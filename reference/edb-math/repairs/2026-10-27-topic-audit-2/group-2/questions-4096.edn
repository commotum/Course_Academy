483f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 4 e^{3} - 3}{1 + e^{3}}" :db/id #edb/ref 17592186703702} :answer-field/id #uuid "b1ad17de-21fc-511c-bc72-e292864ff68f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703691}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af38eb15-44d9-520e-b30d-6a3eecc78cc9" :question/problem "For the function\n\n$$\nf(x,y)=- x y^{2} + \\ln{\\left(e^{x - y^{2}} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(1,2)$.\n\n$f_x(1,2)=$\n\n{{field-1}}\n\n$f_y(1,2)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - y^{2}\\\\\n\\frac{\\partial u}{\\partial x}&=1\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(- x y^{2}\\right)&=- y^{2}\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(- y^{2}\\right)\\\\\n&=- y^{2} + \\frac{e^{x - y^{2}}}{e^{x - y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right) - \\left(2\\right)^{2}=-3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(-4\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-3} + 1\\right) e^{3}}\\right)\\cdot\\left(1\\right)+\\left(-4\\right)\\\\\n&=\\frac{- 4 e^{3} - 3}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - y^{2}\\\\\n\\frac{\\partial u}{\\partial y}&=- 2 y\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(- x y^{2}\\right)&=- 2 x y\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(- 2 y\\right)+\\left(- 2 x y\\right)\\\\\n&=- 2 x y - \\frac{2 y e^{x - y^{2}}}{e^{x - y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right) - \\left(2\\right)^{2}=-3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(-4\\right)+\\left(-4\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-3} + 1\\right) e^{3}}\\right)\\cdot\\left(-4\\right)+\\left(-4\\right)\\\\\n&=\\frac{4 \\left(- e^{3} - 2\\right)}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e2bdff-333f-5ef4-ac82-327989b102b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(1 + 2 e^{3}\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703657} {:answer/id #uuid "34a0f455-5242-5621-b416-d955e570ae49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 + 2 e^{3}" :db/id #edb/ref 17592186703667} {:answer/id #uuid "5cf962f2-ed42-58a5-8453-493799708590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703675} {:answer/id #uuid "676b8c76-46df-5412-a5e9-5419a69e3941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 + 5 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703677} {:answer/id #uuid "a54c6cc1-1720-5e71-b446-82ebaad5f044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(2 + 3 e^{3}\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703687}] :answer-field/correct {:answer/id #uuid "a54c6cc1-1720-5e71-b446-82ebaad5f044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(2 + 3 e^{3}\\right)}{1 + e^{3}}" :db/id #edb/ref 17592186703687} :answer-field/id #uuid "339a1996-dd28-5dac-a7eb-669b3789b711" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703666} {:answer-field/choices [{:answer/id #uuid "122afc4b-fb1f-5781-b892-77b88ce02a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703656} {:answer/id #uuid "5e332027-eb58-598d-947b-fc44dde4d40f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703676} {:answer/id #uuid "880dac31-d6b8-58be-adcb-4058509030f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + 3 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703684} {:answer/id #uuid "ba814d92-de23-5f83-afb7-23eb26aac121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + e^{3}" :db/id #edb/ref 17592186703694} {:answer/id #uuid "bd311ce9-6df4-51e3-97d5-beac836acd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703695}] :answer-field/correct {:answer/id #uuid "5e332027-eb58-598d-947b-fc44dde4d40f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e^{3}}{1 + e^{3}}" :db/id #edb/ref 17592186703676} :answer-field/id #uuid "b295afa0-7a7b-5399-b0c9-a308a7b5a4a8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703692}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d5a098ac-1507-532c-ad17-f6f7d3354ef9" :question/problem "For the function\n\n$$\nf(x,y)=x^{2} y + \\ln{\\left(e^{x^{2} + y} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(1,2)$.\n\n$f_x(1,2)=$\n\n{{field-1}}\n\n$f_y(1,2)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial x}&=2 x\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(x^{2} y\\right)&=2 x y\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(2 x\\right)+\\left(2 x y\\right)\\\\\n&=2 x y + \\frac{2 x e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right)^{2} + \\left(2\\right)=3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(2\\right)+\\left(4\\right)\\\\\n&=\\left(\\frac{e^{3}}{1 + e^{3}}\\right)\\cdot\\left(2\\right)+\\left(4\\right)\\\\\n&=\\frac{2 \\left(2 + 3 e^{3}\\right)}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial y}&=1\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(x^{2} y\\right)&=x^{2}\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(x^{2}\\right)\\\\\n&=x^{2} + \\frac{e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=2$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right)^{2} + \\left(2\\right)=3.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(1,2)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(1\\right)\\\\\n&=\\left(\\frac{e^{3}}{1 + e^{3}}\\right)\\cdot\\left(1\\right)+\\left(1\\right)\\\\\n&=\\frac{1 + 2 e^{3}}{1 + e^{3}}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137d5731-be82-5061-84e4-ad3aa79d9eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e^{2}}{1 + e^{2}}" :db/id #edb/ref 17592186703766} {:answer/id #uuid "8d6d0c3d-ca5f-5a83-959d-19956b96c957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 + 4 e^{2}}{2 \\left(1 + e^{2}\\right)}" :db/id #edb/ref 17592186703783} {:answer/id #uuid "cfa9a357-6689-5b5c-bf4d-349633a5129c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 e^{2}}{1 + e^{2}}" :db/id #edb/ref 17592186703803} {:answer/id #uuid "f79cafe8-ad2c-5cd4-a238-712a6b7b10db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2} + 2" :db/id #edb/ref 17592186703811} {:answer/id #uuid "f7da1ee4-432d-5cba-a574-097ba553ce37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 + 2 e^{2}}{1 + e^{2}}" :db/id #edb/ref 17592186703812}] :answer-field/correct {:answer/id #uuid "f7da1ee4-432d-5cba-a574-097ba553ce37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 + 2 e^{2}}{1 + e^{2}}" :db/id #edb/ref 17592186703812} :answer-field/id #uuid "05772023-c67b-5b15-9ec0-0f29e2464db6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703764} {:answer-field/choices [{:answer/id #uuid "007c0e75-2d01-5ad0-83a2-2b95a99418d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4}{1 + e^{2}}" :db/id #edb/ref 17592186703763} {:answer/id #uuid "338ea97e-06fa-5c2f-b746-627d2d7078e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4}{e^{2}}" :db/id #edb/ref 17592186703768} {:answer/id #uuid "c476ec8f-de55-5ced-8222-96f47cb52600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1 + e^{2}}" :db/id #edb/ref 17592186703798} {:answer/id #uuid "cd450952-57ac-582b-b20c-3598fa7b1bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 e^{2}}{1 + e^{2}}" :db/id #edb/ref 17592186703801} {:answer/id #uuid "dd102e97-ba8d-56a0-884a-8e8f5ade546d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{8}{1 + e^{2}}" :db/id #edb/ref 17592186703808}] :answer-field/correct {:answer/id #uuid "007c0e75-2d01-5ad0-83a2-2b95a99418d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4}{1 + e^{2}}" :db/id #edb/ref 17592186703763} :answer-field/id #uuid "668a5b94-94a0-52ce-84a9-681cdb2846f1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703778}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "75332933-81f5-5b3e-9643-b155acc35353" :question/problem "For the function\n\n$$\nf(x,y)=2 x y^{2} + \\ln{\\left(e^{x - 2 y^{2}} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(0,1)$.\n\n$f_x(0,1)=$\n\n{{field-1}}\n\n$f_y(0,1)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - 2 y^{2}\\\\\n\\frac{\\partial u}{\\partial x}&=1\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(2 x y^{2}\\right)&=2 y^{2}\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(2 y^{2}\\right)\\\\\n&=2 y^{2} + \\frac{e^{x - 2 y^{2}}}{e^{x - 2 y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=0$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=\\left(0\\right) - 2 \\left(1\\right)^{2}=-2.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(0,1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(2\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-2} + 1\\right) e^{2}}\\right)\\cdot\\left(1\\right)+\\left(2\\right)\\\\\n&=\\frac{3 + 2 e^{2}}{1 + e^{2}}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x - 2 y^{2}\\\\\n\\frac{\\partial u}{\\partial y}&=- 4 y\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(2 x y^{2}\\right)&=4 x y\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(- 4 y\\right)+\\left(4 x y\\right)\\\\\n&=4 x y - \\frac{4 y e^{x - 2 y^{2}}}{e^{x - 2 y^{2}} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=0$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=\\left(0\\right) - 2 \\left(1\\right)^{2}=-2.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(0,1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(-4\\right)+\\left(0\\right)\\\\\n&=\\left(\\frac{1}{\\left(e^{-2} + 1\\right) e^{2}}\\right)\\cdot\\left(-4\\right)+\\left(0\\right)\\\\\n&=- \\frac{4}{1 + e^{2}}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58d9c54c-5364-5325-b1f3-ea264676a239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{1 + e}" :db/id #edb/ref 17592186703775} {:answer/id #uuid "96a7ea34-6cd0-52b9-aaa4-31e429487c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 e}{1 + e}" :db/id #edb/ref 17592186703786} {:answer/id #uuid "9911e4c9-5666-54a0-8d94-a662778d330a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703787} {:answer/id #uuid "cb62b0d7-7912-53f4-ba25-d464c33083f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{2 e}{1 + e}" :db/id #edb/ref 17592186703799} {:answer/id #uuid "d808fbc5-ac0a-5a16-b160-3ad24e0152bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{2}{1 + e}" :db/id #edb/ref 17592186703805}] :answer-field/correct {:answer/id #uuid "96a7ea34-6cd0-52b9-aaa4-31e429487c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 e}{1 + e}" :db/id #edb/ref 17592186703786} :answer-field/id #uuid "05d0d234-a60f-534f-83b6-a2ce8e2dc1b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703765} {:answer-field/choices [{:answer/id #uuid "5388748f-2487-54de-9e94-617e6e4e5534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 + 2 e}{1 + e}" :db/id #edb/ref 17592186703774} {:answer/id #uuid "6440b5ed-5833-514c-8896-887374617d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703777} {:answer/id #uuid "8b3cb476-7da2-5804-a7db-b604d90928bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + e}{1 + e}" :db/id #edb/ref 17592186703782} {:answer/id #uuid "94bd65d2-5724-5dc7-a20d-8fb4ad2d61e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + 3 e}{1 + e}" :db/id #edb/ref 17592186703785} {:answer/id #uuid "be267a11-d41e-5b6e-91bb-f886464b207a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(1 + 2 e\\right)}{1 + e}" :db/id #edb/ref 17592186703797}] :answer-field/correct {:answer/id #uuid "94bd65d2-5724-5dc7-a20d-8fb4ad2d61e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + 3 e}{1 + e}" :db/id #edb/ref 17592186703785} :answer-field/id #uuid "b77df5fc-b694-5fb7-a9fc-8187a3e54a51" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703795}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b42917ca-f399-512c-97e2-7ccc211980d7" :question/problem "For the function\n\n$$\nf(x,y)=2 x^{2} y + \\ln{\\left(e^{x^{2} + y} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(1,0)$.\n\n$f_x(1,0)=$\n\n{{field-1}}\n\n$f_y(1,0)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial x}&=2 x\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(2 x^{2} y\\right)&=4 x y\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(2 x\\right)+\\left(4 x y\\right)\\\\\n&=4 x y + \\frac{2 x e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=0$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right)^{2} + \\left(0\\right)=1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,0)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(2\\right)+\\left(0\\right)\\\\\n&=\\left(\\frac{e}{1 + e}\\right)\\cdot\\left(2\\right)+\\left(0\\right)\\\\\n&=\\frac{2 e}{1 + e}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x^{2} + y\\\\\n\\frac{\\partial u}{\\partial y}&=1\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(2 x^{2} y\\right)&=2 x^{2}\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(2 x^{2}\\right)\\\\\n&=2 x^{2} + \\frac{e^{x^{2} + y}}{e^{x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=0$ after differentiating. The inner input is\n\n$$\nu_0=\\left(1\\right)^{2} + \\left(0\\right)=1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(1,0)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(2\\right)\\\\\n&=\\left(\\frac{e}{1 + e}\\right)\\cdot\\left(1\\right)+\\left(2\\right)\\\\\n&=\\frac{2 + 3 e}{1 + e}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15576ef1-1942-5f26-9d65-3d910bf4ab94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e}{1 + e}" :db/id #edb/ref 17592186703767} {:answer/id #uuid "355b7e37-af89-50f7-a68f-9a416d97fdbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 3 e}{1 + e}" :db/id #edb/ref 17592186703770} {:answer/id #uuid "791f31ba-4cab-5b55-98ad-04f905763c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + e" :db/id #edb/ref 17592186703780} {:answer/id #uuid "99688d40-ac43-5240-b614-58f76311508b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703788} {:answer/id #uuid "ba725723-55b7-5d82-abfc-66a7e61f202b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 + 3 e}{2 \\left(1 + e\\right)}" :db/id #edb/ref 17592186703796}] :answer-field/correct {:answer/id #uuid "15576ef1-1942-5f26-9d65-3d910bf4ab94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1 + 2 e}{1 + e}" :db/id #edb/ref 17592186703767} :answer-field/id #uuid "3d545713-2f96-58ec-865e-f103b694025f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703773} {:answer-field/choices [{:answer/id #uuid "33c2e81a-a770-5aae-ac00-48134294113b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703769} {:answer/id #uuid "ad14ab0a-04e7-5153-b55a-5923ddc3ac46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 3 e - 2}{1 + e}" :db/id #edb/ref 17592186703789} {:answer/id #uuid "b5602bad-9474-5f15-9b99-71878628ff99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- e - 2}{1 + e}" :db/id #edb/ref 17592186703793} {:answer/id #uuid "b6d4a6c5-f4d8-583f-85f0-7686329b7417" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186703794} {:answer/id #uuid "cff979d7-e2a5-5619-a6de-f799edc1de8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e - 2" :db/id #edb/ref 17592186703804}] :answer-field/correct {:answer/id #uuid "ad14ab0a-04e7-5153-b55a-5923ddc3ac46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{- 3 e - 2}{1 + e}" :db/id #edb/ref 17592186703789} :answer-field/id #uuid "ffd45750-6900-5120-a739-1d5608ca5e37" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703814}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e6baa3ef-96c3-5076-91f3-db4b3df780c6" :question/problem "For the function\n\n$$\nf(x,y)=x y^{2} + \\ln{\\left(1 + e^{- x y} \\right)},\n$$\n\nevaluate both partial derivatives at $(1,-1)$.\n\n$f_x(1,-1)=$\n\n{{field-1}}\n\n$f_y(1,-1)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=- x y\\\\\n\\frac{\\partial u}{\\partial x}&=- y\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(x y^{2}\\right)&=y^{2}\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(- y\\right)+\\left(y^{2}\\right)\\\\\n&=y^{2} - \\frac{y e^{- x y}}{1 + e^{- x y}}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=-1$ after differentiating. The inner input is\n\n$$\nu_0=- \\left(1\\right) \\left(-1\\right)=1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(1,-1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(1\\right)\\\\\n&=\\left(\\frac{e}{1 + e}\\right)\\cdot\\left(1\\right)+\\left(1\\right)\\\\\n&=\\frac{1 + 2 e}{1 + e}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=- x y\\\\\n\\frac{\\partial u}{\\partial y}&=- x\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(x y^{2}\\right)&=2 x y\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(- x\\right)+\\left(2 x y\\right)\\\\\n&=2 x y - \\frac{x e^{- x y}}{1 + e^{- x y}}\n\\end{aligned}\n$$\n\nSubstitute $x=1$ and $y=-1$ after differentiating. The inner input is\n\n$$\nu_0=- \\left(1\\right) \\left(-1\\right)=1.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(1,-1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(-1\\right)+\\left(-2\\right)\\\\\n&=\\left(\\frac{e}{1 + e}\\right)\\cdot\\left(-1\\right)+\\left(-2\\right)\\\\\n&=\\frac{- 3 e - 2}{1 + e}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}] [{:db/id #edb/ref 17592186703810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381694ea-815e-588e-954f-47892e9da161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 + e^{9}" :db/id #edb/ref 17592186703772} {:answer/id #uuid "b240318f-37dd-54fc-8571-a59d127ee573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 + 9 e^{9}}{2 \\left(1 + e^{9}\\right)}" :db/id #edb/ref 17592186703790} {:answer/id #uuid "b3f0d0b3-695d-571d-a285-4e7d57b27028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 + 5 e^{9}}{1 + e^{9}}" :db/id #edb/ref 17592186703791} {:answer/id #uuid "d81065e1-0946-591f-8e1a-003adeeec9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703806} {:answer/id #uuid "d8a8e3b5-07bc-54d8-9d8e-1087b3acb9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186703807}] :answer-field/correct {:answer/id #uuid "b3f0d0b3-695d-571d-a285-4e7d57b27028" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 + 5 e^{9}}{1 + e^{9}}" :db/id #edb/ref 17592186703791} :answer-field/id #uuid "5aa7741a-00e8-54ea-bf81-b5ede117f261" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703776} {:answer-field/choices [{:answer/id #uuid "38161032-1bff-5005-b665-35559e87aa3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(3 + e^{9}\\right)}{1 + e^{9}}" :db/id #edb/ref 17592186703771} {:answer/id #uuid "888a9597-4aa9-55ae-a673-4c430e360d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(1 + 3 e^{9}\\right)}{1 + e^{9}}" :db/id #edb/ref 17592186703781} {:answer/id #uuid "cc1c3942-7f2c-51cf-94e4-0720fb08ace3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(1 + 2 e^{9}\\right)}{1 + e^{9}}" :db/id #edb/ref 17592186703800} {:answer/id #uuid "ce12cfe8-5c77-52a5-84a8-cea7ce4ac71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 e^{9}}{1 + e^{9}}" :db/id #edb/ref 17592186703802} {:answer/id #uuid "f7e02fbb-e6c3-5ef6-a564-67a032c1a419" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703813}] :answer-field/correct {:answer/id #uuid "888a9597-4aa9-55ae-a673-4c430e360d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4 \\left(1 + 3 e^{9}\\right)}{1 + e^{9}}" :db/id #edb/ref 17592186703781} :answer-field/id #uuid "911b472f-c8ea-5e0b-9b1f-8aa55e8fe953" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186703784}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f06dd19d-0916-536a-9797-3696a5a63129" :question/problem "For the function\n\n$$\nf(x,y)=x^{2} y + \\ln{\\left(e^{2 x^{2} + y} + 1 \\right)},\n$$\n\nevaluate both partial derivatives at $(2,1)$.\n\n$f_x(2,1)=$\n\n{{field-1}}\n\n$f_y(2,1)=$\n\n{{field-2}}" :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=2 x^{2} + y\\\\\n\\frac{\\partial u}{\\partial x}&=4 x\\\\\n\\frac{\\partial}{\\partial x}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial x}\\\\\n\\frac{\\partial}{\\partial x}\\left(x^{2} y\\right)&=2 x y\\\\\nf_x(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(4 x\\right)+\\left(2 x y\\right)\\\\\n&=2 x y + \\frac{4 x e^{2 x^{2} + y}}{e^{2 x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=2$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=2 \\left(2\\right)^{2} + \\left(1\\right)=9.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(2,1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(8\\right)+\\left(4\\right)\\\\\n&=\\left(\\frac{e^{9}}{1 + e^{9}}\\right)\\cdot\\left(8\\right)+\\left(4\\right)\\\\\n&=\\frac{4 \\left(1 + 3 e^{9}\\right)}{1 + e^{9}}.\n\\end{aligned}\n$$\n\nTreat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=2 x^{2} + y\\\\\n\\frac{\\partial u}{\\partial y}&=1\\\\\n\\frac{\\partial}{\\partial y}\\ln(1+e^u)&=\\frac{1}{1+e^u}\\cdot e^u\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(x^{2} y\\right)&=x^{2}\\\\\nf_y(x,y)&=\\left(\\frac{e^{u}}{e^{u} + 1}\\right)\\cdot\\left(1\\right)+\\left(x^{2}\\right)\\\\\n&=x^{2} + \\frac{e^{2 x^{2} + y}}{e^{2 x^{2} + y} + 1}\n\\end{aligned}\n$$\n\nSubstitute $x=2$ and $y=1$ after differentiating. The inner input is\n\n$$\nu_0=2 \\left(2\\right)^{2} + \\left(1\\right)=9.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(2,1)&=\\left(\\frac{e^{u_0}}{e^{u_0} + 1}\\right)\\cdot\\left(1\\right)+\\left(4\\right)\\\\\n&=\\left(\\frac{e^{9}}{1 + e^{9}}\\right)\\cdot\\left(1\\right)+\\left(4\\right)\\\\\n&=\\frac{4 + 5 e^{9}}{1 + e^{9}}.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."}]}
