b/id #edb/ref 17592186193191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dca404c-a5ec-59b9-86f2-7bef312a3a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276314} {:answer/id #uuid "60f31fe4-d889-5663-b09c-1f3d3a934e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-2" :db/id #edb/ref 17592186276351} {:answer/id #uuid "b0d9bb43-7bc8-5503-9cb9-8fa76c5d61b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186277059} {:answer/id #uuid "cf8085bd-299e-5a6d-b588-c8dc819bbb1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277313} {:answer/id #uuid "dd32ec93-9bb3-5504-9d2b-d507b1f2c7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277413}] :answer-field/correct {:answer/id #uuid "60f31fe4-d889-5663-b09c-1f3d3a934e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-2" :db/id #edb/ref 17592186276351} :answer-field/id #uuid "8c4fa2ab-2f5d-570f-a779-b76e2b67ca98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277976}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d20c624a-1709-5495-88ea-45d0df97ea34" :question/math-academy-id "q-159751" :question/problem "For the function $f(x,y)=y{e}^{xy}-{x}^{2}{y}^{2},$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(y{e}^{xy}-{x}^{2}{y}^{2}) \\\\  & =\\frac{∂}{∂y}(y{e}^{xy})-\\frac{∂}{∂y}({x}^{2}{y}^{2}) \\\\  & =\\frac{∂}{∂y}(y{e}^{xy})-{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{2})\\end{aligned}\n$$\n\nThen, we use the product, the chain, and the constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(y{e}^{xy})-{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{2}) & =(\\frac{∂}{∂y}(y)\\cdot {e}^{xy}+y\\cdot \\frac{∂}{∂y}({e}^{xy}))-{x}^{2}\\cdot (2y) \\\\  & =(1\\cdot {e}^{xy}+y\\cdot {e}^{xy}\\cdot \\frac{∂}{∂y}(xy))-2{x}^{2}y \\\\  & =({e}^{xy}+y\\cdot {e}^{xy}\\cdot x\\cdot \\frac{∂}{∂y}(y))-2{x}^{2}y \\\\  & =({e}^{xy}+y\\cdot {e}^{xy}\\cdot x\\cdot 1)-2{x}^{2}y \\\\  & ={e}^{xy}+xy{e}^{xy}-2{x}^{2}y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1)} & ={e}^{1\\cdot 1}+1\\cdot 1\\cdot {e}^{1\\cdot 1}-2\\cdot {1}^{2}\\cdot 1 \\\\  & =e+e-2 \\\\  & =2e-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6537a211-988c-5668-b744-a7a835445a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186321932} {:answer/id #uuid "71e4806a-8e4b-520c-928b-81dbadc1fe14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322044} {:answer/id #uuid "960d1e29-7934-50e7-a295-0f743083eb53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186322339} {:answer/id #uuid "b481fb26-41eb-5d5c-b42b-d663d5f13d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186322557} {:answer/id #uuid "def87247-a78e-5ef4-8eed-60df8bc36b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322891}] :answer-field/correct {:answer/id #uuid "960d1e29-7934-50e7-a295-0f743083eb53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186322339} :answer-field/id #uuid "3e6e9ad1-12b8-512c-a42e-c331613a9a75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323292}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3cd9c82e-fba1-518a-8285-94d9c7befa44" :question/math-academy-id "q-35710" :question/problem "For the function $f(x,y,z)={x}^{2}{y}^{2}-\\operatorname{ln}⁡(xz),$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,0,1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}{y}^{2}-\\operatorname{ln}⁡(xz)) \\\\  & =\\frac{∂}{∂y}({x}^{2}{y}^{2})-\\frac{∂}{∂y}(\\operatorname{ln}⁡(xz)) \\\\  & ={x}^{2}\\cdot \\frac{∂}{∂y}({y}^{2})-(0) \\\\  & ={x}^{2}\\cdot (2y) \\\\  & =2{x}^{2}y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,0,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,0,1)} & =2(1)^{2}(0) \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003296a1-5642-5e96-9e65-6300b69a9f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321150} {:answer/id #uuid "1c00999c-6574-561f-a1f1-5c0fa860bddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186321358} {:answer/id #uuid "4e3bf925-d142-5810-a048-d160ed091e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321764} {:answer/id #uuid "844c30dc-5a70-5766-b0c0-94b42ca5ecd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186322192} {:answer/id #uuid "f98ec2c9-ca94-5316-a3d1-a8113b2c28df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186323110}] :answer-field/correct {:answer/id #uuid "f98ec2c9-ca94-5316-a3d1-a8113b2c28df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186323110} :answer-field/id #uuid "aa4699ed-35c4-5fe9-b9bb-a4122274633f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323499}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "52ec8ecc-7425-5715-9001-87fc8bd443a4" :question/math-academy-id "q-35718" :question/problem "For the function $f(x,y)={e}^{xy}+{x}^{2}y,$ evaluate ${f}_{y}(1,0).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the sum rule:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{xy}+{x}^{2}y) \\\\  & =\\frac{∂}{∂y}({e}^{xy})+\\frac{∂}{∂y}({x}^{2}y)\\end{aligned}\n$$\n\n \n\nNow, we use the chain and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}({e}^{xy})+\\frac{∂}{∂y}({x}^{2}y) & ={e}^{xy}\\cdot \\frac{∂}{∂y}(xy)+{x}^{2}\\cdot \\frac{∂}{∂y}(y) \\\\  & ={e}^{xy}\\cdot x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot (1) \\\\  & =x{e}^{xy}\\cdot (1)+{x}^{2} \\\\  & =x{e}^{xy}+{x}^{2}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,0):$ \n\n$$\n\\begin{aligned}{f}_{y}(1,0) & =1\\cdot {e}^{1\\cdot 0}+{1}^{2} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cd2ecec-e482-5e59-ab0d-633d49709954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{4}e^{x^{4}y}" :db/id #edb/ref 17592186192184} {:answer/id #uuid "c4327b70-7103-5fc8-8434-e8898f0f6a65" :