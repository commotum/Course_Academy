torname{sin}⁡(xz)) \\\\  & =yz-\\frac{∂}{∂x}(\\operatorname{sin}⁡(xz))\\end{aligned}\n$$\n\nThen, we use the chain rule:\n\n$$\n\\begin{aligned}yz-\\frac{∂}{∂x}(\\operatorname{sin}⁡(xz)) & =yz-\\operatorname{cos}⁡(xz)\\cdot \\frac{∂}{∂x}(xz) \\\\  & =yz-\\operatorname{cos}⁡(xz)\\cdot (z) \\\\  & =yz-z\\operatorname{cos}⁡(xz) \\\\  & =z(y-\\operatorname{cos}⁡(xz))\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,0,\\pi ):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,0,\\pi )} & =\\pi (0-\\operatorname{cos}⁡(1\\cdot \\pi )) \\\\  & =\\pi (0-(-1)) \\\\  & =\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1b3428-f0ff-5ea9-ae99-bf8657ba7b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{e}^{-1}" :db/id #edb/ref 17592186352412} {:answer/id #uuid "689b5ddb-7080-5cde-993b-3f0536812305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2}" :db/id #edb/ref 17592186352500} {:answer/id #uuid "7cdee458-66d1-5075-a5b3-b90c8837d4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+e" :db/id #edb/ref 17592186352664} {:answer/id #uuid "bb7a10a6-a680-5c5d-bddf-8913d3cf78ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186353158} {:answer/id #uuid "d4fc7604-4fda-5395-8026-a179d600a128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{e}^{-1}" :db/id #edb/ref 17592186353415}] :answer-field/correct {:answer/id #uuid "5f1b3428-f0ff-5ea9-ae99-bf8657ba7b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{e}^{-1}" :db/id #edb/ref 17592186352412} :answer-field/id #uuid "c7aa88dc-8c66-5720-9d75-ddad96eeb69d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354161}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ce4a1a73-6331-5e40-b163-83a2f690e9c1" :question/math-academy-id "q-86812" :question/problem "For the function $f(x,y,z)={z}^{2}{e}^{xy}-{y}^{2}{e}^{yz},$ evaluate $\\frac{∂f}{∂z}$ at the point $(0,-1,1).$" :question/worked-solution "We differentiate the given function with respect to $z,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂}{∂z}({z}^{2}{e}^{xy}-{y}^{2}{e}^{yz}) \\\\  & =\\frac{∂}{∂z}({z}^{2}{e}^{xy})-\\frac{∂}{∂z}({y}^{2}{e}^{yz}) \\\\  & ={e}^{xy}\\cdot \\frac{∂}{∂z}({z}^{2})-{y}^{2}\\cdot \\frac{∂}{∂z}({e}^{yz})\\end{aligned}\n$$\n\nThen, we use the chain rule:\n\n$$\n\\begin{aligned}{e}^{xy}\\cdot \\frac{∂}{∂z}({z}^{2})-{y}^{2}\\cdot \\frac{∂}{∂z}({e}^{yz}) & ={e}^{xy}\\cdot 2z-{y}^{2}\\cdot {e}^{yz}\\cdot \\frac{∂}{∂z}(yz) \\\\  & ={e}^{xy}\\cdot 2z-{y}^{2}\\cdot {e}^{yz}\\cdot y \\\\  & =2z{e}^{xy}-{y}^{3}{e}^{yz}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(0,-1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}{|}_{(0,-1,1)} & =2(1){e}^{(0)(-1)}-(-1)^{3}{e}^{(-1)(1)} \\\\  & =2+{e}^{-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85813fa1-7598-522f-8c21-a78340a56373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186380959} {:answer/id #uuid "794f355d-1fd3-5f85-acbc-2a0b9cb24276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186380960} {:answer/id #uuid "d727996c-f099-52f9-bb09-3a563b0e8bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380961} {:answer/id #uuid "169f002f-fd26-50ae-930c-9a604e9ae96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186380962} {:answer/id #uuid "a1d17484-2506-5d97-98a5-73a7fa14daee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186380963}] :answer-field/correct {:answer/id #uuid "a1d17484-2506-5d97-98a5-73a7fa14daee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186380963} :answer-field/id #uuid "391d0c46-ac45-548f-b507-5755302aa0bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380958}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9414edde-aaa5-55fe-99cf-fcbd12cf83ce" :question/math-academy-id "q-132255" :question/problem "For the function $g(x,y,z)=\\sqrt{x}\\operatorname{arccos}⁡(y{z}^{2}),$ evaluate $\\frac{∂g}{∂z}$ at the point $(3,\\frac{1}{2},1).$" :question/worked-solution "We differentiate the given function with respect to $z,$ treating all other variables as constants. \n\nUsing the constant multiple and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂}{∂z}(\\sqrt{x}\\operatorname{arccos}⁡(y{z}^{2})) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂z}(\\operatorname{arccos}⁡(y{z}^{2})) \\\\  & =\\sqrt{x}\\cdot \\left(-\\frac{1}{\\sqrt{1-{(y{z}^{2})}^{2}}}\\right)\\cdot \\frac{∂}{∂z}(y{z}^{2}) \\\\  & =\\sqrt{x}\\cdot \\left(-\\frac{1}{\\sqrt{1-{y}^{2}{z}^{4}}}\\right)\\cdot y\\cdot 2z \\\\  & =-\\frac{2yz\\sqrt{x}}{\\sqrt{1-{y}^{2}{z}^{4}}}.\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(3,\\frac{1}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}{|}_{(3,\\,1/2,\\,1)} & =-\\frac{2\\left(\\frac{1}{2}\\right)(1)\\sqrt{3}}{\\sqrt{1-{\\left(\\frac{1}{2}\\right)}^{2}(1)^{4}}} \\\\  & =-\\frac{\\sqrt{3}}{\\sqrt{1-\\frac{1}{4}}} \\\\  & =-\\frac{\\sqrt{3}}{\\left(\\frac{\\sqrt{3}}{2}\\right)} \\\\  & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c844163-eb89-5874-92d7-a5e42c8fbbd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sec}⁡(x+y)}{x+y}" :db/id #edb/ref 17592186381246} {:answer/id #uuid "30d11849-9588-53e0-81ab-c140edee486b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}" :db/id #edb/ref 17592186381247} {:answer/id #uuid "50a71ffc-fa50-51cd-9ad1-844d4f0ba6a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{\\operatorname{ln}⁡(x+y)}" :db/id #edb/ref 17592186381248} {:answer/id #uuid "8816e80b-49b5-5210-ae66-28bae9df4a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}+1" :db/id #edb/ref 17592186381249} {:answer/id #uuid "f228610a-936e-57b2-b0d3-3a75eb518312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(x+y)}{\\operatorname{ln}⁡(x+y)}" :db/id #edb/ref 17592186381250}] :answer-field/correct {:answer/id #uuid "30d11849-9588-53e0-81ab-c140edee486b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}" :db/id #edb/ref 17592186381247} :answer-field/id #uuid "f0221042-a90c-56d3-89c0-3048bc883643" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381245}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4560fcbf-c2fb-5e9f-b888-53c870445e63" :question/math-academy-id "q-159655" :question/problem "Find $\\frac{∂f}{∂y}$ for $f(x,y)=\\operatorname{tan}⁡(\\operatorname{ln}⁡(x+y)).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the chain rule: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{tan}⁡(\\operatorname{ln}⁡(x+y))) \\\\  & ={sec}^{2}⁡(\\operatorname{ln}⁡(x+y))\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y)) \\\\  & ={sec}^{2}⁡(\\operatorname{ln}⁡(x+y))\\cdot \\frac{1}{x+y}\\cdot \\frac{∂}{∂y}(x+y)\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))\\cdot \\frac{1}{x+y}\\cdot \\frac{∂}{∂y}(x+y) & =\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}\\cdot (x\\cdot \\frac{∂}{∂y}(1)+\\frac{∂}{∂y}(y)) \\\\  & =\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}\\cdot (x\\cdot 0+1) \\\\  & =\\frac{{sec}^{2}⁡(\\operatorname{ln}⁡(x+y))}{x+y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbc2a41c-8b46-55d8-8633-185639106579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x+{x}^{3}y}" :db/id #edb/ref 17592186381253} {:answer/id #uuid "b53ff0ab-76f0-50e1-b576-7d4bec199596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{\\operatorname{ln}⁡(x+{x}^{3}y)}" :db/id #edb/ref 17592186381254} {:answer/id #uuid "7aeb7858-5a4c-5e37-baac-5e1b09598456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381255} {:answer/id #uuid "75c5ac00-44da-5d0f-bc6a-05231039cb36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381256} {:answer/id #uuid "891569ad-a562-5cb2-8249-28d2b2b8e614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}y}{1+{x}^{3}y}" :db/id #edb/ref 17592186381257}] :answer-field/correct {:answer/id #uuid "7aeb7858-5a4c-5e37-baac-5e1b09598456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+3{x}^{2}y}{x+{x}^{3}y}" :db/id #edb/ref 17592186381255} :answer-field/id #uuid "16d337f9-2d19-54ee-833d-730d6117510a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381252}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6cc4635c-e2d0-54e1-a8b8-18c5b785e7cf" :question/math-academy-id "q-159659" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\operatorname{ln}⁡(x+{x}^{3}y).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the chain rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+{x}^{3}y)) \\\\  & =\\frac{1}{x+{x}^{3}y}\\cdot \\frac{∂}{∂x}(x+{x}^{3}y)\\end{aligned}\n$$\n\nNow, we use the sum and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{1}{x+{x}^{3}y}\\cdot \\frac{∂}{∂x}(x+{x}^{3}y) & =\\frac{1}{x+{x}^{3}y}\\cdot (\\frac{∂}{∂x}(x)+y\\cdot \\frac{∂}{∂x}({x}^{3})) \\\\  & =\\frac{1}{x+{x}^{3}y}\\cdot (1+y\\cdot 3{x}^{2}) \\\\  & =\\frac{1+3{x}^{2}y}{x+{x}^{3}y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "764fe799-f9d4-56fc-8786-768351e90b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186381260} {:answer/id #uuid "af40a1cc-fcdd-5d82-88f1-afb1cb810dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381261} {:answer/id #uuid "238d2bb5-2057-5938-92cb-490c8fd1d052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186381262} {:answer/id #uuid "007df772-538e-5628-b388-eb1493c3de4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186381263} {:answer/id #uuid "e31f346f-c25e-5e5e-9897-5f3acda1e293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186381264}] :answer-field/correct {:answer/id #uuid "af40a1cc-fcdd-5d82-88f1-afb1cb810dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381261} :answer-field/id #uuid "33cf4f0d-d3ae-5f4a-af95-43db53f9c0fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381259}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ba29a24e-25aa-5034-8849-e753260af75f" :question/math-academy-id "q-159706" :question/problem "For the function $$\n\\displaystyle f(x,y)=\\frac{\\operatorname{cos}⁡x+\\operatorname{sin}⁡y}{\\operatorname{cos}⁡x-\\operatorname{sin}⁡y},\n$$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,-\\pi ).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the quotient rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}\\left(\\frac{\\operatorname{cos}⁡x+\\operatorname{sin}⁡y}{\\operatorname{cos}⁡x-\\operatorname{sin}⁡y}\\right) & =\\frac{\\frac{∂}{∂y}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (-\\operatorname{cos}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\operatorname{cos}⁡x-\\operatorname{cos}⁡y\\operatorname{sin}⁡y+\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{2\\operatorname{cos}⁡x\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\pi ,-\\pi ):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,-\\pi )} & =\\frac{2\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡(-\\pi )}{(\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))^{2}} \\\\  & =\\frac{2(-1)(-1)}{(-1-0)^{2}} \\\\  & =\\frac{2}{1} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8367eed8-8db9-5b16-8030-4fb1d45343f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}" :db/id #edb/ref 17592186381267} {:answer/id #uuid "c3f7d926-4b2e-5a47-a964-89bbf3409d2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{2}}" :db/id #edb/ref 17592186381268} {:answer/id #uuid "c0684d01-ce2e-5d72-b7c5-5083711bc071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-e" :db/id #edb/ref 17592186381269} {:answer/id #uuid "3e29fb6f-8142-5709-a889-a0d7208a0ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381270} {:answer/id #uuid "20723cc1-5581-5f10-b006-0cc5888b60c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186381271}] :answer-field/correct {:answer/id #uuid "8367eed8-8db9-5b16-8030-4fb1d45343f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2}" :db/id #edb/ref 17592186381267} :answer-field/id #uuid "c43d33af-7b21-5589-9d8f-5fccd66d3600" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381266}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f6e1b67-30d1-5d26-980f-cea342aa0dc8" :question/math-academy-id "q-159707" :question/problem "For the function $f(x,y)=\\frac{{x}^{2}-{y}^{2}}{{e}^{y-x}},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,-1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the quotient and chain rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}\\left(\\frac{{x}^{2}-{y}^{2}}{{e}^{y-x}}\\right) & =\\frac{\\frac{∂}{∂x}({x}^{2}-{y}^{2})\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot \\frac{∂}{∂x}({e}^{y-x})}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot \\frac{∂}{∂x}(y-x)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x{e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot (-1)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{(2x+{x}^{2}-{y}^{2}){e}^{y-x}}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x+{x}^{2}-{y}^{2}}{{e}^{y-x}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,-1)} & =\\frac{2(1)+{1}^{2}-(-1)^{2}}{{e}^{-1-1}} \\\\  & =\\frac{2+1-1}{{e}^{-2}} \\\\  & =2{e}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b4a1d9-cd1c-5571-9518-79d29836ff46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡x\\operatorname{sin}⁡y" :db/id #edb/ref 17592186381274} {:answer/id #uuid "12f38844-8972-566b-9cc4-9cfde5403c8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x-\\operatorname{cos}⁡y" :db/id #edb/ref 17592186381275} {:answer/id #uuid "c7c9d0a7-3b5f-5c87-8d2d-3652e6d79b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186381276} {:answer/id #uuid "83292db4-d816-5e9e-a3de-33ff1b3276fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x\\operatorname{sin}⁡y" :db/id #edb/ref 17592186381277} {:answer/id #uuid "6a8d819d-5775-5389-a036-8dc2fb90c6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡y-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381278}] :answer-field/correct {:answer/id #uuid "83292db4-d816-5e9e-a3de-33ff1b3276fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x\\operatorname{sin}⁡y" :db/id #edb/ref 17592186381277} :answer-field/id #uuid "4cc5a44e-5e88-5654-addf-13837aea580f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381273}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9fb48fb-ee18-53c2-9d40-be28dc7c4677" :question/math-academy-id "q-159722" :question/problem "Consider the function $$\n\\displaystyle f(x,y)=\\frac{\\operatorname{sin}⁡x-\\operatorname{cos}⁡y}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡y}.\n$$ The partial derivative of $f$ with respect to $y$ is given by\n\n$$\n\\frac{∂f}{∂y}=\\frac{h(x,y)}{(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)^{2}}.\n$$\n\nFind the function $h(x,y).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the quotient rule, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}\\left(\\frac{\\operatorname{sin}⁡x-\\operatorname{cos}⁡y}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡y}\\right) \\\\  & =\\frac{\\frac{∂}{∂y}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡y)\\cdot (\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)-(\\operatorname{sin}⁡x-\\operatorname{cos}⁡y)\\cdot \\frac{∂}{∂y}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)}{(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{sin}⁡y\\cdot (\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)-(\\operatorname{sin}⁡x-\\operatorname{cos}⁡y)\\cdot (-\\operatorname{sin}⁡y)}{(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡y+\\operatorname{cos}⁡y\\operatorname{sin}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y-\\operatorname{cos}⁡y\\operatorname{sin}⁡y}{(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)^{2}} \\\\  & =\\frac{2\\operatorname{sin}⁡x\\operatorname{sin}⁡y}{(\\operatorname{sin}⁡x+\\operatorname{cos}⁡y)^{2}}\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=2\\operatorname{sin}⁡x\\operatorname{sin}⁡y.\n$$"}] [{:db/id #edb/ref 17592186381279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5361b3e-3a8f-5f23-bccc-16c3847e243d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+{y}^{5})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381281} {:answer/id #uuid "c396d8bd-ee03-54b5-9fa3-772cead8f6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2+{y}^{5})\\operatorname{cos}⁡x-{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381282} {:answer/id #uuid "466b5ac2-73bd-559a-876d-a603caed3fe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-{y}^{4})\\operatorname{cos}⁡x-y\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381283} {:answer/id #uuid "807ec85c-b29c-57a4-8b0d-6e20c421ffd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+{y}^{5})\\operatorname{cos}⁡x-y\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381284} {:answer/id #uuid "89d9d8d2-74da-542b-b631-e8a3e5161e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+5{y}^{4})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381285}] :answer-field/correct {:answer/id #uuid "e5361b3e-3a8f-5f23-bccc-16c3847e243d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+{y}^{5})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381281} :answer-field/id #uuid "b1af9e5e-7d6f-5413-99e4-88f6a6ae2bd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381280}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3444068d-2f79-5306-813a-47bbdab330c5" :question/math-academy-id "q-159725" :question/problem "Find $\\frac{∂f}{∂x}$ for $f(x,y)=x\\operatorname{cos}⁡x+{y}^{5}\\operatorname{sin}⁡x.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡x+{y}^{5}\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡x)+\\frac{∂}{∂x}({y}^{5}\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡x)+{y}^{5}\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nThen, we use the product rule:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(x\\operatorname{cos}⁡x)+{y}^{5}\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) & =(\\frac{∂}{∂x}(x)\\cdot \\operatorname{cos}⁡x+x\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡x))+{y}^{5}\\cdot (\\operatorname{cos}⁡x) \\\\  & =((1)\\cdot \\operatorname{cos}⁡x+x\\cdot (-\\operatorname{sin}⁡x))+{y}^{5}\\operatorname{cos}⁡x \\\\  & =\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+{y}^{5}\\operatorname{cos}⁡x \\\\  & =(1+{y}^{5})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3c1021c-0885-5bf7-b3e5-6327c277df4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+2\\pi }{4}" :db/id #edb/ref 17592186381288} {:answer/id #uuid "110927d7-7b2d-5c08-bf3d-0346fca0acbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4\\pi }{8}" :db/id #edb/ref 17592186381289} {:answer/id #uuid "60bf5676-3040-5ff2-acf5-f790c6a36101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi +1}{8}" :db/id #edb/ref 17592186381290} {:answer/id #uuid "92b9f3d2-b458-5615-b4f0-1138a3573da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4}{2}" :db/id #edb/ref 17592186381291} {:answer/id #uuid "d23a20cb-a2b4-58ef-a4f6-d0f3bb9feba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186381292}] :answer-field/correct {:answer/id #uuid "110927d7-7b2d-5c08-bf3d-0346fca0acbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}+4\\pi }{8}" :db/id #edb/ref 17592186381289} :answer-field/id #uuid "9a23d4f6-a890-5ca9-9d9c-0ca9c46113c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381287}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "39e99179-93fc-5477-adbb-fdfcbcd0de54" :question/math-academy-id "q-159753" :question/problem "For the function $f(x,y)={x}^{2}\\operatorname{tan}⁡(x{y}^{2}),$ evaluate ${f}_{x}(\\frac{\\pi }{4},1)$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the product rule:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}\\operatorname{tan}⁡(x{y}^{2})) \\\\  & =\\frac{∂}{∂x}({x}^{2})\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot \\frac{∂}{∂x}(\\operatorname{tan}⁡(x{y}^{2}))\\end{aligned}\n$$\n\nThen, we use the chain and the constant multiple rules:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}({x}^{2})\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot \\frac{∂}{∂x}(\\operatorname{tan}⁡(x{y}^{2})) & =(2x)\\cdot \\operatorname{tan}⁡(x{y}^{2})+{x}^{2}\\cdot {sec}^{2}⁡(x{y}^{2})\\frac{∂}{∂x}(x{y}^{2}) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{sec}^{2}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{sec}^{2}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot (1) \\\\  & =2x\\operatorname{tan}⁡(x{y}^{2})+{x}^{2}{y}^{2}{sec}^{2}⁡(x{y}^{2})\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\frac{\\pi }{4},1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi /4,1)} & =2\\cdot \\frac{\\pi }{4}\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{4}\\cdot {1}^{2})+{\\left(\\frac{\\pi }{4}\\right)}^{2}\\cdot {1}^{2}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4}\\cdot {1}^{2}) \\\\  & =2\\cdot \\frac{\\pi }{4}\\cdot 1+\\frac{{\\pi }^{2}}{16}\\cdot (\\sqrt{2})^{2} \\\\  & =\\frac{\\pi }{2}+\\frac{{\\pi }^{2}}{8} \\\\  & =\\frac{{\\pi }^{2}+4\\pi }{8}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd3a4ba0-0931-5b38-80b6-0a4eb0ceef6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{2}" :db/id #edb/ref 17592186381295} {:answer/id #uuid "cfcd4e39-e404-5742-b04b-6b4daf7838dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\pi {e}^{2}" :db/id #edb/ref 17592186381296} {:answer/id #uuid "e72dc8ba-5b49-5a51-819e-098dd8a6604c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8e" :db/id #edb/ref 17592186381297} {:answer/id #uuid "a1cf94f7-cef2-596a-922