:answer-field/choices [{:answer/id #uuid "d7c02e33-edf5-5e9a-9dd7-81cb55213e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xz}{\\sqrt{1-{x}^{2}{y}^{2}}}" :db/id #edb/ref 17592186381919} {:answer/id #uuid "2603ddd8-ff44-5138-990c-fd4a215965d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}{y}^{2}}}" :db/id #edb/ref 17592186381920} {:answer/id #uuid "48cc0f63-6ffb-5e32-995f-dc1c121b3cd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{z}{\\sqrt{1-{y}^{2}}}" :db/id #edb/ref 17592186381921} {:answer/id #uuid "177336c7-0dc2-579c-a40e-ed3d123fed1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{\\sqrt{1-{x}^{2}{y}^{2}}}" :db/id #edb/ref 17592186381922} {:answer/id #uuid "5cd8816e-4b58-5f53-b267-eff8ba589cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{yz}{\\sqrt{1-{x}^{2}{y}^{2}}}" :db/id #edb/ref 17592186381923}] :answer-field/correct {:answer/id #uuid "d7c02e33-edf5-5e9a-9dd7-81cb55213e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xz}{\\sqrt{1-{x}^{2}{y}^{2}}}" :db/id #edb/ref 17592186381919} :answer-field/id #uuid "0585b134-bc39-5ad2-9671-a9693974496c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381918}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1970f3e5-319e-5450-8a91-5ac540e3ae28" :question/math-academy-id "q-35715" :question/problem "Find ${g}_{y}(x,y,z)$ given that $g(x,y,z)=z\\operatorname{arcsin}⁡(xy).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nUsing the constant multiple and chain rules, we have\n\n$$\n\\begin{aligned}{g}_{y}(x,y,z) & =\\frac{∂}{∂y}(z\\operatorname{arcsin}⁡(xy)) \\\\  & =z\\cdot \\frac{∂}{∂y}(\\operatorname{arcsin}⁡(xy)) \\\\  & =z\\cdot \\frac{1}{\\sqrt{1-(xy)^{2}}}\\cdot \\frac{∂}{∂y}(xy) \\\\  & =z\\cdot \\frac{1}{\\sqrt{1-(xy)^{2}}}\\cdot (x) \\\\  & =\\frac{xz}{\\sqrt{1-{x}^{2}{y}^{2}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a37ea7ae-4cef-5fcd-9228-e2df831da5fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186382126} {:answer/id #uuid "679825cc-7f11-5343-ae88-84a1ca97e167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{e}^{-1}" :db/id #edb/ref 17592186382127} {:answer/id #uuid "0df78ffc-b050-5411-91a2-dfd4d4406f7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2}" :db/id #edb/ref 17592186382128} {:answer/id #uuid "3cea194b-2a28-5191-a2e3-0a7f014011fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-e" :db/id #edb/ref 17592186382129} {:answer/id #uuid "bb7f3664-511a-5234-bd52-b3ad5619722f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{e}^{-1}" :db/id #edb/ref 17592186382130}] :answer-field/correct {:answer/id #uuid "679825cc-7f11-5343-ae88-84a1ca97e167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{e}^{-1}" :db/id #edb/ref 17592186382127} :answer-field/id #uuid "96d9e209-65c0-591c-9c57-813c74680ed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382125}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "684028b0-fca2-5e81-bf94-98e01d24397f" :question/math-academy-id "q-64906" :question/problem "For the function $f(x,y)={x}^{3}{y}^{2}+{e}^{xy},$ evaluate $\\frac{∂f}{∂x}$ at the point $(-1,1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}{y}^{2}+{e}^{xy}) \\\\  & =\\frac{∂}{∂x}({x}^{3}{y}^{2})+\\frac{∂}{∂x}({e}^{xy})\\end{aligned}\n$$\n\nNow, we use the chain rule and constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}{y}^{2})+{e}^{xy}\\cdot \\frac{∂}{∂x}(xy) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{3})+{e}^{xy}\\cdot y\\cdot \\frac{∂}{∂x}(x) \\\\  & ={y}^{2}\\cdot 3{x}^{2}+{e}^{xy}\\cdot y\\cdot 1 \\\\  & =3{x}^{2}{y}^{2}+y{e}^{xy}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(-1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(-1,1)} & =3(-1)^{2}(1)^{2}+(1){e}^{(-1)(1)} \\\\  & =3+{e}^{-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "faffc889-7ad7-5317-8313-d46fd721c933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}{y}^{2}+2{z}^{4}{e}^{y}" :db/id #edb/ref 17592186382147} {:answer/id #uuid "f262f116-4129-511f-91c6-6ef599a2213c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{x}^{2}{y}^{2}-2{z}^{4}{e}^{2y}" :db/id #edb/ref 17592186382148} {:answer/id #uuid "ec1efe75-1502-501f-aabc-57c0b0f621d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{3}y+4{z}^{3}{e}^{2y}" :db/id #edb/ref 17592186382149} {:answer/id #uuid "69ad3668-cb67-53a3-8444-7e9d5683bcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{3}y-2{z}^{4}{e}^{2y}" :db/id #edb/ref 17592186382150} {:answer/id #uuid "7298654a-25b1-5bdf-8284-a89f479aed3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "