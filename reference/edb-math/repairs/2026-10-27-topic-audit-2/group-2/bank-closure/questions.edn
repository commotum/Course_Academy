db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y^{2}}" :db/id #edb/ref 17592186216609} {:answer/id #uuid "abc9f5b9-bc53-5670-b39c-af1f8c968827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y^{3}}" :db/id #edb/ref 17592186216610} {:answer/id #uuid "56cf23ab-7f91-582e-954d-4adee4a3e857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}" :db/id #edb/ref 17592186216611}] :answer-field/id #uuid "c031e279-077e-5029-a2da-74addad4195b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216607} {:answer-field/choices [{:answer/id #uuid "a49d6c74-b5a7-5d73-b934-356db52c7562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{y^{4}} - 2y = c" :db/id #edb/ref 17592186216613} {:answer/id #uuid "b41f7e2a-1a3e-5839-b87a-c941baf2f173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{y^{3}} - 2y = c" :db/id #edb/ref 17592186216614} {:answer/id #uuid "d4a56924-dcb7-5cf4-8c84-0f73d6a26c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{y^{2}} - 2y^{2} = c" :db/id #edb/ref 17592186216615} {:answer/id #uuid "27c30c51-6505-52b9-a760-7228c987c3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{y^{4}} - 2y^{3} = c" :db/id #edb/ref 17592186216616}] :answer-field/id #uuid "15bbcb71-db2d-5641-91c5-a91a12625a77" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216612}] :question/id #uuid "21520ba3-80e3-5455-9216-9ff33775a80b" :question/math-academy-id "q-337099" :question/problem "Consider the inexact differential equation\n\n$$\n{x}^{2}y\\hspace{0.167em}\\text{d}x-({x}^{3}+2{y}^{4})\\hspace{0.167em}\\text{d}y=0.\n$$\n\nIt is known that \n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{4}{y}\n$$\n\nwhere the functions $P$ and $Q$ are given by \n\n$$\nP(x,y)={x}^{2}y,\\hspace{2em}Q(x,y)=-{x}^{3}-2{y}^{4}.\n$$\n\nUse this information to find a suitable integrating factor $I(y)$ and hence find the general solution to the equation.\n\n$\\hspace{2em}$ A suitable integrating factor is $I(y)=$ {{field-1}}.\n\n$\\hspace{2em}$ The general solution is {{field-2}}, where $c$ is a constant."}]}
