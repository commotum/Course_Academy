′} & =(\\alpha x{e}^{7x})^{′} \\\\  & =\\alpha (x{e}^{7x})^{′} \\\\  & =\\alpha ({e}^{7x}+7x{e}^{7x}) \\\\  & =\\alpha (1+7x){e}^{7x}.\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1+7x){e}^{7x})-7\\alpha x{e}^{7x} & =5{e}^{7x} \\\\ (1+7x-7x)\\alpha {e}^{7x} & =5{e}^{7x} \\\\ \\alpha {e}^{7x} & =5{e}^{7x} \\\\ \\alpha  & =5.\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=5x{e}^{7x}.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{7x}+5x{e}^{7x}.\n$$"}] [{:db/id #edb/ref 17592186308400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77d645f3-858a-5441-98ca-c391f11f6446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{3x}-4{e}^{x}" :db/id #edb/ref 17592186306289}] :answer-field/correct {:answer/id #uuid "77d645f3-858a-5441-98ca-c391f11f6446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{3x}-4{e}^{x}" :db/id #edb/ref 17592186306289} :answer-field/id #uuid "8099e683-1503-5e10-8c12-f1fec8b2ad2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307925}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a04ef1bf-4028-5cae-b670-2200bafd2729" :question/math-academy-id "q-333171" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-3y=8{e}^{x},\\,y(0)=1\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}-3y=8{e}^{x}\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{3x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nWe see that the right-hand side is $8{e}^{x},$ and ${e}^{x}$ is not a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{x},\n$$\n\nwhere $\\alpha $ is a constant to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n{y}_{p}^{′}=\\alpha {e}^{x}.\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha {e}^{x})-3(\\alpha {e}^{x}) & =8{e}^{x} \\\\ (1-3)\\alpha {e}^{x} & =8{e}^{x} \\\\ -2\\alpha {e}^{x} & =8{e}^{x} \\\\ \\alpha  & =-4.\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-4{e}^{x}.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{3x}-4{e}^{x}.\n$$\n\nWe can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}A-4 & =1 \\\\ A & =5.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=5{e}^{3x}-4{e}^{x}.\n$$"}] [{:db/id #edb/ref 17592186308401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4863e38f-9359-50ac-8420-a0903db6b4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{5x}-{e}^{3x}" :db/id #edb/ref 17592186305857}] :answer-field/correct {:answer/id #uuid "4863e38f-9359-50ac-8420-a0903db6b4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answe