}.\n\nThe solution to the initial value problem is $y(x) =$ {{field-2}}."}] [{:db/id #edb/ref 17592186088142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80c8587c-0681-5470-9101-a94e1b865b7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186085490} {:answer/id #uuid "fb495ab0-55e0-5942-940a-f31359be6bdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}" :db/id #edb/ref 17592186085491} {:answer/id #uuid "03d46401-4ffb-5966-b580-0cae904a9ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-x/2}" :db/id #edb/ref 17592186085492} {:answer/id #uuid "1c9fc23f-faa5-5b06-afe2-30ee13c12d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x/2}" :db/id #edb/ref 17592186085493}] :answer-field/id #uuid "c20ffb15-716c-5a92-897c-54544fdac81b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186085489} {:answer-field/choices [{:answer/id #uuid "a3a462de-10b1-50ba-8aa3-3f92d7594674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x - 2 + Ce^{x/2}" :db/id #edb/ref 17592186085495} {:answer/id #uuid "b7f55b30-57a5-5bbe-92c1-e22a93abbb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(x - 2) + Ce^{-x/2}" :db/id #edb/ref 17592186085496} {:answer/id #uuid "ee113825-8acb-52f4-95ae-9a78aa997854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(x - 2) + Ce^{x/2}" :db/id #edb/ref 17592186085497} {:answer/id #uuid "5d1e248e-ec32-5215-bf23-1884dde9a2c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x - 2 + Ce^{-x/2}" :db/id #edb/ref 17592186085498}] :answer-field/id #uuid "e339e5ef-e5d3-5c9a-babd-764bfcb1cffa" :answer-