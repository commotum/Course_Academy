answer/id #uuid "173bb3ab-d1c4-5418-a0cb-92a62d2a96bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{2}^{xh+2y}-{2}^{x+2y}}{h}\\right)" :db/id #edb/ref 17592186275695} {:answer/id #uuid "17deb0e8-1996-51f5-9f32-d42e6ae0b565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{2}^{x+h+2y}-{2}^{x+2y}}{h}\\right)" :db/id #edb/ref 17592186275700} {:answer/id #uuid "1890f986-0ae7-50e5-b62e-c366ead209f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{2}^{x+2h+2y}-{2}^{x+2yy}}{h}\\right)" :db/id #edb/ref 17592186275704} {:answer/id #uuid "628ae353-6c53-5630-93ca-446655a63038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{2}^{x+h+2y}+{2}^{x+2y}}{h}\\right)" :db/id #edb/ref 17592186276369}] :answer-field/correct {:answer/id #uuid "17deb0e8-1996-51f5-9f32-d42e6ae0b565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{2}^{x+h+2y}-{2}^{x+2y}}{h}\\right)" :db/id #edb/ref 17592186275700} :answer-field/id #uuid "2e0f3f0b-6ee6-5967-888b-14889b71b37d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277800}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c2bb34d-dbfd-5a5b-98f2-f7deb6f4851c" :question/math-academy-id "q-159574" :question/problem "Given that $f(x,y)={2}^{x+2y},$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)={2}^{x+2y},$  we have that \n\n$$\nf(x+h,y)={2}^{x+h+2y}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{{2}^{x+h+2y}-{2}^{x+2y}}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186278230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383e0bc9-03cf-5a8c-863c-225af3392d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(x-h+3y)+\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186275974} {:answer/id #uuid "7945ffd3-5f05-5457-a797-f97318f811fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{h\\operatorname{log}⁡(x+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186276578} {:answer/id #uuid "b0c9179d-e8b2-536c-b20f-6906f6eca321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(x+3h+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186277058} {:answer/id #uuid "c35e4727-2498-5dca-8178-4436cb00df14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186277214} {:answer/id #uuid "dda4715e-bd12-5ebe-bfef-6060557727a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(xh+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186277419}] :answer-field/correct {:answer/id #uuid "c35e4727-2498-5dca-8178-4436cb00df14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right)" :db/id #edb/ref 17592186277214} :answer-field/id #uuid "c4ece284-f8fe-594e-b804-399bb52c5e8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278071}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fdf020b6-22cb-53d4-9f16-5ef52a2ed3d5" :question/math-academy-id "q-159579" :question/problem "Given that $f(x,y)=\\operatorname{log}⁡(x+3y),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\operatorname{log}⁡(x+3y),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{log}⁡(x+h+3y).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{\\operatorname{log}⁡(x+h+3y)-\\operatorname{log}⁡(x+3y)}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186278231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f7787dd-304e-5594-887b-b0172efaf02d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi +1" :db/id #edb/ref 17592186276029} {:answer/id #uuid "565547a1-4ccd-54dc-a9ff-90ea2d921c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\pi " :db/id #edb/ref 17592186276246} {:answer/id #uuid "abd54eb7-1086-539a-8add-746e03dd04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi -1" :db/id #edb/ref 17592186277021} {:answer/id #uuid "be3c2156-2c5d-51d6-a50e-e4aace745738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}+1" :db/id #edb/ref 17592186277176} {:answer/id #uuid "e8c6955b-9352-573f-ba2b-3ad0a48e017e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{\\pi }^{2}" :db/id #edb/ref 17592186277514}] :answer-field/correct {:answer/id #uuid "abd54eb7-1086-539a-8add-746e03dd04ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi -1" :db/id #edb/ref 17592186277021} :answer-field/id #uuid "c006b05b-e312-5e14-bc62-bb96f8a28156" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278066}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e406b09c-bfce-50a6-b8a5-dd556a32ecbf" :question/math-academy-id "q-159585" :question/problem "For the function $f(x,y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-xy,$ evaluate ${f}_{x}(0,\\pi ).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y-xy) \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y)-\\frac{∂}{∂x}(xy) \\\\  & =\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x)-y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x)-y\\cdot (1) \\\\  & =\\operatorname{cos}⁡y\\operatorname{cos}⁡x-y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(0,\\pi ):$\n\n$$\n\\begin{aligned}{f}_{x}(0,\\pi ) & =\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡0-\\pi  \\\\  & =(-1)\\cdot 1-\\pi  \\\\  & =-\\pi -1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17151a6a-94bf-55a7-a13b-683abbbb3201" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y-h+2)^{3}}+\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186275693} {:answer/id #uuid "88bb8931-3ab4-597f-ac73-5223c606f67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{(x+h)^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276712} {:answer/id #uuid "8b258731-5747-557a-bf41-f3eb922a6546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276738} {:answer/id #uuid "c9b7a87b-e2a5-587c-b8eb-c96fc0270fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+2h)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186277269} {:answer/id #uuid "d7dbfd03-ca32-5bda-a9d7-8c6f0318343c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{(x+h)^{2}}{(y+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186277376}] :answer-field/correct {:answer/id #uuid "8b258731-5747-557a-bf41-f3eb922a6546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})]" :db/id #edb/ref 17592186276738} :answer-field/id #uuid "a188f0c3-15f8-5c12-aa43-1dce2bcf1a25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278010}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "31a26b77-cde2-5225-9c1c-15176a7705f8" :question/math-academy-id "q-159589" :question/problem "Given that $f(x,y)=\\frac{{x}^{2}}{(y+2)^{3}},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{f(x,y+h)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\frac{{x}^{2}}{(y+2)^{3}},$  we have that \n\n$$\nf(x,y+h)=\\frac{{x}^{2}}{(y+h+2)^{3}}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}[\\frac{1}{h}(\\frac{{x}^{2}}{(y+h+2)^{3}}-\\frac{{x}^{2}}{(y+2)^{3}})].\n$$"}] [{:db/id #edb/ref 17592186278233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249ebeac-e510-559d-a04e-8e2375a2831c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{xyh}-{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186275806} {:answer/id #uuid "4c0ac94f-8e99-53ac-8de2-0c4f79ea8d3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{xy+h}-{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186276146} {:answer/id #uuid "98310189-0e48-5672-8231-757b76da0ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186276845} {:answer/id #uuid "ab929482-7885-5340-ac99-508b3d867148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{x(y-h)}+{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186277019} {:answer/id #uuid "f822d8e0-bdc3-5436-a10f-0e2f3829e6db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{xy-h}+{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186277646}] :answer-field/correct {:answer/id #uuid "98310189-0e48-5672-8231-757b76da0ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h}\\right)" :db/id #edb/ref 17592186276845} :answer-field/id #uuid "b234f6ec-b3e8-5cd0-a075-9cdfd38eace2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278035}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96b9d7fd-e6bd-5861-b4a2-0c2b1d143000" :question/math-academy-id "q-159593" :question/problem "Given that $f(x,y)={3}^{xy},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{f(x,y+h)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)={3}^{xy},$  we have that \n\n$$\nf(x,y+h)={3}^{x(y+h)}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{{3}^{x(y+h)}-{3}^{xy}}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186278234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a7ffcb1-b787-5688-a29a-b14cbb4f5d13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-yh}+\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186275865} {:answer/id #uuid "387f4d00-3ca9-5bc5-88ef-bdb211870301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{h\\sqrt[3]{{x}^{2}-y}-\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186275977} {:answer/id #uuid "60dd8e6e-8fb3-5403-b935-b1d6062ef077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-(y-h)}+\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186276350} {:answer/id #uuid "b8904d3e-ea3f-58de-a7d5-6645fe9d0a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-yh}-\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186277113} {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186277469}] :answer-field/correct {:answer/id #uuid "e436179e-0aae-5046-8432-58d235c36750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h}\\right)" :db/id #edb/ref 17592186277469} :answer-field/id #uuid "8be9e607-3ca8-5c79-b594-28cdaa505ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277975}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "53daed36-1f31-5b2b-8966-96a4d35c598d" :question/math-academy-id "q-159594" :question/problem "Given that $f(x,y)=\\sqrt[3]{{x}^{2}-y},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{f(x,y+h)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\sqrt[3]{{x}^{2}-y},$  we have that \n\n$$\nf(x,y+h)=\\sqrt[3]{{x}^{2}-(y+h)}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186278235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45268c40-f590-50a8-ba1a-21b858fce141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276088} {:answer/id #uuid "6951a819-e923-55cf-bd46-3c7b08d10b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-e" :db/id #edb/ref 17592186276422} {:answer/id #uuid "87075966-f8e5-53bf-a25f-6d732f4d7578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186276690} {:answer/id #uuid "ab0146c6-98b7-5f6f-8fc2-b635a9e8a5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186277013} {:answer/id #uuid "c59e102d-a80d-5341-bb04-c1b2868dc317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186277235}] :answer-field/correct {:answer/id #uuid "6951a819-e923-55cf-bd46-3c7b08d10b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-e" :db/id #edb/ref 17592186276422} :answer-field/id #uuid "b3c719af-bf0c-5f78-a3a9-113baf55c4f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278039}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff776960-64d0-5d6e-aeb2-a63fd457dce4" :question/math-academy-id "q-159597" :question/problem "For the function $f(x,y)={x}^{3}\\operatorname{ln}⁡y-2y\\sqrt{x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,e).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}\\operatorname{ln}⁡y-2y\\sqrt{x}) \\\\  & =\\frac{∂}{∂x}({x}^{3}\\operatorname{ln}⁡y)-\\frac{∂}{∂x}(2y\\sqrt{x}) \\\\  & =\\operatorname{ln}⁡y\\cdot \\frac{∂}{∂x}({x}^{3})-2y\\cdot \\frac{∂}{∂x}(\\sqrt{x}) \\\\  & =\\operatorname{ln}⁡y\\cdot (3{x}^{2})-2y\\cdot \\left(\\frac{1}{2\\sqrt{x}}\\right) \\\\  & =3{x}^{2}\\operatorname{ln}⁡y-\\frac{y}{\\sqrt{x}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,e):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,e)} & =3\\cdot {1}^{2}\\cdot \\operatorname{ln}⁡e-\\frac{e}{\\sqrt{1}} \\\\  & =3-e\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32674586-4e3a-5879-b109-f0eb8a8c0450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186275924} {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} {:answer/id #uuid "a7c2cdb1-d291-595f-9c08-8200c680205a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186276990} {:answer/id #uuid "cfe844ab-c3d