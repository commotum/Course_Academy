-b30e-18510d8360b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186275708} {:answer/id #uuid "56d691d2-2344-50e8-b755-1515d6701246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186276253} {:answer/id #uuid "8909b9e2-69c1-5292-8bb6-bb0f8619ca13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276715} {:answer/id #uuid "be12f9bb-678a-5eac-a78c-690ff881310b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277173} {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507}] :answer-field/correct {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507} :answer-field/id #uuid "16fdfad6-c4ab-5074-9d21-20b8c8a78547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277765}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "099a0674-bec3-5a03-b0cd-02423c11a6a6" :question/math-academy-id "q-159602" :question/problem "For the function $f(x,y)=4y{x}^{2}-x{y}^{4},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(4y{x}^{2}-x{y}^{4}) \\\\  & =\\frac{∂}{∂y}(4y{x}^{2})-\\frac{∂}{∂y}(x{y}^{4}) \\\\  & =4{x}^{2}\\cdot \\frac{∂}{∂y}(y)-x\\cdot \\frac{∂}{∂y}({y}^{4}) \\\\  & =4{x}^{2}\\cdot (1)-x\\cdot (4{y}^{3}) \\\\  & =4{x}^{2}-4x{y}^{3}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(2,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,1)} & =4\\cdot {2}^{2}-4\\cdot 2\\cdot {1}^{3} \\\\  & =16-8 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} {:answer/id #uuid "2307c0e9-79a7-5b71-94fb-81d1846549c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186275789} {:answer/id #uuid "24ba32c9-8d5c-5863-b6a3-b590ddbbf12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275808} {:answer/id #uuid "2bdb0760-9291-5b88-884e-ce3f76c09234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275876} {:answer/id #uuid "cfdca77f-9773-5630-851d-65b8078cfedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277318}] :answer-field/correct {:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} :answer-field/id #uuid "370efeef-a1d5-51c2-8154-bfdd43bcb49d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277810}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "761131e3-fd5c-5281-9b00-7e9bad552026" :question/math-academy-id "q-159607" :question/problem "For the function $f(x,y)=x\\operatorname{sec}⁡y+{x}^{4}y,$ evaluate ${f}_{y}(\\sqrt{2},\\frac{\\pi }{4}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y+{x}^{4}y) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y)+\\frac{∂}{∂y}({x}^{4}y) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\operatorname{sec}⁡y)+{x}^{4}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot (\\operatorname{sec}⁡y\\operatorname{tan}⁡y)+{x}^{4}\\cdot (1) \\\\  & =x\\operatorname{sec}⁡y\\operatorname{tan}⁡y+{x}^{4}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\sqrt{2},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}{f}_{y}(\\sqrt{2},\\frac{\\pi }{4}) & =\\sqrt{2}\\cdot \\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)\\cdot \\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)+{(\\sqrt{2})}^{4} \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1+4 \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186275720} {:answer/id #uuid "48d4574b-09ae-5cd7-8667-6addc311e93c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186276125} {:answer/id #uuid "5524be5e-28f5-5433-a5d3-d73957b779a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+{x}^{2}\\operatorname{ln}⁡y" :db/id #edb/ref 17592186276234} {:answer/id #uuid "60ced972-1fd7-5d9e-89b4-5b1ed89abe9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+2x\\operatorname{ln}⁡y" :db/id #edb/ref 17592186276347} {:answer/id #uuid "c6e6df92-0fe0-52bf-ad68-64d6651fef07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+\\frac{2x}{y}" :db/id #edb/ref 17592186277246}] :answer-field/correct {:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186275720} :answer-field/id #uuid "9501b870-d0cb-5b61-aa64-68a74b0b08a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c020eea-053d-5f14-b5a2-c9f697a99828" :question/math-academy-id "q-159613" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=xy+{x}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =\\frac{∂}{∂y}(xy)+\\frac{∂}{∂y}({x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y) \\\\  & =x\\cdot 1+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x+\\frac{{x}^{2}}{y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb6e91c-e353-5113-a18f-0395e4a6e343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{{y}^{2}}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186276032} {:answer/id #uuid "4118aa52-6cf2-5999-9929-8a5819037289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276047} {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} {:answer/id #uuid "ebaecd0a-b971-5e92-b62d-28ceae190dc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{{y}^{2}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186277539} {:answer/id #uuid "f0a09a6f-356b-5b97-85dc-4fbfa42ac95a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}-\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186277589}] :answer-field/correct {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} :answer-field/id #uuid "e473ea39-99a3-5f5a-9eb6-13ee0b150617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278125}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "198d06c9-ec80-5c14-815c-c9ec68f7a2d2" :question/math-academy-id "q-159616" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=\\frac{x}{y}-\\frac{y}{{x}^{2}}.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the constant multiple rule for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y}-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{∂}{∂x}\\left(\\frac{x}{y}\\right)-\\frac{∂}{∂x}\\left(\\frac{y}{{x}^{2}}\\right) \\\\  & =\\frac{1}{y}\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}\\left(\\frac{1}{{x}^{2}}\\right) \\\\  & =\\frac{1}{y}\\cdot (1)-y\\cdot \\left(-\\frac{2}{{x}^{3}}\\right) \\\\  & =\\frac{1}{y}+\\frac{2y}{{x}^{3}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186275545} {:answer/id #uuid "2959b683-8721-5d47-ae28-bfdae8458730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}-16y" :db/id #edb/ref 17592186275851} {:answer/id #uuid "8368ea87-f533-59c5-8779-19322eca007e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡x-16y" :db/id #edb/ref 17592186276659} {:answer/id #uuid "bd6ef288-08fc-5b25-a851-71488d467d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186277165} {:answer/id #uuid "ecc63446-669b-52c7-a4ab-fb4eec89773e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{arcsin}⁡x" :db/id #edb/ref 17592186277553}] :answer-field/correct {:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186275545} :answer-field/id #uuid "ad8d61fd-1884-5c25-bcf8-efd036093e2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fe04cdb-3f03-5a9d-a32d-3dd7d276f6a2" :question/math-academy-id "q-159619" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=y\\operatorname{arcsin}⁡x-8{y}^{2}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x-8{y}^{2}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x)-\\frac{∂}{∂x}(8{y}^{2}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{arcsin}⁡x)-8{y}^{2}\\frac{∂}{∂x}(1) \\\\  & =y\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-0 \\\\  & =\\frac{y}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0ec142-6a42-5919-bfa1-4366a65092fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186275741} {:answer/id #uuid "4619d482-5733-51a3-96e0-8ad693700d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{e}^{2x+3y}+6x{y}^{2}" :db/id #edb/ref 17592186276096} {:answer/id #uuid "4c062e4a-ec8c-5adf-8963-947c77e772cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+6x{y}^{2}" :db/id #edb/ref 17592186276145} {:answer/id #uuid "733056c4-4ea1-5358-977a-a7c64e073092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x+3y}+2x{y}^{3}" :db/id #edb/ref 17592186276520} {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186277035}] :answer-field/correct {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186277035} :answer-field/id #uuid "4348a5dd-f992-5c0f-a358-d3667a2d63fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5ed8a7e6-be3b-5de6-bfb2-8c47db49086f" :question/math-academy-id "q-159623" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)={e}^{2x+3y}+{x}^{2}{y}^{3}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum rule for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{2x+3y}+{x}^{2}{y}^{3}) \\\\  & =\\frac{∂}{∂y}({e}^{2x}\\cdot {e}^{3y})+\\frac{∂}{∂y}({x}^{2}{y}^{3}) \\\\  & ={e}^{2x}\\cdot \\frac{∂}{∂y}({e}^{3y})+{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{3}) \\\\  & ={e}^{2x}\\cdot 3{e}^{3y}+{x}^{2}\\cdot 3{y}^{2} \\\\  & =3{e}^{2x+3y}+3{x}^{2}{y}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2fd4076-e762-5242-adfc-f4e6cb508ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7x(y+h))-\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381176} {:answer/id #uuid "660727fe-a41a-5769-91f2-4c44ac360a56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7x(y-h))+\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381177} {:answer/id #uuid "1838f68c-7ac5-515e-aa5e-11752c7e1cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7(x+h)(y+h))-\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381178} {:answer/id #uuid "02164e1c-6b30-50b3-8f91-eeddea866e0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{h\\operatorname{ln}⁡(7xy)-\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381179} {:answer/id #uuid "21ccd40f-30bf-5218-9e66-8cceeec891d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7xyh)-\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381180}] :answer-field/correct {:answer/id #uuid "a2fd4076-e762-5242-adfc-f4e6cb508ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7x(y+h))-\\operatorname{ln}⁡(7xy)}{h}\\right)" :db/id #edb/ref 17592186381176} :answer-field/id #uuid "c914a4e9-03cd-5d1d-af6f-38faa9b11f46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381175}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c0019cf-9f1b-5e4a-8594-fc0063073eea" :question/math-academy-id "q-159584" :question/problem "Given that $f(x,y)=\\operatorname{ln}⁡(7xy),$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{f(x,y+h)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\operatorname{ln}⁡(7xy),$  we have that \n\n$$\nf(x,y+h)=\\operatorname{ln}⁡(7x(y+h)).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{\\operatorname{ln}⁡(7x(y+h))-\\operatorname{ln}⁡(7xy)}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186381181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383a34d-6e32-5f0f-87b8-e7ec3d81fb75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186381183} {:answer/id #uuid "f18943a3-6ebe-57f1-9bae-7fc754040e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186381184} {:answer/id #uuid "062115ff-ad39-57f6-a416-c53bab27effc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186381185} {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} {:answer/id #uuid "5f7541dc-dac5-5424-9421-52ce964411eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186381187}] :answer-field/correct {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} :answer-field/id #uuid "7d6eafe7-491c-520d-9960-7135619c340c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381182}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83c38041-fc9b-546f-afa6-2d3c332d1b5a" :question/math-academy-id "q-159587" :question/problem "For the function $f(x,y)={y}^{2}\\sqrt{x}+\\frac{x}{y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(4,2).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+\\frac{x}{y}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+x{y}^{-1}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x})+\\frac{∂}{∂y}(x{y}^{-1}) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂y}({y}^{2})+x\\cdot \\frac{∂}{∂y}({y}^{-1}) \\\\  & =\\sqrt{x}\\cdot (2y)+x\\cdot (-{y}^{-2}) \\\\  & =2y\\sqrt{x}-x{y}^{-2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,2):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(4,2)} & =2\\cdot 2\\cdot \\sqrt{4}-4\\cdot {2}^{-2} \\\\  & =8-1 \\\\  & =7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13833f19-5564-5576-bebd-f5954b425482" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{y-h}+{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381190} {:answer/id #uuid "5b85e5ec-9555-5859-9a4f-7cb585c99a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{yh}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381191} {:answer/id #uuid "f31e5de1-20d8-5a67-9ff4-22829d0328ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y+h}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381192} {:answer/id #uuid "c5587b30-c56c-51fb-bedd-4acebd010a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{y+h}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381193} {:answer/id #uuid "0737f705-f646-52a2-ad7c-661e8f5e2bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381194}] :answer-field/correct {:answer/id #uuid "c5587b30-c56c-51fb-bedd-4acebd010a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{y+h}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186381193} :answer-field/id #uuid "9ed4acb9-9999-5592-9a17-9e0a5dd42c14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381189}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f02ee2a-1487-5adc-ad30-bf559dca8927" :question/math-academy-id "q-159592" :question/problem "Given that $f(x,y)={x}^{y},$ then $\\frac{∂f}{∂y}=$" :question/worked-solution "The derivative of $f$ with respect to $y$ is given by the limit \n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{f(x,y+h)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)={x}^{y},$  we have that \n\n$$\nf(x,y+h)={x}^{y+h}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂y}=\\lim_{h\\to 0}\\left(\\frac{{x}^{y+h}-{x}^{y}}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186381195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb46f74-a6ac-51dd-9716-053467775795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186381197} {:answer/id #uuid "7c752b1e-3494-58b3-91b3-bc63d9070f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381198} {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} {:answer/id #uuid "57c21eba-c639-589d-a590-6b2758f94e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186381200} {:answer/id #uuid "437f7400-06af-5d12-8795-82aceaaa029f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186381201}] :answer-field/correct {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} :answer-field/id #uuid "3bc66302-048f-5b61-a77f-e57947059d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381196}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85a0874e-f8e3-58ee-a763-3ef7eef71825" :question/math-academy-id "q-159600" :question/problem "For the function $f(x,y)=2x\\sqrt{y}-4y\\sqrt{x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,4).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(2x\\sqrt{y}-4y\\sqrt{x}) \\\\  & =\\frac{∂}{∂x}(2x\\sqrt{y})-\\frac{∂}{∂x}(4y\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot \\frac{∂}{∂x}(x)-4y\\cdot \\frac{∂}{∂x}(\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot (1)-4y\\cdot \\left(\\frac{1}{2\\sqrt{x}}\\right) \\\\  & =2\\sqrt{y}-\\frac{2y}{\\sqrt{x}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,4):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,4)} & =2\\sqrt{4}-\\frac{2\\cdot 4}{\\sqrt{1}} \\\\  & =4-8 \\\\  & =-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fcd07b7-50b4-5ed1-b9d3-2a201e5d7d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186381204} {:answer/id #uuid "1def416a-9115-5f32-affa-b8039b5e3e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186381205} {:answer/id #uuid "c69f5c3f-2861-5ba1-aeb3-abdd43e0cb6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186381206} {:answer/id #uuid "70a9f79d-b5dc-5ada-901e-3f661c7aa60d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186381207} {:answer/id #uuid "1d3a15eb-a517-5392-b575-6d93c1835d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }-\\pi " :db/id #edb/ref 17592186381208}] :answer-field/correct {:answer/id #uuid "c69f5c3f-2861-5ba1-aeb3-abdd43e0cb6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186381206} :answer-field/id #uuid "6a6cd008-5190-5b59-930e-c8142bae276f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381203}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b549b8fe-2ea6-52d5-aba5-f73f5834b6db" :question/math-academy-id "q-159601" :question/problem "For the function $f(x,y)=\\operatorname{cos}⁡x\\operatorname{ln}⁡y-x\\operatorname{sin}⁡y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,\\frac{\\pi }{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{ln}⁡y-x\\operatorname{sin}⁡y) \\\\  & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{ln}⁡y)-\\frac{∂}{∂y}(x\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)-x\\cdot \\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡x\\cdot \\left(\\frac{1}{y}\\right)-x\\cdot (\\operatorname{cos}⁡y) \\\\  & =\\frac{\\operatorname{cos}⁡x}{y}-x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi ,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(\\pi ,\\pi /2)} & =\\frac{\\operatorname{cos}⁡\\pi }{\\left(\\frac{\\pi }{2}\\right)}-\\pi \\cdot \\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =-\\frac{2}{\\pi }-0 \\\\  & =-\\frac{2}{\\pi }\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0ef6ef-d5c2-5f7d-b007-5d1f8bcb76dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186381211} {:answer/id #uuid "d2d3c50a-be40-5168-9b60-89cddf3610ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\pi " :db/id #edb/ref 17592186381212} {:answer/id #uuid "885ea363-dc99-5baa-bdb0-83b42d304c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186381213} {:answer/id #uuid "7e4f7612-4c6b-5535-81d9-f5903c791c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\pi " :db/id #edb/ref 17592186381214} {:answer/id #uuid "f9925be6-c2b3-5b22-8f0f-b02e6fe00ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2\\pi " :db/id #edb/ref 17592186381215}] :answer-field/correct {:answer/id #uuid "7e4f7612-4c6b-5535-81d9-f5903c791c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-\\pi " :db/id #edb/ref 17592186381214} :answer-field/id #uuid "47162c79-8d31-5bc6-a2b7-3b78e065d6f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381210}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4e2a2cf2-39c7-5aaf-aba5-b368c09836a4" :question/math-academy-id "q-159606" :question/problem "For the function $f(x,y)={y}^{3}\\operatorname{cot}⁡x-{x}^{2}{y}^{2},$ evaluate ${f}_{x}(\\frac{\\pi }{2},1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({y}^{3}\\operatorname{cot}⁡x-{x}^{2}{y}^{2}) \\\\  & =\\frac{∂}{∂x}({y}^{3}\\operatorname{cot}⁡x)-\\frac{∂}{∂x}({x}^{2}{y}^{2}) \\\\  & ={y}^{3}\\cdot \\frac{∂}{∂x}(\\operatorname{cot}⁡x)-{y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2}) \\\\  & ={y}^{3}\\cdot (-{csc}^{2}⁡x)-{y}^{2}\\cdot (2x) \\\\  & =-{y}^{3}{csc}^{2}⁡x-2x{y}^{2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\frac{\\pi }{2},1):$\n\n$$\n\\begin{aligned}{f}_{x}(\\frac{\\pi }{2},1) & =-(1)^{3}\\cdot {csc}^{2}⁡\\left(\\frac{\\pi }{2}\\right)-2\\cdot \\frac{\\pi }{2}\\cdot {1}^{2} \\\\  & =-1\\cdot 1-\\pi  \\\\  & =-1-\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051af5b2-726e-5b49-a969-9796e797ae3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381218} {:answer/id #uuid "ecde6fb6-675d-59f3-9850-531e953ba33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381219} {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} {:answer/id #uuid "a24feefe-3cbe-5e42-b271-0ac95ae87b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{csc}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381221} {:answer/id #uuid "faa81e86-4ae1-53c8-8b77-4618058650b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381222}] :answer-field/correct {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} :answer-field/id #uuid "e9775693-9681-5414-8d66-ab2776e2f417" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381217}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "26ca0866-34da-5a8a-8819-c0314d3abbb7" :question/math-academy-id "q-159611" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)={x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}) \\\\  & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y)-\\frac{∂}{∂y}({3}^{x}\\cdot {3}^{y}) \\\\  & ={x}^{3}\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡y)-{3}^{x}\\cdot \\frac{∂}{∂y}({3}^{y}) \\\\  & ={x}^{3}\\cdot {sec}^{2}⁡y-{3}^{x}\\cdot {3}^{y}\\operatorname{ln}⁡3 \\\\  & ={x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc01c4d-160a-5eea-af63-34bb0d6f5cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381225} {:answer/id #uuid "c56e8f59-813f-5140-bc33-6355f2e8c8f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381226} {:answer/id #uuid "f4c320e0-173a-55b6-b2fe-6e2df1ef3a1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381227} {:answer/id #uuid "23510347-ad72-510f-9453-61fb93eb4c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381228} {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229}] :answer-field/correct {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229} :answer-field/id #uuid "107fee59-5ae8-5849-9751-9c38f3f036ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381224}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a343ea27-2d89-5c6e-9038-e851b2a44521" :question/math-academy-id "q-159614" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=5y-2\\operatorname{sin}⁡x.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(5y-2\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(5y)-\\frac{∂}{∂x}(2\\operatorname{sin}⁡x) \\\\  & =5\\cdot \\frac{∂}{∂x}(y)-2\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & =5\\cdot (0)-2\\cdot (\\operatorname{cos}⁡x) \\\\  & =-2\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42294efd-0726-56da-9ff2-aacaa739035d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{{y}^{5}}+6x" :db/id #edb/ref 17592186381232} {:answer/id #uuid "e692a74c-4360-52d2-9a3b-14b7bb724d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12{x}^{2}}{{y}^{4}}+6" :db/id #edb/ref 17592186381233} {:answer/id #uuid "e8ed405c-d0bb-58ec-9cb0-db66e314a0e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{3}}{{y}^{5}}+6y" :db/id #edb/ref 17592186381234} {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} {:answer/id #uuid "1c43e727-621e-5491-9269-e9a7064dc12d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{{y}^{5}}+6" :db/id #edb/ref 17592186381236}] :answer-field/correct {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} :answer-field/id #uuid "88fa3ce5-5c28-5db2-ada3-b42ead245d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381231}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55f3a1d2-cb7d-5965-acea-2992a42840fe" :question/math-academy-id "q-159618" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\frac{{x}^{3}}{{y}^{4}}+6xy.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}}+6xy) \\\\  & =\\frac{∂}{∂x}\\left(\\frac{{x}^{3}}{{y}^{4}}\\right)+\\frac{∂}{∂x}(6xy) \\\\  & =\\frac{1}{{y}^{4}}\\frac{∂}{∂x}({x}^{3})+6y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{{y}^{4}}\\cdot 3{x}^{2}+6y\\cdot 1 \\\\  & =\\frac{3{x}^{2}}{{y}^{4}}+6y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186381237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6f0ef5-d53d-5837-98c8-631186129434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{y}^{3}-\\frac{24y}{{x}^{5}}" :db/id #edb/ref 17592186381239} {:answer/id #uuid "cd8e251a-8b10-5e05-b8e9-664d5a11015b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x{y}^{3}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381240} {:answer/id #uuid "b39b7828-0e78-591c-b643-6a8cdf575bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32x{y}^{3}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381241} {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} {:answer/id #uuid "4b9203e9-d678-558b-b50c-6a4193709f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381243}] :answer-field/correct {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} :answer-field/id #uuid "3225480b-17a3-5de3-a894-3b9c909ffb27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381238}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54a3e289-7644-5884-8f3d-09b4adcf7d3d" :question/math-academy-id "q-159621" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =\\frac{∂}{∂x}(8x{y}^{4})+\\frac{∂}{∂x}\\left(\\frac{3{y}^{2}}{{x}^{4}}\\right) \\\\  & =8{y}^{4}\\cdot \\frac{∂}{∂x}(x)+3{y}^{2}\\cdot \\frac{∂}{∂x}\\left(\\frac{1}{{x}^{4}}\\right) \\\\  & =8{y}^{4}\\cdot 1+3{y}^{2}\\cdot \\left(-\\frac{4}{{x}^{5}}\\right) \\\\  & =8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436293} {:answer/id #uuid "9023fe86-f4d4-53cf-afa7-ceab284c385c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{y}" :db/id #edb/ref 17592186436306} {:answer/id #uuid "a479ae38-298e-5258-8558-f1d904df696f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{y}+y{e}^{x}" :db/id #edb/ref 17592186436312} {:answer/id #uuid "e1294690-bb34-5896-b0c1-f42f98fe8355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436319} {:answer/id #uuid "ffa0af21-05d8-5b41-b926-c8615ac23faf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}" :db/id #edb/ref 17592186436323}] :answer-field/correct {:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436293} :answer-field/id #uuid "ec0f419d-2a0d-5de9-af19-f4de7b215052" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436328}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ea23849-68e0-52dc-ba91-b8da7ebd925a" :question/math-academy-id "q-159624" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)=x{e}^{y}+y{e}^{x}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x{e}^{y}+y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂y}(y{e}^{x}) \\\\  & =x\\cdot \\frac{∂}{∂y}({e}^{y})+{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot {e}^{y}+{e}^{x}\\cdot 1 \\\\  & =x{e}^{y}+{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a19112-03ca-50b8-84a1-fe692ba95087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30\\operatorname{ln}⁡3" :db/id #edb/ref 17592186436300} {:answer/id #uuid "60c0f614-7c90-5e8c-8d18-e07fc305806f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-5" :db/id #edb/ref 17592186436301} {:answer/id #uuid "9e7a5161-9c2f-5c14-b85f-c8f0665e4971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186436308} {:answer/id #uuid "a2ff159b-22e8-5203-b53e-81a9138124a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-30" :db/id #edb/ref 17592186436311} {:answer/id #uuid "e9c6a17e-95c5-56f6-8ecd-f1ad41f668be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-10" :db/id #edb/ref 17592186436322}] :answer-field/correct {:answer/id #uuid "a2ff159b-22e8-5203-b53e-81a9138124a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-30" :db/id #edb/ref 17592186436311} :answer-field/id #uuid "db764a00-316f-56d9-8f40-2a0441db7ae8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436327}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "90392678-f725-5c12-933c-87fa3256c47c" :question/math-academy-id "q-159609" :question/problem "For the function $f(x,y)=y\\operatorname{ln}⁡x-2{x}^{5}{e}^{y},$ evaluate ${f}_{x}(1,\\operatorname{ln}⁡3).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x-2{x}^{5}{e}^{y}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x)-\\frac{∂}{∂x}(2{x}^{5}{e}^{y}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{ln}⁡x)-2{e}^{y}\\cdot \\frac{∂}{∂x}({x}^{5}) \\\\  & =y\\cdot \\left(\\frac{1}{x}\\right)-2{e}^{y}\\cdot (5{x}^{4}) \\\\  & =\\frac{y}{x}-10{x}^{4}{e}^{y}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\operatorname{ln}⁡3):$\n\n$$\n\\begin{aligned}{f}_{x}(1,\\operatorname{ln}⁡3) & =\\frac{\\operatorname{ln}⁡3}{1}-10\\cdot {1}^{4}\\cdot {e}^{\\operatorname{ln}⁡3} \\\\  & =\\operatorname{ln}⁡3-10\\cdot 3 \\\\  & =\\operatorname{ln}⁡3-30\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19821da5-f0d9-5231-b6e6-57d05a583c98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y}+{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436292} {:answer/id #uuid "31ac6394-634c-5df7-8435-c91eb48acad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436295} {:answer/id #uuid "3ca1bb65-4836-5031-98cd-687ce371b497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{y+h}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436296} {:answer/id #uuid "88c4c69c-b8ec-5afa-8545-f80894277b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y+h}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436305} {:answer/id #uuid "dd81c589-9abe-5852-882a-90489739a54c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{{x}^{y+h}+{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436317}] :answer-field/correct {:answer/id #uuid "31ac6394-634c-5df7-8435-c91eb48acad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y}-{x}^{y}}{h}\\right)" :db/id #edb/ref 17592186436295} :answer-field/id #uuid "76655532-0bc3-55d8-ba79-572397ad3e3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436326}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9785714b-27e4-57d0-bac5-65edf8d118a2" :question/math-academy-id "q-159575" :question/problem "Given that $f(x,y)={x}^{y},$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)={x}^{y},$  we have that \n\n$$\nf(x+h,y)=(x+h)^{y}.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{(x+h)^{y}-{x}^{y}}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186436333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5347b519-c490-5531-86d9-c47823454ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{y}^{2}" :db/id #edb/ref 17592186436298} {:answer/id #uuid "55c2293e-6cda-5e44-a3be-cf42f0b0106e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡y-{y}^{2}" :db/id #edb/ref 17592186436299} {:answer/id #uuid "6d40833e-3b6e-5b26-96b6-154dbe238c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6xy}{1+{y}^{2}}" :db/id #edb/ref 17592186436304} {:answer/id #uuid "a2853c1d-4c78-58f1-877e-d34353665049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-{y}^{2}" :db/id #edb/ref 17592186436310} {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id #edb/ref 17592186436313}] :answer-field/correct {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id #edb/ref 17592186436313} :answer-field/id #uuid "1ad15885-4f52-5353-a9a6-c3dae29fe5c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436324}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ca64fedb-1539-5dab-a00d-8a624f81d8c4" :question/math-academy-id "q-159612" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=3\\operatorname{arctan}⁡y-x{y}^{2}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y-x{y}^{2}) \\\\  & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y)-\\frac{∂}{∂y}(x{y}^{2}) \\\\  & =3\\cdot \\frac{∂}{∂y}(\\operatorname{arctan}⁡y)-x\\cdot \\frac{∂}{∂y}({y}^{2}) \\\\  & =3\\cdot \\frac{1}{1+{y}^{2}}-x\\cdot 2y \\\\  & =\\frac{3}{1+{y}^{2}}-2xy\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fd8c41-938d-5896-af76-a08ef933364a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(x+h-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436289} {:answer/id #uuid "14ea137a-7846-516f-9915-09b5b41d82fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(xh-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436291} {:answer/id #uuid "3cd25198-8ccd-5ecb-ab36-bbba0fbb0d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(x+h-{y}^{2})+\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436297} {:answer/id #uuid "642b4c1b-1346-5ee7-abed-a5e7648fbb56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(xh-{y}^{2})+\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436302} {:answer/id #uuid "959569af-b23a-5e0d-8446-2bab69573083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{h\\operatorname{cos}⁡(x-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436307}] :answer-field/correct {:answer/id #uuid "04fd8c41-938d-5896-af76-a08ef933364a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(x+h-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right)" :db/id #edb/ref 17592186436289} :answer-field/id #uuid "25a45b6b-9452-510a-88d9-fa6cff3a05a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea65f87f-49a7-5b8c-93db-0d61d7663ef3" :question/math-academy-id "q-159576" :question/problem "Given that $f(x,y)=\\operatorname{cos}⁡(x-{y}^{2}),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\operatorname{cos}⁡(x-{y}^{2}),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{cos}⁡(x+h-{y}^{2}).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{\\operatorname{cos}⁡(x+h-{y}^{2})-\\operatorname{cos}⁡(x-{y}^{2})}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186436335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0966d4fd-1004-5375-90cf-1757ff705f99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡((x+h)(y+h))-\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436290} {:answer/id #uuid "6c6f24d2-f9ef-5de6-894b-96a6e11cae68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡(xy+h)-\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436303} {:answer/id #uuid "b4733487-8f20-5482-b97a-b62fc0d6cb76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡(xy+h)+\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436314} {:answer/id #uuid "dd8fe9b0-2dfe-5cce-8bde-270fb503d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436318} {:answer/id #uuid "e34026d0-8c07-5e65-85c3-9dc96c50dbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡(x(y+h))-\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436320}] :answer-field/correct {:answer/id #uuid "dd8fe9b0-2dfe-5cce-8bde-270fb503d4de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h}\\right)" :db/id #edb/ref 17592186436318} :answer-field/id #uuid "fb776df8-d18c-56c6-b0af-71e18ee9b2ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436329}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fab082ec-08e1-574d-8102-367e3c718114" :question/math-academy-id "q-159572" :question/problem "Given that $f(x,y)=\\operatorname{sin}⁡(xy),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x)=\\operatorname{sin}⁡(xy),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{sin}⁡((x+h)y).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}=\\lim_{h\\to 0}\\left(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h}\\right).\n$$"}] [{:db/id #edb/ref 17592186560258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29ae3e04-d75d-5e50-a1d8-2e2f3b14548a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186560263} {:answer/id #uuid "4f8f0941-242b-56dc-acb3-8445828e2e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186560272} {:answer/id #uuid "6e428339-ef99-55d2-b4e3-6051ca192247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186560278} {:answer/id #uuid "7479ca5f-2358-5e22-8cd3-5525c5bd7322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186560280} {:answer/id #uuid "e3f4b07d-d167-52a6-8ffe-b705d15b6344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186560293}] :answer-field/correct {:answer/id #uuid "29ae3e04-d75d-5e50-a1d8-2e2f3b14548a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186560263} :answer-field/id #uuid "6bd013bf-07bc-5cb9-a7a8-da55318ffd08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "147e9a52-51e2-5c74-9d4e-fa093aa4d65f" :question/problem "For the function $f(x,y)=4 y^{2} x^{2}+2 y x,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,-1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(4 y^{2} x^{2}+2 y x) \\\\  & =\\frac{∂}{∂y}(4 y^{2} x^{2})+\\frac{∂}{∂y}(2 y x) \\\\  & =4 x^{2}\\cdot \\frac{∂}{∂y}(y^{2})+2 x\\cdot \\frac{∂}{∂y}(y) \\\\  & =4 x^{2}\\cdot (2 y)+2 x\\cdot (1) \\\\  & =8 y x^{2}+2 x\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,-1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,-1)} & =8 (-1) (1)^{2}+2 (1) \\\\  & =-8+(2) \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186560267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281c0703-b852-50f5-8381-792285de4691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186560261} {:answer/id #uuid "3d071372-a702-5054-9530-d8a986bccb43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186560269} {:answer/id #uuid "42ae0e48-13dc-5b0f-b8c1-406c19758160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value 