/id #uuid "16aa8fa2-7aff-5caf-8b68-dbc93bde4617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186308924} {:answer/id #uuid "39c3126f-f605-5fdb-a8f6-4beb75098139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186309190} {:answer/id #uuid "ca026e68-7ce9-5001-8466-f35ce831f359" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186310367}] :answer-field/correct {:answer/id #uuid "39c3126f-f605-5fdb-a8f6-4beb75098139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186309190} :answer-field/id #uuid "5cba810c-0085-539c-9dc2-07aca71701c7" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311035} {:answer-field/choices [{:answer/id #uuid "081fd3e6-7056-5b42-8ece-35ee8a05f6ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-{x}^{2}}(2xy\\,\\text{d}x+\\text{d}y)=0" :db/id #edb/ref 17592186308808} {:answer/id #uuid "cab10925-126e-5dca-9586-c1e95612fb12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}(2xy\\,\\text{d}x+\\text{d}y)=0" :db/id #edb/ref 17592186310371} {:answer/id #uuid "cf3a0b50-31da-5b90-a36e-a951e3b730e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{{x}^{2}}(2xy\\,\\text{d}x+\\text{d}y)=0" :db/id #edb/ref 17592186310413} {:answer/id #uuid "e9bacd60-793a-590d-91b6-5f68cff4a256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}(2xy\\,\\text{d}x+\\text{d}y)=0" :db/id #edb/ref 17592186310609}] :answer-field/correct {:answer/id #uuid "cf3a0b50-31da-5b90-a36e-a951e3b730e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{{x}^{2}}(2xy\\,\\text{d}x+\\text{d}y)=0" :db/id #edb/ref 17592186310413} :answer-field/id #uuid "93f45a86-9581-56d4-9138-43d72b84a227" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311214} {:answer-field/choices [{:answer/id #uuid "137b0afc-ddd3-52f3-a0df-775f92e59f37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186308889} {:answer/id #uuid "34559140-97d3-5b23-a65d-788dccdb249c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-g(x))" :db/id #edb/ref 17592186309146} {:answer/id #uuid "75abab72-0c55-5ec5-ae0b-3980472ea108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(g(x))" :db/id #edb/ref 17592186309665} {:answer/id #uuid "aa78d0a7-3a2c-5216-a41e-fd6a3e424c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186310126}] :answer-field/correct {:answer/id #uuid "aa78d0a7-3a2c-5216-a41e-fd6a3e424c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186310126} :answer-field/id #uuid "c8f38525-da5b-54fa-98f9-d510e3b345e7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311371}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "962d1a79-d985-579f-97b1-f3fa44664b6b" :question/math-academy-id "q-337400" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n2xy\\,\\text{d}x+\\text{d}y=0\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below.For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nLet's denote\n\n$$\nP(x,y)=2xy,\\,Q(x,y)=1.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}={{field-3}}\n$$\n\n$$\n\\frac{∂Q}{∂x}={{field-4}}\n$$\n\nSince for this equation\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-5}},\n$$\n\nwhich depends on $x$ only, then an integrating factor for our equation is\n\n$$\nI(x)={{field-6}},\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-7}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x).\n$$\n\nLet's denote\n\n$$\nP(x,y)=2xy,\\,Q(x,y)=1.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(2xy)=2x \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(1)=0\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =2x,\\end{aligned}\n$$\n\nis a function of $x$ only, we conclude that an integrating factor is\n\n$$\n\\begin{aligned}I(x) & =\\operatorname{exp}⁡(\\int 2x\\,\\text{d}x) \\\\  & =\\operatorname{exp}⁡({x}^{2}) \\\\  & ={e}^{{x}^{2}}.\\end{aligned}\n$$\n\nMultiplying the differential equation by the integrating factor gives\n\n$$\n{e}^{{x}^{2}}(2xy\\,\\text{d}x+\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186311852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0307f2b4-04f6-5826-b8