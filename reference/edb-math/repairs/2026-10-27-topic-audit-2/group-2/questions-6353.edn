nswer/id #uuid "b896269b-94a5-5d59-aa59-c53f53f2e92e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186310242} {:answer/id #uuid "be7f3ff3-1f2f-5b3f-a703-bb889c795914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186310288}] :answer-field/correct {:answer/id #uuid "5d81dc75-e75d-5f2e-8ff5-cc5a8dcabee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186309448} :answer-field/id #uuid "c41c32de-08e5-5420-8a6a-71d38d96b107" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311356} {:answer-field/choices [{:answer/id #uuid "0e708148-1238-56d4-90dc-d343be8acc07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{d}x-4xy\\,\\text{d}y=0" :db/id #edb/ref 17592186308847} {:answer/id #uuid "147fdf6f-470c-5ea1-b8b2-a17198692966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3x-4xy)\\,\\text{d}x+\\text{d}y=0" :db/id #edb/ref 17592186308899} {:answer/id #uuid "2840ebe3-09f7-5fdc-a5a9-a014f70307bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(4xy+3x)\\,\\text{d}x+\\text{d}y=0" :db/id #edb/ref 17592186309053} {:answer/id #uuid "428bddbc-7fe1-57a9-b19a-9be2149863bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{d}x-(4xy+3x)\\,\\text{d}y=0" :db/id #edb/ref 17592186309252}] :answer-field/correct {:answer/id #uuid "2840ebe3-09f7-5fdc-a5a9-a014f70307bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(4xy+3x)\\,\\text{d}x+\\text{d}y=0" :db/id #edb/ref 17592186309053} :answer-field/id #uuid "d51be4dc-70f6-5f93-83cb-4da4f3682b59" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311418} {:answer-field/choices [{:answer/id #uuid "31620a73-9199-59c5-9292-3957d93c8c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x" :db/id #edb/ref 17592186309120} {:answer/id #uuid "6f4f2e5f-1bbf-57a2-9854-0768e88af997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}" :db/id #edb/ref 17592186309607} {:answer/id #uuid "a01bf326-7cf7-50ef-828d-7c4d8fc369ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186310043} {:answer/id #uuid "e8d9ff67-6eb4-5d9b-aee1-713423b5e5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186310596}] :answer-field/correct {:answer/id #uuid "e8d9ff67-6eb4-5d9b-aee1-713423b5e5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186310596} :answer-field/id #uuid "ea40afce-65ce-51ba-a0f9-c3502feadf74" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311476}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a976c29-035c-5d40-acc5-bb9e8d96a10e" :question/math-academy-id "q-337161" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n{y}^{′}=4xy+3x\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below.For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nFirst, we rewrite our equation in differential form. This gives\n\n$$\n{{field-3}}.\n$$\n\nLet's denote\n\n$$\nP(x,y)=-(4xy+3x),\\,Q(x,y)=1.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}=\\,{{field-4}}\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-5}}\n$$\n\nSince for this equation \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-6}},\n$$\n\nwhich depends on $x$ only, then an integrating factor for our equation is\n\n$$\nI(x)={{field-7}},\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-8}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nFirst, we rewrite our equation in differential form: \n\n$$\n-(4xy+3x)\\,\\text{d}x+\\text{d}y=0\n$$\n\nLet's denote \n\n$$\nP(x,y)=-(4xy+3x),\\,Q(x,y)=1.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(-(4xy+3x))=-4x \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(1)=0\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =\\frac{1}{1}(-4x-0) \\\\  & =-4x,\\end{aligned}\n$$\n\nis a function of $x$ only, we can conclude that an integrating factor for the equation is\n\n$$\n\\begin{aligned}I(x) & =\\operatorname{exp}⁡(\\int -4x\\,\\text{d}x) \\\\  & =\\operatorname{exp}⁡(-2{x}^{2}) \\\\  & ={e}^{-2{x}^{2}}\\end{aligned}\n$$\n\nand by multiplying our differential equation by the integrating factor, we have\n\n$$\nI(x)\\cdot (-(4xy+3x)\\,\\text{d}x+\\text{d}y)=I(x)\\cdot 0\n$$\n\nwhich simplifies as\n\n$$\n{e}^{-2{x}^{2}}\\cdot (-(4xy+3x)\\,\\text{d}x+\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186311824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f30852-47f0-5a6b-87db-ac15a818f355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}" :db/id #edb/ref 17592186309003} {:answer/id #uuid "be83f521-1513-5563-aaca-88655bd63836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂y}\\ne \\frac{∂Q}{∂x}" :db/id #edb/ref 17592186310289}] :answer-field/correct {:answer/id #uuid "be83f521-1513-5563-aaca-88655bd63836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂y}\\ne \\frac{∂Q}{∂x}" :db/id #edb/ref 17592186310289} :answer-field/id #uuid "012b9d81-72aa-5987-ac92-34b0607afc69" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186310798} {:answer-field/choices [{:answer/id #uuid "440c7798-a7c8-5e8d-af50-ab328a69acba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186309266} {:answer/id #uuid "8057bf1d-3e44-5e64-abc2-f9b73cc06815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "isn't" :db/id #edb/ref 17592186309755} {:answer/id #uuid "dfde9415-e6b6-59d5-bd4d-05c090ef9fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186310543} {:answer/id #uuid "eb567668-eecc-548b-a97e-c8268574a4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186310620} {:answer/id #uuid "ee890229-7196-5863-ae88-890c5a09d2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}" :db/id #edb/ref 17592186310650}] :answer-field/correct {:answer/id #uuid "8057bf1d-3e44-5e64-abc2-f9b73cc06815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "isn't" :db/id #edb/ref 17592186309755} :answer-field/id #uuid "3751c7cc-124f-57a3-84a4-223cb6d29754" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186310939} {:answer-field/choices [{:answer/id #uuid "1239fcdb-95d8-5aaf-ba8e-1a01467ef334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{y}" :db/id #edb/ref 17592186308880} {:answer/id #uuid "2331e238-0aed-50c7-8608-ed7d341d37d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{y}" :db/id #edb/ref 17592186309014} {:answer/id #uuid "6112b8bc-4d45-56ce-90cb-e6e35b76af60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186309487} {:answer/id #uuid "92b391f5-dca8-5757-b61d-507d39e3c0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{y}" :db/id #edb/ref 17592186309921}] :answer-field/correct {:answer/id #uuid "2331e238-0aed-50c7-8608-ed7d341d37d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{y}" :db/id #edb/ref 17592186309014} :answer-field/id #uuid "87352ccf-fadb-51b8-a257-91267503a756" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311174} {:answer-field/choices [{:answer/id #uuid "2f661ae2-14cb-562e-9ec5-f5510f617444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y\\,\\text{d}x-y\\,\\text{d}y" :db/id #edb/ref 17592186309107} {:answer/id #uuid "5e450170-999d-5202-849b-aa86fe79e067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y\\,\\text{d}x+\\frac{{x}^{2}}{y}\\,\\text{d}y" :db/id #edb/ref 17592186309452} {:answer/id #uuid "7d272730-8c43-5f09-8db0