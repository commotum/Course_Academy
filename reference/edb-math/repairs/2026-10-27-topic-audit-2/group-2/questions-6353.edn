"b6cabcf0-fc89-5dc3-9753-bbcd168846ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/y}" :db/id #edb/ref 17592186298347} :answer-field/id #uuid "9f77f208-cb17-5fb0-8ba6-03894d66a5cc" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186299166} {:answer-field/choices [{:answer/id #uuid "118c1b73-c895-5a12-8061-782967560b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-h(y))" :db/id #edb/ref 17592186297632} {:answer/id #uuid "2299f41e-dad5-540d-8488-9c628f4704a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(h(y))" :db/id #edb/ref 17592186297701} {:answer/id #uuid "2ae714a5-1598-534b-998a-f2554d82ddbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(\\int h(x)\\,\\text{d}y)" :db/id #edb/ref 17592186297732} {:answer/id #uuid "955025ce-7123-5779-b133-bdefe7a435b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)" :db/id #edb/ref 17592186298196}] :answer-field/correct {:answer/id #uuid "955025ce-7123-5779-b133-bdefe7a435b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)" :db/id #edb/ref 17592186298196} :answer-field/id #uuid "a330f150-a997-5706-aa6a-267e43af1973" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186299182} {:answer-field/choices [{:answer/id #uuid "415616a2-bec2-53e1-b000-daecc8b6edd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{y}^{-1}+3{y}^{2}" :db/id #edb/ref 17592186297814} {:answer/id #uuid "50a37358-7f2c-588e-9ab6-352fd3cd0f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{-1}-{y}^{-2}" :db/id #edb/ref 17592186297886} {:answer/id #uuid "a27901a3-bede-5eb3-8919-789f8935b7ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{-2}+y" :db/id #edb/ref 17592186298266} {:answer/id #uuid "dab0b68b-a64a-5c80-b00e-643cee922ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-1}+1" :db/id #edb/ref 17592186298491}] :answer-field/correct {:answer/id #uuid "50a37358-7f2c-588e-9ab6-352fd3cd0f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{-1}-{y}^{-2}" :db/id #edb/ref 17592186297886} :answer-field/id #uuid "b589b91b-8e6f-5cf2-b652-ee36c0caa91c" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186299249} {:answer-field/choices [{:answer/id #uuid "3f390c3f-3d8a-5215-902a-2111e1cb9064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186297800} {:answer/id #uuid "6fb08d3e-745f-5d5e-a6f0-813f37e8f5c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186298028} {:answer/id #uuid "9d01e28b-2bec-5906-ac6d-fdf1bdf1ffed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186298241} {:answer/id #uuid "f5d799e0-e3ef-5bec-9aa6-900bcf220160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186298599}] :answer-field/correct {:answer/id #uuid "6fb08d3e-745f-5d5e-a6f0-813f37e8f5c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186298028} :answer-field/id #uuid "d7184634-9a08-500a-9184-3112157be269" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186299364} {:answer-field/choices [{:answer/id #uuid "4a02e00e-701c-5b8e-9132-1b5593eda284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}" :db/id #edb/ref 17592186297856} {:answer/id #uuid "79b85f2e-5627-5832-8d9b-b229eb68273f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186298083} {:answer/id #uuid "8fc9d4b3-6efd-5d1b-94bc-a6d389fbeb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186298175} {:answer/id #uuid "9e47a9e6-82e1-5d48-9586-aa786a8a9927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}" :db/id #edb/ref 17592186298248}] :answer-field/correct {:answer/id #uuid "9e47a9e6-82e1-5d48-9586-aa786a8a9927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}" :db/id #edb/ref 17592186298248} :answer-field/id #uuid "d71e630e-4f8f-5a9f-9bbd-c0584ea6c464" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186299365}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "16348fba-4613-56cd-be81-305ba49c72ee" :question/math-academy-id "q-318660" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n{y}^{3}\\,\\text{d}x+xy\\,\\text{d}y=0,\\,y>0\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below. For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(y)$ denotes the exponential function ${e}^{y}.$\n\nLet's denote\n\n$$\nP(x,y)={y}^{3},\\,Q(x,y)=xy.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}=\\,{{field-3}}\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-4}}\n$$\n\nSince for this equation \n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-5}},\n$$\n\nwhich depends on $y$ only, then an integrating factor for our equation is\n\n$$\nI(y)={{field-6}}.\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-7}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)=\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)\n$$\n\nwhere $\\operatorname{exp}⁡(y)$ denotes the exponential function ${e}^{y}.$\n\nLet's denote\n\n$$\nP(x,y)={y}^{3},\\,Q(x,y)=xy.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}({y}^{3})=3{y}^{2} \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(xy)=y\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =\\frac{1}{{y}^{3}}(3{y}^{2}-y) \\\\  & =3{y}^{-1}-{y}^{-2},\\end{aligned}\n$$\n\nis a function of $y$ only, we can conclude that an integrating factor for our equation is\n\n$$\n\\begin{aligned}I(y) & =\\operatorname{exp}⁡(\\int -(3{y}^{-1}-{y}^{-2})\\,\\text{d}y) \\\\  & =\\operatorname{exp}⁡(-(3\\operatorname{ln}⁡y+1/y)) \\\\  & =\\operatorname{exp}⁡(\\operatorname{ln}⁡{y}^{-3})\\cdot \\operatorname{exp}⁡(-1/y) \\\\  & ={y}^{-3}\\,{e}^{-1/y}.\\end{aligned}\n$$\n\nand by multiplying our differential equation by the integrating factor, we have\n\n$$\nI(y)\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=I(y)\\cdot 0\n$$\n\nwhich simplifies as\n\n$$\n{y}^{-3}{e}^{-1/y}({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186217792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e958fa7a-2530-5e28-9195-e3dd1010f6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x}" :db/id #edb/ref 17592186216598} {:answer/id #uuid "0c1ef443-4597-541d-a8b8-ab8eac9b4807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{3}" :db/id #edb/ref 17592186216599} {:answer/id #uuid "331ca236-b1f1-5b54-9bf6-4ef67cedef79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}" :db/id #edb/ref 17592186216600} {:answer/id #uuid "64939ccc-a9bb-5407-afbc-0c31373b00bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3x}" :db/id #edb/ref 17592186216601}] :answer-field/id #uuid "7b6ed42b-5c85-5ddb-bee9-efa742312304" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216597} {:answer-field/choices [{:answer/id #uuid "f23ef2ff-c615-5327-8856-dcaefed546c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}y^{4} + 3x^{2}y^{2} + xy = c" :db/id #edb/ref 17592186216603} {:answer/id #uuid "ff9098f4-a6d7-59b2-aa95-8e2743fc9f5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4}y^{3} + 2x^{3}y^{2} + y = c" :db/id #edb/ref 17592186216604} {:answer/id #uuid "139036de-8f75-5274-bd83-8a15afa69a21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{3}y^{3} + 2xy^{2} + y = c" :db/id #edb/ref 17592186216605} {:answer/id #uuid "1ffffdcd-1009-542a-b618-7670fe4f7c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}y^{2} + xy^{2} + xy = c" :db/id #edb/ref 17592186216606}] :answer-field/id #uuid "5ccc11c6-641b-5db3-a990-fccf006a1b53" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216602} {:answer-field/choices [{:answer/id #uuid "a5aa962c-7d0e-52df-8d52-ef49cea07bf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{y}^{4}+3{x}^{2}{y}^{2}+xy=c" :db/id #edb/ref 17592186391639} {:answer/id #uuid "11e3d474-20b2-5032-9666-95b4f01e1179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{y}^{3}+2{x}^{3}{y}^{2}+y=c" :db/id #edb/ref 17592186391640} {:answer/id #uuid "f75b222d-003d-5187-8076-ece9e06f1717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{2}+x{y}^{2}+xy=c" :db/id #edb/ref 17592186391641} {:answer/id #uuid "73f61c2c-6548-57e3-8b11-917ede06e5e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{3}+2x{y}^{2}+y=c" :db/id #edb/ref 17592186391642}] :answer-field/correct {:answer/id #uuid "11e3d474-20b2-5032-9666-95b4f01e1179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{y}^{3}+2{x}^{3}{y}^{2}+y=c" :db/id #edb/ref 17592186391640} :answer-field/id #uuid "95895bc2-016a-540f-933b-27ed94e47a3c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186391638} {:answer-field/choices [{:answer/id #uuid "e2e30145-5610-556c-b3c9-6712ae5787c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{x}" :db/id #edb/ref 17592186391644} {:answer/id #uuid "b181fa3b-5355-508d-8687-40cf1538a9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186391645} {:answer/id #uuid "04f7ffac-fd58-5761-bb3a-04a54c62e4bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}" :db/id #edb/ref 17592186391646} {:answer/id #uuid "1ecf71d4-8f46-5451-a460-3ca8dfbc5fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186391647}] :answer-field/correct {:answer/id #uuid "b181fa3b-5355-508d-8687-40cf1538a9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186391645} :answer-field/id #uuid "85d87871-391a-5f75-8927-010186af7a6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186391643}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1effee9c-dd60-525b-b725-817b354982d6" :question/math-academy-id "q-337096" :question/problem "Consider the inexact differential equation\n\n$$\n(\\frac{6{y}^{2}}{x}+4{y}^{3})\\,\\text{d}x+(4y+3x{y}^{2}+\\frac{1}{{x}^{3}})\\,\\text{d}y=0.\n$$\n\nIt is known that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{3}{x}\n$$\n\nwhere the functions $P$ and $Q$ are given by \n\n$$\nP(x,y)=\\frac{6{y}^{2}}{x}+4{y}^{3},\\,Q(x,y)=4y+3x{y}^{2}+\\frac{1}{{x}^{3}}.\n$$\n\nUse this information to find a suitable integrating factor $I(x)$ and hence find the general solution to the equation.\n\n$\\,$ A suitable integrating factor is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is {{field-2}}, where $c$ is a constant." :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nWe are given that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{3}{x}.\n$$\n\nSince $\\frac{3}{x}$ is a function of $x$ only, we can conclude that the integrating factor for the equation is \n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int 3{x}^{-1}\\text{ }\\text{d}x} \\\\  & ={e}^{3\\operatorname{ln}⁡x} \\\\  & ={x}^{3}.\\end{aligned}\n$$\n\nMultiplying our equation by the integrating factor, we arrive at the following exact differential equation:\n\n$$\n\\begin{aligned}{x}^{3}[(\\frac{6{y}^{2}}{x}+4{y}^{3})\\,\\text{d}x+(4y+3x{y}^{2}+\\frac{1}{{x}^{3}})\\,\\text{d}y] & =0 \\\\ \\underbrace{(6{x}^{2}{y}^{2}+4{x}^{3}{y}^{3})}_{\\overset{~}{P}}\\,\\text{d}x+\\underbrace{(4{x}^{3}y+3{x}^{4}{y}^{2}+1)}_{\\overset{~}{Q}}\\,\\text{d}y & =0\\end{aligned}\n$$\n\nFor this exact equation, we have\n\n$$\n\\overset{~}{P}(x,y)=6{x}^{2}{y}^{2}+4{x}^{3}{y}^{3},\\,\\overset{~}{Q}(x,y)=4{x}^{3}y+3{x}^{4}{y}^{2}+1.\n$$\n\nTo solve the equation, let's first integrate $\\overset{~}{P}(x,y)$ with respect to $x.$\nThe result should include an arbitrary function of $y,$ which we'll call $F(y):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{P}(x,y)\\,\\text{d}x+F(y) \\\\  & =\\int (6{x}^{2}{y}^{2}+4{x}^{3}{y}^{3})\\,\\text{d}x+F(y) \\\\  & =2{x}^{3}{y}^{2}+{x}^{4}{y}^{3}+F(y).\\end{aligned}\n$$\n\nNext, let's integrate $\\overset{~}{Q}(x,y)$ with respect to $y.$\nThe result should include an arbitrary function of $x,$ which we'll call $G(x):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{Q}(x,y)\\,\\text{d}y+G(x) \\\\  & =\\int (4{x}^{3}y+3{x}^{4}{y}^{2}+1)\\,\\text{d}y+G(x) \\\\  & =2{x}^{3}{y}^{2}+{x}^{4}{y}^{3}+y+G(x).\\end{aligned}\n$$\n\nComparing the two solutions, we must have\n\n$$\nF(y)=y,\\,G(x)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n2{x}^{3}{y}^{2}+{x}^{4}{y}^{3}+y=c.\n$$"}] [{:db/id #edb/ref 17592186217793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82fd609a-7d57-5e8f-ba67-820976003caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y^{4}}" :db/id #edb/ref 17592186216608} {:answer/id #uuid "8cec932d-ecd3-53b9-9ee5-8e371b4aa29f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y^{2}}" :db/id #edb/ref 17592186216609} {:answer/id #uuid "abc9f5b9-bc53-5670-b39c-af1f8c968827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y^{3}}" :db/id #edb/ref 17592186216610} {:answer/id #uuid "56cf23ab-7f91-582e-954d-4adee4a3e857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}" :db/id #edb/ref 17592186216611}] :answer-field/id #uuid "c031e279-077e-5029-a2da-74addad4195b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216607} {:answer-field/choices [{:answer/id #uuid "a49d6c74-b5a7-5d73-b934-356db52c7562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{y^{4}} - 2y = c" :db/id #edb/ref 17592186216613} {:answer/id #uuid "b41f7e2a-1a3e-5839-b87a-c941baf2f173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{y^{3}} - 2y = c" :db/id #edb/ref 17592186216614} {:answer/id #uuid "d4a56924-dcb7-5cf4-8c84-0f73d6a26c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{y^{2}} - 2y^{2} = c" :db/id #edb/ref 17592186216615} {:answer/id #uuid "27c30c51-6505-52b9-a760-7228c987c3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{y^{4}} - 2y^{3} = c" :db/id #edb/ref 17592186216616}] :answer-field/id #uuid "15bbcb71-db2d-5641-91c5-a91a12625a77" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186216612}] :question/id #uuid "21520ba3-80e3-5455-9216-9ff33775a80b" :question/math-academy-id "q-337099" :question/problem "Consider the inexact differential equation\n$x^{2}ydx - (x^{3} + 2y^{4})dy = 0$.\nIt is known that\n$$\n\\displaystyle \\frac{1}{P}(\\frac{∂P}{∂y} - \\frac{∂Q}{∂x}) = \\frac{4}{y}\n$$\nwhere the functions $P$ and $Q$ are given by\n$$\n\\displaystyle P(x, y) = x^{2}y, Q(x, y) =-x^{3} - 2y^{4}.\n$$\n\nUse this information to find a suitable integrating factor $I(y)$ and hence find the general solution to the equation.\n\nA suitable integrating factor is $I(y) =$ {{field-1}}.\n\nThe general solution is {{field-2}}, where $c$ is a constant."}] [{:db/id #edb/ref 17592186217794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80000d4c-7739-5f64-a737-2ea473eeaf24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186309751} {:answer/id #uuid "f7ef16fa-44ab-5bb3-afcb-42dbcf98c3e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186310721}] :answer-field/correct {:answer/id #uuid "f7ef16fa-44ab-5bb3-afcb-42dbcf98c3e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186310721} :answer-field/id #uuid "03fdb7f2-eca0-5406-840d-1205920d819e" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186310803} {:answer-field/choices [{:answer/id #uuid "c7612abb-a919-5c4a-a907-517d58064003" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186310350} {:answer/id #uuid "f474d878-a88b-5654-9c8f-20eea8ff9cfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186310692}] :answer-field/correct {:answer/id #uui