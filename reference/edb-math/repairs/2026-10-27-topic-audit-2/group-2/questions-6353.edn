 4 x y^{2}\\right)\\,\\mathrm{d}y]=0\\end{aligned}" :db/id #edb/ref 17592186690226}] :answer-field/correct {:answer/id #uuid "11f45be5-28be-542d-bc98-0621965e31dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\left(\\frac{e^{- y}}{y^{2}}\\right)\\, [\\\\ &\\quad \\left(2 y \\left(x + 2 y\\right)\\right)\\,\\mathrm{d}x\\\\ &\\quad {}+\\left(- x^{2}\\right)\\,\\mathrm{d}y\\\\ &\\quad {}+\\left(- x^{2} y\\right)\\,\\mathrm{d}y\\\\ &\\quad {}+\\left(- 4 x y^{2}\\right)\\,\\mathrm{d}y]=0\\end{aligned}" :db/id #edb/ref 17592186690174} :answer-field/id #uuid "8760f038-38be-5304-8774-9db0d81c1b8e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186690207}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7474724e-89fd-5bc7-9796-bdb7a2e2efa8" :question/problem "Find an integrating factor depending only on $y$ for\n\n$$\n\\left(- x^{2} y - x^{2} - 4 x y^{2}\\right)\\frac{\\mathrm{d}y}{\\mathrm{d}x}=-\\left(2 y \\left(x + 2 y\\right)\\right)\n$$\n\nWork on the domain $x>0$, $y>0$.\n\nRewrite as $P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y=0$, with $P=2 y \\left(x + 2 y\\right)$. Compute the ratio and simplify before choosing:\n\n$$\n\\frac{P_y-Q_x}{P}={{field-1}}\n$$\n\nUse this ratio to choose an integrating factor:\n\n$$\nI(y)={{field-2}}\n$$\n\nChoose the **exact equation** obtained by multiplying the original differential equation by that factor:\n\n$$\n{{field-3}}\n$$\n\n" :question/worked-solution "Move the right side to the left and multiply by $\\mathrm{d}x$:\n\n$$\n\\left(2 y \\left(x + 2 y\\right)\\right)\\,\\mathrm{d}x+\\left(- x \\left(x y + x + 4 y^{2}\\right)\\right)\\,\\mathrm{d}y=0\n$$\n\nThe coefficients and their partial derivatives are\n\n$$\n\\begin{aligned}P&=2 y \\left(x + 2 y\\right) \\\\ Q&=- x^{2} y - x^{2} - 4 x y^{2} \\\\ P_y&=2 x + 8 y \\\\ Q_x&=- 2 x y - 2 x - 4 y^{2}\\end{aligned}\n$$\n\nSubtract, factor, and cancel:\n\n$$\n\\begin{aligned}P_y-Q_x&=2 x y + 4 x + 4 y^{2} + 8 y \\\\ &=2 \\left(x + 2 y\\right) \\left(y + 2\\right) \\\\ \\frac{P_y-Q_x}{P}&=\\frac{2 \\left(x + 2 y\\right) \\left(y + 2\\right)}{2 y \\left(x + 2 y\\right)} \\\\ &=1 + \\frac{2}{y}\\end{aligned}\n$$\n\nThe domain makes the canceled factors nonzero. This ratio depends on $y$ only. Apply the negative-integral formula:\n\n$$\n\\begin{aligned}I(y)&=\\exp\\left(-\\int h(y)\\,\\mathrm{d}y\\right) \\\\ &=\\exp\\left(-\\int\\left(1 + \\frac{2}{y}\\right)\\,\\mathrm{d}y\\right) \\\\ &=\\exp\\left(-\\left(y + 2 \\ln{\\left(y \\right)}\\right)\\right) \\\\ &=\\exp\\left(- y\\right)\\exp\\left(-2\\ln y\\right) \\\\ &=\\frac{e^{- y}}{y^{2}}\\end{aligned}\n$$\n\nSince $y>0$, the logarithm conversion is valid. Choose the arbitrary nonzero multiplier as $1$. The multiplied equation, distributing $Q\\,\\mathrm{d}y$ across rows, is\n\n$$\n\\begin{aligned}&\\left(\\frac{e^{- y}}{y^{2}}\\right)\\, [\\\\ &\\quad \\left(2 y \\left(x + 2 y\\right)\\right)\\,\\mathrm{d}x\\\\ &\\quad {}+\\left(- x^{2}\\right)\\,\\mathrm{d}y\\\\ &\\quad {}+\\left(- x^{2} y\\right)\\,\\mathrm{d}y\\\\ &\\quad {}+\\left(- 4 x y^{2}\\right)\\,\\mathrm{d}y]=0\\end{aligned}\n$$\n\nIts cross-partials agree:\n\n$$\n\\frac{\\partial(IP)}{\\partial y}=\\frac{\\partial(IQ)}{\\partial x}=- \\frac{2 \\left(x y + x + 2 y^{2}\\right) e^{- y}}{y^{2}}\n$$\n\n"}] [{:db/id #edb/ref 17592186690214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ffc45d-ef1c-5126-af3e-b6fe193e5873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + \\frac{1}{y}" :db/id #edb/ref 17592186690169} {:answer/id #uuid "3407a404-e0da-5163-8b76-0f5931d8c6bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + \\frac{2}{y}" :db/id #edb/ref 17592186690191} {:answer/id #uuid "847e269f-60ab-52a3-bb80-2e504fc698c2" :answer/type {:db/id #edb/ref 17592186045498 :d