\mathrm{d}y=0" :db/id #edb/ref 17592186690386} :answer-field/id #uuid "b6978efa-9079-52c0-86ef-c0eb8e7905c4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186690368} {:answer-field/choices [{:answer/id #uuid "6e128618-72c3-52d3-940d-d44c382a74fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x^2}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690345} {:answer/id #uuid "a07a24ab-7b65-5acc-8c69-9ee13ebdef63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690358} {:answer/id #uuid "da5f5dbb-80fc-5bdc-8ff5-3fdd7f35f4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-x^2}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690388} {:answer/id #uuid "f2bc47bc-5283-5172-9167-98b44a0a4d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2x}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690397}] :answer-field/correct {:answer/id #uuid "f2bc47bc-5283-5172-9167-98b44a0a4d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2x}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690397} :answer-field/id #uuid "ef468d96-5c57-5906-b2c7-076df001ce07" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186690396}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "277a6d3d-25ca-570b-a425-37168ec6219d" :question/problem "Find an integrating factor that converts the following differential equation into an exact equation:\n\n$$\ny'=2y+5\n$$\n\nSelect the correct options in the reasoning below. Take $x$ to be real.\n\nFor a differential equation of the form\n\n$$\nP(x,y)\\,\\mathrm{d}x+Q(x,y)\\,\\mathrm{d}y=0,\n$$\n\nif\n\n$$\n{{field-1}}=g(x),\n$$\n\nwhere $g(x)$ is independent of $y$ and $Q\\ne0$, then an integrating factor is\n\n$$\nI(x)={{field-2}}.\n$$\n\nHere $\\exp(x)=e^x$.\n\nFirst, rewrite the equation in differential form:\n\n$$\n{{field-3}}.\n$$\n\nLet\n\n$$\nP(x,y)=-2y-5,\\qquad Q(x,y)=1.\n$$\n\nCompute the partial derivatives:\n\n$$\n\\frac{\\partial P}{\\partial y}={{field-4}},\\qquad\\frac{\\partial Q}{\\partial x}={{field-5}}.\n$$\n\nSince\n\n$$\n\\frac{1}{Q}\\left(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x}\\right)={{field-6}}\n$$\n\ndepends only on $x$, an integrating factor is\n\n$$\nI(x)={{field-7}},\n$$\n\nand multiplication gives the exact equation\n\n$$\n{{field-8}}.\n$$" :question/worked-solution "For an integrating factor depending only on $x$, the condition is\n\n$$\ng(x)=\\frac{P_y-Q_x}{Q},\\qquad I(x)=\\exp\\left(\\int g(x)\\,\\mathrm{d}x\\right).\n$$\n\nMoving the right-hand side to the left and multiplying by $\\mathrm{d}x$ gives\n\n$$\n(-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y=0.\n$$\n\nHere\n\n$$\nP=-2y-5,\\qquad Q=1,\\qquad P_y=-2,\\qquad Q_x=0.\n$$\n\nTherefore\n\n$$\ng(x)=\\frac{-2-0}{1}=-2,\n$$\n\nwhich depends only on $x$. Hence, choosing the multiplicative constant to be one,\n\n$$\n\\begin{aligned}I(x)&=\\exp\\left(\\int -2\\,\\mathrm{d}x\\right)\\\\&=\\exp(-2x)\\\\&=e^{-2x}.\\end{aligned}\n$$\n\nMultiplying the differential form gives\n\n$$\ne^{-2x}\\left((-2y-5)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0.\n$$\n\nTo check exactness, differentiate the new coefficients:\n\n$$\n\\frac{\\partial}{\\partial y}((-2y-5)e^{-2x})=-2e^{-2x}=\\frac{\\partial}{\\partial x}(e^{-2x}).\n$$\n\nThe transformed equation is exact. The general rule uses subtraction, even though $Q_x=0$ in this particular equation."}] [{:db/id #edb/ref 17592186690337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e6c7d22-d9ed-5ea1-9a34-9ebb0add895d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4x}" :db/id #edb/ref 17592186690321} {:answer/id #uuid "31dceb83-9e62-5f99-9630-087fe5b653ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-4x}" :db/id #edb/ref 17592186690324} {:answer/id #uuid "3f899619-84a2-58dc-872d-31ecd72c0611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2x^2}" :db/id #edb/ref 17592186690330} {:answer/id #uuid "af87c190-adf9-55f3-9279-45f5ee344838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x^2}" :db/id #edb/ref 17592186690365}] :answer-field/correct {:answer/id #uuid "3f899619-84a2-58dc-872d-31ecd72c0611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2x^2}" :db/id #edb/ref 17592186690330} :answer-field/id #uuid "349c9a8f-3193-5370-b227-3adbcf4ead82" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186690326} {:answer-field/choices [{:answer/id #uuid "6e15cbc4-254d-5a8c-9dd9-14c2e3245645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2x^2}\\left((-4xy)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690346} {:answer/id #uuid "aac0e741-a168-5b4c-9fef-388bebec838c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-2x^2}\\left((-4xy)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690363} {:answer/id #uuid "aee1391c-1cea-5d83-aab3-35e641a20fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-4x}\\left((-4xy)\\,\\mathrm{d}x+\\,\\mathrm{d}y\\right)=0" :db/id #edb/ref 17592186690364} {:answer/id #uuid "be945f44-bb03-5890-8cfe-53bdfd054a67" :answer/type 