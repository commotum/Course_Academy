-8c04-5019-a917-d2fa618a812f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- y" :db/id #edb/ref 17592186681840} :answer-field/id #uuid "c5971488-1df6-50a9-b75f-75d53d2b9e0a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186681812} {:answer-field/choices [{:answer/id #uuid "06bc92df-a542-5681-93eb-07dc996e1f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3 y}" :db/id #edb/ref 17592186681676} {:answer/id #uuid "bb852314-f966-56ca-ab29-a126029ac7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3 y}" :db/id #edb/ref 17592186681801} {:answer/id #uuid "bfb12d98-6794-54e6-a361-98c8b5eab4b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{3 y}" :db/id #edb/ref 17592186681807} {:answer/id #uuid "c31389b9-c4c1-521a-a161-ce45d98e32a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3 y}" :db/id #edb/ref 17592186681810}] :answer-field/correct {:answer/id #uuid "bb852314-f966-56ca-ab29-a126029ac7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3 y}" :db/id #edb/ref 17592186681801} :answer-field/id #uuid "c885df02-bfe6-53c6-9a31-0f2a4df6286f" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186681815}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42dcd2fa-b59d-5010-a94f-e29d1e933f8f" :question/problem "Find an integrating factor to convert the following differential equation into an **exact equation**. Select the correct options in the reasoning below.\n\n$$\n\\left(3 y^{2}\\right)\\,\\mathrm{d}x+\\left(- x y\\right)\\,\\mathrm{d}y=0,\\qquad y>0\n$$\n\nFor an equation of the form\n\n$$\nP(x,y)\\,\\mathrm{d}x+Q(x,y)\\,\\mathrm{d}y=0\n$$\n\nif\n\n$$\n{{field-1}}=h(y)\n$$\n\nwhere $h(y)$ is independent of $x$, an integrating factor is\n\n$$\nI(y)={{field-2}}\n$$\n\nHere $\\exp(y)$ denotes $e^y$.\n\nDenote\n\n$$\nP(x,y)=3 y^{2},\\qquad Q(x,y)=- x y\n$$\n\nCompute the partial derivatives:\n\n$$\n\\frac{\\partial P}{\\partial y}={{field-3}}\n$$\n\n\n\n$$\n\\frac{\\partial Q}{\\partial x}={{field-4}}\n$$\n\nFor this equation,\n\n$$\n\\frac{1}{P}\\left(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x}\\right)={{field-5}}\n$$\n\nThis depends on $y$ only, so\n\n$$\nI(y)={{field-6}}\n$$\n\nMultiplying gives the exact equation\n\n$$\n{{field-7}}\n$$\n\n" :question/worked-solution "For an equation in differential form, the condition is\n\n$$\n\\frac{1}{P}\\left(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x}\\right)=h(y)\n$$\n\nwith $h(y)$ independent of $x$. Then\n\n$$\nI(y)=\\exp\\left(-\\int h(y)\\,\\mathrm{d}y\\right)\n$$\n\nSet\n\n$$\nP(x,y)=3 y^{2},\\qquad Q(x,y)=- x y\n$$\n\nCompute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{\\partial P}{\\partial y}&=\\frac{\\partial}{\\partial y}\\left(3 y^{2}\\right)=6 y \\\\ \\frac{\\partial Q}{\\partial x}&=\\frac{\\partial}{\\partial x}\\left(- x y\\right)=- y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{P}\\left(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x}\\right)&=\\frac{1}{3 y^{2}}\\left[\\left(6 y\\right)-\\left(- y\\right)\\right] \\\\ &=\\frac{7}{3 y}\\end{aligned}\n$$\n\nThe ratio depends on $y$ only. On the stated domain,\n\n$$\n\\begin{aligned}I(y)&=\\exp\\left(-\\int\\left(\\frac{7}{3 y}\\right)\\,\\mathrm{d}y\\right) \\\\ &=\\exp\\left(-\\left(\\frac{7 \\ln{\\left(y \\right)}}{3}\\right)\\right) \\\\ &=\\frac{1}{y^{\\frac{7}{3}}}\\end{aligned}\n$$\n\nWe choose the arbitrary nonzero constant multiplier to be $1$. Here $y>0$ permits the logarithm and exponential conversion. Multiplying the original equation by this factor gives\n\n$$\n\\begin{aligned}&\\left(\\frac{1}{y^{\\frac{7}{3}}}\\right)\\, [\\\\ &\\quad \\left(3 y^{2}\\right)\\,\\mathrm{d}x\\\\ &\\quad {}+\\left(- x y\\right)\\,\\mathrm{d}y]=0\\end{aligned}\n$$\n\n"}] [{:db/id #edb/ref 17592186681758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49437d6e-1a55-5794-9fa9-c3a776b44ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 y + 2}{3 y^{2}}" :db/id #edb/ref 17592186681727} {:answer/id #uuid "6a7347e4-63b2-51c9-ae1a-835fa4d57a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 y - 2}{3 y^{2}}" :db/id #edb/ref 17592186681748} {:answer/id #uuid "707575e6-fa70-51c5-97ea-d70147247572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 y - 1\\right)}{3 y^{2}}" :db/id #edb/ref 17592186681751} {:answer/id #uuid "e50f74e6-28d8-5932-958b-5704f2a8bbae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(3 y + 1\\right)}{3 y^{2}}" :db/id #edb/ref 17592186681829}] :answer-field/correct {:answer/id #uuid "49437d6e-1a55-5794-9fa9-c3a776b44ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 y + 2}{3 y^{2}}" :db/id #edb/ref 17592186681727} :answer-field/id #uuid "0ac99440-9534-5da9-840e-a0692da7743b" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186681679} {:answer-field/choices [{:answer/id #uuid "4c222bb6-a09c-5c19-8ea5-9ddd9bfb16a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}&\\left(\\frac{e^{\\frac{4}{3 y}}}{y^{4}}\\right)\\, [\\\\ &\\quad \\left(3 y^{3}\\right)\\,\\mathrm{d}x\\\\ &\\quad {}+\\left(- 2 x y\\right)\\,\\mathrm{d}y]=0\\end{aligned}" :db/id #edb/ref 17592186681732} {:answer/i