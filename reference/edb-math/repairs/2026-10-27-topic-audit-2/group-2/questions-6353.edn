id #uuid "d1f9b2d4-37b0-5587-81df-4d157b3e5129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-1}" :db/id #edb/ref 17592186310436}] :answer-field/correct {:answer/id #uuid "742bd8f0-d89f-5f02-a311-59c68bf91a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6y+1}{2{y}^{2}}" :db/id #edb/ref 17592186309650} :answer-field/id #uuid "7a03f948-66fc-5da1-9042-c6ecea5c79c3" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311124} {:answer-field/choices [{:answer/id #uuid "6a03fb99-61e2-573b-b5da-0b06e12cc1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(\\int h(x)\\,\\text{d}y)" :db/id #edb/ref 17592186309568} {:answer/id #uuid "b5ad52a0-151c-5757-97bd-153874440b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)" :db/id #edb/ref 17592186310217} {:answer/id #uuid "cb298530-774e-57d8-9ccd-9f5c75f7852f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-h(y))" :db/id #edb/ref 17592186310375} {:answer/id #uuid "d9a49e34-5fd3-5cc8-9dfd-3fdc3f06520f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(h(y))" :db/id #edb/ref 17592186310500}] :answer-field/correct {:answer/id #uuid "b5ad52a0-151c-5757-97bd-153874440b20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)" :db/id #edb/ref 17592186310217} :answer-field/id #uuid "93da18b2-0f04-5d92-8287-4db5128efec2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311211} {:answer-field/choices [{:answer/id #uuid "3f705cdc-41c2-5f9a-8445-edd919c31cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-2}{e}^{1/(2y)}" :db/id #edb/ref 17592186309228} {:answer/id #uuid "8e0481b1-b497-58f4-b105-3f3d55abce0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/(2y)}" :db/id #edb/ref 17592186309878} {:answer/id #uuid "fa34ecd1-5439-525f-9135-2393396f1316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{1/(2y)}" :db/id #edb/ref 17592186310741}] :answer-field/correct {:answer/id #uuid "fa34ecd1-5439-525f-9135-2393396f1316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{1/(2y)}" :db/id #edb/ref 17592186310741} :answer-field/id #uuid "e0c8a9a3-d29e-566e-98ae-8919fefcf054" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311447} {:answer-field/choices [{:answer/id #uuid "05e90167-98bc-5494-9877-95fbe03661c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186308795} {:answer/id #uuid "062343fa-a7e4-5446-adf9-0e582f17946e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186308798} {:answer/id #uuid "26a3a9dd-860b-5c80-af07-44e21596f9b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186309037} {:answer/id #uuid "5f6a1317-f7f4-5800-95ee-65866a9a09b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186309465}] :answer-field/correct {:answer/id #uuid "05e90167-98bc-5494-9877-95fbe03661c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186308795} :answer-field/id #uuid "e62f2e9c-b823-5d73-8121-225ae6240239" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311463}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "43a2c42c-804d-5119-bec4-269847a33364" :question/math-academy-id "q-337619" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y=0,\\,y>0\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below.For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(y)$ denotes the exponential function ${e}^{y}.$\n\nLet's denote\n\n$$\nP(x,y)=2{y}^{3},\\,Q(x,y)=-xy.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}=\\,{{field-3}}\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-4}}\n$$\n\nSince for this equation \n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-5}},\n$$\n\nwhich depends on $y$ only, then an integrating factor for our equation is\n\n$$\nI(y)={{field-6}}.\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-7}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)=\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y).\n$$\n\nLet's denote\n\n$$\nP(x,y)=2{y}^{3},\\,Q(x,y)=-xy.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(2{y}^{3})=6{y}^{2} \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(-xy)=-y\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =\\frac{1}{2{y}^{3}}(6{y}^{2}-(-y)) \\\\  & =\\frac{1}{2{y}^{3}}(6{y}^{2}+y) \\\\  & =\\frac{6y+1}{2{y}^{2}},\\end{aligned}\n$$\n\nis a function of $y$ only, we can conclude that an integrating factor for our equation is\n\n$$\n\\begin{aligned}I(y) & =\\operatorname{exp}⁡(\\int -\\frac{6y+1}{2{y}^{2}}\\,\\text{d}y) \\\\  & =\\operatorname{exp}⁡(-(3\\operatorname{ln}⁡y-\\frac{1}{2y})) \\\\  & =\\operatorname{exp}⁡(-3\\operatorname{ln}⁡y)\\cdot \\operatorname{exp}⁡\\left(\\frac{1}{2y}\\right) \\\\  & ={y}^{-3}{e}^{1/(2y)}.\\end{aligned}\n$$\n\nand by multiplying our differential equation by the integrating factor, we have\n\n$$\nI(y)\\cdot (2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0\n$$\n\nwhich simplifies as\n\n$$\n{y}^{-3}{e}^{1/(2y)}(2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186311864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04dd3513-0642-5de4-be16-d4bc511b2663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186308782} {:answer/id #uuid "40109527-2da6-5399-9922-7e9d518987c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186309237} {:answer/id #uuid "609d8f66-0ba6-5f9a-8e8f-b8027b9814d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186309483} {:answer/id #uuid "e126aa57-9a75-5745-b52d-fda7d4fa7971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186310549}] :answer-field/correct {:answer/id #uuid "40109527-2da6-5399-9922-7e9d518987c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186309237} :answer-field/id #uuid "878292fb-d89c-5d5b-a679-78ab004bc741" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311177} {:answer-field/choices [{:answer/id #uuid "63bad373-7338-58aa-906e-eb34efc7bf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+y=c" :db/id #edb/ref 17592186309513} {:answer/id #uuid "a9003b3f-7a31-5040-b685-09977b462248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{1}{3}{x}^{3}{y}^{3}+2y=c" :db/id #edb/ref 17592186310114} {:answer/id #uuid "d0fcd743-a7be-56d3-bd31-82e8db685454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c" :db/id #edb/ref 17592186310427} {:answer/id #uuid "d22db97e-e112-5d17-a5e0-7ec914407346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{2}+{x}^{3}{y}^{3}+y=c" :db/id #edb/ref 17592186310439}] :answer-field/correct {:answer/id #uuid "d0fcd743-a7be-56d3-bd31-82e8db685454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c" :db/id #edb/ref 17592186310427} :answer-field/id #uuid "df51da9d-27f4-5dcc-802f-21eb4fe9d87a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311441}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24f77cc5-eae7-5d74-9490-65584fc368cc" :question/math-academy-id "q-337637" :question/problem "Consider the inexact differential equation\n\n$$\n(\\frac{5{y}^{2}}{x}+2{y}^{3})\\,\\text{d}x+(5y+2x{y}^{2}+\\frac{2}{{x}^{2}})\\,\\text{d}y=0.\n$$\n\nIt is known that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{2}{x}\n$$\n\nwhere the functions $P$ and $Q$ are given by \n\n$$\nP(x,y)=\\frac{5{y}^{2}}{x}+2{y}^{3},\\,Q(x,y)=5y+2x{y}^{2}+\\frac{2}{{x}^{2}}.\n$$\n\nUse this information to find a suitable integrating factor $I(x)$ and hence find the general solution to the equation.$\\,$ A suitable integrating factor is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is {{field-2}}, where $c$ is a constant." :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nWe are given that \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=\\frac{2}{x}.\n$$\n\nSince $\\frac{2}{x}$ is a function of $x$ only, we can conclude that the integrating factor for the equation is \n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int 2{x}^{-1}\\text{ }\\text{d}x} \\\\  & ={e}^{2\\operatorname{ln}⁡x} \\\\  & ={x}^{2}.\\end{aligned}\n$$\n\nMultiplying our equation by the integrating factor, we arrive at the following exact differential equation:\n\n$$\n\\begin{aligned}{x}^{2}[(\\frac{5{y}^{2}}{x}+2{y}^{3})\\,\\text{d}x+(5y+2x{y}^{2}+\\frac{2}{{x}^{2}})\\,\\text{d}y] & =0 \\\\ \\underbrace{(5x{y}^{2}+2{x}^{2}{y}^{3})}_{\\overset{~}{P}}\\,\\text{d}x+\\underbrace{(5{x}^{2}y+2{x}^{3}{y}^{2}+2)}_{\\overset{~}{Q}}\\,\\text{d}y & =0.\\end{aligned}\n$$\n\nFor this exact equation, we have\n\n$$\n\\overset{~}{P}(x,y)=5x{y}^{2}+2{x}^{2}{y}^{3},\\,\\overset{~}{Q}(x,y)=5{x}^{2}y+2{x}^{3}{y}^{2}+2.\n$$\n\nTo solve the equation, let's first integrate $\\overset{~}{P}(x,y)$ with respect to $x.$\nThe result should include an arbitrary function of $y,$ which we'll call $F(y):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{P}(x,y)\\,\\text{d}x+F(y) \\\\  & =\\int (5x{y}^{2}+2{x}^{2}{y}^{3})\\,\\text{d}x+F(y) \\\\  & =\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+F(y)\\end{aligned}\n$$\n\nNext, let's integrate $\\overset{~}{Q}(x,y)$ with respect to $y.$\nThe result should include an arbitrary function of $x,$ which we'll call $G(x):$\n\n$$\n\\begin{aligned}u(x,y) & =\\int \\overset{~}{Q}(x,y)\\,\\text{d}y+G(x) \\\\  & =\\int (5{x}^{2}y+2{x}^{3}{y}^{2}+2)\\,\\text{d}y+G(x) \\\\  & =\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y+G(x)\\end{aligned}\n$$\n\nComparing the two expressions, we must have\n\n$$\nF(y)=2y,\\,G(x)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\frac{5}{2}{x}^{2}{y}^{2}+\\frac{2}{3}{x}^{3}{y}^{3}+2y=c.\n$$"}] [{:db/id #edb/ref 17592186311873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ffdd0a1-0a35-5b24-99ea-94b9973f954a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}" :db/id #edb/ref 17592186309235} {:answer/id #uuid "4bd31a46-ae29-5e01-a12b-8c7a675b7c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186309325} {:answer/id #uuid "55b44314-7d8e-55e8-8a7d-181fa35e6a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}+1" :db/id #edb/ref 17592186309393} {:answer/id #uuid "c764cc9b-fcda-5258-add1-27d9639340d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{y}^{2}" :db/id #edb/ref 17592186310351}] :answer-field/correct {:answer/id #uuid "c764cc9b-fcda-5258-add1-27d9639340d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{y}^{2}" :db/id #edb/ref 17592186310351} :answer-field/id #uuid "17ab2035-ec62-5df4-b79d-b94f2c4b9423" :answer-field/key "field-4" :answer-field/type 