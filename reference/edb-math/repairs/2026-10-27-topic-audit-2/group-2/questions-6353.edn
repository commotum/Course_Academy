30430060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not" :db/id #edb/ref 17592186680858}] :answer-field/correct {:answer/id #uuid "0db0cbff-5955-5f15-8685-c11d02b44454" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186680833} :answer-field/id #uuid "99fc48e8-b2b8-5644-9570-72af2ef80d97" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680863} {:answer-field/choices [{:answer/id #uuid "61d0dbd8-e22c-5299-a98d-e372fa9b23c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M_y=N_x" :db/id #edb/ref 17592186680846} {:answer/id #uuid "f05482eb-1ad8-5715-870b-a78ddaabb3ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M_y\\ne N_x" :db/id #edb/ref 17592186680877}] :answer-field/correct {:answer/id #uuid "61d0dbd8-e22c-5299-a98d-e372fa9b23c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M_y=N_x" :db/id #edb/ref 17592186680846} :answer-field/id #uuid "a077b77f-bce2-5f99-be6f-cd300cf4c96e" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680865} {:answer-field/choices [{:answer/id #uuid "37586bc2-f594-5df8-9b60-c788e7c9f29e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186680841} {:answer/id #uuid "452137b7-2f61-574f-bdb0-3a2bb8cacad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186680843} {:answer/id #uuid "7ae63874-3634-5205-be06-b41f046227ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186680857} {:answer/id #uuid "99a74130-d653-5ec4-add4-ce5c7c367660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y" :db/id #edb/ref 17592186680862}] :answer-field/correct {:answer/id #uuid "99a74130-d653-5ec4-add4-ce5c7c367660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y" :db/id #edb/ref 17592186680862} :answer-field/id #uuid "d890537c-d860-582a-b470-61af0df99daa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680873}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "55ce604e-fb65-5b50-a0ee-102c40d5febb" :question/problem "Consider the inexact equation on the region $x>0$, $y>0$:\n\n$$\ny\\,\\mathrm{d}x+2x\\,\\mathrm{d}y=0.\n$$\n\nTest the proposed integrating factor $I(x,y)=y$ by completing the reasoning.\n\nMultiplying both coefficients gives\n\n$$\n{{field-1}}=0.\n$$\n\nFor the transformed equation, let $M=y^2$ and $N=2xy$. The exactness test compares\n\n$$\n\\frac{\\partial M}{\\partial y}={{field-2}},\\qquad \\frac{\\partial N}{\\partial x}={{field-3}}.\n$$\n\nSince {{field-4}}, the transformed equation {{field-5}} exact. Therefore, $I(x,y)=y$ {{field-6}} an integrating factor of the original equation." :question/worked-solution "An integrating factor must make the equation exact after multiplication. Here\n\n$$\ny\\bigl(y\\,\\mathrm{d}x+2x\\,\\mathrm{d}y\\bigr)=y^2\\,\\mathrm{d}x+2xy\\,\\mathrm{d}y=0.\n$$\n\nThus $M=y^2$ and $N=2xy$. Differentiate with the other variable held constant:\n\n$$\n\\begin{aligned}M_y&=\\frac{\\partial}{\\partial y}(y^2)=2y,\\\\N_x&=\\frac{\\partial}{\\partial x}(2xy)=2y.\\end{aligned}\n$$\n\nThe two partial derivatives agree throughout the region, so the transformed equation is exact. Since $y$ is defined and nonzero there, $I(x,y)=y$ is an integrating factor."}] [{:db/id #edb/ref 17592186680847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df2f1748-c6e0-585f-bcef-5877ecaaeacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2y+xy^2)e^{xy}" :db/id #edb/ref 17592186680874}] :answer-field/correct {:answer/id #uuid "df2f1748-c6e0-585f-bcef-5877ecaaeacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2y+xy^2)e^{xy}" :db/id #edb/ref 17592186680874} :answer-field/id #uuid "0ecb433f-2c48-5010-abcf-11328ffd9a1e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680834} {:answer-field/choices [{:answer/id #uuid "043b2cba-6dbb-54c7-81d3-2b806b51f912" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not" :db/id #edb/ref 17592186680830} {:answer/id #uuid "057f6426-aeea-5979-9219-5cdc65590ae3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186680831}] :answer-field/correct {:answer/id #uuid "057f6426-aeea-5979-9219-5cdc65590ae3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186680831} :answer-field/id #uuid "18ec0d9b-73bb-51ce-9422-afb95b4cb9d7" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680836} {:answer-field/choices [{:answer/id #uuid "bb0137eb-2fa0-5f63-adb6-6fc840924d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2y+xy^2)e^{xy}" :db/id #edb/ref 17592186680870}] :answer-field/correct {:answer/id #uuid "bb0137eb-2fa0-5f63-adb6-6fc840924d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2y+xy^2)e^{xy}" :db/id #edb/ref 17592186680870} :answer-field/id #uuid "28cab455-2227-5989-8674-56c0501a9677" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680840} {:answer-field/choices [{:answer/id #uuid "b5087bd1-7920-530d-9dd9-af7c9abdd131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^2e^{xy}" :db/id #edb/ref 17592186680866}] :answer-field/correct {:answer/id #uuid "b5087bd1-7920-530d-9dd9-af7c9abdd131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^2e^{xy}" :db/id #edb/ref 17592186680866} :answer-field/id #uuid "75392900-0a18-5a1b-a536-a135adbb1986" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680855} {:answer-field/choices [{:answer/id #uuid "c22e505c-a7c4-5306-8435-55819ef20bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(xy+1)e^{xy}" :db/id #edb/ref 17592186680871}] :answer-field/correct {:answer/id #uuid "c22e505c-a7c4-5306-8435-55819ef20bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(xy+1)e^{xy}" :db/id #edb/ref 17592186680871} :answer-field/id #uuid "9d11934f-4a56-5cbc-879d-7463546cde08" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680864}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61d668a9-e9a4-5957-83e6-efd703d7372e" :question/problem "Consider the differential equation on the region $x>0$, $y>0$:\n\n$$\ny^3\\,\\mathrm{d}x+(xy^2+y)\\,\\mathrm{d}y=0.\n$$\n\nTest whether $I(x,y)=\\dfrac{e^{xy}}{y}$ is an integrating factor. Record the coefficients after multiplication and the two derivatives needed to justify your conclusion.\n\nIn $I\\bigl[y^3\\,\\mathrm{d}x+(xy^2+y)\\,\\mathrm{d}y\\bigr]=M\\,\\mathrm{d}x+N\\,\\mathrm{d}y$,\n\n$M=$ {{field-1}}\n\n$N=$ {{field-2}}\n\n$M_y=$ {{field-3}}\n\n$N_x=$ {{field-4}}\n\nThe proposed function {{field-5}} an integrating factor." :question/worked-solution "First cancel the factor $y$ in each coefficient:\n\n$$\n\\begin{aligned}M&=\\frac{e^{xy}}{y}y^3=y^2e^{xy},\\\\N&=\\frac{e^{xy}}{y}(xy^2+y)=(xy+1)e^{xy}.\\end{aligned}\n$$\n\nThe exponential depends on both variables, so apply the product rule and the chain rule to both cross partials:\n\n$$\n\\begin{aligned}M_y&=2y e^{xy}+y^2\\bigl(xe^{xy}\\bigr)=(2y+xy^2)e^{xy},\\\\N_x&=y e^{xy}+(xy+1)\\bigl(ye^{xy}\\bigr)=(2y+xy^2)e^{xy}.\\end{aligned}\n$$\n\nThe cross partials agree as functions throughout the region. The transformed equation is exact, so the defined, nonzero function $I(x,y)=\\dfrac{e^{xy}}{y}$ is an integrating factor. The original equation is inexact: its cross partials are $3y^2$ and $y^2$. Multiplying first is essential."}] [{:db/id #edb/ref 17592186680859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efa01340-555e-5a58-afdc-9afd667545ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{y^2}" :db/id #edb/ref 17592186680876}] :answer-field/correct {:answer/id #uuid "efa01340-555e-5a58-afdc-9afd667545ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{y^2}" :db/id #edb/ref 17592186680876} :answer-field/id #uuid "3e1ff944-372f-5a38-b689-155815be7ea9" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680842} {:answer-field/choices [{:answer/id #uuid "6c2edf28-376a-51cb-bd67-294c2c02df76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{y}{x}" :db/id #edb/ref 17592186680852}] :answer-field/correct {:answer/id #uuid "6c2edf28-376a-51cb-bd67-294c2c02df76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{y}{x}" :db/id #edb/ref 17592186680852} :answer-field/id #uuid "64e03704-86e9-5ab5-b0c8-9d60e31044f3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680848} {:answer-field/choices [{:answer/id #uuid "6e61cd68-c7f7-5d17-8743-8f3dc3e9108c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^2}{y^2}" :db/id #edb/ref 17592186680854}] :answer-field/correct {:answer/id #uuid "6e61cd68-c7f7-5d17-8743-8f3dc3e9108c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^2}{y^2}" :db/id #edb/ref 17592186680854} :answer-field/id #uuid "69cef578-afc5-57fe-bc66-a818eba892fd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680851} {:answer-field/choices [{:answer/id #uuid "908a2600-93f1-5200-b0a8-0b604b74f53c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186680860} {:answer/id #uuid "f65e5786-d16f-501d-8eff-ad0538b8355c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not" :db/id #edb/ref 17592186680878}] :answer-field/correct {:answer/id #uuid "f65e5786-d16f-501d-8eff-ad0538b8355c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not" :db/id #edb/ref 17592186680878} :answer-field/id #uuid "d24def3a-3ef2-5c4f-8908-4b5df039d3f1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680872} {:answer-field/choices [{:answer/id #uuid "201902a8-d110-5c31-9afd-786112f8d385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{y^2}+\\frac{1}{x}" :db/id #edb/ref 17592186680839}] :answer-field/correct {:answer/id #uuid "201902a8-d110-5c31-9afd-786112f8d385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{y^2}+\\frac{1}{x}" :db/id #edb/ref 17592186680839} :answer-field/id #uuid "e1b27c4f-7aff-525a-98c7-ca45f3c1c6d0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186680875}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c820d02-c523-5ff1-a1b9-54b7dfdd5b11" :question/problem "On the region $x>0$, $y>0$, consider\n\n$$\n(x^2y+y^3)\\,\\mathrm{d}x-x^3\\,\\mathrm{d}y=0.\n$$\n\nIs $I(x,y)=\\dfrac{1}{xy^2}$ an integrating factor? Complete the test. After multiplying by $I$, write the equation as $M\\,\\mathrm{d}x+N\\,\\mathrm{d}y=0$:\n\n$M=$ {{field-1}}\n\n$N=$ {{field-2}}\n\nNow compute the cross partials:\n\n$M_y=$ {{field-3}}\n\n$N_x=$ {{field-4}}\n\nAn integrating factor requires $M_y=N_x$ throughout the region. Therefore, this candidate {{field-5}} an integrating factor." :question/worked-solution "Multiply the whole coefficient of each differential by the candidate:\n\n$$\n\\begin{aligned}M&=\\frac{x^2y+y^3}{xy^2}=\\frac{x}{y}+\\frac{y}{x},\\\\N&=-\\frac{x^3}{xy^2}=-\\frac{x^2}{y^2}.\\end{aligned}\n$$\n\nHolding the other variable constant gives\n\n$$\n\\begin{aligned}M_y&=-\\frac{x}{y^2}+\\frac{1}{x},\\\\N_x&=-\\frac{2x}{y^2}.\\end{aligned}\n$$\n\nTheir difference is\n\n$$\nM_y-N_x=\\frac{x}{y^2}+\\frac{1}{x}>0\\qquad(x>0,\\ y>0).\n$$\n\nThus they do not agree on the region. The transformed equation is not exact, and $I(x,y)=\\dfrac{1}{xy^2}$ is not an integrating factor. Testing the original coefficients alone would not test the proposed factor."}] [{:db/id #edb/ref 17592186680943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d528547-4468-5440-87cb-fe4b9020ba55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-3}((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y)=0" :db/id #edb/ref 17592186680949} {:answer/id #uuid "829d55a1-ae09-51d8-be03-7b0fb97fa9fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-4/x}((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y)=0" :db/id #edb/ref 17592186680958} {:answer/id #uuid "83e2036c-3370-5882-a08e-d6dbe6b7fdaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4}((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y)=0" :db/id #edb/ref 17592186680959} {:answer/id #uuid "a3fd75d2-0ac1-559c-96cf-27ed07075554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-4}((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y)=0" :db/id #edb/ref 17592186680978}] :answer-field/correct {:answer/id #uuid "a3fd75d2-0ac1-559c-96cf-27ed07075554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-4}((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y)=0" :db/id #edb/ref 17592186680978} :answer-field/id #uuid "479f32f6-6893-5e4f-a769-1f259d50eb28" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680941} {:answer-field/choices [{:answer/id #uuid "0603a86c-b60b-56b1-8d58-aafd353a2da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{x}" :db/id #edb/ref 17592186680918} {:answer/id #uuid "06bcb795-f22a-5329-b73b-6983c9036ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}" :db/id #edb/ref 17592186680919} {:answer/id #uuid "27dcc7ce-5549-55a6-8123-252188af12af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}" :db/id #edb/ref 17592186680928} {:answer/id #uuid "f29e73b3-3a8b-5e87-a2db-2448418dd5e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186681004}] :answer-field/correct {:answer/id #uuid "0603a86c-b60b-56b1-8d58-aafd353a2da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{x}" :db/id #edb/ref 17592186680918} :answer-field/id #uuid "47a2664b-6bfa-57c5-ac77-23be87403aae" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680942} {:answer-field/choices [{:answer/id #uuid "06f1ea67-6eed-57ca-86d0-c355f7826d01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-3}" :db/id #edb/ref 17592186680920} {:answer/id #uuid "34b290cd-a417-5d1d-a361-447f9af1a588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4}" :db/id #edb/ref 17592186680934} {:answer/id #uuid "75f2a216-0956-5225-9c47-e6b646aad081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-4/x}" :db/id #edb/ref 17592186680952} {:answer/id #uuid "db273b03-de6f-577b-bacb-b7a5b77b3491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-4}" :db/id #edb/ref 17592186680997}] :answer-field/correct {:answer/id #uuid "db273b03-de6f-577b-bacb-b7a5b77b3491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{-4}" :db/id #edb/ref 17592186680997} :answer-field/id #uuid "962c24ed-42ee-5060-8d28-b7460032fdde" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680969} {:answer-field/choices [{:answer/id #uuid "0463b3a9-e25f-598f-9662-fa8538779e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\,\\text{d}x+(x^2-3y)\\,\\text{d}y=0" :db/id #edb/ref 17592186680916} {:answer/id #uuid "7c28d9ec-6e73-578f-a179-f946f2130b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^2-3y)\\,\\text{d}x+\\,\\text{d}y=0" :db/id #edb/ref 17592186680956} {:answer/id #uuid "8d3097af-76db-5300-9c26-665f86f9d889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^2-3y)\\,\\text{d}x+x\\,\\text{d}y=0" :db/id #edb/ref 17592186680965} {:answer/id #uuid "a43be897-2fc4-5c51-b436-1d54084450a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^2+3y)\\,\\text{d}x+x\\,\\text{d}y=0" :db/id #edb/ref 17592186680979}] :answer-field/correct {:answer/id #uuid "8d3097af-76db-5300-9c26-665f86f9d889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^2-3y)\\,\\text{d}x+x\\,\\text{d}y=0" :db/id #edb/ref 17592186680965} :answer-field/id #uuid "d33bc9e6-8d0c-53b3-bd7a-f2f54be103d6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680992}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4d8892b7-fdff-5e8d-a5ff-43746d21795c" :question/problem "Find an integrating factor depending on $x$ alone that makes the following equation exact, on $x>0$.\n\n$$\nx y'=3y-x^2.\n$$\n\nUse the differential form obtained by moving the right-hand side to the left and multiplying by $\\text{d}x$, without dividing by $x$. Select the entries below. Choose the integrating factor normalized by $I(1)=1$.\n\nDifferential form:\n\n$$\n{{field-1}}\n$$\n\nFor this form, compute the quotient:\n\n$$\n\\frac{P_y-Q_x}{Q}={{field-2}}.\n$$\n\nThen an integrating factor is\n\n$$\nI(x)={{field-3}},\n$$\n\nand multiplying the differential form by it gives the exact equation\n\n$$\n{{field-4}}.\n$$" :question/worked-solution "Moving all terms to the left before multiplying by $\\text{d}x$ gives\n\n$$\n(x^2-3y)\\,\\text{d}x+x\\,\\text{d}y=0.\n$$\n\nThus $P=x^2-3y$ and $Q=x$. Treating the other variable as constant gives\n\n$$\nP_y=-3,\\qquad Q_x=1.\n$$\n\nThe original equation is inexact because these derivatives differ. Now\n\n$$\n\\frac{P_y-Q_x}{Q}=\\frac{-3-1}{x}=-\\frac{4}{x}.\n$$\n\nThis depends on $x$ only. For an $x$-dependent integrating factor, exactness requires $I P_y=I'Q+I Q_x$, so $I'/I=(P_y-Q_x)/Q$. Therefore\n\n$$\n\\begin{aligned}\nI(x)&=\\exp\\left(\\int -\\frac{4}{x}\\,\\text{d}x\\right)\\\\\n&=\\exp(-4\\ln x)\\\\\n&=x^{-4}.\n\\end{aligned}\n$$\n\nHere $x>0$ justifies $\\ln x$, and the multiplicative constant is one because $I(1)=1$. Multiplying the original differential form gives\n\n$$\nx^{-4}\\left((x^2-3y)\\,\\text{d}x+x\\,\\text{d}y\\right)=0.\n$$\n\nTo check exactness afterward, write the new coefficients as $M=x^{-2}-3yx^{-4}$ and $N=x^{-3}$. Then\n\n$$\nM_y=-3x^{-4}=N_x.\n$$\n\nSo the transformed equation is exact. The factor applies to the specified differential form; dividing the original form by $x$ first would change the factor needed."}] [{:db/id #edb/ref 17592186680967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d17402-1c96-5320-9437-dedc2f8e2e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})" :db/id #edb/ref 17592186680933} {:answer/id #uuid "3b299d27-1549-52fd-bc1b-d2557e0fc08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})" :db/id #edb/ref 17592186680936} {:answer/id #uuid "850ad2d3-c912-5f58-aabe-8ac7c5df5755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{\\partial P}{\\partial y}+\\frac{\\partial Q}{\\partial x})" :db/id #edb/ref 17592186680960} {:answer/id #uuid "fe74097c-5bee-56f5-bd22-46d0ab26fc60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}+\\frac{\\partial Q}{\\partial x})" :db/id #edb/ref 17592186681010}] :answer-field/correct {:answer/id #uuid "3b299d27-1549-52fd-bc1b-d2557e0fc08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})" :db/id #edb/ref 17592186680936} :answer-field/id #uuid "03b38b35-d90d-5b05-90f5-6f0581444159" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680915} {:answer-field/choices [{:answer/id #uuid "1936ff6b-fc63-55e5-b517-8008aa5a0e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- 2 x}((2 x y - 3 x)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186680925} {:answer/id #uuid "d94a7b73-eaa9-5d07-a259-f4151dfb8a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- x^{2}}((2 x y - 3 x)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186680995} {:answer/id #uuid "e1306b82-8cf1-5f7a-986e-028dc747ff2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x^{2}}((2 x y - 3 x)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186681001} {:answer/id #uuid "fc677e8f-98f4-5b5a-bd2b-9484fad0b480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{2 x}((2 x y - 3 x)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186681009}] :answer-field/correct {:answer/id #uuid "e1306b82-8cf1-5f7a-986e-028dc747ff2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x^{2}}((2 x y - 3 x)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186681001} :answer-field/id #uuid "09db790c-c798-5e7b-b76c-667670f97e18" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186680921} {:answer-field/choices [{:answer/id #uuid "22f072d9-108d-596e-b440-e6aa9883a25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{x}" :db/id #edb/ref 17592186680927} {:answer/id #uuid "29b42935-2871-5d1e-