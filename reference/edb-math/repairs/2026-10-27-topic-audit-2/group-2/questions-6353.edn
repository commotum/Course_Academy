ref 17592186310493} {:answer/id #uuid "efe296da-cfd2-5e0e-b9da-f263b3d0120f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186310661}] :answer-field/correct {:answer/id #uuid "efe296da-cfd2-5e0e-b9da-f263b3d0120f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186310661} :answer-field/id #uuid "a02e7a88-0b72-5f22-928e-11487eed9816" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311256} {:answer-field/choices [{:answer/id #uuid "047944f3-d362-5653-9c31-1326ae272f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186308778} {:answer/id #uuid "7fc8cecd-6963-516f-8661-be9df221ebe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309747} {:answer/id #uuid "86381135-6cef-5057-81a2-b74315d11145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186309799} {:answer/id #uuid "9eab5566-ffab-5b1a-a066-7f89ba1e4307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186310028}] :answer-field/correct {:answer/id #uuid "9eab5566-ffab-5b1a-a066-7f89ba1e4307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186310028} :answer-field/id #uuid "c16c3297-8e94-5309-b982-bcfe725a491c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311351} {:answer-field/choices [{:answer/id #uuid "2eff5820-e0e1-557f-ba66-9b4633b38e63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186309106} {:answer/id #uuid "6944ac20-9fac-51b7-8527-ffeba8049c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}" :db/id #edb/ref 17592186309561} {:answer/id #uuid "9281fa81-650d-5a52-a326-5c9c50de4b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{-1}" :db/id #edb/ref 17592186309916} {:answer/id #uuid "e25d4223-3f88-51ed-8c8d-632419954a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}" :db/id #edb/ref 17592186310559}] :answer-field/correct {:answer/id #uuid "2eff5820-e0e1-557f-ba66-9b4633b38e63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186309106} :answer-field/id #uuid "db2815c8-eadc-5a5e-87c5-e32edcb77a09" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311434}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ff77e1b-8c3d-580c-a6d9-d90a052f53dd" :question/math-academy-id "q-337523" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n3x\\,{y}^{′}=-6y-4{x}^{2}\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below.For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nFirst, we rewrite our equation in differential form. This gives\n\n$$\n{{field-3}}.\n$$\n\nLet's denote\n\n$$\nP(x,y)=4{x}^{2}+6y,\\,Q(x,y)=3x.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}=\\,{{field-4}}\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-5}}\n$$\n\nSince for this equation \n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-6}},\n$$\n\nwhich depends on $x$ only, then an integrating factor for our equation is\n\n$$\nI(x)={{field-7}},\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-8}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y,$ then an integrating factor for the equation is\n\n$$\nI(x)=\\operatorname{exp}⁡(\\int g(x)\\,\\text{d}x)\n$$\n\nwhere $\\operatorname{exp}⁡(x)$ denotes the exponential function ${e}^{x}.$\n\nFirst, we rewrite our equation in differential form: \n\n$$\n(4{x}^{2}+6y)\\,\\text{d}x+3x\\,\\text{d}y=0\n$$\n\nLet's denote \n\n$$\nP(x,y)=4{x}^{2}+6y,\\,Q(x,y)=3x.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(4{x}^{2}+6y)=6 \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}3x=3\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =\\frac{1}{3x}(6-3) \\\\  & =\\frac{1}{3x}\\cdot 3 \\\\  & =\\frac{1}{x},\\end{aligned}\n$$\n\nis a function of $x$ only, we can conclude that an integrating factor for the equation is\n\n$$\n\\begin{aligned}I(x) & =\\operatorname{exp}⁡(\\int \\frac{1}{x}\\,\\text{d}x) \\\\  & =\\operatorname{exp}⁡(\\operatorname{ln}⁡x) \\\\  & =x\\end{aligned}\n$$\n\nand by multiplying our differential equation by the integrating factor, we have\n\n$$\nI(x)\\cdot ((4{x}^{2}+6y)\\,\\text{d}x+3x\\,\\text{d}y)=I(x)\\cdot 0\n$$\n\nwhich simplifies as\n\n$$\nx\\cdot ((4{x}^{2}+6y)\\,\\text{d}x+3x\\,\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186311863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a43b3012-16cb-5208-bab4-c20770b3f2fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-2}{e}^{1/(2y)}\\cdot (2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186310071} {:answer/id #uuid "db134198-ef62-58eb-9844-bd15199bb96c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{1/(2y)}\\cdot (2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186310504} {:answer/id #uuid "f7e7e8f3-2ca3-5b4e-a232-4037add6e168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/(2y)}\\cdot (2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186310720}] :answer-field/correct {:answer/id #uuid "db134198-ef62-58eb-9844-bd15199bb96c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{1/(2y)}\\cdot (2{y}^{3}\\,\\text{d}x-xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186310504} :answer-field/id #uuid "38b62e41-1376-596c-afb8-325e3e6d3c3c" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186310943} {:answer-field/choices [{:answer/id #uuid "18790ca8-255a-58f4-b672-a7855c4765d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{y}^{2}" :db/id #edb/ref 17592186308943} {:answer/id #uuid "df98fd19-cbc6-5002-af14-dceb70b85160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{3}" :db/id #edb/ref 17592186310541} {:answer/id #uuid "f0c6205b-fad7-512c-9444-95ce8d1a8f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186310667} {:answer/id #uuid "fae6870f-5eed-5ef6-bdf9-5b908417a02b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y" :db/id #edb/ref 17592186310747}] :answer-field/correct {:answer/id #uuid "fae6870f-5eed-5ef6-bdf9-5b908417a02b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y" :db/id #edb/ref 17592186310747} :ans