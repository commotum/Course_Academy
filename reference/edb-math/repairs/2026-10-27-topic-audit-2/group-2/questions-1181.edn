3bb06b154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693715} {:answer/id #uuid "c3887bbd-0728-5d30-95e0-f6362dfdfe1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693725}] :answer-field/correct {:answer/id #uuid "6c5b2187-a57d-5842-a971-54d3bb06b154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693715} :answer-field/id #uuid "a747a0a5-6fa3-5c2e-a11c-08dd09acd2f8" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693723}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0eaa0d34-f319-5b74-9452-ae6554aa7dfa" :question/problem "Consider the differential equation\n\n$$\ny'=- y - 1,\\qquad x\\in\\mathbb{R}.\n$$\n\nThe derivatives of the proposed functions are provided:\n\n- For $y=-1 + e^{- x}$, $y'=- e^{- x}$.\n- For $y=-1 + 3 e^{- x}$, $y'=- 3 e^{- x}$.\n- For $y=-2 - e^{- x}$, $y'=e^{- x}$.\n\nSubstitute each function and its derivative into the equation. Which functions are solutions throughout the stated interval? Select all that apply." :question/worked-solution "A function is a **solution** if its derivative equals the differential equation's right-hand side at every point of the stated interval. Differentiate each candidate and substitute it for $y$.\n\nFor $y=-1 + e^{- x}$:\n\n$$\n\\begin{aligned}y'&=- e^{- x}\\\\\\text{RHS}&=-1\\cdot \\left(-1 + e^{- x}+1\\right)\\\\&=- e^{- x}.\\end{aligned}\n$$\n\nThe two expressions agree throughout the interval, so this function **is a solution**.\n\nFor $y=-1 + 3 e^{- x}$:\n\n$$\n\\begin{aligned}y'&=- 3 e^{- x}\\\\\\text{RHS}&=-1\\cdot \\left(-1 + 3 e^{- x}+1\\right)\\\\&=- 3 e^{- x}.\\end{aligned}\n$$\n\nThe two expressions agree throughout the interval, so this function **is a solution**.\n\nFor $y=-2 - e^{- x}$:\n\n$$\n\\begin{aligned}y'&=e^{- x}\\\\\\text{RHS}&=-1\\cdot \\left(-2 - e^{- x}+1\\right)\\\\&=1 + e^{- x}.\\end{aligned}\n$$\n\nAt $x=1$, $y'=e^{-1}$ whereas $\\text{RHS}=e^{-1} + 1$. Thus they are not identical, so this function **is not a solution**.\n\nSelect the functions verified above; do not select **None of the above**."}] [{:db/id #edb/ref 17592186693730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0ced44-f4cf-5ca4-bd40-570d7c7fa734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693710} {:answer/id #uuid "7271b169-000a-59c7-b763-80efb6171556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693716}] :answer-field/correct {:answer/id #uuid "1e0ced44-f4cf-5ca4-bd40-570d7c7fa734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693710} :answer-field/id #uuid "3206ca4b-7b6f-5b3f-bc6f-837280e24dd1" :answer-field/key "$y=3 e^{x} - 1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693712} {:answer-field/choices [{:answer/id #uuid "0a31e880-2ce5-5dce-b87b-5171cee78ee9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693706} {:answer/id #uuid "e40f3de0-a87a-574f-b773-8f0f85ec906b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693729}] :answer-field/correct {:answer/id #uuid "e40f3de0-a87a-574f-b773-8f0f85ec906b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693729} :answer-field/id #uuid "84b5bb82-6a5f-5063-ba24-153b2824ee75" :answer-field/key "$y=-1 - e^{- x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693718} {:answer-field/choices [{:answer/id #uuid "3ce62aed-3126-5507-9895-758fb53d0e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693713} {:answer/id #uuid "c5e8b3cc-b558-5cc5-9fcf-f78587d707f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693727}] :answer-field/correct {:answer/id #uuid "c5e8b3cc-b558-5cc5-9fcf-f78587d707f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693727} :answer-field/id #uuid "9e191b15-57ea-5236-ad06-d06498f89f19" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693722} {:answer-field/choices [{:answer/id #uuid "04c7846e-46b5-5d6e-b232-f53f866702c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693705} {:answer/id #uuid "0f47aa99-8480-5991-aaa4-1ba8ae3362da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693709}] :answer-field/correct {:answer/id #uuid "0f47aa99-8480-5991-aaa4-1ba8ae3362da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693709} :answer-field/id #uuid "c415b7fa-ea33-5a79-9aa5-5d4bf000af65" :answer-field/key "$y=- 3 e^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693726}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee3c54c5-ac35-58e1-b942-98f02efdd920" :question/problem "Consider the differential equation\n\n$$\ny'=y + 1,\\qquad x\\in\\mathbb{R}.\n$$\n\nThe derivatives of the proposed functions are provided:\n\n- For $y=-1 - e^{- x}$, $y'=e^{- x}$.\n- For $y=3 e^{x} - 1$, $y'=3 e^{x}$.\n- For $y=- 3 e^{x}$, $y'=- 3 e^{x}$.\n\nSubstitute each function and its derivative into the equation. Which functions are solutions throughout the stated interval? Select all that apply." :question/worked-solution "A function is a **solution** if its derivative equals the differential equation's right-hand side at every point of the stated interval. Differentiate each candidate and substitute it for $y$.\n\nFor $y=-1 - e^{- x}$:\n\n$$\n\\begin{aligned}y'&=e^{- x}\\\\\\text{RHS}&=1\\cdot \\left(-1 - e^{- x}+1\\right)\\\\&=- e^{- x}.\\end{aligned}\n$$\n\nAt $x=1$, $y'=e^{-1}$ whereas $\\text{RHS}=- \\frac{1}{e}$. Thus they are not identical, so this function **is not a solution**.\n\nFor $y=3 e^{x} - 1$:\n\n$$\n\\begin{aligned}y'&=3 e^{x}\\\\\\text{RHS}&=1\\cdot \\left(3 e^{x} - 1+1\\right)\\\\&=3 e^{x}.\\end{aligned}\n$$\n\nThe two expressions agree throughout the interval, so this function **is a solution**.\n\nFor $y=- 3 e^{x}$:\n\n$$\n\\begin{aligned}y'&=- 3 e^{x}\\\\\\text{RHS}&=1\\cdot \\left(- 3 e^{x}+1\\right)\\\\&=1 - 3 e^{x}.\\end{aligned}\n$$\n\nAt $x=1$, $y'=- 3 e$ whereas $\\text{RHS}=1 - 3 e$. Thus they are not identical, so this function **is not a solution**.\n\nSelect the functions verified above; do not select **None of the above**."}] [{:db/id #edb/ref 17592186693737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4555a466-59b2-5011-b899-a2719595ca8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693733} {:answer/id #uuid "9fd0d0d3-3b7d-5fea-8c41-bad882abd587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693739}] :answer-field/correct {:answer/id #uuid "9fd0d0d3-3b7d-5fea-8c41-bad882abd587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693739} :answer-field/id #uuid "1469d15b-85a4-5f19-9766-74a169f589e1" :answer-field/key "$y=2\\ln\\left(2 x + 3\\right)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693731} {:answer-field/choices [{:answer/id #uuid "4aa2daa5-1810-5210-bb5e-23674acf3da5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693734} {:answer/id #uuid "7ff83dc6-4609-5935-bb90-69fcd0e0fb0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693735}] :answer-field/correct {:answer/id #uuid "4aa2daa5-1810-5210-bb5e-23674acf3da5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693734} :answer-field/id #uuid "8c07be9b-9008-57c3-98cf-81f9bccaf9c9" :answer-field/key "$y=2\\ln\\left(x + 2\\right)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693736} {:answer-field/choices [{:answer/id #uuid "268828cf-b15b-524a-9cfb-c10d476cc9ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693732} {:answer/id #uuid "9c2d6927-f3ec-541d-ad6d-873d7609e103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693738}] :answer-field/correct {:answer/id #uuid "268828cf-b15b-524a-9cfb-c10d476cc9ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693732} :answer-field/id #uuid "b770e707-9a8f-590c-b797-2f039d9c821f" :answer-field/key "$y=\\ln\\left(4 x^{2} + 2\\right)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693740} {:answer-field/choices [{:answer/id #uuid "e1e12c93-8167-58b6-9ac1-e91ef4aae9b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693741} {:answer/id #uuid "ed2589a3-2495-5440-a1bc-9467e35ad6ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693742}] :answer-field/correct {:answer/id #uuid "ed2589a3-2495-5440-a1bc-9467e35ad6ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693742} :answer-field/id #uuid "ff99b2f9-9ad6-53b9-88c1-a53e7be4a7a9" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693743}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d3c1a08-83b4-5f5a-9f1b-a6b2849d5bd4" :question/problem "Consider the differential equation\n\n$$\ny'=\\frac{4}{e^{y/2}},\\qquad x>0.\n$$\n\nWhich functions are solutions throughout the stated interval? Select all that apply." :question/worked-solution "A function is a **solution** if its derivative equals the differential equation's right-hand side at every point of the stated interval. Differentiate each candidate and substitute it for $y$.\n\nFor $y=2\\ln\\left(x + 2\\right)$:\n\nThe logarithm arguments are positive because $x>0$. Using the exponential and logarithm identities gives\n\n$$\n\\begin{aligned}e^{\\frac{2\\ln\\left(x + 2\\right)}{2}}&=x + 2\\end{aligned}\n$$\n\n$$\n\\begin{aligned}y'&=\\frac{2}{x + 2}\\\\\\text{RHS}&=\\frac{4}{e^{\\frac{2\\ln\\left(x + 2\\right)}{2}}}\\\\&=\\frac{4}{x + 2}.\\end{aligned}\n$$\n\nAt $x=1$, $y'=\\frac{2}{3}$ whereas $\\text{RHS}=\\frac{4}{3}$. Thus they are not identical, so this function **is not a solution**.\n\nFor $y=\\ln\\left(4 x^{2} + 2\\right)$:\n\nThe logarithm arguments are positive because $x>0$. Using the exponential and logarithm identities gives\n\n$$\n\\begin{aligned}e^{\\frac{\\ln\\left(4 x^{2} + 2\\right)}{2}}&=\\sqrt{4 x^{2} + 2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}y'&=\\frac{8 x}{4 x^{2} + 2}\\\\\\text{RHS}&=\\frac{4}{e^{\\frac{\\ln\\left(4 x^{2} + 2\\right)}{2}}}\\\\&=\\frac{4}{\\sqrt{4 x^{2} + 2}}.\\end{aligned}\n$$\n\nAt $x=1$, $y'=\\frac{4}{3}$ whereas $\\text{RHS}=\\frac{2 \\sqrt{6}}{3}$. Thus they are not identical, so this function **is not a solution**.\n\nFor $y=2\\ln\\left(2 x + 3\\right)$:\n\nThe logarithm arguments are positive because $x>0$. Using the exponential and logarithm identities gives\n\n$$\n\\begin{aligned}e^{\\frac{2\\ln\\left(2 x + 3\\right)}{2}}&=2 x + 3\\end{aligned}\n$$\n\n$$\n\\begin{aligned}y'&=\\frac{4}{2 x + 3}\\\\\\text{RHS}&=\\frac{4}{e^{\\frac{2\\ln\\left(2 x + 3\\right)}{2}}}\\\\&=\\frac{4}{2 x + 3}.\\end{aligned}\n$$\n\nThe two expressions agree throughout the interval, so this function **is a solution**.\n\nSelect the functions verified above; do not select **None of the above**."}] [{:db/id #edb/ref 17592186693762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63d02c8f-204b-5c28-980c-4c2a85970f0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693757} {:answer/id #uuid "c2d07ad1-31b9-5f37-9f24-996b5be59e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693763}] :answer-field/correct {:answer/id #uuid "63d02c8f-204b-5c28-980c-4c2a85970f0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693757} :answer-field/id #uuid "06c77331-6bae-5c58-870e-fafa8f3ac67f" :answer-field/key "I. $f\\prime(x)=\\frac{1}{x}$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693752} {:answer-field/choices [{:answer/id #uuid "749ea36f-0f70-54da-b2f1-852f1f494e77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693758} {:answer/id #uuid "88de5274-722e-5e28-b426-7c760a6a5700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693761}] :answer-field/correct {:answer/id #uuid "88de5274-722e-5e28-b426-7c760a6a5700" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693761} :answer-field/id #uuid "0ef86690-0601-5d1c-a8fc-720df449ccc5" :answer-field/key "II. Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693753} {:answer-field/choices [{:answer/id #uuid "77d560a6-958e-5fac-afb3-e1b9527db12a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693759} {:answer/id #uuid "81a0fdf1-0e70-5682-a270-9c4da7efb4c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693760}] :answer-field/correct {:answer/id #uuid "81a0fdf1-0e70-5682-a270-9c4da7efb4c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693760} :answer-field/id #uuid "306aa08a-2c42-52b2-8618-851dae21cb37" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693755} {:answer-field/choices [{:answer/id #uuid "13348c41-18a0-55e3-b6a4-18f33c18b7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693754} {:answer/id #uuid "f5f0f4f3-78d8-5b76-8ea4-ba260995dc97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186693764}] :answer-field/correct {:answer/id #uuid "13348c41-18a0-55e3-b6a4-18f33c18b7b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186693754} :answer-field/id #uuid "38fbe813-32fe-57ec-933b-a5c0313a4d21" :answer-field/key "III. The function $y=f(x)$ is a solution of the differential equation." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186693756}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8da2d89c-02ff-5465-858c-fc26aeabe7c2" :question/problem "Consider the differential equation.\n\n$$\nxe^y y\\prime-3e^y=3 x^{4},\\qquad x>0.\n$$\n\nLet $f(x)=4\\ln x+\\ln 3$. Which statements are true? Select all that apply." :question/worked-solution "A solution must satisfy the equation throughout the stated interval. Here $x>0$ makes the logarithm defined.\n\nDifferentiate the candidate:\n\n$$\nf\\prime(x)=4\\frac{1}{x}+0=\\frac{4}{x}.\n$$\n\nStatement I is false.\n\nBefore substituting, simplify the exponential using the logarithm power rule and inverse identity:\n\n$$\n\\begin{aligned}e^{f(x)}&=e^{4\\ln x+\\ln 3}\\\\&=e^{4\\ln x}e^{\\ln 3}\\\\&=e^{\\ln(x^{4})}\\cdot 3\\\\&=3 x^{4}.\\end{aligned}\n$$\n\nSubstitute into the entire left side:\n\n$$\n\\begin{aligned}xe^{f(x)}f\\prime(x)-3e^{f(x)}&=x\\left(3 x^{4}\\right)\\frac{4}{x}-3\\left(3 x^{4}\\right)\\\\&=12 x^{4}-9 x^{4}\\\\&=3 x^{4}.\\end{aligned}\n$$\n\nThe right side is $3 x^{4}$. These expressions agree for every $x>0$. Statement II is true, so statement III is true.\n\nSelect II and III only."}] [{:db/id #edb/ref 17592186693847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5bec109-c4fa-5c7f-bfaa-ef319fd5717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186693852}] :answer-field/correct {:answer/id #uuid "a5bec109-c4fa-5c7f-bfaa-ef319fd5717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186693852} :answer-field/id #uuid "747b31e9-ebc3-5286-a19f-39def838e41e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693848}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6920e0c1-c003-54b9-944b-5174d25c01e6" :question/problem "Consider the following initial value problem for all real $x$:\n\n$$\n\\frac{dy}{dx}=- 2 y,\\qquad y(0)=-3.\n$$\n\nYou are given that $y=A e^{- 2 x}$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y(0)=-3$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n-3&=A\\cdot e^{(-2)(0)}\\\\\n-3&=A\\cdot\\left(1\\right)\\\\\nA&=\\frac{-3}{1}=-3.\n\\end{aligned}\n$$\n\nThus $A=-3$, and the solution is $y=\\left(-3\\right) e^{- 2 x}$ on the stated interval."}] [{:db/id #edb/ref 17592186693851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31ac0ed2-39d6-59c2-bc95-a7d9a6d19fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186693846}] :answer-field/correct {:answer/id #uuid "31ac0ed2-39d6-59c2-bc95-a7d9a6d19fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186693846} :answer-field/id #uuid "7a09d96d-b46c-5427-be0a-cc531857b386" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693850}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "925c40c9-4604-5170-bbe9-02633a7c826c" :question/problem "Consider the following initial value problem for all real $x$:\n\n$$\n\\frac{dy}{dx}=- 2 y,\\qquad y(0)=-2.\n$$\n\nYou are given that $y=A e^{- 2 x}$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y(0)=-2$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n-2&=A\\cdot e^{(-2)(0)}\\\\\n-2&=A\\cdot\\left(1\\right)\\\\\nA&=\\frac{-2}{1}=-2.\n\\end{aligned}\n$$\n\nThus $A=-2$, and the solution is $y=\\left(-2\\right) e^{- 2 x}$ on the stated interval."}] [{:db/id #edb/ref 17592186693853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7645457b-c063-5605-97a0-24c133f5831e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186693849}] :answer-field/correct {:answer/id #uuid "7645457b-c063-5605-97a0-24c133f5831e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186693849} :answer-field/id #uuid "14893af9-c307-52a7-8eba-e03498b444ec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693842}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc02d18b-918c-5ee3-847d-3877c1a97792" :question/problem "Consider the following initial value problem on the interval containing the initial point where $x>0$:\n\n$$\n\\frac{dy}{dx}=\\frac{y}{x},\\qquad y(1)=0.\n$$\n\nYou are given that $y=A x$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y(1)=0$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n0&=A\\cdot (1)^{1}\\\\\n0&=A\\cdot\\left(1\\right)\\\\\nA&=\\frac{0}{1}=0.\n\\end{aligned}\n$$\n\nThus $A=0$, and the solution is $y=\\left(0\\right) x$ on the stated interval."}] [{:db/id #edb/ref 17592186693854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa9b9fe-6179-5132-9348-173e1d3edb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186693843}] :answer-field/correct {:answer/id #uuid "1aa9b9fe-6179-5132-9348-173e1d3edb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186693843} :answer-field/id #uuid "25f6d100-5a2a-582b-a2c9-c4e708201c44" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ceda7b33-27c8-53e5-8f96-45743d47cf56" :question/problem "Consider the following initial value problem on the interval containing the initial point where $x<0$:\n\n$$\n\\frac{dy}{dx}=\\frac{y}{x},\\qquad y(-1)=1.\n$$\n\nYou are given that $y=A x$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y(-1)=1$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n1&=A\\cdot (-1)^{1}\\\\\n1&=A\\cdot\\left(-1\\right)\\\\\nA&=\\frac{1}{-1}=-1.\n\\end{aligned}\n$$\n\nThus $A=-1$, and the solution is $y=\\left(-1\\right) x$ on the stated interval."}] [{:db/id #edb/ref 17592186693855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0502e52f-58a1-5e8b-bdf3-b1650ce68ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186693841}] :answer-field/correct {:answer/id #uuid "0502e52f-58a1-5e8b-bdf3-b1650ce68ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186693841} :answer-field/id #uuid "2cab9764-eadd-59da-808a-4f2bfdf8ea80" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693845}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ddd2e1f7-a2b4-5017-8666-09917204cbcb" :question/problem "Consider the following initial value problem on the interval containing the initial point where $\\sin{(3 x )}\\ne0$:\n\n$$\n\\frac{dy}{dx}=3 y \\cot{(3 x )},\\qquad y\\left(\\frac{\\pi }{6}\\right)=3.\n$$\n\nYou are given that $y=A \\sin{(3 x )}$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y\\left(\\frac{\\pi }{6}\\right)=3$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n3&=A\\cdot \\sin\\left((3)\\left(\\frac{\\pi }{6}\\right)\\right)\\\\\n3&=A\\cdot\\left(1\\right)\\\\\nA&=\\frac{3}{1}=3.\n\\end{aligned}\n$$\n\nThus $A=3$, and the solution is $y=\\left(3\\right) \\sin{(3 x )}$ on the stated interval."}] [{:db/id #edb/ref 17592186693859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01d2af51-cfae-5685-aa59-995030dc154b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{3}}{3}" :db/id #edb/ref 17592186693857}] :answer-field/correct {:answer/id #uuid "01d2af51-cfae-5685-aa59-995030dc154b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{4 \\sqrt{3}}{3}" :db/id #edb/ref 17592186693857} :answer-field/id #uuid "3c15a1a3-1bcc-5a8d-8a71-8781cb270753" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186693858}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b76bb61d-760e-58eb-95fd-e240baaf005d" :question/problem "Consider the following initial value problem on the interval containing the initial point where $\\sin{(3 x )}\\ne0$:\n\n$$\n\\frac{dy}{dx}=3 y \\cot{(3 x )},\\qquad y\\left(\\frac{2 \\pi}{9}\\right)=-2.\n$$\n\nYou are given that $y=A \\sin{(3 x )}$ is the solution family. What is the value of the constant $A$?\n\n$A=${{field-1}}" :question/worked-solution "The supplied family satisfies the differential equation. Substitute $y\\left(\\frac{2 \\pi}{9}\\right)=-2$ into it and solve for $A$:\n\n$$\n\\begin{aligned}\n-2&=A\\cdot \\sin\\left((3)\\left(\\frac{2 \\pi}{9}\\right)\\right)\\\\\n-2&=A\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\\nA&=\\frac{-2}{\\frac{\\sqrt{3}}{2}}=- \\frac{4 \\sqrt{3}}{3}.\n\\end{aligned}\n$$\n\nThus $A=- \\frac{4 \\sqrt{3}}{3}$, and the solution is $y=\\left(- \\frac{4 \\sqrt{3}}{3}\\right) \\sin{(3 x )}$ on the stated interval."}]}
