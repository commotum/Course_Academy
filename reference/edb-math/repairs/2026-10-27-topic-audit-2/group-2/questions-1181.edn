f 17592186437973}] :answer-field/correct {:answer/id #uuid "a63eedbc-25e0-50eb-944b-f8fe7cfea503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437973} :answer-field/id #uuid "ce33855e-6605-5dff-989b-b31182ec13fc" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439015} {:answer-field/choices [{:answer/id #uuid "e7cea9b4-87d2-5c17-8ad9-cf2408439811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668393} {:answer/id #uuid "1a1abdf5-ac73-5153-b44e-67e6be4224d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668394}] :answer-field/correct {:answer/id #uuid "e7cea9b4-87d2-5c17-8ad9-cf2408439811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668393} :answer-field/id #uuid "d789fc2b-fa29-538c-9e1b-ed0708c2a2eb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668774}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8806c061-892c-5fd2-baf1-cd903aa5ea31" :question/math-academy-id "q-141089" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{2y}{x},\\,x\\ne 0\n$$\n\nLet $f(x)=-3{x}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=-5x$ is false. Differentiating $f(x)=-3{x}^{2},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(-3{x}^{2})}^{′} \\\\  & =-3\\cdot 2x \\\\  & =-6x \\\\  & \\ne -5x.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true. Substituting $y=-3{x}^{2}$ and ${y}^{′}=-6x$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{2y}{x} \\\\ -6x & \\overset{?}{=}\\frac{2(-3{x}^{2})}{x} \\\\ -6x & =-6x\\,✓\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is true. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true, the function $y=-3{x}^{2}$ is a solution to our differential equation.\n\nTherefore, the correct answer is “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement”; “The function $y=f(x)$ is a solution of the differential equation” only."}] [{:db/id #edb/ref 17592186272204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c667e6-310e-5bb3-abf7-6315816cc3b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437974} {:answer/id #uuid "db3fe3a6-70e3-5cce-8c97-d3259c62d677" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437975}] :answer-field/correct {:answer/id #uuid "db3fe3a6-70e3-5cce-8c97-d3259c62d677" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437975} :answer-field/id #uuid "63194eb9-d476-519a-91f1-8caa84c9e521" :answer-field/key "$y=\\operatorname{sin}⁡2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439016} {:answer-field/choices [{:answer/id #uuid "ae3abeb4-8839-5211-a768-11057573634d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437976} {:answer/id #uuid "f012982e-627f-59eb-84ad-762b4568f3ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437977}] :answer-field/correct {:answer/id #uuid "ae3abeb4-8839-5211-a768-11057573634d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437976} :answer-field/id #uuid "566d8174-6351-5c75-b0e9-eb5a68f640f6" :answer-field/key "$y=\\operatorname{sin}⁡2x+1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439017} {:answer-field/choices [{:answer/id #uuid "30de8136-a64d-55ca-874e-99d7fd9ffc6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437978} {:answer/id #uuid "c1bc8de1-5d6d-553a-9b99-6f5e3f57a058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437979}] :answer-field/correct {:answer/id #uuid "c1bc8de1-5d6d-553a-9b99-6f5e3f57a058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437979} :answer-field/id #uuid "93e846ba-51fc-5861-b0ff-f945cc525241" :answer-field/key "$y=-3\\operatorname{sin}⁡2x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439018}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e106766c-2780-56ea-8754-563b11d222dd" :question/math-academy-id "q-141091" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=2y\\operatorname{cot}⁡2x.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=\\operatorname{sin}⁡2x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=2\\operatorname{cos}⁡2x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2y\\operatorname{cot}⁡2x \\\\ 2\\operatorname{cos}⁡2x & \\overset{?}{=}2\\operatorname{sin}⁡2x\\cdot \\operatorname{cot}⁡2x \\\\ 2\\operatorname{cos}⁡2x & =2\\operatorname{cos}⁡2x.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=\\operatorname{sin}⁡2x$ *is* a solution to our differential equation.\n\n- Differentiating $y=\\operatorname{sin}⁡2x+1,$ we get $\\frac{\\text{d}y}{\\text{d}x}=2\\operatorname{cos}⁡2x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2y\\operatorname{cot}⁡2x \\\\ 2\\operatorname{cos}⁡2x & \\overset{?}{=}2(\\operatorname{sin}⁡2x+1)\\operatorname{cot}⁡2x \\\\ 2\\operatorname{cos}⁡2x & \\overset{?}{=}2\\operatorname{cos}⁡2x+2\\operatorname{cot}⁡2x \\\\ 0 & =2\\operatorname{cot}⁡2x.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=\\operatorname{sin}⁡2x+1$ is *not* a solution to our differential equation.\n\n- Differentiating $y=-3\\operatorname{sin}⁡2x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=-6\\operatorname{cos}⁡2x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2y\\operatorname{cot}⁡2x \\\\ -6\\operatorname{cos}⁡2x & \\overset{?}{=}2(-3\\operatorname{sin}⁡2x)\\cdot \\operatorname{cot}⁡2x \\\\ -6\\operatorname{cos}⁡2x & =-6\\operatorname{cos}⁡2x.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=-3\\operatorname{sin}⁡2x$ *is* a solution to our differential equation.\n\nTherefore, the correct answer is $y=\\operatorname{sin}⁡2x$; $y=-3\\operatorname{sin}⁡2x$ only."}] [{:db/id #edb/ref 17592186272205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbde5cd7-4a4c-5937-a799-7b21b57c33b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437980} {:answer/id #uuid "db8c300c-0173-5e9e-b3c1-643f3e71fb36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437981}] :answer-field/correct {:answer/id #uuid "db8c300c-0173-5e9e-b3c1-643f3e71fb36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437981} :answer-field/id #uuid "ed6b1190-4430-5c26-820c-6d5d6fae3d79" :answer-field/key "$y=\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439019} {:answer-field/choices [{:answer/id #uuid "eaaedefb-b6d0-54a6-a654-e0dd3e7a6751" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437982} {:answer/id #uuid "7b3e78e1-78cd-5462-9d85-a307e70a00d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437983}] :answer-field/correct {:answer/id #uuid "7b3e78e1-78cd-5462-9d85-a307e70a00d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437983} :answer-field/id #uuid "b282c918-c5d5-512d-9072-bda4c5f527ab" :answer-field/key "$y=3\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439020} {:answer-field/choices [{:answer/id #uuid "799580fd-342b-5be6-99a0-dd688980c5e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437984} {:answer/id #uuid "3e846cbd-10b7-538f-889d-dfae8cd2b98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437985}] :answer-field/correct {:answer/id #uuid "3e846cbd-10b7-538f-889d-dfae8cd2b98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437985} :answer-field/id #uuid "178b5312-5ff7-5d13-a367-0d4394cd147d" :answer-field/key "$y=-2\\operatorname{cos}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439021}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6e3bd06-ef25-5819-bfee-624e8862d278" :question/math-academy-id "q-141092" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-y\\operatorname{tan}⁡x.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=\\operatorname{cos}⁡x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=-\\operatorname{sin}⁡x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-y\\operatorname{tan}⁡x \\\\ -\\operatorname{sin}⁡x & \\overset{?}{=}-\\operatorname{cos}⁡x\\cdot \\operatorname{tan}⁡x \\\\ -\\operatorname{sin}⁡x & =-\\operatorname{sin}⁡x.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=\\operatorname{cos}⁡x$ *is* a solution to our differential equation.\n\n- Differentiating $y=3\\operatorname{cos}⁡x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=-3\\operatorname{sin}⁡x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-y\\operatorname{tan}⁡x \\\\ -3\\operatorname{sin}⁡x & \\overset{?}{=}-3\\operatorname{cos}⁡x\\cdot \\operatorname{tan}⁡x \\\\ -3\\operatorname{sin}⁡x & =-3\\operatorname{sin}⁡x.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=3\\operatorname{cos}⁡x$ *is* a solution to our differential equation.\n\n- Differentiating $y=-2\\operatorname{cos}⁡x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=2\\operatorname{sin}⁡x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-y\\operatorname{tan}⁡x \\\\ 2\\operatorname{sin}⁡x & \\overset{?}{=}-(-2\\operatorname{cos}⁡x)\\cdot \\operatorname{tan}⁡x \\\\ 2\\operatorname{sin}⁡x & =2\\operatorname{sin}⁡x.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=-2\\operatorname{cos}⁡x$ *is* a solution to our differential equation.\n\nTherefore, the correct answer is $y=\\operatorname{cos}⁡x$; $y=3\\operatorname{cos}⁡x$; $y=-2\\operatorname{cos}⁡x$."}] [{:db/id #edb/ref 17592186272206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3ad39e-a247-5a6c-ba6f-410a6f727d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437986} {:answer/id #uuid "8375a5f9-1e5b-5e68-a1a2-d4bb22077aa3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437987}] :answer-field/correct {:answer/id #uuid "3c3ad39e-a247-5a6c-ba6f-410a6f727d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437986} :answer-field/id #uuid "3d0a85f4-6b7a-5206-8912-5ef75d07d5c7" :answer-field/key "$y=\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439022} {:answer-field/choices [{:answer/id #uuid "810eaa21-f1bd-5e35-9c60-fc5b515f7263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437988} {:answer/id #uuid "15681334-eb31-5858-ab81-367c516d43bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437989}] :answer-field/correct {:answer/id #uuid "15681334-eb31-5858-ab81-367c516d43bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437989} :answer-field/id #uuid "b7e12c95-c280-5407-b364-8a9b3e68d6ba" :answer-field/key "$y=2\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439023} {:answer-field/choices [{:answer/id #uuid "13e897d7-5a49-5a79-afb7-d23418de5981" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437990} {:answer/id #uuid "ea53d260-6324-5283-bfa1-49a75c62e26b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437991}] :answer-field/correct {:answer/id #uuid "13e897d7-5a49-5a79-afb7-d23418de5981" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437990} :answer-field/id #uuid "009959a9-26dc-55b5-b0de-6355e0fb41ca" :answer-field/key "$y=-\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439024}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c4f3444-d6eb-515b-bbe6-1939e7e4a2dd" :question/math-academy-id "q-141093" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{{e}^{y/2}}.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{{e}^{y/2}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{2}{{e}^{(\\operatorname{ln}⁡x)/2}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{x}}} \\\\ \\frac{1}{x} & =\\frac{2}{\\sqrt{x}} \\\\ 1 & =2\\sqrt{x}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=\\operatorname{ln}⁡x$ is *not* a solution to our differential equation.\n\n- Differentiating $y=2\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{{e}^{y/2}} \\\\ \\frac{2}{x} & \\overset{?}{=}\\frac{2}{{e}^{(2\\operatorname{ln}⁡x)/2}} \\\\ \\frac{2}{x} & \\overset{?}{=}\\frac{2}{{e}^{\\operatorname{ln}⁡x}} \\\\ \\frac{2}{x} & =\\frac{2}{x}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true.* Therefore, the function $y=2\\operatorname{ln}⁡x$ *is* a solution to our differential equation.\n\n- Differentiating $y=-\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{{e}^{y/2}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{2}{{e}^{(-\\operatorname{ln}⁡x)/2}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{2}{{e}^{\\operatorname{ln}⁡({x}^{-1/2})}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{2}{{x}^{-1/2}} \\\\ -\\frac{1}{x} & =2\\sqrt{x} \\\\ -1 & =2x\\sqrt{x}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-\\operatorname{ln}⁡x$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is $y=2\\operatorname{ln}⁡x$ only."}] [{:db/id #edb/ref 17592186272207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae46f16b-4a3a-5162-a76c-6350bbe8cf5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437998} {:answer/id #uuid "58700634-f044-5904-a864-1876384d88f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437999}] :answer-field/correct {:answer/id #uuid "ae46f16b-4a3a-5162-a76c-6350bbe8cf5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437998} :answer-field/id #uuid "6b224f9d-3166-5fdb-baba-fa61f05f4f1b" :answer-field/key "$y=4x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439028} {:answer-field/choices [{:answer/id #uuid "ce64757c-e188-5d41-b4db-34bc0bbbcf38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438000} {:answer/id #uuid "cf78f6f1-2657-554f-8a9c-1247c354a4b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438001}] :answer-field/correct {:answer/id #uuid "ce64757c-e188-5d41-b4db-34bc0bbbcf38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438000} :answer-field/id #uuid "f8d71f85-f59a-5cf7-b850-1dadf02668b3" :answer-field/key "$y=2{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439029} {:answer-field/choices [{:answer/id #uuid "be0e6097-b578-52d5-9150-71d77d18a246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438002} {:answer/id #uuid "e02a6066-d8bf-5b4d-9ef9-11f939e2bf38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438003}] :answer-field/correct {:answer/id #uuid "be0e6097-b578-52d5-9150-71d77d18a246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438002} :answer-field/id #uuid "3fa08ec6-f0a6-5680-8d5b-d98b9ec07792" :answer-field/key "$y={x}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439030} {:answer-field/choices [{:answer/id #uuid "12661e14-1f98-53c7-88b3-35c686f2a89f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668395} {:answer/id #uuid "0998a8ef-9461-57eb-a720-e38fcfbe946f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668396}] :answer-field/correct {:answer/id #uuid "0998a8ef-9461-57eb-a720-e38fcfbe946f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668396} :answer-field/id #uuid "658ecfe7-ba99-5782-9d99-b74eeb373046" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668775}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbaad5c7-c732-5938-9213-ace2aa1f23df" :question/math-academy-id "q-141098" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{4y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=4x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=4.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4y}{x} \\\\ 4 & \\overset{?}{=}\\frac{4(4x)}{x} \\\\ 4 & \\ne 16.\\,\\times \\end{aligned}\n$$\n\nThis statement is *false*. Therefore, the function $y=4x$ is *not* a solution to our differential equation.\n\n- Differentiating $y=2{x}^{2},$ we get $\\frac{\\text{d}y}{\\text{d}x}=4x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4y}{x} \\\\ 4x & \\overset{?}{=}\\frac{4(2{x}^{2})}{x} \\\\ 4x & \\overset{?}{=}8x \\\\ -4x & \\ne 0.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=2{x}^{2}$ is *not* a solution to our differential equation.\n\n- Differentiating $y={x}^{3},$ we get $\\frac{\\text{d}y}{\\text{d}x}=3{x}^{2}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4y}{x} \\\\ 3{x}^{2} & \\overset{?}{=}\\frac{4({x}^{3})}{x} \\\\ 3{x}^{2} & \\ne 4{x}^{2} \\\\ 0 & \\ne {x}^{2}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={x}^{3}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186272208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282c0558-4ce8-5a0b-9ecb-c71054b4d633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438004} {:answer/id #uuid "e16713e8-3c99-5127-b858-09f6a836bf7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438005}] :answer-field/correct {:answer/id #uuid "282c0558-4ce8-5a0b-9ecb-c71054b4d633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438004} :answer-field/id #uuid "66cce0c8-4d30-5e9d-9a30-1ffdbfa68830" :answer-field/key "$y=-\\frac{1}{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439031} {:answer-field/choices [{:answer/id #uuid "0ecffcc8-53d2-55a3-902f-3663dafe2076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438006} {:answer/id #uuid "3ecb31ee-bc9e-50df-bac9-69db3dc932bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438007}] :answer-field/correct {:answer/id #uuid "3ecb31ee-bc9e-50df-bac9-69db3dc932bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438007} :answer-field/id #uuid "272b3862-8779-5572-983f-8c22da89800f" :answer-field/key "$y=-\\frac{1}{{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439032} {:answer-field/choices [{:answer/id #uuid "d0b1a108-8e14-51d7-8324-6b5a5d23d1af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438008} {:answer/id #uuid "8c2c0aaa-91fa-53d3-af26-2a7cada1ff1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438009}] :answer-field/correct {:answer/id #uuid "8c2c0aaa-91fa-53d3-af26-2a7cada1ff1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438009} :answer-field/id #uuid "92920a70-1e81-5dc7-b31f-286893c6762f" :answer-field/key "$y=\\frac{4}{{x}^{2}}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b4e4e14-2aab-5c49-ba69-c1255e3d6145" :question/math-academy-id "q-141099" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{2y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=-\\frac{1}{x},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{x}^{2}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2y}{x} \\\\ \\frac{1}{{x}^{2}} & \\overset{?}{=}-\\frac{2\\left(-\\frac{1}{x}\\right)}{x} \\\\ \\frac{1}{{x}^{2}} & \\overset{?}{=}\\frac{2}{{x}^{2}} \\\\ 0 & \\ne \\frac{1}{{x}^{2}}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-\\frac{1}{x}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=-\\frac{1}{{x}^{2}},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{{x}^{3}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2y}{x} \\\\ \\frac{2}{{x}^{3}} & \\overset{?}{=}-\\frac{2\\left(-\\frac{1}{{x}^{2}}\\right)}{x} \\\\ \\frac{2}{{x}^{3}} & =\\frac{2}{{x}^{3}}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true.* Therefore, the function $y=-\\frac{1}{{x}^{2}}$ *is* a solution to our differential equation.\n\n- Differentiating $y=\\frac{4}{{x}^{2}},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{8}{{x}^{3}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2y}{x} \\\\ -\\frac{8}{{x}^{3}} & \\overset{?}{=}-\\frac{2\\left(\\frac{4}{{x}^{2}}\\right)}{x} \\\\ -\\frac{8}{{x}^{3}} & =-\\frac{8}{{x}^{3}}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true.* Therefore, the function $y=\\frac{4}{{x}^{2}}$ *is* a solution to our differential equation.\n\nTherefore, the correct answer is $y=-\\frac{1}{{x}^{2}}$; $y=\\frac{4}{{x}^{2}}$ only."}] [{:db/id #edb/ref 17592186272209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e628123d-1857-59cf-99c8-dbfd81aafe1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438010} {:answer/id #uuid "344cc356-0f50-5320-b862-9a02d76becb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438011}] :answer-field/correct {:answer/id #uuid "344cc356-0f50-5320-b862-9a02d76becb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438011} :answer-field/id #uuid "1564794d-6e53-5ee1-997b-519c929759c0" :answer-field/key "$y={x}^{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439034} {:answer-field/choices [{:answer/id #uuid "bc4e1b4b-a13b-5770-acd6-294469c6028f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438012} {:answer/id #uuid "77177cda-2e58-507e-9d06-ce458fb9caf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438013}] :answer-field/correct {:answer/id #uuid "bc4e1b4b-a13b-5770-acd6-294469c6028f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438012} :answer-field/id #uuid "23bab858-62bf-5d21-a329-04f6739fb0c9" :answer-field/key "$y={x}^{10}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439035} {:answer-field/choices [{:answer/id #uuid "aa0067b5-7621-5c0c-8653-7f4fab1a1f56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438014} {:answer/id #uuid "8a7a4f50-4994-5270-b630-a3af98b9e734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438015}] :answer-field/correct {:answer/id #uuid "aa0067b5-7621-5c0c-8653-7f4fab1a1f56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438014} :answer-field/id #uuid "92607fb9-865c-5419-afe4-0e52eddfcb38" :answer-field/key "$y=5{x}^{4}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439036} {:answer-field/choices [{:answer/id #uuid "b34f18fe-b701-5b0c-8094-0d0fb867ae68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668397} {:answer/id #uuid "71c0bb77-461f-538e-978c-a1419b21d48c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668398}] :answer-field/correct {:answer/id #uuid "b34f18fe-b701-5b0c-8094-0d0fb867ae68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668397} :answer-field/id #uuid "8cdd0a5a-01d2-55cf-b29e-505ac15537cb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1646b369-92a0-554a-b444-f79313d419b8" :question/math-academy-id "q-141101" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{5y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y={x}^{5},$ we get $\\frac{\\text{d}y}{\\text{d}x}=5{x}^{4}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 5{x}^{4} & \\overset{?}{=}\\frac{5({x}^{5})}{x} \\\\ 5{x}^{4} & =5{x}^{4}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y={x}^{5}$ *is* a solution to our differential equation.\n\n- Differentiating $y={x}^{10},$ we get $\\frac{\\text{d}y}{\\text{d}x}=10{x}^{9}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 10{x}^{9} & \\overset{?}{=}\\frac{5({x}^{10})}{x} \\\\ 10{x}^{9} & \\overset{?}{=}5{x}^{9} \\\\ 5{x}^{9} & \\ne 0.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={x}^{10}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=5{x}^{4},$ we get $\\frac{\\text{d}y}{\\text{d}x}=20{x}^{3}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 20{x}^{3} & \\overset{?}{=}\\frac{5(5{x}^{4})}{x} \\\\ 20{x}^{3} & \\overset{?}{=}25{x}^{3} \\\\ 0 & \\ne 5{x}^{3}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=5{x}^{4}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is $y={x}^{5}$ only."}] [{:db/id #edb/ref 17592186272210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdfdbbc9-8f7d-5b92-8c7a-21414891f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438016} {:answer/id #uuid "f743e73c-1c1c-57a4-b868-2061d59c13d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438017}] :answer-field/correct {:answer/id #uuid "cdfdbbc9-8f7d-5b92-8c7a-21414891f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438016} :answer-field/id #uuid "24dc77ad-6b0f-53af-88f4-af540b972387" :answer-field/key "$y=\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439037} {:answer-field/choices [{:answer/id #uuid "eed5f60f-41ca-59be-9206-62cf3368db12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438018} {:answer/id #uuid "211fe2a1-b60d-589d-aa08-14fd0a1d5134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438019}] :answer-field/correct {:answer/id #uuid "eed5f60f-41ca-59be-9206-62cf3368db12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438018} :answer-field/id #uuid "ff89b593-0f13-5e74-b5fd-46b080b4539e" :answer-field/key "$y=-\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439038} {:answer-field/choices [{:answer/id #uuid "08076568-a59d-5e86-b097-716389e2ca49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438020} {:answer/id #uuid "38a8f5c4-ee71-5b43-b766-82516de6631a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438021}] :answer-field/correct {:answer/id #uuid "08076568-a59d-5e86-b097-716389e2ca49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438020} :answer-field/id #uuid "bc38cc1b-44bf-5b80-afd0-c4f4a940e99f" :answer-field/key "$y=-2\\operatorname{ln}⁡x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439039} {:answer-field/choices [{:answer/id #uuid "4fa072f3-f6bd-536a-8c77-4cc11f5b800a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668399} {:answer/id #uuid "3ed2a3ed-4314-5381-95a5-afa0cb5c121a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668400}] :answer-field/correct {:answer/id #uuid "3ed2a3ed-4314-5381-95a5-afa0cb5c121a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668400} :answer-field/id #uuid "537cefa5-fa01-5b63-9eb1-840a4e6f4deb" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668777}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d8ec718b-9c17-5ad2-8af8-895d469a7090" :question/math-academy-id "q-141103" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{e}^{3y}}.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{e}^{3y}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{3\\operatorname{ln}⁡x}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{\\operatorname{ln}⁡({x}^{3})}} \\\\ \\frac{1}{x} & =\\frac{1}{{x}^{3}} \\\\ {x}^{2} & =1.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=\\operatorname{ln}⁡x$ is *not* a solution to our differential equation.\n\n- Differentiating $y=-\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{e}^{3y}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{3(-\\operatorname{ln}⁡x)}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{-3\\operatorname{ln}⁡x}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{\\operatorname{ln}⁡({x}^{-3})}} \\\\ -\\frac{1}{x} & \\overset{?}{=}\\frac{1}{{x}^{-3}} \\\\ -\\frac{1}{x} & ={x}^{3} \\\\ -1 & ={x}^{4}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-\\operatorname{ln}⁡x$ is *not* a solution to our differential equation.\n\n- Differentiating $y=-2\\operatorname{ln}⁡x,$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{2}{x}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{e}^{3y}} \\\\ -\\frac{2}{x} & \\overset{?}{=}\\frac{1}{{e}^{3(-2\\operatorname{ln}⁡x)}} \\\\ -\\frac{2}{x} & \\overset{?}{=}\\frac{1}{{e}^{-6\\operatorname{ln}⁡x}} \\\\ -\\frac{2}{x} & \\overset{?}{=}\\frac{1}{{e}^{\\operatorname{ln}⁡({x}^{-6})}} \\\\ -\\frac{2}{x} & \\overset{?}{=}\\frac{1}{{x}^{-6}} \\\\ -\\frac{2}{x} & ={x}^{6} \\\\ -2 & ={x}^{7}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-2\\operatorname{ln}⁡x$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186272211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "058d33c3-38bc-5a8a-b193-b57183edaeaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186269316} {:answer/id #uuid "20ca9768-8408-5d47-83d3-3cdeac15ea6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269546} {:answer/id #uuid "3e9b3f54-9ab3-5a07-8550-6d3a6dd62a49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269842} {:answer/id #uuid "4db64a33-bfca-52ca-81d7-4627db1c20b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269972} {:answer/id #uuid "ddb92157-9cb4-5dee-a5ff-fc87722216d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186271216}] :answer-field/correct {:answer/id #uuid "ddb92157-9cb4-5dee-a5ff-fc87722216d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186271216} :answer-field/id #uuid "8d9cca69-c36e-5a39-a987-76b027db5270" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271760}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e6c8b47-d479-53b1-8c84-47f5f3c59cd6" :question/math-academy-id "q-141107" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{4y}{x},\\,y(-1)=-1.\n$$\n\nYou're given that $y=A{x}^{4}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{x}^{4}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=-1.$\n\nSubstituting the initial condition $y(-1)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{x}^{4} \\\\ -1 & =A(-1)^{4} \\\\ -1 & =A(1) \\\\ A & =-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=(-1){x}^{4}=-{x}^{4}.\n$$"}] [{:db/id #edb/ref 17592186272212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d86cd0-b610-5949-970a-9cadba494d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269856} {:answer/id #uuid "59db9bef-eba4-5426-bced-b24333ab4c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270070} {:answer/id #uuid "9aee7aa9-6233-54c2-97d7-0f70259781ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270636} {:answer/id #uuid "aa5496f6-fdf1-5cc6-a7ce-dbb55d245952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186270789} {:answer/id #uuid "c681c4dd-1f9e-524b-b441-d45c91ba1047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271017}] :answer-field/correct {:answer/id #uuid "c681c4dd-1f9e-524b-b441-d45c91ba1047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271017} :answer-field/id #uuid "7ce1772f-fae9-51d4-86d3-256af231e875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271730}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcfaf845-ee85-5f89-a0ff-887be1bdd8e1" :question/math-academy-id "q-141108" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-y,\\,y(0)=1.\n$$\n\nYou're given that $y=A{e}^{-x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{e}^{-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=1.$\n\nSubstituting the initial condition $y(0)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-x} \\\\ 1 & =A{e}^{-0} \\\\ 1 & =A(1) \\\\ A & =1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=1{e}^{-x}={e}^{-x}.\n$$"}] [{:db/id #edb/ref 17592186272213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27af5735-67e6-5745-837d-f3e8373eb100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269619} {:answer/id #uuid "53ea0659-8633-53a6-87c4-5c537b0142b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270015} {:answer/id #uuid "7c9208d8-0f0e-59f5-a04d-7932257e844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186270360} {:answer/id #uuid "cc899638-4da6-51c0-9a41-5610db689c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271063} {:answer/id #uuid "ce25066e-6373-56e0-8a1e-475a79635a3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186271079}] :answer-field/correct {:answer/id #uuid "53ea0659-8633-53a6-87c4-5c537b0142b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270015} :answer-field/id #uuid "41bf4f85-758e-5da1-abd2-08e5e4cc3f16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271631}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fca85355-bf58-5075-99c6-c35790d44507" :question/math-academy-id "q-141109" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y,\\,y(0)=2.\n$$\n\nYou're given that $y=A{e}^{-2x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{e}^{-2x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=2.$\n\nSubstituting the initial condition $y(0)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-2x} \\\\ 2 & =A{e}^{-2(0)} \\\\ 2 & =A{e}^{0} \\\\ 2 & =A(1) \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2{e}^{-2x}.\n$$"}] [{:db/id #edb/ref 17592186272214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637a72ce-0d98-52b9-bd74-7454769e1306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270150} {:answer/id #uuid "639d7aa9-6e9c-56a5-93f9-c52aa4f843af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270151} {:answer/id #uuid "65c55cd3-8c13-52a3-a22c-496d7ed37306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186270176} {:answer/id #uuid "76ca705e-0bfb-57d2-b037-21e60eec8ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270317} {:answer/id #uuid "952621dd-e2c2-5a13-b19f-0690051a27fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270575}] :answer-field/correct {:answer/id #uuid "952621dd-e2c2-5a13-b19f-0690051a27fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270575} :answer-field/id #uuid "499365bc-c9cb-5bfb-b557-42f54e59d06b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271642}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42cc7718-b801-5574-add3-311d9f7972bc" :question/math-academy-id "q-141111" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y\\operatorname{tan}⁡2x,\\,y\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}.\n$$\n\nYou're given that $y=A\\operatorname{cos}⁡2x$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A\\operatorname{cos}⁡2x$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}.$\n\nSubstituting the initial condition $y\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{cos}⁡2x \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8}) \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\ \\sqrt{2} & =A\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2\\operatorname{cos}⁡2x.\n$$"}] [{:db/id #edb/ref 17592186272215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba2e4d0-14d3-5e3f-a154-f23244402132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269372} {:answer/id #uuid "2eae9f08-f9ab-5840-be4a-f20ee77083b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186269689} {:answer/id #uuid "72af3f51-6c6e-5bd3-b3d5-192c13e81d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270282} {:answer/id #uuid "d2a550bb-d2ce-54f1-bcd0-9c271a541331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186271124} {:answer/id #uuid "f528aba0-decc-5d96-86c5-93d306efde35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271418}] :answer-field/correct {:answer/id #uuid "2eae9f08-f9ab-5840-be4a-f20ee77083b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186269689} :answer-field/id #uuid "59599c50-b345-5a48-9462-d538ac1bac80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271671}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9915548e-f09c-5476-a595-046194f74c54" :question/math-academy-id "q-141114" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{x},\\,y(-1)=3.\n$$\n\nYou're given that $y=Ax$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=Ax$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=3.$\n\nSubstituting the initial condition $y(-1)=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =Ax \\\\ 3 & =A(-1) \\\\ 3 & =-A \\\\ A & =-3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-3x.\n$$"}] [{:db/id #edb/ref 17592186319202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57db562f-825a-5c06-9c18-a4185051c072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317861}] :answer-field/correct {:answer/id #uuid "57db562f-825a-5c06-9c18-a4185051c072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317861} :answer-field/id #uuid "5672edce-69fb-5725-aa5f-85f880ba3571" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318610}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "95cfa877-83ba-5877-86e4-7c000e0d1f2a" :question/math-academy-id "q-347839" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y\\operatorname{cot}⁡(3x),\\,y\\,\\left(\\frac{\\pi }{6}\\right)=1.\n$$\n\nYou are given that $y=A\\operatorname{sin}⁡(3x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We are given that $y=A\\operatorname{sin}⁡(3x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\,\\left(\\frac{\\pi }{6}\\right)=1.$\n\nSubstituting the initial condition $y\\,\\left(\\frac{\\pi }{6}\\right)=1$ into the solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{sin}⁡(3x) \\\\ 1 & =Asin\\,(3\\cdot \\frac{\\pi }{6}) \\\\ 1 & =Asin\\,\\left(\\frac{\\pi }{2}\\right) \\\\ 1 & =A(1) \\\\ A & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c73f686-0fde-551d-8a04-19d55648ae19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319861}] :answer-field/correct {:answer/id #uuid "9c73f686-0fde-551d-8a04-19d55648ae19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319861} :answer-field/id #uuid "1853bdf6-795c-54d2-8aca-6ddb48b65a90" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320219}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c813122-41f5-5f7d-ad1c-44bd6d1ad9e7" :question/math-academy-id "q-352649" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y\\operatorname{tan}⁡(2x),\\,y\\,\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}.\n$$\n\nYou are given that $y=A\\operatorname{cos}⁡(2x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We are given that $y=A\\operatorname{cos}⁡(2x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\,\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}.$\n\nSubstituting the initial condition $y\\,\\left(\\frac{\\pi }{8}\\right)=\\sqrt{2}$ into the solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{cos}⁡(2x) \\\\ \\sqrt{2} & =Acos\\,(2\\cdot \\frac{\\pi }{8}) \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\ \\sqrt{2} & =A\\cdot \\frac{\\sqrt{2}}{2} \\\\ A & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24dfcc68-5dea-50bf-b7a8-8e83148e7990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5/{e}^{6}" :db/id #edb/ref 17592186319505}] :answer-field/correct {:answer/id #uuid "24dfcc68-5dea-50bf-b7a8-8e83148e7990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5/{e}^{6}" :db/id #edb/ref 17592186319505} :answer-field/id #uuid "d41db8f8-1e2b-52a4-95d9-3d2f841c0f19" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320601}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33e8fcf6-acf7-5f2b-b8b8-b3631e5ba43c" :question/math-academy-id "q-352654" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y(2)=5.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=5.$\n\nSubstituting the initial condition $y(2)=5$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ 5 & =A{e}^{3\\cdot 2} \\\\ 5 & =A{e}^{6} \\\\ \\frac{5}{{e}^{6}} & =A \\\\ A & =\\frac{5}{{e}^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f58e9f-d185-562c-9c67-7e75f87623d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4}" :db/id #edb/ref 17592186319560}] :answer-field/correct {:answer/id #uuid "36f58e9f-d185-562c-9c67-7e75f87623d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4}" :db/id #edb/ref 17592186319560} :answer-field/id #uuid "6a793135-2916-5a04-8d25-0d156d312364" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320388}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a255cc3f-5f22-5919-beaf-e4725720aff5" :question/math-academy-id "q-352655" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(1)=2.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=2.$\n\nSubstituting the initial condition $y(1)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ 2 & =A{e}^{-4\\cdot 1} \\\\ 2 & =A{e}^{-4} \\\\ 2{e}^{4} & =A \\\\ A & =2{e}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f8e7e8f-73cf-53bb-83a4-6766a894f35d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186319822}] :answer-field/correct {:answer/id #uuid "8f8e7e8f-73cf-53bb-83a4-6766a894f35d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186319822} :answer-field/id #uuid "66f2860e-a104-57a8-b392-d8993df50cb7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320376}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50e3aacc-64ad-599b-9fdb-eea729801f82" :question/math-academy-id "q-352656" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y,\\,y(-1)=4.\n$$\n\nYou're given that $y=A{e}^{x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=4.$\n\nSubstituting the initial condition $y(-1)=4$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{x} \\\\ 4 & =A{e}^{-1} \\\\ 4 & =A{e}^{-1} \\\\ 4e & =A \\\\ A & =4e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8acbb56-9fb6-58fa-a74e-030faab46fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320132}] :answer-field/correct {:answer/id #uuid "f8acbb56-9fb6-58fa-a74e-030faab46fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320132} :answer-field/id #uuid "c34d4846-12a9-583c-9e1f-8c59dd074ddb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320567}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f863bf4-17d0-5519-90b1-53b7529243b1" :question/math-academy-id "q-352660" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{4y}{x},\\,y(2)=\\frac{3}{4}.\n$$\n\nYou're given that $y=\\frac{A}{{x}^{4}}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{A}{{x}^{4}}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=\\frac{3}{4}.$\n\nSubstituting the initial condition $y(2)=\\frac{3}{4}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{{x}^{4}} \\\\ \\frac{3}{4} & =\\frac{A}{{2}^{4}} \\\\ \\frac{3}{4} & =\\frac{A}{16} \\\\ A & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc24bb63-d5ea-5647-8e74-82ebea88b815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186320150}] :answer-field/correct {:answer/id #uuid "fc24bb63-d5ea-5647-8e74-82ebea88b815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186320150} :answer-field/id #uuid "bbae27ae-1c5d-5215-9548-779ff9205ad0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320549}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "baa48ee7-6d45-5298-b9b3-7a1a62413c86" :question/math-academy-id "q-352661" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2},\\,y(0)=3.\n$$\n\nYou're given that $y=\\frac{1}{A-x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{1}{A-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=3.$\n\nSubstituting the initial condition $y(0)=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A-x} \\\\ 3 & =\\frac{1}{A-0} \\\\ 3 & =\\frac{1}{A} \\\\ A & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "303cc3dd-ed53-5fc3-801d-bfcb237bc936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1/2" :db/id #edb/ref 17592186319544}] :answer-field/correct {:answer/id #uuid "303cc3dd-ed53-5fc3-801d-bfcb237bc936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1/2" :db/id #edb/ref 17592186319544} :answer-field/id #uuid "f83209fb-2c55-58c7-b40d-019c31ec1356" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320690}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44f980f1-e507-5172-bd9f-13aac1021e42" :question/math-academy-id "q-352663" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3y}{x},\\,y(2)=4.\n$$\n\nYou're given that $y=A{x}^{3}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{x}^{3}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=4.$\n\nSubstituting the initial condition $y(2)=4$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{x}^{3} \\\\ 4 & =A(2)^{3} \\\\ 4 & =A(8) \\\\ A & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "905e51f9-40b0-5499-8af5-872dc35779be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438568} {:answer/id #uuid "70569d18-b405-5c62-a953-d3cd6b0b4af1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438569}] :answer-field/correct {:answer/id #uuid "905e51f9-40b0-5499-8af5-872dc35779be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438568} :answer-field/id #uuid "e56acec3-06c5-5f56-bd10-ea20f7c101e9" :answer-field/key "$y={e}^{-4x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439313} {:answer-field/choices [{:answer/id #uuid "27cb07db-d269-5128-aef0-058e9346c8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438570} {:answer/id #uuid "e8b0d574-6237-55e7-8ae6-4df3f29efc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438571}] :answer-field/correct {:answer/id #uuid "e8b0d574-6237-55e7-8ae6-4df3f29efc4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438571} :answer-field/id #uuid "6b78d205-6f1a-546b-a4c3-a766d737c1e0" :answer-field/key "$y={e}^{4x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439314} {:answer-field/choices [{:answer/id #uuid "ab214efc-6a3b-5507-98c5-f553f6d6c683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438572} {:answer/id #uuid "12509a84-7b4f-519d-a728-f34ffb63a683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438573}] :answer-field/correct {:answer/id #uuid "ab214efc-6a3b-5507-98c5-f553f6d6c683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438572} :answer-field/id #uuid "b6078f73-1ba1-5ea4-b78b-ee1956184333" :answer-field/key "$y=4{e}^{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439315}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "33546fc8-b13b-5d05-a639-8809e08f2462" :question/math-academy-id "q-79330" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4y.\n$$\n\n Which of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y={e}^{-4x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{-4x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =4y \\\\ -4{e}^{-4x} & \\overset{?}{=}4{e}^{-4x} \\\\ 0 & \\ne 8{e}^{-4x}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={e}^{-4x}$ is *not* a solution to our differential equation.\n\n- Differentiating $y={e}^{4x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=4{e}^{4x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =4y \\\\ 4{e}^{4x} & =4{e}^{4x}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y={e}^{4x}$ *is* a solution to our differential equation.\n\n- Differentiating $y=4{e}^{x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=4{e}^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =4y \\\\ 4{e}^{x} & \\overset{?}{=}4(4{e}^{x}) \\\\ 4{e}^{x} & \\overset{?}{=}16{e}^{x} \\\\ 0 & \\ne 12{e}^{x}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=4{e}^{x}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is $y={e}^{4x}$ only."}] [{:db/id #edb/ref 17592186348207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19979361-a8df-557d-82d0-af8fd1cd5d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438574} {:answer/id #uuid "c1c92711-50d6-5a72-8bfe-847ca17732fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438575}] :answer-field/correct {:answer/id #uuid "c1c92711-50d6-5a72-8bfe-847ca17732fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438575} :answer-field/id #uuid "1ef534af-2098-561e-b179-3f55b5991272" :answer-field/key "$y=\\frac{7}{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439316} {:answer-field/choices [{:answer/id #uuid "04c1b3ff-9199-58c6-8074-ef77f3973076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438576} {:answer/id #uuid "81f1c637-5060-5374-898f-afcdf1cec8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438577}] :answer-field/correct {:answer/id #uuid "81f1c637-5060-5374-898f-afcdf1cec8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438577} :answer-field/id #uuid "ac7782cf-bc1c-5aca-a517-f8894341953d" :answer-field/key "$y=-\\frac{1}{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439317} {:answer-field/choices [{:answer/id #uuid "9c7481b3-4b8f-5e17-a81a-78de2657429f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438578} {:answer/id #uuid "b09ebf27-8594-5384-8496-cf3a363bb462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438579}] :answer-field/correct {:answer/id #uuid "b09ebf27-8594-5384-8496-cf3a363bb462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438579} :answer-field/id #uuid "4b6785e8-bf84-599d-a8f6-c5925f0b9071" :answer-field/key "$y=\\frac{2}{x}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439318}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2809b1ba-af02-5b95-b4d7-d9885f873cd9" :question/math-academy-id "q-79333" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,x\\ne 0.\n$$\n\nWhich of the following is a solution to this equation?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=\\frac{7}{x},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{7}{{x}^{2}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{y}{x} \\\\ -\\frac{7}{{x}^{2}} & \\overset{?}{=}-\\frac{\\left(\\frac{7}{x}\\right)}{x} \\\\ -\\frac{7}{{x}^{2}} & =-\\frac{7}{{x}^{2}}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=\\frac{7}{x}$ *is* a solution to our differential equation.\n\n- Differentiating $y=-\\frac{1}{x},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{x}^{2}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{y}{x} \\\\ \\frac{1}{{x}^{2}} & \\overset{?}{=}-\\frac{\\left(-\\frac{1}{x}\\right)}{x} \\\\ \\frac{1}{{x}^{2}} & =\\frac{1}{{x}^{2}}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=-\\frac{1}{x}$ *is* a solution to our differential equation.\n\n- Differentiating $y=\\frac{2}{x},$ we get $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=-\\frac{2}{{x}^{2}}.\n$$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{y}{x} \\\\ -\\frac{2}{{x}^{2}} & \\overset{?}{=}-\\frac{\\left(\\frac{2}{x}\\right)}{x} \\\\ -\\frac{2}{{x}^{2}} & =-\\frac{2}{{x}^{2}}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=\\frac{2}{x}$ *is* a solution to our differential equation.\n\nTherefore, the correct answer is $y=\\frac{7}{x}$; $y=-\\frac{1}{x}$; $y=\\frac{2}{x}$."}] [{:db/id #edb/ref 17592186373785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b15d99-5f73-5d71-a0a0-49f9be9df65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186373787} {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} {:answer/id #uuid "243ba24f-c088-5741-b1dc-797cc0c88bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373789} {:answer/id #uuid "3ab4b002-dd36-598f-8102-522b7e368735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186373790} {:answer/id #uuid "4a73df82-8e85-5bb1-90fc-89e5be58e836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186373791}] :answer-field/correct {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} :answer-field/id #uuid "e02b7c91-76ce-53ed-b342-163951d05f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373786}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8abc10be-3eb5-5e2c-9a94-244a431b287a" :question/math-academy-id "q-141112" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,y(-2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=-1.$\n\nSubstituting the initial condition $y(-2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{x} \\\\ -1 & =\\frac{A}{(-2)} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{2}{x}.\n$$"}] [{:db/id #edb/ref 17592186398445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024ac53a-9f0a-5a7a-98f8-c50bcc20b4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398447} {:answer/id #uuid "6125d774-7a34-522e-a338-4e504b088a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398448} {:answer/id #uuid "5be53b7e-12b8-56ea-82fa-df826cb81389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186398449} {:answer/id #uuid "43ee5f6e-6b96-5920-96dd-6bda4e98e633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398450} {:answer/id #uuid "6ffa9645-4799-55ea-b858-499c63ccbd0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186398451}] :answer-field/correct {:answer/id #uuid "5be53b7e-12b8-56ea-82fa-df826cb81389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186398449} :answer-field/id #uuid "cdc013cf-89dd-52e2-93ec-1bd8584646b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398446}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e0065e9-3a69-5f85-ad17-2869bffc442f" :question/math-academy-id "q-141113" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{2y}{x},\\,y(2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{{x}^{2}}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{{x}^{2}}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=-1.$\n\nSubstituting the initial condition $y(2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{{x}^{2}} \\\\ -1 & =\\frac{A}{{2}^{2}} \\\\ -1 & =\\frac{A}{4} \\\\ A & =-4.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\frac{4}{{x}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186398452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89027aec-d449-5dca-8830-9b39f9c5fbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186398454} {:answer/id #uuid "d1591666-636c-5480-9f22-08f9eeec3613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186398455} {:answer/id #uuid "b092bcb2-de91-5a2a-9a1c-b1cf1cdf0b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398456} {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} {:answer/id #uuid "408ad86d-b3e2-50fe-ba49-d6d10e8b89e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398458}] :answer-field/correct {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} :answer-field/id #uuid "5f0f43ae-19bf-5c26-8ca2-6e01020ad358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398453}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e96414b2-2fe9-598e-bc15-f2c64a7b0633" :question/math-academy-id "q-141115" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$"}] [{:db/id #edb/ref 17592186398459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dcefcd7-21a2-550b-82e1-cdf9e8efcbda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186398461} {:answer/id #uuid "4b4230d9-c571-50ea-9f01-98df054d2c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398462} {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} {:answer/id #uuid "89f9fe65-61ad-531c-91e5-0d74f2e05f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398464} {:answer/id #uuid "86af0317-94e9-53ec-8661-5ce6b18962d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398465}] :answer-field/correct {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} :answer-field/id #uuid "9f0c471e-3bc9-5406-b7a8-dfcd6f763630" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398460}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea6ff592-81a4-59f3-84d6-c97bdc2e3a4f" :question/math-academy-id "q-141116" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{y}^{2},\\,y(0)=\\frac{1}{2}.\n$$\n\nYou're given that $y=\\frac{1}{A+x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{1}{A+x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=\\frac{1}{2}.$\n\nSubstituting the initial condition $y(0)=\\frac{1}{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A+x} \\\\ \\frac{1}{2} & =\\frac{1}{A+0} \\\\ \\frac{1}{2} & =\\frac{1}{A} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{1}{2+x}.\n$$"}] [{:db/id #edb/ref 17592186493343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347} {:answer/id #uuid "5899971b-fb4c-4982-a90e-99923b6cd70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^6" :db/id #edb/ref 17592186577405}] :answer-field/correct {:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347} :answer-field/id #uuid "bfb8d739-6087-5cb0-989a-1441bdf28bf6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493362}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "602e8cc0-02ef-5eee-abee-b6d55a9699a0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4y,\\,y\\left(- \\frac{3}{2}\\right)=-1.\n$$\n\nYou're given that $y=A{e}^{4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\left(- \\frac{3}{2}\\right)=-1.$\n\nSubstituting the initial condition $y\\left(- \\frac{3}{2}\\right)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{4x} \\\\ -1 & =A{e}^{4\\cdot \\left(- \\frac{3}{2}\\right)} \\\\ -1 & =A{e}^{-6} \\\\ \\frac{-1}{{e}^{-6}} & =A \\\\ A & =\\frac{-1}{{e}^{-6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9046425d-7108-5533-ae96-d8fb15f776bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 + e^{-2}" :db/id #edb/ref 17592186493354}] :answer-field/correct {:answer/id #uuid "9046425d-7108-5533-ae96-d8fb15f776bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 + e^{-2}" :db/id #edb/ref 17592186493354} :answer-field/id #uuid "411892ad-13d1-53ad-85e2-b75b7b7bede9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493341}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6119d730-e0d1-5eb1-8fa9-da95fad116e4" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(2)=-2.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=-2.$\n\nSubstituting the initial condition $y(2)=-2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ -2 & =\\ln(A+2) \\\\ {e}^{-2} & ={e}^{\\ln(A+2)} \\\\ e^{-2} & =A+2 \\\\ A & ={e}^{-2}-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31f1b340-a0f9-5632-b4ae-d2cd75bbbc79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 + e" :db/id #edb/ref 17592186493339}] :answer-field/correct {:answer/id #uuid "31f1b340-a0f9-5632-b4ae-d2cd75bbbc79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 + e" :db/id #edb/ref 17592186493339} :answer-field/id #uuid "1eb305ae-46db-5835-ae63-e79c838fcf97" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493338}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "630f3abe-1218-5a27-8968-d6da69e8c899" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(-2)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=1.$\n\nSubstituting the initial condition $y(-2)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ 1 & =\\ln(A+(-2)) \\\\ {e}^{1} & ={e}^{\\ln(A+(-2))} \\\\ e & =A+(-2) \\\\ A & =e+2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f87f97d4-3817-590b-83c6-b9735360b4f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493366}] :answer-field/correct {:answer/id #uuid "f87f97d4-3817-590b-83c6-b9735360b4f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493366} :answer-field/id #uuid "8b6b7bd6-9678-5e5b-b378-6e9db169efb7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493352}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "85c1e723-615b-5f4b-84c8-de92ecc7344c" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2},\\,y(1)=\\frac{1}{4}.\n$$\n\nYou're given that $y=\\frac{1}{A-x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{1}{A-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=\\frac{1}{4}.$\n\nSubstituting the initial condition $y(1)=\\frac{1}{4}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A-x} \\\\ \\frac{1}{4} & =\\frac{1}{A-1} \\\\ \\frac{1}{\\frac{1}{4}} & =A-1 \\\\ A & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345}] :answer-field/correct {:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345} :answer-field/id #uuid "b0151b1c-1e8e-5b0e-a19d-1ee0bcc76c89" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493358}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c629d7f-f88e-5741-a882-820e35768d0a" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y\\left(\\frac{1}{2}\\right)=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\left(\\frac{1}{2}\\right)=\\frac{1}{3}.$\n\nSubstituting the initial condition $y\\left(\\frac{1}{2}\\right)=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ \\frac{1}{3} & =A{e}^{-4\\cdot \\frac{1}{2}} \\\\ \\frac{1}{3} & =A{e}^{-2} \\\\ \\frac{\\frac{1}{3}}{{e}^{-2}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{-2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348} {:answer/id #uuid "a1b6b0df-de04-42ac-aa0d-e31817bf10ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac32}}{3}" :db/id #edb/ref 17592186577403}] :answer-field/correct {:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348} :answer-field/id #uuid "e78f8914-c568-5d01-8afc-57d32ce156cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493363}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a76133ad-ea1c-5ff4-8da8-4b052e2debb0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\qquad y\\left(- \\frac{1}{2}\\right)=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $$\n\\displaystyle y\\left(- \\frac{1}{2}\\right)=\\frac{1}{3}.\n$$\n\nSubstituting the initial condition $y\\left(- \\frac{1}{2}\\right)=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ \\frac{1}{3} & =A{e}^{3\\cdot \\left(- \\frac{1}{2}\\right)} \\\\ \\frac{1}{3} & =A{e}^{- \\frac{3}{2}} \\\\ \\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89893d2b-4533-5a43-930c-9ea6e97ff59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + e^{2}" :db/id #edb/ref 17592186493351}] :answer-field/correct {:answer/id #uuid "89893d2b-4533-5a43-930c-9ea6e97ff59b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + e^{2}" :db/id #edb/ref 17592186493351} :answer-field/id #uuid "b772fdc6-384f-5b49-a09f-cd4b45cbd1a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493360}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ad8d0c2d-b7bc-5b71-86d4-7ff2f62aac86" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=2.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=2.$\n\nSubstituting the initial condition $y(1)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ 2 & =\\ln(A+1) \\\\ {e}^{2} & ={e}^{\\ln(A+1)} \\\\ e^{2} & =A+1 \\\\ A & ={e}^{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae581985-6ca4-599a-9dfd-6547c92707d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + e^{-1}" :db/id #edb/ref 17592186493357}] :answer-field/correct {:answer/id #uuid "ae581985-6ca4-599a-9dfd-6547c92707d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1 + e^{-1}" :db/id #edb/ref 17592186493357} :answer-field/id #uuid "0e0c781a-362c-5b42-a085-b46bfa30fbeb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493337}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b21bbef4-9add-53b4-bc34-6d945d14d134" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=-1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=-1.$\n\nSubstituting the initial condition $y(1)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ -1 & =\\ln(A+1) \\\\ {e}^{-1} & ={e}^{\\ln(A+1)} \\\\ e^{-1} & =A+1 \\\\ A & ={e}^{-1}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361}] :answer-field/correct {:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361} :answer-field/id #uuid "54305a96-48f3-5ac5-87e2-b0b6556ff912" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493342}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eded91b2-b55d-56c3-bb62-6b902c3a464d" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y\\left(\\frac{3}{2}\\right)=1.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\left(\\frac{3}{2}\\right)=1.$\n\nSubstituting the initial condition $y\\left(\\frac{3}{2}\\right)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ 1 & =A{e}^{3\\cdot \\frac{3}{2}} \\\\ 1 & =A{e}^{\\frac{9}{2}} \\\\ \\frac{1}{{e}^{\\frac{9}{2}}} & =A \\\\ A & =\\frac{1}{{e}^{\\frac{9}{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340}] :answer-field/correct {:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340} :answer-field/id #uuid "857b5124-dc03-509b-99e1-e4e90f0a3036" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493349}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef863447-fa5f-590c-8056-4768c8c0285e" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y\\left(\\frac{3}{2}\\right)=3.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\left(\\frac{3}{2}\\right)=3.$\n\nSubstituting the initial condition $y\\left(\\frac{3}{2}\\right)=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ 3 & =A{e}^{-4\\cdot \\frac{3}{2}} \\\\ 3 & =A{e}^{-6} \\\\ \\frac{3}{{e}^{-6}} & =A \\\\ A & =\\frac{3}{{e}^{-6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186494077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0077f4e-bfef-5c44-9c4f-22e790c66054" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494118} {:answer/id #uuid "f470c94f-5751-5b47-a030-8985df3f2d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494120}] :answer-field/correct {:answer/id #uuid "f470c94f-5751-5b47-a030-8985df3f2d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494120} :answer-field/id #uuid "276d5850-899a-5418-b118-58774ff396c5" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494089} {:answer-field/choices [{:answer/id #uuid "a0427735-f1b6-5953-9a58-65ffe3fc0cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494104} {:answer/id #uuid "d93ba829-e163-58c2-b76e-e291c5f8be1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494113}] :answer-field/correct {:answer/id #uuid "d93ba829-e163-58c2-b76e-e291c5f8be1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494113} :answer-field/id #uuid "8bc47d48-c82a-5502-bb58-b7f089ff6b6b" :answer-field/key "${f}^{′}(x)=-5{x}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494102} {:answer-field/choices [{:answer/id #uuid "5c3effa8-82fb-5fb4-8d49-078df0fff8cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494098} {:answer/id #uuid "fbb4386c-3ca1-56b1-a1f1-27eda3db5ebb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494122}] :answer-field/correct {:answer/id #uuid "fbb4386c-3ca1-56b1-a1f1-27eda3db5ebb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494122} :answer-field/id #uuid "b26b8e2c-d5f7-5d56-ac89-1e186c2dea2a" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494107}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "03ad73f2-dfe8-5b7e-bde4-05067dff734f" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{3y}{x},\\,x\\ne 0\n$$\n\nLet $f(x)=-2{x}^{3}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement ${f}^{′}(x)=-5{x}^{2}$ is false. Differentiating $f(x)=-2{x}^{3},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(-2{x}^{3})}^{′} \\\\  & =-2\\cdot 3{x}^{2} \\\\  & =-6{x}^{2} \\\\  & \\ne -5{x}^{2}.\\end{aligned}\n$$\n\n- Statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true. Substituting $y=-2{x}^{3}$ and ${y}^{′}=-6{x}^{2}$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{3y}{x} \\\\ -6{x}^{2} & \\overset{?}{=}\\frac{3(-2{x}^{3})}{x} \\\\ -6{x}^{2} & =-6{x}^{2}\\,✓\\end{aligned}\n$$\n\n- Statement “The function $y=f(x)$ is a solution of the differential equation” is true. Since statement “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement” is true, the function $y=-2{x}^{3}$ is a solution to our differential equation.\n\nTherefore, the correct answer is “Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement”; “The function $y=f(x)$ is a solution of the differential equation” only."}] [{:db/id #edb/ref 17592186494079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4330cfb7-8007-5f4b-b65a-6b8ca9b8b25b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494094} {:answer/id #uuid "8a470ecb-d8a1-5134-bd03-7aa6af28cd48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494101}] :answer-field/correct {:answer/id #uuid "8a470ecb-d8a1-5134-bd03-7aa6af28cd48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494101} :answer-field/id #uuid "0fa5a541-2f14-5a90-830a-7537bc62c9fb" :answer-field/key "Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494083} {:answer-field/choices [{:answer/id #uuid "0b03c25e-572f-53bd-97e2-15a9854478d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186494078} {:answer/id #uuid "0f7c5231-f859-571c-a776-7421b5e237a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494082}] :answer-field/correct {:answer/id #uuid "0f7c5231-f859-571c-a776-7421b5e237a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186494082} :answer-field/id #uuid "fb07b3e8-17e8-5b30-abe1-b3a39619c2f2" :answer-field/key "The function $y=f(x)$ is a solution of the differential equation" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186494121} {:answer-field/choices [{:answer/id #uuid "03474253-5656-59c7-960b-e9aba91c42ea" :answer/