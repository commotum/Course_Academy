rac{\\operatorname{cos}(x - 1)}{\\operatorname{sin}(x - 1)}\\,\\text{d}x \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\int \\frac{1}{t}\\,\\text{d}t \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\ln|t|+C \\\\  & =-2 x\\operatorname{cot}(x - 1)+2\\ln|\\operatorname{sin}(x - 1)|+C\\end{aligned}\n$$\n\nThis holds on each interval where $\\operatorname{sin}(x - 1)\\ne0$."}] [{:db/id #edb/ref 17592186693958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08673960-afae-5ac2-93e2-94842a85adfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+27 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693942} {:answer/id #uuid "53cd5250-3135-5b2e-8211-48fc3f2afcf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+9 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693949} {:answer/id #uuid "b5e858e7-80e9-5dfd-ae50-3c2d1bf12d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+3 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693960} {:answer/id #uuid "dbaf7982-e857-5ec0-ab03-67c241df3a4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 x \\operatorname{tan}{(x - 3 )}+9 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693967} {:answer/id #uuid "fdf98e88-1518-53f1-9714-0417f2929cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 x \\operatorname{tan}{(x - 3 )}+3 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}+C" :db/id #edb/ref 17592186693969}] :answer-field/correct {:answer/id #uuid "b5e858e7-80e9-5dfd-ae50-3c2d1bf12d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 x \\operatorname{tan}{(x - 3 )}+3 \\ln{(|{\\operatorname{cos}{(x - 3 )}}| )}