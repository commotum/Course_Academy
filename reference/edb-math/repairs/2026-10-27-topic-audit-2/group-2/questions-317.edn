prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =9 x \\\\ u^{\\prime} & =9 \\\\ v^{\\prime} & =\\operatorname{sin}(2 x) \\\\ v & =-\\frac{\\operatorname{cos}(2 x)}{2}\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =9 x\\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right)9\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\int \\operatorname{cos}(2 x)\\,\\text{d}x}{2} \\\\  & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right)}{2}+C \\\\  & =-\\frac{9 x\\operatorname{cos}(2 x)}{2}+\\frac{9\\operatorname{sin}(2 x)}{4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ead871-24ed-5400-bae4-686f02541758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 x \\operatorname{sin}{(2 x )}+2 \\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693909} {:answer/id #uuid "7bf4cd93-9fed-58a9-943b-c0e085d82da6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 x \\operatorname{sin}{(2 x )}+2 \\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693923} {:answer/id #uuid "9352cd28-68cc-5b6c-8b78-baedf1c4be68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\operatorname{sin}{(2 x )}+\\frac{\\operatorname{cos}{(2 x )}}{2}+C" :db/id #edb/ref 17592186693927} {:answer/id #uuid "9a6dc913-4a71-5a81-bee1-95be3980c62e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 x \\operatorname{sin}{(2 x )}+\\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693930} {:answer/id #uuid "e7623f08-6cca-5666-957b-ab5f06a022d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 x \\operatorname{sin}{(2 x )}+\\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693936}] :answer-field/correct {:answer/id #uuid "14ead871-24ed-5400-bae4-686f02541758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 x \\operatorname{sin}{(2 x )}+2 \\operatorname{cos}{(2 x )}+C" :db/id #edb/ref 17592186693909} :answer-field/id #uuid "3b561170-cb8e-5d99-8584-d067ea668ee9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693913}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbb1cdcc-77f5-5f31-9a8d-82fa47f0faa3" :question/problem "$$\n\\int 8 x\\operatorname{cos}(2 x)\\,\\text{d}x=\n$$" :question/worked-solution "Write $I=\\int 8 x\\operatorname{cos}(2 x)\\,\\text{d}x$. Use integration by parts.\n\n$$\n\\int uv^{\\prime}\\,\\mathrm{d}x=uv-\\int vu^{\\prime}\\,\\mathrm{d}x.\n$$\n\nChoose the linear factor as $u$:\n\n$$\n\\begin{aligned}u & =8 x \\\\ u^{\\prime} & =8 \\\\ v^{\\prime} & =\\operatorname{cos}(2 x) \\\\ v & =\\frac{\\operatorname{sin}(2 x)}{2}\\end{aligned}\n$$\n\nSubstitute into the formula:\n\n$$\n\\begin{aligned}uv & =8 x\\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right) \\\\ \\int vu^{\\prime}\\,\\text{d}x & =\\int \\left(\\frac{\\operatorname{sin}(2 x)}{2}\\right)8\\,\\text{d}x\\end{aligned}\n$$\n\nEvaluate the remaining integral:\n\n$$\n\\begin{aligned}I & =\\frac{8 x\\operatorname{sin}(2 x)}{2}-4\\int \\operatorname{sin}(2 x)\\,\\text{d}x \\\\  & =\\frac{8 x\\operatorname{sin}(2 x)}{2}-4\\left(-\\frac{\\operatorname{cos}(2 x)}{2}\\right)+C \\\\  & =\\frac{8 x\\operatorname{sin}(2 x)}{2}+2\\operatorname{cos}(2 x)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186693948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6baa2743-362f-5fc4-9638-ecba52365759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident