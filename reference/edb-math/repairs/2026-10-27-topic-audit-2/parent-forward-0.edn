#{[{:db/id #edb/ref 17592186235287 :multistep/context "Consider the trigonometric function $f(x)=5sin⁡(2x).$" :multistep/id #uuid "112693d0-1740-5138-b117-6da5b56e4836" :multistep/steps [{:db/id #edb/ref 17592186235629 :step/content {:db/id #edb/ref 17592186235428}} {:db/id #edb/ref 17592186235647 :step/content {:db/id #edb/ref 17592186235422}} {:db/id #edb/ref 17592186235703 :step/content {:db/id #edb/ref 17592186235423}} {:db/id #edb/ref 17592186235710 :step/content {:db/id #edb/ref 17592186235426}} {:db/id #edb/ref 17592186235746 :step/content {:db/id #edb/ref 17592186235424}} {:db/id #edb/ref 17592186235754 :step/content {:db/id #edb/ref 17592186235425}} {:db/id #edb/ref 17592186235769 :step/content {:db/id #edb/ref 17592186235427}} {:db/id #edb/ref 17592186235788 :step/content {:db/id #edb/ref 17592186235421}}]}] [{:db/id #edb/ref 17592186235288 :multistep/context "An object generates an electric field given by $F(x,y)=(a{y}^{3}-1)\\,i+(3x{y}^{2}+1)\\,j$ in a planar coordinate system, where $a$ is a constant to be determined." :multistep/id #uuid "1b7601e5-548d-5aff-8dd3-0560b4ec89f2" :multistep/steps [{:db/id #edb/ref 17592186235602 :step/content {:db/id #edb/ref 17592186235532}} {:db/id #edb/ref 17592186235615 :step/content {:db/id #edb/ref 17592186235534}} {:db/id #edb/ref 17592186235637 :step/content {:db/id #edb/ref 17592186235533}} {:db/id #edb/ref 17592186235704 :step/content {:db/id #edb/ref 17592186235531}} {:db/id #edb/ref 17592186235705 :step/content {:db/id #edb/ref 17592186235528}} {:db/id #edb/ref 17592186235763 :step/content {:db/id #edb/ref 17592186235530}} {:db/id #edb/ref 17592186235767 :step/content {:db/id #edb/ref 17592186235529}}]}] [{:db/id #edb/ref 17592186235289 :multistep/context "![](images/56/56efd553cd7df12e615089a2a8fd41056aa8870a5b681f773c6f30729e29152c.png)\n\nConsider a continuous function $f$ defined on the closed interval $-10\\le x\\le 5.$ The graph of $y=f(x)$ is shown above for the region $-7\\le x\\le 5,$ and consists of two line segments and an arc of a semi-circle centered at $(-4,1)$ with radius $3.$ It is known that the point $(-5,1+2\\sqrt{2})$ is on the graph of $f.$" :multistep/id #uuid "22d447c2-89e8-5a07-be11-2ee2199283a7" :multistep/steps [{:db/id #edb/ref 17592186235660 :step/content {:db/id #edb/ref 17592186235508}} {:db/id #edb/ref 17592186235679 :step/content {:db/id #edb/ref 17592186235503}} {:db/id #edb/ref 17592186235724 :step/content {:db/id #edb/ref 17592186235505}} {:db/id #edb/ref 17592186235776 :step/content {:db/id #edb/ref 17592186235506}} {:db/id #edb/ref 17592186235779 :step/content {:db/id #edb/ref 17592186235507}} {:db/id #edb/ref 17592186235793 :step/content {:db/id #edb/ref 17592186235504}}]}] [{:db/id #edb/ref 17592186235290 :multistep/context "Amy and her friends are preparing to play a tabletop role-playing game (TTRPG). When selecting her character, Amy chose to be a knight." :multistep/id #uuid "2bc075b5-99af-5993-816c-08650dfdfe86" :multistep/steps [{:db/id #edb/ref 17592186235605 :step/content {:db/id #edb/ref 17592186235563}} {:db/id #edb/ref 17592186235664 :step/content {:db/id #edb/ref 17592186235560}} {:db/id #edb/ref 17592186235673 :step/content {:db/id #edb/ref 17592186235561}} {:db/id #edb/ref 17592186235680 :step/content {:db/id #edb/ref 17592186235558}} {:db/id #edb/ref 17592186235752 :step/content {:db/id #edb/ref 17592186235562}} {:db/id #edb/ref 17592186235757 :step/content {:db/id #edb/ref 17592186235557}} {:db/id #edb/ref 17592186235773 :step/content {:db/id #edb/ref 17592186235564}} {:db/id #edb/ref 17592186235783 :step/content {:db/id #edb/ref 17592186235559}}]}] [{:db/id #edb/ref 17592186235291 :multistep/context "![](images/e4/e489437aa3b22a90d71dea3d30ff7a53bb800580775666f97dd4a6cf2db76e6d.png)\n\nThe figure above shows the graphs of the functions $y=f(x)$ and $y=g(x).$" :multistep/id #uuid "2eaab060-c168-5f4b-9fce-1c85507d3036" :multistep/steps [{:db/id #edb/ref 17592186235618 :step/content {:db/id #edb/ref 17592186235377}} {:db/id #edb/ref 17592186235622 :step/content {:db/id #edb/ref 17592186235378}} {:db/id #edb/ref 17592186235639 :step/content {:db/id #edb/ref 17592186235380}} {:db/id #edb/ref 17592186235654 :step/content {:db/id #edb/ref 17592186235375}} {:db/id #edb/ref 17592186235729 :step/content {:db/id #edb/ref 17592186235379}} {:db/id #edb/ref 17592186235735 :step/content {:db/id #edb/ref 17592186235381}} {:db/id #edb/ref 17592186235778 :step/content {:db/id #edb/ref 17592186235376}} {:db/id #edb/ref 17592186235780 :step/content {:db/id #edb/ref 17592186235374}}]}] [{:db/id #edb/ref 17592186235292 :multistep/context "Consider the function $f(x)$, defined as follows:\n\n$$\nf(x)=\\begin{cases}\ne^x+x^2+x, & x\\le 1, \\\\\nx+a, & 1<x<3, \\\\\nx^2-2x, & x\\ge 3.\n\\end{cases}\n$$" :multistep/id #uuid "3a0846b6-2f92-540f-b3c4-80430fb8207e" :multistep/steps [{:db/id #edb/ref 17592186235606 :step/content {:db/id #edb/ref 17592186235469}} {:db/id #edb/ref 17592186235612 :step/content {:db/id #edb/ref 17592186235471}} {:db/id #edb/ref 17592186235613 :step/content {:db/id #edb/ref 17592186235472}} {:db/id #edb/ref 17592186235619 :step/content {:db/id #edb/ref 17592186235470}} {:db/id #edb/ref 17592186235627 :step/content {:db/id #edb/ref 17592186235468}} {:db/id #edb/ref 17592186235640 :step/content {:db/id #edb/ref 17592186235475}} {:db/id #edb/ref 17592186235684 :step/content {:db/id #edb/ref 17592186235467}} {:db/id #edb/ref 17592186235696 :step/content {:db/id #edb/ref 17592186235476}} {:db/id #edb/ref 17592186235721 :step/content {:db/id #edb/ref 17592186235473}} {:db/id #edb/ref 17592186235737 :step/content {:db/id #edb/ref 17592186235474}}]}] [{:db/id #edb/ref 17592186235293 :multistep/context "Maria and John are playing rock, paper, scissors. In each round, the players pick one of those three objects, and the rules are that rock beats scissors, scissors beats paper, and paper beats rock. \n\nThey decide to extend the game and make it so that the winner of each round receives $\\$2$ from the loser. So, for example, if Maria picks scissors and John picks rock, then Maria pays $\\$2$ to John.\n\nMaria represents the money she could earn or lose after one game using the following table.\n\n<div class=\"route-matrix route-matrix-wide\">\n  <span class=\"matrix-to\">John</span>\n  <span class=\"matrix-from\">Maria</span>\n  <table aria-label=\"Game payoffs: rows are Maria’s choices; columns are John’s choices\">\n    <thead>\n      <tr><td class=\"matrix-corner\"></td><th scope=\"col\">Rock</th><th scope=\"col\">Paper</th><th scope=\"col\">Scissors</th></tr>\n    </thead>\n    <tbody>\n<tr><th scope=\"row\">Rock</th><td>$0$</td><td>$-2$</td><td>$2$</td></tr>\n<tr><th scope=\"row\">Paper</th><td>$2$</td><td>$0$</td><td>$-2$</td></tr>\n<tr><th scope=\"row\">Scissors</th><td>$-2$</td><td>$2$</td><td>$0$</td></tr>\n    </tbody>\n  </table>\n</div>" :multistep/id #uuid "4129d817-2dc3-5aec-abb7-540a6063cdd4" :multistep/steps [{:db/id #edb/ref 17592186235609 :step/content {:db/id #edb/ref 17592186235403}} {:db/id #edb/ref 17592186235642 :step/content {:db/id #edb/ref 17592186235399}} {:db/id #edb/ref 17592186235665 :step/content {:db/id #edb/ref 17592186235400}} {:db/id #edb/ref 17592186235677 :step/content {:db/id #edb/ref 17592186235402}} {:db/id #edb/ref 17592186235682 :step/content {:db/id #edb/ref 17592186235401}} {:db/id #edb/ref 17592186235759 :step/content {:db/id #edb/ref 17592186235398}} {:db/id #edb/ref 17592186235789 :step/content {:db/id #edb/ref 17592186235404}}]}] [{:db/id #edb/ref 17592186235294 :multistep/context "Consider the quadratic function $f(x)=4-{x}^{2}.$" :multistep/id #uuid "42564b7c-0444-5256-983f-c909d16148da" :multistep/steps [{:db/id #edb/ref 17592186235584 :step/content {:db/id #edb/ref 17592186235417}} {:db/id #edb/ref 17592186235591 :step/content {:db/id #edb/ref 17592186235413}} {:db/id #edb/ref 17592186235617 :step/content {:db/id #edb/ref 17592186235416}} {:db/id #edb/ref 17592186235652 :step/content {:db/id #edb/ref 17592186235419}} {:db/id #edb/ref 17592186235662 :step/content {:db/id #edb/ref 17592186235414}} {:db/id #edb/ref 17592186235669 :step/content {:db/id #edb/ref 17592186235418}} {:db/id #edb/ref 17592186235676 :step/content {:db/id #edb/ref 17592186235412}} {:db/id #edb/ref 17592186235720 :step/content {:db/id #edb/ref 17592186235420}} {:db/id #edb/ref 17592186235761 :step/content {:db/id #edb/ref 17592186235415}}]}] [{:db/id #edb/ref 17592186235295 :multistep/context "Consider the function $f(x)=-{x}^{3}-3{x}^{2}+24x-7.$" :multistep/id #uuid "438eca66-14e2-5937-8e0c-e84fcd687062" :multistep/steps [{:db/id #edb/ref 17592186235587 :step/content {:db/id #edb/ref 17592186235362}} {:db/id #edb/ref 17592186235590 :step/content {:db/id #edb/ref 17592186235359}} {:db/id #edb/ref 17592186235611 :step/content {:db/id #edb/ref 17592186235361}} {:db/id #edb/ref 17592186235675 :step/content {:db/id #edb/ref 17592186235364}} {:db/id #edb/ref 17592186235738 :step/content {:db/id #edb/ref 17592186235365}} {:db/id #edb/ref 17592186235740 :step/content {:db/id #edb/ref 17592186235360}} {:db/id #edb/ref 17592186235745 :step/content {:db/id #edb/ref 17592186235366}} {:db/id #edb/ref 17592186235770 :step/content {:db/id #edb/ref 17592186235363}}]}] [{:db/id #edb/ref 17592186235296 :multistep/context "Consider the following functions:\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{1}{2}{e}^{x} \\\\\ng(x)&=8x-\\frac{2}{3}{x}^{3} \\\\\nh(x)&=-4\\operatorname{sin}⁡(x)\n\\end{aligned}\n$$" :multistep/id #uuid "4468367b-270c-5aa7-ab13-7147326d02c3" :multistep/steps [{:db/id #edb/ref 17592186235600 :step/content {:db/id #edb/ref 17592186235485}} {:db/id #edb/ref 17592186235603 :step/content {:db/id #edb/ref 17592186235482}} {:db/id #edb/ref 17592186235635 :step/content {:db/id #edb/ref 17592186235479}} {:db/id #edb/ref 17592186235650 :step/content {:db/id #edb/ref 17592186235478}} {:db/id #edb/ref 17592186235688 :step/content {:db/id #edb/ref 17592186235481}} {:db/id #edb/ref 17592186235701 :step/content {:db/id #edb/ref 17592186235484}} {:db/id #edb/ref 17592186235702 :step/content {:db/id #edb/ref 17592186235480}} {:db/id #edb/ref 17592186235771 :step/content {:db/id #edb/ref 17592186235477}} {:db/id #edb/ref 17592186235772 :step/content {:db/id #edb/ref 17592186235483}} {:db/id #edb/ref 17592186235787 :step/content {:db/id #edb/ref 17592186235486}}]}] [{:db/id #edb/ref 17592186235297 :multistep/context "![](images/d8/d868c69cee832cad796feaf0aae5bd6a4bd04d9ab2e76e275bb6e441a429f6e4.png)\n\nConsider the diagram shown above." :multistep/id #uuid "4acaa5e8-f1da-5f3a-9b4a-b585b8227ad6" :multistep/steps [{:db/id #edb/ref 17592186235634 :step/content {:db/id #edb/ref 17592186235492}} {:db/id #edb/ref 17592186235699 :step/content {:db/id #edb/ref 17592186235495}} {:db/id #edb/ref 17592186235716 :step/content {:db/id #edb/ref 17592186235491}} {:db/id #edb/ref 17592186235722 :step/content {:db/id #edb/ref 17592186235487}} {:db/id #edb/ref 17592186235727 :step/content {:db/id #edb/ref 17592186235493}} {:db/id #edb/ref 17592186235733 :step/content {:db/id #edb/ref 17592186235488}} {:db/id #edb/ref 17592186235741 :step/content {:db/id #edb/ref 17592186235490}} {:db/id #edb/ref 17592186235748 :step/content {:db/id #edb/ref 17592186235494}} {:db/id #edb/ref 17592186235755 :step/content {:db/id #edb/ref 17592186235489}}]}] [{:db/id #edb/ref 17592186235298 :multistep/context "A company produces two types of products, type A and type B. The revenue function of the company, in thousands of dollars, is given by $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=-{y}^{4}-5{x}^{2}{y}^{2}+10{y}^{2}-2{x}^{2}+2,\n$$\n\nwhere $x={\\begin{bmatrix}\\,x & y\\,\\end{bmatrix}}^{T},$ $x$ is the price (in thousands of dollars) per unit of product A, and $y$ is the price (in thousands of dollars) per unit of product B. The company can adjust the prices per unit for both types of products by adding or removing certain features." :multistep/id #uuid "5ab7e4ab-7724-5a17-87e7-7f2d55a9f3d2" :multistep/steps [{:db/id #edb/ref 17592186235599 :step/content {:db/id #edb/ref 17592186235547}} {:db/id #edb/ref 17592186235621 :step/content {:db/id #edb/ref 17592186235548}} {:db/id #edb/ref 17592186235668 :step/content {:db/id #edb/ref 17592186235544}} {:db/id #edb/ref 17592186235713 :step/content {:db/id #edb/ref 17592186235546}} {:db/id #edb/ref 17592186235714 :step/content {:db/id #edb/ref 17592186235543}} {:db/id #edb/ref 17592186235774 :step/content {:db/id #edb/ref 17592186235545}} {:db/id #edb/ref 17592186235786 :step/content {:db/id #edb/ref 17592186235542}}]}] [{:db/id #edb/ref 17592186235299 :multistep/context "![](images/4f/4fce9c5eebc7b439d9851ed0ed20df2e0879161b754d63fcd31502b26a8fb82e.png)\n\n \n\nA thin layer of fluid flows over a certain region of the plane, as shown above. The corresponding velocity vector field is given by $V(x,y)={x}^{2}y\\,i+2xy\\,j.$" :multistep/id #uuid "64b29a2d-65ed-55ff-9b90-5cca94feed7a" :multistep/steps [{:db/id #edb/ref 17592186235595 :step/content {:db/id #edb/ref 17592186235527}} {:db/id #edb/ref 17592186235597 :step/content {:db/id #edb/ref 17592186235522}} {:db/id #edb/ref 17592186235671 :step/content {:db/id #edb/ref 17592186235523}} {:db/id #edb/ref 17592186235681 :step/content {:db/id #edb/ref 17592186235525}} {:db/id #edb/ref 17592186235683 :step/content {:db/id #edb/ref 17592186235526}} {:db/id #edb/ref 17592186235690 :step/content {:db/id #edb/ref 17592186235524}}]}] [{:db/id #edb/ref 17592186235300 :multistep/context "![](images/41/4115f50e563758109358ebde96c41dd7674c9a17e3f0040d4c1b807a053fd394.png)\n\nA broker monitoring a company's stock found that the value of the stock $y,$ in thousands of dollars, can be modeled as the union of three curves corresponding to the functions $f(x)$, $g(x),$ and $h(x),$ where $x$ is the number of weeks since she started keeping track of the stock. The graph is shown above." :multistep/id #uuid "8e374ffb-a95b-52b8-bc70-568a304a724d" :multistep/steps [{:db/id #edb/ref 17592186235596 :step/content {:db/id #edb/ref 17592186235441}} {:db/id #edb/ref 17592186235598 :step/content {:db/id #edb/ref 17592186235437}} {:db/id #edb/ref 17592186235604 :step/content {:db/id #edb/ref 17592186235442}} {:db/id #edb/ref 17592186235638 :step/content {:db/id #edb/ref 17592186235438}} {:db/id #edb/ref 17592186235672 :step/content {:db/id #edb/ref 17592186235439}} {:db/id #edb/ref 17592186235697 :step/content {:db/id #edb/ref 17592186235440}} {:db/id #edb/ref 17592186235708 :step/content {:db/id #edb/ref 17592186235444}} {:db/id #edb/ref 17592186235790 :step/content {:db/id #edb/ref 17592186235443}}]}] [{:db/id #edb/ref 17592186235301 :multistep/context "Consider the functions $f(x)={x}^{B}+Ax,g(x)=B{e}^{x},$ and $h(x)=sin⁡x+1,$ where $A$ and $B$ are constants to be found." :multistep/id #uuid "8fd21532-89f6-5c25-a765-13883174e1e0" :multistep/steps [{:db/id #edb/ref 17592186235589 :step/content {:db/id #edb/ref 17592186235453}} {:db/id #edb/ref 17592186235636 :step/content {:db/id #edb/ref 17592186235456}} {:db/id #edb/ref 17592186235643 :step/content {:db/id #edb/ref 17592186235457}} {:db/id #edb/ref 17592186235656 :step/content {:db/id #edb/ref 17592186235454}} {:db/id #edb/ref 17592186235659 :step/content {:db/id #edb/ref 17592186235452}} {:db/id #edb/ref 17592186235700 :step/content {:db/id #edb/ref 17592186235459}} {:db/id #edb/ref 17592186235730 :step/content {:db/id #edb/ref 17592186235458}} {:db/id #edb/ref 17592186235747 :step/content {:db/id #edb/ref 17592186235455}}]}]}
