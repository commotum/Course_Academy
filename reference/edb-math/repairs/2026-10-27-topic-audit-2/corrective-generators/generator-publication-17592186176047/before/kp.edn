 complete set of inputs at which the function has minimum values is $x=n\\pi.$” is false. The minimum value is $-1$, attained at $x=\\pi+2n\\pi$. Every minimum input must be included."} {:db/id #edb/ref 17592186512034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80ec998e-ebc7-57cf-9585-e7037333b8b9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186512039} {:answer/id #uuid "89c1df3f-3762-583b-8c83-ee434a3252d9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512041}] :answer-field/correct {:answer/id #uuid "89c1df3f-3762-583b-8c83-ee434a3252d9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512041} :answer-field/id #uuid "17f8b1ab-556a-50ab-8924-407cb71a9248" :answer-field/key "The complete set of inputs at which the function has maximum values is $x=n\\pi.$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186511990} {:answer-field/choices [{:answer/id #uuid "3e3e3065-d748-56e4-9ea7-63e3f483a888" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186512004} {:answer/id #uuid "8a49b2d2-e020-53df-a5ee-1f419297d7de" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512043}] :answer-field/correct {:answer/id #uuid "8a49b2d2-e020-53df-a5ee-1f419297d7de" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186512043} :answer-field/id #uuid "98c2438b-478a-5125-9517-0d2f3e092a73" :answer-field/key "The complete set of inputs at which the function has minimum values is $x=2n\\pi.$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186512048} {:answer-field/choices [{:answer/id #uuid "20cc89a1-3922-5c45-a9fa-d75c8e199080" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186511993} {:answer/id #uuid "a40ec01a-5ba0-5a70-b087-12eb7c43c