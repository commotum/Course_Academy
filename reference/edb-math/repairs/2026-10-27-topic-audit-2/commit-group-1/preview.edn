x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}+{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{3{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\hspace{0.222em}\\frac{3}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\n- Taking $\\mathbf{x}\\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,0)\\,\\hspace{0.222em}\\hspace{0.222em}y=-x}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}-{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\hspace{0.222em}\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{\\mathbf{x}\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=\\text{DNE}\n$$" 13194139542460 17592186576411 true] [17592186125222 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\lim_{x\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=\\frac{2\\cdot {0}^{2}\\cdot 0+0\\cdot {0}^{2}}{{0}^{3}+0\\cdot {0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=x}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}+{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{3{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\,\\frac{3}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=-x}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{3}-{x}^{3}}{{x}^{3}+{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\frac{{x}^{3}}{2{x}^{3}} \\\\  & =\\lim_{x\\to 0}\\,\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{x\\to (0,0)}\\frac{2{y}^{2}x+y{x}^{2}}{{x}^{3}+x{y}^{2}}=\\text{DNE}\n$$" 13194139542460 17592186576411 false] [17592186125223 1071 "Find  $\\lim_{\\mathbf{x}\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}.$" 13194139542460 17592186576411 true] [17592186125223 1071 "Find  $\\lim_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}.$" 13194139542460 17592186576411 false] [17592186125224 1068 #edb/ref 17592186123944 13194139542460 17592186576411 false] [17592186125224 1071 "$$\n\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\n$$" 13194139542460 17592186576411 true] [17592186125224 1071 "$$\n\\lim_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\n$$" 13194139542460 17592186576411 false] [17592186125224 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\\frac{4-4}{\\sqrt{4}-\\sqrt{4}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}} & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x})^{2}-(\\sqrt{y})^{2}} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{\\mathbf{x}\\to (4,4)}(\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (4,4)}(\\sqrt{x}+\\sqrt{y}) & =\\sqrt{4}+\\sqrt{4} \\\\  & =2+2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $4.$" 13194139542460 17592186576411 true] [17592186125224 1074 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}}=\\frac{4-4}{\\sqrt{4}-\\sqrt{4}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (4,4)}\\frac{x-y}{\\sqrt{x}-\\sqrt{y}} & =\\lim_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & =\\lim_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x})^{2}-(\\sqrt{y})^{2}} \\\\  & =\\lim_{x\\to (4,4)}\\frac{(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{x\\to (4,4)}(\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (4,4)}(\\sqrt{x}+\\sqrt{y}) & =\\sqrt{4}+\\sqrt{4} \\\\  & =2+2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $4.$" 13194139542460 17592186576411 false] [17592186125731 1064 "We can extend our knowledge of limits to multivariable functions. We'll first consider the two-variable case. \n\nWe denote $\\mathbf{x}=(x,y)$ and $\\mathbf{x}_0 = (a,b)$ as a particular, fixed vector. Let the function $f(x,y)$ be defined in some neighborhood of $\\mathbf x_0.$ \n\nThen, the notation\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to \\mathbf{x}_0} f (x,y) = L\n$$\n\nmeans that the value of $f$ can be made as close as we want to $L,$ provided that $\\mathbf x$ is sufficiently close to $\\mathbf{x}_0.$\n\nA few things to note:\n\n- This definition of a limit also extends to functions of more than two variables in the natural way.\n\n- All of the rules set out by the algebra of limits are valid for functions of several variables.\n\nWe say that $f(x,y)$ is **continuous** at $(a,b)$ if\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to (a,b)} f (x,y) = f(a,b).\n$$\n\nSo, if a function is continuous at $(a,b),$ then the limit can be evaluated by simply plugging $(x,y) = (a,b)$ into the function.\n\nTo demonstrate, let's calculate the following limit:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,1)}} \\dfrac{xy}{x^2+y^2}\n$$\n\nThis function is continuous for all $(x,y)$ with the exception of $(0,0)$ where the denominator vanishes. Since the point $(2,1)$ does not cause the denominator to vanish, we can calculate the limit by substituting $(x,y) = (2,1)$ into the function:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (2,1)}\\frac{xy}{{x}^{2}+{y}^{2}} & =\\frac{2\\cdot 1}{{2}^{2}+{1}^{2}}=\\frac{2}{5}\\end{aligned}\n$$" 13194139542460 17592186576411 true] [17592186125731 1064 "We can extend our knowledge of limits to multivariable functions. We'll first consider the two-variable case. \n\nWe denote $\\mathbf{x}=(x,y)$ and $\\mathbf{x}_0 = (a,b)$ as a particular, fixed vector. Let the function $f(x,y)$ be defined in some neighborhood of $\\mathbf x_0.$ \n\nThen, the notation\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to \\mathbf{x}_0} f (x,y) = L\n$$\n\nmeans that the value of $f$ can be made as close as we want to $L,$ provided that $\\mathbf x$ is sufficiently close to $\\mathbf{x}_0.$\n\nA few things to note:\n\n- This definition of a limit also extends to functions of more than two variables in the natural way.\n\n- All of the rules set out by the algebra of limits are valid for functions of several variables.\n\nWe say that $f(x,y)$ is **continuous** at $(a,b)$ if\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to (a,b)} f (x,y) = f(a,b).\n$$\n\nSo, if a function is continuous at $(a,b),$ then the limit can be evaluated by simply plugging $(x,y) = (a,b)$ into the function.\n\nTo demonstrate, let's calculate the following limit:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,1)}} \\dfrac{xy}{x^2+y^2}\n$$\n\nThis function is continuous for all $(x,y)$ with the exception of $(0,0)$ where the denominator vanishes. Since the point $(2,1)$ does not cause the denominator to vanish, we can calculate the limit by substituting $(x,y) = (2,1)$ into the function:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,1)}\\frac{xy}{{x}^{2}+{y}^{2}} & =\\frac{2\\cdot 1}{{2}^{2}+{1}^{2}}=\\frac{2}{5}\\end{aligned}\n$$" 13194139542460 17592186576411 false] [17592186125754 1064 "Sometimes, we may need to simplify a limit before we can evaluate it. \n\nFor example, let's consider the limit\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2}.\n$$\n\nDirect substitution causes this limit to take the indeterminate form $\\dfrac 00$ because the numerator and denominator both evaluate to zero at the given point. \n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2} = \\dfrac{(2)^2 + 2(2)(-1)}{(2)(-1) + 2(-1)^2} = \\dfrac{0}{0}\n$$\n\nHowever, we can simplify the limit by factoring the numerator and denominator and then canceling a common factor, as follows:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (2,-1)}\\frac{{x}^{2}+2xy}{xy+2{y}^{2}} & =\\lim_{\\mathbf{x}\\to (2,-1)}\\frac{x(x+2y)}{y(x+2y)} \\\\  & =\\lim_{\\mathbf{x}\\to (2,-1)}\\frac{x}{y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (2,-1)}\\frac{x}{y} &=\\frac{2}{-1}=-2\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2} = -2.\n$$" 13194139542460 17592186576411 true] [17592186125754 1064 "Sometimes, we may need to simplify a limit before we can evaluate it. \n\nFor example, let's consider the limit\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2}.\n$$\n\nDirect substitution causes this limit to take the indeterminate form $\\dfrac 00$ because the numerator and denominator both evaluate to zero at the given point. \n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2} = \\dfrac{(2)^2 + 2(2)(-1)}{(2)(-1) + 2(-1)^2} = \\dfrac{0}{0}\n$$\n\nHowever, we can simplify the limit by factoring the numerator and denominator and then canceling a common factor, as follows:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,-1)}\\frac{{x}^{2}+2xy}{xy+2{y}^{2}} & =\\lim_{x\\to (2,-1)}\\frac{x(x+2y)}{y(x+2y)} \\\\  & =\\lim_{x\\to (2,-1)}\\frac{x}{y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,-1)}\\frac{x}{y}=\\frac{2}{-1}=-2\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,-1)}} \\dfrac{x^2+2xy}{xy+2y^2} = -2.\n$$" 13194139542460 17592186576411 false] [17592186125809 1064 "However, it is often easy to show that a limit does not exist for a multivariable function. All we have to do is find two paths on which the limit evaluates to different results. \n\nAs an example, let's consider the following limit:\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to (0,0)} \\dfrac{y}{x+y}\n$$\n\nClearly, direct substitution leads to the indeterminate form $\\dfrac00.$ Let's compute the limit along the paths $y=x$ and $y=x^2.$ We will see that the limit evaluates to different results on these two paths.\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,0)\\,\\hspace{0.222em}\\hspace{0.222em}y=x}\\frac{y}{x+y} & =\\lim_{x\\to 0}\\frac{x}{x+x} \\\\  & =\\lim_{x\\to 0}\\frac{x}{2x} \\\\  & =\\lim_{x\\to 0}\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=x^2,$ we have\n\n$$\n\\begin{aligned}\\lim_{\\mathbf{x}\\to (0,0)\\,\\hspace{0.222em}\\hspace{0.222em}y={x}^{2}}\\frac{y}{x+y} & =\\lim_{x\\to 0}\\frac{{x}^{2}}{x+{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x}{1+x} \\\\  & =\\frac{0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on these two paths, we conclude that the limit does not exist:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (0,0)}} \\dfrac{y}{x +y} = \\text{DNE}\n$$" 13194139542460 17592186576411 true] [17592186125809 1064 "However, it is often easy to show that a limit does not exist for a multivariable function. All we have to do is find two paths on which the limit evaluates to different results. \n\nAs an example, let's consider the following limit:\n\n$$\n\\lim\\limits_{\\mathbf{x} \\to (0,0)} \\dfrac{y}{x+y}\n$$\n\nClearly, direct substitution leads to the indeterminate form $\\dfrac00.$ Let's compute the limit along the paths $y=x$ and $y=x^2.$ We will see that the limit evaluates to different results on these two paths.\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=x}\\frac{y}{x+y} & =\\lim_{x\\to 0}\\frac{x}{x+x} \\\\  & =\\lim_{x\\to 0}\\frac{x}{2x} \\\\  & =\\lim_{x\\to 0}\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=x^2,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\frac{y}{x+y} & =\\lim_{x\\to 0}\\frac{{x}^{2}}{x+{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{x}{1+x} \\\\  & =\\frac{0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on these two paths, we conclude that the limit does not exist:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (0,0)}} \\dfrac{y}{x +y} = \\text{DNE}\n$$" 13194139542460 17592186576411 false] [17592186144292 1078 #edb/ref 17592186144297 13194139542460 17592186576411 true] [17592186144298 1078 #edb/ref 17592186144300 13194139542460 17592186576411 true] [17592186144309 1078 #edb/ref 17592186144313 13194139542460 17592186576411 true] [17592186144312 1080 "y^{2} - e^{xy} + 2x = 0" 13194139542460 17592186576411 true] [17592186144312 1080 "y^{2} - e^{xy} - 2x = 0" 13194139542460 17592186576411 false] [17592186144315 1078 #edb/ref 17592186144316 13194139542460 17592186576411 true] [17592186146462 1078 #edb/ref 17592186146467 13194139542460 17592186576411 true] [17592186147765 1074 "Write the equation as $(2+ye^{xy})\\,\\mathrm{d}x+(xe^{xy}-2y)\\,\\mathrm{d}y=0$. A potential is $F=e^{xy}-y^2+2x$, since $F_x=2+ye^{xy}$ and $F_y=xe^{xy}-2y$. Thus $e^{xy}-y^2+2x=c$." 13194139542460 17592186576411 true] [17592186147766 1071 "Consider the differential equation\n\n$$\n(2+ye^{xy})\\,\\mathrm{d}x+(xe^{xy}-2y)\\,\\mathrm{d}y=0\n$$\n\nTo test whether it is exact, write it as $P(x,y)\\,\\mathrm{d}x+Q(x,y)\\,\\mathrm{d}y=0$. Which partial-derivative equality is the exactness criterion?\n\n{{field-1}}" 13194139542460 17592186576411 true] [17592186147766 1071 "Determine whether the following differential equation is exact:\n$(2 + ye^{xy})dx + (xe^{xy} - 2y)dy = 0$A differential equation of the form\n\n$P(x, y)dx + Q(x, y)dy = 0$\n\nis exact if it satisfies the condition\n\n$\\frac{∂P}{∂x} = \\frac{∂Q}{∂y}$ {{field-1}}" 13194139542460 17592186576411 false] [17592186147766 1074 "The exactness criterion is $P_y=Q_x$. Here $P=2+ye^{xy}$ and $Q=xe^{xy}-2y$, so both partial derivatives equal $e^{xy}+xye^{xy}$. Thus the equation is exact." 13194139542460 17592186576411 true] [17592186147768 1074 "Rewrite the equation as $(2+ye^{xy})\\,\\mathrm{d}x+(xe^{xy}-2y)\\,\\mathrm{d}y=0$. A potential is $F=e^{xy}-y^2+2x$, since $F_x=2+ye^{xy}$ and $F_y=xe^{xy}-2y$.\n\nTherefore the solutions satisfy $e^{xy}-y^2+2x=C$. Using $y(0)=1$ gives $C=e^0-1+0=0$. Hence\n\n$$\ne^{xy}-y^2+2x=0.\n$$" 13194139542460 17592186576411 true] [17592186147769 1071 "Consider the differential equation\n\n$$\n(2+y^2e^{xy})\\,\\mathrm{d}x+(xe^{xy}-2y)\\,\\mathrm{d}y=0\n$$\n\nTo test whether it is exact, write it as $P(x,y)\\,\\mathrm{d}x+Q(x,y)\\,\\mathrm{d}y=0$. Which partial-derivative equality is the exactness criterion?\n\n{{field-1}}" 13194139542460 17592186576411 true] [17592186147769 1071 "Determine whether the following differential equation is exact:\n$(2 + y^{2}e^{xy})dx + (xe^{xy} - 2y)dy = 0$A differential equation of the form\n\n$P(x, y)dx + Q(x, y)dy = 0$\n\nis exact if it satisfies the condition\n\n$\\frac{∂P}{∂x} = \\frac{∂Q}{∂y}$ {{field-1}}" 13194139542460 17592186576411 false] [17592186147769 1074 "The exactness criterion is $P_y=Q_x$. Here $P_y=(2y+xy^2)e^{xy}$, whereas $Q_x=(1+xy)e^{xy}$. They are not identically equal, so the equation is not exact." 13194139542460 17592186576411 true] [17592186148118 1074 "Exactness requires $P_y=Q_x$. Since $Q=2y+x$, we have $Q_x=1$. For candidates I, II, III, $P_y$ is respectively $1,1,0$. Therefore I and II only are possible." 13194139542460 17592186576411 true] [17592186148124 1074 "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}\n$$\n\nIn our case, we're given $Q(x,y)=4{y}^{3}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(4{y}^{3})=0\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=\\operatorname{cos}⁡(x)+8.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}(x)+8) &=0=\\frac{∂Q}{∂x}\\hspace{1em}{\\color{green}✓}\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{cos}⁡(x)+8$ gives an exact equation.\n\n- Next, we check $P(x,y)=\\operatorname{ln}⁡(x+1)-2:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+1)-2)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{ln}⁡(x+1)-2$ gives an exact equation.\n\n- Finally, we check $P(x,y)=2x+7:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2x+7) &=0=\\frac{∂Q}{∂x}\\hspace{1em}{\\color{green}✓}\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2x+7$ gives an exact equation." 13194139542460 17592186576411 true] [17592186148124 1074 "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}\n$$\n\nIn our case, we're given $Q(x,y)=4{y}^{3}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(4{y}^{3})=0\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=\\operatorname{cos}⁡(x)+8.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}⁡(x)+8)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{cos}⁡(x)+8$ gives an exact equation.\n\n- Next, we check $P(x,y)=\\operatorname{ln}⁡(x+1)-2:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+1)-2)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{ln}⁡(x+1)-2$ gives an exact equation.\n\n- Finally, we check $P(x,y)=2x+7:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2x+7)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2x+7$ gives an exact equation." 13194139542460 17592186576411 false] [17592186171015 1078 #edb/ref 17592186171019 13194139542460 17592186576411 true] [17592186171225 1078 #edb/ref 17592186171226 13194139542460 17592186576411 true] [17592186171471 1078 #edb/ref 17592186171473 13194139542460 17592186576411 true] [17592186172565 1074 "Substitute each marked point into $y′=2-xy$. The slopes at $(-1,2)$, $(1,3)$, and $(0,-2)$ are respectively $4,-1,2$. Select the diagram with a steep positive segment on the left, a negative segment at $(1,3)$, and a positive segment at $(0,-2)$." 13194139542460 17592186576411 true] [17592186172600 1074 "Substitute each marked point into $y′=x^2-2y$. The slopes at $(1,2)$, $(-1,-1)$, and $(2,-2)$ are respectively $-3,3,8$. Select the diagram with those signed segment slopes." 13194139542460 17592186576411 true] [17592186172641 1074 "Compare segments across each horizontal row. In the selected diagram every segment in a row has the same slope, so the slope depends only on $y$. It therefore cannot represent the stated dependence on both $x$ and $y$." 13194139542460 17592186576411 true] [17592186174388 1078 #edb/ref 17592186174390 13194139542460 17592186576411 true] [17592186175414 1078 #edb/ref 17592186175416 13194139542460 17592186576411 true] [17592186175420 1078 #edb/ref 17592186175424 13194139542460 17592186576411 true] [17592186176355 1074 "Cosine has period $2\\pi$ and is even. Therefore $\\cos(-x+16\\pi)=\\cos(-x)=\\cos x=-11/24$." 13194139542460 17592186576411 true] [17592186176546 1074 "Cosine has period $2\\pi$, so $\\cos(x-6\\pi)=\\cos x$. Hence $4\\cos(x-6\\pi)-1=4(\\sqrt3/2)-1=2\\sqrt3-1$." 13194139542460 17592186576411 true] [17592186176547 1074 "The shift $10\\pi$ is five full periods, so $\\cos(x+10\\pi)=\\cos x=-1/\\sqrt3$." 13194139542460 17592186576411 true] [17592186177219 1078 #edb/ref 17592186177220 13194139542460 17592186576411 true] [17592186177225 1078 #edb/ref 17592186177228 13194139542460 17592186576411 true] [17592186177231 1078 #edb/ref 17592186177233 13194139542460 17592186576411 true] [17592186178143 1078 #edb/ref 17592186178145 13194139542460 17592186576411 true] [17592186178149 1078 #edb/ref 17592186178153 13194139542460 17592186576411 true] [17592186178563 1075 #edb/ref 17592186725815 13194139542460 17592186576411 true] [17592186178563 1078 #edb/ref 17592186725815 13194139542460 17592186576411 true] [17592186179925 1074 "At one half-life $H$, $e^{-0.53319H}=1/2$. Thus $H=\\ln2/0.53319=1.3000\\ldots\\,\\mathrm{s}$, which rounds to $1.3\\,\\mathrm{s}$." 13194139542460 17592186576411 true] [17592186179926 1074 "Exponential decay gives $M(t)=M_0\\,2^{-t/H}$. At the stated time, $t/H=1.5$, so $M=100\\,2^{-1.5}=35.3553\\ldots\\,\\mathrm{pg}$, or $35.36\\,\\mathrm{pg}$." 13194139542460 17592186576411 true] [17592186179927 1074 "The remaining fraction is $0.15=2^{-t/717000}$. Taking logarithms gives $t=717000\\ln(1/0.15)/\\ln2=1962404\\ldots$ years, approximately $1$ million $962$ thousand years." 13194139542460 17592186576411 true] [17592186180079 1074 "The remaining fraction is $6.25/200=1/32=(1/2)^5$. Five half-lives have elapsed, so $t=5(15.2)=76\\,\\mathrm{s}$." 13194139542460 17592186576411 true] [17592186180080 1074 "At the half-life, $e^{-0.001k}=1/2$. Therefore $k=\\ln2/0.001=693.147\\ldots\\,\\mathrm{s}^{-1}$, which is $693$ to three significant figures." 13194139542460 17592186576411 true] [17592186180169 1074 "The remaining fraction satisfies $0.70=2^{-t/12.3}$. Therefore $t=12.3\\ln(0.70)/\\ln(0.5)=6.3292\\ldots$ years, or $6.3$ years to one decimal place." 13194139542460 17592186576411 true] [17592186181456 1078 #edb/ref 17592186181460 13194139542460 17592186576411 true] [17592186181462 1078 #edb/ref 17592186181467 13194139542460 17592186576411 true] [17592186181468 1078 #edb/ref 17592186181471 13194139542460 17592186576411 true] [17592186181502 1078 #edb/ref 17592186181507 13194139542460 17592186576411 true] [17592186183042 1078 #edb/ref 17592186183043 13194139542460 17592186576411 true] [17592186183048 1078 #edb/ref 17592186183050 13194139542460 17592186576411 true] [17592186184548 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int 12 x^{3} + 5 x\\,\\mathrm{d}x=3x^{4} + \\frac{5x^{2}}{2} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(3 x^{4} + \\frac{5 x^{2}}{2}+C\\right)=12 x^{3} + 5 x.\n$$" 13194139542460 17592186576411 true] [17592186184549 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int \\sqrt{x} - 3\\,\\mathrm{d}x=\\frac{2\\sqrt{x^{3}}}{3} - 3x + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{2 x^{\\frac{3}{2}}}{3} - 3 x+C\\right)=\\sqrt{x} - 3.\n$$" 13194139542460 17592186576411 true] [17592186184550 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int - 3 x + \\frac{1}{x^{2}}\\,\\mathrm{d}x=-\\frac{3x^{2}}{2} - \\frac{1}{x} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(- \\frac{3 x^{2}}{2} - \\frac{1}{x}+C\\right)=- 3 x + \\frac{1}{x^{2}}.\n$$" 13194139542460 17592186576411 true] [17592186184563 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int - \\sqrt{x} + x^{2} + 2\\,\\mathrm{d}x=\\frac{x^{3} - 2\\sqrt{x^{3}} + 6x}{3} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(- \\frac{2 x^{\\frac{3}{2}}}{3} + \\frac{x^{3}}{3} + 2 x+C\\right)=- \\sqrt{x} + x^{2} + 2.\n$$" 13194139542460 17592186576411 true] [17592186184738 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int x^{\\frac{5}{2}} + \\frac{1}{x^{\\frac{5}{2}}}\\,\\mathrm{d}x=\\frac{2\\sqrt{x^{7}}}{7} - \\frac{2}{3\\sqrt{x^{3}}} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{2 x^{\\frac{7}{2}}}{7} - \\frac{2}{3 x^{\\frac{3}{2}}}+C\\right)=x^{\\frac{5}{2}} + \\frac{1}{x^{\\frac{5}{2}}}.\n$$" 13194139542460 17592186576411 true] [17592186184739 1074 "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int \\sqrt[5]{x} + 4 x^{7} - \\frac{1}{x^{\\frac{13}{7}}}\\,\\mathrm{d}x=\\frac{x^{8}}{2} + \\frac{5\\sqrt[5]{x^{6}}}{6} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{5 x^{\\frac{6}{5}}}{6} + \\frac{x^{8}}{2} + \\frac{7}{6 x^{\\frac{6}{7}}}+C\\right)=\\sqrt[5]{x} + 4 x^{7} - \\frac{1}{x^{\\frac{13}{7}}}.\n$$" 13194139542460 17592186576411 true] [17592186228333 1078 #edb/ref 17592186228337 13194139542460 17592186576411 true] [17592186228345 1078 #edb/ref 17592186228346 13194139542460 17592186576411 true] [17592186228567 1078 #edb/ref 17592186228571 13194139542460 17592186576411 true] [17592186229692 1074 "Substitu