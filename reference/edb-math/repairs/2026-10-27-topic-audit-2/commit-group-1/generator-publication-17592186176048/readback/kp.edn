#{[{:db/id #edb/ref 17592186176048 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175694 :question/id #uuid "a8cc8b8f-463b-5734-a33d-e915159cba32" :question/math-academy-id "e-11003" :question/problem "If $\\cos x =- \\dfrac {1}{3},$ find the value of $2\\cos( x + 4\\pi)+3.$" :question/worked-solution "The period of $y = \\cos x$ is $2\\pi.$ Therefore, for any integer $n$ we have\n\n$$\n\\cos{x} = \\cos{(x+2n\\pi)} .\n$$\n\nSubstituting $n=2$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x & =cos⁡(x+2\\cdot 2\\cdot \\pi ) \\\\  & =cos⁡(x+4\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos{x} =- \\dfrac {1}{3},$ then $\\cos{(x+4\\pi)} = - \\dfrac {1}{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}2cos⁡(x+4\\pi )+3 & =2\\left(-\\frac{1}{3}\\right)+3 \\\\  & =-\\frac{2}{3}+3 \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "1c25c3a0-083a-55d5-b688-7347bfafaa9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049353 :topic/id #uuid "ee26b28d-c213-5819-bf4f-97826f641d1d" :topic/knowledge-points [{:db/id #edb/ref 17592186133902} {:db/id #edb/ref 17592186133903} {:db/id #edb/ref 17592186133904}] :topic/math-academy-id 2148 :topic/next [{:db/id #edb/ref 17592186049155} {:db/id #edb/ref 17592186050718}] :topic/title "Periodic Functions"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725833 :question-generator/id #uuid "63797286-0780-5b74-9991-55d246d3977b" :question-generator/script "generators/dc/dc78d8c13ad9155f64efeca95efaef7acd20fd4cfd89d66ecd981fc1e4b76db7/17592186176048.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186176546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f28e6a-97ea-5e36-bf74-369bcac3c4bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186175415} {:answer/id #uuid "9e88cd3