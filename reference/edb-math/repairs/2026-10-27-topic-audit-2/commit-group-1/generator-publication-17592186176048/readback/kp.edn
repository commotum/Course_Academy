answer-field/choices [{:answer/id #uuid "128f2af3-d86a-521d-9b87-d08c1d096374" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186580412} {:answer/id #uuid "280defab-bb0e-5467-9302-2304ccfe9c9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}-2\\pi" :db/id #edb/ref 17592186580453} {:answer/id #uuid "e145844b-7979-5eb0-a240-56b9f9f42d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186580741} {:answer/id #uuid "e94091f4-18d7-5f6c-9b7f-e55c81c8c49a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186580754} {:answer/id #uuid "ef19b835-2f51-52cc-a2f9-fc1904cea930" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186580766}] :answer-field/correct {:answer/id #uuid "e94091f4-18d7-5f6c-9b7f-e55c81c8c49a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186580754} :answer-field/id #uuid "d4c9d1da-6b89-5ab2-8c06-0bef819742ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580868}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "95cc69d7-bf4f-55ce-b10c-871c735fbc08" :question/math-academy-id "q-65178" :question/problem "If $\\operatorname{cos}⁡x=\\frac{\\sqrt{5}}{3},$ then $\\sqrt{5}\\operatorname{cos}⁡(x-2\\pi )-2=$" :question/worked-solution "The period of $y=\\operatorname{cos}⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\operatorname{cos}⁡x=\\operatorname{cos}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-1$ into the right-hand-side gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x &=\\operatorname{cos}⁡(x-2\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cos}⁡x=\\frac{\\sqrt{5}}{3},$ then $\\operatorname{cos}⁡(x-2\\pi )=\\frac{\\sqrt{5}}{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}\\sqrt{5}\\operatorname{cos}⁡(x-2\\pi )-2 & =\\sqrt{5}\\left(\\frac{\\sqrt{5}}{3}\\right)-2 \\\\  & =\\frac{{(\\sqrt{5})}^{2}}{3}-2 \\\\  & =\\frac{5}{3}-2 \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186619717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f02f53-47e0-53d0-947e-da99324e17ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186619170} {:answer/id #uuid "1b644897-344d-5e88-b2d6-113f5842b131" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186619204} {:answer/id #uuid "7f21646d-a333-5db7-8556-e9dcbfabf616" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186619367} {:answer/id #uuid "b3083031-33a5-5c24-adf2-0b1fe860dc66" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186619462} {:answer/id #uuid "b3460535-8260-548d-8c0f-54d97fa3e2b2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186619463}] :answer-field/correct {:answer/id #uuid "b3460535-8260-548d-8c0f-54d97fa3e2b2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186619463} :answer-field/id #uuid "f1418037-4648-56fe-b77f-4e1c6a90f9db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186619705}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "08c91d6b-2f39-5f62-bcb1-ff8c61293232" :question/math-academy-id "q-27623" :question/problem "If $\\operatorname{cos}⁡x=-\\frac{1}{2},$ then $8\\operatorname{cos}⁡(x-2\\pi )+6=$" :question/worked-solution "The period of $y=\\operatorname{cos}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{cos}⁡x=\\operatorname{cos}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-1$ into the right-hand-side gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x &=\\operatorname{cos}⁡(x-2\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cos}⁡x=-\\frac{1}{2},$ then $\\operatorname{cos}⁡(x-2\\pi )=-\\frac{1}{2}.$\n\nFinally, then\n\n$$\n8\\operatorname{cos}⁡(x-2\\pi )+6=8\\left(-\\frac{1}{2}\\right)+6=-4+6=2.\n$$"}] :knowledge-point/title "Utilizing the Periodicity Property of the Cosine Function"}]}
