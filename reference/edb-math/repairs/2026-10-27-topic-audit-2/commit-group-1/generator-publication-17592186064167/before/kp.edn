f 17592186632093}] :answer-field/correct {:answer/id #uuid "22bcf2a9-77c7-5d82-b345-bdbb1e3f1ab9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{13}}{13}+C" :db/id #edb/ref 17592186632065} :answer-field/id #uuid "687d9602-d083-5dde-849c-37c5281d7a0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632076}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2400a578-4e3e-50d6-aaa1-b71cd0eb4bcd" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{12}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=12$, and we get\n\n$$\n\\int {x}^{12}\\,\\text{d}x=\\frac{{x}^{12+1}}{12+1}+C=\\frac{{x}^{13}}{13}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{13}}{13}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{13}}{13}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{13}\\frac{\\text{d}}{\\text{d}x}({x}^{13})+0 \\\\ &= \\frac{1}{13}\\cdot 13{x}^{12} \\\\ &= {x}^{12}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186632067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431270bd-146d-5112-b887-738a04648b51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186632074} {:answer/id #uuid "851a58e8-4f4d-5e1e-baec-320b49fd6198" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{6}+C" :db/id #edb/ref 17592186632079} {:answer/id #uuid "af29b014-c606-5fe0-a9dc-c8b52250806b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6}+C" :db/id #edb/ref 17592186632085} {:answer/id #uuid "cf96ecc9-b2ab-5851-b199-ec857eeed39e" :answer/type {:db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186632089} {:answer/id #uuid "e47afe31-bd30-5b7b-8e1a-8407781f6103" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186632092}] :answer-field/correct {:answer/id #uuid "af29b014-c606-5fe0-a9dc-c8b52250806b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6}+C" :db/id #edb/ref 17592186632085} :answer-field/id #uuid "f160be36-0205-577c-a3ce-ed30257270ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632094}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "24a65f7f-6166-52b0-b66b-e7bb9af593bd" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{5}$ and ${F}^{'}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=5$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{5}\\,\\text{d}x \\\\  & =\\frac{{x}^{5+1}}{5+1}+C \\\\  & =\\frac{{x}^{6}}{6}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{6}}{6}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{6}}{6}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{6}\\frac{\\text{d}}{\\text{d}x}({x}^{6})+0 \\\\ &= \\frac{1}{6}\\cdot 6\\,{x}^{5} \\\\ &= {x}^{5}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186632088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09aece13-93fe-51d3-8a5d-b4a2ab7eb067" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{21}}{20}+C" :db/id #edb/ref 17592186632063} {:answer/id #uuid "98f7e536-8b26-5303-9dc1-3a28e6569a4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{20}}{21}+C" :db/id #edb/ref 17592186632082} {:answer/id #uuid "a280dfca-6b2b-56aa-9b48-fcaa1280329f" :answer/type {:db/ident :answer.type/math} :answer/value "x^{20}+C" :db/id #edb/ref 17592186632083} {:answer/id #uuid "a4d0b5e0-9440-5979-a5ee-fc2cca5875bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{21}}{21}+C" :db/id #edb/ref 17592186632084} {:answer/id #uuid "f68f88e0-cb47-5014-b256-da46f2b718bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{20}}{20}+C" :db/id #edb/ref 17592186632096}] :answer-field/correct {:answer/id #uuid "f68f88e0-cb47-5014-b256-da46f2b718bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{20}}{20}+C" :db/id #edb/ref 17592186632096} :answer-field/id #uuid "da6746a6-59ee-52ba-93e6-d5310d5500c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632090}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd7041ea-d08b-5844-9b3c-40be8cd0bd12" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{19}$ and ${F}^{'}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=19$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{19}\\,\\text{d}x \\\\  & =\\frac{{x}^{19+1}}{19+1}+C \\\\  & =\\frac{{x}^{20}}{20}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{20}}{20}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{20}}{20}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{20}\\frac{\\text{d}}{\\text{d}x}({x}^{20})+0 \\\\ &= \\frac{1}{20}\\cdot 20\\,{x}^{19} \\\\ &= {x}^{19}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186632091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e4247c-6054-5f84-84f5-ed5f824d5d90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186632062} {:answer/id #uuid "3bf81e1c-d2d5-5a7d-9e79-6d2e3e314f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186632072} {:answer/id #uuid "66cf396e-3228-5244-9f4c-aedcae1d70c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{4}+C" :db/id #edb/ref 17592186632075} {:answer/id #uuid "8783c8dd-e5fa-5f7a-af8f-c4b7a7c68b03" :answer/type {:db/ident :answer.type/math} :answer/value "x^{5}+C" :db/id #edb/ref 17592186632080} {:answer/id #uuid "f545b0d2-fda1-55ef-b61e-183b5bad59a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{5}+C" :db/id #edb/ref 17592186632095}] :answer-field/correct {:answer/id #uuid "05e4247c-6054-5f84-84f5-ed5f824d5d90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186632062} :answer-field/id #uuid "3cc5e987-43f3-52ec-8e2d-dacca1c43b26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e44b04a5-8d3e-56fa-ae3e-15c4f664b2e9" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{4}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=4$, and we get\n\n$$\n\\int {x}^{4}\\,\\text{d}x=\\frac{{x}^{4+1}}{4+1}+C=\\frac{{x}^{5}}{5}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{5}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 \\\\ &= \\frac{1}{5}\\cdot 5{x}^{4} \\\\ &= {x}^{4}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295e216d-1767-5d93-bd49-000a8278b724" :answer/type {:db/ident :answer.type/math} :answer/value "x+C" :db/id #edb/ref 17592186700417}] :answer-field/correct {:answer/id #uuid "295e216d-1767-5d93-bd49-000a8278b724" :answer/type {:db/ident :answer.type/math} :answer/value "x+C" :db/id #edb/ref 17592186700417} :answer-field/id #uuid "3a09ff01-ec22-54ea-ac09-afb7ae64a096" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700420}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "43eaa0f0-dd22-52cc-86d8-711bdc4f8acc" :question/problem "Given $f(x)=1$ and $F'(x)=f(x)$, find the general expression for $F(x)$. Use $C$ for the arbitrary constant of integration.\n\n$F(x)=$ {{antiderivative}}" :question/worked-solution "We need a function whose derivative is $1$. Since integration reverses differentiation,\n\n$$\nF(x)=\\int 1\\,\\mathrm{d}x.\n$$\n\nThe constant integrand is the power $x^0$, so the power rule applies with $n=0$:\n\n$$\nF(x)=\\int x^0\\,\\mathrm{d}x=\\frac{x^{0+1}}{0+1}+C=x+C.\n$$\n\nCheck:\n\n$$\nF'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}(x+C)=1+0=1=f(x).\n$$\n\nEvery constant $C$ gives the same derivative, so $x$ alone is only one antiderivative; $x+C$ describes the general family."} {:db/id #edb/ref 17592186700427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b33f7f-0ed6-5010-a114-08b13a89a73e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^9}{9}+C" :db/id #edb/ref 17592186700416} {:answer/id #uuid "2b132236-db31-5a86-a1eb-52558ac5948e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{9}+C" :db/id #edb/ref 17592186700418} {:answer/id #uuid "5092b2af-d9c6-5eb2-8d0b-6cf1c04c348c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}+C" :db/id #edb/ref 17592186700423} {:answer/id #uuid "96f982ab-aaa2-5ffd-a137-04d46d1f4b2a" :answer/type {:db/ident :answer.type/math} :answer/value "9x^8+C" :db/id #edb/ref 17592186700426} {:answer/id #uuid "d2953e38-8285-5d5c-8687-9709a1494c6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}" :db/id #edb/ref 17592186700428}] :answer-field/correct {:answer/id #uuid "5092b2af-d9c6-5eb2-8d0b-6cf1c04c348c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}+C" :db/id #edb/ref 17592186700423} :answer-field/id #uuid "d3a6b5d3-e621-534e-b053-c0bc1433c040" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700429}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cb0a26ec-3743-56c1-a25f-60164f32d428" :question/problem "Calculate\n\n$$\n\\int x^9\\,\\mathrm{d}x.\n$$\n\nSelect the general antiderivative, including the arbitrary constant of integration." :question/worked-solution "The power rule for integration increases the exponent by one and divides by that new exponent. With $n=9$,\n\n$$\n\\int x^9\\,\\mathrm{d}x=\\frac{x^{9+1}}{9+1}+C=\\frac{x^{10}}{10}+C.\n$$\n\nHere $C$ is an arbitrary constant. Check by differentiating:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{10}}{10}+C\\right)=\\frac{1}{10}\\cdot 10x^9+0=x^9.\n$$"} {:db/id #edb/ref 17592186700430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2baa8efb-cc02-563c-8076-3b7e3d71ea5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^5}{5}+C" :db/id #edb/ref 17592186700419}] :answer-field/correct {:answer/id #uuid "2baa8efb-cc02-563c-8076-3b7e3d71ea5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^5}{5}+C" :db/id #edb/ref 17592186700419} :answer-field/id #uuid "3c90252f-4f8b-588e-ba82-87453d439d52" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700421} {:answer-field/choices [{:answer/id #uuid "89c0b5be-d1a0-5f61-bf1f-567661a4f050" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^4}{4}" :db/id #edb/ref 17592186700425}] :answer-field/correct {:answer/id #uuid "89c0b5be-d1a0-5f61-bf1f-567661a4f050" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^4}{4}" :db/id #edb/ref 17592186700425} :answer-field/id #uuid "72538860-e2ca-57cf-b8f4-a18487993c28" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700424}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ff219463-6af7-5653-a485-d339b1b9ac56" :question/problem "Given $f(x)=x^4$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^5}{4}+C,\n$$\n\nwhere $C$ is an arbitrary constant. Check the proposed expression by differentiating it, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. The derivative of the proposed expression is $G'(x)=$ {{derivative}}.\n2. The correct general expression is $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression first:\n\n$$\nG'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^5}{4}+C\\right)=\\frac{1}{4}\\cdot 5x^4+0=\\frac{5x^4}{4}.\n$$\n\nThis is not $f(x)=x^4$. The student increased the exponent to $5$ but divided by the old exponent $4$. To undo differentiation, divide by the new exponent:\n\n$$\nF(x)=\\int x^4\\,\\mathrm{d}x=\\frac{x^{4+1}}{4+1}+C=\\frac{x^5}{5}+C.\n$$\n\nVerify the correction:\n\n$$\nF'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^5}{5}+C\\right)=\\frac{1}{5}\\cdot 5x^4+0=x^4=f(x).\n$$\n\nThe arbitrary constant remains in the antiderivative and disappears in its derivative."} {:db/id #edb/ref 17592186700563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75603fb7-c5a9-51e8-b7f6-00eea29ebb1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{4}" :db/id #edb/ref 17592186700572}] :answer-field/correct {:answer/id #uuid "75603fb7-c5a9-51e8-b7f6-00eea29ebb1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{4}" :db/id #edb/ref 17592186700572} :answer-field/id #uuid "09708e45-1f26-580d-b4b0-c98a97bb688c" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700561} {:answer-field/choices [{:answer/id #uuid "b0e442f2-a271-54e7-8f80-654deff22cff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186700577}] :answer-field/correct {:answer/id #uuid "b0e442f2-a271-54e7-8f80-654deff22cff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186700577} :answer-field/id #uuid "b10c2148-d0e7-5410-8595-bb2a18a12058" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700578}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1dab34fc-6107-55d3-b10d-c9eb120d2ee4" :question/problem "Given $f(x)=x^{3}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^{3}}{4}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{3}}{4}+C\\right) \\\\ &=\\frac{1}{4}\\cdot 3x^{2}+0 \\\\ &=\\frac{3 x^{2}}{4}.\\end{aligned}\n$$\n\nThe proposed expression divides by the new exponent but leaves the exponent unchanged.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=3$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{3}\\,\\mathrm{d}x \\\\ &=\\frac{x^{3+1}}{3+1}+C \\\\ &=\\frac{x^{4}}{4}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{4}}{4}+C\\right)&=\\frac{1}{4}\\cdot 4x^{3}+0 \\\\ &=x^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c888bc-5826-5b51-b64b-1bcab5e3b891" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186700564}] :answer-field/correct {:answer/id #uuid "32c888bc-5826-5b51-b64b-1bcab5e3b891" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186700564} :answer-field/id #uuid "3821c9fd-f6ea-5058-a5bc-1eb90b6de307" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700565} {:answer-field/choices [{:answer/id #uuid "92eedf2b-e0ea-5fd8-b4ef-405047a3d6c0" :answer/type {:db/ident :answer.type/math} :answer/value "9 x^{8}" :db/id #edb/ref 17592186700575}] :answer-field/correct {:answer/id #uuid "92eedf2b-e0ea-5fd8-b4ef-405047a3d6c0" :answer/type {:db/ident :answer.type/math} :answer/value "9 x^{8}" :db/id #edb/ref 17592186700575} :answer-field/id #uuid "a3203eb7-d8d2-5995-8e9c-e8e9d807a371" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700576}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "496f23dc-fc22-5733-9883-bf9ff6f1dd21" :question/problem "Given $f(x)=x^{8}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=x^{9}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(x^{9}+C\\right) \\\\ &=1\\cdot 9x^{8}+0 \\\\ &=9 x^{8}.\\end{aligned}\n$$\n\nThe proposed expression omits division by the new exponent.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=8$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{8}\\,\\mathrm{d}x \\\\ &=\\frac{x^{8+1}}{8+1}+C \\\\ &=\\frac{x^{9}}{9}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{9}}{9}+C\\right)&=\\frac{1}{9}\\cdot 9x^{8}+0 \\\\ &=x^{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e0fa51-63ce-5bc6-8479-4772fc2d2e1c" :answer/type {:db/ident :answer.type/math} :answer/value "x^{10}" :db/id #edb/ref 17592186700560}] :answer-field/correct {:answer/id #uuid "02e0fa51-63ce-5bc6-8479-4772fc2d2e1c" :answer/type {:db/ident :answer.type/math} :answer/value "x^{10}" :db/id #edb/ref 17592186700560} :answer-field/id #uuid "18f812af-1a65-5f83-a221-1110e8ba14e3" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700562} {:answer-field/choices [{:answer/id #uuid "d9993038-f68a-5c71-9dbf-8fff7041def9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{11}}{11}+C" :db/id #edb/ref 17592186700580}] :answer-field/correct {:answer/id #uuid "d9993038-f68a-5c71-9dbf-8fff7041def9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{11}}{11}+C" :db/id #edb/ref 17592186700580} :answer-field/id #uuid "72da51d8-78f0-5b09-ae6c-ccd24522f8d2" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700571}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "54172dfa-98f2-5433-82f3-31dd6dd5e828" :question/problem "Given $f(x)=x^{10}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^{11}}{11}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{11}}{11}+C\\right) \\\\ &=\\frac{1}{11}\\cdot 11x^{10}+0 \\\\ &=x^{10}.\\end{aligned}\n$$\n\nThe proposed expression does differentiate to the given function.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=10$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{10}\\,\\mathrm{d}x \\\\ &=\\frac{x^{10+1}}{10+1}+C \\\\ &=\\frac{x^{11}}{11}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{11}}{11}+C\\right)&=\\frac{1}{11}\\cdot 11x^{10}+0 \\\\ &=x^{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4efd4867-5512-5b91-971d-60b0f9a00d98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 x^{4}}{4}" :db/id #edb/ref 17592186700568}] :answer-field/correct {:answer/id #uuid "4efd4867-5512-5b91-971d-60b0f9a00d98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5 x^{4}}{4}" :db/id #edb/ref 17592186700568} :answer-field/id #uuid "e302afe6-e6bf-5a18-932e-23ba8a1299ff" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700581} {:answer-field/choices [{:answer/id #uuid "486a75de-fea9-549b-abe3-43a6f3598aa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186700566}] :answer-field/correct {:answer/id #uuid "486a75de-fea9-549b-abe3-43a6f3598aa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186700566} :answer-field/id #uuid "f94c6270-9467-57e6-a948-c77b0fb8c8eb" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700583}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "75889302-faba-51c2-87ad-8cc85bbcab9e" :question/problem "Given $f(x)=x^{4}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^{5}}{4}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{5}}{4}+C\\right) \\\\ &=\\frac{1}{4}\\cdot 5x^{4}+0 \\\\ &=\\frac{5 x^{4}}{4}.\\end{aligned}\n$$\n\nThe proposed expression divides by the old exponent rather than the new exponent.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=4$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{4}\\,\\mathrm{d}x \\\\ &=\\frac{x^{4+1}}{4+1}+C \\\\ &=\\frac{x^{5}}{5}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{5}}{5}+C\\right)&=\\frac{1}{5}\\cdot 5x^{4}+0 \\\\ &=x^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff19365c-eb62-5c2a-a0f0-f8d9ff0225bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186700584}] :answer-field/correct {:answer/id #uuid "ff19365c-eb62-5c2a-a0f0-f8d9ff0225bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186700584} :answer-field/id #uuid "5066c5fa-3246-598e-85b5-a3d2b0500d97" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700569} {:answer-field/choices [{:answer/id #uuid "8971dadb-c93f-5d41-9b68-b5f5ede98c4f" :answer/type {:db/ident :answer.type/math} :answer/value "64 x^{7}" :db/id #edb/ref 17592186700574}] :answer-field/correct {:answer/id #uuid "8971dadb-c93f-5d41-9b68-b5f5ede98c4f" :answer/type {:db/ident :answer.type/math} :answer/value "64 x^{7}" :db/id #edb/ref 17592186700574} :answer-field/id #uuid "c0b6540a-ddd4-5e24-a329-d12b853098c4" :answer-field/key "derivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700579}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ed74f25e-aeb7-5e9d-9561-681703c592ec" :question/problem "Given $f(x)=x^{7}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=8 x^{8}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(8 x^{8}+C\\right) \\\\ &=8\\cdot 8x^{7}+0 \\\\ &=64 x^{7}.\\end{aligned}\n$$\n\nThe proposed expression multiplies by the new exponent rather than dividing.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=7$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{7}\\,\\mathrm{d}x \\\\ &=\\frac{x^{7+1}}{7+1}+C \\\\ &=\\frac{x^{8}}{8}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{8}}{8}+C\\right)&=\\frac{1}{8}\\cdot 8x^{7}+0 \\\\ &=x^{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186704829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e749ef30-77c5-59c3-a1e0-393b936f7f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186704838}] :answer-field/correct {:answer/id #uuid "e749ef30-77c5-59c3-a1e0-393b936f7f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186704838} :answer-field/id #uuid "5af7e46e-708f-50c8-89ad-c257876e468a" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186704831}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b6a9d78-be17-5fe2-a3f6-8ea8a23ef0fb" :question/problem "Calculate \n\n$$\n\\int {x}^{8}\\,\\text{d}x.\n$$\n\n Use $C$ for the arbitrary constant of integration.\n\n{{antiderivative}}" :question/worked-solution "Apply the power rule with $n=8$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}\\int x^{8}\\,\\mathrm{d}x&=\\frac{x^{8+1}}{8+1}+C \\\\ &=\\frac{x^{9}}{9}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{9}}{9}+C\\right)&=\\frac{1}{9}\\cdot 9x^{8}+0 \\\\ &=x^{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186704833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c62d47e-98ee-5481-8f1d-4be4b02aada5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{16}}{16}+C" :db/id #edb/ref 17592186704828}] :answer-field/correct {:answer/id #uuid "1c62d47e-98ee-5481-8f1d-4be4b02aada5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{16}}{16}+C" :db/id #edb/ref 17592186704828} :answer-field/id #uuid "c89b9c86-d516-580d-a990-693b697834bc" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186704834}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "90f14c3f-45af-5278-9957-6b92ec8354d6" :question/problem "Calculate \n\n$$\n\\int {x}^{15}\\,\\text{d}x.\n$$\n\n Use $C$ for the arbitrary constant of integration.\n\n{{antiderivative}}" :question/worked-solution "Apply the power rule with $n=15$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}\\int x^{15}\\,\\mathrm{d}x&=\\frac{x^{15+1}}{15+1}+C \\\\ &=\\frac{x^{16}}{16}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{16}}{16}+C\\right)&=\\frac{1}{16}\\cdot 16x^{15}+0 \\\\ &=x^{15}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186704835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a1627df-e486-501b-a8f0-4a9e394dc74e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{20}}{20}+C" :db/id #edb/ref 17592186704832}] :answer-field/correct {:answer/id #uuid "8a1627df-e486-501b-a8f0-4a9e394dc74e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{20}}{20}+C" :db/id #edb/ref 17592186704832} :answer-field/id #uuid "456088ff-55fa-5e43-b60a-c99ef8a22e5a" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186704830}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d00eb424-29f8-51c1-83a9-f9d0e59fbee0" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{19}$ and ${F}^{'}(x)=f(x).$ Use $C$ for the arbitrary constant of integration.\n\n$F(x)=$ {{antiderivative}}" :question/worked-solution "Integration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=19$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{19}\\,\\mathrm{d}x \\\\ &=\\frac{x^{19+1}}{19+1}+C \\\\ &=\\frac{x^{20}}{20}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{20}}{20}+C\\right)&=\\frac{1}{20}\\cdot 20x^{19}+0 \\\\ &=x^{19}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186704837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8810d54-d9e5-5b7c-883c-1fd4e263c50c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2}+C" :db/id #edb/ref 17592186704836}] :answer-field/correct {:answer/id #uuid "d8810d54-d9e5-5b7c-883c-1fd4e263c50c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2}+C" :db/id #edb/ref 17592186704836} :answer-field/id #uuid "e766b1b7-9dae-567a-9120-fb22041ad40f" :answer-field/key "antiderivative" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186704839}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "df16da36-a902-5c17-9016-49db16dba219" :question/problem "Calculate \n\n$$\n\\int {x}^{1}\\,\\text{d}x.\n$$\n\n Use $C$ for the arbitrary constant of integration.\n\n{{antiderivative}}" :question/worked-solution "Apply the power rule with $n=1$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}\\int x\\,\\mathrm{d}x&=\\frac{x^{1+1}}{1+1}+C \\\\ &=\\frac{x^{2}}{2}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{2}}{2}+C\\right)&=\\frac{1}{2}\\cdot 2x+0 \\\\ &=x.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Antiderivative of a Monomial"}]}
