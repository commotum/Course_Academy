175-65b7-57c4-b9e2-727b6b0c9179" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186061535} {:answer/id #uuid "4f79a5e8-a535-5732-a68c-46578acb44dc" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3} + C" :db/id #edb/ref 17592186061536}] :answer-field/correct {:answer/id #uuid "4e170175-65b7-57c4-b9e2-727b6b0c9179" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186061535} :answer-field/id #uuid "5f64550e-ffcf-5991-a4ac-264a9e506706" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061531}] :question/id #uuid "a4162e45-b600-54a2-bad9-383dac48cede" :question/math-academy-id "q-2022" :question/problem "Calculate the integral.\n\n$$\n\\int x^{4}\\,\\mathrm{d}x.\n$$" :question/worked-solution "Apply the sum and constant multiple rules, using the power rule or the standard trigonometric/exponential antiderivative for each term:\n\n$$\n\\int x^{4}\\,\\mathrm{d}x=\\frac{x^{5}}{5} + C.\n$$\n\nDifferentiate the result to check:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{5}}{5}+C\\right)=x^{4}.\n$$"} {:db/id #edb/ref 17592186233174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} {:answer/id #uuid "62de7813-7886-5bed-86cd-1ca23e600b30" :answer/type {:db/ident :answer.type/math} :answer/value "21{x}^{19}+C" :db/id #edb/ref 17592186513799} {:answer/id #uuid "65428549-ccd7-5201-8026-265c549f0352" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{19}+C" :db/id #edb/ref 17592186513804} {:answer/id #uuid "7f5af8b6-1444-5218-bbb1-bf6a887d157c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{19}}{19}+C" :db/id #edb/ref 17592186513863} {:answer/id #uuid "8cf69104-089b-5eec-8f81-3bf53d5632ac" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{21}+C" :db/id #edb/ref 17592186513895}] :answer-field/correct {:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} :answer-field/id #uuid "6982cbcb-0bd9-554d-8104-e02dd398a383" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514278}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6e6c66f6-6133-59f6-a79d-0cbf1615accf" :question/math-academy-id "q-113665" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{20}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=20$, and we get\n\n$$\n\\int {x}^{20}\\,\\text{d}x=\\frac{{x}^{20+1}}{20+1}+C=\\frac{{x}^{21}}{21}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{21}}{21}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{21}\\frac{\\text{d}}{\\text{d}x}({x}^{21})+0 \\\\ &= \\frac{1}{21}\\cdot 21{x}^{20} \\\\ &= {x}^{20}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233175 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7949e7bf-09d1-5ce9-ac3c-0d7f26b2e6c4" :question/math-academy-id "q-113670" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{17}$ and ${F}^{'}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=17$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{17}\\,\\text{d}x \\\\  & =\\frac{{x}^{17+1}}{17+1}+C \\\\  & =\\frac{{x}^{18}}{18}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{18}}{18}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{18}}{18}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{18}\\frac{\\text{d}}{\\text{d}x}({x}^{18})+0 \\\\ &= \\frac{1}{18}\\cdot 18\\,{x}^{17} \\\\ &= {x}^{17}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234186 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "48cc16d0-0280-564d-bcf3-e481ad8d20ab" :question/math-academy-id "q-66126" :question/problem "Calculate $$\n\\displaystyle \\int 1\\,\\text{d}x.\n$$" :question/worked-solution "If we write the integrand as a power of $x$, we have ${x}^{0}=1.$ Therefore, we can use the power rule with $n=0$ and we get\n\n$$\n\\begin{aligned}\\int 1\\,\\text{d}x & =\\int {x}^{0}\\,\\text{d}x \\\\  & =\\frac{{x}^{0+1}}{0+1}+C \\\\  & =x+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(x+C) &= \\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= 1+0 \\\\ &= 1\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234300 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb47b292-deba-58b8-a79e-0386e8ea55e3" :question/math-academy-id "q-71121" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{10}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=10$, and we get\n\n$$\n\\int {x}^{10}\\,\\text{d}x=\\frac{{x}^{10+1}}{10+1}+C=\\frac{{x}^{11}}{11}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{11}}{11}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{11}\\frac{\\text{d}}{\\text{d}x}({x}^{11})+0 \\\\ &= \\frac{1}{11}\\cdot 11{x}^{10} \\\\ &= {x}^{10}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref