#{[{:db/id #edb/ref 17592186064167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064038 :question/id #uuid "368cbbae-4eff-5eff-a8f3-d3e8359447a9" :question/math-academy-id "e-364" :question/problem "Calculate $$\n\\displaystyle \\int x^2 \\,\\textrm d x.\n$$" :question/worked-solution "We apply the power rule with $n=2$, and we get\n\n$$\n\\int x^2 \\,\\textrm d x = \\dfrac{x^{2+1}}{2+1} + C = \\dfrac{x^3}{3}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{3}}{3}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 \\\\ &= \\frac{1}{3}\\cdot 3{x}^{2} \\\\ &= {x}^{2}\\,✓\\end{aligned}\n$$"} :knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593 :topic/id #uuid "ac718bb5-4681-5ba0-883a-072801cad492" :topic/knowledge-points [{:db/id #edb/ref 17592186054810} {:db/id #edb/ref 17592186054811} {:db/id #edb/ref 17592186054812} {:db/id #edb/ref 17592186054813}] :topic/math-academy-id 35 :topic/next [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049481}] :topic/title "The Power Rule for Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186704840 :question-generator/id #uuid "a044de28-11ee-5630-bffb-730c3353b832" :question-generator/script "generators/ff/ff861c628fcfd0c901b4749dbd2cb2b07e8fcc9941853a3147857a457eaaef00/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186064554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd9ded59-ba65-5176-b8f9-b0abbcde8e5e" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2}" :db/id #edb/ref 17592186061520} {:answer/id #uuid "06876c28-ebd0-5db2-80b3-e9af69ed8c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{