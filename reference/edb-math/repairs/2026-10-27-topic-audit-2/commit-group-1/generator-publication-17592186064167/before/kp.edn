552" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{13}+C" :db/id #edb/ref 17592186513693} {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} {:answer/id #uuid "a01e6e97-6d87-5937-8e57-076aaa390207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{12}+C" :db/id #edb/ref 17592186513942} {:answer/id #uuid "a8adc543-25c4-55be-8081-e8857819cce0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{14}+C" :db/id #edb/ref 17592186513971} {:answer/id #uuid "f56d5cb2-21a5-51fe-8738-17f8affe9a15" :answer/type {:db/ident :answer.type/math} :answer/value "13{x}^{14}+C" :db/id #edb/ref 17592186514172}] :answer-field/correct {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} :answer-field/id #uuid "c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514321}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c1117fb-96ed-5032-8c50-48772b44cf5c" :question/math-academy-id "q-113668" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{13}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=13$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{13}\\,\\text{d}x \\\\  & =\\frac{{x}^{13+1}}{13+1}+C \\\\  & =\\frac{{x}^{14}}{14}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{14}}{14}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{14}\\frac{\\text{d}}{\\text{d}x}({x}^{14})+0 \\\\ &= \\frac{1}{14}\\cdot 14\\,{x}^{13} \\\\ &= {x}^{13}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387228b-625c-57a2-b9a5-65db0be7f989" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186513537} {:answer/id #uuid "6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186513823} {:answer/id #uuid "78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{5}+C" :db/id #edb/ref 17592186513850} {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} {:answer/id #uuid "b224165e-2200-5c30-be67-560f8a090e5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{5}+C" :db/id #edb/ref 17592186513998}] :answer-field/correct {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} :answer-field/id #uuid "ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514340}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/math-academy-id "q-29994" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{4}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=4$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}+C \\\\  & =\\frac{{x}^{5}}{5}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{5}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 \\\\ &= \\frac{1}{5}\\cdot 5{x}^{4} \\\\ &= {x}^{4}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186632064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267a0355-2f9b-591a-a5b7-f3122f078c98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186632068} {:answer/id #uuid "284fdc57-cace-5ff2-b2e8-df45d06148e0" :answer/type {:db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186632069} {:answer/id #uuid "2e73719e-1858-5ad9-b105-75906d9dc2a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186632070} {:answer/id #uuid "96e019a9-8f39-5b51-b043-48a8a145a7c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{8}+C" :db/id #edb/ref 17592186632081} {:answer/id #uuid "bbfadeb9-5cb3-5120-b16c-a60acc2bbc47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{7}+C" :db/id #edb/ref 17592186632087}] :answer-field/correct {:answer/id #uuid "267a0355-2f9b-591a-a5b7-f3122f078c98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186632068} :answer-field/id #uuid "7f051dfe-f49c-5b19-bcaf-65f74a79dd8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632078}