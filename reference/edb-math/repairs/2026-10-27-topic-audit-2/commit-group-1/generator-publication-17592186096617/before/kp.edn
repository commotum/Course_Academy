/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232540} :answer-field/id #uuid "4cf0faa2-183e-595b-9158-aab3d3891b84" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232539}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a902a53e-f058-534a-bee4-004868eb968b" :question/math-academy-id "q-310188" :question/problem "Differentiate ${3}^{x}\\operatorname{sin}(x).$\n\n$({3}^{x}\\operatorname{sin}(x))^{'}=$\n{{field-1}} $+\\,{3}^{x}\\operatorname{cos}(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)=\\operatorname{sin}(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({3}^{x}\\operatorname{sin}(x))^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =({3}^{x})^{'}\\cdot \\operatorname{sin}(x)+{3}^{x}\\cdot (\\operatorname{sin}(x))^{'} \\\\  & =({3}^{x}\\operatorname{ln}(3))(\\operatorname{sin}(x))+({3}^{x})(\\operatorname{cos}(x)) \\\\  & ={3}^{x}\\operatorname{ln}(3)\\operatorname{sin}(x)+{3}^{x}\\operatorname{cos}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131acbe9-558d-5eca-b043-6011320bbf1f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232577}] :answer-field/correct {:answer/id #uuid "131acbe9-558d-5eca-b043-6011320bbf1f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232577} :answer-field/id #uuid "db20f675-f846-587b-8b98-472e5b4e4ce4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232576}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "04a32680-52e9-52f1-b831-14d1889bed06" :question/math-academy-id "q-319402" :question/problem "Differentiate $(2-\\operatorname{tan}(x))\\operatorname{cos}(x)$\n\n$((2-\\operatorname{tan}(x))\\operatorname{cos}(x))^{'}=-{sec}^{2}(x)\\operatorname{cos}(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=2-\\operatorname{tan}(x)$ and $v(x)=\\operatorname{cos}(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((2-\\operatorname{tan}(x))\\operatorname{cos}(x))^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =(2-\\operatorname{tan}(x))^{'}\\cdot \\operatorname{cos}(x)+(2-\\operatorname{tan}(x))\\cdot (\\operatorname{cos}(x))^{'} \\\\  & =(-{sec}^{2}(x))(\\operatorname{cos}(x))+(2-\\operatorname{tan}(x))(-\\operatorname{sin}(x)) \\\\  & =-{sec}^{2}(x)\\operatorname{cos}(x)+(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234296 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b5dea81-9340-51d4-993f-9f9ce501ae79" :question/math-academy-id "q-71004" :question/problem "Differentiate ${e}^{x}\\operatorname{sin}x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=\\operatorname{sin}x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}\\operatorname{sin}x)^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =({e}^{x})^{'}\\cdot \\operatorname{sin}x+{e}^{x}\\cdot (\\operatorname{sin}x)^{'} \\\\  & =({e}^{x})(\\operatorname{sin}x)+({e}^{x})(\\operatorname{cos}x) \\\\  & ={e}^{x}\\operatorname{sin}x+{e}^{x}\\operatorname{cos}x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20897b11-31f3-5236-8344-066364ab30aa" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}\\operatorname{cos}x-{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186238339} {:answer/id #uuid "2e9dc0f2-2211-5b4e-a2e7-26a81ec7f21c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}x+\\operatorname{sin}x" :db/id #edb/ref 17592186238465} {:answer/id #uuid "528c811e-a747-5b55-b5c7-a2d707220097" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}x-{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186238765} {:answer/id #uuid "c9cd3281-ae65-5560-8442-2a603e50ff12" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}\\operatorname{cos}x+\\operatorname{sin}x" :db/id #edb/ref 17592186239827} {:answer/id #uuid "cce47b31-03c3-57e4-ae08-02ac34ba2a0c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}x+{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186239848}] :answer-field/correct {:answer/id #uuid "528c811e-a747-5b55-b5c7-a2d707220097" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{cos}x-{e}^{x}\\operatorname{sin}x" :db/id #edb/ref 17592186238765} :answer-field/id #uuid "fe0d6216-93d3-5d7b-aefb-cbdf2e8a0a46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240776}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d7240cf-a773-5ae8-8c7e-03955317789e" :question/math-academy-id "q-104297" :question/problem "Differentiate ${e}^{x}cos⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}cos⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot cos⁡x+{e}^{x}\\cdot (cos⁡x)^{′} \\\\  & =({e}^{x})(cos⁡x)+({e}^{x})(-sin⁡x) \\\\  & ={e}^{x}cos⁡x-{e}^{x}sin⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329a0351-2458-5dc2-afb3-fb83d076e70a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\operatorname{sec}x+{e}^{x}{sec}^{2}x" :db/id #edb/ref 17592186285251} {:answer/id #uuid "3d41ba8e-fd4a-5c5b-8e2c-3eb30e482c53" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}x+{e}^{x}\\operatorname{tan}x" :db/id #edb/ref 17592186285366} {:answer/id #uuid "5b2ff268-76d1-583f-9abe-62b917b9c7eb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{csc}^{2}x+{e}^{x}\\operatorname{tan}x" :db/id #edb/ref 17592186285621} {:answer/id #uuid "93783351-25ff-5c87-8ae9-958c98c327e1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}x+\\operatorname{tan}x" :db/id #edb/ref 17592186286129} {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}x+{e}^{x}\\operatorname{tan}x" :db/id #edb/ref 17592186286945}] :answer-field/correct {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}x+{e}^{x}\\operatorname{tan}x" :db/id #edb/ref 17592186286945} :answer-field/id #uuid "a44b9e2e-ea9e-5094-bc4f-bc781e7df5d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a541e9ea-7fd8-5568-9e5c-f9ef03f5eaf6" :question/math-academy-id "q-1931" :question/problem "Differentiate ${e}^{x}tan⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=tan⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}tan⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot tan⁡x+{e}^{x}\\cdot (tan⁡x)^{′} \\\\  & =({e}^{x})(tan⁡x)+({e}^{x})({sec}^{2}⁡x) \\\\  & ={e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bac31f3f-82dd-5744-9c52-62141c569e1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2+\\operatorname{sin}(x)){e}^{x}" :db/id #edb/ref 17592186298365}] :answer-field/correct {:answer/id #uuid "bac31f3f-82dd-5744-9c52-62141c569e1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2+\\operatorname{sin}(x)){e}^{x}" :db/id #edb/ref 17592186298365} :answer-field/id #uuid "3d13588f-071e-5a52-a869-877b2c497c93" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298845}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c9a55990-04ba-5f4c-bd0b-a335f0aeb15a" :question/math-academy-id "q-319350" :question/problem "Differentiate ${e}^{x}(2+sin⁡(x)).$\n\n$({e}^{x}(2+sin⁡(x)))^{′}=$\n{{field-1}} $+\\,{e}^{x}cos⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=2+sin⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}sec⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot (2+sin⁡(x))+{e}^{x}\\cdot (2+sin⁡(x))^{′} \\\\  & =({e}^{x})(2+sin⁡(x))+({e}^{x})(cos⁡(x)) \\\\  & =(2+sin⁡(x)){e}^{x}+{e}^{x}cos⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70915bcc-86df-54d2-a4fe-50e0b9f25633" :answer/type {:db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}(x)" :db/id #edb/ref 17592186298034}] :answer-field/correct {:answer/id #uuid "70915bcc-86df-54d2-a4fe-50e0b9f25633" :answer/type {:db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}(x)" :db/id #edb/ref 17592186298034} :answer-field/id #uuid "75c11172-6006-5675-abeb-a1bc58910b0a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dca45644-472a-517e-a9dd-987f8f5907bc" :question/math-academy-id "q-319357" :question/problem "Differentiate $2{x}^{2}cos⁡(x).$\n\n$(2{x}^{2}cos⁡(x))^{′}=$\n{{field-1}} $-\\,2{x}^{2}sin⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)=2{x}^{2}$ and $v(x)=cos⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(2{x}^{2}cos⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2{x}^{2})^{′}\\cdot cos⁡(x)+2{x}^{2}\\cdot (cos⁡(x))^{′} \\\\  & =(4x)(cos⁡(x))+(2{x}^{2})(-sin⁡(x)) \\\\  & =4xcos⁡(x)-2{x}^{2}sin⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284d504d-e400-57ba-866e-f8dff66216fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}{sec}^{2}(x)" :db/id #edb/ref 17592186297724}] :answer-field/correct {:answer/id #uuid "284d504d-e400-57ba-866e-f8dff66216fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}{sec}^{2}(x)" :db/id #edb/ref 17592186297724} :answer-field/id #uuid "ecb4d22f-ab7d-5aa3-8db2-cf3a5509f8ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299438}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9df2a3ce-ad57-5588-83d2-42b69ca3314d" :question/math-academy-id "q-319385" :question/problem "Differentiate $\\sqrt{x}tan⁡(x).$\n\n$(\\sqrt{x}tan⁡(x))^{′}=\\frac{tan⁡(x)}{2\\sqrt{x}}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=\\sqrt{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(\\sqrt{x}tan⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\sqrt{x})^{′}\\cdot tan⁡(x)+\\sqrt{x}\\cdot (tan⁡(x))^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}(tan⁡(x))+(\\sqrt{x})({sec}^{2}⁡(x)) \\\\  & =\\frac{tan⁡(x)}{2\\sqrt{x}}+\\sqrt{x}{sec}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51bdb6e8-0d6a-5328-858a-42a6f9dd4e01" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x^{4} + 1\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id