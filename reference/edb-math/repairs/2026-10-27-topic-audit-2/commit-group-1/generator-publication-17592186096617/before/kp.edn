#{[{:db/id #edb/ref 17592186096617 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096417 :question/id #uuid "d7a77a89-0535-54da-a246-36ee5b4e9e7f" :question/math-academy-id "e-3634" :question/problem "Differentiate $x\\cos x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)=x$ and $v(x)=\\cos x .$ So, we apply the product rule:\n\n$$\n\\begin{aligned}\n\t (x\\cos x)' &=   u'(x) \\cdot v(x) + u(x) \\cdot v'(x)\\\\\n\t\t\t\t\t\t&= (x)'\\cdot \\cos x + x\\cdot (\\cos x)'\\\\\n\t\t\t\t\t   & = 1 \\cdot \\cos x + x (-\\sin x)\\\\\n\t\t\t\t\t  & =  \\cos x - x \\sin x\t\t\t\t\t\n\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593 :topic/id #uuid "ac718bb5-4681-5ba0-883a-072801cad492" :topic/knowledge-points [{:db/id #edb/ref 17592186054810} {:db/id #edb/ref 17592186054811} {:db/id #edb/ref 17592186054812} {:db/id #edb/ref 17592186054813}] :topic/math-academy-id 35 :topic/next [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049481}] :topic/title "The Power Rule for Differentiation"} {:db/id #edb/ref 17592186050420 :topic/difficulty 1.0 :topic/id #uuid "476d32c8-5b16-54ef-9688-daca6c7937ad" :topic/knowledge-points [{:db/id #edb/ref 17592186059675} {:db/id #edb/ref 17592186059676}] :topic/math-academy-id 280 :topic/next [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186049070} {:db/id #edb/ref 17592186050902}] :topic/title "Differentiating Trigonometric Functions"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186657608 :question-generator/id #uuid "27e66c71-bd32-5699-8d98-9a02705c8999" :question-generator/script "generators/b7/b7d421723f03b6274183d19c876f284452599df4bdd2b1c8e835514999ea32cc/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097154 :question/answer-fields [{:answer-field/choices [{:answer/id