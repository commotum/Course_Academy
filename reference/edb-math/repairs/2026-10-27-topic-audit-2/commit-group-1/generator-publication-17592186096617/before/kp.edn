\\\\ & =(- 4 x - 2)(\\tan{\\left(x \\right)} + 4)+(- 2 x^{2} - 2 x)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =- 2 x^{2} \\tan^{2}{\\left(x \\right)} - 2 x^{2} - 2 x \\tan^{2}{\\left(x \\right)} - 4 x \\tan{\\left(x \\right)} - 18 x - 2 \\tan{\\left(x \\right)} - 8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46b45ffa-eccb-54d0-a02a-4fbd0b129cee" :answer/type {:db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186530602} {:answer/id #uuid "d980e549-091a-5015-8b0e-d624b7f03f90" :answer/type {:db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} + \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530638} {:answer/id #uuid "dca57a40-855e-5d5c-a548-c9e44f1eff72" :answer/type {:db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} - \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530639} {:answer/id #uuid "ddf3d812-a10d-5ec4-9438-aaed83e97f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530640} {:answer/id #uuid "e90489fd-6700-5f5a-92a2-b8c32b183c48" :answer/type {:db/ident :answer.type/math} :answer/value "6 x \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530644}] :answer-field/correct {:answer/id #uuid "d980e549-091a-5015-8b0e-d624b7f03f90" :answer/type {:db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} + \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530638} :answer-field/id #uuid "642f7201-cb46-5bcf-997b-745a8f3e0236" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530613}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9ff3c61-ade3-53cb-bb8e-71f5650e1f69" :question/problem "Differentiate $(3 x^{2} - 2)(\\sin{\\left(x \\right)}).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=3 x^{2} - 2$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((3 x^{2} - 2)(\\sin{\\left(x \\right)}))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(3 x^{2} - 2)'\\cdot (\\sin{\\left(x \\right)})+(3 x^{2} - 2)\\cdot (\\sin{\\left(x \\right)})' \\\\ & =(6 x)(\\sin{\\left(x \\right)})+(3 x^{2} - 2)(\\cos{\\left(x \\right)}) \\\\ & =3 x^{2} \\cos{\\left(x \\right)} + 6 x \\sin{\\left(x \\right)} - 2 \\cos{\\left(x \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3d46da-e92d-5698-a861-712bac0c6ab4" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} + \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530590} {:answer/id #uuid "3632c38a-4cd9-5c2f-805d-07c3cde69f95" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)}" :db/id #edb/ref 17592186530595} {:answer/id #uuid "409f7463-ac7f-5d70-951f-2793322a406e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530597} {:answer/id #uuid "50e38daf-8b87-563b-9e30-c41d9d3c72b2" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530604} {:answer/id #uuid "731608e7-ebe2-5d8c-b2eb-aae031222ae1" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} - \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530617}] :answer-field/correct {:answer/id #uuid "1e3d46da-e92d-5698-a861-712bac0c6ab4" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} + \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530590} :answer-field/id #uuid "1f592693-d1f1-511c-927a-500d252b11b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530591}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e0089896-05d5-55f1-8924-df3c13fcf733" :question/problem "Differentiate $(- 2 x^{2} - 2)(\\tan{\\left(x \\right)}).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=- 2 x^{2} - 2$ and $v(x)=\\tan{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((- 2 x^{2} - 2)(\\tan{\\left(x \\right)}))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(- 2 x^{2} - 2)'\\cdot (\\tan{\\left(x \\right)})+(- 2 x^{2} - 2)\\cdot (\\tan{\\left(x \\right)})' \\\\ & =(- 4 x)(\\tan{\\left(x \\right)})+(- 2 x^{2} - 2)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =- 2 x^{2} \\tan^{2}{\\left(x \\right)} - 2 x^{2} - 4 x \\tan{\\left(x \\right)} - 2 \\tan^{2}{\\left(x \\right)} - 2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbb081d-8fbf-5577-b042-226064e10be0" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571014} {:answer/id #uuid "a20a9a53-3e6f-5754-8799-d24e521ac2b0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571145} {:answer/id #uuid "a462a7c9-b56d-5b3e-b5f2-01b27202da04" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571149} {:answer/id #uuid "cadbcaa0-5f4b-5598-a6eb-4541c20a3865" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}\\operatorname{cos}⁡x+3{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571202} {:answer/id #uuid "dd2fd5e5-1d32-56a9-b43f-1421f5392621" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571232}] :answer-field/correct {:answer/id #uuid "a462a7c9-b56d-5b3e-b5f2-01b27202da04" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186571149} :answer-field/id #uuid "b4d091bc-16c4-5784-a6c4-28309a12be4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571351}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d8004d91-2319-5283-80d1-a0670d83fdc0" :question/math-academy-id "q-104300" :question/problem "Differentiate ${x}^{3}\\operatorname{cos}⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={x}^{3}$ and $v(x)=\\operatorname{cos}⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({x}^{3}\\operatorname{cos}⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({x}^{3})^{′}\\cdot \\operatorname{cos}⁡x+{x}^{3}\\cdot (\\operatorname{cos}⁡x)^{′} \\\\  & =(3{x}^{2})(\\operatorname{cos}⁡x)+({x}^{3})(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{2}\\operatorname{cos}⁡x-{x}^{3}\\operatorname{sin}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588}] :answer-field/correct {:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588} :answer-field/id #uuid "bd6980db-63b9-58a9-a161-58fba5aeb424" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657603}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "50d8c6ab-86f9-5697-89f9-f6bea58cd673" :question/problem "Differentiate ${6}^{x}\\sin(x).$\n\n$(6^{x} \\sin{\\left(x \\right)})'=$ $6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)}\\,+$ {{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=6^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(6^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(6^{x} \\ln{\\left(6 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})(\\cos{\\left(x \\right)}) \\\\ &=6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(6^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} + 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657589} {:answer/id #uuid "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657593} {:answer/id #uuid "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657596} {:answer/id #uuid "91824e3e-fce8-5d21-847f-ffd4ce485006" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657598} {:answer/id #uuid "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657606}] :answer-field/correct {:answer/id #uuid "91824e3e-fce8-5d21-847f-ffd4ce485006" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657598} :answer-field/id #uuid "8d02748c-91f7-5ad2-96c0-7d5e682d90af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657597}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "703e4f2a-80dd-56c0-a429-ff2cdd1642cc" :question/problem "Differentiate $-2{e}^{x}\\cos x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)=- 2 e^{x}$ and $v(x)=\\cos{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(- 2 e^{x})'\\cdot (\\cos{\\left(x \\right)}) \\\\ &\\quad +(- 2 e^{x})\\cdot (\\cos{\\left(x \\right)})' \\\\ &=(- 2 e^{x})(\\cos{\\left(x \\right)}) \\\\ &\\quad +(- 2 e^{x})(- \\sin{\\left(x \\right)}) \\\\ &=- 2 e^{x} \\cos{\\left(x \\right)} \\\\ &\\quad +(2 e^{x} \\sin{\\left(x \\right)})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9209459-d0a0-5814-98c4-a5e1612da2ce" :answer/type {:db/ident :answer.type/math} :answer/value "7^{x} \\ln{\\left(7 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657602}] :answer-field/correct {:answer/id #uuid "b9209459-d0a0-5814-98c4-a5e1612da2ce" :answer/type {:db/ident :answer.type/math} :answer/value "7^{x} \\ln{\\left(7 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657602} :answer-field/id #uuid "7e16e56f-f02c-5f1e-90e0-65ae4cb3b8c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657595}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a" :question/problem "Differentiate ${7}^{x}\\sin(x).$\n\n$(7^{x} \\sin{\\left(x \\right)})'=$ {{field-1}} $+\\,(7^{x} \\cos{\\left(x \\right)})$" :question/worked-solution "Here, we have the product of the two functions $u(x)=7^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(7^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(7^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(7^{x} \\ln{\\left(7 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(7^{x})(\\cos{\\left(x \\right)}) \\\\ &=7^{x} \\ln{\\left(7 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(7^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09eabf26-4b2d-585b-96c2-4e0f60321ba4" :answer/type {:db/ident :answer.type/math} :answer/value "2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657585}] :answer-field/correct {:answer/id #uuid "09eabf26-4b2d-585b-96c2-4e0f60321ba4" :answer/type {:db/ident :answer.type/math} :answer/value "2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657585} :answer-field/id #uuid "293efc50-8594-596a-afd0-5a8ace505e35" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657590}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a964233-42f7-507e-88f1-773242faeff3" :question/problem "Differentiate ${2}^{x}\\sin(x).$\n\n$(2^{x} \\sin{\\left(x \\right)})'=$ {{field-1}} $+\\,(2^{x} \\cos{\\left(x \\right)})$" :question/worked-solution "Here, we have the product of the two functions $u(x)=2^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(2^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(2^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(2^{x} \\ln{\\left(2 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(2^{x})(\\cos{\\left(x \\right)}) \\\\ &=2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(2^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a72ad92-0572-510c-a84c-dec4304c3869" :answer/type {:db/ident :answer.type/math} :answer/value "x \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657586} {:answer/id #uuid "0a8dc2b2-b760-505e-8750-a531af8c2e58" :answer/type {:db/ident :answer.type/math} :answer/value "- x \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657587} {:answer/id #uuid "9e725352-0b38-5cf6-aab1-701881b3895f" :answer/type {:db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657601} {:answer/id #uuid "d0789108-d518-577b-98ea-59013ba1d132" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657605} {:answer/id #uuid "f17141e2-572c-536c-ac35-fea8aec9bb2a" :answer/type {:db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657607}] :answer-field/correct {:answer/id #uuid "9e725352-0b38-5cf6-aab1-701881b3895f" :answer/type {:db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657601} :answer-field/id #uuid "7952d87e-2c7a-5cf7-8ee8-805c4d7ddf06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657594}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c1cf6b9c-c983-58fe-832e-3f664b5ae8fc" :question/problem "Differentiate $x\\cos{\\left(x \\right)}$." :question/worked-solution "Here, we have the product of the two functions $u(x)=x$ and $v(x)=\\cos{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(x)'\\cdot (\\cos{\\left(x \\right)}) \\\\ &\\quad +(x)\\cdot (\\cos{\\left(x \\right)})' \\\\ &=(1)(\\cos{\\left(x \\right)}) \\\\ &\\quad +(x)(- \\sin{\\left(x \\right)}) \\\\ &=\\cos{\\left(x \\right)} \\\\ &\\quad +(- x \\sin{\\left(x \\right)})\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Product Containing a Trigonometric Function"}]}
