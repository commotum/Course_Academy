ight)})+(4 x^{4} + 1)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =4 x^{4} \\tan^{2}{\\left(x \\right)} + 4 x^{4} + 16 x^{3} \\tan{\\left(x \\right)} + \\tan^{2}{\\left(x \\right)} + 1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87dbb621-b492-5ed9-9fca-744bfb854b9e" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{2} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186530619} {:answer/id #uuid "93229879-9f47-5c4c-aab8-5be46908e80a" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{2} \\sin{\\left(x \\right)} - \\left(4 x^{3} + 4\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530623} {:answer/id #uuid "a75e554b-f8ad-5c6e-86e8-d22ddf113264" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{2} \\sin{\\left(x \\right)} + \\left(4 x^{3} + 4\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530626} {:answer/id #uuid "e3069c21-faeb-5767-9717-d859d3f3104d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x^{3} + 4\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530642} {:answer/id #uuid "f8223218-07f9-52d1-8b1c-5008ed47e978" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{2} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530650}] :answer-field/correct {:answer/id #uuid "a75e554b-f8ad-5c6e-86e8-d22ddf113264" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{2} \\sin{\\left(x \\right)} + \\left(4 x^{3} + 4\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530626} :answer-field/id #uuid "e319cf66-a95b-5175-8d89-f32277bacd56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530643}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "014ac4bb-7a72-5e35-b106-ef044de05a7a" :question/problem "Differentiate $(4 x^{3} + 4)(\\sin{\\left(x \\right)}).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=4 x^{3} + 4$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((4 x^{3} + 4)(\\sin{\\left(x \\right)}))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(4 x^{3} + 4)'\\cdot (\\sin{\\left(x \\right)})+(4 x^{3} + 4)\\cdot (\\sin{\\left(x \\right)})' \\\\ & =(12 x^{2})(\\sin{\\left(x \\right)})+(4 x^{3} + 4)(\\cos{\\left(x \\right)}) \\\\ & =4 x^{3} \\cos{\\left(x \\right)} + 12 x^{2} \\sin{\\left(x \\right)} + 4 \\cos{\\left(x \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186530585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26daf466-ef29-5d18-b4d6-0b19055ad7ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x^{3} + 1\\right) \\left(\\tan{\\left(x \\right)} + 2\\right) + \\left(4 x^{4} + x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530592} {:answer/id #uuid "42486479-f5a7-5637-948a-c46eceaa8bfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4 x^{4} + x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530599} {:answer/id #uuid "4d185028-a8dc-5cf3-b80d-54893105586a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x^{3} + 1\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530603} {:answer/id #uuid "8d8e712e-998c-5923-9a65-60879d820f2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x^{3} + 1\\right) \\left(\\tan{\\left(x \\right)} + 2\\right)" :db/id #edb/ref 17592186530621} {:answer/id #uuid "bd61ff04-8b40-58b9-898f-2e05d4e13a94" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(16 x^{3} + 1\\right) \\left(\\tan{\\left(x \\right)} + 2\\right) - \\left(4 x^{4} + x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530633}] :answer-field/correct {:answer/id #uuid "26daf466-ef29-5d18-b4d6-0b19055ad7ce" :answer/type {:db/ident :answer.type/ma