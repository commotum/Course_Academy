#{[{:db/id #edb/ref 17592186059748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059557 :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A),$ if <div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}3 & 2 \\\\ 5 & 6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix} = ad - bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3 & 2 \\\\ 5 & 6\\end{vmatrix} \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"} :knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048896 :topic/difficulty 0.7206860445301848 :topic/id #uuid "ca183854-66cd-5b1f-9d29-03785c3216b8" :topic/knowledge-points [{:db/id #edb/ref 17592186087693} {:db/id #edb/ref 17592186087694} {:db/id #edb/ref 17592186087713} {:db/id #edb/ref 17592186087819}] :topic/math-academy-id 861 :topic/next [{:db/id #edb/ref 17592186049044} {:db/id #edb/ref 17592186049304} {:db/id #edb/ref 17592186050163} {:db/id #edb/ref 17592186050765}] :topic/title "Introduction to Matrices"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725824 :question-generator/id #uuid "583f9083-31e3-5248-8f16-c3b5d9f71bdf" :question-generator/script "generators/df/df19e95b51fab23ea4decc5f0d4b8237b5c9ada1265cea2abd088042b0472f1b/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bef9d71-e6eb-54e4-8e8e-a529aa8f1992" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241284} {:answer/id #uuid "af58227c-7285-5719-b8ee-6e95dc1218