80} :answer-field/id #uuid "329b94c1-1a26-5ab0-bb5c-9a9653b1dee7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637668}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3d689d20-2d7f-5cf6-a734-7021d15cd1a4" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix} & =9\\cdot 0-2\\cdot 4 \\\\  & =0-8 \\\\  & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186637682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b3e94-0bd5-5035-8182-20219196f3d3" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186637669} {:answer/id #uuid "39c867aa-b4ab-5ff2-b3b1-fc92bbba611e" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186637670} {:answer/id #uuid "3e80d07d-fb89-53af-add5-e737e487017c" :answer/type {:db/ident :answer.type/math} :answer/value "-63" :db/id #edb/ref 17592186637672} {:answer/id #uuid "ce3d33cb-9292-5031-8dc9-fc8ef152a2bb" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186637685} {:answer/id #uuid "d6ba0c04-20d7-5cd0-a238-163b99f4557d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637688}] :answer-field/correct {:answer/id #uuid "387b3e94-0bd5-5035-8182-20219196f3d3" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186637669} :answer-field/id #uuid "142e7bbc-988f-5a9a-a690-a72993edd34d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637665}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9f6cc57d-53af-5dcc-86a6-8248d3858078" :question/problem "Calculate $\\text{det}(M)$, if\n$$\n\\displaystyle M=\\begin{bmatrix}1 & 6 \\\\ -2 & 2\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}1 & 6 \\\\ -2 & 2\\end{vmatrix} \\\\  & =1\\cdot 2-6\\cdot (-2) \\\\  & =2-(-12) \\\\  & =14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186637686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6405c50c-ff58-5a00-bcee-240630cdf904" :answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186637674} {:answer/id #uuid "6a5bbfe0-589a-5f35-a568-bbc754c53a0f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186637678} {:answer/id #uuid "810fb912-9044-5f96-a6cc-135ce7b6e4d6" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186637679} {:answer/id #uuid "d681fed6-c792-5907-ba3d-2ff6e1966f03" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186637687} {:answer/id #uuid "de48e019-0135-5d02-8cf9-3f6e3744f22a" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186637692}] :answer-field/correct {:answer/id #uuid "de48e019-0135-5d02-8cf9-3f6e3744f22a" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186637692} :answer-field/id #uuid "084669d9-78f1-50e8-bacc-4b9a41f1bca0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637664}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d59ae0d7-588c-5848-ab89-a73aadfb2aa7" :question/problem "$$\n\\displaystyle \\begin{vmatrix}7 & 0 \\\\ 5 & 8\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 0 \\\\ 5 & 8\\end{vmatrix} & =7\\cdot 8-0\\cdot 5 \\\\  & =56-0 \\\\  & =56\\end{aligned}\n$$"} {:db/id #edb/ref 17592186637691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b60fe57-3565-5ef0-9f8b-a26c1b2b37ab" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186637667} {:answer/id #uuid "4a0b2e54-b519-51b4-8bdd-53121e73853e" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186637673} {:answer/id #uuid "8fe86f0d-7d4c-5dbe-9e94-707bebaa665c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637681} {:answer/id #uuid "b0239739-5d44-588f-ae6e-54f5c57c830d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186637683} {:answer/id #uuid "b3296a8f-8c5a-5df4-b2b5-5eae55d7b6c2" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186637684}] :answer-field/correct {:answer/id #uuid "8fe86f0d-7d4c-5dbe-9e94-707bebaa665c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637681} :answer-field/id #uuid "64f1bbf2-8a8e-5963-82db-2c55b3372417" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637676}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dcba43ae-7666-52b0-997b-a7c6ac084ccc" :question/problem "Calculate $\\text{det}(X)$, if\n$$\n\\displaystyle X=\\begin{bmatrix}6 & 2 \\\\ 9 & 3\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =\\begin{vmatrix}6 & 2 \\\\ 9 & 3\\end{vmatrix} \\\\  & =6\\cdot 3-2\\cdot 9 \\\\  & =18-18 \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186716935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e312ef-38df-55d0-a292-8e586a713fea" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186716940}] :answer-field/correct {:answer/id #uuid "32e312ef-38df-55d0-a292-8e586a713fea" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186716940} :answer-field/id #uuid "34876873-0a72-5506-82ba-acbbebe653ca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186716943}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "01ca9f59-062c-5d62-a4a1-5d091bddc512" :question/problem "Calculate $\\det(C)$, given that\n\n$$\nC=\\begin{bmatrix}-2 & -3 \\\\ -4 & -5\\end{bmatrix}.\n$$\n\n$\\det(C)=$ {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, multiply the main diagonal entries and subtract the product of the off-diagonal entries:\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nEach diagonal contains two negative entries, so both products are positive. Keep the order: main-diagonal product minus off-diagonal product.\n\nThe determinant can be negative; determinant bars do not mean absolute value.\n\n$$\n\\begin{aligned}\\det(C) &=(-2)(-5)-(-3)(-4) \\\\ &=10-12 \\\\ &=-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186716938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03caa3a5-ae8d-5f2b-9f48-fb424e738839" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186716936} {:answer/id #uuid "05b10cba-f8c9-5089-a296-0732e8cb9e54" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186716937} {:answer/id #uuid "32f75a31-4b5c-5237-bde4-f27a2e1f5a17" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186716941} {:answer/id #uuid "335df867-4021-5b0b-bb1e-478d114bed8d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186716942} {:answer/id #uuid "b40a3b19-da66-5ead-8bcf-931fec634843" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186716948}] :answer-field/correct {:answer/id #uuid "32f75a31-4b5c-5237-bde4-f27a2e1f5a17" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186716941} :answer-field/id #uuid "4c23926e-5529-5d15-8af8-3d8b3e772218" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186716944}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0aa10523-be4a-57fe-9858-f98da39469b6" :question/problem "Calculate $\\det(A)$, given that\n\n$$\nA=\\begin{bmatrix}2 & 1 \\\\ 3 & 4\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, multiply the main diagonal entries and subtract the product of the off-diagonal entries:\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\n![The blue main diagonal gives ad; subtract bc from the red off-diagonal. ](images/25/2594f99e0f02241dc6d01f85c82923103df1d6fb4dda5ca03d438637f5178a28.png)\n\n$$\n\\begin{aligned}\\det(A) &=(2)(4)-(1)(3) \\\\ &=8-3 \\\\ &=5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186716945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94466079-59c9-574e-a114-ce7e2fd929a1" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186716946} {:answer/id #uuid "94e4532c-f041-5571-b77b-826e17dce420" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186716947} {:answer/id #uuid "bfa7b27b-2a84-5cc3-840e-06bf1d8a9950" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186716949} {:answer/id #uuid "d9430131-9b2d-50d8-a884-36c769943088" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186716950} {:answer/id #uuid "ea5ea099-f7c9-573c-9426-c7b32f0c040e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186716951}] :answer-field/correct {:answer/id #uuid "ea5ea099-f7c9-573c-9426-c7b32f0c040e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186716951} :answer-field/id #uuid "1ccb7a7d-cec7-57f9-b016-76cbedd45391" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186716939}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "58f6ea98-a4e7-583f-b58c-838a38934da5" :question/problem "Calculate $\\det(B)$, given that\n\n$$\nB=\\begin{bmatrix}2 & 3 \\\\ -4 & 1\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, multiply the main diagonal entries and subtract the product of the off-diagonal entries:\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nThe off-diagonal product is negative: $(3)(-4)=-12$. Subtracting this negative product adds $12$.\n\n$$\n\\begin{aligned}\\det(B) &=(2)(1)-(3)(-4) \\\\ &=2-(-12) \\\\ &=2+12 \\\\ &=14.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}]}
