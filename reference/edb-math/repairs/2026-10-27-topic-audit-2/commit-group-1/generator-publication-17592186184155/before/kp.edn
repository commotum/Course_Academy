e $t\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 5t^{5}-6\\sqrt[5]{t^{2}}+\\frac{3}{t^{4}}\\,\\mathrm{d}t\\\\ &= \\int\\left(5t^{5}-6t^{\\frac{2}{5}}+\\frac{3}{t^{4}}\\right)\\,\\mathrm{d}t\\\\ &= 5\\int t^{5}\\,\\mathrm{d}t-6\\int t^{\\frac{2}{5}}\\,\\mathrm{d}t+3\\int t^{-4}\\,\\mathrm{d}t\\\\ &= 5\\left(\\frac{t^{6}}{6}\\right)-6\\left(\\frac{t^{\\frac{7}{5}}}{\\frac{7}{5}}\\right)+3\\left(\\frac{t^{-3}}{-3}\\right)+C\\\\ &= \\frac{5t^{6}}{6}-\\frac{30\\sqrt[5]{t^{7}}}{7}-\\frac{1}{t^{3}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a58fa2e0-bb9d-57aa-8b0d-a083653bd13b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{28}{\\sqrt[7]{x}}-\\frac{x^{6}}{3}+C" :db/id #edb/ref 17592186671240} {:answer/id #uuid "b41e3497-a1ec-508c-81da-14b427efb021" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{x}+\\frac{7}{\\sqrt[7]{x}}-\\frac{2x^{6}}{3}+C" :db/id #edb/ref 17592186671248} {:answer/id #uuid "c3da1017-dacc-56f9-a8cb-67ad390dd037" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C" :db/id #edb/ref 17592186671255} {:answer/id #uuid "efaeb280-074e-588b-9790-77fa3239ae8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{x^{6}}{2}+C" :db/id #edb/ref 17592186671276} {:answer/id #uuid "f09222c2-6c0f-5c18-a7a3-b0aa261fa091" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{x}+\\frac{21}{\\sqrt[7]{x}}-\\frac{2x^{6}}{3}+C" :db/id #edb/ref 17592186671277}] :answer-field/correct {:answer/id #uuid "c3da1017-dacc-56f9-a8cb-67ad390dd037" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C" :db/id #edb/ref 17592186671255} :answer-field/id #uuid "72da992f-ab95-5a91-b965-6e0d593120e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671300}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ef445d49-180b-5e2d-afaa-378951f5a7d2" :question/problem "Calculate $$\n\\displaystyle\\int \\frac{3}{x^{2}}-\\frac{2}{\\sqrt[7]{x^{8}}}-5x^{5}\\,\\mathrm{d}x.\n$$ Assume $x\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\frac{3}{x^{2}}-\\frac{2}{\\sqrt[7]{x^{8}}}-5x^{5}\\,\\mathrm{d}x\\\\ &= \\int\\left(\\frac{3}{x^{2}}-\\frac{2}{x^{\\frac{8}{7}}}-5x^{5}\\right)\\,\\mathrm{d}x\\\\ &= 3\\int x^{-2}\\,\\mathrm{d}x-2\\int x^{-\\frac{8}{7}}\\,\\mathrm{d}x-5\\int x^{5}\\,\\mathrm{d}x\\\\ &= 3\\left(\\frac{x^{-1}}{-1}\\right)-2\\left(\\frac{x^{-\\frac{1}{7}}}{-\\frac{1}{7}}\\right)-5\\left(\\frac{x^{6}}{6}\\right)+C\\\\ &= -\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186671348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29775553-08f2-568d-aadc-5e12973d0a43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{3}+3x^{2}+x+C" :db/id #edb/ref 17592186671190} {:answer/id #uuid "5423bd1a-105e-5b13-9d86-923699913f6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671208} {:answer/id #uuid "751e857e-3583-5e12-af08-41a2b7b6478c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x^{3}}{3}+2x^{2}+x+C" :db/id #edb/ref 17592186671221} {:answer/id #uuid "e49bce56-1551-5c16-9c86-b3857303a9aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671272} {:answer/id #uuid "faa25c1c-b9d1-547d-9229-3e912ae73050" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}+3x^{2}+x+C" :db/id #edb/ref 17592186671286}] :answer-field/correct {:answer/id #uuid "5423bd1a-105e-5b13-9d86-923699913f6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671208} :answer-field/id #uuid "2761d594-ddb2-5e7c-a1a5-4974c969f73d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671293}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4653c6b-10c6-560d-9991-2e184a7cf8dc" :question/problem "Calculate $$\n\\displaystyle\\int 5x^{2}+2x+1\\,\\mathrm{d}x.\n$$" :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 5x^{2}+2x+1\\,\\mathrm{d}x\\\\ &= \\int\\left(5x^{2}+2x+1\\right)\\,\\mathrm{d}x\\\\ &= 5\\int x^{2}\\,\\mathrm{d}x+2\\int x^{1}\\,\\mathrm{d}x+\\int x^{0}\\,\\mathrm{d}x\\\\ &= 5\\left(\\frac{x^{3}}{3}\\right)+2\\left(\\frac{x^{2}}{2}\\right)+\\left(\\frac{x^{1}}{1}\\right)+C\\\\ &= \\frac{5x^{3}}{3}+x^{2}+x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186680888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c95a787-73e0-53e0-a2bc-fd2f5c520a97" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3}}-\\frac{2x^{3}}{3}+4+C" :db/id #edb/ref 17592186680880} {:answer/id #uuid "3cb7024c-0c82-515b-bcd5-ad57b3bbc5fe" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3}}+\\frac{2x^{3}}{3}+4x+C" :db/id #edb/ref 17592186680882} {:answer/id #uuid "56840ca7-616b-5c9c-9749-4b1997c49228" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{x^{3}}}{2}-\\frac{2x^{3}}{3}+4x+C" :db/id #edb/ref 17592186680884} {:answer/id #uuid "99573cbe-11f8-5be8-b1bb-abfae0590262" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3}}-\\frac{2x^{3}}{3}+4x+C" :db/id #edb/ref 17592186680891} {:answer/id #uuid "e3be435d-9efa-52dd-9c61-dbf33fa8d774" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3}}-2x^{3}+4x+C" :db/id #edb/ref 17592186680898}] :answer-field/correct {:answer/id #uuid "99573cbe-11f8-5be8-b1bb-abfae0590262" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3}}-\\frac{2x^{3}}{3}+4x+C" :db/id #edb/ref 17592186680891} :answer-field/id #uuid "9b273a10-e35d-5655-bcb3-3800e3205664" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680892}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "819846e6-bc40-53d0-9281-b1774d161401" :question/problem "Calculate the indefinite integral for $x>0$.\n\n$$\n\\int (3\\sqrt{x}-2x^{2}+4)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Rewrite the radical as a power: $\\sqrt{x}=x^{1/2}$. Then use the sum, constant factor, and power rules:\n\n$$\n\\begin{aligned}\n&\\int (3\\sqrt{x}-2x^{2}+4)\\,\\mathrm{d}x \\\\\n&=3\\int x^{1/2}\\,\\mathrm{d}x-2\\int x^{2}\\,\\mathrm{d}x+4\\int 1\\,\\mathrm{d}x \\\\\n&=3\\left(\\frac{x^{3/2}}{3/2}\\right)-2\\left(\\frac{x^{3}}{3}\\right)+4x+C \\\\\n&=2x^{3/2}-\\frac{2x^{3}}{3}+4x+C \\\\\n&=2\\sqrt{x^{3}}-\\frac{2x^{3}}{3}+4x+C.\n\\end{aligned}\n$$\n\nDividing by $3/2$ multiplies by $2/3$. For $x>0$, $x^{3/2}=\\sqrt{x^{3}}$. Differentiating the result gives $3\\sqrt{x}-2x^{2}+4$."} {:db/id #edb/ref 17592186680894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aa1e6a4-44ca-59c7-a559-74398283496e" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{3}-x^{2}+4x+C" :db/id #edb/ref 17592186680883} {:answer/id #uuid "5a5cb199-f7ca-5f9d-bd10-2fd49abe6fb3" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}-x^{2}+4+C" :db/id #edb/ref 17592186680885} {:answer/id #uuid "605915e4-484c-5f14-82bb-77ffefa4ac3a" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}-2x^{2}+4x+C" :db/id #edb/ref 17592186680886} {:answer/id #uuid "878e53ed-3c6b-5a25-aca9-6d4fd86a336d" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}+x^{2}+4x+C" :db/id #edb/ref 17592186680890} {:answer/id #uuid "d7086787-9065-55c4-9027-98eb6867477f" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}-x^{2}+4x+C" :db/id #edb/ref 17592186680897}] :answer-field/correct {:answer/id #uuid "d7086787-9065-55c4-9027-98eb6867477f" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3}-x^{2}+4x+C" :db/id #edb/ref 17592186680897} :answer-field/id #uuid "376eee18-d597-518c-a31e-4aa80a894e39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b86dd312-0882-5996-8023-e03328823cb1" :question/problem "Calculate the indefinite integral.\n\n$$\n\\int (3x^{2}-2x+4)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Use the sum and constant factor rules to integrate each term. For each power, add one to the exponent and divide by the new exponent:\n\n$$\n\\begin{aligned}\n&\\int (3x^{2}-2x+4)\\,\\mathrm{d}x \\\\\n&=3\\int x^{2}\\,\\mathrm{d}x-2\\int x\\,\\mathrm{d}x+4\\int 1\\,\\mathrm{d}x \\\\\n&=3\\left(\\frac{x^{3}}{3}\\right)-2\\left(\\frac{x^{2}}{2}\\right)+4x+C \\\\\n&=x^{3}-x^{2}+4x+C.\n\\end{aligned}\n$$\n\nThe constant term integrates to $4x$, and the arbitrary constants combine into one $C$. Differentiating $x^{3}-x^{2}+4x+C$ gives $3x^{2}-2x+4$."} {:db/id #edb/ref 17592186680899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb57791-746c-57d4-ae17-9b7ce25d4505" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{\\sqrt[3]{x}}-x^{3}-\\frac{4}{x}+C" :db/id #edb/ref 17592186680879} {:answer/id #uuid "6f2ff63c-3b6f-5e48-92fd-a6bbd4631fe6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{\\sqrt[3]{x}}-3x^{3}-\\frac{4}{x}+C" :db/id #edb/ref 17592186680887} {:answer/id #uuid "836450ab-8281-5391-a5a9-5a354f0729c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{\\sqrt[3]{x}}-x^{3}+\\frac{4}{x}+C" :db/id #edb/ref 17592186680889} {:answer/id #uuid "a7ecfa91-4b36-5a28-ab8c-3858d392c177" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3\\sqrt[3]{x}}-x^{3}-\\frac{4}{x}+C" :db/id #edb/ref 17592186680893} {:answer/id #uuid "d4b970a4-7080-592a-8969-6926f8811729" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt[3]{x}}-x^{3}-\\frac{4}{x}+C" :db/id #edb/ref 17592186680896}] :answer-field/correct {:answer/id #uuid "0eb57791-746c-57d4-ae17-9b7ce25d4505" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{\\sqrt[3]{x}}-x^{3}-\\frac{4}{x}+C" :db/id #edb/ref 17592186680879} :answer-field/id #uuid "c3c87629-4d42-5af3-9ce2-43baaf7ee2ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186680895}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fe02c1b7-b222-56b6-a00c-48f7d3abd8ce" :question/problem "Calculate the indefinite integral for $x>0$.\n\n$$\n\\int \\left(\\frac{2}{\\sqrt[3]{x^{4}}}-3x^{2}+\\frac{4}{x^{2}}\\right)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Write the reciprocal powers as $2x^{-4/3}$ and $4x^{-2}$. The sum and constant factor rules give\n\n$$\n\\begin{aligned}\n&\\int \\left(\\frac{2}{\\sqrt[3]{x^{4}}}-3x^{2}+\\frac{4}{x^{2}}\\right)\\,\\mathrm{d}x \\\\\n&=2\\int x^{-4/3}\\,\\mathrm{d}x-3\\int x^{2}\\,\\mathrm{d}x+4\\int x^{-2}\\,\\mathrm{d}x \\\\\n&=2\\left(\\frac{x^{-1/3}}{-1/3}\\right)-3\\left(\\frac{x^{3}}{3}\\right)+4\\left(\\frac{x^{-1}}{-1}\\right)+C \\\\\n&=-6x^{-1/3}-x^{3}-4x^{-1}+C \\\\\n&=-\\frac{6}{\\sqrt[3]{x}}-x^{3}-\\frac{4}{x}+C.\n\\end{aligned}\n$$\n\nHere $-4/3+1=-1/3$ and $-2+1=-1$. Dividing by these negative exponents makes both reciprocal contributions negative. As a check, differentiating the result gives $2x^{-4/3}-3x^{2}+4x^{-2}$, the original integrand."} {:db/id #edb/ref 17592186681140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28dbb091-f1c8-535f-93e4-ff0cd0ad3a76" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{t^{3}}}{3}-t^{3}-3t+C" :db/id #edb/ref 17592186681139} {:answer/id #uuid "d29bc728-ba4b-5544-ba12-93dee556ff33" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\sqrt{t^{3}}}{3}-2t^{3}-3t+C" :db/id #edb/ref 17592186681141} {:answer/id #uuid "d42b1edd-ff40-5b87-86b4-e3a728f2757f" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{t^{3}}-2t^{3}-3t+C" :db/id #edb/ref 17592186681142} {:answer/id #uuid "f6407384-9ab7-55d3-84fd-14bcb386f979" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{t^{3}}-\\frac{4t^{3}}{3}-3t+C" :db/id #edb/ref 17592186681144} {:answer/id #uuid "f7f7a97e-11e8-5f16-ac5c-8bf113da83fd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\sqrt{t^{3}}}{3}-\\frac{2t^{3}}{3}-3t+C" :db/id #edb/ref 17592186681145}] :answer-field/correct {:answer/id #uuid "f6407384-9ab7-55d3-84fd-14bcb386f979" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{t^{3}}-\\frac{4t^{3}}{3}-3t+C" :db/id #edb/ref 17592186681144} :answer-field/id #uuid "e94871a4-cc38-549b-9089-40f0053b3d0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186681143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7dbfae1c-a39c-5316-9573-87647a29f09c" :question/problem "Calculate \n\n$$\n\\displaystyle\\int -6\\sqrt{t}-4t^{2}-3\\,\\mathrm{d}t\n$$\n\n. Assume $t>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -6\\sqrt{t}-4t^{2}-3\\,\\mathrm{d}t\\\\ &= \\int\\left(-6t^{\\frac{1}{2}}-4t^{2}-3\\right)\\,\\mathrm{d}t\\\\ &= -6\\int t^{\\frac{1}{2}}\\,\\mathrm{d}t-4\\int t^{2}\\,\\mathrm{d}t-3\\int t^{0}\\,\\mathrm{d}t\\\\ &= -6\\left(\\frac{t^{\\frac{3}{2}}}{\\frac{3}{2}}\\right)-4\\left(\\frac{t^{3}}{3}\\right)-3\\left(\\frac{t^{1}}{1}\\right)+C\\\\ &= -4\\sqrt{t^{3}}-\\frac{4t^{3}}{3}-3t+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186694585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dd3ca9a-2fa5-5646-8039-a52d1322d686" :answer/type {:db/ident :answer.type/math} :answer/value "-x+\\frac{x^{2}}{2}-x^{3}+C" :db/id #edb/ref 17592186694587} {:answer/id #uuid "7e8a106d-5ff1-5391-bc33-b47d09451942" :answer/type {:db/ident :answer.type/math} :answer/value "-x+x^{2}-9x^{3}+C" :db/id #edb/ref 17592186694594} {:answer/id #uuid "8572be7a-89bc-5456-9f7e-2e687c6d63c7" :answer/type {:db/ident :answer.type/math} :answer/value "-x+x^{2}-3x^{3}+C" :db/id #edb/ref 17592186694595} {:answer/id #uuid "8dd3cf30-9c51-5864-a628-bed2bcd74af6" :answer/type {:db/ident :answer.type/math} :answer/value "-x+2x^{2}-x^{3}+C" :db/id #edb/ref 17592186694597} {:answer/id #uuid "b721477b-145f-591c-8026-153465172b48" :answer/type {:db/ident :answer.type/math} :answer/value "-x+\\frac{x^{2}}{2}-9x^{3}+C" :db/id #edb/ref 17592186694599}] :answer-field/correct {:answer/id #uuid "3dd3ca9a-2fa5-5646-8039-a52d1322d686" :answer/type {:db/ident :answer.type/math} :answer/value "-x+\\frac{x^{2}}{2}-x^{3}+C" :db/id #edb/ref 17592186694587} :answer-field/id #uuid "e5e82a5a-a0ff-5521-a711-90b4b0fac5ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694604}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "399175f2-93ca-5250-86bb-3a20cf620740" :question/problem "Calculate \n\n$$\n\\displaystyle\\int -1+x-3x^{2}\\,\\mathrm{d}x\n$$\n\n." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -1+x-3x^{2}\\,\\mathrm{d}x\\\\ &= \\int\\left(-1+x-3x^{2}\\right)\\,\\mathrm{d}x\\\\ &= -\\int x^{0}\\,\\mathrm{d}x+\\int x^{1}\\,\\mathrm{d}x-3\\int x^{2}\\,\\mathrm{d}x\\\\ &= -\\left(\\frac{x^{1}}{1}\\right)+\\left(\\frac{x^{2}}{2}\\right)-3\\left(\\frac{x^{3}}{3}\\right)+C\\\\ &= -x+\\frac{x^{2}}{2}-x^{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186694590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b21357-3794-5397-8ab2-215fd3080ad0" :answer/type {:db/ident :answer.type/math} :answer/value "3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C" :db/id #edb/ref 17592186694584} {:answer/id #uuid "abb4713e-f711-5df2-9e16-3e1f41398918" :answer/type {:db/ident :answer.type/math} :answer/value "3t+2t^{2}-\\frac{t^{3}}{9}+C" :db/id #edb/ref 17592186694598} {:answer/id #uuid "c4e738fd-1e63-5ba9-87d9-2d09a05ed9fe" :answer/type {:db/ident :answer.type/math} :answer/value "3t+2t^{2}-t^{3}+C" :db/id #edb/ref 17592186694600} {:answer/id #uuid "dcb53271-9cdf-5699-95b0-c8752933fd74" :answer/type {:db/ident :answer.type/math} :answer/value "3t+t^{2}-\\frac{t^{3}}{2}+C" :db/id #edb/ref 17592186694603} {:answer/id #uuid "f453948d-5af0-55c6-8a0d-2d73ddebb938" :answer/type {:db/ident :answer.type/math} :answer/value "3t+2t^{2}-\\frac{t^{3}}{2}+C" :db/id #edb/ref 17592186694605}] :answer-field/correct {:answer/id #uuid "38b21357-3794-5397-8ab2-215fd3080ad0" :answer/type {:db/ident :answer.type/math} :answer/value "3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C" :db/id #edb/ref 17592186694584} :answer-field/id #uuid "f4875fd9-13c5-511c-8e3f-799dec40e586" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694606}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5f0c2e42-cfda-5be2-86fd-64f843e311af" :question/problem "Calculate \n\n$$\n\\displaystyle\\int 3+t-t^{2}\\,\\mathrm{d}t\n$$\n\n." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 3+t-t^{2}\\,\\mathrm{d}t\\\\ &= \\int\\left(3+t-t^{2}\\right)\\,\\mathrm{d}t\\\\ &= 3\\int t^{0}\\,\\mathrm{d}t+\\int t^{1}\\,\\mathrm{d}t-\\int t^{2}\\,\\mathrm{d}t\\\\ &= 3\\left(\\frac{t^{1}}{1}\\right)+\\left(\\frac{t^{2}}{2}\\right)-\\left(\\frac{t^{3}}{3}\\right)+C\\\\ &= 3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186694596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5fd084-9d7f-5153-a98b-e2de0f6e7d5c" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-x^{2}-6x^{3}+C" :db/id #edb/ref 17592186694586} {:answer/id #uuid "48d8fa01-9a5e-5ba9-9929-526e5b630cee" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-6x^{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694588} {:answer/id #uuid "66b45656-64af-5bbe-b667-56330afb0a67" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{x^{3}}{2}+C" :db/id #edb/ref 17592186694592} {:answer/id #uuid "c6c5c04f-0ca4-513c-a6f0-d3e8fcd76cf3" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-\\frac{x^{2}}{2}-6x^{3}+C" :db/id #edb/ref 17592186694601} {:answer/id #uuid "f780f595-be59-5d41-a075-8f59d1b3e36c" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694607}] :answer-field/correct {:answer/id #uuid "f780f595-be59-5d41-a075-8f59d1b3e36c" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694607} :answer-field/id #uuid "1c247750-8339-5171-a140-817d98ba604b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694581}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "88b12f38-c5a8-542a-aaa9-ec2417d7827f" :question/problem "Calculate \n\n$$\n\\displaystyle\\int -3-3x-2x^{2}\\,\\mathrm{d}x\n$$\n\n." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -3-3x-2x^{2}\\,\\mathrm{d}x\\\\ &= \\int\\left(-3-3x-2x^{2}\\right)\\,\\mathrm{d}x\\\\ &= -3\\int x^{0}\\,\\mathrm{d}x-3\\int x^{1}\\,\\mathrm{d}x-2\\int x^{2}\\,\\mathrm{d}x\\\\ &= -3\\left(\\frac{x^{1}}{1}\\right)-3\\left(\\frac{x^{2}}{2}\\right)-2\\left(\\frac{x^{3}}{3}\\right)+C\\\\ &= -3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186694602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15265082-0fd8-5334-9ba9-a1364611e7f3" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-2t^{3}+2t^{2}+C" :db/id #edb/ref 17592186694580} {:answer/id #uuid "220b34a1-e3e8-527e-bf2a-987e01ac8635" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{2}+\\frac{2t^{2}}{3}+C" :db/id #edb/ref 17592186694582} {:answer/id #uuid "346a47bd-8486-542b-8adc-b4a3d97798e0" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-\\frac{2t^{3}}{3}+t^{2}+C" :db/id #edb/ref 17592186694583} {:answer/id #uuid "4a5a911b-d4b5-5bed-b43b-6c15cdee07fa" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{3}+2t^{2}+C" :db/id #edb/ref 17592186694589} {:answer/id #uuid "7690799c-1c5f-5dc4-80be-d8d7d3d85e4c" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{2}+t^{2}+C" :db/id #edb/ref 17592186694593}] :answer-field/correct {:answer/id #uuid "346a47bd-8486-542b-8adc-b4a3d97798e0" :answer/type {:db/ident :answer.type/math} :answer/value "-3t-\\frac{2t^{3}}{3}+t^{2}+C" :db/id #edb/ref 17592186694583} :answer-field/id #uuid "5fc2619e-8f2c-5fdd-a356-538d29105291" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694591}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cdf2cb5b-3ce5-5240-9b96-6cc74e5dfa50" :question/problem "Calculate \n\n$$\n\\displaystyle\\int -3-2t^{2}+2t\\,\\mathrm{d}t\n$$\n\n." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -3-2t^{2}+2t\\,\\mathrm{d}t\\\\ &= \\int\\left(-3-2t^{2}+2t\\right)\\,\\mathrm{d}t\\\\ &= -3\\int t^{0}\\,\\mathrm{d}t-2\\int t^{2}\\,\\mathrm{d}t+2\\int t^{1}\\,\\mathrm{d}t\\\\ &= -3\\left(\\frac{t^{1}}{1}\\right)-2\\left(\\frac{t^{3}}{3}\\right)+2\\left(\\frac{t^{2}}{2}\\right)+C\\\\ &= -3t-\\frac{2t^{3}}{3}+t^{2}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Sums of Power Functions"}]}
