  "before_edn": "{:db/id 17592186176047 :knowledge-point/canonical-example {:db/id 17592186175693 :question/id #uuid \"70569afd-42c4-5e5f-8397-4fbd873eb8e4\" :question/math-academy-id \"e-11002\" :question/problem \"Which of the following statements are true regarding the function $y=\\\\cos x?$ Assume that $n$ is an integer.\\n\\n- The range of the function is $[-1,1].$\\n\\n- The function has minimum values at $x =n\\\\pi.$\\n\\n- The function intersects the $x$-axis at $x=\\\\dfrac{\\\\pi}{2} +\\\\pi n.$\" :question/worked-solution \"First, let's plot the graph of $y=\\\\cos{x}.$\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nNow, let's go through each statement.\\n\\n- Statement I is true. The minimum value is $-1,$ and the maximum value is $1.$ Therefore, the range is $[-1,1].$\\n\\n- Statement II is false. The function has a minimum at $x=\\\\pi$ and the period is $2\\\\pi.$ Therefore, the minimum values occur at $\\\\pi+2n\\\\pi.$\\n\\n- Statement III is true. These are the zeros of the cosine curve. The cosine curve has zeros at $x=\\\\dfrac{\\\\pi}{2} + n\\\\pi.$\\n\\nIn conclusion, only statements I and III are true.\"} :knowledge-point/id #uuid \"542df339-5020-5680-a39c-a1ae161083e7\" :knowledge-point/key-prerequisites [{:db/id 17592186050033 :topic/id #uuid \"27991def-afa0-5245-84f6-cb161dd1a2bc\" :topic/knowledge-points [{:db/id 17592186152178} {:db/id 17592186152216} {:db/id 17592186152217} {:db/id 17592186152218}] :topic/math-academy-id 2707 :topic/next [{:db/id 17592186049075} {:db/id 17592186049091} {:db/id 17592186050172} {:db/id 17592186050713}] :topic/title \"Local Extrema of Functions\"} {:db/id 17592186050718 :topic/id #uuid \"61092d2e-5ae6-5f60-8a88-2299822508ec\" :topic/knowledge-points [{:db/id 17592186110576} {:db/id 17592186110577} {:db/id 17592186110578} {:db/id 17592186110579}] :topic/math-academy-id 1491 :topic/next [{:db/id 17592186048402} {:db/id 17592186048595} {:db/id 17592186048647} {:db/id 17592186048794} {:db/id 17592186049075} {:db/id 17592186049091} {:db/id 17592186049568} {:db/id 17592186049726} {:db/id 17592186050064} {:db/id 17592186050172} {:db/id 17592186050533} {:db/id 17592186051035}] :topic/title \"Graphing Sine and Cosine\"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186512082 :question-generator/id #uuid \"ff84f499-32ec-5d9a-a113-5cf2393a4476\" :question-generator/script \"generate/scratch/17592186176047.py\"} :knowledge-point/questions [{:db/id 17592186176448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d3b87e3a-d17f-5d16-a9ee-8bdda6d42f5f\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439603} {:answer/id #uuid \"87018b61-01ec-510f-8fd1-7d6db056af27\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439604}] :answer-field/correct {:answer/id #uuid \"d3b87e3a-d17f-5d16-a9ee-8bdda6d42f5f\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439603} :answer-field/id #uuid \"d542c682-d8b5-5051-a7cb-60f1509b7b1e\" :answer-field/key \"The function has maximum values at $x = \\\\frac{π}{2} + nπ$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440159} {:answer-field/choices [{:answer/id #uuid \"5d64fb74-88cb-53a7-a06c-3b70bb7f6274\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439605} {:answer/id #uuid \"bec31bb0-4e5d-511d-afd5-742b83de0357\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439606}] :answer-field/correct {:answer/id #uuid \"bec31bb0-4e5d-511d-afd5-742b83de0357\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439606} :answer-field/id #uuid \"b87c1b9b-fab1-5cdf-bb7d-886d867b3796\" :answer-field/key \"The function is zero at $x = \\\\frac{3π}{2}$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440160} {:answer-field/choices [{:answer/id #uuid \"f33342a6-71e7-55a1-88ba-63522644016c\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439607} {:answer/id #uuid \"b683d925-eb8f-5ed2-85c9-33a9d51ed2a5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439608}] :answer-field/correct {:answer/id #uuid \"f33342a6-71e7-55a1-88ba-63522644016c\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439607} :answer-field/id #uuid \"02f59618-0384-53ab-a17c-8912c7664860\" :answer-field/key \"The range of the function is $[- π, π]$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440161}] :question/id #uuid \"3291f5a6-141c-577f-9e01-4f06e16f89ac\" :question/math-academy-id \"q-27015\" :question/problem \"Which of the following statements are true regarding the function $y = \\\\cos x$? Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Cosine attains its maxima at x=2n*pi, vanishes at x=3pi/2, and has range [-1,1]. Only statement “The function is zero at $x = \\\\frac{3π}{2}$” is true.\"} {:db/id 17592186176449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"68a428aa-620c-537b-bed4-6525636bfc6b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439609} {:answer/id #uuid \"a2bdaabe-318f-5a44-a993-5dc144a01cc7\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439610}] :answer-field/correct {:answer/id #uuid \"a2bdaabe-318f-5a44-a993-5dc144a01cc7\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439610} :answer-field/id #uuid \"c19eff62-0f3d-5e8b-8840-f4fa3fa30937\" :answer-field/key \"The zeros of the function are $x = \\\\frac{π}{2} + nπ$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440162} {:answer-field/choices [{:answer/id #uuid \"9e122d41-3d05-51c1-8ec6-c73fbca7dcd6\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439611} {:answer/id #uuid \"2ab71ce6-dc10-5b55-86c4-8863ebadb312\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439612}] :answer-field/correct {:answer/id #uuid \"9e122d41-3d05-51c1-8ec6-c73fbca7dcd6\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439611} :answer-field/id #uuid \"12845eb8-7a86-57fa-a87d-28447fbed3a1\" :answer-field/key \"The function has maximum values at $x = \\\\frac{3π}{2} + 2nπ$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440163} {:answer-field/choices [{:answer/id #uuid \"c69287cc-e1d6-5913-b9fc-cfeb0e6876ad\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439613} {:answer/id #uuid \"433b23fc-2e50-5918-ad8e-38d59e8d6077\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186439614}] :answer-field/correct {:answer/id #uuid \"c69287cc-e1d6-5913-b9fc-cfeb0e6876ad\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186439613} :answer-field/id #uuid \"a99ea223-df14-549f-8f0a-56f14ff03cc4\" :answer-field/key \"The range of $y = \\\\cos x$ is $[- 1, 0]$.\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440164}] :question/id #uuid \"4431905d-f46d-548a-987b-b6164fd2cc5d\" :question/math-academy-id \"q-27021\" :question/problem \"Which of the following statements are true regarding the function $y = \\\\cos x$? Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Cosine has zeros at x=pi/2+n*pi. At x=3pi/2+2n*pi it is zero, not maximal, and its range is [-1,1]. Only “The zeros of the function are $x = \\\\frac{π}{2} + nπ$” is true.\"} {:db/id 17592186235452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"fbd74cf7-7832-5d4d-9bdb-4352f71d9f85\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186234944}] :answer-field/correct {:answer/id #uuid \"fbd74cf7-7832-5d4d-9bdb-4352f71d9f85\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186234944} :answer-field/id #uuid \"6614a1f6-a87a-5480-bfb4-b31cd6dddad3\" :answer-field/key \"field-3\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235080} {:answer-field/choices [{:answer/id #uuid \"44c736f2-25bd-5d43-acf7-389cd352b94b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\pi \" :db/id 17592186234650}] :answer-field/correct {:answer/id #uuid \"44c736f2-25bd-5d43-acf7-389cd352b94b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\pi \" :db/id 17592186234650} :answer-field/id #uuid \"86dd5a39-356d-58f6-a814-f6ba7ef31193\" :answer-field/key \"field-5\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235139} {:answer-field/choices [{:answer/id #uuid \"bd151ce5-c877-5cb0-954c-57ccd397f03f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\infty \" :db/id 17592186234837}] :answer-field/correct {:answer/id #uuid \"bd151ce5-c877-5cb0-954c-57ccd397f03f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\infty \" :db/id 17592186234837} :answer-field/id #uuid \"8fb953ef-938a-5b5b-99c5-5fa2a0878578\" :answer-field/key \"field-2\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235145} {:answer-field/choices [{:answer/id #uuid \"80153a7b-80ae-54f5-b4ee-35a981cc0cb2\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186234740}] :answer-field/correct {:answer/id #uuid \"80153a7b-80ae-54f5-b4ee-35a981cc0cb2\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186234740} :answer-field/id #uuid \"914f87c0-b0d8-5ddd-be80-6c4d6303ec75\" :answer-field/key \"field-4\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235147} {:answer-field/choices [{:answer/id #uuid \"fb796ec5-fb4b-5f50-95bf-f4781e9dc4c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\infty \" :db/id 17592186234943}] :answer-field/correct {:answer/id #uuid \"fb796ec5-fb4b-5f50-95bf-f4781e9dc4c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\infty \" :db/id 17592186234943} :answer-field/id #uuid \"ed723404-e7d9-5542-afad-7590ee940dcb\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235255}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ed1a25d3-8778-5a6a-8c12-425fa1c7957d\" :question/math-academy-id \"q-167631\" :question/problem \"Complete the following facts about the function $y=sin⁡x.$\\n\\n                            \\n                                    \\n                                        \\n                                            \\n\\n                                                \\n\\n                                        \\n                                        \\n                                        \\n\\n                                    \\n                                \\n                                    \\n                                        \\nThe domain of the function is $x\\\\in ($\\n\\n                                    \\n                                \\n                                    \\n                            \\n{{field-1}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        \\n$,$\\n\\n                                    \\n                                \\n                                    \\n                            \\n{{field-2}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        \\n$).$\\n\\n                                    \\n                                \\n                                    \\n                                        \\n                                                \\n\\n                                                \\n\\n                                        \\n                                        \\n                                        \\n\\n                                    \\n                                \\n                                    \\n                                        \\nThe range of the function is $[$\\n\\n                                    \\n                                \\n                                    \\n                            \\n{{field-3}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        \\n$,$\\n\\n                                    \\n                                \\n                                    \\n                            \\n{{field-4}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        \\n$].$\\n\\n                                    \\n                                \\n                                    \\n                                        \\n                                                \\n\\n                                                \\n\\n                                        \\n                                        \\n                                        \\n\\n                                    \\n                                \\n                                    \\n                                        \\n                                        The period of the function is\\n\\n                                    \\n                                \\n                                    \\n                            \\n{{field-5}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        .\" :question/worked-solution \"Let's plot the graph of $y=sin⁡x.$\\n\\n![](images/96/96bd60d23237f836b77a26c5c0461a5c2a474554f0a14266b53fc5e7d999f1b7.png)\\n\\nLet's go through each statement.\\n\\n* The domain of the function is $(-\\\\infty ,\\\\infty ).$\\n\\n* The minimum value is $-1,$ and the maximum value is $1.$ Therefore, the range is $[-1,1].$\\n\\n* The period of $sin⁡x$ is $2\\\\pi .$\"} {:db/id 17592186237982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"bdd8d5ad-073e-55ee-92c1-3d941cfbf8cb\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437300} {:answer/id #uuid \"62442bed-3629-535b-844a-f1ed8cc3a547\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437301}] :answer-field/correct {:answer/id #uuid \"62442bed-3629-535b-844a-f1ed8cc3a547\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437301} :answer-field/id #uuid \"6b115472-4d06-5a5e-9cd3-15210c6010e5\" :answer-field/key \"The function is zero at $x=\\\\frac{3\\\\pi }{2}.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438679} {:answer-field/choices [{:answer/id #uuid \"7edfcf80-e21f-5e22-8902-7e7b1332485b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437302} {:answer/id #uuid \"9c74c49e-6c9c-5bab-9fb2-8efb50f61131\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437303}] :answer-field/correct {:answer/id #uuid \"7edfcf80-e21f-5e22-8902-7e7b1332485b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437302} :answer-field/id #uuid \"9da1c4d9-8e1c-5e3d-8925-a2ad4ef01523\" :answer-field/key \"Its range is $y\\\\in [-2,2]$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438680} {:answer-field/choices [{:answer/id #uuid \"57a3617f-5ddc-5f1e-9587-578cb2e5daae\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437304} {:answer/id #uuid \"8c3927d0-6855-5216-a9b2-c6bb7f951391\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437305}] :answer-field/correct {:answer/id #uuid \"57a3617f-5ddc-5f1e-9587-578cb2e5daae\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437304} :answer-field/id #uuid \"e42ef86b-359c-5579-8280-6358310897d5\" :answer-field/key \"$y=-\\\\frac{3}{2}$ is an output of the function\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438681}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4817b633-1cdd-52d9-b9a7-098236a7867f\" :question/math-academy-id \"q-103230\" :question/problem \"Which of the following statements are true regarding the function $y=cos⁡x?$\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=cos⁡x.$\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The function is zero at $x=\\\\frac{3\\\\pi }{2}.$” is true. At $x=\\\\frac{3\\\\pi }{2}$, the function $y=cos⁡x$ takes the value zero.\\n\\n- Statements “Its range is $y\\\\in [-2,2]$” and “$y=-\\\\frac{3}{2}$ is an output of the function” are false. The range of the function $y=cos⁡x$ is $y\\\\in [-1,1].$ Thus, $y=-\\\\frac{3}{2}$ is not an output of this function.\"} {:db/id 17592186237983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"54f7039a-2f3c-5e11-b655-d32aed6af515\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437306} {:answer/id #uuid \"d0e0e83d-6b7c-5018-bd20-49f606eedb04\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437307}] :answer-field/correct {:answer/id #uuid \"54f7039a-2f3c-5e11-b655-d32aed6af515\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437306} :answer-field/id #uuid \"e78118cd-b206-5d3b-aac4-77a392c6c22c\" :answer-field/key \"The zeros of the function are $x=\\\\frac{\\\\pi }{2}+2n\\\\pi $\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438682} {:answer-field/choices [{:answer/id #uuid \"6fbfbd2d-9a45-5a4b-b854-d3e63ee7830d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437308} {:answer/id #uuid \"0c07a39f-6574-5ab6-9301-59c89b690d89\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437309}] :answer-field/correct {:answer/id #uuid \"0c07a39f-6574-5ab6-9301-59c89b690d89\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437309} :answer-field/id #uuid \"62b3d79d-1762-5848-9642-6db59cbc38e2\" :answer-field/key \"Its graph passes through the point $(0,1)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438683} {:answer-field/choices [{:answer/id #uuid \"efed1b10-8121-5609-a029-df7005434c78\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437310} {:answer/id #uuid \"82200c6e-534d-5c90-9855-36c2db1fd8ba\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186437311}] :answer-field/correct {:answer/id #uuid \"efed1b10-8121-5609-a029-df7005434c78\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186437310} :answer-field/id #uuid \"24c76314-0f5c-552b-9634-7a579528542d\" :answer-field/key \"The function has maximum values at $x=\\\\frac{\\\\pi }{2}+n\\\\pi .$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186438684}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4afb86c8-970f-594e-bb88-36f6e2c3e725\" :question/math-academy-id \"q-103233\" :question/problem \"Which of the following statements are true regarding the function $y=cos⁡x?$ Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=cos⁡x.$\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The zeros of the function are $x=\\\\frac{\\\\pi }{2}+2n\\\\pi $” is false. The zeros occur at $$\\n\\\\displaystyle x=\\\\pm \\\\frac{\\\\pi }{2},\\\\pm \\\\frac{3\\\\pi }{2},…,\\n$$ which can be written as $x=\\\\frac{\\\\pi }{2}+n\\\\pi .$\\n\\n- Statement “Its graph passes through the point $(0,1)$” is true. At $x=0,$ the function has the value $y=cos⁡0=1.$ Therefore, the graph of the function passes through the point $(0,1).$\\n\\n- Statement “The function has maximum values at $x=\\\\frac{\\\\pi }{2}+n\\\\pi .$” is false. The function has a maximum at $x=0,\\\\pm 2\\\\pi ,…,$ which can be written as $x=2n\\\\pi .$\"} {:db/id 17592186292696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e5868b07-bcc9-5439-8718-abc34721e4f0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438022} {:answer/id #uuid \"b4492437-18b0-5ea5-afe3-0c95f6e8c559\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438023}] :answer-field/correct {:answer/id #uuid \"b4492437-18b0-5ea5-afe3-0c95f6e8c559\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438023} :answer-field/id #uuid \"049db57c-a0e7-56de-b01d-934b8edb71e7\" :answer-field/key \"The function intersects the $x$-axis at $x=\\\\frac{\\\\pi }{2}.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439040} {:answer-field/choices [{:answer/id #uuid \"f4c2d785-bfd8-52bd-920b-fdf30600fb45\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438024} {:answer/id #uuid \"65d473ca-16c2-5906-9a4b-4d38e4d203a9\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438025}] :answer-field/correct {:answer/id #uuid \"f4c2d785-bfd8-52bd-920b-fdf30600fb45\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438024} :answer-field/id #uuid \"e8b8f0da-7701-59ac-b62e-e3c7f0b5a210\" :answer-field/key \"The function has a minimum value at  $x=2\\\\pi .$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439041} {:answer-field/choices [{:answer/id #uuid \"88d518a6-aec2-5916-b3c0-47b033deb6e0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438026} {:answer/id #uuid \"0e2171a1-1911-5a58-a449-b31bc5f2edce\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438027}] :answer-field/correct {:answer/id #uuid \"88d518a6-aec2-5916-b3c0-47b033deb6e0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438026} :answer-field/id #uuid \"cf911183-758e-5ef8-9432-74581ddfaa58\" :answer-field/key \"The function intersects the $y$-axis at $y=0.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439042}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"69137884-05b3-53be-9c7c-95b53b1ed329\" :question/math-academy-id \"q-27009\" :question/problem \"Which of the following statements are true regarding the function $y=\\\\operatorname{cos}⁡x?$\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=cos⁡x.$\\n\\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The function intersects the $x$-axis at $x=\\\\frac{\\\\pi }{2}.$” is true. At $x=\\\\frac{\\\\pi }{2}$ the function intersects the $x$-axis.\\n\\n- Statement “The function has a minimum value at  $x=2\\\\pi .$” is false. The function has a maximum at $x=2\\\\pi .$\\n\\n- Statement “The function intersects the $y$-axis at $y=0.$” is false. The function intersects the $y$-axis at $y=1.$\"} {:db/id 17592186338799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b7fc3c01-7f3a-5c6b-abd7-c743ce206e9b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438490} {:answer/id #uuid \"47099553-c6c1-5bd1-9e0e-9f21c98fc65f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438491}] :answer-field/correct {:answer/id #uuid \"b7fc3c01-7f3a-5c6b-abd7-c743ce206e9b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438490} :answer-field/id #uuid \"a81ed0d9-7e42-5cbb-aca1-b03bc48b3022\" :answer-field/key \"The function has maximum values at $x=\\\\frac{\\\\pi }{2}+2n\\\\pi .$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439274} {:answer-field/choices [{:answer/id #uuid \"46870e8a-9f05-53d2-a4ea-6c68291e1467\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438492} {:answer/id #uuid \"71ec84ae-38af-5df8-81fd-d23b40330600\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438493}] :answer-field/correct {:answer/id #uuid \"71ec84ae-38af-5df8-81fd-d23b40330600\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438493} :answer-field/id #uuid \"faf0da50-2691-505e-8eef-7d1db6e3c6e2\" :answer-field/key \"The function is zero at $x=-\\\\frac{\\\\pi }{2}.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439275} {:answer-field/choices [{:answer/id #uuid \"550bb9f1-5049-57d7-84d3-41f3f2ac8184\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438494} {:answer/id #uuid \"a91fa62b-3e27-5516-b774-e6cf906a51d1\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438495}] :answer-field/correct {:answer/id #uuid \"550bb9f1-5049-57d7-84d3-41f3f2ac8184\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438494} :answer-field/id #uuid \"a5214bf9-b022-5d37-a8e8-c3abbfca85a8\" :answer-field/key \"The range of the function is $[-\\\\pi ,\\\\pi ].$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439276}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f5773d37-2017-53ae-a0d1-64c772d0dcaf\" :question/math-academy-id \"q-70666\" :question/problem \"Which of the following statements are true regarding the function $y=cos⁡x?$ Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=cos⁡x.$\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The function has maximum values at $x=\\\\frac{\\\\pi }{2}+2n\\\\pi .$” is false. The function has a maximum at $x=0,\\\\pm 2\\\\pi ,…,$ which can be written as $x=2n\\\\pi .$\\n\\n- Statement “The function is zero at $x=-\\\\frac{\\\\pi }{2}.$” is true. At $x=-\\\\frac{\\\\pi }{2}$, the function intersects the $x$-axis.\\n\\n- Statement “The range of the function is $[-\\\\pi ,\\\\pi ].$” is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$\"} {:db/id 17592186338800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"991d9c5f-a832-550c-b508-1bc99acc792d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438496} {:answer/id #uuid \"699ada80-0b45-5f12-a290-7e8d352f34e5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438497}] :answer-field/correct {:answer/id #uuid \"699ada80-0b45-5f12-a290-7e8d352f34e5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438497} :answer-field/id #uuid \"70665897-25d9-5fb8-b277-0ed7bc737d42\" :answer-field/key \"The graph intersects the $y$-axis at $y=1$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439277} {:answer-field/choices [{:answer/id #uuid \"66266660-a17d-5cab-9611-596953bfded0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438498} {:answer/id #uuid \"529ad213-185b-543a-be0e-63b5e783c340\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438499}] :answer-field/correct {:answer/id #uuid \"529ad213-185b-543a-be0e-63b5e783c340\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438499} :answer-field/id #uuid \"2c9a569f-7beb-55df-b6ed-b7c76b589ecb\" :answer-field/key \"The function has a minimum value at $x=-\\\\pi .$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439278} {:answer-field/choices [{:answer/id #uuid \"9326e664-12a0-57da-b2ff-7159b17d534b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438500} {:answer/id #uuid \"8cfbb402-00a5-5543-8bc2-4d82370d544c\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186438501}] :answer-field/correct {:answer/id #uuid \"9326e664-12a0-57da-b2ff-7159b17d534b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186438500} :answer-field/id #uuid \"39ce8d5b-318c-5474-9063-3a51adf37c70\" :answer-field/key \"The range of the function is $[-\\\\pi ,\\\\pi ].$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186439279}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"24b90149-221d-555e-91aa-b1d1cb7cb1c0\" :question/math-academy-id \"q-70667\" :question/problem \"Which of the following statements regarding the graph of $y=\\\\operatorname{cos}⁡x$ are true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=cos⁡x.$\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The graph intersects the $y$-axis at $y=1$” is true. The $y$-intercepts of the function is $y=1.$\\n\\n- Statement “The function has a minimum value at $x=-\\\\pi .$” is true. The function at $x=-\\\\pi $ has a minimum value.\\n\\n- Statement “The range of the function is $[-\\\\pi ,\\\\pi ].$” is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$\"} {:db/id 17592186511988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"61e3a7d8-7256-58da-815e-b8f0dda9e6b2\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512020} {:answer/id #uuid \"84529515-48e3-520e-bfd1-3868a9402a05\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512040}] :answer-field/correct {:answer/id #uuid \"84529515-48e3-520e-bfd1-3868a9402a05\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512040} :answer-field/id #uuid \"4355f151-f54d-57b7-8dcd-e52174dbc60e\" :answer-field/key \"The complete set of inputs at which the function has maximum values is $x=n\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512010} {:answer-field/choices [{:answer/id #uuid \"31b822ea-d79a-561e-bbe1-96f2aa290bba\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186511999} {:answer/id #uuid \"560b4ac7-4028-5d7f-9dee-814213d524b1\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512018}] :answer-field/correct {:answer/id #uuid \"560b4ac7-4028-5d7f-9dee-814213d524b1\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512018} :answer-field/id #uuid \"7553d696-d4bd-5fce-8cb1-3075bcb22340\" :answer-field/key \"The complete set of inputs at which the function has minimum values is $x=\\\\frac{\\\\pi}{2}+n\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512031} {:answer-field/choices [{:answer/id #uuid \"7cce4ff9-d81f-585b-8527-5b41abd3d68c\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512036} {:answer/id #uuid \"a029a29f-51c9-5fa2-a876-4daa2792a47d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512053}] :answer-field/correct {:answer/id #uuid \"a029a29f-51c9-5fa2-a876-4daa2792a47d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512053} :answer-field/id #uuid \"f7cbd98c-0e18-5f50-a46a-5148cb29c545\" :answer-field/key \"The complete set of inputs at which the function has zeros is $x=n\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512079}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1482e5f8-11d5-5027-aa8c-bab1e79796ae\" :question/problem \"Which of the following statements are true regarding the function $y=\\\\cos x$? Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=\\\\cos x$.\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The complete set of inputs at which the function has zeros is $x=n\\\\pi.$” is false. The zeros occur at $x=\\\\frac{\\\\pi}{2}+n\\\\pi$. Every zero must be included.\\n\\n- Statement “The complete set of inputs at which the function has maximum values is $x=n\\\\pi.$” is false. The maximum value is $1$, attained at $x=2n\\\\pi$. Every maximum input must be included.\\n\\n- Statement “The complete set of inputs at which the function has minimum values is $x=\\\\frac{\\\\pi}{2}+n\\\\pi.$” is false. The minimum value is $-1$, attained at $x=\\\\pi+2n\\\\pi$. Every minimum input must be included.\"} {:db/id 17592186511995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"741fac4f-1236-55d2-8c70-cfc0af005c93\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512030} {:answer/id #uuid \"d6570710-b647-565c-a2c9-8585a674a4fe\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512068}] :answer-field/correct {:answer/id #uuid \"d6570710-b647-565c-a2c9-8585a674a4fe\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512068} :answer-field/id #uuid \"068801a3-9623-53de-aa7f-3acc77125b93\" :answer-field/key \"The graph intersects the $y$-axis at $y=1.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186511983} {:answer-field/choices [{:answer/id #uuid \"056e2ce5-e610-549c-a163-cf4528eb99be\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186511982} {:answer/id #uuid \"cd8ee2f5-a72f-56ba-ac9b-dc17f121fef6\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512066}] :answer-field/correct {:answer/id #uuid \"056e2ce5-e610-549c-a163-cf4528eb99be\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186511982} :answer-field/id #uuid \"e6c654b4-1a53-5dbc-9411-9cca0b1b1aff\" :answer-field/key \"The function has a maximum value at $x=\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512070} {:answer-field/choices [{:answer/id #uuid \"92681729-47a6-5427-aec1-03c9d4dd5df6\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512046} {:answer/id #uuid \"f1e78bbc-95d5-5df6-9a9c-07ba7b8b80ac\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512075}] :answer-field/correct {:answer/id #uuid \"f1e78bbc-95d5-5df6-9a9c-07ba7b8b80ac\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512075} :answer-field/id #uuid \"f6909370-19f2-5a16-b8ab-80f2876d0ed6\" :answer-field/key \"The function has a maximum value at $x=\\\\frac{\\\\pi}{2}.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512078}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"28204067-d44a-5402-8c5b-2fe033d1ea9d\" :question/problem \"Which of the following statements are true regarding the function $y=\\\\cos x$?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=\\\\cos x$.\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The graph intersects the $y$-axis at $y=1.$” is true. At $x=0$, the function has value $\\\\cos 0=1$.\\n\\n- Statement “The function has a maximum value at $x=\\\\frac{\\\\pi}{2}.$” is false. $\\\\cos\\\\left(\\\\frac{\\\\pi}{2}\\\\right)=0$.\\n\\n- Statement “The function has a maximum value at $x=\\\\pi.$” is false. $\\\\cos(\\\\pi)=-1$.\"} {:db/id 17592186511996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9fff82ab-ccc2-54e8-a477-b1f06cfd3664\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512052} {:answer/id #uuid \"fea87ffa-961d-547f-9753-66b8606137ce\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512080}] :answer-field/correct {:answer/id #uuid \"9fff82ab-ccc2-54e8-a477-b1f06cfd3664\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512052} :answer-field/id #uuid \"09c35091-41c9-543d-a496-31bb6379010a\" :answer-field/key \"The complete set of inputs at which the function has minimum values is $x=\\\\frac{\\\\pi}{2}+2n\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186511985} {:answer-field/choices [{:answer/id #uuid \"5adf5b71-28b3-57c2-b043-03826303a6ef\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512019} {:answer/id 