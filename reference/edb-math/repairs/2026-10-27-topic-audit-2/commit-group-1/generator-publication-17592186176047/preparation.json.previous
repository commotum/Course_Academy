er.type/text} :answer/value \"false\" :db/id 17592186512005} {:answer/id #uuid \"6cd1710b-9b32-522b-9601-eba847c1e078\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512025}] :answer-field/correct {:answer/id #uuid \"3ebe5d30-e92e-5943-8471-f25c505f78bb\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186512005} :answer-field/id #uuid \"fee93e3b-06c8-5ee1-8dd8-365bfe5b8c36\" :answer-field/key \"The complete set of inputs at which the function has zeros is $x=n\\\\pi.$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186512081}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4ce2ea85-552c-5e62-a3ef-0a5e7f4819be\" :question/problem \"Which of the following statements are true regarding the function $y=\\\\cos x$? Assume that $n$ is an integer.\\n\\nSelect all that apply.\" :question/worked-solution \"Let's plot the graph of $y=\\\\cos x$.\\n\\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\\n\\nLet's go through each statement.\\n\\n- Statement “The complete set of inputs at which the function has zeros is $x=n\\\\pi.$” is false. The zeros occur at $x=\\\\frac{\\\\pi}{2}+n\\\\pi$. Every zero must be included.\\n\\n- Statement “The complete set of inputs at which the function has maximum values is $x=n\\\\pi.$” is false. The maximum value is $1$, attained at $x=2n\\\\pi$. Every maximum input must be included.\\n\\n- Statement “The complete set of inputs at which the function has minimum values is $x=n\\\\pi.$” is false. The minimum value is $-1$, attained at $x=\\\\pi+2n\\\\pi$. Every minimum input must be included.\"} {:db/id 17592186512034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"80ec998e-ebc7-57cf-9585-e7037333b8b9\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186512039} {:answer/id #uuid \"89c1df3f-3762-583b-8c83-ee434a3252d9\" :answer/type {:db/i