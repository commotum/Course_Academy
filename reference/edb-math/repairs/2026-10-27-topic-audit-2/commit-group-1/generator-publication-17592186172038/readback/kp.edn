#{[{:db/id #edb/ref 17592186172038 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171844 :question/id #uuid "231de5e4-8c55-5129-baaf-57673050ddbc" :question/math-academy-id "e-8505" :question/problem "For the differential equation\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = 2x^2-y,\n$$\n\nplot the slope field at the points $(1,1),$ $(0,1),$ and $(1,2).$" :question/worked-solution "We have to sketch the slope field at the points $(1,1),$ $(0,1),$ and $(1,2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)} & =2(1)^{2}-1=1 \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(0,1)} & =2(0)^{2}-1=-1 \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)} & =2(1)^{2}-2=0\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/0c/0c06b4acee1445fea91bcbb7bed5a837a1dd494c9638a4f8945f5ac8dc226c22.png)"} :knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048822 :topic/id #uuid "c2fc5214-795d-5bfe-b226-459801a3c888" :topic/knowledge-points [{:db/id #edb/ref 17592186166730} {:db/id #edb/ref 17592186166823} {:db/id #edb/ref 17592186166824}] :topic/math-academy-id 3276 :topic/next [{:db/id #edb/ref 17592186048179} {:db/id #edb/ref 17592186050480}] :topic/title "Slope Fields for Directly Integrable Differential Equations"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725838 :question-generator/id #uuid "b0dd99d0-7103-5801-a2d3-80a6bb49b4d1" :question-generator/script "generators/c3/c3d38b877d1a898338d3ad4fc096a0d85573427a5ef1a4d6320324f2c93cc1da/17592186172038.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186172565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "964e2a08-2b5f-5ba6-9cb2-