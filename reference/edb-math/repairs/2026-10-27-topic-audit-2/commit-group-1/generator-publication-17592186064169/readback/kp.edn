4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-1/4+1}}{(-\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{3/4}}{\\left(\\frac{3}{4}\\right)}+C \\\\  & =\\frac{4}{3}{x}^{3/4}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d738aac-dbe8-544c-8e1d-2595eca3d13b" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{-1/4} + C" :db/id #edb/ref 17592186502880} {:answer/id #uuid "6a447127-79f8-57b4-9456-cc1dc920e3af" :answer/type {:db/ident :answer.type/math} :answer/value "-4x^{-5/4} + C" :db/id #edb/ref 17592186502913} {:answer/id #uuid "907f822e-c090-559b-9aba-2e8311fdac55" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/4} + C" :db/id #edb/ref 17592186502929} {:answer/id #uuid "a06d15c6-bae0-59f6-910b-7f074de70fef" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-1/4} + C" :db/id #edb/ref 17592186502935} {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945}] :answer-field/correct {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945} :answer-field/id #uuid "fc2d6790-5efe-5373-be98-3094e21928cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502963}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "40665566-8355-550d-acf0-8fd3e706266d" :question/problem "Given that $f(x)=\\frac{1}{{x}^{5/4}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\