d}\n$$"} {:db/id #edb/ref 17592186502887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27715ac4-7080-5ffe-be40-e664b63285a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}x^{-7/3} + C" :db/id #edb/ref 17592186502878} {:answer/id #uuid "3193dee8-6d38-5f64-9116-9e39da2d7bf5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}x^{-7/3} + C" :db/id #edb/ref 17592186502882} {:answer/id #uuid "421826bb-b2d5-5fb8-947d-ac92615073de" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10}{3}x^{-13/3} + C" :db/id #edb/ref 17592186502901} {:answer/id #uuid "a3b35749-3d6f-5507-92fc-8f661d4354b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10}{3}x^{-7/3} + C" :db/id #edb/ref 17592186502936} {:answer/id #uuid "b7fcac92-9f4c-5be7-a469-98066cd54d70" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}x^{-10/3} + C" :db/id #edb/ref 17592186502943}] :answer-field/correct {:answer/id #uuid "3193dee8-6d38-5f64-9116-9e39da2d7bf5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}x^{-7/3} + C" :db/id #edb/ref 17592186502882} :answer-field/id #uuid "8ddf54d7-8f99-5eb4-8c0a-845692b3564f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502928}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "35340db4-7b99-5255-81e2-d140281bf3c1" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[3]{{x}^{10}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[3]{{x}^{10}}}=\\frac{1}{{x}^{10/3}}={x}^{-10/3}.\n$$ So, we can use the power rule with $n=-\\frac{10}{3}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[3]{{x}^{10}}}\\,\\text{d}x & =\\int {x}^{-10/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-10/3+1}}{-\\frac{10}{3}+1}+C \\\\  & =-\\frac{3}{7}{x}^{-7/3}+C \\\\  & =-\\frac{3}{7{x}^{7/3}}+C.\\end{aligned}\n$$"} {:db/id #edb