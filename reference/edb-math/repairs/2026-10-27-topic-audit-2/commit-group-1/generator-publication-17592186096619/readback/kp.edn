#{[{:db/id #edb/ref 17592186096619 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096419 :question/id #uuid "072ce609-b04d-57b0-9c7d-cbb8765c38fa" :question/math-academy-id "e-3636" :question/problem "If a curve $\\mathcal C$ is given by $y=e^x\\sin x,$ calculate the slope of the tangent line to the curve at the point where $x=\\dfrac \\pi 2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x) = e^x$ and $v(x)=\\sin{x}.$ Then, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = e^x,\\qquad \\dfrac{\\textrm d v}{\\textrm d x} = \\cos x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+sin⁡x\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\dfrac\\pi 2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi /2} & ={e}^{\\pi /2}(cos⁡\\left(\\frac{\\pi }{2}\\right)+sin⁡\\left(\\frac{\\pi }{2}\\right)) \\\\  & ={e}^{\\pi /2}(0+1) \\\\  & ={e}^{\\pi /2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $e^{\\pi/2}.$"} :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050711 :topic/difficulty 0.9795434122769167 :topic/id #uuid "608cf86b-83ea-5cc3-a6a8-222e7fa44e21" :topic/knowledge-points [{:db/id #edb/ref 17592186064259} {:db/id #edb/ref 17592186064342} {:db/id #edb/ref 17592186064343}] :topic/math-academy-id 332 :topic/next [{:db/id #edb/ref 17592186048123} {:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186050644}] :topic/title "Calculating the Slope of a Tangent Line Using Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725831 :question-generator/id #uuid "b146d379-d50b-54af-8355-3bfe5e995062" :question-generator/script "generators/f0/f0f588b746b3540db9af7cf321336e5db5521f7b054d60abd0ccfc010826a3b5/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a701631f-ee6f-5c74-8945-ae030b322172" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186095407} {:answer/id #uuid "b33ae4fd-7df5-5668-be3f-6da8b92a1f35" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186095408} {:answer/id #uuid "e5c620ec-258c-57ed-8f58-6c1af87e31f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}e" :db/id #edb/ref 17592186095409} {:answer/id #uuid "30ae4bc2-f079-544b-81c3-abc3d5c10ec8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186095410} {:answer/id #uuid "497ee82d-da93-5f82-adc3-3cb7e1142e53" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186095411}] :answer-field/correct {:answer/id #uuid "b33ae4fd-7df5-5668-be3f-6da8b92a1f35" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186095408} :answer-field/id #uuid "d50d9198-c7df-55ec-ba39-bff28ab4846e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095406}] :question/id #uuid "544be85e-c712-5922-8992-f82de75c2029" :question/math-academy-id "q-48391" :question/problem "If a curve $C$ is given by $y = 2e^{x}(x + 1)$, calculate the slope of the tangent line to the curve at the point where $x = 0$." :question/worked-solution "Use the product rule, $(uv)′=u′v+uv′$, and differentiate each factor:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\left(2 x + 2\\right) e^{x}\\right)=\\left(2 x + 2\\right) e^{x} + 2 e^{x}.\n$$\n\nSubstituting the given point gives\n\n$$\n4.\n$$"} {:db/id #edb/ref 17592186097260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c7eb625-3ff4-5e82-bd70-a085123a70c7" :answer/type {:db/ident :answer.type/math} :answer/value "3π^{2}" :db/id #edb/ref 17592186095485} {:answer/id #uuid "d4b825b6-1cae-5e24-9e36-665ccf694b7d" :answer/type {:db/ident :answer.type/math} :answer/value "-6π^{2}" :db/id #edb/ref 17592186095486} {:answer/id #uuid "3ab1f0af-b2c2-5a25-97d0-1ea8b6003204" :answer/type {:db/ident :answer.type/math} :answer/value "-3π^{2}" :db/id #edb/ref 17592186095487} {:answer/id #uuid "5e676af8-cf84-5f73-998c-145d20246a1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186095488} {:answer/id #uuid "73d74933-2b73-5e41-8a53-45938d45db82" :answer/type {:db/ident :answer.type/math} :answer/value "6π^{2}" :db/id #edb/ref 17592186095489}] :answer-field/correct {:answer/id #uuid "73d74933-2b73-5e41-8a53-45938d45db82" :answer/type {:db/ident :answer.type/math} :answer/value "6π^{2}" :db/id #edb/ref 17592186095489} :answer-field/id #uuid "b2dfab29-1db5-50bf-875c-fe928ce84d34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095484}] :question/id #uuid "1feafbad-2c59-53b5-8e99-0aba4e213ff3" :question/math-academy-id "q-48901" :question/problem "If a curve $C$ is given by $y = 8x^{3}\\sin x$, calculate the slope of the tangent line to the curve at the point where $x = \\frac{π}{2}$." :question/worked-solution "Use the product rule, $(uv)′=u′v+uv′$, and differentiate each factor:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(8 x^{3} \\sin{\\left(x \\right)}\\right)=8 x^{3} \\cos{\\left(x \\right)} + 24 x^{2} \\sin{\\left(x \\right)}.\n$$\n\nSubstituting the given point gives\n\n$$\n6 \\pi^{2}.\n$$"} {:db/id #edb/ref 17592186233776 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d79a7bd8-521e-5538-bc94-8c3a64e6621d" :question/math-academy-id "q-31226" :question/problem "If a curve $C$ is given by $y=3{x}^{2}\\operatorname{tan}x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3{x}^{2}$ and $v(x)=\\operatorname{tan}x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x,\\,\\frac{\\text{d}v}{\\text{d}x}={sec}^{2}x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(3{x}^{2})({sec}^{2}x)+(\\operatorname{tan}x)(6x) \\\\  & =3{x}^{2}{sec}^{2}x+6x\\operatorname{tan}x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=\\pi } & =3{x}^{2}{sec}^{2}x+6x\\operatorname{tan}x{|}_{x=\\pi } \\\\  & =3(\\pi )^{2}{sec}^{2}(\\pi )+6(\\pi )\\operatorname{tan}(\\pi ) \\\\  & =3{\\pi }^{2}\\cdot 1+6\\pi \\cdot 0 \\\\  & =3{\\pi }^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3{\\pi }^{2}.$"} {:db/id #edb/ref 17592186233814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9bc784-4648-528a-ac26-6d3516a71384" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186232589}] :answer-field/correct {:answer/id #uuid "0b9bc784-4648-528a-ac26-6d3516a71384" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186232589} :answer-field/id #uuid "7a2fdd90-ea5c-5dc2-bea7-c9bda09ae803" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c831400-ba54-50fb-91a6-b9b14e55efca" :question/math-academy-id "q-319825" :question/problem "If a curve $C$ is given by $y=(x-1)\\operatorname{ln}(2x+1),$ calculate the slope of the tangent line to the curve at the point where $x=0$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=x-1$ and $v(x)=\\operatorname{ln}(2x+1).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{2}{2x+1}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x-1)\\cdot \\frac{2}{2x+1}+\\operatorname{ln}(2x+1)\\cdot 1 \\\\  & =\\frac{2(x-1)}{2x+1}+\\operatorname{ln}(2x+1).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =\\frac{2(0-1)}{2(0)+1}+\\operatorname{ln}(2(0)+1) \\\\  & =(-2)+\\operatorname{ln}(1) \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-2.$"} {:db/id #edb/ref 17592186235431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ead734d2-e970-5e92-9ac3-1260bbfab982" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{\\pi }" :db/id #edb/ref 17592186234918}] :answer-field/correct {:answer/id #uuid "ead734d2-e970-5e92-9ac3-1260bbfab982" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{\\pi }" :db/id #edb/ref 17592186234918} :answer-field/id #uuid "3429cda5-daf9-53dc-9c18-72e4afbade0a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235025}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dabe687a-249f-595c-be70-5214c92992e9" :question/math-academy-id "q-167326" :question/problem "If a curve $C$ is defined by the equation $y=f(x)\\cdot h(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$\n\nSlope $\\,=${{field-1}}" :question/worked-solution "We differentiate using the product rule. Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x})=\\frac{1}{2}{e}^{x} \\\\ \\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =f\\frac{\\text{d}h}{\\text{d}x}+h\\frac{\\text{d}f}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{x}\\cdot (-4\\operatorname{cos}⁡x)+(-4\\operatorname{sin}⁡x)\\cdot \\frac{1}{2}{e}^{x} \\\\  & =-2{e}^{x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & =-2{e}^{\\pi }(\\operatorname{cos}⁡\\pi +\\operatorname{sin}⁡\\pi ) \\\\  & =-2{e}^{\\pi }(-1+0) \\\\  & =2{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2{e}^{\\pi }.$"} {:db/id #edb/ref 17592186235479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbf988f2-8940-5547-8a0c-461e7fba4865" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{\\pi }" :db/id #edb/ref 17592186234891}] :answer-field/correct {:answer/id #uuid "dbf988f2-8940-5547-8a0c-461e7fba4865" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{\\pi }" :db/id #edb/ref 17592186234891} :answer-field/id #uuid "a6fb57fa-80a8-5893-88ed-795c73c49674" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235177}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8af2c303-b3aa-5790-885e-7a978a609bf5" :question/math-academy-id "q-167780" :question/problem "If a curve $C$ is defined by the equation $y=f(x)\\cdot h(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$\n\nSlope $\\,=${{field-1}}" :question/worked-solution "We differentiate using the product rule. Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡(x).$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x})=\\frac{1}{2}{e}^{x} \\\\ \\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =f\\frac{\\text{d}h}{\\text{d}x}+h\\frac{\\text{d}f}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{x}\\cdot (-4\\operatorname{cos}⁡(x))+(-4\\operatorname{sin}⁡(x))\\cdot \\frac{1}{2}{e}^{x} \\\\  & =-2{e}^{x}(\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & =-2{e}^{\\pi }(\\operatorname{cos}⁡(\\pi )+\\operatorname{sin}⁡(\\pi )) \\\\  & =-2{e}^{\\pi }(-1+0) \\\\  & =2{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2{e}^{\\pi }.$"} {:db/id #edb/ref 17592186299797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94fe4615-3627-5184-b596-faacf4579fe9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}-2" :db/id #edb/ref 17592186298195}] :answer-field/correct {:answer/id #uuid "94fe4615-3627-5184-b596-faacf4579fe9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}-2" :db/id #edb/ref 17592186298195} :answer-field/id #uuid "9d5b5855-e173-5cc0-be78-e8c7ed94613e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299155}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6dd1a867-f879-56d0-b4c0-d0297b5035d5" :question/math-academy-id "q-319806" :question/problem "If a curve $C$ is given by $y=(x+2)cos⁡x,$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi }{2}$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=x+2$ and $v(x)=cos⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x+2)\\cdot (-sin⁡x)+cos⁡x\\cdot 1 \\\\  & =-(x+2)sin⁡x+cos⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi }{2}$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\frac{\\pi }{2}} & =-(\\frac{\\pi }{2}+2)sin⁡\\frac{\\pi }{2}+cos⁡\\frac{\\pi }{2} \\\\  & =-(\\frac{\\pi }{2}+2)(1)+0 \\\\  & =-\\frac{\\pi }{2}-2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{\\pi }{2}-2.$"} {:db/id #edb/ref 17592186299798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a9ff769-7920-54d9-9d56-bc88c33849af" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298084}] :answer-field/correct {:answer/id #uuid "7a9ff769-7920-54d9-9d56-bc88c33849af" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298084} :answer-field/id #uuid "4571a1bf-33ea-5e4c-ab47-61e0c018609f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298876}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6b71a24-90f7-5ca7-b521-491ff5b33ac3" :question/math-academy-id "q-319829" :question/problem "If a curve $C$ is given by $y=(x-1)ln⁡(4x-3),$ calculate the slope of the tangent line to the curve at the point where $x=1$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=x-1$ and $v(x)=ln⁡(4x-3).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{4}{4x-3}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x-1)\\cdot \\frac{4}{4x-3}+ln⁡(4x-3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =(1-1)\\cdot \\frac{4}{4(1)-3}+ln⁡(4(1)-3) \\\\  & =0+ln⁡(1)=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"} {:db/id #edb/ref 17592186299799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bfce910-f1a6-55e0-aa0a-ef391e8972f8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298162}] :answer-field/correct {:answer/id #uuid "8bfce910-f1a6-55e0-aa0a-ef391e8972f8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298162} :answer-field/id #uuid "2b17fdea-2304-5379-9c2f-9f4ff86470d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298785}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dcf49dc9-80d7-5610-a247-cb1da3f12efe" :question/math-academy-id "q-319842" :question/problem "If a curve $C$ is given by $y=({x}^{2}-4x+7){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=0$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{2}-4x+7$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-4,\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{2}-4x+7)\\cdot {e}^{x}+{e}^{x}\\cdot (2x-4) \\\\  & ={e}^{x}({x}^{2}-2x+3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={{e}^{x}({x}^{2}-2x+3)|}_{x=0} \\\\  & =1\\cdot (0-0+3)=3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"} {:db/id #edb/ref 17592186329890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d41e3a6-5106-5f1f-89a7-bdf0659fd667" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186327605} {:answer/id #uuid "5722ae40-633d-5817-9b2f-fd696d396624" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327690} {:answer/id #uuid "7d059a2c-54e1-581a-9631-274cba73cd9c" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186328010} {:answer/id #uuid "e54916ae-cb46-54d5-9769-ffc8af47b71e" :answer/type {:db/ident :answer.type/math} :answer/value "5+2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186328941} {:answer/id #uuid "ef1b3eab-bf60-5779-ac14-8316a78be3d4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186329022}] :answer-field/correct {:answer/id #uuid "5722ae40-633d-5817-9b2f-fd696d396624" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327690} :answer-field/id #uuid "4b4c9edf-2978-575c-9b65-ca2b012c2b2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329326}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "33d86109-fb1d-5bea-8ffd-bc18d4e7651a" :question/math-academy-id "q-48515" :question/problem "If a curve $C$ is given by $y=(3x-2)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3x-2$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(3x-2)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 3 \\\\  & =\\frac{3x-2}{x}+3\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3x-2}{x}+3\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{3(1)-2}{1}+3\\operatorname{ln}⁡1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $1.$"} {:db/id #edb/ref 17592186329891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bc770f-35b5-51f7-ac23-0dd7e7626849" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186326966} {:answer/id #uuid "a57078c9-1989-5bc2-8b84-47cb7c7b7fce" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }" :db/id #edb/ref 17592186328362} {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} {:answer/id #uuid "bce8eacc-997c-5af0-a8a5-5af0dda6e688" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328578} {:answer/id #uuid "d019d383-2037-503a-8480-3e5bdb84df98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328764}] :answer-field/correct {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} :answer-field/id #uuid "8008b7a2-773f-5257-8a67-dd590b27a6d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329395}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7dfe1e7-2a9e-5927-a9e6-a1ed58369b31" :question/math-academy-id "q-48516" :question/problem "If a curve $C$ is given by $y={e}^{x}sin⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={e}^{x}$ and $v(x)=sin⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x},\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+(sin⁡x)\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & ={{e}^{x}(cos⁡x+sin⁡x)|}_{x=\\pi } \\\\  & ={e}^{\\pi }(-1+0) \\\\  & =-{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-{e}^{\\pi }.$"} {:db/id #edb/ref 17592186329892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122dcace-6bca-59bb-b96f-a96026e9a833" :answer/type {:db/ident :answer.type/math} :answer/value "3e+5" :db/id #edb/ref 17592186327088} {:answer/id #uuid "29771cef-6628-575d-b6d2-039fa89b2a35" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+2" :db/id #edb/ref 17592186327286} {:answer/id #uuid "3101f4e9-df22-5461-be7e-f6674a765dce" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186327368} {:answer/id #uuid "c3e4fd4c-0122-574c-8317-faf21984d650" :answer/type {:db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186328648} {:answer/id #uuid "e154d586-179b-57cc-acf3-bc95bc04c67c" :answer/type {:db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186328905}] :answer-field/correct {:answer/id #uuid "c3e4fd4c-0122-574c-8317-faf21984d650" :answer/type {:db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186328648} :answer-field/id #uuid "745d0171-7216-5576-96bb-4a33b2c2f9b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329378}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1066779d-ebe1-53a9-ad1f-5e9c5ee1f7e4" :question/math-academy-id "q-48517" :question/problem "If a curve $C$ is given by $y=({x}^{3}-1){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{3}-1$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2},\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{3}-1)\\cdot {e}^{x}+{e}^{x}\\cdot (3{x}^{2}) \\\\  & ={e}^{x}({x}^{3}+3{x}^{2}-1).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={{e}^{x}({x}^{3}+3{x}^{2}-1)|}_{x=2} \\\\  & ={e}^{2}({2}^{3}+3(2)^{2}-1) \\\\  & =19{e}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $19{e}^{2}.$"} {:db/id #edb/ref 17592186329947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb89b95-0bba-5b10-8fe3-527b548e1601" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327074} {:answer/id #uuid "8a5aa1e3-21ee-5889-8055-e0735761bea1" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186328124} {:answer/id #uuid "c4cf7b66-0f01-5eca-acc9-cb3a3d67bb13" :answer/type {:db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186328659} {:answer/id #uuid "d10f42e2-911f-5fb9-b0b0-c03a2475a986" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328770} {:answer/id #uuid "e360ba04-1df2-5392-a2fb-baf0e0e1b838" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328927}] :answer-field/correct {:answer/id #uuid "0fb89b95-0bba-5b10-8fe3-527b548e1601" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327074} :answer-field/id #uuid "b7bf395d-b055-550a-8f21-50f7bb4a70c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329507}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4a6705a9-7a56-57af-9eab-fa453a263686" :question/math-academy-id "q-48993" :question/problem "If a curve $C$ is given by $y=x\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=e.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =x\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 1 \\\\  & =1+\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=e} & =1+\\operatorname{ln}⁡x \\\\  & =1+\\operatorname{ln}⁡e \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2.$"} {:db/id #edb/ref 17592186514464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{\\pi}" :db/id #edb/ref 17592186514126}] :answer-field/correct {:answer/id #uuid "e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{\\pi}" :db/id #edb/ref 17592186514126} :answer-field/id #uuid "f49d4659-1c96-5a65-a285-84ed00e2cd31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514345}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d1eaed8d-b238-536c-b3a6-a6e7f9e94a12" :question/math-academy-id "q-166073" :question/problem "If a curve $C$ is defined by the equation $y=f(x)\\cdot h(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x})=\\frac{1}{2}{e}^{x} \\\\ \\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =f\\frac{\\text{d}h}{\\text{d}x}+h\\frac{\\text{d}f}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{x}\\cdot (-4\\operatorname{cos}⁡x)+(-4\\operatorname{sin}⁡x)\\cdot \\frac{1}{2}{e}^{x} \\\\  & =-2{e}^{x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & =-2{e}^{\\pi }(\\operatorname{cos}⁡\\pi +\\operatorname{sin}⁡\\pi ) \\\\  & =-2{e}^{\\pi }(-1+0) \\\\  & =2{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2{e}^{\\pi }.$"} {:db/id #edb/ref 17592186536061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086}] :answer-field/correct {:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086} :answer-field/id #uuid "1461180d-25fe-52b1-abad-c2120615be94" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536066}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "025970ae-87f8-5c12-8836-70b62439e2c5" :question/problem "If a curve $C$ is given by $y=(3 x^{2} + x - 1)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 x^{2} + x - 1$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=6 x + 1,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 x^{2} + x - 1)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (6 x + 1) \\\\ &=\\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} + x \\ln{\\left(x \\right)} + x - 1}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(3 (e^{2})^{2} + (e^{2}) - 1)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (6 (e^{2}) + 1) \\\\ &=(-1 + e^{2} + 3 e^{4})\\cdot (e^{-2})+(2)\\cdot (1 + 6 e^{2}) \\\\ &=- \\frac{1}{e^{2}} + 3 + 15 e^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{e^{2}} + 3 + 15 e^{2}.$"} {:db/id #edb/ref 17592186536065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87e3eb-6bcd-53ef-bb03-fc2a22a36834" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186536064} {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} {:answer/id #uuid "4a8deab9-18c9-5ebc-98e6-8435b3c93cfa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186536078} {:answer/id #uuid "84823475-39f2-5b99-8473-e23495b0e21d" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536085} {:answer/id #uuid "d1b1968b-bd0a-5181-accb-526b08866904" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536095}] :answer-field/correct {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} :answer-field/id #uuid "4c5e91f8-c020-5cd4-ab84-1fac365579b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536079}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "11508a06-1238-59d6-9f30-ce054ca95db7" :question/problem "If a curve $C$ is given by $y=(4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(4 e^{x})\\cdot (1)+(x + 1)\\cdot (4 e^{x}) \\\\ &=4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (4 e^{(0)}) \\\\ &=(4)\\cdot (1)+(1)\\cdot (4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $8.$"} {:db/id #edb/ref 17592186536069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068}] :answer-field/correct {:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068} :answer-field/id #uuid "a3c99e80-1859-5501-94e2-065df60ee30c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536092}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "33ab5b35-dd61-5afa-9e50-76ac2177002e" :question/problem "If a curve $C$ is given by $y=(- x^{2} - x - 1)\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - x - 1$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 1,\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - x - 1)\\cdot (\\cos{\\left(x \\right)})+(\\sin{\\left(x \\right)})\\cdot (- 2 x - 1) \\\\ &=- x^{2} \\cos{\\left(x \\right)} - 2 x \\sin{\\left(x \\right)} - x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=(- \\left(\\frac{\\pi}{4}\\right)^{2} - \\left(\\frac{\\pi}{4}\\right) - 1)\\cdot (\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})+(\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{\\pi}{4}\\right) - 1) \\\\ &=(-1 - \\frac{\\pi}{4} - \\frac{\\pi^{2}}{16})\\cdot \\left(\\frac{\\sqrt{2}}{2}\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{\\pi}{2} - 1) \\\\ &=\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.$"} {:db/id #edb/ref 17592186536071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f58f4a6-0b44-5f88-9b25-552d8955a459" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536084} {:answer/id #uuid "9067e445-c243-5b05-b2ab-57c52adbf2ab" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186536088} {:answer/id #uuid "b52782fc-00de-55d6-a076-2f209848a815" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186536093} {:answer/id #uuid "c791b538-1274-505c-a9e0-ab9ebe95ebd5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536094} {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097}] :answer-field/correct {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097} :answer-field/id #uuid "3ecdcf0c-044d-52db-b4c4-2ebdf6a193cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536076}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3897814a-55c8-55e3-8f23-2d1a17edc389" :question/problem "If a curve $C$ is given by $y=(- e^{x})\\cdot (x + 3)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- e^{x}$ and $v(x)=x + 3.$ Then, we have\n\n$$\nu'(x)=- e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- e^{x})\\cdot (1)+(x + 3)\\cdot (- e^{x}) \\\\ &=- \\left(x + 4\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- e^{(0)})\\cdot (1)+((0) + 3)\\cdot (- e^{(0)}) \\\\ &=(-1)\\cdot (1)+(3)\\cdot (-1) \\\\ &=-4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-4.$"} {:db/id #edb/ref 17592186536074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062}] :answer-field/correct {:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062} :answer-field/id #uuid "77d6b1af-8fd9-5dcc-9877-1ef7732a91ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536083}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3be093e9-a88a-5893-84f7-f2f4d4e8fb03" :question/problem "If a curve $C$ is given by $y=(- 4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 4 e^{x})\\cdot (1)+(x + 1)\\cdot (- 4 e^{x}) \\\\ &=- 4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 4 e^{(0)}) \\\\ &=(-4)\\cdot (1)+(1)\\cdot (-4) \\\\ &=-8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-8.$"} {:db/id #edb/ref 17592186536075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081}] :answer-field/correct {:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081} :answer-field/id #uuid "718082e0-417d-5acb-ab28-41d32f8d52ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536082}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3cc06495-0e47-5717-9700-118ad0cf690b" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 2 x + 2)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 2 x + 2$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 2,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 2 x + 2)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (- 2 x - 2) \\\\ &=- \\frac{2 x^{2} \\ln{\\left(x \\right)} + x^{2} + 2 x \\ln{\\left(x \\right)} + 2 x - 2}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(- (e^{2})^{2} - 2 (e^{2}) + 2)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (- 2 (e^{2}) - 2) \\\\ &=(- e^{4} - 2 e^{2} + 2)\\cdot (e^{-2})+(2)\\cdot (- 2 e^{2} - 2) \\\\ &=- 5 e^{2} - 6 + \\frac{2}{e^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 5 e^{2} - 6 + \\frac{2}{e^{2}}.$"} {:db/id #edb/ref 17592186536077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091}] :answer-field/correct {:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091} :answer-field/id #uuid "354f12c4-c49c-5ce8-9d56-4a6bfbb09230" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536070}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "45e8eff6-7be8-5e2f-8927-eac30ddd0bc6" :question/problem "If a curve $C$ is given by $y=(- 3 x^{2} + 3 x - 4)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 x^{2} + 3 x - 4$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=3 - 6 x,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 x^{2} + 3 x - 4)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (3 - 6 x) \\\\ &=- \\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} - 3 x \\ln{\\left(x \\right)} - 3 x + 4}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e} &=(- 3 (e)^{2} + 3 (e) - 4)\\cdot \\left(\\frac{1}{(e)}\\right)+(\\ln{\\left((e) \\right)})\\cdot (3 - 6 (e)) \\\\ &=(- 3 e^{2} - 4 + 3 e)\\cdot (e^{-1})+(1)\\cdot (3 - 6 e) \\\\ &=- 9 e - \\frac{4}{e} + 6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 9 e - \\frac{4}{e} + 6.$"} {:db/id #edb/ref 17592186536087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063}] :answer-field/correct {:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063} :answer-field/id #uuid "1d6f8461-59dd-570a-8790-4ee15ed4552d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536067}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "89a63571-dce9-5ef0-8359-7d12fffc0179" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 3 x - 4)\\cdot (\\cos{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 3 x - 4$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 3,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 3 x - 4)\\cdot (- \\sin{\\left(x \\right)})+(\\cos{\\left(x \\right)})\\cdot (- 2 x - 3) \\\\ &=x^{2} \\sin{\\left(x \\right)} + 3 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=(- \\left(\\frac{3 \\pi}{4}\\right)^{2} - 3 \\left(\\frac{3 \\pi}{4}\\right) - 4)\\cdot (- \\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})+(\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{3 \\pi}{4}\\right) - 3) \\\\ &=(- \\frac{9 \\pi}{4} - \\frac{9 \\pi^{2}}{16} - 4)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right)+\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{3 \\pi}{2} - 3) \\\\ &=\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.$"} {:db/id #edb/ref 17592186536090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072}] :answer-field/correct {:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072} :answer-field/id #uuid "923746ba-42ca-56b6-8ff7-9429d9c12883" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536089}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "92e053cc-163c-5fb4-9084-c721d7a398e6" :question/problem "If a curve $C$ is given by $y=(3 e^{x})\\cdot (x + 2)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 e^{x}$ and $v(x)=x + 2.$ Then, we have\n\n$$\nu'(x)=3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 e^{x})\\cdot (1)+(x + 2)\\cdot (3 e^{x}) \\\\ &=3 \\left(x + 3\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(3 e^{(0)})\\cdot (1)+((0) + 2)\\cdot (3 e^{(0)}) \\\\ &=(3)\\cdot (1)+(2)\\cdot (3) \\\\ &=9.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $9.$"} {:db/id #edb/ref 17592186536098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096}] :answer-field/correct {:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096} :answer-field/id #uuid "50a33319-8a25-53ef-8f2f-91c0f3e572b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536080}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fad32388-6506-515e-9fd4-68888763cf2f" :question/problem "If a curve $C$ is given by $y=(- 3 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 e^{x})\\cdot (1)+(x + 1)\\cdot (- 3 e^{x}) \\\\ &=- 3 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 3 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 3 e^{(0)}) \\\\ &=(-3)\\cdot (1)+(1)\\cdot (-3) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-6.$"} {:db/id #edb/ref 17592186571432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa1cb47c-2e18-5935-a199-4342ba479343" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186571271}] :answer-field/correct {:answer/id #uuid "fa1cb47c-2e18-5935-a199-4342ba479343" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186571271} :answer-field/id #uuid "99aa048f-795f-5835-b3e4-7ab1bb44a8a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571340}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a0fee3ca-7f95-5f0e-a414-4282e409bf7a" :question/math-academy-id "q-319824" :question/problem "If a curve $C$ is given by $y=(2x+1)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=2x+1$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(2x+1)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 2 \\\\  & =\\frac{2x+1}{x}+2\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2x+1}{x}+2\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{2(1)+1}{1}+2\\operatorname{ln}⁡1 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"} {:db/id #edb/ref 17592186578806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346}] :answer-field/correct {:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346} :answer-field/id #uuid "59299f55-f653-572d-af54-ffb8778f188f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578723}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23f453dd-5391-598b-a2f5-caa9d74e0c57" :question/math-academy-id "q-167316" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x)+(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡x+(3+2x)\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"} {:db/id #edb/ref 17592186600798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505}] :answer-field/correct {:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505} :answer-field/id #uuid "7de17562-4cb2-576c-b80a-4d58584f24da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600746}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "688015ab-7641-5f23-9a80-3af6a7102896" :question/math-academy-id "q-167769" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x).\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x))+(2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x))\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡(x)+(3+2x)\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"} {:db/id #edb/ref 17592186610506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165ecc04-7fbd-5a77-93f6-d22774668d8a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610508} {:answer/id #uuid "a9a9eb71-d6f4-5e56-a789-44d48c2f4a4a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2} e^{\\frac{3 \\pi}{4}}}{2}" :db/id #edb/ref 17592186610522} {:answer/id #uuid "c05b88fb-a1f5-578d-b994-6446f57d9da5" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\sqrt{2} e^{\\frac{3 \\pi}{4}}" :db/id #edb/ref 17592186610523} {:answer/id #uuid "c158e98d-9be1-5924-824f-86a906952603" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2} e^{\\frac{3 \\pi}{4}}}{4}" :db/id #edb/ref 17592186610524} {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530}] :answer-field/correct {:answer/id #uuid "e7d12503-47d7-5f59-a1b1-50b38d30a30b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610530} :answer-field/id #uuid "35cfa76c-d46c-58d5-abac-80705a446e4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0d6c902f-2435-5203-aa9f-262524ac5a30" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(2 e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (2 e^{x})\\end{aligned} \\\\ &=2 e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=\\begin{aligned}&(2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (2 e^{\\left(\\frac{3 \\pi}{4}\\right)})\\end{aligned} \\\\ &=\\begin{aligned}&(2 e^{\\frac{3 \\pi}{4}})\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (2 e^{\\frac{3 \\pi}{4}})\\end{aligned} \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"} {:db/id #edb/ref 17592186610512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c653dab-d9d6-5b47-ba64-cbbe5b46db95" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{4}" :db/id #edb/ref 17592186610511} {:answer/id #uuid "4113257e-c58c-52bb-ba02-31e91a438929" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186610515} {:answer/id #uuid "6b30face-c814-5cf8-878a-8e44698640ec" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{\\pi}" :db/id #edb/ref 17592186610518} {:answer/id #uuid "91feb006-6edf-5c92-814e-860c6f6c38e3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{e^{\\pi}}{2}" :db/id #edb/ref 17592186610521} {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526}] :answer-field/correct {:answer/id #uuid "c9c63d51-a96d-5e42-858d-40ab7b62ab2c" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{\\pi}" :db/id #edb/ref 17592186610526} :answer-field/id #uuid "549d2205-841f-52e6-a67c-6b578550ece4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610516}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30877dff-2142-58cc-a6f0-c31f215bf1ca" :question/problem "If a curve $C$ is given by $y=(e^{x})\\cdot (\\sin{\\left(x \\right)}),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=e^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=e^{x},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(e^{x})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (e^{x})\\end{aligned} \\\\ &=e^{x}(\\cos x+\\sin x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\pi} &=\\begin{aligned}&(e^{(\\pi)})\\cdot (\\cos{\\left((\\pi) \\right)}) \\\\ &{}+(\\sin{\\left((\\pi) \\right)})\\cdot (e^{(\\pi)})\\end{aligned} \\\\ &=(e^{\\pi})\\cdot (-1)+(0)\\cdot (e^{\\pi}) \\\\ &=- e^{\\pi}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- e^{\\pi}.$"} {:db/id #edb/ref 17592186610517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342fedd-8d06-51bf-b9ad-5e63f5f5f982" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{8}" :db/id #edb/ref 17592186610505} {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} {:answer/id #uuid "c354a2c8-b0de-585b-8ee4-0a43e6df96a9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{27 \\pi^{2}}{2}" :db/id #edb/ref 17592186610525} {:answer/id #uuid "cb0129b4-44ea-5647-bf41-eda356ea7056" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{81 \\pi^{2}}{4}" :db/id #edb/ref 17592186610527} {:answer/id #uuid "e16fa939-f833-50c4-9a94-5a392aabfb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{81 \\pi^{2}}{16}" :db/id #edb/ref 17592186610529}] :answer-field/correct {:answer/id #uuid "173ff202-950a-5940-aabe-82d481b5d461" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi^{2}}{4}" :db/id #edb/ref 17592186610509} :answer-field/id #uuid "f04cda44-d833-5a4f-9cef-56d38d1b0af1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610531}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6996047e-7e31-5564-bb70-e58aabf2bfcd" :question/problem "If a curve $C$ is given by $y=(- x^{3})\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{2}$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{3}$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 3 x^{2},\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(- x^{3})\\cdot (\\cos{\\left(x \\right)}) \\\\ &{}+(\\sin{\\left(x \\right)})\\cdot (- 3 x^{2})\\end{aligned} \\\\ &=- x^{2} \\left(x \\cos{\\left(x \\right)} + 3 \\sin{\\left(x \\right)}\\right).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{2}} &=\\begin{aligned}&(- \\left(\\frac{3 \\pi}{2}\\right)^{3})\\cdot (\\cos{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)}) \\\\ &{}+(\\sin{\\left(\\left(\\frac{3 \\pi}{2}\\right) \\right)})\\cdot (- 3 \\left(\\frac{3 \\pi}{2}\\right)^{2})\\end{aligned} \\\\ &=\\begin{aligned}&\\left(- \\frac{27 \\pi^{3}}{8}\\right)\\cdot (0) \\\\ &{}+(-1)\\cdot \\left(- \\frac{27 \\pi^{2}}{4}\\right)\\end{aligned} \\\\ &=\\frac{27 \\pi^{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{27 \\pi^{2}}{4}.$"} {:db/id #edb/ref 17592186610519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510}] :answer-field/correct {:answer/id #uuid "1a49124e-b359-593a-a72b-ef618ed162eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}" :db/id #edb/ref 17592186610510} :answer-field/id #uuid "0f7d6f26-56ba-523c-91e9-3177f7b66fb2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610507}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ecb8282-6295-5cd9-a5b5-e1bb578640a9" :question/problem "If a curve $C$ is given by $y=(4 x + 1)\\cdot (\\cos{\\left(x \\right)}),$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 x + 1$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=4,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(4 x + 1)\\cdot (- \\sin{\\left(x \\right)}) \\\\ &{}+(\\cos{\\left(x \\right)})\\cdot (4)\\end{aligned} \\\\ &=-(4 x + 1)\\sin x+4\\cos x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(4 \\left(\\frac{\\pi}{4}\\right) + 1)\\cdot (- \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (4)\\end{aligned} \\\\ &=\\begin{aligned}&(1 + \\pi)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &{}+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (4)\\end{aligned} \\\\ &=\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(3 - \\pi\\right)}{2}.$"} {:db/id #edb/ref 17592186610528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520}] :answer-field/correct {:answer/id #uuid "8a274896-90a4-56a0-b45a-65385719edf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}" :db/id #edb/ref 17592186610520} :answer-field/id #uuid "3187eef1-7f80-587b-a0fe-39dc0cb198ff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186610513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de532b59-dfad-573f-bd25-b6a82e67e141" :question/problem "Given $f(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}$, if a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}.$\n\nSlope $\\,=$\n{{field-1}}" :question/retired true :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=1,\\quad v'(x)=\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=\\begin{aligned}&(x)\\cdot (\\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}) \\\\ &{}+(- 3 \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\begin{aligned}&(x - 3)\\cdot (\\sin{\\left(x \\right)}) \\\\ &{}+(- 3 x - 1)\\cdot (\\cos{\\left(x \\right)})\\end{aligned}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=\\begin{aligned}&(\\left(\\frac{\\pi}{4}\\right))\\cdot (\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - 3 \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)}) \\\\ &{}+(- 3 \\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)} - \\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (1)\\end{aligned} \\\\ &=\\left(\\frac{\\pi}{4}\\right)\\cdot (- \\sqrt{2})+(- 2 \\sqrt{2})\\cdot (1) \\\\ &=\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(-8 - \\pi\\right)}{4}.$"} {:db/id #edb/ref 17592186615560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} {:answer/id #uuid "633cee45-d59f-53de-923d-085faddb4ddb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186615556} {:answer/id #uuid "7c1183b0-b75b-534f-9f78-973a4bb01276" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186615558} {:answer/id #uuid "cf15d09f-7e8e-5f63-801d-3da408b8e869" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186615559} {:answer/id #uuid "f8866bcc-2a42-5656-b565-ee15147b562d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186615561}] :answer-field/correct {:answer/id #uuid "2a1e78ab-8788-5174-8ffd-7a2cc15b6e42" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186615555} :answer-field/id #uuid "691ad0ef-2a57-5243-bdf1-ddb48cf7a828" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186615557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d5190bc4-2336-5db6-bb75-17e05e48e8ff" :question/problem "If a curve $C$ is given by $y=(2 e^{x})\\cdot (x - 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=2 e^{x}$ and $v(x)=x - 1.$ Then, we have\n\n$$\nu'(x)=2 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(2 e^{x})\\cdot (1)+(x - 1)\\cdot (2 e^{x}) \\\\ &=2 x e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=\\begin{aligned}&(2 e^{(0)})\\cdot (1) \\\\ &{}+((0) - 1)\\cdot (2 e^{(0)})\\end{aligned} \\\\ &=(2)\\cdot (1)+(-1)\\cdot (2) \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$"}] :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}]}
