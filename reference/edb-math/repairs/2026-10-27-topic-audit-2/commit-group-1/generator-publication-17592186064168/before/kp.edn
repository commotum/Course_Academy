 \\frac{5}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/5})+0 \\\\ &= \\frac{5}{9}\\cdot \\frac{9}{5}{x}^{9/5-1} \\\\ &= {x}^{4/5}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186585088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517}] :answer-field/correct {:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517} :answer-field/id #uuid "d2400e32-0626-57f4-aa86-36f297e53f28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585001}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "94477f44-1be5-5969-98a4-26af9184571a" :question/math-academy-id "q-167646" :question/problem "The antiderivative of $\\sqrt[6]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{\\left(\\frac{7}{6}\\right)}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{6{x}^{7/6}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 \\\\ &= \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} \\\\ &= {x}^{1/6}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186587304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733}] :answer-field/correct {:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733} :answer-field/id #uuid "3d10d539-8c5e-514d-8877-3d19db95faab" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587183}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3efb6512-0e32-57d7-9bcc-102471dd5cbb" :question/math-academy-id "q-167541" :question/problem "The antiderivative of $\\sqrt[4]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186632107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383c9cf4-9999-544c-9991-3e389d1e8202" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{13/4}}{6} + C" :db/id #edb/ref 17592186632105} {:answer/id #uuid "ab127b7a-c644-50b9-bc45-4f314b20034a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{13/4}}{7} + C" :db/id #edb/ref 17592186632115} {:answer/id #uuid "ae4352af-5818-5677-9495-de1a6e17db7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{7/4}}{11} + C" :db/id #edb/ref 17592186632116} {:answer/id #uuid "b947531c-3eee-5e80-84c9-04e32ec0a073" :answer/type {