#{[{:db/id #edb/ref 17592186299799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bfce910-f1a6-55e0-aa0a-ef391e8972f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298162}] :answer-field/correct {:answer/id #uuid "8bfce910-f1a6-55e0-aa0a-ef391e8972f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298162} :answer-field/id #uuid "2b17fdea-2304-5379-9c2f-9f4ff86470d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298785}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcf49dc9-80d7-5610-a247-cb1da3f12efe" :question/math-academy-id "q-319842" :question/problem "If a curve $C$ is given by $y=({x}^{2}-4x+7){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=0$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{2}-4x+7$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-4,\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{2}-4x+7)\\cdot {e}^{x}+{e}^{x}\\cdot (2x-4) \\\\  & ={e}^{x}({x}^{2}-2x+3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={{e}^{x}({x}^{2}-2x+3)|}_{x=0} \\\\  & =1\\cdot (0-0+3)=3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186299804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757} {:answer/id #uuid "fb9ed3fa-86d1-4803-8dcc-ef4b061d6628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^2e^{x}" :db/id #edb/ref 17592186576149}] :answer-field/correct {:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757} :answer-field/id #uuid "f623b835-9c91-54d1-9180-2267f616a2e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299472}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b53a0674-b02c-54b5-9306-2aa04fbf2674" :question/math-academy-id "q-319902" :question/problem "Given that $f(x)={x}^{3}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,{x}^{3}{e}^{x}$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{3}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{3})^{′}{e}^{x}+{x}^{3}({e}^{x})^{′} \\\\  & =(3{x}^{2})({e}^{x})+({x}^{3})({e}^{x}) \\\\  & =3{x}^{2}{e}^{x}+{x}^{3}{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807}] :answer-field/correct {:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807} :answer-field/id #uuid "1f735430-71e8-5777-be52-a2e57f486a49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298744}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7e457c64-526b-50d2-a5e1-9c9608789ec6" :question/math-academy-id "q-319903" :question/problem "Given that $f(x)=5{x}^{2}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=10x{e}^{x}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=5{x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(5{x}^{2})^{′}{e}^{x}+5{x}^{2}({e}^{x})^{′} \\\\  & =(10x)({e}^{x})+(5{x}^{2})({e}^{x}) \\\\  & =10x{e}^{x}+5{x}^{2}{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75315d65-aa09-5cc6-9834-96090e5d51ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is exact" :db/id #edb/ref 17592186298059} {:answer/id #uuid "9e29e5ad-cfdd-53ef-b6c3-c3e5314727b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not  exact" :db/id #edb/ref 17592186298247}] :answer-field/correct {:answer/id #uuid "9e29e5ad-cfdd-53ef-b6c3-c3e5314727b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not  exact" :db/id #edb/ref 17592186298247} :answer-field/id #uuid "4b69aac3-c4ec-51d9-bbc6-2586c8006024" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186298889} {:answer-field/choices [{:answer/id #uuid "4398be54-0862-5835-b18c-baf4cc6e4ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+{y}^{2}{e}^{xy}" :db/id #edb/ref 17592186297825} {:answer/id #uuid "737de313-117e-5dd0-881f-1b34b5ad9571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{ }{e}^{xy}+xy{e}^{xy}" :db/id #edb/ref 17592186298053} {:answer/id #uuid "c3050d7c-2df6-5bf4-9092-5b3d6c6b2836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :ans