er/id #uuid "2874b89b-043d-584b-9dd3-fe271e45f056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂^{2}P}{∂y^{2}} = \\frac{∂^{2}Q}{∂x^{2}}" :db/id #edb/ref 17592186144317} {:answer/id #uuid "550a1bb8-d948-562d-ab97-32bcf3a9bf37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂x} = \\frac{∂Q}{∂y}" :db/id #edb/ref 17592186144318} {:answer/id #uuid "6a6aa82b-baef-5f3e-80f7-7c096c53fd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂x} =-\\frac{∂Q}{∂y}" :db/id #edb/ref 17592186144319}] :answer-field/id #uuid "9827a3d2-9ffa-5404-af76-8f4544c753be" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186144315}] :question/id #uuid "0254fa61-1b3f-58a8-b0d3-66f0878be7ea" :question/math-academy-id "q-320435" :question/problem "Determine whether the following differential equation is exact:\n$(2 + y^{2}e^{xy})dx + (xe^{xy} - 2y)dy = 0$A differential equation of the form\n\n$P(x, y)dx + Q(x, y)dy = 0$\n\nis exact if it satisfies the condition\n\n$\\frac{∂P}{∂x} = \\frac{∂Q}{∂y}$ {{field-1}}"}] [{:db/id #edb/ref 17592186148118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae82278-f821-5cc5-82d8-87a163279b8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186146463} {:answer/id #uuid "40d36e5f-5f77-5cd5-ba0d-db70a5b16293" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186146464} {:answer/id #uuid "4e2806a0-a1e6-5af4-b15b-7ea6a61f75cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186146465} {:answer/id #uuid "5c7dbae3-3bef-52be-951c-eb4319842fba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186146466} {:answer/id #uuid "7ce3846e-ee81-5611-a15d-533c3ad12cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186146467}] :answer-field/id #uuid "716cb05d-ff6a-5de7-a67c-fffcba018fdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146462}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be15d54e-b542-5d95-9a86-79b1b9761b78" :question/math-academy-id "q-64180" :question/problem "Consider the following differential equation:\n\n$P(x, y)dx + (2y + x)dy = 0$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x, y)$?\n\n1. $2x + y$\n2. $y + 5$\n3. $x^{2}$"}] [{:db/id #edb/ref 17592186148119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386ba770-7949-5770-8438-b93925294ff3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy-{y}^{3}=c" :db/id #edb/ref 17592186330455} {:answer/id #uuid "607be18b-1640-5d1d-9024-92d9e0b3f07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y-\\frac{{y}^{3}}{3}=c" :db/id #edb/ref 17592186330807} {:answer/id #uuid "9773f37f-f36d-5eb7-853d-ad3b4517c55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{3}=c" :db/id #edb/ref 17592186331299} {:answer/id #uuid "aacbd12d-fc72-5dd7-a8df-b88b0223d40b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}y-\\frac{{y}^{3}}{3}=c" :db/id #edb/ref 17592186331463} {:answer/id #uuid "b1a512db-a79b-5093-b3f6-390bfb8853f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-{y}^{3}=c" :db/id #edb/ref 17592186331521}] :answer-field/correct {:answer/id #uuid "607be18b-1640-5d1d-9024-92d9e0b3f07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y-\\frac{{y}^{3}}{3}=c" :db/id #edb/ref 17592186330807} :answer-field/id #uuid "226cb83d-b6d7-53db-9d4f-009818dbe688" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332251}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df67849a-ff15-50d7-b222-6addffd2bf34" :question/math-academy-id "q-64181" :question/problem "Find the general solution of the exact differential equation\n\n$$\n2xy\\,\\text{d}x+({x}^{2}-{y}^{2})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=2xy$ and $Q(x,y)={x}^{2}-{y}^{2}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$:\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int 2xy\\,\\text{d}x+f(y) \\\\  & ={x}^{2}y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x.$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int {x}^{2}-{y}^{2}\\,\\text{d}y+g(x) \\\\  & ={x}^{2}y-\\frac{{y}^{3}}{3}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=0,\\,f(y)=-\\frac{{y}^{3}}{3}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n{x}^{2}y-\\frac{{y}^{3}}{3}=c.\n$$"}] [{:db/id #edb/ref 17592186148124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab4ed6ae-1ce2-5a4f-bcea-2d90bc5e26c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477359} {:answer/id #uuid "a90f908e-b50c-5fc6-98d5-d3ee03483734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477360}] :answer-field/correct {:answer/id #uuid "a90f908e-b50c-5fc6-98d5-d3ee03483734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477360} :answer-field/id #uuid "260494a3-24fd-5d03-9b46-a57dd7b573d7" :answer-field/key "$\\operatorname{cos}⁡(x)+8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477649} {:answer-field/choices [{:answer/id #uuid "7ce6d580-bd25-5de4-9c47-35da644ce89e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477361} {:answer/id #uuid "bd0d635d-731b-509a-8d92-963d69a26fd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477362}] :answer-field/correct {:answer/id #uuid "bd0d635d-731b-509a-8d92-963d69a26fd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477362} :answer-field/id #uuid "96533529-82af-51f4-a2cc-2cce38270790" :answer-field/key "$\\operatorname{ln}⁡(x+1)-2$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477650} {:answer-field/choices [{:answer/id #uuid "b78f8562-de4c-5f73-b774-ca8d83a4c2e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477363} {:answer/id #uuid "79a41a96-393a-564b-bc1a-342f6fa0f531" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477364}] :answer-field/correct {:answer/id #uuid "79a41a96-393a-564b-bc1a-342f6fa0f531" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477364} :answer-field/id #uuid "2d1d1243-74c1-5f70-adf7-8511d7c94a0e" :answer-field/key "$2x+7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c92b66b-ccec-5e6d-8f75-9e3b9cdb1f7e" :question/math-academy-id "q-64207" :question/problem "Consider the following differential equation:\n\n$$\nP(x,y)\\,\\text{d}x+4{y}^{3}\\,\\text{d}y=0\n$$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x,y)?$\n\nSelect all that apply." :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}\n$$\n\nIn our case, we're given $Q(x,y)=4{y}^{3}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(4{y}^{3})=0\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=\\operatorname{cos}⁡(x)+8.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}⁡(x)+8)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{cos}⁡(x)+8$ gives an exact equation.\n\n- Next, we check $P(x,y)=\\operatorname{ln}⁡(x+1)-2:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+1)-2)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{ln}⁡(x+1)-2$ gives an exact equation.\n\n- Finally, we check $P(x,y)=2x+7:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2x+7)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2x+7$ gives an exact equation."}] [{:db/id #edb/ref 17592186148125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd06ae0-fa12-516e-8f05-1659cbdc0500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+xy+{e}^{y}=e" :db/id #edb/ref 17592186330353} {:answer/id #uuid "4d6db708-9f93-5f17-8a6e-0e16ca96b6b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+{e}^{xy}=2" :db/id #edb/ref 17592186330654} {:answer/id #uuid "582ffc91-7d15-50c5-bb34-9b55f9c8ba1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{e}^{xy}=1" :db/id #edb/ref 17592186330736} {:answer/id #uuid "982f30b3-659a-5cae-b729-1686ad5dacde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy+{e}^{xy}=1" :db/id #edb/ref 17592186331307} {:answer/id #uuid "db99ee87-ab3a-542a-a618-7f641ca66395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=-1" :db/id #edb/ref 17592186331896}] :answer-field/correct {:answer/id #uuid "2dd06ae0-fa12-516e-8f05-1659cbdc0500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+xy+{e}^{y}=e" :db/id #edb/ref 17592186330353} :answer-field/id #uuid "0e7c04fa-c383-54df-bcc6-9142185fd4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9efa7792-8965-523c-b567-7789ca6c3aa3" :question/math-academy-id "q-64215" :question/problem "Find the solution of the exact differential equation\n\n$$\n(4+y)\\text{d}x+(x+{e}^{y})\\text{d}y=0\n$$\n\nthat satisfies the initial condition $y(0)=1.$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=4+y$ and $Q(x,y)=x+{e}^{y}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (4+y)\\text{d}x+f(y) \\\\  & =4x+xy+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x+{e}^{y})\\text{d}y+g(x) \\\\  & =xy+{e}^{y}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=4x,\\,f(y)={e}^{y}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n4x+xy+{e}^{y}=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=1$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}4x+xy+{e}^{y} & =c \\\\ 4(0)+(0)(1)+{e}^{1} & =c \\\\ c & =e\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n4x+xy+{e}^{y}=e.\n$$"}]}
