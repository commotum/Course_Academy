.type/math} :answer/value "-3x+\\frac{x^{7}}{2}+C" :db/id #edb/ref 17592186671058} {:answer/id #uuid "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{7}}{2}+C" :db/id #edb/ref 17592186671063} {:answer/id #uuid "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186671064} {:answer/id #uuid "eb50de8c-ecdb-5560-895f-fa5d14eae046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x+\\frac{x^{7}}{2}+C" :db/id #edb/ref 17592186671067}] :answer-field/correct {:answer/id #uuid "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186671064} :answer-field/id #uuid "01f4f87a-a45e-52f0-8489-eb5074709047" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671046}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "420d5e76-0051-5ab1-a5d9-92d8e39b4f48" :question/problem "$$\n\\displaystyle\\int \\left(-6+x^{6}\\right)\\,\\mathrm{d}x=\n$$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-6+x^{6}\\right)\\,\\mathrm{d}x &= \\int \\left(-6+x^{6}\\right)\\,\\mathrm{d}x \\\\ &= -6\\int 1\\,\\mathrm{d}x+\\int x^{6}\\,\\mathrm{d}x \\\\ &= -6\\frac{x^{0+1}}{(0+1)}+\\frac{x^{6+1}}{(6+1)}+C \\\\ &= -6x+\\frac{x^{7}}{7}+C\\end{aligned}\n$$"}]}
