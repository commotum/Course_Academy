up our points and drawing our line segments, we get the following diagram.\n\n![](images/f3/f3e9db617e68f21ff03b3d5bf57764da9d6a0ddd81f18f718cc2c47b60c35eac.png)"}] [{:db/id #edb/ref 17592186670978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07cf43fd-8a0c-5ee4-ac88-49fe77424a28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{3}+\\frac{3}{x}+C" :db/id #edb/ref 17592186670977} {:answer/id #uuid "25025c0b-22c8-58be-89a1-99ae4717a596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{3}{x}+C" :db/id #edb/ref 17592186670981} {:answer/id #uuid "55758766-cfa5-550e-b651-5f45a8c7a409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{3}}{4}+\\frac{3}{x}+C" :db/id #edb/ref 17592186670988} {:answer/id #uuid "6424b0c5-4710-5ee2-992a-ed0bd6deacfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{3}+\\frac{3}{x^{2}}+C" :db/id #edb/ref 17592186670990} {:answer/id #uuid "7e871e26-7307-510f-86a2-758b288ac386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^{6}}{2}+\\frac{3}{x^{3}}+C" :db/id #edb/ref 17592186670993}] :answer-field/correct {:answer/id #uuid "7e871e26-7307-510f-86a2-758b288ac386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^{6}}{2}+\\frac{3}{x^{3}}+C" :db/id #edb/ref 17592186670993} :answer-field/id #uuid "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/problem "$$\n\\displaystyle \\int \\frac{-3x^{9}-9}{x^{4}}\\,\\mathrm{d}x=\n$$\n\nAssume $x\\ne 0$." :question/retired true :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{-3x^{9}-9}{x^{4}}\\,\\mathrm{d}x &= \\int \\left(- 3 x^{5} - \\frac{9}{x^{4}}\\right)\\,\\mathrm{d}x \\\\ &=-3\\int x^{5}\\,\\mathrm{d}x-9\\int x^{-4}\\,\\mathrm{d}x \\\\ &=-3\\left(\\frac{x^{6}}{6}\\right)-9\\left(\\frac{x^{-3}}{-3}\\right)+C \\\\ &=-\\frac{x^{6}}{2}+\\frac{3}{x^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186670986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3328c1d2-6efa-50ac-bfe9-b1c50039b7b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{x^{3}}}{3}+\\frac{6}{\\sqrt{x}}+C" :db/id #edb/ref 17592186670984} {:answer/id #uuid "41ac046f-7739-5958-bd31-a220fcb8b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{x^{5}}}{5}+\\sqrt{x^{3}}+C" :db/id #edb/ref 17592186670985} {:answer/id #uuid "7213b353-1938-5ee2-a89b-5640e0bcc412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C" :db/id #edb/ref 17592186670992} {:answer/id #uuid "adab723c-38a1-57a8-b713-85077ef4ba73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5\\sqrt{x^{5}}}{2}+\\frac{9\\sqrt{x^{3}}}{2}+C" :db/id #edb/ref 17592186670997} {:answer/id #uuid "d277f239-e741-54b9-a814-6854479a7ac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{x^{3}}}{3}-\\frac{6}{\\sqrt{x}}+C" :db/id #edb/ref 17592186671003}] :answer-field/correct {:answer/id #uuid "7213b353-1938-5ee2-a89b-5640e0bcc412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C" :db/id #edb/ref 17592186670992} :answer-field/id #uuid "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "495005c7-eb12-5d76-a716-3e1056b120cd" :question/problem "Calculate $$\n\\displaystyle \\int \\sqrt{x}\\left(-x+3\\right)\\,\\mathrm{d}x\n$$ for $x>0$." :question/retired true :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}\\left(-x+3\\right)\\,\\mathrm{d}x &= \\int \\left(- x^{\\frac{3}{2}} + 3 \\sqrt{x}\\right)\\,\\mathrm{d}x \\\\ &=-\\int x^{\\frac{3}{2}}\\,\\mathrm{d}x+3\\int x^{\\frac{1}{2}}\\,\\mathrm{d}x \\\\ &=-\\left(\\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}}\\right)+3\\left(\\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}}\\right)+C \\\\ &=-\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186670987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89379a7b-fe01-54ed-83cf-d2a57bd45625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{5}}{5}+\\frac{6}{x}+C" :db/id #edb/ref 17592186670994} {:answer/id #uuid "9d86ef84-6787-5c0f-8af8-6271f1c53f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{2}+\\frac{6}{x^{3}}+C" :db/id #edb/ref 17592186670996} {:answer/id #uuid "c5e6be45-47be-53e1-8e43-eec6a7077b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{4}}{5}+\\frac{6}{x}+C" :db/id #edb/ref 17592186671001} {:answer/id #uuid "cb0320d4-11db-54bd-b339-eb83e7ef1f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{7}}{7}+\\frac{6}{x}+C" :db/id #edb/ref 17592186671002} {:answer/id #uuid "d7c35a45-5ec7-5e78-aec9-ece2a7907635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{2}+\\frac{6}{x^{2}}+C" :db/id #edb/ref 17592186671004}] :answer-field/correct {:answer/id #uuid "cb0320d4-11db-54bd-b339-eb83e7ef1f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{7}}{7}+\\frac{6}{x}+C" :db/id #edb/ref 17592186671002} :answer-field/id #uuid "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670995}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/problem "$$\n\\displaystyle \\int \\frac{2x^{8}-6}{x^{2}}\\,\\mathrm{d}x=\n$$\n\nAssume $x\\ne 0$." :question/retired true :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{2x^{8}-6}{x^{2}}\\,\\mathrm{d}x &= \\int \\left(2 x^{6} - \\frac{6}{x^{2}}\\right)\\,\\mathrm{d}x \\\\ &=2\\int x^{6}\\,\\mathrm{d}x-6\\int x^{-2}\\,\\mathrm{d}x \\\\ &=2\\left(\\frac{x^{7}}{7}\\right)-6\\left(\\frac{x^{-1}}{-1}\\right)+C \\\\ &=\\frac{2x^{7}}{7}+\\frac{6}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186670991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dde38843-02ec-58cb-aa01-7203f5075161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{6}{x}" :db/id #edb/ref 17592186671006} {:answer/id #uuid "465c49a6-54af-40bc-8e54-4ea02885f904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^4}{4}-3x^2" :db/id #edb/ref 17592186671079}] :answer-field/correct {:answer/id #uuid "dde38843-02ec-58cb-aa01-7203f5075161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{6}{x}" :db/id #edb/ref 17592186671006} :answer-field/id #uuid "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186670999}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/problem "Given $f(x)=3x^{3}-6x$ and $x\\ne 0$, calculate the integral.\n\n$$\n\\displaystyle \\int \\frac{f(x)}{x^{3}}\\,\\mathrm{d}x=\n$$\n{{field-1}}\n$+C.$" :question/retired true :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{x^{3}}\\,\\mathrm{d}x &= \\int \\frac{3x^{3}-6x}{x^{3}}\\,\\mathrm{d}x \\\\ &=\\int \\left(3 - \\frac{6}{x^{2}}\\right)\\,\\mathrm{d}x \\\\ &=3\\int 1\\,\\mathrm{d}x-6\\int x^{-2}\\,\\mathrm{d}x \\\\ &=3\\left(\\frac{x}{1}\\right)-6\\left(\\frac{x^{-1}}{-1}\\right)+C \\\\ &=3x+\\frac{6}{x}+C.\\end{aligned}\n$$\n\nThe blank excludes the constant $C$, which is already supplied."}] [{:db/id #edb/ref 17592186670998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a16b47-dc19-56f0-83b0-7d1355df4d46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{x^{5}}}{2}+\\frac{9\\sqrt{x^{3}}}{2}+C" :db/id #edb/ref 17592186670980} {:answer/id #uuid "281410b1-d1c8-583b-bde1-a2a4589ef7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x^{5}}}{5}+\\sqrt{x^{3}}+C" :db/id #edb/ref 17592186670982} {:answer/id #uuid "293e410d-2a5e-5635-9967-147d3af10204" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{3}+\\frac{6}{\\sqrt{x}}+C" :db/id #edb/ref 17592186670983} {:answer/id #uuid "bbec5ab2-11ab-50fc-8895-cc45046a7d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C" :db/id #edb/ref 17592186671000} {:answer/id #uuid "ecff5c64-99b1-5d89-a487-6a61fd889bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{3}-\\frac{6}{\\sqrt{x}}+C" :db/id #edb/ref 1759218