186671024} {:answer/id #uuid "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{2}-\\frac{4}{x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671025} {:answer/id #uuid "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671029}] :answer-field/correct {:answer/id #uuid "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C" :db/id #edb/ref 17592186671024} :answer-field/id #uuid "082c53aa-9037-5f6d-a94c-2dd53b9d5139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671011}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "028aa697-e6c4-5a0e-b03d-def9695eb209" :question/problem "Find the antiderivative of\n$$\n\\displaystyle -3x^{3}-\\frac{4}{x^{6}}+\\frac{1}{\\sqrt[5]{x^{6}}}.\n$$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(-3x^{3}-\\frac{4}{x^{6}}+\\frac{1}{\\sqrt[5]{x^{6}}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-3x^{3}-4x^{-6}+x^{\\frac{-6}{5}}\\right)\\,\\mathrm{d}x\\\\ &= -3\\int x^{3}\\,\\mathrm{d}x-4\\int x^{-6}\\,\\mathrm{d}x+\\int x^{\\frac{-6}{5}}\\,\\mathrm{d}x\\\\ &= -3\\left(\\frac{x^{3+1}}{(3+1)}\\right)-4\\left(\\frac{x^{-6+1}}{(-6+1)}\\right)\\\\ &\\quad +\\left(\\frac{x^{\\frac{-6}{5}+1}}{(\\frac{-6}{5}+1)}\\right)+C\\\\ &= -\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "890b50df-241b-5b4f-9df5-aa96000d95d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x^{15}}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671026} {:answer/id #uuid "8ff4abb2-d739-5206-9a76-cad17736caa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671027} {:answer/id #uuid "9cf31199-f10e-56b2-a2c9-e45b77728ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671030} {:answer/id #uuid "c073f955-67ff-5a29-b461-35e9524a9203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671035} {:answer/id #uuid "faefdad3-fda3-5db3-8593-70d8ae260a01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x^{15}}}-\\frac{1}{4x^{5}}+\\frac{3x^{8}}{7}+C" :db/id #edb/ref 17592186671043}] :answer-field/correct {:answer/id #uuid "9cf31199-f10e-56b2-a2c9-e45b77728ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C" :db/id #edb/ref 17592186671030} :answer-field/id #uuid "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671016}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/problem "Find the antiderivative of\n$$\n\\displaystyle -\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}.\n$$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(-\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-6x^{\\frac{-8}{7}}+x^{-5}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= -6\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x+\\int x^{-5}\\,\\mathrm{d}x+3\\int x^{7}\\,\\mathrm{d}x\\\\ &= -6\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)+\\left(\\frac{x^{-5+1}}{(-5+1)}\\right)\\\\ &\\quad +3\\left(\\frac{x^{7+1}}{(7+1)}\\right)+C\\\\ &= \\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1e9927-93b2-583b-9d94-b83a2fafc7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671023} {:answer/id #uuid "9ad435ba-c8ba-50c2-b5b3-e5b4219e660e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12}{5\\sqrt[3]{x}}+C" :db/id #edb/ref 17592186671028} {:answer/id #uuid "be2c096e-451f-52f5-a1a1-954febf897cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671034} {:answer/id #uuid "cae73af8-2404-5b99-bead-4ce52e4304e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{6x^{4}}{5}+\\frac{12}{5\\sqrt[3]{x}}+C" :db/id #edb/ref 17592186671037} {:answer/id #uuid "cfc99332-9b17-5d58-8af7-2a7308dc6928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{6x^{4}}{5}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671038}] :answer-field/correct {:answer/id #uuid "be2c096e-451f-52f5-a1a1-954febf897cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C" :db/id #edb/ref 17592186671034} :answer-field/id #uuid "ec585ac1-4fe5-537f-8aa6-ac15a56ee933" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671040}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/problem "Find the antiderivative of\n$\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}.$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(6x^{-2}+6x^{3}+4x^{\\frac{2}{3}}\\right)\\,\\mathrm{d}x\\\\ &= 6\\int x^{-2}\\,\\mathrm{d}x+6\\int x^{3}\\,\\mathrm{d}x+4\\int x^{\\frac{2}{3}}\\,\\mathrm{d}x\\\\ &= 6\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)+6\\left(\\frac{x^{3+1}}{(3+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{\\frac{2}{3}+1}}{(\\frac{2}{3}+1)}\\right)+C\\\\ &= -\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671009} {:answer/id #uuid "48985b06-1af2-5faa-b044-20977de06c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x^{15}}}+C" :db/id #edb/ref 17592186671019} {:answer/id #uuid "4ab25325-4150-524c-9b62-51299c24dabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671020} {:answer/id #uuid "5b99ecf4-da2e-5859-ad4f-f9152cc5a57a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{5}}+\\frac{42}{\\sqrt[7]{x^{15}}}+C" :db/id #edb/ref 17592186671022} {:answer/id #uuid "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{5}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671041}] :answer-field/correct {:answer/id #uuid "4ab25325-4150-524c-9b62-51299c24dabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C" :db/id #edb/ref 17592186671020} :answer-field/id #uuid "4c63ed41-ff98-562b-9155-b0554d9bc05e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671021}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7b48c65-5e5b-586a-af84-38b8bafff23c" :question/problem "Find the antiderivative of\n$$\n\\displaystyle 2x^{5}+\\frac{1}{x^{4}}-\\frac{6}{\\sqrt[7]{x^{8}}}.\n$$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(2x^{5}+\\frac{1}{x^{4}}-\\frac{6}{\\sqrt[7]{x^{8}}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(2x^{5}+x^{-4}-6x^{\\frac{-8}{7}}\\right)\\,\\mathrm{d}x\\\\ &= 2\\int x^{5}\\,\\mathrm{d}x+\\int x^{-4}\\,\\mathrm{d}x-6\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x\\\\ &= 2\\left(\\frac{x^{5+1}}{(5+1)}\\right)+\\left(\\frac{x^{-4+1}}{(-4+1)}\\right)\\\\ &\\quad -6\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)+C\\\\ &= \\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671013} {:answer/id #uuid "319d2248-2ed0-56eb-9111-9417cab477d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671015} {:answer/id #uuid "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671031} {:answer/id #uuid "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671033} {:answer/id #uuid "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C" :db/id #edb/ref 17592186671039}] :answer-field/correct {:answer/id #uuid "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C" :db/id #edb/ref 17592186671013} :answer-field/id #uuid "a3fae9bb-8131-5df6-aad0-a2b85876eb60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f708cae3-deab-525d-82c5-7fe0627c8526" :question/problem "Find the antiderivative of\n$$\n\\displaystyle \\frac{5}{\\sqrt[7]{x^{8}}}-\\frac{4}{x^{2}}+4x^{4}.\n$$ For real $x\\ne 0$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(\\frac{5}{\\sqrt[7]{x^{8}}}-\\frac{4}{x^{2}}+4x^{4}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(5x^{\\frac{-8}{7}}-4x^{-2}+4x^{4}\\right)\\,\\mathrm{d}x\\\\ &= 5\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x-4\\int x^{-2}\\,\\mathrm{d}x+4\\int x^{4}\\,\\mathrm{d}x\\\\ &= 5\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)-4\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{4+1}}{(4+1)}\\right)+C\\\\ &= -\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2t+\\frac{t^{7}}{7}" :db/id #edb/ref 17592186671060}] :answer-field/correct {:answer/id #uuid "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2t+\\frac{t^{7}}{7}" :db/id #edb/ref 17592186671060} :answer-field/id #uuid "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671048}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "10e82ee6-837f-5483-bbea-742bf32b5839" :question/problem "Given $y'(t)=-2+t^{6}$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" :question/retired true :question/worked-solution "We know that $y'(t)=-2+t^{6}$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-2+t^{6}\\right)\\,\\mathrm{d}t &= \\int \\left(-2+t^{6}\\right)\\,\\mathrm{d}t \\\\ &= -2\\int 1\\,\\mathrm{d}t+\\int t^{6}\\,\\mathrm{d}t \\\\ &= -2\\frac{t^{0+1}}{(0+1)}+\\frac{t^{6+1}}{(6+1)}+C \\\\ &= -2t+\\frac{t^{7}}{7}+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."}] [{:db/id #edb/ref 17592186671050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "265d13c3-577d-5fac-a55b-51d15a808773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t^{3}}{3}+6t" :db/id #edb/ref 17592186671049}] :answer-field/correct {:answer/id #uuid "265d13c3-577d-5fac-a55b-51d15a808773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t^{3}}{3}+6t" :db/id #edb/ref 17592186671049} :answer-field/id #uuid "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671055}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/problem "Given $y'(t)=-t^{2}+6$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" :question/retired true :question/worked-solution "We know that $y'(t)=-t^{2}+6$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-t^{2}+6\\right)\\,\\mathrm{d}t &= \\int \\left(-t^{2}+6\\right)\\,\\mathrm{d}t \\\\ &= -\\int t^{2}\\,\\mathrm{d}t+6\\int 1\\,\\mathrm{d}t \\\\ &= -\\frac{t^{2+1}}{(2+1)}+6\\frac{t^{0+1}}{(0+1)}+C \\\\ &= -\\frac{t^{3}}{3}+6t+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."}] [{:db/id #edb/ref 17592186671051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a90f9a-b732-5698-877a-1b43e8e0388a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t-\\frac{2}{\\sqrt{t}}+C" :db/id #edb/ref 17592186671045} {:answer/id #uuid "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t-\\frac{2}{\\sqrt{t}}+C" :db/id #edb/ref 17592186671052} {:answer/id #uuid "3c5a129e-e655-5463-8fa5-e610d85ece00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answ