^{13/4}}{6} + C" :db/id #edb/ref 17592186632105} {:answer/id #uuid "ab127b7a-c644-50b9-bc45-4f314b20034a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{13/4}}{7} + C" :db/id #edb/ref 17592186632115} {:answer/id #uuid "ae4352af-5818-5677-9495-de1a6e17db7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{7/4}}{11} + C" :db/id #edb/ref 17592186632116} {:answer/id #uuid "b947531c-3eee-5e80-84c9-04e32ec0a073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{7/4}}{6} + C" :db/id #edb/ref 17592186632118} {:answer/id #uuid "d907ffd1-f01c-539b-a1de-9df33d4a67e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{7/4}}{7} + C" :db/id #edb/ref 17592186632122}] :answer-field/correct {:answer/id #uuid "d907ffd1-f01c-539b-a1de-9df33d4a67e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{7/4}}{7} + C" :db/id #edb/ref 17592186632122} :answer-field/id #uuid "3c2dc46f-f898-5487-b33d-e094e125e98f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632106}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "477b81fd-0d41-5aeb-9d0d-bfba79f45ad8" :question/problem "Find the antiderivative of ${x}^{3/4}.$\n\nWork on $x>0$." :question/worked-solution "We can apply the power rule with $n=\\frac{3}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{3/4}\\,\\text{d}x & =\\frac{{x}^{3/4+1}}{(\\frac{3}{4}+1)}+C \\\\  & =\\frac{{x}^{7/4}}{\\left(\\frac{7}{4}\\right)}+C \\\\  & =\\frac{4{x}^{7/4}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{7/4}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{7/4}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/4})+0 \\\\ &= \\frac{4}{7}\\cdot \\frac{7}{4}{x}^{7/4-1} \\\\ &= {x}^{3/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f8b77e-17f1-5387-a87d-23a3ff99934a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{1/3} + C" :db/id #edb/ref 17592186632098} {:answer/id #uuid "12bd4168-b5bc-5325-b188-fea546b91b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{4/3} + C" :db/id #edb/ref 17592186632099} {:answer/id #uuid "32e4276b-e685-51a3-8475-846db1f81282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{1/3}}{4} + C" :db/id #edb/ref 17592186632103} {:answer/id #uuid "c83531c0-b308-538b-9af3-84d795465990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4} + C" :db/id #edb/ref 17592186632120} {:answer/id #uuid "d5440c18-c6db-51ff-ae2c-962a62da086d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{1/3}}{7} + C" :db/id #edb/ref 17592186632121}] :answer-field/correct {:answer/id #uuid "c83531c0-b308-538b-9af3-84d795465990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4} + C" :db/id #edb/ref 17592186632120} :answer-field/id #uuid "6b4df830-d99b-539d-9e07-f753f79c3cf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632108}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "757ec083-21ed-5196-b6d1-4055aef04474" :question/problem "Find the antiderivative of ${x}^{1/3}.$\n\nWork on $x>0$." :question/worked-solution "We can apply the power rule with $n=\\frac{1}{3}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/3}\\,\\text{d}x & =\\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =\\frac{{x}^{4/3}}{\\left(\\frac{4}{3}\\right)}+C \\\\  & =\\frac{3{x}^{4/3}}{4}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{4/3}}{4}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{3{x}^{4/3}}{4}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{3}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4/3})+0 \\\\ &= \\frac{3}{4}\\cdot \\frac{4}{3}{x}^{4/3-1} \\\\ &= {x}^{1/3}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70bf4863-92e7-5e95-9fd6-c2a589917968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{9/4}}{9}" :db/id #edb/ref 17592186632109}] :answer-field/correct {:answer/id #uuid "70bf4863-92e7-5e95-9fd6-c2a589917968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{9/4}}{9}" :db/id #edb/ref 17592186632109} :answer-field/id #uuid "b84da965-e3fc-5ba0-9917-0cb5af5d27bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186632117}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b882599-473b-551d-be43-1f32e525912f" :question/problem "Find the antiderivative of ${x}^{5/4}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We can apply the power rule with $n=\\frac{5}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{5/4}\\,\\text{d}x & =\\frac{{x}^{5/4+1}}{(\\frac{5}{4}+1)}+C \\\\  & =\\frac{{x}^{9/4}}{\\left(\\frac{9}{4}\\right)}+C \\\\  & =\\frac{4{x}^{9/4}}{9}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{9/4}}{9}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{9/4}}{9}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9/4})+0 \\\\ &= \\frac{4}{9}\\cdot \\frac{9}{4}{x}^{9/4-1} \\\\ &= {x}^{5/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec493b07-43f5-5006-bf2b-4faff02253cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186632124}] :answer-field/correct {:answer/id #uuid "ec493b07-43f5-5006-bf2b-4faff02253cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186632124} :answer-field/id #uuid "78fa16cd-fb2e-5d4f-8ed2-80a699116f20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186632111}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a48b925b-78c0-5a09-affb-691438624f03" :question/problem "The antiderivative of $\\sqrt[3]{x}$ equals {{field-1}} $+C$.\n\nWork on $x>0$. Enter only the term before $+C$, with no additive constant." :question/retired true :question/worked-solution "Since $\\sqrt[3]{x}={x}^{1/3}$, we can apply the power rule with $n=\\frac{1}{3}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/3}\\,\\text{d}x & =\\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =\\frac{{x}^{4/3}}{\\left(\\frac{4}{3}\\right)}+C \\\\  & =\\frac{3{x}^{4/3}}{4}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{4/3}}{4}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{3{x}^{4/3}}{4}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{3}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4/3})+0 \\\\ &= \\frac{3}{4}\\cdot \\frac{4}{3}{x}^{4/3-1} \\\\ &= {x}^{1/3}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165347ea-8cc0-5126-bbd5-7fa6bd55f039" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{1}}{5} + C" :db/id #edb/ref 17592186632100} {:answer/id #uuid "236f3c6d-6e65-5105-a485-32f39b7fe38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{x}^{5/4}}{8} + C" :db/id #edb/ref 17592186632101} {:answer/id #uuid "249e2652-bbbb-5e2a-add1-2527b04b268e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{5/4}}{5} + C" :db/id #edb/ref 17592186632102} {:answer/id #uuid "a213afe2-4e5b-56cc-9508-969c8ab27731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{1}}{9} + C" :db/id #edb/ref 17592186632113} {:answer/id #uuid "e6e3cc44-b079-532e-b82f-181f8049ee49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{x}^{1}}{8} + C" :db/id #edb/ref 17592186632123}] :answer-field/correct {:answer/id #uuid "249e2652-bbbb-5e2a-add1-2527b04b268e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{x}^{5/4}}{5} + C" :db/id #edb/ref 17592186632102} :answer-field/id #uuid "3336ec14-fc88-58c0-bf1e-5c78ea812139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632104}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be181925-3dc1-585c-8a3a-66f07078c674" :question/problem "Find the antiderivative of ${x}^{1/4}.$\n\nWork on $x>0$." :question/worked-solution "We can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e4bb45-d508-5b70-8ed2-f20eeac35ac7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\sqrt{2}z" :db/id #edb/ref 17592186632180} {:answer/id #uuid "43a035f5-e17f-596a-ae9d-b69bc4af5b9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+3z" :db/id #edb/ref 17592186632233} {:answer/id #uuid "469b0701-86d6-5c2f-b831-b0922d1f108a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}-3z" :db/id #edb/ref 17592186632243} {:answer/id #uuid "6a1394b3-db21-57d8-8761-69658e219f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}+3z" :db/id #edb/ref 17592186632304} {:answer/id #uuid "d7fea6f7-ac67-5882-b9b2-ba8e1ad1c432" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-3z" :db/id #edb/ref 17592186632473}] :answer-field/correct {:answer/id #uuid "d7fea6f7-ac67-5882-b9b2-ba8e1ad1c432" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-3z" :db/id #edb/ref 17592186632473} :answer-field/id #uuid "8b8c93d5-4aa0-5aa8-8854-3c4446fcbfee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632607}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c832111-7e26-5f06-bbf5-0fe500587e8b" :question/math-academy-id "q-69648" :question/problem "$$\n\\displaystyle \\begin{vmatrix}\\sqrt{2} & z \\\\ 3 & \\sqrt{2}\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{2} & 3 \\\\ z & \\sqrt{2}\\end{vmatrix} & =\\sqrt{2}\\cdot \\sqrt{2}-z\\cdot 3 \\\\  & =2-3z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a492949-3bd3-5139-a09e-bd9913dab194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186632169} {:answer/id #uuid "60936ee6-077a-5769-8dc2-3c8fefce1f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186632286} {:answer/id #uuid "8ef20736-29c1-50f0-84a6-1558444988de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6" :db/id #edb/ref 17592186632364} {:answer/id #uuid "ca1c6019-99d5-5cac-a1f8-9077432f3728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186632446} {:answer/id #uuid "f70a2a78-ceac-54fe-b05a-31a8e59bf980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186632529}] :answer-field/correct {:answer/id #uuid "ca1c6019-99d5-5cac-a1f8-9077432f3728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186632446} :answer-field/id #uuid "10a75dfb-dbb7-5551-954d-06078da5405d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632550}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "67bf1af6-08b7-5d3a-b028-0c31c332e000" :question/math-academy-id "q-11647" :question/problem "If\n$$\n\\displaystyle B=\\begin{bmatrix}2 & x \\\\ 2 & 6\\end{bmatrix}\n$$\nand\n$\\text{det}(B)=2$, what is the value of $x?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(B) & =\\begin{vmatrix}2 & x \\\\ 2 & 6\\end{vmatrix} \\\\  & =2\\cdot 6-x\\cdot 2 \\\\  & =12-2x.\\end{aligned}\n$$\n\n \n\nSince $det(B)=2$, we get:\n\n$$\n\\begin{aligned}det(B) & =2 \\\\ 12-2x & =2 \\\\ -2x & =2-12 \\\\ -2x & =-10 \\\\ x & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d076a4-6367-5487-9f22-ea5c34784e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186632215}] :answer-field/correct {:answer/id #uuid "37d076a4-6367-5487-9f22-ea5c34784e3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186632215} :answer-field/id #uuid "c2f8f65c-9492-5e44-a731-352186ac01a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186632623}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "948a413c-4dce-57f7-8b58-de4a73761168" :question/math-academy-id "q-275599" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+t & 4t \\\\ -3 & 3-t\\end{bmatrix}\n$$\nand $det(A)=45,$ what is the value of $t?$\n\n$t=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+t & 4t \\\\ -3 & 3-t\\end{vmatrix} \\\\  & =(3+t)(3-t)-4t(-3) \\\\  & =9-{t}^{2}+12t \\\\  & =-{t}^{2}+12t+9.\\end{aligned}\n$$\n\nSince $det(A)=45$, we obtain\n\n$$\n\\begin{aligned}det(A) & =45 \\\\ -{t}^{2}+12t+9 & =45 \\\\ -{t}^{2}+12t-36 & =0 \\\\ {t}^{2}-12t+36 & =0 \\\\ (t-6)^{2} & =0 \\\\ t & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ffcc9c8-fa08-54c7-b2ad-c534fcf250d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{1/2}}+C" :db/id #edb/ref 17592186632817} {:answer/id #uuid "25e9b4fa-b3b8-53b4-a463-ae5fa9f91f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{9/2}}+C" :db/id #edb/ref 17592186632819} {:answer/id #uuid "3d392c6d-b3a0-55f0-8421-991ed1909ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5{x}^{1/2}}+C" :db/id #edb/ref 17592186632822} {:answer/id #uuid "87eb4ecf-01c3-53b6-b85a-7cf25ee8a9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5{x}^{5/2}}+C" :db/id #edb/ref 17592186632837} {:answer/id #uuid "ae0a00ea-ab15-53bf-bbe0-f78f449ce528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{5/2}}+C" :db/id #edb/ref 17592186632842}] :answer-field/correct {:answer/id #uuid "87eb4ecf-01c3-53b6-b85a-7cf25ee8a9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5{x}^{5/2}}+C" :db/id #edb/ref 17592186632837} :answer-field/id #uuid "3e4e29b3-1d79-581b-90fd-f6060e9ce8de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632823}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2413cfbc-6c20-5a51-891c-672965174302" :question/problem "Given that $f(x)=\\frac{1}{{x}^{7/2}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{7/2}}={x}^{-7/2}.$ So, we can use the power rule with $n=-\\frac{7}{2}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-7/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/2+1}}{(-\\frac{7}{2}+1)}+C \\\\  & =\\frac{{x}^{-5/2}}{\\left(-\\frac{5}{2}\\right)}+C \\\\  & =-\\frac{2}{5}{x}^{-5/2}+C \\\\  & =-\\frac{2}{5{x}^{5/2}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40977a8b-4863-516a-972a-3a34abc21243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-3/2}+C" :db/id #edb/ref 17592186632825} {:answer/id #uuid "40d3b3cb-8e93-5649-94ea-6e727dc46fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}{x}^{-7/2}+C" :db/id #edb/ref 17592186632826} {:answer/id #uuid "508d6e9f-a218-51a5-85a7-9a0e43544f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-7/6}+C" :db/id #edb/ref 17592186632828} {:answer/id #uuid "587e46be-90b5-568f-97f7-aeea7f29cf0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-7/2}+C" :db/id #edb/ref 17592186632829} {:answer/id #uuid "abad993c-1355-59f7-9f27-49c83c474eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}{x}^{-3/2}+C" :db/id #edb/ref 17592186632841}] :answer-field/correct {:answer/id #uuid "587e46be-90b5-568f-97f7-aeea7f29cf0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-7/2}+C" :db/id #edb/ref 17592186632829} :answer-field/id #uuid "5a425b0e-b155-5ef4-a994-32f805dfde0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632831}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e7a9040-6cde-56d7-a463-866319328df1" :question/problem "Given that $f(x)=\\frac{1}{\\sqrt{{x}^{9}}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{\\sqrt{{x}^{9}}}={x}^{-9/2}.$ So, we can use the power rule with $n=-\\frac{9}{2}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int \\frac{1}{\\sqrt{{x}^{9}}}\\,\\text{d}x \\\\  & =\\int {x}^{-9/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/2+1}}{(-\\frac{9}{2}+1)}+C \\\\  & =\\frac{{x}^{-7/2}}{\\left(-\\frac{7}{2}\\right)}+C \\\\  & =-\\frac{2}{7}{x}^{-7/2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03459bdb-f82c-52d3-a1be-9cf84949b9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-1/2}+C" :db/id #edb/ref 17592186632815} {:answer/id #uuid "7e485733-affe-5550-b0b1-0008e5746e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-3/2}+C" :db/id #edb/ref 17592186632836} {:answer/id #uuid "c0c513de-d62a-5f43-87fa-6497586e1b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-7/2}+C" :db/id #edb/ref 17592186632843} {:answer/id #uuid "f4f21317-af0a-58eb-b862-a55e79d4e17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-1/2}+C" :db/id #edb/ref 17592186632848} {:answer/id #uuid "fa796935-5678-55f3-8b41-1a98f5730810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{-3/2}+C" :db/id #edb/ref 17592186632849}] :answer-field/correct {:answer/id #uuid "c0c513de-d62a-5f43-87fa-6497586e1b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}{x}^{-7/2}+C" :db/id #edb/ref 17592186632843} :answer-field/id #uuid "a22107ac-398a-5313-be3a-7841e8a9ef3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632839}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34f8e342-2cc0-5379-827c-e6ea111173a7" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt{{x}^{9}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt{{x}^{9}}}=\\frac{1}{{x}^{9/2}}={x}^{-9/2}.\n$$ So, we can use the power rule with $n=-\\frac{9}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{9}}}\\,\\text{d}x & =\\int {x}^{-9/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/2+1}}{-\\frac{9}{2}+1}+C \\\\  & =-\\frac{2}{7}{x}^{-7/2}+C \\\\  & =-\\frac{2}{7{x}^{7/2}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e5ff9a9-8634-55ed-8d18-9bf7b3b3068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5{x}^{3/4}}+C" :db/id #edb/ref 17592186632824} {:answer/id #uuid "7dfcfb5c-b9a8-5b12-b428-01cd27f22d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5{x}^{9/4}}+C" :db/id #edb/ref 17592186632835} {:answer/id #uuid "91381b87-bac0-57a5-8ad2-3f9990f1c77c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{x}^{9/4}}+C" :db/id #edb/ref 17592186632838} {:answer/id #uuid "a51ccdc2-c823-5b46-8fb2-7ea81da8261c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5{x}^{5/3}}+C" :db/id #edb/ref 17592186632840} {:answer/id #uuid "c5e76ee5-682e-55c7-a0a6-5a52b10e50a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{x}^{3/4}}+C" :db/id #edb/ref 17592186632844}] :answer-field/correct {:answer/id #uuid "a51ccdc2-c823-5b46-8fb2-7ea81da8261c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5{x}^{5/3}}+C" :db/id #edb/ref 17592186632840} :answer-field/id #uuid "eac8b798-372a-5b7c-8aae-1158b604452e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632845}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4aaa9147-9c56-5d7a-9241-9befe7a7c5f0" :question/problem "Given that $f(x)=\\frac{1}{{x}^{8/3}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{8/3}}={x}^{-8/3}.$ So, we can use the power rule with $n=-\\frac{8}{3}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-8/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-8/3+1}}{(-\\frac{8}{3}+1)}+C \\\\  & =\\frac{{x}^{-5/3}}{\\left(-\\frac{5}{3}\\right)}+C \\\\  & =-\\frac{3}{5}{x}^{-5/3}+C \\\\  & =-\\frac{3}{5{x}^{5/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088ab0da-c959-56ad-83fd-576188ba790e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2{x}^{5/3}}+C" :db/id #edb/ref 17592186632816} {:answer/id #uuid "599cf072-cba2-583a-9b57-e4615008ac45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4{x}^{4/3}}+C" :db/id #edb/ref 17592186632830} {:answer/id #uuid "5ab08f88-4e6e-5c35-a1b3-566b2df064ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2{x}^{2/3}}+C" :db/id #edb/ref 17592186632832} {:answer/id #uuid "64ce697a-66fc-51cc-ab06-f6a409d33b91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4{x}^{5/3}}+C" :db/id #edb/ref 17592186632834} {:answer/id #uuid "ed268571-8aa7-5d64-a0a8-c37d826ecde0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4{x}^{2/3}}+C" :db/id #edb/ref 17592186632846}] :answer-field/correct {:answer/id #uuid "5ab08f88-4e6e-5c35-a1b3-566b2df064ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2{x}^{2/3}}+C" :db/id #edb/ref 17592186632832} :answer-field/id #uuid "627442e6-8763-5c78-bbd2-dcfa1e5936a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1ac7d5f-ec1b-5cf0-bfb5-6279600612b3" :question/problem "Given that $f(x)=\\frac{1}{{x}^{5/3}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{5/3}}={x}^{-5/3}.$ So, we can use the power rule with $n=-\\frac{5}{3}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-5/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/3+1}}{(-\\frac{5}{3}+1)}+C \\\\  & =\\frac{{x}^{-2/3}}{\\left(-\\frac{2}{3}\\right)}+C \\\\  & =-\\frac{3}{2}{x}^{-2/3}+C \\\\  & =-\\frac{3}{2{x}^{2/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b9f7dc7-2094-5747-b63c-1f3aa1dfc31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3\\ln 2}" :db/id #edb/ref 17592186636827}] :answer-field/correct {:answer/id #uuid "5b9f7dc7-2094-5747-b63c-1f3aa1dfc31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3\\ln 2}" :db/id #edb/ref 17592186636827} :answer-field/id #uuid "fe554973-67a0-56ee-a7e9-53e893ffdaf2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637228}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09c65255-db56-5050-bb9d-5e958268d77f" :question/math-academy-id "q-349640" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{2}{2}^{3x-2}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "If we let $u=3x-2,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{2}^{3x-2}\\,\\text{d}x & ={\\int }_{1}^{4}{2}^{u}\\left(\\frac{1}{3}\\right)\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{2}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\left(\\frac{{2}^{u}}{\\operatorname{ln}⁡2}\\right){|}_{1}^{4} \\\\  & =\\frac{1}{3\\operatorname{ln}⁡2}({2}^{4}-{2}^{1}) \\\\  & =\\frac{1}{3\\operatorname{ln}⁡2}(16-2) \\\\  & =\\frac{14}{3\\operatorname{ln}⁡2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2490153a-532d-589d-a4db-4a1a1bc11c14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186636733} {:answer/id #uuid "4fb13946-dfb2-5e6f-8328-af3c91eb3d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186636803} {:answer/id #uuid "936891b6-4a14-503d-8039-39d76a9fde69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186636922} {:answer/id #uuid "b71c13b6-011d-53e8-8015-52b6bfaae5b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186636988} {:answer/id #uuid "bd75c910-18eb-54a9-8aed-7fb84e27d3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186637001}] :answer-field/correct {:answer/id #uuid "4fb13946-dfb2-5e6f-8328-af3c91eb3d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,{e}^{3-2x}+C" :db/id #edb/ref 17592186636803} :answer-field/id #uuid "ad3fcf37-2367-55b2-bd1e-4a20857a229b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637185}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "477c9989-e77f-54ee-a8fb-24b8e86d88f0" :question/math-academy-id "q-113835" :question/problem "Calculate $$\n\\displaystyle \\int 4\\,{e}^{3-2x}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=3-2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 4\\,{e}^{3-2x}\\,\\text{d}x & =\\int 4\\,{e}^{u}\\cdot \\left(-\\frac{1}{2}\\right)\\,\\text{d}u \\\\  & =-2\\int {e}^{u}\\,\\text{d}u \\\\  & =-2\\,{e}^{u}+C \\\\  & =-2\\,{e}^{3-2x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "410662b3-f058-5c3e-adf7-02c920bbe796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(e-1)" :db/id #edb/ref 17592186636786}] :answer-field/correct {:answer/id #uuid "410662b3-f058-5c3e-adf7-02c920bbe796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8(e-1)" :db/id #edb/ref 17592186636786} :answer-field/id #uuid "f1e8b566-b391-5aec-ba6d-252d0b3d68ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637219}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54c3c2fd-fdbe-56c4-bf47-1b608eaef4f4" :question/math-academy-id "q-362688" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{2}4{e}^{x/2}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "If we let $u=x/2,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4{e}^{x/2}\\,\\text{d}x & =4{\\int }_{0}^{2}{e}^{x/2}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{1}{e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =8{\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =8{e}^{u}\\,{|}_{0}^{1} \\\\  & =8({e}^{1}-{e}^{0}) \\\\  & =8(e-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ffb014-a19e-5186-88f1-ecaf37893ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186637663} {:answer/id #uuid "648ce248-63f0-5833-ae5a-478a0e07fda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637675} {:answer/id #uuid "68661bde-1659-5365-813a-1a8433361496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-49" :db/id #edb/ref 17592186637677} {:answer/id #uuid "d9eb3d58-90df-5fb7-be2d-0dfeb3ae4cad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186637689} {:answer/id #uuid "dc68555d-aac6-56e7-acb6-d4f91757e1ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186637690}] :answer-field/correct {:answer/id #uuid "648ce248-63f0-5833-ae5a-478a0e07fda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637675} :answer-field/id #uuid "fbf21eea-e120-5aaa-8293-ac0008ef915b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637693}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14d3ea69-ef01-5fff-b599-c31e9952a48d" :question/problem "Calculate $\\text{det}(M)$, if\n$$\n\\displaystyle M=\\begin{bmatrix}9 & 9 \\\\ 5 & 5\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}9 & 9 \\\\ 5 & 5\\end{vmatrix} \\\\  & =9\\cdot 5-9\\cdot 5 \\\\  & =45-45 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85db34a8-c63e-5587-a1aa-1229d16c82cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186637680}] :answer-field/correct {:answer/id #uuid "85db34a8-c63e-5587-a1aa-1229d16c82cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186637680} :answer-field/id #uuid "329b94c1-1a26-5ab0-bb5c-9a9653b1dee7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637668}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d689d20-2d7f-5cf6-a734-7021d15cd1a4" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix} & =9\\cdot 0-2\\cdot 4 \\\\  & =0-8 \\\\  & =-8.\\end{aligned}\n$$"}]}
