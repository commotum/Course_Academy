r-fields [{:answer-field/choices [{:answer/id #uuid "005c827f-689c-5cf3-90d1-109920cf0783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639312} {:answer/id #uuid "38a18f0f-2317-594f-8efd-6328ee622609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186639316} {:answer/id #uuid "6d2fbe70-79ba-5ce8-95da-6fd6fd50af02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186639321} {:answer/id #uuid "e20fe210-3854-5d24-ac3a-84c2f2dfe577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639334} {:answer/id #uuid "f300bc55-7ee3-5229-80ae-2b9eefd1c42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186639337}] :answer-field/correct {:answer/id #uuid "f300bc55-7ee3-5229-80ae-2b9eefd1c42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186639337} :answer-field/id #uuid "71dbc4a4-c2ab-51eb-a362-49f13ff7f22c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639323}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4059a0e6-5992-5028-8c36-2765a1d37a20" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-3v & -7 \\\\ 8 & -3\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-16$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-3v & -7 \\\\ 8 & -3\\end{vmatrix} \\\\  & =(-3v)\\cdot (-3)-(-7)\\cdot 8 \\\\  & =9v+56\\end{aligned}\n$$\n\nSince $det(U)=-16$, we get:\n\n$$\n\\begin{aligned}det(U) & =-16 \\\\ 9v+56 & =-16 \\\\ 9v & =-16-56 \\\\ 9v & =-72 \\\\ v & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa9f658-ec24-5921-9904-29629964f774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186639314}] :answer-field/correct {:answer/id #uuid "0fa9f658-ec24-5921-9904-29629964f774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186639314} :answer-field/id #uuid "bcd5acb9-fb09-5626-954d-96b09cf7d0cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639332}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46a646ff-1f4c-5382-ae10-f7d28464d45e" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-6-8r & 2-6r \\\\ 5 & 7\\end{bmatrix}\n$$\nand $det(U)=182$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}-6-8r & 2-6r \\\\ 5 & 7\\end{vmatrix} \\\\  & =(-6-8r)\\cdot 7-(2-6r)\\cdot 5 \\\\  & =-42-56r-10+30r \\\\  & =-52-26r.\\end{aligned}\n$$\n\nSince $det(U)=182,$ we get\n\n$$\n\\begin{aligned}det(U) & =182 \\\\ -52-26r & =182 \\\\ -26r & =234 \\\\ r & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdfc11ec-373d-57de-b54c-04933ee37f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186639333}] :answer-field/correct {:answer/id #uuid "bdfc11ec-373d-57de-b54c-04933ee37f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186639333} :answer-field/id #uuid "6f65a0f8-1d0b-5f58-868d-246b5e15dc18" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639322}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7cea3e82-e2a1-50e4-a3dc-49d532c82f4a" :question/problem "If\n$$\n\\displaystyle C=\\begin{bmatrix}-2 & k \\\\ -8 & -4\\end{bmatrix}\n$$\nand\n$\\text{det}(C)=16,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}-2 & k \\\\ -8 & -4\\end{vmatrix} \\\\  & =(-2)\\cdot (-4)-k\\cdot (-8) \\\\  & =8+8k.\\end{aligned}\n$$\n\nSince $det(C)=16$, we get\n\n$$\n\\begin{aligned}det(C) & =16 \\\\ 8+8k & =16 \\\\ 8k & =16-8 \\\\ 8k & =8 \\\\ k & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c1b194-4820-510f-8ae8-e434621b24c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186639315} {:answer/id #uuid "5f67fc68-3c45-5065-b1b1-022c24d47fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186639319} {:answer/id #uuid "745bb945-f72e-581f-893e-68e5c56a6be3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186639324} {:answer/id #uuid "ad1dc6a7-b788-5237-b036-89ce79c15958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186639330} {:answer/id #uuid "edfb9e4d-bf50-5404-9e1c-250542e45730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186639335}] :answer-field/correct {:answer/id #uuid "5f67fc68-3c45-5065-b1b1-022c24d47fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186639319} :answer-field/id #uuid "83fd7816-cba8-5cfd-8cf1-72ff3b96cac5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639326}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "898c44e6-caae-5b89-a738-909dbdb2bd54" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-3 & -6 \\\\ -4k & 8k+2\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-6$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-3 & -6 \\\\ -4k & 8k+2\\end{vmatrix} \\\\  & =(-3)\\cdot (8k+2)-(-6)\\cdot (-4k) \\\\  & =-48k-6\\end{aligned}\n$$\n\nSince $det(U)=-6$, we get:\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ -48k-6 & =-6 \\\\ -48k & =-6-(-6) \\\\ -48k & =0 \\\\ k & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fccc5f-e11c-5381-8753-653378414177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186639313} {:answer/id #uuid "9f1a8e26-30e7-57f7-bb98-09c47d21b898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186639328} {:answer/id #uuid "a35ccc33-9c87-5d21-a82f-2f69c0c8c3ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186639329} {:answer/id #uuid "f252b6de-fe64-5742-af1a-4b99b72662a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186639336} {:answer/id #uuid "ff5daba2-9c57-556e-ab55-dad610664e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186639338}] :answer-field/correct {:answer/id #uuid "9f1a8e26-30e7-57f7-bb98-09c47d21b898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186639328} :answer-field/id #uuid "684879ec-f444-5c04-9846-f23446b2ed95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639320}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b6541fe9-b31d-5be5-b2a6-4679896c9955" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}8 & 7 \\\\ 7k & 7k-5\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-89$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}8 & 7 \\\\ 7k & 7k-5\\end{vmatrix} \\\\  & =8\\cdot (7k-5)-7\\cdot 7k \\\\  & =7k-40\\end{aligned}\n$$\n\nSince $det(U)=-89$, we get:\n\n$$\n\\begin{aligned}det(U) & =-89 \\\\ 7k-40 & =-89 \\\\ 7k & =-89-(-40) \\\\ 7k & =-49 \\\\ k & =-7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ac242bf-5d6d-5022-8c1a-0f4b4b677710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{21}" :db/id #edb/ref 17592186639344}] :answer-field/correct {:answer/id #uuid "3ac242bf-5d6d-5022-8c1a-0f4b4b677710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{21}" :db/id #edb/ref 17592186639344} :answer-field/id #uuid "593e88c7-6bfd-51c4-b1f7-1d0dc66cc1d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639346}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09aafcf5-eb62-5760-9810-48a471fed2b8" :question/problem "Calculate $det(D)$ given that\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$D=\\begin{bmatrix}\\frac{1}{3} & -6 \\\\ -\\frac{2}{7} & 7\\end{bmatrix}$</div>\n</div>\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}\\frac{1}{3} & -6 \\\\ -\\frac{2}{7} & 7\\end{vmatrix} \\\\  & =\\frac{1}{3}\\cdot 7-(-6)\\cdot \\left(-\\frac{2}{7}\\right) \\\\  & =\\frac{7}{3}-\\frac{12}{7} \\\\  & =\\frac{13}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f34cf5a8-5c27-538c-a35a-75a99adfc884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186639365} {:answer/id #uuid "2658db51-acbd-45bd-a6ad-8056b9de1eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac23" :db/id #edb/ref 17592186717017}] :answer-field/correct {:answer/id #uuid "f34cf5a8-5c27-538c-a35a-75a99adfc884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186639365} :answer-field/id #uuid "b77d1437-56f5-5899-ab7e-1ee68b9a6755" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639359}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b11b093-daa3-57d3-b97c-9296f81e0d47" :question/problem "Calculate $det(E)$ given that\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-\\frac{2}{3} & 2 \\\\ 2 & -5\\end{bmatrix}$</div>\n</div>\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}-\\frac{2}{3} & 2 \\\\ 2 & -5\\end{vmatrix} \\\\  & =-\\frac{2}{3}\\cdot (-5)-2\\cdot 2 \\\\  & =\\frac{10}{3}-4 \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2188fe79-a76a-51b4-ad37-c3d2a5c4a7ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8xy" :db/id #edb/ref 17592186639342} {:answer/id #uuid "5c7b2e02-c757-5875-aa23-1697b15d931b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30xy" :db/id #edb/ref 17592186639349} {:answer/id #uuid "d1fb2756-e8be-5132-a59f-3f60523a8d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy" :db/id #edb/ref 17592186639360} {:answer/id #uuid "df865b60-c71e-5515-bd50-2d65fa633e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5xy" :db/id #edb/ref 17592186639362} {:answer/id #uuid "ed75fc99-2d19-5567-ac93-ac5575c22004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-xy" :db/id #edb/ref 17592186639364}] :answer-field/correct {:answer/id #uuid "5c7b2e02-c757-5875-aa23-1697b15d931b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30xy" :db/id #edb/ref 17592186639349} :answer-field/id #uuid "916192da-1d51-5b17-9106-60cbe61a2011" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639356}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3d439578-50a4-5d2b-9801-d8534fc7ff1a" :question/problem "Calculate $det(C)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$C=\\begin{bmatrix}-4x & -4y \\\\ \\frac{x}{2} & 8y\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}-4x & -4y \\\\ \\frac{x}{2} & 8y\\end{vmatrix} \\\\  & =-4x\\cdot 8y-(-4y)\\cdot \\frac{x}{2} \\\\  & =-32xy+2xy \\\\  & =-30xy\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f81b72f-2573-5079-8cdd-51d22f2f3a82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\left(ru-st\\right)" :db/id #edb/ref 17592186639343} {:answer/id #uuid "5e553e6f-6776-5f41-b35c-8578fc3d06b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56\\left(ru-st\\right)" :db/id #edb/ref 17592186639350} {:answer/id #uuid "642d93ec-f95b-5ee8-b562-8ccfb43303cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\left(ru-st\\right)" :db/id #edb/ref 17592186639351} {:answer/id #uuid "8a19ec22-03f9-5cc9-b73e-30d0229d763f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\left(ru-st\\right)" :db/id #edb/ref 17592186639352} {:answer/id #uuid "8b0a836b-18cc-528e-92d0-ba6fa184f7e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\left(ru-st\\right)" :db/id #edb/ref 17592186639353}] :answer-field/correct {:answer/id #uuid "2f81b72f-2573-5079-8cdd-51d22f2f3a82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\left(ru-st\\right)" :db/id #edb/ref 17592186639343} :answer-field/id #uuid "b2b47578-eae9-5ed8-80e2-64b3347f1e70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639358}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8dd46ce8-8808-5254-800a-0f54bc7488d1" :question/problem "Calculate $det(H)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$H=\\begin{bmatrix}-2t & 7u \\\\ -2r & 7s\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}-2t & 7u \\\\ -2r & 7s\\end{vmatrix} \\\\  & =-2t\\cdot 7s-7u\\cdot (-2r) \\\\  & =-14st-(-14ru) \\\\  & =14\\left(ru-st\\right)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aec8442-7467-5873-869f-258878a5f0f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\left(2{x}^{2}+1\\right)" :db/id #edb/ref 17592186639348} {:answer/id #uuid "90e99275-eb15-5e67-876d-c833a04e4b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3y\\left({x}^{2}+1\\right)" :db/id #edb/ref 17592186639355} {:answer/id #uuid "92a6ccc2-8a72-5c43-8ae5-1e6872fe7af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\left(3{x}^{2}+1\\right)" :db/id #edb/ref 17592186639357} {:answer/id #uuid "de05e50f-2675-533c-af0e-4506a45a6196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\left({x}^{2}+1\\right)" :db/id #edb/ref 17592186639361} {:answer/id #uuid "f909bad3-77e9-5a47-808f-879f1af3d391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\left(5{x}^{2}+3\\right)" :db/id #edb/ref 17592186639366}] :answer-field/correct {:answer/id #uuid "92a6ccc2-8a72-5c43-8ae5-1e6872fe7af4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\left(3{x}^{2}+1\\right)" :db/id #edb/ref 17592186639357} :answer-field/id #uuid "59e3410a-713f-55ee-b30b-7118f6dc5508" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639347}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dfd803bb-3dbf-5b74-af0b-2b5faef6ba6a" :question/problem "Calculate $det(D)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$D=\\begin{bmatrix}6x & -2 \\\\ y & xy\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}6x & -2 \\\\ y & xy\\end{vmatrix} \\\\  & =6x\\cdot xy-(-2\\cdot y) \\\\  & =6{x}^{2}y-(-2y) \\\\  & =2y\\left(3{x}^{2}+1\\right)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0737dd86-7ea8-5edd-a7f6-9089c06e979b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186639368}] :answer-field/correct {:answer/id #uuid "0737dd86-7ea8-5edd-a7f6-9089c06e979b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186639368} :answer-field/id #uuid "fdec6006-e422-576a-a0f7-8f139bc986c1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639379}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "38c47915-6f68-5518-b913-de4c53318abb" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}-5+p & -2p-{p}^{2} \\\\ 1 & -4-p\\end{bmatrix}\n$$\nand $det(A)=38,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}-5+p & -2p-{p}^{2} \\\\ 1 & -4-p\\end{vmatrix} \\\\  & =(-5+p)(-4-p)-(-2p-{p}^{2})\\cdot 1 \\\\  & =20+5p-4p-{p}^{2}+2p+{p}^{2} \\\\  & =20+3p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =20+3p.\\end{aligned}\n$$\n\nFinally, since $det(A)=38$, we obtain\n\n$$\n\\begin{aligned}det(A) & =38 \\\\ 20+3p & =38 \\\\ 3p & =18 \\\\ p & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e8e32f0-f403-5921-a466-7f3d75d9c7bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639369}] :answer-field/correct {:answer/id #uuid "2e8e32f0-f403-5921-a466-7f3d75d9c7bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639369} :answer-field/id #uuid "83f455e3-cdd3-5426-bed7-c84613564549" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639376}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6e463122-efbb-5d02-95c5-fd1427b3ebb1" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}7+p & -6p-{p}^{2} \\\\ 1 & 2-p\\end{bmatrix}\n$$\nand $det(A)=23,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}7+p & -6p-{p}^{2} \\\\ 1 & 2-p\\end{vmatrix} \\\\  & =(7+p)(2-p)-(-6p-{p}^{2})\\cdot 1 \\\\  & =14-7p+2p-{p}^{2}+6p+{p}^{2} \\\\  & =14+p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =14+p.\\end{aligned}\n$$\n\nFinally, since $det(A)=23$, we obtain\n\n$$\n\\begin{aligned}det(A) & =23 \\\\ 14+p & =23 \\\\ p & =9 \\\\ p & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639377 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b918bc3-43cb-545f-b25b-277f6bf89403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639374}] :answer-field/correct {:answer/id #uuid "6b918bc3-43cb-545f-b25b-277f6bf89403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639374} :answer-field/id #uuid "327a7a0c-7023-5434-a7ce-ce3828aff719" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639370}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9333705c-58cc-567e-9660-11375155a969" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}4+p & 7p-{p}^{2} \\\\ 1 & -5-p\\end{bmatrix}\n$$\nand $det(A)=-180,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}4+p & 7p-{p}^{2} \\\\ 1 & -5-p\\end{vmatrix} \\\\  & =(4+p)(-5-p)-(7p-{p}^{2})\\cdot 1 \\\\  & =-20-4p-5p-{p}^{2}-7p+{p}^{2} \\\\  & =-20-16p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =-20-16p.\\end{aligned}\n$$\n\nFinally, since $det(A)=-180$, we obtain\n\n$$\n\\begin{aligned}det(A) & =-180 \\\\ -20-16p & =-180 \\\\ -16p & =-160 \\\\ p & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64ad9141-f944-5052-ab08-7fd552b10459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186639373}] :answer-field/correct {:answer/id #uuid "64ad9141-f944-5052-ab08-7fd552b10459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186639373} :answer-field/id #uuid "63a925aa-d3fd-5dbc-95d4-49984cdf96ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639372}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9de463d3-005b-5c57-8e51-9f4d98e4461a" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+p & 8p-{p}^{2} \\\\ 1 & 4-p\\end{bmatrix}\n$$\nand $det(A)=82,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+p & 8p-{p}^{2} \\\\ 1 & 4-p\\end{vmatrix} \\\\  & =(3+p)(4-p)-(8p-{p}^{2})\\cdot 1 \\\\  & =12-3p+4p-{p}^{2}-8p+{p}^{2} \\\\  & =12-7p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =12-7p.\\end{aligned}\n$$\n\nFinally, since $det(A)=82$, we obtain\n\n$$\n\\begin{aligned}det(A) & =82 \\\\ 12-7p & =82 \\\\ -7p & =70 \\\\ p & =-10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186645690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b84876-a51a-53a7-b8e3-4ca45af53bbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-3x+3y=c" :db/id #edb/ref 17592186645145} {:answer/id #uuid "2f9b3a96-01eb-5cf9-a522-fce9ee889b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-{x}^{2}+3y=c" :db/id #edb/ref 17592186645215} {:answer/id #uuid "b741bf37-7e54-595e-be78-9f077e6334e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-\\frac{3}{2}{y}^{2}+3x=c" :db/id #edb/ref 17592186645458} {:answer/id #uuid "c4e1884d-69aa-5fd1-9edc-f81cc35bd548" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-{x}^{2}+3x=c" :db/id #edb/ref 17592186645487} {:answer/id #uuid "f20ab661-fed1-5224-93ae-fd6e628aa143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-x+3y=c" :db/id #edb/ref 17592186645563}] :answer-field/correct {:answer/id #uuid "b741bf37-7e54-595e-be78-9f077e6334e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2xy}-\\frac{3}{2}{y}^{2}+3x=c" :db/id #edb/ref 17592186645458} :answer-field/id #uuid "7967c51f-f737-596f-87be-a484fbdd256b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186645625}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0d52ddac-4426-55ab-b12b-d04c3983d6f3" :question/math-academy-id "q-321209" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{3+y{e}^{2xy}}{3y-x{e}^{2xy}}.\n$$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3+y{e}^{2xy}}{3y-x{e}^{2xy}},\\end{aligned}\n$$\n\nwe first multiply through by $(3y-x{e}^{2xy})\\,\\text{d}x$:\n\n$$\n(3y-x{e}^{2xy})\\,\\text{d}y=(3+y{e}^{2xy})\\,\\text{d}x\n$$\n\nThen, we then rearrange the terms:\n\n$$\n(3+y{e}^{2xy})\\,\\text{d}x+(x{e}^{2xy}-3y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=3+y{e}^{2xy},\\,Q(x,y)=x{e}^{2xy}-3y.\n$$\n\nNow, let's compute the partial derivatives:\n\n \n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(3+y{e}^{2xy}) \\\\  & ={e}^{2xy}+2xy\\,{e}^{2xy}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(x{e}^{2xy}-3y) \\\\  & ={e}^{2xy}+2xy\\,{e}^{2xy}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\n \n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (3+y{e}^{2xy})\\,\\text{d}x+f(y) \\\\  & =3x+\\frac{1}{2}{e}^{2xy}+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x{e}^{2xy}-3y)\\,\\text{d}y+g(x) \\\\  & =\\frac{1}{2}{e}^{2xy}-\\frac{3}{2}{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=3x,\\,f(y)=-\\frac{3}{2}{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\frac{1}{2}{e}^{2xy}-\\frac{3}{2}{y}^{2}+3x=c.\n$$"}] [{:db/id #edb/ref 17592186645695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29166695-b391-5aca-b223-fc8cc2234141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y+x\\operatorname{cos}⁡y=c" :db/id #edb/ref 17592186645208} {:answer/id #uuid "7059e5b1-283c-5971-bf83-2e8cb6fe5bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+\\operatorname{sin}⁡y=c" :db/id #edb/ref 17592186645332} {:answer/id #uuid "7f13a10e-5e9f-5ff3-bd1d-92e410e0f287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+3x\\operatorname{sin}⁡y=c" :db/id #edb/ref 17592186645357} {:answer/id #uuid "89b074bc-6245-57ab-b0f0-06dbb2e36cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+x\\operatorname{cos}⁡y=c" :db/id #edb/ref 17592186645377} {:answer/id #uuid "b59dfe0c-6698-59ff-aafa-7b55e73bf5cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy+{x}^{2}\\operatorname{cos}⁡y=c" :db/id #edb/ref 17592186645454}] :answer-field/correct {:answer/id #uuid "89b074bc-6245-57ab-b0f0-06dbb2e36cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+x\\operatorname{cos}⁡y=c" :db/id #edb/ref 17592186645377} :answer-field/id #uuid "9c03c16a-abba-589a-86b1-fcc0b46f27dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186645643}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2325e13b-ac3f-566d-9a2f-e39f1cb4fb14" :question/math-academy-id "q-64182" :question/problem "Find the general solution of the differential equation\n\n$$\n(1+\\operatorname{cos}⁡y)\\,\\text{d}x+(-x\\operatorname{sin}⁡y)\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=1+\\operatorname{cos}⁡y$ and $Q(x,y)=-x\\operatorname{sin}⁡y.$\n\nLet's check if the equation is exact. To do this, we check to see if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{\\text{d}x}.\n$$\n\nFirst, let's differentiate $P(x,y)$ with respect to $y$:\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂}{∂y}(1+\\operatorname{cos}⁡y)=-\\operatorname{sin}⁡y\n$$\n\nNow, let's differentiate $Q(x,y)$ with respect to $x$:\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(-x\\operatorname{sin}⁡y)=-\\operatorname{sin}⁡y=\\frac{∂P}{∂y}\\,✓\n$$\n\nSo, the given equation is exact and its solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$:\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int 1+\\operatorname{cos}⁡y\\,\\text{d}x+f(y) \\\\  & =x+x\\operatorname{cos}⁡y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x.$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int -x\\operatorname{sin}⁡y\\,\\text{d}y+g(x) \\\\  & =x\\operatorname{cos}⁡y+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=x,\\,f(y)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\nx\\operatorname{cos}⁡y+x=c.\n$$"}] [{:db/id #edb/ref 17592186645704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f83b903-c649-5837-bca0-6849c0fdddd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{x}^{2}+26x=c" :db/id #edb/ref 17592186645214} {:answer/id #uuid "309644ef-1ee1-57ab-a916-aa470e0e8cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+26y=c" :db/id #edb/ref 17592186645216} {:answer/id #uuid "3b731360-4301-5b1f-95f3-949b8d08f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+26x=c" :db/id #edb/ref 17592186645231} {:answer/id #uuid "b53f3254-76af-524b-9a74-25a5e2ddf311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+26x=c" :db/id #edb/ref 17592186645452} {:answer/id #uuid "c69f2d69-fcc4-5d72-87de-dc0fd160e5be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)+\\frac{19}{2}{y}^{2}-26x=c" :db/id #edb/ref 17592186645491}] :answer-field/correct {:answer/id #uuid "3b731360-4301-5b1f-95f3-949b8d08f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+26x=c" :db/id #edb/ref 17592186645231} :answer-field/id #uuid "f5b36222-701d-5d2d-9763-6d1c7d0ee620" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186645682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35162e91-3041-5e8b-a0fe-436da8a0b892" :question/math-academy-id "q-320580" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{\\,y\\operatorname{sin}⁡(xy)+26\\,}{\\,19y-x\\operatorname{sin}⁡(xy)\\,}.\n$$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(xy)+26}{19y-x\\operatorname{sin}⁡(xy)},\\end{aligned}\n$$\n\nwe first multiply through by $(19y-x\\operatorname{sin}⁡(xy))\\,\\text{d}x$:\n\n$$\n(19y-x\\operatorname{sin}⁡(xy))\\,\\text{d}y=(y\\operatorname{sin}⁡(xy)+26)\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(y\\operatorname{sin}⁡(xy)+26)\\,\\text{d}x+(x\\operatorname{sin}⁡(xy)-19y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=y\\operatorname{sin}⁡(xy)+26,\\,Q(x,y)=x\\operatorname{sin}⁡(xy)-19y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}\\,(y\\operatorname{sin}⁡(xy)+26) \\\\  & =\\operatorname{sin}⁡(xy)+xy\\,\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}\\,(x\\operatorname{sin}⁡(xy)-19y) \\\\  & =\\operatorname{sin}⁡(xy)+xy\\,\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\n \nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (y\\operatorname{sin}⁡(xy)+26)\\,\\text{d}x+f(y) \\\\  & =-\\operatorname{cos}⁡(xy)+26x+f(y).\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x\\operatorname{sin}⁡(xy)-19y)\\,\\text{d}y+g(x) \\\\  & =-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+g(x).\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=26x,\\,f(y)=-\\frac{19}{2}{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n-\\operatorname{cos}⁡(xy)-\\frac{19}{2}{y}^{2}+26x=c.\n$$"}] [{:db/id #edb/ref 17592186645710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b30a42d2-8339-5e17-8d13-14d01bd351d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is not exact" :db/id #edb/ref 17592186645448} {:answer/id #uuid "eb61e1f1-3971-5607-9067-e9ec1b37473a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is exact" :db/id #edb/ref 17592186645548}] :answer-field/correct {:answer/id #uuid "eb61e1f1-3971-5607-9067-e9ec1b37473a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is exact" :db/id #edb/ref 17592186645548} :answer-field/id #uuid "4da08cad-50d5-5497-8219-921dbbe9caab" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186645601} {:answer-field/choices [{:answer/id #uuid "2bb1af23-b6a8-501d-ba1f-d5ed401b2725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂v}=\\frac{∂Q}{∂u}" :db/id #edb/ref 17592186645211} {:answer/id #uuid "34b0054d-4478-551c-baf5-585c71c3051c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{∂}^{2}P}{∂{v}^{2}}=\\frac{{∂}^{2}Q}{∂{u}^{2}}" :db/id #edb/ref 17592186645224} {:answer/id #uuid "3da51344-c610-5b56-92b7-6fbb01f7b80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂u}=-\\frac{∂Q}{∂v}" :db/id #edb/ref 17592186645235} {:answer/id #uuid "d1a42a8c-0c9a-50a1-a130-ee52700b5822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂u}=\\frac{∂Q}{∂v}" :db/id #edb/ref 17592186645510}] :answer-field/correct {:answer/id #uuid "2bb1af23-b6a8-501d-ba1f-d5ed401b2725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂v}=\\frac{∂Q}{∂u}" :db/id #edb/ref 17592186645211} :answer-field/id #uuid "5119d7ab-50b1-5af8-99e6-8d437914a572" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186645604} {:answer-field/choices [{:answer/id #uuid "6270c1f9-3c80-5330-93a3-91586fb0073e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{uv}+uv{e}^{uv}" :db/id #edb/ref 17592186645309} {:answer/id #uuid "a1bcfad9-6b66-5077-8074-6af50632fa5c" :answer/type {:db/i