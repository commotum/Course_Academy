85} :question/id #uuid "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a" :question/problem "Differentiate ${7}^{x}\\sin(x).$\n\n$(7^{x} \\sin{\\left(x \\right)})'=$ {{field-1}} $+\\,(7^{x} \\cos{\\left(x \\right)})$" :question/worked-solution "Here, we have the product of the two functions $u(x)=7^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(7^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(7^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(7^{x} \\ln{\\left(7 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(7^{x})(\\cos{\\left(x \\right)}) \\\\ &=7^{x} \\ln{\\left(7 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(7^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09eabf26-4b2d-585b-96c2-4e0f60321ba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657585}] :answer-field/correct {:answer/id #uuid "09eabf26-4b2d-585b-96c2-4e0f60321ba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657585} :answer-field/id #uuid "293efc50-8594-596a-afd0-5a8ace505e35" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657590}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9a964233-42f7-507e-88f1-773242faeff3" :question/problem "Differentiate ${2}^{x}\\sin(x).$\n\n$(2^{x} \\sin{\\left(x \\right)})'=$ {{field-1}} $+\\,(2^{x} \\cos{\\left(x \\right)})$" :question/worked-solution "Here, we have the product of the two functions $u(x)=2^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(2^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(2^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(2^{x} \\ln{\\left(2 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(2^{x})(\\cos{\\left(x \\right)}) \\\\ &=2^{x} \\ln{\\left(2 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(2^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a72ad92-0572-510c-a84c-dec4304c3869" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657586} {:answer/id #uuid "0a8dc2b2-b760-505e-8750-a531af8c2e58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186657587} {:answer/id #uuid "9e725352-0b38-5cf6-aab1-701881b3895f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657601} {:answer/id #uuid "d0789108-d518-577b-98ea-59013ba1d132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657605} {:answer/id #uuid "f17141e2-572c-536c-ac35-fea8aec9bb2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657607}] :answer-field/correct {:answer/id #uuid "9e725352-0b38-5cf6-aab1-701881b3895f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- x \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657601} :answer-field/id #uuid "7952d87e-2c7a-5cf7-8ee8-805c4d7ddf06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657594}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1cf6b9c-c983-58fe-832e-3f664b5ae8fc" :question/problem "Differentiate $x\\cos{\\left(x \\right)}$." :question/worked-solution "Here, we have the product of the two functions $u(x)=x$ and $v(x)=\\cos{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(x)'\\cdot (\\cos{\\left(x \\right)}) \\\\ &\\quad +(x)\\cdot (\\cos{\\left(x \\right)})' \\\\ &=(1)(\\cos{\\left(x \\right)}) \\\\ &\\quad +(x)(- \\sin{\\left(x \\right)}) \\\\ &=\\cos{\\left(x \\right)} \\\\ &\\quad +(- x \\sin{\\left(x \\right)})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{11}{2}\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(\\frac{11}{2}\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657611} {:answer/id #uuid "3e3cc552-b13d-5424-9879-4f15ac541649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(5\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(5\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657615} {:answer/id #uuid "921c17d0-1976-5b3a-915c-86d80055277b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(4\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(4\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657621} {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(6\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657622} {:answer/id #uuid "bffd7eb9-1ef0-5aae-98d8-18005e448afe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{9}{2}\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(\\frac{9}{2}\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657624}] :answer-field/correct {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(6\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657622} :answer-field/id #uuid "571e7da4-8bf0-538e-b7aa-3f10b987cbb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657617}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/problem "Given that $f(x) = 6\\log_{5} x\\ln x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=6\\log_{5} x$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(6\\log_{5} x)^{′}\\ln x+6\\log_{5} x(\\ln x)^{′} \\\\  & =(\\frac{6}{x \\ln{\\left(5 \\right)}})(\\ln x)+(6\\log_{5} x)(\\frac{1}{x}) \\\\  & =\\frac{6\\log_{5} x}{x} + \\frac{6\\ln x}{x\\ln 5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657609} {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} {:answer/id #uuid "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(0\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657626} {:answer/id #uuid "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657628} {:answer/id #uuid "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657629}] :answer-field/correct {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} :answer-field/id #uuid "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657630}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/problem "Given that $f(x) = x^{-2}\\log_{4} x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=x^{-2}$ and $v(x)=\\log_{4} x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(x^{-2})^{′}\\log_{4} x+x^{-2}(\\log_{4} x)^{′} \\\\  & =(- \\frac{2}{x^{3}})(\\log_{4} x)+(x^{-2})(\\frac{1}{x \\ln{\\left(4 \\right)}}) \\\\  & =x^{-3}(-2\\log_{4} x + \\frac{1}{\\ln 4})\\end{aligned}\n$$"}]}
