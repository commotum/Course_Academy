99 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186724993} :answer-field/id #uuid "b8f68b17-e789-57d3-9a62-e6685a1fcfb0" :answer-field/key "At every point $(x,y)$ where $x>3$ and $y>-2$, the slope of the slope field is negative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186725013} {:answer-field/choices [{:answer/id #uuid "2ff42cf3-0dc4-5abf-8da6-0845f3485b94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186724981} {:answer/id #uuid "85518af4-17e2-5075-9e08-8d810c7164e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186725001}] :answer-field/correct {:answer/id #uuid "2ff42cf3-0dc4-5abf-8da6-0845f3485b94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186724981} :answer-field/id #uuid "bd933b7b-d99e-5e60-a0b0-908f28e4d1a5" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186725017}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd0faff6-bd6e-5824-9a24-11223bcf7130" :question/problem "Consider the differential equation $\\frac{dy}{dx}=(3-x)(-2-y)$ and its slope field.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Let $f(x,y)=(3-x)(-2-y)$. The slope at $(x,y)$ is $f(x,y)$. A factor is zero on $x=3$ or $y=-2$, so these are the zero-slope lines.\n\n![Zero-slope lines dividing the plane into four open regions.](images/8b/8bb21454ab2c2ad3f483ff0ff2634d217300ee1acad614830eb77122bded41ae.png)\n\nAway from these lines, each factor has a fixed sign throughout each open region. Multiply the factor signs to determine the slope sign.\n\n| Region | $(3-x)$ | $(-2-y)$ | $f(x,y)$ |\n| --- | --- | --- | --- |\n| $x<3$, $y>-2$ | $+$ | $-$ | $-$ |\n| $x>3$, $y>-2$ | $-$ | $-$ | $+$ |\n| $x<3$, $y<-2$ | $+$ | $+$ | $+$ |\n| $x>3$, $y<-2$ | $-$ | $+$ | $-$ |\n\n![Signs of the slope in all four open regions.](images/f4/f46ca375a005b6130c8b316e3e9cdcbf2fbe3dc338616471913f146810d659b7.png)\n\n- Statement 1: for $x<3$ and $y>-2$, the slope is negative. The statement is **true**.\n- Statement 2: for $x>3$ and $y<-2$, the slope is negative. The statement is **false**.\n- Statement 3: for $x>3$ and $y>-2$, the slope is positive. The statement is **false**.\n\n“None of the above” is **false** because at least one ordinary statement is true.\n\nThe strict inequalities exclude the zero-slope lines; the slope is zero on those lines."}] [{:db/id #edb/ref 17592186725062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ae7068-ba21-5a8c-af75-7e601bcabaab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186725039} {:answer/id #uuid "12275f8f-cb9c-5a55-87da-da11382c2945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186725043}] :answer-field/correct {:answer/id #uuid "12275f8f-cb9c-5a55-87da-da11382c2945" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186725043} :answer-field/id #uuid "4bf03cb1-b99a-52b6-abaa-18710dbb3aaf" :answer-field/key "At every point $(x,y)$ where $x>-1$ and $y>3$, the slope of the slope field is negative." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186725051} {:answer-field/choices [{:answer/id #uuid "0f1b1fcd-979c-5c4e-97ba-af92a6c1be6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186725042} {:answer/id #uuid "f0b26482-ea26-5c48-82ea-89f37d5d7708" :answer/type {:db/id #edb/ref 17592186045499 :db/