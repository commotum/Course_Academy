 collect the signs:\n$$\n\\begin{aligned}\n&\\int \\left(\\sec z\\left(-6\\tan z+5\\sec z\\right)\\right)\\,\\mathrm{d}z \\\\\n&=-6\\int \\sec z\\tan z\\,\\mathrm{d}z \\\\\n&\\quad+5\\int \\sec^2 z\\,\\mathrm{d}z \\\\\n&=-6\\left(\\sec z\\right)+5\\left(\\tan z\\right)+C \\\\\n&=-6\\sec z+5\\tan z+C.\n\\end{aligned}\n$$\nOne arbitrary constant suffices for the combined antiderivative."}] [{:db/id #edb/ref 17592186721486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4259801b-6cd8-5604-8c29-ae695fbdb5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\tan z-2\\tan z+C" :db/id #edb/ref 17592186721482} {:answer/id #uuid "67788536-de29-5132-8073-0a40f243b3e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\tan z+2\\sec z+C" :db/id #edb/ref 17592186721485} {:answer/id #uuid "835d2a0a-c04e-5039-9694-19378377bbc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\tan z-2\\sec z+C" :db/id #edb/ref 17592186721491} {:answer/id #uuid "e3e49e3d-481c-54b7-828d-f7e891495ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sec^2 z-2\\sec z+C" :db/id #edb/ref 17592186721507} {:answer/id #uuid "f1bbc502-0db9-54c5-93f9-08f17d90635e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\tan z-2\\sec z+C" :db/id #edb/ref 17592186721509}] :answer-field/correct {:answer/id #uuid "835d2a0a-c04e-5039-9694-19378377bbc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\tan z-2\\sec z+C" :db/id #edb/ref 17592186721491} :answer-field/id #uuid "ace25b54-a18a-5e18-97cf-7ae82dd2a1a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721496}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68336140-2a67-5014-ab