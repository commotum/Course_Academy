sc^2 t\\,\\mathrm{d}t \\\\ &\\quad+2\\int \\sin t\\,\\mathrm{d}t\\end{aligned}\n$$\n\nApply the formulas and simplify the signs:\n\n$$\n\\begin{aligned}I&=3(-\\cot t)+2(-\\cos t)+C \\\\ &=-3\\cot t-2\\cos t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112a58c4-7d9f-5aa8-bc8f-a702ecf16718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot x-5\\csc x+C" :db/id #edb/ref 17592186721332} {:answer/id #uuid "3a1bbbb9-73fc-5b0c-938f-a5d3827fe203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot x+5\\csc x+C" :db/id #edb/ref 17592186721334} {:answer/id #uuid "9dc28af1-2a4e-57ed-b188-2fe1adb500c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cot x-5\\csc x+C" :db/id #edb/ref 17592186721348} {:answer/id #uuid "b1b50664-b9b6-5c60-bb2a-07dee284ea1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cot x+5\\csc x+C" :db/id #edb/ref 17592186721352} {:answer/id #uuid "fa549c1a-0979-59c1-bb97-9a61a36887be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot x-10\\csc x+C" :db/id #edb/ref 17592186721364}] :answer-field/correct {:answer/id #uuid "112a58c4-7d9f-5aa8-bc8f-a702ecf16718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cot x-5\\csc x+C" :db/id #edb/ref 17592186721332} :answer-field/id #uuid "a25b7da1-e517-54cf-b8c1-6453947e38c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721349}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d7f19b4b-931a-5613-be4a-2b46e312cdfb" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\csc x\\bigl(\\csc x+5\\cot x\\bigr)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\csc^2 x\\,\\mathrm{d}x&=-\\cot x+C, \\\\ \\int \\csc x\\cot x\\,\\mathrm{d}x&=-\\csc x+C.\\end{aligned}\n$$\n\nLet $I$ be the requested integral. Expand the product:\n\n$$\nI=\\int\\bigl(\\csc^2 x+5\\csc x\\cot x\\bigr)\\,\\mathrm{d}x.\n$$\n\n$$\n\\begin{aligned}I&=\\int \\csc^2 x\\,\\mathrm{d}x \\\\ &\\quad+5\\int \\csc x\\cot x\\,\\mathrm{d}x\\end{aligned}\n$$\n\nApply the formulas and simplify the signs:\n\n$$\n\\begin{aligned}I&=(-\\cot x)+5(-\\csc x)+C \\\\ &=-\\cot x-5\\csc x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "272d1915-9c65-55a6-a931-1b72c549a1d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sec x-5\\cot x+C" :db/id #edb/ref 17592186721333} {:answer/id #uuid "677cab3d-ed3f-5a2f-9a0f-50fa93e647bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sec x+5\\cot x+C" :db/id #edb/ref 17592186721343} {:answer/id #uuid "85af9898-a3d2-5f69-9b59-49b4413d53db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sec x+5\\cot x+C" :db/id #edb/ref 17592186721346} {:answer/id #uuid "dd1dd4ab-2fd6-5f19-8ffd-fbd8f2c06250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sec x-10\\cot x+C" :db/id #edb/ref 17592186721356} {:answer/id #uuid "e1242fc8-1f5d-5b04-a334-888d26ded256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sec x-5\\cot x+C" :db/id #edb/ref 17592186721358}] :answer-field/correct {:answer/id #uuid "85af9898-a3d2-5f69-9b59-49b4413d53db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sec x+5\\cot x+C" :db/id #edb/ref 17592186721346} :answer-field/id #uuid "63e770bf-9377-5161-8133-b9be9f4014e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721342}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7aaf865-a3f8-551a-b3d9-97d0aaa6a89f" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\bigl(6\\sec x\\tan x-5\\csc^2 x\\bigr)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\sec x\\tan x\\,\\mathrm{d}x&=\\sec x+C, \\\\ \\int \\csc^2 x\\,\\mathrm{d}x&=-\\cot x+C.\\end{aligned}\n$$\n\nLet $I$ be the requested integral. Use linearity.\n\n$$\n\\begin{aligned}I&=6\\int \\sec x\\tan x\\,\\mathrm{d}x \\\\ &\\quad-5\\int \\csc^2 x\\,\\mathrm{d}x\\end{aligned}\n$$\n\nApply the formulas and simplify the signs:\n\n$$\n\\begin{aligned}I&=6(\\sec x)-5(-\\cot x)+C \\\\ &=6\\sec x+5\\cot x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f1d05d-4529-537d-8ea8-6fa0da9bafe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sin \\theta+5\\tan \\theta+C" :db/id #edb/ref 17592186721477} {:answer/id #uuid "2b375f86-4fe8-5422-9f8e-a16c7ba98756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos \\theta+5\\sec^2 \\theta+C" :db/id #edb/ref 17592186721480} {:answer/id #uuid "68867cec-41a0-50e4-9afd-b1af9ae4323a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos \\theta+5\\sec^2 \\theta+C" :db/id #edb/ref 17592186721487} {:answer/id #uuid "8bcf5586-2366-5bc5-9b31-0c7b45b2052d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos \\theta+5\\tan \\theta+C" :db/id #edb/ref 17592186721493} {:answer/id #uuid "c4a5b70d-47b1-5392-aec9-2cbefb740ae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sin \\theta-5\\tan \\theta+C" :db/id #edb/ref 17592186721501}] :answer-field/correct {:answer/id #uuid "8bcf5586-2366-5bc5-