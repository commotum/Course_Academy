#{[{:db/id #edb/ref 17592186184550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d775da7-8fc1-5cb3-9d3c-2af0421afc9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x^{2}}{3} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181469} {:answer/id #uuid "b4ecc404-7066-5348-973e-7377baa05dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} - \\frac{1}{x^{2}} + C" :db/id #edb/ref 17592186181470} {:answer/id #uuid "e051ef6b-9060-5a12-a9ec-f4bbb35ddd1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181471} {:answer/id #uuid "489937da-53bc-51fa-8f37-d45d0186f18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181472} {:answer/id #uuid "7520d140-b77f-5b0e-8a33-ded183b046ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} + \\frac{1}{x} + C" :db/id #edb/ref 17592186181473}] :answer-field/id #uuid "2149efd2-ebb0-5555-985d-1cb04dd0d206" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181468}] :question/id #uuid "74b8affd-5a59-5349-9045-109c73cdc246" :question/math-academy-id "q-2166" :question/problem "What is $$\n\\displaystyle \\int\\frac{1}{x^{2}} - 3xdx\n$$?"}] [{:db/id #edb/ref 17592186184563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e5ce597-62ea-54d2-8f1a-415f3eedcc86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 3\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181503} {:answer/id #uuid "c47182fe-b5f7-5ab7-9468-8e985b6c0a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 2\\sqrt{x^{3}} + 2x}{3} + C" :db/id #edb/ref 17592186181504} {:answer/id #uuid "c8c0f99f-f43c-5656-ad88-f62d9b27ccb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 2\\sqrt[3]{x^{2}} + 2x}{3} + C" :db/id #edb/ref 17592186181505} {:answer/id #uuid "39ee7c07-44d7-5ef5-97de-7c0090d83f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 3\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181506} {:answer/id #uuid "5e14c783-f2a2-5eff-9bda-e48e2bc22284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 2\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181507}] :answer-field/id #uuid "55fc02a1-3a57-558e-b923-8f00b33126b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181502}] :question/id #uuid "564c4689-85ae-5d46-8778-645d30c6800f" :question/math-academy-id "q-2250" :question/problem "What is $$\n\\displaystyle \\int(x^{2} - \\sqrt{x} + 2)dx\n$$?"}] [{:db/id #edb/ref 17592186184738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9836b573-d927-50b1-b2a4-0ccf3e742d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{7}}}{7} - \\frac{2}{3\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186183043} {:answer/id #uuid "b7835897-2660-52c4-b3cd-da6bc55f2cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{7}}}{3} + \\frac{5}{3\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186183044} {:answer/id #uuid "c1601f06-29da-5717-a469-8e5ed3b92ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{x^{5}}}{7} - \\frac{7}{5\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186183045} {:answer/id #uuid "1aa875c2-66a0-5591-9f88-7cfb965f2a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{7} + \\frac{2}{3\\sqrt{x^{5}}} + C" :db/id #edb/ref 17592186183046} {:answer/id #uuid "74e1a9fb-4eb3-57c9-9555-eaa686b19404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{x^{3}}}{7} - \\frac{11}{3\\sqrt{x^{7}}} + C" :db/id #edb/ref 17592186183047}] :answer-field/id #uuid "f50e978e-1b94-5800-b880-db8b1e335087" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183042}] :question/id #uuid "bd6f191d-dd25-52a7-91ee-5275c10c8293" :question/math-academy-id "q-29828" :question/problem "Find the antiderivative of $\\sqrt{x^{5}} + \\frac{1}{\\sqrt{x^{5}}}$."}] [{:db/id #edb/ref 17592186184739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0295760-ce95-592b-8918-47e98fff062e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{4} + \\frac{5\\sqrt[6]{x^{5}}}{6} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C" :db/id #edb/ref 17592186183049} {:answer/id #uuid "c1baca12-4645-57ec-bb80-522c579d2dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{2} + \\frac{5\\sqrt[5]{x^{6}}}{6} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C" :db/id #edb/ref 17592186183050} {:answer/id #uuid "f62c1c24-e30c-5d3a-89bc-93a36f6194ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{2} + \\frac{6\\sqrt[5]{x^{6}}}{5} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C" :db/id #edb/ref 17592186183051} {:answer/id #uuid "131615a4-d31a-5361-8d8a-cfc92590ca05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + \\frac{5\\sqrt[5]{x^{6}}}{6} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C" :db/id #edb/ref 17592186183052} {:answer/id #uuid "713496cd-a9f5-56c1-b81f-979de96c5389" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{2} - \\frac{5\\sqrt[5]{x^{6}}}{3} + \\frac{7}{6\\sqrt[7]{x^{6}}} + C" :db/id #edb/ref 17592186183053}] :answer-field/id #uuid "975fc5fc-ca69-50a6-9a72-cc1bfd1b425b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183048}] :question/id #uuid "85a6ac94-4138-58eb-b70e-d9adb7cdff2f" :question/math-academy-id "q-29830" :question/problem "Find the antiderivative of\n$4x^{7} + \\sqrt[5]{x} - \\frac{1}{\\sqrt[7]{x^{13}}}$."}] [{:db/id #edb/ref 17592186228930 :question/id #uuid "2f5d8d59-2cc7-53bf-92ad-6062df331851" :question/math-academy-id "e-21765" :question/problem "A water-treatment holding tank initially holds $700\\,\\textrm{L}$ of liquid containing $12\\,\\textrm{kg}$ of dissolved coagulant.\nA feed solution containing $0.05\\,\\textrm{kg/L}$ of the coagulant is pumped into the tank at a rate of $30\\,\\textrm{L/min},$ while the completely mixed liquid is drained out at a rate of $20\\,\\textrm{L/min}.$\nFind, rounded to two decimal places, the amount of coagulant in the tank $8$ minutes after pumping begins." :question/worked-solution "Let $Q$ be the amount of coagulant in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which coagulant enters the tank minus the rate at which coagulant leaves the tank.\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}\n$$\n\nNote that the units of $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}, Q'_{\\textrm{in}}$ and $Q'_{\\textrm{out}}$ are $\\textrm{kg}/\\textrm{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which coagulant enters the tank.\n\nNote that a feed solution containing $0.05\\,\\textrm{kg/L}$ of the coagulant enters the tank at a rate of $30\\,\\textrm{L/min}.$ So, the rate at which the *coagulant* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.05\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (30\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.05\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (30\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =1.5\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which coagulant exits the tank.\n\nTo find the rate at which coagulant leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $700\\,\\textrm{L}$ of liquid; a solution enters at $30\\,\\textrm{L/min}$ and leaves at $20\\,\\textrm{L/min}.$\nAs a result, the volume of liquid in the tank after $t$ minutes is \n\n$$\n700 + 30t - 20t = (700+10t)\\,\\textrm{L}.\n$$\n\nSince $Q$ is the amount of coagulant in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\dfrac{Q}{700+10t}\\,\\textrm{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $20\\,\\textrm{L/min},$ *coagulant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(20\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{700+10t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{700+10t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{20Q}{700+10t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{2Q}{70+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =1.5-\\frac{2Q}{70+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{2}{70+t}Q=1.5.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(70+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|70+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(70+t)^{2}} \\\\  & =(70+t)^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t) = (70+t)^2$ yields\n\n$$\n\\begin{aligned}(70+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{70+t}Q) & =(70+t)^{2}\\cdot 1.5 \\\\ (70+t)^{2}\\frac{dQ}{dt}+2(70+t)Q & =1.5(70+t)^{2} \\\\ \\frac{d}{dt}(Q(70+t)^{2}) & =1.5(70+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t{:}$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(70+t)^{2})\\,dt & =\\int 1.5(70+t)^{2}\\,dt \\\\ Q(70+t)^{2} & =1.5\\cdot \\frac{1}{3}(70+t)^{3}+C \\\\ Q(t) & =0.5(70+t)+\\frac{C}{(70+t)^{2}}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $12\\,\\textrm{kg}$ of coagulant. So, we can apply the initial condition $Q(0) = 12,$ and solve for $C{:}$\n\n$$\n\\begin{aligned}Q(0) & =12 \\\\ 0.5(70+0)+\\frac{C}{(70+0)^{2}} & =12 \\\\ 35+\\frac{C}{{70}^{2}} & =12 \\\\ \\frac{C}{{70}^{2}} & =-23 \\\\ C & =-23(70)^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t){:}$\n\n$$\n\\begin{aligned}Q(t) & =0.5(70+t)-\\frac{23(70)^{2}}{(70+t)^{2}} \\\\  & =0.5(70+t)-23{\\left(\\frac{70}{70+t}\\right)}^{2}.\\end{aligned}\n$$\n\nFinally,  the amount of coagulant in the tank $8$ minutes after pumping begins is\n\n$$\n\\begin{aligned}Q(8) & =0.5(70+8)-23{\\left(\\frac{70}{70+8}\\right)}^{2} \\\\  & =39-23{\\left(\\frac{70}{78}\\right)}^{2} \\\\  & ≈20.48\\,\\text{kg},\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186228931 :question/id #uuid "bbf602f0-1101-55d5-a6b3-9bfc5731e9ec" :question/math-academy-id "e-21766" :question/problem "A syrup mixing tank in a confectionery factory can hold up to $240\\,\\textrm{gal}$ of liquid. Initially, it contains $96\\,\\textrm{gal}$ of syrup solution with $32\\,\\textrm{lb}$ of dissolved sugar. A more concentrated syrup with concentration $1.5\\,\\textrm{lb/gal}$ flows into the tank at a rate of $24\\,\\textrm{gal/min},$ while the completely mixed solution drains out at a rate of $16\\,\\textrm{gal/min}.$ Rounded to one decimal place, find the amount of sugar in the tank at the moment it begins to overflow." :question/worked-solution "Since $Q$ is the amount of sugar in the tank at time $t,$ the derivative \n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which sugar enters the tank minus the rate at which sugar leaves the tank.\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}\n$$\n\nNote that the units of $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}, Q'_{\\textrm{in}}$ and $Q'_{\\textrm{out}}$ are $\\textrm{lb}/\\textrm{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the tank.\n\nFirst, note that a solution containing $1.5\\,\\textrm{lb/gal}$ of sugar enters the tank at a rate of $24\\,\\textrm{gal/min}.$ So, the rate at which the *sugar* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(1.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (24\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(1.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (24\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =36\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the tank.\n\nTo find the rate at which sugar leaves the tank, we must first determine the volume of solution in the tank at time $t.$\n\nThe tank initially contains $96\\,\\textrm{gal}$ of solution; solution enters at $24\\,\\textrm{gal/min}$ and mixed solution leaves at $16\\,\\textrm{gal/min}.$\nAs a result, the amount of solution in the tank after $t$ minutes is \n\n$$\nV(t) = 96 + 24t - 16t = 8(12+t)\\,\\textrm{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of sugar in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\dfrac{Q}{8(12 + t)}\\,\\textrm{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $16\\,\\textrm{gal/min},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(16\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{8(12+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(16\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{8(12+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{16Q}{8(12+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{12+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =36-\\frac{2Q}{12+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} + \\dfrac{2}{12 + t}\\,Q = 36.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(12+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|12+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(12+t)^{2}} \\\\  & =(12+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t) = (12+t)^2$ yields\n\n$$\n\\begin{aligned}(12+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{12+t}\\,Q) & =(12+t)^{2}\\cdot 36 \\\\ (12+t)^{2}\\frac{dQ}{dt}+2(12+t)Q & =36(12+t)^{2} \\\\ \\frac{d}{dt}(Q(12+t)^{2}) & =36(12+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t{:}$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(12+t)^{2})\\,dt & =\\int 36(12+t)^{2}\\,dt \\\\ Q(12+t)^{2} & =36\\cdot \\frac{1}{3}(12+t)^{3}+C \\\\ Q(t) & =12(12+t)+\\frac{C}{(12+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $32\\,\\textrm{lb}$ of sugar. So, we can apply the initial condition $Q(0) = 32,$ and solve for $C{:}$\n\n$$\n\\begin{aligned}Q(0) & =32 \\\\ 12(12+0)+\\frac{C}{(12+0)^{2}} & =32 \\\\ 12\\cdot 12+\\frac{C}{(12)^{2}} & =32 \\\\ 144+\\frac{C}{{12}^{2}} & =32 \\\\ \\frac{C}{{12}^{2}} & =-112 \\\\ C & =-112(12)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t){:}$\n\n$$\n\\begin{aligned}Q(t) & =12(12+t)-\\frac{112(12)^{2}}{(12+t)^{2}} \\\\  & =12(12+t)-112{\\left(\\frac{12}{12+t}\\right)}^{2}.\\end{aligned}\n$$\n\nNow, let $t_o$ be the time when the tank begins to overflow. The tank has a capacity of $240\\,\\textrm{gal},$ so we can use the condition $V(t_o) = 240$ to solve for $t_o{:}$\n\n$$\n\\begin{aligned}V({t}_{o}) & =240 \\\\ 96+24{t}_{o}-16{t}_{o} & =240 \\\\ 96+8{t}_{o} & =240 \\\\ 8{t}_{o} & =144 \\\\ {t}_{o} & =18\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of sugar in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(18) & =12(12+18)-112{\\left(\\frac{12}{12+18}\\right)}^{2} \\\\  & =360-112{\\left(\\frac{12}{30}\\right)}^{2} \\\\  & ≈342.1\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186228949 :question/id #uuid "6b62d830-be21-5734-8a12-115b6a5136bf" :question/math-academy-id "e-21880" :question/problem "A fertilizer tank initially holds $800\\,\\textrm{L}$ of liquid containing $7\\,\\textrm{kg}$ of dissolved nutrient.\nA solution containing $0.01\\,\\textrm{kg/L}$ of dissolved nutrient is pumped into the tank at a rate of $40\\,\\textrm{L/min},$ while the completely mixed liquid is drained out at a rate of $40\\,\\textrm{L/min}.$ Which expression gives the amount of nutrient $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins?" :question/worked-solution "Let $Q$ be the amount of nutrient in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which nutrient enters the tank minus the rate at which nutrient leaves the tank.\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}\n$$\n\nNote that the units of $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}, Q'_{\\textrm{in}}$ and $Q'_{\\textrm{out}}$ are $\\textrm{kg}/\\textrm{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which additives enter the tank.\n\nNote that a feed solution containing $0.01\\,\\textrm{kg/L}$ of the nutrient enters the tank at a rate of $40\\,\\textrm{L/min}.$ So, the rate at which the *nutrient* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.01\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (40\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.01\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (40\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.4\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which additives exit the tank.\n\nNext, note that the rate of flow in equals the rate of flow out, so the volume in the tank remains $800\\,\\textrm{L}.$ Then, since $Q$ is the amount of nutrient in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\dfrac{Q}{800}\\,\\textrm{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $40\\,\\textrm{L/min},$ *nutrient* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(40\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{800}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(40\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{800}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{40Q}{800}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{20}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.4-\\frac{Q}{20}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} + \\dfrac{1}{20}Q = 0.4.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution $Q_c,$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\dfrac{\\mathrm{d}Q_c}{\\mathrm{d}t} + \\dfrac{1}{20}Q_c = 0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\nQ_c(t) = Ae^{-t/20},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\nQ_p(t) = \\alpha.\n$$\n\nTo find the value of $\\alpha,$ we substitute $Q_p = \\alpha$ and $\\dfrac{\\mathrm{d}Q_p}{\\mathrm{d}t} = (\\alpha)' = 0$ into the inhomogeneous equation:\n\n$$\n0 + \\dfrac{1}{20}\\alpha = 0.4\n  \\quad\\Longrightarrow\\quad\n  \\alpha = 8.\n$$\n\nTherefore, the particular solution is $Q_p(t) = 8.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nQ(t) = Q_c(t) + Q_p(t) = Ae^{-t/20} + 8.\n$$\n\nWe're told that the tank initially contains $7\\,\\textrm{kg}$ of dissolved nutrient. So, we can apply the initial condition $Q(0) = 7,$ and solve for $A{:}$\n\n$$\n\\begin{aligned}Q(0) & =7 \\\\ A{e}^{-0/20}+8 & =7 \\\\ A & =-1\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t){:}$\n\n$$\nQ(t) = 8 - e^{-t/20}.\n$$"}] [{:db/id #edb/ref 17592186229692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8db66dec-2792-5218-8a9d-85b9dbca389e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186228334} {:answer/id #uuid "a9f4e072-1f4c-5373-a3d6-0795c277ede4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186228335} {:answer/id #uuid "fd684dc0-61aa-5e73-9b90-b9380e77f537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186228336} {:answer/id #uuid "37b72754-baa1-5d83-b734-0964e3861b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186228337} {:answer/id #uuid "39eb6365-d2f3-5e96-a701-c71bfda37768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186228338}] :answer-field/id #uuid "579dbc44-8b7c-5a48-b291-b80099c940f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228333}] :question/id #uuid "5708b503-7d42-5d87-80c5-062229fe4d3c" :question/math-academy-id "q-336439" :question/problem "An aquarium initially holds $300L$ of water containing $6kg$ of dissolved minerals.\nA solution containing $0.03kg/L$ of dissolved minerals is pumped into the aquarium at a rate of $24L/min$, while the completely mixed water is drained out at a rate of $36L/min$. If the amount of minerals $Q(t)$, in kilograms, in the tank $t$ minutes after pumping begins is given by\n$$\n\\displaystyle Q(t) = α(1 - \\frac{t}{25}) + β(1 - \\frac{t}{25})^{3}\n$$\nwhere $α$ and $β$ are constants, what is the value of $α + β$?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186229693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac342bc-5d31-58a3-842a-8a4e79ae42dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "201.0\\,\\text{lb}" :db/id #edb/ref 17592186377193} {:answer/id #uuid "2980a552-e3d5-5564-ab0e-1bbb2358ce8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "204.3\\,\\text{lb}" :db/id #edb/ref 17592186377194} {:answer/id #uuid "b4d44c02-122b-57ce-ae8c-3073cccbf6f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "207.6\\,\\text{lb}" :db/id #edb/ref 17592186377195} {:answer/id #uuid "49a8983c-5113-540c-9960-edc50602eed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "206.2\\,\\text{lb}" :db/id #edb/ref 17592186377196} {:answer/id #uuid "8c1780f1-fe83-536d-9909-81d9b471da59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "205.4\\,\\text{lb}" :db/id #edb/ref 17592186377197}] :answer-field/correct {:answer/id #uuid "b4d44c02-122b-57ce-ae8c-3073cccbf6f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "207.6\\,\\text{lb}" :db/id #edb/ref 17592186377195} :answer-field/id #uuid "33da174c-337a-5186-96b2-62c3b16e65a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98f92dde-10ee-5a2e-ae0c-afe47e1981a5" :question/math-academy-id "q-336451" :question/problem "A de-icing salt reservoir can hold up to $300\\,\\text{gal}$ of liquid. Initially, it contains $180\\,\\text{gal}$ of brine with $54\\,\\text{lb}$ of dissolved salt. A stronger brine with concentration $0.8\\,\\text{lb/gal}$ flows into the reservoir at a rate of $6\\,\\text{gal/min},$ while the completely mixed brine drains out at a rate of $4\\,\\text{gal/min}.$\nFind the amount of salt in the reservoir at the moment it begins to overflow." :question/requires-calculator true :question/worked-solution "Since $Q$ is the amount of salt in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which minerals enter the tank minus the rate at which minerals leave the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which minerals enter the tank.\n\nFirst, note that a brine solution containing $0.8\\,\\text{lb/gal}$ of salt enters the reservoir at a rate of $6\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.8\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (6\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.8\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (6\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =4.8\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which minerals exit the tank.\n\nTo find the rate at which salt leaves the reservoir, we must first determine the volume of brine in the reservoir at time $t.$\n\nThe reservoir initially contains $180\\,\\text{gal}$ of brine; brine enters at $6\\,\\text{gal/min}$ and mixed brine leaves at $4\\,\\text{gal/min}.$\nAs a result, the amount of brine in the reservoir after $t$ minutes is \n\n$$\nV(t)=180+6t-4t=2(90+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of salt in the reservoir, the concentration of the brine at time $t$ is\n\n$$\n\\frac{Q}{2(90+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $4\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(4\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{2(90+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(4\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{2(90+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{4Q}{2(90+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{90+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =4.8-\\frac{2Q}{90+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{90+t}\\,Q=4.8.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(90+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|90+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(90+t)^{2}} \\\\  & =(90+t)^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(90+t)^{2}$ yields\n\n$$\n\\begin{aligned}(90+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{90+t}\\,Q) & =(90+t)^{2}\\cdot 4.8 \\\\ (90+t)^{2}\\frac{dQ}{dt}+2(90+t)Q & =4.8(90+t)^{2} \\\\ \\frac{d}{dt}(Q(90+t)^{2}) & =4.8(90+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(90+t)^{2})\\,dt & =\\int 4.8(90+t)^{2}\\,dt \\\\ Q(90+t)^{2} & =4.8\\cdot \\frac{1}{3}(90+t)^{3}+C \\\\ Q(t) & =1.6(90+t)+\\frac{C}{(90+t)^{2}}\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $54\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=54,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =54 \\\\ 1.6(90+0)+\\frac{C}{(90+0)^{2}} & =54 \\\\ 144+\\frac{C}{(90)^{2}} & =54 \\\\ C & =-90(90)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =1.6(90+t)-\\frac{90(90)^{2}}{(90+t)^{2}} \\\\  & =1.6(90+t)-90{\\left(\\frac{90}{90+t}\\right)}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $300\\,\\text{gal},$ so we can use the condition $V({t}_{o})=300$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =300 \\\\ 2(90+{t}_{o}) & =300 \\\\ 90+{t}_{o} & =150 \\\\ {t}_{o} & =60\\,\\text{min}\\end{aligned}\n$$\n\nFinally, the amount of salt in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(60) & =1.6(90+60)-90{\\left(\\frac{90}{90+60}\\right)}^{2} \\\\  & =240-90{\\left(\\frac{9}{15}\\right)}^{2} \\\\  & =207.6\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186229694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c17fcaa1-cd0a-5b81-a422-98bed86e8456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95.2lb" :db/id #edb/ref 17592186228346} {:answer/id #uuid "cf230f49-5d88-556c-b1ef-9be0df07fa17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "94.7lb" :db/id #edb/ref 17592186228347} {:answer/id #uuid "f2079ff6-400e-5858-be77-8608b194d8c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95.0lb" :db/id #edb/ref 17592186228348} {:answer/id #uuid "37221632-d09d-5e81-8be5-0ac427f473d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93.5lb" :db/id #edb/ref 17592186228349} {:answer/id #uuid "719abf85-d7e7-5fed-8da5-1c3347fb8a6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "94.2lb" :db/id #edb/ref 17592186228350}] :answer-field/id #uuid "d74abd8b-f96b-59a5-a0ea-b2c09890154a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228345}] :question/id #uuid "138b92a0-177f-5f9d-993c-5b85e485defc" :question/math-academy-id "q-336499" :question/problem "A nutrient tank for a hydroponic greenhouse can hold up to $210gal$ of solution. Initially, it contains $120gal$ of nutrient solution with $30lb$ of dissolved nutrient. A more concentrated solution with concentration $0.5lb/gal$ flows into the tank at a rate of $9gal/min$, while the completely mixed solution drains out at a rate of $6gal/min$. Rounded to one decimal place, find the amount of nutrient in the tank at the moment it begins to overflow.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186229698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132d6c9e-eb68-5d65-8d72-ee64a266345d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.18\\,\\text{kg}" :db/id #edb/ref 17592186501500} {:answer/id #uuid "14f59116-2d5c-52e2-9b35-7f32ef8ca9aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.21\\,\\text{kg}" :db/id #edb/ref 17592186501506} {:answer/id #uuid "23c67163-5885-5331-b6df-e6f1abd577ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.81\\,\\text{kg}" :db/id #edb/ref 17592186501529} {:answer/id #uuid "df01cbb2-ff59-5cab-a987-8313d051432e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.63\\,\\text{kg}" :db/id #edb/ref 17592186501913} {:answer/id #uuid "eb7cb287-8d09-5c98-9bf7-3d208192ac9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.99\\,\\text{kg}" :db/id #edb/ref 17592186501939}] :answer-field/correct {:answer/id #uuid "23c67163-5885-5331-b6df-e6f1abd577ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.81\\,\\text{kg}" :db/id #edb/ref 17592186501529} :answer-field/id #uuid "4ad053d7-10e4-578d-b606-6bda94abf500" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228371}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "310f29d9-e5f9-5829-9c84-72d1324e1777" :question/math-academy-id "q-336738" :question/problem "A storage tank initially holds $600\\,\\text{L}$ of liquid containing $5\\,\\text{kg}$ of dissolved stabilizer.\nA feed solution containing $0.04\\,\\text{kg/L}$ of the stabilizer is pumped into the tank at a rate of $15\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $10\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of stabilizer in the tank $10$ minutes after pumping begins." :question/requires-calculator true :question/worked-solution "Let $Q$ be the amount of stabilizer in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which stabilizer enters the tank minus the rate at which stabilizer leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which stabilizer enters the tank.\n\nNote that a feed solution containing $0.04\\,\\text{kg/L}$ of the stabilizer enters the tank at a rate of $15\\,\\text{L/min}.$ So, the rate at which the *stabilizer* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (15\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.6\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which stabilizer exits the tank.\n\nTo find the rate at which stabilizer leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $600\\,\\text{L}$ of liquid; a solution enters at $15\\,\\text{L/min}$ and leaves at $10\\,\\text{L/min}.$\nAs a result, the volume of liquid in the tank after $t$ minutes is \n\n$$\n600+15t-10t=(600+5t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of stabilizer in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{600+5t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $10\\,\\text{L/min},$ *stabilizer* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(10\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{600+5t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(10\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{600+5t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{10Q}{600+5t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{2Q}{120+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.6-\\frac{2Q}{120+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{2}{120+t}Q=0.6.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(120+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|120+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(120+t)^{2}} \\\\  & =(120+t)^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(120+t)^{2}$ yields\n\n$$\n\\begin{aligned}(120+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{120+t}Q) & =(120+t)^{2}\\cdot 0.6 \\\\ (120+t)^{2}\\frac{dQ}{dt}+2(120+t)Q & =0.6(120+t)^{2} \\\\ \\frac{d}{dt}(Q(120+t)^{2}) & =0.6(120+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(120+t)^{2})\\,dt & =\\int 0.6(120+t)^{2}\\,dt \\\\ Q(120+t)^{2} & =0.6\\cdot \\frac{1}{3}(120+t)^{3}+C \\\\ Q(t) & =0.2(120+t)+\\frac{C}{(120+t)^{2}}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $5\\,\\text{kg}$ of stabilizer. So, we can apply the initial condition $Q(0)=5,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =5 \\\\ 0.2(120+0)+\\frac{C}{(120+0)^{2}} & =5 \\\\ 24+\\frac{C}{{120}^{2}} & =5 \\\\ \\frac{C}{{120}^{2}} & =-19 \\\\ C & =-19(120)^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.2(120+t)-\\frac{19(120)^{2}}{(120+t)^{2}} \\\\  & =0.2(120+t)-19{\\left(\\frac{120}{120+t}\\right)}^{2}.\\end{aligned}\n$$\n\nFinally,  the amount of stabilizer in the tank $10$ minutes after pumping begins is\n\n$$\n\\begin{aligned}Q(10) & =0.2(120+10)-19{\\left(\\frac{120}{120+10}\\right)}^{2} \\\\  & =26-19{\\left(\\frac{12}{13}\\right)}^{2} \\\\  & ≈9.81\\,\\text{kg},\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186229724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ea8df2-9a57-5710-b7c3-195b889f7f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=22.5-16.5{e}^{-t/20}" :db/id #edb/ref 17592186501754} {:answer/id #uuid "dd85ac5a-dd49-59af-aa19-5e740d5694bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=22.5-16.5{e}^{-t/25}" :db/id #edb/ref 17592186501910} {:answer/id #uuid "e796a362-8cfa-568a-9c64-27bf196de4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=22.5+16.5{e}^{-t/25}" :db/id #edb/ref 17592186501932} {:answer/id #uuid "e7d824a3-01e9-5812-b58b-a58e01e5be71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=22.5-16.5{e}^{t/25}" :db/id #edb/ref 17592186501933} {:answer/id #uuid "f48f1195-a2b9-5291-9be2-abc8416f3fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=6-22.5{e}^{-t/25}" :db/id #edb/ref 17592186501956}] :answer-field/correct {:answer/id #uuid "dd85ac5a-dd49-59af-aa19-5e740d5694bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=22.5-16.5{e}^{-t/25}" :db/id #edb/ref 17592186501910} :answer-field/id #uuid "3214b49d-a843-5dfc-aaf4-826626ec3984" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228561}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "872cac41-3a52-503a-bac8-64cc582ee5f1" :question/math-academy-id "q-339385" :question/problem "A wastewater basin initially holds $750\\,\\text{L}$ of water containing $6\\,\\text{kg}$ of dissolved pollutant.\nA solution containing $0.03\\,\\text{kg/L}$ of dissolved pollutant is pumped into the basin at a rate of $30\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $30\\,\\text{L/min}.$ Which expression gives the amount of pollutant $Q(t),$ in kilograms, in the basin $t$ minutes after pumping begins?" :question/worked-solution "Let $Q$ be the amount of pollutant in the basin at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which pollutant enters the basin minus the rate at which pollutant leaves the basin.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which additives enter the basin.\n\nNote that a feed solution containing $0.03\\,\\text{kg/L}$ of the pollutant enters the basin at a rate of $30\\,\\text{L/min}.$ So, the rate at which the *pollutant* enters the basin is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.03\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (30\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.03\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (30\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.9\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which additives exit the basin.\n\nNext, note that the rate of flow in equals the rate of flow out, so the volume in the basin remains $750\\,\\text{L}.$ Then, since $Q$ is the amount of pollutant in the basin, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{750}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $30\\,\\text{L/min},$ *pollutant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(30\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{750}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(30\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{750}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{30Q}{750}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{25}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.9-\\frac{Q}{25}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1}{25}Q=0.9.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${Q}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{Q}_{c}}{dt}+\\frac{1}{25}{Q}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{Q}_{c}(t)=A{e}^{-t/25},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{Q}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${Q}_{p}=\\alpha $ and $\\frac{d{Q}_{p}}{dt}=(\\alpha )^{′}=0$ into the inhomogeneous equation:\n\n$$\n0+\\frac{1}{25}\\alpha =0.9\\,⟹\\,\\alpha =22.5.\n$$\n\nTherefore, the particular solution is ${Q}_{p}(t)=22.5.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nQ(t)={Q}_{c}(t)+{Q}_{p}(t)=A{e}^{-t/25}+22.5.\n$$\n\nWe're told that the basin initially contains $6\\,\\text{kg}$ of dissolved pollutant. So, we can apply the initial condition $Q(0)=6,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =6 \\\\ A{e}^{-0/25}+22.5 & =6 \\\\ A & =-16.5\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=22.5-16.5{e}^{-t/25}.\n$$"}] [{:db/id #edb/ref 17592186229725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e1475d2-7658-5bfe-ac43-ffd1505c10be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.83kg" :db/id #edb/ref 17592186228568} {:answer/id #uuid "f373892c-d44d-5ca4-87c6-9686668b6bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.02kg" :db/id #edb/ref 17592186228569} {:answer/id #uuid "f5a3f476-7ca4-5e94-a291-5155c9a0a5fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.11kg" :db/id #edb/ref 17592186228570} {:answer/id #uuid "190a0242-051d-533b-8e18-6d0b767d11ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.45kg" :db/id #edb/ref 17592186228571} {:answer/id #uuid "53ddf027-12e1-5680-907f-e7217bcbea8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.76kg" :db/id #edb/ref 17592186228572}] :answer-field/id #uuid "60eabee9-a505-5182-8327-f4aaf6a75e48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228567}] :question/id #uuid "0b497833-a441-5b14-bcbb-b0d828ec78fc" :question/math-academy-id "q-339392" :question/problem "A fish hatchery tank initially holds $900L$ of water containing $10kg$ of dissolved salt.\nA feed solution containing $0.02kg/L$ of the salt is pumped into the tank at a rate of $30L/min$, while the completely mixed liquid is drained out at a rate of $30L/min$.\nFind, rounded to two decimal places, the amount of salt in the tank $6$ minutes after pumping begins."}] [{:db/id #edb/ref 17592186233174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} {:answer/id #uuid "62de7813-7886-5bed-86cd-1ca23e600b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21{x}^{19}+C" :db/id #edb/ref 17592186513799} {:answer/id #uuid "65428549-ccd7-5201-8026-265c549f0352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{19}+C" :db/id #edb/ref 17592186513804} {:answer/id #uuid "7f5af8b6-1444-5218-bbb1-bf6a887d157c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{19}}{19}+C" :db/id #edb/ref 17592186513863} {:answer/id #uuid "8cf69104-089b-5eec-8f81-3bf53d5632ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{x}^{21}+C" :db/id #edb/ref 17592186513895}] :answer-field/correct {:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} :answer-field/id #uuid "6982cbcb-0bd9-554d-8104-e02dd398a383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514278}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e6c66f6-6133-59f6-a79d-0cbf1615accf" :question/math-academy-id "q-113665" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{20}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=20$, and we get\n\n$$\n\\int {x}^{20}\\,\\text{d}x=\\frac{{x}^{20+1}}{20+1}+C=\\frac{{x}^{21}}{21}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{21}}{21}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{21}\\frac{\\text{d}}{\\text{d}x}({x}^{21})+0 \\\\ &= \\frac{1}{21}\\cdot 21{x}^{20} \\\\ &= {x}^{20}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233175 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7949e7bf-09d1-5ce9-ac3c-0d7f26b2e6c4" :question/math-academy-id "q-113670" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{17}$ and ${F}^{'}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=17$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{17}\\,\\text{d}x \\\\  & =\\frac{{x}^{17+1}}{17+1}+C \\\\  & =\\frac{{x}^{18}}{18}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{18}}{18}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{18}}{18}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{18}\\frac{\\text{d}}{\\text{d}x}({x}^{18})+0 \\\\ &= \\frac{1}{18}\\cdot 18\\,{x}^{17} \\\\ &= {x}^{17}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233176 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "353f4779-4251-5a93-b99f-1eda6757b24d" :question/math-academy-id "q-113674" :question/problem "Find the antiderivative of ${x}^{1/4}.$" :question/worked-solution "We can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233177 :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1eab1e18-d0df-58e6-917b-50a1d74ed3f6" :question/math-academy-id "q-113680" :question/problem "Calculate the integral of $\\sqrt[5]{{x}^{3}}.$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{3}}={x}^{3/5}.$ So, we can apply the power rule with $n=\\frac{3}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{3}}\\,\\text{d}x & =\\int {x}^{3/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/5+1}}{(\\frac{3}{5}+1)}+C \\\\  & =\\frac{{x}^{8/5}}{\\left(\\frac{8}{5}\\right)}+C \\\\  & =\\frac{5{x}^{8/5}}{8}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{8/5}}{8}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{8/5}}{8}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{8}\\frac{\\text{d}}{\\text{d}x}({x}^{8/5})+0 \\\\ &= \\frac{5}{8}\\cdot \\frac{8}{5}{x}^{8/5-1} \\\\ &= {x}^{3/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233178 :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "63703f37-ab84-53aa-922b-b2e419a9f1a5" :question/math-academy-id "q-113695" :question/problem "Find the antiderivative of $\\sqrt[5]{{x}^{2}}.$" :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[5]{{x}^{2}}={x}^{2/5}.$ So, we can apply the power rule with $n=\\frac{2}{5}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[5]{{x}^{2}}\\,\\text{d}x & =\\int {x}^{2/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{2/5+1}}{(\\frac{2}{5}+1)}+C \\\\  & =\\frac{{x}^{7/5}}{\\left(\\frac{7}{5}\\right)}+C \\\\  & =\\frac{5{x}^{7/5}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{5{x}^{7/5}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{5{x}^{7/5}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{5}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/5})+0 \\\\ &= \\frac{5}{7}\\cdot \\frac{7}{5}{x}^{7/5-1} \\\\ &= {x}^{2/5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233179 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25edeff2-faa4-50c4-bbfd-3291d7ac7694" :question/math-academy-id "q-113705" :question/problem "Given that $f(x)=\\frac{1}{{x}^{4/3}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{4/3}}={x}^{-4/3}.$ So, we can use the power rule with $n=-\\frac{4}{3}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-4/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{\\left(-\\frac{1}{3}\\right)}+C \\\\  & =-3{x}^{-1/3}+C \\\\  & =-\\frac{3}{{x}^{1/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233186 :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d0c3f56-ed74-5e4d-bb18-eac56541b5e8" :question/math-academy-id "q-113781" :question/problem "Find the antiderivative of $\\sqrt[4]{x}-{x}^{5}.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\sqrt[4]{x}-{x}^{5}\\,\\text{d}x & =\\int {x}^{1/4}\\,\\text{d}x-\\int {x}^{5}\\,\\text{d}x \\\\  & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}-\\frac{{x}^{5+1}}{(5+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}-\\frac{{x}^{6}}{(6)}+C \\\\  & =\\frac{4\\sqrt[4]{{x}^{5}}}{5}-\\frac{{x}^{6}}{6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233194 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96dcd1e4-f866-5c31-9249-b3c6a08f3b50" :question/math-academy-id "q-113923" :question/problem "$$\n\\displaystyle \\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x & =3\\int \\operatorname{cos}x\\,\\text{d}x-2\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3\\operatorname{sin}x-2\\operatorname{sec}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233195 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b17add20-e3fe-557a-b7ba-b30e3097020e" :question/math-academy-id "q-113925" :question/problem "$$\n\\displaystyle \\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233197 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d24358a-b43d-52c4-a1f0-66ea18710364" :question/math-academy-id "q-113935" :question/problem "$$\n\\displaystyle \\int -\\frac{3}{2}{sec}^{2}x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}x\\,\\text{d}x=\\operatorname{tan}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{3}{2}{sec}^{2}x\\,\\text{d}x & =-\\frac{3}{2}\\int {sec}^{2}x\\,\\text{d}x \\\\  & =-\\frac{3}{2}(\\operatorname{tan}x)+C \\\\  & =-\\frac{3}{2}\\operatorname{tan}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233199 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f618a7fb-c5a6-5658-a8d2-b99235d841c5" :question/math-academy-id "q-113948" :question/problem "$$\n\\displaystyle \\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}x\\,\\text{d}x=-\\operatorname{cot}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x & =-\\frac{5}{2}\\int {csc}^{2}x\\,\\text{d}x \\\\  & =-\\frac{5}{2}(-\\operatorname{cot}x)+C \\\\  & =\\frac{5}{2}\\operatorname{cot}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233200 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1c076ca-58d1-50c6-89b5-7409bb1c260d" :question/math-academy-id "q-113952" :question/problem "$$\n\\displaystyle \\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =3\\int {csc}^{2}x\\,\\text{d}x-4\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3(-\\operatorname{cot}x)-4(\\operatorname{sec}x)+C \\\\  & =-3\\operatorname{cot}x-4\\operatorname{sec}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233201 :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1dc5c87c-64df-54e7-9938-40291c767c67" :question/math-academy-id "q-113958" :question/problem "$$\n\\displaystyle \\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int sin\\,\\text{d}x & =-\\operatorname{cos}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x & =\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x-2\\int {csc}^{2}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =\\operatorname{sec}x-2(-\\operatorname{cot}x)+(-\\operatorname{cos}x)+C \\\\  & =\\operatorname{sec}x+2\\operatorname{cot}x-\\operatorname{cos}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d273204-9c71-5dd0-b69b-1a90276ae151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186716952}] :answer-field/correct {:answer/id #uuid "2d273204-9c71-5dd0-b69b-1a90276ae151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186716952} :answer-field/id #uuid "d37edfe3-8d04-5659-9550-117d4c4acd83" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186716953}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ed3ae951-db6d-557c-8a34-9c013751cf9a" :question/math-academy-id "q-127614" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2x & 6 \\\\ 2x & x-2\\end{bmatrix}\n$$\nand $det(D)=-32$, what is the value of $x?$\n\n$x=$ {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(D) & =\\begin{vmatrix}2x & 6 \\\\ 2x & x-2\\end{vmatrix} \\\\  & =2x\\cdot (x-2)-6\\cdot 2x \\\\  & =2{x}^{2}-16x\\end{aligned}\n$$\n\nSince $det(D)=-32$, we obtain:\n\n$$\n\\begin{aligned}det(D) & =-32 \\\\ 2{x}^{2}-16x & =-32 \\\\ 2{x}^{2}-16x+32 & =0 \\\\ {x}^{2}-8x+16 & =0 \\\\ (x-4)^{2} & =0 \\\\ x & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "716b9760-7403-5664-a541-6f49fb28dac8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186232204}] :answer-field/correct {:answer/id #uuid "716b9760-7403-5664-a541-6f49fb28dac8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{4/3}}{4}" :db/id #edb/ref 17592186232204} :answer-field/id #uuid "6e017c6d-4e9c-5cb6-a364-f311476d6242" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232203}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a718be7-eb73-54f8-925e-728120665d52" :question/math-academy-id "q-143041" :question/problem "The antiderivative of $\\sqrt[3]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/retired true :question/worked-solution "Since $\\sqrt[3]{x}={x}^{1/3}$, we can apply the power rule with $n=\\frac{1}{3}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/3}\\,\\text{d}x & =\\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =\\frac{{x}^{4/3}}{\\left(\\frac{4}{3}\\right)}+C \\\\  & =\\frac{3{x}^{4/3}}{4}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{4/3}}{4}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{3{x}^{4/3}}{4}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{3}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4/3})+0 \\\\ &= \\frac{3}{4}\\cdot \\frac{4}{3}{x}^{4/3-1} \\\\ &= {x}^{1/3}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fab2b00-89b9-5e37-acd4-cacd09480aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id #edb/ref 17592186232210}] :answer-field/correct {:answer/id #uuid "1fab2b00-89b9-5e37-acd4-cacd09480aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id #edb/ref 17592186232210} :answer-field/id #uuid "741876d0-ec1d-5a78-b6aa-658f559e821f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232209}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c3f30b1-6acc-552c-b509-78b7cd37e409" :question/math-academy-id "q-143522" :question/problem "$$\n\\displaystyle \\int v(t)\\,\\text{d}t\\,\\,=\\,\n$${{field-1}} $+\\text{ }C$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}t\\,\\text{d}t=-\\operatorname{cot}t+C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4{csc}^{2}t\\,\\text{d}t & =4\\int {csc}^{2}t\\,\\text{d}t \\\\  & =4(-\\operatorname{cot}t)+C \\\\  & =-4\\operatorname{cot}t+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233634 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef8ad019-8d31-5614-ab73-184fca0a32e7" :question/math-academy-id "q-2162" :question/problem "$$\n\\displaystyle \\int (2{sec}^{2}x-\\operatorname{sin}x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int {sec}^{2}x\\,\\text{d}x & =\\operatorname{tan}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (2{sec}^{2}x-\\operatorname{sin}x)\\,\\text{d}x & =\\int 2{sec}^{2}x\\,\\text{d}x-\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2\\operatorname{tan}x-(-\\operatorname{cos}x)+C \\\\  & =2\\operatorname{tan}x+\\operatorname{cos}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233636 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "295e7322-51e3-57c4-a92b-99303a51ff13" :question/math-academy-id "q-2165" :question/problem "$$\n\\displaystyle \\int (\\operatorname{sec}x\\operatorname{tan}x-{sec}^{2}x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int {sec}^{2}x\\,\\text{d}x & =\\operatorname{tan}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{sec}x\\operatorname{tan}x-{sec}^{2}x)\\,\\text{d}x & =\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x-\\int {sec}^{2}x\\,\\text{d}x \\\\  & =\\operatorname{sec}x-\\operatorname{tan}x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233643 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b6e2582-e861-5aac-850f-2f62d29905a5" :question/math-academy-id "q-2251" :question/problem "Find the antiderivative of $3x+6.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 3x+6\\,\\text{d}x & =\\int 3x\\,\\text{d}x+\\int 6\\,\\text{d}x \\\\  & =3\\int x\\,\\text{d}x+6\\int 1\\,\\text{d}x \\\\  & =3\\left(\\frac{{x}^{2}}{2}\\right)+6(x)+C \\\\  & =\\frac{3{x}^{2}}{2}+6x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233644 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8f7dc381-ff4a-5ab2-9c80-1b180b43d77b" :question/math-academy-id "q-2252" :question/problem "Find the antiderivative of $2{x}^{2}-x+\\frac{1}{2}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (2{x}^{2}-x+\\frac{1}{2})\\,\\text{d}x & =2\\int {x}^{2}\\,\\text{d}x-\\int x\\,\\text{d}x+\\int \\frac{1}{2}\\,\\text{d}x \\\\  & =2\\left(\\frac{{x}^{3}}{3}\\right)-\\left(\\frac{{x}^{2}}{2}\\right)+\\left(\\frac{x}{2}\\right)+C \\\\  & =\\frac{2{x}^{3}}{3}-\\frac{{x}^{2}}{2}+\\frac{x}{2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233751 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a192223-274d-5d58-847a-c92d2faa98df" :question/math-academy-id "q-29633" :question/problem "What is the antiderivative of $\\frac{1}{{x}^{4}}?$" :question/worked-solution "Note that $\\frac{1}{{x}^{4}}={x}^{-4}.$ So, we can use the power rule with $n=-4$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x & =\\int {x}^{-4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4+1}}{-4+1}+C \\\\  & =-\\frac{{x}^{-3}}{3}+C \\\\  & =-\\frac{1}{3{x}^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233752 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8dcd24a2-ce5f-5ab6-8a92-814e8f1355a9" :question/math-academy-id "q-29662" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt{{x}^{5}}}$" :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt{{x}^{5}}}=\\frac{1}{{x}^{5/2}}={x}^{-5/2}.\n$$ So, we can use the power rule with $n=-\\frac{5}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{5}}} & =\\int {x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}+C \\\\  & =-\\frac{2}{3}{x}^{-3/2}+C \\\\  & =-\\frac{2}{3{x}^{3/2}}+C.\\end{aligned}\n$$"}]}
