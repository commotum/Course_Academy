#{[{:db/id #edb/ref 17592186693317 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63fa7857-f7dd-5dd9-a9d7-799067c155cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2b/2b19f87eb17d91b115dc77303c2780e3f4c95b524378d8af1c9b156fb36165c6.png" :db/id #edb/ref 17592186693318} {:answer/id #uuid "af476738-f81e-5de9-acd4-effb341e5cca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0ad0c95f20718d10a442f75aa84a945d92e065bbe64878c7296488ee9a9016e7.png" :db/id #edb/ref 17592186693324} {:answer/id #uuid "c18f5826-8616-5e79-b8bf-b7a8eba085ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/01bbea6f674cf87bc6ac46196806e94bf7590295031b7b849695f350f299882c.png" :db/id #edb/ref 17592186693325}] :answer-field/correct {:answer/id #uuid "63fa7857-f7dd-5dd9-a9d7-799067c155cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2b/2b19f87eb17d91b115dc77303c2780e3f4c95b524378d8af1c9b156fb36165c6.png" :db/id #edb/ref 17592186693318} :answer-field/id #uuid "3f53752e-4e9f-56eb-9add-008983959e0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693315}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "635cc7ea-9335-5904-aa1b-c48cbaa3ecf0" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=- x - 2 y - 1?$\n\nCompare the slopes along the blue lines $x=0.75$ and $y=-0.75$. The right-hand side changes when either variable changes while the other is held fixed. Choose the field showing both kinds of change." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/2b/2b19f87eb17d91b115dc77303c2780e3f4c95b524378d8af1c9b156fb36165c6.png)\n\n \n\nAlong the blue comparison lines, slopes change in both directions. A special constant row or column does not rule out dependence on both variables; check the rest of the field as well.\n\n![](images/2b/2b19f87eb17d91b115dc77303c2780e3f4c95b524378d8af1c9b156fb36165c6.png)"}] [{:db/id #edb/ref 17592186693323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af67d77-e2b7-5e79-98ed-919d8cfa189e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c2fc4e7b510f10359e31a46f0adbe4292c14a7cc9f440494452ba380139dd51f.png" :db/id #edb/ref 17592186693311} {:answer/id #uuid "a2e5b4b0-13e6-5085-8d4b-5d17d1935d4d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d3ba7155c7899ff7fb453287ce045f19dc16e19b62656e160666881dc5f9b41e.png" :db/id #edb/ref 17592186693322} {:answer/id #uuid "f0f86256-3160-521b-8bcd-77dc5f4b4c47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a5/a590d6d7cd787d3c6c15a391fe41c69901d978711182dcb4ff94472b56c82db9.png" :db/id #edb/ref 17592186693328}] :answer-field/correct {:answer/id #uuid "f0f86256-3160-521b-8bcd-77dc5f4b4c47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a5/a590d6d7cd787d3c6c15a391fe41c69901d978711182dcb4ff94472b56c82db9.png" :db/id #edb/ref 17592186693328} :answer-field/id #uuid "0723eedf-addf-5693-b937-b9224bf4e990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aee9e2f1-09b0-5ed6-82c3-e6a4ddd31aee" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=- 2 x + y - 2?$\n\nCompare the slopes along the blue lines $x=0.75$ and $y=-0.75$. The right-hand side changes when either variable changes while the other is held fixed. Choose the field showing both kinds of change." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/a5/a590d6d7cd787d3c6c15a391fe41c69901d978711182dcb4ff94472b56c82db9.png)\n\n \n\nAlong the blue comparison lines, slopes change in both directions. A special constant row or column does not rule out dependence on both variables; check the rest of the field as well.\n\n![](images/a5/a590d6d7cd787d3c6c15a391fe41c69901d978711182dcb4ff94472b56c82db9.png)"}] [{:db/id #edb/ref 17592186693326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e67061-fd3a-556f-8a5c-6606258de0d1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9e/9e6232b017b50928b7aeaed1ab3d7b830af1aa8a4efbc0476ea25f64279d4cdb.png" :db/id #edb/ref 17592186693312} {:answer/id #uuid "36c68776-681a-5745-b43a-cbfc8c22f9bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/7089d262674f049c14716553f281fa892a0d38e846d28657c03142cd27952ceb.png" :db/id #edb/ref 17592186693313} {:answer/id #uuid "89f9e576-9c0d-5476-92d9-fa6e9e9dec7a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/25/25405f0c0d8d3921e5d1a6a5e7c9b4dcdc84800be16a4dac5876cb0b07d28864.png" :db/id #edb/ref 17592186693320}] :answer-field/correct {:answer/id #uuid "36c68776-681a-5745-b43a-cbfc8c22f9bd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/7089d262674f049c14716553f281fa892a0d38e846d28657c03142cd27952ceb.png" :db/id #edb/ref 17592186693313} :answer-field/id #uuid "a20975c8-06fe-57f2-9b47-0663d480a078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186693321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2ee4072-7694-5974-be28-524a07c3d5cb" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=- 2 x - 2 y + 2?$\n\nCompare the slopes along the blue lines $x=0.75$ and $y=-0.75$. The right-hand side changes when either variable changes while the other is held fixed. Choose the field showing both kinds of change." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/70/7089d262674f049c14716553f281fa892a0d38e846d28657c03142cd27952ceb.png)\n\n \n\nAlong the blue comparison lines, slopes change in both directions. A special constant row or column does not rule out dependence on both variables; check the rest of the field as well.\n\n![](images/70/7089d262674f049c14716553f281fa892a0d38e846d28657c03142cd27952ceb.png)"}] [{:db/id #edb/ref 17592186694136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233f82fd-4089-5169-84a4-b38d897b0aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3}{3}+2x+C" :db/id #edb/ref 17592186694132} {:answer/id #uuid "81a99f64-b29c-5256-a217-4c75917f3056" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^2}{2}+2x+C" :db/id #edb/ref 17592186694135} {:answer/id #uuid "974f6b16-47cf-5c6e-99b4-49d6eb680a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^3+2x+C" :db/id #edb/ref 17592186694137} {:answer/id #uuid "b81d9d2b-8f1c-5b82-9188-8e2896c95ff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3}{3}-2x+C" :db/id #edb/ref 17592186694140} {:answer/id #uuid "d0605535-96ca-5a2a-bed4-dba625b710b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3}{3}+2+C" :db/id #edb/ref 17592186694141}] :answer-field/correct {:answer/id #uuid "233f82fd-4089-5169-84a4-b38d897b0aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3}{3}+2x+C" :db/id #edb/ref 17592186694132} :answer-field/id #uuid "f4bc978d-d4c1-5a80-9bd3-59b9d94c7c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694144}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d257c27-d4e9-5ee5-a61a-9b76abc5f0d3" :question/problem "Use the sum rule to find the integral. The split is shown for you:\n\n$$\n\\int (x^2+2)\\,\\mathrm{d}x=\\int x^2\\,\\mathrm{d}x+\\int 2\\,\\mathrm{d}x.\n$$\n\nChoose the general antiderivative, where $C$ is an arbitrary constant." :question/worked-solution "Integrate each term, using the power rule for $x^2$ and the fact that a constant $2$ has antiderivative $2x$:\n\n$$\n\\begin{aligned}\n\\int (x^2+2)\\,\\mathrm{d}x\n&=\\int x^2\\,\\mathrm{d}x+\\int 2\\,\\mathrm{d}x\\\\\n&=\\frac{x^{2+1}}{2+1}+2x+C\\\\\n&=\\frac{x^3}{3}+2x+C.\n\\end{aligned}\n$$\n\nThe two integration constants combine into one arbitrary constant $C$. Differentiating gives $x^2+2$."}] [{:db/id #edb/ref 17592186694139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07826de1-b2c9-5972-ada6-4bba8fe70e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{5/4}+\\frac{2}{\\sqrt{x}}" :db/id #edb/ref 17592186694130}] :answer-field/correct {:answer/id #uuid "07826de1-b2c9-5972-ada6-4bba8fe70e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{5/4}+\\frac{2}{\\sqrt{x}}" :db/id #edb/ref 17592186694130} :answer-field/id #uuid "d3e151a0-7d31-5583-8eb1-34db0e02c819" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694142}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "abfbf5c1-9bbe-5d44-92de-c16dd31ab80a" :question/problem "Find the general antiderivative for $x>0$. Enter the expression before the arbitrary constant $C$.\n\n$$\n\\int \\left(\\sqrt[4]{x}-\\frac{1}{\\sqrt{x^3}}\\right)\\,\\mathrm{d}x=\n$$\n{{field-1}} $+C$" :question/worked-solution "For $x>0$, write $\\sqrt[4]{x}=x^{1/4}$ and $1/\\sqrt{x^3}=x^{-3/2}$. Split the difference and integrate each power:\n\n$$\n\\begin{aligned}\n\\int \\left(\\sqrt[4]{x}-\\frac{1}{\\sqrt{x^3}}\\right)\\,\\mathrm{d}x\n&=\\int x^{1/4}\\,\\mathrm{d}x-\\int x^{-3/2}\\,\\mathrm{d}x\\\\\n&=\\frac{x^{1/4+1}}{1/4+1}-\\frac{x^{-3/2+1}}{-3/2+1}+C\\\\\n&=\\frac{x^{5/4}}{5/4}-\\frac{x^{-1/2}}{-1/2}+C\\\\\n&=\\frac{4}{5}x^{5/4}+\\frac{2}{\\sqrt{x}}+C.\n\\end{aligned}\n$$\n\nSubtracting the negative second antiderivative produces a plus sign. The entry is $\\frac{4}{5}x^{5/4}+\\frac{2}{\\sqrt{x}}$, since $+C$ is supplied. Differentiating the full result gives $x^{1/4}-x^{-3/2}$, as required."}] [{:db/id #edb/ref 17592186694145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09bb690f-1bc6-56da-998d-14876c22b094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3\\sqrt{x^3}}+2x+C" :db/id #edb/ref 17592186694131} {:answer/id #uuid "6d8c950a-feac-5d50-af40-3bb448db831f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{x}}+2x+C" :db/id #edb/ref 17592186694133} {:answer/id #uuid "6fc293a6-4085-5bd0-a702-6e387150b34f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{x}}+2+C" :db/id #edb/ref 17592186694134} {:answer/id #uuid "a9e96d16-fc35-540f-88b3-73ed1f894878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{x}}+2x+C" :db/id #edb/ref 17592186694138} {:answer/id #uuid "fe4d19c0-f745-5c20-8fe3-417b8920a743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+2x+C" :db/id #edb/ref 17592186694146}] :answer-field/correct {:answer/id #uuid "a9e96d16-fc35-540f-88b3-73ed1f894878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{x}}+2x+C" :db/id #edb/ref 17592186694138} :answer-field/id #uuid "de92b8bb-a7a6-5381-8a0b-7d9b3f1aa023" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694143}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f96bec31-411b-5532-ba27-087da6b26ad6" :question/problem "Find the general antiderivative for $x>0$:\n\n$$\n\\int \\left(\\frac{1}{\\sqrt{x^3}}+2\\right)\\,\\mathrm{d}x.\n$$\n\nHere $C$ is an arbitrary constant." :question/worked-solution "Rewrite the reciprocal radical as a power: $1/\\sqrt{x^3}=x^{-3/2}$ for $x>0$. Apply the sum rule, then the power rule to each term:\n\n$$\n\\begin{aligned}\n\\int \\left(\\frac{1}{\\sqrt{x^3}}+2\\right)\\,\\mathrm{d}x\n&=\\int x^{-3/2}\\,\\mathrm{d}x+\\int 2\\,\\mathrm{d}x\\\\\n&=\\frac{x^{-3/2+1}}{-3/2+1}+2x+C\\\\\n&=\\frac{x^{-1/2}}{-1/2}+2x+C\\\\\n&=-\\frac{2}{\\sqrt{x}}+2x+C.\n\\end{aligned}\n$$\n\nThe constants combine into $C$. As a check, the derivative of $-2x^{-1/2}+2x+C$ is $x^{-3/2}+2$."}] [{:db/id #edb/ref 17592186694147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2269253c-c4be-52fb-9c49-d62462bc0df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{2}-6x^{3}+C" :db/id #edb/ref 17592186694148} {:answer/id #uuid "5c8aab8e-0c57-5f7c-bebf-f0fcafbb66ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}-2x^{3}+C" :db/id #edb/ref 17592186694151} {:answer/id #uuid "90e7c5f8-74aa-5d8d-8342-76861e331e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}+2x^{3}+C" :db/id #edb/ref 17592186694155} {:answer/id #uuid "b9e463cc-7889-5282-9b70-bfb0a0dea622" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}-3x^{2}+C" :db/id #edb/ref 17592186694160} {:answer/id #uuid "c2ef36f8-382a-589f-bb40-4e3b3f93d20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-12x+C" :db/id #edb/ref 17592186694161}] :answer-field/correct {:answer/id #uuid "5c8aab8e-0c57-5f7c-bebf-f0fcafbb66ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}-2x^{3}+C" :db/id #edb/ref 17592186694151} :answer-field/id #uuid "e0f1e8f5-dcc6-524e-86ca-5aa297c6928e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694162}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14b05cde-da41-586d-b963-194e2a35e587" :question/problem "Calculate\n$$\n\\int (4x-6x^{2})\\,\\mathrm{d}x.\n$$" :question/worked-solution "Use the sum and constant factor rules to integrate the terms separately:\n$$\n\\begin{aligned}\n\\int (4x-6x^{2})\\,\\mathrm{d}x\n&=4\\int x\\,\\mathrm{d}x-6\\int x^{2}\\,\\mathrm{d}x\\\\\n&=4\\left(\\frac{x^{2}}{2}\\right)-6\\left(\\frac{x^{3}}{3}\\right)+C\\\\\n&=2x^{2}-2x^{3}+C.\n\\end{aligned}\n$$\nThe arbitrary constants from the two terms combine into one constant $C$. Differentiating gives $4x-6x^{2}$, as required."}] [{:db/id #edb/ref 17592186694152 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dfe3577-4b49-583a-95a1-62d33af0d403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}x^{3/2}-\\frac{2}{5}x^{5/2}+C" :db/id #edb/ref 17592186694149} {:answer/id #uuid "528f7a74-160d-58fd-acd5-8ebde24da948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{3/2}+\\frac{5}{2}x^{5/2}+C" :db/id #edb/ref 17592186694150} {:answer/id #uuid "8b81d915-3b54-5d5d-a576-22b6929a1a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}x^{3/2}+\\frac{2}{5}x^{5/2}+C" :db/id #edb/ref 17592186694153} {:answer/id #uuid "aa13a18d-ed76-5b38-9fd9-8ec60867f063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}x^{3/2}+\\frac{2}{3}x^{3/2}+C" :db/id #edb/ref 17592186694156} {:answer/id #uuid "b0c0025b-211d-5e16-ad99-b399b7766bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}x^{3/2}+\\frac{2}{5}x^{5/2}+C" :db/id #edb/ref 17592186694157}] :answer-field/correct {:answer/id #uuid "b0c0025b-211d-5e16-ad99-b399b7766bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}x^{3/2}+\\frac{2}{5}x^{5/2}+C" :db/id #edb/ref 17592186694157} :answer-field/id #uuid "b7a21bf4-bcf9-5956-a457-93b129098c09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694159}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ef2af78-2ef2-5b47-90d3-dd050095177b" :question/problem "For $x>0$, calculate\n$$\n\\int \\sqrt{x}(4+x)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Rewrite the square root as a power and distribute before integrating:\n$$\n\\sqrt{x}(4+x)=x^{1/2}(4+x)=4x^{1/2}+x^{3/2}.\n$$\nThen use the sum, constant factor, and power rules:\n$$\n\\begin{aligned}\n\\int \\sqrt{x}(4+x)\\,\\mathrm{d}x\n&=4\\int x^{1/2}\\,\\mathrm{d}x+\\int x^{3/2}\\,\\mathrm{d}x\\\\\n&=4\\left(\\frac{x^{3/2}}{3/2}\\right)+\\frac{x^{5/2}}{5/2}+C\\\\\n&=\\frac{8}{3}x^{3/2}+\\frac{2}{5}x^{5/2}+C.\n\\end{aligned}\n$$\nDifferentiating this result gives $4x^{1/2}+x^{3/2}=\\sqrt{x}(4+x)$."}] [{:db/id #edb/ref 17592186694154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1c690e6-4d61-588d-85a7-9ef00fec0ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{7/2}-4x^{1/2}+C" :db/id #edb/ref 17592186694158}] :answer-field/correct {:answer/id #uuid "b1c690e6-4d61-588d-85a7-9ef00fec0ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{7/2}-4x^{1/2}+C" :db/id #edb/ref 17592186694158} :answer-field/id #uuid "fb1da7b4-385c-5a03-9a2f-1f1d0d186673" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694163}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8e7a2d0c-709b-5e9a-a61b-7866f0a31a3a" :question/problem "For $x>0$, find the general antiderivative. Include the arbitrary constant $C$.\n$$\n\\int \\frac{3x^{3}-2}{\\sqrt{x}}\\,\\mathrm{d}x=\n$$\n{{field-1}}" :question/worked-solution "Divide each numerator term by $x^{1/2}$:\n$$\n\\frac{3x^{3}-2}{\\sqrt{x}}=3x^{3-1/2}-2x^{-1/2}=3x^{5/2}-2x^{-1/2}.\n$$\nApply the sum and constant factor rules, then integrate each power:\n$$\n\\begin{aligned}\n\\int \\frac{3x^{3}-2}{\\sqrt{x}}\\,\\mathrm{d}x\n&=3\\int x^{5/2}\\,\\mathrm{d}x-2\\int x^{-1/2}\\,\\mathrm{d}x\\\\\n&=3\\left(\\frac{x^{7/2}}{7/2}\\right)-2\\left(\\frac{x^{1/2}}{1/2}\\right)+C\\\\\n&=\\frac{6}{7}x^{7/2}-4x^{1/2}+C.\n\\end{aligned}\n$$\nHere $-\\frac12+1=\\frac12$, so the second term remains negative. The result can also be written as $\\frac{6}{7}x^{3}\\sqrt{x}-4\\sqrt{x}+C$.\n\nChecking by differentiation gives $3x^{5/2}-2x^{-1/2}=\\frac{3x^{3}-2}{\\sqrt{x}}$."}] [{:db/id #edb/ref 17592186694428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14e32f7a-0707-5935-928f-9d1a7f79f1ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{3}}{3}+C" :db/id #edb/ref 17592186694433} {:answer/id #uuid "36a03bfb-ea0a-560d-8ca7-1fc4e6e4c02b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+3x^{3}+C" :db/id #edb/ref 17592186694441} {:answer/id #uuid "39e8f27e-c916-59c0-8e1d-f36e13c438cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+x^{3}+C" :db/id #edb/ref 17592186694443} {:answer/id #uuid "6660cbd7-f832-5817-95fd-fff943a4e387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+4x^{3}+C" :db/id #edb/ref 17592186694447} {:answer/id #uuid "f787bb26-b618-5445-a0cb-399811d6d36b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{3}}{9}+C" :db/id #edb/ref 17592186694462}] :answer-field/correct {:answer/id #uuid "14e32f7a-0707-5935-928f-9d1a7f79f1ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+\\frac{x^{3}}{3}+C" :db/id #edb/ref 17592186694433} :answer-field/id #uuid "b621e75e-6ea2-5a7a-a48d-e88a00b93a07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694454}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "00bbd537-3ea7-5f90-951d-baa42cd37974" :question/problem "Calculate $\\displaystyle\\int -6+x^{2}\\,\\mathrm{d}x$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -6+x^{2}\\,\\mathrm{d}x\\\\ &= \\int\\left(-6+x^{2}\\right)\\,\\mathrm{d}x\\\\ &= -6\\int x^{0}\\,\\mathrm{d}x+\\int x^{2}\\,\\mathrm{d}x\\\\ &= -6\\left(\\frac{x^{1}}{1}\\right)+\\left(\\frac{x^{3}}{3}\\right)+C\\\\ &= -6x+\\frac{x^{3}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db03a48-55fc-58d1-af1a-e44bd87e1412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y^{4}-2y+C" :db/id #edb/ref 17592186694431} {:answer/id #uuid "25d70e04-8209-5d27-98bd-0961650920c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{4}}{8}-2y+C" :db/id #edb/ref 17592186694435} {:answer/id #uuid "2bf514b6-3e9b-506a-9b06-675536a9db15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{4}}{4}-2y+C" :db/id #edb/ref 17592186694437} {:answer/id #uuid "32f9fd6c-77d1-5b02-8dba-c0c034caec86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{4}}{16}-2y+C" :db/id #edb/ref 17592186694440} {:answer/id #uuid "ebefd30b-3dd4-551f-b5c2-219dec662c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{4}}{6}-2y+C" :db/id #edb/ref 17592186694459}] :answer-field/correct {:answer/id #uuid "2bf514b6-3e9b-506a-9b06-675536a9db15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{4}}{4}-2y+C" :db/id #edb/ref 17592186694437} :answer-field/id #uuid "2d06da73-2fee-5591-bb32-726fe075866d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694438}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25dc299b-49b2-5007-901d-3558020af38f" :question/problem "Calculate $\\displaystyle\\int -y^{3}-2\\,\\mathrm{d}y$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -y^{3}-2\\,\\mathrm{d}y\\\\ &= \\int\\left(-y^{3}-2\\right)\\,\\mathrm{d}y\\\\ &= -\\int y^{3}\\,\\mathrm{d}y-2\\int y^{0}\\,\\mathrm{d}y\\\\ &= -\\left(\\frac{y^{4}}{4}\\right)-2\\left(\\frac{y^{1}}{1}\\right)+C\\\\ &= -\\frac{y^{4}}{4}-2y+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b846dcd-5aff-5270-85fe-b7599980e152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{5}+x+C" :db/id #edb/ref 17592186694430} {:answer/id #uuid "6ef8d6ab-2c52-5131-96b3-7bce5d49cde4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+x+C" :db/id #edb/ref 17592186694448} {:answer/id #uuid "a722b422-1d9a-50df-88ff-af1ecc4b3c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{5}+x+C" :db/id #edb/ref 17592186694452} {:answer/id #uuid "cb869eb0-b153-5083-85c6-fdd3b089db13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16x^{5}+x+C" :db/id #edb/ref 17592186694456} {:answer/id #uuid "db176115-752c-5fd6-92a2-e734c8c0399a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{7}+x+C" :db/id #edb/ref 17592186694458}] :answer-field/correct {:answer/id #uuid "6ef8d6ab-2c52-5131-96b3-7bce5d49cde4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+x+C" :db/id #edb/ref 17592186694448} :answer-field/id #uuid "01df14bb-7b39-53b1-a4a0-f1fc60455257" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :d