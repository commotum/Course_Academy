+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b21357-3794-5397-8ab2-215fd3080ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C" :db/id #edb/ref 17592186694584} {:answer/id #uuid "abb4713e-f711-5df2-9e16-3e1f41398918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+2t^{2}-\\frac{t^{3}}{9}+C" :db/id #edb/ref 17592186694598} {:answer/id #uuid "c4e738fd-1e63-5ba9-87d9-2d09a05ed9fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+2t^{2}-t^{3}+C" :db/id #edb/ref 17592186694600} {:answer/id #uuid "dcb53271-9cdf-5699-95b0-c8752933fd74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+t^{2}-\\frac{t^{3}}{2}+C" :db/id #edb/ref 17592186694603} {:answer/id #uuid "f453948d-5af0-55c6-8a0d-2d73ddebb938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+2t^{2}-\\frac{t^{3}}{2}+C" :db/id #edb/ref 17592186694605}] :answer-field/correct {:answer/id #uuid "38b21357-3794-5397-8ab2-215fd3080ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C" :db/id #edb/ref 17592186694584} :answer-field/id #uuid "f4875fd9-13c5-511c-8e3f-799dec40e586" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f0c2e42-cfda-5be2-86fd-64f843e311af" :question/problem "Calculate $\\displaystyle\\int 3+t-t^{2}\\,\\mathrm{d}t$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 3+t-t^{2}\\,\\mathrm{d}t\\\\ &= \\int\\left(3+t-t^{2}\\right)\\,\\mathrm{d}t\\\\ &= 3\\int t^{0}\\,\\mathrm{d}t+\\int t^{1}\\,\\mathrm{d}t-\\int t^{2}\\,\\mathrm{d}t\\\\ &= 3\\left(\\frac{t^{1}}{1}\\right)+\\left(\\frac{t^{2}}{2}\\right)-\\left(\\frac{t^{3}}{3}\\right)+C\\\\ &= 3t+\\frac{t^{2}}{2}-\\frac{t^{3}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5fd084-9d7f-5153-a98b-e2de0f6e7d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-x^{2}-6x^{3}+C" :db/id #edb/ref 17592186694586} {:answer/id #uuid "48d8fa01-9a5e-5ba9-9929-526e5b630cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-6x^{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694588} {:answer/id #uuid "66b45656-64af-5bbe-b667-56330afb0a67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{x^{3}}{2}+C" :db/id #edb/ref 17592186694592} {:answer/id #uuid "c6c5c04f-0ca4-513c-a6f0-d3e8fcd76cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-\\frac{x^{2}}{2}-6x^{3}+C" :db/id #edb/ref 17592186694601} {:answer/id #uuid "f780f595-be59-5d41-a075-8f59d1b3e36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694607}] :answer-field/correct {:answer/id #uuid "f780f595-be59-5d41-a075-8f59d1b3e36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C" :db/id #edb/ref 17592186694607} :answer-field/id #uuid "1c247750-8339-5171-a140-817d98ba604b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694581}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88b12f38-c5a8-542a-aaa9-ec2417d7827f" :question/problem "Calculate $\\displaystyle\\int -3-3x-2x^{2}\\,\\mathrm{d}x$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -3-3x-2x^{2}\\,\\mathrm{d}x\\\\ &= \\int\\left(-3-3x-2x^{2}\\right)\\,\\mathrm{d}x\\\\ &= -3\\int x^{0}\\,\\mathrm{d}x-3\\int x^{1}\\,\\mathrm{d}x-2\\int x^{2}\\,\\mathrm{d}x\\\\ &= -3\\left(\\frac{x^{1}}{1}\\right)-3\\left(\\frac{x^{2}}{2}\\right)-2\\left(\\frac{x^{3}}{3}\\right)+C\\\\ &= -3x-\\frac{3x^{2}}{2}-\\frac{2x^{3}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15265082-0fd8-5334-9ba9-a1364611e7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-2t^{3}+2t^{2}+C" :db/id #edb/ref 17592186694580} {:answer/id #uuid "220b34a1-e3e8-527e-bf2a-987e01ac8635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{2}+\\frac{2t^{2}}{3}+C" :db/id #edb/ref 17592186694582} {:answer/id #uuid "346a47bd-8486-542b-8adc-b4a3d97798e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-\\frac{2t^{3}}{3}+t^{2}+C" :db/id #edb/ref 17592186694583} {:answer/id #uuid "4a5a911b-d4b5-5bed-b43b-6c15cdee07fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{3}+2t^{2}+C" :db/id #edb/ref 17592186694589} {:answer/id #uuid "7690799c-1c5f-5dc4-80be-d8d7d3d85e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-\\frac{t^{3}}{2}+t^{2}+C" :db/id #edb/ref 17592186694593}] :answer-field/correct {:answer/id #uuid "346a47bd-8486-542b-8adc-b4a3d97798e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t-\\frac{2t^{3}}{3}+t^{2}+C" :db/id #edb/ref 17592186694583} :answer-field/id #uuid "5fc2619e-8f2c-5fdd-a356-538d29105291" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694591}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cdf2cb5b-3ce5-5240-9b96-6cc74e5dfa50" :question/problem "Calculate $\\displaystyle\\int -3-2t^{2}+2t\\,\\mathrm{d}t$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $\\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -3-2t^{2}+2t\\,\\mathrm{d}t\\\\ &= \\int\\left(-3-2t^{2}+2t\\right)\\,\\mathrm{d}t\\\\ &= -3\\int t^{0}\\,\\mathrm{d}t-2\\int t^{2}\\,\\mathrm{d}t+2\\int t^{1}\\,\\mathrm{d}t\\\\ &= -3\\left(\\frac{t^{1}}{1}\\right)-2\\left(\\frac{t^{3}}{3}\\right)+2\\left(\\frac{t^{2}}{2}\\right)+C\\\\ &= -3t-\\frac{2t^{3}}{3}+t^{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6fac8d8-1457-5460-82d7-6e8017862133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}x^{5/2}-\\frac{2}{3}x^{-3/2}+C" :db/id #edb/ref 17592186694715}] :answer-field/correct {:answer/id #uuid "e6fac8d8-1457-5460-82d7-6e8017862133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}x^{5/2}-\\frac{2}{3}x^{-3/2}+C" :db/id #edb/ref 17592186694715} :answer-field/id #uuid "0c1b637b-a3e9-5fde-a89e-08ab7ec78dda" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694702}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5e13c078-1c87-5b54-9d73-70457aed48de" :question/problem "Find the general antiderivative for $x>0$. Include the arbitrary constant $C$ in your answer.\n\n$$\n\\int \\left(\\sqrt{x^3}+\\frac{1}{\\sqrt{x^5}}\\right)\\,\\mathrm{d}x\n$$\n\n{{field-1}}" :question/worked-solution "Both terms need to be written as powers. Since $x>0$, we have $\\sqrt{x^3}=x^{3/2}$ and $1/\\sqrt{x^5}=x^{-5/2}$.\n\nApply the sum rule, then the power rule separately to each term:\n\n$$\n\\begin{aligned}\n\\int \\left(\\sqrt{x^3}+\\frac{1}{\\sqrt{x^5}}\\right)\\,\\mathrm{d}x\n&=\\int x^{3/2}\\,\\mathrm{d}x+\\int x^{-5/2}\\,\\mathrm{d}x \\\\\n&=\\frac{x^{3/2+1}}{3/2+1}+\\frac{x^{-5/2+1}}{-5/2+1}+C \\\\\n&=\\frac{x^{5/2}}{5/2}+\\frac{x^{-3/2}}{-3/2}+C \\\\\n&=\\frac{2}{5}x^{5/2}-\\frac{2}{3}x^{-3/2}+C.\n\\end{aligned}\n$$\n\nThe reciprocal term integrates to a negative term even though the integrand is a sum. An equivalent radical form is $\\frac{2\\sqrt{x^5}}{5}-\\frac{2}{3\\sqrt{x^3}}+C$.\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{2}{5}x^{5/2}-\\frac{2}{3}x^{-3/2}+C\\right)\n&=x^{3/2}+x^{-5/2} \\\\\n&=\\sqrt{x^3}+\\frac{1}{\\sqrt{x^5}}.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186694706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010cd992-4f3d-503f-94b7-929ab09069b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{4}{x^5}+C" :db/id #edb/ref 17592186694700} {:answer/id #uuid "6fa97ae8-de23-5085-8be6-3f146876bb6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{4x^4}+C" :db/id #edb/ref 17592186694709} {:answer/id #uuid "9360cda4-d615-5ef4-893b-c8f22102b60c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{3x^3}+C" :db/id #edb/ref 17592186694710} {:answer/id #uuid "c30a50cd-5a7c-507a-b9fd-28d9492b7ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{3x^3}+C" :db/id #edb/ref 17592186694713} {:answer/id #uuid "e7841ca1-18e8-5e43-98ca-38b23a06370e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-\\frac{1}{3x^3}+C" :db/id #edb/ref 17592186694716}] :answer-field/correct {:answer/id #uuid "c30a50cd-5a7c-507a-b9fd-28d9492b7ef7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{3x^3}+C" :db/id #edb/ref 17592186694713} :answer-field/id #uuid "b492fb15-1d22-5bd8-afb5-c34d42060301" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694711}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5eed3e6e-012c-5e3c-b385-d2ea0b8ae924" :question/problem "Find the general antiderivative for $x>0$.\n\n$$\n\\int \\left(3+\\frac{1}{x^4}\\right)\\,\\mathrm{d}x\n$$\n\nHere $C$ is an arbitrary constant." :question/worked-solution "Write the reciprocal as a negative power, $1/x^4=x^{-4}$, and apply the sum rule:\n\n$$\n\\begin{aligned}\n\\int \\left(3+\\frac{1}{x^4}\\right)\\,\\mathrm{d}x\n&=\\int 3\\,\\mathrm{d}x+\\int x^{-4}\\,\\mathrm{d}x \\\\\n&=3x+\\frac{x^{-4+1}}{-4+1}+C \\\\\n&=3x-\\frac{x^{-3}}{3}+C \\\\\n&=3x-\\frac{1}{3x^3}+C.\n\\end{aligned}\n$$\n\nIn particular, dividing by the new exponent $-3$ produces a negative term. Differentiating gives $3+x^{-4}$, as required."}] [{:db/id #edb/ref 17592186694714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cf433a-1bf8-5001-8ddd-7c805654f911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^4}{4}+1+C" :db/id #edb/ref 17592186694701} {:answer/id #uuid "51ab8a9b-bd74-5afe-9a64-7fd9b26caff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^4}{4}+x+C" :db/id #edb/ref 17592186694704} {:answer/id #uuid "668a586f-ba0c-5489-b95c-27b5d06d011a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^2+C" :db/id #edb/ref 17592186694707} {:answer/id #uuid "67b5767a-b725-5718-91a3-4a46a0f75a50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3}{3}+x+C" :db/id #edb/ref 17592186694708} {:answer/id #uuid "b82f5d54-f381-5959-9746-2208dcba7dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^4+x+C" :db/id #edb/ref 17592186694712}] :answer-field/correct {:answer/id #uuid "51ab8a9b-bd74-5afe-9a64-7fd9b26caff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^4}{4}+x+C" :db/id #edb/ref 17592186694704} :answer-field/id #uuid "2d6f8b4d-6e9b-5f61-9be3-b554d2c96420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186694703}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de653fc6-c3d8-52b1-a8be-21c967bd81ae" :question/problem "Find the general antiderivative.\n\n$$\n\\int (x^3+1)\\,\\mathrm{d}x\n$$\n\nThe sum rule gives\n\n$$\n\\int (x^3+1)\\,\\mathrm{d}x=\\int x^3\\,\\mathrm{d}x+\\int 1\\,\\mathrm{d}x.\n$$\n\nUse this split to choose the result. Here $C$ is an arbitrary constant." :question/worked-solution "Integrate each term using the power rule:\n\n$$\n\\begin{aligned}\n\\int (x^3+1)\\,\\mathrm{d}x\n&=\\int x^3\\,\\mathrm{d}x+\\int 1\\,\\mathrm{d}x \\\\\n&=\\frac{x^{3+1}}{3+1}+x+C \\\\\n&=\\frac{x^4}{4}+x+C.\n\\end{aligned}\n$$\n\nThe two integration constants combine into one arbitrary constant $C$. Differentiating the result gives $x^3+1$."}] [{:db/id #edb/ref 17592186694954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caa35af8-65d3-5ed4-9018-9e2be0c1925b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^{3}}{3}-3x" :db/id #edb/ref 17592186694962}] :answer-field/correct {:answer/id #uuid "caa35af8-65d3-5ed4-9018-9e2be0c1925b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x^{3}}{3}-3x" :db/id #edb/ref 17592186694962} :answer-field/id #uuid "748a44e1-ca8f-5963-b637-8f0777ba776c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694957}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "26eaa711-f78e-54b3-a595-b43a2a9c0ae1" :question/problem "Find the general antiderivative.\n\n$$\n\\int\\left(-x^{2}-3\\right)\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$\n\nThe arbitrary constant $+C$ is supplied outside the blank. Enter the two variable terms only." :question/worked-solution "Write radicals and reciprocals as powers when needed. Apply the sum rule and integrate each term with the power rule:\n\n$$\n\\begin{aligned}\\int\\left(-x^{2}-3\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-x^{2}-3\\right)\\,\\mathrm{d}x\\\\ &= -\\int x^{2}\\,\\mathrm{d}x-3\\int x^{0}\\,\\mathrm{d}x\\\\ &= -\\frac{x^{3}}{3}-3\\frac{x^{1}}{1}+C\\\\ &= -\\frac{x^{3}}{3}-3x+C\\\\ &= -\\frac{x^{3}}{3}-3x+C\\end{aligned}\n$$\n\nThe two integration constants combine into $C$, which is already supplied outside the blank."}] [{:db/id #edb/ref 17592186694959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad6e73b-da83-56ed-a13e-fee38d01a7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+4x" :db/id #edb/ref 17592186694958}] :answer-field/correct {:answer/id #uuid "8ad6e73b-da83-56ed-a13e-fee38d01a7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+4x" :db/id #edb/ref 17592186694958} :answer-field/id #uuid "b9834939-520b-5023-a857-970ed2c04429" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694961}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a52d8e00-df52-527b-b838-6c0c1e364655" :question/problem "Find the general antiderivative.\n\n$$\n\\int\\left(x^{3}+4\\right)\\,\\mathrm{d}x\n$$\n\n{{field-1}} $+C$\n\nThe arbitrary constant $+C$ is supplied outside the blank. Enter the two variable terms only." :question/worked-solution "Write radicals and reciprocals as powers when needed. Apply the sum rule and integrate each term with the power rule:\n\n$$\n\\begin{aligned}\\int\\left(x^{3}+4\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(x^{3}+4\\right)\\,\\mathrm{d}x\\\\ &= \\int x^{3}\\,\\mathrm{d}x+4\\int x^{0}\\,\\mathrm{d}x\\\\ &= \\frac{x^{4}}{4}+4\\frac{x^{1}}{1}+C\\\\ &= \\frac{x^{4}}{4}+4x+C\\\\ &= \\frac{x^{4}}{4}+4x+C\\end{aligned}\n$$\n\nThe two integration constants combine into $C$, which is already supplied outside the blank."}] [{:db/id #edb/ref 17592186694960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6461a0af-30da-5c11-b0c7-bf10e45718eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y^{6}}{6}-3y" :db/id #edb/ref 17592186694956}] :answer-field/correct {:answer/id #uuid "6461a0af-30da-5c11-b0c7-bf10e45718eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y^{6}}{6}-3y" :db/id #edb/ref 17592186694956} :answer-field/id #uuid "039a611b-5ae5-58fe-8b78-d447380aa11b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694953}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa9e5468-43e2-5683-81f6-940b435da6fe" :question/problem "Find the general antiderivative.\n\n$$\n\\int\\left(y^{5}-3\\right)\\,\\mathrm{d}y\n$$\n\n{{field-1}} $+C$\n\nThe arbitrary constant $+C$ is supplied outside the blank. Enter the two variable terms only." :question/worked-solution "Write radicals and reciprocals as powers when needed. Apply the sum rule and integrate each term with the power rule:\n\n$$\n\\begin{aligned}\\int\\left(y^{5}-3\\right)\\,\\mathrm{d}y\\\\ &= \\int\\left(y^{5}-3\\right)\\,\\mathrm{d}y\\\\ &= \\int y^{5}\\,\\mathrm{d}y-3\\int y^{0}\\,\\mathrm{d}y\\\\ &= \\frac{y^{6}}{6}-3\\frac{y^{1}}{1}+C\\\\ &= \\frac{y^{6}}{6}-3y+C\\\\ &= \\frac{y^{6}}{6}-3y+C\\end{aligned}\n$$\n\nThe two integration constants combine into $C$, which is already supplied outside the blank."}] [{:db/id #edb/ref 17592186694963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc3011a7-e7ed-5077-9ce1-91d23779afbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{5}}{5}-3y" :db/id #edb/ref 17592186694964}] :answer-field/correct {:answer/id #uuid "fc3011a7-e7ed-5077-9ce1-91d23779afbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y^{5}}{5}-3y" :db/id #edb/ref 17592186694964} :answer-field/id #uuid "5e95973f-41ce-56ba-b2ec-f0b2cacb0e67" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186694955}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f246fd77-0566-5ae7-939e-4b8263f5f558" :question/problem "Find the general antiderivative.\n\n$$\n\\int\\left(-y^{4}-3\\right)\\,\\mathrm{d}y\n$$\n\n{{field-1}} $+C$\n\nThe arbitrary constant $+C$ is supplied outside the blank. Enter the two variable terms only." :question/worked-solution "Write radicals and reciprocals as powers when needed. Apply the sum rule and integrate each term with the power rule:\n\n$$\n\\begin{aligned}\\int\\left(-y^{4}-3\\right)\\,\\mathrm{d}y\\\\ &= \\int\\left(-y^{4}-3\\right)\\,\\mathrm{d}y\\\\ &= -\\int y^{4}\\,\\mathrm{d}y-3\\int y^{0}\\,\\mathrm{d}y\\\\ &= -\\frac{y^{5}}{5}-3\\frac{y^{1}}{1}+C\\\\ &= -\\frac{y^{5}}{5}-3y+C\\\\ &= -\\frac{y^{5}}{5}-3y+C\\end{aligned}\n$$\n\nThe two integration constants combine into $C$, which is already supplied outside the blank."}] [{:db/id #edb/ref 17592186700422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295e216d-1767-5d93-bd49-000a8278b724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+C" :db/id #edb/ref 17592186700417}] :answer-field/correct {:answer/id #uuid "295e216d-1767-5d93-bd49-000a8278b724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+C" :db/id #edb/ref 17592186700417} :answer-field/id #uuid "3a09ff01-ec22-54ea-ac09-afb7ae64a096" :answer-field/key "antiderivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700420}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "43eaa0f0-dd22-52cc-86d8-711bdc4f8acc" :question/problem "Given $f(x)=1$ and $F'(x)=f(x)$, find the general expression for $F(x)$. Use $C$ for the arbitrary constant of integration.\n\n$F(x)=$ {{antiderivative}}" :question/worked-solution "We need a function whose derivative is $1$. Since integration reverses differentiation,\n\n$$\nF(x)=\\int 1\\,\\mathrm{d}x.\n$$\n\nThe constant integrand is the power $x^0$, so the power rule applies with $n=0$:\n\n$$\nF(x)=\\int x^0\\,\\mathrm{d}x=\\frac{x^{0+1}}{0+1}+C=x+C.\n$$\n\nCheck:\n\n$$\nF'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}(x+C)=1+0=1=f(x).\n$$\n\nEvery constant $C$ gives the same derivative, so $x$ alone is only one antiderivative; $x+C$ describes the general family."}] [{:db/id #edb/ref 17592186700427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b33f7f-0ed6-5010-a114-08b13a89a73e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^9}{9}+C" :db/id #edb/ref 17592186700416} {:answer/id #uuid "2b132236-db31-5a86-a1eb-52558ac5948e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{9}+C" :db/id #edb/ref 17592186700418} {:answer/id #uuid "5092b2af-d9c6-5eb2-8d0b-6cf1c04c348c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}+C" :db/id #edb/ref 17592186700423} {:answer/id #uuid "96f982ab-aaa2-5ffd-a137-04d46d1f4b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^8+C" :db/id #edb/ref 17592186700426} {:answer/id #uuid "d2953e38-8285-5d5c-8687-9709a1494c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}" :db/id #edb/ref 17592186700428}] :answer-field/correct {:answer/id #uuid "5092b2af-d9c6-5eb2-8d0b-6cf1c04c348c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{10}}{10}+C" :db/id #edb/ref 17592186700423} :answer-field/id #uuid "d3a6b5d3-e621-534e-b053-c0bc1433c040" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186700429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cb0a26ec-3743-56c1-a25f-60164f32d428" :question/problem "Calculate\n\n$$\n\\int x^9\\,\\mathrm{d}x.\n$$\n\nSelect the general antiderivative, including the arbitrary constant of integration." :question/worked-solution "The power rule for integration increases the exponent by one and divides by that new exponent. With $n=9$,\n\n$$\n\\int x^9\\,\\mathrm{d}x=\\frac{x^{9+1}}{9+1}+C=\\frac{x^{10}}{10}+C.\n$$\n\nHere $C$ is an arbitrary constant. Check by differentiating:\n\n$$\n\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{10}}{10}+C\\right)=\\frac{1}{10}\\cdot 10x^9+0=x^9.\n$$"}] [{:db/id #edb/ref 17592186700430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2baa8efb-cc02-563c-8076-3b7e3d71ea5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^5}{5}+C" :db/id #edb/ref 17592186700419}] :answer-field/correct {:answer/id #uuid "2baa8efb-cc02-563c-8076-3b7e3d71ea5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^5}{5}+C" :db/id #edb/ref 17592186700419} :answer-field/id #uuid "3c90252f-4f8b-588e-ba82-87453d439d52" :answer-field/key "antiderivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700421} {:answer-field/choices [{:answer/id #uuid "89c0b5be-d1a0-5f61-bf1f-567661a4f050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x^4}{4}" :db/id #edb/ref 17592186700425}] :answer-field/correct {:answer/id #uuid "89c0b5be-d1a0-5f61-bf1f-567661a4f050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x^4}{4}" :db/id #edb/ref 17592186700425} :answer-field/id #uuid "72538860-e2ca-57cf-b8f4-a18487993c28" :answer-field/key "derivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700424}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff219463-6af7-5653-a485-d339b1b9ac56" :question/problem "Given $f(x)=x^4$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^5}{4}+C,\n$$\n\nwhere $C$ is an arbitrary constant. Check the proposed expression by differentiating it, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. The derivative of the proposed expression is $G'(x)=$ {{derivative}}.\n2. The correct general expression is $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression first:\n\n$$\nG'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^5}{4}+C\\right)=\\frac{1}{4}\\cdot 5x^4+0=\\frac{5x^4}{4}.\n$$\n\nThis is not $f(x)=x^4$. The student increased the exponent to $5$ but divided by the old exponent $4$. To undo differentiation, divide by the new exponent:\n\n$$\nF(x)=\\int x^4\\,\\mathrm{d}x=\\frac{x^{4+1}}{4+1}+C=\\frac{x^5}{5}+C.\n$$\n\nVerify the correction:\n\n$$\nF'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^5}{5}+C\\right)=\\frac{1}{5}\\cdot 5x^4+0=x^4=f(x).\n$$\n\nThe arbitrary constant remains in the antiderivative and disappears in its derivative."}] [{:db/id #edb/ref 17592186700563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75603fb7-c5a9-51e8-b7f6-00eea29ebb1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{4}" :db/id #edb/ref 17592186700572}] :answer-field/correct {:answer/id #uuid "75603fb7-c5a9-51e8-b7f6-00eea29ebb1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 x^{2}}{4}" :db/id #edb/ref 17592186700572} :answer-field/id #uuid "09708e45-1f26-580d-b4b0-c98a97bb688c" :answer-field/key "derivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700561} {:answer-field/choices [{:answer/id #uuid "b0e442f2-a271-54e7-8f80-654deff22cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186700577}] :answer-field/correct {:answer/id #uuid "b0e442f2-a271-54e7-8f80-654deff22cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186700577} :answer-field/id #uuid "b10c2148-d0e7-5410-8595-bb2a18a12058" :answer-field/key "antiderivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700578}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1dab34fc-6107-55d3-b10d-c9eb120d2ee4" :question/problem "Given $f(x)=x^{3}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=\\frac{x^{3}}{4}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{3}}{4}+C\\right) \\\\ &=\\frac{1}{4}\\cdot 3x^{2}+0 \\\\ &=\\frac{3 x^{2}}{4}.\\end{aligned}\n$$\n\nThe proposed expression divides by the new exponent but leaves the exponent unchanged.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=3$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{3}\\,\\mathrm{d}x \\\\ &=\\frac{x^{3+1}}{3+1}+C \\\\ &=\\frac{x^{4}}{4}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{4}}{4}+C\\right)&=\\frac{1}{4}\\cdot 4x^{3}+0 \\\\ &=x^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186700567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c888bc-5826-5b51-b64b-1bcab5e3b891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186700564}] :answer-field/correct {:answer/id #uuid "32c888bc-5826-5b51-b64b-1bcab5e3b891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9}+C" :db/id #edb/ref 17592186700564} :answer-field/id #uuid "3821c9fd-f6ea-5058-a5bc-1eb90b6de307" :answer-field/key "antiderivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700565} {:answer-field/choices [{:answer/id #uuid "92eedf2b-e0ea-5fd8-b4ef-405047a3d6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 x^{8}" :db/id #edb/ref 17592186700575}] :answer-field/correct {:answer/id #uuid "92eedf2b-e0ea-5fd8-b4ef-405047a3d6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 x^{8}" :db/id #edb/ref 17592186700575} :answer-field/id #uuid "a3203eb7-d8d2-5995-8e9c-e8e9d807a371" :answer-field/key "derivative" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186700576}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "496f23dc-fc22-5733-9883-bf9ff6f1dd21" :question/problem "Given $f(x)=x^{8}$ and $F'(x)=f(x)$, a student proposes\n\n$$\nG(x)=x^{9}+C.\n$$\n\nDifferentiate the proposed expression, then give the correct general antiderivative of $f$. Use $C$ for the arbitrary constant.\n\n1. $G'(x)=$ {{derivative}}.\n2. $F(x)=$ {{antiderivative}}." :question/worked-solution "Differentiate the proposed expression:\n\n$$\n\\begin{aligned}G'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(x^{9}+C\\right) \\\\ &=1\\cdot 9x^{8}+0 \\\\ &=9 x^{8}.\\end{aligned}\n$$\n\nThe proposed expression omits division by the new exponent.\n\nIntegration reverses differentiation, so $F'(x)=f(x)$ gives $F(x)=\\int f(x)\\,\\mathrm{d}x$.\n\nApply the power rule with $n=8$ and include an arbitrary constant $C$:\n\n$$\n\\begin{aligned}F(x)&=\\int x^{8}\\,\\mathrm{d}x \\\\ &=\\frac{x^{8+1}}{8+1}+C \\\\ &=\\frac{x^{9}}{9}+C.\\end{aligned}\n$$\n\nCheck by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{x^{9}}{9}+C\\right)&=\\frac{1}{9}\\cdot 9x^{8}+0 \\\\ &=x^{8}.\\end{aligned}\n$$"}]}
