5e1d-93dc-4ec4f7f42e62" :question/problem "$$\n\\displaystyle \\int -6{sec}^{2}⁡z\\,\\text{d}z=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡z\\,\\text{d}z=tan⁡z+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -6{sec}^{2}⁡z\\,\\text{d}z & =-6\\int {sec}^{2}⁡z\\,\\text{d}z \\\\  & =-6(tan⁡z)+C \\\\  & =-6tan⁡z+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c2ce65-5dd3-54eb-b9f5-4314c702bb1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4tan⁡x+7csc⁡x+C" :db/id #edb/ref 17592186479282} {:answer/id #uuid "48106c87-9587-5f92-b34a-6e84abf0425f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4tan⁡x-7csc⁡x+C" :db/id #edb/ref 17592186479291} {:answer/id #uuid "d32d6061-ddb8-555a-857a-51f97a305e88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4cot⁡x+7sec⁡x+C" :db/id #edb/ref 17592186479305} {:answer/id #uuid "d6f1409e-faf6-5671-a59c-873872ecf37a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4cot⁡x-7sec⁡x+C" :db/id #edb/ref 17592186479309} {:answer/id #uuid "efb19c95-2013-57ff-8764-cba8d0c38900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4tan⁡x+7sec⁡x+C" :db/id #edb/ref 17592186479313}] :answer-field/correct {:answer/id #uuid "efb19c95-2013-57ff-8764-cba8d0c38900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4tan⁡x+7sec⁡x+C" :db/id #edb/ref 17592186479313} :answer-field/id #uuid "7a70370f-31b2-5dc8-ad4e-d2697a3b9c8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d57ebf80-c4f4-5872-a02e-c71994c830ec" :qu