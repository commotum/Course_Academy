field.type/blank} :db/id #edb/ref 17592186487198}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "28369a0e-aba7-51eb-8715-45d32f7550f3" :question/math-academy-id "q-218546" :question/problem "If ${x}^{2}-15=34,$ then $x=${{field-1}}." :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{x}^{2}-15 & =34 \\\\ {x}^{2} & =49\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{49} \\\\ |x| & =7 \\\\ x & =\\pm 7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8e2336-330f-5029-92a7-0d0ab28d6d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186486625} {:answer/id #uuid "17f14f97-f249-5dfb-9c13-79154bbd0395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{5\\sqrt{2}}" :db/id #edb/ref 17592186486642} {:answer/id #uuid "900fd687-4698-590d-a358-c19d9edd4bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{2\\sqrt{2}}{5}" :db/id #edb/ref 17592186486912} {:answer/id #uuid "a4fd7934-d968-5053-8705-3ee362f6cf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186486969} {:answer/id #uuid "c317104a-f0b3-5429-af3b-40954f5f5187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\sqrt{10}" :db/id #edb/ref 17592186487027}] :answer-field/correct {:answer/id #uuid "17f14f97-f249-5dfb-9c13-79154bbd0395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{5\\sqrt{2}}" :db/id #edb/ref 17592186486642} :answer-field/id #uuid "e8d4b2de-e41d-5da0-92bf-74693bde50d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487269}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "40c2d4a4-7047-536a-96ef-5761a02b86db" :question/math-academy-id "q-23833" :question/problem "Find $z$ if ${z}^{2}-\\frac{1}{50}=0.$" :question/worked-solution "First, we isolate the ${z}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{z}^{2}-\\frac{1}{50} & =0 \\\\ {z}^{2} & =\\frac{1}{50}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{z}^{2}} & =\\sqrt{\\frac{1}{50}} \\\\ |z| & =\\sqrt{\\frac{1}{50}} \\\\ |z| & =\\frac{\\sqrt{1}}{\\sqrt{50}} \\\\ |z| & =\\frac{1}{\\sqrt{25\\cdot 2}} \\\\ |z| & =\\frac{1}{5\\sqrt{2}} \\\\ z & =\\pm \\frac{1}{5\\sqrt{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299d1d2a-8f5f-5e7c-8e64-5d7529ce14db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{4}{3}" :db/id #edb/ref 17592186486674} {:answer/id #uuid "462526e8-fc43-5cc7-8eb3-ed00147c32a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{9}{4}" :db/id #edb/ref 17592186486744} {:answer/id #uuid "59d659c1-4443-5028-92b3-e12237de32cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{2}{3}" :db/id #edb/ref 17592186486792} {:answer/id #uuid "ce0e0dcf-f962-5de2-a67c-1c7391f31974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{2}" :db/id #edb/ref 17592186487047} {:answer/id #uuid "d464a780-0bbb-5e84-98b1-7a2792ada102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{4}" :db/id #edb/ref 17592186487057}] :answer-field/correct {:answer/id #uuid "d464a780-0bbb-5e84-98b1-7a2792ada102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "w=\\pm \\frac{3}{4}" :db/id #edb/ref 17592186487057} :answer-field/id #uuid "e030839c-1a8a-53e2-b8c7-88d824a286f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487263}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d4e69dd-adb5-5686-b554-16f7f78bb263" :question/math-academy-id "q-111426" :question/problem "Solve for $w$ where $16{w}^{2}=9.$" :question/worked-solution "First, we isolate the ${w}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}16{w}^{2} & =9 \\\\ {w}^{2} & =\\frac{9}{16}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{w}^{2}} & =\\sqrt{\\frac{9}{16}} \\\\ |w| & =\\frac{\\sqrt{9}}{\\sqrt{16}} \\\\ |w| & =\\frac{3}{4} \\\\ w & =\\pm \\frac{3}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee8d97a-e080-5fc9-a8de-e1cf3703cb2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=-16" :db/id #edb/ref 17592186486623} {:answer/id #uuid "0fc72536-786d-5f86-a53c-6cc754b68cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\pm 16" :db/id #edb/ref 17592186486627} {:answer/id #uuid "5d298338-d356-5fd9-9e5a-6cba9af110ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\pm 8" :db/id #edb/ref 17592186486801} {:answer/id #uuid "9db2f0aa-6943-5e9c-9921-cde4d5e98644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\pm 6" :db/id #edb/ref 17592186486948} {:answer/id #uuid "d16d5dc7-dc09-5902-91aa-d2762686d17c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\pm 36" :db/id #edb/ref 17592186487053}] :answer-field/correct {:answer/id #uuid "9db2f0aa-6943-5e9c-9921-cde4d5e98644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q=\\pm 6" :db/id #edb/ref 17592186486948} :answer-field/id #uuid "b72aded4-db5f-5673-ac54-684079de3588" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487244}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f380333b-76ae-58b4-8fc8-adf9bbb2d3ab" :question/math-academy-id "q-44121" :question/problem "Solve  $\\frac{{q}^{2}}{2}-18=0.$" :question/worked-solution "First, we isolate the ${q}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{q}^{2}}{2}-18 & =0 \\\\ \\frac{{q}^{2}}{2} & =18 \\\\ {q}^{2} & =2\\cdot 18 \\\\ {q}^{2} & =36\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{q}^{2}} & =\\sqrt{36} \\\\ |q| & =6 \\\\ q & =\\pm 6\\end{aligned}\n$$"}]}
