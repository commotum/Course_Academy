id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479284}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e51262c4-111b-5af6-9c4b-384b623d1a51" :question/problem "Calculate $$\n\\displaystyle \\int sec⁡x(3sec⁡x+8tan⁡x)\\text{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sec⁡xtan⁡x\\,\\text{d}x & =sec⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int sec⁡x(3sec⁡x+8tan⁡x)\\text{d}x & =\\int (3{sec}^{2}⁡x+8sec⁡xtan⁡x)\\text{d}x \\\\  & =\\int 3{sec}^{2}⁡x\\,\\text{d}x+\\int 8sec⁡xtan⁡x\\,\\text{d}x \\\\  & =3\\int {sec}^{2}⁡x\\,\\text{d}x+8\\int sec⁡xtan⁡x\\,\\text{d}x \\\\  & =3tan⁡x+8sec⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f50ded-9f12-51bb-a822-c1a4dc23c1e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486566} {:answer/id #uuid "4f83cade-9ff1-5412-b97f-b97f2cbbe392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486568} {:answer/id #uuid "93666e6d-1a12-5926-957a-515012ac4cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- {e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486572} {:answer/id #uuid "981141c0-7599-5cce-ae10-1464ee76b15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486573} {:answer/id #uuid "9dc23cf1-613d-5795-85b2-7758594c68cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 6 {e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486574}] :answer-field/correct {:answer/id #uuid "30f50ded-9f12-51bb-a822-c1a4dc23c1e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486566} :answer-field/id #uuid "f96eaad2-708f-55c4-b8bd-ca9fe0fd745b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486583}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0cdba6d7-7a6b-54f6-b7d5-39604050f081" :question/problem "What is $$\n\\displaystyle \\int 17 {e}^{- 6 x - 2}\\,\\text{d}x\n$$?" :question/worked-solution "If we let $u=- 6 x - 2,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6\\quad\\Longrightarrow\\quad\\text{d}x=- \\frac{1}{6}\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 17 {e}^{- 6 x - 2}\\,\\text{d}x&=\\int 17{e}^{u}\\cdot - \\frac{1}{6}\\,\\text{d}u \\\\ &=- \\frac{17}{6}\\int {e}^{u}\\,\\text{d}u \\\\ &=- \\frac{17}{6}{e}^{u}+C \\\\ &=- \\frac{17 {e}^{- 6 x - 2}}{6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0509bb76-47cb-5776-89ad-4918b5670f82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{17 x}}{8} + C" :db/id #edb/ref 17592186486564} {:answer/id #uuid "39d20901-8395-52c2-a3d2-b837a59f265d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 {e}^{8 x + 3} + C" :db/id #edb/ref 17592186486567} {:answer/id #uuid "c3e3d634-fb28-5096-89e6-31636d00431a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17 {e}^{8 x + 3} + C" :db/id #edb/ref 17592186486576} {:answer/id #uuid "d6d56921-07c2-5ed7-a309-ae0f21f511c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 {e}^{8 x + 3}}{17} + C" :db/id #edb/ref 17592186486578} {:answer/id #uuid "fa4e0ccf-a5a0-5d88-a3a5-0b612d29b4b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{8 x + 3}}{8} + C" :db/id #edb/ref 17592186486584}] :answer-field/correct {:answer/id #uuid "fa4e0ccf-a5a0-5d88-a3a5-0b612d29b4b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{8 x + 3}}{8} + C" :db/id #edb/ref 17592186486584} :answer-field/id #uuid "c8e1a941-1a09-527e-9beb-23a4b61432d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486577}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "daf12fe8-bb11-5fd8-a3b3-59d7ece27403" :question/problem "$$\n\\displaystyle \\int 17 {e}^{8 x + 3}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=8 x + 3,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8\\quad\\Longrightarrow\\quad\\text{d}x=\\frac{1}{8}\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 17 {e}^{8 x + 3}\\,\\text{d}x&=\\int 17{e}^{u}\\cdot \\frac{1}{8}\\,\\text{d}u \\\\ &=\\frac{17}{8}\\int {e}^{u}\\,\\text{d}u \\\\ &=\\frac{17}{8}{e}^{u}+C \\\\ &=\\frac{17 {e}^{8 x + 3}}{8}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186486582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "523fb413-bcaa-5750-8a89-02163f3e910f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486569} {:answer/id #uuid "6384ef1d-eb0c-5b89-81a8-9b3c4b5b9b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486570} {:answer/id #uuid "a5670e65-dba0-567d-a8e1-807da90c42f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 {e}^{x - 4} + C" :db/id #edb/ref 17592186486575} {:answer/id #uuid "dffc41ff-8df9-5896-af63-b72614c86a56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{\\frac{x}{7} - 4}}{7} + C" :db/id #edb/ref 17592186486580} {:answer/id #uuid "e368b95a-6074-5507-b918-fe622d329a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486581}] :answer-field/correct {:answer/id #uuid "e368b95a-6074-5507-b918-fe622d329a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486581} :answer-field/id #uuid "7c47b8e2-1d72-58cc-a7ba-c337501e85c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486571}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f11bb3fa-ce88-546d-aefd-7cd344d3c36f" :question/problem "Calculate $$\n\\displaystyle \\int {e}^{\\frac{x}{7} - 4}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=\\frac{x}{7} - 4,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\quad\\Longrightarrow\\quad\\text{d}x=7\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{\\frac{x}{7} - 4}\\,\\text{d}x&=\\int 1{e}^{u}\\cdot 7\\,\\text{d}u \\\\ &=7\\int {e}^{u}\\,\\text{d}u \\\\ &=7{e}^{u}+C \\\\ &=7 {e}^{\\frac{x}{7} - 4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baedb9f1-4e6f-57a3-bfc8-77c1252fcfd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm\\sqrt{5}" :db/id #edb/ref 17592186487004}] :answer-field/correct {:answer/id #uuid "baedb9f1-4e6f-57a3-bfc8-77c1252fcfd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm\\sqrt{5}" :db/id #edb/ref 17592186487004} :answer-field/id #uuid "ac7c4d3b-5e80-5eb1-9dea-f2ec50088d31" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "01fa67fa-62b9-56b9-929f-65394494b5c0" :question/math-academy-id "q-218607" :question/problem "Solve the equation $\\frac{{a}^{2}-5}{3}=0.$ Express your final answer in its simplest form.\n\n$a=$\n\n{{field-1}}" :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{a}^{2}-5}{3} & =0 \\\\ {a}^{2}-5 & =0 \\\\ {a}^{2} & =5\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{5} \\\\ |a| & =\\sqrt{5} \\\\ a & =\\pm \\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b61df4-5646-56cb-91f4-0bb6021487d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{10}}" :db/id #edb/ref 17592186486671} {:answer/id #uuid "3e71ec7c-99e9-5c6e-be27-a59349af1bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186486729} {:answer/id #uuid "7f48a130-1976-51dc-83b9-6407c4ce4f76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{5\\sqrt{2}}" :db/id #edb/ref 17592186486870} {:answer/id #uuid "bc481e31-40b3-5964-9311-39c484a7cb89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186487007} {:answer/id #uuid "dce8fb30-54cb-57bb-8c12-8f73bf118dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{2\\sqrt{5}}" :db/id #edb/ref 17592186487074}] :answer-field/correct {:answer/id #uuid "3e71ec7c-99e9-5c6e-be27-a59349af1bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186486729} :answer-field/id #uuid "1f6f3673-5cd0-5215-bb2d-129ad6dfc34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487147}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16965fbd-f380-5aaa-bd39-b9dfc41f6cc7" :question/math-academy-id "q-218731" :question/problem "Find $u$ if  ${u}^{2}+\\frac{2}{5}=\\frac{1}{2}.$" :question/worked-solution "First, we isolate the ${u}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{u}^{2}+\\frac{2}{5} & =\\frac{1}{2} \\\\ {u}^{2} & =\\frac{1}{2}-\\frac{2}{5} \\\\ {u}^{2} & =\\frac{5}{10}-\\frac{4}{10} \\\\ {u}^{2} & =\\frac{1}{10}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{u}^{2}} & =\\sqrt{\\frac{1}{10}} \\\\ |u| & =\\sqrt{\\frac{1}{10}} \\\\ |u| & =\\frac{\\sqrt{1}}{\\sqrt{10}} \\\\ |u| & =\\frac{1}{\\sqrt{10}} \\\\ u & =\\pm \\frac{1}{\\sqrt{10}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad80d12-5111-51a7-a662-e65fdce90ed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm 4\\sqrt{3}" :db/id #edb/ref 17592186486757} {:answer/id #uuid "8478bc0e-b938-55fe-a79a-b0a74b62e12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\frac{4\\sqrt{3}}{3}" :db/id #edb/ref 17592186486880} {:answer/id #uuid "8bf27318-4316-5483-ad50-934fea49818a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\pm \\frac{4}{3}" :db/id #edb/ref 17592186486897}