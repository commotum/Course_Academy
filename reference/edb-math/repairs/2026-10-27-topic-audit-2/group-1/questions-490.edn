#{[{:db/id #edb/ref 17592186487406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0435fbbd-ecc6-5db3-9a1d-71544f3d68dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=-\\sqrt{19}" :db/id #edb/ref 17592186486602} {:answer/id #uuid "3dc60bf6-d7b2-51e0-b2ad-ac8898cae6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=1,\\pm \\sqrt{19}" :db/id #edb/ref 17592186486725} {:answer/id #uuid "8f209d46-54a1-5839-aa07-ad8dc82a1d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\pm \\sqrt{19}" :db/id #edb/ref 17592186486910} {:answer/id #uuid "b52f0129-8390-5ff3-a94b-7f331a2c4995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\sqrt{19}" :db/id #edb/ref 17592186486994} {:answer/id #uuid "db0d4977-97df-54ed-8727-33f34c8d51ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=0,\\sqrt{19}" :db/id #edb/ref 17592186487071}] :answer-field/correct {:answer/id #uuid "8f209d46-54a1-5839-aa07-ad8dc82a1d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b=\\pm \\sqrt{19}" :db/id #edb/ref 17592186486910} :answer-field/id #uuid "ff9f8fb8-769c-562d-9a4f-1ba530c47436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487285}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe6cba18-c737-5fde-a708-668f780bcd21" :question/math-academy-id "q-12797" :question/problem "Find $b$ if ${b}^{2}-15=4.$" :question/worked-solution "First, we isolate the ${b}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}{b}^{2}-15 & =4 \\\\ {b}^{2} & =19\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{b}^{2}} & =\\sqrt{19} \\\\ |b| & =\\sqrt{19} \\\\ b & =\\pm \\sqrt{19}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465}] :answer-field/correct {:answer/id #uuid "7b1bc9b8-0ea0-52cc-a644-25016e73c24b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{5}" :db/id #edb/ref 17592186492465} :answer-field/id #uuid "fb6954e1-945b-51aa-b2d8-20a643556b8d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90d6c1a2-df8a-556c-89a1-d672dd78eab8" :question/math-academy-id "q-218588" :question/problem "Solve the equation ${v}^{2}=45.$ Express your final answer in its simplest form.\n\n$v=$\n\n{{field-1}}" :question/worked-solution "We take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{v}^{2}} & =\\sqrt{45} \\\\ |v| & =\\sqrt{9\\cdot 5} \\\\ |v| & =\\sqrt{9}\\cdot \\sqrt{5} \\\\ |v| & =3\\sqrt{5} \\\\ v & =\\pm 3\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6f09a0-ccd7-5f3c-b936-37c4d8190186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{7}" :db/id #edb/ref 17592186492363} {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} {:answer/id #uuid "8bbf1f51-b87d-56f3-a2e4-c8c1a5907fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{7}{3}" :db/id #edb/ref 17592186492494} {:answer/id #uuid "aabe0e05-f4e4-5dba-8d77-0379c8bb7619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{49}" :db/id #edb/ref 17592186492562} {:answer/id #uuid "d05fdd44-d514-56b7-a034-70edb6be2559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{9}{7}" :db/id #edb/ref 17592186492631}] :answer-field/correct {:answer/id #uuid "72c93668-102e-59cf-bbee-5a2ec27c8f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{7}" :db/id #edb/ref 17592186492444} :answer-field/id #uuid "52cb84e8-9f4d-596d-8658-8754ec0aa693" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492737}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c009e53d-f124-53fe-9bd5-4569b0faacf3" :question/math-academy-id "q-78906" :question/problem "Solve for $x$ where $\\frac{{x}^{2}}{2}=\\frac{9}{98}.$" :question/worked-solution "First, we isolate the ${x}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2} & =\\frac{9}{98} \\\\ {x}^{2} & =\\frac{9\\cdot 2}{98} \\\\ {x}^{2} & =\\frac{9}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & =\\sqrt{\\frac{9}{49}} \\\\ |x| & =\\frac{\\sqrt{9}}{\\sqrt{49}} \\\\ |x| & =\\frac{3}{7} \\\\ x & =\\pm \\frac{3}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451}] :answer-field/correct {:answer/id #uuid "7524c348-11f2-59fe-89ce-2554d91064a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{5}{7}" :db/id #edb/ref 17592186492451} :answer-field/id #uuid "246155e5-4b6f-5296-89cb-0ce66033efc4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492717}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dc9b5d6a-36da-5369-a8e0-149a58110d0a" :question/math-academy-id "q-218577" :question/problem "If $49{a}^{2}+12=37,$ then $a=${{field-1}}." :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}49{a}^{2}+12 & =37 \\\\ 49{a}^{2} & =25 \\\\ {a}^{2} & =\\frac{25}{49}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{25}{49}} \\\\ |a| & =\\frac{\\sqrt{25}}{\\sqrt{49}} \\\\ |a| & =\\frac{5}{7} \\\\ a & =\\pm \\frac{5}{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ca6815-86fe-5f83-92e3-96c606c3263e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{\\frac{x}{5}}}{\\ln{\\left(5 \\right)}}+C" :db/id #edb/ref 17592186493007} {:answer/id #uuid "6e14030d-94e3-5db6-a373-8aeb4879a2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{\\frac{x}{5}}}{5 \\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493013} {:answer/id #uuid "73e0c2e2-7fd4-564c-8dd3-10b1aa2a7896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 \\cdot 6^{x}}{\\ln{\\left(5 \\right)}}+C" :db/id #edb/ref 17592186493014} {:answer/id #uuid "b274efb9-234d-5a10-a8b5-3cd22fdb67d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{x}}{5 \\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493017} {:answer/id #uuid "d8f318d0-f1ac-5767-b6d6-5968ca82870b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 \\cdot 6^{\\frac{x}{5}}}{\\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493019}] :answer-field/correct {:answer/id #uuid "d8f318d0-f1ac-5767-b6d6-5968ca82870b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5 \\cdot 6^{\\frac{x}{5}}}{\\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493019} :answer-field/id #uuid "109716d1-dff5-5cb4-b22b-82cd881dc9e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493008}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98a4bd56-0285-5f4b-b31e-2a51803f2189" :question/problem "$$\n\\displaystyle \\int 6^{\\frac{x}{5}}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=\\frac{x}{5},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\quad\\Longrightarrow\\quad 5\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 6^{\\frac{x}{5}}\\,\\text{d}x&=\\int 6^{u}\\cdot 5\\,\\text{d}u \\\\ &=5\\int 6^{u}\\,\\text{d}u \\\\ &=5\\frac{6^{u}}{\\ln 6}+C \\\\ &=\\frac{5 \\cdot 6^{\\frac{x}{5}}}{\\ln{\\left(6 \\right)}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197a6e1c-ac21-5ce4-99cd-b8ab6c5541e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{4 x - 5}}{4 \\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493009} {:answer/id #uuid "2ef814e7-9aa7-51a1-ae5f-0cb54dc801b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{2 x - 5}}{\\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493010} {:answer/id #uuid "4d43fdae-0415-589c-a452-b9e2e785202c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{4 x - 5}}{4}+C" :db/id #edb/ref 17592186493012} {:answer/id #uuid "98c228a9-986e-55be-8e4d-9ebb09a415b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{2 x - 5}}{4}+C" :db/id #edb/ref 17592186493016} {:answer/id #uuid "df0ab8b2-51a9-59dc-bd23-253d0062c1bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{4 x - 5}}{\\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493020}] :answer-field/correct {:answer/id #uuid "197a6e1c-ac21-5ce4-99cd-b8ab6c5541e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6^{4 x - 5}}{4 \\ln{\\left(6 \\right)}}+C" :db/id #edb/ref 17592186493009} :answer-field/id #uuid "3673e5d8-318d-5d29-ac81-edbe9ff6ffb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493011}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b59c6ae3-b0c9-51c8-9fe5-f6714e9067eb" :question/problem "What is $$\n\\displaystyle \\int 6^{4 x - 5}\\,\\text{d}x\n$$?" :question/worked-solution "If we let $u=4 x - 5,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\quad\\Longrightarrow\\quad \\frac{1}{4}\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 6^{4 x - 5}\\,\\text{d}x&=\\int 6^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\ &=\\frac{1}{4}\\int 6^{u}\\,\\text{d}u \\\\ &=\\frac{1}{4}\\frac{6^{u}}{\\ln 6}+C \\\\ &=\\frac{6^{4 x - 5}}{4 \\ln{\\left(6 \\right)}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60afaad7-5c74-5ffe-abde-22de9074b994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "189.2\\,\\text{lb}" :db/id #edb/ref 17592186501645} {:answer/id #uuid "727ecad7-0669-59e4-acfa-630e5b405f52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "190.1\\,\\text{lb}" :db/id #edb/ref 17592186501675} {:answer/id #uuid "87cd631b-b970-5565-be2b-b669ed3ae06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "189.7\\,\\text{lb}" :db/id #edb/ref 17592186501727} {:answer/id #uuid "cc782d2e-ff11-5ac5-a0c7-6ccf48af546c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "190.5\\,\\text{lb}" :db/id #edb/ref 17592186501874} {:answer/id #uuid "e50bcdd8-481a-5a75-a0f4-6d4a10f0bb53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "190.9\\,\\text{lb}" :db/id #edb/ref 17592186501928}] :answer-field/correct {:answer/id #uuid "727ecad7-0669-59e4-acfa-630e5b405f52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "190.1\\,\\text{lb}" :db/id #edb/ref 17592186501675} :answer-field/id #uuid "2eaf0f19-6003-5585-a879-f271b5fc12a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0b0e00ac-15e0-50ff-896e-2fb3f25eb38a" :question/math-academy-id "q-336519" :question/problem "An ink reservoir for an industrial printer can hold up to $150\\,\\text{gal}$ of liquid. Initially, it contains $60\\,\\text{gal}$ of ink solution with $18\\,\\text{lb}$ of dissolved ink dye. A more concentrated ink solution with concentration $\\frac{4}{3}\\,\\text{lb/gal}$ flows into the reservoir at a rate of $9\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $6\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of ink dye in the reservoir at the moment it begins to overflow." :question/worked-solution "Since $Q$ is the amount of ink dye in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which ink dye enters the reservoir minus the rate at which ink dye leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which ink dye enters the reservoir.\n\nFirst, note that a solution containing $\\frac{4}{3}\\,\\text{lb/gal}$ of ink dye enters the reservoir at a rate of $9\\,\\text{gal/min}.$ So, the rate at which the *ink dye* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(\\frac{4}{3}\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (9\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(\\frac{4}{3}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (9\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =12\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which ink dye exits the reservoir.\n\nTo find the rate at which ink dye leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $60\\,\\text{gal}$ of solution; solution enters at $9\\,\\text{gal/min}$ and mixed solution leaves at $6\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=60+9t-6t=3(20+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of ink dye in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{3(20+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $6\\,\\text{gal/min},$ *ink dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(6\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{3(20+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(6\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{3(20+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{6Q}{3(20+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{20+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =12-\\frac{2Q}{20+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{20+t}\\,Q=12.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(20+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|20+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(20+t)^{2}} \\\\  & =(20+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(20+t)^{2}$ yields\n\n$$\n\\begin{aligned}(20+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{20+t}\\,Q) & =(20+t)^{2}\\cdot 12 \\\\ (20+t)^{2}\\frac{dQ}{dt}+2(20+t)Q & =12(20+t)^{2} \\\\ \\frac{d}{dt}(Q(20+t)^{2}) & =12(20+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(20+t)^{2})\\,dt & =\\int 12(20+t)^{2}\\,dt \\\\ Q(20+t)^{2} & =12\\cdot \\frac{1}{3}(20+t)^{3}+C \\\\ Q(t) & =4(20+t)+\\frac{C}{(20+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $18\\,\\text{lb}$ of ink dye. So, we can apply the initial condition $Q(0)=18,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ 4(20+0)+\\frac{C}{(20+0)^{2}} & =18 \\\\ 80+\\frac{C}{(20)^{2}} & =18 \\\\ \\frac{C}{{20}^{2}} & =-62 \\\\ C & =-62(20)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =4(20+t)-\\frac{62(20)^{2}}{(20+t)^{2}} \\\\  & =4(20+t)-62{\\left(\\frac{20}{20+t}\\right)}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $150\\,\\text{gal},$ so we can use the condition $V({t}_{o})=150$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =150 \\\\ 60+9{t}_{o}-6{t}_{o} & =150 \\\\ 60+3{t}_{o} & =150 \\\\ 3{t}_{o} & =90 \\\\ {t}_{o} & =30\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of ink dye in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(30) & =4(20+30)-62{\\left(\\frac{20}{20+30}\\right)}^{2} \\\\  & =200-62{\\left(\\frac{20}{50}\\right)}^{2} \\\\  & ≈190.1\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa46099-da71-5b6e-bf88-ae9c1cd9cdcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186501493} {:answer/id #uuid "3a8aabfa-3b2a-546d-a525-0b6c5247d515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186501570} {:answer/id #uuid "3c64925c-c3fb-50bc-a4cf-26896798c5a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186501573} {:answer/id #uuid "79afc2f1-79a1-5645-98b6-d23030be32d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186501693} {:answer/id #uuid "e5345499-fd39-5582-a566-851fc68ed4e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186501930}] :answer-field/correct {:answer/id #uuid "e5345499-fd39-5582-a566-851fc68ed4e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186501930} :answer-field/id #uuid "1f525641-4d00-5cf1-b519-6a6c8d3e8e86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501985}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11c8e0ff-5f12-56c5-bbf7-d578f71b8d7f" :question/math-academy-id "q-336746" :question/problem "A rinse tank initially holds $240\\,\\text{L}$ of water containing $9\\,\\text{kg}$ of dissolved dye.\nA solution containing $0.025\\,\\text{kg/L}$ of dissolved dye is pumped into the tank at a rate of $16\\,\\text{L/min},$ while the completely mixed water is drained out at a rate of $24\\,\\text{L/min}.$ If the amount of dye $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins is given by\n\n$$\nQ(t)=\\alpha \\,(1-\\frac{t}{30})+\\beta {(1-\\frac{t}{30})}^{3}\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants, what is the value of $\\alpha -\\beta ?$" :question/worked-solution "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that a water solution containing $0.025\\,\\text{kg/L}$ of dye enters the tank at a rate of $16\\,\\text{L/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.025\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (16\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.025\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (16\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.4\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nTo find the rate at which dye leaves the tank, we must first determine the volume of water in the tank at time $t.$\n\nThe tank initially contains $240\\,\\text{L}$ of water; a solution enters at $16\\,\\text{L/min}$ and leaves at $24\\,\\text{L/min}.$\nAs a result, the amount of water in the tank after $t$ minutes is \n\n$$\n240+16t-24t=(240-8t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of dye in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{240-8t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed water leaves at a rate of $24\\,\\text{L/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(24\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{240-8t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(24\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{240-8t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{24Q}{240-8t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{3Q}{30-t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.4-\\frac{3Q}{30-t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{3}{30-t}Q=0.4.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 3/(30-t)\\,dt} \\\\  & ={e}^{-3\\operatorname{ln}⁡|30-t|} \\\\  & ={e}^{\\operatorname{ln}⁡(30-t)^{-3}} \\\\  & =(30-t)^{-3}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(30-t)^{-3}$ yields\n\n$$\n\\begin{aligned}(30-t)^{-3}\\cdot (\\frac{dQ}{dt}+\\frac{3}{30-t}Q) & =(30-t)^{-3}\\cdot 0.4 \\\\ (30-t)^{-3}\\frac{dQ}{dt}+3(30-t)^{-4}Q & =0.4(30-t)^{-3} \\\\ \\frac{d}{dt}(Q(30-t)^{-3}) & =0.4(30-t)^{-3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(30-t)^{-3})\\,dt & =\\int 0.4(30-t)^{-3}\\,dt \\\\ Q(30-t)^{-3} & =0.4\\cdot \\frac{1}{2}(30-t)^{-2}+C \\\\ Q(t) & =0.2(30-t)+C(30-t)^{3}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $9\\,\\text{kg}$ of dye. So, we can apply the initial condition $Q(0)=9,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =9 \\\\ C(30-0)^{3}+0.2(30-0) & =9 \\\\ C(30)^{3}+6 & =9 \\\\ C & =\\frac{3}{{30}^{3}}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.2(30-t)+\\frac{3}{{30}^{3}}(30-t)^{3} \\\\  & =0.2\\cdot 30\\,\\left(\\frac{30-t}{30}\\right)+3{\\left(\\frac{30-t}{30}\\right)}^{3} \\\\  & =6\\,(1-\\frac{t}{30})+3{(1-\\frac{t}{30})}^{3}.\\end{aligned}\n$$\n\nFinally, we have $\\alpha =6,\\beta =3,$ and\n\n$$\n\\alpha -\\beta =6-3=3.\n$$"}] [{:db/id #edb/ref 17592186502082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012bbc31-fce8-5143-bbdb-f134d11c9b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=25-15{e}^{-t/40}" :db/id #edb/ref 17592186501467} {:answer/id #uuid "31248321-fb90-5cb0-aa5a-920f043c50d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=-20+30{e}^{t/40}" :db/id #edb/ref 17592186501553} {:answer/id #uuid "3ed776e2-31c7-5d6e-9bbc-6f6a10752d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=30-20{e}^{-t/40}" :db/id #edb/ref 17592186501578} {:answer/id #uuid "6a8cf9da-4b94-562b-ad43-2abfa2d2e1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=-2+12{e}^{-t/40}" :db/id #edb/ref 17592186501663} {:answer/id #uuid "a2495ea6-828d-5486-8e26-3bd05d9010fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=24-14{e}^{-t/40}" :db/id #edb/ref 17592186501777}] :answer-field/correct {:answer/id #uuid "a2495ea6-828d-5486-8e26-3bd05d9010fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=24-14{e}^{-t/40}" :db/id #edb/ref 17592186501777} :answer-field/id #uuid "cda88114-20cf-5991-bcbf-f77da4f62dbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502048}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23f15773-7029-5dc4-9ea6-d17c6a8daaa9" :question/math-academy-id "q-336752" :question/problem "A mixing tank initially holds $600\\,\\text{L}$ of liquid containing $10\\,\\text{kg}$ of dissolved cleanser.\nA solution containing $0.04\\,\\text{kg/L}$ of dissolved cleanser is pumped into the tank at a rate of $15\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $15\\,\\text{L/min}.$ Which expression gives the amount of cleanser $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins?" :question/worked-solution "Let $Q$ be the amount of cleanser in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which cleanser enters the tank minus the rate at which cleanser leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which additives enter the tank.\n\nNote that a feed solution containing $0.04\\,\\text{kg/L}$ of the cleanser enters the tank at a rate of $15\\,\\text{L/min}.$ So, the rate at which the *cleanser* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (15\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.6\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which additives exit the tank.\n\nNext, note that the rate of flow in equals the rate of flow out, so the volume in the tank remains $600\\,\\text{L}.$ Then, since $Q$ is the amount of cleanser in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{600}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $15\\,\\text{L/min},$ *cleanser* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(15\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{600}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{600}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{15Q}{600}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{40}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.6-\\frac{Q}{40}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1}{40}Q=0.6.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${Q}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{Q}_{c}}{dt}+\\frac{1}{40}{Q}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{Q}_{c}(t)=A{e}^{-t/40},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{Q}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${Q}_{p}=\\alpha $ and $\\frac{d{Q}_{p}}{dt}=(\\alpha )^{′}=0$ into the inhomogeneous equation:\n\n$$\n0+\\frac{1}{40}\\alpha =0.6\\,⟹\\,\\alpha =24.\n$$\n\nTherefore, the particular solution is ${Q}_{p}(t)=24.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nQ(t)={Q}_{c}(t)+{Q}_{p}(t)=A{e}^{-t/40}+24.\n$$\n\nWe're told that the tank initially contains $10\\,\\text{kg}$ of dissolved cleanser. So, we can apply the initial condition $Q(0)=10,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =10 \\\\ A{e}^{-0/40}+24 & =10 \\\\ A & =-14\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=24-14{e}^{-t/40}.\n$$"}] [{:db/id #edb/ref 17592186502104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04076803-eae5-51dd-adf5-ffaa457974c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.75\\,\\text{kg}" :db/id #edb/ref 17592186501473} {:answer/id #uuid "8a602200-48ad-53f0-8143-6fe9792d4181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.63\\,\\text{kg}" :db/id #edb/ref 17592186501731} {:answer/id #uuid "d5adba53-2823-56b8-b86a-d86b90f0927a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.32\\,\\text{kg}" :db/id #edb/ref 17592186501890} {:answer/id #uuid "da3ec5e9-ce8a-5063-b326-988d95b5ddd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.18\\,\\text{kg}" :db/id #edb/ref 17592186501903} {:answer/id #uuid "ffc5fe1b-7116-5783-a523-4a7779acf88d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10.94\\,\\text{kg}" :db/id #edb/ref 17592186501974}] :answer-field/correct {:answer/id #uuid "04076803-eae5-51dd-adf5-ffaa457974c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.75\\,\\text{kg}" :db/id #edb/ref 17592186501473} :answer-field/id #uuid "3f84c734-a5ae-5ecb-9eb0-7a39a117167f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501996}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "554f59f6-c41f-55e2-8f84-8c2aab7670ec" :question/math-academy-id "q-336736" :question/problem "A mixing tank initially holds $400\\,\\text{L}$ of liquid containing $6\\,\\text{kg}$ of dissolved cleaning agent.\nA feed solution containing $0.08\\,\\text{kg/L}$ of the cleaning agent is pumped into the tank at a rate of $20\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $20\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of cleaning agent in the tank $5$ minutes after pumping begins." :question/worked-solution "Let $Q$ be the amount of cleaning agent in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which cleaning agents enter the tank minus the rate at which cleaning agents leave the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which cleaning agents enter the tank.\n\nNote that a feed solution containing $0.08\\,\\text{kg/L}$ of the cleaning agent enters the tank at a rate of $20\\,\\text{L/min}.$ So, the rate at which the *cleaning agent* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.08\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (20\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.08\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =1.6\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which cleaning agents exit the tank.\n\nNext, note that the rate of flow in equals the rate of flow out, so the volume in the tank remains $400\\,\\text{L}.$ Then, since $Q$ is the amount of cleaning agent in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{400}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $20\\,\\text{L/min},$ *cleaning agent* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(20\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{400}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(20\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{400}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{20Q}{400}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{20}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =1.6-\\frac{Q}{20}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1}{20}Q=1.6.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${Q}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{Q}_{c}}{dt}+\\frac{1}{20}{Q}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{Q}_{c}(t)=A{e}^{-t/20},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{Q}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${Q}_{p}=\\alpha $ and $\\frac{d{Q}_{p}}{dt}=(\\alpha )^{′}=0$ into the inhomogeneous equation:\n\n$$\n0+\\frac{1}{20}\\alpha =1.6\\,⟹\\,\\alpha =32.\n$$\n\nTherefore, the particular solution is ${Q}_{p}(t)=32.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nQ(t)={Q}_{c}(t)+{Q}_{p}(t)=A{e}^{-t/20}+32.\n$$\n\nWe're told that the tank initially contains $6\\,\\text{kg}$ of dissolved cleaning agent. So, we can apply the initial condition $Q(0)=6,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =6 \\\\ A{e}^{-0/20}+32 & =6 \\\\ A & =-26\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=32-26{e}^{-t/20}\n$$\n\nFinally,  the amount of cleaning agent in the tank $5$ minutes after pumping begins is\n\n$$\nQ(5)=32-26{e}^{-5/20}≈11.75\\,\\text{kg},\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186502108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f66fb4-40cf-56c6-b199-8c73d618fc37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=12-11{e}^{-t/15}" :db/id #edb/ref 17592186501503} {:answer/id #uuid "4f46af42-cc7d-5f1f-afb2-f63457bfad29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=12-11{e}^{-t/20}" :db/id #edb/ref 17592186501609} {:answer/id #uuid "578ba4bb-a618-5ab5-8b97-78550b74205b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=12+11{e}^{-t/20}" :db/id #edb/ref 17592186501628} {:answer/id #uuid "bc8273dc-02bc-5c58-83c8-72b74f957f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=1-12{e}^{-t/20}" :db/id #edb/ref 17592186501842} {:answer/id #uuid "c413a31a-8d21-5344-817f-3bab2b829337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=12-11{e}^{t/20}" :db/id #edb/ref 17592186501857}] :answer-field/correct {:answer/id #uuid "4f46af42-cc7d-5f1f-afb2-f63457bfad29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q(t)=12-11{e}^{-t/20}" :db/id #edb/ref 17592186501609} :answer-field/id #uuid "efdf6499-b332-5612-bc05-cf92d925d07f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502054}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63623e2d-9a1a-53b1-a242-66f71be1ef8a" :question/math-academy-id "q-339383" :question/problem "A pharmaceutical mixer initially holds $300\\,\\text{L}$ of liquid containing $1\\,\\text{kg}$ of dissolved medication.\nA solution containing $0.04\\,\\text{kg/L}$ of dissolved medication is pumped into the mixer at a rate of $15\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $15\\,\\text{L/min}.$ Which expression gives the amount of medication $Q(t),$ in kilograms, in the mixer $t$ minutes after pumping begins?" :question/worked-solution "Let $Q$ be the amount of medication in the mixer at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which medication enters the mixer minus the rate at which medication leaves the mixer.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which additives enter the mixer.\n\nNote that a feed solution containing $0.04\\,\\text{kg/L}$ of the medication enters the mixer at a rate of $15\\,\\text{L/min}.$ So, the rate at which the *medication* enters the mixer is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (15\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.6\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which additives exit the mixer.\n\nNext, note that the rate of flow in equals the rate of flow out, so the volume in the mixer remains $300\\,\\text{L}.$ Then, since $Q$ is the amount of medication in the mixer, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{300}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $15\\,\\text{L/min},$ *medication* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(15\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{300}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(15\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{300}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{15Q}{300}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{20}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.6-\\frac{Q}{20}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1}{20}Q=0.6.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${Q}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{Q}_{c}}{dt}+\\frac{1}{20}{Q}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{Q}_{c}(t)=A{e}^{-t/20},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{Q}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${Q}_{p}=\\alpha $ and $\\frac{d{Q}_{p}}{dt}=(\\alpha )^{′}=0$ into the inhomogeneous equation:\n\n$$\n0+\\frac{1}{20}\\alpha =0.6\\,⟹\\,\\alpha =12.\n$$\n\nTherefore, the particular solution is ${Q}_{p}(t)=12.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nQ(t)={Q}_{c}(t)+{Q}_{p}(t)=A{e}^{-t/20}+12.\n$$\n\nWe're told that the mixer initially contains $1\\,\\text{kg}$ of dissolved medication. So, we can apply the initial condition $Q(0)=1,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =1 \\\\ A{e}^{-0/20}+12 & =1 \\\\ A & =-11\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=12-11{e}^{-t/20}.\n$$"}] [{:db/id #edb/ref 17592186502142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0112f1fc-6de5-513e-87f9-3b66ed92fd30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100.8\\,\\text{lb}" :db/id #edb/ref 17592186501465} {:answer/id #uuid "26fdd352-98f8-5049-9bca-4712271dc3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99.2\\,\\text{lb}" :db/id #edb/ref 17592186501536} {:answer/id #uuid "5cc4d99a-a70c-5a49-aae0-f3604e67d27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100.4\\,\\text{lb}" :db/id #edb/ref 17592186501638} {:answer/id #uuid "c69e4261-0557-5f97-9e81-25b3bb4c21af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "99.6\\,\\text{lb}" :db/id #edb/ref 17592186501861} {:answer/id #uuid "f1dcaab2-0d10-522e-bd0f-9e9fdbc1a915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100.0\\,\\text{lb}" :db/id #edb/ref 17592186501952}] :answer-field/correct {:answer/id #uuid "f1dcaab2-0d10-522e-bd0f-9e9fdbc1a915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100.0\\,\\text{lb}" :db/id #edb/ref 17592186501952} :answer-field/id #uuid "507a90fb-d7f1-59f5-8df1-dc619644c3da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502000}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c3e80580-6c31-591c-a6d6-df75a9aede3a" :question/math-academy-id "q-336503" :question/problem "A fertilizer tank for an irrigation system can hold up to $210\\,\\text{gal}$ of solution. Initially, it contains $90\\,\\text{gal}$ of fertilizer solution with $18\\,\\text{lb}$ of dissolved fertilizer. A more concentrated solution with concentration $0.5\\,\\text{lb/gal}$ flows into the tank at a rate of $18\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $12\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of fertilizer in the tank at the moment it begins to overflow." :question/worked-solution "Since $Q$ is the amount of fertilizer in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which fertilizer enters the tank minus the rate at which fertilizer leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which fertilizer enters the tank.\n\nFirst, note that a solution containing $0.5\\,\\text{lb/gal}$ of fertilizer enters the tank at a rate of $18\\,\\text{gal/min}.$ So, the rate at which the *fertilizer* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (18\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (18\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =9\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which fertilizer exits the tank.\n\nTo find the rate at which fertilizer leaves the tank, we must first determine the volume of solution in the tank at time $t.$\n\nThe tank initially contains $90\\,\\text{gal}$ of solution; solution enters at $18\\,\\text{gal/min}$ and mixed solution leaves at $12\\,\\text{gal/min}.$\nAs a result, the amount of solution in the tank after $t$ minutes is \n\n$$\nV(t)=90+18t-12t=6(15+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of fertilizer in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{6(15+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $12\\,\\text{gal/min},$ *fertilizer* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{6(15+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{6(15+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{12Q}{6(15+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{15+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =9-\\frac{2Q}{15+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{15+t}\\,Q=9.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(15+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|15+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(15+t)^{2}} \\\\  & =(15+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(15+t)^{2}$ yields\n\n$$\n\\begin{aligned}(15+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{15+t}\\,Q) & =(15+t)^{2}\\cdot 9 \\\\ (15+t)^{2}\\frac{dQ}{dt}+2(15+t)Q & =9(15+t)^{2} \\\\ \\frac{d}{dt}(Q(15+t)^{2}) & =9(15+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(15+t)^{2})\\,dt & =\\int 9(15+t)^{2}\\,dt \\\\ Q(15+t)^{2} & =9\\cdot \\frac{1}{3}(15+t)^{3}+C \\\\ Q(t) & =3(15+t)+\\frac{C}{(15+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $18\\,\\text{lb}$ of fertilizer. So, we can apply the initial condition $Q(0)=18,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ 3(15+0)+\\frac{C}{(15+0)^{2}} & =18 \\\\ 45+\\frac{C}{(15)^{2}} & =18 \\\\ \\frac{C}{{15}^{2}} & =-27 \\\\ C & =-27(15)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =3(15+t)-\\frac{27(15)^{2}}{(15+t)^{2}} \\\\  & =3(15+t)-27{\\left(\\frac{15}{15+t}\\right)}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $210\\,\\text{gal},$ so we can use the condition $V({t}_{o})=210$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =210 \\\\ 90+18{t}_{o}-12{t}_{o} & =210 \\\\ 90+6{t}_{o} & =210 \\\\ 6{t}_{o} & =120 \\\\ {t}_{o} & =20\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of fertilizer in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(20) & =3(15+20)-27{\\left(\\frac{15}{15+20}\\right)}^{2} \\\\  & =105-27{\\left(\\frac{15}{35}\\right)}^{2} \\\\  & ≈100.0\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19631a4f-fc75-5f16-94d0-c840626309aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.48\\,\\text{kg}" :db/id #edb/ref 17592186501515} {:answer/id #uuid "409f3cff-59d6-5382-900e-2722da60aa57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.09\\,\\text{kg}" :db/id #edb/ref 17592186501584} {:answer/id #uuid "5688b277-ef03-5eaf-8c63-160fb654c7c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.62\\,\\text{kg}" :db/id #edb/ref 17592186501625} {:answer/id #uuid "5f94b143-c3c7-545e-847d-30ec918b7ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.90\\,\\text{kg}" :db/id #edb/ref 17592186501641} {:answer/id #uuid "a0b4fa8a-26bd-5a01-bcb0-d0ebf5922738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.01\\,\\text{kg}" :db/id #edb/ref 17592186501768}] :answer-field/correct {:answer/id #uuid "a0b4fa8a-26bd-5a01-bcb0-d0ebf5922738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.01\\,\\text{kg}" :db/id #edb/ref 17592186501768} :answer-field/id #uuid "71c957ef-ec71-5945-b112-c39defc2facc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502016}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d0340e70-b947-5b25-8e24-a63ff0f87f38" :question/math-academy-id "q-339403" :question/problem "A wastewater treatment basin initially holds $320\\,\\text{L}$ of liquid containing $2.2\\,\\text{kg}$ of dissolved neutralizing agent.\nA feed solution containing $0.05\\,\\text{kg/L}$ of the agent is pumped into the basin at a rate of $8\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $4\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of agent in the basin $5$ minutes after pumping begins." :question/worked-solution "Let $Q$ be the amount of agent in the basin at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which agent enters the tank minus the rate at which agent leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which agent enters the basin.\n\nNote that a feed solution containing $0.05\\,\\text{kg/L}$ of the agent enters the basin at a rate of $8\\,\\text{L/min}.$ So, the rate at which the *agent* enters the basin is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.05\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (8\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.05\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (8\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.4\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which agent exits the basin.\n\nTo find the rate at which agent leaves the basin, we must first determine the volume of liquid in the basin at time $t.$\n\nThe basin initially contains $320\\,\\text{L}$ of liquid; a solution enters at $8\\,\\text{L/min}$ and leaves at $4\\,\\text{L/min}.$\nAs a result, the volume of liquid in the basin after $t$ minutes is \n\n$$\n320+8t-4t=(320+4t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of agent in the basin, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{320+4t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $4\\,\\text{L/min},$ *agent* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(4\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{320+4t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(4\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{320+4t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{4Q}{320+4t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{Q}{80+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.4-\\frac{Q}{80+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{1}{80+t}Q=0.4.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 1/(80+t)\\,dt} \\\\  & ={e}^{\\operatorname{ln}⁡|80+t|} \\\\  & =80+t\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=80+t$ yields\n\n$$\n\\begin{aligned}(80+t)\\cdot (\\frac{dQ}{dt}+\\frac{1}{80+t}Q) & =(80+t)\\cdot 0.4 \\\\ (80+t)\\frac{dQ}{dt}+Q & =0.4(80+t) \\\\ \\frac{d}{dt}(Q(80+t)) & =0.4(80+t).\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(80+t))\\,dt & =\\int 0.4(80+t)\\,dt \\\\ Q(80+t) & =0.4\\cdot \\frac{1}{2}(80+t)^{2}+C \\\\ Q(t) & =0.2(80+t)+\\frac{C}{80+t}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the basin initially contains $2.2\\,\\text{kg}$ of agent. So, we can apply the initial condition $Q(0)=2.2,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =2.2 \\\\ 0.2(80+0)+\\frac{C}{80+0} & =2.2 \\\\ 16+\\frac{C}{80} & =2.2 \\\\ \\frac{C}{80} & =-13.8 \\\\ C & =-1104\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.2(80+t)-\\frac{1104}{80+t}.\\end{aligned}\n$$\n\nFinally,  the amount of agent in the basin $5$ minutes after pumping begins is\n\n$$\n\\begin{aligned}Q(5) & =0.2(80+5)-\\frac{1104}{80+5} \\\\  & =17-\\frac{1104}{85} \\\\  & ≈4.01\\,\\text{kg},\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186502863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "379ce176-b85b-5473-ac5c-c334e33ade53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}x^{-6/7} + C" :db/id #edb/ref 17592186502889} {:answer/id #uuid "3fa0d404-d0fc-5e09-8e4b-7fcc8eed12b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-13/7} + C" :db/id #edb/ref 17592186502896} {:answer/id #uuid "4028963f-e622-507c-92ba-3fe653d44e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{7}x^{-20/7} + C" :db/id #edb/ref 17592186502898} {:answer/id #uuid "48e20e30-98ef-545f-8564-315ec67ca5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-6/7} + C" :db/id #edb/ref 17592186502906} {:answer/id #uuid "d873e68a-b191-51b0-8a82-9ae3df09c4fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{7}x^{-6/7} + C" :db/id #edb/ref 17592186502953}] :answer-field/correct {:answer/id #uuid "48e20e30-98ef-545f-8564-315ec67ca5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-6/7} + C" :db/id #edb/ref 17592186502906} :answer-field/id #uuid "94d70d54-a73e-59c2-9e26-72bd20515cfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502930}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "054c92af-f6c0-5cb6-8c52-c81bf5740a21" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[7]{{x}^{13}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[7]{{x}^{13}}}=\\frac{1}{{x}^{13/7}}={x}^{-13/7}.\n$$ So, we can use the power rule with $n=-\\frac{13}{7}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[7]{{x}^{13}}}\\,\\text{d}x & =\\int {x}^{-13/7}\\,\\text{d}x \\\\  & =\\frac{{x}^{-13/7+1}}{-\\frac{13}{7}+1}+C \\\\  & =-\\frac{7}{6}{x}^{-6/7}+C \\\\  & =-\\frac{7}{6{x}^{6/7}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e03f87-24cd-5a1f-85f6-21fa74293d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{9}x^{-16/9} + C" :db/id #edb/ref 17592186502861} {:answer/id #uuid "04c21815-61ed-534e-ad04-3d35a62aa2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502862} {:answer/id #uuid "24baf7d8-b08d-52e8-aacf-0f682f6c25f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{9}x^{2/9} + C" :db/id #edb/ref 17592186502877} {:answer/id #uuid "a8a05915-00e3-5287-9df3-ec5051320330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{-7/9} + C" :db/id #edb/ref 17592186502937} {:answer/id #uuid "d1cf8368-4008-5f0c-b393-98dc8c2b3340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502951}] :answer-field/correct {:answer/id #uuid "04c21815-61ed-534e-ad04-3d35a62aa2bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}x^{2/9} + C" :db/id #edb/ref 17592186502862} :answer-field/id #uuid "23d96cda-06e3-5949-b59a-136c6439133a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502875}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ea9e5d9-602f-5599-818f-aa6b87eda7f7" :question/problem "Given that $f(x)={x}^{-7/9}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{7}{9}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-7/9}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/9+1}}{(-\\frac{7}{9}+1)}+C \\\\  & =\\frac{{x}^{2/9}}{\\left(\\frac{2}{9}\\right)}+C \\\\  & =\\frac{9}{2}{x}^{2/9}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3db7372d-b7c0-5c4e-be87-53e9e865f128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-8/3} + C" :db/id #edb/ref 17592186502895} {:answer/id #uuid "4341f9bb-aabc-509a-b456-9aef502ddeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}x^{-2/3} + C" :db/id #edb/ref 17592186502904} {:answer/id #uuid "515bed00-c253-59e6-90ff-ea177c4df26c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-2/3} + C" :db/id #edb/ref 17592186502908} {:answer/id #uuid "6542b0ac-8e88-518e-93f4-c4f361379998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}x^{-5/3} + C" :db/id #edb/ref 17592186502912} {:answer/id #uuid "d1d66349-73d9-5894-8ea5-62c18d22ca86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}x^{-2/3} + C" :db/id #edb/ref 17592186502952}] :answer-field/correct {:answer/id #uuid "d1d66349-73d9-5894-8ea5-62c18d22ca86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}x^{-2/3} + C" :db/id #edb/ref 17592186502952} :answer-field/id #uuid "8878aff2-5da1-5cae-8ac0-c802b9fa22f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502924}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "24409f16-92eb-5e3a-9a94-2612754d8d1a" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[3]{{x}^{5}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[3]{{x}^{5}}}=\\frac{1}{{x}^{5/3}}={x}^{-5/3}.\n$$ So, we can use the power rule with $n=-\\frac{5}{3}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[3]{{x}^{5}}}\\,\\text{d}x & =\\int {x}^{-5/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/3+1}}{-\\frac{5}{3}+1}+C \\\\  & =-\\frac{3}{2}{x}^{-2/3}+C \\\\  & =-\\frac{3}{2{x}^{2/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca6ae77-d4eb-5628-bf2d-2ad81668a6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{3/7} + C" :db/id #edb/ref 17592186502893} {:answer/id #uuid "4c8ee872-c2aa-5ac4-be85-d82e9c4ef936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{-11/7} + C" :db/id #edb/ref 17592186502907} {:answer/id #uuid "727e1873-0bcc-5e7f-8015-b4f278888e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{-4/7} + C" :db/id #edb/ref 17592186502919} {:answer/id #uuid "c398c1d7-925b-5ee5-a8fa-61cab36aa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502946} {:answer/id #uuid "fa18ec9f-eb7c-5a17-b374-3ab9b1f1d7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502961}] :answer-field/correct {:answer/id #uuid "fa18ec9f-eb7c-5a17-b374-3ab9b1f1d7cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502961} :answer-field/id #uuid "42e84933-a55b-529f-9a48-2720e2d4ea8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502903}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2838d5a7-98fc-5b74-838a-12c9f0c1d487" :question/problem "Given that $f(x)={x}^{-4/7}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{4}{7}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-4/