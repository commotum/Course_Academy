{5}{4}{x}^{4/5}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d4daf1-ba4b-5a5a-9bfb-9fcfa0ec5e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-8/5} + C" :db/id #edb/ref 17592186502867} {:answer/id #uuid "16537613-9cc7-5cb0-93b0-7503cdac3395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502868} {:answer/id #uuid "3d2dd136-0894-52fa-aaf0-fb2dc0ac21a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}x^{-13/5} + C" :db/id #edb/ref 17592186502894} {:answer/id #uuid "718ee9a6-017b-59f0-8c6e-948645ffc5f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{5}x^{-3/5} + C" :db/id #edb/ref 17592186502917} {:answer/id #uuid "ee7bf801-e0b2-5094-bcb2-972f291cbd49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502958}] :answer-field/correct {:answer/id #uuid "16537613-9cc7-5cb0-93b0-7503cdac3395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}x^{-3/5} + C" :db/id #edb/ref 17592186502868} :answer-field/id #uuid "9de62160-8b1a-5cc7-89d0-103a6a2a4141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502933}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7db6e951-901a-5fa3-9344-ecedb4022de8" :question/problem "Given that $f(x)=\\frac{1}{{x}^{8/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{8/5}}={x}^{-8/5}.$ So, we can use the power rule with $n=-\\frac{8}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-8/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-8/5+1}}{(-\\frac{8}{5}+1)}+C \\\\  & =\\frac{{x}^{-3/5}}{\\left(-\\frac{3}{5}\\right)}+C \\\\  & =-\\frac{5}{3}{x}^{-3/5}+C \\\\  & =-\\frac{5}{3{x}^{3/5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "226b2f3f-2db8-5997-b937-8e623b198b43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{-1/5} + C" :db/id #edb/ref 17592186502874} {:answer/id #uuid "343827b0-544c-50a0-9c05-84886ec4f608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-1/5} + C" :db/id #edb/ref 17592186502885} {:answer/id #uuid "4235fe68-65b7-5e1e-8085-4b69c66d66c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-6/5} + C" :db/id #edb/ref 17592186502902} {:answer/id #uuid "638899e9-e5e6-56ef-b39c-a5c6ac140c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}x^{-11/5} + C" :db/id #edb/ref 17592186502911} {:answer/id #uuid "f6be96f2-f588-5691-8f93-a2cb3d17caa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}x^{-1/5} + C" :db/id #edb/ref 17592186502960}] :answer-field/correct {:answer/id #uuid "343827b0-544c-50a0-9c05-84886ec4f608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5x^{-1/5} + C" :db/id #edb/ref 17592186502885} :answer-field/id #uuid "6f2d2ada-563b-5a0b-805f-7e51d4ac3934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502915}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c4c3de5-5797-5a42-a678-da4fa4e6e5be" :question/problem "Given that $f(x)=\\frac{1}{{x}^{6/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{6/5}}={x}^{-6/5}.$ So, we can use the power rule with $n=-\\frac{6}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-6/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6/5+1}}{(-\\frac{6}{5}+1)}+C \\\\  & =\\frac{{x}^{-1/5}}{\\left(-\\frac{1}{5}\\right)}+C \\\\  & =-5{x}^{-1/5}+C \\\\  & =-\\frac{5}{{x}^{1/5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17719d5d-d1ba-5a53-82a1-927b9ba2ae7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{6}x^{-7/6} + C" :db/id #edb/ref 17592186502869} {:answer/id #uuid "222ebe4e-7cc2-56b8-9528-6c4ba3801e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502873} {:answer/id #uuid "45cf63b0-27c9-5a38-89d8-9b07fe0e46ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502905} {:answer/id #uuid "e2c684a2-9fa1-565b-98df-fcb0427759b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-13/6} + C" :db/id #edb/ref 17592186502956} {:answer/id #uuid "fb60838c-841d-5641-a911-df7407114bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{6}x^{-19/6} + C" :db/id #edb/ref 17592186502962}] :answer-field/correct {:answer/id #uuid "45cf63b0-27c9-5a38-89d8-9b07fe0e46ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502905} :answer-field/id #uuid "9a8e6cf9-5e9d-5592-8b0f-70404484ce19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502932}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "99719f66-3778-50b5-89e7-75e1a56079c8" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[6]{{x}^{13}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[6]{{x}^{13}}}=\\frac{1}{{x}^{13/6}}={x}^{-13/6}.\n$$ So, we can use the power rule with $n=-\\frac{13}{6}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[6]{{x}^{13}}}\\,\\text{d}x & =\\int {x}^{-13/6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-13/6+1}}{-\\frac{13}{6}+1}+C \\\\  & =-\\frac{6}{7}{x}^{-7/6}+C \\\\  & =-\\frac{6}{7{x}^{7/6}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09fcd5be-886d-5871-98a0-3b7bbee18125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-5} + C" :db/id #edb/ref 17592186502864} {:answer/id #uuid "17bc6fb3-f3d6-554b-b7d0-aa12f00d5ed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-6} + C" :db/id #edb/ref 17592186502870} {:answer/id #uuid "30994037-ecf1-5233-ae47-c9184a594ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502881} {:answer/id #uuid "324f2843-e8c3-538b-861f-2062bfaaafcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-7} + C" :db/id #edb/ref 17592186502883} {:answer/id #uuid "8968132d-f3a4-5d38-af6d-f8cb16432147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502925}] :answer-field/correct {:answer/id #uuid "30994037-ecf1-5233-ae47-c9184a594ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502881} :answer-field/id #uuid "b42f636b-4503-5284-ad05-d0d8123f8de6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502940}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa70fb16-17a5-5816-9e73-90243c9b4ed6" :question/problem "What is the antiderivative of $\\frac{1}{{x}^{6}}?$ Assume $x>0$." :question/worked-solution "Note that $\\frac{1}{{x}^{6}}={x}^{-6}.$ So, we can use the power rule with $n=-6$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{6}}\\,\\text{d}x & =\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6+1}}{-6+1}+C \\\\  & =-\\frac{{x}^{-5}}{5}+C \\\\  & =-\\frac{1}{5{x}^{5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1821ed70-eaad-54b9-8c65-4bbb2bcf3160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-13/6} + C" :db/id #edb/ref 17592186502871} {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} {:answer/id #uuid "532e1430-d266-59be-bcd5-73f6c2edc0c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x^{-1/6} + C" :db/id #edb/ref 17592186502909} {:answer/id #uuid "a0474aa2-d95c-5f73-a568-2f603fd609c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-7/6} + C" :db/id #edb/ref 17592186502934} {:answer/id #uuid "b62fcefc-fd59-5b42-856a-3cdec3b5280a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-1/6} + C" :db/id #edb/ref 17592186502941}] :answer-field/correct {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} :answer-field/id #uuid "4062f5dc-238e-55a5-899a-9aca06dee35f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502899}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc7d7a47-ab4b-5a3b-8ff4-ed432aa440ba" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[6]{{x}^{7}}}$. Assume $x>0$." :question/worked-solution "Note that $$\n\\displaystyle \\frac{1}{\\sqrt[6]{{x}^{7}}}=\\frac{1}{{x}^{7/6}}={x}^{-7/6}.\n$$ So, we can use the power rule with $n=-\\frac{7}{6}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[6]{{x}^{7}}}\\,\\text{d}x & =\\int {x}^{-7/6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/6+1}}{-\\frac{7}{6}+1}+C \\\\  & =-6{x}^{-1/6}+C \\\\  & =-\\frac{6}{{x}^{1/6}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34391ca3-ad98-50ce-8e1e-44cb8eade4a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502886} {:answer/id #uuid "401ae6af-30db-5402-a6f2-7d26f4d47d36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-14/5} + C" :db/id #edb/ref 17592186502897} {:answer/id #uuid "5b7281c4-4d4b-5557-8aaa-96752cd38280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/5} + C" :db/id #edb/ref 17592186502910} {:answer/id #uuid "c4952ea7-4ee5-5ad8-9fff-3d99d83b3d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-4/5} + C" :db/id #edb/ref 17592186502947} {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949}] :answer-field/correct {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949} :answer-field/id #uuid "71958d00-8def-5201-b349-02ba63662a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502918}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de2aa536-e15f-5af4-b511-e0e4c9d378a1" :question/problem "Given that $f(x)=\\frac{1}{{x}^{9/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{9/5}}={x}^{-9/5}.$ So, we can use the power rule with $n=-\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/5+1}}{(-\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{-4/5}}{\\left(-\\frac{4}{5}\\right)}+C \\\\  & =-\\frac{5}{4}{x}^{-4/5}+C \\\\  & =-\\frac{5}{4{x}^{4/5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6ad986-0c26-5cd6-9cd3-04a7be56d694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186503846} {:answer/id #uuid "4ec8b324-f032-547f-97d9-6c73f80f4440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186503850} {:answer/id #uuid "7fe67df0-46d1-5acd-abf6-e732a8688e8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186503855} {:answer/id #uuid "b8b1f0d3-bec7-598d-ba2e-a3f438f06ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7x^{7}+C" :db/id #edb/ref 17592186503868} {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875}] :answer-field/correct {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875} :answer-field/id #uuid "b67f2104-8e47-50cd-b752-fad1aa17e5ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503867}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4194dc2e-82ad-5109-91f4-d383eed4b18e" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{6}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=6$, and we get\n\n$$\n\\int {x}^{6}\\,\\text{d}x=\\frac{{x}^{6+1}}{6+1}+C=\\frac{{x}^{7}}{7}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{7}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7})+0 \\\\ &= \\frac{1}{7}\\cdot 7{x}^{6} \\\\ &= {x}^{6}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} {:answer/id #uuid "0b7b7de0-eaf8-57d9-8475-c23f72194dd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{8}" :db/id #edb/ref 17592186503844} {:answer/id #uuid "a5bb73e6-3ec8-51dd-ad3b-1cd6d6243b7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 + C" :db/id #edb/ref 17592186503862} {:answer/id #uuid "b52194ac-60ec-5ec7-91b2-c8a58426c3e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}" :db/id #edb/ref 17592186503866} {:answer/id #uuid "f1d839d9-d182-5a2a-8ca4-8961f79ffaae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{8} + C" :db/id #edb/ref 17592186503874}] :answer-field/correct {:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} :answer-field/id #uuid "88eaa69f-9171-51b9-9926-45e937a2ad36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503859}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4fc55d29-07c8-58f3-8bc8-d1223d0589d0" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{7}\\,\\text{d}x.\n$$ Include the arbitrary constant of integration." :question/worked-solution "We apply the power rule with $n=7$, and we get\n\n$$\n\\int {x}^{7}\\,\\text{d}x=\\frac{{x}^{7+1}}{7+1}+C=\\frac{{x}^{8}}{8}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{8}}{8}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{8}\\frac{\\text{d}}{\\text{d}x}({x}^{8})+0 \\\\ &= \\frac{1}{8}\\cdot 8{x}^{7} \\\\ &= {x}^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081fa2f5-42b3-5c04-80c9-10a003c271a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x^{4} + C" :db/id #edb/ref 17592186503843} {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} {:answer/id #uuid "7015537d-a311-57e0-815f-dece8e7c2eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{6} + C" :db/id #edb/ref 17592186503853} {:answer/id #uuid "84bc4aa5-c9e8-54dc-9352-f633e5591d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186503857} {:answer/id #uuid "dd56a3a8-a755-5234-b43f-e287021340e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4} + C" :db/id #edb/ref 17592186503870}] :answer-field/correct {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} :answer-field/id #uuid "51200684-dca8-5045-9aea-e16255caa7bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503852}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "74bb6151-9d7e-5db4-9d07-e87c336986aa" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{5}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=5$, and we get\n\n$$\n\\int {x}^{5}\\,\\text{d}x=\\frac{{x}^{5+1}}{5+1}+C=\\frac{{x}^{6}}{6}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{6}}{6}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{6}}{6}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{6}\\frac{\\text{d}}{\\text{d}x}({x}^{6})+0 \\\\ &= \\frac{1}{6}\\cdot 6{x}^{5} \\\\ &= {x}^{5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19401952-b969-5a9f-9750-1720c3ea9602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9} + C" :db/id #edb/ref 17592186503845} {:answer/id #uuid "3d942c43-21e5-5ec4-b609-785240316ce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{7} + C" :db/id #edb/ref 17592186503847} {:answer/id #uuid "7ff916ab-3641-575c-b8ab-d8ce83a4174b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{9} + C" :db/id #edb/ref 17592186503856} {:answer/id #uuid "90147ce6-5ad4-56fc-aa26-0fc98c813215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503861} {:answer/id #uuid "ce201103-531a-5e28-bbe3-329fc7ec8063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{7} + C" :db/id #edb/ref 17592186503869}] :answer-field/correct {:answer/id #uuid "19401952-b969-5a9f-9750-1720c3ea9602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9} + C" :db/id #edb/ref 17592186503845} :answer-field/id #uuid "fe44896c-83fc-509b-862e-d8c3138397c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d476a50-5742-5b02-8acf-300d458d3177" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{8}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=8$, and we get\n\n$$\n\\int {x}^{8}\\,\\text{d}x=\\frac{{x}^{8+1}}{8+1}+C=\\frac{{x}^{9}}{9}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{9}}{9}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{9}}{9}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9})+0 \\\\ &= \\frac{1}{9}\\cdot 9{x}^{8} \\\\ &= {x}^{8}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863bcfda-f86c-5454-b9dc-accc499f2c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{4}+C" :db/id #edb/ref 17592186503858} {:answer/id #uuid "abbb6d1e-23ec-52ad-93a6-2a688bee49af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186503864} {:answer/id #uuid "abe28291-ecd6-5f9e-985f-a0a2c28cc41d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186503865} {:answer/id #uuid "e85650a9-47ba-50b3-a4f1-3c07d1371853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{4}+C" :db/id #edb/ref 17592186503872} {:answer/id #uuid "f079c239-840f-54f7-96fe-bbb4346258a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{4}+C" :db/id #edb/ref 17592186503873}] :answer-field/correct {:answer/id #uuid "abbb6d1e-23ec-52ad-93a6-2a688bee49af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186503864} :answer-field/id #uuid "a740068d-6348-515e-8b5f-4399bec063f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503863}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2fcd99b-3b51-589f-9fd0-4c5df6da6a6c" :question/problem "Calculate $$\n\\displaystyle \\int {x}^{3}\\,\\text{d}x.\n$$" :question/worked-solution "We apply the power rule with $n=3$, and we get\n\n$$\n\\int {x}^{3}\\,\\text{d}x=\\frac{{x}^{3+1}}{3+1}+C=\\frac{{x}^{4}}{4}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{4}}{4}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4})+0 \\\\ &= \\frac{1}{4}\\cdot 4{x}^{3} \\\\ &= {x}^{3}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d7829f8-6eb6-557a-9168-c1c357d9482c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{7/2}}{7}" :db/id #edb/ref 17592186503878}] :answer-field/correct {:answer/id #uuid "0d7829f8-6eb6-557a-9168-c1c357d9482c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{7/2}}{7}" :db/id #edb/ref 17592186503878} :answer-field/id #uuid "1dad12b4-53d9-5ebb-9ae6-bd1949a26915" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503881}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f6eb79d-ca08-5993-aa8f-2308ed2df00b" :question/problem "Find the antiderivative of $\\sqrt[2]{{x}^{5}}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[2]{{x}^{5}}={x}^{5/2}.$ So, we can apply the power rule with $n=\\frac{5}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[2]{{x}^{5}}\\,\\text{d}x & =\\int {x}^{5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{5/2+1}}{(\\frac{5}{2}+1)}+C \\\\  & =\\frac{{x}^{7/2}}{\\left(\\frac{7}{2}\\right)}+C \\\\  & =\\frac{2{x}^{7/2}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{7/2}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2{x}^{7/2}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/2})+0 \\\\ &= \\frac{2}{7}\\cdot \\frac{7}{2}{x}^{7/2-1} \\\\ &= {x}^{5/2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b160a8b5-4564-5b27-8acf-8c7ae622a84f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{5/2}}{5}" :db/id #edb/ref 17592186503907}] :answer-field/correct {:answer/id #uuid "b160a8b5-4564-5b27-8acf-8c7ae622a84f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{x}^{5/2}}{5}" :db/id #edb/ref 17592186503907} :answer-field/id #uuid "9c8859ee-7542-5269-9360-31fde77bc9d0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503899}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2591c86e-cb60-5cb8-b4bb-3c4891ec69bc" :question/problem "Find the antiderivative of ${x}^{3/2}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We can apply the power rule with $n=\\frac{3}{2}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{3/2}\\,\\text{d}x & =\\frac{{x}^{3/2+1}}{(\\frac{3}{2}+1)}+C \\\\  & =\\frac{{x}^{5/2}}{\\left(\\frac{5}{2}\\right)}+C \\\\  & =\\frac{2{x}^{5/2}}{5}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{5/2}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2{x}^{5/2}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/2})+0 \\\\ &= \\frac{2}{5}\\cdot \\frac{5}{2}{x}^{5/2-1} \\\\ &= {x}^{3/2}\\,✓\\end{aligned}\n$$"}]}
