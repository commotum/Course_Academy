}{\\sqrt[3]{{x}^{10}}}=\\frac{1}{{x}^{10/3}}={x}^{-10/3}.\n$$ So, we can use the power rule with $n=-\\frac{10}{3}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[3]{{x}^{10}}}\\,\\text{d}x & =\\int {x}^{-10/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-10/3+1}}{-\\frac{10}{3}+1}+C \\\\  & =-\\frac{3}{7}{x}^{-7/3}+C \\\\  & =-\\frac{3}{7{x}^{7/3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12095852-ce4c-5c59-b9b1-192364d03345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{-1/4} + C" :db/id #edb/ref 17592186502866} {:answer/id #uuid "80af63e6-f7fb-5178-9c4a-d96bedf2c287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x^{-5/4} + C" :db/id #edb/ref 17592186502922} {:answer/id #uuid "b6d97a02-3bcb-5f85-9497-a9db944bdb62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x^{3/4} + C" :db/id #edb/ref 17592186502942} {:answer/id #uuid "e0d65c81-82ee-5c39-9813-d7adc6117dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502955} {:answer/id #uuid "e9b9e661-3c29-5b89-b031-ae16b8d1203b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502957}] :answer-field/correct {:answer/id #uuid "e9b9e661-3c29-5b89-b031-ae16b8d1203b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}x^{3/4} + C" :db/id #edb/ref 17592186502957} :answer-field/id #uuid "10312bb4-8cd0-5e43-95e8-b8afad9283e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a5e9787-8ef9-5e19-99e9-70e48a27adcf" :question/problem "Given that $f(x)={x}^{-1/4}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can use the power rule with $n=-\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-1/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-1/4+1}}{(-\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{3/4}}{\\left(\\frac{3}{4}\\right)}+C \\\\  & =\\frac{4}{3}{x}^{3/4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d738aac-dbe8-544c-8e1d-2595eca3d13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{-1/4} + C" :db/id #edb/ref 17592186502880} {:answer/id #uuid "6a447127-79f8-57b4-9456-cc1dc920e3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-5/4} + C" :db/id #edb/ref 17592186502913} {:answer/id #uuid "907f822e-c090-559b-9aba-2e8311fdac55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/4} + C" :db/id #edb/ref 17592186502929} {:answer/id #uuid "a06d15c6-bae0-59f6-910b-7f074de70fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-1/4} + C" :db/id #edb/ref 17592186502935} {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945}] :answer-field/correct {:answer/id #uuid "c035fb66-b8a0-5b74-85ee-dba3437624aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x^{-1/4} + C" :db/id #edb/ref 17592186502945} :answer-field/id #uuid "fc2d6790-5efe-5373-be98-3094e21928cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502963}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40665566-8355-550d-acf0-8fd3e706266d" :question/problem "Given that $f(x)=\\frac{1}{{x}^{5/4}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{5/4}}={x}^{-5/4}.$ So, we can use the power rule with $n=-\\frac{5}{4}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-5/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/4+1}}{(-\\frac{5}{4}+1)}+C \\\\  & =\\frac{{x}^{-1/4}}{\\left(-\\frac{1}{4}\\right)}+C \\\\  & =-4{x}^{-1/4}+C \\\\  & =-\\frac{4}{{x}^{1/4}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186502914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0079a791-7df9-5dd7-bdf0-9fde624e2bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{5/7} + C" :db/id #edb/ref 17592186502860} {:answer/id #uuid "337d5a89-e1d3-5a29-83bb-5d3c21780cb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}x^{-2/7} + C" :db/id #edb/ref 17592186502884} {:answer/id #uuid "369f6c33-6557-5d15-9e0e-5f461bceaa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{-9/7} + C" :db/id #edb/ref 17592186502888} {:answer/id #uuid "384fd8fa-5c2e-5502-b800-d8f574d73937" :answer/type {:db/