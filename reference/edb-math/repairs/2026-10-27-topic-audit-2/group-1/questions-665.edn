#{[{:db/id #edb/ref 17592186571450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} {:answer/id #uuid "205ae525-2c88-43fd-ab44-a800dec93096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\ln x+x+\\frac{3}{x}" :db/id #edb/ref 17592186576147}] :answer-field/correct {:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} :answer-field/id #uuid "b6a34341-fe46-5049-b63f-03fb79ef67af" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f475b19b-1e35-517e-8f15-4fa3d740b6ba" :question/math-academy-id "q-320824" :question/problem "Given that $f(x)=({x}^{2}+3)\\operatorname{ln}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2x\\operatorname{ln}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}+3$ and $v(x)=\\operatorname{ln}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2}+3)}^{′}\\operatorname{ln}⁡(x)+({x}^{2}+3){(\\operatorname{ln}⁡(x))}^{′} \\\\  & =(2x)(\\operatorname{ln}⁡(x))+({x}^{2}+3)\\left(\\frac{1}{x}\\right) \\\\  & =2x\\operatorname{ln}⁡(x)+\\frac{{x}^{2}+3}{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c21b53-f065-504c-a5e3-aa2005a3edca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+5\\operatorname{csc}⁡\\operatorname{tan}⁡x+C." :db/id #edb/ref 17592186574951} {:answer/id #uuid "1f40bf7b-d980-5c37-9185-3b085c9c5c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C." :db/id #edb/ref 17592186574999} {:answer/id #uuid "3a387fb4-5f8e-534c-9e75-92e6cdf63fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-{tan}^{2}⁡x+C." :db/id #edb/ref 17592186575047} {:answer/id #uuid "9dd5d538-c487-511e-8d7f-5e1b4ffcc218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+5\\operatorname{tan}⁡x+C." :db/id #edb/ref 17592186575222} {:answer/id #uuid "ad986292-1692-5d51-b82b-3cd472c78eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+5\\operatorname{tan}⁡x+C." :db/id #edb/ref 17592186575255}] :answer-field/correct {:answer/id #uuid "1f40bf7b-d980-5c37-9185-3b085c9c5c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C." :db/id #edb/ref 17592186574999} :answer-field/id #uuid "08e04e2e-7eca-562c-852b-2c70ebf8ebaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "59e71a7a-5ae7-5b4a-bdd0-a27062dbab09" :question/math-academy-id "q-71661" :question/problem "$$\n\\displaystyle \\int (\\operatorname{cos}⁡x-5{sec}^{2}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{cos}⁡x-5{sec}^{2}⁡x)\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-\\int 5{sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-5\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-5\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186574988} {:answer/id #uuid "2fc267db-4bcb-55dc-bdea-9ddc9b01a7b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{tan}⁡x+5\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575030} {:answer/id #uuid "9b5373b4-ce2d-560c-85b8-db62e75a98a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{cot}⁡x-5\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575214} {:answer/id #uuid "c9e90b57-bb92-5b49-98e6-3e0a2d915c73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{tan}⁡x-5\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575306} {:answer/id #uuid "f8c18cbb-8412-58a3-a55e-23de81200289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\operatorname{cot}⁡x-5\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575392}] :answer-field/correct {:answer/id #uuid "18bcbe64-bb6f-55cf-a9d1-22e95a1231bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186574988} :answer-field/id #uuid "6d0a6d73-32b4-5324-aae6-b3e318afe759" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575461}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aefe8a56-b826-5c47-afc1-22f96d795fb8" :question/math-academy-id "q-49123" :question/problem "$$\n\\displaystyle \\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}⁡x\\,\\text{d}x & =-\\operatorname{cot}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡x(6\\operatorname{csc}⁡x-5\\operatorname{cot}⁡x)\\text{d}x & =\\int (6{csc}^{2}⁡x-5\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\int 6{csc}^{2}⁡x\\,\\text{d}x-\\int 5\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6\\int {csc}^{2}⁡x\\,\\text{d}x-5\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6(-\\operatorname{cot}⁡x)-5(-\\operatorname{csc}⁡x)+C \\\\  & =-6\\operatorname{cot}⁡x+5\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322df916-39b9-599e-a476-810f5cef3397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575036} {:answer/id #uuid "7c2fc9f8-9ba6-5343-a7ed-17d93cc87a5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575174} {:answer/id #uuid "a9719d4f-c0e6-58b1-9042-0f8dc0cc5b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575248} {:answer/id #uuid "cfa7ffc1-052c-532e-8da6-94ac7004b9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575317} {:answer/id #uuid "e5572e89-e95f-550c-955c-320f0b7a840a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+8\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575356}] :answer-field/correct {:answer/id #uuid "cfa7ffc1-052c-532e-8da6-94ac7004b9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186575317} :answer-field/id #uuid "1700a89d-2650-5aef-adea-d21bee253a61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd10b8fd-b17b-505d-be34-31b755b59a68" :question/math-academy-id "q-71655" :question/problem "$$\n\\displaystyle \\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x+C, \\\\ \\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x & =8\\int \\operatorname{sin}⁡x\\,\\text{d}x-\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =8(-\\operatorname{cos}⁡x)-\\operatorname{sin}⁡x+C \\\\  & =-8\\operatorname{cos}⁡x-\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aee2163-e8a4-5db3-b481-1e8dba213e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575077} {:answer/id #uuid "555c3bc4-aaa4-54ab-86d4-e690a6ee7f08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575098} {:answer/id #uuid "666f70a8-5246-59d5-a9a4-eb81a720cfdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575133} {:answer/id #uuid "936df478-a4cb-5ede-900f-165576785176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186575203} {:answer/id #uuid "c6b9b9b6-687d-58c6-a996-f8747f0bad9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡x\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186575302}] :answer-field/correct {:answer/id #uuid "4aee2163-e8a4-5db3-b481-1e8dba213e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186575077} :answer-field/id #uuid "c17c9630-513d-5b72-86de-468560e389b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575490}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7057d32-2563-5caa-9eb0-bb4367d4b45b" :question/math-academy-id "q-113919" :question/problem "$$\n\\displaystyle \\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\operatorname{sec}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =4\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =4\\operatorname{sec}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186578796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b4e062-ad59-5766-a138-f351f333cf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos x+3\\sin x" :db/id #edb/ref 17592186578363}] :answer-field/correct {:answer/id #uuid "39b4e062-ad59-5766-a138-f351f333cf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos x+3\\sin x" :db/id #edb/ref 17592186578363} :answer-field/id #uuid "dccf592a-07ff-571c-a6b2-42b304ad235f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578775}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10fbc4f9-a999-51b3-a93e-6600a9db62f1" :question/math-academy-id "q-167321" :question/problem "$$\n\\displaystyle \\int f(x)\\,\\text{d}x\\,=\n$${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C,\\,\\,\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int f(x)\\,\\text{d}x & =\\int (2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\,\\text{d}x \\\\  & =2\\int \\operatorname{sin}⁡x\\,\\text{d}x+3\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-2\\operatorname{cos}⁡x+3\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186578806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346}] :answer-field/correct {:answer/id #uuid "2f296ed5-5ee1-5373-8853-cd9b42ca5b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186578346} :answer-field/id #uuid "59299f55-f653-572d-af54-ffb8778f188f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578723}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "23f453dd-5391-598b-a2f5-caa9d74e0c57" :question/math-academy-id "q-167316" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡x-3\\operatorname{sin}⁡x)+(2\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡x+(3+2x)\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186580892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66ee4154-2c82-5f7c-a453-639a3c26e78e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186580557} {:answer/id #uuid "a4446db1-6811-56cb-83ad-f4290b765162" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186580661} {:answer/id #uuid "dc264dd9-aead-5752-b49e-de8c3a93172a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186580731} {:answer/id #uuid "e0766b7f-1b11-54db-a463-de8434f00db9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186580738} {:answer/id #uuid "ee1767e8-6b16-5f29-a9f2-9d13c262d7a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186580762}] :answer-field/correct {:answer/id #uuid "dc264dd9-aead-5752-b49e-de8c3a93172a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186580731} :answer-field/id #uuid "bfdb6ef3-805b-5c90-be75-327e320d6c71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580858}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24945ccb-291e-5b02-a82c-6983ca8e2098" :question/math-academy-id "q-27019" :question/problem "Which of the following statements are true?\n\nI. $\\operatorname{cos}⁡x=0$ for $$\n\\displaystyle x=\\pm \\frac{\\pi }{2},\\pm \\frac{3\\pi }{2},....\n$$\n\nII. $y=\\operatorname{cos}⁡x$ has a minimum value at $x=\\frac{7\\pi }{2}$, which is equal to $-1.$\n\nIII. The range of $y=\\operatorname{cos}⁡x$ is $[-1,1].$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{cos}⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement I is true. The zeros of the function $y=\\operatorname{cos}⁡x$ occur at $\\frac{\\pi }{2}+n\\pi$ for any integer $n.$\n\n- Statement II is false. $x=\\frac{7\\pi }{2}$ is a zero of the function.\n\n- Statement III is true. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186580899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd1d219-b857-5b5f-a779-302045da7712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186580408} {:answer/id #uuid "3ffe0c79-47de-5b14-88c0-6da61308e7b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186580494} {:answer/id #uuid "a2a27c37-36e7-5f80-87f2-d34f3be666ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186580660} {:answer/id #uuid "b8c7ebfd-c5dc-51d3-95b8-c30068e3aa83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186580684} {:answer/id #uuid "c39b7953-b317-5f0e-8c8a-8e4d700894fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186580693}] :answer-field/correct {:answer/id #uuid "a2a27c37-36e7-5f80-87f2-d34f3be666ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186580660} :answer-field/id #uuid "f73fd2d0-ce67-564f-8d0c-066bb7ff774e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580877}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3cfbb3ff-1787-5500-ba6b-0a0c378c7517" :question/math-academy-id "q-103227" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cos}⁡x?$ \n\nI. The function intersects the $x$-axis at $x=2\\pi$\n\nII. Its minimum value is $-1$\n\nIII. The function intersects the $y$-axis at $y=1$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{cos}⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement I is false since $\\operatorname{cos}⁡2\\pi =1\\ne 0.$\n\n- Statement II is true. Indeed, the minimum value of the function is $-1.$\n\n- Statement III is true. The function intersects the $y$-axis at $y=1.$"}] [{:db/id #edb/ref 17592186580929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128f2af3-d86a-521d-9b87-d08c1d096374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186580412} {:answer/id #uuid "280defab-bb0e-5467-9302-2304ccfe9c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}-2\\pi" :db/id #edb/ref 17592186580453} {:answer/id #uuid "e145844b-7979-5eb0-a240-56b9f9f42d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186580741} {:answer/id #uuid "e94091f4-18d7-5f6c-9b7f-e55c81c8c49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186580754} {:answer/id #uuid "ef19b835-2f51-52cc-a2f9-fc1904cea930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186580766}] :answer-field/correct {:answer/id #uuid "e94091f4-18d7-5f6c-9b7f-e55c81c8c49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186580754} :answer-field/id #uuid "d4c9d1da-6b89-5ab2-8c06-0bef819742ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580868}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "95cc69d7-bf4f-55ce-b10c-871c735fbc08" :question/math-academy-id "q-65178" :question/problem "If $\\operatorname{cos}⁡x=\\frac{\\sqrt{5}}{3},$ then $\\sqrt{5}\\operatorname{cos}⁡(x-2\\pi )-2=$" :question/worked-solution "The period of $y=\\operatorname{cos}⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\operatorname{cos}⁡x=\\operatorname{cos}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-1$ into the right-hand-side gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x &=\\operatorname{cos}⁡(x-2\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cos}⁡x=\\frac{\\sqrt{5}}{3},$ then $\\operatorname{cos}⁡(x-2\\pi )=\\frac{\\sqrt{5}}{3}.$\n\nFinally, then\n\n$$\n\\begin{aligned}\\sqrt{5}\\operatorname{cos}⁡(x-2\\pi )-2 & =\\sqrt{5}\\left(\\frac{\\sqrt{5}}{3}\\right)-2 \\\\  & =\\frac{{(\\sqrt{5})}^{2}}{3}-2 \\\\  & =\\frac{5}{3}-2 \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186580956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2153b638-5a48-5879-a797-f45755fef1c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186580438} {:answer/id #uuid "415f1c04-3325-5c6c-9e37-199d76af8270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186580496} {:answer/id #uuid "9d4862ee-2fd3-59d7-a815-add17575e836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186580652} {:answer/id #uuid "c795e8ee-d9cc-5b4e-9318-6c3d73a0a57c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186580698} {:answer/id #uuid "ccbf85bc-ebfa-5124-998d-be2debcef7d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186580708}] :answer-field/correct {:answer/id #uuid "2153b638-5a48-5879-a797-f45755fef1c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186580438} :answer-field/id #uuid "c1ed5084-2ed3-5f3c-8c8a-972f5c48d95c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580859}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9a2e847-6e9d-5334-8d47-3c2e8d9dab70" :question/math-academy-id "q-103219" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cos}⁡x?$ Assume that $n$ is an integer.\n\nI. The function reaches its minimum value at $x=2n\\pi$\n\nII. The zeros of the function are $x=\\frac{\\pi }{2}+n\\pi .$\n\nIII. The range of $y=\\operatorname{cos}⁡x$ is $[-1,0].$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{cos}⁡x.$\n\n![](images/04/04f13f2dec860874174f51990f4260615e7be893a6be5f86b3b13857c4e8953f.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function reaches its minimum value at $x=\\pi \\pm 2\\pi ,\\pi \\pm 4\\pi ,…,$ which can be written as $x=\\pi +2n\\pi .$\n\n- Statement II is true. The zeros occur at $$\n\\displaystyle x=\\pm \\frac{\\pi }{2},\\pm \\frac{3\\pi }{2},…,\n$$ which can be written as $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement III is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186581656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23134426-684d-55a9-88fb-591da81afa5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186581075} {:answer/id #uuid "3c7557df-0cc4-52d8-bfc6-396f7efac420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{12}" :db/id #edb/ref 17592186581129} {:answer/id #uuid "9e352b72-4265-5188-8985-f24c526554c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186581309} {:answer/id #uuid "adbe69eb-413a-5e0d-a7cb-e28e73259bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186581341} {:answer/id #uuid "eaa9fed7-77ec-5b09-9ba5-3ac0296e8390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581461}] :answer-field/correct {:answer/id #uuid "eaa9fed7-77ec-5b09-9ba5-3ac0296e8390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186581461} :answer-field/id #uuid "be0e325f-ad41-535c-99b9-6f5c7070e42e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581598}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2782ee42-d9a0-52a8-87ec-e12a588135de" :question/math-academy-id "q-30945" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\operatorname{ln}⁡5}\\frac{1}{6}{e}^{2x}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=2x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\operatorname{ln}⁡5$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡5}\\frac{1}{6}{e}^{2x}\\,\\text{d}x & =\\frac{1}{6}{\\int }_{0}^{\\operatorname{ln}⁡5}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{12}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{12}({e}^{u}){|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{12}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{12}\\cdot ({5}^{2}-1) \\\\  & =\\frac{24}{12} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0134e157-4f6f-5d29-be2d-28ffe387e8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{5x+2}}{5}+C" :db/id #edb/ref 17592186581013} {:answer/id #uuid "1408faec-5137-5ec3-a05e-24345552c783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25{e}^{5x+2}+C" :db/id #edb/ref 17592186581048} {:answer/id #uuid "29f6112a-8f0a-5e9d-b8bb-421f76008f24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{5x+2}}{5}+C" :db/id #edb/ref 17592186581087} {:answer/id #uuid "9a70219d-9c69-5bc0-b31a-d6bc576d0839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{5x+2}}{25}+C" :db/id #edb/ref 17592186581301} {:answer/id #uuid "cc37eeee-e711-5506-a2e0-4f90e3c5bca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5x+2}+C" :db/id #edb/ref 17592186581407}] :answer-field/correct {:answer/id #uuid "9a70219d-9c69-5bc0-b31a-d6bc576d0839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{5x+2}}{25}+C" :db/id #edb/ref 17592186581301} :answer-field/id #uuid "ebf4de2c-8f90-5760-8de4-f4d23f35e328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581625}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3236e6df-9e12-5603-961c-9cd302220a60" :question/math-academy-id "q-2193" :question/problem "$$\n\\displaystyle \\int \\frac{{e}^{5x+2}}{5}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=5x+2$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{e}^{5x+2}}{5}\\,\\text{d}x & =\\int \\frac{{e}^{u}}{5}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{25}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{25}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{5x+2}}{25}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2622e464-3dff-5477-8605-02e70bffa083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{52}{3\\ln 3}" :db/id #edb/ref 17592186581079}] :answer-field/correct {:answer/id #uuid "2622e464-3dff-5477-8605-02e70bffa083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{52}{3\\ln 3}" :db/id #edb/ref 17592186581079} :answer-field/id #uuid "bcd438ee-dce3-5d31-b12a-2590c896eb26" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581597}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7af4733f-66c2-5243-8fa1-4d5f71535cdf" :question/math-academy-id "q-349627" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{2}2\\cdot {3}^{6-3x}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "If we let $u=6-3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,-\\frac{1}{3}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $3$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}2\\cdot {3}^{6-3x}\\,\\text{d}x & ={\\int }_{3}^{0}2\\cdot {3}^{u}\\left(-\\frac{1}{3}\\right)\\text{d}u \\\\  & =-\\frac{2}{3}{\\int }_{3}^{0}{3}^{u}\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\left(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}\\right){|}_{3}^{0} \\\\  & =-\\frac{2}{3\\operatorname{ln}⁡3}({3}^{0}-{3}^{3}) \\\\  & =-\\frac{2}{3\\operatorname{ln}⁡3}(1-27) \\\\  & =\\frac{52}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425088a0-8b6d-555a-87b1-28f844922b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-\\frac{2}{x}" :db/id #edb/ref 17592186581142}] :answer-field/correct {:answer/id #uuid "425088a0-8b6d-555a-87b1-28f844922b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-\\frac{2}{x}" :db/id #edb/ref 17592186581142} :answer-field/id #uuid "6867512d-b53b-53db-a5a5-f341bd835d41" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581553}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8913b80e-2bcb-5364-9080-3c746725b920" :question/math-academy-id "q-167587" :question/problem "Given that $A=3$ and $B=2,$\n\n$$\n\\displaystyle \\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x=\n$$\n{{field-1}}\n$+\\,C.$" :question/worked-solution "We found that $A=3$ and $B=2$ in steps 2 and 3, respectively. Hence, $f(x)={x}^{3}+2x.$ \n\nUsing the sum and constant factor rules and our result from step 4, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{{x}^{3}}\\,\\text{d}x & =\\int \\frac{{x}^{3}+2x}{{x}^{3}}\\,\\text{d}x \\\\  & =\\int (1+\\frac{2}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int \\,\\text{d}x+\\int \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & =x-\\frac{2}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b8c5f3-6667-557e-b276-2a7a42b7356d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{4x+6}}{3\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186581052} {:answer/id #uuid "775dc83f-2af0-5494-a363-6e4d0fa58b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{4x+7}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186581234} {:answer/id #uuid "9408ac4b-b913-5bd4-bb24-9d969c04f563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{4x+5}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186581290} {:answer/id #uuid "a59ed773-9425-5e45-9c7f-0fb0800a8d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{4x+5}+C" :db/id #edb/ref 17592186581328} {:answer/id #uuid "f7485e0b-2d3f-5709-bd1a-685290431c6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{4x+6}+C" :db/id #edb/ref 17592186581486}] :answer-field/correct {:answer/id #uuid "775dc83f-2af0-5494-a363-6e4d0fa58b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{4x+7}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186581234} :answer-field/id #uuid "56ac4051-8029-50cc-8dd7-f8f51956a433" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581549}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ab431cfc-4325-5302-8b89-6fa6834a5030" :question/math-academy-id "q-73668" :question/problem "Calculate the integral $$\n\\displaystyle \\int 8\\cdot {2}^{4x+6}\\,\\text{d}x.\n$$" :question/worked-solution "Let's introduce the new variable $u=4x+6.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}u=4\\,\\text{d}x.\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\int 8\\cdot {2}^{4x+6}\\,\\text{d}x & =\\int 2\\cdot {2}^{4x+6}\\cdot 4\\,\\text{d}x \\\\  & =2\\int {2}^{u}\\,\\text{d}u \\\\  & =\\frac{2\\cdot {2}^{u}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{2\\cdot {2}^{4x+6}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{2}^{4x+7}}{\\operatorname{ln}⁡2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5601ad3f-07e0-5bda-92ae-64ef1e2e302f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186581175}] :answer-field/correct {:answer/id #uuid "5601ad3f-07e0-5bda-92ae-64ef1e2e302f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186581175} :answer-field/id #uuid "f32572e4-edff-584a-b1d1-9e096d52ad0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581634}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b3a518db-61a3-5b91-88c9-d775dbcff2db" :question/math-academy-id "q-346397" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\operatorname{ln}⁡3}3{e}^{4x}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "If we let $u=4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}3{e}^{4x}\\,\\text{d}x & =3{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{4x}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{4\\operatorname{ln}⁡3}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{3}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{4})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{4}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({3}^{4})} \\\\  & =\\frac{3}{4}({e}^{\\operatorname{ln}⁡({3}^{4})}-{e}^{0}) \\\\  & =\\frac{3}{4}({3}^{4}-1) \\\\  & =\\frac{3}{4}(81-1) \\\\  & =\\frac{3}{4}\\cdot 80 \\\\  & =60\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "234fbd64-3e71-5154-ba26-c33ca9ec6950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186581076}] :answer-field/correct {:answer/id #uuid "234fbd64-3e71-5154-ba26-c33ca9ec6950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186581076} :answer-field/id #uuid "32061a8c-5090-50ce-ba79-da5f40f5cbb1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581529} {:answer-field/choices [{:answer/id #uuid "f3aeab3b-a5ca-5a04-bcdb-bed224c74207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186581481}] :answer-field/correct {:answer/id #uuid "f3aeab3b-a5ca-5a04-bcdb-bed224c74207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186581481} :answer-field/id #uuid "727182ea-b0dc-5650-931f-1144963d2573" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581561} {:answer-field/choices [{:answer/id #uuid "eb6337cc-bf42-5a29-9bf5-2dc359f58d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186581467}] :answer-field/correct {:answer/id #uuid "eb6337cc-bf42-5a29-9bf5-2dc359f58d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186581467} :answer-field/id #uuid "9a9965c6-ca41-50a9-81f8-b456e5eca1c7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581581} {:answer-field/choices [{:answer/id #uuid "9315993c-5171-5b3f-94b3-42d7c3c23737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186581287}] :answer-field/correct {:answer/id #uuid "9315993c-5171-5b3f-94b3-42d7c3c23737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186581287} :answer-field/id #uuid "a2515abb-3b8d-5ba1-84a6-8154a443be88" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581585} {:answer-field/choices [{:answer/id #uuid "4afb0a0e-82c0-5586-856c-f6410ae81b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186581156}] :answer-field/correct {:answer/id #uuid "4afb0a0e-82c0-5586-856c-f6410ae81b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186581156} :answer-field/id #uuid "d76c56e7-b4cc-5cbe-a907-4b7404595cc6" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581611}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bac76f4a-4116-5fca-a94a-36ce5cbe8b54" :question/math-academy-id "q-167583" :question/problem "Complete the following facts about the function $y=\\operatorname{sin}⁡x.$\n\nThe domain of the function is $x\\in ($\n{{field-1}}\n$,$\n{{field-2}}\n$).$\n\nThe range of the function is $[$\n{{field-3}}\n$,$\n{{field-4}}\n$].$\n\nThe period of the function is\n{{field-5}}." :question/worked-solution "Let's plot the graph of $y=\\operatorname{sin}⁡x.$\n\n![](images/96/96bd60d23237f836b77a26c5c0461a5c2a474554f0a14266b53fc5e7d999f1b7.png)\n\nLet's go through each statement.\n\n* The domain of the function is $(-\\infty ,\\infty ).$\n\n* The minimum value is $-1,$ and the maximum value is $1.$ Therefore, the range is $[-1,1].$\n\n* The period of $\\operatorname{sin}⁡x$ is $2\\pi .$"}] [{:db/id #edb/ref 17592186581732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0b2fd43-76b1-520b-8885-257c74a76cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581316} {:answer/id #uuid "c69ce661-936b-50e6-a844-3548ae845666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581391} {:answer/id #uuid "d03068c2-b1e8-5a6e-9e33-1c7d33a7f96c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581414} {:answer/id #uuid "ec5b0540-6522-5291-88f0-a7cf4728b698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581471} {:answer/id #uuid "fa742624-8db8-591b-b4bc-1799172e7b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581494}] :answer-field/correct {:answer/id #uuid "d03068c2-b1e8-5a6e-9e33-1c7d33a7f96c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186581414} :answer-field/id #uuid "2480749c-7cb2-5d28-bd67-b89d3b9aa890" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581521}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5e8ba75-88fa-5048-ab75-1e503c4e8a87" :question/math-academy-id "q-30975" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{0}^{1}{2}^{-2x}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=-2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration,we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{2}^{-2x}\\,\\text{d}x & ={\\int }_{0}^{-2}{2}^{u}\\,\\left(-\\frac{1}{2}\\right)\\text{d}u \\\\  & =-\\frac{1}{2}{\\int }_{0}^{-2}{2}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\left(\\frac{{2}^{u}}{\\operatorname{ln}⁡2}\\right){|}_{0}^{-2} \\\\  & =-\\frac{1}{2\\operatorname{ln}⁡2}(\\frac{1}{4}-1) \\\\  & =\\frac{3}{8\\operatorname{ln}⁡2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186581747 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a8e2b9-040f-58ce-b647-7856dc2a5bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-\\frac{20}{e}" :db/id #edb/ref 17592186581080} {:answer/id #uuid "2a1bceda-02e7-4e26-899b-fc1df110d847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20\\left(\\frac{1}{e}-1\\right)" :db/id #edb/ref 17592186725801}] :answer-field/correct {:answer/id #uuid "26a8e2b9-040f-58ce-b647-7856dc2a5bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-\\frac{20}{e}" :db/id #edb/ref 17592186581080} :answer-field/id #uuid "3987d703-426c-529d-9e4f-c62b4c8efa11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186581533}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff0aa1c3-e701-5eaf-b09e-1f2042e0aa02" :question/math-academy-id "q-349604" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{4}5{e}^{-x/4}\\,\\text{d}x=\n$$  \n{{field-1}}" :question/worked-solution "If we let $u=-\\frac{x}{4},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{4}\\,⟹\\,-4\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}5{e}^{-x/4}\\,\\text{d}x & =5{\\int }_{0}^{4}{e}^{-x/4}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-1}{e}^{u}\\cdot (-4)\\,\\text{d}u \\\\  & =-20{\\int }_{0}^{-1}{e}^{u}\\,\\text{d}u \\\\  & =-20\\cdot {e}^{u}\\,{|}_{0}^{-1} \\\\  & =-20({e}^{-1}-{e}^{0}) \\\\  & =-20({e}^{-1}-1) \\\\  & =20-20{e}^{-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186583069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36967d5c-f7cc-542d-a243-47e99d9dd4c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cot t" :db/id #edb/ref 17592186582586}] :answer-field/correct {:answer/id #uuid "36967d5c-f7cc-542d-a243-47e99d9dd4c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cot t" :db/id #edb/ref 17592186582586} :answer-field/id #uuid "342af6ea-b868-5203-a1fc-48940e593573" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186582915}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a898657d-48bc-5582-9aad-7b9b3c7de1c9" :question/math-academy-id "q-167391" :question/problem "$$\n\\displaystyle \\int v(t)\\,\\text{d}t\\,\\,=\\,\n$${{field-1}} $+\\text{ }C$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡t\\,\\text{d}t=-\\operatorname{cot}⁡t+C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 3{csc}^{2}⁡t\\,\\text{d}t & =3\\int {csc}^{2}⁡t\\,\\text{d}t \\\\  & =3(-\\operatorname{cot}⁡t)+C \\\\  & =-3\\operatorname{cot}⁡t+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517}] :answer-field/correct {:answer/id #uuid "04e42ff3-44ae-54c1-9e29-1f70a48ccb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{\\frac{7}{6}}" :db/id #edb/ref 17592186584517} :answer-field/id #uuid "d2400e32-0626-57f4-aa86-36f297e53f28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585001}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94477f44-1be5-5969-98a4-26af9184571a" :question/math-academy-id "q-167646" :question/problem "The antiderivative of $\\sqrt[6]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[6]{x}={x}^{1/6}$, we can apply the power rule with $n=\\frac{1}{6}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/6}\\,\\text{d}x & =\\frac{{x}^{1/6+1}}{(\\frac{1}{6}+1)}+C \\\\  & =\\frac{{x}^{7/6}}{\\left(\\frac{7}{6}\\right)}+C \\\\  & =\\frac{6{x}^{7/6}}{7}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{7/6}}{7}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{6{x}^{7/6}}{7}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{6}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/6})+0 \\\\ &= \\frac{6}{7}\\cdot \\frac{7}{6}{x}^{7/6-1} \\\\ &= {x}^{1/6}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8db33716-add6-5f35-bf02-1d51985de66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{4}{x}" :db/id #edb/ref 17592186585431}] :answer-field/correct {:answer/id #uuid "8db33716-add6-5f35-bf02-1d51985de66c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{4}{x}" :db/id #edb/ref 17592186585431} :answer-field/id #uuid "095f41d4-028c-5d7c-986c-c74e9a83226f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585594}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "002408ea-9be6-53e5-9b20-0951e4cd4bad" :question/math-academy-id "q-167617" :question/problem "Given that $A=2$ and $B=4,$\n\n$$\n\\displaystyle \\int \\frac{f(x)}{{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}\n$+\\,C.$" :question/worked-solution "We found that $A=2$ and $B=4$ in steps 2 and 3, respectively. Hence, $f(x)=2{x}^{2}-4.$  \n\nUsing the sum and constant factor rules and our result from step 4, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{{x}^{2}}\\,\\text{d}x & =\\int \\frac{2{x}^{2}-4}{{x}^{2}}\\,\\text{d}x \\\\  & =\\int (2-\\frac{4}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int 2\\,\\text{d}x-\\int \\frac{4}{{x}^{2}}\\,\\text{d}x \\\\  & =2x+\\frac{4}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186585738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ab5cdca-189e-52b2-be54-a0503ca79375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186585397}] :answer-field/correct {:answer/id #uuid "7ab5cdca-189e-52b2-be54-a0503ca79375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186585397} :answer-field/id #uuid "26ba861f-b15d-52e9-8a84-3a7d609f4655" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585609} {:answer-field/choices [{:answer/id #uuid "417289e7-c73a-5143-86c0-e7e05ba57000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186585299}] :answer-field/correct {:answer/id #uuid "417289e7-c73a-5143-86c0-e7e05ba57000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186585299} :answer-field/id #uuid "35efb24a-9e94-5377-b7da-2b0ab09e50f5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585616} {:answer-field/choices [{:answer/id #uuid "2a7dc364-5a72-58cf-815e-4e86750bd04e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186585260}] :answer-field/correct {:answer/id #uuid "2a7dc364-5a72-58cf-815e-4e86750bd04e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186585260} :answer-field/id #uuid "55aa2ba0-d01d-5f53-89a6-8e83b2a3c1c6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585632} {:answer-field/choices [{:answer/id #uuid "af9c512a-03d5-54ac-b2a9-8c61ffa45614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186585482}] :answer-field/correct {:answer/id #uuid "af9c512a-03d5-54ac-b2a9-8c61ffa45614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186585482} :answer-field/id #uuid "6407632e-5356-5c51-949f-e505f5602aa1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585638} {:answer-field/choices [{:answer/id #uuid "2a5cb174-5766-5bd4-93bd-41748015067f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186585259}] :answer-field/correct {:answer/id #uuid "2a5cb174-5766-5bd4-93bd-41748015067f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186585259} :answer-field/id #uuid "80bbfc2a-a5e7-5f5d-a854-bfe10f2ea1cd" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186585644}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b74a3d3-c29e-513b-a913-e51860e5cc88" :question/math-academy-id "q-167613" :question/problem "Complete the following facts about the function $y=\\operatorname{cos}⁡x.$\n\nThe domain of the function is $x\\in ($\n{{field-1}}\n$,$\n{{field-2}}\n$).$\n\nThe range of the function is $[$\n{{field-3}}\n$,$\n{{field-4}}\n$].$\n\nThe period of the function is\n{{field-5}}." :question/worked-solution "Let's plot the graph of $y=\\operatorname{cos}⁡x.$ \n\n![](images/ce/cebd0527c2b8b3bcdf2948da0771103f17412ff058d74b96db1287a7046ba3bc.png)\n\nLet's go through each statement.\n\n* The domain of the function is $(-\\infty ,\\infty ).$\n\n* The minimum value is $-1,$ and the maximum value is $1.$ Therefore, the range is $[-1,1].$\n\n* The period of $\\operatorname{cos}⁡x$ is $2\\pi .$"}] [{:db/id #edb/ref 17592186586552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886}] :answer-field/correct {:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886} :answer-field/id #uuid "517709e9-f87f-51ef-86e5-3a7246853549" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186586429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4aaf1474-44f2-53a9-ae70-2c44030b9b58" :question/math-academy-id "q-311231" :question/problem "Given that $f(x)={3}^{x}\\operatorname{cos}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $-\\,{3}^{x}\\operatorname{sin}⁡(x)$" :question/worked-solution "Here, we have the product of two functions $u(x)={3}^{x}$ and $v(x)=\\operatorname{cos}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({3}^{x})}^{′}\\operatorname{cos}⁡(x)+{3}^{x}{(\\operatorname{cos}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))\\operatorname{cos}⁡(x)+{3}^{x}(-\\operatorname{sin}⁡(x)) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3)\\operatorname{cos}⁡(x)-{3}^{x}\\operatorname{sin}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186586560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c287098-fdb2-58e8-8342-956a1ff9deb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586034} {:answer/id #uuid "612c3980-83e9-5078-8f02-eb7e2291e335" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+\\frac{2{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586063} {:answer/id #uuid "81086a0e-a325-51b9-93a4-e249186b89b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586132} {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} {:answer/id #uuid "b967f191-c4fe-5e66-b7f6-f73c7faf9b66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+x{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586246}] :answer-field/correct {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} :answer-field/id #uuid "3c400dff-bed5-5d41-986f-72a99df176f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64d86353-289c-5c4c-a5f5-b6e2b66703e2" :question/math-academy-id "q-47954" :question/problem "Given that $f(x)=\\sqrt{x}{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\sqrt{x}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\sqrt{x})^{′}\\cdot {e}^{x}+\\sqrt{x}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}{e}^{x}+\\sqrt{x}{e}^{x} \\\\  & =\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186587304 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733}] :answer-field/correct {:answer/id #uuid "2202f6fe-b53b-5a2d-a1db-2533ed538332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}x^{\\frac{5}{4}}" :db/id #edb/ref 17592186586733} :answer-field/id #uuid "3d10d539-8c5e-514d-8877-3d19db95faab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186587183}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3efb6512-0e32-57d7-9bcc-102471dd5cbb" :question/math-academy-id "q-167541" :question/problem "The antiderivative of $\\sqrt[4]{x}$ equals{{field-1}} $+\\,\\text{ }C$" :question/worked-solution "Since $\\sqrt[4]{x}={x}^{1/4}$, we can apply the power rule with $n=\\frac{1}{4}$ and get\n\n$$\n\\begin{aligned}\\int {x}^{1/4}\\,\\text{d}x & =\\frac{{x}^{1/4+1}}{(\\frac{1}{4}+1)}+C \\\\  & =\\frac{{x}^{5/4}}{\\left(\\frac{5}{4}\\right)}+C \\\\  & =\\frac{4{x}^{5/4}}{5}+C.\\end{aligned}\n$$\n\nLet's check our answer by differentiating: \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{4{x}^{5/4}}{5}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{4{x}^{5/4}}{5}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{4}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5/4})+0 \\\\ &= \\frac{4}{5}\\cdot \\frac{5}{4}{x}^{5/4-1} \\\\ &= {x}^{1/4}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec04919-851c-5f1c-955b-e2ff97fdf5f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186591815} {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} {:answer/id #uuid "83672e87-80c5-5786-a4c9-02556e774a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186591969} {:answer/id #uuid "e4fef352-25c1-5611-b453-4c7c29fa7623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186592108} {:answer/id #uuid "e6683a70-94fb-5b5c-9555-12c8a50c3815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186592110}] :answer-field/correct {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} :answer-field/id #uuid "0de6d142-7706-50b2-ae89-6ca03ca1279e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1de59b11-3c24-56b4-ab0a-82d3c06932c8" :question/math-academy-id "q-69658" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-v & 5 \\\\ 4 & 3\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=4$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-v & 5 \\\\ 4 & 3\\end{vmatrix} \\\\  & =-v\\cdot 3-5\\cdot 4 \\\\  & =-3v-20\\end{aligned}\n$$\n\nSince $det(U)=4$, we get:\n\n$$\n\\begin{aligned}det(U) & =4 \\\\ -3v-20 & =4 \\\\ -3v & =4+20 \\\\ -3v & =24 \\\\ v & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035}] :answer-field/correct {:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035} :answer-field/id #uuid "2a53609f-6339-5056-99fc-1faddb53d517" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e824411-1e03-5958-a98d-c29104d4627e" :question/math-academy-id "q-317341" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix} & =7\\cdot 4-2\\cdot 5 \\\\  & =28-10 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816}] :answer-field/correct {:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816} :answer-field/id #uuid "b6df6735-8419-5b2f-a9d4-bfe1d4b061e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592211}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5711e1a6-e6b6-576f-bfa5-52e1edd7ede4" :question/math-academy-id "q-317369" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix} & =-\\sqrt{3}\\cdot 1-4\\cdot \\sqrt{3} \\\\  & =-\\sqrt{3}-4\\sqrt{3} \\\\  & =-5\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5220f649-c738-5122-9599-d9f859321690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186591903} {:answer/id #uuid "80de4d31-9aa8-5e7b-88f9-e0000d031070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186591965} {:answer/id #uuid "947a0df3-49f3-5c04-a318-f69823764ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186591993} {:answer/id #uuid "9f359a0a-cb67-582c-8d5f-8ac128bee997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186592008} {:answer/id #uuid "b209ffb8-293b-588e-a783-135c4e560ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592038}] :answer-field/correct {:answer/id #uuid "b209ffb8-293b-588e-a783-135c4e560ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186592038} :answer-field/id #uuid "8e0bfcb5-87e5-5485-85b2-fb6a1bc3e040" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592201}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d247b8c0-327a-5c2e-bca9-c1e451471450" :question/math-academy-id "q-1071" :question/problem "$$\n\\displaystyle \\begin{vmatrix}6 & 3 \\\\ 2 & 1\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}6 & 3 \\\\ 2 & 1\\end{vmatrix} & =6\\cdot 1-3\\cdot 2 \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186594690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eaf90b86-ed00-521f-866e-457741256953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{(t^2+3)^2}" :db/id #edb/ref 17592186594566}] :answer-field/correct {:answer/id #uuid "eaf90b86-ed00-521f-866e-457741256953" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{(t^2+3)^2}" :db/id #edb/ref 17592186594566} :answer-field/id #uuid "c3de83bc-b404-5457-8f8e-eb85acb80364" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594644}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6cc6368e-df43-5cbe-829c-1d64f41be4a6" :question/math-academy-id "q-132779" :question/problem "$$\n\\displaystyle \\int {y}^{′}(t)\\,\\text{d}t=\\operatorname{ln}⁡(\n$${{field-1}}\n$)+\\,K,$\nwhere $K$ is an arbitrary constant." :question/worked-solution "In part 9, we found that\n\n$$\n-4\\int \\frac{t}{{t}^{2}+3}\\,\\text{d}t=-2\\operatorname{ln}⁡({t}^{2}+3)+K.\n$$\n\nUsing the sum and constant multiple rules, we compute the sum of the integrals of each function in the partial sum decomposition of ${y}^{′}(t)$ found in part 8:\n\n$$\n\\begin{aligned}\\int {y}^{′}(t)\\,\\text{d}t & =\\int (\\frac{1}{t}-\\frac{4t}{{t}^{2}+1})\\text{d}t \\\\  & =\\int \\frac{1}{t}\\,\\text{d}t-4\\int \\frac{t}{{t}^{2}+3}\\,\\text{d}t \\\\  & =\\operatorname{ln}⁡|t|-2\\operatorname{ln}⁡({t}^{2}+3)+K \\\\  & =\\operatorname{ln}⁡t-\\operatorname{ln}⁡(({t}^{2}+3)^{2})+K \\\\  & =\\operatorname{ln}⁡\\left(\\frac{t}{({t}^{2}+3)^{2}}\\right)+K.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186600798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505}] :answer-field/correct {:answer/id #uuid "00cbe2c2-361c-57b8-8499-6c44bef9cd90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186600505} :answer-field/id #uuid "7de17562-4cb2-576c-b80a-4d58584f24da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "688015ab-7641-5f23-9a80-3af6a7102896" :question/math-academy-id "q-167769" :question/problem "If a curve $C$ is defined by the equation $y=x\\cdot f(x),$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. \n\nIn part 2 we found that $$\n\\displaystyle \\frac{\\text{d}f}{\\text{d}x}=2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x).\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}f}{\\text{d}x}+f\\frac{\\text{d}(x)}{\\text{d}x} \\\\  & =x\\cdot (2\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x))+(2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x))\\cdot 1 \\\\  & =(2-3x)\\operatorname{sin}⁡(x)+(3+2x)\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & =(2-3(0))\\operatorname{sin}⁡(0)+(3+2(0))\\operatorname{cos}⁡(0) \\\\  & =3\\operatorname{cos}⁡(0) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$"}] [{:db/id #edb/ref 17592186600812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45cc1cf2-6bac-53a9-a68f-ecaffa3cd79c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos(x)+3\\sin(x)" :db/id #edb/ref 17592186600560}] :answer-field/correct {:answer/id #uuid "45cc1cf2-6bac-53a9-a68f-ecaffa3cd79c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos(x)+3\\sin(x)" :db/id #edb/ref 17592186600560} :answer-field/id #uuid "e25874a5-683b-58ad-8929-54fab2cfeb57" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186600770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a83d34b6-a472-59a1-ac22-d2d920894fa3" :question/math-academy-id "q-167774" :question/problem "$$\n\\displaystyle \\int f(x)\\,\\text{d}x\\,=\n$${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x)+C,\\,\\,\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x)+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int f(x)\\,\\text{d}x & =\\int (2\\operatorname{sin}⁡(x)+3\\operatorname{cos}⁡(x))\\,\\text{d}x \\\\  & =2\\int \\operatorname{sin}⁡(x)\\,\\text{d}x+3\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-2\\operatorname{cos}⁡(x)+3\\operatorname{sin}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186601926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0cfd63a-4b5a-533e-a2be-e7bf4a561271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}}{(t^2+1)^{3/2}}" :db/id #edb/ref 17592186601770}] :answer-field/correct {:answer/id #uuid "d0cfd63a-4b5a-533e-a2be-e7bf4a561271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}}{(t^2+1)^{3/2}}" :db/id #edb/ref 17592186601770} :answer-field/id #uuid "e0fb97d3-41c9-50ca-834c-975b2638d484" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186601879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a588b6ca-ca51-5122-a816-0bdade4e8a44" :question/math-academy-id "q-133003" :question/problem "$$\n\\displaystyle \\int {y}^{′}(t)\\,\\text{d}t=\\operatorname{ln}⁡(\n$${{field-1}}\n$)+\\,K,$\nwhere $K$ is an arbitrary constant." :question/worked-solution "In part 9, we found that\n\n$$\n-3\\int \\frac{t}{{t}^{2}+1}\\,\\text{d}t=-\\frac{3}{2}\\operatorname{ln}⁡({t}^{2}+1)+K.\n$$\n\nUsing the sum and constant multiple rules, we compute the sum of the integrals of each function in the partial sum decomposition of ${y}^{′}(t)$ found in part 8:\n\n$$\n\\begin{aligned}\\int {y}^{′}(t)\\,\\text{d}t & =\\int (\\frac{1}{2t}-\\frac{3t}{{t}^{2}+1})\\text{d}t \\\\  & =\\frac{1}{2}\\int \\frac{1}{t}\\,\\text{d}t-3\\int \\frac{t}{{t}^{2}+1}\\,\\text{d}t \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|t|-\\frac{3}{2}\\operatorname{ln}⁡({t}^{2}+1)+K \\\\  & =\\operatorname{ln}⁡(\\sqrt{t})-\\operatorname{ln}⁡(\\sqrt{({t}^{2}+1)^{3}})+K \\\\  & =\\operatorname{ln}⁡\\left(\\frac{\\sqrt{t}}{\\sqrt{({t}^{2}+1)^{3}}}\\right)+K \\\\  & =\\operatorname{ln}⁡(\\sqrt{\\frac{t}{({t}^{2}+1)^{3}}})+K.\\end{aligned}\n$$"}]}
