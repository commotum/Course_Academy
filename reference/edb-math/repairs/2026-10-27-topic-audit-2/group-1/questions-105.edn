/checkbox} :db/id #edb/ref 17592186440159} {:answer-field/choices [{:answer/id #uuid "5d64fb74-88cb-53a7-a06c-3b70bb7f6274" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439605} {:answer/id #uuid "bec31bb0-4e5d-511d-afd5-742b83de0357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439606}] :answer-field/correct {:answer/id #uuid "bec31bb0-4e5d-511d-afd5-742b83de0357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439606} :answer-field/id #uuid "b87c1b9b-fab1-5cdf-bb7d-886d867b3796" :answer-field/key "The function is zero at $x = \\frac{3π}{2}$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440160} {:answer-field/choices [{:answer/id #uuid "f33342a6-71e7-55a1-88ba-63522644016c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439607} {:answer/id #uuid "b683d925-eb8f-5ed2-85c9-33a9d51ed2a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439608}] :answer-field/correct {:answer/id #uuid "f33342a6-71e7-55a1-88ba-63522644016c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439607} :answer-field/id #uuid "02f59618-0384-53ab-a17c-8912c7664860" :answer-field/key "The range of the function is $[- π, π]$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440161}] :question/id #uuid "3291f5a6-141c-577f-9e01-4f06e16f89ac" :question/math-academy-id "q-27015" :question/problem "Which of the following statements are true regarding the function $y = \\cos x$? Assume that $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Cosine attains its maxima at x=2n*pi, vanishes at x=3pi/2, and has range [-1,1]. Only statement “The function is zero at $x = \\frac{3π}{2}$” is true."}] [{:db/id #edb/ref 17592186176449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a428aa-620c-537b-bed4-6525636bfc6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439609} {:answer/id #uuid "a2bdaabe-318f-5a44-a993-5dc144a01cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439610}] :answer-field/correct {:answer/id #uuid "a2bdaabe-318f-5a44-a993-5dc144a01cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439610} :answer-field/id #uuid "c19eff62-0f3d-5e8b-8840-f4fa3fa30937" :answer-field/key "The zeros of the function are $x = \\frac{π}{2} + nπ$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440162} {:answer-field/choices [{:answer/id #uuid "9e122d41-3d05-51c1-8ec6-c73fbca7dcd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439611} {:answer/id #uuid "2ab71ce6-dc10-5b55-86c4-8863ebadb312" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439612}] :answer-field/correct {:answer/id #uuid "9e122d41-3d05-51c1-8ec6-c73fbca7dcd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439611} :answer-field/id #uuid "12845eb8-7a86-57fa-a87d-28447fbed3a1" :answer-field/key "The function has maximum values at $x = \\frac{3π}{2} + 2nπ$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440163} {:answer-field/choices [{:answer/id #uuid "c69287cc-e1d6-5913-b9fc-cfeb0e6876ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439613} {:answer/id #uuid "433b23fc-2e50-5918-ad8e-38d59e8d6077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439614}] :answer-field/correct {:answer/id #uuid "c69287cc-e1d6-5913-b9fc-cfeb0e6876ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439613} :answer-field/id #uuid "a99ea223-df14-549f-8f0a-56f14ff03cc4" :answer-field/key "The range of $y = \\cos x$ is $[- 1, 0]$." :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440164}] :question/id #uuid "4431905d-f46d-548a-987b-b6164fd2cc5d" :question/math-academy-id "q-27021" :question/problem "Which of the following statements are true regarding the function $y = \\cos x$? Assume that $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Cosine has zeros at x=pi/2+n*pi. At x=3pi/2+2n*pi it is zero, not maximal, and its range is [-1,1]. Only “The zeros of the function are $x = \\frac{π}{2} + nπ$” is true."}] [{:db/id #edb/ref 17592186176546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f28e6a-97ea-5e36-bf74-369bcac3c4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186175415} {:answer/id #uuid "9e88cd39-4060-5bbd-a35c-9862da2c6a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3} - 1" :db/id #edb/ref 17592186175416} {:answer/id #uuid "9fd05264-d89f-5106-8257-5d4ac26b1665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2} - 6" :db/id #edb/ref 17592186175417} {:answer/id #uuid "20110d5e-fbba-58e2-8b26-14f37290f7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2} + 1" :db/id #edb/ref 17592186175418} {:answer/id #uuid "778b3ce5-f938-535a-88ae-9093fb35824b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3} + 1" :db/id #edb/ref 17592186175419}] :answer-field/id #uuid "d12dd988-13f0-5a13-904a-161740f16df7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175414}] :question/id #uuid "5457cf58-f029-55a0-8895-b6f3142a17ea" :question/math-academy-id "q-65176" :question/problem "If $\\cos x = \\frac{\\sqrt{3}}{2}$, then $4\\cos (x - 6π) - 1 =$"}] [{:db/id #edb/ref 17592186176547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c52f2c48-4a46-5583-880d-822ccf44143f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186175421} {:answer/id #uuid "d42ec008-d1d7-561c-8465-0c98e443936f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3} - 1}{\\sqrt{3}}" :db/id #edb/ref 17592186175422} {:answer/id #uuid "2b789ccc-6318-5506-a401-752f09d593a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186175423} {:answer/id #uuid "3eb7a0b3-5252-598b-950a-bf9294626602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186175424} {:answer/id #uuid "4e529198-14f7-5289-a052-6ddc4948acc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186175425}] :answer-field/id #uuid "4c61285c-bf04-5039-ae4b-83ba17973aee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175420}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8cdc2927-1bb6-5eeb-9fd3-503bd87e51e6" :question/math-academy-id "q-65179" :question/problem "If $\\cos x =-\\frac{1}{\\sqrt{3}}$, then $\\cos (x + 10π) =$"}] [{:db/id #edb/ref 17592186179528 :question/id #uuid "0681419e-fc16-53ad-89b9-945fb616a391" :question/math-academy-id "e-6675" :question/problem "The half-life of bismuth-210 is $5.012$ days. How long does it take for a $1\\,280\\,\\textrm g$ sample of bismuth-210 to reduce to $5\\,\\textrm g?$" :question/worked-solution "The mass $M(t)$ of a radioactive substance at time $t$ can be modeled by the differential equation\n\n$$\nM'(t) = -kM(t), \\qquad M(0) = M_0.\n$$\n\nThe general solution to this equation is\n\n$$\nM(t) = M_0e^{-kt}.\n$$\n\nThe half-life $t_{1/2}$ is the time taken for the mass of the substance to reduce by one half and is given by\n\n$$\nt_{1/2} = \\dfrac{\\ln 2}{k}.\n$$\n\nThere are two methods that we can use to solve this problem. We describe each of them below.\n\n**Method 1**\n\nSince we know that $t_{1/2} = 5.012$ days we have\n\n$$\n5.012 = \\dfrac{\\ln 2}{k}\\quad\\Rightarrow\\quad k = \\dfrac{\\ln 2}{5.012}\n$$\n\nAlso, since $M_0 = 1\\,280\\,\\textrm g,$ we have the particular solution\n\n$$\nM(t) = 1\\,280 e^{-t\\ln 2/5.012}.\n$$\n\nWe wish to calculate the time $t$ such that $M(t) = 5\\,\\textrm g.$ So, we set up our equation as follows:\n\n$$\n5 = 1\\,280 e^{-t\\ln 2/5.012}\n$$\n\nSolving this equation for $t,$ we get\n\n$$\n\\begin{aligned}5 & =1\\,280{e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\frac{5}{1\\,280} & ={e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\frac{1}{256} & ={e}^{-t\\operatorname{ln}⁡2/5.012} \\\\ \\operatorname{ln}⁡\\left(\\frac{1}{256}\\right) & =\\operatorname{ln}⁡({e}^{-t\\operatorname{ln}⁡2/5.012}) \\\\ \\operatorname{ln}⁡1-\\operatorname{ln}⁡256 & =-\\frac{t\\operatorname{ln}⁡2}{5.012} \\\\ -\\operatorname{ln}⁡256 & =-\\frac{t\\operatorname{ln}⁡2}{5.012} \\\\ t & =\\frac{5.012\\cdot \\operatorname{ln}⁡256}{\\operatorname{ln}⁡2} \\\\ t & ≈40.\\end{aligned}\n$$\n\nTherefore, we conclude that it takes approximately $40$ days for the mass of the substance to reduce to $5\\,\\textrm g.$\n\n**Method 2**\n\nWe wish to calculate the time $t$ such that $M(t) = 5\\,\\textrm g.$ Notice that\n\n$$\n\\begin{aligned}\\frac{M(t)}{M(0)} & =\\frac{5\\,\\text{g}}{1\\,280\\,\\text{g}} \\\\  & =\\frac{1}{256} \\\\  & ={\\left(\\frac{1}{2}\\right)}^{8},\\end{aligned}\n$$\n\nor equivalently\n\n$$\nM(t) =  \\left(\\dfrac{1}{2}\\right)^8\\cdot M(0).\n$$\n\nFrom this equation, we see that $8$ half-lives must have occurred for the mass to reduce from $1\\,280\\,\\textrm g$ to $5\\,\\textrm g.$ Hence,\n\n$$\nt = 8\\cdot t_{1/2} =8 \\cdot 5.012 \\approx 40.\n$$\n\nTherefore, we conclude that it takes approximately $40$ days for the mass of the substance to reduce to $5\\,\\textrm g.$"}] [{:db/id #edb/ref 17592186179556 :question/id #uuid "67fa57e9-812f-54b7-b1d3-4d9e3fb99a1b" :question/math-academy-id "e-9373" :question/problem "At a geological site, an object is found with $65\\%$ of its original chlorine-36 content. Given that the half-life of chlorine-36 is $301$ thousand years, approximately how old is the object?" :question/worked-solution "The mass $M(t)$ of a radioactive substance at time $t$ can be modeled by the differential equation\n\n$$\nM'(t) = -kM(t), \\qquad M(0) = M_0.\n$$\n\nThe general solution to this equation is\n\n$$\nM(t) = M_0e^{-kt}.\n$$\n\nThe half-life $t_{1/2}$ is the time taken for the mass of the substance to reduce by one half and is given by\n\n$$\nt_{1/2} = \\dfrac{\\ln 2}{k}.\n$$\n\nSince we know that $t_{1/2} = 301$ thousand years, we have\n\n$$\n301 = \\dfrac{\\ln 2}{k}\\quad\\Rightarrow\\quad k = \\dfrac{\\ln 2}{301}.\n$$\n\nSo, we have\n\n$$\nM(t) = M_0 e^{-t\\ln 2/301}.\n$$\n\nWe wish to calculate the time $t$ such that $M(t) = 0.65 M_0.$ So, we set up our equation as follows:\n\n$$\n0.65M_0 = M_0 e^{-t\\ln 2/301}\n$$\n\nSolving this equation for $t,$ we get\n\n$$\n\\begin{aligned}0.65{M}_{0} & ={M}_{0}{e}^{-t\\operatorname{ln}⁡2/301} \\\\ 0.65\\cancel{{M}_{0}} & =\\cancel{{M}_{0}}{e}^{-t\\operatorname{ln}⁡2/301} \\\\ 0.65 & ={e}^{-t\\operatorname{ln}⁡2/301} \\\\ \\operatorname{ln}⁡(0.65) & =\\operatorname{ln}⁡({e}^{-t\\operatorname{ln}⁡2/301}) \\\\ \\operatorname{ln}⁡(0.65) & =-\\frac{t\\operatorname{ln}⁡2}{301} \\\\ t & =-\\frac{301\\cdot \\operatorname{ln}⁡(0.65)}{\\operatorname{ln}⁡2} \\\\ t & ≈187.\\end{aligned}\n$$\n\nTherefore, we conclude that the object is approximately $187$ thousand years old."}] [{:db/id #edb/ref 17592186179557 :question/id #uuid "adf49e6f-28cc-55b4-9a46-3acc34fa6c6f" :question/math-academy-id "e-9374" :question/problem "The mass $M(t),$ in grams, of a sample of iron-60 is given by\n\n$$\nM(t) = 100 e^{-kt},\n$$\n\nwhere $t$ is the time, in millions of years. The half-life of iron-60 is $2.6$ million years. Rounded to three significant figures, what is the value of $k?$" :question/worked-solution "The mass $M(t)$ of a radioactive substance at time $t$ can be modeled by the differential equation\n\n$$\nM'(t) = -kM(t), \\qquad M(0) = M_0.\n$$\n\nThe general solution to this equation is\n\n$$\nM(t) = M_0e^{-kt}.\n$$\n\nThe half-life $t_{1/2}$ is the time taken for the mass of the substance to reduce by one half and is given by\n\n$$\nt_{1/2} = \\dfrac{\\ln 2}{k}.\n$$\n\nSince we know that $t_{1/2} = 2.6$ million years, we have\n\n$$\n2.6 = \\dfrac{\\ln 2}{k}\\quad\\Rightarrow\\quad k = \\dfrac{\\ln 2}{2.6} \\approx 0.267.\n$$"}] [{:db/id #edb/ref 17592186179925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92389420-ec45-5c14-8810-5d4ef2945a06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.3s" :db/id #edb/ref 17592186177220} {:answer/id #uuid "c346af33-d86a-598f-9d22-5000e802d55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.4s" :db/id #edb/ref 1759