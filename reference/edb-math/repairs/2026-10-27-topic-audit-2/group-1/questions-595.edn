#{[{:db/id #edb/ref 17592186530627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b43ac8-f505-57b1-9bb9-eab1a99683a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 4 x - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530584} {:answer/id #uuid "58953184-510b-5d8a-bf25-093931935708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 4 x - 2\\right) \\left(\\tan{\\left(x \\right)} + 4\\right) + \\left(- 2 x^{2} - 2 x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530608} {:answer/id #uuid "88c197b9-1af8-5550-9830-84789185a002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 4 x - 2\\right) \\left(\\tan{\\left(x \\right)} + 4\\right)" :db/id #edb/ref 17592186530620} {:answer/id #uuid "d736437a-c00f-55ea-b764-3b117b6eb55c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 2 x^{2} - 2 x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530637} {:answer/id #uuid "f322be5c-4030-5005-8d2e-91cf78f9922d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 4 x - 2\\right) \\left(\\tan{\\left(x \\right)} + 4\\right) - \\left(- 2 x^{2} - 2 x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530648}] :answer-field/correct {:answer/id #uuid "58953184-510b-5d8a-bf25-093931935708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 4 x - 2\\right) \\left(\\tan{\\left(x \\right)} + 4\\right) + \\left(- 2 x^{2} - 2 x\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530608} :answer-field/id #uuid "9a2dc616-6a44-5748-bb89-bacbee62fb1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530625}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a77347a8-80b9-5bce-883a-cdfb18cc9a3f" :question/problem "Differentiate $(- 2 x^{2} - 2 x)(\\tan{\\left(x \\right)} + 4).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=- 2 x^{2} - 2 x$ and $v(x)=\\tan{\\left(x \\right)} + 4.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((- 2 x^{2} - 2 x)(\\tan{\\left(x \\right)} + 4))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(- 2 x^{2} - 2 x)'\\cdot (\\tan{\\left(x \\right)} + 4)+(- 2 x^{2} - 2 x)\\cdot (\\tan{\\left(x \\right)} + 4)' \\\\ & =(- 4 x - 2)(\\tan{\\left(x \\right)} + 4)+(- 2 x^{2} - 2 x)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =- 2 x^{2} \\tan^{2}{\\left(x \\right)} - 2 x^{2} - 2 x \\tan^{2}{\\left(x \\right)} - 4 x \\tan{\\left(x \\right)} - 18 x - 2 \\tan{\\left(x \\right)} - 8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46b45ffa-eccb-54d0-a02a-4fbd0b129cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)}" :db/id #edb/ref 17592186530602} {:answer/id #uuid "d980e549-091a-5015-8b0e-d624b7f03f90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} + \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530638} {:answer/id #uuid "dca57a40-855e-5d5c-a548-c9e44f1eff72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} - \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530639} {:answer/id #uuid "ddf3d812-a10d-5ec4-9438-aaed83e97f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530640} {:answer/id #uuid "e90489fd-6700-5f5a-92a2-b8c32b183c48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 x \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530644}] :answer-field/correct {:answer/id #uuid "d980e549-091a-5015-8b0e-d624b7f03f90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6 x \\sin{\\left(x \\right)} + \\left(3 x^{2} - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530638} :answer-field/id #uuid "642f7201-cb46-5bcf-997b-745a8f3e0236" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530613}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9ff3c61-ade3-53cb-bb8e-71f5650e1f69" :question/problem "Differentiate $(3 x^{2} - 2)(\\sin{\\left(x \\right)}).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=3 x^{2} - 2$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((3 x^{2} - 2)(\\sin{\\left(x \\right)}))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(3 x^{2} - 2)'\\cdot (\\sin{\\left(x \\right)})+(3 x^{2} - 2)\\cdot (\\sin{\\left(x \\right)})' \\\\ & =(6 x)(\\sin{\\left(x \\right)})+(3 x^{2} - 2)(\\cos{\\left(x \\right)}) \\\\ & =3 x^{2} \\cos{\\left(x \\right)} + 6 x \\sin{\\left(x \\right)} - 2 \\cos{\\left(x \\right)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3d46da-e92d-5698-a861-712bac0c6ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} + \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530590} {:answer/id #uuid "3632c38a-4cd9-5c2f-805d-07c3cde69f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)}" :db/id #edb/ref 17592186530595} {:answer/id #uuid "409f7463-ac7f-5d70-951f-2793322a406e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530597} {:answer/id #uuid "50e38daf-8b87-563b-9e30-c41d9d3c72b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530604} {:answer/id #uuid "731608e7-ebe2-5d8c-b2eb-aae031222ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} - \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530617}] :answer-field/correct {:answer/id #uuid "1e3d46da-e92d-5698-a861-712bac0c6ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 4 x \\tan{\\left(x \\right)} + \\left(- 2 x^{2} - 2\\right) \\left(\\tan^{2}{\\left(x \\right)} + 1\\right)" :db/id #edb/ref 17592186530590} :answer-field/id #uuid "1f592693-d1f1-511c-927a-500d252b11b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530591}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e0089896-05d5-55f1-8924-df3c13fcf733" :question/problem "Differentiate $(- 2 x^{2} - 2)(\\tan{\\left(x \\right)}).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=- 2 x^{2} - 2$ and $v(x)=\\tan{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((- 2 x^{2} - 2)(\\tan{\\left(x \\right)}))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(- 2 x^{2} - 2)'\\cdot (\\tan{\\left(x \\right)})+(- 2 x^{2} - 2)\\cdot (\\tan{\\left(x \\right)})' \\\\ & =(- 4 x)(\\tan{\\left(x \\right)})+(- 2 x^{2} - 2)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =- 2 x^{2} \\tan^{2}{\\left(x \\right)} - 2 x^{2} - 4 x \\tan{\\left(x \\right)} - 2 \\tan^{2}{\\left(x \\right)} - 2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19711b50-8807-59b7-acdb-8970429b0ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186533199} {:answer/id #uuid "81206fce-7990-5565-942e-8da7f37d692c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186533447} {:answer/id #uuid "8439ad9e-77a8-5942-943a-193cf7502f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186533449} {:answer/id #uuid "86ce9780-060e-5652-a984-02fffec1697a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186533458} {:answer/id #uuid "afc268a2-7c3e-5206-99f6-7894f6937564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186533563}] :answer-field/correct {:answer/id #uuid "afc268a2-7c3e-5206-99f6-7894f6937564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186533563} :answer-field/id #uuid "a12eb56b-c05a-51d2-a8e2-2e399e71b0cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533902}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4ad2c176-6641-542e-87e9-2e557825f205" :question/math-academy-id "q-129344" :question/problem "$$\n\\lim_{x\\to (7,-2)}\\frac{\\sqrt{2x-y}-4}{16-2x+y}=\n$$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (7,-2)}\\frac{\\sqrt{2x-y}-4}{16-2x+y} & =\\frac{\\sqrt{2(7)-(-2)}-4}{16-2(7)+(-2)} \\\\  & =\\frac{4-4}{16-14-2} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (7,-2)}\\frac{\\sqrt{2x-y}-4}{16-2x+y} & =\\lim_{x\\to (7,-2)}\\frac{(\\sqrt{2x-y}-4)(\\sqrt{2x-y}+4)}{(16-2x+y)(\\sqrt{2x-y}+4)} \\\\  & =\\lim_{x\\to (7,-2)}\\frac{2x-y-16}{(16-2x+y)(\\sqrt{2x-y}+4)} \\\\  & =-\\lim_{x\\to (7,-2)}\\frac{16-2x+y}{(16-2x+y)(\\sqrt{2x-y}+4)} \\\\  & =-\\lim_{x\\to (7,-2)}\\frac{\\cancel{16-2x+y}}{\\cancel{(16-2x+y)}(\\sqrt{2x-y}+4)} \\\\  & =-\\lim_{x\\to (7,-2)}\\frac{1}{\\sqrt{2x-y}+4}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}-\\lim_{x\\to (7,-2)}\\frac{1}{\\sqrt{2x-y}+4} & =-\\frac{1}{\\sqrt{2(7)-(-2)}+4} \\\\  & =-\\frac{1}{\\sqrt{16}+4} \\\\  & =-\\frac{1}{4+4} \\\\  & =-\\frac{1}{8}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-\\frac{1}{8}.$"}] [{:db/id #edb/ref 17592186536061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086}] :answer-field/correct {:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086} :answer-field/id #uuid "1461180d-25fe-52b1-abad-c2120615be94" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536066}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "025970ae-87f8-5c12-8836-70b62439e2c5" :question/problem "If a curve $C$ is given by $y=(3 x^{2} + x - 1)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 x^{2} + x - 1$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=6 x + 1,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 x^{2} + x - 1)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (6 x + 1) \\\\ &=\\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} + x \\ln{\\left(x \\right)} + x - 1}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(3 (e^{2})^{2} + (e^{2}) - 1)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (6 (e^{2}) + 1) \\\\ &=(-1 + e^{2} + 3 e^{4})\\cdot (e^{-2})+(2)\\cdot (1 + 6 e^{2}) \\\\ &=- \\frac{1}{e^{2}} + 3 + 15 e^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{e^{2}} + 3 + 15 e^{2}.$"}] [{:db/id #edb/ref 17592186536065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87e3eb-6bcd-53ef-bb03-fc2a22a36834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186536064} {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} {:answer/id #uuid "4a8deab9-18c9-5ebc-98e6-8435b3c93cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186536078} {:answer/id #uuid "84823475-39f2-5b99-8473-e23495b0e21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536085} {:answer/id #uuid "d1b1968b-bd0a-5181-accb-526b08866904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536095}] :answer-field/correct {:answer/id #uuid "3bb39653-f774-5bc6-95ff-0532ba097430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186536073} :answer-field/id #uuid "4c5e91f8-c020-5cd4-ab84-1fac365579b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536079}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11508a06-1238-59d6-9f30-ce054ca95db7" :question/problem "If a curve $C$ is given by $y=(4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(4 e^{x})\\cdot (1)+(x + 1)\\cdot (4 e^{x}) \\\\ &=4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (4 e^{(0)}) \\\\ &=(4)\\cdot (1)+(1)\\cdot (4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $8.$"}] [{:db/id #edb/ref 17592186536069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068}] :answer-field/correct {:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068} :answer-field/id #uuid "a3c99e80-1859-5501-94e2-065df60ee30c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536092}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "33ab5b35-dd61-5afa-9e50-76ac2177002e" :question/problem "If a curve $C$ is given by $y=(- x^{2} - x - 1)\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - x - 1$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 1,\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - x - 1)\\cdot (\\cos{\\left(x \\right)})+(\\sin{\\left(x \\right)})\\cdot (- 2 x - 1) \\\\ &=- x^{2} \\cos{\\left(x \\right)} - 2 x \\sin{\\left(x \\right)} - x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=(- \\left(\\frac{\\pi}{4}\\right)^{2} - \\left(\\frac{\\pi}{4}\\right) - 1)\\cdot (\\cos{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})+(\\sin{\\left(\\left(\\frac{\\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{\\pi}{4}\\right) - 1) \\\\ &=(-1 - \\frac{\\pi}{4} - \\frac{\\pi^{2}}{16})\\cdot \\left(\\frac{\\sqrt{2}}{2}\\right)+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{\\pi}{2} - 1) \\\\ &=\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.$"}] [{:db/id #edb/ref 17592186536071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f58f4a6-0b44-5f88-9b25-552d8955a459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186536084} {:answer/id #uuid "9067e445-c243-5b05-b2ab-57c52adbf2ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186536088} {:answer/id #uuid "b52782fc-00de-55d6-a076-2f209848a815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186536093} {:answer/id #uuid "c791b538-1274-505c-a9e0-ab9ebe95ebd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186536094} {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097}] :answer-field/correct {:answer/id #uuid "e8f0fd20-ea84-5728-a09c-b8667bf436f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186536097} :answer-field/id #uuid "3ecdcf0c-044d-52db-b4c4-2ebdf6a193cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3897814a-55c8-55e3-8f23-2d1a17edc389" :question/problem "If a curve $C$ is given by $y=(- e^{x})\\cdot (x + 3)$, calculate the slope of the tangent line to the curve at the point where $x=0$." :question/worked-solution "We differentiate using the product rule. Let $u(x)=- e^{x}$ and $v(x)=x + 3.$ Then, we have\n\n$$\nu'(x)=- e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- e^{x})\\cdot (1)+(x + 3)\\cdot (- e^{x}) \\\\ &=- \\left(x + 4\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- e^{(0)})\\cdot (1)+((0) + 3)\\cdot (- e^{(0)}) \\\\ &=(-1)\\cdot (1)+(3)\\cdot (-1) \\\\ &=-4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-4.$"}] [{:db/id #edb/ref 17592186536074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062}] :answer-field/correct {:answer/id #uuid "0abdf3e2-3942-5519-a3a0-98c8ba14955a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186536062} :answer-field/id #uuid "77d6b1af-8fd9-5dcc-9877-1ef7732a91ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536083}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3be093e9-a88a-5893-84f7-f2f4d4e8fb03" :question/problem "If a curve $C$ is given by $y=(- 4 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 4 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 4 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 4 e^{x})\\cdot (1)+(x + 1)\\cdot (- 4 e^{x}) \\\\ &=- 4 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 4 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 4 e^{(0)}) \\\\ &=(-4)\\cdot (1)+(1)\\cdot (-4) \\\\ &=-8.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-8.$"}] [{:db/id #edb/ref 17592186536075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081}] :answer-field/correct {:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081} :answer-field/id #uuid "718082e0-417d-5acb-ab28-41d32f8d52ce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536082}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3cc06495-0e47-5717-9700-118ad0cf690b" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 2 x + 2)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 2 x + 2$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 2,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 2 x + 2)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (- 2 x - 2) \\\\ &=- \\frac{2 x^{2} \\ln{\\left(x \\right)} + x^{2} + 2 x \\ln{\\left(x \\right)} + 2 x - 2}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(- (e^{2})^{2} - 2 (e^{2}) + 2)\\cdot \\left(\\frac{1}{(e^{2})}\\right)+(\\ln{\\left((e^{2}) \\right)})\\cdot (- 2 (e^{2}) - 2) \\\\ &=(- e^{4} - 2 e^{2} + 2)\\cdot (e^{-2})+(2)\\cdot (- 2 e^{2} - 2) \\\\ &=- 5 e^{2} - 6 + \\frac{2}{e^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 5 e^{2} - 6 + \\frac{2}{e^{2}}.$"}] [{:db/id #edb/ref 17592186536077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091}] :answer-field/correct {:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091} :answer-field/id #uuid "354f12c4-c49c-5ce8-9d56-4a6bfbb09230" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536070}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "45e8eff6-7be8-5e2f-8927-eac30ddd0bc6" :question/problem "If a curve $C$ is given by $y=(- 3 x^{2} + 3 x - 4)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 x^{2} + 3 x - 4$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=3 - 6 x,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 x^{2} + 3 x - 4)\\cdot \\left(\\frac{1}{x}\\right)+(\\ln{\\left(x \\right)})\\cdot (3 - 6 x) \\\\ &=- \\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} - 3 x \\ln{\\left(x \\right)} - 3 x + 4}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e} &=(- 3 (e)^{2} + 3 (e) - 4)\\cdot \\left(\\frac{1}{(e)}\\right)+(\\ln{\\left((e) \\right)})\\cdot (3 - 6 (e)) \\\\ &=(- 3 e^{2} - 4 + 3 e)\\cdot (e^{-1})+(1)\\cdot (3 - 6 e) \\\\ &=- 9 e - \\frac{4}{e} + 6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 9 e - \\frac{4}{e} + 6.$"}] [{:db/id #edb/ref 17592186536087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063}] :answer-field/correct {:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063} :answer-field/id #uuid "1d6f8461-59dd-570a-8790-4ee15ed4552d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536067}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "89a63571-dce9-5ef0-8359-7d12fffc0179" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 3 x - 4)\\cdot (\\cos{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 3 x - 4$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 3,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 3 x - 4)\\cdot (- \\sin{\\left(x \\right)})+(\\cos{\\left(x \\right)})\\cdot (- 2 x - 3) \\\\ &=x^{2} \\sin{\\left(x \\right)} + 3 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=(- \\left(\\frac{3 \\pi}{4}\\right)^{2} - 3 \\left(\\frac{3 \\pi}{4}\\right) - 4)\\cdot (- \\sin{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})+(\\cos{\\left(\\left(\\frac{3 \\pi}{4}\\right) \\right)})\\cdot (- 2 \\left(\\frac{3 \\pi}{4}\\right) - 3) \\\\ &=(- \\frac{9 \\pi}{4} - \\frac{9 \\pi^{2}}{16} - 4)\\cdot \\left(- \\frac{\\sqrt{2}}{2}\\right)+\\left(- \\frac{\\sqrt{2}}{2}\\right)\\cdot (- \\frac{3 \\pi}{2} - 3) \\\\ &=\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.$"}] [{:db/id #edb/ref 17592186536090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072}] :answer-field/correct {:answer/id #uuid "396109d2-9a78-5ec7-8f4c-daf147bbb5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186536072} :answer-field/id #uuid "923746ba-42ca-56b6-8ff7-9429d9c12883" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536089}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92e053cc-163c-5fb4-9084-c721d7a398e6" :question/problem "If a curve $C$ is given by $y=(3 e^{x})\\cdot (x + 2)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 e^{x}$ and $v(x)=x + 2.$ Then, we have\n\n$$\nu'(x)=3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 e^{x})\\cdot (1)+(x + 2)\\cdot (3 e^{x}) \\\\ &=3 \\left(x + 3\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(3 e^{(0)})\\cdot (1)+((0) + 2)\\cdot (3 e^{(0)}) \\\\ &=(3)\\cdot (1)+(2)\\cdot (3) \\\\ &=9.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $9.$"}] [{:db/id #edb/ref 17592186536098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096}] :answer-field/correct {:answer/id #uuid "dbaa2ade-3a9e-5286-83c0-581f6b0d6602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186536096} :answer-field/id #uuid "50a33319-8a25-53ef-8f2f-91c0f3e572b9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536080}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fad32388-6506-515e-9fd4-68888763cf2f" :question/problem "If a curve $C$ is given by $y=(- 3 e^{x})\\cdot (x + 1)$, calculate the slope of the tangent line to the curve at the point where $x=0$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 e^{x}$ and $v(x)=x + 1.$ Then, we have\n\n$$\nu'(x)=- 3 e^{x},\\quad v'(x)=1.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 e^{x})\\cdot (1)+(x + 1)\\cdot (- 3 e^{x}) \\\\ &=- 3 \\left(x + 2\\right) e^{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=0} &=(- 3 e^{(0)})\\cdot (1)+((0) + 1)\\cdot (- 3 e^{(0)}) \\\\ &=(-3)\\cdot (1)+(1)\\cdot (-3) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-6.$"}] [{:db/id #edb/ref 17592186539398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b62b53-1b76-5884-8cf6-e623e6a2f279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.3\\,\\text{lb}" :db/id #edb/ref 17592186539394} {:answer/id #uuid "1d6d3790-da14-581b-85b9-f63924341cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.8\\,\\text{lb}" :db/id #edb/ref 17592186539400} {:answer/id #uuid "49ad23b9-5753-5821-bf10-fcf46d63b245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.9\\,\\text{lb}" :db/id #edb/ref 17592186539414} {:answer/id #uuid "4e0087ee-6487-5333-81b9-0c1398c381ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.6\\,\\text{lb}" :db/id #edb/ref 17592186539416} {:answer/id #uuid "8e62ca35-4a8a-52bf-a4f8-7c4ea42efb76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90.0\\,\\text{lb}" :db/id #edb/ref 17592186539433}] :answer-field/correct {:answer/id #uuid "1d6d3790-da14-581b-85b9-f63924341cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "89.8\\,\\text{lb}" :db/id #edb/ref 17592186539400} :answer-field/id #uuid "b807e3c0-f519-5770-bffe-d3aeea20ea64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539442}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a0728d4-a0d3-515f-805e-eb1a7d3c019c" :question/problem "A disinfectant reservoir in a water treatment facility can hold up to $180\\,\\text{gal}$ of liquid. Initially, it contains $60\\,\\text{gal}$ of disinfectant solution with $10\\,\\text{lb}$ of dissolved disinfectant. A more concentrated solution with concentration $0.5\\,\\text{lb/gal}$ flows into the reservoir at a rate of $25\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $20\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of disinfectant in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of disinfectant in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which disinfectant enters the reservoir minus the rate at which disinfectant leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which disinfectant enters the reservoir.\n\nFirst, note that a solution containing $0.5\\,\\text{lb/gal}$ of disinfectant enters the reservoir at a rate of $25\\,\\text{gal/min}.$ So, the rate at which the *disinfectant* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (25\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (25\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =12.5\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which disinfectant exits the reservoir.\n\nTo find the rate at which disinfectant leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $60\\,\\text{gal}$ of solution; solution enters at $25\\,\\text{gal/min}$ and mixed solution leaves at $20\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=60+25t-20t=5(12+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of disinfectant in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{5(12+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $20\\,\\text{gal/min},$ *disinfectant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(20\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{5(12+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(20\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{5(12+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{20Q}{5(12+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{4Q}{12+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =12.5-\\frac{4Q}{12+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{4}{12+t}\\,Q=12.5.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 4/(12+t)\\,dt} \\\\  & ={e}^{4\\operatorname{ln}⁡|12+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(12+t)^{4}} \\\\  & =(12+t)^{4}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(12+t)^{4}$ yields\n\n$$\n\\begin{aligned}(12+t)^{4}\\cdot (\\frac{dQ}{dt}+\\frac{4}{12+t}\\,Q) & =(12+t)^{4}\\cdot 12.5 \\\\ (12+t)^{4}\\frac{dQ}{dt}+4(12+t)^{3}Q & =12.5(12+t)^{4} \\\\ \\frac{d}{dt}(Q(12+t)^{4}) & =12.5(12+t)^{4}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(12+t)^{4})\\,dt & =\\int 12.5(12+t)^{4}\\,dt \\\\ Q(12+t)^{4} & =12.5\\cdot \\frac{1}{5}(12+t)^{5}+C \\\\ Q(t) & =2.5(12+t)+\\frac{C}{(12+t)^{4}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $10\\,\\text{lb}$ of disinfectant. So, we can apply the initial condition $Q(0)=10,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =10 \\\\ 2.5(12+0)+\\frac{C}{(12+0)^{4}} & =10 \\\\ 30+\\frac{C}{(12)^{4}} & =10 \\\\ \\frac{C}{{12}^{4}} & =-20 \\\\ C & =-20(12)^{4}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =2.5(12+t)-\\frac{20(12)^{4}}{(12+t)^{4}} \\\\  & =2.5(12+t)-20{\\left(\\frac{12}{12+t}\\right)}^{4}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $180\\,\\text{gal},$ so we can use the condition $V({t}_{o})=180$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =180 \\\\ 60+25{t}_{o}-20{t}_{o} & =180 \\\\ 60+5{t}_{o} & =180 \\\\ 5{t}_{o} & =120 \\\\ {t}_{o} & =24\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of disinfectant in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(24) & =2.5(12+24)-20{\\left(\\frac{12}{12+24}\\right)}^{4} \\\\  & =90-20{\\left(\\frac{12}{36}\\right)}^{4} \\\\  & ≈89.8\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3544b068-279b-57e6-9f38-0c9eaa23d33f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "235.5\\,\\text{lb}" :db/id #edb/ref 17592186539406} {:answer/id #uuid "69907d51-3bf1-5b65-bbb2-ae831146ccb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "222.2\\,\\text{lb}" :db/id #edb/ref 17592186539422} {:answer/id #uuid "872c8957-d06f-5407-86a5-616dbaa82761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "117.7\\,\\text{lb}" :db/id #edb/ref 17592186539430} {:answer/id #uuid "d8fcf795-dfb5-51ba-9ea4-76d781abc0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "246.4\\,\\text{lb}" :db/id #edb/ref 17592186539450} {:answer/id #uuid "e82e736f-6d11-5a2d-83f2-a27bd4f7db0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "294.4\\,\\text{lb}" :db/id #edb/ref 17592186539454}] :answer-field/correct {:answer/id #uuid "3544b068-279b-57e6-9f38-0c9eaa23d33f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "235.5\\,\\text{lb}" :db/id #edb/ref 17592186539406} :answer-field/id #uuid "4f10b853-d565-5f3f-8bc1-e376bfffca18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539417}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "21bb65fc-94da-5d56-9b2a-2fe8f762fdb9" :question/problem "A disinfectant reservoir in a water treatment facility can hold up to $368\\,\\text{gal}$ of liquid. Initially, it contains $300\\,\\text{gal}$ of disinfectant solution with $160\\,\\text{lb}$ of dissolved disinfectant. A more concentrated solution with concentration $0.8\\,\\text{lb/gal}$ flows into the reservoir at a rate of $20\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $12\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of disinfectant in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of disinfectant in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which disinfectant enters the reservoir minus the rate at which disinfectant leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which disinfectant enters the reservoir.\n\nFirst, note that a solution containing $0.8\\,\\text{lb/gal}$ of disinfectant enters the reservoir at a rate of $20\\,\\text{gal/min}.$ So, the rate at which the *disinfectant* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.8\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (20\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.8\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (20\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =16\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which disinfectant exits the reservoir.\n\nTo find the rate at which disinfectant leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $300\\,\\text{gal}$ of solution; solution enters at $20\\,\\text{gal/min}$ and mixed solution leaves at $12\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=300+20t-12t=8(37.5+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of disinfectant in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{8(37.5+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $12\\,\\text{gal/min},$ *disinfectant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{8(37.5+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{8(37.5+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{12Q}{8(37.5+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{1.5Q}{37.5+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =16-\\frac{1.5Q}{37.5+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1.5}{37.5+t}\\,Q=16.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 1.5/(37.5+t)\\,dt} \\\\  & ={e}^{1.5\\operatorname{ln}⁡|37.5+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(37.5+t)^{1.5}} \\\\  & =(37.5+t)^{1.5}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(37.5+t)^{1.5}$ yields\n\n$$\n\\begin{aligned}(37.5+t)^{1.5}\\cdot (\\frac{dQ}{dt}+\\frac{1.5}{37.5+t}\\,Q) & =(37.5+t)^{1.5}\\cdot 16 \\\\ (37.5+t)^{1.5}\\frac{dQ}{dt}+1.5(37.5+t)^{0.5}Q & =16(37.5+t)^{1.5} \\\\ \\frac{d}{dt}(Q(37.5+t)^{1.5}) & =16(37.5+t)^{1.5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(37.5+t)^{1.5})\\,dt & =\\int 16(37.5+t)^{1.5}\\,dt \\\\ Q(37.5+t)^{1.5} & =16\\cdot \\frac{1}{2.5}(37.5+t)^{2.5}+C \\\\ Q(t) & =6.4(37.5+t)+\\frac{C}{(37.5+t)^{1.5}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $160\\,\\text{lb}$ of disinfectant. So, we can apply the initial condition $Q(0)=160,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =160 \\\\ 6.4(37.5+0)+\\frac{C}{(37.5+0)^{1.5}} & =160 \\\\ 240+\\frac{C}{(37.5)^{1.5}} & =160 \\\\ \\frac{C}{{37.5}^{1.5}} & =-80 \\\\ C & =-80(37.5)^{1.5}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =6.4(37.5+t)-\\frac{80(37.5)^{1.5}}{(37.5+t)^{1.5}} \\\\  & =6.4(37.5+t)-80{\\left(\\frac{37.5}{37.5+t}\\right)}^{1.5}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $368\\,\\text{gal},$ so we can use the condition $V({t}_{o})=368$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =368 \\\\ 300+20{t}_{o}-12{t}_{o} & =368 \\\\ 300+8{t}_{o} & =368 \\\\ 8{t}_{o} & =68 \\\\ {t}_{o} & =8.5\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of disinfectant in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(8.5) & =6.4(37.5+8.5)-80{\\left(\\frac{37.5}{37.5+8.5}\\right)}^{1.5} \\\\  & =294.4-80{\\left(\\frac{37.5}{46}\\right)}^{1.5} \\\\  & ≈235.5\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09aa09e5-f47d-5621-9398-dc8978b0d87a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "316.3\\,\\text{lb}" :db/id #edb/ref 17592186539393} {:answer/id #uuid "3c471766-6b4e-5806-89be-2166ca930256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "328.0\\,\\text{lb}" :db/id #edb/ref 17592186539409} {:answer/id #uuid "89c88c07-7e92-5645-a2bb-e6beb66e7182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "301.0\\,\\text{lb}" :db/id #edb/ref 17592186539431} {:answer/id #uuid "b9a76597-8ded-5bde-a591-93a2815617ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "287.6\\,\\text{lb}" :db/id #edb/ref 17592186539443} {:answer/id #uuid "d57c8381-a0fe-5352-bcb4-fdc5674d137c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "265.7\\,\\text{lb}" :db/id #edb/ref 17592186539448}] :answer-field/correct {:answer/id #uuid "89c88c07-7e92-5645-a2bb-e6beb66e7182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "301.0\\,\\text{lb}" :db/id #edb/ref 17592186539431} :answer-field/id #uuid "b68e3566-38f2-5496-a173-8df05cbc7a77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539441}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3a39de0b-a8fb-57f4-97a8-3f35b38b481a" :question/problem "A saline reservoir for a medical research lab can hold up to $492\\,\\text{gal}$ of solution. Initially, it contains $213\\,\\text{gal}$ of saline solution with $\\frac{142}{3}\\,\\text{lb}$ of dissolved salt. A more concentrated saline solution with concentration $\\frac{2}{3}\\,\\text{lb/gal}$ flows into the reservoir at a rate of $15\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $9\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of salt in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of salt in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the reservoir minus the rate at which salt leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the reservoir.\n\nFirst, note that a solution containing $\\frac{2}{3}\\,\\text{lb/gal}$ of salt enters the reservoir at a rate of $15\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(\\frac{2}{3}\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (15\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(\\frac{2}{3}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (15\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =10\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the reservoir.\n\nTo find the rate at which salt leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $213\\,\\text{gal}$ of solution; solution enters at $15\\,\\text{gal/min}$ and mixed solution leaves at $9\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=213+15t-9t=6(35.5+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of salt in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{6(35.5+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $9\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(9\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{6(35.5+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(9\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{6(35.5+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{9Q}{6(35.5+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{1.5Q}{35.5+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =10-\\frac{1.5Q}{35.5+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1.5}{35.5+t}\\,Q=10.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 1.5/(35.5+t)\\,dt} \\\\  & ={e}^{1.5\\operatorname{ln}⁡|35.5+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(35.5+t)^{1.5}} \\\\  & =(35.5+t)^{1.5}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(35.5+t)^{1.5}$ yields\n\n$$\n\\begin{aligned}(35.5+t)^{1.5}\\cdot (\\frac{dQ}{dt}+\\frac{1.5}{35.5+t}\\,Q) & =(35.5+t)^{1.5}\\cdot 10 \\\\ (35.5+t)^{1.5}\\frac{dQ}{dt}+1.5(35.5+t)^{0.5}Q & =10(35.5+t)^{1.5} \\\\ \\frac{d}{dt}(Q(35.5+t)^{1.5}) & =10(35.5+t)^{1.5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(35.5+t)^{1.5})\\,dt & =\\int 10(35.5+t)^{1.5}\\,dt \\\\ Q(35.5+t)^{1.5} & =10\\cdot \\frac{1}{2.5}(35.5+t)^{2.5}+C \\\\ Q(t) & =4(35.5+t)+\\frac{C}{(35.5+t)^{1.5}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $\\frac{142}{3}\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=\\frac{142}{3},$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =\\frac{142}{3} \\\\ 4(35.5+0)+\\frac{C}{(35.5+0)^{1.5}} & =\\frac{142}{3} \\\\ 142+\\frac{C}{(35.5)^{1.5}} & =\\frac{142}{3} \\\\ \\frac{C}{(35.5)^{1.5}} & =-\\frac{284}{3} \\\\ C & =-\\frac{284}{3}(35.5)^{1.5}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =4(35.5+t)-\\frac{\\frac{284}{3}(35.5)^{1.5}}{(35.5+t)^{1.5}} \\\\  & =4(35.5+t)-\\frac{284}{3}{\\left(\\frac{35.5}{35.5+t}\\right)}^{1.5}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $492\\,\\text{gal},$ so we can use the condition $V({t}_{o})=492$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =492 \\\\ 213+15{t}_{o}-9{t}_{o} & =492 \\\\ 213+6{t}_{o} & =492 \\\\ 6{t}_{o} & =279 \\\\ {t}_{o} & =46.5\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of salt in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(46.5) & =4(35.5+46.5)-\\frac{284}{3}{\\left(\\frac{35.5}{35.5+46.5}\\right)}^{1.5} \\\\  & =328-\\frac{284}{3}{\\left(\\frac{35.5}{82}\\right)}^{1.5} \\\\  & ≈301.0\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42b4b74e-a664-52ce-a195-21a3d605fb31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.0\\,\\text{lb}" :db/id #edb/ref 17592186539411} {:answer/id #uuid "71401fcb-b5f8-5b4c-8bf5-f003372af32c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.0\\,\\text{lb}" :db/id #edb/ref 17592186539424} {:answer/id #uuid "989c22ac-092f-5f6b-a7b9-e236e2ba3d64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.7\\,\\text{lb}" :db/id #edb/ref 17592186539434} {:answer/id #uuid "a796dcf6-c12a-5697-9493-d0728388bc96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38.1\\,\\text{lb}" :db/id #edb/ref 17592186539437} {:answer/id #uuid "cf523ecc-0427-56f9-a3d5-e87e43240325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.2\\,\\text{lb}" :db/id #edb/ref 17592186539447}] :answer-field/correct {:answer/id #uuid "cf523ecc-0427-56f9-a3d5-e87e43240325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "39.2\\,\\text{lb}" :db/id #edb/ref 17592186539447} :answer-field/id #uuid "22f5cfc2-660c-58a7-af4f-432fa13dacdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539402}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6991e06d-da9f-57bf-8c9b-3cc0e133e514" :question/problem "A dye mixing tank at a textile factory can hold up to $80\\,\\text{gal}$ of liquid. Initially, it contains $32\\,\\text{gal}$ of solution with $4\\,\\text{lb}$ of dissolved dye. A more concentrated dye solution with concentration $0.5\\,\\text{lb/gal}$ flows into the tank at a rate of $8\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $6\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of dye in the tank at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that a solution containing $0.5\\,\\text{lb/gal}$ of dye enters the tank at a rate of $8\\,\\text{gal/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (8\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (8\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =4\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nTo find the rate at which dye leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $32\\,\\text{gal}$ of liquid; solution enters at $8\\,\\text{gal/min}$ and mixed solution leaves at $6\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=32+8t-6t=2(16+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of dye in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{2(16+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $6\\,\\text{gal/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(6\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{2(16+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(6\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{2(16+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{6Q}{2(16+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{3Q}{16+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =4-\\frac{3Q}{16+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{3}{16+t}\\,Q=4.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 3/(16+t)\\,dt} \\\\  & ={e}^{3\\operatorname{ln}⁡|16+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(16+t)^{3}} \\\\  & =(16+t)^{3}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(16+t)^{3}$ yields\n\n$$\n\\begin{aligned}(16+t)^{3}\\cdot (\\frac{dQ}{dt}+\\frac{3}{16+t}\\,Q) & =(16+t)^{3}\\cdot 4 \\\\ (16+t)^{3}\\frac{dQ}{dt}+3(16+t)^{2}Q & =4(16+t)^{3} \\\\ \\frac{d}{dt}(Q(16+t)^{3}) & =4(16+t)^{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(16+t)^{3})\\,dt & =\\int 4(16+t)^{3}\\,dt \\\\ Q(16+t)^{3} & =4\\cdot \\frac{1}{4}(16+t)^{4}+C \\\\ Q(t) & =1(16+t)+\\frac{C}{(16+t)^{3}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $4\\,\\text{lb}$ of dye. So, we can apply the initial condition $Q(0)=4,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =4 \\\\ 1(16+0)+\\frac{C}{(16+0)^{3}} & =4 \\\\ 16+\\frac{C}{(16)^{3}} & =4 \\\\ \\frac{C}{(16)^{3}} & =-12 \\\\ C & =-12(16)^{3}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =1(16+t)-\\frac{12(16)^{3}}{(16+t)^{3}} \\\\  & =1(16+t)-12{\\left(\\frac{16}{16+t}\\right)}^{3}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $80\\,\\text{gal},$ so we can use the condition $V({t}_{o})=80$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =80 \\\\ 32+8{t}_{o}-6{t}_{o} & =80 \\\\ 32+2{t}_{o} & =80 \\\\ 2{t}_{o} & =48 \\\\ {t}_{o} & =24\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of dye in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(24) & =1(16+24)-12{\\left(\\frac{16}{16+24}\\right)}^{3} \\\\  & =40-12{\\left(\\frac{16}{40}\\right)}^{3} \\\\  & ≈39.2\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1accc569-7a13-58f0-bb4e-fe4d837666e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30.5\\,\\text{lb}" :db/id #edb/ref 17592186539399} {:answer/id #uuid "4c421d3c-a021-523f-b9ba-63f0c8410839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21.5\\,\\text{lb}" :db/id #edb/ref 17592186539415} {:answer/id #uuid "b2e8af6d-9653-5a1a-9535-1b2052824104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33.1\\,\\text{lb}" :db/id #edb/ref 17592186539440} {:answer/id #uuid "d8aad8df-e1a6-5036-96dc-1c9eea79d2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.0\\,\\text{lb}" :db/id #edb/ref 17592186539449} {:answer/id #uuid "e4ac5ae2-38a9-5b58-b64a-b2b42879cc90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37.8\\,\\text{lb}" :db/id #edb/ref 17592186539452}] :answer-field/correct {:answer/id #uuid "b2e8af6d-9653-5a1a-9535-1b2052824104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33.1\\,\\text{lb}" :db/id #edb/ref 17592186539440} :answer-field/id #uuid "b03249a1-4a5a-5426-a9d8-a51d09a0bcc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539439}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7375207b-1d18-5bc8-88aa-4e960cad1491" :question/problem "A dye mixing tank at a textile factory can hold up to $82\\,\\text{gal}$ of liquid. Initially, it contains $33\\,\\text{gal}$ of solution with $\\frac{33}{8}\\,\\text{lb}$ of dissolved dye. A more concentrated dye solution with concentration $0.5\\,\\text{lb/gal}$ flows into the tank at a rate of $3\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $1\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of dye in the tank at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that a solution containing $0.5\\,\\text{lb/gal}$ of dye enters the tank at a rate of $3\\,\\text{gal/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (3\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (3\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =1.5\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nTo find the rate at which dye leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $33\\,\\text{gal}$ of liquid; solution enters at $3\\,\\text{gal/min}$ and mixed solution leaves at $1\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=33+3t-1t=2(16.5+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of dye in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{2(16.5+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $1\\,\\text{gal/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(1\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{2(16.5+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(1\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{2(16.5+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{1Q}{2(16.5+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{0.5Q}{16.5+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =1.5-\\frac{0.5Q}{16.5+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{0.5}{16.5+t}\\,Q=1.5.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 0.5/(16.5+t)\\,dt} \\\\  & ={e}^{0.5\\operatorname{ln}⁡|16.5+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(16.5+t)^{0.5}} \\\\  & =(16.5+t)^{0.5}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(16.5+t)^{0.5}$ yields\n\n$$\n\\begin{aligned}(16.5+t)^{0.5}\\cdot (\\frac{dQ}{dt}+\\frac{0.5}{16.5+t}\\,Q) & =(16.5+t)^{0.5}\\cdot 1.5 \\\\ (16.5+t)^{0.5}\\frac{dQ}{dt}+0.5(16.5+t)^{-0.5}Q & =1.5(16.5+t)^{0.5} \\\\ \\frac{d}{dt}(Q(16.5+t)^{0.5}) & =1.5(16.5+t)^{0.5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(16.5+t)^{0.5})\\,dt & =\\int 1.5(16.5+t)^{0.5}\\,dt \\\\ Q(16.5+t)^{0.5} & =1.5\\cdot \\frac{1}{1.5}(16.5+t)^{1.5}+C \\\\ Q(t) & =1(16.5+t)+\\frac{C}{(16.5+t)^{0.5}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $\\frac{33}{8}\\,\\text{lb}$ of dye. So, we can apply the initial condition $Q(0)=\\frac{33}{8},$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =\\frac{33}{8} \\\\ 1(16.5+0)+\\frac{C}{(16.5+0)^{0.5}} & =\\frac{33}{8} \\\\ 16.5+\\frac{C}{(16.5)^{0.5}} & =\\frac{33}{8} \\\\ \\frac{C}{(16.5)^{0.5}} & =-\\frac{99}{8} \\\\ C & =-\\frac{99}{8}(16.5)^{0.5}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =1(16.5+t)-\\frac{\\frac{99}{8}(16.5)^{0.5}}{(16.5+t)^{0.5}} \\\\  & =1(16.5+t)-\\frac{99}{8}{\\left(\\frac{16.5}{16.5+t}\\right)}^{0.5}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $82\\,\\text{gal},$ so we can use the condition $V({t}_{o})=82$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =82 \\\\ 33+3{t}_{o}-1{t}_{o} & =82 \\\\ 33+2{t}_{o} & =82 \\\\ 2{t}_{o} & =49 \\\\ {t}_{o} & =24.5\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of dye in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(24.5) & =1(16.5+24.5)-\\frac{99}{8}{\\left(\\frac{16.5}{16.5+24.5}\\right)}^{0.5} \\\\  & =41-\\frac{99}{8}{\\left(\\frac{16.5}{41}\\right)}^{0.5} \\\\  & ≈33.1\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19329e8b-f3ba-516f-af71-d4b1d311b395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "233.0\\,\\text{lb}" :db/id #edb/ref 17592186539396} {:answer/id #uuid "3ebc62f3-c951-51bd-a0c0-b13a63587c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "193.6\\,\\text{lb}" :db/id #edb/ref 17592186539410} {:answer/id #uuid "8e496fc1-51c0-50fa-b05e-7b8545cfbf6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243.2\\,\\text{lb}" :db/id #edb/ref 17592186539432} {:answer/id #uuid "ec958c6a-8b57-50b9-9e6f-b329672750e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "220.7\\,\\text{lb}" :db/id #edb/ref 17592186539455} {:answer/id #uuid "fed2300e-a029-550d-98c0-c43563de994e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "209.4\\,\\text{lb}" :db/id #edb/ref 17592186539461}] :answer-field/correct {:answer/id #uuid "ec958c6a-8b57-50b9-9e6f-b329672750e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "220.7\\,\\text{lb}" :db/id #edb/ref 17592186539455} :answer-field/id #uuid "36a6811d-be8c-5fac-8293-80fb147bef39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539407}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a7b8493b-92bf-5e7a-80a8-38bdcc3f94e7" :question/problem "A nutrient tank for a hydroponic greenhouse can hold up to $608gal$ of solution. Initially, it contains $276gal$ of nutrient solution with $36.8lb$ of dissolved nutrient. A more concentrated solution with concentration $0.4lb/gal$ flows into the tank at a rate of $20gal/min$, while the completely mixed solution drains out at a rate of $12gal/min$. Rounded to one decimal place, find the amount of nutrient in the tank at the moment it begins to overflow.\n\n> A scientific calculator is required to answer this question." :question/retired true :question/worked-solution "Since $Q$ is the amount of nutrient in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which nutrient enters the tank minus the rate at which nutrient leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which nutrient enters the tank.\n\nFirst, note that a solution containing $0.4\\,\\text{lb/gal}$ of nutrient enters the tank at a rate of $20\\,\\text{gal/min}.$ So, the rate at which the *nutrient* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.4\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (20\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.4\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (20\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =8\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which nutrient exits the tank.\n\nTo find the rate at which nutrient leaves the tank, we must first determine the volume of solution in the tank at time $t.$\n\nThe tank initially contains $276\\,\\text{gal}$ of solution; solution enters at $20\\,\\text{gal/min}$ and mixed solution leaves at $12\\,\\text{gal/min}.$\nAs a result, the amount of solution in the tank after $t$ minutes is \n\n$$\nV(t)=276+20t-12t=8(34.5+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of nutrient in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{8(34.5+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $12\\,\\text{gal/min},$ *nutrient* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{8(34.5+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{8(34.5+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{12Q}{8(34.5+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{1.5Q}{34.5+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =8-\\frac{1.5Q}{34.5+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{1.5}{34.5+t}\\,Q=8.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 1.5/(34.5+t)\\,dt} \\\\  & ={e}^{1.5\\operatorname{ln}⁡|34.5+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(34.5+t)^{1.5}} \\\\  & =(34.5+t)^{1.5}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(34.5+t)^{1.5}$ yields\n\n$$\n\\begin{aligned}(34.5+t)^{1.5}\\cdot (\\frac{dQ}{dt}+\\frac{1.5}{34.5+t}\\,Q) & =(34.5+t)^{1.5}\\cdot 8 \\\\ (34.5+t)^{1.5}\\frac{dQ}{dt}+1.5(34.5+t)^{0.5}Q & =8(34.5+t)^{1.5} \\\\ \\frac{d}{dt}(Q(34.5+t)^{1.5}) & =8(34.5+t)^{1.5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(34.5+t)^{1.5})\\,dt & =\\int 8(34.5+t)^{1.5}\\,dt \\\\ Q(34.5+t)^{1.5} & =8\\cdot \\frac{1}{2.5}(34.5+t)^{2.5}+C \\\\ Q(t) & =3.2(34.5+t)+\\frac{C}{(34.5+t)^{1.5}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $36.8\\,\\text{lb}$ of nutrient. So, we can apply the initial condition $Q(0)=36.8,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =36.8 \\\\ 3.2(34.5+0)+\\frac{C}{(34.5+0)^{1.5}} & =36.8 \\\\ 110.4+\\frac{C}{(34.5)^{1.5}} & =36.8 \\\\ \\frac{C}{(34.5)^{1.5}} & =-73.6 \\\\ C & =-73.6(34.5)^{1.5}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =3.2(34.5+t)-\\frac{73.6(34.5)^{1.5}}{(34.5+t)^{1.5}} \\\\  & =3.2(34.5+t)-73.6{\\left(\\frac{34.5}{34.5+t}\\right)}^{1.5}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $608\\,\\text{gal},$ so we can use the condition $V({t}_{o})=608$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =608 \\\\ 276+20{t}_{o}-12{t}_{o} & =608 \\\\ 276+8{t}_{o} & =608 \\\\ 8{t}_{o} & =332 \\\\ {t}_{o} & =41.5\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of nutrient in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(41.5) & =3.2(34.5+41.5)-73.6{\\left(\\frac{34.5}{34.5+41.5}\\right)}^{1.5} \\\\  & =243.2-73.6{\\left(\\frac{34.5}{76}\\right)}^{1.5} \\\\  & ≈220.7\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195e6da9-9d93-5a3f-abbd-e60df2db40ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "288.9\\,\\text{lb}" :db/id #edb/ref 17592186539397} {:answer/id #uuid "3070ff1a-7364-514c-8463-27955639a9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "287.0\\,\\text{lb}" :db/id #edb/ref 17592186539404} {:answer/id #uuid "c36c1a8a-ce2f-5284-b361-d99daa4298d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "290.0\\,\\text{lb}" :db/id #edb/ref 17592186539445} {:answer/id #uuid "c7bef1a7-bd82-52c0-a027-9770a4051e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "289.6\\,\\text{lb}" :db/id #edb/ref 17592186539446} {:answer/id #uuid "f2f09433-dc8c-51ad-bba5-d5f7876a82dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "287.7\\,\\text{lb}" :db/id #edb/ref 17592186539458}] :answer-field/correct {:answer/id #uuid "195e6da9-9d93-5a3f-abbd-e60df2db40ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "288.9\\,\\text{lb}" :db/id #edb/ref 17592186539397} :answer-field/id #uuid "86cc63e8-6dde-540e-9e8a-53412c30e26f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539429}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd6eb638-b03a-52f5-961d-00f47eebd890" :question/problem "A saline reservoir for a medical research lab can hold up to $290\\,\\text{gal}$ of solution. Initially, it contains $110\\,\\text{gal}$ of saline solution with $55\\,\\text{lb}$ of dissolved salt. A more concentrated saline solution with concentration $1.0\\,\\text{lb/gal}$ flows into the reservoir at a rate of $25\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $20\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of salt in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of salt in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the reservoir minus the rate at which salt leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the reservoir.\n\nFirst, note that a solution containing $1.0\\,\\text{lb/gal}$ of salt enters the reservoir at a rate of $25\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(1.0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (25\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(1.0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (25\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =25\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the reservoir.\n\nTo find the rate at which salt leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $110\\,\\text{gal}$ of solution; solution enters at $25\\,\\text{gal/min}$ and mixed solution leaves at $20\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=110+25t-20t=5(22+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of salt in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{5(22+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $20\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(20\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{5(22+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(20\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{5(22+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{20Q}{5(22+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{4Q}{22+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =25-\\frac{4Q}{22+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{4}{22+t}\\,Q=25.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 4/(22+t)\\,dt} \\\\  & ={e}^{4\\operatorname{ln}⁡|22+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(22+t)^{4}} \\\\  & =(22+t)^{4}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(22+t)^{4}$ yields\n\n$$\n\\begin{aligned}(22+t)^{4}\\cdot (\\frac{dQ}{dt}+\\frac{4}{22+t}\\,Q) & =(22+t)^{4}\\cdot 25 \\\\ (22+t)^{4}\\frac{dQ}{dt}+4(22+t)^{3}Q & =25(22+t)^{4} \\\\ \\frac{d}{dt}(Q(22+t)^{4}) & =25(22+t)^{4}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(22+t)^{4})\\,dt & =\\int 25(22+t)^{4}\\,dt \\\\ Q(22+t)^{4} & =25\\cdot \\frac{1}{5}(22+t)^{5}+C \\\\ Q(t) & =5(22+t)+\\frac{C}{(22+t)^{4}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $55\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=55,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =55 \\\\ 5(22+0)+\\frac{C}{(22+0)^{4}} & =55 \\\\ 110+\\frac{C}{(22)^{4}} & =55 \\\\ \\frac{C}{(22)^{4}} & =-55 \\\\ C & =-55(22)^{4}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =5(22+t)-\\frac{55(22)^{4}}{(22+t)^{4}} \\\\  & =5(22+t)-55{\\left(\\frac{22}{22+t}\\right)}^{4}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $290\\,\\text{gal},$ so we can use the condition $V({t}_{o})=290$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =290 \\\\ 110+25{t}_{o}-20{t}_{o} & =290 \\\\ 110+5{t}_{o} & =290 \\\\ 5{t}_{o} & =180 \\\\ {t}_{o} & =36\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of salt in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(36) & =5(22+36)-55{\\left(\\frac{22}{22+36}\\right)}^{4} \\\\  & =290-55{\\left(\\frac{22}{58}\\right)}^{4} \\\\  & ≈288.9\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33657fab-2d53-58a0-98a5-5356a1b0e53a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "226.4\\,\\text{lb}" :db/id #edb/ref 17592186539405} {:answer/id #uuid "481acaa8-6906-5974-ae76-54c5df18a291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "226.9\\,\\text{lb}" :db/id #edb/ref 17592186539412} {:answer/id #uuid "49a7b172-e749-59a4-86e1-727a1b566135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "227.5\\,\\text{lb}" :db/id #edb/ref 17592186539413} {:answer/id #uuid "a6d6b5ed-3b6b-5ab9-afd8-dc8db825fe1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "228.0\\,\\text{lb}" :db/id #edb/ref 17592186539436} {:answer/id #uuid "ecee97e7-7992-52dc-9300-131e135e7abf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "227.8\\,\\text{lb}" :db/id #edb/ref 17592186539456}] :answer-field/correct {:answer/id #uuid "49a7b172-e749-59a4-86e1-727a1b566135" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "227.5\\,\\text{lb}" :db/id #edb/ref 17592186539413} :answer-field/id #uuid "e6be6c4b-dcbc-5ac0-a692-8e76768f9b9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539453}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df8520ff-a1e4-578f-8153-7bfeb8954209" :question/problem "A nutrient tank for a hydroponic greenhouse can hold up to $342gal$ of solution. Initially, it contains $117gal$ of nutrient solution with $39lb$ of dissolved nutrient. A more concentrated solution with concentration $\\frac{2}{3}lb/gal$ flows into the tank at a rate of $45gal/min$, while the completely mixed solution drains out at a rate of $36gal/min$. Rounded to one decimal place, find the amount of nutrient in the tank at the moment it begins to overflow.\n\n> A scientific calculator is required to answer this question." :question/retired true :question/worked-solution "Since $Q$ is the amount of nutrient in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which nutrient enters the tank minus the rate at which nutrient leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which nutrient enters the tank.\n\nFirst, note that a solution containing $\\frac{2}{3}\\,\\text{lb/gal}$ of nutrient enters the tank at a rate of $45\\,\\text{gal/min}.$ So, the rate at which the *nutrient* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(\\frac{2}{3}\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (45\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(\\frac{2}{3}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (45\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =30\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which nutrient exits the tank.\n\nTo find the rate at which nutrient leaves the tank, we must first determine the volume of solution in the tank at time $t.$\n\nThe tank initially contains $117\\,\\text{gal}$ of solution; solution enters at $45\\,\\text{gal/min}$ and mixed solution leaves at $36\\,\\text{gal/min}.$\nAs a result, the amount of solution in the tank after $t$ minutes is \n\n$$\nV(t)=117+45t-36t=9(13+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of nutrient in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{9(13+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $36\\,\\text{gal/min},$ *nutrient* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(36\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{9(13+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(36\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{9(13+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{36Q}{9(13+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{4Q}{13+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =30-\\frac{4Q}{13+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{4}{13+t}\\,Q=30.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 4/(13+t)\\,dt} \\\\  & ={e}^{4\\operatorname{ln}⁡|13+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(13+t)^{4}} \\\\  & =(13+t)^{4}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(13+t)^{4}$ yields\n\n$$\n\\begin{aligned}(13+t)^{4}\\cdot (\\frac{dQ}{dt}+\\frac{4}{13+t}\\,Q) & =(13+t)^{4}\\cdot 30 \\\\ (13+t)^{4}\\frac{dQ}{dt}+4(13+t)^{3}Q & =30(13+t)^{4} \\\\ \\frac{d}{dt}(Q(13+t)^{4}) & =30(13+t)^{4}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(13+t)^{4})\\,dt & =\\int 30(13+t)^{4}\\,dt \\\\ Q(13+t)^{4} & =30\\cdot \\frac{1}{5}(13+t)^{5}+C \\\\ Q(t) & =6(13+t)+\\frac{C}{(13+t)^{4}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $39\\,\\text{lb}$ of nutrient. So, we can apply the initial condition $Q(0)=39,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =39 \\\\ 6(13+0)+\\frac{C}{(13+0)^{4}} & =39 \\\\ 78+\\frac{C}{(13)^{4}} & =39 \\\\ \\frac{C}{(13)^{4}} & =-39 \\\\ C & =-39(13)^{4}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =6(13+t)-\\frac{39(13)^{4}}{(13+t)^{4}} \\\\  & =6(13+t)-39{\\left(\\frac{13}{13+t}\\right)}^{4}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $342\\,\\text{gal},$ so we can use the condition $V({t}_{o})=342$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =342 \\\\ 117+45{t}_{o}-36{t}_{o} & =342 \\\\ 117+9{t}_{o} & =342 \\\\ 9{t}_{o} & =225 \\\\ {t}_{o} & =25\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of nutrient in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(25) & =6(13+25)-39{\\left(\\frac{13}{13+25}\\right)}^{4} \\\\  & =228-39{\\left(\\frac{13}{38}\\right)}^{4} \\\\  & ≈227.5\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59522728-6ff5-53b4-81e0-6fc27377f260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "139.7\\,\\text{lb}" :db/id #edb/ref 17592186539419} {:answer/id #uuid "5cc28afa-a913-5db8-b93f-4620f9101e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100.7\\,\\text{lb}" :db/id #edb/ref 17592186539421} {:answer/id #uuid "7393c7e7-e7db-5dae-8dbd-5c124fce7375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "153.0\\,\\text{lb}" :db/id #edb/ref 17592186539426} {:answer/id #uuid "7b517137-5fec-5646-b994-ef492f5bc290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135.6\\,\\text{lb}" :db/id #edb/ref 17592186539428} {:answer/id #uuid "f63a9d0e-447c-57d4-a11e-5dba82466c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130.2\\,\\text{lb}" :db/id #edb/ref 17592186539459}] :answer-field/correct {:answer/id #uuid "7b517137-5fec-5646-b994-ef492f5bc290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135.6\\,\\text{lb}" :db/id #edb/ref 17592186539428} :answer-field/id #uuid "5063c8db-660b-5ca6-90ed-32587c3a7e76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539418}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbffe068-df49-5949-a93c-dd6aa67cd689" :question/problem "A saline reservoir for a medical research lab can hold up to $306\\,\\text{gal}$ of solution. Initially, it contains $234\\,\\text{gal}$ of saline solution with $78\\,\\text{lb}$ of dissolved salt. A more concentrated saline solution with concentration $0.5\\,\\text{lb/gal}$ flows into the reservoir at a rate of $24\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $18\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of salt in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of salt in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the reservoir minus the rate at which salt leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the reservoir.\n\nFirst, note that a solution containing $0.5\\,\\text{lb/gal}$ of salt enters the reservoir at a rate of $24\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.5\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (24\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.5\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (24\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =12\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the reservoir.\n\nTo find the rate at which salt leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $234\\,\\text{gal}$ of solution; solution enters at $24\\,\\text{gal/min}$ and mixed solution leaves at $18\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=234+24t-18t=6(39+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of salt in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{6(39+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $18\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(18\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{6(39+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(18\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{6(39+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{18Q}{6(39+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{3Q}{39+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =12-\\frac{3Q}{39+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{3}{39+t}\\,Q=12.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 3/(39+t)\\,dt} \\\\  & ={e}^{3\\operatorname{ln}⁡|39+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(39+t)^{3}} \\\\  & =(39+t)^{3}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(39+t)^{3}$ yields\n\n$$\n\\begin{aligned}(39+t)^{3}\\cdot (\\frac{dQ}{dt}+\\frac{3}{39+t}\\,Q) & =(39+t)^{3}\\cdot 12 \\\\ (39+t)^{3}\\frac{dQ}{dt}+3(39+t)^{2}Q & =12(39+t)^{3} \\\\ \\frac{d}{dt}(Q(39+t)^{3}) & =12(39+t)^{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(39+t)^{3})\\,dt & =\\int 12(39+t)^{3}\\,dt \\\\ Q(39+t)^{3} & =12\\cdot \\frac{1}{4}(39+t)^{4}+C \\\\ Q(t) & =3(39+t)+\\frac{C}{(39+t)^{3}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $78\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=78,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =78 \\\\ 3(39+0)+\\frac{C}{(39+0)^{3}} & =78 \\\\ 117+\\frac{C}{(39)^{3}} & =78 \\\\ \\frac{C}{(39)^{3}} & =-39 \\\\ C & =-39(39)^{3}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =3(39+t)-\\frac{39(39)^{3}}{(39+t)^{3}} \\\\  & =3(39+t)-39{\\left(\\frac{39}{39+t}\\right)}^{3}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $306\\,\\text{gal},$ so we can use the condition $V({t}_{o})=306$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =306 \\\\ 234+24{t}_{o}-18{t}_{o} & =306 \\\\ 234+6{t}_{o} & =306 \\\\ 6{t}_{o} & =72 \\\\ {t}_{o} & =12\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of salt in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(12) & =3(39+12)-39{\\left(\\frac{39}{39+12}\\right)}^{3} \\\\  & =153-39{\\left(\\frac{39}{51}\\right)}^{3} \\\\  & ≈135.6\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d1e1a0-3c64-5ef9-9dbe-759c9e661398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "386.0\\,\\text{lb}" :db/id #edb/ref 17592186539395} {:answer/id #uuid "2bf04547-57c3-53c4-840a-33e618532e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "284.9\\,\\text{lb}" :db/id #edb/ref 17592186539403} {:answer/id #uuid "5acc0bd1-19cd-5dac-ac79-38ebff3903c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "588.0\\,\\text{lb}" :db/id #edb/ref 17592186539420} {:answer/id #uuid "797eee29-2209-55c5-906c-e8f2d054d896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "458.1\\,\\text{lb}" :db/id #edb/ref 17592186539427} {:answer/id #uuid "a62cbaf9-65b9-5cb1-860f-98a4438ffabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "273.7\\,\\text{lb}" :db/id #edb/ref 17592186539435}] :answer-field/correct {:answer/id #uuid "17d1e1a0-3c64-5ef9-9dbe-759c9e661398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "386.0\\,\\text{lb}" :db/id #edb/ref 17592186539395} :answer-field/id #uuid "f243c2a4-f8d5-5f1f-93bf-3f804ba469a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539457}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff0fe97f-83da-58e7-9a2a-1f41369f6103" :question/problem "A saline reservoir for a medical research lab can hold up to $490\\,\\text{gal}$ of solution. Initially, it contains $315\\,\\text{gal}$ of saline solution with $126\\,\\text{lb}$ of dissolved salt. A more concentrated saline solution with concentration $1.2\\,\\text{lb/gal}$ flows into the reservoir at a rate of $15\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $5\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of salt in the reservoir at the moment it begins to overflow." :question/retired true :question/worked-solution "Since $Q$ is the amount of salt in the reservoir at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which salt enters the reservoir minus the rate at which salt leaves the reservoir.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the reservoir.\n\nFirst, note that a solution containing $1.2\\,\\text{lb/gal}$ of salt enters the reservoir at a rate of $15\\,\\text{gal/min}.$ So, the rate at which the *salt* enters the reservoir is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(1.2\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (15\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(1.2\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (15\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =18\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the reservoir.\n\nTo find the rate at which salt leaves the reservoir, we must first determine the volume of solution in the reservoir at time $t.$\n\nThe reservoir initially contains $315\\,\\text{gal}$ of solution; solution enters at $15\\,\\text{gal/min}$ and mixed solution leaves at $5\\,\\text{gal/min}.$\nAs a result, the amount of solution in the reservoir after $t$ minutes is \n\n$$\nV(t)=315+15t-5t=10(31.5+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the reservoir is filling.\n\nSince $Q$ is the amount of salt in the reservoir, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{10(31.5+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $5\\,\\text{gal/min},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(5\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{10(31.5+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(5\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{10(31.5+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{5Q}{10(31.5+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{0.5Q}{31.5+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =18-\\frac{0.5Q}{31.5+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{0.5}{31.5+t}\\,Q=18.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 0.5/(31.5+t)\\,dt} \\\\  & ={e}^{0.5\\operatorname{ln}⁡|31.5+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(31.5+t)^{0.5}} \\\\  & =(31.5+t)^{0.5}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(31.5+t)^{0.5}$ yields\n\n$$\n\\begin{aligned}(31.5+t)^{0.5}\\cdot (\\frac{dQ}{dt}+\\frac{0.5}{31.5+t}\\,Q) & =(31.5+t)^{0.5}\\cdot 18 \\\\ (31.5+t)^{0.5}\\frac{dQ}{dt}+0.5(31.5+t)^{-0.5}Q & =18(31.5+t)^{0.5} \\\\ \\frac{d}{dt}(Q(31.5+t)^{0.5}) & =18(31.5+t)^{0.5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(31.5+t)^{0.5})\\,dt & =\\int 18(31.5+t)^{0.5}\\,dt \\\\ Q(31.5+t)^{0.5} & =18\\cdot \\frac{1}{1.5}(31.5+t)^{1.5}+C \\\\ Q(t) & =12(31.5+t)+\\frac{C}{(31.5+t)^{0.5}}.\\end{aligned}\n$$\n\nWe're told that the reservoir initially contains $126\\,\\text{lb}$ of salt. So, we can apply the initial condition $Q(0)=126,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =126 \\\\ 12(31.5+0)+\\frac{C}{(31.5+0)^{0.5}} & =126 \\\\ 378+\\frac{C}{(31.5)^{0.5}} & =126 \\\\ \\frac{C}{(31.5)^{0.5}} & =-252 \\\\ C & =-252(31.5)^{0.5}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =12(31.5+t)-\\frac{252(31.5)^{0.5}}{(31.5+t)^{0.5}} \\\\  & =12(31.5+t)-252{\\left(\\frac{31.5}{31.5+t}\\right)}^{0.5}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the reservoir begins to overflow. The reservoir has a capacity of $490\\,\\text{gal},$ so we can use the condition $V({t}_{o})=490$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =490 \\\\ 315+15{t}_{o}-5{t}_{o} & =490 \\\\ 315+10{t}_{o} & =490 \\\\ 10{t}_{o} & =175 \\\\ {t}_{o} & =17.5\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of salt in the reservoir at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(17.5) & =12(31.5+17.5)-252{\\left(\\frac{31.5}{31.5+17.5}\\right)}^{0.5} \\\\  & =588-252{\\left(\\frac{31.5}{49}\\right)}^{0.5} \\\\  & ≈386.0\\,\\text{lb}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093fa62e-8096-5d11-a95f-85739516d8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186540395} {:answer/id #uuid "8c6c709b-6491-5318-be01-b2892d94e1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186540419} {:answer/id #uuid "8e0091a3-591b-5df5-a23c-7e2504de52d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186540420} {:answer/id #uuid "97de21b0-ff26-5a3c-8296-017bf39aad56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186540423} {:answer/id #uuid "cc3a8fe1-cd84-5092-a7c0-1ca7d988d36f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186540436}] :answer-field/correct {:answer/id #uuid "cc3a8fe1-cd84-5092-a7c0-1ca7d988d36f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186540436} :answer-field/id #uuid "75267109-2433-5e86-a308-d103295ada57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540416}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "020bf2b5-6b7c-5949-b44d-18f12c8b1668" :question/problem "A juice-processing tank initially holds $1200\\,\\text{L}$ of liquid containing $22\\,\\text{kg}$ of dissolved sugar.\nA solution containing $0.04\\,\\text{kg/L}$ of dissolved sugar is pumped into the tank at a rate of $24\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $36\\,\\text{L/min}.$ If the amount of sugar $Q(t),$ in kilograms, in the tank $t$ minutes after pumping begins is given by\n\n$$\nQ(t)=\\alpha \\,(1-\\frac{t}{100})+\\beta {(1-\\frac{t}{100})}^{3}\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants, what is the value of $\\alpha -\\beta ?$" :question/worked-solution "Let $Q$ be the amount of dissolved substance in the tank at time $t,$ in minutes. The amount entering minus the amount leaving gives\n$$\\frac{dQ}{dt}=Q'_{\\text{in}}-Q'_{\\text{out}}.$$\nThe units of these rates are $\\text{kg/min}.$\n\n**Step 1**: Calculating the rate at which substance enters the tank.\n$$\\begin{aligned}Q'_{\\text{in}}&=(0.04\\,\\frac{\\text{kg}}{\\text{L}})\\cdot(24\\,\\frac{\\text{L}}{\\text{min}})\\\\\n&=(0.04\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot(24\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\\\&=0.96\\,\\text{kg/min}.\\end{aligned}$$\n\n**Step 2**: Calculating the rate at which substance exits the tank.\nThe volume is\n$$V(t)=1200+24t-36t=(1200-12t)\\,\\text{L}.$$\nThe concentration is $\\frac{Q}{1200-12t}\\,\\text{kg/L}.$ Hence,\n$$\\begin{aligned}Q'_{\\text{out}}&=(36\\,\\frac{\\text{L}}{\\text{min}})\\cdot(\\frac{Q}{1200-12t}\\,\\frac{\\text{kg}}{\\text{L}})\\\\\n&=(36\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot(\\frac{Q}{1200-12t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\\\\n&=\\frac{36Q}{1200-12t}\\,\\text{kg/min}=\\frac{3Q}{100-t}\\,\\text{kg/min}.\\end{aligned}$$\n\n**Step 3**: Calculate the overall rate of change.\n$$\\begin{aligned}\\frac{dQ}{dt}&=Q'_{\\text{in}}-Q'_{\\text{out}}\\\\&=0.96-\\frac{3Q}{100-t}.\\end{aligned}$$\nThus,\n$$\\frac{dQ}{dt}+\\frac{3}{100-t}Q=0.96.$$\n\n**Step 4**: Integrate the equation.\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n$$\\begin{aligned}I(t)&=e^{\\int 3/(100-t)\\,dt}\\\\&=e^{-3\\ln|100-t|}\\\\&=e^{\\ln (100-t)^{-3}}\\\\&=(100-t)^{-3}.\\end{aligned}$$\nMultiplying both sides by $I(t)=(100-t)^{-3}$ yields\n$$\\begin{aligned}(100-t)^{-3}\\cdot(\\frac{dQ}{dt}+\\frac{3}{100-t}Q)&=(100-t)^{-3}\\cdot 0.96\\\\\n(100-t)^{-3}\\frac{dQ}{dt}+3(100-t)^{-4}Q&=0.96(100-t)^{-3}\\\\\\frac{d}{dt}(Q(100-t)^{-3})&=0.96(100-t)^{-3}.\\end{aligned}$$\nNow, we integrate with respect to $t:$\n$$\\begin{aligned}\\int\\frac{d}{dt}(Q(100-t)^{-3})\\,dt&=\\int 0.96(100-t)^{-3}\\,dt\\\\Q(100-t)^{-3}&=0.96\\cdot\\frac{1}{2}(100-t)^{-2}+C\\\\Q(t)&=0.48(100-t)+C(100-t)^{3}.\\end{aligned}$$\nNote that $C$ is a constant of integration.\nThe initial condition is $Q(0)=22.$ Thus,\n$$\\begin{aligned}0.48(100-0)+C(100-0)^{3}&=22\\\\\n48+C(100)^{3}&=22\\\\C(100)^{3}&=-26\\\\C&=- \\frac{13}{500000}.\\end{aligned}$$\nFinally, we obtain the following expression for $Q(t):$\n$$Q(t)=- \\frac{12 t}{25} - \\frac{13 \\left(100 - t\\right)^{3}}{500000} + 48.$$\nWriting this in the supplied normalized form gives\n$$Q(t)=48(1-\\frac{t}{100})-26(1-\\frac{t}{100})^{3}.$$\nFinally, we have $\\alpha=48,\\beta=-26,$ and\n$$\\alpha-\\beta=48-(-26)=74.$$"}] [{:db/id #edb/ref 17592186540397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166fed0c-8918-56b2-b636-cf592f997ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186540396} {:answer/id #uuid "5a22b298-1a5a-5058-9b77-2eab6913c677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186540407} {:answer/id #uuid "69d45437-7fd6-5848-923b-1f4b15b57c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186540412} {:answer/id #uuid "89c99d91-82cb-5e14-8527-fde394dd6d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186540418} {:answer/id #uuid "a271f298-37bd-5138-badb-b61de5604cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186540427}] :answer-field/correct {:answer/id #uuid "69d45437-7fd6-5848-923b-1f4b15b57c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186540412} :answer-field/id #uuid "3d60cb95-ef2a-5a65-ad01-ba8fd07daf1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540402}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17255c70-5c1b-504e-b42a-7ed81673de48" :question/problem "An aquarium initially holds $1200L$ of water containing $18kg$ of dissolved minerals.\nA solution containing $0.04kg/L$ of dissolved minerals is pumped into the aquarium at a rate of $24L/min$, while the completely mixed water is drained out at a rate of $36L/min$. If the amount of minerals $Q(t)$, in kilograms, in the tank $t$ minutes after pumping begins is given by\n$$\n\\displaystyle Q(t) = α(1 - \\frac{t}{100}) + β(1 - \\frac{t}{100})^{3}\n$$\nwhere $α$ and $β$ are constants, what is the value of $α + β$?\n\n> A scientific calculator is required to answer this question." :question/worked-solution "At $t=0,$ the supplied model gives $Q(0)=\\alpha(1-0/100)+\\beta(1-0/100)^{3}=\\alpha+\\beta.$ The initial amount is $18\\,\\text{kg},$ so $\\alpha+\\beta=18.$"}] [{:db/id #edb/ref 17592186540415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e4ada2a-5139-5032-b4de-d205305460f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186540409} {:answer/id #uuid "6007bd78-951f-5937-8b7f-594e98a3abc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186540411} {:answer/id #uuid "6c7bba5f-763e-535c-8b1c-41f26255be3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186540414} {:answer/id #uuid "a051d0eb-a8b6-5a4f-a659-75e7cc394c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85" :db/id #edb/ref 17592186540426} {:answer/id #uuid "f4aec868-1b73-5283-b31d-1022e36884f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95