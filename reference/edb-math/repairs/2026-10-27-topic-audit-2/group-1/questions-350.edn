#{[{:db/id #edb/ref 17592186329891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bc770f-35b5-51f7-ac23-0dd7e7626849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186326966} {:answer/id #uuid "a57078c9-1989-5bc2-8b84-47cb7c7b7fce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi }" :db/id #edb/ref 17592186328362} {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} {:answer/id #uuid "bce8eacc-997c-5af0-a8a5-5af0dda6e688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328578} {:answer/id #uuid "d019d383-2037-503a-8480-3e5bdb84df98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi {e}^{\\pi }" :db/id #edb/ref 17592186328764}] :answer-field/correct {:answer/id #uuid "acccd38a-7649-5753-9632-b00f2c05b4e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{\\pi }" :db/id #edb/ref 17592186328433} :answer-field/id #uuid "8008b7a2-773f-5257-8a67-dd590b27a6d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7dfe1e7-2a9e-5927-a9e6-a1ed58369b31" :question/math-academy-id "q-48516" :question/problem "If a curve $C$ is given by $y={e}^{x}sin⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={e}^{x}$ and $v(x)=sin⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x},\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+(sin⁡x)\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & ={{e}^{x}(cos⁡x+sin⁡x)|}_{x=\\pi } \\\\  & ={e}^{\\pi }(-1+0) \\\\  & =-{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-{e}^{\\pi }.$"}] [{:db/id #edb/ref 17592186329892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122dcace-6bca-59bb-b96f-a96026e9a833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e+5" :db/id #edb/ref 17592186327088} {:answer/id #uuid "29771cef-6628-575d-b6d2-039fa89b2a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+2" :db/id #edb/ref 17592186327286} {:answer/id #uuid "3101f4e9-df22-5461-be7e-f6674a765dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186327368} {:answer/id #uuid "c3e4fd4c-0122-574c-8317-faf21984d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186328648} {:answer/id #uuid "e154d586-179b-57cc-acf3-bc95bc04c67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186328905}] :answer-field/correct {:answer/id #uuid "c3e4fd4c-0122-574c-8317-faf21984d650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186328648} :answer-field/id #uuid "745d0171-7216-5576-96bb-4a33b2c2f9b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329378}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1066779d-ebe1-53a9-ad1f-5e9c5ee1f7e4" :question/math-academy-id "q-48517" :question/problem "If a curve $C$ is given by $y=({x}^{3}-1){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{3}-1$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2},\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{3}-1)\\cdot {e}^{x}+{e}^{x}\\cdot (3{x}^{2}) \\\\  & ={e}^{x}({x}^{3}+3{x}^{2}-1).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={{e}^{x}({x}^{3}+3{x}^{2}-1)|}_{x=2} \\\\  & ={e}^{2}({2}^{3}+3(2)^{2}-1) \\\\  & =19{e}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $19{e}^{2}.$"}] [{:db/id #edb/ref 17592186329947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb89b95-0bba-5b10-8fe3-527b548e1601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327074} {:answer/id #uuid "8a5aa1e3-21ee-5889-8055-e0735761bea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186328124} {:answer/id #uuid "c4cf7b66-0f01-5eca-acc9-cb3a3d67bb13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186328659} {:answer/id #uuid "d10f42e2-911f-5fb9-b0b0-c03a2475a986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328770} {:answer/id #uuid "e360ba04-1df2-5392-a2fb-baf0e0e1b838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328927}] :answer-field/correct {:answer/id #uuid "0fb89b95-0bba-5b10-8fe3-527b548e1601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327074} :answer-field/id #uuid "b7bf395d-b055-550a-8f21-50f7bb4a70c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329507}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a6705a9-7a56-57af-9eab-fa453a263686" :question/math-academy-id "q-48993" :question/problem "If a curve $C$ is given by $y=x\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=e.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =x\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 1 \\\\  & =1+\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=e} & =1+\\operatorname{ln}⁡x \\\\  & =1+\\operatorname{ln}⁡e \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2.$"}] [{:db/id #edb/ref 17592186332661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64328e68-62e1-53dd-9cfb-7398eb993288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x-2cot⁡x+C" :db/id #edb/ref 17592186330842} {:answer/id #uuid "8aeb842f-aeaa-5e41-b067-5daed501c3d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2cos⁡x+2tan⁡x+C" :db/id #edb/ref 17592186331183} {:answer/id #uuid "a3677c87-1d81-51dd-8a89-966172c275aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x-2sec⁡x+C" :db/id #edb/ref 17592186331413} {:answer/id #uuid "c5c429dd-3478-55e6-b756-94a76a605818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x-2tan⁡x+C" :db/id #edb/ref 17592186331704} {:answer/id #uuid "cd4bb0d0-92fa-5871-a2d8-fc85d9224fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{sin}^{3}⁡x-2cot⁡x+C" :db/id #edb/ref 17592186331771}] :answer-field/correct {:answer/id #uuid "64328e68-62e1-53dd-9cfb-7398eb993288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x-2cot⁡x+C" :db/id #edb/ref 17592186330842} :answer-field/id #uuid "a0820439-91be-5bbd-bf0c-17495c4b5b15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332479}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b36d025f-bace-58ef-adb7-3885184b511c" :question/math-academy-id "q-49121" :question/problem "Calculate $$\n\\displaystyle \\int csc⁡x(3cot⁡x+2csc⁡x)\\text{d}x.\n$$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}⁡x\\,\\text{d}x & =-cot⁡x+C, \\\\ \\int csc⁡xcot⁡x\\,\\text{d}x & =-csc⁡x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int csc⁡x(3cot⁡x+2csc⁡x)\\text{d}x & =\\int (3csc⁡xcot⁡x+2{csc}^{2}⁡x)\\,\\text{d}x \\\\  & =\\int 3csc⁡xcot⁡x\\,\\text{d}x+\\int 2{csc}^{2}⁡x\\,\\text{d}x \\\\  & =3\\int csc⁡xcot⁡x\\,\\text{d}x+2\\int {csc}^{2}⁡x\\,\\text{d}x \\\\  & =3(-csc⁡x)+2(-cot⁡x)+C \\\\  & =-3csc⁡x-2cot⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274362a6-a3c6-5920-81f8-1b2abcf16ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7tan⁡x+4csc⁡x+C" :db/id #edb/ref 17592186330301} {:answer/id #uuid "4a02aa3a-212d-52ee-bcdb-e1c48e5f318d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7tan⁡x-4csc⁡x+C" :db/id #edb/ref 17592186330616} {:answer/id #uuid "6d5434a6-e354-57cc-8be3-921a471e1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7tan⁡x+4sec⁡x+C" :db/id #edb/ref 17592186330929} {:answer/id #uuid "c85ca58b-0676-50a2-a51f-81c36b63f586" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7cot⁡x+4sec⁡x+C" :db/id #edb/ref 17592186331724} {:answer/id #uuid "eeff4377-3048-5370-9c27-9dad4e9d4466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7cot⁡x-4sec⁡x+C" :db/id #edb/ref 17592186332047}] :answer-field/correct {:answer/id #uuid "6d5434a6-e354-57cc-8be3-921a471e1964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7tan⁡x+4sec⁡x+C" :db/id #edb/ref 17592186330929} :answer-field/id #uuid "f5cb83ec-ba9e-5744-a1c6-b0f47594acda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332632}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c3a5d5fb-8f22-572d-9122-04a2c3a1b6ad" :question/math-academy-id "q-49122" :question/problem "Calculate $$\n\\displaystyle \\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sec⁡xtan⁡x\\,\\text{d}x & =sec⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x & =\\int (7{sec}^{2}⁡x+4sec⁡xtan⁡x)\\text{d}x \\\\  & =\\int 7{sec}^{2}⁡x\\,\\text{d}x+\\int 4sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7\\int {sec}^{2}⁡x\\,\\text{d}x+4\\int sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7tan⁡x+4sec⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081c395e-81a0-58ca-9b28-908fbc08890b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9b/9bba5f86445177b9124813e85bf9294b7b566a029686f163c685663f5b352e30.png" :db/id #edb/ref 17592186330018} {:answer/id #uuid "6693c55b-1fbf-5e3a-bcc1-b97dd508708b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186330868} {:answer/id #uuid "a161b1e9-2046-5e54-8b93-40f73c498c97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7a550e346a2b31e09ec2dbfcf8eefe9a80108a74edffa92cb3a617643a810e31.png" :db/id #edb/ref 17592186331402} {:answer/id #uuid "cb04b6dd-6d28-5c58-a979-d60f59b78f97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e5b20b6b0ae17ca9ee891ec33efa93fd23f684e938b1527e56db01f11a2e53d8.png" :db/id #edb/ref 17592186331751} {:answer/id #uuid "e3217471-cfef-53f9-a6f4-33a3eafa2151" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a87973b958bd7a598da127164fd77365daaf121a601c25d198f1a3256bd84f6d.png" :db/id #edb/ref 17592186331954}] :answer-field/correct {:answer/id #uuid "6693c55b-1fbf-5e3a-bcc1-b97dd508708b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186330868} :answer-field/id #uuid "498a90f9-7a3f-5e45-8a1f-e1f3e2ba683e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2935646c-b052-5fbf-9833-4d59c4cb2c23" :question/math-academy-id "q-49811" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=2{x}^{2}-\\frac{1}{2}{y}^{2}?\n$$" :question/worked-solution "We have to sketch the slope field at the points $(1,2),(1,0),$ and $(-1,-2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)}=2(1)^{2}-\\frac{1}{2}(2)^{2}=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,0)}=2(1)^{2}-\\frac{1}{2}(0)^{2}=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-2)}=2(-1)^{2}-\\frac{1}{2}(-2)^{2}=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png)"}] [{:db/id #edb/ref 17592186332860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bcca4c-5187-5b94-ac7b-5d02a3f2a7a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2z}+C" :db/id #edb/ref 17592186330287} {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} {:answer/id #uuid "b72adbd0-bb37-569b-a51f-ca71e2f21191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186331566} {:answer/id #uuid "c2a7f69b-7b9b-5b9c-a316-48041e48b095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2z}+C" :db/id #edb/ref 17592186331680} {:answer/id #uuid "ed5ddad8-9030-5f3c-8173-cbf15c6a73ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186332034}] :answer-field/correct {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} :answer-field/id #uuid "5a02851a-ae90-5a99-96af-7dadaa7d8178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332375}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "375483c5-6d04-5b75-830f-34c3a2a176c9" :question/math-academy-id "q-51160" :question/problem "$$\n\\displaystyle \\int {e}^{z}{e}^{z}\\,\\text{d}z=\n$$" :question/worked-solution "First, we notice that\n\n$$\n\\int {e}^{z}{e}^{z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z.\n$$\n\nIf we let $u=2z$, then\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2\\,⟹\\,\\text{d}z=\\frac{1}{2}\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {e}^{2z}\\,\\text{d}z & =\\int {e}^{2z}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{2z}}{2}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085dc6f6-e081-5bd2-8063-ddd239c0a955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{2}-{e}^{x-1}+{e}^{y}=0" :db/id #edb/ref 17592186330019} {:answer/id #uuid "2186d9f1-dc7f-530e-af88-d45f4f718cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{y}^{3}-3x=-3" :db/id #edb/ref 17592186330235} {:answer/id #uuid "2e28716a-006d-55b4-8fe4-2b634e177998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y-3x+{e}^{y}=-2" :db/id #edb/ref 17592186330355} {:answer/id #uuid "325350f1-47bf-55f6-ba0b-f7750ab8a802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}y+3{x}^{3}+{e}^{2y}=4" :db/id #edb/ref 17592186330394} {:answer/id #uuid "cd3ce59f-17fa-556e-87ed-8cf80754e300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y-3{e}^{y}=-3" :db/id #edb/ref 17592186331769}] :answer-field/correct {:answer/id #uuid "2e28716a-006d-55b4-8fe4-2b634e177998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y-3x+{e}^{y}=-2" :db/id #edb/ref 17592186330355} :answer-field/id #uuid "ae4c8d78-2bc4-5bc4-a8a2-626fba58916f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332504}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "06039f1f-a0f6-5cde-96ff-64c58d9f4662" :question/math-academy-id "q-64183" :question/problem "Find the general solution of the exact differential equation\n\n$$\n(3{x}^{2}y-3)\\,\\text{d}x+({x}^{3}+{e}^{y})\\text{d}y=0\n$$\n\nwith the initial condition $y(1)=0.$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=3{x}^{2}y-3$ and $Q(x,y)={x}^{3}+{e}^{y}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$:\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int 3{x}^{2}y-3\\,\\text{d}x+f(y) \\\\  & ={x}^{3}y-3x+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x.$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int {x}^{3}+{e}^{y}\\,\\text{d}y+g(x) \\\\  & ={x}^{3}y+{e}^{y}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=-3x,\\,f(y)={e}^{y}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n{x}^{3}y-3x+{e}^{y}=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=0$ when $x=1.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}{x}^{3}y-3x+{e}^{y}=c \\\\ (1)^{3}(0)-3(1)+{e}^{0}=c \\\\ -3+1=c \\\\ c=-2\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n{x}^{3}y-3x+{e}^{y}=-2.\n$$"}] [{:db/id #edb/ref 17592186332987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1cf463-3457-5981-9bbd-b68c2ec0ca83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡({x}^{3}+2)+{y}^{3}=c" :db/id #edb/ref 17592186330339} {:answer/id #uuid "2c9f0d23-1dcb-59c1-8bcd-adc9087744bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({x}^{3}y+1)}{4}+xy=c" :db/id #edb/ref 17592186330345} {:answer/id #uuid "398905e8-f698-5e67-8a8e-436c0d2f0dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y+\\frac{{y}^{4}}{2}=c" :db/id #edb/ref 17592186330467} {:answer/id #uuid "4a0199a8-ab10-5c77-a6db-2a5f6ffbd4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y-6xy+x{y}^{3}=c" :db/id #edb/ref 17592186330615} {:answer/id #uuid "5bb4c936-b8a1-59c1-ab78-981e2028f030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+xy+{y}^{2}=c" :db/id #edb/ref 17592186330767}] :answer-field/correct {:answer/id #uuid "398905e8-f698-5e67-8a8e-436c0d2f0dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}y+\\frac{{y}^{4}}{2}=c" :db/id #edb/ref 17592186330467} :answer-field/id #uuid "aabd69a2-93f7-5c9a-b909-b7c6020b9a82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332498}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64ac5ce4-250c-588a-ad8b-692c1a6131a7" :question/math-academy-id "q-64211" :question/problem "Find the general solution of the exact differential equation\n\n$$\n3{x}^{2}y\\,\\text{d}x+({x}^{3}+2{y}^{3})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=3{x}^{2}y$ and $Q(x,y)={x}^{3}+2{y}^{3}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int 3{x}^{2}y\\,\\text{d}x+f(y) \\\\  & ={x}^{3}y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int ({x}^{3}+2{y}^{3})\\,\\text{d}y+g(x) \\\\  & ={x}^{3}y+\\frac{{y}^{4}}{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=0,\\,f(y)=\\frac{{y}^{4}}{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n{x}^{3}y+\\frac{{y}^{4}}{2}=c.\n$$"}] [{:db/id #edb/ref 17592186335688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0642ebe1-6c98-5eac-a446-e612e4a190c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+3x{y}^{2}-{x}^{3}y=c" :db/id #edb/ref 17592186333045} {:answer/id #uuid "4c2b7d9d-4068-58e2-9129-1936ba2f45c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+y}{2}+xy=c" :db/id #edb/ref 17592186333690} {:answer/id #uuid "55364f0b-3fbd-5e5b-b377-2662a569d13c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{y}^{3}+{x}^{3}y+xy=c" :db/id #edb/ref 17592186333767} {:answer/id #uuid "9d95b17f-126c-55d9-a0b2-de291b04ceeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{2}-\\frac{y}{x}=c" :db/id #edb/ref 17592186334378} {:answer/id #uuid "b840acfd-0a4c-5999-9f4f-bc21be33eba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4xy+{y}^{3}=c" :db/id #edb/ref 17592186334603}] :answer-field/correct {:answer/id #uuid "0642ebe1-6c98-5eac-a446-e612e4a190c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+3x{y}^{2}-{x}^{3}y=c" :db/id #edb/ref 17592186333045} :answer-field/id #uuid "f2a5de7b-f4d1-5d19-9a0e-cfe0f070ae70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335660}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d8cab43-4389-52c8-83a2-bbac13e68994" :question/math-academy-id "q-64219" :question/problem "Find the general solution of the differential equation\n\n$$\n(4x+3{y}^{2}-3{x}^{2}y)\\text{d}x+(6xy-{x}^{3})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=4x+3{y}^{2}-3{x}^{2}y$ and $Q(x,y)=6xy-{x}^{3}.$\n\nLet's check if the equation is exact. To do this, we check to see if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFirst, let's differentiate $P(x,y)$ with respect to $y:$\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂}{∂y}(4x+3{y}^{2}-3{x}^{2}y)=6y-3{x}^{2}\n$$\n\nNow, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(6xy-{x}^{3})=6y-3{x}^{2}=\\frac{∂P}{∂y}\\,✓\n$$\n\nSo, the given equation is exact and its solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (4x+3{y}^{2}-3{x}^{2}y)\\text{d}x+f(y) \\\\  & =2{x}^{2}+3x{y}^{2}-{x}^{3}y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (6xy-{x}^{3})\\text{d}y+g(x) \\\\  & =3x{y}^{2}-{x}^{3}y+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=2{x}^{2},\\,f(y)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n2{x}^{2}+3x{y}^{2}-{x}^{3}y=c.\n$$"}] [{:db/id #edb/ref 17592186335802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f09aafd-c1e5-5dd1-bf03-b73681599bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451477} {:answer/id #uuid "2f54d447-a39c-55bb-850f-c236243803eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451478}] :answer-field/correct {:answer/id #uuid "2f09aafd-c1e5-5dd1-bf03-b73681599bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451477} :answer-field/id #uuid "85c75200-01ed-54ca-9326-1eca1bb956f5" :answer-field/key "The limit evaluates to $0$ along the path $y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452586} {:answer-field/choices [{:answer/id #uuid "bf599bcb-83ed-5f4a-a06d-a9db97c5fe77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451479} {:answer/id #uuid "d1ec1810-7d26-56cd-aaac-4334475ae5ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451480}] :answer-field/correct {:answer/id #uuid "d1ec1810-7d26-56cd-aaac-4334475ae5ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451480} :answer-field/id #uuid "a87ea30f-e244-5f86-bffc-4a5395ff286d" :answer-field/key "The limit evaluates to $-\\frac{1}{2}$ along the path $y=-x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452587} {:answer-field/choices [{:answer/id #uuid "ca681fe9-ee18-536a-9299-af74510e99ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451481} {:answer/id #uuid "2d5393a0-13ec-5e60-9584-47126e03236e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451482}] :answer-field/correct {:answer/id #uuid "ca681fe9-ee18-536a-9299-af74510e99ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451481} :answer-field/id #uuid "118478a6-d6eb-5b08-b5c7-fcce661c9509" :answer-field/key "The limit exists and is equal to $0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452588}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ccd0f4b9-0dbd-51e2-a95c-14471c65ba52" :question/math-academy-id "q-65145" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n\\lim_{x\\to (0,0)}\\frac{2y+x}{3x+y}\n$$\n\nSelect all that apply." :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\lim_{x\\to (0,0)}\\frac{2y+x}{3x+y}=\\frac{2\\cdot 0+0}{3\\cdot 0+0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement “The limit evaluates to $0$ along the path $y=x$” is false. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=x}\\frac{2y+x}{3x+y} & =\\lim_{x\\to 0}\\frac{2x+x}{3x+x} \\\\  & =\\lim_{x\\to 0}\\frac{3x}{4x} \\\\  & =\\lim_{x\\to 0}\\,\\frac{3}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\n- Statement “The limit evaluates to $-\\frac{1}{2}$ along the path $y=-x$” is true. Taking $x\\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=-x}\\frac{2y+x}{3x+y} & =\\lim_{x\\to 0}\\frac{-2x+x}{3x-x} \\\\  & =\\lim_{x\\to 0}\\frac{-x}{2x} \\\\  & =\\lim_{x\\to 0}\\left(-\\frac{1}{2}\\right) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\n- Statement “The limit exists and is equal to $0$” is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{x\\to (0,0)}\\frac{2y+x}{3x+y}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186335990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} {:answer/id #uuid "1b7eebe0-7cb3-5f9c-90c8-996ed14bd473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2{z}^{2}y" :db/id #edb/ref 17592186333241} {:answer/id #uuid "62b8bc2c-0ea0-54c2-81f8-ac2379203980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x-3y{z}^{2}" :db/id #edb/ref 17592186333886} {:answer/id #uuid "d6426e90-34c6-5f45-884d-afd51e4b42c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-2{y}^{2}z" :db/id #edb/ref 17592186334865} {:answer/id #uuid "da5805d0-457f-5d06-aadd-5dc42e733cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y{z}^{2}" :db/id #edb/ref 17592186334901}] :answer-field/correct {:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} :answer-field/id #uuid "61b1a4cb-aa69-5954-bf74-458e8b0b734e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335433}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f495c11-33b3-5814-a588-ff956e62d01d" :question/math-academy-id "q-69649" :question/problem "$$\n\\displaystyle \\begin{vmatrix}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{vmatrix} & =3\\sqrt{x}\\cdot (-\\sqrt{x})-{z}^{2}\\cdot 2y \\\\  & =-3x-2y{z}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245f8b76-960f-5227-85be-1848c57026fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(ru-st)" :db/id #edb/ref 17592186333328} {:answer/id #uuid "5179db59-ecf5-527f-b152-14da85049ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6ru-3st" :db/id #edb/ref 17592186333736} {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} {:answer/id #uuid "be3cb9cd-cb94-5657-98ff-b3d91e1ff9d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6ru+3st" :db/id #edb/ref 17592186334635} {:answer/id #uuid "fa49eaa1-621e-5ca8-a141-b55927a350aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186335181}] :answer-field/correct {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} :answer-field/id #uuid "8926dc70-416f-5104-b768-f00f2078937e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f8c0050-79c4-5426-9e5c-a8628ebc0ae0" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n$$\n\\displaystyle H=\\begin{bmatrix}-2r & 3s \\\\ -2t & 3u\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}-2r & 3s \\\\ -2t & 3u\\end{vmatrix} \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd1c86f-37e4-5b7b-9ec3-6d55d9670cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333244} {:answer/id #uuid "4342bd65-1b39-56fb-b10b-45b1a8deeebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186333618} {:answer/id #uuid "982f2c1a-e0ab-57c2-b71f-62ccc2593e9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186334339} {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} {:answer/id #uuid "ab173fd5-9f80-5b1f-9676-76188073a554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186334491}] :answer-field/correct {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} :answer-field/id #uuid "8c672b33-f965-56dc-b5e9-ce679a558195" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335509}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66ad3ebb-398d-57e0-be2a-0ce7c08b87a1" :question/math-academy-id "q-69661" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}1-p & 1+p \\\\ -3 & 2\\end{bmatrix}\n$$\nand $det(S)=2$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}1-p & 1+p \\\\ -3 & 2\\end{vmatrix} \\\\  & =(1-p)\\cdot 2-(1+p)\\cdot (-3) \\\\  & =2-2p+3+3p \\\\  & =5+p\\end{aligned}\n$$\n\nSince $det(S)=2$, we obtain:\n\n$$\n\\begin{aligned}det(S) & =2 \\\\ 5+p & =2 \\\\ p & =2-5 \\\\ p & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7fc3c01-7f3a-5c6b-abd7-c743ce206e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438490} {:answer/id #uuid "47099553-c6c1-5bd1-9e0e-9f21c98fc65f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438491}] :answer-field/correct {:answer/id #uuid "b7fc3c01-7f3a-5c6b-abd7-c743ce206e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438490} :answer-field/id #uuid "a81ed0d9-7e42-5cbb-aca1-b03bc48b3022" :answer-field/key "The function has maximum values at $x=\\frac{\\pi }{2}+2n\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439274} {:answer-field/choices [{:answer/id #uuid "46870e8a-9f05-53d2-a4ea-6c68291e1467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438492} {:answer/id #uuid "71ec84ae-38af-5df8-81fd-d23b40330600" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438493}] :answer-field/correct {:answer/id #uuid "71ec84ae-38af-5df8-81fd-d23b40330600" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438493} :answer-field/id #uuid "faf0da50-2691-505e-8eef-7d1db6e3c6e2" :answer-field/key "The function is zero at $x=-\\frac{\\pi }{2}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439275} {:answer-field/choices [{:answer/id #uuid "550bb9f1-5049-57d7-84d3-41f3f2ac8184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438494} {:answer/id #uuid "a91fa62b-3e27-5516-b774-e6cf906a51d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438495}] :answer-field/correct {:answer/id #uuid "550bb9f1-5049-57d7-84d3-41f3f2ac8184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438494} :answer-field/id #uuid "a5214bf9-b022-5d37-a8e8-c3abbfca85a8" :answer-field/key "The range of the function is $[-\\pi ,\\pi ].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439276}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5773d37-2017-53ae-a0d1-64c772d0dcaf" :question/math-academy-id "q-70666" :question/problem "Which of the following statements are true regarding the function $y=cos⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement “The function has maximum values at $x=\\frac{\\pi }{2}+2n\\pi .$” is false. The function has a maximum at $x=0,\\pm 2\\pi ,…,$ which can be written as $x=2n\\pi .$\n\n- Statement “The function is zero at $x=-\\frac{\\pi }{2}.$” is true. At $x=-\\frac{\\pi }{2}$, the function intersects the $x$-axis.\n\n- Statement “The range of the function is $[-\\pi ,\\pi ].$” is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186338800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991d9c5f-a832-550c-b508-1bc99acc792d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438496} {:answer/id #uuid "699ada80-0b45-5f12-a290-7e8d352f34e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438497}] :answer-field/correct {:answer/id #uuid "699ada80-0b45-5f12-a290-7e8d352f34e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438497} :answer-field/id #uuid "70665897-25d9-5fb8-b277-0ed7bc737d42" :answer-field/key "The graph intersects the $y$-axis at $y=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439277} {:answer-field/choices [{:answer/id #uuid "66266660-a17d-5cab-9611-596953bfded0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438498} {:answer/id #uuid "529ad213-185b-543a-be0e-63b5e783c340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438499}] :answer-field/correct {:answer/id #uuid "529ad213-185b-543a-be0e-63b5e783c340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438499} :answer-field/id #uuid "2c9a569f-7beb-55df-b6ed-b7c76b589ecb" :answer-field/key "The function has a minimum value at $x=-\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439278} {:answer-field/choices [{:answer/id #uuid "9326e664-12a0-57da-b2ff-7159b17d534b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438500} {:answer/id #uuid "8cfbb402-00a5-5543-8bc2-4d82370d544c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438501}] :answer-field/correct {:answer/id #uuid "9326e664-12a0-57da-b2ff-7159b17d534b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438500} :answer-field/id #uuid "39ce8d5b-318c-5474-9063-3a51adf37c70" :answer-field/key "The range of the function is $[-\\pi ,\\pi ].$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439279}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24b90149-221d-555e-91aa-b1d1cb7cb1c0" :question/math-academy-id "q-70667" :question/problem "Which of the following statements regarding the graph of $y=\\operatorname{cos}⁡x$ are true?\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement “The graph intersects the $y$-axis at $y=1$” is true. The $y$-intercepts of the function is $y=1.$\n\n- Statement “The function has a minimum value at $x=-\\pi .$” is true. The function at $x=-\\pi $ has a minimum value.\n\n- Statement “The range of the function is $[-\\pi ,\\pi ].$” is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186338802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0e7978b-65fb-572d-9e69-fb0ed478e885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337487} {:answer/id #uuid "c8d773d6-1137-500e-9144-d700b2fde742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-10\\pi " :db/id #edb/ref 17592186337808} {:answer/id #uuid "d9c26a46-9433-52e8-869e-79e45ee386aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}-2\\pi " :db/id #edb/ref 17592186337927} {:answer/id #uuid "de73e983-b2d8-5bee-8dbc-77304e29d367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337970} {:answer/id #uuid "e38b4e0e-34f4-5b2c-bf38-151d565a04ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}+10\\pi " :db/id #edb/ref 17592186338018}] :answer-field/correct {:answer/id #uuid "a0e7978b-65fb-572d-9e69-fb0ed478e885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337487} :answer-field/id #uuid "dd7d23c2-12b8-516e-b527-7ded32873395" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338666}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c70c4bc0-3980-5503-a6a2-bd4be92dae51" :question/math-academy-id "q-70671" :question/problem "If $cos⁡x=\\frac{1}{2}$ for some $x$, then $cos⁡(x-10\\pi )=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for any integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-5$ into the right-hand-side gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x-10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{1}{2},$ then $cos⁡(x-10\\pi )=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186338803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c81bece-db23-58d8-bb4c-a4ec954ab3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186336150} {:answer/id #uuid "11454d75-ea49-5be3-97d8-331be00c105f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}+2\\pi " :db/id #edb/ref 17592186336195} {:answer/id #uuid "180fc6bd-ead7-54b4-bbdc-eccc651de809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}+16\\pi " :db/id #edb/ref 17592186336255} {:answer/id #uuid "aa67f4b1-dac9-5c08-9fd9-fcd2b26eb1d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186337568} {:answer/id #uuid "e2a95a14-3cbb-500b-8ddd-ebf38336d4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}+16\\pi " :db/id #edb/ref 17592186338005}] :answer-field/correct {:answer/id #uuid "0c81bece-db23-58d8-bb4c-a4ec954ab3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186336150} :answer-field/id #uuid "c49b55a2-50e7-5337-b7ac-4eaf751dacaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338629}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6abcc021-8010-5554-b152-291688c68aef" :question/math-academy-id "q-70672" :question/problem "If $cos⁡x=\\frac{\\sqrt{3}}{3}$ for some $x$, then $cos⁡(x+16\\pi )=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for any integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=8$ into the right-hand-side gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+16\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{\\sqrt{3}}{3},$ then $cos⁡(x+16\\pi )=\\frac{\\sqrt{3}}{3}.$"}] [{:db/id #edb/ref 17592186338968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e32df3c-867b-52e1-9685-54ed36350f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5csc⁡\\theta +C" :db/id #edb/ref 17592186336617} {:answer/id #uuid "5749ab4b-3829-5dff-b27a-ce092af76408" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5sec⁡\\theta +C" :db/id #edb/ref 17592186336834} {:answer/id #uuid "61ce3452-83b8-56ee-bf09-a6c17e0a4182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5sec⁡\\theta +C" :db/id #edb/ref 17592186336913} {:answer/id #uuid "8016e95f-4a51-542c-89e3-3e83b8ee0866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5csc⁡\\theta +C" :db/id #edb/ref 17592186337193} {:answer/id 