:answer.type/math} :answer/value "-4csc⁡\\theta +C" :db/id #edb/ref 17592186337699} {:answer/id #uuid "c2a9867d-68f4-5b0a-ae4b-adea335fb6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{4}⁡\\theta +C" :db/id #edb/ref 17592186337759}] :answer-field/correct {:answer/id #uuid "ae4c906b-acc5-53f5-a555-2225a7ea5cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4sec⁡\\theta +C" :db/id #edb/ref 17592186337596} :answer-field/id #uuid "25b443c2-741e-5679-9eb5-90af61d418a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23d8fb70-2ed4-561a-80fc-2945cc48a648" :question/math-academy-id "q-71659" :question/problem "$$\n\\displaystyle \\int (-4sec⁡\\theta tan⁡\\theta )\\,\\text{d}\\theta =\n$$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-4sec⁡\\theta tan⁡\\theta )\\,\\text{d}\\theta  & =-4\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =-4sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b98751b-5a6f-5701-a079-66efabd0c54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3tan⁡y+C" :db/id #edb/ref 17592186336591} {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} {:answer/id #uuid "898bc83c-2d65-5f25-8fe3-14152653f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3tan⁡y+C" :db/id #edb/ref 17592186337272} {:answer/id #uuid "bab226dc-1012-58ab-b0