 3)+(- x^{2} + 4 x)\\cdot (\\tan{\\left(x \\right)} - 3)' \\\\ & =(4 - 2 x)(\\tan{\\left(x \\right)} - 3)+(- x^{2} + 4 x)(\\tan^{2}{\\left(x \\right)} + 1) \\\\ & =- x^{2} \\tan^{2}{\\left(x \\right)} - x^{2} + 4 x \\tan^{2}{\\left(x \\right)} - 2 x \\tan{\\left(x \\right)} + 10 x + 4 \\tan{\\left(x \\right)} - 12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03403a80-261a-55a5-811d-86be3111f82f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(12 x^{2} + 4\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530583} {:answer/id #uuid "361c3e8d-6518-5aa3-b6fb-f9ff92036099" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(4 x^{3} + 4 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530594} {:answer/id #uuid "43a3772e-3d63-5146-b44e-05174cd970a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(12 x^{2} + 4\\right) \\left(\\sin{\\left(x \\right)} + 4\\right) + \\left(4 x^{3} + 4 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530601} {:answer/id #uuid "b9313533-1638-5458-9f87-aa5680e5c6e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(12 x^{2} + 4\\right) \\left(\\sin{\\left(x \\right)} + 4\\right) - \\left(4 x^{3} + 4 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530632} {:answer/id #uuid "c8710a91-1d8d-5afc-9805-9fbdfbde5aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(12 x^{2} + 4\\right) \\left(\\sin{\\left(x \\right)} + 4\\right)" :db/id #edb/ref 17592186530635}] :answer-field/correct {:answer/id #uuid "43a3772e-3d63-5146-b44e-05174cd970a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(12 x^{2} + 4\\right) \\left(\\sin{\\left(x \\right)} + 4\\right) + \\left(4 x^{3} + 4 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530601} :answer-field/id #uuid "5c90dacf-27e8-5325-9bdb-f01d716e1f90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530611}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "726118ef-5aa2-561b-b07d-8ea17d1719c5" :question/problem "Differentiate $(4 x^{3} + 4 x)(\\sin{\\left(x \\right)} + 4).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=4 x^{3} + 4 x$ and $v(x)=\\sin{\\left(x \\right)} + 4.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((4 x^{3} + 4 x)(\\sin{\\left(x \\right)} + 4))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(4 x^{3} + 4 x)'\\cdot (\\sin{\\left(x \\right)} + 4)+(4 x^{3} + 4 x)\\cdot (\\sin{\\left(x \\right)} + 4)' \\\\ & =(12 x^{2} + 4)(\\sin{\\left(x \\right)} + 4)+(4 x^{3} + 4 x)(\\cos{\\left(x \\right)}) \\\\ & =4 x^{3} \\cos{\\left(x \\right)} + 12 x^{2} \\sin{\\left(x \\right)} + 48 x^{2} + 4 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} + 16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8931e3-4d31-5643-8d6e-cfe900786972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 x - 2\\right) \\left(\\sin{\\left(x \\right)} - 1\\right)" :db/id #edb/ref 17592186530587} {:answer/id #uuid "4394cdc0-706e-5272-bc32-f08d9ea5a0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 x - 2\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530600} {:answer/id #uuid "597c0426-66ed-5d40-8d24-4bd715960a44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 x - 2\\right) \\left(\\sin{\\left(x \\right)} - 1\\right) + \\left(3 x^{2} - 2 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530610} {:answer/id #uuid "690cbc32-19d2-5c0f-a3d4-e812707db23b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(3 x^{2} - 2 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530614} {:answer/id #uuid "ebf517a5-ea05-52ef-8268-b30145546a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 x - 2\\right) \\left(\\sin{\\left(x \\right)} - 1\\right) - \\left(3 x^{2} - 2 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530646}] :answer-field/correct {:answer/id #uuid "597c0426-66ed-5d40-8d24-4bd715960a44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6 x - 2\\right) \\left(\\sin{\\left(x \\right)} - 1\\right) + \\left(3 x^{2} - 2 x\\right) \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186530610} :answer-field/id #uuid "63ac5143-f775-5d0c-a419-515a551a07a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530612}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "94a83bf3-2f19-5bd8-9519-a3fb2385c4db" :question/problem "Differentiate $(3 x^{2} - 2 x)(\\sin{\\left(x \\right)} - 1).$" :question/worked-solution "Here, we have the product of the two functions $u(x)=3 x^{2} - 2 x$ and $v(x)=\\sin{\\left(x \\right)} - 1.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((3 x^{2} - 2 x)(\\sin{\\left(x \\right)} - 1))^{'} & =u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ & =(3 x^{2} - 2 x)'\\cdot (\\sin{\\left(x \\right)} - 1)+(3 x^{2} - 2 x)\\cdot (\\sin{\\left(x \\right)} - 1)' \\\\ & =(6 x - 2)(\\sin{\\left(x \\right)} - 1)+(3 x^{2} - 2 x)(\\cos{\\left(x \\right)}) \\\\ & =3 x^{2} \\cos{\\left(x \\right)} + 6 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} - 6 x - 2 \\sin{\\left(x \\right)} + 2\\end{aligned}\n$$"}]}
