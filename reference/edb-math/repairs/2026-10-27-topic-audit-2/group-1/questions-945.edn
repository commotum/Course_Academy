6\\csc \\theta+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-2\\sec \\theta-6\\csc \\theta$ gives $-2\\sec \\theta\\tan \\theta+6\\csc \\theta\\cot \\theta$."}] [{:db/id #edb/ref 17592186721264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a5c606-6f93-581c-a931-5894574c810c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos \\theta-4\\csc \\theta+C" :db/id #edb/ref 17592186721245} {:answer/id #uuid "2038f27c-e37f-5c5d-8787-205b84d4dcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos \\theta-4\\csc \\theta+C" :db/id #edb/ref 17592186721250} {:answer/id #uuid "84d57138-7509-570b-bf09-188f0eeacccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos^{2} \\theta+4\\csc^{2} \\theta+C" :db/id #edb/ref 17592186721263} {:answer/id #uuid "92a4c17a-076b-5651-a67e-9ae5ac2b974b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos \\theta+4\\csc \\theta+C" :db/id #edb/ref 17592186721266} {:answer/id #uuid "faecb1ed-2138-5d04-8bb9-1468890f1a8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos \\theta+4\\csc \\theta+C" :db/id #edb/ref 17592186721279}] :answer-field/correct {:answer/id #uuid "92a4c17a-076b-5651-a67e-9ae5ac2b974b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos \\theta+4\\csc \\theta+C" :db/id #edb/ref 17592186721266} :answer-field/id #uuid "e9740eaa-ab5b-5088-898b-d96530d3aab6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721278}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8965b370-4837-54d9-9091-cd97a78842ee" :question/problem "Calculate\n\n$$\n\\displaystyle \\int (\\sin \\theta-4\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta.\n$$" :question/worked-solution "Recall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\sin \\theta)\\,\\mathrm{d}\\theta&=-\\cos \\theta+C. \\\\\n\\int (\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta&=-\\csc \\theta+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (\\sin \\theta-4\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta \\\\\n&=\\int (\\sin \\theta)\\,\\mathrm{d}\\theta-4\\int (\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta \\\\\n&=(-\\cos \\theta)-4(-\\csc \\theta)+C \\\\\n&=-\\cos \\theta+4\\csc \\theta+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-\\cos \\theta+4\\csc \\theta$ gives $\\sin \\theta-4\\csc \\theta\\cot \\theta$."}] [{:db/id #edb/ref 17592186721281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0278b9-fbd6-5046-a878-a64454adceba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sec x-2\\csc x+C" :db/id #edb/ref 17592186721290} {:answer/id #uuid "8a5862c3-de9b-52b3-a224-5af3a55ca955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec x+2\\csc x+C" :db/id #edb/ref 17592186721295} {:answer/id #uuid "9d4c31a7-0efb-5de0-aae1-0974c318f6db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan x+2\\cot x+C" :db/id #edb/ref 17592186721297} {:answer/id #uuid "ba4f6d97-227a-5a43-959d-963dc80d90c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sec x+2\\csc x+C" :db/id #edb/ref 17592186721300} {:answer/id #uuid "ea8780b5-bf7f-5afd-81dc-7d3002849313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec x-2\\csc x+C" :db/id #edb/ref 17592186721306}] :answer-field/correct {:answer/id #uuid "ba4f6d97-227a-5a43-959d-963dc80d90c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sec x+2\\csc x+C" :db/id #edb/ref 17592186721300} :answer-field/id #uuid "a1402e54-7e2e-5cb2-9932-528c59cd69ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721298}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "036ac889-1ba3-5442-b209-2101223c1351" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\left(\\frac{-\\sin^{3} x-2\\cos^{3} x}{\\sin^{2} x\\cos^{2} x}\\right)\\,\\mathrm{d}x.\n$$\n\nWork on an interval where $\\sin x\\cos x\\ne 0$." :question/worked-solution "Split the fraction and cancel common factors in each term:\n\n$$\n\\begin{aligned}\n&\\frac{-\\sin^{3} x-2\\cos^{3} x}{\\sin^{2} x\\cos^{2} x} \\\\\n&=-\\frac{\\sin^{3} x}{\\sin^{2} x\\cos^{2} x}-2\\frac{\\cos^{3} x}{\\sin^{2} x\\cos^{2} x} \\\\\n&=-\\frac{\\sin x}{\\cos^{2} x}-2\\frac{\\cos x}{\\sin^{2} x}\n\\end{aligned}\n$$\n\nUse the reciprocal and quotient definitions:\n\n$$\n\\begin{aligned}\n\\frac{\\sin x}{\\cos^{2} x}&=\\frac{1}{\\cos x}\\cdot\\frac{\\sin x}{\\cos x}=\\sec x\\tan x \\\\\n\\frac{\\cos x}{\\sin^{2} x}&=\\frac{1}{\\sin x}\\cdot\\frac{\\cos x}{\\sin x}=\\csc x\\cot x\n\\end{aligned}\n$$\n\nThe integrand is therefore $-\\sec x\\tan x-2\\csc x\\cot x$. These cancellations hold on the stated interval.\n\nRecall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\sec x\\tan x)\\,\\mathrm{d}x&=\\sec x+C. \\\\\n\\int (\\csc x\\cot x)\\,\\mathrm{d}x&=-\\csc x+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (-\\sec x\\tan x-2\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=-\\int (\\sec x\\tan x)\\,\\mathrm{d}x-2\\int (\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=-(\\sec x)-2(-\\csc x)+C \\\\\n&=-\\sec x+2\\csc x+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-\\sec x+2\\csc x$ gives $-\\sec x\\tan x-2\\csc x\\cot x$."}] [{:db/id #edb/ref 17592186721287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185e5126-99a1-5bd3-b4dc-73ac152ea480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\csc^{2} \\theta-4\\sec^{2} \\theta+C" :db/id #edb/ref 17592186721285} {:answer/id #uuid "70716f83-4daa-55b9-a28c-03580c95e535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\csc \\theta-4\\sec \\theta+C" :db/id #edb/ref 17592186721292} {:answer/id #uuid "8426cf39-637a-59a4-9482-81426e248edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\csc \\theta+4\\sec \\theta+C" :db/id #edb/ref 17592186721294} {:answer/id #uuid "c3255cb1-dfd7-5cd9-bf5a-90aceace4617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\csc \\theta+4\\sec \\theta+C" :db/id #edb/ref 17592186721301} {:answer/id #uuid "c7225bf7-a859-5667-ae84-16bb3d54307c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\csc \\theta-4\\sec \\theta+C" :db/id #edb/ref 17592186721302}] :answer-field/correct {:answer/id #uuid "70716f83-4daa-55b9-a28c-03580c95e535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\csc \\theta-4\\sec \\theta+C" :db/id #edb/ref 17592186721292} :answer-field/id #uuid "79815897-4fbe-5a60-a6ec-66d9c7c61b6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721293}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "46800208-d1a1-5ec7-bd4c-a7c0c735ac62" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\left(\\frac{\\cos^{3} \\theta-4\\sin^{3} \\theta}{\\sin^{2} \\theta\\cos^{2} \\theta}\\right)\\,\\mathrm{d}\\theta.\n$$\n\nWork on an interval where $\\sin \\theta\\cos \\theta\\ne 0$." :question/worked-solution "Split the fraction and cancel common factors in each term:\n\n$$\n\\begin{aligned}\n&\\frac{\\cos^{3} \\theta-4\\sin^{3} \\theta}{\\sin^{2} \\theta\\cos^{2} \\theta} \\\\\n&=\\frac{\\cos^{3} \\theta}{\\sin^{2} \\theta\\cos^{2} \\theta}-4\\frac{\\sin^{3} \\theta}{\\sin^{2} \\theta\\cos^{2} \\theta} \\\\\n&=\\frac{\\cos \\theta}{\\sin^{2} \\theta}-4\\frac{\\sin \\theta}{\\cos^{2} \\theta}\n\\end{aligned}\n$$\n\nUse the reciprocal and quotient definitions:\n\n$$\n\\begin{aligned}\n\\frac{\\sin \\theta}{\\cos^{2} \\theta}&=\\frac{1}{\\cos \\theta}\\cdot\\frac{\\sin \\theta}{\\cos \\theta}=\\sec \\theta\\tan \\theta \\\\\n\\frac{\\cos \\theta}{\\sin^{2} \\theta}&=\\frac{1}{\\sin \\theta}\\cdot\\frac{\\cos \\theta}{\\sin \\theta}=\\csc \\theta\\cot \\theta\n\\end{aligned}\n$$\n\nThe integrand is therefore $\\csc \\theta\\cot \\theta-4\\sec \\theta\\tan \\theta$. These cancellations hold on the stated interval.\n\nRecall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta&=-\\csc \\theta+C. \\\\\n\\int (\\sec \\theta\\tan \\theta)\\,\\mathrm{d}\\theta&=\\sec \\theta+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (\\csc \\theta\\cot \\theta-4\\sec \\theta\\tan \\theta)\\,\\mathrm{d}\\theta \\\\\n&=\\int (\\csc \\theta\\cot \\theta)\\,\\mathrm{d}\\theta-4\\int (\\sec \\theta\\tan \\theta)\\,\\mathrm{d}\\theta \\\\\n&=(-\\csc \\theta)-4(\\sec \\theta)+C \\\\\n&=-\\csc \\theta-4\\sec \\theta+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-\\csc \\theta-4\\sec \\theta$ gives $\\csc \\theta\\cot \\theta-4\\sec \\theta\\tan \\theta$."}] [{:db/id #edb/ref 17592186721288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1409f530-9aa2-5083-a1b9-84141ef24eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\csc^{2} y-2\\sec^{2} y+C" :db/id #edb/ref 17592186721284} {:answer/id #uuid "9a01b67b-773d-5b5c-9ed8-ab330a3a018c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\csc y+2\\sec y+C" :db/id #edb/ref 17592186721296} {:answer/id #uuid "ab5c9ea6-fd95-5402-b135-21ee90acf19b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\csc y-2\\sec y+C" :db/id #edb/ref 17592186721299} {:answer/id #uuid "d9823824-e4b5-5d06-a67d-52503ff37045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\csc y+2\\sec y+C" :db/id #edb/ref 17592186721304} {:answer/id #uuid "f8290c70-018d-557d-b537-f1265c0bd7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\csc y-2\\sec y+C" :db/id #edb/ref 17592186721307}] :answer-field/correct {:answer/id #uuid "d9823824-e4b5-5d06-a67d-52503ff37045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\csc y+2\\sec y+C" :db/id #edb/ref 17592186721304} :answer-field/id #uuid "08c8a539-3379-525e-9a03-64993f65c0cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721283}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4a09deb9-aa59-56e0-ad86-91189075eb80" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\left(\\frac{-4\\cos^{3} y+2\\sin^{3} y}{\\sin^{2} y\\cos^{2} y}\\right)\\,\\mathrm{d}y.\n$$\n\nWork on an interval where $\\sin y\\cos y\\ne 0$." :question/worked-solution "Split the fraction and cancel common factors in each term:\n\n$$\n\\begin{aligned}\n&\\frac{-4\\cos^{3} y+2\\sin^{3} y}{\\sin^{2} y\\cos^{2} y} \\\\\n&=-4\\frac{\\cos^{3} y}{\\sin^{2} y\\cos^{2} y}+2\\frac{\\sin^{3} y}{\\sin^{2} y\\cos^{2} y} \\\\\n&=-4\\frac{\\cos y}{\\sin^{2} y}+2\\frac{\\sin y}{\\cos^{2} y}\n\\end{aligned}\n$$\n\nUse the reciprocal and quotient definitions:\n\n$$\n\\begin{aligned}\n\\frac{\\sin y}{\\cos^{2} y}&=\\frac{1}{\\cos y}\\cdot\\frac{\\sin y}{\\cos y}=\\sec y\\tan y \\\\\n\\frac{\\cos y}{\\sin^{2} y}&=\\frac{1}{\\sin y}\\cdot\\frac{\\cos y}{\\sin y}=\\csc y\\cot y\n\\end{aligned}\n$$\n\nThe integrand is therefore $-4\\csc y\\cot y+2\\sec y\\tan y$. These cancellations hold on the stated interval.\n\nRecall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\csc y\\cot y)\\,\\mathrm{d}y&=-\\csc y+C. \\\\\n\\int (\\sec y\\tan y)\\,\\mathrm{d}y&=\\sec y+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (-4\\csc y\\cot y+2\\sec y\\tan y)\\,\\mathrm{d}y \\\\\n&=-4\\int (\\csc y\\cot y)\\,\\mathrm{d}y+2\\int (\\sec y\\tan y)\\,\\mathrm{d}y \\\\\n&=-4(-\\csc y)+2(\\sec y)+C \\\\\n&=4\\csc y+2\\sec y+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $4\\csc y+2\\sec y$ gives $-4\\csc y\\cot y+2\\sec y\\tan y$."}] [{:db/id #edb/ref 17592186721289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0750d66a-eb38-5e97-ae4d-f2f0b87283c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sec x-\\csc x+C" :db/id #edb/ref 17592186721282} {:answer/id #uuid "3bec7f85-168c-5188-b166-e1505ea27280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2} x-\\csc^{2} x+C" :db/id #edb/ref 17592186721286} {:answer/id #uuid "583684cd-7953-5bc3-b85d-997d934ea1d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec x+\\csc x+C" :db/id #edb/ref 17592186721291} {:answer/id #uuid "e75a3991-9c96-547b-86a2-11293eda8b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec x-\\csc x+C" :db/id #edb/ref 17592186721305} {:answer/id #uuid "ffaebf2f-2040-5240-9634-51db754945be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sec x+\\csc x+C" :db/id #edb/ref 17592186721308}] :answer-field/correct {:answer/id #uuid "e75a3991-9c96-547b-86a2-11293eda8b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec x-\\csc x+C" :db/id #edb/ref 17592186721305} :answer-field/id #uuid "d7ed47b0-b0b1-5993-bb82-258da87e1397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721303}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4c184899-77d0-51bc-a850-504f0c8d010f" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\left(\\frac{\\sin^{3} x+\\cos^{3} x}{\\sin^{2} x\\cos^{2} x}\\right)\\,\\mathrm{d}x.\n$$\n\nWork on an interval where $\\sin x\\cos x\\ne 0$." :question/worked-solution "Split the fraction and cancel common factors in each term:\n\n$$\n\\begin{aligned}\n&\\frac{\\sin^{3} x+\\cos^{3} x}{\\sin^{2} x\\cos^{2} x} \\\\\n&=\\frac{\\sin^{3} x}{\\sin^{2} x\\cos^{2} x}+\\frac{\\cos^{3} x}{\\sin^{2} x\\cos^{2} x} \\\\\n&=\\frac{\\sin x}{\\cos^{2} x}+\\frac{\\cos x}{\\sin^{2} x}\n\\end{aligned}\n$$\n\nUse the reciprocal and quotient definitions:\n\n$$\n\\begin{aligned}\n\\frac{\\sin x}{\\cos^{2} x}&=\\frac{1}{\\cos x}\\cdot\\frac{\\sin x}{\\cos x}=\\sec x\\tan x \\\\\n\\frac{\\cos x}{\\sin^{2} x}&=\\frac{1}{\\sin x}\\cdot\\frac{\\cos x}{\\sin x}=\\csc x\\cot x\n\\end{aligned}\n$$\n\nThe integrand is therefore $\\sec x\\tan x+\\csc x\\cot x$. These cancellations hold on the stated interval.\n\nRecall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\sec x\\tan x)\\,\\mathrm{d}x&=\\sec x+C. \\\\\n\\int (\\csc x\\cot x)\\,\\mathrm{d}x&=-\\csc x+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (\\sec x\\tan x+\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=\\int (\\sec x\\tan x)\\,\\mathrm{d}x+\\int (\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=(\\sec x)+(-\\csc x)+C \\\\\n&=\\sec x-\\csc x+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $\\sec x-\\csc x$ gives $\\sec x\\tan x+\\csc x\\cot x$."}] [{:db/id #edb/ref 17592186721340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ae2234-e488-5d82-a11e-ce6d5faec65c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\csc t-4\\cot t+C" :db/id #edb/ref 17592186721331} {:answer/id #uuid "80274eed-4f94-52ee-ba0e-bdc2ec5d4c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\csc t+4\\cot t+C" :db/id #edb/ref 17592186721344} {:answer/id #uuid "c68c86d4-db8b-5b75-86fd-e561132da2fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc t+4\\cot t+C" :db/id #edb/ref 17592186721353} {:answer/id #uuid "e04887e4-b441-58b2-a2a8-f27e148e32ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\csc t+4\\cot t+C" :db/id #edb/ref 17592186721357} {:answer/id #uuid "e9d08b30-1a4c-5a02-9b42-f0237282d877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc t-4\\cot t+C" :db/id #edb/ref 17592186721360}] :answer-field/correct {:answer/id #uuid "80274eed-4f94-52ee-ba0e-bdc2ec5d4c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\csc t+4\\cot t+C" :db/id #edb/ref 17592186721344} :answer-field/id #uuid "5bd268fd-3619-57f2-836a-9f4b29b6a2bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721338}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5eb0ccb4-5627-5a63-9f19-3a7bdf034e0a" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\csc t\\bigl(-4\\csc t-6\\cot t\\bigr)\\,\\mathrm{d}t.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\csc t\\cot t\\,\\mathrm{d}t&=-\\csc t+C, \\\\ \\int \\csc^2 t\\,\\mathrm{d}t&=-\\cot t+C.\\end{aligned}\n$$\n\nLet $I$ be the requested integral. Expand the product:\n\n$$\nI=\\int\\bigl(-6\\csc t\\cot t-4\\csc^2 t\\bigr)\\,\\mathrm{d}t.\n$$\n\n$$\n\\begin{aligned}I&=-6\\int \\csc t\\cot t\\,\\mathrm{d}t \\\\ &\\quad-4\\int \\csc^2 t\\,\\mathrm{d}t\\end{aligned}\n$$\n\nApply the formulas and simplify the signs:\n\n$$\n\\begin{aligned}I&=-6(-\\csc t)-4(-\\cot t)+C \\\\ &=6\\csc t+4\\cot t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4822eec6-4fe0-50dc-9972-9337dd3e9642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\cot t-3\\sec t+C" :db/id #edb/ref 17592186721336} {:answer/id #uuid "5e9fcb3c-9fbd-5a99-a34b-5350a83f7f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cot t+3\\sec t+C" :db/id #edb/ref 17592186721339} {:answer/id #uuid "8367c5a1-1067-5679-bc2d-5b0c6c258be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\cot t+6\\sec t+C" :db/id #edb/ref 17592186721345} {:answer/id #uuid "a5a56920-6b92-53f7-80cf-80b5e3650a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cot t-3\\sec t+C" :db/id #edb/ref 17592186721350} {:answer/id #uuid "aa839f9f-4f19-5077-82df-5fc3d986a723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\cot t+3\\sec t+C" :db/id #edb/ref 17592186721351}] :answer-field/correct {:answer/id #uuid "a5a56920-6b92-53f7-80cf-80b5e3650a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\cot t-3\\sec t+C" :db/id #edb/ref 17592186721350} :answer-field/id #uuid "ea65711a-d130-57e6-a0fe-50eda8f2ff67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721361}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "62dd8be4-6607-5ab7-aa52-67e24d6c957c" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\bigl(-6\\csc^2 t-3\\sec t\\tan t\\bigr)\\,\\mathrm{d}t.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\csc^2 t\\,\\mathrm{d}t&=-\\cot t+C, \\\\ \\int \\sec t\\tan t\\,\\mathrm{d}t&=\\sec t+C.\\end{aligned}\n$$\n\nLet $I$ be the requested integral. Use linearity.\n\n$$\n\\begin{aligned}I&=-6\\int \\csc^2 t\\,\\mathrm{d}t \\\\ &\\quad-3\\int \\sec t\\tan t\\,\\mathrm{d}t\\end{aligned}\n$$\n\nApply the formulas and simplify the signs:\n\n$$\n\\begin{aligned}I&=-6(-\\cot t)-3(\\sec t)+C \\\\ &=6\\cot t-3\\sec t+C.\\end{aligned}\n$$"}]}
