#{[{:db/id #edb/ref 17592186720759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49fe6901-c10c-56f4-ab96-f8aa818b9be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sin x-8\\cos x+C" :db/id #edb/ref 17592186720755} {:answer/id #uuid "66aeae76-44d1-5b20-8e1d-d0c710abb5e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos x+8\\sin x+C" :db/id #edb/ref 17592186720757} {:answer/id #uuid "b22bae15-d38e-5747-a598-08b175293b18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos x-8\\sin x+C" :db/id #edb/ref 17592186720764} {:answer/id #uuid "f02c03cc-4c3e-54cc-93a9-c57a5c12f4d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\cos x+4\\sin x+C" :db/id #edb/ref 17592186720770} {:answer/id #uuid "f44e353e-da4d-51ba-99a6-5850011ccff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos x-8\\sin x+C" :db/id #edb/ref 17592186720772}] :answer-field/correct {:answer/id #uuid "b22bae15-d38e-5747-a598-08b175293b18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos x-8\\sin x+C" :db/id #edb/ref 17592186720764} :answer-field/id #uuid "aa53571d-913a-5954-90eb-b9fca68152d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720762}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "83ab412c-dc62-574b-b672-08b0f5a624d7" :question/problem "Calculate\n\n$$\n\\int \\bigl[2(\\sin x-\\cos x)-3(\\sin x+2\\cos x)\\bigr]\\,\\mathrm{d}x.\n$$" :question/worked-solution "First distribute both constant factors and collect the sine and cosine terms. The minus sign before the second group applies to both terms:\n\n$$\n\\begin{aligned}\n&2(\\sin x-\\cos x)-3(\\sin x+2\\cos x)\\\\\n&=2\\sin x-2\\cos x-3\\sin x-6\\cos x\\\\\n&=-\\sin x-8\\cos x.\n\\end{aligned}\n$$\n\nRecall that\n\n$$\n\\begin{aligned}\n\\int \\sin x\\,\\mathrm{d}x&=-\\cos x+C,\\\\\n\\int \\cos x\\,\\mathrm{d}x&=\\sin x+C.\n\\end{aligned}\n$$\n\nNow integrate term by term:\n\n$$\n\\begin{aligned}\n\\int (-\\sin x-8\\cos x)\\,\\mathrm{d}x\n&=-\\int \\sin x\\,\\mathrm{d}x-8\\int \\cos x\\,\\mathrm{d}x\\\\\n&=-(-\\cos x)-8\\sin x+C\\\\\n&=\\cos x-8\\sin x+C.\n\\end{aligned}\n$$\n\nCheck by differentiating: the derivative is $-\\sin x-8\\cos x$, which equals the original grouped integrand."}] [{:db/id #edb/ref 17592186720768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00206625-0c55-5585-97aa-df0237450219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos x+4\\sin x+C" :db/id #edb/ref 17592186720752} {:answer/id #uuid "8bc37496-8456-572a-a786-ce31384864dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos x+4\\sin x+C" :db/id #edb/ref 17592186720760} {:answer/id #uuid "9c5275f6-1818-5c93-b837-ffb4b9f952c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sin x+4\\cos x+C" :db/id #edb/ref 17592186720761} {:answer/id #uuid "ceee7b87-2089-5015-92b9-188d659bb0cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cos x-4\\sin x+C" :db/id #edb/ref 17592186720767} {:answer/id #uuid "eeaca03a-18f7-5507-ad89-e5ce83ae63ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos x-4\\sin x+C" :db/id #edb/ref 17592186720769}] :answer-field/correct {:answer/id #uuid "8bc37496-8456-572a-a786-ce31384864dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos x+4\\sin x+C" :db/id #edb/ref 17592186720760} :answer-field/id #uuid "f2d7cc6f-8910-594d-9d94-36cb243f47b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720771}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d616b2fc-2972-567c-a9e4-ca35be29f17e" :question/problem "Calculate\n\n$$\n\\int (-2\\sin x+4\\cos x)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\n\\int \\sin x\\,\\mathrm{d}x&=-\\cos x+C,\\\\\n\\int \\cos x\\,\\mathrm{d}x&=\\sin x+C.\n\\end{aligned}\n$$\n\nUse the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\n&\\int (-2\\sin x+4\\cos x)\\,\\mathrm{d}x\\\\\n&=-2\\int \\sin x\\,\\mathrm{d}x+4\\int \\cos x\\,\\mathrm{d}x\\\\\n&=-2(-\\cos x)+4\\sin x+C\\\\\n&=2\\cos x+4\\sin x+C.\n\\end{aligned}\n$$\n\nThe two constants of integration combine into one arbitrary constant $C$. Differentiating the result gives $-2\\sin x+4\\cos x$."}] [{:db/id #edb/ref 17592186720874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f05cb7-8674-5921-a433-22f8fd3b392f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sin \\theta+5\\cos \\theta+C" :db/id #edb/ref 17592186720884} {:answer/id #uuid "734af65f-079f-5800-8239-2662e9cdd599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sin \\theta-5\\cos \\theta+C" :db/id #edb/ref 17592186720887} {:answer/id #uuid "9919ddc3-a264-52dc-93bf-5a0ce3b9bb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\sin \\theta-5\\cos \\theta+C" :db/id #edb/ref 17592186720893} {:answer/id #uuid "e67f3dfb-6993-5c48-826a-ad04a4ae7464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\cos \\theta+C" :db/id #edb/ref 17592186720903} {:answer/id #uuid "fbeb5564-448c-56e0-8fc5-3f9b5d7a7dc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sin \\theta+5\\cos \\theta+C" :db/id #edb/ref 17592186720908}] :answer-field/correct {:answer/id #uuid "734af65f-079f-5800-8239-2662e9cdd599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sin \\theta-5\\cos \\theta+C" :db/id #edb/ref 17592186720887} :answer-field/id #uuid "88fd5c45-f5f5-582a-9ee9-c3c8336f6a4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186720890}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "021bf73a-089a-5827-9da0-e805e9e3072a" :question/problem "Calculate\n\n$$\n\\int \\bigl[5\\sin \\theta+5\\cos \\theta\\bigr]\\,\\mathrm{d}\\theta.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\n\\int \\sin \\theta\\,\\mathrm{d}\\theta&=-\\cos \\theta+C.\\\\\n\\int \\cos \\theta\\,\\mathrm{d}\\theta&=\\sin \\theta+C.\n\\end{aligned}\n$$\n\nUse the constant multiple and sum rules:\n\n$$\n\\begin{aligned}\n&\\int \\bigl(5\\sin \\theta+5\\cos \\theta\\bigr)\\,\\mathrm{d}\\theta\\\\\n&=5\\int \\sin \\theta\\,\\mathrm{d}\\theta+5\\int \\cos \\theta\\,\\mathrm{d}\\theta\\\\\n&=5\\bigl(-\\cos \\theta\\bigr)+5\\bigl(\\sin \\theta\\bigr)+C\\\\\n&=5\\sin \\theta-5\\cos \\theta+C.\n\\end{aligned}\n$$\n\nHere $C$ is an arbitrary constant. Differentiating the result gives $5\\sin \\theta+5\\cos \\theta$."}] [{:db/id #edb/ref 17592186720881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e379040-0879-5fd5-8646-3bcda44c92dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sin x-6\\cos x+C" :db/id #edb/ref 17592186720878} {:answer/id #uuid "529ee70c-b4c8-5a64-bf0a-e3e404d419e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sin x+6\\cos x+C" :db/id #edb/ref 17592186720882} {:answer/id #uuid "52ef20a2-e655-5c29-834e-c0a0cf7e257f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sin x+6\\cos x+C" :db/id #edb/ref 17592186720883} {:answer/id