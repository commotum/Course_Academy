 y\\\\\n&=5\\cos y+2\\sin y.\n\\end{aligned}\n$$\n\nRecall that\n\n$$\n\\begin{aligned}\n\\int \\sin y\\,\\mathrm{d}y&=-\\cos y+C.\\\\\n\\int \\cos y\\,\\mathrm{d}y&=\\sin y+C.\n\\end{aligned}\n$$\n\nUse the constant multiple and sum rules:\n\n$$\n\\begin{aligned}\n&\\int \\bigl(5\\cos y+2\\sin y\\bigr)\\,\\mathrm{d}y\\\\\n&=5\\int \\cos y\\,\\mathrm{d}y+2\\int \\sin y\\,\\mathrm{d}y\\\\\n&=5\\bigl(\\sin y\\bigr)+2\\bigl(-\\cos y\\bigr)+C\\\\\n&=-2\\cos y+5\\sin y+C.\n\\end{aligned}\n$$\n\nHere $C$ is an arbitrary constant. Differentiating the result gives $5\\cos y+2\\sin y$."}] [{:db/id #edb/ref 17592186720973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27721acf-ae8c-5fb8-b43d-837c4889375e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos \\theta-5\\sin \\theta+C" :db/id #edb/ref 17592186720965} {:answer/id #uuid "6b692984-3c5f-51d0-a383-734365d5a5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\cos \\theta+\\sin \\theta+C" :db/id #edb/ref 17592186720972} {:answer/id #uuid "a808932e-1812-580b-84be-9a4773b1f658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos \\theta+5\\sin \\theta+C" :db/id #edb/ref 17592186720981} {:answer/id #uuid "c447f59d-b0da-547a-80be-6f4846140df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\cos \\theta-5\\sin \\theta+C" :db/id #edb/ref 17592186720984} {:answer/id #uuid "ca091a01-5648-5126-a4e8-e04d1b362af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos \\theta+5\\sin \\theta+C" :db/id #edb/ref 17592186720985}] :answer-field/correct {:answer/id #uuid "ca091a01-5648-5126-a4e8-e04d1b362af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos \\theta+5\\sin \\theta+C" :db/id #edb/ref 17592186720985} :answer-field/id #uuid "fd77edbc-48a1-5972-84f