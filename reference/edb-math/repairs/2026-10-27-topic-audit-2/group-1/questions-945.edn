pe/math} :answer/value "2\\sec x-3\\cot x-\\cos x+C" :db/id #edb/ref 17592186721025} {:answer/id #uuid "98a339da-0f40-5ca7-bf7e-0e8b18e05cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sec x+3\\cot x-\\cos x+C" :db/id #edb/ref 17592186721027} {:answer/id #uuid "99549723-ffac-5166-8e89-c6771894bd8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sec x\\tan x+3\\cot x-\\cos x+C" :db/id #edb/ref 17592186721028} {:answer/id #uuid "cfd389de-a595-5a89-9b0e-fae3ef435d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sec x+3\\cot x-\\cos x+C" :db/id #edb/ref 17592186721036} {:answer/id #uuid "da1271b5-f71c-5c87-8b30-e8b8feb9b62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sec x+3\\cot x+\\cos x+C" :db/id #edb/ref 17592186721038}] :answer-field/correct {:answer/id #uuid "98a339da-0f40-5ca7-bf7e-0e8b18e05cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sec x+3\\cot x-\\cos x+C" :db/id #edb/ref 17592186721027} :answer-field/id #uuid "f04420b4-0e91-5586-af1a-379249c16da8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721039}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c4721d32-5506-5280-902c-24a9acc86dd1" :question/problem "Calculate\n\n$$\n\\displaystyle \\int (2\\sec x\\tan x-3\\csc^2x+\\sin x)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int\\sec x\\tan x\\,\\mathrm{d}x&=\\sec x+C, \\\\ \\int\\csc^2x\\,\\mathrm{d}x&=-\\cot x+C, \\\\ \\int\\sin x\\,\\mathrm{d}x&=-\\cos x+C.\\end{aligned}\n$$\n\nLet $I$ be the requested integral. Separate the three terms:\n\n$$\n\\begin{aligned}I&=2\\int\\sec x\\tan x\\,\\mathrm{d}x \\\\ &\\quad-3\\int\\csc^2x\\,\\mathrm{d}x+\\int\\sin x\\,\\mathrm{d}x.\\end{aligned}\n$$\n\nSubstitute the antiderivatives, keeping the signs:\n\n$$\n\\begin{aligned}I&=2\\sec x-3(-\\cot x)-\\cos x+C \\\\ &=2\\sec x+3\\cot x-\\cos x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186721252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b8c8eb-0b54-581b-8189-68d690447cd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cos x+8\\cot x+C" :db/id #edb/ref 17592186721251} {:answer/id #uuid "41c5a493-79f3-5682-b817-ac95702ac14a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\cos x-8\\csc x+C" :db/id #edb/ref 17592186721256} {:answer/id #uuid "6f1f67a2-52aa-5f56-9238-fc0460cdd3c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cos x-8\\csc x+C" :db/id #edb/ref 17592186721262} {:answer/id #uuid "ad843755-dc11-5f22-9e2f-7bdccd8031b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\cos x+8\\csc x+C" :db/id #edb/ref 17592186721272} {:answer/id #uuid "cc96a3d4-a441-5b74-8c1d-8eba9d2b26d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cos x+8\\csc x+C" :db/id #edb/ref 17592186721274}] :answer-field/correct {:answer/id #uuid "ad843755-dc11-5f22-9e2f-7bdccd8031b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\cos x+8\\csc x+C" :db/id #edb/ref 17592186721272} :answer-field/id #uuid "06810dfa-f041-5d9b-adaa-9c4638327a17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721246}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2724ee3f-0c7f-5e1f-aa6b-2f90f6ec5936" :question/problem "Calculate\n\n$$\n\\displaystyle \\int (-8\\sin x-8\\csc x\\cot x)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Recall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\sin x)\\,\\mathrm{d}x&=-\\cos x+C. \\\\\n\\int (\\csc x\\cot x)\\,\\mathrm{d}x&=-\\csc x+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (-8\\sin x-8\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=-8\\int (\\sin x)\\,\\mathrm{d}x-8\\int (\\csc x\\cot x)\\,\\mathrm{d}x \\\\\n&=-8(-\\cos x)-8(-\\csc x)+C \\\\\n&=8\\cos x+8\\csc x+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $8\\cos x+8\\csc x$ gives $-8\\sin x-8\\csc x\\cot x$."}] [{:db/id #edb/ref 17592186721254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b49796d-141b-5b7f-956d-88e84ed9cfb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\csc y+\\cos y+C" :db/id #edb/ref 17592186721247} {:answer/id #uuid "17ccf6d4-ea9e-539e-a472-843edb27e114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc y+\\cos y+C" :db/id #edb/ref 17592186721248} {:answer/id #uuid "688006b9-c685-5287-981f-e4bb0ba077a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc^{2} y+\\cos^{2} y+C" :db/id #edb/ref 17592186721261} {:answer/id #uuid "995369d3-ddf2-52ed-a156-7daff2d0e09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\csc y-\\cos y+C" :db/id #edb/ref 17592186721268} {:answer/id #uuid "9bdbb863-64d4-5023-ab56-dbb764be1662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc y-\\cos y+C" :db/id #edb/ref 17592186721269}] :answer-field/correct {:answer/id #uuid "9bdbb863-64d4-5023-ab56-dbb764be1662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\csc y-\\cos y+C" :db/id #edb/ref 17592186721269} :answer-field/id #uuid "ddaf8b59-6c29-5785-a789-400fbdc7ecd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721276}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "29db8ebe-a81c-548d-9e6d-18aa0a75ee07" :question/problem "Calculate\n\n$$\n\\displaystyle \\int (6\\csc y\\cot y+\\sin y)\\,\\mathrm{d}y.\n$$" :question/worked-solution "Recall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\csc y\\cot y)\\,\\mathrm{d}y&=-\\csc y+C. \\\\\n\\int (\\sin y)\\,\\mathrm{d}y&=-\\cos y+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (6\\csc y\\cot y+\\sin y)\\,\\mathrm{d}y \\\\\n&=6\\int (\\csc y\\cot y)\\,\\mathrm{d}y+\\int (\\sin y)\\,\\mathrm{d}y \\\\\n&=6(-\\csc y)+(-\\cos y)+C \\\\\n&=-6\\csc y-\\cos y+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-6\\csc y-\\cos y$ gives $6\\csc y\\cot y+\\sin y$."}] [{:db/id #edb/ref 17592186721257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19cb3b6f-c176-51e8-9108-97337f9fac05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sec \\theta+4\\sin \\theta+C" :db/id #edb/ref 17592186721249} {:answer/id #uuid "2970b5b0-5c7c-5a72-ab6b-5aab00a59805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sec \\theta+4\\sin \\theta+C" :db/id #edb/ref 17592186721253} {:answer/id #uuid "5ddec8b5-de0f-51ed-9a42-238a0ecf4145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sec \\theta-4\\sin \\theta+C" :db/id #edb/ref 17592186721260} {:answer/id #uuid "9f400ba3-4b0e-5064-8743-b4f101ab4563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sec^{2} \\theta+4\\sin^{2} \\theta+C" :db/id #edb/ref 17592186721270} {:answer/id #uuid "ab89a558-eaf8-5094-8e4d-7eac51edf66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sec \\theta-4\\sin \\theta+C" :db/id #edb/ref 17592186721271}] :answer-field/correct {:answer/id #uuid "19cb3b6f-c176-51e8-9108-97337f9fac05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sec \\theta+4\\sin \\theta+C" :db/id #edb/ref 17592186721249} :answer-field/id #uuid "9446563c-daf6-5914-9c04-affe6c9dcfdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186721267}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4c820022-e04a-5af6-9c4e-a6c8825120ad" :question/problem "Calculate\n\n$$\n\\displaystyle \\int (-8\\sec \\theta\\tan \\theta+4\\cos \\theta)\\,\\mathrm{d}\\theta.\n$$" :question/worked-solution "Recall the required antiderivatives:\n\n$$\n\\begin{aligned}\n\\int (\\sec \\theta\\tan \\theta)\\,\\mathrm{d}\\theta&=\\sec \\theta+C. \\\\\n\\int (\\cos \\theta)\\,\\mathrm{d}\\theta&=\\sin \\theta+C.\n\\end{aligned}\n$$\n\nTake each constant outside its integral and integrate term by term:\n\n$$\n\\begin{aligned}\n&\\int (-8\\sec \\theta\\tan \\theta+4\\cos \\theta)\\,\\mathrm{d}\\theta \\\\\n&=-8\\int (\\sec \\theta\\tan \\theta)\\,\\mathrm{d}\\theta+4\\int (\\cos \\theta)\\,\\mathrm{d}\\theta \\\\\n&=-8(\\sec \\theta)+4(\\sin \\theta)+C \\\\\n&=-8\\sec \\theta+4\\sin \\theta+C.\n\\end{aligned}\n$$\n\nUse one arbitrary constant. Differentiating $-8\\sec \\theta+4\\sin \\theta$ gives $-8\\sec \\theta\\tan \\theta+4\\cos \\theta$."}] [{:db/id #edb/ref 17592186721258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3865d15f-adcd-578a-a183-612fe78dafd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sec^{2} \\theta+6\\csc^{2} \\theta+C" :db/id #edb/ref 17592186721255} {:answer/id #uuid "555efa13-9532-54da-9929-d22d83bef926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sec \\theta+6\\csc \\theta+C" :db/id #