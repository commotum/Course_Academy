ices [{:answer/id #uuid "0139c477-5e87-5d46-857f-1e644b941aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{11}" :db/id #edb/ref 17592186511912} {:answer/id #uuid "46197fe5-c4cc-5300-bd68-d98bdaf687a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{34}{11}" :db/id #edb/ref 17592186511928} {:answer/id #uuid "4b1cee34-400f-5464-8d28-7c1491e7128e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{11}" :db/id #edb/ref 17592186511929} {:answer/id #uuid "55cde37a-dc3e-5fca-9ffe-050d8732e68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{144}{11}" :db/id #edb/ref 17592186511932} {:answer/id #uuid "6d088897-13c5-5628-a11b-29a2e1cecba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{24}{11}" :db/id #edb/ref 17592186511940}] :answer-field/correct {:answer/id #uuid "46197fe5-c4cc-5300-bd68-d98bdaf687a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{34}{11}" :db/id #edb/ref 17592186511928} :answer-field/id #uuid "51fd72b7-5534-5859-b921-0fbb2129cd60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511931}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b461b9cd-5fb6-5c5e-92ad-d98cc83a4b85" :question/problem "If $\\cos x=-\\frac{2}{11},$ then $6\\cos (x-16\\pi )-2=$" :question/worked-solution "The period of $y=\\cos x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\cos x=\\cos (x+2n\\pi ).\n$$\n\nSubstituting $n=-8$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos x=\\cos (x+2\\cdot (-8)\\cdot \\pi )=\\cos (x-16\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos x=-\\frac{2}{11},$ then $\\cos (x-16\\pi )=-\\frac{2}{11}.$\n\nFinally, then\n\n$$\n\\begin{aligned}6\\cos (x-16\\pi )-2 & =6\\left(-\\frac{2}{11}\\right)-2 \\\\  & =-\\frac{12}{11}-2 \\\\  & =-\\frac{34}{11}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d684425-319e-5df9-a19b-b91f16445b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7} + 2 \\pi" :db/id #edb/ref 17592186511941} {:answer/id #uuid "7d297630-0527-52dc-9af7-424f1abed1ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7} + 2 \\pi" :db/id #edb/ref 17592186511948} {:answer/id #uuid "7df40e16-9f3b-58ad-a6f5-c6d22328d6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186511949} {:answer/id #uuid "b6191568-a449-562c-9689-12dd4f6ed840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7} -2 \\pi" :db/id #edb/ref 17592186511964} {:answer/id #uuid "e92c7cd8-15c6-52db-a643-505013833f68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186511977}] :answer-field/correct {:answer/id #uuid "7df40e16-9f3b-58ad-a6f5-c6d22328d6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186511949} :answer-field/id #uuid "ae9d0b10-7acc-518d-900c-3994ee3b6907" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511961}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d0139f9a-b2bc-55fa-8fcc-2117ac2d633f" :question/problem "If $\\cos x=\\frac{5}{7},$ then $\\cos (x+12\\pi )=$" :question/worked-solution "The period of $y=\\cos x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\cos x=\\cos (x+2n\\pi ).\n$$\n\nSubstituting $n=6$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos x=\\cos (x+2\\cdot 6\\cdot \\pi )=\\cos (x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos x=\\frac{5}{7},$ then $\\cos (x+12\\pi )=\\frac{5}{7}.$"}] [{:db/id #edb/ref 17592186511973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dad7e2b-bae8-5d84-8c3f-6468b2dc4e04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{230}{11}" :db/id #edb/ref 17592186511915} {:answer/id #uuid "1fec70af-72b7-516d-888c-519ee25da87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{54}{11}" :db/id #edb/ref 17592186511923} {:answer/id #uuid "60d115bc-5abe-5b32-a617-3d115b680270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{46}{11}" :db/id #edb/ref 17592186511936} {:answer/id #uuid "89c3b91e-4518-5d73-8f7f-7b8cf00f0714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{54}{11}" :db/id #edb/ref 17592186511952} {:answer/id #uuid "d1481b75-880b-5cb5-95b2-1b161d8953b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{34}{11}" :db/id #edb/ref 17592186511970}] :answer-field/correct {:answer/id #uuid "d1481b75-880b-5cb5-95b2-1b161d8953b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{34}{11}" :db/id #edb/ref 17592186511970} :answer-field/id #uuid "05357ae5-599f-5855-8b16-bae2d424708e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511913}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e3eb5fc0-3045-5e5d-a8b1-a1ea5cfdb161" :question/problem "If $\\cos x=\\frac{2}{11},$ then $-5\\cos (x+4\\pi )+4=$" :question/worked-solution "The period of $y=\\cos x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\cos x=\\cos (x+2n\\pi ).\n$$\n\nSubstituting $n=2$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos x=\\cos (x+2\\cdot 2\\cdot \\pi )=\\cos (x+4\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos x=\\frac{2}{11},$ then $\\cos (x+4\\pi )=\\frac{2}{11}.$\n\nFinally, then\n\n$$\n\\begin{aligned}-5\\cos (x+4\\pi )+4 & =-5\\left(\\frac{2}{11}\\right)+4 \\\\  & =-\\frac{10}{11}+4 \\\\  & =\\frac{34}{11}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00933cc8-a337-5afa-bc3b-98f4a1fdcad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2} + 2 \\pi" :db/id #edb/ref 17592186511911} {:answer/id #uuid "5c8db6e0-431a-5af0-a1f1-b4c26a353fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2} + 2 \\pi" :db/id #edb/ref 17592186511933} {:answer/id #uuid "61e48368-d13e-516d-9c13-fbe4b86284c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186511937} {:answer/id #uuid "78841c3a-7fd9-5263-9cc0-4ce0d97abd83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186511944} {:answer/id #uuid "8db2caa3-f4b5-5b65-afd5-b1a82e243d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 \\pi -\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186511953}] :answer-field/correct {:answer/id #uuid "61e48368-d13e-516d-9c13-fbe4b86284c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186511937} :answer-field/id #uuid "a500c162-6a73-55e7-85ed-d6f17977f362" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511957}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f5852b5f-0ccb-54cb-bad3-0ec889542ba3" :question/problem "If $\\cos x=-\\frac{\\sqrt{2}}{2},$ then $\\cos (x-2\\pi )=$" :question/worked-solution "The period of $y=\\cos x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\cos x=\\cos (x+2n\\pi ).\n$$\n\nSubstituting $n=-1$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos x=\\cos (x+2\\cdot (-1)\\cdot \\pi )=\\cos (x-2\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos x=-\\frac{\\sqrt{2}}{2},$ then $\\cos (x-2\\pi )=-\\frac{\\sqrt{2}}{2}.$"}]}
