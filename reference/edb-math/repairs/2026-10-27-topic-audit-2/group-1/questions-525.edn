uuid "bb8b713e-6030-54a2-bb0e-99ba1fba2a32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12}{7}" :db/id #edb/ref 17592186511965}] :answer-field/correct {:answer/id #uuid "5f9f5765-9e63-51b4-81f2-ac00398068a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{7}" :db/id #edb/ref 17592186511935} :answer-field/id #uuid "88b4427d-f2f1-571e-900c-ab2a00e3a774" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511951}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "19ee0877-fb33-5fe0-9855-c6ff1fa21c11" :question/problem "If $\\cos x=\\frac{1}{7},$ then $2\\cos (x-14\\pi )+2=$" :question/worked-solution "The period of $y=\\cos x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\n\\cos x=\\cos (x+2n\\pi ).\n$$\n\nSubstituting $n=-7$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\cos x=\\cos (x+2\\cdot (-7)\\cdot \\pi )=\\cos (x-14\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\cos x=\\frac{1}{7},$ then $\\cos (x-14\\pi )=\\frac{1}{7}.$\n\nFinally, then\n\n$$\n\\begin{aligned}2\\cos (x-14\\pi )+2 & =2\\left(\\frac{1}{7}\\right)+2 \\\\  & =\\frac{2}{7}+2 \\\\  & =\\frac{16}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186511924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f260668-83d5-5737-be7a-fcd41740577c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{7}" :db/id #edb/ref 17592186511934} {:answer/id #uuid "7534c7ed-b9b9-5a4e-b7cc-648e83cbe230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{34}{7}" :db/id #edb/ref 17592186511943} {:answer/id #uuid "7b4eb6cc-0bc2-52a2-b07f-504b6d6ecb53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{7}" :db/id #edb/ref 17