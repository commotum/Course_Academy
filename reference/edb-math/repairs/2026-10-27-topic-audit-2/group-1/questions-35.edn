98 :db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094949} {:answer/id #uuid "667ba516-4fd4-5570-a622-0203f2df6f20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5}{x\\ln 3}" :db/id #edb/ref 17592186094950}] :answer-field/id #uuid "39bd020b-c912-5ba2-9e81-38edfaf9381b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094945}] :question/id #uuid "cf22f993-a76b-52d8-8977-b83456911b64" :question/math-academy-id "q-1933" :question/problem "Given that $f(x) = 5\\log_{3} x\\ln x$, find $f^{′}(x)$."}] [{:db/id #edb/ref 17592186097217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07313f55-5d1b-57b8-a58b-0fd2285fb384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186295301} {:answer/id #uuid "302be2db-4e95-585b-828f-222678bc2c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186295541} {:answer/id #uuid "4e91aacd-fda2-5f11-90aa-6106b854beaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186295720} {:answer/id #uuid "6803b977-2128-5c3c-8a0c-1019fb07b1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295852} {:answer/id #uuid "73ac26ff-08d4-5c73-9841-6e57a53e85a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186295901}] :answer-field/correct {:answer/id #uuid "302be2db-4e95-585b-828f-222678bc2c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186295541} :answer-field/id #uuid "942489c8-b11e-5069-8ed0-9bf73a6a722c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296942}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68ba7826-02c2-5b69-a594-6dc133f00570" :question/math-academy-id "q-30923" :question/problem "$$\n\\displaystyle {\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}u=\\frac{1}{3}\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x & ={\\int }_{0}^{3}{e}^{x/3}\\cdot \\frac{1}{3}\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =({e}^{u}){|}_{0}^{1} \\\\  & ={e}^{1}-{e}^{0} \\\\  & =e-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9abbe1a2-b532-51a1-80f3-e85520454526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{6x - 1}}{\\ln 2} + C" :db/id #edb/ref 17592186095250} {:answer/id #uuid "b2030311-b93b-5086-ac8a-22c14254a5bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{3x - 1}}{6} + C" :db/id #edb/ref 17592186095251} {:answer/id #uuid "f17de8b1-8c36-542e-8869-051ce59fb3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{6x - 1}}{6} + C" :db/id #edb/ref 17592186095252} {:answer/id #uuid "34308b09-4153-58b1-9482-a404961a3981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{6x - 1}}{6\\ln 2} + C" :db/id #edb/ref 17592186095253} {:answer/id #uuid "572cb874-e27a-510f-85d8-8a946c5bb585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2^{3x - 1}}{\\ln 2} + C" :db/id #edb/ref 17592186095254}] :answer-field/id #uuid "c5ec82f4-c60f-506f-8243-a969fdc4fa8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095249}] :question/id #uuid "11de273d-2b3c-5d60-8d62-a5a765ac49f3" :question/math-academy-id "q-31405" :question/problem "What is $$\n\\displaystyle \\int2^{6x - 1}dx\n$$?"}] [{:db/id #edb/ref 17592186097221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0a1db5-167b-5f70-a564-82d5102adf3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3^{x + 6}}{3} + C" :db/id #edb/ref 17592186095256} {:answer/id #uuid "ad1e4e92-d55c-58f4-9e5d-b775f0cbec86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3^{-x - 6}}{\\ln 3} + C" :db/id #edb/ref 17592186095257} {:answer/id #uuid "fd7ed679-6aae-5266-a8e0-9d47536a6cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3^{x + 6}}{\\ln 3} + C" :db/id #edb/ref 17592186095258} {:answer/id #uuid "035814d6-6224-5943-996a-04fa0cc9de74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3^{-x}}{\\ln 3} + C" :db/id #edb/ref 17592186095259} {:answer/id #uuid "3dd1679a-328d-52a1-8d02-f2939bb088b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3^{-x - 6}}{\\ln 3} + C" :db/id #edb/ref 17592186095260}] :answer-field/id #uuid "a57101a1-86df-5076-a20f-a74c092ac31b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095255}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18f1bf44-951c-5e83-9b4d-761eaec466c8" :question/math-academy