fd975-1de6-59c3-bcc3-a4f3edef6f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = ± \\frac{3}{4}" :db/id #edb/ref 17592186067221}] :answer-field/id #uuid "3c16bff1-d87e-51d8-a94d-0aa124c5cf8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067216}] :question/id #uuid "6086efeb-d874-5b30-8932-6d52e4958690" :question/math-academy-id "q-44117" :question/problem "Solve $9y^{2} - 16 = 0$."}] [{:db/id #edb/ref 17592186096417 :question/id #uuid "d7a77a89-0535-54da-a246-36ee5b4e9e7f" :question/math-academy-id "e-3634" :question/problem "Differentiate $x\\cos x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)=x$ and $v(x)=\\cos x .$ So, we apply the product rule:\n\n$$\n\\begin{aligned}\n\t (x\\cos x)' &=   u'(x) \\cdot v(x) + u(x) \\cdot v'(x)\\\\\n\t\t\t\t\t\t&= (x)'\\cdot \\cos x + x\\cdot (\\cos x)'\\\\\n\t\t\t\t\t   & = 1 \\cdot \\cos x + x (-\\sin x)\\\\\n\t\t\t\t\t  & =  \\cos x - x \\sin x\t\t\t\t\t\n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096418 :question/id #uuid "6bb0eded-7277-5ab5-8c13-bfc480403b1a" :question/math-academy-id "e-3635" :question/problem "Given that $f(x)=x^2\\ln x,$ find $f'(x).$" :question/worked-solution "Here, we have the product of two functions $u(x) = x^2$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2})}^{′}ln⁡x+{x}^{2}{(ln⁡x)}^{′} \\\\  & =2x\\cdot ln⁡x+{x}^{2}\\left(\\frac{1}{x}\\right) \\\\  & =2xln⁡x+x \\\\  & =x(2ln⁡x+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096419 :question/id #uuid "072ce609-b04d-57b0-9c7d-cbb8765c38fa" :question/math-academy-id "e-3636" :question/problem "If a curve $\\mathcal C$ is given by $y=e^x\\sin x,$ calculate the slope of the tangent line to the curve at the point where $x=\\dfrac \\pi 2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x) = e^x$ and $v(x)=\\sin{x}.$ Then, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = e^x,\\qquad \\dfrac{\\textrm d v}{\\textrm d x} = \\cos x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+sin⁡x\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\dfrac\\pi 2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi /2} & ={e}^{\\pi /2}(cos⁡\\left(\\frac{\\pi }{2}\\right)+sin⁡\\left(\\frac{\\pi }{2}\\right)) \\\\  & ={e}^{\\pi /2}(0+1) \\\\  & ={e}^{\\pi /2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $e^{\\pi/2}.$"}] [{:db/id #edb/ref 17592186096454 :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459" :question/problem "Calculate  $$\n\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.\n$$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot \\left(-\\frac{1}{3}\\right)\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096455 :question/id #uuid "cbf09123-3650-5d6a-869a-8edd8f54206b" :question/math-academy-id "e-460" :question/problem "Calculate  $$\n\\displaystyle{\\int 3^{5+4x}\\, \\textrm{d}x }.\n$$" :question/worked-solution "If we let $u=5+4x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 4\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 4 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {3}^{5+4x}\\,\\text{d}x & =\\int {3}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int {3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{3}^{u}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{3}^{5+4x}}{4\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d7f849-00ec-5e56-93bd-5f9af777de2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6e^{-6x} + C" :db/id #edb/ref 17592186094568} {:answer/id #uuid "86b83b6e-810a-5b7c-8d7d-dec07b441bde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^{-6x} + C" :db/id #edb/ref 17592186094569} {:answer/id #uuid "e0d45296-f41d-5260-89b5-e966f8183b9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-6x} + C" :db/id #edb/ref 17592186094570} {:answer/id #uuid "4c62783d-5ce8-5688-b061-43d00f936eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}e^{-6x} + C" :db/id #edb/ref 17592186094571} {:answer/id #uuid "53d806b7-7b1d-5247-bcd5-05bb3e53e235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}e^{-6x} + C" :db/id #edb/ref 17592186094572}] :answer-field/id #uuid "c3d3ffff-3549-5728-bf95-65b415f0642e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094567}] :question/id #uuid "4aa289aa-4bea-5233-863b-82ac1f00cf7d" :question/math-academy-id "q-13733" :question/problem "What is $$\n\\displaystyle \\int3e^{-6x}dx\n$$?"}] [{:db/id #edb/ref 17592186097154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aca48a7b-5c44-5ceb-9f7a-46475643a906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}\\cos x - x^{2}\\sin x" :db/id #edb/ref 17592186094898} {:answer/id #uuid "bb75f