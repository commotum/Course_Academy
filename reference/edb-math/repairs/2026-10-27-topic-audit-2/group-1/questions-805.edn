{-3}}{-3}\\right)+C\\\\ &= \\frac{5t^{6}}{6}-\\frac{30\\sqrt[5]{t^{7}}}{7}-\\frac{1}{t^{3}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d20d2d9-20db-5af8-9c24-0b2e8284a720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{2}{\\sqrt{y}}+C" :db/id #edb/ref 17592186671192} {:answer/id #uuid "6eda08b9-529e-5f8a-a014-7e9ac76178b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{4}{7\\sqrt{y}}+C" :db/id #edb/ref 17592186671217} {:answer/id #uuid "bd1a38e2-847f-5bd5-890b-b7e9e0e5982e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{6}{11\\sqrt{y}}+C" :db/id #edb/ref 17592186671253} {:answer/id #uuid "cf23446f-5660-5912-91d0-9e2509d3bfb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{3}{\\sqrt{y}}+C" :db/id #edb/ref 17592186671264} {:answer/id #uuid "e9b2a0c1-02b0-5988-8684-bb269fd1280c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{8}{\\sqrt{y}}+C" :db/id #edb/ref 17592186671275}] :answer-field/correct {:answer/id #uuid "2d20d2d9-20db-5af8-9c24-0b2e8284a720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4y-\\frac{2}{\\sqrt{y}}+C" :db/id #edb/ref 17592186671192} :answer-field/id #uuid "f1b15a85-8c1e-54d0-960f-1bade617bdcd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671316}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e79065f6-b8d3-5cd6-99d1-ea13ab9bb01c" :question/problem "Calculate $$\n\\displaystyle\\int -4+\\frac{1}{\\sqrt{y^{3}}}\\,\\mathrm{d}y.\n$$ Assume $y>0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int -4+\\frac{1}{\\sqrt{y^{3}}}\\,\\mathrm{d}y\\\\ &= \\int\\left(-4+\\frac{1}{y^{\\frac{3}{2}}}\\right)\\,\\mathrm{d}y\\\\ &= -4\\int y^{0}\\,\\mathrm{d}y+\\int y^{-\\frac{3}{2}}\\,\\mathrm{d}y\\\\ &= -4\\left(\\frac{y^{1}}{1}\\right)+\\left(\\frac{y^{-\\frac{1}{2}}}{-\\frac{1}{2}}\\right)+C\\\\ &= -4y-\\frac{2}{\\sqrt{y}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a58fa2e0-bb9d-57aa-8b0d-a083653bd13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{28}{\\sqrt[7]{x}}-\\frac{x^{6}}{3}+C" :db/id #edb/ref 17592186671240} {:answer/id #uuid "b41e3497-a1ec-508c-81da-14b427efb021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{x}+\\frac{7}{\\sqrt[7]{x}}-\\frac{2x^{6}}{3}+C" :db/id #edb/ref 17592186671248} {:answer/id #uuid "c3da1017-dacc-56f9-a8cb-67ad390dd037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C" :db/id #edb/ref 17592186671255} {:answer/id #uuid "efaeb280-074e-588b-9790-77fa3239ae8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{x^{6}}{2}+C" :db/id #edb/ref 17592186671276} {:answer/id #uuid "f09222c2-6c0f-5c18-a7a3-b0aa261fa091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{x}+\\frac{21}{\\sqrt[7]{x}}-\\frac{2x^{6}}{3}+C" :db/id #edb/ref 17592186671277}] :answer-field/correct {:answer/id #uuid "c3da1017-dacc-56f9-a8cb-67ad390dd037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C" :db/id #edb/ref 17592186671255} :answer-field/id #uuid "72da992f-ab95-5a91-b965-6e0d593120e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671300}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ef445d49-180b-5e2d-afaa-378951f5a7d2" :question/problem "Calculate $$\n\\displaystyle\\int \\frac{3}{x^{2}}-\\frac{2}{\\sqrt[7]{x^{8}}}-5x^{5}\\,\\mathrm{d}x.\n$$ Assume $x\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\frac{3}{x^{2}}-\\frac{2}{\\sqrt[7]{x^{8}}}-5x^{5}\\,\\mathrm{d}x\\\\ &= \\int\\left(\\frac{3}{x^{2}}-\\frac{2}{x^{\\frac{8}{7}}}-5x^{5}\\right)\\,\\mathrm{d}x\\\\ &= 3\\int x^{-2}\\,\\mathrm{d}x-2\\int x^{-\\frac{8}{7}}\\,\\mathrm{d}x-5\\int x^{5}\\,\\mathrm{d}x\\\\ &= 3\\left(\\frac{x^{-1}}{-1}\\right)-2\\left(\\frac{x^{-\\frac{1}{7}}}{-\\frac{1}{7}}\\right)-5\\left(\\frac{x^{6}}{6}\\right)+C\\\\ &= -\\frac{3}{x}+\\frac{14}{\\sqrt[7]{x}}-\\frac{5x^{6}}{6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29775553-08f2-568d-aadc-5e12973d0a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{3}+3x^{2}+x+C" :db/id #edb/ref 17592186671190} {:answer/id #uuid "5423bd1a-105e-5b13-9d86-923699913f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671208} {:answer/id #uuid "751e857e-3583-5e12-af08-41a2b7b6478c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x^{3}}{3}+2x^{2}+x+C" :db/id #edb/ref 17592186671221} {:answer/id #uuid "e49bce56-1551-5c16-9c86-b3857303a9aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671272} {:answer/id #uuid "faa25c1c-b9d1-547d-9229-3e912ae73050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{3}+3x^{2}+x+C" :db/id #edb/ref 17592186671286}] :answer-field/correct {:answer/id #uuid "5423bd1a-105e-5b13-9d86-923699913f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x^{3}}{3}+x^{2}+x+C" :db/id #edb/ref 17592186671208} :answer-field/id #uuid "2761d594-ddb2-5e7c-a1a5-4974c969f73d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671293}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f4653c6b-10c6-560d-9991-2e184a7cf8dc" :question/problem "Calculate $$\n\\displaystyle\\int 5x^{2}+2x+1\\,\\mathrm{d}x.\n$$" :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int x^p\\,\\mathrm{d}x=x^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int 5x^{2}+2x+1\\,\\mathrm{d}x\\\\ &= \\int\\left(5x^{2}+2x+1\\right)\\,\\mathrm{d}x\\\\ &= 5\\int x^{2}\\,\\mathrm{d}x+2\\int x^{1}\\,\\mathrm{d}x+\\int x^{0}\\,\\mathrm{d}x\\\\ &= 5\\left(\\frac{x^{3}}{3}\\right)+2\\left(\\frac{x^{2}}{2}\\right)+\\left(\\frac{x^{1}}{1}\\right)+C\\\\ &= \\frac{5x^{3}}{3}+x^{2}+x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186672584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a95f97-a1c7-5408-8e45-38520c0e9deb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672600} {:answer/id #uuid "d1484a87-e37c-53a4-8a20-887bc62c7c02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672632}] :answer-field/correct {:answer/id #uuid "d1484a87-e37c-53a4-8a20-887bc62c7c02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672632} :answer-field/id #uuid "3eda00a6-2b53-5eb5-9443-bc481456b9ea" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672599} {:answer-field/choices [{:answer/id #uuid "123c772a-908b-56ee-b836-c400f788ea5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672583} {:answer/id #uuid "87c145b7-172a-524e-a01a-8524140e5e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672620}] :answer-field/correct {:answer/id #uuid "123c772a-908b-56ee-b836-c400f788ea5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672583} :answer-field/id #uuid "79aad520-644b-54cf-9059-eada322e4888" :answer-field/key "At every point in the first quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672615} {:answer-field/choices [{:answer/id #uuid "1862e18d-986b-5d28-b0d2-296a0d3c1090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672585} {:answer/id #uuid "666ceb38-febd-5cbb-a891-050c0272630e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672608}] :answer-field/correct {:answer/id #uuid "666ceb38-febd-5cbb-a891-050c0272630e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672608} :answer-field/id #uuid "e4b661b9-6e36-5c48-b27d-843339c86705" :answer-field/key "At every point in the second quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672637} {:answer-field/choices [{:answer/id #uuid "23d36483-289a-586a-a99a-5ab37d982a59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672589} {:answer/id #uuid "c48ca3d0-28f0-5045-b250-3689bfe7f400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672630}] :answer-field/correct {:answer/id #uuid "23d36483-289a-586a-a99a-5ab37d982a59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672589} :answer-field/id #uuid "e9bfb2b5-5172-5ec8-9973-6fe90c04f85e" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672640}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1345f069-f11b-56fe-958c-de725b58eb1f" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-6xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=-6xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the second quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement “At every point in the first quadrant, the slope of the slope field is negative” is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the fourth quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is “At every point in the second quadrant, the slope of the slope field is positive”; “At every point in the first quadrant, the slope of the slope field is negative”."}] [{:db/id #edb/ref 17592186672612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "804f1b05-3f3d-53a8-80db-45b5b7ac8a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672616} {:answer/id #uuid "a27049d1-5058-588c-b245-1868507a583f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672625}] :answer-field/correct {:answer/id #uuid "804f1b05-3f3d-53a8-80db-45b5b7ac8a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672616} :answer-field/id #uuid "36a3dbcf-8363-569d-aad7-f87855406f76" :answer-field/key "At every point in the second quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672595} {:answer-field/choices [{:answer/id #uuid "6dbbdf50-4bc2-502e-9cfd-c889652b44b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672610} {:answer/id #uuid "e61cbeb9-6f77-5f4e-86af-43c701736476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672638}] :answer-field/correct {:answer/id #uuid "e61cbeb9-6f77-5f4e-86af-43c701736476" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672638} :answer-field/id #uuid "6544f083-6a49-585b-9750-d235f087c4e7" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672606} {:answer-field/choices [{:answer/id #uuid "09504bbd-1657-521d-9a74-58cf501bfd51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672581} {:answer/id #uuid "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672582}] :answer-field/correct {:answer/id #uuid "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672582} :answer-field/id #uuid "86f5078b-71ac-572a-803e-18ae809816f3" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672619} {:answer-field/choices [{:answer/id #uuid "82e81c3c-c30d-5538-93e0-17e3ed5e3a3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672618} {:answer/id #uuid "a96cc47a-1e26-59c8-8ada-74efc154ef17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672627}] :answer-field/correct {:answer/id #uuid "a96cc47a-1e26-59c8-8ada-74efc154ef17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672627} :answer-field/id #uuid "a4d45b94-b0e8-5c09-baa0-33a750b24587" :answer-field/key "At every point in the third quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672626}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "764de3d1-5894-55be-8e26-0caf40d3c432" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-2xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=-2xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the fourth quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is positive” is false. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the third quadrant.\n\n- Statement “At every point in the second quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\nTherefore, the correct answer is “At every point in the second quadrant, the slope of the slope field is positive” only."}] [{:db/id #edb/ref 17592186672623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245e8010-9f6c-5819-9fdc-92eb0082eb98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672590} {:answer/id #uuid "c7e35bda-557b-58e9-86fc-0850194c1bb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672631}] :answer-field/correct {:answer/id #uuid "245e8010-9f6c-5819-9fdc-92eb0082eb98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672590} :answer-field/id #uuid "1ca97b16-ffef-5260-ac53-9f232f048a0b" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672586} {:answer-field/choices [{:answer/id #uuid "233c0192-884a-5254-95fa-e1c83b7f8fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672588} {:answer/id #uuid "fcb9885a-ae4d-5a97-8504-2e93c4fe7812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672644}] :answer-field/correct {