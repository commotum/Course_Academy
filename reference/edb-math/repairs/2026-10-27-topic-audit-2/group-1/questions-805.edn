tive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is “At every point in the third quadrant, the slope of the slope field is negative” only."}] [{:db/id #edb/ref 17592186672635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce5149c-7b2b-5d0e-a058-bcc0ca62a3c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672602} {:answer/id #uuid "c34e4300-3e2b-5623-b2df-ec2f08a2fe95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672629}] :answer-field/correct {:answer/id #uuid "4ce5149c-7b2b-5d0e-a058-bcc0ca62a3c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672602} :answer-field/id #uuid "266dc37a-fa0b-50a4-bb31-698554827674" :answer-field/key "At every point in the second quadrant, the slope of the slope field is positive" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672591} {:answer-field/choices [{:answer/id #uuid "37190a41-cbef-538f-8c72-826960f510bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672596} {:answer/id #uuid "eef6b882-3e9f-5292-be8a-8a60806effe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672641}] :answer-field/correct {:answer/id #uuid "eef6b882-3e9f-5292-be8a-8a60806effe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672641} :answer-field/id #uuid "2e6071a0-256f-5964-960c-364249476b25" :answer-field/key "At every point in the fourth quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 175921866725