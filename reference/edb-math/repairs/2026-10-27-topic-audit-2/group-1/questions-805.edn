/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672621} :answer-field/id #uuid "6d6ed8a6-7d75-5550-8a8c-2db9c82f28df" :answer-field/key "At every point in the second quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672609} {:answer-field/choices [{:answer/id #uuid "e4ac9920-5ad1-51b2-8827-f16142e49064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186672636} {:answer/id #uuid "e764cfd3-7778-56a9-81c1-681b9656a661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672639}] :answer-field/correct {:answer/id #uuid "e764cfd3-7778-56a9-81c1-681b9656a661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186672639} :answer-field/id #uuid "d8fc5edf-b284-52a8-811a-3db53d1a274c" :answer-field/key "At every point in the third quadrant, the slope of the slope field is negative" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186672634}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=5xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "First, we define $f(x,y)=5xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the second quadrant, the slope of the slope field is negative” is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement “At every point in the first quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\nTherefore, the correct answer is “At every point in the second quadrant, the slope of the slope field is negative”; “At every point in the first quadrant, the slope of the slope field is positive”."}] [{:db/id #edb/ref 17592186672653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22cdcc2c-02c7-5ed4-8d09-2cbfb8fe6667" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9e/9e237b1ed82702a83a9dd57bae1b8b145869b6553a3d1d3cf46bdb462f1185c1.png" :db/id #edb/ref 17592186672659} {:answer/id #uuid "52ffb102-56cb-594f-b612-767db21c2b35" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/43/43d8cc77fa0e6b149b8e8653e6a1ce25a403bf5b9fda0a70d2299f5d48b58d05.png" :db/id #edb/ref 17592186672666} {:answer/id #uuid "996fe4cb-6888-5425-8e9d-d0bee2d0a511" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/749132341c79056904d68e444249b5ad33e89df84700c5756ca8c8a1246f033f.png" :db/id #edb/ref 17592186672674} {:answer/id #uuid "a6aba166-44f6-57f6-97fb-94d24f88bbc5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/20/2001bcc57f69aa456ebddb97c8e9cf323e11af1565f85eab09f353a19d68f007.png" :db/id #edb/ref 17592186672677} {:answer/id #uuid "dbdcde0a-7698-51e4-abab-33c001af2ce6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd4c9ee2cc8d82e8f55503886bbe9343f4b467b2adfacd17c27eaf921e45b81d.png" :db/id #edb/ref 17592186672684}] :answer-field/correct {:answer/id #uuid "996fe4cb-6888-5425-8e9d-d0bee2d0a511" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/74/749132341c79056904d68e444249b5ad33e89df84700c5756ca8c8a1246f033f.png" :db/id #edb/ref 17592186672674} :answer-field/id #uuid "0ddada67-feb4-57a9-8574-014b93629d9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186672654}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "08df7dc7-1844-5892-82e4-9cbf1e82032f" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2 x^{2} y?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/74/749132341c79056904d68e444249b5ad33e89df84700c5756ca8c8a1246f033f.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/17/170a2afad1f143ccce8776f20b810096c7b127782543278671ad9794aecb391e.png)"}]}
