{3}\\,\\mathrm{d}y+3\\int y^{-2}\\,\\mathrm{d}y\\\\ &= -\\left(\\frac{y^{4}}{4}\\right)+3\\left(\\frac{y^{-1}}{-1}\\right)+C\\\\ &= -\\frac{y^{4}}{4}-\\frac{3}{y}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1cf232-79dc-57e3-893c-c88206f74cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16y^{3}+16y+\\frac{36y^{5}}{5}+C" :db/id #edb/ref 17592186671197} {:answer/id #uuid "64b5dab1-8e05-53d7-a6e9-fd8177b69af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{32y^{3}}{3}+16y+\\frac{16y^{5}}{5}+C" :db/id #edb/ref 17592186671213} {:answer/id #uuid "6cd6b418-26bc-5cb4-bdcc-7cd1b9dc019d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8y^{3}+16y+\\frac{9y^{5}}{5}+C" :db/id #edb/ref 17592186671216} {:answer/id #uuid "8230b682-a119-5939-9e1c-325f1757d159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16y^{3}}{3}+16y+\\frac{4y^{5}}{5}+C" :db/id #edb/ref 17592186671225} {:answer/id #uuid "f651bc8d-b674-5014-9422-55599195225f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{40y^{3}}{3}+16y+5y^{5}+C" :db/id #edb/ref 17592186671285}] :answer-field/correct {:answer/id #uuid "f651bc8d-b674-5014-9422-55599195225f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{40y^{3}}{3}+16y+5y^{5}+C" :db/id #edb/ref 17592186671285} :answer-field/id #uuid "e51c9a9b-9dda-5ea4-b76d-db3e7ae87d9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671313}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "100f3bc0-faf0-5120-ae97-28d49f237446" :question/problem "Calculate $$\n\\displaystyle\\int \\left(4-5y^{2}\\right)^{2}\\,\\mathrm{d}y.\n$$" :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int y^p\\,\\mathrm{d}y=y^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\left(4-5y^{2}\\right)^{2}\\,\\mathrm{d}y\\\\ &= \\int\\left(-40y^{2}+16+25y^{4}\\right)\\,\\mathrm{d}y\\\\ &= -40\\int y^{2}\\,\\mathrm{d}y+16\\int y^{0}\\,\\mathrm{d}y+25\\int y^{4}\\,\\mathrm{d}y\\\\ &= -40\\left(\\frac{y^{3}}{3}\\right)+16\\left(\\frac{y^{1}}{1}\\right)+25\\left(\\frac{y^{5}}{5}\\right)+C\\\\ &= -\\frac{40y^{3}}{3}+16y+5y^{5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186671324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9e7a3d4-2eaa-5c0c-b79e-bbb854b967f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4t-\\frac{6}{t}" :db/id #edb/ref 17592186671267}] :answer-field/correct {:answer/id #uuid "d9e7a3d4-2eaa-5c0c-b79e-bbb854b967f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4t-\\frac{6}{t}" :db/id #edb/ref 17592186671267} :answer-field/id #uuid "e35fb1fe-a3f5-5d6f-ae8c-fbd7b24e32cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671312}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "15374ade-be7d-56c6-9f1a-1fc3902b8289" :question/problem "Find the antiderivative:\n\n$$\n\\displaystyle\\int \\frac{-4t^{2}+6}{t^{2}}\\,\\mathrm{d}t=\n$$\n{{field-1}}\n$+C$. Assume $t\\ne0$." :question/worked-solution "Rewrite as powers, apply the sum and constant factor rules, and integrate each term using $$\n\\displaystyle \\int t^p\\,\\mathrm{d}t=t^{p+1}/(p+1)+C\n$$ for $p\\ne-1$:\n\n$$\n\\begin{aligned}& \\int \\frac{-4t^{2}+6}{t^{2}}\\,\\mathrm{d}t\\\\ &= \\int\\left(-4+\\frac{6}{t^{2}}\\right)\\,\\mathrm{d}t\\\\ &= -4\\int t^{0}\\,\\mathrm{d}t+6\\int t^{-2}\\,\\mathrm{d}t\\\\ &= -4\\left(\\frac{t^{1}}{1}\\right)+6\\left(\\frac{t^{-1}}{-1}\\right)+C\\\\ &= -4t-\\frac{6}{t}+C\\end{aligned}\n$$\n\nThe constant $C$ is already supplied outside the blank."}] [{:db/id #edb/ref 17592186671325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1746d60b-249d-5e98-8bc5-1300d3119cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5t^{2}}{2}-\\frac{2t^{3}}{3}+C" :db/id #edb/ref 17592186671182} {:answer/id #uuid "7a0a2277-98e1-5aa1-ac7d-da384049ec46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3t^{2}}{2}-\\frac{4t^{3}}{3}+C" :db/id #edb/ref 17592186671224} {:answer/id #uuid "9dd5da0b-3aca-5369-b06b-62d81e58b057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3t^{2}-\\frac{5t^{3}}{3}+C" :db/id #edb/ref 17592186671238} {:answer/id #uuid "c731a56b-46ca-5b4e-8502-f9bef9d43cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5t^{2}}{2}-\\frac{5t^{3}}{3}+C" :db/id #edb/ref 17592186671257} {:answer/id #uuid "e55ba367-b093-5950-8c24-ee02ba7118a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5t^{2}}{2}-t^{3}+C" :db/id #edb/ref 17592186671273}] :answer-field/correct {:answer/id #uuid "c731a56b-46ca-5b4e-8502-f9bef9d43cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5t^{2}}{2}-\\frac{5t^{3}}{3}+C" :db/id #edb/ref 17592186671257} :answer-field/id #uuid "cfefda4a-7911-5640-8768-73c3b23c0ba4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1914f415-2da9-526d-bb62-0aed631ce877" :question/problem "Calculate $$\n\\displaystyle\\int -5t-5t^{2}\\,\\mathrm{d}t.\n$$" :question/worked-solution "Rewrite as 