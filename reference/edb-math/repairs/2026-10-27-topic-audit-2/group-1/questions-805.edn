#{[{:db/id #edb/ref 17592186671062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t^{6}}{6}-5t" :db/id #edb/ref 17592186671061}] :answer-field/correct {:answer/id #uuid "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{t^{6}}{6}-5t" :db/id #edb/ref 17592186671061} :answer-field/id #uuid "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186671059}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/problem "Given $y'(t)=-t^{5}-5$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$" :question/retired true :question/worked-solution "We know that $y'(t)=-t^{5}-5$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-t^{5}-5\\right)\\,\\mathrm{d}t &= \\int \\left(-t^{5}-5\\right)\\,\\mathrm{d}t \\\\ &= -\\int t^{5}\\,\\mathrm{d}t-5\\int 1\\,\\mathrm{d}t \\\\ &= -\\frac{t^{5+1}}{(5+1)}-5\\frac{t^{0+1}}{(0+1)}+C \\\\ &= -\\frac{t^{6}}{6}-5t+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."}] [{:db/id #edb/ref 17592186671321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055a6133-5178-5632-948f-b55773ae909e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4y^{3}}{3}-\\frac{1}{y^{2}}+C" :db/id #edb/ref 17592186671179} {:answer/id #uuid "17774358-6aa3-5d4f-a4a7-489d7953249b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y^{3}-\\frac{3}{y^{2}}+C" :db/id #edb/ref 17592186671