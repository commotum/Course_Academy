 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\ln 4}" :db/id #edb/ref 17592186702433} {:answer/id #uuid "75b35a4e-4461-5c60-b37e-a3b286fa0bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{60}{\\ln 4}" :db/id #edb/ref 17592186702436} {:answer/id #uuid "d4efd240-5c54-5a98-bef9-4ff0ef5c6754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{60}{\\ln 4}" :db/id #edb/ref 17592186702445} {:answer/id #uuid "edb18c7e-2885-5740-ab29-ee79cf0656ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{120}{\\ln 4}" :db/id #edb/ref 17592186702448}] :answer-field/correct {:answer/id #uuid "75b35a4e-4461-5c60-b37e-a3b286fa0bc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{60}{\\ln 4}" :db/id #edb/ref 17592186702436} :answer-field/id #uuid "5fec8a77-16c0-5702-8a7c-dc1d1186abec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186702434}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3df6b76f-f832-5753-8e45-f2ed7c3248a7" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{-1}^{0} 2\\cdot 4^{2x+3}\\,\\mathrm{d}x.\n$$" :question/worked-solution "Let $u=2x+3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2\\quad\\Longrightarrow\\quad\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u.\n$$\n\nTransform both limits, keeping their corresponding order:\n\n| $x$ | $-1$ | $0$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nNow integrate and evaluate:\n\n$$\n\\begin{aligned}\n\\int_{-1}^{0} 2\\cdot 4^{2x+3}\\,\\mathrm{d}x&=\\int_{1}^{3} 4^{u}\\,\\mathrm{d}u \\\\ &=\\left[\\frac{4^{u}}{\\ln 4}\\right]_{1}^{3} \\\\ &=\\frac{1}{\\ln 4}\\left(4^{3}-4^{1}\\right) \\\\ &=\\frac{1}{\\ln 4}\\left(64-4\\right) \\\\ &=\\frac{60}{\\ln 4}\n\\end{aligned}\n$$\n\nThe answer is positive because the integrand is positive and the original limits increase."}] [{:db/id #edb/ref 17592186702431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "315db8a3-7277-5132-ba2b-6a1cc7f9b5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{40}{27\\ln 3}" :db/id #edb/ref 17592186702428}] :answer-field/correct {:answer/id #uuid "315db8a3-7277-5132-ba2b-6a1cc7f9b5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{40}{27\\ln 3}" :db/id #edb/ref 17592186702428} :answer-field/id #uuid "eaf595d5-1813-5d52-ab23-238c2ce27f2b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186702447}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4923860d-4d22-5a2d-80a3-93fb9f628826" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{1}^{3} 3\\cdot 3^{-2x+2}\\,\\mathrm{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=-2x+2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-2\\quad\\Longrightarrow\\quad\\mathrm{d}x=- \\frac{1}{2}\\,\\mathrm{d}u.\n$$\n\nTransform both limits, keeping their corresponding order:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4$ |\n\nNow integrate and evaluate:\n\n$$\n\\begin{aligned}\n\\int_{1}^{3} 3\\cdot 3^{-2x+2}\\,\\mathrm{d}x&=-\\frac{3\\cdot \\int_{0}^{-4} 3^{u}\\,\\mathrm{d}u}{2} \\\\ &=-\\frac{3\\cdot \\left[\\frac{3^{u}}{\\ln 3}\\right]_{0}^{-4}}{2} \\\\ &=-\\frac{3}{2\\ln 3}\\left(3^{-4}-3^{0}\\right) \\\\ &=-\\frac{3}{2\\ln 3}\\left(\\frac{1}{81}-1\\right) \\\\ &=\\frac{40}{27\\ln 3}\n\\end{aligned}\n$$\n\nThe answer is positive because the integrand is positive and the original limits increase."}] [{:db/id #edb/ref 17592186702437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c65f024-89c0-5e0e-8a3c-f1afef14c36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln 2}" :db/id #edb/ref 17592186702442}] :answer-field/correct {:answer/id #uuid "9c65f024-89c0-5e0e-8a3c-f1afef14c36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\ln 2}" :db/id #edb/ref 17592186702442} :answer-field/id #uuid "3e2af618-1f03-5319-8f9f-301c03f46710" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186702430}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "781621b7-55ef-5f64-8701-ea2a6ff47011" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{1} 2^{-2x+3}\\,\\mathrm{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=-2x+3$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-2\\quad\\Longrightarrow\\quad\\mathrm{d}x=- \\frac{1}{2}\\,\\mathrm{d}u.\n$$\n\nTransform both limits, keeping their corresponding order:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $3$ | $1$ |\n\nNow integrate and evaluate:\n\n$$\n\\begin{aligned}\n\\int_{0}^{1} 2^{-2x+3}\\,\\mathrm{d}x&=-\\frac{\\int_{3}^{1} 2^{u}\\,\\mathrm{d}u}{2} \\\\ &=-\\frac{\\left[\\frac{2^{u}}{\\ln 2}\\right]_{3}^{1}}{2} \\\\ &=-\\frac{1}{2\\ln 2}\\left(2^{1}-2^{3}\\right) \\\\ &=-\\frac{1}{2\\ln 2}\\left(2-8\\right) \\\\ &=\\frac{3}{\\ln 2}\n\\end{aligned}\n$$\n\nThe answer is positive because the integrand is positive and the original limits increase."}] [{:db/id #edb/ref 17592186702438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f7abfcc-8e98-5065-b3c1-04e8cb03eb92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{27}" :db/id #edb/ref 17592186702427} {:answer/id #uuid "658b21e5-e2ee-5f8e-855e-f55a02ef1372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{26}{9\\ln 3}" :db/id #edb/ref 17592186702435} {:answer/id #uuid "87f76060-da56-5cbf-9aed-b9aca138901c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{3\\ln 3}" :db/id #edb/ref 17592186702439} {:answer/id #uuid "9030118d-dea0-56e9-944d-3b401601d40e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{28}{27\\ln 3}" :db/id #edb/ref 17592186702440} {:answer/id #uuid "b1470613-0637-531a-8148-19f4483535fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{27\\ln 3}" :db/id #edb/ref 17592186702443}] :answer-field/correct {:answer/id #uuid "b1470613-0637-531a-8148-19f4483535fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{27\\ln 3}" :db/id #edb/ref 17592186702443} :answer-field/id #uuid "4efdb1fd-b246-57e6-b5aa-8ce181a083c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186702432}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "78db84d1-53e6-54ff-b8ae-aaa174d567bd" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{-1}^{0} 3^{-3x-2}\\,\\mathrm{d}x.\n$$" :question/worked-solution "Let $u=-3x-2$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-3\\quad\\Longrightarrow\\quad\\mathrm{d}x=- \\frac{1}{3}\\,\\mathrm{d}u.\n$$\n\nTransform both limits, keeping their corresponding order:\n\n| $x$ | $-1$ | $0$ |\n| --- | --- | --- |\n| $u$ | $1$ | $-2$ |\n\nNow integrate and evaluate:\n\n$$\n\\begin{aligned}\n\\int_{-1}^{0} 3^{-3x-2}\\,\\mathrm{d}x&=-\\frac{\\int_{1}^{-2} 3^{u}\\,\\mathrm{d}u}{3} \\\\ &=-\\frac{\\left[\\frac{3^{u}}{\\ln 3}\\right]_{1}^{-2}}{3} \\\\ &=-\\frac{1}{3\\ln 3}\\left(3^{-2}-3^{1}\\right) \\\\ &=-\\frac{1}{3\\ln 3}\\left(\\frac{1}{9}-3\\right) \\\\ &=\\frac{26}{27\\ln 3}\n\\end{aligned}\n$$\n\nThe answer is positive because the integrand is positive and the original limits increase."}] [{:db/id #edb/ref 17592186702446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96577d02-2876-5882-a8c7-0065ef2d0ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{\\ln 2}" :db/id #edb/ref 17592186702441}] :answer-field/correct {:answer/id #uuid "96577d02-2876-5882-a8c7-0065ef2d0ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{\\ln 2}" :db/id #edb/ref 17592186702441} :answer-field/id #uuid "ba510d57-8c92-5c5b-866c-ec5faf6b6801" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186702444}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d68d6698-a950-5c8b-8121-b493b31af2af" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{1}^{3} 2\\cdot 2^{3x-4}\\,\\mathrm{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=3x-4$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3\\quad\\Longrightarrow\\quad\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u.\n$$\n\nTransform both limits, keeping their corresponding order:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $5$ |\n\nNow integrate and evaluate:\n\n$$\n\\begin{aligned}\n\\int_{1}^{3} 2\\cdot 2^{3x-4}\\,\\mathrm{d}x&=\\frac{2\\cdot \\int_{-1}^{5} 2^{u}\\,\\mathrm{d}u}{3} \\\\ &=\\frac{2\\cdot \\left[\\frac{2^{u}}{\\ln 2}\\right]_{-1}^{5}}{3} \\\\ &=\\frac{2}{3\\ln 2}\\left(2^{5}-2^{-1}\\right) \\\\ &=\\frac{2}{3\\ln 2}\\left(32-\\frac{1}{2}\\right) \\\\ &=\\frac{21}{\\ln 2}\n\\end{aligned}\n$$\n\nThe answer is positive because the integrand is positive and the original limits increase."}] [{:db/id #edb/ref 17592186704829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e749ef30-77c5-59c3-a1e0-393b936f7f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{