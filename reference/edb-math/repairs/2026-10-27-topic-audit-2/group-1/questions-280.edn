ta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1371ebf8-eb22-510a-8da9-ab71603cf224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)x{e}^{x}" :db/id #edb/ref 17592186284960} {:answer/id #uuid "53d9fa80-4531-56fa-a24b-26f7f44fadfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{x}" :db/id #edb/ref 17592186285560} {:answer/id #uuid "7e63c504-8cfa-54d7-aead-931836c675c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(2{e}^{x}+x)" :db/id #edb/ref 17592186285950} {:answer/id #uuid "8f418a4b-7d9e-52b0-a17c-229783a68355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)x{e}^{x}" :db/id #edb/ref 17592186286094} {:answer/id #uuid "904ec37a-bb54-5997-a86e-3970a5f9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(x{e}^{x}+2)" :db/id #edb/ref 17592186286106}] :answer-field/correct {:answer/id #uuid "1371ebf8-eb22-510a-8da9-ab71603cf224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)x{e}^{x}" :db/id #edb/ref 17592186284960} :answer-field/id #uuid "4af7b461-8f62-58e4-ac36-73b94cae5741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287310}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5d5b2e99-3a45-59ab-9bf2-0e86debf5990" :question/math-academy-id "q-1916" :question/problem "Given that $f(x)={x}^{2}{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2})^{′}{e}^{x}+{x}^{2}({e}^{x})^{′} \\\\  & =(2x)({e}^{x})+({x}^{2})({e}^{x}) \\\\  & =2x{e}^{x}+{x}^{2}{e}^{x} \\\\  & =(x+2)x{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329a0351-2458-5dc2-afb3-fb83d076e70a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}sec⁡x+{e}^{x}{sec}^{2}⁡x" :db/id #edb/ref 17592186285251} {:answer/id #uuid "3d41ba8e-fd4a-5c5b-8e2c-3eb30e482c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186285366} {:answer/id #uuid "5b2ff268-76d1-583f-9abe-62b917b9c7eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}{csc}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186285621} {:answer/id #uuid "93783351-25ff-5c87-8ae9-958c98c327e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+tan⁡x" :db/id #edb/ref 17592186286129} {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186286945}] :answer-field/correct {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186286945} :answer-field/id #uuid "a44b9e2e-ea9e-5094-bc4f-bc781e7df5d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287478}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a541e9ea-7fd8-5568-9e5c-f9ef03f5eaf6" :question/math-academy-id "q-1931" :question/problem "Differentiate ${e}^{x}tan⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=tan⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}tan⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot tan⁡x+{e}^{x}\\cdot (tan⁡x)^{′} \\\\  & =({e}^{x})(tan⁡x)+({e}^{x})({sec}^{2}⁡x) \\\\  & ={e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733a21b6-530d-58ad-a226-6cac63423ff9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{ln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186285849} {:answer/id #uuid "b59cbc6b-900a-5727-b8b9-ede6d31b43fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{x}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286442} {:answer/id #uuid "b7de04db-df2e-5b86-833c-791e2ab5c775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}+sin⁡xlog⁡x" :db/id #edb/ref 17592186286464} {:answer/id #uuid "c5d4f500-323e-5311-9fac-df967ad59f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286604} {:answer/id #uuid "df108f3b-d4a9-5d27-b27b-ac44d2256aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{x}-sin⁡x" :db/id #edb/ref 17592186286822}] :answer-field/correct {:answer/id #uuid "c5d4f500-323e-5311-9fac-df967ad59f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286604} :answer-field/id #uuid "87489006-c764-5370-a687-c0a258ab9b3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287432}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d56c895-83f0-5d1c-bce1-e5e5d8df4d98" :question/math-academy-id "q-1934" :question/problem "Given that $f(x)=cos⁡xlog⁡x,$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=cos⁡x$ and $v(x)=log⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(cos⁡x)}^{′}log⁡x+cos⁡x{(log⁡x)}^{′} \\\\  & =(-sin⁡x)(log⁡x)+(cos⁡x)\\left(\\frac{1}{xln⁡10}\\right) \\\\  & =\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d4843e-1503-5b14-9ef4-6d9bd866b768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta +C" :db/id #edb/ref 17592186284994} {:answer/id #uuid "5f513476-ecb1-5481-9bb0-8cd729eba6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡xcot⁡x+C" :db/id #edb/ref 17592186285660} {:answer/id #uuid "c159be5b-9ba9-50ec-90b5-6beba2ba516f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡\\theta +C" :db/id #edb/ref 17592186286558} {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} {:answer/id #uuid "f5a909e4-a442-5f93-bb1c-8af5b5eeb86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-csc⁡\\theta +C" :db/id #edb/ref 17592186287037}] :answer-field/correct {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} :answer-field/id #uuid "f5759735-03db-58c8-afc1-42a56314fd9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287647}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8eefdd68-c49a-5b6b-9578-f46e438f3aac" :question/math-academy-id "q-2038" :question/problem "$$\n\\displaystyle \\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta =\n$$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta  & =-\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =-(sec⁡\\theta )+C \\\\  & =-sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346358f5-312e-5c8a-9238-6be633b31e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186288379} {:answer/id #uuid "419bbacf-36c2-544f-888a-5bf28372bd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186288478} {:answer/id #uuid "70205983-7a23-51c1-a345-bf2ec479a0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x+C" :db/id #edb/ref 17592186288812} {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} {:answer/id #uuid "c6a193d2-0ce7-5a28-86c4-834fae7f7271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186289350}] :answer-field/correct {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} :answer-field/id #uuid "0c59fbc8-d124-507b-af30-f117e1976ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d70818e9-1705-53df-abe3-9e6e72f287c6" :question/math-academy-id "q-2161" :question/problem "$$\n\\displaystyle \\int (cos⁡x-sin⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (cos⁡x-sin⁡x)\\,\\text{d}x & =\\int cos⁡x\\,\\text{d}x-\\int sin⁡x\\,\\text{d}x \\\\  & =sin⁡x-(-cos⁡x)+C \\\\  & =sin⁡x+cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0c250-5bf4-502b-ac7f-de044cfaaa10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186288340} {:answer/id #uuid "3f822d39-9367-56e2-94ac-4e46c353ca47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4csc⁡x-tan⁡x+C" :db/id #edb/ref 17592186288464} {:answer/id #uuid "74d923d2-3efc-5ca9-941b-f2721f9ebb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4csc⁡x+sec⁡x+C" :db/id #edb/ref 17592186288844} {:answer/id #uuid "abf937ba-cc12-532c-bb17-a12d2975c76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4cot⁡x+tan⁡x+C" :db/id #edb/ref 17592186289171} {:answer/id #uuid "ba90d1ee-fd42-5b53-b6d2-9a950b91bbcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186289264}] :answer-field/correct {:answer/id #uuid "ba90d1ee-fd42-5b53-b6d2-9a950b91bbcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186289264} :answer-field/id #uuid "1f887537-7c98-501a-bbfa-38699eb068a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289808}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "150e96e0-2dad-5989-ac38-041fb3f1fdd0" :question/math-academy-id "q-2164" :question/problem "$$\n\\displaystyle \\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int csc⁡xcot⁡x\\,\\text{d}x & =-csc⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (4csc⁡xcot⁡x+{sec}^{2}⁡x)\\,\\text{d}x & =\\int 4csc⁡xcot⁡x\\,\\text{d}x+\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =4(-csc⁡x)+tan⁡x+C \\\\  & =-4csc⁡x+tan⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5868b07-bcc9-5439-8718-abc34721e4f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438022} {:answer/id #uuid "b4492437-18b0-5ea5-afe3-0c95f6e8c559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438023}] :answer-field/correct {:answer/id #uuid "b4492437-18b0-5ea5-afe3-0c95f6e8c559" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438023} :answer-field/id #uuid "049db57c-a0e7-56de-b01d-934b8edb71e7" :answer-field/key "The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439040} {:answer-field/choices [{:answer/id #uuid "f4c2d785-bfd8-52bd-920b-fdf30600fb45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438024} {:answer/id #uuid "65d473ca-16c2-5906-9a4b-4d38e4d203a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438025}] :answer-field/correct {:answer/id #uuid "f4c2d785-bfd8-52bd-920b-fdf30600fb45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438024} :answer-field/id #uuid "e8b8f0da-7701-59ac-b62e-e3c7f0b5a210" :answer-field/key "The function has a minimum value at  $x=2\\pi .$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439041} {:answer-field/choices [{:answer/id #uuid "88d518a6-aec2-5916-b3c0-47b033deb6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438026} {:answer/id #uuid "0e2171a1-1911-5a58-a449-b31bc5f2edce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438027}] :answer-field/correct {:answer/id #uuid "88d518a6-aec2-5916-b3c0-47b033deb6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438026} :answer-field/id #uuid "cf911183-758e-5ef8-9432-74581ddfaa58" :answer-field/key "The function intersects the $y$-axis at $y=0.$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439042}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{cos}⁡x?$\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement “The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$” is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement “The function has a minimum value at  $x=2\\pi .$” is false. The function has a maximum at $x=2\\pi .$\n\n- Statement “The function intersects the $y$-axis at $y=0.$” is false. The function intersects the $y$-axis at $y=1.$"}] [{:db/id #edb/ref 17592186292870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231}] :answer-field/correct {:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231} :answer-field/id #uuid "60cd938e-fe0c-506b-935f-e549ff5c73c7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292029}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d53568b9-73ac-5ba0-8169-82ca6f9fc7df" :question/math-academy-id "q-275595" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{vmatrix}=\n$$\n {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{vmatrix} & =\\sqrt{3}\\cdot \\sqrt{3}-y\\cdot 2 \\\\  & =3-2y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058}] :answer-field/correct {:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058} :answer-field/id #uuid "5deef2d0-b2e7-54ab-a3df-7734195f5705" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292019}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d712990-6aa9-538b-af72-704fc59cbac8" :question/math-academy-id "q-275598" :question/problem "If\n$$\n\\displaystyle C=\\begin{bmatrix}1 & k \\\\ 4 & 6\\end{bmatrix}\n$$\nand\n$\\text{det}(C)=-14,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}1 & k \\\\ 4 & 6\\end{vmatrix} \\\\  & =1\\cdot 6-k\\cdot 4 \\\\  & =6-4k.\\end{aligned}\n$$\n\nSince $det(C)=-14$, we get\n\n$$\n\\begin{aligned}det(C) & =-14 \\\\ 6-4k & =-14 \\\\ -4k & =-14-6 \\\\ -4k & =-20 \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266}] :answer-field/correct {:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266} :answer-field/id #uuid "339de4a9-ce7b-517d-9496-4255c739b1c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291908}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d673c24b-03d4-55e8-a5fb-605bc1d6c21f" :question/math-academy-id "q-275601" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{bmatrix}\n$$\nand $det(A)=7,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{vmatrix} \\\\  & =(3+p)(5-p)-(4p-{p}^{2})\\cdot 1 \\\\  & =15-3p+5p-{p}^{2}-4p+{p}^{2} \\\\  & =15-2p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =15-2p.\\end{aligned}\n$$\n\nFinally, since $det(A)=7$, we obtain\n\n$$\n\\begin{aligned}det(A) & =7 \\\\ 15-2p & =7 \\\\ -2p & =-8 \\\\ p & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68846e-8392-5a94-a3aa-2686ed8da072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{16}" :db/id #edb/ref 17592186295320} {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} {:answer/id #uuid "567f2736-63ee-5f2a-b291-57227aca1813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{16}" :db/id #edb/ref 17592186295771} {:answer/id #uuid "98a360bd-7dc7-5172-9965-33a5e01d2144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{75}{16}" :db/id #edb/ref 17592186296086} {:answer/id #uuid "b68c6e0c-5bad-5bf2-bfb7-247965fb865b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{8}" :db/id #edb/ref 17592186296225}] :answer-field/correct {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} :answer-field/id #uuid "f97a2636-5f46-5511-ac10-6484a8f5f52e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297145}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38f9635e-72c4-5968-9945-fe2ceda9691e" :question/math-academy-id "q-30922" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=-2x,$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x & =-5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{-2x}\\,\\text{d}u \\\\  & =-5{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{-2})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({4}^{-2})} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡({4}^{-2})}-{e}^{0}) \\\\  & =\\frac{5}{2}({4}^{-2}-1) \\\\  & =\\frac{5}{2}(\\frac{1}{16}-1) \\\\  & =\\frac{5}{2}\\cdot \\left(-\\frac{15}{16}\\right) \\\\  & =-\\frac{75}{32}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b95ba0-8776-5e87-8a07-fb4dd6e251e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295276} {:answer/id #uuid "36229afc-ab9a-5470-be3f-a37b681ee81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3}" :db/id #edb/ref 17592186295571} {:answer/id #uuid "43ef6c71-98a2-5c12-8945-04c4d08e3cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295649} {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} {:answer/id #uuid "8fc47e71-ee79-5542-acba-c30ea159db79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186296034}] :answer-field/correct {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} :answer-field/id #uuid "dcf773c9-a379-54a1-a3f0-7de93b756309" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297089}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34a4e0e2-73c5-54dc-8277-4607c07e4179" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\left(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}\\right){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295533} {:answer/id #uuid "4ee811f8-8af9-53fa-be26-778f4f77cd67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{5}^{-x}+C" :db/id #edb/ref 17592186295722} {:answer/id #uuid "57a67b0f-0c05-5b5a-b5ea-792d6c56a440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295773} {:answer/id #uuid "5de84312-4ff6-5203-8c07-5a2dbc5c4c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295809} {:answer/id #uuid "c521dc80-7e50-540f-93b7-e321d21cdb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186296307}] :answer-field/correct {:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295533} :answer-field/id #uuid "4944a858-6895-5891-aed1-aabff8de8a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296769}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91e61cac-e373-57ad-92b8-00ce9bccf78c" :question/math-academy-id "q-31412" :question/problem "$$\n\\displaystyle \\int {5}^{-x}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=-x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {5}^{-x}\\,\\text{d}x & =\\int {5}^{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int {5}^{u}\\,\\text{d}u \\\\  & =-\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297390 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0233f9ce-2764-5d65-ab16-8209abe9223a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295274} {:answer/id #uuid "12f09c2c-e425-5277-8d43-cc46fdd169bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5}+C" :db/id #edb/ref 17592186295370} {:answer/id #uuid "3076245a-c830-5476-aa4e-faa07b490fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295544} {:answer/id #uuid "60697ea3-02a7-5388-b168-e038e029d1f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{4}^{5x-7}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295819} {:answer/id #uuid "e998d14b-9dc3-5546-a7f6-0253d13262c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296510}] :answer-field/correct {:answer/id #uuid "0233f9ce-2764-5d65-ab16-8209abe9223a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295274} :answer-field/id #uuid "1b9605dc-1036-5199-9391-eb2590d1187e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296686}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "747ae585-9faa-50cc-acc3-b1e5b1896ba8" :question/math-academy-id "q-31413" :question/problem "$$\n\\displaystyle \\int {4}^{5x}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=5x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {4}^{5x}\\,\\text{d}x & =\\int {4}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1277c0e2-5004-5ee3-b7fe-7022e68c6a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186295368} {:answer/id #uuid "7cdefd48-2695-5a38-8f5d-ed070355571e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186295950} {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186296343} {:answer/id #uuid "d8ca43b4-033c-5cd0-a8a6-8ea7eb292ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186296410} {:answer/id #uuid "e19fa8a4-2ede-5cc9-a74c-dbb6cdba1380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186296468}] :answer-field/correct {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186296343} :answer-field/id #uuid "1db9f319-6a3e-51d1-bbc2-fd789260b0da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296690}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a2ea8a4-727a-5496-81cd-8ee505de6239" :question/math-academy-id "q-31417" :question/problem "$$\n\\displaystyle \\int {6}^{x/3}\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {6}^{x/3}\\,\\text{d}x & =\\int {6}^{u}\\cdot 3\\,\\text{d}u \\\\  & =3\\int {6}^{u}\\,\\text{d}u \\\\  & =3\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ce25fc2-f172-5796-bdb4-80f062501242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186298240}] :answer-field/correct {:answer/id #uuid "9ce25fc2-f172-5796-bdb4-80f062501242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186298240} :answer-field/id #uuid "42ec026c-9601-596a-aac7-34e1c7298d90" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52b70b4e-c944-5a6c-9fb5-10e8bb1b8364" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$$\n\\displaystyle R=\\begin{bmatrix}8 & -5 \\\\ 3 & 4\\end{bmatrix}.\n$$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}8 & -5 \\\\ 3 & 4\\end{vmatrix} \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56075e41-2276-59fc-aa32-dc0aefbc46ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297914}] :answer-field/correct {:answer/id #uuid "56075e41-2276-59fc-aa32-dc0aefbc46ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297914} :answer-field/id #uuid "9dd2ce63-3870-5dc7-88b5-af30fb44581f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299157}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "51e6ce71-0f6b-5ca6-9047-0832d38b3af3" :question/math-academy-id "q-317336" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}2 & 4 \\\\ 1 & 3\\end{vmatrix} \\\\  & =(2)(3)-(4)(1) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299593 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6324678-0597-5421-a104-04c3342494f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298419}] :answer-field/correct {:answer/id #uuid "c6324678-0597-5421-a104-04c3342494f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298419} :answer-field/id #uuid "cfc4e21a-193b-52dd-8dc9-d21c2d8f7ddb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299337}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd3c7419-67b1-5120-a5e4-6bd19d8d0a71" :question/math-academy-id "q-317342" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}6 & -2 \\\\ 5 & 7\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}6 & -2 \\\\ 5 & 7\\end{vmatrix} \\\\  & =(6)(7)-(-2)(5) \\\\  & =42+10 \\\\  & =52.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616}] :answer-field/correct {:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616} :answer-field/id #uuid "0ac069ea-97f0-5b28-aae8-5ec01ea01538" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298670}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e6ca014c-b5cb-5825-95b8-87e00a3142c6" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{vmatrix} \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774}] :answer-field/correct {:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774} :answer-field/id #uuid "eab4d4b7-2252-5c08-b2b6-6e240fa0a5f2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299429}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a27ba74d-67e7-552a-808b-c86c1ab2858a" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$$\n\\displaystyle E=\\begin{bmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{bmatrix}.\n$$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}3x & 2y \\\\ -5 & x\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}3x & 2y \\\\ -5 & x\\end{vmatrix} \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787} :answer-field/id #uuid "5f79e083-14ad-5456-a436-b4ade461c1f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298964}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9aa98f1a-30c2-558c-875f-c99582477892" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix} & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479}] :answer-field/correct {:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479} :answer-field/id #uuid "154b6de9-0d77-5e77-8de1-45bf6ab48913" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e3ffcd6-7f26-5f4f-8230-33ae44d7f744" :question/math-academy-id "q-317377" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2 & m \\\\ 3 & 5\\end{bmatrix}\n$$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}2 & m \\\\ 3 & 5\\end{vmatrix} \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524}] :answer-field/correct {:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524} :answer-field/id #uuid "ebf4f818-ea4f-5a3d-9526-388b53c60cf1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0f61095-530a-54e2-bb79-353fa0efed39" :question/math-academy-id "q-317382" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}1+r & 2-r \\\\ -5 & 4\\end{bmatrix}\n$$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}1+r & 2-r \\\\ -5 & 4\\end{vmatrix} \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164}] :answer-field/correct {:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164} :answer-field/id #uuid "0eda0fee-f95d-5630-8031-5abef3969057" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298688}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e22859c-f056-5995-96a3-08af912796b8" :question/math-academy-id "q-317385" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}3+s & 2s \\\\ -4 & 3-s\\end{bmatrix}\n$$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}3+s & 2s \\\\ -4 & 3-s\\end{vmatrix} \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5a431d3-5124-5852-8633-c02fe08320b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂s}=\\frac{∂Q}{∂r}" :db/id #edb/ref 17592186298341} {:answer/id #uuid "f22d3646-8e61-5cf0-9cde-b2e5b57a3fe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂s}\\ne \\frac{∂Q}{∂r}" :db/id #edb/ref 17592186298578}] :answer-field/correct {:answer/id #uuid "b5a431d3-5124-5852-8633-c02fe08320b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{∂P}{∂s}=\\frac{∂Q}{∂r}" :db/id #edb/ref 17592186298341} :answer-field/id #uuid "2f2dce55-d564-51cf-8b1f-81e5d69438e9" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186298799} {:answer-field/choices [{:answer/id #uuid "4434c00e-2711-575d-926e-a5d5634c4e42" :answer/type {:db/id #edb/ref 17592186045498