y & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e5b4ed-eeb6-50fd-9d7c-a2cadad2150e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263092} {:answer/id #uuid "17975e13-48f0-5e64-b97d-6b4b3abe3bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263223} {:answer/id #uuid "44bfef5a-564c-5524-bcfb-24152afe7765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263603} {:answer/id #uuid "65042cb7-a615-5767-8903-e2b88dbd8cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263874} {:answer/id #uuid "92181a3e-9464-53f8-8d0a-4cee36eefaf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264253}] :answer-field/correct {:answer/id #uuid "65042cb7-a615-5767-8903-e2b88dbd8cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263874} :answer-field/id #uuid "3963b998-8449-5414-8913-164290af0fad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265349}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2fa0e8d7-3133-5471-9c08-501132fe188f" :question/math-academy-id "q-129322" :question/problem "Find $\\lim_{x\\to (0,-1)}\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}}.\n$$\n\nThe function $f(x,y)$ is continuous except when the denominator is zero. However, the point $(0,-1)$ does not cause the denominator to vanish, so we can calculate the limit by substituting $(0,-1)$ into the function:\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,-1)}\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}} & =\\frac{{0}^{2}-(-1)^{2}}{{0}^{2}+(-1)^{2}} \\\\  & =\\frac{0-1}{0+1} \\\\  & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c1cdaa-8ccc-5f2d-a004-9ae4846bab35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{2}" :db/id #edb/ref 17592186264272} {:answer/id #uuid "aa551ce0-e36c-55d8-b6d7-caa9fba4882b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264454} {:answer/id #uuid "cfa9a350-3a47-50f2-8f0e-6a5936d8b19b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264818} {:answer/id #uuid "ea8fac4d-b063-52b0-8ed7-a78b532ee43a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt[3]{2}" :db/id #edb/ref 17592186265043} {:answer/id #uuid "fccf2baa-e984-5f4c-9fc3-9a03dfb968c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265219}] :answer-field/correct {:answer/id #uuid "aa551ce0-e36c-55d8-b6d7-caa9fba4882b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264454} :answer-field/id #uuid "619cb15a-2c93-5319-81cd-c8a7665c35b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265415}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d53fcb5b-03e0-54f4-94bd-b9eac7281e74" :question/math-academy-id "q-129329" :question/problem "Determine $\\lim_{x\\to (1,-2)}\\sqrt[3]{3x-2y+1}.$" :question/worked-solution "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\sqrt[3]{3x-2y+1}.\n$$\n\nThe function $f(x,y)$ is continuous for all values of $x$ and $y.$ So, we can calculate the limit by substituting $(1,-2)$ into the function:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,-2)}\\sqrt[3]{3x-2y+1} & =\\sqrt[3]{3(1)-2(-2)+1} \\\\  & =\\sqrt[3]{3+4+1} \\\\  & =\\sqrt[3]{8} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ad1bd2-8442-5dfe-b6b9-a6a220f4b699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263602} {:answer/id #uuid "73354caa-11ab-5a26-90fd-714c92eefd92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186264000} {:answer/id #uuid "a62e5c28-ad0a-52bf-bd5e-b5aca29871b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186264421} {:answer/id #uuid "a7d81618-b514-541a-badf-cb234ce0914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264435} {:answer/id #uuid "ab554095-56b3-5440-8583-dc412455d74b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264471}] :answer-field/correct {:answer/id #uuid "a7d81618-b514-541a-badf-cb234ce0914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264435} :answer-field/id #uuid "6f223cdc-4ab9-5d2a-9c8f-fc56257df30b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265436}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8d67ac27-26e1-5580-9eb2-034565720f25" :question/math-academy-id "q-129332" :question/problem "Find $\\lim_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & =\\frac{(-1)(2)+1(2)}{(-1)^{2}-{1}^{2}} \\\\  & =\\frac{-2+2}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & =\\lim_{x\\to (-1,1,2)}\\frac{z(x+y)}{(x+y)(x-y)} \\\\  & =\\lim_{x\\to (-1,1,2)}\\frac{z\\cancel{(x+y)}}{\\cancel{(x+y)}(x-y)} \\\\  & =\\lim_{x\\to (-1,1,2)}\\frac{z}{x-y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,1,2)}\\frac{z}{x-y} & =\\frac{2}{-1-1} \\\\  & =\\frac{2}{(-2)} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-1.$"}] [{:db/id #edb/ref 17592186265714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd3a569-22f5-58d9-b2f8-184a33be9932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186263543} {:answer/id #uuid "73948bda-635e-5d60-afcf-95c733c7ad2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264002} {:answer/id #uuid "ba8ab39b-0d20-5e12-be94-5fb9aa528858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264617} {:answer/id #uuid "c4e3ae72-b88f-5f06-b306-aaafce164c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264726} {:answer/id #uuid "dc64dec8-2f23-5153-a3b2-2728e3383078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264922}] :answer-field/correct {:answer/id #uuid "73948bda-635e-5d60-afcf-95c733c7ad2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264002} :answer-field/id #uuid "2d1300cc-2bf9-55dc-b250-0c25b95b165f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265326}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "715f6fef-c679-5b35-a9f5-f8ac13307bba" :question/math-academy-id "q-129335" :question/problem "Determine $$\n\\displaystyle \\lim_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}}.\n$$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & =\\frac{{2}^{3}-3({2}^{2})(2)+3(2)({2}^{2})-{2}^{3}}{{2}^{2}-2(2)(2)+{2}^{2}} \\\\  & =\\frac{8-24+24-8}{4-8+4} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & =\\lim_{x\\to (2,2)}\\frac{(x-y)^{3}}{(x-y)^{2}} \\\\  & =\\lim_{x\\to (2,2)}\\frac{(x-y)(x-y)^{2}}{(x-y)^{2}} \\\\  & =\\lim_{x\\to (2,2)}\\frac{(x-y)\\cancel{(x-y)^{2}}}{\\cancel{(x-y)^{2}}} \\\\  & =\\lim_{x\\to (2,2)}(x-y)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (2,2)}(x-y) & =2-2=0\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $0.$"}] [{:db/id #edb/ref 17592186265715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0569550f-51bd-575d-b80b-ec093b07682c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263049} {:answer/id #uuid "298d83f3-e1e3-5bce-96c8-4b0b8973f332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263357} {:answer/id #uuid "ba0c56eb-cdff-5db9-9329-b25d29d16a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264610} {:answer/id #uuid "ba22f1e6-506d-59b4-8ad2-edde9f213b02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264611} {:answer/id #uuid "e27a6e9e-7126-5be8-b5d1-8378b185a03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264967}] :answer-field/correct {:answer/id #uuid "e27a6e9e-7126-5be8-b5d1-8378b185a03b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264967} :answer-field/id #uuid "a66c8923-8d97-5e59-b5ab-27bce45dda8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265541}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa92e0c7-08cd-5cb2-af58-76718486c28e" :question/math-academy-id "q-129339" :question/problem "Find $\\lim_{x\\to (-1,-1)}\\frac{{x}^{2}-{y}^{2}}{{x}^{2}-xy}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,-1)}\\frac{{x}^{2}-{y}^{2}}{{x}^{2}-xy} & =\\frac{(-1)^{2}-(-1)^{2}}{(-1)^{2}-(-1)(-1)} \\\\  & =\\frac{1-1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,-1)}\\frac{{x}^{2}-{y}^{2}}{{x}^{2}-xy} & =\\lim_{x\\to (-1,-1)}\\frac{(x+y)(x-y)}{x(x-y)} \\\\  & =\\lim_{x\\to (-1,-1)}\\frac{(x+y)\\cancel{(x-y)}}{x\\cancel{(x-y)}} \\\\  & =\\lim_{x\\to (-1,-1)}\\frac{x+y}{x}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (-1,-1)}\\frac{x+y}{x} & =\\frac{-1+(-1)}{(-1)} \\\\  & =\\frac{(-2)}{(-1)} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $2.$"}] [{:db/id #edb/ref 17592186265716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b2e738-d4ff-5a73-bf88-ee96a546601e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263713} {:answer/id #uuid "6e5d18cd-26e9-513a-9ac2-d9e28cdc3a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186263957} {:answer/id #uuid "859fba6d-65df-52f9-8934-78218673bfa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264151} {:answer/id #uuid "b3999021-6e0d-58f6-8af2-534ecd301f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264540} {:answer/id #uuid "f16bc0b6-a366-5c5f-a505-fcaf77e8d63c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265120}] :answer-field/correct {:answer/id #uuid "f16bc0b6-a366-5c5f-a505-fcaf77e8d63c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265120} :answer-field/id #uuid "828835a1-d776-5ae6-8933-2aafe083fed7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265474}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d8bc5519-0c3a-5438-9140-d93c11fd7b22" :question/math-academy-id "q-129342" :question/problem "$$\n\\lim_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}}=\n$$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & =\\frac{\\sqrt{0}-\\sqrt{0}+0-0}{\\sqrt{0}-\\sqrt{0}} \\\\  & =\\frac{0-0+0-0}{0-0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{\\sqrt{x}-\\sqrt{y}+x-y}{\\sqrt{x}-\\sqrt{y}} & =\\lim_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y}+x-y)(\\sqrt{x}+\\sqrt{y})}{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})} \\\\  & =\\lim_{x\\to (0,0)}\\frac{(\\sqrt{x}-\\sqrt{y})(\\sqrt{x}+\\sqrt{y})+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{x\\to (0,0)}\\frac{x-y+(x-y)(\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{x\\to (0,0)}\\frac{(x-y)(1+\\sqrt{x}+\\sqrt{y})}{x-y} \\\\  & =\\lim_{x\\to (0,0)}\\frac{\\cancel{(x-y)}(1+\\sqrt{x}+\\sqrt{y})}{\\cancel{x-y}} \\\\  & =\\lim_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}(1+\\sqrt{x}+\\sqrt{y}) & =1+\\sqrt{0}+\\sqrt{0} \\\\  & =1+0+0 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $1.$"}] [{:db/id #edb/ref 17592186265717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0baa5e10-5459-5732-9dd7-5d51a31a7b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263111} {:answer/id #uuid "3fec9ee5-6ae2-58fe-8a38-325b070dba28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263564} {:answer/id #uuid "815895b6-8daa-5f01-b1e0-50eb24942d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264112} {:answer/id #uuid "ed0f99ee-d7bb-5f69-b6bb-53b9408bee54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265068} {:answer/id #uuid "fcd17ed5-cd78-5b95-8110-e650724142fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186265220}] :answer-field/correct {:answer/id #uuid "ed0f99ee-d7bb-5f69-b6bb-53b9408bee54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265068} :answer-field/id #uuid "f643f621-c0dd-5dc1-b633-084448f646c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265686}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "43a8fc7d-552c-5ee1-ac4a-431ddf37f045" :question/math-academy-id "q-129345" :question/problem "$\\lim_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1} & =\\frac{1\\sqrt{2+(-1)}-1}{({1}^{2})(2+(-1))-1} \\\\  & =\\frac{1-1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1} & =\\lim_{x\\to (1,2,-1)}\\frac{(x\\sqrt{y+z}-1)(x\\sqrt{y+z}+1)}{({x}^{2}(y+z)-1)(x\\sqrt{y+z}+1)} \\\\  & =\\lim_{x\\to (1,2,-1)}\\frac{{x}^{2}(y+z)-1}{({x}^{2}(y+z)-1)(x\\sqrt{y+z}+1)} \\\\  & =\\lim_{x\\to (1,2,-1)}\\frac{\\cancel{{x}^{2}(y+z)-1}}{\\cancel{({x}^{2}(y+z)-1)}(x\\sqrt{y+z}+1)} \\\\  & =\\lim_{x\\to (1,2,-1)}\\frac{1}{x\\sqrt{y+z}+1}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2,-1)}\\frac{1}{x\\sqrt{y+z}+1} & =\\frac{1}{1\\sqrt{2+(-1)}+1} \\\\  & =\\frac{1}{1+1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186265718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36de98d3-7bb5-5915-95e1-b5b78a147e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263490} {:answer/id #uuid "41df6099-6368-5629-97e7-c9681245feb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263583} {:answer/id #uuid "a9fbcaf4-6b4a-5eed-b561-6f65f5756d96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264452} {:answer/id #uuid "b4ae1d76-9dd1-56fd-88c0-3619b135a8a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264554} {:answer/id #uuid "e08b40a4-9f01-5372-973d-b6907da00dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264949}] :answer-field/correct {:answer/id #uuid "e08b40a4-9f01-5372-973d-b6907da00dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264949} :answer-field/id #uuid "2df59ef6-6f84-55da-879a-62c922b8039c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265329}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "98eb7cb6-6c4e-52ce-9f7d-3ac96c9eabeb" :question/math-academy-id "q-129346" :question/problem "Find $\\lim_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z} & =\\frac{1+0-{1}^{2}}{\\sqrt{1+0}-1} \\\\  & =\\frac{1+0-1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z} & =\\lim_{x\\to (1,0,1)}\\frac{(x+y-{z}^{2})(\\sqrt{x+y}+z)}{(\\sqrt{x+y}-z)(\\sqrt{x+y}+z)} \\\\  & =\\lim_{x\\to (1,0,1)}\\frac{(x+y-{z}^{2})(\\sqrt{x+y}+z)}{x+y-{z}^{2}} \\\\  & =\\lim_{x\\to (1,0,1)}\\frac{\\cancel{(x+y-{z}^{2})}(\\sqrt{x+y}+z)}{\\cancel{x+y-{z}^{2}}} \\\\  & =\\lim_{x\\to (1,0,1)}(\\sqrt{x+y}+z)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,0,1)}(\\sqrt{x+y}+z) & =\\sqrt{1+0}+1 \\\\  & =1+0+1 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $2.$"}] [{:db/id #edb/ref 17592186265719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b35a9a-4cdd-5c91-90ee-71d656ed495e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186263007} {:answer/id #uuid "528d1499-5272-5dd7-b3fb-6258a07d6726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263712} {:answer/id #uuid "a015c9d1-4b16-5124-b907-8539b7f1f1ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264363} {:answer/id #uuid "c7d18dad-121a-5539-aa6a-64f5b013d4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186264750} {:answer/id #uuid "fde472b2-1fec-5b3a-b7d9-d562106cbe12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186265233}] :answer-field/correct {:answer/id #uuid "c7d18dad-121a-5539-aa6a-64f5b013d4db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186264750} :answer-field/id #uuid "a416a2ef-a857-581b-bbef-47029f3cce4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265533}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b38eaadb-c5b0-5008-b859-4e13e1a65105" :question/math-academy-id "q-129348" :question/problem "$\\lim_{x\\to (0,0)}\\frac{\\sqrt{{x}^{2}{y}^{2}+9}-3}{{x}^{2}{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{\\sqrt{{x}^{2}{y}^{2}+9}-3}{{x}^{2}{y}^{2}} & =\\frac{\\sqrt{({0}^{2})({0}^{2})+9}-3}{({0}^{2})({0}^{2})} \\\\  & =\\frac{3-3}{0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{\\sqrt{{x}^{2}{y}^{2}+9}-3}{{x}^{2}{y}^{2}} & =\\lim_{x\\to (0,0)}\\frac{(\\sqrt{{x}^{2}{y}^{2}+9}-3)(\\sqrt{{x}^{2}{y}^{2}+9}+3)}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & =\\lim_{x\\to (0,0)}\\frac{{x}^{2}{y}^{2}+9-9}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & =\\lim_{x\\to (0,0)}\\frac{{x}^{2}{y}^{2}}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & =\\lim_{x\\to (0,0)}\\frac{\\cancel{{x}^{2}{y}^{2}}}{\\cancel{{x}^{2}{y}^{2}}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & =\\lim_{x\\to (0,0)}\\frac{1}{\\sqrt{{x}^{2}{y}^{2}+9}+3}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{1}{\\sqrt{{x}^{2}{y}^{2}+9}+3} & =\\frac{1}{\\sqrt{({0}^{2})({0}^{2})+9}+3} \\\\  & =\\frac{1}{\\sqrt{9}+3} \\\\  & =\\frac{1}{3+3} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{6}.$"}] [{:db/id #edb/ref 17592186265721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c16c662e-6c36-5bf3-9a52-d68e7902ba15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463760} {:answer/id #uuid "303d13d8-c568-5462-a96e-7d9428cc0d8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463761}] :answer-field/correct {:answer/id #uuid "303d13d8-c568-5462-a96e-7d9428cc0d8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463761} :answer-field/id #uuid "cabcaf59-25b4-5a2a-bea6-e13d0904de77" :answer-field/key "The limit evaluates to $2$ along the path $y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464814} {:answer-field/choices [{:answer/id #uuid "1f3edabc-c5eb-54d4-b7ff-8f9655427dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463762} {:answer/id #uuid "f3850539-7158-5fcf-8ebd-98d1a0685dcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463763}] :answer-field/correct {:answer/id #uuid "f3850539-7158-5fcf-8ebd-98d1a0685dcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463763} :answer-field/id #uuid "34866a6a-1b03-5e91-a0b3-e6c757b74c41" :answer-field/key "The limit evaluates to $\\frac{1}{3}$ along the path $y=x$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464815} {:answer-field/choices [{:answer/id #uuid "28836dbd-a890-547c-9183-fb1de06ae39a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463764} {:answer/id #uuid "3afc1354-96f1-5aed-a802-292fe64f8795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463765}] :answer-field/correct {:answer/id #uuid "3afc1354-96f1-5aed-a802-292fe64f8795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463765} :answer-field/id #uuid "e2aff006-d18e-573f-82f2-1f4b6cb7dfd9" :answer-field/key "The limit does not exist" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464816}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32eaab66-626d-536b-9465-8d972be98972" :question/math-academy-id "q-129405" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n\\lim_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}}\n$$\n\nSelect all that apply." :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & =\\frac{2({0}^{2})-{0}^{2}}{{0}^{2}+2({0}^{2})} \\\\  & =\\frac{0-0}{0+0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement “The limit evaluates to $2$ along the path $y=0$” is true. Taking $x\\to (0,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & =\\lim_{x\\to 0}\\,\\frac{2{x}^{2}-{0}^{2}}{{x}^{2}+2({0}^{2})} \\\\  & =\\lim_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{2\\cancel{{x}^{2}}}{\\cancel{{x}^{2}}} \\\\  & =\\lim_{x\\to 0}2 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement “The limit evaluates to $\\frac{1}{3}$ along the path $y=x$” is also true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & =\\lim_{x\\to 0}\\frac{2{x}^{2}-{x}^{2}}{{x}^{2}+2{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{{x}^{2}}{3{x}^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{{x}^{2}}}{3\\cancel{{x}^{2}}} \\\\  & =\\lim_{x\\to 0}\\frac{1}{3} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\n- Statement “The limit does not exist” is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186265722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e982015-e57d-5a0b-a9cf-5d08deab7ed2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448356} {:answer/id #uuid "2459a454-5301-5e77-b21b-b6196bab14e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448357}] :answer-field/correct {:answer/id #uuid "2459a454-5301-5e77-b21b-b6196bab14e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448357} :answer-field/id #uuid "0d95f94d-2076-5218-bb4b-c6ab553eb89a" :answer-field/key "The limit evaluates to $0$ along the path $y=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449218} {:answer-field/choices [{:answer/id #uuid "8b6df36c-4778-5e0d-8a29-4c2efc4da127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448358} {:answer/id #uuid "51ef316d-e1c9-5b72-9ff3-7956a1c2c951" :answer/type {:db/id #edb/ref 