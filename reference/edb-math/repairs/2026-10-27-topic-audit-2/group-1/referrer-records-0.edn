id #edb/ref 17592186124261} :knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186124938} {:db/id #edb/ref 17592186125222} {:db/id #edb/ref 17592186265721} {:db/id #edb/ref 17592186265722} {:db/id #edb/ref 17592186265723} {:db/id #edb/ref 17592186335802} {:db/id #edb/ref 17592186345004} {:db/id #edb/ref 17592186345005} {:db/id #edb/ref 17592186377708} {:db/id #edb/ref 17592186378636} {:db/id #edb/ref 17592186380062} {:db/id #edb/ref 17592186407847} {:db/id #edb/ref 17592186436127} {:db/id #edb/ref 17592186475943} {:db/id #edb/ref 17592186508069} {:db/id #edb/ref 17592186565425} {:db/id #edb/ref 17592186565432}] :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions"}] [{:db/id #edb/ref 17592186124558 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124367} :knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050225}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186125221} {:db/id #edb/ref 17592186125224} {:db/id #edb/ref 17592186265716} {:db/id #edb/ref 17592186265717} {:db/id #edb/ref 17592186265718} {:db/id #edb/ref 17592186265719} {:db/id #edb/ref 17592186345001} {:db/id #edb/ref 17592186345002} {:db/id #edb/ref 17592186345003} {:db/id #edb/ref 17592186407848} {:db/id #edb/ref 17592186407849} {:db/id #edb/ref 17592186436124} {:db/id #edb/ref 17592186436130} {:db/id #edb/ref 17592186508060} {:db/id #edb/ref 17592186534002} {:db/id #edb/ref 17592186565424} {:db/id #edb/ref 17592186565463}] :knowledge-point/title "Calculating Limits of Multivariable Functions Using Conjugate Multiplication"}] [{:db/id #edb/ref 17592186125222 :question/answer-fields [{:answer-field/choices [{:answer/