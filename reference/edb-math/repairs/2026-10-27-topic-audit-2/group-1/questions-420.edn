17592186436075} {:answer/id #uuid "566a1241-e2de-561e-9daf-82cc2652adff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186436092} {:answer/id #uuid "5e0718a8-d111-53b4-8167-8361933440ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436094} {:answer/id #uuid "705005f1-4e76-51ab-bd86-bbc4756b8e21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186436096} {:answer/id #uuid "8579266b-a01b-54d9-9032-9c94a818a557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186436099}] :answer-field/correct {:answer/id #uuid "5e0718a8-d111-53b4-8167-8361933440ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436094} :answer-field/id #uuid "c964af35-b530-511c-ba6c-a0a70d2a6c2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436119}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88f91bc6-5d92-5d89-9639-1db1ee91906d" :question/math-academy-id "q-74908" :question/problem "Find $\\lim_{x\\to (-2,-2)}\\sqrt{xy}.$" :question/worked-solution "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\sqrt{xy}.\n$$\n\nThe function $f(x,y)$ is continuous except when the expression under the radical   is negative. However, for the point $(-2,-2)$ the product $x\\cdot y$ is not negative, so we can calculate the limit by substituting  $(-2,-2)$ into the function: \n\n$$\n\\begin{aligned}\\lim_{x\\to (-2,-2)}\\sqrt{xy}=\\sqrt{(-2)\\cdot (-2)}=\\sqrt{4}=2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0924a936-e922-5c55-aa02-d684eeb3f2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186436077} {:answer/id #uuid "753869fe-932f-5db8-83a0-37c1015d805e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436097} {:answer/id #uuid "90465371-f2d3-501a-b599-455e14d6af8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436100} {:answer/id #uuid "ae730908-c126-5126-80c5-7ba1a6367fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436104} {:answer/id #uuid "f1888faf-1d96-547d-a447-76ace2c376d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186436113}] :answer-field/correct {:answer/id #uuid "f1888faf-1d96-547d-a447-76ace2c376d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186436113} :answer-field/id #uuid "78bd852f-26bb-5b2b-90e2-b2dc4782250d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436117}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9df4444a-990b-5f68-bec9-ae4f2c45450b" :question/math-academy-id "q-129402" :question/problem "Determine $\\lim_{x\\to (0,0)}\\frac{{x}^{2}y}{{x}^{4}+{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)}\\frac{{x}^{2}y}{{x}^{4}+{y}^{2}} & =\\frac{({0}^{2})(0)}{{0}^{4}+{0}^{2}} \\\\  & =\\frac{0}{0+0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y=0}\\frac{{x}^{2}y}{{x}^{4}+{y}^{2}} & =\\lim_{x\\to 0}\\frac{{x}^{2}(0)}{{x}^{4}+{0}^{2}} \\\\  & =\\lim_{x\\to 0}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\frac{{x}^{2}y}{{x}^{4}+{y}^{2}} & =\\lim_{x\\to 0}\\frac{{x}^{2}({x}^{2})}{{x}^{4}+({x}^{2})^{2}} \\\\  & =\\lim_{x\\to 0}\\frac{{x}^{4}}{{x}^{4}+{x}^{4}} \\\\  & =\\lim_{x\\to 0}\\frac{\\cancel{{x}^{4}}}{2\\cancel{{x}^{4}}} \\\\  & =\\lim_{x\\to 0}\\frac{1}{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{x\\to (0,0)}\\frac{{x}^{2}y}{{x}^{4}+{y}^{2}}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186436128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a55cd8-59d4-51e6-bfc3-6f7e89d540fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436078} {:answer/id #uuid "289a71e6-833a-5782-99bf-9eaaf974a1d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186436082} {:answer/id #uuid "924475dc-6d5b-55d7-b419-2671e1182f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186436101} {:answer/id #uuid "baaec9e1-8b5e-5f7f-8ef8-59b96e26a955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436106} {:answer/id #uuid "d6a58b3c-76e3-54b6-ab35-4bf1be82b8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186436109}] :answer-field/correct {:answer/id #uuid "baaec9e1-8b5e-5f7f-8ef8-59b96e26a955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436106} :answer-field/id #uuid "8116b6c2-1cab-5c9a-af1a-53984a742595" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436118}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a678f4db-f59f-58b6-9d8f-ba8fadd30c17" :question/math-academy-id "q-129336" :question/problem "Determine $\\lim_{x\\to (1,-1)}\\frac{{x}^{3}+2{x}^{2}y+x{y}^{2}}{x+y}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}\\lim_{x\\to (1,-1)}\\frac{{x}^{3}+2{x}^{2}y+x{y}^{2}}{x+y} & =\\frac{{1}^{3}+2(1)^{2}(-1)+1(-1)^{2}}{1+(-1)} \\\\  & =\\frac{1-2+1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,-1)}\\frac{{x}^{3}+2{x}^{2}y+x{y}^{2}}{x+y} & =\\lim_{x\\to (1,-1)}\\frac{x({x}^{2}+2xy+{y}^{2})}{x+y} \\\\  & =\\lim_{x\\to (1,-1)}\\frac{x(x+y)(x+y)}{x+y} \\\\  & =\\lim_{x\\to (1,-1)}\\frac{x(x+y)\\cancel{(x+y)}}{\\cancel{x+y}} \\\\  & =\\lim_{x\\to (1,-1)}x(x+y)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,-1)}x(x+y) & =1(1-1)=0\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $0.$"}] [{:db/id #edb/ref 17592186436129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e050b6b-4c71-5b1d-95f2-c237914af9e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436080} {:answer/id #uuid "23db4813-aed1-5501-99cf-12aa83f3383d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436081} {:answer/id #uuid "4c47b885-90cb-59cf-b936-3007bf1a5ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186436090} {:answer/id #uuid "a7f9219d-acd8-5505-9300-47d9ac52607b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186436102} {:answer/id #uuid "e3f4f9e0-fb6f-53dd-a9eb-91c9e707abd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436112}] :answer-field/correct {:answer/id #uuid "23db4813-aed1-5501-99cf-12aa83f3383d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436081} :answer-field/id #uuid "f486c765-ecd7-5a87-8f26-635e2f270bec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436122}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c11b4e02-4fa9-528c-867b-1ff09ac00c10" :question/math-academy-id "q-74911" :question/problem "$$\n\\lim_{x\\to (4,-4,-2)}\\frac{\\sqrt[3]{x-y}}{z}=\n$$" :question/worked-solution "The function \n\n$$\nf(x,y,z)=\\frac{\\sqrt[3]{x-y}}{z}\n$$\n\nis continuous except when the denominator is zero. However, the point $(4,-4,-2)$ does not cause the  denominator to vanish, so we can calculate the limit by substituting  $(4,-4,-2)$ into the function: \n\n$$\n\\begin{aligned}\\lim_{x\\to (4,-4,-2)}\\frac{\\sqrt[3]{x-y}}{z} & =\\frac{\\sqrt[3]{4-(-4)}}{(-2)} \\\\  & =\\frac{\\sqrt[3]{8}}{-2} \\\\  & =\\frac{2}{-2} \\\\  & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3da1bffe-a256-5463-b543-084468d49c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186436084} {:answer/id #uuid "47a24a05-5058-5973-b9b9-1f6b550f6f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186436088} {:answer/id #uuid "5512019f-2424-5d94-8ce3-00141bd0391c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186436091} {:answer/id #uuid "aa885501-8121-5a91-81dd-6ab6a0717534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186436103} {:answer/id #uuid "d4dd68e7-ba4b-5f9e-bb24-90eb7a550447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186436108}] :answer-field/correct {:answer/id #uuid "d4dd68e7-ba4b-5f9e-bb24-90eb7a550447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186436108} :answer-field/id #uuid "eebddb13-5c72-52ae-80f4-9d372c2249ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436121}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cdbbe1e3-c4b9-56df-b019-b8be69ef537e" :question/math-academy-id "q-74959" :question/problem "$$\n\\lim_{x\\to (3,3)}\\frac{\\sqrt{6+y}-x}{6+y-{x}^{2}}=\n$$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\lim_{x\\to (3,3)}\\frac{\\sqrt{6+y}-x}{6+y-{x}^{2}}=\\frac{\\sqrt{6+3}-3}{6+3-{3}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}\\lim_{x\\to (3,3)}\\frac{\\sqrt{6+y}-x}{6+y-{x}^{2}} & =\\lim_{x\\to (3,3)}\\frac{(\\sqrt{6+y}-x)(\\sqrt{6+y}+x)}{(6+y-{x}^{2})(\\sqrt{6+y}+x)} \\\\  & =\\lim_{x\\to (3,3)}\\frac{(\\sqrt{6+y})^{2}-{x}^{2}}{(6+y-{x}^{2})(\\sqrt{6+y}+x)} \\\\  & =\\lim_{x\\to (3,3)}\\frac{6+y-{x}^{2}}{(6+y-{x}^{2})(\\sqrt{6+y}+x)} \\\\  & =\\lim_{x\\to (3,3)}\\frac{1}{\\sqrt{6+y}+x}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}\\lim_{x\\to (3,3)}\\frac{1}{\\sqrt{6+y}+x} & =\\frac{1}{\\sqrt{6+3}+3} \\\\  & =\\frac{1}{\\sqrt{9}+3} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{6}.$"}] [{:db/id #edb/ref 17592186475943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1771b53b-a9ea-5204-9e6c-c3664e7f4eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186475475} {:answer/id #uuid "52b82999-7d0c-5f60-b09d-5d9bfb9dabdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186475563} {:answer/id #uuid "644db317-5ce2-5b55-a3a9-b57771242cfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186475590} {:answer/id #uuid "9e112b0b-f642-5793-ba13-d921da5ca298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186475677} {:answer/id #uuid "d8d267a1-bd0b-57f4-92ed-545ceb83bbea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186475769}] :answer-field/correct {:answer/id #uuid "1771b53b-a9ea-5204-9e6c-c3664e7f4eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186475475} :answer-field/id #uuid "cbe5df83-a1f1-5212-94d6-8a03a2936996" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186475891}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83c8f2ad-db17-53f8-868d-e48deabc8feb" :question/math-academy-id "q-129409" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n\\lim_{x\\to (1,2)}\\,\\frac{(x-1)(y-2)}{(x-1)^{2}+(y-2)^{2}}\n$$\n\nI. The limit evaluates to $0$ along the path $y=2$\n\nII. The limit evaluates to $\\frac{1}{2}$ along the path $y=x+1$\n\nIII. The limit does not exist" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2)}\\,\\frac{(x-1)(y-2)}{(x-1)^{2}+(y-2)^{2}} & =\\frac{(1-1)(2-2)}{(1-1)^{2}+(2-2)^{2}} \\\\  & =\\frac{0(0)}{{0}^{2}+{0}^{2}} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(1,2)$ from different paths.\n\n- Statement I is true. Taking $x\\to (1,2)$ along the path $y=2,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2)\\,\\,\\,y=2}\\,\\frac{(x-1)(y-2)}{(x-1)^{2}+(y-2)^{2}} & =\\lim_{x\\to 1}\\,\\frac{(x-1)(2-2)}{(x-1)^{2}+(2-2)^{2}} \\\\  & =\\lim_{x\\to 1}\\,\\frac{(x-1)(0)}{(x-1)^{2}+{0}^{2}} \\\\  & =\\lim_{x\\to 1}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Taking $x\\to (1,2)$ along the path $y=x+1,$ we have\n\n$$\n\\begin{aligned}\\lim_{x\\to (1,2)\\,\\,\\,y=x+1}\\,\\frac{(x-1)(y-2)}{(x-1)^{2}+(y-2)^{2}} & =\\lim_{x\\to 1}\\frac{(x-1)(x+1-2)}{(x-1)^{2}+(x+1-2)^{2}} \\\\  & =\\lim_{x\\to 1}\\frac{(x-1)(x-1)}{(x-1)^{2}+(x-1)^{2}} \\\\  & =\\lim_{x\\to 1}\\frac{(x-1)^{2}}{2(x-1)^{2}} \\\\  & =\\lim_{x\\to 1}\\frac{\\cancel{(x-1)^{2}}}{2\\cancel{(x-1)^{2}}} \\\\  & =\\lim_{x\\to 1}\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- Statement III is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n\\lim_{x\\to (1,2)}\\,\\frac{(x-1)(y-2)}{(x-1)^{2}+(y-2)^{2}}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186478530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34d8d160-2451-562f-aefd-3db0e0ef0fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7sec⁡\\theta +C" :db/id #edb/ref 17592186478538} {:answer/id #uuid "40d72ac0-a3c5-5832-814d-2a54f2d35d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7sec⁡\\theta +C" :db/id #edb/ref 17592186478539} {:answer/id #uuid "61f86ef2-8183-5115-a218-8fe444974f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7csc⁡\\theta +C" :db/id #edb/ref 17592186478542} {:answer/id #uuid "fbe32cdb-ad3d-5087-9b08-760a8593842e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7csc⁡\\theta +C" :db/id #edb/ref 17592186478556} {:answer/id #uuid "fc53f318-8fe8-5f6b-9463-9bfceb2b64b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7csc⁡\\theta cot⁡\\theta +C" :db/id #edb/ref 17592186478557}] :answer-field/correct {:answer/id #uuid "34d8d160-2451-562f-aefd-3db0e0ef0fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7sec⁡\\theta +C" :db/id #edb/ref 17592186478538} :answer-field/id #uuid "8d93b18b-fb9d-5347-bbbb-727496189eb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478547}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "000c3cb5-99b8-5a63-a939-b4c9bbac2e4d" :question/problem "$$\n\\displaystyle \\int 7sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =\n$$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 7sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  & =7\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =7sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}]}
