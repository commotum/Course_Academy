#{[{:db/id #edb/ref 17592186059557 :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A),$ if <div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}3 & 2 \\\\ 5 & 6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix} = ad - bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3 & 2 \\\\ 5 & 6\\end{vmatrix} \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059558 :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A),$ if <div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix} = ad - bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{vmatrix} \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059559 :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n$$\n\\displaystyle {A} = \n    \\left\\lbrack\n    \\begin{matrix}\n        2 & -1  \\\\\n        -3 & k\n    \\end{matrix}\n    \\right\\rbrack\n$$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix} = ad - bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}2 & -1 \\\\ -3 & k\\end{vmatrix} \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bef9d71-e6eb-54e4-8e8e-a529aa8f1992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241284} {:answer/id #uuid "af58227c-7285-5719-b8ee-6e95dc121818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242708} {:answer/id #uuid "b33e532a-b90d-5de2-812f-858d1ea4ce57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186242741} {:answer/id #uuid "b7782812-7471-5927-8799-42fa4e8f2c90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186242786} {:answer/id #uuid "d690db23-f51d-5c54-a3fe-07d2f24b9b75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243082}] :answer-field/correct {:answer/id #uuid "0bef9d71-e6eb-54e4-8e8e-a529aa8f1992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241284} :answer-field/id #uuid "bbd1e424-be57-57db-8709-ae267fc7b54a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "67459f8a-4276-51e0-8ff0-10c56a6d248e" :question/math-academy-id "q-1079" :question/problem "Calculate $\\text{det}(A)$, if\n$$\n\\displaystyle A=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(A) & =\\begin{vmatrix}1 & 2 \\\\ 3 & 0\\end{vmatrix} \\\\  & =1\\cdot 0-2\\cdot 3 \\\\  & =0-6 \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b466bee3-4694-50ff-b4ff-be40469939a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056245} {:answer/id #uuid "14252abb-f88d-5c80-a1a7-50e1c5101e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6} + 5" :db/id #edb/ref 17592186056246} {:answer/id #uuid "422a8592-44c9-5cd7-a9f8-f218255dd350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2} - 5" :db/id #edb/ref 17592186056247} {:answer/id #uuid "5403717f-fd25-5fdf-9147-cb1006233b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186056248} {:answer/id #uuid "62819f9b-2032-516f-902f-f58dc1fc0aaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6} - 5" :db/id #edb/ref 17592186056249}] :answer-field/correct {:answer/id #uuid "422a8592-44c9-5cd7-a9f8-f218255dd350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2} - 5" :db/id #edb/ref 17592186056247} :answer-field/id #uuid "49e48a24-3b9b-576a-ba9c-ed6114af8aa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056244}] :question/id #uuid "50adc5c7-3aa8-5ed8-9f4a-a8650f063784" :question/math-academy-id "q-1088" :question/problem "What is $\\begin{vmatrix}\\sqrt{2} & 5 \\\\ 1 & 3\\end{vmatrix}$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}\\sqrt{2} & 5 \\\\ 1 & 3\\end{vmatrix}\n&=\\sqrt{2}\\cdot3-5\\cdot1 \\\\\n&=3\\sqrt{2}-5.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c21266-f6c2-5bea-9e7b-5c12a6cd64b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2{y}^{2}" :db/id #edb/ref 17592186241696} {:answer/id #uuid "3e6a2a2e-5861-5f92-b070-b29670058f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{x}-{y}^{3}" :db/id #edb/ref 17592186241737} {:answer/id #uuid "404488cf-c12a-5d3e-8f12-bae9be5d6d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-{y}^{3}" :db/id #edb/ref 17592186241756} {:answer/id #uuid "95789385-1849-5307-a089-1a094f6dcc15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{x}-2{y}^{3}" :db/id #edb/ref 17592186242493} {:answer/id #uuid "d8e15fa7-75e2-5444-be13-0b59e1863f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-{y}^{2}" :db/id #edb/ref 17592186243110}] :answer-field/correct {:answer/id #uuid "404488cf-c12a-5d3e-8f12-bae9be5d6d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-{y}^{3}" :db/id #edb/ref 17592186241756} :answer-field/id #uuid "2b79083a-ceaf-5ef9-8a92-8b480f0daf73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243517}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "31d5493d-598a-5cd3-9717-dec41584eaba" :question/math-academy-id "q-1089" :question/problem "Calculate $det(Z)$, if\n $$\n\\displaystyle Z=\\begin{bmatrix}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(Z) & =\\begin{vmatrix}\\sqrt{x} & y \\\\ {y}^{2} & \\sqrt{x}\\end{vmatrix} \\\\  & =\\sqrt{x}\\cdot \\sqrt{x}-y\\cdot {y}^{2} \\\\  & =x-{y}^{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adeef685-13ff-59be-8555-fa285a4b673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186056359} {:answer/id #uuid "e93e332c-0067-5a8e-978e-451498a19a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056360} {:answer/id #uuid "09a86a42-c0b8-57e0-a93a-e191a7d6b5f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186056361} {:answer/id #uuid "0a801cc5-5312-593f-9422-e650a8b22f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056362} {:answer/id #uuid "3f33f5eb-9069-5dcd-955b-ccc0b698801b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186056363}] :answer-field/correct {:answer/id #uuid "adeef685-13ff-59be-8555-fa285a4b673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186056359} :answer-field/id #uuid "809ecc7b-96f9-5877-beda-07f945eee167" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056358}] :question/id #uuid "ea87b1ac-4625-5a01-8d70-68a1975a00a3" :question/math-academy-id "q-11648" :question/problem "What is $\\begin{vmatrix}2 & -4 \\\\ -2 & 7\\end{vmatrix}$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\n\\begin{vmatrix}2 & -4 \\\\ -2 & 7\\end{vmatrix}\n&=2\\cdot7-(-4)\\cdot(-2) \\\\\n&=14-8 \\\\\n&=6.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ff914a-1317-5490-ba59-b2437dd6665a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k = 9" :db/id #edb/ref 17592186056365} {:answer/id #uuid "be028415-acff-5d6d-8080-1a4b0687fc37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k =-4" :db/id #edb/ref 17592186056366} {:answer/id #uuid "28d6cf2e-8b16-58ce-af42-d46cb399a7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k =-9" :db/id #edb/ref 17592186056367} {:answer/id #uuid "3882486c-1efa-5685-9f10-e83963bf1488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k = 4" :db/id #edb/ref 17592186056368} {:answer/id #uuid "585ec4a5-edb5-5cf4-907c-653192911ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k = 0" :db/id #edb/ref 17592186056369}] :answer-field/correct {:answer/id #uuid "a0ff914a-1317-5490-ba59-b2437dd6665a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k = 9" :db/id #edb/ref 17592186056365} :answer-field/id #uuid "463bd4e4-2bee-5ee4-b6dd-f8a4f765f86b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056364}] :question/id #uuid "cda11aab-d0f1-5aed-9faf-9b4214024dc7" :question/math-academy-id "q-11651" :question/problem "If\n$$\n\\displaystyle C = \\begin{bmatrix}2 & 3 \\\\ 5 & k\\end{bmatrix}\n$$\nand\n$det(C) = 3$, what is the value of $k$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\n\\det(C)&=\\begin{vmatrix}2 & 3 \\\\ 5 & k\\end{vmatrix} \\\\\n&=2\\cdot k-3\\cdot5 \\\\\n&=2k-15.\n\\end{aligned}\n$$\n\nSince $\\det(C)=3$, we obtain:\n\n$$\n\\begin{aligned}\n2k-15&=3 \\\\\n2k&=18 \\\\\nk&=9.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8f75c6a-39ca-54ce-90b2-d2fed57bce1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186057631} {:answer/id #uuid "f1cc6fa4-5d2d-5ef7-8b9e-ca6b2a04a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186057632} {:answer/id #uuid "34efec5a-0267-59a9-a0e8-a8bbc8e3bbc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057633} {:answer/id #uuid "626288b8-1266-5c66-8802-e4279b82a65f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186057634} {:answer/id #uuid "65626e08-ea8e-5f2e-a56f-1de07c241265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186057635}] :answer-field/correct {:answer/id #uuid "34efec5a-0267-59a9-a0e8-a8bbc8e3bbc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057633} :answer-field/id #uuid "1cb55465-244d-5741-a788-539ef4e5adf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057630}] :question/id #uuid "e1d88843-5476-50c9-8034-3251a4933b8a" :question/math-academy-id "q-19801" :question/problem "If\n$$\n\\displaystyle A = \\begin{bmatrix}1 + t & 2t \\\\ -3 & 1 - t\\end{bmatrix}\n$$\nand $det(A) = 10$, what is the value of $t$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\n\\det(A)&=\\begin{vmatrix}1+t & 2t \\\\ -3 & 1-t\\end{vmatrix} \\\\\n&=(1+t)(1-t)-(2t)(-3) \\\\\n&=1-t^2+6t.\n\\end{aligned}\n$$\n\nSince $\\det(A)=10$, we obtain:\n\n$$\n\\begin{aligned}\n1-t^2+6t&=10 \\\\\nt^2-6t+9&=0 \\\\\n(t-3)^2&=0 \\\\\nt&=3.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063981 :question/id #uuid "1d7623f9-6377-53a9-8178-5819263d5508" :question/math-academy-id "e-1421" :question/problem "Solve the equation $x^2-5x +6=0$." :question/worked-solution "We will factor the left-hand side and then apply the zero product rule.\n\nTo factor the left-hand side, we need to find two numbers that multiply to $6$ and add to $-5$. These two numbers are $-2$ and $-3$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned} x^2 - 5x + 6 &= 0 \\\\[5pt] x^2 \\underbrace{-3x -2x}_{\\large -5x} + 6 &= 0 \\\\[5pt] x(x-3) - 2(x-3) &= 0 \\\\[5pt] (x - 2)(x -3) &= 0 \\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nx-2=0 \\qquad\\text{or}\\qquad x-3=0\n$$\n\nwhich in turn gives\n\n$$\nx=2 \\qquad\\text{or}\\qquad x=3\n$$\n\nTherefore, the solutions are $x=2,3$."}] [{:db/id #edb/ref 17592186063982 :question/id #uuid "4114003d-b086-5d60-b5b2-fec73cf38596" :question/math-academy-id "e-1423" :question/problem "Solve $-x^2-5x-14=5x-5$." :question/worked-solution "First, we bring all terms to the left side:\n\n$$\n\\begin{aligned}\n-x^{2} - 5x - 14 &= 5x - 5 \\\\\n- x^{2} - 5x - 14 - 5x + 5 &= 0 \\\\\n- x^{2} + (-5x - 5x) + (-14 + 5) &= 0 \\\\\n- x^{2} - 10x - 9 &= 0\n\\end{aligned}\n$$\n\nNow, we multiply by $-1$ so that the leading coefficient becomes positive.\n\n$$\n\\begin{aligned}\n-x^{2} - 10x - 9 &= 0 \\\\\n(-1)(-x^{2} - 10x - 9) &= (-1) \\cdot (0) \\\\\nx^{2} + 10x + 9 &= 0\n\\end{aligned}\n$$\n\nTo factor the equation, we need two numbers that multiply to $9$ and add to $10$. These two numbers are $1$ and $9$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned}\nx^{2} + 10x + 9 &= 0 \\\\\nx^{2} + (1x + 9x) + 9 &= 0 \\\\\n(x^{2} + x) + (9x + 9) &= 0 \\\\\nx(x + 1) + 9(x + 1) &= 0 \\\\\n(x + 9)(x + 1) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nx+9=0 \\qquad\\text{or}\\qquad x+1=0\n$$\n\nwhich in turn gives\n\n$$\nx=-9 \\qquad\\text{or}\\qquad x=-1\n$$\n\nTherefore, the solutions are $x=-9,-1$."}] [{:db/id #edb/ref 17592186064007 :question/id #uuid "f022898b-d24c-5c84-8388-1edfa84b9874" :question/math-academy-id "e-1792" :question/problem "Solve the equation $-x^2+7x+18=0$." :question/worked-solution "First, we multiply by $-1$ so that the leading coefficient becomes positive.\n\n$$\n\\begin{aligned}\n-x^{2} + 7x + 18 &= 0 \\\\\n(-1)(-x^{2} + 7x + 18) &= (-1) \\cdot (0) \\\\\nx^{2} - 7x - 18 &= 0\n\\end{aligned}\n$$\n\nTo factor the equation, we need two numbers that multiply to $-18$ and add to $-7$. These two numbers are $2$ and $-9$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 7x - 18 &= 0 \\\\\nx^{2} + (2x - 9x) - 18 &= 0 \\\\\n(x^{2} + 2x) + (-9x - 18) &= 0 \\\\\nx(x + 2) - 9(x + 2) &= 0 \\\\\n(x - 9)(x + 2) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nx-9=0 \\qquad\\text{or}\\qquad x+2=0\n$$\n\nwhich in turn gives\n\n$$\nx=9 \\qquad\\text{or}\\qquad x=-2\n$$\n\nTherefore, the solutions are $x=-2,9$."}] [{:db/id #edb/ref 17592186064038 :question/id #uuid "368cbbae-4eff-5eff-a8f3-d3e8359447a9" :question/math-academy-id "e-364" :question/problem "Calculate $$\n\\displaystyle \\int x^2 \\,\\textrm d x.\n$$" :question/worked-solution "We apply the power rule with $n=2$, and we get\n\n$$\n\\int x^2 \\,\\textrm d x = \\dfrac{x^{2+1}}{2+1} + C = \\dfrac{x^3}{3}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{{x}^{3}}{3}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{1}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 \\\\ &= \\frac{1}{3}\\cdot 3{x}^{2} \\\\ &= {x}^{2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064039 :question/id #uuid "818f4fbe-e251-57bd-90ae-b6517c6f2f89" :question/math-academy-id "e-367" :question/problem "Find the antiderivative of  $\\sqrt x.$" :question/worked-solution "We start by writing the square root as a rational power, $\\sqrt x= x^{1/2}.$ So, we can apply the power rule with $n=\\dfrac{1}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}\\,\\text{d}x & =\\int {x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{1/2+1}}{(\\frac{1}{2}+1)}+C \\\\  & =\\frac{{x}^{3/2}}{\\left(\\frac{3}{2}\\right)}+C \\\\  & =\\frac{2{x}^{3/2}}{3}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{3/2}}{3}+C) &= \\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2{x}^{3/2}}{3}\\right)+\\frac{\\text{d}}{\\text{d}x}(C) \\\\ &= \\frac{2}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3/2})+0 \\\\ &= \\frac{2}{3}\\cdot \\frac{3}{2}{x}^{3/2-1} \\\\ &= {x}^{1/2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064040 :question/id #uuid "c25e6037-3900-5314-b9a9-262fef07061c" :question/math-academy-id "e-368" :question/problem "Given that $f(x) = \\dfrac 1 {x^3}$ and that $F'(x) = f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if $F'(x) = f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\dfrac 1 {x^3}= x^{-3}.$ So, we can use the power rule with $n=-3$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =\\int {x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}+C \\\\  & =-\\frac{{x}^{-2}}{2}+C \\\\  & =-\\frac{1}{2{x}^{2}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064052 :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/math-academy-id "e-382" :question/problem "Calculate $$\n\\displaystyle \\int 3\\sin{x}\\,\\textrm d x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 3sin⁡x\\,\\text{d}x & =3\\int sin⁡x\\,\\text{d}x \\\\  & =3(-cos⁡x)+C \\\\  & =-3cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064053 :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/math-academy-id "e-383" :question/problem "Calculate $$\n\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-csc⁡xcot⁡x)\\,\\text{d}x & =-\\int (csc⁡xcot⁡x)\\,\\text{d}x \\\\  & =-(-csc⁡x)+C \\\\  & =csc⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064054 :question/id #uuid "3d2bde25-f8dc-5e62-9999-6593424f0ae2" :question/math-academy-id "e-384" :question/problem "Calculate the integral $$\n\\displaystyle{\\int} (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x.\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\sec^2 x \\, \\textrm dx = \\tan x + C\n$$\n\nand\n\n$$\n\\int \\sec x \\tan x \\, \\textrm dx = \\sec x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n\t\t\\int (2\\sec^2 x + \\sec x \\tan x )\\, \\textrm{d}x& = 2 \\int \\sec^2 x \\, \\textrm{d}x+ \\int \\sec x \\tan x \\, \\textrm{d}x \\\\\n\t\t\t\t\t\t\t\t\t\t&=2\\tan x + \\sec x + C.\n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064055 :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/math-academy-id "e-385" :question/problem "Calculate the integral $$\n\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int csc⁡x(csc⁡x+3cot⁡x)\\,\\text{d}x & =\\int {csc}^{2}⁡x+3csc⁡xcot⁡x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡x\\,\\text{d}x+3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-cot⁡x-3csc⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd9ded59-ba65-5176-b8f9-b0abbcde8e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}" :db/id #edb/ref 17592186061520} {:answer/id #uuid "06876c28-ebd0-5db2-80b3-e9af69ed8c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186061521} {:answer/id #uuid "1e1c848c-bcad-5a85-903a-9791288e9010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 + C" :db/id #edb/ref 17592186061522} {:answer/id #uuid "53a354ab-679e-5199-ac84-f449177db3d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2}" :db/id #edb/ref 17592186061523} {:answer/id #uuid "759d2e84-4518-561f-8c74-506babc880c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2} + C" :db/id #edb/ref 17592186061524}] :answer-field/id #uuid "d83860ac-499e-5a75-812f-1da4dee6be22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061519}] :question/id #uuid "9681ab06-ae34-5546-895c-3849a33f13b3" :question/math-academy-id "q-2005" :question/problem "Calculate $\\intxdx$."}] [{:db/id #edb/ref 17592186064556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a441ddd8-cdfd-510b-9645-167a452b9e7c" :answer/type {:db/id #edb/ref 1759218604