#{[{:db/id #edb/ref 17592186253532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171dcc35-2e96-5d00-9b3e-92b88f1e973d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=3\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186250755} {:answer/id #uuid "2b19b8bd-9546-5cc0-9ed1-4c2a8ecedd85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-\\frac{3}{(x-1)^{2}}+C" :db/id #edb/ref 17592186250923} {:answer/id #uuid "437d8ac4-b175-5851-bcbe-f20b4b028b84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{1}{3}\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186251118} {:answer/id #uuid "64d8f14f-2e7e-56a6-a247-99126b763397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-\\frac{1}{(3x-1)^{2}}+C" :db/id #edb/ref 17592186251380} {:answer/id #uuid "e882ef4b-8f4d-553d-bbb5-65eff9191ac7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\operatorname{ln}⁡|3x-1|+C" :db/id #edb/ref 17592186252586}] :answer-field/correct {:db/id #edb/ref 17592186250755} :answer-field/id #uuid "e1a55590-7e4d-59c4-88a9-f483aed246b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253190}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e46bf143-4783-5ce4-a8e4-31db596b41d7" :question/math-academy-id "q-119034" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{3}{x-1}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{3}{x-1}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{x-1}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{x-1}\\,\\text{d}x \\\\  & =3\\operatorname{ln}⁡|x-1|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245c51d3-f742-5f41-b1dd-3551a892b046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}(1-x)+C" :db/id #edb/ref 17592186250868} {:answer/id #uuid "688f1217-b625-5da8-a08e-dadadf44274e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}({x}^{2}-1)+C" :db/id #edb/ref 17592186251410} {:answer/id #uuid "705ba4e9-a328-506c-95e2-3f7a3275a47d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)={x}^{2}(2x-1)+C" :db/id #edb/ref 17592186251470} {:answer/id #uuid "9b76e6cf-b140-5d7b-bf6a-f55d3ab8cc9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)={x}^{2}(2-x)+C" :db/id #edb/ref 17592186251893} {:answer/id #uuid "cd912817-d2f0-5ce1-a2a2-c2744159033c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}(3-x)+C" :db/id #edb/ref 17592186252367}] :answer-field/correct {:db/id #edb/ref 17592186250868} :answer-field/id #uuid "dbaa4233-2442-5788-bdba-a93b2096247b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253180}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fb6cc49c-88f2-58a8-a4b7-b8174a349cdf" :question/math-academy-id "q-119035" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)+6{x}^{2}=4x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =4x-6{x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x-6{x}^{2})\\text{d}x \\\\  & =4\\int x\\,\\text{d}x-6\\int {x}^{2}\\,\\text{d}x \\\\  & =4\\cdot \\frac{1}{2}{x}^{2}-6\\cdot \\frac{1}{3}{x}^{3} \\\\  & =2{x}^{2}-2{x}^{3}+C \\\\  & =2{x}^{2}(1-x)+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222d3811-c9d6-5e7d-b85c-95aa3edf1f5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-{e}^{-2x}+C{e}^{-x}+Dx" :db/id #edb/ref 17592186250846} {:answer/id #uuid "2aeffcd6-4797-59ec-860f-11aa268d3482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186250918} {:answer/id #uuid "65573541-1d72-5f2c-8753-db5f49766c66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-2x}+C{x}^{2}+Dx" :db/id #edb/ref 17592186251383} {:answer/id #uuid "849fa2e5-06fb-57df-930c-0b02e73c0378" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{e}^{-2x}+C{e}^{-x}+D" :db/id #edb/ref 17592186251665} {:answer/id #uuid "dd1f009d-922c-586a-8478-6e8b8c14b8c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-4{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186252500}] :answer-field/correct {:db/id #edb/ref 17592186250918} :answer-field/id #uuid "cdcccacb-a603-583d-bd6c-044e60d286f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253159}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "31249dfd-dd0f-51ef-9508-c411dcb82eb2" :question/math-academy-id "q-119038" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a7a8ec6-3a7f-59a8-a36a-57b3c0e72d61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2\\operatorname{sin}⁡2x+Cx+D" :db/id #edb/ref 17592186251298} {:answer/id #uuid "7c79b537-ac7c-5f96-ac1d-d1860fe46a0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{cos}⁡2x+C{x}^{2}+D" :db/id #edb/ref 17592186251588} {:answer/id #uuid "bf97146c-f829-59ef-a419-71c2a32c9365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{sin}⁡2x+Cx+D" :db/id #edb/ref 17592186252244} {:answer/id #uuid "caaff75b-db1f-5d6d-9954-596535269be7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2\\operatorname{cos}⁡2x+Cx+D" :db/id #edb/ref 17592186252349} {:answer/id #uuid "f7a50774-5155-52c7-ab4f-ad427a04fce8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2\\operatorname{sin}⁡2x+C{x}^{2}+D" :db/id #edb/ref 17592186252719}] :answer-field/correct {:db/id #edb/ref 17592186251298} :answer-field/id #uuid "4dba1b47-1418-53b5-8e0b-75806451ee28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252943}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "39f64cb7-5a70-5fc4-8565-289e61a98a66" :question/math-academy-id "q-119041" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=-8\\operatorname{sin}⁡2x.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =-8\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-8(-\\frac{1}{2}\\operatorname{cos}⁡2x) \\\\  & =4\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (4\\operatorname{cos}⁡2x+C)\\text{d}x \\\\ y & =4\\int \\operatorname{cos}⁡2x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =4(\\frac{1}{2}\\operatorname{sin}⁡2x)+Cx+D \\\\  & =2\\operatorname{sin}⁡2x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52771b76-d1b4-51e6-ab25-23d4a36b8b91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=16{e}^{x/2}+{x}^{3}+Cx+D" :db/id #edb/ref 17592186251227} {:answer/id #uuid "b4ba7691-e0f5-58b0-8306-ebfe9995ce2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=16{e}^{x/2}-3{x}^{3}+Cx+D" :db/id #edb/ref 17592186252144} {:answer/id #uuid "d52fa157-a79b-5633-8056-0ad742ff72b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8{e}^{x/2}-{x}^{3}+Cx+D" :db/id #edb/ref 17592186252440} {:answer/id #uuid "dad3e85e-1ff8-5404-b11a-42ecf755a4c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=32{e}^{x/2}-{x}^{3}+Cx+D" :db/id #edb/ref 17592186252477} {:answer/id #uuid "e75f3c4e-0901-518a-8832-fdbd533170dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=32{e}^{x/2}-\\frac{1}{2}{x}^{3}+Cx+D" :db/id #edb/ref 17592186252575}] :answer-field/correct {:db/id #edb/ref 17592186252477} :answer-field/id #uuid "8bc11b9f-979a-5428-873c-d6f95fed2f3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253046}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f306795-58e9-56b9-bfb8-50791b341767" :question/math-academy-id "q-119042" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6x=8{e}^{x/2}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{x/2}-6x.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (8{e}^{x/2}-6x)\\text{d}x \\\\  & =8\\int {e}^{x/2}\\,\\text{d}x-6\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(2{e}^{x/2})-6(\\frac{1}{2}{x}^{2})+C \\\\  & =16{e}^{x/2}-3{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (16{e}^{x/2}-3{x}^{2}+C)\\text{d}x \\\\ y & =16\\int {e}^{x/2}\\,\\text{d}x-3\\int {x}^{2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =16(2{e}^{x/2})-3(\\frac{1}{3}{x}^{3})+Cx+D \\\\  & =32{e}^{x/2}-{x}^{3}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cc8ac7-5e09-54ce-b6d3-e159d67ab8ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3{x}^{4}+4{x}^{2}+Cx+D" :db/id #edb/ref 17592186250861} {:answer/id #uuid "5901205a-e2f9-52f3-b94e-a09bbbbe0521" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{x}^{4}}{4}+\\frac{5{x}^{2}}{4}+Cx+D" :db/id #edb/ref 17592186251285} {:answer/id #uuid "60767b47-bf28-5927-9170-56b9e257c34c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3{x}^{4}-5{x}^{2}+Cx+D" :db/id #edb/ref 17592186251342} {:answer/id #uuid "cc4e1b67-45cb-51ac-a61f-ee18bbb149b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D" :db/id #edb/ref 17592186252358} {:answer/id #uuid "f4155827-e220-55c0-a8b5-d48c90df5a62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{x}^{4}}{2}-4{x}^{2}+Cx+D" :db/id #edb/ref 17592186252693}] :answer-field/correct {:db/id #edb/ref 17592186252358} :answer-field/id #uuid "aeb1d879-87da-5436-bd2a-6290c0abb0e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253110}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5323a95-ccb4-5698-8e94-ec2b6a694be3" :question/math-academy-id "q-119043" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+5=6{x}^{2}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6{x}^{2}-5.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (6{x}^{2}-5)\\text{d}x \\\\  & =6\\int {x}^{2}\\,\\text{d}x-5\\int \\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6\\left(\\frac{{x}^{3}}{3}\\right)-5x+C \\\\  & =2{x}^{3}-5x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2{x}^{3}-5x+C)\\text{d}x \\\\ y & =2\\int {x}^{3}\\,\\text{d}x-5\\int x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =2\\left(\\frac{{x}^{4}}{4}\\right)-5\\left(\\frac{{x}^{2}}{2}\\right)+Cx+D \\\\  & =\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061e9049-685a-5e57-b12d-6b56030be323" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186250602} {:answer/id #uuid "42b59196-b9a8-573b-be83-9fd902357365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={2}^{x}{ln}^{2}⁡2-\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186251109} {:answer/id #uuid "b5960315-6cae-5802-922d-5b341c99ee9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186252150} {:answer/id #uuid "c18c981b-dd26-58f1-bd40-912972cd4a5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={2}^{x}\\operatorname{ln}⁡2-\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186252261} {:answer/id #uuid "e6e95291-17f3-571b-b000-bb1e43ebce08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}+\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186252574}] :answer-field/correct {:db/id #edb/ref 17592186250602} :answer-field/id #uuid "e27e7bd7-eaed-55b0-916c-a3dd3a5a5d99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f9dee74-c92e-5523-b157-7ba038c745c8" :question/math-academy-id "q-119044" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-{2}^{x}=\\operatorname{cos}⁡x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\operatorname{cos}⁡x+{2}^{x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x+{2}^{x})\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C)\\text{d}x \\\\ y & =\\int \\operatorname{sin}⁡x\\,\\text{d}x+\\frac{1}{\\operatorname{ln}⁡2}\\int {2}^{x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =-\\operatorname{cos}⁡x+\\frac{1}{\\operatorname{ln}⁡2}\\left(\\frac{{2}^{x}}{\\operatorname{ln}⁡2}\\right)+Cx+D \\\\  & =\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186253539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ecc69b-755b-5462-8126-6d18390bc9cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-2\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186251113} {:answer/id #uuid "51d0ffb6-6f64-5896-abdf-17cb6f16197d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2\\operatorname{cos}⁡x-3" :db/id #edb/ref 17592186251222} {:answer/id #uuid "b403e123-9b40-51a1-b551-d4ee97aeac63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{1}{2}\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186252131} {:answer/id #uuid "bcae2f92-0655-5e91-b689-f83acfb52de0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2\\operatorname{sin}⁡x-3" :db/id #edb/ref 17592186252218} {:answer/id #uuid "ec6281fe-2594-5ca0-8ac1-0635fb6762ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-2\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186252623}] :answer-field/correct {:db/id #edb/ref 17592186251113} :answer-field/id #uuid "5e18fea8-a6e5-5302-8876-2d446746feb0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8dd37419-0acf-5e07-951f-998d06a1d1c6" :question/math-academy-id "q-119045" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)+2\\operatorname{cos}⁡x=0$ that satisfies the condition $f(0)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=-2\\operatorname{cos}⁡x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-2\\operatorname{cos}⁡x)\\,\\text{d}x \\\\ f(x) & =-2\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-2\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-2\\operatorname{sin}⁡x+C.$ To find a particular solution, we substitute the condition $f(0)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =-2\\operatorname{sin}⁡0+C \\\\ -1 & =-2(0)+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=-2\\operatorname{sin}⁡x-1.\n$$"}] [{:db/id #edb/ref 17592186253540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0877a493-110b-5bc5-b8f0-b95a212d57cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}+x-4" :db/id #edb/ref 17592186250624} {:answer/id #uuid "404b89d5-fb90-54b3-9fd1-b0ed48ad3aca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)={x}^{2}-2x" :db/id #edb/ref 17592186251087} {:answer/id #uuid "7d24a901-b539-53de-9ab1-410020de269d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)={x}^{2}+2x-4" :db/id #edb/ref 17592186251597} {:answer/id #uuid "b2cb0cc0-4925-5d83-a3b2-07b01eb84c1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}+3x-6" :db/id #edb/ref 17592186252117} {:answer/id #uuid "c233f23d-d374-5888-ae7d-c2e80f985c8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2{x}^{2}+x-1" :db/id #edb/ref 17592186252267}] :answer-field/correct {:db/id #edb/ref 17592186250624} :answer-field/id #uuid "cb5f0d15-ef01-5c2b-8b45-e12411c1710b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70e058ec-5742-5754-884d-951409c47fdc" :question/math-academy-id "q-119046" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)-4x=1$ that satisfies the condition $f(1)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=4x+1.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x+1)\\,\\text{d}x \\\\ f(x) & =4\\int x\\,\\text{d}x+\\int \\text{d}x \\\\  & =4(\\frac{1}{2}{x}^{2})+x+C \\\\  & =2{x}^{2}+x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=2{x}^{2}+x+C.$ To find a particular solution, we substitute the condition $f(1)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =2(1)^{2}+1+C \\\\ -1 & =2+1+C \\\\ C & =-4.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=2{x}^{2}+x-4.\n$$"}] [{:db/id #edb/ref 17592186253544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063d885c-e465-53c3-8fc9-1185c7d2a24c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{x}^{2}-2{e}^{-2x}+3" :db/id #edb/ref 17592186250604} {:answer/id #uuid "2352b722-ccc2-5fb7-b992-99d02c98a38b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8{x}^{2}+2{e}^{-2x}-1" :db/id #edb/ref 17592186250855} {:answer/id #uuid "4927258a-3e5d-57d8-ad17-4093de1cc583" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186251163} {:answer/id #uuid "7cf4bda2-85a0-506d-86cb-55bb6ebcdb9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{x}^{2}+\\frac{{e}^{-2x}}{2}-\\frac{3}{2}" :db/id #edb/ref 17592186251595} {:answer/id #uuid "febdfee4-02c6-55f5-970a-792e4ad18364" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186252790}] :answer-field/correct {:db/id #edb/ref 17592186252790} :answer-field/id #uuid "4a412b91-1bde-571f-aacb-eb83ca3e461a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252937}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea7f0932-1ce6-52df-a5dc-f1855b5f815e" :question/math-academy-id "q-119075" :question/problem "Find the particular solution to the differential equation ${y}^{′}+{e}^{-2x}=8x$ that satisfies the condition $y(0)=1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=8x-{e}^{-2x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (8x-{e}^{-2x})\\,\\text{d}x \\\\ y & =8\\int x\\,\\text{d}x-\\int {e}^{-2x}\\,\\text{d}x \\\\  & =8\\left(\\frac{{x}^{2}}{2}\\right)-\\left(-\\frac{{e}^{-2x}}{2}\\right)+C \\\\  & =4{x}^{2}+\\frac{{e}^{-2x}}{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=4{x}^{2}+\\frac{{e}^{-2x}}{2}+C.$ To find a particular solution, we substitute the condition $y(0)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}1 & =4(0)^{2}+\\frac{{e}^{-2(0)}}{2}+C \\\\ 1 & =0+\\frac{1}{2}+C \\\\ C & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=4{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186253545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4861751d-591d-55c3-986e-ef2a5b44047f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x-\\frac{{e}^{x/2}}{2}+\\frac{5}{2}" :db/id #edb/ref 17592186251157} {:answer/id #uuid "66412d8c-05ca-5d19-b457-71e9ce3cbc83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}+2{e}^{x/2}+2" :db/id #edb/ref 17592186251394} {:answer/id #uuid "73dd9002-7420-57dd-aa1f-4e2c936b2b76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x+{e}^{x/2}+1" :db/id #edb/ref 17592186251508} {:answer/id #uuid "906cd958-b4d4-5e47-8a8a-6773bb3989db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}+2{e}^{x/2}" :db/id #edb/ref 17592186251780} {:answer/id #uuid "f2723fb9-3ffe-529a-aa32-10cf5b96b2dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}+\\frac{{e}^{x/2}}{2}+\\frac{3}{2}" :db/id #edb/ref 17592186252675}] :answer-field/correct {:db/id #edb/ref 17592186251780} :answer-field/id #uuid "b2e489f5-5c3c-511b-8803-0c93ae9edf09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253116}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5aa7094-d36f-5005-a0c6-3e11c04ef4b9" :question/math-academy-id "q-119083" :question/problem "Find the particular solution to the differential equation ${y}^{′}-2x={e}^{x/2}$ that satisfies the condition $y(0)=2.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=2x+{e}^{x/2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (2x+{e}^{x/2})\\text{d}x \\\\ y & =2\\int x\\,\\text{d}x+\\int {e}^{x/2}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+2{e}^{x/2}+C \\\\  & ={x}^{2}+2{e}^{x/2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y={x}^{2}+2{e}^{x/2}+C.$ To find a particular solution, we substitute the condition $y(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & ={0}^{2}+2{e}^{0}+C \\\\ 2 & =0+2(1)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny={x}^{2}+2{e}^{x/2}.\n$$"}] [{:db/id #edb/ref 17592186253548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad94dc2-96d1-5f82-a763-87dd2729f0de" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/78/7832a2110292cb364cf06c24eb51e9bb1ee42fe430ac8fcc381af047a09125e4.png" :db/id #edb/ref 17592186250651} {:answer/id #uuid "104071b2-3939-5957-8b0b-115c9954484c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ce/cece096a5b267821994e9b6d8142f0d7ea684bbe8e28da7cdb01b87a73f1db4c.png" :db/id #edb/ref 17592186250695} {:answer/id #uuid "37599f90-3244-5785-b02a-3b8c6636ce9b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/96/96359fe35288b866cbf9fd929e2515af04a4ec0dc565a4cd4af9d3a8fcd20f94.png" :db/id #edb/ref 17592186251006} {:answer/id #uuid "56cfa623-a5a2-5b84-a1b7-c443f45bdc6e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186251263} {:answer/id #uuid "a29f2347-9127-52fe-8d0d-29d70ef13664" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8e/8ede6d26a62570f4037ecc58c377e95389ab00dbee36b60c46e6fb2021e01cea.png" :db/id #edb/ref 17592186251955}] :answer-field/correct {:db/id #edb/ref 17592186251263} :answer-field/id #uuid "56370ecd-d3f8-58ef-b871-fb4e753f3b83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252955}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b17887e-edc7-5942-b62d-5bad58805bd8" :question/math-academy-id "q-119132" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{-x/4}}{2}?\n$$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](images/a4/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)"}] [{:db/id #edb/ref 17592186253555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a5ceeaf-77ab-505d-bb07-50c54445462f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,564" :db/id #edb/ref 17592186251297} {:answer/id #uuid "7b78439c-ca20-5818-a970-64171dd3bcbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,231" :db/id #edb/ref 17592186251581} {:answer/id #uuid "ac59003d-1e2c-5c46-b660-07f04e886860" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,052" :db/id #edb/ref 17592186252051} {:answer/id #uuid "b4105a55-70f2-56f5-b963-f527dc14d121" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,981" :db/id #edb/ref 17592186252133} {:answer/id #uuid "cfddca51-e5f9-5449-af23-505e7218836b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13\\,002" :db/id #edb/ref 17592186252388}] :answer-field/correct {:db/id #edb/ref 17592186252051} :answer-field/id #uuid "a8ba59c8-c696-513f-83b9-12f2d0cd5509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253100}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7681f328-523f-50bf-b697-22aa240e7260" :question/math-academy-id "q-119231" :question/problem "The number of subscribers $S(t)$ to a certain site's e-mail news service after $t$ weeks can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=0.01S.\n$$\n\nIf the site's e-mail news service currently has $10\\,000$ subscribers, calculate the number of subscribers after $10$ weeks. Round your answer to the nearest integer." :question/worked-solution "We model the number of subscribers using the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=0.01S.\n$$\n\nThe solution to this equation is\n\n$$\nS(t)={S}_{0}\\,{e}^{0.01t},\n$$\n\nwhere ${S}_{0}$ is the initial value.\n\nWe're told that the service currently has $10\\,000$ subscribers, so we have ${S}_{0}=10\\,000.$\n\nTherefore, the number of subscribers $S$ at time $t$ is\n\n$$\nS(t)=10\\,000\\,{e}^{0.01t}.\n$$\n\nFinally, to find the number of subscribers when $t=10,$ we substitute $t=10$ into the above, as follows:\n\n$$\n\\begin{aligned}S(10) & =10\\,000\\,{e}^{0.01\\cdot 10} \\\\  & =10\\,000\\,{e}^{0.1} \\\\  & ≈11\\,051.71\\end{aligned}\n$$\n\nRounding our answer to the nearest integer, we conclude that the number of subscribers is $11\\,052$ after $10$ weeks."}] [{:db/id #edb/ref 17592186253569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01dd95bb-746a-5b4f-89b5-559e2c6e635c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36\\,788" :db/id #edb/ref 17592186250570} {:answer/id #uuid "0963ac3d-cfd1-51b5-b3c9-deaa5f439a5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "73\\,558" :db/id #edb/ref 17592186250638} {:answer/id #uuid "0b8d03f3-44f5-5dee-937b-31c0b4d1a15b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42\\,125" :db/id #edb/ref 17592186250654} {:answer/id #uuid "23ddc8b2-b9af-55e0-92bd-2e6ddf4e0fd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "67\\,124" :db/id #edb/ref 17592186250863} {:answer/id #uuid "8c0173f2-9ccd-5ff7-9e59-7166170e8f81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52\\,009" :db/id #edb/ref 17592186251734}] :answer-field/correct {:db/id #edb/ref 17592186250570} :answer-field/id #uuid "1e31b0c6-2bb3-58b2-b32a-79bcc2cafe14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252860}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45aa4aa2-7cf9-5de2-abd9-971473e01594" :question/math-academy-id "q-119341" :question/problem "The number of sales $S(t)$ of a new tech device $t$ weeks after the start of sales can be modeled by the differential equation \n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=-0.1S.\n$$\n\nIf there were $100\\,000$ sales initially, calculate the number of sales after $10$ weeks. Round your answer to the nearest integer." :question/worked-solution "We model the number of sales using the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=-0.1S.\n$$\n\nThe solution to this equation is\n\n$$\nS(t)={S}_{0}\\,{e}^{-0.1t},\n$$\n\nwhere ${S}_{0}$ is the initial value.\n\nWe're told that there were $100\\,000$  sales initially, so we have ${S}_{0}=100\\,000.$\n\nTherefore, the number of sales $S$ at time $t$ is\n\n$$\nS(t)=100\\,000\\,{e}^{-0.1t}\\,.\n$$\n\nFinally, to find the number of sales when $t=10,$ we substitute $t=10$ into the above, as follows:\n\n$$\n\\begin{aligned}S(10) & =100\\,000\\,{e}^{-0.1\\cdot 10} \\\\  & =100\\,000\\,{e}^{-1} \\\\  & ≈36\\,787.94\\end{aligned}\n$$\n\nRounding our answer to the nearest integer, we conclude that there are $36\\,788$ sales after $10$ weeks."}] [{:db/id #edb/ref 17592186253585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c5a967-b916-51e7-85c4-87f741809c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\%" :db/id #edb/ref 17592186251507} {:answer/id #uuid "7f5d2774-02d8-509e-bea0-22fc4c3d00a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\%" :db/id #edb/ref 17592186251623} {:answer/id #uuid "a87254c0-c4f2-5b10-99f8-6cd6541cb657" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19\\%" :db/id #edb/ref 17592186252011} {:answer/id #uuid "bd7ae1e5-acb5-5733-998b-a9c096ad44ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\%" :db/id #edb/ref 17592186252230} {:answer/id #uuid "fee1ef19-6c5f-5663-8680-40607d99f5d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\%" :db/id #edb/ref 17592186252793}] :answer-field/correct {:db/id #edb/ref 17592186252230} :answer-field/id #uuid "2271c125-3539-579c-b126-09af49fbc17a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252867}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74752b29-704c-5e5f-8887-3d2f4bffc5fa" :question/math-academy-id "q-119597" :question/problem "The value $V=V(t)$ of a certain art object $t$ years after its production can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=kV\n$$\n\nwhere $k>0$ is the growth rate. If it was initially worth $\\$2\\,000,$ and $V(10)=10\\,000$, calculate the value  of the growth rate $k$ to the nearest percent." :question/worked-solution "We model the value of the art object using the differential equation\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=kV.\n$$\n\nThe solution to this equation is\n\n$$\nV(t)={V}_{0}\\,{e}^{kt},\n$$\n\nwhere ${V}_{0}$ is the initial value.\n\nWe're told that  it was initially worth $\\$2\\,000,$ so we have ${V}_{0}=2\\,000.$\n\nTherefore, the value $V$ at time $t$ is\n\n$$\nV(t)=2\\,000\\,{e}^{kt}.\n$$\n\nFinally, to find the value of $k,$ we substitute $V(10)=10\\,000$ into the equation above and solve for $k,$ as follows:\n\n$$\n\\begin{aligned}V(10) & =2\\,000\\,{e}^{k\\cdot 10} \\\\ 10\\,000 & =2\\,000\\,{e}^{10k} \\\\ {e}^{10k} & =\\frac{10\\,000}{2\\,000} \\\\ {e}^{10k} & =5 \\\\ \\operatorname{ln}⁡({e}^{10k}) & =\\operatorname{ln}⁡(5) \\\\ 10k & =\\operatorname{ln}⁡(5) \\\\ k & =\\frac{1}{10}\\operatorname{ln}⁡(5) \\\\ k & ≈0.16\\end{aligned}\n$$\n\nTherefore, $k≈16\\%,$ rounded to the nearest percent."}] [{:db/id #edb/ref 17592186265777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08231897-379f-5465-a685-d58d28a9a029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263074} {:answer/id #uuid "2fdbf991-a81b-541a-86a5-8e9569760048" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263403} {:answer/id #uuid "894275a3-764c-5ff1-95dd-588429bf5785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186264182} {:answer/id #uuid "90767335-6ee7-503b-aaad-90d180393cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186264241} {:answer/id #uuid "edaad585-b008-5187-9422-f08e3851db74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265076}] :answer-field/correct {:db/id #edb/ref 17592186263074} :answer-field/id #uuid "37094ebd-d0aa-5bec-a937-d45769e3e042" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265344}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "59cfc6f0-d08d-5f61-ba3e-7216ac027397" :question/math-academy-id "q-129797" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=x$ and ${y}_{2}(x)=\\operatorname{sin}⁡x.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nIn our case, we have ${y}_{1}(x)=x$ and ${y}_{2}(x)=\\operatorname{sin}⁡x.$ Therefore\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(x){(\\operatorname{sin}⁡x)}^{′}-(\\operatorname{sin}⁡x){(x)}^{′} \\\\  & =(x)(\\operatorname{cos}⁡x)-(\\operatorname{sin}⁡x)(1) \\\\  & =x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e76a6fe-6d24-5989-a9e7-3c18718b2cf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186263552} {:answer/id #uuid "4ae06cb8-7602-50b5-825f-1241313fd0fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186263643} {:answer/id #uuid "53c3a2c4-e337-527f-9a70-7c872bcee9dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263723} {:answer/id #uuid "6d2bf0c3-3f89-5769-9e6d-06a6d5c01fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-{x}^{2}\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263944} {:answer/id #uuid "d1155580-e3e6-5b63-82ba-ce930249adb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186264827}] :answer-field/correct {:db/id #edb/ref 17592186264827} :answer-field/id #uuid "e7f3a1f3-9d09-58de-a25f-2af39a88d549" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265656}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9ce6b8cc-3f3b-55bd-a0b8-d4825ae956b1" :question/math-academy-id "q-129800" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=x$ and ${y}_{2}(x)=x\\operatorname{sin}⁡x.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nIn our case, we have ${y}_{1}(x)=x$ and ${y}_{2}(x)=x\\operatorname{sin}⁡x.$ Therefore\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(x){(x\\operatorname{sin}⁡x)}^{′}-(x\\operatorname{sin}⁡x){(x)}^{′} \\\\  & =x(\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x)-(x\\operatorname{sin}⁡x)(1) \\\\  & =x\\operatorname{sin}⁡x+{x}^{2}\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x \\\\  & ={x}^{2}\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0889345f-a38a-50cd-a87f-84b6104b3bc2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ or $2$" :db/id #edb/ref 17592186263081} {:answer/id #uuid "2c370f5b-e48e-5f12-9548-77b8e555ecb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $1$" :db/id #edb/ref 17592186263374} {:answer/id #uuid "9f6f9741-617d-5b1f-93fe-1140a62ac290" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ or $1$" :db/id #edb/ref 17592186264358} {:answer/id #uuid "ae7d9162-df73-56b4-ad07-bb194e701f0f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ or $2$" :db/id #edb/ref 17592186264502} {:answer/id #uuid "e41e761f-da1d-5e5f-908b-2fafe637f5bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ or $2$" :db/id #edb/ref 17592186264982}] :answer-field/correct {:db/id #edb/ref 17592186264502} :answer-field/id #uuid "e654c3b5-2d10-5e67-86aa-fd41f51028f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44bbf18b-7ba9-5ecf-acfa-bc2974557813" :question/math-academy-id "q-129836" :question/problem "Consider the equation ${y}^{″}-{y}^{′}-2y=0$ where $y=y(x).$ If $y={e}^{\\lambda x}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-\\lambda {e}^{\\lambda x}-2{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-\\lambda -2) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-\\lambda -2 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +1)(\\lambda -2)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-1$ or $\\lambda =2.$"}] [{:db/id #edb/ref 17592186265829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a09fc5-de73-5cc7-9b01-55b17faed4d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{-x}" :db/id #edb/ref 17592186263202} {:answer/id #uuid "7779f14c-50b3-520b-91d6-2a97c1b4d4a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-x}+B{e}^{2x}" :db/id #edb/ref 17592186264037} {:answer/id #uuid "8dee922c-748c-5c16-a3a3-9b46af27a554" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-x}+B{e}^{x}" :db/id #edb/ref 17592186264214} {:answer/id #uuid "978b4e8e-825b-5241-9035-2b14924b85ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{x}" :db/id #edb/ref 17592186264302} {:answer/id #uuid "a104befc-b950-5466-a5f6-df8ac36039ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{2x}" :db/id #edb/ref 17592186264369}] :answer-field/correct {:db/id #edb/ref 17592186264302} :answer-field/id #uuid "64d38205-f37e-5e25-ab49-76fc3955e146" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265421}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "480d405e-b6dc-5f02-bd47-92890e02436f" :question/math-academy-id "q-130114" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\frac{\\text{d}y}{\\text{d}x}-2y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+\\lambda {e}^{\\lambda x}-2{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+\\lambda -2) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+\\lambda -2.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =1.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{x}.\n$$"}] [{:db/id #edb/ref 17592186265830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "302061b2-590e-57bc-9027-1fa52d005f22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-4x}+B{e}^{x}" :db/id #edb/ref 17592186263407} {:answer/id #uuid "4137b59d-651f-5d17-9d5f-7b05b5e44095" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186263579} {:answer/id #uuid "5cf5d4d5-d6e9-5c36-b641-b515c21d032a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-x}+B{e}^{5x}" :db/id #edb/ref 17592186263806} {:answer/id #uuid "76ae8221-3de4-5545-bdbe-c6c34dd61a2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-4x}+B{e}^{5x}" :db/id #edb/ref 17592186264032} {:answer/id #uuid "931f5078-4d07-5799-b50c-80cf55dd7ee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-5x}+B{e}^{4x}" :db/id #edb/ref 17592186264261}] :answer-field/correct {:db/id #edb/ref 17592186263579} :answer-field/id #uuid "08f3fbfd-de21-55e9-b36b-0dcec2a0f91f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265259}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aabd9305-103b-5e3f-a7eb-59e7abf9e597" :question/math-academy-id "q-130118" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -4)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =1$ or $\\lambda =4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{x}+B{e}^{4x}.\n$$"}] [{:db/id #edb/ref 17592186265832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6b0f30-722e-564a-bc0f-567caceb21da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-3x}+{e}^{-x}" :db/id #edb/ref 17592186263530} {:answer/id #uuid "5c82e1c9-7216-598e-bed5-f25629a73c98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{3x}" :db/id #edb/ref 17592186263799} {:answer/id #uuid "6397e78e-daa7-5177-ba18-9151594d411a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-3x}+3{e}^{-x}" :db/id #edb/ref 17592186263861} {:answer/id #uuid "d767c68c-5d55-5b4e-b28e-a165a6cb90c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{e}^{-x}" :db/id #edb/ref 17592186264878} {:answer/id #uuid "e09f071c-e6a0-5382-aa02-707969b3720a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-3x}" :db/id #edb/ref 17592186264950}] :answer-field/correct {:db/id #edb/ref 17592186263799} :answer-field/id #uuid "27ada274-ae51-593f-9c0d-7d5e8a1a2519" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265320}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c7e5301-fce4-581f-9a1b-7a5fdeeaa7ab" :question/math-academy-id "q-130123" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+4{y}^{′}+3y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+3{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +3 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +3)(\\lambda +1)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-3$ or $\\lambda =-1.$\n\nTherefore, any linear combination of the functions ${e}^{-3x}$ and ${e}^{-x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{3x}$ is not a solution."}] [{:db/id #edb/ref 17592186265833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ad620b-3fc3-5457-b0e3-5365f9109304" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{-3x}" :db/id #edb/ref 17592186263245} {:answer/id #uuid "8f9e0533-11b3-5bc5-a88a-67a4e6340865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{-3x}+4{e}^{-2x}" :db/id #edb/ref 17592186264231} {:answer/id #uuid "9730928e-aad3-5e78-9c5e-7d9033980232" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-3x}+{e}^{-2x}" :db/id #edb/ref 17592186264295} {:answer/id #uuid "b8b2ef53-8585-5367-ae62-ca4ee6637dd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-3x}+{e}^{2x}" :db/id #edb/ref 17592186264597} {:answer/id #uuid "f2632b6d-569b-5600-aedc-7ef3ddd7e627" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-2x}" :db/id #edb/ref 17592186265131}] :answer-field/correct {:db/id #edb/ref 17592186264597} :answer-field/id #uuid "2397aa76-173b-51c5-9008-6a28b68229dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265309}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e70795d1-4d4c-517f-8763-1daa4c701147" :question/math-academy-id "q-130124" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+5{y}^{′}+6y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+5\\lambda {e}^{\\lambda x}+6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+5\\lambda +6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+5\\lambda +6 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +3)(\\lambda +2)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-3$ or $\\lambda =-2.$\n\nTherefore, any linear combination of the functions ${e}^{-3x}$ and ${e}^{-2x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{-3x}+{e}^{2x}$ is not a solution."}] [{:db/id #edb/ref 17592186272345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b4d2f7-6de2-5196-b879-a739a65217f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{y}=\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186269464} {:answer/id #uuid "6d70ab15-788c-5c79-a3c0-32dd56d91377" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡|y|={e}^{x}+C" :db/id #edb/ref 17592186270240} {:answer/id #uuid "9562133f-63b5-500a-8c0d-b36151b151b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡|y|={e}^{\\sqrt{x}}+C" :db/id #edb/ref 17592186270580} {:answer/id #uuid "d007c7f5-5f1d-5941-b941-1b46c8f9d226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{\\sqrt{x}}+C" :db/id #edb/ref 17592186271095} {:answer/id #uuid "e3317b49-f544-53b2-a03e-5508bdec7af7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{x}+C" :db/id #edb/ref 17592186271269}] :answer-field/correct {:db/id #edb/ref 17592186270240} :answer-field/id #uuid "df0697db-7cb2-5930-925b-39436791038a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271900}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8ed818f-2b3f-54cd-b6b2-99b0955850e8" :question/math-academy-id "q-14246" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y{e}^{x} \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & ={e}^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|={e}^{x}+C\n$$"}] [{:db/id #edb/ref 17592186272346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bbb69e0-08ac-541f-a0c9-781e5adaf93d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{\\sqrt{{x}^{2}+2}}" :db/id #edb/ref 17592186269951} {:answer/id #uuid "a64073d1-36b3-54ce-9da0-185ff798ba5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{{x}^{2}+2x}" :db/id #edb/ref 17592186270756} {:answer/id #uuid "caeda8f1-2556-5b04-bcc7-d9ae17db2b41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{\\sqrt{{x}^{3}+x}}" :db/id #edb/ref 17592186271051} {:answer/id #uuid "d6d54641-37a1-5f1b-b411-9374e6a99c0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{{x}^{3}+x}" :db/id #edb/ref 17592186271154} {:answer/id #uuid "f24d04bd-5257-5f28-8f9a-f8dfa0f53d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{3{x}^{2}+x}" :db/id #edb/ref 17592186271398}] :answer-field/correct {:db/id #edb/ref 17592186271154} :answer-field/id #uuid "f58bc506-2ce6-5f14-8138-f2c78e5c6cec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271934}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8f251269-fa35-5ece-9af4-5538cedc8207" :question/math-academy-id "q-14247" :question/problem "Find the general solution to the differential equation ${y}^{′}=y+3y{x}^{2}$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y+3y{x}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y+3y{x}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y(1+3{x}^{2}) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1+3{x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (1+3{x}^{2})\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (1+3{x}^{2})\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =x+{x}^{3}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|={x}^{3}+x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & ={x}^{3}+x+C \\\\ |y| & ={e}^{{x}^{3}+x+C} \\\\ |y| & ={e}^{{x}^{3}+x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{{x}^{3}+x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{{x}^{3}+x}.\n$$"}] [{:db/id #edb/ref 17592186272353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67122d50-92e9-5dbf-990c-0216ba86e1b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2x+C}" :db/id #edb/ref 17592186270187} {:answer/id #uuid "74a6e407-2886-5e8a-b215-c668e4499333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{{x}^{2}+x}+C" :db/id #edb/ref 17592186270298} {:answer/id #uuid "8f18500b-635a-52f2-ad08-9cfecc92fe33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2{x}^{2}+x}+C" :db/id #edb/ref 17592186270513} {:answer/id #uuid "afaac117-d7de-54cf-b4d2-12a4f27ad185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{{x}^{3}+C}" :db/id #edb/ref 17592186270833} {:answer/id #uuid "fe67ce39-75d8-5a64-817a-e44f388af12a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{{x}^{2}+x+C}" :db/id #edb/ref 17592186271497}] :answer-field/correct {:db/id #edb/ref 17592186271497} :answer-field/id #uuid "df104af1-2216-5c05-8160-ea3f0cd58c3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271901}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de6a882e-022d-59c5-adf8-2e2394047b45" :question/math-academy-id "q-14253" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}+2{y}^{2}x$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={y}^{2}+2{y}^{2}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={y}^{2}(1+2x) \\\\ \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1+2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (1+2x)\\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}}\\,\\text{d}y & =\\int (1+2x)\\,\\text{d}x \\\\ -\\frac{1}{y} & =x+{x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n-\\frac{1}{y}={x}^{2}+x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=-\\frac{1}{{x}^{2}+x+C}.\n$$"}] [{:db/id #edb/ref 17592186272362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4171c5-a734-541a-8466-69b56ce0d873" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{ln}⁡(1+{e}^{x})" :db/id #edb/ref 17592186269359} {:answer/id #uuid "38ecd45c-ba43-5032-b302-2a4db3f68db3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{ln}⁡(1+x+{e}^{x})" :db/id #edb/ref 17592186269785} {:answer/id #uuid "b0aa3d76-7de4-57d1-9a49-fedf8212ceab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{ln}⁡(x+{e}^{x})" :db/id #edb/ref 17592186270846} {:answer/id #uuid "b2780b36-6d65-5d14-9b03-a066bbecba37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{ln}⁡(3-2x-{e}^{x})" :db/id #edb/ref 17592186270864} {:answer/id #uuid "bcf951d6-95fc-5d3d-8bf4-6811a7297a18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{ln}⁡(3-{e}^{x})" :db/id #edb/ref 17592186270934}] :answer-field/correct {:db/id #edb/ref 17592186270934} :answer-field/id #uuid "c146e3ac-1df2-5b81-bf01-9382213bcac9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271861}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a8c132a-a85d-5f19-bf08-0d6e90b34efd" :question/math-academy-id "q-14267" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{x+y}$ given that  $\\,y(0)=-\\operatorname{ln}⁡2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x+y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}{e}^{y} \\\\ {e}^{-y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x} \\\\ \\int {e}^{-y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {e}^{-y}\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ -{e}^{-y} & ={e}^{x}+{C}_{1} \\\\ {e}^{-y} & =-{e}^{x}+C\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{-y}) & =\\operatorname{ln}⁡(-{e}^{x}+C) \\\\ -y & =\\operatorname{ln}⁡(C-{e}^{x}) \\\\ y & =-\\operatorname{ln}⁡(C-{e}^{x}).\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=-\\operatorname{ln}⁡2$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =-\\operatorname{ln}⁡2 \\\\ -\\operatorname{ln}⁡(C-{e}^{0}) & =-\\operatorname{ln}⁡2 \\\\ \\operatorname{ln}⁡(C-1) & =\\operatorname{ln}⁡2 \\\\ C-1 & =2 \\\\ C & =3\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{x+y}$ that satisfies the condition $y(0)=-\\operatorname{ln}⁡2$ is\n\n$$\ny=-\\operatorname{ln}⁡(3-{e}^{x}).\n$$"}] [{:db/id #edb/ref 17592186275103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b271c8-930d-55d2-b6c9-4d10415d1f40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{tan}⁡(x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186272398} {:answer/id #uuid "453026c0-09cc-5849-a51c-b0765a6a347c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{cot}⁡(x-\\frac{\\pi }{4})" :db/id #edb/ref 17592186272980} {:answer/id #uuid "7f4bfc4f-7d7a-5012-b1f2-ad8906f9fa0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{tan}⁡(x+\\frac{\\pi }{4})" :db/id #edb/ref 17592186273481} {:answer/id #uuid "a9c5c442-efee-51ea-b4c4-619423884639" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{tan}⁡(x+\\frac{\\pi }{2})" :db/id #edb/ref 17592186273854} {:answer/id #uuid "dcd30bde-3736-5aa2-a5e8-1c3be5c7c83c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{cot}⁡(x+\\frac{\\pi }{2})" :db/id #edb/ref 17592186274328}] :answer-field/correct {:db/id #edb/ref 17592186272398} :answer-field/id #uuid "6bfbd7fa-8ea2-5c3c-b15b-9c490e6cfc9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274817}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2219a64-4fca-5417-a4ef-4988c9db8d90" :question/math-academy-id "q-14310" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}+1$ given that  $y\\left(\\frac{\\pi }{2}\\right)=1.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}={y}^{2}+1 \\\\ \\frac{1}{{y}^{2}+1}\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{{y}^{2}+1}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}+1}\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{arctan}⁡(y) & =x+C \\\\ y & =\\operatorname{tan}⁡(x+C).\\end{aligned}\n$$\n\nWe conclude that the general solution is\n\n$$\ny=\\operatorname{tan}⁡(x+C).\n$$\n\nWe now apply the condition $y\\left(\\frac{\\pi }{2}\\right)=1$ to find $C$:\n\n$$\n\\begin{aligned}1 & =\\operatorname{tan}⁡(\\frac{\\pi }{2}+C) \\\\ \\operatorname{arctan}⁡(1) & =\\frac{\\pi }{2}+C \\\\ \\frac{\\pi }{4} & =\\frac{\\pi }{2}+C \\\\ C & =\\frac{\\pi }{4}-\\frac{\\pi }{2} \\\\ C & =-\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nThus, the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}+1$ that satisfies the condition $y\\left(\\frac{\\pi }{2}\\right)=1$ is\n\n$$\ny=\\operatorname{tan}⁡(x-\\frac{\\pi }{4}).\n$$"}] [{:db/id #edb/ref 17592186275104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161701b8-cab3-5a52-baee-ca387468d340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-1+x}" :db/id #edb/ref 17592186272583} {:answer/id #uuid "50b36c20-41be-54bd-8252-8418beace6e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-{e}^{-x}}" :db/id #edb/ref 17592186273071} {:answer/id #uuid "6737182b-f42e-57d4-b8d6-67a37fb50f8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{{e}^{x}}" :db/id #edb/ref 17592186273273} {:answer/id #uuid "7771e672-13a1-5981-b9ae-117088631933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-1-{e}^{x}}" :db/id #edb/ref 17592186273404} {:answer/id #uuid "db69fd4d-8719-5651-b5ad-029bab24e359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-1+{e}^{-x}}" :db/id #edb/ref 17592186274311}] :answer-field/correct {:db/id #edb/ref 17592186273071} :answer-field/id #uuid "62ccf029-8cdb-5f2e-b996-01a4b881873e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274806}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd2fa0cf-e14d-5280-8a92-ce27abb0aa11" :question/math-academy-id "q-14312" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y{e}^{-x}$ that satisfies $y(0)={e}^{-1}.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y{e}^{-x} \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{-x} \\\\ \\int \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}\\,dx & =\\int {e}^{-x}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int {e}^{-x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =-{e}^{-x}+C.\\end{aligned}\n$$\n\nApplying the exponential function to both sides, we find the general solution:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{-{e}^{-x}+C} \\\\ |y| & ={e}^{-{e}^{-x}+C} \\\\ y & =\\pm {e}^{-{e}^{-x}+C} \\\\ y & =K{e}^{-{e}^{-x}}\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{C}$ is an arbitrary constant. \n\nWe now apply the condition $y(0)={e}^{-1}$ to find $K:$ \n\n$$\n\\begin{aligned}{e}^{-1} & =K{e}^{-{e}^{-0}} \\\\ {e}^{-1} & =K{e}^{-1} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the particular solution of $\\frac{\\text{d}y}{\\text{d}x}=y{e}^{-x}$ that satisfies the condition $y(0)={e}^{-1}$ is\n\n$$\ny={e}^{-{e}^{-x}}.\n$$"}] [{:db/id #edb/ref 17592186275105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184695d3-9029-5e71-b2c0-44b31db02e5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}=3{x}^{2}+5" :db/id #edb/ref 17592186272598} {:answer/id #uuid "1bb941ed-69f9-51b5-84ab-9b185febcd77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}={x}^{2}+3" :db/id #edb/ref 17592186272625} {:answer/id #uuid "664df1fa-7210-55f4-b6c5-5c6c644b8caa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}={x}^{3}+7" :db/id #edb/ref 17592186273263} {:answer/id #uuid "7bb836b0-ad07-50fc-aaa1-78966b0fe6f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}=5{x}^{3}+3" :db/id #edb/ref 17592186273448} {:answer/id #uuid "93347f2d-2098-56c3-8973-3c2341f180fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}=2{x}^{3}+2" :db/id #edb/ref 17592186273667}] :answer-field/correct {:db/id #edb/ref 17592186273263} :answer-field/id #uuid "46fc4299-9139-57f9-a4a0-55185f85b3c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274754}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c2372277-7745-54d3-839c-0b3553acea76" :question/math-academy-id "q-14313" :question/problem "Find the particular solution to the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{{x}^{2}}{{y}^{2}}\n$$  that satisfies $y(1)=2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{{y}^{2}} \\\\ {y}^{2}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2} \\\\ \\int {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int {y}^{2}\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{{y}^{3}}{3} & =\\frac{{x}^{3}}{3}+{C}_{1} \\\\ {y}^{3} & ={x}^{3}+C,\\end{aligned}\n$$\n\nwhere   $C=3{C}_{1}$ is an arbitrary constant.  \n\nWe now apply the condition $y(1)=2$ to find $C:$\n\n$$\n\\begin{aligned}{2}^{3} & ={1}^{3}+C \\\\ 8-1 & =C \\\\ C & =7\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}={x}^{3}+7.\n$$"}] [{:db/id #edb/ref 17592186275106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a63a78-d8f8-520d-9e1a-a547cbc802ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right)+2v)\\frac{\\text{d}v}{\\text{d}x}=x" :db/id #edb/ref 17592186272882} {:answer/id #uuid "5798a05b-9e8b-5365-ba0d-17eaf8a8607b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1}{\\operatorname{tan}⁡\\left(\\frac{1}{v}\\right)+v}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186273138} {:answer/id #uuid "610c7517-5cb8-53dc-8041-977fdbde02dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1}{\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right)+2v}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186273226} {:answer/id #uuid "6dd95ac9-8774-563b-bda6-a758e1302a3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{tan}⁡\\left(\\frac{1}{v}\\right)+2{v}^{2})\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186273341} {:answer/id #uuid "df13e973-3a12-5311-937b-d3dcae4d2226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right))\\frac{\\text{d}v}{\\text{d}x}=x" :db/id #edb/ref 17592186274354}] :answer-field/correct {:db/id #edb/ref 17592186273226} :answer-field/id #uuid "15ca98bc-dec3-575a-b42c-45d374e930cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274674}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4e19450-4e51-548d-b019-a1f8398b116f" :question/math-academy-id "q-14314" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡\\left(\\frac{{x}^{2}}{{y}^{2}}\\right)+\\frac{3y}{x}.\n$$\n\nIf the transformation $y=v(x)x$ is applied to the differential equation, what is the resulting equation?" :question/worked-solution "Using the transformation $y=vx$ (where $v=v(x)$), we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{tan}⁡\\left(\\frac{{x}^{2}}{{y}^{2}}\\right)+\\frac{3y}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\operatorname{tan}⁡\\left(\\frac{{x}^{2}}{{v}^{2}{x}^{2}}\\right)+\\frac{3vx}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right)+3v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right)+2v \\\\ \\left(\\frac{1}{\\operatorname{tan}⁡\\left(\\frac{1}{{v}^{2}}\\right)+2v}\\right)\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$"}]}
