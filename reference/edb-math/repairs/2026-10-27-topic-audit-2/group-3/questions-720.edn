+ 7}" :db/id #edb/ref 17592186610470}] :answer-field/correct {:db/id #edb/ref 17592186610455} :answer-field/id #uuid "485fe0e0-0492-5f0a-9c96-8383391a20d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186610446}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4ca25e8-79e5-5523-a975-f95345c4c6b4" :question/problem "Given that $f(x)={e}^{6x+7},$ find $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=6x+7.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 6 \\\\  & =6{e}^{u} \\\\  & =6{e}^{6x+7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a310b50-e76d-5c84-a7d8-439cba9283f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(14 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610475} {:answer/id #uuid "26a31a6d-0ddd-5920-b189-0f95fa2a1b73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(15 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610482} {:answer/id #uuid "300bc62e-aa67-500e-9e29-b98c5a745e4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(16 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610485} {:answer/id #uuid "d74640fc-0a3c-52b2-977c-9201db784ece" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(8 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610500} {:answer/id #uuid "fa473eba-82bb-53ff-9841-25d71827e37b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(13 x\\right)e^{4{x}^{2}-6}" :db/id #edb/ref 17592186610502}] :answer-field/correct {:db/id #edb/ref 17592186610500} :answer-field/id #uuid "bf5c94bf-efc6-541e-a1af-13bb640e828e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186610496}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a6f87ab-c871-5d73-b2fc-d2732f1674d8" :question/problem "Given that $y=e^{4{x}^{2}-6}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=4{x}^{2}-6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (8x) \\\\ & =(8x)e^{u} \\\\ & =8 x e^{4 x^{2} - 6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114666fb-e4b1-5224-8ac4-31e59d040d5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 8 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610478} {:answer/id #uuid "48800d7c-ecaf-51c2-96b7-ba445223aee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 11 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610487} {:answer/id #uuid "8facde07-0b54-542e-88b0-754af8f0a5bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 10 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610493} {:answer/id #uuid "c90aabe4-d1a1-54fa-bc6b-88b3c9a436f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 4 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610497} {:answer/id #uuid "e09577c3-4b1c-5fc2-83f1-8999e9812bd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 9 x\\right)e^{-2{x}^{2}+1}" :db/id #edb/ref 17592186610501}] :answer-field/correct {:db/id #edb/ref 17592186610497} :answer-field/id #uuid "bcb277f3-fe77-50e5-873d-1973c4992c81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186610495}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15b62d33-cb18-5df8-9bbc-c0c480db4147" :question/problem "Find $f′(x)$ for $f(x)=e^{-2{x}^{2}+1}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u=-2{x}^{2}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-4x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (-4x) \\\\ & =(-4x)e^{u} \\\\ & =- 4 x e^{1 - 2 x^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d026a6-2206-53ea-a409-4618dfcd55ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(3 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610483} {:answer/id #uuid "8bb1d071-4c68-553b-a230-488c233f4bb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(4 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610491} {:answer/id #uuid "8c9a8673-82e7-5213-acce-c81f91b01bb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(6 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610492} {:answer/id #uuid "cb7a4773-76c0-5f03-87e3-3004a0849809" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(10 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610498} {:answer/id #uuid "ff8c3307-5958-5fe4-b101-a2a253fa0f3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(7 x^{3}\\right)e^{{x}^{4}-8}" :db/id #edb/ref 17592186610503}] :answer-field/correct {:db/id #edb/ref 17592186610491} :answer-field/id #uuid "10addea1-4650-53ff-b6d4-deee11cf02ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186610477}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15bd5965-2c97-5c0a-bda8-27bd8b23f859" :question/problem "Find $f′(x)$ for $f(x)=e^{{x}^{4}-8}$." :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u={x}^{4}-8.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (4{x}^{3}) \\\\ & =(4{x}^{3})e^{u} \\\\ & =4 x^{3} e^{x^{4} - 8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e60f46-f7fe-5772-b8c0-dc7343518590" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(13 x^{3} + 6\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610473} {:answer/id #uuid "070c3f80-61a6-5863-a6b1-33b6899f1368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(16 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610474} {:answer/id #uuid "32dcf1db-cad3-5ea9-b541-9a00e6f6a5e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(8 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610486} {:answer/id #uuid "9c1bc474-37a0-52e3-9f1e-9b4d9b1838f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(9 x^{3} + 6\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610494} {:answer/id #uuid "ccfa003a-e603-5e98-936b-f436b88940b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(14 x^{3} + 5\\right)e^{2{x}^{4}+5x}" :db/id #edb/ref 17592186610499}] :answer-field/correct {:db/id #edb/ref 17592186610486} :answer-field/id #uuid "851f94c7-b8fe-5a81-b39a-4f857ba79151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186610490}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2fa6917a-5a4a-5303-8052-9cb68d3b2fcc" :question/problem "Given that $y=e^{2{x}^{4}+5x}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=e^{u},\\,u=2{x}^{4}+5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8{x}^{3}+5.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (8{x}^{3}+5) \\\\ & =(8{x}^{3}+5)e^{u} \\\\ & =\\left(8 x^{3} + 5\\right) e^{2 x^{4} + 5 x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186610488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16126b45-e476-59b2-8939-faf24557a0e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18 x^{5} e^{3 x^{6}}" :db/id #edb/ref 17592186610481}] :answer-field/correct {:db/id #edb/ref 17592186610481} :answer-field/id #uuid "7984346a-477f-5829-aad1-d3f5fd0110ad" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186610489}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56855aa4-8739-5d32-8b10-552d67cfe6ca" :question/problem "Find $f′(x)$ for $f(x)=e^{3{x}^{6}}$.\n\n$f′(x)=$\n{{field-1}}" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf=e^{u},\\,u=3{x}^{6}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=e^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=18{x}^{5}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ & =e^{u}\\cdot (18{x}^{5}) \\\\ & =(18{x}^{5})e^{u} \\\\ & =18 x^{5} e^{3 x^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb667c8f-9adf-5349-ad7f-a4747d4996c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x^2+1}" :db/id #edb/ref 17592186611383}] :answer-field/correct {:db/id #edb/ref 17592186611383} :answer-field/id #uuid "a1b7fc3b-0489-599b-a33d-b01a904ddc4f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186611525}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9759ed03-ac35-5978-994e-f41f2480791e" :question/math-academy-id "q-355529" :question/problem "Find the particular solution to the differential equation\n$\\frac{\\text{d}y}{\\text{d}x}+2x{y}^{2}=0$\nthat satisfies the condition $y(2)=\\frac{1}{5}.$  Assume that $y>0.$\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}+2x{y}^{2} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-2x{y}^{2} \\\\ \\frac{1}{{y}^{2}}\\,\\text{d}y & =-2x\\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}}\\,\\text{d}y & =\\int -2x\\,\\text{d}x \\\\ -\\frac{1}{y} & =-{x}^{2}+{C}_{1} \\\\ \\frac{1}{y} & ={x}^{2}-{C}_{1} \\\\ y & =\\frac{1}{{x}^{2}-{C}_{1}}.\\end{aligned}\n$$\n\nAssuming $y>0,$ the general solution is\n\n$$\ny(x)=\\frac{1}{{x}^{2}+C},\n$$\n\nwhere $C=-{C}_{1}$ is an arbitrary constant.\n\nWe now apply the condition $y(2)=\\frac{1}{5}$ to find $C:$\n\n$$\n\\begin{aligned}\\frac{1}{5} & =\\frac{1}{(2)^{2}+C} \\\\ \\frac{1}{5} & =\\frac{1}{4+C} \\\\ 5 & =4+C \\\\ C & =1\\end{aligned}\n$$\n\nThus, the particular solution is\n\n$$\ny(x)=\\frac{1}{{x}^{2}+1}.\n$$"}] [{:db/id #edb/ref 17592186611628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f0d3d1-d5c3-5423-8d9c-435bab2cb3b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2x^4+7}" :db/id #edb/ref 17592186611105}] :answer-field/correct {:db/id #edb/ref 17592186611105} :answer-field/id #uuid "4c8694f4-d6cb-5998-87f5-d1ab47e7a995" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186611491}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be49ba33-2e88-505f-80dc-7c884577e569" :question/math-academy-id "q-347850" :question/problem "Find the particular solution to the differential equation\n$$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{4{x}^{3}}{y}\n$$\nthat satisfies the condition $y(1)=3.$  Assume that $y>0.$\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4{x}^{3}}{y} \\\\ y\\,\\text{d}y & =4{x}^{3}\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int 4{x}^{3}\\,\\text{d}x \\\\ \\frac{{y}^{2}}{2} & ={x}^{4}+{C}_{1} \\\\ {y}^{2} & =2{x}^{4}+2{C}_{1} \\\\ y & =\\pm \\sqrt{2{x}^{4}+2{C}_{1}}.\\end{aligned}\n$$\n\nAssuming $y>0,$ the general solution is\n\n$$\ny(x)=\\sqrt{2{x}^{4}+C},\n$$\n\nwhere $C=2{C}_{1}$ is an arbitrary constant.\n\nWe now apply the condition $y(1)=3$ to find $C:$\n\n$$\n\\begin{aligned}3 & =\\sqrt{2(1)^{4}+C} \\\\ 3 & =\\sqrt{2+C} \\\\ 9 & =2+C \\\\ C & =7\\end{aligned}\n$$\n\nThus, the particular solution is\n\n$$\ny(x)=\\sqrt{2{x}^{4}+7}.\n$$"}] [{:db/id #edb/ref 17592186611693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691}] :answer-field/correct {:db/id #edb/ref 17592186611691} :answer-field/id #uuid "e573b0d0-2df3-5439-93d8-68fb45052de8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186611696}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d431469-04a8-5431-a8f2-30fe91513752" :question/problem "Given that $f(x)=(1+2x)^{4},$ the equation of the tangent at the point $(-1,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(1+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=-1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=-1} &=[8(1+2x)^{3}]|_{x=-1} \\\\  &=8(1+2(-1))^{3} \\\\  &=-8.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(-1,1)$ is $m=-8.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=-8(x-(-1)) \\\\ y &=- 8 x - 8+1 \\\\ y &=- 8 x - 7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697}] :answer-field/correct {:db/id #edb/ref 17592186611697} :answer-field/id #uuid "0f1d28df-dabb-5bf7-8e72-27b57ca20785" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186611690}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "90d7ca00-a943-5f90-be7d-b4fa402d7fc3" :question/problem "Given that $f(x)=(-4+2x)^{4},$ the equation of the tangent at the point $(1,16)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=-4+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(-4+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[8(-4+2x)^{3}]|_{x=1} \\\\  &=8(-4+2(1))^{3} \\\\  &=-64.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,16)$ is $m=-64.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(16) &=-64(x-(1)) \\\\ y &=64 - 64 x+16 \\\\ y &=80 - 64 x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186611695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698}] :answer-field/correct {:db/id #edb/ref 17592186611698} :answer-field/id #uuid "576ad759-6f77-5ac1-a36e-2ea6c5dd47da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186611692}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c482bf94-14dc-5d26-9e9f-475518535fcc" :question/problem "Given that $f(x)=(1+3x)^{4},$ the equation of the tangent at the point $(0,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(1+3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=0$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=0} &=[12(1+3x)^{3}]|_{x=0} \\\\  &=12(1+3(0))^{3} \\\\  &=12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(0,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=12(x-(0)) \\\\ y &=12 x+1 \\\\ y &=12 x + 1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186614585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5c5c57-ff82-5fd5-aaac-17482984506d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186613945} {:answer/id #uuid "580510f9-1cd1-5457-a43c-248ce7b45d09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186614066} {:answer/id #uuid "5a983be6-491f-504e-8561-5d6ac5a1e66f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186614071} {:answer/id #uuid "b1e8e6c7-7b48-5088-b9a0-99e2a0343baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186614255} {:answer/id #uuid "b54cdb63-fbf3-5dcc-8122-d77e259ab723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}" :db/id #edb/ref 17592186614260}] :answer-field/correct {:db/id #edb/ref 17592186614071} :answer-field/id #uuid "fe19b15b-a617-57ee-94e5-65be081a8fec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186614544}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6ae0e9f1-1c28-529d-9fc7-4de77e68896f" :question/math-academy-id "q-48551" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-2x}$ at the point where $x=1.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-2.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-2) \\\\  & =(3{x}^{2}-2)\\cdot {e}^{u} \\\\  & =(3{x}^{2}-2){e}^{{x}^{3}-2x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(3{x}^{2}-2){e}^{{x}^{3}-2x}|}_{x=1} \\\\  & =(3(1)^{2}-2){e}^{{1}^{3}-2(1)} \\\\  & ={e}^{-1} \\\\  & =\\frac{1}{e}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186615365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecacaa6-b9e0-5a5e-9467-4c6167922106" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{x^2+1}" :db/id #edb/ref 17592186614748}] :answer-field/correct {:db/id #edb/ref 17592186614748} :answer-field/id #uuid "0e654def-f45b-5448-a558-d0aafef927a5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186615207}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "06632100-a7a1-5d47-9549-7f654f194e12" :question/math-academy-id "q-128199" :question/problem "Find the solution to the initial value problem \n\n$$\n{y}^{′}=\\frac{x}{y},\\,y(0)=1.\n$$\n\n$y(x)=\\,\\,$ \n{{field-1}}" :question/worked-solution "From part 6, we found the general solution\n\n$$\n\\begin{aligned}y & =\\pm \\sqrt{{x}^{2}+K},\\end{aligned}\n$$\n\nwhere $K$ is an arbitrary constant.\n\nNow, we apply the initial condition $y(0)=1$ to find $K.$ Since $y(0)=1>0,$ we choose the solution with the positive sign:\n\n$$\n\\begin{aligned}y(0) & =1 \\\\ \\sqrt{{0}^{2}+K} & =1 \\\\ \\sqrt{K} & =1 \\\\ K & =1\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is\n\n$$\ny=\\sqrt{{x}^{2}+1}.\n$$"}] [{:db/id #edb/ref 17592186615371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "393e078f-2170-534f-840a-7765e6ea3c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡2y=2x+1" :db/id #edb/ref 17592186614831} {:answer/id #uuid "417f7b3d-d9b2-5a87-a659-b78b4e8233b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡y=2x" :db/id #edb/ref 17592186614847} {:answer/id #uuid "4dc55273-390a-51d5-8e7a-648a1fb4057e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2y=x" :db/id #edb/ref 17592186614871} {:answer/id #uuid "8712381e-1cb5-530e-a116-71641a5ef31e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡y=x" :db/id #edb/ref 17592186614974} {:answer/id #uuid "d408f613-cbb1-55b7-b03f-183a5101fc73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡y=x+1" :db/id #edb/ref 17592186615118}] :answer-field/correct {:db/id #edb/ref 17592186614974} :answer-field/id #uuid "a42c0b25-a242-5a87-81a2-6dd27ac3d6eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186615297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "116ef790-d071-544d-9c70-f53a1e2cf0f3" :question/math-academy-id "q-50568" :question/problem "Find the particular solution to the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{\\operatorname{cos}⁡y}\n$$ that satisfies $y(0)=0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{\\operatorname{cos}⁡y} \\\\ \\operatorname{cos}⁡y\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\int \\operatorname{cos}⁡y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\operatorname{cos}⁡y\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{sin}⁡y & =x+C.\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=0$ to find $C:$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡0 & =0+C \\\\ 0 & =0+C \\\\ C & =0\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n\\operatorname{sin}⁡y=x\n$$"}] [{:db/id #edb/ref 17592186615416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed35dbe5-d4a9-5d5d-bbba-3fff8ca5c4bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x^2" :db/id #edb/ref 17592186615164}] :answer-field/correct {:db/id #edb/ref 17592186615164} :answer-field/id #uuid "461fab47-fcfa-589d-85e8-c322bc51c476" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186615239}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8363d7a8-d552-504e-a21c-ebf886d548c2" :question/math-academy-id "q-128198" :question/problem "Find the general solution to the differential equation ${y}^{′}=\\frac{x}{y},$ given that $K$ is an arbitrary constant.\n\n$y=\\pm ($ \n{{field-1}}$+K)^{1/2}$" :question/worked-solution "First, we separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x}{y} \\\\ y\\cdot \\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nNext, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int y\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int x\\,\\text{d}x \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+C\\end{aligned}\n$$\n\nFinally, we solve for $y.$ This gives\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+C \\\\ {y}^{2} & ={x}^{2}+2C \\\\ {y}^{2} & ={x}^{2}+K \\\\ y & =\\pm \\sqrt{{x}^{2}+K} \\\\ y & =\\pm ({x}^{2}+K)^{1/2},\\end{aligned}\n$$\n\nwhere $K=2C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186616327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c59ab1b-f4c8-5a75-87e4-20893cd4b044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24(-9-4x)^{5}" :db/id #edb/ref 17592186616326}] :answer-field/correct {:db/id #edb/ref 17592186616326} :answer-field/id #uuid "63b9c5d6-db2e-54e6-84b8-bf2a0320e4db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186616328}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "57a6783a-fc39-5ef5-8a1c-628f352f4ad2" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-9-4x)^{6}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-9-4x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(-9-4x)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186616329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7bf8b1-ff38-5f11-bbcc-50fa3c64315d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12(3 x - 2)^{3}" :db/id #edb/ref 17592186616322} {:answer/id #uuid "3b7d9b20-6c95-5ef1-9f2f-5d156d52e4b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21(3 x - 2)^{2}" :db/id #edb/ref 17592186616324} {:answer/id #uuid "44ea5da8-041a-5e5b-99cd-1fb7c91c60e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28(3 x - 2)^{3}" :db/id #edb/ref 17592186616325} {:answer/id #uuid "d3b17d71-4b32-5a53-8943-d88edbe9e11a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9(3 x - 2)^{2}" :db/id #edb/ref 17592186616330} {:answer/id #uuid "d5a8f75a-30e8-5ac1-8c2d-9aeb2e7e764a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(3 x - 2)^{2}" :db/id #edb/ref 17592186616331}] :answer-field/correct {:db/id #edb/ref 17592186616330} :answer-field/id #uuid "298df8c1-b7b3-5697-9024-df99fb83258d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186616323}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a831160d-bd79-52f7-b589-31b6792f7366" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 x - 2)^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{3},\\,g=3 x - 2\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3g^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=3g^{2}\\cdot (3) \\\\  &=9(3 x - 2)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186617845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de48994-427c-519d-aa76-f53aecd9f00d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2t" :db/id #edb/ref 17592186617277}] :answer-field/correct {:db/id #edb/ref 17592186617277} :answer-field/id #uuid "697d83b8-cc1b-5fa5-82b6-d02f8194e336" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186617702}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b5785d45-e79c-5188-8c0a-65a380b832ea" :question/math-academy-id "q-168070" :question/problem "Find the general solution to the differential equation in part 1 for $s\\ne 0.$\n\n$s\\,=\\,($\n{{field-1}}$+K)^{-1}$\n$\\,\\,$where $K$ is an arbitrary constant." :question/worked-solution "To find the general solution, we separate variables and integrate both sides with respect to $t,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}s}{\\text{d}t} & =2{s}^{2} \\\\ \\frac{1}{{s}^{2}}\\cdot \\frac{\\text{d}s}{\\text{d}t} & =2 \\\\ \\int \\frac{1}{{s}^{2}}\\cdot \\frac{\\text{d}s}{\\text{d}t}\\,\\text{d}t & =\\int 2\\,\\text{d}t \\\\ \\int \\frac{\\text{d}s}{{s}^{2}} & =2\\int \\,\\text{d}t \\\\ -\\frac{1}{s} & =2t+C.\\end{aligned}\n$$\n\nThis is a perfectly valid general solution. However, if we want to write $s=s(t)$ explicitly, then we can solve for $s.$ This gives\n\n$$\n\\begin{aligned}-\\frac{1}{s} & =2t+C \\\\ s & =-\\frac{1}{2t+C} \\\\ s & =\\frac{1}{-2t+K} \\\\ s & =(-2t+K)^{-1}\\end{aligned}\n$$\n\nwhere $K=-C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186617850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6bae5a9-13f3-5846-83ad-b2dd61f294cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{1-2t}" :db/id #edb/ref 17592186617634}] :answer-field/correct {:db/id #edb/ref 17592186617634} :answer-field/id #uuid "b3214e1e-7be4-53ce-b26f-cc9bdc3883b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186617735}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c2e10c0c-3de3-537c-b528-8a51a1cc8527" :question/math-academy-id "q-168071" :question/problem "Let $\\widehat{s}(t)$ be a particular solution of the differential equation from the previous part that satisfies the condition $\\widehat{s}(0)=1.$ Find $\\widehat{s}(t).$\n\n$\\widehat{s}(t)\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that the general solution is\n\n$$\ns=\\frac{1}{-2t+K}.\n$$\n\nwhere $K$ is an arbitrary constant.\n\nWe now apply the condition $s(0)=1$ to find $K:$\n\n$$\n\\begin{aligned}s & =\\frac{1}{-2t+K} \\\\ 1 & =\\frac{1}{-2(0)+K} \\\\ 1 & =\\frac{1}{K} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the required particular solution is\n\n$$\n\\widehat{s}(t)=\\frac{1}{1-2t}.\n$$"}]}
