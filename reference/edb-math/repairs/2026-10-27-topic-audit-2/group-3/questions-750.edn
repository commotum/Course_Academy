#{[{:db/id #edb/ref 17592186618742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129bead9-eaf6-5d30-863b-7d6939381b01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5\\operatorname{cos}⁡x+C{x}^{2}+D" :db/id #edb/ref 17592186618232} {:answer/id #uuid "9c77c957-f195-59b6-a8ff-8106d2793457" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=5\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186618432} {:answer/id #uuid "b03879d5-af5f-5c04-a523-6383dc1471e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186618470} {:answer/id #uuid "d8a52c27-6310-557b-99cf-256eab6e85da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5\\operatorname{cos}⁡x+C{x}^{2}+D" :db/id #edb/ref 17592186618532} {:answer/id #uuid "de50dcc8-0d47-5479-8dfb-c0cb3681297d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186618540}] :answer-field/correct {:db/id #edb/ref 17592186618470} :answer-field/id #uuid "8e6c64b6-2714-5246-9c33-55457cf0e1f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186618650}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4323b87b-7f2c-55f8-b7fd-23f912219d74" :question/math-academy-id "q-79557" :question/problem "Solve the differential equation \n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=5\\operatorname{cos}⁡x.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int 5\\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =5\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (5\\operatorname{sin}⁡x+C)\\,\\text{d}x \\\\ y & =-5\\operatorname{cos}⁡x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186618749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19291e33-5cf0-5ca2-8dff-bd1968ab1d22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{x}^{3}}{3}+C{x}^{2}+D" :db/id #edb/ref 17592186618245} {:answer/id #uuid "2fa9202e-f823-5935-9800-09449db547c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{8{x}^{3}}{3}+Cx+D" :db/id #edb/ref 17592186618285} {:answer/id #uuid "501c3af9-271e-588d-9494-899c17208484" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{x}^{3}}{3}+Cx+D" :db/id #edb/ref 17592186618327} {:answer/id #uuid "8abac270-d8da-5315-bae2-765c92693951" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4{x}^{3}}{3}+Cx+D" :db/id #edb/ref 17592186618407} {:answer/id #uuid "e906de34-5eca-57fd-8fd9-718f250aea03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4{x}^{3}}{3}+C{x}^{2}+D" :db/id #edb/ref 17592186618556}] :answer-field/correct {:db/id #edb/ref 17592186618407} :answer-field/id #uuid "dec04a18-808a-5dd4-8e51-9512cdaca3f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186618695}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4dadb5b5-ba2c-5b31-b2ae-24f80b511754" :question/math-academy-id "q-79556" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8x.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8\\cdot \\frac{{x}^{2}}{2}\\,\\text{d}x \\\\  & =4{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (4{x}^{2}+C)\\text{d}x \\\\ y & =4\\cdot \\frac{{x}^{3}}{3}+Cx+D \\\\  & =\\frac{4{x}^{3}}{3}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186619918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d3a3a1-004c-54b9-8f85-cb06fd5509ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=8 x + \\frac{8 e^{- 3 x}}{3}+C" :db/id #edb/ref 17592186619904} {:answer/id #uuid "1a1e6fdc-958b-5e7e-aa01-64f42d076610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=8 x - 2 e^{- 3 x}+C" :db/id #edb/ref 17592186619905} {:answer/id #uuid "4a02d050-464f-524b-9b32-3b9882466224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- 6 x + \\frac{4 e^{- 3 x}}{3}+C" :db/id #edb/ref 17592186619916} {:answer/id #uuid "84c2c7c3-e0df-5fe7-a560-ceefc81888fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- 6 x - 2 e^{- 3 x}+C" :db/id #edb/ref 17592186619924} {:answer/id #uuid "e671928a-32ca-5a57-ae4f-90c9444fd30f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- 6 x + \\frac{8 e^{- 3 x}}{3}+C" :db/id #edb/ref 17592186619934}] :answer-field/correct {:db/id #edb/ref 17592186619905} :answer-field/id #uuid "22165752-d530-55ce-88e6-cf5ddb7e6e9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619907}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4c26c0d4-585b-53f6-bd69-a5ea3f1bfa3c" :question/problem "Find the general solution to the differential equation $f'(x)- 6 e^{- 3 x}=8.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=8+6 e^{- 3 x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\mathrm{d}x &=\\int \\left(8+6 e^{- 3 x}\\right)\\,\\mathrm{d}x \\\\ f(x) &=8\\int 1\\,\\mathrm{d}x+6\\int e^{- 3 x}\\,\\mathrm{d}x \\\\ &=8\\left(x\\right)+6\\left(- \\frac{e^{- 3 x}}{3}\\right)+C \\\\ &=8 x - 2 e^{- 3 x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123ae7a6-46ff-570e-bdf0-a91588318d11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2 \\sin{\\left(x \\right)}+C" :db/id #edb/ref 17592186619903} {:answer/id #uuid "29c0e449-f972-5e9a-8c18-33b3956569c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\sin{\\left(x \\right)}+C" :db/id #edb/ref 17592186619909} {:answer/id #uuid "42d6c467-c63e-5d2a-8cc5-a64ad9174a08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{4 \\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619914} {:answer/id #uuid "c82be6b7-848c-590f-9242-f78b210cc71d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{4 \\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619931} {:answer/id #uuid "d0abb02f-1e65-5cad-97fe-e2eedd9dedae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\sin{\\left(x \\right)}+C" :db/id #edb/ref 17592186619933}] :answer-field/correct {:db/id #edb/ref 17592186619914} :answer-field/id #uuid "1eceb581-6aec-546d-9576-f0a399c0725c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619906}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "696e3824-50d8-5a03-88af-92a2a9f44e38" :question/problem "Solve the differential equation $3f'(x)+4 \\cos{\\left(x \\right)}=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- \\frac{4 \\cos{\\left(x \\right)}}{3}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\mathrm{d}x &=\\int \\left(- \\frac{4 \\cos{\\left(x \\right)}}{3}\\right)\\,\\mathrm{d}x \\\\ f(x) &=- \\frac{4}{3}\\int \\cos{\\left(x \\right)}\\,\\mathrm{d}x \\\\ &=- \\frac{4}{3}\\left(\\sin{\\left(x \\right)}\\right)+C \\\\ &=- \\frac{4 \\sin{\\left(x \\right)}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ec01e40-7715-56df-8113-d562e3789845" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{\\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619913} {:answer/id #uuid "93f9cc5a-b2ee-5405-bdf7-6c086d5975a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{8 \\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619927} {:answer/id #uuid "a9a15b3f-2f36-56fd-a293-91195c26456b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{4 \\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619929} {:answer/id #uuid "cae0f19b-4f4f-55ab-b915-07d77bf262c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\sin{\\left(x \\right)}+C" :db/id #edb/ref 17592186619932} {:answer/id #uuid "f2711ca2-fd70-5e51-99d1-ad6a4ec24bbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{8 \\sin{\\left(x \\right)}}{3}+C" :db/id #edb/ref 17592186619936}] :answer-field/correct {:db/id #edb/ref 17592186619927} :answer-field/id #uuid "6d640786-5e86-57b5-9a0f-b96ab332b610" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "70cf77e1-f297-5983-8888-28dd0a199185" :question/problem "Solve the differential equation $3f'(x)+8 \\cos{\\left(x \\right)}=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- \\frac{8 \\cos{\\left(x \\right)}}{3}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\mathrm{d}x &=\\int \\left(- \\frac{8 \\cos{\\left(x \\right)}}{3}\\right)\\,\\mathrm{d}x \\\\ f(x) &=- \\frac{8}{3}\\int \\cos{\\left(x \\right)}\\,\\mathrm{d}x \\\\ &=- \\frac{8}{3}\\left(\\sin{\\left(x \\right)}\\right)+C \\\\ &=- \\frac{8 \\sin{\\left(x \\right)}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca0577e-49b5-59dc-8d98-ecb968d7eb2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{2 x^{2} \\left(4 x - 3\\right)}{3}+C" :db/id #edb/ref 17592186619911} {:answer/id #uuid "4be9c165-5e56-51dd-ac97-55c2c7dcdb29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{2 x^{2} \\left(2 x + 3\\right)}{3}+C" :db/id #edb/ref 17592186619917} {:answer/id #uuid "8a10e91e-25c7-56fe-93f0-763ff2ad06c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{x^{2} \\left(8 x + 3\\right)}{6}+C" :db/id #edb/ref 17592186619926} {:answer/id #uuid "979d558a-53e2-5c91-9a6a-b9295184e93c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{x^{2} \\left(16 x + 3\\right)}{6}+C" :db/id #edb/ref 17592186619928} {:answer/id #uuid "ea7b235b-aab3-583b-a597-967ed3ca187a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{x^{2} \\left(16 x - 3\\right)}{6}+C" :db/id #edb/ref 17592186619935}] :answer-field/correct {:db/id #edb/ref 17592186619917} :answer-field/id #uuid "f32d483c-23fd-570d-8a5d-86794988dd94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619937}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8411719e-2d1d-5f86-bd9d-8937fa6e31c3" :question/problem "Find the general solution to the differential equation $f'(x)- 4 x^{2}=4 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=4 x+4 x^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\mathrm{d}x &=\\int \\left(4 x+4 x^{2}\\right)\\,\\mathrm{d}x \\\\ f(x) &=4\\int x\\,\\mathrm{d}x+4\\int x^{2}\\,\\mathrm{d}x \\\\ &=4\\left(\\frac{x^{2}}{2}\\right)+4\\left(\\frac{x^{3}}{3}\\right)+C \\\\ &=\\frac{4 x^{3}}{3} + 2 x^{2}+C \\\\ &=\\frac{2 x^{2} \\left(2 x + 3\\right)}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186619925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "307ceb05-be7c-5e29-b986-24c83dab2c97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{x^{2} \\left(2 x - 9\\right)}{3}+C" :db/id #edb/ref 17592186619910} {:answer/id #uuid "3d7511e9-70a8-5d9e-a5cc-f1725f8bf63e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- \\frac{x^{2} \\left(4 x + 1\\right)}{2}+C" :db/id #edb/ref 17592186619912} {:answer/id #uuid "493f11e3-1896-57bc-82ea-de68d352cd38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=- x^{2} \\left(2 x + 3\\right)+C" :db/id #edb/ref 17592186619915} {:answer/id #uuid "7d89fe69-9a79-50de-8b79-4e0b20d1ccd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{x^{2} \\left(16 x - 3\\right)}{6}+C" :db/id #edb/ref 17592186619922} {:answer/id #uuid "bf7f54c8-3d09-5d75-853a-0099924e6013" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{x^{2} \\left(8 x - 9\\right)}{3}+C" :db/id #edb/ref 17592186619930}] :answer-field/correct {:db/id #edb/ref 17592186619930} :answer-field/id #uuid "244fff69-4fdb-5147-92c2-965ca96081d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186619908}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "896573e6-451d-5682-963e-fbb01e7e8e35" :question/problem "Find the general solution to the differential equation $f'(x)- 8 x^{2}=- 6 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- 6 x+8 x^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\mathrm{d}x &=\\int \\left(- 6 x+8 x^{2}\\right)\\,\\mathrm{d}x \\\\ f(x) &=-6\\int x\\,\\mathrm{d}x+8\\int x^{2}\\,\\mathrm{d}x \\\\ &=-6\\left(\\frac{x^{2}}{2}\\right)+8\\left(\\frac{x^{3}}{3}\\right)+C \\\\ &=\\frac{8 x^{3}}{3} - 3 x^{2}+C \\\\ &=\\frac{x^{2} \\left(8 x - 9\\right)}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186620984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271409d5-4217-5c85-b07c-9e0df003989b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186620978} {:answer/id #uuid "362293ce-6960-5bec-bd1d-91d950c62c55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186620979} {:answer/id #uuid "5442b9e8-2d41-5f44-aa1b-5bf84a779714" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-64" :db/id #edb/ref 17592186620980} {:answer/id #uuid "9e1008cf-16e7-59e5-9723-0377df844c92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186620982} {:answer/id #uuid "cf9bd0de-8993-53c8-b29e-a2a030396acb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186620983}] :answer-field/correct {:db/id #edb/ref 17592186620982} :answer-field/id #uuid "8826ac9f-6e72-51e7-9d14-5ca172f0524c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186620981}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f96934b1-b807-5be7-b577-eeccabeded8d" :question/problem "Given that $f(x)=(2 x^{2} - 3)^{4},$ find the slope at the point $(1,1)$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=2 x^{2} - 3\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=4 x.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (4 x) \\\\  &=16 x(2 x^{2} - 3)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[16 x(2 x^{2} - 3)^{3}]|_{x=1} \\\\  &=16 (1)(2 (1)^{2} - 3)^{3} \\\\  &=-16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186623673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3aa684e-0c6b-5d69-a653-42d133bba623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3t" :db/id #edb/ref 17592186623459}] :answer-field/correct {:db/id #edb/ref 17592186623459} :answer-field/id #uuid "e2200e8c-e0ce-5195-bdce-39c5e7c37cf0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186623609}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b071164a-d7dc-50ad-9600-bbe303de9fa0" :question/math-academy-id "q-168084" :question/problem "Find the general solution to the differential equation in part 1.\n\n$p\\,=\\operatorname{ln}⁡(\\,$\n{{field-1}}$+C)$\n$\\,\\,$where $C$ is an arbitrary positive constant." :question/worked-solution "To find the general solution, we separate variables and integrate both sides with respect to $t,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}p}{\\text{d}t} & =\\frac{3}{{e}^{p}} \\\\ {e}^{p}\\cdot \\frac{\\text{d}p}{\\text{d}t} & =3 \\\\ \\int {e}^{p}\\cdot \\frac{\\text{d}p}{\\text{d}t}\\,\\text{d}t & =\\int 3\\,\\text{d}t \\\\ \\int {e}^{p}\\text{d}p & =3\\int \\,\\text{d}t \\\\ {e}^{p} & =3t+C.\\end{aligned}\n$$\n\nThis is a perfectly valid general solution. However, if we want to write $p=p(t)$ explicitly, then we can solve for $p.$ This gives\n\n$$\n\\begin{aligned}{e}^{p} & =3t+C \\\\ p & =\\operatorname{ln}⁡(3t+C)\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary positive constant."}] [{:db/id #edb/ref 17592186623700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352c5c4f-74f8-548b-8eb0-123f93f32aae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln(3t+1)" :db/id #edb/ref 17592186623254}] :answer-field/correct {:db/id #edb/ref 17592186623254} :answer-field/id #uuid "3710e2a1-85de-5721-96b9-8c206877637c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186623543}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fda6dc54-f248-5a6c-bbc8-84150c60dcca" :question/math-academy-id "q-168085" :question/problem "Let $\\widehat{p}(t)$ be a particular solution of the differential equation from the previous part that satisfies the condition $\\widehat{p}(0)=0.$ Find $\\widehat{p}(t).$\n\n$\\widehat{p}(t)\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that the general solution is\n\n$$\np=\\operatorname{ln}⁡(3t+C).\n$$\n\nwhere $C$ is an arbitrary positive constant.\n\nWe now apply the condition $p(0)=0$ to find $C:$\n\n$$\n\\begin{aligned}0 & =\\operatorname{ln}⁡(3(0)+C) \\\\ 0 & =\\operatorname{ln}⁡(C) \\\\ {e}^{0} & =C \\\\ C & =1\\end{aligned}\n$$\n\nThus, the required particular solution is\n\n$$\n\\widehat{p}(t)=\\operatorname{ln}⁡(3t+1).\n$$"}] [{:db/id #edb/ref 17592186639398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1717eb14-929b-51d4-b280-496f6b7e4ce1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D - \\frac{7 \\cos{\\left(2 x \\right)}}{4}" :db/id #edb/ref 17592186639389} {:answer/id #uuid "63613469-6cff-5d3f-8c0d-61695625befc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D x - \\cos{\\left(2 x \\right)}" :db/id #edb/ref 17592186639399} {:answer/id #uuid "65f0892d-e481-50ff-adac-4bb52dacb1c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{3 \\cos{\\left(2 x \\right)}}{2}" :db/id #edb/ref 17592186639400} {:answer/id #uuid "c79be15d-75dc-55ef-be7c-0bca2e0e0a5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\cos{\\left(2 x \\right)}" :db/id #edb/ref 17592186639413} {:answer/id #uuid "ec1e0817-758e-548e-9b70-cff1f6d3683c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{7 \\cos{\\left(2 x \\right)}}{4}" :db/id #edb/ref 17592186639419}] :answer-field/correct {:db/id #edb/ref 17592186639419} :answer-field/id #uuid "49d0b6e8-7c91-5731-9b58-19933964ac2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186639397}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "607b2dbd-082f-5f8c-82b8-b77fac7ab983" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=7 \\cos{\\left(2 x \\right)}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int 7 \\cos{\\left(2 x \\right)}\\,\\text{d}x \\\\  & =7\\int \\cos{\\left(2 x \\right)}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =7\\left(\\frac{\\sin{\\left(2 x \\right)}}{2}\\right)+C \\\\  & =C + \\frac{7 \\sin{\\left(2 x \\right)}}{2}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C + \\frac{7 \\sin{\\left(2 x \\right)}}{2}\\right)\\,\\text{d}x \\\\ y & =\\frac{7}{2}\\int \\sin{\\left(2 x \\right)}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =\\frac{7}{2}\\left(- \\frac{\\cos{\\left(2 x \\right)}}{2}\\right)+Cx+D \\\\  & =C x + D - \\frac{7 \\cos{\\left(2 x \\right)}}{4}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186639409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b56b397-99f3-57cf-bc12-72d3e76bf7ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{7 \\sin{\\left(3 x \\right)}}{9}" :db/id #edb/ref 17592186639387} {:answer/id #uuid "7890acd5-0cc9-56ad-86f0-a210a261677e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=D - \\frac{2 \\sin{\\left(3 x \\right)}}{9}" :db/id #edb/ref 17592186639403} {:answer/id #uuid "8e1638bb-0fb1-5e30-a6c7-95a7f35efe55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{2 \\sin{\\left(3 x \\right)}}{9}" :db/id #edb/ref 17592186639404} {:answer/id #uuid "9561b78f-6792-5f52-828e-ed07f2a4c3d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{\\sin{\\left(3 x \\right)}}{9}" :db/id #edb/ref 17592186639406} {:answer/id #uuid "9eba6100-b0ae-507c-ad0f-758eb6c1bbfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + \\frac{7 \\sin{\\left(3 x \\right)}}{9}" :db/id #edb/ref 17592186639408}] :answer-field/correct {:db/id #edb/ref 17592186639406} :answer-field/id #uuid "680428fe-40e4-561d-b629-683c1ff5ad86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186639402}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a537d5f6-6036-5888-bee0-4764e826a47d" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\sin{\\left(3 x \\right)}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\sin{\\left(3 x \\right)}\\,\\text{d}x \\\\  & =\\int \\sin{\\left(3 x \\right)}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\left(- \\frac{\\cos{\\left(3 x \\right)}}{3}\\right)+C \\\\  & =C - \\frac{\\cos{\\left(3 x \\right)}}{3}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C - \\frac{\\cos{\\left(3 x \\right)}}{3}\\right)\\,\\text{d}x \\\\ y & =- \\frac{1}{3}\\int \\cos{\\left(3 x \\right)}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =- \\frac{1}{3}\\left(\\frac{\\sin{\\left(3 x \\right)}}{3}\\right)+Cx+D \\\\  & =C x + D - \\frac{\\sin{\\left(3 x \\right)}}{9}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186639410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8ee4ad-283b-5789-b67b-1c4243e3bd46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{4 e^{- 3 x}}{9}" :db/id #edb/ref 17592186639393} {:answer/id #uuid "66b24681-c8ed-58da-bab8-a024ba715004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{5 e^{- 3 x}}{9}" :db/id #edb/ref 17592186639401} {:answer/id #uuid "94ae3533-90a6-568b-ae5b-373ff2b97bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x - \\frac{4 e^{- 3 x}}{9}" :db/id #edb/ref 17592186639405} {:answer/id #uuid "974f9a31-0c2c-533e-9298-e8d07cbde575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{2 e^{- 3 x}}{9}" :db/id #edb/ref 17592186639407} {:answer/id #uuid "dab1cc16-fe1d-5cec-9327-84fbb575bfe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=D + \\frac{2 e^{- 3 x}}{9}" :db/id #edb/ref 17592186639415}] :answer-field/correct {:db/id #edb/ref 17592186639393} :answer-field/id #uuid "2a8edfb8-6efc-5830-b532-4c5bbb08df8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186639392}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9a2d330-3b6a-5d95-907b-4dbb2906c00d" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=- 4 e^{- 3 x}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int - 4 e^{- 3 x}\\,\\text{d}x \\\\  & =-4\\int e^{- 3 x}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-4\\left(- \\frac{e^{- 3 x}}{3}\\right)+C \\\\  & =C + \\frac{4 e^{- 3 x}}{3}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C + \\frac{4 e^{- 3 x}}{3}\\right)\\,\\text{d}x \\\\ y & =\\frac{4}{3}\\int e^{- 3 x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =\\frac{4}{3}\\left(- \\frac{e^{- 3 x}}{3}\\right)+Cx+D \\\\  & =C x + D - \\frac{4 e^{- 3 x}}{9}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186639412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17725ba8-12ea-5e94-872b-4ea829490b18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D - \\frac{\\cos{\\left(2 x \\right)}}{2}" :db/id #edb/ref 17592186639390} {:answer/id #uuid "263770d8-c6e0-5b59-ba33-56a3beeefc3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - 2 \\cos{\\left(2 x \\right)}" :db/id #edb/ref 17592186639391} {:answer/id #uuid "31f2221f-da20-5f13-97f1-c04ac11e6b0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D x - \\frac{7 \\cos{\\left(2 x \\right)}}{4}" :db/id #edb/ref 17592186639395} {:answer/id #uuid "dabef250-c7b0-5195-90d5-131c4e3d1275" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{\\cos{\\left(2 x \\right)}}{2}" :db/id #edb/ref 17592186639416} {:answer/id #uuid "e2a80c4d-6e2b-5b40-b294-ac46682f2610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{7 \\cos{\\left(2 x \\right)}}{4}" :db/id #edb/ref 17592186639418}] :answer-field/correct {:db/id #edb/ref 17592186639391} :answer-field/id #uuid "2d6a1d79-6dc7-5272-b25d-35ed4aacfffb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186639394}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c33b8888-a818-571d-9155-2f9e05a27bf0" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8 \\cos{\\left(2 x \\right)}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int 8 \\cos{\\left(2 x \\right)}\\,\\text{d}x \\\\  & =8\\int \\cos{\\left(2 x \\right)}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8\\left(\\frac{\\sin{\\left(2 x \\right)}}{2}\\right)+C \\\\  & =C + 4 \\sin{\\left(2 x \\right)}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C + 4 \\sin{\\left(2 x \\right)}\\right)\\,\\text{d}x \\\\ y & =4\\int \\sin{\\left(2 x \\right)}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =4\\left(- \\frac{\\cos{\\left(2 x \\right)}}{2}\\right)+Cx+D \\\\  & =C x + D - 2 \\cos{\\left(2 x \\right)}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186639420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4c4927-c85d-53eb-b574-90fe318bcb8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{2 e^{3 x}}{9}" :db/id #edb/ref 17592186639388} {:answer/id #uuid "3edb2b07-88aa-5519-a134-4b50a328dee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{7 e^{3 x}}{9}" :db/id #edb/ref 17592186639396} {:answer/id #uuid "c0293b53-f421-5262-adba-385f85f4c17f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{2 e^{3 x}}{9}" :db/id #edb/ref 17592186639411} {:answer/id #uuid "ca07a7e3-6dae-5afc-9269-8276d12c6c34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D x + \\frac{7 e^{3 x}}{9}" :db/id #edb/ref 17592186639414} {:answer/id #uuid "f9ea149b-f81e-5925-875e-a9bd320f47bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D - \\frac{2 e^{3 x}}{9}" :db/id #edb/ref 17592186639421}] :answer-field/correct {:db/id #edb/ref 17592186639388} :answer-field/id #uuid "e0947d2d-9e25-5edc-927b-8abcbd92287e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186639417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4c6464d-1bb9-5ae4-b67f-86e47e05ffde" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=- 2 e^{3 x}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int - 2 e^{3 x}\\,\\text{d}x \\\\  & =-2\\int e^{3 x}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-2\\left(\\frac{e^{3 x}}{3}\\right)+C \\\\  & =C - \\frac{2 e^{3 x}}{3}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C - \\frac{2 e^{3 x}}{3}\\right)\\,\\text{d}x \\\\ y & =- \\frac{2}{3}\\int e^{3 x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =- \\frac{2}{3}\\left(\\frac{e^{3 x}}{3}\\right)+Cx+D \\\\  & =C x + D - \\frac{2 e^{3 x}}{9}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186640738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d42376-2a67-5205-bc31-6029158d622c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4x^{2}}{121}+\\frac{y^{2}}{4}" :db/id #edb/ref 17592186640346}] :answer-field/correct {:db/id #edb/ref 17592186640346} :answer-field/id #uuid "ebba8b17-515a-5650-ae77-45e9d1280e10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186640721}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3105dab3-bbf2-5f61-bf47-d3d107d36609" :question/math-academy-id "q-277920" :question/problem "![](images/6b/6b511e6494fc9f5ec653321f29ae2628c48222ef42f591f4ce39a36c60948481.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=\\frac{11}{2}$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{\\left(\\frac{11}{2}\\right)}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{\\left(\\frac{121}{4}\\right)}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{121}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186640982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d17d31e-0a00-5b11-92de-ef3fc221297c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{x^{3}}{2} + 8 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186640980} {:answer/id #uuid "71a16978-6834-5266-b21e-e6914459753d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + \\frac{x^{3}}{2} + 8 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186640983} {:answer/id #uuid "e19dc7a8-3b81-57cc-8ad5-ddd8ae62b851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - x^{3} + 8 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186640989} {:answer/id #uuid "eae0338a-7be1-509d-9345-bc30cb400967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=D + \\frac{x^{3}}{2} + 16 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186640990} {:answer/id #uuid "eae2993f-0296-524d-b19f-1cf9d05c3cbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{x^{3}}{2} + 16 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186640991}] :answer-field/correct {:db/id #edb/ref 17592186640989} :answer-field/id #uuid "a010bbb6-618e-531f-8e4c-0abcdcd0148b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186640985}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5021eefe-22b9-5410-b2da-7d98a574ffff" :question/problem "Solve the differential equation\n\n$$\n2\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\left(4 e^{- \\frac{x}{2}}\\right)=- 12 x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=- 6 x + 2 e^{- \\frac{x}{2}}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\left(- 6 x + 2 e^{- \\frac{x}{2}}\\right)\\,\\text{d}x \\\\  & =-6\\int x\\,\\text{d}x + 2\\int e^{- \\frac{x}{2}}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-6\\left(\\frac{x^{2}}{2}\\right) + 2\\left(- 2 e^{- \\frac{x}{2}}\\right)+C \\\\  & =C - 3 x^{2} - 4 e^{- \\frac{x}{2}}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C - 3 x^{2} - 4 e^{- \\frac{x}{2}}\\right)\\,\\text{d}x \\\\ y & =-3\\int x^{2}\\,\\text{d}x - 4\\int e^{- \\frac{x}{2}}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =-3\\left(\\frac{x^{3}}{3}\\right) - 4\\left(- 2 e^{- \\frac{x}{2}}\\right)+Cx+D \\\\  & =C x + D - x^{3} + 8 e^{- \\frac{x}{2}}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186640984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7853e6-d994-55dd-94a4-2e36615f64c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{2 x^{3}}{3} - 2 x^{2}" :db/id #edb/ref 17592186640979} {:answer/id #uuid "293b02e3-93fb-5886-b2a0-9d2e2716226f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - \\frac{2 x^{3}}{3} + 4 x^{2}" :db/id #edb/ref 17592186640981} {:answer/id #uuid "a12fba02-b6c1-5792-883c-e53f6e8e1946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D x + \\frac{x^{3}}{2} + 4 x^{2}" :db/id #edb/ref 17592186640986} {:answer/id #uuid "b8e3147f-c314-5dcb-9411-4ea0291515ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x^{2} + D - \\frac{2 x^{3}}{3} - 2 x^{2}" :db/id #edb/ref 17592186640987} {:answer/id #uuid "dc810d8c-0e4c-5422-8864-431eff6194d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + \\frac{x^{3}}{2} + 4 x^{2}" :db/id #edb/ref 17592186640988}] :answer-field/correct {:db/id #edb/ref 17592186640988} :answer-field/id #uuid "ff629e50-4523-5c1b-979b-fc27cea927d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186640992}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "92c1437b-9aa3-5e24-8e32-d82e89cc5fc8" :question/problem "Solve the differential equation\n\n$$\nx\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=3 x^{2} + 8 x.\n$$\n\nWork on a connected interval with $x\\ne0.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=3 x + 8.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\left(3 x + 8\\right)\\,\\text{d}x \\\\  & =8\\int 1\\,\\text{d}x + 3\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8\\left(x\\right) + 3\\left(\\frac{x^{2}}{2}\\right)+C \\\\  & =C + \\frac{3 x^{2}}{2} + 8 x.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C + \\frac{3 x^{2}}{2} + 8 x\\right)\\,\\text{d}x \\\\ y & =8\\int x\\,\\text{d}x + \\frac{3}{2}\\int x^{2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =8\\left(\\frac{x^{2}}{2}\\right) + \\frac{3}{2}\\left(\\frac{x^{3}}{3}\\right)+Cx+D \\\\  & =C x + D + \\frac{x^{3}}{2} + 4 x^{2}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186641039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d15220-b3b2-523c-9f8a-b662e7f6b363" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1e/1e54b478599620e04330ee34b99c8f115be46e8b47a0ba27148c1609e261041c.png" :db/id #edb/ref 17592186641029} {:answer/id #uuid "49e78e5b-e49b-58bd-8f99-4b1acbcda43c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/66/660e9797f205b04c1763852b20a1736d4e70e254e588aeb9670de83739129af6.png" :db/id #edb/ref 17592186641036} {:answer/id #uuid "4a3f2fc0-749c-5e86-93ac-2ad94b6bc901" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0b/0bc90f9fbd2a9c67095120e65de5c2254842ff47b19061688d69dfbc3612cf6c.png" :db/id #edb/ref 17592186641037} {:answer/id #uuid "bacd9714-0886-50c4-8e85-0f03473e9e4d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4d/4d750c3acd6b15babe09b3d383759cd225e791de479c869c283cf3256b66c27c.png" :db/id #edb/ref 17592186641054} {:answer/id #uuid "cce62fda-9898-5275-a00c-f193d6e9e3fc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1d/1d92dc33db726ebe0220e8cc1c5f018724a1e42b9a6663881b9ef94120cfb2b8.png" :db/id #edb/ref 17592186641056}] :answer-field/correct {:db/id #edb/ref 17592186641056} :answer-field/id #uuid "5d339956-7f51-52ad-bd86-2592d8c347c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641041}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "57976395-8fd4-58bf-a6b8-359ec30e43a9" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=6 x^{2}$?" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (6 x^{2})\\,\\text{d}x \\\\ y & =6\\int \\left(x^{2}\\right)\\,\\text{d}x \\\\  & =6\\left(\\frac{x^{3}}{3}\\right)+C \\\\ y & =2 x^{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2$.\n\n![](images/a2/a2e576a0e839a4e2e58d1bbb475d6b609274df79d274f5bd35702c4c9bfbac13.png)"}] [{:db/id #edb/ref 17592186641048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31db1bfe-e38f-5503-b018-8ff53932ee05" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a8391b24899a73d39ddc72998d6a73e8ce528ebe20b7b18a40d8b94cfe5863d4.png" :db/id #edb/ref 17592186641030} {:answer/id #uuid "3602a658-78dc-564e-9538-5f8bfd2ebb88" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/32438d5c1f583bf0cafd97de3f175e200713a4dd1c71862d7562a0ae6b216446.png" :db/id #edb/ref 17592186641032} {:answer/id #uuid "647e92e2-5106-5a6a-9edf-524675233bef" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/93/9358dc07d1943811b345e971f2fa38d381e7a95cfda3ba5231e8c22ca31efb09.png" :db/id #edb/ref 17592186641044} {:answer/id #uuid "6782fae1-6260-5503-b584-e186fc27d8f6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4d/4ddaa010b5e57fe7e40d8efa20936293f6bf164b9e5a9b8a684b785e5f2ea193.png" :db/id #edb/ref 17592186641045} {:answer/id #uuid "f1fcd199-6c8c-5442-b374-a8355cd499aa" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/51/5134533e90e8882ab19a3246eac35dfbca1320d073d853ac036f93c981692c3e.png" :db/id #edb/ref 17592186641060}] :answer-field/correct {:db/id #edb/ref 17592186641044} :answer-field/id #uuid "4b836d72-47d0-5eab-bbad-7d4db203268e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641038}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85d7ae14-2ba9-55bb-b0ac-f4bb4c643611" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=- \\frac{e^{- \\frac{x}{4}}}{4}\n$$?" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(- \\frac{e^{- \\frac{x}{4}}}{4}\\right)\\,\\text{d}x \\\\ y & =- \\frac{1}{4}\\int e^{- \\frac{x}{4}}\\,\\text{d}x \\\\  & =- \\frac{1}{4}\\left(- 4 e^{- \\frac{x}{4}}\\right)+C \\\\ y & =e^{- \\frac{x}{4}}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2$.\n\n![](images/c6/c6fb115b5a9ba91a992d23547cfa273693d203ce6b0e557e2f851f66b656f6cf.png)"}] [{:db/id #edb/ref 17592186641049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040bc458-157a-53f2-8cdf-41afe6d03df4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e5/e5b66a9fe2f0f0a4cedfb48326718897bc791fb427a6328c31dbc5a370b0eb8d.png" :db/id #edb/ref 17592186641028} {:answer/id #uuid "44c781c8-957c-5e26-911d-7f7f17f36e0a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9c/9cbf208a1d175bd134fab3a9772cd8fb1eb865fbf153d6540eb8289492cd1f67.png" :db/id #edb/ref 17592186641034} {:answer/id #uuid "49e6bbaa-2d85-5bb6-94e9-8b61394a6755" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/19/19a4b5c2e371f53f1a6c98dfd36e5a87d8db0ee8b6ddb3375fa274d60f4a2ad8.png" :db/id #edb/ref 17592186641035} {:answer/id #uuid "d039db91-c0f7-5d5a-ac5d-b787083ccee7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/85/85e2bae695b950b4af86f7c6089bcd81f2957c9b640df5d5bc0981be7f91021f.png" :db/id #edb/ref 17592186641057} {:answer/id #uuid "f457c883-97ef-5040-8d35-288398c8814a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/20/2044b40ad3bac7ae6c0f663734bc69116f1bfd277d336cd9e1387707b358e3b6.png" :db/id #edb/ref 17592186641061}] :answer-field/correct {:db/id #edb/ref 17592186641034} :answer-field/id #uuid "5bc94680-3bff-55a4-a5dc-6ecdbf95ae76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641040}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8859f62e-80ac-56b9-850e-503888ccd1b0" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=- e^{2 x}$?" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (- e^{2 x})\\,\\text{d}x \\\\ y & =-1\\int e^{2 x}\\,\\text{d}x \\\\  & =-1\\left(\\frac{e^{2 x}}{2}\\right)+C \\\\ y & =- \\frac{e^{2 x}}{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2$.\n\n![](images/c0/c0255a3cb0280b553f6a229722cbbbd1dc9b9c200741f33579de30b4013d745c.png)"}] [{:db/id #edb/ref 17592186641052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0121e584-559b-588b-9281-4e4beefbcba8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e0/e01de98afa0e0be207e7f0afef50f5992b40ed9b0215c29069f38a225a2ab618.png" :db/id #edb/re