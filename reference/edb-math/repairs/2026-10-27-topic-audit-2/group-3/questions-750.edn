/9390549a04dbdba15a33a278f11adab95c475035e0a3ab35faded58d2bd56808.png)"}] [{:db/id #edb/ref 17592186641053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ccf2fe1-6190-5ac4-8785-fe7cfa768c27" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/9230b4e5b741b9367f56ce6331c52170e54ecb7e533865ec81c4a6e1a51cca1b.png" :db/id #edb/ref 17592186641033} {:answer/id #uuid "5e3e7b92-3aa8-5386-a127-2f838aa52ac6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/68/68e0c23ae0a3482e884f7c3bac1acda4576c48c9b69782ec316bb58bb17c70a0.png" :db/id #edb/ref 17592186641042} {:answer/id #uuid "8b3f0243-3610-56ef-a6ca-d26891053145" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c4/c40c86fc79f3f08a5793314df21027a1d4a2a538ed15675d9a1971ab8d3a7505.png" :db/id #edb/ref 17592186641050} {:answer/id #uuid "ec4f2e61-9af3-520c-80e7-a20151ac873c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/99/9949ff36b89afc73672da71c8d85fd44207c5a1493698ff2a62d3ee2307a863b.png" :db/id #edb/ref 17592186641058} {:answer/id #uuid "f1eaa1c0-43b9-56ac-9641-48c2e40e3d8d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a4/a41028d51e0c8e8b7035742590df8416a3c0cdf33eafb3dd0e11e9b334552fd5.png" :db/id #edb/ref 17592186641059}] :answer-field/correct {:db/id #edb/ref 17592186641059} :answer-field/id #uuid "60e7a856-3b8e-5ccb-8ed4-0924f47ce0bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b557c249-65db-50fb-ae95-cc00756f10e5" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{e^{\\frac{x}{2}}}{4}\n$$?" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(\\frac{e^{\\frac{x}{2}}}{4}\\right)\\,\\text{d}x \\\\ y & =\\frac{1}{4}\\int e^{\\frac{x}{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\left(2 e^{\\frac{x}{2}}\\right)+C \\\\ y & =\\frac{e^{\\frac{x}{2}}}{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2$.\n\n![](images/c1/c1af73e79e10a3ef1473f9e4bf152b49e714d7c8a5439fdfe7b18444897b0201.png)"}] [{:db/id #edb/ref 17592186641789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f95c04-048f-560a-a3b3-09b545e22f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4}{x - 1}" :db/id #edb/ref 17592186641784} {:answer/id #uuid "76d19c7d-0b1c-5b90-82c7-da9322b1322f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4 x}{x^{2} - 2 x + 1} - 3 - \\frac{4}{x - 1}" :db/id #edb/ref 17592186641793} {:answer/id #uuid "9dada226-dcc8-5237-8461-afdb5e21e89b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- \\frac{4 x}{x^{2} - 2 x + 1} + 12" :db/id #edb/ref 17592186641797} {:answer/id #uuid "be354d9d-c8d9-506c-ad4f-c13641d1107d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- \\frac{4 x}{x^{2} - 2 x + 1} + 9" :db/id #edb/ref 17592186641798} {:answer/id #uuid "cb0374a8-8b61-5d47-9b96-4e98410ad454" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3 + \\frac{4}{x - 1}" :db/id #edb/ref 17592186641799}] :answer-field/correct {:db/id #edb/ref 17592186641784} :answer-field/id #uuid "3c12e126-258d-5d49-9226-7eec5c9b7147" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641787}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52234b9b-b864-5f56-ab32-b939fd1c0bc2" :question/problem "Find the particular solution to the differential equation ${y}^{′} (x - 1)^{2}=-4$ that satisfies the condition $y(2)=4$." :question/worked-solution "First, we rearrange the equation to give\n\n$$\ny'=- \\frac{4}{x^{2} - 2 x + 1}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int y'\\,\\text{d}x & =\\int \\left(- \\frac{4}{x^{2} - 2 x + 1}\\right)\\,\\text{d}x \\\\ y & =(-4)\\int \\left(\\frac{1}{x^{2} - 2 x + 1}\\right)\\,\\text{d}x \\\\ & =(-4)\\left(- \\frac{1}{x - 1}\\right)+C \\\\ & =\\frac{4}{x - 1}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=\\frac{4}{x - 1}+C.$ To find a particular solution, we substitute the condition $y(2)=4$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}4 & =\\frac{4}{(2) - 1}+C \\\\ 4 & =4+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=\\frac{4}{x - 1}.\n$$"}] [{:db/id #edb/ref 17592186641795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f857628-f038-56fc-83a6-fa24c36f2cd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1 + \\frac{8}{x - 3}" :db/id #edb/ref 17592186641786}] :answer-field/correct {:db/id #edb/ref 17592186641786} :answer-field/id #uuid "db31a485-d87b-5316-94d3-bd21623ce0db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186641803}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9976725a-8cac-56a2-b98b-d4d969a004b4" :question/problem "Find the particular solution to the differential equation ${y}^{′} (x - 3)^{2}=-8$ that satisfies the condition $y(5)=3.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=(-1)\\cdot\\left(\\frac{8}{(x-3)^{2}}\\right).\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =(-1)\\cdot(\\int \\frac{8}{(x-3)^{2}}\\,\\text{d}x )\\\\ y & =(-1)\\cdot(8\\int \\frac{1}{(x-3)^{2}}\\,\\text{d}x )\\\\  & =(-1)\\cdot(8\\left(-\\frac{1}{x-3}\\right))+C \\\\  & =(-1)\\cdot\\left(-\\frac{8}{x-3}\\right)+C.\\end{aligned}\n$$\n\nSo our general solution is $y=(-1)\\cdot\\left(-\\frac{8}{x-3}\\right)+C.$ To find a particular solution, we substitute the condition $y(5)=3$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}3 & =\\frac{8}{(5) - 3}+C \\\\ 3 & =4+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-1 + \\frac{8}{x - 3}.\n$$"}] [{:db/id #edb/ref 17592186641796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03243027-1608-5e73-93f9-4f44bcc5befa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- 8 x^{3} - 125" :db/id #edb/ref 17592186641782} {:answer/id #uuid "06c6b782-b70f-53c7-9340-00863ff09a13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8 x^{3} + 3" :db/id #edb/ref 17592186641783} {:answer/id #uuid "3df876c1-fad6-572e-b1af-2e211ce6bc05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- 8 x^{3} - 128" :db/id #edb/ref 17592186641788} {:answer/id #uuid "727e1be5-b742-5b4e-b2e5-5cb8834b3803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-64" :db/id #edb/ref 17592186641791} {:answer/id #uuid "74279789-d795-5ee5-8f1a-8feeee0c10f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8 x^{3}" :db/id #edb/ref 17592186641792}] :answer-field/correct {:db/id #edb/ref 17592186641792} :answer-field/id #uuid "0e0fcbc6-0a43-5e99-82f5-23ab4c105060" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186641785}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b1af572-ade9-55d4-8ae9-97662ee8f53c" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $y(-2)=-64$\n \n\n$$\n\\frac{\\text{d}y}{\\text{d}x} x=24 x^{3}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=(4)\\cdot(6{x}^{2}).\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =(4)\\cdot(\\int 6{x}^{2}\\,\\text{d}x )\\\\ y & =(4)\\cdot(6\\left(\\frac{{x}^{3}}{3}\\right))+C \\\\  & =(4)\\cdot(2{x}^{3})+C.\\end{aligned}\n$$\n\nSo our general solution is $y=(4)\\cdot(2{x}^{3})+C.$ To find a particular solution, we substitute the condition $y(-2)=-64$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-64 & =8 (-2)^{3}+C \\\\ -64 & =-64+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=8 x^{3}.\n$$"}] [{:db/id #edb/ref 17592186641800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d456940a-e543-54f4-ad7b-7224f5b944ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 9 \\cos{(x )}" :db/id #edb/ref 17592186641802}] :answer-field/correct {:db/id #edb/ref 17592186641802} :answer-field/id #uuid "7fc5e9ad-f1b6-5b54-996f-d70421807723" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186641794}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cdc1aaf9-74b0-505d-b059-313017c92d3f" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x) - 9 \\sin{(x )}=0$ that satisfies the condition $f(0)=-9.$\n\n$f(x)=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=(-3)\\cdot(-3\\operatorname{sin}⁡x).\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =(-3)\\cdot(\\int (-3\\operatorname{sin}⁡x)\\,\\text{d}x )\\\\ f(x) & =(-3)\\cdot(-3\\int \\operatorname{sin}⁡x\\,\\text{d}x )\\\\  & =(-3)\\cdot(-3(-\\operatorname{cos}⁡x))+C \\\\  & =(-3)\\cdot(3\\operatorname{cos}⁡x)+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=(-3)\\cdot(3\\operatorname{cos}⁡x)+C.$ To find a particular solution, we substitute the condition $f(0)=-9$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-9 & =- 9 \\cos{((0) )}+C \\\\ -9 & =-9+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=- 9 \\cos{(x )}.\n$$"}] [{:db/id #edb/ref 17592186641804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d13286c4-0605-52c4-8b86-a1c36a338876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- x^{2} - 6" :db/id #edb/ref 17592186641801}] :answer-field/correct {:db/id #edb/ref 17592186641801} :answer-field/id #uuid "5232102e-23ce-5720-83da-0dd15e5ef158" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186641790}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0f748e0-3486-59dc-9a56-59ba5c3b0df2" :question/problem "Find the particular solution to the differential equation $- \\frac{\\text{d}y}{\\text{d}x} - 2 x=- 2 x^{2}$ that satisfies the condition $y(2)=- \\frac{14}{3}.$\n\n$y=\\frac{2 x^{3}}{3}+${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=2 x^{2} - 2 x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2 x^{2} - 2 x)\\,\\text{d}x \\\\ y & =(-2)\\int (x)\\,\\text{d}x+(2)\\int (x^{2})\\,\\text{d}x \\\\ & =(-2)\\left(\\frac{x^{2}}{2}\\right)+(2)\\left(\\frac{x^{3}}{3}\\right)+C \\\\ & =\\frac{2 x^{3}}{3} - x^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=\\frac{2 x^{3}}{3} - x^{2}+C.$ To find a particular solution, we substitute the condition $y(2)=- \\frac{14}{3}$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}- \\frac{14}{3} & =\\frac{2 (2)^{3}}{3} - (2)^{2}+C \\\\ - \\frac{14}{3} & =\\frac{4}{3}+C \\\\ C & =-6.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=\\frac{2 x^{3}}{3} - x^{2} - 6.\n$$"}] [{:db/id #edb/ref 17592186642576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c34f0a5-3eb3-5ab2-885c-b8f04b3ec3be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2 x^{2} + 4 e^{\\frac{x}{2}} + 6" :db/id #edb/ref 17592186642570} {:answer/id #uuid "33fbb8c8-7df2-51a4-ab8a-6496b74959a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2 x^{2} + 4 e^{\\frac{x}{2}} + 3" :db/id #edb/ref 17592186642571} {:answer/id #uuid "4a9d2a44-3914-5b52-8ad3-1545d503438c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4 x^{2} + 8 e^{\\frac{x}{2}} + 2" :db/id #edb/ref 17592186642572} {:answer/id #uuid "83187d0d-c5e1-584a-b770-6f1d7dfea20c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- 6 x^{2} - 12 e^{\\frac{x}{2}} + 19" :db/id #edb/ref 17592186642573} {:answer/id #uuid "d3b385f3-7788-52bd-bc32-94b17ad29b2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4 x^{2} + 8 e^{\\frac{x}{2}} - 1" :db/id #edb/ref 17592186642575}] :answer-field/correct {:db/id #edb/ref 17592186642575} :answer-field/id #uuid "b9159b05-7b28-5a5f-8338-05f5827e0ed0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186642574}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f462ee8e-5a84-54a0-8b0c-e214de561739" :question/problem "Find the particular solution to the differential equation ${y}^{′} - 8 x=4 e^{\\frac{x}{2}}$ that satisfies the condition $y(0)=7.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=8 x + 4 e^{\\frac{x}{2}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (8 x + 4 e^{\\frac{x}{2}})\\,\\text{d}x \\\\ y & =(4)\\int (e^{\\frac{x}{2}})\\,\\text{d}x+(8)\\int (x)\\,\\text{d}x \\\\ & =(4)(2 e^{\\frac{x}{2}})+(8)\\left(\\frac{x^{2}}{2}\\right)+C \\\\ & =4 x^{2} + 8 e^{\\frac{x}{2}}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=4 x^{2} + 8 e^{\\frac{x}{2}}+C.$ To find a particular solution, we substitute the condition $y(0)=7$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}7 & =4 (0)^{2} + 8 e^{\\frac{(0)}{2}}+C \\\\ 7 & =8+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=4 x^{2} + 8 e^{\\frac{x}{2}} - 1.\n$$"}] [{:db/id #edb/ref 17592186643298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f7ec6d-e409-500e-ac06-44968617b98e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186643297} {:answer/id #uuid "3aaa549a-4c70-5f6d-96ed-2b88fcd9a5df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186643306} {:answer/id #uuid "56f3b578-6c76-5bbb-8f8d-0b7ac0b32290" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186643309} {:answer/id #uuid "582fb0d7-708d-5d51-92df-507131f40950" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186643310} {:answer/id #uuid "9ba8f99a-c6be-541f-baa6-8d99641b194e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186643315}] :answer-field/correct {:db/id #edb/ref 17592186643315} :answer-field/id #uuid "34100d4e-936d-50ec-9c50-3f50c79f6ddf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186643303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "10aa925b-dbc8-583e-a476-be7dc1ebb577" :question/problem "![](images/bd/bddd8b3ba7352cd58667179d8b01c9c7f0ef523e4646e7c459ab577023356b64.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=6$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{6}^{2}}+\\frac{{y}^{2}}{{5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{25} & =1.\\end{aligned}\n$$"}]}
