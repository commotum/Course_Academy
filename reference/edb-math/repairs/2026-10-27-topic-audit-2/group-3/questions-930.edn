86045498} :answer/value "13 \\left(3 x + 3\\right)^{3}" :db/id #edb/ref 17592186702958} {:answer/id #uuid "abb21755-1796-5a3a-a060-0ab4c77e1a85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 \\left(3 x + 3\\right)^{3}" :db/id #edb/ref 17592186702972} {:answer/id #uuid "c37f7efe-dc76-5c63-8d6e-c451c01cf72e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15 \\left(3 x + 3\\right)^{3}" :db/id #edb/ref 17592186702974}] :answer-field/correct {:db/id #edb/ref 17592186702954} :answer-field/id #uuid "887cb7d0-8b07-5431-9106-6c408adf8710" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186702967}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27b02973-5d14-53fa-b0f3-0f20e21306bb" :question/problem "Given that $f(x)=\\left(3 x + 3\\right)^{4}$, find $f^{\\prime}(x).$\n\nUse the decomposition $g(x)=3 x + 3$ and $F(u)=u^{4}$, so $f(x)=F(g(x))$. Recall that $f^{\\prime}(x)=F^{\\prime}(g(x))g^{\\prime}(x)$." :question/worked-solution "Let $g(x)=3 x + 3$ and $F(g)=g^{4}$, so $f(x)=F(g(x))$.\n\nDifferentiating, we have\n\n$$\n\\begin{aligned} F^{\\prime}(g)&=4 g^{3}, \\\\ g^{\\prime}(x)&=3.\\end{aligned}\n$$\n\nThen, using the chain rule,\n\n$$\n\\begin{aligned} f^{\\prime}(x)&=F^{\\prime}(g(x))\\cdot g^{\\prime}(x) \\\\ &=\\left(4 \\left(3 x + 3\\right)^{3}\\right)\\cdot\\left(3\\right) \\\\ &=12 \\left(3 x + 3\\right)^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186702968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd06ab6-3bac-5da4-aad5-d599405bf6af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 \\left(- 2 x - 2\\right)^{2}" :db/id #edb/ref 17592186702957} {:answer/id #uuid "a14e4f3a-6d71-50c6-b78f-8c10ad88ead2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 \\left(- 2 x - 2\\right)^{2}" :db/id #edb/ref 17592186702971} {:answer/id #uuid "ae2f84e9-dae0-58be-a7e9-61e48e61696e" :answer/type {:db/id #edb/r