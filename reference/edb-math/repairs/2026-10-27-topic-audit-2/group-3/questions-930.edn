b/ref 17592186045498} :answer/value "-\\frac{1}{6}{e}^{x}+C" :db/id #edb/ref 17592186704105}] :answer-field/correct {:db/id #edb/ref 17592186704093} :answer-field/id #uuid "3ec8b9f9-f1fc-5ef9-9eb1-15d1829e31a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704080}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a0acf369-a6cc-5402-aa7f-c417a13cd6f5" :question/problem "$$\n\\displaystyle \\int \\frac{1}{6}{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant $\\frac{1}{6}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{6}{e}^{x}\\,\\text{d}x & =\\frac{1}{6}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{6}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010bd8e7-0b8b-5ea8-9ade-9fea66759508" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\left(\\frac{1}{21}\\right)}^{x}\\ln 21+C" :db/id #edb/ref 17592186704278} {:answer/id #uuid "0c443499-8438-5712-b644-60167ee9a227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{\\left(\\frac{1}{21}\\right)}^{x}}{\\ln 21}+C" :db/id #edb/ref 17592186704280} {:answer/id #uuid "c0231104-4010-5468-8f72-5bdc8b7b959e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\left(\\frac{1}{21}\\right)}^{x}\\ln 21+C" :db/id #edb/ref 17592186704299} {:answer/id #uuid "e2ebba62-67ee-527a-af73-a1252eb3b2c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\left(\\frac{1}{21}\\right)}^{x}}{\\ln 21}+C" :db/id #edb/ref 17592186704306} {:answer/id #uuid "e84b401b-d46c-5a25-a675-3ac4363f6b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\left(\\frac{1}{21}\\right)}^{x}+C" :db/id #edb/ref 17592186704307}] :answer-field/correct {:db/id #edb/ref 17592186704280} :answer-field/id #uuid "eab58b84-9d69-5a04-9fc5-daad642b2d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704308}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0996da2f-0d44-5487-88df-a6196b39abfc" :question/problem "Calculate $\\int {\\left(\\frac{1}{21}\\right)}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{21}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{21}\\right)}^{x}}{\\ln \\left(\\frac{1}{21}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}\\ln \\left(\\frac{1}{21}\\right) & =\\ln 1-\\ln 21 \\\\  & =0-\\ln 21 \\\\  & =-\\ln 21.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{21}\\right)}^{x}}{\\ln \\left(\\frac{1}{21}\\right)}+C &=-\\frac{{\\left(\\frac{1}{21}\\right)}^{x}}{\\ln 21}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59dc3ead-0ab4-5b67-aaca-de66b89f0c98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{39\\ln 39}+C" :db/id #edb/ref 17592186704288} {:answer/id #uuid "86a4ea13-43b5-5ad5-a4b2-93a5fd75f4b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{\\ln 39}+C" :db/id #edb/ref 17592186704292} {:answer/id #uuid "adc10c36-6019-56b2-8f2e-71c50cc61efb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\left(\\frac{1}{39}\\right)}^{x}\\ln 39+C" :db/id #edb/ref 17592186704297} {:answer/id #uuid "bfcb83f4-6eee-5fe4-b99a-5fd6791215c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{\\ln 39}+C" :db/id #edb/ref 17592186704298} {:answer/id #uuid "c9221641-ddd9-5e0f-9b6f-cc285122de0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\left(\\frac{1}{39}\\right)}^{x}\\ln 39+C" :db/id #edb/ref 17592186704301}] :answer-field/correct {:db/id #edb/ref 17592186704292} :answer-field/id #uuid "5b08d795-1e2a-5550-be85-08f5bcba01da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704289}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1383403c-5c9c-5b3c-b05c-bd407702cf47" :question/problem "Calculate $\\int {\\left(\\frac{1}{39}\\right)}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{39}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{\\ln \\left(\\frac{1}{39}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}\\ln \\left(\\frac{1}{39}\\right) & =\\ln 1-\\ln 39 \\\\  & =0-\\ln 39 \\\\  & =-\\ln 39.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{\\ln \\left(\\frac{1}{39}\\right)}+C &=-\\frac{{\\left(\\frac{1}{39}\\right)}^{x}}{\\ln 39}+C\\end{aligned}\n$$"}]}
