o, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{9}\\right)}^{x}}{\\ln \\left(\\frac{1}{9}\\right)}+C &=-\\frac{{\\left(\\frac{1}{9}\\right)}^{x}}{\\ln 9}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123562f6-c757-5195-9dfc-1e26f16e1a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{4}^{x}}{\\ln 4}+C" :db/id #edb/ref 17592186704349} {:answer/id #uuid "1de2447c-cf20-5d1d-94a9-47471ff95285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{4}^{x}}{\\ln 4}+C" :db/id #edb/ref 17592186704351} {:answer/id #uuid "3eb94225-3880-5e80-9f79-458272c3a89f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\cdot \\frac{{4}^{x}}{\\ln 4}+C" :db/id #edb/ref 17592186704352} {:answer/id #uuid "57e89644-a9c6-5df1-8d0d-432335fe899d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\cdot {4}^{x}\\ln 4+C" :db/id #edb/ref 17592186704356} {:answer/id #uuid "d10d554d-99d2-5075-a760-c2f073bd2792" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7\\cdot \\frac{{4}^{x}}{\\ln 4}+C" :db/id #edb/ref 17592186704378}] :answer-field/correct {:db/id #edb/ref 17592186704378} :answer-field/id #uuid "c18b98c8-5780-5d0d-88a8-d51e671e7553" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704374}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5412f671-0949-5029-9d23-41d015e5f591" :question/problem "$\\int -7\\cdot {4}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $-7.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int -7\\cdot {4}^{x}\\,\\text{d}x & =-7\\int {4}^{x}\\,\\text{d}x \\\\  & =-7\\cdot \\frac{{4}^{x}}{\\ln 4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15173e39-30