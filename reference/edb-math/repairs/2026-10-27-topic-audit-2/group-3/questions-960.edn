^{x}}{\\ln 47}+C" :db/id #edb/ref 17592186704369} {:answer/id #uuid "a3609141-8c52-5a95-9769-466a7141c4ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9\\cdot \\frac{{47}^{x}}{\\ln 47}+C" :db/id #edb/ref 17592186704370}] :answer-field/correct {:db/id #edb/ref 17592186704369} :answer-field/id #uuid "b03599bd-18d5-59c4-be10-dc48a15a57e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704371}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c3670ef4-4fc2-5be7-b28d-97e20928f559" :question/problem "$\\int 9\\cdot {47}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $9.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 9\\cdot {47}^{x}\\,\\text{d}x & =9\\int {47}^{x}\\,\\text{d}x \\\\  & =9\\cdot \\frac{{47}^{x}}{\\ln 47}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "659323f7-4ae2-5548-bc61-b198ac07c98f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\cdot \\frac{{20}^{x}}{\\ln 20}+C" :db/id #edb/ref 17592186704359} {:answer/id #uuid "7a93be0b-8cbe-5838-b88e-9d570c002e22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {20}^{x}\\ln 20+C" :db/id #edb/ref 17592186704363} {:answer/id #uuid "8cb659c9-c957-55ed-bcad-18e28a04baf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\cdot {20}^{x}\\ln 20+C" :db/id #edb/ref 17592186704365} {:answer/id #uuid "d06c4c45-5714-5e38-8591-096f605d5a7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16\\cdot \\frac{{20}^{x}}{\\ln 20}+C" :db/id #edb/ref 17592186704377} {:answer/id #uuid "d5b855e1-35d9-50a7-a227-b52dd6d04733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot \\frac{{20}^{x}}{\\ln 20}+C" :db/id #edb/ref 17592186704379}] :answer-field/correct {:db/id #edb/ref 17592186704379} :answer-field/id #uuid "70a22abf-edeb-5865-9236-4fde5d8238cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704360}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6d0caba-299e-5047-9dd6-2c8c3fe51348" :question/problem "$\\int 4\\cdot {20}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $4.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 4\\cdot {20}^{x}\\,\\text{d}x & =4\\int {20}^{x}\\,\\text{d}x \\\\  & =4\\cdot \\frac{{20}^{x}}{\\ln 20}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186704776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d4bf0d1-a8b6-5985-ab5f-7cdcbf5a2427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2e^{x}-\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln 8}+3+C" :db/id #edb/ref 17592186704780} {:answer/id #uuid "6678061a-f0ad-52d8-b632-da68a6922f02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2e^{x}+\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln 8}+3x+C" :db/id #edb/ref 17592186704782} {:answer/id #uuid "9aa34473-0688-5bfc-b5a3-22be4e773b60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2e^{x}-\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln 8}+3x+C" :db/id #edb/ref 17592186704786} {:answer/id #uuid "a8fe57a4-0ae6-596c-9d4f-8ff3e3d5fbf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2e^{x}+\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln 8}+3+C" :db/id #edb/ref 17592186704788} {:answer/id #uuid "e5ecbfa3-dc54-522d-8e6b-fd1ca827041a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2e^{x}-3\\left(\\frac{1}{8}\\right)^{x}+3x^{2}+C" :db/id #edb/ref 17592186704797}] :answer-field/correct {:db/id #edb/ref 17592186704782} :answer-field/id #uuid "b7f16aa5-cbc9-52b1-b1f3-002e82a550af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704791}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4da20fd9-a4cc-50dd-886f-d64356f0f224" :question/problem "Calculate\n\n$$\n\\int\\left(-2e^{x}-3\\left(\\frac{1}{8}\\right)^{x}+3\\right)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Apply the sum and constant factor rules, then integrate each term:\n\n$$\n\\begin{aligned}\n&\\int\\left(-2e^{x}-3\\left(\\frac{1}{8}\\right)^{x}+3\\right)\\,\\mathrm{d}x \\\\\n&=-2\\int e^{x}\\,\\mathrm{d}x-3\\int \\left(\\frac{1}{8}\\right)^{x}\\,\\mathrm{d}x+3\\int 1\\,\\mathrm{d}x \\\\\n&=-2e^{x}-\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln\\left(\\frac{1}{8}\\right)}+3x+C\n\\end{aligned}\n$$\n\nFor the reciprocal base, use the logarithm quotient rule:\n\n$$\n\\ln\\left(\\frac{1}{8}\\right)=\\ln 1-\\ln 8=-\\ln 8.\n$$\n\nSubstitute the negative logarithm and simplify the signed coefficient:\n\n$$\n\\begin{aligned}\n&=-2e^{x}-\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln\\left(\\frac{1}{8}\\right)}+3x+C \\\\\n&=-2e^{x}+\\frac{3\\left(\\frac{1}{8}\\right)^{x}}{\\ln 8}+3x+C\n\\end{aligned}\n$$\n\nInclude one arbitrary constant for the complete sum."}] [{:db/id #edb/ref 17592186704777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae076de-dec0-5307-9aef-982493bb3377" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln 3}+3e^{x}+3\\ln|x|+C" :db/id #edb/ref 17592186704778} {:answer/id #uuid "5c364d7b-f354-5b58-a9dc-a20aea91c8ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1}{3}\\right)^{x}\\ln 3+3e^{x}-\\frac{3}{x^{2}}+C" :db/id #edb/ref 17592186704779} {:answer/id #uuid "61e98a6e-c426-55e5-8cfa-4057e9494bdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln 3}+3e^{x}+\\frac{3}{x}+C" :db/id #edb/ref 17592186704781} {:answer/id #uuid "974d2363-20fa-5e24-ad02-e4dfe375a3de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln 3}+3e^{x}+3\\ln|x|+C" :db/id #edb/ref 17592186704785} {:answer/id #uuid "d1bfd4ae-36c7-58cd-ac85-76a62e8ab5cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln 3}+3e^{x}+\\frac{3}{x}+C" :db/id #edb/ref 17592186704795}] :answer-field/correct {:db/id #edb/ref 17592186704785} :answer-field/id #uuid "bbf7d490-2c55-596c-af63-6da983a0e9c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704793}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "55b7c37b-554a-5dfb-820c-fbc028c53c1d" :question/problem "Calculate\n\n$$\n\\int\\left(-\\left(\\frac{1}{3}\\right)^{x}+3e^{x}+\\frac{3}{x}\\right)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Apply the sum and constant factor rules, then integrate each term:\n\n$$\n\\begin{aligned}\n&\\int\\left(-\\left(\\frac{1}{3}\\right)^{x}+3e^{x}+\\frac{3}{x}\\right)\\,\\mathrm{d}x \\\\\n&=-\\int \\left(\\frac{1}{3}\\right)^{x}\\,\\mathrm{d}x+3\\int e^{x}\\,\\mathrm{d}x+3\\int \\frac{1}{x}\\,\\mathrm{d}x \\\\\n&=-\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln\\left(\\frac{1}{3}\\right)}+3e^{x}+3\\ln|x|+C\n\\end{aligned}\n$$\n\nFor the reciprocal base, use the logarithm quotient rule:\n\n$$\n\\ln\\left(\\frac{1}{3}\\right)=\\ln 1-\\ln 3=-\\ln 3.\n$$\n\nSubstitute the negative logarithm and simplify the signed coefficient:\n\n$$\n\\begin{aligned}\n&=-\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln\\left(\\frac{1}{3}\\right)}+3e^{x}+3\\ln|x|+C \\\\\n&=\\frac{\\left(\\frac{1}{3}\\right)^{x}}{\\ln 3}+3e^{x}+3\\ln|x|+C\n\\end{aligned}\n$$\n\nHere $x\\ne 0$; the arbitrary constant is independent on each interval of the domain."}] [{:db/id #edb/ref 17592186704783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110fe624-f858-5fce-9926-b31a443c045a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3e^{x}+\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}-x^{3}+C" :db/id #edb/ref 17592186704772} {:answer/id #uuid "b2a907d0-04b8-5523-a6b2-b9961b573d3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3e^{x}-\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}-\\frac{1}{3}x^{3}+C" :db/id #edb/ref 17592186704789} {:answer/id #uuid "b6324bd6-4b78-5a15-8256-bd441368db00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3e^{x}-2\\left(\\frac{1}{2}\\right)^{x}\\ln 2-\\frac{1}{3}x^{3}+C" :db/id #edb/ref 17592186704790} {:answer/id #uuid "ce292ed0-38ab-5dfb-97e8-3be1e5682c31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3e^{x}-\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}-\\frac{1}{3}x^{2}+C" :db/id #edb/ref 17592186704794} {:answer/id #uuid "df0cb46e-85f7-5fa0-841f-ddd3c956e4c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3e^{x}-2\\left(\\frac{1}{2}\\right)^{x}\\ln 2-\\frac{1}{3}x^{2}+C" :db/id #edb/ref 17592186704796}] :answer-field/correct {:db/id #edb/ref 17592186704789} :answer-field/id #uuid "3a8cb73c-2ea8-5d69-b18a-ed391f57e9d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704775}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6bfbd94b-d325-591b-8dba-c498821952fe" :question/problem "Calculate\n\n$$\n\\int\\left(-3e^{x}+2\\left(\\frac{1}{2}\\right)^{x}-x^{2}\\right)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Apply the sum and constant factor rules, then integrate each term:\n\n$$\n\\begin{aligned}\n&\\int\\left(-3e^{x}+2\\left(\\frac{1}{2}\\right)^{x}-x^{2}\\right)\\,\\mathrm{d}x \\\\\n&=-3\\int e^{x}\\,\\mathrm{d}x+2\\int \\left(\\frac{1}{2}\\right)^{x}\\,\\mathrm{d}x-\\int x^{2}\\,\\mathrm{d}x \\\\\n&=-3e^{x}+\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln\\left(\\frac{1}{2}\\right)}-\\left(\\frac{x^{3}}{3}\\right)+C\n\\end{aligned}\n$$\n\nFor the reciprocal base, use the logarithm quotient rule:\n\n$$\n\\ln\\left(\\frac{1}{2}\\right)=\\ln 1-\\ln 2=-\\ln 2.\n$$\n\nSubstitute the negative logarithm and simplify the signed coefficient:\n\n$$\n\\begin{aligned}\n&=-3e^{x}+\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln\\left(\\frac{1}{2}\\right)}-\\frac{1}{3}x^{3}+C \\\\\n&=-3e^{x}-\\frac{2\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}-\\frac{1}{3}x^{3}+C\n\\end{aligned}\n$$\n\nInclude one arbitrary constant for the complete sum."}] [{:db/id #edb/ref 17592186704784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "317ae228-fd57-56a1-b22d-48d18034c69c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}+5e^{x}-\\frac{1}{x}+C" :db/id #edb/ref 17592186704774} {:answer/id #uuid "a2fd68a8-db97-573d-8309-b8bf192c8100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}+5e^{x}-\\frac{1}{x}+C" :db/id #edb/ref 17592186704787} {:answer/id #uuid "bbd95c72-628f-5901-80e9-5eb70fd7bbd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}+5e^{x}-\\ln|x|+C" :db/id #edb/ref 17592186704792} {:answer/id #uuid "efe68492-5bfc-531c-b5ce-160c1bb82e96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}+5e^{x}-\\ln|x|+C" :db/id #edb/ref 17592186704798} {:answer/id #uuid "fbfb525b-98e2-5f71-a981-29d84a2fc14f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\left(\\frac{1}{2}\\right)^{x}+5e^{x}-\\frac{1}{x}+C" :db/id #edb/ref 17592186704799}] :answer-field/correct {:db/id #edb/ref 17592186704798} :answer-field/id #uuid "1ff365fd-b2a0-51e6-849c-d2645e76170b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704773}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8cb1ea3a-13e8-5e28-b502-198d66383f50" :question/problem "Calculate\n\n$$\n\\int\\left(3\\left(\\frac{1}{2}\\right)^{x}+5e^{x}-\\frac{1}{x}\\right)\\,\\mathrm{d}x.\n$$" :question/worked-solution "Apply the sum and constant factor rules, then integrate each term:\n\n$$\n\\begin{aligned}\n&\\int\\left(3\\left(\\frac{1}{2}\\right)^{x}+5e^{x}-\\frac{1}{x}\\right)\\,\\mathrm{d}x \\\\\n&=3\\int \\left(\\frac{1}{2}\\right)^{x}\\,\\mathrm{d}x+5\\int e^{x}\\,\\mathrm{d}x-\\int \\frac{1}{x}\\,\\mathrm{d}x \\\\\n&=\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln\\left(\\frac{1}{2}\\right)}+5e^{x}-\\ln|x|+C\n\\end{aligned}\n$$\n\nFor the reciprocal base, use the logarithm quotient rule:\n\n$$\n\\ln\\left(\\frac{1}{2}\\right)=\\ln 1-\\ln 2=-\\ln 2.\n$$\n\nSubstitute the negative logarithm and simplify the signed coefficient:\n\n$$\n\\begin{aligned}\n&=\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln\\left(\\frac{1}{2}\\right)}+5e^{x}-\\ln|x|+C \\\\\n&=-\\frac{3\\left(\\frac{1}{2}\\right)^{x}}{\\ln 2}+5e^{x}-\\ln|x|+C\n\\end{aligned}\n$$\n\nHere $x\\ne 0$; the arbitrary constant is independent on each interval of the domain."}] [{:db/id #edb/ref 17592186704859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ed65ad-1465-5ab9-8679-cd611276a253" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x - 2 e^{x}+C" :db/id #edb/ref 17592186704850} {:answer/id #uuid "40d90112-6794-5a45-b2ad-4c426c7cc006" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=2 x + 2 e^{x}+C" :db/id #edb/ref 17592186704854} {:answer/id #uuid "663e6de5-e4a0-5913-b14b-368368930881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=2 x - 2 e^{x}+C" :db/id #edb/ref 17592186704858} {:answer/id #uuid "a3090ead-9855-5b2f-a069-76fa8b2918fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=- 2 x - 2 e^{x}+C" :db/id #edb/ref 17592186704866} {:answer/id #uuid "b97c09a7-80c9-5ec4-a752-8253e1b1d5ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 e^{x}+C" :db/id #edb/ref 17592186704870}] :answer-field/correct {:db/id #edb/ref 17592186704850} :answer-field/id #uuid "1172c19d-e9bb-5a5b-ba5f-ffe275534768" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704848}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6b947863-40c9-5cbf-8f21-064bf0831ead" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=- 2 e^{x - y} - 2 e^{- y}.$ **Hint:** Factor the common exponential before separating the variables." :question/worked-solution "Factor $e^{-y}$ from the right-hand side, then multiply both sides by $e^y$ to separate the variables.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- 2 e^{x - y} - 2 e^{- y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =e^{-y}(- 2 e^{x} - 2) \\\\ (e^{y})\\,\\frac{\\text{d}y}{\\text{d}x} & =- 2 e^{x} - 2\\end{aligned}\n$$\n\nIntegrate both sides term by term:\n\n$$\n\\begin{aligned}\\int (e^{y})\\,\\text{d}y & =\\int (- 2 e^{x} - 2)\\,\\text{d}x \\\\ e^{y} & =- 2 x - 2 e^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ne^{y}=- 2 x - 2 e^{x}+C.\n$$"}] [{:db/id #edb/ref 17592186704861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a3d144-fe5e-55df-8a5c-b8f0a27f44a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=2 x + e^{x}+C" :db/id #edb/ref 17592186704852} {:answer/id #uuid "39faa50a-c584-56ba-8908-7c2aaf58896d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=2 x - e^{x}+C" :db/id #edb/ref 17592186704853} {:answer/id #uuid "51921e9d-7c38-571d-a219-eb12cfdf5a4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x + e^{x}+C" :db/id #edb/ref 17592186704856} {:answer/id #uuid "5f366ab8-45b7-54d3-a10a-ce1dc3569cc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x - e^{x}+C" :db/id #edb/ref 17592186704857} {:answer/id #uuid "9ec8734d-7fb0-5984-baa3-ddef8fbd2e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=e^{x}+C" :db/id #edb/ref 17592186704865}] :answer-field/correct {:db/id #edb/ref 17592186704856} :answer-field/id #uuid "83dce02c-6d15-50fe-bffc-d59a94a3a03b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704860}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fc85f2f-d0c2-5daf-bcba-357a03c49302" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=e^{x - y} - 2 e^{- y}.$ **Hint:** Factor the common exponential before separating the variables." :question/worked-solution "Factor $e^{-y}$ from the right-hand side, then multiply both sides by $e^y$ to separate the variables.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =e^{x - y} - 2 e^{- y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =e^{-y}(e^{x} - 2) \\\\ (e^{y})\\,\\frac{\\text{d}y}{\\text{d}x} & =e^{x} - 2\\end{aligned}\n$$\n\nIntegrate both sides term by term:\n\n$$\n\\begin{aligned}\\int (e^{y})\\,\\text{d}y & =\\int (e^{x} - 2)\\,\\text{d}x \\\\ e^{y} & =- 2 x + e^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ne^{y}=- 2 x + e^{x}+C.\n$$"}] [{:db/id #edb/ref 17592186704862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152f9070-d0d2-593d-b504-c9457da631fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- x + 2 e^{x}+C" :db/id #edb/ref 17592186704849} {:answer/id #uuid "991d6738-9bf3-5af3-9cde-b517ec3f48dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- x - 2 e^{x}+C" :db/id #edb/ref 17592186704864} {:answer/id #uuid "abbbceb0-ab33-5b0e-8ced-7caca63bcddb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=x - 2 e^{x}+C" :db/id #edb/ref 17592186704868} {:answer/id #uuid "bc053f41-c27f-5c1e-950f-b962d7ab079f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=\\frac{x^{2}}{2} - 2 e^{x}+C" :db/id #edb/ref 17592186704871} {:answer/id #uuid "efc47638-fe7c-59cc-8a75-79b41797de41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=x + 2 e^{x}+C" :db/id #edb/ref 17592186704875}] :answer-field/correct {:db/id #edb/ref 17592186704868} :answer-field/id #uuid "42af0f9a-e960-5891-bb1a-c1c4eab0b923" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704855}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "919b26a6-bdad-59af-9475-f124ac217c1d" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=- 2 e^{x - y} + e^{- y}.$ **Hint:** Factor the common exponential before separating the variables." :question/worked-solution "Factor $e^{-y}$ from the right-hand side, then multiply both sides by $e^y$ to separate the variables.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- 2 e^{x - y} + e^{- y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =e^{-y}(1 - 2 e^{x}) \\\\ (e^{y})\\,\\frac{\\text{d}y}{\\text{d}x} & =1 - 2 e^{x}\\end{aligned}\n$$\n\nIntegrate both sides term by term:\n\n$$\n\\begin{aligned}\\int (e^{y})\\,\\text{d}y & =\\int (1 - 2 e^{x})\\,\\text{d}x \\\\ e^{y} & =x - 2 e^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ne^{y}=x - 2 e^{x}+C.\n$$"}] [{:db/id #edb/ref 17592186704867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275b8a0f-6f02-58d3-ba1a-8a2f7973a3d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x + e^{2 x}+C" :db/id #edb/ref 17592186704851} {:answer/id #uuid "956f50a5-5e41-5e5f-a098-5e5bc1459a50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x - 4 e^{2 x}+C" :db/id #edb/ref 17592186704863} {:answer/id #uuid "ae2495b1-f0c4-58b9-9bdd-b5b4726ca6f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=2 x + e^{2 x}+C" :db/id #edb/ref 17592186704869} {:answer/id #uuid "d1222305-8479-5099-961f-496b3d84f0c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- 2 x - e^{2 x}+C" :db/id #edb/ref 17592186704873} {:answer/id #uuid "e80bb691-630d-5fed-ab12-3e9513795193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{y}=- e^{2 x}+C" :db/id #edb/ref 17592186704874}] :answer-field/correct {:db/id #edb/ref 17592186704873} :answer-field/id #uuid "c82f8f0c-2158-5dee-96b2-4b813af7ba29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a61aea06-b0bf-5692-a059-3f4ab59fe2b0" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=- 2 e^{2 x - y} - 2 e^{- y}.$ **Hint:** Factor the common exponential before separating the variables." :question/worked-solution "Factor $e^{-y}$ from the right-hand side, then multiply both sides by $e^y$ to separate the variables.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- 2 e^{2 x - y} - 2 e^{- y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =e^{-y}(- 2 e^{2 x} - 2) \\\\ (e^{y})\\,\\frac{\\text{d}y}{\\text{d}x} & =- 2 e^{2 x} - 2\\end{aligned}\n$$\n\nIntegrate both sides term by term:\n\n$$\n\\begin{aligned}\\int (e^{y})\\,\\text{d}y & =\\int (- 2 e^{2 x} - 2)\\,\\text{d}x \\\\ e^{y} & =- 2 x - e^{2 x}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ne^{y}=- 2 x - e^{2 x}+C.\n$$"}] [{:db/id #edb/ref 17592186722797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132edf03-e179-5599-a910-e91f8eeb76c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=1620-6y" :db/id #edb/ref 17592186722799} {:answer/id #uuid "7c35d191-8b21-513f-997f-9db275611ebd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=6y-1740" :db/id #edb/ref 17592186722813} {:answer/id #uuid "99ffb332-2ec1-52f9-9645-49d28f46b2a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=260-2y^{2}" :db/id #edb/ref 17592186722819} {:answer/id #uuid "d1f37915-cc2d-5bff-b3c6-59a4410df4e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=540-6y" :db/id #edb/ref 17592186722825} {:answer/id #uuid "de7b1318-2d89-5090-8718-f4b4c13c83e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=600-5y" :db/id #edb/ref 17592186722827}] :answer-field/correct {:db/id #edb/ref 17592186722799} :answer-field/id #uuid "80cb2cd0-2339-5c2e-896a-be470becd92f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186722815}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "018970ac-de02-510a-b494-d884db639437" :question/problem "Given that $y<270$ and $t\\ge 0$, which of the following is an inhibited growth equation throughout this range?" :question/worked-solution "An inhibited growth equation has the form\n\n$$\n\\frac{dy}{dt}=k(a-y),\\qquad k>0.\n$$\n\nThe quantity must be below its equilibrium: $y<a$.\n\nThe matching choice is\n\n$$\n\\frac{dy}{dt}=1620-6y.\n$$\n\n\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=600-5y \\\\ &=5(120-y) \\\\ a&=120\\end{aligned}\n$$\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=1620-6y \\\\ &=6(270-y) \\\\ a&=270\\end{aligned}\n$$\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=540-6y \\\\ &=6(90-y) \\\\ a&=90\\end{aligned}\n$$\n\nThe choice $\\frac{dy}{dt}=600-5y$ has equilibrium $a=120<270$; the stated bound does *not* keep the quantity below this equilibrium throughout the allowed range.\n\nThe choice $\\frac{dy}{dt}=1620-6y$ has $k=6>0$ and equilibrium $a=270$, consistent with $y<270$.\n\nThe choice $\\frac{dy}{dt}=540-6y$ has equilibrium $a=90<270$; the stated bound does *not* keep the quantity below this equilibrium throughout the allowed range.\n\nThe choice $\\frac{dy}{dt}=260-2y^{2}$ is nonlinear in $y$; it is not the required constant-times-gap model.\n\nThe choice $\\frac{dy}{dt}=6y-1740$ has a positive linear coefficient, so its rate is not a positive constant times the remaining gap."}] [{:db/id #edb/ref 17592186722814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "261e0e35-b550-5c23-89f9-f3d1e5d59fa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3y-540" :db/id #edb/ref 17592186722800} {:answer/id #uuid "709fb6ef-8c04-586a-b2a3-8a2ae369271d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=2y-300" :db/id #edb/ref 17592186722811} {:answer/id #uuid "96534649-1a72-543e-a8b7-701aafb3a595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=300-2y" :db/id #edb/ref 17592186722818} {:answer/id #uuid "9bb710a9-88e8-53e7-991a-93e6cc381aad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=500-2y^{2}" :db/id #edb/ref 17592186722820} {:answer/id #uuid "faceb177-89be-57c7-8da9-b214d9f8cfe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=540-3y" :db/id #edb/ref 17592186722831}] :answer-field/correct {:db/id #edb/ref 17592186722831} :answer-field/id #uuid "59e5178b-605f-550b-9c9e-c12748dd393e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186722808}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7dc8483d-6f91-5a70-961f-a9dcad9098d0" :question/problem "Given that $y<180$ and $t\\ge 0$, which of the following is an inhibited growth equation throughout this range?" :question/worked-solution "An inhibited growth equation has the form\n\n$$\n\\frac{dy}{dt}=k(a-y),\\qquad k>0.\n$$\n\nThe quantity must be below its equilibrium: $y<a$.\n\nThe matching choice is\n\n$$\n\\frac{dy}{dt}=540-3y.\n$$\n\n\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=540-3y \\\\ &=3(180-y) \\\\ a&=180\\end{aligned}\n$$\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=300-2y \\\\ &=2(150-y) \\\\ a&=150\\end{aligned}\n$$\n\nThe choice $\\frac{dy}{dt}=500-2y^{2}$ is nonlinear in $y$; it is not the required constant-times-gap model.\n\nThe choice $\\frac{dy}{dt}=540-3y$ has $k=3>0$ and equilibrium $a=180$, consistent with $y<180$.\n\nThe choice $\\frac{dy}{dt}=300-2y$ has equilibrium $a=150<180$; the stated bound does *not* keep the quantity below this equilibrium throughout the allowed range.\n\nThe choice $\\frac{dy}{dt}=3y-540$ has a positive linear coefficient, so its rate is not a positive constant times the remaining gap.\n\nThe choice $\\frac{dy}{dt}=2y-300$ has a positive linear coefficient, so its rate is not a positive constant times the remaining gap."}] [{:db/id #edb/ref 17592186722817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7e578e-c113-59f1-a142-250ce5f626b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=10-1y" :db/id #edb/ref 17592186722801} {:answer/id #uuid "4d3c3e45-6392-5f34-853a-6c03131ab151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=1710-9y" :db/id #edb/ref 17592186722804} {:answer/id #uuid "4fbc3b51-e427-5743-9f17-1ab9e300fdf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=900-9y" :db/id #edb/ref 17592186722805} {:answer/id #uuid "54248a7f-dd78-5315-bc4c-5649fc38d1cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=8y^{2}-640" :db/id #edb/ref 17592186722806} {:answer/id #uuid "58db6148-a4cf-5ec1-aa2e-ccd97aed11df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3y-60" :db/id #edb/ref 17592186722807}] :answer-field/correct {:db/id #edb/ref 17592186722804} :answer-field/id #uuid "ed1b4c6b-6ac9-596f-908c-df13a6869390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186722830}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "92799678-711a-5ecb-b669-01b184ca86d5" :question/problem "Given that $y<190$ and $t\\ge 0$, which of the following is an inhibited growth equation throughout this range?" :question/worked-solution "An inhibited growth equation has the form\n\n$$\n\\frac{dy}{dt}=k(a-y),\\qquad k>0.\n$$\n\nThe quantity must be below its equilibrium: $y<a$.\n\nThe matching choice is\n\n$$\n\\frac{dy}{dt}=1710-9y.\n$$\n\n\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=900-9y \\\\ &=9(100-y) \\\\ a&=100\\end{aligned}\n$$\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=10-1y \\\\ &=1(10-y) \\\\ a&=10\\end{aligned}\n$$\n\nThe equation\n\n$$\n\\begin{aligned}\\frac{dy}{dt}&=1710-9y \\\\ &=9(190-y) \\\\ a&=190\\end{aligned}\n$$\n\nThe choice $\\frac{dy}{dt}=900-9y$ has equilibrium $a=100<190$; the stated bound does *not* keep the quantity below this equilibrium throughout the allowed range.\n\nThe choice $\\frac{dy}{dt}=3y-60$ has a positive linear coefficient, so its rate is not a positive constant times the remaining gap.\n\nThe choice $\\frac{dy}{dt}=10-1y$ has equilibrium $a=10<190$; the stated bound does *not* keep the quantity below this equilibrium throughout the allowed range.\n\nThe choice $\\frac{dy}{dt}=1710-9y$ has $k=9>0$ and equilibrium $a=190$, consistent with $y<190$.\n\nThe choice $\\frac{dy}{dt}=8y^{2}-640$ is nonlinear in $y$; it is not the required constant-times-gap model."}] [{:db/id #edb/ref 17592186722821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cfc13b0-d246-5195-80b1-728788e330dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3y-870" :db/id #edb/ref 17592186722803} {:answer/id #uuid "60441a93-175a-5d98-a3e4-d598515c2d8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=8y^{2}-560" :db/id #edb/ref 17592186722809} {:answer/id #uuid "6dfedd3d-e738-5e8a-b262-cc6b6abf884f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=60-2y" :db/id #edb/ref 17592186722810} {:answer/id #uuid "dcad1613-fc5f-5e5f-82b0-396f78223f7c" :answer/type {