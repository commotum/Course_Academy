\\right)+C \\\\ y & =- \\frac{2 \\left(x - 1\\right)^{3}}{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/01/0152976cf6d6be4135913d14818ee23fc12b58ac1fcf432c6896e3c75e76016c.png)"}] [{:db/id #edb/ref 17592186496429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6a1146-7f52-5c21-8481-707664564a73" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/42/423249f8b6972f7f9c7482f5ccd8c1fa6f786ee7f4b7e8381fb9d552e65fb5fe.png" :db/id #edb/ref 17592186496397} {:answer/id #uuid "2e1e8205-a3a1-54f9-be35-36c48fa91e07" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d79f542f2d7066f0d08c935ee07eb17f12bdb4bc03b0d50a9b3b55f493ef3fbd.png" :db/id #edb/ref 17592186496402} {:answer/id #uuid "a81f77a2-6dd5-5d7a-88bf-ba50595b238d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e9/e9bf393362331bba0ce4cd1ad2f85bc300c340eac451b3e44cf9a7d82c1a519d.png" :db/id #edb/ref 17592186496417} {:answer/id #uuid "cbb2d373-4142-52a2-8286-325b9784e2e8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/9239d5fa24b4470527313e87be01cdfa12511a0bb5008bc8a1584b018b9faf66.png" :db/id #edb/ref 17592186496425} {:answer/id #uuid "f4bfb58f-2a48-58c7-8f84-d943df4fff49" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e6/e6497eec57bbd7a05803dc6218a2cb0363becc62b41c19cb3d90d701ebacc801.png" :db/id #edb/ref 17592186496435}] :answer-field/correct {:db/id #edb/ref 17592186496397} :answer-field/id #uuid "18683a5e-c88e-55e8-bf18-3022667e5c68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d592e808-7510-5a65-9880-a1f40ab32589" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{e^{- \\frac{x}{4}}}{8}?\n$$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(\\frac{e^{- \\frac{x}{4}}}{8}\\right)\\,\\text{d}x \\\\ y & =\\frac{1}{8}\\int e^{- \\frac{x}{4}}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\left(- 4 e^{- \\frac{x}{4}}\\right)+C \\\\ y & =- \\frac{e^{- \\frac{x}{4}}}{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/25/258e0e2dea305737216c1a4cbc8f448d93055b1c97eb8b8e73805b7fb8425c73.png)"}] [{:db/id #edb/ref 17592186496432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0229aff1-dd15-5dc0-8c29-4fe7230b6c3c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/66/66c0cf6892e6d86094f6ce2cbebb03fde5b72b62142502eb7df37b189fe1e090.png" :db/id #edb/ref 17592186496391} {:answer/id #uuid "25995fff-b334-5513-a18b-186af48cae46" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e7/e713f3dec38a143e0262ba7ebac0e654abf2bda07e5c9f05fdd0f98159a3af3d.png" :db/id #edb/ref 17592186496398} {:answer/id #uuid "2d1495df-de65-5c2a-808e-c395b77f25c2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3e/3e72325c08bf00f7ba5c76370b4be967249bb359cb4c8f106a5341192ec65be4.png" :db/id #edb/ref 17592186496401} {:answer/id #uuid "51af2964-ab37-58f8-bfb2-3440d159b7cc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8f/8f7920be5fb2d5b085400b14ecaeaa9f48a1bfcd5574b26846d67d2d24998bac.png" :db/id #edb/ref 17592186496410} {:answer/id #uuid "e47a143e-9a2a-504a-abb4-4687e24cbda0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d6/d6b9688cbe10695bcce92a75e8cb732370ff826697e340648e6b1e62114c61ca.png" :db/id #edb/ref 17592186496431}] :answer-field/correct {:db/id #edb/ref 17592186496398} :answer-field/id #uuid "db6badbb-63b1-5ae0-86a4-973b3f656302" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496430}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ebcdfba8-83b2-550e-83cd-6936094d4ac7" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{4 e^{- \\frac{2 x}{3}}}{9}?\n$$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(\\frac{4 e^{- \\frac{2 x}{3}}}{9}\\right)\\,\\text{d}x \\\\ y & =\\frac{4}{9}\\int e^{- \\frac{2 x}{3}}\\,\\text{d}x \\\\  & =\\frac{4}{9}\\left(- \\frac{3 e^{- \\frac{2 x}{3}}}{2}\\right)+C \\\\ y & =- \\frac{2 e^{- \\frac{2 x}{3}}}{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/ae/ae0e43d8605937216fd9b02d433085e87cf87e6f3bc66f3b8d0d20a86aada3d2.png)"}] [{:db/id #edb/ref 17592186496436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "335f78e7-e2ea-5a9b-a298-f76a48628524" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a8a38d8facf47ef51c0be050d7455b711cdc2ffe9f70982b811beca4f6eb6efc.png" :db/id #edb/ref 17592186496403} {:answer/id #uuid "3a47b506-3357-5439-a759-2bff00517d37" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6e/6edc37526f2955eb61e17377e014019d29bed65e47fd9ba59f9a5afc69bc7640.png" :db/id #edb/ref 17592186496405} {:answer/id #uuid "9d258c64-fd79-52f8-a367-e6841bdd1de5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/82/82caab06e81f5d84b3a2d90c3424c38e60697d42cf8883dc366982afb06456e2.png" :db/id #edb/ref 17592186496414} {:answer/id #uuid "a1303f0d-df89-544c-b68d-5bc8dc219b34" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/38/389ab31fd9cc675e64aecdfb60efa0a8adb524e9339f099a4c6f7f10382d686d.png" :db/id #edb/ref 17592186496416} {:answer/id #uuid "cad6d72d-23a4-5418-9ece-7d5d5e47991f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b1/b1d00ae4be0bdd48d9c8842419eb93ce4235b220fccd4162e471d08579a0adb6.png" :db/id #edb/ref 17592186496424}] :answer-field/correct {:db/id #edb/ref 17592186496405} :answer-field/id #uuid "26fb1d4f-55f0-5b2d-870e-c89f1b155e39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496399}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f4e4ee52-3f50-50c3-a550-02f217c3847c" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=e^{- \\frac{3 x}{2}}?\n$$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (e^{- \\frac{3 x}{2}})\\,\\text{d}x \\\\ y & =1\\int e^{- \\frac{3 x}{2}}\\,\\text{d}x \\\\  & =1\\left(- \\frac{2 e^{- \\frac{3 x}{2}}}{3}\\right)+C \\\\ y & =- \\frac{2 e^{- \\frac{3 x}{2}}}{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/1d/1d557f2aba4bd9f970251a40832e5a2eeb0ffa87fc6a89294d59aee4ed948bc5.png)"}] [{:db/id #edb/ref 17592186496441 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24f127e6-1306-5a2b-a3d3-e1cfe2de5c37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - 24 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186496444} {:answer/id #uuid "5dab8531-5053-5b1b-960d-22107ac03ca2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=D + 24 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186496456} {:answer/id #uuid "a757570a-5b0a-50a9-bc98-ac563d9d1ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D + 24 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186496472} {:answer/id #uuid "e3ca0a9f-4c7c-5392-b936-b70a824ebe7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + 24 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186496482} {:answer/id #uuid "ed1b0f73-2efc-5389-b2ce-f608d80d53f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=C x + D - 12 e^{- \\frac{x}{2}}" :db/id #edb/ref 17592186496484}] :answer-field/correct {:db/id #edb/ref 17592186496472} :answer-field/id #uuid "ddb49e73-0d27-5a15-86c6-4ce6a587bf67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "035ced66-4ab9-5d2d-a65a-0b6c4095543d" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6 e^{- \\frac{x}{2}}.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\left(6 e^{- \\frac{x}{2}}\\right)\\,\\text{d}x \\\\  & =((6)\\int \\left(e^{- \\frac{x}{2}}\\right)\\,\\text{d}x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =((6)\\left(- 2 e^{- \\frac{x}{2}}\\right))+C \\\\  & =C - 12 e^{- \\frac{x}{2}}.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\left(C - 12 e^{- \\frac{x}{2}}\\right)\\,\\text{d}x \\\\ y & =((-12)\\int \\left(e^{- \\frac{x}{2}}\\right)\\,\\text{d}x)+C\\int \\text{d}x \\\\  & =((-12)\\left(- 2 e^{- \\frac{x}{2}}\\right))+Cx+D \\\\  & =C x + D + 24 e^{- \\frac{x}{2}}.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}]}
