3} \\\\  & =-6\\cdot {e}^{0} \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f51954f-ef10-5b61-8e64-a3c5da15b5b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186241888} {:answer/id #uuid "561e1348-b169-5b7b-9445-b0635e9a11e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186241956} {:answer/id #uuid "662b5321-520e-54cd-9509-03f4e29b7113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186242102} {:answer/id #uuid "d763b1fc-ea11-5f90-95d1-e07b6b76e1cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186243092} {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186243251}] :answer-field/correct {:db/id #edb/ref 17592186243251} :answer-field/id #uuid "4a8beb4d-3f02-544b-a522-4d1a06ffa730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243581}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0b47caa-0fc0-55c4-b8be-d17c35ea6d3b" :question/math-academy-id "q-107452" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-4x}$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-4) \\\\  & =(3{x}^{2}-4){e}^{{x}^{3}-4x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(3{x}^{2}-4){e}^{{x}^{3}-4x}\\,|}_{x=2} \\\\  & =(3(2)^{2}-4){e}^{{2}^{3}-4(2)} \\\\  & =8\\cdot {e}^{0} \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152cb325-9ed7-57e6-9c36-b431d68cdffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241362} {:answer/id #uuid "2e76f4b9-59bb-51c9-a297-586eb211cb2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241592} {:answer/id #uuid "33d1a60d-2b25-5917-b2e1-7176812399fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241637} {:answer/id #uuid "7ab59f64-3cac-5e93-b9c8-4dd4ce8cba35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186242259} {:answer/id #uuid "ec2442e6-3bcb-5d29-a607-74db0268944f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186243268}] :answer-field/correct {:db/id #edb/ref 17592186241637} :answer-field/id #uuid "fdd15e38-3eee-5ed4-a0c4-348e7c224b10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f637ee3d-e925-50b9-8fb1-4aa44482e5e0" :question/math-academy-id "q-107459" :question/problem "Given that $y=3\\cdot {4}^{{x}^{2}-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\cdot {4}^{u},\\,u={x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\cdot {4}^{u}ln⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {4}^{u}ln⁡4\\cdot 2x \\\\  & =6x\\cdot {4}^{{x}^{2}-1}ln⁡4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41028630-8c80-5740-be87-b44f1ebfd09f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{e}^{x}}{4}+C" :db/id #edb/ref 17592186248001} {:answer/id #uuid "90f8cd2a-a92e-59b3-ae89-34b065cea112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{{e}^{x}}+C" :db/id #edb/ref 17592186248711} {:answer/id #uuid "b57632a7-9133-5352-a7c0-526e4674997c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{x}}{4}+C" :db/id #edb/ref 17592186249049} {:answer/id #uuid "d8f36ba5-f3dd-592f-a595-23844bb8da19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{x}+C" :db/id #edb/ref 17592186249337} {:answer/id #uuid "dce13361-28d2-5755-89f1-84924332f956" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4{e}^{x}+C" :db/id #edb/ref 17592186249382}] :answer-field/correct {:db/id #edb/ref 17592186249382} :answer-field/id #uuid "23df843a-3b48-5844-a27d-b466fbc7efd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249733}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6434d2e4-0465-5195-adb8-8688c42e1ab0" :question/math-academy-id "q-113853" :question/problem "$$\n\\displaystyle \\int -4{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant $-4$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -4{e}^{x}\\,\\text{d}x & =-4\\int {e}^{x}\\,\\text{d}x \\\\  & =-4{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $$\n\\displaystyle \\int {5}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d639fb1-5e97-552a-8900-f00ca81a7aa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {9}^{x}+C" :db/id #edb/ref 17592186247685} {:answer/id #uuid "4e751153-0344-5e47-bcf5-2ce3275c0e44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡9}{{9}^{x}}+C" :db/id #edb/ref 17592186248130} {:answer/id #uuid "7bfcf753-80ad-5540-ac4c-743bbdad3d0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{9}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186248511} {:answer/id #uuid "c52e14f9-6656-5f67-a272-35abe6783236" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡2}{9ln⁡x}+C" :db/id #edb/ref 17592186249175} {:answer/id #uuid "fc1db222-2e90-5213-97f5-5919e160fc92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186249619}] :answer-field/correct {:db/id #edb/ref 17592186249619} :answer-field/id #uuid "8f4bc499-d0fb-5f3a-829e-6c1ced03dc45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249923}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "763936f6-7387-5f00-bda0-da6f24c0d625" :question/math-academy-id "q-113890" :question/problem "$$\n\\displaystyle \\int 2\\cdot {9}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "First, we factor out the constant $2.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 2\\cdot {9}^{x}\\,\\text{d}x & =2\\int {9}^{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{9}^{x}}{ln⁡9}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fd8908-86c1-5758-81a1-2ec277f68aa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\left(\\frac{1}{8}\\right)}^{x}ln⁡8+C" :db/id #edb/ref 17592186247614} {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} {:answer/id #uuid "5253b616-1982-56f6-8a9e-7ac1838f5f20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186248162} {:answer/id #uuid "57f12027-6306-5a43-b276-eb500592f0a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186248222} {:answer/id #uuid "7f8980f3-ea7f-50a6-9c9c-7812ebfc0549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:db/id #edb/ref 17592186247681} :answer-field/id #uuid "8d70d61a-ae6a-57e0-bc6d-72a634f609db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249920}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "89cd3b1f-2f20-5813-8f46-6c4d05bd7fcb" :question/math-academy-id "q-113893" :question/problem "Calculate $$\n\\displaystyle \\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡\\left(\\frac{1}{8}\\right) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C=-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68b10feb-2180-5f4b-affc-efda6877e76e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2arccscx+C" :db/id #edb/ref 17592186248364} {:answer/id #uuid "6aec3579-b361-56d6-a432-c946f704be8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248375} {:answer/id #uuid "da0de2de-876a-5403-b74e-22394befed75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2arcsecx+C" :db/id #edb/ref 17592186249349} {:answer/id #uuid "ed63bc4d-a191-52f9-8099-1ca3eac1e754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186249506} {:answer/id #uuid "f89181c8-7cac-5b50-aded-bef01ac1683b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186249591}] :answer-field/correct {:db/id #edb/ref 17592186249591} :answer-field/id #uuid "1e8c0466-86ee-546f-9d46-8a6ca5c6d092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249724}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "620c9fa2-b98d-514c-8603-da573e96fa60" :question/math-academy-id "q-114026" :question/problem "$$\n\\displaystyle \\int \\frac{-2}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{-2}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =-2\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-2\\operatorname{arcsin}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f240b1-d54b-564c-a1f7-d889936d9276" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186247583} {:answer/id #uuid "5a7ded06-3f99-52c5-87a3-f6e7bebc74fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arccos}⁡7x+C" :db/id #edb/ref 17592186248244} {:answer/id #uuid "771a04ea-5611-5699-afd7-d2b1bbd76a59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arctan}⁡7x+C" :db/id #edb/ref 17592186248471} {:answer/id #uuid "7d136e41-3145-5b99-887b-cf979a7e6a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248523} {:answer/id #uuid "d7af2528-6583-53ff-a7c1-8ea96fab80ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arctan}⁡\\frac{x}{7}+C" :db/id #edb/ref 17592186249332}] :answer-field/correct {:db/id #edb/ref 17592186248523} :answer-field/id #uuid "e36f1bf8-9bd8-52fd-955f-97af63b0c86c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250063}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b07fb93b-c797-5e29-853c-4ccbaeed5144" :question/math-academy-id "q-114042" :question/problem "$$\n\\displaystyle \\int \\frac{2}{7{x}^{2}+7}\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{7{x}^{2}+7}\\,\\text{d}x & =\\int \\frac{2}{7({x}^{2}+1)}\\,\\text{d}x \\\\  & =\\frac{2}{7}\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\frac{2}{7}\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "147b8607-00ab-583f-9d29-c36db3ffb93e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30{(5x+10)}^{5}" :db/id #edb/ref 17592186247609} {:answer/id #uuid "8b9923c0-68fb-5db2-a270-b22a0a565a94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30{(5x+10)}^{6}" :db/id #edb/ref 17592186248673} {:answer/id #uuid "b955e3b8-b464-5b10-97ae-eea2d8b024ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{(5x+10)}^{5}" :db/id #edb/ref 17592186249080} {:answer/id #uuid "efb057ba-bc50-5a4b-9c8c-026e21fb0356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10{(5x+10)}^{5}" :db/id #edb/ref 17592186249528} {:answer/id #uuid "f825b128-d786-54b0-9c93-577427b75d05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{(5x+10)}^{5}" :db/id #edb/ref 17592186249588}] :answer-field/correct {:db/id #edb/ref 17592186247609} :answer-field/id #uuid "1beb6b75-3505-5fda-ac7d-3d7a94737480" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249718}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "421599a5-1cf3-595e-9d3b-cce9b649fa80" :question/math-academy-id "q-11410" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)={(5x+10)}^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{6},\\,g=5x+10\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6{g}^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=5.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =6{g}^{5}\\cdot 5 \\\\  & =30(5x+10{)}^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31bd6778-18b0-5ff5-8b99-5a553e76b73e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186247877} {:answer/id #uuid "4a97465c-2eb1-5200-9609-a38e8e5419dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186248089} {:answer/id #uuid "5170f02c-e217-5a70-9d06-19689007bd09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248155} {:answer/id #uuid "70c0b236-95a4-5fec-9b61-50baea92bf78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248412} {:answer/id #uuid "bb0c8113-6440-560f-bdcf-41c0564064c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249095}] :answer-field/correct {:db/id #edb/ref 17592186248412} :answer-field/id #uuid "c16c266a-b08e-5ef0-9fc4-f4220c1b8349" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250002}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a79dcdc-c1c8-5a71-9d84-cbbd212d39b8" :question/math-academy-id "q-114156" :question/problem "$$\n\\displaystyle \\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x & =\\int x\\,\\text{d}x+\\int \\frac{2}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\int x\\,\\text{d}x+2\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15af9c4d-6b3b-599c-9211-07f95e750f61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5arcsecx+C" :db/id #edb/ref 17592186247619} {:answer/id #uuid "56166895-6ca7-5e1b-beab-d135e33e1113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5arcsinx+C" :db/id #edb/ref 17592186248204} {:answer/id #uuid "affd5c63-c26e-5dd4-b056-d93b2bf76848" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-arcsec5x+C" :db/id #edb/ref 17592186249006} {:answer/id #uuid "e69b4304-2053-5d7c-b519-2c107aefacc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5arctanx+C" :db/id #edb/ref 17592186249456} {:answer/id #uuid "eeca40ae-b548-5ac3-9919-f0fb789966ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "arctan5x+C" :db/id #edb/ref 17592186249519}] :answer-field/correct {:db/id #edb/ref 17592186247619} :answer-field/id #uuid "0765ed4c-acdd-543a-b28e-d7e3e43736bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249682}] :question/difficulty {:db/