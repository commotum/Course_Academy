{:answer/id #uuid "321ef9b3-dc8b-5b99-b689-dfe8d1c4cf58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186241620} {:answer/id #uuid "501d0fb0-7ccb-548e-bb3a-b18b59d46b6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241894} {:answer/id #uuid "8cf3df5e-c66f-522b-838e-722473ef4ed3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186242424} {:answer/id #uuid "99c71189-09eb-555b-8519-9b447439afc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186242524}] :answer-field/correct {:db/id #edb/ref 17592186241894} :answer-field/id #uuid "19320ca1-b053-535e-b992-542e4931ff17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243482}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8b46779-d19f-5cca-987d-5f500a9de334" :question/math-academy-id "q-107360" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{1-4x}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=1-4x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-4) \\\\  & =-\\frac{2}{\\sqrt{1-4x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={\\left(-\\frac{2}{\\sqrt{1-4x}}\\right)|}_{x=-2} \\\\  & =-\\frac{2}{\\sqrt{1-4(-2)}} \\\\  & =-\\frac{2}{3}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad776a9-f4a0-5e5c-a3f9-720c0f51d8db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5{x}^{4}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186241411} {:answer/id #uuid "2b4eb06f-e217-5ea4-b6a5-fd33dc42e528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{x}^{4}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186241563} {:answer/id #uuid "6f6b602b-df9a-5236-8240-b5610aba6892" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{5}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186242173} {:answer/id #uuid "830d7ceb-1451-565b-a032-3b85a06189f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}{x}^{2}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186242323} {:answer/id #uuid "ee1d283c-0aa8-54f8-8845-20de899f1a2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{5}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186243290}] :answer-field/correct {:db/id #edb/ref 17592186241563} :answer-field/id #uuid "d9d8a733-77cf-5587-abae-2d5e6d3cb563" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243816}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6db51996-7191-5665-ba1d-2ca54d5c9e73" :question/math-academy-id "q-107437" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{{x}^{5}+1}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u={x}^{5}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (5{x}^{4}) \\\\  & =5{x}^{4}{e}^{u} \\\\  & =5{x}^{4}{e}^{{x}^{5}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100855dc-01a1-54eb-889b-5c5849671fed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241318} {:answer/id #uuid "412016b5-7fcf-5318-88ca-74a5337fd439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241764} {:answer/id #uuid "b3c2451f-e77c-598c-a29b-975bfafc93b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186242750} {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} {:answer/id #uuid "e95fa722-682a-5996-bbc5-42651cbf8584" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243242}] :answer-field/correct {:db/id #edb/ref 17592186243224} :answer-field/id #uuid "666980b0-ea06-5cc6-8aba-d89d9e6e8dd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243640}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "30a7e2e3-900c-5659-9ff0-e1c7283ea786" :question/math-academy-id "q-107445" :question/problem "Given that $y={e}^{{x}^{2}-2x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{2}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x-2) \\\\  & =(2x-2){e}^{u} \\\\  & =(2x-2){e}^{{x}^{2}-2x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e4e1491-e222-5802-886e-742231f78057" :