{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =-12\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =-12arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ace781-d274-5e56-a670-5a4a11cc396e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7{x}^{3}\\text{ arcsin }x+C" :db/id #edb/ref 17592186247581} {:answer/id #uuid "5692d53f-e590-5c4b-b3cf-b26aac77396a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186248210} {:answer/id #uuid "bfc18efd-3204-5471-89ef-885c34415cd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}+7\\text{ arcsin }x+C" :db/id #edb/ref 17592186249128} {:answer/id #uuid "d2dad63e-a18d-5765-8de3-fdf0ca004d01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7{x}^{3}\\text{ arcsec }x+C" :db/id #edb/ref 17592186249295} {:answer/id #uuid "dd4b608f-ffe9-5210-b69f-f21778e1a218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{3}-7\\text{ arctan }x+C" :db/id #edb/ref 17592186249386}] :answer-field/correct {:db/id #edb/ref 17592186248210} :answer-field/id #uuid "8b1cbd54-3439-59c4-a3d8-a241f241223c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249912}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eb0e1654-81f3-51ff-a1ad-22ecef08f60d" :question/math-academy-id "q-114164" :question/problem "$$\n\\displaystyle \\int (3{x}^{2}+\\frac{7}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x=\n$$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int (3{x}^{2}+\\frac{7}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x & =\\int 3{x}^{2}\\,\\text{d}x+\\int \\frac{7}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =3\\int {x}^{2}\\,\\text{d}x+7\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =3\\left(\\frac{{x}^{3}}{3}\\right)+7(\\text{ arcsec }x)+C \\\\  & ={x}^{3}+7\\text{ arcsec }x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d777e7-64e4-53c8-a58b-4109b26ec30a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186247779} {:answer/id #uuid "4725e1f3-3bac-54c9-976b-a4be3acdee45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248055} {:answer/id #uuid "5f842a7a-96b0-5892-bbf8-16bcb12e7b80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248289} {:answer/id #uuid "ac802b62-ee40-527f-a541-bc50021df648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248964} {:answer/id #uuid "c7af75c9-f04f-5c0c-b971-fa76073ccb70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186249200}] :answer-field/correct {:db/id #edb/ref 17592186248964} :answer-field/id #uuid "6e6e76fc-ebfb-5b23-9799-3f3027022a53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249859}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9199096c-1056-59b2-bc8e-bf89ee34e2ca" :question/math-academy-id "q-114181" :question/problem "$$\n\\displaystyle \\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x=\n$$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+6}{{x}^{2}+1} & =\\frac{{x}^{2}+1-1+6}{{x}^{2}+1} \\\\  & =\\frac{({x}^{2}+1)+5}{{x}^{2}+1} \\\\  & =\\frac{\\cancel{{x}^{2}+1}}{\\cancel{{x}^{2}+1}}+\\frac{5}{{x}^{2}+1} \\\\  & =1+\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x & =\\int (1+\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =\\int \\text{d}x+\\int \\frac{5}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int \\text{d}x+5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =x+5\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573f0bf8-8c3a-5fd3-87b0-1f98d36645e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248215} {:answer/id #uuid "7df83fc4-3a1c-5b4e-9334-3a07c3e58e5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248529} {:answer/id #uuid "857ce7ea-a4b4-5485-b3d8-49d024d15f0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248613} {:answer/id #uuid "881c84d2-e368-5509-bb5a-80ca75c9ca6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248639} {:answer/id #uuid "994d053b-d19e-559c-a29d-2a8054864f41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248792}] :answer-field/correct {:db/id #edb/ref 17592186248529} :answer-field/id #uuid "7223fe64-f45f-5bb2-b016-eb100aa48182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d5fd5d6-3989-51af-a4dc-33f4a2f20e44" :question/math-academy-id "q-114183" :question/problem "$$\n\\displaystyle \\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=\n$$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}}{{x}^{2}+1} & =\\frac{5{x}^{2}+5-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)}{{x}^{2}+1}-\\frac{5}{{x}^{2}+1} \\\\  & =\\frac{5\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{5}{{x}^{2}+1} \\\\  & =5-\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (5-\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =5\\int \\text{d}x-5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =5x-5\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454a889b-721a-50b6-97c3-f47be3defb16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248046} {:answer/id #uuid "824243f4-5ca1-536a-9f8d-289db11728a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248577} {:answer/id #uuid "86b2b588-7b9d-56fe-a27a-0e737e5e0cba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248627} {:answer/id #uuid "97a50aac-2235-5530-bca7-b5df0d59c773" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248775} {:answer/id #uuid "a81bfa86-2d4c-5595-afcd-7b763ef010ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248918}] :answer-field/correct {:db/id #edb/ref 17592186248627} :answer-field/id #uuid "c544ada9-fdbb-5a15-af23-b77ee756bc20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250009}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7663d90a-9599-5f84-ad9c-e23f99291791" :question/math-academy-id "q-114184" :question/problem "$$\n\\displaystyle \\int \\frac{4{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=\n$$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{4{x}^{2}}{{x}^{2}+1} & =\\frac{4{x}^{2}+4-4}{{x}^{2}+1} \\\\  & =\\frac{4({x}^{2}+1)-4}{{x}^{2}+1} \\\\  & =\\frac{4({x}^{2}+1)}{{x}^{2}+1}-\\frac{4}{{x}^{2}+1} \\\\  & =\\frac{4\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{4}{{x}^{2}+1} \\\\  & =4-\\frac{4}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (4-\\frac{4}{{x}^{2}+1})\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =4x-4\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3424c38a-0404-5112-b538-b0b51cd67cca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81}=1" :db/id #edb/ref 17592186247893} {:answer/id #uuid "9f539e40-9fe1-5755-b952-a5dba33c4b36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248841} {:answer/id #uuid "abbd5f4c-90d7-5f59-bdc9-b9540e0ed117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{18}=1" :db/id #edb/ref 17592186248951} {:answer/id #uuid "c03064a2-589f-5b9e-acac-21e3dde6cf6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186249133} {:answer/id #uuid "c273eca8-c57d-58f1-aa76-b2a120fc902e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186249152}] :answer-field/correct {:db/id #edb/ref 17592186247893} :answer-field/id #uuid "7cdda833-7434-58f2-9ede-95f3721b6654" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249887}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e837072a-c08e-5c7a-88b6-aa68dac3c245" :question/math-academy-id "q-115123" :question/problem "![](images/cf/cf20c8dba07a1c6c2e6e6a95fbe45675301e734c976b8073d67ff4bd2cb21ad6.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=6$ and the vertical radius has length $b=9.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{6}^{2}}+\\frac{{y}^{2}}{{9}^{2}} & =1 \\\\ \\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{81} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153668da-d780-523a-8e26-48e058715b79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186247615} {:answer/id #uuid "3d9dc02d-1da3-5526-af85-e13cc50a7c05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186247968} {:answer/id #uuid "750c26fb-43a5-5a41-8361-58c46e0b0804" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186248452} {:answer/id #uuid "a1d902f3-35d6-5d0d-ac8b-52610f9c819b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248870} {:answer/id #uuid "a8569992-7633-5a8b-9630-e609ef25ddfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186248919}] :answer-field/correct {:db/id #edb/ref 17592186248452} :answer-field/id #uuid "106279dc-5bad-5b89-83c9-6a40e4f9b6f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249697}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "522f5175-a019-5a90-95ed-58cc045a0980" :question/math-academy-id "q-115124" :question/problem "![](images/76/764f25a4b18f3f28110c0ce3345402bf183d61cac350832663e221b0de9852a5.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18946d18-556b-5c59-afd6-6c11c44a77d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186247643} {:answer/id #uuid "4e4292dd-4e78-52b6-8b71-ca0e4809368b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186248128} {:answer/id #uuid "5679d9fd-563d-5470-8c16-90f34b8f5565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64}=1" :db/id #edb/ref 17592186248208} {:answer/id #uuid "e447b96f-daf1-55bd-af45-305484c0b5f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186249435} {:answer/id #uuid "fcc74f87-91ec-5a2b-ab39-4332409ff087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186249632}] :answer-field/correct {:db/id #edb/ref 17592186248208} :answer-field/id #uuid "2043a17f-33cb-56ee-8db3-82cbe5fc75f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249728}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "04f04ac8-2bb9-5d12-9232-9b8b1040f8d5" :question/math-academy-id "q-115126" :question/problem "![](images/62/62b62eb01c13ad4eef0367999445402d5a39710b7cfb2df11813b2bfcddb4b9c.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=8.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{8}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{64} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f413219-72b6-563c-a2d9-f8afbb029259" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186248284} {:answer/id #uuid "79b4aef4-9b3f-5d77-ac44-d038f8baee85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186248495} {:answer/id #uuid "8b0d68c5-024a-5887-9a04-22c2df46341f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186248664} {:answer/id #uuid "aeaf04e9-ff57-5fe8-b96e-fbd8f41c5c32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186248984} {:answer/id #uuid "c85e571b-6275-59b2-895d-4959a07626cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186249206}] :answer-field/correct {:db/id #edb/ref 17592186249206} :answer-field/id #uuid "9207681d-e046-55c2-be9d-c8f1f3489b44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249930}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ba6b3820-d361-5a84-a78c-c8c951e27981" :question/math-academy-id "q-115129" :question/problem "![](images/c7/c71a52cc148f8ce4a23a2fb2005757c9d141d3caf05586d8fb5122f591dc7474.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=1$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{4}^{2}} & =1 \\\\ \\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a537988-fe3f-54c0-9969-840ebacfdc49" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$16$ and $7$" :db/id #edb/ref 17592186247941} {:answer/id #uuid "47dcabf5-4c17-538f-b234-536fc0e79fb2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$14$ and $8$" :db/id #edb/ref 17592186248066} {:answer/id #uuid "84dca1dd-ac85-5c5e-981b-8c8116385a31" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $3.5$" :db/id #edb/ref 17592186248603} {:answer/id #uuid "a90d8381-a4e7-5c6c-b202-bb25fb3dee30" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $\\sqrt{7}$" :db/id #edb/ref 17592186248927} {:answer/id #uuid "ffe41db8-dff4-598f-8f14-5e33cb612563" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $2\\sqrt{7}$" :db/id #edb/ref 17592186249664}] :answer-field/correct {:db/id #edb/ref 17592186249664} :answer-field/id #uuid "cb465769-f76a-5b09-871d-27ae5361defb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250021}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0af912c0-685f-5b27-b24c-c0de6bcff1d8" :question/math-academy-id "q-115132" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{7}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=16$ and ${b}^{2}=7.$\n\n- Since ${a}^{2}=16,$ the length of the horizontal radius must be $a=\\sqrt{16}=4.$\n\n- Since ${b}^{2}=7,$ the length of the vertical radius must be $b=\\sqrt{7}.$\n\nThus, the semi-major axis has length $a=4,$ and the semi-minor axis has length $b=\\sqrt{7}.$\n\nTherefore, the major axis has length $2a=2\\cdot 4=8,$ and the minor axis has length $2b=2\\cdot \\sqrt{7}=2\\sqrt{7}.$"}] [{:db/id #edb/ref 17592186250351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ab7bfc4-fe0b-5271-b8ca-448cc2f51cca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$20$ and $10$" :db/id #edb/ref 17592186247805} {:answer/id #uuid "515c4642-4ca5-5554-a9a2-a99042231e23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $2.5$" :db/id #edb/ref 17592186248154} {:answer/id #uuid "5390bb0d-24f6-53b5-94f1-003ff942f21a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$50$ and $12.5$" :db/id #edb/ref 17592186248176} {:answer/id #uuid "7c004586-c7f0-5ef1-b7fc-ca0dc8582a7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$100$ and $25$" :db/id #edb/ref 17592186248512} {:answer/id #uuid "f6dfbabe-5660-549f-96d1-e202fb8340ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $5$" :db/id #edb/ref 17592186249580}] :answer-field/correct {:db/id #edb/ref 17592186247805} :answer-field/id #uuid "7ac28089-ed40-5056-81d0-446e067aefea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249880}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41a42db1-4c6e-506f-8c7d-8db6141e0014" :question/math-academy-id "q-115135" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$$\n\\displaystyle \\frac{{x}^{2}}{100}+\\frac{{y}^{2}}{25}=1?\n$$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=100$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=100,$ the length of the horizontal radius must be $a=\\sqrt{100}=10.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nThus, the semi-major axis has length $a=10,$ and the semi-minor axis has length $b=5.$\n\nTherefore, the major axis has length $2a=2\\cdot 10=20,$ and the minor axis has length $2b=2\\cdot 5=10.$"}] [{:db/id #edb/ref 17592186253525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae3c5e0-1352-56fd-ba70-9a98aacdb051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{tan}⁡y={e}^{x}+C" :db/id #edb/ref 17592186250782} {:answer/id #uuid "3b8d8918-9739-590c-9fbc-5d363870224a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡y={e}^{2x}+C" :db/id #edb/ref 17592186251048} {:answer/id #uuid "7590b4e3-175b-5973-b9a4-23a24a9d8b1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{tan}⁡y={e}^{2x}+C" :db/id #edb/ref 17592186251521} {:answer/id #uuid "d65bc188-62c5-5f03-8494-a8fcd839865a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡y=2{e}^{x}+C" :db/id #edb/ref 17592186252450} {:answer/id #uuid "dbcc7213-5543-5c22-a097-9b55ce7076ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡y={e}^{x}+C" :db/id #edb/ref 17592186252486}] :answer-field/correct {:db/id #edb/ref 17592186252486} :answer-field/id #uuid "d173063d-47e4-520d-a7a8-338e552ab61b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a130453a-6065-5959-8de8-bb802e7d41f1" :question/math-academy-id "q-118885" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{x}{cos}^{2}⁡y$ for $0<y<\\frac{\\pi }{2}.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}{cos}^{2}⁡y \\\\ \\frac{1}{{cos}^{2}⁡y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x} \\\\ {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {sec}^{2}⁡y\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ \\operatorname{tan}⁡y & ={e}^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{tan}⁡y={e}^{x}+C.\n$$"}] [{:db/id #edb/ref 17592186253531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2628def8-9645-51de-9e8f-3993f1de42dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-8\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186250883} {:answer/id #uuid "2e2afe8b-693c-5e5d-8ae5-7dd6c9ecac38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=\\frac{1}{2}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186250948} {:answer/id #uuid "7e485acb-f298-517c-be2f-3047650c561f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-\\frac{1}{4}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186251613} {:answer/id #uuid "ce428001-7345-56f1-b009-0b23f9dd54d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=-\\frac{1}{8}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186252376} {:answer/id #uuid "d492b169-b001-5d91-9313-3a1cdca45303" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x)=2\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186252432}] :answer-field/correct {:db/id #edb/ref 17592186252376} :answer-field/id #uuid "21d3ab40-897b-52d6-935d-dd5cec3b2f88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b105cb3a-38a2-5c0a-8e78-f3632457e0c5" :question/math-academy-id "q-119032" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{1}{2}\\operatorname{sin}⁡4x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2}\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sin}⁡4x\\,\\text{d}x \\\\ f(x) & =\\frac{1}{2}\\int \\operatorname{sin}⁡4x\\,\\text{d}x \\\\  & =\\frac{1}{2}(-\\frac{1}{4}\\operatorname{cos}⁡4x) \\\\  & =-\\frac{1}{8}\\operatorname{cos}⁡4x+C.\\end{aligned}\n$$"}]}
