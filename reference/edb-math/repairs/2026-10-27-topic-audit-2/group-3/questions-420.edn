#{[{:db/id #edb/ref 17592186339009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} {:answer/id #uuid "2c3c2a30-99f8-537b-8508-e5713aa27c9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186336450} {:answer/id #uuid "67383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$$\n\\displaystyle \\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2617015a-5455-5667-ad50-b136e5b1fa55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5{e}^{x}+C" :db/id #edb/ref 17592186336390} {:answer/id #uuid "3a23d2fc-a7aa-5d1c-9864-c7a6153600b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}{e}^{x}+C" :db/id #edb/ref 17592186336580} {:answer/id #uuid "58f93f66-db36-5c48-881b-168f6ab9b1da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336846} {:answer/id #uuid "91871bd5-c6b8-54e1-afe7-328451f3d7cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{5x}+C" :db/id #edb/ref 17592186337348} {:answer/id #uuid "d7c559ce-e0d7-5005-92d4-45151197edcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-5x}+C" :db/id #edb/ref 17592186337906}] :answer-field/correct {:db/id #edb/ref 17592186336390} :answer-field/id #uuid "a5cc0952-0c9f-5522-9ba6-3e6da71b3cd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338585}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0db7f6e-faf8-548f-9f7b-4ca5b8b122ae" :question/math-academy-id "q-71914" :question/problem "$$\n\\displaystyle \\int -5{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant $-5$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -5{e}^{x}\\,\\text{d}x & =-5\\int {e}^{x}\\,\\text{d}x \\\\  & =-5{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047bf720-73c7-51c2-a1d1-0d7ce9ba0daf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\pi }^{2}{e}^{x}+C" :db/id #edb/ref 17592186336069} {:answer/id #uuid "28c95efa-9323-5c94-81de-c262b269bc72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }{e}^{x}+C" :db/id #edb/ref 17592186336413} {:answer/id #uuid "6c76f031-a85c-501b-9e15-92c6ad1fc1ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{\\pi }^{2}}{e}^{x}+C" :db/id #edb/ref 17592186336992} {:answer/id #uuid "87d9262e-48c6-59b6-91be-da9db9655aed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {e}^{x}+C" :db/id #edb/ref 17592186337257} {:answer/id #uuid "a43b59b6-25ca-52aa-9cd7-3a4cf85aee70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186337525}] :answer-field/correct {:db/id #edb/ref 17592186336069} :answer-field/id #uuid "c2b21568-35b2-50d7-96a4-854078bb38e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338626}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c37273e4-126c-576b-aa8c-be1f096ba883" :question/math-academy-id "q-71918" :question/problem "$$\n\\displaystyle \\int {\\pi }^{2}{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant ${\\pi }^{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int {\\pi }^{2}{e}^{x}\\,\\text{d}x & ={\\pi }^{2}\\int {e}^{x}\\,\\text{d}x \\\\  & ={\\pi }^{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25c6804e-8060-5dff-bba1-acaf4df961ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32(8x-7)^{3}" :db/id #edb/ref 17592186524452} {:answer/id #uuid "a07a2ebe-3a0b-54c5-a1a1-e83b39b74dac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16(8x-7)^{3}" :db/id #edb/ref 17592186524636} {:answer/id #uuid "a9e6700f-f254-59c8-947f-7f6a658e28f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32(16x-7)^{3}" :db/id #edb/ref 17592186524655} {:answer/id #uuid "d56bf506-fd8c-5071-aec9-cd4f69c5a6e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16(16x-7)^{3}" :db/id #edb/ref 17592186524738} {:answer/id #uuid "ee2fea0e-928b-58ba-8851-272406927771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(8x-7)^{3}" :db/id #edb/ref 17592186524802}] :answer-field/correct {:db/id #edb/ref 17592186524452} :answer-field/id #uuid "37b56870-5595-52b0-ae23-7f96f4a87f21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338377}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "217bdf0c-2bc6-585f-ac52-fad4aec9092f" :question/math-academy-id "q-71954" :question/problem "Given that $f(x)={(8x-7)}^{4},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=8x-7$ and $f(g(x))=g(x)^{4}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{4})^{′}=4{g}^{3}, \\\\ {g}^{′}(x) & =(8x-7)^{′}=8.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =4{g}^{3}\\cdot (8) \\\\  & =32(8x-7)^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2f6517-e258-513a-b912-2250e7c54e17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15(2+5x{)}^{2}" :db/id #edb/ref 17592186336461} {:answer/id #uuid "3b2c8729-231c-5b49-a873-246a32aa4645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15(2-5x{)}^{3}" :db/id #edb/ref 17592186336588} {:answer/id #uuid "77d335ef-89db-5392-8e96-2e5663d37f72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15(2+5x{)}^{2}" :db/id #edb/ref 17592186337111} {:answer/id #uuid "84c34e15-f7f7-51bd-91ad-be1849bcac42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15(2-5x{)}^{2}" :db/id #edb/ref 17592186337229} {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682}] :answer-field/correct {:db/id #edb/ref 17592186337682} :answer-field/id #uuid "20dca297-5492-547a-957c-959f9e7520f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338339}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ccad926b-6344-5bec-99bc-507d50cda1e3" :question/math-academy-id "q-71956" :question/problem "Given that $f(x)={(2-5x)}^{3},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2-5x$ and $f(g(x))=g(x{)}^{3}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{3}{)}^{′}=3{g}^{2}, \\\\ {g}^{′}(x) & =(2-5x{)}^{′}=-5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =3{g}^{2}\\cdot (-5) \\\\  & =-15(2-5x{)}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a99ac4-61b4-5a56-b3ac-d93de9f9dd89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186339144} {:answer/id #uuid "4904f1fc-dc77-524c-af2d-813ee70dcc8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186339783} {:answer/id #uuid "a8efa69b-78be-5a02-81b6-baa9e8fedd59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186340664} {:answer/id #uuid "cdd060fa-0631-5438-80c1-f6c14e340129" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186340956} {:answer/id #uuid "d6c989e2-03ee-581f-83f6-e95b613b2103" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186341033}] :answer-field/correct {:db/id #edb/ref 17592186339783} :answer-field/id #uuid "013f1fb3-558e-5ad1-b4b7-34a42443c53c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341385}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65bcf244-fd2b-540c-b6fb-6b4c12786b6a" :question/math-academy-id "q-73619" :question/problem "![](images/86/8637901efc126236b190e7012cf65a06be078cb21c3093eff39b927493000138.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1.5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{\\left(\\frac{3}{2}\\right)}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{\\left(\\frac{{3}^{2}}{{2}^{2}}\\right)} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{\\left(\\frac{9}{4}\\right)} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264c8e91-4c93-5aee-ba55-bd907c4a3b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339459} {:answer/id #uuid "320f7703-8c4f-5dc9-8624-856e513ecd8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339568} {:answer/id #uuid "60bbf1c4-341f-50ef-8931-5d66a4141ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186339990} {:answer/id #uuid "ba485f5d-a19d-569b-ac5d-342a12dfefea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186340797} {:answer/id #uuid "e1dcb36b-eef4-548f-8678-715a402e7c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{32}=1" :db/id #edb/ref 17592186341129}] :answer-field/correct {:db/id #edb/ref 17592186340797} :answer-field/id #uuid "d755d6a9-5867-59b0-abe9-3aa060579222" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341759}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "72c0e5d1-5884-5875-91c7-7d9b69f20798" :question/math-academy-id "q-73627" :question/problem "![](images/37/377a871e9328e0a8b3c12d8904ecc16a2e6e3a17fa7dba05925bb6f2e5d7e4ad.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=4$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e7bd1b3-9829-5473-8614-8c430afd35b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186343033} {:answer/id #uuid "6886ac93-669b-567a-bcd2-cdc962ddc459" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ and $4$" :db/id #edb/ref 17592186343131} {:answer/id #uuid "84a8edc1-a88f-5434-afb0-143e81012a89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$12$ and $8$" :db/id #edb/ref 17592186343372} {:answer/id #uuid "abe395a2-a154-5294-8225-b25996255c90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $6$" :db/id #edb/ref 17592186343751} {:answer/id #uuid "d30a39f9-5218-5a0d-9fba-e6226fea77be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $3$" :db/id #edb/ref 17592186344090}] :answer-field/correct {:db/id #edb/ref 17592186343751} :answer-field/id #uuid "59951fee-072e-57e6-a856-742c18a4ab71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344644}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e4e0a287-1212-5e98-875c-b8a10ba64112" :question/math-academy-id "q-7595" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{9}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=16$ and ${b}^{2}=9.$\n\n- Since ${a}^{2}=16,$ the length of the horizontal radius must be  $a=\\sqrt{16}=4.$\n\n- Since ${b}^{2}=9,$ the length of the vertical radius must be $b=\\sqrt{9}=3.$\n\nSo the semi-major axis has length $a=4,$ and the semi-minor axis has length $b=3.$\n\nTherefore, the major axis has length $2a=2\\cdot 4=8,$ and the minor axis has length $2b=2\\cdot 3=6.$"}] [{:db/id #edb/ref 17592186345157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b4bbdd7-3b6a-517b-9ed6-1c446dcec71a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $4$" :db/id #edb/ref 17592186342857} {:answer/id #uuid "74e98528-55f2-5075-9918-6944dd0fae8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ and $16$" :db/id #edb/ref 17592186343250} {:answer/id #uuid "93976b13-3f0e-58d6-b564-21e806715d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $2$" :db/id #edb/ref 17592186343531} {:answer/id #uuid "d72c0683-cce5-5c5b-b1ee-f4a799dd53cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $8$" :db/id #edb/ref 17592186344126} {:answer/id #uuid "dc66f534-da0e-5146-9fee-e309f47a07d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$50$ and $32$" :db/id #edb/ref 17592186344173}] :answer-field/correct {:db/id #edb/ref 17592186344126} :answer-field/id #uuid "59484f16-7ef8-58ef-819d-3d6908e8ec4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344643}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "548834cd-5f39-5629-b131-aad9f4ac51b6" :question/math-academy-id "q-7601" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$$\n\\displaystyle \\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{25}=1?\n$$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=16$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=16,$ the length of the horizontal radius must be $a=\\sqrt{16}=4.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nSo the semi-major axis has length $b=5,$ and the semi-minor axis has length $a=4.$\n\nTherefore, the major axis has length $2b=2\\cdot 5=10,$ and the minor axis has length $2a=2\\cdot 4=8.$"}] [{:db/id #edb/ref 17592186345158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09932463-c5ae-59d4-9a1f-8f7b93b1e39e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186342317} {:answer/id #uuid "0fde284f-a456-53ec-9d8f-0544d1aada84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186342375} {:answer/id #uuid "168b385f-5a94-575d-a63a-f2ac457d8eb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{1}=1" :db/id #edb/ref 17592186342440} {:answer/id #uuid "9062242e-5334-5a2e-9f74-55287a13161a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186343501} {:answer/id #uuid "e7356bbf-885d-5a76-ba7a-55f84c4f9035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186344267}] :answer-field/correct {:db/id #edb/ref 17592186343501} :answer-field/id #uuid "4e169c08-9580-5cff-91b2-b2f2a723f60d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344626}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "802974bf-a2fe-59d8-9a6a-a2db7dc5159c" :question/math-academy-id "q-7602" :question/problem "![](images/bc/bcac8eb60e0603ee38bd200b15072685a2bcebb834d490fb4e5a0c318f401096.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=1$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a06fb7-fb76-56d8-b6e1-f809612a62d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186342506} {:answer/id #uuid "25b26601-0bd0-5ba9-8edc-93a16701e235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186342556} {:answer/id #uuid "325931bd-edd2-5aee-b4bb-db09428a96e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186342663} {:answer/id #uuid "d456c171-7bf0-551c-826b-9b80db67e5fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{18}+\\frac{{y}^{2}}{25}=1" :db/id #edb/ref 17592186344101} {:answer/id #uuid "f9b91c50-fe18-5dce-ac87-c7a197511c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186344434}] :answer-field/correct {:db/id #edb/ref 17592186342506} :answer-field/id #uuid "ffbc37fc-8913-56b6-aa24-4d3f0156cd73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344943}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efae30e0-3c67-576a-b125-57ed6ed688b6" :question/math-academy-id "q-7608" :question/problem "![](images/20/202dec2a2e75aa6720181eb925f98999031453f8f1f8822dd86d7a2baab21396.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a798c75-1028-50da-906a-6ce771bdb6db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{6x}+B{e}^{x}" :db/id #edb/ref 17592186342718} {:answer/id #uuid "675b97cc-6fe3-576e-a8b0-ea424f9b4bbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-6x}+B{e}^{x}" :db/id #edb/ref 17592186343116} {:answer/id #uuid "6c0cd778-fdd7-5863-a3b0-a558825aa1ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+B{e}^{2x}" :db/id #edb/ref 17592186343160} {:answer/id #uuid "8d57ddf6-b4a7-5b27-8140-3be19d35a4c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-3x}+B{e}^{-x}" :db/id #edb/ref 17592186343473} {:answer/id #uuid "d27295fb-5989-5da0-97fb-dba7880bc9c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-3x}+B{e}^{2x}" :db/id #edb/ref 17592186344083}] :answer-field/correct {:db/id #edb/ref 17592186344083} :answer-field/id #uuid "7cc586f7-7f72-5b99-b598-b4cbc0b3d2be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344716}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "90a25429-7c22-5d0a-a1ee-3b92bacbd5ae" :question/math-academy-id "q-7782" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\frac{\\text{d}y}{\\text{d}x}-6y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+\\lambda {e}^{\\lambda x}-6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+\\lambda -6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+\\lambda -6.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +3)(\\lambda -2)=0,\n$$\n\nand so $\\lambda =-3$ or $\\lambda =2.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-3x}+B{e}^{2x}.\n$$"}] [{:db/id #edb/ref 17592186345344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65848ef8-449f-52ef-afe9-6880f5eaceaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{3x}+B{e}^{2x}" :db/id #edb/ref 17592186343099} {:answer/id #uuid "8706118c-ae3c-5ece-9c81-360268a04874" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{4x}+B{e}^{x}" :db/id #edb/ref 17592186343403} {:answer/id #uuid "9f458148-b886-5b6d-9407-50ebbbf6adab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-3x}+B{e}^{3x}" :db/id #edb/ref 17592186343644} {:answer/id #uuid "b783c6e3-65ed-57a8-b014-28317b91eb91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-3x}+B{e}^{x}" :db/id #edb/ref 17592186343846} {:answer/id #uuid "f6c29463-12e8-5380-b231-4b0df6dd30ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+B{e}^{-x}" :db/id #edb/ref 17592186344410}] :answer-field/correct {:db/id #edb/ref 17592186343846} :answer-field/id #uuid "38ea9890-a05d-5af7-84e8-3240d9ee883e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344590}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4721b7fe-866d-52da-8089-b7acfe28a0b8" :question/math-academy-id "q-7783" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+2\\frac{\\text{d}y}{\\text{d}x}-3y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+2\\lambda {e}^{\\lambda x}-3{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+2\\lambda -3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+2\\lambda -3=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +3)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =-3$ or $\\lambda =1.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-3x}+B{e}^{x}.\n$$"}] [{:db/id #edb/ref 17592186348217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c251d4a-f0c0-5a48-8e3e-7592f3c7a8d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x+{e}^{-3x}-4" :db/id #edb/ref 17592186345744} {:answer/id #uuid "5e801574-e220-5db2-a084-a19a5433b090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}-3{e}^{-x}" :db/id #edb/ref 17592186346166} {:answer/id #uuid "781de7e7-abc0-5010-a18b-6acb28d569ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={x}^{2}-3{e}^{-x}+2" :db/id #edb/ref 17592186346405} {:answer/id #uuid "d8d86e1b-6bec-5f73-8e1e-04c4c97f4533" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4x+{e}^{-3x}-4" :db/id #edb/ref 17592186347262} {:answer/id #uuid "ec8bcfe8-08ab-5bf7-879a-4e9b26f6d9cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2{e}^{-x}-1" :db/id #edb/ref 17592186347438}] :answer-field/correct {:db/id #edb/ref 17592186346166} :answer-field/id #uuid "a5f056d2-0c8e-5224-b4ba-23c1cec61974" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347897}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d0357fe4-4d50-5037-a26c-ebfd87a1a2f3" :question/math-academy-id "q-79371" :question/problem "Find the particular solution to the differential equation ${e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x}=3$ that satisfies $y(0)=-3.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}{e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x} & =3 \\\\ {e}^{x}\\frac{\\text{d}y}{\\text{d}x} & =3+2x{e}^{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =3{e}^{-x}+2x \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3{e}^{-x}+2x)\\,\\text{d}x \\\\ \\int \\,\\text{d}y & =\\int 3{e}^{-x}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\ y & =-3{e}^{-x}+{x}^{2}+C.\\end{aligned}\n$$\n\nWe now apply the initial condition $y(0)=-3$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =-3 \\\\ -3{e}^{-0}+{0}^{2}+C & =-3 \\\\ C-3 & =-3 \\\\ C & =0\\,.\\end{aligned}\n$$\n\nThus the particular solution of ${e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x}=3$ that satisfies the condition $y(0)=-3$ is\n\n$$\ny={x}^{2}-3{e}^{-x}.\n$$"}] [{:db/id #edb/ref 17592186348218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "451f3842-16b6-5866-9651-73784c8644e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{x}^{4}-x+2}{2}\\right)" :db/id #edb/ref 17592186345950} {:answer/id #uuid "58be30d8-ef50-5ef7-b5f3-523380bbc11f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{x}^{2}+1}{2}\\right)" :db/id #edb/ref 17592186346113} {:answer/id #uuid "70a616da-72b0-575c-adfa-c326848aeb16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡({x}^{2}+2x-2)" :db/id #edb/ref 17592186346340} {:answer/id #uuid "816eafe7-746e-5226-88e6-c6e7b7b43820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡({x}^{4}-x+1)" :db/id #edb/ref 17592186346482} {:answer/id #uuid "f1baeeb1-4f87-5895-9e67-a1a7e8844e32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡({x}^{4}-x)" :db/id #edb/ref 17592186347490}] :answer-field/correct {:db/id #edb/ref 17592186346482} :answer-field/id #uuid "ea329cec-2c85-5a3c-ae6a-b47fc15cd1cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348015}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49fb438b-3c89-5f2d-ad22-0703828a1cf7" :question/math-academy-id "q-79373" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}+{e}^{-y}=4{x}^{3}{e}^{-y}$ that satisfies $y(1)=0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}+{e}^{-y} & =4{x}^{3}{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =4{x}^{3}{e}^{-y}-{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(4{x}^{3}-1){e}^{-y} \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =4{x}^{3}-1 \\\\ \\int {e}^{y}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (4{x}^{3}-1)\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int (4{x}^{3}-1)\\,\\text{d}x \\\\ {e}^{y} & ={x}^{4}-x+C.\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡({x}^{4}-x+C) \\\\ y & =\\operatorname{ln}⁡({x}^{4}-x+C)\\end{aligned}\n$$\n\nWe now apply the initial condition $y(1)=0$ to find $C:$\n\n$$\n\\begin{aligned}y(1) & =0 \\\\ \\operatorname{ln}⁡({1}^{4}-1+C) & =0 \\\\ \\operatorname{ln}⁡C & =0 \\\\ C & =1\\,.\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}+{e}^{-y}=4{x}^{3}{e}^{-y}$ that satisfies the condition $y(1)=0$ is\n\n$$\ny=\\operatorname{ln}⁡({x}^{4}-x+1).\n$$"}] [{:db/id #edb/ref 17592186348224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02894820-667a-5bb1-8d2d-4a0e95595d4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}=3{e}^{x}-2" :db/id #edb/ref 17592186345370} {:answer/id #uuid "1d756a9d-9a70-50be-87ba-3a12ce907a55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}=2{e}^{{x}^{2}}-1" :db/id #edb/ref 17592186345607} {:answer/id #uuid "4914777d-f2b5-57b0-a44a-c23834802afd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{e}^{x}-1" :db/id #edb/ref 17592186345974} {:answer/id #uuid "b5d0bd7d-ae6a-5b73-af44-998074dd148c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}={e}^{{x}^{2}}" :db/id #edb/ref 17592186346935} {:answer/id #uuid "d13ddd57-da35-5009-922f-44e87553a2f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}=3{e}^{{x}^{2}}-2" :db/id #edb/ref 17592186347184}] :answer-field/correct {:db/id #edb/ref 17592186347184} :answer-field/id #uuid "d0ce2963-49b7-5510-bb64-1ea4168634e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347969}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "64550cf0-ae14-5b89-b54c-860d29b3d527" :question/math-academy-id "q-79425" :question/problem "Find the particular solution to the differential equation $3{y}^{2}\\frac{\\text{d}y}{\\text{d}x}-2x{y}^{3}=4x$ that satisfies $y(0)=1.$  Assume that $y>0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}3{y}^{2}\\frac{\\text{d}y}{\\text{d}x}-2x{y}^{3} & =4x \\\\ 3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x(2+{y}^{3}) \\\\ \\frac{3{y}^{2}}{2+{y}^{3}}\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ \\int \\frac{3{y}^{2}}{2+{y}^{3}}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{3{y}^{2}}{2+{y}^{3}}\\,\\text{d}y & ={x}^{2}+{C}_{1}.\\end{aligned}\n$$\n\nTo calculate the integral on the left-hand side of this equality, we use a substitution\n\n$$\nu=2+{y}^{3}\\,⟹\\,\\text{d}u=3{y}^{2}\\,\\text{d}y.\n$$\n\nThen  we have\n\n$$\n\\begin{aligned}\\int \\frac{3{y}^{2}}{2+{y}^{3}}\\text{d}y & =\\int \\frac{1}{2+{y}^{3}}(3{y}^{2}\\,\\text{d}y) \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+{C}_{2} \\\\  & =\\operatorname{ln}⁡(2+{y}^{3})+{C}_{2},\\end{aligned}\n$$\n\nwhere we used that $y>0.$\n\nHence,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2+{y}^{3})+{C}_{2} & ={x}^{2}+{C}_{1} \\\\ \\operatorname{ln}⁡(2+{y}^{3}) & ={x}^{2}+{C}_{1}-{C}_{2} \\\\ {e}^{\\operatorname{ln}⁡(2+{y}^{3})} & ={e}^{{x}^{2}+{C}_{1}-{C}_{2}} \\\\ 2+{y}^{3} & =K{e}^{{x}^{2}} \\\\ {y}^{3} & =K{e}^{{x}^{2}}-2,\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{{C}_{1}-{C}_{2}}$ is an arbitrary constant. \n\nWe now apply the initial condition $y(0)=1$ to find $K:$\n\n$$\n\\begin{aligned}{1}^{3} & =K{e}^{{0}^{2}}-2 \\\\ 1 & =K-2 \\\\ K & =3\\,.\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}=3{e}^{{x}^{2}}-2.\n$$"}] [{:db/id #edb/ref 17592186348235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4239f824-0cdb-56c2-b03e-ba26979ede69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4}{5}\\,{x}^{3/2}+C{x}^{2}+D" :db/id #edb/ref 17592186345918} {:answer/id #uuid "4f0b8e6e-4ec7-58f9-81fa-5762778dd80c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4}{15}\\,{x}^{5/2}+Cx+D" :db/id #edb/ref 17592186346028} {:answer/id #uuid "517c9cdb-fafc-50c3-8c25-73b1c9f3a696" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{15}\\,{x}^{5/2}+C{x}^{2}+D" :db/id #edb/ref 17592186346052} {:answer/id #uuid "8b73bf1b-fafc-5923-a918-fb2d34e27d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{15}\\,{x}^{5/2}+Cx+D" :db/id #edb/ref 17592186346559} {:answer/id #uuid "995de1a6-1b5d-505e-b32d-431f2c275661" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{3}\\,{x}^{3/2}+Cx+D" :db/id #edb/ref 17592186346686}] :answer-field/correct {:db/id #edb/ref 17592186346028} :answer-field/id #uuid "a14bd67c-bf99-5b34-a9b6-546acd076bc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347887}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49effcbe-cf5f-52f7-9899-b28e9803c299" :question/math-academy-id "q-79554" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\sqrt{x}=0.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\sqrt{x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3}{x}^{3/2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\frac{2}{3}{x}^{3/2}+C)\\text{d}x \\\\ y & =\\frac{2}{3}\\int {x}^{3/2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =\\frac{2}{3}(\\frac{2}{5}\\,{x}^{5/2})+Cx+D \\\\  & =\\frac{4}{15}\\,{x}^{5/2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186348237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c8e0e4-b6b0-5ce5-a177-56e9965046e1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/af/af10bb7e5a91561be6d83950803920c8c74aeee40f7982c0564250f707628cbb.png" :db/id #edb/ref 17592186345390} {:answer/id #uuid "6240cadb-35f1-579b-8dae-223167fd3a72" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ff/ff60bb4fceb52346f5f9b4275343729a737dd52e0283beaaeb4d740e1751feca.png" :db/id #edb/ref 17592186346210} {:answer/id #uuid "af89ef40-65f5-59fa-8b28-5017f226cfb7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8c/8ca894c5a5ca9e93af8c39242ba1584447472bb81c872e1225c52a4fbc652e1c.png" :db/id #edb/ref 17592186346881} {:answer/id #uuid "c710ab4c-0a89-5ed1-93ff-d7f8f762fb71" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/99/9908bd23538332705791bbd968dfdf5e22ddde8884aaa9fed58268bc1132d208.png" :db/id #edb/ref 17592186347081} {:answer/id #uuid "e21e3502-e73e-54c9-aa07-914a1e444c55" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09fb3125c260d2f042ec3a509bb7e776d0d47ece3e78255931f8bc9781aa31c8.png" :db/id #edb/ref 17592186347338}] :answer-field/correct {:db/id #edb/ref 17592186345390} :answer-field/id #uuid "499a21fe-5105-56a0-88bc-df91046ea02d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347729}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93e33eaf-8744-5d73-a1ee-4660c16a2922" :question/math-academy-id "q-79565" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2x?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =2\\int x\\,\\text{d}x \\\\  & ={x}^{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](images/fa/fa13b048e5ca54c7074bbf6ec11421bfd8fb9e1618abd732a5faa1d78372a863.png)"}] [{:db/id #edb/ref 17592186348238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4493079c-7314-5dbc-a7dd-26d9f676b1a0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f5/f55575ecf51ce707283ca5bf8e8020e7384ebe65348196e3aa0581697addf7c0.png" :db/id #edb/ref 17592186345943} {:answer/id #uuid "6b147da5-9140-5642-abc7-5f86d8aaa861" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4d/4da0b446c5fa2cbc1e7cd36b23be142487ecd2d7c83f55276b249a712e49d343.png" :db/id #edb/ref 17592186346277} {:answer/id #uuid "8f230d08-b0a5-5fda-9093-79d2086df5c7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6c/6c67b35b6dad5ac54d013f3ea3c20be662a09c3b793ee71f08baa45bcba4362c.png" :db/id #edb/ref 17592186346595} {:answer/id #uuid "910a1429-caa6-56d9-805c-3ab3c00d0e21" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1c/1c0d59930937ca24873ee68b8234647e59d65d075aaa7b2409adf814c274e3dd.png" :db/id #edb/ref 17592186346615} {:answer/id #uuid "ee5b8043-adad-55be-b956-cc8d0a7cfa0c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/10/108aed53018d6fd0737f2e7725a87554342e20067e5035ff87959fcda2885d73.png" :db/id #edb/ref 17592186347455}] :answer-field/correct {:db/id #edb/ref 17592186345943} :answer-field/id #uuid "4f8c20b8-d98b-51f0-af50-31f2e296e0b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347741}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9ba32d8-4493-5d23-b5e3-204324cba975" :question/math-academy-id "q-79566" :question/problem "Which of the following shows some of the solution curves of the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{2}(x+2)^{2}.\n$$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{3}{2}(x+2)^{2}\\,\\text{d}x \\\\ y & =\\frac{3}{2}\\int (x+2)^{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}(x+2)^{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](images/2e/2ef13d3c7516974afcb94986ee9198b61d263f0ef53c344c02a5a8eb849e2c38.png)"}] [{:db/id #edb/ref 17592186348250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e364992-7edc-53f1-910c-f390251a729e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt[3]{\\frac{K}{x}+1}" :db/id #edb/ref 17592186345466} {:answer/id #uuid "22166d6d-c75b-5d4d-95dd-c959a62939dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt[3]{K-\\frac{1}{x}}" :db/id #edb/ref 17592186345656} {:answer/id #uuid "a530df5f-1758-5257-88f9-0923a1b1b0c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{K+\\frac{1}{x}}" :db/id #edb/ref 17592186346791} {:answer/id #uuid "c7fec27b-d196-52e9-95f2-c4377198d22c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{K-\\frac{2}{x}}" :db/id #edb/ref 17592186347091} {:answer/id #uuid "d8069f30-9bf0-5b4e-9f9e-9c10ba0b9d32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt[3]{K-\\frac{3}{x}}" :db/id #edb/ref 17592186347253}] :answer-field/correct {:db/id #edb/ref 17592186347253} :answer-field/id #uuid "316512c9-9dd3-57da-a367-ec001996e486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7875009d-90d4-5d80-94fc-0c8d789c5fc8" :question/math-academy-id "q-79660" :question/problem "Find the general solution to the differential equation $(xy)^{2}\\,\\frac{\\text{d}y}{\\text{d}x}=1$ for $x\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}(xy)^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ {x}^{2}{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ \\int {y}^{2}\\,\\text{d}y & =\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ \\frac{1}{3}{y}^{3} & =-\\frac{1}{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{1}{3}{y}^{3}=C-\\frac{1}{x}.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\frac{1}{3}{y}^{3} & =C-\\frac{1}{x} \\\\ {y}^{3} & =3C-\\frac{3}{x} \\\\ y & =\\sqrt[3]{3C-\\frac{3}{x}} \\\\ y & =\\sqrt[3]{K-\\frac{3}{x}}\\end{aligned}\n$$\n\nwhere $K=3C.$"}] [{:db/id #edb/ref 17592186348251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a97ce8d-6961-5e39-bc06-a013c948432b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{\\sqrt{{x}^{3}+{x}^{2}}}" :db/id #edb/ref 17592186345433} {:answer/id #uuid "5564c19a-cbe2-58bc-ba00-963c24b8358a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{\\sqrt{3{x}^{2}+2x}}" :db/id #edb/ref 17592186346075} {:answer/id #uuid "614aee15-ac05-53b6-ba2c-564ddddc0d85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{{x}^{3}+{x}^{2}}" :db/id #edb/ref 17592186346195} {:answer/id #uuid "7a0a5e6f-53c5-57f6-ab14-08940078f3d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{6x+2}" :db/id #edb/ref 17592186346420} {:answer/id #uuid "bbeca412-cbe7-524d-9ed5-77012bdbf6fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{3{x}^{2}+2x}" :db/id #edb/ref 17592186346984}] :answer-field/correct {:db/id #edb/ref 17592186346195} :answer-field/id #uuid "bfb7e4f2-96b5-5898-b4a9-72b2a6f8b019" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "723d85e2-15cf-520f-80d9-dfe4f98e64df" :question/math-academy-id "q-79663" :question/problem "Find the general solution to the differential equation ${y}^{′}-2xy=3{x}^{2}y$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}-2xy & =3{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x}-2xy & =3{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}y+2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(3{x}^{2}+2x)y \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}+2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3{x}^{2}+2x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (3{x}^{2}+2x)\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & ={x}^{3}+{x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|={x}^{3}+{x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & ={x}^{3}+{x}^{2}+C \\\\ |y| & ={e}^{{x}^{3}+{x}^{2}+C} \\\\ |y| & ={e}^{{x}^{3}+{x}^{2}}\\cdot {e}^{C} \\\\ |y| & =K{e}^{{x}^{3}+{x}^{2}}\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{{x}^{3}+{x}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186348252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007ed2e6-bd51-5024-8a95-96aa09f05e0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{{x}^{3}+{x}^{2}}+C" :db/id #edb/ref 17592186345357} {:answer/id #uuid "9e50d021-a50c-5e77-832f-1a3dc9472b6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2{x}^{3}+x+C}" :db/id #edb/ref 17592186346729} {:answer/id #uuid "a9f321b9-654c-59f1-9a98-a1f9fbd24b88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{{x}^{2}-x}+C" :db/id #edb/ref 17592186346835} {:answer/id #uuid "bf4a829c-cabc-5c66-816d-f53731b75309" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{{x}^{3}+{x}^{2}+C}" :db/id #edb/ref 17592186347005} {:answer/id #uuid "cfbd2b2e-b768-5790-8750-258301711938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{C}{2{x}^{3}+x}" :db/id #edb/ref 17592186347168}] :answer-field/correct {:db/id #edb/ref 17592186346729} :answer-field/id #uuid "031df737-e5b5-5c2a-8346-08d047fd5540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347613}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9654e7b6-ccd8-562c-817c-0c6175953f88" :question/math-academy-id "q-79664" :question/problem "Find the general solution to the differential equation ${y}^{′}-{y}^{2}=6{x}^{2}{y}^{2}$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}-{y}^{2} & =6{x}^{2}{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}-{y}^{2} & =6{x}^{2}{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}{y}^{2}+{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(6{x}^{2}+1){y}^{2} \\\\ \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}+1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (6{x}^{2}+1)\\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}}\\,\\text{d}y & =\\int (6{x}^{2}+1)\\,\\text{d}x \\\\ -\\frac{1}{y} & =2{x}^{3}+x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n-\\frac{1}{y}=2{x}^{3}+x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2{x}^{3}+x+C}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d16c4a6-ec99-5254-95d5-c2498c545a1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={({x}^{3}+K)}^{2}" :db/id #edb/ref 17592186346012} {:answer/id #uuid "a9c2462b-f997-5c04-b171-95ec7c69c289" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(\\frac{1}{3}{x}^{3/2}+K)}^{2}" :db/id #edb/ref 17592186346834} {:answer/id #uuid "aea245a2-f864-583c-93ae-1ffebcc63b01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{9}\\,{x}^{3/2}+K" :db/id #edb/ref 17592186346874} {:answer/id #uuid "ba319483-e1c6-5bee-ad75-c8afa87e7451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{9}\\,{x}^{3}+K" :db/id #edb/ref 17592186346969} {:answer/id #uuid "ec814b88-7549-5acd-8292-f5bca233d961" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(3{x}^{1/2}+K)}^{2}" :db/id #edb/ref 17592186347437}] :answer-field/correct {:db/id #edb/ref 17592186346834} :answer-field/id #uuid "798d40ee-1bd1-5a20-9b4d-e3b5e219a75d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347820}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a2bae15-170e-5e1c-8377-f10d9fc5ad9d" :question/math-academy-id "q-79665" :question/problem "Find the general solution to the differential equation $\\frac{1}{\\sqrt{xy}}\\,{y}^{′}=1$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{xy}}{y}^{′} & =1 \\\\ \\frac{1}{\\sqrt{xy}}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int \\frac{1}{\\sqrt{y}}\\,\\text{d}y & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int {y}^{-1/2}\\,\\text{d}y & =\\int {x}^{1/2}\\,\\text{d}x \\\\ 2{y}^{1/2} & =\\frac{2}{3}{x}^{3/2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n2{y}^{1/2}=\\frac{2}{3}{x}^{3/2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}2{y}^{1/2} & =\\frac{2}{3}{x}^{3/2}+C \\\\ {y}^{1/2} & =\\frac{1}{3}{x}^{3/2}+\\frac{C}{2} \\\\ y & ={(\\frac{1}{3}{x}^{3/2}+\\frac{C}{2})}^{2} \\\\ y & ={(\\frac{1}{3}{x}^{3/2}+K)}^{2}\\end{aligned}\n$$\n\nwhere $K=\\frac{C}{2}.$"}] [{:db/id #edb/ref 17592186348254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1427b6f0-45ab-57a3-bbd6-50d52ab7a525" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{\\operatorname{cos}⁡x+C}" :db/id #edb/ref 17592186345522} {:answer/id #uuid "15670b68-e9a4-5267-aa5c-b0e904fefa0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{\\operatorname{sec}⁡x+C}" :db/id #edb/ref 17592186345535} {:answer/id #uuid "162c82c1-f74e-5083-bbf9-1dde8b71d2f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{\\sqrt{\\operatorname{cos}⁡x+C}}" :db/id #edb/ref 17592186345546} {:answer/id #uuid "38d35db6-1978-5ad0-9ced-f96355824add" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{\\operatorname{sec}⁡x+C}" :db/id #edb/ref 17592186345836} {:answer/id #uuid "89c06b6b-e914-552e-af45-057aa20eba1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\sqrt{\\operatorname{cos}⁡x+C}" :db/id #edb/ref 17592186346546}] :answer-field/correct {:db/id #edb/ref 17592186346546} :answer-field/id #uuid "04f852ec-a1f8-56f5-8679-e9e9f08dfd90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347617}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d00a6660-7238-556d-8857-0bdcf8cbff05" :question/math-academy-id "q-79666" :question/problem "Find the general solution to the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}+\\frac{\\operatorname{sin}⁡x}{2y}=0\n$$ for $y>0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}+\\frac{\\operatorname{sin}⁡x}{2y} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\operatorname{sin}⁡x}{2y} \\\\ 2y\\,\\frac{\\text{d}y}{\\text{d}x} & =-\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 2y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\int 2y\\,\\text{d}y & =-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ {y}^{2} & =\\operatorname{cos}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{2}=\\operatorname{cos}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\sqrt{\\operatorname{cos}⁡x+C}.\n$$"}] [{:db/id #edb/ref 17592186348308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3f80c3-11e0-53ce-ab4f-c2114d4cd6dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186345454} {:answer/id #uuid "579765a3-79c5-503e-a7d8-df4c043db39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sin}^{2}⁡(2x)" :db/id #edb/ref 17592186346099} {:answer/id #uuid "6cdc93a7-e284-5327-b186-e1e3e8cddce3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{cos}^{2}⁡(2x)" :db/id #edb/ref 17592186346298} {:answer/id #uuid "a961f5ea-2fba-5e69-9513-539eefac46a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186346827} {:answer/id #uuid "d6716acc-a519-5155-ab98-db9047e0d776" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186347239}] :answer-field/correct {:db/id #edb/ref 17592186345454} :answer-field/id #uuid "0c09e4ee-3f79-57c7-b73c-91af0a4b37ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347627}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1435ae2d-a320-5119-ac37-c350e8bda29f" :question/math-academy-id "q-79891" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ and ${y}_{2}(x)=\\operatorname{sin}⁡(2x).$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ and ${y}_{2}(x)=\\operatorname{sin}⁡(2x).$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(\\operatorname{cos}⁡(2x)){(\\operatorname{sin}⁡(2x))}^{′}-(\\operatorname{sin}⁡(2x)){(\\operatorname{cos}⁡(2x))}^{′} \\\\  & =(\\operatorname{cos}⁡(2x))(2\\operatorname{cos}⁡(2x))-(\\operatorname{sin}⁡(2x))(-2\\operatorname{sin}⁡(2x)) \\\\  & =2{cos}^{2}⁡(2x)+2{sin}^{2}⁡(2x) \\\\  & =2({cos}^{2}⁡(2x)+{sin}^{2}⁡(2x)) \\\\  & =2(1) \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d55fd2-ecd0-5a79-b92e-3c231d624583" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186345709} {:answer/id #uuid "3ed41f4c-c263-5893-b628-a235644b865c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x" :db/id #edb/ref 17592186345888} {:answer/id #uuid "a3ac7945-09e7-5b68-aeda-5f073de3fdf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{3}" :db/id #edb/ref 17592186346770} {:answer/id #uuid "f3664608-78f0-5f1f-b489-87201b9f31a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}" :db/id #edb/ref 17592186347503} {:answer/id #uuid "fb904c33-f3a3-5aff-830b-ee7b42d304a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}" :db/id #edb/ref 17592186347569}] :answer-field/correct {:db/id #edb/ref 17592186347503} :answer-field/id #uuid "fa87fa01-88ef-50f6-a2b6-fc94ba7e56db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348044}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1c2008ea-be87-5d3e-820a-be491611181f" :question/math-academy-id "q-79893" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)={x}^{2}$ and ${y}_{2}(x)={x}^{3}.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)={x}^{2}$ and ${y}_{2}(x)={x}^{3}.$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =({x}^{2}){({x}^{3})}^{′}-({x}^{3}){({x}^{2})}^{′} \\\\  & =({x}^{2})(3{x}^{2})-({x}^{3})(2x) \\\\  & =3{x}^{4}-2{x}^{4} \\\\  & ={x}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0671accb-4f80-59d0-b63a-2d4ef61fee1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x" :db/id #edb/ref 17592186345406} {:answer/id #uuid "1e357513-bba7-5ea2-8878-f5cc60ae324e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186345616} {:answer/id #uuid "49064de5-7b71-571e-826c-ae9373e9263b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+3" :db/id #edb/ref 17592186345973} {:answer/id #uuid "50f2439f-1a12-5c5c-9512-ca6bad400415" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186346043} {:answer/id #uuid "ca6ceb55-1e83-515c-954b-e997dd8b7ed4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-1" :db/id #edb/ref 17592186347116}] :answer-field/correct {:db/id #edb/ref 17592186346043} :answer-field/id #uuid "ee05531e-ad43-579c-bafb-ef2b6b592589" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348026}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b1e7581-61c6-579a-9a8d-e9478858536d" :question/math-academy-id "q-79894" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=2x+1$ and ${y}_{2}(x)=x-1.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=\\begin{vmatrix}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{vmatrix}={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)=2x+1$ and ${y}_{2}(x)=x-1.$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(2x+1){(x-1)}^{′}-(x-1){(2x+1)}^{′} \\\\  & =(2x+1)(1)-(x-1)(2) \\\\  & =2x+1-2x+2 \\\\  & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d0084b0-93d4-5ac2-ae43-c8efadc132bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3{x}^{1/3}+K" :db/id #edb/ref 17592186349592} {:answer/id #uuid "7f62d026-75e5-5768-912a-ed4fbc3613ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3{x}^{1/2}+K" :db/id #edb/ref 17592186349615} {:answer/id #uuid "91edbc26-60f5-5d18-b7c2-4b6f55811b81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={(3{x}^{1/2}+K)}^{2/3}" :db/id #edb/ref 17592186349751} {:answer/id #uuid "921e26e7-3d47-5dac-b41a-956375d6101d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={({x}^{1/2}+K)}^{2/3}" :db/id #edb/ref 17592186349755} {:answer/id #uuid "a71d7811-e797-50e1-978f-9b13629b9fe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={({x}^{2/3}+K)}^{1/2}" :db/id #edb/ref 17592186349935}] :answer-field/correct {:db/id #edb/ref 17592186349751} :answer-field/id #uuid "e7df14ce-0a3a-5b35-9828-40dbb7064dd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351117}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d4faf034-eb8a-55d3-93d9-79b525a402a1" :question/math-academy-id "q-8304" :question/problem "Find the general solution to the differential equation $\\sqrt{xy}\\,\\frac{\\text{d}y}{\\text{d}x}=1.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\sqrt{xy}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\sqrt{x}\\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{\\sqrt{x}}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\int \\sqrt{y}\\,\\text{d}y & =\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\int {y}^{1/2}\\,\\text{d}y & =\\int {x}^{-1/2}\\,\\text{d}x \\\\ \\frac{2}{3}{y}^{3/2} & =2{x}^{1/2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{2}{3}{y}^{3/2}=2{x}^{1/2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\frac{2}{3}{y}^{3/2} & =2{x}^{1/2}+C \\\\ {y}^{3/2} & =3{x}^{1/2}+\\frac{3C}{2} \\\\ y & ={(3{x}^{1/2}+\\frac{3C}{2})}^{2/3} \\\\ y & ={(3{x}^{1/2}+K)}^{2/3}\\end{aligned}\n$$\n\nwhere $K=\\frac{3C}{2}.$"}] [{:db/id #edb/ref 17592186351480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30133227-afe7-5481-8b20-5e90c5357811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-x}" :db/id #edb/ref 17592186348873} {:answer/id #uuid "8dc6e6b6-7795-585f-872f-9399fa1852a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186349722} {:answer/id #uuid "9fbd50f1-5563-5199-adb8-f88d72b3446a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186349870} {:answer/id #uuid "dfced686-1189-5123-b1b4-8db75ac9b85e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{x}" :db/id #edb/ref 17592186350409} {:answer/id #uuid "f802ca15-9874-59ee-8efd-bf70059a7581" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x+1" :db/id #edb/ref 17592186350620}] :answer-field/correct {:db/id #edb/ref 17592186350409} :answer-field/id #uuid "643eee79-9b2d-5db9-9284-6c2e12ddc115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c64ef55-bd01-5eed-b990-f133790399ab" :question/math-academy-id "q-8308" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y$  that satisfies $y(0)=1.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =x+C\\,.\\end{aligned}\n$$\n\nApplying the exponential function to both sides, we find the general solution:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{x+C} \\\\ |y| & ={e}^{x+C}\\, \\\\ y & =\\pm {e}^{x+C} \\\\ y & =K{e}^{x}\\,.\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{C}$ is an arbitrary constant. \n\nWe now apply the condition $y(0)=1$ to find $K:$ \n\n$$\n\\begin{aligned}1 & =K{e}^{0} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the particular solution of $\\frac{\\text{d}y}{\\text{d}x}=y$ that satisfies the condition $y(0)=1$ is\n\n$$\ny={e}^{x}\\,.\n$$"}] [{:db/id #edb/ref 17592186351481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa50117-feef-5fb7-b4c7-8d5074635199" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡(2y)=1-\\operatorname{cos}⁡(3x)" :db/id #edb/ref 17592186348870} {:answer/id #uuid "452eaa99-839b-51b9-a716-4597a4aef31a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sin}⁡(2y)=2(1-\\operatorname{cos}⁡(3x))" :db/id #edb/ref 17592186349076} {:answer/id #uuid "74fe7c6f-36b4-5a32-8184-47101e4f7568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(2y)=1-\\operatorname{cos}⁡(3x)" :db/id #edb/ref 17592186349521} {:answer/id #uuid "80940eb3-3340-5a50-8f91-c8c22404f7b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡(2y)=2(1-\\operatorname{cos}⁡(3x))" :db/id #edb/ref 17592186349628} {:answer/id #uuid "b1b526ac-6987-52e6-b725-e6fce574b42d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(2y)=\\operatorname{cos}⁡(3x)" :db/id #edb/ref 17592186350018}] :answer-field/correct {:db/id #edb/ref 17592186349628} :answer-field/id #uuid "aae6146f-444d-5de3-893c-8276bf7fa71f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351001}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "61f94262-435d-5c53-971b-8da63f6d82a0" :question/math-academy-id "q-8309" :question/problem "Find the particular solution to the differential equation ${y}^{′}=\\frac{\\operatorname{sin}⁡(3x)}{\\operatorname{cos}⁡(2y)}$ that satisfies $y(0)=0.$ Assume that $-\\frac{\\pi }{4}<y<\\frac{\\pi }{4}.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\operatorname{sin}⁡(3x)}{\\operatorname{cos}⁡(2y)} \\\\ (\\operatorname{cos}⁡(2y))\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{sin}⁡(3x) \\\\ \\int (\\operatorname{cos}⁡(2y))\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\ \\int \\operatorname{cos}⁡(2y)\\,\\text{d}y & =\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\ \\frac{1}{2}\\operatorname{sin}⁡(2y) & =-\\frac{1}{3}\\operatorname{cos}⁡(3x)+C \\\\ \\operatorname{sin}⁡(2y) & =-\\frac{2}{3}\\operatorname{cos}⁡(3x)+{C}_{1}\\,,\\end{aligned}\n$$\n\nwhere ${C}_{1}=2C.$\n\nWe now apply the condition $y(0)=0$ to find ${C}_{1}:$\n\n$$\n\\begin{aligned}y(0) & =0 \\\\ \\operatorname{sin}⁡(2\\cdot 0) & =-\\frac{2}{3}\\operatorname{cos}⁡(3\\cdot 0)+{C}_{1} \\\\ \\operatorname{sin}⁡(0) & =-\\frac{2}{3}\\operatorname{cos}⁡(0)+{C}_{1} \\\\ 0 & =-\\frac{2}{3}\\cdot 1+{C}_{1} \\\\ {C}_{1} & =\\frac{2}{3}\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2y) & =\\frac{2}{3}-\\frac{2}{3}\\operatorname{cos}⁡(3x) \\\\  & =\\frac{2}{3}(1-\\operatorname{cos}⁡(3x))\\end{aligned}\n$$\n\nFinally, we can write the above equation as\n\n$$\n3\\operatorname{sin}⁡(2y)=2(1-\\operatorname{cos}⁡(3x)).\n$$"}]}
