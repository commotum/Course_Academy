274e7cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186289762}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2ae58f45-f27a-546f-bea3-1dad22e6710d" :question/math-academy-id "q-2498" :question/problem "$$\n\\displaystyle \\int \\frac{4}{{x}^{2}+1}\\,\\text{d}x=\n$$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =4\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "910b8b6a-55e2-5efa-b9cd-5825d5701abb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{e^{x}} + C" :db/id #edb/ref 17592186062438} {:answer/id #uuid "bf11c64d-2599-567c-a4c2-bf2b27fd9a04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3x} + C" :db/id #edb/ref 17592186062439} {:answer/id #uuid "cfc3b227-c765-5945-8e43-f5f68cce2cf7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e^{\\ln x} + C" :db/id #edb/ref 17592186062440} {:answer/id #uuid "0b175dff-3816-5913-bdba-bedc85309011" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e^{x} + C" :db/id #edb/ref 17592186062441} {:answer/id #uuid "563f491b-0d7b-525b-b7e0-07bf66f59e34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{x}}{3} + C" :db/id #edb/ref 17592186062442}] :answer-field/id #uuid "9bcf16c6-503f-54d0-b03e-1d2abdb7054f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062437}] :question/id #uuid "e73bcc6f-94c4-5a9a-9af2-80bb3faabf75" :question/math-academy-id "q-31244" :question/problem "What is $$\n\\displaystyle \\int3e^{x}dx\n$$?"}] [{:db/id #edb/ref 17592186064731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfff078-9fb4-5b67-bb26-7811957a40b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{e}^{ln⁡x}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "36c4e4d8-ea74-510a-8195-fcca114fa7c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{e}^{x}}{2}+C" :db/id #edb/ref 17592186295573} {:answer/id #uuid "4d71c1ee-dea6-5890-90dd-6cf50a8cd3a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-2x}+C" :db/id #edb/ref 17592186295711} {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} {:answer/id #uuid "cd13943f-d3e1-5920-9b15-4d7240e4db43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{{e}^{x}}+C" :db/id #edb/ref 17592186296342}] :answer-field/correct {:db/id #edb/ref 17592186296256} :answer-field/id #uuid "b94705d1-73b6-521f-a07d-12831457766a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186297018}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/math-academy-id "q-31245" :question/problem "$$\n\\displaystyle \\int -2{e}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "Factoring out the constant $-2$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -2{e}^{x}\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f91348-41c4-59da-9054-29ca395a2dff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{\\ln x} + C" :db/id #edb/ref 17592186062450} {:answer/id #uuid "0c1f6d71-03b1-5b2e-88f6-fb297b2ed172" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln x}{\\ln 5} + C" :db/id #edb/ref 17592186062451} {:answer/id #uuid "36f6ac37-51eb-57a2-a3ff-6f122cc6d6cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\cdot \\frac{4^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062452} {:answer/id #uuid "5ac5273f-b429-5937-9cf1-d1c7eda2cfb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\cdot \\frac{5^{\\ln x}}{\\ln 5} + C" :db/id #edb/ref 17592186062453} {:answer/id #uuid "6a2714d6-38ad-52bb-bd65-61cbd0d301e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\cdot \\frac{5^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062454}] :answer-field/id #uuid "98e96cde-6df7-5835-82c7-e2a56458c62a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186062449}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e19a3f4c-ed35-54ad-b148-0361a3082be0" :question/math-academy-id "q-31248" :question/problem "What is $$\n\\displaystyle \\int4 \\cdot 5^{x}dx\n$$?"}] [{:db/id #edb/ref 17592186064733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb961f21-24f9-5186-8b78-9160a090c5f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln 2} - 10e^{x} + C" :db/id #edb/ref 17592186062456} {:answer/id #uuid "e669465d-2a21-50bb-8844-652cde65cb07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x - 2}{\\ln 2} - 10e^{x} + C" :db/id #edb/ref 17592186062457} {:answer/id #uuid "1fd3cf03-65ba-5dbb-b119-e3a217383f5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2}}{\\ln 2} - e^{x} + C" :db/id #edb/ref 17592186062458} {:answer/id #uuid "36ba2561-d258-5dff-81fe-25738beafe32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{\\ln 2} + e^{10x} + C" :db/id #edb/ref 17592186062459} {:answer/id #uuid "43e299a5-2bc0-592c-8cb9-be8f6744c147" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2^{x}}{\\ln \\mid x \\mid} - 10e^{x} + C" :db/id #edb/ref 17592186062460}] :answer-field/id #uuid "7