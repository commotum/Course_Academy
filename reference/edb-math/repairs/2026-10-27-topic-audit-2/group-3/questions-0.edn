186045498} :answer/value "x + 3\\arctan x + C" :db/id #edb/ref 17592186063170} {:answer/id #uuid "284cb3f3-3751-5ad1-966d-bfa52e06c3d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x + \\arctan x + C" :db/id #edb/ref 17592186063171} {:answer/id #uuid "41921973-b011-5257-a874-f1132f115e70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x - \\arctan x + C" :db/id #edb/ref 17592186063172} {:answer/id #uuid "49728ff1-4b89-5104-b101-ae9dc7fa7384" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x - 5\\arctan x + C" :db/id #edb/ref 17592186063173}] :answer-field/id #uuid "efb04adb-db92-5e07-8e04-82ca903f579b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063168}] :question/id #uuid "026bb058-405f-5c61-94c5-ed33261784bd" :question/math-academy-id "q-49149" :question/problem "What is $$\n\\displaystyle \\int\\frac{x^{2} - 4}{x^{2} + 1}dx\n$$?"}] [{:db/id #edb/ref 17592186064889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1508f44-ef2f-5fb2-833b-2c1cdbc1f242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{2x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063391} {:answer/id #uuid "fb1b5947-8324-568d-a1eb-6bab88724f99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063392} {:answer/id #uuid "10820fcc-08b9-5665-9f14-e212298a861f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - 2x^{2} + C" :db/id #edb/ref 17592186063393} {:answer/id #uuid "1aa00c79-92f8-5479-b7be-d4906d2fca5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e^{x} + 4^{x}\\ln 4 - \\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186063394} {:answer/id #uuid "64107285-5bce-5d52-ac18-a3e7155a4f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e^{x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063395}] :answer-field/id #uuid "6518b595-b387-521a-bcc0-05e2bc70cceb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063390}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5ef23df-cb86-53d4-a2bd-c06a8017fa2b" :question/math-academy-id "q-51102" :question/problem "What is $$\n\\displaystyle \\int(2e^{x} + 4^{x} - 2x)dx\n$$?"}] [{:db/id #edb/ref 17592186064932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e9e8cc-7e2c-5b9c-8895-6a0d01a94483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{3}^{x}}{ln⁡3}+C" :db/id #edb/ref 17592186333213} {:answer/id #uuid "2550874f-8ee9-5a21-ad79-124324b76991" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "ln⁡({3}^{x})+C" :db/id #edb/ref 17592186333335} {:answer/id #uuid "602373f3-a4ef-5989-b10a-66c28e72546b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{x}ln⁡3+C" :db/id #edb/ref 17592186333867} {:answer/id #uuid "93360ddb-2f30-5402-b6bd-6562c3c2c6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{x}+C" :db/id #edb/ref 17592186334300} {:answer/id #uuid "94f01e4b-399e-55ad-bf45-f119b26a99ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{ln⁡x}{ln⁡3}+C" :db/id #edb/ref 17592186334315}] :answer-field/correct {:db/id #edb/ref 17592186333213} :answer-field/id #uuid "fb7cb00b-1c03-5bd1-8af9-27f6fe69ec11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335676}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "709a586a-cd76-5969-9f50-4116711ad7ab" :question/math-academy-id "q-66139" :question/problem "Calculate $$\n\\displaystyle \\int {3}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {3}^{x}\\,\\text{d}x & =\\frac{{3}^{x}}{ln⁡3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068447 :question/id #uuid "d1de6657-82b1-5bcb-b8cc-fd2629d31faa" :question/math-academy-id "e-10832" :question/problem "Find the general solution to the differential equation $y' = \\dfrac {x^2}{y}.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{x}^{2}}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{y} \\\\ y\\,\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{1}{2}{y}^{2} & =\\frac{1}{3}{x}^{3}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\dfrac{1}{2}y^2 = \\dfrac{1}{3}x^3 + C.\n$$\n\nWe can express the solution in the form $y = y(x)$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{y}^{2} & =\\frac{1}{3}{x}^{3}+C \\\\ {y}^{2} & =\\frac{2}{3}{x}^{3}+2C \\\\ y & =\\pm \\sqrt{\\frac{2}{3}{x}^{3}+2C} \\\\ y & =\\pm \\sqrt{\\frac{2}{3}{x}^{3}+K}\\end{aligned}\n$$\n\nwhere $K = 2C.$"}] [{:db/id #edb/ref 17592186068448 :question/id #uuid "23d66cc8-8e5a-5a33-a7a1-c43f5facdcbc" :question/math-academy-id "e-10833" :question/problem "Find the general solution to the differential equation $y' + 2xy = 0$ for $y\\neq 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}+2xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+2xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-2xy \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-2x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =-2\\int x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =-{x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln \\vert y \\vert = -x^2 + C.\n$$\n\nWe're required to write the solution in the form $y = y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & =-{x}^{2}+C \\\\ |y| & ={e}^{-{x}^{2}+C} \\\\ |y| & ={e}^{-{x}^{2}}\\cdot {e}^{C} \\\\ |y| & =K{e}^{-{x}^{2}}\\end{aligned}\n$$\n\nwhere $K = e^C$  and $K > 0.$ \n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny = Ke^{-x^2}.\n$$"}] [{:db/id #edb/ref 17592186068449 :question/id #uuid "32040154-373e-5a10-a460-1d17f6989da0" :question/math-academy-id "e-10849" :question/problem "Given that $x,y \\geq 0,$ separate the variables in the following differential equation: \n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\sqrt{2xy}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\dfrac{1}{g(y)} \\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} =  \\sqrt{2x} \\cdot  \\sqrt{y}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\dfrac{1}{\\sqrt{y}} \\cdot \\dfrac {\\textrm{d}y} {\\textrm{d}x} = \\sqrt{2x}\n$$"}] [{:db/id #edb/ref 17592186068451 :question/id #uuid "d53c6172-978d-57c7-b1f0-e56e892e48a9" :question/math-academy-id "e-10997" :question/problem "Find the general solution to the differential equation $$\n\\displaystyle \\dfrac{\\textrm{d}y}{\\textrm{d}x}\n    =\n    \\dfrac{x}{y}.\n$$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x}{y} \\\\ y\\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int x\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int x\\,\\text{d}x \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+K \\\\ {y}^{2} & ={x}^{2}+2K \\\\ {y}^{2} & ={x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C= 2K.$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\ny^2 = x^2 + C .\n$$"}] [{:db/id #edb/ref 17592186069061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184d638d-4f43-5a61-a9aa-986f3a8d0dbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-\\operatorname{sin}⁡x}+K" :db/id #edb/ref 17592186269471} {:answer/id #uuid "349a3566-02ae-5b67-8d72-7bd88977f0c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{cos}⁡x+K" :db/id #edb/ref 17592186269751} {:answer/id #uuid "64f06b04-a151-5196-a323-0ff963707282" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{ln}⁡\\operatorname{cos}⁡x+K" :db/id #edb/ref 17592186270168} {:answer/id #uuid "a6629602-dc5e-5bc2-92b8-bcfffe8f083a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=K{e}^{-\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186270759} {:answer/id #uuid "e7c59461-10cd-516c-bdd1-affc4f03909b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-\\operatorname{cos}⁡x}+K" :db/id #edb/ref 17592186271296}] :answer-field/correct {:db/id #edb/ref 17592186270759} :answer-field/id #uuid "783e5ec9-8d8f-5c4c-b6d1-cdb57257612e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271723}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "432fe98f-ffaf-5033-958e-d3cb37de9f8b" :question/math-academy-id "q-14244" :question/problem "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{sin}⁡x$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{sin}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =-\\operatorname{cos}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=-\\operatorname{cos}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{-\\operatorname{cos}⁡x+C} \\\\ |y| & ={e}^{-\\operatorname{cos}⁡x+C} \\\\ |y| & ={e}^{-\\operatorname{cos}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{-\\operatorname{cos}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{-\\operatorname{cos}⁡x}.\n$$"}] [{:db/id #edb/ref 17592186069062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b657e03-7993-5721-9a5b-d80240b025be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{{y}^{3}}{3}+y+C" :db/id #edb/ref 17592186269491} {:answer/id #uuid "4f6b4ac3-40cd-56f5-a8ef-2d1ffef6fc5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{tan}⁡(x+C)" :db/id #edb/ref 17592186269985} {:answer/id #uuid "7464bda0-43dc-5fdf-8e19-585d1a9061ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{cot}⁡(x+C)" :db/id #edb/ref 17592186270297} {:answer/id #uuid "a5d74015-a23f-5510-af78-69d656de3331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{sec}⁡(x)+C" :db/id #edb/ref 17592186270754} {:answer/id #uuid "bf138df5-1e52-57d6-bb9c-63f3bc95323c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{tan}⁡(x+1)+C" :db/id #edb/ref 17592186270960}] :answer-field/correct {:db/id #edb/ref 17592186269985} :answer-field/id #uuid "c282741d-f793-55ca-ac4d-c9a4c645b15f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271863}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c17c4aa5-1ffc-5c4e-9267-85cce391b502" :question/math-academy-id "q-14257" :question/problem "Find the general solution to the differential equation ${y}^{′}={y}^{2}+1.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & ={y}^{2}+1 \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={y}^{2}+1 \\\\ \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\text{d}x} & =1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}+1}\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{arctan}⁡(y) & =x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{arctan}⁡(y)=x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\operatorname{tan}⁡(x+C).\n$$"}] [{:db/id #edb/ref 17592186069078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06161b70-c2b1-55cf-b1de-7e7405481b9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{y}={x}^{2}+C" :db/id #edb/ref 17592186272443} {:answer/id #uuid "39421cbc-ac97-518d-bd42-917038547d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{y}={x}^{2}+C" :db/id #edb/ref 17592186272887} {:answer/id #uuid "444dd661-b7e1-574e-8d5f-f13ae9f6b31c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{e}^{2y}=2x+C" :db/id #edb/ref 17592186272968} {:answer/id #uuid "56d2005e-9587-5d20-848f-63f6e43bb679" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{e}^{2y}=x+C" :db/id #edb/ref 17592186273128} {:answer/id #uuid "b3af1ba1-131e-5620-89ed-6381153a413f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{y}={x}^{3}+C" :db/id #edb/ref 17592186273940}] :answer-field/correct {:db/id #edb/ref 17592186272443} :answer-field/id #uuid "45330bec-555f-5499-99ad-e898e9a6b68d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274751}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8653163f-c134-5fe5-8ca8-a073f08d08b4" :question/math-academy-id "q-154359" :question/problem "Find the general solution to the differential equation $$\n\\displaystyle \\frac{\\text{d}y}{\\text{d}x}=\\frac{2x}{{e}^{y}}.\n$$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x}{{e}^{y}} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {e}^{y} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{e}^{y}={x}^{2}+C.\n$$"}] [{:db/id #edb/ref 17592186069079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6d452c-ba79-5770-b07f-d5b3da22c242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡y=x+C" :db/id #edb/ref 17592186273029} {:answer/id #uuid "65ede7b4-590b-55e3-8f50-17be1122ce29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡y=x+C" :db/id #edb/ref 17592186273261} {:answer/id #uuid "787ea476-0dcb-5e79-83e8-2015f52616e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arctan}⁡y=x+C" :db/id #edb/ref 17592186273413} {:answer/id #uuid "bbd47fee-b75d-5148-b300-321c7b06ff4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccos}⁡y=x+C" :db/id #edb/ref 17592186274013} {:answer/id #uuid "bd385d42-fd70-5ecd-bff1-d953008c20fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡y=x+C" :db/id #edb/ref 17592186274023}] :answer-field/correct {:db/id #edb/ref 17592186273261} :answer-field/id #uuid "66f205c9-d7de-5191-ae98-7d9196548f1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc5a6535-55d7-58bf-9da3-473b544214d4" :question/math-academy-id "q-154367" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\sqrt{1-{y}^{2}}\\,$ for $\\,|y|<1.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{1-{y}^{2}} \\\\ \\frac{1}{\\sqrt{1-{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{\\sqrt{1-{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y & =\\int \\text{d}x \\\\ \\operatorname{arcsin}⁡y & =x+C.\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{arcsin}⁡y=x+C.\n$$"}] [{:db/id #edb/ref 17592186069081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12f2bc2f-1fe4-514d-9417-86b74216500d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}}{x+1}" :db/id #edb/ref 17592186272557} {:answer/id #uuid "7fd070c7-31c8-5ed5-9940-dea95036c4e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{x+1}" :db/id #edb/ref 17592186273484} {:answer/id #uuid "a06b58e1-28a4-50ed-ac87-373471256b9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{x+1}" :db/id #edb/ref 17592186273777} {:answer/id #uuid "d2e5e197-f359-54c9-a2da-6fab379f6f8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x+1}{x}\\cdot \\frac{\\text{d}y}{\\text{d}x}={y}^{2}" :db/id #edb/ref 17592186274233} {:answer/id #uuid "dae5896a-987c-5514-adf7-468aaa639a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+1)\\cdot \\frac{\\text{d}y}{\\text{d}x}=x{y}^{2}" :db/id #edb/ref 17592186274301}] :answer-field/correct {:db/id #edb/ref 17592186273777} :answer-field/id #uuid "5e8a4da3-858c-5210-bec3-9666fbd56e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274797}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8143064d-a592-5c44-b653-c218df46c5ef" :question/math-academy-id "q-154678" :question/problem "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x{y}^{2}}{x+1}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\left(\\frac{x}{x+1}\\right)\\cdot {y}^{2}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{x+1}\n$$"}]}
