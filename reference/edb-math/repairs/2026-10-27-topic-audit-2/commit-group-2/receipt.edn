x+y}}.\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)=\\operatorname{sec}^{2}⁡(x-y)-\\operatorname{tan}⁡(x-y).\n$$" 13194139542481 17592186576411 true] [17592186567042 1074 "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nUsing the quotient and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}\\left(\\frac{\\operatorname{tan}⁡(x-y)}{{e}^{x+y}}\\right) \\\\  & =\\frac{\\frac{∂}{∂x}(\\operatorname{tan}⁡(x-y))\\cdot {e}^{x+y}-\\operatorname{tan}⁡(x-y)\\cdot \\frac{∂}{∂x}({e}^{x+y})}{{({e}^{x+y})}^{2}} \\\\  & =\\frac{{sec}^{2}⁡(x-y)\\cdot \\frac{∂}{∂x}(x-y)\\cdot {e}^{x+y}-\\operatorname{tan}⁡(x-y)\\cdot {e}^{x+y}\\cdot \\frac{∂}{∂x}(x+y)}{{({e}^{x+y})}^{2}} \\\\  & =\\frac{{sec}^{2}⁡(x-y)\\cdot 1\\cdot {e}^{x+y}-\\operatorname{tan}⁡(x-y)\\cdot {e}^{x+y}\\cdot 1}{{({e}^{x+y})}^{2}} \\\\  & =\\frac{({sec}^{2}⁡(x-y)-\\operatorname{tan}⁡(x-y)){e}^{x+y}}{{({e}^{x+y})}^{2}} \\\\  & =\\frac{{sec}^{2}⁡(x-y)-\\operatorname{tan}⁡(x-y)}{{e}^{x+y}}.\\end{aligned}\n$$\n\n \n\nTherefore, we conclude that\n\n$$\nh(x,y)={sec}^{2}⁡(x-y)-\\operatorname{tan}⁡(x-y).\n$$" 13194139542481 17592186576411 false] [17592186567047 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule and the product rule:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(xy\\operatorname{tan}⁡({y}^{2})) \\\\  & =x\\frac{∂}{∂y}(y\\operatorname{tan}⁡({y}^{2})) \\\\  & =x(\\frac{∂}{∂y}(y)\\cdot \\operatorname{tan}⁡({y}^{2})+y\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))) \\\\  & =x((1)\\cdot \\operatorname{tan}⁡({y}^{2})+y\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))\\end{aligned}\n$$\n\nThen, we use the chain rule:\n\n$$\n\\begin{aligned}x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2})) & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2})) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\operatorname{sec}^{2}⁡({y}^{2})\\frac{∂}{∂y}({y}^{2}) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy{sec}^{2}⁡({y}^{2})\\cdot (2y) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+2x{y}^{2}\\operatorname{sec}^{2}⁡({y}^{2})\\end{aligned}\n$$" 13194139542481 17592186576411 true] [17592186567047 1074 "We differentiate the given function with respect to $y,$ treating all other variables as constants. \n\nFirst, we use the constant multiple rule and the product rule:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(xy\\operatorname{tan}⁡({y}^{2})) \\\\  & =x\\frac{∂}{∂y}(y\\operatorname{tan}⁡({y}^{2})) \\\\  & =x(\\frac{∂}{∂y}(y)\\cdot \\operatorname{tan}⁡({y}^{2})+y\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))) \\\\  & =x((1)\\cdot \\operatorname{tan}⁡({y}^{2})+y\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2}))\\end{aligned}\n$$\n\nThen, we use the chain rule:\n\n$$\n\\begin{aligned}x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2})) & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡({y}^{2})) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy\\cdot {sec}^{2}⁡({y}^{2})\\frac{∂}{∂y}({y}^{2}) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+xy{sec}^{2}⁡({y}^{2})\\cdot (2y) \\\\  & =x\\operatorname{tan}⁡({y}^{2})+2x{y}^{2}{sec}^{2}⁡({y}^{2})\\end{aligned}\n$$" 13194139542481 17592186576411 false] [17592186582344 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int x{sec}^{2}⁡x\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sec}^{2}⁡x\\, & ⟹\\,v=\\operatorname{tan}⁡x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sec}^{2}⁡x\\,\\text{d}x & =x\\cdot \\operatorname{tan}⁡x-\\int \\operatorname{tan}⁡x\\cdot 1\\,\\text{d}x \\\\  & =x\\operatorname{tan}⁡x-\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral using the substitution $u=\\operatorname{cos}⁡x,$ where $\\text{d}u=-\\operatorname{sin}⁡x\\,\\text{d}x,$ as follows:\n\n$$\n\\begin{aligned}\\int x{sec}^{2}⁡(x)\\,\\text{d}x & =x\\operatorname{tan}⁡x-\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & =x\\operatorname{tan}⁡x-\\int \\frac{1}{u}(-\\text{d}u) \\\\  & =x\\operatorname{tan}⁡x+\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =x\\operatorname{tan}⁡x+\\operatorname{ln}⁡|u|+C \\\\  & =x\\operatorname{tan}⁡x+\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C\\end{aligned}\n$$" 13194139542481 17592186576411 true] [17592186582344 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int x{sec}^{2}⁡x\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={sec}^{2}⁡x\\, & ⟹\\,v=\\operatorname{tan}⁡x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {sec}^{2}⁡x\\,\\text{d}x & =x\\cdot \\operatorname{tan}⁡x-\\int \\operatorname{tan}⁡x\\cdot 1\\,\\text{d}x \\\\  & =x\\operatorname{tan}⁡x-\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral using the substitution $u=\\operatorname{cos}⁡x,$ where $\\text{d}u=-\\operatorname{sin}⁡x\\,\\text{d}x,$ as follows:\n\n$$\n\\begin{aligned}\\int x{sec}^{2}⁡(x)\\,\\text{d}x & =x\\operatorname{tan}⁡x-\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & =x\\operatorname{tan}⁡x-\\int \\frac{1}{u}(-\\text{d}u) \\\\  & =x\\operatorname{tan}⁡x+\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =x\\operatorname{tan}⁡x+\\operatorname{ln}⁡|u|+C \\\\  & =x\\operatorname{tan}⁡x+\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C\\end{aligned}\n$$" 13194139542481 17592186576411 false] [17592186694089 1071 "Calculate\n\n$$\n\\int 6 xe^{- x}\\,\\text{d}x.\n$$" 13194139542481 17592186576411 true] [17592186694089 1071 "Calculate $\\int 6 xe^{- x}\\,\\text{d}x.$" 13194139542481 17592186576411 false] [17592186694090 1071 "$$\n\\int x3^{x}\\,\\text{d}x=\n$$" 13194139542481 17592186576411 true] [17592186694090 1071 "$\\int x3^{x}\\,\\text{d}x=$" 13194139542481 17592186576411 false] [17592186694098 1071 "Calculate\n\n$$\n\\int x4^{x}\\,\\text{d}x.\n$$" 13194139542481 17592186576411 true] [17592186694098 1071 "Calculate $\\int x4^{x}\\,\\text{d}x.$" 13194139542481 17592186576411 false] [17592186694100 1071 "Calculate the integral\n\n$$\n\\int 2 xe^{- x}\\,\\text{d}x.\n$$" 13194139542481 17592186576411 true] [17592186694100 1071 "Calculate the integral $\\int 2 xe^{- x}\\,\\text{d}x.$" 13194139542481 17592186576411 false] [17592186694108 1071 "$$\n\\int 6 xe^{7 x - 4}\\,\\text{d}x=\n$$" 13194139542481 17592186576411 true] [17592186694108 1071 "$\\int 6 xe^{7 x - 4}\\,\\text{d}x=$" 13194139542481 17592186576411 false] [17592186694125 1071 "$$\n\\int 8 xe^{6 x}\\,\\text{d}x=\n$$" 13194139542481 17592186576411 true] [17592186694125 1071 "$\\int 8 xe^{6 x}\\,\\text{d}x=$" 13194139542481 17592186576411 false] [17592186725839 1080 "-3e^{-3x}" 13194139542481 17592186576411 true] [17592186725839 1082 #edb/ref 17592186045498 13194139542481 17592186576411 true] [17592186725839 1083 #uuid "4c8641bf-1828-521d-bcd3-42c22bb0a215" 13194139542481 175921