\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703585} {:answer/id #uuid "60c6291c-d821-586e-8118-443380929340" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703590} {:answer/id #uuid "934501aa-0ccf-52a3-a17a-7697a60a6329" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2}\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703593} {:answer/id #uuid "c162a7b1-3325-5387-b962-fca88d0852b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(x + y^{2}\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703597} {:answer/id #uuid "dd9f76b3-fd50-53eb-9784-1bdbf6e38f73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x y^{2} - 2 y^{4} - 2 y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703599}] :answer-field/correct {:answer/id #uuid "60c6291c-d821-586e-8118-443380929340" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}" :db/id #edb/ref 17592186703590} :answer-field/id #uuid "6a79f399-0de0-5f3a-ad9f-dab2927d7af6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703592}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "22259673-fa26-5ed1-a205-f20f7f26a6f1" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} + 1},\n$$\n\nfind $\\frac{\\partial f}{\\partial x}$, where $x + y^{2} + 1\\ne0$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} + 1$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- y^{2} e^{- x y^{2}}, \\\\\nD_{x}&=1.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- y^{2}$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- y^{2} e^{- x y^{2}}\\right)D-N\\left(1\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} - y^{2} - 1\\right)}{\\left(x + y^{2} + 1\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} + 1\\ne0$."} {:db/id #edb/ref 17592186703589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077231f7-eafb-588e-ae80-23ef77302737" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 2\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703577} {:answer/id #uuid "30416b19-787f-5a3a-9766-2cc6bee0bb12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x y^{2} - 2 y^{4} + 2 y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703583} {:answer/id #uuid "3945d4f4-7852-579d-9b5d-44f096659dab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 2 x y - 2 y\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703584} {:answer/id #uuid "57f0557d-8c27-53a7-b931-cdae1d010d33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703588} {:answer/id #uuid "65692aa5-76ee-53c5-81e5-a128415f581d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x^{2} y^{2} - 2 x y^{4} + 2 x y^{2} - x - y^{6} + 2 y^{4} - 2 y^{2} + 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703591}] :answer-field/correct {:answer/id #uuid "57f0557d-8c27-53a7-b931-cdae1d010d33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}" :db/id #edb/ref 17592186703588} :answer-field/id #uuid "c3e2d419-1a4a-5f40-97cd-dfd16be71203" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703598}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "59a46ae3-091e-5d67-b273-6ba33cc756e4" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} - 1},\n$$\n\nfind $\\frac{\\partial f}{\\partial x}$, where $x + y^{2} - 1\\ne0$." :question/worked-solution "Hold $y$ constant and differentiate with respect to $x$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} - 1$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{x}&=- y^{2} e^{- x y^{2}}, \\\\\nD_{x}&=1.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- y^{2}$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}&=\\frac{N_{x}D-ND_{x}}{D^2} \\\\\n&=\\frac{\\left(- y^{2} e^{- x y^{2}}\\right)D-N\\left(1\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + y^{2} - 1\\right)}{\\left(x + y^{2} - 1\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} - 1\\ne0$."} {:db/id #edb/ref 17592186703594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115edd5a-e36e-5155-b042-47681eb95fd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(4 x^{3} y^{2} + 4 x^{2} y^{4} - 8 x^{2} y^{2} - 2 x^{2} - 2 x y^{2} + 4 x - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703578} {:answer/id #uuid "1bf65ecc-d045-5ee4-b5db-f9935cc050ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- x y^{2} - y^{4} + 2 y^{2} - 1\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703579} {:answer/id #uuid "26286f54-8520-559f-b1ab-9dfb23f78fa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703581} {:answer/id #uuid "2982e09b-d12b-5336-8365-ab3ff027e61c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(x + y^{2} - 2 y - 2\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703582} {:answer/id #uuid "fb037ca2-43d9-5b49-93e8-1c7a24d37edb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703603}] :answer-field/correct {:answer/id #uuid "fb037ca2-43d9-5b49-93e8-1c7a24d37edb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}" :db/id #edb/ref 17592186703603} :answer-field/id #uuid "ed196b42-225c-58c3-8b20-8f4a4d55667e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703600}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a17a2d63-cb15-534d-9625-d8f2f79140f3" :question/problem "For the function\n\n$$\nf(x,y)=\\frac{e^{- x y^{2}}}{x + y^{2} - 2},\n$$\n\nfind $\\frac{\\partial f}{\\partial y}$, where $x + y^{2} - 2\\ne0$." :question/worked-solution "Hold $x$ constant and differentiate with respect to $y$. Write $N=e^{- x y^{2}}$ and $D=x + y^{2} - 2$. The component derivatives are\n\n$$\n\\begin{aligned}\nN_{y}&=- 2 x y e^{- x y^{2}}, \\\\\nD_{y}&=2 y.\n\\end{aligned}\n$$\n\nThe chain rule differentiates the exponent first; its inner derivative is $- 2 x y$. Apply the quotient rule, keeping its subtraction and squared denominator:\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial y}&=\\frac{N_{y}D-ND_{y}}{D^2} \\\\\n&=\\frac{\\left(- 2 x y e^{- x y^{2}}\\right)D-N\\left(2 y\\right)}{D^2} \\\\\n&=\\frac{e^{- x y^{2}}\\left(- 2 x^{2} y - 2 x y^{3} + 4 x y - 2 y\\right)}{\\left(x + y^{2} - 2\\right)^2}.\n\\end{aligned}\n$$\n\nThe last step factors the common nonzero exponential $e^{- x y^{2}}$ from the numerator.  These expressions apply where $x + y^{2} - 2\\ne0$."}] :knowledge-point/title "Applying the Quotient Rule"}]}
