es as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(5y-2\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(5y)-\\frac{∂}{∂x}(2\\operatorname{sin}⁡x) \\\\  & =5\\cdot \\frac{∂}{∂x}(y)-2\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & =5\\cdot (0)-2\\cdot (\\operatorname{cos}⁡x) \\\\  & =-2\\operatorname{cos}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42294efd-0726-56da-9ff2-aacaa739035d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{{y}^{5}}+6x" :db/id #edb/ref 17592186381232} {:answer/id #uuid "e692a74c-4360-52d2-9a3b-14b7bb724d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12{x}^{2}}{{y}^{4}}+6" :db/id #edb/ref 17592186381233} {:answer/id #uuid "e8ed405c-d0bb-58ec-9cb0-db66e314a0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{3}}{{y}^{5}}+6y" :db/id #edb/ref 17592186381234} {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} {:answer/id #uuid "1c43e727-621e-5491-9269-e9a7064dc12d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{{y}^{5}}+6" :db/id #edb/ref 17592186381236}] :answer-field/correct {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} :answer-field/id #uuid "88fa3ce5-5c28-5db2-ada3-b42ead245d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381231}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55f3a1d2-cb7d-5965-acea-2992a42840fe" :question/math-academy-id "q-159618" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\frac{{x}^{3}}{{y}^{4}}+6xy.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}}+6xy) \\\\  & =\\frac{∂}{∂x}\\left(\\frac{{x}^{3}}{{y}^{4}}\\right)+\\frac{∂}{∂x}(6xy) \\\\  & =\\frac{1}{{y}^{4}}\\frac{∂}{∂x}({x}^{3})+6y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{{y}^{4}}\\cdot 3{x}^{2}+6y\\cdot 1 \\\\  & =\\frac{3{x}^{2}}{{y}^{4}}+6y\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6f0ef5-d53d-5837-98c8-631186129434" :answer/type {:db/ident :answer.type/math} :answer/value "32{y}^{3}-\\frac{24y}{{x}^{5}}" :db/id #edb/ref 17592186381239} {:answer/id #uuid "cd8e251a-8b10-5e05-b8e9-664d5a11015b" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381240} {:answer/id #uuid "b39b7828-0e78-591c-b643-6a8cdf575bd5" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381241} {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} {:answer/id #uuid "4b9203e9-d678-558b-b50c-6a4193709f98" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381243}] :answer-field/correct {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} :answer-field/id #uuid "3225480b-17a3-5de3-a894-3b9c909ffb27" :answer-field/key "selection" :answer-field/type {:db/id