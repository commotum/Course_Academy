{3}}" :db/id #edb/ref 17592186563932} {:answer/id #uuid "f0d2d702-1a45-5763-80bf-ddbc0c8e01fe" :answer/type {:db/ident :answer.type/math} :answer/value "8 y^{4} \\cos{\\left(x \\right)} + \\frac{4 y}{x^{2} + 1} + \\frac{2 y^{2}}{x^{3}}" :db/id #edb/ref 17592186563943} {:answer/id #uuid "fb8bd3bb-d891-5b48-b7c5-d72caa5b2b4b" :answer/type {:db/ident :answer.type/math} :answer/value "8 y^{4} \\sin{\\left(x \\right)} + \\frac{4 y}{x^{2} + 1} + \\frac{2 y^{2}}{x^{3}}" :db/id #edb/ref 17592186563944}] :answer-field/correct {:answer/id #uuid "f0d2d702-1a45-5763-80bf-ddbc0c8e01fe" :answer/type {:db/ident :answer.type/math} :answer/value "8 y^{4} \\cos{\\left(x \\right)} + \\frac{4 y}{x^{2} + 1} + \\frac{2 y^{2}}{x^{3}}" :db/id #edb/ref 17592186563943} :answer-field/id #uuid "76582032-af87-5d6f-82c4-522f1be624eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563929}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "358908ba-e0d7-5631-bfea-bfcff1b40f32" :question/problem "Find ${f}_{x}(x,y)$ for $$\n\\displaystyle f(x,y)=8 y^{4} \\sin{\\left(x \\right)}+4 y \\arctan{\\left(x \\right)}- \\frac{y^{2}}{x^{2}}.\n$$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(8 y^{4} \\sin{\\left(x \\right)}+4 y \\arctan{\\left(x \\right)}- \\frac{y^{2}}{x^{2}}) \\\\  & =\\frac{∂}{∂x}(8 y^{4} \\sin{\\left(x \\right)})+\\frac{∂}{∂x}(4 y \\arctan{\\left(x \\right)})-\\frac{∂}{∂x}\\left(\\frac{y^{2}}{x^{2}}\\right) \\\\  & =8 y^{4}\\cdot \\frac{∂}{∂x}(\\sin{\\left(x \\right)})+4 y\\cdot \\frac{∂}{∂x}(\\arctan{\\left(x \\right)})-y^{2}\\cdot \\frac{∂}{∂x}\\left(\\frac{1}{x^{2}}\\right) \\\\  & =8 y^{4}\\cdot \\cos{\\left(x \\right)}+4 y\\cdot \\frac{1}{x^{2} + 1}-y^{2}\\cdot \\left(- \\frac{2}{x^{3}}\\right) \\\\  & =8 y^{4} \\cos{\\left(x \\right)} + \\frac{4 y}{x^{2} + 1} + \\frac{2 y^{2}}{x^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186563923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68032335-7ad1-5905-be82-d1352bbfb651" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{4}}{y} - \\frac{18 x^{2}}{y^{3}} + 2 x e^{y}" :db/id #edb/ref 17592186563925} {:answer/id #uuid "6b97efc7-96e6-548d-9747-5cffdc532dc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{4}}{y} + \\frac{18 x^{2}}{y^{3}} + 2 x e^{y}" :db/id #edb/ref 17592186563926} {:answer/id #uuid "6bc357a2-4d8d-5bb5-83bb-a1d6124f6d08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{4}}{y} + \\frac{18 x^{2}}{y^{3}} + 2 e^{y}" :db/id #edb/ref 17592186563927} {:answer/id #uuid "78b438d2-03af-5ea4-b2a1-c55529c78830" :answer/type {:db/ident :answer.type/math} :answer/value "12 x^{3} \\ln{\\left(y \\right)} - \\frac{18 x}{y^{2}} + 2 e^{y}" :db/id #edb/ref 17592186563930} {:answer/id #uuid "9d4cc921-f6e2-523b-81f3-c30c21971313" :answer/type {:db/ident :answer.type/math} :answer/value "3 x^{4} \\ln{\\left(y \\right)} + \\frac{18 x^{2}}{y^{3}} + 2 x e^{y}" :db/id #edb/ref 17592186563936}] :answer-field/correct {:answer/id #uuid "6b97efc7-96e6-548d-9747-5cffdc532dc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x^{4}}{y} + \\frac{18 x^{2}}{y^{3}} + 2 x e^{y}" :db/id #edb/ref 17592186563926} :answer-field/id #uuid "2d5a7b03-c824-563d-a453-efaa5a4681b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563916}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "53c46985-75bd-5d0e-8acf-681defd4e494" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)=3 x^{4} \\ln{\\left(y \\right)}+2 x e^{y}- \\frac{9 x^{2}}{y^{2}}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(3 x^{4} \\ln{\\left(y \\right)}+2 x e^{y}- \\frac{9 x^{2}}{y^{2}}) \\\\  & =\\frac{∂}{∂y}(3 x^{4} \\ln{\\left(y \\right)})+\\frac{∂}{∂y}(2 x e^{y})-\\frac{∂}{∂y}\\left(\\frac{9 x^{2}}{y^{2}}\\right) \\\\  & =3 x^{4}\\cdot \\frac{∂}{∂y}(\\ln{\\left(y \\right)})+2 x\\cdot \\frac{∂}{∂y}(e^{y})-9 x^{2}\\cdot \\frac{∂}{∂y}\\left(\\frac{1}{y^{2}}\\right) \\\\  & =3 x^{4}\\cdot \\frac{1}{y}+2 x\\cdot e^{y}-9 x^{2}\\cdot \\left(- \\frac{2}{y^{3}}\\right) \\\\  & =\\frac{3 x^{4}}{y} + \\frac{18 x^{2}}{y^{3}} + 2 x e^{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186563935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e86ebca-d073-5614-920c-2c40368c5855" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 x^{4}}{y} - \\frac{24 x^{2}}{y^{5}} + 6 x e^{y}" :db/id #edb/ref 17592186563922} {:answer/id #uuid "5e528259-2bf2-593c-ad87-b336511c725f" :answer/type {:db/ident :answer.type/math} :answer/value "36 x^{3} \\ln{\\left(y \\right)} - \\frac{12 x}{y^{4}} + 6 e^{y}" :db/id #edb/ref 17592186563924} {:answer/id #uuid "86904204-2b1a-5604-96a0-fe1dacd76618" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 x^{4}}{y} + \\frac{24 x^{2}}{y^{5}} + 6 e^{y}" :db/id #edb/ref 17592186563933} {:answer/id #uuid "ad0ad5bb-cac7-5166-853a-00283b9beefc" :answer/type {:db/ident :answer.type/math} :answer/value "9 x^{4} \\ln{\\left(y \\right)} + \\frac{24 x^{2}}{y^{5}} + 6 x e^{y}" :db/id #edb/ref 17592186563937} {:answer/id #uuid "da58126b-9127-5f9d-9267-f655f93757b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 x^{4}}{y} + \\frac{24 x^{2}}{y^{5}} + 6 x e^{y}" :db/id #edb/ref 17