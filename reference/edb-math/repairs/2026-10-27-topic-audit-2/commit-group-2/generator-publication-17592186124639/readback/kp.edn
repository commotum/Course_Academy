{sin}⁡y+y" :db/id #edb/ref 17592186322175} :answer-field/id #uuid "1b693047-cc14-523f-9435-46452a8f9f15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323222}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f09939e1-cd34-5f87-ba1b-e1ac2c9af5b2" :question/math-academy-id "q-35709" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)={x}^{2}\\operatorname{sin}⁡y+xy.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y+xy) \\\\  & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y)+\\frac{∂}{∂x}(xy) \\\\  & =\\operatorname{sin}⁡y\\cdot \\frac{∂}{∂x}({x}^{2})+y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\operatorname{sin}⁡y\\cdot (2x)+y\\cdot (1) \\\\  & =2x\\operatorname{sin}⁡y+y\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186275720} {:answer/id #uuid "48d4574b-09ae-5cd7-8667-6addc311e93c" :answer/type {:db/ident :answer.type/math} :answer/value "xy+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186276125} {:answer/id #uuid "5524be5e-28f5-5433-a5d3-d73957b779a9" :answer/type {:db/ident :answer.type/math} :answer/value "x+{x}^{2}\\operatorname{ln}⁡y" :db/id #edb/ref 17592186276234} {:answer/id #uuid "60ced972-1fd7-5d9e-89b4-5b1ed89abe9f" :answer/type {:db/ident :answer.type/math} :answer/value "y+2x\\operatorname{ln}⁡y" :db/id #edb/ref 17592186276347} {:answer/id #uuid "c6e6df92-0fe0-52bf-ad68-64d6651fef07" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{2x}{y}" :db/id #edb/ref 17592186277246}] :answer-field/correct {:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186275720} :answer-field/id #uuid "9501b870-d0cb-5b61-aa64-68a74b0b08a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277990}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c020eea-053d-5f14-b5a2-c9f697a99828" :question/math-academy-id "q-159613" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=xy+{x}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =\\frac{∂}{∂y}(xy)+\\frac{∂}{∂y}({x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y) \\\\  & =x\\cdot 1+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x+\\frac{{x}^{2}}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb6e91c-e353-5113-a18f-0395e4a6e343" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{y}^{2}}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186276032} {:answer/id #uuid "4118aa52-6cf2-5999-9929-8a5819037289" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276047} {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} {:answer/id #uuid "ebaecd0a-b971-5e92-b62d-28ceae190dc8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{{y}^{2}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186277539} {:answer/id #uuid "f0a09a