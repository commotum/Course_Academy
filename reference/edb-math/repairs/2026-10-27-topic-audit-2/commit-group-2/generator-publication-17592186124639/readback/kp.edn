ac{1}{x^{2}}\\right) \\\\  & =3 y^{4}\\cdot \\frac{1}{x}+4 y\\cdot e^{x}-y^{2}\\cdot \\left(- \\frac{2}{x^{3}}\\right) \\\\  & =4 y e^{x} + \\frac{3 y^{4}}{x} + \\frac{2 y^{2}}{x^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186563939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c8f599d-831f-5be1-a7f2-eb934263746c" :answer/type {:db/ident :answer.type/math} :answer/value "8 x^{4} \\cos{\\left(y \\right)} + \\frac{9 x^{2}}{y^{4}} + \\frac{9}{y^{2} + 1}" :db/id #edb/ref 17592186563910} {:answer/id #uuid "23db01ce-0748-517a-a55b-f582e03db432" :answer/type {:db/ident :answer.type/math} :answer/value "32 x^{3} \\sin{\\left(y \\right)} - \\frac{6 x}{y^{3}} + 9 \\arctan{\\left(y \\right)}" :db/id #edb/ref 17592186563914} {:answer/id #uuid "43a148d3-9892-5fd6-af0e-5e2de55e18bf" :answer/type {:db/ident :answer.type/math} :answer/value "8 x^{4} \\cos{\\left(y \\right)} + \\frac{9 x^{2}}{y^{4}} + \\frac{9 x}{y^{2} + 1}" :db/id #edb/ref 17592186563921} {:answer/id #uuid "913ea125-5439-59c9-937d-f47f89923df9" :answer/type {:db/ident :answer.type/math} :answer/value "8 x^{4} \\sin{\\left(y \\right)} + \\frac{9 x^{2}}{y^{4}} + \\frac{9 x}{y^{2} + 1}" :db/id #edb/ref 17592186563934} {:answer/id #uuid "b76686c0-e762-51a7-9a52-4022ee86fe5f" :answer/type {:db/ident :answer.type/math} :answer/value "8 x^{4} \\cos{\\left(y \\right)} - \\frac{9 x^{2}}{y^{4}} + \\frac{9 x}{y^{2} + 1}" :db/id #edb/ref 17592186563940}] :answer-field/correct {:answer/id #uuid "43a148d3-9892-5fd6-af0e-5e2de55e18bf" :answer/type {:db/ident :answer.type/math} :answer/value "8 x^{4} \\cos{\\left(y \\right)} + \\frac{9 x^{2}}{y^{4}} + \\frac{9 x}{y^{2} + 1}" :db/id #edb/ref 17592186563921} :answer-field/id #uuid "1656178c-d374-56ef-bdd1-26d275bae562" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563912}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b43704d0-6be6-52a5-b0ab-6873dc76da8f" :question/problem "Find ${f}_{y}(x,y)$ for $$\n\\displaystyle f(x,y)=8 x^{4} \\sin{\\left(y \\right)}+9 x \\arctan{\\left(y \\right)}- \\frac{3 x^{2}}{y^{3}}.\n$$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(8 x^{4} \\sin{\\left(y \\right)}+9 x \\arctan{\\left(y \\right)}- \\frac{3 x^{2}}{y^{3}}) \\\\  & =\\frac{∂}{∂y}(8 x^{4} \\sin{\\left(y \\right)})+\\frac{∂}{∂y}(9 x \\arctan{\\left(y \\right)})-\\frac{∂}{∂y}\\left(\\frac{3 x^{2}}{y^{3}}\\right) \\\\  & =8 x^{4}\\cdot \\frac{∂}{∂y}(\\sin{\\left(y \\right)})+9 x\\cdot \\frac{∂}{∂y}(\\arctan{\\left(y \\right)})-3 x^{2}\\cdot \\frac{∂}{∂y}\\left(\\frac{1}{y^{3}}\\right) \\\\  & =8 x^{4}\\cdot \\cos{\\left(y \\right)}+9 x\\cdot \\frac{1}{y^{2} + 1}-3 x^{2}\\cdot \\left(- \\frac{3}{y^{4}}\\right) \\\\  & =8 x^{4} \\cos{\\left(y \\right)} + \\frac{9 x^{2}}{y^{4}} + \\frac{9 x}{y^{2} + 1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1155411d-5f9c-5e6f-8706-5171f919f32b" :answer/type {:db/ident :answer.type/math} :answer/value "6e^{3x+2y}+4xy" :db/id #edb/ref 17592186713063} {:answer/id #uuid "546a68e7-1412-51c1-8974-d345b92f3b77" :answer/type {:db/ident :answer.type/math} :answer/value "e^{3x+2y}+2xy^2" :db/id #edb/ref 17592186713067} {:answer/id #uuid "6283f21b-d0db-59e8-b6e9-f56a327d1a64" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x+2y}+2xy" :db/id #edb/ref 17592186713069} {:answer/id #uuid "89007c04-0eb2-54c1-83cc-ff69c6d279b8" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x+2y}+2xy^2" :db/id #edb/ref 17592186713071} {:answer/id #uuid "e3128806-3813-574f-bef2-c1d6b0bafa26" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{3x+2y}+2x^2y" :db/id #edb/ref 17592186713082}] :answer-field/correct {:answer/id #uuid "89007c04-0eb2-54c1-83cc-ff69c6d279b8" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x+2y}+2xy^2" :db/id #edb/ref 17592186713071} :answer-field/id #uuid "dd63d4bc-902f-5188-8650-967690a75fa6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713080}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1783fd66-9c6d-50c1-b707-f17924761eb3" :question/problem "Find $f_x(x,y)$ for $f(x,y)=e^{3x+2y}+x^2y^2.$" :question/worked-solution "The notation $f_x$ means the partial derivative with respect to $x$. Hold $y$ constant, so $e^{2y}$ and $y^2$ are constant multipliers. First write $e^{3x+2y}=e^{2y}e^{3x}$.\n\nUsing the sum and constant multiple rules,\n\n$$\n\\begin{aligned}\nf_x(x,y)\n&=\\frac{\\partial}{\\partial x}(e^{2y}e^{3x})+\\frac{\\partial}{\\partial x}(x^2y^2) \\\\\n&=e^{2y}\\frac{\\partial}{\\partial x}(e^{3x})+y^2\\frac{\\partial}{\\partial x}(x^2) \\\\\n&=e^{2y}\\cdot 3e^{3x}+y^2\\cdot 2x \\\\\n&=3e^{3x+2y}+2xy^2.\n\\end{aligned}\n$$\nThe factor $3$ comes from differentiating $e^{3x}$; the held factor $e^{2y}$ is unchanged."} {:db/id #edb/ref 17592186713066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04215ebb-fd67-5b0c-a30d-5c56c5cc575d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\ln x+e^{2x+y}+\\frac{x}{y^2}" :db/id #edb/ref 17592186713062} {:answer/id #uuid "1c66bc44-d6c5-5e11-97e9-31f576b83c68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\ln x+2e^{2x+y}-\\frac{x}{y^2}" :db/id #edb/ref 17592186713065} {:answer/id #uuid "96cd781e-c908-5dfb-98fa-7c6e1c373304" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln y+\\frac{y}{x}+2e^{2x+y}+\\frac{1}{y}" :db/id #edb/ref 17592186713074} {:answer/id #uuid "b49462cd-7fe4-5da1-a83c-fd4a7fd5798d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\ln x+e^{2x+y}-\\frac{x}{y^2}" :db/id #edb/ref 17592186713077} {:answer/id #uuid "d35d20c4-144e-5618-9c8d-0c6716520ca7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{y}{x}+e^{2x+y}-\\frac{x}{y^2}" :db/id #edb/ref 17592186713079}] :answer-field/correct {:answer/id #uuid "b49462cd-7fe4-5da1-a83c-fd4a7fd5798d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\ln x+e^{2x+y}-\\frac{x}{y^2}" :db/id #edb/ref 17592186713077} :answer-field/id #uuid "e12667bc-561a-5eba-b132-c79b2a0c0b00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713081}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "460eff50-09be-55c7-8f8c-66579465ed1e" :question/problem "Find $f_y(x,y)$ for $f(x,y)=x\\ln y+y\\ln x+e^{2x+y}+\\dfrac{x}{y}$, where $x>0$ and $y>0$." :question/worked-solution "The notation $f_y$ means the partial derivative with respect to $y$. Treat $x$ as constant throughout. In particular, $\\ln x$ is a constant multiplier in $y\\ln x$, whereas $\\ln y$ must be differentiated in $x\\ln y$.\n\nRewrite $e^{2x+y}=e^{2x}e^y$ and $x/y=xy^{-1}$ to expose the constant multipliers. Apply the sum and constant multiple rules:\n\n$$\n\\begin{aligned}\nf_y(x,y)\n&=x\\frac{\\partial}{\\partial y}(\\ln y)\n  +\\ln x\\frac{\\partial}{\\partial y}(y) \\\\\n&\\quad +e^{2x}\\frac{\\partial}{\\partial y}(e^y)\n  +x\\frac{\\partial}{\\partial y}(y^{-1}) \\\\\n&=x\\cdot\\frac{1}{y}+\\ln x\\cdot 1+e^{2x}\\cdot e^y+x\\cdot(-y^{-2}) \\\\\n&=\\frac{x}{y}+\\ln x+e^{2x+y}-\\frac{x}{y^2}.\n\\end{aligned}\n$$\nHere $x$ survives as a multiplier in the first and last terms. The last term is negative because the derivative of $y^{-1}$ is $-y^{-2}$."} {:db/id #edb/ref 17592186713068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72f4ae8f-a5a0-58c1-96b1-dc0a8f2462e9" :answer/type {:db/ident :answer.type/math} :answer/value "x\\cos y" :db/id #edb/ref 17592186713070} {:answer/id #uuid "8b9267be-1edf-5cbd-af6c-d393468fc1e5" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos y" :db/id #edb/ref 17592186713072} {:answer/id #uuid "9a0deecd-81e7-53e2-97af-c5d91f02dd80" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos y+y^3" :db/id #edb/ref 17592186713075} {:answer/id #uuid "a24847d6-cde7-54ca-b25a-e1bae711db1e" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos y+3y^2" :db/id #edb/ref 17592186713076} {:answer/id #uuid "d0a729a7-6435-5b5d-afac-e8d1f9bf40f1" :answer/type {:db/ident :answer.type/math} :answer/value "-x^2\\sin y+3y^2" :db/id #edb/ref 17592186713078}] :answer-field/correct {:answer/id #uuid "8b9267be-1edf-5cbd-af6c-d393468fc1e5" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos y" :db/id #edb/ref 17592186713072} :answer-field/id #uuid "92d97d99-5074-5b41-870a-058fe32ff724" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5648ee7f-e590-5b9b-9ead-ed028a8ff682" :question/problem "Find $\\dfrac{\\partial f}{\\partial x}$ given that $f(x,y)=x^2\\cos y+y^3.$" :question/worked-solution "Differentiate with respect to $x$, treating $y$ as a constant. Thus $\\cos y$ is a constant multiplier, and the entire term $y^3$ is constant.\n\nUsing the sum and constant multiple rules,\n\n$$\n\\begin{aligned}\n\\frac{\\partial f}{\\partial x}\n&=\\frac{\\partial}{\\partial x}(x^2\\cos y)+\\frac{\\partial}{\\partial x}(y^3) \\\\\n&=\\cos y\\cdot\\frac{\\partial}{\\partial x}(x^2)+0 \\\\\n&=\\cos y\\cdot 2x+0 \\\\\n&=2x\\cos y.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186713484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112d9e89-0b8a-575d-b7cb-b7b558f56de1" :answer/type {:db/ident :answer.type/math} :answer/value "e^{y} + 1" :db/id #edb/ref 17592186713475} {:answer/id #uuid "4763f31a-58fb-5c9d-9a64-cd4c47b3fabd" :answer/type {:db/ident :answer.type/math} :answer/value "x e^{y} + e^{x}" :db/id #edb/ref 17592186713481} {:answer/id #uuid "655a2394-f54e-564a-9bb1-b26f1bad49d9" :answer/type {:db/ident :answer.type/math} :answer/value "e^{x} + e^{y}" :db/id #edb/ref 17592186713488} {:answer/id #uuid "b835b96a-7b42-5d01-bdbe-7c4e1f3b1853" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{y} - 1" :db/id #edb/ref 17592186713499} {:answer/id #uuid "eb834721-92e0-52d4-ab0b-16fe052d0a95" :answer/type {:db/ident :answer.type/math} :answer/value "- x e^{y} - e^{x}" :db/id #edb/ref 17592186713506}] :answer-field/correct {:answer/id #uuid "4763f31a-58fb-5c9d-9a64-cd4c47b3fabd" :answer/type {:db/ident :answer.type/math} :answer/value "x e^{y} + e^{x}" :db/id #edb/ref 17592186713481} :answer-field/id #uuid "b6bf43b3-d407-501d-9e18-ad5199114769" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713498}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "51e20725-2c30-5fee-9590-fd43548b6871" :question/problem "Find $f_{y}(x,y)$ for $f(x,y)=x e^{y}+y e^{x}$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Apply the sum and constant multiple rules term by term.\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(x e^{y}) &=x\\cdot \\frac{∂}{∂y}(e^{y}) \\\\\n&=x\\cdot \\left(e^{y}\\right) \\\\\n&=x e^{y}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(y e^{x}) &=e^{x}\\cdot \\frac{∂}{∂y}(y) \\\\\n&=e^{x}\\cdot \\left(1\\right) \\\\\n&=e^{x}\\end{aligned}\n$$\n\nTherefore $f_{y}(x,y)=x e^{y} + e^{x}$."} {:db/id #edb/ref 17592186713485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34cdaa6c-1dd9-567d-b19a-0ece1a61f140" :answer/type {:db/ident :answer.type/math} :answer/value "2 x e^{y} + e^{x}" :db/id #edb/ref 17592186713477} {:answer/id #uuid "4ef77582-f3a2-5f8d-8c1c-670d9c3b3d7e" :answer/type {:db/ident :answer.type/math} :answer/value "2 x e^{y} + y e^{x}" :db/id #edb/ref 17592186713482} {:answer/id #uuid "5bded3cf-11fd-5f24-bf1a-4dd0f539a44e" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 x e^{y} - e^{x}" :db/id #edb/ref 17592186713487} {:answer/id #uuid "7228916d-9c0f-554d-8bc3-4a1037f3f108" :answer/type {:db/ident :answer.type/math} :answer/value "y e^{x} + 2 e^{y}" :db/id #edb/ref 17592186713491} {:answer/id #uuid "b0c65c0c-ca47-59e3-9105-65900077dc97" :answer/type {:db/ident :answer.type/math} :answer/value "- y e^{x} - 2 e^{y}" :db/id #edb/ref 17592186713497}] :answer-field/correct {:answer/id #uuid "7228916d-9c0f-554d-8bc3-4a1037f3f108" :answer/type {:db/ident :answer.type/math} :answer/value "y e^{x} + 2 e^{y}" :db/id #edb/ref 17592186713491} :answer-field/id #uuid "e37feb59-1815-5f89-8772-d2c7a64ac24c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713504}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5a5be5b2-6e2a-5f9e-84f8-eebaab60cc90" :question/problem "Find $f_{x}(x,y)$ for $f(x,y)=2 x e^{y}+y e^{x}$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Apply the sum and constant multiple rules term by term.\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(2 x e^{y}) &=2 e^{y}\\cdot \\frac{∂}{∂x}(x) \\\\\n&=2 e^{y}\\cdot \\left(1\\right) \\\\\n&=2 e^{y}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(y e^{x}) &=y\\cdot \\frac{∂}{∂x}(e^{x}) \\\\\n&=y\\cdot \\left(e^{x}\\right) \\\\\n&=y e^{x}\\end{aligned}\n$$\n\nTherefore $f_{x}(x,y)=y e^{x} + 2 e^{y}$."} {:db/id #edb/ref 17592186713492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f46157e-4d36-56fc-923f-58d011368fcf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 x}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713474} {:answer/id #uuid "39507883-9c95-5ce3-bb25-226c4d15c2f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713478} {:answer/id #uuid "5128d09f-6c8e-5583-b389-dddd3dcd9dbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713483} {:answer/id #uuid "7015f03d-654c-5549-a0c1-fef2d63398c2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713490} {:answer/id #uuid "f4bc4e62-81b7-59ea-927f-8b243cf5ef1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713508}] :answer-field/correct {:answer/id #uuid "39507883-9c95-5ce3-bb25-226c4d15c2f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 x}{\\sqrt{- y^{2} + 1}}" :db/id #edb/ref 17592186713478} :answer-field/id #uuid "90040c04-80f8-56ba-bd11-c30cd747abeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713494}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7efdb431-97f3-5fe4-9816-97ae8b917488" :question/problem "Find $f_{y}(x,y)$ for $f(x,y)=3 x \\arcsin{\\left(y \\right)}+3 x^{2}$, where $-1<y<1$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Apply the sum and constant multiple rules term by term.\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(3 x \\arcsin{\\left(y \\right)}) &=3 x\\cdot \\frac{∂}{∂y}(\\arcsin{\\left(y \\right)}) \\\\\n&=3 x\\cdot \\left(\\frac{1}{\\sqrt{- y^{2} + 1}}\\right) \\\\\n&=\\frac{3 x}{\\sqrt{- y^{2} + 1}}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(3 x^{2}) &=3 x^{2}\\cdot \\frac{∂}{∂y}(1) \\\\\n&=3 x^{2}\\cdot \\left(0\\right) \\\\\n&=0\\end{aligned}\n$$\n\nTherefore $f_{y}(x,y)=\\frac{3 x}{\\sqrt{- y^{2} + 1}}$."} {:db/id #edb/ref 17592186713500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ccef1b6-e029-5925-a086-5c560ada47e6" :answer/type {:db/ident :answer.type/math} :answer/value "3 y^{2} + 1" :db/id #edb/ref 17592186713489} {:answer/id #uuid "8e56ca33-be28-59de-94bf-23c17a2ab35b" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 y^{2} - 1" :db/id #edb/ref 17592186713493} {:answer/id #uuid "d237da93-f746-5b52-9213-d0a3522badb1" :answer/type {:db/ident :answer.type/math} :answer/value "2 e^{x} - \\frac{3 y^{2}}{x}" :db/id #edb/ref 17592186713501} {:answer/id #uuid "e6b04a78-76f6-5355-96d6-ad52e45c848e" :answer/type {:db/ident :answer.type/math} :answer/value "3 y^{2} \\ln{\\left(x \\right)} - 2 e^{x}" :db/id #edb/ref 17592186713505} {:answer/id #uuid "ed19aadf-3227-5be8-b498-af8bd9dbd973" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 y^{2} \\ln{\\left(x \\right)} + 2 e^{x}" :db/id #edb/ref 17592186713507}] :answer-field/correct {:answer/id #uuid "ed19aadf-3227-5be8-b498-af8bd9dbd973" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 y^{2} \\ln{\\left(x \\right)} + 2 e^{x}" :db/id #edb/ref 17592186713507} :answer-field/id #uuid "5ae5462a-74f6-572d-9946-add2dc9dd7e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c63e8e49-a150-56a8-b628-d55ceebd82c6" :question/problem "Find $f_{y}(x,y)$ for $f(x,y)=- y^{3} \\ln{\\left(x \\right)}+2 y e^{x}$, where $x>0$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Apply the sum and constant multiple rules term by term.\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(- y^{3} \\ln{\\left(x \\right)}) &=- \\ln{\\left(x \\right)}\\cdot \\frac{∂}{∂y}(y^{3}) \\\\\n&=- \\ln{\\left(x \\right)}\\cdot \\left(3 y^{2}\\right) \\\\\n&=- 3 y^{2} \\ln{\\left(x \\right)}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2 y e^{x}) &=2 e^{x}\\cdot \\frac{∂}{∂y}(y) \\\\\n&=2 e^{x}\\cdot \\left(1\\right) \\\\\n&=2 e^{x}\\end{aligned}\n$$\n\nTherefore $f_{y}(x,y)=- 3 y^{2} \\ln{\\left(x \\right)} + 2 e^{x}$."} {:db/id #edb/ref 17592186713503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195899e8-70a1-5f6a-8d5a-ae70d37f2ace" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 y^{2} - 2 y \\arcsin{\\left(x \\right)}" :db/id #edb/ref 17592186713476} {:answer/id #uuid "3bc82773-2b14-5bbb-97ca-786220a0fd85" :answer/type {:db/ident :answer.type/math} :answer/value "6 y + 2 \\arcsin{\\left(x \\right)}" :db/id #edb/ref 17592186713479} {:answer/id #uuid "93fcbbd4-e7e3-58a5-8279-812f8ef96075" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 y}{\\sqrt{- x^{2} + 1}}" :db/id #edb/ref 17592186713495} {:answer/id #uuid "ad69dbda-f5d2-52c9-9431-39fc463c3802" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 y - 2 \\arcsin{\\left(x \\right)}" :db/id #edb/ref 17592186713496} {:answer/id #uuid "d3ac9dc5-5d4d-5095-a9e7-79e11add8cd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 y}{\\sqrt{- x^{2} + 1}}" :db/id #edb/ref 17592186713502}] :answer-field/correct {:answer/id #uuid "ad69dbda-f5d2-52c9-9431-39fc463c3802" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 y - 2 \\arcsin{\\left(x \\right)}" :db/id #edb/ref 17592186713496} :answer-field/id #uuid "45e91bad-c3c6-5abb-a85c-0b01b7660df4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713480}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d62269e4-b061-5de0-8e0a-cf4f4037af17" :question/problem "Find $f_{y}(x,y)$ for $f(x,y)=- 2 y \\arcsin{\\left(x \\right)}- 3 y^{2}$, where $-1<x<1$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Apply the sum and constant multiple rules term by term.\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(- 2 y \\arcsin{\\left(x \\right)}) &=- 2 \\arcsin{\\left(x \\right)}\\cdot \\frac{∂}{∂y}(y) \\\\\n&=- 2 \\arcsin{\\left(x \\right)}\\cdot \\left(1\\right) \\\\\n&=- 2 \\arcsin{\\left(x \\right)}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(- 3 y^{2}) &=-3\\cdot \\frac{∂}{∂y}(y^{2}) \\\\\n&=-3\\cdot \\left(2 y\\right) \\\\\n&=- 6 y\\end{aligned}\n$$\n\nTherefore $f_{y}(x,y)=- 6 y - 2 \\arcsin{\\left(x \\right)}$."}] :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}]}
