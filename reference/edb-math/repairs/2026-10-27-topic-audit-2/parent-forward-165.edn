id "c805bd16-d00f-5d74-92d0-6474b58e41f0" :multistep/steps [{:db/id #edb/ref 17592186674468 :step/content {:db/id #edb/ref 17592186233572}} {:db/id #edb/ref 17592186674469 :step/content {:db/id #edb/ref 17592186233573}} {:db/id #edb/ref 17592186674470 :step/content {:db/id #edb/ref 17592186233574}} {:db/id #edb/ref 17592186674471 :step/content {:db/id #edb/ref 17592186233575}} {:db/id #edb/ref 17592186674472 :step/content {:db/id #edb/ref 17592186233576}} {:db/id #edb/ref 17592186674473 :step/content {:db/id #edb/ref 17592186233577}} {:db/id #edb/ref 17592186674474 :step/content {:db/id #edb/ref 17592186233578}}]}] [{:db/id #edb/ref 17592186702487 :multistep/context "Source: Problem 4(a–c), PDF page 5.\n\n**Ideal Fluids.** The source describes an ideal fluid as one with “zero viscosity (zero divergence)” and “no vortex (zero curl).” Use its stated mathematical conditions of zero divergence and zero curl for this problem. For each pair, complete (i) the conservativeness and ideal-flow discussion and (ii) the potential/stream-function construction." :multistep/id #uuid "18efe2aa-0ee7-5577-80d1-bacd43921887" :multistep/steps [{:db/id #edb/ref 17592186702504 :step/content {:db/id #edb/ref 17592186702619}} {:db/id #edb/ref 17592186702558 :step/content {:db/id #edb/ref 17592186702594}} {:db/id #edb/ref 17592186702639 :step/content {:db/id #edb/ref 17592186702606}}]}] [{:db/id #edb/ref 17592186702499 :multistep/context "Source: Problem 1(a–d), PDF page 2.\n\nLet $\\mathbf F=\\langle f,g\\rangle$ and $\\mathbf G=\\langle-g,f\\rangle$, and let $C$ be any counterclockwise simple closed curve in the plane." :multistep/id #uuid "2a27ae01-32f5-5430-8969-0add91b1daf5" :multistep/steps [{:db/id #edb/ref 17592186702559 :step/content {:db/id #edb/ref 17592186702593}} {:db/id #edb/ref 17592186702561 :step/content {:db/id #edb/ref 17592186702486}} {:db/id #edb/ref 17592186702687 :step/content {:db/id #edb/ref 17592186702502}} {:db/id #edb/ref 17592186702696 :step/content {:db/id #edb/ref 17592186702480}}]}] [{:db/id #edb/ref 17592186702547 :multistep/context "Source exercise: 3.1.1(a–c), textbook printed page 126 (PDF page 138)." :multistep/id #uuid "6524fe0f-3387-5099-a4eb-239ad80a370e" :multistep/steps [{:db/id #edb/ref 17592186702546 :step/content {:db/id #edb/ref 17592186702532}} {:db/id #edb/ref 17592186702603 :step/content {:db/id #edb/ref 17592186702688}} {:db/id #edb/ref 17592186702659 :step/content {:db/id #edb/ref 17592186702677}}]}] [{:db/id #edb/ref 17592186702569 :multistep/context "Source: Problem 3(a–c), each with tasks (i–iv), PDF page 4.\n\nLet $C$ be the counterclockwise unit circle centered at the origin. For each field in parts (a), (b), and (c): (i) find its domain; (ii) calculate the indicated integral by hand; (iii) calculate it “using” Green's theorem; and (iv) compare (ii) and (iii), using (i) to explain any difference.\n\n**Source hint:** Use the previous two problems to avoid additional calculations." :multistep/id #uuid "790bf7b9-b5d7-5639-b5b0-fe2cef244b42" :multistep/steps [{:db/id #edb/ref 17592186702507 :step/content {:db/id #edb/ref 17592186702478}} {:db/id #edb/ref 17592186702520 :step/content {:db/id #edb/ref 17592186702692}} {:db/id #edb/ref 17592186702528 :step/content {:db/id #edb/ref 17592186702672}} {:db/id #edb/ref 17592186702539 :step/content {:db/id #edb/ref 17592186702675}} {:db/id #edb/ref 17592186702542 :step/content {:db/id #edb/ref 17592186702598}} {:db/id #edb/ref 17592186702587 :step/content {:db/id #edb/ref 17592186702498}} {:db/id #edb/ref 17592186702611 :step/content {:db/id #edb/ref 17592186702537}} {:db/id #edb/ref 17592186702612 :step/content {:db/id #edb/ref 17592186702623}} {:db/id #edb/ref 17592186702613 :step/content {:db/id #edb/ref 17592186702572}} {:db/id #edb/ref 17592186702637 :step/content {:db/id #edb/ref 17592186702671}} {:db/id #edb/ref 17592186702648 :step/content {:db/id #edb/ref 17592186702670}} {:db/id #edb/ref 17592186702699 :step/content {:db/id #edb/ref 17592186702614}}]