=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$8$</td>\n<td data-cell-align=\"center\">$1.397$</td>\n<td data-cell-align=\"center\">$1.860$</td>\n<td data-cell-align=\"center\">$2.306$</td>\n<td data-cell-align=\"center\">$2.896$</td>\n<td data-cell-align=\"center\">$3.355$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td data-cell-align=\"center\">$1.383$</td>\n<td data-cell-align=\"center\">$1.833$</td>\n<td data-cell-align=\"center\">$2.262$</td>\n<td data-cell-align=\"center\">$2.821$</td>\n<td data-cell-align=\"center\">$3.250$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$10$</td>\n<td data-cell-align=\"center\">$1.372$</td>\n<td data-cell-align=\"center\">$1.812$</td>\n<td data-cell-align=\"center\">$2.228$</td>\n<td data-cell-align=\"center\">$2.764$</td>\n<td data-cell-align=\"center\">$3.169$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161666 :question/worked-solution "Since $X \\sim T_{9},$ we focus on the row of the table that corresponds to $k=9.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.005}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$8$</td>\n<td data-cell-align=\"center\">$1.397$</td>\n<td data-cell-align=\"center\">$1.860$</td>\n<td data-cell-align=\"center\">$2.306$</td>\n<td data-cell-align=\"center\">$2.896$</td>\n<td data-cell-align=\"center\">$3.355$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$1.383$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$1.833$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$2.262$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$2.821$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$\\bbox[2pt,Gainsboro]{\\color{red}3.250}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$10$</td>\n<td data-cell-align=\"center\">$1.372$</td>\n<td data-cell-align=\"center\">$1.812$</td>\n<td data-cell-align=\"center\">$2.228$</td>\n<td data-cell-align=\"center\">$2.764$</td>\n<td data-cell-align=\"center\">$3.169$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this row, we see that\n\n$$\nP(X \\geq {\\color{red}3.250}) = {\\color{blue}0.005}.\n$$\n\nTherefore, our answer is $x=3.250.$"] [17592186161667 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p,$ where $X$ has a student's $t$-distribution $T_k$ with $k$ degrees of freedom. Given that the random variable $X \\sim T_{11},$ find the value of $x$ such that $P(X \\leq x) = 0.99.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td data-cell-align=\"center\">$1.363$</td>\n<td data-cell-align=\"center\">$1.796$</td>\n<td data-cell-align=\"center\">$2.201$</td>\n<td data-cell-align=\"center\">$2.718$</td>\n<td data-cell-align=\"center\">$3.106$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$12$</td>\n<td data-cell-align=\"center\">$1.356$</td>\n<td data-cell-align=\"center\">$1.782$</td>\n<td data-cell-align=\"center\">$2.179$</td>\n<td data-cell-align=\"center\">$2.681$</td>\n<td data-cell-align=\"center\">$3.055$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td data-cell-align=\"center\">$1.350$</td>\n<td data-cell-align=\"center\">$1.771$</td>\n<td data-cell-align=\"center\">$2.160$</td>\n<td data-cell-align=\"center\">$2.650$</td>\n<td data-cell-align=\"center\">$3.012$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161667 :question/worked-solution "The table shows probabilities in the form $P(X \\ge x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(X\\ge x) & =1-P(X\\le x) \\\\  & =1-0.99 \\\\  & =0.01\\end{aligned}\n$$\n\nNow, since $X \\sim T_{11},$ we focus on the row of the table that corresponds to $k=11.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k\\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.010}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$1.363$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$1.796$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$2.201$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$\\bbox[2pt,Gainsboro]{\\color{red}2.718}$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$3.106$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$12$</td>\n<td data-cell-align=\"center\">$1.356$</td>\n<td data-cell-align=\"center\">$1.782$</td>\n<td data-cell-align=\"center\">$2.179$</td>\n<td data-cell-align=\"center\">$2.681$</td>\n<td data-cell-align=\"center\">$3.055$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td data-cell-align=\"center\">$1.350$</td>\n<td data-cell-align=\"center\">$1.771$</td>\n<td data-cell-align=\"center\">$2.160$</td>\n<td data-cell-align=\"center\">$2.650$</td>\n<td data-cell-align=\"center\">$3.012$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this row, we see that\n\n$$\nP(X \\ge {\\color{red}2.718}) = {\\color{blue}0.010}.\n$$\n\nTherefore, our answer is $x=2.718.$"] [17592186161668 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n</tr>\n</tbody></table></div>\n\n\nGiven the joint probability mass function $f(x,y)$ above for the discrete random variables $X$ and $Y,$ find the marginal mass function for $X.$"] [17592186161668 :question/worked-solution "If the random variables $X$ and $Y$ have joint distribution with joint probability mass function $f(x,y),$ then we have\n\n$$\n\\begin{aligned}P(X=x) & ={f}_{X}(x)={\\sum }_{y}f(x,y) \\\\ P(Y=y) & ={f}_{Y}(y)={\\sum }_{x}f(x,y)\\end{aligned}\n$$\n\nwhere $f_X(x)$ and $f_Y(y)$ are the marginal mass functions for $X$ and $Y,$ respectively.\n\nIn this case, the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals. Let's add these row and column totals to our table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.3}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.7}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nFinally, the marginal mass function for $X$ is given by the following table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X(x)$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.7$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161669 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p,$ where $X$ has a student's $t$-distribution $T_k$ with $k$ degrees of freedom. Given that the random variable $X \\sim T_{13},$ find the value of $x$ such that $P(|X| \\leq x) = 0.9.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td data-cell-align=\"center\">$1.363$</td>\n<td data-cell-align=\"center\">$1.796$</td>\n<td data-cell-align=\"center\">$2.201$</td>\n<td data-cell-align=\"center\">$2.718$</td>\n<td data-cell-align=\"center\">$3.106$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$12$</td>\n<td data-cell-align=\"center\">$1.356$</td>\n<td data-cell-align=\"center\">$1.782$</td>\n<td data-cell-align=\"center\">$2.179$</td>\n<td data-cell-align=\"center\">$2.681$</td>\n<td data-cell-align=\"center\">$3.055$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td data-cell-align=\"center\">$1.350$</td>\n<td data-cell-align=\"center\">$1.771$</td>\n<td data-cell-align=\"center\">$2.160$</td>\n<td data-cell-align=\"center\">$2.650$</td>\n<td data-cell-align=\"center\">$3.012$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161669 :question/worked-solution "The table shows probabilities in the form $P(X > x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(|X|>x) & =1-P(|X|\\le x) \\\\  & =1-0.9 \\\\  & =0.1\\end{aligned}\n$$\n\n![](images/63/635de7075b0d106ffc2a0f15e65ca7a3406a49945591aa5eae59090c74df1398.png)\n\nDue to the symmetry of the student's $t$-distribution, we have that $P(|X| > x) = 0.1$ is equivalent to\n\n$$\n2P(X > x) = 0.1 \n\\qquad\\Longrightarrow\\qquad\nP(X > x) = 0.05.\n$$\n\nNow, since $X \\sim T_{13},$ we focus on the row of the table that corresponds to $k=13.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.050}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td data-cell-align=\"center\">$1.363$</td>\n<td data-cell-align=\"center\">$1.796$</td>\n<td data-cell-align=\"center\">$2.201$</td>\n<td data-cell-align=\"center\">$2.718$</td>\n<td data-cell-align=\"center\">$3.106$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$12$</td>\n<td data-cell-align=\"center\">$1.356$</td>\n<td data-cell-align=\"center\">$1.782$</td>\n<td data-cell-align=\"center\">$2.179$</td>\n<td data-cell-align=\"center\">$2.681$</td>\n<td data-cell-align=\"center\">$3.055$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$1.350$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$\\bbox[2pt,Gainsboro]{\\color{red}1.771}$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$2.160$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$2.650$</td>\n<td data-cell-align=\"center\" data-fill=\"PapayaWhip\">$3.012$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this row, we see that\n\n$$\nP(X \\geq {\\color{red}1.771}) = {\\color{blue}0.050}.\n$$\n\nTherefore, our answer is $x=1.771.$"] [17592186161670 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=3$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n\n\nFind the conditional probability mass function $f_{X|Y}(x\\,|\\, 1)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161670 :question/worked-solution "The conditional probability mass function $f_{X|Y}(x|y)$ is defined as\n\n$$\nf_{X|Y}(x\\,|\\,y) = P(X = x \\,|\\, Y=y).\n$$\n\nTherefore, we're required to compute the following set of conditional probabilities:\n\n$$\nf_{X|Y}(x \\,|\\, 1) = P(X = x \\,|\\, Y=1)\n$$\n\nBy the multiplication law for conditional probability, we have\n\n$$\nP(X = x \\,|\\, Y=1) = \\dfrac{P(X = x, Y=1)}{P(Y=1)} = \\dfrac{f(x,1)}{f_Y(1)}\n$$\n\nwhere $f(x,y)$ is the joint probability mass function of $X$ and $Y,$ and $f_Y(y)$ is the marginal distribution of $Y.$\n\nRecall that the marginal distributions for $X$ and $Y$ correspond to the row and column totals, respectively. So, let's compute these:\n\n| $f$ | $Y=1$ | $Y=3$ | $Y=5$ | $f_X(x)$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0$ | $0.2$ | $0.3$ |\n| $X=2$ | $0.3$ | $0.1$ | $0$ | $0.4$ |\n| $X=4$ | $0.1$ | $0$ | $0.2$ | $0.3$ |\n| $f_Y(y)$ | $0.5$ | $0.3$ | $0.2$ | $1$ |\n\nTherefore, for $x\\in \\{0,2,4\\},$ we obtain the following:\n\n$$\n\\begin{array}{rl}\\displaystyle P ( X = 0 \\hspace{0.167em} | \\hspace{0.167em} Y = 1 ) & \\displaystyle  = {\\displaystyle \\frac{f ( 0 , 1 )}{ {f}_{Y} ( 1 )}} = {\\displaystyle \\frac{0.1}{0.5}} = {\\displaystyle \\frac{1}{5}} \\\\ \\displaystyle P ( X = 2 \\hspace{0.167em} | \\hspace{0.167em} Y = 1 ) & \\displaystyle  = {\\displaystyle \\frac{f ( 2 , 1 )}{ {f}_{Y} ( 1 )}} = {\\displaystyle \\frac{0.3}{0.5}} = {\\displaystyle \\frac{3}{5}} \\\\ \\displaystyle P ( X = 4 \\hspace{0.167em} | \\hspace{0.167em} Y = 1 ) & \\displaystyle  = {\\displaystyle \\frac{f ( 4 , 1 )}{ {f}_{Y} ( 1 )}} = {\\displaystyle \\frac{0.1}{0.5}} = {\\displaystyle \\frac{1}{5}}\\end{array}\n$$\n\nFinally, the conditional probability mass function can be represented by the following table:   \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_{X|Y}(x\\,|\\, 1)$</td>\n<td data-cell-align=\"center\">$\\dfrac 1 5$</td>\n<td data-cell-align=\"center\">$\\dfrac{3}{5}$</td>\n<td data-cell-align=\"center\">$\\dfrac 1 5$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161671 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{18}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{18}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{18}$</td>\n</tr>\n</tbody></table></div>\n\n\nCompute $f_{X|Y}(2 \\,|\\, 2)$ given that the discrete random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161676 :question/problem "Given that $X_1, X_2, \\ldots,X_{100} \\sim N(-4, 20^2)$ is a random sample of size $100$ from a normal population, calculate $P(-4.3 \\lt \\overline{X} \\lt -3.9).$\n\n*Hint: A value table of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.04 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.05 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.06 \\,$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, -0.1 \\,$</th><td data-cell-align=\"center\">$\\, 0.4443 \\,$</td><td data-cell-align=\"center\">$\\, 0.4404 \\,$</td><td data-cell-align=\"center\">$\\, 0.4364 \\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.0 \\,$</th><td data-cell-align=\"center\">$\\, 0.5160 \\,$</td><td data-cell-align=\"center\">$\\, 0.5199 \\,$</td><td data-cell-align=\"center\">$\\, 0.5239 \\,$</td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.1 \\,$</th><td data-cell-align=\"center\">$\\, 0.5557 \\,$</td><td data-cell-align=\"center\">$\\, 0.5596 \\,$</td><td data-cell-align=\"center\">$\\, 0.5636 \\,$</td></tr>\n</tbody></table></div>\n\n"] [17592186161677 :question/problem "The diastolic blood pressure of adult men in a given population is normally distributed with a mean of $75\\,\\text{mm}\\,\\text{Hg}$ and a standard deviation of $10\\,\\text{mm}\\,\\text{Hg}.$ Suppose $10$ men are selected at random. What is the probability that the mean diastolic blood pressure for this sample will be less than $70\\,\\text{mm}\\,\\text{Hg}?$\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.*  \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.05 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.06 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.07 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.08 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.09 \\,$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, -1.5 \\,$</th><td data-cell-align=\"center\">$\\, 0.0606 \\,$</td><td data-cell-align=\"center\">$\\, 0.0594 \\,$</td><td data-cell-align=\"center\">$\\, 0.0582 \\,$</td><td data-cell-align=\"center\">$\\, 0.0571 \\,$</td><td data-cell-align=\"center\">$\\, 0.0559 \\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, -1.4 \\,$</th><td data-cell-align=\"center\">$\\, 0.0735 \\,$</td><td data-cell-align=\"center\">$\\, 0.0721 \\,$</td><td data-cell-align=\"center\">$\\, 0.0708 \\,$</td><td data-cell-align=\"center\">$\\, 0.0694 \\,$</td><td data-cell-align=\"center\">$\\, 0.0681 \\,$</td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, -1.3 \\,$</th><td data-cell-align=\"center\">$\\, 0.0885 \\,$</td><td data-cell-align=\"center\">$\\, 0.0869 \\,$</td><td data-cell-align=\"center\">$\\, 0.0853 \\,$</td><td data-cell-align=\"center\">$\\, 0.0838 \\,$</td><td data-cell-align=\"center\">$\\, 0.0823 \\,$</td></tr>\n</tbody></table></div>\n\n"] [17592186161683 :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given in the table below. Find $\\textrm{E}\\big[ X+2Y \\big].$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.6$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161689 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_{Y|X}(y \\,|\\, 2)$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{3}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{3}$</td>\n</tr>\n</tbody></table></div>\n\n\nFind the $\\textrm{E}\\big[Y \\,|\\, X=2\\big]$ given that the conditional probability mass function $f_{Y|X}(y \\,|\\, 2)$ is shown in the table above."] [17592186161690 :question/problem "Let $X$ and $Y$ be discrete random variables with the joint probability mass function $f(x,y)$ shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=-2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=-1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F\\left(2,1\\right).$"] [17592186161690 :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y) = P(X \\leq x, Y \\leq y) = \\sum\\limits_{x_i \\leq x} \\sum\\limits_{y_i \\leq y} f(x_i, y_i).\n$$\n\nBy definition, we have\n\n$$\n\\begin{aligned}F(2,1) & =P(X\\le 2,Y\\le 1).\\end{aligned}\n$$\n\nWe start by highlighting all cells in the table that correspond to $X \\leq 2, Y \\leq 1.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=-2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=-1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#FCF3CF\">$0.1$</td>\n<td data-cell-align=\"center\" data-fill=\"#FCF3CF\">$0.3$</td>\n<td data-cell-align=\"center\" data-fill=\"#FCF3CF\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}F(2,1) & ={\\sum }_{x\\le 2}{\\sum }_{y\\le 1}f(x,y) \\\\  & =f(1,-2)+f(1,-1)+f(1,0) \\\\  & =0.1+0.3+0.05 \\\\  & =0.45.\\end{aligned}\n$$"] [17592186161692 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{9}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{8}{27}$</td>\n<td data-cell-align=\"center\">$\\dfrac{5}{27}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{27}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n</tr>\n</tbody></table></div>\n\n\nFind $\\textrm{E}\\big[Y \\,|\\, X=2\\big]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161692 :question/worked-solution "Recall that the conditional expected value of  $Y$ given $X=x$ is defined by\n\n$$\n\\textrm{E}\\big[Y \\,|\\, X=x\\big] = \\sum_{y} y \\, f_{Y | X}(y \\,|\\, x).\n$$\n\nIn order to find $f_{Y | X}(y \\,|\\, x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X(x)$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{9}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{1}{3}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{8}{27}$</td>\n<td data-cell-align=\"center\">$\\dfrac{5}{27}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{13}{27}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{27}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{5}{27}$</td>\n</tr>\n</tbody></table></div>\n\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\nf_{Y | X}(y \\,|\\, x)  = \\dfrac{f(x,y)}{f_X(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x{:}$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f_{Y | X}(y \\,|\\, x)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{3}$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{3}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{8}{13}$</td>\n<td data-cell-align=\"center\">$\\dfrac{5}{13}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{5}$</td>\n<td data-cell-align=\"center\">$\\dfrac{3}{5}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[Y\\,|\\,X=2] & ={\\sum }_{y}y\\,{f}_{Y|X}(y\\,|\\,2) \\\\  & =1\\cdot \\frac{8}{13}+2\\cdot \\frac{5}{13} \\\\  & =\\frac{18}{13}.\\end{aligned}\n$$"] [17592186161698 :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n</tr>\n</tbody></table></div>\n\n\nCalculate the covariance of $X$ and $Y.$"] [17592186161698 :question/worked-solution "The covariance of two discrete random variables $X$ and $Y$ with joint support $S$ is defined as\n\n$$\n\\textrm{Cov}[X, Y] = \\sum_{(x,y)\\in S}(x − \\textrm E[X])(y − \\textrm E[Y])f(x,y).\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.1$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.9$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nWe now compute $\\textrm{E}[X]$ and $\\textrm{E}[Y],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{x\\in {S}_{X}}x\\cdot {f}_{X}(x) \\\\  & =1\\cdot 0.6+2\\cdot 0.4 \\\\  & =0.6+0.8 \\\\  & =1.4 \\\\ \\text{E}[Y] & ={\\sum }_{y\\in {S}_{Y}}y\\cdot {f}_{Y}(y) \\\\  & =0\\cdot 0.1+1\\cdot 0.9 \\\\  & =0+0.9 \\\\  & =0.9\\end{aligned}\n$$\n\nApplying the formula for the covariance, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & ={\\sum }_{(x,y)\\in S}(x-\\text{E}[X])(y-\\text{E}[Y])f(x,y) \\\\  & ={\\sum }_{(x,y)\\in S}(x-1.4)(y-0.9)f(x,y) \\\\  & =(1-1.4)(0-0.9)f(1,0) \\\\  & +(1-1.4)(1-0.9)f(1,1) \\\\  & +(2-1.4)(0-0.9)f(2,0) \\\\  & +(2-1.4)(1-0.9)f(2,1) \\\\  & =(-0.4)(-0.9)(0.1) \\\\  & +(-0.4)(0.1)(0.5) \\\\  & +(0.6)(-0.9)(0) \\\\  & +(0.6)(0.1)(0.4) \\\\  & =0.04.\\end{aligned}\n$$"] [17592186161699 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{9}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{3}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=6$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n</tr>\n</tbody></table></div>\n\n\nFind $\\textrm{E}\\big[X \\,|\\, Y=1\\big]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161699 :question/worked-solution "Recall that the conditional expected value of  $X$ given $Y=y$ is defined by\n\n$$\n\\textrm{E}\\big[X \\,|\\, Y=y\\big] = \\sum_{x} x \\, f_{X | Y}(x \\,|\\, y).\n$$\n\nIn order to find $f_{X | Y}(x \\,|\\, y),$ let's first find the marginal distribution for $Y,$ corresponding to the column totals: \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{2}{9}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{3}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=6$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{9}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y(y)$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{5}{9}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{4}{9}$</td>\n</tr>\n</tbody></table></div>\n\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\nf_{X | Y}(x \\,|\\, y)  = \\dfrac{f(x,y)}{f_Y(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y{:}$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f_{X | Y}(x \\,|\\, y)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{5}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{2}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$\\dfrac{3}{5}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{4}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=6$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{5}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{4}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{E}[X\\,|\\,Y=1] & ={\\sum }_{x}x\\,{f}_{X|Y}(x\\,|\\,1) \\\\  & =2\\cdot \\frac{1}{5}+4\\cdot \\frac{3}{5}+6\\cdot \\frac{1}{5} \\\\  & =\\frac{20}{5} \\\\  & =4.\\end{aligned}\n$$"] [17592186161701 :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ with joint support $S=S_X\\times S_Y$ is given below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.45$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n</tr>\n</tbody></table></div>\n\n\nFind an expression for the covariance in sigma notation."] [17592186161701 :question/worked-solution "The covariance of two discrete random variables $X$ and $Y$ with joint support $S$ is defined as\n\n$$\n\\textrm{Cov}[X, Y] = \\sum_{(x,y)\\in S}(x − \\textrm E[X])(y − \\textrm E[Y])f(x,y).\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=5$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.45$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nWe now compute $\\textrm{E}[X]$ and $\\textrm{E}[Y],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\sum }_{x\\in {S}_{X}}x\\cdot {f}_{X}(x) \\\\  & =1\\cdot 0.4+4\\cdot 0.6 \\\\  & =0.4+2.4 \\\\  & =2.8 \\\\ \\text{E}[Y] & ={\\sum }_{y\\in {S}_{Y}}y\\cdot {f}_{Y}(y) \\\\  & =2\\cdot 0.6+5\\cdot 0.4 \\\\  & =1.2+2 \\\\  & =3.2\\end{aligned}\n$$\n\nApplying the formula for the covariance, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & ={\\sum }_{(x,y)\\in S}(x-\\text{E}[X])(y-\\text{E}[Y])f(x,y) \\\\  & ={\\sum }_{(x,y)\\in S}(x-2.8)(y-3.2)f(x,y).\\end{aligned}\n$$"] [17592186161702 :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n\n\nIf $\\textrm{E} [X]=2.8$ and $\\textrm{E}[Y] = 2.4,$ calculate the covariance of $X$ and $Y.$"] [17592186161707 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f(x,y)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\textrm {E}[X]=0.4\\qquad\n\\textrm {E}[Y]=0.6, \\qquad\n\\textrm {SD}[X] \\approx 0.4899, \\qquad\n\\textrm {SD}[Y] \\approx 0.4899,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places."] [17592186161713 :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.28$</td>\n<td data-cell-align=\"center\">$0.12$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.42$</td>\n<td data-cell-align=\"center\">$0.18$</td>\n</tr>\n</tbody></table></div>\n\n\nWhich of the following statements are true?\n\nI. $P({X = 0}, {Y = 0}) = P(X=0) \\cdot P(Y=0)$\n\nII. $P({X = x}, {Y = y}) = P(X=x) \\cdot P(Y=y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent"] [17592186161713 :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x, y) = f_X(x) \\cdot f_Y (y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where $f_X(x)$ and $f_Y (y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.28$</td>\n<td data-cell-align=\"center\">$0.12$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.42$</td>\n<td data-cell-align=\"center\">$0.18$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.6$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.7$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.3$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P({X = 0}, {Y = 0}) = f(0,0) = 0.28.$ Likewise, \n\n$$\nP(X=0) \\cdot P(Y=0) = f_X(0) \\cdot f_Y(0) = 0.4 \\cdot 0.7 = 0.28. \\quad {\\color{green}\\checkmark}\n$$\n\n- Statement II is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,1) & =0.12=0.4\\cdot 0.3={f}_{X}(0)\\cdot {f}_{Y}(1) & ✓ \\\\ f(1,0) & =0.42=0.6\\cdot 0.7={f}_{X}(1)\\cdot {f}_{Y}(0) & ✓ \\\\ f(1,1) & =0.18=0.6\\cdot 0.3={f}_{X}(1)\\cdot {f}_{Y}(1) & ✓\\end{aligned}\n$$\n\nSo, $P({X = x}, {Y = y}) = P(X=x) \\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is \"I, II, and III.\""] [17592186161714 :question/problem "The marginal mass functions of the discrete random variables $X$ and $Y$ are shown below. Given that the corresponding joint probability mass function is $f(x,y),$ find $f(4,2).$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"none\" data-table-align=\"center\">\n<tbody><tr>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X(x)$</td>\n<td data-cell-align=\"center\">$0.4$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n</tbody></table></div>\n<p></p></th>\n<th></th>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y(y)$</td>\n<td data-cell-align=\"center\">$0.55$</td>\n<td data-cell-align=\"center\">$0.45$</td>\n</tr>\n</tbody></table></div>\n<p></p></th></tr></tbody></table></div>\n\n"] [17592186161715 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.24$</td>\n<td data-cell-align=\"center\">$0.06$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.56$</td>\n<td data-cell-align=\"center\">$0.14$</td>\n</tr>\n</tbody></table></div>\n\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"none\" data-table-align=\"center\">\n<tbody><tr>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X(x)$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.7$</td>\n</tr>\n</tbody></table></div>\n<p></p></th>\n<th></th>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y(y)$</td>\n<td data-cell-align=\"center\">$0.8$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n<p></p></th></tr></tbody></table></div>\n\n\n\nWhich of the following statements are true?\n\nI. $P({X = 0}, {Y = 0}) = P(X=0) \\cdot P(Y=0)$\n\nII. $P({X = x}, {Y = y}) = P(X=x) \\cdot P(Y=y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent"] [17592186161723 :question/problem "In a textile factory, the manager estimated that $10\\%$ of the T-shirts produced by a faulty machine are defective. After repairing the machine, the manager wants to know if the proportion of defective T-shirts has decreased. They decide to conduct a hypothesis test at the $5\\%$ significance level.\n\nThe manager samples a batch of $120$ T-shirts produced by the repaired machine and notices that only $4$ of them are defective. The manager compares this experimental evidence against a null hypothesis, making use of the following cumulative distribution table for $X\\sim B(120,0.1)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\quad x \\quad$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$7$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P(X\\leq x)$</td>\n<td>$\\,0.0016\\,$</td>\n<td>$\\,0.0056\\,$</td>\n<td>$\\,0.0160\\,$</td>\n<td>$\\,0.0382\\,$</td>\n<td>$\\,0.0784\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFill in the missing information from the following statements.\n\n> If $X$ represents the number of defective T-shirts in a random sample of $120$ T-shirts produced by the new machine, then a suitable test statistic is\n> $P\\big(\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{X \\leq 4}}} \\big)= \\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0.0000}}}$.\n> Since $P\\big(\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{X \\leq 4}}}\\big)$$\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{<}}}$ $5\\%$, there is $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{sufficient}}}$ evidence to reject $H_0$.\n> Therefore, we $\\bbox[3pt, border: solid 1pt]{\\phantom{\\textrm{can conclude}}}$ that the proportion of defective T-shirts has decreased since the machine was replaced."] [17592186161724 :question/problem "A telecommunications company believes that $50\\%$ of its customers must wait at least $3$ minutes for their call to be answered. The director of the customer service office claims that the true percentage is even higher. They conduct a hypothesis test at the $1 \\%$ significance level to test this claim.\n\nAfter randomly sampling $20$ customers, the director determined that $15$ of them waited for at least $3$ minutes. The director compares this experimental evidence against a null hypothesis, making use of the following cumulative distribution table for $X\\sim B(20,0.5)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\quad x \\quad$</td>\n<td data-cell-align=\"center\">$13$</td>\n<td data-cell-align=\"center\">$14$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$17$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P(X \\leq x)$</td>\n<td>$\\,0.9423\\,$</td>\n<td>$\\,0.9793\\,$</td>\n<td>$\\,0.9941\\,$</td>\n<td>$\\,0.9987\\,$</td>\n<td>$\\,0.9998\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFill in the missing information from the following statements.\n\n> If $X$ represents the number of randomly selected customers who waited at least $3$ minutes, then an appropriate test statistic is $P\\big(\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0.0000}}}\\big) = \\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0.0000}}}$.\n> Since $P\\big(\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0.0000}}}\\big)\\, \\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0}}}\\, 1\\%$, there is $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{0.000000}}}$ evidence to reject $H_0$.\n> Therefore, we $\\bbox[3pt,border:solid 1pt]{\\phantom{\\textrm{cannot conclude}}}$ that the percentage of customers who must wait at least $3$ minutes is higher than expected."] [17592186161726 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p$, where $X\\sim F(\\nu_1, \\nu_2)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td colspan=\"2\" data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu_2\\setminus \\nu_1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,0.32\\,$<br>$\\,0.23\\,$<br>$\\,0.11\\,$</td>\n<td data-cell-align=\"right\">$\\,0.35\\,$<br>$\\,0.25\\,$<br>$\\,0.13\\,$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,0.33\\,$<br>$\\,0.23\\,$<br>$\\,0.12\\,$</td>\n<td data-cell-align=\"right\">$\\,0.35\\,$<br>$\\,0.26\\,$<br>$\\,0.14\\,$</td>\n</tr>\n<tr rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.30\\,$<br>$\\,0.21\\,$<br>$\\,0.10\\,$</td>\n<td data-cell-align=\"right\">$\\,0.33\\,$<br>$\\,0.24\\,$<br>$\\,0.12\\,$</td>\n<td data-cell-align=\"right\">$\\,0.36\\,$<br>$\\,0.26\\,$<br>$\\,0.14\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nGiven that $X \\sim F(6,7)$, find the value of $x$ such that $P(X \\leq x) = 0.1$."] [17592186161726 :question/worked-solution "The $F$-distribution, denoted $F(\\nu_1, \\nu_2)$, is a two-parameter distribution whose probability density function $f(x)$ is defined for $x> 0$, as shown below.\n\n![](images/0a/0ab3a197cb1944052226978f5b00c6336dfeba6948ef26ef66b24565dc75e7be.png)\n\nThe table gives probabilities in the form\n\n$$\nP(X \\geq x)\n$$\n\nSo, we express the desired probability in this form:\n\n$$\n\\begin{aligned}\nP(X \\ge x) &= 1 - P(X < x) \\\\\n&= 1 - P(X \\le x) \\\\\n&= 1 - 0.1 \\\\\n&= 0.9\n\\end{aligned}\n$$\n\nSince $X \\sim F(6,7)$, we focus on the column of the table corresponding to $\\nu_1=6$ and the row corresponding to $\\nu_2=7$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td colspan=\"2\" data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu_2\\setminus \\nu_1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,0.32\\,$<br>$\\,0.23\\,$<br>$\\,0.11\\,$</td>\n<td data-cell-align=\"right\">$\\,0.35\\,$<br>$\\,0.25\\,$<br>$\\,0.13\\,$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,0.33\\,$<br>$\\,0.23\\,$<br>$\\,0.12\\,$</td>\n<td data-cell-align=\"right\">$\\,0.35\\,$<br>$\\,0.26\\,$<br>$\\,0.14\\,$</td>\n</tr>\n<tr rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,0.30\\,$<br>$\\,0.21\\,$<br>$\\,0.10\\,$</td>\n<td data-cell-align=\"right\">$\\,\\bbox[3pt,Gainsboro]{\\color{blue}0.33}\\,$<br>$\\,0.24\\,$<br>$\\,0.12\\,$</td>\n<td data-cell-align=\"right\">$\\,0.36\\,$<br>$\\,0.26\\,$<br>$\\,0.14\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this cell, we see that\n\n$$\nP(X \\geq \\bbox[3pt,Gainsboro]{\\color{blue}0.33}) = 0.9\n$$\n\nTherefore, our answer is\n\n$$\nx=\\bbox[3pt,Gainsboro]{\\color{blue}0.33}\n$$"] [17592186161727 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = 0.01$, where $X\\sim F(\\nu_1, \\nu_2)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu_2\\setminus \\nu_1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$15$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,10.46\\,$</td>\n<td>$\\,10.16\\,$</td>\n<td>$\\,9.963\\,$</td>\n<td>$\\,9.825\\,$</td>\n<td>$\\,9.722\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td>$\\,6.993\\,$</td>\n<td>$\\,6.719\\,$</td>\n<td>$\\,6.538\\,$</td>\n<td>$\\,6.410\\,$</td>\n<td>$\\,6.314\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td>$\\,5.613\\,$</td>\n<td>$\\,5.351\\,$</td>\n<td>$\\,5.178\\,$</td>\n<td>$\\,5.055\\,$</td>\n<td>$\\,4.962\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$11$</td>\n<td>$\\,4.886\\,$</td>\n<td>$\\,4.632\\,$</td>\n<td>$\\,4.462\\,$</td>\n<td>$\\,4.342\\,$</td>\n<td>$\\,4.251\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$13$</td>\n<td>$\\,4.441\\,$</td>\n<td>$\\,4.191\\,$</td>\n<td>$\\,4.025\\,$</td>\n<td>$\\,3.905\\,$</td>\n<td>$\\,3.815\\,$</td>\n</tr></tbody></table></div>\n\n\nGiven that $X \\sim F(13,9)$, find the value $c$ such that $P(X \\geq c) = 0.99$. Round your answer to three decimal places."] [17592186161728 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p$, where $X\\sim F(\\nu_1, \\nu_2)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td colspan=\"2\" data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu_2\\setminus \\nu_1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.010$<br>$\\,p=0.050$<br>$\\,p=0.100$<br>$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,15.98\\,$<br>$\\,6.39\\,$<br>$\\,4.11\\,$<br>$\\,0.24\\,$<br>$\\,0.16\\,$<br>$\\,0.06\\,$</td>\n<td data-cell-align=\"right\">$\\,15.52\\,$<br>$\\,6.26\\,$<br>$\\,4.05\\,$<br>$\\,0.28\\,$<br>$\\,0.19\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,15.21\\,$<br>$\\,6.16\\,$<br>$\\,4.01\\,$<br>$\\,0.31\\,$<br>$\\,0.22\\,$<br>$\\,0.11\\,$</td>\n</tr>\n<tr data-next-row=\"true\" rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.010$<br>$\\,p=0.050$<br>$\\,p=0.100$<br>$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,11.39\\,$<br>$\\,5.19\\,$<br>$\\,3.52\\,$<br>$\\,0.25\\,$<br>$\\,0.16\\,$<br>$\\,0.06\\,$</td>\n<td data-cell-align=\"right\">$\\,10.97\\,$<br>$\\,5.05\\,$<br>$\\,3.45\\,$<br>$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,10.67\\,$<br>$\\,4.95\\,$<br>$\\,3.40\\,$<br>$\\,0.32\\,$<br>$\\,0.23\\,$<br>$\\,0.11\\,$</td>\n</tr>\n<tr rowspan=\"3\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td data-fill=\"#D6EAF8\">$\\,p=0.010$<br>$\\,p=0.050$<br>$\\,p=0.100$<br>$\\,p=0.900$<br>$\\,p=0.950$<br>$\\,p=0.990$</td>\n<td data-cell-align=\"right\">$\\,9.15\\,$<br>$\\,4.53\\,$<br>$\\,3.18\\,$<br>$\\,0.25\\,$<br>$\\,0.16\\,$<br>$\\,0.07\\,$</td>\n<td data-cell-align=\"right\">$\\,8.75\\,$<br>$\\,4.39\\,$<br>$\\,3.11\\,$<br>$\\,0.29\\,$<br>$\\,0.20\\,$<br>$\\,0.09\\,$</td>\n<td data-cell-align=\"right\">$\\,8.47\\,$<br>$\\,4.28\\,$<br>$\\,3.05\\,$<br>$\\,0.33\\,$<br>$\\,0.23\\,$<br>$\\,0.12\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nIf $X\\sim F(5,4)$, then calculate the following probability.\n\n$P\\left(\\dfrac{1}{3.52} \\leq X \\leq 6.26 \\right)$"] [17592186161729 :question/problem "Calculate Spearman's correlation coefficient $r_s$ for the two sets of ranks given below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<th data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$x_i$</strong></th>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<th data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$y_i$</strong></th>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161730 :question/problem "The air pollution level in micrograms per cubic meter and average lung capacity of citizens in liters for five cities are shown in the table below. The cities are labeled A-E.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">A</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">B</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">C</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">D</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">E</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Air Pollution</strong></td>\n<td data-cell-align=\"center\">$50$</td>\n<td data-cell-align=\"center\">$30$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$60$</td>\n<td data-cell-align=\"center\">$35$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Lung Capacity</strong></td>\n<td data-cell-align=\"center\">$3.4$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$3.8$</td>\n<td data-cell-align=\"center\">$3.5$</td>\n<td data-cell-align=\"center\">$4.1$</td>\n</tr>\n</tbody></table></div>\n\n\nCalculate **Spearman's rank** correlation coefficient for this data."] [17592186161730 :question/worked-solution "The Spearman's rank correlation coefficient $r_s$ is Pearson's correlation coefficient applied to two sets of ranks.\n\nGiven two sets of ranks $x_1, x_2, \\ldots, x_n$ and $y_1, y_2, \\ldots, y_n$, where the numbers in each set are uniquely expressed as integers between $1$ and $n$, the Spearman's rank correlation coefficient can be calculated as follows:\n\n$$\nr = 1 - \\dfrac{6}{n(n^2-1)}\\sum_{i=1}^n d_i^2\n$$\n\nwhere\n\n$$\nd_i = x_i - y_i\n$$\n\nis the difference between the ranks of $x_i$ and $y_i$.\n\nFirst, we need to rank the cities' pollution levels and average lung capacities. So, we'll label the highest value in each category as $1$ and the lowest value in each category as $5$ (Note that we can rank the values in each category the opposite way, and the final answer will be the same).\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">A</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">B</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">C</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">D</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">E</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Air Pollution</strong></td>\n<td data-cell-align=\"center\">$50$</td>\n<td data-cell-align=\"center\">$30$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$60$</td>\n<td data-cell-align=\"center\">$35$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Lung Capacity</strong></td>\n<td data-cell-align=\"center\">$3.4$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$3.8$</td>\n<td data-cell-align=\"center\">$3.5$</td>\n<td data-cell-align=\"center\">$4.1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Rank (Air Pollution)</strong></td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Rank (Lung Capacity)</strong></td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nNext, we calculate the differences between the ranks, and their squares.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">A</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">B</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">C</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">D</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">E</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Rank (Air Pollution)</strong></td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Rank (Lung Capacity)</strong></td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$d_i$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$-3$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$d_i^2$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$9$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that\n\n$$\n\\displaystyle\\sum_i d_i = 0\n$$\n\nas expected, and\n\n$$\n\\sum_i d_i^2 = 9+9+0+9+9 = 36\n$$\n\nTherefore, the Spearman's rank correlation coefficient is\n\n$$\nr_s = 1 - \\dfrac{6(36)}{5(5^2-1)} = \\bbox[3pt,Gainsboro]{\\color{blue}-0.8}\n$$"] [17592186161731 :question/problem "A film critic ranks five movies based on the screenplay and actors' performance. The table below shows the rankings, where the movies are labeled $A$-$E$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">A</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">B</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">C</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">D</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">E</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Screenplay</strong></td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Actors' performance</strong></td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n</tbody></table></div>\n\n\nCalculate Spearman's correlation coefficient $r_s$ and interpret the result."] [17592186161731 :question/worked-solution "The Spearman's rank correlation coefficient $r_s$ is Pearson's correlation coefficient applied to two sets of ranks.\n\nGiven two sets of ranks $x_1, x_2, \\ldots, x_n$ and $y_1, y_2, \\ldots, y_n$, where the numbers in each set are uniquely expressed as integers between $1$ and $n$, the Spearman's rank correlation coefficient can be calculated as follows:\n\n$$\nr_s = 1 - \\dfrac{6}{n(n^2-1)}\\sum_{i=1}^n d_i^2\n$$\n\nwhere\n\n$$\nd_i = x_i - y_i\n$$\n\nis the difference between the ranks of $x_i$ and $y_i$.\n\nFirst, we calculate the differences between the ranks and their squares.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-fill=\"#D6EAF8\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">A</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">B</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">C</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">D</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">E</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Screenplay</strong></td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>Actors' performances</strong></td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$5$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$d_i$</strong></td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n<tr><td data-cell-align=\"center\" data-fill=\"#D6EAF8\"><strong>$d_i^2$</strong></td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$16$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that\n\n$$\n\\displaystyle\\sum_i d_i = 0\n$$\n\nas expected, and\n\n$$\n\\sum_i d_i^2 = 4+16+4+4+4 = 32\n$$\n\nTherefore, the Spearman's rank correlation coefficient is\n\n$$\nr_s = 1 - \\dfrac{6(32)}{5(5^2-1)} = -0.6\n$$\n\nSince\n\n$$\n-0.7 < r_s \\leq -0.3\n$$\n\nwe conclude that there is a **weak negative correlation** between the rankings."] [17592186161733 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p,$ where $X\\sim \\chi^2(k).$ Given that the random variable $X \\sim \\chi^2(7),$ find the value of $x$ such that $P(X \\geq x) = 0.99.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.995$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.990$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.975$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.950$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.900$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,0.412\\,$</td>\n<td>$\\,0.554\\,$</td>\n<td>$\\,0.831\\,$</td>\n<td>$\\,1.145\\,$</td>\n<td>$\\,1.610\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td>$\\,0.676\\,$</td>\n<td>$\\,0.872\\,$</td>\n<td>$\\,1.237\\,$</td>\n<td>$\\,1.635\\,$</td>\n<td>$\\,2.204\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td>$\\,0.989\\,$</td>\n<td>$\\,1.239\\,$</td>\n<td>$\\,1.690\\,$</td>\n<td>$\\,2.167\\,$</td>\n<td>$\\,2.833\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161733 :question/worked-solution "Since $X \\sim \\chi^2(7),$ we focus on the row of the table that corresponds to $k=7.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.995$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.990$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.975$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.950$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.900$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td>$\\,0.989\\,$</td>\n<td>$\\,1.239\\,$</td>\n<td>$\\,1.690\\,$</td>\n<td>$\\,2.167\\,$</td>\n<td>$\\,2.833\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this row, we see that\n\n$$\nP(X \\geq 1.239) = 0.990.\n$$\n\nTherefore, our answer is $x=1.239.$"] [17592186161734 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\geq x) = p,$ where $X\\sim \\chi^2(k).$ Given that $X \\sim \\chi^2(7),$ find the value of $x$ such that $P(X \\leq x) = 0.005.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.995$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.990$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.975$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.950$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.900$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,0.412\\,$</td>\n<td>$\\,0.554\\,$</td>\n<td>$\\,0.831\\,$</td>\n<td>$\\,1.145\\,$</td>\n<td>$\\,1.610\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$6$</td>\n<td>$\\,0.676\\,$</td>\n<td>$\\,0.872\\,$</td>\n<td>$\\,1.237\\,$</td>\n<td>$\\,1.635\\,$</td>\n<td>$\\,2.204\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td>$\\,0.989\\,$</td>\n<td>$\\,1.239\\,$</td>\n<td>$\\,1.690\\,$</td>\n<td>$\\,2.167\\,$</td>\n<td>$\\,2.833\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161734 :question/worked-solution "The table shows probabilities in the form $P(X > x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(X>x) & =1-P(X\\le x) \\\\  & =1-0.005 \\\\  & =0.995\\end{aligned}\n$$\n\nNow, since $X \\sim \\chi^2(7),$ we focus on the row of the table that corresponds to $k=7.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.995$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.990$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.975$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.950$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.900$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$7$</td>\n<td>$\\,0.989\\,$</td>\n<td>$\\,1.239\\,$</td>\n<td>$\\,1.690\\,$</td>\n<td>$\\,2.167\\,$</td>\n<td>$\\,2.833\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFrom this row, we see that\n\n$$\nP(X > 0.989) = 0.995.\n$$\n\nTherefore, our answer is $x=0.989.$"] [17592186161735 :question/problem "Let the random variable $Y$ be defined as\n\n$$\nY = Z_1^2+Z_2^2+\\cdots + Z_{10}^2\n$$\n\nwhere $Z_i\\sim N(0,1)$ for $1\\leq i\\leq 10.$ Find the value $y$ that satisfies $P(Y\\leq y) = 0.99.$\n\n*Hint: The table below gives the values of $x$ that satisfy $P(X\\geq x) = p,$ where $X\\sim \\chi^2(k).$*\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.150$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.200$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$8$</td>\n<td>$\\,20.090\\,$</td>\n<td>$\\,15.507\\,$</td>\n<td>$\\,13.362\\,$</td>\n<td>$\\,12.027\\,$</td>\n<td>$\\,11.030\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td>$\\,21.666\\,$</td>\n<td>$\\,16.919\\,$</td>\n<td>$\\,14.684\\,$</td>\n<td>$\\,13.288\\,$</td>\n<td>$\\,12.242\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$10$</td>\n<td>$\\,23.209\\,$</td>\n<td>$\\,18.307\\,$</td>\n<td>$\\,15.987\\,$</td>\n<td>$\\,14.534\\,$</td>\n<td>$\\,13.442\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161735 :question/worked-solution "If $Z_i\\sim N(0,1)$ for $1\\leq i \\leq k$ are independent normal random variables, then the sum\n\n$$\nZ_1^2+Z_2^2+\\cdots + Z_{k}^2\n$$\n\nfollows a $\\chi^2(k)$ distribution with $k$ degrees of freedom.\n\nSo, in our case, we have\n\n$$\nY = Z_1^2+Z_2^2+\\cdots + Z_{10}^2 \\sim \\chi^2(10).\n$$\n\nFirst, we express the given probability in the form $P(Y\\geq y){:}$\n\n$$\n\\begin{aligned}P(Y\\le y) & =1-P(Y\\ge y) \\\\ 0.99 & =1-P(Y\\ge y) \\\\ P(Y\\ge y) & =0.01\\end{aligned}\n$$\n\nNow, we wish to find the value $y$ such that $P(Y\\geq y) = 0.01$ This can be found from the given table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.150$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.200$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$8$</td>\n<td>$\\,20.090\\,$</td>\n<td>$\\,15.507\\,$</td>\n<td>$\\,13.362\\,$</td>\n<td>$\\,12.027\\,$</td>\n<td>$\\,11.030\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$9$</td>\n<td>$\\,21.666\\,$</td>\n<td>$\\,16.919\\,$</td>\n<td>$\\,14.684\\,$</td>\n<td>$\\,13.288\\,$</td>\n<td>$\\,12.242\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$10$</td>\n<td>$\\,\\bbox[3pt,Gainsboro]{\\color{blue}23.209}\\,$</td>\n<td>$\\,18.307\\,$</td>\n<td>$\\,15.987\\,$</td>\n<td>$\\,14.534\\,$</td>\n<td>$\\,13.442\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nSo, we have\n\n$$\nP(Y\\geq 23.209) = 0.01\n$$\n\nwhich means\n\n$$\nP(Y\\leq 23.209) = 0.99.\n$$\n\nTherefore, the value $y$ that satisfies $P(Y\\leq y) = 0.99$ is $y=\\bbox[3pt,Gainsboro]{\\color{blue}23.209}.$"] [17592186161736 :question/problem "Suppose $X$ is a random variable with support $S=\\{0,1,2,3\\}$. We wish to carry out a hypothesis test with the following null and alternative hypotheses:\n\n- $H_0:\\: X\\sim B(3, 0.4)$\n- $H_1:\\:X\\not\\sim B(3, 0.4)$\n\nA random sample is carried out, and the data is shown below. Calculate the expected frequency $E_i$ for each observation.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$120$</td>\n<td data-cell-align=\"center\">$180$</td>\n<td data-cell-align=\"center\">$65$</td>\n<td data-cell-align=\"center\">$35$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161736 :question/worked-solution "Under the null hypothesis, we have that $X\\sim B(3, 0.4)$. Therefore,\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( X = x ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{n}{x} \\right) {p}^{x} ( 1 - p {)}^{n - x} \\\\ \\displaystyle  & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{x} \\right) ( 0.4 {)}^{x} ( 0.6 {)}^{3 - x} , \\hspace{2em} x = 0 , 1 , 2 , 3.\\end{array}}\n$$\n\nLet's calculate the probability of each value of $X{:}$\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( X = 0 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{0} \\right) ( 0.4 {)}^{0} ( 0.6 {)}^{3} = 0.216 \\\\ \\displaystyle P ( X = 1 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{1} \\right) ( 0.4 {)}^{1} ( 0.6 {)}^{2} = 0.432 \\\\ \\displaystyle P ( X = 2 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{2} \\right) ( 0.4 {)}^{2} ( 0.6 {)}^{1} = 0.288 \\\\ \\displaystyle P ( X = 3 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{3} \\right) ( 0.4 {)}^{3} ( 0.6 {)}^{0} = 0.064\\end{array}}\n$$\n\nThe sample size is\n\n$$\nN = 120+180+65+35 = 400\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(X = 0) = 400 \\cdot 0.216 = 86.4 \\\\\nE_{1} &= N \\cdot P(X = 1) = 400 \\cdot 0.432 = 172.8 \\\\\nE_{2} &= N \\cdot P(X = 2) = 400 \\cdot 0.288 = 115.2 \\\\\nE_{3} &= N \\cdot P(X = 3) = 400 \\cdot 0.064 = 25.6\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding expected frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$120$</td>\n<td data-cell-align=\"center\">$180$</td>\n<td data-cell-align=\"center\">$65$</td>\n<td data-cell-align=\"center\">$35$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}86.4}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}172.8}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}115.2}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}25.6}$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161737 :question/problem "The manager of a chocolate shop believes that the weekly number of customer complaints about the service follows a Poisson distribution with rate parameter $\\lambda$. The frequency distribution of the complaints over $40$ weeks is summarized below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Number of Complaints $(y_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$\\geq3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequencies $(O_i)$</td>\n<td data-cell-align=\"center\">$20$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$8$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n</tbody></table></div>\n\n\nConduct a chi-square goodness of fit test at the $10\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\: Y\\sim \\mathrm{Po}(\\lambda)$\n- $H_1:\\: Y\\not\\sim \\mathrm{Po}(\\lambda)$\n\nwhere the rate parameter $\\lambda$ is unknown.\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = p$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$1$</td>\n<td>$\\,6.635\\,$</td>\n<td>$\\,3.841\\,$</td>\n<td>$\\,2.706\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2$</td>\n<td>$\\,9.210\\,$</td>\n<td>$\\,5.991\\,$</td>\n<td>$\\,4.605\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td>$\\,11.345\\,$</td>\n<td>$\\,7.815\\,$</td>\n<td>$\\,6.251\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161737 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nLet $Y$ be the number of customer complaints received per week. Under the null hypothesis, we have that $Y \\sim \\mathrm{Po}(\\lambda)$.\n\nThe number of observations is\n\n$$\nN = 20+12+8 =40\n$$\n\nWe can calculate an estimator for $\\lambda$, which we denote as $\\hat \\lambda$, as follows:\n\n$$\n\\begin{aligned}\n\\hat{λ} &= \\frac{total number of events}{total number of observations} \\\\\n&= (∑(y_{i} \\cdot O_{i}))/(N)\n\\end{aligned}\n$$\n\nwhere $O_i$ is the observed frequency for the $i$th observation, $N$ is the number of observations. So, in our case, we have\n\n$$\n\\begin{aligned}\n\\hat{λ} &= \\frac{0 \\cdot 20 + 1 \\cdot 12 + 2 \\cdot 8}{40} \\\\\n&= 0.7\n\\end{aligned}\n$$\n\nTherefore, the proposed distribution is $Y\\sim \\mathrm{Po}(0.7)$.\n\nUnder the hypothesis that $Y \\sim \\mathrm{Po}(0.7)$, we have\n\n$$\n\\begin{aligned}\nP(Y = y) &= \\frac{λ^{y}e^{- λ}}{y!} \\\\\n&= ((0.7)^{y}e^{-0.7})/(y!), y = 0, 1, 2\n\\end{aligned}\n$$\n\nLet's calculate the probability of each value of $Y{:}$\n\n$$\n\\begin{aligned}\nP(Y = 0) &= ((0.7)^{0}e^{-0.7})/(0!) \\approx 0.496585 \\\\\nP(Y = 1) &= ((0.7)^{1}e^{-0.7})/(1!) \\approx 0.347610 \\\\\nP(Y = 2) &= ((0.7)^{2}e^{-0.7})/(2!) \\approx 0.121663 \\\\\nP(Y \\ge 3) &= 1 - P(Y = 0) - P(Y = 1) - P(Y = 2) = 0.034142\n\\end{aligned}\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(Y = 0) = 40 \\cdot 0.496585 \\approx 19.8634 \\\\\nE_{1} &= N \\cdot P(Y = 1) = 40 \\cdot 0.347610 \\approx 13.9044 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 40 \\cdot 0.121663 \\approx 4.8665 \\\\\nE_{3} &= N \\cdot P(Y \\ge 3) = 40 \\cdot 0.034142 \\approx 1.3657\n\\end{aligned}\n$$\n\nNotice that there are two frequencies less than $5$, so we combine the values $Y = 2$ and $Y=3$.\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$\\geq2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$20$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$8$</td>\n</tr><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$19.8634$</td>\n<td data-cell-align=\"center\">$13.9044$</td>\n<td data-cell-align=\"center\">$6.2322$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$0.0009$</td>\n<td data-cell-align=\"center\">$0.2608$</td>\n<td data-cell-align=\"center\">$0.5014$</td>\n</tr>\n</tbody></table></div>\n\n\nWe have rounded values to four decimal places, where appropriate.\n\nWe compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 0.0009 + 0.2608 + 0.5014 \\\\\n&\\approx 0.8\n\\end{aligned}\n$$\n\nTherefore, the test statistic is $\\bbox[3pt,Gainsboro]{\\color{blue}0.8}$ (rounded to one decimal place).\n\nOur data has two constraints: the total number of observations must equal $N$, and the estimated rate $\\hat \\lambda$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 3 - 2 \\\\\n&= 1\n\\end{aligned}\n$$\n\n**Watch Out!** We must use the number of categories in the combined table!\n\nSo, there is\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}1}\n$$\n\ndegree of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu = 1$ at a $10\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}} = 2.706\n$$\n\nand the critical region is\n\n$$\nX\\geq 2.706\n$$\n\nas shown below.\n\n![](images/15/155070611813bc121d3af67bb5e53c5504bfa3e089a4b0b1d491e8f351f36bc7.png)\n\nOur test statistic $(0.8)$ is not inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{insufficient}}$ evidence to reject the null hypothesis."] [17592186161738 :question/problem "Suppose $Y$ is a continuous random variable. We wish to conduct a chi-square goodness-of-fit test at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ $Y\\sim N(\\mu,\\sigma^2)$\n- $H_1:\\:$ $Y\\not\\sim N(\\mu,\\sigma^2)$\n\nwhere the mean $\\mu$ and variance $\\sigma^2$ are unknown.\n\nA random sample is carried out, and the sample data is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Observations $(y_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Frequency $(O_i)$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1\\leq y_i < 5$</td>\n<td data-cell-align=\"center\">$11$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$5\\leq y_i < 9$</td>\n<td data-cell-align=\"center\">$12$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$9\\leq y_i < 13$</td>\n<td data-cell-align=\"center\">$25$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$13\\leq y_i < 17$</td>\n<td data-cell-align=\"center\">$19$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$17\\leq y_i < 21$</td>\n<td data-cell-align=\"center\">$13$</td>\n</tr>\n</tbody></table></div>\n\n\nSome summary statistics for this data set are given below. Each expected frequency $E_i$ is calculated assuming the null hypothesis is true using the estimates $\\widehat{\\mu} \\approx 11.6$ and $\\widehat{\\sigma}^2\\approx 25.4$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i - E_i)^2}{E_i}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1\\leq y_i < 5$</td>\n<td data-cell-align=\"center\">$11$</td>\n<td data-cell-align=\"center\">$6.2992$</td>\n<td data-cell-align=\"center\">$3.5080$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$5\\leq y_i < 9$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$16.7652$</td>\n<td data-cell-align=\"center\">$1.3544$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$9\\leq y_i < 13$</td>\n<td data-cell-align=\"center\">$25$</td>\n<td data-cell-align=\"center\">$24.5351$</td>\n<td data-cell-align=\"center\">$0.0088$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$13\\leq y_i < 17$</td>\n<td data-cell-align=\"center\">$19$</td>\n<td data-cell-align=\"center\">$19.7586$</td>\n<td data-cell-align=\"center\">$0.0291$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$17\\leq y_i < 21$</td>\n<td data-cell-align=\"center\">$13$</td>\n<td data-cell-align=\"center\">$8.7523$</td>\n<td data-cell-align=\"center\">$2.0615$</td>\n</tr>\n</tbody></table></div>\n\n\nCarry out this hypothesis test and state your conclusion."] [17592186161738 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nFirst, note that the number of observations is\n\n$$\nN= 11 + 12 + 25 + 19 + 13 = 80\n$$\n\nWe first need to find estimates for the mean $\\mu$ and variance $\\sigma^2$. We start by finding the midpoint of each observational class.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Observations $(y_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Frequency $(O_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i^{\\textrm{mid}}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$1\\leq y_i < 5$</td>\n<td data-cell-align=\"center\">$11$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$5\\leq y_i < 9$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$7$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$9\\leq y_i < 13$</td>\n<td data-cell-align=\"center\">$25$</td>\n<td data-cell-align=\"center\">$11$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$13\\leq y_i < 17$</td>\n<td data-cell-align=\"center\">$19$</td>\n<td data-cell-align=\"center\">$15$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$17\\leq y_i < 21$</td>\n<td data-cell-align=\"center\">$13$</td>\n<td data-cell-align=\"center\">$19$</td>\n</tr>\n</tbody></table></div>\n\n\nWe can find an estimate $\\widehat{\\mu}$ for the mean $\\mu$ as follows:\n\n$$\n\\begin{aligned}\n\\widehat{μ} &= \\frac{1}{N}∑O_{i} \\cdot y_{i}^{mid} \\\\\n&= \\frac{1}{80}(11 \\cdot 3 + 12 \\cdot 7 + 25 \\cdot 11 + 19 \\cdot 15 + 13 \\cdot 19) \\\\\n&= 11.55 \\\\\n&\\approx 11.6\n\\end{aligned}\n$$\n\nWe can find an estimate $\\widehat{\\sigma}^2$ for the variance $\\sigma^2$ as follows:\n\n$$\n\\begin{aligned}\n\\widehat{σ}^{2} &= \\frac{1}{N - 1}∑O_{i} \\cdot (y_{i}^{mid} - \\widehat{μ})^{2} \\\\\n&= \\frac{1}{80 - 1}(11 \\cdot (3 - 11.55)^{2} + 12 \\cdot (7 - 11.55)^{2} \\\\\n&= + 25 \\cdot (11 - 11.55)^{2} + 19 \\cdot (15 - 11.55)^{2} + 13 \\cdot (19 - 11.55)^{2}) \\\\\n&= 25.4151… \\\\\n&\\approx 25.4\n\\end{aligned}\n$$\n\nOur data has three constraints: the total number of observations must equal $N$, and our estimates for the mean and variance are $11.6$ and $25.4$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 5 - 3 \\\\\n&= 2\n\\end{aligned}\n$$\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}2}\n$$\n\ndegrees of freedom.\n\nWe compute the chi-square test statistic as follows:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 3.5080 + 1.3544 + 0.0088 + 0.0291 + 2.0615 \\\\\n&\\approx 7.0\n\\end{aligned}\n$$\n\nSo, the test statistic is approximately $\\bbox[3pt,Gainsboro]{\\color{blue}7.0}$.\n\nNotice that the test statistic does not lie inside the critical region, as shown below.\n\n![](images/d9/d955393fa1665ae7d971eb104a009e2038484f19f3c29a5134a01854deba69c0.png)\n\nTherefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{insufficient}}$ evidence to reject the null hypothesis."] [17592186161739 :question/problem "Suppose $Y$ is a continuous random variable. We wish to conduct a hypothesis test with the following null and alternative hypotheses:\n\n- $H_0:\\:$ $Y\\sim N(22,(\\sqrt{66})^2)$\n- $H_1:\\:$ $Y\\not\\sim N(22,(\\sqrt{66})^2)$\n\nA random sample is carried out, and the sample data is shown below. The third column gives $P\\left(a < Y < b\\right)$ under the null hypothesis, where $a$ and $b$ are the boundaries for each class of observations.\n\nComplete the table by calculating the expected frequency $E_i$ for each class of observations. Round each answer to **one decimal place.**\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0\\leq y_i < 8$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$0.0390$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$8\\leq y_i < 16$</td>\n<td data-cell-align=\"center\">$13$</td>\n<td data-cell-align=\"center\">$0.1877$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$16\\leq y_i < 24$</td>\n<td data-cell-align=\"center\">$47$</td>\n<td data-cell-align=\"center\">$0.3671$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$24\\leq y_i < 32$</td>\n<td data-cell-align=\"center\">$53$</td>\n<td data-cell-align=\"center\">$0.2936$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$32\\leq y_i < 40$</td>\n<td data-cell-align=\"center\">$22$</td>\n<td data-cell-align=\"center\">$0.0958$</td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161739 :question/worked-solution "The number of observations is\n\n$$\nN= 6+13+47+53+22= 141\n$$\n\nWe compute the expected frequencies for each class of observations by multiplying the total number of observations by the probability that $Y$ lies in that class.\n\n$$\n\\begin{aligned}\nE_{1} &= 141 \\cdot 0.0390 \\approx 5.5 \\\\\nE_{2} &= 141 \\cdot 0.1877 \\approx 26.5 \\\\\nE_{3} &= 141 \\cdot 0.3671 \\approx 51.8 \\\\\nE_{4} &= 141 \\cdot 0.2936 \\approx 41.4 \\\\\nE_{5} &= 141 \\cdot 0.0958 \\approx 13.5\n\\end{aligned}\n$$\n\nTherefore, our completed table is as follows:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0\\leq y_i < 8$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$0.0390$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}5.5}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$8\\leq y_i < 16$</td>\n<td data-cell-align=\"center\">$13$</td>\n<td data-cell-align=\"center\">$0.1877$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}26.5}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$16\\leq y_i < 24$</td>\n<td data-cell-align=\"center\">$47$</td>\n<td data-cell-align=\"center\">$0.3671$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}51.8}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$24\\leq y_i < 32$</td>\n<td data-cell-align=\"center\">$53$</td>\n<td data-cell-align=\"center\">$0.2936$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}41.4}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$32\\leq y_i < 40$</td>\n<td data-cell-align=\"center\">$22$</td>\n<td data-cell-align=\"center\">$0.0958$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}13.5}$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161740 :question/problem "Suppose $Y$ is a continuous random variable. We wish to conduct a chi-square goodness-of-fit test at the $2.5\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ $Y\\sim N(16,(\\sqrt{20})^2)$\n- $H_1:\\:$ $Y\\not\\sim N(16,(\\sqrt{20})^2)$\n\nA random sample is carried out, and the sample data is shown below. The rightmost column gives $P\\left(a < Y < b\\right)$ under the null hypothesis, where $a$ and $b$ are the boundaries for each class of observations.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Observations $(y_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Frequency $(O_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$4\\leq y_i < 10$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$0.0862$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$10\\leq y_i < 16$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$0.4101$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$16\\leq y_i < 22$</td>\n<td data-cell-align=\"center\">$78$</td>\n<td data-cell-align=\"center\">$0.4101$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$22\\leq y_i < 28$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$0.0862$</td>\n</tr>\n</tbody></table></div>\n\n\nCalculate the value of the test statistic for this hypothesis test, rounded to one decimal place."] [17592186161740 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nThe number of observations is\n\n$$\nN= 9+45+78+18 = 150\n$$\n\nNext, we compute the expected frequencies for each class of observations.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i - E_i)^2}{E_i}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$4\\leq y_i < 10$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$0.0862$</td>\n<td data-cell-align=\"center\">$12.9300$</td>\n<td data-cell-align=\"center\">$1.1945$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$10\\leq y_i < 16$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$0.4101$</td>\n<td data-cell-align=\"center\">$61.5150$</td>\n<td data-cell-align=\"center\">$4.4338$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$16\\leq y_i < 22$</td>\n<td data-cell-align=\"center\">$78$</td>\n<td data-cell-align=\"center\">$0.4101$</td>\n<td data-cell-align=\"center\">$61.5150$</td>\n<td data-cell-align=\"center\">$4.4177$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$22\\leq y_i < 28$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$0.0862$</td>\n<td data-cell-align=\"center\">$12.9300$</td>\n<td data-cell-align=\"center\">$1.9880$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that all the expected frequencies are greater than or equal to $5$. We have rounded to four decimal places, where appropriate.\n\nFinally, we calculate the test statistic by summing the values in the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 1.1945 + 4.4338 + 4.4177 + 1.9880 \\\\\n&\\approx 12.0\n\\end{aligned}\n$$\n\nTherefore, the test statistic is approximately $\\bbox[3pt,Gainsboro]{\\color{blue}12.0}$."] [17592186161857 :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\textrm E[X] = 2.3,$ calculate $\\textrm{Var}[-10X].$ \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\" data-cell-weight=\"bold\">$x$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\" data-cell-weight=\"bold\">$f(x)$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161860 :question/problem "If $X_1\\sim N(10,3^2)$ and $X_2\\sim N(20,5^2)$ are independent and $Y=5X_1-4X_2,$ calculate $P(3 \\lt Y \\lt  40 ).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"none\" data-table-align=\"center\">\n<tbody><tr>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.01$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.02$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.03$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 1.2 \\,$</th><td data-cell-align=\"center\"> $0.8869$ </td><td data-cell-align=\"center\"> $0.8888$ </td><td data-cell-align=\"center\"> $0.8907$ </td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 1.3 \\,$</th><td data-cell-align=\"center\"> $0.9049$ </td><td data-cell-align=\"center\"> $0.9066$ </td><td data-cell-align=\"center\"> $0.9082$ </td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 1.4 \\,$</th><td data-cell-align=\"center\"> $0.9207$ </td><td data-cell-align=\"center\"> $0.9222$ </td><td data-cell-align=\"center\"> $0.9236$ </td></tr>\n</tbody></table></div>\n</th>\n<th></th>\n<th>\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.00$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.01$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.02$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 2.7 \\,$</th><td data-cell-align=\"center\"> $0.9965$ </td><td data-cell-align=\"center\"> $0.9966$ </td><td data-cell-align=\"center\"> $0.9967$ </td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 2.8 \\,$</th><td data-cell-align=\"center\"> $0.9974$ </td><td data-cell-align=\"center\"> $0.9975$ </td><td data-cell-align=\"center\"> $0.9976$ </td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 2.9 \\,$</th><td data-cell-align=\"center\"> $0.9981$ </td><td data-cell-align=\"center\"> $0.9982$ </td><td data-cell-align=\"center\"> $0.9982$ </td></tr>\n</tbody></table></div>\n</th>\n</tr>\n</tbody></table></div>\n\n"] [17592186161861 :question/problem "The math test results of a group of students are normally distributed with a mean of $67$ and a standard deviation of $12.$ The results of the same group on a history test are normally distributed with a mean of $73$ and a standard deviation of $9.$ If one student is randomly selected, what is the probability their combined score from both tests is more than $150?$ You may assume that the student's scores on both tests are independent. \n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.05 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.06 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.07 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.08 \\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.09 \\,$</th>\n</tr><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.5 \\,$</th><td data-cell-align=\"center\">$\\, 0.7088 \\,$</td><td data-cell-align=\"center\">$\\, 0.7123 \\,$</td><td data-cell-align=\"center\">$\\, 0.7157 \\,$</td><td data-cell-align=\"center\">$\\, 0.7190 \\,$</td><td data-cell-align=\"center\">$\\, 0.7224 \\,$</td></tr>\n<tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.6 \\,$</th><td data-cell-align=\"center\">$\\, 0.7422 \\,$</td><td data-cell-align=\"center\">$\\, 0.7454 \\,$</td><td data-cell-align=\"center\">$\\, 0.7486 \\,$</td><td data-cell-align=\"center\">$\\, 0.7517 \\,$</td><td data-cell-align=\"center\">$\\, 0.7549 \\,$</td></tr>\n<tr> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\, 0.7 \\,$</th><td data-cell-align=\"center\">$\\, 0.7734 \\,$</td><td data-cell-align=\"center\">$\\, 0.7764 \\,$</td><td data-cell-align=\"center\">$\\, 0.7794 \\,$</td><td data-cell-align=\"center\">$\\, 0.7823 \\,$</td><td data-cell-align=\"center\">$\\, 0.7852 \\,$</td></tr>\n</tbody></table></div>\n\n"] [17592186161863 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$\\dfrac a2$</td>\n<td data-cell-align=\"center\">$a$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$a$</td>\n<td data-cell-align=\"center\">$\\dfrac 52a$</td>\n</tr>\n</tbody></table></div>\n\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given above. Find the value of $a.$"] [17592186161871 :question/problem "Given the joint probability distribution $f(x,y)$ below for the discrete random variables $X$ and $Y,$ find $P(X = 0).$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n<td data-cell-align=\"center\">$\\dfrac{5}{12}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{4}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161871 :question/worked-solution "If the random variables $X$ and $Y$ have joint distribution with joint probability mass function $f(x,y),$ then we have\n\n$$\n\\begin{aligned}P(X=x) & ={f}_{X}(x)={\\sum }_{y}f(x,y) \\\\ P(Y=y) & ={f}_{Y}(y)={\\sum }_{x}f(x,y)\\end{aligned}\n$$\n\nwhere $f_X(x)$ and $f_Y(y)$ are the marginal mass functions for $X$ and $Y,$ respectively.\n\nIn this case, the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals. Let's add these row and column totals to our table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n<td data-cell-align=\"center\">$\\dfrac{5}{12}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}\\dfrac{7}{12}}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{4}$</td>\n<td data-cell-align=\"center\">$\\dfrac{1}{6}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{5}{12}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{5}{12}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\dfrac{7}{12}$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nFinally, using the table, we have\n\n$$\n\\begin{aligned}P(X=0) & ={f}_{X}(0) \\\\  & =f(0,0)+f(0,1) \\\\  & =\\frac{1}{6}+\\frac{5}{12} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"] [17592186161872 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.35$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n</tr>\n</tbody></table></div>\n\n\nGiven the joint probability mass function $f(x,y)$ above for the discrete random variables $X$ and $Y,$ calculate $P(X \\geq 2).$"] [17592186161872 :question/worked-solution "If the random variables $X$ and $Y$ have joint distribution with joint probability mass function $f(x,y),$ then we have\n\n$$\n\\begin{aligned}P(X=x) & ={f}_{X}(x)={\\sum }_{y}f(x,y) \\\\ P(Y=y) & ={f}_{Y}(y)={\\sum }_{x}f(x,y)\\end{aligned}\n$$\n\nwhere $f_X(x)$ and $f_Y(y)$ are the marginal mass functions for $X$ and $Y,$ respectively.\n\nIn this case, the marginal distribution for $X$ corresponds to the row totals, and the marginal distribution for $Y$ corresponds to the column totals. Let's add these row and column totals to our table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.25}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.35$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.5}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=3$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$\\bbox[2pt,Gainsboro]{\\color{blue}0.25}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_Y$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.35$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$0.65$</td>\n<td data-cell-align=\"center\" data-fill=\"#F2F4F4\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nThe marginal mass function for $X$ is given in the following table:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f_X(x)$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n</tr>\n</tbody></table></div>\n\n\nFinally, using the table of values of the marginal mass function for $X,$ we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =P(X\\in \\{2,3\\}) \\\\  & =P(X=2)+P(X=3) \\\\  & =0.5+0.25 \\\\  & =0.75.\\end{aligned}\n$$"] [17592186161873 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n</tr>\n<tr><td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=6$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n</tr>\n</tbody></table></div>\n\n\nCompute $P\\Big( (X,Y) \\in \\{(2,3), (6,1) \\}\\Big)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161874 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.25$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n</tr>\n</tbody></table></div>\n\n\nCompute $P\\left( X\\cdot Y \\geq 4 \\right)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161876 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.5$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=1$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0.3$</td>\n</tr>\n</tbody></table></div>\n\n\nCompute $P(Y=0 \\,|\\, X=1)$ given that the discrete random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above."] [17592186161877 :question/problem "\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$f$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=2$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$Y=3$</td></tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=0$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=2$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0.15$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$X=4$</td>\n<td data-cell-align=\"center\">$0.2$</td>\n<td data-cell-align=\"center\">$0.05$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0.1$</td>\n</tr>\n</tbody></table></div>\n\n\nCompute $P(0\\lt Y \\lt 3\\,|\\, X=0  )$ given that the discrete random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above. Round your answer to two decimal places."] [17592186161881 :question/problem "A particular city uses three types of public transportation: type $1$, type $2$, and type $3$. Citizens' preferences across the three types are believed to be equally distributed. A random sample of citizens is conducted, and the frequency distribution of citizens who use each type of transport in the sample is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Transportation Type $(y_i)$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$135$</td>\n<td data-cell-align=\"center\">$153$</td>\n<td data-cell-align=\"center\">$162$</td>\n</tr>\n</tbody></table></div>\n\n\nSuppose a hypothesis test is conducted with the following null and alternative hypotheses:\n\n- $H_0:\\:$ Transportation preferences are distributed uniformly.\n- $H_1:\\:$ Transportation preferences are not distributed uniformly.\n\nCalculate the value of the chi-square test statistic for this hypothesis test."] [17592186161881 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. The chi-square test statistic is given by\n\n$$\n\\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\nwhere\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nLet $Y$ be the preferred type of public transportation of a randomly selected citizen from the population under the null hypothesis. Then, we have\n\n$$\nP(Y=y)=\\dfrac 13,\\qquad y=1,2,3\n$$\n\nThe total number of citizens in the sample is\n\n$$\nN = 135 + 153+ 162 = 450\n$$\n\nTherefore, the expected frequencies for each type of public transportation are as follows:\n\n$$\n\\begin{aligned}\nE_{1} &= N \\cdot P(Y = 1) = 450 \\cdot \\frac{1}{3} = 150 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 450 \\cdot \\frac{1}{3} = 150 \\\\\nE_{3} &= N \\cdot P(Y = 3) = 450 \\cdot \\frac{1}{3} = 150\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$135$</td>\n<td data-cell-align=\"center\">$153$</td>\n<td data-cell-align=\"center\">$162$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$150$</td>\n<td data-cell-align=\"center\">$150$</td>\n<td data-cell-align=\"center\">$150$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$1.5$</td>\n<td data-cell-align=\"center\">$0.06$</td>\n<td data-cell-align=\"center\">$0.96$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that we have rounded values to four decimal places, where appropriate.\n\nWe compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 1.5 + 0.06 + 0.96 \\\\\n&= 2.52\n\\end{aligned}\n$$\n\nTherefore, the value of the test statistic is $\\bbox[3pt,Gainsboro]{\\color{blue}2.52}$."] [17592186161882 :question/problem "Suppose $Y$ is a random variable with support $S=\\{1,2,3\\}$. A random sample is carried out, and the sample data is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observation $(y_i)$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$\\,42\\,$</td>\n<td data-cell-align=\"center\">$\\,40\\,$</td>\n<td data-cell-align=\"center\">$\\,68\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nConduct a chi-square goodness of fit test at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\: Y\\sim U\\{1,2,3\\}$\n- $H_1:\\: Y\\not\\sim U\\{1,2,3\\}$\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = p$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$1$</td>\n<td>$\\,2.706\\,$</td>\n<td>$\\,3.841\\,$</td>\n<td>$\\,5.024\\,$</td>\n<td>$\\,6.635\\,$</td>\n<td>$\\,7.879\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2$</td>\n<td>$\\,4.605\\,$</td>\n<td>$\\,5.991\\,$</td>\n<td>$\\,7.378\\,$</td>\n<td>$\\,9.210\\,$</td>\n<td>$\\,10.597\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td>$\\,6.251\\,$</td>\n<td>$\\,7.815\\,$</td>\n<td>$\\,9.348\\,$</td>\n<td>$\\,11.345\\,$</td>\n<td>$\\,12.838\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161882 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nUnder the null hypothesis, we have that $Y\\sim U\\{1,2,3\\}$. Therefore,\n\n$$\nP(Y=y)=\\dfrac{1}{3},\\qquad y=1,2,3\n$$\n\nThe sample size is\n\n$$\nN = 57 + 40 + 53 = 150\n$$\n\nTherefore, the expected frequencies for each species are as follows:\n\n$$\n\\begin{aligned}\nE_{1} &= N \\cdot P(Y = 1) = 150 \\cdot \\frac{1}{3} = 50 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 150 \\cdot \\frac{1}{3} = 50 \\\\\nE_{3} &= N \\cdot P(Y = 3) = 150 \\cdot \\frac{1}{3} = 50\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$\\,42\\,$</td>\n<td data-cell-align=\"center\">$\\,40\\,$</td>\n<td data-cell-align=\"center\">$\\,68\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$\\,50\\,$</td>\n<td data-cell-align=\"center\">$\\,50\\,$</td>\n<td data-cell-align=\"center\">$\\,50\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$\\,1.28\\,$</td>\n<td data-cell-align=\"center\">$\\,2\\,$</td>\n<td data-cell-align=\"center\">$\\,6.48\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nFirst, we compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 1.28 + 2 + 6.48 \\\\\n&= 9.76\n\\end{aligned}\n$$\n\nTherefore, the test statistic is $\\bbox[3pt,Gainsboro]{\\color{blue}9.76}$.\n\nThere is only one constraint on our data: the total number of observations must equal $N$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 3 - 1 \\\\\n&= 2\n\\end{aligned}\n$$\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}2}\n$$\n\ndegrees of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu=2$ at a $1\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}}=9.210\n$$\n\nand the critical region is\n\n$$\nX\\geq 9.210\n$$\n\nas shown below.\n\n![](images/6c/6cfddf70a50b22ecc9b85c036cf97de6ff88571214e837caa63675110895cdbb.png)\n\nOur test statistic $(9.76)$ lies inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{sufficient}}$ evidence to reject the null hypothesis."] [17592186161883 :question/problem "Suppose $X$ is a random variable with support $S=\\{0,1,2,3,4\\}$. We wish to carry out a hypothesis test with the following null and alternative hypotheses:\n\n- $H_0:\\: X\\sim U\\{0,1,2,3,4\\}$\n- $H_1:\\:X\\not\\sim U\\{0,1,2,3,4\\}$\n\nA random sample is carried out, and the sample data is shown below. Calculate the expected frequency $E_i$ for each observation.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observation $(x_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$47$</td>\n<td data-cell-align=\"center\">$46$</td>\n<td data-cell-align=\"center\">$42$</td>\n<td data-cell-align=\"center\">$40$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Expected Frequency $(E_i)$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161883 :question/worked-solution "Under the null hypothesis, we have that $X\\sim U\\{0,1,2,3,4\\}$. Therefore,\n\n$$\nP(X=x)=\\dfrac 15,\\qquad x=0,1,2,3,4\n$$\n\nThe sample size is\n\n$$\nN = 45+47+46+42+40 = 220\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n{\\begin{array}{rl}\\displaystyle {E}_{1} & \\displaystyle  = N \\cdot  P ( X = 0 ) = 220 \\cdot  {\\displaystyle \\frac{1}{5}} = 44 \\\\ \\displaystyle {E}_{2} & \\displaystyle  = N \\cdot  P ( X = 2 ) = 220 \\cdot  {\\displaystyle \\frac{1}{5}} = 44 \\\\ \\displaystyle  & \\displaystyle  \\phantom{=} \\vdots  \\\\ \\displaystyle {E}_{5} & \\displaystyle  = N \\cdot  P ( X = 4 ) = 220 \\cdot  {\\displaystyle \\frac{1}{5}} = 44\\end{array}}\n$$\n\nA table summarizing the observed and corresponding expected frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$45$</td>\n<td data-cell-align=\"center\">$47$</td>\n<td data-cell-align=\"center\">$46$</td>\n<td data-cell-align=\"center\">$42$</td>\n<td data-cell-align=\"center\">$40$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}44}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}44}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}44}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}44}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}44}$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161884 :question/problem "A basketball player practices free throws, shooting $5$ times per session and tracking the number of successful shots. The frequency distribution of successful shots per session is summarized below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Successful Shots $(y_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequencies $(O_i)$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$32$</td>\n<td data-cell-align=\"center\">$67$</td>\n<td data-cell-align=\"center\">$52$</td>\n<td data-cell-align=\"center\">$27$</td>\n<td data-cell-align=\"center\">$10$</td>\n</tr>\n</tbody></table></div>\n\n\nThe player's coach wants to test whether a binomial distribution can model the observed data.\nCarry out a chi-square goodness-of-fit test at the $10\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The observed distribution can be modeled as $B(5, p)$\n- $H_1:\\:$ The observed distribution cannot be modeled as $B(5, p)$\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = q$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus q$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td>$\\,11.345\\,$</td>\n<td>$\\,7.815\\,$</td>\n<td>$\\,6.251\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td>$\\,13.277\\,$</td>\n<td>$\\,9.488\\,$</td>\n<td>$\\,7.779\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,15.086\\,$</td>\n<td>$\\,11.070\\,$</td>\n<td>$\\,9.236\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161884 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nThe number of observations is\n\n$$\nN= 12+32+67+52+27+10 = 200\n$$\n\nWe can calculate an estimate of $p$, which we denote as $\\hat p$, as follows:\n\n$$\n\\begin{aligned}\n\\hat{p} &= \\frac{total number of successes}{total number of trials} \\\\\n&= (∑(y_{i} \\cdot O_{i}))/(n \\cdot N)\n\\end{aligned}\n$$\n\nwhere $N$ is the number of observations, and $n$ is the number of trials in each binomial sequence. So, in our case, we have\n\n$$\n\\begin{aligned}\n\\hat{p} &= \\frac{0 \\cdot 12 + 1 \\cdot 32 + 2 \\cdot 67 + 3 \\cdot 52 + 4 \\cdot 27 + 5 \\cdot 0}{5 \\cdot 200} \\\\\n&= 0.48\n\\end{aligned}\n$$\n\nTherefore, the proposed distribution is $Y\\sim B(5, \\, 0.48)$.\n\nUnder the hypothesis that $Y\\sim B(5, \\, 0.48)$, we have\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( Y = y ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{n}{y} \\right) {p}^{y} ( 1 - p {)}^{n - y} \\\\ \\displaystyle  & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{y} \\right) ( 0.48 {)}^{y} ( 0.52 {)}^{5 - y} , \\hspace{2em} y = 0 , 1 , 2 , 3 , 4 , 5\\end{array}}\n$$\n\nLet's calculate the probability of each value of $Y{:}$\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( Y = 0 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{0} \\right) ( 0.48 {)}^{0} ( 0.52 {)}^{5} = 0.038 \\\\ \\displaystyle P ( Y = 1 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{1} \\right) ( 0.48 {)}^{1} ( 0.52 {)}^{4} = 0.1755 \\\\ \\displaystyle P ( Y = 2 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{2} \\right) ( 0.48 {)}^{2} ( 0.52 {)}^{3} = 0.324 \\\\ \\displaystyle P ( Y = 3 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{3} \\right) ( 0.48 {)}^{3} ( 0.52 {)}^{2} = 0.299 \\\\ \\displaystyle P ( Y = 4 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{4} \\right) ( 0.48 {)}^{4} ( 0.52 {)}^{1} = 0.138 \\\\ \\displaystyle P ( Y = 5 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{5}{5} \\right) ( 0.48 {)}^{5} ( 0.52 {)}^{0} = 0.0255\\end{array}}\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(Y = 0) = 200 \\cdot 0.0380 = 7.6 \\\\\nE_{1} &= N \\cdot P(Y = 1) = 200 \\cdot 0.1755 = 35.1 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 200 \\cdot 0.3240 = 64.8 \\\\\nE_{3} &= N \\cdot P(Y = 3) = 200 \\cdot 0.2990 = 59.8 \\\\\nE_{4} &= N \\cdot P(Y = 4) = 200 \\cdot 0.1380 = 27.6 \\\\\nE_{5} &= N \\cdot P(Y = 5) = 200 \\cdot 0.0255 = 5.1\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$4$</td>\n<td data-cell-align=\"center\">$5$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$32$</td>\n<td data-cell-align=\"center\">$67$</td>\n<td data-cell-align=\"center\">$52$</td>\n<td data-cell-align=\"center\">$27$</td>\n<td data-cell-align=\"center\">$10$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$7.6$</td>\n<td data-cell-align=\"center\">$35.1$</td>\n<td data-cell-align=\"center\">$64.8$</td>\n<td data-cell-align=\"center\">$59.8$</td>\n<td data-cell-align=\"center\">$27.6$</td>\n<td data-cell-align=\"center\">$5.1$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$2.5474$</td>\n<td data-cell-align=\"center\">$0.2738$</td>\n<td data-cell-align=\"center\">$0.0747$</td>\n<td data-cell-align=\"center\">$1.0174$</td>\n<td data-cell-align=\"center\">$0.0130$</td>\n<td data-cell-align=\"center\">$4.7078$</td>\n</tr>\n</tbody></table></div>\n\n\nWe have rounded values to four decimal places, where appropriate. Notice that all of the expected frequencies are greater than or equal to $5$.\n\nFirst, we compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 2.5474 + 0.2738 + 0.0747 + 1.0173 + 0.0130 + 4.7078 \\\\\n&\\approx 8.6\n\\end{aligned}\n$$\n\nTherefore, the test statistic is approximately $\\bbox[3pt,Gainsboro]{\\color{blue}8.6}$.\n\nThere are two constraints on our data: the total number of observations must equal $N$, and our estimated probability of success $\\hat p$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 6 - 2 \\\\\n&= 4\n\\end{aligned}\n$$\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}4}\n$$\n\ndegrees of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu=4$ at a $10\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}}=7.779\n$$\n\nand the critical region is\n\n$$\nX\\geq 7.779\n$$\n\nas shown below.\n\n![](images/39/3949c36fa794d40d277708c4ac5808c5895fa40c327445f1fbeb99af7bd136e2.png)\n\nOur test statistic $(8.6)$ lies inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{sufficient}}$ evidence to reject the null hypothesis."] [17592186161885 :question/problem "Suppose $Y$ is a random variable with support $S = \\{0,1,2,3\\}$. A random sample is carried out, and the sample data is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observations $(y_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequencies $(O_i)$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$27$</td>\n<td data-cell-align=\"center\">$8$</td>\n</tr>\n</tbody></table></div>\n\n\nCarry out a chi-square goodness of fit test at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The observed distribution can be modeled as $B(3,0.6)$\n- $H_1:\\:$ The observed distribution cannot be modeled as $B(3,0.6)$\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = q$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus q$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n</tr>\n<tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$1$</td>\n<td data-cell-align=\"center\">$\\,6.635\\,$</td>\n<td data-cell-align=\"center\">$\\,3.841\\,$</td>\n<td data-cell-align=\"center\">$\\,2.706\\,$</td>\n</tr>\n<tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2$</td>\n<td data-cell-align=\"center\">$\\,9.210\\,$</td>\n<td data-cell-align=\"center\">$\\,5.991\\,$</td>\n<td data-cell-align=\"center\">$\\,4.605\\,$</td>\n</tr>\n<tr data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td data-cell-align=\"center\">$\\,11.345\\,$</td>\n<td data-cell-align=\"center\">$\\,7.815\\,$</td>\n<td data-cell-align=\"center\">$\\,6.251\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161885 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nThe number of observations is\n\n$$\nN= 3+12+27+8 = 50\n$$\n\nUnder the hypothesis that $Y\\sim B(3, \\, 0.6)$, we have\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( Y = y ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{n}{y} \\right) {p}^{y} ( 1 - p {)}^{n - y} \\\\ \\displaystyle  & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{y} \\right) ( 0.6 {)}^{y} ( 0.4 {)}^{3 - y} , \\hspace{2em} y = 0 , 1 , 2 , 3.\\end{array}}\n$$\n\nLet's calculate the probability of each value of $Y{:}$\n\n$$\n{\\begin{array}{rl}\\displaystyle P ( Y = 0 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{0} \\right) ( 0.6 {)}^{0} ( 0.4 {)}^{3} = 0.064 \\\\ \\displaystyle P ( Y = 1 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{1} \\right) ( 0.6 {)}^{1} ( 0.4 {)}^{2} = 0.288 \\\\ \\displaystyle P ( Y = 2 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{2} \\right) ( 0.6 {)}^{2} ( 0.4 {)}^{1} = 0.432 \\\\ \\displaystyle P ( Y = 3 ) & \\displaystyle  = \\left( \\genfrac{}{}{0pt}{}{3}{3} \\right) ( 0.6 {)}^{3} ( 0.4 {)}^{0} = 0.216\\end{array}}\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(Y = 0) = 50 \\cdot 0.064 = 3.2 \\\\\nE_{1} &= N \\cdot P(Y = 1) = 50 \\cdot 0.288 = 14.4 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 50 \\cdot 0.432 = 21.6 \\\\\nE_{3} &= N \\cdot P(Y = 3) = 50 \\cdot 0.216 = 10.8\n\\end{aligned}\n$$\n\nNotice that there is one frequency less than $5$, so we combine the values $Y=0$ and $Y=1$.\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$\\leq 1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$27$</td>\n<td data-cell-align=\"center\">$8$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$17.6$</td>\n<td data-cell-align=\"center\">$21.6$</td>\n<td data-cell-align=\"center\">$10.8$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$0.384\\,091$</td>\n<td data-cell-align=\"center\">$1.35$</td>\n<td data-cell-align=\"center\">$0.725\\,926$</td>\n</tr>\n</tbody></table></div>\n\n\nWe have rounded values to six decimal places, where appropriate. Notice that all of the expected frequencies here are greater than or equal to $5$.\n\nFirst, we compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 0.384091 + 1.35 + 0.725926 \\\\\n&\\approx 2.46\n\\end{aligned}\n$$\n\nTherefore, the test statistic is approximately $\\bbox[3pt,Gainsboro]{\\color{blue}2.46}$.\n\nThere is one constraint on our data: the total number of observations must equal $N$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 3 - 1 \\\\\n&= 2\n\\end{aligned}\n$$\n\n**Watch out!** We must use the number of categories in the combined table!\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}2}\n$$\n\ndegrees of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu=1$ at a $1\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}}=9.210\n$$\n\nand the critical region is\n\n$$\nX\\geq 9.210\n$$\n\nas shown below.\n\n![](images/29/29977e662d295a3aee4554f405d52eed72c63f768c1ee40bf14e7bd0d5a91544.png)\n\nOur test statistic $(2.46)$ does not lie inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{insufficient}}$ evidence to reject the null hypothesis."] [17592186161886 :question/problem "A shopping center manager believes that the average number of customer complaints received on a randomly selected day follows a Poisson distribution $\\mathrm{Po}(\\lambda)$. The frequency distribution of the complaints received over a period of $50$ days is summarized below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Number of Complaints ($y_i$)</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\geq 4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Frequency ($O_i$)</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$14$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n</tbody></table></div>\n\n\nConduct a chi-square goodness of fit test at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The observed distribution can be modeled as $\\mathrm{Po}(\\lambda)$\n- $H_1:\\:$ The observed distribution cannot be modeled as $\\mathrm{Po}(\\lambda)$\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = p$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\" data-cell-align=\"center\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$1$</td>\n<td data-cell-align=\"center\">$\\,6.635\\,$</td>\n<td data-cell-align=\"center\">$\\,3.841\\,$</td>\n<td data-cell-align=\"center\">$\\,2.706\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2$</td>\n<td data-cell-align=\"center\">$\\,9.210\\,$</td>\n<td data-cell-align=\"center\">$\\,5.991\\,$</td>\n<td data-cell-align=\"center\">$\\,4.605\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td data-cell-align=\"center\">$\\,11.345\\,$</td>\n<td data-cell-align=\"center\">$\\,7.815\\,$</td>\n<td data-cell-align=\"center\">$\\,6.251\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161886 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nY= \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nLet the random variable $Y$ be the number of complaints received on a randomly selected day.\n\nThe number of observations is\n\n$$\nN= 6 + 12 + 18 + 14= 50\n$$\n\nWe can calculate an estimate for $\\lambda$, which we denote as $\\hat \\lambda$, as follows:\n\n$$\n\\begin{aligned}\n\\hat{λ} &= \\frac{total number of events}{total number of observations} \\\\\n&= (∑(y_{i} \\cdot O_{i}))/(N)\n\\end{aligned}\n$$\n\nwhere $O_i$ is the observed frequency for the $i$th observation, and $N$ is the number of observations. So, in our case, we have\n\n$$\n\\begin{aligned}\n\\hat{λ} &= \\frac{0 \\cdot 6 + 1 \\cdot 12 + 2 \\cdot 18 + 3 \\cdot 14}{50} \\\\\n&= 1.8\n\\end{aligned}\n$$\n\nTherefore, the proposed distribution is $Y\\sim \\mathrm{Po}(1.8)$.\n\nUnder the hypothesis that $Y\\sim \\mathrm{Po}(1.8)$, we have\n\n$$\n\\begin{aligned}\nP(Y = y) &= \\frac{λ^{y}e^{- λ}}{y!} \\\\\n&= ((1.8)^{y}e^{-1.8})/(y!), y = 0, 1, 2, 3, …\n\\end{aligned}\n$$\n\nLet's calculate the probability of each value of $Y{:}$\n\n$$\n\\begin{aligned}\nP(Y = 0) &= ((1.8)^{0}e^{-1.8})/(0!) \\approx 0.165299 \\\\\nP(Y = 1) &= ((1.8)^{1}e^{-1.8})/(1!) \\approx 0.297538 \\\\\nP(Y = 2) &= ((1.8)^{2}e^{-1.8})/(2!) \\approx 0.267784 \\\\\nP(Y = 3) &= ((1.8)^{3}e^{-1.8})/(3!) \\approx 0.160671 \\\\\nP(Y \\ge 4) &= 1 - P(Y = 0) - P(Y = 1) - P(Y = 2) - P(Y = 3) = 0.108708\n\\end{aligned}\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(Y = 0) = 50 \\cdot 0.165299 \\approx 8.2650 \\\\\nE_{1} &= N \\cdot P(Y = 1) = 50 \\cdot 0.297538 \\approx 14.8769 \\\\\nE_{2} &= N \\cdot P(Y = 2) = 50 \\cdot 0.267784 \\approx 13.3892 \\\\\nE_{3} &= N \\cdot P(Y = 3) = 50 \\cdot 0.160671 \\approx 8.0336 \\\\\nE_{4} &= N \\cdot P(Y \\ge 4) = 50 \\cdot 0.108708 \\approx 5.4354\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding theoretical frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\geq 4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$6$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$14$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$8.2650$</td>\n<td data-cell-align=\"center\">$14.8769$</td>\n<td data-cell-align=\"center\">$13.3892$</td>\n<td data-cell-align=\"center\">$8.0336$</td>\n<td data-cell-align=\"center\">$5.4354$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$0.6207$</td>\n<td data-cell-align=\"center\">$0.5563$</td>\n<td data-cell-align=\"center\">$1.5878$</td>\n<td data-cell-align=\"center\">$4.4311$</td>\n<td data-cell-align=\"center\">$5.4354$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that the expected frequencies are greater than or equal to $5$. Also, we have rounded values to four decimal places, where appropriate.\n\nWe compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 0.6207 + 0.5563 + 1.5878 + 4.4311 + 5.4354 \\\\\n&= 12.6313\n\\end{aligned}\n$$\n\nTherefore, the test statistic is $\\bbox[3pt,Gainsboro]{\\color{blue}12.6}$ (rounded to one decimal place).\n\nOur data has two constraints: the total number of observations must equal $N$, and the estimated rate parameter $\\hat \\lambda$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 5 - 2 \\\\\n&= 3\n\\end{aligned}\n$$\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}3}\n$$\n\ndegrees of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu=3$ at a $1\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}}=11.345\n$$\n\nand the critical region is\n\n$$\nY\\geq 11.345\n$$\n\nas shown below.\n\n![](images/3f/3f28000117b2d51899700d0e995c44e556f15be3d740cbac98e4e1a3c95ff709.png)\n\nOur test statistic $(12.6)$ lies inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{sufficient}}$ evidence to reject the null hypothesis."] [17592186161887 :question/problem "Suppose $Y$ is a continuous random variable. We wish to conduct a chi-square goodness-of-fit test at the $5\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ $Y\\sim N(10,(\\sqrt{30})^2)$\n- $H_1:\\:$ $Y\\not\\sim N(10,(\\sqrt{30})^2)$\n\nA random sample is carried out, and the sample data is shown below. The rightmost column gives $P\\left(a < Y < b\\right)$ under the null hypothesis, where $a$ and $b$ are the boundaries for each class of observations.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Observations $(y_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Frequency $(O_i)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0\\leq y_i < 5$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$0.1467$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$5\\leq y_i < 10$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$0.3193$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$10\\leq y_i < 15$</td>\n<td data-cell-align=\"center\">$19$</td>\n<td data-cell-align=\"center\">$0.3193$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$15\\leq y_i < 20$</td>\n<td data-cell-align=\"center\">$14$</td>\n<td data-cell-align=\"center\">$0.1467$</td>\n</tr>\n</tbody></table></div>\n\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = p$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.025$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td>$\\,6.251\\,$</td>\n<td>$\\,7.815\\,$</td>\n<td>$\\,9.348\\,$</td>\n<td>$\\,11.345\\,$</td>\n<td>$\\,12.838\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td>$\\,7.779\\,$</td>\n<td>$\\,9.488\\,$</td>\n<td>$\\,11.143\\,$</td>\n<td>$\\,13.277\\,$</td>\n<td>$\\,14.860\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,9.236\\,$</td>\n<td>$\\,11.070\\,$</td>\n<td>$\\,12.832\\,$</td>\n<td>$\\,15.086\\,$</td>\n<td>$\\,16.750\\,$</td>\n</tr>\n</tbody></table></div>\n\n\nConduct this hypothesis test, and state your conclusion."] [17592186161887 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nThe number of observations is\n\n$$\nN= 12 + 15 + 19 + 14= 60\n$$\n\nNext, we compute the expected frequencies for each class of observations.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$y_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$P\\left(a < Y < b\\right)$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i - E_i)^2}{E_i}$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$0\\leq y_i < 5$</td>\n<td data-cell-align=\"center\">$12$</td>\n<td data-cell-align=\"center\">$0.1467$</td>\n<td data-cell-align=\"center\">$8.8020$</td>\n<td data-cell-align=\"center\">$1.1619$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$5\\leq y_i < 10$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$0.3193$</td>\n<td data-cell-align=\"center\">$19.1580$</td>\n<td data-cell-align=\"center\">$0.9024$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\">$10\\leq y_i < 15$</td>\n<td data-cell-align=\"center\">$19$</td>\n<td data-cell-align=\"center\">$0.3193$</td>\n<td data-cell-align=\"center\">$19.1580$</td>\n<td data-cell-align=\"center\">$0.0013$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\">$15\\leq y_i < 20$</td>\n<td data-cell-align=\"center\">$14$</td>\n<td data-cell-align=\"center\">$0.1467$</td>\n<td data-cell-align=\"center\">$8.8020$</td>\n<td data-cell-align=\"center\">$3.0697$</td>\n</tr>\n</tbody></table></div>\n\n\nNotice that all the expected frequencies are greater than or equal to $5$. We have rounded to four decimal places, where appropriate.\n\nFirst, we compute our test statistic:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 1.1619 + 0.9024 + 0.0013 + 3.0697 \\\\\n&\\approx 5.1\n\\end{aligned}\n$$\n\nTherefore, the test statistic is approximately $\\bbox[3pt,Gainsboro]{\\color{blue}5.1}$.\n\nThere is only one constraint on our data: the total number of observations must equal $N$. Therefore, the number of degrees of freedom $\\nu$ is calculated as follows:\n\n$$\n\\begin{aligned}\nν &= number of categories - number of constraints \\\\\n&= 4 - 1 \\\\\n&= 3\n\\end{aligned}\n$$\n\nSo, there are\n\n$$\n\\nu = \\bbox[3pt,Gainsboro]{\\color{blue}3}\n$$\n\ndegrees of freedom.\n\nFrom the given chi-square table, the critical value for $\\nu=3$ at a $5\\%$ significance level is\n\n$$\n\\chi^2_{\\textrm{critical}}=7.815\n$$\n\nand the critical region is\n\n$$\nX\\geq 7.815\n$$\n\nas shown below.\n\n![](images/fa/fad576b25445e2cadd5862f52f5cd376331349e3ad05e7097be0bfa3fafab8ff.png)\n\nOur test statistic $(5.1)$ does not lie inside the critical region. Therefore, there is $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{insufficient}}$ evidence to reject the null hypothesis."] [17592186161889 :question/problem "The salaries of a company's employees range from $\\$30\\,000$ to $\\$90\\,000$ dollars. A random sample of employees is taken, and the frequency distribution of their salaries is shown below.\n\n| Salary (thousands of $\\$$) | $30\\leq y_i \\lt 40$ | $40\\leq y_i \\lt 60$ | $60\\leq y_i \\lt 80$ | $80\\leq y_i \\leq 90$ |\n| --- | ---: | ---: | ---: | ---: |\n| Observed Frequency $(O_i)$ | $\\,27\\,$ | $\\,49\\,$ | $\\,27\\,$ | $\\,17\\,$ |\n\nConduct a chi-squre goodness -of-fit test at the $5\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The salaries are distributed uniformly.\n- $H_1:\\:$ The salaries are not distributed uniformly.\n\nThe table below gives the values of $w$ that satisfy $P(W\\geq w) = p$, where $W\\sim \\chi^2(\\nu)$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\nu \\setminus p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.010$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.050$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.100$</td>\n</tr>\n<tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2$</td>\n<td data-cell-align=\"center\">$\\,9.210\\,$</td>\n<td data-cell-align=\"center\">$\\,5.991\\,$</td>\n<td data-cell-align=\"center\">$\\,4.605\\,$</td>\n</tr>\n<tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td data-cell-align=\"center\">$\\,11.345\\,$</td>\n<td data-cell-align=\"center\">$\\,7.815\\,$</td>\n<td data-cell-align=\"center\">$\\,6.251\\,$</td>\n</tr>\n<tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td data-cell-align=\"center\">$\\,13.277\\,$</td>\n<td data-cell-align=\"center\">$\\,9.488\\,$</td>\n<td data-cell-align=\"center\">$\\,7.779\\,$</td>\n</tr>\n<tr data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td data-cell-align=\"center\">$\\,15.086\\,$</td>\n<td data-cell-align=\"center\">$\\,11.070\\,$</td>\n<td data-cell-align=\"center\">$\\,9.236\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161890 :question/problem "Suppose $Y$ is a random variable with support $S=\\{0,1,2,3, \\ldots\\}$. A random sample is carried out, and the sample data is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observation $(y_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\geq 4$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$30$</td>\n<td data-cell-align=\"center\">$27$</td>\n<td data-cell-align=\"center\">$10$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$0$</td>\n</tr>\n</tbody></table></div>\n\n\nA chi-square goodness of fit test is conducted at the $10\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\: Y\\sim \\mathrm{Po}(\\lambda)$\n- $H_1:\\: Y\\not\\sim \\mathrm{Po}(\\lambda)$\n\nUse this data to calculate an estimator for the rate $\\lambda$."] [17592186161891 :question/problem "A publishing house believes the number of misspellings per page of a draft book follows a Poisson distribution $\\mathrm{Po}(2.5)$. They wish to carry out a hypothesis test with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The observed distribution can be modeled as $\\mathrm{Po}(2.5)$\n- $H_1:\\:$ The observed distribution cannot be modeled as $\\mathrm{Po}(2.5)$\n\nThe table below shows the number of misspellings per page and their corresponding frequencies. Calculate the missing expected frequencies. Round your final answers to one decimal place.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Number of Misspellings $(x_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\geq 4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$26$</td>\n<td data-cell-align=\"center\">$12$</td>\n</tr>\n<tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Expected Frequency $(E_i)$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\">$16.4$</td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n<td data-cell-align=\"center\"></td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161891 :question/worked-solution "Under the null hypothesis, we have that $X\\sim \\mathrm{Po}(2.5)$. Therefore,\n\n$$\n\\begin{aligned}\nP(X = x) &= \\frac{λ^{x}e^{- λ}}{x!} \\\\\n&= ((2.5)^{x}e^{-2.5})/(x!), x = 0, 1, 2, …\n\\end{aligned}\n$$\n\nLet's calculate the probability of each missing value of $X{:}$\n\n$$\n\\begin{aligned}\nP(X = 0) &= ((2.5)^{0}e^{-2.5})/(0!) \\approx 0.082085 \\\\\nP(X = 1) &= ((2.5)^{1}e^{-2.5})/(1!) \\approx 0.205212 \\\\\nP(X = 2) &= ((2.5)^{2}e^{-2.5})/(2!) \\approx 0.256516 \\\\\nP(X = 3) &= ((2.5)^{3}e^{-2.5})/(3!) \\approx 0.213763 \\\\\nP(X \\ge 4) &= 1 - P(X = 0) - P(X = 1) - P(X = 2) - P(X = 3) = 0.242424\n\\end{aligned}\n$$\n\nThe number of observations is\n\n$$\nN = 15 + 18 + 9 + 26+ 12 = 80\n$$\n\nTherefore, the expected frequencies for each observation are as follows:\n\n$$\n\\begin{aligned}\nE_{0} &= N \\cdot P(X = 0) = 80 \\cdot 0.082085 \\approx 6.6 \\\\\nE_{2} &= N \\cdot P(X = 2) = 80 \\cdot 0.256516 \\approx 20.5 \\\\\nE_{3} &= N \\cdot P(X = 3) = 80 \\cdot 0.213763 \\approx 17.1 \\\\\nE_{4} &= N \\cdot P(X \\ge 4) = 80 \\cdot 0.242424 \\approx 19.4\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding expected frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x_i$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n<td data-cell-align=\"center\">$\\geq 4$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$15$</td>\n<td data-cell-align=\"center\">$18$</td>\n<td data-cell-align=\"center\">$9$</td>\n<td data-cell-align=\"center\">$26$</td>\n<td data-cell-align=\"center\">$12$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}6.6}$</td>\n<td data-cell-align=\"center\">$16.4$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}20.5}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}17.1}$</td>\n<td data-cell-align=\"center\">$\\bbox[3pt,Gainsboro]{\\color{blue}19.4}$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186161892 :question/problem "Suppose $Y$ is a continuous random variable with support $S=[0,120]$. A random sample is carried out, and the frequency distribution of the sample data is shown below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Class</td>\n<td data-cell-align=\"center\">$0\\leq y_i < 30$</td>\n<td data-cell-align=\"center\">$30\\leq y_i< 90$</td>\n<td data-cell-align=\"center\">$90\\leq y_i \\leq 120$</td>\n</tr><tr>\n<td data-cell-align=\"left\" data-fill=\"#D6EAF8\">Observed Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$31$</td>\n<td data-cell-align=\"center\">$42$</td>\n<td data-cell-align=\"center\">$27$</td>\n</tr>\n</tbody></table></div>\n\n\nA chi-square goodness of fit test is conducted at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\: Y\\sim U[0,120]$\n- $H_1:\\:Y\\not\\sim U[0,120]$\n\nCalculate the value of the test statistic for this hypothesis test."] [17592186161892 :question/worked-solution "Suppose we have a set of observed frequencies $O_i$ and corresponding expected frequencies $E_i$, as defined by a theoretical model under the null hypothesis. Then, the random variable\n\n$$\nX = \\sum_{i} \\frac{(O_i - E_i)^2}{E_i}\n$$\n\napproximately follows a chi-square distribution with $\\nu$ degrees of freedom, where\n\n- $O_i$ is the observed frequency for category $i$, and\n- $E_i$ is the expected frequency for category $i$, as predicted under the null hypothesis.\n\nThis approximation holds when all expected frequencies $E_i$ are sufficiently large (typically\n\n$$\nE_i \\geq 5\n$$\n\nfor each category), and the observations are independent.\n\nUnder the null hypothesis, we have that $Y\\sim U[0,120]$. Therefore,\n\n$$\nP(a\\leq Y\\lt b)= \\dfrac{b-a}{120-0} = \\dfrac{b-a}{120}\n$$\n\nwhere $a \\lt b$ and $a,b\\in [0,120]$.\n\nThe sample size is\n\n$$\nN = 31 + 42 + 27 = 100\n$$\n\nTherefore, the expected frequencies for each class of observation are as follows:\n\n$$\n\\begin{aligned}\nE_{1} &= N \\cdot P(0 \\le Y < 30) \\\\\n&= 100 \\cdot \\left(\\frac{30 - 0}{120}\\right) \\\\\n&= 25 \\\\\nE_{2} &= N \\cdot P(30 \\le Y < 90) \\\\\n&= 100 \\cdot \\left(\\frac{90 - 30}{120}\\right) \\\\\n&= 50 \\\\\nE_{3} &= N \\cdot P(90 \\le Y < 120) \\\\\n&= 100 \\cdot \\left(\\frac{120 - 90}{120}\\right) \\\\\n&= 25\n\\end{aligned}\n$$\n\nA table summarizing the observed and corresponding expected frequencies is given below:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Class</td>\n<td data-cell-align=\"center\">$0\\leq y_i < 30$</td>\n<td data-cell-align=\"center\">$30\\leq y_i< 90$</td>\n<td data-cell-align=\"center\">$90\\leq y_i \\leq 120$</td>\n</tr><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$O_i$</td>\n<td data-cell-align=\"center\">$31$</td>\n<td data-cell-align=\"center\">$42$</td>\n<td data-cell-align=\"center\">$27$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$E_i$</td>\n<td data-cell-align=\"center\">$25$</td>\n<td data-cell-align=\"center\">$50$</td>\n<td data-cell-align=\"center\">$25$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\dfrac{(O_i-E_i)^2}{E_i}$</td>\n<td data-cell-align=\"center\">$1.44$</td>\n<td data-cell-align=\"center\">$1.28$</td>\n<td data-cell-align=\"center\">$0.16$</td>\n</tr>\n</tbody></table></div>\n\n\nWe compute our test statistic by summing the last row:\n\n$$\n\\begin{aligned}\n∑_(i)((O_{i} - E_{i})^{2})/(E_{i}) &= 1.44 + 1.28 + 0.16 \\\\\n&= 2.88\n\\end{aligned}\n$$\n\nTherefore, the value of the test statistic is $\\bbox[3pt,Gainsboro]{\\color{blue}2.88}$."] [17592186161893 :question/problem "A food quality control team tests boxes of packaged salads to check for damage. Each box contains $3$ salad packs. The results of the test are summarized below.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Number of Damaged Packs in a Box $(x_i)$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n<td data-cell-align=\"center\">$3$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">Frequency $(O_i)$</td>\n<td data-cell-align=\"center\">$20$</td>\n<td data-cell-align=\"center\">$30$</td>\n<td data-cell-align=\"center\">$8$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n</tbody></table></div>\n\n\nA chi-square goodness-of-fit test is conducted at the $1\\%$ significance level with the following null and alternative hypotheses:\n\n- $H_0:\\:$ The sample data fit a binomial distribution $B(3,p)$\n- $H_1:\\:$ The sample data does not fit a binomial distribution $B(3,p)$\n\nUse this data to calculate an estimate of $p$."] [17592186161899 :question/worked-solution "We can write down the binary fraction using a place value chart:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-left=\"none\"><strong>Place Values</strong></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^1$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^0$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">.</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-1}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-2}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-3}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-4}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"><strong>Digits</strong></td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">.</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nTherefore, our number in base $10$ can be written as follows:\n\n$$\n\\begin{aligned}\n(10.0101)_{2} &= \\overbrace{1 \\cdot 2^{1} + 1 \\cdot 2^{0}}^{\\text{whole}} + \\overbrace{1 \\cdot 2^{-1} + 1 \\cdot 2^{-2} + 0 \\cdot 2^{-3} + 1 \\cdot 2^{-4}}^{\\text{fraction}} \\\\\n&= 2 + 1 + 0.5 + 0.25 + 0 + 0.0625 \\\\\n&= (3.8125)_{10}\n\\end{aligned}\n$$"] [17592186161900 :question/worked-solution "We express the number $(3.25)_{10}$ in base $10$ as follows:\n\n- For the whole number part ($3$), we extract the powers of $2$ from the number, starting from the largest possible one.\n- For the fractional part, we extract the *negative* powers of $2$ from the number, starting from the largest possible one.\n\nTherefore, we get:\n\n$$\n\\begin{aligned}\n3.25 &= \\overbrace{3}^{\\text{whole}} + \\overbrace{0.25}^{\\text{fraction}} \\\\\n&= 2^{1} + 2^{0} + 2^{-2} \\\\\n&= \\underbrace{1 \\cdot 2^{1} + 1 \\cdot 2^{0}}_{\\text{whole}} + \\underbrace{0 \\cdot 2^{-1} + 1 \\cdot 2^{-2}}_{\\text{fraction}}\n\\end{aligned}\n$$\n\nSo, the corresponding place value chart is as follows:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-left=\"none\"><strong>Place Values</strong></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{1}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{0}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">.</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-1}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-2}$</td>\n</tr>\n<tr>\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"><strong>Digits</strong></td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">.</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n</tr>\n</tbody></table></div>\n\n\nTherefore,\n\n$$\n(3.25)_{10} = (11.01)_2\n$$"] [17592186161901 :question/worked-solution "We extract the negative powers of $2$ from the number, starting from the largest possible one:\n\n$$\n\\begin{aligned}\n0.9 &= \\underbrace{0.5}_{1/2} + 0.4 \\\\\n&= \\underbrace{0.5}_{1/2} + \\underbrace{0.25}_{1/4} + 0.15 \\\\\n&= \\underbrace{0.5}_{1/2} + \\underbrace{0.25}_{1/4} + \\underbrace{0.125}_{1/8} + 0.025 \\\\\n&= \\underbrace{0.5}_{1/2} + \\underbrace{0.25}_{1/4} + \\underbrace{0.125}_{1/8} + \\underbrace{0.015625}_{1/64} + 0.009375 \\\\\n&= 1 \\cdot 2^{-1} + 1 \\cdot 2^{-2} + 1 \\cdot 2^{-3} + 0 \\cdot 2^{-4} + 0 \\cdot 2^{-5} + 1 \\cdot 2^{-6} + ⋯\n\\end{aligned}\n$$\n\nSo, the corresponding place value chart is as follows:\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-left=\"none\"><strong>Place Values</strong></td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-1}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-2}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-3}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-4}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-5}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$2^{-6}$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\ldots$</td>\n</tr>\n<tr>\n<td data-cell-align=\"right\" data-border-top=\"none\" data-border-bottom=\"none\" data-border-left=\"none\"><strong>Digits</strong></td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$0$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$\\ldots$</td>\n</tr>\n</tbody></table></div>\n\n\nTherefore,\n\n$$\n(0.9)_{10} = (0.\\,111\\:001 \\ldots)_2\n$$"] [17592186162238 :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X∼{χ}^{2}(k).$  Given that the random variable $X∼{χ}^{2}(5),$ find the value of $x$ such that $P(X\\ge x)=0.99.$\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\" data-cell-align=\"center\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$k∖p$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.995$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.990$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.975$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.950$</td>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$0.900$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$3$</td>\n<td>$\\,0.072\\,$</td>\n<td>$\\,0.115\\,$</td>\n<td>$\\,0.216\\,$</td>\n<td>$\\,0.352\\,$</td>\n<td>$\\,0.584\\,$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$4$</td>\n<td>$\\,0.207\\,$</td>\n<td>$\\,0.297\\,$</td>\n<td>$\\,0.484\\,$</td>\n<td>$\\,0.711\\,$</td>\n<td>$\\,1.064\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$5$</td>\n<td>$\\,0.412\\,$</td>\n<td>$\\,0.554\\,$</td>\n<td>$\\,0.831\\,$</td>\n<td>$\\,1.145\\,$</td>\n<td>$\\,1.610\\,$</td>\n</tr>\n</tbody></table></div>\n\n"] [17592186162239 :question/problem "The table below gives the values of $x$ that satisfy $P(X \\ge x) = p$, where $X∼χ^{2}(k)$. Given that $X∼χ^{2}(3)$, find the value of $x$ such that $P(X \\le x) = 0.025$.\n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-tabl