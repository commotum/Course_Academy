l=\"#D6EAF8\">$0.005$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$15$</td>\n<td data-cell-align=\"center\">$1.341$</td>\n<td data-cell-align=\"center\">$1.753$</td>\n<td data-cell-align=\"center\">$2.131$</td>\n<td data-cell-align=\"center\">$2.602$</td>\n<td data-cell-align=\"center\">$2.947$</td>\n</tr>\n<tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$16$</td>\n<td data-cell-align=\"center\">$1.337$</td>\n<td data-cell-align=\"center\">$1.746$</td>\n<td data-cell-align=\"center\">$2.120$</td>\n<td data-cell-align=\"center\">$2.583$</td>\n<td data-cell-align=\"center\">$2.921$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$17$</td>\n<td data-cell-align=\"center\">$1.333$</td>\n<td data-cell-align=\"center\">$1.740$</td>\n<td data-cell-align=\"center\">$2.110$</td>\n<td data-cell-align=\"center\">$2.576$</td>\n<td data-cell-align=\"center\">$2.898$</td>\n</tr>\n</tbody></table></div>\n\n\n> A scientific calculator is required to answer this question."] [17592186188560 :question/problem "Given that ${X}_{1},{X}_{2},…,{X}_{20}$ are I.I.D random variables, where\n\n$$\n{X}_{i}∼N(1,{2}^{2}),\\,1\\le i\\le 20,\n$$\n\ncalculate $P(Y\\le 21),$ where  $Y={X}_{1}+{X}_{2}+⋯+{X}_{20}.$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.* \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\"> <th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$z$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.00\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.01\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.02\\,$</th><th data-cell-align=\"center\" data-fill=\"#D6EAF8\">$\\,0.03\\,$</th>\