sy] [:db/add "9deb93d0-b686-5a18-a81b-2b184fe640f4" :question/answer-fields "3de2a0c9-d204-5efa-99ad-cc95fa78f246"] [:db/ensure "9deb93d0-b686-5a18-a81b-2b184fe640f4" :question/validate] [:db/add 17592186087721 :knowledge-point/questions "9deb93d0-b686-5a18-a81b-2b184fe640f4"] [:db/add "f6a82582-f928-5342-a4ab-842cfa222e4d" :answer/id #uuid "f6a82582-f928-5342-a4ab-842cfa222e4d"] [:db/add "f6a82582-f928-5342-a4ab-842cfa222e4d" :answer/type :answer.type/image] [:db/add "f6a82582-f928-5342-a4ab-842cfa222e4d" :answer/value "images/af/afa8a20868d4c23677bc709c74364f949a515c8e99e4331e1bc361bb476131bf.png"] [:db/ensure "f6a82582-f928-5342-a4ab-842cfa222e4d" :answer/validate] [:db/add "9ff2563c-80c0-51e0-b077-0c0b2d1ed4a0" :answer/id #uuid "9ff2563c-80c0-51e0-b077-0c0b2d1ed4a0"] [:db/add "9ff2563c-80c0-51e0-b077-0c0b2d1ed4a0" :answer/type :answer.type/image] [:db/add "9ff2563c-80c0-51e0-b077-0c0b2d1ed4a0" :answer/value "images/b5/b5a8e3975c3ff7ae9f446c3e46f8e077c34d54207605ae5ef066424ce50c0fd1.png"] [:db/ensure "9ff2563c-80c0-51e0-b077-0c0b2d1ed4a0" :answer/validate] [:db/add "5c64d8ca-2f1c-5402-9ceb-51ad602c8b12" :answer/id #uuid "5c64d8ca-2f1c-5402-9ceb-51ad602c8b12"] [:db/add "5c64d8ca-2f1c-5402-9ceb-51ad602c8b12" :answer/type :answer.type/image] [:db/add "5c64d8ca-2f1c-5402-9ceb-51ad602c8b12" :answer/value "images/d8/d8b8f6fd0bdbec282f589a93b0d0421a9d8d6c2a83a9d1d536f48c5777937d4b.png"] [:db/ensure "5c64d8ca-2f1c-5402-9ceb-51ad602c8b12" :answer/validate] [:db/add "f5018b03-9586-55e8-ada5-fa84894604cc" :answer/id #uuid "f5018b03-9586-55e8-ada5-fa84894604cc"] [:db/add "f5018b03-9586-55e8-ada5-fa84894604cc" :answer/type :answer.type/image] [:db/add "f5018b03-9586-55e8-ada5-fa84894604cc" :answer/value "images/a3/a33abcd83733d853cf665b2a836754f9cab33f5c23f803c43df0b8d431951119.png"] [:db/ensure "f5018b03-9586-55e8-ada5-fa84894604cc" :answer/validate] [:db/add "efde7810-ab65-55a2-92d3-6ce1cd07f9bc" :answer/id #uuid "efde7810-ab65-55a2-92d3-6ce1cd07f9bc"] [:db/add "efde7810-ab