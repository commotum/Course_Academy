r-field/choices "48b828a4-c19d-52c4-8b8e-dd8c61f31f7b"] [:db/add "6faa0d35-4d70-5f86-86b3-31773984b6d6" :answer-field/choices "7ad08466-8c6d-5415-920d-5d16760f9b29"] [:db/add "6faa0d35-4d70-5f86-86b3-31773984b6d6" :answer-field/choices "751f88b7-7b00-5219-b397-c3f69bf9230f"] [:db/add "6faa0d35-4d70-5f86-86b3-31773984b6d6" :answer-field/correct "7ad08466-8c6d-5415-920d-5d16760f9b29"] [:db/ensure "6faa0d35-4d70-5f86-86b3-31773984b6d6" :answer-field/validate] [:db/add "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/id #uuid "d3992dc4-5071-5e0b-9934-84983ca5e05e"] [:db/add "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\n\\begin{aligned}x&=2 - 4 t\\\\ y&=t\\\\ &-3\\le t\\le 3\\end{aligned}\n$$"] [:db/add "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/worked-solution "First calculate the $x$-values using $x=2 - 4 t$:\n\n$$\n\\begin{array}{|c|c|c|c|c|c|}\\hline \\mathbf{t} & -3 & -2 & -1 & 0 & 1 \\\\ \\hline x & 14 & 10 & 6 & 2 & -2 \\\\ \\hline y &  &  &  &  &  \\\\ \\hline\\end{array}\n$$\n\n$$\n\\begin{array}{|c|c|c|}\\hline \\mathbf{t} & 2 & 3 \\\\ \\hline x & -6 & -10 \\\\ \\hline y &  &  \\\\ \\hline\\end{array}\n$$\n\nNow calculate $y=t$ at the **same parameter values**:\n\n$$\n\\begin{array}{|c|c|c|c|c|c|}\\hline \\mathbf{t} & -3 & -2 & -1 & 0 & 1 \\\\ \\hline x & 14 & 10 & 6 & 2 & -2 \\\\ \\hline y & -3 & -2 & -1 & 0 & 1 \\\\ \\hline\\end{array}\n$$\n\n$$\n\\begin{array}{|c|c|c|}\\hline \\mathbf{t} & 2 & 3 \\\\ \\hline x & -6 & -10 \\\\ \\hline y & 2 & 3 \\\\ \\hline\\end{array}\n$$\n\nPair the coordinates at the same parameter value and follow the curve only over the stated interval.\n\n![Curve through the calculated points](images/20/20be54be011b2d69feb364bbf42ee1c2b9ad12c3152f56efc449333473d5fc5b.png)"] [:db/add "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/difficulty :question.difficulty/easy] [:db/add "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/answer-fields "6faa0d35-4d70-5f86-86b3-31773984b6d6"] [:db/ensure "d3992dc4-5071-5e0b-9934-84983ca5e05e" :question/validate] [:db/add 17592186087721 :knowledge-point/questions "d3992dc4-5071-5e0b-9934-84983ca5e05e"] [:db/add "b7a394dc-8c40-5fba-966e-ef377e223fec" :answer/id #uuid "b7a394dc-8c40-5fba-966e-ef377e223fec"] [:db/add "b7a394dc-8c40-5fba-966e-ef377e223fec" :answer/type :answer.type/image] [:db/add "b7a394dc-8c40-5fba-966e-ef377e223fec" :answer/value "images/a2/a2960b8f08dd315368766e830f3dc66664d817ba274ef87db829e37420b80353.png"] [:db/ensure "b7a394dc-8c40-5fba-966e-ef377e223fec" :answer/validate] [:db/add "8a2518bb-f427-59ba-a6b9-6bc2d96b00e3" :answer/id #uuid "8a2518bb-f427-59ba-a6b9-6bc2d96b00e3"] [:db/add "8a2518bb-f427-59ba-a6b9-6bc2d96b00e3" :answer/type :answer.type/image] [:db/add "8a2518bb-f427-59ba-a6b9-6bc2d96b00e3" :answer/value "images/c4/c4a205afe55772c0a1ed789d833544134e6783f1ab50efa7c49eba2aa081f443.png"] [:db/ensure "8a2518bb-f427-59ba-a6b9-6bc2d96b00e3" :answer/validate] [:db/add "15805110-1fce-5e2a-ba85-960858ee8ca3" :answer/id #uuid "15805110-1fce-5e2a-ba85-960858ee8ca3"] [:db/add "15805110-1fce-5e2a-ba85-960858ee8ca3" :answer/type :answer.type/image] [:db/add "15805110-1fce-5e2a-ba85-960858ee8ca3" :answer/value "images/18/1891a7cf2deda3e71c200ab53bb6a0af9b6445fd65ecf610f1e6d18731296167.png"] [:db/ensure "15805110-1fce-5e2a-ba85-960858ee8ca3" :answer/validate] [:db/add "882ee73e-264d-5163-83ba-e99ce466489b" :answer/id #uuid "882ee73e-264d-5163-83ba-e99ce466489b"] [:db/add "882ee73e-264d-5163-83ba-e99ce466489b" :answer/type :answer.type/image] [:db/add "882ee73e-264d-5163-83ba-e99ce466489b" :answer/value "images/b9/b96e1ce65ecd79a382126de80f509fa2377ec5653075337933d4b75bd41164b5.png"] [:db/ensure "882ee73e-264d-5163-83ba-e99ce466489b" :answer/validate] [:db/add "64065697-5dbb-586c-8388-25cdf3ba1c27" :answer/id #uuid "64065697-5dbb-586c-8388-25cdf3ba1c27"] [:db/add "64065697-5dbb-586c-8388-25cdf3ba1c27" :answer/type :answer.type/image] [:db/add "64065697-5dbb