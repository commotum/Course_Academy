aired points and the bends between them.\n\n![Curve through the calculated points](images/a9/a9827b1804d4b2417bc1738af6430e578f2e677bac21f761a0ec342a611c9bbe.png)"] [:db/add "7601e670-8bc6-5c76-93fa-e46e631803ea" :question/difficulty :question.difficulty/hard] [:db/add "7601e670-8bc6-5c76-93fa-e46e631803ea" :question/answer-fields "91df5fc8-743c-5be8-af6e-bc1991cfd2f5"] [:db/ensure "7601e670-8bc6-5c76-93fa-e46e631803ea" :question/validate] [:db/add 17592186087721 :knowledge-point/questions "7601e670-8bc6-5c76-93fa-e46e631803ea"] [:db/add "b4f9f9cb-2a49-5a71-a6cc-deb738db74fa" :answer/id #uuid "b4f9f9cb-2a49-5a71-a6cc-deb738db74fa"] [:db/add "b4f9f9cb-2a49-5a71-a6cc-deb738db74fa" :answer/type :answer.type/image] [:db/add "b4f9f9cb-2a49-5a71-a6cc-deb738db74fa" :answer/value "images/85/85fba8d77b732539b8dd987a3a29ff662c0584eb99da836f56bc594454757373.png"] [:db/ensure "b4f9f9cb-2a49-5a71-a6cc-deb738db74fa" :answer/validate] [:db/add "091fff01-496d-5625-b569-ee8f9ee997ba" :answer/id #uuid "091fff01-496d-5625-b569-ee8f9ee997ba"] [:db/add "091fff01-496d-5625-b569-ee8f9ee997ba" :answer/type :answer.type/image] [:db/add "091fff01-496d-5625-b569-ee8f9ee997ba" :answer/value "images/c4/c46fac67802a4bb0321d2930a3ed1041b7f3ad4a7c0f7e84b51697021a0a4b8a.png"] [:db/ensure "091fff01-496d-5625-b569-ee8f9ee997ba" :answer/validate] [:db/add "30a1513b-255f-5ba5-bb98-666c8acbb2cd" :answer/id #uuid "30a1513b-255f-5ba5-bb98-666c8acbb2cd"] [:db/add "30a1513b-255f-5ba5-bb98-666c8acbb2cd" :answer/type :answer.type/image] [:db/add "30a1513b-255f-5ba5-bb98-666c8acbb2cd" :answer/value "images/24/24b721430e801b6026c540a462e731842df553c086ed53cfbf240783f595fc64.png"] [:db/ensure "30a1513b-255f-5ba5-bb98-666c8acbb2cd" :answer/validate] [:db/add "99619dfe-f7bb-535a-80e1-8b20bf1de9d3" :answer/id #uuid "99619dfe-f7bb-535a-80e1-8b20bf1de9d3"] [:db/add "99619dfe-f7bb-535a-80e1-8b20bf1de9d3" :answer/type :answer.type/image] [:db/add "99619dfe-f7bb-535a-80e1-8b20bf1de9d3" :answer/value "images/d6/d6b20b30e