#{[{:db/id #edb/ref 17592186049072 :topic/id #uuid "d7ec1df4-0aef-597f-8620-cdbc4bbf4af9" :topic/knowledge-points [{:db/id #edb/ref 17592186087815 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087423 :question/id #uuid "445894dd-2509-547b-8b42-2f44e3739d2c" :question/math-academy-id "e-1100" :question/problem "What is the domain of the function shown below?\n\n![](images/16/16ee469ac79597e3afc65844e27a156fd45d8cbd3234f2fdc74e0ab9b4554237.png)" :question/worked-solution "The function above is defined for values between $x=-2$ and $x=2.$\n\n- Since there is a closed circle at $x=-2,$ this point is included in the domain.\n\n- Since there is a closed circle at $x=2,$ this point is also included in the domain.\n\nTherefore, the domain of this function is\n\n$$\n-2 \\leq x \\leq 2.\n$$\n\nUsing interval notation, we can write this as\n\n$$\nx \\in [-2,2].\n$$"} :knowledge-point/id #uuid "3dea9cc3-e655-5f03-80a7-beb0e3f252de" :knowledge-point/title "Determining the Finite Domain of a Function From Its Graph"} {:db/id #edb/ref 17592186087816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087424 :question/id #uuid "3482c05a-8088-510a-9eed-52a9299e87e9" :question/math-academy-id "e-1102" :question/problem "What is the domain of the function $f(x)$ defined by the following table? \n\n\n\n<div class=\"source-table-scroll\"><table class=\"source-table\" data-rules=\"all\" data-table-align=\"center\" data-frame=\"true\">\n<tbody><tr data-next-row=\"true\">\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$x$</td>\n<td>$\\,-2\\,$</td>\n<td>$\\,-1\\,$</td>\n<td>$\\,0\\,$</td>\n<td>$\\,2\\,$</td>\n<td>$\\,4\\,$</td>\n<td>$\\,6\\,$</td>\n</tr>\n<tr>\n<td data-cell-align=\"center\" data-fill=\"#D6EAF8\">$f(x)$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-2$</td>\n<td data-cell-align=\"center\">$-1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$1$</td>\n<td data-cell-align=\"center\">$2$</td>\n</tr>\n</tbody></table></div>\n\n" :question/worked-solution "The domain is the set of all input values for which the function is defined. In the table, this corresponds to the set of $x$-values in the first row:\n\n \n\n$$\n\\{ -2,-1,0,2,4,6\\}\n$$"} :knowledge-point/id #uuid "4fdb7891-f2c4-5464-afe5-50badf628096" :knowledge-point/title "Determining the Domain of a Function From a Mapping Diagram or Table"} {:db/id #edb/ref 17592186087817 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087652 :question/id #uuid "7eee5cfd-73ea-5430-81ff-b725b748b177" :question/math-academy-id "e-9641" :question/problem "![](images/42/424ba7888faf0cd8503f562664da2d87595680e79b91acbefa5f1e3e79b81776.png)\n\nWhat is the domain of the function shown above?" :question/worked-solution "The function above is defined for all values of $x$ that are less than $x = 3.$\n\nIn addition, since there is a closed circle at $x = 3,$ this point is included in the domain.\n\nTherefore, the domain of this function is $x \\leq 3,$ which we can write as $x \\in (-\\infty, 3].$"} :knowledge-point/id #uuid "edc2109a-1ed3-5211-8b78-5592f7d77493" :knowledge-point/title "Determining the Infinite Domain of a Function From Its Graph"}] :topic/math-academy-id 802 :topic/next [{:db/id #edb/ref 17592186048164} {:db/id #edb/ref 17592186049534} {:db/id #edb/ref 17592186049573} {:db/id #edb/ref 17592186050373} {:db/id #edb/ref 17592186050530} {:db/id #edb/ref 17592186050652}] :topic/title "The Domain of a Function"}]}
