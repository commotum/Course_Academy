#{[{:db/id #edb/ref 17592186602424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098ef7d9-5769-58ae-a335-036b70249ce5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & -2 & -6\\end{bmatrix}" :db/id #edb/ref 17592186602059} {:answer/id #uuid "1c9b3d92-3824-5e10-a4f4-49aa1e897ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186602081} {:answer/id #uuid "2b34a625-bed6-57f1-a30a-3b1b1ed1a1ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -9\\end{bmatrix}" :db/id #edb/ref 17592186602097} {:answer/id #uuid "2e218715-4362-559c-bf01-ebc771eab4ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186602101} {:answer/id #uuid "e0b20ff9-8b7c-5596-8865-3506ac664436" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 2 & -8\\end{bmatrix}" :db/id #edb/ref 17592186602274}] :answer-field/correct {:answer/id #uuid "1c9b3d92-3824-5e10-a4f4-49aa1e897ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186602081} :answer-field/id #uuid "36212398-c0ed-51a3-a332-208b9342eead" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186602325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "75b40f52-40d8-537f-b6a5-8648a574261a" :question/math-academy-id "q-129497" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}2 & 3\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle B=\\begin{bmatrix}3 & -2 & 1 \\\\ 1 & 2 & -3\\end{bmatrix}\n$$\nthen $AB=$" :question/worked-solution "Here, $A$ is a $1\\times 2$ matrix and $B$ is a $2\\times 3$ matrix. \n\nThere are $2$ columns in $A$ and $2$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{1\\times \\boxed{\\text{2}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{2}}\\times 3}={AB}_{1\\times 3}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & 3\\end{bmatrix}\\begin{bmatrix}3 & -2 & 1 \\\\ 1 & 2 & -3\\end{bmatrix}=\\begin{bmatrix}9 & ∗ & ∗\\end{bmatrix}, &  & \\,9=2\\cdot 3+3\\cdot 1 \\\\  & \\begin{bmatrix}2 & 3\\end{bmatrix}\\begin{bmatrix}3 & -2 & 1 \\\\ 1 & 2 & -3\\end{bmatrix}=\\begin{bmatrix}9 & 2 & ∗\\end{bmatrix}, &  & \\,2=2\\cdot (-2)+3\\cdot 2 \\\\  & \\begin{bmatrix}2 & 3\\end{bmatrix}\\begin{bmatrix}3 & -2 & 1 \\\\ 1 & 2 & -3\\end{bmatrix}=\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}, &  & \\,-7=2\\cdot 1+3\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle AB=\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186642471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f4c03f8-675d-5c46-9956-a4354ef7bd07" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -5 \\\\ -4 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642475} {:answer/id #uuid "9683bd22-3ed4-5749-8bf4-9bd3fea8fcf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -3 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642480} {:answer/id #uuid "b9194a14-8a73-5358-9c23-396a77580c0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & -4 \\\\ -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186642485} {:answer/id #uuid "bdeccf2c-3aa9-5dbe-98c8-46794507e347" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & -4 \\\\ -3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186642488} {:answer/id #uuid "f722f631-e17c-572b-a43d-cdc965613256" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -4 \\\\ -3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642496}] :answer-field/correct {:answer/id #uuid "f722f631-e17c-572b-a43d-cdc965613256" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -4 \\\\ -3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642496} :answer-field/id #uuid "37bfe405-d85d-5786-a704-c56dba09f12f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642467}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "682f503a-7bda-54cb-a214-85f0337b0942" :question/problem "If\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-1 & -2 & 1 & 1 \\\\ -2 & 3 & 0 & -1\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}3 & 3 \\\\ 0 & 1 \\\\ -4 & 2 \\\\ -3 & -1\\end{bmatrix}$</div>\n</div>\n\nthen $EF=$" :question/worked-solution "Here, $E$ is a $2\\times 4$ matrix and $F$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $E$ and $4$ rows in $F,$ so $E$ and $F$ are conformable for multiplication:\n\n$$\n{E}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{F}_{\\boxed{\\text{4}}\\times 2}={EF}_{2\\times 2}\n$$\n\nLet's compute $EF,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-1 & -2 & 1 & 1 \\\\ -2 & 3 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 & 3 \\\\ 0 & 1 \\\\ -4 & 2 \\\\ -3 & -1\\end{bmatrix}=\\begin{bmatrix}-10 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, \\\\ & \\,-10=(-1)\\cdot 3+(-2)\\cdot 0+1\\cdot (-4)+1\\cdot (-3) \\\\  & \\begin{bmatrix}-1 & -2 & 1 & 1 \\\\ -2 & 3 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 & 3 \\\\ 0 & 1 \\\\ -4 & 2 \\\\ -3 & -1\\end{bmatrix}=\\begin{bmatrix}-10 & -4 \\\\ ∗ & ∗\\end{bmatrix}, \\\\ & \\,-4=(-1)\\cdot 3+(-2)\\cdot 1+1\\cdot 2+1\\cdot (-1) \\\\  & \\begin{bmatrix}-1 & -2 & 1 & 1 \\\\ -2 & 3 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 & 3 \\\\ 0 & 1 \\\\ -4 & 2 \\\\ -3 & -1\\end{bmatrix}=\\begin{bmatrix}-10 & -4 \\\\ -3 & ∗\\end{bmatrix}, \\\\ & \\,-3=(-2)\\cdot 3+3\\cdot 0+0\\cdot (-4)+(-1)\\cdot (-3) \\\\  & \\begin{bmatrix}-1 & -2 & 1 & 1 \\\\ -2 & 3 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 & 3 \\\\ 0 & 1 \\\\ -4 & 2 \\\\ -3 & -1\\end{bmatrix}=\\begin{bmatrix}-10 & -4 \\\\ -3 & -2\\end{bmatrix}, \\\\ & \\,-2=(-2)\\cdot 3+3\\cdot 1+0\\cdot 2+(-1)\\cdot (-1)\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle EF=\\begin{bmatrix}-10 & -4 \\\\ -3 & -2\\end{bmatrix}.\n$$"}]}
