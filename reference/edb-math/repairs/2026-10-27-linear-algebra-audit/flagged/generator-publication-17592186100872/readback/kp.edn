{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $E$ (blue) and column $2$ of $F$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{-1}} & {\\color{#4169E1}{-2}} & {\\color{#4169E1}{1}} & {\\color{#4169E1}{1}} \\\\ {\\color{gray}{-2}} & {\\color{gray}{3}} & {\\color{gray}{0}} & {\\color{gray}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{3}} & {\\color{red}{3}} \\\\ {\\color{gray}{0}} & {\\color{red}{1}} \\\\ {\\color{gray}{-4}} & {\\color{red}{2}} \\\\ {\\color{gray}{-3}} & {\\color{red}{-1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-10 & \\boxed{-4} \\\\ \\ast & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&=({\\color{#4169E1}{-1}})\\cdot {\\color{red}{3}}+({\\color{#4169E1}{-2}})\\cdot {\\color{red}{1}} \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot {\\color{red}{2}}+{\\color{#4169E1}{1}}\\cdot ({\\color{red}{-1}}) \\\\ &=-4\\end{aligned}\n$$\n\nFor entry $c_{21}$, use row $2$ of $E$ (blue) and column $1$ of $F$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{-1}} & {\\color{gray}{-2}} & {\\color{gray}{1}} & {\\color{gray}{1}} \\\\ {\\color{#4169E1}{-2}} & {\\color{#4169E1}{3}} & {\\color{#4169E1}{0}} & {\\color{#4169E1}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{3}} & {\\color{gray}{3}} \\\\ {\\color{red}{0}} & {\\color{gray}{1}} \\\\ {\\color{red}{-4}} & {\\color{gray}{2}} \\\\ {\\color{red}{-3}} & {\\color{gray}{-1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-10 & -4 \\\\ \\boxed{-3} & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21}&=({\\color{#4169E1}{-2}})\\cdot {\\color{red}{3}}+{\\color{#4169E1}{3}}\\cdot {\\color{red}{0}} \\\\ &\\quad +{\\color{#4169E1}{0}}\\cdot ({\\color{red}{-4}})+({\\color{#4169E1}{-1}})\\cdot ({\\color{red}{-3}}) \\\\ &=-3\\end{aligned}\n$$\n\nFor entry $c_{22}$, use row $2$ of $E$ (blue) and column $2$ of $F$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{-1}} & {\\color{gray}{-2}} & {\\color{gray}{1}} & {\\color{gray}{1}} \\\\ {\\color{#4169E1}{-2}} & 