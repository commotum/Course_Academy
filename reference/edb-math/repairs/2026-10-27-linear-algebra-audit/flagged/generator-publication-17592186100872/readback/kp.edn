{gray}{-2}} \\\\ {\\color{red}{0}} & {\\color{gray}{3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{2} & \\ast \\\\ \\ast & 9 \\\\ \\ast & 14 \\\\ 5 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{2}}\\cdot {\\color{red}{1}}+{\\color{#4169E1}{1}}\\cdot {\\color{red}{0}} \\\\ &=2\\end{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{2}} & {\\color{#4169E1}{1}} \\\\ {\\color{gray}{0}} & {\\color{gray}{3}} \\\\ {\\color{gray}{-1}} & {\\color{gray}{4}} \\\\ {\\color{gray}{5}} & {\\color{gray}{2}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{1}} & {\\color{red}{-2}} \\\\ {\\color{gray}{0}} & {\\color{red}{3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}2 & \\boxed{-1} \\\\ \\ast & 9 \\\\ \\ast & 14 \\\\ 5 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&={\\color{#4169E1}{2}}\\cdot ({\\color{red}{-2}})+{\\color{#4169E1}{1}}\\cdot {\\color{red}{3}} \\\\ &=-1\\end{aligned}\n$$\n\nFor entry $c_{21}$, use row $2$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{2}} & {\\color{gray}{1}} \\\\ {\\color{#4169E1}{0}} & {\\color{#4169E1}{3}} \\\\ {\\color{gray}{-1}} & {\\color{gray}{4}} \\\\ {\\color{gray}{5}} & {\\color{gray}{2}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{1}} & {\\color{gray}{-2}} \\\\ {\\color{red}{0}} & {\\color{gray}{3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}2 & -1 \\\\ \\boxed{0} & 9 \\\\ \\ast & 14 \\\\ 5 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21}&={\\color{#4169E1}{0}}\\cdot {\\color{red}{1}}+{\\color{#4169E1}{3}}\\cdot {\\color{red}{0}} \\\\ &=0\\end{aligned}\n$$\n\nFor entry $c_{31}$, use row $3$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{2}} & {\\color{gray}{1}} \\\\ {\\color{gray}{0}} & {\\color{gray}{3}} \\\\ {\\color{#4169E1}{-1}} & {\\color{#4169E1}{4}} \\\\ {\\color{gray}{5}} & {\\color{gray}{2}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{1}} & {\\color{gray}{-2}} \\\\ {\\color{red}{0}} & {\\color{gray}{3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ \\boxed{-1} & 14 \\\\ 5 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{31}&=({\\color{#4169E1}{-1}})\\cdot {\\color{red}{1}}+{\\color{#4169E1}{4}}\\cdot {\\color{red}{0}} \\\\ &=-1\\end{aligned}\n$$\n\nFor entry $c_{42}$, use row $4$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{2}} & {\\color{gray}{1}} \\\\ {\\color{gray}{0}} & {\\color{gray}{3}} \\\\ {\\color{gray}{-1}} & {\\color{gray}{4}} \\\\ {\\color{#4169E1}{5}} & {\\color{#4169E1}{2}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{1}} & {\\color{red}{-2}} \\\\ {\\color{gray}{0}} & {\\color{red}{3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & \\boxed{-4}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{42}&={\\color{#4169E1}{5}}\\cdot ({\\color{red}{-2}})+{\\color{#4169E1}{2}}\\cdot {\\color{red}{3}} \\\\ &=-4\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582}] :answer-field/correct {:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582} :answer-field/id #uuid "7f84dc72-92a1-5353-b591-bdf85d6a4d27" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299069} {:answer-field/choices [{:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036}] :answer-field/correct {:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036} :answer-field/id #uuid "c6007ff8-9e9f-5fb3-89f5-bb5c4da4bf33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299300}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d6b8e49d-bc16-5e49-870a-d27907495843" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$3$</td></tr>\n<tr><td>$9$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. The matching inner dimensions show that the product is defined, and $AB$ is $2\\times 2$:\n\n$$\n\\underset{2\\times\\boxed{{\\color{#2E8B57}{3}}}}{A}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{3}}}\\times2}{B}=\\underset{2\\times2}{AB}\n$$\n\nFor entry $c_{11}$, use row $1$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{1}} & {\\color{#4169E1}{2}} & {\\color{#4169E1}{-1}} \\\\ {\\color{gray}{0}} & {\\color{gray}{3}} & {\\color{gray}{4}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{2}} & {\\color{gray}{1}} \\\\ {\\color{red}{-1}} & {\\color{gray}{0}} \\\\ {\\color{red}{3}} & {\\color{gray}{-2}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{-3} & 3 \\\\ 9 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{1}}\\cdot {\\color{red}{2}}+{\\color{#4169E1}{2}}\\cdot ({\\color{red}{-1}}) \\\\ &\\quad +({\\color{#4169E1}{-1}})\\cdot {\\color{red}{3}} \\\\ &=-3\\end{aligned}\n$$\n\nFor entry $c_{22}$, use row $2$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{1}} & {\\color{gray}{2}} & {\\color{gray}{-1}} \\\\ {\\color{#4169E1}{0}} & {\\color{#4169E1}{3}} & {\\color{#4169E1}{4}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{2}} & {\\color{red}{1}} \\\\ {\\color{gray}{-1}} & {\\color{red}{0}} \\\\ {\\color{gray}{3}} & {\\color{red}{-2}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-3 & 3 \\\\ 9 & \\boxed{-8}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{22}&={\\color{#4169E1}{0}}\\cdot {\\color{red}{1}}+{\\color{#4169E1}{3}}\\cdot {\\color{red}{0}} \\\\ &\\quad +{\\color{#4169E1}{4}}\\cdot ({\\color{red}{-2}}) \\\\ &=-8\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723}] :answer-field/correct {:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723} :answer-field/id #uuid "33eaef6a-e5d9-5210-b63a-9e30983de20d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298815} {:answer-field/choices [{:answer/id #uuid "75360412-a790-5f78-ba8d-9d3583d9e3ec" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060}] :answer-field/correct {:answer/id #uuid "75360412-a790-5f78-ba8d-9d3583d9e3ec" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060} :answer-field/id #uuid "4497312c-b639-5838-b4a9-f27d6e46fda8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298871}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4dabe113-4cf7-5192-92c8-d6891215d7d9" :question/math-academy-id "q-317847" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$4$</td></tr>\n<tr><td>$0$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. The matching inner dimensions show that the product is defined, and $AB$ is $2\\times 2$:\n\n$$\n\\underset{2\\times\\boxed{{\\color{#2E8B57}{3}}}}{A}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{3}}}\\times2}{B}=\\underset{2\\times2}{AB}\n$$\n\nFor entry $c_{11}$, use row $1$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{2}} & {\\color{#4169E1}{-1}} & {\\color{#4169E1}{0}} \\\\ {\\color{gray}{4}} & {\\color{gray}{3}} & {\\color{gray}{1}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{1}} & {\\color{gray}{2}} \\\\ {\\color{red}{-3}} & {\\color{gray}{0}} \\\\ {\\color{red}{5}} & {\\color{gray}{-1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{5} & 4 \\\\ 0 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{2}}\\cdot {\\color{red}{1}}+({\\color{#4169E1}{-1}})\\cdot ({\\color{red}{-3}}) \\\\ &\\quad +{\\color{#4169E1}{0}}\\cdot {\\color{red}{5}} \\\\ &=5\\end{aligned}\n$$\n\nFor entry $c_{22}$, use row $2$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{2}} & {\\color{gray}{-1}} & {\\color{gray}{0}} \\\\ {\\color{#4169E1}{4}} & {\\color{#4169E1}{3}} & {\\color{#4169E1}{1}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{1}} & {\\color{red}{2}} \\\\ {\\color{gray}{-3}} & {\\color{red}{0}} \\\\ {\\color{gray}{5}} & {\\color{red}{-1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}5 & 4 \\\\ 0 & \\boxed{7}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{22}&={\\color{#4169E1}{4}}\\cdot {\\color{red}{2}}+{\\color{#4169E1}{3}}\\cdot {\\color{red}{0}} \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot ({\\color{red}{-1}}) \\\\ &=7\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813}] :answer-field/correct {:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813} :answer-field/id #uuid "4541560b-538b-5f05-b59c-8a9bf0f5a2d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298874} {:answer-field/choices [{:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844}] :answer-field/correct {:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844} :answer-field/id #uuid "50d12860-4dc8-5d98-b731-8fe82a2cacc7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298910}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "630b6f29-5fc9-5ea7-9ec7-b34bacfad40e" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$-6$</td></tr>\n<tr><td>$11$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. The matching inner dimensions show that the product is defined, and $AB$ is $2\\times 2$:\n\n$$\n\\underset{2\\times\\boxed{{\\color{#2E8B57}{4}}}}{A}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{4}}}\\times2}{B}=\\underset{2\\times2}{AB}\n$$\n\nFor entry $c_{11}$, use row $1$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{1}} & {\\color{#4169E1}{0}} & {\\color{#4169E1}{-2}} & {\\color{#4169E1}{3}} \\\\ {\\color{gray}{4}} & {\\color{gray}{1}} & {\\color{gray}{0}} & {\\color{gray}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{2}} & {\\color{gray}{-1}} \\\\ {\\color{red}{1}} & {\\color{gray}{3}} \\\\ {\\color{red}{0}} & {\\color{gray}{4}} \\\\ {\\color{red}{-2}} & {\\color{gray}{1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{-4} & -6 \\\\ 11 & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{1}}\\cdot {\\color{red}{2}}+{\\color{#4169E1}{0}}\\cdot {\\color{red}{1}} \\\\ &\\quad +({\\color{#4169E1}{-2}})\\cdot {\\color{red}{0}}+{\\color{#4169E1}{3}}\\cdot ({\\color{red}{-2}}) \\\\ &=-4\\end{aligned}\n$$\n\nFor entry $c_{22}$, use row $2$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{1}} & {\\color{gray}{0}} & {\\color{gray}{-2}} & {\\color{gray}{3}} \\\\ {\\color{#4169E1}{4}} & {\\color{#4169E1}{1}} & {\\color{#4169E1}{0}} & {\\color{#4169E1}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{2}} & {\\color{red}{-1}} \\\\ {\\color{gray}{1}} & {\\color{red}{3}} \\\\ {\\color{gray}{0}} & {\\color{red}{4}} \\\\ {\\color{gray}{-2}} & {\\color{red}{1}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-4 & -6 \\\\ 11 & \\boxed{-2}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{22}&={\\color{#4169E1}{4}}\\cdot ({\\color{red}{-1}})+{\\color{#4169E1}{1}}\\cdot {\\color{red}{3}} \\\\ &\\quad +{\\color{#4169E1}{0}}\\cdot {\\color{red}{4}}+({\\color{#4169E1}{-1}})\\cdot {\\color{red}{1}} \\\\ &=-2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186338850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636472-3eda-542f-b7c3-23ae232bc2c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 14\\end{bmatrix}" :db/id #edb/ref 17592186336582} {:answer/id #uuid "b4de6dcb-4fe1-5185-b370-367b3c5e23aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & -1\\end{bmatrix}" :db/id #edb/ref 17592186337637} {:answer/id #uuid "de21dbdb-0d9a-5740-aec5-151cfe330af1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186337964} {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} {:answer/id #uuid "f3f6c67a-5a58-56b5-8c25-9be2881adeb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 14\\end{bmatrix}" :db/id #edb/ref 17592186338163}] :answer-field/correct {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} :answer-field/id #uuid "89241c64-36b6-57dc-ba88-dc9eb9dc5ea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338528}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cfec97ba-ccad-5e4f-97b5-a14f90d0cefb" :question/math-academy-id "q-70928" :question/problem "Find $BC$,  if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$B=\\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}.$</div>\n</div>" :question/worked-solution "Here, $B$ is a $1\\times 3$ matrix and $C$ is a $3\\times 2$ matrix. The matching inner dimensions show that the product is defined, and $BC$ is $1\\times 2$:\n\n$$\n\\underset{1\\times\\boxed{{\\color{#2E8B57}{3}}}}{B}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{3}}}\\times2}{C}=\\underset{1\\times2}{BC}\n$$\n\nFor entry $c_{11}$, use row $1$ of $B$ (blue) and column $1$ of $C$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{-3}} & {\\color{#4169E1}{1}} & {\\color{#4169E1}{-2}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{1}} & {\\color{gray}{2}} \\\\ {\\color{red}{3}} & {\\color{gray}{4}} \\\\ {\\color{red}{5}} & {\\color{gray}{6}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{-10} & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&=({\\color{#4169E1}{-3}})\\cdot {\\color{red}{1}}+{\\color{#4169E1}{1}}\\cdot {\\color{red}{3}} \\\\ &\\quad +({\\color{#4169E1}{-2}})\\cdot {\\color{red}{5}} \\\\ &=-10\\end{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $B$ (blue) and column $2$ of $C$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{-3}} & {\\color{#4169E1}{1}} & {\\color{#4169E1}{-2}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{1}} & {\\color{red}{2}} \\\\ {\\color{gray}{3}} & {\\color{red}{4}} \\\\ {\\color{gray}{5}} & {\\color{red}{6}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-10 & \\boxed{-14}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&=({\\color{#4169E1}{-3}})\\cdot {\\color{red}{2}}+{\\color{#4169E1}{1}}\\cdot {\\color{red}{4}} \\\\ &\\quad +({\\color{#4169E1}{-2}})\\cdot {\\color{red}{6}} \\\\ &=-14\\end{aligned}\n$$\n\nTherefore,\n\n$$\nBC=\\begin{bmatrix}-10 & -14\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186602424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098ef7d9-5769-58ae-a335-036b70249ce5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & -2 & -6\\end{bmatrix}" :db/id #edb/ref 17592186602059} {:answer/id #uuid "1c9b3d92-3824-5e10-a4f4-49aa1e897ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186602081} {:answer/id #uuid "2b34a625-bed6-57f1-a30a-3b1b1ed1a1ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 & -9\\end{bmatrix}" :db/id #edb/ref 17592186602097} {:answer/id #uuid "2e218715-4362-559c-bf01-ebc771eab4ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186602101} {:answer/id #uuid "e0b20ff9-8b7c-5596-8865-3506ac664436" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 2 & -8\\end{bmatrix}" :db/id #edb/ref 17592186602274}] :answer-field/correct {:answer/id #uuid "1c9b3d92-3824-5e10-a4f4-49aa1e897ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}" :db/id #edb/ref 17592186602081} :answer-field/id #uuid "36212398-c0ed-51a3-a332-208b9342eead" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186602325}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "75b40f52-40d8-537f-b6a5-8648a574261a" :question/math-academy-id "q-129497" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}2 & 3\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle B=\\begin{bmatrix}3 & -2 & 1 \\\\ 1 & 2 & -3\\end{bmatrix}\n$$\nthen $AB=$" :question/worked-solution "Here, $A$ is a $1\\times 2$ matrix and $B$ is a $2\\times 3$ matrix. The matching inner dimensions show that the product is defined, and $AB$ is $1\\times 3$:\n\n$$\n\\underset{1\\times\\boxed{{\\color{#2E8B57}{2}}}}{A}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{2}}}\\times3}{B}=\\underset{1\\times3}{AB}\n$$\n\nFor entry $c_{11}$, use row $1$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{2}} & {\\color{#4169E1}{3}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{3}} & {\\color{gray}{-2}} & {\\color{gray}{1}} \\\\ {\\color{red}{1}} & {\\color{gray}{2}} & {\\color{gray}{-3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{9} & \\ast & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{2}}\\cdot {\\color{red}{3}}+{\\color{#4169E1}{3}}\\cdot {\\color{red}{1}} \\\\ &=9\\end{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{2}} & {\\color{#4169E1}{3}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{3}} & {\\color{red}{-2}} & {\\color{gray}{1}} \\\\ {\\color{gray}{1}} & {\\color{red}{2}} & {\\color{gray}{-3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}9 & \\boxed{2} & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&={\\color{#4169E1}{2}}\\cdot ({\\color{red}{-2}})+{\\color{#4169E1}{3}}\\cdot {\\color{red}{2}} \\\\ &=2\\end{aligned}\n$$\n\nFor entry $c_{13}$, use row $1$ of $A$ (blue) and column $3$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{2}} & {\\color{#4169E1}{3}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{3}} & {\\color{gray}{-2}} & {\\color{red}{1}} \\\\ {\\color{gray}{1}} & {\\color{gray}{2}} & {\\color{red}{-3}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}9 & 2 & \\boxed{-7}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{13}&={\\color{#4169E1}{2}}\\cdot {\\color{red}{1}}+{\\color{#4169E1}{3}}\\cdot ({\\color{red}{-3}}) \\\\ &=-7\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}9 & 2 & -7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186602444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9703f8e-5cf3-58d8-b084-47a0b792e47b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186602251}] :answer-field/correct {:answer/id #uuid "c9703f8e-5cf3-58d8-b084-47a0b792e47b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186602251} :answer-field/id #uuid "71c42643-0393-5573-888c-09b8ce398c19" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602343} {:answer-field/choices [{:answer/id #uuid "20b56970-6bb5-5108-bb2c-77dc54c74421" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186602085}] :answer-field/correct {:answer/id #uuid "20b56970-6bb5-5108-bb2c-77dc54c74421" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186602085} :answer-field/id #uuid "df3ff047-72be-5ef1-9b5a-2edc81025a9a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602385}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1702e86-c34d-50db-922d-80c8b5e93cb8" :question/math-academy-id "q-318413" :question/problem "Determine $AB$ given that \n$$\n\\displaystyle A=\\begin{bmatrix}-2 & 0 & 1\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle B=\\begin{bmatrix}3 & -1 \\\\ 5 & 2 \\\\ -4 & 0\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $1\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. The matching inner dimensions show that the product is defined, and $AB$ is $1\\times 2$:\n\n$$\n\\underset{1\\times\\boxed{{\\color{#2E8B57}{3}}}}{A}\\underset{{\\color{#2E8B57}{\\checkmark}}}{\\cdot}\\underset{\\boxed{{\\color{#2E8B57}{3}}}\\times2}{B}=\\underset{1\\times2}{AB}\n$$\n\nFor entry $c_{11}$, use row $1$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{-2}} & {\\color{#4169E1}{0}} & {\\color{#4169E1}{1}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{3}} & {\\color{gray}{-1}} \\\\ {\\color{red}{5}} & {\\color{gray}{2}} \\\\ {\\color{red}{-4}} & {\\color{gray}{0}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{-10} & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&=({\\color{#4169E1}{-2}})\\cdot {\\color{red}{3}}+{\\color{#4169E1}{0}}\\cdot {\\color{red}{5}} \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot ({\\color{red}{-4}}) \\\\ &=-10\\end{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{-2}} & {\\color{#4169E1}{0}} & {\\color{#4169E1}{1}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{3}} & {\\color{red}{-1}} \\\\ {\\color{gray}{5}} & {\\color{red}{2}} \\\\ {\\color{gray}{-4}} & {\\color{red}{0}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-10 & \\boxed{2}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&=({\\color{#4169E1}{-2}})\\cdot ({\\color{red}{-1}})+{\\color{#4169E1}{0}}\\cdot {\\color{red}{2}} \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot {\\color{red}{0}} \\\\ &=2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-10 & 2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186642470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cd2126-e761-5314-bbea-aa545e9ae770" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 11 \\\\ -8 & -12\\end{bmatrix}" :db/id #edb/ref 17592186642462} {:answer/id #uuid "b446047d-7f98-5b49-a508-ba34a38f61c9" :answer/type {:db/ident :answer.type/math} :answe