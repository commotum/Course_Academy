E1}{-2}} & {\\color{#4169E1}{1}} \\\\ {\\color{gray}{-2}} & {\\color{gray}{4}} & {\\color{gray}{0}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{2}} & {\\color{gray}{3}} \\\\ {\\color{red}{-1}} & {\\color{gray}{-2}} \\\\ {\\color{red}{-5}} & {\\color{gray}{4}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}\\boxed{-1} & \\ast \\\\ \\ast & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{11}&={\\color{#4169E1}{1}}\\cdot {\\color{red}{2}}+({\\color{#4169E1}{-2}})\\cdot ({\\color{red}{-1}}) \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot ({\\color{red}{-5}}) \\\\ &=-1\\end{aligned}\n$$\n\nFor entry $c_{12}$, use row $1$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{#4169E1}{1}} & {\\color{#4169E1}{-2}} & {\\color{#4169E1}{1}} \\\\ {\\color{gray}{-2}} & {\\color{gray}{4}} & {\\color{gray}{0}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{2}} & {\\color{red}{3}} \\\\ {\\color{gray}{-1}} & {\\color{red}{-2}} \\\\ {\\color{gray}{-5}} & {\\color{red}{4}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-1 & \\boxed{11} \\\\ \\ast & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{12}&={\\color{#4169E1}{1}}\\cdot {\\color{red}{3}}+({\\color{#4169E1}{-2}})\\cdot ({\\color{red}{-2}}) \\\\ &\\quad +{\\color{#4169E1}{1}}\\cdot {\\color{red}{4}} \\\\ &=11\\end{aligned}\n$$\n\nFor entry $c_{21}$, use row $2$ of $A$ (blue) and column $1$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{1}} & {\\color{gray}{-2}} & {\\color{gray}{1}} \\\\ {\\color{#4169E1}{-2}} & {\\color{#4169E1}{4}} & {\\color{#4169E1}{0}}\\end{bmatrix}\\begin{bmatrix}{\\color{red}{2}} & {\\color{gray}{3}} \\\\ {\\color{red}{-1}} & {\\color{gray}{-2}} \\\\ {\\color{red}{-5}} & {\\color{gray}{4}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-1 & 11 \\\\ \\boxed{-8} & \\ast\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{21}&=({\\color{#4169E1}{-2}})\\cdot {\\color{red}{2}}+{\\color{#4169E1}{4}}\\cdot ({\\color{red}{-1}}) \\\\ &\\quad +{\\color{#4169E1}{0}}\\cdot ({\\color{red}{-5}}) \\\\ &=-8\\end{aligned}\n$$\n\nFor entry $c_{22}$, use row $2$ of $A$ (blue) and column $2$ of $B$ (red):\n\n$$\n\\begin{aligned}&\\begin{bmatrix}{\\color{gray}{1}} & {\\color{gray}{-2}} & {\\color{gray}{1}} \\\\ {\\color{#4169E1}{-2}} & {\\color{#4169E1}{4}} & {\\color{#4169E1}{0}}\\end{bmatrix}\\begin{bmatrix}{\\color{gray}{2}} & {\\color{red}{3}} \\\\ {\\color{gray}{-1}} & {\\color{red}{-2}} \\\\ {\\color{gray}{-5}} & {\\color{red}{4}}\\end{bmatrix}\\\\ &=\\begin{bmatrix}-1 & 11 \\\\ -8 & \\boxed{-14}\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}c_{22}&=({\\color{#4169E1}{-2}})\\cdot {\\color{red}{3}}+{\\color{#4169E1}{4}}\\cdot ({\\color{red}{-2}}) \\\\ &\\quad +{\\color{#4169E1}{0}}\\cdot {\\color{red}{4}} \\\\ &=-14\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-1 & 11 \\\\ -8 & -14\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186642471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f4c03f8-675d-5c46-9956-a4354ef7bd07" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -5 \\\\ -4 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642475} {:answer/id #uuid "9683bd22-3ed4-5749-8bf4-9bd3fea8fcf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -3 \\\\ -2 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642480} {:answer/id #uuid "b9194a14-8a73-5358-9c23-396a77580c0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & -4 \\\\ -3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186642485} {:answer/id #uuid "bdeccf2c-3aa9-5dbe-98c8-46794507e347" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-11 & -4 \\\\ -3 & -3\\end{bmatrix}" :db/id #edb/ref 17592186642488} {:answer/id #uuid "f722f631-e17c-572b-a43d-cdc965613256" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -4 \\\\ -3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186642496}] :answer-field/correct {:answer/id #uuid "f722f