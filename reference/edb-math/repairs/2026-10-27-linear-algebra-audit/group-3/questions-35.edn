ue "\\begin{bmatrix}48 & 54 \\\\ 3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186097962} {:answer/id #uuid "794420f1-b2c5-535e-8d7b-3bc881e4a12d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}48 & 5 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186097963} {:answer/id #uuid "7d26aa62-97bf-576f-8cad-734f8bb38e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}48 & 3 \\\\ 54 & -6\\end{bmatrix}" :db/id #edb/ref 17592186097964}] :answer-field/id #uuid "6106ff27-a10c-5110-b526-56f147f3d77b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186097959}] :question/id #uuid "1af60e7f-3da3-56ec-8846-70fae5eeab59" :question/math-academy-id "q-1034" :question/problem "Find $AB$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}5 & 1 & 3 \\\\ 0 & 1 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}6 & 5 \\\\ 9 & 8 \\\\ 3 & 7\\end{bmatrix}$</div>\n</div>"}] [{:db/id #edb/ref 17592186101140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8e48646-8b8d-5098-b1e9-d7651fd9fe05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186098176} {:answer/id #uuid "10a0fb7b-6234-5c70-9858-c5d5d5df52b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186098177} {:answer/id #uuid "2cd0dd9c-14ad-54cf-98f1-ae27c74457cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[4]" :db/id #edb/ref 17592186098178} {:answer/id #uuid "3b4c9f35-14c3-535d-891e-3ed64366d46c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{bmatrix}" :db/id #edb/ref 17592186098179} {:answer/id #uuid "623adff0-a387-5a4f-acc7-1259375dd372" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end