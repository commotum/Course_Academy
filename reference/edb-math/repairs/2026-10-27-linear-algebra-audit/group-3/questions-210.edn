\ 0 & 7 & -5\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}3 \\\\ 9 \\\\ -5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}5 & -3 & 0 \\\\ -2 & 0 & 6 \\\\ 0 & 7 & -5\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 9 \\\\ -5\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ba1424-91d7-5c62-a094-828e0e888e06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186297580}] :answer-field/correct {:db/id #edb/ref 17592186297580} :answer-field/id #uuid "3ac9bed5-2877-5551-b039-f9193e28a015" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298835} {:answer-field/choices [{:answer/id #uuid "f3e6f5c4-a7ca-537a-9ec8-53d03fd09870" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186298585}] :answer-field/correct {:db/id #edb/ref 17592186298585} :answer-field/id #uuid "82b43927-47cb-5708-962f-92a6334680cb" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299080} {:answer-field/choices [{:answer/id #uuid "d50182a5-b6fe-5d57-9f80-7cea0f222904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186298466}] :answer-field/correct {:db/id #edb/ref 17592186298466} :answer-field/id #uuid "d89514df-b19e-5584-9382-f92d17e2324c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299373} {:answer-field/choices [{:answer/id #uuid "761736bb-d1a6-5731-b2fe-7aa62385e4b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186298067}] :answer-field/correct {:db/id #edb/ref 17592186298067} :answer-field/id #uuid "eafd7059-5b8c-5651-85c0-107af3e8ef74" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299430}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a4ab7e0-5c2e-51f8-b6d7-195279e97c0b" :question/math-academy-id "q-317639" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}4z+x-3 &=7 \\\\ 2x-5y+6 &=1 \\\\ 3y+7z-4x+5 &=10\\end{aligned}\\right.\n$$\n\n \n\ncan be represented using matrix notation as\n\n|  |  | $1$ | $0$ | {{field-1}} |  |  |  | $x$ |  |  |  | $10$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $2$ | {{field-2}} | $0$ |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | {{field-4}} | $3$ | $7$ |  |  |  | $z$ |  |  |  | $5$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\left\\{\\begin{aligned}x+0y+4z &=10 \\\\ 2x-5y+0z &=-5 \\\\ -4x+3y+7z &=5\\end{aligned}\\right.\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}1 & 0 & 4 \\\\ 2 & -5 & 0 \\\\ -4 & 3 & 7\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}10 \\\\ -5 \\\\ 5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}1 & 0 & 4 \\\\ 2 & -5 & 0 \\\\ -4 & 3 & 7\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}10 \\\\ -5 \\\\ 5\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8b4b7ed-ec16-5051-9f0e-eb339152d483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186298612}] :answer-field/correct {:db/id #edb/ref 1