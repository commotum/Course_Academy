b,$ where\n\n$$\nA=\\begin{bmatrix}7 & -4 & 6 \\\\ -2 & 3 & 0 \\\\ 1 & -9 & 1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}-1 \\\\ 0 \\\\ 5\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}7 & -4 & 6 \\\\ -2 & 3 & 0 \\\\ 1 & -9 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 5\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be3b387-a266-5aef-899d-85c5377ba9fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186297938}] :answer-field/correct {:db/id #edb/ref 17592186297938} :answer-field/id #uuid "203e627b-9f75-5b76-a0ab-096b78718564" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298746} {:answer-field/choices [{:answer/id #uuid "86c12b43-c774-58d9-bd02-2ab96f8e6903" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186298135}] :answer-field/correct {:db/id #edb/ref 17592186298135} :answer-field/id #uuid "22eb6f77-fd16-5651-97c6-7d63f3adaf57" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298752} {:answer-field/choices [{:answer/id #uuid "66b5ad57-dc18-5e85-ba08-dbda00deb359" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186297991}] :answer-field/correct {:db/id #edb/ref 17592186297991} :answer-field/id #uuid "29ad4e84-d621-57b6-bdae-77fe81fbaa1b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298778} {:answer-field/choices [{:answer/id #uuid "78b85a30-9de2-50c6-a767-5b60e5b58864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186298078}] :an