{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & -\\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & -3 \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AB=BA={I}_{2}$ is false. As a result, $B\\ne {A}^{-1}$ and statement $B={A}^{-1}$ is false too.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}2 & 3 \\\\ -2 & -1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ \\frac{1}{2} & \\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{2}$ is true.\n\nTherefore, the correct answer is $AC=CA={I}_{2}$ only."}] [{:db/id #edb/ref 17592186557780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac5ff699-83f3-5502-8863-b5603f0fa78e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557755} {:answer/id #uuid "d38a16ac-5ef0-5fbd-96ac-5b7ea626f6aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557779}] :answer-field/correct {:db/id #edb/ref 17592186557755} :answer-field/id #uuid "0010b0e8-07d9-539f-b46c-d9a9cc6cbc1b" :answer-field/key "$C={A}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186557699} {:answer-field/choices [{:answer/id #uuid "93963a8b-5efe-5721-9483-a5516fd22aaf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557745} {:answer/id #uuid "bf65268d-df33-5a1f-9cae-9aa588043c0d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557766}] :ans