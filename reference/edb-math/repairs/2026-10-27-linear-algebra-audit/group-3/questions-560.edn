ac{3}{2} & 1\\end{bmatrix},\\,D=\\begin{bmatrix}-2 & -\\frac{4}{3} \\\\ -3 & -1\\end{bmatrix},\\,E=\\begin{bmatrix}1 & \\frac{2}{3} \\\\ \\frac{3}{2} & \\frac{1}{2}\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- First, we check whether $CD=DC={I}_{2}.$ Computing $CD$, we get\n\n$$\n\\begin{aligned}CD & =\\begin{bmatrix}\\frac{1}{2} & -\\frac{2}{3} \\\\ -\\frac{3}{2} & 1\\end{bmatrix}\\begin{bmatrix}-2 & -\\frac{4}{3} \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DC$, we get\n\n$$\n\\begin{aligned}DC & =\\begin{bmatrix}-2 & -\\frac{4}{3} \\\\ -3 & -1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{2} & -\\frac{2}{3} \\\\ -\\frac{3}{2} & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $CD=DC={I}_{2}$ is true. As a result, $D={C}^{-1}$ and statement $D={C}^{-1}$ is true too.\n\n- Now, we check whether $DE=ED={I}_{2}.$ Computing $DE$, we get\n\n$$\n\\begin{aligned}DE & =\\begin{bmatrix}-2 & -\\frac{4}{3} \\\\ -3 & -1\\end{bmatrix}\\begin{bmatrix}1 & \\frac{2}{3} \\\\ \\frac{3}{2} & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $DE=ED={I}_{2}$ is false.\n\nTherefore, the correct answer is $CD=DC={I}_{2}$; $D={C}^{-1}$ only."}] [{:db/id #edb/ref 17592186557776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d2458d-fd3e-5dae-847c-b5a4feb35268" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557708} {:answer/id #uuid "4b99ab47-f438-51cf-94cf-68be9d817c07" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557718}] :answer-field/correct {:db/id #edb/ref 17592186557708} :answer-field/id #uuid "7bf2a116-d332-5fa5-ad24-fee13ae