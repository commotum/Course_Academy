/correct {:db/id #edb/ref 17592186440021} :answer-field/id #uuid "abb35f96-8e34-5ec5-8483-299f03e8484c" :answer-field/key "$x=8$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440368}] :question/id #uuid "f04c86de-5ed5-52ee-bc8b-1a0c07c06519" :question/math-academy-id "q-9657" :question/problem "Given that the determinant of\n$$\n\\displaystyle \\begin{bmatrix}2 & -1 & 3 \\\\ x & 2 & 4 \\\\ -2 & 1 & x + 3\\end{bmatrix}\n$$\nis $8$, find all the possible values of $x$.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The determinant is $x^{2} + 10 x + 24$. Setting it equal to $8$ gives $\\left\\{-8, -2\\right\\}$."}] [{:db/id #edb/ref 17592186060447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186357827} {:answer/id #uuid "1497bbf0-b0e3-55c9-a773-3097042ee709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186357932} {:answer/id #uuid "94d5145f-94aa-5233-938d-f5a7dd10a709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186359056} {:answer/id #uuid "bda894ff-ae9d-5d5a-99bd-a1f4b7cf8342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186359402} {:answer/id #uuid "e8ddf45e-881c-5c0c-a2da-d518f976e537" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186359817}] :answer-field/correct {:db/id #edb/ref 17592186357827} :answer-field/id #uuid "796c6d71-8b6e-59df-88c9-9b3757e40cfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $\\begin{bmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{vmatrix} & =2\\begin{vmatrix}3 & k \\\\ 0 & 1\\end{vmatrix}-1\\begin{vmatrix}2k+1 & k \\\\ 1 & 1\\end{vmatrix}-4\\begin{vmatrix}2k+1 & 3 \\\\ 1 & 0\\end{vmatrix} \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"}] [{:db/id #edb/ref 17592186060451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5c13e1d-6bcd-56d3-a766-b556b263fc53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a = 2, b = 0, c = 1" :db/id #edb/ref 17592186059329} {:answer/id #uuid "ee582995-801a-5dee-b283-78fb41347fce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a = 6, b = 0, c = 1" :db/id #edb/ref 17592186059330} {:answer/id #uuid "fe4215d1-5294-56ca-91f0-4ab7fcf1005d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a =-1, b = 1, c =-2" :db/id #edb/ref 17592186059331} {:answer/id #uuid "579b9fda-559b-50ac-9974-6dd31ab1a37c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a = 1, b = 3, c = 0" :db/id #edb/ref 17592186059332} {:answer/id #uuid "69c48b55-0366-5095-bf96-0b91c24943b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a = 1, b = 0, c = 2" :db/id #edb/ref 17592186059333}] :answer-field/id #uuid "4c21af52-dff9-509e-a7d4-a22fd4d7499f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186059328}] :question/id #uuid "0ad9c62f-7c03-5fbc-ab09-c5cd0fac325b" :question/math-academy-id "q-9721" :question/problem "The system of equations\n$$\n\\displaystyle \\left\\{\\begin{aligned}x &=6 \\\\ y - x - 2z &=0 \\\\ 3z - 2x - 5 &=-3\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\displaystyle \\begin{bmatrix}a & 0 & 0 \\\\ -1 & 1 & -2 \\\\ -2 & b & 3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} = \\begin{bmatrix}6 \\\\ 0 \\\\ c\\end{bmatrix}.\n$$\n\nWhat are the values of $a, b$ and $c$?"}] [{:db/id #edb/ref 17592186060454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141d3bda-708e-5cd1-a9c3-33813075f0e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438670} {:answer/id #uuid "c97bfd73-22d0-514a-b96a-af8b07567307" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438671}] :answer-field/correct {:db/id #edb/ref 17592186438671} :answer-field/id #uuid "e441ef7a-f7d8-556c-897f-7d0c7a6b2bc1" :answer-field/key "$det(F)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439364} {:answer-field/choices [{:answer/id #uuid "aa853019-8cb7-57bb-8d89-07bb087c8654" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438672} {:answer/id #uuid "5e56b566-9992-53f1-aacf-331d0f084061" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438673}] :answer-field/correct {:db/id #edb/ref 17592186438673} :answer-field/id #uuid "e6cc4081-efb3-5cbd-91d9-77bb4d9690f4" :answer-field/key "$F$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439365} {:answer-field/choices [{:answer/id #uuid "1db0c840-997f-55b7-bab1-3572f80549a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438674} {:answer/id #uuid "9da77c68-30c2-574d-8a12-c8183bf926de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438675}] :answer-field/correct {:db/id #edb/ref 17592186438674} :answer-field/id #uuid "3e1cd461-5747-5d77-9466-83683a668421" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439366}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =\\begin{vmatrix}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{vmatrix} \\\\  & =0\\begin{vmatrix}4 & 5 \\\\ 7 & 8\\end{vmatrix}-1\\begin{vmatrix}3 & 5 \\\\ 6 & 8\\end{vmatrix}+2\\begin{vmatrix}3 & 4 \\\\ 6 & 7\\end{vmatrix} \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements $det(F)=0$ and “$F$ is a singular matrix” are true."}] [{:db/id #edb/ref 17592186060455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb7f9378-1e2c-5fad-a64e-dba8350af45e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186059353} {:answer/id #uuid "d0ce2cd2-c328-50a2-a7d8-262686f4f13c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-13" :db/id #edb/ref 17592186059354} {:answer/id #uuid "f1b413f1-d53c-5d8d-939a-db24e1f1fc46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "47" :db/id #edb/ref 17592186059355} {:answer/id #uuid "f83be477-467e-53c3-8f41-fa96ec94d220" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186