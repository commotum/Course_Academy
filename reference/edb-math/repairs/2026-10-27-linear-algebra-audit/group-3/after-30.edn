{-2}} & {\\color{lightgray}{-1}}\\end{bmatrix}\\begin{bmatrix}-4 & {\\color{lightgray}{-2}} & {\\color{lightgray}{2}} \\\\ -6 & {\\color{lightgray}{4}} & {\\color{lightgray}{-6}} \\\\ -5 & {\\color{lightgray}{-4}} & {\\color{lightgray}{1}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $X$ by the $1$st column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{11} & =\\begin{bmatrix}-2 & 1 & 2\\end{bmatrix}\\begin{bmatrix}-4 \\\\ -6 \\\\ -5\\end{bmatrix} \\\\  & =(-2)\\cdot (-4)+1\\cdot (-6)+2\\cdot (-5) \\\\  & =8-6-10 \\\\  & =-8.\\end{aligned}\n$$"] [17592186642630 :question/worked-solution "The full matrix product is\n\n$$\nK=\\begin{bmatrix}-3 & -5 \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{2}}\\end{bmatrix}\\begin{bmatrix}1 & {\\color{lightgray}{-3}} & {\\color{lightgray}{-2}} \\\\ 1 & {\\color{lightgray}{2}} & {\\color{lightgray}{4}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $M$ by the $1$st column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{11} & =\\begin{bmatrix}-3 & -5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =(-3)\\cdot 1+(-5)\\cdot 1 \\\\  & =-3-5 \\\\  & =-8.\\end{aligned}\n$$"] [17592186642633 :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}2 & -2 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{-4}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & {\\color{lightgray}{4}} & {\\color{lightgray}{4}} & 5 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{-5}} & {\\color{lightgray}{1}} & -3\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $X$ by the $4$th column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{14} & =\\begin{bmatrix}2 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3\\end{bmatrix} \\\\  & =2(5)+(-2)(-3) \\\\  & =10+6 \\\\  & =16.\\end{aligned}\n$$"] [17592186646270 :question/worked-solution "Multiplying the $3$rd row of $H$ by the $1$st column of $J$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{0}} & {\\color{lightgray}{-1}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{-2}} & {\\color{lightgray}{1}} \\\\ 2 & 0 & -1 \\\\ {\\color{lightgray}{1}} & {\\color{lightgray}{2}} & {\\color{lightgray}{0}}\\end{bmatrix}\\begin{bmatrix}3 & {\\color{lightgray}{-1}} \\\\ -1 & {\\color{lightgray}{5}} \\\\ -4 & {\\color{lightgray}{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -1 \\\\ -4\\end{bmatrix} \\\\  & =2\\cdot 3+0\\cdot (-1)+(-1)\\cdot (-4) \\\\  & =6+0+4 \\\\  & =10.\\end{aligned}\n$$"] [17592186647010 :question/worked-solution "Multiplying the $2$nd row in $B$ by the $3$rd column in $C$, we get\n\n$$\n\\begin{aligned}{a}_{23} & =\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{-1}} & {\\color{lightgray}{2}} \\\\ -2 & 0 & 3 \\\\ {\\color{lightgray}{4}} & {\\color{lightgray}{5}} & {\\color{lightgray}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & {\\color{lightgray}{2}} & 1 \\\\ {\\color{lightgray}{3}} & {\\color{lightgray}{-1}} & 4 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{5}} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 0 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4 \\\\ 0\\end{bmatrix} \\\\  & =(-2)(1)+0(4)+3(0) \\\\  & =-2+0+0 \\\\  & =-2.\\end{aligned}\n$$"] [17592186647044 :question/worked-solution "Multiplying the $4$th row in $P$ by the $2$nd column in $Q,$ we get\n\n$$\n\\begin{aligned}{r}_{42} & =\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{3}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{-2}} \\\\ {\\color{lightgray}{5}} & {\\color{lightgray}{1}} \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{1}} & 2 \\\\ {\\color{lightgray}{-3}} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -4\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =2(2)+(-4)(0) \\\\  & =4+0 \\\\  & =4.\\end{aligned}\n$$"]}
