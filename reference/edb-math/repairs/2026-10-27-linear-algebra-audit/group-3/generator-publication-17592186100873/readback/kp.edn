#{[{:db/id #edb/ref 17592186100873 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100695 :question/id #uuid "3a696ed3-e341-5ea6-bf17-681ba8e386c7" :question/math-academy-id "e-4407" :question/problem "Let $C=AB.$ What is the value of $c_{32}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & 4 & -1 \\\\ 1 & -2 & 2\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nC=\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{2}} \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{0}} \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{3}} & 4 & {\\color{lightgray}{-1}} \\\\ {\\color{lightgray}{1}} & -2 & {\\color{lightgray}{2}}\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =\\begin{bmatrix}1 & 2\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} \\\\  & =1\\cdot 4+2\\cdot (-2) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725764 :question-generator/id #uuid "8ae432d8-9bb1-5773-ab67-dbc68f87afe2" :question-generator/script "generators/0b/0bb7250591b2ca521fbab7a0201654c5f7dd325cbd74ada055fdca171c88f1e6/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186101529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da11c7dd-d121-5ec6-a851-0550acc8383c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186100336} {:answer/id #uuid "f05ee2d4-37e9-50bf-9c22-b5b9883029bf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186100337} {:answer/id #uuid "ff390486-aaf4-5c76-bea7-169be73cbb9b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186100338} {:answer/id #uuid "3dbfdba2-052a-5173-854f-fcd1979b88ad" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186100339} {:answer/id #uuid "4a55b509-3db2-5543-b2b0-ff04d40fa36c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186100340}] :answer-field/correct {:answer/id #uuid "4a55b509-3db2-5543-b2b0-ff04d40fa36c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186100340} :answer-field/id #uuid "8eb61b81-552d-543e-9977-b4452142c164" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100335}] :question/id #uuid "b8e4eb4a-9417-587e-869f-333706170962" :question/math-academy-id "q-70791" :question/problem "Let $C = AB$. What is the value of $c_{13}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-1 & 2 \\\\ 3 & 4 \\\\ -5 & 6\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & 1 & -2 \\\\ 2 & 0 & 5\\end{bmatrix}$</div>\n</div>\n\n?" :question/worked-solution "Multiply row $1$ of $A$ by column $3$ of $B$:\n\n$$\n\\begin{aligned}c_{13}&=\\begin{bmatrix}-1&2\\end{bmatrix}\\begin{bmatrix}-2\\\\5\\end{bmatrix}\\\\&=(-1)(-2)+2(5)\\\\&=12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80585822-4b2a-5bc3-ad21-63aca33fef78" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186100342} {:answer/id #uuid "f46d7639-df84-528a-ac36-8f2b1d918a6a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186100343} {:answer/id #uuid "f94ccd4f-ecfd-528a-99d6-bb71f6fbdbfc" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186100344} {:answer/id #uuid "568af77e-37c0-5e0d-b22d-90aeab758b4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186100345} {:answer/id #uuid "7559a496-a2a5-5577-b7ea-25f918286d30" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186100346}] :answer-field/correct {:answer/id #uuid "7559a496-a2a5-5577-b7ea-25f918286d30" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186100346} :answer-field/id #uuid "9e6f1148-d36b-51bb-99e8-5de0ade3469e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100341}] :question/id #uuid "d6dc76a2-8ad4-5d9f-970f-746f45e0bc48" :question/math-academy-id "q-70792" :question/problem "Let $Z = XY$. What is the value of $z_{42}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}-1 & 2 & -1 \\\\ 3 & 4 & 0 \\\\ 0 & -1 & 1 \\\\ -5 & 6 & -2\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}1 & -3 & -2 \\\\ -4 & 0 & -2 \\\\ -5 & 1 & -1\\end{bmatrix}$</div>\n</div>\n\n?" :question/worked-solution "Multiply row $4$ of $X$ by column $2$ of $Y$:\n\n$$\n\\begin{aligned}z_{42}&=\\begin{bmatrix}-5&6&-2\\end{bmatrix}\\begin{bmatrix}-3\\\\0\\\\1\\end{bmatrix}\\\\&=(-5)(-3)+6(0)+(-2)(1)\\\\&=13.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a9b3cc-7576-59b2-aabd-3e3baec2350f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263163} {:answer/id #uuid "220549d6-0043-5ea3-afc4-aec900485a3c" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186263301} {:answer/id #uuid "2ba621a6-7f8a-5196-8dc2-e27ffc2bb0d5" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186263369} {:answer/id #uuid "c860a24f-7231-5ddb-8c12-1297c7899912" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264755} {:answer/id #uuid "e89a0dc1-39c3-5234-b0bd-01580a7b5954" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186265022}] :answer-field/correct {:answer/id #uuid "e89a0dc1-39c3-5234-b0bd-01580a7b5954" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186265022} :answer-field/id #uuid "7b13e3a0-f57b-544f-a120-5165f77a15ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265456}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "945d4e42-e131-5958-8aed-5486accd9a01" :question/math-academy-id "q-130111" :question/problem "Let $S=UV.$ What is the value of ${s}_{13}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$U=\\begin{bmatrix}-2 & 3 & -1 \\\\ 3 & 0 & 4\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}-1 & -2 & 3 \\\\ 1 & 3 & -2 \\\\ 10 & 2 & -5\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nS=\\begin{bmatrix}-2 & 3 & -1 \\\\ {\\color{lightgray}{3}} & {\\color{lightgray}{0}} & {\\color{lightgray}{4}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{-2}} & 3 \\\\ {\\color{lightgray}{1}} & {\\color{lightgray}{3}} & -2 \\\\ {\\color{lightgray}{10}} & {\\color{lightgray}{2}} & -5\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $U$ by the $3$rd column in $V$, we get\n\n$$\n\\begin{aligned}{s}_{13} & =\\begin{bmatrix}-2 & 3 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2 \\\\ -5\\end{bmatrix} \\\\  & =(-2)\\cdot 3+3\\cdot (-2)+(-1)\\cdot (-5) \\\\  & =-6-6+5 \\\\  & =-7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41cfda0a-f144-589a-a43c-f062ef97cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263582} {:answer/id #uuid "6754aa3f-9d7e-5ec5-8d62-0bc2e16b1dd9" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186263893} {:answer/id #uuid "8692590c-83fe-5fc5-a3dc-acaa0e379556" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186264160} {:answer/id #uuid "cc7c5d22-55ac-5c2e-8365-30562490fd3c" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186264790} {:answer/id #uuid "f3ee5f0e-8ece-5209-a013-26fe841fffb9" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186265142}] :answer-field/correct {:answer/id #uuid "41cfda0a-f144-589a-a43c-f062ef97cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263582} :answer-field/id #uuid "913f5424-fdc7-501c-8672-ca7479ea1e3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265506}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "131c2176-2405-5c54-b473-9fb3958cf472" :question/math-academy-id "q-130120" :question/problem "Let $D=AB.$ What is the value of ${d}_{24}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-1 & 2 & 4 \\\\ 3 & 4 & -1 \\\\ -1 & 1 & 0 \\\\ 0 & 4 & -7\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 1 & -2 & -3 \\\\ 0 & 4 & -1 & 1 \\\\ 2 & 0 & 3 & -3\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nD=\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{2}} & {\\color{lightgray}{4}} \\\\ 3 & 4 & -1 \\\\ {\\color{lightgray}{-1}} & {\\color{lightgray}{1}} & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-7}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{1}} & {\\color{lightgray}{-2}} & -3 \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-1}} & 1 \\\\ {\\color{lightgray}{2}} & {\\color{lightgray}{0}} & {\\color{lightgray}{3}} & -3\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $A$ by the $4$th column in $B$, we get\n\n$$\n\\begin{aligned}{d}_{24} & =\\begin{bmatrix}3 & 4 & -1\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 1 \\\\ -3\\end{bmatrix} \\\\  & =3\\cdot (-3)+4\\cdot 1+(-1)\\cdot (-3) \\\\  & =-9+4+3 \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73870312-24b0-5710-9582-ace4d833975f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186291128}] :answer-field/correct {:answer/id #uuid "73870312-24b0-5710-9582-ace4d833975f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186291128} :answer-field/id #uuid "61916db7-9570-5896-8478-8a654eab7267" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292032}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "375c7db7-262a-5420-9a53-a13dd2a5b997" :question/math-academy-id "q-275547" :question/problem "Let $L=MN.$ What is the value of ${l}_{22}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$M=\\begin{bmatrix}2 & -3 \\\\ 4 & 2\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{bmatrix}?$</div>\n</div>\n\n${l}_{22}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nL=\\begin{bmatrix}{\\color{lightgray}{2}} & {\\color{lightgray}{-3}} \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{1}} & 2 & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{-1}} & 3 & {\\color{lightgray}{3}}\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{l}_{22} & =\\begin{bmatrix}4 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =4\\cdot 2+2\\cdot 3 \\\\  & =8+6 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872}] :answer-field/correct {:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872} :answer-field/id #uuid "0b459b10-8619-5f0d-afdd-56b9910358fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298672}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0cf7bab6-9aaa-53a5-ad4b-30e1807bc5dc" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Q=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}?$</div>\n</div>\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nP=\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{-2}} & {\\color{lightgray}{3}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-1}} \\\\ 2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 & {\\color{lightgray}{0}} \\\\ -3 & {\\color{lightgray}{2}} \\\\ 1 & {\\color{lightgray}{4}}\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =\\begin{bmatrix}2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660}] :answer-field/correct {:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660} :answer-field/id #uuid "cd3d9a0e-8498-5cbb-884b-c40fde8b221a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "941171d1-f178-5deb-90c4-b1a669882e6a" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Y=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}$</div>\n<div>$Z=\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}?$</div>\n</div>\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nX=\\begin{bmatrix}-2 & 3 & 0 \\\\ {\\color{lightgray}{1}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & 5 & {\\color{lightgray}{-1}} \\\\ {\\color{lightgray}{2}} & -3 & {\\color{lightgray}{4}} \\\\ {\\color{lightgray}{1}} & 1 & {\\color{lightgray}{0}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =\\begin{bmatrix}-2 & 3 & 0\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385}] :answer-field/correct {:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385} :answer-field/id #uuid "04b1a5a5-69b5-54cc-9927-afbe16de429c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298654}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d709c6eb-9e1b-5062-85d4-7521181b0638" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}?$</div>\n</div>\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{-1}} \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{2}} & {\\color{lightgray}{0}} & {\\color{lightgray}{5}} & -3 \\\\ {\\color{lightgray}{-4}} & {\\color{lightgray}{1}} & {\\color{lightgray}{-1}} & 2\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =\\begin{bmatrix}3 & 2\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab14835-d162-5a27-a085-b4b919a36b42" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186336132} {:answer/id #uuid "3315575e-eba2-51bc-a342-692c1283d7cb" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186336516} {:answer/id #uuid "618bb264-210a-53cf-ab61-500e5973c2f3" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186336911} {:answer/id #uuid "9eb3cc5f-cfd1-5a82-9250-0d6ceda1e462" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337467} {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488}] :answer-field/correct {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488} :answer-field/id #uuid "a63e7de0-266f-539b-8fee-e35ab81173de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338586}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "44992928-91b6-50f2-9197-4b5da9dd00f2" :question/math-academy-id "q-70946" :question/problem "Let $D=EF.$ What is the value of ${d}_{23}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nD=\\begin{bmatrix}{\\color{lightgray}{-2}} & {\\color{lightgray}{1}} \\\\ -4 & 3 \\\\ {\\color{lightgray}{6}} & {\\color{lightgray}{1}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{2}} & {\\color{lightgray}{1}} & -5 & {\\color{lightgray}{3}} \\\\ {\\color{lightgray}{-1}} & {\\color{lightgray}{0}} & -2 & {\\color{lightgray}{-1}}\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $E$ by the $3$rd column in $F$, we get\n\n$$\n\\begin{aligned}{d}_{23} & =\\begin{bmatrix}-4 & 3\\end{bmatrix}\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =(-4)\\cdot (-5)+3\\cdot (-2) \\\\  & =20-6 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e95cad-860e-538a-8b99-9f0c70f261c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336097} {:answer/id #uuid "57fc8d0d-2b20-52ee-b810-0e17521266a7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336838} {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} {:answer/id #uuid "a99efaa4-b49e-5cdd-af2c-d3ba9219b384" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186337563} {:answer/id #uuid "ad8fdf84-56c3-5819-a6bb-de4f89a6b352" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186337589}] :answer-field/correct {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} :answer-field/id #uuid "7d3b9a44-3753-5606-8ec0-132a1ef649d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338499}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bb301367-989b-59c3-9a3a-157e756a6cf8" :question/math-academy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$M=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nK=\\begin{bmatrix}5 & -4 \\\\ {\\color{lightgray}{-3}} & {\\color{lightgray}{2}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & -1 & {\\color{lightgray}{2}} \\\\ {\\color{lightgray}{-3}} & -2 & {\\color{lightgray}{-5}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =\\begin{bmatrix}5 & -4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} {:answer/id #uuid "3b70ccb4-c16c-5cf5-b11e-8aafc5f11705" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186336590} {:answer/id #uuid "baedc752-7f92-5818-8e49-7eadefb98f9f" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186337692} {:answer/id #uuid "d7a7677a-b2a4-59f0-ac24-ee44c46d1a26" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337904} {:answer/id #uuid "f431b48c-3499-5e6b-9764-458010a3f0be" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186338165}] :answer-field/correct {:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} :answer-field/id #uuid "618939f6-04ba-5ea6-a01f-f04923f31488" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338449}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3ed5dbc7-d94a-5c52-80fe-8e1e3e8256f9" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$U=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nT=\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-1}} \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{2}} & {\\color{lightgray}{10}} \\\\ {\\color{lightgray}{-3}} & {\\color{lightgray}{1}} & {\\color{lightgray}{-1}} \\\\ -5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 & {\\color{lightgray}{-3}} & {\\color{lightgray}{-2}} \\\\ -1 & {\\color{lightgray}{10}} & {\\color{lightgray}{-1}} \\\\ -1 & {\\color{lightgray}{20}} & {\\color{lightgray}{-1}}\\end{bmatrix}\n$$\n\nMultiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =\\begin{bmatrix}-5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nR=\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{-2}} \\\\ 3 & -4 \\\\ {\\color{lightgray}{4}} & {\\color{lightgray}{-6}} \\\\ {\\color{lightgray}{1}} & {\\color{lightgray}{-8}} \\\\ {\\color{lightgray}{3}} & {\\color{lightgray}{-9}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & {\\color{lightgray}{1}} & {\\color{lightgray}{2}} & {\\color{lightgray}{-1}} & 10 \\\\ {\\color{lightgray}{2}} & {\\color{lightgray}{0}} & {\\color{lightgray}{5}} & {\\color{lightgray}{-2}} & 7\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =\\begin{bmatrix}3 & -4\\end{bmatrix}\\begin{bmatrix}10 \\\\ 7\\end{bmatrix} \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c11f78e-8e30-52bd-832b-d7dd35b5f8e5" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186642616} {:answer/id #uuid "64b0c3dc-6f5d-5754-9473-c7503d431005" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186642618} {:answer/id #uuid "6b29be56-4c32-5f16-a1d0-81219465d866" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186642620} {:answer/id #uuid "9e52dbfb-f125-5841-a4c5-4b9323bbacc1" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186642625} {:answer/id #uuid "bea058cd-3d74-5de6-aa55-50ac5587dd09" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186642628}] :answer-field/correct {:answer/id #uuid "bea058cd-3d74-5de6-aa55-50ac5587dd09" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186642628} :answer-field/id #uuid "dc905687-81db-5390-ab7f-32a754d9fa74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642632}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "08bb2926-3195-5c83-bde4-c8c5367c12ec" :question/problem "Let $C = AB$. What is the value of $c_{32}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-1 & 5 \\\\ 3 & 0 \\\\ -2 & -4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 3 & 2 \\\\ -6 & 5 & 5\\end{bmatrix}$</div>\n</div>\n\n?" :question/worked-solution "The full matrix product is\n\n$$\nC=\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{5}} \\\\ {\\color{lightgray}{3}} & {\\color{lightgray}{0}} \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{-2}} & 3 & {\\color{lightgray}{2}} \\\\ {\\color{lightgray}{-6}} & 5 & {\\color{lightgray}{5}}\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =\\begin{bmatrix}-2 & -4\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix} \\\\  & =(-2)\\cdot 3+(-4)\\cdot 5 \\\\  & =-6-20 \\\\  & =-26.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ab6de0-e4c3-5d66-b87c-63555d015d4b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186642607} {:answer/id #uuid "5a4d7fec-f030-5792-bdb5-d042bcf748c9" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186642615} {:answer/id #uuid "676b8651-52ff-5c03-94cc-a3b15d796017" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186642619} {:answer/id #uuid "8ae2dd63-a08e-50c9-a3a6-9499c171b28a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186642624} {:answer/id #uuid "fa2bd584-e4ff-5cf2-830d-88b5f648cc41" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186642636}] :answer-field/correct {:answer/id #uuid "676b8651-52ff-5c03-94cc-a3b15d796017" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186642619} :answer-field/id #uuid "7d65a106-73ed-5e6a-bd90-2ef4a92d28a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642622}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "20ddb7c6-e7f6-5d34-85bd-5b82b85231cc" :question/problem "Let $T=UV.$ What is the value of ${t}_{31}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$U=\\begin{bmatrix}-3 & -6 & 2 \\\\ 4 & -3 & -1 \\\\ -1 & 3 & 3 \\\\ -2 & -2 & -5\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}2 & -4 & 2 \\\\ 4 & 1 & -1 \\\\ 0 & -3 & 3\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nT=\\begin{bmatrix}{\\color{lightgray}{-3}} & {\\color{lightgray}{-6}} & {\\color{lightgray}{2}} \\\\ {\\color{lightgray}{4}} & {\\color{lightgray}{-3}} & {\\color{lightgray}{-1}} \\\\ -1 & 3 & 3 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{-2}} & {\\color{lightgray}{-5}}\\end{bmatrix}\\begin{bmatrix}2 & {\\color{lightgray}{-4}} & {\\color{lightgray}{2}} \\\\ 4 & {\\color{lightgray}{1}} & {\\color{lightgray}{-1}} \\\\ 0 & {\\color{lightgray}{-3}} & {\\color{lightgray}{3}}\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{31} & =\\begin{bmatrix}-1 & 3 & 3\\end{bmatrix}\\begin{bmatrix}2 \\\\ 4 \\\\ 0\\end{bmatrix} \\\\  & =(-1)\\cdot 2+3\\cdot 4+3\\cdot 0 \\\\  & =-2+12+0 \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd150d6-cc3d-58ee-8394-00cb8454b7e8" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186642610} {:answer/id #uuid "2fdcf12f-82ac-5f70-ac3c-1ae04333cc87" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186642611} {:answer/id #uuid "898ff740-3065-5cee-a99f-52a1f0f814fd" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186642623} {:answer/id #uuid "ca2e23a1-b8ef-513d-9032-ee9cb09014dc" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186642629} {:answer/id #uuid "ee539d61-f50e-51a1-ac84-364fef151919" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186642634}] :answer-field/correct {:answer/id #uuid "2bd150d6-cc3d-58ee-8394-00cb8454b7e8" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186642610} :answer-field/id #uuid "29657839-779b-5b8b-b095-4d8825831787" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "523fb0cb-4281-5baa-8269-338f890da9ea" :question/problem "Let $Z = XY$. What is the value of $z_{11}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}-2 & 1 & 2 \\\\ -2 & 4 & -6 \\\\ -4 & 0 & 6 \\\\ 5 & -2 & -1\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}-4 & -2 & 2 \\\\ -6 & 4 & -6 \\\\ -5 & -4 & 1\\end{bmatrix}$</div>\n</div>\n\n?" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}-2 & 1 & 2 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{4}} & {\\color{lightgray}{-6}} \\\\ {\\color{lightgray}{-4}} & {\\color{lightgray}{0}} & {\\color{lightgray}{6}} \\\\ {\\color{lightgray}{5}} & {\\color{lightgray}{-2}} & {\\color{lightgray}{-1}}\\end{bmatrix}\\begin{bmatrix}-4 & {\\color{lightgray}{-2}} & {\\color{lightgray}{2}} \\\\ -6 & {\\color{lightgray}{4}} & {\\color{lightgray}{-6}} \\\\ -5 & {\\color{lightgray}{-4}} & {\\color{lightgray}{1}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $X$ by the $1$st column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{11} & =\\begin{bmatrix}-2 & 1 & 2\\end{bmatrix}\\begin{bmatrix}-4 \\\\ -6 \\\\ -5\\end{bmatrix} \\\\  & =(-2)\\cdot (-4)+1\\cdot (-6)+2\\cdot (-5) \\\\  & =8-6-10 \\\\  & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fa6d4c5-9ddf-50f1-ab7e-40bb293d5d75" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186642612} {:answer/id #uuid "43d0173a-11b2-5527-8591-816aaeaa7aea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186642613} {:answer/id #uuid "5d5632ef-c690-5f32-b9b9-2a46dfbe9775" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186642617} {:answer/id #uuid "aaa423a6-e320-5d9a-a8ff-056e3b87b86e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186642626} {:answer/id #uuid "dbf28885-d528-5833-806d-8c43f283bc36" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186642631}] :answer-field/correct {:answer/id #uuid "dbf28885-d528-5833-806d-8c43f283bc36" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186642631} :answer-field/id #uuid "7269e3d6-4d6f-5168-99cb-55b9a7ce8a07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642621}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dbe231bf-d183-5a05-8499-455d16c86f92" :question/problem "Let $K=MN.$ What is the value of ${k}_{11}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$M=\\begin{bmatrix}-3 & -5 \\\\ 0 & 2\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}1 & -3 & -2 \\\\ 1 & 2 & 4\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nK=\\begin{bmatrix}-3 & -5 \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{2}}\\end{bmatrix}\\begin{bmatrix}1 & {\\color{lightgray}{-3}} & {\\color{lightgray}{-2}} \\\\ 1 & {\\color{lightgray}{2}} & {\\color{lightgray}{4}}\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $M$ by the $1$st column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{11} & =\\begin{bmatrix}-3 & -5\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =(-3)\\cdot 1+(-5)\\cdot 1 \\\\  & =-3-5 \\\\  & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5c08d0d-691a-5091-a7ad-5f8e96f473dc" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186642635}] :answer-field/correct {:answer/id #uuid "f5c08d0d-691a-5091-a7ad-5f8e96f473dc" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186642635} :answer-field/id #uuid "af2ce934-5fe0-5b21-b061-1ff7095651d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186642627}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec7d4bcd-8ff1-5d13-8f08-7a186b9929da" :question/problem "Let $Z=XY.$ What is the value of ${z}_{14}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}2 & -2 \\\\ -2 & -4\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}0 & 4 & 4 & 5 \\\\ -2 & -5 & 1 & -3\\end{bmatrix}?$</div>\n</div>\n\n${z}_{14}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}2 & -2 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{-4}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & {\\color{lightgray}{4}} & {\\color{lightgray}{4}} & 5 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{-5}} & {\\color{lightgray}{1}} & -3\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $X$ by the $4$th column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{14} & =\\begin{bmatrix}2 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3\\end{bmatrix} \\\\  & =2(5)+(-2)(-3) \\\\  & =10+6 \\\\  & =16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186646270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53e0a66b-9102-5a3e-87b1-7bcf13dd16f1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186645934} {:answer/id #uuid "5ee282eb-76c2-5be5-9d49-e2d1fbfaafe4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186645949} {:answer/id #uuid "98362eec-1393-5059-84fd-f31b20435a76" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186646039} {:answer/id #uuid "d344abca-81ce-59a3-8ce4-6cc9a2407e2e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186646100} {:answer/id #uuid "f7c95609-9f63-5cba-a10f-34d61ffe9358" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186646150}] :answer-field/correct {:answer/id #uuid "d344abca-81ce-59a3-8ce4-6cc9a2407e2e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186646100} :answer-field/id #uuid "94e9c210-4a7c-5634-b0b7-886274bcf058" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186646233}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1814757d-bb0f-5f0a-9169-b4f613cdbbfb" :question/math-academy-id "q-70952" :question/problem "Let $G=HJ.$ What is the value of ${g}_{31}$, if\n\n$$\nH=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & -2 & 1 \\\\ 2 & 0 & -1 \\\\ 1 & 2 & 0\\end{bmatrix},\\,J=\\begin{bmatrix}3 & -1 \\\\ -1 & 5 \\\\ -4 & 2\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $3$rd row of $H$ by the $1$st column of $J$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{0}} & {\\color{lightgray}{-1}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{-2}} & {\\color{lightgray}{1}} \\\\ 2 & 0 & -1 \\\\ {\\color{lightgray}{1}} & {\\color{lightgray}{2}} & {\\color{lightgray}{0}}\\end{bmatrix}\\begin{bmatrix}3 & {\\color{lightgray}{-1}} \\\\ -1 & {\\color{lightgray}{5}} \\\\ -4 & {\\color{lightgray}{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -1 \\\\ -4\\end{bmatrix} \\\\  & =2\\cdot 3+0\\cdot (-1)+(-1)\\cdot (-4) \\\\  & =6+0+4 \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186647010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22c17fbc-9ac0-5bff-8f1d-4b3a9035be30" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186646476}] :answer-field/correct {:answer/id #uuid "22c17fbc-9ac0-5bff-8f1d-4b3a9035be30" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186646476} :answer-field/id #uuid "487f4946-6601-51e0-85a7-2026b2356e9a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186646929}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "09ddb40e-a04f-502b-831d-9899e7155ce3" :question/math-academy-id "q-318464" :question/problem "Let $A=BC.$ What is the value of ${a}_{23}$, if\n\n$$\nB=\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 0 & 3 \\\\ 4 & 5 & -1\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 2 & 1 \\\\ 3 & -1 & 4 \\\\ -2 & 5 & 0\\end{bmatrix}?\n$$\n\n${a}_{23}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $B$ by the $3$rd column in $C$, we get\n\n$$\n\\begin{aligned}{a}_{23} & =\\begin{bmatrix}{\\color{lightgray}{1}} & {\\color{lightgray}{-1}} & {\\color{lightgray}{2}} \\\\ -2 & 0 & 3 \\\\ {\\color{lightgray}{4}} & {\\color{lightgray}{5}} & {\\color{lightgray}{-1}}\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{0}} & {\\color{lightgray}{2}} & 1 \\\\ {\\color{lightgray}{3}} & {\\color{lightgray}{-1}} & 4 \\\\ {\\color{lightgray}{-2}} & {\\color{lightgray}{5}} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 0 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4 \\\\ 0\\end{bmatrix} \\\\  & =(-2)(1)+0(4)+3(0) \\\\  & =-2+0+0 \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186647044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd177de-c030-50b4-a605-6e5fe0df8140" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186646651}] :answer-field/correct {:answer/id #uuid "7bd177de-c030-50b4-a605-6e5fe0df8140" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186646651} :answer-field/id #uuid "854a374f-5958-5a14-bb51-eb8d55caa831" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186646958}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "485b2cd5-2903-511a-a83b-a078a2197cb2" :question/math-academy-id "q-318471" :question/problem "Let $R=PQ.$ What is the value of ${r}_{42}$, if\n\n$$\nP=\\begin{bmatrix}-1 & 3 \\\\ 0 & -2 \\\\ 5 & 1 \\\\ 2 & -4\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 2 \\\\ -3 & 0\\end{bmatrix}?\n$$\n\n${r}_{42}=$\n{{field-1}}" :question/worked-solution "Multiplying the $4$th row in $P$ by the $2$nd column in $Q,$ we get\n\n$$\n\\begin{aligned}{r}_{42} & =\\begin{bmatrix}{\\color{lightgray}{-1}} & {\\color{lightgray}{3}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{-2}} \\\\ {\\color{lightgray}{5}} & {\\color{lightgray}{1}} \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}{\\color{lightgray}{1}} & 2 \\\\ {\\color{lightgray}{-3}} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -4\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =2(2)+(-4)(0) \\\\  & =4+0 \\\\  & =4.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}]}
