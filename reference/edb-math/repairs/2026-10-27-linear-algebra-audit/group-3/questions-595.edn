6642633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5c08d0d-691a-5091-a7ad-5f8e96f473dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186642635}] :answer-field/correct {:db/id #edb/ref 17592186642635} :answer-field/id #uuid "af2ce934-5fe0-5b21-b061-1ff7095651d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186642627}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ec7d4bcd-8ff1-5d13-8f08-7a186b9929da" :question/problem "Let $Z=XY.$ What is the value of ${z}_{14}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}2 & -2 \\\\ -2 & -4\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}0 & 4 & 4 & 5 \\\\ -2 & -5 & 1 & -3\\end{bmatrix}?$</div>\n</div>\n\n${z}_{14}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}2 & -2 \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}0 & 4 & 4 & 5 \\\\ -2 & -5 & 1 & -3\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $X$ by the $4$th column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{14} & =\\begin{bmatrix}2 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3\\end{bmatrix} \\\\  & =2(5)+(-2)(-3) \\\\  & =10+6 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186643265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c206660b-d996-5868-92a1-4ddde1d3af7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186643286}] :answer-field/correct {:db/id #edb/ref 17592186643286} :answer-field/id #uuid "3c50e828-d613-55fb-aa44-0d17abb0f0f0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186643259} {:answer-field/choices [{:answer/id #uuid "57dbb366-880e-5173-b74b-3250f19a66c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-28" :db/id #edb/ref 17592186643263}] :answer-field/correct {:db/id #edb/ref 17592186643263