ix}.\n$$"}] [{:db/id #edb/ref 17592186642606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c11f78e-8e30-52bd-832b-d7dd35b5f8e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186642616} {:answer/id #uuid "64b0c3dc-6f5d-5754-9473-c7503d431005" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-28" :db/id #edb/ref 17592186642618} {:answer/id #uuid "6b29be56-4c32-5f16-a1d0-81219465d866" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186642620} {:answer/id #uuid "9e52dbfb-f125-5841-a4c5-4b9323bbacc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186642625} {:answer/id #uuid "bea058cd-3d74-5de6-aa55-50ac5587dd09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-26" :db/id #edb/ref 17592186642628}] :answer-field/correct {:db/id #edb/ref 17592186642628} :answer-field/id #uuid "dc905687-81db-5390-ab7f-32a754d9fa74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186642632}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "08bb2926-3195-5c83-bde4-c8c5367c12ec" :question/problem "Let $C = AB$. What is the value of $c_{32}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-1 & 5 \\\\ 3 & 0 \\\\ -2 & -4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 3 & 2 \\\\ -6 & 5 & 5\\end{bmatrix}$</div>\n</div>\n\n?" :question/worked-solution "The full matrix product is\n\n$$\nC=\\begin{bmatrix}-1 & 5 \\\\ 3 & 0 \\\\ -2 & -4\\end{bmatrix}\\begin{bmatrix}-2 & 3 & 2 \\\\ -6 & 5 & 5\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =\\begin{bmatrix}-2 & -4\\end{bmatrix}\\begin{bmatrix}3 \\\\ 5\\end{bmatrix} \\\\  & =(-2)\\cdot 3+(-4)\\cdot 5 \\\\  & =-6-20 \\\\  & =-26.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186642608 :question/answe