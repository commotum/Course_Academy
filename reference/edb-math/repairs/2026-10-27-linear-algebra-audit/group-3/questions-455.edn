 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186436819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21333662-4221-5556-87c3-a82bacc85a82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=(-6){R}_{1}" :db/id #edb/ref 17592186436762} {:answer/id #uuid "2e0aec34-380f-59c7-b0b9-bab7ff9c5edb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+6{R}_{1}" :db/id #edb/ref 17592186436763} {:answer/id #uuid "40cb2605-d7af-5bce-abf6-276350c8dc19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-6){R}_{1}" :db/id #edb/ref 17592186436765} {:answer/id #uuid "bf2a402f-3c31-5995-88ca-f0b9c765a7e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-6){R}_{2}" :db/id #edb/ref 17592186436791} {:answer/id #uuid "e0355739-0916-506f-b796-ffbe20c9beba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=(-6){R}_{2}" :db/id #edb/ref 17592186436795}] :answer-field/correct {:db/id #edb/ref 17592186436765} :answer-field/id #uuid "0be5a703-ade8-5f32-9eae-8fc699a6f178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436803}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88681796-21e9-5e72-a195-e1da66276721" :question/math-academy-id "q-130842" :question/problem "Let $E=\\begin{bmatrix}1 & 0 \\\\ -6 & 1\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by taking the second row of the identity matrix and adding $-6$ times the first row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+(-6){R}_{1} \\\\  & ∼\\begin{bmatrix}1 