5 \\\\ 2 & 0 & 0 & 0 \\\\ -4 & 0 & 3 & 0 \\\\ -3 & -5 & 1 & -4\\end{vmatrix} \\\\  & =2\\cdot (-1)^{2+1}\\begin{vmatrix}6 & 4 & 5 \\\\ 0 & 3 & 0 \\\\ -5 & 1 & -4\\end{vmatrix} \\\\  & =-2\\cdot \\begin{vmatrix}6 & 4 & 5 \\\\ 0 & 3 & 0 \\\\ -5 & 1 & -4\\end{vmatrix} \\\\  & =(-2)\\cdot (3)\\cdot (-1)^{2+2}\\begin{vmatrix}6 & 5 \\\\ -5 & -4\\end{vmatrix} \\\\  & =-6(-24+25) \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186440782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54bddb8d-cf36-57d3-8990-5419840cdebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}8 & 11 & -10 \\\\ 1 & -7 & -2 \\\\ -4 & -14 & 19\\end{vmatrix}" :db/id #edb/ref 17592186440743} {:answer/id #uuid "c076c4ac-c079-5402-8162-3e9e7e97c4a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}13 & -8 & -10 \\\\ 1 & 7 & -4 \\\\ -4 & 6 & 12\\end{vmatrix}" :db/id #edb/ref 17592186440753} {:answer/id #uuid "df6a56d6-11e4-5ce2-b833-c8b6d50c3e35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}13 & 10 & -5 \\\\ 1 & 7 & -2 \\\\ -2 & -16 & -21\\end{vmatrix}" :db/id #edb/ref 17592186440762} {:answer/id #uuid "f439f4fb-9730-5674-820b-040ca58a4b57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}13 & 11 & -10 \\\\ 1 & 7 & -2 \\\\ -4 & -16 & 21\\end{vmatrix}" :db/id #edb/ref 17592186440764} {:answer/id #uuid "f563015d-cc65-5533-8c04-fd6a642474d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}13 & 11 & -10 \\\\ 10 & 2 & 2 \\\\ -4 & -13 & 24\\end{vmatrix}" :db/id #edb/ref 17592186440765}] :answer-field/correct {:db/id #edb/ref 17592186440764} :answer-field/id #uuid "5017e5ab-f540-5f24-b47d-7ab195cf9ff0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440772}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f1c17071-3f38-5e15-9f1d-979ec9d512e0" :question/math-academy-id "q-131226" :question/problem "$$\n\\begin{vmatrix}4 & -3 & 2 & 5 \\\\ -2 & -1 & 4 & 3 \\\\ 5 & 3 & -7 & 6 \\\\ 3 & 1 & 3 & -5\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above ${a}_{42}$ equal to zero.*" :question/worked-solution "Let's make entries above ${a}_{42}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}4 & -3 & 2 & 5 \\\\ -2 & -1 & 4 & 3 \\\\ 5 & 3 & -7 & 6 \\\\ 3 & 1 & 3 & -5\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{4} \\\\ {R}_{2}:={R}_{2}+{R}_{4} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{4}\\end{aligned} \\\\  & =\\begin{vmatrix}13 & 0 & 11 & -10 \\\\ 1 & 0 & 7 & -2 \\\\ -4 & 0 & -16 & 21 \\\\ 3 & 1 & 3 & -5\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}13 & 0 & 11 & -10 \\\\ 1 & 0 & 7 & -2 \\\\ -4 & 0 & -16 & 21 \\\\ 3 & 1 & 3 & -5\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+2}\\begin{vmatrix}13 & 11 & -10 \\\\ 1 & 7 & -2 \\\\ -4 & -16 & 21\\end{vmatrix} \\\\  & =\\begin{vmatrix}13 & 11 & -10 \\\\ 1 & 7 & -2 \\\\ -4 & -16 & 21\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186440932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02156f42-01b9-5208-be76-46dd56d1f051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ -2 & 0 & -3 \\\\ 4 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186440906} {:answer/id #uuid "6988567e-c6b3-5730-a2d4-b0c476a8c21a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186440912} {:answer/id #uuid "79b811ba-d237-5358-9a7b-e5099ee68347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440913} {:answer/id #uuid "c40a1344-3c43-5a5d-97e2-770817ab45f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 6 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440921} {:answer/id #uuid "fb87aec8-67bb-5868-9fd5-615026521a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 1 & 0 \\\\ 4 & 0 & 6 \\\\ -2 & 0 & -3\\end{bmatrix}" :db/id #edb/ref 17592186440925}] :answer-field/correct {:db/id #edb/ref 17592186440913} :answer-field/id #uuid "e2b3e7c5-52c2-5e4b-bcbf-08cf2d113f06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440928}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de50db69-1f49-5b62-bb8f-7cba652094a4" :question/math-academy-id "q-130663" :question/problem "If $A=\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}$, then ${A}^{4}=$" :question/worked-solution "First, we compute ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix} \\\\  & =A\\end{aligned}\n$$\n\nNotice that ${A}^{2}=A,$ so $A$ is an idempotent matrix. \n\nWe can use this fact to compute ${A}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =A\\cdot A \\\\  & ={A}^{2} \\\\  & =A\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{A}^{4}=\\begin{bmatrix}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186481376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f4d151-1cd0-5621-ba89-6470f4af573e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186480746} {:answer/id #uuid "86ae4f21-6981-5f72-90e2-a3f32de9f3c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186481000} {:answer/id #uuid "8fca35bb-c3b8-5e45-a1f8-dfab2c842147" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186481008} {:answer/id #uuid "9c56e737-b927-5ce7-a48f-7ae0b922a01d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186481039} {:answer/id #uuid "bb990b9f-4a58-59bd-858f-c85000fc92e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186481093}] :answer-field/correct {:db/id #edb/ref 17592186481039} :answer-field/id #uuid "010bf50f-8de4-58ce-a0a7-3ef04178a4cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481238}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "656e0655-2fab-5e41-bca0-28f4bd148f34" :question/math-academy-id "q-35293" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-2 & -3 & 5 \\\\ 4 & 6 & -10 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, it has exactly $1$ non-zero row). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ -6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=1.\n$$"}] [{:db/id #edb/ref 17592186483398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2674be6f-e836-53b6-ad75-f49bcd215297" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186482879} {:answer/id #uuid "2fdaf3df-3466-5a46-9d91-de545d17a174" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186482896} {:answer/id #uuid "628e0240-3161-5a31-bec3-d0d78a344f09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186482984} {:answer/id #uuid "ca9bbb01-90f1-5914-b05b-4fdbb5c155e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186483149} {:answer/id #uuid "d68f1746-c721-55d0-abfa-7820321d3544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186483176}] :answer-field/correct {:db/id #edb/ref 17592186482879} :answer-field/id #uuid "6d524d4c-bdb9-5865-a9c3-811956ada022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483279}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b149c895-74ab-53c4-8e34-ba4f249fb566" :question/math-academy-id "q-79314" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-5 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ -2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-5 & 2 & 0 & 1 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, $2$ non-zero rows). \n\nTherefore,\n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-5 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}0 \\\\ -2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix}\\})=2.\n$$"}] [{:db/id #edb/ref 17592186484198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04efdac5-3dd6-5c5f-8a26-b2759cf8283c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186483576} {:answer/id #uuid "59ee36a8-3df4-5abd-9635-4a64fbb2b20e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186483735} {:answer/id #uuid "6881cacb-49d1-5796-ac41-85af50ef8c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186483770} {:answer/id #uuid "8d5ed0e6-bb61-546d-a212-902bf1dcb965" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186483861} {:answer/id #uuid "9c10c03d-47ea-5d76-845a-038143841e71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186483885}] :answer-field/correct {:db/id #edb/ref 17592186483861} :answer-field/id #uuid "68dc34c5-a4cf-5701-b2b5-6b8a0f11f690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484132}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "099dc702-c2e9-5790-a5a1-762c52cdef4b" :question/math-academy-id "q-130632" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=24$ and $|{C}^{-1}|=4$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=\\frac{1}{4}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =24\\cdot \\frac{1}{4} \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0acfc248-b5ab-54fa-8eb8-3479fdad0217" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186483590} {:answer/id #uuid "4b107cbc-1aec-5e53-8ab7-cac57bdb14f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-51" :db/id #edb/ref 17592186483702} {:answer/id #uuid "7e63a3c5-498c-5a2e-b046-09467c9969f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-26" :db/id #edb/ref 17592186483824} {:answer/id #uuid "b5c2c137-72d0-5dfc-8aa8-6b6268ba7b95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-55" :db/id #edb/ref 17592186483930} {:answer/id #uuid "e76766a9-b27c-5c4f-ae2b-31a477472e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-66" :db/id #edb/ref 17592186484026}] :answer-field/correct {:db/id #edb/ref 17592186484026} :answer-field/id #uuid "75ca7507-fbd3-5777-94c4-ec567590b1b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484138}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bcf73b5-94e8-5857-a9f9-54d536a26fba" :question/math-academy-id "q-88265" :question/problem "Given that $$\n\\displaystyle A=\\begin{bmatrix}2\\sqrt{2} & -3 \\\\ 1 & 2\\sqrt{2}\\end{bmatrix}\\begin{bmatrix}-1 & 1 \\\\ 1 & 5\\end{bmatrix},\n$$ find $det(A).$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nIn our case, this gives\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}2\\sqrt{2} & -3 \\\\ 1 & 2\\sqrt{2}\\end{bmatrix}\\cdot det\\begin{bmatrix}-1 & 1 \\\\ 1 & 5\\end{bmatrix} \\\\  & =(8-(-3))\\cdot (-5-1) \\\\  & =11\\cdot (-6) \\\\  & =-66.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c6938e-502c-5f98-9c7a-0ebfcfb54e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-68" :db/id #edb/ref 17592186483582} {:answer/id #uuid "4f852e05-57a9-502f-b965-9fd1fbb17ae7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-66" :db/id #edb/ref 17592186483713} {:answer/id #uuid "a098acd6-da89-5cfe-bde4-ac323858939a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-110" :db/id #edb/ref 17592186483898} {:answer/id #uuid "c4678384-56ad-53be-a089-e4e17f325669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186483955} {:answer/id #uuid "f23d61e3-4fd0-5603-9dfe-41cc76943e7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186484052}] :answer-field/correct {:db/id #edb/ref 17592186483713} :answer-field/id #uuid "e9aaf06e-8aeb-522a-88ab-797652cf646e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484185}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "20f4c241-f6b2-5f00-9ec7-bcba6743c7a5" :question/math-academy-id "q-42919" :question/problem "Calculate the value of \n$$\n\\displaystyle \\,\\begin{vmatrix}1 & -2 & -2 & 2 \\\\ 3 & 4 & -6 & -1 \\\\ -3 & 2 & 4 & 3 \\\\ -5 & -1 & 10 & 1\\end{vmatrix}.\n$$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{13}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{13}=-2$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & -2 & -2 & 2 \\\\ 3 & 4 & -6 & -1 \\\\ -3 & 2 & 4 & 3 \\\\ -5 & -1 & 10 & 1\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ {R}_{3}:={R}_{3}+2{R}_{1} \\\\ {R}_{4}:={R}_{4}+5{R}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}1 & -2 & -2 & 2 \\\\ 0 & 10 & 0 & -7 \\\\ -1 & -2 & 0 & 7 \\\\ 0 & -11 & 0 & 11\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & -2 & -2 & 2 \\\\ 0 & 10 & 0 & -7 \\\\ -1 & -2 & 0 & 7 \\\\ 0 & -11 & 0 & 11\\end{vmatrix} \\\\  & =(-2)\\cdot (-1)^{1+3}\\begin{vmatrix}0 & 10 & -7 \\\\ -1 & -2 & 7 \\\\ 0 & -11 & 11\\end{vmatrix} \\\\  & =-2\\begin{vmatrix}0 & 10 & -7 \\\\ -1 & -2 & 7 \\\\ 0 & -11 & 11\\end{vmatrix} \\\\  & =(-2)\\cdot (-1)\\cdot (-1)^{2+1}\\begin{vmatrix}10 & -7 \\\\ -11 & 11\\end{vmatrix} \\\\  & =-2(110-77) \\\\  & =-66.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd15e66-d81f-505f-ae3a-06ee7efe8da5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28" :db/id #edb/ref 17592186483817} {:answer/id #uuid "7f02f7ea-bb98-517e-b82f-b806e5e2a73b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,170" :db/id #edb/ref 17592186483828} {:answer/id #uuid "92f177fd-349d-5f7e-80b4-6b9c20c3f3eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "578" :db/id #edb/ref 17592186483871} {:answer/id #uuid "a70b093d-7492-5a92-b086-4158c45fe368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,272" :db/id #edb/ref 17592186483908} {:answer/id #uuid "cd8cb6ec-b4fb-5a1e-8a74-79d83ac487eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400" :db/id #edb/ref 17592186483978}] :answer-field/correct {:db/id #edb/ref 17592186483978} :answer-field/id #uuid "87ae0d39-79d3-52b7-9037-2374608a8562" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484148}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3c0dc310-8159-56fb-918f-2199e65fa375" :question/math-academy-id "q-42585" :question/problem "Find\n$$\n\\displaystyle \\begin{vmatrix}4 & 6 & 9 \\\\ 202 & 203 & 205 \\\\ 202 & 203 & 204\\end{vmatrix}.\n$$" :question/worked-solution "First, notice that the $2$nd row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 6 & 9 \\\\ 202 & 203 & 205 \\\\ 202 & 203 & 204\\end{vmatrix} & =\\begin{vmatrix}4 & 6 & 9 \\\\ 202+0 & 203+0 & 204+1 \\\\ 202 & 203 & 204\\end{vmatrix}\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 6 & 9 \\\\ 202+0 & 203+0 & 204+1 \\\\ 202 & 203 & 204\\end{vmatrix} & =\\begin{vmatrix}4 & 6 & 9 \\\\ 202 & 203 & 204 \\\\ 202 & 203 & 204\\end{vmatrix}+\\begin{vmatrix}4 & 6 & 9 \\\\ 0 & 0 & 1 \\\\ 202 & 203 & 204\\end{vmatrix}.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}4 & 6 & 9 \\\\ 202 & 203 & 204 \\\\ 202 & 203 & 204\\end{vmatrix}+\\begin{vmatrix}4 & 6 & 9 \\\\ 0 & 0 & 1 \\\\ 202 & 203 & 204\\end{vmatrix} & =0+1(-1)^{2+3}\\begin{vmatrix}4 & 6 \\\\ 202 & 203\\end{vmatrix} \\\\  & =-(4\\cdot 203-6\\cdot 202) \\\\  & =-(812-1\\,212) \\\\  & =400\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a728dd52-17c5-5bbe-8ae1-9335ea32a209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186483909} {:answer/id #uuid "c97eaa67-5423-5696-a85d-e65f81cf7222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "84" :db/id #edb/ref 17592186483965} {:answer/id #uuid "cba33b1f-74be-596c-ab36-00796559159b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-96" :db/id #edb/ref 17592186483974} {:answer/id #uuid "e79780cf-7d17-561d-9e14-064715c15dac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186484027} {:answer/id #uuid "e7a2cfdc-549e-5021-bdb9-3d2b4d0cce92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186484028}] :answer-field/correct {:db/id #edb/ref 17592186483974} :answer-field/id #uuid "7173e51f-ca84-5cf0-ad24-28894c605bbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484134}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "76f24dd6-dfcb-56d2-ac88-5f5a55e3e851" :question/math-academy-id "q-88273" :question/problem "Given that $$\n\\displaystyle H=\\begin{bmatrix}1 & -2 & 6 \\\\ 3 & 2 & 4 \\\\ 0 & 0 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 & 3 \\\\ -3 & 3 & 1 \\\\ 1 & 0 & 1\\end{bmatrix},\n$$ find $det(H).$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nIn our case, this gives\n\n$$\ndet(H)=det\\begin{bmatrix}1 & -2 & 6 \\\\ 3 & 2 & 4 \\\\ 0 & 0 & 4\\end{bmatrix}\\cdot det\\begin{bmatrix}2 & 0 & 3 \\\\ -3 & 3 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}.\n$$\n\nWe can compute the required determinants as follows:\n\n- For the first determinant, we can compute it using a Laplace expansion across the $3$rd row.\n\n- For the second determinant, we can compute it using a Laplace expansion down the $2$nd column.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}1 & -2 & -6 \\\\ 3 & 2 & 4 \\\\ 0 & 0 & 4\\end{vmatrix}\\cdot \\begin{vmatrix}2 & 0 & 3 \\\\ -3 & 3 & 1 \\\\ 1 & 0 & 1\\end{vmatrix} \\\\  & =4(-1)^{3+3}\\begin{vmatrix}1 & -2 \\\\ 3 & 2\\end{vmatrix}\\cdot 3(-1)^{2+2}\\begin{vmatrix}2 & 3 \\\\ 1 & 1\\end{vmatrix} \\\\  & =4(2-(-6)\\cdot 3(2-3) \\\\  & =32\\cdot (-3) \\\\  & =-96.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d6e884-c166-55a3-a97c-9e435db64b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\begin{vmatrix}-1 & 3 & 4 \\\\ -2 & 2 & 3 \\\\ 1 & -1 & -2\\end{vmatrix}" :db/id #edb/ref 17592186483607} {:answer/id #uuid "5e4476d2-7b18-522a-b167-52cbab3f3c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\begin{vmatrix}3 & 6 & -3 \\\\ -2 & 2 & 3 \\\\ 1 & -1 & -2\\end{vmatrix}" :db/id #edb/ref 17592186483748} {:answer/id #uuid "8b44067d-79fe-52e7-82bd-1255f8daff64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\begin{vmatrix}1 & 3 & 4 \\\\ 2 & 2 & 3 \\\\ 4 & -1 & -2\\end{vmatrix}" :db/id #edb/ref 17592186483854} {:answer/id #uuid "9e5f3ec9-451c-5e08-9424-a012a9cef0b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\begin{vmatrix}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{vmatrix}" :db/id #edb/ref 17592186483895} {:answer/id #uuid "d5ed131f-b891-52a5-9551-160b86e31eff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\begin{vmatrix}4 & 5 & 3 \\\\ 8 & 6 & -5 \\\\ 1 & 9 & 7\\end{vmatrix}" :db/id #edb/ref 17592186483994}] :answer-field/correct {:db/id #edb/ref 17592186483895} :answer-field/id #uuid "773fbcca-312d-53ef-8e00-a56e31c49e76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484139}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "858b58f0-f246-57e1-b5d7-2b4a24d86dda" :question/math-academy-id "q-91200" :question/problem "$$\n\\begin{vmatrix}9 & 3 & 6 & -3 \\\\ 1 & -1 & 3 & 4 \\\\ 2 & -2 & 2 & 3 \\\\ 4 & 1 & -1 & -2\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{12}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{12}=3$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}9 & 3 & 6 & -3 \\\\ 1 & -1 & 3 & 4 \\\\ 2 & -2 & 2 & 3 \\\\ 4 & 1 & -1 & -2\\end{vmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-3){C}_{2} \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+{C}_{2}\\end{aligned} \\\\  & =\\begin{vmatrix}0 & 3 & 0 & 0 \\\\ 4 & -1 & 5 & 3 \\\\ 8 & -2 & 6 & 1 \\\\ 1 & 1 & -3 & -1\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $1$st row, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}0 & 3 & 0 & 0 \\\\ 4 & -1 & 5 & 3 \\\\ 8 & -2 & 6 & 1 \\\\ 1 & 1 & -3 & -1\\end{vmatrix} \\\\  & =3\\cdot (-1)^{1+2}\\begin{vmatrix}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{vmatrix} \\\\  & =-3\\begin{vmatrix}4 & 5 & 3 \\\\ 8 & 6 & 1 \\\\ 1 & -3 & -1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d711e45-7ec3-56d2-ab35-037569a4df11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\begin{vmatrix}-3 & -5 & 2 \\\\ -2 & 0 & -1 \\\\ -5 & 2 & -4\\end{vmatrix}" :db/id #edb/ref 17592186483744} {:answer/id #uuid "7e8a1859-b3ba-56f4-b537-6223471bd407" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\begin{vmatrix}1 & -5 & 4 \\\\ 1 & 2 & -6 \\\\ 4 & 7 & -8\\end{vmatrix}" :db/id #edb/ref 17592186483825} {:answer/id #uuid "b8679840-e1d7-55b1-9b60-168dd43e13d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\begin{vmatrix}-3 & -5 & 2 \\\\ -5 & 2 & -4 \\\\ -4 & -8 & 8\\end{vmatrix}" :db/id #edb/ref 17592186483937} {:answer/id #uuid "db442710-d557-5f6a-8536-d434b1d8713a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\begin{vmatrix}1 & -5 & 4 \\\\ 1 & 2 & -1 \\\\ -6 & -8 & 7\\end{vmatrix}" :db/id #edb/ref 17592186484004} {:answer/id #uuid "f05253ae-92cc-554f-a9fa-70f4587815bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\begin{vmatrix}-3 & 2 & 8 \\\\ -1 & 2 & 1 \\\\ 7 & -8 & 6\\end{vmatrix}" :db/id #edb/ref 17592186484044}] :answer-field/correct {:db/id #edb/ref 17592186484004} :answer-field/id #uuid "8e61c18c-5fab-5f5b-87cc-ad4a3cb34dce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "988956df-fafe-5af5-9e6f-367acfc61887" :question/math-academy-id "q-42570" :question/problem "$$\n\\begin{vmatrix}2 & -3 & -5 & 2 \\\\ 1 & -2 & 0 & -1 \\\\ 3 & -5 & 2 & -4 \\\\ -1 & -4 & -8 & 8\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{21}$ equal to zero.*" :question/worked-solution "Let's make entries above and below ${a}_{21}=1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}2 & -3 & -5 & 2 \\\\ 1 & -2 & 0 & -1 \\\\ 3 & -5 & 2 & -4 \\\\ -1 & -4 & -8 & 8\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+(-2){R}_{2} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{2} \\\\ {R}_{4}:={R}_{4}+{R}_{2}\\end{aligned} \\\\  & =\\begin{vmatrix}0 & 1 & -5 & 4 \\\\ 1 & -2 & 0 & -1 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & -6 & -8 & 7\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $1$st column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}0 & 1 & -5 & 4 \\\\ 1 & -2 & 0 & -1 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & -6 & -8 & 7\\end{vmatrix} \\\\  & =1\\cdot (-1)^{2+1}\\begin{vmatrix}1 & -5 & 4 \\\\ 1 & 2 & -1 \\\\ -6 & -8 & 7\\end{vmatrix} \\\\  & =-\\begin{vmatrix}1 & -5 & 4 \\\\ 1 & 2 & -1 \\\\ -6 & -8 & 7\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186484286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b3c0e7-01c6-5510-aaa7-6103067cdafd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186483600} {:answer/id #uuid "57d0f5ec-4050-55b9-86ce-57bffb2142ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186483727} {:answer/id #uuid "9d96e0aa-ca98-55b2-a431-8d6b9c26a4cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186483888} {:answer/id #uuid "ad587483-130d-5a95-91ba-0265af6e89b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186483916} {:answer/id #uuid "e2da65e2-07d0-5e36-abf3-a1b103221c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186484016}] :answer-field/correct {:db/id #edb/ref 17592186484016} :answer-field/id #uuid "cab925e1-8606-5f87-ab70-d0c31c22a818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484177}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eb18f7db-5036-553a-815a-b1774de95355" :question/math-academy-id "q-42580" :question/problem "Given that \n$$\n\\displaystyle \\begin{vmatrix}2 & 4 \\\\ a & b-1\\end{vmatrix}=5,\n$$\nfind \n$$\n\\displaystyle \\begin{vmatrix}2 & 4 \\\\ a+2 & b\\end{vmatrix}.\n$$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 4 \\\\ a+2 & b\\end{vmatrix} & =\\begin{vmatrix}2 & 4 \\\\ a+2 & (b-1)+1\\end{vmatrix}\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}\\begin{vmatrix}2 & 4 \\\\ a+2 & (b-1)+1\\end{vmatrix} & =\\underbrace{\\begin{vmatrix}2 & 4 \\\\ a & b-1\\end{vmatrix}}_{5}+\\begin{vmatrix}2 & 4 \\\\ 2 & 1\\end{vmatrix} \\\\  & =5+(2-8) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "491ec8ca-40f3-5454-809e-b6b418901802" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186489686} {:answer/id #uuid "4bad21d3-8ccb-5f2e-b04d-bc4550a71c3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186489691} {:answer/id #uuid "83029887-1c17-5621-b865-840b4e1ed3fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186489813} {:answer/id #uuid "8884a0e0-0a83-5ace-92f9-fb64604eefa0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186489827} {:answer/id #uuid "916469af-a06a-5bf7-a441-a7fdd789fe00" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186489844}] :answer-field/correct {:db/id #edb/ref 17592186489827} :answer-field/id #uuid "6a6251f1-889c-581d-b906-e6b75fa33975" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490134}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "128f0273-6319-516f-a4e8-3d58e084f0a9" :question/math-academy-id "q-142538" :question/problem "Which of the following statements are true given that $A$ is a $5\\times 5$ matrix with $2$ pivot columns?\n\nI. $\\text{rank}(A)=4$\n\nII. $A$ is invertible\n\nIII. $\\text{nullity}(A)=3$" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{5} \\\\ \\text{dim(Col}(A)) &=5=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false.  Since $A$ has $2$ pivot columns, we have $\\text{rank}(A)=2.$\n\n- Statement II is false. For the matrix $A,$ the number of the columns is $n=5.$ Now, since $\\text{rank}(A)\\ne 5,$ then by the invertible matrix theorem, we have that $A$ is not invertible.\n\n- Statement III is true. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 2+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the correct answer is \" III only.\""}] [{:db/id #edb/ref 17592186490316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298c6536-dd07-5d51-8c18-8ca670439c0d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186489607} {:answer/id #uuid "37b42792-707d-5224-838b-cff46365c833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186489639} {:answer/id #uuid "5ec0644e-4274-5048-9b84-1b7e49ed7bcf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186489741} {:answer/id #uuid "d4a192c7-d581-5aec-87a2-1e74c429a5b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186489985} {:answer/id #uuid "df796ca4-fa04-56be-ad9e-bc125d4ef4a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186490000}] :answer-field/correct {:db/id #edb/ref 17592186489639} :answer-field/id #uuid "8ea1ac60-40da-5758-9bc0-142c36f8f6ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490155}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3a4804f-9ed9-56b0-80c9-162f94bd57af" :question/math-academy-id "q-79411" :question/problem "Which of the following statements are true given that $A$ is a $6\\times 6$ matrix which has exactly $2$ non-pivot columns?\n\nI. $A$ is  invertible\n\nII. $\\text{rank}(A)=2$\n\nIII. $\\text{nullity}(A)=2$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{6} \\\\ \\text{dim(Col}(A)) &=6=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $A$ has $n=6$ columns and $2$ of them are non-pivot ones, it follows that    \n\n$$\n\\text{dim(Col}(A))=6-2=4\\ne 6.\n$$\n\n Thus, according to the invertible matrix theorem $A$ can't be an invertible matrix.\n\n- Statement II is false. Since $\\text{dim(Col}(A))=4$,  then $\\text{rank}(A)=4.$\n\n- Statement III is true. Indeed, since $n=6$, according to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186490326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2624dee0-0e9d-5954-b17a-630c9c03b623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186489599} {:answer/id #uuid "4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186489703} {:answer/id #uuid "76d6b8cf-388a-5474-aaf8-b2cb995a67ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186489789} {:answer/id #uuid "8879e74f-52fc-547b-ac4e-229ffb4a243b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186489826} {:answer/id #uuid "94b18bfb-620b-57f0-83d6-6c6dd32ac223" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186489849}] :answer-field/correct {:db/id #edb/ref 17592186489703} :answer-field/id #uuid "de313b80-7984-512b-bdaf-802f9aba6f00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490190}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa527559-21f3-5088-ac1e-a7d1439bef18" :question/math-academy-id "q-142483" :question/problem "Consider a $8\\times 8$ matrix $A.$ If $\\text{rank}(A)=5$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 5+\\text{nullity}(A) & =8 \\\\ \\text{nullity}(A) & =8-5 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3065f796-1624-588c-ad6c-8dc59c6f240e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186489622} {:answer/id #uuid "4da61d62-968c-5325-878b-c10d9e629b68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186489698} {:answer/id #uuid "50c964b1-c602-5d5d-919e-df6c10f9af08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186489708} {:answer/id #uuid "a98b8437-83a6-540a-b465-549d1e82c697" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186489887} {:answer/id #uuid "d659b67d-8b6a-563d-897b-d4779a52e317" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186489990}] :answer-field/correct {:db/id #edb/ref 17592186489708} :answer-field/id #uuid "7e63c75a-0e87-5ea0-8fd9-4a7908e3c449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb06ba3d-1b9f-5681-af01-0922516167aa" :question/math-academy-id "q-142484" :question/problem "Consider a $8\\times 10$ matrix $A.$ If $\\text{rank}(A)=7$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=10.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 7+\\text{nullity}(A) & =10 \\\\ \\text{nullity}(A) & =10-7 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c122c68-ba85-506a-9b5d-b7e8d41f11b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186492400} {:answer/id #uuid "90746f9d-5a52-5223-86f2-eebad7cce602" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186492502} {:answer/id #uuid "a00e12c1-efd1-5bb1-8807-973d94c98793" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186492536} {:answer/id #uuid "af7e5af6-3e33-5368-823c-3062f7002694" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186492568} {:answer/id #uuid "fcccf2b5-4696-5f4a-92c9-3b29f694860e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186492701}] :answer-field/correct {:db/id #edb/ref 17592186492568} :answer-field/id #uuid "83ab4b9b-dc34-5dc7-8a1e-ba7fb0076d92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22d64530-5ce7-515c-aafe-c528e2fc812f" :question/math-academy-id "q-74834" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ 2x-7y &=0 \\\\ -4x+15y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\n\nII. The system has no solution\n\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -4 & -1 \\\\ 2 & -7 & 0 \\\\ -4 & 15 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ -4 & 15 & 2\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & -1 & -2\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-1 \\\\ y &=2.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=2$ and substituting this into the first equation yields $x=7.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186492874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7b0d87-9712-510c-adb7-5bde077204da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=10" :db/id #edb/ref 17592186492235} {:answer/id #uuid "58ea3fc2-519f-5eea-8c33-6dce5b9c6e3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=8" :db/id #edb/ref 17592186492389} {:answer/id #uuid "8133480e-57da-5ca9-9bce-a1b99fc82856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=7" :db/id #edb/ref 17592186492477} {:answer/id #uuid "a85d27da-01e0-5767-a1e4-b5479a5241b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=5" :db/id #edb/ref 17592186492558} {:answer/id #uuid "da15d75f-b174-5630-b7ee-c26933c1301a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=6" :db/id #edb/ref 17592186492646}] :answer-field/correct {:db/id #edb/ref 17592186492477} :answer-field/id #uuid "df2effb2-e366-52f0-a14b-bc202d0cbc2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492799}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7409a043-b196-5341-8318-5b111a0c527e" :question/math-academy-id "q-131725" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ -4x+(k-5)y &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ -4 & k-5 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ 0 & k-7 & 5\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k-7)y &=5.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"}] [{:db/id #edb/ref 17592186514369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e651fca-df91-5a95-892f-780cef22a6df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186513611} {:answer/id #uuid "b85887ad-503b-5a31-9a5f-ed5afa3bbe07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186514018} {:answer/id #uuid "e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186514143} {:answer/id #uuid "f606c8f4-0164-5bb8-968e-6ee4d224953a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186514173} {:answer/id #uuid "f88ff125-ed18-5a84-bda5-936ae6d644fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186514181}] :answer-field/correct {:db/id #edb/ref 17592186514143} :answer-field/id #uuid "3235286d-76ea-568e-a9be-0249cc7ffbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514244}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13976613-adec-5296-be7c-cccd907c4b03" :question/math-academy-id "q-42998" :question/problem "Find $det({A}^{-1})$, if $$\n\\displaystyle A=\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}-2 & 1 \\\\ 4 & 3\\end{bmatrix} \\\\  & =-6-4 \\\\  & =-10\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=-\\frac{1}{10}.\n$$"}]}
