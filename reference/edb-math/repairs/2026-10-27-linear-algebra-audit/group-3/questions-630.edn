6100} :answer-field/id #uuid "94e9c210-4a7c-5634-b0b7-886274bcf058" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186646233}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1814757d-bb0f-5f0a-9169-b4f613cdbbfb" :question/math-academy-id "q-70952" :question/problem "Let $G=HJ.$ What is the value of ${g}_{31}$, if\n\n$$\nH=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & -2 & 1 \\\\ 2 & 0 & -1 \\\\ 1 & 2 & 0\\end{bmatrix},\\,J=\\begin{bmatrix}3 & -1 \\\\ -1 & 5 \\\\ -4 & 2\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $3$rd row of $H$ by the $1$st column of $J$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & -2 & 1 \\\\ 2 & 0 & -1 \\\\ 1 & 2 & 0\\end{bmatrix}\\begin{bmatrix}3 & -1 \\\\ -1 & 5 \\\\ -4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -1 \\\\ -4\\end{bmatrix} \\\\  & =2\\cdot 3+0\\cdot (-1)+(-1)\\cdot (-4) \\\\  & =6+0+4 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186647010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22c17fbc-9ac0-5bff-8f1d-4b3a9035be30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186646476}] :answer-field/correct {:db/id #edb/ref 17592186646476} :answer-field/id #uuid "487f4946-6601-51e0-85a7-2026b2356e9a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646929}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "09ddb40e-a04f-502b-831d-9899e7155ce3" :question/math-academy-id "q-318464" :question/problem "Let $A=BC.$ What is the value of ${a}_{23}$, if\n\n$$\nB=\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 0 & 3 \\\\ 4 & 5 & -1\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 2 & 1 \\\\ 3 & -1 & 4 \\\\ -2 & 5 & 0\\end{bmatrix}?\n$$\n\n${a}_{23}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $B$ by the $3$rd column in $C$, we get\n\n$$\n\\begin{aligned}{a}_{23} & =\\begin{bmatrix}1 & -1 & 2 \\\\ -2 & 0 & 3 \\\\ 4 & 5 & -1\\end{bmatrix}\\begin{bmatrix}0 & 2 & 1 \\\\ 3 & -1 & 4 \\\\ -2 & 5 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 0 & 3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 4 \\\\ 0\\end{bmatrix} \\\\  & =(-2)(1)+0(4)+3(0) \\\\  & =-2+0+0 \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186647013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "300c7ee6-f8c2-5550-9c51-c22d8ed0834f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-15 \\\\ -1 \\\\ -18\\end{bmatrix}" :db/id #edb/ref 17592186646503} {:answer/id #uuid "6159ee3b-79a5-586b-95d9-4e2cecd243c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-15 & 0 \\\\ -1 & \\frac{1}{3} \\\\ -18 & 0\\end{bmatrix}" :db/id #edb/ref 17592186646597} {:answer/id #uuid "671278e4-8cb1-50ea-8eeb-19644f9ebd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-15 & 0 \\\\ -1 & 0 \\\\ -18 & 0\\end{bmatrix}" :db/id #edb/ref 17592186646612} {:answer/id #uuid "72a64f85-a60c-50f5-bc99-2fdc6a10b0c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-15 & 0 \\\\ -18 & 0\\end{bmatrix}" :db/id #edb/ref 17592186646633} {:answer/id #uuid "a5b04ab9-74f5-54f5-afcc-a39aafacfa00" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186646731}] :answer-field/correct {:db/id #edb/ref 17592186646612} :answer-field/id #uuid "9d68016e-ec17-557d-b48b-bc411b1bf2b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186646967}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c885f3c-f7ac-58fc-a133-ab1031b19332" :question/math-academy-id "q-1036" :question/problem "$$\n\\displaystyle \\begin{bmatrix}5 \\\\ \\frac{1}{3} \\\\ 6\\end{bmatrix}\\begin{bmatrix}-3 & 0\\end{bmatrix}=\n$$" :question/worked-solution "Here, the first factor is a $3\\times 1$ matrix and the second factor is a $1\\times 2$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n3\\times \\boxed{\\text{1}}✓\\boxed{\\text{1}}\\times 2=3\\times 2\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 \\\\ \\frac{1}{3} \\\\ 6\\end{bmatrix}\\begin{bmatrix}-3 & 0\\end{bmatrix} & =\\begin{bmatrix}5\\cdot (-3) & 5\\cdot 0 \\\\ \\frac{1}{3}\\cdot (-3) & \\frac{1}{3}\\cdot 0 \\\\ 6\\cdot (-3) & 6\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-15 & 0 \\\\ -1 & 0 \\\\ -18 & 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186647044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd177de-c030-50b4-a605-6e5fe0df8140" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186646651}] :answer-field/correct {:db/id #edb/ref 17592186646651} :answer-field/id #uuid "854a374f-5958-5a14-bb51-eb8d55caa831" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646958}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "485b2cd5-2903-511a-a83b-a078a2197cb2" :question/math-academy-id "q-318471" :question/problem "Let $R=PQ.$ What is the value of ${r}_{42}$, if\n\n$$\nP=\\begin{bmatrix}-1 & 3 \\\\ 0 & -2 \\\\ 5 & 1 \\\\ 2 & -4\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 2 \\\\ -3 & 0\\end{bmatrix}?\n$$\n\n${r}_{42}=$\n{{field-1}}" :question/worked-solution "Multiplying the $4$th row in $P$ by the $2$nd column in $Q,$ we get\n\n$$\n\\begin{aligned}{r}_{42} & =\\begin{bmatrix}-1 & 3 \\\\ 0 & -2 \\\\ 5 & 1 \\\\ 2 & -4\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -4\\end{bmatrix}\\begin{bmatrix}2 \\\\ 0\\end{bmatrix} \\\\  & =2(2)+(-4)(0) \\\\  & =4+0 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186647103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a49fdcaa-b661-58da-839d-d7240de22f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186646728}] :answer-field/correct {:db/id #edb/ref 17592186646728} :answer-field/id #uuid "0914d663-7f25-517f-b1ec-12059f1a87a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646899} {:answer-field/choices [{:answer/id #uuid "67bb63df-9b84-5830-a6ee-64cdec6e5409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186646613}] :answer-field/correct {:db/id #edb/ref 17592186646613} :answer-field/id #uuid "0cde3e15-987d-5869-a5c9-66c1761b2dc7" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646902} {:answer-field/choices [{:answer/id #uuid "3e38b909-a69d-59d8-97e9-615ce9686bb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186646531}] :answer-field/correct {:db/id #edb/ref 17592186646531} :answer-field/id #uuid "3e0987ee-1705-5738-9b5c-5faa9c505ccd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646924} {:answer-field/choices [{:answer/id #uuid "a409193f-9647-56cf-b4cb-9ec096ad820f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186646726}] :answer-field/correct {:db/id #edb/ref 17592186646726} :answer-field/id #uuid "a4effca1-75de-5c81-93d8-fc86643e3300" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186646970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fdf2798f-d6ef-5f5d-8526-bc9120a1291a" :question/math-academy-id "q-318506" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle B=\\begin{bmatrix}-2 & 3\\end{bmatrix},\n$$\nfind $AB.$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$AB=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}12 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,12=-6\\cdot (-2) \\\\  & \\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}12 & -18 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-18=-6\\cdot 3 \\\\  & \\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}12 & -18 \\\\ -2 & ∗\\end{bmatrix}, &  & \\,-2=1\\cdot (-2) \\\\  & \\begin{bmatrix}-6 \\\\ 1\\end{bmatrix}\\begin{bmatrix}-2 & 3\\end{bmatrix}=\\begin{bmatrix}12 & -18 \\\\ -2 & 3\\end{bmatrix}, &  & \\,3=1\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle AB=\\begin{bmatrix}12 & -18 \\\\ -2 & 3\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186660325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fa2427-a806-5340-85c6-0e6495cfeb21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186659833} {:answer/id #uuid "10c47acf-e5a2-5b77-b9fa-a4a7308019e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186659861} {:answer/id #uuid "29e25e0b-1aee-5847-91ab-60dd2edd696e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-2){R}_{2}" :db/id #edb/ref 17592186659894} {:answer/id #uuid "90881ba0-18fb-5895-b9e2-9c7c7d22bea8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=-2{R}_{1}" :db/id #edb/ref 17592186660044} {:answer/id #uuid "9f146183-228c-5263-a6c8-63493c4c4eac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=2{R}_{1}" :db/id #edb/ref 17592186660071}] :answer-field/correct {:db/id #edb/ref 17592186659861} :answer-field/id #uuid "b82625c9-df9a-50b1-8937-4074e83e2769" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660283}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38dcabe7-7032-5aaf-aa1e-dc730fa0c589" :question/math-academy-id "q-31974" :question/problem "Let $E=\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}.$\n Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by taking the second row of the identity matrix and adding $-2$ times the first row: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying  the\nrow operation ${R}_{2}:={R}_{2}+(-2){R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186660338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b95d2d0-e542-55e1-886e-9402bc5346e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}3 & 0 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186659877} {:answer/id #uuid "434f8410-b24d-52d6-8f62-4c202c542a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{3}{4} & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186659943} {:answer/id #uuid "83065b19-9e68-5a00-8edd-d2ba560ea1f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186660023} {:answer/id #uuid "afbb829b-6a9e-5d9b-8b96-39b519d94916" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{3}{4}\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186660102} {:answer/id #uuid "e3e6afe3-de20-50d6-a38f-7d21818c9c9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186660168}] :answer-field/correct {:db/id #edb/ref 17592186660168} :answer-field/id #uuid "c3f8e470-d495-59aa-adcf-632c5cb98628" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660288}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "591ef521-e91b-5ac2-95ab-4648d366063a" :question/math-academy-id "q-32012" :question/problem "Suppose we are applying the elementary row operation ${R}_{1}:=\\frac{3}{4}{R}_{1}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:=\\frac{3}{4}{R}_{1}$ to $A.$ \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :=\\frac{3}{4}{R}_{1} \\\\  & ∼\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}\\frac{3}{4} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186660386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab619e1f-ed35-50d1-be56-df3847f97af7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186660092} {:answer/id #uuid "aedf1ecd-4ac5-5d72-88bf-d8fae4e11cdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186660099} {:answer/id #uuid "c9c8eb1b-5921-5931-a589-c1012ab61f7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186660132} {:answer/id #uuid "e7bcd3ce-b141-55d4-a986-8956f53221de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186660177} {:answer/id #uuid "ea45a1cf-11dc-5e02-8d18-d4cea6056077" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186660181}] :answer-field/correct {:db/id #edb/ref 17592186660181} :answer-field/id #uuid "a1ec187b-fb09-5122-b5a5-998d9932f700" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660274}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ea5376de-e9a1-536f-8c2c-7db85824da02" :question/math-academy-id "q-32013" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{1}↔{R}_{2},\\,{R}_{1}={R}_{1}+3{R}_{2},\\,{R}_{1}=4{R}_{1}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{1}={R}_{1}+3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}={R}_{1}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third elementary row operation is ${R}_{1}=4{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}=4{R}_{1} \\\\  & ∼\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$ \n\n$$\n\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$\n\n \n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$\n\n$$\n\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186660856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081a7db4-b8e3-5aad-b23f-dd8a6e91b0cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186660473} {:answer/id #uuid "37b77ee0-984b-5887-a0b1-1bdf0b0cea80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186660518} {:answer/id #uuid "8512a03f-08f3-5a5a-b190-48db2708214d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186660617} {:answer/id #uuid "ce926e9d-945d-57b1-9109-c1f981fb58c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186660699} {:answer/id #uuid "d8ad66ca-8bf6-5a23-ac80-2a86b29da1cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186660715}] :answer-field/correct {:db/id #edb/ref 17592186660518} :answer-field/id #uuid "76572e25-9402-5b53-b33c-98421290fbc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660808}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14361c6d-cac3-5b4d-b77b-8d67c1c14fc6" :question/math-academy-id "q-141221" :question/problem "Consider a $4\\times 5$ matrix $A.$ If $\\text{rank}(A)=4$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ee71af-6ea0-54c0-b7a1-4d4f6222b4ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186660487} {:answer/id #uuid "6491a7a0-9bc2-550d-a99a-fe0582392222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186660578} {:answer/id #uuid "9157e22a-668b-5b6d-9536-c10b82429afe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186660631} {:answer/id #uuid "c4ba40e1-e207-53f9-8883-bba851dbac3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186660689} {:answer/id #uuid "ef62df37-2b5c-5348-a5dc-d408cc56e8db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186660747}] :answer-field/correct {:db/id #edb/ref 17592186660578} :answer-field/id #uuid "cd394fcd-18a4-591d-8049-8b37242f4f02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660835}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1b45e803-c138-5bcf-9207-424394814f56" :question/math-academy-id "q-79351" :question/problem "Find $\\text{rank}(A)$ given that $$\n\\displaystyle \\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1}+{x}_{2} \\\\ {x}_{1}-{x}_{2} \\\\ 0 \\\\ {x}_{1} \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}.\n$$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 1 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8ce1c0-5754-5478-bc05-f4802752f757" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186660507} {:answer/id #uuid "3c48ff84-2124-59af-8a59-2b7a50149883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186660523} {:answer/id #uuid "67619b83-ebe1-5039-afd3-c6baa26f582a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186660580} {:answer/id #uuid "a91da89c-91d1-567c-b8db-da19e57a2d4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186660655} {:answer/id #uuid "b1dedd03-7ad7-503a-91ab-2c0775009362" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186660674}] :answer-field/correct {:db/id #edb/ref 17592186660580} :answer-field/id #uuid "2b179eb0-7ccd-5526-9967-9696806ef586" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660781}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "419374b5-8846-5602-9c56-203ab6362cc4" :question/math-academy-id "q-142482" :question/problem "Consider a $8\\times 9$ matrix $A.$ If $\\text{rank}(A)=6$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=9.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 6+\\text{nullity}(A) & =9 \\\\ \\text{nullity}(A) & =9-6 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186660883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290b0c77-d60f-54bf-937a-d056c4f84be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186660505} {:answer/id #uuid "b94d1e34-ae18-5f78-986f-551fa069351e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186660680} {:answer/id #uuid "d580f223-91ec-52c6-8b44-d6b4b604c1e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186660710} {:answer/id #uuid "dad592c2-ff97-544e-bd2e-d272e249c227" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186660720} {:answer/id #uuid "f118edb7-d3a0-5a71-8681-0a49db16ed62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186660751}] :answer-field/correct {:db/id #edb/ref 17592186660505} :answer-field/id #uuid "ffbb6650-9286-560d-8cd6-3068e961c9dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186660851}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7e28e70a-8db7-56d6-8e9d-6424a558b67a" :question/math-academy-id "q-141190" :question/problem "Consider a $6\\times 6$ matrix $A.$ If $\\text{dim(Null(}A))=4,$ then $\\text{rank}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+4 & =6 \\\\ \\text{rank}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a9affe-37d3-5ef6-b2de-c9034eba2368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186661095} {:answer/id #uuid "5ad0cc8e-3535-5925-8b5a-acfb42667c38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186661148} {:answer/id #uuid "631e1428-80ba-5cc3-8b4b-66af07e773a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186661157} {:answer/id #uuid "b201e6de-9673-58cb-8e68-3eaf607c62dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186661284} {:answer/id #uuid "b7ad602f-da53-54b3-87c2-13f76e2afdd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186661292}] :answer-field/correct {:db/id #edb/ref 17592186661284} :answer-field/id #uuid "f6ac9d9d-8d85-5328-80be-563c06a94fe9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186661480}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2fe3d80d-e926-5e26-9854-5c7da0ce248e" :question/math-academy-id "q-132136" :question/problem "Calculate the value of \n$$\n\\displaystyle \\,\\begin{vmatrix}1 & 2 & 5 & 4 \\\\ 3 & -9 & 5 & -3 \\\\ 1 & -3 & 4 & -2 \\\\ -3 & 9 & -7 & 4\\end{vmatrix}.\n$$\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{31}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{31}=1$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 2 & 5 & 4 \\\\ 3 & -9 & 5 & -3 \\\\ 1 & -3 & 4 & -2 \\\\ -3 & 9 & -7 & 4\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{1}: &={R}_{1}+(-1){R}_{3} \\\\ {R}_{2}: &={R}_{2}+(-3){R}_{3} \\\\ {R}_{4}: &={R}_{4}+3{R}_{3}\\end{aligned} \\\\  & =\\begin{vmatrix}0 & 5 & 1 & 6 \\\\ 0 & 0 & -7 & 3 \\\\ 1 & -3 & 4 & -2 \\\\ 0 & 0 & 5 & -2\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $1$st column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}0 & 5 & 1 & 6 \\\\ 0 & 0 & -7 & 3 \\\\ 1 & -3 & 4 & -2 \\\\ 0 & 0 & 5 & -2\\end{vmatrix} \\\\  & =1\\cdot (-1)^{3+1}\\begin{vmatrix}5 & 1 & 6 \\\\ 0 & -7 & 3 \\\\ 0 & 5 & -2\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & 1 & 6 \\\\ 0 & -7 & 3 \\\\ 0 & 5 & -2\\end{vmatrix} \\\\  & =5\\cdot (-1)^{1+1}\\begin{vmatrix}-7 & 3 \\\\ 5 & -2\\end{vmatrix} \\\\  & =5(14-15) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d94a362-9dc4-5e5e-81fd-2aa979bd1e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}10 & -7 & -13 \\\\ -8 & 7 & 9 \\\\ 1 & 7 & 8\\end{vmatrix}" :db/id #edb/ref 17592186660996} {:answer/id #uuid "22421478-c94f-51ea-a405-53dc73d3a813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}1 & -4 & -3 \\\\ 3 & -3 & 1 \\\\ -2 & 3 & 2\\end{vmatrix}" :db/id #edb/ref 17592186661033} {:answer/id #uuid "2588adca-8cde-5b90-b7b2-c5fc602d98a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}-1 & -4 & -3 \\\\ 3 & 3 & 2 \\\\ 5 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186661040} {:answer/id #uuid "554ece15-2bd3-576e-a189-0f4660f3483c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}10 & -7 & -13 \\\\ -8 & 7 & 1 \\\\ 3 & 5 & 7\\end{vmatrix}" :db/id #edb/ref 17592186661137} {:answer/id #uuid "8e20373e-6501-5bd7-8faa-91a5e00f72d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}1 & -1 & -3 \\\\ -2 & 3 & 2 \\\\ 4 & 5 & 1\\end{vmatrix}" :db/id #edb/ref 17592186661214}] :answer-field/correct {:db/id #edb/ref 17592186660996} :answer-field/id #uuid "76f7f86e-6bce-5c2d-8d94-6994a1d52d4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186661438}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6cee631a-06ec-5fca-a936-d1b9d8519ca7" :question/math-academy-id "q-91198" :question/problem "$$\n\\begin{vmatrix}1 & -1 & -4 & -3 \\\\ 3 & -2 & -3 & 1 \\\\ -2 & 3 & 3 & 2 \\\\ 4 & 5 & 5 & 1\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left of ${a}_{24}$ equal to zero.*" :question/worked-solution "Let's make entries to the left of ${a}_{24}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & -1 & -4 & -3 \\\\ 3 & -2 & -3 & 1 \\\\ -2 & 3 & 3 & 2 \\\\ 4 & 5 & 5 & 1\\end{vmatrix} &  & \\,\\begin{aligned}{C}_{1}: &={C}_{1}+(-3){C}_{4} \\\\ {C}_{2}: &={C}_{2}+2{C}_{4} \\\\ {C}_{3}: &={C}_{3}+3{C}_{4}\\end{aligned} \\\\  & =\\begin{vmatrix}10 & -7 & -13 & -3 \\\\ 0 & 0 & 0 & 1 \\\\ -8 & 7 & 9 & 2 \\\\ 1 & 7 & 8 & 1\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}10 & -7 & -13 & -3 \\\\ 0 & 0 & 0 & 1 \\\\ -8 & 7 & 9 & 2 \\\\ 1 & 7 & 8 & 1\\end{vmatrix} \\\\  & =1\\cdot (-1)^{2+4}\\begin{vmatrix}10 & -7 & -13 \\\\ -8 & 7 & 9 \\\\ 1 & 7 & 8\\end{vmatrix} \\\\  & =\\begin{vmatrix}10 & -7 & -13 \\\\ -8 & 7 & 9 \\\\ 1 & 7 & 8\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186661540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51d2d6af-e5b4-5a80-b9f4-d2b2b9315526" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\begin{vmatrix}3 & 1 & -1 \\\\ -4 & 3 & 1 \\\\ -1 & 8 & 3\\end{vmatrix}" :db/id #edb/ref 17592186661128} {:answer/id #uuid "650d1f26-59ef-5668-870b-2424555a81f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\begin{vmatrix}5 & 6 & 3 \\\\ -7 & -9 & 5 \\\\ -9 & -3 & -1\\end{vmatrix}" :db/id #edb/ref 17592186661159} {:answer/id #uuid "8f4c6ab7-1ba4-5784-91f9-f38bd697484c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\begin{vmatrix}1 & 2 & 2 \\\\ 5 & 5 & 3 \\\\ -7 & -3 & 5\\end{vmatrix}" :db/id #edb/ref 17592186661215} {:answer/id #uuid "ab0810c0-6fd4-58a8-94b6-7c8886ad9672" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\begin{vmatrix}3 & 1 & -1 \\\\ -4 & 3 & 11 \\\\ -8 & 0 & 1\\end{vmatrix}" :db/id #edb/ref 17592186661267} {:answer/id #uuid "d2d3166b-6c4c-5ed2-b0d9-a59a62a35132" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\begin{vmatrix}5 & 6 & 3 \\\\ -3 & -9 & 5 \\\\ -2 & -3 & -1\\end{vmatrix}" :db/id #edb/ref 17592186661329}] :answer-field/correct {:db/id #edb/ref 17592186661267} :answer-field/id #uuid "f7f39fde-67f1-56ee-9c92-9d0b5fb643f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186661481}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94e9c65d-2d6c-5983-85c8-dbf5c7cef18f" :question/math-academy-id "q-91175" :question/problem "$$\n\\begin{vmatrix}1 & 2 & 3 & 2 \\\\ 5 & 5 & 6 & 3 \\\\ -7 & -3 & -9 & 5 \\\\ -9 & -2 & -3 & -1\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries below ${a}_{13}$ equal to zero.*" :question/worked-solution "Let's make entries below ${a}_{13}=3$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 2 & 3 & 2 \\\\ 5 & 5 & 6 & 3 \\\\ -7 & -3 & -9 & 5 \\\\ -9 & -2 & -3 & -1\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{2}: &={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}: &={R}_{3}+3{R}_{1} \\\\ {R}_{4}: &={R}_{4}+{R}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}1 & 2 & 3 & 2 \\\\ 3 & 1 & 0 & -1 \\\\ -4 & 3 & 0 & 11 \\\\ -8 & -0 & 0 & 1\\end{vmatrix}\\end{aligned}\n$$\n\nExpanding the result along the $3$rd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 2 & 3 & 2 \\\\ 3 & 1 & 0 & -1 \\\\ -4 & 3 & 0 & 11 \\\\ -8 & 0 & 0 & 1\\end{vmatrix} \\\\  & =3\\cdot (-1)^{1+3}\\begin{vmatrix}3 & 1 & -1 \\\\ -4 & 3 & 11 \\\\ -8 & 0 & 1\\end{vmatrix} \\\\  & =3\\begin{vmatrix}3 & 1 & -1 \\\\ -4 & 3 & 11 \\\\ -8 & 0 & 1\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186672450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e26d0b-707b-5d9c-8e09-e116855bbe42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672439} {:answer/id #uuid "b4e18cbd-85bd-569e-bb51-71ca318aad90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672476}] :answer-field/correct {:db/id #edb/ref 17592186672476} :answer-field/id #uuid "28651d72-c06e-56c0-a175-73b31a3c9afb" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672448} {:answer-field/choices [{:answer/id #uuid "87c5b294-7310-5511-bf00-5ac4ff9593a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672466} {:answer/id #uuid "8cc25d53-fd2a-5639-aa44-da2ab89587a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672470}] :answer-field/correct {:db/id #edb/ref 17592186672470} :answer-field/id #uuid "35a4a927-0607-5827-b062-f3254e5c80a8" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672451} {:answer-field/choices [{:answer/id #uuid "38fb1c45-5e8b-5c86-aa64-b1650068a4df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672453} {:answer/id #uuid "836066b8-7eef-5b5b-80ee-5ef95bf02288" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672464}] :answer-field/correct {:db/id #edb/ref 17592186672453} :answer-field/id #uuid "9fdce7dc-68d9-5c9a-9737-c8cf33d56bca" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672473}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32cdb33c-5637-59fc-8a01-d05ed6dad373" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x+5y &=-11 \\\\ -x+2y &=-4 \\\\ x-3y &=7\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}-2 & 5 & -11 \\\\ -1 & 2 & -4 \\\\ 1 & -3 & 7\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}-2 & 5 & -11 \\\\ -1 & 2 & -4 \\\\ 1 & -3 & 7\\end{array}\\right] & {R}_{1}↔{R}_{2} \\\\ & ∼\\left[\\begin{array}{cc|c}-1 & 2 & -4 \\\\ -2 & 5 & -11 \\\\ 1 & -3 & 7\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}-1 & 2 & -4 \\\\ 0 & 1 & -3 \\\\ 1 & -3 & 7\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}-1 & 2 & -4 \\\\ 0 & 1 & -3 \\\\ 0 & -1 & 3\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\ & ∼\\left[\\begin{array}{cc|c}-1 & 2 & -4 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThere is a pivot for each variable and no contradictory row. The system has a unique solution, so we conclude that the system is consistent independent.\n\nAs a result, select: The system is consistent independent."}] [{:db/id #edb/ref 17592186672467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b34a96-9597-5e33-ae99-a43e3776f5fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672438} {:answer/id #uuid "de0743a1-c3b0-5a53-9010-eb971d542c4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672488}] :answer-field/correct {:db/id #edb/ref 17592186672488} :answer-field/id #uuid "57e68633-b84e-518f-bff2-a73d5f130307" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672460} {:answer-field/choices [{:answer/id #uuid "18c6eb44-9f10-5111-85e0-00d8b79c6e33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672443} {:answer/id #uuid "c7a50776-61f8-5a8e-b5fe-1a9b47dd27c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672481}] :answer-field/correct {:db/id #edb/ref 17592186672481} :answer-field/id #uuid "a96a2964-fd05-57f0-b621-f9c8c819b64f" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672474} {:answer-field/choices [{:answer/id #uuid "397f0cf0-854f-5ad5-923d-92d976f023e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672454} {:answer/id #uuid "8c348bf5-74d0-52c5-913f-09ceaeae0b02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672469}] :answer-field/correct {:db/id #edb/ref 17592186672469} :answer-field/id #uuid "cad5a0d3-219c-59e6-ad2f-8885dde97589" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672482}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8af5dfcd-793c-58a3-ab83-cbf7376d71b5" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x+y+3z &=4 \\\\ x-\\frac{1}{2}y-\\frac{3}{2}z &=-5\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 1 & 3 & 4 \\\\ 1 & -\\frac{1}{2} & -\\frac{3}{2} & -5\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}-2 & 1 & 3 & 4 \\\\ 1 & -\\frac{1}{2} & -\\frac{3}{2} & -5\\end{array}\\right] & {R}_{2}:={R}_{2}+\\left(\\frac{1}{2}\\right){R}_{1} \\\\ & ∼\\left[\\begin{array}{ccc|c}-2 & 1 & 3 & 4 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nA row corresponds to the equation $0x+0y+0z=-3,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, select: The system is inconsistent."}] [{:db/id #edb/ref 17592186672468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0d09bf-d343-5a4d-9238-a9ceb31638ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672458} {:answer/id #uuid "650f0d58-af2d-53b6-a1c2-220360ccbe18" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672462}] :answer-field/correct {:db/id #edb/ref 17592186672462} :answer-field/id #uuid "2380161b-b59e-5db4-9912-a328ceb92ebb" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672447} {:answer-field/choices [{:answer/id #uuid "9c53e85e-76f1-5a43-b51b-86a6a8086938" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672472} {:answer/id #uuid "f5cf300d-42e3-5fdc-a667-a1d32631a84d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672490}] :answer-field/correct {:db/id #edb/ref 17592186672490} :answer-field/id #uuid "2fcdf00d-5c37-5043-82f9-cd3bd17e17a0" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672449} {:answer-field/choices [{:answer/id #uuid "c470e5a9-8485-5fb3-9008-4c4332621c2c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672479} {:answer/id #uuid "d3ec8105-cda2-535b-893c-c7b98fd85203" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672484}] :answer-field/correct {:db/id #edb/ref 17592186672479} :answer-field/id #uuid "51dbd002-9caa-59e9-8986-f6bf6a9143cf" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672459} {:answer-field/choices [{:answer/id #uuid "49bff5e4-7aa9-50b9-acc1-0c2ef4e81bcd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672456} {:answer/id #uuid "d9db5460-05c5-50b8-b33e-2caadfb58905" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672486}] :answer-field/correct {:db/id #edb/ref 17592186672456} :answer-field/id #uuid "c5cd8eb8-8434-5295-ba1c-693339b0f238" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672480}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8bda5cea-f321-5119-aab4-e354ad5d9899" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x+y &=3 \\\\ 6x+3y &=9 \\\\ -4x-2y &=-6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 6 & 3 & 9 \\\\ -4 & -2 & -6\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 6 & 3 & 9 \\\\ -4 & -2 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 0 & 0 & 0 \\\\ -4 & -2 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}2 & 1 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThere is one free variable, $y$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, select: The system is consistent dependent."}] [{:db/id #edb/ref 17592186672483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13af2fa2-ef22-5fae-a4ea-b4c3661438fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672441} {:answer/id #uuid "1ebb0168-fbc6-560b-a024-c9456c2195fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672444}] :answer-field/correct {:db/id #edb/ref 17592186672444} :answer-field/id #uuid "4a9a8084-e54c-57a6-a187-6f709b15c316" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672457} {:answer-field/choices [{:answer/id #uuid "22f09fd4-8a17-5f77-8aaa-7b4cac2d2f39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672446} {:answer/id #uuid "b8e12768-44ff-54e4-924f-2c9e85ef4820" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672477}] :answer-field/correct {:db/id #edb/ref 17592186672477} :answer-field/id #uuid "9310d490-05df-5094-a5e9-b8751fe630df" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672471} {:answer-field/choices [{:answer/id #uuid "1fea03a7-6313-5fae-a6ee-e5eef7fddf62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672445} {:answer/id #uuid "7189a9ab-e796-530d-8bd0-36cd55affcba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672463}] :answer-field/correct {:db/id #edb/ref 17592186672445} :answer-field/id #uuid "c11886bd-2ff0-5400-a530-d8043ec17846" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672478}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ce349286-3078-503c-a3d7-b0ae10d0caf1" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-2x-y-2z &=1 \\\\ x+\\frac{1}{2}y+z &=\\frac{1}{2}\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & -1 & -2 & 1 \\\\ 1 & \\frac{1}{2} & 1 & \\frac{1}{2}\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}-2 & -1 & -2 & 1 \\\\ 1 & \\frac{1}{2} & 1 & \\frac{1}{2}\\end{array}\\right] & {R}_{2}:={R}_{2}+\\left(\\frac{1}{2}\\right){R}_{1} \\\\ & ∼\\left[\\begin{array}{ccc|c}-2 & -1 & -2 & 1 \\\\ 0 & 0 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nA row corresponds to the equation $0x+0y+0z=1,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, select: The system is inconsistent."}] [{:db/id #edb/ref 17592186672487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87a3666d-8fac-56a4-818f-b9ba41e732a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672465} {:answer/id #uuid "af2ef084-2e1d-514a-ad82-04a9770f76d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672475}] :answer-field/correct {:db/id #edb/ref 17592186672475} :answer-field/id #uuid "1712a8b0-cb38-5d4e-a8ef-ccb6dc5d65d2" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672442} {:answer-field/choices [{:answer/id #uuid "5c5ae8f0-aff2-537f-bd54-bdc616911c8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672461} {:answer/id #uuid "de9ec4b0-ff6f-59a9-9b06-b271a53c7c7a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672489}] :answer-field/correct {:db/id #edb/ref 17592186672489} :answer-field/id #uuid "3aff6ca8-a727-5aa8-b36f-a9da1207c747" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672455} {:answer-field/choices [{:answer/id #uuid "06b043d8-05ae-5155-b0cb-cc55c923b591" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186672440} {:answer/id #uuid "35fbc521-76bc-549c-bad8-c826794745e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186672452}] :answer-field/correct {:db/id #edb/ref 17592186672452} :answer-field/id #uuid "d425eb1e-183b-55aa-b38e-7c4895fd163a" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186672485}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ddd43cac-6ae5-546e-b0db-53cfc8607617" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=0 \\\\ x-y &=0 \\\\ x-y &=0\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -3 & 0 \\\\ 1 & -1 & 0 \\\\ 1 & -1 & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}3 & -3 & 0 \\\\ 1 & -1 & 0 \\\\ 1 & -1 & 0\\end{array}\\right] & {R}_{1}↔{R}_{2} \\\\ & ∼\\left[\\begin{array}{cc|c}1 & -1 & 0 \\\\ 3 & -3 & 0 \\\\ 1 & -1 & 0\\end{array}\\right] & {R}_{2}:={R}_{2}+(-3){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}1 & -1 & 0 \\\\ 0 & 0 & 0 \\\\ 1 & -1 & 0\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ & ∼\\left[\\begin{array}{cc|c}1 & -1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right] & {R}_{3}:={R}_{3}+\\left(-\\frac{1}{2}\\right){R}_{2} \\\\ & ∼\\left[\\begin{array}{cc|c}1 & -1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThere is one free variable, $y$. Therefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*.\n\nAs a result, select: The system is consistent dependent."}] [{:db/id #edb/ref 17592186672514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5z-3 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672509} {:answer/id #uuid "2c841829-54bc-5dec-8ff2-9cf3ebf4da02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-5 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672510} {:answer/id #uuid "3bcfd52c-d90f-5f20-abe2-50e7e46b69db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-5 \\\\ 2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672513} {:answer/id #uuid "5aa72fb9-733a-5615-abc1-29cadc7f36a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3z-3 \\\\ 2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672518} {:answer/id #uuid "b10d29e3-983c-5645-8076-547fdcfca1d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5z-3 \\\\ 4z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672531}] :answer-field/correct {:db/id #edb/ref 17592186672509} :answer-field/id #uuid "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186672511}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "446bb426-185b-5200-b6db-b7020b61fbe9" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+15z &=-3 \\\\ -2x+5y-35z &=6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ -2 & 5 & -35 & 6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ -2 & 5 & -35 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 5 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+5z &=-3 \\\\ y-5z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-5z-3 \\\\ y &=5z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-5z-3 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186672527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39af486b-84be-58f8-825b-2fa72172319a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5y-4 \\\\ y \\\\ 2\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672512} {:answer/id #uuid "7542f303-28df-5793-a36f-88ceb76973d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2y-2 \\\\ y \\\\ 2\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672523} {:answer/id #uuid "7a660858-41e1-51e0-a2c7-c95ea07132d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2y-2 \\\\ y \\\\ 3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672525} {:answer/id #uuid "91126e15-a29f-5475-b30c-4e052d32d23e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}y-5 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672529} {:answer/id #uuid "b5a58a29-a610-5a34-90b3-f2ff2a2d150a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5y-4 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672534}] :answer-field/correct {:db/id #edb/ref 17592186672529} :answer-field/id #uuid "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186672522}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8805faad-2210-5845-9d51-28bb144681d1" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-y+z &=-8 \\\\ 2x-2y+3z &=-19.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 2 & -2 & 3 & -19\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 2 & -2 & 3 & -19\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 0 & 0 & 1 & -3\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 0 & -5 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=-5 \\\\ z &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $z$, and we have one free variable, $y$. That means we need to find $x$ and $z$ in terms of $y$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=y-5 \\\\ y &=y \\\\ z &=-3,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}y-5 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186672528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5410998f-d23f-5516-830a-8390a4f91ab9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-z-4 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672516} {:answer/id #uuid "5755dfa1-c68b-54cf-a6d1-3071dc214e89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-1 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672517} {:answer/id #uuid "8339a1ff-5c08-56b3-96b5-b386fd988e3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-z+6 \\\\ -5z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672526} {:answer/id #uuid "cf5e0c44-aefa-5a79-87b3-8309bd783595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-1 \\\\ -5z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672539} {:answer/id #uuid "d50c5f05-e908-5f07-b3d4-9cc37031fd70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-z-4 \\\\ -4z+1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672540}] :answer-field/correct {:db/id #edb/ref 17592186672517} :answer-field/id #uuid "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186672530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+2y+3z &=-7 \\\\ -x-y-z &=4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ -1 & -1 & -1 & 4\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ -1 & -1 & -1 & 4\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ 0 & 1 & 2 & -3\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -1 \\\\ 0 & 1 & 2 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-1 \\\\ y+2z &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-1 \\\\ y &=-2z-3 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-1 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186672538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79f58e54-41b6-587a-9d2e-44385101fe4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 5z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672524} {:answer/id #uuid "b2b703ac-4c72-50f7-870c-97a25a13e8f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672532} {:answer/id #uuid "b39971e0-7379-52c4-877a-96d4d3201a22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672533} {:answer/id #uuid "c82b412f-edb1-541c-8856-100f8d2765be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 5z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672537} {:answer/id #uuid "e594b817-7d8c-514c-9a16-3fd1b3742032" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672541}] :answer-field/correct {:db/id #edb/ref 17592186672533} :answer-field/id #uuid "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186672521}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c88342e4-8236-5f70-ad12-bf716689c179" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+y+2z &=-5 \\\\ -2x-y-2z &=6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ -2 & -1 & -2 & 6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ -2 & -1 & -2 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ 0 & 1 & 2 & -4\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & -1 \\\\ 0 & 1 & 2 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x &=-1 \\\\ y+2z &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-1 \\\\ y &=-2z-4 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186672542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f5ee2e-ff11-50e2-826b-9348a6ab569e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5y-4 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672508} {:answer/id #uuid "465ddf68-f324-5407-b26e-541e1ce5b482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672515} {:answer/id #uuid "5eba9f32-f244-5d64-b641-f6e07e477eaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2y+6 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672519} {:answer/id #uuid "60e746a6-fed6-5d84-93f7-d86e324d7677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-y+6 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672520} {:answer/id #uuid "bdaaa831-8fd9-537c-ac73-e66540ddfd38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5y-6 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186672535}] :answer-field/correct {:db/id #edb/ref 17592186672519} :answer-field/id #uuid "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186672536}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y &=12 \\\\ -x-2y &=-6 \\\\ -x-2y &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 4 & 12 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 4 & 12 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ 0 & 0 & 0 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$, and we have one free variable, $y$. That means we need to find $x$ in terms of $y$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2y+6 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2y+6 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186673338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053aa5d5-3c4a-5ec5-bd3b-6d8b5744d679" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186673335} {:answer/id #uuid "5b4b6171-2f2a-5c79-a709-054f94f33f7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186673345} {:answer/id #uuid "abb6cff0-fe8a-530d-8e4f-cf319b4d59aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186673358} {:answer/id #uuid "bb58e131-2a9d-5fdd-8d5f-1729b93c0895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186673359} {:answer/id #uuid "e6f93549-a6ab-593e-8eda-eb3494ff49c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186673366}] :answer-field/correct {:db/id #edb/ref 17592186673366} :answer-field/id #uuid "85951f0b-5328-5e3c-83e7-463cc54fac71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186673353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29dd4e52-7255-5095-87cf-ee16eb0cb137" :question/problem "Let $A$ be a $7\\times 9$ matrix. If $B=\\{{b}_{1}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=9,$ and since $B$ is formed by $1$ vector, $\\text{rank}(A)=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 1+\\text{nullity}(A) & =9 \\\\ \\text{nullity}(A) & =9-1 \\\\ \\text{dim(Null}(A)) & =8.\\end{aligned}\n$$"}]}
