2cc48547c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439552}] :answer-field/correct {:db/id #edb/ref 17592186439551} :answer-field/id #uuid "fd10953c-49e2-5397-a8d6-c07f7f824c40" :answer-field/key "$x=7$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440133} {:answer-field/choices [{:answer/id #uuid "e7f79edc-2997-5309-a8e1-d7e987ae7695" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439553} {:answer/id #uuid "a410470b-bb5c-5e99-9ef1-c4f15f64a1e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439554}] :answer-field/correct {:db/id #edb/ref 17592186439553} :answer-field/id #uuid "d21ddfff-201d-565d-875a-ebc1c438bce9" :answer-field/key "$x=8$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440134}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c642acf-da11-5fe2-a467-6e32aaff486e" :question/math-academy-id "q-130580" :question/problem "Given that the determinant of\n$$\n\\displaystyle \\begin{bmatrix}x & 2x & 3 \\\\ 5 & x & 7 \\\\ 3 & 2 & 1\\end{bmatrix}\n$$\nis $22$, find all the possible values of $x.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}x & 2x & 3 \\\\ 5 & x & 7 \\\\ 3 & 2 & 1\\end{vmatrix} & =x\\begin{vmatrix}x & 7 \\\\ 2 & 1\\end{vmatrix}-2x\\begin{vmatrix}5 & 7 \\\\ 3 & 1\\end{vmatrix}+3\\begin{vmatrix}5 & x \\\\ 3 & 2\\end{vmatrix} \\\\  & =x(x-14)-2x(5-21)+3(10-3x) \\\\  & ={x}^{2}-14x+32x+30-9x \\\\  & ={x}^{2}+9x+30\\end{aligned}\n$$\n\nSince the determinant of the matrix is $22,$ we have:\n\n$$\n\\begin{aligned}{x}^{2}+9x+30 & =22 \\\\ {x}^{2}+9x+8 & =0 \\\\ x & =\\frac{-9\\pm \\sqrt{{9}^{2}-4\\cdot 1\\cdot 8}}{2\\cdot 1} \\\\  & =\\frac{-9\\pm \\sqrt{49}}{2} \\\\  & =\\frac{-9\\pm 7}{2} \\\\  & =-8,-1\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-8$ and $x=-1.$"}] [{:db/id #edb/ref 17592186265941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c93118d-05d2-5c6b-87c7-03b3d0f94d30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}45 & 0 \\\\ 0 & 45\\end{bmatrix}" :db/id #edb/ref 17592186263663} {:answer/id #uuid "8b0d446e-c4b3-5c52-bf36-11e6accb1be3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}45 & 36 \\\\ 36 & 45\\end{bmatrix}" :db/id #edb/ref 17592186264190} {:answer/id #uuid "8b72944c-0abd-5363-81d8-0321d00b871c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264194} {:answer/id #uuid "978b8539-0071-53a5-b6bd-bfd120f218bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}72 & 0 \\\\ 0 & 72\\end{bmatrix}" :db/id #edb/ref 17592186264303} {:answer/id #uuid "fadb6048-46a8-5f65-84e9-1d69721374d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 36 \\\\ -144 & 0\\end{bmatrix}" :db/id #edb/ref 17592186265197}] :answer-field/correct {:db/id #edb/ref 17592186264194} :answer-field/id #uuid "d504a61e-48ce-50a6-8766-6f3e055d4a4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "769bd8c7-2c71-5253-a7d7-b11b68ce46e8" :question/math-academy-id "q-130616" :question/problem "If $T=\\begin{bmatrix}-6 & 3 \\\\ -12 & 6\\end{bmatrix}$, then ${T}^{6}=$" :question/worked-solution "Computing ${T}^{2},$ we have\n\n$$\n\\begin{aligned}{T}^{2} & =T\\cdot T \\\\  & =\\begin{bmatrix}-6 & 3 \\\\ -12 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}-6 & 3 \\\\ -12 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${T}^{2}=O,$ the matrix $T$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${T}^{6}$ quickly, as follows:\n\n$$\n\\begin{aligned}{T}^{6} & ={T}^{2}\\cdot {T}^{4} \\\\  & =O\\cdot {T}^{4} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{T}^{6}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08612547-b005-5392-af1a-df7b474c183f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263076} {:answer/id #uuid "44c75865-eba7-5ea5-899b-6ea970d46b60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186263604} {:answer/id #uuid "540dadca-dfc9-5c4a-a4a7-eb33cde6b83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186263725} {:answer/id #uuid "73317ca7-7b96-518c-af47-8c1a296a0e5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186263999} {:answer/id #uuid "fc9e8555-066d-500b-b643-2c20d52ada5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186265217}] :answer-field/correct {:db/id #edb/ref 17592186263076} :answer-field/id #uuid "f52b9c18-1a55-5825-8634-6431340dd06d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265685}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7e9e0a1f-e62f-537b-9ae4-39884aaf945c" :question/math-academy-id "q-130620" :question/problem "Find the possible values of the constant $x$ given that the matrix $\\begin{bmatrix}3 & 5 & 8 \\\\ 1 & 1 & 2 \\\\ x & -1 & -x\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $x:$ \n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 5 & 8 \\\\ 1 & 1 & 2 \\\\ x & -1 & -x\\end{vmatrix} & =3\\begin{vmatrix}1 & 2 \\\\ -1 & -x\\end{vmatrix}-5\\begin{vmatrix}1 & 2 \\\\ x & -x\\end{vmatrix}+8\\begin{vmatrix}1 & 1 \\\\ x & -1\\end{vmatrix} \\\\  & =3(-x+2)-5(-x-2x)+8(-1-x) \\\\  & =-3x+6+15x-8-8x \\\\  & =4x-2\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}4x-2 & =0 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186265944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "230f8658-c0ec-55d0-a480-24839035e5f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}18 & 0 \\\\ 0 & 18\\end{bmatrix}" :db/id #edb/ref 17592186263308} {:answer/id #uuid "537a84f3-e5d6-5919-8f59-fa68e396bdea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 54 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186263718} {:answer/id #uuid "81a8fd32-3158-5f3a-96c4-bee35c88b641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}18 & 54 \\\\ 6 & 18\\end{bmatrix}" :db/id #edb/ref 17592186264115} {:answer/id #uuid "c48c76a8-87b3-54a5-9957-b4fab1c3eea9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 3 \\\\ -1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186264723} {:answer/id #uuid "e9c6aead-5e9f-5906-9990-0dcf405dc1cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186265033}] :answer-field/correct {:db/id #edb/ref 17592186265033} :answer-field/id #uuid "2df157aa-3ba5-56ae-b49c-932b270763ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265328}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73bc7e3c-0d0e-5c12-afc8-020d832fd510" :question/math-academy-id "q-130621" :question/problem "If $K=\\begin{bmatrix}9 & 27 \\\\ -3 & -9\\end{bmatrix}$, then ${K}^{4}=$" :question/worked-solution "Computing ${K}^{2},$ we have\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =\\begin{bmatrix}9 & 27 \\\\ -3 & -9\\end{bmatrix}\\cdot \\begin{bmatrix}9 & 27 \\\\ -3 & -9\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${K}^{2}=O,$ the matrix $K$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${K}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{K}^{2} & ={K}^{2}\\cdot {K}^{2} \\\\  & =O\\cdot O \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{K}^{4}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21390a7b-0a54-5e9a-9011-c7deff139c41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\frac{5}{2}$ only" :db/id #edb/ref 17592186263297} {:answer/id #uuid "91d75f72-1a96-5644-a529-caf7355ab1bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $p$" :db/id #edb/ref 17592186264249} {:answer/id #uuid "970c8319-2067-5d80-a590-021621a09030" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-3$ and $3$ only" :db/id #edb/ref 17592186264292} {:answer/id #uuid "f080186a-d1c4-58fa-9d1f-db014dd38fcc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-3$ only" :db/id #edb/ref 17592186265109} {:answer/id #uuid "fc1c675c-a294-5ee2-a8ca-549d874e48c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-10$ only" :db/id #edb/ref 17592186265208}] :answer-field/correct {:db/id #edb/ref 17592186264249} :answer-field/id #uuid "a69f31fe-6848-54a7-8e0e-0e1258ee7ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265543}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fee93468-4926-51f6-9486-b49c687c7f2f" :question/math-academy-id "q-130626" :question/problem "Find the possible values of the constant $p$ given that the matrix\n$\\begin{bmatrix}1 & -3p & 4 \\\\ -2 & 6p & -8 \\\\ 1 & -1 & 1\\end{bmatrix}$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & -3p & 4 \\\\ -2 & 6p & -8 \\\\ 1 & -1 & 1\\end{vmatrix} & =1\\begin{vmatrix}6p & -8 \\\\ -1 & 1\\end{vmatrix}-(-3p)\\begin{vmatrix}-2 & -8 \\\\ 1 & 1\\end{vmatrix}+4\\begin{vmatrix}-2 & 6p \\\\ 1 & -1\\end{vmatrix} \\\\  & =(6p-8)+3p(-2+8)+4(2-6p) \\\\  & =6p-8+18p+8-24p \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, this matrix is singular for all values of $p.$"}] [{:db/id #edb/ref 17592186265947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9a7a36-a333-5a73-a6f8-e2d1a0a39a74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{42}" :db/id #edb/ref 17592186263393} {:answer/id #uuid "7d53f47d-a7d0-59bb-b8f8-0e9e0f14d3c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{23}" :db/id #edb/ref 17592186264080} {:answer/id #uuid "9006f4e2-501c-5255-8645-a0e20a8bc8d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{36}" :db/id #edb/ref 17592186264234} {:answer/id #uuid "95412705-5f71-5fb8-8941-52c8f2ca7268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{44}" :db/id #edb/ref 17592186264278} {:answer/id #uuid "cfbd30aa-8f8f-58dc-9aba-c954e828fb31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{46}" :db/id #edb/ref 17592186264820}] :answer-field/correct {:db/id #edb/ref 17592186264820} :answer-field/id #uuid "aa8aa345-1680-55b9-9d85-b18f97d1bceb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265551}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "33302e24-2ebe-5f9a-9cc7-6d4f67c8f493" :question/math-academy-id "q-130629" :question/problem "Find $|{A}^{-1}|,$ if $A=\\begin{bmatrix}-7 & 3 & 5 \\\\ 6 & -4 & 1 \\\\ -2 & 0 & 0\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $3$rd row:\n\n$$\n\\begin{aligned}|A| & =\\begin{vmatrix}-7 & 3 & 5 \\\\ 6 & -4 & 1 \\\\ -2 & 0 & 0\\end{vmatrix} \\\\  & =-2\\cdot (-1)^{3+1}\\cdot \\begin{vmatrix}3 & 5 \\\\ -4 & 1\\end{vmatrix} \\\\  & =(-2)\\cdot (3+20) \\\\  & =-46\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{46}.\n$$"}] [{:db/id #edb/ref 17592186265948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f304f8-92e8-51a7-b162-d70782a1c348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186263492} {:answer/id #uuid "3ad553e1-5759-5c80-aea1-b19a2c528e67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-45" :db/id #edb/ref 17592186263524} {:answer/id #uuid "5c396193-d1e2-5c07-ab21-8ee06b268902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186263794} {:answer/id #uuid "60eb6a69-4e31-5fd0-8238-b39bcb055083" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186263837} {:answer/id #uuid "616d3a76-1bf3-5317-9871-b368f9f8170b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186263841}] :answer-field/correct {:db/id #edb/ref 17592186263794} :answer-field/id #uuid "f29ff58d-9c44-54c2-82fc-6274cfaab393" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265680}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0bc36fde-175a-5a60-bfe0-4edee290223c" :question/math-academy-id "q-130631" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=-15$ and $|{C}^{-1}|=3$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=\\frac{1}{3}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =(-15)\\cdot \\left(\\frac{1}{3}\\right) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b01122-cef4-57e0-bbe6-9e9ca46a105d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "172" :db/id #edb/ref 17592186263225} {:answer/id #uuid "68462165-dd02-5aef-a990-fa2a80304b30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "154" :db/id #edb/ref 17592186263899} {:answer/id #uuid "9d4b1f65-f423-5f95-a77f-398f082a7e84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "176" :db/id #edb/ref 17592186264347} {:answer/id #uuid "b3c540ce-78c8-5ba3-8e16-45516155084a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "168" :db/id #edb/ref 17592186264543} {:answer/id #uuid "da01d959-45b6-560c-907e-0539a9249ab1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "88" :db/id #edb/ref 17592186264900}] :answer-field/correct {:db/id #edb/ref 17592186264347} :answer-field/id #uuid "b70c3988-227e-5d92-a2bc-8cd2a832cea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265566}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aff6f4ac-0990-556a-848c-2e5cb8fef1cd" :question/math-academy-id "q-130634" :question/problem "$$\n\\displaystyle \\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 78\\end{vmatrix}=\n$$" :question/worked-solution "First, notice that the $1$st row of our determinant is almost equal to the $3$rd row. So, we can rewrite the given determinant, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 78\\end{vmatrix} & =\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160+0 & 184+0 & 76+2\\end{vmatrix}\\end{aligned}\n$$\n\nNext, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160+0 & 184+0 & 76+2\\end{vmatrix} & =\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 76\\end{vmatrix}+\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 0 & 0 & 2\\end{vmatrix}.\\end{aligned}\n$$\n\nThe first determinant must be zero since it has two identical rows, while the second determinant can be expanded across the $3$rd row, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 160 & 184 & 76\\end{vmatrix}+\\begin{vmatrix}160 & 184 & 76 \\\\ 3 & 4 & -8 \\\\ 0 & 0 & 2\\end{vmatrix} & =0+2(-1)^{3+3}\\begin{vmatrix}160 & 184 \\\\ 3 & 4\\end{vmatrix} \\\\  & =2\\cdot (160\\cdot 4-184\\cdot 3) \\\\  & =2\\cdot 88 \\\\  & =176\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73a96b2f-f10f-5679-8a52-f7da800ace47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264005} {:answer/id #uuid "77cb7e4e-717f-5d83-a3d1-62b0c089f91a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 0 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264040} {:answer/id #uuid "7a6d7095-457a-545c-9a96-59a7eb796817" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & -4 \\\\ 0 & -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264062} {:answer/id #uuid "9d2f1f3a-355c-5498-a687-9a1ead7b19d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186264346} {:answer/id #uuid "9eaaa110-7886-5377-b0ae-e774694df7fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186264353}] :answer-field/correct {:db/id #edb/ref 17592186264353} :answer-field/id #uuid "f8d83749-d1d8-562a-b410-fb63e7552eb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265690}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "612080dd-d026-5cb3-8a7c-eb82500a5280" :question/math-academy-id "q-130642" :question/problem "If $A=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}$, then ${A}^{4}=$" :question/worked-solution "First, we compute ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix} \\\\  & =A\\end{aligned}\n$$\n\nNotice that ${A}^{2}=A,$ so $A$ is an idempotent matrix. \n\nWe can use this fact to compute ${A}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =A\\cdot A \\\\  & ={A}^{2} \\\\  & =A\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{A}^{4}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186265974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "331f3993-b5ac-54a2-ac82-06dd0321b151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186263442} {:answer/id #uuid "3603ab83-8aae-5dd5-89fa-afe1ef9f62d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186263477} {:answer/id #uuid "57d3925a-c1e7-542d-8f33-1d3909394cd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186263757} {:answer/id #uuid "c0ead8f3-49e7-5a32-8b04-bc4291058f3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186264675} {:answer/id #uuid "c9e9d9c7-1fa1-50bc-b6dc-efdafdea5ab7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186264765}] :answer-field/correct {:db/id #edb/ref 17592186263477} :answer-field/id #uuid "6691a242-c5c1-5177-b03a-f829842b5ebb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265425}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74270614-19f5-5cbe-a862-b299585b014f" :question/math-academy-id "q-130777" :question/problem "Given that \n$$\n\\displaystyle \\begin{vmatrix}3 & -2 \\\\ a & b+2\\end{vmatrix}=8,\n$$\nfind \n$$\n\\displaystyle \\begin{vmatrix}3 & -2 \\\\ a+3 & b\\end{vmatrix}.\n$$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & -2 \\\\ a+3 & b\\end{vmatrix} & =\\begin{vmatrix}3 & -2 \\\\ a+3 & (b+2)-2\\end{vmatrix}\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & -2 \\\\ a+3 & (b+2)-2\\end{vmatrix} & =\\underbrace{\\begin{vmatrix}3 & -2 \\\\ a & b+2\\end{vmatrix}}_{8}+\\begin{vmatrix}3 & -2 \\\\ 3 & -2\\end{vmatrix} \\\\  & =8+(-6+6) \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef7082b-a8cb-5f1a-919c-08c1470cb74b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{1}+(-5){R}_{2}" :db/id #edb/ref 17592186263284} {:answer/id #uuid "26826c57-252e-56f3-928a-7ed1b119d8ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{1}+5{R}_{2}" :db/id #edb/ref 17592186263335} {:answer/id #uuid "81bc10fa-ce64-5073-9d1d-50f07fae01cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-5{R}_{2}" :db/id #edb/ref 17592186264117} {:answer/id #uuid "aac4da94-090c-5cac-8faf-9b696938bf0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+5{R}_{1}" :db/id #edb/ref 17592186264461} {:answer/id #uuid "f36fc7b0-5e82-5868-91c8-65280ba1adb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-5){R}_{1}" :db/id #edb/ref 17592186265138}] :answer-field/correct {:db/id #edb/ref 17592186265138} :answer-field/id #uuid "ee672deb-35f0-517e-ab60-3ec6be1e3a3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265674}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29282155-f922-5de3-8efa-da8c96056d84" :question/math-academy-id "q-130838" :question/problem "Let $E=\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by taking the second row of the identity matrix and adding $-5$ times the first row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\  & =E.\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation ${R}_{2}:={R}_{2}+(-5){R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186265984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089c5bd3-3769-5987-9447-6e451dbfb996" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-10){R}_{1}" :db/id #edb/ref 17592186263083} {:answer/id #uuid "2ceb45bf-0de1-5013-9011-eb983274c6b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-10{R}_{1}" :db/id #edb/ref 17592186263377} {:answer/id #uuid "6ce4fda5-dbe5-5692-b9c9-b04929fcf10f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=10{R}_{2}" :db/id #edb/ref 17592186263939} {:answer/id #uuid "a40c2e2a-60ed-544b-b69e-fd7dbab623b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-10{R}_{2}" :db/id #edb/ref 17592186264397} {:answer/id #uuid "e39cead2-c6e5-5ada-b391-e2fb40dfcde3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{1}+(-10){R}_{2}" :db/id #edb/ref 17592186264979}] :answer-field/correct {:db/id #edb/ref 17592186264397} :answer-field/id #uuid "2c04d78f-c815-5da7-93ea-f38bfbfa1990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "45924c9f-a57f-5ad0-bbf3-47d440fa2c4c" :question/math-academy-id "q-130839" :question/problem "Let $E=\\begin{bmatrix}1 & 0 \\\\ 0 & -10\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The given matrix $E$ is obtained by multiplying the second row of the identity matrix by $-10$: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2} & :=-10{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & -10\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation  ${R}_{2}:=-10{R}_{2}$ to $A.$"}] [{:db/id #edb/ref 17592186265986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bef6d2-3b43-5908-9441-dc022c8ce2f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=8{R}_{1}" :db/id #edb/ref 17592186263156} {:answer/id #uuid "2e917a2f-5791-5c33-93ae-708786a89d80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+8{R}_{2}" :db/id #edb/ref 17592186263391} {:answer/id #uuid "3f4dba73-ef9c-5b36-9ea1-0a19fe664efc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+8{R}_{1}" :db/id #edb/ref 17592186263559} {:answer/id #uuid "b4c050ae-1334-5393-879f-891363e45568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-8){R}_{2}" :db/id #edb/ref 17592186264556} {:answer/id #uuid "fd620fa6-6708-5056-8f7d-aa1dae17d139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-8){R}_{1}" :db/id #edb/ref 17592186265225}] :answer-field/correct {:db/id #edb/ref 17592186263391} :answer-field/id #uuid "182d1226-d8e7-5d77-89d4-6ff2a6884d4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265284}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "55e31023-29e9-51b8-898e-4fb42a50ab20" :question/math-academy-id "q-130844" :question/problem "Let $E=\\begin{bmatrix}1 & 8 \\\\ 0 & 1\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by taking the first row of the identity matrix and adding $8$ times the second row:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+8{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 8 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation ${R}_{1}:={R}_{1}+8{R}_{2}$ to $A.$"}] [{:db/id #edb/ref 17592186265987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345c7e9e-f5b1-5730-a772-96772cc53242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 7\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186263457} {:answer/id #uuid "39ec37a5-6de1-5f66-85d4-e51c21144e52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & 7\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186263516} {:answer/id #uuid "78c1b96e-24c2-5b99-9c19-b8cf0eb30df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 7\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186264048} {:answer/id #uuid "b4b525a9-5eee-53ab-9159-6caa875402d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & -7\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186264555} {:answer/id #uuid "bece3777-dc59-5f5d-aa6f-dd9707969691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 7 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186264659}] :answer-field/correct {:db/id #edb/ref 17592186264659} :answer-field/id #uuid "929663cd-c2ae-5ebd-8e94-aee08cf03d7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265510}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88d07c0b-13bc-57c6-99c3-9b20d846b987" :question/math-academy-id "q-130845" :question/problem "Suppose we are applying the elementary row operation ${R}_{1}:={R}_{1}+7{R}_{2}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+7{R}_{2}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+7{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 7 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}1 & 7 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186265988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090417bb-bda0-5586-94b2-46eceb1bcbb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ -16 & 1\\end{bmatrix}" :db/id #edb/ref 17592186263085} {:answer/id #uuid "1a096cdf-7202-57cc-a632-c055625d37b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}16 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186263249} 