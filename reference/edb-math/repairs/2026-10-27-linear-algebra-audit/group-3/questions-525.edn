 -1 & 4 & -10 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 3 & 12 & 6 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0da7ae-0be2-5a15-bb78-e9aa6a4e73bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557526} {:answer/id #uuid "7271e45f-8553-5ce0-acb1-6c300273e818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2z+3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557533} {:answer/id #uuid "8ccb0a70-9168-5376-aab3-e2bf68061d3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} {:answer/id #uuid "b8bdf101-8a17-59f6-92cc-0d92a551d21e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2z-3 \\\\ 5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557555} {:answer/id #uuid "f5a634f4-002a-58cb-96bc-17a4efd0a7ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3z+5 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557568}] :answer-field/correct {:db/id #edb/ref 17592186557538} :answer-field/id #uuid "a2993581-de40-5699-b32f-c45f7304d89a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f34874f6-66c0-58d0-a503-ac8424ffc0ef" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y-2z &=-16 \\\\ 2x+y+7z &=-1 \\\\ 2x+4z &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & -2 & -16 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 2 & 1 & 7 & -1 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 3 & 9 & 15 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce1dc0c-75ef-52c2-bd4b-bf75d5f2e8dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4z+6 \\\\ 3z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557510} {:answer/id #uuid "3bf6b08b-6231-5a56-a8e3-c43b285af62d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3z-4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557516} {:answer/id #uuid "86cd4be6-2d2c-56d7-b46a-2c157bb80402" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557537} {:answer/id #uuid "d2124629-8825-54e6-8828-d3638950e6b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3z+4 \\\\ 6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557559} {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564}] :answer-field/correct {:db/id #edb/ref 17592186557564} :answer-field/id #uuid "33817d11-0d35-5223-ad95-222c9e4cd34e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557514}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf82865b-b7f8-5978-a65d-6ceaeecc7985" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557768} {:answer/id #uuid "d2c67902-8586-522d-8128-26d6372edb3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557777}] :answer-field/correct {:db/id #edb/ref 17592186557777} :answer-field/id #uuid "352475c6-893f-5d15-8bd4-4fc7d65c9b40" :answer-field/key "$AB=BA={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186557713} {:answer-field/choices [{:answer/id #uuid "e8f869e2-c759-591a-9c02-906bc98f760f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557789} {:answer/id #uuid "e9e346c7-807b-58b0-9826-de71aa5abe49" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557791}] :answer-field/correct {:db/id #edb/ref 17592186557791} :answer-field/id #uuid "5aac40eb-e4b1-5a40-92f2-d09ca0cd77c3" :answer-field/key "$AC=CA={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186557725} {:answer-field/choices [{:answer/id #uuid "023a940e-0586-53bb-85a2-7d425b0cf6a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557703} {:answer/id #uuid "ae4cf946-1ca5-5f24-9b50-8c5503ce3a04" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557758}] :answer-field/correct {:db/id #edb/ref 17592186557703} :answer-field/id #uuid "765fa93c-fc92-5c91-8fc2-7219896e12df" :answer-field/key "$B={A}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186557736}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1a0b8b2e-0993-564b-9de2-b414008b167b" :question/problem "Consider the matrices\n\n$$\nA=\\begin{bmatrix}-1 & -\\frac{3}{2} \\\\ -1 & \\frac{1}{2}\\end{bmatrix},\\,B=\\begin{bmatrix}-\\frac{1}{4} & \\frac{3}{4} \\\\ -\\frac{1}{2} & \\frac{1}{2}\\end{bmatrix},\\,C=\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ -\\frac{1}{2} & \\frac{1}{2}\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- First, we check whether $AB=BA={I}_{2}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-1 & -\\frac{3}{2} \\\\ -1 & \\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & \\frac{3}{4} \\\\ -\\frac{1}{2} & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & ∗ \\\\ ∗ & -\\frac{1}{2}\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $AB=BA={I}_{2}$ is false. As a result, $B\\ne {A}^{-1}$ and statement $B={A}^{-1}$ is false too.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =\\begin{bmatrix}-1 & -\\frac{3}{2} \\\\ -1 & \\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ -\\frac{1}{2} & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{1}{4} & -\\frac{3}{4} \\\\ -\\frac{1}{2} & \\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-1 & -\\frac{3}{2} \\\\ -1 & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $AC=CA={I}_{2}$ is true.\n\nTherefore, the correct answer is $AC=CA={I}_{2}$ only."}] [{:db/id #edb/ref 17592186557710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f18c79-3b49-530d-8454-86379c0b9403" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186557785} {:answer/id #uuid "e9d8a19d-14c7-57f9-99cc-9cac0d153cd9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557790}] :answer-field/correct {:db/id #edb/ref 17592186557785} :answer-field/id #uuid "6ee91bd2-1a95-558f-be1a-abb6d916f84b" :answer-field/key "$DE=ED={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186557733} {:answer-field/choices [{:answer/id #uuid "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186557750} {:answer/id #uuid "c2c423f1-fa46-5046-b322-201462bc9092" :answer/type {:db/id #e