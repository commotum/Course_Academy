ray}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ -2 & -1 & 7 & 24 & -20 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 1 & 1 & -1 & -5 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 3 & 3 & 6 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & -1 & 1 & 4 & -8\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 2 & 6 & -8\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -9 & 10 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -3 & 2 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -1 & -6 \\\\ 0 & 1 & 0 & -1 & 4 \\\\ 0 & 0 & 1 & 3 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-w &=-6 \\\\ y-w &=4 \\\\ z+3w &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=w-6 \\\\ y &=w+4 \\\\ z &=-3w-4 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}w-6 \\\\ w+4 \\\\ -3w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02892691-5a2f-5f61-9177-938daabef939" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w+6 \\\\ -5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557504} {:answer/id #uuid "98857d11-cf0f-559c-a624-f643e00223ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557540} {:answer/id #uuid "9db1195b-832e-5816-88cf-39d7489101c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w-5 \\\\ 3w+6 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557543} {:answer/id #uuid "a3ec9f26-beca-531e-a168-718b6fa8b969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w-6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557547} {:answer/id #uuid "b2f20b2d-3574-56db-9346-d8ef62225348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557553}] :answer-field/correct {:db/id #edb/ref 17592186557540} :answer-field/id #uuid "488246de-7953-56e5-9ac6-5b947af6556f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557523}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a510fef8-28cf-5858-9f70-47fb3be2fcfd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-4z-26w &=-20 \\\\ 2x+7y+2z-23w &=-17 \\\\ -2x-5y+4z+29w &=25.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -4 & -26 & -20 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 2 & 7 & 2 & -23 & -17 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ -2 & -5 & 4 & 29 & 25\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 3 & 6 & 3 & 3 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & -1 & 0 & 3 & 5\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 2 & 4 & 6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 2 & 1 & 1 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -2 & -13 & -10 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -9 & -4 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -3 & 6 \\\\ 0 & 1 & 0 & -3 & -5 \\\\ 0 & 0 & 1 & 2 & 3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3w &=6 \\\\ y-3w &=-5 \\\\ z+2w &=3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3w+6 \\\\ y &=3w-5 \\\\ z &=-2w+3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}3w+6 \\\\ 3w-5 \\\\ -2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a654292-8518-53cd-98bb-71caefcd0a07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z+6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557525} {:answer/id #uuid "b0ca90a2-0b9b-5a30-90dc-f0b37b92a3da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3z-2 \\\\ z-6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557552} {:answer/id #uuid "bb5b33de-0074-5e2b-829b-eccf84bde51a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-6 \\\\ -2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557556} {:answer/id #uuid "df6a7199-5556-5eff-bdc9-33f2fe72ec36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557563} {:answer/id #uuid "f7ab48c0-6851-5db5-a9dc-659cf7d80014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557570}] :answer-field/correct {:db/id #edb/ref 17592186557570} :answer-field/id #uuid "da4edae9-050e-575b-96c1-28496dd612d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557562}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6f0b47a-f445-55ab-8fc9-cbed8ed9f994" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+4z &=-16 \\\\ -2x+y+5z &=10 \\\\ -x-2y-5z &=10.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -16 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ -2 & 1 & 5 & 10 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 3 & 9 & -6 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ -1 & -2 & -5 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & -1 & -3 & 2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -8 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -6 \\\\ 0 & 1 & 3 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-6 \\\\ y+3z &=-2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-6 \\\\ y &=-3z-2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-6 \\\\ -3z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fa00707-ca62-5e26-8cd5-1f7625b9c10c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557528} {:answer/id #uuid "995676a6-2cf6-5858-b738-aba60a8aeefa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4z+2 \\\\ -5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557541} {:answer/id #uuid "9cedd0e2-f0fe-57de-8bf9-74b0d6aeefe1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4z-2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557542} {:answer/id #uuid "d32535a8-e248-5a18-9233-6d41ff79b84a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3z-5 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557560} {:answer/id #uuid "d7b08673-f5a7-5468-88d2-82fface9dd69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557561}] :answer-field/correct {:db/id #edb/ref 17592186557528} :answer-field/id #uuid "32299d3b-6034-5ff8-afd5-342220d2ad49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557513}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "adb0568a-cc33-548d-9e70-7aec30b5b6bd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+14z &=-6 \\\\ x+4y+16z &=-18 \\\\ -2x-4y-20z &=16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 14 & -6 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 1 & 4 & 16 & -18 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 3 & 9 & -15 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ -2 & -4 & -20 & 16\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & -2 & -6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 7 & -3 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & 2 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=2 \\\\ y+3z &=-5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z+2 \\\\ y &=-3z-5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z+2 \\\\ -3z-5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f75aad-535e-5349-ac30-0817cbc6131e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557507} {:answer/id #uuid "67b5aba3-9287-5655-a310-8b430569b715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557531} {:answer/id #uuid "85f5e298-78dd-5de5-b5f3-f4c5ec30a051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2w-2 \\\\ -6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557535} {:answer/id #uuid "a0cb117c-63e0-5b48-8734-1e48dee2c005" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-6 \\\\ 2w-2 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557545} {:answer/id #uuid "f8bddcd4-51ea-5bca-9efc-633ffe6faec6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2w+2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557571}] :answer-field/correct {:db/id #edb/ref 17592186557531} :answer-field/id #uuid "43ca07dd-c5bb-5c16-9ac1-3f7c98019646" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557521}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c7e5dc6c-e550-5c9b-8c75-fe188ef23a8b" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+2z-8w &=-22 \\\\ -x+2y+2z-2w &=-16 \\\\ x+2y+4z-12w &=-26.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/retired true :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -8 & -22 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ -1 & 2 & 2 & -2 & -16 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 1 & 2 & 4 & -12 & -26\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 3 & 3 & -6 & -27 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 1 & 3 & -8 & -15\\end{array}\\right] & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 2 & -6 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 1 & -2 & -9 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -4 & -11 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -1 & -8 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & 1 & -6 \\\\ 0 & 0 & 1 & -3 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2w &=-2 \\\\ y+w &=-6 \\\\ z-3w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2w-2 \\\\ y &=-w-6 \\\\ z &=3w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}2w-2 \\\\ -w-6 \\\\ 3w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186557558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ff2e8-5074-588e-a4a9-3d3cfb18d3bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4z-4 \\\\ 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557506} {:answer/id #uuid "3076215c-304a-5d01-86d1-3ff9741ff4dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4z-4 \\\\ -4z+2 \\\\ z\\end{bmatri