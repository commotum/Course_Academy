#{[{:db/id #edb/ref 17592186329709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "217b4b8b-cc0b-53a3-8c11-0c11e0db776d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{3}" :db/id #edb/ref 17592186327223} {:answer/id #uuid "238bb388-343a-58d7-9db2-050e57ec45b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186327242} {:answer/id #uuid "68c0d0ce-8c27-5888-ace5-002687a4df64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186327837} {:answer/id #uuid "c160f3eb-2949-5657-b5a9-161a21d65fd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186328622} {:answer/id #uuid "ce09f426-6762-5fb0-b6f0-768bffc90ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186328746}] :answer-field/correct {:db/id #edb/ref 17592186328622} :answer-field/id #uuid "c87a46a6-b339-5dc3-8ffd-5e9183021584" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329540}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d375fe07-2a11-5b83-b2d9-76a00ed1fc28" :question/math-academy-id "q-43096" :question/problem "Find $det({A}^{-1}),$ if $A=\\begin{bmatrix}4 & 3 \\\\ 3 & -3\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}4 & 3 \\\\ 3 & -3\\end{bmatrix} \\\\  & =-12-9 \\\\  & =-21\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=-\\frac{1}{21}.\n$$"}] [{:db/id #edb/ref 17592186336011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89dca9db-88dc-5f58-9f23-ec98ca1bbc75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438478} {:answer/id #uuid "128f9548-3706-5b6d-94e4-afd0ea31e354" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438479}] :answer-field/correct {:db/id #edb/ref 17592186438479} :answer-field/id #uuid "f8abcdf3-f784-54de-90bb-b51f314f8912" :answer-field/key "$M$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439268} {:answer-field/choices [{:answer/id #uuid "1b74bddc-ad74-5f61-a0ce-c1bb3f545d9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438480} {:answer/id #uuid "f99619dc-7a17-50df-b37c-d5f5007df859" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438481}] :answer-field/correct {:db/id #edb/ref 17592186438480} :answer-field/id #uuid "96b81975-4ed5-5bfd-b978-ee8fdac7cf77" :answer-field/key "$det(M)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439269} {:answer-field/choices [{:answer/id #uuid "ad1a88c7-0f27-56c5-b163-10cc23842fb0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438482} {:answer/id #uuid "97a592ec-ef1e-56af-8795-1ae139a9168a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438483}] :answer-field/correct {:db/id #edb/ref 17592186438483} :answer-field/id #uuid "92e3b518-970c-5ddb-8ddd-c289c427c026" :answer-field/key "$det(M)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439270}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "924829bc-4eac-54c3-82c8-f773955ca97e" :question/math-academy-id "q-69834" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\nSelect all that apply.\n\n$$\nM=\\begin{bmatrix}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =\\begin{vmatrix}1 & -2 & 1 \\\\ 1 & 2 & 3 \\\\ -2 & 4 & -2\\end{vmatrix} \\\\  & =1\\begin{vmatrix}2 & 3 \\\\ 4 & -2\\end{vmatrix}-(-2)\\begin{vmatrix}1 & 3 \\\\ -2 & -2\\end{vmatrix}+1\\begin{vmatrix}1 & 2 \\\\ -2 & 4\\end{vmatrix} \\\\  & =1(-4-12)+2(-2+6)+1(4+4) \\\\  & =1\\cdot (-16)+2\\cdot 4+1\\cdot 8 \\\\  & =-16+8+8 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statements “$M$ is a singular matrix” and $det(M)=0$ are true."}] [{:db/id #edb/ref 17592186338850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636472-3eda-542f-b7c3-23ae232bc2c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 & 14\\end{bmatrix}" :db/id #edb/ref 17592186336582} {:answer/id #uuid "b4de6dcb-4fe1-5185-b370-367b3c5e23aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}10 & -1\\end{bmatrix}" :db/id #edb/ref 17592186337637} {:answer/id #uuid "de21dbdb-0d9a-5740-aec5-151cfe330af1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186337964} {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} {:answer/id #uuid "f3f6c67a-5a58-56b5-8c25-9be2881adeb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 14\\end{bmatrix}" :db/id #edb/ref 17592186338163}] :answer-field/correct {:db/id #edb/ref 17592186338044} :answer-field/id #uuid "89241c64-36b6-57dc-ba88-dc9eb9dc5ea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338528}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfec97ba-ccad-5e4f-97b5-a14f90d0cefb" :question/math-academy-id "q-70928" :question/problem "Find $BC$,  if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$B=\\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}.$</div>\n</div>" :question/worked-solution "Here, $B$ is a $1\\times 3$ matrix and $C$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $B$ and $3$ rows in $C,$ so $B$ and $C$ are conformable for multiplication:\n\n$$\n{B}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{C}_{\\boxed{\\text{3}}\\times 2}={BC}_{1\\times 2}\n$$\n\nLet's compute $BC,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & ∗\\end{bmatrix}, &  & \\,-10=(-3)\\cdot 1+1\\cdot 3+(-2)\\cdot 5 \\\\  & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & -14\\end{bmatrix}, &  & \\,-14=(-3)\\cdot 2+1\\cdot 4+(-2)\\cdot 6\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle BC=\\begin{bmatrix}-10 & -14\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186338852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab14835-d162-5a27-a085-b4b919a36b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186336132} {:answer/id #uuid "3315575e-eba2-51bc-a342-692c1283d7cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186336516} {:answer/id #uuid "618bb264-210a-53cf-ab61-500e5973c2f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-26" :db/id #edb/ref 17592186336911} {:answer/id #uuid "9eb3cc5f-cfd1-5a82-9250-0d6ceda1e462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186337467} {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186337488}] :answer-field/correct {:db/id #edb/ref 17592186337488} :answer-field/id #uuid "a63e7de0-266f-539b-8fee-e35ab81173de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338586}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44992928-91b6-50f2-9197-4b5da9dd00f2" :question/math-academy-id "q-70946" :question/problem "Let $D=EF.$ What is the value of ${d}_{23}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nD=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $E$ by the $3$rd column in $F$, we get\n\n$$\n\\begin{aligned}{d}_{23} & =\\begin{bmatrix}-4 & 3\\end{bmatrix}\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =(-4)\\cdot (-5)+3\\cdot (-2) \\\\  & =20-6 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e95cad-860e-538a-8b99-9f0c70f261c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186336097} {:answer/id #uuid "57fc8d0d-2b20-52ee-b810-0e17521266a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186336838} {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186337096} {:answer/id #uuid "a99efaa4-b49e-5cdd-af2c-d3ba9219b384" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186337563} {:answer/id #uuid "ad8fdf84-56c3-5819-a6bb-de4f89a6b352" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186337589}] :answer-field/correct {:db/id #edb/ref 17592186337096} :answer-field/id #uuid "7d3b9a44-3753-5606-8ec0-132a1ef649d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338499}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb301367-989b-59c3-9a3a-157e756a6cf8" :question/math-academy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$M=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nK=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =\\begin{bmatrix}5 & -4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186336137} {:answer/id #uuid "3b70ccb4-c16c-5cf5-b11e-8aafc5f11705" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186336590} {:answer/id #uuid "baedc752-7f92-5818-8e49-7eadefb98f9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-23" :db/id #edb/ref 17592186337692} {:answer/id #uuid "d7a7677a-b2a4-59f0-ac24-ee44c46d1a26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186337904} {:answer/id #uuid "f431b48c-3499-5e6b-9764-458010a3f0be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186338165}] :answer-field/correct {:db/id #edb/ref 17592186336137} :answer-field/id #uuid "618939f6-04ba-5ea6-a01f-f04923f31488" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338449}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ed5dbc7-d94a-5c52-80fe-8e1e3e8256f9" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$U=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nT=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}\n$$\n\nMultiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =\\begin{bmatrix}-5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nR=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =\\begin{bmatrix}3 & -4\\end{bmatrix}\\begin{bmatrix}10 \\\\ 7\\end{bmatrix} \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c25817-90d5-5739-bde8-c7bb037f4127" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451537} {:answer/id #uuid "ce945b72-5264-5a5b-8a2f-5f3cc5335b1c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451538}] :answer-field/correct {:db/id #edb/ref 17592186451537} :answer-field/id #uuid "75de82e6-fb57-5a51-a8f9-1335844b81db" :answer-field/key "$BC=CB={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452616} {:answer-field/choices [{:answer/id #uuid "2aeacf71-84c6-5a17-9d5e-1859dec82bf3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451539} {:answer/id #uuid "1fb17603-bcaf-5635-9adf-ab7d73d0ab98" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451540}] :answer-field/correct {:db/id #edb/ref 17592186451540} :answer-field/id #uuid "652e549d-bd49-5b19-8c97-310687a0bbc7" :answer-field/key "$BD=DB={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452617} {:answer-field/choices [{:answer/id #uuid "fa6bd75a-5100-5a01-b2f9-62605056b7ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451541} {:answer/id #uuid "e078b049-aafa-54c7-bccb-956724005e82" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451542}] :answer-field/correct {:db/id #edb/ref 17592186451542} :answer-field/id #uuid "9b789eb6-286f-59e6-b5ed-05232be7d77e" :answer-field/key "$D={B}^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4139737b-7211-574f-84a7-c3e2691e8190" :question/math-academy-id "q-71817" :question/problem "Consider the matrices\n\n$$\nB=\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix},\\,D=\\begin{bmatrix}0 & \\frac{1}{2} \\\\ -\\frac{1}{2} & 0\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "- First, we check whether $BC=CB={I}_{2}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement $BC=CB={I}_{2}$ is false.\n\n- Now, we check whether $BD=DB={I}_{2}.$ Computing $BD$, we get\n\n$$\n\\begin{aligned}BD & =\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 & \\frac{1}{2} \\\\ -\\frac{1}{2} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DB$, we get\n\n$$\n\\begin{aligned}DB & =\\begin{bmatrix}0 & \\frac{1}{2} \\\\ -\\frac{1}{2} & 0\\end{bmatrix}\\begin{bmatrix}0 & -2 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement $BD=DB={I}_{2}$ is true. As a result, $D={B}^{-1}$ and statement $D={B}^{-1}$ is true too.\n\nTherefore, the correct answer is $BD=DB={I}_{2}$; $D={B}^{-1}$ only."}] [{:db/id #edb/ref 17592186338996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eaec500-2809-5bb5-861d-56d1da22f167" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451543} {:answer/id #uuid "6ebf9533-e707-5bf6-8742-eb76ec6be172" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451544}] :answer-field/correct {:db/id #edb/ref 17592186451544} :answer-field/id #uuid "f29819b3-4f4a-51ee-bbae-9782ec90563c" :answer-field/key "$EF=FE={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452619} {:answer-field/choices [{:answer/id #uuid "cd03c76f-01ad-5869-9266-ea6396baa60f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451545} {:answer/id #uuid "0249768e-eeb3-505e-bc4e-f893b8cbb258" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451546}] :answer-field/correct {:db/id #edb/ref 17592186451545} :answer-field/id #uuid "938a501e-fad4-53b6-847b-60d0820298e9" :answer-field/key "$EG=GE={I}_{2}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452620} {:answer-field/choices [{:answer/id #uuid "2ba7af21-5652-57ba-8798-d37c8fda3fe8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :