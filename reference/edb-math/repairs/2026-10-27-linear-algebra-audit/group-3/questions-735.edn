1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\ &=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}BA&=\\begin{bmatrix}1 & 3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\ &=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nBoth products are $I_3$, so $B=A^{-1}$ is true.\n\nThe statement $B\\ne A^{-1}$ is **false** by the product test above.\n\nSelect $AB=BA=I_3$."}] [{:db/id #edb/ref 17592186703871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f41d1b-32d1-5898-a539-aeb0b4541150" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186703872} {:answer/id #uuid "f4d0fcc8-ac39-5c26-af2f-13d37388fadb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186703873}] :answer-field/correct {:db/id #edb/ref 17592186703872} :answer-field/id #uuid "b149940a-773a-5374-b007-3301b9c37f78" :answer-field/key "$AB=BA=I_3$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186703865} {:answer-field/choices [{:answer/id #uuid "04e8b3a1-27ee-52ff-a5e7-a56d3695c53a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186703837} {:answer/id #uuid "778428c0-b3dc-5939-a9af-a522ad7a11fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186703857}] :answer-field/correct {:db/id #edb/ref 17592186703857} :answer-field/id #uuid "ce252870-8aa8-58ab-97a9-941d6334ccdc" :answer-field/key "$B\\ne A^{-1}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186703869} {:answer-field/choices [{:answer/id #uuid "3b5946c1-d49d-51df-b118-808f3804239f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186703845} {:answer/id #uuid "5d010470-117c-5279-8723-420489e43b36" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186703850}] :answer-field/correct {:db/id #edb/ref 17592186703850} :answer-field/id #uuid "f783918d-e28f-5bf2-bf4f-61c113cd1d21" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186703874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e305843c-2ffc-598c-b0fc-09a09e75317d" :question/problem "Consider the matrices\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n</div>\n\nRecall that $B=A^{-1}$ means $AB=BA=I_3$. Which of the following statements are true? Use direct verification.\n\nSelect all that apply." :question/worked-solution "Check $B$. The entry in row $1$, column $2$ already disproves the identity claim:\n\n$$\n\\begin{aligned}(AB)_{12}&=(1)(2)+(-3)(1)+(0)(0) \\\\ &=-1\\ne 0\\end{aligned}\n$$\n\nThus $AB\\ne I_3$, so $B$ is not an inverse of $A$. One mismatching entry is enough to reject a candidate.\n\nThe statement $B\\ne A^{-1}$ is **true** by the product test above.\n\nSelect $B\\ne A^{-1}$."}] [{:db/id #edb/ref 17592186704845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02630caf-d9d7-52e4-b3e5-5c1717fa0765" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186704841} {:answer/id #uuid "44b0e7ec-e7e3-5045-a405-07f46f19198c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186704843} {:answer/id #uuid "773263e4-814a-5c47-84b9-7183804afcf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & 1 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186704844} {:answer/id #uuid "9c7ec4bc-7338-5122-9310-d5b31c5df3d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186704846} {:answer/id #uuid "f6dfe965-e80f-560f-b25c-b712ee2a4bd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & -1 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186704847}] :answer-field/correct {:db/id #edb/ref 17592186704843} :answer-field/id #uuid "0dca7aa4-ea65-5e6b-a22a-3c0f09e9dc44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704842}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8708a0e1-760d-5650-9a72-dd5bcc33d458" :question/problem "Consider the system\n\n$$\n\\left\\{\\begin{aligned}-x_{1}-x_{2}+x_{3} &=-1 \\\\ -x_{1}-2x_{2}+x_{3} &=2 \\\\ x_{1}+x_{2}-x_{3} &=1\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix $M$ to row echelon form." :question/worked-solution "The augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-1 & -1 & 1 & -1 \\\\ -1 & -2 & 1 & 2 \\\\ 1 & 1 & -1 & 1\\end{array}\\right]\n$$\n\nApply Gaussian elimination to every augmented column:\n\n$$\n\\begin{aligned}M &=\\left[\\begin{array}{ccc|c}-1 & -1 & 1 & -1 \\\\ -1 & -2 & 1 & 2 \\\\ 1 & 1 & -1 & 1\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ -1 & -2 & 1 & 2 \\\\ 1 & 1 & -1 & 1\\end{array}\\right]\\qquad R_{1}\\gets -1R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & -1 & 0 & 3 \\\\ 1 & 1 & -1 & 1\\end{array}\\right]\\qquad R_{2}\\gets R_{2}+(1)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & -1 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\qquad R_{3}\\gets R_{3}+(-1)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\qquad R_{2}\\gets -1R_{2}\\end{aligned}\n$$\n\nThus a row echelon form is\n\n$$\nM\\sim \\left[\\begin{array}{ccc|c}1 & 1 & -1 & 1 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThe final row is the redundant equation $0=0$; there are two coefficient pivots."}] [{:db/id #edb/ref 17592186704908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096f5baf-278e-5337-a8ef-a587454ffa1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704905} {:answer/id #uuid "56b45059-59ca-53c8-a5ae-bc9c77eee784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704912} {:answer/id #uuid "61b32a5a-870f-5ab3-ab34-34c2adaf6c1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704914} {:answer/id #uuid "7834cac5-5a17-5737-94ee-9ad941026a98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704917} {:answer/id #uuid "d575acff-8477-5727-9ea2-946b5a8d06b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704930}] :answer-field/correct {:db/id #edb/ref 17592186704912} :answer-field/id #uuid "799e0348-f794-592d-ae84-bc783b129cbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704918}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2917f57a-9cdb-5571-ba80-4de593a663c1" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-2x+4y-8z &=-6 \\\\ -2x+4y-8z &=-6 \\\\ -3x+6y-12z &=-9\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 4 & -8 & -6 \\\\ -2 & 4 & -8 & -6 \\\\ -3 & 6 & -12 & -9\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow \\left(-\\frac{1}{2}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & 4 & 3 \\\\ -2 & 4 & -8 & -6 \\\\ -3 & 6 & -12 & -9\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & 4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ -3 & 6 & -12 & -9\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & 4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x-2y+4z &=3 \\\\ x &=3+2y-4z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3+2y-4z \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259356d2-48c7-5eee-8979-e7460beb2d4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704907} {:answer/id #uuid "6d8d3522-50af-55ae-a7ec-d5a32283333c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704916} {:answer/id #uuid "8cb4c69d-ecc6-5af7-9541-d63f2d190cc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704922} {:answer/id #uuid "abdcc322-49b7-540c-9f51-6800df203ced" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704926} {:answer/id #uuid "bed34ade-842d-57cd-93cf-ce847f545c75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704928}] :answer-field/correct {:db/id #edb/ref 17592186704922} :answer-field/id #uuid "8d780390-b2d2-5dea-ae8a-cb8c59d25ece" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704923}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f231ad5-c534-5c20-a3cc-cef55e1aef15" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-2x-6y &=-8 \\\\ -x-3y &=-4 \\\\ -2x-6y &=-8\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & -6 & 0 & -8 \\\\ -1 & -3 & 0 & -4 \\\\ -2 & -6 & 0 & -8\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow \\left(-\\frac{1}{2}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & 0 & 4 \\\\ -1 & -3 & 0 & -4 \\\\ -2 & -6 & 0 & -8\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & 0 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ -2 & -6 & 0 & -8\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & 0 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x+3y &=4 \\\\ x &=4-3y\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}4-3y \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129d5d4b-c467-507d-af0a-12c52015026b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704906} {:answer/id #uuid "44db5142-9bfd-5df5-abc7-7993c7f65543" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -3 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704909} {:answer/id #uuid "61ffda14-2e35-5a26-ba3d-55fa6fd0f9f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -3 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704915} {:answer/id #uuid "7c1ad589-9b5e-5b2a-8247-5aa98856f8c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 3 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704919} {:answer/id #uuid "846cdfaf-6ab9-5bcd-8630-0f8bebd83235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 3 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704921}] :answer-field/correct {:db/id #edb/ref 17592186704919} :answer-field/id #uuid "de9c8b06-3967-5ff1-9d7b-1194aded4e30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704931}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "811bd99e-c6af-55cb-b5bc-855b0e879d3f" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-y-z &=-3 \\\\ -3y-3z &=-9 \\\\ y+z &=3\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}0 & -1 & -1 & -3 \\\\ 0 & -3 & -3 & -9 \\\\ 0 & 1 & 1 & 3\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow (-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 1 & 3 \\\\ 0 & -3 & -3 & -9 \\\\ 0 & 1 & 1 & 3\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 1 & 1 & 3\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $y$; the **free variables** are $x,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}y+z &=3 \\\\ y &=3-z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ 3-z \\\\ z\\end{bmatrix},\\quad x,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 3 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "511cacbc-fea1-555c-9cc5-83b2845b76a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704911} {:answer/id #uuid "a002187c-12b7-52b8-8f1c-d048e3e652a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704924} {:answer/id #uuid "a8c94e26-1195-5b2d-824d-99b8a20920a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704925} {:answer/id #uuid "c6536133-2d9c-5a99-a7e9-d13968347c88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704929} {:answer/id #uuid "f7890a56-f580-5c8a-8a9e-a65b391e2922" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704932}] :answer-field/correct {:db/id #edb/ref 17592186704929} :answer-field/id #uuid "6093b372-0d55-5bab-9328-5dfdfbca4213" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704913}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b8b8bef3-8386-58ec-ba79-9a6454699a9e" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-x+2z &=-1 \\\\ -3x+6z &=-3 \\\\ 2x-4z &=2\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-1 & 0 & 2 & -1 \\\\ -3 & 0 & 6 & -3 \\\\ 2 & 0 & -4 & 2\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow (-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 1 \\\\ -3 & 0 & 6 & -3 \\\\ 2 & 0 & -4 & 2\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 0 & -4 & 2\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x-2z &=1 \\\\ x &=1+2z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1+2z \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad3e3e5-1d44-587c-b00c-be0870cbb348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704933} {:answer/id #uuid "0e38cb8d-3110-553b-a73a-3d173472263f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704934} {:answer/id #uuid "1525de33-eb01-5d5d-8b98-1d3f791450ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704935} {:answer/id #uuid "28db3f0c-cbc1-5b21-a5c2-38268e74e792" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704939} {:answer/id #uuid "4926656e-5387-5a7e-b1ab-50b70cf436d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704942}] :answer-field/correct {:db/id #edb/ref 17592186704933} :answer-field/id #uuid "8e024e68-9e89-530f-b524-9a7b88940a38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704949}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2d3977f4-7c1b-5d85-aa1c-9bf62961dbf4" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=-2 \\\\ -2x-8y &=4 \\\\ -x-4y &=2\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 4 & 0 & -2 \\\\ -2 & -8 & 0 & 4 \\\\ -1 & -4 & 0 & 2\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 4 & 0 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ -1 & -4 & 0 & 2\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 4 & 0 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x+4y &=-2 \\\\ x &=-2-4y\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2-4y \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e92451e-d7a7-5ab9-bb2b-65897d899c25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704937} {:answer/id #uuid "2360547f-2082-5e4c-988b-e382fa08f7c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704938} {:answer/id #uuid "8179be20-ced8-563d-a680-cbebad089880" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704947} {:answer/id #uuid "a12aa1e2-9ccb-58ef-9abb-f2f492702ba9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704951} {:answer/id #uuid "aedfe954-0431-578a-85b3-cc2102507af7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704953}] :answer-field/correct {:db/id #edb/ref 17592186704937} :answer-field/id #uuid "c26e9e84-3ec6-5cc9-9ec3-61daf98b9de2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704956}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "adf8a5fb-3af6-597f-830b-a27345054aad" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-2x+6z &=4 \\\\ -2x+6z &=4 \\\\ 3x-9z &=-6\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 0 & 6 & 4 \\\\ -2 & 0 & 6 & 4 \\\\ 3 & 0 & -9 & -6\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow \\left(-\\frac{1}{2}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -3 & -2 \\\\ -2 & 0 & 6 & 4 \\\\ 3 & 0 & -9 & -6\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -3 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 3 & 0 & -9 & -6\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & -3 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x-3z &=-2 \\\\ x &=-2+3z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2+3z \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5907f5-f815-5335-9093-ad69e51c6ce2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704936} {:answer/id #uuid "28ff072b-c150-582b-aeed-bf9a7177cbe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704940} {:answer/id #uuid "6525bede-8ede-56a3-aa89-479dff268bf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704944} {:answer/id #uuid "9843b678-363a-5b05-b657-2d940735474a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704950} {:answer/id #uuid "e88e61e8-2b6b-5055-94cc-08867ce70cdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704957}] :answer-field/correct {:db/id #edb/ref 17592186704944} :answer-field/id #uuid "738bf24f-3312-5058-86c1-ec97be2bd632" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704945}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b3a40cc6-36af-5845-a5b3-2c76f7112714" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}2x+6y-2z &=10 \\\\ 2x+6y-2z &=10 \\\\ -2x-6y+2z &=-10\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 6 & -2 & 10 \\\\ 2 & 6 & -2 & 10 \\\\ -2 & -6 & 2 & -10\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow \\left(\\frac{1}{2}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & 5 \\\\ 2 & 6 & -2 & 10 \\\\ -2 & -6 & 2 & -10\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & 5 \\\\ 0 & 0 & 0 & 0 \\\\ -2 & -6 & 2 & -10\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & 5 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $x$; the **free variables** are $y,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}x+3y-z &=5 \\\\ x &=5-3y+z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5-3y+z \\\\ y \\\\ z\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad y,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5602f359-c95e-5ea6-adf7-e7ab0f3f8c82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704943} {:answer/id #uuid "7bb89031-f588-5d39-9169-bbcf0da93778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -4 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -4 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704946} {:answer/id #uuid "85b300cc-a834-5300-a7df-5fbd974052bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704948} {:answer/id #uuid "f4d0cf8e-2714-5b1b-88b7-71bd4e842fc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -4 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704959} {:answer/id #uuid "f91526f1-4202-5379-a77a-7156920e8cee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ -4 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}" :db/id #edb/ref 17592186704960}] :answer-field/correct {:db/id #edb/ref 17592186704946} :answer-field/id #uuid "b2e12a41-12fb-5664-aa00-aaeb45f060d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704954}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f029be8a-23f8-5266-b7e1-55fff6c535a3" :question/problem "Consider the system in variables $x,y,z$:\n\n$$\n\\left\\{\\begin{aligned}-y-4z &=4 \\\\ 2y+8z &=-8 \\\\ -2y-8z &=8\\end{aligned}\\right.\n$$\n\nUse Gaussian elimination to reduce its augmented matrix to row echelon form, and then find the general solution in vector form." :question/worked-solution "Keeping the columns in the order $x,y,z$, the augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}0 & -1 & -4 & 4 \\\\ 0 & 2 & 8 & -8 \\\\ 0 & -2 & -8 & 8\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1\\leftarrow (-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 4 & -4 \\\\ 0 & 2 & 8 & -8 \\\\ 0 & -2 & -8 & 8\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 4 & -4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -2 & -8 & 8\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 1 & 4 & -4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThere is one pivot. The two zero rows express $0=0$, so they impose no restrictions. The **basic variable** is $y$; the **free variables** are $x,z$. The remaining equation and its rearrangement are\n\n$$\n\\begin{aligned}y+4z &=-4 \\\\ y &=-4-4z\\end{aligned}\n$$\n\nThus all solutions are\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ -4-4z \\\\ z\\end{bmatrix},\\quad x,z\\in\\mathbb{R}\n$$\n\nSeparating the constant part and the contributions of the two free variables gives\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -4 \\\\ 0\\end{bmatrix}+x\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ -4 \\\\ 1\\end{bmatrix},\\quad x,z\\in\\mathbb{R}\n$$\n\nThe two free parameters range independently over all real numbers, so the solution set is a plane."}] [{:db/id #edb/ref 17592186704989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135598f1-99fe-54cb-b7e4-238df0c56290" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & -21\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704990} {:answer/id #uuid "5a9539b6-aa78-5990-8e54-457aa0178e41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & -9\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704998} {:answer/id #uuid "5b9c9d18-f2eb-54d9-a3a9-c43c7c588d46" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705000} {:answer/id #uuid "5e8224c3-7fa6-5819-8153-244cb8532d90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & -12\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705002} {:answer/id #uuid "cf8d31b6-0851-5f9f-84b4-7998f647c62c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & 15\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705010}] :answer-field/correct {:db/id #edb/ref 17592186705000} :answer-field/id #uuid "5affbd27-612d-5135-9cfa-ef82171f3850" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704999}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0ab5c9eb-9769-5683-9abf-e18ee3ef7756" :question/problem "Consider the augmented matrix with variable columns $x,y,z$:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ -2 & -1 & 5 & -9 \\\\ 1 & 4 & -6 & -9\\end{array}\\right]\n$$\n\nUse forward Gaussian elimination. Leave pivot rows **unscaled**, do not swap rows, and eliminate entries below successive pivots from left to right. Stop once echelon form is reached; do not perform further row operations. Select the **exact resulting matrix and solution conclusion**." :question/worked-solution "Start with the augmented matrix\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ -2 & -1 & 5 & -9 \\\\ 1 & 4 & -6 & -9\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2+2R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 1 & 4 & -6 & -9\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 3 & -3 & -12\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-3R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -3 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]\n$$\n\nThe final augmented update is $-12-(3)(-3)=-3$. The last row asserts $0=-3$, which is impossible. Hence the system has **no solution**. The absent coefficient pivot does not give a valid solution family in the presence of this contradiction."}] [{:db/id #edb/ref 17592186704993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e1ddb8-2d54-5291-aab7-3b70151a20a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704991} {:answer/id #uuid "2e4584b5-9254-58ad-ab94-58e42b8c3572" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 6\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704995} {:answer/id #uuid "9027a833-9725-5705-bd9e-a67c9881f079" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705006} {:answer/id #uuid "e0851166-573d-5750-ab8e-7f2ff18322f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 7\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705014} {:answer/id #uuid "f71762b9-17dd-51e4-895d-2be44344200a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 1\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705016}] :answer-field/correct {:db/id #edb/ref 17592186705006} :answer-field/id #uuid "559fc174-f8cb-5082-a7e6-16d1a286569c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704997}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "173684aa-ccb8-5095-b5e7-2a8417e09b20" :question/problem "Consider the augmented matrix with variable columns $x,y,z$:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ -1 & 4 & 4 & -1 \\\\ 1 & -5 & -5 & 6\\end{array}\\right]\n$$\n\nUse forward Gaussian elimination. Leave pivot rows **unscaled**, do not swap rows, and eliminate entries below successive pivots from left to right. Stop once echelon form is reached; do not perform further row operations. Select the **exact resulting matrix and solution conclusion**." :question/worked-solution "Start with the augmented matrix\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ -1 & 4 & 4 & -1 \\\\ 1 & -5 & -5 & 6\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2+R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 1 & -5 & -5 & 6\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & -2 & -2 & 5\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3+2R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -3 & 1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]\n$$\n\nThe final augmented update is $5-(-2)(0)=5$. The last row asserts $0=5$, which is impossible. Hence the system has **no solution**. The absent coefficient pivot does not give a valid solution family in the presence of this contradiction."}] [{:db/id #edb/ref 17592186705012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26026b49-dd55-5a25-9db2-44f664a86b61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704994} {:answer/id #uuid "68cb197f-a2c3-5084-9ffd-2d1b350cb1a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & -27\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705003} {:answer/id #uuid "b8c93c16-95b5-517d-9bdb-f9e1d3b963e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 1\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705009} {:answer/id #uuid "d0c314ab-7ab8-56b7-b1cb-a5ba8ae3a3d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705011} {:answer/id #uuid "d6e71202-41d4-5a04-b5ee-43eb893707a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 6\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705013}] :answer-field/correct {:db/id #edb/ref 17592186705011} :answer-field/id #uuid "3df92989-6126-5026-9370-52d5b9308c6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186704996}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d31348cb-cac8-5247-9076-ab3c3c507f60" :question/problem "Consider the augmented matrix with variable columns $x,y,z$:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ -2 & -2 & -1 & 7 \\\\ -2 & -2 & 1 & 10\\end{array}\\right]\n$$\n\nUse forward Gaussian elimination. Leave pivot rows **unscaled**, do not swap rows, and eliminate entries below successive pivots from left to right. Stop once echelon form is reached; do not perform further row operations. Select the **exact resulting matrix and solution conclusion**." :question/worked-solution "Start with the augmented matrix\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ -2 & -2 & -1 & 7 \\\\ -2 & -2 & 1 & 10\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2+2R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ -2 & -2 & 1 & 10\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3+2R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 3 & 6\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-3R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]\n$$\n\nAfter clearing the first column, the second column has no pivot, so the next pivot is in the third column. The final augmented update is $6-(3)(3)=-3$. The last row asserts $0=-3$, which is impossible. Hence the system has **no solution**. The absent coefficient pivot does not give a valid solution family in the presence of this contradiction."}] [{:db/id #edb/ref 17592186705015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a39358-82a1-5091-ad7d-883c788ea45e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186704992} {:answer/id #uuid "5e56d235-ace9-5783-9098-97b48a5736da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & -3\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705001} {:answer/id #uuid "732479ad-0e76-539f-b229-3cca0c87a51d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 7\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705004} {:answer/id #uuid "8b3c1093-ed7d-5672-b3d3-2e98aed1bd5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705005} {:answer/id #uuid "af8e2dba-3974-553e-b669-7bcc7c24a749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & -9\\end{array}\\right]$\n\nNo solution" :db/id #edb/ref 17592186705007}] :answer-field/correct {:db/id #edb/ref 17592186704992} :answer-field/id #uuid "b8004062-ef97-5f78-87b6-4ff916a41857" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705008}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "eb7ebf1f-741d-5f92-9e31-40b05dc9cccb" :question/problem "Consider the augmented matrix with variable columns $x,y,z$:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 2 & -2 & -5 & 3 \\\\ 1 & -1 & 0 & 2\\end{array}\\right]\n$$\n\nUse forward Gaussian elimination. Leave pivot rows **unscaled**, do not swap rows, and eliminate entries below successive pivots from left to right. Stop once echelon form is reached; do not perform further row operations. Select the **exact resulting matrix and solution conclusion**." :question/worked-solution "Start with the augmented matrix\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 2 & -2 & -5 & 3 \\\\ 1 & -1 & 0 & 2\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-2R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 1 & -1 & 0 & 2\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 3 & 0\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-3R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & -3 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 3\\end{array}\\right]\n$$\n\nAfter clearing the first column, the second column has no pivot, so the next pivot is in the third column. The final augmented update is $0-(3)(-1)=3$. The last row asserts $0=3$, which is impossible. Hence the system has **no solution**. The absent coefficient pivot does not give a valid solution family in the presence of this contradiction."}] [{:db/id #edb/ref 17592186705275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eeee876-ea72-52e0-aaea-9bffd896b2ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $p$" :db/id #edb/ref 17592186705289} {:answer/id #uuid "b58dc4a7-a1dd-5b86-bb15-a5b7b753ba83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-4$ and $-1$ only" :db/id #edb/ref 17592186705295} {:answer/id #uuid "b8317694-36cb-5e28-ab58-4c2875782073" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ only" :db/id #edb/ref 17592186705296} {:answer/id #uuid "c410ebc6-e22a-5175-a85d-358914011d9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $4$ only" :db/id #edb/ref 17592186705297} {:answer/id #uuid "e4da1484-aa24-5f55-a40f-2a25c854f291" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-4$ only" :db/id #edb/ref 17592186705300}] :answer-field/correct {:db/id #edb/ref 17592186705295} :answer-field/id #uuid "5dcec67b-11e2-5e44-9cda-f08fcea7fea4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705283}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "08a89fa1-a53d-5ad3-97c9-5f44159c8118" :question/problem "Find all real values of $p$ for which the following matrix is singular.\n\n$$\n\\begin{bmatrix}1 & -2 & 2 \\\\ - 3 p - 4 & 4 p + 7 & - 3 p - 3 \\\\ - 5 p - 8 & 6 p + 13 & - 5 p - 9\\end{bmatrix}\n$$" :question/worked-solution "Expand along the first row, using the signs $+,-,+$. Compute the three signed contributions separately:\n\n$$\n\\begin{aligned}T_{1} & =(1)\\begin{vmatrix}4 p + 7 & - 3 p - 3 \\\\ 6 p + 13 & - 5 p - 9\\end{vmatrix} \\\\  & =(1)((4 p + 7)(- 5 p - 9)-(- 3 p - 3)(6 p + 13)) \\\\  & =(1)(- 2 p^{2} - 14 p - 24) \\\\  & =- 2 p^{2} - 14 p - 24\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{2} & =-(-2)\\begin{vmatrix}- 3 p - 4 & - 3 p - 3 \\\\ - 5 p - 8 & - 5 p - 9\\end{vmatrix} \\\\  & =-(-2)((- 3 p - 4)(- 5 p - 9)-(- 3 p - 3)(- 5 p - 8)) \\\\  & =-(-2)(8 p + 12) \\\\  & =16 p + 24\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{3} & =(2)\\begin{vmatrix}- 3 p - 4 & 4 p + 7 \\\\ - 5 p - 8 & 6 p + 13\\end{vmatrix} \\\\  & =(2)((- 3 p - 4)(6 p + 13)-(4 p + 7)(- 5 p - 8)) \\\\  & =(2)(2 p^{2} + 4 p + 4) \\\\  & =4 p^{2} + 8 p + 8\\end{aligned}\n$$\n\nAdd the signed contributions to obtain the determinant:\n\n$$\n\\begin{aligned}D & =T_1+T_2+T_3 \\\\  & =2 p^{2} + 10 p + 8\\end{aligned}\n$$\n\nA singular matrix has determinant $0$.\n\n$$\n\\begin{aligned}2 p^{2} + 10 p + 8 & =0 \\\\ 2 (p + 1) (p + 4) & =0 \\\\ p & =-4,\\,-1\\end{aligned}\n$$\n\nTherefore, the solutions are $p=-4$ and $p=-1$."}] [{:db/id #edb/ref 17592186705285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "163fe3c5-117c-50d3-b4e4-1e1ab7ad0456" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ and $1$ only" :db/id #edb/ref 17592186705277} {:answer/id #uuid "278180ec-78bd-5264-b491-657694531bf1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ only" :db/id #edb/ref 17592186705279} {:answer/id #uuid "8ba48029-fb1a-5102-bac0-61297b575932" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $p$" :db/id #edb/ref 17592186705288} {:answer/id #uuid "a5a3c725-28b3-5c88-8b27-cf22ec5c389d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ and $2$ only" :db/id #edb/ref 17592186705292} {:answer/id #uuid "dc554ed9-06e6-50ac-af73-df339c379c7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ only" :db/id #edb/ref 17592186705298}] :answer-field/correct {:db/id #edb/ref 17592186705277} :answer-field/id #uuid "9682fd7b-3892-5768-8819-c647568b313a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705290}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "85af9268-b852-5f3d-84a0-5ddde79250a5" :question/problem "Find all real values of $p$ for which the following matrix is singular.\n\n$$\n\\begin{bmatrix}- p - 2 & - 2 p - 3 & p + 1 \\\\ 3 p + 3 & 4 p + 7 & - 3 p - 5 \\\\ -1 & -2 & 2\\end{bmatrix}\n$$" :question/worked-solution "Expand along the first row, using the signs $+,-,+$. Compute the three signed contributions separately:\n\n$$\n\\begin{aligned}T_{1} & =(- p - 2)\\begin{vmatrix}4 p + 7 & - 3 p - 5 \\\\ -2 & 2\\end{vmatrix} \\\\  & =(- p - 2)((4 p + 7)(2)-(- 3 p - 5)(-2)) \\\\  & =(- p - 2)(2 p + 4) \\\\  & =- 2 p^{2} - 8 p - 8\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{2} & =-(- 2 p - 3)\\begin{vmatrix}3 p + 3 & - 3 p - 5 \\\\ -1 & 2\\end{vmatrix} \\\\  & =-(- 2 p - 3)((3 p + 3)(2)-(- 3 p - 5)(-1)) \\\\  & =-(- 2 p - 3)(3 p + 1) \\\\  & =6 p^{2} + 11 p + 3\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{3} & =(p + 1)\\begin{vmatrix}3 p + 3 & 4 p + 7 \\\\ -1 & -2\\end{vmatrix} \\\\  & =(p + 1)((3 p + 3)(-2)-(4 p + 7)(-1)) \\\\  & =(p + 1)(1 - 2 p) \\\\  & =- 2 p^{2} - p + 1\\end{aligned}\n$$\n\nAdd the signed contributions to obtain the determinant:\n\n$$\n\\begin{aligned}D & =T_1+T_2+T_3 \\\\  & =2 p^{2} + 2 p - 4\\end{aligned}\n$$\n\nA singular matrix has determinant $0$.\n\n$$\n\\begin{aligned}2 p^{2} + 2 p - 4 & =0 \\\\ 2 (p - 1) (p + 2) & =0 \\\\ p & =-2,\\,1\\end{aligned}\n$$\n\nTherefore, the solutions are $p=-2$ and $p=1$."}] [{:db/id #edb/ref 17592186705286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1541c782-1eb4-5ec0-9322-8520916fd484" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $p$" :db/id #edb/ref 17592186705276} {:answer/id #uuid "26126201-c1f2-5abe-a041-50e7fbd8ba7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ only" :db/id #edb/ref 17592186705278} {:answer/id #uuid "5fb0b957-012c-5eca-9568-4b483ff395a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-1$ and $4$ only" :db/id #edb/ref 17592186705284} {:answer/id #uuid "98dfc3d5-043c-5b2e-9cc9-d096d0e3a9c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-4$ only" :db/id #edb/ref 17592186705291} {:answer/id #uuid "fd0aae61-15f0-50e9-b4b9-f63acd7eb26c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-4$ and $1$ only" :db/id #edb/ref 17592186705302}] :answer-field/correct {:db/id #edb/ref 17592186705276} :answer-field/id #uuid "31a4fc94-2a07-5a72-9b1c-b56a92072074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705281}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "869472d3-d923-5499-8798-74bf41a36e0a" :question/problem "Find all real values of $p$ for which the following matrix is singular.\n\n$$\n\\begin{bmatrix}- 2 p - 1 & p & p + 2 \\\\ 2 p - 1 & 1 - p & - p \\\\ -2 & 1 & 2\\end{bmatrix}\n$$" :question/worked-solution "Expand along the first row, using the signs $+,-,+$. Compute the three signed contributions separately:\n\n$$\n\\begin{aligned}T_{1} & =(- 2 p - 1)\\begin{vmatrix}1 - p & - p \\\\ 1 & 2\\end{vmatrix} \\\\  & =(- 2 p - 1)((1 - p)(2)-(- p)(1)) \\\\  & =(- 2 p - 1)(2 - p) \\\\  & =2 p^{2} - 3 p - 2\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{2} & =-(p)\\begin{vmatrix}2 p - 1 & - p \\\\ -2 & 2\\end{vmatrix} \\\\  & =-(p)((2 p - 1)(2)-(- p)(-2)) \\\\  & =-(p)(2 p - 2) \\\\  & =- 2 p^{2} + 2 p\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{3} & =(p + 2)\\begin{vmatrix}2 p - 1 & 1 - p \\\\ -2 & 1\\end{vmatrix} \\\\  & =(p + 2)((2 p - 1)(1)-(1 - p)(-2)) \\\\  & =(p + 2)(1) \\\\  & =p + 2\\end{aligned}\n$$\n\nAdd the signed contributions to obtain the determinant:\n\n$$\n\\begin{aligned}D & =T_1+T_2+T_3 \\\\  & =0\\end{aligned}\n$$\n\nThe determinant is $0$ for every real value of $p$. Therefore, the matrix is singular for every real value of $p$."}] [{:db/id #edb/ref 17592186705287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be13b03-5b80-500d-8b75-064858690378" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ only" :db/id #edb/ref 17592186705282} {:answer/id #uuid "b1ad5c23-8bd9-53aa-a17e-08702a71de72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Any value of $p$" :db/id #edb/ref 17592186705293} {:answer/id #uuid "b58d939e-b8d3-5fa6-a73c-19864c42aaac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-2$ and $-1$ only" :db/id #edb/ref 17592186705294} {:answer/id #uuid "e374ec34-e113-5dee-9eac-36b84549986f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ only" :db/id #edb/ref 17592186705299} {:answer/id #uuid "ee05a336-ebc8-5ca9-8ba3-8387290a4d74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $2$ only" :db/id #edb/ref 17592186705301}] :answer-field/correct {:db/id #edb/ref 17592186705299} :answer-field/id #uuid "2bf63112-d210-58cb-911f-c3cc2e1b3a7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705280}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8730b36b-1834-5182-9c12-0cd8c03fa744" :question/problem "Find all real values of $p$ for which the following matrix is singular.\n\n$$\n\\begin{bmatrix}2 p & - p - 1 & 1 - p \\\\ -2 & 2 & 1 \\\\ 2 p - 5 & 4 - p & 3 - p\\end{bmatrix}\n$$" :question/worked-solution "Expand along the first row, using the signs $+,-,+$. Compute the three signed contributions separately:\n\n$$\n\\begin{aligned}T_{1} & =(2 p)\\begin{vmatrix}2 & 1 \\\\ 4 - p & 3 - p\\end{vmatrix} \\\\  & =(2 p)((2)(3 - p)-(1)(4 - p)) \\\\  & =(2 p)(2 - p) \\\\  & =- 2 p^{2} + 4 p\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{2} & =-(- p - 1)\\begin{vmatrix}-2 & 1 \\\\ 2 p - 5 & 3 - p\\end{vmatrix} \\\\  & =-(- p - 1)((-2)(3 - p)-(1)(2 p - 5)) \\\\  & =-(- p - 1)(-1) \\\\  & =- p - 1\\end{aligned}\n$$\n\n$$\n\\begin{aligned}T_{3} & =(1 - p)\\begin{vmatrix}-2 & 2 \\\\ 2 p - 5 & 4 - p\\end{vmatrix} \\\\  & =(1 - p)((-2)(4 - p)-(2)(2 p - 5)) \\\\  & =(1 - p)(2 - 2 p) \\\\  & =2 p^{2} - 4 p + 2\\end{aligned}\n$$\n\nAdd the signed contributions to obtain the determinant:\n\n$$\n\\begin{aligned}D & =T_1+T_2+T_3 \\\\  & =1 - p\\end{aligned}\n$$\n\nA singular matrix has determinant $0$.\n\n$$\n\\begin{aligned}1 - p & =0 \\\\ - p & =-1 \\\\ p & =1\\end{aligned}\n$$\n\nTherefore, the solution is $p=1$."}] [{:db/id #edb/ref 17592186716634 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Allowing $y$ to vary requires $x$ to vary as $3-2y$." :answer/id #uuid "31384dc2-fd15-5bde-87e1-d8d05bc46d40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716635} {:answer/feedback "The equation $3z=3$ gives $z=1$, not $3$." :answer/id #uuid "462572cd-58a5-54fb-9b36-b41dccf505ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2y \\\\ y \\\\ 3\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716638} {:answer/feedback "Clearing the $z$ coefficient also changes the constant from $2$ to $3$." :answer/id #uuid "54ae90f3-2cae-55fd-9f74-f578edee1521" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2-2y \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716639} {:answer/feedback "The nonpivot variable is $y$; the pivot variable $z$ is fixed at $1$." :answer/id #uuid "a893ccc9-c4ef-5602-afa6-f3e9316d8522" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2y \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716643} {:answer/feedback "The equation $x+2y=3$ gives $x=3-2y$." :answer/id #uuid "fb9a6b2b-be12-56f5-861f-0e1c5d48ba36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3+2y \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716649}] :answer-field/correct {:db/id #edb/ref 17592186716643} :answer-field/id #uuid "3ffb5c36-c1ed-53f6-bff9-cd67994254d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716637}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "287dc12d-b98e-5f1f-b216-0b0b775b7e37" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y+z &=7 \\\\ x+2y-z &=2\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ to reduced row echelon form, and then solve the system. Select the general solution in the variable order $x,y,z$." :question/worked-solution "The augmented matrix, with columns in the stated variable order, is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 4 & 1 & 7 \\\\ 1 & 2 & -1 & 2\\end{array}\\right]\n$$\n\nApply $R_1\\leftrightarrow R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & -1 & 2 \\\\ 2 & 4 & 1 & 7\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-2R_1$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & -1 & 2 \\\\ 0 & 0 & 3 & 3\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow \\frac13 R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & -1 & 2 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nApply $R_1\\leftarrow R_1+R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThis is reduced row echelon form. After the first elimination, both the $x$ and $y$ coefficients vanish in the second row. The next pivot is therefore in the $z$ column, not the $y$ column. In the final matrix the pivot variables are $x$ and $z$, while $y$ is free. The corresponding equations are\n\n$$\n\\left\\{\\begin{aligned}x+2y &=3 \\\\ z &=1\\end{aligned}\\right.\n$$\n\nTherefore $x=3-2y$, $z=1$, and $y$ can be any real number. The general solution is\n\n$$\n\\begin{bmatrix}3-2y \\\\ y \\\\ 1\\end{bmatrix},\\quad y\\in\\mathbb{R}\n$$\n\nSubstitution gives $2(3-2y)+4y+1=7$ and $(3-2y)+2y-1=2$ for every real $y$."}] [{:db/id #edb/ref 17592186716646 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The first pivot equation gives $x=3-2z$, so the sign of the $z$ term is wrong." :answer/id #uuid "1e3c238b-14c4-547a-b026-e0f63c99171b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3+2z \\\\ 1+z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}" :db/id #edb/ref 17592186716632} {:answer/feedback "From $y-z=1$, we get $y=1+z$." :answer/id #uuid "2038e632-056f-53e5-b4d0-b8288ce5d0eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2z \\\\ 1-z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}" :db/id #edb/ref 17592186716633} {:answer/feedback "Both pivot variables are expressed in terms of the free variable $z$." :answer/id #uuid "3f3885f0-9529-5a1d-a5de-e3c0c5e1559e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2z \\\\ 1+z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}" :db/id #edb/ref 17592186716636} {:answer/feedback "Subtract the constants as well as the coefficients: $4-1=3$." :answer/id #uuid "77edc1fc-dd77-536c-836f-5390418718d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4-2z \\\\ 1+z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}" :db/id #edb/ref 17592186716642} {:answer/feedback "This is only the solution with $z=0$. The question asks for every solution." :answer/id #uuid "c02c23cb-88aa-5181-947c-e39bc6347144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186716645}] :answer-field/correct {:db/id #edb/ref 17592186716636} :answer-field/id #uuid "0ace548b-c4c3-5737-9833-056407587ce8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716629}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c493fe01-3f68-578b-adae-91107fa6c9c3" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=4 \\\\ y-z &=1\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ to reduced row echelon form, and then solve the system. Select the general solution in the variable order $x,y,z$." :question/worked-solution "The augmented matrix, with columns in the stated variable order, is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 4 \\\\ 0 & 1 & -1 & 1\\end{array}\\right]\n$$\n\nApply $R_1\\leftarrow R_1-R_2$:\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & 1 & -1 & 1\\end{array}\\right]\n$$\n\nThis is reduced row echelon form. The pivot columns correspond to $x$ and $y$; $z$ is free. The corresponding equations are\n\n$$\n\\left\\{\\begin{aligned}x+2z &=3 \\\\ y-z &=1\\end{aligned}\\right.\n$$\n\nThus $x=3-2z$ and $y=1+z$, while $z$ can be any real number. The general solution is\n\n$$\n\\begin{bmatrix}3-2z \\\\ 1+z \\\\ z\\end{bmatrix},\\quad z\\in\\mathbb{R}\n$$\n\nFor every real $z$, substitution gives $(3-2z)+(1+z)+z=4$ and $(1+z)-z=1$."}] [{:db/id #edb/ref 17592186716648 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This forces $w=y$ and leaves out valid solutions where the two free variables differ." :answer/id #uuid "1702c7af-22cf-5980-8d05-1780959ae954" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-y \\\\ y \\\\ -1-2y \\\\ y\\end{bmatrix},\\quad y\\in\\mathbb{R}" :db/id #edb/ref 17592186716630} {:answer/feedback "This is just one solution, obtained by taking $y=w=0$." :answer/id #uuid "5718aafd-2a50-5157-b063-1c78a6a2d348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186716640} {:answer/feedback "The first pivot equation gives $x=3-2y+w$." :answer/id #uuid "68ab3c01-58a2-5813-8f69-ee809a82e77a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3+2y+w \\\\ y \\\\ -1-2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716641} {:answer/feedback "Both free variables vary independently, and the pivot equations determine $x$ and $z$." :answer/id #uuid "ac581172-a2d1-53a9-bc31-065f73225a7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2y+w \\\\ y \\\\ -1-2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716644} {:answer/feedback "The pivot equations give $x=3-2y+w$ and $z=-1-2w$; both parameter signs here are wrong." :answer/id #uuid "dd912ed2-6123-5faa-a141-8de452a153b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-2y-w \\\\ y \\\\ -1+2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}" :db/id #edb/ref 17592186716647}] :answer-field/correct {:db/id #edb/ref 17592186716644} :answer-field/id #uuid "1bac10f3-b02d-5af5-9337-7b5d9fadc082" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716631}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e2021192-1d14-52d3-9800-a26b51473bca" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+2y+z+w &=2 \\\\ x+2y-z-3w &=4 \\\\ 2x+4y-2w &=6\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ to reduced row echelon form, and then solve the system. Select the general solution in the variable order $x,y,z,w$." :question/worked-solution "The augmented matrix, with columns in the stated variable order, is\n\n$$\nM=\\left[\\begin{array}{cccc|c}1 & 2 & 1 & 1 & 2 \\\\ 1 & 2 & -1 & -3 & 4 \\\\ 2 & 4 & 0 & -2 & 6\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-R_1$:\n\n$$\n\\left[\\begin{array}{cccc|c}1 & 2 & 1 & 1 & 2 \\\\ 0 & 0 & -2 & -4 & 2 \\\\ 2 & 4 & 0 & -2 & 6\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-2R_1$:\n\n$$\n\\left[\\begin{array}{cccc|c}1 & 2 & 1 & 1 & 2 \\\\ 0 & 0 & -2 & -4 & 2 \\\\ 0 & 0 & -2 & -4 & 2\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow -\\frac12 R_2$:\n\n$$\n\\left[\\begin{array}{cccc|c}1 & 2 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 2 & -1 \\\\ 0 & 0 & -2 & -4 & 2\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3+2R_2$:\n\n$$\n\\left[\\begin{array}{cccc|c}1 & 2 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 2 & -1 \\\\ 0 & 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nApply $R_1\\leftarrow R_1-R_2$:\n\n$$\n\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -1 & 3 \\\\ 0 & 0 & 1 & 2 & -1 \\\\ 0 & 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThis is reduced row echelon form. The zero row represents $0=0$ and imposes no restriction. The pivots are in the $x$ and $z$ columns, so both $y$ and $w$ are free. The nonzero rows give\n\n$$\n\\left\\{\\begin{aligned}x+2y-w &=3 \\\\ z+2w &=-1\\end{aligned}\\right.\n$$\n\nSolving for the pivot variables gives $x=3-2y+w$ and $z=-1-2w$. Thus the general solution is\n\n$$\n\\begin{bmatrix}3-2y+w \\\\ y \\\\ -1-2w \\\\ w\\end{bmatrix},\\quad y,w\\in\\mathbb{R}\n$$\n\nThe values of $y$ and $w$ can be chosen independently. Substitution into the three original left-hand sides gives $2$, $4$, and $6$, respectively, for every pair of real values. Conversely, every solution must satisfy the two pivot equations, so this vector includes all solutions. Setting $w=y$ would omit solutions; for example, $(4,0,-3,1)$ is a solution with different values of $w$ and $y$. A single vector such as $(3,0,-1,0)$ is only one solution."}] [{:db/id #edb/ref 17592186716824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cff85c2-ecc3-594e-9344-b48b08ff207d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-6 \\\\ w-3 \\\\ -2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716826} {:answer/id #uuid "78b38e6a-3a8d-5e35-8b42-1970d98bf650" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-6 \\\\ w+6 \\\\ 2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716836} {:answer/id #uuid "a14a5627-8a55-5ef1-bf26-67aded9d6faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w+6 \\\\ w-4 \\\\ 6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716842} {:answer/id #uuid "ace39982-b202-57bf-bc21-531d83757de6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w+5 \\\\ w-4 \\\\ 5 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716843} {:answer/id #uuid "bd70cfd0-0813-5aa4-aecd-8ef9679dcd19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w+6 \\\\ w+6 \\\\ 1 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716846}] :answer-field/correct {:db/id #edb/ref 17592186716826} :answer-field/id #uuid "6af90c20-f105-57e3-a58d-eb09b3f21b42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716834}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04a8f200-6733-59d8-8652-e057515529b3" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+4z+4w &=-14 \\\\ -2x+5y-7z-7w &=11 \\\\ -2x+3y-3z-5w &=9.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & -2 & 4 & 4 & -14 \\\\ -2 & 5 & -7 & -7 & 11 \\\\ -2 & 3 & -3 & -5 & 9\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & -2 & 4 & 4 & -14 \\\\ -2 & 5 & -7 & -7 & 11 \\\\ -2 & 3 & -3 & -5 & 9\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ -2 & 5 & -7 & -7 & 11 \\\\ -2 & 3 & -3 & -5 & 9\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 3 & -3 & -3 & -3 \\\\ -2 & 3 & -3 & -5 & 9\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 3 & -3 & -3 & -3 \\\\ 0 & 1 & 1 & -1 & -5\\end{array}\\right] \\\\ & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 1 & -1 & -1 & -1 \\\\ 0 & 1 & 1 & -1 & -5\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 1 & -1 & -1 & -1 \\\\ 0 & 0 & 2 & 0 & -4\\end{array}\\right] \\\\ & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 1 & -1 & -1 & -1 \\\\ 0 & 0 & 1 & 0 & -2\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 2 & 2 & -7 \\\\ 0 & 1 & 0 & -1 & -3 \\\\ 0 & 0 & 1 & 0 & -2\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 0 & 2 & -3 \\\\ 0 & 1 & 0 & -1 & -3 \\\\ 0 & 0 & 1 & 0 & -2\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 1 & -6 \\\\ 0 & 1 & 0 & -1 & -3 \\\\ 0 & 0 & 1 & 0 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+w &=-6 \\\\ y-w &=-3 \\\\ z &=-2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-w-6 \\\\ y &=w-3 \\\\ z &=-2 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-w-6 \\\\ w-3 \\\\ -2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186716828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23105e54-b57d-5473-8bed-6683ce59ae88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w-4 \\\\ w+1 \\\\ 2w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716829} {:answer/id #uuid "72fbcd6a-9da8-5231-b04b-bd293f169911" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w-4 \\\\ w-2 \\\\ 2w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716835} {:answer/id #uuid "96fae066-d67c-551b-8c37-553ce9976a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w+6 \\\\ w-4 \\\\ 2w+5 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716840} {:answer/id #uuid "d08f2293-434d-583a-bfdd-73c9a88e359b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w-8 \\\\ w-4 \\\\ 2w-5 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716850} {:answer/id #uuid "f0eed5d2-8b8c-55a7-9498-da6ef0c4d4a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3w+6 \\\\ w-2 \\\\ 2w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716855}] :answer-field/correct {:db/id #edb/ref 17592186716855} :answer-field/id #uuid "eda06fc3-a51b-5718-8e74-6a559fe0a405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716854}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "15a716d8-b779-5923-be2e-3320154178b3" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y+4z-10w &=4 \\\\ -x+5y-5z+8w &=4 \\\\ -2x+6y-4z+8w &=-8.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & -4 & 4 & -10 & 4 \\\\ -1 & 5 & -5 & 8 & 4 \\\\ -2 & 6 & -4 & 8 & -8\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & -4 & 4 & -10 & 4 \\\\ -1 & 5 & -5 & 8 & 4 \\\\ -2 & 6 & -4 & 8 & -8\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ -1 & 5 & -5 & 8 & 4 \\\\ -2 & 6 & -4 & 8 & -8\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 3 & -3 & 3 & 6 \\\\ -2 & 6 & -4 & 8 & -8\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 3 & -3 & 3 & 6 \\\\ 0 & 2 & 0 & -2 & -4\\end{array}\\right] \\\\ & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 1 & -1 & 1 & 2 \\\\ 0 & 2 & 0 & -2 & -4\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 1 & -1 & 1 & 2 \\\\ 0 & 0 & 2 & -4 & -8\\end{array}\\right] \\\\ & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 1 & -1 & 1 & 2 \\\\ 0 & 0 & 1 & -2 & -4\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 2 & -5 & 2 \\\\ 0 & 1 & 0 & -1 & -2 \\\\ 0 & 0 & 1 & -2 & -4\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -2 & 0 & -1 & 10 \\\\ 0 & 1 & 0 & -1 & -2 \\\\ 0 & 0 & 1 & -2 & -4\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -3 & 6 \\\\ 0 & 1 & 0 & -1 & -2 \\\\ 0 & 0 & 1 & -2 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3w &=6 \\\\ y-w &=-2 \\\\ z-2w &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3w+6 \\\\ y &=w-2 \\\\ z &=2w-4 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}3w+6 \\\\ w-2 \\\\ 2w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186716831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb80a41-c9fa-52b5-a560-cec9565bd495" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-1 \\\\ 2w+1 \\\\ 2w-4 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716827} {:answer/id #uuid "617478c0-dedc-5f9e-8065-af3f877e1929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w+3 \\\\ 2w-2 \\\\ 2w+1 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716833} {:answer/id #uuid "7e3880b5-50a0-5b32-8896-0807face5402" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-1 \\\\ 2w-1 \\\\ 2w-2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716837} {:answer/id #uuid "96be94e1-9291-5a47-a8aa-6cb6012e88d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w-2 \\\\ 2w+1 \\\\ 2w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716839} {:answer/id #uuid "c2155071-2e81-58b0-ba3e-07e73d2919a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-w+3 \\\\ 2w-1 \\\\ 2w+2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716847}] :answer-field/correct {:db/id #edb/ref 17592186716833} :answer-field/id #uuid "2e6b1805-828c-581e-a79c-fb5fd7b8233f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716830}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4a2718e7-1cb2-53ba-9266-313709a6a3cd" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y-2z-2w &=-4 \\\\ -2x-y+5z-10w &=1 \\\\ -x-4y+z+5w &=6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 4 & -2 & -2 & -4 \\\\ -2 & -1 & 5 & -10 & 1 \\\\ -1 & -4 & 1 & 5 & 6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 4 & -2 & -2 & -4 \\\\ -2 & -1 & 5 & -10 & 1 \\\\ -1 & -4 & 1 & 5 & 6\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ -2 & -1 & 5 & -10 & 1 \\\\ -1 & -4 & 1 & 5 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 3 & 3 & -12 & -3 \\\\ -1 & -4 & 1 & 5 & 6\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 3 & 3 & -12 & -3 \\\\ 0 & -2 & 0 & 4 & 4\\end{array}\\right] \\\\ & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 1 & 1 & -4 & -1 \\\\ 0 & -2 & 0 & 4 & 4\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 1 & 1 & -4 & -1 \\\\ 0 & 0 & 2 & -4 & 2\\end{array}\\right] \\\\ & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 1 & 1 & -4 & -1 \\\\ 0 & 0 & 1 & -2 & 1\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & -1 & -1 & -2 \\\\ 0 & 1 & 0 & -2 & -2 \\\\ 0 & 0 & 1 & -2 & 1\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 2 & 0 & -3 & -1 \\\\ 0 & 1 & 0 & -2 & -2 \\\\ 0 & 0 & 1 & -2 & 1\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 1 & 3 \\\\ 0 & 1 & 0 & -2 & -2 \\\\ 0 & 0 & 1 & -2 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+w &=3 \\\\ y-2w &=-2 \\\\ z-2w &=1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-w+3 \\\\ y &=2w-2 \\\\ z &=2w+1 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-w+3 \\\\ 2w-2 \\\\ 2w+1 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186716841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b98400e9-b117-5bc4-9605-0b1f0294de16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}w-4 \\\\ 3w-3 \\\\ -w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716844} {:answer/id #uuid "b9926fff-96c2-545d-8463-fcf91c7a5dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}w-3 \\\\ 3w+3 \\\\ -w+6 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716845} {:answer/id #uuid "c8f77741-692a-5741-9b8b-ccef6e83ae5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}w-4 \\\\ 3w+1 \\\\ -w+3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716848} {:answer/id #uuid "cce71908-133f-5fae-9210-e76c5377cb8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}w-2 \\\\ 3w+1 \\\\ -w-5 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716849} {:answer/id #uuid "e065d76a-5aee-5a56-b8e8-bdd8662cf6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}w-2 \\\\ 3w+3 \\\\ -w+2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186716851}] :answer-field/correct {:db/id #edb/ref 17592186716851} :answer-field/id #uuid "ff66c047-8898-5219-8479-bbbf0b0e29b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716857}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ab3d8ef-af42-525d-8610-a74602463bfa" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y+2z-6w &=6 \\\\ 2x+5y-z-18w &=9 \\\\ x+3y+z-9w &=9.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -6 & 6 \\\\ 2 & 5 & -1 & -18 & 9 \\\\ 1 & 3 & 1 & -9 & 9\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cccc|c}2 & 2 & 2 & -6 & 6 \\\\ 2 & 5 & -1 & -18 & 9 \\\\ 1 & 3 & 1 & -9 & 9\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 2 & 5 & -1 & -18 & 9 \\\\ 1 & 3 & 1 & -9 & 9\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 3 & -3 & -12 & 3 \\\\ 1 & 3 & 1 & -9 & 9\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 3 & -3 & -12 & 3 \\\\ 0 & 2 & 0 & -6 & 6\\end{array}\\right] \\\\ & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -4 & 1 \\\\ 0 & 2 & 0 & -6 & 6\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -4 & 1 \\\\ 0 & 0 & 2 & 2 & 4\\end{array}\\right] \\\\ & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 1 & -1 & -4 & 1 \\\\ 0 & 0 & 1 & 1 & 2\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 1 & -3 & 3 \\\\ 0 & 1 & 0 & -3 & 3 \\\\ 0 & 0 & 1 & 1 & 2\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 1 & 0 & -4 & 1 \\\\ 0 & 1 & 0 & -3 & 3 \\\\ 0 & 0 & 1 & 1 & 2\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & -1 & -2 \\\\ 0 & 1 & 0 & -3 & 3 \\\\ 0 & 0 & 1 & 1 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-w &=-2 \\\\ y-3w &=3 \\\\ z+w &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=w-2 \\\\ y &=3w+3 \\\\ z &=-w+2 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}w-2 \\\\ 3w+3 \\\\ -w+2 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$"}]}
