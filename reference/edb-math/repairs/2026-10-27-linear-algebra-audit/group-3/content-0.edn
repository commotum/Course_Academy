/ref 17592186612448}] :knowledge-point/title "Identifying Entries of a Matrix Product Representing a 3x3 System of Equations by Reorganizing"}] [{:db/id #edb/ref 17592186059847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059452} :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048965}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186702207} :knowledge-point/questions [{:db/id #edb/ref 17592186060278} {:db/id #edb/ref 17592186060455} {:db/id #edb/ref 17592186262882} {:db/id #edb/ref 17592186292868} {:db/id #edb/ref 17592186295135} {:db/id #edb/ref 17592186295136} {:db/id #edb/ref 17592186295137} {:db/id #edb/ref 17592186295138} {:db/id #edb/ref 17592186295139} {:db/id #edb/ref 17592186323974} {:db/id #edb/ref 17592186323975} {:db/id #edb/ref 17592186326669} {:db/id #edb/ref 17592186326670} {:db/id #edb/ref 17592186326672} {:db/id #edb/ref 17592186364948} {:db/id #edb/ref 17592186534217} {:db/id #edb/ref 17592186534218} {:db/id #edb/ref 17592186534226} {:db/id #edb/ref 17592186534228} {:db/id #edb/ref 17592186534229} {:db/id #edb/ref 17592186534234} {:db/id #edb/ref 17592186534237} {:db/id #edb/ref 17592186534244} {:db/id #edb/ref 17592186534246} {:db/id #edb/ref 17592186534251} {:db/id #edb/ref 17592186600364} {:db/id #edb/ref 17592186600391} {:db/id #edb/ref 17592186702015} {:db/id #edb/ref 17592186702017} {:db/id #edb/ref 17592186702022} {:db/id #edb/ref 17592186702179} {:db/id #edb/ref 17592186702189} {:db/id #edb/ref 17592186702193} {:db/id #edb/ref 17592186702201} {:db/id #edb/ref 17592186702206}] :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] [{:db/id #edb/ref 17592186059848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059453} :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049125}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186702351} :knowledge-point/questions [{:db/id #edb/ref 17592186060020} {:db/id #edb/ref 17592186060454} {:db/id #edb/ref 17592186262906} {:db/id #edb/ref 17592186262908} {:db/id #edb/ref 17592186262913} {:db/id #edb/ref 17592186326671} {:db/id #edb/ref 17592186326673} {:db/id #edb/ref 17592186336011} {:db/id #edb/ref 17592186345302} {:db/id #edb/ref 17592186345303} {:db/id #edb/ref 17592186345304} {:db/id #edb/ref 17592186366794} {:db/id #edb/ref 17592186400345} {:db/id #edb/ref 17592186400352} {:db/id #edb/ref 17592186400359} {:db/id #edb/ref 17592186402609} {:db/id #edb/ref 17592186403335} {:db/id #edb/ref 17592186529209} {:db/id #edb/ref 17592186529214} {:db/id #edb/ref 17592186529220} {:db/id #edb/ref 17592186529229} {:db/id #edb/ref 17592186529250} {:db/id #edb/ref 17592186702041} {:db/id #edb/ref 17592186702063} {:db/id #edb/ref 17592186702067} {:db/id #edb/ref 17592186702298} {:db/id #edb/ref 17592186702299} {:db/id #edb/ref 17592186702321} {:db/id #edb/ref 17592186702322} {:db/id #edb/ref 17592186702338}] :knowledge-point/title "Identifying Singular Matrices"}] [{:db/id #edb/ref 17592186059849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059454} :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050465}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186705303} :knowledge-point/questions [{:db/id #edb/ref 17592186060446} {:db/id #edb/ref 17592186060447} {:db/id #edb/ref 17592186060456} {:db/id #edb/ref 17592186262917} {:db/id #edb/ref 17592186262918} {:db/id #edb/ref 17592186265935} {:db/id #edb/ref 17592186265937} {:db/id #edb/ref 17592186265943} {:db/id #edb/ref 17592186265945} {:db/id #edb/ref 17592186287820} {:db/id #edb/ref 17592186287821} {:db/id #edb/ref 17592186287824} {:db/id #edb/ref 17592186287825} {:db/id #edb/ref 17592186295140} {:db/id #edb/ref 17592186295141} {:db/id #edb/ref 17592186295151} {:db/id #edb/ref 17592186295160} {:db/id #edb/ref 17592186295161} {:db/id #edb/ref 17592186362340} {:db/id #edb/ref 17592186362379} {:db/id #edb/ref 17592186365547} {:db/id #edb/ref 17592186365550} {:db/id #edb/ref 17592186396237} {:db/id #edb/ref 17592186400366} {:db/id #edb/ref 17592186600360} {:db/id #edb/ref 17592186600397} {:db/id #edb/ref 17592186637238} {:db/id #edb/ref 17592186702214} {:db/id #edb/ref 17592186702228} {:db/id #edb/ref 17592186702231} {:db/id #edb/ref 17592186702234} {:db/id #edb/ref 17592186702239} {:db/id #edb/ref 17592186705275} {:db/id #edb/ref 17592186705285} {:db/id #edb/ref 17592186705286} {:db/id #edb/ref 17592186705287}] :knowledge-point/title "Solving for an Unknown Given the Determinant"}] [{:db/id #edb/ref 17592186060935 :tutorial/content "Remember that we can represent a system of two linear equations in two variables using matrices. We can do the same thing for a system of three linear equations in three variables, such as the following:\n\n$$\n\\left\\{\\begin{aligned}3x+2y\\text{ }-\\text{ }2z &=7 \\\\ 2x\\text{ }-\\text{ }1y\\text{ }-\\text{ }4z &=2 \\\\ 2x+1y\\text{ }-\\text{ }3z &=3\\end{aligned}\\right.\n$$\n\nFor a $3 \\times 3$ system like the one above, we put the coefficients of the system into a $3 \\times 3$ coefficient matrix:\n\n\n\n$$\nA= \\begin{bmatrix}{\\color{blue}3} & {\\color{blue}2} & {\\color{blue}-2} \\\\ {\\color{blue}2} & {\\color{blue}-1} & {\\color{blue}-4} \\\\ {\\color{blue}2} & {\\color{blue}1} & {\\color{blue}-3}\\end{bmatrix}.\n$$\n\n\n\nEach row has the coefficients of one of the equations in the system, and each column consists of the coefficients of one particular variable.\nWe also have the $3 \\times 1$ column vectors\n\n\n\n$$\n\\mathbf{b} = \\begin{bmatrix}{\\color{red}7} \\\\ {\\color{red}2} \\\\ {\\color{red}3}\\end{bmatrix} \\quad \\text{and} \\quad \\mathbf{x} = \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix},\n$$\n\n\n\nwhere $\\mathbf{b}$ consists of each constant on the right side of the system and $\\mathbf{x}$ contains the variables.\nWith these matrices, we can write our system as $A\\mathbf{x} = \\mathbf{b},$ or\n\n\n\n$$\n\\begin{bmatrix}{\\color{blue}3} & {\\color{blue}2} & {\\color{blue}-2} \\\\ {\\color{blue}2} & {\\color{blue}-1} & {\\color{blue}-4} \\\\ {\\color{blue}2} & {\\color{blue}1} & {\\color{blue}-3}\\end{bmatrix} \\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} =\\begin{bmatrix}{\\color{red}7} \\\\ {\\color{red}2} \\\\ {\\color{red}3}\\end{bmatrix}.\n$$\n\n\n\nWe can write any system of three equations with three variables in this form. Just to check that the above equation is true, let's multiply out the left-hand side to see if it equals the right-hand side:\n\n$$\n\\begin{aligned}Ax & =\\begin{bmatrix}3 & 2 & -2 \\\\ 2 & -1 & -4 \\\\ 2 & 1 & -3\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} \\\\  & =\\begin{bmatrix}3x+2y\\text{ }-\\text{ }2z \\\\ 2x\\text{ }-\\text{ }1y\\text{ }-\\text{ }4z \\\\ 2x+1y\\text{ }-\\text{ }3z\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 \\\\ 2 \\\\ 3\\end{bmatrix} \\\\  & =b\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "93427b42-9f68-58e3-a3fd-19c5c8c58d90" :tutorial/math-academy-id 3053 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186061006 :tutorial/content "How do we find the determinant of a $3\\times3$ matrix such as\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}7 & 1 & -3 \\\\ 3 & 2 & 4 \\\\ 5 & 0 & -1\\end{bmatrix}$</div>\n</div>\n\nOne way to do this is to take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as shown below:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 1 & -3 \\\\ 3 & 2 & 4 \\\\ 5 & 0 & -1\\end{vmatrix} & =\\underbrace{(\\,7\\,)}_{{a}_{11}}\\cdot \\overbrace{\\begin{vmatrix}2 & 4 \\\\ 0 & -1\\end{vmatrix}}^{{M}_{11}}-\\underbrace{(\\,1\\,)}_{{a}_{12}}\\cdot \\overbrace{\\begin{vmatrix}3 & 4 \\\\ 5 & -1\\end{vmatrix}}^{{M}_{12}}+\\underbrace{(-3)}_{{a}_{13}}\\cdot \\overbrace{\\begin{vmatrix}3 & 2 \\\\ 5 & 0\\end{vmatrix}}^{{M}_{13}} \\\\  & =7(-2-0)-1(-3-20)-3(0-10) \\\\  & =-14+23+30 \\\\  & =39\\end{aligned}\n$$\n\nIn the above, we have denoted $\\color{blue}M_{1j}$ as the minor of the entry ${\\color{red}a_{1j}}.$\n\nIn general, the determinant of a $3\\times 3$ matrix $A$ is given by\n\n$$\n\\det(A) = {\\color{red}a_{11}}{\\color{blue}M_{11}} - {\\color{red}a_{12}}{\\color{blue}M_{12}} + {\\color{red}a_{13}}{\\color{blue}M_{13}}.\n$$\n\nThat is, if $A=\\begin{bmatrix}a & b & c \\\\ d & e & f \\\\ g & h & i\\end{bmatrix},$ then\n\n$$\n\\begin{aligned}\\begin{vmatrix}a & b & c \\\\ d & e & f \\\\ g & h & i\\end{vmatrix} & =a\\begin{vmatrix}e & f \\\\ h & i\\end{vmatrix}-b\\begin{vmatrix}d & f \\\\ g & i\\end{vmatrix}+c\\begin{vmatrix}d & e \\\\ g & h\\end{vmatrix} \\\\  & =a(ei-fh)-b(di-fg)+c(dh-eg).\\end{aligned}\n$$\n\n**Important:** Do not forget about the *minus sign* in front of the *second term* in the formula!" :tutorial/id #uuid "99828b7b-b501-5509-8853-d17316824f5f" :tutorial/math-academy-id 9175 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186061007 :tutorial/content "If the determinant of a square matrix $A$ is equal to zero, then we say that $A$ is a **singular** matrix.\n\nIf a matrix is singular, then it does not have a multiplicative inverse." :tutorial/id #uuid "2dc6054b-777f-5106-9e65-71bede9f6b49" :tutorial/math-academy-id 9176 :tutorial/title "Singular Matrices"}] [{:db/id #edb/ref 17592186061008 :tutorial/content "Suppose we are given the $3\\times 3$ matrix\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 2 & 3 \\\\ k & -1 & 1 \\\\ 0 & 2 & 1\\end{bmatrix}$</div>\n</div>\n\nthat has an unknown constant $k$ as one of the entries, and we are given that $A$ is singular. How do we find all the possible values of $k?$\n\nOne way is to use the formula for the determinant of a $3 \\times 3$ matrix to find an expression for the determinant in terms of $k,$ and then make an equation with the given determinant to solve for $k.$\n\nSo first, let's use the formula for the determinant on our matrix to get an expression in terms of $k\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 3 \\\\ k & -1 & 1 \\\\ 0 & 2 & 1\\end{vmatrix} & =1\\begin{vmatrix}-1 & 1 \\\\ 2 & 1\\end{vmatrix}-2\\begin{vmatrix}k & 1 \\\\ 0 & 1\\end{vmatrix}+3\\begin{vmatrix}k & -1 \\\\ 0 & 2\\end{vmatrix} \\\\  & =(-1-2)-2(k-0)+3(2k-0) \\\\  & =-3-2k+6k \\\\  & =4k-3\\end{aligned}\n$$\n\nNow, since we are told that $\\det(A) =0,$ let's equate the above expression to $0$ and solve for $k\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 2 & 3 \\\\ k & -1 & 1 \\\\ 0 & 2 & 1\\end{vmatrix} & =0 \\\\ 4k-3 & =0 \\\\ 4k & =3 \\\\ k & =\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the only possible value for $k$ is $\\dfrac{3}{4}.$" :tutorial/id #uuid "55643210-75d5-50e5-a63b-30b951b8a201" :tutorial/math-academy-id 9177 :tutorial/title "Solving for a Variable"}] [{:db/id #edb/ref 17592186087699 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087506} :knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048297}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/question-generator {:db/id #edb/ref 17592186699346} :knowledge-point/questions [{:db/id #edb/ref 17592186087986} {:db/id #edb/ref 17592186088366} {:db/id #edb/ref 17592186237917} {:db/id #edb/ref 17592186237919} {:db/id #edb/ref 17592186237920} {:db/id #edb/ref 17592186237921} {:db/id #edb/ref 17592186237922} {:db/id #edb/ref 17592186237923} {:db/id #edb/ref 17592186253258} {:db/id #edb/ref 17592186338995} {:db/id #edb/ref 17592186338996} {:db/id #edb/ref 17592186557709} {:db/id #edb/ref 17592186557710} {:db/id #edb/ref 17592186557719} {:db/id #edb/ref 17592186557740} {:db/id #edb/ref 17592186557744} {:db/id #edb/ref 17592186557746} {:db/id #edb/ref 17592186557767} {:db/id #edb/ref 17592186557776} {:db/id #edb/ref 17592186557780} {:db/id #edb/ref 17592186557796} {:db/id #edb/ref 17592186600401} {:db/id #edb/ref 17592186699161} {:db/id #edb/ref 17592186699181} {:db/id #edb/ref 17592186699187} {:db/id #edb/ref 17592186699302} {:db/id #edb/ref 17592186699322} {:db/id #edb/ref 17592186699327} {:db/id #edb/ref 17592186699332} {:db/id #edb/ref 17592186699343}] :knowledge-point/title "Determining the Inverse of a 2x2 Matrix"}] [{:db/id #edb/ref 17592186087700 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087507} :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186703877} :knowledge-point/questions [{:db/id #edb/ref 17592186087987} {:db/id #edb/ref 17592186088367} {:db/id #edb/ref 17592186253256} {:db/id #edb/ref 17592186253257} {:db/id #edb/ref 17592186275250} {:db/id #edb/ref 17592186275251} {:db/id #edb/ref 17592186275252} {:db/id #edb/ref 17592186275253} {:db/id #edb/ref 17592186339006} {:db/id #edb/ref 17592186339007} {:db/id #edb/ref 17592186348160} {:db/id #edb/ref 17592186348161} {:db/id #edb/ref 17592186348162} {:db/id #edb/ref 17592186565548} {:db/id #edb/ref 17592186565559} {:db/id #edb/ref 17592186565567} {:db/id #edb/ref 17592186565572} {:db/id #edb/ref 17592186699099} {:db/id #edb/ref 17592186699114} {:db/id #edb/ref 17592186699119} {:db/id #edb/ref 17592186699366} {:db/id #edb/ref 17592186699370} {:db/id #edb/ref 17592186699383} {:db/id #edb/ref 17592186699387} {:db/id #edb/ref 17592186699405} {:db/id #edb/ref 17592186703840} {:db/id #edb/ref 17592186703858} {:db/id #edb/ref 17592186703860} {:db/id #edb/ref 17592186703871}] :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] [{:db/id #edb/ref 17592186088893 :tutorial/content "Given the scalar $a,$ the **multiplicative inverse** of $a$ is defined as the scalar $a^{-1}$ such that\n\n$$\na \\cdot a^{-1} = a^{-1} \\cdot a = 1.\n$$\n\nFor example, the multiplicative inverse of $2$ is the number $2^{-1} = \\dfrac{1}{2}$ because \n\n$$\n\\dfrac{1}{2}\\cdot 2 =  2\\cdot \\dfrac{1}{2} = 1.\n$$\n\nSimilarly, given a square $n \\times n$ matrix $A,$ the **inverse** of $A$ is defined as the $n \\times n$ matrix $A^{-1}$ such that\n\n$$\nA \\cdot A^{-1} = A^{-1} \\cdot A = I_n,\n$$\n\nwhere $I_n$ is the $n\\times n$ identity matrix.\n\nFor example, suppose we're given the following $2\\times 2$ matrix:\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}-1 & -1 \\\\ 1 & 2\\end{bmatrix}$</div>\n</div>\n\nThe inverse of the above matrix is given by\n\n$$\nA^{-1} =\n\t\\begin{bmatrix}-2 & -1 \\\\ 1 & 1\\end{bmatrix}.\n$$\n\nTo verify that the above matrix is in fact the inverse of $A,$ first observe that if we multiply $A$ by the above matrix $A^{-1},$ then we get the identity matrix $I_2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\underbrace{\\begin{bmatrix}-1 & -1 \\\\ 1 & 2\\end{bmatrix}}_{A}\\underbrace{\\begin{bmatrix}-2 & -1 \\\\ 1 & 1\\end{bmatrix}}_{{A}^{-1}} & =\\begin{bmatrix}-1\\cdot (-2)+(-1)\\cdot 1 & -1\\cdot (-1)+(-1)\\cdot 1 \\\\ 1\\cdot (-2)+2\\cdot 1 & 1\\cdot (-1)+2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$\n\nLikewise, if we multiply $A^{-1}$ by $A,$ then we also get the identity matrix $I_2\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{bmatrix}-2 & -1 \\\\ 1 & 1\\end{bmatrix}\\underbrace{\\begin{bmatrix}-1 & -1 \\\\ 1 & 2\\end{bmatrix}}_{A} & ={I}_{2}\\,✓\\end{aligned}\n$$\n\nWe do not yet know how to find the inverse of a matrix. However, we can verify that one matrix is the inverse of the other by carrying out the same procedure as we did here." :tutorial/id #uuid "427bce08-8aa6-508f-969b-2a2ed4eb8c7a" :tutorial/math-academy-id 3043 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186088894 :tutorial/content "The number $0$ does not have an inverse for multiplication over the real numbers, because there's no such number $a$ that $a \\cdot 0 = 1.$ Instead, for every $a$ we have $a \\cdot 0 = 0.$\n\nSimilarly, not every matrix has an inverse.\n\n- If a matrix is not square, an inverse does not exist.\n\n- Some square matrices do not have an inverse. If a square matrix does not have an inverse, then it is said to be **singular**. An example of a singular matrix is the zero matrix\n\n$$\n\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nWe will soon learn how to calculate the inverse of a square matrix, and we'll also soon learn how to determine when a square matrix does not have an inverse." :tutorial/id #uuid "fea084a4-999a-5a17-8f35-e8d7e5dbf25c" :tutorial/math-academy-id 3044 :tutorial/title "Not Every Matrix Has an Inverse"}] [{:db/id #edb/ref 17592186092185 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092025} :knowledge-point/id #uuid "12637b1d-ca03-568f-b1fc-6a626eec88de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049151} {:db/id #edb/ref 17592186050825}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/questions [{:db/id #edb/ref 17592186092817} {:db/id #edb/ref 17592186092818} {:db/id #edb/ref 17592186292892} {:db/id #edb/ref 17592186348080} {:db/id #edb/ref 17592186348093} {:db/id #edb/ref 17592186348094} {:db/id #edb/ref 17592186348095} {:db/id #edb/ref 17592186348096} {:db/id #edb/ref 17592186393877} {:db/id #edb/ref 17592186393884} {:db/id #edb/ref 17592186435149} {:db/id #edb/ref 17592186605128} {:db/id #edb/ref 17592186619714} {:db/id #edb/ref 17592186619719}] :knowledge-point/title "Solving a 3x3 System of Equations Given the Inverse of the Coefficient Matrix"}] [{:db/id #edb/ref 17592186092186 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092026} :knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049043}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186092709} {:db/id #edb/ref 17592186092937} {:db/id #edb/ref 17592186237787} {:db/id #edb/ref 17592186237803} {:db/id #edb/ref 17592186237804} {:db/id #edb/ref 17592186237805} {:db/id #edb/ref 17592186237810} {:db/id #edb/ref 17592186237812} {:db/id #edb/ref 17592186237814} {:db/id #edb/ref 17592186240893} {:db/id #edb/ref 17592186240894} {:db/id #edb/ref 17592186240895} {:db/id #edb/ref 17592186292893} {:db/id #edb/ref 17592186415690} {:db/id #edb/ref 17592186435147} {:db/id #edb/ref 17592186605132}] :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"}]}
