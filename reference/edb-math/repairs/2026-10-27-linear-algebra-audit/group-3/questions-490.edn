\\\\  & =-252\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc809fa4-652d-5ac8-974c-677581cdb740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "290" :db/id #edb/ref 17592186534242}] :answer-field/correct {:db/id #edb/ref 17592186534242} :answer-field/id #uuid "21e24fff-e059-56bd-a412-331cb6aac184" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534220}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e7f085d-8189-5198-aacc-e050d549ba30" :question/problem "If $$\n\\displaystyle A=\\begin{bmatrix}-2 & 8 & -3 \\\\ 6 & 7 & -3 \\\\ 2 & -2 & -4\\end{bmatrix},\n$$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-2 & 8 & -3 \\\\ 6 & 7 & -3 \\\\ 2 & -2 & -4\\end{vmatrix} & =(-2)\\begin{vmatrix}7 & -3 \\\\ -2 & -4\\end{vmatrix}-8\\begin{vmatrix}6 & -3 \\\\ 2 & -4\\end{vmatrix}+(-3)\\begin{vmatrix}6 & 7 \\\\ 2 & -2\\end{vmatrix} \\\\  & =(-2)(7\\cdot (-4)-(-3)\\cdot (-2))+(-8)(6\\cdot (-4)-(-3)\\cdot 2)+(-3)(6\\cdot (-2)-7\\cdot 2) \\\\  & =(-2)(-28-6)+(-8)(-24-(-6))+(-3)(-12-14) \\\\  & =(-2)\\cdot (-34)+(-8)\\cdot (-18)+(-3)\\cdot (-26) \\\\  & =68+144+78 \\\\  & =290\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b87f15d6-01c2-557f-a08c-16a5ceb7d64c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2080" :db/id #edb/ref 17592186534238}] :answer-field/correct {:db/id #edb/ref 17592186534238} :answer-field/id #uuid "6b974bbe-ce42-568d-a217-2141b1101e14" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534230}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b0697975-fcd3-5a6b-8bab-bac455d6d4bb" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}-10 & -5 & 4 \\\\ -10 & 8 & -7 \\\\ -10 & -5 & -12\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-10 & -5 & 4 \\\\ -10 & 8 & -7 \\\\ -10 & -5 & -12\\end{vmatrix} & =(-10)\\begin{vmatrix}8 & -7 \\\\ -5 & -12\\end{vmatrix}-(-5)\\begin{vmatrix}-10 & -7 \\\\ -10 & -12\\end{vmatrix}+4\\begin{vmatrix}-10 & 8 \\\\ -10 & -5\\end{vmatrix} \\\\  & =(-10)(8\\cdot (-12)-(-7)\\cdot (-5))+5((-10)\\cdot (-12)-(-7)\\cdot (-10))+4((-10)\\cdot (-5)-8\\cdot (-10)) \\\\  & =(-10)(-96-35)+5(120-70)+4(50-(-80)) \\\\  & =(-10)\\cdot (-131)+5\\cdot 50+4\\cdot 130 \\\\  & =1310+250+520 \\\\  & =2080\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc802cfd-5dcd-5ae0-9368-5cd44186f5bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-163" :db/id #edb/ref 17592186534247}] :answer-field/correct {:db/id #edb/ref 17592186534247} :answer-field/id #uuid "c48cbd3e-4fec-5282-b2b0-e02d9a186f35" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534243}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c662d088-8a5c-538a-9a26-b6ad00819d49" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}8 & 5 & 5 \\\\ 9 & 8 & -4 \\\\ -12 & -9 & -10\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}8 & 5 & 5 \\\\ 9 & 8 & -4 \\\\ -12 & -9 & -10\\end{vmatrix} & =8\\begin{vmatrix}8 & -4 \\\\ -9 & -10\\end{vmatrix}-5\\begin{vmatrix}9 & -4 \\\\ -12 & -10\\end{vmatrix}+5\\begin{vmatrix}9 & 8 \\\\ -12 & -9\\end{vmatrix} \\\\  & =8(8\\cdot (-10)-(-4)\\cdot (-9))+(-5)(9\\cdot (-10)-(-4)\\cdot (-12))+5(9\\cdot (-9)-8\\cdot (-12)) \\\\  & =8(-80-36)+(-5)(-90-48)+5(-81-(-96)) \\\\  & =8\\cdot (-116)+(-5)\\cdot (-138)+5\\cdot 15 \\\\  & =-928+690+75 \\\\  & =-163\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb6d018c-ba33-52b5-b3d7-aa5783cc6736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1022" :db/id #edb/ref 17592186534252}] :answer-field/correct {:db/id #edb/ref 17592186534252} :answer-field/id #uuid "7ab18f7c-f40c-5379-93c7-a7f21c1e6cce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534232}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d662af0a-b4d4-5653-a75a-192a84ba886b" :question/problem "If $$\n\\displaystyle Q=\\begin{bmatrix}7 & -7 & 9 \\\\ -7 & -7 & 7 \\\\ 12 & -12 & 5\\end{bmatrix},\n$$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & -7 & 9 \\\\ -7 & -7 & 7 \\\\ 12 & -12 & 5\\end{vmatrix} & =7\\begin{vmatrix}-7 & 7 \\\\ -12 & 5\\end{vmatrix}-(-7)\\begin{vmatrix}-7 & 7 \\\\ 12 & 5\\end{vmatrix}+9\\begin{vmatrix}-7 & -7 \\\\ 12 & -12\\end{vmatrix} \\\\  & =7((-7)\\cdot 5-7\\cdot (-12))+7((-7)\\cdot 5-7\\cdot 12)+9((-7)\\cdot (-12)-(-7)\\cdot 12) \\\\  & =7(-35-(-84))+7(-35-84)+9(84-(-84)) \\\\  & =7\\cdot 49+7\\cdot (-119)+9\\cdot 168 \\\\  & =343-833+1512 \\\\  & =1022\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186534251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003496f1-3b51-50b5-b886-d6d3f3efcc21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1839" :db/id #edb/ref 17592186534215}] :answer-field/correct {:db/id #edb/ref 17592186534215} :answer-field/id #uuid "2d8282c0-97d4-5fb5-b9eb-de5bff7453bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534222}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f47007bd-5cbd-5756-890b-9b75cb25d807" :question/problem "If $$\n\\displaystyle W=\\begin{bmatrix}-9 & 9 & 8 \\\\ 12 & 8 & -5 \\\\ 6 & 5 & 8\\end{bmatrix},\n$$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-9 & 9 & 8 \\\\ 12 & 8 & -5 \\\\ 6 & 5 & 8\\end{vmatrix} & =(-9)\\begin{vmatrix}8 & -5 \\\\ 5 & 8\\end{vmatrix}-9\\begin{vmatrix}12 & -5 \\\\ 6 & 8\\end{vmatrix}+8\\begin{vmatrix}12 & 8 \\\\ 6 & 5\\end{vmatrix} \\\\  & =(-9)(8\\cdot 8-(-5)\\cdot 5)+(-9)(12\\cdot 8-(-5)\\cdot 6)+8(12\\cdot 5-8\\cdot 6) \\\\  & =(-9)(64-(-25))+(-9)(96-(-30))+8(60-48) \\\\  & =(-9)\\cdot 89+(-9)\\cdot 126+8\\cdot 12 \\\\  & =-801-1134+96 \\\\  & =-1839\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2237675a-cbb8-55f4-ac1e-48c201dc4645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186545270} {:answer/id #uuid "b366e033-8b4f-533d-86e0-d5b107bc8270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186545525} {:answer/id #uuid "d71b0cc6-29c4-5b34-b310-64ab60f5b724" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186545592} {:answer/id #uuid "d90fb75f-16a5-5779-817f-22c451b4191b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545597} {:answer/id #uuid "fe29b5e6-ad57-590e-8812-0f23650c5a45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545668}] :answer-field/correct {:db/id #edb/ref 17592186545592} :answer-field/id #uuid "a810a855-c6d2-5045-a468-45c2987823ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545752}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :question/math-academy-id "q-142489" :question/problem "Find $\\text{rank}(A)$ given that $$\n\\displaystyle \\text{Null}(A)=\\{\\begin{bmatrix}{x}_{1} \\\\ 0 \\\\ {x}_{1}+{x}_{2} \\\\ 0 \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}.\n$$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1666c48c-616a-5584-b4b9-47f389d5edd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186545240} {:answer/id #uuid "269226e3-2066-5e11-9e53-68cf25388793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545283} {:answer/id #uuid "9ab4711a-55c0-5e5e-90df-e23264046ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186545478} {:answer/id #uuid "daf3c561-12b4-504e-a0d4-870b426bed38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186545606} {:answer/id #uuid "dec293c4-9e4a-569e-b668-6abc7a7c73a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186545610}] :answer-field/correct {:db/id #edb/ref 17592186545610} :answer-field/id #uuid "4635540b-1236-5d34-8d5b-e01f27623485" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545699}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94febb74-e81c-5137-a80c-9d7fa83538e0" :question/math-academy-id "q-141229" :question/problem "Let $A$ be a $4\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186545857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1b4ae3-0a40-5756-bb35-332f91366150" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186545226} {:answer/id #uuid "341ea572-fea0-5ab5-8e97-94b9de3afc39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186545303} {:answer/id #uuid "3dc8c0b7-7f8f-5ba1-a69b-9e3d9da97a75" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186545318} {:answer/id #uuid "73232096-0842-59cd-811b-a3783597953d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186545416} {:answer/id #uuid "855804bf-27d3-5391-ba94-a4c1ff073b30" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186545452}] :answer-field/correct {:db/id #edb/ref 17592186545226} :answer-field/id #uuid "c143e0e6-92b8-5ab3-a31a-0f6f3f8892c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545765}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c10d4c77-93c5-52a9-900d-275fa9299d3e" :question/math-academy-id "q-79410" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\{\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}\\}?\n$$\n\nI. $\\text{rank}(A)=2$\n\nII. $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}$\n\nIII. $A$ has $2$ pivot colums" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $$\n\\displaystyle \\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{4} \\\\ \\text{dim(Col}(A)) &=4=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the non-zero vector\n\n$$\n\\begin{bmatrix}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix}\n$$\n\nspans $\\text{Null}(A),$ we conclude that $\\text{nullity}(A)=1.$ So, by the rank-nullity theorem, with $n=4$,  we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, since $\\text{dim(Col}(A))=\\text{rank}(A)=3,$ we must have  that $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}.$\n\n- Statement III is false. The fact that $\\text{dim(Col}(A))=3$ implies that the number of pivot columns in $A$ is also equal to $3.$\n\nTherefore, the correct answer is \"II only.\""}]}
