#{[{:db/id #edb/ref 17592186393828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388a6e36-47ac-5d37-98c8-6a8422650b4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 & -25 \\\\ 1 & 5\\end{bmatrix}" :db/id #edb/ref 17592186393830} {:answer/id #uuid "b87b90b7-2463-5e8e-ad19-a99c7fc4f432" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393831} {:answer/id #uuid "bba036bc-c4e5-5518-bbe9-5b2cb2b09056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393832} {:answer/id #uuid "0d78787e-c53a-504e-b15a-57da10dcc04f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 5 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393833} {:answer/id #uuid "6e62e811-4b5f-5978-9b25-4900d2227f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5 & 25 \\\\ -1 & -5\\end{bmatrix}" :db/id #edb/ref 17592186393834}] :answer-field/correct {:db/id #edb/ref 17592186393831} :answer-field/id #uuid "8cb48b9b-e45b-5d41-b39e-ff8551f772bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393829}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "578bb254-91a1-5ec9-b189-2ecd517094f8" :question/math-academy-id "q-78344" :question/problem "If $B=\\begin{bmatrix}5 & 25 \\\\ -1 & -5\\end{bmatrix}$, then ${B}^{6}=$" :question/worked-solution "Computing ${B}^{2},$ we have\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}5 & 25 \\\\ -1 & -5\\end{bmatrix}\\cdot \\begin{bmatrix}5 & 25 \\\\ -1 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${B}^{2}=O,$ the matrix $B$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${B}^{6}$ quickly, as follows:\n\n$$\n\\begin{aligned}{B}^{6} & ={B}^{2}\\cdot {B}^{4} \\\\  & =O\\cdot {B}^{4} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{B}^{6}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186393856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "366c6653-367a-59a7-84cb-6ee9c7105259" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393858} {:answer/id #uuid "7cdfd0ed-3fe5-5b86-87d3-32bcacf5d620" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186393859} {:answer/id #uuid "14be786b-6205-5224-9e4e-5339226f55dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186393860} {:answer/id #uuid "5efc90ca-87fe-57c3-ba7c-64fc159ed6b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393861} {:answer/id #uuid "3969bfd8-042f-5db5-aa6d-bb90db966f17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}\\,d\\,B" :db/id #edb/ref 17592186393862}] :answer-field/correct {:db/id #edb/ref 17592186393861} :answer-field/id #uuid "0e367af9-44e1-5186-9afd-a825a6fad5d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393857}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ecb9056c-9932-5a89-8f17-1df1e929dfe8" :question/math-academy-id "q-78445" :question/problem "Consider a matrix equation $AB\\,x=d,$ where $A$ and $B$ are $4\\times 4$ non-singular matrices, while $x$ and $d$ are $4\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $AB\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}AB\\,x & =d \\\\ {A}^{-1}AB\\,x & ={A}^{-1}\\,d \\\\ {I}_{4}B\\,x & ={A}^{-1}\\,d \\\\ B\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x={A}^{-1}\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ {I}_{4}\\,x & ={B}^{-1}{A}^{-1}\\,d \\\\ x & ={B}^{-1}{A}^{-1}\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46eb92c2-7586-5474-8de1-8f3018443d1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186393872} {:answer/id #uuid "533dd821-5655-5510-a57f-8493e82642af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 & 0 \\\\ -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393873} {:answer/id #uuid "aef19fc2-859f-59e3-8cd0-62db907c84bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393874} {:answer/id #uuid "d5c8ed65-2963-576c-8a72-8223e203e5ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 & 16 \\\\ -1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186393875} {:answer/id #uuid "d00a9629-7e88-5d9d-aadb-bf40609cc5bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 & -16 \\\\ 1 & -4\\end{bmatrix}" :db/id #edb/ref 17592186393876}] :answer-field/correct {:db/id #edb/ref 17592186393874} :answer-field/id #uuid "52a06aef-9285-5bae-89f6-500d7ffcb21a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393871}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1700d4e7-644c-5246-9a39-552cdcd23dbb" :question/math-academy-id "q-78534" :question/problem "If $K=\\begin{bmatrix}-4 & 16 \\\\ -1 & 4\\end{bmatrix}$, then ${K}^{6}=$" :question/worked-solution "Computing ${K}^{2},$ we have\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =\\begin{bmatrix}-4 & 16 \\\\ -1 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}-4 & 16 \\\\ -1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${K}^{2}=O,$ the matrix $K$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${K}^{6}$ quickly, as follows:\n\n$$\n\\begin{aligned}{K}^{6} & ={K}^{2}\\cdot {K}^{4} \\\\  & =O\\cdot {K}^{4} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{K}^{6}=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186393877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e5fd665-92c8-5de9-a962-94e1f5665e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186393879} {:answer/id #uuid "b49b5346-149e-5688-b4e3-abd91ac82b0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186393880} {:answer/id #uuid "dde44d62-1c85-5ae3-b2b1-d15a071a6e4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186393881} {:answer/id #uuid "86f61021-d77c-5497-9ea7-8d2d27863b89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186393882} {:answer/id #uuid "6286448b-0a3f-5139-a73d-05652685e000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186393883}] :answer-field/correct {:db/id #edb/ref 17592186393883} :answer-field/id #uuid "4352c172-b7da-52e6-b834-2727aa018a4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393878}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c98c808b-049b-59b0-8d36-61df2339933c" :question/math-academy-id "q-78549" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+2y+4z &=-2 \\\\ x+3y+9z &=0 \\\\ y+6z &=3\\end{aligned}\\right.\n$$\n\nThe system above has the matrix representation $Ax=b.$ Given that $x=⟨x,y,z⟩$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n\\,{A}^{-1}=\\begin{bmatrix}9 & -8 & 6 \\\\ -6 & 6 & -5 \\\\ 1 & -1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ \\begin{bmatrix}1 & 2 & 4 \\\\ 1 & 3 & 9 \\\\ 0 & 1 & 6\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 0 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nRecall that the solution to $Ax=b$ is given by $x={A}^{-1}b.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}9 & -8 & 6 \\\\ -6 & 6 & -5 \\\\ 1 & -1 & 1\\end{bmatrix}\\begin{bmatrix}-2 \\\\ 0 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, the solution is $x=0,y=-3,z=1.$\n\nFinally, $x+y+z=0+(-3)+1=-2.$"}] [{:db/id #edb/ref 17592186393884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d740f60-2523-5646-9a92-3c0d339e8fc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186393886} {:answer/id #uuid "b7f32d4d-f862-5218-b3d1-078edcdfe213" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186393887} {:answer/id #uuid "12eac5a8-05a9-5828-8db5-751459d1b149" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186393888} {:answer/id #uuid "5af9cd45-f4f1-5692-8de2-840ab3c6c7fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186393889} {:answer/id #uuid "44860cb9-5129-5c07-80fe-7caff5e9aed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186393890}] :answer-field/correct {:db/id #edb/ref 17592186393887} :answer-field/id #uuid "b5d59287-5dfe-56f3-93e2-54429b0c04b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393885}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07f12953-92a4-55d6-afcb-39fb0f43a712" :question/math-academy-id "q-78552" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}4x-3y+2z &=-4 \\\\ -4x+4y-3z &=7 \\\\ x-y+z &=-2\\end{aligned}\\right.\n$$\n\nThe system above has the matrix representation $Ax=b.$ Given that $x=⟨x,y,z⟩$ is unique, what is the value of $x+y+z?$ \n\n*Hint: The inverse of the coefficient matrix is given by*\n\n$$\n\\,{A}^{-1}=\\begin{bmatrix}1 & 1 & 1 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 4\\end{bmatrix}.\n$$" :question/worked-solution "First, let's write our system in matrix form as follows:\n\n$$\n\\begin{aligned}Ax & =b \\\\ \\begin{bmatrix}4 & -3 & 2 \\\\ -4 & 4 & -3 \\\\ 1 & -1 & 1\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ 7 \\\\ -2\\end{bmatrix}\\end{aligned}\n$$\n\nRecall that the solution to $Ax=b$ is given by $x={A}^{-1}b.$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\begin{bmatrix}1 & 1 & 1 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 4\\end{bmatrix}\\begin{bmatrix}-4 \\\\ 7 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, the solution is $x=1,y=2,z=-1.$\n\nFinally, $x+y+z=1+2+(-1)=2.$"}] [{:db/id #edb/ref 17592186393891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfb9e7b-0f96-52bc-8348-6c0d6f9ba989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186393893} {:answer/id #uuid "d5398128-e22c-5b5f-92b9-e65712906c71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393894} {:answer/id #uuid "3b931214-8c31-51a5-9560-c552952dcaa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=d\\,AB" :db/id #edb/ref 17592186393895} {:answer/id #uuid "29ab2774-f7be-5352-8b96-05d271f68d3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}{B}^{-1}\\,d" :db/id #edb/ref 17592186393896} {:answer/id #uuid "cdf010f2-d5ab-5f4c-934d-e157995906f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393897}] :answer-field/correct {:db/id #edb/ref 17592186393894} :answer-field/id #uuid "ede05a98-17ce-5670-a287-9b512d09f89c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393892}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e9038fac-5f35-5ebb-bf51-e55eda35beaa" :question/math-academy-id "q-78566" :question/problem "Consider a matrix equation ${A}^{-1}{B}^{-1}\\,x=d,$ where $A$ and $B$ are $3\\times 3$ non-singular matrices, while $x$ and $d$ are $3\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}{B}^{-1}\\,x=d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}{B}^{-1}\\,x & =d \\\\ A{A}^{-1}{B}^{-1}\\,x & =A\\,d \\\\ {I}_{3}{B}^{-1}\\,x & =A\\,d \\\\ {B}^{-1}\\,x & =A\\,d.\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of the equation ${B}^{-1}\\,x=A\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & =A\\,d \\\\ B{B}^{-1}\\,x & =BA\\,d \\\\ {I}_{3}\\,x & =BA\\,d \\\\ x & =BA\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f188d035-264a-5a84-960f-7777553b0e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=A\\,d\\,{B}^{-1}" :db/id #edb/ref 17592186393900} {:answer/id #uuid "e9b99b9b-8aea-5b21-b666-f2b5972647d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393901} {:answer/id #uuid "03b50807-020a-5cac-b35c-77e42daa0304" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=A{B}^{-1}\\,d" :db/id #edb/ref 17592186393902} {:answer/id #uuid "eb50426c-3288-5b08-aec6-d84bf2186543" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}A\\,d" :db/id #edb/ref 17592186393903} {:answer/id #uuid "516626d3-a681-5f04-b08f-b2800b9b0239" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393904}] :answer-field/correct {:db/id #edb/ref 17592186393903} :answer-field/id #uuid "949387db-f0bb-576c-92cd-6be88553f987" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393899}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0ec9f7c8-9125-5a99-8012-bc8baca62664" :question/math-academy-id "q-78567" :question/problem "Consider a matrix equation ${A}^{-1}B\\,x=d,$ where $A$ and $B$ are $6\\times 6$ non-singular matrices, while $x$ and $d$ are $6\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}B\\,x=d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}B\\,x & =d \\\\ A{A}^{-1}B\\,x & =A\\,d \\\\ {I}_{6}B\\,x & =A\\,d \\\\ B\\,x & =A\\,d.\\end{aligned}\n$$\n\nSince $B$ is not singular, it must have an inverse ${B}^{-1}.$ Now, pre-multiplying both sides of the equation $B\\,x=A\\,d$ by ${B}^{-1},$ we obtain\n\n$$\n\\begin{aligned}B\\,x & =A\\,d \\\\ {B}^{-1}B\\,x & ={B}^{-1}A\\,d \\\\ {I}_{6}\\,x & ={B}^{-1}A\\,d \\\\ x & ={B}^{-1}A\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb6862b-40a4-553e-b127-875a257430ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186393907} {:answer/id #uuid "c37e5a61-c2eb-538b-99a7-23642c14b38b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186393908} {:answer/id #uuid "8ee481b4-326b-5845-a01e-35c02639b453" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186393909} {:answer/id #uuid "8395c955-c031-5153-8925-7f64e907dff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={B}^{-1}{A}^{-1}\\,d" :db/id #edb/ref 17592186393910} {:answer/id #uuid "85a30c66-8a0b-5199-9181-20081d9e024c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B{A}^{-1}\\,d" :db/id #edb/ref 17592186393911}] :answer-field/correct {:db/id #edb/ref 17592186393911} :answer-field/id #uuid "fd860ae1-dad5-535f-9702-2f27d023f02d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393906}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "434e4ac4-2d0e-5134-b4d8-984f36cd5b9a" :question/math-academy-id "q-78568" :question/problem "Consider a matrix equation $A{B}^{-1}\\,x=d,$ where $A$ and $B$ are $5\\times 5$ non-singular matrices, while $x$ and $d$ are $5\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A{B}^{-1}\\,x=d$ by ${A}^{-1},$ we obtain\n\n$$\n\\begin{aligned}A{B}^{-1}\\,x & =d \\\\ {A}^{-1}A{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {I}_{5}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ {B}^{-1}\\,x & ={A}^{-1}\\,d.\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of the equation ${B}^{-1}\\,x={A}^{-1}\\,d$ by $B,$ we obtain\n\n$$\n\\begin{aligned}{B}^{-1}\\,x & ={A}^{-1}\\,d \\\\ B{B}^{-1}\\,x & =B{A}^{-1}\\,d \\\\ {I}_{5}\\,x & =B{A}^{-1}\\,d \\\\ x & =B{A}^{-1}\\,d.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0b2a5a8-67e7-5639-9d41-6b6082af0189" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393914} {:answer/id #uuid "6cf33cc7-55a2-56b0-9243-826fe4617b79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & -6 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186393915} {:answer/id #uuid "b56078f5-e9a2-54d5-b4dc-d6536dec2e4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393916} {:answer/id #uuid "6198d7ae-e34d-53ed-983e-2b4492d3825c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -6 & 0\\end{bmatrix}" :db/id #edb/ref 17592186393917} {:answer/id #uuid "90b66a89-a532-5756-b976-d72f2602a6b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & -6 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186393918}] :answer-field/correct {:db/id #edb/ref 17592186393916} :answer-field/id #uuid "12ef64bb-d65e-5cfd-b87f-976d076e6e82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393913}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f92da47c-e719-5f4d-aa7e-be4e5edae187" :question/math-academy-id "q-78577" :question/problem "If $Z=\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}$, then ${Z}^{5}=$" :question/worked-solution "First, we compute ${Z}^{2}$ as follows:\n\n$$\n\\begin{aligned}{Z}^{2} & =Z\\cdot Z \\\\  & =\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix} \\\\  & =Z\\end{aligned}\n$$\n\nNotice that ${Z}^{2}=Z,$ so $Z$ is an idempotent matrix. \n\nWe can use this fact to compute ${Z}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{Z}^{5} & ={Z}^{2}\\cdot {Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z\\cdot Z \\\\  & ={Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z \\\\  & ={Z}^{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Z}^{5}=\\begin{bmatrix}1 & 0 \\\\ -6 & 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186394840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1de9bc2-0f30-517a-9782-a9ca1f325ab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{vmatrix}" :db/id #edb/ref 17592186394842} {:answer/id #uuid "5ac6aa15-7074-542e-a631-82d70b92d723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}3 & 5 & 2 \\\\ -1 & 3 & 2 \\\\ 2 & -1 & 1\\end{vmatrix}" :db/id #edb/ref 17592186394843} {:answer/id #uuid "e527a465-6e77-5e69-9d55-173ec29fa087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}11 & 17 & 11 \\\\ -6 & -1 & 11 \\\\ -1 & 1 & 10\\end{vmatrix}" :db/id #edb/ref 17592186394844} {:answer/id #uuid "d8dfdaca-5484-51f8-8589-1f59e7f19eb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}3 & 4 & 3 \\\\ -3 & 3 & 2 \\\\ 5 & -1 & 1\\end{vmatrix}" :db/id #edb/ref 17592186394845} {:answer/id #uuid "cf9d2e43-fa8b-5321-9df5-097671ef682a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}2 & 3 & 5 \\\\ -3 & -1 & 3 \\\\ 5 & 2 & -1\\end{vmatrix}" :db/id #edb/ref 17592186394846}] :answer-field/correct {:db/id #edb/ref 17592186394842} :answer-field/id #uuid "be649d92-73f0-5810-94c6-ee526da83145" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394841}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5692854a-1edd-56c8-8906-b5a68a5133f6" :question/math-academy-id "q-91170" :question/problem "$$\n\\begin{vmatrix}3 & -1 & 4 & 3 \\\\ 2 & 3 & 5 & 2 \\\\ -3 & -1 & 3 & 2 \\\\ 5 & 2 & -1 & 1\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero.*" :question/worked-solution "Let's make entries below ${a}_{12}=-1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}3 & -1 & 4 & 3 \\\\ 2 & 3 & 5 & 2 \\\\ -3 & -1 & 3 & 2 \\\\ 5 & 2 & -1 & 1\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ {R}_{4}:={R}_{4}+2{R}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}3 & -1 & 4 & 3 \\\\ 11 & 0 & 17 & 11 \\\\ -6 & 0 & -1 & -1 \\\\ 11 & 0 & 7 & 7\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}3 & -1 & 4 & 3 \\\\ 11 & 0 & 17 & 11 \\\\ -6 & 0 & -1 & -1 \\\\ 11 & 0 & 7 & 7\\end{vmatrix} \\\\  & =(-1)\\cdot (-1)^{1+2}\\begin{vmatrix}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{vmatrix} \\\\  & =\\begin{vmatrix}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "609d4aa3-2241-5f9d-b6f4-1a30887ca390" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}2 & 1 & 1 \\\\ 1 & 2 & -1 \\\\ -1 & 3 & -2\\end{vmatrix}" :db/id #edb/ref 17592186394856} {:answer/id #uuid "30f3764a-811a-5eab-869c-ec0be3239d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}5 & -3 & 7 \\\\ 0 & 0 & 5 \\\\ -5 & 2 & 1\\end{vmatrix}" :db/id #edb/ref 17592186394857} {:answer/id #uuid "5044ffe8-6af3-542a-b299-73a548e1de0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}3 & 1 & 1 \\\\ -1 & 2 & -1 \\\\ 2 & 3 & -2\\end{vmatrix}" :db/id #edb/ref 17592186394858} {:answer/id #uuid "0d21572b-0d8b-5bbe-ae1d-2219314d5b82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}3 & 2 & 1 \\\\ 2 & -1 & 3 \\\\ -1 & 1 & 2\\end{vmatrix}" :db/id #edb/ref 17592186394859} {:answer/id #uuid "470fd86e-b0d9-5a17-a025-3164e11aa781" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{vmatrix}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{vmatrix}" :db/id #edb/ref 17592186394860}] :answer-field/correct {:db/id #edb/ref 17592186394860} :answer-field/id #uuid "c480dcb0-6f15-525e-b469-6c0d8ba55637" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394855}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5ff3ecd8-fc32-55c0-acc0-bdc23d568e06" :question/math-academy-id "q-91217" :question/problem "$$\n\\begin{vmatrix}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{vmatrix}\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{42}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{42}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{vmatrix} &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =\\begin{vmatrix}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+2}\\begin{vmatrix}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{vmatrix} \\\\  & =\\begin{vmatrix}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{vmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ffe24a8-fe0e-5039-81c0-fb9631f878a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2-y-z \\\\ 4-z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395980} {:answer/id #uuid "30c4ec68-4b39-55b5-8e7c-bbe84a2b4057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3y \\\\ y \\\\ 4y-1\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395981} {:answer/id #uuid "bc323d4c-6ab9-5df2-881f-281eabd5b981" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186395982} {:answer/id #uuid "3bac1b8f-a5a2-5c6f-9f74-53d3dc54a0d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1-3y \\\\ y \\\\ 2+y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395983} {:answer/id #uuid "ca74fa9e-2937-5e51-b664-ed9cfa05d409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2-y-z \\\\ 1+z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395984}] :answer-field/correct {:db/id #edb/ref 17592186395982} :answer-field/id #uuid "2f5eaa46-bf95-53b6-ace1-3bd33b1c4991" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186395979}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "06de5100-449e-5af5-b65a-4e9e27bdf01a" :question/math-academy-id "q-10662" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{array}\\right] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & -1 & 3 & -4\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & 0 & 0 & -3\\end{array}\\right].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=2 \\\\ 0x+y-3z &=1 \\\\ 0x+0y+0z &=-3\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-3,$ we can conclude that our system has no solution."}] [{:db/id #edb/ref 17592186396025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{bmatrix}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186396030} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396031}] :answer-field/correct {:db/id #edb/ref 17592186396027} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186396026}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 2\\end{bmatrix}.$</div>\n</div>" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}\\begin{bmatrix}1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46af019b-5e0e-54fe-a3a4-d3a5f79204d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186440035} {:answer/id #uuid "36089e95-fc88-5a76-b2c4-311f215a41a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186440036}] :answer-field/correct {:db/id #edb/ref 17592186440035} :answer-field/id #uuid "a7bba9ed-822d-53ee-89c9-116fde41ee52" :answer-field/key "$k=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440375} {:answer-field/choices [{:answer/id #uuid "242f0892-e1e1-5e47-ac02-f10209cc7691" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186440037} {:answer/id #uuid "5261eeed-b902-50cd-be8c-e339e0cd7603" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186440038}] :answer-field/correct {:db/id #edb/ref 17592186440038} :answer-field/id #uuid "3baa83a4-cb6e-5db3-8f0f-7d1c5b2abfae" :answer-field/key "$k=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440376} {:answer-field/choices [{:answer/id #uuid "2a8201e6-2d8f-5889-8d5a-7f26e45965c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186440039} {:answer/id #uuid "8aa3b90b-7a80-5418-b7a0-778bc241d10d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186440040}] :answer-field/correct {:db/id #edb/ref 17592186440040} :answer-field/id #uuid "ab487ccf-fee0-51d3-aff0-dfee470b09fd" :answer-field/key "$k=2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440377}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11af43ea-89bf-58ea-b458-4433226aa764" :question/math-academy-id "q-9913" :question/problem "Find the possible values of the constant $k$ given that the matrix  $\\begin{bmatrix}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{bmatrix}$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{vmatrix} & =k\\begin{vmatrix}3 & 1 \\\\ 6 & k\\end{vmatrix}+0\\begin{vmatrix}0 & 1 \\\\ 0 & k\\end{vmatrix}+0\\begin{vmatrix}0 & 3 \\\\ 0 & 6\\end{vmatrix} \\\\  & =k(3k-6)+0+0 \\\\  & =k(3k-6)\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}k(3k-6) & =0 \\\\ 3k(k-2) & =0 \\\\ k & =0,2\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=2.$"}] [{:db/id #edb/ref 17592186398982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3df6cd2-68c7-5027-b94c-cebc3edbefd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\frac{1}{2}" :db/id #edb/ref 17592186398984} {:answer/id #uuid "3d7403d1-9523-59ef-892c-8762070fc770" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-\\frac{1}{2}" :db/id #edb/ref 17592186398985} {:answer/id #uuid "43b3ca27-4022-5e94-91a9-05d77b4b0c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-2" :db/id #edb/ref 17592186398986} {:answer/id #uuid "321a43c8-209e-53e7-bddf-716f4dd735c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=2" :db/id #edb/ref 17592186398987} {:answer/id #uuid "a9f1972b-cdc9-5bbd-bf68-8c034ebe8712" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-4" :db/id #edb/ref 17592186398988}] :answer-field/correct {:db/id #edb/ref 17592186398987} :answer-field/id #uuid "ce520123-e722-5fc8-b4b5-0ce963a1fe4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398983}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b1df7fe-03a7-50e4-93e7-ab9ba910308e" :question/math-academy-id "q-74650" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ x+(k+1)y &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}+\\left(-\\frac{1}{2}\\right){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & 6 & 4 \\\\ 0 & k-2 & 0\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}2x+6y &=4 \\\\ (k-2)y &=0.\\end{aligned}\\right.\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=2,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $2x+6y=4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=2.$"}] [{:db/id #edb/ref 17592186400345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869e00c6-a4ba-5e49-adbb-6c7b2dfda6d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437800} {:answer/id #uuid "cc3eef7f-38ce-53c9-b7d7-5ad7331d9db5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437801}] :answer-field/correct {:db/id #edb/ref 17592186437800} :answer-field/id #uuid "ee1ffe9f-6a37-5717-a79c-006e1e279e9f" :answer-field/key "$det(F)=-7$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438929} {:answer-field/choices [{:answer/id #uuid "73f233cd-a07f-56cc-b019-5bf1a281c9e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437802} {:answer/id #uuid "0370b8e5-fbed-53fa-bba4-73a7be7e3de4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437803}] :answer-field/correct {:db/id #edb/ref 17592186437803} :answer-field/id #uuid "91e6ecc2-f970-55e9-9644-03d1a8d33b21" :answer-field/key "$F$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438930} {:answer-field/choices [{:answer/id #uuid "ecabd635-8703-591e-8d3a-ae23bbdf9467" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437804} {:answer/id #uuid "a6071a93-94cd-5aa5-98a0-dee30b1fa3cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437805}] :answer-field/correct {:db/id #edb/ref 17592186437804} :answer-field/id #uuid "d1b2f581-bf3c-5b63-a3e5-a1336a490a06" :answer-field/key "$det(F)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438931} {:answer-field/choices [{:answer/id #uuid "09770f28-1851-55a6-907e-48f97d04ec38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186669019} {:answer/id #uuid "01aca0ce-8957-55c8-8d7a-37e49a101f4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186669020}] :answer-field/correct {:db/id #edb/ref 17592186669019} :answer-field/id #uuid "a948a82a-6898-532e-87b0-ae1a9d0da2ea" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186669309}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n$$\nF=\\begin{bmatrix}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =\\begin{vmatrix}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{vmatrix} \\\\  & =2\\begin{vmatrix}2 & 1 \\\\ 3 & 1\\end{vmatrix}-8\\begin{vmatrix}-1 & 1 \\\\ 5 & 1\\end{vmatrix}+3\\begin{vmatrix}-1 & 2 \\\\ 5 & 3\\end{vmatrix} \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement “$F$ is **not** a singular matrix” is true."}] [{:db/id #edb/ref 17592186400352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a30e54a5-5549-54be-a77d-0271a747f483" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437806} {:answer/id #uuid "1678c617-1408-5d9c-b2b6-f33cb2bcbc97" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437807}] :answer-field/correct {:db/id #edb/ref 17592186437807} :answer-field/id #uuid "8934c094-53e8-5252-811d-16f83b72799e" :answer-field/key "$D$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438932} {:answer-field/choices [{:answer/id #uuid "cdeb7450-ec19-5575-89aa-66f56497533b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437808} {:answer/id #uuid "cd4c6b03-6a3d-5e71-8ee1-bd76a8e47d7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437809}] :answer-field/correct {:db/id #edb/ref 17592186437808} :answer-field/id #uuid "f7edd53d-df96-5e60-b073-b95bd4d92abf" :answer-field/key "$det(D)=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438933} {:answer-field/choices [{:answer/id #uuid "0668d434-29bc-5c22-ae50-ede25ab3fb55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437810} {:answer/id #uuid "a8d7c2a7-df8c-5627-999f-6d43c26ca389" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437811}] :answer-field/correct {:db/id #edb/ref 17592186437811} :answer-field/id #uuid "b7f7e987-6e7f-5d92-a6ad-a4d71c321aa2" :answer-field/key "$det(D)=0$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438934}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n$$\nD=\\begin{bmatrix}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =\\begin{vmatrix}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{vmatrix} \\\\  & =2\\begin{vmatrix}2 & 3 \\\\ 5 & 2\\end{vmatrix}+3\\begin{vmatrix}-1 & 3 \\\\ -3 & 2\\end{vmatrix}+1\\begin{vmatrix}-1 & 2 \\\\ -3 & 5\\end{vmatrix} \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements “$D$ is a singular matrix” and $det(D)=0$ are true."}] [{:db/id #edb/ref 17592186400359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437818} {:answer/id #uuid "20bd5256-a3ef-5a48-b762-66cfb4a56832" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437819}] :answer-field/correct {:db/id #edb/ref 17592186437818} :answer-field/id #uuid "f79065b5-83e0-5c45-91ca-02a92fe83586" :answer-field/key "$S$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438938} {:answer-field/choices [{:answer/id #uuid "51e1d911-6963-56d2-a197-b7ef0fd454a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437820} {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437821}] :answer-field/correct {:db/id #edb/ref 17592186437821} :answer-field/id #uuid "6d2d1bc7-850d-5cc3-a700-a5297c1412e2" :answer-field/key "$S$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438939} {:answer-field/choices [{:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437822} {:answer/id #uuid "f7553a7c-6618-5039-9f2e-70225d0f69b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437823}] :answer-field/correct {:db/id #edb/ref 17592186437822} :answer-field/id #uuid "bd92868f-3a2b-5764-95b0-634de408c963" :answer-field/key "$det(S)=5+2\\sqrt{7}$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438940}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nSelect all that apply.\n\n$$\nS=\\begin{bmatrix}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{vmatrix} \\\\  & =2\\sqrt{7}\\begin{vmatrix}2 & 0 \\\\ 0 & \\sqrt{7}\\end{vmatrix}-0\\begin{vmatrix}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{vmatrix}+\\frac{1}{2}\\begin{vmatrix}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{vmatrix} \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not**  singular. \n\nTherefore, only statement “$S$ is **not** a singular matrix” is true."}] [{:db/id #edb/ref 17592186400366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439483} {:answer/id #uuid "3db08d97-0845-5f7c-ab43-56777bea1d91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439484}] :answer-field/correct {:db/id #edb/ref 17592186439483} :answer-field/id #uuid "36f65856-78a1-51a9-a1da-71cda1e674f1" :answer-field/key "$m=-6$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440099} {:answer-field/choices [{:answer/id #uuid "dec92b27-277d-5920-9c63-50c355350d50" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439485} {:answer/id #uuid "d7efe730-22a8-5253-b96e-23123e4a98e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439486}] :answer-field/correct {:db/id #edb/ref 17592186439485} :answer-field/id #uuid "21524ea9-5072-5e34-9765-c48f94050d16" :answer-field/key "$m=-5$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440100} {:answer-field/choices [{:answer/id #uuid "6a17a4ff-d40c-5630-a3e9-10db02ad93e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439487} {:answer/id #uuid "dbf556fa-4d79-5443-8bfa-93c96686c0b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439488}] :answer-field/correct {:db/id #edb/ref 17592186439487} :answer-field/id #uuid "1274cfce-7367-5750-bf06-dd8f1d1cfeec" :answer-field/key "$m=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440101} {:answer-field/choices [{:answer/id #uuid "c6367235-10eb-5b6e-8e95-119de9f56fb6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439489} {:answer/id #uuid "b943d1ca-7cab-5262-81fa-8f183158d7b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439490}] :answer-field/correct {:db/id #edb/ref 17592186439489} :answer-field/id #uuid "53e76782-4383-593d-b1d2-b6c475ceb4a9" :answer-field/key "$m=3$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440102} {:answer-field/choices [{:answer/id #uuid "c370c082-b2ae-5038-9133-5e429cbafa66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439491} {:answer/id #uuid "e077bebf-4ed8-550b-a674-b8c67d696044" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439492}] :answer-field/correct {:db/id #edb/ref 17592186439492} :answer-field/id #uuid "3d73edd5-cd07-5400-bca8-9dc482987051" :answer-field/key "$m=4$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440103} {:answer-field/choices [{:answer/id #uuid "48620b4b-6598-5913-ad54-44caf8e83b26" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439493} {:answer/id #uuid "2e884f18-53fd-5041-94e9-ff9a8b0abf64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439494}] :answer-field/correct {:db/id #edb/ref 17592186439494} :answer-field/id #uuid "3b49d521-d2dd-5bd3-a65b-f63b17f6768a" :answer-field/key "$m=8$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440104}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30a80f14-b653-5ec9-a12d-20d43bb40f91" :question/math-academy-id "q-128506" :question/problem "Given that the determinant of\n$$\n\\displaystyle \\begin{bmatrix}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{bmatrix}\n$$\nis $-29$, find all the possible values of $m.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $m:$\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{vmatrix} & =1\\begin{vmatrix}3 & 0 \\\\ 1 & 1\\end{vmatrix}-6\\begin{vmatrix}m & 0 \\\\ 2 & 1\\end{vmatrix}+m\\begin{vmatrix}m & 3 \\\\ 2 & 1\\end{vmatrix} \\\\  & =(3-0)-6(m-0)+m(m-6) \\\\  & =3-6m+{m}^{2}-6m \\\\  & ={m}^{2}-12m+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-29,$ we have:\n\n$$\n\\begin{aligned}{m}^{2}-12m+3 & =-29 \\\\ {m}^{2}-12m+32 & =0 \\\\ m & =\\frac{-(-12)\\pm \\sqrt{{12}^{2}-4\\cdot 1\\cdot 32}}{2\\cdot 1} \\\\  & =\\frac{12\\pm \\sqrt{16}}{2} \\\\  & =\\frac{12\\pm 4}{2} \\\\  & =6\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $m=4$ and $m=8.$"}] [{:db/id #edb/ref 17592186400597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee44784e-c13a-5b12-af97-8b32c8c0a5be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7z+3 \\\\ 2z-2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400599} {:answer/id #uuid "230fd32d-be4a-579c-925a-53e385a20db2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-7z-3 \\\\ 2z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400600} {:answer/id #uuid "c1affba9-f056-51a7-a549-36a67d2e8dca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7z-3 \\\\ 2-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400601} {:answer/id #uuid "c81a8969-331d-5a2b-a2ad-56d7d447802b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-7z-3 \\\\ 2-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400602} {:answer/id #uuid "74fab224-971f-5289-87ed-552b598c900e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-7z \\\\ 2z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400603}] :answer-field/correct {:db/id #edb/ref 17592186400600} :answer-field/id #uuid "bdb79457-f181-5b77-98a7-2247b1af411b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400598}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a5eae7d8-0877-5f8b-8a7a-fca7737eb497" :question/math-academy-id "q-131485" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 7 & -3 \\\\ 0 & 1 & -2 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "Notice that the matrix $M$ is already in row echelon form. The system corresponding to $M$ is \n\n$$\n\\left\\{\\begin{aligned}x+0y+7z &=-3 \\\\ 0x+y-2z &=2 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final equation $0x+0y+0z=0,$ we can remove this equation from the system. So, our system now consists of just two equations:\n\n$$\n\\left\\{\\begin{aligned}x+7z &=-3 \\\\ y-2z &=2\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ To do this, we apply the back substitution. \n\nFrom the second equation, we get\n\n$$\ny-2z=2\\,⇒\\,y=2z+2\n$$\n\nand from the first equation, we obtain\n\n$$\nx+7z=-3\\,⇒\\,x=-7z-3.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-7z-3 \\\\ y &=2z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-7z-3 \\\\ 2z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e094e93-8ced-5de7-8bbd-0b45c329cfff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400606} {:answer/id #uuid "ffd2f927-f231-5b80-9010-2d3a5ee3c4c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400607} {:answer/id #uuid "9c0f3ab0-4578-57b2-96d9-136b48cbe0b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}-4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400608} {:answer/id #uuid "177d9d96-5f02-53c6-b377-f4b0a23620b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186400609} {:answer/id #uuid "713dc755-61ac-526d-bf07-e1bd0d805dd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400610}] :answer-field/correct {:db/id #edb/ref 17592186400607} :answer-field/id #uuid "3bf381b7-5f27-5de3-b285-a0155244b022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400605}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a36d5833-a8f6-5e41-9f0c-9e264c1ac49c" :question/math-academy-id "q-131499" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -8 & 6 & -4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\left\\{\\begin{aligned}2x-8y+6z &=-4 \\\\ 0x+0y+0z &=0 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\n2x-8y+6z=-4\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=4y-3z-2.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=4y-3z-2 \\\\ y &=y \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $y$, $z$ (free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}4y-3z-2 \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}4 \\\\ 1 \\\\ 0\\end{bmatrix}+z\\begin{bmatrix}-3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48980080-3b29-5d93-8895-6dc8d852d470" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1-3y-2z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400613} {:answer/id #uuid "e332c64f-7ba6-5dbb-85f7-2fda0b6da246" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186400614} {:answer/id #uuid "3abac20c-2ea5-5660-86e2-4798e8e9514d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1-3y+2z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400615} {:answer/id #uuid "66c6dc1b-675e-55c7-974d-d4c469830584" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}y-2z-3 \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400616} {:answer/id #uuid "d146ccb7-a362-5b17-993b-13a2c5e5f08f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3y-2z-1 \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400617}] :answer-field/correct {:db/id #edb/ref 17592186400617} :answer-field/id #uuid "77e15572-4a4b-502d-8485-53598d56e2c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400612}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd76a088-2631-55dd-b133-6b775b2a304e" :question/math-academy-id "q-131502" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}-1 & 3 & -2 & 1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}-1 & 3 & -2 & 1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{array}\\right] & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ -3 & 9 & -6 & 3\\end{array}\\right] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3y+2z &=-1 \\\\ 0x+0y+0z &=0 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx-3y+2z=-1\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=3y-2z-1.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3y-2z-1 \\\\ y &=y \\\\ z &=z\\end{aligned}\\right.\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3y-2z-1 \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d174f1e-8230-59a5-b790-dfbaab4e9521" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186400627} {:answer/id #uuid "244aab6d-90be-578a-8092-166a36c8c9ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400628} {:answer/id #uuid "83dd970a-9032-5161-9210-85e901723065" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4y+3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400629} {:answer/id #uuid "8e7e3b2b-d1a1-5446-8ee4-32636f7b1b2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400630} {:answer/id #uuid "0e38c584-fc56-5df5-a079-f3072bdddfc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3-4y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400631}] :answer-field/correct {:db/id #edb/ref 17592186400628} :answer-field/id #uuid "0a4567f4-6572-5d9e-8018-4068c6812f07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400626}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0feb9ee-8e97-5292-aff6-05655689f05b" :question/math-academy-id "q-131712" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+8y &=-6 \\\\ -4x-16y &=12 \\\\ 6x+24y &=-18.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & -3 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{array}\\right] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 6 & 24 & -18\\end{array}\\right] & {R}_{3} & :={R}_{3}-6{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+4y &=-3\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4y-3 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-4y-3 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438973} {:answer-field/choices [{:answer/id #uuid "19caaa21-1924-5f34-bf64-11d9efbb6c3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186669035} {:answer/id #uuid "4c09126d-8a68-536f-9a8b-012529fa611c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186669036}] :answer-field/correct {:db/id #edb/ref 17592186669035} :answer-field/id #uuid "461e6f2f-4d78-500f-9681-0f0e5f34ced2" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186669317}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-6y-2z &=4 \\\\ 3x-9y-3z &=6\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement “The system is consistent dependent” is true."}] [{:db/id #edb/ref 17592186400639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438976} {:answer-field/choices [{:answer/id #uuid "6bd79b88-af3a-5863-9c9c-2f3f1d5e44a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186669037} {:answer/id #uuid "f2735887-99de-543f-aed7-0e72e76203db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186669038}] :answer-field/correct {:db/id #edb/ref 17592186669037} :answer-field/id #uuid "94e01891-307f-5863-9e93-52d1282eb40d" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186669318}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+7y &=1 \\\\ -2x-4y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ y &=4.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."}] [{:db/id #edb/ref 17592186400646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438979} {:answer-field/choices [{:answer/id #uuid "ed4c4298-c274-5506-95ba-2e40145b01d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186669039} {:answer/id #uuid "80e6770a-2c73-54a6-b26e-9ebc40660d80" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186669040}] :answer-field/correct {:db/id #edb/ref 17592186669039} :answer-field/id #uuid "ac790e8c-7dda-5424-ab85-bfe6b93ff17c" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186669319}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}3x-3y &=6 \\\\ -2x+y &=-3 \\\\ 4x-4y &=8.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{array}\\right] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{array}\\right] & {R}_{2} & :=-{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ y &=-1.\\end{aligned}\\right.\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."}] [{:db/id #edb/ref 17592186402009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402011} {:answer/id #uuid "bd1763ae-5fcd-5d4b-b18a-af3a643749d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}8-{x}_{3} \\\\ 3+3{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402012} {:answer/id #uuid "300bc792-b634-5ba3-8561-858fdf7d8d69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-8-8{x}_{3} \\\\ 6-6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402013} {:answer/id #uuid "55911223-4948-5180-95bf-96b38f95603a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-8-6{x}_{3} \\\\ 10+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402014} {:answer/id #uuid "e5a39045-c764-56cd-a094-6caa0b024ef0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-8-{x}_{3} \\\\ 6+{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402015}] :answer-field/correct {:db/id #edb/ref 17592186402011} :answer-field/id #uuid "94d6271a-24bd-58c0-9553-83b2dc10742e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f65d67ed-b94b-50cc-87d4-9aa7130f7547" :question/math-academy-id "q-32247" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}-2{x}_{3} &=4 \\\\ -2{x}_{1}-3{x}_{2}-2{x}_{3} &=-2.\\end{aligned}\\right.\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 2 & -2 & 4 \\\\ 0 & 1 & -6 & 6\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 10 & -8 \\\\ 0 & 1 & -6 & 6\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+10{x}_{3} &=-8 \\\\ {x}_{2}-6{x}_{3} &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=-8-10{x}_{3} \\\\ {x}_{2} &=6+6{x}_{3} \\\\ {x}_{3} &={x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "547016f8-709b-55ae-9ed1-84a5249a6fe5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3-3z \\\\ 7-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402570} {:answer/id #uuid "ad3871c3-7636-59b3-aaf5-402cb593106f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186402571} {:answer/id #uuid "92e86a7a-e842-58e1-a2ac-d05c185871b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7-3z \\\\ -3-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402572} {:answer/id #uuid "f8c294cf-9ff4-580b-9460-402477d8c46d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-7+3z \\\\ -3+2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402573} {:answer/id #uuid "a20d4184-e472-531e-8a16-81dbaf3b46d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7+3z \\\\ 3-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402574}] :answer-field/correct {:db/id #edb/ref 17592186402572} :answer-field/id #uuid "84f00b54-07f8-565a-95ff-d33549fee4dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402569}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae2d41a6-3045-5117-8d5e-3a9ab6755a10" :question/math-academy-id "q-37774" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 3 & 7 \\\\ 0 & 1 & 2 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "Notice that the matrix $M$ is already in row echelon form. The system corresponding to $M$ is \n\n$$\n\\left\\{\\begin{aligned}x+0y+3z &=7 \\\\ 0x+y+2z &=-3 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final equation $0x+0y+0z=0,$ we can remove this equation from the system. So, our system now consists of just two equations:\n\n$$\n\\left\\{\\begin{aligned}x+3z &=7 \\\\ y+2z &=-3\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ To do this, we apply the back substitution. \n\nFrom the first equation, we get\n\n$$\nx+3z=7\\,⇒\\,x=7-3z\n$$\n\nand from the second equation, we obtain\n\n$$\ny+2z=-3\\,⇒\\,y=-3-2z.\n$$\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=7-3z \\\\ y &=-3-2z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}7-3z \\\\ -3-2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53f93a90-917d-59e1-ad77-0b9aad541d3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438266} {:answer/id #uuid "12af740c-a997-5387-8362-5e2cc16732ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438267}] :answer-field/correct {:db/id #edb/ref 17592186438266} :answer-field/id #uuid "2b6fcdaf-3dd3-5706-a56b-12ba3e57c541" :answer-field/key "$N$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439162} {:answer-field/choices [{:answer/id #uuid "80660670-28fa-562c-9cdd-803d3f3b6e24" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438268} {:answer/id #uuid "5834e804-b776-587a-9eff-2c1a6107cc1a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438269}] :answer-field/correct {:db/id #edb/ref 17592186438269} :answer-field/id #uuid "676ac767-8dfd-50fa-9ecf-b51ab8fab0b5" :answer-field/key "$N$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439163} {:answer-field/choices [{:answer/id #uuid "56d97f56-3c64-5231-b1a7-ace7dd7012d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438270} {:answer/id #uuid "1c459c6d-1c91-560e-9b29-0f2524d0be20" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438271}] :answer-field/correct {:db/id #edb/ref 17592186438270} :answer-field/id #uuid "091267d0-c528-519a-8b1c-763f1c12a047" :answer-field/key "$det(N)=-1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439164}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a5eb8a6b-37c6-54e6-b340-18101dbf3f8f" :question/math-academy-id "q-38187" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\nSelect all that apply.\n\n$$\nN=\\begin{bmatrix}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(N) & =\\begin{vmatrix}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{vmatrix} \\\\  & =\\frac{1}{7}\\begin{vmatrix}4 & -\\frac{1}{7} \\\\ 5 & -\\frac{1}{7}\\end{vmatrix}-3\\begin{vmatrix}\\frac{1}{7} & -\\frac{1}{7} \\\\ \\frac{1}{7} & -\\frac{1}{7}\\end{vmatrix}+\\left(-\\frac{1}{7}\\right)\\begin{vmatrix}\\frac{1}{7} & 4 \\\\ \\frac{1}{7} & 5\\end{vmatrix} \\\\  & =\\frac{1}{7}(-\\frac{4}{7}+\\frac{5}{7})-3(-\\frac{1}{49}+\\frac{1}{49})-\\frac{1}{7}(\\frac{5}{7}-\\frac{4}{7}) \\\\  & =\\frac{1}{7}\\cdot \\frac{1}{7}-3\\cdot 0-\\frac{1}{7}\\cdot \\frac{1}{7} \\\\  & =\\frac{1}{49}-\\frac{1}{49} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(N)=0$, the matrix is singular. \n\nTherefore, only statement “$N$ is a singular matrix” is true."}] [{:db/id #edb/ref 17592186402756 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e80e6ba-d53c-56a1-8f14-814656e252d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2-z \\\\ 0 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402758} {:answer/id #uuid "240d49db-221f-5c96-a2c7-752016dd8d06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1-z \\\\ 0 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402759} {:answer/id #uuid "c205ae90-dae6-5981-8476-c566174adf7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-z \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402760} {:answer/id #uuid "a7eb10d8-4da4-5dab-bc8c-4a003f7cebfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402761} {:answer/id #uuid "c70e171e-d942-5f58-90b7-b6fb6a232836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ -z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402762}] :answer-field/correct {:db/id #edb/ref 17592186402761} :answer-field/id #uuid "0fa49e40-cb09-52a9-be51-216ec3f67938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "013e11bb-39c0-595b-a244-03847638286f" :question/math-academy-id "q-42019" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+2z &=2 \\\\ y-z &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 0 \\\\ 0 & 1 & -1 & -1\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x &=0 \\\\ y-z &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=0 \\\\ y &=z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6873b1-0d04-54c4-a516-3393f091ca8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438290} {:answer/id #uuid "cf136178-b995-530b-bb4f-ee1711feaab9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438291}] :answer-field/correct {:db/id #edb/ref 17592186438290} :answer-field/id #uuid "0f126748-e572-518c-b374-65fb20a3785e" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439174} {:answer-field/choices [{:answer/id #uuid "58ee750b-7fc4-5d76-a8fd-41226a7f5ad1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438292} {:answer/id #uuid "23ff6b9a-302b-5629-8e07-bc20b267963c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438293}] :answer-field/correct {:db/id #edb/ref 17592186438292} :answer-field/id #uuid "db15201f-7938-57e0-8d64-2e3e68d9b2f2" :answer-field/key "The system has a unique solution" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439175} {:answer-field/choices [{:answer/id #uuid "db32e8d6-cfbf-5975-ae7e-91c6447ca478" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438294} {:answer/id #uuid "a53b68f3-fc73-544a-93b7-5353580edb77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438295}] :answer-field/correct {:db/id #edb/ref 17592186438295} :answer-field/id #uuid "9847730a-03c8-54a9-b1d7-d557810eefed" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439176}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a930b2a-2578-5145-8e40-06b6cab16ba9" :question/math-academy-id "q-42020" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ 3x+y &=3 \\\\ -2x+y &=-2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:  \n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 3 & 1 & 3 \\\\ -2 & 1 & -2\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ -2 & 1 & -2\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 5 & -4\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & -5 & 6 \\\\ 0 & 0 & 2\\end{array}\\right]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=2,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."}] [{:db/id #edb/ref 17592186403335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8bfe8db-1989-5e4c-9ad9-c6db83ad7bb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438484} {:answer/id #uuid "6b7cbeaf-dee8-5b96-8308-94729708799c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438485}] :answer-field/correct {:db/id #edb/ref 17592186438484} :answer-field/id #uuid "4ec23c8b-291b-5610-9226-611cabeda584" :answer-field/key "$T$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439271} {:answer-field/choices [{:answer/id #uuid "f42e4a93-c186-58e5-951e-917759693098" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438486} {:answer/id #uuid "f52e2b00-e5d8-52b7-83e8-eba250bef166" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438487}] :answer-field/correct {:db/id #edb/ref 17592186438486} :answer-field/id #uuid "dfb6943e-42d8-5697-b023-3106b7e5611c" :answer-field/key "$det(T)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439272} {:answer-field/choices [{:answer/id #uuid "74d5746f-c69f-5b13-8c52-ab7a0cb272bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438488} {:answer/id #uuid "f9a8ba1d-5bcb-54c6-a41a-1a451759a5dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438489}] :answer-field/correct {:db/id #edb/ref 17592186438489} :answer-field/id #uuid "2f6d01c9-2762-59a1-a7a5-cb52ffab3689" :answer-field/key "$T$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439273}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0582f249-3bf5-5079-8fe1-8ed6df521a52" :question/math-academy-id "q-69835" :question/problem "Which of the following statements are true regarding the matrix $T$ given below?\n\nSelect all that apply.\n\n$$\nT=\\begin{bmatrix}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:  \n\n$$\n\\begin{aligned}det(T) & =\\begin{vmatrix}4 & 2 & -1 \\\\ 1 & 2 & 3 \\\\ -2 & -1 & 1\\end{vmatrix} \\\\  & =4\\begin{vmatrix}2 & 3 \\\\ -1 & 1\\end{vmatrix}-2\\begin{vmatrix}1 & 3 \\\\ -2 & 1\\end{vmatrix}-1\\begin{vmatrix}1 & 2 \\\\ -2 & -1\\end{vmatrix} \\\\  & =4(2+3)-2(1+6)-1(-1+4) \\\\  & =4\\cdot 5-2\\cdot 7-1\\cdot 3 \\\\  & =20-14-3 \\\\  & =3\\end{aligned}\n$$\n\n \n\nSince $det(T)=3\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement “$T$ is **not** a singular matrix” is true."}] [{:db/id #edb/ref 17592186403731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f607536-ba89-5718-aed4-73d79d8fefe2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}5 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403733} {:answer/id #uuid "c6da98ac-d2bd-5e17-bf72-7dbf0e0b1406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403734} {:answer/id #uuid "7102331a-61ac-555b-a308-ed6c3c607afc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186403735} {:answer/id #uuid "fe9dc8bc-d50e-5f42-a53c-d906ba0fc3e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403736} {:answer/id #uuid "e0aa2a8a-523a-5375-aabf-871e94803607" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix}+y\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}+z\\begin{bmatrix}4 \\\\ 0 \\\\ 1\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186403737}] :answer-field/correct {:db/id #edb/ref 17592186403735} :answer-field/id #uuid "154dd871-921f-589c-a014-a6f06b889ded" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403732}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "546eeb31-583e-555f-a75b-4f974cd8d508" :question/math-academy-id "q-73953" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}3 & 5 & 2 & 1 \\\\ 0 & -2 & 4 & 3 \\\\ 0 & 0 & 0 & 10\\end{array}\\right].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n\\left\\{\\begin{aligned}3x+5y+2z &=1 \\\\ 0x-2y+4z &=3 \\\\ 0x+0y+0z &=10\\end{aligned}\\right.\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=10,$ we can conclude that our system has no solution."}] [{:db/id #edb/ref 17592186403787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed3c728-986a-5b3f-ab57-0020cb435ca9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438514} {:answer/id #uuid "72c05b38-661e-55ef-b895-991dd965f68d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438515}] :answer-field/correct {:db/id #edb/ref 17592186438514} :answer-field/id #uuid "d5f63264-b18f-5fb9-8709-61b443e3ce15" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439286} {:answer-field/choices [{:answer/id #uuid "1a9ad7d4-df0d-5491-9263-1cfec2f1523b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438516} {:answer/id #uuid "0cfc1f4e-c211-54e2-8df0-f80bdf080bed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438517}] :answer-field/correct {:db/id #edb/ref 17592186438516} :answer-field/id #uuid "a0678042-ac90-54b5-926f-6259f946ee55" :answer-field/key "The system has a unique solution" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439287} {:answer-field/choices [{:answer/id #uuid "c32dbf70-7f15-517a-9383-074f32bf4f01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438518} {:answer/id #uuid "b90a004e-1b26-5348-ab56-1dd54d767fcc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438519}] :answer-field/correct {:db/id #edb/ref 17592186438519} :answer-field/id #uuid "98fa2d2a-8e07-54bb-bb31-70f2215b776f" :answer-field/key "The system is inconsistent" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8971116-e24d-5808-9b29-a50e168511e5" :question/math-academy-id "q-74634" :question/problem "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}2x-y &=-1 \\\\ 2x-4y &=3 \\\\ x+y &=2\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we will first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & -1 & -1 \\\\ 2 & -4 & 3 \\\\ 1 & 1 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 1 & 1 & 2\\end{array}\\right] & {R}_{3} & :={R}_{3}+\\left(-\\frac{1}{2}\\right){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & \\frac{3}{2} & \\frac{5}{2}\\end{array}\\right] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & -1 & -1 \\\\ 0 & -3 & 4 \\\\ 0 & 0 & \\frac{9}{2}\\end{array}\\right]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=\\frac{9}{2},$ and it has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement “The system is inconsistent” is true."}] [{:db/id #edb/ref 17592186403947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403948}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =\\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{D}^{-1}}}}c \\\\ \\bbox[2pt,lightgray]{\\color{blue}{\\phantom{{I}_{n}}}}z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"}]}
