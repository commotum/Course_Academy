-004a-5da8-9c3e-6a6e50c794ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186325066} {:answer/id #uuid "c67d2e1d-8417-5a78-a35c-8205ba48cf31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-26" :db/id #edb/ref 17592186325685} {:answer/id #uuid "f4ea0889-e7f0-58ed-8cf7-e8e35863a9f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186326127}] :answer-field/correct {:db/id #edb/ref 17592186325685} :answer-field/id #uuid "f4aa40ce-8299-5985-952f-3e95c613ab8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93db7f8f-7ceb-59cb-bb66-3026f7154ffa" :question/math-academy-id "q-38176" :question/problem "Find the value of $$\n\\displaystyle \\begin{vmatrix}6 & 0 & 7 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{vmatrix}.\n$$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}6 & 0 & 7 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{vmatrix} & =6\\begin{vmatrix}2 & 0 \\\\ 0 & -1\\end{vmatrix}-0\\begin{vmatrix}0 & 0 \\\\ 1 & -1\\end{vmatrix}+7\\begin{vmatrix}0 & 2 \\\\ 1 & 0\\end{vmatrix} \\\\  & =6(-2-0)-0+7(0-2) \\\\  & =6\\cdot (-2)+7\\cdot (-2) \\\\  & =-12-14 \\\\  & =-26\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6ffe837-0ba9-566a-847f-01c50e5b0d4e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438254} {:answer/id #uuid "0c851c6e-8e6f-5ce1-85f0-794bba8508bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438255}] :answer-field/correct {:db/id #edb/ref 17592186438255} :answer-field/id #uuid "ece7019d-4e4a-54c5-8c4b-3ee796bd1176" :answer-field/key "$E$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439156} {:answer-field/choices [{:answer/id #uuid "69b3cb09-83cc-54f2-9f3a-46d5234e0bc2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438256} {:answer/id #uuid "e013cbff-c909-515f-a71d-027cdb4811c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438257}] :answer-field/correct {:db/id #edb/ref 17592186438256} :answer-field/id #uuid "1bcb1241-521a-5c92-ac65-6398206509ea" :answer-field/key "$E$ is **not**  a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439157} {:answer-field/choices [{:answer/id #uuid "1785546f-b00e-5a43-be50-0c26a6fc2ca6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438258} {:answer/id #uuid "1c201000-e71f-5609-9f1d-19bba5ab4630" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438259}] :answer-field/correct {:db/id #edb/ref 17592186438258} :answer-field/id #uuid "e28dc200-2ac1-54de-90ea-6e018bd1ba08" :answer-field/key "$det(E)=-2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "084b3fe8-adf9-5ab7-9017-b2d4d829ca62" :question/math-academy-id "q-38179" :question/problem "Which of the following statements are true regarding the matrix $E$ given below?\n\nSelect all that apply.\n\n$$\nE=\\begin{bmatrix}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(E) & =\\begin{vmatrix}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{vmatrix} \\\\  & =\\frac{2}{3}\\begin{vmatrix}5 & 6 \\\\ 7 & 8\\end{vmatrix}-3\\begin{vmatrix}\\frac{2}{3} & 6 \\\\ \\frac{2}{3} & 8\\end{vmatrix}+4\\begin{vmatrix}\\frac{2}{3} & 5 \\\\ \\frac{2}{3} & 7\\end{vmatrix} \\\\  & =\\frac{2}{3}(40-42)-3(\\frac{16}{3}-\\frac{12}{3})+4(\\frac{14}{3}-\\frac{10}{3}) \\\\  & =\\frac{2}{3}\\cdot (-2)-3\\cdot \\frac{4}{3}+4\\cdot \\frac{4}{3} \\\\  & =-\\frac{4}{3}-\\frac{12}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(E)=0$, the matrix is singular. \n\nTherefore, only statement “$E$ is a singular matrix” is true."}] [{:db/id #edb/ref 17592186326672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f2d595-4c96-599f-b04a-ef1a4facbf7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186324134} {:answer/id #uuid "35476165-d1db-5ee5-b183-b3201978c25b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186324408} {:answer/id #uuid "36554c2e-a686-5080-983a-7fd2be339db8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186324414} {:answer/id #uuid "5dc9de58-8130-508b-ad5a-dc48cfe4914d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186324751} {:answer/id #uuid "a45499fc-34c3-5b71-b300-396e74e38e5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186325368}] :answer-field/correct {:db/id #edb/ref 17592186324134} :answer-field/id #uuid "17302b73-c3c5-5ca7-9ed6-b18a09cd2b48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "687c1640-263b-54f0-8cd7-1fc76a39da2b" :question/math-academy-id "q-38180" :question/problem "Find the value of $$\n\\displaystyle \\begin{vmatrix}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{vmatrix}.\n$$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}\\begin{vmatrix}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{vmatrix} & =0\\begin{vmatrix}0 & 2 \\\\ -2 & 0\\end{vmatrix}-(-1)\\begin{vmatrix}1 & 2 \\\\ 3 & 0\\end{vmatrix}+3\\begin{vmatrix}1 & 0 \\\\ 3 & -2\\end{vmatrix} \\\\  & =0+1(0-6)+3(-2-0) \\\\  & =1\\cdot (-6)+3\\cdot (-2) \\\\  & =-6-6 \\\\  & =-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79e4e142-7005-54c1-8d51-b38fccf87ef4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438260} {:answer/id #uuid "54cfd4e5-c485-53e9-8b91-e2afca217595" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438261}] :answer-field/correct {:db/id #edb/ref 17592186438260} :answer-field/id #uuid "bc0815ad-f485-5e0c-8048-0318325f0ad4" :answer-field/key "$Q$ is **not** a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439159} {:answer-field/choices [{:answer/id #uuid "7f7c0c3a-e50c-57b3-b6e3-787c897947c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438262} {:answer/id #uuid "4c0b4616-bf0b-52ad-8642-7f8e6022ec10" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438263}] :answer-field/correct {:db/id #edb/ref 17592186438263} :answer-field/id #uuid "ef01e74d-81a9-5880-81c3-faa3592706db" :answer-field/key "$Q$ is a singular matrix" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439160} {:answer-field/choices [{:answer/id #uuid "8ce5156b-be05-52db-8fa2-508a2bebc677" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186438264} {:answer/id #uuid "5c652fd1-d715-5a76-8fb9-1477a177d25a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186438265}] :answer-field/correct {:db/id #edb/ref 17592186438264} :answer-field/id #uuid "f4c6df6b-8841-5610-8b0d-3ae518f8442e" :answer-field/key "$det(Q)=-5$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186439161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2a72ef8-dad7-5172-8868-8d2781696df8" :question/math-academy-id "q-38182" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n$$\nQ=\\begin{bmatrix}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{bmatrix}\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =\\begin{vmatrix}0 & 3 & 6 \\\\ 1 & 4 & 7 \\\\ 2 & 5 & 8\\end{vmatrix} \\\\  & =0\\begin{vmatrix}4 & 7 \\\\ 5 & 8\\end{vmatrix}-3\\begin{vmatrix}1 & 7 \\\\ 2 & 8\\end{vmatrix}+6\\begin{vmatrix}1 & 4 \\\\ 2 & 5\\end{vmatrix} \\\\  & =0-3(8-14)+6(5-8) \\\\  & =0-3\\cdot (-6)+6\\cdot (-3) \\\\  & =18-18 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, only statement “$Q$ is a singular matrix” is true."}] [{:db/id #edb/ref 17592186326924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50f9b50f-35ed-5015-90a2-abcb73e7da04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2z \\\\ 4z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324637} {:answer/id #uuid "5aacb359-a752-57ee-91e8-49aab1c366a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1+2z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324720} {:answer/id #uuid "7904e155-741c-55db-ada4-37737e9bba13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2+4z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324977} {:answer/id #uuid "9a333b0e-0c9f-57ef-9a78-652e513b4226" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2+4z \\\\ 1-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325282} {:answer/id #uuid "e2e79639-3620-552d-af88-21e978591b1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1+4z \\\\ 3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325961}] :answer-field/correct {:db/id #edb/ref 17592186324720} :answer-field/id #uuid "4ff1beeb-90d1-5401-997f-ae3e61dc47dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7ff9f1a-cb7f-5669-aa2d-6b7ae8d5b3bd" :question/math-academy-id "q-42041" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4z &=2 \\\\ 4x+y-5z &=4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 1 \\\\ 4 & 1 & -5 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 1 \\\\ 0 & 1 & 3 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2z &=1 \\\\ y+3z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=1+2z \\\\ y &=-3z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1+2z \\\\ -3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3672ebc9-24fb-51d7-a9f1-c3eb667bc7cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186327407} {:answer/id #uuid "681050c1-f90a-52c2-96e6-90b209aad18f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186327834} {:answer/id #uuid "87400b8d-a49e-54be-98a9-44ee2feebfd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186328096} {:answer/id #uuid "9be6a1c1-2916-5f20-b765-a456ff73026d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186328281} {:answer/id #uuid "c62200c6-6716-501c-bb83-1b638c35509e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186328672}] :answer-field/correct {:db/id #edb/ref 17592186328096} :answer-field/id #uuid "3e8823c0-bb89-5457-a931-f2fd5266cb03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329306}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "293999e5-5c9a-5b54-b498-f6519c92524e" :question/math-academy-id "q-42579" :question/problem "Find $|{A}^{-1}|,$ if $A=\\begin{bmatrix}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}.$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $3$rd row:\n\n$$\n\\begin{aligned}|A| & =\\begin{vmatrix}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{vmatrix} \\\\  & =1\\cdot (-1)^{3+1}\\cdot \\begin{vmatrix}6 & -3 \\\\ -2 & 0\\end{vmatrix} \\\\  & =1\\cdot (-6) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186329687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026c7004-8494-5ac7-b146-bd83da70b93c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=-4{R}_{1}" :db/id #edb/ref 17592186326961} {:answer/id #uuid "2dc553fa-6372-54a1-80cf-6f418a317470" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186327342} {:answer/id #uuid "59e0fb20-5f68-5538-924e-54424e3a674e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-4{R}_{2}" :db/id #edb/ref 17592186327724} {:answer/id #uuid "80510d9c-0bde-550b-9d76-7c48e94ee945" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-4){R}_{2}" :db/id #edb/ref 17592186328040} {:answer/id #uuid "b6ea519f-6c58-5a67-b687-351fe81c79a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=4{R}_{1}" :db/id #edb/ref 17592186328524}] :answer-field/correct {:db/id #edb/ref 17592186326961} :answer-field/id #uuid "a89561ad-ace0-5390-80f1-311ee4c1f3e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e243a04a-20ca-53ba-bf29-0d9f8f727a6a" :question/math-academy-id "q-42813" :question/problem "Let $E=\\begin{bmatrix}-4 & 0 \\\\ 0 & 1\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by multiplying the first row of the identity matrix  by $-4$:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :=-4{R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation ${R}_{1}:=-4{R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186329693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0384fc6a-338f-52f3-9912-45dc7776f831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186326970} {:answer/id #uuid "6ee7c280-f909-5ec8-8c9c-c74ada42fe15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186327894} {:answer/id #uuid "946e20b5-0492-5fd6-ae6e-147fd17c870c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186328230} {:answer/id #uuid "a7fe3ae2-cc9e-5511-a146-54bd7d489b9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186328391} {:answer/id #uuid "e858b1fe-b1e0-50be-bed8-8e186555a94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186328966}] :answer-field/correct {:db/id #edb/ref 17592186328230} :answer-field/id #uuid "733bce34-68ed-5d19-8098-0ba365d5ad91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329375}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3344b843-2ccb-5b01-90af-e0b77e74221e" :question/math-academy-id "q-42890" :question/problem "Calculate the value of \n$$\n\\displaystyle \\,\\begin{vmatrix}1 & 2 & -3 & 2 \\\\ 2 & 2 & -3 & -1 \\\\ -3 & 2 & -2 & 4 \\\\ -2 & -2 & 3 & 2\\end{vmatrix}.\n$$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{12}=2$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 2 & -3 & 2 \\\\ 2 & 2 & -3 & -1 \\\\ -3 & 2 & -2 & 4 \\\\ -2 & -2 & 3 & 2\\end{vmatrix} &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ {R}_{4}:={R}_{4}+{R}_{1}\\end{aligned} \\\\  & =\\begin{vmatrix}1 & 2 & -3 & 2 \\\\ 1 & 0 & 0 & -3 \\\\ -4 & 0 & 1 & 2 \\\\ -1 & 0 & 0 & 4\\end{vmatrix}.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,\\begin{vmatrix}1 & 2 & -3 & 2 \\\\ 1 & 0 & 0 & -3 \\\\ -4 & 0 & 1 & 2 \\\\ -1 & 0 & 0 & 4\\end{vmatrix} \\\\  & =2\\cdot (-1)^{1+2}\\begin{vmatrix}1 & 0 & -3 \\\\ -4 & 1 & 2 \\\\ -1 & 0 & 4\\end{vmatrix} \\\\  & =-2\\begin{vmatrix}1 & 0 & -3 \\\\ -4 & 1 & 2 \\\\ -1 & 0 & 4\\end{vmatrix} \\\\  & =(-2)\\cdot 1\\cdot (-1)^{2+2}\\begin{vmatrix}1 & -3 \\\\ -1 & 4\\end{vmatrix} \\\\  & =-2(4-3) \\\\  & =-2.\\end{aligned}\n$$"}]}
