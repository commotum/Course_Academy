#{[{:db/id #edb/ref 17592186299653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186297813}] :answer-field/correct {:db/id #edb/ref 17592186297813} :answer-field/id #uuid "4541560b-538b-5f05-b59c-8a9bf0f5a2d9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298874} {:answer-field/choices [{:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186297844}] :answer-field/correct {:db/id #edb/ref 17592186297844} :answer-field/id #uuid "50d12860-4dc8-5d98-b731-8fe82a2cacc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298910}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "630b6f29-5fc9-5ea7-9ec7-b34bacfad40e" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$-6$</td></tr>\n<tr><td>$11$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & ∗\\end{bmatrix}, &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}, &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b613db7-3639-5cfa-8355-3eda8dde4a1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Ab" :db/id #edb/ref 17592186297671} {:answer/id #uuid "2d07001d-219e-5a54-8e7b-a8e55434a3e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b" :db/id #edb/ref 17592186297742} {:answer/id #uuid "51acb5a0-36e9-5e3d-9c37-06230f28f670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "bA" :db/id #edb/ref 17592186297897} {:answer/id #uuid "8be8e53b-8e70-5d31-b2d7-9a5de3c0f54c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b{A}^{-1}" :db/id #edb/ref 17592186298159}] :answer-field/correct {:db/id #edb/ref 17592186297742} :answer-field/id #uuid "aecff7e3-afce-52e5-acb9-05ee2422ca92" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186299229} {:answer-field/choices [{:answer/id #uuid "29445ea8-6882-5534-9d88-5e8b0cf3e66e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{A}^{-1}A" :db/id #edb/ref 17592186297726} {:answer/id #uuid "4b427bb1-b697-5144-a1f1-b54f5ea50788" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{A}^{-1}" :db/id #edb/ref 17592186297859} {:answer/id #uuid "981db98e-0c4e-517f-8b72-e3598b65761d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186298212} {:answer/id #uuid "b4799b1c-0481-5e9f-b566-724306e100bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{A}^{-1}" :db/id #edb/ref 17592186298336}] :answer-field/correct {:db/id #edb/ref 17592186297726} :answer-field/id #uuid "af88031d-b7e4-58da-b4dc-09cb37cca46d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186299232} {:answer-field/choices [{:answer/id #uuid "00578b3d-0fe5-5f60-9bbd-5f64e29784da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{A}^{-1}" :db/id #edb/ref 17592186297550} {:answer/id #uuid "2c8e315f-5acc-550d-8293-b4611dadb326" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186297740} {:answer/id #uuid "a093a29e-c08b-5b90-b6f7-4b9d650d5356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b" :db/id #edb/ref 17592186298261} {:answer/id #uuid "c184e032-81a7-50b5-9a8d-3cc56c24e7d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186298402}] :answer-field/correct {:db/id #edb/ref 17592186298261} :answer-field/id #uuid "bbb40022-f0c5-5eee-853a-bec8f370936b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186299273} {:answer-field/choices [{:answer/id #uuid "8dab9844-a72f-570d-b103-bd06f140114a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b" :db/id #edb/ref 17592186298166} {:answer/id #uuid "9a71b385-f680-520d-8206-53aec1a5fe84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x" :db/id #edb/ref 17592186298227} {:answer/id #uuid "9e0a824a-5921-5804-8b3b-dd0c558367cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186298245} {:answer/id #uuid "f290487a-0f85-52a8-86a0-71b58d8df2db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{I}_{3}" :db/id #edb/ref 17592186298581}] :answer-field/correct {:db/id #edb/ref 17592186298227} :answer-field/id #uuid "d7ba2f28-0cf0-5b78-bbdb-244572b42fd2" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186299368}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cce553b5-2cba-5d0f-a25a-d7275ae86d94" :question/math-academy-id "q-317900" :question/problem "Consider a system of $3$ linear equations in $3$ variables, written in matrix form as $A\\,x=b.$ Here, $A$ is the non-singular coefficient matrix of the system, $x$ is the column vector containing the variables, and $b$ is the column vector containing the constants. What are the missing parts of the derivation method shown below to find the unique solution of the system?\n\n$$\nA\\,x={{field-1}}\n$$\n\n$$\n{{field-2}}\\,x={A}^{-1}\\,b\n$$\n\n$$\n{I}_{3}\\,x={A}^{-1}\\,{{field-3}}\n$$\n\n$$\n{{field-4}}={A}^{-1}\\,b\n$$" :question/worked-solution "Since $A$ is not singular, it must have an inverse ${A}^{-1}.$ Now, pre-multiplying both sides of the equation $A\\,x=b$ by ${A}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}A\\,x & =b \\\\ {A}^{-1}A\\,x & ={A}^{-1}\\,b \\\\ {I}_{3}\\,x & ={A}^{-1}\\,b \\\\ x & ={A}^{-1}\\,b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186297872}] :answer-field/correct {:db/id #edb/ref 17592186297872} :answer-field/id #uuid "0b459b10-8619-5f0d-afdd-56b9910358fb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298672}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0cf7bab6-9aaa-53a5-ad4b-30e1807bc5dc" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Q=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}?$</div>\n</div>\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nP=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =\\begin{bmatrix}2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-19" :db/id #edb/ref 17592186297660}] :answer-field/correct {:db/id #edb/ref 17592186297660} :answer-field/id #uuid "cd3d9a0e-8498-5cbb-884b-c40fde8b221a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299323}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "941171d1-f178-5deb-90c4-b1a669882e6a" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Y=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}$</div>\n<div>$Z=\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}?$</div>\n</div>\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nX=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =\\begin{bmatrix}-2 & 3 & 0\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186298385}] :answer-field/correct {:db/id #edb/ref 17592186298385} :answer-field/id #uuid "04b1a5a5-69b5-54cc-9927-afbe16de429c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298654}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d709c6eb-9e1b-5062-85d4-7521181b0638" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}?$</div>\n</div>\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =\\begin{bmatrix}3 & 2\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d5156d-1d4d-58d0-b3db-f06dc3110af2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186298182}] :answer-field/correct {:db/id #edb/ref 17592186298182} :answer-field/id #uuid "60ee3141-5ab6-5a49-864a-59e094c19044" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298967} {:answer-field/choices [{:answer/id #uuid "cdcbaa46-9cac-5426-ab3d-927a136593d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186298450}] :answer-field/correct {:db/id #edb/ref 17592186298450} :answer-field/id #uuid "777110cd-e150-534d-a2cc-8ff44e91e456" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299040} {:answer-field/choices [{:answer/id #uuid "11781e0e-cbc8-5673-b303-fddb5dd204cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186297630}] :answer-field/correct {:db/id #edb/ref 17592186297630} :answer-field/id #uuid "eb00e7e1-8810-52ee-a695-867da382934b" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299431} {:answer-field/choices [{:answer/id #uuid "6bcc1e4f-a4bf-5a59-8f24-9a6a1ab50a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186298016}] :answer-field/correct {:db/id #edb/ref 17592186298016} :answer-field/id #uuid "eb0feda7-eeae-5b52-8b25-7199991e023a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299432}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1050bc77-12b5-5216-85bc-cb476e852617" :question/math-academy-id "q-318484" :question/problem "If\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & -3\\end{bmatrix},$</div>\n</div>\n\nfind $AB.$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,5=5\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-15=5\\cdot (-3) \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & ∗\\end{bmatrix}, &  & \\,-2=-2\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}, &  & \\,6=-2\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle AB=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fcdd0ac-c4d8-5dd7-8ce4-29a07e65c610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186298029}] :answer-field/correct {:db/id #edb/ref 17592186298029} :answer-field/id #uuid "3d3ccc6b-89ba-5ba8-8a64-d1dd15121053" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298846} {:answer-field/choices [{:answer/id #uuid "874c93ff-44ad-5c2e-8a4f-77019c4f2b86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186298140}] :answer-field/correct {:db/id #edb/ref 17592186298140} :answer-field/id #uuid "4de9dcd3-c548-55ae-96de-6e52cab045c0" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298897} {:answer-field/choices [{:answer/id #uuid "2ae40015-4fcb-586e-8a84-7d4f6a259e22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186297731}] :answer-field/correct {:db/id #edb/ref 17592186297731} :answer-field/id #uuid "64782fe1-4d28-5e2c-9f59-1390501840c7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186298977} {:answer-field/choices [{:answer/id #uuid "bd732c28-e607-547f-9e6a-89b4964ab33f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186298379}] :answer-field/correct {:db/id #edb/ref 17592186298379} :answer-field/id #uuid "773cf57c-f4bf-5a7b-8d27-324f2c476811" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299039} {:answer-field/choices [{:answer/id #uuid "d6772ac0-8762-523b-b968-4d37a6be9ed9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186298472}] :answer-field/correct {:db/id #edb/ref 17592186298472} :answer-field/id #uuid "85b2534a-9c75-559c-a1eb-defb03116ee5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299086} {:answer-field/choices [{:answer/id #uuid "4eb17f79-016a-5e9c-b6d6-e46c3b822d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186297880}] :answer-field/correct {:db/id #edb/ref 17592186297880} :answer-field/id #uuid "96cea0dd-cf80-5acf-9892-8cd8aa4d611a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186299136}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2eb6f27b-270d-54d9-87be-3557d2c76515" :question/math-academy-id "q-318588" :question/problem "Find $PQ,$ if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}-4 & 2\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$PQ=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n<tr><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $P$ is a $3\\times 1$ matrix and $Q$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $P$ and $1$ row in matrix $Q$, so the product is well defined:\n\n$$\n{P}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{Q}_{\\boxed{\\text{1}}\\times 2}={PQ}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}PQ & =\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot (-4) & 0\\cdot 2 \\\\ 3\\cdot (-4) & 3\\cdot 2 \\\\ (-1)\\cdot (-4) & (-1)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -12 & 6 \\\\ 4 & -2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579d616-78a8-516c-9fe5-0f8eae33db70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}\\frac{1}{3} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186297642} {:answer/id #uuid "ada80f79-a7e3-5ad9-99a1-6118d91b141a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186298309} {:answer/id #uuid "adea5347-c355-585a-adfb-70d6dee66bdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298310} {:answer/id #uuid "b739caa3-4913-5223-b205-23b07f823f66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298348} {:answer/id #uuid "e44d84ae-c620-5c69-9535-1f49151394ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{1}{3} & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186298534}] :answer-field/correct {:db/id #edb/ref 17592186298310} :answer-field/id #uuid "026b1493-140a-504e-a2a2-628b3df5debb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186298651}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "76e5a507-45db-59c1-877b-e0a6e215a18d" :question/math-academy-id "q-32037" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{2},\\,{R}_{2}:=\\frac{1}{3}{R}_{2}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{1}:={R}_{1}+(-3){R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1}:={R}_{1}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{2}:=\\frac{1}{3}{R}_{2}$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows: \n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix} \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n\\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$ \n\n$$\n\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ 0 & 1\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186299842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104ce5a7-32bd-5f6d-bcd6-f0b2918eba87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+3{R}_{2}" :db/id #edb/ref 17592186297626} {:answer/id #uuid "9181e1eb-6a3f-552a-9842-18275f2f57b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=3{R}_{2}" :db/id #edb/ref 17592186298184} {:answer/id #uuid "96a2a760-fd0b-5658-b50d-e9c9b2f65c59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+3{R}_{1}" :db/id #edb/ref 17592186298205} {:answer/id #uuid "b3994986-86d1-517b-a047-ae17476405b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=-3{R}_{1}" :db/id #edb/ref 17592186298333} {:answer/id #uuid "ebacae7d-7760-529c-ab50-e0bbe70e8510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:=3{R}_{1}" :db/id #edb/ref 17592186298555}] :answer-field/correct {:db/id #edb/ref 17592186298555} :answer-field/id #uuid "64dc2104-9234-5a99-8dc3-b4f160b2ac84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186298979}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "890b7708-4d96-51de-8064-24b0a048633e" :question/math-academy-id "q-32038" :question/problem "Let  $E=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}.$ Find the row operation that, when applied to a $2\\times 2$ matrix $A,$ gives the result of the product $EA.$" :question/worked-solution "The matrix $E$ is obtained by multiplying the first row of the identity matrix  by $3$:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} & {R}_{1} & :=3{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the row operation ${R}_{1}:=3{R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186302108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c59c60-7047-52d5-87e2-939004f4e5df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{y}{5}-2 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300051} {:answer/id #uuid "2f11b4f8-857a-5c20-acad-ec6bae4a9637" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solution" :db/id #edb/ref 17592186300189} {:answer/id #uuid "7456e911-694c-5708-b6ea-4413295c3756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{5}{2}-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300539} {:answer/id #uuid "a14ecff4-c49b-5d5d-a419-1378eddbc09c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}5-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300774} {:answer/id #uuid "aa051ba2-8988-5b2b-a5fb-1ce37c227a56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{5}{2}+x \\\\ x\\end{bmatrix},\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300815}] :answer-field/correct {:db/id #edb/ref 17592186300539} :answer-field/id #uuid "ead03c74-07ea-57d9-9500-45e44f75354b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301973}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cbdb5209-5ae6-5fea-a525-87f604e2410b" :question/math-academy-id "q-32244" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+2y &=5 \\\\ -10x-10y &=-25 \\\\ 8x+8y &=20.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & \\frac{5}{2} \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{array}\\right] & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 8 & 8 & 20\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-8){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x+y &=\\frac{5}{2}\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=\\frac{5}{2}-y \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}\\frac{5}{2}-y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eefeb35-a93a-5693-8a54-a335560cde62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=0" :db/id #edb/ref 17592186300764} {:answer/id #uuid "a14a43e5-9b21-562f-aaa1-5f805da32173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-4" :db/id #edb/ref 17592186300773} {:answer/id #uuid "a2621a0b-e192-593d-b62d-8165fb69e7a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=2" :db/id #edb/ref 17592186300778} {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-2" :db/id #edb/ref 17592186300857} {:answer/id #uuid "f15a5a0a-88a7-5b7b-9e41-9d091c25e2a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=4" :db/id #edb/ref 17592186301152}] :answer-field/correct {:db/id #edb/ref 17592186300857} :answer-field/id #uuid "0c0fdc5a-0dcc-576e-afcb-e159db8dd3fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301262}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "534e2a93-e71a-5475-894e-dfd5ca99a3a6" :question/math-academy-id "q-32245" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ 4x+ky &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ 4 & k & 4\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ 4 & k & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & -1 & 3 \\\\ 0 & k+2 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}2x-y &=3 \\\\ (k+2)y &=-2.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nNow if $k=-2$, then the second equation is $0=-2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when  $k=-2.$"}] [{:db/id #edb/ref 17592186302143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=2" :db/id #edb/ref 17592186300241} {:answer/id #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=0" :db/id #edb/ref 17592186300297} {:answer/id #uuid "7951ba97-6d77-594c-84f6-7b1ce6a00426" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-5" :db/id #edb/ref 17592186300560} {:answer/id #uuid "8713309c-6e3b-5cbf-9236-a21b2e8d5efd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-8" :db/id #edb/ref 17592186300642} {:answer/id #uuid "99ccc30d-db87-5ff3-b366-54bc530fc04c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-2" :db/id #edb/ref 17592186300734}] :answer-field/correct {:db/id #edb/ref 17592186300241} :answer-field/id #uuid "7a94e5ac-1c4c-5f66-9534-54809e136ec5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f5f8dda9-f72e-566e-91bc-44ecdce08b8e" :question/math-academy-id "q-32331" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ 8x+ky &=5\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}-4 & -1 & 2 \\\\ 8 & k & 5\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}-4 & -1 & 2 \\\\ 8 & k & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-4 & -1 & 2 \\\\ 0 & k-2 & 9\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}-4x-y &=2 \\\\ (k-2)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=2,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=2.$"}] [{:db/id #edb/ref 17592186302193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e2124c-250c-5553-90ac-ad036367a54c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}6 \\\\ -4-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186299936} {:answer/id #uuid "1428c74d-a417-5a13-a349-88d508754aa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ {x}_{2} \\\\ 6+{x}_{2}\\end{bmatrix},\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300041} {:answer/id #uuid "16ebfa7c-e065-59dc-ac56-9ad2d722ea9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300054} {:answer/id #uuid "46144e61-deb2-5eb2-93d9-1c9a051af1e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}8 \\\\ -6+{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300311} {:answer/id #uuid "ceb22f69-ba3e-510b-bac2-26a4175bcd5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-4 \\\\ {x}_{2} \\\\ 6-2{x}_{2}\\end{bmatrix},\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300994}] :answer-field/correct {:db/id #edb/ref 17592186300054} :answer-field/id #uuid "fcaee800-c02a-5f44-8ba8-6b7bcc06692e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186302033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a1b8b6ae-30af-5f18-a21d-8dba558350b5" :question/math-academy-id "q-32517" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+2{x}_{2}+4{x}_{3} &=-4 \\\\ {x}_{2}+2{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -2 \\\\ 0 & 1 & 2 & -6\\end{array}\\right] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 4 \\\\ 0 & 1 & 2 & -6\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now   \n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=4 \\\\ {x}_{2}+2{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ Since we have that ${x}_{1}=4$,  we only need to find ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}{x}_{1} &=4 \\\\ {x}_{2} &=-6-2{x}_{3},\\end{aligned}\\right.\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{bmatrix},\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186319174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aab6359-d412-5594-9846-75e761e2adf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186317696} {:answer/id #uuid "2bdefd21-573e-5f0e-84c7-9994c7e195f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186317700} {:answer/id #uuid "4472fcff-17d4-5a02-a680-9de0b581a073" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186317788} {:answer/id #uuid "f75dceba-84c1-5c39-9174-0200a28709ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186318384} {:answer/id #uuid "fde7d800-efa6-5d51-97dd-1d43ce1bba79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186318414}] :answer-field/correct {:db/id #edb/ref 17592186317700} :answer-field/id #uuid "4af871db-2403-531b-aa56-f1be63167c90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186318590}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dbc23108-6d38-5169-be16-bd8ae0c5611e" :question/math-academy-id "q-34725" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & -1 & -1 \\\\ -2 & 2 & -2\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & -1 \\\\ 0 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}1 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}\\})=2.\n$$"}] [{:db/id #edb/ref 17592186321058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85d268a4-da68-5461-a5fd-4325487f2486" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186319793} {:answer/id #uuid "8e081505-3e87-527d-928a-050077ac043e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186319815} {:answer/id #uuid "a9f2b1f8-3c4d-5787-adea-b1ec3788961d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319903} {:answer/id #uuid "dca55a5a-8830-5a03-b9ee-73e0f828dbe2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186320062} {:answer/id #uuid "fb52be77-be13-5cd3-9f52-a1bc052f07d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186320148}] :answer-field/correct {:db/id #edb/ref 17592186320148} :answer-field/id #uuid "e593bb99-2134-5208-8b24-97c01ed0e7f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8505e165-2993-5e50-9039-0c1c0e794caf" :question/math-academy-id "q-35292" :question/problem "Determine the dimension of\n$$\n\\displaystyle \\text{Span}\\{\\begin{bmatrix}1 \\\\ -5 \\\\ 0\\end{bmatrix},\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix},\\begin{bmatrix}-7 \\\\ -9 \\\\ 6\\end{bmatrix}\\}.\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 4 & -7 \\\\ -5 & 2 & -9 \\\\ 0 & -3 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 4 & -7 \\\\ 0 & 22 & -44 \\\\ 0 & -3 & 6\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{3}{22}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 4 & -7 \\\\ 0 & 22 & -44 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, the dimension of the span is $2.$"}] [{:db/id #edb/ref 17592186321061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29de170a-c6df-528c-9251-01f3de79ef6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319525} {:answer/id #uuid "38e191bb-945f-5f74-84c7-b6dbab73d721" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319566} {:answer/id #uuid "5d4489fa-8058-58fc-9d16-c24df105f95b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319671} {:answer/id #uuid "da2382ba-e1ad-5327-8727-332d59ce6c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186320055} {:answer/id #uuid "e11b8b77-8937-57d0-997a-adeec99d9234" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186320073}] :answer-field/correct {:db/id #edb/ref 17592186319566} :answer-field/id #uuid "79cea883-b687-5151-a7fb-d722579f29c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320416}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2472ea9f-8e8e-5b80-8c7c-945a5a43c650" :question/math-academy-id "q-35297" :question/problem "Determine the dimension of\n$$\n\\displaystyle \\text{Span}\\{\\begin{bmatrix}5 \\\\ 4 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-10 \\\\ -2 \\\\ -6\\end{bmatrix}\\}.\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 & -10 \\\\ 4 & -2 \\\\ 3 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\left(-\\frac{4}{5}\\right){R}_{1} \\\\  & ∼\\begin{bmatrix}5 & -10 \\\\ 0 & 6 \\\\ 3 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\left(-\\frac{3}{5}\\right){R}_{1} \\\\  & ∼\\begin{bmatrix}5 & -10 \\\\ 0 & 6 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, the dimension of the span is $2.$"}] [{:db/id #edb/ref 17592186321062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0077e2b0-9780-54fe-afa4-b670dc9fed69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319393} {:answer/id #uuid "3acae8da-de1f-55f4-a6ed-13701c01de6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319570} {:answer/id #uuid "3b0903cd-0495-574d-b41e-abbe3013ddf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319571} {:answer/id #uuid "87860f14-7358-57f6-a4a5-2a37b1f9c9ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319798} {:answer/id #uuid "cf85f8ab-e663-568c-9644-773ac18a9dfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186320028}] :answer-field/correct {:db/id #edb/ref 17592186319798} :answer-field/id #uuid "cc4b9fed-d8b4-5a97-89f5-38bb7b5b308d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320596}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2304859f-a364-5093-b7c5-56d02eda6877" :question/math-academy-id "q-35298" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}2 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -3 & 5 \\\\ -4 & 6 & -10\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & 5 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, it has exactly $1$ non-zero row). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}2 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10\\end{bmatrix}\\})=1.\n$$"}] [{:db/id #edb/ref 17592186321063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ab403f1-37e8-5537-b482-1b497f41b6de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319614} {:answer/id #uuid "7defa742-522c-5545-9656-199144eab8fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186319768} {:answer/id #uuid "8ebdd4c7-2b1d-5b85-aec1-f2e0254b78bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319818} {:answer/id #uuid "d4ae9ea2-f7af-5bb3-9254-c194f6f8817e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186320039} {:answer/id #uuid "eebdfceb-9ba4-5843-ba91-acb1afc553e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186320107}] :answer-field/correct {:db/id #edb/ref 17592186320107} :answer-field/id #uuid "bab218b2-bffd-5950-8dc4-5254fdc0b910" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320547}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9e1095e2-b747-574e-a018-9f92abb5fb55" :question/math-academy-id "q-35299" :question/problem "Determine the dimension of\n$$\n\\displaystyle \\text{Span}{\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 5 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 5 \\\\ -2\\end{bmatrix}}.\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ -1 & 3 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & \\frac{3}{2} & -\\frac{5}{2}\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\left(-\\frac{3}{10}\\right){R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -3 & -1 \\\\ 0 & 5 & 5 \\\\ 0 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"}] [{:db/id #edb/ref 17592186321065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267fce2f-8f79-53e9-831e-7c2a90e2adc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186319510} {:answer/id #uuid "345eb41a-6222-5988-930d-6af162d31248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319552} {:answer/id #uuid "48471577-d3ba-5647-a23c-9be647a9f57c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319607} {:answer/id #uuid "96266788-11c1-5a60-bc6e-f7ab6b25cc84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319834} {:answer/id #uuid "a1b8e6ac-3f8b-59ff-9fcc-f59861669f49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319873}] :answer-field/correct {:db/id #edb/ref 17592186319607} :answer-field/id #uuid "eca04464-a958-5b61-98f7-1d33e413d898" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320654}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2a41f8fd-4b7f-554c-b544-a6304735d193" :question/math-academy-id "q-35302" :question/problem "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{bmatrix}\\})=\n$$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ -1 & 0 & 2 & -1 \\\\ 0 & -2 & 4 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\left(-\\frac{1}{2}\\right){R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & -\\frac{5}{2} & 5 & -\\frac{5}{2} \\\\ 0 & -2 & 4 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{5}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & -2 & 4 & -2\\end{bmatrix} & {R}_{4} & :={R}_{4}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 5 & -6 & 3 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, it has exactly $2$ non-zero rows). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 0 \\\\ -1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}5 \\\\ 1 \\\\ 0 \\\\ -2\\end{bmatrix},\\begin{bmatrix}-6 \\\\ -2 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}3 \\\\ 1 \\\\ -1 \\\\ -2\\end{bmatrix}\\})=2.\n$$"}] [{:db/id #edb/ref 17592186321066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b85b279-7e69-58e1-a4f9-4b75ae988e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186319470} {:answer/id #uuid "64bf6646-5170-5bb1-8e05-e24752360acc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186319699} {:answer/id #uuid "7e96af98-5bfb-5e34-afca-b9cf9d10ef39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186319770} {:answer/id #uuid "bc3cbb5a-6d77-51f2-bfe2-db9526ea77ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186319961} {:answer/id #uuid "f454b58e-29cd-5edd-8ccd-449ab4ecf6fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186320125}] :answer-field/correct {:db/id #edb/ref 17592186319770} :answer-field/id #uuid "81bf6810-4bfe-5e20-bf04-b7a714fed99f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186320430}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5fad5527-7b65-5529-b82c-0602148a162d" :question/math-academy-id "q-35305" :question/problem "Let $A$ be a $3\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b5be7eb-072d-5dbb-85d1-4bb399b16dbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186321739} {:answer/id #uuid "682f17c8-dc59-5ca2-9a8d-858f8e1d270d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186321960} {:answer/id #uuid "69b23ec7-308e-55f0-87ff-d98810e90a1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186321975} {:answer/id #uuid "d22ac36a-96b4-56fa-bb44-6e52d5841d9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186322788} {:answer/id #uuid "e52564db-fb76-550d-a946-192a8ea03547" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186322940}] :answer-field/correct {:db/id #edb/ref 17592186321960} :answer-field/id #uuid "e9490f7a-31fa-5933-90ba-5b4d669f2d46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323627}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "98e375b6-3e6d-5b62-8ce3-1cf16ed1d92d" :question/math-academy-id "q-35434" :question/problem "Find $\\text{rank}(A)$ given that\n\n$$\n\\text{Null}(A)=\\left\\{\\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ {x}_{2}-{x}_{3} \\\\ -3{x}_{1}+{x}_{3} \\\\ {x}_{1}+{x}_{2}+{x}_{3}\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\right\\}.\n$$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\left\\{{x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ -3 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\right\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =4 \\\\ \\text{rank}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323765 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ce51d3d-741a-5369-986e-eefed5ac9f85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=-4,\\,b=0,\\,c=4" :db/id #edb/ref 17592186321883} {:answer/id #uuid "7ca0482f-4c6e-5b47-9cb6-8938fc8f2f8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=-2,\\,b=7,\\,c=-5" :db/id #edb/ref 17592186322128} {:answer/id #uuid "8383a234-7ee7-5c7c-b65b-25632a4d878c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=3,\\,b=4,\\,c=7" :db/id #edb/ref 17592186322184} {:answer/id #uuid "89c3a6e4-255a-5b64-b610-f937bd99d980" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=-4,\\,b=-5,\\,c=8" :db/id #edb/ref 17592186322246} {:answer/id #uuid "9a9951b6-2f89-5a28-89c6-2fbd021d5540" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a=8,\\,b=-5,\\,c=-4" :db/id #edb/ref 17592186322374}] :answer-field/correct {:db/id #edb/ref 17592186322374} :answer-field/id #uuid "fa7d2367-57ba-5860-a0e9-b45ec2c3a521" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323660}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "075fd7f5-bea7-5040-92fa-5b19399df625" :question/math-academy-id "q-36178" :question/problem "The system of equations\n\n$$\n\\left\\{\\begin{aligned}3x+2y+8z &=0 \\\\ 2x-5y+4z &=3 \\\\ 5x-4y+7z &=-2\\end{aligned}\\right.\n$$\n\ncan be represented using matrix notation as\n\n$$\n\\begin{bmatrix}3 & 2 & a \\\\ 2 & b & 4 \\\\ 5 & c & 7\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 3 \\\\ -2\\end{bmatrix}.\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=\\begin{bmatrix}3 & 2 & 8 \\\\ 2 & -5 & 4 \\\\ 5 & -4 & 7\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\nb=\\begin{bmatrix}0 \\\\ 3 \\\\ -2\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\nx=\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n\\begin{bmatrix}3 & 2 & 8 \\\\ 2 & -5 & 4 \\\\ 5 & -4 & 7\\end{bmatrix}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 3 \\\\ -2\\end{bmatrix}.\n$$\n\nTherefore, $a=8,\\,b=-5,\\,c=-4.$"}] [{:db/id #edb/ref 17592186323936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cf451e-40c4-5086-8442-4ceec7825fcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186321459} {:answer/id #uuid "44c5522c-e2ed-5c0c-b6d9-fa32ff78e74b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}-1 & 0 & -2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & -1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186321691} {:answer/id #uuid "5fb7d0e1-ce60-5e51-85aa-253d9e1e857a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}-1 & 0 & 2 & 2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186321901} {:answer/id #uuid "8785d91d-9bc4-54d1-b19e-7288e20b0326" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186322225} {:answer/id #uuid "a0d65888-5e15-59ab-a0b5-6b4507637241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186322417}] :answer-field/correct {:db/id #edb/ref 17592186322225} :answer-field/id #uuid "563b3367-86c2-58ad-8433-479dfbcdc69d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323335}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19a5f3b2-35c3-5827-a1e7-20c819c308c9" :question/math-academy-id "q-37770" :question/problem "Consider the system\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{1}+4{x}_{3} &=4 \\\\ {x}_{2}-5{x}_{3} &=3 \\\\ 3{x}_{1}-6{x}_{3} &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 0 & 4 & 4 \\\\ 0 & 1 & -5 & 3 \\\\ 3 & 0 & -6 & -6\\end{array}\\right].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}-2 & 0 & 4 & 4 \\\\ 0 & 1 & -5 & 3 \\\\ 3 & 0 & -6 & -6\\end{array}\\right] & {R}_{1} & :=-\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 3 & 0 & -6 & -6\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & -2 \\\\ 0 & 1 & -5 & 3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "421cbfe9-9b22-5420-93a5-b97b4f3e3f24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & -1 & 1 & 1 \\\\ 0 & 0 & 0 & 4\\end{array}\\right]" :db/id #edb/ref 17592186321671} {:answer/id #uuid "5f4226e8-c944-55a1-a5c6-83de652f8fe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 0 & 5\\end{array}\\right]" :db/id #edb/ref 17592186321897} {:answer/id #uuid "6ef83589-8fda-54ea-ae57-b74616151461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 0 & -1\\end{array}\\right]" :db/id #edb/ref 17592186322005} {:answer/id #uuid "787c35b2-0007-5ed1-b52c-9f770ab784cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186322094} {:answer/id #uuid "8310ff5c-7fab-5cf2-9293-d1225604e2b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -2 \\\\ 0 & -1 & 1 & 0 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186322181}] :answer-field/correct {:db/id #edb/ref 17592186322005} :answer-field/id #uuid "27eebce0-3e5d-5e82-a911-315587af5b17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323251}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2876023b-e3be-555c-9447-7b41ee9d170f" :question/math-academy-id "q-37771" :question/problem "Consider the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-2{x}_{3} &=-2 \\\\ -2{x}_{1}-{x}_{2}+5{x}_{3} &=3 \\\\ 5{x}_{1}+4{x}_{2}-11{x}_{3} &=-10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ -2 & -1 & 5 & 3 \\\\ 5 & 4 & -11 & -10\\end{array}\\right].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ -2 & -1 & 5 & 3 \\\\ 5 & 4 & -11 & -10\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 5 & 4 & -11 & -10\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-5){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & -1 & -1 & 0\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & -2 & -2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 0 & -1\\end{array}\\right].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323974 :questi