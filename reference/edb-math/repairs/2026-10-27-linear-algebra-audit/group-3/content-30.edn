ref 17592186119845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119659} :knowledge-point/id #uuid "8a5d11c2-4a7c-5fdc-a363-8a87b90db19e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049222}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186120529} {:db/id #edb/ref 17592186120530} {:db/id #edb/ref 17592186278261} {:db/id #edb/ref 17592186348198} {:db/id #edb/ref 17592186348199} {:db/id #edb/ref 17592186348201} {:db/id #edb/ref 17592186348202} {:db/id #edb/ref 17592186348203} {:db/id #edb/ref 17592186348204} {:db/id #edb/ref 17592186348205} {:db/id #edb/ref 17592186410545} {:db/id #edb/ref 17592186410546} {:db/id #edb/ref 17592186424595} {:db/id #edb/ref 17592186430827} {:db/id #edb/ref 17592186430829} {:db/id #edb/ref 17592186483398} {:db/id #edb/ref 17592186597554}] :knowledge-point/title "Finding the Dimension of a Span by Inspection"}] [{:db/id #edb/ref 17592186119846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119660} :knowledge-point/id #uuid "004c4177-ca0e-586c-962a-1220b4b64f47" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186120365} {:db/id #edb/ref 17592186120367} {:db/id #edb/ref 17592186319174} {:db/id #edb/ref 17592186321058} {:db/id #edb/ref 17592186321061} {:db/id #edb/ref 17592186321062} {:db/id #edb/ref 17592186321063} {:db/id #edb/ref 17592186321065} {:db/id #edb/ref 17592186410547} {:db/id #edb/ref 17592186410548} {:db/id #edb/ref 17592186424594} {:db/id #edb/ref 17592186430828} {:db/id #edb/ref 17592186481376} {:db/id #edb/ref 17592186597539} {:db/id #edb/ref 17592186597544} {:db/id #edb/ref 17592186597579} {:db/id #edb/ref 17592186605843}] :knowledge-point/title "Finding the Dimension of a Span Using Row Reduction"}] [{:db/id #edb/ref 17592186119870 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119687} :knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045487}] :knowledge-point/questions [{:db/id #edb/ref 17592186120419} {:db/id #edb/ref 17592186120433} {:db/id #edb/ref 17592186266142} {:db/id #edb/ref 17592186266143} {:db/id #edb/ref 17592186266145} {:db/id #edb/ref 17592186266147} {:db/id #edb/ref 17592186329693} {:db/id #edb/ref 17592186357514} {:db/id #edb/ref 17592186357515} {:db/id #edb/ref 17592186440778} {:db/id #edb/ref 17592186440781} {:db/id #edb/ref 17592186484204} {:db/id #edb/ref 17592186551247} {:db/id #edb/ref 17592186661505}] :knowledge-point/title "Computing 4x4 Determinants Using Row and Column Operations"}] [{:db/id #edb/ref 17592186119874 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119690} :knowledge-point/id #uuid "6b0edd60-2801-59d3-b9df-18bfbf8763bb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048462} {:db/id #edb/ref 17592186048505}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120434} {:db/id #edb/ref 17592186120546} {:db/id #edb/ref 17592186266066} {:db/id #edb/ref 17592186357503} {:db/id #edb/ref 17592186392528} {:db/id #edb/ref 17592186394840} {:db/id #edb/ref 17592186440776} {:db/id #edb/ref 17592186440777} {:db/id #edb/ref 17592186440779} {:db/id #edb/ref 17592186440782} {:db/id #edb/ref 17592186484254} {:db/id #edb/ref 17592186551271} {:db/id #edb/ref 17592186551323} {:db/id #edb/ref 17592186661540}] :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Row Operations"}] [{:db/id #edb/ref 17592186119875 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119691} :knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120545} {:db/id #edb/ref 17592186120547} {:db/id #edb/ref 17592186266127} {:db/id #edb/ref 17592186357508} {:db/id #edb/ref 17592186357512} {:db/id #edb/ref 17592186357513} {:db/id #edb/ref 17592186388251} {:db/id #edb/ref 17592186394854} {:db/id #edb/ref 17592186440780} {:db/id #edb/ref 17592186484245} {:db/id #edb/ref 17592186551268} {:db/id #edb/ref 17592186551282} {:db/id #edb/ref 17592186590786} {:db/id #edb/ref 17592186590787} {:db/id #edb/ref 17592186590837} {:db/id #edb/ref 17592186661521}] :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] [{:db/id #edb/ref 17592186121022 :tutorial/content "In this topic, we will consider a few more properties of determinants. Let's start with the following important property. \n\n*The determinant of the product of two square matrices is equal to the product of the determinants.*\n\nSymbolically, if $M$ and $N$ are both square matrices, then\n\n$$\n\\det  ( M \\cdot  N ) = \\det  ( M ) \\cdot  \\det  ( N ) .\n$$\n\nFor instance, suppose that we want to find the determinant of the matrix $A$ that is defined as follows:\n$$\nA = \n\t{\\left[ \\begin{array}{ccc}1 & 0 & 0 \\\\ - 2 & - 3 & 0 \\\\ 2 & 0 & 2\\end{array} \\right]}\n\t{\\left[ \\begin{array}{ccc}3 & - 10 & \\sqrt{2} \\\\ 0 & 5 & 2 \\sqrt{3} \\\\ 0 & 0 & - 1\\end{array} \\right]}\n$$\n\nTo easily compute $\\det(A)$, we first compute the determinants of the two matrices and then multiply the results. Also, notice that both matrices in our product are triangular, so their determinants are given by the product of the diagonal entries:\n\n$$\n\\begin{array}{cc}\\det  ( A ) &  = \\det  \\left[ \\begin{array}{ccc}1 & 0 & 0 \\\\ - 2 & - 3 & 0 \\\\ 2 & 0 & 2\\end{array} \\right] \\cdot  \\det  \\left[ \\begin{array}{ccc}3 & - 10 & \\sqrt{2} \\\\ 0 & 5 & 2 \\sqrt{3} \\\\ 0 & 0 & - 1\\end{array} \\right] \\\\  &  = \\underset{\\text{lower triangular}}{\\underbrace{∣ \\begin{array}{ccc}{\\color{red}1} & {\\color{blue}0} & {\\color{blue}0} \\\\ - 2 & {\\color{red}- 3} & {\\color{blue}0} \\\\ 2 & 0 & {\\color{red}2}\\end{array} ∣}} \\cdot  \\underset{\\text{upper triangular}}{\\underbrace{∣ \\begin{array}{ccc}{\\color{red}3} & - 10 & \\sqrt{2} \\\\ {\\color{blue}0} & {\\color{red}5} & 2 \\sqrt{3} \\\\ {\\color{blue}0} & {\\color{blue}0} & {\\color{red}- 1}\\end{array} ∣}} \\\\  &  = ( {\\color{red}1} \\cdot  ( {\\color{red}- 3} ) \\cdot  {\\color{red}2} ) \\cdot  ( {\\color{red}3} \\cdot  {\\color{red}5} \\cdot  ( {\\color{red}- 1} ) ) \\\\  &  = ( - 6 ) \\cdot  ( - 15 ) \\\\  &  = 90\\end{array}\n$$" :tutorial/id #uuid "5a8abcbc-c41d-5553-8b2e-daa7256d7d34" :tutorial/math-academy-id 3009 :tutorial/title "Introduction"}] [{:db/id #edb/ref 17592186121023 :tutorial/content "Another useful property of determinants is that, for any invertible matrix $A,$ we have\n\n$$\n\\det(A^{-1}) = \\dfrac{1}{\\det(A)}.\n$$\n\nTo understand why the above property is true, remember that $A \\cdot A^{-1} = I$ for any invertible matrix $A.$ So, we have\n\n$$\n\\begin{aligned}A\\cdot {A}^{-1} & =I \\\\ det(A\\cdot {A}^{-1}) & =det(I) \\\\ det(A)\\cdot det({A}^{-1}) & =1 \\\\ det({A}^{-1}) & =\\frac{1}{det(A)}.\\end{aligned}\n$$\n\n**Important:** We can only apply the formula $\\det(A^{-1}) = \\dfrac{1}{\\det(A)}$ if $A$ is invertible, meaning that $\\det(A) \\neq 0.$" :tutorial/id #uuid "043b8a4a-8f67-5ae8-a7ae-bbda3fa2bdbe" :tutorial/math-academy-id 3010 :tutorial/title "The Determinant of an Inverse Matrix"}]}
