choices [{:answer/id #uuid "34a389ed-2a90-5310-9d49-d9de078d0e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471073} {:answer/id #uuid "14b87aa4-7616-54b5-993b-17ac7bcfc6c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471074}] :answer-field/correct {:answer/id #uuid "34a389ed-2a90-5310-9d49-d9de078d0e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471073} :answer-field/id #uuid "9bac6d2b-71be-5d31-8a9c-1f6b199802d9" :answer-field/key "$Π$ is a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472042} {:answer-field/choices [{:answer/id #uuid "c734eefe-de11-5133-a634-625ab193030d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186669067} {:answer/id #uuid "0a5f9e72-fc00-57ea-bd06-6f3e9150a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669068}] :answer-field/correct {:answer/id #uuid "0a5f9e72-fc00-57ea-bd06-6f3e9150a5a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186669068} :answer-field/id #uuid "34f2ba81-0efa-5ed3-88f6-8ca5344a19d1" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186669333}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f7a73387-34bf-50c1-bd13-d6c9025be3b5" :question/math-academy-id "q-157470" :question/problem "Let $Π$ be the plane with equation $2x-y+z=2$ in ${R}^{3}.$ Which of the following statements are true? \n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ 2-2x+y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}2x-y+z & =2 \\\\ 2(0)-(0)+(0) & =2 \\\\ 0 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is false. Let's consider $a=\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}0 \\\\ -2 \\\\ 0\\end{bmatrix}\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -2 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0+0 \\\\ 0+(-2) \\\\ 2+0\\end{bmatrix}=\\begin{bmatrix}0 \\\\ -2 \\\\ 2\\end{bmatrix},\\end{aligned}\n$$\n\nHowever, $\\begin{bmatrix}0 \\\\ -2 \\\\ 2\\end{bmatrix}$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}2x-y+z & =2 \\\\ 2(0)-(-2)+(2) & =2 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under scalar multiplication” is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement “$Π$ is a subspace of ${R}^{3}$” is false. Since statements “$Π$ is closed under vector addition” and “$Π$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186376068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "700557ce-6572-5ee2-a07f-34d93423cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471075} {:answer/id #uuid "c353aaf6-90db-54f4-992e-599b27b80250" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471076}] :answer-field/correct {:answer/id #uuid "700557ce-6572-5ee2-a07f-34d93423cafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471075} :answer-field/id #uuid "334fdb1c-33a5-5fc3-a6c1-ca14b6176b0d" :answer-field/key "$Π$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472043} {:answer-field/choices [{:answer/id #uuid "fa1b9382-ab0d-51d1-b161-c5849bc1195f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471077} {:answer/id #uuid "f0f7775c-4896-5c6a-a1a8-3b9527a4b11d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471078}] :answer-field/correct {:answer/id #uuid "fa1b9382-ab0d-51d1-b161-c5849bc1195f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471077} :answer-field/id #uuid "6a505b43-dfd2-5534-9a4c-af0066c726a3" :answer-field/key "$Π$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472044} {:answer-field/choices [{:answer/id #uuid "5d03f060-6ebf-5283-a886-1008c9f73000" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471079} {:answer/id #uuid "2d73b1c0-28c1-5f56-9383-71e8c8e7cd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 1759