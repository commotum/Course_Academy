er.type/text} :answer/value "true" :db/id #edb/ref 17592186464475}] :answer-field/correct {:answer/id #uuid "7f230175-96a5-5648-a72b-a3f53ab5bf0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464475} :answer-field/id #uuid "97b76e0e-f96a-590c-afb1-fad6d6e43575" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465171} {:answer-field/choices [{:answer/id #uuid "3cd5189d-1f84-59b4-aad4-6cd6be89149c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464476} {:answer/id #uuid "58c78ec7-38c7-545a-9b3d-b3b31b558b7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464477}] :answer-field/correct {:answer/id #uuid "3cd5189d-1f84-59b4-aad4-6cd6be89149c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464476} :answer-field/id #uuid "1f295196-509c-5417-828b-b1db47be1605" :answer-field/key "$L$ is **not** a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465172}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "712144d5-1b91-55e7-970d-beb256e92d9d" :question/math-academy-id "q-157300" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(2,1,-1).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}.\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}2t \\\\ t \\\\ -t\\end{bmatrix}\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n\\frac{x}{2}=y=-z.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}2a \\\\ a \\\\ -a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}2b \\\\ b \\\\ -b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}2a \\\\ a \\\\ -a\\end{bmatrix}+\\begin{bmatrix}2b \\\\ b \\\\ -b\\end{bmatrix}=\\begin{bmatrix}2a+2b \\\\ a+b \\\\ (-a)+(-b)\\end{bmatrix}=\\begin{bmatrix}2(a+b) \\\\ a+b \\\\ -(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{2}=y=-z.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}2a \\\\ a \\\\ -a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}2a \\\\ a \\\\ -a\\end{bmatrix}=\\begin{bmatrix}k(2a) \\\\ ka \\\\ k(-a)\\end{bmatrix}=\\begin{bmatrix}2(ka) \\\\ ka \\\\ -(ka)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{2}=y=-z.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is **not** a subspace of ${R}^{3}$” is false. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is “$L$ contains the zero-vector”; “$L$ is closed under vector addition”; “$L$ is closed under scalar multiplication” only."}] [{:db/id #edb/ref 17592186275391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "944e44ff-e533-5ed4-96bb-5a535eaddc00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464478} {:answer/id #uuid "d9a34893-198a-5797-a5eb-2dac1413854e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464479}] :answer-field/correct {:answer/id #uuid "d9a34893-198a-5797-a5eb-2dac1413854e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464479} :answer-field/id #uuid "0b789df4-0f0f-56cb-9ecd-1817894caa49" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465173} {:answer-field/choices [{:answer/id #uuid "10e4fe65-09fc-52db-9ad9-c4b810d95943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464480} {:answer/id #uuid "a57fa40c-c577-5110-ad32-33826b9d5ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464481}] :answer-field/correct {:answer/id #uuid "a57fa40c-c577-5110-ad32-33826b9d5ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464481} :answer-field/id #uuid "e97038ed-fec6-54a7-be13-57daf6ed6250" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465174} {:answer-field/choices [{:answer/id #uuid "9530189a-66d7-5ec1-bcdd-d8a159b2bb43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464482} {:answer/id #uuid "5ecdaacb-8609-5a2d-aeb6-96682093c1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464483}] :answer-field/correct {:answer/id #uuid "5ecdaacb-8609-5a2d-aeb6-96682093c1e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464483} :answer-field/id #uuid "0d5022e7-1fa9-59b1-bb96-9869737b531f" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465175} {:answer-field/choices [{:answer/id #uuid "f94ae52d-af32-5aa4-b47f-703bd283b958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464484} {:answer/id #uuid "def3d7d0-1890-579f-af10-3e07494b2e5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464485}] :answer-field/correct {:answer/id #uuid "def3d7d0-1890-579f-af10-3e07494b2e5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464485} :answer-field/id #uuid "627aa078-61dc-5bc5-a57c-68e48233cb15" :answer-field/key "$L$ is a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f036c2d4-285c-5c5e-a300-6732346f17c0" :question/math-academy-id "q-157374" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(1,-2,3).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}.\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}t \\\\ -2t \\\\ 3t\\end{bmatrix}\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\nx=-\\frac{y}{2}=\\frac{z}{3}.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -2a \\\\ 3a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}b \\\\ -2b \\\\ 3b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}a \\\\ -2a \\\\ 3a\\end{bmatrix}+\\begin{bmatrix}b \\\\ -2b \\\\ 3b\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ (-2a)+(-2b) \\\\ 3a+3b\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ -2(a+b) \\\\ 3(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $x=-\\frac{y}{2}=\\frac{z}{3}.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -2a \\\\ 3a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}a \\\\ -2a \\\\ 3a\\end{bmatrix}=\\begin{bmatrix}ka \\\\ k(-2a) \\\\ k(3a)\\end{bmatrix}=\\begin{bmatrix}ka \\\\ -2(ka) \\\\ 3(ka)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $x=-\\frac{y}{2}=\\frac{z}{3}.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{3}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186275392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2d0ab31-79fc-56c0-a851-0d5df14186c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464486} {:answer/id #uuid "ec6d2be0-2a80-5e10-a694-2cdeec8a1465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464487}] :answer-field/correct {:answer/id #uuid "ec6d2be0-2a80-5e10-a694-2cdeec8a1465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464487} :answer-field/id #uuid "41cdada3-82d8-5968-8216-ba6d32041a7a" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465177} {:answer-field/choices [{:answer/id #uuid "4c387dbc-a33a-5d64-82b3-98e714d0e769" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464488} {:answer/id #uuid "74498b0d-4aa8-5024-8fe8-8ecef00dd690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464489}] :answer-field/correct {:answer/id #uuid "74498b0d-4aa8-5024-8fe8-8ecef00dd690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464489} :answer-field/id #uuid "3d8c2f63-c223-5c22-bef2-6982183fb90e" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465178} {:answer-field/choices [{:answer/id #uuid "f546280c-e061-5cff-926b-39ec9fff0f3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464490} {:answer/id #uuid "1bc2bfda-bcbf-54c1-9b15-6f62129e7713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464491}] :answer-field/correct {:answer/id #uuid "1bc2bfda-bcbf-54c1-9b15-6f62129e7713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464491} :answer-field/id #uuid "f2a7b39c-01fe-5a81-9cd5-bc2fb5ba5137" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465179} {:answer-field/choices [{:answer/id #uuid "558fec7d-53b0-5787-a5eb-d171da3ebcd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464492} {:answer/id #uuid "d9907495-8e2b-5392-a9a3-629b3c59fa10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464493}] :answer-field/correct {:answer/id #uuid "d9907495-8e2b-5392-a9a3-629b3c59fa10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464493} :answer-field/id #uuid "3b55ce83-b7c2-52d3-8a8b-7cdbe5a56c0c" :answer-field/key "$L$ is a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465180}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fec918c0-b48b-51d4-9fda-9d6b7c9058ec" :question/math-academy-id "q-157375" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(4,3,-2).$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=\\begin{bmatrix}4 \\\\ 3 \\\\ -2\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}4 \\\\ 3 \\\\ -2\\end{bmatrix}.\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}+t\\begin{bmatrix}4 \\\\ 3 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}4t \\\\ 3t \\\\ -2t\\end{bmatrix}\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n\\frac{x}{4}=\\frac{y}{3}=-\\frac{z}{2}.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}4a \\\\ 3a \\\\ -2a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}4b \\\\ 3b \\\\ -2b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}4a \\\\ 3a \\\\ -2a\\end{bmatrix}+\\begin{bmatrix}4b \\\\ 3b \\\\ -2b\\end{bmatrix}=\\begin{bmatrix}4a+4b \\\\ 3a+3b \\\\ (-2a)+(-2b)\\end{bmatrix}=\\begin{bmatrix}4(a+b) \\\\ 3(a+b) \\\\ -2(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{4}=\\frac{y}{3}=-\\frac{z}{2}.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}4a \\\\ 3a \\\\ -2a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}4a \\\\ 3a \\\\ -2a\\end{bmatrix}=\\begin{bmatrix}k(4a) \\\\ k(3a) \\\\ k(-2a)\\end{bmatrix}=\\begin{bmatrix}4(ka) \\\\ 3(ka) \\\\ -2(ka)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{4}=\\frac{y}{3}=-\\frac{z}{2}.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{3}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186275393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97742b8a-34cf-5189-af20-df43023c61dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464494} {:answer/id #uuid "7ae0d77e-ad6b-5f6a-9374-9d4e224b4416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464495}] :answer-field/correct {:answer/id #uuid "97742b8a-34cf-5189-af20-df43023c61dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464494} :answer-field/id #uuid "744a436e-d533-5945-91e9-1188f48f53b0" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465181} {:answer-field/choices [{:answer/id #uuid "16e608cd-a84d-5934-9295-cbb3b7804914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464496} {:answer/id #uuid "5eddee3a-9355-5dc5