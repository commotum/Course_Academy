86045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448445} :answer-field/id #uuid "5b3216b8-68d0-5976-8b72-88a30238ee44" :answer-field/key "$Π$ is **not** a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449262}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f59c175-a7f1-58ec-b16f-fd24b9c9dd63" :question/math-academy-id "q-156685" :question/problem "Let $Π$ be the plane with equation $x-y-z=1$ in ${R}^{3}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ x-y-1\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}z & =x-y-1 \\\\ (0) & =(0)-(0)-(1) \\\\ 0 & =-1\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is false. Let's consider $a=\\begin{bmatrix}0 \\\\ 0 \\\\ -1\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}0 \\\\ 0 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}0+1 \\\\ 0+0 \\\\ -1+0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix},\\end{aligned}\n$$\n\nHowever, $\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}z & =x-y-1 \\\\ (-1) & =(1)-(0)-1 \\\\ -1 & =0\\,\\times \\end{aligned}\n$$\n\n- Statement “$Π$ is closed under scalar multiplication” is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement “$Π$ is **not** a subspace of ${R}^{3}$” is true. Since statements “$Π$ is closed under vector addition” and “$Π$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is “$Π$ is **not** a subspace of ${R}^{3}$” only."}] [{:db/id #edb/ref 17592186120153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e25ac228-d193-5ebc-8755-db62b8ed2d6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448446} {:answer/id #uuid "97e87930-b43d-5bac-9e1c-47a721b48491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448447}] :answer-field/correct {:answer/id #uuid "97e87930-b43d-5bac-9e1c-47a721b48491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448447} :answer-field/id #uuid "3d500936-ee82-5080-ac08-bef3d3eaa3c1" :answer-field/key "$Π$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449263} {:answer-field/choices [{:answer/id #uuid "86c8192b-16cf-5e19-8b80-1add681eb5aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448448} {:answer/id #uuid "cd6afe2d-18b1-5a6d-ac8f-bec0627bec1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448449}] :answer-field/correct {:answer/id #uuid "cd6afe2d-18b1-5a6d-ac8f-bec0627bec1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448449} :answer-field/id #uuid "2c9a0b63-a428-59e7-8e61-153351ae6756" :answer-field/key "$Π$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449264} {:answer-field/choices [{:answer/id #uuid "abdcf3ff-572a-5007-97fb-7924447d2418" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448450} {:answer/id #uuid "7d29026a-1829-5065-a9e8-5223d4001976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448451}] :answer-field/correct {:answer/id #uuid "7d29026a-1829-5065-a9e8-5223d4001976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448451} :answer-field/id #uuid "5735db43-5ab0-59bd-bf1d-6365653e745a" :answer-field/key "$Π$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449265} {:answer-field/choices [{:answer/id #uuid "e99e80e5-f93b-5878-83fd-8192fe31da43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448452} {:answer/id #uuid "6bb90d13-99f5-5226-86da-aa3c3e18067c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448453}] :answer-field/correct {:answer/id #uuid "e99e80e5-f93b-5878-83fd-8192fe31da43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448452} :answer-field/id #uuid "7a9210ac-f65d-536c-92f2-e1ec02b3e035" :answer-field/key "$Π$ is **not** a subspace of ${R}^{3}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449266}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ceae9baf-b635-5e21-b116-a9e3e8cfea9c" :question/math-academy-id "q-156719" :question/problem "Let $Π$ be the plane with equation $z=x-y$ in ${R}^{3}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}x \\\\ y \\\\ x-y\\end{bmatrix},\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$Π$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $z=x-y:$\n\n$$\n\\begin{aligned}z & =x-y \\\\ (0) & =(0)-(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$Π$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{bmatrix}\\in Π$ and $b=\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}-{b}_{2}\\end{bmatrix}\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{bmatrix}+\\begin{bmatrix}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+{b}_{2}\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}-{a}_{2})+({b}_{1}-{b}_{2})\\end{bmatrix}=\\begin{bmatrix}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}+{b}_{1})-({a}_{2}+{b}_{2})\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x-y.$ Therefore, $a+b\\in Π.$\n\n- Statement “$Π$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{bmatrix}\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k({a}_{1}-{a}_{2})\\end{bmatrix}=\\begin{bmatrix}k{a}_{1} \\\\ k{a}_{2} \\\\ k{a}_{1}-k{a}_{2}\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x-y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement “$Π$ is **not** a subspace of ${R}^{3}$” is false. Since statements “$Π$ is closed under vector addition” and “$Π$ is closed under scalar multiplication” are true, $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is “$Π$ contains the zero-vector”; “$Π$ is closed under vector addition”; “$Π$ is closed under scalar multiplication” only."}] [{:db/id #edb/ref 17592186275357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "398c8456-89a1-5b2a-b177-7c042901d158" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464438} {:answer/id #uuid "0ff8260e-6af0-52e3-bb10-d965f0c5153e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464439}] :answer-field/correct {:answer/id #uuid "0ff8260e-6af0-52e3-bb10-d965f0c5153e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464439} :answer-field/id #uuid "a8f499f9-88c4-51cf-b7cc-fce0e2052fbd" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465153} {:answer-field/choices [{:answer/id #uuid "c0b69d56-1ac2-5658-9220-6daa7ad09e35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464440} {:answer/id #uuid "3902b043-29bf-5320-92e3-81580b55d422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464441}] :answer-field/correct {:answer/id #uuid "3902b043-29bf-5320-92e3-81580b55d422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464441} :answer-field/id #uuid "3373aec6-7201-50eb-aefe-ad0080fb7754" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465154} {:answer-field/choices [{:answer/id #uuid "1f78f89e-a16f-5632-97f4-b5609621130b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464442} {:answer/id #uuid "7947bcec-220d-561f-a8dd-3f1053459776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464443}] :answer-field/correct {:answer/id #uuid "7947bcec-220d-561f-a8dd-3f1053459776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464443} :answer-field/id #uuid "a2bf7047-04e8-5d42-b4cd-8c904a7e2b18" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465155} {:answer-field/choices [{:answer/id #uuid "84c6930c-489d-5bd2-8a89-92301e886857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464444} {:answer/id #uuid "bbd70689-73bb-5018-9cb5-e10d2dd592c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464445}] :answer-field/correct {:answer/id #uuid "bbd70689-73bb-5018-9cb5-e10d2dd592c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464445} :answer-field/id #uuid "f7476c97-72af-5a74-aead-e576226375b1" :answer-field/key "$L$ is a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465156}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41028c0a-ba2e-5172-bd8b-8e9a6506adda" :question/math-academy-id "q-156596" :question/problem "Let $L$ be the line with equation $y=-x$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}x \\\\ -x\\end{bmatrix},\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $y=-x:$\n\n$$\n\\begin{aligned}y & =-x \\\\ (0) & =-(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}b \\\\ -b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}a \\\\ -a\\end{bmatrix}+\\begin{bmatrix}b \\\\ -b\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ (-a)+(-b)\\end{bmatrix}=\\begin{bmatrix}a+b \\\\ -(a+b)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-x.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}a \\\\ -a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}a \\\\ -a\\end{bmatrix}=\\begin{bmatrix}ka \\\\ k(-a)\\end{bmatrix}=\\begin{bmatrix}ka \\\\ -(ka)\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $y=-x.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186275358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34a088cc-b42a-52bc-92eb-bd25ac5895d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449708} {:answer/id #uuid "1ae9d0d2-5225-533c-916d-258badd95105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449709}] :answer-field/correct {:answer/id #uuid "34a088cc-b42a-52bc-92eb-bd25ac5895d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449708} :answer-field/id #uuid "937dcbfa-8dc3-50f6-a185-ae4dc328b41b" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450808} {:answer-field/choices [{:answer/id #uuid "326c98a9-ff77-5b6e-aecb-8e7f1dddecc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449710} {:answer/id #uuid "ac781d5c-11d4-539a-a6a0-03e56d803d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449711}] :answer-field/correct {:answer/id #uuid "326c98a9-ff77-5b6e-aecb-8e7f1dddecc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449710} :answer-field/id #uuid "c513012e-f0c7-59bd-93e1-bc2abf1598e4" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450809} {:answer-field/choices [{:answer/id #uuid "31a8c64f-0c9c-5370-8df5-0f3072768ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449712} {:answer/id #uuid "aced70ec-42bb-5c36-a298-f7b0a764a07e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449713}] :answer-field/correct {:answer/id #uuid "31a8c64f-0c9c-5370-8df5-0f3072768ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449712} :answer-field/id #uuid "9c508d60-bfd9-5766-b225-3dfedd6417f5" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450810} {:answer-field/choices [{:answer/id #uuid "66001218-3dc4-59d1-a926-442ef428f82c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449714} {:answer/id #uuid "67502b01-affc-5927-8b15-bd8da2993526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449715}] :answer-field/correct {:answer/id #uuid "67502b01-affc-5927-8b15-bd8da2993526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449715} :answer-field/id #uuid "ce7a4fe0-4bec-5040-8666-8761d884ec88" :answer-field/key "$L$ is **not** a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450811}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "238a8f80-b240-55d1-a1f3-be7bf8e77e18" :question/math-academy-id "q-156624" :question/problem "Let $L$ be the line with equation $x=2y-1$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2y-1 \\\\ y\\end{bmatrix},\\,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is false. The coordinates of the zero-vector do not satisfy the equation $x=2y-1:$\n\n$$\n\\begin{aligned}x & =2y-1 \\\\ (0) & =2(0)-1 \\\\ 0 & =-1\\,\\times \\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is false. Let, for example, $a=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}$ and $b=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}+\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1+1 \\\\ 0+1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n \nHowever, $\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\notin L$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}x & =2y-1 \\\\ (0) & =2(1)-1 \\\\ 0 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement “$L$ is closed under scalar multiplication” is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement “$L$ is **not** a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is “$L$ is **not** a subspace of ${R}^{2}$” only."}] [{:db/id #edb/ref 17592186275359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f11d9c02-3fcb-5de5-9310-548ef0ea1976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464446} {:answer/id #uuid "af5ca6bf-57c5-54f8-8c3d-74a6501b1c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464447}] :answer-field/correct {:answer/id #uuid "af5ca6bf-57c5-54f8-8c3d-74a6501b1c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464447} :answer-field/id #uuid "d5c0c456-50b3-5b9e-b75c-057a51b3cb94" :answer-field/key "$L$ contains the zero-vector" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465157} {:answer-field/choices [{:answer/id #uuid "31d0dc76-0c99-5824-8dd2-2bb7cd735f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464448} {:answer/id #uuid "2a785ac7-7123-5e81-8212-f960187ffcc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464449}] :answer-field/correct {:answer/id #uuid "2a785ac7-7123-5e81-8212-f960187ffcc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464449} :answer-field/id #uuid "3033df77-bf3c-59b5-9b8c-4f1e33a15732" :answer-field/key "$L$ is closed under vector addition" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465158} {:answer-field/choices [{:answer/id #uuid "abd1831a-3f45-5615-bfb4-1f61ee6504d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464450} {:answer/id #uuid "7e166bca-aae1-51a7-aef5-1c539b2e96c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464451}] :answer-field/correct {:answer/id #uuid "7e166bca-aae1-51a7-aef5-1c539b2e96c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464451} :answer-field/id #uuid "c4bad57b-de5d-5929-9ce2-6ee9a38a2741" :answer-field/key "$L$ is closed under scalar multiplication" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465159} {:answer-field/choices [{:answer/id #uuid "6ec7d5d4-d2c7-5341-b462-a61b953ba95c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464452} {:answer/id #uuid "b7e32e69-5a2f-5d72-9e79-4f67730c1317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464453}] :answer-field/correct {:answer/id #uuid "b7e32e69-5a2f-5d72-9e79-4f67730c1317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464453} :answer-field/id #uuid "d911c6c4-5349-5bc9-bfa9-b8374c8015e9" :answer-field/key "$L$ is a subspace of ${R}^{2}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465160}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f3a8da8b-2b40-54c1-8d4a-0bb7a1d10698" :question/math-academy-id "q-156628" :question/problem "Let $L$ be the line with equation $x=5y$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}5y \\\\ y\\end{bmatrix},\\,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement “$L$ contains the zero-vector” is true. The coordinates of the zero-vector satisfy the equation $x=5y:$\n\n$$\n\\begin{aligned}x & =5y \\\\ (0) & =5(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement “$L$ is closed under vector addition” is true. Let, for example, $a=\\begin{bmatrix}5a \\\\ a\\end{bmatrix}\\in L$ and $b=\\begin{bmatrix}5b \\\\ b\\end{bmatrix}\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =\\begin{bmatrix}5a \\\\ a\\end{bmatrix}+\\begin{bmatrix}5b \\\\ b\\end{bmatrix}=\\begin{bmatrix}5a+5b \\\\ a+b\\end{bmatrix}=\\begin{bmatrix}5(a+b) \\\\ a+b\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $x=5y.$ Therefore, $a+b\\in L.$\n\n- Statement “$L$ is closed under scalar multiplication” is true. Let, for example, $a=\\begin{bmatrix}5a \\\\ a\\end{bmatrix}\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot \\begin{bmatrix}5a \\\\ a\\end{bmatrix}=\\begin{bmatrix}5ka \\\\ ka\\end{bmatrix},\\end{aligned}\n$$\n\nwhich satisfies the condition $x=5y.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement “$L$ is a subspace of ${R}^{2}$” is true. Since statements “$L$ is closed under vector addition” and “$L$ is closed under scalar multiplication” are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186275361 :question/answ