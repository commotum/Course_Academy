rrect {:answer/id #uuid "9301ffd4-9641-526c-8ebc-03ea6b20d8df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673216} :answer-field/id #uuid "79426dc1-d4e1-5869-bb3a-e61c0a7fc4d6" :answer-field/key "$\\text{rank}(A)\\ne 4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673210}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11e6dd5d-7bfa-519f-8ed0-b83419e1cc9b" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-4{x}_{1} \\\\ 0 \\\\ 0 \\\\ 3{x}_{1}\\end{bmatrix}\\mid {x}_{1}\\in\\mathbb{R}\\}?\n$$\n\nSelect all that apply." :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{4} \\\\ \\text{rank}(A)&=4 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}-4 \\\\ 0 \\\\ 0 \\\\ 3\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=1$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<4$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{4}$. In particular, $\\text{rank}(A)=3$ and $\\text{nullity}(A)=1$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{dim(Null}(A))=1$ is true. $\\text{nullity}(A)=1$.\n\n- Statement $A\\text{ is invertible}$ is false. $A$ is not invertible.\n\n- Statement $\\text{rank}(A)\\ne 4$ is true. $\\text{rank}(A)=3$; the rank counts pivot columns.\n\nTherefore, the correct answer is $\\text{dim(Null}(A))=1$; $\\text{rank}(A)\\ne 4$ only."}] [{:db/id #edb/ref 17592186673201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1def3aa4-ca90-5a60-ae81-18f879b8fddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673193} {:answer/id #uuid "8c642003-b71c-5b74-b74f-96717d49a20d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673215}] :answer-field/correct {:answer/id #uuid "1def3aa4-ca90-5a60-ae81-18f879b8fddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673193} :answer-field/id #uuid "65f2daf0-1c47-56c2-8a8a-84307ad4e944" :answer-field/key "$A\\text{ is invertible}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673207} {:answer-field/choices [{:answer/id #uuid "9d645105-5d62-523a-ba77-f3ae46379c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673220} {:answer/id #uuid "e7ce894c-68e9-5937-8695-76780148fcbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673231}] :answer-field/correct {:answer/id #uuid "9d645105-5d62-523a-ba77-f3ae46379c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673220} :answer-field/id #uuid "7a0a7474-22e8-5cb7-8b0e-968185248948" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673211} {:answer-field/choices [{:answer/id #uuid "93408f71-3d1f-5b6e-a833-cd6d34e0287a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673217} {:answer/id #uuid "ffde7463-aad8-597e-af48-aae2a8b41180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673235}] :answer-field/correct {:answer/id #uuid "ffde7463-aad8-597e-af48-aae2a8b41180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673235} :answer-field/id #uuid "89a52085-ad67-59e9-a740-a9f7fe03feee" :answer-field/key "$\\text{dim(Null}(A))=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673213} {:answer-field/choices [{:answer/id #uuid "95467dba-3781-541b-af8d-d761115470c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673218} {:answer/id #uuid "ce459033-934c-5e8f-9cc5-1373e4c9dc76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673227}] :answer-field/correct {:answer/id #uuid "ce459033-934c-5e8f-9cc5-1373e4c9dc76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673227} :answer-field/id #uuid "dca096b0-234a-53b0-8389-67623d2617b5" :answer-field/key "$\\text{Col}(A)\\ne {R}^{5}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673229}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "430a54b8-0a61-5fcc-ba8f-8099feede2af" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-2{x}_{1} \\\\ 2{x}_{1} \\\\ 4{x}_{2} \\\\ {x}_{2} \\\\ 0\\end{bmatrix}\\mid {x}_{1},{x}_{2}\\in\\mathbb{R}\\}?\n$$\n\nSelect all that apply." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{5} \\\\ \\text{rank}(A)&=5 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}-2 \\\\ 2 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix} + {x}_{2}\\begin{bmatrix}0 \\\\ 0 \\\\ 4 \\\\ 1 \\\\ 0\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=2$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<5$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{5}$. In particular, $\\text{rank}(A)=3$ and $\\text{nullity}(A)=2$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{dim(Null}(A))=5$ is false. $\\text{nullity}(A)=2$.\n\n- Statement $A\\text{ is invertible}$ is false. $A$ is not invertible.\n\n- Statement $\\text{Col}(A)\\ne {R}^{5}$ is true. $\\text{Col}(A)\\ne \\mathbb{R}^{5}$.\n\nTherefore, the correct answer is $\\text{Col}(A)\\ne {R}^{5}$ only."}] [{:db/id #edb/ref 17592186673204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d72e44-a033-5788-b049-8a451dbad1da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186673189} {:answer/id #uuid "1522bd23-2fc5-5e8e-81c9-c3ca0adfaab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186673191} {:answer/id #uuid "2bbf6eaf-1e5c-54f5-b3b7-442da6545e77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186673197} {:answer/id #uuid "37ae6200-8724-50c0-b709-2ecc0e3f8794" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186673200} {:answer/id #uuid "7226ecd6-8273-51ac-aea6-43a3c8e77024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186673209}] :answer-field/correct {:answer/id #uuid "37ae6200-8724-50c0-b709-2ecc0e3f8794" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186673200} :answer-field/id #uuid "a8de8536-0c81-5998-87eb-81d60e006561" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673222}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4d55ab29-1e9c-54fa-b4c5-045bb2cab9cc" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-4{x}_{2} \\\\ {x}_{2} \\\\ {x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}\\mid {x}_{1},{x}_{2}\\in\\mathbb{R}\\}?\n$$\n\nI. $\\text{dim(Null}(A))=2$\n\nII. $A\\text{ is not invertible}$\n\nIII. $\\text{Col}(A)={R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{4} \\\\ \\text{rank}(A)&=4 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 3\\end{bmatrix} + {x}_{2}\\begin{bmatrix}-4 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=2$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<4$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{4}$. In particular, $\\text{rank}(A)=2$ and $\\text{nullity}(A)=2$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true: $\\text{dim(Null}(A))=2$. $\\text{nullity}(A)=2$.\n\n- Statement II is true: $A\\text{ is not invertible}$. $A$ is not invertible.\n\n- Statement III is false: $\\text{Col}(A)={R}^{4}$. $\\text{Col}(A)\\ne \\mathbb{R}^{4}$.\n\nTherefore, the correct answer is I and II only."}] [{:db/id #edb/ref 17592186673226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290959aa-c9e0-552a-b454-bf5b41e57491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673196} {:answer/id #uuid "6d0b566c-e3b7-52ff-95cf-90860925fada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673208}] :answer-field/correct {:answer/id #uuid "6d0b566c-e3b7-52ff-95cf-90860925fada" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673208} :answer-field/id #uuid "1e751ad0-31b9-5191-b323-5b7b0e2bc46c" :answer-field/key "$A\\text{ is not invertible}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673194} {:answer-field/choices [{:answer/id #uuid "5b15f975-67ea-5476-8f03-c7f74f2dc017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673205} {:answer/id #uuid "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673214}] :answer-field/correct {:answer/id #uuid "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673214} :answer-field/id #uuid "460aa660-c8cb-5c14-a7a7-344c954cf7ea" :answer-field/key "$\\text{dim(Null}(A))=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673202} {:answer-field/choices [{:answer/id #uuid "475b0073-903b-5909-957b-c2bf958a0e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673203} {:answer/id #uuid "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673233}] :answer-field/correct {:answer/id #uuid "475b0073-903b-5909-957b-c2bf958a0e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673203} :answer-field/id #uuid "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/key "$\\text{rank}(A)=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186673206}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c254c2c5-fa4e-5e1f-9d05-d1929805dcd3" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-2{x}_{1} \\\\ 0 \\\\ -3{x}_{1} \\\\ 4{x}_{2}\\end{bmatrix}\\mid {x}_{1},{x}_{2}\\in\\mathbb{R}\\}?\n$$\n\nSelect all that apply." :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{4} \\\\ \\text{rank}(A)&=4 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}-2 \\\\ 0 \\\\ -3 \\\\ 0\\end{bmatrix} + {x}_{2}\\begin{bmatrix}0 \\\\ 0 \\\\ 0 \\\\ 4\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=2$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<4$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{4}$. In particular, $\\text{rank}(A)=2$ and $\\text{nullity}(A)=2$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{dim(Null}(A))=1$ is false. $\\text{nullity}(A)=2$.\n\n- Statement $A\\text{ is not invertible}$ is true. $A$ is not invertible.\n\n- Statement $\\text{rank}(A)=5$ is false. $\\text{rank}(A)=2$; the rank counts pivot columns.\n\nTherefore, the correct answer is $A\\text{ is not invertible}$ only."}] [{:db/id #edb/ref 17592186673230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ffd11b0-8235-5f25-9175-bc26be2367d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186673198} {:answer/id #uuid "9a07f16e-b808-5228-b981-8548b21f279e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186673219} {:answer/id #uuid "c1f98da1-d3b1-5d5c-ba1c-d1627336a904" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186673225} {:answer/id #uuid "e8fcdf25-49f6-5816-a304-cabb301b89ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186673232} {:answer/id #uuid "f15e8fed-707c-5062-8e6e-f4b9c86ecce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186673234}] :answer-field/correct {:answer/id #uuid "9a07f16e-b808-5228-b981-8548b21f279e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186673219} :answer-field/id #uuid "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673195}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e41f879e-5e60-5636-a17a-b03256796798" :question/problem "Which of the following statements are true, given that $A$ is a $7\\times 7$ matrix and $\\text{rank}(A)=7$?\n\nI. $A\\text{ is invertible}$\n\nII. $\\text{Col}(A)\\ne {R}^{7}$\n\nIII. $\\text{dim(Null}(A))=0$" :question/worked-solution "Since $A$ is a $7\\times 7$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{7} \\\\ \\text{rank}(A)&=7 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe given full rank implies that $A$ is invertible.\n\nWe have $\\text{rank}(A)=7$, $\\text{nullity}(A)=0$, $\\text{Null}(A)=\\{0\\}$, and $\\text{Col}(A)=\\mathbb{R}^{7}$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true: $A\\text{ is invertible}$. $A$ is invertible.\n\n- Statement II is false: $\\text{Col}(A)\\ne {R}^{7}$. $\\text{Col}(A)=\\mathbb{R}^{7}$.\n\n- Statement III is true: $\\text{dim(Null}(A))=0$. $\\text{nullity}(A)=0$.\n\nTherefore, the correct answer is I and III only."}]}
