  "before_edn": "{:db/id 17592186115228 :knowledge-point/canonical-example {:db/id 17592186115058 :question/id #uuid \"7ab158e6-4222-5cab-88a0-85ce74a7d4b2\" :question/math-academy-id \"e-4413\" :question/problem \"Given that $A, B,$ and $C$ are $6 \\\\times 6$ matrices, which of the following statements are always true?\\n\\nI. $A(BC) = (AB)C$\\n\\nII. $A(B+C) = BA+CA$\\n\\nIII. $A(B+C) = AB+AC$\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement I is true. Matrix multiplication is associative, so $(AB)C = A(BC)$ in general.\\n\\n- Statement II is false. Matrix multiplication is distributive, so $A(B+C) = AB + AC$ in general. However, since matrix multiplication is not commutative, we have\\n\\n$$\\nAB + AC  \\\\neq BA + CA.\\n$$\\n\\n- Statement III is true. Matrix multiplication is distributive, so $(A+B)C = AC+BC,$ and $A(B+C) = AB+AC$ in general.\\n\\nTherefore, only statements I and III are true.\"} :knowledge-point/id #uuid \"5a870c4a-daa5-5df2-8968-d8bf9ac0bd75\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186718022 :question-generator/id #uuid \"028d4c73-4c19-5dd0-ae44-f23203550450\" :question-generator/script \"generators/a5/a5e8abb80a6e583ae7f686c041fdaad493447a97ee3e7ceaa1d198abf31e6f4e/generator.py\"} :knowledge-point/questions [{:db/id 17592186115837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1067aa3d-2b51-5b1a-b638-8cd254e921c1\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448632} {:answer/id #uuid \"a3967aa3-4b50-5c5c-b5fe-aa477f5fe032\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448633}] :answer-field/correct {:answer/id #uuid \"1067aa3d-2b51-5b1a-b638-8cd254e921c1\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448632} :answer-field/id #uuid \"149d811f-1bfd-59da-848a-31d1c4100def\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449356} {:answer-field/choices [{:answer/id #uuid \"86075d40-0e3f-586b-9449-798158d86bca\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448634} {:answer/id #uuid \"1fec6718-135d-53ed-ace0-3373f23e193b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448635}] :answer-field/correct {:answer/id #uuid \"1fec6718-135d-53ed-ace0-3373f23e193b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448635} :answer-field/id #uuid \"2cdc4938-08ac-5768-9c3a-6cf1b96bf157\" :answer-field/key \"$(AB)C=A(BC)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449357} {:answer-field/choices [{:answer/id #uuid \"8546691d-f8b4-5754-96f8-903691eb5eb6\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448636} {:answer/id #uuid \"d2f078ae-15b0-55b8-85f1-fb559cdbab88\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448637}] :answer-field/correct {:answer/id #uuid \"d2f078ae-15b0-55b8-85f1-fb559cdbab88\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448637} :answer-field/id #uuid \"0bc3e7d1-fdc0-5ebf-9944-36f12a7d8eff\" :answer-field/key \"$AC+BC=(A+B)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449358}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"5e648555-87e2-52bf-ac70-24ae7f7d32c1\" :question/math-academy-id \"q-42265\" :question/problem \"Given that $A,B,$ and $C$ are $4\\\\times 4$ matrices, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $(AB)C=A(BC)$ is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\\n\\n- Statement $AC+BC=(A+B)C$ is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\\n\\nTherefore, only statements $(AB)C=A(BC)$ and $AC+BC=(A+B)C$ are true.\"} {:db/id 17592186115838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"84adee91-f9b3-5089-890e-41b5e257813d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448638} {:answer/id #uuid \"e2e31c4f-b7bd-5276-a991-deb172fd1702\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448639}] :answer-field/correct {:answer/id #uuid \"e2e31c4f-b7bd-5276-a991-deb172fd1702\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448639} :answer-field/id #uuid \"5d1bd3d1-8fdb-5689-a908-f1bc0ac9ac01\" :answer-field/key \"$(A+B)C=AC+BC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449359} {:answer-field/choices [{:answer/id #uuid \"1670a685-9e94-5937-8cfd-7d0d29af6eb0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448640} {:answer/id #uuid \"16ec1bf8-e36a-5bfb-84bd-a4334c07e464\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448641}] :answer-field/correct {:answer/id #uuid \"1670a685-9e94-5937-8cfd-7d0d29af6eb0\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448640} :answer-field/id #uuid \"64b55508-2a98-5d52-9e53-d6536bd357ec\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449360} {:answer-field/choices [{:answer/id #uuid \"113b4e99-4e5b-55aa-a4da-2a14a868af02\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448642} {:answer/id #uuid \"056450c3-2bbe-583e-950a-5fcae4730b42\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448643}] :answer-field/correct {:answer/id #uuid \"113b4e99-4e5b-55aa-a4da-2a14a868af02\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448642} :answer-field/id #uuid \"96d5b3ee-a8ea-534b-8e66-6ca762d54d43\" :answer-field/key \"$A(BC)=(BA)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449361}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"174631dd-f119-50e8-bf7b-ac669b330d64\" :question/math-academy-id \"q-42266\" :question/problem \"Given that $A,B,$ and $C$ are $6\\\\times 6$ matrices, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $(A+B)C=AC+BC$ is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $A(BC)=(BA)C$ is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\\n\\n$$\\n\\\\begin{aligned}A(BC) &=(AB)C\\\\ne (BA)C.\\\\end{aligned}\\n$$\\n\\nTherefore, only statement $(A+B)C=AC+BC$ is true.\"} {:db/id 17592186265906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5721fddb-4ddb-5ceb-8d53-beb5879aabb4\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448386} {:answer/id #uuid \"94b7a979-8ec2-54e2-90a3-0c1ddb63d731\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448387}] :answer-field/correct {:answer/id #uuid \"94b7a979-8ec2-54e2-90a3-0c1ddb63d731\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448387} :answer-field/id #uuid \"808c3874-e879-50ff-9b4f-7080ca2b02ad\" :answer-field/key \"${A}^{2}B=A(AB)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449233} {:answer-field/choices [{:answer/id #uuid \"2f74fb5a-177b-5835-b20e-ce0567027248\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448388} {:answer/id #uuid \"06d94795-ebf6-5369-a12b-dbfa3c0bde79\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448389}] :answer-field/correct {:answer/id #uuid \"2f74fb5a-177b-5835-b20e-ce0567027248\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448388} :answer-field/id #uuid \"7bc69198-ea95-5680-86fb-59feb160bb36\" :answer-field/key \"$A(B-C)=AB-CA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449234} {:answer-field/choices [{:answer/id #uuid \"f629e2cf-0d6b-5ebd-ba20-35e8b11008d8\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448390} {:answer/id #uuid \"3ab0f40e-90eb-52f5-8bf5-16588c5aca46\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186448391}] :answer-field/correct {:answer/id #uuid \"f629e2cf-0d6b-5ebd-ba20-35e8b11008d8\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186448390} :answer-field/id #uuid \"ac7d9849-da3b-534a-83ba-7cddee8c3884\" :answer-field/key \"$B(CA)=(CB)A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186449235}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8250ce52-a1e9-536b-9512-ee968aac3cef\" :question/math-academy-id \"q-130446\" :question/problem \"Given that $A,B,$ and $C$ are $4\\\\times 4$ matrices which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement ${A}^{2}B=A(AB)$ is true. Matrix multiplication is associative and  ${A}^{2}B=AAB=A(AB)$ is always true.\\n\\n- Statement $A(B-C)=AB-CA$ is false.  Matrix multiplication is distributive and  $A(B-C)=AB-AC.$ However, matrix multiplication is not commutative, so $AC\\\\ne CA$ in general and therefore $A(B-C)\\\\ne AB-CA$, in general.\\n\\n- Statement $B(CA)=(CB)A$ is false. Matrix multiplication is associative and  $B(CA)=(BC)A.$ However, matrix multiplication is not commutative, so $BC\\\\ne CB$ in general and therefore $B(CA)\\\\ne (CB)A$, in general.\\n\\nTherefore, only statement  ${A}^{2}B=A(AB)$ is true.\"} {:db/id 17592186265907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"420d6cc9-8195-5ce4-9357-adff9f06e789\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449472} {:answer/id #uuid \"dfaff5dd-3001-57cc-a214-27e4b2f13a0b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449473}] :answer-field/correct {:answer/id #uuid \"dfaff5dd-3001-57cc-a214-27e4b2f13a0b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449473} :answer-field/id #uuid \"e83edd0f-1ee5-57a0-b8f2-861740202905\" :answer-field/key \"$AB=A{I}_{3}B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450690} {:answer-field/choices [{:answer/id #uuid \"8a96d375-e3c1-5d42-b10d-88fedd420645\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449474} {:answer/id #uuid \"f9d1552b-b0c1-5914-8616-b9aa0f71d996\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449475}] :answer-field/correct {:answer/id #uuid \"8a96d375-e3c1-5d42-b10d-88fedd420645\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449474} :answer-field/id #uuid \"0e5d71a8-1832-50ab-a267-82a5ea4c6510\" :answer-field/key \"$A(B+{I}_{3})=AB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450691} {:answer-field/choices [{:answer/id #uuid \"4fd4a080-8694-528b-99c0-94bb7afe0160\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449476} {:answer/id #uuid \"b70ca1e9-55e1-5e83-8b86-ac7385727b87\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449477}] :answer-field/correct {:answer/id #uuid \"b70ca1e9-55e1-5e83-8b86-ac7385727b87\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449477} :answer-field/id #uuid \"43485488-f54f-56dd-98bd-bbf9a37fb3ae\" :answer-field/key \"${I}_{3}A=A{I}_{3}$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450692}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9a216ad8-b070-56d6-a23a-d32e7322b41f\" :question/math-academy-id \"q-130449\" :question/problem \"Given that $A,B,$ and $C$ are $3\\\\times 3$ matrices, and  ${I}_{3}$ is the $3\\\\times 3$ identity matrix, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $AB=A{I}_{3}B$ is true. Matrix multiplication is associative, so $A{I}_{3}B=(A{I}_{3})B=AB.$\\n\\n- Statement $A(B+{I}_{3})=AB$ is false. Matrix multiplication is distributive, so $A(B+{I}_{3})=AB+A{I}_{3}=AB+A.$ However,  $AB+A\\\\ne AB,$ in general.\\n\\n- Statement ${I}_{3}A=A{I}_{3}$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  ${I}_{3}A=A{I}_{3}.$\\n\\nTherefore, only statements $AB=A{I}_{3}B$ and ${I}_{3}A=A{I}_{3}$ are true.\"} {:db/id 17592186265909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e7957644-0d34-5355-b4aa-6843421f4cb6\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449478} {:answer/id #uuid \"ccfd816a-e282-554a-bc11-458d1326d8d5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449479}] :answer-field/correct {:answer/id #uuid \"ccfd816a-e282-554a-bc11-458d1326d8d5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449479} :answer-field/id #uuid \"6fcf8fbd-79c9-5a3f-9c93-3269eb1a6b18\" :answer-field/key \"$A(BC)=(AB)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450693} {:answer-field/choices [{:answer/id #uuid \"5609b0ad-b55f-5942-bbdd-8d585ee962ad\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449480} {:answer/id #uuid \"8db8304a-b1d0-5052-b18c-e9bb08899b11\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449481}] :answer-field/correct {:answer/id #uuid \"5609b0ad-b55f-5942-bbdd-8d585ee962ad\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449480} :answer-field/id #uuid \"63b9348d-3f50-5361-9ba1-8262be95c0a0\" :answer-field/key \"$A(B-C)=AB-CA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450694} {:answer-field/choices [{:answer/id #uuid \"c5099a79-f035-55b7-a74f-976fa8b79237\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449482} {:answer/id #uuid \"96ca6167-ad12-543c-a1c9-e7474101a124\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449483}] :answer-field/correct {:answer/id #uuid \"c5099a79-f035-55b7-a74f-976fa8b79237\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449482} :answer-field/id #uuid \"fcd08e90-18cc-5f16-8ac5-f89ed5e9b611\" :answer-field/key \"$CA=AC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450695}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"da216097-76ab-5a2e-b3ad-662534506edb\" :question/math-academy-id \"q-130455\" :question/problem \"Given that $A,B,$ and $C$ are $6\\\\times 6$ matrices which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $A(BC)=(AB)C$ is true. Matrix multiplication is associative and  $A(BC)=(AB)C$ is always true.\\n\\n- Statement $A(B-C)=AB-CA$ is false. Matrix multiplication is distributive, so $A(B-C)=AB-AC,$ but $AC\\\\ne CA$ because matrix multiplication is not commutative in general.\\n\\n- Statement $CA=AC$  is false. Matrix multiplication is not commutative, so $CA\\\\ne AC$ in general.\\n\\nTherefore, only statement  $A(BC)=(AB)C$ is true.\"} {:db/id 17592186265913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e3e23a78-9cff-5f4f-b321-68256103a287\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449484} {:answer/id #uuid \"fc24f783-305e-584a-96dc-56e90c7199d3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449485}] :answer-field/correct {:answer/id #uuid \"fc24f783-305e-584a-96dc-56e90c7199d3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449485} :answer-field/id #uuid \"599aa420-34d9-5e48-96d9-1fff3725e551\" :answer-field/key \"$A{I}_{8}={I}_{8}A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450696} {:answer-field/choices [{:answer/id #uuid \"1cd393f3-55f2-599a-aa0a-d18ad1ef34f4\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449486} {:answer/id #uuid \"1566549e-0426-589d-92ea-3d623677f3b5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449487}] :answer-field/correct {:answer/id #uuid \"1cd393f3-55f2-599a-aa0a-d18ad1ef34f4\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449486} :answer-field/id #uuid \"d184eea5-c9c5-5b93-8586-c6e75fec6d77\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450697} {:answer-field/choices [{:answer/id #uuid \"a7fff099-59fc-5bf2-850f-508b365824eb\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449488} {:answer/id #uuid \"c4b157f5-5880-5d42-b0af-3314832fb23c\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449489}] :answer-field/correct {:answer/id #uuid \"c4b157f5-5880-5d42-b0af-3314832fb23c\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449489} :answer-field/id #uuid \"c228a2f4-4fa2-5cb5-ad55-1810d368d693\" :answer-field/key \"$A\\\\cdot 2{I}_{8}=2A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450698}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c886d4f7-2a2b-5730-a24b-3976b9e31d35\" :question/math-academy-id \"q-130463\" :question/problem \"Given that $A$ and $B$  are $8\\\\times 8$ matrices,  and ${I}_{8}$ is the $8\\\\times 8$ identity matrix,  which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $A{I}_{8}={I}_{8}A$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{8}={I}_{8}A=A.$\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $A\\\\cdot 2{I}_{8}=2A$ is true. Matrix multiplication is distributive, so \\n\\n$$\\n\\\\begin{aligned}A\\\\cdot 2{I}_{8} & =A({I}_{8}+{I}_{8}) \\\\\\\\  & =A{I}_{8}+A{I}_{8} \\\\\\\\  & =A+A \\\\\\\\  & =2A.\\\\end{aligned}\\n$$\\n\\nTherefore, only statements $A{I}_{8}={I}_{8}A$  and $A\\\\cdot 2{I}_{8}=2A$ are true.\"} {:db/id 17592186265914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7f505436-de5e-5e74-9c16-db47f9d3dde8\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449490} {:answer/id #uuid \"55ad8fd2-983a-52f3-adb4-1610dbb1063d\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449491}] :answer-field/correct {:answer/id #uuid \"7f505436-de5e-5e74-9c16-db47f9d3dde8\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449490} :answer-field/id #uuid \"61886434-6b69-5a05-bc4e-5fe067d4aadb\" :answer-field/key \"$(CA)B=C(BA)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450699} {:answer-field/choices [{:answer/id #uuid \"20e4cb8a-161c-5b37-8171-e110c0ccabdc\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449492} {:answer/id #uuid \"c53c0d38-c0d6-534c-98d5-3e8b2cf7c4e5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449493}] :answer-field/correct {:answer/id #uuid \"c53c0d38-c0d6-534c-98d5-3e8b2cf7c4e5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449493} :answer-field/id #uuid \"6517376b-dc67-5612-af55-6316cd92e350\" :answer-field/key \"$(A+A)B=2AB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450700} {:answer-field/choices [{:answer/id #uuid \"45243252-dbf8-5dba-81eb-702f3231cb73\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449494} {:answer/id #uuid \"5489dffc-c13b-505b-b7ba-aa63f4669cd4\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186449495}] :answer-field/correct {:answer/id #uuid \"45243252-dbf8-5dba-81eb-702f3231cb73\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186449494} :answer-field/id #uuid \"bd0867ba-7318-50a7-adfb-0f8ddb112341\" :answer-field/key \"$CB=BC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186450701}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ca328f5c-fde3-5a0e-88ed-9bc8ff6b0334\" :question/math-academy-id \"q-130478\" :question/problem \"Given that $A,B,$ and $C$ are $7\\\\times 7$ matrices which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $(CA)B=C(BA)$  is false. Matrix multiplication is associative and  $(CA)B=C(AB)$ is always true. However,  matrix multiplication is not commutative,   $AB\\\\ne BA$ in general. Therefore, $(CA)B\\\\ne C(BA)$ in general.\\n\\n- Statement $(A+A)B=2AB$ is true. Matrix multiplication is distributive, so $(A+A)B=AB+AB=2AB$ is always true.\\n\\n- Statement $CB=BC$ is false. Matrix multiplication is not commutative in general, so $CB\\\\ne BC$ in general.\\n\\nTherefore, only statement $(A+A)B=2AB$ is true.\"} {:db/id 17592186329640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"98d094e2-1177-5e99-96ad-7caeee897640\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450618} {:answer/id #uuid \"ca99c815-da6d-51d7-a07d-611d7659f788\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450619}] :answer-field/correct {:answer/id #uuid \"98d094e2-1177-5e99-96ad-7caeee897640\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450618} :answer-field/id #uuid \"c30fd7ce-bd14-59fb-ab10-845f8a59bb92\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451263} {:answer-field/choices [{:answer/id #uuid \"956b7a25-6517-5ef2-837c-39c50a5c5a32\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450620} {:answer/id #uuid \"bd63bdd4-4b06-56ad-b67b-a613cc1dd46f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450621}] :answer-field/correct {:answer/id #uuid \"bd63bdd4-4b06-56ad-b67b-a613cc1dd46f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450621} :answer-field/id #uuid \"382ec9ba-1720-5328-8c38-f194ab93dcab\" :answer-field/key \"$(AB)C=A(BC)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451264} {:answer-field/choices [{:answer/id #uuid \"762ad639-2afc-55e3-bdc7-be4e7057c714\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450622} {:answer/id #uuid \"7a78eef3-ff9c-56b5-98cb-545a4b324d66\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450623}] :answer-field/correct {:answer/id #uuid \"762ad639-2afc-55e3-bdc7-be4e7057c714\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450622} :answer-field/id #uuid \"800a3551-29f1-5bb8-a3bc-66ca201c01c9\" :answer-field/key \"$A(B-C)=(B-C)A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451265}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"005a0156-3d99-59d1-ab99-adf9b9b4c7b4\" :question/math-academy-id \"q-42264\" :question/problem \"Given that $A,B,$ and $C$ are $2\\\\times 2$ matrices, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $(AB)C=A(BC)$ is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\\n\\n- Statement $A(B-C)=(B-C)A$ is false. Matrix multiplication is not commutative, so $A(B-C)\\\\ne (B-C)A$ in general.\\n\\nTherefore, only statement $(AB)C=A(BC)$ is true.\"} {:db/id 17592186329641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450624} {:answer/id #uuid \"55e4960c-b4a8-5dc4-9358-5474cf82f7c1\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450625}] :answer-field/correct {:answer/id #uuid \"0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450624} :answer-field/id #uuid \"3d5404b0-68d0-5679-9acd-82c4cfdc5828\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451266} {:answer-field/choices [{:answer/id #uuid \"a7725433-91f4-58a8-86f9-aeb838dcca83\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450626} {:answer/id #uuid \"db204d99-d48d-5b15-a94d-fd45955b1ffa\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450627}] :answer-field/correct {:answer/id #uuid \"db204d99-d48d-5b15-a94d-fd45955b1ffa\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450627} :answer-field/id #uuid \"36d78dc9-a409-525c-846b-1acf74456b6c\" :answer-field/key \"$A(B+C)=AB+AC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451267} {:answer-field/choices [{:answer/id #uuid \"6be3f3c0-0d5f-53d8-b5d4-1cdbc4330e3f\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186450628} {:answer/id #uuid \"32dd403d-28b4-5b42-93d6-1c1a8a1630d3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450629}] :answer-field/correct {:answer/id #uuid \"32dd403d-28b4-5b42-93d6-1c1a8a1630d3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186450629} :answer-field/id #uuid \"baab8b40-76af-5c21-b0d3-f31812f8c1dd\" :answer-field/key \"$B{I}_{5}={I}_{5}B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186451268}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"cea2f24d-948b-5d70-91c6-23df57186795\" :question/math-academy-id \"q-42267\" :question/problem \"Given that $A,B,$ and $C$ are $5\\\\times 5$ matrices, and  ${I}_{5}$ is the $5\\\\times 5$ identity matrix, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $A(B+C)=AB+AC$ is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\\n\\n- Statement $B{I}_{5}={I}_{5}B$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $B{I}_{5}={I}_{5}B=B.$\\n\\nTherefore, only statements $A(B+C)=AB+AC$ and $B{I}_{5}={I}_{5}B$ are true.\"} {:db/id 17592186345115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a5b4b6c9-b120-5669-8778-9d44bd03a705\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451627} {:answer/id #uuid \"5c9ff174-54f1-5fc0-82c9-56c7f68be83b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451628}] :answer-field/correct {:answer/id #uuid \"5c9ff174-54f1-5fc0-82c9-56c7f68be83b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451628} :answer-field/id #uuid \"c6596886-eb35-5a15-8678-0d03898ac57c\" :answer-field/key \"$A(B+C)=AC+AB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452661} {:answer-field/choices [{:answer/id #uuid \"6b1b7dcd-0a45-5a31-b1e7-359ba6b8ce48\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451629} {:answer/id #uuid \"2844641e-66b1-56cc-8371-e36f6a1b3ff0\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451630}] :answer-field/correct {:answer/id #uuid \"6b1b7dcd-0a45-5a31-b1e7-359ba6b8ce48\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451629} :answer-field/id #uuid \"648f05bf-a002-5add-8c9a-e67860f117ba\" :answer-field/key \"$A(BC)=(BA)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452662} {:answer-field/choices [{:answer/id #uuid \"aec13ecc-22bc-5436-b215-dddd0d181f9e\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451631} {:answer/id #uuid \"ddfc103f-6039-5ed8-b224-6f15716dcaa5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451632}] :answer-field/correct {:answer/id #uuid \"aec13ecc-22bc-5436-b215-dddd0d181f9e\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451631} :answer-field/id #uuid \"5ce1dbe9-397b-565f-a4c9-e832cb32d032\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452663}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1c88851c-8567-55d2-897e-8b0f9b020c35\" :question/math-academy-id \"q-75662\" :question/problem \"Given that $A,B,$ and $C$ are $7\\\\times 7$ matrices, which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $A(B+C)=AC+AB$ is true. Matrix multiplication is distributive, so \\n\\n$$\\nA(B+C)=AB+AC=AC+AB\\n$$\\n\\n since matrix addition is commutative.\\n\\n- Statement $A(BC)=(BA)C$ is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\\n\\n$$\\n\\\\begin{aligned}A(BC) &=(AB)C\\\\ne (BA)C.\\\\end{aligned}\\n$$\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\nTherefore, only statement $A(B+C)=AC+AB$ is true.\"} {:db/id 17592186345116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3fd2d4af-fcc8-55b6-bf9b-9feed35a4e39\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451633} {:answer/id #uuid \"8c44c3d1-8408-5b27-9d56-5820850d8e6f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451634}] :answer-field/correct {:answer/id #uuid \"3fd2d4af-fcc8-55b6-bf9b-9feed35a4e39\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451633} :answer-field/id #uuid \"875098b9-5492-5e1a-b53e-55972f8d78c0\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452664} {:answer-field/choices [{:answer/id #uuid \"2c09b308-44c0-5d82-b117-e79d490fc908\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451635} {:answer/id #uuid \"e5ea9fe4-7d06-5ee2-81e0-6e343876dfb5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451636}] :answer-field/correct {:answer/id #uuid \"e5ea9fe4-7d06-5ee2-81e0-6e343876dfb5\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451636} :answer-field/id #uuid \"f365105a-7265-5164-bb84-ae009541d7d4\" :answer-field/key \"$A{I}_{4}={I}_{4}A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452665} {:answer-field/choices [{:answer/id #uuid \"086cedd9-2c5d-5cf5-8342-fff602804217\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451637} {:answer/id #uuid \"d576ec60-2dbd-5562-90ac-ff700e520b13\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451638}] :answer-field/correct {:answer/id #uuid \"d576ec60-2dbd-5562-90ac-ff700e520b13\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451638} :answer-field/id #uuid \"8bf272d3-96d9-5e52-bf3a-2077d76af75c\" :answer-field/key \"$A(B+{I}_{4})=AB+A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452666}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8619c3de-3523-5f87-a248-dac65df502b6\" :question/math-academy-id \"q-75664\" :question/problem \"Given that $A$ and $B$  are $4\\\\times 4$ matrices,  and ${I}_{4}$ is the $4\\\\times 4$ identity matrix,  which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $A{I}_{4}={I}_{4}A$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{4}={I}_{4}A=A.$\\n\\n- Statement $A(B+{I}_{4})=AB+A$ is true. Matrix multiplication is distributive, so $A(B+{I}_{4})=AB+A{I}_{4}=AB+A$ in general.\\n\\nTherefore, only statements $A{I}_{4}={I}_{4}A$  and $A(B+{I}_{4})=AB+A$ are true.\"} {:db/id 17592186345117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d29adab0-49f5-5be8-9dfb-41b652b9f78b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451639} {:answer/id #uuid \"aae53705-b1e7-5ad4-a458-fc12bd5715e8\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451640}] :answer-field/correct {:answer/id #uuid \"d29adab0-49f5-5be8-9dfb-41b652b9f78b\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451639} :answer-field/id #uuid \"4ec2f6a3-b7c4-5dbf-b313-e1460364d497\" :answer-field/key \"$CB=BC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452667} {:answer-field/choices [{:answer/id #uuid \"163312b5-47ae-51a4-8302-780627f27eaf\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451641} {:answer/id #uuid \"8391eb9d-de48-5257-958c-71e626ee3926\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451642}] :answer-field/correct {:answer/id #uuid \"163312b5-47ae-51a4-8302-780627f27eaf\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451641} :answer-field/id #uuid \"7e9e4ab6-972e-5a28-8a06-204e593f15c3\" :answer-field/key \"$A(B-C)=AB-CA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452668} {:answer-field/choices [{:answer/id #uuid \"5abcda23-f4db-5653-8749-2127e4eb2cc5\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186451643} {:answer/id #uuid \"83789ace-8be4-5fa7-bb78-667b324a5f43\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451644}] :answer-field/correct {:answer/id #uuid \"83789ace-8be4-5fa7-bb78-667b324a5f43\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186451644} :answer-field/id #uuid \"ebdef35b-4dc7-5168-954f-85f588629353\" :answer-field/key \"$A(BC)=(AB)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186452669}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8ca7b9cd-e052-55a9-b9b9-9f438a40909d\" :question/math-academy-id \"q-75717\" :question/problem \"Given that $A,B,$ and $C$ are $6\\\\times 6$ matrices which of the following statements are always true?\\n\\nSelect all that apply.\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement $CB=BC$ is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement $A(B-C)=AB-CA$ is false. Matrix multiplication is distributive, so $A(B-C)=AB-AC,$ but $AC\\\\ne CA$ because matrix multiplication is not commutative in general.\\n\\n- Statement $A(BC)=(AB)C$ is true. Matrix multiplication is associative and  $A(BC)=(AB)C$ is always true.\\n\\nTherefore, only statement  $A(BC)=(AB)C$ is true.\"} {:db/id 17592186485559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0baea8e6-67f2-5e1f-8d1f-49751d15a460\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186484839} {:answer/id #uuid \"150d4133-0a25-50d9-a5b6-3426cedc7ceb\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186484857} {:answer/id #uuid \"b6bd451c-1d47-509f-8a91-0bb7d9a2e039\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186485211} {:answer/id #uuid \"b779c7a3-5d4b-56ea-9ee5-63a3e5e72954\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186485212} {:answer/id #uuid \"d6de882f-5289-5eb0-83ae-5e40d163532c\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186485268}] :answer-field/correct {:answer/id #uuid \"0baea8e6-67f2-5e1f-8d1f-49751d15a460\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186484839} :answer-field/id #uuid \"72242043-aa0f-565d-a557-78a4b73b318a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186485413}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"96d290b8-46cc-5702-9916-bb75bce9f305\" :question/math-academy-id \"q-75663\" :question/problem \"Given that $A,B,$ and $C$ are $4\\\\times 4$ matrices, and ${I}_{4}$ is the $4\\\\times 4$ identity matrix,  which of the following statements are always true?\\n\\nI. $A{I}_{4}={I}_{4}A$\\n\\nII. $(CA)B=C(AB)$\\n\\nIII. $BC=CB$\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement I is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{4}={I}_{4}A=A.$\\n\\n- Statement II is true. Matrix multiplication is asociative, so $(CA)B=C(AB)$ in general.\\n\\n- Statement III is false. Matrix multiplication is not commutative, so $BC\\\\ne CB$ in general.\\n\\nTherefore, only statements I  and II are true.\"} {:db/id 17592186629288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"242e8c6c-5ef6-5530-b221-67b1724cb924\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186628771} {:answer/id #uuid \"467beaa2-f789-5f60-9ede-95bff4fd79a2\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186628834} {:answer/id #uuid \"63fa0419-3548-5eb3-a74f-0c8ec26478d7\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186628877} {:answer/id #uuid \"83287c90-7f72-5277-9910-eef08a8e9f0a\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186628929} {:answer/id #uuid \"c84f9faa-27b0-5feb-b898-8ee328b2817d\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186629046}] :answer-field/correct {:answer/id #uuid \"63fa0419-3548-5eb3-a74f-0c8ec26478d7\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186628877} :answer-field/id #uuid \"ead74683-8b8c-5101-b102-d3a41b2c166a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186629241}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4f54e4e8-85c8-5be4-a909-f55503250f4b\" :question/math-academy-id \"q-75661\" :question/problem \"Given that $A,B,$ and $C$ are $4\\\\times 4$ matrices, which of the following statements are always true?\\n\\nI. $A(B-C)=AB-AC$\\n\\nII. $AB=BA$\\n\\nIII. $(AC)B=A(CB)$\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement I is true. Matrix multiplication is distributive, so \\n\\n$$\\nA(B-C)=A(B+(-C))=AB+A(-C)=AB-AC.\\n$$\\n\\n- Statement II is false. Matrix multiplication is not commutative, so $AB\\\\ne BA$ in general.\\n\\n- Statement III is true. Matrix multiplication is associative, so $(AC)B=A(CB)$  in general.\\n\\nTherefore, only statements I and III are true.\"} {:db/id 17592186629328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6b1a2fe9-8acf-5209-842f-457138328f72\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186628887} {:answer/id #uuid \"8c1e400d-a09e-534a-8be6-6acd27c855a4\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186628943} {:answer/id #uuid \"d3b88920-7f6b-5e51-888f-cac24d60b9f1\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186629057} {:answer/id #uuid \"dc8ff2a5-5409-58c7-acbc-0f1147fc82a9\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186629080} {:answer/id #uuid \"f4a24263-6bb0-5a83-870a-7f39ca73dc7a\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186629116}] :answer-field/correct {:answer/id #uuid \"d3b88920-7f6b-5e51-888f-cac24d60b9f1\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186629057} :answer-field/id #uuid \"eb48ebea-5c12-5e74-899a-177996703a8f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186629242}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"b81a7dc6-23a0-5a37-be19-b0f5da8ca9f3\" :question/math-academy-id \"q-130453\" :question/problem \"Given that $A,B,$ and $C$ are $5\\\\times 5$ matrices which of the following statements are always true? \\n\\nI. $A(B-C)=A(C-B)$\\n\\nII. $A(CB)=(AC)B$\\n\\nIII. $A{B}^{2}=(AB)B$\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement I is false.  Matrix multiplication is distributive, so   $A(B-C)=AB-AC$ and $A(C-B)=AC-BC.$ However,  $AB-AC\\\\ne AC-AB,$ in general. Therefore $A(B-C)\\\\ne A(C-B)$, in general.\\n\\n- Statement II is true. Matrix multiplication is associative and  $A(CB)=(AC)B$ is always true.\\n\\n- Statement III is true. Matrix multiplication is associative and  $A{B}^{2}=A(BB)=(AB)B$ is always true.\\n\\nTherefore, only statements II and III are true.\"} {:db/id 17592186629329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"171a931e-aa04-55a2-9b28-d2a04fa7aa2a\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186628743} {:answer/id #uuid \"20b3cab3-4542-5819-9cb5-a89999e8e2b4\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186628760} {:answer/id #uuid \"8cc81170-862e-596c-8360-8088ce74703d\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186628945} {:answer/id #uuid \"b88450ba-c795-50bd-9557-1eb37f71f7a2\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186629017} {:answer/id #uuid \"d499a780-bd64-57b9-9d55-d65085448926\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186629060}] :answer-field/correct {:answer/id #uuid \"d499a780-bd64-57b9-9d55-d65085448926\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186629060} :answer-field/id #uuid \"35dfb0dc-3fc5-50e8-b885-b8e8e3bdf2f7\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186629160}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"baa88cfe-429c-543d-bba8-a1f699b6bda3\" :question/math-academy-id \"q-75718\" :question/problem \"Given that $A,B,$ and $C$ are $6\\\\times 6$ matrices which of the following statements are always true? \\n\\nI. $BCB=B(BC)$\\n\\nII. $A(B-C)=AB-AC$\\n\\nIII. $C(BA)=(CB)A$\" :question/worked-solution \"Let's consider the statements one by one.\\n\\n- Statement I is false.  Matrix multiplication is associative and  $BCB=B(CB).$ However, matrix multiplication is not commutative, so $CB\\\\ne BC$ in general and therefore $BCB\\\\ne B(BC)$, in general.\\n\\n- Statement II is true. Matrix multiplication is distributive, so $A(B-C)=AB-AC.$\\n\\n- Statement III is true. Matrix multiplication is associative and  $C(BA)=(CB)A$ is always true.\\n\\nTherefore, only statements  II and III are true.\"} {:db/id 17592186717586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7106c1e4-8d04-5f6c-a405-2de143a15b40\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717589} {:answer/id #uuid \"9203803e-065a-5b75-bfe7-93f49747c193\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717596}] :answer-field/correct {:answer/id #uuid \"9203803e-065a-5b75-bfe7-93f49747c193\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717596} :answer-field/id #uuid \"89ce90cd-f561-5d55-af33-452e439f4ca2\" :answer-field/key \"$AI_2=A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717595} {:answer-field/choices [{:answer/id #uuid \"b8f73c65-a7d4-5ebe-a0eb-b10f1326a354\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717602} {:answer/id #uuid \"d92c11e8-e597-56f0-b6b8-eeb8673285d4\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717612}] :answer-field/correct {:answer/id #uuid \"b8f73c65-a7d4-5ebe-a0eb-b10f1326a354\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717602} :answer-field/id #uuid \"b4b838a6-e6be-5576-a374-82a287d3e5d6\" :answer-field/key \"$(AB)C=A(BC)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717601} {:answer-field/choices [{:answer/id #uuid \"19ef1e14-61d5-559e-a4bf-8cf463667d99\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717584} {:answer/id #uuid \"5612b755-4449-5e31-9256-e572b6365a1e\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717588}] :answer-field/correct {:answer/id #uuid \"19ef1e14-61d5-559e-a4bf-8cf463667d99\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717584} :answer-field/id #uuid \"c1f7e875-5670-57fc-9f8a-8609475d0156\" :answer-field/key \"$AB=BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717606}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2199c6f3-6278-50c2-b04a-7b10b34704c8\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $AI_2=A$ is always true: multiplying by the identity leaves a matrix unchanged.\\n\\n- $AB=BA$ is not always true: matrix multiplication need not be commutative. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\qquad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen $AB=B$ but $BA=\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so $AB\\\\ne BA$ for these matrices.\\n\\n- $(AB)C=A(BC)$ is always true by associativity. Both sides multiply the factors in the order $A$, then $B$, then $C$; only the parentheses move.\\n\\nSelect $AI_2=A$ and $(AB)C=A(BC)$.\"} {:db/id 17592186717587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"733b808c-675b-5e2b-a3ee-24da5e9a58cb\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717590} {:answer/id #uuid \"aa609def-1cc1-596c-8648-ba88856b2480\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717599}] :answer-field/correct {:answer/id #uuid \"733b808c-675b-5e2b-a3ee-24da5e9a58cb\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717590} :answer-field/id #uuid \"7fa2b485-160c-5621-8b1a-29ddff1bd68b\" :answer-field/key \"$A^2B=A(AB)$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717592} {:answer-field/choices [{:answer/id #uuid \"1de34152-0b49-52f2-bf06-e7c9dfd81d3c\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717585} {:answer/id #uuid \"d4eb6431-1d6c-5a02-899d-3a9a402ad711\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717611}] :answer-field/correct {:answer/id #uuid \"d4eb6431-1d6c-5a02-899d-3a9a402ad711\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717611} :answer-field/id #uuid \"ad9b44ca-f248-5259-81ad-956a48a82eca\" :answer-field/key \"$B(CA)=(CB)A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717600} {:answer-field/choices [{:answer/id #uuid \"c8c819f3-9290-523e-9e26-ac11710b81e4\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717607} {:answer/id #uuid \"d42b4613-6fde-5c38-a730-aedc8f0bf667\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717610}] :answer-field/correct {:answer/id #uuid \"d42b4613-6fde-5c38-a730-aedc8f0bf667\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717610} :answer-field/id #uuid \"bf040830-8fe5-5862-bd99-dfc249348c18\" :answer-field/key \"$A(B+C)=AC+AB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717603}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3df55019-db64-5397-8b0d-ef7ef56fd417\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $B(CA)=(CB)A$ is not always true. Associativity gives $B(CA)=(BC)A$, keeping the order $B,C,A$. The proposed right side has order $C,B,A$, so it swaps factors. For example, take\\n\\n$$\\nA=I_2,\\\\qquad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\qquad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen $B(CA)=C$, whereas $(CB)A=0$.\\n\\n- $A(B+C)=AC+AB$ is always true. First distribute, preserving the order within each product; then interchange the two terms of the sum:\\n\\n$$\\nA(B+C)=AB+AC=AC+AB.\\n$$\\n\\nMatrix addition is commutative even though matrix multiplication is not commutative in general. No factors inside $AB$ or $AC$ have been swapped.\\n\\n- $A^2B=A(AB)$ is always true. Expand the square as a repeated product and use associativity:\\n\\n$$\\nA^2B=(AA)B=A(AB).\\n$$\\n\\nBoth products have the order $A,A,B$.\\n\\nSelect $A(B+C)=AC+AB$ and $A^2B=A(AB)$.\"} {:db/id 17592186717597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7a360e66-51b6-5924-ab8a-c45c14e044d7\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717591} {:answer/id #uuid \"809d2d65-91dc-5190-aca9-078dc70ee055\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717593}] :answer-field/correct {:answer/id #uuid \"7a360e66-51b6-5924-ab8a-c45c14e044d7\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717591} :answer-field/id #uuid \"83f29cc6-46b0-51f5-b792-7f05733d6b23\" :answer-field/key \"$A(B-C)=AB-AC$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717594} {:answer-field/choices [{:answer/id #uuid \"c0a67fd5-ebdf-5277-a419-a940e2192c41\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717604} {:answer/id #uuid \"f6286755-e29a-569d-b29b-52a67d61809d\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717613}] :answer-field/correct {:answer/id #uuid \"c0a67fd5-ebdf-5277-a419-a940e2192c41\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717604} :answer-field/id #uuid \"cce4c5c9-9d8d-53e8-b05e-f8d6f8f0c1d8\" :answer-field/key \"$(A+B)C=CA+CB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717608} {:answer-field/choices [{:answer/id #uuid \"a9e4370c-d857-5781-9d2e-bfad3656fd8e\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717598} {:answer/id #uuid \"c1578945-d02d-5d97-b56d-db2110fb4172\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186717605}] :answer-field/correct {:answer/id #uuid \"a9e4370c-d857-5781-9d2e-bfad3656fd8e\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186717598} :answer-field/id #uuid \"ce0d831d-d8af-525c-88eb-0b79fd3dba7a\" :answer-field/key \"$A(B+I_2)=AB$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186717609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"985afdc3-6dd2-5ae5-afc3-822f672a03b9\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $A(B+I_2)=AB$ is not always true. Distribution gives\\n\\n$$\\nA(B+I_2)=AB+AI_2=AB+A.\\n$$\\n\\nThe extra $A$ cannot generally be dropped. For example, $A=I_2$ and $B=0$ give $I_2$ on the left and $0$ on the right.\\n\\n- $(A+B)C=CA+CB$ is not always true. The correct right distribution is\\n\\n$$\\n(A+B)C=AC+BC.\\n$$\\n\\nThe factor $C$ must stay on the right of each term. For a counterexample, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\qquad B=\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\qquad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen $(A+B)C=C$, whereas $CA+CB=0$.\\n\\n- $A(B-C)=AB-AC$ is always true by the distributive law. The left factor $A$ stays on the left in both products, and subtraction is preserved.\\n\\nSelect only $A(B-C)=AB-AC$.\"} {:db/id 17592186717988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2337eacf-3112-5321-8345-803d0708169e\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186717989} {:answer/id #uuid \"45141402-cc9a-574b-8747-5b82e65af53f\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186717994} {:answer/id #uuid \"90dfb212-be54-5d70-90ea-314d7849d850\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186718007} {:answer/id #uuid \"a04fcacc-57cc-5e21-a045-d041cc87bdcd\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186718009} {:answer/id #uuid \"ef7262c7-4a9d-5426-adeb-46c17f3d89cf\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186718017}] :answer-field/correct {:answer/id #uuid \"2337eacf-3112-5321-8345-803d0708169e\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186717989} :answer-field/id #uuid \"fb70ba4e-bcf1-5422-967c-43d20b2c2193\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186718021}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"161f4188-5649-5158-8ed8-0617b613a636\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true?\\n\\n**I.** $(B+I_2)C=BC+C$\\n\\n**II.** $C(AB)=(CA)B$\\n\\n**III.** $A(B-C)=BA-AC$\" :question/worked-solution \"- $(B+I_2)C=BC+C$ is **always true**. First distribute, keeping the outside factor on its original side. Then remove the identity factor; its entire term must remain.\\n\\n$$\\n\\\\begin{aligned}(B+I_2)C &=BC+I_2C \\\\\\\\  &=BC+C\\\\end{aligned}\\n$$\\n\\n- $C(AB)=(CA)B$ is **always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}C(AB) &=(CA)B\\\\end{aligned}\\n$$\\n\\n- $A(B-C)=BA-AC$ is **not always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}A(B-C) &=AB-AC\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}-1 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}-1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\nSelect $(B+I_2)C=BC+C$, $C(AB)=(CA)B$.\"} {:db/id 17592186718003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2e71b797-3e1d-5bab-a16d-6cdd77f1150a\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186717992} {:answer/id #uuid \"5b12e166-e02e-5a47-9542-8d044e7dce2b\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186717997} {:answer/id #uuid \"7e8bd83b-a430-5a49-8f45-ef1587fe30ec\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186718004} {:answer/id #uuid \"f0b2b035-9906-5070-ad55-44180f541f3c\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186718018} {:answer/id #uuid \"f7504c56-e384-5159-8ee7-62605711a788\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186718019}] :answer-field/correct {:answer/id #uuid \"5b12e166-e02e-5a47-9542-8d044e7dce2b\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186717997} :answer-field/id #uuid \"aa2ffbab-4fd7-5376-b221-faadb642bedd\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186718011}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"799af930-c3d6-5801-86dd-00d3b46628ae\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true?\\n\\n**I.** $(C+I_2)B=CB+B$\\n\\n**II.** $A(BC)=(BA)C$\\n\\n**III.** $(A-B)C=AC-BC$\" :question/worked-solution \"- $(C+I_2)B=CB+B$ is **always true**. First distribute, keeping the outside factor on its original side. Then remove the identity factor; its entire term must remain.\\n\\n$$\\n\\\\begin{aligned}(C+I_2)B &=CB+I_2B \\\\\\\\  &=CB+B\\\\end{aligned}\\n$$\\n\\n- $A(BC)=(BA)C$ is **not always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}A(BC) &=(AB)C\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $(A-B)C=AC-BC$ is **always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}(A-B)C &=AC-BC\\\\end{aligned}\\n$$\\n\\nSelect $(C+I_2)B=CB+B$, $(A-B)C=AC-BC$.\"} {:db/id 17592186718010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0537f584-6ce6-5207-9f66-f2befb5675b0\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186717987} {:answer/id #uuid \"273b9b03-d11e-5d9a-b4ff-de89a88b98e3\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186717990} {:answer/id #uuid \"566bf995-96b2-5393-bdab-07bbae605731\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186717996} {:answer/id #uuid \"740b0104-9183-5719-838a-c8373687e208\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186718002} {:answer/id #uuid \"b2b65a91-f571-5670-9926-3d6349f82bac\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186718012}] :answer-field/correct {:answer/id #uuid \"566bf995-96b2-5393-bdab-07bbae605731\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186717996} :answer-field/id #uuid \"708f5854-c62d-5141-af3c-51a508be43cc\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186718001}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a559ada1-d2f0-50f2-b350-849a627b250b\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true?\\n\\n**I.** $C(BA)=(BC)A$\\n\\n**II.** $B(A+I_2)=BA$\\n\\n**III.** $(A+B)C=AC+BC$\" :question/worked-solution \"- $C(BA)=(BC)A$ is **not always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}C(BA) &=(CB)A\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $B(A+I_2)=BA$ is **not always true**. First distribute, keeping the outside factor on its original side. Then remove the identity factor; its entire term must remain.\\n\\n$$\\n\\\\begin{aligned}B(A+I_2) &=BA+BI_2 \\\\\\\\  &=BA+B\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}2 & 0 \\\\\\\\ 0 & 2\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $(A+B)C=AC+BC$ is **always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}(A+B)C &=AC+BC\\\\end{aligned}\\n$$\\n\\nSelect $(A+B)C=AC+BC$.\"} {:db/id 17592186718015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3341623b-651b-5de3-8fd6-6cc953dde418\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186717993} {:answer/id #uuid \"5dbf73eb-ada2-5165-8f98-f595feba5583\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186717998} {:answer/id #uuid \"61f446c8-0dfd-5cf1-bdcb-b2f157987811\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186718000} {:answer/id #uuid \"d570779f-8318-5a3b-a182-5f3a31cb554c\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186718013} {:answer/id #uuid \"d7a1f9bf-9b9a-5f67-9b3e-63736f67a536\" :answer/type {:db/ident :answer.type/text} :answer/value \"II and III only\" :db/id 17592186718014}] :answer-field/correct {:answer/id #uuid \"61f446c8-0dfd-5cf1-bdcb-b2f157987811\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186718000} :answer-field/id #uuid \"9bc99618-5a45-59d4-93d2-270deaeec9ca\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186718008}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e13527ea-1f84-5e05-989b-6ecd900ea451\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true?\\n\\n**I.** $A(B-I_2)=AB-A$\\n\\n**II.** $B(CA)=(CB)A$\\n\\n**III.** $(A+B)C=CA+BC$\" :question/worked-solution \"- $A(B-I_2)=AB-A$ is **always true**. First distribute, keeping the outside factor on its original side. Then remove the identity factor; its entire term must remain.\\n\\n$$\\n\\\\begin{aligned}A(B-I_2) &=AB-AI_2 \\\\\\\\  &=AB-A\\\\end{aligned}\\n$$\\n\\n- $B(CA)=(CB)A$ is **not always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}B(CA) &=(BC)A\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $(A+B)C=CA+BC$ is **not always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}(A+B)C &=AC+BC\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 2 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\nSelect $A(B-I_2)=AB-A$.\"} {:db/id 17592186718016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"29101904-231e-52be-9bc6-3ea714ea440c\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and III only\" :db/id 17592186717991} {:answer/id #uuid \"5259c92a-f9da-5505-b9d6-9b085df51a24\" :answer/type {:db/ident :answer.type/text} :answer/value \"I only\" :db/id 17592186717995} {:answer/id #uuid \"5f8f4157-54bb-5eea-abec-f48efbb0696b\" :answer/type {:db/ident :answer.type/text} :answer/value \"II only\" :db/id 17592186717999} {:answer/id #uuid \"804532e1-c62b-5a51-9d54-1aa24600552b\" :answer/type {:db/ident :answer.type/text} :answer/value \"I and II only\" :db/id 17592186718005} {:answer/id #uuid \"f8e52379-cd50-5e11-aef0-9a3b4f825bac\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186718020}] :answer-field/correct {:answer/id #uuid \"f8e52379-cd50-5e11-aef0-9a3b4f825bac\" :answer/type {:db/ident :answer.type/text} :answer/value \"III only\" :db/id 17592186718020} :answer-field/id #uuid \"82b2bac9-4d17-5d1d-876f-c5058f506a7e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186718006}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e55ab3a0-dbbe-5515-a330-1f4f2bc2a90e\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nWhich statements are always true?\\n\\n**I.** $A(B+C)=AB+CA$\\n\\n**II.** $C(A-I_2)=CA$\\n\\n**III.** $B(AC)=(BA)C$\" :question/worked-solution \"- $A(B+C)=AB+CA$ is **not always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}A(B+C) &=AB+AC\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}1 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $C(A-I_2)=CA$ is **not always true**. First distribute, keeping the outside factor on its original side. Then remove the identity factor; its entire term must remain.\\n\\n$$\\n\\\\begin{aligned}C(A-I_2) &=CA-CI_2 \\\\\\\\  &=CA-C\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $B(AC)=(BA)C$ is **always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}B(AC) &=(BA)C\\\\end{aligned}\\n$$\\n\\nSelect $B(AC)=(BA)C$.\"} {:db/id 17592186718033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ad4a9241-5e66-584e-b653-8553196ac986\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718052} {:answer/id #uuid \"d2499650-dea9-58fe-b930-002e52763db7\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718056}] :answer-field/correct {:answer/id #uuid \"d2499650-dea9-58fe-b930-002e52763db7\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718056} :answer-field/id #uuid \"04101b82-c742-577b-947a-f5962697b07c\" :answer-field/key \"$A(C+B)=CA+BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718024} {:answer-field/choices [{:answer/id #uuid \"3d663199-31ab-55c3-91a2-90658da9c6f3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718037} {:answer/id #uuid \"798f4d5c-88ff-5f9d-8ec7-82ff449d4af9\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718043}] :answer-field/correct {:answer/id #uuid \"798f4d5c-88ff-5f9d-8ec7-82ff449d4af9\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718043} :answer-field/id #uuid \"1aa6c570-10eb-5b8e-b927-2ffdb6f66e85\" :answer-field/key \"$C(BA)=(CA)B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718028} {:answer-field/choices [{:answer/id #uuid \"004d4f99-c58f-5a31-8e27-26b132677d63\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718023} {:answer/id #uuid \"1ad284a5-7f32-5474-a070-95b3d4fa17a9\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718029}] :answer-field/correct {:answer/id #uuid \"1ad284a5-7f32-5474-a070-95b3d4fa17a9\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718029} :answer-field/id #uuid \"fd059a1e-2123-534a-98b7-d978f236980e\" :answer-field/key \"$I_2A=A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718062}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2cbaa884-991c-567f-b788-62be891c7a2f\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $I_2A=A$ is **always true**. The identity factor disappears; the arbitrary matrix remains.\\n\\n$$\\n\\\\begin{aligned}I_2A &=A\\\\end{aligned}\\n$$\\n\\n- $A(C+B)=CA+BA$ is **not always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}A(C+B) &=AC+AB\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}1 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $C(BA)=(CA)B$ is **not always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}C(BA) &=(CB)A\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\nSelect $I_2A=A$.\"} {:db/id 17592186718038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2fa4da2e-91cb-52fa-8bac-ad7ee2c4d0ab\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718034} {:answer/id #uuid \"94334769-4014-5bbf-960b-8119c23bdd8f\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718047}] :answer-field/correct {:answer/id #uuid \"2fa4da2e-91cb-52fa-8bac-ad7ee2c4d0ab\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718034} :answer-field/id #uuid \"8b01f883-c8d9-5bc6-8e21-94c91994edf3\" :answer-field/key \"$C(AB)=(CA)B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718045} {:answer-field/choices [{:answer/id #uuid \"722df149-01b1-5e96-9bf7-ae9d1321f2e9\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718042} {:answer/id #uuid \"f53b1c44-0c7f-54ed-9625-e154496bbb00\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718060}] :answer-field/correct {:answer/id #uuid \"f53b1c44-0c7f-54ed-9625-e154496bbb00\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718060} :answer-field/id #uuid \"b2daa2e0-de73-5128-9305-ce23c55e671e\" :answer-field/key \"$B(C+A)=BC+BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718053} {:answer-field/choices [{:answer/id #uuid \"34d1c515-7214-5b25-8b63-e0dd7d4fc4d3\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718035} {:answer/id #uuid \"934abd1f-554e-54f3-a57a-0cd271849737\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718046}] :answer-field/correct {:answer/id #uuid \"934abd1f-554e-54f3-a57a-0cd271849737\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718046} :answer-field/id #uuid \"c9d8b6e6-f587-53d7-8064-8acddb650c4c\" :answer-field/key \"$CI_2=I_2$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718055}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"40c0b93f-ed7e-5e12-aa2e-62e07826582d\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $B(C+A)=BC+BA$ is **always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}B(C+A) &=BC+BA\\\\end{aligned}\\n$$\\n\\n- $CI_2=I_2$ is **not always true**. The identity factor disappears; the arbitrary matrix remains.\\n\\n$$\\n\\\\begin{aligned}CI_2 &=C\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $C(AB)=(CA)B$ is **always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}C(AB) &=(CA)B\\\\end{aligned}\\n$$\\n\\nSelect $B(C+A)=BC+BA$, $C(AB)=(CA)B$.\"} {:db/id 17592186718040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1b2bb884-5c03-503c-8d5e-b416c654da1b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718030} {:answer/id #uuid \"eef72ee3-13d2-5041-9cf5-b3053d0d8b3a\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718059}] :answer-field/correct {:answer/id #uuid \"1b2bb884-5c03-503c-8d5e-b416c654da1b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718030} :answer-field/id #uuid \"05b51ad9-438d-585c-bd42-19189199ee95\" :answer-field/key \"$BI_2=B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718025} {:answer-field/choices [{:answer/id #uuid \"1f11542d-5bfc-53a0-b45e-380e8f15f801\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718031} {:answer/id #uuid \"4fc3d147-330e-5871-8869-192e5638a6d5\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718039}] :answer-field/correct {:answer/id #uuid \"4fc3d147-330e-5871-8869-192e5638a6d5\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718039} :answer-field/id #uuid \"df80bc89-483d-5d21-9431-126a2e737d49\" :answer-field/key \"$C(BA)=(CA)B$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718058} {:answer-field/choices [{:answer/id #uuid \"14f91d72-48c5-59de-a004-ceb1409dc210\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718027} {:answer/id #uuid \"a0449f89-1a78-5346-ab2e-d9bc888ed69d\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718051}] :answer-field/correct {:answer/id #uuid \"14f91d72-48c5-59de-a004-ceb1409dc210\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718027} :answer-field/id #uuid \"fa369fec-350f-5ad8-9c67-0bc1725bacd1\" :answer-field/key \"$(B+C)A=BA+CA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718061}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"50c5b39e-765c-58a2-bd59-54cb70ab848a\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $BI_2=B$ is **always true**. The identity factor disappears; the arbitrary matrix remains.\\n\\n$$\\n\\\\begin{aligned}BI_2 &=B\\\\end{aligned}\\n$$\\n\\n- $(B+C)A=BA+CA$ is **always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}(B+C)A &=BA+CA\\\\end{aligned}\\n$$\\n\\n- $C(BA)=(CA)B$ is **not always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}C(BA) &=(CB)A\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\nSelect $BI_2=B$, $(B+C)A=BA+CA$.\"} {:db/id 17592186718049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"14c7e79a-efc8-5546-9b21-86b10f92b6b1\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718026} {:answer/id #uuid \"9ecab358-4026-5ae1-b519-068d715cb220\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718050}] :answer-field/correct {:answer/id #uuid \"14c7e79a-efc8-5546-9b21-86b10f92b6b1\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718026} :answer-field/id #uuid \"3b81b81d-e3df-5081-8236-fe57c7592b2a\" :answer-field/key \"$B(AC)=(BA)C$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718036} {:answer-field/choices [{:answer/id #uuid \"95758370-76ec-5c80-bc78-a5682fbae46f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718048} {:answer/id #uuid \"d4cb8ac6-236c-59fe-89a3-2bac45965cf1\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718057}] :answer-field/correct {:answer/id #uuid \"95758370-76ec-5c80-bc78-a5682fbae46f\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718048} :answer-field/id #uuid \"8659799e-0d97-555e-a24c-7309d70d19fe\" :answer-field/key \"$AI_2=A$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718044} {:answer-field/choices [{:answer/id #uuid \"28221c1c-3df7-561f-b81e-27552137499b\" :answer/type {:db/ident :answer.type/text} :answer/value \"true\" :db/id 17592186718032} {:answer/id #uuid \"5f0a43b8-c7a0-56ca-ab2b-864160402ad3\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718041}] :answer-field/correct {:answer/id #uuid \"5f0a43b8-c7a0-56ca-ab2b-864160402ad3\" :answer/type {:db/ident :answer.type/text} :answer/value \"false\" :db/id 17592186718041} :answer-field/id #uuid \"b3e478cc-aedf-56ff-ab98-89761c4163a8\" :answer-field/key \"$(C+A)B=CB+BA$\" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186718054}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"994bf2d3-1f8f-54d2-96ad-147049cddadc\" :question/problem \"Let $A$, $B$, and $C$ be $2\\\\times 2$ real matrices, and let $I_2$ be the identity matrix.\\n\\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\\n\\nWhich statements are always true? Select all that apply.\" :question/worked-solution \"- $(C+A)B=CB+BA$ is **not always true**. Distribute with the outside factor on the same side in each product.\\n\\n$$\\n\\\\begin{aligned}(C+A)B &=CB+AB\\\\end{aligned}\\n$$\\n\\nThe proposed right side is not guaranteed to equal this result. For example, take\\n\\n$$\\nA=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad B=\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix},\\\\quad C=\\\\begin{bmatrix}1 & 0 \\\\\\\\ 0 & 1\\\\end{bmatrix}.\\n$$\\n\\nThen the left side is $\\\\begin{bmatrix}0 & 2 \\\\\\\\ 0 & 0\\\\end{bmatrix}$ and the proposed right side is $\\\\begin{bmatrix}0 & 1 \\\\\\\\ 0 & 0\\\\end{bmatrix}$, so this is a counterexample.\\n\\n- $AI_2=A$ is **always true**. The identity factor disappears; the arbitrary matrix remains.\\n\\n$$\\n\\\\begin{aligned}AI_2 &=A\\\\end{aligned}\\n$$\\n\\n- $B(AC)=(BA)C$ is **always true**. Associativity moves parentheses while retaining the order of every factor.\\n\\n$$\\n\\\\begin{aligned}B(AC) &=(BA)C\\\\end{aligned}\\n$$\\n\\nSelect $AI_2=A$, $B(AC)=(BA)C$.\"}] :knowledge-point/title \"Identifying True Statements Regarding Matrix Multiplication\"}",
  "records": []
}
