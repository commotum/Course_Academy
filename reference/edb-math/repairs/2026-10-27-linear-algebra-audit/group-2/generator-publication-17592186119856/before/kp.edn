\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-9.$ Therefore, the system has a solution only if\n\n$$\n0=k-9\\,⇒\\,k=9.\n$$"} {:db/id #edb/ref 17592186436138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "711bff2a-6953-5410-bb47-66e0c9bf361e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436132} {:answer/id #uuid "94b9bad3-ee59-5063-a347-e17815281f18" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186436133} {:answer/id #uuid "a2f39043-eded-58ee-8538-d1b96c3a350b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436134} {:answer/id #uuid "a676903a-1471-5d07-b4fb-3436e54d4e03" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436135} {:answer/id #uuid "caaab5ae-2e33-5881-8499-57baf2a35a93" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186436136}] :answer-field/correct {:answer/id #uuid "711bff2a-6953-5410-bb47-66e0c9bf361e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436132} :answer-field/id #uuid "b4437cfd-d611-50b5-a26a-25a34c0f8218" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436137}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1dfec754-9c19-551c-8df7-102df6435813" :question/math-academy-id "q-34636" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}4 \\\\ -2 \\\\ 8\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix},\\,b=\\begin{bmatrix}-2 \\\\ -8 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}4 \\\\ -2 \\\\ 8\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ -8 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}4{x}_{1}+2{x}_{2} &=-2 \\\\ -2{x}_{1}+2{x}_{2} &=-8 \\\\ 8{x}_{1}+2{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}4 & 2 & -2 \\\\ -2 & 2 & -8 \\\\ 8 & 2 & k\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 4 & 2 & -2 \\\\ 8 & 2 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 0 & 6 & -18 \\\\ 8 & 2 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 0 & 6 & -18 \\\\ 0 & 10 & k-32\\end{array}\\right] & {R}_{2} & :=\\frac{1}{6}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 0 & 1 & -3 \\\\ 0 & 10 & k-32\\end{array}\\right] & {R}_{3} & :={R}_{3}-10{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & k-2\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-2.$ Therefore, the system has a solution only if\n\n$$\n0=k-2\\,⟹\\,k=2.\n$$"} {:db/id #edb/ref 17592186563678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a3b4f0-37fc-510b-b782-70713c302e3e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186562949} {:answer/id #uuid "0e4b9832-4e75-5456-ae0f-c9cbef897a8d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562972} {:answer/id #uuid "79384773-3b33-5558-b1a4-01487217122d" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186563212} {:answer/id #uuid "d55768be-caa1-5015-a0a0-51da48688614" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186563412} {:answer/id #uuid "d5b9c506-0e84-558b-99e5-7b80605f2397" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186563413}] :answer-field/correct {:answer/id #uuid "0e4b9832-4e75-5456-ae0f-c9cbef897a8d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562972} :answer-field/id #uuid "a41c8e29-8919-560f-acd3-bb2401f756f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "435bef4b-b3af-5768-973e-b4aa50ac129d" :question/math-academy-id "q-105235" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}+5{x}_{2}=3 \\\\ -2{x}_{1}-9{x}_{2}=-4 \\\\ 2{x}_{1}+10{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 5 & 3 \\\\ -2 & -9 & -4 \\\\ 2 & 10 & k\\end{array}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 2 & 10 & k\\end{array}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k-6\\end{array}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$"} {:db/id #edb/ref 17592186713449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19760ba9-9db5-502d-8d63-3c5fb1086e15" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713448} {:answer/id #uuid "3ce95a86-06ff-558b-9495-32c2a7c7c866" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713450} {:answer/id #uuid "9479c85b-a4e5-50da-982c-ff9b4a609ddc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713457} {:answer/id #uuid "dcf2e29d-80b8-58c8-a486-f34a36bc6cbb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713462} {:answer/id #uuid "eb7a1d3d-9390-54fe-b90a-d2578f3be03e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713464}] :answer-field/correct {:answer/id #uuid "eb7a1d3d-9390-54fe-b90a-d2578f3be03e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713464} :answer-field/id #uuid "dba638f7-0e13-5bd1-81f3-5d3126b48804" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713461}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "29e56cc2-36b7-51bd-bd5d-6d1d8ef616b1" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$. The vectors are\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}3 \\\\ 2 \\\\ k\\end{bmatrix}.\n$$\n\nThe augmented matrix for $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has already been row reduced:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2 \\\\ 2 & -1 & k\\end{array}\\right]\\;\\sim\\;\\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k-4\\end{array}\\right]\n$$\n\nUse the last row to decide when the system is consistent." :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1 &=3 \\\\ x_2 &=2 \\\\ 2x_1-x_2 &=k\\end{aligned}\\right.\n$$\n\nThe last row of the supplied row-reduced matrix means $0x_1+0x_2=k-4$. For the system to have a solution, this equation must be $0=0$. Thus\n\n$$\nk-4=0\\quad\\Longrightarrow\\quad k=4.\n$$\n\nThe first two rows give $x_1=3$ and $x_2=2$, so this condition is also sufficient:\n\n$$\n3\\mathbf{a}_1+2\\mathbf{a}_2=\\begin{bmatrix}3 \\\\ 2 \\\\ 4\\end{bmatrix}.\n$$\n\nTherefore, $k=4$ is the only value for which the vector lies in the span."} {:db/id #edb/ref 17592186713452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17785160-18b4-5f5b-84c7-847b6dd3b916" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186713447} {:answer/id #uuid "613397bc-053a-5297-b0e8-7eb52a6a852a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186713453} {:answer/id #uuid "63dea0a4-2590-5761-8d90-ad50edd0cb81" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186713454} {:answer/id #uuid "9d65e62c-8dae-5564-b96f-dbfcf07caf41" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186713458} {:answer/id #uuid "c910fee1-23a5-5446-a39c-650adafcc146" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186713460}] :answer-field/correct {:answer/id #uuid "9d65e62c-8dae-5564-b96f-dbfcf07caf41" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186713458} :answer-field/id #uuid "ea52dcba-48da-5f02-86a6-64d1f83fd3c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713463}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "44beb49c-ecc4-56b4-a0c6-edd3f803e5f6" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}-1 \\\\ 1 \\\\ -2\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}4 \\\\ 5 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1-x_2 &=4 \\\\ 2x_1+x_2 &=5 \\\\ 3x_1-2x_2 &=k\\end{aligned}\\right.\n$$\n\nForm the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 2 & 1 & 5 \\\\ 3 & -2 & k\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-2R_1$ and $R_3\\leftarrow R_3-3R_1$:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 0 & 3 & -3 \\\\ 0 & 1 & k-12\\end{array}\\right]\n$$\n\nNext apply $R_2\\leftarrow\\frac{1}{3}R_2$, then $R_3\\leftarrow R_3-R_2$ using the new second row:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & k-11\\end{array}\\right]\n$$\n\nThe last row means $0x_1+0x_2=k-11$. Thus consistency requires\n\n$$\nk-11=0\\quad\\Longrightarrow\\quad k=11.\n$$\n\nThe pivot rows give $x_2=-1$ and $x_1=3$, so the condition is sufficient:\n\n$$\n3\\mathbf{a}_1-\\mathbf{a}_2=\\begin{bmatrix}4 \\\\ 5 \\\\ 11\\end{bmatrix}.\n$$\n\nTherefore, $k=11$ is the only value for which the vector lies in the span."} {:db/id #edb/ref 17592186713455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0789b12a-1f85-5f9c-9110-4dcc165095df" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186713446} {:answer/id #uuid "3ec6dd30-084c-5b50-8027-6486779d6dd3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186713451} {:answer/id #uuid "73aebeee-5e3d-552a-a8e0-4143e4bd227b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186713456} {:answer/id #uuid "b0f4087d-c2c8-5974-86f7-ddf5a9b3a5c9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713459} {:answer/id #uuid "eeba8161-9dcb-50af-a75b-fda8c798e36e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713465}] :answer-field/correct {:answer/id #uuid "3ec6dd30-084c-5b50-8027-6486779d6dd3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186713451} :answer-field/id #uuid "f832b76b-684c-5168-ab5b-85216772e37e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713466}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c1751f1-f7a5-50d3-b40f-a33e3b4f8011" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}2 \\\\ 1 \\\\ 4\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}-3 \\\\ 6 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1+2x_2 &=-3 \\\\ -x_1+x_2 &=6 \\\\ 2x_1+4x_2 &=k\\end{aligned}\\right.\n$$\n\nThe left side of the third equation is twice the left side of the first, so consistency requires $k=2(-3)=-6$. We can verify this by row reduction. Starting with\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & -3 \\\\ -1 & 1 & 6 \\\\ 2 & 4 & k\\end{array}\\right]\n$$\n\napply $R_2\\leftarrow R_2+R_1$ and $R_3\\leftarrow R_3-2R_1$ to obtain\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & -3 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & k+6\\end{array}\\right]\n$$\n\nThe last row requires $0=k+6$, hence $k=-6$. The second row gives $x_2=1$, and the first gives $x_1=-5$. These values verify sufficiency:\n\n$$\n-5\\mathbf{a}_1+\\mathbf{a}_2=\\begin{bmatrix}-3 \\\\ 6 \\\\ -6\\end{bmatrix}.\n$$\n\nTherefore, $k=-6$ is the only value for which the vector lies in the span."} {:db/id #edb/ref 17592186713911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aad39e-0bcd-5ac4-b120-f315b2a3b66d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186713913} {:answer/id #uuid "8fd5e3cd-1fb9-50f5-a37c-e3e538f462b4" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186713928} {:answer/id #uuid "97240460-dda9-5c55-af1a-7ec8905a411c" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186713930} {:answer/id #uuid "b2d642b3-4d73-52ef-8bb7-8769749f00f3" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713935} {:answer/id #uuid "f34eb032-1be9-5033-b596-1dcffa3365f6" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186713943}] :answer-field/correct {:answer/id #uuid "13aad39e-0bcd-5ac4-b120-f315b2a3b66d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186713913} :answer-field/id #uuid "97baa7f7-25cf-56b5-9bec-d66e21316a14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713931}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "08f7d235-02eb-547d-be73-12c3da51c192" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}-2 \\\\ 3 \\\\ -3\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}-1 \\\\ 3 \\\\ -3\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}-6 \\\\ 12 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}- 2 x_{1} - x_{2} &=-6 \\\\ 3 x_{1} + 3 x_{2} &=12 \\\\ - 3 x_{1} - 3 x_{2} &=k\\end{aligned}\\right.\n$$\n\nForm the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}-2 & -1 & -6 \\\\ 3 & 3 & 12 \\\\ -3 & -3 & k\\end{array}\\right]\n$$\n\nApply $R_1\\leftarrow \\left(- \\frac{1}{2}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & \\frac{1}{2} & 3 \\\\ 3 & 3 & 12 \\\\ -3 & -3 & k\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(3)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & \\frac{1}{2} & 3 \\\\ 0 & \\frac{3}{2} & 3 \\\\ -3 & -3 & k\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(-3)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & \\frac{1}{2} & 3 \\\\ 0 & \\frac{3}{2} & 3 \\\\ 0 & - \\frac{3}{2} & k + 9\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow \\left(\\frac{2}{3}\\right)R_2$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & \\frac{1}{2} & 3 \\\\ 0 & 1 & 2 \\\\ 0 & - \\frac{3}{2} & k + 9\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-\\left(- \\frac{3}{2}\\right)R_2$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & \\frac{1}{2} & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k + 12\\end{array}\\right]\n$$\n\nThe last row represents $0x_1+0x_2=k + 12$. Consistency therefore requires\n\n$$\n\\begin{aligned}0 &=k + 12 \\\\ k &=-12.\\end{aligned}\n$$\n\nThe pivot equations give $x_2=2$ and $x_1=2$. These values also establish sufficiency:\n\n$$\n(2)\\mathbf{a}_1+(2)\\mathbf{a}_2=\\begin{bmatrix}-6 \\\\ 12 \\\\ -12\\end{bmatrix}.\n$$\n\nTherefore, $k=-12$ is the only value for which the vector lies in the span."} {:db/id #edb/ref 17592186713914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066b3f5c-36da-52f6-8e4f-6c14ac8b17f2" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186713910} {:answer/id #uuid "0aa06829-8cb7-54d9-8b30-368b9d974283" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186713912} {:answer/id #uuid "5f0dd8b3-8a69-5ade-b0f0-71a808740910" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186713921} {:answer/id #uuid "67c367c1-9fb8-5443-b1cf-fbe3665583b6" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186713923} {:answer/id #uuid "ef4e7512-a7f5-5a7d-9e77-6d0a0095bdd7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186713942}] :answer-field/correct {:answer/id #uuid "5f0dd8b3-8a69-5ade-b0f0-71a808740910" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186713921} :answer-field/id #uuid "ad22df8d-0d33-5cb3-aab6-25a7f1737abf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "18a0d301-489e-58dc-897c-edd8a69d7f80" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}-3 \\\\ 3 \\\\ 6\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}2 \\\\ 2 \\\\ 4\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}-8 \\\\ 16 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}- 3 x_{1} + 2 x_{2} &=-8 \\\\ 3 x_{1} + 2 x_{2} &=16 \\\\ 6 x_{1} + 4 x_{2} &=k\\end{aligned}\\right.\n$$\n\nForm the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}-3 & 2 & -8 \\\\ 3 & 2 & 16 \\\\ 6 & 4 & k\\end{array}\\right]\n$$\n\nApply $R_1\\leftarrow \\left(- \\frac{1}{3}\\right)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & - \\frac{2}{3} & \\frac{8}{3} \\\\ 3 & 2 & 16 \\\\ 6 & 4 & k\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-(3)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & - \\frac{2}{3} & \\frac{8}{3} \\\\ 0 & 4 & 8 \\\\ 6 & 4 & k\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(6)R_1$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & - \\frac{2}{3} & \\frac{8}{3} \\\\ 0 & 4 & 8 \\\\ 0 & 8 & k - 16\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow \\left(\\frac{1}{4}\\right)R_2$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & - \\frac{2}{3} & \\frac{8}{3} \\\\ 0 & 1 & 2 \\\\ 0 & 8 & k - 16\\end{array}\\right]\n$$\n\nApply $R_3\\leftarrow R_3-(8)R_2$.\n\n$$\n\\left[\\begin{array}{cc|c}1 & - \\frac{2}{3} & \\frac{8}{3} \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k - 32\\end{array}\\right]\n$$\n\nThe last row represents $0x_1+0x_2=k - 32$. Consistency therefore requires\n\n$$\n\\begin{aligned}0 &=k - 32 \\\\ k &=32.\\end{aligned}\n$$\n\nThe pivot equations give $x_2=2$ and $x_1=4$. These values also establish sufficiency:\n\n$$\n(4)\\mathbf{a}_1+(2)\\mathbf{a}_2=\\begin{bmatrix}-8 \\\\ 16 \\\\ 32\\end{bmatrix}.\n$$\n\nTherefore, $k=32$ is the only value for which the vector lies in the span."} {:db/id #edb/ref 17592186713916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2848c0fb-cd72-5d0a-b92b-733826d44eb7" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186713917} {:answer/id #uuid "9608afc5-dd9b-59e3-a5a5-15e87d23af68" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713929} {:answer/id #uuid "a1685ecf-0849-5374-bcb6-fffc1a369288" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713932} {:answer/id #uuid "c650b55f-11fc-5d96-9330-b6fa1e3724cf" :an