igned} & \\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 2 & -1 & 5 \\\\ 3 & 6 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 3 & 6 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 9 & k-6\\end{array}\\right] & {R}_{3} & :={R}_{3}-9{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & k-15\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-15.$ Therefore, the system has a solution only if\n\n$$\n0=k-15\\,⇒\\,k=15.\n$$"} {:db/id #edb/ref 17592186342229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18733bfc-c516-57fc-8204-98be886fd6cc" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186339347} {:answer/id #uuid "1ee95a79-bba5-59cc-9f71-c0051ce3fca6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186339398} {:answer/id #uuid "4d1a1e05-cb85-543e-b3c6-80325298b9b9" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186339831} {:answer/id #uuid "5809d3ca-8a99-57cf-8d7b-4d70abd4f34b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339930} {:answer/id #uuid "7a8d2452-3d62-57a3-9c5b-df55a70b783b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340222}] :answer-field/correct {:answer/id #uuid "5809d3ca-8a99-57cf-8d7b-4d70abd4f34b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339930} :answer-field/id #uuid "df57767b-1e97-5aa2-bd32-f48e86c9f80c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341775}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c201285-f84a-584f-bd1b-b67204ad9977" :questio