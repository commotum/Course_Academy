\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ -2 & 4 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & k+8\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+8.$ Therefore, the system has a solution only if\n\n$$\n0=k+8\\,⇒\\,k=-8.\n$$"} {:db/id #edb/ref 17592186241019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351d3eaa-8d71-5eaf-91f1-6a15d982842b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186238515} {:answer/id #uuid "521c8347-9356-57c0-82a2-f6f058e2fdd4" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186238763} {:answer/id #uuid "77e423df-6336-5ebd-a988-70ffd97ff91b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186239089} {:answer/id #uuid "9e933237-ff23-52d2-a25d-7ee910ab795d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186239441} {:answer/id #uuid "b70c1cd0-e286-53f1-ba39-4e8669a377a5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186239650}] :answer-field/correct {:answer/id #uuid "521c8347-9356-57c0-82a2-f6f058e2fdd4" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186238763} :answer-field/id #uuid "ca08aa7d-69a4-53e7-9a42-33232fc442bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240683}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "847914f8-60db-55a2-9155-7cfe231e6bcb" :question/math-academy-id "q-105237" :question/problem "Find the values of $k$ such that the vector $\\mathbf{b}$ lies in $\\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\},$ where\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=