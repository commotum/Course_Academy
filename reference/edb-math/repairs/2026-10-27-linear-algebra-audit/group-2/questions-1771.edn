1)^{3+2}D_{1}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}-2 & -3 & 1 \\\\ 1 & -2 & 3 \\\\ 0 & -2 & 0\\end{vmatrix}.\n$$\n\nExpand along row $3$, retaining the cofactor signs.\n\n$$\nD_{1}=(-2)(-1)^{3+2}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}-2 & 1 \\\\ 1 & 3\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=(-2)\\cdot 3-1\\cdot 1\\\\&=(-6)-1=-7.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=2\\cdot (-7)=-14.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=3\\cdot (-14)=-42.\n$$\n\nTherefore,\n\n$$\nV=|-42|=42.\n$$"}] [{:db/id #edb/ref 17592186704235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a088fbd-1625-5109-b4c0-d895155e4a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186704219} {:answer/id #uuid "1c073555-788b-57aa-814d-e3f3bb4a1656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704220} {:answer/id #uuid "a91ce31c-5feb-53e3-bbf3-4bbff8c9175f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704236} {:answer/id #uuid "bb9adb06-342f-5237-9814-0a3978023376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704239} {:answer/id #uuid "e0c57f19-b66a-53d2-82dc-b4f100862b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186704246}] :answer-field/correct {:answer/id #uuid "1a088fbd-1625-5109-b4c0-d895155e4a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186704219} :answer-field/id #uuid "bcd6c800-5260-5a9d-9c6a-0d8faf6d67a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704241}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8edf5ac0-ceb8-5d68-b7b3-ee5e04414f11" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}3 \\\\ 0 \\\\ 3 \\\\ 0\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}3 \\\\ -3 \\\\ -3 \\\\ 0\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}-1 \\\\ -1 \\\\ 1 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}0 & 3 & 3 & -1 \\\\ 0 & 0 & -3 & -1 \\\\ 1 & 3 & -3 & 1 \\\\ 0 & 0 & 0 & 4\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\n\\det(M)=1(-1)^{3+1}D_{1}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}3 & 3 & -1 \\\\ 0 & -3 & -1 \\\\ 0 & 0 & 4\\end{vmatrix}.\n$$\n\nThis matrix is triangular, so multiply its diagonal entries.\n\n$$\nD_{1}=3\\cdot (-3)\\cdot 4=-36.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=1\\cdot (-36)=-36.\n$$\n\nTherefore,\n\n$$\nV=|-36|=36.\n$$"}] [{:db/id #edb/ref 17592186704242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1794ae4d-f103-5226-a922-bc99ea7ce66d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704217} {:answer/id #uuid "818ffea5-794f-57e2-a435-9004a41c9403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704233} {:answer/id #uuid "b8fd1034-cc1b-5d32-b093-55a8f06d77d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186704238} {:answer/id #uuid "e063a629-734a-570d-8412-90cd91e73cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186704245} {:answer/id #uuid "f4b19110-0f1a-5b68-b490-7c687fb884e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186704247}] :answer-field/correct {:answer/id #uuid "b8fd1034-cc1b-5d32-b093-55a8f06d77d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186704238} :answer-field/id #uuid "0c945ada-9e70-5675-a4e5-da9265b30ebd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704216}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf25b63d-57c2-5edb-a678-1c0b35ea1a89" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}0 \\\\ -3 \\\\ 0 \\\\ 0\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}4 \\\\ -4 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}1 \\\\ -4 \\\\ 0 \\\\ 2\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}2 \\\\ 1 \\\\ 3 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}0 & 4 & 1 & 2 \\\\ -3 & -4 & -4 & 1 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 1 & 2 & 4\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along row $3$, retaining the cofactor signs.\n\n$$\n\\det(M)=3(-1)^{3+4}D_{1}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}0 & 4 & 1 \\\\ -3 & -4 & -4 \\\\ 0 & 1 & 2\\end{vmatrix}.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\nD_{1}=(-3)(-1)^{2+1}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}4 & 1 \\\\ 1 & 2\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=4\\cdot 2-1\\cdot 1\\\\&=8-1=7.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=3\\cdot 7=21.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=(-3)\\cdot 21=-63.\n$$\n\nTherefore,\n\n$$\nV=|-63|=63.\n$$"}] [{:db/id #edb/ref 17592186704254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b40157f-c160-53e2-9d02-046394d4fec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186704261} {:answer/id #uuid "7f7d4aeb-1dc8-5dc9-800b-d381ec2fe92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186704263} {:answer/id #uuid "b9f63996-c829-5936-8958-1f5181d21e3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186704267} {:answer/id #uuid "bb15cf05-4b2b-5183-b733-dae88ba98f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186704268} {:answer/id #uuid "fcffb5d5-27ce-56f8-b9ee-7ae5d7995f4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186704277}] :answer-field/correct {:answer/id #uuid "bb15cf05-4b2b-5183-b733-dae88ba98f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186704268} :answer-field/id #uuid "f526f7be-01b4-5787-a45b-e7519ad76c54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704275}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "14474f3f-fe50-5bb7-8cd7-4828d0fc3003" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}0 \\\\ -3 \\\\ 0 \\\\ -1\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}-2 \\\\ 2 \\\\ -1 \\\\ 0\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}-4 \\\\ 0 \\\\ 0 \\\\ 3\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}0 & -2 & -4 & 1 \\\\ -3 & 2 & 0 & -2 \\\\ 0 & -1 & 0 & 2 \\\\ -1 & 0 & 3 & 0\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along row $4$, retaining the cofactor signs.\n\n$$\n\\det(M)=(-1)(-1)^{4+1}D_{1}+3(-1)^{4+3}D_{3}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}-2 & -4 & 1 \\\\ 2 & 0 & -2 \\\\ -1 & 0 & 2\\end{vmatrix}.\n$$\n\nExpand along column $2$, retaining the cofactor signs.\n\n$$\nD_{1}=(-4)(-1)^{1+2}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}2 & -2 \\\\ -1 & 2\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=2\\cdot 2-(-2)\\cdot (-1)\\\\&=4-2=2.\\end{aligned}\n$$\n\nEvaluate the minor\n\n$$\nD_{3}=\\begin{vmatrix}0 & -2 & 1 \\\\ -3 & 2 & -2 \\\\ 0 & -1 & 2\\end{vmatrix}.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\nD_{3}=(-3)(-1)^{2+1}D_{4}.\n$$\n\nEvaluate the minor\n\n$$\nD_{4}=\\begin{vmatrix}-2 & 1 \\\\ -1 & 2\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{4}&=(-2)\\cdot 2-1\\cdot (-1)\\\\&=(-4)-(-1)=-3.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{3}=3\\cdot (-3)=-9.\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=4\\cdot 2=8.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=1\\cdot 8+(-3)\\cdot (-9)=35.\n$$\n\nTherefore,\n\n$$\nV=|35|=35.\n$$"}] [{:db/id #edb/ref 17592186704265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ee69ed8-9df6-57a9-96f3-91f9c25f8bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186704255} {:answer/id #uuid "21e04442-ee31-5011-8b67-9a4d9133a190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86" :db/id #edb/ref 17592186704256} {:answer/id #uuid "5ada9fc5-da68-5378-9dc7-6db6b5da3c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186704260} {:answer/id #uuid "6fcaff27-222b-5245-984d-36c4169481a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704262} {:answer/id #uuid "fadb4b5a-150f-5c8e-aa97-f59369399769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186704276}] :answer-field/correct {:answer/id #uuid "21e04442-ee31-5011-8b67-9a4d9133a190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "86" :db/id #edb/ref 17592186704256} :answer-field/id #uuid "844aaad4-518c-5e0b-8198-448464b93d42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704264}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87421bbb-1864-5d1b-8d4e-c61630b4ef86" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}3 \\\\ 4 \\\\ -3 \\\\ 0\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}0 \\\\ 0 \\\\ 3 \\\\ -1\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}1 \\\\ 3 \\\\ 1 \\\\ 0\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}2 \\\\ 0 \\\\ 0 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}3 & 0 & 1 & 2 \\\\ 4 & 0 & 3 & 0 \\\\ -3 & 3 & 1 & 0 \\\\ 0 & -1 & 0 & 4\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along row $4$, retaining the cofactor signs.\n\n$$\n\\det(M)=(-1)(-1)^{4+2}D_{1}+4(-1)^{4+4}D_{3}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}3 & 1 & 2 \\\\ 4 & 3 & 0 \\\\ -3 & 1 & 0\\end{vmatrix}.\n$$\n\nExpand along column $3$, retaining the cofactor signs.\n\n$$\nD_{1}=2(-1)^{1+3}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}4 & 3 \\\\ -3 & 1\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=4\\cdot 1-3\\cdot (-3)\\\\&=4-(-9)=13.\\end{aligned}\n$$\n\nEvaluate the minor\n\n$$\nD_{3}=\\begin{vmatrix}3 & 0 & 1 \\\\ 4 & 0 & 3 \\\\ -3 & 3 & 1\\end{vmatrix}.\n$$\n\nExpand along column $2$, retaining the cofactor signs.\n\n$$\nD_{3}=3(-1)^{3+2}D_{4}.\n$$\n\nEvaluate the minor\n\n$$\nD_{4}=\\begin{vmatrix}3 & 1 \\\\ 4 & 3\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{4}&=3\\cdot 3-1\\cdot 4\\\\&=9-4=5.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{3}=(-3)\\cdot 5=-15.\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=2\\cdot 13=26.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=(-1)\\cdot 26+4\\cdot (-15)=-86.\n$$\n\nTherefore,\n\n$$\nV=|-86|=86.\n$$"}] [{:db/id #edb/ref 17592186704273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0638a4f5-b667-5182-a6f4-acb888daf41e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186704250} {:answer/id #uuid "102b8f65-f694-53a8-859b-a7ea412ce863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704252} {:answer/id #uuid "8e06bd71-d275-5ebd-924d-d0ae62c5da94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704266} {:answer/id #uuid "c8e4fbeb-e8f1-55fe-86ea-60cce8d36294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704270} {:answer/id #uuid "d0401953-c1d9-5d12-a97c-2b61eaa03203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186704271}] :answer-field/correct {:answer/id #uuid "8e06bd71-d275-5ebd-924d-d0ae62c5da94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704266} :answer-field/id #uuid "bd0e1080-8df8-53b0-b296-5dd773af6fb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704269}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e9d09386-de39-5fdc-9879-c52d570701e5" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}3 \\\\ -4 \\\\ 0 \\\\ 0\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}4 \\\\ 0 \\\\ -2 \\\\ 1\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}1 \\\\ 0 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}3 & 0 & 4 & 1 \\\\ -4 & 1 & 0 & 0 \\\\ 0 & 1 & -2 & -2 \\\\ 0 & 0 & 1 & 1\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along row $2$, retaining the cofactor signs.\n\n$$\n\\det(M)=(-4)(-1)^{2+1}D_{1}+1(-1)^{2+2}D_{3}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}0 & 4 & 1 \\\\ 1 & -2 & -2 \\\\ 0 & 1 & 1\\end{vmatrix}.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\nD_{1}=1(-1)^{2+1}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}4 & 1 \\\\ 1 & 1\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=4\\cdot 1-1\\cdot 1\\\\&=4-1=3.\\end{aligned}\n$$\n\nEvaluate the minor\n\n$$\nD_{3}=\\begin{vmatrix}3 & 4 & 1 \\\\ 0 & -2 & -2 \\\\ 0 & 1 & 1\\end{vmatrix}.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\nD_{3}=3(-1)^{1+1}D_{4}.\n$$\n\nEvaluate the minor\n\n$$\nD_{4}=\\begin{vmatrix}-2 & -2 \\\\ 1 & 1\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{4}&=(-2)\\cdot 1-(-2)\\cdot 1\\\\&=(-2)-(-2)=0.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{3}=3\\cdot 0=0.\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=(-1)\\cdot 3=-3.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=4\\cdot (-3)+1\\cdot 0=-12.\n$$\n\nTherefore,\n\n$$\nV=|-12|=12.\n$$"}] [{:db/id #edb/ref 17592186704274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b5a93b-1155-5146-ad1d-a1fdc7b48334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186704251} {:answer/id #uuid "11e4c8ba-c7fe-5967-8673-f50ae3995dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186704253} {:answer/id #uuid "46046cce-0a82-5360-8c82-7a741236e851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "224" :db/id #edb/ref 17592186704258} {:answer/id #uuid "4efbc344-aff5-51f6-95d1-12239fe83868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "280" :db/id #edb/ref 17592186704259} {:answer/id #uuid "d725df19-2ad7-5b47-91f7-660415165860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186704272}] :answer-field/correct {:answer/id #uuid "d725df19-2ad7-5b47-91f7-660415165860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186704272} :answer-field/id #uuid "3100fda9-b7de-5f45-84e6-800b6091831d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704257}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f013bdf4-d9f1-56eb-85be-ba0e2e35ddff" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}2 \\\\ 0 \\\\ -2 \\\\ 0\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}0 \\\\ 4 \\\\ 3 \\\\ 4\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}0 \\\\ -3 \\\\ -4 \\\\ 4\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}-4 \\\\ -1 \\\\ 0 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}2 & 0 & 0 & -4 \\\\ 0 & 4 & -3 & -1 \\\\ -2 & 3 & -4 & 0 \\\\ 0 & 4 & 4 & 0\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along row $1$, retaining the cofactor signs.\n\n$$\n\\det(M)=2(-1)^{1+1}D_{1}+(-4)(-1)^{1+4}D_{3}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}4 & -3 & -1 \\\\ 3 & -4 & 0 \\\\ 4 & 4 & 0\\end{vmatrix}.\n$$\n\nExpand along column $3$, retaining the cofactor signs.\n\n$$\nD_{1}=(-1)(-1)^{1+3}D_{2}.\n$$\n\nEvaluate the minor\n\n$$\nD_{2}=\\begin{vmatrix}3 & -4 \\\\ 4 & 4\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{2}&=3\\cdot 4-(-4)\\cdot 4\\\\&=12-(-16)=28.\\end{aligned}\n$$\n\nEvaluate the minor\n\n$$\nD_{3}=\\begin{vmatrix}0 & 4 & -3 \\\\ -2 & 3 & -4 \\\\ 0 & 4 & 4\\end{vmatrix}.\n$$\n\nExpand along column $1$, retaining the cofactor signs.\n\n$$\nD_{3}=(-2)(-1)^{2+1}D_{4}.\n$$\n\nEvaluate the minor\n\n$$\nD_{4}=\\begin{vmatrix}4 & -3 \\\\ 4 & 4\\end{vmatrix}.\n$$\n\nUse the difference of the cross products.\n\n$$\n\\begin{aligned}D_{4}&=4\\cdot 4-(-3)\\cdot 4\\\\&=16-(-12)=28.\\end{aligned}\n$$\n\nCombine the signed contributions:\n\n$$\nD_{3}=2\\cdot 28=56.\n$$\n\nCombine the signed contributions:\n\n$$\nD_{1}=(-1)\\cdot 28=-28.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=2\\cdot (-28)+4\\cdot 56=168.\n$$\n\nTherefore,\n\n$$\nV=|168|=168.\n$$"}] [{:db/id #edb/ref 17592186704383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0974a0c7-8269-50f5-9269-333d3b196b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704385} {:answer/id #uuid "1e69dd23-64ef-563a-ac77-a0cbe3f8f50a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704388} {:answer/id #uuid "376752ec-cfce-57bb-bf4d-df9a5c949339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704393} {:answer/id #uuid "cb8f0f84-a0ee-5585-8aed-0d3d4e5fef57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704412} {:answer/id #uuid "cfbd8231-ca70-5a30-8df0-9cc55203739f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704415}] :answer-field/correct {:answer/id #uuid "cfbd8231-ca70-5a30-8df0-9cc55203739f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704415} :answer-field/id #uuid "bdf94aec-1f85-529e-96d7-cbbb79701998" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704410}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "011d16e6-6939-56f5-b73d-fff168ae73d7" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 2 & -2 & 2 \\\\ -1 & -2 & 2 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{4+1}\\begin{vmatrix}2 & 0 & -1 \\\\ 1 & 0 & 1 \\\\ 2 & -2 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{3+2}\\begin{vmatrix}2 & -1 \\\\ 1 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 3 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & -1 \\\\ 1 & 1\\end{vmatrix} \\\\ &=(2)(1)-(-1)(1) \\\\ &=3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{3+2}(3) \\\\ &=6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{4+1}(6) \\\\ &=6.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=6$."}] [{:db/id #edb/ref 17592186704395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6deea-fa85-5f50-a311-5a93075befb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704384} {:answer/id #uuid "95a95589-b30d-5d65-99ba-c8ab2596ba61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704408} {:answer/id #uuid "b1036f2c-6fa2-5489-a416-9d5c5a16b2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704409} {:answer/id #uuid "c3965541-9341-566f-b5f0-6d2f5ff99695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704411} {:answer/id #uuid "f723223c-2dc2-5b5a-a714-f9a9fb2e567f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704417}] :answer-field/correct {:answer/id #uuid "b1036f2c-6fa2-5489-a416-9d5c5a16b2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704409} :answer-field/id #uuid "50ec9776-a284-5675-9390-90ecc0a18c59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704400}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b91d575-508c-5aa1-b7e9-ae9619ddbb4b" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}2 & 0 & \\frac{1}{2} & 0 \\\\ 1 & 3 & -1 & -1 \\\\ 3 & -2 & - \\frac{3}{2} & 0 \\\\ -2 & 0 & - \\frac{1}{2} & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{2+4}\\begin{vmatrix}2 & 0 & \\frac{1}{2} \\\\ 3 & -2 & - \\frac{3}{2} \\\\ -2 & 0 & - \\frac{1}{2}\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+2}\\begin{vmatrix}2 & \\frac{1}{2} \\\\ -2 & - \\frac{1}{2}\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & \\frac{1}{2} \\\\ -2 & - \\frac{1}{2}\\end{vmatrix} \\\\ &=(2)\\left(- \\frac{1}{2}\\right)-\\left(\\frac{1}{2}\\right)(-2) \\\\ &=0.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+2}(0) \\\\ &=0.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{2+4}(0) \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=0$."}] [{:db/id #edb/ref 17592186704401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2207fa0a-2b85-5a84-99b8-e0cab749a1e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704390} {:answer/id #uuid "322669cb-bfd6-5b69-9efb-9a210087cf3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704392} {:answer/id #uuid "5eb3aea6-b30b-5078-bcbe-1de96b52818c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 2 \\sqrt{3}" :db/id #edb/ref 17592186704404} {:answer/id #uuid "6f7cf6f4-7120-5887-87b8-d519e7da680c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704405} {:answer/id #uuid "79058757-4e63-5765-80fa-801e254af8bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4 + 2 \\sqrt{3}" :db/id #edb/ref 17592186704407}] :answer-field/correct {:answer/id #uuid "322669cb-bfd6-5b69-9efb-9a210087cf3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704392} :answer-field/id #uuid "37b8a0e4-cd76-5935-87fa-acd2a84c836c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704394}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5306fe3f-b2d8-52ea-ad10-ffa4c780480f" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & - 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ -2 & 3 \\sqrt{3} & 1 & \\sqrt{3} \\\\ 0 & 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & 0 & \\sqrt{3}\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{2+1}\\begin{vmatrix}- 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & \\sqrt{3}\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}- 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & \\sqrt{3}\\end{vmatrix} \\\\ &=(- 2 \\sqrt{3})\\cdot(2)\\cdot(\\sqrt{3}) \\\\ &=-12.\\end{aligned}\n$$\n\nUse $\\sqrt{3}\\cdot\\sqrt{3}=3$.\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{2+1}(-12) \\\\ &=-24.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-24$."}] [{:db/id #edb/ref 17592186704402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f7563-3eec-5fc9-b737-a21dd802eece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704389} {:answer/id #uuid "448f2107-2d71-5d28-a199-8f29bef5487a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704397} {:answer/id #uuid "44a87ad0-f3d4-5549-aa21-c7efae8fc47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704398} {:answer/id #uuid "5aa02756-8b6f-58cc-a2a8-b29931a3877e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704403} {:answer/id #uuid "e53f6058-d838-5c9b-a511-b0c78a37a740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186704416}] :answer-field/correct {:answer/id #uuid "44a87ad0-f3d4-5549-aa21-c7efae8fc47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704398} :answer-field/id #uuid "cc91082f-5cf9-51de-bb28-99c105593211" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704413}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54ef2a5d-9a4a-55e0-bbc4-d1618ef2c4c1" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & 0 & 0 & -2 \\\\ 2 & 1 & 1 & -3 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 0 & -1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 1; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{1+4}\\begin{vmatrix}2 & 1 & 1 \\\\ 0 & -2 & -1 \\\\ 0 & 0 & -1\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}2 & 1 & 1 \\\\ 0 & -2 & -1 \\\\ 0 & 0 & -1\\end{vmatrix} \\\\ &=(2)\\cdot(-2)\\cdot(-1) \\\\ &=4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{1+4}(4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=8$."}] [{:db/id #edb/ref 17592186704406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d70c3a0-22aa-5b1b-b16f-da791bb42bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186704387} {:answer/id #uuid "2fad0001-76e0-5670-b0d2-73c03ac01d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704391} {:answer/id #uuid "4119dbef-9674-589f-8ad9-90d64e9f4d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704396} {:answer/id #uuid "4e21047b-fc02-5d4c-9787-683bafb81980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186704399} {:answer/id #uuid "cd67c6ef-6ac5-5bfc-b10b-f6b84f5af577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704414}] :answer-field/correct {:answer/id #uuid "1d70c3a0-22aa-5b1b-b16f-da791bb42bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186704387} :answer-field/id #uuid "1010b3b0-6428-5031-ba0f-7f613b37cb14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704386}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "744ecaa5-6d28-55ef-8866-e937c7b43ecb" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-1 & - \\frac{1}{2} & -1 & -1 \\\\ 0 & 0 & 0 & -1 \\\\ -2 & 0 & 0 & 2 \\\\ -1 & -2 & 1 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{2+4}\\begin{vmatrix}-1 & - \\frac{1}{2} & -1 \\\\ -2 & 0 & 0 \\\\ -1 & -2 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+1}\\begin{vmatrix}- \\frac{1}{2} & -1 \\\\ -2 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 1.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}- \\frac{1}{2} & -1 \\\\ -2 & 1\\end{vmatrix} \\\\ &=\\left(- \\frac{1}{2}\\right)(1)-(-1)(-2) \\\\ &=- \\frac{5}{2}.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+1}\\left(- \\frac{5}{2}\\right) \\\\ &=-5.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{2+4}(-5) \\\\ &=5.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=5$."}] [{:db/id #edb/ref 17592186704421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020bb060-10e7-5b61-a37b-5c9cddf61c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704419} {:answer/id #uuid "05fc86f3-2513-57cc-a9cb-15dae93f7c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704420} {:answer/id #uuid "879c2284-b918-5aac-b628-ab01b9a01260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704429} {:answer/id #uuid "9546e3ec-4c09-5efc-a551-3af4deb0203b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704431} {:answer/id #uuid "ad9ce7b6-2fb0-5cd0-a62f-e3d720682201" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704434}] :answer-field/correct {:answer/id #uuid "05fc86f3-2513-57cc-a9cb-15dae93f7c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704420} :answer-field/id #uuid "15302738-55c4-596b-8f91-13991b5c440c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704422}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0fab570c-8bd2-5bf1-8911-22ecd1914d6a" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & 2 & 1 & -1 \\\\ 1 & 3 & 2 & 0 \\\\ 0 & 3 & -2 & 0 \\\\ 0 & 0 & -2 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along column 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{1+4}\\begin{vmatrix}1 & 3 & 2 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}1 & 3 & 2 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -2\\end{vmatrix} \\\\ &=(1)\\cdot(3)\\cdot(-2) \\\\ &=-6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{1+4}(-6) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-6$."}] [{:db/id #edb/ref 17592186704424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e65ef6-e044-51a0-bf5c-07faf3182555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704423} {:answer/id #uuid "66360cf9-99c7-5a89-855d-430f5099d3ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704426} {:answer/id #uuid "9c29c588-4aa0-5294-8c29-ec32ce339ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704432} {:answer/id #uuid "9c8694a0-1a90-52dc-86f2-3e0d11c85609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704433} {:answer/id #uuid "e52a280a-95e0-5e57-a0bc-666805eede59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704445}] :answer-field/correct {:answer/id #uuid "20e65ef6-e044-51a0-bf5c-07faf3182555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704423} :answer-field/id #uuid "dc83ca58-540c-5eab-a3d4-cc640f9df767" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704444}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "38f78fea-a626-5841-9772-48532c5c45b8" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}1 & -1 & 0 & 0 \\\\ -1 & -3 & -1 & 0 \\\\ -2 & -2 & 3 & -2 \\\\ 1 & 0 & 0 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 4; only 1 nonzero entry contributes.\n\n$$\nD=(1)(-1)^{4+1}\\begin{vmatrix}-1 & 0 & 0 \\\\ -3 & -1 & 0 \\\\ -2 & 3 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}-1 & 0 & 0 \\\\ -3 & -1 & 0 \\\\ -2 & 3 & -2\\end{vmatrix} \\\\ &=(-1)\\cdot(-1)\\cdot(-2) \\\\ &=-2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(1)(-1)^{4+1}(-2) \\\\ &=2.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=2$."}] [{:db/id #edb/ref 17592186704438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b5a742d-29a1-5970-b231-6ecd7e2c2484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704425} {:answer/id #uuid "7337fa5c-29cf-5b05-b43c-9d2f7e3669f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704428} {:answer/id #uuid "90389884-7478-5b57-a04b-34f0ee8c5481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704430} {:answer/id #uuid "b8b39029-9dbf-545b-8078-6a54e7b7c664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186704437} {:answer/id #uuid "cbc1447d-0bff-529b-a62f-60637fbd6397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186704441}] :answer-field/correct {:answer/id #uuid "7337fa5c-29cf-5b05-b43c-9d2f7e3669f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704428} :answer-field/id #uuid "d2ce3ad3-207c-5f83-884e-8a6fd2079c3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704443}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "be42bff7-3e35-5e00-aabd-5902ea02c85a" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-1 & 2 & 2 & 1 \\\\ -2 & 0 & 3 & 3 \\\\ -1 & 0 & 0 & -2 \\\\ -2 & 0 & 0 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 4; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{4+1}\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & -2\\end{vmatrix} \\\\ &=(2)\\cdot(3)\\cdot(-2) \\\\ &=-12.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{4+1}(-12) \\\\ &=-24.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-24$."}] [{:db/id #edb/ref 17592186704442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2002381-5da8-5a6d-8a89-c0bfa3a3eaea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-81" :db/id #edb/ref 17592186704435} {:answer/id #uuid "b436d5ef-2cd9-5933-8063-5a4b6e8d0576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704436} {:answer/id #uuid "bf25fcf9-64cb-58d7-8a92-fffbd2342bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704439} {:answer/id #uuid "c14e284f-dea5-5618-bd15-5f9ee1408ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186704440} {:answer/id #uuid "fac05fd5-2d31-5b3d-9f78-c5446c0f2b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186704446}] :answer-field/correct {:answer/id #uuid "fac05fd5-2d31-5b3d-9f78-c5446c0f2b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186704446} :answer-field/id #uuid "67c9e640-ea34-5044-a804-5365830157d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd6c25b7-82b1-5674-a549-fd1555cd26ba" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 3 & -1 & -1 \\\\ 0 & 0 & 3 & 2\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 2, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD=(-3)(-1)^{2+4}\\begin{vmatrix}-3 & -1 & 1 \\\\ 0 & 3 & -1 \\\\ 0 & 0 & 3\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}-3 & -1 & 1 \\\\ 0 & 3 & -1 \\\\ 0 & 0 & 3\\end{vmatrix} \\\\ &=(-3)\\cdot(3)\\cdot(3) \\\\ &=-27.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{2+4}(-27) \\\\ &=81.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=81$."}] [{:db/id #edb/ref 17592186704534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ad09dd-5090-53a4-bb8c-9040f6998812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704543} {:answer/id #uuid "bbbb60b9-f607-5a92-bed2-8ec04d86e803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704546} {:answer/id #uuid "d095374a-601c-50ba-92ab-688a2085cd06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186704548} {:answer/id #uuid "d1e691b0-5e54-5cc7-9039-6185ffcd4601" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186704549} {:answer/id #uuid "f608d31f-35c8-5971-83ee-1306f2e96770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704556}] :answer-field/correct {:answer/id #uuid "d095374a-601c-50ba-92ab-688a2085cd06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186704548} :answer-field/id #uuid "69437ce8-3833-5f4a-815e-517c3d5b4987" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704540}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2cdd9e81-e911-5932-b8a8-e9d8825a6ac9" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 2 & 2 \\\\ 1 & -2 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{1+1}\\begin{vmatrix}1 & 0 & -3 \\\\ 0 & 2 & 2 \\\\ -2 & 0 & 0\\end{vmatrix} \\\\ &\\quad +(1)(-1)^{4+1}\\begin{vmatrix}0 & 1 & 0 \\\\ 1 & 0 & -3 \\\\ 0 & 2 & 2\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 1, and $D_{2}$ for the minor obtained by deleting row 4 and column 1.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(2)(-1)^{2+2}\\begin{vmatrix}1 & -3 \\\\ -2 & 0\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}1 & -3 \\\\ -2 & 0\\end{vmatrix} \\\\ &=(1)(0)-(-3)(-2) \\\\ &=-6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(2)(-1)^{2+2}(-6) \\\\ &=-12.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(1)(-1)^{2+1}\\begin{vmatrix}1 & 0 \\\\ 2 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 2 and column 1.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}1 & 0 \\\\ 2 & 2\\end{vmatrix} \\\\ &=(1)(2)-(0)(2) \\\\ &=2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(1)(-1)^{2+1}(2) \\\\ &=-2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{1+1}(-12)+(1)(-1)^{4+1}(-2) \\\\ &=38.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=38$."}] [{:db/id #edb/ref 17592186704547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "223b931c-b0d0-5e9c-ac82-8129e440bd53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704533} {:answer/id #uuid "314857d8-9db1-5184-bcc0-d60a84fc6f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186704535} {:answer/id #uuid "50c80433-d412-58eb-8c2c-04729e76cf38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704536} {:answer/id #uuid "595dc589-90a5-5a9a-b06c-ddb7bd788c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186704538} {:answer/id #uuid "d41763f7-88c1-52bf-8c4e-b6374619c914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186704550}] :answer-field/correct {:answer/id #uuid "595dc589-90a5-5a9a-b06c-ddb7bd788c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186704538} :answer-field/id #uuid "a065bec3-7535-5103-a6d7-5cba158dcf53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704544}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2a7b07a-e881-5538-b894-061c5483b2f7" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}2 & -1 & 0 & 0 \\\\ 0 & 0 & -1 & 2 \\\\ -3 & 0 & -1 & 0 \\\\ 0 & -2 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+4}\\begin{vmatrix}2 & -1 & 0 \\\\ -3 & 0 & -1 \\\\ 0 & -2 & 0\\end{vmatrix} \\\\ &\\quad +(-3)(-1)^{4+4}\\begin{vmatrix}2 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -3 & 0 & -1\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4, and $D_{2}$ for the minor obtained by deleting row 4 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-1)(-1)^{2+3}\\begin{vmatrix}2 & -1 \\\\ 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & -1 \\\\ 0 & -2\\end{vmatrix} \\\\ &=(2)(-2)-(-1)(0) \\\\ &=-4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-1)(-1)^{2+3}(-4) \\\\ &=-4.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(-1)(-1)^{1+2}\\begin{vmatrix}0 & -1 \\\\ -3 & -1\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 1 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}0 & -1 \\\\ -3 & -1\\end{vmatrix} \\\\ &=(0)(-1)-(-1)(-3) \\\\ &=-3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(-1)(-1)^{1+2}(-3) \\\\ &=-3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+4}(-4)+(-3)(-1)^{4+4}(-3) \\\\ &=1.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=1$."}] [{:db/id #edb/ref 17592186704554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08986ba9-269c-5f9c-a4da-571c81113de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704530} {:answer/id #uuid "531c3eb7-f203-5d62-9e9e-ce6fed848c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186704537} {:answer/id #uuid "7206e007-85c2-5891-8852-ae92fbb3d8ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704541} {:answer/id #uuid "e1008537-8552-5d58-9ab7-2a10c48c01ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186704552} {:answer/id #uuid "ee7b1374-2dec-5455-a882-49269febc8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704555}] :answer-field/correct {:answer/id #uuid "531c3eb7-f203-5d62-9e9e-ce6fed848c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186704537} :answer-field/id #uuid "adf305a7-b2d6-51b2-a9a7-b60bfbe71582" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704545}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e7c50abb-3dea-5f9e-8553-e44ec7cfa578" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}3 & -1 & 0 & 0 \\\\ 2 & 0 & 0 & 2 \\\\ 0 & 0 & 2 & -2 \\\\ 0 & 2 & -2 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+1}\\begin{vmatrix}-1 & 0 & 0 \\\\ 0 & 2 & -2 \\\\ 2 & -2 & 0\\end{vmatrix} \\\\ &\\quad +(2)(-1)^{2+4}\\begin{vmatrix}3 & -1 & 0 \\\\ 0 & 0 & 2 \\\\ 0 & 2 & -2\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 1, and $D_{2}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+3}\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix} \\\\ &=(-1)(-2)-(0)(2) \\\\ &=2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+3}(2) \\\\ &=4.\\end{aligned}\n$$\n\nExpand $D_{2}$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(2)(-1)^{2+3}\\begin{vmatrix}3 & -1 \\\\ 0 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}3 & -1 \\\\ 0 & 2\\end{vmatrix} \\\\ &=(3)(2)-(-1)(0) \\\\ &=6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(2)(-1)^{2+3}(6) \\\\ &=-12.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+1}(4)+(2)(-1)^{2+4}(-12) \\\\ &=-32.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-32$."}] [{:db/id #edb/ref 17592186704557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161269f0-a160-5704-a88e-6a6ff299ef56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186704531} {:answer/id #uuid "1ef3cc63-90f2-5b33-8b82-22ac9275937c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186704532} {:answer/id #uuid "7e8012c8-7641-5dc5-a5fb-579a4259517a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704542} {:answer/id #uuid "d532ca2b-3247-5e6a-9d84-3527c3206804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186704551} {:answer/id #uuid "e375ac85-0a30-5bbd-abf2-a0f3bc2d4e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186704553}] :answer-field/correct {:answer/id #uuid "1ef3cc63-90f2-5b33-8b82-22ac9275937c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186704532} :answer-field/id #uuid "6177ca0d-04d3-5d48-bb69-6bb27eb91ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704539}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f8940873-a3cb-5e97-bc5f-3f853d67c84e" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-2 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 3 \\\\ -3 & -2 & 0 & 0 \\\\ 0 & -3 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(3)(-1)^{2+4}\\begin{vmatrix}-2 & 0 & -1 \\\\ -3 & -2 & 0 \\\\ 0 & -3 & 0\\end{vmatrix} \\\\ &\\quad +(1)(-1)^{4+4}\\begin{vmatrix}-2 & 0 & -1 \\\\ 0 & 0 & -2 \\\\ -3 & -2 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4, and $D_{2}$ for the minor obtained by deleting row 4 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-1)(-1)^{1+3}\\begin{vmatrix}-3 & -2 \\\\ 0 & -3\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 1 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}-3 & -2 \\\\ 0 & -3\\end{vmatrix} \\\\ &=(-3)(-3)-(-2)(0) \\\\ &=9.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-1)(-1)^{1+3}(9) \\\\ &=-9.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(-2)(-1)^{3+2}\\begin{vmatrix}-2 & -1 \\\\ 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 3 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}-2 & -1 \\\\ 0 & -2\\end{vmatrix} \\\\ &=(-2)(-2)-(-1)(0) \\\\ &=4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(-2)(-1)^{3+2}(4) \\\\ &=8.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(3)(-1)^{2+4}(-9)+(1)(-1)^{4+4}(8) \\\\ &=-19.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-19$."}]}
