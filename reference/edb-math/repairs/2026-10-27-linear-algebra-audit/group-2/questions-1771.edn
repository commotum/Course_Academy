81ff-5434-be8f-00b07d0775b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703884}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f81b4107-97bd-5cb6-9c1e-e455143c083a" :question/problem "Given that $D=3I$, where $I$ is the $3\\times 3$ identity matrix, find $\\det(D)$." :question/worked-solution "First write the scalar multiple of the identity matrix:\n\n$$\nD=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}.\n$$\n\nThe matrix $D$ is diagonal. Its determinant is the product of the main diagonal entries:\n\n$$\n\\det(D)=3\\cdot3\\cdot3=27.\n$$"}] [{:db/id #edb/ref 17592186703920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aab41d56-38ce-50e1-bcfc-b42193b50bf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186703930} {:answer/id #uuid "b152f7be-e9a7-5413-9dbe-4b68ea60c33a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186703932} {:answer/id #uuid "b99de4b2-c3fb-5797-9a05-2a1ad8cf95df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186703933} {:answer/id #uuid "d4848bf7-5293-51e3-9bf2-e9657eb0464a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703936} {:answer/id #uuid "fb37f727-118c-5f22-8ea3-2a50b41cc2c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186703941}] :answer-field/correct {:answer/id #uuid "d4848bf7-5293-51e3-9bf2-e9657eb0464a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703936} :answer-field/id #uuid "4ca1a071-006c-5f06-baaa-7e04e56ac29c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703921}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3a2ad1c4-6948-53e0-8e71-68653016bb6e" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T+B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-3 & 0 & 0 \\\\ -2 & -3 & 0 \\\\ 1 & -2 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -2 & 4 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}-3 & -2 & 1 \\\\ 0 & -3 & -2 \\\\ 0 & 0 & -2\\end{bmatrix},\\\\B&=\\begin{bmatrix}0 & -2 & 4 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T+B&=\\begin{bmatrix}-3+0 & -2+(-2) & 1+4 \\\\ 0+0 & -3+3 & -2+2 \\\\ 0+0 & 0+0 & -2+1\\end{bmatrix}\\\\&=\\begin{bmatrix}-3 & -4 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T+B)=(-3)\\cdot0\\cdot(-1)=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."}] [{:db/id #edb/ref 17592186703923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f310f0-54f1-5d2e-822f-d9e071439aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703914} {:answer/id #uuid "312f2a19-b45c-5759-8136-f4e22ce808e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186703918} {:answer/id #uuid "33dfdc5d-8490-5de5-8326-3892c170b121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186703919} {:answer/id #uuid "93ce436c-b0f9-598a-ba55-ef878e592bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703926} {:answer/id #uuid "97fef6fe-1d50-5c3b-92de-0e281d38b3f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703927}] :answer-field/correct {:answer/id #uuid "93ce436c-b0f9-598a-ba55-ef878e592bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703926} :answer-field/id #uuid "89f20267-8654-5925-8640-c3c912eaceb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703924}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7e2e4c7a-0012-55b8-b741-ae28e99a6fe6" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T-B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}2 & 4 & 3 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}2 & 0 & 0 \\\\ 4 & 2 & 0 \\\\ 3 & 1 & 1\\end{bmatrix},\\\\B&=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T-B&=\\begin{bmatrix}2-2 & 0-0 & 0-0 \\\\ 4-0 & 2-1 & 0-0 \\\\ 3-1 & 1-1 & 1-(-1)\\end{bmatrix}\\\\&=\\begin{bmatrix}0 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T-B)=0\\cdot1\\cdot2=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."}] [{:db/id #edb/ref 17592186703935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14331b3a-ac10-50c9-b8d1-2dc33dff756b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703915} {:answer/id #uuid "1ef909a3-64fa-582d-8692-7049bd3f95c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703916} {:answer/id #uuid "53cb12a1-3d5c-521e-9df3-51c168362372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186703922} {:answer/id #uuid "afb2df77-4140-5e2b-ab60-6b7061ef1b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186703931} {:answer/id #uuid "da4c8162-ecc9-56ef-82bb-5205753eb07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186703938}] :answer-field/correct {:answer/id #uuid "53cb12a1-3d5c-521e-9df3-51c168362372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186703922} :answer-field/id #uuid "bf907172-fa08-586c-a5f9-d22981535210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703934}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c671e697-6b85-5b40-8e67-3ac53e085961" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T+B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}3 & 2 & 0 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 3 & 0 \\\\ -4 & -2 & -3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}3 & 0 & 0 \\\\ 2 & 3 & 0 \\\\ 0 & -2 & -1\\end{bmatrix},\\\\B&=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 3 & 0 \\\\ -4 & -2 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T+B&=\\begin{bmatrix}3+(-2) & 0+0 & 0+0 \\\\ 2+(-1) & 3+3 & 0+0 \\\\ 0+(-4) & -2+(-2) & -1+(-3)\\end{bmatrix}\\\\&=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 6 & 0 \\\\ -4 & -4 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T+B)=1\\cdot6\\cdot(-4)=-24.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."}] [{:db/id #edb/ref 17592186703940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d9782b8-e60f-5a0a-8750-f220fde38f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703917} {:answer/id #uuid "90f8d54b-2b1b-5eae-8977-2d280cc09f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186703925} {:answer/id #uuid "9a492d59-419e-5977-997e-eee46e3d6a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186703929} {:answer/id #uuid "d604f003-03db-5471-ab4b-67944e737cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186703937} {:answer/id #uuid "e485497e-e8ac-571c-a9f5-c06ec22ea7c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703939}] :answer-field/correct {:answer/id #uuid "2d9782b8-e60f-5a0a-8750-f220fde38f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703917} :answer-field/id #uuid "986a74e3-202d-587c-a733-248692740f8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703928}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "eeba27d7-4691-55eb-9b70-698616fcfa42" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A+B^T)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -2 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 4 & 4 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A&=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -2 & -2\\end{bmatrix},\\\\B^T&=\\begin{bmatrix}-2 & 0 & 0 \\\\ 4 & -1 & 0 \\\\ 4 & -2 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A+B^T&=\\begin{bmatrix}-2+(-2) & 0+0 & 0+0 \\\\ -1+4 & 1+(-1) & 0+0 \\\\ 1+4 & -2+(-2) & -2+(-1)\\end{bmatrix}\\\\&=\\begin{bmatrix}-4 & 0 & 0 \\\\ 3 & 0 & 0 \\\\ 5 & -4 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A+B^T)=(-4)\\cdot0\\cdot(-3)=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."}] [{:db/id #edb/ref 17592186704108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80827421-5b8f-5346-b596-655199ba1920" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704140} {:answer/id #uuid "e9b1df02-8de7-58ec-b395-1a177e8522e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704161}] :answer-field/correct {:answer/id #uuid "e9b1df02-8de7-58ec-b395-1a177e8522e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704161} :answer-field/id #uuid "30d60d32-f8b2-5a39-ab87-596eedd3987a" :answer-field/key "$\\det(K)+2\\det(I)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704118} {:answer-field/choices [{:answer/id #uuid "7797d9af-7511-5042-9eb1-5f5ed3a844ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704136} {:answer/id #uuid "f9add759-d121-5f53-9d2f-6e8f283a017b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704166}] :answer-field/correct {:answer/id #uuid "f9add759-d121-5f53-9d2f-6e8f283a017b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704166} :answer-field/id #uuid "34d3027c-4e05-5f19-a96b-bd7ea172b293" :answer-field/key "$2\\det(K^T)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704119} {:answer-field/choices [{:answer/id #uuid "48dfce0a-167a-5024-820c-0c8478b63200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704129} {:answer/id #uuid "57590754-b30f-58ff-be31-7584f791bdb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704131}] :answer-field/correct {:answer/id #uuid "48dfce0a-167a-5024-820c-0c8478b63200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704129} :answer-field/id #uuid "b0a60748-8c38-556d-a22e-dd44206b9151" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704152} {:answer-field/choices [{:answer/id #uuid "3adfb975-6f59-56a6-9579-a99796420353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704124} {:answer/id #uuid "e4299717-87fd-5684-93d0-70fc48047d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704159}] :answer-field/correct {:answer/id #uuid "e4299717-87fd-5684-93d0-70fc48047d58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704159} :answer-field/id #uuid "ecb6a80a-d94c-597f-96db-dbbb3e929c49" :answer-field/key "$2\\det(K^T)-2\\det(K)=-12$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704162}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "030d9562-fea6-5f02-81c6-f82039858fa3" :question/problem "Let $K$ be a square matrix with $\\det(K^T)=-3$, and let $I$ be the identity matrix of the same size.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(K^T)&=\\det(K)=-3 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $2\\det(K^T)=-3$,\n\n$$\n2\\det(K^T)=2(-3)=-6\\ne -3.\n$$\n\nThis statement is **false**.\n\nFor $\\det(K)+2\\det(I)=-3$,\n\n$$\n\\det(K)+2\\det(I)=(-3)+2(1)=-1\\ne -3.\n$$\n\nThis statement is **false**.\n\nFor $2\\det(K^T)-2\\det(K)=-12$,\n\n$$\n2\\det(K^T)-2\\det(K)=2(-3)-2(-3)=0\\ne -12.\n$$\n\nThis statement is **false**.\n\nAll three mathematical statements are false. Select **None of the above** only."}] [{:db/id #edb/ref 17592186704132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "461db137-de97-5140-8981-679f34e5505e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704128} {:answer/id #uuid "7c9351bc-7bee-5ca3-b28d-3450b8807880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704139}] :answer-field/correct {:answer/id #uuid "461db137-de97-5140-8981-679f34e5505e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704128} :answer-field/id #uuid "031fdbe9-a320-5847-9905-e5e737e5161a" :answer-field/key "$-\\det(M^T)-\\det(M)=8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704109} {:answer-field/choices [{:answer/id #uuid "1bcdc626-9ac1-50f4-923f-f6140f4aab9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704116} {:answer/id #uuid "c26b847e-9136-58b8-9eb0-9beffc63ba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704155}] :answer-field/correct {:answer/id #uuid "c26b847e-9136-58b8-9eb0-9beffc63ba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704155} :answer-field/id #uuid "413ed835-432d-5e17-bf89-ffcab6fe0b49" :answer-field/key "$3\\det(M^T)=-4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704126} {:answer-field/choices [{:answer/id #uuid "dc03ff67-5775-5c3f-8b62-3f2822dcc5fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704157} {:answer/id #uuid "f7801315-441b-5661-8e0c-bef506420bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704164}] :answer-field/correct {:answer/id #uuid "f7801315-441b-5661-8e0c-bef506420bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704164} :answer-field/id #uuid "8fefeba1-b760-593d-8928-6eeb22145ca1" :answer-field/key "$\\det(M)-3\\det(I)=-7$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704144}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60a1b666-7b04-5b60-b241-ca418a7dc688" :question/problem "Let $M$ be a square matrix with $\\det(M)=-4$, and let $I$ be the identity matrix of the same size.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(M^T)&=\\det(M)=-4 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $3\\det(M^T)=-4$,\n\n$$\n3\\det(M^T)=3(-4)=-12\\ne -4.\n$$\n\nThis statement is **false**.\n\nFor $\\det(M)-3\\det(I)=-7$,\n\n$$\n\\det(M)-3\\det(I)=(-4)-3(1)=-7.\n$$\n\nThis statement is **true**.\n\nFor $-\\det(M^T)-\\det(M)=8$,\n\n$$\n-\\det(M^T)-\\det(M)=-(-4)-(-4)=8.\n$$\n\nThis statement is **true**.\n\nSelect $\\det(M)-3\\det(I)=-7$, $-\\det(M^T)-\\det(M)=8$."}] [{:db/id #edb/ref 17592186704145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "788110af-02dd-5f7d-bd83-388c2540ceac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704137} {:answer/id #uuid "9ba0a69d-3256-51d8-96a4-d30816e43d82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704147}] :answer-field/correct {:answer/id #uuid "9ba0a69d-3256-51d8-96a4-d30816e43d82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704147} :answer-field/id #uuid "078685bd-f77f-51b5-986b-0896047cbbd6" :answer-field/key "$-\\det(K^T)+\\det(K)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704110} {:answer-field/choices [{:answer/id #uuid "1a631dfe-bab3-5209-b6ab-bd4ed8a5b213" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704115} {:answer/id #uuid "f6c4963c-7463-53bd-b2e1-063d8d00a8af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704163}] :answer-field/correct {:answer/id #uuid "f6c4963c-7463-53bd-b2e1-063d8d00a8af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704163} :answer-field/id #uuid "0a972db2-b781-5b91-9bce-d5e0536f3256" :answer-field/key "$3\\det(K^T)=18$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704111} {:answer-field/choices [{:answer/id #uuid "1880b015-4c51-5ace-b9c8-c7cc226e4af3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704114} {:answer/id #uuid "4b01baee-4db4-5363-b5aa-231bac5abf4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704130}] :answer-field/correct {:answer/id #uuid "4b01baee-4db4-5363-b5aa-231bac5abf4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704130} :answer-field/id #uuid "83e48df1-d5eb-5c10-ae0b-1ad20e8d7acd" :answer-field/key "$\\det(K)-2\\det(I)=-6$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704142} {:answer-field/choices [{:answer/id #uuid "6ceafd0d-2f56-5e89-b7ba-7643cb011e04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704133} {:answer/id #uuid "aca51fec-5e4f-5b68-bb96-ef47c258fe8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704151}] :answer-field/correct {:answer/id #uuid "aca51fec-5e4f-5b68-bb96-ef47c258fe8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704151} :answer-field/id #uuid "f8177f93-7104-5118-8163-79e13726771f" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704165}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93bfcc15-649b-5f74-978b-a5cffd6ab846" :question/problem "Let $K$ be a square matrix with $\\det(K)=-6$, and let $I$ be the identity matrix of the same size.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(K^T)&=\\det(K)=-6 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $3\\det(K^T)=18$,\n\n$$\n3\\det(K^T)=3(-6)=-18\\ne 18.\n$$\n\nThis statement is **false**.\n\nFor $\\det(K)-2\\det(I)=-6$,\n\n$$\n\\det(K)-2\\det(I)=(-6)-2(1)=-8\\ne -6.\n$$\n\nThis statement is **false**.\n\nFor $-\\det(K^T)+\\det(K)=0$,\n\n$$\n-\\det(K^T)+\\det(K)=-(-6)+(-6)=0.\n$$\n\nThis statement is **true**.\n\nSelect $-\\det(K^T)+\\det(K)=0$. **None of the above** is false."}] [{:db/id #edb/ref 17592186704156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e0ec824-5d1f-5965-89f2-a6c22b8ca50f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704134} {:answer/id #uuid "de427e5d-ff51-5347-971e-de6f6a11aa03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704158}] :answer-field/correct {:answer/id #uuid "6e0ec824-5d1f-5965-89f2-a6c22b8ca50f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704134} :answer-field/id #uuid "