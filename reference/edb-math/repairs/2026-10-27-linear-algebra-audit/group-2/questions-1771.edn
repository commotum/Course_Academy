86045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704184} :answer-field/id #uuid "ae9f8fdb-aad4-5613-9a96-ff3a773f842f" :answer-field/key "$\\det(B^T)+\\det(I)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704202}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4e334824-1c85-56e6-8104-521b5a84320f" :question/problem "Let $B$ be a square matrix with $\\det(B)=-7$, and let $I$ be the identity matrix of the same size.\n\nRecall that transposing a matrix leaves its determinant unchanged and that $\\det(I)=1$.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(B^T)&=\\det(B)=-7 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $\\det(B^T)=0$,\n\n$$\n\\det(B^T)=(-7)=-7\\ne 0.\n$$\n\nThis statement is **false**.\n\nFor $\\det(I)=1$,\n\n$$\n\\det(I)=(1)=1.\n$$\n\nThis statement is **true**.\n\nFor $\\det(B^T)+\\det(I)=1$,\n\n$$\n\\det(B^T)+\\det(I)=(-7)+(1)=-6\\ne 1.\n$$\n\nThis statement is **false**.\n\nSelect $\\det(I)=1$. **None of the above** is false."}] [{:db/id #edb/ref 17592186704194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8250a030-4cc9-5644-affa-ead609669cad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704192} {:answer/id #uuid "eaaf8499-c3e6-51ff-bea0-60cd17bb3c16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704208}] :answer-field/correct {:answer/id #uuid "8250a030-4cc9-5644-affa-ead609669cad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704192} :answer-field/id #uuid "4c19f0e3-00e0-5ae7-9719-8702bd98227c" :answer-field/key "$\\det(B^T)=-3$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704179} {:answer-field/choices [{:answer/id #uuid "210ca506-e56b-5b78-aebe-bcf1e2d1a36a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704174} {:answer/id #uuid "f274ad28-9f0e-57fe-b1cc-2fb6556cdaf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704211}] :answer-field/correct {:answer/id #uuid "f274ad28-9f0e-57fe-b1cc-2fb6556cdaf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704211} :answer-field/id #uuid "4f97bf57-25ff-59b2-b118-9d37534f5c10" :answer-field/key "$\\det(B^T)+\\det(I)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704182} {:answer-field/choices [{:answer/id #uuid "03615669-9a60-5fcb-821c-9247de2a768c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704169} {:answer/id #uuid "beb65ef9-a65d-5984-83e0-bf450764b52e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704203}] :answer-field/correct {:answer/id #uuid "03615669-9a60-5fcb-821c-9247de2a768c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704169} :answer-field/id #uuid "7ce629fb-c256-50e7-b36d-cc32939ac454" :answer-field/key "$\\det(I)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704191}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85db6eb2-20ce-53e7-b285-2dadc1321933" :question/problem "Let $B$ be a square matrix with $\\det(B)=-3$, and let $I$ be the identity matrix of the same size.\n\nRecall that transposing a matrix leaves its determinant unchanged and that $\\det(I)=1$.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(B^T)&=\\det(B)=-3 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $\\det(B^T)=-3$,\n\n$$\n\\det(B^T)=(-3)=-3.\n$$\n\nThis statement is **true**.\n\nFor $\\det(I)=1$,\n\n$$\n\\det(I)=(1)=1.\n$$\n\nThis statement is **true**.\n\nFor $\\det(B^T)+\\det(I)=0$,\n\n$$\n\\det(B^T)+\\det(I)=(-3)+(1)=-2\\ne 0.\n$$\n\nThis statement is **false**.\n\nSelect $\\det(B^T)=-3$, $\\det(I)=1$."}] [{:db/id #edb/ref 17592186704195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a3bc34d-a4e8-524c-bfda-825cec3d05cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704175} {:answer/id #uuid "7713da0f-1a08-546b-9891-8e4644af6da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704190}] :answer-field/correct {:answer/id #uuid "7713da0f-1a08-546b-9891-8e4644af6da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704190} :answer-field/id #uuid "01b47efe-7135-5cbb-aec5-40f896baab76" :answer-field/key "$\\det(B^T)-\\det(I)=-9$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704168} {:answer-field/choices [{:answer/id #uuid "52869827-7be4-505c-a4cd-a766e7f18803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704183} {:answer/id #uuid "5897ccdf-cef2-5229-8695-afccf1b3625a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704186}] :answer-field/correct {:answer/id #uuid "52869827-7be4-505c-a4cd-a766e7f18803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704183} :answer-field/id #uuid "17a621d7-e5af-5d9e-99df-47e84774402c" :answer-field/key "$\\det(I)=4$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704172} {:answer-field/choices [{:answer/id #uuid "0ecca450-a4cf-5354-a029-78b41c3689a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704171} {:answer/id #uuid "c0f37145-c57f-51d3-a2b2-d0e1cb5b2d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704204}] :answer-field/correct {:answer/id #uuid "c0f37145-c57f-51d3-a2b2-d0e1cb5b2d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704204} :answer-field/id #uuid "a2a6dd05-2ef0-5a4d-a2fb-d292db42928e" :answer-field/key "$\\det(B^T)=-8$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704201}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8882e373-b8a0-5ad8-8325-a79d29bdf951" :question/problem "Let $B$ be a square matrix with $\\det(B)=-8$, and let $I$ be the identity matrix of the same size.\n\nRecall that transposing a matrix leaves its determinant unchanged and that $\\det(I)=1$.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(B^T)&=\\det(B)=-8 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $\\det(B^T)=-8$,\n\n$$\n\\det(B^T)=(-8)=-8.\n$$\n\nThis statement is **true**.\n\nFor $\\det(I)=4$,\n\n$$\n\\det(I)=(1)=1\\ne 4.\n$$\n\nThis statement is **false**.\n\nFor $\\det(B^T)-\\det(I)=-9$,\n\n$$\n\\det(B^T)-\\det(I)=(-8)-(1)=-9.\n$$\n\nThis statement is **true**.\n\nSelect $\\det(B^T)=-8$, $\\det(B^T)-\\det(I)=-9$."}] [{:db/id #edb/ref 17592186704210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b632a3-5ba7-5b4d-b041-1c8ebbeea7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704176} {:answer/id #uuid "9572ca87-21be-5eb0-8819-e28ef616ff3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704197}] :answer-field/correct {:answer/id #uuid "9572ca87-21be-5eb0-8819-e28ef616ff3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704197} :answer-field/id #uuid "097f47ba-5967-555b-9fa7-540c9b2ba431" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704170} {:answer-field/choices [{:answer/id #uuid "568fbd50-6845-59ae-8c59-32754cf89f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704185} {:answer/id #uuid "9c64454c-fa2c-5fbf-9d8e-0a70cc714d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704199}] :answer-field/correct {:answer/id #uuid "9c64454c-fa2c-5fbf-9d8e-0a70cc714d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704199} :answer-field/id #uuid "34ff3809-bb23-5ae0-b524-422cf386cf90" :answer-field/key "$\\det(I)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704177} {:answer-field/choices [{:answer/id #uuid "5b9d3f45-0100-5be9-9f25-5448343942f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704188} {:answer/id #uuid "c7b2bea8-b35a-5343-8287-623bd1bec84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704205}] :answer-field/correct {:answer/id #uuid "c7b2bea8-b35a-5343-8287-623bd1bec84d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704205} :answer-field/id #uuid "83a77022-87c6-5397-af6b-e82d77e2121f" :answer-field/key "$\\det(B^T)-\\det(I)=1$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704193} {:answer-field/choices [{:answer/id #uuid "4f68c482-e423-5eeb-bef3-672f502f4121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704181} {:answer/id #uuid "69dd1a9b-4926-5e19-9558-a7f54a698be1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704189}] :answer-field/correct {:answer/id #uuid "69dd1a9b-4926-5e19-9558-a7f54a698be1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704189} :answer-field/id #uuid "ec946599-232d-5eef-bef2-dd56ec29d925" :answer-field/key "$\\det(B^T)=0$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704209}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eeb72bd1-a741-5b28-9e0d-0b1bdb3aa074" :question/problem "Let $B$ be a square matrix with $\\det(B)=0$, and let $I$ be the identity matrix of the same size.\n\nRecall that transposing a matrix leaves its determinant unchanged and that $\\det(I)=1$.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(B^T)&=\\det(B)=0 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $\\det(B^T)=0$,\n\n$$\n\\det(B^T)=(0)=0.\n$$\n\nThis statement is **true**.\n\nFor $\\det(I)=0$,\n\n$$\n\\det(I)=(1)=1\\ne 0.\n$$\n\nThis statement is **false**.\n\nFor $\\det(B^T)-\\det(I)=1$,\n\n$$\n\\det(B^T)-\\det(I)=(0)-(1)=-1\\ne 1.\n$$\n\nThis statement is **false**.\n\nSelect $\\det(B^T)=0$. **None of the above** is false."}] [{:db/id #edb/ref 17592186704214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4398d6bc-928d-5f62-a985-9b2c125cec24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186704224} {:answer/id #uuid "65a83798-c150-5915-aa63-5c2634cd0573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704227} {:answer/id #uuid "78744a08-5dba-5cb4-ad4a-e4614372254f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704229} {:answer/id #uuid "ac1ef642-cb73-501a-ac06-2d1a7082b198" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186704237} {:answer/id #uuid "c528a85b-adfc-5ed5-a8e9-92425b500451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186704243}] :answer-field/correct {:answer/id #uuid "65a83798-c150-5915-aa63-5c2634cd0573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704227} :answer-field/id #uuid "7ba2d121-5a52-57cc-b274-bd496df29d72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704230}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "074e6459-9745-5e96-8c1a-f4f1590214b1" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}-2 \\\\ -3 \\\\ 3 \\\\ 2\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}0 \\\\ 1 \\\\ -3 \\\\ -1\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}0 \\\\ 4 \\\\ 0 \\\\ -4\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}-2 & 0 & 0 & 0 \\\\ -3 & 1 & 1 & 4 \\\\ 3 & -3 & 0 & 0 \\\\ 2 & -1 & 0 & -4\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along column $3$, retaining the cofactor signs.\n\n$$\n\\det(M)=1(-1)^{2+3}D_{1}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}-2 & 0 & 0 \\\\ 3 & -3 & 0 \\\\ 2 & -1 & -4\\end{vmatrix}.\n$$\n\nThis matrix is triangular, so multiply its diagonal entries.\n\n$$\nD_{1}=(-2)\\cdot (-3)\\cdot (-4)=-24.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=(-1)\\cdot (-24)=24.\n$$\n\nTherefore,\n\n$$\nV=|24|=24.\n$$"}] [{:db/id #edb/ref 17592186704231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f0b6db-9b2d-5324-ac9f-3aa1fe394c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704215} {:answer/id #uuid "1dc1dd64-a799-5d62-b324-ffa2a26a2896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186704221} {:answer/id #uuid "778865f2-2fef-5374-ad1d-e77242e7fc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186704228} {:answer/id #uuid "bc5b27f7-2e6a-59b5-9ee8-8d5aa7eb7ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186704240} {:answer/id #uuid "c81bff2c-3bc0-5cc9-b812-63fc66ef8503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704244}] :answer-field/correct {:answer/id #uuid "07f0b6db-9b2d-5324-ac9f-3aa1fe394c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704215} :answer-field/id #uuid "fa59a708-7cfb-5339-9c9c-e863df9dc95e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704248}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f29876a-cadf-5a2c-a2a6-6871f0037edc" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\n\\mathbf{a}=\\begin{bmatrix}2 \\\\ 0 \\\\ 0 \\\\ -4\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}-2 \\\\ -4 \\\\ 0 \\\\ -3\\end{bmatrix},\\quad \\mathbf{c}=\\begin{bmatrix}0 \\\\ 0 \\\\ 0 \\\\ -1\\end{bmatrix},\\quad \\mathbf{d}=\\begin{bmatrix}-4 \\\\ -1 \\\\ -2 \\\\ 1\\end{bmatrix}.\n$$" :question/worked-solution "Construct the matrix whose columns are the four vectors:\n\n$$\nM=\\begin{bmatrix}2 & -2 & 0 & -4 \\\\ 0 & -4 & 0 & -1 \\\\ 0 & 0 & 0 & -2 \\\\ -4 & -3 & -1 & 1\\end{bmatrix}.\n$$\n\nThe volume is the absolute value of its determinant:\n\n$$\nV=|\\det(M)|.\n$$\n\nExpand along column $3$, retaining the cofactor signs.\n\n$$\n\\det(M)=(-1)(-1)^{4+3}D_{1}.\n$$\n\nEvaluate the minor\n\n$$\nD_{1}=\\begin{vmatrix}2 & -2 & -4 \\\\ 0 & -4 & -1 \\\\ 0 & 0 & -2\\end{vmatrix}.\n$$\n\nThis matrix is triangular, so multiply its diagonal entries.\n\n$$\nD_{1}=2\\cdot (-4)\\cdot (-2)=16.\n$$\n\nCombine the signed contributions:\n\n$$\n\\det(M)=1\\cdot 16=16.\n$$\n\nTherefore,\n\n$$\nV=|16|=16.\n$$"}] [{:db/id #edb/ref 17592186704234 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a9f21a-f605-5182-813d-b11ac681088b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186704218} {:answer/id #uuid "25b