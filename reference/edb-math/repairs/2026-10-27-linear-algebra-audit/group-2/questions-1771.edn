/text} :answer/value "true" :db/id #edb/ref 17592186704123} {:answer/id #uuid "43e22a2b-f99d-5977-89b9-102e5d10246f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704127}] :answer-field/correct {:answer/id #uuid "38689c9d-c9e6-509b-9335-10a91a79ff98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704123} :answer-field/id #uuid "be512d4d-2ba8-5722-b35d-274d982b159e" :answer-field/key "$\\det(K)+3\\det(I)=5$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704154}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9725765-753b-50b9-a416-35590437137f" :question/problem "Let $K$ be a square matrix with $\\det(K^T)=2$, and let $I$ be the identity matrix of the same size.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(K^T)&=\\det(K)=2 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $-3\\det(K^T)=-6$,\n\n$$\n-3\\det(K^T)=-3(2)=-6.\n$$\n\nThis statement is **true**.\n\nFor $\\det(K)+3\\det(I)=5$,\n\n$$\n\\det(K)+3\\det(I)=(2)+3(1)=5.\n$$\n\nThis statement is **true**.\n\nFor $-\\det(K^T)-2\\det(K)=-2$,\n\n$$\n-\\det(K^T)-2\\det(K)=-(2)-2(2)=-6\\ne -2.\n$$\n\nThis statement is **false**.\n\nSelect $-3\\det(K^T)=-6$, $\\det(K)+3\\det(I)=5$. **None of the above** is false."}] [{:db/id #edb/ref 17592186704160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5237a2-5056-5510-9b99-178db645aefa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704117} {:answer/id #uuid "36984cca-bf2b-58a0-875c-bc9c89698ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704122}] :answer-field/correct {:answer/id #uuid "36984cca-bf2b-58a0-875c-bc9c89698ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704122} :answer-field/id #uuid "1633495c-4270-5351-96a0-2ac43ae199d8" :answer-field/key "$\\det(B)-3\\det(I)=-10$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704113} {:answer-field/choices [{:answer/id #uuid "81489982-8fcb-5dad-9668-28b2d521048d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704141} {:answer/id #uuid "86d61c8d-11c7-5fee-808d-3382785f04ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704143}] :answer-field/correct {:answer/id #uuid "86d61c8d-11c7-5fee-808d-3382785f04ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704143} :answer-field/id #uuid "3513635d-87b6-5d12-8eb1-f313e6274d67" :answer-field/key "$-\\det(B^T)+\\det(B)=-14$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704120} {:answer-field/choices [{:answer/id #uuid "1166a7ac-9356-51b1-a9a8-e0ff0ceee1b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704112} {:answer/id #uuid "9e7072bd-4962-5812-be0b-e109251ac8c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704148}] :answer-field/correct {:answer/id #uuid "1166a7ac-9356-51b1-a9a8-e0ff0ceee1b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704112} :answer-field/id #uuid "74342a70-9c57-567e-b8a2-37690ef2a910" :answer-field/key "$2\\det(B^T)=14$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704135}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e55a9c41-093e-58e1-95eb-ac209cb6bd37" :question/problem "Let $B$ be a square matrix with $\\det(B)=7$, and let $I$ be the identity matrix of the same size.\n\nWhich of the following statements are true? Select all that apply." :question/worked-solution "Transposition preserves the determinant, and the identity matrix has determinant $1$:\n\n$$\n\\begin{aligned}\\det(B^T)&=\\det(B)=7 \\\\ \\det(I)&=1.\\end{aligned}\n$$\n\nFor $2\\det(B^T)=14$,\n\n$$\n2\\det(B^T)=2(7)=14.\n$$\n\nThis statement is **true**.\n\nFor $\\det(B)-3\\det(I)=-10$,\n\n$$\n\\det(B)-3\\det(I)=(7)-3(1)=4\\ne -10.\n$$\n\nThis statement is **false**.\n\nFor $-\\det(B^T)+\\det(B)=-14$,\n\n$$\n-\\det(B^T)+\\det(B)=-(7)+(7)=0\\ne -14.\n$$\n\nThis statement is **false**.\n\nSelect $2\\det(B^T)=14$."}] [{:db/id #edb/ref 17592186704180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f84d8f4-292d-5e95-8ce2-7e388ccad6bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186704200} {:answer/id #uuid "f3d2eb64-c385-5317-b9aa-d5ed2c0f0993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704212}] :answer-field/correct {:answer/id #uuid "f3d2eb64-c385-5317-b9aa-d5ed2c0f0993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186704212} :answer-field/id #uuid "48b8c3bd-6ec4-5d60-8220-531dc085f641" :answer-field/key "None of the above" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186704178} {:answer-field/choices [{:answer/id #uuid "cf4d10f5-f498-5e57-a875-ce8103bd262b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.ty