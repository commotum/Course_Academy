(\\,8\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=3\\cdot {b}_{1}+8\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\n$$\n\nFinally, we have that ${x}_{1}=3.$"}] [{:db/id #edb/ref 17592186247249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084c18f2-f67b-5e04-b240-8825360f865a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186244379} {:answer/id #uuid "08c8915f-4f30-5fbd-b8da-620ab2515c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244383} {:answer/id #uuid "36c8a039-cae1-5573-aa38-c3b8d5035d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244798} {:answer/id #uuid "747f4e6a-3787-5256-9ec2-519b2042c307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245350} {:answer/id #uuid "bfacd98f-ad15-5b3d-b121-7e7590e5c9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186246021}] :answer-field/correct {:answer/id #uuid "36c8a039-cae1-5573-aa38-c3b8d5035d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244798} :answer-field/id #uuid "3961e0da-79bd-5af2-b292-f3270d3bc83c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246645}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1636206a-9151-5198-a421-3985f6d14532" :question/math-academy-id "q-112204" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where \n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n\\underbrace{\\begin{bmatrix}5 \\\\ 0 \\\\ 4\\end{bmatrix}}_{x}=\\underbrace{(\\,4\\,)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{b}_{1}}+\\underbrace{(\\,0\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{2}}+\\underbrace{(\\,5\\,)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=4\\cdot {b}_{1}+0\\cdot {b}_{2}+5\\cdot {b}_{3}\n$$\n\nand therefore \n\n$$\n[x]_{B}=\\begin{bmatrix}4 \\\\ 0 \\\\ 5\\end{bmatrix},\n$$\n\nFinally, ${x}_{1}=4.$"}] [{:db/id #edb/ref 17592186247250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6641cc50-250b-56ad-b14a-c1124ec8c662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245216} {:answer/id #uuid "6fd41642-b280-5a7c-b432-e2ff0d315b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186245311} {:answer/id #uuid "a10427df-c462-55bc-928a-4193f572fa44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245747} {:answer/id #uuid "c751a88a-3aa0-5648-a5b6-305258fb0889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186246079} {:answer/id #uuid "dbad1c26-6ccc-544d-abe3-93664ba57768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186430725}] :answer-field/correct {:answer/id #uuid "a10427df-c462-55bc-928a-4193f572fa44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245747} :answer-field/id #uuid "6ec8a63e-d3c0-5582-b9c7-8a8870cbc79b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246741}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "438d91ee-b10a-5c27-8e0b-9fc621fd3a05" :question/math-academy-id "q-112208" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ 2 \\\\ 3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n\\underbrace{\\begin{bmatrix}6 \\\\ 2 \\\\ 3\\end{bmatrix}}_{x}=\\underbrace{(\\,2\\,)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}}_{{b}_{1}}+\\underbrace{(\\,3\\,)}_{{x}_{2}}\\cdot \\underbrace{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{{b}_{2}}+\\underbrace{(\\,6\\,)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}}_{{b}_{3}}\n$$\n\nwhich means that\n\n$$\nx=2\\cdot {b}_{1}+3\\cdot {b}_{2}+6\\cdot {b}_{3}\n$$\n\nand therefore \n\n$$\n[x]_{B}=\\begin{bmatrix}2 \\\\ 3 \\\\ 6\\end{bmatrix},\n$$\n\nFinally, ${x}_{2}=3.$"}] [{:db/id #edb/ref 17592186247252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0ea231-19e4-5798-a9b5-7d616adcb4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186244401} {:answer/id #uuid "46b0264c-38fc-51bf-9a2e-b16574bbff8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186244943} {:answer/id #uuid "7568a423-b1a0-56b5-9c30-5d075d3f0fca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186245358} {:answer/id #uuid "ea2c4ded-2cb2-599a-8acc-2d89b36bcf63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186246391} {:answer/id #uuid "fae915c2-fd4c-5a6b-83a6-5c149b41d652" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186246515}] :answer-field/correct {:answer/id #uuid "0a0ea231-19e4-5798-a9b5-7d616adcb4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186244401} :answer-field/id #uuid "c90bf3e4-1542-5c4f-a871-c4aab70eb175" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246909}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63a14e88-cc23-5be1-a9f6-6129753bc256" :question/math-academy-id "q-112248" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -5\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix},\\,x=\\begin{bmatrix}-3 \\\\ 41\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 41\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ -5 & 2 & 41\\end{array}\\right].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ -5 & 2 & 41\\end{array}\\right] & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 0 & -13 & 26\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=-3 \\\\ -13{x}_{2} &=26.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-3(-2)=-3\\,⟹\\,{x}_{1}=-9.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-9 \\\\ -2\\end{bmatrix}.$\n\nFinally, ${x}_{1}+{x}_{2}=(-9)+(-2)=-11.$"}] [{:db/id #edb/ref 17592186247255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "296cd22a-e3e6-5668-be49-c9790984cca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244678} {:answer/id #uuid "33cb894e-30a8-5fee-ac79-72c518bf3408" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244777} {:answer/id #uuid "5007a5a6-3bfd-51f1-b9ba-487b02337aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186245027} {:answer/id #uuid "b7d7acf5-3f65-510e-b5a6-c807a7374801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245956} {:answer/id #uuid "fbb787e5-5300-5374-97cb-bd8f1dae13c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186246519}] :answer-field/correct {:answer/id #uuid "33cb894e-30a8-5fee-ac79-72c518bf3408" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244777} :answer-field/id #uuid "aaf0f62f-67a7-5f41-9447-87fb27b25ae6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246858}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9c3dd938-940e-56ac-a6cd-45dfa09950dd" :question/math-academy-id "q-112254" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ 3 \\\\ -1\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ 2 \\\\ 1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 3 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\left[\\begin{array}{ccc|c}1 & 2 & 2 & 2 \\\\ 1 & 2 & 1 & 3 \\\\ 1 & 1 & 0 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 2 & 2 & 2 \\\\ 0 & 0 & -1 & 1 \\\\ 1 & 1 & 0 & -1\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 2 & 2 & 2 \\\\ 0 & 0 & -1 & 1 \\\\ 0 & -1 & -2 & -3\\end{array}\\right] & {R}_{2} & ↔{R}_{3} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 2 & 2 & 2 \\\\ 0 & -1 & -2 & -3 \\\\ 0 & 0 & -1 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2}+2{x}_{3} &=2 \\\\ -{x}_{2}-2{x}_{3} &=-3 \\\\ -{x}_{3} &=1.\\end{aligned}\\right.\n$$\n\nFrom third equation we get ${x}_{3}=-1$ and substituting this value into the second equation yields ${x}_{2}=-2(-1)+3=5.$ Finally, substituting ${x}_{2}=5$ and ${x}_{3}=-1$ into the first equation, we obtain\n\n$$\n{x}_{1}+2(5)+2(-1)=2\\,⟹\\,{x}_{1}=-6.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-6 \\\\ 5 \\\\ -1\\end{bmatrix}.$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=(-6)+5+(-1)=-2.\n$$"}] [{:db/id #edb/ref 17592186247256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c2da7a5-8be1-5d3a-b7b8-84d845408066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244705} {:answer/id #uuid "4b1658d1-8646-530e-9bbb-ed483365301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186244983} {:answer/id #uuid "996ad15d-6fb8-5b99-a905-e15c3419426c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245673} {:answer/id #uuid "9b78066b-73b4-592e-b22a-57a46070479a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186245687} {:answer/id #uuid "c135f5c6-da3d-5064-adf6-5bb4423b9af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186246036}] :answer-field/correct {:answer/id #uuid "4b1658d1-8646-530e-9bbb-ed483365301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}" :db/id #edb/ref 17592186244983} :answer-field/id #uuid "30a7efad-d8d4-5766-b05e-5dabc79d8092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246625}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9f3a1083-5a71-5924-8931-5b0db0d5ac8d" :question/math-academy-id "q-112290" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}0 \\\\ -1 \\\\ -2 \\\\ 1\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 0 \\\\ -8\\end{bmatrix},\\,x=\\begin{bmatrix}-3 \\\\ 8 \\\\ 5 \\\\ 4\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 1 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ -1 \\\\ -2 \\\\ 1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-3 \\\\ 2 \\\\ 0 \\\\ -8\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ 8 \\\\ 5 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 1 & -1 & 2 & 8 \\\\ 1 & -2 & 0 & 5 \\\\ 0 & 1 & -8 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 0 & -1 & 5 & 11 \\\\ 1 & -2 & 0 & 5 \\\\ 0 & 1 & -8 & 4\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 0 & -1 & 5 & 11 \\\\ 0 & -2 & 3 & 8 \\\\ 0 & 1 & -8 & 4\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 0 & -1 & 5 & 11 \\\\ 0 & 0 & -7 & -14 \\\\ 0 & 1 & -8 & 4\\end{array}\\right] & {R}_{4} & :={R}_{4}+{R}_{2} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 0 & -1 & -5 & 11 \\\\ 0 & 0 & -7 & -14 \\\\ 0 & 0 & -3 & 15\\end{array}\\right] & {R}_{4} & :={R}_{4}+\\left(-\\frac{3}{7}\\right){R}_{2} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & -3 \\\\ 0 & -1 & -5 & 11 \\\\ 0 & 0 & -7 & -14 \\\\ 0 & 0 & 0 & 21\\end{array}\\right]\\end{aligned}\n$$\n\n \nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{2} &=-3 \\\\ -{x}_{2}+5{x}_{3} &=11 \\\\ 13{x}_{3} &=-14 \\\\ 0 &=21,\\end{aligned}\\right.\n$$\n\nwhere the fourth equation is always false. Therefore, the system has no solution and we conclude that \n\n$$\nx\\notin \\text{Span}{{b}_{1},{b}_{2},{b}_{3}}.\n$$"}] [{:db/id #edb/ref 17592186247257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c86a8e6-6f85-5aa5-ae6d-29029bdec356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245272} {:answer/id #uuid "9aad1bac-86db-5804-9c07-c985acb44877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245681} {:answer/id #uuid "a44bbdac-4145-547d-a028-c0ec1721745f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186245782} {:answer/id #uuid "d577a31d-6124-5fbe-949c-907e0f506fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186246217} {:answer/id #uuid "f3d6cf3f-5569-5d37-8bae-a5a9fd24ed99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246466}] :answer-field/correct {:answer/id #uuid "9aad1bac-86db-5804-9c07-c985acb44877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245681} :answer-field/id #uuid "cb99454a-a003-5139-9346-c2529872576e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246914}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fb853955-e8ef-5657-bd4c-789f3e409e20" :question/math-academy-id "q-112291" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 4\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ -2 \\\\ -4\\end{bmatrix},\\,x=\\begin{bmatrix}7 \\\\ -15 \\\\ 6\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -3 \\\\ -2\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ -2 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}7 \\\\ -15 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & 7 \\\\ -2 & -3 & -2 & -15 \\\\ 4 & -2 & -4 & 6\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 4 & -2 & -4 & 6\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & -6 & -4 & -22\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & 0 & 8 & -16\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=7 \\\\ -{x}_{2}-2{x}_{3} &=-1 \\\\ 8{x}_{3} &=-16.\\end{aligned}\\right.\n$$\n\nFrom third equation we get ${x}_{3}=-2$ and substituting this value into the second equation yields ${x}_{2}=-2(-2)+1=5.$ Finally, substituting ${x}_{2}=5$ into the first equation, we obtain\n\n$$\n{x}_{1}+5=7\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}2 \\\\ 5 \\\\ -2\\end{bmatrix}.$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+5+(-2)=5.\n$$"}] [{:db/id #edb/ref 17592186319175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f401e4-eb59-5198-abf4-1458830b331c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186317692} {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317852} {:answer/id #uuid "914f6ffc-e4c9-5161-9fde-b475bcf8fceb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186318060} {:answer/id #uuid "e0273188-6c7e-5354-921c-cdc4386a3d9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318313} {:answer/id #uuid "32fd85ec-3fca-5fdb-8d41-028482470a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186454982}] :answer-field/correct {:answer/id #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317852} :answer-field/id #uuid "e0750bff-0d7b-54f9-bc9f-9e5f7a657747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318894}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "706ae806-e20f-56d6-9072-359885047529" :question/math-academy-id "q-34738" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}-1 \\\\ 5 \\\\ 0\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix},\\,x=\\begin{bmatrix}6 \\\\ -8 \\\\ -3\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}-1 \\\\ 5 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 2 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -8 \\\\ -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=\\left[\\begin{array}{cc|c}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{array}\\right].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & \\left[\\begin{array}{cc|c}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & \\left[\\begin{array}{cc|c}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{array}\\right] & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & \\left[\\begin{array}{cc|c}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2} &=6 \\\\ 22{x}_{2} &=22.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}.$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$"}] [{:db/id #edb/ref 17592186319176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f285bc7-2a23-5461-b750-eaa8f8e003bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186317767} {:answer/id #uuid "465bc87f-b4a4-5569-aa65-b254b4fbca65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186317793} {:answer/id #uuid "8bc09a5e-7cd5-5761-8f58-6943d3fd026d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186318035} {:answer/id #uuid "bdf6f1a2-5a0d-557d-9d4d-637603acd709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318196} {:answer/id #uuid "d753030c-70c7-564a-8109-5e1dd68f21a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186318280}] :answer-field/correct {:answer/id #uuid "d753030c-70c7-564a-8109-5e1dd68f21a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186318280} :answer-field/id #uuid "a4db4dd7-90ce-5e87-8722-aa6c46fcd3cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318787}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "97ed7d89-2f52-524c-b0ee-358754224b0a" :question/math-academy-id "q-34741" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}2 \\\\ -5 \\\\ 6\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}4 \\\\ -2 \\\\ 4\\end{bmatrix},\\,x=\\begin{bmatrix}2 \\\\ -4 \\\\ 5\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}\\begin{bmatrix}2 \\\\ -5 \\\\ 6\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ -2 \\\\ 4\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ -4 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 4 & 2 \\\\ -5 & -2 & -4 \\\\ 6 & 4 & 5\\end{array}\\right].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 4 & 2 \\\\ -5 & -2 & -4 \\\\ 6 & 4 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 6 & 4 & 5\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 0 & -8 & -1\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}2 & 4 & 2 \\\\ 0 & 8 & 1 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+4{x}_{2} &=2 \\\\ 8{x}_{2} &=1.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=\\frac{1}{8}.$ Substituting this into the first equation, we obtain\n\n$$\n2{x}_{1}+4\\cdot \\frac{1}{8}=2\\,⟹\\,{x}_{1}=\\frac{3}{4}.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}\\frac{3}{4} \\\\ \\frac{1}{8}\\end{bmatrix}.$ \n\nFinally, $$\n\\displaystyle {x}_{1}+{x}_{2}=\\frac{3}{4}+\\frac{1}{8}=\\frac{7}{8}.\n$$"}] [{:db/id #edb/ref 17592186319177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "423871db-c340-5435-8af7-55106b21f6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ 44 \\\\ -48\\end{bmatrix}" :db/id #edb/ref 17592186317779} {:answer/id #uuid "84a93b24-f7eb-59c2-ba7e-4e4993455137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}33 \\\\ 40 \\\\ -42\\end{bmatrix}" :db/id #edb/ref 17592186318017} {:answer/id #uuid "a5063a72-ba46-51d1-a2c2-aa70ff1fd965" :answer/type {:db/id #edb/