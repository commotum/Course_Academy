 {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393564}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "caf9f205-8208-5fa1-98c3-950f88c7e14f" :question/math-academy-id "q-75958" :question/problem "Find the vector $x$, if $B={{b}_{1},{b}_{2}}$ is a basis of $\\text{Span}{{b}_{1},{b}_{2}},$ and \n\n$$\n{b}_{1}=\\begin{bmatrix}-1 \\\\ 0 \\\\ -5\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}2 \\\\ -2 \\\\ 2\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}3 \\\\ 7\\end{bmatrix}.\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}{{b}_{1},{b}_{2}}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}-1 \\\\ 0 \\\\ -5\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -2 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=\\begin{bmatrix}3 \\\\ 7\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}x & =\\underbrace{(\\,3\\,)}_{{x}_{1}}\\begin{bmatrix}-1 \\\\ 0 \\\\ -5\\end{bmatrix}+\\underbrace{(\\,7\\,)}_{{x}_{2}}\\begin{bmatrix}2 \\\\ -2 \\\\ 2\\end{bmatrix}= \\\\  & =\\begin{bmatrix}-3 \\\\ 0 \\\\ -15\\end{bmatrix}+\\begin{bmatrix}14 \\\\ -14 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}11 \\\\ -14 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186409817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a1f0ad-84e2-58dd-a8ed-11320d5d0931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-21 \\\\ -3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186409794} {:answer/id #uuid "65c3f0eb-5935-5403-8987-9332ba2a913e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186409795} {:answer/id #uuid "aae52088-4930-599a-9ee5-fd6a528c248d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answe