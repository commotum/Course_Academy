ray}{cc|c}1 & 3 & -5 \\\\ 0 & -4 & 5 \\\\ 4 & 0 & 4\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & -4 & 5 \\\\ 0 & -12 & 24\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -5 \\\\ 0 & -4 & 5 \\\\ 0 & 0 & 9\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=-5 \\\\ -4{x}_{2} &=5 \\\\ 0 &=9,\\end{aligned}\\right.\n$$\n\nwhere the third equation is always false. Therefore, the system has no solution and we conclude that $x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}.$"}] [{:db/id #edb/ref 17592186597568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8b0a0f-c31a-5f20-8846-a0cdc3daee78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 12 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186596894} {:answer/id #uuid "11c6941c-eefb-536d-a91b-0f7820d4efec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -20 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186596902} {:answer/id #uuid "7a5dacd1-d80c-5f8e-be65-ee8751fafd80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 5 \\\\ 20\\end{bmatrix}" :db/id #edb/ref 17592186597110} {:answer/id #uuid "cfe419cd-8008-5062-b6af-83bc6a3620d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186597280} {:answer/id #uuid "d7e5fb38-79bf-55e2-b3a4-8971abf3c5a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ -20 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186597298}] :answer-field/correct {:answer/id #uuid "11c6941c-eefb-536d-a91b-0f7820d4efec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -20 \\\\ -12\\end{bmatrix}" :db/id #edb/ref 17592186596902} :answer-field/id #uuid "9b2ad75d-ad6d-5c02-bab9-05c5afb4c164" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186597478}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ba7f13d-552c-5be7-bc2c-62cd5e8905a3" :question/math-academy-id "q-112198" :question/problem "Find the vector $x$, if $B=\\{{b}_{1},{b}_{2}\\}$ is a basis of $\\text{Span}\\{{b}_{1},{b}_{2}\\},$ and \n\n$$\n{b}_{1}=\\begin{bmatrix}4 \\\\ -3 \\\\ -2\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}9 \\\\ -1 \\\\ -1\\end{bmatrix},\\,[x]_{B}=\\begin{bmatrix}8 \\\\ -4\\end{bmatrix}.\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}\\{{b}_{1},{b}_{2}\\}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}4 \\\\ -3 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}9 \\\\ -1 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=\\begin{bmatrix}8 \\\\ -4\\end{bmatrix},$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,8\\,)}_{⏟}}_{{x}_{1}}\\begin{bmatrix}4 \\\\ -3 \\\\ -2\\end{bmatrix}+{{(\\,-4\\,)}_{⏟}}_{{x}_{2}}\\begin{bmatrix}9 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}32 \\\\ -24 \\\\ -16\\end{bmatrix}+\\begin{bmatrix}-36 \\\\ 4 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 \\\\ -20 \\\\ -12\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186597586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391f3f19-5b2a-5ca2-88ce-90a3eb5eb2fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186596978} {:answer/id #uuid "48e92048-4d96-57cf-aa41-eb31a9e16e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186597019} {:answer/id #uuid "b7f96a62-1043-5355-9f00-84f3498619d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/id #edb/ref 17592186597229} {:answer/id #uuid "d97e27f8-f685-5b67-b6f0-818ca40f1d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186597303} {:answer/id #uuid "dac461ac-b9eb-5874-aa4a-f6927cf59d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186597305}] :answer-field/correct {:answer/id #uuid "48e92048-4d96-57cf-aa41-eb31a9e16e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186597019} :answer-field/id #uuid "81486cf4-a716-5194-b807-0d5e7f01d3a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186597458}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ac643e1d-28b2-5d4a-8f5c-f9a61cbb6bd6" :question/math-academy-id "q-112278" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,{b}_{2}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix},\\,{b}_{3}=\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix},\\,x=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nIf $[x]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -1 \\\\ 2 & -1 & 2 & 1 \\\\ 1 & 0 & 1 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -1 \\\\ 0 & -3 & 2 & 3 \\\\ 1 & 0 & 1 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -1 \\\\ 0 & -3 & 2 & 3 \\\\ 0 & -1 & 1 & 2\\end{array}\\right] & {R}_{2} & ↔{R}_{3} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -1 \\\\ 0 & -1 & 1 & 2 \\\\ 0 & -3 & 2 & 3\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\ ∼ & \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -1 \\\\ 0 & -1 & 1 & 2 \\\\ 0 & 0 & -1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2} &=-1 \\\\ -{x}_{2}+{x}_{3} &=2 \\\\ -{x}_{3} &=-3.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting this into the second   equation yields\n\n$$\n-{x}_{2}+(3)=2\\,⟹\\,{x}_{2}=1.\n$$\n\n Finally,  by substituting ${x}_{2}=1$  into the first equation we obtain\n\n$$\n{x}_{1}+1=-1\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=\\begin{bmatrix}-2 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=(-2)+1+3=2.\n$$"}] [{:db/id #edb/ref 17592186597600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6dc25c-590c-54ce-a6e4-2c7f505f6573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ 3 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186596917} {:answer/id #uuid "2b81f1bc-d79c-5b11-9867-aebb00393b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ -3 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186596951} {:answer/id #uuid "871b879f-f1d8-5