#{[{:db/id #edb/ref 17592186119929 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119503 :question/id #uuid "6a0257ef-3ec6-501c-bbf7-1c1108d4f8b6" :question/math-academy-id "e-10991" :question/problem "Calculate \n$$\n{\\left| \\begin{array}{cccc}- 2 & 0 & 0 & 0 \\\\ - 4 & 1 & 0 & 0 \\\\ 1 & 10 & \\sqrt{3} & 0 \\\\ - 3 & 0 & 6 & - 2\\end{array} \\right|}.\n$$" :question/worked-solution "The determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-2 & {\\color{blue}{0}} & {\\color{blue}{0}} & {\\color{blue}{0}} \\\\ -4 & 1 & {\\color{blue}{0}} & {\\color{blue}{0}} \\\\ 1 & 10 & \\sqrt{3} & {\\color{blue}{0}} \\\\ -3 & 0 & 6 & -2\\end{vmatrix} & =(-2)\\cdot 1\\cdot \\sqrt{3}\\cdot (-2)=4\\sqrt{3}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e84e45ca-c250-5e65-a04e-4714a485f38e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048252 :topic/difficulty 0.6018997901213411 :topic/id #uuid "8c876864-a853-56d6-a887-91d7f8f1cf14" :topic/knowledge-points [{:db/id #edb/ref 17592186087695} {:db/id #edb/ref 17592186087696} {:db/id #edb/ref 17592186087697} {:db/id #edb/ref 17592186087698}] :topic/math-academy-id 862 :topic/next [{:db/id #edb/ref 17592186048297} {:db/id #edb/ref 17592186050283} {:db/id #edb/ref 17592186050825}] :topic/title "Zero, Square, Diagonal and Identity Matrices"} {:db/id #edb/ref 17592186050283 :topic/difficulty 0.9149892976448922 :topic/id #uuid "3cb2a10b-5d06-5efe-b222-3c14b0ccd7c8" :topic/knowledge-points [{:db/id #edb/ref 17592186119771} {:db/id #edb/ref 17592186119772} {:db/id #edb/ref 17592186119784}] :topic/math-academy-id 1777 :topic/next [{:db/id #edb/ref 17592186048221} {:db/id #edb/ref 17592186048743} {:db/id #edb/ref 17592186049159} {:db/id #edb/ref 17592186049779}] :topic/title "Triangular Matrices"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowl