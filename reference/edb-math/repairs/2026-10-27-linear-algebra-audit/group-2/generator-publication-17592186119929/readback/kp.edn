17592186702459}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0cc67c3c-0334-59e3-b6fd-5c5b12713dd9" :question/problem "Find the determinant of the matrix\n\n$$\nT=\\begin{bmatrix}2 & \\sqrt{2} & -1 & 5 \\\\ 0 & -1 & 0.5 & 4 \\\\ 0 & 0 & 3 & \\pi \\\\ 0 & 0 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "All entries below the main diagonal are zero, so $T$ is upper triangular. Its determinant is the product of its main diagonal entries:\n\n$$\n\\det(T)=2\\cdot(-1)\\cdot3\\cdot2=-12.\n$$\n\nThe off-diagonal entries do not enter this product."} {:db/id #edb/ref 17592186702465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4934ebad-b648-5e73-913b-aa42a0ecdfab" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186702455} {:answer/id #uuid "6a60df68-14c5-5203-8af8-a612bdcdbdce" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186702457} {:answer/id #uuid "9ad2c019-e68b-5ea8-83a9-bae09d14ed2a" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186702463} {:answer/id #uuid "c8cb7448-46a8-546c-a503-c9a39aaeae1b" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186702468} {:answer/id #uuid "d0a1fe9d-45cc-5470-86f1-ebb643177d4a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186702469}] :answer-field/correct {:answer/id #uuid "d0a1fe9d-45cc-5470-86f1-ebb643177d4a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186702469} :answer-field/id #uuid "75b6a4bb-397f-52d1-86e4-5a4bd551d83a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186702458}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac56422a-ae07-5014-84d3-374ac97d57b5" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A)-\\det(B^T)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-2 & 0 & 0 \\\\ \\sqrt{3} & 3 & 0 \\\\ 4 & -1 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 0.5 & 5 \\\\ 0 & -2 & 4 \\\\ 0 & 0 & 2\\end{bmatrix}$</div>\n</div>" :question/worked-solution "The matrix $A$ is lower triangular and $B$ is upper triangular. Multiply their main diagonal entries:\n\n$$\n\\begin{aligned}\\det(A)&=(-2)\\cdot3\\cdot1=-6,\\\\\\det(B)&=1\\cdot(-2)\\cdot2=-4.\\end{aligned}\n$$\n\nTransposition preserves the determinant, so $\\det(B^T)=\\det(B)=-4$. Therefore,\n\n$$\n\\det(A)-\\det(B^T)=-6-(-4)=-2.\n$$"} {:db/id #edb/ref 17592186702470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0790787d-1deb-570d-80b3-1a2732493292" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186702450} {:answer/id #uuid "1295d0c8-fed0-56eb-b8ac-689ec9b2b29d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186702452} {:answer/id #uuid "1363b943-31d5-5b86-810c-5918750ee77f" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186702453} {:answer/id #uuid "86b92eaf-81b5-5d5d-a34b-9ef70472935b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186702460} {:answer/id #uuid "be9bef8f-7638-56ac-af71-6ad6874d3947" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186702467}] :answer-field/correct {:answer/id #uuid "1295d0c8-fed0-56eb-b8ac-689ec9b2b29d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186702452} :answer-field/id #uuid "ae0d9945-94de-5b8b-8448-e6a630d70e8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186702466}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e943bc0b-58ab-5d24-9b76-ad39a0da742b" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T+B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}2 & 0 & 0 \\\\ -2 & -1 & 0 \\\\ 4 & 1 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-3 & 5 & 0 \\\\ 0 & 4 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "Transposing the lower triangular matrix $A$ gives an upper triangular matrix. Since $B$ is also upper triangular, their sum is upper triangular:\n\n$$\n\\begin{aligned}A^T+B&=\\begin{bmatrix}2+(-3) & -2+5 & 4+0 \\\\ 0 & -1+4 & 1+(-2) \\\\ 0 & 0 & 3+(-1)\\end{bmatrix}\\\\&=\\begin{bmatrix}-1 & 3 & 4 \\\\ 0 & 3 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nIts main diagonal entries are $-1$, $3$, and $2$. Thus,\n\n$$\n\\det(A^T+B)=(-1)\\cdot3\\cdot2=-6.\n$$\n\nWe must add the matrices before taking the diagonal product. Adding their determinants would give $-6+12=6$, which is a different quantity."} {:db/id #edb/ref 17592186703878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39988e65-0cf6-56cf-a05f-752f8efea2e5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703886} {:answer/id #uuid "b87b7f1c-28ac-5813-b269-08c22cfa570d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703901} {:answer/id #uuid "bfbde0a8-5510-5f67-9a76-5cb38013e04c" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186703902} {:answer/id #uuid "dd7c35fa-6b02-505d-aedc-75f1f147bb75" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186703906} {:answer/id #uuid "f072f7f7-6b2c-5dfa-9ae7-bf53ab18e800" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703909}] :answer-field/correct {:answer/id #uuid "dd7c35fa-6b02-505d-aedc-75f1f147bb75" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186703906} :answer-field/id #uuid "1a3aaa25-3cc5-558e-b2ba-61636be0fb78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703882}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0117b33a-21ee-519b-a2ef-b6777231bb95" :question/problem "Given that $D=2I$, where $I$ is the $3\\times 3$ identity matrix, find $\\det(D)$." :question/worked-solution "First write the scalar multiple of the identity matrix:\n\n$$\nD=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$\n\nThe matrix $D$ is diagonal. Its determinant is the product of the main diagonal entries:\n\n$$\n\\det(D)=2\\cdot2\\cdot2=8.\n$$"} {:db/id #edb/ref 17592186703879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30255748-0714-5f1e-b44e-82b5520fb6bb" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186703885} {:answer/id #uuid "75f584a3-2429-59aa-a2f1-3026b0ed9f17" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703893} {:answer/id #uuid "8fcd9f04-e00f-541c-934c-fd112b2f4d96" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703895} {:answer/id #uuid "9cc3b7cf-bc25-5c92-aa39-68847a8a35e1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703897} {:answer/id #uuid "a5dc1b0c-ad88-51ba-863b-5afc4ee6246f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186703898}] :answer-field/correct {:answer/id #uuid "9cc3b7cf-bc25-5c92-aa39-68847a8a35e1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703897} :answer-field/id #uuid "c4bee312-ef66-5d13-8838-ae13856ad97b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703903}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0274f1c1-13b0-51dc-a421-5453ce2a7aa9" :question/problem "Find the determinant of the matrix\n\n$$\nE=\\begin{bmatrix}2 & -1 & -4 \\\\ 0 & 3 & 4 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$" :question/work