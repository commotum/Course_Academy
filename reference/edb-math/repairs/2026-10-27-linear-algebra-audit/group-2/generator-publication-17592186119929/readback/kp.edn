correct {:answer/id #uuid "d4848bf7-5293-51e3-9bf2-e9657eb0464a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703936} :answer-field/id #uuid "4ca1a071-006c-5f06-baaa-7e04e56ac29c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703921}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a2ad1c4-6948-53e0-8e71-68653016bb6e" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T+B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-3 & 0 & 0 \\\\ -2 & -3 & 0 \\\\ 1 & -2 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -2 & 4 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}-3 & -2 & 1 \\\\ 0 & -3 & -2 \\\\ 0 & 0 & -2\\end{bmatrix},\\\\B&=\\begin{bmatrix}0 & -2 & 4 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T+B&=\\begin{bmatrix}-3+0 & -2+(-2) & 1+4 \\\\ 0+0 & -3+3 & -2+2 \\\\ 0+0 & 0+0 & -2+1\\end{bmatrix}\\\\&=\\begin{bmatrix}-3 & -4 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T+B)=(-3)\\cdot0\\cdot(-1)=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."} {:db/id #edb/ref 17592186703923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f310f0-54f1-5d2e-822f-d9e071439aea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703914} {:answer/id #uuid "312f2a19-b45c-5759-8136-f4e22ce808e0" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186703918} {:answer/id #uuid "33dfdc5d-8490-5de5-8326-3892c170b121" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186703919} {:answer/id #uuid "93ce436c-b0f9-598a-ba55-ef878e592bf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703926} {:answer/id #uuid "97fef6fe-1d50-5c3b-92de-0e281d38b3f9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703927}] :answer-field/correct {:answer/id #uuid "93ce436c-b0f9-598a-ba55-ef878e592bf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703926} :answer-field/id #uuid "89f20267-8654-5925-8640-c3c912eaceb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703924}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7e2e4c7a-0012-55b8-b741-ae28e99a6fe6" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T-B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}2 & 4 & 3 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}2 & 0 & 0 \\\\ 4 & 2 & 0 \\\\ 3 & 1 & 1\\end{bmatrix},\\\\B&=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T-B&=\\begin{bmatrix}2-2 & 0-0 & 0-0 \\\\ 4-0 & 2-1 & 0-0 \\\\ 3-1 & 1-1 & 1-(-1)\\end{bmatrix}\\\\&=\\begin{bmatrix}0 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 2 & 0 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T-B)=0\\cdot1\\cdot2=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."} {:db/id #edb/ref 17592186703935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14331b3a-ac10-50c9-b8d1-2dc33dff756b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703915} {:answer/id #uuid "1ef909a3-64fa-582d-8692-7049bd3f95c3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186703916} {:answer/id #uuid "53cb12a1-3d5c-521e-9df3-51c168362372" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186703922} {:answer/id #uuid "afb2df77-4140-5e2b-ab60-6b7061ef1b08" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186703931} {:answer/id #uuid "da4c8162-ecc9-56ef-82bb-5205753eb07c" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186703938}] :answer-field/correct {:answer/id #uuid "53cb12a1-3d5c-521e-9df3-51c168362372" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186703922} :answer-field/id #uuid "bf907172-fa08-586c-a5f9-d22981535210" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703934}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c671e697-6b85-5b40-8e67-3ac53e085961" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A^T+B)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}3 & 2 & 0 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 3 & 0 \\\\ -4 & -2 & -3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A^T&=\\begin{bmatrix}3 & 0 & 0 \\\\ 2 & 3 & 0 \\\\ 0 & -2 & -1\\end{bmatrix},\\\\B&=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 3 & 0 \\\\ -4 & -2 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A^T+B&=\\begin{bmatrix}3+(-2) & 0+0 & 0+0 \\\\ 2+(-1) & 3+3 & 0+0 \\\\ 0+(-4) & -2+(-2) & -1+(-3)\\end{bmatrix}\\\\&=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 6 & 0 \\\\ -4 & -4 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A^T+B)=1\\cdot6\\cdot(-4)=-24.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."} {:db/id #edb/ref 17592186703940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d9782b8-e60f-5a0a-8750-f220fde38f23" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703917} {:answer/id #uuid "90f8d54b-2b1b-5eae-8977-2d280cc09f43" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186703925} {:answer/id #uuid "9a492d59-419e-5977-997e-eee46e3d6a52" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186703929} {:answer/id #uuid "d604f003-03db-5471-ab4b-67944e737cf0" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186703937} {:answer/id #uuid "e485497e-e8ac-571c-a9f5-c06ec22ea7c3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186703939}] :answer-field/correct {:answer/id #uuid "2d9782b8-e60f-5a0a-8750-f220fde38f23" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703917} :answer-field/id #uuid "986a74e3-202d-587c-a733-248692740f8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703928}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "eeba27d7-4691-55eb-9b70-698616fcfa42" :question/problem "Consider the matrices $A$ and $B$ below. Find $\\det(A+B^T)$.\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -2 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-2 & 4 & 4 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "After transposition the operands have the same triangular direction. Combine corresponding entries before taking the determinant:\n\n$$\n\\begin{aligned}A&=\\begin{bmatrix}-2 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 1 & -2 & -2\\end{bmatrix},\\\\B^T&=\\begin{bmatrix}-2 & 0 & 0 \\\\ 4 & -1 & 0 \\\\ 4 & -2 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}A+B^T&=\\begin{bmatrix}-2+(-2) & 0+0 & 0+0 \\\\ -1+4 & 1+(-1) & 0+0 \\\\ 1+4 & -2+(-2) & -2+(-1)\\end{bmatrix}\\\\&=\\begin{bmatrix}-4 & 0 & 0 \\\\ 3 & 0 & 0 \\\\ 5 & -4 & -3\\end{bmatrix}.\\end{aligned}\n$$\n\nThe resulting matrix is triangular, so multiply its main diagonal entries:\n\n$$\n\\det(A+B^T)=(-4)\\cdot0\\cdot(-3)=0.\n$$\n\nThe determinant rule applies to the combined matrix; determinants do not in general distribute over matrix addition or subtraction."}] :knowledge-point/title "Finding the Determinant of a Triangular Matrix"}]}
