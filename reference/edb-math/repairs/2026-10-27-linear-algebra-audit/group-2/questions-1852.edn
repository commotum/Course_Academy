-8 \\\\ 0 & 1 & -3 \\\\ 0 & 10 & k-32\\end{array}\\right] & {R}_{3} & :={R}_{3}-10{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 2 & -8 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & k-2\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-2.$ Therefore, the system has a solution only if\n\n$$\n0=k-2\\,⟹\\,k=2.\n$$"}] [{:db/id #edb/ref 17592186563678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a3b4f0-37fc-510b-b782-70713c302e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186562949} {:answer/id #uuid "0e4b9832-4e75-5456-ae0f-c9cbef897a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562972} {:answer/id #uuid "79384773-3b33-5558-b1a4-01487217122d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186563212} {:answer/id #uuid "d55768be-caa1-5015-a0a0-51da48688614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186563412} {:answer/id #uuid "d5b9c506-0e84-558b-99e5-7b80605f2397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186563413}] :answer-field/correct {:answer/id #uuid "0e4b9832-4e75-5456-ae0f-c9cbef897a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562972} :answer-field/id #uuid "a41c8e29-8919-560f-acd3-bb2401f756f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563609}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "435bef4b-b3af-5768-973e-b4aa50ac129d" :question/math-academy-id "q-105235" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -2 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}5 \\\\ -9 \\\\ 10\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -4 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}+5{x}_{2}=3 \\\\ -2{x}_{1}-9{x}_{2}=-4 \\\\ 2{x}_{1}+10{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 5 & 3 \\\\ -2 & -9 & -4 \\\\ 2 & 10 & k\\end{array}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 2 & 10 & k\\end{array}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 5 & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k-6\\end{array}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$"}] [{:db/id #edb/ref 17592186563719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e4a4287-0b4e-5134-b26d-e720107fbfce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2}\\}" :db/id #edb/ref 17592186563012} {:answer/id #uuid "32966283-95f9-59c0-9da8-620246a44c9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186563060} {:answer/id #uuid "35881d2a-16d1-5e15-a12f-b325e9f8db16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563066} {:answer/id #uuid "4d4a40a4-8887-524e-8b48-8a24128d12fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186563117} {:answer/id #uuid "d639618d-a932-5b03-8225-fae8a0b21ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186563414}] :answer-field/correct {:answer/id #uuid "35881d2a-16d1-5e15-a12f-b325e9f8db16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563066} :answer-field/id #uuid "283164aa-73de-5dcd-8a69-e6c9e6374abc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563546}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a8427e64-b547-5ecb-a62e-824aa188b632" :question/math-academy-id "q-34114" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}=2 \\\\ 2{x}_{1}+4{x}_{2}=0 \\\\ -3{x}_{1}+{x}_{2}=-7\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 0 & 2 \\\\ 2 & 4 & 0 \\\\ -3 & 1 & -7\\end{array}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ -3 & 1 & -7\\end{array}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ 0 & 1 & -1\\end{array}] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{array}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=2 \\\\ {x}_{2}=-1 \\\\ 0=0.\\end{aligned}\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}2{a}_{1}+(-1){a}_{2} & =b \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot (-1)=-2.$"}] [{:db/id #edb/ref 17592186563732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1442cd36-01ab-57b5-b752-7b7131e887f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186562987} {:answer/id #uuid "1f1cbd99-3722-58a8-94e3-9b80df51c48b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186563016} {:answer/id #uuid "38fb4394-142f-596a-acba-652af141f7ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186563073} {:answer/id #uuid "976c158b-03de-5101-af86-c772a635e855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186563285} {:answer/id #uuid "98c56786-6605-5401-b672-c63cb1cecd33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186563288}] :answer-field/correct {:answer/id #uuid "98c56786-6605-5401-b672-c63cb1cecd33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186563288} :answer-field/id #uuid "7847d689-0e36-5ac4-b435-bd1cf0642bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563577}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c391d9c3-0c76-5e6f-b0c3-d6b4ee2c37cb" :question/math-academy-id "q-105199" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}=3 \\\\ 2{x}_{1}+{x}_{2}=8\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 0 & 3 \\\\ 2 & 1 & 8\\end{array}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=3 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}3{a}_{1}+2{a}_{2} & =b \\\\ 3\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=3\\cdot 2=6.$"}] [{:db/id #edb/ref 17592186563749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012982fc-c0c6-5360-983d-5c24ecfa5a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "162" :db/id #edb/ref 17592186562940} {:answer/id #uuid "3ef56e44-9e80-5352-bfb2-5d35c8c19329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186563087} {:answer/id #uuid "65e52e96-8639-5303-a9f5-06fb2d4d391c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186563179} {:answer/id #uuid "84afc469-3802-566a-b03f-b05bcd3fd37e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}" :db/id #edb/ref 17592186563242} {:answer/id #uuid "bcb4217f-2b11-5476-8d7f-3c0e1e75e42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186563361}] :answer-field/correct {:answer/id #uuid "012982fc-c0c6-5360-983d-5c24ecfa5a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "162" :db/id #edb/ref 17592186562940} :answer-field/id #uuid "0d94e257-45da-5352-bd7b-f0680253dc5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563523}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ddfb229d-f01d-542c-8a6c-f2e9a5996154" :question/math-academy-id "q-34639" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ 4{x}_{1}+{x}_{2}-8{x}_{3}=18 \\\\ 2{x}_{1}-3{x}_{3}=9\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 4 & 1 & -8 & 18 \\\\ 2 & 0 & -3 & 9\\end{array}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 2 & 0 & -3 & 9\\end{array}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ {x}_{2}=6 \\\\ {x}_{3}=3.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(3)=3\\,⟹\\,{x}_{1}=9.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}9{a}_{1}+6{a}_{2}+3{a}_{3} & =b \\\\ 9\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+6\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+3\\cdot \\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=9\\cdot 6\\cdot 3=162.$"}] [{:db/id #edb/ref 17592186581745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85642ced-3291-5237-912d-27c18667a775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186581254} {:answer/id #uuid "89688d1e-1b07-5980-a614-ee26f98d14b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186581266} {:answer/id #uuid "996cd1b5-1025-5b4a-aed1-60540f519a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-85" :db/id #edb/ref 17592186581295} {:answer/id #uuid "af84bccb-ed07-5cfd-887d-b3215ea2afcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}" :db/id #edb/ref 17592186581344} {:answer/id #uuid "e2cd389f-4bbf-5bf0-8a70-8204c3b14d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-340" :db/id #edb/ref 17592186581440}] :answer-field/correct {:answer/id #uuid "e2cd389f-4bbf-5bf0-8a70-8204c3b14d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-340" :db/id #edb/ref 17592186581440} :answer-field/id #uuid "ee2745ef-4acf-51e1-98fb-ee4182d16ee2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581629}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fbcfd8ae-059d-51b0-aee6-824d405b7e28" :question/math-academy-id "q-34648" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=5 \\\\ 3{x}_{1}+{x}_{2}-9{x}_{3} &=10 \\\\ -4{x}_{1}+13{x}_{3} &=-16\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 3 & 1 & -9 & 10 \\\\ -4 & 0 & 13 & -16\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 0 & 1 & 0 & -5 \\\\ -4 & 0 & 13 & -16\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=5 \\\\ {x}_{2} &=-5 \\\\ {x}_{3} &=4.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=4.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-3(4)=5\\,⟹\\,{x}_{1}=17.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}17{a}_{1}+(-5){a}_{2}+4{a}_{3} & =b \\\\ 17\\cdot \\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix}+(-5)\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+4\\cdot \\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=17\\cdot (-5)\\cdot 4=-340.$"}] [{:db/id #edb/ref 17592186713317 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The repeated equation does not cause inconsistency. The third coordinate gives the missing independent equation." :answer/id #uuid "50be0dbb-729f-527e-a8dd-e4bcd0b394c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713322} {:answer/feedback "This is $t$. The requested value is $s\\cdot t$." :answer/id #uuid "91a39ad4-cd8c-5671-9d2f-0a41cbe97000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713329} {:answer/feedback "Yes. The pair $(4,-1)$ satisfies all three coordinates and has product $-4$." :answer/id #uuid "a80f81d5-d260-5a89-ba0f-55d6260788ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713331} {:answer/feedback "This is the sum $s+t$. Use the product after checking membership." :answer/id #uuid "ed295388-d435-5252-b201-efc65f104216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713335} {:answer/feedback "This is $s$. Multiply it by $t=-1$." :answer/id #uuid "f884e554-fb60-56f5-9de4-d70b8aac748d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713336}] :answer-field/correct {:answer/feedback "Yes. The pair $(4,-1)$ satisfies all three coordinates and has product $-4$." :answer/id #uuid "a80f81d5-d260-5a89-ba0f-55d6260788ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713331} :answer-field/id #uuid "201e8260-65cd-578b-8403-3aa3a5fdf53e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713320}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "016710be-ea4e-545b-b717-b22ccfc9d1eb" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\mathbf{b}=\\langle 1, 2, 1\\rangle,\\qquad\\mathbf{c}=\\langle 2, 4, -1\\rangle,\\qquad\\mathbf{u}=\\langle 2, 4, 5\\rangle.\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. Expanding gives\n\n$$\n\\left\\{\\begin{aligned}s+2t &=2 \\\\ 2s+4t &=4 \\\\ s-t &=5\\end{aligned}\\right.\n$$\n\nThe second equation repeats twice the first, so those two equations alone cannot determine both coefficients. Use the third coordinate as well. Apply $R_2\\leftarrow R_2-2R_1$ and $R_3\\leftarrow R_3-R_1$:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & 2 \\\\ 2 & 4 & 4 \\\\ 1 & -1 & 5\\end{array}\\right]\\sim \\left[\\begin{array}{cc|c}1 & 2 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & -3 & 3\\end{array}\\right]\n$$\n\nInterchange $R_2$ and $R_3$ to put the nonzero row above the zero row:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & 2 \\\\ 0 & -3 & 3 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nThen $-3t=3$ gives $t=-1$, and $s+2(-1)=2$ gives $s=4$. Check every coordinate:\n\n$$\n4\\mathbf{b}-\\mathbf{c}=\\langle 4-2,8-4,4+1\\rangle=\\langle 2,4,5\\rangle=\\mathbf{u}.\n$$\n\nThere is no contradiction; the zero row adds no restriction. The remaining two equations determine a unique pair. Therefore $\\mathbf{u}$ lies on $\\Pi$ and $s\\cdot t=4(-1)=-4$."}] [{:db/id #edb/ref 17592186713321 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This product uses a pair that fails the third coordinate. Membership must be checked first." :answer/id #uuid "6dd423a0-ae3b-5e13-87cc-e1d1e5e969ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713326} {:answer/feedback "The first coordinate is not the requested product, and the system is inconsistent." :answer/id #uuid "840a29b9-d0a1-585b-96ee-1232f063e2ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186713327} {:answer/feedback "A product from a partial system does not establish membership; check all three coordinates." :answer/id #uuid "87c06dd6-1497-50e0-b49f-866d36ca3ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713328} {:answer/feedback "This is the candidate value of $t$, and that candidate fails the third coordinate." :answer/id #uuid "aed8b987-c1df-5e0c-932e-77f4160d8f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713332} {:answer/feedback "Yes. Row reduction gives $0=1$, so no pair works." :answer/id #uuid "b916a909-f5f4-5a9c-a5eb-5a772a786063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713333}] :answer-field/correct {:answer/feedback "Yes. Row reduction gives $0=1$, so no pair works." :answer/id #uuid "b916a909-f5f4-5a9c-a5eb-5a772a786063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713333} :answer-field/id #uuid "f8f478c4-d46b-515a-9e5a-0d9001327484" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713337}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4bd375d4-5b1f-5bdb-83be-769624674385" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\mathbf{b}=\\langle 1, 1, 2\\rangle,\\qquad\\mathbf{c}=\\langle 1, -1, 1\\rangle,\\qquad\\mathbf{u}=\\langle 1, 3, 4\\rangle.\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. Expanding the vector equation gives\n\n$$\n\\left\\{\\begin{aligned}s+t &=1 \\\\ s-t &=3 \\\\ 2s+t &=4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and apply $R_2\\leftarrow R_2-R_1$ and $R_3\\leftarrow R_3-2R_1$:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 1 & 1 \\\\ 1 & -1 & 3 \\\\ 2 & 1 & 4\\end{array}\\right]\\sim \\left[\\begin{array}{cc|c}1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & -1 & 2\\end{array}\\right]\n$$\n\nNow apply $R_3\\leftarrow R_3-\\frac12 R_2$:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{array}\\right]\n$$\n\nThe last row says $0=1$, a contradiction. The first two coordinate equations would give $t=-1$ and $s=2$, but then the third coordinate would be $2s+t=3$, not $4$. Thus no pair satisfies all three equations. The vector $\\mathbf{u}$ does not lie on $\\Pi$; the candidate product $-2$ from only the first two equations is not a valid answer."}] [{:db/id #edb/ref 17592186713334 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The signs of $s=2$ and $t=-1$ differ, so their product is negative." :answer/id #uuid "05eed988-5442-593c-88d6-9715f575714b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713318} {:answer/feedback "Yes. The pair $(2,-1)$ satisfies every coordinate, and its product is $-2$." :answer/id #uuid "10f26121-320a-57ba-bb34-5ddef5eaf638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713319} {:answer/feedback "The third equation holds: $2+2(-1)=0$." :answer/id #uuid "686fc79b-533a-5d0a-a7f5-10ce4acd911b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713324} {:answer/feedback "This is $s+t$. The requested quantity is $s\\cdot t$." :answer/id #uuid "6ce0be00-e792-5eea-945f-513eaacf83f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186713325} {:answer/feedback "This is $t$ alone. Multiply $s$ and $t$." :answer/id #uuid "98bdb059-ba2d-5996-8775-8e7e5e78d2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713330}] :answer-field/correct {:answer/feedback "Yes. The pair $(2,-1)$ satisfies every coordinate, and its product is $-2$." :answer/id #uuid "10f26121-320a-57ba-bb34-5ddef5eaf638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713319} :answer-field/id #uuid "5f92007e-156e-5ad4-b687-e9324b1fd2da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713323}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e81cdfbb-d407-58ff-998e-36733206e347" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\mathbf{b}=\\langle 1, 0, 1\\rangle,\\qquad\\mathbf{c}=\\langle 0, 1, 2\\rangle,\\qquad\\mathbf{u}=\\langle 2, -1, 0\\rangle.\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$.\n\nUse the component equations\n\n$$\n\\left\\{\\begin{aligned}s &=2 \\\\ t &=-1 \\\\ s+2t &=0\\end{aligned}\\right.\n$$\n\nCheck that the values from the first two equations also satisfy the third." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. The component system is\n\n$$\n\\left\\{\\begin{aligned}s &=2 \\\\ t &=-1 \\\\ s+2t &=0\\end{aligned}\\right.\n$$\n\nThe first two equations give $s=2$ and $t=-1$. In the third equation, $s+2t=2+2(-1)=0$, as required. Equivalently,\n\n$$\n2\\mathbf{b}-\\mathbf{c}=\\langle 2,-1,0\\rangle=\\mathbf{u}.\n$$\n\nAll three coordinates agree, so $\\mathbf{u}$ lies on $\\Pi$ and $s\\cdot t=2(-1)=-2$."}] [{:db/id #edb/ref 17592186713379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35185c3b-728f-50bb-832a-01ddc76f40d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186713375} {:answer/id #uuid "4acb7b27-19ed-5bf6-aa4d-b57306dbf270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713382} {:answer/id #uuid "7bacdd84-2d92-5d9e-996a-fd271953a4f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713385} {:answer/id #uuid "a015093f-9326-5e95-845d-d121a207ece2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186713396} {:answer/id #uuid "f7dfbabf-7a06-5871-b041-d52b19095b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186713408}] :answer-field/correct {:answer/id #uuid "f7dfbabf-7a06-5871-b041-d52b19095b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186713408} :answer-field/id #uuid "f35529c9-73aa-51b0-8151-fe25441d190a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713407}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "408a692c-c137-5e29-bfb3-74397834a78e" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}5 \\\\ 4 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}6 \\\\ 4 \\\\ 2\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-24 \\\\ -18 \\\\ -6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}5x_{1}+6x_{2} &= -24 \\\\ 4x_{1}+4x_{2} &= -18 \\\\ x_{1}+2x_{2} &= -6\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 4 & 4 & -18 \\\\ 1 & 2 & -6\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(\\frac{4}{5}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 1 & 2 & -6\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(\\frac{1}{5}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 0 & \\frac{4}{5} & -\\frac{6}{5}\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{2} &= \\frac{\\frac{6}{5}}{-\\frac{4}{5}} = -\\frac{3}{2} \\\\ x_{1} &= \\frac{-24-\\left(6\\right)\\left(-\\frac{3}{2}\\right)}{5} = -3\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}=\\left(-3\\right)\\cdot \\left(-\\frac{3}{2}\\right)=\\frac{9}{2}.\n$$"}] [{:db/id #edb/ref 17592186713383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5a0747-882f-5818-beca-b67fb715c9e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{56}{3}" :db/id #edb/ref 17592186713378} {:answer/id #uuid "7e75a186-9954-5af6-8c17-35039bd84d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186713387} {:answer/id #uuid "8da45463-28a6-5a95-9944-580c5b1154c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186713390} {:answer/id #uuid "930e27ca-56f9-5ccd-9aa8-0ae91d3daed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713391} {:answer/id #uuid "dea936f5-4c15-551c-8dc4-f8fcb7b6c47b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713404}] :answer-field/correct {:answer/id #uuid "dea936f5-4c15-551c-8dc4-f8fcb7b6c47b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713404} :answer-field/id #uuid "d8c902ad-c2d3-50d5-8efd-a82f3aef63f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713401}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "695fb789-d14d-5a24-8f29-8a9a2c5fb717" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}3 \\\\ 1 \\\\ 10\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}2 \\\\ 0 \\\\ 8\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}x_{1}+3x_{2} &= 2 \\\\ x_{2} &= 0 \\\\ 3x_{1}+10x_{2} &= 8\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 3 & 10 & 8\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(3\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 2\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{array}\\right]\n$$\n\nRow $3$ gives $0=2$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."}] [{:db/id #edb/ref 17592186713386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d848c3-ec9d-5403-ad07-e1f7970c2863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713376} {:answer/id #uuid "445d757f-1d1c-566e-b24e-9336addd1dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713380} {:answer/id #uuid "9b5817a6-b947-5d48-9790-2fee9682d2bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186713394} {:answer/id #uuid "9f985dad-acc1-5941-8b38-708921ae9fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713395} {:answer/id #uuid "de6138c3-2180-5c24-b5f9-64cb9d5193f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186713403}] :answer-field/correct {:answer/id #uuid "38d848c3-ec9d-5403-ad07-e1f7970c2863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713376} :answer-field/id #uuid "e221f1a6-9601-5824-a967-dfe6b455354c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713405}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7e4b7932-a5e2-58d4-823b-4920aab927bc" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}2 \\\\ -2 \\\\ -8\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}1 \\\\ -3 \\\\ -6\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}1 \\\\ -1 \\\\ -4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}2x_{1}+x_{2} &= 1 \\\\ -2x_{1}-3x_{2} &= -1 \\\\ -8x_{1}-6x_{2} &= -4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ -2 & -3 & -1 \\\\ -8 & -6 & -4\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ -8 & -6 & -4\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-4\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ 0 & -2 & 0\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{2} &= \\frac{0}{-2} = 0 \\\\ x_{1} &= \\frac{1-\\left(1\\right)\\left(0\\right)}{2} = \\frac{1}{2}\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}=\\left(\\frac{1}{2}\\right)\\cdot \\left(0\\right)=0.\n$$"}] [{:db/id #edb/ref 17592186713397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec0e806-d9a7-5c06-a779-d2afb62c2f95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713374} {:answer/id #uuid "39c76f85-7006-542f-8cbb-a58712cea35f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186713377} {:answer/id #uuid "4579363f-0ffb-5514-a52e-09a68134f799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713381} {:answer/id #uuid "714b3da7-86d8-5da5-b78c-0757db482989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186713384} {:answer/id #uuid "94994ed3-3596-5f3e-9a0b-a8bf6c76b6c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186713392}] :answer-field/correct {:answer/id #uuid "4579363f-0ffb-5514-a52e-09a68134f799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713381} :answer-field/id #uuid "ee0a33e9-823e-5f08-bc6f-51e20e2beb11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713406}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad9ef2fb-ed16-50ac-a85e-128a7ded85f9" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}-1 \\\\ -2 \\\\ 6\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -4\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}4 \\\\ 4 \\\\ -19\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}-x_{1}+x_{2} &= 4 \\\\ -2x_{1}+x_{2} &= 4 \\\\ 6x_{1}-4x_{2} &= -19\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ -2 & 1 & 4 \\\\ 6 & -4 & -19\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(2\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 6 & -4 & -19\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-6\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 0 & 2 & 5\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-2\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 0 & 0 & -3\\end{array}\\right]\n$$\n\nRow $3$ gives $0=-3$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."}] [{:db/id #edb/ref 17592186713402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833465e3-09b8-54ef-a3eb-b19d39eca64d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186713388} {:answer/id #uuid "898c1d59-9685-5b86-beb0-c65de080cb2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713389} {:answer/id #uuid "99d322b0-2d66-5ce4-8c26-ebe7f70f2155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713393} {:answer/id #uuid "c275ab3b-dde4-5541-ba94-a675b9056175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186713398} {:answer/id #uuid "cd82486f-0a39-5be5-a281-a27f609090bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186713399}] :answer-field/correct {:answer/id #uuid "99d322b0-2d66-5ce4-8c26-ebe7f70f2155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713393} :answer-field/id #uuid "d5437794-a220-5c13-af3b-0a06fe18289b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713400}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcf0a2ce-94dd-5338-a060-a69502e0e3c8" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 4\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-3 \\\\ 3 \\\\ 4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}-x_{1}-3x_{2} &= -3 \\\\ x_{1}+2x_{2} &= 3 \\\\ x_{1}+4x_{2} &= 4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 1 & 2 & 3 \\\\ 1 & 4 & 4\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 1 & 4 & 4\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{array}\\right]\n$$\n\nRow $3$ gives $0=1$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."}] [{:db/id #edb/ref 17592186713449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19760ba9-9db5-502d-8d63-3c5fb1086e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713448} {:answer/id #uuid "3ce95a86-06ff-558b-9495-32c2a7c7c866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713450} {:answer/id #uuid "9479c85b-a4e5-50da-982c-ff9b4a609ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713457} {:answer/id #uuid "dcf2e29d-80b8-58c8-a486-f34a36bc6cbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713462} {:answer/id #uuid "eb7a1d3d-9390-54fe-b90a-d2578f3be03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713464}] :answer-field/correct {:answer/id #uuid "eb7a1d3d-9390-54fe-b90a-d2578f3be03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713464} :answer-field/id #uuid "dba638f7-0e13-5bd1-81f3-5d3126b48804" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713461}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29e56cc2-36b7-51bd-bd5d-6d1d8ef616b1" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$. The vectors are\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}3 \\\\ 2 \\\\ k\\end{bmatrix}.\n$$\n\nThe augmented matrix for $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has already been row reduced:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2 \\\\ 2 & -1 & k\\end{array}\\right]\\;\\sim\\;\\left[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k-4\\end{array}\\right]\n$$\n\nUse the last row to decide when the system is consistent." :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1 &=3 \\\\ x_2 &=2 \\\\ 2x_1-x_2 &=k\\end{aligned}\\right.\n$$\n\nThe last row of the supplied row-reduced matrix means $0x_1+0x_2=k-4$. For the system to have a solution, this equation must be $0=0$. Thus\n\n$$\nk-4=0\\quad\\Longrightarrow\\quad k=4.\n$$\n\nThe first two rows give $x_1=3$ and $x_2=2$, so this condition is also sufficient:\n\n$$\n3\\mathbf{a}_1+2\\mathbf{a}_2=\\begin{bmatrix}3 \\\\ 2 \\\\ 4\\end{bmatrix}.\n$$\n\nTherefore, $k=4$ is the only value for which the vector lies in the span."}] [{:db/id #edb/ref 17592186713452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17785160-18b4-5f5b-84c7-847b6dd3b916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186713447} {:answer/id #uuid "613397bc-053a-5297-b0e8-7eb52a6a852a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186713453} {:answer/id #uuid "63dea0a4-2590-5761-8d90-ad50edd0cb81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186713454} {:answer/id #uuid "9d65e62c-8dae-5564-b96f-dbfcf07caf41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186713458} {:answer/id #uuid "c910fee1-23a5-5446-a39c-650adafcc146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186713460}] :answer-field/correct {:answer/id #uuid "9d65e62c-8dae-5564-b96f-dbfcf07caf41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186713458} :answer-field/id #uuid "ea52dcba-48da-5f02-86a6-64d1f83fd3c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713463}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "44beb49c-ecc4-56b4-a0c6-edd3f803e5f6" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}-1 \\\\ 1 \\\\ -2\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}4 \\\\ 5 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1-x_2 &=4 \\\\ 2x_1+x_2 &=5 \\\\ 3x_1-2x_2 &=k\\end{aligned}\\right.\n$$\n\nForm the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 2 & 1 & 5 \\\\ 3 & -2 & k\\end{array}\\right]\n$$\n\nApply $R_2\\leftarrow R_2-2R_1$ and $R_3\\leftarrow R_3-3R_1$:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 0 & 3 & -3 \\\\ 0 & 1 & k-12\\end{array}\\right]\n$$\n\nNext apply $R_2\\leftarrow\\frac{1}{3}R_2$, then $R_3\\leftarrow R_3-R_2$ using the new second row:\n\n$$\n\\left[\\begin{array}{cc|c}1 & -1 & 4 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & k-11\\end{array}\\right]\n$$\n\nThe last row means $0x_1+0x_2=k-11$. Thus consistency requires\n\n$$\nk-11=0\\quad\\Longrightarrow\\quad k=11.\n$$\n\nThe pivot rows give $x_2=-1$ and $x_1=3$, so the condition is sufficient:\n\n$$\n3\\mathbf{a}_1-\\mathbf{a}_2=\\begin{bmatrix}4 \\\\ 5 \\\\ 11\\end{bmatrix}.\n$$\n\nTherefore, $k=11$ is the only value for which the vector lies in the span."}] [{:db/id #edb/ref 17592186713455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0789b12a-1f85-5f9c-9110-4dcc165095df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186713446} {:answer/id #uuid "3ec6dd30-084c-5b50-8027-6486779d6dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186713451} {:answer/id #uuid "73aebeee-5e3d-552a-a8e0-4143e4bd227b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186713456} {:answer/id #uuid "b0f4087d-c2c8-5974-86f7-ddf5a9b3a5c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713459} {:answer/id #uuid "eeba8161-9dcb-50af-a75b-fda8c798e36e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713465}] :answer-field/correct {:answer/id #uuid "3ec6dd30-084c-5b50-8027-6486779d6dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186713451} :answer-field/id #uuid "f832b76b-684c-5168-ab5b-85216772e37e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6c1751f1-f7a5-50d3-b40f-a33e3b4f8011" :question/problem "Find the value of $k$ such that $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$, where\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\qquad\\mathbf{a}_2=\\begin{bmatrix}2 \\\\ 1 \\\\ 4\\end{bmatrix},\\qquad\\mathbf{b}=\\begin{bmatrix}-3 \\\\ 6 \\\\ k\\end{bmatrix}.\n$$\n\n" :question/worked-solution "By definition, $\\mathbf{b}\\in\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ exactly when $x_1\\mathbf{a}_1+x_2\\mathbf{a}_2=\\mathbf{b}$ has a solution. Equating coordinates gives\n\n$$\n\\left\\{\\begin{aligned}x_1+2x_2 &=-3 \\\\ -x_1+x_2 &=6 \\\\ 2x_1+4x_2 &=k\\end{aligned}\\right.\n$$\n\nThe left side of the third equation is twice the left side of the first, so consistency requires $k=2(-3)=-6$. We can verify this by row reduction. Starting with\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & -3 \\\\ -1 & 1 & 6 \\\\ 2 & 4 & k\\end{array}\\right]\n$$\n\napply $R_2\\leftarrow R_2+R_1$ and $R_3\\leftarrow R_3-2R_1$ to obtain\n\n$$\n\\left[\\begin{array}{cc|c}1 & 2 & -3 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & k+6\\end{array}\\right]\n$$\n\nThe last row requires $0=k+6$, hence $k=-6$. The second row gives $x_2=1$, and the first gives $x_1=-5$. These values verify sufficiency:\n\n$$\n-5\\mathbf{a}_1+\\mathbf{a}_2=\\begin{bmatrix}-3 \\\\ 6 \\\\ -6\\end{bmatrix}.\n$$\n\nTherefore, $k=-6$ is the only value for which the vector lies in the span."}] [{:db/id #edb/ref 17592186713472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31dd2988-47f9-54b5-8e70-aefa971fd2bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713468} {:answer/id #uuid "6837d40d-7338-50b4-be78-11d9d65bc410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186713469} {:answer/id #uuid "68db29be-3540-5c51-a707-757e5b60fc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186713470} {:answer/id #uuid "ac5d63fb-8179-56ba-92a2-0bd59f331de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186713471} {:answer/id #uuid "c6177b14-7906-55cf-ab04-045021373363" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}" :db/id #edb/ref 17592186713473}] :answer-field/correct {:answer/id #uuid "ac5d63fb-8179-56ba-92a2-0bd59f331de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186713471} :answer-field/id #uuid "1cdef479-1481-5f86-9d40-ce2b9b1a7c68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713467}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c10cc3bc-065b-5289-9900-2a88e8ac7fde" :question/problem "The vectors $a_{1},a_{2},a_{3}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}\\cdot x_{3}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}+x_{3}a_{3}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}$</div>\n<div>$a_{3}=\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}6 \\\\ 1 \\\\ 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}+x_{3}a_{3}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}2x_{2}+2x_{3} &= 6 \\\\ -3x_{1}+x_{2}-3x_{3} &= 1 \\\\ x_{1}+x_{3} &= 1\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 2 & 2 & 6 \\\\ -3 & 1 & -3 & 1 \\\\ 1 & 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{1}\\leftrightarrow R_{2}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 1 & 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-\\frac{1}{3}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 0 & \\frac{1}{3} & 0 & \\frac{4}{3}\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(\\frac{1}{6}\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 0 & 0 & -\\frac{1}{3} & \\frac{1}{3}\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{3} &= \\frac{\\frac{1}{3}}{-\\frac{1}{3}} = -1 \\\\ x_{2} &= \\frac{6-\\left(2\\right)\\left(-1\\right)}{2} = 4 \\\\ x_{1} &= \\frac{1-\\left(1\\right)\\left(4\\right)-\\left(-3\\right)\\left(-1\\right)}{-3} = 2\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}\\cdot x_{3}=\\left(2\\right)\\cdot \\left(4\\right)\\cdot \\left(-1\\right)=-8.\n$$"}] [{:db/id #edb/ref 17592186713652 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "2ab2cccf-0bb2-54be-9ce0-3c0abc5be8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186713649} {:answer/feedback "Correct. The coordinate system is inconsistent." :answer/id #uuid "6710d9a6-e649-5e6f-8a86-0550e270dcb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713657} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "78683cc2-0462-5abd-92cb-c091eaa949ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713666} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "a42f9ea5-e752-57a1-9570-2deaa0a51218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186713673} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "b18c3309-58d6-5a38-b6d0-f78f92585710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186713674}] :answer-field/correct {:answer/feedback "Correct. The coordinate system is inconsistent." :answer/id #uuid "6710d9a6-e649-5e6f-8a86-0550e270dcb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713657} :answer-field/id #uuid "8cde8873-1bf6-5e5e-8e61-11ad2fe1dfb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713668}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "397ab5f1-714c-50a0-886a-dd99b0d87a5b" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\begin{aligned}\\mathbf{b}&=\\langle -2, 2, -2\\rangle \\\\ \\mathbf{c}&=\\langle -3, -1, 3\\rangle \\\\ \\mathbf{u}&=\\langle 15, 2, -10\\rangle\\end{aligned}\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. Expanding the vector equation gives\n\n$$\n\\left\\{\\begin{aligned}-2s-3t &=15 \\\\ 2s-t &=2 \\\\ -2s+3t &=-10\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}-2 & -3 & 15 \\\\ 2 & -1 & 2 \\\\ -2 & 3 & -10\\end{array}\\right]\n$$\n\nApply $R_2 \\leftarrow R_2-(-1)R_1$, then $R_3 \\leftarrow R_3-(1)R_1$, then $R_3 \\leftarrow R_3-\\left(-\\frac{3}{2}\\right)R_2$:\n\n$$\n\\left[\\begin{array}{cc|c}-2 & -3 & 15 \\\\ 0 & -4 & 17 \\\\ 0 & 0 & \\frac{1}{2}\\end{array}\\right]\n$$\n\nThe last row gives $0=\\frac{1}{2}$, a contradiction. No pair satisfies all three equations. Thus $\\mathbf{u}$ does not lie on $\\Pi$. A product obtained from only two coordinates is not a valid answer."}] [{:db/id #edb/ref 17592186713667 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This uses $s+t$ instead of $s\\cdot t$." :answer/id #uuid "5d358bb8-9917-51d4-aaeb-7c96047880fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713656} {:answer/feedback "The pair $s=0,t=-2$ satisfies all three coordinates; the vector lies on the plane." :answer/id #uuid "6846e198-8e22-5428-8ca2-2e91f853a917" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713658} {:answer/feedback "This uses $s^2+t^2$ instead of $s\\cdot t$." :answer/id #uuid "6fc68ecf-97f3-5c95-bc6d-4965b97abcbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713661} {:answer/feedback "Correct. The common pair satisfies all three equations and gives $s\\cdot t=0$." :answer/id #uuid "7691cdd3-7761-5524-ba89-8b3617873584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713665} {:answer/feedback "This uses $s-t$ instead of $s\\cdot t$." :answer/id #uuid "b2a59cc9-3021-5c24-8c5c-4fc559c55718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186713676}] :answer-field/correct {:answer/feedback "Correct. The common pair satisfies all three equations and gives $s\\cdot t=0$." :answer/id #uuid "7691cdd3-7761-5524-ba89-8b3617873584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713665} :answer-field/id #uuid "5121c8ed-3e06-5e06-8005-63a610a406a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713654}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8496c6a9-e8f5-5ea8-a3eb-410a86fc5225" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\begin{aligned}\\mathbf{b}&=\\langle -2, -1, -2\\rangle \\\\ \\mathbf{c}&=\\langle -1, -3, 1\\rangle \\\\ \\mathbf{u}&=\\langle 2, 6, -2\\rangle\\end{aligned}\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. Expanding the vector equation gives\n\n$$\n\\left\\{\\begin{aligned}-2s-t &=2 \\\\ -s-3t &=6 \\\\ -2s+t &=-2\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}-2 & -1 & 2 \\\\ -1 & -3 & 6 \\\\ -2 & 1 & -2\\end{array}\\right]\n$$\n\nApply $R_2 \\leftarrow R_2-\\left(\\frac{1}{2}\\right)R_1$, then $R_3 \\leftarrow R_3-(1)R_1$, then $R_3 \\leftarrow R_3-\\left(-\\frac{4}{5}\\right)R_2$:\n\n$$\n\\left[\\begin{array}{cc|c}-2 & -1 & 2 \\\\ 0 & -\\frac{5}{2} & 5 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nThe last row is $0=0$, so it adds no restriction. Back substitute in the two nonzero rows:\n\n$$\n\\begin{aligned}t&=\\frac{5}{-\\frac{5}{2}}=-2 \\\\ s&=\\frac{2-(-1)(-2)}{-2}=0\\end{aligned}\n$$\n\nVerify every coordinate:\n\n$$\n\\begin{aligned}(0)(-2)+(-2)(-1)&=2=2 \\\\ (0)(-1)+(-2)(-3)&=6=6 \\\\ (0)(-2)+(-2)(1)&=-2=-2\\end{aligned}\n$$\n\nAll three coordinates agree, so the vector lies on the plane. Therefore,\n\n$$\ns\\cdot t=(0)\\cdot(-2)=0.\n$$"}] [{:db/id #edb/ref 17592186713678 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Correct. The coordinate system is inconsistent." :answer/id #uuid "28738f3c-3a3b-5f3d-a6aa-50cb4e0f13ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713648} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "35ab9ab8-b60c-5dd8-b84a-10f94d5b3491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186713651} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "5a1fd843-a892-5d68-a1bc-03b05a719513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713655} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "7339d2a2-5161-5528-81ed-ce73e38fab83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713663} {:answer/feedback "Check all three coordinates before giving a product; the system has no common solution." :answer/id #uuid "f98189a4-d135-5e50-bf2c-dfccb96c4bdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713680}] :answer-field/correct {:answer/feedback "Correct. The coordinate system is inconsistent." :answer/id #uuid "28738f3c-3a3b-5f3d-a6aa-50cb4e0f13ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\mathbf{u}$ does not lie on $\\Pi$" :db/id #edb/ref 17592186713648} :answer-field/id #uuid "2daaf91f-9d4c-5640-bd18-fea3ac6f7e25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713650}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec1392b1-fa17-5e2e-b673-e3d4d9a2a12d" :question/problem "Determine whether $\\mathbf{u}$ lies on the plane $\\Pi:\\mathbf{r}=s\\mathbf{b}+t\\mathbf{c}$, where $s,t\\in\\mathbb{R}$ and\n\n$$\n\\begin{aligned}\\mathbf{b}&=\\langle 3, -2, 1\\rangle \\\\ \\mathbf{c}&=\\langle 2, -1, 3\\rangle \\\\ \\mathbf{u}&=\\langle 2, -1, -4\\rangle\\end{aligned}\n$$\n\nIf it does, select the value of $s\\cdot t$ in $\\mathbf{u}=s\\mathbf{b}+t\\mathbf{c}$. Otherwise, select the statement that $\\mathbf{u}$ does not lie on $\\Pi$." :question/worked-solution "By definition, $\\mathbf{u}\\in\\Pi$ exactly when the same values of $s$ and $t$ satisfy all three coordinate equations. Expanding the vector equation gives\n\n$$\n\\left\\{\\begin{aligned}3s+2t &=2 \\\\ -2s-t &=-1 \\\\ s+3t &=-4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix:\n\n$$\n\\left[\\begin{array}{cc|c}3 & 2 & 2 \\\\ -2 & -1 & -1 \\\\ 1 & 3 & -4\\end{array}\\right]\n$$\n\nApply $R_2 \\leftarrow R_2-\\left(-\\frac{2}{3}\\right)R_1$, then $R_3 \\leftarrow R_3-\\left(\\frac{1}{3}\\right)R_1$, then $R_3 \\leftarrow R_3-(7)R_2$:\n\n$$\n\\left[\\begin{array}{cc|c}3 & 2 & 2 \\\\ 0 & \\frac{1}{3} & \\frac{1}{3} \\\\ 0 & 0 & -7\\end{array}\\right]\n$$\n\nThe last row gives $0=-7$, a contradiction. No pair satisfies all three equations. Thus $\\mathbf{u}$ does not lie on $\\Pi$. A product obtained from only two coordinates is not a valid answer."}] [{:db/id #edb/ref 17592186713679 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Correct. The common pair satisfies all three equations and gives $s\\cdot t=-3$." :answer/id #uuid "42b99840-4e1a-5ce7-a8ac-f183adf96f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713653} {:answer/feedback "This uses $s+t$ instead of $s\\cdot t$." :answer/id #uuid "6acfcd37-40eb-5a7a-b7db-dfad25fa5463" :answer/type 