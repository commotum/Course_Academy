+9{x}_{2} &=-8 \\\\ -2{x}_{1}+10{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ -4 & 9 & -8 \\\\ -2 & 10 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ -2 & 10 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 6 & k+6\\end{array}\\right] & {R}_{3} & :={R}_{3}-6{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & k-18\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-18.$ Therefore, the system has a solution only if\n\n$$\n0=k-18\\,⇒\\,k=18.\n$$"}] [{:db/id #edb/ref 17592186342237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ea0212-0c8f-50de-a9e9-986f267bdb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339138} {:answer/id #uuid "25b09d72-beeb-56f8-b3c5-bd45509568ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186339451} {:answer/id #uuid "392acaa5-a047-5743-bd68-0e133d8bead9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186339642} {:answer/id #uuid "c4734975-ddc9-5119-b9e9-59e873e223ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186340873} {:answer/id #uuid "d55e6034-4f45-5b74-b206-75e90bc1aef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186341016}] :answer-field/correct {:answer/id #uuid "00ea0212-0c8f-50de-a9e9-986f267bdb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339138} :answer-field/id #uuid "690b25a1-892c-577b-b6f7-6ff437d6dcd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341563}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e12a2efc-9d88-56c5-96b5-ec530d76269d" :question/math-academy-id "q-74594" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ 2 \\\\ -1\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ -5 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-2 \\\\ 2 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}9 \\\\ -5 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2} &=9 \\\\ 3{x}_{1}+2{x}_{2} &=-5 \\\\ 2{x}_{1}-{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & -2 & 9 \\\\ 3 & 2 & -5 \\\\ 2 & -1 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 2 & -1 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 0 & 3 & k-18\\end{array}\\right] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 3 & k-18\\end{array}\\right] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & k-6\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$"}] [{:db/id #edb/ref 17592186342238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dc6fae0-6fc8-5ce6-8524-68dfcc8dcd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186340263} {:answer/id #uuid "d804a124-1946-56c4-a682-7985f9351701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186341044} {:answer/id #uuid "eabc7ef9-665b-5387-a4c7-5e2ca3d36188" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186341200} {:answer/id #uuid "eec7a1c7-8ad3-5a27-876f-0162e54d2cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186341235} {:answer/id #uuid "f54514a3-c908-5fb8-b5c9-a864f0c8a55b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186341290}] :answer-field/correct {:answer/id #uuid "d804a124-1946-56c4-a682-7985f9351701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186341044} :answer-field/id #uuid "c44d1be5-bc0f-5bba-aed3-5e89db45d7c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341722}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "329f79c0-9230-5c7a-8435-3cce24f63578" :question/math-academy-id "q-74596" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}6 \\\\ -2 \\\\ 10\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-8 \\\\ 3 \\\\ -12\\end{bmatrix},\\,b=\\begin{bmatrix}-3 \\\\ -9 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}6 \\\\ -2 \\\\ 10\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-8 \\\\ 3 \\\\ -12\\end{bmatrix} & =\\begin{bmatrix}-3 \\\\ -9 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}6{x}_{1}-8{x}_{2} &=-3 \\\\ -2{x}_{1}+3{x}_{2} &=-9 \\\\ 10{x}_{1}-12{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}6 & -8 & -3 \\\\ -2 & 3 & -9 \\\\ 10 & -12 & k\\end{array}\\right] & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 3 & -9 \\\\ 6 & -8 & -3 \\\\ 10 & -12 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 10 & -12 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 3 & k-45\\end{array}\\right] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 0 & k+45\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+45.$ Therefore, the system has a solution only if\n\n$$\n0=k+45\\,⟹\\,k=-45.\n$$"}] [{:db/id #edb/ref 17592186342239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b030142-b351-5e7f-9981-3a7a900479a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339506} {:answer/id #uuid "a7085a93-27ed-53b5-a303-a8fca730844d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340645} {:answer/id #uuid "b4affd08-9db3-5c2c-982f-d4b5