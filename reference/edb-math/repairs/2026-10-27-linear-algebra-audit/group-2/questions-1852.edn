\\\ -4 & 7 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 3 \\\\ 0 & 1 & 5 \\\\ 0 & 3 & k+12\\end{array}\\right] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 3 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & k-3\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-3.$ Therefore, the system has a solution only if\n\n$$\n0=k-3\\,⇒\\,k=3.\n$$"}] [{:db/id #edb/ref 17592186342230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ad9e02-0e28-5883-8383-80771f092ba1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186339164} {:answer/id #uuid "429c3c68-2ae7-53e0-b37e-d3c96ecd5672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186339712} {:answer/id #uuid "7407de37-953c-52c3-9691-7a1948812671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186340155} {:answer/id #uuid "9c61980b-b3a4-5a5c-866f-cfae9f4280c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340538} {:answer/id #uuid "ff51d081-de5e-5605-93dc-c11008dd57a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186341379}] :answer-field/correct {:answer/id #uuid "9c61980b-b3a4-5a5c-866f-cfae9f4280c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340538} :answer-field/id #uuid "bf553037-64a2-590c-b4fb-05bae9f5c8de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341709}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cef0a842-c20f-55db-9989-525f1aca72a5" :question/math-academy-id "q-74558" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ -5 \\\\ -4\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 1 \\\\ k\\end{bmatrix}.\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}2 \\\\ 3 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-4 \\\\ -5 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 1 \\\\ k\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}-4{x}_{2} &=0 \\\\ 3{x}_{1}-5{x}_{2} &=1 \\\\ 2{x}_{1}-4{x}_{2} &=k\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}2 & -4 & 0 \\\\ 3 & -5 & 1 \\\\ 2 & -4 & k\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 0 \\\\ 3 & -5 & 1 \\\\ 2 & -4 & k\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 0 \\\\ 0 & 1 & 1 \\\\ 2 & -4 & k\\end{array}\\right] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & k\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k.$ Therefore, the system has a solution only if\n\n$$\nk=0.\n$$"}] [{:db/id #edb/ref 17592186342231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4823cb09-c970-5693-9e2b-8bd1376d913d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186339771} {:answer/id #uuid "80e4ce86-252f-55b0-9c33-fb68673d04ae" :answer/type {:db/id #ed