d}[P\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 5 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{1}:={R}_{1}+(-5){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & -5 \\\\ 0 & 1 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{P}^{-1}=\\begin{bmatrix}1 & -5 \\\\ 0 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186436526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b54b601-afa4-54fb-9b81-8e1a343fbbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186436484} {:answer/id #uuid "722609aa-a0d5-5e3b-9591-7ee5f0d9b3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436490} {:answer/id #uuid "74fbade3-24cf-5469-a14c-c1b53476a0da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -6 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436491} {:answer/id #uuid "a943f519-fb72-5834-9e86-9b373dc13537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & 6\\end{bmatrix}" :db/id #edb/ref 17592186436500} {:answer/id #uuid "afe75d39-2b1f-5943-9262-25e98dd52004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & -6\\end{bmatrix}" :db/id #edb/ref 17592186436502}] :answer-field/correct {:answer/id #uuid "3b54b601-afa4-54fb-9b81-8e1a343fbbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 6\\end{bmatrix}" :db/id #edb/ref 17592186436484} :answer-field/id #uuid "57d2ad5f-fd97-5e2d-883f-36f12c7f88c8" :answer-field/key "selection" :answer-field/type {:db