82e5-5e0a-9493-269c69c2ba02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436495} {:answer/id #uuid "bcbeb476-106e-56ab-bc8d-5ea75f68ee56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186436504} {:answer/id #uuid "f3f4c4eb-37ab-559c-af8f-9eacddcde995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436515}] :answer-field/correct {:answer/id #uuid "8d99ac86-82e5-5e0a-9493-269c69c2ba02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436495} :answer-field/id #uuid "a181bc03-12d6-5f9e-af68-66c71236d0b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436523}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c2f3128b-e14c-5d17-b8ee-71ffa4c47e70" :question/math-academy-id "q-130825" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & -1 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{1}:={R}_{1}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 1 \\\\ -1 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186436531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd0fc74-bae7-5ca6-8b3d-6e3dc367d94c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 4 \\\\ 6 & 25\\end{bmatrix}" :db/id #edb/ref 17592186436476} {:answer/id #uuid "154c032f-809a-5efc-89c5-4f1d4dd4d1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}25 & 4 \\\\ 6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436479} {:answer/id #uuid "226082c9-2e79-5379-b639-80b5394d6a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 6 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186436480} {:answer/id #uuid "d335ae16-8497-5078-b422-95a4ecd43940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 6 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186436512} {:answer/id #uuid "f8657687-c509-5554-80a8-e863a3769213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 6 \\\\ 4 & 25\\end{bmatrix}" :db/id #edb/ref 17592186436516}] :answer-field/correct {:answer/id #uuid "f8657687-c509-5554-80a8-e863a3769213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 6 \\\\ 4 & 25\\end{bmatrix}" :db/id #edb/ref 17592186436516} :answer-field/id #uuid "3a5a16fb-2a91-54b4-a37d-03216a65fec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436521}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf425079-a50e-5390-afb0-f23f208d7e4f" :question/math-academy-id "q-73648" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ -4 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{2}:={R}_{2}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & 4 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{1}^{-1} & =\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}1 & 6 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 6 \\\\ 4 & 25\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186551259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359a8301-f2b5-525c-9c59-3eca56ed7220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550498} {:answer/id #uuid "954ac438-6aab-5e66-944b-f44c338618fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186550741} {:answer/id #uuid "a5bc2cfa-37ac-5ab0-91e9-e6abbac4d269" :answer/type {:db/id #edb/ref 175921