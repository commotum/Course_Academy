array}{cc|cc}1 & 0 & 1 & 0 \\\\ 1 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & -1 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=\\begin{bmatrix}1 & 0 \\\\ -6 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ -7 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186400499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4f8308-7466-5b10-aeb8-3c645cd76aac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472658} {:answer/id #uuid "6ef72410-bf24-549a-a67f-ebdeb7154ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472659}] :answer-field/correct {:answer/id #uuid "7d4f8308-7466-5b10-aeb8-3c645cd76aac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472658} :answer-field/id #uuid "db31b420-a5f5-58e8-97fd-f9e9cb76ee53" :answer-field/key "$P=\\begin{bmatrix}1 & 1 \\\\ -3 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473724} {:answer-field/choices [{:answer/id #uuid "bee9e24a-602d-5c0c-98ca-cdd5fbae2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472660} {:answer/id #uuid "dc7362ee-1b3c-5b7d-b741-5aaa54d8f01e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472661}] :answer-field/correct {:answer/id #uuid "bee9e24a-602d-5c0c-98ca-cdd5fbae2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/i