1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix} \\\\  & =S\\end{aligned}\n$$\n\nTherefore, only $S$ is an elementary matrix."}] [{:db/id #edb/ref 17592186400506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} {:answer/id #uuid "bcb5e1b1-f89e-5daa-85b2-e0dde4da66b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472665}] :answer-field/correct {:answer/id #uuid "4c34442a-1ba5-50e6-9956-6c60c53a175d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472664} :answer-field/id #uuid "61214d2d-44ba-553b-b6a3-330618cebbc3" :answer-field/key "$A=\\begin{bmatrix}3 & -2 \\\\ 5 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473727} {:answer-field/choices [{:answer/id #uuid "41438b30-61cc-5947-860b-7cfc8403798e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472666} {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667}] :answer-field/correct {:answer/id #uuid "341c504d-f433-56b8-84a8-a8071aab725e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472667} :answer-field/id #uuid "404fba34-ac4e-5d8f-94be-c73393320824" :answer-field/key "$B=\\begin{bmatrix}4 & 0 \\\\ 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473728} {:answer-field/choices [{:an