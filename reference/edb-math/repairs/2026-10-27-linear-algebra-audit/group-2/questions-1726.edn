564c-5a88-83a5-7aa534682710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474752} {:answer/id #uuid "a20e1d2b-1cc4-5391-9806-84714901dfaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474753}] :answer-field/correct {:answer/id #uuid "a20e1d2b-1cc4-5391-9806-84714901dfaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474753} :answer-field/id #uuid "c6983834-6f71-5348-96c0-e1bdfc142faa" :answer-field/key "$E=\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475302} {:answer-field/choices [{:answer/id #uuid "b099eb91-9ca5-5c85-a7d5-72eff2354b80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474754} {:answer/id #uuid "263a88ac-61b5-5e85-ad17-92c76acc9730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474755}] :answer-field/correct {:answer/id #uuid "b099eb91-9ca5-5c85-a7d5-72eff2354b80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474754} :answer-field/id #uuid "beaa7087-789c-5fc6-91c3-ada531bbfec4" :answer-field/key "$F=\\begin{bmatrix}1 & 1 \\\\ 1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73b54284-6d5f-5b76-a388-21fc0778bb8a" :question/math-academy-id "q-31889" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $D$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $E$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:={R}_{2}+2{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\n- The matrix $F$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\nTherefore, only $E$ is an elementary matrix."}] [{:db/id #edb/ref 17592186436528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d928832-0507-5fdf-88b2-89972940e5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436475} {:answer/id #uuid "1255b6e9-ff95-561b-b9f3-8ded22368554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436478} {:answer/id #uuid "702fbf57-e626-5e53-9e98-7e555e45d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436489} {:answer/id #uuid "8b9d9eea-15de-5c1d-ae98-366b6c4fc7bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436494} {:answer/id #uuid "9ff5fc1a-d5a0-51b3-8cf3-52c45c688cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186436