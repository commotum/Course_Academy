92186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467529}] :answer-field/correct {:answer/id #uuid "7191e2a0-f178-5d00-aec5-334b5b5b342d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467528} :answer-field/id #uuid "cd3c5d47-0088-54ee-b2a3-b8323cc401fa" :answer-field/key "$W=\\begin{bmatrix}0 & 1 \\\\ 1 & 7\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468485}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9df20933-ebce-545d-be35-aa9a6fe179d6" :question/math-academy-id "q-42751" :question/problem "Which of the following are elementary matrices?\n\nSelect all that apply." :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $Q$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:=3{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{2}:=3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =Q\\end{aligned}\n$$\n\n- The matrix $W$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $E$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{1}:={R}_{1}+(-4){R}_{2},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} &  & {R}_{1}:={R}_{1}+(-4){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -4 \\\\ 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, only $Q$ and $E$ are elementary matrices."}] [{:db/id #edb/ref 17592186342047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2efe0c-05bd-54a2-ad27-5673aa4673e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186339225} {:answer/id #uuid "0d6acaee-7b21-52bc-b61d-bf44adce4a22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & -\\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186339251} {:answer/id #uuid "183b5978-21ac-58bc-888c-401516b804c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186339344} {:answer/id #uuid "1d43d413-f3a6-5f92-ac72-43eedbb002e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186339384} {:answer/id #uuid "98466e5f-11ec-5032-be54-034e13be0da4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186340497}] :answer-field/correct {:answer/id #uuid "183b5978-21ac-58bc-888c-401516b804c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186339344} :answer-field/id #uuid "6498bfec-7329-5fea-a382-cf6cfdeff4c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341555}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ffb15942-22d3-5f36-91a0-c39f9d76e946" :question/math-academy-id "q-73642" :question/problem "Find the inverse of the elementary matrix \n$$\n\\displaystyle G=\\begin{bmatrix}-\\frac{3}{2} & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We write down $G$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[G\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}-\\frac{3}{2} & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{1}:=-\\frac{2}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & -\\frac{2}{3} & 0 \\\\ 0 & 1 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{G}^{-1}=\\begin{bmatrix}-\\frac{2}{3} & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186342048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1391b4fd-9cca-5da8-baf8-6d340c7d4016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186339301} {:answer/id #uuid "8a0d676c-a633-5d1a-bb13-280eb2401f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -8 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186340362} {:answer/id #uuid "bd6cfc1a-3bf2-56f7-a96b-03e2e6292f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -\\frac{1}{8} & 1\\end{bmatrix}" :db/id #edb/ref 17592186340819} {:answer/id #uuid "c6d7aba8-c8d2-5cc4-a762-754794c37e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186340889} {:answer/id #uuid "daed1698-ddd3-5099-ad1e-89ca2e5dae0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{1}{8} & 1\\end{bmatrix}" :db/id #edb/ref 17592186341073}] :answer-field/correct {:answer/id #uuid "1391b4fd-9cca-5da8-baf8-6d340c7d4016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186339301} :answer-field/id #uuid "ca7ed00f-c32a-55d0-bf66-b80337cbdee9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341735}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ae3d569-e0d6-5d3d-9c5e-94e5b9fd437b" :question/math-academy-id "q-73646" :question/problem "Find the inverse of the elementary matrix \n$$\n\\displaystyle K=\\begin{bmatrix}1 & 0 \\\\ 8 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We write down $K$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[K\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 8 & 1 & 0 & 1\\end{array}\\right] &  & {R}_{2}:={R}_{2}+(-8){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & -8 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{K}^{-1}=\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186342049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83492424-920b-57cd-af61-ba623f57ae3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186340309} {:answer/id #uuid "a427d688-565d-53d1-b8fd-e30111538319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 3 \\\\ 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186340617} {:answer/id #uuid "a85df999-36e6-5904-90aa-ef8fb7e9f7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 0 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186340657} {:answer/id #uuid "ca7fd710-5ec3-5eb4-8da8-2bcceb41a777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & -1\\end{bmatrix}" :db/id #edb/ref 17592186340921} {:answer/id #uuid "f7492f13-1197-54f9-9aa1-0d629e866114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186341315}] :answer-field/correct {:answer/id #uuid "f7492f13-1197-54f9-9aa1-0d629e866114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186341315} :answer-field/id #uuid "dfa3d820-5e84-505b-89c4-ef77e5bd5391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd46d64d-aaae-5435-b750-329b869c363c" :question/math-academy-id "q-73651" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix},\\,{E}_{2}=\\begin{bmatrix}1 & 0 \\\\ 0 & -\\frac{1}{4}\\end{bmatrix}.\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & -\\frac{1}{4} & 0 & 1\\end{array}\\right] &  & {R}_{2}:=(-4){R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|cc}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & -4\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 3 & -4\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186388153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d64c95a-81ba-59a6-bf83-5a767c86bf1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{1}{2} & 1\\end{bmatrix}" :db/id #edb/ref 17592186388155} {:answer/id #uuid "0a03eae7-4d43-591d-b900-3a7d7fb90b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & \\frac{1}{2} \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186388156} {:answer/id #uuid "50dfac96-9a7b-5bd5-a734-ade19e95361d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186388157} {:answer/id #uuid "10f05efa-3c60-59ae-934f-69e435732cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186388158} {:answer/id #uuid "e9171e6a-f0d0-54c5-8b15-13f958570956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 1 & \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186388159}] :answer-field/correct {:answer/id #uuid "3d64c95a-81ba-59a6-bf83-5a767c86bf1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{1}{2} & 1\\end{bmatrix}" :db/id #edb/ref 17592186388155} :answer-field/id #uuid "6c56f01f-7a13-599b-81cc-be3bebf20617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388154}] :question/dif