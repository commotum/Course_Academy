egin{bmatrix}4 & -2 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -2 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, since ${A}^{4}={A}^{2}\\cdot {A}^{2},$ we get\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =\\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}146 & -130 \\\\ 65 & -49\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635}] :answer-field/correct {:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635} :answer-field/id #uuid "6eb78f3a-36e5-5305-b6cb-2c5f0c33edd8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294318} {:answer-field/choices [{:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293302}] :answer-field/correct {:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293302} :answer-field/id #uuid "878b519a-9848-5864-b294-4a97244a614d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294412} {:answer-field/choices [{:answer/id #uuid "80a53002-fac7-5fa3-b9bb-fc880c2ae565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293450}] :answer-field/correct {:answer/id #uuid "80a53002-fac7-5fa3-b9bb-fc880c2ae565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293450} :answer-field/id #uuid "e87a6e92-ea2b-5d15-8aeb-33ed594d4c37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294749} {:answer-field/choices [{:answer/id #uuid "8e70978d-817b-58a4-9e22-a0e67916282a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186293483}] :answer-field/correct {:answer/id #uuid "8e70978d-817b-58a4-9e22-a0e67916282a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186293483} :answer-field/id #uuid "f63c9854-5a31-5e11-a464-989d7cde4a32" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294794}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa44b764-43be-5630-bb00-0e547cc2b254" :question/math-academy-id "q-279481" :question/problem "Consider the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}.$ If $f(X)={X}^{2}+2X+2$, find $f(A).$\n\n| $f(A)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+2X+2 \\\\  & ={X}^{2}+2X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+2A+2I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+2I \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}+2\\begin{bmatrix}2 & -1 \\\\ 0 & 3\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -5 \\\\ 0 & 9\\end{bmatrix}+\\begin{bmatrix}4 & -2 \\\\ 0 & 6\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+4+2 & -5+(-2)+0 \\\\ 0+0+0 & 9+6+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & -7 \\\\ 0 & 17\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1edb7101-b917-5e90-889e-728140e2f236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293059}] :answer-field/correct {:answer/id #uuid "1edb7101-b917-5e90-889e-728140e2f236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293059} :answer-field/id #uuid "47953371-e2a3-5b62-a292-fc745ed5c6eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294183} {:answer-field/choices [{:answer/id #uuid "31ae1d39-21b9-5f62-9ebc-cf3d93e071d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293141}] :answer-field/correct {:answer/id #uuid "31ae1d39-21b9-5f62-9ebc-cf3d93e071d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293141} :answer-field/id #uuid "4d706eca-c550-5c7c-9ec1-b9ef5a6fd7fc" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294200} {:answer-field/choices [{:answer/id #uuid "98e3c8e3-fdf8-5b7b-b52d-4e5065562689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293533}] :answer-field/correct {:answer/id #uuid "98e3c8e3-fdf8-5b7b-b52d-4e5065562689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293533} :answer-field/id #uuid "5197ccdf-ad83-5948-81bd-7a636473de04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294219} {:answer-field/choices [{:answer/id #uuid "413bb6cd-83bd-59a4-a684-e14208adafa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293198}] :answer-field/correct {:answer/id #uuid "413bb6cd-83bd-59a4-a684-e14208adafa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293198} :answer-field/id #uuid "8f291b59-3c7d-5599-a542-590f9ead574b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294445}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5da85e9e-1563-5727-987f-c0454bf0e4f4" :question/math-academy-id "q-279485" :question/problem "Consider the matrix $D=\\begin{bmatrix}3 & -2 \\\\ 0 & 1\\end{bmatrix}.$ If $f(X)={X}^{2}-X-2$, find $f(D).$\n\n| $f(D)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-X-2 \\\\  & ={X}^{2}-X-2I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-D-2I.$\n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -8 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-D-2I \\\\  & =\\begin{bmatrix}9 & -8 \\\\ 0 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -2 \\\\ 0 & 1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -8 \\\\ 0 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -2 \\\\ 0 & 1\\end{bmatrix}-\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}9-3-2 & -8-(-2)-0 \\\\ 0-0-0 & 1-1-2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -6 \\\\ 0 & -2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6034546-7d4e-5c51-9fd2-f41fcfef04a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293585}] :answer-field/correct {:answer/id #uuid "a6034546-7d4e-5c51-9fd2-f41fcfef04a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293585} :answer-field/id #uuid "1428d1b1-1543-5a2a-9556-2cee443c52dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293995} {:answer-field/choices [{:answer/id #uuid "26a75419-4630-5608-bb8c-21f42f59fc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293101}] :answer-field/correct {:answer/id #uuid "26a75419-4630-5608-bb8c-21f42f59fc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293101} :answer-field/id #uuid "4dd27018-7e5e-55e0-a7db-154856c32454" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294202} {:answer-field/choices [{:answer/id #uuid "f82b6ae6-019e-5945-bcdb-f89f1c5c18ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293903}] :