t 1+(-1)\\cdot 1=0 \\\\ (A^2)_{22} &= 1\\cdot 1+0\\cdot 0+(-1)\\cdot 1=0 \\\\ (A^2)_{23} &= 1\\cdot (-1)+0\\cdot (-1)+(-1)\\cdot 0=-1 \\\\ (A^2)_{31} &= 1\\cdot 1+1\\cdot 1+0\\cdot 1=2 \\\\ (A^2)_{32} &= 1\\cdot 1+1\\cdot 0+0\\cdot 1=1 \\\\ (A^2)_{33} &= 1\\cdot (-1)+1\\cdot (-1)+0\\cdot 0=-2\\end{aligned}\n$$\n\nThus,\n\n$$\nA^2=\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 0 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}.\n$$\n\nNow use $A^3=A^2\\cdot A$:\n\n$$\nA^3=\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 0 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 & -1 \\\\ 1 & 0 & -1 \\\\ 1 & 1 & 0\\end{bmatrix}\n$$\n\nCompute the entries by row-by-column products:\n\n$$\n\\begin{aligned}(A^3)_{11} &= 1\\cdot 1+0\\cdot 1+(-2)\\cdot 1=-1 \\\\ (A^3)_{12} &= 1\\cdot 1+0\\cdot 0+(-2)\\cdot 1=-1 \\\\ (A^3)_{13} &= 1\\cdot (-1)+0\\cdot (-1)+(-2)\\cdot 0=-1 \\\\ (A^3)_{21} &= 0\\cdot 1+0\\cdot 1+(-1)\\cdot 1=-1 \\\\ (A^3)_{22} &= 0\\cdot 1+0\\cdot 0+(-1)\\cdot 1=-1 \\\\ (A^3)_{23} &= 0\\cdot (-1)+0\\cdot (-1)+(-1)\\cdot 0=0 \\\\ (A^3)_{31} &= 2\\cdot 1+1\\cdot 1+(-2)\\cdot 1=1 \\\\ (A^3)_{32} &= 2\\cdot 1+1\\cdot 0+(-2)\\cdot 1=0 \\\\ (A^3)_{33} &= 2\\cdot (-1)+1\\cdot (-1)+(-2)\\cdot 0=-3\\end{aligned}\n$$\n\nThus,\n\n$$\nA^3=\\begin{bmatrix}-1 & -1 & -1 \\\\ -1 & -1 & 0 \\\\ 1 & 0 & -3\\end{bmatrix}.\n$$\n"}] [{:db/id #edb/ref 17592186719772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e53916-b27a-5ccc-bddf-b47a932dcb00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719767}] :answer-field/correct {:answer/id #uuid "42e53916-b27a-5ccc-bddf-b47a932dcb00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186719767} :answer-field/id #uuid "09f1eb65-e07e-5040-ac6d-87fda4e1c674" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719762} {:answer-field