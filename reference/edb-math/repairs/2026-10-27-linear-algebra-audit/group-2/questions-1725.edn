^{4}={Z}^{2}\\cdot {Z}^{2},$ we get\n\n$$\n\\begin{aligned}{Z}^{4} & ={Z}^{2}\\cdot {Z}^{2} \\\\  & =\\begin{bmatrix}6 & 2 \\\\ 1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}6 & 2 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}38 & 18 \\\\ 9 & 11\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bff18ab-5790-5f68-bae6-cdddbf33e3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 6 & -4 \\\\ 1 & 2 & -1 \\\\ -1 & -4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186345742} {:answer/id #uuid "5cc35f77-20dd-54f0-809e-37a397353b07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -1 \\\\ -1 & -4 & 5 \\\\ 2 & 6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186346143} {:answer/id #uuid "81a80d41-0732-5b94-aa08-c17655e12741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 3 & -4 \\\\ -1 & -1 & 5\\end{bmatrix}" :db/id #edb/ref 17592186346484} {:answer/id #uuid "ea0faef8-8b4a-5cc2-a2c8-4e9b130a74fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 & -1 \\\\ 6 & 2 & -4 \\\\ -1 & -4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186347417} {:answer/id #uuid "fba24c72-18f5-52fe-851e-5a8ec616701b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 6 & -4 \\\\ -1 & -4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186347570}] :answer-field/correct {:answer/id #uuid "fba24c72-18f5-52fe-851e-5a8ec616701b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 6 & -4 \\\\ -1 & -4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186347570} :answer-field/id #uuid "4e104d47-09d8-5927-9ddf-70aec5525b12" :answer-field/key "selection" :an