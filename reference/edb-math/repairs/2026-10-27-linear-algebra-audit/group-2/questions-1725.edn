nswer.type/math} :answer/value "-1" :db/id #edb/ref 17592186719745} :answer-field/id #uuid "c9a41506-859f-5975-810d-d2b714d4841c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719753}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b54376e-e842-58aa-8fcf-49b02d7645a2" :question/problem "Consider the matrix $A=\\begin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}$. Find $A^2$.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$A^2=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First multiply the matrix by itself:\n\n$$\nA^2=\\begin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}\n$$\n\nCompute the entries by row-by-column products:\n\n$$\n\\begin{aligned}(A^2)_{11} &= (-1)\\cdot (-1)+(-1)\\cdot 2=-1 \\\\ (A^2)_{12} &= (-1)\\cdot (-1)+(-1)\\cdot 2=-1 \\\\ (A^2)_{21} &= 2\\cdot (-1)+2\\cdot 2=2 \\\\ (A^2)_{22} &= 2\\cdot (-1)+2\\cdot 2=2\\end{aligned}\n$$\n\nThus,\n\n$$\nA^2=\\begin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}.\n$$\n"}] [{:db/id #edb/ref 17592186719728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79d028c8-38c3-53fb-8d71-65c578e170a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719740}] :answer-field/correct {:answer/id #uuid "79d028c8-38c3-53fb-8d71-65c578e170a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719740} :answer-field/id #uuid "0842fcb2-fca0-56a8-a74d-a5401827e44a" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref