} \\\\  & =\\begin{bmatrix}3 & -3 \\\\ 3 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -3 \\\\ 3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -9 \\\\ 9 & -9\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186629332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd03b721-f261-58dd-9f24-9ae0df640031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186629127}] :answer-field/correct {:answer/id #uuid "fd03b721-f261-58dd-9f24-9ae0df640031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186629127} :answer-field/id #uuid "61b6e8f8-a7a2-5691-bbf0-33be4f81c20f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629178} {:answer-field/choices [{:answer/id #uuid "099ba8d1-09e5-5a60-80b7-7a46ff8a57af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186628724}] :answer-field/correct {:answer/id #uuid "099ba8d1-09e5-5a60-80b7-7a46ff8a57af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186628724} :answer-field/id #uuid "652f2d6a-9aff-5d19-b481-386c22817e87" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629180} {:answer-field/choices [{:answer/id #uuid "13ea2c42-844f-5687-af6d-03c8be327333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186628741}] :answer-field/correct {:answer/id #uuid "13ea2c42-844f-5687-af6d-03c8be327333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186628741} :answer-field/id #uuid "dff0bcc0-7743-5c6d-ac6d-fd033b3ee793" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629232} {:answer-field/choices [{:answer/id #uuid "d709ad8f-e81b-50f1-9954-df85990f51d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186629068}] :answer-field/correct {:answer/id #uuid "d709ad8f-e81b-50f1-9954-df85990f51d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186629068} :answer-field/id #uuid "e7d9628f-ea16-5036-ae76-99cec0bc8878" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629239}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c68e683e-334e-5304-baec-132bf6fa50ca" :question/math-academy-id "q-279491" :question/problem "Consider the matrix $C=\\begin{bmatrix}4 & 0 \\\\ -2 & 1\\end{bmatrix}.$ If $f(X)={X}^{2}-5X+6$, find $f(C).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$f(C)=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-5X+6 \\\\  & ={X}^{2}-5X+6I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-5C+6I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}4 & 0 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & 0 \\\\ -10 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-5C+6I \\\\  & =\\begin{bmatrix}16 & 0 \\\\ -10 & 1\\end{bmatrix}-5\\begin{bmatrix}4 & 0 \\\\ -2 & 1\\end{bmatrix}+6\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & 0 \\\\ -10 & 1\\end{bmatrix}-\\begin{bmatrix}20 & 0 \\\\ -10 & 5\\end{bmatrix}+\\begin{bmatrix}6 & 0 \\\\ 0 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}16-20+6 & 0-0+0 \\\\ -10-(-10)+0 & 1-5+6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c13dd03-e008-5c45-b787-b16e24662667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186719536}] :answer-field/correct {:answer/id #uuid "1c13dd03-e008-5c45-b787-b16e24662667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186719536} :answer-field/id #uuid "4b7e9f88-4a8a-5c1d-87dd-90daba670af8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719540} {:answer-field/choices [{:answer/id #uuid "d40b5107-faff-5685-909e-0dcba3c75ce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186719552}] :answer-field/correct {:answer/id #uuid "d40b5107-faff-5685-909e-0dcba3c75ce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186719552} :answer-field/id #uuid "532633d5-6f95-5392-b41e-af797084b63a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719542} {:answer-field/choices [{:answer/id #uuid "0f9a9ada-8a9e-5974-a048-d2999fcfb898" :answer/type {:db/id #ed