ix}3 & 5 \\\\ 1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 5 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & 5 \\\\ 1 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+5I \\\\  & =\\begin{bmatrix}14 & 5 \\\\ 1 & 9\\end{bmatrix}+2\\begin{bmatrix}3 & 5 \\\\ 1 & -2\\end{bmatrix}+5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & 5 \\\\ 1 & 9\\end{bmatrix}+\\begin{bmatrix}6 & 10 \\\\ 2 & -4\\end{bmatrix}+\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}14+6+5 & 5+10+0 \\\\ 1+2+0 & 9+(-4)+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}25 & 15 \\\\ 3 & 10\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1744d8fb-81b6-5395-81e3-a30d1cf22dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -11 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300056} {:answer/id #uuid "3abbca31-cd1a-55dc-ab78-8295ad3f83b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 12 \\\\ -11 & 17\\end{bmatrix}" :db/id #edb/ref 17592186300246} {:answer/id #uuid "4bc77c6a-3546-525e-8f13-32f2ba98a1e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 & -8 \\\\ -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186300356} {:answer/id #uuid "97271f38-aaea-5cbb-9d12-854e247ffaa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300724} {:answer/id #uuid "b62e6866-8fdc-5e97-9346-6542dc3d5717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 & -15 \\\\ 1 & 5\\end{bmatrix}" :db/id #edb/ref 17592186300868}] :answer-field/correct {:answer/id #uuid "97271f38-aaea-5cbb-9d12-854e247ffaa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300724} :answer-field/id #uuid "e2bb789b-a485-529a-bddb-817de5ff3b84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301943}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "997c432b-610d-53fe-ad2b-73f9ef5c7989" :question/math-academy-id "q-32321" :question/problem "Consider the matrix $A=\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}.$ Find $f(A)$ if $f(X)={X}^{2}-3X+1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+1 \\\\  & ={X}^{2}-3X+I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-3A+I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-3A+I \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}-3\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}-\\begin{bmatrix}-6 & 18 \\\\ 3 & 9\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10-(-6)+1 & 6-18 \\\\ 1-3 & 15-9+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17adda87-3f0b-5f93-906d-0841db0139f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 8 \\\\ 9 & 1