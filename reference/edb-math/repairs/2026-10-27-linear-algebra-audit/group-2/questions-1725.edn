 =D\\cdot D \\\\  & =\\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 2 \\\\ -6 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-4I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}+\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-4 & 0+0 \\\\ 0+0 & 4-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec524896-56b2-55db-94bb-f8b865199c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186293852}] :answer-field/correct {:answer/id #uuid "ec524896-56b2-55db-94bb-f8b865199c21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186293852} :answer-field/id #uuid "3cfac5e1-9ff8-57fc-aff8-0bd5690b1b28" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294138} {:answer-field/choices [{:answer/id #uuid "7f52463a-2953-506f-b5d7-9eefb2b98226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293445}] :answer-field/correct {:answer/id #uuid "7f52463a-2953-506f-b5d7-9eefb2b98226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293445} :answer-field/id #uuid "491b649c-77be-5c37-98b6-c5b76504a37e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294189} {:answer-field/choices [{:answer/id #uuid "68bb777c-771a-5d4f-b2c5-0bd323026a8b