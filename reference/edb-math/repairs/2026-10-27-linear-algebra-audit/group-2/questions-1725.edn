\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -2 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-2A-3I \\\\  & =\\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix}-2\\begin{bmatrix}4 & -2 \\\\ 1 & 1\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & -10 \\\\ 5 & -1\\end{bmatrix}-\\begin{bmatrix}8 & -4 \\\\ 2 & 2\\end{bmatrix}-\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}14-8-3 & -10-(-4)-0 \\\\ 5-2-0 & -1-2-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -6 \\\\ 3 & -6\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e36dffb-dd3f-518c-ad3b-7006e4f65c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186293128}] :answer-field/correct {:answer/id #uuid "2e36dffb-dd3f-518c-ad3b-7006e4f65c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186293128} :answer-field/id #uuid "6a4306a0-8d63-5999-96e3-3ad186f44dfd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294304} {:answer-field/choices [{:answer/id #uuid "3516aaa5-73d4-536c-ad56-3e3e9843cbc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293157}] :answer-field/correct {:answer/id #uuid "3516aaa5-73d4-536c-ad56-3e3e9843cbc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293157} :answer-field/id #uuid "97efe776-c3a1-54c4-97a1-88dd96a8edc5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294473} {:answer-f