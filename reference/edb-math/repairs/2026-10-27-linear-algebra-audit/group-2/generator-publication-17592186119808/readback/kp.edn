}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186316342}] :answer-field/correct {:answer/id #uuid "0df36293-7642-519e-989b-c1e17518df82" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186315203} :answer-field/id #uuid "9edde81d-d00d-5468-9796-d7ae23f5cfcd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316913}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d12a13d-137e-5159-9c9a-8fb99c09543c" :question/math-academy-id "q-34205" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ -4 \\\\ -7\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}2 \\\\ -3 \\\\ -5\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}-1 \\\\ -6 \\\\ -11\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -4 \\\\ -7\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -3 \\\\ -5\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -6 \\\\ -11\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-1 \\\\ -4{x}_{1}-3{x}_{2} &=-6 \\\\ -7{x}_{1}-5{x}_{2} &=-11\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ -4 & -3 & -6 \\\\ -7 & -5 & -11\\end{array}\\right] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 5 & -10 \\\\ -7 & -5 & -11\\end{array}\\right] & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 5 & -10 \\\\ 0 & 9 & -18\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 9 & -18\\end{array}\\right] & {R}_{3} & :={R}_{3}-9{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & -1 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-1 \\\\ {x}_{2} &=-2 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+2(-2)=-1\\,⟹\\,{x}_{1}=3.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$ and ${\\mathbf{a}}_{2}:$\n\n$$\n\\begin{aligned}3{\\mathbf{a}}_{\\mathbf{1}}+(-2){\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ 3\\cdot \\begin{bmatrix}1 \\\\ -4 \\\\ -7\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}2 \\\\ -3 \\\\ -5\\end{bmatrix} & =\\begin{bmatrix}-1 \\\\ -6 \\\\ -11\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=3\\cdot (-2)=-6.$"} {:db/id #edb/ref 17592186120355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d731da-980e-5958-bb11-b7045715cb7a" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186317685} {:answer/id #uuid "4647d462-0bf9-544e-bb3f-c0d7a0beb52d" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186317792} {:answer/id #uuid "b1531067-2f49-5764-92da-e5ecfde9e825" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186318166} {:answer/id #uuid "eaaa3200-ccdc-5f1f-a276-dc2c92322895" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186318348} {:answer/id #uuid "f96436b2-dcb3-50c1-b814-2675c7944c08" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186318394}] :answer-field/correct {:answer/id #uuid "4647d462-0bf9-544e-bb3f-c0d7a0beb52d" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186317792} :answer-field/id #uuid "13796a7d-01bd-5ac0-8a55-2720a5cdf2f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318464}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b46516d2-c8a1-53ed-ad0e-7623ea65bae8" :question/math-academy-id "q-34635" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}-3 \\\\ -3\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}-3 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-5 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-3{x}_{1}+{x}_{2} &=-5 \\\\ -3{x}_{1}+{x}_{2} &=7\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}-3 & 1 & -5 \\\\ -3 & 1 & 7\\end{array}\\right] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}-3 & 1 & -5 \\\\ 0 & 0 & 12\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=12,$ which has no solution.\n\nSo, there are no values of ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b}.\\end{aligned}\n$$\n\nTherefore, we conclude that $\\mathbf{b}$ does *not* lie in $\\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}.$"} {:db/id #edb/ref 17592186241011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af0cd86-ff1e-5239-9722-50f94e89c329" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186239405} {:answer/id #uuid "a0be7551-7e5c-5636-a7c9-8ef9da132150" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186239457} {:answer/id #uuid "a44bd6e6-d3e3-5f61-ba38-c4130f629ed1" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186239480} {:answer/id #uuid "ae46b645-7b11-5610-bd71-0f1a23d4cc2f" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186239568} {:answer/id #uuid "b95beb87-1375-5d48-a8c9-c7597f30c390" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186239667}] :answer-field/correct {:answer/id #uuid "b95beb87-1375-5d48-a8c9-c7597f30c390" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186239667} :answer-field/id #uuid "ecbaf85e-cf9e-5c08-9461-081257f34591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240744}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a63e4e3d-b5b1-5859-9678-2c18ce011365" :question/math-academy-id "q-105208" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ -3\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}3 \\\\ -5\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}3 \\\\ -17\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ -5\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -17\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=3 \\\\ -3{x}_{1}-5{x}_{2} &=-17\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 3 & 3 \\\\ -3 & -5 & -17\\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 3 \\\\ 0 & 4 & -8\\end{array}\\right] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 3 \\\\ 0 & 1 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=3 \\\\ {x}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+3(-2)=3\\,⟹\\,{x}_{1}=9.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$ and ${\\mathbf{a}}_{2}:$\n\n$$\n\\begin{aligned}9{\\mathbf{a}}_{\\mathbf{1}}+(-2){\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ 9\\cdot \\begin{bmatrix}1 \\\\ -3\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}3 \\\\ -5\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -17\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=9\\cdot (-2)=-18.$"} {:db/id #edb/ref 17592186314972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077cc4da-3c12-5749-87e3-9136fa56ff18" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186312025} {:answer/id #uuid "39d686df-f396-5c82-92b8-3b075c274d61" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312445} {:answer/id #uuid "4dd5ec6b-997e-5c4c-82cd-f74e85dcbdf1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186312607} {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} {:answer/id #uuid "2efb3d59-10d0-57b0-b6f6-06c1b609ee7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}" :db/id #edb/ref 17592186422770}] :answer-field/correct {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} :answer-field/id #uuid "901fd7a3-f614-5740-8413-9326f82935f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314396}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dffa9b37-7313-5190-ae5f-372cf9f5aaea" :question/math-academy-id "q-34058" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=1 \\\\ {x}_{2} &=1 \\\\ 2{x}_{1}+3{x}_{2} &=7\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 2 & 3 & 7\\end{array}\\right] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 5 & 5\\end{array}\\right] & {R}_{3} & :={R}_{3}-5{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2} &=1 \\\\ {x}_{2} &=1 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-1=1\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$ and ${\\mathbf{a}}_{2}:$\n\n$$\n\\begin{aligned}2{\\mathbf{a}}_{\\mathbf{1}}+{\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot 1=2.$"} {:db/id #edb/ref 17592186315058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4353f2a2-2e1f-5b21-a610-9bc1d73de9eb" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186312513} {:answer/id #uuid "5a50f3ee-4329-5f14-85d9-cd33cdb2bfaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186312695} {:answer/id #uuid "95778461-811f-5b4c-bb40-bd404063421e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186313170} {:answer/id #uuid "b72923b2-e566-5436-984b-89faeb74608d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186313400} {:answer/id #uuid "e264f385-ccd1-57b4-a97a-4878b9b02343" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186313759}] :answer-field/correct {:answer/id #uuid "5a50f3ee-4329-5f14-85d9-cd33cdb2bfaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}" :db/id #edb/ref 17592186312695} :answer-field/id #uuid "535982b4-ac83-5175-baa7-29e64cb50acc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314243}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d123ca06-d8b5-58e1-a29a-b212c006eac8" :question/math-academy-id "q-34115" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}-1 \\\\ -4 \\\\ 3\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}-1 \\\\ -4 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1} &=-2 \\\\ -4{x}_{1}+{x}_{2} &=4 \\\\ 3{x}_{1}-3{x}_{2} &=1\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}-1 & 0 & -2 \\\\ -4 & 1 & 4 \\\\ 3 & -3 & 1\\end{array}\\right] & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ -4 & 1 & 4 \\\\ 3 & -3 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 3 & -3 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 0 & -3 & -5\\end{array}\\right] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 0 & 0 & 31\\end{array}\\right]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=31,$ which has no solution.\n\nSo, there are no values of ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b}.\\end{aligned}\n$$\n\nTherefore, we conclude that $\\mathbf{b}$ does *not* lie in $\\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}.$"} {:db/id #edb/ref 17592186315059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "683c75de-7b34-50d6-88f2-6c51a3c7f829" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186312792} {:answer/id #uuid "923048c9-ff86-55c4-bcc3-03777aa67776" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186313149} {:answer/id #uuid "afaf5d38-ccd2-55f1-a847-9241b631f84f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186313345} {:answer/id #uuid "dd4e5aec-7f80-5329-8295-b30810fc13fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}" :db/id #edb/ref 17592186313716} {:answer/id #uuid "e2641fa7-4060-5129-9314-eb56f0e0a24d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186313758}] :answer-field/correct {:answer/id #uuid "e2641fa7-4060-5129-9314-eb56f0e0a24d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186313758} :answer-field/id #uuid "4764b730-de51-591f-8dc2-a6719ee618fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314209}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6c8923fc-6353-5c69-b3ea-6ae80c516e61" :question/math-academy-id "q-34117" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, ${\\mathbf{a}}_{\\mathbf{3}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}+{x}_{3}{\\mathbf{a}}_{3}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{3}}=\\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}-4 \\\\ -9 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}},{\\mathbf{a}}_{\\mathbf{3}}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}+{x}_{3}{\\mathbf{a}}_{3} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ -9 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+6{x}_{3} &=-4 \\\\ -3{x}_{1}+{x}_{2} &=-9 \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{ccc|c}1 & 0 & 6 & -4 \\\\ -3 & 1 & 0 & -9 \\\\ 0 & 0 & 1 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 6 & -4 \\\\ 0 & 1 & 18 & -21 \\\\ 0 & 0 & 1 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}-18{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 6 & -4 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+6{x}_{3} &=-4 \\\\ {x}_{2} &=-3 \\\\ {x}_{3} &=-1.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+6(-1)=-4\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{2}$ and ${\\mathbf{a}}_{3}:$\n\n$$\n\\begin{aligned}2{\\mathbf{a}}_{\\mathbf{1}}+(-3){\\mathbf{a}}_{\\mathbf{2}}+(-1){\\mathbf{a}}_{\\mathbf{3}} & =\\mathbf{b} \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+(-3)\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ -9 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot (-3)\\cdot (-1)=6.$"} {:db/id #edb/ref 17592186317213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d12c5f6-3b92-5441-a0fc-3952c1a70749" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186315285} {:answer/id #uuid "2be071fa-e50f-5e15-af2e-800d12bec8db" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186315374} {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} {:answer/id #uuid "719e49b9-6453-5c6f-ae8b-fb5f2080b954" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186315762} {:answer/id #uuid "385e50bb-f4df-5245-a484-97539f7d5c09" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}" :db/id #edb/ref 17592186422778}] :answer-field/correct {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} :answer-field/id #uuid "8429c92b-0897-5b2d-8856-66b5640c1f28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316855}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "54dedc31-eea3-5db1-a0e4-025cee199163" :question/math-academy-id "q-34218" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, ${\\mathbf{a}}_{\\mathbf{3}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}+{x}_{3}{\\mathbf{a}}_{3}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{3}}=\\begin{bmatrix}-2 \\\\ 6 \\\\ 1\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}6 \\\\ -14 \\\\ -14\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}},{\\mathbf{a}}_{\\mathbf{3}}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2}+{x}_{3}{\\mathbf{a}}_{3} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ 6 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -14 \\\\ -14\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{3} &=6 \\\\ -3{x}_{1}+{x}_{2}+6{x}_{3} &=-14 \\\\ -3{x}_{2}+{x}_{3} &=-14\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{ccc|c}1 & 0 & -2 & 6 \\\\ -3 & 1 & 6 & -14 \\\\ 0 & -3 & 1 & -14\\end{array}\\right] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & -3 & 1 & -14\\end{array}\\right] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{3} &=6 \\\\ {x}_{2} &=4 \\\\ {x}_{3} &=-2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(-2)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{2}$ and ${\\mathbf{a}}_{3}:$\n\n$$\n\\begin{aligned}2{\\mathbf{a}}_{\\mathbf{1}}+4{\\mathbf{a}}_{\\mathbf{2}}+(-2){\\mathbf{a}}_{\\mathbf{3}} & =\\mathbf{b} \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+4\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}-2 \\\\ 6 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -14 \\\\ -14\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 4\\cdot (-2)=-16.$"} {:db/id #edb/ref 17592186342223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "120b91cf-0db6-5fff-9cd2-96b7e554a40a" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186339285} {:answer/id #uuid "14e37e35-842f-5038-9d62-28d1f13c1bd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathbf{b}\\notin \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}" :db/id #edb/ref 17592186339313} {:answer/id #uuid "2d7657e7-1a18-56b9-93e9-58660f379564" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339526} {:answer/id #uuid "67d6a9b4-19f3-511b-aa8f-ade40252120a" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186340051} {:answer/id #uuid "f805952e-7829-54ab-97f1-32e7a06c683e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186341321}] :answer-field/correct {:answer/id #uuid "67d6a9b4-19f3-511b-aa8f-ade40252120a" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186340051} :answer-field/id #uuid "e16bd03e-9440-52af-87df-1a7859a2c251" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341783}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b39a9eda-2020-5222-b891-a65118115aa0" :question/math-academy-id "q-74546" :question/problem "The vectors ${\\mathbf{a}}_{1}$, ${\\mathbf{a}}_{\\mathbf{2}}$, and $\\mathbf{b}$ are given below. Determine if $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $\\mathbf{b}={x}_{1}{\\mathbf{a}}_{\\mathbf{1}}+{x}_{2}{\\mathbf{a}}_{\\mathbf{2}}.$\n\n$$\n{\\mathbf{a}}_{\\mathbf{1}}=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix},\\hspace{2em}{\\mathbf{a}}_{\\mathbf{2}}=\\begin{bmatrix}3 \\\\ 10\\end{bmatrix},\\hspace{2em}\\mathbf{b}=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}\n$$" :question/worked-solution "We know that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{\\mathbf{1}},{\\mathbf{a}}_{\\mathbf{2}}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{\\mathbf{a}}_{1}+{x}_{2}{\\mathbf{a}}_{2} & =\\mathbf{b} \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}3 \\\\ 10\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=2 \\\\ 3{x}_{1}+10{x}_{2} &=4\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 3 & 10 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & -2\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=2 \\\\ {x}_{2} &=-2.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+3(-2)=2\\,⟹\\,{x}_{1}=8.\n$$\n\nSince the system has a solution, we can conclude that $\\mathbf{b}\\in \\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $\\mathbf{b}$ as a linear combination of ${\\mathbf{a}}_{1}$ and ${\\mathbf{a}}_{2}:$\n\n$$\n\\begin{aligned}8{\\mathbf{a}}_{\\mathbf{1}}+(-2){\\mathbf{a}}_{\\mathbf{2}} & =\\mathbf{b} \\\\ 8\\cdot \\begin{bmatrix}1 \\\\ 3\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}3 \\\\ 10\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=8\\cdot (-2)=-16.$"} {:db/id #edb/ref 17592186421529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a7a3f85-c316-5d92-9f90-b24c014d8770" :answer/type {:db/ident :answer.type/math} :answer/value "-100" :db/id #edb/ref 17592186421500} {:answer/id #uuid "244d18d1-69c9-554a-801a-a1ee85e653f9" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}{{a}_{1},{a}_{2}}" :db/id #edb/ref 17592186421501} {:answer/id #uuid "49efebb4-5b44-54d8-a642-d7be1bed4e5c" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186421507} {:answer/id #uuid "8c1e9e25-575f-5bba-bb57-6864dc973a15" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186421511} {:answer/id #uuid "f486e66a-d479-5a8a-b1e9-cfb2602b755d" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186421521}] :answer-field/correct {:answer/id #uuid "1a7a3f85-c316-5d92-9f90-b24c014d8770" :answer/type {:db/ident :answer.type/math} :answer/value "-100" :db/id #edb/ref 17592186421500} :answer-field/id #uuid "2974b131-4f18-559b-891b-6b98e368f920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421523}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9fca2b37-ca0d-5f9c-9cd0-c84b2660c1c8" :question/math-academy-id "q-34653" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}{{a}_{1},{a}_{2}}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}4 \\\\ 6\\end{bmatrix},\\,b=\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}4 \\\\ 6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2} &=0 \\\\ 2{x}_{1}+6{x}_{2} &=10\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 2 & 6 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 0 & -2 & 10\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 0 & 1 & -5\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+4{x}_{2} &=0 \\\\ {x}_{2} &=-5.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-5.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+4(-5)=0\\,⟹\\,{x}_{1}=20.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}{{a}_{1},{a}_{2}}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}20{a}_{1}+(-5){a}_{2} & =b \\\\ 20\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+(-5)\\cdot \\begin{bmatrix}4 \\\\ 6\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 10\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=20\\cdot (-5)=-100.$"} {:db/id #edb/ref 17592186421530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3730de20-b24e-5f5e-a26c-d563eb7c0ee1" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}{{a}_{1},{a}_{2}}" :db/id #edb/ref 17592186421504} {:answer/id #uuid "43f2e466-d80e-55b3-9568-6896ede2a380" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186421506} {:answer/id #uuid "7216d5b9-15dc-5173-80f7-9cff9ed9a669" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186421508} {:answer/id #uuid "afae5c38-3c29-54c4-8923-744473be6095" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186421515} {:answer/id #uuid "daa49e61-be48-5737-b796-4a269a8a98e3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186421520}] :answer-field/correct {:answer/id #uuid "3730de20-b24e-5f5e-a26c-d563eb7c0ee1" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}{{a}_{1},{a}_{2}}" :db/id #edb/ref 17592186421504} :answer-field/id #uuid "46a3e759-b5ee-59ce-9c0f-961ebc2fe588" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421525}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c75c18ab-94b6-560b-bd47-66c76f099710" :question/math-academy-id "q-105215" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}{{a}_{1},{a}_{2}}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}-6 \\\\ 4\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}3{x}_{1}-6{x}_{2} &=3 \\\\ -2{x}_{1}+4{x}_{2} &=-1\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{cc|c}3 & -6 & 3 \\\\ -2 & 4 & -1\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 1 \\\\ -2 & 4 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 1 \\\\ 0 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe second row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=1,$ which has no solution.\n\nSo, there are no values of ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b.\\end{aligned}\n$$\n\nTherefore, we conclude that $b$ does *not* lie in $\\text{Span}{{a}_{1},{a}_{2}}.$"} {:db/id #edb/ref 17592186563719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e4a4287-0b4e-5134-b26d-e720107fbfce" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2}\\}" :db/id #edb/ref 17592186563012} {:answer/id #uuid "32966283-95f9-59c0-9da8-620246a44c9f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186563060} {:answer/id #uuid "35881d2a-16d1-5e15-a12f-b325e9f8db16" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563066} {:answer/id #uuid "4d4a40a4-8887-524e-8b48-8a24128d12fd" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186563117} {:answer/id #uuid "d639618d-a932-5b03-8225-fae8a0b21ef5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186563414}] :answer-field/correct {:answer/id #uuid "35881d2a-16d1-5e15-a12f-b325e9f8db16" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186563066} :answer-field/id #uuid "283164aa-73de-5dcd-8a69-e6c9e6374abc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563546}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a8427e64-b547-5ecb-a62e-824aa188b632" :question/math-academy-id "q-34114" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}=2 \\\\ 2{x}_{1}+4{x}_{2}=0 \\\\ -3{x}_{1}+{x}_{2}=-7\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 0 & 2 \\\\ 2 & 4 & 0 \\\\ -3 & 1 & -7\\end{array}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ -3 & 1 & -7\\end{array}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 4 & -4 \\\\ 0 & 1 & -1\\end{array}] & {R}_{2} & :=\\frac{1}{4}{R}_{2} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{array}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=2 \\\\ {x}_{2}=-1 \\\\ 0=0.\\end{aligned}\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}2{a}_{1}+(-1){a}_{2} & =b \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}0 \\\\ 4 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 0 \\\\ -7\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot (-1)=-2.$"} {:db/id #edb/ref 17592186563732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1442cd36-01ab-57b5-b752-7b7131e887f9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186562987} {:answer/id #uuid "1f1cbd99-3722-58a8-94e3-9b80df51c48b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186563016} {:answer/id #uuid "38fb4394-142f-596a-acba-652af141f7ea" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186563073} {:answer/id #uuid "976c158b-03de-5101-af86-c772a635e855" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186563285} {:answer/id #uuid "98c56786-6605-5401-b672-c63cb1cecd33" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186563288}] :answer-field/correct {:answer/id #uuid "98c56786-6605-5401-b672-c63cb1cecd33" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186563288} :answer-field/id #uuid "7847d689-0e36-5ac4-b435-bd1cf0642bc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563577}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c391d9c3-0c76-5e6f-b0c3-d6b4ee2c37cb" :question/math-academy-id "q-105199" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}=3 \\\\ 2{x}_{1}+{x}_{2}=8\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{cc|c}1 & 0 & 3 \\\\ 2 & 1 & 8\\end{array}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{array}{cc|c}1 & 0 & 3 \\\\ 0 & 1 & 2\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=3 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}3{a}_{1}+2{a}_{2} & =b \\\\ 3\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=3\\cdot 2=6.$"} {:db/id #edb/ref 17592186563749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012982fc-c0c6-5360-983d-5c24ecfa5a09" :answer/type {:db/ident :answer.type/math} :answer/value "162" :db/id #edb/ref 17592186562940} {:answer/id #uuid "3ef56e44-9e80-5352-bfb2-5d35c8c19329" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186563087} {:answer/id #uuid "65e52e96-8639-5303-a9f5-06fb2d4d391c" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186563179} {:answer/id #uuid "84afc469-3802-566a-b03f-b05bcd3fd37e" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}" :db/id #edb/ref 17592186563242} {:answer/id #uuid "bcb4217f-2b11-5476-8d7f-3c0e1e75e42b" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186563361}] :answer-field/correct {:answer/id #uuid "012982fc-c0c6-5360-983d-5c24ecfa5a09" :answer/type {:db/ident :answer.type/math} :answer/value "162" :db/id #edb/ref 17592186562940} :answer-field/id #uuid "0d94e257-45da-5352-bd7b-f0680253dc5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563523}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ddfb229d-f01d-542c-8a6c-f2e9a5996154" :question/math-academy-id "q-34639" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ 4{x}_{1}+{x}_{2}-8{x}_{3}=18 \\\\ 2{x}_{1}-3{x}_{3}=9\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 4 & 1 & -8 & 18 \\\\ 2 & 0 & -3 & 9\\end{array}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 2 & 0 & -3 & 9\\end{array}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{array}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=3 \\\\ {x}_{2}=6 \\\\ {x}_{3}=3.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(3)=3\\,⟹\\,{x}_{1}=9.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}9{a}_{1}+6{a}_{2}+3{a}_{3} & =b \\\\ 9\\cdot \\begin{bmatrix}1 \\\\ 4 \\\\ 2\\end{bmatrix}+6\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+3\\cdot \\begin{bmatrix}-2 \\\\ -8 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}3 \\\\ 18 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=9\\cdot 6\\cdot 3=162.$"} {:db/id #edb/ref 17592186581745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85642ced-3291-5237-912d-27c18667a775" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186581254} {:answer/id #uuid "89688d1e-1b07-5980-a614-ee26f98d14b7" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186581266} {:answer/id #uuid "996cd1b5-1025-5b4a-aed1-60540f519a90" :answer/type {:db/ident :answer.type/math} :answer/value "-85" :db/id #edb/ref 17592186581295} {:answer/id #uuid "af84bccb-ed07-5cfd-887d-b3215ea2afcb" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}" :db/id #edb/ref 17592186581344} {:answer/id #uuid "e2cd389f-4bbf-5bf0-8a70-8204c3b14d09" :answer/type {:db/ident :answer.type/math} :answer/value "-340" :db/id #edb/ref 17592186581440}] :answer-field/correct {:answer/id #uuid "e2cd389f-4bbf-5bf0-8a70-8204c3b14d09" :answer/type {:db/ident :answer.type/math} :answer/value "-340" :db/id #edb/ref 17592186581440} :answer-field/id #uuid "ee2745ef-4acf-51e1-98fb-ee4182d16ee2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186581629}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fbcfd8ae-059d-51b0-aee6-824d405b7e28" :question/math-academy-id "q-34648" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix},\\,b=\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=5 \\\\ 3{x}_{1}+{x}_{2}-9{x}_{3} &=10 \\\\ -4{x}_{1}+13{x}_{3} &=-16\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 3 & 1 & -9 & 10 \\\\ -4 & 0 & 13 & -16\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 0 & 1 & 0 & -5 \\\\ -4 & 0 & 13 & -16\\end{array}\\right] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 5 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-3{x}_{3} &=5 \\\\ {x}_{2} &=-5 \\\\ {x}_{3} &=4.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=4.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-3(4)=5\\,⟹\\,{x}_{1}=17.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}17{a}_{1}+(-5){a}_{2}+4{a}_{3} & =b \\\\ 17\\cdot \\begin{bmatrix}1 \\\\ 3 \\\\ -4\\end{bmatrix}+(-5)\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+4\\cdot \\begin{bmatrix}-3 \\\\ -9 \\\\ 13\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 10 \\\\ -16\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=17\\cdot (-5)\\cdot 4=-340.$"} {:db/id #edb/ref 17592186713379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35185c3b-728f-50bb-832a-01ddc76f40d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186713375} {:answer/id #uuid "4acb7b27-19ed-5bf6-aa4d-b57306dbf270" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713382} {:answer/id #uuid "7bacdd84-2d92-5d9e-996a-fd271953a4f8" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713385} {:answer/id #uuid "a015093f-9326-5e95-845d-d121a207ece2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186713396} {:answer/id #uuid "f7dfbabf-7a06-5871-b041-d52b19095b97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186713408}] :answer-field/correct {:answer/id #uuid "f7dfbabf-7a06-5871-b041-d52b19095b97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186713408} :answer-field/id #uuid "f35529c9-73aa-51b0-8151-fe25441d190a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713407}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "408a692c-c137-5e29-bfb3-74397834a78e" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}5 \\\\ 4 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}6 \\\\ 4 \\\\ 2\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-24 \\\\ -18 \\\\ -6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}5x_{1}+6x_{2} &= -24 \\\\ 4x_{1}+4x_{2} &= -18 \\\\ x_{1}+2x_{2} &= -6\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 4 & 4 & -18 \\\\ 1 & 2 & -6\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(\\frac{4}{5}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 1 & 2 & -6\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(\\frac{1}{5}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 0 & \\frac{4}{5} & -\\frac{6}{5}\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}5 & 6 & -24 \\\\ 0 & -\\frac{4}{5} & \\frac{6}{5} \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{2} &= \\frac{\\frac{6}{5}}{-\\frac{4}{5}} = -\\frac{3}{2} \\\\ x_{1} &= \\frac{-24-\\left(6\\right)\\left(-\\frac{3}{2}\\right)}{5} = -3\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}=\\left(-3\\right)\\cdot \\left(-\\frac{3}{2}\\right)=\\frac{9}{2}.\n$$"} {:db/id #edb/ref 17592186713383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5a0747-882f-5818-beca-b67fb715c9e2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{56}{3}" :db/id #edb/ref 17592186713378} {:answer/id #uuid "7e75a186-9954-5af6-8c17-35039bd84d0f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186713387} {:answer/id #uuid "8da45463-28a6-5a95-9944-580c5b1154c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186713390} {:answer/id #uuid "930e27ca-56f9-5ccd-9aa8-0ae91d3daed6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713391} {:answer/id #uuid "dea936f5-4c15-551c-8dc4-f8fcb7b6c47b" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713404}] :answer-field/correct {:answer/id #uuid "dea936f5-4c15-551c-8dc4-f8fcb7b6c47b" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713404} :answer-field/id #uuid "d8c902ad-c2d3-50d5-8efd-a82f3aef63f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713401}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "695fb789-d14d-5a24-8f29-8a9a2c5fb717" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}3 \\\\ 1 \\\\ 10\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}2 \\\\ 0 \\\\ 8\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}x_{1}+3x_{2} &= 2 \\\\ x_{2} &= 0 \\\\ 3x_{1}+10x_{2} &= 8\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 3 & 10 & 8\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(3\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 2\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{array}\\right]\n$$\n\nRow $3$ gives $0=2$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."} {:db/id #edb/ref 17592186713386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d848c3-ec9d-5403-ad07-e1f7970c2863" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713376} {:answer/id #uuid "445d757f-1d1c-566e-b24e-9336addd1dc9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186713380} {:answer/id #uuid "9b5817a6-b947-5d48-9790-2fee9682d2bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186713394} {:answer/id #uuid "9f985dad-acc1-5941-8b38-708921ae9fb8" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713395} {:answer/id #uuid "de6138c3-2180-5c24-b5f9-64cb9d5193f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186713403}] :answer-field/correct {:answer/id #uuid "38d848c3-ec9d-5403-ad07-e1f7970c2863" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186713376} :answer-field/id #uuid "e221f1a6-9601-5824-a967-dfe6b455354c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713405}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7e4b7932-a5e2-58d4-823b-4920aab927bc" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}2 \\\\ -2 \\\\ -8\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}1 \\\\ -3 \\\\ -6\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}1 \\\\ -1 \\\\ -4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}2x_{1}+x_{2} &= 1 \\\\ -2x_{1}-3x_{2} &= -1 \\\\ -8x_{1}-6x_{2} &= -4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ -2 & -3 & -1 \\\\ -8 & -6 & -4\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ -8 & -6 & -4\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-4\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ 0 & -2 & 0\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}2 & 1 & 1 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{2} &= \\frac{0}{-2} = 0 \\\\ x_{1} &= \\frac{1-\\left(1\\right)\\left(0\\right)}{2} = \\frac{1}{2}\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}=\\left(\\frac{1}{2}\\right)\\cdot \\left(0\\right)=0.\n$$"} {:db/id #edb/ref 17592186713397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec0e806-d9a7-5c06-a779-d2afb62c2f95" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186713374} {:answer/id #uuid "39c76f85-7006-542f-8cbb-a58712cea35f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186713377} {:answer/id #uuid "4579363f-0ffb-5514-a52e-09a68134f799" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713381} {:answer/id #uuid "714b3da7-86d8-5da5-b78c-0757db482989" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186713384} {:answer/id #uuid "94994ed3-3596-5f3e-9a0b-a8bf6c76b6c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186713392}] :answer-field/correct {:answer/id #uuid "4579363f-0ffb-5514-a52e-09a68134f799" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713381} :answer-field/id #uuid "ee0a33e9-823e-5f08-bc6f-51e20e2beb11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713406}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ad9ef2fb-ed16-50ac-a85e-128a7ded85f9" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}-1 \\\\ -2 \\\\ 6\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ -4\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}4 \\\\ 4 \\\\ -19\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}-x_{1}+x_{2} &= 4 \\\\ -2x_{1}+x_{2} &= 4 \\\\ 6x_{1}-4x_{2} &= -19\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ -2 & 1 & 4 \\\\ 6 & -4 & -19\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(2\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 6 & -4 & -19\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-6\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 0 & 2 & 5\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-2\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & 1 & 4 \\\\ 0 & -1 & -4 \\\\ 0 & 0 & -3\\end{array}\\right]\n$$\n\nRow $3$ gives $0=-3$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."} {:db/id #edb/ref 17592186713402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833465e3-09b8-54ef-a3eb-b19d39eca64d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186713388} {:answer/id #uuid "898c1d59-9685-5b86-beb0-c65de080cb2b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186713389} {:answer/id #uuid "99d322b0-2d66-5ce4-8c26-ebe7f70f2155" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713393} {:answer/id #uuid "c275ab3b-dde4-5541-ba94-a675b9056175" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186713398} {:answer/id #uuid "cd82486f-0a39-5be5-a281-a27f609090bd" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186713399}] :answer-field/correct {:answer/id #uuid "99d322b0-2d66-5ce4-8c26-ebe7f70f2155" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2}\\}" :db/id #edb/ref 17592186713393} :answer-field/id #uuid "d5437794-a220-5c13-af3b-0a06fe18289b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713400}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dcf0a2ce-94dd-5338-a060-a69502e0e3c8" :question/problem "The vectors $a_{1},a_{2}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}-3 \\\\ 2 \\\\ 4\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}-3 \\\\ 3 \\\\ 4\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}-x_{1}-3x_{2} &= -3 \\\\ x_{1}+2x_{2} &= 3 \\\\ x_{1}+4x_{2} &= 4\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 1 & 2 & 3 \\\\ 1 & 4 & 4\\end{array}\\right]\n$$\n\n$$\nR_{2}\\leftarrow R_{2}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 1 & 4 & 4\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-1\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{cc|c}-1 & -3 & -3 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{array}\\right]\n$$\n\nRow $3$ gives $0=1$, a contradiction. No coefficients satisfy every component, so $b\\notin \\operatorname{Span}\\{a_{1},a_{2}\\}$."} {:db/id #edb/ref 17592186713472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31dd2988-47f9-54b5-8e70-aefa971fd2bb" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186713468} {:answer/id #uuid "6837d40d-7338-50b4-be78-11d9d65bc410" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186713469} {:answer/id #uuid "68db29be-3540-5c51-a707-757e5b60fc01" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186713470} {:answer/id #uuid "ac5d63fb-8179-56ba-92a2-0bd59f331de7" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186713471} {:answer/id #uuid "c6177b14-7906-55cf-ab04-045021373363" :answer/type {:db/ident :answer.type/math} :answer/value "b\\notin\\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}" :db/id #edb/ref 17592186713473}] :answer-field/correct {:answer/id #uuid "ac5d63fb-8179-56ba-92a2-0bd59f331de7" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186713471} :answer-field/id #uuid "1cdef479-1481-5f86-9d40-ce2b9b1a7c68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186713467}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c10cc3bc-065b-5289-9900-2a88e8ac7fde" :question/problem "The vectors $a_{1},a_{2},a_{3}$ and $b$ are given below. Determine whether $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$. In the affirmative case, find $x_{1}\\cdot x_{2}\\cdot x_{3}$ from the decomposition $b=x_{1}a_{1}+x_{2}a_{2}+x_{3}a_{3}$.\n\n<div class=\"matrix-operands\">\n<div>$a_{1}=\\begin{bmatrix}0 \\\\ -3 \\\\ 1\\end{bmatrix}$</div>\n<div>$a_{2}=\\begin{bmatrix}2 \\\\ 1 \\\\ 0\\end{bmatrix}$</div>\n<div>$a_{3}=\\begin{bmatrix}2 \\\\ -3 \\\\ 1\\end{bmatrix}$</div>\n<div>$b=\\begin{bmatrix}6 \\\\ 1 \\\\ 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "By the definition of span, $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ exactly when coefficients exist such that\n\n$$\nx_{1}a_{1}+x_{2}a_{2}+x_{3}a_{3}=b.\n$$\n\nEquating components gives\n\n$$\n\\left\\{\\begin{aligned}2x_{2}+2x_{3} &= 6 \\\\ -3x_{1}+x_{2}-3x_{3} &= 1 \\\\ x_{1}+x_{3} &= 1\\end{aligned}\\right.\n$$\n\nSet up the augmented matrix and use elementary row operations:\n\n$$\n\\left[\\begin{array}{ccc|c}0 & 2 & 2 & 6 \\\\ -3 & 1 & -3 & 1 \\\\ 1 & 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{1}\\leftrightarrow R_{2}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 1 & 0 & 1 & 1\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(-\\frac{1}{3}\\right)R_{1}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 0 & \\frac{1}{3} & 0 & \\frac{4}{3}\\end{array}\\right]\n$$\n\n$$\nR_{3}\\leftarrow R_{3}-\\left(\\frac{1}{6}\\right)R_{2}\n$$\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 1 & -3 & 1 \\\\ 0 & 2 & 2 & 6 \\\\ 0 & 0 & -\\frac{1}{3} & \\frac{1}{3}\\end{array}\\right]\n$$\n\nBack-substitution gives\n\n$$\n\\begin{aligned}x_{3} &= \\frac{\\frac{1}{3}}{-\\frac{1}{3}} = -1 \\\\ x_{2} &= \\frac{6-\\left(2\\right)\\left(-1\\right)}{2} = 4 \\\\ x_{1} &= \\frac{1-\\left(1\\right)\\left(4\\right)-\\left(-3\\right)\\left(-1\\right)}{-3} = 2\\end{aligned}\n$$\n\nAll component equations hold. Thus $b\\in \\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ and the coefficients are unique. Finally,\n\n$$\nx_{1}\\cdot x_{2}\\cdot x_{3}=\\left(2\\right)\\cdot \\left(4\\right)\\cdot \\left(-1\\right)=-8.\n$$"}] :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"}]}
