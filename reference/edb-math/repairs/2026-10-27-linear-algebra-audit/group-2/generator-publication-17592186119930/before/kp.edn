#{[{:db/id #edb/ref 17592186119930 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119504 :question/id #uuid "c9760010-bcdd-53f4-8428-a3f5ecdd838b" :question/math-academy-id "e-10992" :question/problem "Find the determinant of the matrix \n$$\nA=\n{\\left[ \\begin{array}{cccc}2 & 5 & 5 & 4 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 8 & 2 & 0 \\\\ 0 & 13 & 19 & - 3\\end{array} \\right]}.\n$$" :question/worked-solution "Notice that the $1$st column contains three zeros. So, using Laplace expansion along the $1$st column, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}2 & {\\color{lightgray}{5}} & {\\color{lightgray}{5}} & {\\color{lightgray}{4}} \\\\ {\\color{lightgray}{0}} & 1 & 0 & 0 \\\\ {\\color{lightgray}{0}} & 8 & 2 & 0 \\\\ {\\color{lightgray}{0}} & 13 & 19 & -3\\end{vmatrix} \\\\  & =2\\cdot (-1)^{1+1}\\begin{vmatrix}1 & 0 & 0 \\\\ 8 & 2 & 0 \\\\ 13 & 19 & -3\\end{vmatrix} \\\\  & =2\\begin{vmatrix}1 & 0 & 0 \\\\ 8 & 2 & 0 \\\\ 13 & 19 & -3\\end{vmatrix}.\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}1 & 0 & 0 \\\\ 8 & 2 & 0 \\\\ 13 & 19 & -3\\end{vmatrix} & =1\\cdot 2\\cdot (-3)=-6.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\det(A) = 2 \\cdot (-6) = -12.\n$$"} :knowledge-point/id #uuid "02e65c73-8c02-5403-8c5c-b1e81f81a7b6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048505 :topic/difficulty 0.6763642300648692 :topic/id #uuid "a564c0d5-78a2-53e7-86da-2f6c443f5501" :topic/knowledge-points [{:db/id #edb/ref 17592186119773} {:db/id #edb/ref 17592186119774} {:db/id #edb/ref 17592186119843}] :topic/math-academy-id 1770 :topic/next [{:db/id #edb/ref 17592186049159} {:db/id #edb/ref 17592186049530}] :topic/title "Finding Determinants Using Laplace Expansions"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186704418 :question-generator/id #uuid "299fcf06-2ce7-59b2-b09e-93ebf8d7b3e9" :question-generator/script "generators/94/94d5ed04918e6d6b89fc1758e8d34bec9613a11cefe466d7eaa432312e1d37db/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186120429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2854ab92-ed1f-5d7d-be3e-9599ee77142e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327276} {:answer/id #uuid "3e28e4aa-5d1d-5c3f-ada1-e4595bcbe54b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186327478} {:answer/id #uuid "5aec9977-94b7-52b9-9d5b-6e3ababd8990" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186327731} {:answer/id #uuid "a344999f-2014-517f-b6ac-76fba5cd2bfa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328344} {:answer/id #uuid "eb4599c2-f1c9-5ae5-b91d-71e1e423f931" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186328991}] :answer-field/correct {:answer/id #uuid "eb4599c2-f1c9-5ae5-b91d-71e1e423f931" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186328991} :answer-field/id #uuid "6517ca2d-d648-5470-bdf2-00df6f4aa468" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329361}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a43a5f7-bf85-5fa1-b02e-c33727064a7d" :question/math-academy-id "q-42472" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle B=\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 3 & 1 & 0 & 0 \\\\ 5 & 11 & 1 & 19 \\\\ 4 & 0 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $3$rd column contains three zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(B) & =\\begin{vmatrix}3 & 0 & {\\color{lightgray}{0}} & 0 \\\\ 3 & 1 & {\\color{lightgray}{0}} & 0 \\\\ {\\color{lightgray}{5}} & {\\color{lightgray}{11}} & 1 & {\\color{lightgray}{19}} \\\\ 4 & 0 & {\\color{lightgray}{0}} & -3\\end{vmatrix} \\\\  & =1\\cdot (-1)^{3+3}\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix} & =3\\cdot 1\\cdot (-3)=-9.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(B)=-9.\n$$"} {:db/id #edb/ref 17592186120445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81524c1d-439e-5c56-892a-1eb8e0b26c13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186118785} {:answer/id #uuid "8a7c2b68-acec-551c-8774-821bc23d3735" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186118786} {:answer/id #uuid "a0e7866f-acfa-5d8e-9941-5c7d8110bd5a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118787} {:answer/id #uuid "a64ba277-49a2-53b0-bc51-7de660a403bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186118788} {:answer/id #uuid "7cd3bdfd-fa3c-511b-bb08-4db0a17982ab" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186118789}] :answer-field/correct {:answer/id #uuid "a0e7866f-acfa-5d8e-9941-5c7d8110bd5a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118787} :answer-field/id #uuid "1609bd79-ff32-575c-b07b-a7b71d3f8d98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118784}] :question/id #uuid "0d948c7a-e644-5166-a1ae-a29a9bc815d3" :question/math-academy-id "q-42955" :question/problem "Find the determinant of the matrix\n$$\n\\displaystyle A = \\begin{bmatrix}1 & 1 & 1 & 2 \\\\ 2 & -1 & 4 & 2 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 5 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "The third row contains three zeros, so expand along that row:\n\n$$\n\\det(A)=2(-1)^{3+2}\\begin{vmatrix}1&1&2\\\\2&4&2\\\\1&0&0\\end{vmatrix}\n=-2\\begin{vmatrix}1&2\\\\4&2\\end{vmatrix}\n=-2(2-8)=12.\n$$"} {:db/id #edb/ref 17592186265875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9f7acf-4772-524d-9933-4e4b011382eb" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186263101} {:answer/id #uuid "84991aa5-a164-5887-9901-28536fb438f2" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186264138} {:answer/id #uuid "aaf8ec22-38b5-5754-a41d-3642a684daa3" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186264466} {:answer/id #uuid "d7fd14d4-5f8d-53a4-85a5-f268e7755565" :answer/type {:db/ident :answer.type/math} :answer/value "-45" :db/id #edb/ref 17592186264882} {:answer/id #uuid "f3caa275-2457-5ac1-9efb-eeb0208aa29a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186265140}] :answer-field/correct {:answer/id #uuid "84991aa5-a164-5887-9901-28536fb438f2" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186264138} :answer-field/id #uuid "21720e07-443d-5bb2-ab55-5c097e6b5435" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265301}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9e66bdd6-8cff-5caf-91ee-00562039faba" :question/math-academy-id "q-130292" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle B=\\begin{bmatrix}5 & 0 & 0 & 0 \\\\ 2 & 6 & 0 & 0 \\\\ -4 & 1 & 2 & 8 \\\\ 9 & 0 & 0 & -1\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $3$rd column contains three zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(B) & =\\begin{vmatrix}5 & 0 & {\\color{lightgray}{0}} & 0 \\\\ 2 & 6 & {\\color{lightgray}{0}} & 0 \\\\ {\\color{lightgray}{-4}} & {\\color{lightgray}{1}} & 2 & {\\color{lightgray}{8}} \\\\ 9 & 0 & {\\color{lightgray}{0}} & -1\\end{vmatrix} \\\\  & =2\\cdot (-1)^{3+3}\\begin{vmatrix}5 & 0 & 0 \\\\ 2 & 6 & 0 \\\\ 9 & 0 & -1\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}5 & 0 & 0 \\\\ 2 & 6 & 0 \\\\ 9 & 0 & -1\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}2\\cdot \\begin{vmatrix}5 & 0 & 0 \\\\ 2 & 6 & 0 \\\\ 9 & 0 & -1\\end{vmatrix} & =2\\cdot 5\\cdot 6\\cdot (-1)=-60.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(B)=-60.\n$$"} {:db/id #edb/ref 17592186265879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "636aef10-3270-54bf-b37d-582939738eb0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186263859} {:answer/id #uuid "6b659b14-a1a5-552e-8b00-dca9b612470a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263927} {:answer/id #uuid "6eada1d8-5f71-55fe-bc4b-1f917357671e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186263960} {:answer/id #uuid "b483092a-be5d-5489-a57e-06365388bdcb" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264549} {:answer/id #uuid "d6d9e2c5-2174-5b56-a851-f30f9487514c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264869}] :answer-field/correct {:answer/id #uuid "6b659b14-a1a5-552e-8b00-dca9b612470a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263927} :answer-field/id #uuid "1ee10030-860a-5423-847d-8ae268473b68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c1038fde-ed05-5c15-a434-43fa62ec2a0c" :question/math-academy-id "q-130308" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle E=\\begin{bmatrix}\\frac{7}{4} & \\frac{3}{5} & 0 & \\frac{1}{2} \\\\ 6 & -5 & -\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{4} & \\frac{2}{5} & 0 \\\\ 0 & 0 & \\frac{8}{3} & 0\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}{\\color{lightgray}{\\frac{7}{4}}} & {\\color{lightgray}{\\frac{3}{5}}} & {\\color{lightgray}{0}} & \\frac{1}{2} \\\\ 6 & -5 & -\\frac{1}{4} & {\\color{lightgray}{0}} \\\\ 0 & \\frac{1}{4} & \\frac{2}{5} & {\\color{lightgray}{0}} \\\\ 0 & 0 & \\frac{8}{3} & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =\\frac{1}{2}\\cdot (-1)^{1+4}\\begin{vmatrix}6 & -5 & -\\frac{1}{4} \\\\ 0 & \\frac{1}{4} & \\frac{2}{5} \\\\ 0 & 0 & \\frac{8}{3}\\end{vmatrix} \\\\  & =-\\frac{1}{2}\\cdot \\begin{vmatrix}6 & -5 & -\\frac{1}{4} \\\\ 0 & \\frac{1}{4} & \\frac{2}{5} \\\\ 0 & 0 & \\frac{8}{3}\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\cdot \\begin{vmatrix}6 & -5 & -\\frac{1}{4} \\\\ 0 & \\frac{1}{4} & \\frac{2}{5} \\\\ 0 & 0 & \\frac{8}{3}\\end{vmatrix} & =-\\frac{1}{2}\\cdot (6\\cdot \\frac{1}{4}\\cdot \\frac{8}{3})=-2.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(E)=-2.\n$$"} {:db/id #edb/ref 17592186265881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0429add4-2aea-5cc2-b5e4-8b47b09e9aa4" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186263036} {:answer/id #uuid "160becb5-a116-533d-9e96-dcecccf52cda" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186263207} {:answer/id #uuid "56579d78-87c5-5301-9459-84ebd2b0dd94" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186263744} {:answer/id #uuid "850bebae-2473-59de-a9ae-416d829203bc" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186264144} {:answer/id #uuid "98f0124f-bee3-5aff-9f37-ba78bff49ac9" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186264315}] :answer-field/correct {:answer/id #uuid "160becb5-a116-533d-9e96-dcecccf52cda" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186263207} :answer-field/id #uuid "a64713bd-5e44-5228-a2fc-0af71aa7b132" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265539}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "192bc61f-95e6-574d-85ae-b6351c8929be" :question/math-academy-id "q-130320" :question/problem "Find the determinant of the matrix\n$$\n\\displaystyle C=\\begin{bmatrix}5 & 8 & 5 & 6 \\\\ 7 & \\,\\,\\,-4 & 1 & 2 \\\\ 0 & 4 & 0 & 0 \\\\ 3 & \\,\\,\\,-2 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $3$rd row contains three zeros. So, using Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}5 & {\\color{lightgray}{8}} & 5 & 6 \\\\ 7 & {\\color{lightgray}{-4}} & 1 & 2 \\\\ {\\color{lightgray}{0}} & 4 & {\\color{lightgray}{0}} & {\\color{lightgray}{0}} \\\\ 3 & {\\color{lightgray}{-2}} & 0 & 0\\end{vmatrix} \\\\  & =4\\cdot (-1)^{3+2}\\begin{vmatrix}5 & 5 & 6 \\\\ 7 & 1 & 2 \\\\ 3 & 0 & 0\\end{vmatrix} \\\\  & =-4\\cdot \\begin{vmatrix}5 & 5 & 6 \\\\ 7 & 1 & 2 \\\\ 3 & 0 & 0\\end{vmatrix}\\end{aligned}\n$$\n\nNow, notice that the $3$rd row of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}det(C) & =-4\\cdot \\begin{vmatrix}{\\color{lightgray}{5}} & 5 & 6 \\\\ {\\color{lightgray}{7}} & 1 & 2 \\\\ 3 & {\\color{lightgray}{0}} & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =(-4)\\cdot (3\\cdot (-1)^{3+1}\\begin{vmatrix}5 & 6 \\\\ 1 & 2\\end{vmatrix}) \\\\  & =-12\\cdot \\begin{vmatrix}5 & 6 \\\\ 1 & 2\\end{vmatrix} \\\\  & =-12(10-6) \\\\  & =(-12)\\cdot 4 \\\\  & =-48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb3393d-32c9-5bdf-9ebb-1e63400365d6" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186263133} {:answer/id #uuid "121e7e63-f36b-51ee-bc85-4970d581ce91" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186263168} {:answer/id #uuid "37391e5d-3b89-519a-bbec-e7821adfaa81" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186263495} {:answer/id #uuid "ceb66f2f-f3c3-5469-8fd1-a2a9e128c1ab" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186264811} {:answer/id #uuid "dbcae654-c04a-5a33-870d-cf5b11c8fafa" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186264914}] :answer-field/correct {:answer/id #uuid "ceb66f2f-f3c3-5469-8fd1-a2a9e128c1ab" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186264811} :answer-field/id #uuid "c208a04d-da4f-540c-bb21-415169293ef0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265586}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1bb816f-d348-556a-937e-40ca064b8b64" :question/math-academy-id "q-130328" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle S=\\begin{bmatrix}-3 & -1 & 2 & 0 \\\\ 5 & -7 & 0 & 0 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 0 & 5 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(S) & =\\begin{vmatrix}-3 & -1 & 2 & {\\color{lightgray}{0}} \\\\ 5 & -7 & 0 & {\\color{lightgray}{0}} \\\\ 0 & 2 & 0 & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{0}} & {\\color{lightgray}{5}} & 3\\end{vmatrix} \\\\  & =3\\cdot (-1)^{4+4}\\begin{vmatrix}-3 & -1 & 2 \\\\ 5 & -7 & 0 \\\\ 0 & 2 & 0\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}-3 & -1 & 2 \\\\ 5 & -7 & 0 \\\\ 0 & 2 & 0\\end{vmatrix}\\end{aligned}\n$$\n\nNow, notice that the $3$rd column of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(S) & =3\\cdot \\begin{vmatrix}{\\color{lightgray}{-3}} & {\\color{lightgray}{-1}} & 2 \\\\ 5 & -7 & {\\color{lightgray}{0}} \\\\ 0 & 2 & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =3\\cdot 2\\cdot (-1)^{1+3}\\begin{vmatrix}5 & -7 \\\\ 0 & 2\\end{vmatrix} \\\\  & =6\\cdot \\begin{vmatrix}5 & -7 \\\\ 0 & 2\\end{vmatrix} \\\\  & =6(10-0) \\\\  & =6\\cdot 10 \\\\  & =60.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1498611b-0556-5abc-869c-1401b16619d8" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186327110} {:answer/id #uuid "2da4d16b-5145-5932-ba3b-2df5df669f02" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186327339} {:answer/id #uuid "afb70833-7f98-5202-981d-07c80b7212d3" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328456} {:answer/id #uuid "ef6ed8db-dc5e-5828-b443-f57f860dbc72" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186329025} {:answer/id #uuid "f2a73c5e-483e-5442-87d1-6ee3b9e074c1" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186329052}] :answer-field/correct {:answer/id #uuid "f2a73c5e-483e-5442-87d1-6ee3b9e074c1" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186329052} :answer-field/id #uuid "1eaa93b8-bf26-5114-b9d3-e50e9e4165b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329234}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4012f96f-2f93-5c2e-93bb-fa81bfcb07ff" :question/math-academy-id "q-42486" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle C=\\begin{bmatrix}2 & 5 & 0 & 0 \\\\ -4 & 8 & -4 & 0 \\\\ 7 & 7 & 5 & 3 \\\\ 1 & 0 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th row contains three zeros. So, using Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}{\\color{lightgray}{2}} & 5 & 0 & 0 \\\\ {\\color{lightgray}{-4}} & 8 & -4 & 0 \\\\ {\\color{lightgray}{7}} & 7 & 5 & 3 \\\\ 1 & {\\color{lightgray}{0}} & {\\color{lightgray}{0}} & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+1}\\begin{vmatrix}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{vmatrix} \\\\  & =-\\begin{vmatrix}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-\\begin{vmatrix}5 & 0 & 0 \\\\ 8 & -4 & 0 \\\\ 7 & 5 & 3\\end{vmatrix} & =-1\\cdot (5\\cdot (-4)\\cdot 3)=60.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(C)=60.\n$$"} {:db/id #edb/ref 17592186329698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7000a217-4435-526b-b200-effd548ffb43" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186327908} {:answer/id #uuid "99a6dd33-35c1-56e8-be21-39631ff1b887" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328261} {:answer/id #uuid "b44e7329-de37-5ec8-82e6-18783ad06a95" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186328502} {:answer/id #uuid "c418b73b-c4e0-5117-9c26-b479706f4607" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328654} {:answer/id #uuid "e2e4d300-ace5-5df3-9e76-83e1460f7723" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186328920}] :answer-field/correct {:answer/id #uuid "b44e7329-de37-5ec8-82e6-18783ad06a95" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186328502} :answer-field/id #uuid "af5a31b6-8c92-56e7-b3da-d9146c997969" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329489}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1ea69780-9815-5bcf-b663-589f1bb5bcec" :question/math-academy-id "q-42956" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle K=\\begin{bmatrix}2 & 1 & 4 & 0 \\\\ -2 & \\,-1 & 0 & 0 \\\\ 0 & -1 & 0 & 0 \\\\ 0 & 0 & 8 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(K) & =\\begin{vmatrix}2 & 1 & 4 & {\\color{lightgray}{0}} \\\\ -2 & \\hspace{-0.167em}-1 & 0 & {\\color{lightgray}{0}} \\\\ 0 & -1 & 0 & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{0}} & {\\color{lightgray}{8}} & 1\\end{vmatrix} \\\\  & =1\\cdot (-1)^{4+4}\\begin{vmatrix}2 & 1 & 4 \\\\ -2 & -1 & 0 \\\\ 0 & -1 & 0\\end{vmatrix} \\\\  & =\\begin{vmatrix}2 & 1 & 4 \\\\ -2 & -1 & 0 \\\\ 0 & -1 & 0\\end{vmatrix}\\end{aligned}\n$$\n\nNow, notice that the $3$rd column of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(K) & =\\begin{vmatrix}{\\color{lightgray}{2}} & {\\color{lightgray}{1}} & 4 \\\\ -2 & -1 & {\\color{lightgray}{0}} \\\\ 0 & -1 & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =4\\cdot (-1)^{1+3}\\begin{vmatrix}-2 & -1 \\\\ 0 & -1\\end{vmatrix} \\\\  & =4\\cdot \\begin{vmatrix}-2 & -1 \\\\ 0 & -1\\end{vmatrix} \\\\  & =4(2-0) \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c984e09-e8d2-5135-b5ff-81916a351e95" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336455} {:answer/id #uuid "2d5e2cb1-490e-5f3b-b865-89f1464eb985" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186336466} {:answer/id #uuid "38935e3e-5b0b-5374-8e22-c50d4af654e8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186336559} {:answer/id #uuid "485c01f6-5918-5d64-aa23-be0db26d06c7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186336704} {:answer/id #uuid "4923f7bf-855c-5c14-928c-f372d5597467" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186336712}] :answer-field/correct {:answer/id #uuid "2c984e09-e8d2-5135-b5ff-81916a351e95" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336455} :answer-field/id #uuid "3989b148-b100-5c6b-9a6d-281acffd6c47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338381}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9cb18e3e-e4ff-5f29-8899-3f491f7a731c" :question/math-academy-id "q-69979" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle G=\\begin{bmatrix}1 & 0 & 4 & 0 \\\\ 0 & 2 & 8 & 0 \\\\ 0 & 0 & -1 & 0 \\\\ 13 & 6 & 7 & -2\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(G) & =\\begin{vmatrix}1 & 0 & 4 & {\\color{lightgray}{0}} \\\\ 0 & 2 & 8 & {\\color{lightgray}{0}} \\\\ 0 & 0 & -1 & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{13}} & {\\color{lightgray}{6}} & {\\color{lightgray}{7}} & -2\\end{vmatrix} \\\\  & =(-2)\\cdot (-1)^{4+4}\\begin{vmatrix}1 & 0 & 4 \\\\ 0 & 2 & 8 \\\\ 0 & 0 & -1\\end{vmatrix} \\\\  & =-2\\cdot \\begin{vmatrix}1 & 0 & 4 \\\\ 0 & 2 & 8 \\\\ 0 & 0 & -1\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}(-2)\\cdot \\begin{vmatrix}1 & 0 & 4 \\\\ 0 & 2 & 8 \\\\ 0 & 0 & -1\\end{vmatrix} & =(-2)\\cdot (1\\cdot 2\\cdot (-1))=4.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(G)=4.\n$$"} {:db/id #edb/ref 17592186338734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ea4053-49e8-5168-b098-82430469625d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186336121} {:answer/id #uuid "1f526be7-ec90-5c66-9047-fe096403b260" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186336321} {:answer/id #uuid "608cd9c2-29eb-5826-a7de-08dd4569f81d" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186336906} {:answer/id #uuid "7ec811cf-1595-5300-be5a-c090541a7609" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186337179} {:answer/id #uuid "f66c976f-3fd2-55bb-96d7-c102515381cf" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186338194}] :answer-field/correct {:answer/id #uuid "7ec811cf-1595-5300-be5a-c090541a7609" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186337179} :answer-field/id #uuid "d27254a7-7a2d-59ff-8e48-3b8de8a30567" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338648}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2c7d5db-866e-5c6e-9e0a-4bf934983da9" :question/math-academy-id "q-69980" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle H=\\begin{bmatrix}3 & 0 & 4 & 0 \\\\ 7 & \\,\\,\\,-3 & 8 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 10 & 0 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $3$rd row contains three zeros. So, using Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}3 & 0 & {\\color{lightgray}{4}} & 0 \\\\ 7 & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}-3 & {\\color{lightgray}{8}} & 8 \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{0}} & 1 & {\\color{lightgray}{0}} \\\\ 10 & 0 & {\\color{lightgray}{0}} & 2\\end{vmatrix} \\\\  & =1\\cdot (-1)^{3+3}\\begin{vmatrix}3 & 0 & 0 \\\\ 7 & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}-3 & 8 \\\\ 10 & 0 & 2\\end{vmatrix} \\\\  & =\\begin{vmatrix}3 & 0 & 0 \\\\ 7 & \\hspace{-0.167em}\\hspace{-0.167em}\\hspace{-0.167em}-3 & 8 \\\\ 10 & 0 & 2\\end{vmatrix}\\end{aligned}\n$$\n\nNow, notice that the $1$st row of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}det(H) & =\\begin{vmatrix}3 & {\\color{lightgray}{0}} & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{7}} & -3 & 8 \\\\ {\\color{lightgray}{10}} & 0 & 2\\end{vmatrix} \\\\  & =3\\cdot (-1)^{1+1}\\begin{vmatrix}-3 & 8 \\\\ 0 & 2\\end{vmatrix} \\\\  & =3\\cdot \\begin{vmatrix}-3 & 8 \\\\ 0 & 2\\end{vmatrix} \\\\  & =3(-6-0) \\\\  & =3\\cdot (-6) \\\\  & =-18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de166ca-46b4-544e-904a-cc7975a6f45a" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186336162} {:answer/id #uuid "2375c8a7-9a19-5fd8-b8ee-770553467efc" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336364} {:answer/id #uuid "2cc57ab4-4695-5847-9f1e-f714683c7ee9" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186336457} {:answer/id #uuid "8bc94a86-c87a-5e6a-bfaf-7770bb6cd054" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186337299} {:answer/id #uuid "9547ed6d-0c6a-5acd-a9ec-1e37eee996ae" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186337395}] :answer-field/correct {:answer/id #uuid "9547ed6d-0c6a-5acd-a9ec-1e37eee996ae" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186337395} :answer-field/id #uuid "fb8ca1ef-6050-5261-aedc-d39456e56e94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338723}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1cded5b0-233c-51be-b7fc-66e328db8e2f" :question/math-academy-id "q-69981" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle P=\\begin{bmatrix}1 & 0 & 4 & 0 \\\\ 0 & 0 & -1 & 2 \\\\ -3 & 0 & 8 & 0 \\\\ 1 & -2 & 7 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $2$nd column contains three zeros. So, using Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}\\text{det}(P) & =\\begin{vmatrix}1 & {\\color{lightgray}{0}} & 4 & 0 \\\\ 0 & {\\color{lightgray}{0}} & -1 & 2 \\\\ -3 & {\\color{lightgray}{0}} & 8 & 0 \\\\ {\\color{lightgray}{1}} & -2 & {\\color{lightgray}{7}} & {\\color{lightgray}{1}}\\end{vmatrix} \\\\  & =(-2)\\cdot (-1)^{4+2}\\begin{vmatrix}1 & 4 & 0 \\\\ 0 & -1 & 2 \\\\ -3 & 8 & 0\\end{vmatrix} \\\\  & =-2\\cdot \\begin{vmatrix}1 & 4 & 0 \\\\ 0 & -1 & 2 \\\\ -3 & 8 & 0\\end{vmatrix}\\end{aligned}\n$$\n\nNow, notice that the $3$rd column of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(P) & =-2\\cdot \\begin{vmatrix}1 & 4 & {\\color{lightgray}{0}} \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{-1}} & 2 \\\\ -3 & 8 & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =(-2)\\cdot (2\\cdot (-1)^{2+3}\\begin{vmatrix}1 & 4 \\\\ -3 & 8\\end{vmatrix}) \\\\  & =4\\cdot \\begin{vmatrix}1 & 4 \\\\ -3 & 8\\end{vmatrix} \\\\  & =4(8-(-12)) \\\\  & =4\\cdot 20 \\\\  & =80.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564a9b9e-aab5-5b0f-93e8-ff25aa13561b" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186336826} {:answer/id #uuid "74d85b4a-b12a-5c0f-b5ed-ff52586806e1" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186337084} {:answer/id #uuid "a8927049-3f50-5f32-81d8-ae0adb9041c3" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186337555} {:answer/id #uuid "c1b2cb1f-b916-5d6a-83bd-0b171941131c" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186337754} {:answer/id #uuid "f8db2c98-cfca-5e9d-8c6d-040c9d9da0b5" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186338212}] :answer-field/correct {:answer/id #uuid "a8927049-3f50-5f32-81d8-ae0adb9041c3" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186337555} :answer-field/id #uuid "21e0fd22-373d-5dc1-ac92-23af629fc5c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338341}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e129d90-7991-5aeb-8e6d-b77b70757df7" :question/math-academy-id "q-69982" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle Q=\\begin{bmatrix}5 & 2 & 0 & 5 \\\\ 2 & -4 & -4 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 3 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(Q) & =\\begin{vmatrix}{\\color{lightgray}{5}} & {\\color{lightgray}{2}} & {\\color{lightgray}{0}} & 5 \\\\ 2 & -4 & -4 & {\\color{lightgray}{0}} \\\\ 0 & 1 & 3 & {\\color{lightgray}{0}} \\\\ 0 & 0 & 3 & {\\color{lightgray}{0}}\\end{vmatrix} \\\\  & =5\\cdot (-1)^{1+4}\\begin{vmatrix}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{vmatrix} \\\\  & =-5\\cdot \\begin{vmatrix}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-5\\cdot \\begin{vmatrix}2 & -4 & -4 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 3\\end{vmatrix} & =-5\\cdot (2\\cdot 1\\cdot 3)=-30.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(Q)=-30.\n$$"} {:db/id #edb/ref 17592186370953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f91b8ff9-f8eb-51b8-b52f-289c02818338" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186370955} {:answer/id #uuid "f3e4a327-ea8e-530f-89f9-a4e243adc7d9" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186370956} {:answer/id #uuid "e926e6d7-8c6a-52a4-b903-1e9338a6f201" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186370957} {:answer/id #uuid "c331c706-c3f7-5678-9e57-a7714e5447c5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186370958} {:answer/id #uuid "7ede5ce4-29de-59fd-baf2-447d94e15852" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186370959}] :answer-field/correct {:answer/id #uuid "f91b8ff9-f8eb-51b8-b52f-289c02818338" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186370955} :answer-field/id #uuid "59058239-7698-5829-8ac2-6fc0b1fe2dc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370954}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "67a0d7e9-a72d-5fc5-b7f4-cd87aaa4ba3a" :question/math-academy-id "q-42923" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle F=\\begin{bmatrix}3 & 0 & 0 & 0 \\\\ 3 & -1 & 0 & 0 \\\\ 0 & 0 & -1 & -2 \\\\ 4 & 0 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $3$rd column contains three zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}\\text{det}(F) & =\\begin{vmatrix}3 & 0 & {\\color{lightgray}{0}} & 0 \\\\ 3 & -1 & {\\color{lightgray}{0}} & 0 \\\\ {\\color{lightgray}{0}} & {\\color{lightgray}{0}} & -1 & {\\color{lightgray}{-2}} \\\\ 4 & 0 & {\\color{lightgray}{0}} & -3\\end{vmatrix} \\\\  & =(-1)\\cdot (-1)^{3+3}\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix} \\\\  & =-\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}-\\begin{vmatrix}3 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 4 & 0 & -3\\end{vmatrix} & =-1\\cdot (3\\cdot (-1)\\cdot (-3))=-9.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(F)=-9.\n$$"} {:db/id #edb/ref 17592186572117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a3d5b37-6c2a-5cba-ad78-e9a2626168b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186571558} {:answer/id #uuid "593caf3a-5a8a-5474-911c-e4672c977ceb" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\sqrt{5}" :db/id #edb/ref 17592186571695} {:answer/id #uuid "5aa48bd6-79d0-527f-843f-9ca1892f691d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571697} {:answer/id #uuid "5e28842e-a45a-5471-b0f2-624733f6c02e" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186571702} {:answer/id #uuid "eca12e3d-3b57-505b-bd5b-c92cf39819a7" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{5}" :db/id #edb/ref 17592186571953}] :answer-field/correct {:answer/id #uuid "5e28842e-a45a-5471-b0f2-624733f6c02e" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186571702} :answer-field/id #uuid "72d0d37d-2da5-57c2-b260-86d1c7a8fa86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572032}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1d6c75b7-d9d1-5c4f-a63e-3df78db605e9" :question/math-academy-id "q-42946" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle N=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ \\sqrt{6} & -1 & 0 & 0 \\\\ 5 & 0 & \\sqrt{5} & 2 \\\\ \\sqrt{3} & 0 & 0 & \\sqrt{5}\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $1$st row contains three zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\text{det}(N) & =\\begin{vmatrix}2 & 0 & 0 & 0 \\\\ \\sqrt{6} & -1 & 0 & 0 \\\\ 5 & 0 & \\sqrt{5} & 2 \\\\ \\sqrt{3} & 0 & 0 & \\sqrt{5}\\end{vmatrix} \\\\  & =2\\cdot (-1)^{1+1}\\begin{vmatrix}-1 & 0 & 0 \\\\ 0 & \\sqrt{5} & 2 \\\\ 0 & 0 & \\sqrt{5}\\end{vmatrix} \\\\  & =2\\cdot \\begin{vmatrix}-1 & 0 & 0 \\\\ 0 & \\sqrt{5} & 2 \\\\ 0 & 0 & \\sqrt{5}\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}2\\cdot \\begin{vmatrix}-1 & 0 & 0 \\\\ 0 & \\sqrt{5} & 2 \\\\ 0 & 0 & \\sqrt{5}\\end{vmatrix} & =2\\cdot ((-1)\\cdot \\sqrt{5}\\cdot \\sqrt{5})=-10.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(N)=-10.\n$$"} {:db/id #edb/ref 17592186647806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e951641-491c-58bd-ae98-91a20f76d969" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186647351} {:answer/id #uuid "b85e29f8-6820-540c-aaf7-90a47d1d2ba5" :answer/type {:db/ident :answer.type/math} :answer/value "-74" :db/id #edb/ref 17592186647508} {:answer/id #uuid "bb3db8ce-11d6-5111-b634-eb50f1a51a0f" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186647515} {:answer/id #uuid "e72852f3-1322-51a3-aec4-e32a9c43cdb6" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186647597} {:answer/id #uuid "fc8498ad-6f19-5533-9dbf-f5affa146154" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186647636}] :answer-field/correct {:answer/id #uuid "e72852f3-1322-51a3-aec4-e32a9c43cdb6" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186647597} :answer-field/id #uuid "49ecf6fc-d8c7-5540-89b6-6249f0195d13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186647674}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9bda11b1-d6cb-5fdd-863d-cffbb64624bc" :question/math-academy-id "q-130302" :question/problem "Find the determinant of the matrix \n$$\n\\displaystyle L=\\begin{bmatrix}4 & 0 & 0 & 0 \\\\ 12 & 3 & 0 & 0 \\\\ -13 & 0 & -2 & 5 \\\\ 9 & 0 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Notice that the $1$st row contains three zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}\\text{det}(L) & =\\begin{vmatrix}4 & 0 & 0 & 0 \\\\ 12 & 3 & 0 & 0 \\\\ -13 & 0 & -2 & 5 \\\\ 9 & 0 & 0 & -3\\end{vmatrix} \\\\  & =4\\cdot (-1)^{1+1}\\begin{vmatrix}3 & 0 & 0 \\\\ 0 & -2 & 5 \\\\ 0 & 0 & -3\\end{vmatrix} \\\\  & =4\\cdot \\begin{vmatrix}3 & 0 & 0 \\\\ 0 & -2 & 5 \\\\ 0 & 0 & -3\\end{vmatrix}\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}4\\cdot \\begin{vmatrix}3 & 0 & 0 \\\\ 0 & -2 & 5 \\\\ 0 & 0 & -3\\end{vmatrix} & =4\\cdot (3\\cdot (-2)\\cdot (-3))=72.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\ndet(L)=72.\n$$"} {:db/id #edb/ref 17592186703637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a84a0ce-70d4-536a-ad01-b7086d6dd283" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186703634} {:answer/id #uuid "20ed9cdb-8e07-559c-afa9-f1b03f475390" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186703635} {:answer/id #uuid "3347548c-8dd0-52d7-998f-3b424cb40c54" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703639} {:answer/id #uuid "3a737d7b-cff0-5a1f-bf23-7649a00d5e82" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186703640} {:answer/id #uuid "ddb9d579-665e-55ca-b066-6289e59f09c9" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186703649}] :answer-field/correct {:answer/id #uuid "3a737d7b-cff0-5a1f-bf23-7649a00d5e82" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186703640} :answer-field/id #uuid "6d5eb7e5-1256-5f51-abf8-14c63c2f9196" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703644}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "24f9534c-f081-5666-921a-2702ff3b7cba" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & 2 & 0 & 0 \\\\ 3 & 1 & 0 & 0 \\\\ 4 & 5 & -1 & 0 \\\\ 1 & 0 & 2 & 2\\end{bmatrix}.\n$$\nUse a Laplace expansion along the first row, then evaluate the triangular minor." :question/worked-solution "The first row has only one nonzero entry, in position $(1,2)$. Its cofactor sign is $(-1)^{1+2}=-1$. Deleting row 1 and column 2 gives\n\n$$\n\\det(A)=2(-1)^{1+2}\\begin{vmatrix}3 & 0 & 0 \\\\ 4 & -1 & 0 \\\\ 1 & 2 & 2\\end{vmatrix}=-2\\begin{vmatrix}3 & 0 & 0 \\\\ 4 & -1 & 0 \\\\ 1 & 2 & 2\\end{vmatrix}.\n$$\nThe remaining matrix is lower triangular, so its determinant is the product of its diagonal entries:\n\n$$\n3\\cdot(-1)\\cdot2=-6.\n$$\nTherefore,\n\n$$\n\\det(A)=(-2)(-6)=12.\n$$\n"} {:db/id #edb/ref 17592186703641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21330a06-72a5-5bab-9eeb-9c1d3871c8b9" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186703636} {:answer/id #uuid "2f76f5ce-250c-55d0-8194-744b13da7988" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186703638} {:answer/id #uuid "6c7f37db-d37a-56ba-a5de-eda740ed33ac" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186703643} {:answer/id #uuid "7727855b-b261-5b04-907d-11e8d874ce2d" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186703645} {:answer/id #uuid "e4f23d9e-7480-54be-a8d8-40083081668e" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186703652}] :answer-field/correct {:answer/id #uuid "6c7f37db-d37a-56ba-a5de-eda740ed33ac" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186703643} :answer-field/id #uuid "675edbbd-6ea5-5a1a-8525-13c1696b57c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703642}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5eea92fa-e295-5756-90cf-e38cb6bc6e2f" :question/problem "Find the determinant of the matrix\n\n$$\nB=\\begin{bmatrix}1 & 2 & 1 & 3 \\\\ 2 & -1 & 4 & 1 \\\\ 0 & 2 & 0 & 0 \\\\ 1 & 3 & 0 & 0\\end{bmatrix}.\n$$\n" :question/worked-solution "Row 3 has three zeros. Expand along that row, keeping the sign of the entry in position $(3,2)$:\n\n$$\n\\det(B)=2(-1)^{3+2}\\begin{vmatrix}1 & 1 & 3 \\\\ 2 & 4 & 1 \\\\ 1 & 0 & 0\\end{vmatrix}=-2\\begin{vmatrix}1 & 1 & 3 \\\\ 2 & 4 & 1 \\\\ 1 & 0 & 0\\end{vmatrix}.\n$$\nIn this smaller determinant, expand along row 3. Its nonzero entry is now in position $(3,1)$, with sign $(-1)^{3+1}=1$:\n\n$$\n\\det(B)=(-2)\\cdot1\\cdot(-1)^{3+1}\\begin{vmatrix}1 & 3 \\\\ 4 & 1\\end{vmatrix}=-2(1\\cdot1-3\\cdot4).\n$$\nThus,\n\n$$\n\\det(B)=-2(-11)=22.\n$$\n"} {:db/id #edb/ref 17592186703648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3c2d7e-0599-5836-827a-ccd81ee724b3" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186703633} {:answer/id #uuid "8e9ce469-392f-5f52-a251-32f2c7eb2695" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186703646} {:answer/id #uuid "df8172b3-42ac-5f9c-ac22-cdddd2588685" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186703650} {:answer/id #uuid "e13c9b48-1d95-52c1-b2fb-3701bbe486cb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186703651} {:answer/id #uuid "e674f818-d800-5192-a303-071fd2f6ff5e" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186703653}] :answer-field/correct {:answer/id #uuid "e674f818-d800-5192-a303-071fd2f6ff5e" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186703653} :answer-field/id #uuid "97a5da1f-db41-5930-ab31-928b7aa3e9ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703647}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bffca4e7-0bf9-53f7-83df-1f634b854d33" :question/problem "Find the determinant of the matrix\n\n$$\nC=\\begin{bmatrix}2 & 1 & 0 & 0 \\\\ 0 & 3 & 1 & 0 \\\\ 0 & 0 & 2 & 1 \\\\ 1 & 0 & 0 & 1\\end{bmatrix}.\n$$\n" :question/worked-solution "Each row and column has two nonzero entries. Expanding along row 1 leaves two terms; the signs at $(1,1)$ and $(1,2)$ are $+$ and $-$:\n\n$$\n\\det(C)=2\\begin{vmatrix}3 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 1\\end{vmatrix}-\\begin{vmatrix}0 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 1 & 0 & 1\\end{vmatrix}.\n$$\nThe first minor is upper triangular:\n\n$$\n\\begin{vmatrix}3 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 1\\end{vmatrix}=3\\cdot2\\cdot1=6.\n$$\nFor the second minor, expand along its first column. The only nonzero entry is in position $(3,1)$, with positive cofactor sign:\n\n$$\n\\begin{vmatrix}0 & 1 & 0 \\\\ 0 & 2 & 1 \\\\ 1 & 0 & 1\\end{vmatrix}=1(-1)^{3+1}\\begin{vmatrix}1 & 0 \\\\ 2 & 1\\end{vmatrix}=1\\cdot1-0\\cdot2=1.\n$$\nCombine both contributions:\n\n$$\n\\det(C)=2\\cdot6-1=11.\n$$\n"} {:db/id #edb/ref 17592186704383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0974a0c7-8269-50f5-9269-333d3b196b5f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704385} {:answer/id #uuid "1e69dd23-64ef-563a-ac77-a0cbe3f8f50a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704388} {:answer/id #uuid "376752ec-cfce-57bb-bf4d-df9a5c949339" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704393} {:answer/id #uuid "cb8f0f84-a0ee-5585-8aed-0d3d4e5fef57" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704412} {:answer/id #uuid "cfbd8231-ca70-5a30-8df0-9cc55203739f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704415}] :answer-field/correct {:answer/id #uuid "cfbd8231-ca70-5a30-8df0-9cc55203739f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704415} :answer-field/id #uuid "bdf94aec-1f85-529e-96d7-cbbb79701998" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704410}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "011d16e6-6939-56f5-b73d-fff168ae73d7" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 2 & -2 & 2 \\\\ -1 & -2 & 2 & 3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{4+1}\\begin{vmatrix}2 & 0 & -1 \\\\ 1 & 0 & 1 \\\\ 2 & -2 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{3+2}\\begin{vmatrix}2 & -1 \\\\ 1 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 3 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & -1 \\\\ 1 & 1\\end{vmatrix} \\\\ &=(2)(1)-(-1)(1) \\\\ &=3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{3+2}(3) \\\\ &=6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{4+1}(6) \\\\ &=6.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=6$."} {:db/id #edb/ref 17592186704395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b6deea-fa85-5f50-a311-5a93075befb4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704384} {:answer/id #uuid "95a95589-b30d-5d65-99ba-c8ab2596ba61" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704408} {:answer/id #uuid "b1036f2c-6fa2-5489-a416-9d5c5a16b2f8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704409} {:answer/id #uuid "c3965541-9341-566f-b5f0-6d2f5ff99695" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704411} {:answer/id #uuid "f723223c-2dc2-5b5a-a714-f9a9fb2e567f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704417}] :answer-field/correct {:answer/id #uuid "b1036f2c-6fa2-5489-a416-9d5c5a16b2f8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704409} :answer-field/id #uuid "50ec9776-a284-5675-9390-90ecc0a18c59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704400}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b91d575-508c-5aa1-b7e9-ae9619ddbb4b" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}2 & 0 & \\frac{1}{2} & 0 \\\\ 1 & 3 & -1 & -1 \\\\ 3 & -2 & - \\frac{3}{2} & 0 \\\\ -2 & 0 & - \\frac{1}{2} & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{2+4}\\begin{vmatrix}2 & 0 & \\frac{1}{2} \\\\ 3 & -2 & - \\frac{3}{2} \\\\ -2 & 0 & - \\frac{1}{2}\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+2}\\begin{vmatrix}2 & \\frac{1}{2} \\\\ -2 & - \\frac{1}{2}\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & \\frac{1}{2} \\\\ -2 & - \\frac{1}{2}\\end{vmatrix} \\\\ &=(2)\\left(- \\frac{1}{2}\\right)-\\left(\\frac{1}{2}\\right)(-2) \\\\ &=0.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+2}(0) \\\\ &=0.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{2+4}(0) \\\\ &=0.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=0$."} {:db/id #edb/ref 17592186704401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2207fa0a-2b85-5a84-99b8-e0cab749a1e4" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704390} {:answer/id #uuid "322669cb-bfd6-5b69-9efb-9a210087cf3b" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704392} {:answer/id #uuid "5eb3aea6-b30b-5078-bcbe-1de96b52818c" :answer/type {:db/ident :answer.type/math} :answer/value "4 - 2 \\sqrt{3}" :db/id #edb/ref 17592186704404} {:answer/id #uuid "6f7cf6f4-7120-5887-87b8-d519e7da680c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704405} {:answer/id #uuid "79058757-4e63-5765-80fa-801e254af8bd" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 2 \\sqrt{3}" :db/id #edb/ref 17592186704407}] :answer-field/correct {:answer/id #uuid "322669cb-bfd6-5b69-9efb-9a210087cf3b" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704392} :answer-field/id #uuid "37b8a0e4-cd76-5935-87fa-acd2a84c836c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704394}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5306fe3f-b2d8-52ea-ad10-ffa4c780480f" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & - 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ -2 & 3 \\sqrt{3} & 1 & \\sqrt{3} \\\\ 0 & 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & 0 & \\sqrt{3}\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{2+1}\\begin{vmatrix}- 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & \\sqrt{3}\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}- 2 \\sqrt{3} & 1 & - 2 \\sqrt{3} \\\\ 0 & 2 & 2 \\sqrt{3} \\\\ 0 & 0 & \\sqrt{3}\\end{vmatrix} \\\\ &=(- 2 \\sqrt{3})\\cdot(2)\\cdot(\\sqrt{3}) \\\\ &=-12.\\end{aligned}\n$$\n\nUse $\\sqrt{3}\\cdot\\sqrt{3}=3$.\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{2+1}(-12) \\\\ &=-24.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-24$."} {:db/id #edb/ref 17592186704402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f7563-3eec-5fc9-b737-a21dd802eece" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704389} {:answer/id #uuid "448f2107-2d71-5d28-a199-8f29bef5487a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704397} {:answer/id #uuid "44a87ad0-f3d4-5549-aa21-c7efae8fc47c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704398} {:answer/id #uuid "5aa02756-8b6f-58cc-a2a8-b29931a3877e" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704403} {:answer/id #uuid "e53f6058-d838-5c9b-a511-b0c78a37a740" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186704416}] :answer-field/correct {:answer/id #uuid "44a87ad0-f3d4-5549-aa21-c7efae8fc47c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704398} :answer-field/id #uuid "cc91082f-5cf9-51de-bb28-99c105593211" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704413}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54ef2a5d-9a4a-55e0-bbc4-d1618ef2c4c1" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}0 & 0 & 0 & -2 \\\\ 2 & 1 & 1 & -3 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 0 & -1 & -1\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 1; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{1+4}\\begin{vmatrix}2 & 1 & 1 \\\\ 0 & -2 & -1 \\\\ 0 & 0 & -1\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}2 & 1 & 1 \\\\ 0 & -2 & -1 \\\\ 0 & 0 & -1\\end{vmatrix} \\\\ &=(2)\\cdot(-2)\\cdot(-1) \\\\ &=4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{1+4}(4) \\\\ &=8.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=8$."} {:db/id #edb/ref 17592186704406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d70c3a0-22aa-5b1b-b16f-da791bb42bd6" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186704387} {:answer/id #uuid "2fad0001-76e0-5670-b0d2-73c03ac01d5c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704391} {:answer/id #uuid "4119dbef-9674-589f-8ad9-90d64e9f4d04" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704396} {:answer/id #uuid "4e21047b-fc02-5d4c-9787-683bafb81980" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186704399} {:answer/id #uuid "cd67c6ef-6ac5-5bfc-b10b-f6b84f5af577" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704414}] :answer-field/correct {:answer/id #uuid "1d70c3a0-22aa-5b1b-b16f-da791bb42bd6" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186704387} :answer-field/id #uuid "1010b3b0-6428-5031-ba0f-7f613b37cb14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704386}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "744ecaa5-6d28-55ef-8866-e937c7b43ecb" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-1 & - \\frac{1}{2} & -1 & -1 \\\\ 0 & 0 & 0 & -1 \\\\ -2 & 0 & 0 & 2 \\\\ -1 & -2 & 1 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{2+4}\\begin{vmatrix}-1 & - \\frac{1}{2} & -1 \\\\ -2 & 0 & 0 \\\\ -1 & -2 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+1}\\begin{vmatrix}- \\frac{1}{2} & -1 \\\\ -2 & 1\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 1.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}- \\frac{1}{2} & -1 \\\\ -2 & 1\\end{vmatrix} \\\\ &=\\left(- \\frac{1}{2}\\right)(1)-(-1)(-2) \\\\ &=- \\frac{5}{2}.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+1}\\left(- \\frac{5}{2}\\right) \\\\ &=-5.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{2+4}(-5) \\\\ &=5.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=5$."} {:db/id #edb/ref 17592186704421 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020bb060-10e7-5b61-a37b-5c9cddf61c02" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186704419} {:answer/id #uuid "05fc86f3-2513-57cc-a9cb-15dae93f7c3e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704420} {:answer/id #uuid "879c2284-b918-5aac-b628-ab01b9a01260" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704429} {:answer/id #uuid "9546e3ec-4c09-5efc-a551-3af4deb0203b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704431} {:answer/id #uuid "ad9ce7b6-2fb0-5cd0-a62f-e3d720682201" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704434}] :answer-field/correct {:answer/id #uuid "05fc86f3-2513-57cc-a9cb-15dae93f7c3e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186704420} :answer-field/id #uuid "15302738-55c4-596b-8f91-13991b5c440c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704422}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0fab570c-8bd2-5bf1-8911-22ecd1914d6a" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & 2 & 1 & -1 \\\\ 1 & 3 & 2 & 0 \\\\ 0 & 3 & -2 & 0 \\\\ 0 & 0 & -2 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along column 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 1 nonzero entry contributes.\n\n$$\nD=(-1)(-1)^{1+4}\\begin{vmatrix}1 & 3 & 2 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}1 & 3 & 2 \\\\ 0 & 3 & -2 \\\\ 0 & 0 & -2\\end{vmatrix} \\\\ &=(1)\\cdot(3)\\cdot(-2) \\\\ &=-6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-1)(-1)^{1+4}(-6) \\\\ &=-6.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-6$."} {:db/id #edb/ref 17592186704424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e65ef6-e044-51a0-bf5c-07faf3182555" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704423} {:answer/id #uuid "66360cf9-99c7-5a89-855d-430f5099d3ed" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704426} {:answer/id #uuid "9c29c588-4aa0-5294-8c29-ec32ce339ede" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186704432} {:answer/id #uuid "9c8694a0-1a90-52dc-86f2-3e0d11c85609" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186704433} {:answer/id #uuid "e52a280a-95e0-5e57-a0bc-666805eede59" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704445}] :answer-field/correct {:answer/id #uuid "20e65ef6-e044-51a0-bf5c-07faf3182555" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704423} :answer-field/id #uuid "dc83ca58-540c-5eab-a3d4-cc640f9df767" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704444}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "38f78fea-a626-5841-9772-48532c5c45b8" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}1 & -1 & 0 & 0 \\\\ -1 & -3 & -1 & 0 \\\\ -2 & -2 & 3 & -2 \\\\ 1 & 0 & 0 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 4; only 1 nonzero entry contributes.\n\n$$\nD=(1)(-1)^{4+1}\\begin{vmatrix}-1 & 0 & 0 \\\\ -3 & -1 & 0 \\\\ -2 & 3 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}-1 & 0 & 0 \\\\ -3 & -1 & 0 \\\\ -2 & 3 & -2\\end{vmatrix} \\\\ &=(-1)\\cdot(-1)\\cdot(-2) \\\\ &=-2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(1)(-1)^{4+1}(-2) \\\\ &=2.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=2$."} {:db/id #edb/ref 17592186704438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b5a742d-29a1-5970-b231-6ecd7e2c2484" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704425} {:answer/id #uuid "7337fa5c-29cf-5b05-b43c-9d2f7e3669f4" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704428} {:answer/id #uuid "90389884-7478-5b57-a04b-34f0ee8c5481" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186704430} {:answer/id #uuid "b8b39029-9dbf-545b-8078-6a54e7b7c664" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186704437} {:answer/id #uuid "cbc1447d-0bff-529b-a62f-60637fbd6397" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186704441}] :answer-field/correct {:answer/id #uuid "7337fa5c-29cf-5b05-b43c-9d2f7e3669f4" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704428} :answer-field/id #uuid "d2ce3ad3-207c-5f83-884e-8a6fd2079c3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704443}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "be42bff7-3e35-5e00-aabd-5902ea02c85a" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-1 & 2 & 2 & 1 \\\\ -2 & 0 & 3 & 3 \\\\ -1 & 0 & 0 & -2 \\\\ -2 & 0 & 0 & 0\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 4, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 4; only 1 nonzero entry contributes.\n\n$$\nD=(-2)(-1)^{4+1}\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 4 and column 1.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}2 & 2 & 1 \\\\ 0 & 3 & 3 \\\\ 0 & 0 & -2\\end{vmatrix} \\\\ &=(2)\\cdot(3)\\cdot(-2) \\\\ &=-12.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-2)(-1)^{4+1}(-12) \\\\ &=-24.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-24$."} {:db/id #edb/ref 17592186704442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2002381-5da8-5a6d-8a89-c0bfa3a3eaea" :answer/type {:db/ident :answer.type/math} :answer/value "-81" :db/id #edb/ref 17592186704435} {:answer/id #uuid "b436d5ef-2cd9-5933-8063-5a4b6e8d0576" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704436} {:answer/id #uuid "bf25fcf9-64cb-58d7-8a92-fffbd2342bda" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704439} {:answer/id #uuid "c14e284f-dea5-5618-bd15-5f9ee1408ed9" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186704440} {:answer/id #uuid "fac05fd5-2d31-5b3d-9f78-c5446c0f2b06" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186704446}] :answer-field/correct {:answer/id #uuid "fac05fd5-2d31-5b3d-9f78-c5446c0f2b06" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186704446} :answer-field/id #uuid "67c9e640-ea34-5044-a804-5365830157d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704427}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cd6c25b7-82b1-5674-a549-fd1555cd26ba" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 3 & -1 & -1 \\\\ 0 & 0 & 3 & 2\\end{bmatrix}.\n$$\nUse a Laplace expansion along row 2, then evaluate the triangular minor." :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD=(-3)(-1)^{2+4}\\begin{vmatrix}-3 & -1 & 1 \\\\ 0 & 3 & -1 \\\\ 0 & 0 & 3\\end{vmatrix}.\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4.\n\nThe matrix in $D_{1}$ is triangular, so multiply its diagonal entries.\n\n$$\n\\begin{aligned}D_{1} &=\\begin{vmatrix}-3 & -1 & 1 \\\\ 0 & 3 & -1 \\\\ 0 & 0 & 3\\end{vmatrix} \\\\ &=(-3)\\cdot(3)\\cdot(3) \\\\ &=-27.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{2+4}(-27) \\\\ &=81.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=81$."} {:db/id #edb/ref 17592186704534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ad09dd-5090-53a4-bb8c-9040f6998812" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186704543} {:answer/id #uuid "bbbb60b9-f607-5a92-bed2-8ec04d86e803" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186704546} {:answer/id #uuid "d095374a-601c-50ba-92ab-688a2085cd06" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186704548} {:answer/id #uuid "d1e691b0-5e54-5cc7-9039-6185ffcd4601" :answer/type {:db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186704549} {:answer/id #uuid "f608d31f-35c8-5971-83ee-1306f2e96770" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186704556}] :answer-field/correct {:answer/id #uuid "d095374a-601c-50ba-92ab-688a2085cd06" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186704548} :answer-field/id #uuid "69437ce8-3833-5f4a-815e-517c3d5b4987" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704540}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2cdd9e81-e911-5932-b8a8-e9d8825a6ac9" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-3 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 2 & 2 \\\\ 1 & -2 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 1; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{1+1}\\begin{vmatrix}1 & 0 & -3 \\\\ 0 & 2 & 2 \\\\ -2 & 0 & 0\\end{vmatrix} \\\\ &\\quad +(1)(-1)^{4+1}\\begin{vmatrix}0 & 1 & 0 \\\\ 1 & 0 & -3 \\\\ 0 & 2 & 2\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 1 and column 1, and $D_{2}$ for the minor obtained by deleting row 4 and column 1.\n\nExpand $D_{1}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(2)(-1)^{2+2}\\begin{vmatrix}1 & -3 \\\\ -2 & 0\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}1 & -3 \\\\ -2 & 0\\end{vmatrix} \\\\ &=(1)(0)-(-3)(-2) \\\\ &=-6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(2)(-1)^{2+2}(-6) \\\\ &=-12.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 1; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(1)(-1)^{2+1}\\begin{vmatrix}1 & 0 \\\\ 2 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 2 and column 1.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}1 & 0 \\\\ 2 & 2\\end{vmatrix} \\\\ &=(1)(2)-(0)(2) \\\\ &=2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(1)(-1)^{2+1}(2) \\\\ &=-2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(-3)(-1)^{1+1}(-12)+(1)(-1)^{4+1}(-2) \\\\ &=38.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=38$."} {:db/id #edb/ref 17592186704547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "223b931c-b0d0-5e9c-ac82-8129e440bd53" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186704533} {:answer/id #uuid "314857d8-9db1-5184-bcc0-d60a84fc6f0f" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186704535} {:answer/id #uuid "50c80433-d412-58eb-8c2c-04729e76cf38" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704536} {:answer/id #uuid "595dc589-90a5-5a9a-b06c-ddb7bd788c71" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186704538} {:answer/id #uuid "d41763f7-88c1-52bf-8c4e-b6374619c914" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186704550}] :answer-field/correct {:answer/id #uuid "595dc589-90a5-5a9a-b06c-ddb7bd788c71" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186704538} :answer-field/id #uuid "a065bec3-7535-5103-a6d7-5cba158dcf53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704544}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c2a7b07a-e881-5538-b894-061c5483b2f7" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}2 & -1 & 0 & 0 \\\\ 0 & 0 & -1 & 2 \\\\ -3 & 0 & -1 & 0 \\\\ 0 & -2 & 0 & -3\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+4}\\begin{vmatrix}2 & -1 & 0 \\\\ -3 & 0 & -1 \\\\ 0 & -2 & 0\\end{vmatrix} \\\\ &\\quad +(-3)(-1)^{4+4}\\begin{vmatrix}2 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -3 & 0 & -1\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4, and $D_{2}$ for the minor obtained by deleting row 4 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-1)(-1)^{2+3}\\begin{vmatrix}2 & -1 \\\\ 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}2 & -1 \\\\ 0 & -2\\end{vmatrix} \\\\ &=(2)(-2)-(-1)(0) \\\\ &=-4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-1)(-1)^{2+3}(-4) \\\\ &=-4.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(-1)(-1)^{1+2}\\begin{vmatrix}0 & -1 \\\\ -3 & -1\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 1 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}0 & -1 \\\\ -3 & -1\\end{vmatrix} \\\\ &=(0)(-1)-(-1)(-3) \\\\ &=-3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(-1)(-1)^{1+2}(-3) \\\\ &=-3.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+4}(-4)+(-3)(-1)^{4+4}(-3) \\\\ &=1.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=1$."} {:db/id #edb/ref 17592186704554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08986ba9-269c-5f9c-a4da-571c81113de8" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186704530} {:answer/id #uuid "531c3eb7-f203-5d62-9e9e-ce6fed848c18" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186704537} {:answer/id #uuid "7206e007-85c2-5891-8852-ae92fbb3d8ac" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186704541} {:answer/id #uuid "e1008537-8552-5d58-9ab7-2a10c48c01ac" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186704552} {:answer/id #uuid "ee7b1374-2dec-5455-a882-49269febc8d3" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186704555}] :answer-field/correct {:answer/id #uuid "531c3eb7-f203-5d62-9e9e-ce6fed848c18" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186704537} :answer-field/id #uuid "adf305a7-b2d6-51b2-a9a7-b60bfbe71582" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704545}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e7c50abb-3dea-5f9e-8553-e44ec7cfa578" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}3 & -1 & 0 & 0 \\\\ 2 & 0 & 0 & 2 \\\\ 0 & 0 & 2 & -2 \\\\ 0 & 2 & -2 & 0\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along row 2; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+1}\\begin{vmatrix}-1 & 0 & 0 \\\\ 0 & 2 & -2 \\\\ 2 & -2 & 0\\end{vmatrix} \\\\ &\\quad +(2)(-1)^{2+4}\\begin{vmatrix}3 & -1 & 0 \\\\ 0 & 0 & 2 \\\\ 0 & 2 & -2\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 1, and $D_{2}$ for the minor obtained by deleting row 2 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-2)(-1)^{2+3}\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}-1 & 0 \\\\ 2 & -2\\end{vmatrix} \\\\ &=(-1)(-2)-(0)(2) \\\\ &=2.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-2)(-1)^{2+3}(2) \\\\ &=4.\\end{aligned}\n$$\n\nExpand $D_{2}$ along row 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(2)(-1)^{2+3}\\begin{vmatrix}3 & -1 \\\\ 0 & 2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 2 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}3 & -1 \\\\ 0 & 2\\end{vmatrix} \\\\ &=(3)(2)-(-1)(0) \\\\ &=6.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(2)(-1)^{2+3}(6) \\\\ &=-12.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(2)(-1)^{2+1}(4)+(2)(-1)^{2+4}(-12) \\\\ &=-32.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-32$."} {:db/id #edb/ref 17592186704557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161269f0-a160-5704-a88e-6a6ff299ef56" :answer/type {:db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186704531} {:answer/id #uuid "1ef3cc63-90f2-5b33-8b82-22ac9275937c" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186704532} {:answer/id #uuid "7e8012c8-7641-5dc5-a5fb-579a4259517a" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186704542} {:answer/id #uuid "d532ca2b-3247-5e6a-9d84-3527c3206804" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186704551} {:answer/id #uuid "e375ac85-0a30-5bbd-abf2-a0f3bc2d4e52" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186704553}] :answer-field/correct {:answer/id #uuid "1ef3cc63-90f2-5b33-8b82-22ac9275937c" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186704532} :answer-field/id #uuid "6177ca0d-04d3-5d48-bb69-6bb27eb91ca0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186704539}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f8940873-a3cb-5e97-bc5f-3f853d67c84e" :question/problem "Find the determinant of the matrix\n\n$$\nA=\\begin{bmatrix}-2 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 3 \\\\ -3 & -2 & 0 & 0 \\\\ 0 & -3 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "Write $D=\\det(A)$.\n\nExpand $D$ along column 4; only 2 nonzero entries contribute.\n\n$$\n\\begin{aligned}D &=(3)(-1)^{2+4}\\begin{vmatrix}-2 & 0 & -1 \\\\ -3 & -2 & 0 \\\\ 0 & -3 & 0\\end{vmatrix} \\\\ &\\quad +(1)(-1)^{4+4}\\begin{vmatrix}-2 & 0 & -1 \\\\ 0 & 0 & -2 \\\\ -3 & -2 & 0\\end{vmatrix}.\\end{aligned}\n$$\n\nWrite $D_{1}$ for the minor obtained by deleting row 2 and column 4, and $D_{2}$ for the minor obtained by deleting row 4 and column 4.\n\nExpand $D_{1}$ along column 3; only 1 nonzero entry contributes.\n\n$$\nD_{1}=(-1)(-1)^{1+3}\\begin{vmatrix}-3 & -2 \\\\ 0 & -3\\end{vmatrix}.\n$$\n\nWrite $D_{11}$ for the minor obtained by deleting row 1 and column 3.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{11} &=\\begin{vmatrix}-3 & -2 \\\\ 0 & -3\\end{vmatrix} \\\\ &=(-3)(-3)-(-2)(0) \\\\ &=9.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{1} &=(-1)(-1)^{1+3}(9) \\\\ &=-9.\\end{aligned}\n$$\n\nExpand $D_{2}$ along column 2; only 1 nonzero entry contributes.\n\n$$\nD_{2}=(-2)(-1)^{3+2}\\begin{vmatrix}-2 & -1 \\\\ 0 & -2\\end{vmatrix}.\n$$\n\nWrite $D_{21}$ for the minor obtained by deleting row 3 and column 2.\n\nEvaluate the two by two determinant:\n\n$$\n\\begin{aligned}D_{21} &=\\begin{vmatrix}-2 & -1 \\\\ 0 & -2\\end{vmatrix} \\\\ &=(-2)(-2)-(-1)(0) \\\\ &=4.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D_{2} &=(-2)(-1)^{3+2}(4) \\\\ &=8.\\end{aligned}\n$$\n\nSubstituting these minor values,\n\n$$\n\\begin{aligned}D &=(3)(-1)^{2+4}(-9)+(1)(-1)^{4+4}(8) \\\\ &=-19.\\end{aligned}\n$$\n\nTherefore, $\\det(A)=-19$."}] :knowledge-point/title "Calculating the Determinant of a Matrix With Many Zeros"}]}
