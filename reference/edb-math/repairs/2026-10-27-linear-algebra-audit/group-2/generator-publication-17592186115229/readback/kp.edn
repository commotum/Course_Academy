gin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}\n$$\n\nCompute the entries by row-by-column products:\n\n$$\n\\begin{aligned}(A^2)_{11} &= (-1)\\cdot (-1)+(-1)\\cdot 2=-1 \\\\ (A^2)_{12} &= (-1)\\cdot (-1)+(-1)\\cdot 2=-1 \\\\ (A^2)_{21} &= 2\\cdot (-1)+2\\cdot 2=2 \\\\ (A^2)_{22} &= 2\\cdot (-1)+2\\cdot 2=2\\end{aligned}\n$$\n\nThus,\n\n$$\nA^2=\\begin{bmatrix}-1 & -1 \\\\ 2 & 2\\end{bmatrix}.\n$$\n"} {:db/id #edb/ref 17592186719728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79d028c8-38c3-53fb-8d71-65c578e170a5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719740}] :answer-field/correct {:answer/id #uuid "79d028c8-38c3-53fb-8d71-65c578e170a5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719740} :answer-field/id #uuid "0842fcb2-fca0-56a8-a74d-a5401827e44a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719714} {:answer-field/choices [{:answer/id #uuid "aba894c6-7e68-5866-838b-d5ebb6fbe711" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719747}] :answer-field/correct {:answer/id #uuid "aba894c6-7e68-5866-838b-d5ebb6fbe711" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186719747} :answer-field/id #uuid "37617403-b66b-54bf-8089-5816192de223" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719725} {:answer-field/choices [{:answer/id #uuid "5182ea73-538c-5e90-9be5-8edd161c87d1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186719731}] :answer-field/correct {:answer/id #uuid "5182ea73-538c-5e90-9be5-8edd161c87d1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186719731} :answer-field/id #uuid "4cbfd2bd-57ae-5e3c-99b6-abe7110cab3e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/