es 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}-4 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-13\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}5 \\\\ -1 \\\\ 3\\end{bmatrix}\\cdot \\begin{bmatrix}-13\\end{bmatrix} \\\\  & =\\begin{bmatrix}-65 \\\\ 13 \\\\ -39\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5380e4f7-3997-5eec-a4c1-2dd08757f0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186297904}] :answer-field/correct {:answer/id #uuid "5380e4f7-3997-5eec-a4c1-2dd08757f0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186297904} :answer-field/id #uuid "2488bf7b-4c5f-5b36-8cbb-ca49d28d8bf9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298761} {:answer-field/choices [{:answer/id #uuid "07a31a1b-94aa-5cea-9846-cc139c0dc4ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186297589}] :answer-field/correct {:answer/id #uuid "07a31a1b-94aa-5cea-9846-cc139c0dc4ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186297589} :answer-field/id #uuid "8ab1180c-fa05-5dcf-b73c-82d0a580b13c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299102} {:answer-field/choices [{:answer/id #uuid "27f662dc-9756-5093-86b7-94ddad217ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-182" :db/id #edb/ref 17592186297722}] :answer-field/correct {:answer/id #uuid "27f662dc-9756-5093-86b7-94ddad217ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-182" :db/id #edb/ref 17592186297722} :answer-field/id #uuid "a09c47e6-4da3-5f54-947d-4183a7d968e3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299170}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5aecc675-116f-5b56-855b-8a2ff5a85c00" :question/math-academy-id "q-319943" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix},\\,B=\\begin{bmatrix}5 & -1\\end{bmatrix},\\,C=\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}.\n$$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $ABC=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 1$ matrix, $B$ is a $1\\times 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}5 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-4 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-26\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix}\\cdot \\begin{bmatrix}-26\\end{bmatrix} \\\\  & =\\begin{bmatrix}78 \\\\ -52 \\\\ -182\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6482cff8-ea84-5d14-a24d-9034a0c7b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186297981}] :answer-field/correct {:answer/id #uuid "6482cff8-ea84-5d14-a24d-9034a0c7b0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186297981} :answer-field/id #uuid "24506a77-9b74-5997-b750-9ae0f37f53de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298759} {:answer-field/choices [{:answer/id #uuid "4004e514-65cc-5ba3-8951-7fdfa32a9481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186297805}] :answer-field/correct {:answer/id #uuid "4004e514-65cc-5ba3-8951-7fdfa32a9481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186297805} :answer-field/id #uuid "4fb3cc92-18ef-57d1-8cf8-4873a0f63452" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298907} {:answer-field/choices [{:answer/id #uuid "67ac13fb-5f80-5b63-8caf-0023f6f87094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186297998}] :answer-field/correct {:answer/id #uuid "67ac13fb-5f80-5b63-8caf-0023f6f87094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186297998} :answer-field/id #uuid "d1529332-216e-5593-b381-6e2408117b50" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299347}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "34cd5f5a-f82e-5ae5-899e-5e1bd32cf8b9" :question/math-academy-id "q-320021" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}6 & -2\\end{bmatrix},\\,B=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix},\\,C=\\begin{bmatrix}2 & -4 & 5\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}6 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}-1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\cdot (-1)+(-2)\\cdot 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $(AB)$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)\\,C \\\\  & =\\begin{bmatrix}-12\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 & 48 & -60\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186298101}] :answer-field/correct {:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186298101} :answer-field/id #uuid "298a71ad-58e1-55a8-a4ab-0720f04e5f75" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298777} {:answer-field/choices [{:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "136" :db/id #edb/ref 17592186297954}] :answer-field/correct {:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "136" :db/id #edb/ref 17592186297954} :answer-field/id #uuid "a531995d-b29d-5426-9f4b-9a89a67a333f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d60a4e0-4fdb-56f1-b62d-65e7bbd5fd84" :question/math-academy-id "q-320026" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-4 & 6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix}.\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-4 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-58 & 136\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0768e386-ed42-523a-8b81-d32778b33888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 18 & 9 \\\\ 21 & 7 & -42 \\\\ 8 & 2 & -6\\end{bmatrix}" :db/id #edb/ref 17592186324039} {:answer/id #uuid "5765f40b-6dcf-5301-9949-f4819aec1ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 \\\\ 42 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186324697} {:answer/id #uuid "8bca11ec-165a-537d-b134-38df44b671e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{bmatrix}" :db/id #edb/ref 17592186325158} {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186325358} {:answer/id #uuid "f31eb4fa-cff2-5b17-9422-8db3c6117a17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-144" :db/id #edb/ref 17592186326112}] :answer-field/correct {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186325358} :answer-field/id #uuid "b79923e4-1da4-5e24-8a5e-c420b9db32e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326548}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0594dca0-de16-5429-abef-c4b9b45aec7e" :question/math-academy-id "q-42001" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\,C=\\begin{bmatrix}-2 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d6f5d49-745b-5ede-bd5a-5fba9ad228e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}" :db/id #edb/ref 17592186324875} {:answer/id #uuid "80a1cf50-d570-5721-9f08-cde570f35644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 \\\\ 30 \\\\ 36\\end{bmatrix}" :db/id #edb/ref 17592186325047} {:answer/id #uuid "80e94439-3053-5945-8cd8-c5472e86cc65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 30 & 24\\end{bmatrix}" :db/id #edb/ref 17592186325049} {:answer/id #uuid "831a2a1f-be35-584b-82e9-94e6bad8d512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 \\\\ -12 \\\\ 24\\end{bmatrix}" :db/id #edb/ref 17592186325075} {:answer/id #uuid "951ff042-febe-53ab-80bd-fc8751546317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-36\\end{bmatrix}" :db/id #edb/ref 17592186325239}] :answer-field/correct {:answer/id #uuid "6d6f5d49-745b-5ede-bd5a-5fba9ad228e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}" :db/id #edb/ref 17592186324875} :answer-field/id #uuid "d930fd29-15ea-5832-a242-908e83b9d76e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326613}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "872a04d1-c3a7-5abb-ba35-c6553a0edf68" :question/math-academy-id "q-42002" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -2\\end{bmatrix},\\,C=\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 1$ matrix, $B$ is a $1\\times 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}2 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d094e2-1177-5e99-96ad-7caeee897640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450618} {:answer/id #uuid "ca99c815-da6d-51d7-a07d-611d7659f788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450619}] :answer-field/correct {:answer/id #uuid "98d094e2-1177-5e99-96ad-7caeee897640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450618} :answer-field/id #uuid "c30fd7ce-bd14-59fb-ab10-845f8a59bb92" :answer-field/key "$AB=BA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451263} {:answer-field/choices [{:answer/id #uuid "956b7a25-6517-5ef2-837c-39c50a5c5a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450620} {:answer/id #uuid "bd63bdd4-4b06-56ad-b67b-a613cc1dd46f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450621}] :answer-field/correct {:answer/id #uuid "bd63bdd4-4b06-56ad-b67b-a613cc1dd46f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450621} :answer-field/id #uuid "382ec9ba-1720-5328-8c38-f194ab93dcab" :answer-field/key "$(AB)C=A(BC)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451264} {:answer-field/choices [{:answer/id #uuid "762ad639-2afc-55e3-bdc7-be4e7057c714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450622} {:answer/id #uuid "7a78eef3-ff9c-56b5-98cb-545a4b324d66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450623}] :answer-field/correct {:answer/id #uuid "762ad639-2afc-55e3-bdc7-be4e7057c714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450622} :answer-field/id #uuid "800a3551-29f1-5bb8-a3bc-66ca201c01c9" :answer-field/key "$A(B-C)=(B-C)A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451265}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "005a0156-3d99-59d1-ab99-adf9b9b4c7b4" :question/math-academy-id "q-42264" :question/problem "Given that $A,B,$ and $C$ are $2\\times 2$ matrices, which of the following statements are always true?\n\nSelect all that apply." :question/worked-solution "Let's consider the statements one by one.\n\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement $(AB)C=A(BC)$ is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\n\n- Statement $A(B-C)=(B-C)A$ is false. Matrix multiplication is not commutative, so $A(B-C)\\ne (B-C)A$ in general.\n\nTherefore, only statement $(AB)C=A(BC)$ is true."}] [{:db/id #edb/ref 17592186329641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450624} {:answer/id #uuid "55e4960c-b4a8-5dc4-9358-5474cf82f7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450625}] :answer-field/correct {:answer/id #uuid "0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450624} :answer-field/id #uuid "3d5404b0-68d0-5679-9acd-82c4cfdc5828" :answer-field/key "$AB=BA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451266} {:answer-field/choices [{:answer/id #uuid "a7725433-91f4-58a8-86f9-aeb838dcca83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450626} {:answer/id #uuid "db204d99-d48d-5b15-a94d-fd45955b1ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450627}] :answer-field/correct {:answer/id #uuid "db204d99-d48d-5b15-a94d-fd45955b1ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450627} :answer-field/id #uuid "36d78dc9-a409-525c-846b-1acf74456b6c" :answer-field/key "$A(B+C)=AB+AC$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451267} {:answer-field/choices [{:answer/id #uuid "6be3f3c0-0d5f-53d8-b5d4-1cdbc4330e3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450628} {:answer/id #uuid "32dd403d-28b4-5b42-93d6-1c1a8a1630d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450629}] :answer-field/correct {:answer/id #uuid "32dd403d-28b4-5b42-93d6-1c1a8a1630d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450629} :answer-field/id #uuid "baab8b40-76af-5c21-b0d3-f31812f8c1dd" :answer-field/key "$B{I}_{5}={I}_{5}B$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451268}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cea2f24d-948b-5d70-91c6-23df57186795" :question/math-academy-id "q-42267" :question/problem "Given that $A,B,$ and $C$ are $5\\times 5$ matrices, and  ${I}_{5}$ is the $5\\times 5$ identity matrix, which of the following statements are always true?\n\nSelect all that apply." :question/worked-solution "Let's consider the statements one by one.\n\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement $A(B+C)=AB+AC$ is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\n\n- Statement $B{I}_{5}={I}_{5}B$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $B{I}_{5}={I}_{5}B=B.$\n\nTherefore, only statements $A(B+C)=AB+AC$ and $B{I}_{5}={I}_{5}B$ are true."}] [{:db/id #edb/ref 17592186345111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee09dde-9c18-57ab-a901-5cb48ac60b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 0 & -2 \\\\ 0 & -1 & 0 \\\\ -2 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186342366} {:answer/id #uuid "acddba2b-17ca-56dc-8396-ff2e31f12d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186343760} {:answer/id #uuid "b1e2f292-6220-5944-8085-85b72df63404" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186343799} {:answer/id #uuid "b265b790-4d44-5977-8ab0-7c363f5b3089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186343806} {:answer/id #uuid "e00b655d-026d-51b0-a39a-995529f592be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 4 \\\\ 0 & 2 & 0 \\\\ 4 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186344204}] :answer-field/correct {:answer/id #uuid "e00b655d-026d-51b0-a39a-995529f592be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 4 \\\\ 0 & 2 & 0 \\\\ 4 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186344204} :answer-field/id #uuid "67aaf379-1aa5-553d-babc-0323dc49f059" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344669}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80c9e376-8c41-538a-b47f-6281460b7dd2" :question/math-academy-id "q-75635" :question/problem "Calculate $CB+CA$, where\n\n$$\nA=\\begin{bmatrix}2 & 3 & \\sqrt{2} \\\\ -1 & 3 & 2 \\\\ \\sqrt{3} & 2 & -1\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -3 & -\\sqrt{2} \\\\ 1 & 1 & -2 \\\\ -\\sqrt{3} & -2 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "We apply the distributive law \n\n$$\nCB+CA=C(B+A).\n$$\n\nSo, we calculate $B+A$ first:\n\n$$\n\\begin{aligned}B+A & =\\begin{bmatrix}2 & -3 & -\\sqrt{2} \\\\ 1 & 1 & -2 \\\\ -\\sqrt{3} & -2 & 5\\end{bmatrix}+\\begin{bmatrix}2 & 3 & \\sqrt{2} \\\\ -1 & 3 & 2 \\\\ \\sqrt{3} & 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix} \\\\  & =4{I}_{3}\\end{aligned}\n$$\n\n \n\nFinally, we obtain\n\n$$\n\\begin{aligned}CB+CA & =C(B+A) \\\\  & =C\\cdot 4{I}_{3} \\\\  & =4C \\\\  & =\\begin{bmatrix}4 & 0 & 4 \\\\ 0 & 2 & 0 \\\\ 4 & 0 & 4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5b4b6c9-b120-5669-8778-9d44bd03a705" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451627} {:answer/id #uuid "5c9ff174-54f1-5fc0-82c9-56c7f68be83b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451628}] :answer-field/correct {:answer/id #uuid "5c9ff174-54f1-5fc0-82c9-56c7f68be83b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451628} :answer-field/id #uuid "c6596886-eb35-5a15-8678-0d03898ac57c" :answer-field/key "$A(B+C)=AC+AB$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452661} {:answer-field/choices [{:answer/id #uuid "6b1b7dcd-0a45-5a31-b1e7-359ba6b8ce48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451629} {:answer/id #uuid "2844641e-66b1-56cc-8371-e36f6a1b3ff0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451630}] :answer-field/correct {:answer/id #uuid "6b1b7dcd-0a45-5a31-b1e7-359ba6b8ce48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451629} :answer-field/id #uuid "648f05bf-a002-5add-8c9a-e67860f117ba" :answer-field/key "$A(BC)=(BA)C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452662} {:answer-field/choices [{:answer/id #uuid "aec13ecc-22bc-5436-b215-dddd0d181f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451631} {:answer/id #uuid "ddfc103f-6039-5ed8-b224-6f15716dcaa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451632}] :answer-field/correct {:answer/id #uuid "aec13ecc-22bc-5436-b215-dddd0d181f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451631} :answer-field/id #uuid "5ce1dbe9-397b-565f-a4c9-e832cb32d032" :answer-field/key "$AB=BA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452663}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1c88851c-8567-55d2-897e-8b0f9b020c35" :question/math-academy-id "q-75662" :question/problem "Given that $A,B,$ and $C$ are $7\\times 7$ matrices, which of the following statements are always true?\n\nSelect all that apply." :question/worked-solution "Let's consider the statements one by one.\n\n- Statement $A(B+C)=AC+AB$ is true. Matrix multiplication is distributive, so \n\n$$\nA(B+C)=AB+AC=AC+AB\n$$\n\n since matrix addition is commutative.\n\n- Statement $A(BC)=(BA)C$ is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\n\n$$\n\\begin{aligned}A(BC) &=(AB)C\\ne (BA)C.\\end{aligned}\n$$\n\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\nTherefore, only statement $A(B+C)=AC+AB$ is true."}] [{:db/id #edb/ref 17592186345116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd2d4af-fcc8-55b6-bf9b-9feed35a4e39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451633} {:answer/id #uuid "8c44c3d1-8408-5b27-9d56-5820850d8e6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451634}] :answer-field/correct {:answer/id #uuid "3fd2d4af-fcc8-55b6-bf9b-9feed35a4e39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451633} :answer-field/id #uuid "875098b9-5492-5e1a-b53e-55972f8d78c0" :answer-field/key "$AB=BA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452664} {:answer-field/choices [{:answer/id #uuid "2c09b308-44c0-5d82-b117-e79d490fc908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451635} {:answer/id #uuid "e5ea9fe4-7d06-5ee2-81e0-6e343876dfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451636}] :answer-field/correct {:answer/id #uuid "e5ea9fe4-7d06-5ee2-81e0-6e343876dfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451636} :answer-field/id #uuid "f365105a-7265-5164-bb84-ae009541d7d4" :answer-field/key "$A{I}_{4}={I}_{4}A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452665} {:answer-field/choices [{:answer/id #uuid "086cedd9-2c5d-5cf5-8342-fff602804217" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451637} {:answer/id #uuid "d576ec60-2dbd-5562-90ac-ff700e520b13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451638}] :answer-field/correct {:answer/id #uuid "d576ec60-2dbd-5562-90ac-ff700e520b13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451638} :answer-field/id #uuid "8bf272d3-96d9-5e52-bf3a-2077d76af75c" :answer-field/key "$A(B+{I}_{4})=AB+A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452666}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8619c3de-3523-5f87-a248-dac65df502b6" :question/math-academy-id "q-75664" :question/problem "Given that $A$ and $B$  are $4\\times 4$ matrices,  and ${I}_{4}$ is the $4\\times 4$ identity matrix,  which of the following statements are always true?\n\nSelect all that apply." :question/worked-solution "Let's consider the statements one by one.\n\n- Statement $AB=BA$ is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement $A{I}_{4}={I}_{4}A$ is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{4}={I}_{4}A=A.$\n\n- Statement $A(B+{I}_{4})=AB+A$ is true. Matrix multiplication is distributive, so $A(B+{I}_{4})=AB+A{I}_{4}=AB+A$ in general.\n\nTherefore, only statements $A{I}_{4}={I}_{4}A$  and $A(B+{I}_{4})=AB+A$ are true."}] [{:db/id #edb/ref 17592186345117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d29adab0-49f5-5be8-9dfb-41b652b9f78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451639} {:answer/id #uuid "aae53705-b1e7-5ad4-a458-fc12bd5715e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451640}] :answer-field/correct {:answer/id #uuid "d29adab0-49f5-5be8-9dfb-41b652b9f78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451639} :answer-field/id #uuid "4ec2f6a3-b7c4-5dbf-b313-e1460364d497" :answer-field/key "$CB=BC$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452667} {:answer-field/choices [{:answer/id #uuid "163312b5-47ae-51a4-8302-780627f27eaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451641} {:answer/id #uuid "8391eb9d-de48-5257-958c-71e626ee3926" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451642}] :answer-field/correct {:answer/id #uuid "163312b5-47ae-51a4-8302-780627f27eaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451641} :answer-field/id #uuid "7e9e4ab6-972e-5a28-8a06-204e593f15c3" :answer-field/key "$A(B-C)=AB-CA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452668} {:answer-field/choices [{:answer/id #uuid "5abcda23-f4db-5653-8749-2127e4eb2cc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451643} {:answer/id #uuid "83789ace-8be4-5fa7-bb78-667b324a5f43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451644}] :answer-field/correct {:answer/id #uuid "83789ace-8be4-5fa7-bb78-667b324a5f43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451644} :answer-field/id #uuid "ebdef35b-4dc7-5168-954f-85f588629353" :answer-field/key "$A(BC)=(AB)C$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452669}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ca7b9cd-e052-55a9-b9b9-9f438a40909d" :question/math-academy-id "q-75717" :question/problem "Given that $A,B,$ and $C$ are $6\\times 6$ matrices which of the following statements are always true?\n\nSelect all that apply." :question/worked-solution "Let's consider the statements one by one.\n\n- Statement $CB=BC$ is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement $A(B-C)=AB-CA$ is false. Matrix multiplication is distributive, so $A(B-C)=AB-AC,$ but $AC\\ne CA$ because matrix multiplication is not commutative in general.\n\n- Statement $A(BC)=(AB)C$ is true. Matrix multiplication is associative and  $A(BC)=(AB)C$ is always true.\n\nTherefore, only statement  $A(BC)=(AB)C$ is true."}] [{:db/id #edb/ref 17592186388090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94eaedeb-d14a-5b50-9cc7-4ad0b2f03f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ \\sqrt{2} & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388092} {:answer/id #uuid "a956827c-a23e-56c4-9e5f-8c8e21ce2a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388093} {:answer/id #uuid "3bdf7634-79ef-565d-858f-11943c4d903e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & \\sqrt{2} & 0 \\\\ 0 & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388094} {:answer/id #uuid "ffa6a60f-415f-5b14-8f97-93d351d78b98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388095} {:answer/id #uuid "ae69e124-6446-5af0-9833-757e17efe5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & -\\sqrt{2} & 2 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388096}] :answer-field/correct {:answer/id #uuid "ffa6a60f-415f-5b14-8f97-93d351d78b98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388095} :answer-field/id #uuid "737de3a2-dc25-52ae-ba23-56212b940498" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c8441f0a-579a-53ac-9a6d-fa812952db44" :question/math-academy-id "q-130259" :question/problem "Calculate $AC+BC$, where\n\n$$\nA=\\begin{bmatrix}1 & 2 & 3 \\\\ 3 & 2 & -3 \\\\ -3 & -4 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}-1 & -2 & -3 \\\\ -2 & -2 & 3 \\\\ 3 & 4 & -2\\end{bmatrix},\\,C=\\begin{bmatrix}-2 & \\sqrt{2} & 1 \\\\ 1 & -\\sqrt{2} & 2 \\\\ -2 & 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 2 & 3 \\\\ 3 & 2 & -3 \\\\ -3 & -4 & 2\\end{bmatrix}+\\begin{bmatrix}-1 & -2 & -3 \\\\ -2 & -2 & 3 \\\\ 3 & 4 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\begin{bmatrix}-2 & \\sqrt{2} & 1 \\\\ 1 & -\\sqrt{2} & 2 \\\\ -2 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5\\end{bmatrix}" :db/id #edb/ref 17592186392450} {:answer/id #uuid "52743f64-5575-5f50-ab83-057fdf07b94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186392451} {:answer/id #uuid "56be43e4-cbda-5ce6-b53d-23acb1dfe969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -3 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392452} {:answer/id #uuid "77068922-3e71-5bec-a56b-febc23200124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186392453} {:answer/id #uuid "55501deb-48c2-5461-b4b5-3c1803f7a5f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5 \\\\ 1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186392454}] :answer-field/correct {:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5\\end{bmatrix}" :db/id #edb/ref 17592186392450} :answer-field/id #uuid "fb19f32f-0991-5b71-b98c-bdea9bdda5e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392449}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "54c6b58b-7b12-5b44-8e47-3a85c2ee0cea" :question/math-academy-id "q-41981" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 3 \\\\ 1 & 4\\end{bmatrix},\\,C=\\begin{bmatrix}4 & -3 \\\\ -1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-3 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 11\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}2 & 11\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -3 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e619a67-9c5c-5198-a6e6-8fe2cae308d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}55 \\\\ -21 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392503} {:answer/id #uuid "26af411f-4369-55ad-9e9b-e90514a5bcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-68 \\\\ -22 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392504} {:answer/id #uuid "d5580b66-a310-537c-a0c5-a20457678669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-68 \\\\ -22 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186392505} {:answer/id #uuid "45d96025-8f3a-50af-9de9-cd071e5ec232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}68 \\\\ -22 \\\\ 40\\end{bmatrix}" :db/id #edb/ref 17592186392506} {:answer/id #uuid "a3df1fc7-14b6-532e-b12c-6343f041272c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}42 \\\\ -12 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392507}] :answer-field/correct {:answer/id #uuid "26af411f-4369-55ad-9e9b-e90514a5bcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-68 \\\\ -22 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392504} :answer-field/id #uuid "ed3d0a23-eac0-554f-905e-6466f6601ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392502}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4cbd1e16-e623-56fd-8563-e7c6cd4b5ff2" :question/math-academy-id "q-42258" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-1 & 6 \\\\ 1 & 3 \\\\ 5 & -1\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 1 & 2 \\\\ 0 & -5 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}3 & 1 & 2 \\\\ 0 & -5 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 \\\\ -10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-1 & 6 \\\\ 1 & 3 \\\\ 5 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}8 \\\\ -10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-68 \\\\ -22 \\\\ 50\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a43c89-29de-5118-a4d4-3f996c643cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -2 \\\\ 15 & -7 \\\\ 9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392510} {:answer/id #uuid "c445d736-2b33-5a39-a7be-0a95976a8481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ 15 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186392511} {:answer/id #uuid "cbc16d9e-74fc-598e-a8df-a8298f3cced4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -2 \\\\ -15 & 7 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186392512} {:answer/id #uuid "b96c80d8-2ac1-5468-adbf-38acb2a30f63" :answer/type {:db/id #edb/ref 17592186045498 :db