\ 15 & 25 & 5 \\\\ -10\\sqrt{7} & 5 & 15\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e233e64-3579-5308-adcf-0a3d34ed29d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484954}] :answer-field/correct {:answer/id #uuid "3e233e64-3579-5308-adcf-0a3d34ed29d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186484954} :answer-field/id #uuid "47bcd799-0bc3-56c0-89be-70bb4ebb64ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485398} {:answer-field/choices [{:answer/id #uuid "0ebeac41-ad6f-5e78-914d-22f0aeb5dd17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484846}] :answer-field/correct {:answer/id #uuid "0ebeac41-ad6f-5e78-914d-22f0aeb5dd17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186484846} :answer-field/id #uuid "aae6b6ee-6c60-535b-9bd3-32a07cc14ec8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485441} {:answer-field/choices [{:answer/id #uuid "24f12064-302a-52c9-8e88-80bf05a286d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484886}] :answer-field/correct {:answer/id #uuid "24f12064-302a-52c9-8e88-80bf05a286d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186484886} :answer-field/id #uuid "ae3e7ed6-338b-5cae-8e40-b8c7b35d8018" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485443}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5fdc95ea-e1eb-5331-974c-7dbe555559e4" :question/math-academy-id "q-319197" :question/problem "Calculate $AC+BC$, where\n\n$$\nA=\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}-2 & 0 & 2 \\\\ -1 & -1 & -4 \\\\ 0 & -1 & -4\\end{bmatrix},\\,C=\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & 4 & 2 \\\\ 5 & -1 & 3\\end{bmatrix}.\n$$\n\n|  |  | $2$ | {{field-1}} | $0$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $AC+BC=\\,\\,$ |  | {{field-2}} | $4$ | $2$ |  |\n|  |  | $5$ | {{field-3}} | $3$ |  |" :question/worked-solution "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}3 & 0 & -2 \\\\ 1 & 2 & 4 \\\\ 0 & 1 & 5\\end{bmatrix}+\\begin{bmatrix}-2 & 0 & 2 \\\\ -1 & -1 & -4 \\\\ 0 & -1 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & ={I}_{3}\\cdot C \\\\  & =C \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 3 & 4 & 2 \\\\ 5 & -1 & 3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6afbb954-8251-54c6-9289-3b7b67977c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}" :db/id #edb/ref 17592186485049} {:answer/id #uuid "9f8c7b20-ab9a-5f82-aa71-ab274f566e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186485162} {:answer/id #uuid "a457aec9-c905-57bd-a32b-334aab799f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3\\sqrt{3} & 0 \\\\ 0 & 0 & 3\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485175} {:answer/id #uuid "d93c949b-2601-5a6c-bdfe-2a018e7d7553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -\\sqrt{2} & -\\sqrt{3} \\\\ -2 & -\\sqrt{3} & -2 \\\\ -3 & -2 & -\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485273} {:answer/id #uuid "dbc1e4f5-2794-5ee2-870f-276a9e8a1fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & \\sqrt{2} & \\sqrt{3} \\\\ 2 & \\sqrt{3} & 2 \\\\ 3 & 2 & \\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186485279}] :answer-field/correct {:answer/id #uuid "6afbb954-8251-54c6-9289-3b7b67977c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}" :db/id #edb/ref 17592186485049} :answer-field/id #uuid "1201651f-fb8b-5f4f-9fec-edb4aa86cc4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485374}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "72e0b567-7c07-513e-b4b8-2088d6f698dd" :question/math-academy-id "q-75612" :question/problem "Find $AC+BC$, where\n\n$$\nA=\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & -3 & 1 \\\\ 3 & 2 & -6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -2 & 1 \\\\ -3 & 6 & -1 \\\\ -3 & -2 & 9\\end{bmatrix},\\,C=\\begin{bmatrix}1 & \\sqrt{2} & \\sqrt{3} \\\\ 2 & \\sqrt{3} & 2 \\\\ 3 & 2 & \\sqrt{5}\\end{bmatrix}.\n$$" :question/worked-solution "We apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 2 & -1 \\\\ 3 & -3 & 1 \\\\ 3 & 2 & -6\\end{bmatrix}+\\begin{bmatrix}2 & -2 & 1 \\\\ -3 & 6 & -1 \\\\ -3 & -2 & 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =3{I}_{3}\\end{aligned}\n$$\n\n \n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =3{I}_{3}C \\\\  & =3C \\\\  & =\\begin{bmatrix}3 & 3\\sqrt{2} & 3\\sqrt{3} \\\\ 6 & 3\\sqrt{3} & 6 \\\\ 9 & 6 & 3\\sqrt{5}\\text{ }\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0baea8e6-67f2-5e1f-8d1f-49751d15a460" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186484839} {:answer/id #uuid "150d4133-0a25-50d9-a5b6-3426cedc7ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186484857} {:answer/id #uuid "b6bd451c-1d47-509f-8a91-0bb7d9a2e039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186485211} {:answer/id #uuid "b779c7a3-5d4b-56ea-9ee5-63a3e5e72954" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186485212} {:answer/id #uuid "d6de882f-5289-5eb0-83ae-5e40d163532c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186485268}] :answer-field/correct {:answer/id #uuid "0baea8e6-67f2-5e1f-8d1f-49751d15a460" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186484839} :answer-field/id #uuid "72242043-aa0f-565d-a557-78a4b73b318a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485413}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96d290b8-46cc-5702-9916-bb75bce9f305" :question/math-academy-id "q-75663" :question/problem "Given that $A,B,$ and $C$ are $4\\times 4$ matrices, and ${I}_{4}$ is the $4\\times 4$ identity matrix,  which of the following statements are always true?\n\nI. $A{I}_{4}={I}_{4}A$\n\nII. $(CA)B=C(AB)$\n\nIII. $BC=CB$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $A{I}_{4}={I}_{4}A=A.$\n\n- Statement II is true. Matrix multiplication is asociative, so $(CA)B=C(AB)$ in general.\n\n- Statement III is false. Matrix multiplication is not commutative, so $BC\\ne CB$ in general.\n\nTherefore, only statements I  and II are true."}] [{:db/id #edb/ref 17592186485578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c8bceae-a8f8-59df-9913-53898f44b673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186485052}] :answer-field/correct {:answer/id #uuid "6c8bceae-a8f8-59df-9913-53898f44b673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186485052} :answer-field/id #uuid "16cf85a0-d4e0-503b-a40c-377068739a10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485376} {:answer-field/choices [{:answer/id #uuid "df658338-ffbc-54a4-8fc3-4233fa4b9c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485286}] :answer-field/correct {:answer/id #uuid "df658338-ffbc-54a4-8fc3-4233fa4b9c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485286} :answer-field/id #uuid "91a5a09a-06e9-5e46-b927-635849a5367f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485429} {:answer-field/choices [{:answer/id #uuid "f3e847ec-d131-5985-94dc-25f91ed6df64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186485336}] :answer-field/correct {:answer/id #uuid "f3e847ec-d131-5985-94dc-25f91ed6df64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186485336} :answer-field/id #uuid "fc2e3df9-3029-583e-b5fd-63d9b4b790dc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485478}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4c5958e-629a-595b-ba26-53d736ebe0b2" :question/math-academy-id "q-320017" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}3 & -2 \\\\ -1 & 5 \\\\ 4 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-2 & 1 & 0 \\\\ 3 & -3 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $ABC=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore,\n\n- multiplying $A$ by $B$ gives a $3\\times 3$ matrix, which would require finding $9$ entries, while\n\n- multiplying $B$ by $C$ gives a $2\\times 1$ matrix, which requires finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}-2 & 1 & 0 \\\\ 3 & -3 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}3 & -2 \\\\ -1 & 5 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -15 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #e