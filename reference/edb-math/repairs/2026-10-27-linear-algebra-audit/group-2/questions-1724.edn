gin{bmatrix}7 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 \\\\ 15 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186408070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4caef308-f829-5678-91b0-8c356246d3db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 2 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186408051} {:answer/id #uuid "5305f733-f1f5-5fee-a5d0-db365d37810d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186408052} {:answer/id #uuid "adb0e76d-9986-5b8e-a736-d4821798cae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 6 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186408058} {:answer/id #uuid "efb8a5b6-21b1-5345-9b9e-e436922d4029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186408063} {:answer/id #uuid "feae4636-ed31-53a4-b5a1-dfde035b20cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6 \\\\ 28\\end{bmatrix}" :db/id #edb/ref 17592186408064}] :answer-field/correct {:answer/id #uuid "feae4636-ed31-53a4-b5a1-dfde035b20cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6 \\\\ 28\\end{bmatrix}" :db/id #edb/ref 17592186408064} :answer-field/id #uuid "9eb9eed7-da79-5b44-8508-0e1881d8523f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408066}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38a55885-c791-5e66-b4d4-e155d750a7c6" :question/math-academy-id "q-130322" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 & 1 \