e/math} :answer/value "-12" :db/id #edb/ref 17592186717506} :answer-field/id #uuid "cec39c40-5b1f-5bb5-9504-e4a3f4b635ea" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717513} {:answer-field/choices [{:answer/id #uuid "66f6df8b-6fee-5eff-9821-8c8b441fe9ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186717499}] :answer-field/correct {:answer/id #uuid "66f6df8b-6fee-5eff-9821-8c8b441fe9ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186717499} :answer-field/id #uuid "d4cd38b5-3067-55f6-87a0-876662148431" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717515}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4de9405f-1520-54e1-92d3-e7ba15edacd2" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}2 & -1 & 3 \\\\ 1 & 4 & -2 \\\\ -3 & 2 & 1\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}1 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{bmatrix}\n$$\n\n$$\nC=\\begin{bmatrix}1 & -2 & -2 \\\\ 1 & 1 & 4 \\\\ -1 & -1 & 2\\end{bmatrix}.\n$$\n\nEnter the entries of $ABC$ in the table.\n\n| |Column 1|Column 2|Column 3|\n|---|---|---|---|\n|Row 1|{{field-1}}|{{field-2}}|{{field-3}}|\n|Row 2|{{field-4}}|{{field-5}}|{{field-6}}|\n|Row 3|{{field-7}}|{{field-8}}|{{field-9}}|\n" :question/worked-solution "The associative law lets us change the parentheses while keeping the factors in order:\n\n$$\n\\begin{aligned}ABC &= (AB)C \\\\ &= A(BC).\\end{aligned}\n$$\n\nAll three matrices are $3\\times3$, so the intermediate dimensions alone do not favor either grouping. Computing $BC$ reveals cancellations:\n\n$$\n\\begin{aligned}BC &= \\begin{bmatrix}1 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & -2 & -2 \\\\ 1 & 1 & 4 \\\\ -1 & -1 & 2\\end{bmatrix} \\\\ &= \\begin{bmatrix}1+1+1 & -2+1+1 & -2+4-2 \\\\ 1-1 & -2-1 & -2+2 \\\\ 1-1 & 1-1 & 4+2\\end{bmatrix} \\\\ &= \\begin{bmatrix}3 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying $A$ on the right by this diagonal matrix scales its first, second, and third columns by $3$, $-3$, and $6$, respectively. The order matters; scaling the rows would compute $(BC)A$. Therefore,\n\n$$\n\\begin{aligned}ABC &= A(BC) \\\\ &= \\begin{bmatrix}2 & -1 & 3 \\\\ 1 & 4 & -2 \\\\ -3 & 2 & 1\\end{bmatrix}\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & 6\\end{bmatrix} \\\\ &= \\begin{bmatrix}2(3) & (-1)(-3) & 3(6) \\\\ 1(3) & 4(-3) & (-2)(6) \\\\ (-3)(3) & 2(-3) & 1(6)\\end{bmatrix} \\\\ &= \\begin{bmatrix}6 & 3 & 18 \\\\ 3 & -12 & -12 \\\\ -9 & -6 & 6\\end{bmatrix}.\\end{aligned}\n$$\n\n"}] [{:db/id #edb/ref 17592186717512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef29583-be73-5980-8d53-68f660e2e88a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ -2 & -4\\end{bmatrix}" :db/id #edb/ref 17592186717488} {:answer/id #uuid "150f1212-c36c-5327-9ff4-701d25e51245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}" :db/id #edb/ref 17592186717489} {:answer/id #uuid "718d92d6-5312-536e-b358-cd9a1482dc89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186717501} {:answer/id #uuid "7e631623-92b3-55b0-89fe-0f0b25a42b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186717503} {:answer/id #uuid "eba655fb-9dd8-5371-9639-7d8bd9eb4c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ -2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186717519}] :answer-field/correct {:answer/id #uuid "150f1212-c36c-5327-9ff4-701d25e51245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}" :db/id #edb/ref 17592186717489} :answer-field/id #uuid "dd04e184-95a0-5c52-8977-6d147ff8c13c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186717518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bcf22643-b2bf-5f10-8849-53af9f98e84a" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & 2 & -1 \\\\ -2 & 1 & 3\\end{bmatrix},\\quad B=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\quad C=\\begin{bmatrix}-1 & 2\\end{bmatrix}.\n$$\n\n" :question/worked-solution "The associative law lets us change the parentheses while keeping the factors in order:\n\n$$\n\\begin{aligned}ABC &= (AB)C \\\\ &= A(BC).\\end{aligned}\n$$\n\nThe dimensions are $2\\times3$, $3\\times1$, and $1\\times2$. Thus $AB$ has two entries, while $BC$ has six. Compute $AB$ first:\n\n$$\n\\begin{aligned}AB &= \\begin{bmatrix}1 & 2 & -1 \\\\ -2 & 1 & 3\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\ &= \\begin{bmatrix}1\\cdot2+2\\cdot(-1)+(-1)\\cdot1 \\\\ (-2)\\cdot2+1\\cdot(-1)+3\\cdot1\\end{bmatrix} \\\\ &= \\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nNow form the outer product:\n\n$$\n\\begin{aligned}ABC &= (AB)C \\\\ &= \\begin{bmatrix}-1 \\\\ -2\\end{bmatrix}\\begin{bmatrix}-1 & 2\\end{bmatrix} \\\\ &= \\begin{bmatrix}(-1)(-1) & (-1)\\cdot2 \\\\ (-2)(-1) & (-2)\\cdot2\\end{bmatrix} \\\\ &= \\begin{bmatrix}1 & -2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\n"}] [{:db/id #edb/ref 17592186717517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d09174e-09bf-5b77-834b-0ea2907def05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186717491}] :answer-field/correct {:answer/id #uuid "1d09174e-09bf-5b77-834b-0ea2907def05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186717491} :answer-field/id #uuid "34a48b03-ed51-5446-a1ef-25d59a473f4e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717494} {:answer-field/choices [{:answer/id #uuid "9b822726-da80-5d23-8e6b-1b5a957534d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186717507}] :answer-field/correct {:answer/id #uuid "9b822726-da80-5d23-8e6b-1b5a957534d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186717507} :answer-field/id #uuid "d4714672-a915-54be-9dbf-96a255f0d855" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717514} {:answer-field/choices [{:answer/id #uuid "4c58f13a-10e5-5107-b4d4-ed1db55cb014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186717496}] :answer-field/correct {:answer/id #uuid "4c58f13a-10e5-5107-b4d4-ed1db55cb014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186717496} :answer-field/id #uuid "d646d175-1236-5216-92e2-0712696f7619" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717516}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d9d4351a-47f8-548b-9f66-bfc9fe039836" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}2 & -3\\end{bmatrix},\\quad B=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},\\quad C=\\begin{bmatrix}-2 & 1 & 3\\end{bmatrix}.\n$$\n\nEnter the entries of $ABC$ in the table.\n\n| |Column 1|Column 2|Column 3|\n|---|---|---|---|\n|Row 1|{{field-1}}|{{field-2}}|{{field-3}}|\n" :question/worked-solution "The associative law lets us change the parentheses while keeping the factors in order:\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nHere $AB$ is $1\\times1$, whereas $BC$ is $2\\times3$. Computing $AB$ first gives one entry instead of six. We obtain\n\n$$\nAB=\\begin{bmatrix}2 & -3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}=\\begin{bmatrix}2\\cdot1+(-3)\\cdot2\\end{bmatrix}=\\begin{bmatrix}-4\\end{bmatrix}.\n$$\n\nThen\n\n$$\nABC=(AB)C=\\begin{bmatrix}-4\\end{bmatrix}\\begin{bmatrix}-2 & 1 & 3\\end{bmatrix}=\\begin{bmatrix}8 & -4 & -12\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7106c1e4-8d04-5f6c-a405-2de143a15b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717589} {:answer/id #uuid "9203803e-065a-5b75-bfe7-93f49747c193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717596}] :answer-field/correct {:answer/id #uuid "9203803e-065a-5b75-bfe7-93f49747c193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717596} :answer-field/id #uuid "89ce90cd-f561-5d55-af33-452e439f4ca2" :answer-field/key "$AI_2=A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717595} {:answer-field/choices [{:answer/id #uuid "b8f73c65-a7d4-5ebe-a0eb-b10f1326a354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717602} {:answer/id #uuid "d92c11e8-e597-56f0-b6b8-eeb8673285d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717612}] :answer-field/correct {:answer/id #uuid "b8f73c65-a7d4-5ebe-a0eb-b10f1326a354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717602} :answer-field/id #uuid "b4b838a6-e6be-5576-a374-82a287d3e5d6" :answer-field/key "$(AB)C=A(BC)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717601} {:answer-field/choices [{:answer/id #uuid "19ef1e14-61d5-559e-a4bf-8cf463667d99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717584} {:answer/id #uuid "5612b755-4449-5e31-9256-e572b6365a1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717588}] :answer-field/correct {:answer/id #uuid "19ef1e14-61d5-559e-a4bf-8cf463667d99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717584} :answer-field/id #uuid "c1f7e875-5670-57fc-9f8a-8609475d0156" :answer-field/key "$AB=BA$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2199c6f3-6278-50c2-b04a-7b10b34704c8" :question/problem "Let $A$, $B$, and $C$ be $2\\times 2$ real matrices, and let $I_2$ be the identity matrix.\n\nRemember: regrouping a product changes its parentheses without changing the order of its factors.\n\nWhich statements are always true? Select all that apply." :question/worked-solution "- $AI_2=A$ is always true: multiplying by the identity leaves a matrix unchanged.\n\n- $AB=BA$ is not always true: matrix multiplication need not be commutative. For example, take\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\qquad B=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nThen $AB=B$ but $BA=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$, so $AB\\ne BA$ for these matrices.\n\n- $(AB)C=A(BC)$ is always true by associativity. Both sides multiply the factors in the order $A$, then $B$, then $C$; only the parentheses move.\n\nSelect $AI_2=A$ and $(AB)C=A(BC)$."}] [{:db/id #edb/ref 17592186717587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733b808c-675b-5e2b-a3ee-24da5e9a58cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717590} {:answer/id #uuid "aa609def-1cc1-596c-8648-ba88856b2480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717599}] :answer-field/correct {:answer/id #uuid "733b808c-675b-5e2b-a3ee-24da5e9a58cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717590} :answer-field/id #uuid "7fa2b485-160c-5621-8b1a-29ddff1bd68b" :answer-field/key "$A^2B=A(AB)$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717592} {:answer-field/choices [{:answer/id #uuid "1de34152-0b49-52f2-bf06-e7c9dfd81d3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717585} {:answer/id #uuid "d4eb6431-1d6c-5a02-899d-3a9a402ad711" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717611}] :answer-field/correct {:answer/id #uuid "d4eb6431-1d6c-5a02-899d-3a9a402ad711" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717611} :answer-field/id #uuid "ad9b44ca-f248-5259-81ad-956a48a82eca" :answer-field/key "$B(CA)=(CB)A$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717600} {:answer-field/choices [{:answer/id #uuid "c8c819f3-9290-523e-9e26-ac11710b81e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717607} {:answer/id #uuid "d42b4613-6fde-5c38-a730-aedc8f0bf667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717610}] :answer-field/correct {:answer/id #uuid "d42b4613-6fde-5c38-a730-aedc8f0bf667" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717610} :answer-field/id #uuid "bf040830-8fe5-5862-bd99-dfc249348c18" :answer-field/key "$A(B+C)=AC+AB$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717603}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3df55019-db64-5397-8b0d-ef7ef56fd417" :question/problem "Let $A$, $B$, and $C$ be $2\\times 2$ real matrices.\n\nWhich statements are always true? Select all that apply." :question/worked-solution "- $B(CA)=(CB)A$ is not always true. Associativity gives $B(CA)=(BC)A$, keeping the order $B,C,A$. The proposed right side has order $C,B,A$, so it swaps factors. For example, take\n\n$$\nA=I_2,\\qquad B=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\qquad C=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nThen $B(CA)=C$, whereas $(CB)A=0$.\n\n- $A(B+C)=AC+AB$ is always true. First distribute, preserving the order within each product; then interchange the two terms of the sum:\n\n$$\nA(B+C)=AB+AC=AC+AB.\n$$\n\nMatrix addition is commutative even though matrix multiplication is not commutative in general. No factors inside $AB$ or $AC$ have been swapped.\n\n- $A^2B=A(AB)$ is always true. Expand the square as a repeated product and use associativity:\n\n$$\nA^2B=(AA)B=A(AB).\n$$\n\nBoth products have the order $A,A,B$.\n\nSelect $A(B+C)=AC+AB$ and $A^2B=A(AB)$."}] [{:db/id #edb/ref 17592186717597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a360e66-51b6-5924-ab8a-c45c14e044d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717591} {:answer/id #uuid "809d2d65-91dc-5190-aca9-078dc70ee055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717593}] :answer-field/correct {:answer/id #uuid "7a360e66-51b6-5924-ab8a-c45c14e044d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717591} :answer-field/id #uuid "83f29cc6-46b0-51f5-b792-7f05733d6b23" :answer-field/key "$A(B-C)=AB-AC$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717594} {:answer-field/choices [{:answer/id #uuid "c0a67fd5-ebdf-5277-a419-a940e2192c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717604} {:answer/id #uuid "f6286755-e29a-569d-b29b-52a67d61809d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717613}] :answer-field/correct {:answer/id #uuid "c0a67fd5-ebdf-5277-a419-a940e2192c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717604} :answer-field/id #uuid "cce4c5c9-9d8d-53e8-b05e-f8d6f8f0c1d8" :answer-field/key "$(A+B)C=CA+CB$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717608} {:answer-field/choices [{:answer/id #uuid "a9e4370c-d857-5781-9d2e-bfad3656fd8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717598} {:answer/id #uuid "c1578945-d02d-5d97-b56d-db2110fb4172" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186717605}] :answer-field/correct {:answer/id #uuid "a9e4370c-d857-5781-9d2e-bfad3656fd8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186717598} :answer-field/id #uuid "ce0d831d-d8af-525c-88eb-0b79fd3dba7a" :answer-field/key "$A(B+I_2)=AB$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186717609}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "985afdc3-6dd2-5ae5-afc3-822f672a03b9" :question/problem "Let $A$, $B$, and $C$ be $2\\times 2$ real matrices, and let $I_2$ be the identity matrix.\n\nWhich statements are always true? Select all that apply." :question/worked-solution "- $A(B+I_2)=AB$ is not always true. Distribution gives\n\n$$\nA(B+I_2)=AB+AI_2=AB+A.\n$$\n\nThe extra $A$ cannot generally be dropped. For example, $A=I_2$ and $B=0$ give $I_2$ on the left and $0$ on the right.\n\n- $(A+B)C=CA+CB$ is not always true. The correct right distribution is\n\n$$\n(A+B)C=AC+BC.\n$$\n\nThe factor $C$ must stay on the right of each term. For a counterexample, take\n\n$$\nA=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\qquad B=\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix},\\qquad C=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\nThen $(A+B)C=C$, whereas $CA+CB=0$.\n\n- $A(B-C)=AB-AC$ is always true by the distributive law. The left factor $A$ stays on the left in both products, and subtraction is preserved.\n\nSelect only $A(B-C)=AB-AC$."}] [{:db/id #edb/ref 17592186717716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8be4f047-5657-5da8-8e29-6b0be634ef22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186717731}] :answer-field/correct {:answer/id #uuid "8be4f047-5657-5da8-8e29-6b0be634ef22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186717731} :answer-field/id #uuid "52b90642-cc41-52e0-9665-aac430198080" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717727} {:answer-field/choices [{:answer/id #uuid "fbd13ef5-906d-5fd8-a0a2-a9d6753354b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717750}] :answer-field/correct {:answer/id #uuid "fbd13ef5-906d-5fd8-a0a2-a9d6753354b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717750} :answer-field/id #uuid "975b0ab2-086c-5ecc-8a56-006de5111d87" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717733} {:answer-field/choices [{:answer/id #uuid "a039df5e-fc19-593b-a5be-f78d1cf80ff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186717736}] :answer-field/correct {:answer/id #uuid "a039df5e-fc19-593b-a5be-f78d1cf80ff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186717736} :answer-field/id #uuid "9e5e81ae-6502-541a-8be8-f47da9088e32" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717735}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0241b95f-2b75-5cc3-97c9-9862fe4bf540" :question/problem "Calculate $BC-BA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}4 & 1 & -2 \\\\ -1 & 1 & 3 \\\\ 4 & -4 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}- \\sqrt{5} & 1 & -1 \\\\ -2 & - \\sqrt{5} & 1 \\\\ 3 & \\sqrt{3} & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 1 & -2 \\\\ -1 & -2 & 3 \\\\ 4 & -4 & 0\\end{bmatrix}$</div>\n</div>\n\nFill in the input cells. An asterisk $\\ast$ marks an entry that is not requested.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BC-BA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-3}}</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>$\\ast$</td></tr>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $B$ on the left and preserve the order of the subtraction:\n\n$$\nBC-BA=B(C-A).\n$$\n\nCombine corresponding entries first:\n\n$$\nC-A=\\begin{bmatrix}-3 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}.\n$$\n\nThe combined matrix is $-3I_3$. Multiply every entry of $B$ by $-3$.\n\n$$\nBC-BA=\\begin{bmatrix}3 \\sqrt{5} & -3 & 3 \\\\ 6 & 3 \\sqrt{5} & -3 \\\\ -9 & - 3 \\sqrt{3} & -3\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce25edb8-5945-52f8-b052-c4b64ad158f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186717743}] :answer-field/correct {:answer/id #uuid "ce25edb8-5945-52f8-b052-c4b64ad158f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186717743} :answer-field/id #uuid "5576cfea-a5c2-59ee-b9b4-9cd27de13e9e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717728} {:answer-field/choices [{:answer/id #uuid "a511cacb-e96c-5985-aac5-68bf61969dfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717737}] :answer-field/correct {:answer/id #uuid "a511cacb-e96c-5985-aac5-68bf61969dfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717737} :answer-field/id #uuid "94665fc1-acb7-5ec4-a5fe-ce28158f5533" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717732} {:answer-field/choices [{:answer/id #uuid "c7549fb8-f8a0-56f0-bd46-b6b788aab2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717741}] :answer-field/correct {:answer/id #uuid "c7549fb8-f8a0-56f0-bd46-b6b788aab2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717741} :answer-field/id #uuid "f4c2d967-12d0-5846-a5b4-c5207c845253" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717749}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "27e48bbd-ab13-5e82-87ed-cecbb766b597" :question/problem "Calculate $BA+CA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & 0\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & -3 & -1 \\\\ 1 & -1 & -3 \\\\ 3 & 0 & 4\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}-1 & 5 & 1 - \\sqrt{3} \\\\ 2 & 2 & \\sqrt{3} + 3 \\\\ -1 & \\sqrt{2} & -3\\end{bmatrix}$</div>\n</div>\n\nFill in the input cells. An asterisk $\\ast$ marks an entry that is not requested.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BA+CA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>$\\ast$</td></tr>\n<tr><td>{{field-3}}</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $A$ on the right and preserve the order of the addition:\n\n$$\nBA+CA=(B+C)A.\n$$\n\nCombine corresponding entries first:\n\n$$\nB+C=\\begin{bmatrix}1 & 2 & - \\sqrt{3} \\\\ 3 & 1 & \\sqrt{3} \\\\ 2 & \\sqrt{2} & 1\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $(B+C)A$.\n\n$$\n\\begin{aligned}(BA+CA)_{21}&=0=0 \\\\ (BA+CA)_{22}&=(\\sqrt{3})(1)=\\sqrt{3} \\\\ (BA+CA)_{31}&=0=0\\end{aligned}\n$$\n\n\n\n$$\nBA+CA=\\begin{bmatrix}0 & - \\sqrt{3} & 0 \\\\ 0 & \\sqrt{3} & 0 \\\\ 0 & 1 & 0\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3769c9a2-a670-50fb-bc13-bdbcf121366d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717724}] :answer-field/correct {:answer/id #uuid "3769c9a2-a670-50fb-bc13-bdbcf121366d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717724} :answer-field/id #uuid "bc94e482-b634-5076-a6e1-9d7cf4c1808e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717740} {:answer-field/choices [{:answer/id #uuid "16399de5-7f6b-5b7b-a94b-346bd660dba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\sqrt{5}" :db/id #edb/ref 17592186717718}] :answer-field/correct {:answer/id #uuid "16399de5-7f6b-5b7b-a94b-346bd660dba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\sqrt{5}" :db/id #edb/ref 17592186717718} :answer-field/id #uuid "cd2e1ec6-ec51-56b1-8ddb-9041262ae781" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717742} {:answer-field/choices [{:answer/id #uuid "98a828ee-1535-5b78-9b50-523bc829a9b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717734}] :answer-field/correct {:answer/id #uuid "98a828ee-1535-5b78-9b50-523bc829a9b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717734} :answer-field/id #uuid "d1720720-ef80-539c-9d2a-2b91fa98e7e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717744}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2aa790e7-9ea7-50de-8796-f47876af9ff4" :question/problem "Calculate $BC-BA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 1 & 1 \\\\ -4 & -1 & -3 \\\\ 0 & -3 & -3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & -2 & - \\sqrt{5} \\\\ \\sqrt{3} & -3 & -3 \\\\ 1 & \\sqrt{5} & 2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 1 & 1 \\\\ -4 & -1 & -3 \\\\ 0 & -1 & -3\\end{bmatrix}$</div>\n</div>\n\nFill in the input cells. An asterisk $\\ast$ marks an entry that is not requested.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BC-BA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>$\\ast$</td></tr>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>{{field-3}}</td></tr>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $B$ on the left and preserve the order of the subtraction:\n\n$$\nBC-BA=B(C-A).\n$$\n\nCombine corresponding entries first:\n\n$$\nC-A=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 2 & 0\\end{bmatrix}.\n$$\n\nUse row-by-column multiplication on the shorter product $B(C-A)$.\n\n$$\n\\begin{aligned}(BC-BA)_{11}&=0=0 \\\\ (BC-BA)_{12}&=(- \\sqrt{5})(2)=- 2 \\sqrt{5} \\\\ (BC-BA)_{23}&=0=0\\end{aligned}\n$$\n\n\n\n$$\nBC-BA=\\begin{bmatrix}0 & - 2 \\sqrt{5} & 0 \\\\ 0 & -6 & 0 \\\\ 0 & 4 & 0\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42a988f6-93de-58fa-8cdc-e4c2429b423e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\sqrt{2}" :db/id #edb/ref 17592186717725}] :answer-field/correct {:answer/id #uuid "42a988f6-93de-58fa-8cdc-e4c2429b423e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\sqrt{2}" :db/id #edb/ref 17592186717725} :answer-field/id #uuid "4898b25e-c490-5911-93b9-d24db4b4831c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717726} {:answer-field/choices [{:answer/id #uuid "69f7f8e7-9f20-5a26-9f56-654350e247d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717729}] :answer-field/correct {:answer/id #uuid "69f7f8e7-9f20-5a26-9f56-654350e247d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717729} :answer-field/id #uuid "babfacd7-0809-585c-a007-5ff4fedcc212" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717739} {:answer-field/choices [{:answer/id #uuid "1b5e8d8d-2db8-58f4-ac93-bcc299fe2ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186717719}] :answer-field/correct {:answer/id #uuid "1b5e8d8d-2db8-58f4-ac93-bcc299fe2ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186717719} :answer-field/id #uuid "f0731d29-d25f-522b-b2d0-1a4460cf9ecf" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717748}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8434b7d-6059-57f9-b363-a2a8b64d24d7" :question/problem "Calculate $BC+AC$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 4 & -1 \\\\ 3 & -2 & -2 \\\\ -2 & -1 & -5\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-3 & -4 & 1 \\\\ -3 & 0 & 2 \\\\ 2 & 1 & 3\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}-3 & 0 & \\sqrt{2} \\\\ \\sqrt{2} & -2 & 0 \\\\ -3 & - \\sqrt{3} & -2\\end{bmatrix}$</div>\n</div>\n\nFill in the input cells. An asterisk $\\ast$ marks an entry that is not requested.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BC+AC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n<tr><td>{{field-1}}</td><td>{{field-3}}</td><td>$\\ast$</td></tr>\n<tr><td>{{field-2}}</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $C$ on the right and preserve the order of the addition:\n\n$$\nBC+AC=(B+A)C.\n$$\n\nCombine corresponding entries first:\n\n$$\nB+A=\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}.\n$$\n\nThe combined matrix is $-2I_3$. Multiply every entry of $C$ by $-2$.\n\n$$\nBC+AC=\\begin{bmatrix}6 & 0 & - 2 \\sqrt{2} \\\\ - 2 \\sqrt{2} & 4 & 0 \\\\ 6 & 2 \\sqrt{3} & 4\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de335a7a-2926-52b6-8f68-4d169c09705a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717745}] :answer-field/correct {:answer/id #uuid "de335a7a-2926-52b6-8f68-4d169c09705a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717745} :answer-field/id #uuid "077483ba-3fa9-5c1b-b629-f37bbbd17a80" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717717} {:answer-field/choices [{:answer/id #uuid "2a6069d0-8c80-5692-a989-a2badccad92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717721}] :answer-field/correct {:answer/id #uuid "2a6069d0-8c80-5692-a989-a2badccad92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717721} :answer-field/id #uuid "3730e359-dc0b-5cf9-a681-13c4be6fa3ef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717723} {:answer-field/choices [{:answer/id #uuid "6be85b48-9b10-59ef-a6e2-93f0f354ba27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186717730}] :answer-field/correct {:answer/id #uuid "6be85b48-9b10-59ef-a6e2-93f0f354ba27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186717730} :answer-field/id #uuid "ec150429-cdcb-5ebb-9647-cb75e97f188a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717747}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ebc8eff7-097d-53e3-b29c-ca66bfac4dc4" :question/problem "Calculate $BA+CA$, where\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 1 & \\sqrt{2} \\\\ 1 & 3 & - \\sqrt{3} \\\\ -3 & 1 & \\sqrt{5}\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 0 & 2 \\\\ 3 & -2 & 1 \\\\ -3 & 2 & 2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}2 & 0 & -2 \\\\ -3 & 5 & -1 \\\\ 3 & -2 & 1\\end{bmatrix}$</div>\n</div>\n\nFill in the input cells. An asterisk $\\ast$ marks an entry that is not requested.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$BA+CA=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-2}}</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n<tr><td>{{field-1}}</td><td>{{field-3}}</td><td>$\\ast$</td></tr>\n<tr><td>$\\ast$</td><td>$\\ast$</td><td>$\\ast$</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Keep the common factor $A$ on the right and preserve the order of the addition:\n\n$$\nBA+CA=(B+C)A.\n$$\n\nCombine corresponding entries first:\n\n$$\nB+C=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}.\n$$\n\nThe combined matrix is $3I_3$. Multiply every entry of $A$ by $3$.\n\n$$\nBA+CA=\\begin{bmatrix}3 & 3 & 3 \\sqrt{2} \\\\ 3 & 9 & - 3 \\sqrt{3} \\\\ -9 & 3 & 3 \\sqrt{5}\\end{bmatrix}.\n$$\n\n"}] [{:db/id #edb/ref 17592186717755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d09bf999-9091-5b84-af87-c6705a5ee2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717784}] :answer-field/correct {:answer/id #uuid "d09bf999-9091-5b84-af87-c6705a5ee2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717784} :answer-field/id #uuid "7a9afd3e-6897-5b55-b909-f408237f50bb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717767} {:answer-field/choices [{:answer/id #uuid "fddf9145-7b98-5355-9b4d-a2a928a4bf91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717787}] :answer-field/correct {:answer/id #uuid "fddf9145-7b98-5355-9b4d-a2a928a4bf91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717787} :answer-field/id #uuid "7d4d7389-e468-50f9-ad63-765987b554e5" :answer-field/key "field-4" :answer-field/type {:db/id #edb/