b/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186535147}] :answer-field/correct {:answer/id #uuid "23bc995b-802f-5d48-82a2-8a99d9e1af8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186535147} :answer-field/id #uuid "ea03b5a5-5406-5a43-9d8c-3277b23f6208" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535151}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fcaebaeb-11fe-5bba-b85c-4e60e4cc54b3" :question/problem "$$\nX+Y=\\begin{bmatrix}-3 & 0 \\\\ 1 & -1\\end{bmatrix}\\,Z=\\begin{bmatrix}-3 & 0 \\\\ 1 & -2\\end{bmatrix}\n$$\n\nConsider the matrices above. Knowing that the matrix representation $T=\\begin{bmatrix}{t}_{11} & {t}_{12} \\\\ {t}_{21} & {t}_{22}\\end{bmatrix}$ of a linear transformation $T$ is given by\n\n$$\nT=XZ+YZ,\n$$\n\nfind the values ${t}_{ij}.$\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n${t}_{11}=$\n\n\n\n\n\n{{field-1}}                \n\n\n\n\n\n$\\,{t}_{12}=$\n\n\n\n\n\n{{field-2}}                \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n${t}_{21}=$\n\n\n\n\n\n{{field-3}}                \n\n\n\n\n\n$\\,{t}_{22}=$\n\n\n\n\n\n{{field-4}}" :question/retired true :question/worked-solution "We apply the distributive law\n\n$$\nXZ+YZ=(X+Y)Z.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T & =XZ+YZ \\\\  & =(X+Y)Z \\\\  & =\\begin{bmatrix}-3 & 0 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}-3 & 0 \\\\ 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 0 \\\\ -4 & 2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186549231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f10f67-df03-50c7-a1bf-5e006341a225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186549232}] :answer-field/correct {:answer/id #uuid "27f10f67-df03-50c7-a1bf-5e006341a225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186549232} :answer-field/id #uuid "7a1b35ca-c7e1-59ae-a856-f56012ef0b81" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549236} {:answer-field/choices [{:answer/id #uuid "7c772d00-f765-5d8f-bc2e-32016f3f2865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549237}] :answer-field/correct {:answer/id #uuid "7c772d00-f765-5d8f-bc2e-32016f3f2865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549237} :answer-field/id #uuid "e48b1de5-1483-57d3-9d6b-7c2d15925062" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549243}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "06d6225d-4b01-5c48-bc90-403dc6edd027" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-6 & 3\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 5 \\\\ 0 & 2\\end{bmatrix},\\,C=\\begin{bmatrix}4 & -4 \\\\ -2 & -2\\end{bmatrix}.\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-6 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 5 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & -24\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-12 & -24\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -4 \\\\ -2 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 96\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186549239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ece529b6-c6ae-5615-90bc-4d54796df05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549244}] :answer-field/correct {:answer/id #uuid "ece529b6-c6ae-5615-90bc-4d54796df05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549244} :answer-field/id #uuid "cd9b3b77-a05b-5a30-b798-0de9e3ac89a6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549241} {:answer-field/choices [{:answer/id #uuid "c8f4cd3d-eb75-5365-9f9a-85d1850ed7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549240}] :answer-field/correct {:answer/id #uuid "c8f4cd3d-eb75-5365-9f9a-85d1850ed7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549240} :answer-field/id #uuid "ce2d2cb8-9afc-5890-a68a-634867abbb6a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549242}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ccaf12f-b22e-5cd6-9d78-52cfd8d406ea" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-6 & -4\\end{bmatrix},\\,B=\\begin{bmatrix}6 & -5 \\\\ -4 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 5 \\\\ -5 & -1\\end{bmatrix}.\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-6 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}6 & -5 \\\\ -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-20 & 10\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 5 \\\\ -5 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-110 & -110\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186549246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c3e2b8e-8c83-5ad9-92ba-e5bf2691d00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549233}] :answer-field/correct {:answer/id #uuid "4c3e2b8e-8c83-5ad9-92ba-e5bf2691d00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549233} :answer-field/id #uuid "4eddf070-87e3-5dd1-9c6c-8c102e5b2871" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549234} {:answer-field/choices [{:answer/id #uuid "6f6ea8b1-6eae-5fef-aee9-bc00462cb7e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186549235}] :answer-field/correct {:answer/id #uuid "6f6ea8b1-6eae-5fef-aee9-bc00462cb7e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186549235} :answer-field/id #uuid "86fc0d6b-ed48-5943-b4fd-deee378fe8ce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549238} {:answer-field/choices [{:answer/id #uuid "f02708cf-b1b9-5464-8710-caa8ec92dce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186549245}] :answer-field/correct {:answer/id #uuid "f02708cf-b1b9-5464-8710-caa8ec92dce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186549245} :answer-field/id #uuid "f8ec97ff-39a5-521f-ac19-40acb2e2b077" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549247}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f78f9635-d6b7-5289-960e-001285f39f9d" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}0 & -3\\end{bmatrix},\\,B=\\begin{bmatrix}4 \\\\ -6\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 0 & 4\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}4 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 4+(-3)\\cdot (-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+18\\end{bmatrix} \\\\  & =\\begin{bmatrix}18\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $(AB)$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)\\,C \\\\  & =\\begin{bmatrix}18\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}54 & 0 & 72\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186604574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd39b83-84f9-519f-9fe6-fcdb026d9475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186604280}] :answer-field/correct {:answer/id #uuid "3cd39b83-84f9-519f-9fe6-fcdb026d9475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186604280} :answer-field/id #uuid "03571e43-2601-52fd-aded-f54703d41a17" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604475} {:answer-field/choices [{:answer/id #uuid "f8d0c442-8a91-5c08-97be-418027c14c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604469}] :answer-field/correct {:answer/id #uuid "f8d0c442-8a91-5c08-97be-418027c14c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604469} :answer-field/id #uuid "5e62364a-6895-5757-aae3-26e5e9efd184" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604510} {:answer-field/choices [{:answer/id #uuid "c32e6191-335c-5764-8fea-bb20da30413c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186604417}] :answer-field/correct {:answer/id #uuid "c32e6191-335c-5764-8fea-bb20da30413c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186604417} :answer-field/id #uuid "9f44d8ce-372a-5283-b574-f9be2a3c6f25" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604526} {:answer-field/choices [{:answer/id #uuid "1b3d9259-bb69-5fec-9d57-f8798c5df470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186604233}] :answer-field/correct {:answer/id #uuid "1b3d9259-bb69-5fec-9d57-f8798c5df470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186604233} :answer-field/id #uuid "f544ba4c-b79c-5afd-a22f-2c96d5ac1df6" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604558}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25db1a97-9ec4-5a92-aa5c-6915402afa8c" :question/math-academy-id "q-319973" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-2 & 1 & 3 \\\\ 5 & 0 & 4\\end{bmatrix},\\,B=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,C=\\begin{bmatrix}3 & -2\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"35px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $2\\times 3$ matrix, $B$ is a $3\\times 1$ matrix, and $C$ is a $1\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-2 & 1 & 3 \\\\ 5 & 0 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 14\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-2 \\\\ 14\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 4 \\\\ 42 & -28\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186604606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a078935-5de5-5d43-9abf-c43ca9b96845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604378}] :answer-field/correct {:answer/id #uuid "9a078935-5de5-5d43-9abf-c43ca9b96845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604378} :answer-field/id #uuid "aee2535c-d9e8-5f8c-aa65-9316ae36c17a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604532} {:answer-field/choices [{:answer/id #uuid "eb6773b9-fef4-55b8-8ee0-a7578486a8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186604453}] :answer-field/correct {:answer/id #uuid "eb6773b9-fef4-55b8-8ee0-a7578486a8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186604453} :answer-field/id #uuid "c64a17b3-e695-5f80-8256-4aa02af1acee" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604537} {:answer-field/choices [{:answer/id #uuid "0ccb7a9a-b3de-5341-8600-290f881682a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186604218}] :answer-field/correct {:answer/id #uuid "0ccb7a9a-b3de-5341-8600-290f881682a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186604218} :answer-field/id #uuid "e6c83ed6-e318-57b9-a8eb-2c2f97cfe48e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604550}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92b6cc93-e7b1-5f9e-b0e7-fe50186edb11" :question/math-academy-id "q-319194" :question/problem "Calculate $AB+AC$, where\n\n$$\nA=\\begin{bmatrix}-2 & 5 & 7 \\\\ 3 & -1 & 4 \\\\ 6 & 0 & -3\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -1 & 0 \\\\ 0 & 3 & 1 \\\\ 4 & -2 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & -2 & -1 \\\\ -4 & 2 & -4\\end{bmatrix}.\n$$\n\n|  |  | {{field-1}} | $5$ | $7$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $AB+AC=\\,\\,$ |  | $3$ | $-1$ | {{field-2}} |  |\n|  |  | $6$ | {{field-3}} | $-3$ |  |" :question/worked-solution "We apply the distributive law \n\n$$\nAB+AC=A(B+C).\n$$\n\nSo, we calculate $B+C$ first:\n\n$$\n\\begin{aligned}B+C & =\\begin{bmatrix}2 & -1 & 0 \\\\ 0 & 3 & 1 \\\\ 4 & -2 & 5\\end{bmatrix}+\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & -2 & -1 \\\\ -4 & 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+AC & =A(B+C) \\\\  & =A{I}_{3} \\\\  & =A \\\\  & =\\begin{bmatrix}-2 & 5 & 7 \\\\ 3 & -1 & 4 \\\\ 6 & 0 & -3\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186604611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1516c745-8e80-5a7b-93ce-85215241503b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186604224}] :answer-field/correct {:answer/id #uuid "1516c745-8e80-5a7b-93ce-85215241503b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186604224} :answer-field/id #uuid "169265c9-3fed-569e-b3a9-fe73999a7f2f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604480} {:answer-field/choices [{:answer/id #uuid "df4b67bb-9c2c-5724-804b-5039bbface28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186604443}] :answer-field/correct {:answer/id #uuid "df4b67bb-9c2c-5724-804b-5039bbface28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186604443} :answer-field/id #uuid "d6d13a5a-4a6e-5634-82ce-6f12b3913a5d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604544} {:answer-field/choices [{:answer/id #uuid "6c3db9c0-68bb-5109-b381-1189a190ea09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186604327}] :answer-field/correct {:answer/id #uuid "6c3db9c0-68bb-5109-b381-1189a190ea09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186604327} :answer-field/id #uuid "d86ba93c-fc77-5120-88fc-5a3576a85bb0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604547}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a86c622a-becf-5716-a4e7-4a3e3cd93246" :question/math-academy-id "q-319850" :question/problem "Calculate $AB+AC$, where\n\n$$\nA=\\begin{bmatrix}2 & -1 & 0 \\\\ 1 & 3 & 2 \\\\ -2 & 1 & 4\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 0 & 2 \\\\ 4 & -1 & 0 \\\\ 3 & 5 & 1\\end{bmatrix},\\,C=\\begin{bmatrix}2 & 0 & -2 \\\\ -4 & 4 & 0 \\\\ -3 & -5 & 2\\end{bmatrix}.\n$$\n\n|  |  | {{field-1}} | $-3$ | $0$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $AB+AC=\\,\\,$ |  | $3$ | $9$ | {{field-2}} |  |\n|  |  | $-6$ | $3$ | {{field-3}} |  |" :question/worked-solution "We apply the distributive law \n\n$$\nAB+AC=A(B+C).\n$$\n\nSo, we calculate $B+C$ first:\n\n$$\n\\begin{aligned}B+C & =\\begin{bmatrix}1 & 0 & 2 \\\\ 4 & -1 & 0 \\\\ 3 & 5 & 1\\end{bmatrix}+\\begin{bmatrix}2 & 0 & -2 \\\\ -4 & 4 & 0 \\\\ -3 & -5 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =3{I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+AC & =A(B+C) \\\\  & =A\\cdot 3{I}_{3} \\\\  & =3A \\\\  & =\\begin{bmatrix}6 & -3 & 0 \\\\ 3 & 9 & 6 \\\\ -6 & 3 & 12\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186607610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297d66ec-172e-5927-8691-b137869d9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186607105}] :answer-field/correct {:answer/id #uuid "297d66ec-172e-5927-8691-b137869d9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186607105} :answer-field/id #uuid "44316051-6405-53c4-9613-38df98ff2e3f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186607457} {:answer-field/choices [{:answer/id #uuid "39fc1705-527d-5d57-b854-5a41fc4a8899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186607124}] :answer-field/correct {:answer/id #uuid "39fc1705-527d-5d57-b854-5a41fc4a8899" :answer/type {:db/id #edb/re