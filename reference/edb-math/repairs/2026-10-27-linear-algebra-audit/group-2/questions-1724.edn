 17592186717908} :answer-field/id #uuid "bda4f1e9-b0e4-5d46-85d1-8c70ffaddd08" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717929} {:answer-field/choices [{:answer/id #uuid "779d9264-88e8-5e58-8532-1fc0e95238c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717913}] :answer-field/correct {:answer/id #uuid "779d9264-88e8-5e58-8532-1fc0e95238c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186717913} :answer-field/id #uuid "e9178a90-d55f-5e40-b25b-41492e447b3f" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717944}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "deec1cdf-8b2f-5024-aac4-a26738238687" :question/problem "Calculate $ABC$, where\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}0 & -3 & 3 \\\\ -2 & 3 & -2 \\\\ 1 & 0 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 2 & -1 \\\\ 2 & 3 & -1 \\\\ -1 & -1 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}-4 & -1 & -1 \\\\ 2 & 1 & 0 \\\\ -2 & 0 & -2\\end{bmatrix}$</div>\n</div>\n\nEnter the entries of the product.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n<tr><td>{{field-4}}</td><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n<tr><td>{{field-7}}</td><td>{{field-8}}</td><td>{{field-9}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "The associative law changes the grouping while preserving factor order:\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nAll three factors are $3\\times3$, so intermediate dimensions do not distinguish the groupings. Computing $BC$ exposes cancellation. For example, the first entry is\n\n$$\n\\begin{aligned}(BC)_{1,1} &=(2)\\cdot(-4)+(2)\\cdot(2)+(-1)\\cdot(-2) \\\\ &=-2\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}BC &=\\begin{bmatrix}2 & 2 & -1 \\\\ 2 & 3 & -1 \\\\ -1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-4 & -1 & -1 \\\\ 2 & 1 & 0 \\\\ -2 & 0 & -2\\end{bmatrix} \\\\ &=\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe diagonal intermediate multiplies the columns of $A$. Now complete the product. For example, the first entry is\n\n$$\n\\begin{aligned}(ABC)_{1,1} &=(0)\\cdot(-2)+(-3)\\cdot(0)+(3)\\cdot(0) \\\\ &=0\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}ABC &=A(BC) \\\\ &=\\begin{bmatrix}0 & -3 & 3 \\\\ -2 & 3 & -2 \\\\ 1 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix} \\\\ &=\\begin{bmatrix}0 & -3 & -3 \\\\ 4 & 3 & 2 \\\\ -2 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\n"}] [{:db/id #edb/ref 17592186717947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c71a5691-1570-5d9b-8629-4df5975f8276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717935}] :answer-field/correct {:answer/id #uuid "c71a5691-1570-5d9b-8629-4df5975f8276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717935} :answer-field/id #uuid "2032fe59-d317-5415-a552-a83059e9f8d2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717887} {:answer-field/choices [{:answer/id #uuid "5dd9d12b-29fd-53dd-a903-07b6912e9f05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186717902}] :answer-field/correct {:answer/id #uuid "5dd9d12b-29fd-53dd-a903-07b6912e9f05" :answer/type 