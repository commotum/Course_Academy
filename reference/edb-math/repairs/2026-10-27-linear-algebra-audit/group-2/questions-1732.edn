& 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}-5 & -25 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -5 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{bmatrix} & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 5 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186247261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f9beaf-0424-5aa2-956d-c07c9eb62b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461677} {:answer/id #uuid "66a00ca0-0b71-5677-9842-8f027893c915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461678}] :answer-field/correct {:answer/id #uuid "37f9beaf-0424-5aa2-956d-c07c9eb62b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461677} :answer-field/id #uuid "017cb54c-3b6b-50b1-95d4-f81dad5ee6be" :answer-field/key "$A=\\begin{bmatrix}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462592} {:answer-field/choices [{:answer/id #uuid "2d8c85ad-fd15-5dd4-9e14-bfd98d611ea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 1759218646167