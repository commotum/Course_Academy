6 & 1 & 2 & 0 & 1\\end{array}\\right] & {R}_{3} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 0 & 1 & 2 & -2 & 1\\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $N$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $N$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[N\\,|\\,I] & =\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ -2 & 6 & 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ 0 & 6 & 1 & 2 & 0 & 1\\end{array}\\right] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 6 & 1 & 2 & 0 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 0 & 1 & 2 & -2 & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{3}:={R}_{3}+2{R}_{1},\\,{R}_{3}:={R}_{3}+(-6){R}_{2}.\n$$\n\nThe matrix ${N}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{N}^{-1}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{1}{3} & 0 \\\\ 2 & -2 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186403940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7d1e99c-ece0-5199-9719-2e3edf3972bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:=2{R}_{3}$\n$\\,\\text{and}\\,$\n${R}_{1}:={R}_{1}+(-1){R}_{3}$" :db/id #edb/ref 17592186403942} {:answer/id #uuid "3d3adace-7a25-553e-8e95-b8ac0d5307bc" :answer/type {:db/id #edb/ref 1759218604