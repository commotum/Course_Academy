& 1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 & \\frac{1}{4} & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{4} & 2 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{array}\\right]\\end{aligned}\n$$\n\n \n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{1}{4} & 2 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186348109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c45ee0d5-9308-555e-8655-27b49940846a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468220} {:answer/id #uuid "01fd75aa-adb0-55a4-a4a6-505837749218" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468221}] :answer-field/correct {:answer/id #uuid "c45ee0d5-9308-555e-8655-27b49940846a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468220} :answer-field/id #uuid "d8821c63-a7c5-5ece-9e8b-2cf346755fea" :answer-field/key "$A=\\begin{bmatrix}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468831} {:answer-field/choices [{:answer/id #uuid "79c8137b-cfe0-5491-acb8-08e31e6b36a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468222} {:answer/id #uuid "54d834f8-d01e-5030-b6db-31e199e73c16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468223}] :answer-field/correct {:answer/id #uuid "54d834f8-d01e-5030-b6db-31e199e73c16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468223} :answer-field/id #uuid "5df3bbee-6432-59a0-a00f-c0b239fb51db" :answer-field/key "$B=\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468832} {:answer-field/choices [{:answer/id #uuid "44748425-a40a-50f9-9a5f-8d6b21698bf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468224} {:answer/id #uuid "3e68b5b1-8455-51e8-87d7-ba9e6d6c1d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468225}] :answer-field/correct {:answer/id #uuid "44748425-a40a-50f9-9a5f-8d6b21698bf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468224} :answer-field/id #uuid "ac5f0085-a29d-5b62-b75a-4b1190f65885" :answer-field/key "$C=\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad44d2b4-38e0-5faa-8080-32a8feda902f" :question/math-academy-id "q-78772" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{2}:={R}_{2}+{R}_{1}\\,$ and $\\,{R}_{3}:={R}_{3}+(-1){R}_{2}?$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 2 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 1 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -2 & -3 & 1\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186348111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1721f0aa-145f-55ca-afdf-dad93f7502f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+4{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=3{R}_{2}$" :db/id #edb/ref 17592186345556} {:answer/id #uuid "2a384bd1-f185-5fa0-9b8b-43bdb2230522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+5{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=\\frac{1}{3}{R}_{2}$" :db/id #edb/ref 17592186345728} {:answer/id #uuid "790967fc-cb6b-55ad-973b-42d10462f59e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+5{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=2{R}_{1}$" :db/id #edb/ref 17592186346411} {:answer/id #uuid "bf3f3e1c-e580-58e2-9173-38cbe5e04fbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{2}+(-5){R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=\\frac{1}{3}{R}_{3}$" :db/id #edb/ref 17592186347004} {:answer/id #uuid "dd873e45-8378-501e-b244-479c359eb4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+4{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=\\frac{1}{5}{R}_{2}$" :db/id #edb/ref 17592186347299}] :answer-field/correct {:answer/id #uuid "2a384bd1-f185-5fa0-9b8b-43bdb2230522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{3}:={R}_{3}+5{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:=\\frac{1}{3}{R}_{2}$" :db/id #edb/ref 17592186345728} :answer-field/id #uuid "542d8b6a-d795-511e-9bd4-1953076e68b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347756}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fe9d70d4-844d-5fa8-a656-d346eee97593" :question/math-academy-id "q-78797" :question/problem "The inverse of the matrix $F$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[F\\,|\\,I] & =\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ -5 & 2 & 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{3} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ 0 & 2 & 1 & 5 & 0 & 1\\end{array}\\right] & {R}_{2} & :=\\underline{\\phantom{xxxxxx}} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 2 & 1 & 5 & 0 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 0 & 1 & 5 & -\\frac{2}{3} & 1\\end{array}\\right]\\end{aligned}\n$$" :question/worked-solution "We write down $F$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $F$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[F\\,|\\,I] & =\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ -5 & 2 & 1 & 0 & 0 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 3 & 0 & 0 & 1 & 0 \\\\ 0 & 2 & 1 & 5 & 0 & 1\\end{array}\\right] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 2 & 1 & 5 & 0 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|ccc}1 & 0 & 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 0 & 1 & 5 & -\\frac{2}{3} & 1\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{3}:={R}_{3}+5{R}_{1},\\,{R}_{2}:=\\frac{1}{3}{R}_{2}.\n$$\n\nThe matrix ${F}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{F}^{-1}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{1}{3} & 0 \\\\ 5 & -\\frac{2}{3} & 1\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186348112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057914f8-8b34-52fc-a795-ac756cc4f9df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:=\\frac{1}{2}{R}_{2}$\n$\\,\\text{and}\\,$\n${R}_{2}:={R}_{3}+(-4){R}_{2}$" :db/id #edb/ref 17592186345401} {:answer/id #uuid "2e1ef2e2-8c1e-5b2b-832d-918e2e41286e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:=\\frac{1}{2}{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:={R}_{2}+(-3){R}_{1}$" :db/id #edb/ref 17592186345760} {:answer/id #uuid "690ccfa1-e413-51d1-9cfb-d65c0687e844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${R}_{1}:=3{R}_{1}$\n$\\,\\text{and}\\,$\n${R}_{2}:={R}_{2}+4{R}_{1}$" :db/id #edb/ref 17592186346262} {:answer/id #uuid "c8103d40-cd4c-565f-9cdc-e94773fd3f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type