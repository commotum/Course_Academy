5d37810d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186408052} {:answer/id #uuid "adb0e76d-9986-5b8e-a736-d4821798cae1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 6 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186408058} {:answer/id #uuid "efb8a5b6-21b1-5345-9b9e-e436922d4029" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186408063} {:answer/id #uuid "feae4636-ed31-53a4-b5a1-dfde035b20cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6 \\\\ 28\\end{bmatrix}" :db/id #edb/ref 17592186408064}] :answer-field/correct {:answer/id #uuid "feae4636-ed31-53a4-b5a1-dfde035b20cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-14 \\\\ 6 \\\\ 28\\end{bmatrix}" :db/id #edb/ref 17592186408064} :answer-field/id #uuid "9eb9eed7-da79-5b44-8508-0e1881d8523f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408066}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "38a55885-c791-5e66-b4d4-e155d750a7c6" :question/math-academy-id "q-130322" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 & 1 \\\\ 1 & 0 \\\\ 2 & 4\\end{bmatrix},\\,B=\\begin{bmatrix}4 & -2 & -1 \\\\ 1 & -3 & -2\\end{bmatrix},\\,C=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}4 & -2 & -1 \\\\ 1 & -3 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-3 & 1 \\\\ 1 & 0 \\\\ 2 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-14 \\\\ 6 \\\\ 28\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c8bceae-a8f8-59df-9913-53898f44b673" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186485052}] :answer-field/correct {:answer/id #uuid "6c8bceae-a8f8-59df-9913-53898f44b673" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186485052} :answer-field/id #uuid "16cf85a0-d4e0-503b-a40c-377068739a10" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485376} {:answer-field/choices [{:answer/id #uuid "df658338-ffbc-54a4-8fc3-4233fa4b9c9a" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485286}] :answer-field/correct {:answer/id #uuid "df658338-ffbc-54a4-8fc3-4233fa4b9c9a" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186485286} :answer-field/id #uuid "91a5a09a-06e9-5e46-b927-635849a5367f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485429} {:answer-field/choices [{:answer/id #uuid "f3e847ec-d131-5985-94dc-25f91ed6df64" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186485336}] :answer-field/correct {:answer/id #uuid "f3e847ec-d131-5985-94dc-25f91ed6df64" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186485336} :answer-field/id #uuid "fc2e3df9-3029-583e-b5fd-63d9b4b790dc" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485478}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c4c5958e-629a-595b-ba26-53d736ebe0b2" :question/math-academy-id "q-320017" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}3 & -2 \\\\ -1 & 5 \\\\ 4 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}-2 & 1 & 0 \\\\ 3 & -3 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore,\n\n- multiplying $A$ by $B$ gives a $3\\times 3$ matrix, which would require finding $9$ entries, while\n\n- multiplying $B$ by $C$ gives a $2\\times 1$ matrix, which requires finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}-2 & 1 & 0 \\\\ 3 & -3 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}3 & -2 \\\\ -1 & 5 \\\\ 4 & 1\\end{bmatrix}\\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 \\\\ -15 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f10f67-df03-50c7-a1bf-5e006341a225" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186549232}] :answer-field/correct {:answer/id #uuid "27f10f67-df03-50c7-a1bf-5e006341a225" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186549232} :answer-field/id #uuid "7a1b35ca-c7e1-59ae-a856-f56012ef0b81" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549236} {:answer-field/choices [{:answer/id #uuid "7c772d00-f765-5d8f-bc2e-32016f3f2865" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549237}] :answer-field/correct {:answer/id #uuid "7c772d00-f765-5d8f-bc2e-32016f3f2865" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549237} :answer-field/id #uuid "e48b1de5-1483-57d3-9d6b-7c2d15925062" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549243}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "06d6225d-4b01-5c48-bc90-403dc6edd027" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-6 & 3\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 5 \\\\ 0 & 2\\end{bmatrix},\\,C=\\begin{bmatrix}4 & -4 \\\\ -2 & -2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-6 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 5 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & -24\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-12 & -24\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -4 \\\\ -2 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 96\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ece529b6-c6ae-5615-90bc-4d54796df05b" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549244}] :answer-field/correct {:answer/id #uuid "ece529b6-c6ae-5615-90bc-4d54796df05b" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549244} :answer-field/id #uuid "cd9b3b77-a05b-5a30-b798-0de9e3ac89a6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549241} {:answer-field/choices [{:answer/id #uuid "c8f4cd3d-eb75-5365-9f9a-85d1850ed7ef" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549240}] :answer-field/correct {:answer/id #uuid "c8f4cd3d-eb75-5365-9f9a-85d1850ed7ef" :answer/type {:db/ident :answer.type/math} :answer/value "-110" :db/id #edb/ref 17592186549240} :answer-field/id #uuid "ce2d2cb8-9afc-5890-a68a-634867abbb6a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549242}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8ccaf12f-b22e-5cd6-9d78-52cfd8d406ea" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-6 & -4\\end{bmatrix},\\,B=\\begin{bmatrix}6 & -5 \\\\ -4 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 5 \\\\ -5 & -1\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-6 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}6 & -5 \\\\ -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}-20 & 10\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 5 \\\\ -5 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-110 & -110\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c3e2b8e-8c83-5ad9-92ba-e5bf2691d00f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549233}] :answer-field/correct {:answer/id #uuid "4c3e2b8e-8c83-5ad9-92ba-e5bf2691d00f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186549233} :answer-field/id #uuid "4eddf070-87e3-5dd1-9c6c-8c102e5b2871" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549234} {:answer-field/choices [{:answer/id #uuid "6f6ea8b1-6eae-5fef-aee9-bc00462cb7e6" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186549235}] :answer-field/correct {:answer/id #uuid "6f6ea8b1-6eae-5fef-aee9-bc00462cb7e6" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186549235} :answer-field/id #uuid "86fc0d6b-ed48-5943-b4fd-deee378fe8ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549238} {:answer-field/choices [{:answer/id #uuid "f0270