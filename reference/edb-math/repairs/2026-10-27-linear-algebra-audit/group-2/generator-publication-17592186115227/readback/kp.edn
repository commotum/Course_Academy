begin{bmatrix}18\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}54 & 0 & 72\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186604574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd39b83-84f9-519f-9fe6-fcdb026d9475" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186604280}] :answer-field/correct {:answer/id #uuid "3cd39b83-84f9-519f-9fe6-fcdb026d9475" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186604280} :answer-field/id #uuid "03571e43-2601-52fd-aded-f54703d41a17" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604475} {:answer-field/choices [{:answer/id #uuid "f8d0c442-8a91-5c08-97be-418027c14c2d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604469}] :answer-field/correct {:answer/id #uuid "f8d0c442-8a91-5c08-97be-418027c14c2d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186604469} :answer-field/id #uuid "5e62364a-6895-5757-aae3-26e5e9efd184" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604510} {:answer-field/choices [{:answer/id #uuid "c32e6191-335c-5764-8fea-bb20da30413c" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186604417}] :answer-field/correct {:answer/id #uuid "c32e6191-335c-5764-8fea-bb20da30413c" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186604417} :answer-field/id #uuid "9f44d8ce-372a-5283-b574-f9be2a3c6f25" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186604526} {:answer-field/choices [{:answer/id #uuid "1b3d9259-bb69-5fec-9d57-f8798c5df470" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186604233}] :answer-field/correct {:answer/id #uuid