/ref 17592186717928}] :answer-field/correct {:answer/id #uuid "bbc234af-066f-560e-835d-5a0d5696b90d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186717928} :answer-field/id #uuid "f96e272b-0216-5412-ac1b-725158f71dab" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717949}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c7e0058e-62d5-5ba9-8096-12dcea49fa54" :question/problem "Calculate $ABC$, where\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}3 & 3 & 3 \\\\ 2 & 2 & 0 \\\\ 0 & -3 & 3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & 2 & -1 \\\\ 2 & 2 & -1 \\\\ -1 & -1 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 1 & 0 \\\\ -1 & -2 & 1 \\\\ 0 & -1 & 2\\end{bmatrix}$</div>\n</div>\n\nEnter the entries of the product.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n<tr><td>{{field-4}}</td><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n<tr><td>{{field-7}}</td><td>{{field-8}}</td><td>{{field-9}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "The associative law changes the grouping while preserving factor order:\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nAll three factors are $3\\times3$, so intermediate dimensions do not distinguish the groupings. Computing $BC$ exposes cancellation. For example, the first entry is\n\n$$\n\\begin{aligned}(BC)_{1,1} &=(3)\\cdot(1)+(2)\\cdot(-1)+(-1)\\cdot(0) \\\\ &=1\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}BC &=\\begin{bmatrix}3 & 2 & -1 \\\\ 2 & 2 & -1 \\\\ -1 & -1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 1 & 0 \\\\ -1 & -2 & 1 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\ &=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nThe diagonal intermediate multiplies the columns of $A$. Now complete the product. For example, the first entry is\n\n$$\n\\begin{aligned}(ABC)_{1,1} &=(3)\\cdot(1)+(3)\\cdot(0)+(3)\\cdot(0) \\\\ &=3\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}ABC &=A(BC) \\\\ &=\\begin{bmatrix}3 & 3 & 3 \\\\ 2 & 2 & 0 \\\\ 0 & -3 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\ &=\\begin{bmatrix}3 & -3 & 3 \\\\ 2 & -2 & 0 \\\\ 0 & 3 & 3\\end{bmatrix}\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186717942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8c74e5d-9168-57fa-ac96-4f168416d337" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186717925}] :answer-field/correct {:answer/id #uuid "a8c74e5d-9168-57fa-ac96-4f168416d337" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186717925} :answer-field/id #uuid "0c31acbf-b363-5848-a323-899fab30d5a9" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717879} {:answer-field/choices [{:answer/id #uuid "4b0e30e3-60c4-5d45-bef9-e9484065a6ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186717897}] :answer-field/correct {:answer/id #uuid "4b0e30e3-60c4-5d45-bef9-e9484065a6ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186717897} :answer-field/id #uuid "35374073-c3ec-50ba-b006-4afaf35615bb" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717892} {:answer-field/choices [{:answer/id #uuid "1756809b-5438-5bc5-907f-fd3b4335cc4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717883}] :answer-field/correct {:answer/id #uuid "1756809b-5438-5bc5-907f-fd3b4335cc4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186717883} :answ