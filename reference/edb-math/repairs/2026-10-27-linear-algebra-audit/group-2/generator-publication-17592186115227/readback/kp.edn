 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 4 \\\\ 42 & -28\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186629270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd39dfca-2e0b-5d0c-99b4-fb6bbddff83d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186629053}] :answer-field/correct {:answer/id #uuid "cd39dfca-2e0b-5d0c-99b4-fb6bbddff83d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186629053} :answer-field/id #uuid "159cdec6-a2f0-5547-8cf7-8a0b345160aa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629141} {:answer-field/choices [{:answer/id #uuid "df157b4e-4bd5-5afe-bfc1-9c8b63d323f4" :answer/type {:db/ident :answer.type/math} :answer/value "-68" :db/id #edb/ref 17592186629083}] :answer-field/correct {:answer/id #uuid "df157b4e-4bd5-5afe-bfc1-9c8b63d323f4" :answer/type {:db/ident :answer.type/math} :answer/value "-68" :db/id #edb/ref 17592186629083} :answer-field/id #uuid "23204e02-a85b-5138-ae6e-4b72698ed92c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629150} {:answer-field/choices [{:answer/id #uuid "25844569-f541-5d94-90cf-57abbfbaa16e" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186628774}] :answer-field/correct {:answer/id #uuid "25844569-f541-5d94-90cf-57abbfbaa16e" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186628774} :answer-field/id #uuid "3bc9200a-6293-532f-8d4a-a84939731b12" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629163}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2477118f-5d40-5b7c-b0ad-0ab680cefec4" :question/math-academy-id "q-320020" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-1 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},\\,C=\\begin{bmatrix}4 & 0 & -2\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-1 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-1)\\cdot 2+5\\cdot (-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-17\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $(AB)$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)\\,C \\\\  & =\\begin{bmatrix}-17\\end{bmatrix}\\cdot \\begin{bmatrix}4 & 0 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-68 & 0 & 34\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186629276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "258f302a-bd8f-584f-a29d-db45c779e0e6" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186628775}] :answer-field/correct {:answer/id #uuid "258f302a-bd8f-584f-a29d-db45c779e0e6" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186628775} :answer-field/id #uuid "2e4e99c5-75ea-5628-bd88-5be4e4eb7eae" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629155} {:answer-field/choices [{:answer/id #uuid "81117680-9f10-5c23-913a-b317c45f1fe2" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186628927}] :answer-field/correct {:answer/id #uuid "81117680-9f10-5c23-913a-b317c45f1fe2" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186628927} :answer-field/id #uuid "fbb99a80-64ea-514f-a9e8-6d1c466aee9d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186629249}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2ea71558-54ec-572a-9d1d-713eb9802e6e" :question/math-academy-id "q-320025" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}2 & -1\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 5 \\\\ -2 & 3\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 2 \\\\ -3 & 4\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}2 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 5 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}2 & 7\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ -3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-19 & 32\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186649824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4313732b-563a-55dc-8ca7-78581cd77a15" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-35 & 25 \\\\ 42 & -18 \\\\ -5 & 21\\end{bmatrix}" :db/id #edb/ref 17592186649380} {:answer/id #uuid "47390465-ab03-59b6-ad5e-9cf8cffc4593" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}28 \\\\ -12 \\\\ 35\\end{bmatrix}" :db/id #edb/ref 17592186649388} {:answer/id #uuid "57c7e7f4-9b6f-578d-a160-643cba921eff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 5 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186649425} {:answer/id #uuid "8ee3d17b-7676-5413-b495-384c53b0bc12" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & -12 \\\\ 35 & -28 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186649524} {:answer/id #uuid "cdf21d84-a23e-5c34-9fca-ebad21063f40" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 35 \\\\ 28 & -12 \\\\ -15 & 4\\end{bmatrix}" :db/id #edb/ref 17592186649632}] :answer-field/correct {:answer/id #uuid "8ee3d17b-7676-5413-b495-384c53b0bc12" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & -12 \\\\ 35 & -28 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186649524} :answer-field/id #uuid "6f51278f-ee43-5032-a5a8-e7f0378d75e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186649754}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "31687a2b-cc68-5ba3-a320-59a64870dd5f" :question/math-academy-id "q-42003" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & -1 & 0 \\\\ 2 & 0 & 1 \\\\ 4 & 5 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix},\\,C=\\begin{bmatrix}5 & -4\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 3$ matrix, $B$ is a $3\\times 1$ matrix, and $C$ is a $1\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & -1 & 0 \\\\ 2 & 0 & 1 \\\\ 4 & 5 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -2 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 7 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}3 \\\\ 7 \\\\ -1\\end{bmatrix}\\cdot \\begin{bmatrix}5 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 & -12 \\\\ 35 & -28 \\\\ -5 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186649832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afa897e3-bec4-5f88-93d5-7db1ac1ca0f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 3 \\\\ -8 & 12 \\\\ 18 & -27\\end{bmatrix}" :db/id #edb/ref 17592186649584} {:answer/id #uuid "afb3c867-7599-5ee2-b2e8-39d64dd1816e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -8 \\\\ 18\\end{bmatrix}" :db/id #edb/ref 17592186649585} {:answer/id #uuid "e1e716c2-b879-5dd2-a6f7-d656cfce4a61" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & -8 & 18\\end{bmatrix}" :db/id #edb/ref 17592186649663} {:answer/id #uuid "eae1bce1-1b37-56cd-872c-571598d1a2e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 6 \\\\ -16 & 24 \\\\ 36 & -54\\end{bmatrix}" :db/id #edb/ref 17592186649679} {:answer/id #uuid "fa5167ed-3b6b-5d91-8525-04f6c3b12108" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ -4 & 8 \\\\ 9 & -9\\end{bmatrix}" :db/id #edb/ref 17592186649704}] :answer-field/correct {:answer/id #uuid "eae1bce1-1b37-56cd-872c-571598d1a2e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 6 \\\\ -16 & 24 \\\\ 36 & -54\\end{bmatrix}" :db/id #edb/ref 17592186649679} :answer-field/id #uuid "7372f355-a8ea-5930-a427-d4650afe8524" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186649756}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3f365320-c37a-5260-b123-1955c90d35a3" :question/math-academy-id "q-130309" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-1 & 0 & 1 \\\\ 2 & 0 & 1 \\\\ 4 & 5 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ -3 \\\\ 2\\end{bmatrix},\\,C=\\begin{bmatrix}-4 & 6\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 3$ matrix, $B$ is a $3\\times 1$ matrix, and $C$ is a $1\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-1 & 0 & 1 \\\\ 2 & 0 & 1 \\\\ 4 & 5 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 4 \\\\ -9\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}1 \\\\ 4 \\\\ -9\\end{bmatrix}\\cdot \\begin{bmatrix}-4 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 6 \\\\ -16 & 24 \\\\ 36 & -54\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186649880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98db1f97-05ad-542a-834e-da8739b3ac75" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186649548}] :answer-field/correct {:answer/id #uuid "98db1f97-05ad-542a-834e-da8739b3ac75" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186649548} :answer-field/id #uuid "11b2c8a7-0e02-5c0b-99c8-104567b9da48" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186649725} {:answer-field/choices [{:answer/id #uuid "bafbf1b8-66aa-567f-98b2-420dd24a5775" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186649603}] :answer-field/correct {:answer/id #uuid "bafbf1b8-66aa-567f-98b2-420dd24a5775" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186649603} :answer-field/id #uuid "29db3a45-608f-5486-aec0-b0a0ae7240a5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186649735} {:answer-field/choices [{:answer/id #uuid "f3d70b6a-4494-57e3-91a0-dd689e1bba4e" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186649693}] :answer-field/correct {:answer/id #uuid "f3d70b6a-4494-57e3-91a0-dd689e1bba4e" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186649693} :answer-field/id #uuid "92eb4cb5-20c3-548a-8db9-09e31c9738ed" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186649770}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ccf609af-63ab-558e-b2d1-560aae618250" :question/math-academy-id "q-320019" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & -4 \\\\ 3 & 2 \\\\ -2 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}2 & 0 & -1 \\\\ -3 & 1 & 4\\end{bmatrix},\\,C=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$ABC=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore,\n\n- multiplying $A$ by $B$ produces a $3\\times 3$ matrix (nine entries to compute), while\n\n- multiplying $B$ by $C$ produces a $2\\times 1$ matrix (two entries to compute).\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}2 & 0 & -1 \\\\ -3 & 1 & 4\\end{bmatrix}\\,\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 1+0\\cdot (-1)+(-1)\\cdot 2 \\\\ (-3)\\cdot 1+1\\cdot (-1)+4\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}1 & -4 \\\\ 3 & 2 \\\\ -2 & 5\\end{bmatrix}\\,\\begin{bmatrix}0 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1\\cdot 0+(-4)\\cdot 4 \\\\ 3\\cdot 0+2\\cdot 4 \\\\ (-2)\\cdot 0+5\\cdot 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-16 \\\\ 8 \\\\ 20\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186717497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "695ee893-2e8d-5508-8a3f-417e7a79dc72" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186717500}] :answer-field/correct {:answer/id #uuid "695ee893-2e8d-5508-8a3f-417e7a79dc72" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186717500} :answer-field/id #uuid "07249a84-8cc4-5146-be2c-a5fcd4b990c4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717487} {:answer-field/choices [{:answer/id #uuid "a012feeb-d45c-5634-ae4a-d8b0359f04ff" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db