1)\\cdot(1)+(-1)\\cdot(2) \\\\ &=-3\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}BC &=\\begin{bmatrix}-1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix} \\\\ &=\\begin{bmatrix}-3\\end{bmatrix}\\end{aligned}\n$$\n\n Now complete the product. For example, the first entry is\n\n$$\n\\begin{aligned}(ABC)_{1,1} &=(1)\\cdot(-3) \\\\ &=-3\\end{aligned}\n$$\n\nThe complete product is\n\n$$\n\\begin{aligned}ABC &=A(BC) \\\\ &=\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}\\cdot \\begin{bmatrix}-3\\end{bmatrix} \\\\ &=\\begin{bmatrix}-3 \\\\ -3 \\\\ -6\\end{bmatrix}\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186717880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dc37729-141f-5666-8a9b-a5ee0817db9a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186717916}] :answer-field/correct {:answer/id #uuid "8dc37729-141f-5666-8a9b-a5ee0817db9a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186717916} :answer-field/id #uuid "1f043c14-a1ce-5718-9298-af13e6ec3e1d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717885} {:answer-field/choices [{:answer/id #uuid "70ea8ec9-a005-5957-91f0-38bf8b7c7c16" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717907}] :answer-field/correct {:answer/id #uuid "70ea8ec9-a005-5957-91f0-38bf8b7c7c16" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186717907} :answer-field/id #uuid "483e2f69-e80e-566b-a28b-5147ab24e5c5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186717896} {:answer-field/choices [{:answer/id #uuid "124cebcd-2b2b-54cd-be99-4633c92ffaf8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186717881}] :answer-field/correct {:answer/id #uuid "124cebcd-2b2b-54cd-be99-4633c92ffaf8" :answer/type 