:question/problem "If $A$ is a $6\\times 11$ matrix that has $8$ **non-pivot** columns, then $\\text{rank}(A)=$" :question/worked-solution "We know that $\\text{rank}(A)$ is the number of pivot columns in $A.$ \n\nSince $A$ has $11$ columns and $8$ of them are non-pivots, then the number of pivot columns in $A$ is \n\n$$\n11-8=3.\n$$\n\nTherefore, $\\text{rank}(A)=3.$"}] [{:db/id #edb/ref 17592186120364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96575d6e-bf49-5dc7-8a78-535b3afb687b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D = \\begin{bmatrix}1 & 1 & 1 & 0 \\\\ 0 & -1 & 0 & 3 \\\\ 0 & 0 & 3 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186118299} {:answer/id #uuid "ddbcd510-8196-5dd5-8040-8e0d74f88a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E = \\begin{bmatrix}1 & 2 & 0 & 0 & 5 \\\\ 0 & 3 & 0 & 5 & 3 \\\\ 0 & 0 & 1 & 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118300} {:answer/id #uuid "e1dc381e-7fc9-51f4-91a7-448730b2123f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A = \\begin{bmatrix}5 & -3 & 2 & 0 \\\\ 0 & 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118301} {:answer/id #uuid "3ddbdba3-aa44-5df7-8946-615c6227e1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B = \\begin{bmatrix}1 & 0 & 2 & 0 & 0 \\\\ 0 & -1 & 3 & 1 & 2 \\\\ 0 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118302} {:answer/id #uuid "51383179-335b-5d6d-8add-d367b6dab0fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C = \\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 2 & 3 \\\\ 0 & 3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186118303}] :answer-field/id #uuid "8b490f9e-f431-571e-9a05-4fef55cab46a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio}