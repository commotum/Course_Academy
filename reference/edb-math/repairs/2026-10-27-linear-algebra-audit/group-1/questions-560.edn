b/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602358} {:answer-field/choices [{:answer/id #uuid "cf8adca1-430a-5345-8b1c-9dd457b34dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186602259}] :answer-field/correct {:answer/id #uuid "cf8adca1-430a-5345-8b1c-9dd457b34dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186602259} :answer-field/id #uuid "9dda086c-e2b4-5412-b9a1-8de9341ce5d6" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602361} {:answer-field/choices [{:answer/id #uuid "2809f8df-7e22-5488-b02d-382854f1a83a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186602094}] :answer-field/correct {:answer/id #uuid "2809f8df-7e22-5488-b02d-382854f1a83a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186602094} :answer-field/id #uuid "f31f942e-b532-5898-af70-f9fab3c827cc" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602390}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "213b2643-d369-585f-a935-32807ac38964" :question/math-academy-id "q-337657" :question/problem "Calculate the product ${I}_{3}D$ given that ${I}_{3}$ is the $3\\times 3$ identity matrix and\n$$\n\\displaystyle D=\\begin{bmatrix}-7 & 2 & 0 \\\\ 1 & -4 & 9 \\\\ 3 & 5 & -2\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">${I}_{3}\\cdot D=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>{{field-3}}</td></tr>\n<tr><td>{{field-4}}</td><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n<tr><td>{{field-7}}</td><td>{{field-8}}</td><td>{{field-9}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $D$ is a $3\\times 3$ matrix and ${I}_{3}$ is a $3\\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{3}\\cdot D=D=\\begin{bmatrix}-7 & 2 & 0 \\\\ 1 & -4 & 9 \\\\ 3 & 5 & -2\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186602418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273f1034-7493-5689-80b6-d9d8bb4de711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{11}" :db/id #edb/ref 17592186602091}] :answer-field/correct {:answer/id #uuid "273f1034-7493-5689-80b6-d9d8bb4de711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{11}" :db/id #edb/ref 17592186602091} :answer-field/id #uuid "279dca77-14c0-534d-bd5a-cbc0b1404831" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602320} {:answer-field/choices [{:answer/id #uuid "ef7d4cea-48e5-5126-afec-75abcf59374d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186602287}] :answer-field/correct {:answer/id #uuid "ef7d4cea-48e5-5126-afec-75abcf59374d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186602287} :answer-field/id #uuid "5743b1a3-0dff-56dc-a5c7-6aee70e06c65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602338} {:answer-field/choices [{:answer/id #uuid "f2ef71af-dc19-5280-9652-e6f2b73f7d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186602291}] :answer-field/correct {:answer/id #uuid "f2ef71af-dc19-5280-9652-e6f2b73f7d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186602291} :answer-field/id #uuid "baa92b97-cd37-5bd8-89b0-056673466195" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602372} {:answer-field/choices [{:answer/id #uuid "270dcdcf-34c7-59f5-9d85-d644909445b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186602089}] :answer-field/correct {:answer/id #uuid "270dcdcf-34c7-59f5-9d85-d644909445b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{4}" :db/id #edb/ref 17592186602089} :answer-field/id #uuid "d3216cc2-3da0-53b6-a890-400ba45512ec" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602379}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "667b91b1-e507-551a-b225-8b558b92d6a6" :question/math-academy-id "q-337672" :question/problem "Find the product $CD$, if\n$$\n\\displaystyle C=\\begin{bmatrix}0 & 0 & 1 & 0\\end{bmatrix}\n$$\nand \n$$\n\\displaystyle D=\\begin{bmatrix}-4 & \\sqrt{2} & 10 & -\\frac{1}{5} \\\\ \\frac{3}{2} & -7 & \\pi  & 0 \\\\ 6 & -\\sqrt{11} & -\\frac{9}{4} & \\operatorname{ln}⁡(2) \\\\ 12 & -3 & \\sqrt{13} & -e\\end{bmatrix}.\n$$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$CD=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Notice that $C$ is the $3$rd *row* of the identity matrix ${I}_{4}.$\n\nSince we're multiplying the $4\\times 4$ matrix $D$ by the $3$rd *row* of the identity matrix ${I}_{4}$ on the *left*, the result must be the $3$rd *row* of $D.$ Therefore,\n\n$$\nCD=\\begin{bmatrix}6 & -\\sqrt{11} & -\\frac{9}{4} & \\operatorname{ln}⁡(2)\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}CD & =\\begin{bmatrix}0 & 0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}-4 & \\sqrt{2} & 10 & -\\frac{1}{5} \\\\ \\frac{3}{2} & -7 & \\pi  & 0 \\\\ 6 & -\\sqrt{11} & -\\frac{9}{4} & \\operatorname{ln}⁡(2) \\\\ 12 & -3 & \\sqrt{13} & -e\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -\\sqrt{11} & -\\frac{9}{4} & \\operatorname{ln}⁡(2)\\end{bmatrix}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186612414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1794521a-6abc-5660-8e17-0a354e18524d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix},\\begin{bmatrix}9 \\\\ -12\\end{bmatrix}\\}" :db/id #edb/ref 17592186611757} {:answer/id #uuid "41c758b6-85ab-5881-bd4e-0d470eeee9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-6 \\\\ 8\\end{bmatrix}\\}" :db/id #edb/ref 17592186611843} {:answer/id #uuid "9305180f-34da-5356-8e25-1c1e28476623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}9 \\\\ -12\\end{bmatrix},\\begin{bmatrix}-6 \\\\ 8\\end{bmatrix}\\}" :db/id #edb/ref 17592186612005} {:answer/id #uuid "b8f68a1f-0cf6-5e96-823d-0ae1aeeeebcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix},\\begin{bmatrix}9 \\\\ -12\\end{bmatrix},\\begin{bmatrix}-6 \\\\ 8\\end{bmatrix}\\}" :db/id #edb/ref 17592186612087} {:answer/id #uuid "f5a8f66b-20c5-502e-8636-50485d475241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186612231}] :answer-field/correct {:answer/id #uuid "f5a8f66b-20c5-502e-8636-50485d475241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186612231} :answer-field/id #uuid "2a1103b2-f774-5cbb-ad1b-be4bfd9306f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186612273}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "163f4ab1-e459-544e-b3ef-fa78330fc316" :question/math-academy-id "q-75069" :question/problem "Consider the vectors ${a}_{1}=\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix},$ ${a}_{2}=\\begin{bmatrix}9 \\\\ -12\\end{bmatrix},$ and ${a}_{3}=\\begin{bmatrix}-6 \\\\ 8\\end{bmatrix}.$ Find a basis $B$ of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$" :question/worked-solution "We need to find a subset of linearly independent vectors. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-3 & 9 & -6 \\\\ 4 & -12 & 8\\end{bmatrix} & {R}_{1} & :=\\left(-\\frac{1}{3}\\right){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 4 & -12 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st column is a pivot column, while the $2$nd and $3$rd columns are non-pivot columns.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one.\n\nThe $1$st column from the original matrix is ${a}_{1}.$ So, a basis of $S$ is $\\{{a}_{1}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}-3 \\\\ 4\\end{bmatrix}\\}.\n$$"}] [{:db/id #edb/ref 17592186612418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e7f7dbf-eae4-5042-b329-f8d8b7f2696d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is not a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}$" :db/id #edb/ref 17592186611768} {:answer/id #uuid "870c8c77-c551-5605-b456-16d06ec72f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186611983} {:answer/id #uuid "a579281a-2765-5169-a2e7-0c390e24d0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186612051} {:answer/id #uuid "d2982091-8b9d-5258-a024-4e1cbd79bd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186612145} {:answer/id #uuid "da987545-74c4-520f-9aa6-0636f3da4074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186612166}] :answer-field/correct {:answer/id #uuid "870c8c77-c551-5605-b456-16d06ec72f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186611983} :answer-field/id #uuid "152ae697-1299-5759-8624-d48f20d60ad7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186612261}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2530e12d-5c5a-548e-a5d0-95bcd538a3d8" :question/math-academy-id "q-110971" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ ${a}_{3},$ and ${a}_{4}$ are given below. Determine whether $B=\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$ If that is the case, find ${x}_{1}+{x}_{2}+{x}_{3},$ where ${a}_{4}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-2 \\\\ -3 \\\\ 2\\end{bmatrix},\\,{a}_{3}=\\begin{bmatrix}-2 \\\\ -4 \\\\ 3\\end{bmatrix},\\,{a}_{4}=\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix}\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$ So, we want to find ${x}_{1},{x}_{2},{x}_{3}\\in R$ such that \n\n$$\n{x}_{1}\\underbrace{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}}_{{a}_{1}}+{x}_{2}\\underbrace{\\begin{bmatrix}-2 \\\\ -3 \\\\ 2\\end{bmatrix}}_{{a}_{2}}+{x}_{3}\\underbrace{\\begin{bmatrix}-2 \\\\ -4 \\\\ 3\\end{bmatrix}}_{{a}_{3}}=\\underbrace{\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix}}_{{a}_{4}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}-2{x}_{3} &=-2 \\\\ 2{x}_{1}-3{x}_{2}-4{x}_{3} &=-1 \\\\ -{x}_{1}+2{x}_{2}+3{x}_{3} &=1\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\left[\\begin{array}{ccc|c}1 & -2 & -2 & -2 \\\\ 2 & -3 & -4 & -1 \\\\ -1 & 2 & 3 & 1\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ -1 & 2 & 3 & 1\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -1\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 0 & -4 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -1\\end{array}\\right] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that the pivot columns are the $1$st, $2$nd, and $3$rd columns. So,  $B$ is indeed a basis of $\\text{Span}\\{{a}_{1},{a}_{2},{a}_{3},{a}_{4}\\}.$\nAlso, the matrix tells us that ${x}_{1}=2,$ ${x}_{2}=3,$ and ${x}_{3}=-1,$ meaning that\n\n$$\n2\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}}_{{a}_{1}}+3\\cdot \\underbrace{\\begin{bmatrix}-2 \\\\ -3 \\\\ 2\\end{bmatrix}}_{{a}_{2}}+(-1)\\cdot \\underbrace{\\begin{bmatrix}-2 \\\\ -4 \\\\ 3\\end{bmatrix}}_{{a}_{3}}=\\underbrace{\\begin{bmatrix}-2 \\\\ -1 \\\\ 1\\end{bmatrix}}_{{a}_{4}}.\n$$\n\nTherefore, ${x}_{1}+{x}_{2}+{x}_{3}=2+3+(-1)=4.$"}] [{:db/id #edb/ref 17592186612492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75cfba26-767e-5ce5-87ed-77fd30f4a814" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186611947} {:answer/id #uuid "788f558d-0d36-5417-a3ed-82e0a95f6442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186611956} {:answer/id #uuid "a4daf6bd-e111-52ef-b5d2-614147666825" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186612050} {:answer/id #uuid "e09b4ed7-612e-5a30-a27b-a4911ef0673b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186612177} {:answer/id #uuid "f4006333-c526-582e-9145-24db7fd87b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186612227}] :answer-field/correct {:answer/id #uuid "75cfba26-767e-5ce5-87ed-77fd30f4a814" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186611947} :answer-field/id #uuid "e4646079-8bca-57ff-be1b-d1178bbfa81b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186612385}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f844eb54-55ea-5827-8341-7ee314833a14" :question/math-academy-id "q-74978" :question/problem "Consider the vectors ${a}_{1}=\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix},{a}_{2}=\\begin{bmatrix}-2 \\\\ 0 \\\\ 0\\end{bmatrix},$ and ${a}_{3}=\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}.$ Find a basis $B$ of $\\text{span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$" :question/worked-solution "We need to find a subset of linearly independent vectors. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -2 & -3 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $3$rd columns are pivot columns, while the $2$nd column is a non-pivot column.\n\nThe $1$st and $3$rd columns from the original matrix are ${a}_{1}$ and ${a}_{3}.$ So, a basis of $S$ is $\\{{a}_{1},{a}_{3}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 1 \\\\ 0\\end{bmatrix}\\}.\n$$"}] [{:db/id #edb/ref 17592186615374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05511e8f-a9ad-5228-8360-c5a651d2b72b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186614736} {:answer/id #uuid "807ce9cb-83b2-59d4-a467-8f1acb04c3d6" :answer/type {:db/id #edb/ref 