  {
    "id": 17592186134396,
    "source": "q-42532",
    "prompt": "Suppose that the elementary row operation\n$R_{2}:=-\\frac{1}{3}R_{2}$ is applied to a $3 \\cdot 3$ matrix $A$. What is the equivalent notation in terms of matrix multiplication?",
    "solution": null,
    "fields": [
      {
        ":answer-field/choices": [
          {
            ":answer/id": "ae722046-6be9-5e9a-bf56-4206a9c79894",
            ":answer/type": {
              ":db/id": 17592186045498,
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\cdot A",
            ":db/id": 17592186132416
          },
          {
            ":answer/id": "10dc647e-4bc7-5382-9e97-bd8139145536",
            ":answer/type": {
              ":db/id": 17592186045498,
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "A \\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -\\frac{1}{3} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}",
            ":db/id": 17592186132417
          },
          {
            ":answer/id": "24d766ed-85a6-59fa-8b22-a6ac0c017b06",
            ":answer/type": {
              ":db/id": 17592186045498,
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "A \\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{3} & 0 & 1\\end{bmatrix}",
            ":db/id": 17592186132418
          },
          {
            ":answer/id": "27406f2d-9f97-5baa-af72-688260907814",
            ":answer/type": {
              ":db/id": 17592186045498,
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{3} & 1\\end{bmatrix} \\cdot A",
            ":db/id": 17592186132419
          },
          {
            ":answer/id": "591aa2fa-7ddf-5186-a24b-309823941754",
            ":answer/type": {
              ":db/id": 17592186045498,
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{bmatrix} \\cdot A",
            ":db/id": 17592186132420
          }
        ],
        ":answer-field/id": "0b77ad91-bb09-5ec1-ad51-91b9ef6f7291",
        ":answer-field/key": "selection",
        ":answer-field/type": {
          ":db/id": 17592186045493,
          ":db/ident": ":answer-field.type/radio"
        },
        ":db/id": 17592186132415
