b/ref 17592186688376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71f0f728-375a-56bb-9e0d-d6827df2767a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186688368} {:answer/id #uuid "8b1657ce-0efc-5822-8d02-3aeb92d7403e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186688371} {:answer/id #uuid "a09ae09d-164b-5d81-a60c-62a022c39a03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186688373} {:answer/id #uuid "c77ef708-bfec-5967-9779-b50ed9fc1b15" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186688374} {:answer/id #uuid "e5e425d0-79a7-5c25-8ff1-23bf40975d65" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186688377}] :answer-field/correct {:answer/id #uuid "c77ef708-bfec-5967-9779-b50ed9fc1b15" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186688374} :answer-field/id #uuid "530da1d6-029a-52b0-98ff-88515deb48a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186688361}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e19be8df-0162-5666-8be4-94e618981df2" :question/problem "Find $t$, if $2\\mathbf{a}_1-t\\mathbf{a}_2=\\mathbf{b}$ and\n\n$$\n\\mathbf{a}_1=\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix},\\quad \\mathbf{a}_2=\\begin{bmatrix}0 \\\\ -2 \\\\ 4\\end{bmatrix},\\quad \\mathbf{b}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}.\n$$" :question/worked-solution "Isolate the term containing $t$ using vector subtraction:\n\n$$\n\\begin{aligned}2\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}-t\\begin{bmatrix}0 \\\\ -2 \\\\ 4\\end{bmatrix} &=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\ t\\begin{bmatrix}0 \\\\ -2 \\\\ 4\\end{bmatrix} &=2\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}