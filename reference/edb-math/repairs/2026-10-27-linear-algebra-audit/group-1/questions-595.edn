:answer/id #uuid "7908ce59-21b7-5d90-8cad-bdc6d52632ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186673004} :answer-field/id #uuid "154ce2a9-72b3-5a4a-b636-487a13241be2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186672988}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7f29c73-c3e5-58b4-85db-805220fa565a" :question/problem "Find the value of ${x}_{1}+{x}_{4}$ given that $3a-5x=b$ and\n\n$$\na=\\begin{bmatrix}1 \\\\ -2 \\\\ 2 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix},\\,b=\\begin{bmatrix}-37 \\\\ -36 \\\\ 6 \\\\ -23\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}3a-5x & =b \\\\ -5x & =b-3a \\\\ x & =-\\frac{1}{5}(b-3a) \\\\ x & =-\\frac{1}{5}(\\begin{bmatrix}-37 \\\\ -36 \\\\ 6 \\\\ -23\\end{bmatrix}-3\\begin{bmatrix}1 \\\\ -2 \\\\ 2 \\\\ -1\\end{bmatrix}) \\\\ x & =-\\frac{1}{5}\\begin{bmatrix}-40 \\\\ -30 \\\\ 0 \\\\ -20\\end{bmatrix} \\\\ x & =\\begin{bmatrix}8 \\\\ 6 \\\\ 0 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore,${x}_{1}+{x}_{4}=8+4=12.$"}] [{:db/id #edb/ref 17592186673015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018392a3-de7a-5fda-8bf3-da0c036043ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 \\\\ -2 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186672984} {:answer/id #uuid "04c85f3b-ac81-5e08-83aa-cbb568aa8891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186672985} {:answer/id #uuid "4968ee2a-19bb-547a-97b1-4afc060b4ea5" :answer/type {:db/id #edb/ref 17592186045498 :d