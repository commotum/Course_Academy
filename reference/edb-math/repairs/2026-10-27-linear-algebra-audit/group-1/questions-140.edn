${R}_{1}:=(-5){R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :=(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nTherefore, only $B$ and $C$ are elementary matrices."}] [{:db/id #edb/ref 17592186247106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a20caaf5-55ed-50a8-9c16-3db9d13f58f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461623} {:answer/id #uuid "88a54ef8-32b5-5135-87f6-e5f1333a4f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461624}] :answer-field/correct {:answer/id #uuid "88a54ef8-32b5-5135-87f6-e5f1333a4f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461624} :answer-field/id #uuid "54012b06-a154-5d01-a786-1580b0324414" :answer-field/key "$A=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{bmatrix}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462565} {:answer-field/choices [{:answer/id #uuid "96e31214-3d9d-56fa-8a9e-04bc79bd837a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461625} {:answer/id #uuid "ed987963-27f0-581d-9e0a-71c1f56eff2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461626}] :answer-field/correct {:answer/id #uuid "ed987963-27f0-581d-9e0a-71c1f56eff2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461626} :answer-field/id #uuid "d239a3f5-a495-5008-bcae-4c74c9d8e615" :answer-field/key "$B=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 