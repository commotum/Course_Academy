 0 \\\\ 0 & \\frac{1}{4} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & \\frac{1}{4} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 6 & \\frac{1}{4} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186247123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cee5eb8-efa1-5941-8bf9-0e54cab0fa57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=5{R}_{1}" :db/id #edb/ref 17592186245134} {:answer/id #uuid "6ea815cf-9548-527b-8c1d-b0036833ffb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{5}{R}_{1}" :db/id #edb/ref 17592186245295} {:answer/id #uuid "8ee3f9e7-7f35-5a1a-b758-bb28bec552dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{5}{R}_{2}" :db/id #edb/ref 17592186245559} {:answer/id #uuid "ab390cd1-dce0-597d-bf1c-33ede6ec245e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+5{R}_{3}" :db/id #edb/ref 17592186245842} {:answer/id #uuid "dc8b1652-03f3-5e9a-ad5e-5472f6d274d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+5{R}_{2}" :db/id #edb/ref 17592186246274}] :answer-field/correct {:answer/id #uuid "5cee5eb8-efa1-5941-8bf9-0e54cab0fa57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=5{R}_{1}" :db/id #edb/ref 17592186245134} :answer-field/id #uuid "47754a8c-f6ae-5aee-954d-64bb110f0fc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246663}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "677b9d5b-b0c9-541a-ab16-d958e9ccc367" :question/math-academy-id "q-110458" :question/problem "Consider $E=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ and a $3\\times 3$ matrix $A.$ Find the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by multiplying the first row of ${I}_{3}$ by $5:$\n\n$$\n\\begin{aligned}{I}_{3} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :=5{R}_{1} \\\\  & ∼\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{1}:=5{R}_{1}$ to $A.$"}] [{:db/id #edb/ref 17592186247124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e821962-49e9-5a77-9f88-6a51c200b884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-9{R}_{2}" :db/id #edb/ref 17592186244579} {:answer/id #uuid "89907094-f2a4-5219-ae5b-dbeb9f6d7004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{9}{R}_{1}" :db/id #edb/ref 17592186245519} {:answer/id #uuid "93cf44f6-7fb9-52d8-b75b-fdf4cf51376d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:=9{R}_{3}" :db/id #edb/ref 17592186245604} {:answer/id #uuid "a5080df0-3c27-5897-b66c-356c0dc4c395" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+9{R}_{1}" :db/id #edb/ref 17592186245795} {:answer/id #uuid "d3c83e79-dc8e-5ac9-96ee-17cbf5869267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+9{R}_{2}" :db/id #edb/ref 17592186246199}] :answer-field/correct {:answer/id #uuid "93cf44f6-7fb9-52d8-b75b-fdf4cf51376d" :answer/type {