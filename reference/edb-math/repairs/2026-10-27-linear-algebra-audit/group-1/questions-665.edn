#{[{:db/id #edb/ref 17592186712634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17047e3c-f7d7-5a6f-b296-578be3f9ea16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186712632} {:answer/id #uuid "32e595d0-b2be-593c-9789-35e54e349b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Every vector in R³" :db/id #edb/ref 17592186712633} {:answer/id #uuid "4f067355-5791-5dac-a0d6-ddec6779c2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186712635} {:answer/id #uuid "86074445-c523-5032-87e0-8c41dff5e7a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186712638} {:answer/id #uuid "a996ab74-0488-5188-a597-2f03e562f8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186712641}] :answer-field/correct {:answer/id #uuid "17047e3c-f7d7-5a6f-b296-578be3f9ea16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186712632} :answer-field/id #uuid "d11a9179-174e-59ba-8025-9acd95446a51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712645}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4d735390-5a91-52b0-9def-832c9c296555" :question/problem "Solve for $\\mathbf{x}\\in\\mathbb{R}^3$ if\n\n$$\n2(\\mathbf{a}-\\mathbf{x})+3\\mathbf{x}=\\mathbf{b}+\\mathbf{x},\n$$\n\nwhere\n\n$$\n\\mathbf{a}=\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix},\\qquad \\mathbf{b}=\\begin{bmatrix}4 \\\\ -2 \\\\ 7\\end{bmatrix}.\n$$" :question/worked-solution "Distribute the scalar before collecting the unknown vector terms:\n\n$$\n\\begin{aligned}2(\\mathbf{a}-\\mathbf{x})+3\\mathbf{x} &=\\mathbf{b}+\\mathbf{x} \\\\ 2\\mathbf{a}-2\\mathbf{x}+3\\mathbf{x} &=\\mathbf{b}+\\mathbf{x} \\\\ 2\\mathbf{a}+\\mathbf{x} &=\\mathbf{b}+\\mathbf{x} \\\\ 2\\mathbf{a} &=\\mathbf{b}.\\end{aligned}\n$$\n\nThis would require\n\n$$\n\\begin{bmatrix}4 \\\\ -2 \\\\ 6\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -2 \\\\ 7\\end{bmatrix},\n$$\n\nbut the third components are different: $6\\ne7$. The unknown vector has canceled, leaving a false statement. No vector $\\mathbf{x}$ satisfies the original equation, so there is **no solution**. A zero coefficient of $\\mathbf{x}$ does not imply $\\mathbf{x}=\\mathbf{0}$."}] [{:db/id #edb/ref 17592186712637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5241bf78-94df-5785-99a2-910a464fff33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 3 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186712636} {:answer/id #uuid "b86e4c47-b424-534b-9de0-21f5d3f1c2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186712643} {:answer/id #uuid "cd2aa894-884a-5b3e-b177-f6e308a55685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -6 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186712644} {:answer/id #uuid "ea35649e-82ca-50a5-8199-6547fbe9adda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{2} \\\\ -\\frac{3}{4} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186712648} {:answer/id #uuid "f016c2ee-7882-5150-bdef-905a0bc0e44a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186712649}] :answer-field/correct {:answer/id #uuid "b86e4c47-b424-534b-9de0-21f5d3f1c2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186712643} :answer-field/id #uuid "9bb2a3f8-cc57-593c-aecb-062812c5962a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712640}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71a08af9-9a95-5b11-948f-f91f1ac2937f" :question/problem "Find $\\mathbf{x}$ if $2\\mathbf{a}+3\\mathbf{x}=\\mathbf{b}+5\\mathbf{x}$ and\n\n$$\n\\mathbf{a}=\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix},\\qquad \\mathbf{b}=\\begin{bmatrix}6 \\\\ 2 \\\\ -2\\end{bmatrix}.\n$$" :question/worked-solution "Collect the unknown vector terms on the right and the known vector terms on the left:\n\n$$\n\\begin{aligned}2\\mathbf{a}+3\\mathbf{x} &=\\mathbf{b}+5\\mathbf{x} \\\\ 2\\mathbf{a}-\\mathbf{b} &=5\\mathbf{x}-3\\mathbf{x} \\\\ 2\\mathbf{a}-\\mathbf{b} &=2\\mathbf{x} \\\\ \\mathbf{x} &=\\frac{1}{2}(2\\mathbf{a}-\\mathbf{b}) \\\\ &=\\frac{1}{2}\\left(2\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}-\\begin{bmatrix}6 \\\\ 2 \\\\ -2\\end{bmatrix}\\right) \\\\ &=\\frac{1}{2}\\begin{bmatrix}-4 \\\\ -6 \\\\ 8\\end{bmatrix} \\\\ &=\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix}.\\end{aligned}\n$$\n\nSubstitution gives the same vector on both sides:\n\n$$\n2\\begin{bmatrix}1 \\\\ -2 \\\\ 3\\end{bmatrix}+3\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix}=\\begin{bmatrix}-4 \\\\ -13 \\\\ 18\\end{bmatrix}=\\begin{bmatrix}6 \\\\ 2 \\\\ -2\\end{bmatrix}+5\\begin{bmatrix}-2 \\\\ -3 \\\\ 4\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186712647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105de743-bf39-51f7-ac4c-519c12f293d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186712630} {:answer/id #uuid "165847d5-0529-5e8c-a163-ed77ca969cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186712631} {:answer/id #uuid "8d527821-c3e2-5999-bc23-9836a17d0390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 12 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186712639} {:answer/id #uuid "afad26cd-9048-5913-9627-542842705660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186712642} {:answer/id #uuid "d52fb540-b453-51ea-b853-cae6f7c45641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ \\frac{10}{3} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186712646}] :answer-field/correct {:answer/id #uuid "165847d5-0529-5e8c-a163-ed77ca969cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ 4 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186712631} :answer-field/id #uuid "06206cab-6429-598e-89dc-a5e2a9467ed8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712629}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e28c0cf3-bc0f-55da-a276-b9e74f8071e1" :question/problem "Find $\\mathbf{x}$ if $2\\mathbf{a}+3\\mathbf{x}=\\mathbf{b}$ and\n\n$$\n\\mathbf{a}=\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix},\\qquad \\mathbf{b}=\\begin{bmatrix}-2 \\\\ 10 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "Subtract the known vector term, then divide each component by $3$:\n\n$$\n\\begin{aligned}2\\mathbf{a}+3\\mathbf{x} &=\\mathbf{b} \\\\ 3\\mathbf{x} &=\\mathbf{b}-2\\mathbf{a} \\\\ \\mathbf{x} &=\\frac{1}{3}(\\mathbf{b}-2\\mathbf{a}) \\\\ &=\\frac{1}{3}\\left(\\begin{bmatrix}-2 \\\\ 10 \\\\ 0\\end{bmatrix}-2\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix}\\right) \\\\ &=\\frac{1}{3}\\begin{bmatrix}-6 \\\\ 12 \\\\ -6\\end{bmatrix} \\\\ &=\\begin{bmatrix}-2 \\\\ 4 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\nCheck:\n\n$$\n2\\begin{bmatrix}2 \\\\ -1 \\\\ 3\\end{bmatrix}+3\\begin{bmatrix}-2 \\\\ 4 \\\\ -2\\end{bmatrix}=\\begin{bmatrix}4 \\\\ -2 \\\\ 6\\end{bmatrix}+\\begin{bmatrix}-6 \\\\ 12 \\\\ -6\\end{bmatrix}=\\begin{bmatrix}-2 \\\\ 10 \\\\ 0\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186712838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2507a44d-f339-5076-8955-502870c6d21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186712836} {:answer/id #uuid "671e65e3-4e2b-55ec-9bce-c67f3520457a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186712851} {:answer/id #uuid "6ebb0e6e-2147-532f-9365-42e33f8da91a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Every vector in $\\mathbb{R}^4$" :db/id #edb/ref 17592186712852} {:answer/id #uuid "7f870c60-4345-5242-8d26-cbb48eb5d7b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 8 \\\\ 10 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186712855} {:answer/id #uuid "9f3ae402-02f1-55ff-9a91-534941f6ab0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 \\\\ 6 \\\\ 6 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186712859}] :answer-field/correct {:answer/id #uuid "2507a44d-f339-5076-8955-502870c6d21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186712836} :answer-field/id #uuid "73c6c88a-a943-5418-b281-76cdfce9e979" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186712853}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2bc344e7-47f9-5082-a13d-8cd4c68308fd" :question/problem "Solve for $\\mathbf{x}\\in\\mathbb{R}^4$ if\n\n$$\n3\\left(\\mathbf{a}+\\mathbf{x}\\right)-\\mathbf{x}=\\mathbf{b}-\\mathbf{x}\n$$\n\nwhere\n\n$$\n\\mathbf{a}=\\begin{bmatrix}-3 \\\\ 3 \\\\ 4 \\\\ 4\\end{bmatrix},\\qquad \\mathbf{b}=\\begin{bmatrix}6 \\\\ 15 \\\\ 18 \\\\ 15\\end{bmatrix}.\n$$" :question/worked-solution "Distribute the scalar and collect the unknown vector terms.\n\n$$\n\\begin{aligned}3\\left(\\mathbf{a}+\\mathbf{x}\\right)-\\mathbf{x}&=\\mathbf{b}-\\mathbf{x} \\\\ 3\\mathbf{a}+3\\mathbf{x}-\\mathbf{x}&=\\mathbf{b}-\\mathbf{x} \\\\ 3\\mathbf{x}&=\\mathbf{b}-3\\mathbf{a} \\\\ 3\\mathbf{x}&=\\begin{bmatrix}15 \\\\ 6 \\\\ 6 \\\\ 3\\end{bmatrix} \\\\ \\mathbf{x}&=\\frac{1}{3}\\begin{bmatrix}15 \\\\ 6 \\\\ 6 \\\\ 3\\end{bmatrix} \\\\ \\mathbf{x}&=\\begin{bmatrix}5 \\\\ 2 \\\\ 2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nDivide every component by $3$. Substitution into the original equation verifies this vector."}] [{:db/id #edb/ref 17592186712840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b1b4319-efdc-52e2-8403-eeaa7ca361d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Every vector in $\\mathbb{R}^3$" :db/id #edb/ref 17592186712837} {:answer/id #uuid "5b7a8588-1351-5cc0-b37b-833a0e9e3da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186712847} {:answer/id #uuid "9fc38d98-a0a3-5f16-ab5b-5e3e06e2a738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/re