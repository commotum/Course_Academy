hbf{a}}_{2}.$ So, a basis of $S$ is $\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2}\\},$ that is to say, \n\n$$\n\\mathcal{B}=\\{\\begin{bmatrix}-3 \\\\ 8\\end{bmatrix},\\begin{bmatrix}3 \\\\ 3\\end{bmatrix}\\}.\n$$"} {:db/id #edb/ref 17592186427559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b48259-01c4-5109-abc6-4dc67b3a3146" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}8 \\\\ -3 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427541} {:answer/id #uuid "b70926c5-b359-5ad0-bd7d-b705946cb78b" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-9 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427548} {:answer/id #uuid "bd4b0fe3-0884-5aa4-93af-8002f7bc5198" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-9 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}8 \\\\ -3 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427549} {:answer/id #uuid "d713060d-1719-5dcc-a1f8-8b656c01f943" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-16 \\\\ 6 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427552} {:answer/id #uuid "f441b186-2f4b-5de4-917f-48c65dfbcc86" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-9 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}8 \\\\ -3 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-16 \\\\ 6 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427554}] :answer-field/correct {:answer/id #uuid "bd4b0fe3-0884-5aa4-93af-8002f7bc5198" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-9 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}8 \\\\ -3 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186427549} :answer-field/id #uuid "a651d1bb-f837-5587-b77d-257e4a384de7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0010b93b-f332-5a69