 space of $A$, which is $S$. The nonpivot columns can be removed without changing the span. Row operations locate the pivot indices; use the original vectors when writing the basis."} {:db/id #edb/ref 17592186714118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "676e3373-acb7-53a5-b78d-7162059b25fd" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ -2 \\\\ -2\\end{bmatrix},\\;\\begin{bmatrix}-2 \\\\ 2 \\\\ -4 \\\\ -4\\end{bmatrix},\\;\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{bmatrix},\\;\\begin{bmatrix}1 \\\\ 1 \\\\ 0 \\\\ 4\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714098} {:answer/id #uuid "7ac15af0-0457-576a-b7e0-b7977c81e8fa" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ -2 \\\\ -2\\end{bmatrix},\\;\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714100} {:answer/id #uuid "cddc5de9-2aea-53d2-ab9a-4039e126ce2a" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ -2 \\\\ -2\\end{bmatrix},\\;\\begin{bmatrix}1 \\\\ -1 \\\\ 2 \\\\ 2\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714109} {:answer/id #uuid "cf3d7e7f-79e3-584e-a5a3-9363a36cdd00" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ -2 \\\\ -2\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714110} {:answer/id #uuid "e51aa1f3-ecc5-5a21-a908-ce06bf2b969a" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714113}] :answer-field/correct {:answer/id #uuid "7ac15af0-0457-576a-b7e0-b7977c81e8fa" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 1 \\\\ -2 \\\\ -2\\end{bmatrix},\\;\\begin{bmatrix}0 \\\\ -1 \\\\ 1 \\\\ -1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714100} :answer-field/id 