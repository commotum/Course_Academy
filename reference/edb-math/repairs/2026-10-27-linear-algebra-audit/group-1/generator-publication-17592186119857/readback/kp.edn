ype/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\}" :db/id #edb/ref 17592186371066} {:answer/id #uuid "ab31abaa-74a2-58cb-84cc-d50b1ea59be0" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}4 \\\\ -2\\end{bmatrix}\\}" :db/id #edb/ref 17592186371067} {:answer/id #uuid "0939e63b-0927-5013-b553-caac0e47f55a" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}4 \\\\ -2\\end{bmatrix},\\begin{bmatrix}6 \\\\ 7\\end{bmatrix}\\}" :db/id #edb/ref 17592186371068} {:answer/id #uuid "a9f50bb7-4910-55aa-a783-58cc0878502f" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}4 \\\\ -2\\end{bmatrix},\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}\\}" :db/id #edb/ref 17592186371069}] :answer-field/correct {:answer/id #uuid "0939e63b-0927-5013-b553-caac0e47f55a" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}4 \\\\ -2\\end{bmatrix},\\begin{bmatrix}6 \\\\ 7\\end{bmatrix}\\}" :db/id #edb/ref 17592186371068} :answer-field/id #uuid "2fb34408-5114-5a1d-8466-918a4595a268" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371064}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d109fab1-7a0a-532d-8a65-68e9e49778da" :question/math-academy-id "q-75067" :question/problem "Consider the vectors ${\\mathbf{a}}_{1}=\\begin{bmatrix}4 \\\\ -2\\end{bmatrix},$ ${\\mathbf{a}}_{2}=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix},$ and ${\\mathbf{a}}_{3}=\\begin{bmatrix}6 \\\\ 7\\end{bmatrix}.$ Find a basis $B$ of $\\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$" :question/worked-solution "We need to find a subset of linearly independent vectors. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}