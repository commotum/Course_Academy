c {:db/id #edb/ref 17592186048980} :encompassing/weight 0.3333333333333333}] :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/knowledge-points [{:db/id #edb/ref 17592186124477} {:db/id #edb/ref 17592186124478} {:db/id #edb/ref 17592186124479} {:db/id #edb/ref 17592186124480}] :topic/math-academy-id 1904 :topic/next [{:db/id #edb/ref 17592186050178}] :topic/title "Identifying the Pivot Columns of a Matrix"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186725802 :question-generator/id #uuid "24626522-44c7-5f61-a1c2-e7e34358b212" :question-generator/script "generators/13/13cdc34825c74e7eb35a26c653d6c3aa61079da4f46a13c77b44d27f37b0a8d0/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186120338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99d5d699-2c32-5e33-8c0a-c7bde90e4f12" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 7 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118158} {:answer/id #uuid "b8b6cf7e-042b-5174-9e6f-b4eaee4e778f" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}2 \\\\ -14 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118159} {:answer/id #uuid "2a3915ec-765c-578b-b7bd-2b50af4a69e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118160} {:answer/id #uuid "516a4a58-eec7-5c72-a86e-18168edd95c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-1 \\\\ 7 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ -14 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118161} {:answer/id #uuid "6c4d4e39-2528-5b12-880a-f0ef64c173a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-1 \\\\ 7 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118162}] :answer-field/correct {:answer/id #uuid "99d5d699-2c32-5e33-8c0a-c7bde90e4f12" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-1 \\\\ 7 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186118158} :answer-field/id #uuid "72c538fe-430b-5995-b3f4-aa259eaa63e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118157}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a89108a8-d6a3-5ede-8a7d-e076eed2e86f" :question/math-academy-id "q-34464" :question/problem "Consider the vectors ${\\mathbf{a}}_{1}=\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}$, ${\\mathbf{a}}_{2}=\\begin{bmatrix}-1 \\\\ 7 \\\\ 0\\end{bmatrix}$, and ${\\mathbf{a}}_{3}=\\begin{bmatrix}2 \\\\ -14 \\\\ 0\\end{bmatrix}$. Find a basis $B$ of $\\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}$." :question/worked-solution "We need a linearly independent subset that has the same span. Place the given vectors in the columns of a matrix:\n\n$$\n\\begin{bmatrix}5&-1&2\\\\0&7&-14\\\\0&0&0\\end{bmatrix}.\n$$\n\nThis matrix is already in row echelon form, with pivots in the first and second columns. The third column is $-2$ times the second, so $a_3=-2a_2$ can be removed without changing the span. Select the first and second columns from the original matrix:\n\n$$\nB=\\left\\{\\begin{bmatrix}5\\\\0\\\\0\\end{bmatrix},\\begin{bmatrix}-1\\\\7\\\\0\\end{bmatrix}\\right\\}.\n$$"} {:db/id #edb/ref 17592186120399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15cfb642-9e64-528d-927d-c6e8ff6db964" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}\\}" :db/id #edb/ref 17592186321323} {:answer/id #uuid "1c284991-45e3-5538-8aa1-f55c069004b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-4 \\\\ -6\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\\}" :db/id #edb/ref 17592186321361} {:answer/id #uuid "b989efb8-be23-5a75-ad11-9e6cd939ad34" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\\}" :db/id #edb/ref 17592186322587} {:answer/id #uuid "e3edb4e2-9f7d-5526-9df5-1b6e4a177ea0" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}\\}" :db/id #edb/ref 17592186322933} {:answer/id #uuid "fbb5a983-9153-55a4-b046-e874770016c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}\\}" :db/id #edb/ref 17592186323133}] :answer-field/correct {:answer/id #uuid "b989efb8-be23-5a75-ad11-9e6cd939ad34" :answer/type {:db/ident :answer.type/math} :answer/value "\\mathcal{B}=\\{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\\}" :db/id #edb/ref 17592186322587} :answer-field/id #uuid "d5fe3d3d-94be-516c-9d55-e5600444b9f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323592}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fe4864a-ed27-50fc-8816-ad1ec4b0dfc8" :question/math-academy-id "q-35694" :question/problem "Consider the vectors ${\\mathbf{a}}_{1}=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},$ ${\\mathbf{a}}_{2}=\\begin{bmatrix}4 \\\\ -6\\end{bmatrix},$ and ${\\mathbf{a}}_{3}=\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}.$ Find a basis $B$ of $\\text{Span}\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{2},{\\mathbf{a}}_{3}\\}.$" :question/worked-solution "We need to find a subset of linearly independent vectors. So, we start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-2 & 4 & -2 \\\\ 3 & -6 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{3}{2}{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 4 & -2 \\\\ 0 & 0 & -6\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $3$rd columns are pivot columns, while the $2$nd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one.\n\nThe $1$st and $3$rd columns from the original matrix are ${\\mathbf{a}}_{1}$ and ${\\mathbf{a}}_{3}.$ So, a basis of $S$ is $\\{{\\mathbf{a}}_{1},{\\mathbf{a}}_{3}\\},$ that is to say, \n\n$$\n\\mathcal{B}=\\{\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix},\\begin{bmatrix}-2 \\\\ -3\\end{bmatrix}\\}.\n$$"} {:db/id #edb/ref 17592186247171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316d5931-7999-53f3-ad90-06c5ea96ca28" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186488576} {:answer/id #uuid "3cc5baa7-58c6-5fb1-bb5b-bc5d2809c3fd" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}6 \\\\ 2 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186488596} {:answer/id #uuid "81e78e16-327e-5283-9ae6-8297686d3018" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\begin{bmatrix}5 \\\\ 0 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186488728} {:answer/id #uuid "8961892e-bd58-5202-80e6-b3295e996c34" :answer/type {:db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}6 \\\\ 2 \\\\ 0\\end{bmatrix}\\}" :db/id #edb/ref 17592186488743} {:answer/id #uuid "8f4f12a7-86f7-5632-aa12-4ebf32e0df03" :answer/type {:db/ident :answer.type/math} :