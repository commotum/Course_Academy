nswer-field.type/checkbox} :db/id #edb/ref 17592186713884} {:answer-field/choices [{:answer/id #uuid "df73af6f-4d56-5526-8ea5-3e4773d8a52b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713892} {:answer/id #uuid "e057aaa4-3134-5fcf-8220-fecfc0fe3a96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713894}] :answer-field/correct {:answer/id #uuid "e057aaa4-3134-5fcf-8220-fecfc0fe3a96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713894} :answer-field/id #uuid "c98de253-704e-5512-8c85-a32b817eb731" :answer-field/key "$\\{\\mathbf{a}_{1},\\mathbf{a}_{2}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186713887} {:answer-field/choices [{:answer/id #uuid "2ea69391-98cb-527c-bdbc-1928032fd436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713838} {:answer/id #uuid "b6293e33-dfed-5273-bca9-9ef49db71ce4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713883}] :answer-field/correct {:answer/id #uuid "2ea69391-98cb-527c-bdbc-1928032fd436" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713838} :answer-field/id #uuid "ec631a61-020e-5d21-a85e-9804fb198842" :answer-field/key "$\\{\\mathbf{a}_{2},\\mathbf{a}_{3}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186713898}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8064fc83-0cc2-5cb4-9e7e-0f271141e052" :question/problem "Consider the vectors\n\n$$\n\\mathbf{a}_{1}=\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix},\\qquad \\mathbf{a}_{2}=\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix},\\qquad \\mathbf{a}_{3}=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}.\n$$\n\nFind bases of $S=\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2,\\mathbf{a}_3\\}$ by inspection. **Select every set that is a basis of $S$.**" :question/worked-solution "A **basis** must be linearly independent and span $S$.\n\nIf $\\mathbf{a}_{2}=t\\mathbf{a}_{3}$, coordinate $1$ would force $t=0$. But coordinate $2$ would then give $(0)(0)=0\\ne 1$. Thus these two nonzero vectors are not parallel and are linearly independent.\n\nTo have $\\mathbf{a}_{1}=x\\mathbf{a}_{3}+y\\mathbf{a}_{2}$, coordinates $1$ and $2$ force $x=1$ and $y=-1$. The remaining coordinate would have to be $(1)(2)+(-1)(2)=0$; the displayed value is $1$.\n\nChecking the proposed combination gives\n\n$$\n(1)\\mathbf{a}_{3}+(-1)\\mathbf{a}_{2}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}\\ne \\mathbf{a}_{1}.\n$$\n\nThus $\\mathbf{a}_{1}$ is outside the span of the independent pair. All three vectors are independent. The triple spans $S$; every proper subset omits an independent direction.\n\nTherefore, select exactly these bases:\n\n$$\n\\begin{aligned}\\mathcal{B}_{1}&=\\{\\mathbf{a}_{1},\\mathbf{a}_{2},\\mathbf{a}_{3}\\}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186713886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0b2fb6c-c293-597c-b536-c549e0428678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713905} {:answer/id #uuid "f9258d1c-55e4-578c-873d-fb0423644f5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713907}] :answer-field/correct {:answer/id #uuid "f0b2fb6c-c293-597c-b536-c549e0428678" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713905} :answer-field/id #uuid "0b046170-ef76-53dd-8fae-71072a4f9f79" :answer-field/key "$\\{