8e-93a5-5679-8b15-d39b07c4f6ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713822} {:answer/id #uuid "36ee5a79-a7ed-5482-9d6e-a1f512f27b6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186713840}] :answer-field/correct {:answer/id #uuid "03ad238e-93a5-5679-8b15-d39b07c4f6ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186713822} :answer-field/id #uuid "e1fc28fe-de7e-559e-a04c-59754ac8f4e0" :answer-field/key "$\\{\\mathbf{a}_{1},\\mathbf{a}_{2},\\mathbf{a}_{3}\\}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186713896}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f05c7809-b71c-5fce-8272-930443af43b0" :question/problem "Consider the vectors\n\n$$\n\\mathbf{a}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix},\\qquad \\mathbf{a}_{2}=\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix},\\qquad \\mathbf{a}_{3}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}.\n$$\n\nFind bases of $S=\\operatorname{Span}\\{\\mathbf{a}_1,\\mathbf{a}_2,\\mathbf{a}_3\\}$ by inspection. **Select every set that is a basis of $S$.**" :question/worked-solution "A **basis** must be linearly independent and span $S$.\n\nIf $\\mathbf{a}_{2}=t\\mathbf{a}_{3}$, coordinate $2$ would force $t=-1$. But coordinate $1$ would then give $(-1)(0)=0\\ne 1$. Thus these two nonzero vectors are not parallel and are linearly independent.\n\nTo have $\\mathbf{a}_{1}=x\\mathbf{a}_{3}+y\\mathbf{a}_{2}$, coordinates $3$ and $1$ force $x=1$ and $y=1$. The remaining coordinate would have to be $(1)(1)+(1)(-1)=0$; the displayed value is $1$.\n\nChecking the proposed combination gives\n\n$$\n(1)\\mathbf{a}_{3}+(1)\\mathbf{a}_{2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}\\ne \\mathbf{a}_{1}.\n$$\n\nThus $\\mathbf{a}_{1}$ is outside the span of the independent pair. All three vectors are independent. The triple spans $S$; every proper subset omits an independent direction.\n\nTherefore, select exactly these bases:\n\n$$\n\\begin{aligned}\\mathcal{B}_{1}&=\\{\\mathbf{a}_{1},\\mathbf{a}_{2},\\mathbf{a}_{3}\\}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186714062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19187d96-60c6-5d56-9dd6-592f1c447a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714058} {:answer/id #uuid "39296d13-f3cc-5b4b-babb-1a0d60bbb89d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714067} {:answer/id #uuid "397e79f3-3100-52b8-a66e-cec7ec05b23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714068} {:answer/id #uuid "3ec58a55-8627-5b8c-9576-55771346a565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714070} {:answer/id #uuid "7fc19ce5-de69-51e7-a8cb-c0fbbb428881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}4 \\\\ -6 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714075}] :answer-field/correct {:answer/id #uuid "397e79f3-3100-52b8-a66e-cec7ec05b23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714068} :answer-field/id #uuid "24c3a71e-1061-5bff-ad90-215b17ade4de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186714061}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "293ce814-d429-585c-b915-8169dcc8935d" :question/problem "Consider the vectors\n\n$$\n\\begin{aligned}a_{1} &=\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}\\qquad a_{2} &=\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ a_{3} &=\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nFind a basis $B$ of $S=\\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ by identifying pivot columns." :question/worked-solution "Place the vectors in the columns of a matrix:\n\n$$\nA=\\begin{bmatrix}0 & 3 & 2 \\\\ 0 & 0 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nThis matrix is already in row echelon form.\n\nThe leading nonzero entries are in columns $2, 3$. Select the corresponding columns from the **original matrix**, giving $B=\\{a_{2},\\;a_{3}\\}$:\n\n$$\nB=\\left\\{\\begin{bmatrix}3 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}2 \\\\ -3 \\\\ 0\\end{bmatrix}\\right\\}.\n$$\n\nThese pivot columns are linearly independent and span the column space of $A$, which is $S$. The nonpivot columns can be removed without changing the span. Row operations locate the pivot indices; use the original vectors when writing the basis."}] [{:db/id #edb/ref 17592186714064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08dbdaec-f0d0-5bcf-b336-49adc6de5716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714056} {:answer/id #uuid "1a3af82f-7748-5664-b7e3-0ad0030c05d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714059} {:answer/id #uuid "34ee0802-0b07-5e59-a064-a2fa9bbeb697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714066} {:answer/id #uuid "88b9f827-c8f0-5e6a-af0d-ac1a1be00533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-1 \\\\ 3 \\\\ -1\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714079} {:answer/id #uuid "e601a342-80f3-5bbb-aaa4-1e79e881d451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714089}] :answer-field/correct {:answer/id #uuid "e601a342-80f3-5bbb-aaa4-1e79e881d451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714089} :answer-field/id #uuid "3e4323e1-66e7-506c-9c69-9a509c8ac0bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186714069}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "341e0bdc-1e61-5b74-bb1f-03f21056b3a6" :question/problem "Consider the vectors\n\n$$\n\\begin{aligned}a_{1} &=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\qquad a_{2} &=\\begin{bmatrix}2 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ a_{3} &=\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nFind a basis $B$ of $S=\\operatorname{Span}\\{a_{1},a_{2},a_{3}\\}$ by identifying pivot columns." :question/worked-solution "Place the vectors in the columns of a matrix:\n\n$$\nA=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nThis matrix is already in row echelon form.\n\nThe leading nonzero entries are in columns $1, 3$. Select the corresponding columns from the **original matrix**, giving $B=\\{a_{1},\\;a_{3}\\}$:\n\n$$\nB=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-1 \\\\ 3 \\\\ 0\\end{bmatrix}\\right\\}.\n$$\n\nThese pivot columns are linearly independent and span the column space of $A$, which is $S$. The nonpivot columns can be removed without changing the span. Row operations locate the pivot indices; use the original vectors when writing the basis."}] [{:db/id #edb/ref 17592186714074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be34091-7153-58cf-9808-97c420c913b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}-2 \\\\ -1 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714057} {:answer/id #uuid "887f1de0-02cc-5e7b-9f52-3b5a899283f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714078} {:answer/id #uuid "9f7a46e0-3c8e-55d4-a751-d2702a7b5a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-2 \\\\ -1 \\\\ 0\\end{bmatrix}\\right\\}" :db/id #edb/ref 17592186714081} {:answer/id #uuid "e501e891-32fd-524f-9ddf-56a7abdd675b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\left\\{\\begin{bmatrix}-1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix},\\;\\begi