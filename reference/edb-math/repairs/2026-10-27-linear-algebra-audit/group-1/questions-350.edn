7592186045485} :question/id #uuid "1a05ecba-dbf9-513d-af2d-03ee8f54c56e" :question/math-academy-id "q-20508" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 2 & -1 & 1 & 3 \\\\ -1 & 1 & 0 & -3\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 2 & -1 & 1 & 3 \\\\ -1 & 1 & 0 & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 0 & 1 & -1 & 1 \\\\ -1 & 1 & 0 & -3\\end{array}\\right] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & 1 \\\\ 0 & 1 & -1 & 1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8326c365-38e8-509f-ba26-6de3d26a5411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186390376} {:answer/id #uuid "f0893938-c4dc-5b69-ac7a-20d7546db3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186390377} {:answer/id #uuid "98de7d9c-ac96-50b3-a7cd-2e1f0a084bca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186390378} {:answer/id #uuid "5d46c30a-315a-5f3c-9e1c-febc548b0a21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186390379} {:answer/id #uuid "c961a688-8a1a-5a32-8996-3f5dbb760b72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186390380}] :answer-field/correct {:answer/id #uuid "f0893938-c4dc-5b69-ac7a-20d7546db3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186390377} :answer-field/id #uuid "1a2efbab-ca3d-5dfb-bdbf-f29fc5964e47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390375}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b0ab2ea-5bc8-5361-b6e4-ca31cdf1350a" :question/math-academy-id "q-20539" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 4 & 12 & 17 & -26\\end{array}\\right] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"}]}
