_{1} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n\\begin{bmatrix}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{bmatrix}\\cdot A\n$$"}] [{:db/id #edb/ref 17592186302071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9c3794-3d61-5c59-8f4c-0fba7faa0d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186300081} {:answer/id #uuid "6036e44a-abe5-5908-af38-25d639e02c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186300456} {:answer/id #uuid "85975f0b-1702-5c99-8d51-dd63c624b6d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186300631} {:answer/id #uuid "b8b73eaf-15e2-5527-a7eb-70edc5e8e657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186300883} {:answer/id #uuid "dbeceeef-284b-50ec-b0a1-fe8def1b75fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & -4\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\