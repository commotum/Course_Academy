n{bmatrix}\\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ -\\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\nand\n$$\nB=\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\n$$" :question/worked-solution "The matrix $B$ is column $1$ of $I_3$. Multiplying on the right selects column $1$ of $A$:\n$$\nAB=\\begin{bmatrix}\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ 0\\end{bmatrix}\n$$\nCheck the entries by row-by-column multiplication:\n$$\n\\begin{aligned}\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot 1+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot 0+(0)\\cdot 0&=\\frac{\\sqrt{2}}{2} \\\\ \\left(-\\frac{\\sqrt{2}}{2}\\right)\\cdot 1+\\left(\\frac{\\sqrt{2}}{2}\\right)\\cdot 0+(0)\\cdot 0&=-\\frac{\\sqrt{2}}{2} \\\\ (0)\\cdot 1+(0)\\cdot 0+(1)\\cdot 0&=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186719638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115b7665-9ae5-5c37-8d6e-afec25b364bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719613}] :answer-field/correct {:answer/id #uuid "115b7665-9ae5-5c37-8d6e-afec25b364bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186719613} :answer-field/id #uuid "166e60cb-998f-5bcd-8095-f32d1d277f36" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186719615} {:answer-field/choices [{:answer/id #uuid "94c7a3da-9ade-5967-9407-13bad298f738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186719634}] :answer-field/correct {:answer/id #uuid "94c7a3da-9ade-5967-9407-13bad298f738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186719634} :answer-field/id #uuid "4db9ba7d-5640-5c23-a01a-91477ee4daba" :answer-field/key "