ked-solution "Notice that $A$ is a matrix for which all entries below the diagonal are $0$'s:\n\n$$\nA = \\begin{bmatrix}-6 & 2 & 0 \\\\ 0 & 3 & -4 \\\\ 0 & 0 & 8\\end{bmatrix}\n$$\n\nTherefore, it is an upper triangular matrix.\n\nIt is not a lower triangular matrix or a diagonal matrix since there is a non-zero element above the diagonal: ${a}_{12}=2\\ne 0.$"}] [{:db/id #edb/ref 17592186576289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d9392b9-825e-5242-8135-bb88d1eae49a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186576287} {:answer/id #uuid "126267db-46cf-567b-ba73-303b0fa8a62d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Other" :db/id #edb/ref 17592186576288} {:answer/id #uuid "2810638d-bcdf-5f06-8451-df224d5dd854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Upper triangular matrix" :db/id #edb/ref 17592186576292} {:answer/id #uuid "2a6123e2-cb40-5f61-bbb4-7473bfc2ddb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Diagonal matrix" :db/id #edb/ref 17592186576293} {:answer/id #uuid "7fedff43-e926-5a78-97ac-2fa601b09eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Identity matrix" :db/id #edb/ref 17592186576303}] :answer-field/correct {:answer/id #uuid "0d9392b9-825e-5242-8135-bb88d1eae49a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186576287} :answer-field/id #uuid "dd9d690f-4db9-57c0-9bb0-01c2b39686ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186576309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18165933-2531-502a-