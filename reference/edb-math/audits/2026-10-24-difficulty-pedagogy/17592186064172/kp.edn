#{[{:db/id #edb/ref 17592186064172 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064050 :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/math-academy-id "e-380" :question/problem "Calculate $$\n\\displaystyle \\int -6(7^x) \\, \\textrm d x.\n$$" :question/worked-solution "First, we factor out the constant $-6.$ Then, we integrate the exponential function, and get\n\n$$\n\\begin{aligned}\n\\int (-6)7^x  \\, \\textrm d x   \n&= -6\\int 7^x\\,\\textrm{d}x\\\\\n&=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C.\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/questions [{:db/id #edb/ref 17592186064732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f91348-41c4-59da-9054-29ca395a2dff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\ln x} + C" :db/id #edb/ref 17592186062450} {:answer/id #uuid "0c1f6d71-03b1-5b2e-88f6-fb297b2ed172" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln x}{\\ln 5} + C" :db/id #edb/ref 17592186062451} {:answer/id #uuid "36f6ac37-51eb-57a2-a3ff-6f122cc6d6cb" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot \\frac{4^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062452} {:answer/id #uuid "5ac5273f-b429-5937-9cf1-d1c7eda2cfb6" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot \\frac{5^{\\ln x}}{\\ln 5} + C" :db/id #edb/ref 17592186062453} {:answer/id #uuid "6a2714d6-38ad-52bb-bd65-61cbd0d301e9" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot \\frac{5^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062454}] :answer-field/id #uuid "98e96cde-6df7-5835-82c7-e2a56458c62a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062449}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e19a3f4c-ed35-54ad-b148-0361a3082be0" :question/math-academy-id "q-31248" :question/problem "What is $$\n\\