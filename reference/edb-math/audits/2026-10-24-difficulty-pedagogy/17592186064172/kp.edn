ype/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $$\n\\displaystyle \\int {5}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d639fb1-5e97-552a-8900-f00ca81a7aa1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot {9}^{x}+C" :db/id #edb/ref 17592186247685} {:answer/id #uuid "4e751153-0344-5e47-bcf5-2ce3275c0e44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡9}{{9}^{x}}+C" :db/id #edb/ref 17592186248130} {:answer/id #uuid "7bfcf753-80ad-5540-ac4c-743bbdad3d0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{9}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186248511} {:answer/id #uuid "c52e14f9-6656-5f67-a272-35abe6783236" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡2}{9ln⁡x}+C" :db/id #edb/ref 17592186249175} {:answer/id #uuid "fc1db222-2e90-5213-97f5-5919e160fc92" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186249619}] :answer-field/correct {:answer/id #uuid "fc1db222-2e90-5213-97f5-5919e160fc92" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186249619} :answer-field/id #uuid "8f4bc499-d0fb-5f3a-829e-6c1ced03dc45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249923}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "763936f6-7387-5f00-bda0-da6f24c0d625" :question/math-academy-id "q-113890" :question/problem "$$\n\\displaystyle \\int 2\\cdot {9}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "First, we factor out the constant $2.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 2\\cdot {9}^{x}\\,\\text{d}x & =2\\int {9}^{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{9}^{x}}{ln⁡9}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fd8908-86c1-5758-81a1-2ec277f68aa3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\left(\\frac{1}{8}\\right)}^{x}ln⁡8+C" :db/id #edb/ref 17592186247614} {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} {:answer/id #uuid "5253b616-1982-56f6-8a9e-7ac1838f5f20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186248162} {:answer/id #uuid "57f12027-6306-5a43-b276-eb500592f0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186248222} {:answer/id #uuid "7f8980f3-ea7f-50a6-9c9c-7812ebfc0549" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} :answer-field/id #uuid "8d70d61a-ae6a-57e0-bc6d-72a634f609db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249920}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "89cd3b1f-2f20-5813-8f46-6c4d05bd7fcb" :question/math-academy-id "q-113893" :question/problem "Calculate $$\n\\displaystyle \\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{8}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡\\left(\\frac{1}{8}\\right) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡\\left(\\frac{1}{8}\\right)}+C=-\\frac{{\\left(\\frac{1}{8}\\right)}^{x}}{ln⁡8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38bd8b8c-b4c6-5ce9-a1d8-1966ee4c81bb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{3}^{ln⁡x}}{ln⁡2}+C" :db/id #edb/ref 17592186295587} {:answer/id #uuid "588dfff7-5cbe-5038-b14d-3d8e751e698d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡2}+C" :db/id #edb/ref 17592186295779} {:answer/id #uuid "986402eb-7839-5d62-b792-c55aac95a275" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186296083} {:answer/id #uuid "9902409f-61ad-5f6d-bef9-23a2badd42e4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{3}^{2x}}{ln⁡3}+C" :db/id #edb/ref 17592186296087} {:answer/id #uuid "ba798157-3c82-5684-a8b2-fe1f9b64430c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{ln⁡x}+C" :db/id #edb/ref 17592186296245}] :answer-field/correct {:answer/id #uuid "986402eb-7839-5d62-b792-c55aac95a275" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186296083} :answer-field/id #uuid "11c70d75-1a42-5da1-9557-cc4e7e234b2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296672}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a909a720-f9c7-52e5-a8a4-abd3492e6b5f" :question/math-academy-id "q-31249" :question/problem "$$\n\\displaystyle \\int 3\\cdot {2}^{x}\\,\\text{d}x=\n$$" :question/worked-solution "First, we factor out the constant $3.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 3\\cdot {2}^{x}\\,\\text{d}x & =3\\int {2}^{x}\\,\\text{d}x \\\\  & =3\\cdot \\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186573944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} {:answer/id #uuid "3c5b76da-5c79-5570-96fc-a1071399ac45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{3\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573497} {:answer/id #uuid "8096f421-e949-50b4-8f19-80003343c718" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\left(\\frac{1}{3}\\right)}^{x}+C" :db/id #edb/ref 17592186573592} {:answer/id #uuid "d2eb6285-99de-51bb-896a-d2849f05a9d1" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡3{\\left(\\frac{1}{3}\\right)}^{x}+C" :db/id #edb/ref 17592186573702} {:answer/id #uuid "ec976108-75b3-594d-8698-a417623ef1c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3{\\left(\\frac{1}{3}\\right)}^{x}+C" :db/id #edb/ref 17592186573734}] :answer-field/correct {:answer/id #uuid "07836247-f997-5dfb-b77d-a88bd5744dd6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186573432} :answer-field/id #uuid "2cf68b31-cd10-5161-95fb-e446441e1ca2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573787}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f3a89c81-1f21-57c4-8472-9cb98515b280" :question/math-academy-id "q-71910" :question/problem "Calculate $$\n\\displaystyle \\int {\\left(\\frac{1}{3}\\right)}^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {\\left(\\frac{1}{3}\\right)}^{x}\\,\\text{d}x & =\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{\\operatorname{ln}⁡\\left(\\frac{1}{3}\\right)}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡\\left(\\frac{1}{3}\\right) & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\  & =0-\\operatorname{ln}⁡3 \\\\  & =-\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{\\operatorname{ln}⁡\\left(\\frac{1}{3}\\right)}+C &=-\\frac{{\\left(\\frac{1}{3}\\right)}^{x}}{\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating an Exponential Function With a General Base"}]}
