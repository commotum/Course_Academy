592186101453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157cb123-7330-58bc-a063-3374ccd593b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{59}{3}" :db/id #edb/ref 17592186330122} {:answer/id #uuid "15ed61b4-3ade-50d3-8b2c-9f81770e4827" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{6}" :db/id #edb/ref 17592186330135} {:answer/id #uuid "25977eb2-b160-5400-965b-3c3bab2cb7e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{6}" :db/id #edb/ref 17592186330274} {:answer/id #uuid "7bcb3619-33fc-5423-ae01-62b75b557302" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{9}" :db/id #edb/ref 17592186331039} {:answer/id #uuid "e0809338-7fdb-55c8-b1a8-c0195030c113" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{3}" :db/id #edb/ref 17592186331931}] :answer-field/correct {:answer/id #uuid "e0809338-7fdb-55c8-b1a8-c0195030c113" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{3}" :db/id #edb/ref 17592186331931} :answer-field/id #uuid "8f9ab705-9785-5102-b86c-ad670d149651" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332453}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "17c3d123-f91a-5a92-a651-8b2492b2be43" :question/math-academy-id "q-49610" :question/problem "Calculate the definite integral $$\n\\displaystyle {\\int }_{1}^{2}{(2x+1)}^{2}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =2x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2 \\\\ \\text{d}u & =2\\,\\text{d}x \\\\ \\frac{1}{2}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=2x+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 1 & 2 \\\\ \\hline u & 3 & 5 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{2}{(2x+1)}^{2}\\,\\text{d}x={\\int }_{3}^{5}{u}^{2}\\cdot \\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{5}{u}^{2}\\cdot \\frac{1}{2}\\text{d}u & =\\frac{1}{2}{\\int }_{3}^{5}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\cdot \\frac{1}{3}{u}^{3}|}_{3}^{5} \\\\  & =\\frac{1}{2}\\cdot \\frac{{5}^{3}-{3}^{3}}{3} \\\\  & =\\frac{1}{2}\\cdot \\frac{125-27}{3} \\\\  & =\\frac{98}{6} \\\\  & =\\frac{49}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e08c25-53f6-56c6-b37c-9f2613113562" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{844}" :db/id #edb/ref 17592186281749} {:answer/id #uuid "2dc12e58-2d01-50bd-9a66-980395ab1e0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{48}{5}" :db/id #edb/ref 17592186282089} {:answer/id #uuid "cb301ba0-f91b-5349-b957-257925a88ad0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{448}{5}" :db/id #edb/ref 17592186283465} {:answer/id #uuid "ce7e6a99-02ab-586e-b409-32d4c7b24816" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{844}{5}" :db/id #edb/ref 17592186283493} {:answer/id #uuid "d893f264-802c-5576-9efe-cdcc40eb0b41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{484}{5}" :db/id #edb/ref 17592186283577}] :answer-field/correct {:answer/id #uuid "d893f264-802c-5576-9efe-cdcc40eb0b41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{484}{5}" :db/id #edb/ref 17592186283577} :answer-field/id #uuid "9a4457a0-d186-5f7a-b2a9-fa84d18d00ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284199}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "12f8c1d9-a9d0-50bf-abea-c2c8a8d35792" :question/math-academy-id "q-17103" :question/problem "$$\n\\displaystyle {\\int }_{0}^{2}3{x}^{2}\\sqrt{{({x}^{3}+1)}^{3}}\\,\\text{d}x=\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{3}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2} \\\\ \\text{d}u & =3{x}^{2}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{3}+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 2 \\\\ \\hline u & 1 & 9 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\sqrt{{({x}^{3}+1)}^{3}}\\cdot 3{x}^{2}\\,\\text{d}x={\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\text{d}u & ={\\int }_{1}^{9}{u}^{3/2}\\,\\text{d}u \\\\  & ={\\frac{2}{5}{u}^{5/2}|}_{1}^{9} \\\\  & =\\frac{2}{5}({9}^{5/2}-{1}^{5/2}) \\\\  & =\\frac{2}{5}(({3}^{2})^{5/2}-1) \\\\  & =\\frac{2}{5}({3}^{5}-1) \\\\  & =\\frac{484}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28a30ff9-3b62-5356-9656-ec02d7e6895e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}(2\\sqrt{2}-1)" :db/id #edb/ref 17592186282039} {:answer/id #uuid "4ba7d001-1251-5e08-9682-9d36d414d8cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}(4\\sqrt{2}-1)" :db/id #edb/ref 17592186282338} {:answer/id #uuid "6946f231-dc72-5464-a957-623dad9874b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{15}(4\\sqrt{2}-1)" :db/id #edb/ref 17592186282593} {:answer/id #uuid "7c7f1f8d-1802-501c-ba81-0dc577801a46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}(4\\sqrt{2}+1)" :db/id #edb/ref 17592186282764} {:answer/id #uuid "83956ed5-7220-549a-941b-c8d82a474c6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}(4\\sqrt{2}-1)" :db/id #edb/ref 17592186282826}] :answer-field/correct {:answer/id #uuid "4ba7d001-1251-5e08-9682-9d36d414d8cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}(4\\sqrt{2}-1)" :db/id #edb/ref 17592186282338} :answer-field/id #uuid "a6b8013a-ce72-50b8-bb0d-bca57a49fd0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284224}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "84aca7ae-780f-5acd-9b43-37d22c8d6cd9" :question/math-academy-id "q-17104" :question/problem "Evaluate the definite integral $$\n\\displaystyle {\\int }_{0}^{1}{x}^{2}\\sqrt{{(2-{x}^{3})}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =2-{x}^{3} \\\\ \\frac{\\text{d}u}{\\text{d}x} & =-3{x}^{2} \\\\ \\text{d}u & =-3{x}^{2}\\,\\text{d}x \\\\ -\\frac{1}{3}\\text{d}u & ={x}^{2}\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=2-{x}^{3}.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 1 \\\\ \\hline u & 2 & 1 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\sqrt{{(2-{x}^{3})}^{3}}\\cdot {x}^{2}\\,\\text{d}x={\\int }_{2}^{1}\\sqrt{{u}^{3}}\\cdot \\left(-\\frac{1}{3}\\right)\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{2}^{1}\\sqrt{{u}^{3}}\\cdot \\left(-\\frac{1}{3}\\right)\\text{d}u & =-\\frac{1}{3}{\\int }_{2}^{1}{u}^{3/2}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{2}^{1} \\\\  & =-\\frac{1}{3}\\cdot \\frac{2}{5}({1}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{2}{15}(1-({2}^{5})^{1/2}) \\\\  & =-\\frac{2}{15}(1-4\\sqrt{2}) \\\\  & =\\frac{2}{15}(4\\sqrt{2}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "362046fe-9c6a-58a5-ae85-d29f14c2b041" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{671}{2}" :db/id #edb/ref 17592186297770}] :answer-field/correct {:answer/id #uuid "362046fe-9c6a-58a5-ae85-d29f14c2b041" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{671}{2}" :db/id #edb/ref 17592186297770} :answer-field/id #uuid "7f7f3757-5c39-5541-a2e0-f9c096b49cd8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299068}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b16d83bf-12e3-5715-9420-1c293062c088" :question/math-academy-id "q-318994" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{1}6{x}^{2}\\cdot {({x}^{3}+5)}^{3}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{3}+5 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2} \\\\ \\text{d}u & =3{x}^{2}\\,\\text{d}x \\\\ 6{x}^{2}\\,\\text{d}x & =2\\,\\text{d}u\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{3}+5.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 1 \\\\ \\hline u & 5 & 6 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}6{x}^{2}\\cdot {({x}^{3}+5)}^{3}\\,\\text{d}x={\\int }_{5}^{6}{u}^{3}\\cdot 2\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{5}^{6}2{u}^{3}\\,\\text{d}u & =2{\\int }_{5}^{6}{u}^{3}\\,\\text{d}u \\\\  & =2\\cdot {\\frac{{u}^{4}}{4}|}_{5}^{6} \\\\  & =2\\cdot \\frac{1}{4}({6}^{4}-{5}^{4}) \\\\  & =\\frac{1}{2}(1296-625) \\\\  & =\\frac{1}{2}\\cdot 671 \\\\  & =\\frac{671}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c456d8b3-7ef3-59e5-a8fb-a629343d9c5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186310323}] :answer-field/correct {:answer/id #uuid "c456d8b3-7ef3-59e5-a8fb-a629343d9c5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186310323} :answer-field/id #uuid "7f7dcfb9-fd15-501e-8b70-53d1cf1c6d33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311142}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1c2d29f-f77c-522c-8fc4-71bcad74829c" :question/math-academy-id "q-336603" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{-7/10}^{-1/5}\\sqrt{10x+7}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =10x+7 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =10 \\\\ \\text{d}u & =10\\,\\text{d}x \\\\ \\frac{1}{10}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=10x+7.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & -\\frac{7}{10} & -\\frac{1}{5} \\\\ \\hline u & 0 & 5 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{-7/10}^{-1/5}\\sqrt{10x+7}\\,\\text{d}x={\\int }_{0}^{5}\\sqrt{u}\\,\\cdot \\frac{1}{10}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}\\sqrt{u}\\,\\cdot \\frac{1}{10}\\,\\text{d}u & =\\frac{1}{10}{\\int }_{0}^{5}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\cdot {\\frac{2}{3}{u}^{3/2}|}_{0}^{5} \\\\  & =\\frac{1}{10}\\cdot \\frac{2}{3}({5}^{3/2}-{0}^{3/2}) \\\\  & =\\frac{1}{15}(({5}^{3})^{1/2}-0) \\\\  & =\\frac{1}{15}\\cdot 5\\sqrt{5} \\\\  & =\\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af233ea7-8f75-5c74-8862-627232df1716" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186310166}] :answer-field/correct {:answer/id #uuid "af233ea7-8f75-5c74-8862-627232df1716" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186310166} :answer-field/id #uuid "edaedafa-3154-5cd6-bf1c-4451e3246564" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311487}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5dc53a57-411e-580b-a40e-954fafb6854b" :question/math-academy-id "q-336612" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{1}8{x}^{3}\\cdot {({x}^{4}+1)}^{2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{4}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3} \\\\ \\text{d}u & =4{x}^{3}\\,\\text{d}x \\\\ 8{x}^{3}\\,\\text{d}x & =2\\,\\text{d}u\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{4}+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 1 \\\\ \\hline u & 1 & 2 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}8{x}^{3}\\cdot {({x}^{4}+1)}^{2}\\,\\text{d}x={\\int }_{1}^{2}{u}^{2}\\cdot 2\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}2{u}^{2}\\,\\text{d}u & =2{\\int }_{1}^{2}{u}^{2}\\,\\text{d}u \\\\  & =2\\cdot {\\frac{{u}^{3}}{3}|}_{1}^{2} \\\\  & =\\frac{2}{3}({2}^{3}-{1}^{3}) \\\\  & =\\frac{2}{3}(8-1) \\\\  & =\\frac{2}{3}\\cdot 7 \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8da89d77-1592-5867-afc9-0e854876956d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186309870}] :answer-field/correct {:answer/id #uuid "8da89d77-1592-5867-afc9-0e854876956d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186309870} :answer-field/id #uuid "747bc3ec-1544-5340-9df4-cd7d1c816ade" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311110}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "da16783e-e9bc-5cc2-9dc4-b8a66d37273e" :question/math-academy-id "q-336783" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =9x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =9 \\\\ \\text{d}u & =9\\,\\text{d}x \\\\ \\frac{1}{9}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=9x+2.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\frac{1}{3} \\\\ \\hline u & 2 & 5 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x={\\int }_{2}^{5}{u}^{2}\\cdot \\frac{1}{9}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x & ={\\int }_{2}^{5}{u}^{2}\\cdot \\frac{1}{9}\\text{d}u \\\\  & =\\frac{1}{9}{\\int }_{2}^{5}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{9}\\cdot {\\frac{1}{3}{u}^{3}|}_{2}^{5} \\\\  & =\\frac{1}{9}\\cdot \\frac{1}{3}({5}^{3}-{2}^{3}) \\\\  & =\\frac{1}{27}(125-8) \\\\  & =\\frac{13}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d9d21b-e49b-5785-8251-699a31291db4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186309254}] :answer-field/correct {:answer/id #uuid "42d9d21b-e49b-5785-8251-699a31291db4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186309254} :answer-field/id #uuid "d0cbb9c8-7af9-5a18-b7e3-86c80e22c12b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311398}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2d539d21-0053-5fd3-a75f-95a9a795d1aa" :question/math-academy-id "q-336788" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x+2.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\frac{1}{2} \\\\ \\hline u & 2 & 4 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x={\\int }_{2}^{4}{u}^{3}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x & ={\\int }_{2}^{4}{u}^{3}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{2}^{4}{u}^{3}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot {\\frac{1}{4}{u}^{4}|}_{2}^{4} \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{4}({4}^{4}-{2}^{4}) \\\\  & =\\frac{1}{16}(256-16) \\\\  & =15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "772b0d3e-1e75-5862-97a5-994c0879c86d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{5}" :db/id #edb/ref 17592186309680}] :answer-field/correct {:answer/id #uuid "772b0d3e-1e75-5862-97a5-994c0879c86d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{5}" :db/id #edb/ref 17592186309680} :answer-field/id #uuid "f3cf7db0-2782-54ad-bdc6-04bf7b95a429" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311502}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "699740db-43f4-5820-a2ed-6b9467c27228" :question/math-academy-id "q-336803" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{3}}2x\\sqrt{{({x}^{2}+1)}^{3}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{2}+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\sqrt{3} \\\\ \\hline u & 1 & 4 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{\\sqrt{3}}\\sqrt{{({x}^{2}+1)}^{3}}\\cdot 2x\\,\\text{d}x={\\int }_{1}^{4}\\sqrt{{u}^{3}}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\sqrt{{u}^{3}}\\,\\text{d}u & ={\\int }_{1}^{4}{u}^{3/2}\\,\\text{d}u \\\\  & ={\\frac{2}{5}{u}^{5/2}|}_{1}^{4} \\\\  & =\\frac{2}{5}({4}^{5/2}-{1}^{5/2}) \\\\  & =\\frac{2}{5}(({2}^{2})^{5/2}-1) \\\\  & =\\frac{2}{5}({2}^{5}-1) \\\\  & =\\frac{62}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b6f02d-aa78-5ce7-a607-1389d7befb81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{52}{3}" :db/id #edb/ref 17592186309142}] :answer-field/correct {:answer/id #uuid "33b6f02d-aa78-5ce7-a607-1389d7befb81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{52}{3}" :db/id #edb/ref 17592186309142} :answer-field/id #uuid "a0555f9a-c619-5dba-932f-7a5f8149185e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311258}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "71d421dc-1ef1-554b-9d91-1ccfe24a307b" :question/math-academy-id "q-336804" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{0}^{2\\sqrt{2}}2x\\sqrt{{x}^{2}+1}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{2}+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 2\\sqrt{2} \\\\ \\hline u & 1 & 9 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2\\sqrt{2}}\\sqrt{{x}^{2}+1}\\cdot 2x\\,\\text{d}x={\\int }_{1}^{9}\\sqrt{u}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}\\sqrt{u}\\,\\text{d}u & ={\\int }_{1}^{9}{u}^{1/2}\\,\\text{d}u \\\\  & ={\\frac{2}{3}{u}^{3/2}|}_{1}^{9} \\\\  & =\\frac{2}{3}({9}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{2}{3}(({3}^{2})^{3/2}-1) \\\\  & =\\frac{2}{3}({3}^{3}-1) \\\\  & =\\frac{52}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46df47e1-4fd2-5e74-9802-30c7d71ec8fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{422}{25}" :db/id #edb/ref 17592186330587} {:answer/id #uuid "7ca2042a-b7db-5664-bcb3-7bcf6ce2185d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{25}" :db/id #edb/ref 17592186331048} {:answer/id #uuid "aac76cc2-a7d5-5aa3-b046-0863aacd9809" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{5}" :db/id #edb/ref 17592186331462} {:answer/id #uuid "d1c71de2-0ba0-5210-8c48-1c8d28840ba7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{484}{25}" :db/id #edb/ref 17592186331808} {:answer/id #uuid "f29fa433-a6b6-567c-9b83-dd78cdad5f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{96}{5}" :db/id #edb/ref 17592186332084}] :answer-field/correct {:answer/id #uuid "46df47e1-4fd2-5e74-9802-30c7d71ec8fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{422}{25}" :db/id #edb/ref 17592186330587} :answer-field/id #uuid "8440e1ec-085a-581e-8015-b19ea38f1533" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332432}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d5b21fd6-f10f-59da-bb75-6d859e96a1aa" :question/math-academy-id "q-49613" :question/problem "Evaluate the definite integral $$\n\\displaystyle {\\int }_{2}^{3}\\sqrt{{(5x-6)}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =5x-6 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =5 \\\\ \\text{d}u & =5\\,\\text{d}x \\\\ \\frac{1}{5}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=5x-6.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 2 & 3 \\\\ \\hline u & 4 & 9 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{2}^{3}\\sqrt{{(5x-6)}^{3}}\\,\\text{d}x={\\int }_{4}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{5}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{5}\\,\\text{d}u & =\\frac{1}{5}{\\int }_{4}^{9}{u}^{3/2}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{4}^{9} \\\\  & =\\frac{1}{5}\\cdot \\frac{2}{5}({9}^{5/2}-{4}^{5/2}) \\\\  & =\\frac{2}{25}(({3}^{2})^{5/2}-({2}^{2})^{5/2}) \\\\  & =\\frac{2}{25}({3}^{5}-{2}^{5}) \\\\  & =\\frac{2}{25}(243-32) \\\\  & =\\frac{422}{25}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455c1245-c286-51ee-8b71-5df8dd0ec3a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330575} {:answer/id #uuid "71fe6547-c7cf-54d3-bc02-4090b59215ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330974} {:answer/id #uuid "9d056934-52b2-5970-b8ce-f04c50502ec0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3})" :db/id #edb/ref 17592186331356} {:answer/id #uuid "b02c3a52-f4b9-5722-9302-2760583bc78e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3\\sqrt{3}+1)" :db/id #edb/ref 17592186331510} {:answer/id #uuid "d1587f6b-b870-5469-993d-ac5199f2ca89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{7}-1)" :db/id #edb/ref 17592186331805}] :answer-field/correct {:answer/id #uuid "71fe6547-c7cf-54d3-bc02-4090b59215ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}(3\\sqrt{3}-1)" :db/id #edb/ref 17592186330974} :answer-field/id #uuid "872a381f-94df-5ea3-9ade-45bc07d0d4ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332437}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "51462d31-1f9f-535d-b34a-3d3333f0fc53" :question/math-academy-id "q-49622" :question/problem "Evaluate the definite integral $$\n\\displaystyle {\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =8x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =8 \\\\ \\text{d}u & =8\\,\\text{d}x \\\\ \\frac{1}{8}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=8x+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & \\frac{1}{4} \\\\ \\hline u & 1 & 3 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x={\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u & =\\frac{1}{8}{\\int }_{1}^{3}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{8}\\cdot {\\frac{2}{3}{u}^{3/2}|}_{1}^{3} \\\\  & =\\frac{1}{8}\\cdot \\frac{2}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{1}{12}({({3}^{3})}^{1/2}-1) \\\\  & =\\frac{1}{12}(3\\sqrt{3}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49788f89-f4b9-57a4-81f3-fc6af6cb4308" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186579806} {:answer/id #uuid "aaf556fe-7d29-5c91-b5de-ee7a548300c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{243}{5}" :db/id #edb/ref 17592186579967} {:answer/id #uuid "cb5ac1c6-5452-5981-8c7a-2ed1d2d86920" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186580018} {:answer/id #uuid "ef32d425-3e1d-5281-81ea-507eb1d1e90c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{243}{10}" :db/id #edb/ref 17592186580089} {:answer/id #uuid "fb2a13a2-2e01-5c4b-9a43-345d0d260ed6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{121}{5}" :db/id #edb/ref 17592186580113}] :answer-field/correct {:answer/id #uuid "fb2a13a2-2e01-5c4b-9a43-345d0d260ed6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{121}{5}" :db/id #edb/ref 17592186580113} :answer-field/id #uuid "6bb1526e-fa6d-5ccb-99ca-7b2fbe4b22c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580154}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "50d57b5d-c643-5a59-b83e-53fccd71ff63" :question/math-academy-id "q-49614" :question/problem "Evaluate the definite integral $$\n\\displaystyle {\\int }_{0}^{2}\\sqrt{{(4x+1)}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 2 \\\\ \\hline u & 1 & 9 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\sqrt{{(4x+1)}^{3}}\\,\\text{d}x={\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{4}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{4}\\,\\text{d}u & =\\frac{1}{4}{\\int }_{1}^{9}{u}^{3/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{1}^{9} \\\\  & =\\frac{1}{4}\\cdot \\frac{2}{5}({9}^{5/2}-{1}^{5/2}) \\\\  & =\\frac{1}{10}(({3}^{2})^{5/2}-1) \\\\  & =\\frac{1}{10}({3}^{5}-1) \\\\  & =\\frac{1}{10}(243-1) \\\\  & =\\frac{242}{10} \\\\  & =\\frac{121}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124a5197-e018-5fa1-b5ed-b97a2d1f0ca3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186579707} {:answer/id #uuid "81fdc34d-d76c-585d-a63f-85fa47719702" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{15}" :db/id #edb/ref 17592186579898} {:answer/id #uuid "82466636-41eb-59c3-b274-03d25c6d5963" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{15}" :db/id #edb/ref 17592186579899} {:answer/id #uuid "a7ca8509-5569-51d5-a832-e6373c8b5128" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186579963} {:answer/id #uuid "f3cdb716-d7a4-572f-917a-f7330199ecf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186580098}] :answer-field/correct {:answer/id #uuid "81fdc34d-d76c-585d-a63f-85fa47719702" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{15}" :db/id #edb/ref 17592186579898} :answer-field/id #uuid "862e5b4f-5134-5b8c-8e40-1cedf29b04a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580169}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e483fd07-3d6b-5f84-9535-4229c6c62ad9" :question/math-academy-id "q-17102" :question/problem "Evaluate the definite integral $$\n\\displaystyle {\\int }_{0}^{1}\\sqrt{{(3x+1)}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =3x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3 \\\\ \\text{d}u & =3\\,\\text{d}x \\\\ \\frac{1}{3}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=3x+1.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & 0 & 1 \\\\ \\hline u & 1 & 4 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\sqrt{{(3x+1)}^{3}}\\,\\text{d}x={\\int }_{1}^{4}\\sqrt{{u}^{3}}\\cdot \\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\sqrt{{u}^{3}}\\cdot \\frac{1}{3}\\text{d}u & =\\frac{1}{3}{\\int }_{1}^{4}{u}^{3/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{1}^{4} \\\\  & =\\frac{1}{3}\\cdot \\frac{2}{5}({4}^{5/2}-{1}^{5/2}) \\\\  & =\\frac{2}{15}(({2}^{2})^{5/2}-1) \\\\  & =\\frac{2}{15}({2}^{5}-1) \\\\  & =\\frac{2}{15}(32-1) \\\\  & =\\frac{62}{15}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186650336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc315a5-73e1-5920-8414-4b3afc2e4cf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186650033}] :answer-field/correct {:answer/id #uuid "2bc315a5-73e1-5920-8414-4b3afc2e4cf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{7}" :db/id #edb/ref 17592186650033} :answer-field/id #uuid "690af8c0-aeab-5ca0-9587-5a8b4153e864" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186650262}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ab6e5877-7dc3-5ec8-af08-4b2eef6d3c11" :question/math-academy-id "q-336602" :question/problem "Compute the exact value of the definite integral.\n\n$$\n\\displaystyle {\\int }_{-2/7}^{1/7}\\sqrt{14x+4}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =14x+4 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =14 \\\\ \\text{d}u & =14\\,\\text{d}x \\\\ \\frac{1}{14}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=14x+4.$\n\n$$\n\\begin{array}{|c|c|c|}\\hline x & -\\frac{2}{7} & \\frac{1}{7} \\\\ \\hline u & 0 & 6 \\\\ \\hline\\end{array}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{-2/7}^{1/7}\\sqrt{14x+4}\\,\\text{d}x={\\int }_{0}^{6}\\sqrt{u}\\,\\cdot \\frac{1}{14}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}\\sqrt{u}\\,\\cdot \\frac{1}{14}\\,\\text{d}u & =\\frac{1}{14}{\\int }_{0}^{6}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{14}\\cdot {\\frac{2}{3}{u}^{3/2}|}_{0}^{6} \\\\  & =\\frac{1}{14}\\cdot \\frac{2}{3}({6}^{3/2}-{0}^{3/2}) \\\\  & =\\frac{1}{21}(({6}^{3})^{1/2}-0) \\\\  & =\\frac{1}{21}\\cdot 6\\sqrt{6} \\\\  & =\\frac{2\\sqrt{6}}{7}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Definite Integral of Function Using Substitution"}]}
