value "-\\frac{4}{15}" :db/id #edb/ref 17592186061193}] :answer-field/correct {:answer/id #uuid "6ca0f78d-1bc7-59a2-9ac0-7f822a56a9fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{15}" :db/id #edb/ref 17592186061193} :answer-field/id #uuid "2e7252c6-0f89-5144-8e64-8a0780e8107d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061188}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "73f175e7-2f1a-5340-97b3-b6e69ba4df75" :question/math-academy-id "q-12910" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{-1/3}^{0}9x\\sqrt{3x+1}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=3x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{3}(u-1).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1/3$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $1$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}9x\\sqrt{3x+1}\\,\\text{d}x & =9{\\int }_{-1/3}^{0}\\frac{u-1}{3}\\cdot \\sqrt{u}\\cdot \\frac{1}{3}\\text{d}u \\\\  & ={\\int }_{0}^{1}({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & ={(\\frac{1}{5/2}{u}^{5/2}-\\frac{1}{3/2}{u}^{3/2})|}_{0}^{1} \\\\  & ={(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})|}_{0}^{1} \\\\  & =(\\frac{2}{5}\\cdot {1}^{5/2}-\\frac{2}{3}\\cdot {1}^{3/2})-(\\frac{2}{5}\\cdot {0}^{5/2}-\\frac{2}{3}\\cdot {0}^{3/2}) \\\\  & =\\frac{2}{5}-\\frac{2}{3} \\\\  & =-\\frac{4}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ffd13b6-ea9b-58cb-a89b-c5f8a9264f6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186263565} {:answer/id #uuid "59964896-d18f-5204-b6b4-44487674368e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186263772} {:answer/id #uuid "ac53c6d7-2cca-5751-be18-8b38b141d546" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{32}{5}" :db/id #edb/ref 17592186264481} {:answer/id #uuid "de79243c-3a69-5bea-a43c-56750fff8b81" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186264932} {:answer/id #uuid "ef4f0f80-e65c-5257-b2b7-26de7d191567" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{72}{5}" :db/id #edb/ref 17592186265100}] :answer-field/correct {:answer/id #uuid "de79243c-3a69-5bea-a43c-56750fff8b81" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186264932} :answer-field/id #uuid "6ad20c4e-67c2-5940-9f8e-2073856fa1e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "69ab2a48-2191-5716-80d5-fc677ca5b318" :question/math-academy-id "q-13191" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{-2}^{0}x{(x+2)}^{3}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-2.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $-2$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{(x+2)}^{3}\\,\\text{d}x & ={\\int }_{0}^{2}(u-2){u}^{3}\\,\\text{d}u \\\\  & ={\\int }_{0}^{2}({u}^{4}-2{u}^{3})\\,\\text{d}u \\\\  & ={(\\frac{1}{5}{u}^{5}-2\\cdot \\frac{1}{4}{u}^{4})|}_{0}^{2} \\\\  & ={(\\frac{1}{5}{u}^{5}-\\frac{1}{2}{u}^{4})|}_{0}^{2} \\\\  & =\\frac{1}{5}({2}^{5}-{0}^{5})-\\frac{1}{2}({2}^{4}-{0}^{4}) \\\\  & =\\frac{1}{5}(32-0)-\\frac{1}{2}(16-0) \\\\  & =\\frac{32}{5}-8 \\\\  & =-\\frac{8}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b49dffc-ef34-51f9-880f-343a17e7f464" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{11}}}{7}" :db/id #edb/ref 17592186282461} {:answer/id #uuid "8972d08b-477b-5df8-8798-490e031cacfc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{{2}^{7}}}{35}" :db/id #edb/ref 17592186282876} {:answer/id #uuid "a2129991-a47b-5a82-ac7c-8e1ca3a89e30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{11}}}{35}" :db/id #edb/ref 17592186283104} {:answer/id #uuid "b46333d5-37ec-5aa4-b7d2-c43db38be685" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{{2}^{9}}}{7}" :db/id #edb/ref 17592186283251} {:answer/id #uuid "c63d1f0f-ee09-585f-b726-ba8a97ddf0c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{9}}}{35}" :db/id #edb/ref 17592186283415}] :answer-field/correct {:answer/id #uuid "a2129991-a47b-5a82-ac7c-8e1ca3a89e30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{11}}}{35}" :db/id #edb/ref 17592186283104} :answer-field/id #uuid "54febd29-2fe4-5926-8377-9b3e1c741602" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284074}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "abf52321-10d1-5a8b-a0a2-2f3814ff9431" :question/math-academy-id "q-17045" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=2-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that $x=2-u.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $2$ | $0$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x & ={\\int }_{0}^{2}x{(2-x)}^{3/2}\\,\\text{d}x \\\\  & ={\\int }_{2}^{0}(2-u){u}^{3/2}(-\\text{d}u) \\\\  & ={\\int }_{2}^{0}(u-2){u}^{3/2}\\,\\text{d}u \\\\  & ={\\int }_{2}^{0}({u}^{5/2}-2{u}^{3/2})\\,\\text{d}u \\\\  & ={(\\frac{2}{7}{u}^{7/2}-2\\cdot \\frac{2}{5}{u}^{5/2})|}_{2}^{0} \\\\  & ={(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2})|}_{2}^{0} \\\\  & =\\frac{2}{7}({0}^{7/2}-{2}^{7/2})-\\frac{4}{5}({0}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{{2}^{9/2}}{7}+\\frac{{2}^{9/2}}{5} \\\\  & =\\frac{{2}^{11/2}}{35} \\\\  & =\\frac{\\sqrt{{2}^{11}}}{35}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d4fb092-4b4b-5222-a34c-724a53131d37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{112}{15}" :db/id #edb/ref 17592186317820}] :answer-field/correct {:answer/id #uuid "4d4fb092-4b4b-5222-a34c-724a53131d37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{112}{15}" :db/id #edb/ref 17592186317820} :answer-field/id #uuid "7fc3e3bf-4990-5b89-bf6a-9355ad43fa17" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318699}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7fd825e3-0d14-5ed8-a4b9-9f4979a0fb9f" :question/math-academy-id "q-346390" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-1/2}^{3/2}4x\\sqrt{2x+1}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=2x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{2}(u-1).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1/2$ | $3/2$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $4$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1/2}^{3/2}4x\\sqrt{2x+1}\\,\\text{d}x & ={\\int }_{0}^{4}4\\cdot \\frac{1}{2}(u-1)\\cdot \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & ={\\int }_{0}^{4}({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & ={(\\frac{1}{(5/2)}{u}^{5/2}-\\frac{1}{(3/2)}{u}^{3/2})|}_{0}^{4} \\\\  & ={(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})|}_{0}^{4} \\\\  & =(\\frac{2}{5}\\cdot {4}^{5/2}-\\frac{2}{3}\\cdot {4}^{3/2})-(\\frac{2}{5}\\cdot {0}^{5/2}-\\frac{2}{3}\\cdot {0}^{3/2}) \\\\  & =\\frac{64}{5}-\\frac{16}{3} \\\\  & =\\frac{112}{15}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c14e0f54-e96d-5872-93bf-ea86a07ecf2e" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186318206}] :answer-field/correct {:answer/id #uuid "c14e0f54-e96d-5872-93bf-ea86a07ecf2e" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186318206} :answer-field/id #uuid "526aef95-e8d0-5c8b-bd07-14ed0e710e6f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318600}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "11e654cd-30e9-5558-8788-bee1abdebb50" :question/math-academy-id "q-346393" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{6}\\frac{3x+1}{\\sqrt{x+3}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=x+3.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-3.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $6$ |\n| --- | --- | --- |\n| **$u$** | $4$ | $9$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}\\frac{3x+1}{\\sqrt{x+3}}\\,\\text{d}x & ={\\int }_{4}^{9}\\frac{3(u-3)+1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{9}\\frac{3u-8}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{9}(3{u}^{1/2}-8{u}^{-1/2})\\,\\text{d}u \\\\  & ={(\\frac{3}{(3/2)}{u}^{3/2}-\\frac{8}{(1/2)}{u}^{1/2})|}_{4}^{9} \\\\  & ={(2{u}^{3/2}-16{u}^{1/2})|}_{4}^{9} \\\\  & =(2\\cdot {9}^{3/2}-16\\cdot {9}^{1/2})-(2\\cdot {4}^{3/2}-16\\cdot {4}^{1/2}) \\\\  & =(2\\cdot 27-16\\cdot 3)-(2\\cdot 8-16\\cdot 2) \\\\  & =(54-48)-(16-32) \\\\  & =6-(-16) \\\\  & =22\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea0640d9-c3e5-5ddf-9df9-feeb259286d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186318345}] :answer-field/correct {:answer/id #uuid "ea0640d9-c3e5-5ddf-9df9-feeb259286d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186318345} :answer-field/id #uuid "6b191dcb-cda9-53a5-951a-047fd95e08bd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318657}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03e05686-97cf-5c15-b403-a4caf1953954" :question/math-academy-id "q-348275" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-1}^{1/3}\\frac{7}{4}x\\sqrt[3]{6x+6}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u=6x+6.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{6}(u-6).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1$ | $1/3$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $8$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1/3}\\frac{7}{4}x\\sqrt[3]{6x+6}\\,\\text{d}x & ={\\int }_{0}^{8}\\frac{7}{4}\\cdot \\frac{1}{6}(u-6)\\cdot {u}^{1/3}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{7}{144}{\\int }_{0}^{8}({u}^{4/3}-6{u}^{1/3})\\,\\text{d}u \\\\  & =\\frac{7}{144}{(\\frac{1}{(7/3)}{u}^{7/3}-6\\cdot \\frac{1}{(4/3)}{u}^{4/3})|}_{0}^{8} \\\\  & =\\frac{7}{144}{(\\frac{3}{7}{u}^{7/3}-\\frac{9}{2}{u}^{4/3})|}_{0}^{8} \\\\  & =\\frac{7}{144}[(\\frac{3}{7}\\cdot {8}^{7/3}-\\frac{9}{2}\\cdot {8}^{4/3})-(\\frac{3}{7}\\cdot {0}^{7/3}-\\frac{9}{2}\\cdot {0}^{4/3})] \\\\  & =\\frac{7}{144}(\\frac{384}{7}-72) \\\\  & =\\frac{7}{144}\\cdot \\left(-\\frac{120}{7}\\right) \\\\  & =-\\frac{5}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "730ade57-923a-5b77-b9d1-e09ab5c9256d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186317960}] :answer-field/correct {:answer/id #uuid "730ade57-923a-5b77-b9d1-e09ab5c9256d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186317960} :answer-field/id #uuid "acfb67b2-49ba-5e80-bd44-691f651b8f48" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318797}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4037d146-183a-5606-a4b5-d0636799ff9e" :question/math-academy-id "q-348282" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-3}^{-2}\\frac{48(x+2)}{{({x}^{2}+4x)}^{3}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u={x}^{2}+4x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x+4\\,⟹\\,2(x+2)\\,\\text{d}x=\\text{d}u.\n$$\n\nComputing our limits of integration, we get\n\n| **$x$** | $-3$ | $-2$ |\n| --- | --- | --- |\n| **$u$** | $-3$ | $-4$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-2}\\frac{48(x+2)}{{({x}^{2}+4x)}^{3}}\\,\\text{d}x & =24{\\int }_{-3}^{-2}\\frac{1}{{({x}^{2}+4x)}^{3}}\\cdot 2(x+2)\\,\\text{d}x \\\\  & =24{\\int }_{-3}^{-4}\\frac{1}{{u}^{3}}\\,\\text{d}u \\\\  & =24{\\int }_{-3}^{-4}{u}^{-3}\\,\\text{d}u \\\\  & =24\\cdot {(-\\frac{1}{2}{u}^{-2})|}_{-3}^{-4} \\\\  & ={\\left(-\\frac{12}{{u}^{2}}\\right)|}_{-3}^{-4} \\\\  & =-\\frac{12}{(-4)^{2}}-\\left(-\\frac{12}{(-3)^{2}}\\right) \\\\  & =-\\frac{12}{16}-\\left(-\\frac{12}{9}\\right) \\\\  & =-\\frac{3}{4}+\\frac{4}{3} \\\\  & =\\frac{7}{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99be5e4f-a330-5237-9aa1-2288b56102b3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}(2)-1" :db/id #edb/ref 17592186318091}] :answer-field/correct {:answer/id #uuid "99be5e4f-a330-5237-9aa1-2288b56102b3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}(2)-1" :db/id #edb/ref 17592186318091} :answer-field/id #uuid "32768bdd-f28f-51ab-bf18-de06146d3a9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318530}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3f15199a-7d19-5480-bc32-7ebe9a4b45db" :question/math-academy-id "q-348289" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "Let $u={x}^{3}+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,3{x}^{2}\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that ${x}^{3}=u-1.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2{x}^{3}}{({x}^{3}+1)^{2}}\\cdot 3{x}^{2}\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{2(u-1)}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{2}(\\frac{2}{u}-\\frac{2}{{u}^{2}})\\,\\text{d}u \\\\  & ={(2\\operatorname{ln}⁡|u|+\\frac{2}{u})|}_{1}^{2} \\\\  & =(2\\operatorname{ln}⁡(2)+\\frac{2}{2})-(2\\operatorname{ln}⁡(1)+2) \\\\  & =2\\operatorname{ln}⁡(2)-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d32797f-9d7a-5b52-8960-235626e6cc66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{5}({u}^{1/2}+{u}^{-1/2})\\text{d}u" :db/id #edb/ref 17592186330067} {:answer/id #uuid "16e90fc0-413f-571e-9234-9c9d29c6bffe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{3}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186330146} {:answer/id #uuid "7c647bff-6963-5d64-a559-cc69b3e75a2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{3}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186331044} {:answer/id #uuid "ed05fcfb-bb70-599b-838c-5723fd5d7864" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186332028} {:answer/id #uuid "f80a4b5a-7c6a-584d-ab83-e74c1159cbd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186332129}] :answer-field/correct {:answer/id #uuid "ed05fcfb-bb70-599b-838c-5723fd5d7864" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186332028} :answer-field/id #uuid "c96e4fa0-68d1-58eb-a210-73f341888124" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332553}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2063239-3a6f-54f6-9552-f4b8aed0756c" :question/math-academy-id "q-49529" :question/problem "Given that $u=2x-1$, which integral is equivalent to $$\n\\displaystyle {\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x?\n$$" :question/worked-solution "Since $u=2x-1$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+1}{2}.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $3$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $5$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x & ={\\int }_{1}^{5}\\frac{u+1}{2}\\cdot \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}(u+1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c6f716-0519-5fb1-93a4-786d28bac131" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{0}^{2}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186330143} {:answer/id #uuid "4927607f-0369-52dc-b543-e723b2461ade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186330607} {:answer/id #uuid "78d07609-2e7d-54a9-9741-9a2935bac1f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{-3}^{7}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186331024} {:answer/id #uuid "803c71e2-8b94-5e22-89ed-0d745090a6b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{0}^{2}({u}^{1/2}-3{u}^{-1/2})\\text{d}u" :db/id #edb/ref 17592186331085} {:answer/id #uuid "c64bac8c-74bb-582b-b441-399c56ded0cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186331707}] :answer-field/correct {:answer/id #uuid "4927607f-0369-52dc-b543-e723b2461ade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186330607} :answer-field/id #uuid "411bfdcb-0f1c-547f-8af9-002c23966f87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332310}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86923e84-3824-5605-bba1-058782ecab5b" :question/math-academy-id "q-49533" :question/problem "Given that $u=5x-3$, which integral is equivalent to $$\n\\displaystyle {\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x?\n$$" :question/worked-solution "Since $u=5x-3$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+3}{5}.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $-3$ | $7$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x & ={\\int }_{-3}^{7}\\frac{u+3}{5}\\cdot \\sqrt{u}\\cdot \\frac{1}{5}\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}(u+3){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4025429-6e17-5c14-a483-024d71ec6616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{-1}^{0}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392691} {:answer/id #uuid "906bbb28-e4b5-5434-be5a-c275368e56e8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{0}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392692} {:answer/id #uuid "9bb1e0bc-fcd0-5a9a-a1c2-f002323abc31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392693} {:answer/id #uuid "1b5df1c7-ea7d-5d47-a8d0-092ad3a409bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392694} {:answer/id #uuid "d0d7aa84-cc44-5f47-a62a-eef3f56d5530" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392695}] :answer-field/correct {:answer/id #uuid "1b5df1c7-ea7d-5d47-a8d0-092ad3a409bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186392694} :answer-field/id #uuid "1a3d3edd-4727-5c6c-b8de-2aa598d8b805" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392690}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1acd046b-858c-598a-a588-48bb2b8b4ced" :question/math-academy-id "q-49532" :question/problem "Given that $u=3-2{x}^{2}$, which integral is equivalent to $$\n\\displaystyle {\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x?\n$$" :question/worked-solution "Since $u=3-2{x}^{2}$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4x\\,⟹\\,-\\frac{\\text{d}u}{4}=x\\text{d}x.\n$$\n\nWe also note that ${x}^{2}=\\frac{1}{2}(3-u).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $3$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x & ={\\int }_{-1}^{0}{x}^{2}\\sqrt{3-2{x}^{2}}\\cdot x\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{2}(3-u)\\sqrt{u}\\cdot \\left(-\\frac{\\text{d}u}{4}\\right) \\\\  & =-\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u\\end{aligned}\n$$"} {:db/id #edb/ref 17592186528003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a76db44-e626-54e3-bb32-fdade55a01be" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186527402} {:answer/id #uuid "35321656-4bd6-5396-805d-37ad3b680477" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186527416} {:answer/id #uuid "719b0fe5-3c99-5cac-84f5-1fc289687dce" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}-1" :db/id #edb/ref 17592186527521} {:answer/id #uuid "c50c3670-73c7-5cc3-9ccf-673bb3533570" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186527701} {:answer/id #uuid "c52c231c-1dfb-55b4-9960-d0a4177ddef9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186527702}] :answer-field/correct {:answer/id #uuid "2a76db44-e626-54e3-bb32-fdade55a01be" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186527402} :answer-field/id #uuid "eb85d00d-c4fb-5b35-911e-a717db9a9969" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527901}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "dc80cc6c-733b-50ec-85a0-e9f5b6f29bef" :question/math-academy-id "q-73332" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{1}^{2}x\\sqrt{{x}^{2}-1}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u={x}^{2}-1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,x\\text{d}x=\\frac{\\text{d}u}{2}.\n$$\n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $3$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}x\\sqrt{{x}^{2}-1}\\,\\text{d}x & ={\\int }_{1}^{2}\\sqrt{{x}^{2}-1}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{3}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\left(\\frac{2{u}^{3/2}}{3}\\right)|}_{0}^{3} \\\\  & ={\\frac{{u}^{3/2}}{3}|}_{0}^{3} \\\\  & =\\frac{{3}^{3/2}}{3}-\\frac{{0}^{3/2}}{3} \\\\  & =\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186532723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380d9a49-c6d8-5c6c-aad5-cf5792818606" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{39}{10}" :db/id #edb/ref 17592186532046} {:answer/id #uuid "55366fad-0795-57d6-85e8-4f68957d0932" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186532117} {:answer/id #uuid "5ce8cb92-d753-507f-8961-5d82ee267410" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{10}" :db/id #edb/ref 17592186532136} {:answer/id #uuid "88a10e65-44ad-55c3-b17c-5d31a83466d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186532244} {:answer/id #uuid "be4996ff-8496-533e-9142-f9c34a17d2a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{61}{10}" :db/id #edb/ref 17592186532342}] :answer-field/correct {:answer/id #uuid "5ce8cb92-d753-507f-8961-5d82ee267410" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{10}" :db/id #edb/ref 17592186532136} :answer-field/id #uuid "ff7568f3-47d5-56fb-a003-0872e000e58b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532619}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "faa87228-4c67-51da-9af8-97fb8de0d515" :question/math-academy-id "q-13190" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{1}x{(1+x)}^{4}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=1+x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-1.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{(1+x)}^{4}\\,\\text{d}x & ={\\int }_{1}^{2}(u-1){u}^{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{2}({u}^{5}-{u}^{4})\\,\\text{d}u \\\\  & ={(\\frac{1}{6}{u}^{6}-\\frac{1}{5}{u}^{5})|}_{1}^{2} \\\\  & =\\frac{1}{6}({2}^{6}-{1}^{6})-\\frac{1}{5}({2}^{5}-{1}^{5}) \\\\  & =\\frac{1}{6}(64-1)-\\frac{1}{5}(32-1) \\\\  & =\\frac{63}{6}-\\frac{31}{5} \\\\  & =\\frac{21}{2}-\\frac{31}{5} \\\\  & =\\frac{43}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26b8f3b6-b20d-59c2-a2d4-b9d80bbaf8da" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186628051} {:answer/id #uuid "36db3bf7-8e5b-5439-a350-ae3bda9e88ab" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186628066} {:answer/id #uuid "b08ec968-3f92-5220-8cc9-2e509449c8d1" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186628234} {:answer/id #uuid "c628174f-5bc4-53a7-9db8-cc0b03a897e0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186628263} {:answer/id #uuid "c8a4be86-8bd4-5b99-b260-62620c9ff847" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186628269}] :answer-field/correct {:answer/id #uuid "c8a4be86-8bd4-5b99-b260-62620c9ff847" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186628269} :answer-field/id #uuid "a2a0a21f-29b1-500a-82e0-7213d9b21245" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628398}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a346ce59-dc42-5dc3-b891-80107ced0f82" :question/math-academy-id "q-73330" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{3}\\frac{3(x+2)}{\\sqrt{x+1}}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x+2=u+1.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $3$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $4$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{3(x+2)}{\\sqrt{x+1}}\\,\\text{d}x & =3{\\int }_{1}^{4}\\frac{u+1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3{\\int }_{1}^{4}(\\sqrt{u}+\\frac{1}{\\sqrt{u}})\\text{d}u \\\\  & =3{\\int }_{1}^{4}({u}^{1/2}+{u}^{-1/2})\\text{d}u \\\\  & =3{(\\frac{2{u}^{3/2}}{3}+2{u}^{1/2})|}_{1}^{4} \\\\  & ={(2\\sqrt{{u}^{3}}+6\\sqrt{u})|}_{1}^{4} \\\\  & =(2\\cdot \\sqrt{{4}^{3}}+6\\sqrt{4})-(2\\cdot \\sqrt{{1}^{3}}+6\\sqrt{1}) \\\\  & =(16+12)-(2+6) \\\\  & =20\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Definite Integrals of Algebraic Functions Using Substitution"}]}
