#{[{:db/id #edb/ref 17592186096841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096400 :question/id #uuid "19bf8d06-cbcc-547b-b882-ac89cd39fd1a" :question/math-academy-id "e-181" :question/problem "Given that $f(x) = (3x^4+x^3)^5,$ calculate $\\dfrac {\\textrm{d}f} {\\textrm{d}x}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf = g^5, \\qquad g = 3x^4+x^3\n$$\n\nThe chain rule states that\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}x} = \\dfrac {\\textrm{d}f} {\\textrm{d}g} \\cdot \\dfrac {\\textrm{d}g} {\\textrm{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}g}  = 5g^4,\n$$\n\nand\n\n$$\n\\dfrac {\\textrm{d}g} {\\textrm{d}x} = 12x^3 + 3x^2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =5{g}^{4}\\cdot (12{x}^{3}+3{x}^{2}) \\\\  & =5(3{x}^{4}+{x}^{3})^{4}(12{x}^{3}+3{x}^{2}).\\end{aligned}\n$$"} :knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/id #uuid "cd2e9db4-6727-5887-90bc-20eb0a0bf6d2" :topic/knowledge-points [{:db/id #edb/ref 17592186059862} {:db/id #edb/ref 17592186059863} {:db/id #edb/ref 17592186059864} {:db/id #edb/ref 17592186059865}] :topic/math-academy-id 278 :topic/next [{:db/id #edb/ref 17592186048442} {:db/id #edb/ref 17592186050711}] :topic/title "The Sum and Constant Multiple Rules for Differentiation"} {:db/id #edb/ref 17592186049317 :topic/id #uuid "ebb1ef31-5cab-5892-affd-92e347cc4f35" :topic/knowledge-points [{:db/id #edb/ref 17592186184340} {:db/id #edb/ref 17592186184341} {:db/id #edb/ref 17592186184342} {:db/id #edb/ref 17592186184343}] :topic/math-academy-id 3817 :topic/next [{:db/id #edb/ref 17592186048440} {:db/id #edb/ref 17592186048494} {:db/id #edb/ref 17592186048988} {:db/id #edb/ref 17592186049362} {:db/id #edb/ref 17592186049873} {:db/id #edb/ref 17592186050223} {:db/id #edb/ref 17592186050370} {:db/id #edb/ref 17592186050867}] :topic/title "Describing Function Composition"} {:db/id #edb/ref 17592186050644 :topic/difficulty 1.0054125078076268 :topic/id #uuid "5beaefa1-1d02-51a5-90bc-250adca28a57" :topic/knowledge-points [{:db/id #edb/ref 17592186092382} {:db/id #edb/ref 17592186092383}] :topic/math-academy-id 986 :topic/next [{:db/id #edb/ref 17592186049119} {:db/id #edb/ref 17592186049248} {:db/id #edb/ref 17592186050420} {:db/id #edb/ref 17592186051084}] :topic/title "Calculating the Equation of a Tangent Line Using Differentiation"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186676107 :question-generator/id #uuid "a7d66944-dfa7-5a71-8ebb-ba2df9b9337d" :question-generator/script "generators/9c/9ca83a8f4bc1bc146ddd87df692449dcd1719c7cd0008cf3bce571741e2a0d12/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85752216-72d1-52c5-a307-1f7593bb2baa" :answer/type {:db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3)" :db/id #edb/ref 17592186095425} {:answer/id #uuid "bffd2b2f-d555-5e17-8756-8a754febf526" :answer/type {:db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3x)" :db/id #edb/ref 17592186095426} {:answer/id #uuid "eef892e3-6947-592f-9345-311b595e0536" :answer/type {:db/ident :answer.type/math} :answer/value "2(4x^{3})(x^{4} + 3x)" :db/id #edb/ref 17592186095427} {:answer/id #uuid "05327ffd-b783-558f-8116-edad45453171" :answer/type {:db/ident :answer.type/math} :answer/value "2(4x^{3})(x^{4} + 3x)^{2}" :db/id #edb/ref 17592186095428} {:answer/id #uuid "62baa9f7-a4b9-5ff4-84f6-37fdf189f3fa" :answer/type {:db/ident :answer.type/math} :answer/value "2(x^{4} + 3x)(4x^{3} + 3)^{2}" :db/id #edb/ref 17592186095429}] :answer-field/id #uuid "a72fa786-3004-51a5-a233-17a9a216dfb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095424}] :question/id #uuid "b551e489-4c37-53ea-831b-8f3ca007450b" :question/math-academy-id "q-48625" :question/problem "Find $\\frac{df}{dx}$ when $f(x) = (x^{4} + 3x)^{2}$."} {:db/id #edb/ref 17592186097325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2e9e80-9009-5c4d-8418-53807b048413" :answer/type {:db/ident :answer.type/math} :answer/value "18(4+6x{)}^{2}" :db/id #edb/ref 17592186333097} {:answer/id #uuid "2f451149-34e3-5874-ac22-67e5f7f806cc" :answer/type {:db/ident :answer.type/math} :answer/value "18x(4+6x{)}^{2}" :db/id #edb/ref 17592186333429} {:answer/id #uuid "ac1f9842-ca0a-55db-bcb6-06735b728dba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+6x{)}^{2}}{2}" :db/id #edb/ref 17592186334496} {:answer/id #uuid "b1df2cc8-3e8e-59c7-a92f-f4f573b06622" :answer/type {:db/ident :answer.type/math} :answer/value "3(4+6x{)}^{2}" :db/id #edb/ref 17592186334551} {:answer/id #uuid "d848947b-033e-583b-9707-793c5c4bf6dc" :answer/type {:db/ident :answer.type/math} :answer/value "30(4+6x{)}^{4}" :db/id #edb/ref 17592186334883}] :answer-field/correct {:answer/id #uuid "0c2e9e80-9009-5c4d-8418-53807b048413" :answer/type {:db/ident :answer.type/math} :answer/value "18(4+6x{)}^{2}" :db/id #edb/ref 17592186333097} :answer-field/id #uuid "564e943b-61e3-5dd9-b71b-ad37ff586952" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335411}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f0bd56a8-5c99-5166-be8e-4185bfb62ed5" :question/math-academy-id "q-666" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(4+6x{)}^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{3},\\,g=4+6x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3{g}^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =3\\cdot 6\\cdot (4+6x{)}^{2} \\\\  & =18(4+6x{)}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182d03f6-7007-5d30-9f41-468940bf1b5d" :answer/type {:db/ident :answer.type/math} :answer/value "8t(2{t}^{2}+3)" :db/id #edb/ref 17592186234577}] :answer-field/correct {:answer/id #uuid "182d03f6-7007-5d30-9f41-468940bf1b5d" :answer/type {:db/ident :answer.type/math} :answer/value "8t(2{t}^{2}+3)" :db/id #edb/ref 17592186234577} :answer-field/id #uuid "88d80e90-19de-5aa6-bcad-6a5bb1a4fd17" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235141}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f760aed-6b31-5953-b3f9-00dcac8b3038" :question/math-academy-id "q-132974" :question/problem "$\\frac{\\text{d}}{\\text{d}t}[(2{t}^{2}+3)^{2}]=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "First, let's define a function $h(t):$\n\n$$\nh(t)=(2{t}^{2}+3)^{2}\n$$\n\nTo differentiate this function, we use the chain rule. Let \n\n$$\ng(t)=2{t}^{2}+3,\\,h(g(t))=g(t)^{2}.\n$$\n\nDifferentiating our functions, we have\n\n$$\n\\begin{aligned}{g}^{′}(t) & =(2{t}^{2}+3)^{′}=4t, \\\\ {h}^{′}(g(t)) & =({g}^{2})^{′}=2g.\\end{aligned}\n$$\n\nThen, using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[(2{t}^{2}+3)^{2}] & ={h}^{′}(t) \\\\  & ={h}^{′}(g(t))\\cdot {g}^{′}(t) \\\\  & =2g\\cdot 4t \\\\  & =8t(2{t}^{2}+3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "147b8607-00ab-583f-9d29-c36db3ffb93e" :answer/type {:db/ident :answer.type/math} :answer/value "30{(5x+10)}^{5}" :db/id #edb/ref 17592186247609} {:answer/id #uuid "8b9923c0-68fb-5db2-a270-b22a0a565a94" :answer/type {:db/ident :answer.type/math} :answer/value "30{(5x+10)}^{6}" :db/id #edb/ref 17592186248673} {:answer/id #uuid "b955e3b8-b464-5b10-97ae-eea2d8b024ff" :answer/type {:db/ident :answer.type/math} :answer/value "5{(5x+10)}^{5}" :db/id #edb/ref 17592186249080} {:answer/id #uuid "efb057ba-bc50-5a4b-9c8c-026e21fb0356" :answer/type {:db/ident :answer.type/math} :answer/value "10{(5x+10)}^{5}" :db/id #edb/ref 17592186249528} {:answer/id #uuid "f825b128-d786-54b0-9c93-577427b75d05" :answer/type {:db/ident :answer.type/math} :answer/value "6{(5x+10)}^{5}" :db/id #edb/ref 17592186249588}] :answer-field/correct {:answer/id #uuid "147b8607-00ab-583f-9d29-c36db3ffb93e" :answer/type {:db/ident :answer.type/math} :answer/value "30{(5x+10)}^{5}" :db/id #edb/ref 17592186247609} :answer-field/id #uuid "1beb6b75-3505-5fda-ac7d-3d7a94737480" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249718}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "421599a5-1cf3-595e-9d3b-cce9b649fa80" :question/math-academy-id "q-11410" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)={(5x+10)}^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{6},\\,g=5x+10\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6{g}^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=5.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =6{g}^{5}\\cdot 5 \\\\  & =30(5x+10{)}^{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db185f31-d898-509f-b9c4-a2881a9060fa" :answer/type {:db/ident :answer.type/math} :answer/value "-28(1-7x)^3" :db/id #edb/ref 17592186313696} {:answer/id #uuid "0367ff3f-be48-44c0-9200-bace643c1760" :answer/type {:db/ident :answer.type/math} :answer/value "-28\\left(1-7x\\right)" :db/id #edb/ref 17592186576513}] :answer-field/correct {:answer/id #uuid "db185f31-d898-509f-b9c4-a2881a9060fa" :answer/type {:db/ident :answer.type/math} :answer/value "-28(1-7x)^3" :db/id #edb/ref 17592186313696} :answer-field/id #uuid "36ad8472-0eaf-547f-a51d-d9fd88b94c6d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314156}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "45dae178-5aad-56cb-99e8-4cae2859e574" :question/math-academy-id "q-340690" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(1-7x)^{4}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=1-7x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-7.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (-7) \\\\  & =-28(1-7x)^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dddace1-6902-5bd8-8d9c-4f8e9ee4c695" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186316001}] :answer-field/correct {:answer/id #uuid "9dddace1-6902-5bd8-8d9c-4f8e9ee4c695" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186316001} :answer-field/id #uuid "fb310ac7-3d59-5c34-90b1-fa1d08886eef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5911b4d-cb67-58a7-a1eb-0368289d94d7" :question/math-academy-id "q-342630" :question/problem "Given that $f(x)={({x}^{2}+2x+1)}^{2},$ the slope at the point $(0,1)$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{2},\\,g={x}^{2}+2x+1\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=2g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2x+2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2g\\cdot (2x+2) \\\\  & =2({x}^{2}+2x+1)(2x+2).\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & =[2({x}^{2}+2x+1)(2x+2){]}_{x=0} \\\\  & =2((0{)}^{2}+2\\cdot (0)+1)(2\\cdot (0)+2) \\\\  & =2(1)(2) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afdc11cd-82dd-5c6f-bcb3-29722512bae8" :answer/type {:db/ident :answer.type/math} :answer/value "-96" :db/id #edb/ref 17592186316117}] :answer-field/correct {:answer/id #uuid "afdc11cd-82dd-5c6f-bcb3-29722512bae8" :answer/type {:db/ident :answer.type/math} :answer/value "-96" :db/id #edb/ref 17592186316117} :answer-field/id #uuid "466922a0-7e46-579f-8acd-8a627c38b832" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316705}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d9eda9c-9861-5891-97dc-ba4b870f7db4" :question/math-academy-id "q-342663" :question/problem "Given that $f(x)={(3x+1)}^{4},$ the slope at the point $(-1,16)$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=3x+1\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot 3 \\\\  & =12(3x+1{)}^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=-1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & =[12(3x+1{)}^{3}{]}_{x=-1} \\\\  & =12(3\\cdot (-1)+1{)}^{3} \\\\  & =12(-2{)}^{3} \\\\  & =-96.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e15c4f3-e0aa-5296-8996-2def04133195" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+11" :db/id #edb/ref 17592186316002}] :answer-field/correct {:answer/id #uuid "9e15c4f3-e0aa-5296-8996-2def04133195" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+11" :db/id #edb/ref 17592186316002} :answer-field/id #uuid "adb706a4-b97c-5d9a-a3d9-b9ec8f4ae7e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316955}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f16d8b27-8720-58fb-ad21-d69be0217bc6" :question/math-academy-id "q-342910" :question/problem "Given that $f(x)=(3-2x{)}^{3},$ the equation of the tangent at the point $(2,-1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{3},\\,g=3-2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3{g}^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =3{g}^{2}\\cdot (-2) \\\\  & =-6(3-2x{)}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=2} & =(-6{(3-2x)}^{2}){|}_{x=2} \\\\  & =-6{(3-2(2))}^{2} \\\\  & =-6.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(2,-1)$ is $m=-6.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y+1 & =-6\\cdot (x-2) \\\\ y & =-6x+12-1 \\\\ y & =-6x+11\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354142ae-6999-5699-b81d-9f16570b6115" :answer/type {:db/ident :answer.type/math} :answer/value "y=-12x+25" :db/id #edb/ref 17592186327394} {:answer/id #uuid "6637b75c-a39e-5721-a28b-4a320ad5c971" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-23" :db/id #edb/ref 17592186327821} {:answer/id #uuid "790d805f-3881-5904-ba81-7ea14a53c052" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3x+7" :db/id #edb/ref 17592186327971} {:answer/id #uuid "85aa1fa8-f1d2-5839-ba72-e02c15010a7e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x+9" :db/id #edb/ref 17592186328087} {:answer/id #uuid "bcf17a1f-abef-5a3c-bb11-4d68176c30e1" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-7" :db/id #edb/ref 17592186328579}] :answer-field/correct {:answer/id #uuid "6637b75c-a39e-5721-a28b-4a320ad5c971" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-23" :db/id #edb/ref 17592186327821} :answer-field/id #uuid "7f94fd28-0c54-584b-93ad-2ea2c59a1f97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329394}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6c44e7b4-d61a-54f6-b052-1c62e5ff035f" :question/math-academy-id "q-48666" :question/problem "Given that $f(x)={(5-3x)}^{4},$ find the equation of the tangent at point $(2,1).$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=5-3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (-3) \\\\  & =-12(5-3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=2} & =-12{(5-3(2))}^{3} \\\\  & =12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(2,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =12(x-2) \\\\ y-1 & =12x-24 \\\\ y & =12x-23\\end{aligned}\n$$"} {:db/id #edb/ref 17592186525021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e53a687-845e-5e38-b650-cd7d2e960b1e" :answer/type {:db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186524465} {:answer/id #uuid "4c87e60d-6195-503b-b8b0-645b9615d373" :answer/type {:db/ident :answer.type/math} :answer/value "384" :db/id #edb/ref 17592186524511} {:answer/id #uuid "92b0203b-17bf-5bcc-b180-500fc847f62a" :answer/type {:db/ident :answer.type/math} :answer/value "3,072" :db/id #edb/ref 17592186524613} {:answer/id #uuid "ca95a77f-004b-588b-8c88-365d7dedd455" :answer/type {:db/ident :answer.type/math} :answer/value "768" :db/id #edb/ref 17592186524712} {:answer/id #uuid "de1da834-e484-5065-82b1-ac2bfe5f309a" :answer/type {:db/ident :answer.type/math} :answer/value "758" :db/id #edb/ref 17592186524761}] :answer-field/correct {:answer/id #uuid "4c87e60d-6195-503b-b8b0-645b9615d373" :answer/type {:db/ident :answer.type/math} :answer/value "384" :db/id #edb/ref 17592186524511} :answer-field/id #uuid "4a15449d-4ef5-5450-8663-fb7daf5af1c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524872}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a24feddb-3c6c-5b5d-be09-ecb6ef41d845" :question/math-academy-id "q-48622" :question/problem "Given that $f(x)=(3{x}^{2}-10)^{4},$ find the slope at the point $(2,16).$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=3{x}^{2}-10\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6x.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (6x) \\\\  & =24x(3{x}^{2}-10)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=2} & ={24x{(3{x}^{2}-10)}^{3}|}_{x=2} \\\\  & =24(2){(3(2)^{2}-10)}^{3} \\\\  & =384.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186565593 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc5a380-1983-5fd3-a9a8-a3c2ecf287fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4(3 - 4 x)^{5}" :db/id #edb/ref 17592186565591} {:answer/id #uuid "73f4128f-a1d8-5bf3-ad9f-85f70a222251" :answer/type {:db/ident :answer.type/math} :answer/value "3(3 - 4 x)^{5}" :db/id #edb/ref 17592186565592} {:answer/id #uuid "95a11de1-bb6b-5eb4-8e63-f0b053e1f1df" :answer/type {:db/ident :answer.type/math} :answer/value "6(3 - 4 x)^{5}" :db/id #edb/ref 17592186565595} {:answer/id #uuid "c2fd3656-3e39-56a1-92a1-6955b83b3b0b" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{6}" :db/id #edb/ref 17592186565598} {:answer/id #uuid "f881b92f-d7fe-54ff-9a4d-3e96bd197db8" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{5}" :db/id #edb/ref 17592186565603}] :answer-field/correct {:answer/id #uuid "f881b92f-d7fe-54ff-9a4d-3e96bd197db8" :answer/type {:db/ident :answer.type/math} :answer/value "-24(3 - 4 x)^{5}" :db/id #edb/ref 17592186565603} :answer-field/id #uuid "bad14dfb-e7b1-549d-8b87-2f1d672c7de0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565597}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a04edd0-e7bf-56e5-8b7e-72d1c5d80068" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 - 4 x)^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=3 - 4 x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(3 - 4 x)^{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186565600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37815dd4-eb85-5506-a53b-02d708dc63b4" :answer/type {:db/ident :answer.type/math} :answer/value "12x(-1+2x)^{5}" :db/id #edb/ref 17592186565590} {:answer/id #uuid "7ca845be-815d-54b6-b943-67a05dfc5659" :answer/type {:db/ident :answer.type/math} :answer/value "16(-1+2x)^{7}" :db/id #edb/ref 17592186565594} {:answer/id #uuid "c4a651a1-21d4-5d6e-99e6-82d10932c207" :answer/type {:db/ident :answer.type/math} :answer/value "12(-1+2x)^{5}" :db/id #edb/ref 17592186565599} {:answer/id #uuid "d0dc0981-4569-5cd4-81b4-a1e05d370b16" :answer/type {:db/ident :answer.type/math} :answer/value "3(-1+2x)^{5}" :db/id #edb/ref 17592186565601} {:answer/id #uuid "f30538b4-9ca0-589f-b496-783cf99694de" :answer/type {:db/ident :answer.type/math} :answer/value "6(-1+2x)^{5}" :db/id #edb/ref 17592186565602}] :answer-field/correct {:answer/id #uuid "c4a651a1-21d4-5d6e-99e6-82d10932c207" :answer/type {:db/ident :answer.type/math} :answer/value "12(-1+2x)^{5}" :db/id #edb/ref 17592186565599} :answer-field/id #uuid "a28f42e5-36b6-5f5e-8b58-a45c3ea6040b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565596}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c560bc6a-e1e6-5b7e-9d3d-86522a3c4ff0" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-1+2x)^{6}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6\\cdot 2\\cdot (-1+2x)^{5} \\\\  &=12(-1+2x)^{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c14e8a2-231e-520a-9373-a71e0dd19e6b" :answer/type {:db/ident :answer.type/math} :answer/value "4t(t^2+3)" :db/id #edb/ref 17592186594381}] :answer-field/correct {:answer/id #uuid "2c14e8a2-231e-520a-9373-a71e0dd19e6b" :answer/type {:db/ident :answer.type/math} :answer/value "4t(t^2+3)" :db/id #edb/ref 17592186594381} :answer-field/id #uuid "ec6431b2-e799-5371-92fe-40e4255fa0c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186594657}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "016c901a-a8ed-57f7-ace0-713928705ac4" :question/math-academy-id "q-132770" :question/problem "$\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+3)^{2}]=\\,${{field-1}}" :question/worked-solution "First, let's define a function $h(t):$\n\n$$\nh(t)=({t}^{2}+3)^{2}\n$$\n\nTo differentiate this function, we use the chain rule. Let \n\n$$\ng(t)={t}^{2}+3,\\,h(g(t))=g(t)^{2}.\n$$\n\nDifferentiating our functions, we have\n\n$$\n\\begin{aligned}{g}^{′}(t) & =({t}^{2}+3)^{′}=2t, \\\\ {h}^{′}(g(t)) & =({g}^{2})^{′}=2g.\\end{aligned}\n$$\n\nThen, using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+3)^{2}] & ={h}^{′}(t) \\\\  & ={h}^{′}(g(t))\\cdot {g}^{′}(t) \\\\  & =2g\\cdot 2t \\\\  & =4t({t}^{2}+3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186601935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55139606-5928-55a4-b814-22a969ada28b" :answer/type {:db/ident :answer.type/math} :answer/value "6t(t^2+1)^2" :db/id #edb/ref 17592186601654}] :answer-field/correct {:answer/id #uuid "55139606-5928-55a4-b814-22a969ada28b" :answer/type {:db/ident :answer.type/math} :answer/value "6t(t^2+1)^2" :db/id #edb/ref 17592186601654} :answer-field/id #uuid "cc71457a-ed2e-5826-8272-b8f37053afd2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186601872}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c125870a-b46c-59e0-a9be-37ea8a9a1d43" :question/math-academy-id "q-132994" :question/problem "$\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+1)^{3}]=\\,${{field-1}}" :question/worked-solution "First, let's define a function $h(t):$\n\n$$\nh(t)=({t}^{2}+1)^{3}\n$$\n\nTo differentiate this function, we use the chain rule. Let \n\n$$\ng(t)={t}^{2}+1,\\,h(g(t))=g(t)^{3}.\n$$\n\nDifferentiating our functions, we have\n\n$$\n\\begin{aligned}{g}^{′}(t) & =({t}^{2}+1)^{′}=2t, \\\\ {h}^{′}(g(t)) & =({g}^{3})^{′}=3{g}^{2}.\\end{aligned}\n$$\n\nThen, using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[({t}^{2}+1)^{3}] & ={h}^{′}(t) \\\\  & ={h}^{′}(g(t))\\cdot {g}^{′}(t) \\\\  & =3{g}^{2}\\cdot 2t \\\\  & =6t({t}^{2}+1)^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186611693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691}] :answer-field/correct {:answer/id #uuid "2637e49a-0781-515c-9a84-f689805a94ab" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x - 7" :db/id #edb/ref 17592186611691} :answer-field/id #uuid "e573b0d0-2df3-5439-93d8-68fb45052de8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611696}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6d431469-04a8-5431-a8f2-30fe91513752" :question/problem "Given that $f(x)=(1+2x)^{4},$ the equation of the tangent at the point $(-1,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(1+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=-1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=-1} &=[8(1+2x)^{3}]|_{x=-1} \\\\  &=8(1+2(-1))^{3} \\\\  &=-8.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(-1,1)$ is $m=-8.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=-8(x-(-1)) \\\\ y &=- 8 x - 8+1 \\\\ y &=- 8 x - 7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186611694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697}] :answer-field/correct {:answer/id #uuid "ec2cf140-cbdf-5a26-a3b0-eb6b8b2c84f1" :answer/type {:db/ident :answer.type/math} :answer/value "80 - 64 x" :db/id #edb/ref 17592186611697} :answer-field/id #uuid "0f1d28df-dabb-5bf7-8e72-27b57ca20785" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611690}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "90d7ca00-a943-5f90-be7d-b4fa402d7fc3" :question/problem "Given that $f(x)=(-4+2x)^{4},$ the equation of the tangent at the point $(1,16)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=-4+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (2) \\\\  &=8(-4+2x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[8(-4+2x)^{3}]|_{x=1} \\\\  &=8(-4+2(1))^{3} \\\\  &=-64.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,16)$ is $m=-64.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(16) &=-64(x-(1)) \\\\ y &=64 - 64 x+16 \\\\ y &=80 - 64 x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186611695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698}] :answer-field/correct {:answer/id #uuid "f389ac9f-9185-59ca-813f-7320e8f73331" :answer/type {:db/ident :answer.type/math} :answer/value "12 x + 1" :db/id #edb/ref 17592186611698} :answer-field/id #uuid "576ad759-6f77-5ac1-a36e-2ea6c5dd47da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611692}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c482bf94-14dc-5d26-9e9f-475518535fcc" :question/problem "Given that $f(x)=(1+3x)^{4},$ the equation of the tangent at the point $(0,1)$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=1+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(1+3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=0$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=0} &=[12(1+3x)^{3}]|_{x=0} \\\\  &=12(1+3(0))^{3} \\\\  &=12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(0,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-y_1 &=m(x-x_1) \\\\ y-(1) &=12(x-(0)) \\\\ y &=12 x+1 \\\\ y &=12 x + 1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186616327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c59ab1b-f4c8-5a75-87e4-20893cd4b044" :answer/type {:db/ident :answer.type/math} :answer/value "-24(-9-4x)^{5}" :db/id #edb/ref 17592186616326}] :answer-field/correct {:answer/id #uuid "4c59ab1b-f4c8-5a75-87e4-20893cd4b044" :answer/type {:db/ident :answer.type/math} :answer/value "-24(-9-4x)^{5}" :db/id #edb/ref 17592186616326} :answer-field/id #uuid "63b9c5d6-db2e-54e6-84b8-bf2a0320e4db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186616328}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "57a6783a-fc39-5ef5-8a1c-628f352f4ad2" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-9-4x)^{6}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-9-4x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(-9-4x)^{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186616329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7bf8b1-ff38-5f11-bbcc-50fa3c64315d" :answer/type {:db/ident :answer.type/math} :answer/value "12(3 x - 2)^{3}" :db/id #edb/ref 17592186616322} {:answer/id #uuid "3b7d9b20-6c95-5ef1-9f2f-5d156d52e4b9" :answer/type {:db/ident :answer.type/math} :answer/value "21(3 x - 2)^{2}" :db/id #edb/ref 17592186616324} {:answer/id #uuid "44ea5da8-041a-5e5b-99cd-1fb7c91c60e3" :answer/type {:db/ident :answer.type/math} :answer/value "28(3 x - 2)^{3}" :db/id #edb/ref 17592186616325} {:answer/id #uuid "d3b17d71-4b32-5a53-8943-d88edbe9e11a" :answer/type {:db/ident :answer.type/math} :answer/value "9(3 x - 2)^{2}" :db/id #edb/ref 17592186616330} {:answer/id #uuid "d5a8f75a-30e8-5ac1-8c2d-9aeb2e7e764a" :answer/type {:db/ident :answer.type/math} :answer/value "6(3 x - 2)^{2}" :db/id #edb/ref 17592186616331}] :answer-field/correct {:answer/id #uuid "d3b17d71-4b32-5a53-8943-d88edbe9e11a" :answer/type {:db/ident :answer.type/math} :answer/value "9(3 x - 2)^{2}" :db/id #edb/ref 17592186616330} :answer-field/id #uuid "298df8c1-b7b3-5697-9024-df99fb83258d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186616323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a831160d-bd79-52f7-b589-31b6792f7366" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 x - 2)^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{3},\\,g=3 x - 2\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3g^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=3g^{2}\\cdot (3) \\\\  &=9(3 x - 2)^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186620984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271409d5-4217-5c85-b07c-9e0df003989b" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186620978} {:answer/id #uuid "362293ce-6960-5bec-bd1d-91d950c62c55" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186620979} {:answer/id #uuid "5442b9e8-2d41-5f44-aa1b-5bf84a779714" :answer/type {:db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186620980} {:answer/id #uuid "9e1008cf-16e7-59e5-9723-0377df844c92" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186620982} {:answer/id #uuid "cf9bd0de-8993-53c8-b29e-a2a030396acb" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186620983}] :answer-field/correct {:answer/id #uuid "9e1008cf-16e7-59e5-9723-0377df844c92" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186620982} :answer-field/id #uuid "8826ac9f-6e72-51e7-9d14-5ca172f0524c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186620981}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f96934b1-b807-5be7-b577-eeccabeded8d" :question/problem "Given that $f(x)=(2 x^{2} - 3)^{4},$ find the slope at the point $(1,1)$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=2 x^{2} - 3\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=4 x.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (4 x) \\\\  &=16 x(2 x^{2} - 3)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}|_{x=1} &=[16 x(2 x^{2} - 3)^{3}]|_{x=1} \\\\  &=16 (1)(2 (1)^{2} - 3)^{3} \\\\  &=-16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186674232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1911a5a7-f3f7-570f-9fa3-c1981c4207d2" :answer/type {:db/ident :answer.type/math} :answer/value "-25(-1-2x)^{4}" :db/id #edb/ref 17592186674225} {:answer/id #uuid "2af3b741-0e3b-5d69-b4c9-aeec185861b3" :answer/type {:db/ident :answer.type/math} :answer/value "-6(-1-2x)^{2}" :db/id #edb/ref 17592186674228} {:answer/id #uuid "3ee743cc-f41a-5f09-bc26-34dd01d784e7" :answer/type {:db/ident :answer.type/math} :answer/value "-10(-1-2x)^{4}" :db/id #edb/ref 17592186674231} {:answer/id #uuid "506242d7-6946-5793-af48-24427370b9ad" :answer/type {:db/ident :answer.type/math} :answer/value "-15(-1-2x)^{2}" :db/id #edb/ref 17592186674234} {:answer/id #uuid "cf3a5ea2-bbee-5c81-a219-c37346ebec71" :answer/type {:db/ident :answer.type/math} :answer/value "-18(-1-2x)^{2}" :db/id #edb/ref 17592186674247}] :answer-field/correct {:answer/id #uuid "2af3b741-0e3b-5d69-b4c9-aeec185861b3" :answer/type {:db/ident :answer.type/math} :answer/value "-6(-1-2x)^{2}" :db/id #edb/ref 17592186674228} :answer-field/id #uuid "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674237}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-1-2x)^{3}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{3},\\,g=-1-2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3g^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=3\\cdot (-2)\\cdot (-1-2x)^{2} \\\\  &=-6(-1-2x)^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186674233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f7b679-b110-593d-9a4d-48c344350489" :answer/type {:db/ident :answer.type/math} :answer/value "6(-9+3x)" :db/id #edb/ref 17592186674230}] :answer-field/correct {:answer/id #uuid "38f7b679-b110-593d-9a4d-48c344350489" :answer/type {:db/ident :answer.type/math} :answer/value "6(-9+3x)" :db/id #edb/ref 17592186674230} :answer-field/id #uuid "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186674244}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4488b435-75c4-5bf8-836f-8c025405b71b" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-9+3x)^{2}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{2},\\,g=-9+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=2g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=2g\\cdot (3) \\\\  &=6(-9+3x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186674235 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "358cdd35-f54f-5f0a-96f8-8aa8b44b8ceb" :answer/type {:db/ident :answer.type/math} :answer/value "-21(8-5x)^{2}" :db/id #edb/ref 17592186674229} {:answer/id #uuid "685dc9ff-3893-53af-a4fe-684701e82263" :answer/type {:db/ident :answer.type/math} :answer/value "-8(8-5x)^{3}" :db/id #edb/ref 17592186674236} {:answer/id #uuid "771e8765-6d6b-5ea7-b38e-82d4e23649c3" :answer/type {:db/ident :answer.type/math} :answer/value "-6(8-5x)^{2}" :db/id #edb/ref 17592186674238} {:answer/id #uuid "a07bb43c-0d8b-56c9-bf60-bcb8516d2494" :answer/type {:db/ident :answer.type/math} :answer/value "-15(8-5x)^{2}" :db/id #edb/ref 17592186674242} {:answer/id #uuid "b5258c1e-66c7-5a68-9de6-0e14c158d25d" :answer/type {:db/ident :answer.type/math} :answer/value "-20(8-5x)^{3}" :db/id #edb/ref 17592186674245}] :answer-field/correct {:answer/id #uuid "b5258c1e-66c7-5a68-9de6-0e14c158d25d" :answer/type {:db/ident :answer.type/math} :answer/value "-20(8-5x)^{3}" :db/id #edb/ref 17592186674245} :answer-field/id #uuid "7917f945-dbcb-5a17-9d25-fe021a3c403f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674239}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5c07f75d-1f18-51f4-b433-e46bd0df0550" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(8-5x)^{4}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=8-5x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-5.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4\\cdot (-5)\\cdot (8-5x)^{3} \\\\  &=-20(8-5x)^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186674243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/type {:db/ident :answer.type/math} :answer/value "12(5+3x)^{3}" :db/id #edb/ref 17592186674240}] :answer-field/correct {:answer/id #uuid "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/type {:db/ident :answer.type/math} :answer/value "12(5+3x)^{3}" :db/id #edb/ref 17592186674240} :answer-field/id #uuid "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186674249}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a25c900d-1561-5094-9272-47bf64ff1c06" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(5+3x)^{4}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=5+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(5+3x)^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186674246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1afff144-faa8-5d98-8b52-2e0fcc9a7f3c" :answer/type {:db/ident :answer.type/math} :answer/value "30(-7+6x)^{4}" :db/id #edb/ref 17592186674226} {:answer/id #uuid "1c35b387-63bd-565d-b5dc-feba286107ad" :answer/type {:db/ident :answer.type/math} :answer/value "25(-7+6x)^{4}" :db/id #edb/ref 17592186674227} {:answer/id #uuid "8ff15c7e-b33c-59b4-b72a-86eca43164f7" :answer/type {:db/ident :answer.type/math} :answer/value "15(-7+6x)^{2}" :db/id #edb/ref 17592186674241} {:answer/id #uuid "d3e08094-b4f8-524a-b559-837c1a01dfd8" :answer/type {:db/ident :answer.type/math} :answer/value "10(-7+6x)^{4}" :db/id #edb/ref 17592186674248} {:answer/id #uuid "f771748e-0724-5882-9ec8-fdf9ce712c4a" :answer/type {:db/ident :answer.type/math} :answer/value "18(-7+6x)^{2}" :db/id #edb/ref 17592186674251}] :answer-field/correct {:answer/id #uuid "1afff144-faa8-5d98-8b52-2e0fcc9a7f3c" :answer/type {:db/ident :answer.type/math} :answer/value "30(-7+6x)^{4}" :db/id #edb/ref 17592186674226} :answer-field/id #uuid "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674250}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c83476a7-334e-550f-a570-977c18f19b5f" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-7+6x)^{5}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{5},\\,g=-7+6x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=5g^{4},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=5\\cdot 6\\cdot (-7+6x)^{4} \\\\  &=30(-7+6x)^{4}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}]}
