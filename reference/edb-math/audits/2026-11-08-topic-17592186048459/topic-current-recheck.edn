2}+{y}_{2}) \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{x}_{1}+{y}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}{x}_{2}+{y}_{2} \\\\ 0\\end{bmatrix} \\\\  & =T\\begin{bmatrix}{x}_{1} \\\\ {y}_{1}\\end{bmatrix}+T\\begin{bmatrix}{x}_{2} \\\\ {y}_{2}\\end{bmatrix}.\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."} {:db/id #edb/ref 17592186284661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f7e2b7e-e309-5a7f-bd15-1dc1b4f018b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465597} {:answer/id #uuid "1bd65821-b67f-5f1e-bfd9-730d7932bbeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465598}] :answer-field/correct {:answer/id #uuid "5f7e2b7e-e309-5a7f-bd15-1dc1b4f018b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465597} :answer-field/id #uuid "4b34043b-63f9-5fa0-a22b-0f554e482772" :answer-field/key "$T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466642} {:answer-field/choices [{:answer/id #uuid "9e85b11b-9116-5803-b998-326a84d0a854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465599} {:answer/id #uuid "ef9a180e-d1f1-5448-8cfe-21b6fb5e12c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465600}] :answer-field/correct {:answer/id #uuid "9e85b11b-9116-5803-b998-326a84d0a854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465599} :answer-field/id #uuid "c66f4dae-dcc5-550b-8a88-51f93fc0be6f" :answer-fi