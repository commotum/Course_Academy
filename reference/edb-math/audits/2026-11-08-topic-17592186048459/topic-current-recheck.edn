 $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-5{v}_{2}) & =-5T({v}_{2}) \\\\  & =-5\\begin{bmatrix}7 \\\\ 8 \\\\ 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(11{v}_{1}+6{v}_{2})=\\begin{bmatrix}-35 \\\\ -40 \\\\ -45\\end{bmatrix}.$"} {:db/id #edb/ref 17592186596703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195ad14f-a664-544d-86be-c0307fe1f679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 \\\\ 5 \\\\ 35\\end{bmatrix}" :db/id #edb/ref 17592186596118} {:answer/id #uuid "28bd4d02-6934-531b-815d-f2f2d7fb6af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 \\\\ -7 \\\\ -49\\end{bmatrix}" :db/id #edb/ref 17592186596144} {:answer/id #uuid "2d9d4be8-0a09-59a8-b857-ef8aed7e5002" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -13 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186596155} {:answer/id #uuid "aeaee271-2013-5589-82ee-89136aaa4550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ 2 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186596359} {:answer/id #uuid "d4916530-96c3-5116-9def-4083faf3334e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-24 \\\\ 104 \\\\ 56\\end{bmatrix}" :db/id #edb/ref 17592186596417}] :answer-field/correct {:answer/id #uuid "28bd4d02-6934-531b-815d-f2f2d7fb6af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 \\\\ -7 \\\\ -49\\end{bmatrix}" :db/id #edb/ref 17592186596144} :answer-field/id #uuid "1746d085-2b52-5a94-a30d-dddf727fe730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186596504}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf779b3a-5448-5cce-b050-fadf2e6a99ed" :question/math-academy-id "q-74783" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=\\begin{bmatrix}-3 \\\\ 1 \\\\ 7\\end{bmatrix}\\,$, find $\\,T(15{v}_{1}+8{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}15{v}_{1}+8{v}_{2} & =15{v}_{1}+15{v}_{2}-7{v}_{2} \\\\  & =15({v}_{1}+{v}_{2})-7{v}_{2} \\\\  & =15(0)-7{v}_{2} \\\\  & =-7{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(15{v}_{1}+8{v}_{2})=T(-7{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-7{v}_{2}) & =-7T({v}_{2}) \\\\  & =-7\\begin{bmatrix}-3 \\\\ 1 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}21 \\\\ -7 \\\\ -49\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(15{v}_{1}+8{v}_{2})=\\begin{bmatrix}21 \\\\ -7 \\\\ -49\\end{bmatrix}.$"} {:db/id #edb/ref 17592186643141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ab27f-b463-5656-81d1-09d643c980be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186642685}] :answer-field/correct {:answer/id #uuid "186ab27f-b463-5656-81d1-09d643c980be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186642685} :answer-field/id #uuid "28b991b7-0c23-5673-8da6-87b7966dcf2b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186643036} {:answer-field/choices [{:answer/id #uuid "050c94ce-53b1-5191-ac08-1ce0a598c805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186642655}] :answer-field/correct {:answer/id #uuid "050c94ce-53b1-5191-ac08-1ce0a598c805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186642655} :answer-field/id #uuid "988e72ea-be85-5ef6-99e0-7f25898c02c2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186643080} {:answer-field/choices [{:answer/id #uuid "a17b17f4-b454-51bd-860e-31fe2a85b1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186642877}] :answer-field/correct {:answer/id #uuid "a17b17f4-b454-51bd-860e-31fe2a85b1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186642877} :answer-field/id #uuid "a4dd9da4-ff9e-5caa-a9b7-942af3c92253" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186643083}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7b11147a-69b5-55ec-b09a-5f5856bc7fde" :question/math-academy-id "q-317820" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}\\,$, find  $T(7{v}_{1}+13{v}_{2}).$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"105px\" rowspan=\"3\" width=\"30px\">\n$\\,T(7{v}_{1}+13{v}_{2})=\\,\\,$  \n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">\n{{field-1}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}7{v}_{1}+13{v}_{2} & =13{v}_{1}-6{v}_{1}+13{v}_{2} \\\\  & =13({v}_{1}+{v}_{2})-6{v}_{1} \\\\  & =13(0)-6{v}_{1} \\\\  & =-6{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(7{v}_{1}+13{v}_{2})=T(-6{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(-6{v}_{1}) & =-6T({v}_{1}) \\\\  & =-6\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 \\\\ -24 \\\\ -6\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(7{v}_{1}+13{v}_{2})=\\begin{bmatrix}12 \\\\ -24 \\\\ -6\\end{bmatrix}.$"}] :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :topic/math-academy-id 865 :topic/title "Introduction to Linear Transformations"}]}
