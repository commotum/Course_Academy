+5{v}_{1} \\\\  & =4(0)+5{v}_{1} \\\\  & =5{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(9{v}_{1}+4{v}_{2})=T(5{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(5{v}_{1}) & =5T({v}_{1}) \\\\  & =5\\begin{bmatrix}3 \\\\ -2 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 \\\\ -10 \\\\ 25\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(9{v}_{1}+4{v}_{2})=\\begin{bmatrix}15 \\\\ -10 \\\\ 25\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec31264b-8623-5bfb-ad12-e6e6791216a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298557}] :answer-field/correct {:answer/id #uuid "ec31264b-8623-5bfb-ad12-e6e6791216a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298557} :answer-field/id #uuid "27683d78-7862-5ee3-9dfe-de26a66c4f6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298769} {:answer-field/choices [{:answer/id #uuid "8c90211a-3b66-5115-b238-966324942e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186298163}] :answer-field/correct {:answer/id #uuid "8c90211a-3b66-5115-b238-966324942e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186298163} :answer-field/id #uuid "3cf2dcc6-6ef8-5333-adfa-7bd0181651f9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298844} {:answer-field/choices [{:answer/id #uuid "36f444b2-927d-5879-a914-fdad60e6be1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186297773}]