{v}_{1}) & =4T({v}_{1}) \\\\  & =4\\begin{bmatrix}-4 \\\\ 13 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}.\\end{aligned}\n$$\n\nIn conclusion, $T(41{v}_{1}+37{v}_{2})=\\begin{bmatrix}-16 \\\\ 52 \\\\ -28\\end{bmatrix}.$"} {:db/id #edb/ref 17592186344984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b04976-9bfc-56d7-801f-a1ef0a853a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186342249} {:answer/id #uuid "46cbe344-5439-5e0a-bd87-73047c87a17e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-40 \\\\ 20 \\\\ 45\\end{bmatrix}" :db/id #edb/ref 17592186342823} {:answer/id #uuid "758b29d9-f4ee-55d9-baae-0129f919eee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}64 \\\\ -32 \\\\ -72\\end{bmatrix}" :db/id #edb/ref 17592186343253} {:answer/id #uuid "7a08d470-42c3-5b67-8c85-dd1691a27317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -4 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186343289} {:answer/id #uuid "da0518b2-7cae-56e3-a0f8-6aba065ae55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-64 \\\\ 32 \\\\ 72\\end{bmatrix}" :db/id #edb/ref 17592186344153}] :answer-field/correct {:answer/id #uuid "00b04976-9bfc-56d7-801f-a1ef0a853a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}40 \\\\ -20 \\\\ -45\\end{bmatrix}" :db/id #edb/ref 17592186342249} :answer-field/id #uuid "0a14c23e-18a5-58d8-9ebf-12128c65d882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344514}] :question/difficulty {:db/id #edb/ref 175921860454