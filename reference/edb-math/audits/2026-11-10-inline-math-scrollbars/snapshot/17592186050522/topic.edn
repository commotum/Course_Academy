type/text} :answer/value "is" :db/id #edb/ref 17592186313471} :answer-field/id #uuid "b91e7daf-7104-5609-8668-56d7ca68dc0b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314513} {:answer-field/choices [{:answer/id #uuid "b07798c6-d5e8-5403-a71d-03fc9a8fbe7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186313348} {:answer/id #uuid "e7b6d0f4-cd58-5563-8d0b-4f5cd1f043af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186313812}] :answer-field/correct {:answer/id #uuid "b07798c6-d5e8-5403-a71d-03fc9a8fbe7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186313348} :answer-field/id #uuid "c0f9c7b6-d9fc-5ddf-96d4-b5b9b1ab9da2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314549} {:answer-field/choices [{:answer/id #uuid "04b8e1f9-3c9c-5060-84ea-64646477e8b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186312000} {:answer/id #uuid "3e2b207f-a62c-5210-b0ac-d1cc446c0656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186312476}] :answer-field/correct {:answer/id #uuid "3e2b207f-a62c-5210-b0ac-d1cc446c0656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186312476} :answer-field/id #uuid "d30ac714-e473-5bc6-a578-417058601e19" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314590}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ba452e1-067b-53c9-a55d-7aa33b4eb4d9" :question/math-academy-id "q-339917" :question/problem "$$\n{x}^{2}{y}^{″}-4x{y}^{′}=-6{x}^{2}\n$$\n\nConsider the differential equation above, for which the corresponding complementary solution is ${y}_{c}(x)=A{x}^{5}+B,$ where $A$ and $B$ are arbitrary constants. Select the correct options below.$\\,$\nThe function ${y}_{p}(x)=x$ \n{{field-1}} \na particular solution of the differential equation.\n\n$\\,$\nThe function ${y}_{p}(x)={x}^{2}$ \n{{field-2}} \na particular solution of the differential equation.\n\n$\\,$\nThe general solution of the differential equation is given by\n\n$\\,\\,$\n$y(x)=$ \n{{field-3}}\n$+$\n{{field-4}},\n\n$\\,$\nwhere \n{{field-5}} are arbitrary constants." :question/worked-solution "For an inhomogeneous differential equation, the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nwhere\n\n- ${y}_{c}(x)$ is the complementary solution (the general solution of the corresponding homogeneous equation), and\n\n- ${y}_{p}(x)$ is a particular solution of the original inhomogeneous equation.\n\nWith this in mind, let's check which of the two given functions is a particular solution of our inhomogeneous equation:\n\n- For ${y}_{p}(x)=x,$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =(x)^{′}=1, \\\\ {y}^{″}(x) & =(1)^{′}=0.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(0)-4x(1)=-6{x}^{2}.\\,\\,\\times \n$$\n\nSo, ${y}_{p}(x)=x$ $\\text{isn't}$ a particular solution of the differential equation.\n\n- For ${y}_{p}(x)={x}^{2},$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =({x}^{2})^{′}=2x, \\\\ {y}^{″}(x) & =(2x)^{′}=2.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(2)-4x(2x)=-6{x}^{2}.\\,\\,✓\n$$\n\nSo, ${y}_{p}(x)={x}^{2}$ $\\text{is}$ a particular solution of the differential equation.\n\nWe are told that the complementary solution of our equation is ${y}_{c}(x)=A{x}^{5}+B.$ Therefore, the general solution is\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{x}^{5}+B+{x}^{2}\\end{aligned}\n$$\n\nwhere $A\\text{ and }B$ are arbitrary constants."} {:db/id #edb/ref 17592186314878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb229fa-6f9c-5a69-b0d6-2b934a5e8256" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186312323} {:answer/id #uuid "c1ca5e06-743e-56c6-9376-f34c234b3e9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186313491}] :answer-field/correct {:answer/id #uuid "c1ca5e06-743e-56c6-9376-f34c234b3e9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186313491} :answer-field/id #uuid "300f091d-60d2-51e6-9901-b231130a3cf9" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314139} {:answer-field/choices [{:answer/id #uuid "2219bbfa-a73f-5279-82c4-8e4bb0824640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186312234} {:answer/id #uuid "9333a372-c254-5d36-8386-b1fcf0f69a73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186313155}] :answer-field/correct {:answer/id #uuid "9333a372-c254-5d36-8386-b1fcf0f69a73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186313155} :answer-field/id #uuid "7ce1e876-8ad6-5f03-9bb6-591931b8394d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314340} {:answer-field/choices [{:answer/id #uuid "2aa8a5a5-d664-53a8-8a1e-ddeb8fe6c96f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{-x}+B{e}^{4x}" :db/id #edb/ref 17592186312301} {:answer/id #uuid "49de3ce7-2ddc-518c-854e-eafd8a047df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{-x}+B{e}^{-4x}" :db/id #edb/ref 17592186312572} {:answer/id #uuid "4f7b123a-cc84-54a8-9151-605919bba372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{x}+B{e}^{-4x}" :db/id #edb/ref 17592186312619} {:answer/id #uuid "745b5e39-98d3-52dd-955c-2733b31747be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186312902}] :answer-field/correct {:answer/id #uuid "49de3ce7-2ddc-518c-854e-eafd8a047df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A{e}^{-x}+B{e}^{-4x}" :db/id #edb/ref 17592186312572} :answer-field/id #uuid "a5001142-fa63-5975-98fc-6aefc3a3fff8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314455} {:answer-field/choices [{:answer/id #uuid "2e2e9fe0-9d14-5584-9191-0594a5f5e62d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186312337} {:answer/id #uuid "4f9fe0aa-cdb6-5e9b-95ba-83e767629260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186312621}] :answer-field/correct {:answer/id #uuid "4f9fe0aa-cdb6-5e9b-95ba-83e767629260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186312621} :answer-field/id #uuid "eb3422fc-9101-5049-b9da-89d0ec0f636d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314656} {:answer-field/choices [{:answer/id #uuid "2a7b4ca9-d4f5-5b81-8dfc-3c846dff159a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C{e}^{-x}" :db/id #edb/ref 17592186312298} {:answer/id #uuid "352fdb5e-5751-5d23-aed4-b0c4585bee5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-x}" :db/id #edb/ref 17592186312402} {:answer/id #uuid "5867f2da-f584-5b0e-ac8e-bbe3cffb4923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}" :db/id #edb/ref 17592186312683} {:answer/id #uuid "9a599ed7-aafe-501d-b364-42c43da7d22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Cx{e}^{-x}" :db/id #edb/ref 17592186313198}] :answer-field/correct {:answer/id #uuid "352fdb5e-5751-5d23-aed4-b0c4585bee5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-x}" :db/id #edb/ref 17592186312402} :answer-field/id #uuid "ef2b9423-79f0-5dc9-ab2c-4fbd6f9e2d00" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314667}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81480660-8b23-5d75-8411-ad962650246b" :question/math-academy-id "q-339876" :question/problem "$$\n{y}^{″}+5{y}^{′}+4y=3{e}^{-x}\n$$\n\nConsider the differential equation above, for which the corresponding complementary solution is ${y}_{c}(x)=A{e}^{-x}+B{e}^{-4x},$ where $A$ and $B$ are arbitrary constants. Select the correct options below.\n\n$\\,$\nThe function ${y}_{p}(x)={e}^{-x}$ \n{{field-1}} \na particular solution of the differential equation.\n\n$\\,$\nThe function ${y}_{p}(x)=x{e}^{-x}$ \n{{field-2}} \na particular solution of the differential equation.\n\n$\\,$\nThe general solution of the differential equation is given by\n\n$\\,\\,$\n$y(x)=$ \n{{field-3}}\n$+$\n{{field-4}},\n\n$\\,$\nwhere \n{{field-5}} are arbitrary constants." :question/worked-solution "For an inhomogeneous differential equation, the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nwhere\n\n- ${y}_{c}(x)$ is the complementary solution (the general solution of the corresponding homogeneous equation), and\n\n- ${y}_{p}(x)$ is a particular solution of the original inhomogeneous equation.\n\nWith this in mind, let's check which of the two given functions is a particular solution of our inhomogeneous equation:\n\n- For ${y}_{p}(x)={e}^{-x},$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =({e}^{-x})^{′}=-{e}^{-x}, \\\\ {y}^{″}(x) & =(-{e}^{-x})^{′}={e}^{-x}.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n({e}^{-x})+5(-{e}^{-x})+4({e}^{-x})=3{e}^{-x}.\\,\\,\\times \n$$\n\nSo, ${y}_{p}(x)={e}^{-x}$ $\\text{isn't}$ a particular solution of the differential equation.\n\n- For ${y}_{p}(x)=x{e}^{-x},$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =(x{e}^{-x})^{′}={e}^{-x}-x{e}^{-x}, \\\\ {y}^{″}(x) & =({e}^{-x}-x{e}^{-x})^{′}=-2{e}^{-x}+x{e}^{-x}.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n(-2{e}^{-x}+x{e}^{-x})+5({e}^{-x}-x{e}^{-x})+4(x{e}^{-x})=3{e}^{-x}.\\,\\,✓\n$$\n\nSo, ${y}_{p}(x)=x{e}^{-x}$ $\\text{is}$ a particular solution of the differential equation.\n\nWe are told that the complementary solution of our equation is ${y}_{c}(x)=A{e}^{-x}+B{e}^{-4x}.$ Therefore, the general solution is\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{e}^{-x}+B{e}^{-4x}+x{e}^{-x}\\end{aligned}\n$$\n\nwhere $A\\text{ and }B$ are arbitrary constants."} {:db/id #edb/ref 17592186314879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "431db97c-82bf-53a9-80a3-c1646126588e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186312511} {:answer/id #uuid "d15c4c7b-5958-5907-ac23-369c09ffa8b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186313610}] :answer-field/co