#{[{:db/id #edb/ref 17592186678090 :knowledge-point/_questions [{:db/id #edb/ref 17592186068915 :knowledge-point/title "Integrating Trigonometric Functions With Linear Arguments"}] :question/id #uuid "85d13d2d-f042-57af-a1a0-8e6f471f6d8a" :question/problem "Find an antiderivative.\n\n$$\n\\int \\sin{\\left(4 x + 3 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\n{{answer}} $+C$"}] [{:db/id #edb/ref 17592186678190 :knowledge-point/_questions [{:db/id #edb/ref 17592186068916 :knowledge-point/title "Integrating Reciprocal Trigonometric Functions With Linear Arguments"}] :question/id #uuid "a12513cf-5b77-57ed-9d9c-cdf66ea9782e" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{4}} 4 \\cot{\\left(2 x \\right)} \\csc{\\left(2 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cot{\\left(u \\right)} \\csc{\\left(u \\right)}\\,\\mathrm{d}u=- \\csc{\\left(u \\right)}+C$.\n\nEndpoint values: $\\csc{\\left(\\frac{\\pi}{6} \\right)}=2,\\quad \\csc{\\left(\\frac{\\pi}{2} \\right)}=1$.\n\n{{answer}}"}] [{:db/id #edb/ref 17592186678417 :knowledge-point/_questions [{:db/id #edb/ref 17592186068918 :knowledge-point/title "Integrating Quotients Containing Trigonometric Functions Using Substitution"}] :question/id #uuid "bfed7b75-cd14-5de2-9aa5-2a0b83a01ce0" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3 \\sin{\\left(x \\right)}}{\\cos{\\left(x \\right)} + 2}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int 1/u\\,\\mathrm{d}u=\\ln\\left|u\\right|+C$.\n\n{{answer}} $+C$"}]}
