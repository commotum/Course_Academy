#{[{:db/id #edb/ref 17592186714557 :knowledge-point/_questions [{:db/id #edb/ref 17592186059665 :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas" :topic/_knowledge-points [{:db/id #edb/ref 17592186048319 :topic/title "The Sum and Difference Formulas for Cosine"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69dd262a-0636-50da-bd19-bf579c709cf8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin t" :db/id #edb/ref 17592186714560} {:answer/id #uuid "80062407-40b6-5d3f-84da-7feeb2630c51" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186714562} {:answer/id #uuid "884b547b-d5fc-5ad9-96ae-13937bc26d06" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin t" :db/id #edb/ref 17592186714564} {:answer/id #uuid "8ac94f42-f6f2-58b9-94d7-b9a2320462be" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos t" :db/id #edb/ref 17592186714565} {:answer/id #uuid "b6f15d55-f117-500e-9329-3e1d21808e65" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos t" :db/id #edb/ref 17592186714566}] :answer-field/correct {:answer/id #uuid "b6f15d55-f117-500e-9329-3e1d21808e65" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos t" :db/id #edb/ref 17592186714566} :answer-field/id #uuid "dbe2a294-0cb5-5be5-a390-e51d8b97802f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186714568}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "28e9089c-6417-5772-a8b3-173523505655" :question/problem "Simplify $\\cos(t-\\pi)$ in terms of $\\sin t$ or $\\cos t$.\n\nUse the difference formula\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nand the exact values $\\cos\\pi=-1$ and $\\sin\\pi=0$." :question/worked-solution "Apply the difference formula with $u=t$ and $v=\\pi$:\n\n$$\n\\begin{aligned}\n\\cos(t-\\pi)&=\\cos t\\cos\\pi+\\sin t\\sin\\pi\\\\\n&=\\cos t\\cdot(-1)+\\sin t\\cdot0\\\\\n&=-\\cos t.\n\\end{aligned}\n$$\n\nThe sine term vanishes; the cosine term changes sign."}]}
