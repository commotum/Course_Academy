  "failure_taxonomy": [
    {
      "kind": "upright Greek identifier",
      "example": "source <mi mathvariant=\"normal\">Π</mi> imported as literal Π",
      "visible_effect": "MathJax chooses italic mathematical Pi (1D6F1) instead of upright Pi (3A0).",
      "current_extractor": "Supported: \\mathrm{Π}. Equivalent \\Pi is also correct.",
      "regex_limit": "A naked Π in stored content is only a candidate; source may intentionally be italic. Inherited mstyle normal requires a DOM walk."
    },
    {
      "kind": "bold versus scalar identifier",
      "example": "source bold v or zero becomes v or 0",
      "visible_effect": "Vector/scalar distinction disappears; bold a naming a vector must not bold its scalar component a.",
      "current_extractor": "Supported: \\mathbf, including explicit variants on each node.",
      "regex_limit": "Presence of any \\mathbf in a field does not prove all bold source tokens survived; compare matched formulas/token positions."
    },
    {
      "kind": "double-struck and other alphabet variants",
      "example": "source double-struck R becomes ordinary italic R",
      "visible_effect": "Number-space notation becomes a variable.",
      "current_extractor": "Supported for listed variants; unsupported variants report errors.",
      "regex_limit": "Unicode ℝ, \\mathbb R and \\mathbb{R} can be equivalent. Do not classify by spelling alone."
    },
    {
      "kind": "colored teaching marker",
      "example": "red terminal × or green ✓ loses color",
      "visible_effect": "A failure/check marker appears as an unexplained mathematical operator.",
      "current_extractor": "Supported for named and hex mathcolor; scoped per node.",
      "regex_limit": "Marker regex must be intersected with colored source math and formula context; × is also legitimate multiplication. Colors can be inherited from mstyle/ancestors or CSS."
    },
    {
      "kind": "authored spacing",
      "example": "1em gap before red × becomes 0.167em thin space",
      "visible_effect": "Feedback marker visually merges into equation; larger spacings and negative adjustments disappear.",
      "current_extractor": "Active bug in all three: silent unconditional \\, output.",
      "regex_limit": "0.167em and \\, are effectively equivalent; compare non-default width/height/depth numerically/structurally, including negative dimensions and named math spaces."
    },
    {
      "kind": "mixed legacy title corruption",
      "example": "SVG title contains raw TeX plus newer mjx-container/MathML inside it",
      "visible_effect": "Flattening loses matrix shape, vector style and delimiters.",
      "current_extractor": "Special paths exist, but audit must preserve nested original structure.",
      "regex_limit": "A regex on title text alone cannot reconstruct mixed TeX/MathML; traverse child nodes and select owned assistive MathML."
    }
  ],
  "recommended_regexes": {
    "any_mathvariant_tag": "(?is)<[a-z][\\w:.-]*\\b[^>]*\\bmathvariant\\s*=\\s*([\"'])(?P<variant>[^\"']+)\\1[^>]*>",
    "direct_upright_greek": "(?is)<(?:\\w+:)?mi\\b(?=[^>]*\\bmathvariant\\s*=\\s*[\"']normal[\"'])[^>]*>\\s*[Α-Ωα-ωϐϑϕϖϰϱϵ]\\s*</(?:\\w+:)?mi\\s*>",
    "font_loss_candidates": "(?is)<[a-z][\\w:.-]*\\b[^>]*\\bmathvariant\\s*=\\s*[\"'](?:bold(?:-italic)?|double-struck|script|fraktur|monospace|sans-serif)[\"'][^>]*>",
    "any_color_tag": "(?is)<[a-z][\\w:.-]*\\b[^>]*\\b(?:mathcolor|mathbackground)\\s*=\\s*([\"'])(?P<color>[^\"']+)\\1[^>]*>",
    "check_cross_marker": "[×✓✔✗✘]|\\\\(?:times|checkmark)\\b",
    "authored_space_tag": "(?is)<(?:\\w+:)?mspace\\b[^>]*\\b(?:width|height|depth)\\s*=\\s*([\"'])(?P<dimension>[^\"']+)\\1[^>]*>",
    "svg_title_tex_styles": "\\\\(?:mathrm|mathit|mathbf|boldsymbol|mathbb|mathcal|mathfrak|mathsf|mathtt|mathbfit|color|textcolor|bbox|hspace|kern|mkern|quad|qquad|Pi)\\b|\\\\[,;:!]",
    "css_style_candidates": "(?is)<[a-z][\\w:.-]*\\b[^>]*\\bstyle\\s*=\\s*([\"'])(?P<style>[^\"']*\\b(?:color|background(?:-color)?|font-(?:weight|style|family))\\s*:[^\"']*)\\1[^>]*>"
  },
  "regex_preconditions": [
    "Decode JSON first, then parse/extract HTML fields; HTML-unescape entities before token-marker regexes. Do not apply these patterns directly to serialized escaped JSON.",
    "Patterns are candidate discovery, not proof of failure and never automatic substitutions. Include namespaces and both quote styles. Parse matched HTML to resolve nesting, inherited attributes and formula ownership.",
    "Search all mathvariant values before narrowing to recognized categories; unfamiliar variants should become review gaps, not silently disappear.",
    "For original SVG titles/TeX annotations apply TeX-style regex to the preserved title child stream. For direct MathML apply attribute regex. Keep original source SHA256 and question/component identity.",
    "Normalize semantic math and compare source/current font, marker color and spacing per matched formula. Then use actual renderer glyphs when equivalent TeX spellings create ambiguity.",
    "Check prompts, worked solutions, checkbox labels, answer values and feedback, plus tutorial/canonical content. Intentional checkbox/semantic-statement migrations require component-aware matching."
  ],
