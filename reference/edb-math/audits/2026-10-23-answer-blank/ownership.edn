#{[{:db/id #edb/ref 17592186064281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064125 :question/id #uuid "2bb17470-6365-5e08-b649-f9f42146a4c6" :question/math-academy-id "e-732" :question/problem "Calculate $f'(x)$ if $f(x) = 2\\sin (3x - 1).$" :question/worked-solution "First, we express $f(x)$ as a composite function\n\n$$\nf = 2\\sin u, \\qquad u=3x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = 2\\cos u, \\qquad\\dfrac{\\textrm d u}{\\textrm d x} = 3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2\\operatorname{cos}⁡u\\cdot 3 \\\\  & =6\\operatorname{cos}⁡u \\\\  & =6\\operatorname{cos}⁡(3x-1).\\end{aligned}\n$$"} :knowledge-point/id #uuid "73216188-6524-55c3-b945-86d13ef64170" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050420} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186491440 :question-generator/id #uuid "81161d7f-70af-5c80-8dcb-1391c3b4cb0e" :question-generator/script "generate/scratch/17592186064281.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186064546} {:db/id #edb/ref 17592186064547} {:db/id #edb/ref 17592186233773} {:db/id #edb/ref 17592186233777} {:db/id #edb/ref 17592186234093} {:db/id #edb/ref 17592186234096} {:db/id #edb/ref 17592186297322} {:db/id #edb/ref 17592186297323} {:db/id #edb/ref 17592186297328} {:db/id #edb/ref 17592186297329} {:db/id #edb/ref 17592186332841} {:db/id #edb/ref 17592186491422} {:db/id #edb/ref 17592186491425} {:db/id #edb/ref 17592186491432} {:db/id #edb/ref 17592186491434} {:db/id #edb/ref 17592186491436} {:db/id #edb/ref 17592186544803} {:db/id #edb/ref 17592186575597}] :knowledge-point/title "Differentiating a Trigonometric Function Using the Chain Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050789 :topic/math-academy-id 305 :topic/title "The Chain Rule Wi