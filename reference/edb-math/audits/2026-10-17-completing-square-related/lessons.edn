frac{6x+1}{2})+C" :db/id #edb/ref 17592186249181}] :answer-field/correct {:answer/id #uuid "7c54a2d2-9684-516e-a49e-05b02d5d4c75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C" :db/id #edb/ref 17592186248517} :answer-field/id #uuid "aa53ad0f-77f4-501c-a778-132511875487" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249972}] :question/id #uuid "efd4eb6a-b650-553c-bcc2-ab2b63a8dbe2" :question/math-academy-id "q-114918" :question/problem "$\\int \\frac{1}{\\sqrt{4-{(6x+1)}^{2}}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4-(6x+1)^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{4(1-(6x+1)^{2}/4)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{4}\\cdot \\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{2\\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-((6x+1)/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{6x+1}{2}).$\n\nSo, let's perform the substitution \n\n$$\nu=\\frac{6x+1}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4-(6x+1)^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-((6x+1)/2)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{6}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31c17a05-d2f9-5ba0-b754-dcbfc7f9b4eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x-3}{2})+C" :db/id #edb/ref 17592186247879} {:answer/id #uuid "4ccaaf30-f65e-532d-85cd-8c1ce995b1fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{arcsec}(x-3)+C" :db/id #edb/ref 17592186248111} {:answer/id #uuid "8f1dda95-180f-5a89-bfe9-5307962c3d37" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x-3)+C" :db/id #edb/ref 17592186248697} {:answer/id #uuid "c56c203a-3635-5203-8a26-4d2596b69db1" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x-3)+C" :db/id #edb/ref 17592186249180} {:answer/id #uuid "ec86287a-069c-51b9-9eb7-959c7a23a3fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(2(x-3))+C" :db/id #edb/ref 17592186249500}] :answer-field/correct {:answer/id #uuid "8f1dda95-180f-5a89-bfe9-5307962c3d37" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x-3)+C" :db/id #edb/ref 17592186248697} :answer-field/id #uuid "83644fa9-f278-5c29-b9fd-b62b8c892acc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249900}] :question/id #uuid "d48157cd-3ea4-5a4b-b2a2-ea19ff6fa51b" :question/math-academy-id "q-114923" :question/problem "$\\int \\frac{2}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-3).$\n\nSo, let's perform the substitution \n\n$$\nu=x-3.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(x-3)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29dcd689-72bf-5686-8310-3f4ea4bcf96f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186247794} {:answer/id #uuid "7314371c-12e4-5b55-aa71-8b0815acf1f3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248430} {:answer/id #uuid "87412b14-93b3-5355-a1a5-6ed1ad4a5e68" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248633} {:answer/id #uuid "a875d9a9-1360-585e-bc17-f8dabea475cc" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248921} {:answer/id #uuid "cd50af5e-b746-5d70-8359-da9db445f575" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186249247}] :answer-field/correct {:answer/id #uuid "7314371c-12e4-5b55-aa71-8b0815acf1f3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248430} :answer-field/id #uuid "ecf1fad6-0be7-535a-8535-84a302eff6c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250083}] :question/id #uuid "d6c81b22-316a-514d-b9b9-16489eee9df0" :question/math-academy-id "q-114926" :question/problem "$\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x-7).$\n\nSo, let's perform the substitution \n\n$$\nu=2x-7.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(2x-7)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e292fd4-3a6d-5ea9-bc60-eb76a02ac7f2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x+2)+C" :db/id #edb/ref 17592186346159} {:answer/id #uuid "65d16fde-472a-5454-8885-c24fadefed86" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\frac{x+1}{2})+C" :db/id #edb/ref 17592186346238} {:answer/id #uuid "794e0cf8-9e4e-5f4f-a1ec-e99f27abb154" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x+1)+C" :db/id #edb/ref 17592186346413} {:answer/id #uuid "916efffa-9fa6-558d-b257-5b948a3e436a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x+1)+C" :db/id #edb/ref 17592186346622} {:answer/id #uuid "a2ad6372-a008-5d03-89b1-3818438a388e" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x+2)+C" :db/id #edb/ref 17592186346762}] :answer-field/correct {:answer/id #uuid "794e0cf8-9e4e-5f4f-a1ec-e99f27abb154" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x+1)+C" :db/id #edb/ref 17592186346413} :answer-field/id #uuid "5a5ac89a-0b95-54ab-a1f6-007eed434a51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347761}] :question/id #uuid "f140ef15-884a-5848-bea0-7026afe13f1e" :question/math-academy-id "q-80312" :question/problem "$\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+1).$\n\nSo, let's perform the substitution \n\n$$\nu=x+1.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(x+1)+C\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Inverse Trigonometric Function Integrals Using Substitution"} :step/id #uuid "cb1059e4-1e66-5fbd-b127-18f2fa4cf7eb" :step/next {:db/id #edb/ref 17592186069804}} {:db/id #edb/ref 17592186069804 :step/content {:db/id #edb/ref 17592186068854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068504 :question/id #uuid "648e9e50-03bf-56ba-a4ad-caf142c9628a" :question/math-academy-id "e-14574" :question/problem "Calculate $\\displaystyle \\int \\dfrac{1}{x^2-2x + 3}\\, \\textrm{d}x.$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\eqalign{\nx^2-2x + 3\n& = x^2 - 2 \\cdot x+ (1^2 - 1^2) + 3 \\[3pt]\n& = (x^2 - 2 \\cdot x+ 1^2) - 1 + 3 \\[3pt]\n& = (x-1)^2+2\n}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-2x+3}\\,\\text{d}x & =\\int \\frac{1}{(x-1)^{2}+2}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+((x-1)/\\sqrt{2})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\dfrac{1}{1+u^2} \\, \\textrm{d}u\n=\n\\arctan u + C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\left(\\dfrac{x-1}{\\sqrt{2}}\\right).$\n\nSo, let's perform the substitution\n\n$$\nu=\\dfrac{x-1}{\\sqrt{2}}.\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{\\sqrt{2}}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\sqrt{2}\\,\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-2x+3}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+((x-1)/\\sqrt{2})^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{2}}{2}\\operatorname{arctan}⁡(\\frac{x-1}{\\sqrt{2}})+C\\end{aligned}\\end{aligned}\n$$"} :knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff" :knowledge-point/questions [{:db/id #edb/ref 17592186069282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67c3a1db-119e-5acf-9a09-e1b123cb6a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x+2)+C" :db/id #edb/ref 17592186321958} {:answer/id #uuid "6ae0275c-cc30-50ee-b708-ba1496f49e5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x-2}{3})+C" :db/id #edb/ref 17592186321982} {:answer/id #uuid "8a37ad44-5363-5c8a-9452-384bf55bfec2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x+2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186322250} {:answer/id #uuid "c0b212eb-1b6b-52f4-856b-b6d2907bae74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x-2)+C" :db/id #edb/ref 17592186322646} {:answer/id #uuid "fbe4dd98-fdc8-542c-8023-a647e8bbcf6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186323136}] :answer-field/correct {:answer/id #uuid "fbe4dd98-fdc8-542c-8023-a647e8bbcf6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186323136} :answer-field/id #uuid "26cc15b6-f5cf-5aac-b6f5-1e3c4c37f90f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323243}] :question/id #uuid "87d8f51d-ee05-5977-8eb0-8be27f9cb800" :question/math-academy-id "q-3596" :question/problem "$\\int \\frac{1}{{x}^{2}-4x+7}\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+7 & ={x}^{2}-2\\cdot 2x+({2}^{2}-{2}^{2})+7 \\\\  & =({x}^{2}-2\\cdot 2x+{2}^{2})-4+7 \\\\  & =(x-2)^{2}+3\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-4x+7}\\,\\text{d}x & =\\int \\frac{1}{(x-2)^{2}+3}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+((x-2)/\\sqrt{3})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-2}{\\sqrt{3}}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-2}{\\sqrt{3}}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-4x+7}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{1+((x-2)/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+{u}^{2}}\\cdot \\sqrt{3}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ca0a028-161d-529e-83af-69439650454a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2π}{3}" :db/id #edb/ref 17592186067571} {:answer/id #uuid "af5f060e-eb7a-5548-bd10-79214346e475" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4π}{3}" :db/id #edb/ref 17592186067572} {:answer/id #uuid "5dd1094f-9a1e-5888-ac06-c645b3f368be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186067573} {:answer/id #uuid "713fc8f5-ad93-5dc5-a007-9c08ec38c72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3π}{2}" :db/id #edb/ref 17592186067574} {:answer/id #uuid "7f359441-fbb1-55eb-9b0f-57e85824fb66" :answer/type {:db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186067575}] :answer-field/id #uuid "e9b774de-78b1-59c8-ad8e-28bcfd89e658" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067570}] :question/id #uuid "fa9d7e89-76f2-504d-9a39-58601595673e" :question/math-academy-id "q-49937" :question/problem "Evaluate the integral $\\displaystyle \\int_{-2}^{\\sqrt{3} - 3}\\frac{8}{x^{2} + 6x + 10}dx$."} {:db/id #edb/ref 17592186250320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0188c738-8d3f-5f42-b61d-b6905e5bfdd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C" :db/id #edb/ref 17592186247429} {:answer/id #uuid "3788c026-240f-51ce-96e4-36b327b09c8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x-3)+C" :db/id #edb/ref 17592186247924} {:answer/id #uuid "52b4f6b7-1404-5c2e-b939-52278a731f90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{9})+C" :db/id #edb/ref 17592186248167} {:answer/id #uuid "7654b839-b02e-5d72-8ce8-e1293aaa3cad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(x-3)+C" :db/id #edb/ref 17592186248466} {:answer/id #uuid "b5aaf4ce-721d-5f9e-8dc0-70a1acafef73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C" :db/id #edb/ref 17592186249050}] :answer-field/correct {:answer/id #uuid "b5aaf4ce-721d-5f9e-8dc0-70a1acafef73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C" :db/id #edb/ref 17592186249050} :answer-field/id #uuid "8b8f6cff-c895-5917-993d-b2d120420f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249915}] :question/id #uuid "4c6784ae-fdbb-5b66-87d7-0cf88bfc85a0" :question/math-academy-id "q-114910" :question/problem "$\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-6x+18 & ={x}^{2}-2\\cdot 3x+({3}^{2}-{3}^{2})+18 \\\\  & =({x}^{2}-2\\cdot 3x+{3}^{2})-9+18 \\\\  & =(x-3)^{2}+9\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x & =\\int \\frac{1}{(x-3)^{2}+9}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+((x-3)/3)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-3}{3}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-3}{3}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+((x-3)/3)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot 3\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae5f597-51dc-537c-97d8-2213e77b66a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186285163} {:answer/id #uuid "5c981f04-9a7b-5f9e-b012-5b3ed4e5537d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186285636} {:answer/id #uuid "60c0e328-a8db-5493-aa2a-248624490bd2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285677} {:answer/id #uuid "b5fee3b0-7e49-5f47-8edd-50fc138289e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286448} {:answer/id #uuid "bbeecb8d-8395-52f9-b6fb-7671c4b447e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186286499}] :answer-field/correct {:answer/id #uuid "2ae5f597-51dc-537c-97d8-2213e77b66a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186285163} :answer-field/id #uuid "b5818e62-465a-5e39-9967-d2bce0bca1bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287522}] :question/id #uuid "7599d445-5344-5472-bfea-dd4cab006b2e" :question/math-academy-id "q-19527" :question/problem "Evaluate the integral ${\\int }_{3}^{3+\\sqrt{3}}\\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-6x+10 & ={x}^{2}-2\\cdot 3x+({3}^{2}-{3}^{2})+10 \\\\  & =({x}^{2}+2\\cdot 3x+{3}^{2})-9+10 \\\\  & =(x-3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x & =\\int \\frac{5}{(x-3)^{2}+1}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{1+(x-3)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-3).$\n\nSo, let's perform the substitution\n\n$$\nu=x-3.\n$$\n\n \nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $3$ | $3+\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{3}^{3+\\sqrt{3}}\\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x & =5{\\int }_{3}^{3+\\sqrt{3}}\\frac{1}{1+(x-3)^{2}}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =5\\operatorname{arctan}⁡u\\,{|}_{0}^{\\sqrt{3}} \\\\  & =5(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡0) \\\\  & =5(\\frac{\\pi }{3}-0) \\\\  & =5(\\frac{\\pi }{3}) \\\\  & =\\frac{5\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d659652f-4675-56ba-94dc-9e4c7d51f754" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186318277}] :answer-field/correct {:answer/id #uuid "d659652f-4675-56ba-94dc-9e4c7d51f754" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186318277} :answer-field/id #uuid "477d5e91-a032-5984-8576-8ecd87b3defd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318579}] :question/id #uuid "300d8b9a-8fa6-522c-8c63-eee3475f0ab0" :question/math-academy-id "q-348553" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-3}^{\\sqrt{3}-3}\\frac{6}{{x}^{2}+6x+10}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+10 & ={x}^{2}+2\\cdot 3x+({3}^{2}-{3}^{2})+10 \\\\  & =({x}^{2}+2\\cdot 3x+{3}^{2})-9+10 \\\\  & =(x+3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}+6x+10}\\,\\text{d}x & =\\int \\frac{6}{(x+3)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x+3)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+3).$\n\nSo, let's perform the substitution\n\n$$\nu=x+3.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-3$ | $\\sqrt{3}-3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{\\sqrt{3}-3}\\frac{6}{{x}^{2}+6x+10}\\,\\text{d}x & =6{\\int }_{0}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{0}^{\\sqrt{3}} \\\\  & =6(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡(0)) \\\\  & =6(\\frac{\\pi }{3}-0) \\\\  & =2\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186319264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "778a582d-ea0f-55e8-bf04-1f6f33d24848" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186317974}] :answer-field/correct {:answer/id #uuid "778a582d-ea0f-55e8-bf04-1f6f33d24848" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186317974} :answer-field/id #uuid "64e67d9c-4cdd-54b3-9e59-0a2243fd10d4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318641}] :question/id #uuid "9ae8ff40-323b-5106-b233-450ffba3e186" :question/math-academy-id "q-348554" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3}\\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+5 & ={x}^{2}-2\\cdot 2x+({2}^{2}-{2}^{2})+5 \\\\  & =({x}^{2}-2\\cdot 2x+{2}^{2})-4+5 \\\\  & =(x-2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x & =\\int \\frac{6}{(x-2)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x-2)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-2).$\n\nSo, let's perform the substitution\n\n$$\nu=x-2.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x & =6{\\int }_{-1}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{-1}^{1} \\\\  & =6(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(-1)) \\\\  & =6(\\frac{\\pi }{4}-(-\\frac{\\pi }{4})) \\\\  & =6(\\frac{\\pi }{2}) \\\\  & =3\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186319265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a387894e-1aa9-5b94-892e-fdc3e5365b84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186318127}] :answer-field/correct {:answer/id #uuid "a387894e-1aa9-5b94-892e-fdc3e5365b84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186318127} :answer-field/id #uuid "6f5c6ce3-3264-5d12-918a-88126d369913" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318664}] :question/id #uuid "3d03c752-2f01-5331-91ed-02e39cb4137e" :question/math-academy-id "q-348555" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-4}^{-3}\\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+8x+17 & ={x}^{2}+2\\cdot 4x+({4}^{2}-{4}^{2})+17 \\\\  & =({x}^{2}+2\\cdot 4x+{4}^{2})-16+17 \\\\  & =(x+4)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x & =\\int \\frac{6}{(x+4)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x+4)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-4$ | $-3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-3}\\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x & =6{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{0}^{1} \\\\  & =6(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =6(\\frac{\\pi }{4}-0) \\\\  & =\\frac{3\\pi }{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c473cf-9a6d-5243-afee-2a9a22ea295c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{2}" :db/id #edb/ref 17592186317680}] :answer-field/correct {:answer/id #uuid "24c473cf-9a6d-5243-afee-2a9a22ea295c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{2}" :db/id #edb/ref 17592186317680} :answer-field/id #uuid "02cb7d9f-15cb-5de3-b16f-f7c775c110ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318428}] :question/id #uuid "2760d8ee-c80d-54ee-9960-fe327a71f143" :question/math-academy-id "q-348563" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-7}^{\\sqrt{3}-6}\\frac{6}{{x}^{2}+12x+37}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+12x+37 & ={x}^{2}+2\\cdot 6x+({6}^{2}-{6}^{2})+37 \\\\  & =({x}^{2}+2\\cdot 6x+{6}^{2})-36+37 \\\\  & =(x+6)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}+12x+37}\\,\\text{d}x & =\\int \\frac{6}{(x+6)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x+6)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+6).$\n\nSo, let's perform the substitution\n\n$$\nu=x+6.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-7$ | $\\sqrt{3}-6$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-7}^{\\sqrt{3}-6}\\frac{6}{{x}^{2}+12x+37}\\,\\text{d}x & =6{\\int }_{-1}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{-1}^{\\sqrt{3}} \\\\  & =6(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡(-1)) \\\\  & =6(\\frac{\\pi }{3}-(-\\frac{\\pi }{4})) \\\\  & =6(\\frac{7\\pi }{12}) \\\\  & =\\frac{7\\pi }{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76643950-59ab-5f7a-be34-ee1ed0632a65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186317971}] :answer-field/correct {:answer/id #uuid "76643950-59ab-5f7a-be34-ee1ed0632a65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186317971} :answer-field/id #uuid "963661af-e3ad-557e-a178-857097572d61" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318757}] :question/id #uuid "65ee6f5f-82eb-5042-a628-9182bdef4e50" :question/math-academy-id "q-348570" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4-1/\\sqrt{3}}^{5}\\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-8x+17 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+17 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+17 \\\\  & =(x-4)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x & =\\int \\frac{3}{(x-4)^{2}+1}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{1+(x-4)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-4).$\n\nSo, let's perform the substitution\n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $4-\\frac{1}{\\sqrt{3}}$ | $5$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{\\sqrt{3}}$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{4-1/\\sqrt{3}}^{5}\\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x & =3{\\int }_{-1/\\sqrt{3}}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =3\\operatorname{arctan}⁡u\\,{|}_{-1/\\sqrt{3}}^{1} \\\\  & =3(\\operatorname{arctan}⁡(1)-arctan\\,(-\\frac{1}{\\sqrt{3}})) \\\\  & =3(\\frac{\\pi }{4}-(-\\frac{\\pi }{6})) \\\\  & =3(\\frac{5\\pi }{12}) \\\\  & =\\frac{5\\pi }{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d38f6099-0eb7-5b1f-b702-3d8dc7e8a65b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{3}" :db/id #edb/ref 17592186318267}] :answer-field/correct {:answer/id #uuid "d38f6099-0eb7-5b1f-b702-3d8dc7e8a65b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{3}" :db/id #edb/ref 17592186318267} :answer-field/id #uuid "c942d526-8802-5337-aa52-cffd5ded6ea1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318853}] :question/id #uuid "c0b71dd0-a85a-5859-a5eb-f867799838ab" :question/math-academy-id "q-348571" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{5+\\sqrt{3}}\\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-10x+26 & ={x}^{2}-2\\cdot 5x+({5}^{2}-{5}^{2})+26 \\\\  & =({x}^{2}-2\\cdot 5x+{5}^{2})-25+26 \\\\  & =(x-5)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x & =\\int \\frac{7}{(x-5)^{2}+1}\\,\\text{d}x \\\\  & =7\\int \\frac{1}{1+(x-5)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-5).$\n\nSo, let's perform the substitution\n\n$$\nu=x-5.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $5$ | $5+\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{5}^{5+\\sqrt{3}}\\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x & =7{\\int }_{0}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =7\\operatorname{arctan}⁡u\\,{|}_{0}^{\\sqrt{3}} \\\\  & =7(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡(0)) \\\\  & =7(\\frac{\\pi }{3}-0) \\\\  & =\\frac{7\\pi }{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12971660-0666-53e4-a242-f293c1e8accb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186317626}] :answer-field/correct {:answer/id #uuid "12971660-0666-53e4-a242-f293c1e8accb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186317626} :answer-field/id #uuid "3755137b-e240-539f-9362-6851372f9187" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318539}] :question/id #uuid "67805982-e3cf-5a33-88b0-53b47f04b8dd" :question/math-academy-id "q-348572" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{5}\\frac{8}{{x}^{2}-8x+17}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-8x+17 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+17 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+17 \\\\  & =(x-4)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{8}{{x}^{2}-8x+17}\\,\\text{d}x & =\\int \\frac{8}{(x-4)^{2}+1}\\,\\text{d}x \\\\  & =8\\int \\frac{1}{1+(x-4)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-4).$\n\nSo, let's perform the substitution\n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $4$ | $5$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{4}^{5}\\frac{8}{{x}^{2}-8x+17}\\,\\text{d}x & =8{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =8\\operatorname{arctan}⁡u\\,{|}_{0}^{1} \\\\  & =8(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =8(\\frac{\\pi }{4}-0) \\\\  & =2\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186323726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c0c3933-f2eb-5430-9130-c222c7dd3385" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x-4}{4})+C" :db/id #edb/ref 17592186321486} {:answer/id #uuid "2dced506-c98b-54f2-b521-a33b0d31abca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x-4}{2})+C" :db/id #edb/ref 17592186321505} {:answer/id #uuid "80578236-5da7-59f5-bd63-88412bcc2467" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{cot}^{-1}⁡(\\frac{x-4}{4})+C" :db/id #edb/ref 17592186322155} {:answer/id #uuid "b8492909-14e1-53f7-8fa9-31eb444b5dc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arccos}⁡(\\frac{x-4}{4})+C" :db/id #edb/ref 17592186322580} {:answer/id #uuid "f8841ffb-1d88-5c6c-a30f-dff18090dbb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cot}^{-1}⁡(\\frac{x-4}{2})+C" :db/id #edb/ref 17592186323102}] :answer-field/correct {:answer/id #uuid "2dced506-c98b-54f2-b521-a33b0d31abca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x-4}{2})+C" :db/id #edb/ref 17592186321505} :answer-field/id #uuid "be8e3c92-c6bd-5872-9009-f104c52acf8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323542}] :question/id #uuid "9ddbb116-5940-52b1-bf90-b7efeb6e8633" :question/math-academy-id "q-3588" :question/problem "$\\int \\frac{1}{{x}^{2}-8x+20}\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-8x+20 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+20 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+20 \\\\  & =(x-4)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-8x+20}\\,\\text{d}x & =\\int \\frac{1}{(x-4)^{2}+4}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+((x-4)/2)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-4}{2}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-4}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-8x+20}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1+((x-4)/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x-4}{2})+C\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Computing an Arctangent Integral by Completing the Square"} :step/id #uuid "cd1fd0e6-a7e9-5fa2-8560-798eef76b3dd" :step/next {:db/id #edb/ref 17592186069805}} {:db/id #edb/ref 17592186069805 :step/content {:db/id #edb/ref 17592186068855 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068505 :question/id #uuid "77952d82-6a9b-5a6b-921e-32cbe82ea298" :question/math-academy-id "e-14575" :question/problem "Calculate ${\\displaystyle \\int \\dfrac{1}{\\sqrt{4x - 4x^2}} \\, \\textrm{d}x}.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4x-4{x}^{2} & =-(4{x}^{2}-4x) \\\\  & =-((2x)^{2}-2\\cdot 2x+1-1) \\\\  & =-((2x-1)^{2}-1) \\\\  & =1-(2x-1)^{2}\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4x-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x-1)^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\,\\textrm{d}u = \\arcsin u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x - 1).$  \n\nSo, let's perform the substitution\n\n$$\nu =2x - 1.\n$$\n\nDifferentiating, we get \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\dfrac12\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4x-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x-1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡(2x-1)+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a" :knowledge-point/questions [{:db/id #edb/ref 17592186069171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68e00ece-3332-5f0f-b59c-11045c060d89" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}" :db/id #edb/ref 17592186288767} {:answer/id #uuid "761a6701-8961-546a-b212-c98c4fbfc1ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186288850} {:answer/id #uuid "cd59d288-6229-56af-81b6-b4ead16a7499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186289401} {:answer/id #uuid "cd7e3828-7766-562c-b628-34b107549138" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186289402} {:answer/id #uuid "f553b8da-e80a-55a1-a36f-a6e33554962b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186289650}] :answer-field/correct {:answer/id #uuid "cd59d288-6229-56af-81b6-b4ead16a7499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186289401} :answer-field/id #uuid "c5829d08-72ba-56f4-86f2-a84b8f039183" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290156}] :question/id #uuid "d8f3f828-4a9b-54dd-a6d3-6f4468d7c192" :question/math-academy-id "q-238056" :question/problem "Evaluate the integral ${\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-12x-35 & =-({x}^{2}+12x+35) \\\\  & =-({x}^{2}+2\\cdot 6x+[{6}^{2}-{6}^{2}]+35) \\\\  & =-((x+6)^{2}-1) \\\\  & =1-(x+6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x={\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{1-(x+6)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x+6.$\n\nSo, let's perform the substitution\n\n$$\nu=x+6.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-13/2$ | $-11/2$ |\n| --- | --- | --- |\n| $u$ | $-1/2$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x & ={\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{1-(x+6)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}-(-\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cf60cc0-0176-5d63-a5ad-319ac2ffdc3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\arccos (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186066857} {:answer/id #uuid "c2591fd8-b4ad-5d49-a54d-d43929caa1e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\arcsin (x - 3) + C" :db/id #edb/ref 17592186066858} {:answer/id #uuid "3f3b3048-1124-5408-9ff7-320533431cc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\arcsin (\\frac{x + 3}{3}) + C" :db/id #edb/ref 17592186066859} {:answer/id #uuid "4f9cdc08-13d8-59d4-8bac-3a3fb9f2ea8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\arcsin (x + 3) + C" :db/id #edb/ref 17592186066860} {:answer/id #uuid "7d6e9b82-e96d-5952-ae17-b152a68e5fc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\arccos (x + 3) + C" :db/id #edb/ref 17592186066861}] :answer-field/id #uuid "55e38742-513f-52eb-bbd2-eb1d8093f1c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066856}] :question/id #uuid "567f832d-7383-5daa-9fd7-bc7519727ba1" :question/math-academy-id "q-3591" :question/problem "What is $\\displaystyle \\int\\frac{1}{\\sqrt{-8 + 6x - x^{2}}}dx$?"} {:db/id #edb/ref 17592186292695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24525713-bf70-55fd-abab-0c1845d05c1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186290785} {:answer/id #uuid "35ea1169-3275-56a8-bd81-03dc1bc51fe4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186290853} {:answer/id #uuid "5d00a6fc-ad42-58d1-8f01-afeda4d695a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{3}" :db/id #edb/ref 17592186291029} {:answer/id #uuid "a5916820-d3d4-5edd-990e-38c3bc72b296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14\\pi }{3}" :db/id #edb/ref 17592186291354} {:answer/id #uuid "e7f6083c-3821-5677-8a34-2877a31b741e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186291603}] :answer-field/correct {:answer/id #uuid "a5916820-d3d4-5edd-990e-38c3bc72b296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14\\pi }{3}" :db/id #edb/ref 17592186291354} :answer-field/id #uuid "7596f1e0-8097-5f7f-bb0e-59032dfd6b04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292102}] :question/id #uuid "0889b5ca-5401-5843-aac6-1c3eb1c8a759" :question/math-academy-id "q-270043" :question/problem "Evaluate the integral ${\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{1-2x-{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}1-2x-{x}^{2} & =1-({x}^{2}+2x) \\\\  & =1-({x}^{2}+2x+1-1) \\\\  & =1-((x+1)^{2}-1) \\\\  & =2-(x+1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{1-2x-{x}^{2}}}\\,\\text{d}x & ={\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{2-(x+1)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{2(1-(x+1)^{2}/2)}}\\,\\text{d}x \\\\  & ={\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{2}\\cdot \\sqrt{1-(x+1)^{2}/(\\sqrt{2})^{2}}}\\,\\text{d}x \\\\  & =\\frac{14}{\\sqrt{2}}{\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{1-((x+1)/\\sqrt{2})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+1}{\\sqrt{2}}).$\n\nSo, let's perform the substitution\n\n$$\nu=(\\frac{x+1}{\\sqrt{2}}).\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{2}}\\,⟹\\,\\text{d}x=\\sqrt{2}\\,\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-1-\\sqrt{2}/2$ | $-1+\\sqrt{2}/2$ |\n| --- | --- | --- |\n| $u$ | $-1/2$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{14}{\\sqrt{1+2x-{x}^{2}}}\\,\\text{d}x & =\\frac{14}{\\sqrt{2}}{\\int }_{-1-\\sqrt{2}/2}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{1-((x+1)/\\sqrt{2})^{2}}}\\,\\text{d}x \\\\  & =\\frac{14}{\\sqrt{2}}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{2}\\,\\text{d}u. \\\\  & =14{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =14\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =14(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2})) \\\\  & =14(\\frac{\\pi }{6}-(-\\frac{\\pi }{6})) \\\\  & =\\frac{14\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1377c96f-21fc-51fb-8305-3bcbd43e0831" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186290712} {:answer/id #uuid "1a0db884-e2e8-5bb9-91dd-6d41ae5f204f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186290741} {:answer/id #uuid "50ebd29b-208a-5d56-90e2-e4954122c36c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186290978} {:answer/id #uuid "8ffa1fa3-01fa-5458-83f4-d55488f88570" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186291250} {:answer/id #uuid "c89344f3-53f2-5536-af33-917ad134ae7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186291494}] :answer-field/correct {:answer/id #uuid "8ffa1fa3-01fa-5458-83f4-d55488f88570" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186291250} :answer-field/id #uuid "1e1f01e4-776e-5a83-8671-70533062147c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291848}] :question/id #uuid "b1a15b56-fccd-50eb-8563-117b4ea3220a" :question/math-academy-id "q-270103" :question/problem "Evaluate the integral ${\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-12-x(x+12) & =-12-({x}^{2}+12x) \\\\  & =-12-({x}^{2}+12x+36-36) \\\\  & =-12-((x+6)^{2}-36) \\\\  & =24-(x+6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24-(x+6)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24(1-(x+6)^{2}/24)}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24}\\cdot \\sqrt{1-(x+6)^{2}/(2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+6}{2\\sqrt{6}}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x+6}{2\\sqrt{6}}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{6}}\\,⟹\\,\\text{d}x=2\\sqrt{6}\\,\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-6-\\sqrt{6}$ | $-6+\\sqrt{6}$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 2\\sqrt{6}\\,\\text{d}u. \\\\  & =15{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =15\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =15(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2})) \\\\  & =15(\\frac{\\pi }{6}-(-\\frac{\\pi }{6})) \\\\  & =5\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9809b8-87c8-582a-808c-26cec644f54f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186290746} {:answer/id #uuid "730ea799-4109-5d6f-af23-7144fe907b41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{3}" :db/id #edb/ref 17592186291125} {:answer/id #uuid "76c0c3a2-840b-59e6-9a30-453c5765f92f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186291137} {:answer/id #uuid "8bc80dc4-cf10-5475-80b5-614593b3c2ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186291227} {:answer/id #uuid "8d40a91a-c811-5fd4-9c25-3bfc390521de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186291235}] :answer-field/correct {:answer/id #uuid "1b9809b8-87c8-582a-808c-26cec644f54f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186290746} :answer-field/id #uuid "b411dfbd-b727-5e3b-b7bc-d9d35be5e6af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292292}] :question/id #uuid "9496cc14-8bc3-58e6-be87-2cbb72457c80" :question/math-academy-id "q-270105" :question/problem "Evaluate the integral ${\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-4x-3 & =-({x}^{2}+4x+3) \\\\  & =-({x}^{2}+2\\cdot 2x+[{2}^{2}-{2}^{2}]+3) \\\\  & =-((x+2)^{2}-1) \\\\  & =1-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x={\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x+2.$\n\nSo, let's perform the substitution\n\n$$\nu=x+2.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-5/2$ | $-3/2$ |\n| --- | --- | --- |\n| $u$ | $-1/2$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x & ={\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76c17acb-6457-5886-9ff2-ff91bb4ecbbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186317973}] :answer-field/correct {:answer/id #uuid "76c17acb-6457-5886-9ff2-ff91bb4ecbbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186317973} :answer-field/id #uuid "874e2d16-8e34-579f-8e23-5bc989a9da8d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318719}] :question/id #uuid "084c0a1a-3b23-52a0-be86-625685b44c64" :question/math-academy-id "q-348330" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{-1/2}\\frac{1}{\\sqrt{-x(x+2)}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-x(x+2) & =-({x}^{2}+2x) \\\\  & =-({x}^{2}+2\\cdot 1x+[{1}^{2}-{1}^{2}]) \\\\  & =-((x+1)^{2}-1) \\\\  & =1-(x+1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-1}^{-1/2}\\frac{1}{\\sqrt{-x(x+2)}}\\,\\text{d}x={\\int }_{-1}^{-1/2}\\frac{1}{\\sqrt{1-(x+1)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+1).$\n\nSo, let's perform the substitution\n\n$$\nu=x+1.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-1$ | $-1/2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{-1/2}\\frac{1}{\\sqrt{-x(x+2)}}\\,\\text{d}x & ={\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{0}^{1/2} \\\\  & =arcsin\\,(\\frac{1}{2})-arcsin\\,(0) \\\\  & =\\frac{\\pi }{6}-0 \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "354ccba6-4642-55d3-971d-ff4ca55e1306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186317734}] :answer-field/correct {:answer/id #uuid "354ccba6-4642-55d3-971d-ff4ca55e1306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186317734} :answer-field/id #uuid "4372872a-43e8-5e7f-bcf2-e151efaff712" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318567}] :question/id #uuid "bda87ebf-c11d-539d-beb7-42e0b943e143" :question/math-academy-id "q-348547" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-2x & =-({x}^{2}+2x) \\\\  & =-({x}^{2}+2\\cdot 1x+[{1}^{2}-{1}^{2}]) \\\\  & =-((x+1)^{2}-1) \\\\  & =1-(x+1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x={\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{1-(x+1)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+1).$\n\nSo, let's perform the substitution\n\n$$\nu=x+1.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-1$ | $-1+\\frac{\\sqrt{2}}{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{2}}{2}$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{2}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{0}^{\\sqrt{2}/2} \\\\  & =arcsin\\,(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{\\pi }{4}-0 \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5234ffcf-f5a8-57ff-9b16-9b9c2f10aee4" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186317837}] :answer-field/correct {:answer/id #uuid "5234ffcf-f5a8-57ff-9b16-9b9c2f10aee4" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186317837} :answer-field/id #uuid "67416e31-0417-50b7-b78f-028611abdfb1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318645}] :question/id #uuid "85ef0dc2-d9d3-5cf0-9efe-27fab192419c" :question/math-academy-id "q-348550" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-18x-80 & =-({x}^{2}+18x+80) \\\\  & =-({x}^{2}+2\\cdot 9x+[{9}^{2}-{9}^{2}]+80) \\\\  & =-((x+9)^{2}-1) \\\\  & =1-(x+9)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x={\\int }_{-10}^{-8}\\frac{1}{\\sqrt{1-(x+9)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+9).$\n\nSo, let's perform the substitution\n\n$$\nu=x+9.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-10$ | $-8$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x & ={\\int }_{-1}^{1}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1}^{1} \\\\  & =\\operatorname{arcsin}⁡(1)-\\operatorname{arcsin}⁡(-1) \\\\  & =\\frac{\\pi }{2}-(-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb97f34-32f2-5fbb-aec5-57ace0fbaad6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(x+4)+C" :db/id #edb/ref 17592186321872} {:answer/id #uuid "8b638a94-901f-5e77-bbce-f68bb55836a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(x-4)+C" :db/id #edb/ref 17592186322260} {:answer/id #uuid "c656713f-8a67-5fd6-8734-5401564b9a80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(x+4)+C" :db/id #edb/ref 17592186322683} {:answer/id #uuid "d689d4b8-8b89-5de7-b04a-9ad318e85b1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡(\\frac{x-4}{4})+C" :db/id #edb/ref 17592186322822} {:answer/id #uuid "ee7edee3-ab4b-5148-91d5-eeb3f01579ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x-4}{4})+C" :db/id #edb/ref 17592186323027}] :answer-field/correct {:answer/id #uuid "c656713f-8a67-5fd6-8734-5401564b9a80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(x+4)+C" :db/id #edb/ref 17592186322683} :answer-field/id #uuid "7a9b73dc-645a-581e-bb60-7a672cb6e2c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323409}] :question/id #uuid "84868fd8-3ce0-5bf2-96b8-b86160226a86" :question/math-academy-id "q-3594" :question/problem "$\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-8x-15 & =-({x}^{2}+8x+15) \\\\  & =-({x}^{2}+2\\cdot 4x+[{4}^{2}-{4}^{2}]+15) \\\\  & =-((x+4)^{2}-1) \\\\  & =1-(x+4)^{2}\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x=\\int \\frac{1}{\\sqrt{1-(x+4)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(x+4)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(x+4)+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38443001-42f7-5354-910c-d2bda1d2489f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡(x-3)+C" :db/id #edb/ref 17592186330451} {:answer/id #uuid "51f9d630-7059-5b2c-a570-244434b31bbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x-3}{4})+C" :db/id #edb/ref 17592186330693} {:answer/id #uuid "80e7251c-9714-530e-bd0c-307cd40efb8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡(\\frac{x-4}{3})+C" :db/id #edb/ref 17592186331092} {:answer/id #uuid "ba8b59b8-3d3d-5312-b267-a0ef3e145541" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arcsin}⁡(\\frac{x+4}{3})+C" :db/id #edb/ref 17592186331597} {:answer/id #uuid "ffd6c1db-a953-5e1e-9e0c-ca534d859d15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcsin}⁡(\\frac{x-3}{4})+C" :db/id #edb/ref 17592186332198}] :answer-field/correct {:answer/id #uuid "51f9d630-7059-5b2c-a570-244434b31bbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x-3}{4})+C" :db/id #edb/ref 17592186330693} :answer-field/id #uuid "3810e1f1-bba5-549c-8da7-558d1cab6398" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332295}] :question/id #uuid "7a3d68b6-b7c9-51b5-a32f-dec5ef3543dd" :question/math-academy-id "q-49655" :question/problem "$\\int \\frac{1}{\\sqrt{7+6x-{x}^{2}}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}7+6x-{x}^{2} & =-({x}^{2}-6x-7) \\\\  & =-({x}^{2}-2\\cdot 3x+[{3}^{2}-{3}^{2}]-7) \\\\  & =-((x-3)^{2}-16) \\\\  & =16-(x-3)^{2}\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{7+6x-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{16-(x-3)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{16(1-(x-3)^{2}/16)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{16}\\cdot \\sqrt{1-(x-3)^{2}/16}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{4\\sqrt{1-(x-3)^{2}/16}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{\\sqrt{1-((x-3)/4)^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-3}{4}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-3}{4}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{7+6x-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{\\sqrt{1-((x-3)/4)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 4\\,\\text{d}u \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(\\frac{x-3}{4})+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35ceb9bc-32d1-5e15-a733-fddde56fa205" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcsin}⁡(\\frac{x-3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330430} {:answer/id #uuid "3814f410-4692-533f-ab4d-9fc4e28c8766" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{11})+C" :db/id #edb/ref 17592186330449} {:answer/id #uuid "402c58c4-6fc4-5b10-b233-048c89f390b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{33}}\\operatorname{arcsin}⁡(x+3)+C" :db/id #edb/ref 17592186330522} {:answer/id #uuid "4edd4e6d-9d85-570a-818c-e40797a3d8e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330666} {:answer/id #uuid "6fcef366-c806-5aba-853e-73a4a9c9ca91" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{11}\\operatorname{arcsin}⁡(\\frac{x+11}{\\sqrt{3}})+C" :db/id #edb/ref 17592186330953}] :answer-field/correct {:answer/id #uuid "4edd4e6d-9d85-570a-818c-e40797a3d8e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C" :db/id #edb/ref 17592186330666} :answer-field/id #uuid "3df9f5da-1d1a-5b9b-a71c-2f5dea7ce56e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332305}] :question/id #uuid "9d8b04a6-d5ee-5401-b693-4f822d6507a5" :question/math-academy-id "q-49934" :question/problem "$\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-3{x}^{2}-18x+6 & =-3({x}^{2}+6x-2) \\\\  & =-3({x}^{2}+2\\cdot 3x+[{3}^{2}-{3}^{2}]-2) \\\\  & =-3({(x+3)}^{2}-11) \\\\  & =3(11-{(x+3)}^{2})\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{3(11-{(x+3)}^{2})}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{33(1-(x+3)^{2}/11)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{33}\\cdot \\sqrt{1-(x+3)^{2}/11}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-((x+3)/\\sqrt{11})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+3}{\\sqrt{11}}).$  \n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x+3}{\\sqrt{11}}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{11}}\\,⟹\\,\\text{d}x=\\sqrt{11}\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{-3{x}^{2}-18x+6}}\\,\\text{d}x & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-((x+3)/\\sqrt{11})^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{33}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{11}\\,\\text{d}u \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{\\sqrt{3}}\\operatorname{arcsin}⁡(\\frac{x+3}{\\sqrt{11}})+C.\\end{aligned}\n$$"}] :knowledge-point/title "Computing an Arcsine Integral by Completing the Square"} :step/id #uuid "ffc36223-0640-50b6-bde4-0b7af3bf0642" :step/next {:db/id #edb/ref 17592186069806}} {:db/id #edb/ref 17592186069806 :step/content {:db/id #edb/ref 17592186068856 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068506 :question/id #uuid "4e0188f0-4d2b-5f3c-b1bd-12270e3adc0f" :question/math-academy-id "e-14576" :question/problem "Evaluate the integral $\\displaystyle{\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x}.$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\eqalign{\n    x^2-2x&= x^2 -2x +(1-1)\\[3pt]\n              &= (x^2 -2x +1)-1\\[3pt]\n         &= (x-1)^2-1\n         \n  }\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n= \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\, \\textrm{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\, \\textrm{d}u = \\textrm{arcsec} \\, u +C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-1.$\n\nSo, let's perform the substitution\n\n$$\nu=x-1.\n$$\n\n \nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $1+\\dfrac{2}{\\sqrt{3}}$ | $3$ |\n| --- | --- | --- |\n| $u$ | $\\dfrac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\eqalign{\n    \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n&=  \\int_{1+2/\\sqrt{3}}^{3}\\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\,\\textrm{d}x \\[5pt]\n&=\\int_{2/\\sqrt{3}}^{2} \\dfrac{1}{|u|\\sqrt{u^2-1}}\\, \\textrm{d}u\\[5pt]\n&=  \\textrm{arcsec}\\, {u}\\Big|_{2/\\sqrt{3}}^{2}\\[5pt]\n&= \\textrm{arcsec} \\left(2\\right)  - \\textrm{arcsec}\\left(\\dfrac{2}{\\sqrt{3}} \\right)\\[5pt]\n&=\\left(\\dfrac{\\pi}{3}-\\dfrac{\\pi}{6}\\right)\\[5pt]\n&=\\dfrac{\\pi}{6}.\n\n}\n$$"} :knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c" :knowledge-point/questions [{:db/id #edb/ref 17592186069172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a268bba4-a0ea-5ea8-b8dd-169f1b9b0f00" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{12}" :db/id #edb/ref 17592186066262} {:answer/id #uuid "b7f08e7c-2a8d-5055-84f6-8969cbe6f8f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{5}" :db/id #edb/ref 17592186066263} {:answer/id #uuid "e1ed043f-e3fc-5347-a454-2690874f42ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3π}{2}" :db/id #edb/ref 17592186066264} {:answer/id #uuid "3d30f7e0-1cfd-57c8-a39f-cd259afb68cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2π}{5}" :db/id #edb/ref 17592186066265} {:answer/id #uuid "51a7effa-d0f4-5e63-91a6-43e7e246d312" :answer/type {:db/ident :answer.type/math} :answer/value "12π" :db/id #edb/ref 17592186066266}] :answer-field/id #uuid "96fc3ca8-6851-5c64-b9a9-014b9b524ae1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066261}] :question/id #uuid "5e4e641f-707a-572d-bc4e-cfc1e816fb1b" :question/math-academy-id "q-238092" :question/problem "Evaluate the integral $\\displaystyle \\int_{1 + 2/\\sqrt{3}}^{1 + 2/\\sqrt{2}}(1)/(\\mid x - 1 \\mid \\sqrt{x(x - 2)})dx$."} {:db/id #edb/ref 17592186069283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c8edcdc-8f1c-51c2-bbb5-0e9493ab87c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcsec(x + 3) + C" :db/id #edb/ref 17592186066869} {:answer/id #uuid "b6844ac0-a966-53fc-be83-d306677a8eb4" :answer/type {:db/ident :answer.type/math} :answer/value "arcsec(x - 2) + C" :db/id #edb/ref 17592186066870} {:answer/id #uuid "fa2b0b46-a229-5aff-94f5-75873e2dcacb" :answer/type {:db/ident :answer.type/math} :answer/value "arcsec(x + 2) + C" :db/id #edb/ref 17592186066871} {:answer/id #uuid "1f2b6cc8-ec18-57b5-b67e-f5bf938fc06b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}arcsec(2x - 4) + C" :db/id #edb/ref 17592186066872} {:answer/id #uuid "30330287-bf74-50f2-bc68-0fbb07832428" :answer/type {:db/ident :answer.type/math} :answer/value "arcsec(\\frac{x - 2}{2}) + C" :db/id #edb/ref 17592186066873}] :answer-field/id #uuid "6d426217-2e59-5f50-b1e1-d35750ae76fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066868}] :question/id #uuid "86c8cc54-dfe9-514c-942f-b0ac5d0ada71" :question/math-academy-id "q-3597" :question/problem "What is $\\displaystyle \\int\\frac{1}{\\mid x - 2 \\mid \\sqrt{x^{2} - 4x + 3}}dx$?"} {:db/id #edb/ref 17592186250324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001d516e-ba06-5b95-b4a6-f35dab9a3672" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(x+4)+C" :db/id #edb/ref 17592186247415} {:answer/id #uuid "14ed51ee-756e-57ce-98c5-e09580d0ea4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\text{arcsec}(x-4)+C" :db/id #edb/ref 17592186247613} {:answer/id #uuid "1d6dbd24-53a8-57ca-8ab3-2c785beb7617" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x-4)+C" :db/id #edb/ref 17592186247686} {:answer/id #uuid "3fd72e51-75ac-59c4-906c-a14dfbeed5aa" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\frac{x-4}{2})+C" :db/id #edb/ref 17592186247990} {:answer/id #uuid "4deeee7d-3bfe-54f3-bb50-f18cec4519b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x+4}{2})+C" :db/id #edb/ref 17592186248123}] :answer-field/correct {:answer/id #uuid "1d6dbd24-53a8-57ca-8ab3-2c785beb7617" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x-4)+C" :db/id #edb/ref 17592186247686} :answer-field/id #uuid "8347f822-40d4-57c9-9262-ff4fdf512681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249898}] :question/id #uuid "07920739-bd19-5b4b-b343-8e19ac7c6d5e" :question/math-academy-id "q-114928" :question/problem "$\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-8x+15 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+15 \\\\  & =({x}^{2}-8x+16)-16+15 \\\\  & =(x-4)^{2}-1.\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=\\int \\frac{1}{|x-4|\\sqrt{(x-4)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-4.$\n\nSo, let's perform the substitution \n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x & =\\int \\frac{1}{|x-4|\\sqrt{(x-4)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{arcsec}\\,u+C \\\\  & =\\text{arcsec}(x-4)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069e5dc3-903f-56c3-80b2-a36d93cb6a14" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x-2)+C" :db/id #edb/ref 17592186247483} {:answer/id #uuid "4ee8a822-9e03-5b0b-9157-4a6e261fd6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\text{arcsec}(2(x+2))+C" :db/id #edb/ref 17592186248134} {:answer/id #uuid "5c9b7170-e2cb-5afb-ae16-7aa25d17f2fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x+2)+C" :db/id #edb/ref 17592186248268} {:answer/id #uuid "8c688811-e631-576f-b3af-fccf1d19453f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186248679} {:answer/id #uuid "c73082f2-4cbb-5c23-891d-47290806832d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\frac{x-2}{2})+C" :db/id #edb/ref 17592186249194}] :answer-field/correct {:answer/id #uuid "5c9b7170-e2cb-5afb-ae16-7aa25d17f2fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(x+2)+C" :db/id #edb/ref 17592186248268} :answer-field/id #uuid "76fa23d1-4298-5709-9837-39a75683bfac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249874}] :question/id #uuid "fd2cd352-82c1-595a-88b3-99447daccebc" :question/math-academy-id "q-114929" :question/problem "$\\int \\frac{1}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+4x+3 & ={x}^{2}+2\\cdot 2x+({2}^{2}-{2}^{2})+3 \\\\  & =({x}^{2}+4x+4)-4+3 \\\\  & =(x+2)^{2}-1.\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{1}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=\\int \\frac{1}{|x+2|\\sqrt{(x+2)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x+2.$\n\nSo, let's perform the substitution \n\n$$\nu=x+2.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x & =\\int \\frac{1}{|x+2|\\sqrt{(x+2)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{arcsec}\\,u+C \\\\  & =\\text{arcsec}(x+2)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f28c9eb-3840-5b5a-a56c-67005ceedbcf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186317708}] :answer-field/correct {:answer/id #uuid "2f28c9eb-3840-5b5a-a56c-67005ceedbcf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186317708} :answer-field/id #uuid "686eae4d-b0d6-58e1-ba44-ec76b61e6ca2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318649}] :question/id #uuid "2f8cb3ef-802b-56b0-aecd-f648c03fc650" :question/math-academy-id "q-348528" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+6x+8 & ={x}^{2}+2\\cdot 3x+({3}^{2}-{3}^{2})+8 \\\\  & =({x}^{2}+2\\cdot 3x+{3}^{2})-9+8 \\\\  & =(x+3)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x=6{\\int }_{\\sqrt{2}-3}^{-1}\\frac{1}{|x+3|\\sqrt{(x+3)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+3).$\n\nSo, let's perform the substitution\n\n$$\nu=x+3.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $\\sqrt{2}-3$ | $-1$ |\n| --- | --- | --- |\n| $u$ | $\\sqrt{2}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x & =6{\\int }_{\\sqrt{2}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =6\\,\\text{arcsec}\\,u\\,{|}_{\\sqrt{2}}^{2} \\\\  & =6(\\text{arcsec}(2)-\\text{arcsec}(\\sqrt{2})) \\\\  & =6(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "457b53c0-5c6d-516d-a877-c712b70b39e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186317791}] :answer-field/correct {:answer/id #uuid "457b53c0-5c6d-516d-a877-c712b70b39e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186317791} :answer-field/id #uuid "e3d3deba-cbdd-5184-8055-2e4be419e417" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318901}] :question/id #uuid "935ea227-3967-5286-b590-f5c1cff1d8bb" :question/math-academy-id "q-348530" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+4x+3 & ={x}^{2}+2\\cdot 2x+({2}^{2}-{2}^{2})+3 \\\\  & =({x}^{2}+2\\cdot 2x+{2}^{2})-4+3 \\\\  & =(x+2)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=3{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{1}{|x+2|\\sqrt{(x+2)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+2).$\n\nSo, let's perform the substitution\n\n$$\nu=x+2.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-2+\\frac{2}{\\sqrt{3}}$ | $0$ |\n| --- | --- | --- |\n| $u$ | $\\frac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x & =3{\\int }_{2/\\sqrt{3}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =3\\,\\text{arcsec}\\,u\\,{|}_{2/\\sqrt{3}}^{2} \\\\  & =3(\\text{arcsec}(2)-\\text{arcsec}\\,(\\frac{2}{\\sqrt{3}})) \\\\  & =3(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9281596-87b0-57d8-a581-4893a3a5f6f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186318229}] :answer-field/correct {:answer/id #uuid "c9281596-87b0-57d8-a581-4893a3a5f6f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186318229} :answer-field/id #uuid "480d7b82-80ba-5bf8-83a2-2e84505b516f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318581}] :question/id #uuid "6c4d7d65-4e55-5a11-a6e7-c436fd955297" :question/math-academy-id "q-348531" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5+\\sqrt{2}}^{7}\\frac{8}{|x-5|\\sqrt{{x}^{2}-10x+24}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-10x+24 & ={x}^{2}-2\\cdot 5x+({5}^{2}-{5}^{2})+24 \\\\  & =({x}^{2}-2\\cdot 5x+{5}^{2})-25+24 \\\\  & =(x-5)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{5+\\sqrt{2}}^{7}\\frac{8}{|x-5|\\sqrt{{x}^{2}-10x+24}}\\,\\text{d}x=8{\\int }_{5+\\sqrt{2}}^{7}\\frac{1}{|x-5|\\sqrt{(x-5)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-5).$\n\nSo, let's perform the substitution\n\n$$\nu=x-5.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $5+\\sqrt{2}$ | $7$ |\n| --- | --- | --- |\n| $u$ | $\\sqrt{2}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{5+\\sqrt{2}}^{7}\\frac{8}{|x-5|\\sqrt{{x}^{2}-10x+24}}\\,\\text{d}x & =8{\\int }_{\\sqrt{2}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =8\\,\\text{arcsec}\\,u\\,{|}_{\\sqrt{2}}^{2} \\\\  & =8(\\text{arcsec}(2)-\\text{arcsec}(\\sqrt{2})) \\\\  & =8(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221653f2-bbc5-5c48-bf4c-c1771f86560d" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186317671}] :answer-field/correct {:answer/id #uuid "221653f2-bbc5-5c48-bf4c-c1771f86560d" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186317671} :answer-field/id #uuid "d553147c-43b1-5c52-9661-80a3cc7c948a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318878}] :question/id #uuid "8adadcfb-a209-54ca-845d-63966459ad0c" :question/math-academy-id "q-348532" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4+\\sqrt{2}}^{6}\\frac{12}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-8x+15 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+15 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+15 \\\\  & =(x-4)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{4+\\sqrt{2}}^{6}\\frac{12}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=12{\\int }_{4+\\sqrt{2}}^{6}\\frac{1}{|x-4|\\sqrt{(x-4)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-4).$\n\nSo, let's perform the substitution\n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $4+\\sqrt{2}$ | $6$ |\n| --- | --- | --- |\n| $u$ | $\\sqrt{2}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{4+\\sqrt{2}}^{6}\\frac{12}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x & =12{\\int }_{\\sqrt{2}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =12\\,\\text{arcsec}\\,u\\,{|}_{\\sqrt{2}}^{2} \\\\  & =12(\\text{arcsec}(2)-\\text{arcsec}(\\sqrt{2})) \\\\  & =12(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3df062f-a483-5b34-b334-45ecc7d4e171" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186318270}] :answer-field/correct {:answer/id #uuid "d3df062f-a483-5b34-b334-45ecc7d4e171" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186318270} :answer-field/id #uuid "e9736f4f-99a2-5e67-8623-ab108ae29d34" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318914}] :question/id #uuid "a7023621-9b53-549a-bf91-15f518a7082a" :question/math-academy-id "q-348533" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+8x+15 & ={x}^{2}+2\\cdot 4x+({4}^{2}-{4}^{2})+15 \\\\  & =({x}^{2}+2\\cdot 4x+{4}^{2})-16+15 \\\\  & =(x+4)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x=5{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{1}{|x+4|\\sqrt{(x+4)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-4+\\frac{2}{\\sqrt{3}}$ | $-2$ |\n| --- | --- | --- |\n| $u$ | $\\frac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x & =5{\\int }_{2/\\sqrt{3}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =5\\,\\text{arcsec}\\,u\\,{|}_{2/\\sqrt{3}}^{2} \\\\  & =5(\\text{arcsec}(2)-\\text{arcsec}\\,(\\frac{2}{\\sqrt{3}})) \\\\  & =5(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51a96887-12f9-54a7-9f27-889811c6585e" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\text{arcsec}(x+2)+C" :db/id #edb/ref 17592186330691} {:answer/id #uuid "5be25893-006e-5120-bfc9-3385c633e5ea" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{arcsec}(\\frac{x+1}{5})+C" :db/id #edb/ref 17592186330772} {:answer/id #uuid "8597e78d-6a6c-513d-99e9-421156a1013b" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\text{arcsec}(\\frac{x+2}{5})+C" :db/id #edb/ref 17592186331136} {:answer/id #uuid "93c370e2-9cd9-5e58-a79b-66978cc6b8b3" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\text{arcsec}(x+5)+C" :db/id #edb/ref 17592186331260} {:answer/id #uuid "c88f3648-0e88-5c0c-930e-b5d8abbd6773" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{arcsec}(\\frac{x+5}{2})+C" :db/id #edb/ref 17592186331725}] :answer-field/correct {:answer/id #uuid "8597e78d-6a6c-513d-99e9-421156a1013b" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\text{arcsec}(\\frac{x+2}{5})+C" :db/id #edb/ref 17592186331136} :answer-field/id #uuid "1358753c-7bf6-5eb8-b3a1-6471cbbf4b86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332225}] :question/id #uuid "85c37b78-e926-5fab-baa1-c0d49d07ba65" :question/math-academy-id "q-49689" :question/problem "$\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the expression inside the square root:\n\n$$\n\\begin{aligned}(x+2)^{2}-25 & =25[\\frac{(x+2)^{2}}{25}-1] \\\\  & =25[{(\\frac{x+2}{5})}^{2}-1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x & =\\int \\frac{75}{|x+2|\\sqrt{25[((x+2)/5)^{2}-1]}}\\,\\text{d}x \\\\  & =\\int \\frac{75}{|x+2|\\cdot \\sqrt{25}\\cdot \\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{75}{|x+2|\\cdot 5\\cdot \\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{15}{|x+2|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{|(x+2)/5|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\frac{x+2}{5}.$\n\nSo, let's perform the substitution \n\n$$\nu=\\frac{x+2}{5}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x & =3\\int \\frac{1}{|(x+2)/5|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot 5\\,\\text{d}u \\\\  & =15\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =15\\,\\text{arcsec }u+C \\\\  & =15\\,\\text{arcsec}(\\frac{x+2}{5})+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd564d9f-63fb-590f-bd58-4b804a9ab1e3" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{arcsec}(x-6)+C" :db/id #edb/ref 17592186390355} {:answer/id #uuid "a0809cc0-8245-5717-8ded-90aaf0006a8e" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{arcsec}(x+6)+C" :db/id #edb/ref 17592186390356} {:answer/id #uuid "de905a14-40b4-54a2-9966-938904217d49" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{arcsec}(x-4)+C" :db/id #edb/ref 17592186390357} {:answer/id #uuid "e79926dc-55a2-51bb-946e-9f9ee21d2e2f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{arcsec}(\\frac{x-3}{2})+C" :db/id #edb/ref 17592186390358} {:answer/id #uuid "703b11b7-a06a-596e-9766-2f893cbd71bf" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{arcsec}(\\frac{x+2}{3})+C" :db/id #edb/ref 17592186390359}] :answer-field/correct {:answer/id #uuid "dd564d9f-63fb-590f-bd58-4b804a9ab1e3" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{arcsec}(x-6)+C" :db/id #edb/ref 17592186390355} :answer-field/id #uuid "4529ba01-864b-583e-ae2f-75a351bb79bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390354}] :question/id #uuid "db8ef128-2717-5091-8870-85aa35ff95e0" :question/math-academy-id "q-19532" :question/problem "Calculate $\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-12x+35 & ={x}^{2}-2\\cdot 6x+({6}^{2}-{6}^{2})+35 \\\\  & =({x}^{2}-12x+36)-36+35 \\\\  & =(x-6)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x=10\\int \\frac{1}{|x-6|\\sqrt{(x-6)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-6.$\n\nSo, let's perform the substitution \n\n$$\nu=x-6.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x & =10\\int \\frac{1}{|x-6|\\sqrt{(x-6)^{2}-1}}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =10\\,\\text{arcsec }u+C \\\\  & =10\\,\\text{arcsec}(x-6)+C.\\end{aligned}\n$$"}] :knowledge-point/title "Computing an Arcsecant Integral by Completing the Square"} :step/id #uuid "3f8c6957-fb74-5c1d-9110-0699559d48a4"}] :activity/title "Integrating Functions by Completing the Square" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186068972}] [{:db/id #edb/ref 17592186048436 :topic/id #uuid "9f06bd65-df18-5d83-abc2-a397390391ec" :topic/knowledge-points [{:db/id #edb/ref 17592186078390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078247 :question/id #uuid "36c32777-8081-5431-a112-321738a3adab" :question/math-academy-id "e-3228" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - 4x + 6y = 12.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x+6y & =12 \\\\ ({x}^{2}-4x)+({y}^{2}+6y) & =12 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =12+{2}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+3)^{2} & ={5}^{2} \\\\ (x-2)^{2}+(y-(-3))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-3)$ and its radius is $5.$"} :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/questions [{:db/id #edb/ref 17592186079061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ffeffb-ef59-54f5-be3f-a2062b83999e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186077145} {:answer/id #uuid "a8e22452-4b20-5bf4-9090-9c4baa1361ca" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186077146} {:answer/id #uuid "c8f09b0a-5fff-5884-866a-7cd7c2b038b1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186077147} {:answer/id #uuid "d6f5be55-2167-551f-a536-04e193c35eb9" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2, 3)$, radius: $4$" :db/id #edb/ref 17592186077148} {:answer/id #uuid "00169a7a-33bd-5ce6-8aa9-6f23a52c4730" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186077149}] :answer-field/id #uuid "b0de6a19-461b-5d8f-8397-c1cfef2f142b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077144} {:answer-field/choices [{:answer/id #uuid "ae470676-bc8c-59ed-9ddf-e6bfad4e99f2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186396095} {:answer/id #uuid "3958fd13-48da-5731-9bd7-2332d7318f31" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186396096} {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} {:answer/id #uuid "1caf2e7f-b2a3-5b2b-9e2c-a85b6dd512fd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186396098} {:answer/id #uuid "6d7bd3d5-18da-5a40-acfa-fa44fce357be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186396099}] :answer-field/correct {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} :answer-field/id #uuid "8f64383e-34d9-58e2-8c5a-1486b312000b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396094}] :question/id #uuid "dd6c82b9-14ab-538d-aa0f-037306546c3d" :question/math-academy-id "q-5144" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4x-6y=3.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-6y & =3 \\\\ ({x}^{2}+4x)+({y}^{2}-6y) & =3 \\\\ ({x}^{2}+2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot 3y+{3}^{2}) & =3+{2}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 2x+4)+({y}^{2}-2\\cdot 3y+9) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-(-2))^{2}+(y-3)^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-2,3)$ and its radius is $4.$"} {:db/id #edb/ref 17592186079065 :question/answer-fields 