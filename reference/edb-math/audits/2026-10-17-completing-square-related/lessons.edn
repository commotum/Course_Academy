+2)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-2,-1).$"} {:db/id #edb/ref 17592186238039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e6780a0-762d-5a15-b943-22dbd2ab6570" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186236719} {:answer/id #uuid "900d2c15-c83d-5c46-855d-8118349f8cb6" :answer/type {:db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186236732} {:answer/id #uuid "ab39596d-4c14-53b6-815b-9a32b718e5ef" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186236901} {:answer/id #uuid "f77f8eb9-c933-5802-913a-e784cac05211" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186237380} {:answer/id #uuid "fbe4025f-f0f9-5b78-860f-a3ff51f288c4" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186237410}] :answer-field/correct {:answer/id #uuid "900d2c15-c83d-5c46-855d-8118349f8cb6" :answer/type {:db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186236732} :answer-field/id #uuid "20b1407b-f7de-5c3b-85d3-ac67ee8bf74f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237480}] :question/id #uuid "70768156-f2bf-5774-95e4-b9982eaa5922" :question/math-academy-id "q-103679" :question/problem "Calculate the coordinates of the vertex of the parabola ${y}^{2}-8x-2y+33=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x-2y+33 & =0 \\\\ {y}^{2}-2y & =8x-33 \\\\ (y-1)^{2}-1 & =8x-33 \\\\ (y-1)^{2} & =8x-33+1 \\\\ (y-1)^{2} & =8x-32 \\\\ (y-1)^{2} & =8(x-4) \\\\ (y-1)^{2} & =4(2)(x-4)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(4,1).$"} {:db/id #edb/ref 17592186238040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d229355-b369-5d20-b9e2-85c05afb9a4a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-2)" :db/id #edb/ref 17592186235887} {:answer/id #uuid "4f3ee54b-cfe1-5ac4-9901-8009c1085a49" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186236330} {:answer/id #uuid "8545854b-d48c-5f49-a863-4315e9d09350" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186236649} {:answer/id #uuid "b8338b95-fe03-51df-b077-ed5602d7d957" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186236991} {:answer/id #uuid "b89f243b-eb88-517a-bc36-5080283e88f2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186236999}] :answer-field/correct {:answer/id #uuid "b89f243b-eb88-517a-bc36-5080283e88f2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186236999} :answer-field/id #uuid "84e4ba47-1a7c-564a-b419-85065b3e4316" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237617}] :question/id #uuid "5f63b7f3-3eef-5ebd-9d62-4e44d073d800" :question/math-academy-id "q-103680" :question/problem "Calculate the coordinates of the vertex of the parabola ${y}^{2}-4x-4y+24=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-4x-4y+24 & =0 \\\\ {y}^{2}-4y & =4x-24 \\\\ (y-2)^{2}-4 & =4x-24 \\\\ (y-2)^{2} & =4x-24+4 \\\\ (y-2)^{2} & =4x-20 \\\\ (y-2)^{2} & =4(x-5) \\\\ (y-2)^{2} & =4(1)(x-5)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,2).$"} {:db/id #edb/ref 17592186354477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1102e6af-dc6b-5bfe-859d-d0db788a38c3" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186351709} {:answer/id #uuid "6db915df-ac6e-5002-914f-44e5deb6f0fd" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186352534} {:answer/id #uuid "9610af9b-654e-5ab3-b1e2-838a60132f4d" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186352866} {:answer/id #uuid "c8256306-418d-5bb8-8322-29cc8ef94813" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186353308} {:answer/id #uuid "f78745b5-88a9-5f5d-ab1e-3ed9a85480f9" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186353723}] :answer-field/correct {:answer/id #uuid "1102e6af-dc6b-5bfe-859d-d0db788a38c3" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186351709} :answer-field/id #uuid "745da8b3-dc4c-54cd-a987-1247331cacc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354033}] :question/id #uuid "524c5073-ce66-5faf-96af-bd847bc0e1ad" :question/math-academy-id "q-86523" :question/problem "Calculate the coordinates of the vertex of the parabola $3{y}^{2}-2x+18y+29=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{y}^{2}-2x+18y+29 & =0 \\\\ 3{y}^{2}+18y & =2x-29 \\\\ 3[{y}^{2}+6y] & =2x-29 \\\\ 3[(y+3)^{2}-9] & =2x-29 \\\\ 3(y+3)^{2}-27 & =2x-29 \\\\ 3(y+3)^{2} & =2x-29+27 \\\\ 3(y+3)^{2} & =2x-2 \\\\ 3(y+3)^{2} & =2(x-1) \\\\ (y+3)^{2} & =\\frac{2}{3}(x-1) \\\\ (y+3)^{2} & =4(\\frac{1}{6})(x-1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(1,-3).$"}] :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"} :step/id #uuid "d532a1e2-faba-5d0e-90a2-1bac527ab8d1"} {:db/id #edb/ref 17592186172872 :step/content {:db/id #edb/ref 17592186172020 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171824 :question/id #uuid "a7f9f74b-e213-5f38-8cb2-b9352ee515ad" :question/math-academy-id "e-7471" :question/problem "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}-10x-4y-7 & =0 \\\\ 5{x}^{2}-10x & =4y+7 \\\\ 5[{x}^{2}-2x] & =4y+7 \\\\ 5[(x-1)^{2}-1] & =4y+7 \\\\ 5(x-1)^{2}-5 & =4y+7 \\\\ 5(x-1)^{2} & =4y+7+5 \\\\ 5(x-1)^{2} & =4y+12 \\\\ 5(x-1)^{2} & =4(y+3) \\\\ (x-1)^{2} & =\\frac{4}{5}(y+3) \\\\ (x-1)^{2} & =4(\\frac{1}{5})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (1,-3).$"} :knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/questions [{:db/id #edb/ref 17592186172273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3640b53-f2c4-59b4-8c39-a60f3b23a8c9" :answer/type {:db/ident :answer.type/math} :answer/value "(-5, 5)" :db/id #edb/ref 17592186168502} {:answer/id #uuid "d5a22c05-9a57-5c7c-9725-71126475b45f" :answer/type {:db/ident :answer.type/math} :answer/value "(-3, 3)" :db/id #edb/ref 17592186168503} {:answer/id #uuid "d70e5da8-eeaf-5834-ba60-bdd7287df095" :answer/type {:db/ident :answer.type/math} :answ