 form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}-\\frac{1}{4}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{9}{2})}^{2}-\\frac{41}{2}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}+9y+\\frac{1}{4} & =-({(y-\\frac{9}{2})}^{2}-\\frac{41}{2}) \\\\  & =\\frac{41}{2}-{(y-\\frac{9}{2})}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85efc12e-6686-5c83-a584-51d24265e514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}-{(x+\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186500745} {:answer/id #uuid "87c47d54-c33c-5791-b51c-9f273e7288ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186500752} {:answer/id #uuid "a2bc4dbf-a3c1-5c4a-bb30-637dbdcc4445" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(x-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186500795} {:answer/id #uuid "ce7d23ab-bc7a-5e58-9183-a23a3316f17d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}-{(x-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186500909} {:answer/id #uuid "ff089ad5-5112-577e-a4ad-ebbdd0861706" :answer/type {:db/ident :answer.type/math} :answer/value "10-{(x-6)}^{2}" :db/id #edb/ref 17592186501008}] :answer-field/correct {:answer/id #uuid "a2bc4dbf-a3c1-5c4a-bb30-637dbdcc4445" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(x-\\frac{3}{2})}^{2}" :db/id #edb/ref 17592186500795} :answer-field/id #uuid "23e91312-58c2-59dc-9a23-0a2685890965" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501029}] :question/id #uuid "aef8db66-e528-55a5-877b-5de5c3121fc3" :question/math-academy-id "q-140270" :question/problem "Rewrite $-({x}^{2}-3x+1)$ by completing the square." :question/worked-soluti