-ecc94cc73dc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186289143} :answer-field/id #uuid "153066fe-0cdd-579e-aaf5-007fbeaf0529" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289778} {:answer-field/choices [{:answer/id #uuid "5009285a-463e-50f3-8e28-b07d7280545d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288587}] :answer-field/correct {:answer/id #uuid "5009285a-463e-50f3-8e28-b07d7280545d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288587} :answer-field/id #uuid "1ccc1df6-062b-5450-b229-e0042056f1a4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289800}] :question/id #uuid "28433fb4-b2dc-583d-a623-b374a7e4b335" :question/math-academy-id "q-223564" :question/problem "Rewrite the following expression as the difference of a perfect square and a constant.\n\n$({x}^{2}-11x+\\frac{121}{4})-10=(x\\,\\,-$\n{{field-1}} $)^{2}-$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-11x+\\frac{121}{4} & = \\\\ {x}^{2}-11x+{(\\frac{11}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2} & = \\\\ {(x-\\frac{11}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-11x+\\frac{121}{4})-10 & = \\\\ {(x-\\frac{11}{2})}^{2}-10 & .\\end{aligned}\n$$"}] :knowledge-point/title "Completing the Square When the Perfect Square Is Isolated"} {:db/id #edb/ref 17592186184169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183962 :question/id #uuid "05109436-7f8b-5ef9-a460-b53497a138f4" :question/math-academy-id "e-15020" :question/problem "Complete the square on the quadratic expression $x^2 + 7x - 1.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with ${\\color{red}{2}}$ as a factor:\n\n$$\nx^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{7}{2}}}x - {\\color{purple}{1}}\n$$\n\nNow, here's the trick. We *add* and *then subtract* $\\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2,$ writing the constant term ${\\color{purple}{-1}}$ last:\n\n$$\n\\underbrace{x^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{7}{2}}}x  + \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2} - \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2 - {\\color{purple}{1}}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n\\left(x + {\\color{blue}{\\dfrac{7}{2}}}\\right)^2  - \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2 - {\\color{purple}{1}}\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n\\left(x + {\\color{blue}{\\dfrac{7}{2}}}\\right)^2  - \\dfrac{53}{4}.\n$$"} :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/questions [{:db/id #edb/ref 17592186184457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "945964ef-8a0e-5d8c-924d-f6d3a1780683" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} + \\frac{1}{2}" :db/id #edb/ref 17592186180920} {:answer/id #uuid "ee0609ba-ae7a-5e08-ba84-64848c080c69" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} - \\frac{1}{2}" :db/id #edb/ref 17592186180921} {:answer/id #uuid "feacbd8b-44ff-562a-b9c6-04cd6c153e1e" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} - \\frac{1}{4}" :db/id #edb/ref 17592186180922} {:answer/id #uuid "132cbd12-bce9-5d91-918d-98e2c5c224b3" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{4})^{2} - \\frac{1}{4}" :db/id #edb/ref 17592186180923} {:answer/id #uuid "4e5c2cd4-3a2d-5fce-9add-f7ef2a74f498" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} + \\frac{1}{4}" :db/id #edb/ref 17592186180924}] :answer-field/id #uuid "d70eb358-4c87-5a71-9d95-eb12aa7628df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180919}] :question/id #uuid "8a738f34-f692-5d7d-8efb-05e39d3d0c4d" :question/math-academy-id "q-12880" :question/problem "Complete the square on the quadratic expression $n^{2} + n$."} {:db/id #edb/ref 17592186184554 :question/answer-fields [{:answer-field/id #uuid "9e167051-e22f-510e-aae7-ecac56b8a33e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181478} {:answer-field/id #uuid "ac029dc8-8802-5110-ba14-217515784b70" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181479}] :question/id #uuid "50734f27-301d-5936-b91c-e25181ba0c79" :question/math-academy-id "q-221412" :question/problem "Complete the square on the quadratic expression $x^{2} + 3x + 9$.$x^{2} + 3x + 9 = (x +$\n{{field-1}} $)^{2} +$\n{{field-2}}"} {:db/id #edb/ref 17592186272293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ed7dc5-6698-544e-8bd2-b698be8286f0" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-2" :db/id #edb/ref 17592186269786} {:answer/id #uuid "3e36f179-7a99-5b80-b4d9-f5843fe8a371" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{4})}^{2}-\\frac{9}{2}" :db/id #edb/ref 17592186269838} {:answer/id #uuid "775b0e34-1455-5f81-80d8-cdd1da12224b" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-\\frac{3}{4}" :db/id #edb/ref 17592186270325} {:answer/id #uuid "a28998c9-f966-53ff-9806-5302008f6b71" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-\\frac{9}{4}" :db/id #edb/ref 17592186270718} {:answer/id #uuid "f1c01206-6b1c-516a-bfe3-0aaf6c038975" :answer/type {:db/ident :answer.type/math} :answer/va