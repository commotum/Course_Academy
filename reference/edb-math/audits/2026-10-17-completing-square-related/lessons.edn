bb5d4b-0ce6-53d9-8497-039fb7fe2e2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}\\operatorname{arcsch}⁡(\\frac{3x-2}{3})+C" :db/id #edb/ref 17592186538551} {:answer/id #uuid "c0f32036-6948-5f43-a566-222721d70200" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C" :db/id #edb/ref 17592186538681} {:answer/id #uuid "d37f6b69-2bf6-5e33-a159-45bc4b373ce2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arcsch}⁡(3x-2)+C" :db/id #edb/ref 17592186538722}] :answer-field/correct {:answer/id #uuid "c0f32036-6948-5f43-a566-222721d70200" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C" :db/id #edb/ref 17592186538681} :answer-field/id #uuid "fe2698ca-7e20-5c2e-95df-9f69c77c58a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538923}] :question/id #uuid "46c80522-dca7-526c-a225-6cc3d9755240" :question/math-academy-id "q-97313" :question/problem "Calculate $\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}=\\int \\frac{\\text{d}x}{6(x-\\frac{2}{3})\\sqrt{9-9{(x-\\frac{2}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{2}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(x-\\frac{2}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2a94b3-44dd-52b7-9ec8-57361cc9534d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{\\sqrt{2}})+C" :db/id #edb/ref 17592186538267} {:answer/id #uuid "5ede2391-c2b2-5c77-84a5-0c2d651d0c65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538441} {:answer/id #uuid "7ecac083-f3f6-50fd-85bd-f274abf8632b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538522} {:answer/id #uuid "8f9a2895-a913-526c-a6b5-9b164f01bfb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538569} {:answer/id #uuid "c0b5fe7e-e088-5647-ad7c-cb6d53c10815" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x+3}{\\sqrt{2}})+C" :db/id #edb/ref 17592186538680}] :answer-field/correct {:answer/id #uuid "5ede2391-c2b2-5c77-84a5-0c2d651d0c65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538441} :answer-field/id #uuid "8f32ba7e-ec4d-5979-a816-0eff8d932fa9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538876}] :question/id #uuid "dbcc5371-79bd-5123-b706-5a10821a5d21" :question/math-academy-id "q-97758" :question/problem "Calculate $\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x.$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x=\\int \\frac{1}{4-4{(\\frac{x+3}{2})}^{2}}\\text{d}x=\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{x+3}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+3}{2}|>1.$"}] :knowledge-point/title "Computing an Inverse Reciprocal Hyperbolic Integral Containing a Completed Square"} :step/id #uuid "0f6c3062-9d6c-592d-a31f-5fb2ead310cd" :step/next {:db/id #edb/ref 17592186167643}} {:db/id #edb/ref 17592186167645 :step/content {:db/id #edb/ref 17592186166808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166646 :question/id #uuid "26cd55d1-dc94-507c-bcf9-13d619493184" :question/math-academy-id "e-8454" :question/problem "${\\displaystyle \\int \\dfrac{6}{|3x+9|\\sqrt{x^2+6x+10}} \\textrm{d}x= }$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+10 & ={x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}+10 \\\\  & =(x+3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{6}{|3x\\!+\\!9|\\sqrt{x^2\\!+\\!6x\\!+\\!10}} \\,\\textrm{d}x  = \\int  \\dfrac{6}{3|x\\!+\\!3|\\sqrt {1\\!+\\!(x\\!+\\!3)^2} }\t\\, \\textrm{d}x = {2} \\int \\dfrac{1}{|x\\!+\\!3|\\sqrt{1\\!+\\!(x\\!+\\!3)^2}} \\, \\textrm{d}x.\n$$\n\nLet $u = x+3.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}2\\int \\frac{1}{|x+3|\\sqrt{1+(x+3)^{2}}}\\text{d}x & =2\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-2\\operatorname{arcsch}⁡u+C \\\\  & =-2\\operatorname{arcsch}⁡(x+3)+C.\\end{aligned}\\end{aligned}\n$$"} :knowledge-point/id #uuid "f97720d6-2c67-5017-bf20-8045a8bb30b5" :knowledge-point/questions [{:db/id #edb/ref 17592186167436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d84557a-483b-5d86-b94d-d4c4b8aaecf2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arsech}⁡(x-2)+C" :db/id #edb/ref 17592186538264} {:answer/id #uuid "7757ac70-ef61-5e8f-a5b3-02b102e498d4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(x-2)+C" :db/id #edb/ref 17592186538501} {:answer/id #uuid "9c33e5eb-9dde-5c7c-b414-ba30f3308878" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(x-2)+C" :db/id #edb/ref 17592186538604} {:answer/id #uuid "cfc1ea2f-a52f-5330-a42a-047633957a3a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsch}⁡(x-2)+C" :db/id #edb/ref 17592186538714} {:answer/id #uuid "eb1b61ae-1e87-535f-8fc0-68cde71649a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C" :db/id #edb/ref 17592186538769}] :answer-field/correct {:answer/id #uuid "eb1b61ae-1e87-535f-8fc0-68cde71649a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C" :db/id #edb/ref 17592186538769} :answer-field/id #uuid "3e8e8330-236a-5ebb-966c-b155b08ffef3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165824}] :question/id #uuid "2e1c2ab8-7185-5af4-9bb5-d9487e392b5e" :question/math-academy-id "q-95977" :question/problem "$\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+5 & ={x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}+5 \\\\  & =(x-2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\,\\text{d}x=\\int \\frac{2}{4|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186167519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a53a977-08c6-5df9-a860-2371d7ca93a8" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538428} {:answer/id #uuid "a541d1ea-9725-5c0d-81a6-8717209ba023" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538627} {:answer/id #uuid "ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538637} {:answer/id #uuid "e5e11cb3-9047-5ff4-947e-2cd0cb49d427" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538755} {:answer/id #uuid "f5fa1e27-e6e7-5ee2-8cfd-06752c595b70" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{arsech}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538790}] :answer-field/correct {:answer/id #uuid "ac30b210-151b-52ec-9f43-9946b5b6bd5d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C" :db/id #edb/ref 17592186538637} :answer-field/id #uuid "cffcc18d-04b4-520c-afc2-9502fc33eeb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166322}] :question/id #uuid "d0b115b9-4f73-5fd8-99ef-72eedb4e4a17" :question/math-academy-id "q-97903" :question/problem "$\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4{x}^{2}+4x+5 & =4({x}^{2}+x+\\frac{5}{4}) \\\\  & =4({x}^{2}+2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+\\frac{5}{4}) \\\\  & =4[{(x+\\frac{1}{2})}^{2}+1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\,\\text{d}x=\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{4[1+{(x+\\frac{1}{2})}^{2}]}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+\\frac{1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186538970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c51b78-104c-5cc3-aee1-4e68441c9623" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538292} {:answer/id #uuid "453056a6-3a29-558e-96a3-8e72fe77debe" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538372} {:answer/id #uuid "82eda7e3-a9bb-5caf-8d13-aa3068ab29d6" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{arsech}⁡(\\frac{x+3}{2})+C" :db/id #edb/ref 17592186538532} {:answer/id #uuid "a5174d35-1a1b-5a59-a41a-cfbded8edbe3" :answer