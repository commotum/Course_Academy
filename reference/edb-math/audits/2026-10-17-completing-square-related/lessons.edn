\\frac{11}{2}" :db/id #edb/ref 17592186289351} :answer-field/id #uuid "7bfdb33f-3e5a-560d-b881-280805ddbed2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290003} {:answer-field/choices [{:answer/id #uuid "cdfeff32-20d1-5a8c-9bf3-84db4cf46043" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186289406}] :answer-field/correct {:answer/id #uuid "cdfeff32-20d1-5a8c-9bf3-84db4cf46043" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186289406} :answer-field/id #uuid "cc602a12-4abd-5560-9d31-a86b4eba380b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290174}] :question/id #uuid "71bc1100-5cb2-564e-9a6b-89a542c6c7de" :question/math-academy-id "q-223639" :question/problem "Complete the square on the quadratic expression ${x}^{2}-11x+30.$\n\n${x}^{2}-11x+30=(x\\,\\,-$\n{{field-1}} $)^{2}-$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{11}{2}x+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $30$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2}}_{⏟}-\\,{(\\frac{11}{2})}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(x-\\frac{11}{2})}^{2}-\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186290409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3266af3-d507-5677-9cca-fe953b9f4291" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289322}] :answer-field/correct {:answer/id #uuid "c3266af3-d507-5677-9cca-fe953b9f4291" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289322} :answer-field/id #uuid "1d49c639-c1b4-5d1c-988b-463effd88b79" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289804} {:answer-field/choices [{:answer/id #uuid "b0a2a9da-d25b-54f5-866a-796316d4daa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186289201}] :answer-field/correct {:answer/id #uuid "b0a2a9da-d25b-54f5-866a-796316d4daa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186289201} :answer-field/id #uuid "ffba8f81-6bad-5095-8d2a-7a84517eadec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290255}] :question/id #uuid "b072df2c-3382-5adf-80f6-f89bc73cbee2" :question/math-academy-id "q-223640" :question/problem "Complete the square on the quadratic expression ${w}^{2}-3w+3.$\n\n${w}^{2}-3w+3=(w\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{w}^{2}-2\\cdot \\frac{3}{2}w+3\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $3$ last:\n\n$$\n{{w}^{2}-2\\cdot \\frac{3}{2}w+{(\\frac{3}{2})}^{2}}_{⏟}-\\,{(\\frac{3}{2})}^{2}+3\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(w-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}+3\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(w-\\frac{3}{2})}^{2}+\\frac{3}{4}.\n$$"}] :knowledge-point/title "Expressions Containing a Negative Linear Term"}] :topic/title "Completing the Square With Odd Linear Terms"} {:activity/first-step {:db/id #edb/ref 17592186184932} :activity/id #uuid "23370b95-0255-56e2-941f-aa45341f5a48" :activity/steps [{:db/id #edb/ref 17592186184932 :step/content {:db/id #edb/ref 17592186185383 :tutorial/content "Let's recall the formula for factoring a perfect square:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nAs we've seen, **completing the square** on a quadratic expression means expressing it as the sum of a perfect square and a constant.\n\nIn this lesson, we'll learn how to complete the square on a quadratic expression when the coefficient of the linear term is odd. In these cases, we get a fraction in the final expression.\n\nAs an example, let's consider the following quadratic expression:\n\n$$\n\\left(x^2 + 5x + \\left(\\dfrac 52\\right)^2\\right) + 1\n$$\n\nNotice that we have a perfect square in the large parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+5x+{(\\frac{5}{2})}^{2} & = \\\\ {x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2} & = \\\\ {(x+\\frac{5}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression can be written as\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+1.\\end{aligned}\n$$\n\nLet's see another example." :tutorial/id #uuid "858a20e8-2e9b-5ab0-ae5f-811c370a9b56" :tutorial/title "Introduction"} :step/id #uuid "dde3630a-2987-5c08-902d-908c2a28f36d" :step/next {:db/id #edb/ref 17592186184933}} {:db/id #edb/ref 17592186184933 :step/content {:db/id #edb/ref 17592186184168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183961 :question/id #uuid "fc7c982c-7e5d-5187-9779-6952f32fe2bf" :question/math-academy-id "e-15019" :question/problem "Rewrite the expression \n\n$$\n\\left(x^2 + 7x + \\dfrac{49}{4}\\right) + 3\n$$\n\nas the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+7x+\\frac{49}{4} & = \\\\ {x}^{2}+7x+{(\\frac{7}{2})}^{2} & = \\\\ {x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2} & = \\\\ {(x+\\frac{7}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+7x+\\frac{49}{4})+3 & = \\\\ {(x+\\frac{7}{2})}^{2}+3 & .\\end{aligned}\n$$"} :knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7" :knowledge-point/questions [{:db/id #edb/ref 17592186184478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e115dce-6c4a-5990-acf3-bf492c96d488" :answer/type {:db/ident :answer.type/math} :answer/value "(x + \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181046} {:answer/id #uuid "a70edb35-cbf2-5e18-b8aa-351303b13799" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 5)^{2} + 3" :db/id #edb/ref 17592186181047} {:answer/id #uuid "cc6b90df-1c57-524a-8734-19d8517fefc3" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 5)^{2} + 3" :db/id #edb/ref 17592186181048} {:answer/id #uuid "f1b669fc-c53e-5ece-bb04-bb4167ea84d2" :answer/type {:db/ident :answer.type/math} :answer/value "(x - \\frac{5}{4})^{2} + 3" :db/id #edb/ref 17592186181049} {:answer/id #uuid "56ee1c11-8464-5689-b873-51dcd5a5583d" :answer/type {:db/ident :answer.type/math} :answer/value "(x - \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181050}] :answer-field/id #uuid "eb8c466d-4935-54e2-a0c5-07904d3f71b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181045}] :question/id #uuid "7fde105f-56e2-5383-a76a-5a8fb4028ec0" :question/math-academy-id "q-140191" :question/problem "Rewrite the expression\n$(x^{2} + 5x + (\\frac{5}{2})^{2}) + 3$\nas the sum of a perfect square and a constant."} {:db/id #edb/ref 17592186184553 :question/answer-fields [{:answer-field/id #uuid "f71c95db-5c93-50f2-9dbe-b16d5d197d7b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181476} {:answer-field/id #uuid "face2b35-7848-5b75-822e-e760b54ac25c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181477}] :question/id #uuid "50997d11-dc77-5455-a188-b0e98a0d9407" :question/math-academy-id "q-221410" :question/problem "Rewrite the following expression as the difference of a perfect square and a constant.$(y^{2} + 13y + \\frac{169}{4}) - 7 = (y +$\n{{field-1}} $)^{2} -$\n{{field-2}}"} {:db/id #edb/ref 17592186272046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b92c754-eb13-5d62-8988-5c9cd5b46d9c" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+1)}^{2}-1" :db/id #edb/ref 17592186269662} {:answer/id #uuid "2d6d3379-d6ad-5655-999a-1273f57649fc" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186269678} {:answer/id #uuid "71c32ce2-abcd-589e-9ee2-bf0011fa0aee" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{4})}^{2}-1" :db/id #edb/ref 17592186270278} {:answer/id #uuid "9f2d8b7d-7c0f-5acc-b9f8-e53fbc017c17" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186270680} {:answer/id #uuid "fd66c5fe-ca7f-51da-b3eb-be1db1ee6189" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-1)}^{2}-1" :db/id #edb/ref 17592186271486}] :answer-field/correct {:answer/id #uuid "2d6d3379-d6ad-5655-999a-1273f57649fc" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186269678} :answer-field/id #uuid "bd33067a-85fe-5634-91e6-8571e5edc593" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271854}] :question/id #uuid "92dac4ab-f152-5947-b5c0-1c9fee1af33c" :question/math-academy-id "q-140299" :question/problem "Rewrite the expression \n\n$$\n({x}^{2}-x+\\frac{1}{4})-1\n$$\n\nas the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x+\\frac{1}{4} & = \\\\ {x}^{2}-x+{(\\frac{1}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2} & = \\\\ {(x-\\frac{1}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-x+\\frac{1}{4})-1 & = \\\\ {(x-\\frac{1}{2})}^{2}-1 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad3e0aa-0ecb-5b45-b73c-497f51eb1f97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186288314}] :answer-field/correct {:answer/id #uuid "2ad3e0aa-0ecb-5b45-b73c-497f51eb1f97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186288314} :answer-field/id #uuid "90cbc86e-fd80-52ed-b920-292039fdb1b4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290054} {:answer-field/choices [{:answer/id #uuid "a455dece-e051-505c-99b8-692017ed3883" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289128}] :answer-field/correct {:answer/id #uuid "a455dece-e051-505c-99b8-692017ed3883" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289128} :answer-field/id #uuid "eba984db-e836-5a2f-a0af-85e0fe8023c1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290221}] :question/id #uuid "3d1d4ff1-0f32-51b3-b771-45a49de2ebf2" :question/math-academy-id "q-221409" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}-17x+{(\\frac{17}{2})}^{2})+5=(x\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-17x+{(\\frac{17}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{17}{2}x+{(\\frac{17}{2})}^{2} & = \\\\ {(x-\\frac{17}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-17x+{(\\frac{17}{2})}^{2})+5 & = \\\\ {(x-\\frac{17}{2})}^{2}+5 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e53c6fa-b88e-5996-a931-7e9fb5cf482f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289096}] :answer-field/correct {:answer/id #uuid "9e53c6fa-b88e-5996-a931-7e9fb5cf482f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289096} :answer-field/id #uuid "23309c45-ebdb-528a-84a6-ba2fae3cf57a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289814} {:answer-field/choices [{:answer/id #uuid "ba1f5e84-6542-55f0-b2b5-226edc295377" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186289260}] :answer-field/correct {:answer/id #uuid "ba1f5e84-6542-55f0-b2b5-226edc295377" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186289260} :answer-field/id #uuid "6b63762a-9e11-51e9-b0a9-fd55097541a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289965}] :question/id #uuid "6800959f-090f-5fdb-a727-120e768644ff" :question/math-academy-id "q-223560" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({y}^{2}+9y+\\frac{81}{4})+2=(y\\,\\,+$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}+2ay+{a}^{2}=(y+a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}+9y+\\frac{81}{4} & = \\\\ {y}^{2}+9y+{(\\frac{9}{2})}^{2} & = \\\\ {y}^{2}+2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2} & = \\\\ {(y+\\frac{9}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}+9y+\\frac{81}{4})+2 & = \\\\ {(y+\\frac{9}{2})}^{2}+2 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5aefa84-cbe2-57d3-a7a2-fd784b217046" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289555}] :answer-field/correct {:answer/id #uuid "e5aefa84-cbe2-57d3-a7a2-fd784b217046" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186289555} :answer-field/id #uuid "cabb38b6-1a0f-57a3-b72b-19039258e861" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290171} {:answer-field/choices [{:answer/id #uuid "caba86a1-e7e2-5362-8cca-fbdd59c2f18c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289377}] :answer-field/correct {:answer/id #uuid "caba86a1-e7e2-5362-8cca-fbdd59c2f18c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289377} :answer-field/id #uuid "cda6ce23-21ce-5504-bbad-ef62a064a046" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290179}] :question/id #uuid "bd82d6cc-a4d8-5108-b016-979bbf922e63" :question/math-academy-id "q-223562" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({u}^{2}-3u+\\frac{9}{4})+5=(u\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{u}^{2}-2au+{a}^{2}=(u-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{u}^{2}-3u+\\frac{9}{4} & = \\\\ {u}^{2}-3u+{(\\frac{3}{2})}^{2} & = \\\\ {u}^{2}-2\\cdot \\frac{3}{2}u+{(\\frac{3}{2})}^{2} & = \\\\ {(u-\\frac{3}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({u}^{2}-3u+\\frac{9}{4})+5 & = \\\\ {(u-\\frac{3}{2})}^{2}+5 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7cca0f9-5fcb-5924-94b4-ecc94cc73dc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186289143}] :answer-field/correct {:answer/id #uuid "a7cca0f9-5fcb-5924-94b4-ecc94cc73dc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186289143} :answer-field/id #uuid "153066fe-0cdd-579e-aaf5-007fbeaf0529" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289778} {:answer-field/choices [{:answer/id #uuid "5009285a-463e-50f3-8e28-b07d7280545d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288587}] :answer-field/correct {:answer/id #uuid "5009285a-463e-50f3-8e28-b07d7280545d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288587} :answer-field/id #uuid "1ccc1df6-062b-5450-b229-e0042056f1a4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289800}] :question/id #uuid "28433fb4-b2dc-583d-a623-b374a7e4b335" :question/math-academy-id "q-223564" :question/problem "Rewrite the following expression as the difference of a perfect square and a constant.\n\n$({x}^{2}-11x+\\frac{121}{4})-10=(x\\,\\,-$\n{{field-1}} $)^{2}-$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-11x+\\frac{121}{4} & = \\\\ {x}^{2}-11x+{(\\frac{11}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2} & = \\\\ {(x-\\frac{11}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-11x+\\frac{121}{4})-10 & = \\\\ {(x-\\frac{11}{2})}^{2}-10 & .\\end{aligned}\n$$"}] :knowledge-point/title "Completing the Square When the Perfect Square Is Isolated"} :step/id #uuid "8c7c2830-c121-536d-9010-2a49fcebeeb7" :step/next {:db/id #edb/ref 17592186184934}} {:db/id #edb/ref 17592186184934 :step/content {:db/id #edb/ref 17592186185384 :tutorial/content "Let's complete the square on the following expression: \n\n$$\nx^2 + 3x + 4\n$$\n\nThe procedure is very similar to the one we encountered when the coefficient of the linear term was even.\n\nFirst, we rewrite the coefficient of the linear term as a product with ${\\color{red}{2}}$ as a factor:\n\n$$\nx^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{3}{2}}}x + {\\color{purple}{4}}\n$$\n\nNow, here's the trick. We *add* and *then subtract* $\\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2,$ writing the constant term ${\\color{purple}{4}}$ last:\n\n$$\nx^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{3}{2}}}x  + \\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2 - \\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2 + {\\color{purple}{4}}\n$$\n\nAs a result, the first three terms now form a perfect square!\n\n$$\n\\underbrace{x^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{3}{2}}}x  + \\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2} - \\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2 + {\\color{purple}{4}}\n$$\n\nFactoring the perfect square, we get\n\n$$\n\\left(x + {\\color{blue}{\\dfrac{3}{2}}}\\right)^2  - \\left({\\color{blue}{\\dfrac{3}{2}}}\\right)^2 + {\\color{purple}{4}}.\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}+4 & = \\\\ {(x+\\frac{3}{2})}^{2}-\\frac{9}{4}+4 & = \\\\ {(x+\\frac{3}{2})}^{2}-\\frac{9}{4}+\\frac{16}{4} & = \\\\ {(x+\\frac{3}{2})}^{2}+\\frac{7}{4} & .\\end{aligned}\n$$" :tutorial/id #uuid "dba1a2d3-8092-514c-905c-9f6c001081ae" :tutorial/title "Completing the Square"} :step/id #uuid "e2ab26c1-628c-5277-a285-79d9416fcf17" :step/next {:db/id #edb/ref 17592186184935}} {:db/id #edb/ref 17592186184935 :step/content {:db/id #edb/ref 17592186184169 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183962 :question/id #uuid "05109436-7f8b-5ef9-a460-b53497a138f4" :question/math-academy-id "e-15020" :question/problem "Complete the square on the quadratic expression $x^2 + 7x - 1.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with ${\\color{red}{2}}$ as a factor:\n\n$$\nx^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{7}{2}}}x - {\\color{purple}{1}}\n$$\n\nNow, here's the trick. We *add* and *then subtract* $\\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2,$ writing the constant term ${\\color{purple}{-1}}$ last:\n\n$$\n\\underbrace{x^2 + {\\color{red}{2}}\\cdot {\\color{blue}{\\dfrac{7}{2}}}x  + \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2} - \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2 - {\\color{purple}{1}}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n\\left(x + {\\color{blue}{\\dfrac{7}{2}}}\\right)^2  - \\left({\\color{blue}{\\dfrac{7}{2}}}\\right)^2 - {\\color{purple}{1}}\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n\\left(x + {\\color{blue}{\\dfrac{7}{2}}}\\right)^2  - \\dfrac{53}{4}.\n$$"} :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/questions [{:db/id #edb/ref 17592186184457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "945964ef-8a0e-5d8c-924d-f6d3a1780683" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} + \\frac{1}{2}" :db/id #edb/ref 17592186180920} {:answer/id #uuid "ee0609ba-ae7a-5e08-ba84-64848c080c69" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} - \\frac{1}{2}" :db/id #edb/ref 17592186180921} {:answer/id #uuid "feacbd8b-44ff-562a-b9c6-04cd6c153e1e" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} - \\frac{1}{4}" :db/id #edb/ref 17592186180922} {:answer/id #uuid "132cbd12-bce9-5d91-918d-98e2c5c224b3" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{4})^{2} - \\frac{1}{4}" :db/id #edb/ref 17592186180923} {:answer/id #uuid "4e5c2cd4-3a2d-5fce-9add-f7ef2a74f498" :answer/type {:db/ident :answer.type/math} :answer/value "(n + \\frac{1}{2})^{2} + \\frac{1}{4}" :db/id #edb/ref 17592186180924}] :answer-field/id #uuid "d70eb358-4c87-5a71-9d95-eb12aa7628df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180919}] :question/id #uuid "8a738f34-f692-5d7d-8efb-05e39d3d0c4d" :question/math-academy-id "q-12880" :question/problem "Complete the square on the quadratic expression $n^{2} + n$."} {:db/id #edb/ref 17592186184554 :question/answer-fields [{:answer-field/id #uuid "9e167051-e22f-510e-aae7-ecac56b8a33e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181478} {:answer-field/id #uuid "ac029dc8-8802-5110-ba14-217515784b70" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181479}] :question/id #uuid "50734f27-301d-5936-b91c-e25181ba0c79" :question/math-academy-id "q-221412" :question/problem "Complete the square on the quadratic expression $x^{2} + 3x + 9$.$x^{2} + 3x + 9 = (x +$\n{{field-1}} $)^{2} +$\n{{field-2}}"} {:db/id #edb/ref 17592186272293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ed7dc5-6698-544e-8bd2-b698be8286f0" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-2" :db/id #edb/ref 17592186269786} {:answer/id #uuid "3e36f179-7a99-5b80-b4d9-f5843fe8a371" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{4})}^{2}-\\frac{9}{2}" :db/id #edb/ref 17592186269838} {:answer/id #uuid "775b0e34-1455-5f81-80d8-cdd1da1