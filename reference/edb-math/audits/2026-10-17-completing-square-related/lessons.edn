r-field/choices [{:answer/id #uuid "08c80b97-dd13-59cf-86fa-1becb3caf9d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288098}] :answer-field/correct {:answer/id #uuid "08c80b97-dd13-59cf-86fa-1becb3caf9d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288098} :answer-field/id #uuid "77bd53f0-18ae-5e39-bf99-8b07ee076ca3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289991} {:answer-field/choices [{:answer/id #uuid "0e03fbeb-fbc4-56a4-8b12-bf3188d05dac" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288132}] :answer-field/correct {:answer/id #uuid "0e03fbeb-fbc4-56a4-8b12-bf3188d05dac" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288132} :answer-field/id #uuid "b82afa5d-68f9-55e0-acca-52a6b15bdc7b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290131} {:answer-field/choices [{:answer/id #uuid "be3398a9-2294-5454-a14a-ea4a047a3b54" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289283}] :answer-field/correct {:answer/id #uuid "be3398a9-2294-5454-a14a-ea4a047a3b54" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289283} :answer-field/id #uuid "dd9c8eb3-8509-5c9d-845e-9e9e73b368cb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290202}] :question/id #uuid "d3ba39a5-e7a4-5a6a-9c2d-3395582bfc87" :question/math-academy-id "q-218771" :question/problem "The equation ${x}^{2}+8x+9=0$ is equivalent to$\\,(x\\,\\,+$\n{{field-1}}\n$)^{2}=$\n{{field-2}}, and the solutions are \n\n$x=$\n{{field-3}}\n$\\pm $\n{{field-4}}." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x+9 & =0 \\\\ {x}^{2}+8x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =-9 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =-9 \\\\ (x+4)^{2}-16 & =-9\\end{aligned}\n$$\n\nNow, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =-9 \\\\ (x+4)^{2} & =-9+16 \\\\ (x+4)^{2} & =7\\end{aligned}\n$$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =7 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{7} \\\\ x+4 & =\\pm \\sqrt{7} \\\\ x & =-4\\pm \\sqrt{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029fa0e3-dd36-5f3b-83ad-2cba2e31a6df" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=20" :db/id #edb/ref 17592186351588} {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} {:answer/id #uuid "371907b8-8d3b-547a-9416-21dcd94a96bf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=36" :db/id #edb/ref 17592186352079} {:answer/id #uuid "64af757f-a5f5-5de8-9518-714b14936255" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-16" :db/id #edb/ref 17592186352457} {:answer/id #uuid "67a3e342-6a19-5ca4-9745-f0c27bfd5f69" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186352490}] :answer-field/correct {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} :answer-field/id #uuid "6b5c2324-629b-5b3c-99c4-45b9f2afb50e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354016}] :question/id #uuid "6913ef2e-5530-525b-8ba5-681a643ef5b4" :question/math-academy-id "q-86404" :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$"} {:db/id #edb/ref 17592186399746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} {:answer/id #uuid "015db316-4ebb-5b1d-99f9-48da4423ea95" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=-2\\pm \\sqrt{2}" :db/id #edb/ref 17592186399749} {:answer/id #uuid "6bce9687-7b54-57ab-bfdf-8d118e548ef3" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=8,\\,m=4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399750} {:answer/id #uuid "b47af5b9-db68-5705-87ff-a810d0b94396" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399751} {:answer/id #uuid "51890425-293e-58e0-898f-8746f49fa609" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=14,\\,m=-4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399752}] :answer-field/correct {:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} :answer-field/id #uuid "1d4fba57-c484-5fd0-a729-550a53e648f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399747}] :question/id #uuid "6d70e8a4-cad6-5c6f-b225-88fe32f8d423" :question/math-academy-id "q-112487" :question/problem "The equation ${m}^{2}+8=-8m$ can be written in the form $(m+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-8m$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{m}^{2}+8 & =-8m \\\\ {m}^{2}+8m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m+{4}^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2}-{4}^{2} & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(m+4)^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2} & =8\\end{aligned}\n$$\n\nSo, $p=4,q=8,$ and $p+q=12.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(m+4)^{2} & =8 \\\\ \\sqrt{(m+4)^{2}} & =\\sqrt{8} \\\\ |m+4| & =\\sqrt{8} \\\\ m+4 & =\\pm 2\\sqrt{2} \\\\ m & =-4\\pm 2\\sqrt{2}\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"} :step/id #uuid "e3ee411c-e11a-597a-92ca-63d4511949eb"}] :activity/title "Solving Quadratic Equations by Completing the Square" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186068953}] [{:db/id #edb/ref 17592186049761 :topic/id #uuid "119f6367-1904-5d42-b538-ea1a0ba89992" :topic/knowledge-points [{:db/id #edb/ref 17592186087726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087527 :question/id #uuid "853bdfff-d043-58d0-bcb7-f1f5891eb31c" :question/math-academy-id "e-5216" :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $25x^2 + 9y^2 - 100x - 18y = 116.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+9{y}^{2}-100x-18y & =116 \\\\ (25{x}^{2}-100x)+(9{y}^{2}-18y) & =116\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}-100x)+(9{y}^{2}-18y) & =116 \\\\ 25[{x}^{2}-4x]+9[{y}^{2}-2y] & =116 \\\\ 25[(x-2)^{2}-4]+9[(y-1)^{2}-1] & =116 \\\\ 25(x-2)^{2}-100+9(y-1)^{2}-9 & =116\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x-2)^{2}-100+9(y-1)^{2}-9 & =116 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =116+100+9 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =225 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y-1)^{2}}{25} & =1 \\\\ \\frac{(x-2)^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5 > 3,$ the length of the major axis is $2\\cdot 5 =10,$ the length of the minor axis is $2\\cdot 3 =6,$ and the ellipse is centered at $({2},{1}).$"} :knowledge-point/id #uuid "d21d6066-f7c8-5a47-b150-d0ae25d2d60b" :knowledge-point/questions [{:db/id #edb/ref 17592186088331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8182e176-8ad5-5794-9546-e0cab61c87f8" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186086641} {:answer/id #uuid "aaefc3c2-e9a1-5aa2-8d94-df214b700228" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186086642} {:answer/id #uuid "f72004c0-12e4-5d4a-bd59-ab2c611aa6e4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186086643} {:answer/id #uuid "1565f4bf-bc71-5563-9931-6110ae4f8e0e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186086644} {:answer/id #uuid "3fabd35a-c0da-50a3-86ef-91c12db63a34" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186086645}] :answer-field/id #uuid "9bf7bc07-ab47-59a8-a2ab-e45ffaca5f84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086640}] :question/id #uuid "ac4a4a32-6149-5196-bd2f-97e5ca12903b" :question/math-academy-id "q-7636" :question/problem "Consider the ellipse whose equation is $4x^{2} + 9y^{2} - 24x + 18y =-9$. Which of the following statements are true?\n\n1. Its center is $(3,-1)$\n2. The length of the major axis is $9$\n3. The length of the minor axis is $4$"} {:db/id #edb/ref 17592186088332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "994e97b3-6987-5577-a0e4-7d25e6f24c73" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 2)" :db/id #edb/ref 17592186086647} {:answer/id #uuid "bd2b98a3-98fb-5faf-8a5b-84afa2493f71" :answer/type {:db/ident :answer.type/math} :answer/value "(-2, 3)" :db/id #edb/ref 17592186086648} {:answer/id #uuid "e938b01a-9fac-5acd-9d0c-e0d0b80a106e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-4)" :db/id #edb/ref 17592186086649} {:answer/id #uuid "2e255213-b6e4-5ea7-8181-f6176d7b3763" :answer/type {:db/ident :answer.type/math} :answer/value "(-3, 4)" :db/id #edb/ref 17592186086650} {:answer/id #uuid "3ec93fb5-01be-50c0-af25-158e5472ac05" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 1)" :db/id #edb/ref 17592186086651}] :answer-field/id #uuid "2c3b8fc3-0d06-5d00-a824-b467d0fa287c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086646}] :question/id #uuid "e7850063-16ff-5266-9b88-31c8a361bb41" :question/math-academy-id "q-7637" :question/problem "Determine the center of the ellipse whose equation is $2x^{2} + 3y^{2} + 16x - 6y =-11$."} {:db/id #edb/ref 17592186250395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4515f7cd-0daf-58a6-88f8-51f7935b3d5f" :answer/type {:db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186248042} {:answer/id #uuid "757c87dc-8a4a-53b7-80be-5b6a95063d0c" :answer/type {:db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186248457} {:answer/id #uuid "8167c83a-d966-57ab-9b41-7236abdf4e83" :answer/type {:db/ident :answer.type/math} :answer/value "(4,2\\sqrt{3})" :db/id #edb/ref 17592186248569} {:answer/id #uuid "e8bac777-996e-581c-b122-df596f19ccd5" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249480} {:answer/id #uuid "fe2210bd-637b-58a9-b4fb-532ee18e1955" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186249646}] :answer-field/correct {:answer/id #uuid "e8bac777-996e-581c-b122-df596f19ccd5" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249480} :answer-field/id #uuid "5bbdb522-2627-5194-81bf-57003e4d61da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249836}] :question/id #uuid "0b1c09a8-ecd6-5ac4-aed2-f9a5b10019aa" :question/math-academy-id "q-115314" :question/problem "Determine the center of the ellipse whose equation is $3{x}^{2}+4{y}^{2}+36x+32y=-124.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}3{x}^{2}+4{y}^{2}+36x+32y & =-124 \\\\ (3{x}^{2}+36x)+(4{y}^{2}+32y) & =-124\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(3{x}^{2}+36x)+(4{y}^{2}+32y) & =-124 \\\\ 3[{x}^{2}+12x]+4[{y}^{2}+8y] & =-124 \\\\ 3[(x+6)^{2}-{6}^{2}]+4[(y+4)^{2}-{4}^{2}] & =-124 \\\\ 3[(x+6)^{2}-36]+4[(y+4)^{2}-16] & =-124 \\\\ 3(x+6)^{2}-108+4(y+4)^{2}-64 & =-124\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}3(x+6)^{2}-108+4(y+4)^{2}-64 & =-124 \\\\ 3(x+6)^{2}+4(y+4)^{2} & =-124+108+64 \\\\ 3(x+6)^{2}+4(y+4)^{2} & =48 \\\\ \\frac{(x+6)^{2}}{16}+\\frac{(y+4)^{2}}{12} & =1 \\\\ \\frac{(x+6)^{2}}{{4}^{2}}+\\frac{(y+4)^{2}}{(2\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-6,-4).$"} {:db/id #edb/ref 17592186295105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0c63222-248f-5831-8301-5127b19ff14e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186293811}] :answer-field/correct {:answer/id #uuid "e0c63222-248f-5831-8301-5127b19ff14e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186293811} :answer-field/id #uuid "4f05eec3-7851-5ab5-9730-c5e9ed785d0b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294211} {:answer-field/choices [{:answer/id #uuid "08bd93b3-96d5-5beb-a2f0-fd1e50255e82" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292969}] :answer-field/correct {:answer/id #uuid "08bd93b3-96d5-5beb-a2f0-fd1e50255e82" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292969} :answer-field/id #uuid "ef2de9e4-0284-5f42-be26-6988bddc8406" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294769}] :question/id #uuid "6ff9327d-118b-5b01-ad59-d9df405fddb6" :question/math-academy-id "q-279719" :question/problem "Determine the lengths of the major and minor axes of the ellipse whose equation is $2{x}^{2}+{y}^{2}+12x-4y=-20.$\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is\n{{field-2}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}+12x-4y & =-20 \\\\ (2{x}^{2}+12x)+({y}^{2}-4y) & =-20\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(2{x}^{2}+12x)+({y}^{2}-4y) & =-20 \\\\ 2({x}^{2}+6x)+({y}^{2}-4y) & =-20 \\\\ 2[(x+3)^{2}-9]+[(y-2)^{2}-4] & =-20 \\\\ 2(x+3)^{2}-18+(y-2)^{2}-4 & =-20\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}2(x+3)^{2}-18+(y-2)^{2}-4 & =-20 \\\\ 2(x+3)^{2}+(y-2)^{2} & =-20+18+4 \\\\ 2(x+3)^{2}+(y-2)^{2} & =2 \\\\ \\frac{(x+3)^{2}}{1}+\\frac{(y-2)^{2}}{2} & =1 \\\\ \\frac{(x+3)^{2}}{{1}^{2}}+\\frac{(y-2)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nSince $\\sqrt{2}>1,$ the length of the major axis  $=2\\cdot \\sqrt{2}=2\\sqrt{2},$ and the length of the minor axis  $=2\\cdot 1=2.$"} {:db/id #edb/ref 17592186295106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd41b81c-81c3-5a26-a382-028fa2bcd639" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293922}] :answer-field/correct {:answer/id #uuid "fd41b81c-81c3-5a26-a382-028fa2bcd639" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293922} :answer-field/id #uuid "277aaa24-d379-5c86-8180-82d9800eed7b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294054} {:answer-field/choices [{:answer/id #uuid "73168334-b144-5f6f-b43a-b42e59e682ab" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293404}] :answer-field/correct {:answer/id #uuid "73168334-b144-5f6f-b43a-b42e59e682ab" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293404} :answer-field/id #uuid "c7e7e9d0-8105-5d07-905e-5d02a8fb84e6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294637}] :question/id #uuid "7b32fe41-7b78-5c91-bbe4-31adfa7b2b86" :question/math-academy-id "q-279720" :question/problem "Determine the lengths of the major and minor axes of the ellipse whose equation is $4{x}^{2}+9{y}^{2}-16x+18y=119.$\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is\n{{field-2}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2}-16x+18y & =119 \\\\ (4{x}^{2}-16x)+(9{y}^{2}+18y) & =119\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-16x)+(9{y}^{2}+18y) & =119 \\\\ 4({x}^{2}-4x)+9({y}^{2}+2y) & =119 \\\\ 4[(x-2)^{2}-4]+9[(y+1)^{2}-1] & =119 \\\\ 4(x-2)^{2}-16+9(y+1)^{2}-9 & =119\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-2)^{2}-16+9(y+1)^{2}-9 & =119 \\\\ 4(x-2)^{2}+9(y+1)^{2} & =119+16+9 \\\\ 4(x-2)^{2}+9(y+1)^{2} & =144 \\\\ \\frac{(x-2)^{2}}{36}+\\frac{(y+1)^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{{6}^{2}}+\\frac{(y+1)^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nSince $6>4,$ the length of the major axis  $=2\\cdot 6=12,$ and the length of the minor axis  $=2\\cdot 4=8.$"} {:db/id #edb/ref 17592186341888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fc4000-62ff-5182-a26a-035ae1251347" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186339358} {:answer/id #uuid "51691912-8755-5a07-a647-6d28e2647dcb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186339876} {:answer/id #uuid "9a581d22-8c34-545c-94dd-3cde512dcecf" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186340518} {:answer/id #uuid "9f32f3aa-b253-5617-8207-b6a5223e98c7" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186340565} {:answer/id #uuid "ce4d8a99-ac46-5b03-ae49-5545a012f93e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186340962}] :answer-field/correct {:answer/id #uuid "19fc4000-62ff-5182-a26a-035ae1251347" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186339358} :answer-field/id #uuid "166efa29-bcb7-5568-883b-86db967a44a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341420}] :question/id #uuid "6f0d0009-b766-5be4-a470-30d32f4056c3" :question/math-academy-id "q-72939" :question/problem "Determine the center of the ellipse whose equation is $5{x}^{2}+2{y}^{2}+20x-12y=-28.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+2{y}^{2}+20x-12y & =-28 \\\\ (5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28 \\\\ 5({x}^{2}+4x)+2({y}^{2}-6y) & =-28 \\\\ 5[(x+2)^{2}-4]+2[(y-3)^{2}-9] & =-28 \\\\ 5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =-28+20+18 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =10 \\\\ \\frac{(x+2)^{2}}{2}+\\frac{(y-3)^{2}}{5} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-2,3).$"} {:db/id #edb/ref 17592186345205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3adfcb62-7ac7-590b-be06-2e8243f4dc65" :answer/type {:db/ident :answer.type/math} :answer/value "(2,4)" :db/id #edb/ref 17592186342720} {:answer/id #uuid "4ad1531f-e1cf-5ebe-ad81-a38e2a113f1f" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186342853} {:answer/id #uuid "6f8cbcdc-3ebb-5a0c-ab73-51b9ffaf200d" :answer/type {:db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186343197} {:answer/id #uuid "7e843273-2386-57fa-b165-5aee9ac338af" :answer/type {:db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186343328} {:answer/id #uuid "f2d228be-5c04-5444-b3a0-25193a937280" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186344371}] :answer-field/correct {:answer/id #uuid "f2d228be-5c04-5444-b3a0-25193a937280" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186344371} :answer-field/id #uuid "ab2f6a43-fe63-5c02-bab3-608eea1fae56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344793}] :question/id #uuid "b972a86c-4480-5828-a8e2-d62f9765dca2" :question/math-academy-id "q-7632" :question/problem "Determine the center of the ellipse whose equation is $5{x}^{2}+9{y}^{2}-10x-36y=4.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+9{y}^{2}-10x-36y & =4 \\\\ (5{x}^{2}-10x)+(9{y}^{2}-36y) & =4\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}-10x)+(9{y}^{2}-36y) & =4 \\\\ 5[{x}^{2}-2x]+9[{y}^{2}-4y] & =4 \\\\ 5[(x-1)^{2}-{1}^{2}]+9[(y-2)^{2}-{2}^{2}] & =4 \\\\ 5[(x-1)^{2}-1]+9[(y-2)^{2}-4] & =4 \\\\ 5(x-1)^{2}-5+9(y-2)^{2}-36 & =4\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x-1)^{2}-5+9(y-2)^{2}-36 & =4 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =4+5+36 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =45 \\\\ \\frac{(x-1)^{2}}{9}+\\frac{(y-2)^{2}}{5} & =1 \\\\ \\frac{(x-1)^{2}}{{3}^{2}}+\\frac{(y-2)^{2}}{(\\sqrt{5})^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(1,2).$"} {:db/id #edb/ref 17592186396134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf85bac6-b89d-5c73-adb5-4938e4b8f922" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471519} {:answer/id #uuid "4e5a20bb-c60f-5338-87c9-e2490e64f006" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471520}] :answer-field/correct {:answer/id #uuid "4e5a20bb-c60f-5338-87c9-e2490e64f006" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471520} :answer-field/id #uuid "2c23e7a2-a53b-5060-bbaf-9b3bfe5e7a0f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472265} {:answer-field/choices [{:answer/id #uuid "e3b974d4-3fd9-51e3-bc6c-5f28cf8e13fb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471521} {:answer/id #uuid "ece7e85c-4f4f-5b66-afe1-c4c1f94870d9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471522}] :answer-field/correct {:answer/id #uuid "e3b974d4-3fd9-51e3-bc6c-5f28cf8e13fb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471521} :answer-field/id #uuid "844f18a7-507e-59d5-b3d2-aaaf4e9e2971" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472266} {:answer-field/choices [{:answer/id #uuid "37ef67bd-4095-53fe-94d3-afa4b2bac162" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471523} {:answer/id #uuid "98e15137-ba00-5798-bf72-ba42aba63f83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471524}] :answer-field/correct {:answer/id #uuid "98e15137-ba00-5798-bf72-ba42aba63f83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471524} :answer-field/id #uuid "fdc3abea-1ce4-58a0-a0ef-8401134def94" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472267}] :question/id #uuid "fd2cdae2-5e26-5778-ab7e-65d79d794e32" :question/math-academy-id "q-7639" :question/problem "Consider the ellipse whose equation is ${x}^{2}+2{y}^{2}-2x+12y=-11.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(1,-3)$\n- **II.** The length of the major axis  is $2\\sqrt{2}$\n- **III.** The length of the minor axis is $4$" :question/worked-solution "First, we must group the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+2{y}^{2}-2x+12y & =-11 \\\\ ({x}^{2}-2x)+(2{y}^{2}+12y) & =-11\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-2x)+(2{y}^{2}+12y) & =-11 \\\\ [{x}^{2}-2x]+2[{y}^{2}+6y] & =-11 \\\\ [(x-1)^{2}-{1}^{2}]+2[(y+3)^{2}-{3}^{2}] & =-11 \\\\ [(x-1)^{2}-1]+2[(y+3)^{2}-9] & =-11 \\\\ (x-1)^{2}-1+2(y+3)^{2}-18 & =-11\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-1)^{2}-1+2(y+3)^{2}-18 & =-11 \\\\ (x-1)^{2}+2(y+3)^{2} & =-11+1+18 \\\\ (x-1)^{2}+2(y+3)^{2} & =8 \\\\ \\frac{(x-1)^{2}}{8}+\\frac{(y+3)^{2}}{4} & =1 \\\\ \\frac{(x-1)^{2}}{(2\\sqrt{2})^{2}}+\\frac{(y+3)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nSince $2\\sqrt{2}>2,$ the length of the major axis is $2\\cdot 2\\sqrt{2}=4\\sqrt{2},$ the length of the minor axis is $2\\cdot 2=4,$ and the ellipse is centered at $(1,-3).$\n\nTherefore,  I and III are true, and II is false."} {:db/id #edb/ref 17592186403606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c381e28-47d1-516c-ba70-7941c1b4c573" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $1$" :db/id #edb/ref 17592186403608} {:answer/id #uuid "c7ab0ed2-8c80-5ee7-ad45-3c43ece3b795" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186403609} {:answer/id #uuid "e0ac736d-0463-57d0-9db1-2a7177ddc558" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186403610} {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} {:answer/id #uuid "cfd845e5-ca89-50e3-8d11-42ad65bcd599" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186403612}] :answer-field/correct {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} :answer-field/id #uuid "66032e6a-59fa-5bca-a1f1-2d6e69a901e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403607}] :question/id #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" :question/math-academy-id "q-72934" :question/problem "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$"}] :knowledge-point/title "Determining the Center and Axis Lengths Given an Inhomogeneous Polynomial Equation of an Ellipse"} {:db/id #edb/ref 17592186087727 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087528 :question/id #uuid "0b3df81e-03a7-5cf2-b815-f999012b9b2b" :question/math-academy-id "e-5217" :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $x^2 + 4y^2 - 6x + 24y + 41 = 0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-6x+24y+41 & =0 \\\\ ({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0 \\\\ ({x}^{2}-6x)+4[{y}^{2}+6y]+41 & =0 \\\\ (x-3)^{2}-9+4[(y+3)^{2}-9]+41 & =0 \\\\ (x-3)^{2}-9+4(y+3)^{2}-36+41 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-3)^{2}-9+4(y+3)^{2}-36+41 & =0 \\\\ (x-3)^{2}+4(y+3)^{2} & =9+36-41 \\\\ (x-3)^{2}+4(y+3)^{2} & =4 \\\\ \\frac{(x-3)^{2}}{4}+\\frac{(y+3)^{2}}{1} & =1 \\\\ \\frac{(x-3)^{2}}{{2}^{2}}+\\frac{(y+3)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2 > 1,$ the length of the major axis is $2\\cdot 2 =4,$ the length of the minor axis is $2\\cdot 1 =2,$ and the ellipse is centered at $({3},{-3}).$"} :knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632" :knowledge-point/questions [{:db/id #edb/ref 17592186088042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34f54f0-2fdb-55b5-8145-9bf8acbf153a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186084987} {:answer/id #uuid "c167508c-7437-5c27-a702-0d58b4594b4b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186084988} {:answer/id #uuid "07f83f05-a5c0-581b-99c5-d70b77414bfb" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186084989} {:answer/id #uuid "1428c4ef-8686-5bc8-9eaf-1a2b0b5c467a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186084990} {:answer/id #uuid "34a00d43-cc72-59d6-ada0-8d7e195f8988" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186084991}] :answer-field/id #uuid "88e37366-9342-5897-89d4-43dd038e71fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084986}] :question/id #uuid "315f7358-7df9-5bd5-9f06-5181f55727ff" :question/math-academy-id "q-16563" :question/problem "Consider the ellipse whose equation is $2x^{2} + 9y^{2} + 16x - 90y + 239 = 0$. Which of the following statements are true?\n\n1. Its center is $(-4, 5)$\n2. The length of the major axis is $4$\n3. The length of the minor axis is $2\\sqrt{3}$"} {:db/id #edb/ref 17592186088043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ab3be2-8f62-572a-9d93-75e373713004" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186084993} {:answer/id #uuid "94182ccf-2b8c-5af3-892b-2a61c090176c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186084994} {:answer/id #uuid "951c98a0-9585-589d-af84-c88586b6d078" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186084995} {:answer/id #uuid "fb38f930-d289-5ab6-8c41-509ed6e8afee" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186084996} {:answer/id #uuid "43fc5d49-c3f8-5ba9-98fe-fc80105c8aaa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186084997}] :answer-field/id #uuid "aa885b7b-141d-52d3-9388-0b997c1fa872" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084992}] :question/id #uuid "78cc6970-10a3-519b-8c8a-18166d49b3ac" :question/math-academy-id "q-16564" :question/problem "Determine the length of the major axis of the ellipse whose equation is $5x^{2} + y^{2} - 30x + 40 = 0$."} {:db/id #edb/ref 17592186250396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e63bcb-4809-51fe-b6c3-080655bfb0b7" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186247631} {:answer/id #uuid "1e81b794-7465-53a2-acbb-2122b17253fa" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186247695} {:answer/id #uuid "59fa202e-084a-55c9-a1dc-46370c43eb22" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186248237} {:answer/id #uuid "796f9264-e95b-5e12-81a1-7df990f9e532" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186248492} {:answer/id #uuid "cf6413e1-a185-5cc6-aceb-d217706e77b7" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186249265}] :answer-field/correct {:answer/id #uuid "1e81b794-7465-53a2-acbb-2122b17253fa" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186247695} :answer-field/id #uuid "f3d5845f-a611-5650-94c4-385364233a0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250100}] :question/id #uuid "abf43efd-2730-5511-9044-94688958afd8" :question/math-academy-id "q-115316" :question/problem "Determine the center of the ellipse whose equation is\n$2{x}^{2}+{y}^{2}+16x-2y+29=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}+16x-2y+29 & =0 \\\\ (2{x}^{2}+16x)+({y}^{2}-2y)+29 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(2{x}^{2}+16x)+({y}^{2}-2y)+29 & =0 \\\\ 2[{x}^{2}+8x]+[{y}^{2}-2y]+29 & =0 \\\\ 2[(x+4)^{2}-{4}^{2}]+[(y-1)^{2}-{1}^{2}]+29 & =0 \\\\ 2[(x+4)^{2}-16]+[(y-1)^{2}-1]+29 & =0 \\\\ 2(x+4)^{2}-32+(y-1)^{2}-1+29 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}2(x+4)^{2}-32+(y-1)^{2}-1+29 & =0 \\\\ 2(x+4)^{2}+(y-1)^{2} & =32+1-29 \\\\ 2(x+4)^{2}+(y-1)^{2} & =4 \\\\ \\frac{(x+4)^{2}}{2}+\\frac{(y-1)^{2}}{4} & =1 \\\\ \\frac{(x+4)^{2}}{(\\sqrt{2})^{2}}+\\frac{(y-1)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-4,1).$"} {:db/id #edb/ref 17592186284557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0df234-c3b6-5275-bb55-70afecc12dcd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282318} {:answer/id #uuid "73e8f492-0bf9-55fe-8d92-a94b65a8a1bf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186282679} {:answer/id #uuid "852acf03-ef6d-5d5a-93f1-5a863b5cd35f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282838} {:answer/id #uuid "ae906ad3-e496-5dba-89a5-dc17369dcfbe" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186283198} {:answer/id #uuid "ccd6b550-eb59-5d55-bc61-e0518c41c707" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186283479}] :answer-field/correct {:answer/id #uuid "4a0df234-c3b6-5275-bb55-70afecc12dcd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282318} :answer-field/id #uuid "62372821-ae81-53cd-908a-823dfcb9b5ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284096}] :question/id #uuid "5ed2b043-750a-5637-b0ae-a564424a079c" :question/math-academy-id "q-16561" :question/problem "Determine the length of the minor axis of the ellipse whose equation is  $25{x}^{2}+4{y}^{2}+100x–40y+100=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+4{y}^{2}+100x–40y+100 & =0 \\\\ (25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0 \\\\ 25[{x}^{2}+4x]+4[{y}^{2}-10y]+100 & =0 \\\\ 25[(x+2)^{2}-{2}^{2}]+4[(y-5)^{2}-{5}^{2}]+100 & =0 \\\\ 25[(x+2)^{2}-4]+4[(y-5)^{2}-25]+100 & =0 \\\\ 25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =-100+100+100 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =100 \\\\ \\frac{(x+2)^{2}}{4}+\\frac{(y-5)^{2}}{25} & =1 \\\\ \\frac{(x+2)^{2}}{{2}^{2}}+\\frac{(y-5)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>2,$ the length of the minor axis is $2\\cdot 2=4.$"} {:db/id #edb/ref 17592186284558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345441f2-5087-5b4b-a170-90bd9b45c571" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450084} {:answer/id #uuid "6254eb3a-73c1-5ab0-ad43-6689f0121fa7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450085}] :answer-field/correct {:answer/id #uuid "6254eb3a-73c1-5ab0-ad43-6689f0121fa7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450085} :answer-field/id #uuid "ade2cdd4-1d37-5b7e-95ec-f1c1d23d5682" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450996} {:answer-field/choices [{:answer/id #uuid "39dcc466-ba2e-5602-ad92-d2b70dc0ca1e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450086} {:answer/id #uuid "eef8513c-faf1-5a9c-bdee-f872e4aea8ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450087}] :answer-field/correct {:answer/id #uuid "39dcc466-ba2e-5602-ad92-d2b70dc0ca1e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450086} :answer-field/id #uuid "25be7e84-c62f-5a39-8971-0aa1b7350b97" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450997} {:answer-field/choices [{:answer/id #uuid "d6047f0f-3255-59c4-8ede-45caac330c15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450088} {:answer/id #uuid "8e1502e5-81a3-537f-95d3-b3d0727811dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450089}] :answer-field/correct {:answer/id #uuid "d6047f0f-3255-59c4-8ede-45caac330c15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450088} :answer-field/id #uuid "3c2d7ce5-553e-5e2f-a362-c4933f79bc92" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450998}] :question/id #uuid "0602fa5a-d2db-5bf8-9142-ab8253a6eb55" :question/math-academy-id "q-16562" :question/problem "Consider the ellipse whose equation is $4{x}^{2}+9{y}^{2}–48x+72y+144=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(6,-4)$\n- **II.** The length of the major axis is $6$\n- **III.** The length of the minor axis is $4$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2}–48x+72y+144 & =0 \\\\ (4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0 \\\\ 4[{x}^{2}-12x]+9[{y}^{2}+8y]+144 & =0 \\\\ 4[(x-6)^{2}-{6}^{2}]+9[(y+4)^{2}-{4}^{2}]+144 & =0 \\\\ 4[(x-6)^{2}-36]+9[(y+4)^{2}-16]+144 & =0 \\\\ 4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =-144+144+144 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =144 \\\\ \\frac{(x-6)^{2}}{36}+\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{(x-6)^{2}}{{6}^{2}}+\\frac{(y+4)^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nSince $6>4,$ the length of the major axis is $2\\cdot 6=12,$ the length of the minor axis is $2\\cdot 4=8,$ and the ellipse is centered at $(6,-4).$\n\nTherefore, statement I is true, statements II and III are false."} {:db/id #edb/ref 17592186284559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22961d8f-86d9-5ab2-b42e-0012e783a23f" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186281993} {:answer/id #uuid "2b13c0a9-a51b-523a-9ce4-3254dce6faef" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186282067} {:answer/id #uuid "8666c22c-5eb3-5056-869a-853adc498f85" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282848} {:answer/id #uuid "959b5fee-bb15-5499-82bb-5faf30029096" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282980} {:answer/id #uuid "9c88853b-9cd6-530a-ad8a-4bf8ba0d8592" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186283053}] :answer-field/correct {:answer/id #uuid "2b13c0a9-a51b-523a-9ce4-3254dce6faef" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186282067} :answer-field/id #uuid "2871ec54-332b-5cf4-8084-1f8c2e08bc69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284007}] :question/id #uuid "beb4f1e9-9ce4-5e8f-a547-7adfbf588a59" :question/math-academy-id "q-16565" :question/problem "Determine the length of the major axis of the ellipse whose equation is ${x}^{2}+4{y}^{2}+10x-16y+25=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}+10x-16y+25 & =0 \\\\ ({x}^{2}+10x)+(4{y}^{2}-16y)+25 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}+10x)+(4{y}^{2}-16y)+25 & =0 \\\\ [{x}^{2}+10x]+4[{y}^{2}-4y]+25 & =0 \\\\ [(x+5)^{2}-{5}^{2}]+4[(y-2)^{2}-{2}^{2}]+25 & =0 \\\\ [(x+5)^{2}-25]+4[(y-2)^{2}-4]+25 & =0 \\\\ (x+5)^{2}-25+4(y-2)^{2}-16+25 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x+5)^{2}-25+4(y-2)^{2}-16+25 & =0 \\\\ (x+5)^{2}+4(y-2)^{2} & =25-25+16 \\\\ (x+5)^{2}+4(y-2)^{2} & =16 \\\\ \\frac{(x+5)^{2}}{16}+\\frac{(y-2)^{2}}{4} & =1 \\\\ \\frac{(x+5)^{2}}{{4}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nSince $4>2,$ the length of the major axis is $2\\cdot 4=8.$"} {:db/id #edb/ref 17592186284560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114aae92-2225-5183-80c7-9284961bdf5a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186281851} {:answer/id #uuid "7b8c3cc2-16f9-5565-9b9b-8a3c610ae938" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186282751} {:answer/id #uuid "94fc378f-de20-59b5-94e6-4c86acf68439" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186282974} {:answer/id #uuid "9ed6d53e-2324-5aa2-9689-a46b0d2dffc6" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186283072} {:answer/id #uuid "e4883d76-b503-580f-a5ea-9d23fd77d194" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186283681}] :answer-field/correct {:answer/id #uuid "94fc378f-de20-59b5-94e6-4c86acf68439" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186282974} :answer-field/id #uuid "191f7906-e711-5a73-a603-018d1e87a170" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283985}] :question/id #uuid "59b2b2f3-1020-59f6-8e6c-939fc6a04444" :question/math-academy-id "q-16566" :question/problem "Determine the center of the ellipse whose equation is\n$4{x}^{2}+{y}^{2}-16x+2y+13=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-16x+2y+13 & =0 \\\\ (4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0 \\\\ 4[{x}^{2}-4x]+[{y}^{2}+2y]+13 & =0 \\\\ 4[(x-2)^{2}-{2}^{2}]+[(y+1)^{2}-{(1)}^{2}]+13 & =0 \\\\ 4[(x-2)^{2}-4]+[(y+1)^{2}-1]+13 & =0 \\\\ 4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0 \\\\ 4(x-2)^{2}+(y+1)^{2} & =-13+1+16 \\\\ 4(x-2)^{2}+(y+1)^{2} & =4 \\\\ (x-2)^{2}+\\frac{(y+1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{{1}^{2}}+\\frac{(y+1)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(2,-1).$"} {:db/id #edb/ref 17592186284566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2957afb5-8dcc-5a3c-be47-05cd7087772b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450090} {:answer/id #uuid "fa300c46-2e42-5e26-904d-c234a85fedd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450091}] :answer-field/correct {:answer/id #uuid "fa300c46-2e42-5e26-904d-c234a85fedd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450091} :answer-field/id #uuid "88ebc973-6cfc-5de6-929b-112f67a157b8" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450999} {:answer-field/choices [{:answer/id #uuid "7be024a6-037e-5a9c-8731-7ee43c421778" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450092} {:answer/id #uuid "4da959f1-cca3-58ea-9511-04f4035a7d01" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450093}] :answer-field/correct {:answer/id #uuid "7be024a6-037e-5a9c-8731-7ee43c421778" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450092} :answer-field/id #uuid "199799b9-038e-5a89-b4fd-5681ab30823f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451000} {:answer-field/choices [{:answer/id #uuid "bfa900cf-a600-5125-b96f-9228d0ef5991" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450094} {:answer/id #uuid "ece15639-1727-5187-966a-fffa729d12cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450095}] :answer-field/correct {:answer/id #uuid "ece15639-1727-5187-966a-fffa729d12cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450095} :answer-field/id #uuid "21f5c4b2-643a-5f2f-b14b-8553d388fa54" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451001}] :question/id #uuid "f98a559b-0a7a-50c5-b65c-b026bdee915b" :question/math-academy-id "q-16639" :question/problem "Consider the ellipse whose equation is $3{x}^{2}+{y}^{2}-9=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(0,0)$\n- **II.** The length of the major axis is $3$\n- **III.** The length of the minor axis is $2\\sqrt{3}$" :question/worked-solution "We rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}3{x}^{2}+{y}^{2}-9 & =0 \\\\ 3{x}^{2}+{y}^{2} & =9 \\\\ \\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{9} & =1 \\\\ \\frac{(x-0)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y-0)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $3>\\sqrt{3},$ the length of the major axis is $2\\cdot 3=6,$ the length of the minor axis is $2\\cdot \\sqrt{3}=2\\sqrt{3},$ and the ellipse is centered at $(0,0).$\n\nTherefore, statements I and III are true, statement II is false."} {:db/id #edb/ref 17592186295107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f3b54e5-b23e-55b9-beae-25109bf3750d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293489}] :answer-field/correct {:answer/id #uuid "8f3b54e5-b23e-55b9-beae-25109bf3750d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293489} :answer-field/id #uuid "b94af748-45f7-5779-8621-3828bbb38ba4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294590} {:answer-field/choices [{:answer/id #uuid "ca38808e-4a06-547d-9aba-c6ce5d923c23" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293716}] :answer-field/correct {:answer/id #uuid "ca38808e-4a06-547d-9aba-c6ce5d923c23" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293716} :answer-field/id #uuid "db3e1c00-e6cb-5449-9c66-f279f8559bdb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294701}] :question/id #uuid "6e1be62d-fda7-56ea-99d2-1ed30bff13cb" :question/math-academy-id "q-279724" :question/problem "The center of the ellipse $6{x}^{2}+5{y}^{2}-36x+50y-1=0$ is located at the point$\\,($\n{{field-1}},\n{{field-2}}$).$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}+5{y}^{2}-36x+50y-1 & =0 \\\\ (6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0 \\\\ 6[{x}^{2}-6x]+5[{y}^{2}+10y]-1 & =0 \\\\ 6[(x-3)^{2}-{3}^{2}]+5[(y+5)^{2}-{5}^{2}]-1 & =0 \\\\ 6[(x-3)^{2}-9]+5[(y+5)^{2}-25]-1 & =0 \\\\ 6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =1+54+125 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =180 \\\\ \\frac{(x-3)^{2}}{30}+\\frac{(y+5)^{2}}{36} & =1 \\\\ \\frac{(x-3)^{2}}{(\\sqrt{30})^{2}}+\\frac{(y+5)^{2}}{{6}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(3,-5).$"} {:db/id #edb/ref 17592186295108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99574deb-0466-5daa-8347-3da8ad7f3e67" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293537}] :answer-field/correct {:answer/id #uuid "99574deb-0466-5daa-8347-3da8ad7f3e67" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293537} :answer-field/id #uuid "776bdf59-0955-54fd-8f41-2a83cb7fb1dc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294355}] :question/id #uuid "de7e4604-2681-5fe9-a457-e4de26ceb8bc" :question/math-academy-id "q-279726" :question/problem "For the ellipse $9{x}^{2}+25{y}^{2}+72x-100y+19=0$, the length of the major axis is{{field-1}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}9{x}^{2}+25{y}^{2}+72x-100y+19 & =0 \\\\ (9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0 \\\\ 9[{x}^{2}+8x]+25[{y}^{2}-4y]+19 & =0 \\\\ 9[(x+4)^{2}-{4}^{2}]+25[(y-2)^{2}-{2}^{2}]+19 & =0 \\\\ 9[(x+4)^{2}-16]+25[(y-2)^{2}-4]+19 & =0 \\\\ 9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =-19+100+144 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =225 \\\\ \\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(x+4)^{2}}{{5}^{2}}+\\frac{(y-2)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>3,$ the length of the major axis is $2\\cdot 5=10.$"}] :knowledge-point/title "Determining the Center and Axis Lengths Given a Homogeneous Polynomial Equation of an Ellipse"}] :topic/title "Finding the Center and Axes of Ellipses by Completing the Square"} {:activity/first-step {:db/id #edb/ref 17592186088571} :activity/id #uuid "cfd7d9b8-adb4-56f8-9c9b-f5a62d5fb88c" :activity/steps [{:db/id #edb/ref 17592186088571 :step/content {:db/id #edb/ref 17592186088911 :tutorial/content "Let's consider the equation $4x^2+y^2 - 8x - 4y = 8.$ Its graph is given below.\n\n![](images/bb/bb75dab958d3dedba6e6b685b88f393aa6c28c15c2e52b414a30e97fdfa68a9e.png)\n\nClearly, this is an ellipse. To determine the center and the lengths of the major and minor axes, we need to rewrite the given equation in the standard form\n\n$$\n\\dfrac{(x-h)^2}{{a}^2}+\\dfrac{(y-k)^2}{{b}^2}=1,\n$$\n\nwhere $(h,k)$ is the center of the ellipse, and $a$ and $b$ are the horizontal and vertical radii of the ellipse, respectively. \n\nWe do this by completing the square. First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-4y & =8 \\\\ (4{x}^{2}-8x)+({y}^{2}-4y) & =8\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-8x)+({y}^{2}-4y) & =8 \\\\ 4[{x}^{2}-2x]+{y}^{2}-4y & =8 \\\\ 4[(x-1)^{2}-1]+(y-2)^{2}-4 & =8 \\\\ 4(x-1)^{2}-4+(y-2)^{2}-4 & =8.\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-1)^{2}-4+(y-2)^{2}-4 & =8 \\\\ 4(x-1)^{2}+(y-2)^{2} & =8+4+4 \\\\ 4(x-1)^{2}+(y-2)^{2} & =16 \\\\ \\frac{(x-1)^{2}}{4}+\\frac{(y-2)^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{4}^{2}} & =1.\\end{aligned}\n$$\n\nNow that the ellipse equation is in the standard form, we can tell that the ellipse is centered at $(1,2).$\n\nAlso, since $4 > 2,$ the length of the semi-major axis is $4$, and the length of the semi-minor axis is $2.$\n\nConsequently, the length of the major axis is $2\\cdot 4 =8$ and the length of the minor axis is $2\\cdot 2 =4.$" :tutorial/id #uuid "fb46eb8f-5131-55b1-baf7-b712d9dd5a71" :tutorial/title "Introduction"} :step/id #uuid "6d1977dd-db9a-5c54-8cae-c4e1cad6611e" :step/next {:db/id #edb/ref 17592186088572}} {:db/id #edb/ref 17592186088572 :step/content {:db/id #edb/ref 17592186087726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087527 :question/id #uuid "853bdfff-d043-58d0-bcb7-f1f5891eb31c" :question/math-academy-id "e-5216" :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $25x^2 + 9y^2 - 100x - 18y = 116.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+9{y}^{2}-100x-18y & =116 \\\\ (25{x}^{2}-100x)+(9{y}^{2}-18y) & =116\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}-100x)+(9{y}^{2}-18y) & =116 \\\\ 25[{x}^{2}-4x]+9[{y}^{2}-2y] & =116 \\\\ 25[(x-2)^{2}-4]+9[(y-1)^{2}-1] & =116 \\\\ 25(x-2)^{2}-100+9(y-1)^{2}-9 & =116\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x-2)^{2}-100+9(y-1)^{2}-9 & =116 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =116+100+9 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =225 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y-1)^{2}}{25} & =1 \\\\ \\frac{(x-2)^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5 > 3,$ the length of the major axis is $2\\cdot 5 =10,$ the length of the minor axis is $2\\cdot 3 =6,$ and the ellipse is centered at $({2},{1}).$"} :knowledge-point/id #uuid "d21d6066-f7c8-5a47-b150-d0ae25d2d60b" :knowledge-point/questions [{:db/id #edb/ref 17592186088331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8182e176-8ad5-5794-9546-e0cab61c87f8" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186086641} {:answer/id #uuid "aaefc3c2-e9a1-5aa2-8d94-df214b700228" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186086642} {:answer/id #uuid "f72004c0-12e4-5d4a-bd59-ab2c611aa6e4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186086643} {:answer/id #uuid "1565f4bf-bc71-5563-9931-6110ae4f8e0e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186086644} {:answer/id #uuid "3fabd35a-c0da-50a3-86ef-91c12db63a34" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186086645}] :answer-field/id #uuid "9bf7bc07-ab47-59a8-a2ab-e45ffaca5f84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086640}] :question/id #uuid "ac4a4a32-6149-5196-bd2f-97e5ca12903b" :question/math-academy-id "q-7636" :question/problem "Consider the ellipse whose equation is $4x^{2} + 9y^{2} - 24x + 18y =-9$. Which of the following statements are true?\n\n1. Its center is $(3,-1)$\n2. The length of the major axis is $9$\n3. The length of the minor axis is $4$"} {:db/id #edb/ref 17592186088332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "994e97b3-6987-5577-a0e4-7d25e6f24c73" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 2)" :db/id #edb/ref 17592186086647} {:answer/id #uuid "bd2b98a3-98fb-5faf-8a5b-84afa2493f71" :answer/type {:db/ident :answer.type/math} :answer/value "(-2, 3)" :db/id #edb/ref 17592186086648} {:answer/id #uuid "e938b01a-9fac-5acd-9d0c-e0d0b80a106e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-4)" :db/id #edb/ref 17592186086649} {:answer/id #uuid "2e255213-b6e4-5ea7-8181-f6176d7b3763" :answer/type {:db/ident :answer.type/math} :answer/value "(-3, 4)" :db/id #edb/ref 17592186086650} {:answer/id #uuid "3ec93fb5-01be-50c0-af25-158e5472ac05" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 1)" :db/id #edb/ref 17592186086651}] :answer-field/id #uuid "2c3b8fc3-0d06-5d00-a824-b467d0fa287c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086646}] :question/id #uuid "e7850063-16ff-5266-9b88-31c8a361bb41" :question/math-academy-id "q-7637" :question/problem "Determine the center of the ellipse whose equation is $2x^{2} + 3y^{2} + 16x - 6y =-11$."} {:db/id #edb/ref 17592186250395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4515f7cd-0daf-58a6-88f8-51f7935b3d5f" :answer/type {:db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186248042} {:answer/id #uuid "757c87dc-8a4a-53b7-80be-5b6a95063d0c" :answer/type {:db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186248457} {:answer/id #uuid "8167c83a-d966-57ab-9b41-7236abdf4e83" :answer/type {:db/ident :answer.type/math} :answer/value "(4,2\\sqrt{3})" :db/id #edb/ref 17592186248569} {:answer/id #uuid "e8bac777-996e-581c-b122-df596f19ccd5" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249480} {:answer/id #uuid "fe2210bd-637b-58a9-b4fb-532ee18e1955" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186249646}] :answer-field/correct {:answer/id #uuid "e8bac777-996e-581c-b122-df596f19ccd5" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186249480} :answer-field/id #uuid "5bbdb522-2627-5194-81bf-57003e4d61da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249836}] :question/id #uuid "0b1c09a8-ecd6-5ac4-aed2-f9a5b10019aa" :question/math-academy-id "q-115314" :question/problem "Determine the center of the ellipse whose equation is $3{x}^{2}+4{y}^{2}+36x+32y=-124.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}3{x}^{2}+4{y}^{2}+36x+32y & =-124 \\\\ (3{x}^{2}+36x)+(4{y}^{2}+32y) & =-124\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(3{x}^{2}+36x)+(4{y}^{2}+32y) & =-124 \\\\ 3[{x}^{2}+12x]+4[{y}^{2}+8y] & =-124 \\\\ 3[(x+6)^{2}-{6}^{2}]+4[(y+4)^{2}-{4}^{2}] & =-124 \\\\ 3[(x+6)^{2}-36]+4[(y+4)^{2}-16] & =-124 \\\\ 3(x+6)^{2}-108+4(y+4)^{2}-64 & =-124\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}3(x+6)^{2}-108+4(y+4)^{2}-64 & =-124 \\\\ 3(x+6)^{2}+4(y+4)^{2} & =-124+108+64 \\\\ 3(x+6)^{2}+4(y+4)^{2} & =48 \\\\ \\frac{(x+6)^{2}}{16}+\\frac{(y+4)^{2}}{12} & =1 \\\\ \\frac{(x+6)^{2}}{{4}^{2}}+\\frac{(y+4)^{2}}{(2\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-6,-4).$"} {:db/id #edb/ref 17592186295105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0c63222-248f-5831-8301-5127b19ff14e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186293811}] :answer-field/correct {:answer/id #uuid "e0c63222-248f-5831-8301-5127b19ff14e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186293811} :answer-field/id #uuid "4f05eec3-7851-5ab5-9730-c5e9ed785d0b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294211} {:answer-field/choices [{:answer/id #uuid "08bd93b3-96d5-5beb-a2f0-fd1e50255e82" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292969}] :answer-field/correct {:answer/id #uuid "08bd93b3-96d5-5beb-a2f0-fd1e50255e82" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292969} :answer-field/id #uuid "ef2de9e4-0284-5f42-be26-6988bddc8406" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294769}] :question/id #uuid "6ff9327d-118b-5b01-ad59-d9df405fddb6" :question/math-academy-id "q-279719" :question/problem "Determine the lengths of the major and minor axes of the ellipse whose equation is $2{x}^{2}+{y}^{2}+12x-4y=-20.$\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is\n{{field-2}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}+12x-4y & =-20 \\\\ (2{x}^{2}+12x)+({y}^{2}-4y) & =-20\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(2{x}^{2}+12x)+({y}^{2}-4y) & =-20 \\\\ 2({x}^{2}+6x)+({y}^{2}-4y) & =-20 \\\\ 2[(x+3)^{2}-9]+[(y-2)^{2}-4] & =-20 \\\\ 2(x+3)^{2}-18+(y-2)^{2}-4 & =-20\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}2(x+3)^{2}-18+(y-2)^{2}-4 & =-20 \\\\ 2(x+3)^{2}+(y-2)^{2} & =-20+18+4 \\\\ 2(x+3)^{2}+(y-2)^{2} & =2 \\\\ \\frac{(x+3)^{2}}{1}+\\frac{(y-2)^{2}}{2} & =1 \\\\ \\frac{(x+3)^{2}}{{1}^{2}}+\\frac{(y-2)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nSince $\\sqrt{2}>1,$ the length of the major axis  $=2\\cdot \\sqrt{2}=2\\sqrt{2},$ and the length of the minor axis  $=2\\cdot 1=2.$"} {:db/id #edb/ref 17592186295106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd41b81c-81c3-5a26-a382-028fa2bcd639" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293922}] :answer-field/correct {:answer/id #uuid "fd41b81c-81c3-5a26-a382-028fa2bcd639" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293922} :answer-field/id #uuid "277aaa24-d379-5c86-8180-82d9800eed7b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294054} {:answer-field/choices [{:answer/id #uuid "73168334-b144-5f6f-b43a-b42e59e682ab" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293404}] :answer-field/correct {:answer/id #uuid "73168334-b144-5f6f-b43a-b42e59e682ab" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293404} :answer-field/id #uuid "c7e7e9d0-8105-5d07-905e-5d02a8fb84e6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294637}] :question/id #uuid "7b32fe41-7b78-5c91-bbe4-31adfa7b2b86" :question/math-academy-id "q-279720" :question/problem "Determine the lengths of the major and minor axes of the ellipse whose equation is $4{x}^{2}+9{y}^{2}-16x+18y=119.$\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is\n{{field-2}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2}-16x+18y & =119 \\\\ (4{x}^{2}-16x)+(9{y}^{2}+18y) & =119\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-16x)+(9{y}^{2}+18y) & =119 \\\\ 4({x}^{2}-4x)+9({y}^{2}+2y) & =119 \\\\ 4[(x-2)^{2}-4]+9[(y+1)^{2}-1] & =119 \\\\ 4(x-2)^{2}-16+9(y+1)^{2}-9 & =119\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-2)^{2}-16+9(y+1)^{2}-9 & =119 \\\\ 4(x-2)^{2}+9(y+1)^{2} & =119+16+9 \\\\ 4(x-2)^{2}+9(y+1)^{2} & =144 \\\\ \\frac{(x-2)^{2}}{36}+\\frac{(y+1)^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{{6}^{2}}+\\frac{(y+1)^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nSince $6>4,$ the length of the major axis  $=2\\cdot 6=12,$ and the length of the minor axis  $=2\\cdot 4=8.$"} {:db/id #edb/ref 17592186341888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fc4000-62ff-5182-a26a-035ae1251347" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186339358} {:answer/id #uuid "51691912-8755-5a07-a647-6d28e2647dcb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186339876} {:answer/id #uuid "9a581d22-8c34-545c-94dd-3cde512dcecf" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186340518} {:answer/id #uuid "9f32f3aa-b253-5617-8207-b6a5223e98c7" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186340565} {:answer/id #uuid "ce4d8a99-ac46-5b03-ae49-5545a012f93e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186340962}] :answer-field/correct {:answer/id #uuid "19fc4000-62ff-5182-a26a-035ae1251347" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186339358} :answer-field/id #uuid "166efa29-bcb7-5568-883b-86db967a44a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341420}] :question/id #uuid "6f0d0009-b766-5be4-a470-30d32f4056c3" :question/math-academy-id "q-72939" :question/problem "Determine the center of the ellipse whose equation is $5{x}^{2}+2{y}^{2}+20x-12y=-28.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+2{y}^{2}+20x-12y & =-28 \\\\ (5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28 \\\\ 5({x}^{2}+4x)+2({y}^{2}-6y) & =-28 \\\\ 5[(x+2)^{2}-4]+2[(y-3)^{2}-9] & =-28 \\\\ 5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =-28+20+18 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =10 \\\\ \\frac{(x+2)^{2}}{2}+\\frac{(y-3)^{2}}{5} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-2,3).$"} {:db/id #edb/ref 17592186345205 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3adfcb62-7ac7-590b-be06-2e8243f4dc65" :answer/type {:db/ident :answer.type/math} :answer/value "(2,4)" :db/id #edb/ref 17592186342720} {:answer/id #uuid "4ad1531f-e1cf-5ebe-ad81-a38e2a113f1f" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186342853} {:answer/id #uuid "6f8cbcdc-3ebb-5a0c-ab73-51b9ffaf200d" :answer/type {:db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186343197} {:answer/id #uuid "7e843273-2386-57fa-b165-5aee9ac338af" :answer/type {:db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186343328} {:answer/id #uuid "f2d228be-5c04-5444-b3a0-25193a937280" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186344371}] :answer-field/correct {:answer/id #uuid "f2d228be-5c04-5444-b3a0-25193a937280" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186344371} :answer-field/id #uuid "ab2f6a43-fe63-5c02-bab3-608eea1fae56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344793}] :question/id #uuid "b972a86c-4480-5828-a8e2-d62f9765dca2" :question/math-academy-id "q-7632" :question/problem "Determine the center of the ellipse whose equation is $5{x}^{2}+9{y}^{2}-10x-36y=4.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+9{y}^{2}-10x-36y & =4 \\\\ (5{x}^{2}-10x)+(9{y}^{2}-36y) & =4\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}-10x)+(9{y}^{2}-36y) & =4 \\\\ 5[{x}^{2}-2x]+9[{y}^{2}-4y] & =4 \\\\ 5[(x-1)^{2}-{1}^{2}]+9[(y-2)^{2}-{2}^{2}] & =4 \\\\ 5[(x-1)^{2}-1]+9[(y-2)^{2}-4] & =4 \\\\ 5(x-1)^{2}-5+9(y-2)^{2}-36 & =4\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x-1)^{2}-5+9(y-2)^{2}-36 & =4 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =4+5+36 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =45 \\\\ \\frac{(x-1)^{2}}{9}+\\frac{(y-2)^{2}}{5} & =1 \\\\ \\frac{(x-1)^{2}}{{3}^{2}}+\\frac{(y-2)^{2}}{(\\sqrt{5})^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(1,2).$"} {:db/id #edb/ref 17592186396134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf85bac6-b89d-5c73-adb5-4938e4b8f922" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471519} {:answer/id #uuid "4e5a20bb-c60f-5338-87c9-e2490e64f006" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471520}] :answer-field/correct {:answer/id #uuid "4e5a20bb-c60f-5338-87c9-e2490e64f006" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471520} :answer-field/id #uuid "2c23e7a2-a53b-5060-bbaf-9b3bfe5e7a0f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472265} {:answer-field/choices [{:answer/id #uuid "e3b974d4-3fd9-51e3-bc6c-5f28cf8e13fb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471521} {:answer/id #uuid "ece7e85c-4f4f-5b66-afe1-c4c1f94870d9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471522}] :answer-field/correct {:answer/id #uuid "e3b974d4-3fd9-51e3-bc6c-5f28cf8e13fb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471521} :answer-field/id #uuid "844f18a7-507e-59d5-b3d2-aaaf4e9e2971" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472266} {:answer-field/choices [{:answer/id #uuid "37ef67bd-4095-53fe-94d3-afa4b2bac162" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471523} {:answer/id #uuid "98e15137-ba00-5798-bf72-ba42aba63f83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471524}] :answer-field/correct {:answer/id #uuid "98e15137-ba00-5798-bf72-ba42aba63f83" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471524} :answer-field/id #uuid "fdc3abea-1ce4-58a0-a0ef-8401134def94" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472267}] :question/id #uuid "fd2cdae2-5e26-5778-ab7e-65d79d794e32" :question/math-academy-id "q-7639" :question/problem "Consider the ellipse whose equation is ${x}^{2}+2{y}^{2}-2x+12y=-11.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(1,-3)$\n- **II.** The length of the major axis  is $2\\sqrt{2}$\n- **III.** The length of the minor axis is $4$" :question/worked-solution "First, we must group the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+2{y}^{2}-2x+12y & =-11 \\\\ ({x}^{2}-2x)+(2{y}^{2}+12y) & =-11\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-2x)+(2{y}^{2}+12y) & =-11 \\\\ [{x}^{2}-2x]+2[{y}^{2}+6y] & =-11 \\\\ [(x-1)^{2}-{1}^{2}]+2[(y+3)^{2}-{3}^{2}] & =-11 \\\\ [(x-1)^{2}-1]+2[(y+3)^{2}-9] & =-11 \\\\ (x-1)^{2}-1+2(y+3)^{2}-18 & =-11\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-1)^{2}-1+2(y+3)^{2}-18 & =-11 \\\\ (x-1)^{2}+2(y+3)^{2} & =-11+1+18 \\\\ (x-1)^{2}+2(y+3)^{2} & =8 \\\\ \\frac{(x-1)^{2}}{8}+\\frac{(y+3)^{2}}{4} & =1 \\\\ \\frac{(x-1)^{2}}{(2\\sqrt{2})^{2}}+\\frac{(y+3)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nSince $2\\sqrt{2}>2,$ the length of the major axis is $2\\cdot 2\\sqrt{2}=4\\sqrt{2},$ the length of the minor axis is $2\\cdot 2=4,$ and the ellipse is centered at $(1,-3).$\n\nTherefore,  I and III are true, and II is false."} {:db/id #edb/ref 17592186403606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c381e28-47d1-516c-ba70-7941c1b4c573" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $1$" :db/id #edb/ref 17592186403608} {:answer/id #uuid "c7ab0ed2-8c80-5ee7-ad45-3c43ece3b795" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186403609} {:answer/id #uuid "e0ac736d-0463-57d0-9db1-2a7177ddc558" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186403610} {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} {:answer/id #uuid "cfd845e5-ca89-50e3-8d11-42ad65bcd599" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186403612}] :answer-field/correct {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} :answer-field/id #uuid "66032e6a-59fa-5bca-a1f1-2d6e69a901e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403607}] :question/id #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" :question/math-academy-id "q-72934" :question/problem "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$"}] :knowledge-point/title "Determining the Center and Axis Lengths Given an Inhomogeneous Polynomial Equation of an Ellipse"} :step/id #uuid "2db45159-e127-58ff-acd3-c37d53967454" :step/next {:db/id #edb/ref 17592186088573}} {:db/id #edb/ref 17592186088573 :step/content {:db/id #edb/ref 17592186087727 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087528 :question/id #uuid "0b3df81e-03a7-5cf2-b815-f999012b9b2b" :question/math-academy-id "e-5217" :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $x^2 + 4y^2 - 6x + 24y + 41 = 0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-6x+24y+41 & =0 \\\\ ({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0 \\\\ ({x}^{2}-6x)+4[{y}^{2}+6y]+41 & =0 \\\\ (x-3)^{2}-9+4[(y+3)^{2}-9]+41 & =0 \\\\ (x-3)^{2}-9+4(y+3)^{2}-36+41 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-3)^{2}-9+4(y+3)^{2}-36+41 & =0 \\\\ (x-3)^{2}+4(y+3)^{2} & =9+36-41 \\\\ (x-3)^{2}+4(y+3)^{2} & =4 \\\\ \\frac{(x-3)^{2}}{4}+\\frac{(y+3)^{2}}{1} & =1 \\\\ \\frac{(x-3)^{2}}{{2}^{2}}+\\frac{(y+3)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2 > 1,$ the length of the major axis is $2\\cdot 2 =4,$ the length of the minor axis is $2\\cdot 1 =2,$ and the ellipse is centered at $({3},{-3}).$"} :knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632" :knowledge-point/questions [{:db/id #edb/ref 17592186088042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34f54f0-2fdb-55b5-8145-9bf8acbf153a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186084987} {:answer/id #uuid "c167508c-7437-5c27-a702-0d58b4594b4b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186084988} {:answer/id #uuid "07f83f05-a5c0-581b-99c5-d70b77414bfb" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186084989} {:answer/id #uuid "1428c4ef-8686-5bc8-9eaf-1a2b0b5c467a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186084990} {:answer/id #uuid "34a00d43-cc72-59d6-ada0-8d7e195f8988" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186084991}] :answer-field/id #uuid "88e37366-9342-5897-89d4-43dd038e71fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084986}] :question/id #uuid "315f7358-7df9-5bd5-9f06-5181f55727ff" :question/math-academy-id "q-16563" :question/problem "Consider the ellipse whose equation is $2x^{2} + 9y^{2} + 16x - 90y + 239 = 0$. Which of the following statements are true?\n\n1. Its center is $(-4, 5)$\n2. The length of the major axis is $4$\n3. The length of the minor axis is $2\\sqrt{3}$"} {:db/id #edb/ref 17592186088043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ab3be2-8f62-572a-9d93-75e373713004" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186084993} {:answer/id #uuid "94182ccf-2b8c-5af3-892b-2a61c090176c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186084994} {:answer/id #uuid "951c98a0-9585-589d-af84-c88586b6d078" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186084995} {:answer/id #uuid "fb38f930-d289-5ab6-8c41-509ed6e8afee" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186084996} {:answer/id #uuid "43fc5d49-c3f8-5ba9-98fe-fc80105c8aaa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186084997}] :answer-field/id #uuid "aa885b7b-141d-52d3-9388-0b997c1fa872" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084992}] :question/id #uuid "78cc6970-10a3-519b-8c8a-18166d49b3ac" :question/math-academy-id "q-16564" :question/problem "Determine the length of the major axis of the ellipse whose equation is $5x^{2} + y^{2} - 30x + 40 = 0$."} {:db/id #edb/ref 17592186250396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e63bcb-4809-51fe-b6c3-080655bfb0b7" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186247631} {:answer/id #uuid "1e81b794-7465-53a2-acbb-2122b17253fa" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186247695} {:answer/id #uuid "59fa202e-084a-55c9-a1dc-46370c43eb22" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186248237} {:answer/id #uuid "796f9264-e95b-5e12-81a1-7df990f9e532" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186248492} {:answer/id #uuid "cf6413e1-a185-5cc6-aceb-d217706e77b7" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186249265}] :answer-field/correct {:answer/id #uuid "1e81b794-7465-53a2-acbb-2122b17253fa" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1)" :db/id #edb/ref 17592186247695} :answer-field/id #uuid "f3d5845f-a611-5650-94c4-385364233a0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250100}] :question/id #uuid "abf43efd-2730-5511-9044-94688958afd8" :question/math-academy-id "q-115316" :question/problem "Determine the center of the ellipse whose equation is\n$2{x}^{2}+{y}^{2}+16x-2y+29=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}+16x-2y+29 & =0 \\\\ (2{x}^{2}+16x)+({y}^{2}-2y)+29 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(2{x}^{2}+16x)+({y}^{2}-2y)+29 & =0 \\\\ 2[{x}^{2}+8x]+[{y}^{2}-2y]+29 & =0 \\\\ 2[(x+4)^{2}-{4}^{2}]+[(y-1)^{2}-{1}^{2}]+29 & =0 \\\\ 2[(x+4)^{2}-16]+[(y-1)^{2}-1]+29 & =0 \\\\ 2(x+4)^{2}-32+(y-1)^{2}-1+29 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}2(x+4)^{2}-32+(y-1)^{2}-1+29 & =0 \\\\ 2(x+4)^{2}+(y-1)^{2} & =32+1-29 \\\\ 2(x+4)^{2}+(y-1)^{2} & =4 \\\\ \\frac{(x+4)^{2}}{2}+\\frac{(y-1)^{2}}{4} & =1 \\\\ \\frac{(x+4)^{2}}{(\\sqrt{2})^{2}}+\\frac{(y-1)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-4,1).$"} {:db/id #edb/ref 17592186284557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0df234-c3b6-5275-bb55-70afecc12dcd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282318} {:answer/id #uuid "73e8f492-0bf9-55fe-8d92-a94b65a8a1bf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186282679} {:answer/id #uuid "852acf03-ef6d-5d5a-93f1-5a863b5cd35f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282838} {:answer/id #uuid "ae906ad3-e496-5dba-89a5-dc17369dcfbe" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186283198} {:answer/id #uuid "ccd6b550-eb59-5d55-bc61-e0518c41c707" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186283479}] :answer-field/correct {:answer/id #uuid "4a0df234-c3b6-5275-bb55-70afecc12dcd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282318} :answer-field/id #uuid "62372821-ae81-53cd-908a-823dfcb9b5ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284096}] :question/id #uuid "5ed2b043-750a-5637-b0ae-a564424a079c" :question/math-academy-id "q-16561" :question/problem "Determine the length of the minor axis of the ellipse whose equation is  $25{x}^{2}+4{y}^{2}+100x–40y+100=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+4{y}^{2}+100x–40y+100 & =0 \\\\ (25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0 \\\\ 25[{x}^{2}+4x]+4[{y}^{2}-10y]+100 & =0 \\\\ 25[(x+2)^{2}-{2}^{2}]+4[(y-5)^{2}-{5}^{2}]+100 & =0 \\\\ 25[(x+2)^{2}-4]+4[(y-5)^{2}-25]+100 & =0 \\\\ 25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =-100+100+100 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =100 \\\\ \\frac{(x+2)^{2}}{4}+\\frac{(y-5)^{2}}{25} & =1 \\\\ \\frac{(x+2)^{2}}{{2}^{2}}+\\frac{(y-5)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>2,$ the length of the minor axis is $2\\cdot 2=4.$"} {:db/id #edb/ref 17592186284558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345441f2-5087-5b4b-a170-90bd9b45c571" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450084} {:answer/id #uuid "6254eb3a-73c1-5ab0-ad43-6689f0121fa7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450085}] :answer-field/correct {:answer/id #uuid "6254eb3a-73c1-5ab0-ad43-6689f0121fa7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450085} :answer-field/id #uuid "ade2cdd4-1d37-5b7e-95ec-f1c1d23d5682" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450996} {:answer-field/choices [{:answer/id #uuid "39dcc466-ba2e-5602-ad92-d2b70dc0ca1e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450086} {:answer/id #uuid "eef8513c-faf1-5a9c-bdee-f872e4aea8ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450087}] :answer-field/correct {:answer/id #uuid "39dcc466-ba2e-5602-ad92-d2b70dc0ca1e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450086} :answer-field/id #uuid "25be7e84-c62f-5a39-8971-0aa1b7350b97" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450997} {:answer-field/choices [{:answer/id #uuid "d6047f0f-3255-59c4-8ede-45caac330c15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450088} {:answer/id #uuid "8e1502e5-81a3-537f-95d3-b3d0727811dc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450089}] :answer-field/correct {:answer/id #uuid "d6047f0f-3255-59c4-8ede-45caac330c15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450088} :answer-field/id #uuid "3c2d7ce5-553e-5e2f-a362-c4933f79bc92" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450998}] :question/id #uuid "0602fa5a-d2db-5bf8-9142-ab8253a6eb55" :question/math-academy-id "q-16562" :question/problem "Consider the ellipse whose equation is $4{x}^{2}+9{y}^{2}–48x+72y+144=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(6,-4)$\n- **II.** The length of the major axis is $6$\n- **III.** The length of the minor axis is $4$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2}–48x+72y+144 & =0 \\\\ (4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0 \\\\ 4[{x}^{2}-12x]+9[{y}^{2}+8y]+144 & =0 \\\\ 4[(x-6)^{2}-{6}^{2}]+9[(y+4)^{2}-{4}^{2}]+144 & =0 \\\\ 4[(x-6)^{2}-36]+9[(y+4)^{2}-16]+144 & =0 \\\\ 4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =-144+144+144 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =144 \\\\ \\frac{(x-6)^{2}}{36}+\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{(x-6)^{2}}{{6}^{2}}+\\frac{(y+4)^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nSince $6>4,$ the length of the major axis is $2\\cdot 6=12,$ the length of the minor axis is $2\\cdot 4=8,$ and the ellipse is centered at $(6,-4).$\n\nTherefore, statement I is true, statements II and III are false."} {:db/id #edb/ref 17592186284559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22961d8f-86d9-5ab2-b42e-0012e783a23f" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186281993} {:answer/id #uuid "2b13c0a9-a51b-523a-9ce4-3254dce6faef" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186282067} {:answer/id #uuid "8666c22c-5eb3-5056-869a-853adc498f85" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282848} {:answer/id #uuid "959b5fee-bb15-5499-82bb-5faf30029096" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282980} {:answer/id #uuid "9c88853b-9cd6-530a-ad8a-4bf8ba0d8592" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186283053}] :answer-field/correct {:answer/id #uuid "2b13c0a9-a51b-523a-9ce4-3254dce6faef" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186282067} :answer-field/id #uuid "2871ec54-332b-5cf4-8084-1f8c2e08bc69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284007}] :question/id #uuid "beb4f1e9-9ce4-5e8f-a547-7adfbf588a59" :question/math-academy-id "q-16565" :question/problem "Determine the length of the major axis of the ellipse whose equation is ${x}^{2}+4{y}^{2}+10x-16y+25=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}+10x-16y+25 & =0 \\\\ ({x}^{2}+10x)+(4{y}^{2}-16y)+25 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}+10x)+(4{y}^{2}-16y)+25 & =0 \\\\ [{x}^{2}+10x]+4[{y}^{2}-4y]+25 & =0 \\\\ [(x+5)^{2}-{5}^{2}]+4[(y-2)^{2}-{2}^{2}]+25 & =0 \\\\ [(x+5)^{2}-25]+4[(y-2)^{2}-4]+25 & =0 \\\\ (x+5)^{2}-25+4(y-2)^{2}-16+25 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x+5)^{2}-25+4(y-2)^{2}-16+25 & =0 \\\\ (x+5)^{2}+4(y-2)^{2} & =25-25+16 \\\\ (x+5)^{2}+4(y-2)^{2} & =16 \\\\ \\frac{(x+5)^{2}}{16}+\\frac{(y-2)^{2}}{4} & =1 \\\\ \\frac{(x+5)^{2}}{{4}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nSince $4>2,$ the length of the major axis is $2\\cdot 4=8.$"} {:db/id #edb/ref 17592186284560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "114aae92-2225-5183-80c7-9284961bdf5a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186281851} {:answer/id #uuid "7b8c3cc2-16f9-5565-9b9b-8a3c610ae938" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186282751} {:answer/id #uuid "94fc378f-de20-59b5-94e6-4c86acf68439" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186282974} {:answer/id #uuid "9ed6d53e-2324-5aa2-9689-a46b0d2dffc6" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186283072} {:answer/id #uuid "e4883d76-b503-580f-a5ea-9d23fd77d194" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186283681}] :answer-field/correct {:answer/id #uuid "94fc378f-de20-59b5-94e6-4c86acf68439" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186282974} :answer-field/id #uuid "191f7906-e711-5a73-a603-018d1e87a170" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283985}] :question/id #uuid "59b2b2f3-1020-59f6-8e6c-939fc6a04444" :question/math-academy-id "q-16566" :question/problem "Determine the center of the ellipse whose equation is\n$4{x}^{2}+{y}^{2}-16x+2y+13=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-16x+2y+13 & =0 \\\\ (4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0 \\\\ 4[{x}^{2}-4x]+[{y}^{2}+2y]+13 & =0 \\\\ 4[(x-2)^{2}-{2}^{2}]+[(y+1)^{2}-{(1)}^{2}]+13 & =0 \\\\ 4[(x-2)^{2}-4]+[(y+1)^{2}-1]+13 & =0 \\\\ 4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0 \\\\ 4(x-2)^{2}+(y+1)^{2} & =-13+1+16 \\\\ 4(x-2)^{2}+(y+1)^{2} & =4 \\\\ (x-2)^{2}+\\frac{(y+1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{{1}^{2}}+\\frac{(y+1)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(2,-1).$"} {:db/id #edb/ref 17592186284566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2957afb5-8dcc-5a3c-be47-05cd7087772b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450090} {:answer/id #uuid "fa300c46-2e42-5e26-904d-c234a85fedd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450091}] :answer-field/correct {:answer/id #uuid "fa300c46-2e42-5e26-904d-c234a85fedd2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450091} :answer-field/id #uuid "88ebc973-6cfc-5de6-929b-112f67a157b8" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450999} {:answer-field/choices [{:answer/id #uuid "7be024a6-037e-5a9c-8731-7ee43c421778" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450092} {:answer/id #uuid "4da959f1-cca3-58ea-9511-04f4035a7d01" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450093}] :answer-field/correct {:answer/id #uuid "7be024a6-037e-5a9c-8731-7ee43c421778" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450092} :answer-field/id #uuid "199799b9-038e-5a89-b4fd-5681ab30823f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451000} {:answer-field/choices [{:answer/id #uuid "bfa900cf-a600-5125-b96f-9228d0ef5991" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450094} {:answer/id #uuid "ece15639-1727-5187-966a-fffa729d12cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450095}] :answer-field/correct {:answer/id #uuid "ece15639-1727-5187-966a-fffa729d12cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450095} :answer-field/id #uuid "21f5c4b2-643a-5f2f-b14b-8553d388fa54" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451001}] :question/id #uuid "f98a559b-0a7a-50c5-b65c-b026bdee915b" :question/math-academy-id "q-16639" :question/problem "Consider the ellipse whose equation is $3{x}^{2}+{y}^{2}-9=0.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Its center is $(0,0)$\n- **II.** The length of the major axis is $3$\n- **III.** The length of the minor axis is $2\\sqrt{3}$" :question/worked-solution "We rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}3{x}^{2}+{y}^{2}-9 & =0 \\\\ 3{x}^{2}+{y}^{2} & =9 \\\\ \\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{9} & =1 \\\\ \\frac{(x-0)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y-0)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $3>\\sqrt{3},$ the length of the major axis is $2\\cdot 3=6,$ the length of the minor axis is $2\\cdot \\sqrt{3}=2\\sqrt{3},$ and the ellipse is centered at $(0,0).$\n\nTherefore, statements I and III are true, statement II is false."} {:db/id #edb/ref 17592186295107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f3b54e5-b23e-55b9-beae-25109bf3750d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293489}] :answer-field/correct {:answer/id #uuid "8f3b54e5-b23e-55b9-beae-25109bf3750d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293489} :answer-field/id #uuid "b94af748-45f7-5779-8621-3828bbb38ba4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294590} {:answer-field/choices [{:answer/id #uuid "ca38808e-4a06-547d-9aba-c6ce5d923c23" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293716}] :answer-field/correct {:answer/id #uuid "ca38808e-4a06-547d-9aba-c6ce5d923c23" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293716} :answer-field/id #uuid "db3e1c00-e6cb-5449-9c66-f279f8559bdb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294701}] :question/id #uuid "6e1be62d-fda7-56ea-99d2-1ed30bff13cb" :question/math-academy-id "q-279724" :question/problem "The center of the ellipse $6{x}^{2}+5{y}^{2}-36x+50y-1=0$ is located at the point$\\,($\n{{field-1}},\n{{field-2}}$).$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}+5{y}^{2}-36x+50y-1 & =0 \\\\ (6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0 \\\\ 6[{x}^{2}-6x]+5[{y}^{2}+10y]-1 & =0 \\\\ 6[(x-3)^{2}-{3}^{2}]+5[(y+5)^{2}-{5}^{2}]-1 & =0 \\\\ 6[(x-3)^{2}-9]+5[(y+5)^{2}-25]-1 & =0 \\\\ 6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =1+54+125 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =180 \\\\ \\frac{(x-3)^{2}}{30}+\\frac{(y+5)^{2}}{36} & =1 \\\\ \\frac{(x-3)^{2}}{(\\sqrt{30})^{2}}+\\frac{(y+5)^{2}}{{6}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(3,-5).$"} {:db/id #edb/ref 17592186295108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99574deb-0466-5daa-8347-3da8ad7f3e67" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293537}] :answer-field/correct {:answer/id #uuid "99574deb-0466-5daa-8347-3da8ad7f3e67" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293537} :answer-field/id #uuid "776bdf59-0955-54fd-8f41-2a83cb7fb1dc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294355}] :question/id #uuid "de7e4604-2681-5fe9-a457-e4de26ceb8bc" :question/math-academy-id "q-279726" :question/problem "For the ellipse $9{x}^{2}+25{y}^{2}+72x-100y+19=0$, the length of the major axis is{{field-1}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}9{x}^{2}+25{y}^{2}+72x-100y+19 & =0 \\\\ (9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0 \\\\ 9[{x}^{2}+8x]+25[{y}^{2}-4y]+19 & =0 \\\\ 9[(x+4)^{2}-{4}^{2}]+25[(y-2)^{2}-{2}^{2}]+19 & =0 \\\\ 9[(x+4)^{2}-16]+25[(y-2)^{2}-4]+19 & =0 \\\\ 9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =-19+100+144 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =225 \\\\ \\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(x+4)^{2}}{{5}^{2}}+\\frac{(y-2)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>3,$ the length of the major axis is $2\\cdot 5=10.$"}] :knowledge-point/title "Determining the Center and Axis Lengths Given a Homogeneous Polynomial Equation of an Ellipse"} :step/id #uuid "ce827559-c630-59e2-a66b-b7e70bfee088"}] :activity/title "Finding the Center and Axes of Ellipses by Completing the Square" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087923}] [{:db/id #edb/ref 17592186049966 :topic/id #uuid "22407020-2e16-5478-893b-c97ed51a3ea0" :topic/knowledge-points [{:db/id #edb/ref 17592186166780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166618 :question/id #uuid "56125c27-b034-5450-a01c-cd22347da6b0" :question/math-academy-id "e-8401" :question/problem "${\\displaystyle \\int \\dfrac{\\textrm{d}x}{\\sqrt{x^2-2x+2}} =}$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned} x^2-2x+2 & = x^2 - 2\\cdot x +1^2 - 1^2 + 2 \\\\[3pt] &= (x-1)^2 -1+2 \\\\[3pt] &= (x-1)^2 + 1 \\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{\\textrm{d}x}{\\sqrt{x^2-2x+2}} = \\int \\dfrac{\\textrm{d}x}{\\sqrt {(x-1)^2 + 1}}\n$$\n\nLet $u = x-1$. Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int\\frac{dx}{\\sqrt{x^{2} - 2x + 2}} &= \\int(dx)/(\\sqrt{(x - 1)^{2} + 1}) \\\\\n&= \\int\\frac{du}{\\sqrt{u^{2} + 1}} \\\\\n&= arsinh u + C \\\\\n&= arsinh (x - 1) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "fc9e3257-b8de-5a0c-8900-8017a344471e" :knowledge-point/questions [{:db/id #edb/ref 17592186167372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "992f308c-3081-51db-8cb6-cf684d229be4" :answer/type {:db/ident :answer.type/math} :answer/value "2arsinh (x + 2) + C" :db/id #edb/ref 17592186165441} {:answer/id #uuid "c27e6a75-b4d2-5d7f-b783-b6bde65b51cf" :answer/type {:db/ident :answer.type/math} :answer/value "2arcosh (x + 2) + C" :db/id #edb/ref 17592186165442} {:answer/id #uuid "1e4f0e1c-6126-5a6e-80c5-6267aa877c6f" :answer/type {:db/ident :answer.type/math} :answer/value "2arcosh (x + 1) + C" :db/id #edb/ref 17592186165443} {:answer/id #uuid "475bdba4-4b2a-5620-92d4-b3fe33c18adf" :answer/type {:db/ident :answer.type/math} :answer/value "2arsinh (x + 1) + C" :db/id #edb/ref 17592186165444} {:answer/id #uuid "52d2d728-9723-5b43-a703-3f2c40468685" :answer/type {:db/ident :answer.type/math} :answer/value "4arsinh (x + 1) + C" :db/id #edb/ref 17592186165445}] :answer-field/id #uuid "4435da9c-5a82-5a22-9e1c-5d9436e11300" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165440}] :question/id #uuid "e5477f2d-0e1b-5ead-bfa0-b5d05ca8088a" :question/math-academy-id "q-95464" :question/problem "What is $\\displaystyle \\int\\frac{2}{\\sqrt{x^{2} + 4x + 5}}dx$?"} {:db/id #edb/ref 17592186167447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01827a4b-f2fe-54dc-88a4-5990d389839c" :answer/type {:db/ident :answer.type/math} :answer/value "arcosh (\\frac{x - 2}{3}) + C" :db/id #edb/ref 17592186165891} {:answer/id #uuid "4a5eab12-c87e-5716-98b2-b60b38647e56" :answer/type {:db/ident :answer.type/math} :answer/value "arsinh (\\frac{x - 2}{3}) + C" :db/id #edb/ref 17592186165892} {:answer/id #uuid "6911028f-3e31-5d95-bd70-a4534b9c4bd0" :answer/type {:db/ident :answer.type/math} :answer/value "arsinh (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186165893} {:answer/id #uuid "75c07914-0def-5ca3-86b6-1c5483173a9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x - 3) + C" :db/id #edb/ref 17592186165894} {:answer/id #uuid "76155b74-9248-564c-93ab-95f88e661f34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arsinh (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186165895}] :answer-field/id #uuid "ffed0f57-4e4a-5c68-a3ab-f2aaab09b53d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165890}] :question/id #uuid "2b704f88-3434-51ec-979f-0b294315821f" :question/math-academy-id "q-96062" :question/problem "What is $\\displaystyle \\int\\frac{dx}{\\sqrt{x^{2} - 6x + 13}}$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arcsine Integral"} {:db/id #edb/ref 17592186166781 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166619 :question/id #uuid "89aeeda2-86ec-5ed2-9ae2-ad68f1b1c599" :question/math-academy-id "e-8402" :question/problem "${\\displaystyle \\int \\dfrac{2}{\\sqrt{x^2-4x+3}} \\textrm{d}x=}$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}\nx^{2} - 4x + 3 &= x^{2} - 2 \\cdot 2x + 2^{2} - 2^{2} + 3 \\\\\n&= (x - 2)^{2} - 1\n\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{2}{\\sqrt{x^2-4x+3}} \\textrm{d}x = \\int \\dfrac{2}{\\sqrt {(x-2)^2-1}} \\, \\textrm{d}x\n$$\n\nLet $u = x-2$. Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int\\frac{2}{\\sqrt{x^{2} - 4x + 3}}dx &= \\int(2)/(\\sqrt{(x - 2)^{2} - 1})dx \\\\\n&= 2\\int\\frac{1}{\\sqrt{u^{2} - 1}}du \\\\\n&= 2arcosh u + C \\\\\n&= 2arcosh (x - 2) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "cdf9d07c-b687-5b71-a4a1-3652d6fb9b2b" :knowledge-point/questions [{:db/id #edb/ref 17592186167374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb8d3fbd-2a5e-5dcf-8568-b95086e80d44" :answer/type {:db/ident :answer.type/math} :answer/value "5arcosh (x - 3) + C" :db/id #edb/ref 17592186165453} {:answer/id #uuid "fbf5e2f3-686b-584e-80cd-f94ae72bd2a7" :answer/type {:db/ident :answer.type/math} :answer/value "10arcosh (x - 6) + C" :db/id #edb/ref 17592186165454} {:answer/id #uuid "312ba2b0-9677-504c-9b3b-9df476dece8e" :answer/type {:db/ident :answer.type/math} :answer/value "arcosh (x - 2) + C" :db/id #edb/ref 17592186165455} {:answer/id #uuid "4af0163a-9663-530e-8d13-d430ef4f90e4" :answer/type {:db/ident :answer.type/math} :answer/value "3arcosh (x - 1) + C" :db/id #edb/ref 17592186165456} {:answer/id #uuid "53d1a3ad-e621-51b7-a1f6-0d5f25fec5bf" :answer/type {:db/ident :answer.type/math} :answer/value "5arcosh (x - 5) + C" :db/id #edb/ref 17592186165457}] :answer-field/id #uuid "98998d08-0cea-5960-8a0a-216339b2b22b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165452}] :question/id #uuid "53ede172-40e4-5f6b-bbef-37f586494ddf" :question/math-academy-id "q-95466" :question/problem "What is $\\displaystyle \\int\\frac{5}{\\sqrt{x^{2} - 6x + 8}}dx$?"} {:db/id #edb/ref 17592186167449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a227af-607e-53ea-8911-93693c9a9332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 2) + C" :db/id #edb/ref 17592186165903} {:answer/id #uuid "b0a0bcb9-2370-5f20-9d72-5f97f954ea7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 1) + C" :db/id #edb/ref 17592186165904} {:answer/id #uuid "f969625f-f618-51f0-bd71-da25f2733fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 4) + C" :db/id #edb/ref 17592186165905} {:answer/id #uuid "15640745-6eb2-54e8-b51f-fa4e642c33c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x + 1) + C" :db/id #edb/ref 17592186165906} {:answer/id #uuid "51ff08d4-f7fa-5a73-bfbe-0f38b8cef599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x + 2) + C" :db/id #edb/ref 17592186165907}] :answer-field/id #uuid "a43a6e18-af92-5f0c-949b-94c1d28904aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165902}] :question/id #uuid "de65eabb-3c40-5992-a0bf-042d4963fdb2" :question/math-academy-id "q-96082" :question/problem "What is $\\displaystyle \\int\\frac{dx}{\\sqrt{16x^{2} + 32x}}$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arccosine Integral"} {:db/id #edb/ref 17592186166782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166620 :question/id #uuid "23d714d4-1c4c-5228-9d9d-303c6011d4a4" :question/math-academy-id "e-8403" :question/problem "$\\displaystyle \\int \\dfrac{1}{4x-x^2} \\textrm{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned} 4x-x^2 & = -(x^2 - 4x) \\\\[5pt] & = -(x^2 - 2\\cdot 2x + 2^2-2^2) \\\\[5pt] & = -((x-2)^2 - 4) \\\\[5pt] &= 4 - (x-2)^2 \\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\dfrac{1}{4x-x^2}\\textrm{d}x = \\int \\dfrac{1}{4-(x-2)^2}\\textrm{d}x = \\dfrac{1}{4} {\\int}\\dfrac{1}{1 - \\left(\\frac{1}{2}(x-2)\\right)^2}\\textrm{d}x\n$$\n\nLet\n\n$$\nu = \\dfrac{1}{2}(x-2)\n$$\n\nThen, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{2} \\quad\\Longrightarrow\\quad \\textrm{d}x = 2\\,\\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\frac{1}{4}\\int(1)/(1 - (\\frac{1}{2}(x - 2))^{2})dx &= \\frac{1}{4}\\int\\frac{1}{1 - u^{2}} \\cdot 2du \\\\\n&= \\frac{1}{2}\\int\\frac{1}{1 - u^{2}}du \\\\\n&= \\frac{1}{2} \\cdot artanh u + C \\\\\n&= \\frac{1}{2}artanh (\\frac{x - 2}{2}) + C\n\\end{aligned}\n$$\n\nNote that this result is subject to the condition\n\n$$\n\\left|\\dfrac {x-2} {2} \\right| < 1\n$$"} :knowledge-point/id #uuid "3ce45bc3-50b2-549d-86f5-464d7ebd9352" :knowledge-point/questions [{:db/id #edb/ref 17592186167375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cd2e6ef-aa1a-5321-8591-2f217eb071e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}artanh (\\frac{x + 5}{3}) + C" :db/id #edb/ref 17592186165459} {:answer/id #uuid "37c5890e-8f7e-5a4b-9393-669dc924e8ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}artanh (\\frac{x + 5}{2}) + C" :db/id #edb/ref 17592186165460} {:answer/id #uuid "4ed10d9e-daef-5d44-abb5-e89b2dc8448a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}artanh (\\frac{x + 5}{4}) + C" :db/id #edb/ref 17592186165461} {:answer/id #uuid "62521cd6-be9d-5372-be78-fb8a8cf2fe07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}artanh (\\frac{x + 5}{4}) + C" :db/id #edb/ref 17592186165462} {:answer/id #uuid "6f97b445-7d32-5699-b6eb-774b0d7caf7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}artanh (\\frac{x + 5}{4}) + C" :db/id #edb/ref 17592186165463}] :answer-field/id #uuid "208f7da6-812d-5b45-a4ca-4040772ccc46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165458}] :question/id #uuid "62913f4f-2cf7-51ab-98d5-f466ddf267eb" :question/math-academy-id "q-95468" :question/problem "What is $\\displaystyle \\int(1)/(4 - (x + 5)^{2})dx$?"} {:db/id #edb/ref 17592186167376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b81b440c-12b2-59db-a12a-123ab7721191" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{6}artanh (\\frac{x - 1}{\\sqrt{6}}) + C" :db/id #edb/ref 17592186165465} {:answer/id #uuid "d9784f7e-6067-50cf-b6b9-8b1b332cc423" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}artanh (\\frac{x - 1}{\\sqrt{6}}) + C" :db/id #edb/ref 17592186165466} {:answer/id #uuid "f07c68fa-71cb-5221-ad49-46de52da9af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{6}artanh (\\frac{x - 1}{\\sqrt{6}}) + C" :db/id #edb/ref 17592186165467} {:answer/id #uuid "1ab6b878-a909-592f-b5e1-8a0cbfbcd9ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}artanh (\\frac{x - 1}{6}) + C" :db/id #edb/ref 17592186165468} {:answer/id #uuid "6acf172c-7fce-5947-aca5-0e8ded323187" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}artanh (\\frac{x - 1}{\\sqrt{6}}) + C" :db/id #edb/ref 17592186165469}] :answer-field/id #uuid "433946ff-3147-5602-9047-caca37647a58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165464}] :question/id #uuid "41f10220-d30c-5b6d-a297-13917a433826" :question/math-academy-id "q-95469" :question/problem "What is $\\displaystyle \\int\\frac{1}{5 + 2x - x^{2}}dx$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arctangent Integral"} {:db/id #edb/ref 17592186166783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166621 :question/id #uuid "fbc6dae4-e0c2-5cbb-abfe-62b7f08afac0" :question/math-academy-id "e-8404" :question/problem "Calculate $\\displaystyle \\int \\dfrac{\\textrm{d}x}{\\sqrt{\\left(x - 1\\right)^2-9}}$." :question/worked-solution "First, we note that\n\n$$\n\\int \\dfrac{\\textrm{d}x}{\\sqrt{\\left(x - 1\\right)^2-9}} = \\int \\dfrac{\\textrm{d}x}{\\sqrt{9\\left(\\dfrac{x - 1}{3}\\right)^2-9}} = \\dfrac{1}{3} \\int \\dfrac{1}{\\sqrt{\\left(\\dfrac{x-1}{3}\\right)^2-1}} \\textrm{d}x\n$$\n\nLet\n\n$$\nu =\\dfrac{x-1}{3}\n$$\n\nThen, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3} \\quad\\Longrightarrow\\quad \\textrm{d}x = 3\\,\\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\frac{1}{3}\\int(1)/(\\sqrt{(\\frac{x - 1}{3})^{2} - 1})dx &= \\frac{1}{3}\\int\\frac{1}{\\sqrt{u^{2} - 1}} \\cdot 3du \\\\\n&= arcosh u + C \\\\\n&= arcosh (\\frac{x - 1}{3}) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "966d7ddd-f07f-5335-a8e4-2189dd51598b" :knowledge-point/questions [{:db/id #edb/ref 17592186167371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad65f720-9ba3-5c48-8ef6-8563a173768e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}arcosh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165435} {:answer/id #uuid "c8152a41-dcc8-59cb-bad5-ce5ad24d78ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165436} {:answer/id #uuid "dfcafd47-c3cd-54c3-8793-f7020e00b919" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165437} {:answer/id #uuid "12349aba-53b7-5546-bef8-9bee6553bd53" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165438} {:answer/id #uuid "42001c11-c861-53c9-baa5-2138d42d277d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}arcosh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165439}] :answer-field/id #uuid "0dc8d21b-706e-5561-adfe-b550503f163f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165434}] :question/id #uuid "888cdf0a-6535-5bca-ac71-d8d488aa9d3f" :question/math-academy-id "q-95461" :question/problem "Calculate $\\displaystyle \\int(dx)/(\\sqrt{(3x + 1)^{2} + 9})$."} {:db/id #edb/ref 17592186167373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899d83e7-170b-5941-b160-b65950585816" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (\\frac{2x - 1}{2}) + C" :db/id #edb/ref 17592186165447} {:answer/id #uuid "cb9a4c48-6b8f-54a4-aa86-f2b6c4aa7080" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (\\frac{2x - 1}{3}) + C" :db/id #edb/ref 17592186165448} {:answer/id #uuid "eb66d945-b58a-5a78-b901-7cafb4dadbe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (\\frac{x - 1}{4}) + C" :db/id #edb/ref 17592186165449} {:answer/id #uuid "203131c7-18fa-5188-82ee-7e3ab4e8fb4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arsinh (\\frac{2x - 1}{3}) + C" :db/id #edb/ref 17592186165450} {:answer/id #uuid "7046eb97-5909-5dd3-9787-f5eb70220d74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arsinh (\\frac{2x - 1}{2}) + C" :db/id #edb/ref 17592186165451}] :answer-field/id #uuid "b940f051-7830-5232-83b4-31d9d55e5f60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165446}] :question/id #uuid "49ddc13d-695b-5cd1-908f-3628c6b7c126" :question/math-academy-id "q-95465" :question/problem "Calculate $\\displaystyle \\int(dx)/(\\sqrt{(2x - 1)^{2} - 4})$."}] :knowledge-point/title "Computing an Inverse Hyperbolic Integral Containing a Completed Square"}] :topic/title "Integration Using Hyperbolic Functions and Completing the Square"} {:activity/first-step {:db/id #edb/ref 17592186167708} :activity/id #uuid "e6f517da-9240-5b4c-ae1d-38b5f912e81b" :activity/steps [{:db/id #edb/ref 17592186167612 :step/content {:db/id #edb/ref 17592186166780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166618 :question/id #uuid "56125c27-b034-5450-a01c-cd22347da6b0" :question/math-academy-id "e-8401" :question/problem "${\\displaystyle \\int \\dfrac{\\textrm{d}x}{\\sqrt{x^2-2x+2}} =}$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned} x^2-2x+2 & = x^2 - 2\\cdot x +1^2 - 1^2 + 2 \\\\[3pt] &= (x-1)^2 -1+2 \\\\[3pt] &= (x-1)^2 + 1 \\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{\\textrm{d}x}{\\sqrt{x^2-2x+2}} = \\int \\dfrac{\\textrm{d}x}{\\sqrt {(x-1)^2 + 1}}\n$$\n\nLet $u = x-1$. Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int\\frac{dx}{\\sqrt{x^{2} - 2x + 2}} &= \\int(dx)/(\\sqrt{(x - 1)^{2} + 1}) \\\\\n&= \\int\\frac{du}{\\sqrt{u^{2} + 1}} \\\\\n&= arsinh u + C \\\\\n&= arsinh (x - 1) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "fc9e3257-b8de-5a0c-8900-8017a344471e" :knowledge-point/questions [{:db/id #edb/ref 17592186167372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "992f308c-3081-51db-8cb6-cf684d229be4" :answer/type {:db/ident :answer.type/math} :answer/value "2arsinh (x + 2) + C" :db/id #edb/ref 17592186165441} {:answer/id #uuid "c27e6a75-b4d2-5d7f-b783-b6bde65b51cf" :answer/type {:db/ident :answer.type/math} :answer/value "2arcosh (x + 2) + C" :db/id #edb/ref 17592186165442} {:answer/id #uuid "1e4f0e1c-6126-5a6e-80c5-6267aa877c6f" :answer/type {:db/ident :answer.type/math} :answer/value "2arcosh (x + 1) + C" :db/id #edb/ref 17592186165443} {:answer/id #uuid "475bdba4-4b2a-5620-92d4-b3fe33c18adf" :answer/type {:db/ident :answer.type/math} :answer/value "2arsinh (x + 1) + C" :db/id #edb/ref 17592186165444} {:answer/id #uuid "52d2d728-9723-5b43-a703-3f2c40468685" :answer/type {:db/ident :answer.type/math} :answer/value "4arsinh (x + 1) + C" :db/id #edb/ref 17592186165445}] :answer-field/id #uuid "4435da9c-5a82-5a22-9e1c-5d9436e11300" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165440}] :question/id #uuid "e5477f2d-0e1b-5ead-bfa0-b5d05ca8088a" :question/math-academy-id "q-95464" :question/problem "What is $\\displaystyle \\int\\frac{2}{\\sqrt{x^{2} + 4x + 5}}dx$?"} {:db/id #edb/ref 17592186167447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01827a4b-f2fe-54dc-88a4-5990d389839c" :answer/type {:db/ident :answer.type/math} :answer/value "arcosh (\\frac{x - 2}{3}) + C" :db/id #edb/ref 17592186165891} {:answer/id #uuid "4a5eab12-c87e-5716-98b2-b60b38647e56" :answer/type {:db/ident :answer.type/math} :answer/value "arsinh (\\frac{x - 2}{3}) + C" :db/id #edb/ref 17592186165892} {:answer/id #uuid "6911028f-3e31-5d95-bd70-a4534b9c4bd0" :answer/type {:db/ident :answer.type/math} :answer/value "arsinh (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186165893} {:answer/id #uuid "75c07914-0def-5ca3-86b6-1c5483173a9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x - 3) + C" :db/id #edb/ref 17592186165894} {:answer/id #uuid "76155b74-9248-564c-93ab-95f88e661f34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arsinh (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186165895}] :answer-field/id #uuid "ffed0f57-4e4a-5c68-a3ab-f2aaab09b53d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165890}] :question/id #uuid "2b704f88-3434-51ec-979f-0b294315821f" :question/math-academy-id "q-96062" :question/problem "What is $\\displaystyle \\int\\frac{dx}{\\sqrt{x^{2} - 6x + 13}}$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arcsine Integral"} :step/id #uuid "06ba6497-5923-5dab-8a77-ce6fa1895aed" :step/next {:db/id #edb/ref 17592186167613}} {:db/id #edb/ref 17592186167613 :step/content {:db/id #edb/ref 17592186166781 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166619 :question/id #uuid "89aeeda2-86ec-5ed2-9ae2-ad68f1b1c599" :question/math-academy-id "e-8402" :question/problem "${\\displaystyle \\int \\dfrac{2}{\\sqrt{x^2-4x+3}} \\textrm{d}x=}$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}\nx^{2} - 4x + 3 &= x^{2} - 2 \\cdot 2x + 2^{2} - 2^{2} + 3 \\\\\n&= (x - 2)^{2} - 1\n\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{2}{\\sqrt{x^2-4x+3}} \\textrm{d}x = \\int \\dfrac{2}{\\sqrt {(x-2)^2-1}} \\, \\textrm{d}x\n$$\n\nLet $u = x-2$. Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int\\frac{2}{\\sqrt{x^{2} - 4x + 3}}dx &= \\int(2)/(\\sqrt{(x - 2)^{2} - 1})dx \\\\\n&= 2\\int\\frac{1}{\\sqrt{u^{2} - 1}}du \\\\\n&= 2arcosh u + C \\\\\n&= 2arcosh (x - 2) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "cdf9d07c-b687-5b71-a4a1-3652d6fb9b2b" :knowledge-point/questions [{:db/id #edb/ref 17592186167374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb8d3fbd-2a5e-5dcf-8568-b95086e80d44" :answer/type {:db/ident :answer.type/math} :answer/value "5arcosh (x - 3) + C" :db/id #edb/ref 17592186165453} {:answer/id #uuid "fbf5e2f3-686b-584e-80cd-f94ae72bd2a7" :answer/type {:db/ident :answer.type/math} :answer/value "10arcosh (x - 6) + C" :db/id #edb/ref 17592186165454} {:answer/id #uuid "312ba2b0-9677-504c-9b3b-9df476dece8e" :answer/type {:db/ident :answer.type/math} :answer/value "arcosh (x - 2) + C" :db/id #edb/ref 17592186165455} {:answer/id #uuid "4af0163a-9663-530e-8d13-d430ef4f90e4" :answer/type {:db/ident :answer.type/math} :answer/value "3arcosh (x - 1) + C" :db/id #edb/ref 17592186165456} {:answer/id #uuid "53d1a3ad-e621-51b7-a1f6-0d5f25fec5bf" :answer/type {:db/ident :answer.type/math} :answer/value "5arcosh (x - 5) + C" :db/id #edb/ref 17592186165457}] :answer-field/id #uuid "98998d08-0cea-5960-8a0a-216339b2b22b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165452}] :question/id #uuid "53ede172-40e4-5f6b-bbef-37f586494ddf" :question/math-academy-id "q-95466" :question/problem "What is $\\displaystyle \\int\\frac{5}{\\sqrt{x^{2} - 6x + 8}}dx$?"} {:db/id #edb/ref 17592186167449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a227af-607e-53ea-8911-93693c9a9332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 2) + C" :db/id #edb/ref 17592186165903} {:answer/id #uuid "b0a0bcb9-2370-5f20-9d72-5f97f954ea7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 1) + C" :db/id #edb/ref 17592186165904} {:answer/id #uuid "f969625f-f618-51f0-bd71-da25f2733fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (x + 4) + C" :db/id #edb/ref 17592186165905} {:answer/id #uuid "15640745-6eb2-54e8-b51f-fa4e642c33c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x + 1) + C" :db/id #edb/ref 17592186165906} {:answer/id #uuid "51ff08d4-f7fa-5a73-bfbe-0f38b8cef599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (x + 2) + C" :db/id #edb/ref 17592186165907}] :answer-field/id #uuid "a43a6e18-af92-5f0c-949b-94c1d28904aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165902}] :question/id #uuid "de65eabb-3c40-5992-a0bf-042d4963fdb2" :question/math-academy-id "q-96082" :question/problem "What is $\\displaystyle \\int\\frac{dx}{\\sqrt{16x^{2} + 32x}}$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arccosine Integral"} :step/id #uuid "c87abe9a-8e1f-5734-bf45-d1b458a9595a" :step/next {:db/id #edb/ref 17592186167614}} {:db/id #edb/ref 17592186167614 :step/content {:db/id #edb/ref 17592186166782 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166620 :question/id #uuid "23d714d4-1c4c-5228-9d9d-303c6011d4a4" :question/math-academy-id "e-8403" :question/problem "$\\displaystyle \\int \\dfrac{1}{4x-x^2} \\textrm{d}x=$" :question/worked-solution "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned} 4x-x^2 & = -(x^2 - 4x) \\\\[5pt] & = -(x^2 - 2\\cdot 2x + 2^2-2^2) \\\\[5pt] & = -((x-2)^2 - 4) \\\\[5pt] &= 4 - (x-2)^2 \\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\dfrac{1}{4x-x^2}\\textrm{d}x = \\int \\dfrac{1}{4-(x-2)^2}\\textrm{d}x = \\dfrac{1}{4} {\\int}\\dfrac{1}{1 - \\left(\\frac{1}{2}(x-2)\\right)^2}\\textrm{d}x\n$$\n\nLet\n\n$$\nu = \\dfrac{1}{2}(x-2)\n$$\n\nThen, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{2} \\quad\\Longrightarrow\\quad \\textrm{d}x = 2\\,\\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\frac{1}{4}\\int(1)/(1 - (\\frac{1}{2}(x - 2))^{2})dx &= \\frac{1}{4}\\int\\frac{1}{1 - u^{2}} \\cdot 2du \\\\\n&= \\frac{1}{2}\\int\\frac{1}{1 - u^{2}}du \\\\\n&= \\frac{1}{2} \\cdot artanh u + C \\\\\n&= \\frac{1}{2}artanh (\\frac{x - 2}{2}) + C\n\\end{aligned}\n$$\n\nNote that this result is subject to the condition\n\n$$\n\\left|\\dfrac {x-2} {2} \\right| < 1\n$$"} :knowledge-point/id #uuid "3ce45bc3-50b2-549d-86f5-464d7ebd9352" :knowledge-point/questions [{:db/id #edb/ref 17592186167375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cd2e6ef-aa1a-5321-8591-2f217eb071e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}artanh (\\frac{x + 5}{3}) + C" :db/id #edb/ref 17592186165459} {:answer/id #uuid "37c5890e-8f7e-5a4b-9393-669dc924e8ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}artanh (\