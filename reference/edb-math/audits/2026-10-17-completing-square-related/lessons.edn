dius: $1$" :db/id #edb/ref 17592186432210} {:answer/id #uuid "6d9f2f63-2b6c-5173-96ad-fa3cefcebd64" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $2$" :db/id #edb/ref 17592186432211} {:answer/id #uuid "76607376-556e-5250-8ef1-e96ff909028c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,2),$ radius: $\\sqrt{2}$" :db/id #edb/ref 17592186432212}] :answer-field/correct {:answer/id #uuid "6c5d401c-bb61-5f85-be78-864bd3556574" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $1$" :db/id #edb/ref 17592186432210} :answer-field/id #uuid "2f7be69d-ef52-5421-abfe-89f073f68500" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432236}] :question/id #uuid "f5b1b8a2-d088-51d1-b8fc-6a7c6d262461" :question/math-academy-id "q-54216" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-4x+{y}^{2}-2y=-4.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-4x+{y}^{2}-2y & =-4 \\\\ ({x}^{2}-4x)+({y}^{2}-2y) & =-4 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =-4+{2}^{2}+{1}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-1)^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,1)$ and its radius is $1.$"} {:db/id #edb/ref 17592186498575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27785dc6-76a3-5a5d-b8dd-d445c16c7768" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,3)$, radius: $2$" :db/id #edb/ref 17592186497879} {:answer/id #uuid "40c67b67-6b96-5400-842b-51fa742b9835" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,3)$, radius: $4$" :db/id #edb/ref 17592186497943} {:answer/id #uuid "4ace6e36-b1ef-56ec-a5a0-deceabb0e4e6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,0)$, radius: $49$" :db/id #edb/ref 17592186497972} {:answer/id #uuid "af981369-ab02-50f9-9b99-0a675cccf17c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,0)$, radius: $7$" :db/id #edb/ref 17592186498190} {:answer/id #uuid "b012dc73-db2e-5d6d-9fda-ff683299fa06" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-3)$, radius: $7$" :db/id #edb/ref 17592186498191}] :answer-field/correct {:answer/id #uuid "af981369-ab02-50f9-9b99-0a675cccf17c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,0)$, radius: $7$" :db/id #edb/ref 17592186498190} :answer-field/id #uuid "c8afdf75-273f-54be-a69f-223bfb905f12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498457}] :question/id #uuid "ba829ff8-bbca-5643-baef-27f89f8dddf9" :question/math-academy-id "q-5192" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+6x+{y}^{2}=40.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+6x+{y}^{2} & =40 \\\\ ({x}^{2}+6x)+{y}^{2} & =40 \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =40+{3}^{2} \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-0)^{2} & ={7}^{2} \\\\ (x-(-3))^{2}+(y-0)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-3,0)$ and its radius is $7.$"}] :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"} {:db/id #edb/ref 17592186078391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078248 :question/id #uuid "b05d1090-fd7b-52eb-84a7-55377ead0dda" :question/math-academy-id "e-3229" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - x  = 6.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x & =6 \\\\ ({x}^{2}-x)+{y}^{2} & =6 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =6+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{y}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-\\frac{1}{2})}^{2}+(y-0)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $\\left(\\dfrac{1}{2}, 0 \\right)$ and its radius is $\\dfrac{5}{2}.$"} :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/questions [{:db/id #edb/ref 17592186079067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267fe552-82a1-5d5a-82b0-0aceb8f8f45a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186330284} {:answer/id #uuid "4aca5a42-8f1f-5417-93c5-329b30814c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186330627} {:answer/id #uuid "86ae4ca7-99be-533c-aff8-15ae23e11015" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{3}{2})$, radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186331149} {:answer/id #uuid "a60ce9b1-fb56-514a-a47c-599fbf677b89" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186331434} {:answer/id #uuid "bdd8529d-f61d-5275-90a7-de3e8de6bb28" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{9}{4})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186331630}] :answer-field/correct {:answer/id #uuid "4aca5a42-8f1f-5417-93c5-329b30814c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186330627} :answer-field/id #uuid "1832e439-01f1-55f8-90bf-4daf38dc31b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332231}] :question/id #uuid "369014bc-22e5-503d-91de-63ec87d81ac8" :question/math-academy-id "q-5195" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3y & =0 \\\\ {x}^{2}+({y}^{2}-3y) & =0 \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & ={(\\frac{3}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{3}{2})$ and its radius is $\\frac{3}{2}.$"} {:db/id #edb/ref 17592186079203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a24aa32-be27-5a08-b7f2-3b7687162fe7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},1),$ radius: $\\frac{25}{4}$" :db/id #edb/ref 17592186432208} {:answer/id #uuid "8a69426e-541f-5455-a730-43f891fdd05a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},-1),$ radius: $3$" :db/id #edb/ref 17592186432216} {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} {:answer/id #uuid "b7212f1a-369b-508d-af5b-02c25936336a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},-1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186432221} {:answer/id #uuid "cafaa4da-7864-5748-8e08-e8893dc4bdbd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432224}] :answer-field/correct {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} :answer-field/id #uuid "0135309d-4571-5e4f-b373-ceb7b0682c4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077996}] :question/id #uuid "7f67332a-d49b-5dc7-b92a-6be6456a8b20" :question/math-academy-id "q-76089" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+5x+{y}^{2}-2y=\\frac{7}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+5x+{y}^{2}-2y & =\\frac{7}{4} \\\\ ({x}^{2}+5x)+({y}^{2}-2y) & =\\frac{7}{4} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =\\frac{7}{4}+{(\\frac{5}{2})}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =9.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+(y-1)^{2} & ={3}^{2} \\\\ {(x-(-\\frac{5}{2}))}^{2}+(y-1)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},1)$ and its radius is $3.$"} {:db/id #edb/ref 17592186238070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} {:answer/id #uuid "a348d55a-36a9-5af2-81e6-6f7585bd95e1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186236841} {:answer/id #uuid "cf31be4e-0647-5297-be76-a4721eb22f2a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237129} {:answer/id #uuid "d9ca6f54-6773-56f6-8dd0-f043a63dc54a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186237197} {:answer/id #uuid "fc2a1ef9-6f90-5fd1-aa22-221a29a4b907" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237416}] :answer-field/correct {:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} :answer-field/id #uuid "2e70a388-068c-5ad0-9ccf-1ecef596f218" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237503}] :question/id #uuid "072480e4-7dc0-5975-9c71-894af7eb1672" :question/math-academy-id "q-103890" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+3x-y-2=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+3x-y-2 & =0 \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =2 \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =2+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{9}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{9}{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{3}{\\sqrt{2}})}^{2}\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{3}{\\sqrt{2}}.$"} {:db/id #edb/ref 17592186238071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1363c841-dd2f-57da-b97b-16bec04683d6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186235930} {:answer/id #uuid "47c89831-df18-53be-92f2-b52d6c8ba5b2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186236279} {:answer/id #uuid "52ba3c55-6a2d-5c64-9e05-2892226192de" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186236342} {:answer/id #uuid "bf62ed9c-4b79-5d2c-83d9-7a2053919ece" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237033} {:answer/id #uuid "d0cd46be-6ca9-56ad-98b1-e84372745705" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},4)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237141}] :answer-field/correct {:answer/id #uuid "bf62ed9c-4b79-5d2c-83d9-7a2053919ece" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237033} :answer-field/id #uuid "c35bda4d-8c7c-53e3-9565-e1df8075b9d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237687}] :question/id #uuid "e504d2ff-bf2c-5a7b-89f3-0f34d5a7f90d" :question/math-academy-id "q-103894" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3x-4y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3x-4y & =0 \\\\ ({x}^{2}-3x)+({y}^{2}-4y) & =0 \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & ={(\\frac{3}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2}+(y-2)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{3}{2},2)$ and its radius is $\\frac{5}{2}.$"} {:db/id #edb/ref 17592186238072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "921a2627-ec10-5d1e-8639-eef8fd7f3342" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{2})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236745} {:answer/id #uuid "9fb55b6d-6427-54d7-925a-0d7d4383ae68" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186236813} {:answer/id #uuid "b365be51-4d65-5928-9f90-0629516c1e8d" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236953} {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} {:answer/id #uuid "c9d0e896-c4c4-58e2-a331-79ea27bb0deb" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186237098}] :answer-field/correct {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} :answer-field/id #uuid "94b4f34f-41d5-5588-8d90-691adc493613" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237636}] :question/id #uuid "f6a657b9-6edf-5ed4-a2a2-a0a7062d8da7" :question/math-academy-id "q-103896" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-\\frac{1}{2}y=\\frac{1}{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-\\frac{1}{2}y & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-\\frac{1}{2}y) & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & ={(\\frac{1}{4})}^{2}+\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"} {:db/id #edb/ref 17592186275155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06850c47-fcbc-5abd-b7d6-b11674ea47ca" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},\\frac{3}{2}),$ radius: $\\frac{33}{2}$" :db/id #edb/ref 17592186272447} {:answer/id #uuid "3a9ee61e-e69d-50e4-8aca-53894b381f7c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186272897} {:answer/id #uuid "3e54b76c-e1f0-5d14-ab10-98399e5e8200" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{5}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186272920} {:answer/id #uuid "3ea670b2-8faf-521a-a46b-20ea49b05bdd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},-\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186272922} {:answer/id #uuid "ebd9899c-a884-5944-9dee-f91e9f53b32f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{1}{2}),$ radius: $\\frac{33}{2}$" :db/id #edb/ref 17592186274470}] :answer-field/correct {:answer/id #uuid "3a9ee61e-e69d-50e4-8aca-53894b381f7c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186272897} :answer-field/id #uuid "5ab20c73-c972-571f-807c-633d199a2fbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274788}] :question/id #uuid "1aecc5c6-9284-53c0-a6bc-d071019a3ece" :question/math-academy-id "q-14620" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+5x-3y-8=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+5x-3y-8 & =0 \\\\ ({x}^{2}+5x)+({y}^{2}-3y) & =8 \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =8+{(\\frac{5}{2})}^{2}+{(\\frac{3}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =\\frac{33}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & =\\frac{33}{2} \\\\ {(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\sqrt{\\frac{33}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},\\frac{3}{2})$ and its radius is $\\sqrt{\\frac{33}{2}}.$"} {:db/id #edb/ref 17592186345210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2deb5ecd-9fcb-5de8-a47f-2aac32b50a6d" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186342625} {:answer/id #uuid "4f75afc8-c8e2-552b-bf47-67f0c0a13567" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,\\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186342897} {:answer/id #uuid "5fd46a16-dd73-5cd7-848b-a231cc8b9c89" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186343050} {:answer/id #uuid "6734105b-9de9-5be8-a53a-4158d98ddacb" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186343113} {:answer/id #uuid "f715325d-e759-56c1-bf0d-6cd6e0eee098" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186344414}] :answer-field/correct {:answer/id #uuid "5fd46a16-dd73-5cd7-848b-a231cc8b9c89" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186343050} :answer-field/id #uuid "58052dca-b02a-538c-bcb6-2bc7ad90fc13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344639}] :question/id #uuid "9155ce6a-a592-5aef-9c65-bf69cca03a69" :question/math-academy-id "q-76369" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}-x+{y}^{2}-4y=-2.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-x+{y}^{2}-4y & =-2 \\\\ ({x}^{2}-x)+({y}^{2}-4y) & =-2 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-2+{(\\frac{1}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{9}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & =\\frac{9}{4} \\\\ {(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},2)$ and its radius is $\\frac{3}{2}.$"} {:db/id #edb/ref 17592186345211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4b4a86-f169-5c4f-87f5-d0b62ec60298" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186342323} {:answer/id #uuid "3ce40828-670c-5edd-87b2-c0cb375a82f2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186342739} {:answer/id #uuid "3ed3b169-f0d4-5213-afa6-342dddae141a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186342758} {:answer/id #uuid "92eceef3-679c-5de1-b434-dd837f79c2d3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186343524} {:answer/id #uuid "d14e25aa-c14c-530e-b787-28f9bb6a6b10" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186344078}] :answer-field/correct {:answer/id #uuid "3ed3b169-f0d4-5213-afa6-342dddae141a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186342758} :answer-field/id #uuid "0b2b3b34-415d-5dcc-bc53-182c2750c2e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344516}] :question/id #uuid "385da02b-d681-50b2-a172-67bb1e6a6af1" :question/math-academy-id "q-76370" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+3x+{y}^{2}-y=-\\frac{9}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+3x+{y}^{2}-y & =-\\frac{9}{4} \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =-\\frac{9}{4} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =-\\frac{9}{4}+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{1}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{1}{2}$"} {:db/id #edb/ref 17592186396066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2fe06dc-0609-5053-9367-73d7ebf2fcb3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396068} {:answer/id #uuid "3f353887-7ced-5107-882a-0276e72dd462" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396069} {:answer/id #uuid "d0c03ddb-5aef-510c-adf3-fa2a8970e245" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396070} {:answer/id #uuid "ef5518f9-14b3-5d56-ae49-14acc285d236" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396071} {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396072}] :answer-field/correct {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396072} :answer-field/id #uuid "8bd2771d-4f88-578f-9fd3-675729a93312" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396067}] :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$"} {:db/id #edb/ref 17592186399412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b34439c-2388-5711-9ac8-63f5bf3cf549" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-7,0)$, radius: $49$" :db/id #edb/ref 17592186399414} {:answer/id #uuid "1eb48f02-d998-5b04-842c-b869161eadb6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399415} {:answer/id #uuid "317341c2-5258-5001-88cf-9b017288ada7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186399416} {:answer/id #uuid "f3bcc4ce-6ce1-5ebf-8946-9df961f73342" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399417} {:answer/id #uuid "1ed03bf8-4e63-5262-8883-5b8d87a82e28" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7,0)$, radius: $7$" :db/id #edb/ref 17592186399418}] :answer-field/correct {:answer/id #uuid "1eb48f02-d998-5b04-842c-b869161eadb6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399415} :answer-field/id #uuid "4c479e6f-23bb-5fd5-ab28-ff2cfcd0fb64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399413}] :question/id #uuid "3f6a0f67-fd62-5333-8099-37761d6fc395" :question/math-academy-id "q-103892" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7x=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7x & =0 \\\\ ({x}^{2}+7x)+{y}^{2} & =0 \\\\ ({x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2})+{y}^{2} & ={(\\frac{7}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x+\\frac{7}{2})}^{2}+{y}^{2} & ={(\\frac{7}{2})}^{2} \\\\ {(x-(-\\frac{7}{2}))}^{2}+(y-0)^{2} & ={(\\frac{7}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{7}{2},0)$ and its radius is $\\frac{7}{2}.$"} {:db/id #edb/ref 17592186403836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "707a4cfe-d34e-5500-a601-9753b554d97e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,-\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186403838} {:answer/id #uuid "0043bbe1-8c13-5357-841d-e795a04df199" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403839} {:answer/id #uuid "13f05de5-d7d8-5d9c-9e5d-ac75c76fa048" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403840} {:answer/id #uuid "1705b14f-f5fa-5468-b93d-33bcdcdbb387" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{4},1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186403841} {:answer/id #uuid "cc1a32ca-3acb-5d7d-b8ad-8a49ebecf6c4" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186403842}] :answer-field/correct {:answer/id #uuid "13f05de5-d7d8-5d9c-9e5d-ac75c76fa048" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186403840} :answer-field/id #uuid "64251e03-03e9-594a-89a0-0a7ae7fb1367" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403837}] :question/id #uuid "64257e64-8ece-56eb-a9da-46dae15085ca" :question/math-academy-id "q-76374" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}-4x+2{y}^{2}-y=-1.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}-4x+2{y}^{2}-y & =-1 \\\\ {x}^{2}-2x+{y}^{2}-\\frac{1}{2}y & =-\\frac{1}{2} \\\\ ({x}^{2}-2x)+({y}^{2}-\\frac{1}{2}y) & =-\\frac{1}{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =-\\frac{1}{2}+{1}^{2}+{(\\frac{1}{4})}^{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{(y-\\frac{1}{4})}^{2} & =\\frac{9}{16} \\\\ (x-1)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"} {:db/id #edb/ref 17592186432241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869f4c55-546c-52cc-8ced-67516318c751" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},2),$ radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186432215} {:answer/id #uuid "8f2c590a-006c-5f3e-a6ce-8ac136804c47" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{25}{2}$" :db/id #edb/ref 17592186432218} {:answer/id #uuid "b7aafbb4-5f1a-532e-a061-cd5642e39dcb" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},-2),$ radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186432222} {:answer/id #uuid "cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432226} {:answer/id #uuid "d272cd79-ec75-589c-ac60-423761ee530e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},-2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432228}] :answer-field/correct {:answer/id #uuid "cf5a2a27-3dd3-5a9b-b293-538e2a5ae403" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{9}{2},2),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432226} :answer-field/id #uuid "5ef058c1-0aa5-57fc-9272-6eda95714a4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432238}] :question/id #uuid "05b6d7d5-d625-5b32-8cf2-e194a924cafa" :question/math-academy-id "q-76372" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}-9x+18=4y-{y}^{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-9x+18 & =4y-{y}^{2} \\\\ ({x}^{2}-9x)+({y}^{2}-4y) & =-18 \\\\ ({x}^{2}-2\\cdot \\frac{9}{2}x+{(\\frac{9}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-18+{(\\frac{9}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{9}{2}x+{(\\frac{9}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{9}{2})}^{2}+(y-2)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{9}{2},2)$ and its radius is $\\frac{5}{2}.$"} {:db/id #edb/ref 17592186432242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bde742f-f51c-5674-bb70-2f6fd40536f4" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,-\\frac{7}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186432203} {:answer/id #uuid "327347a6-42f8-50e6-ad5f-073e874b3720" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432204} {:answer/id #uuid "c0852af0-ccd5-5bd7-9bd6-ee1f70eaa95d" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{7}{2},1),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432223} {:answer/id #uuid "d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432227} {:answer/id #uuid "ff7c06d3-205f-5a3d-a8e4-802ee7d82dbe" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,\\frac{7}{2}),$ radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186432234}] :answer-field/correct {:answer/id #uuid "d1b3959a-2607-51e9-a4b6-5a4f75bcd867" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{7}{2}),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432227} :answer-field/id #uuid "c017ab2c-4452-50b0-937f-c0713b32da2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432240}] :question/id #uuid "11173788-8230-54a4-a1cf-e31575312fe3" :question/math-academy-id "q-76373" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7=7y-2x.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7 & =7y-2x \\\\ ({x}^{2}+2x)+({y}^{2}-7y) & =-7 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =-7+{1}^{2}+{(\\frac{7}{2})}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}) & =\\frac{25}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+1)}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-(-1))}^{2}+{(y-\\frac{7}{2})}^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,\\frac{7}{2})$ and its radius is $\\frac{5}{2}.$"} {:db/id #edb/ref 17592186498585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0651e04-cc61-5bcf-af3b-f91d6f9a0b0e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{4},1)$, radius: $2$" :db/id #edb/ref 17592186498158} {:answer/id #uuid "ac362cb6-492d-5473-b6dc-d32427af7ead" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},1)$, radius: $2$" :db/id #edb/ref 17592186498179} {:answer/id #uuid "db06cb6f-0562-5273-a873-d0e8e28fdf46" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},1)$, radius: $4$" :db/id #edb/ref 17592186498288} {:answer/id #uuid "ddb9f323-6fcc-523f-9e46-a8019383f7b6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{4},-1)$, radius: $4$" :db/id #edb/ref 17592186498294} {:answer/id #uuid "f048c8b8-0deb-58cc-8917-7eb188230fc3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},-1)$, radius: $2$" :db/id #edb/ref 17592186498328}] :answer-field/correct {:answer/id #uuid "ac362cb6-492d-5473-b6dc-d32427af7ead" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},1)$, radius: $2$" :db/id #edb/ref 17592186498179} :answer-field/id #uuid "d763b4a3-5d4a-5059-b073-6cac4252989e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498467}] :question/id #uuid "d79c8724-85a2-50fb-b60d-a80008511394" :question/math-academy-id "q-103893" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-x-2y=\\frac{11}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x-2y & =\\frac{11}{4} \\\\ ({x}^{2}-x)+({y}^{2}-2y) & =\\frac{11}{4} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & ={(\\frac{1}{2})}^{2}+{1}^{2}+\\frac{11}{4} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =4\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-1)}^{2} & ={2}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},1)$ and its radius is $2.$"}] :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :topic/title "Determining Circle Properties by Completing the Square"} {:activity/first-step {:db/id #edb/ref 17592186079239} :activity/id #uuid "f525d904-1978-5a65-97fe-fc43e27af14e" :activity/steps [{:db/id #edb/ref 17592186079239 :step/content {:db/id #edb/ref 17592186079635 :tutorial/content "Consider the equation \n\n$$\nx^2 +  y^2 - 2x - 4y = 4.\n$$\n\nBelieve it or not, this equation actually represents a circle! Its graph is given below:\n\n![](images/5d/5dfea5042d6c84f40a2790a01ee6aafb64433f7422ce88b589cf670d93771e2c.png)\n\n   \n\nClearly, this is a circle of radius $3$ centered at $(1,2).$ But how can we determine the center and radius from the given circle equation?\n\nLet's start with the equation\n\n$$\nx^2 +  y^2 - 2x - 4y = 4.\n$$\n\nBy grouping the $x$ and $y$ terms and completing the squares, we can write the equation in the standard form\n\n$$\n(x-a)^2 + (y-b)^2 = r^2.\n$$\n\nWe carry out the process with the following steps:\n\n**Step 1. **Group the $x$ and $y$ terms.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-2x-4y & =4 \\\\ ({x}^{2}-2x)+({y}^{2}-4y) & =4\\end{aligned}\n$$\n\n**Step 2.** In each group, add the square of half the linear coefficient to both sides of the equation. \n\n- Here, the $x$ coefficient is $-2,$ so we add $\\left( \\dfrac{-2}{2} \\right)^2 = (-1)^2 = 1$ to both sides.\n\n- Likewise, the $y$ coefficient is $-4,$ so we add $\\left( \\dfrac{-4}{2} \\right)^2 = (-2)^2 = 4$ to both sides.\n\nSo, we have\n\n$$\n\\begin{aligned}({x}^{2}-2x+1)+({y}^{2}-4y+4) & =4+1+4 \\\\ ({x}^{2}-2x+1)+({y}^{2}-4y+4) & =9.\\end{aligned}\n$$\n\n**Step 3.** Finally, we factor each group into a perfect square, and we get\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-2)^{2} & =9 \\\\ (x-1)^{2}+(y-2)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nNow, we can see that the equation represents a circle centered at $(1,2)$ with radius $3.$" :tutorial/id #uuid "a8743599-a677-56de-8b27-1b1b04f19643" :tutorial/title "Introduction"} :step/id #uuid "5a84eb88-0914-5665-a28e-3f5d962dbbb0" :step/next {:db/id #edb/ref 17592186079240}} {:db/id #edb/ref 17592186079240 :step/content {:db/id #edb/ref 17592186078390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078247 :question/id #uuid "36c32777-8081-5431-a112-321738a3adab" :question/math-academy-id "e-3228" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - 4x + 6y = 12.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x+6y & =12 \\\\ ({x}^{2}-4x)+({y}^{2}+6y) & =12 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =12+{2}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+3)^{2} & ={5}^{2} \\\\ (x-2)^{2}+(y-(-3))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-3)$ and its radius is $5.$"} :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/questions [{:db/id #edb/ref 17592186079061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ffeffb-ef59-54f5-be3f-a2062b83999e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186077145} {:answer/id #uuid "a8e22452-4b20-5bf4-9090-9c4baa1361ca" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186077146} {:answer/id #uuid "c8f09b0a-5fff-5884-866a-7cd7c2b038b1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186077147} {:answer/id #uuid "d6f5be55-2167-551f-a536-04e193c35eb9" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2, 3)$, radius: $4$" :db/id #edb/ref 17592186077148} {:answer/id #uuid "00169a7a-33bd-5ce6-8aa9-6f23a52c4730" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186077149}] :answer-field/id #uuid "b0de6a19-461b-5d8f-8397-c1cfef2f142b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077144} {:answer-field/choices [{:answer/id #uuid "ae470676-bc8c-59ed-9ddf-e6bfad4e99f2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186396095} {:answer/id #uuid "3958fd13-48da-5731-9bd7-2332d7318f31" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186396096} {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} {:answer/id #uuid "1caf2e7f-b2a3-5b2b-9e2c-a85b6dd512fd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186396098} {:answer/id #uuid "6d7bd3d5-18da-5a40-acfa-fa44fce357be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186396099}] :answer-field/correct {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} :answer-field/id #uuid "8f64383e-34d9-58e2-8c5a-1486b312000b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396094}] :question/id #uuid "dd6c82b9-14ab-538d-aa0f-037306546c3d" :question/math-academy-id "q-5144" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4x-6y=3.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-6y & =3 \\\\ ({x}^{2}+4x)+({y}^{2}-6y) & =3 \\\\ ({x}^{2}+2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot 3y+{3}^{2}) & =3+{2}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 2x+4)+({y}^{2}-2\\cdot 3y+9) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-(-2))^{2}+(y-3)^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-2,3)$ and its radius is $4.$"} {:db/id #edb/ref 17592186079065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac8754e7-ca5f-5b76-b604-9a110c2ab88b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-14, 20)$, radius: $25$" :db/id #edb/ref 17592186077169} {:answer/id #uuid "c94e371a-d708-520a-894e-b3c9579c8394" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7,-10)$, radius: $12$" :db/id #edb/ref 17592186077170} {:answer/id #uuid "f7538859-b348-5e31-a39a-92a668ce1e7b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7,-10)$, radius: $0$" :db/id #edb/ref 17592186077171} {:answer/id #uuid "1eb21335-7e24-55b9-b861-a0d80f3c7d27" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-7, 10)$, radius: $12$" :db/id #edb/ref 17592186077172} {:answer/id #uuid "6d35635c-617d-5371-a861-973fab595947" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7, 10)$, radius: $5$" :db/id #edb/ref 17592186077173}] :answer-field/id #uuid "ff5d74b1-6a1c-5e84-a176-d5eee29d25e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077168}] :question/id #uuid "cf99bec9-827b-5d15-abc6-bd91e8ea70a5" :question/math-academy-id "q-5181" :question/problem "Find the center and radius of the circle whose equation is $y^{2} + x^{2} + 20y - 14x + 5 = 0$."} {:db/id #edb/ref 17592186275313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31063f08-1e78-5379-8242-cacf1a1d6a7c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186272824} {:answer/id #uuid "6c4099a2-b1f7-512a-bb2c-d7f0465c2381" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273321} {:answer/id #uuid "b713ce94-48fa-5ac2-95e8-75f2acb1782d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186273975} {:answer/id #uuid "d6152ee4-371c-567f-a7c3-3a6b44ec945c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274260} {:answer/id #uuid "fd8d4981-cac9-569f-a5c8-dce13d00dbea" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186274617}] :answer-field/correct {:answer/id #uuid "31063f08-1e78-5379-8242-cacf1a1d6a7c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186272824} :answer-field/id #uuid "c93918a5-c8b2-5c94-8ed4-2849b95cb1aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274985}] :question/id #uuid "8f4ce117-1fd3-56dc-bc77-859fb08b2278" :question/math-academy-id "q-15304" :question/problem "A circle in the Cartesian plane is given by the equation $8x+{x}^{2}-2y=64-{y}^{2}.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+{x}^{2}-2y & =64-{y}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}-2y) & =64 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =64+{4}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y-1)^{2} & ={9}^{2} \\\\ (x-(-4))^{2}+(y-1)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-4,b=1$ and $r=9,$ and\n\n$$\na+b+r=-4+1+9=6.\n$$"} {:db/id #edb/ref 17592186275326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e85bc55-e02c-54fc-8122-557e2841e870" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186272659} {:answer/id #uuid "bdd36a44-0719-5e42-b8ba-c592a0f863c2" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186274031} {:answer/id #uuid "cf716e16-5a7b-58d5-bd95-468707fb3db2" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186274193} {:answer/id #uuid "ee3f9ff3-e21e-5c4d-8faf-b3e8f4725a52" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186274496} {:answer/id #uuid "f301e76e-2941-5fe9-867b-3eea69dc0dc1" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186274533}] :answer-field/correct {:answer/id #uuid "1e85bc55-e02c-54fc-8122-557e2841e870" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186272659} :answer-field/id #uuid "3da9ef7a-cbe1-5227-9f80-59ed9e88f81a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274741}] :question/id #uuid "7f46ab27-790f-5c57-b1be-51cd554f05c2" :question/math-academy-id "q-15456" :question/problem "A circle in the Cartesian plane is given by the equation \n$137+6y=-{y}^{2}-{x}^{2}-24x.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}137+6y & =-{y}^{2}-{x}^{2}-24x \\\\ {x}^{2}+24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}+24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-(-12))^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-12,b=-3$ and $r=4,$  and\n\n$$\na+b+r=-12-3+4=-11.\n$$"} {:db/id #edb/ref 17592186275328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a12fe75-6db6-5f09-9bc5-bd6bd9576dcf" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186272478} {:answer/id #uuid "0e54e2e8-e204-5957-a9a9-14cd23ef022b" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272513} {:answer/id #uuid "31882272-1fc2-598e-bbaa-9d0d34bcc80f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186272831} {:answer/id #uuid "adc3cf6a-be00-5f94-b2a5-703634096a40" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186273885} {:answer/id #uuid "c2ce0477-019d-5ea0-8931-34103861ebea" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186274077}] :answer-field/correct {:answer/id #uuid "c2ce0477-019d-5ea0-8931-34103861ebea" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186274077} :answer-field/id #uuid "e34c070b-737d-55b5-bb4e-8a877ca09929" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275033}] :question/id #uuid "28089f87-ec60-5ce5-b8d3-c3dc92be3de4" :question/math-academy-id "q-15459" :question/problem "A circle in the Cartesian plane is given by the equation ${y}^{2}+2x+{x}^{2}=24y-120.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}+2x+{x}^{2} & =24y-120 \\\\ {x}^{2}+2x+{y}^{2}-24y & =-120 \\\\ ({x}^{2}+2x)+({y}^{2}-24y) & =-120 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 12y+{12}^{2}) & =-120+{1}^{2}+{12}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 12y+{12}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-12)^{2} & ={5}^{2} \\\\ (x-(-1))^{2}+(y-12)^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-1,b=12,r=5,$ and \n\n$$\na+b+r=-1+12+5=16.\n$$"} {:db/id #edb/ref 17592186275329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12254c34-d106-50c3-9752-79d32d890482" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-16)$, radius: $3$" :db/id #edb/ref 17592186272551} {:answer/id #uuid "1c28ea65-c015-52ea-802f-e35fde5da930" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,16)$, radius: $7$" :db/id #edb/ref 17592186272631} {:answer/id #uuid "5b970cd3-aad4-584e-be28-7367d2698b3f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-16,4)$, radius: $2$" :db/id #edb/ref 17592186273174} {:answer/id #uuid "9ec94188-6813-5936-86cf-407d3aeba782" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,-16)$, radius: $9$" :db/id #edb/ref 17592186273757} {:answer/id #uuid "d2821275-2b44-5eeb-9dc9-d2ff75e28638" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(16,-4)$, radius: $3$" :db/id #edb/ref 17592186274229}] :answer-field/correct {:answer/id #uuid "12254c34-d106-50c3-9752-79d32d890482" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-16)$, radius: $3$" :db/id #edb/ref 17592186272551} :answer-field/id #uuid "a7fbe651-7ac3-54c8-a95d-1cb5cacd8cd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274933}] :question/id #uuid "e36475b5-c463-5282-90ad-e1d579720252" :question/math-academy-id "q-15461" :question/problem "Find the center and radius of the circle whose equation is $8x+32y+{y}^{2}=-263-{x}^{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+32y+{y}^{2} & =-263-{x}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}+32y) & =-263 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}+2\\cdot 16y+{16}^{2}) & =-263+{4}^{2}+{16}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}+2\\cdot 16y+{16}^{2}) & =9\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y+16)^{2} & ={3}^{2} \\\\ (x-(-4))^{2}+(y-(-16))^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-4,-16)$ and its radius is $3.$"} {:db/id #edb/ref 17592186275330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a8b464f-a745-52e7-91ac-bd4ce713ef33" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186273722} {:answer/id #uuid "9bac1bca-1a7c-516f-8ec8-2ff395b49a60" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,3)$, radius: $4$" :db/id #edb/ref 17592186273735} {:answer/id #uuid "b13ca8a9-fd5e-51c8-a5cb-c5ca2dfa49f1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,12)$, radius: $4$" :db/id #edb/ref 17592186273919} {:answer/id #uuid "d045b16a-1d8f-5a3b-8110-8d687915aeb3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-12,-3)$, radius: $4$" :db/id #edb/ref 17592186274203} {:answer/id #uuid "d66f36ff-0fff-5894-9d3c-b446842d10fc" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,12)$, radius: $4$" :db/id #edb/ref 17592186274263}] :answer-field/correct {:answer/id #uuid "9a8b464f-a745-52e7-91ac-bd4ce713ef33" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186273722} :answer-field/id #uuid "86fce999-c7ca-52b3-8d85-32bc2f1e7d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274865}] :question/id #uuid "84046c7c-9cac-5307-98eb-a99f84787582" :question/math-academy-id "q-15468" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-24x+{y}^{2}+6y=-137.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}-24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-12)^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(12,-3)$ and its radius is $4.$"} {:db/id #edb/ref 17592186332885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a059e00-1c54-560a-a137-62e345ab3ed6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,2)$, radius: $21$" :db/id #edb/ref 17592186330174} {:answer/id #uuid "400bb2ff-8d48-5124-8fb6-c48fab926b3b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,-4)$, radius: $6$" :db/id #edb/ref 17592186330519} {:answer/id #uuid "9048d15d-30fc-5bfe-a3ee-324a2e99cc12" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-2)$, radius: $5$" :db/id #edb/ref 17592186331235} {:answer/id #uuid "f87774bf-a18e-5eb0-8a63-9edbb1bb222f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $5$" :db/id #edb/ref 17592186332134} {:answer/id #uuid "fc9ae8be-ab85-53d2-b8c7-be18b4c1ea94" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,0)$, radius: $4$" :db/id #edb/ref 17592186332170}] :answer-field/correct {:answer/id #uuid "9048d15d-30fc-5bfe-a3ee-324a2e99cc12" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-2)$, radius: $5$" :db/id #edb/ref 17592186331235} :answer-field/id #uuid "9a00cd77-6a89-5461-8ad5-65d1e312fb5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332472}] :question/id #uuid "91f8002c-f831-574b-9cf3-5f411386972a" :question/math-academy-id "q-5180" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}+4y=20.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2}+4y & =20 \\\\ ({x}^{2}+2x)+({y}^{2}+4y) & =20 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =20+{1}^{2}+{2}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+2)^{2} & ={5}^{2} \\\\ (x-(-1))^{2}+(y-(-2))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-2)$ and its radius is $5.$"} {:db/id #edb/ref 17592186332886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176ddd7f-9a57-536e-a807-4c906195114b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $2$" :db/id #edb/ref 17592186330149} {:answer/id #uuid "1ee7a7ed-6f53-53bd-9bdd-8ec2e91c4c85" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-4)$, radius: $2$" :db/id #edb/ref 17592186330217} {:answer/id #uuid "619ff9d0-e9e5-5056-8b0a-90fdb6b945f2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,2)$, radius: $2$" :db/id #edb/ref 17592186330818} {:answer/id #uuid "eeb5a922-43ae-5b5d-8e24-655207b10151" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,-2)$, radius: $4$" :db/id #edb/ref 17592186332046} {:answer/id #uuid "f1d830f6-72c6-576c-879a-5ddae8aa3d02" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $4$" :db/id #edb/ref 17592186332077}] :answer-field/correct {:answer/id #uuid "176ddd7f-9a57-536e-a807-4c906195114b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $2$" :db/id #edb/ref 17592186330149} :answer-field/id #uuid "39f3c35a-e113-58ee-8b08-7ccd598e4a61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332297}] :question/id #uuid "5be17a09-3c27-5dbe-9de9-807433ca0ec5" :question/math-academy-id "q-5191" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-10x+{y}^{2}+4y+25=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-10x+{y}^{2}+4y+25 & =0 \\\\ ({x}^{2}-10x)+({y}^{2}+4y) & =-25 \\\\ ({x}^{2}-2\\cdot 5x+{5}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-25+{5}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 5x+25)+({y}^{2}+2\\cdot 2y+4) & =4\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-5)^{2}+(y+2)^{2} & =4 \\\\ (x-5)^{2}+(y-(-2))^{2} & ={2}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(5,-2)$ and its radius is $2.$"} {:db/id #edb/ref 17592186332887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016bd8a5-abd8-5354-80f9-38c013c39b91" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $1$" :db/id #edb/ref 17592186329968} {:answer/id #uuid "07ad90a4-ac08-5afa-9661-e5a9abc3e146" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $4$" :db/id #edb/ref 17592186330017} {:answer/id #uuid "28f64589-7792-5e8a-b391-9a77d8f38ef5" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $2$" :db/id #edb/ref 17592186330313} {:answer/id #uuid "92032485-fdff-509d-8a9a-8fdda7f20892" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,1)$, radius: $1$" :db/id #edb/ref 17592186331249} {:answer/id #uuid "f6ded878-f69f-5487-9bca-4c3881797f5b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,1)$, radius: $1$" :db/id #edb/ref 17592186332116}] :answer-field/correct {:answer/id #uuid "016bd8a5-abd8-5354-80f9-38c013c39b91" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $1$" :db/id #edb/ref 17592186329968} :answer-field/id #uuid "31b19540-af5a-5a95-96b6-272bfaacc68b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332284}] :question/id #uuid "60af35f6-a00c-5c3c-8627-3517ea92b882" :question/math-academy-id "q-5194" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+2y+{y}^{2}+1=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+2y+{y}^{2}+1 & =0 \\\\ ({x}^{2}+2x)+({y}^{2}+2y) & =-1 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =-1+{1}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+1)^{2} & ={1}^{2} \\\\ (x-(-1))^{2}+(y-(-1))^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-1)$ and its radius is $1.$"} {:db/id #edb/ref 17592186396073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e6273a-f318-5c34-a052-af10236b8229" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,5)$, radius: $3$" :db/id #edb/ref 17592186396075} {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396076} {:answer/id #uuid "c6be1a14-c6c9-582a-8aa6-d933eeef50a8" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-1)$, radius: $7$" :db/id #edb/ref 17592186396077} {:answer/id #uuid "ecbea558-c9ab-5f89-80f4-8cdcb2e0f681" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,1)$, radius: $4$" :db/id #edb/ref 17592186396078} {:answer/id #uuid "91bca4ac-a533-50cd-b79b-78e54b58a746" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-5)$, radius: $9$" :db/id #edb/ref 17592186396079}] :answer-field/correct {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396076} :answer-field/id #uuid "de4e6f08-aad0-5add-9bc8-7a4631ad1e27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396074}] :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$"} {:db/id #edb/ref 17592186396100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da01d3e1-9120-5411-866d-68f2c61e8b78" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $7$" :db/id #edb/ref 17592186396102} {:answer/id #uuid "7347a868-a565-5dcd-9bc6-dcb157568620" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $8$" :db/id #edb/ref 17592186396103} {:answer/id #uuid "4a914338-4d65-53bf-b781-37800f0d7a7e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $4$" :db/id #edb/ref 17592186396104} {:answer/id #uuid "ebef622a-7402-5186-b9c9-cdb47181e259" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $8$" :db/id #edb/ref 17592186396105} {:answer/id #uuid "dff6112c-7516-520a-ad8d-0c891d4eb56c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186396106}] :answer-field/correct {:answer/id #uuid "dff6112c-7516-520a-ad8d-0c891d4eb56c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186396106} :answer-field/id #uuid "f7cc307e-c24b-55cb-bd12-ec807df438fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396101}] :question/id #uuid "6ac8461a-29d0-5698-901e-84a35dae5276" :question/math-academy-id "q-5183" :question/problem "Find the center and radius of the circle whose equation is ${y}^{2}-8x-10y+{x}^{2}=8.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}-8x-10y+{x}^{2} & =8 \\\\ ({x}^{2}-8x)+({y}^{2}-10y) & =8 \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =8+{4}^{2}+{5}^{2} \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-4)^{2}+(y-5)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(4,5)$ and its radius is $7.$"} {:db/id #edb/ref 17592186432243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4c2640-0a36-56ec-af1b-fcad7796bf52" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,0)$, radius: $4$" :db/id #edb/ref 17592186432205} {:answer/id #uuid "4b6a21d8-b231-54b8-835d-bbc866e009e3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-2)$, radius: $4$" :db/id #edb/ref 17592186432206} {:answer/id #uuid "9ce3603d-5b4a-5dda-a1c9-233c3000b216" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,0)$, radius: $4$" :db/id #edb/ref 17592186432220} {:answer/id #uuid "edcde0e6-477c-5745-bf5a-2a31b797aad2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,2)$, radius: $4$" :db/id #edb/ref 17592186432232} {:answer/id #uuid "fabd3cfd-ff6d-5a4a-a418-e152dd3aff14" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $4$" :db/id #edb/ref 17592186432233}] :answer-field/correct {:answer/id #uuid "4b6a21d8-b231-54b8-835d-bbc866e009e3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-2)$, radius: $4$" :db/id #edb/ref 17592186432206} :answer-field/id #uuid "0a922d1e-3efd-542e-bef1-bfc418bd95bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432235}] :question/id #uuid "1da6dc7e-65e3-5087-87df-4fd7079a93cd" :question/math-academy-id "q-15464" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4y=12.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4y & =12 \\\\ {x}^{2}+({y}^{2}+4y) & =12 \\\\ {x}^{2}+({y}^{2}+2\\cdot 2y+{2}^{2}) & =12+{2}^{2} \\\\ {x}^{2}+({y}^{2}+2\\cdot 2y+{2}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-0)^{2}+(y+2)^{2} & ={4}^{2} \\\\ (x-0)^{2}+(y-(-2))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,-2)$ and its radius is $4.$"} {:db/id #edb/ref 17592186432244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154e2e8b-b004-5fd6-a8af-0795c8960483" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-1)$, radius: $9$" :db/id #edb/ref 17592186432201} {:answer/id #uuid "7e4b8669-6cf3-5213-ae28-795579f30a2a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,0)$, radius: $4$" :db/id #edb/ref 17592186432213} {:answer/id #uuid "81717722-81c3-5f14-8952-c1d23e5092e1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,1)$, radius: $7$" :db/id #edb/ref 17592186432214} {:answer/id #uuid "e0870e71-30f3-54e9-bb11-425115745529" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $9$" :db/id #edb/ref 17592186432230} {:answer/id #uuid "e800b37d-a48c-5fa3-b18c-a1c109867cd2" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,1)$, radius: $9$" :db/id #edb/ref 17592186432231}] :answer-field/correct {:answer/id #uuid "e0870e71-30f3-54e9-bb11-425115745529" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $9$" :db/id #edb/ref 17592186432230} :answer-field/id #uuid "475d7cd0-eeb5-57a4-b7c2-c1eef8977b26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432237}] :question/id #uuid "3d51e7e2-42da-5029-94ba-a383fb96ca48" :question/math-academy-id "q-15466" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-2x+{y}^{2}=80.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-2x+{y}^{2} & =80 \\\\ ({x}^{2}-2x)+{y}^{2} & =80 \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+{y}^{2} & =80+{1}^{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+{y}^{2} & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & ={9}^{2} \\\\ (x-1)^{2}+(y-0)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,0)$ and its radius is $9.$"} {:db/id #edb/ref 17592186432245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $11$" :db/id #edb/ref 17592186432200} {:answer/id #uuid "16f43589-ba4b-5fe3-b651-27dcee807b31" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-12,-16)$, radius: $21$" :db/id #edb/ref 17592186432202} {:answer/id #uuid "9896f873-fcd7-5d43-8b83-249941df2b11" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $21$" :db/id #edb/ref 17592186432219} {:answer/id #uuid "cd5d7134-54b8-5fbc-9070-2f312605b654" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,16)$, radius: $21$" :db/id #edb/ref 17592186432225} {:answer/id #uuid "d87ebf8c-3a5e-53cb-b9ad-7e52233c6175" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-6,-8)$, radius: $11$" :db/id #edb/ref 17592186432229}] :answer-field/correct {:answer/id #uuid "0d6171a8-6197-560d-8edc-2b5e80c6ce81" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(6,8)$, radius: $11$" :db/id #edb/ref 17592186432200} :answer-field/id #uuid "6620afbd-acc2-572e-82fa-fe544bca1ecb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432239}] :question/id #uuid "81e4046d-ee12-5213-9139-6081d308b0b9" :question/math-academy-id "q-5182" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-12x+{y}^{2}-16y-21=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-12x+{y}^{2}-16y-21 & =0 \\\\ {x}^{2}-12x+{y}^{2}-16y & =21 \\\\ ({x}^{2}-2\\cdot 6x+{6}^{2})+({y}^{2}-2\\cdot 8y+{8}^{2}) & =21+{6}^{2}+{8}^{2} \\\\ ({x}^{2}-2\\cdot 6x+{6}^{2})+({y}^{2}-2\\cdot 8y+{8}^{2}) & =121\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-6)^{2}+(y-8)^{2} & ={11}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(6,8)$ and its radius is $11.$"} {:db/id #edb/ref 17592186432246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "582731db-ea16-5d66-9090-5f57ae7fd64d" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,2),$ radius: $1$" :db/id #edb/ref 17592186432207} {:answer/id #uuid "648f4194-fec8-5e9c-87af-4fb442b8ea1e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $\\sqrt{2}$" :db/id #edb/ref 17592186432209} {:answer/id #uuid "6c5d401c-bb61-5f85-be78-864bd3556574" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $1$" :db/id #edb/ref 17592186432210} {:answer/id #uuid "6d9f2f63-2b6c-5173-96ad-fa3cefcebd64" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $2$" :db/id #edb/ref 17592186432211} {:answer/id #uuid "76607376-556e-5250-8ef1-e96ff909028c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,2),$ radius: $\\sqrt{2}$" :db/id #edb/ref 17592186432212}] :answer-field/correct {:answer/id #uuid "6c5d401c-bb61-5f85-be78-864bd3556574" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,1),$ radius: $1$" :db/id #edb/ref 17592186432210} :answer-field/id #uuid "2f7be69d-ef52-5421-abfe-89f073f68500" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432236}] :question/id #uuid "f5b1b8a2-d088-51d1-b8fc-6a7c6d262461" :question/math-academy-id "q-54216" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-4x+{y}^{2}-2y=-4.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-4x+{y}^{2}-2y & =-4 \\\\ ({x}^{2}-4x)+({y}^{2}-2y) & =-4 \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =-4+{2}^{2}+{1}^{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-1)^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,1)$ and its radius is $1.$"} {:db/id #edb/ref 17592186498575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27785dc6-76a3-5a5d-b8dd-d445c16c7768" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,3)$, radius: $2$" :db/id #edb/ref 17592186497879} {:answer/id #uuid "40c67b67-6b96-5400-842b-51fa742b9835" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,3)$, radius: $4$" :db/id #edb/ref 17592186497943} {:answer/id #uuid "4ace6e36-b1ef-56ec-a5a0-deceabb0e4e6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,0)$, radius: $49$" :db/id #edb/ref 17592186497972} {:answer/id #uuid "af981369-ab02-50f9-9b99-0a675cccf17c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,0)$, radius: $7$" :db/id #edb/ref 17592186498190} {:answer/id #uuid "b012dc73-db2e-5d6d-9fda-ff683299fa06" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-3)$, radius: $7$" :db/id #edb/ref 17592186498191}] :answer-field/correct {:answer/id #uuid "af981369-ab02-50f9-9b99-0a675cccf17c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,0)$, radius: $7$" :db/id #edb/ref 17592186498190} :answer-field/id #uuid "c8afdf75-273f-54be-a69f-223bfb905f12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498457}] :question/id #uuid "ba829ff8-bbca-5643-baef-27f89f8dddf9" :question/math-academy-id "q-5192" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+6x+{y}^{2}=40.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+6x+{y}^{2} & =40 \\\\ ({x}^{2}+6x)+{y}^{2} & =40 \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =40+{3}^{2} \\\\ ({x}^{2}+2\\cdot 3x+{3}^{2})+{y}^{2} & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-0)^{2} & ={7}^{2} \\\\ (x-(-3))^{2}+(y-0)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-3,0)$ and its radius is $7.$"}] :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"} :step/id #uuid "da3fbfb0-744f-5f91-919e-01f09b8883ea" :step/next {:db/id #edb/ref 17592186079241}} {:db/id #edb/ref 17592186079241 :step/content {:db/id #edb/ref 17592186078391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078248 :question/id #uuid "b05d1090-fd7b-52eb-84a7-55377ead0dda" :question/math-academy-id "e-3229" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - x  = 6.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-x & =6 \\\\ ({x}^{2}-x)+{y}^{2} & =6 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =6+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+{y}^{2} & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{y}^{2} & ={(\\frac{5}{2})}^{2} \\\\ {(x-\\frac{1}{2})}^{2}+(y-0)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $\\left(\\dfrac{1}{2}, 0 \\right)$ and its radius is $\\dfrac{5}{2}.$"} :knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/questions [{:db/id #edb/ref 17592186079067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267fe552-82a1-5d5a-82b0-0aceb8f8f45a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186330284} {:answer/id #uuid "4aca5a42-8f1f-5417-93c5-329b30814c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186330627} {:answer/id #uuid "86ae4ca7-99be-533c-aff8-15ae23e11015" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{3}{2})$, radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186331149} {:answer/id #uuid "a60ce9b1-fb56-514a-a47c-599fbf677b89" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186331434} {:answer/id #uuid "bdd8529d-f61d-5275-90a7-de3e8de6bb28" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{9}{4})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186331630}] :answer-field/correct {:answer/id #uuid "4aca5a42-8f1f-5417-93c5-329b30814c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186330627} :answer-field/id #uuid "1832e439-01f1-55f8-90bf-4daf38dc31b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332231}] :question/id #uuid "369014bc-22e5-503d-91de-63ec87d81ac8" :question/math-academy-id "q-5195" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3y & =0 \\\\ {x}^{2}+({y}^{2}-3y) & =0 \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & ={(\\frac{3}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{3}{2})$ and its radius is $\\frac{3}{2}.$"} {:db/id #edb/ref 17592186079203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a24aa32-be27-5a08-b7f2-3b7687162fe7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},1),$ radius: $\\frac{25}{4}$" :db/id #edb/ref 17592186432208} {:answer/id #uuid "8a69426e-541f-5455-a730-43f891fdd05a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},-1),$ radius: $3$" :db/id #edb/ref 17592186432216} {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} {:answer/id #uuid "b7212f1a-369b-508d-af5b-02c25936336a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},-1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186432221} {:answer/id #uuid "cafaa4da-7864-5748-8e08-e8893dc4bdbd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186432224}] :answer-field/correct {:answer/id #uuid "8d2cea3d-9511-52f8-ba35-37514aa28e6b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},1),$ radius: $3$" :db/id #edb/ref 17592186432217} :answer-field/id #uuid "0135309d-4571-5e4f-b373-ceb7b0682c4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077996}] :question/id #uuid "7f67332a-d49b-5dc7-b92a-6be6456a8b20" :question/math-academy-id "q-76089" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+5x+{y}^{2}-2y=\\frac{7}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+5x+{y}^{2}-2y & =\\frac{7}{4} \\\\ ({x}^{2}+5x)+({y}^{2}-2y) & =\\frac{7}{4} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =\\frac{7}{4}+{(\\frac{5}{2})}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot 1y+{1}^{2}) & =9.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+(y-1)^{2} & ={3}^{2} \\\\ {(x-(-\\frac{5}{2}))}^{2}+(y-1)^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},1)$ and its radius is $3.$"} {:db/id #edb/ref 17592186238070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} {:answer/id #uuid "a348d55a-36a9-5af2-81e6-6f7585bd95e1"