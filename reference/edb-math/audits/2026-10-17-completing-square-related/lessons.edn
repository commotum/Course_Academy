 17592186253518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31eae523-b822-58ad-84b8-24a8c8c517c6" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186250975} {:answer/id #uuid "4f2b65f9-7449-55b0-b80f-012392fc3d56" :answer/type {:db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186251201} {:answer/id #uuid "9304e5c4-e8bb-560d-b6cf-ca604dd5c635" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186251811} {:answer/id #uuid "b05869f6-7a5a-5965-a848-de17c17b0be9" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186252092} {:answer/id #uuid "c38579e0-e067-5179-a6d6-769ac12fe71c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186252282}] :answer-field/correct {:answer/id #uuid "c38579e0-e067-5179-a6d6-769ac12fe71c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186252282} :answer-field/id #uuid "5ff0b7d9-f9c5-51c2-b17a-cf4bb084169d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252977}] :question/id #uuid "75271eed-aac2-5e60-97ce-6705a0cbc81a" :question/math-academy-id "q-11884" :question/problem "Calculate the coordinates of the vertex of the parabola $3{x}^{2}-30x-8y+67=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-30x-8y+67 & =0 \\\\ 3{x}^{2}-30x & =8y-67 \\\\ 3[{x}^{2}-10x] & =8y-67 \\\\ 3[(x-5)^{2}-25] & =8y-67 \\\\ 3(x-5)^{2}-75 & =8y-67 \\\\ 3(x-5)^{2} & =8y-67+75 \\\\ 3(x-5)^{2} & =8y+8 \\\\ 3(x-5)^{2} & =8(y+1) \\\\ (x-5)^{2} & =\\frac{8}{3}(y+1) \\\\ (x-5)^{2} & =4(\\frac{2}{3})(y+1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,-1).$"} {:db/id #edb/ref 17592186354395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f1cb4b5-261a-5efa-8fcc-b76cdafe1ee0" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186352280} {:answer/id #uuid "8acf1963-92c0-55e3-aa51-d43affedb635" :answer/type {:db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186352777} {:answer/id #uuid "ce7f71fc-878d-5676-871b-bb5cabb8d391" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186353357} {:answer/id #uuid "d39bcc56-0980-5cb4-b448-a9671f6b0415" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186353396} {:answer/id #uuid "f2dbb5f9-92f2-56b2-a6b4-72324c06d821" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,4)" :db/id #edb/ref 17592186353688}] :answer-field/correct {:answer/id #uuid "ce7f71fc-878d-5676-871b-bb5cabb8d391" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186353357} :answer-field/id #uuid "410a20de-5c8a-58e2-97be-dbf3cd158570" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353928}] :question/id #uuid "2b03beb9-8f72-5245-9a15-2a9bcfedfa5d" :question/math-academy-id "q-85080" :question/problem "Calculate the coordinates of the vertex of the parabola $5{x}^{2}+30x+2y+41=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}+30x+2y+41 & =0 \\\\ 5{x}^{2}+30x & =-2y-41 \\\\ 5[{x}^{2}+6x] & =-2y-41 \\\\ 5[(x+3)^{2}-9] & =-2y-41 \\\\ 5(x+3)^{2}-45 & =-2y-41 \\\\ 5(x+3)^{2} & =-2y-41+45 \\\\ 5(x+3)^{2} & =-2y+4 \\\\ 5(x+3)^{2} & =-2(y-2) \\\\ (x+3)^{2} & =-\\frac{2}{5}(y-2) \\\\ (x+3)^{2} & =4(-\\frac{1}{10})(y-2)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-3,2).$"}] :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :topic/title "Calculating the Vertex of a Parabola by Completing the Square"} {:activity/first-step {:db/id #edb/ref 17592186172873} :activity/id #uuid "24730412-55e7-557a-aff1-e9e75d633ee0" :activity/steps [{:db/id #edb/ref 17592186172767 :step/content {:db/id #edb/ref 17592186171959 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171811 :question/id #uuid "ef170346-47b1-5ce7-a99d-070021b3fb81" :question/math-academy-id "e-5344" :question/problem "Calculate the coordinates of the vertex of the parabola $y^2 - 8x - 6y + 33 = 0$." :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x-6y+33 & =0 \\\\ {y}^{2}-6y & =8x-33 \\\\ (y-3)^{2}-9 & =8x-33 \\\\ (y-3)^{2} & =8x-33+9 \\\\ (y-3)^{2} & =8x-24 \\\\ (y-3)^{2} & =8(x-3) \\\\ (y-3)^{2} & =4(2)(x-3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (3,3).$"} :knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/questions [{:db/id #edb/ref 17592186172271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfdd7c95-7b36-5988-b4cc-63678946ae29" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-2)" :db/id #edb/ref 17592186168490} {:answer/id #uuid "ebe021f1-949f-5746-b6f9-8a1d81b64a29" :answer/type {:db/ident :answer.type/math} :answer/value "(-2, 4)" :db/id #edb/ref 17592186168491} {:answer/id #uuid "07d821ce-acfb-5