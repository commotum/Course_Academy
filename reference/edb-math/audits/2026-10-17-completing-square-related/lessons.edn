qrt{34} \\\\ a+4 & =\\pm \\sqrt{34} \\\\ a & =-4\\pm \\sqrt{34}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} {:answer/id #uuid "49bc3a1b-22cf-5a66-a6c0-83bfe3292149" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-45" :db/id #edb/ref 17592186263634} {:answer/id #uuid "884cd699-7583-5968-ae5f-5297ccb1d1f9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-50" :db/id #edb/ref 17592186264178} {:answer/id #uuid "8ad3250f-b580-5861-a4c8-475bce8d9d0c" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=45" :db/id #edb/ref 17592186264188} {:answer/id #uuid "9c4347fb-3578-5e6a-b949-5f25952eb680" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=50" :db/id #edb/ref 17592186264338}] :answer-field/correct {:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} :answer-field/id #uuid "a7460a0f-9af3-55d8-9183-7f36516a5325" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265545}] :question/id #uuid "b2094d9e-dc94-52c2-adb6-43e9a1505bb1" :question/math-academy-id "q-12995" :question/problem "The equation ${z}^{2}-25=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-25 & =-10z \\\\ {z}^{2}+10z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2}-{5}^{2} & =25\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2} & =50\\end{aligned}\n$$\n\nSo, $p=5,q=50,$ and $p+q=55.$"} {:db/id #edb/ref 17592186290360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de29281-923d-5c13-81c6-8e7785fa0cb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186288981}] :answer-field/correct {:answer/id #uuid "8de29281-923d-5c13-81c6-8e7785fa0cb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186288981} :answer-field/id #uuid "3d2c6dac-2ac4-5512-a317-c39c5bb58844" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289863} {:answer-field/choices [{:answer/id #uuid "08c80b97-dd13-59cf-86fa-1becb3caf9d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288098}] :answer-field/correct {:answer/id #uuid "08c80b97-dd13-59cf-86fa-1becb3caf9d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288098} :answer-field/id #uuid "77bd53f0-18ae-5e39-bf99-8b07ee076ca3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289991} {:answer-field/choices [{:answer/id #uuid "0e03fbeb-fbc4-56a4-8b12-bf3188d05dac" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288132}] :answer-field/correct {:answer/id #uuid "0e03fbeb-fbc4-56a4-8b12-bf3188d05dac" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288132} :answer-field/id #uuid "b82afa5d-68f9-55e0-acca-52a6b15bdc7b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290131} {:answer-field/choices [{:answer/id #uuid "be3398a9-2294-5454-a14a-ea4a047a3b54" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289283}] :answer-field/correct {:answer/id #uuid "be3398a9-2294-5454-a14a-ea4a047a3b54" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289283} :answer-field/id #uuid "dd9c8eb3-8509-5c9d-845e-9e9e73b368cb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290202}] :question/id #uuid "d3ba39a5-e7a4-5a6a-9c2d-3395582bfc87" :question/math-academy-id "q-218771" :question/problem "The equation ${x}^{2}+8x+9=0$ is equivalent to$\\,(x\\,\\,+$\n{{field-1}}\n$)^{2}=$\n{{field-2}}, and the solutions are \n\n$x=$\n{{field-3}}\n$\\pm $\n{{field-4}}." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x+9 & =0 \\\\ {x}^{2}+8x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =-9 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =-9 \\\\ (x+4)^{2}-16 & =-9\\end{aligned}\n$$\n\nNow, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =-9 \\\\ (x+4)^{2} & =-9+16 \\\\ (x+4)^{2} & =7\\end{aligned}\n$$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =7 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{7} \\\\ x+4 & =\\pm \\sqrt{7} \\\\ x & =-4\\pm \\sqrt{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029fa0e3-dd36-5f3b-83ad-2cba2e31a6df" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=20" :db/id #edb/ref 17592186351588} {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} {:answer/id #uuid "371907b8-8d3b-547a-9416-21dcd94a96bf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=36" :db/id #edb/ref 17592186352079} {:answer/id #uuid "64af757f-a5f5-5de8-9518-714b14936255" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-16" :db/id #edb/ref 17592186352457} {:answer/id #uuid "67a3e342-6a19-5ca4-9745-f0c27bfd5f69" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186352490}] :answer-field/correct {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} :answer-field/id #uuid "6b5c2324-629b-5b3c-99c4-45b9f2afb50e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354016}] :question/id #uuid "6913ef2e-5530-525b-8ba5-681a643ef5b4" :question/math-academy-id "q-86404" :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$"} {:db/id #edb/ref 17592186399746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} {:answer/id #uuid "015db316-4ebb-5b1d-99f9-48da4423ea95" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=-2\\pm \\sqrt{2}" :db/id #edb/ref 17592186399749} {:answer/id #uuid "6bce9687-7b54-57ab-bfdf-8d118e548ef3" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=8,\\,m=4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399750} {:answer/id #uuid "b47af5b9-db68-5705-87ff-a810d0b94396" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399751} {:answer/id #uuid "51890425-293e-58e0-898f-8746f49fa609" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=14,\\,m=-4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399752}] :answer-field/correct {:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} :answer-field/id #uuid "1d4fba57-c484-5fd0-a729-550a53e648f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399747}] :question/id #uuid "6d70e8a4-cad6-5c6f-b225-88fe32f8d423" :question/math-academy-id "q-112487" :question/problem "The equation ${m}^{2}+8=-8m$ can be written in the form $(m+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-8m$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{m}^{2}+8 & =-8m \\\\ {m}^{2}+8m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m+{4}^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2}-{4}^{2} & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(m+4)^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2} & =8\\end{aligned}\n$$\n\nSo, $p=4,q=8,$ and $p+q=12.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(m+4)^{2} & =8 \\\\ \\sqrt{(m+4)^{2}} & =\\sqrt{8} \\\\ |m+4| & =\\sqrt{8} \\\\ m+4 & =\\pm 2\\sqrt{2} \\\\ m & =-4\\pm 2\\sqrt{2}\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :topic/title "Solving Quadratic Equations by Completing the Square"} {:activity/first-step {:db/id #edb/ref 17592186069810} :activity/id #uuid "99962a72-c007-5476-af19-a4bae9a29c12" :activity/steps [{:db/id #edb/ref 17592186069763 :step/content {:db/id #edb/ref 17592186068827 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068431 :question/id #uuid "369ac89b-e838-5929-ba71-d74b3b06445b" :question/math-academy-id "e-10013" :question/problem "Solve the equation $x^2 -10x = -24.$ \n\n*Hint: Use the fact that $x^2 -10x +25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\nx^2 -10x +25 = (x-5)^2.\n$$\n\nFirst, we complete the square on the left-hand side: \n\n$$\n\\begin{aligned}{x}^{2}-10x & =-24 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-24 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-24 \\\\ (x-5{)}^{2}-25 & =-24\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides:\n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-24+25 \\\\ (x-5{)}^{2} & =1\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =1 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{1} \\\\ |x-5| & =1 \\\\ x-5 & =\\pm 1 \\\\ x & =5\\pm 1\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-1=4 \\\\ {x}_{2} & =5+1=6\\end{aligned}\n$$"} :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/questions [{:db/id #edb/ref 17592186069058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb049e4-2d6a-53f4-89ef-727b1f44786d" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186269526} {:answer/id #uuid "5281b7d1-827c-5450-a602-8f82b0212c0f" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186270002} {:answer/id #uuid "5963221b-56d4-5bb5-9de0-d52a55fb961d" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186270060} {:answer/id #uuid "636bbdf2-a9f9-561c-844f-cd6a4abfec1a" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270149} {:answer/id #uuid "865ad5c6-da5f-5b28-b9b0-578811ac4cf0" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186270435}] :answer-field/correct {:answer/id #uuid "636bbdf2-a9f9-561c-844f-cd6a4abfec1a" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270149} :answer-field/id #uuid "af1acbd6-2a93-5981-b55f-6320a360fab4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271826}] :question/id #uuid "22f36eaf-d2b6-5e47-8cc3-19f122968355" :question/math-academy-id "q-141624" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-2x=24.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-2x+1$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-2x+1=(x-1{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x & =24 \\\\ {x}^{2}-2\\cdot 1\\cdot x & =24 \\\\ {x}^{2}-2\\cdot 1\\cdot x+{1}^{2}-{1}^{2} & =24 \\\\ (x-1{)}^{2}-1 & =24\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $1$ to both sides:\n\n$$\n\\begin{aligned}(x-1{)}^{2}-1+1 & =24+1 \\\\ (x-1{)}^{2} & =25\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1{)}^{2} & =25 \\\\ \\sqrt{(x-1{)}^{2}} & =\\sqrt{25} \\\\ |x-1| & =5 \\\\ x-1 & =\\pm 5 \\\\ x & =1\\pm 5\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-5=-4 \\\\ {x}_{2} & =1+5=6\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-4{)}^{2}+{6}^{2}=52.\n$$"} {:db/id #edb/ref 17592186069059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2155671-02ec-5263-acff-34cdcbf46499" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186065788} {:answer/id #uuid "d6f86767-1392-5d7f-b9e6-d715768d1626" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186065789} {:answer/id #uuid "1152c70a-6e2f-5dfd-92d5-a6aa8e983d48" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186065790} {:answer/id #uuid "2b29fe64-850d-56a1-9097-934a93dbeb78" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186065791} {:answer/id #uuid "685732fa-9799-5dea-883f-231dd25af0e6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186065792}] :answer-field/id #uuid "bc1fa481-6edc-507e-a3a3-a41fcde3404a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065787}] :question/id #uuid "04bfa8b3-99fd-5776-81af-4e198c44664c" :question/math-academy-id "q-141797" :question/problem "Let $x_{1}$ and $x_{2}$ be the solutions of the equation $x^{2} + 2x = 3$. Find the value $x_{1}^{2} + x_{2}^{2}$.\n\n*Hint: Use the fact that $x^{2} + 2x + 1$ is a perfect square.*"} {:db/id #edb/ref 17592186272308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119f1823-d83a-5061-b5eb-92bb90522a4b" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186269425} {:answer/id #uuid "544d44e9-7ecc-53cf-ad84-d2fed0c218a6" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186270020} {:answer/id #uuid "5a96cedc-2a2a-58fa-953b-6f50f65a7f5c" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270074} {:answer/id #uuid "71a6d5fd-23c8-5a68-8775-1b1848554df3" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186270277} {:answer/id #uuid "955ae8b4-32ed-581b-aeb7-5c9d32b5e6ce" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186270578}] :answer-field/correct {:answer/id #uuid "5a96cedc-2a2a-58fa-953b-6f50f65a7f5c" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270074} :answer-field/id #uuid "a5c85f94-4ff5-5915-8e56-6cb0ed5b029f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271811}] :question/id #uuid "1b9295ce-b641-57bd-b519-585112fb257f" :question/math-academy-id "q-141804" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}+4x=12.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}+4x+4$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}+4x+4=(x+2{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x & =12 \\\\ {x}^{2}+2\\cdot 2\\cdot x & =12 \\\\ {x}^{2}+2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =12 \\\\ (x+2{)}^{2}-4 & =12\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $4$ to both sides:\n\n$$\n\\begin{aligned}(x+2{)}^{2}-4+4 & =12+4 \\\\ (x+2{)}^{2} & =16\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+2{)}^{2} & =16 \\\\ \\sqrt{(x+2{)}^{2}} & =\\sqrt{16} \\\\ |x+2| & =4 \\\\ x+2 & =\\pm 4 \\\\ x & =-2\\pm 4\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =-2-4=-6 \\\\ {x}_{2} & =-2+4=2\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-6{)}^{2}+{2}^{2}=40.\n$$"} {:db/id #edb/ref 17592186272309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33162c16-a26a-585b-b93a-caff202d8543" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186269736} {:answer/id #uuid "472c723c-83ab-5626-ad0b-8949bf5249de" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186269915} {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} {:answer/id #uuid "dbafdf59-1e66-5dce-9f48-65bc473487a2" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186271191} {:answer/id #uuid "f1de299d-a3c5-5ebc-80da-bb0051f2d8ec" :answer/type {:db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186271392}] :answer-field/correct {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} :answer-field/id #uuid "16c6ad9b-646e-5a06-a5b2-bcae2f52ebb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271547}] :question/id #uuid "f0de10d9-8ebd-58e0-b040-9c2f5e59c9c7" :question/math-academy-id "q-141812" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-8x=20.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-8x+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-8x+16=(x-4{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =20 \\\\ (x-4{)}^{2}-16 & =20\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $16$ to both sides:\n\n$$\n\\begin{aligned}(x-4{)}^{2}-16+16 & =20+16 \\\\ (x-4{)}^{2} & =36\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4{)}^{2} & =36 \\\\ \\sqrt{(x-4{)}^{2}} & =\\sqrt{36} \\\\ |x-4| & =6 \\\\ x-4 & =\\pm 6 \\\\ x & =4\\pm 6\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =4-6=-2 \\\\ {x}_{2} & =4+6=10\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{10}^{2}=104.\n$$"} {:db/id #edb/ref 17592186272320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff5ca07-140b-5d59-98e1-d54b4a779a69" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186269700} {:answer/id #uuid "b5b3e6e3-7a3d-5f35-92f1-92011237f91e" :answer/type {:db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186270883} {:answer/id #uuid "c66afd29-5c1c-5a32-8f20-b20c935cab94" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186271016} {:answer/id #uuid "e8b01e52-5c29-5ac2-8606-b522d8f9a728" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186271299} {:answer/id #uuid "fd97e0c4-2fc1-5eac-89b6-27a7546dff89" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186271488}] :answer-field/correct {:answer/id #uuid "c66afd29-5c1c-5a32-8f20-b20c935cab94" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186271016} :answer-field/id #uuid "65e682be-bb60-559a-8b43-fb7cea076543" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271690}] :question/id #uuid "b9162ac7-236e-5acd-bcca-ee24c2b8f68f" :question/math-academy-id "q-142011" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-6x=16.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-6x+9$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-6x+9=(x-3{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x & =16 \\\\ {x}^{2}-2\\cdot 3\\cdot x & =16 \\\\ {x}^{2}-2\\cdot 3\\cdot x+{3}^{2}-{3}^{2} & =16 \\\\ (x-3{)}^{2}-9 & =16\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $9$ to both sides: \n\n$$\n\\begin{aligned}(x-3{)}^{2}-9+9 & =16+9 \\\\ (x-3{)}^{2} & =25\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3{)}^{2} & =25 \\\\ \\sqrt{(x-3{)}^{2}} & =\\sqrt{25} \\\\ |x-3| & =5 \\\\ x-3 & =\\pm 5 \\\\ x & =3\\pm 5\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =3-5=-2 \\\\ {x}_{2} & =3+5=8\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{8}^{2}=68.\n$$"} {:db/id #edb/ref 17592186272321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08658d01-89d0-5f4d-8f01-ca95f49a8f8e" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186269345} {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} {:answer/id #uuid "b63daf1b-11dc-55f7-bcdf-962180261257" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270887} {:answer/id #uuid "c16cb9a6-c3c8-5125-ae28-f529c2244338" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270983} {:answer/id #uuid "f5121dc9-a221-5173-bccc-27c79eacbf3a" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186271416}] :answer-field/correct {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "3f3ef694-6ed8-54b6-8d68-ea9692dda819" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271625}] :question/id #uuid "36afe386-dcce-5814-bb16-64bd8f39ae6b" :question/math-academy-id "q-142015" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-10x=-21.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-10x+25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-10x+25=(x-5{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-21 \\\\ (x-5{)}^{2}-25 & =-21\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides: \n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-21+25 \\\\ (x-5{)}^{2} & =4\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =4 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{4} \\\\ |x-5| & =2 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-2=3 \\\\ {x}_{2} & =5+2=7\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}={3}^{2}+{7}^{2}=58.\n$$"}] :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"} :step/id #uuid "0dfd2268-0021-5bb4-97d4-fb964fb1dd33" :step/next {:db/id #edb/ref 17592186069814}} {:db/id #edb/ref 17592186069810 :step/content {:db/id #edb/ref 17592186069947 :tutorial/content "We can use the method of completing the square to solve *any* quadratic equation, even if the equation does not factor.\n\nTo illustrate, suppose we want to solve the following equation:\n\n$$\nx^2+2x-8=0\n$$\n\nWe can do so by following the five steps below:\n\n**Step 1.** Move the constant term to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+2x-8 & =0 \\\\ {x}^{2}+2x & =8\\end{aligned}\n$$\n\n**Step 2.** Complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+2x & =8 \\\\ {x}^{2}+2\\cdot 1\\cdot x & =8 \\\\ {x}^{2}+2\\cdot 1\\cdot x+{1}^{2}-{1}^{2} & =8 \\\\ ({x}^{2}+2\\cdot 1\\cdot x+{1}^{2})-1 & =8 \\\\ (x+1)^{2}-1 & =8\\end{aligned}\n$$\n\n**Step 3.** Isolate the perfect square by adding $1$ to both sides. This gives\n\n$$\n\\begin{aligned}(x+1)^{2} & =9.\\end{aligned}\n$$\n\n**Step 4.** We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+1)^{2} & =9 \\\\ \\sqrt{(x+1)^{2}} & =\\sqrt{9} \\\\ |x+1| & =3 \\\\ x+1 & =\\pm 3 \\\\ x & =-1\\pm 3\\end{aligned}\n$$\n\n**Step 5.** Finally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =-1-3=-4 \\\\ {x}_{2} & =-1+3=2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-4$ and $x=2.$" :tutorial/id #uuid "f5c2a281-aa37-55de-831b-f68a8a0fad3e" :tutorial/title "Introduction"} :step/id #uuid "f49815d8-d5fb-5360-b471-c766281b79d4" :step/next {:db/id #edb/ref 17592186069763}} {:db/id #edb/ref 17592186069814 :step/content {:db/id #edb/ref 17592186068860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068498 :question/id #uuid "a0cb3fb6-5ff3-5f4e-9bb9-35c88a22fd34" :question/math-academy-id "e-1431" :question/problem "Write the equation $x^2 + 6x +5= 0$ in the form $(x+p)^2=q,$ and hence solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+6x+5 & =0 \\\\ {x}^{2}+6x & =-5 \\\\ {x}^{2}+2\\cdot 3\\cdot x & =-5 \\\\ {x}^{2}+2\\cdot 3\\cdot x+{3}^{2}-{3}^{2} & =-5 \\\\ ({x}^{2}+2\\cdot 3\\cdot x+{3}^{2})-9 & =-5 \\\\ (x+3{)}^{2}-9 & =-5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+3{)}^{2}-9 & =-5 \\\\ (x+3{)}^{2} & =-5+9 \\\\ (x+3{)}^{2} & =4\\end{aligned}\n$$\n\n \n\nSo, $p=3$ and $q=4.$ Now, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+3{)}^{2} & =4 \\\\ \\sqrt{(x+3{)}^{2}} & =\\sqrt{4} \\\\ |x+3| & =2 \\\\ x+3 & =\\pm 2 \\\\ x & =-3\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =-3+2=-1 \\\\ {x}_{2} & =-3-2=-5\\end{aligned}\n$$"} :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/questions [{:db/id #edb/ref 17592186069217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066485} {:answer/id #uuid "a2710526-3439-5d45-a3cb-b94809df5d4a" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 9, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066486} {:answer/id #uuid "b5eac8af-989a-5812-82cd-e6e80a244860" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} =-4" :db/id #edb/ref 17592186066487} {:answer/id #uuid "cec6266a-38e0-5082-ae2c-0c20a9b251e4" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 6" :db/id #edb/ref 17592186066488} {:answer/id #uuid "d0b0d285-5968-53b9-b5b2-00fcaf5e3048" :answer/type {:db/ident :answer.type/math} :answer/value "p + q =-11x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066489}] :answer-field/id #uuid "d792d360-b68f-53ea-add1-82615c19183b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066484} {:answer-field/choices [{:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} {:answer/id #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=6" :db/id #edb/ref 17592186401957} {:answer/id #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401958} {:answer/id #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186401959} {:answer/id #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401960}] :answer-field/correct {:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} :answer-field/id #uuid "b5fa6494-6274-595a-88b0-e033638de4a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401955}] :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation ${x}^{2}-4x+4=9$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"} {:db/id #edb/ref 17592186069267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0ef2eb-4700-5dce-9571-710931fd498e" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=49,\\,x=-3$ and $x=11$" :db/id #edb/ref 17592186315210} {:answer/id #uuid "1c3d233b-ecc6-5c47-9d51-934dfafa500c" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=53,\\,x=-9$ and $x=3$" :db/id #edb/ref 17592186315284} {:answer/id #uuid "50d6be90-80c2-5b6c-a4b1-5c4bbf022c81" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=49,\\,x=-11$ and $x=3$" :db/id #edb/ref 17592186315579} {:answer/id #uuid "557d20da-8990-5d6f-97ef-e8324200941e" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=53,\\,x=-11$ and $x=3$" :db/id #edb/ref 17592186315608} {:answer/id #uuid "cab874f1-8ebf-5fe9-a20a-6261f2694ff0" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=51,\\,x=-2$ and $x=3$" :db/id #edb/ref 17592186316261}] :answer-field/correct {:answer/id #uuid "557d20da-8990-5d6f-97ef-e8324200941e" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=53,\\,x=-11$ and $x=3$" :db/id #edb/ref 17592186315608} :answer-field/id #uuid "760ecbc1-00e4-5056-ae60-bc55576c3776" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316828}] :question/id #uuid "31f81354-1c7b-50a3-a648-778f85068793" :question/math-academy-id "q-3430" :question/problem "The equation ${x}^{2}+8x-33=0$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x-33 & =0 \\\\ {x}^{2}+8x & =33 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =33 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =33 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =33 \\\\ (x+4)^{2}-16 & =33\\end{aligned}\n$$\n\nThen, we isolate the perfect square and solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =33 \\\\ (x+4)^{2} & =49\\end{aligned}\n$$\n\nSo, $p=4,q=49,$ and $p+q=53.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =49 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{49} \\\\ x+4 & =\\pm 7 \\\\ x & =-4\\pm 7\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-4+7=3 \\\\ x & =-4-7=-11\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-11$ and $x=3.$"} {:db/id #edb/ref 17592186247266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1bcf7d-293f-5d0a-8715-d55eb7ff8501" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=6,\\,x=-4$ and $x=-2$" :db/id #edb/ref 17592186244991} {:answer/id #uuid "70f42828-001d-5e55-a54c-e87e2f878ac7" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=4,\\,x=-6$ and $x=1$" :db/id #edb/ref 17592186245321} {:answer/id #uuid "9cc998e8-57a5-5832-bf9f-e18a53d1c346" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=3,\\,x=-2$ and $x=5$" :db/id #edb/ref 17592186245707} {:answer/id #uuid "b7c4fb0b-3018-5bb0-9ef7-ed3e3f39671e" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=3,\\,x=-6$ and $x=1$" :db/id #edb/ref 17592186245954} {:answer/id #uuid "da5384a6-f89c-5dfc-82d9-ea5cb3b87744" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=4,\\,x=-4$ and $x=-2$" :db/id #edb/ref 17592186246255}] :answer-field/correct {:answer/id #uuid "da5384a6-f89c-5dfc-82d9-ea5cb3b87744" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=4,\\,x=-4$ and $x=-2$" :db/id #edb/ref 17592186246255} :answer-field/id #uuid "6e0b838c-90fa-55f4-a2fe-82f874776ca0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246739}] :question/id #uuid "c2d52179-378c-55d4-a717-499643a64922" :question/math-academy-id "q-112420" :question/problem "The equation ${x}^{2}+6x+8=0$ can be written in the form $(x+p{)}^{2}=q.$ Find $\\,p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+6x+8 & =0 \\\\ {x}^{2}+6x & =-8 \\\\ {x}^{2}+2\\cdot 3\\cdot x & =-8 \\\\ {x}^{2}+2\\cdot 3\\cdot x+{3}^{2}-{3}^{2} & =-8 \\\\ ({x}^{2}+2\\cdot 3\\cdot x+{3}^{2})-9 & =-8 \\\\ (x+3{)}^{2}-9 & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square and solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+3{)}^{2}-9 & =-8 \\\\ (x+3{)}^{2} & =1\\end{aligned}\n$$\n\nSo, $p=3,q=1,$ and $p+q=4.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+3{)}^{2} & =1 \\\\ \\sqrt{(x+3{)}^{2}} & =\\sqrt{1} \\\\ x+3 & =\\pm 1 \\\\ x & =-3\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-3+1=-2 \\\\ x & =-3-1=-4\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-4$ and $x=-2.$"} {:db/id #edb/ref 17592186297258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ca31fd-26f5-555f-939c-7b54b5262086" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=101,\\,x=1$ and $x=11$" :db/id #edb/ref 17592186295669} {:answer/id #uuid "625ecdd1-9080-5efa-a6b3-0baac83cc58f" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=121,\\,x=-1$ and $x=21$" :db/id #edb/ref 17592186295830} {:answer/id #uuid "8017582d-8932-5b22-a5f2-66ff528527da" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=100,\\,x=-11$ and $x=-1$" :db/id #edb/ref 17592186295958} {:answer/id #uuid "e0a163b0-46d8-56ce-a1cc-6dbf51377e75" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=111,\\,x=-1$ and $x=21$" :db/id #edb/ref 17592186296462} {:answer/id #uuid "e2a3e918-ef14-5b5f-b1f2-f38b452c6cd5" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=111,\\,x=-11$ and $x=1$" :db/id #edb/ref 17592186296473}] :answer-field/correct {:answer/id #uuid "e0a163b0-46d8-56ce-a1cc-6dbf51377e75" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=111,\\,x=-1$ and $x=21$" :db/id #edb/ref 17592186296462} :answer-field/id #uuid "8482b996-018f-5010-a15c-fe9017acfbf5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296906}] :question/id #uuid "b44bf3d4-0727-5c97-b85d-0008ae48eb05" :question/math-academy-id "q-30048" :question/problem "The equation ${x}^{2}-20x-21=0$ can be written in the form $(x+p{)}^{2}=q.$ Find $\\,p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-20x-21 & =0 \\\\ {x}^{2}-20x & =21 \\\\ {x}^{2}-2\\cdot 10\\cdot x & =21 \\\\ {x}^{2}-2\\cdot 10\\cdot x+{10}^{2}-{10}^{2} & =21 \\\\ ({x}^{2}-2\\cdot 10\\cdot x+{10}^{2})-100 & =21 \\\\ (x-10{)}^{2}-100 & =21\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-10{)}^{2}-100 & =21 \\\\ (x-10{)}^{2} & =121\\end{aligned}\n$$\n\nSo, $p=-10,q=121,$ and $p+q=111.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-10{)}^{2} & =121 \\\\ \\sqrt{(x-10{)}^{2}} & =\\sqrt{121} \\\\ x-10 & =\\pm 11 \\\\ x & =10\\pm 11\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =10+11=21 \\\\ x & =10-11=-1\\end{aligned}\n$$\n\nSo, the solutions are $x=-1$ and $x=21.$"} {:db/id #edb/ref 17592186297259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03efb687-0648-57d2-afc3-828945a16dcd" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186295285} {:answer/id #uuid "75671aab-2a85-5db2-8b21-7b48ec6d13a9" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-2\\,,\\,\\,{x}_{1}+{x}_{2}=3" :db/id #edb/ref 17592186295906} {:answer/id #uuid "d2df63b9-e947-50de-84ee-ff9d374c9148" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186296378} {:answer/id #uuid "d64ccde1-6f71-56d7-9463-27a4947090e4" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186296393} {:answer/id #uuid "eec8cace-c819-5ec2-878b-8863a0ad3874" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=2" :db/id #edb/ref 17592186296535}] :answer-field/correct {:answer/id #uuid "d2df63b9-e947-50de-84ee-ff9d374c9148" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186296378} :answer-field/id #uuid "e2310d3b-b2cf-5532-a8cf-656c466904ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297101}] :question/id #uuid "9036c737-fb24-58d0-8b5a-f6c590da27dc" :question/math-academy-id "q-30057" :question/problem "The equation ${x}^{2}-4x+4=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p-q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =1 \\\\ {x}^{2}-2\\cdot x\\cdot 2+{2}^{2} & =1 \\\\ (x-2)^{2} & =1\\end{aligned}\n$$\n\nSo, $p=-2,q=1,$ and $p-q=-3.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =1 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{1} \\\\ x-2 & =\\pm 1 \\\\ x & =2\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+1=3 \\\\ {x}_{2} & =2-1=1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=3$ and ${x}_{2}=1.$ Thus, the sum is $4.$"} {:db/id #edb/ref 17592186317325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d15e3e8-3b8d-57f2-a0a8-98600deb962a" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=-29\\,,\\,\\,a=1$ and $a=-9$" :db/id #edb/ref 17592186315286} {:answer/id #uuid "1f211608-1a7b-5fa2-b0c0-6f440df0bc48" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=29\\,,\\,\\,a=1$ and $a=9$" :db/id #edb/ref 17592186315297} {:answer/id #uuid "67caafad-8f96-528c-a534-b14e825b51c3" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=21\\,,\\,\\,a=1$ and $a=9$" :db/id #edb/ref 17592186315701} {:answer/id #uuid "ba7181a2-7433-5966-a6dc-b76953238166" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=21\\,,\\,\\,a=1$ and $a=-9$" :db/id #edb/ref 17592186316172} {:answer/id #uuid "fd763827-58d0-52ce-aff1-aed364c4f0f6" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=29\\,,\\,\\,a=1$ and $a=-9$" :db/id #edb/ref 17592186316534}] :answer-field/correct {:answer/id #uuid "fd763827-58d0-52ce-aff1-aed364c4f0f6" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=29\\,,\\,\\,a=1$ and $a=-9$" :db/id #edb/ref 17592186316534} :answer-field/id #uuid "4866c47a-a995-5e79-b6d1-e8367cf08c4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316713}] :question/id #uuid "697fde48-49f0-583d-9cb4-d2913bde926c" :question/math-academy-id "q-3428" :question/problem "The equation ${a}^{2}+8a=9$ can be written in the form $(a+p{)}^{2}=q.$ Find $\\,p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =9 \\\\ {a}^{2}+2\\cdot a\\cdot 4 & =9 \\\\ {a}^{2}+2\\cdot a\\cdot 4+{4}^{2}-{4}^{2} & =9 \\\\ ({a}^{2}+2\\cdot a\\cdot 4+{4}^{2})-{4}^{2} & =9 \\\\ ({a}^{2}+2\\cdot a\\cdot 4+{4}^{2})-16 & =9 \\\\ (a+4{)}^{2}-16 & =9\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =9 \\\\ (a+4{)}^{2} & =25\\end{aligned}\n$$\n\nSo, $p=4,q=25,$ and $p+q=29.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =25 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{25} \\\\ a+4 & =\\pm 5 \\\\ a & =-4\\pm 5\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{a}_{1} & =-4+5=1 \\\\ {a}_{2} & =-4-5=-9\\end{aligned}\n$$\n\nTherefore, the solutions are $a=1$ and $a=-9.$"} {:db/id #edb/ref 17592186396018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396020} {:answer/id #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=12$ and $a=-4$" :db/id #edb/ref 17592186396021} {:answer/id #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=60,\\,a=12$ and $a=-8$" :db/id #edb/ref 17592186396022} {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} {:answer/id #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=-4$" :db/id #edb/ref 17592186396024}] :answer-field/correct {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} :answer-field/id #uuid "950ac440-c42e-5efd-8288-46527f1353b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396019}] :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$"} {:db/id #edb/ref 17592186399739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f1c5a8-42ee-5523-84ec-f29f28e0ac2c" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-264\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399741} {:answer/id #uuid "eb2399df-9166-5676-8f9c-a51959d4ab11" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399742} {:answer/id #uuid "dff389cf-80e0-5f10-b6f2-86dcbc11e52c" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-14\\,$ and $\\,{t}_{1}+{t}_{2}=49$" :db/id #edb/ref 17592186399743} {:answer/id #uuid "c14d9b4a-b38e-5fab-ad4f-cb09b4aea808" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399744} {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745}] :answer-field/correct {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745} :answer-field/id #uuid "9feed68a-3a5e-5bf8-a32b-19c5c668ac59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399740}] :question/id #uuid "fac39442-17f5-5ace-9954-931f61698611" :question/math-academy-id "q-112457" :question/problem "The equation ${t}^{2}-14t+5=5$ can be written in the form $(t+p{)}^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${t}_{1}+{t}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}-14t+5 & =5 \\\\ {t}^{2}-14t & =0 \\\\ {t}^{2}-2\\cdot t\\cdot 7+{7}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2} & =49\\end{aligned}\n$$\n\nHence, $p=-7$ and $q=49.$ Thus, $pq=-343.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(t-7{)}^{2} & =49 \\\\ \\sqrt{(t-7{)}^{2}} & =\\sqrt{49} \\\\ |t-7| & =7 \\\\ t-7 & =\\pm 7 \\\\ t & =7\\pm 7\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{t}_{1} & =7-7=0 \\\\ {t}_{2} & =7+7=14\\end{aligned}\n$$\n\nTherefore, the sum is ${t}_{1}+{t}_{2}=14.$"} {:db/id #edb/ref 17592186401961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401963} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401964} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401966} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401967}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401962}] :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"} :step/id #uuid "e8ad64de-7f87-50f9-93a9-c312fc8bc8e8" :step/next {:db/id #edb/ref 17592186069816}} {:db/id #edb/ref 17592186069816 :step/content {:db/id #edb/ref 17592186068861 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068499 :question/id #uuid "d53f36b5-fc95-55de-b716-789dd327d2f8" :question/math-academy-id "e-1432" :question/problem "Solve the equation $x^2-2x-1=0.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x-1 & =0 \\\\ {x}^{2}-2x & =1 \\\\ {x}^{2}-2\\cdot 1\\cdot x & =1 \\\\ {x}^{2}-2\\cdot 1\\cdot x+{1}^{2}-{1}^{2} & =1 \\\\ ({x}^{2}-2x+1)-1 & =1 \\\\ (x-1{)}^{2}-1 & =1\\end{aligned}\n$$\n\nThen, we isolate the perfect square and solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-1{)}^{2}-1 & =1 \\\\ (x-1{)}^{2} & =2 \\\\ \\sqrt{(x-1{)}^{2}} & =\\sqrt{2} \\\\ |x-1| & =\\sqrt{2} \\\\ x-1 & =\\pm \\sqrt{2} \\\\ x & =1\\pm \\sqrt{2}\\end{aligned}\n$$\n\nTherefore, our solutions are\n\n$$\n\\begin{aligned}{x}_{1} & =1+\\sqrt{2}, \\\\ {x}_{2} & =1-\\sqrt{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/questions [{:db/id #edb/ref 17592186069020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0974fc91-0158-537c-ae8f-ff1ad03a103d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=17" :db/id #edb/ref 17592186244392} {:answer/id #uuid "10200a83-a143-5ec5-9943-1d5364b850f3" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=16" :db/id #edb/ref 17592186244465} {:answer/id #uuid "4e5f6090-f633-59cc-89bd-bf87f4f07f2a" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=8" :db/id #edb/ref 17592186245008} {:answer/id #uuid "62470b8d-84d8-532b-9c4c-ab152ead57fd" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24" :db/id #edb/ref 17592186245175} {:answer/id #uuid "b9cd46d0-ecba-5b17-b95b-c6236318c54d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12" :db/id #edb/ref 17592186245972}] :answer-field/correct {:answer/id #uuid "0974fc91-0158-537c-ae8f-ff1ad03a103d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=17" :db/id #edb/ref 17592186244392} :answer-field/id #uuid "7d543b24-969d-57cf-b8fa-4e1a8745b4a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246768}] :question/id #uuid "182dc49a-808d-540a-a4f9-abacbd57ac1e" :question/math-academy-id "q-112474" :question/problem "The equation ${t}^{2}+10t+13=0$ can be written in the form $(t+p)^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}+10t+13 & =0 \\\\ {t}^{2}+10t & =-13 \\\\ {t}^{2}+2\\cdot 5\\cdot t & =-13 \\\\ {t}^{2}+2\\cdot 5\\cdot t+{5}^{2}-{5}^{2} & =-13 \\\\ (t+5)^{2}-25 & =-13\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(t+5)^{2}-25 & =-13 \\\\ (t+5)^{2} & =12\\end{aligned}\n$$\n\nHence, $p=5,$ $q=12,$ and $p+q=17.$"} {:db/id #edb/ref 17592186069268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "824db7a0-468b-5b7c-bdd3-7bd19185dd56" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 80, z =-5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066779} {:answer/id #uuid "f44af2a5-1591-5f5e-93ba-40c0ddd584b9" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 80, z =-8 ± 3" :db/id #edb/ref 17592186066780} {:answer/id #uuid "30dfca08-4199-59da-8d02-2600e0f2122b" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 75, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066781} {:answer/id #uuid "4a3b9749-a33c-5c57-89ac-26939f855dba" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 80, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066782} {:answer/id #uuid "6d135e5e-ebb4-5c27-84bf-0be68ee6c029" :answer/type {:db/ident :answer.type/math} :answer/value "p + q =-70, z = ± \\sqrt{3}" :db/id #edb/ref 17592186066783}] :answer-field/id #uuid "988361f0-82f8-5fa0-bce8-8775fead2e27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066778} {:answer-field/choices [{:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} {:answer/id #uuid "23289d14-87e9-57fb-bbda-cdd305eb9ab6" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-70,\\,z=\\pm \\sqrt{3}" :db/id #edb/ref 17592186402358} {:answer/id #uuid "691a3cdd-d3d5-50e7-a708-646cfa31e0a7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-8\\pm 3" :db/id #edb/ref 17592186402359} {:answer/id #uuid "823c0a9e-ef4b-5a9d-a5eb-0fe274767e74" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=75,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402360} {:answer/id #uuid "ee362d99-5b0e-55c5-83d5-a9a8872163ac" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=80,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402361}] :answer-field/correct {:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} :answer-field/id #uuid "0174c191-2a23-5d0f-b8d7-9880c6f7ee41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402356}] :question/id #uuid "5c0076f5-08a5-5d4c-9789-196650ab8295" :question/math-academy-id "q-3435" :question/problem "The equation ${z}^{2}-50=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-50 & =-10z \\\\ {z}^{2}+10z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2}-{5}^{2} & =50\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2} & =75\\end{aligned}\n$$\n\nSo, $p=5,q=75,$ and $p+q=80.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(z+5{)}^{2} & =75 \\\\ \\sqrt{(z+5{)}^{2}} & =\\sqrt{75} \\\\ |z+5| & =\\sqrt{75} \\\\ z+5 & =\\pm 5\\sqrt{3} \\\\ z & =-5\\pm 5\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac30458-5aa5-53d1-a35f-6a5e229b5fd8" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=15" :db/id #edb/ref 17592186244409} {:answer/id #uuid "124afa4f-beb4-5f60-8390-af0d051a7c0e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186244483} {:answer/id #uuid "69db1b27-9bc0-5392-9003-f856713f1c5e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=16" :db/id #edb/ref 17592186245249} {:answer/id #uuid "6fd15390-3548-59b6-b0e5-a6f7effa5ce3" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=11" :db/id #edb/ref 17592186245310} {:answer/id #uuid "e0a87c42-1ede-52a0-9349-121c7a1e1c19" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10" :db/id #edb/ref 17592186246316}] :answer-field/correct {:answer/id #uuid "0ac30458-5aa5-53d1-a35f-6a5e229b5fd8" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=15" :db/id #edb/ref 17592186244409} :answer-field/id #uuid "36db4897-d91b-521b-b2c1-4c1fd93e3621" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246641}] :question/id #uuid "81b835fd-301a-5291-a6dc-f20815ef4cf4" :question/math-academy-id "q-112466" :question/problem "The equation ${y}^{2}+4y-9=0$ can be written in the form $(y+p{)}^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{y}^{2}+4y-9 & =0 \\\\ {y}^{2}+4y & =9 \\\\ {y}^{2}+2\\cdot 2\\cdot y & =9 \\\\ {y}^{2}+2\\cdot 2\\cdot y+{2}^{2}-{2}^{2} & =9 \\\\ (y+2{)}^{2}-4 & =9\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+2{)}^{2}-4 & =9 \\\\ (y+2{)}^{2} & =13\\end{aligned}\n$$\n\nHence, $p=2,$ $q=13,$ and $p+q=15.$"} {:db/id #edb/ref 17592186247273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2672c966-4b66-5dfe-8513-268a8ae1e868" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=35" :db/id #edb/ref 17592186244655} {:answer/id #uuid "5c285e58-08a4-58ee-b9bb-ee54bb9669a7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=48" :db/id #edb/ref 17592186245125} {:answer/id #uuid "6af2fc1e-9c4a-5af3-9cd1-659f0d3f9be4" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=28" :db/id #edb/ref 17592186245262} {:answer/id #uuid "b9fe9153-a5e3-5fcd-8da8-7c6c8058eeb1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=42" :db/id #edb/ref 17592186245975} {:answer/id #uuid "f229f5f3-8a6f-5fef-b49f-bd969e8e8dd5" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186246451}] :answer-field/correct {:answer/id #uuid "b9fe9153-a5e3-5fcd-8da8-7c6c8058eeb1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=42" :db/id #edb/ref 17592186245975} :answer-field/id #uuid "d8d3b0e9-aefb-51b0-81a0-66a64601e3bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246934}] :question/id #uuid "19aa26db-8df6-54d2-b8e3-083008a61322" :question/math-academy-id "q-112472" :question/problem "The equation ${b}^{2}+14b+14=0$ can be written in the form $(b+p{)}^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{b}^{2}+14b+14 & =0 \\\\ {b}^{2}+14b & =-14 \\\\ {b}^{2}+2\\cdot 7\\cdot b & =-14 \\\\ {b}^{2}+2\\cdot 7\\cdot b+{7}^{2}-{7}^{2} & =-14 \\\\ (b+7{)}^{2}-49 & =-14\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(b+7{)}^{2}-49 & =-14 \\\\ (b+7{)}^{2} & =35\\end{aligned}\n$$\n\nHence, $p=7,$ $q=35$ and $p+q=42.$"} {:db/id #edb/ref 17592186247277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a273954-99ac-5a60-820c-f3c7eddd0d84" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=9,\\,n=-2\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186244547} {:answer/id #uuid "336affd6-6b2c-5d14-afe0-9f827fc79682" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,n=-1\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186244775} {:answer/id #uuid "7cda915b-89a3-5c26-a0c3-fe803e316b46" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=9,\\,n=1\\pm \\sqrt{3}" :db/id #edb/ref 17592186245408} {:answer/id #uuid "9be2aa1d-7a2d-578e-9614-a372c345075e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=13,\\,n=3\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186245693} {:answer/id #uuid "bc3ce1a6-84e6-5a21-9bfd-0a9e080554a8" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=11,\\,n=1\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186245992}] :answer-field/correct {:answer/id #uuid "bc3ce1a6-84e6-5a21-9bfd-0a9e080554a8" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=11,\\,n=1\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186245992} :answer-field/id #uuid "dedba501-1db5-5e1e-8cea-3ac060bb1b28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246944}] :question/id #uuid "db749aa2-b405-5990-8407-5b43744a1377" :question/math-academy-id "q-112488" :question/problem "The equation ${n}^{2}-11=2n$ can be written in the form $(n+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $2n$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{n}^{2}-11 & =2n \\\\ {n}^{2}-2n & =11 \\\\ {n}^{2}-2\\cdot 1\\cdot n & =11 \\\\ {n}^{2}-2\\cdot 1\\cdot n+{1}^{2}-{1}^{2} & =11 \\\\ (n-1{)}^{2}-{1}^{2} & =11\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(n-1{)}^{2}-{1}^{2} & =11 \\\\ (n-1{)}^{2} & =12\\end{aligned}\n$$\n\nSo, $p=-1,q=12,$ and $p+q=11.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(n-1{)}^{2} & =12 \\\\ \\sqrt{(n-1{)}^{2}} & =\\sqrt{12} \\\\ |n-1| & =\\sqrt{12} \\\\ n-1 & =\\pm 2\\sqrt{3} \\\\ n & =1\\pm 2\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322bd372-25cd-5d01-937b-88602e918d0b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=6\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186244762} {:answer/id #uuid "54e43c91-0fba-51b5-a36a-ef5277ea80ef" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=12\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186245059} {:answer/id #uuid "6d2994f7-614a-5f12-9f0d-a64dbb8ae84d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26,\\,a=2\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186245279} {:answer/id #uuid "80c62e7a-e03e-5b92-9505-85dc789fa75b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=30,\\,a=1\\pm 3\\sqrt{3}" :db/id #edb/ref 17592186245449} {:answer/id #uuid "932eb87c-4fa3-59e5-8fc9-a301ea01cddc" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=21,\\,a=3\\pm 5\\sqrt{2}" :db/id #edb/ref 17592186245596}] :answer-field/correct {:answer/id #uuid "322bd372-25cd-5d01-937b-88602e918d0b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=6\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186244762} :answer-field/id #uuid "ca2f2966-3f07-5832-80e0-1029cfe3a1cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246911}] :question/id #uuid "ccd1081d-908d-5372-a315-9be341f0eb2c" :question/math-academy-id "q-112490" :question/problem "The equation ${a}^{2}-12a+18=0$ can be written in the form $(a-p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}-12a+18 & =0 \\\\ {a}^{2}-12a & =-18 \\\\ {a}^{2}-2\\cdot 6\\cdot a+{6}^{2}-{6}^{2} & =-18 \\\\ (a-6)^{2}-{6}^{2} & =-18\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a-6)^{2}-{6}^{2} & =-18 \\\\ (a-6)^{2}-36 & =-18 \\\\ (a-6)^{2} & =18\\end{aligned}\n$$\n\nSo, $p=6,q=18,$ and $p+q=24.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a-6)^{2} & =18 \\\\ \\sqrt{(a-6)^{2}} & =\\sqrt{18} \\\\ |a-6| & =\\sqrt{18} \\\\ a-6 & =\\pm 3\\sqrt{2} \\\\ a & =6\\pm 3\\sqrt{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20426930-ba8c-5c0b-84d9-ae0b4c8047af" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-9" :db/id #edb/ref 17592186263294} {:answer/id #uuid "5065f861-e6df-5f39-a2b8-138ec48c99a4" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=2" :db/id #edb/ref 17592186263698} {:answer/id #uuid "578f66bf-7976-5a27-9ccf-fd57b92c5a0c" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=13" :db/id #edb/ref 17592186263755} {:answer/id #uuid "9a21a94c-b5ba-56ba-85cc-fcd5d8214911" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-11" :db/id #edb/ref 17592186264322} {:answer/id #uuid "a72ceb15-df31-5809-ac8b-2e90e34a075e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=11" :db/id #edb/ref 17592186264430}] :answer-field/correct {:answer/id #uuid "578f66bf-7976-5a27-9ccf-fd57b92c5a0c" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=13" :db/id #edb/ref 17592186263755} :answer-field/id #uuid "27691a0a-fa86-5985-a681-1bfbb1b241da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265319}] :question/id #uuid "e7c6376f-3050-50c0-ac00-dc867cf23b29" :question/math-academy-id "q-12979" :question/problem "The equation ${x}^{2}+4x-7=0$ can be written in the form $(x+p)^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x-7 & =0 \\\\ {x}^{2}+4x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =7 \\\\ (x+2)^{2}-4 & =7\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+2)^{2}-4 & =7 \\\\ (x+2)^{2} & =11\\end{aligned}\n$$\n\nHence, $p=2,$ $q=11,$ and $p+q=13.$"} {:db/id #edb/ref 17592186265778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8706a9ee-2268-5b08-9baa-5c2d6c15ca4e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186264168} {:answer/id #uuid "9f97e249-0464-56fa-ae0e-5a637b86a0d9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=4+\\sqrt{34}" :db/id #edb/ref 17592186264359} {:answer/id #uuid "b22c6bf1-7b75-5dfb-a52d-08a9c74961bd" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-38,\\,a=-4\\pm \\sqrt{35}" :db/id #edb/ref 17592186264532} {:answer/id #uuid "cb792f03-1896-59dc-81a3-229808ddc1f3" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-35,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186264782} {:answer/id #uuid "d7d8d534-ab0f-5280-8373-ad9441a4c27b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=35,\\,a=-4-\\sqrt{34}" :db/id #edb/ref 17592186264881}] :answer-field/correct {:answer/id #uuid "8706a9ee-2268-5b08-9baa-5c2d6c15ca4e" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186264168} :answer-field/id #uuid "e5e63e33-5791-54e0-9a37-33c3980605a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265652}] :question/id #uuid "3e3748c5-6be5-535f-b3c7-81c495d312b4" :question/math-academy-id "q-12980" :question/problem "The equation ${a}^{2}+8a=18$ can be written in the form $(a+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =18 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =18 \\\\ {a}^{2}+2\\cdot a\\cdot 4+{4}^{2}-{4}^{2} & =18 \\\\ (a+4)^{2}-{4}^{2} & =18\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4)^{2}-{4}^{2} & =18 \\\\ (a+4)^{2}-16 & =18 \\\\ (a+4)^{2} & =34\\end{aligned}\n$$\n\nSo, $p=4,q=34,$ and $p+q=38.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4)^{2} & =34 \\\\ \\sqrt{(a+4)^{2}} & =\\sqrt{34} \\\\ |a+4| & =\\sqrt{34} \\\\ a+4 & =\\pm \\sqrt{34} \\\\ a & =-4\\pm \\sqrt{34}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} {:answer/id #uuid "49bc3a1b-22cf-5a66-a6c0-83bfe3292149" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-45" :db/id #edb/ref 17592186263634} {:answer/id #uuid "884cd699-7583-5968-ae5f-5297ccb1d1f9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-50" :db/id #edb/ref 17592186264178} {:answer/id #u