rac{x - 1}{\\sqrt{6}}) + C" :db/id #edb/ref 17592186165469}] :answer-field/id #uuid "433946ff-3147-5602-9047-caca37647a58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165464}] :question/id #uuid "41f10220-d30c-5b6d-a297-13917a433826" :question/math-academy-id "q-95469" :question/problem "What is $\\displaystyle \\int\\frac{1}{5 + 2x - x^{2}}dx$?"}] :knowledge-point/title "Completing the Square to Compute a Hyperbolic Arctangent Integral"} :step/id #uuid "2bc0a73c-820f-58b6-becd-5738236cc7f7"} {:db/id #edb/ref 17592186167616 :step/content {:db/id #edb/ref 17592186166783 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166621 :question/id #uuid "fbc6dae4-e0c2-5cbb-abfe-62b7f08afac0" :question/math-academy-id "e-8404" :question/problem "Calculate $\\displaystyle \\int \\dfrac{\\textrm{d}x}{\\sqrt{\\left(x - 1\\right)^2-9}}$." :question/worked-solution "First, we note that\n\n$$\n\\int \\dfrac{\\textrm{d}x}{\\sqrt{\\left(x - 1\\right)^2-9}} = \\int \\dfrac{\\textrm{d}x}{\\sqrt{9\\left(\\dfrac{x - 1}{3}\\right)^2-9}} = \\dfrac{1}{3} \\int \\dfrac{1}{\\sqrt{\\left(\\dfrac{x-1}{3}\\right)^2-1}} \\textrm{d}x\n$$\n\nLet\n\n$$\nu =\\dfrac{x-1}{3}\n$$\n\nThen, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3} \\quad\\Longrightarrow\\quad \\textrm{d}x = 3\\,\\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\frac{1}{3}\\int(1)/(\\sqrt{(\\frac{x - 1}{3})^{2} - 1})dx &= \\frac{1}{3}\\int\\frac{1}{\\sqrt{u^{2} - 1}} \\cdot 3du \\\\\n&= arcosh u + C \\\\\n&= arcosh (\\frac{x - 1}{3}) + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "966d7ddd-f07f-5335-a8e4-2189dd51598b" :knowledge-point/questions [{:db/id #edb/ref 17592186167371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad65f720-9ba3-5c48-8ef6-8563a173768e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}arcosh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165435} {:answer/id #uuid "c8152a41-dcc8-59cb-bad5-ce5ad24d78ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165436} {:answer/id #uuid "dfcafd47-c3cd-54c3-8793-f7020e00b919" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165437} {:answer/id #uuid "12349aba-53b7-5546-bef8-9bee6553bd53" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}arsinh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165438} {:answer/id #uuid "42001c11-c861-53c9-baa5-2138d42d277d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}arcosh (\\frac{3x + 1}{3}) + C" :db/id #edb/ref 17592186165439}] :answer-field/id #uuid "0dc8d21b-706e-5561-adfe-b550503f163f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165434}] :question/id #uuid "888cdf0a-6535-5bca-ac71-d8d488aa9d3f" :question/math-academy-id "q-95461" :question/problem "Calculate $\\displaystyle \\int(dx)/(\\sqrt{(3x + 1)^{2} + 9})$."} {:db/id #edb/ref 17592186167373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899d83e7-170b-5941-b160-b65950585816" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (\\frac{2x - 1}{2}) + C" :db/id #edb/ref 17592186165447} {:answer/id #uuid "cb9a4c48-6b8f-54a4-aa86-f2b6c4aa7080" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arcosh (\\frac{2x - 1}{3}) + C" :db/id #edb/ref 17592186165448} {:answer/id #uuid "eb66d945-b58a-5a78-b901-7cafb4dadbe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcosh (\\frac{x - 1}{4}) + C" :db/id #edb/ref 17592186165449} {:answer/id #uuid "203131c7-18fa-5188-82ee-7e3ab4e8fb4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}arsinh (\\frac{2x - 1}{3}) + C" :db/id #edb/ref 17592186165450} {:answer/id #uuid "7046eb97-5909-5dd3-9787-f5eb70220d74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}arsinh (\\frac{2x - 1}{2}) + C" :db/id #edb/ref 17592186165451}] :answer-field/id #uuid "b940f051-7830-5232-83b4-31d9d55e5f60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165446}] :question/id #uuid "49ddc13d-695b-5cd1-908f-3628c6b7c126" :question/math-academy-id "q-95465" :question/problem "Calculate $\\displaystyle \\int(dx)/(\\sqrt{(2x - 1)^{2} - 4})$."}] :knowledge-point/title "Computing an Inverse Hyperbolic Integral Containing a Completed Square"} :step/id #uuid "192b2e82-bdb6-5aeb-aa5a-f10a2948bef1" :step/next {:db/id #edb/ref 17592186167612}} {:db/id #edb/ref 17592186167708 :step/content {:db/id #edb/ref 17592186168098 :tutorial/content "Consider the integral\n\n$$\n\\int \\dfrac{1}{\\sqrt{x^2-10x+34}}\\, \\textrm{d}x\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can complete the square for the denominator, as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 10x + 34 &= x^{2} - 10x + (25 - 25) + 34 \\\\\n&= (x^{2} - 10x + 25) - 25 + 34 \\\\\n&= (x - 5)^{2} + 9\n\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of $9$ in the denominator, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{\\sqrt{x^{2} - 10x + 34}}dx &= \\int(1)/(\\sqrt{(x - 5)^{2} + 9})dx \\\\\n&= \\int(1)/(\\sqrt{9[((x - 5)^{2})/(9) + 1]})dx \\\\\n&= \\frac{1}{3}\\int(1)/(\\sqrt{(\\frac{x - 5}{3})^{2} + 1})dx\n\\end{aligned}\n$$\n\nThis now looks more familiar! Let\n\n$$\nu = \\dfrac {x-5}{3}\n$$\n\nThen\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3} \\quad\\Longrightarrow\\quad \\textrm{d}x = 3\\,\\textrm{d}u\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{\\sqrt{x^{2} - 10x + 34}}dx &= \\frac{1}{3}\\int(1)/(\\sqrt{(\\frac{x - 5}{3})^{2} + 1})dx \\\\\n&= \\frac{1}{3}\\int\\frac{1}{\\sqrt{u^{2} + 1}} \\cdot (3du) \\\\\n&= \\int\\frac{1}{\\sqrt{u^{2} + 1}}du\n\\end{aligned}\n$$\n\nThis is a basic integral for an inverse hyperbolic function, and we can solve it in one step:\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{\\sqrt{u^{2} + 1}}du &= arsinh u + C \\\\\n&= arsinh (\\frac{x - 5}{3}) + C\n\\end{aligned}\n$$" :tutorial/id #uuid "59b06095-0ed1-54ec-b486-9618bb3c0704" :tutorial/title "Introduction"} :step/id #uuid "76d7b772-0793-533d-b97a-83cada3520cf" :step/next {:db/id #edb/ref 17592186167616}}] :activity/title "Integration Using Hyperbolic Functions and Completing the Square" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186167029}] [{:db/id #edb/ref 17592186050044 :topic/id #uuid "283fdb1d-4be7-5644-aaf9-820e24ebcdcb" :topic/knowledge-points [{:db/id #edb/ref 17592186184168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183961 :question/id #uuid "fc7c982c-7e5d-5187-9779-6952f32fe2bf" :question/math-academy-id "e-15019" :question/problem "Rewrite the expression \n\n$$\n\\left(x^2 + 7x + \\dfrac{49}{4}\\right) + 3\n$$\n\nas the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}+7x+\\frac{49}{4} & = \\\\ {x}^{2}+7x+{(\\frac{7}{2})}^{2} & = \\\\ {x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2} & = \\\\ {(x+\\frac{7}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}+7x+\\frac{49}{4})+3 & = \\\\ {(x+\\frac{7}{2})}^{2}+3 & .\\end{aligned}\n$$"} :knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7" :knowledge-point/questions [{:db/id #edb/ref 17592186184478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e115dce-6c4a-5990-acf3-bf492c96d488" :answer/type {:db/ident :answer.type/math} :answer/value "(x + \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181046} {:answer/id #uuid "a70edb35-cbf2-5e18-b8aa-351303b13799" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 5)^{2} + 3" :db/id #edb/ref 17592186181047} {:answer/id #uuid "cc6b90df-1c57-524a-8734-19d8517fefc3" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 5)^{2} + 3" :db/id #edb/ref 17592186181048} {:answer/id #uuid "f1b669fc-c53e-5ece-bb04-bb4167ea84d2" :answer/type {:db/ident :answer.type/math} :answer/value "(x - \\frac{5}{4})^{2} + 3" :db/id #edb/ref 17592186181049} {:answer/id #uuid "56ee1c11-8464-5689-b873-51dcd5a5583d" :answer/type {:db/ident :answer.type/math} :answer/value "(x - \\frac{5}{2})^{2} + 3" :db/id #edb/ref 17592186181050}] :answer-field/id #uuid "eb8c466d-4935-54e2-a0c5-07904d3f71b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181045}] :question/id #uuid "7fde105f-56e2-5383-a76a-5a8fb4028ec0" :question/math-academy-id "q-140191" :question/problem "Rewrite the expression\n$(x^{2} + 5x + (\\frac{5}{2})^{2}) + 3$\nas the sum of a perfect square and a constant."} {:db/id #edb/ref 17592186184553 :question/answer-fields [{:answer-field/id #uuid "f71c95db-5c93-50f2-9dbe-b16d5d197d7b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181476} {:answer-field/id #uuid "face2b35-7848-5b75-822e-e760b54ac25c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186181477}] :question/id #uuid "50997d11-dc77-5455-a188-b0e98a0d9407" :question/math-academy-id "q-221410" :question/problem "Rewrite the following expression as the difference of a perfect square and a constant.$(y^{2} + 13y + \\frac{169}{4}) - 7 = (y +$\n{{field-1}} $)^{2} -$\n{{field-2}}"} {:db/id #edb/ref 17592186272046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b92c754-eb13-5d62-8988-5c9cd5b46d9c" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+1)}^{2}-1" :db/id #edb/ref 17592186269662} {:answer/id #uuid "2d6d3379-d6ad-5655-999a-1273f57649fc" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186269678} {:answer/id #uuid "71c32ce2-abcd-589e-9ee2-bf0011fa0aee" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{4})}^{2}-1" :db/id #edb/ref 17592186270278} {:answer/id #uuid "9f2d8b7d-7c0f-5acc-b9f8-e53fbc017c17" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186270680} {:answer/id #uuid "fd66c5fe-ca7f-51da-b3eb-be1db1ee6189" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-1)}^{2}-1" :db/id #edb/ref 17592186271486}] :answer-field/correct {:answer/id #uuid "2d6d3379-d6ad-5655-999a-1273f57649fc" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}-1" :db/id #edb/ref 17592186269678} :answer-field/id #uuid "bd33067a-85fe-5634-91e6-8571e5edc593" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271854}] :question/id #uuid "92dac4ab-f152-5947-b5c0-1c9fee1af33c" :question/math-academy-id "q-140299" :question/problem "Rewrite the expression \n\n$$\n({x}^{2}-x+\\frac{1}{4})-1\n$$\n\nas the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x+\\frac{1}{4} & = \\\\ {x}^{2}-x+{(\\frac{1}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2} & = \\\\ {(x-\\frac{1}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-x+\\frac{1}{4})-1 & = \\\\ {(x-\\frac{1}{2})}^{2}-1 & .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad3e0aa-0e