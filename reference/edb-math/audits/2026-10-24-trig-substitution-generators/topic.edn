/ref 17592186580778} :answer-field/id #uuid "f2d8f522-565f-5640-81d7-21d42b1024a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186580876}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2ed18e1b-5d9e-5d88-b764-bf87259e7a34" :question/math-academy-id "q-350908" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /4}\\frac{{sec}^{2}⁡(x)}{2+3\\operatorname{tan}⁡(x)}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=2+3\\operatorname{tan}⁡(x),$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{sec}^{2}⁡(x)\\,⟹\\,\\frac{1}{3}\\text{d}u={sec}^{2}⁡(x)\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /4$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{{sec}^{2}⁡(x)}{2+3\\operatorname{tan}⁡(x)}\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{1}{2+3\\operatorname{tan}⁡(x)}\\cdot {sec}^{2}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{5}\\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|{|}_{2}^{5} \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡5-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{5}{2}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9862e91c-0efe-5bb8-8925-45bc31839846" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(\\frac{4}{3}\\right)" :db/id #edb/ref 17592186580645}] :answer-field/correct {:answer/id #uuid "9862e91c-0efe-5bb8-8925-45bc31839846" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(\\frac{4}{3}\\right)" :db/id #edb/ref 17592186580645} :answer-field/id #uuid "65d0530e-816a-5976-ad52-1c7704a78646" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186580830}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "49d4a023-e567-5ef0-bff2-0a05874f4d54" :question/math-academy-id "q-350892" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)}{2+\\operatorname{sec}⁡(x)}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=2+\\operatorname{sec}⁡(x),$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)\\,⟹\\,\\text{d}u=\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $3$ | $4$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)}{2+\\operatorname{sec}⁡(x)}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{1}{2+\\operatorname{sec}⁡(x)}\\cdot \\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|\\,{|}_{3}^{4} \\\\  & =\\operatorname{ln}⁡4-\\operatorname{ln}⁡3 \\\\  & =\\operatorname{ln}⁡\\left(\\frac{4}{3}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4372d15c-6169-5803-bfb8-66c3f2f3cbf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{tan}^{3}⁡x|+C" :db/id #edb/ref 17592186580500} {:answer/id #uuid "4deac130-288d-5045-b1d2-b52497fdefa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(1+{tan}^{3}⁡x)^{2}}{6}+C" :db/id #edb/ref 17592186580520} {:answer/id #uuid "61729743-7563-55d5-8b83-b7ddbc821b96" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|1+{tan}^{3}⁡x|+C" :db/id #edb/ref 17592186580551} {:answer/id #uuid "6264dfba-3484-5fd9-b5f3-94b863b01f18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{tan}^{3}⁡x|}{3}+C" :db/id #edb/ref 17592186580552} {:answer/id #uuid "aa07f6f8-4014-5a7c-801e-34f67c5ef101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C" :db/id #edb/ref 17592186580670}] :answer-field/correct {:answer/id #uuid "aa07f6f8-4014-5a7c-801e-34f67c5ef101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C" :db/id #edb/ref 17592186580670} :answer-field/id #uuid "32eb1b68-1758-57ca-a900-b98c6ab2561c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580809}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6921b481-ec14-522b-b9b9-dcaba2949b0c" :question/math-academy-id "q-113987" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{{tan}^{2}⁡x{sec}^{2}⁡x}{1+{tan}^{3}⁡x}\\,\\text{d}x\n$$" :question/worked-solution "Let $u=1+{tan}^{3}⁡x.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{tan}^{2}⁡x\\cdot {sec}^{2}⁡x\\,⟹\\,\\frac{1}{3}\\text{d}u={tan}^{2}⁡x{sec}^{2}⁡x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{tan}^{2}⁡x{sec}^{2}⁡x}{1+{tan}^{3}⁡x}\\,\\text{d}x & =\\int \\frac{1}{1+{tan}^{3}⁡x}\\cdot {tan}^{2}⁡x{sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|1+{tan}^{3}⁡x|+C \\\\  & =\\frac{\\operatorname{ln}⁡|1+{tan}^{3}⁡x|}{3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186580921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45daf244-4c3f-5472-93a8-da7d6c3bdccd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{9}{16}\\right)" :db/id #edb/ref 17592186580505} {:answer/id #uuid "52196bc9-8d38-5c9d-83d2-2c96f288c9a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{4}{9}\\right)" :db/id #edb/ref 17592186580525} {:answer/id #uuid "b5431721-a52a-5556-b365-52a555669b07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{16}{9}\\right)" :db/id #edb/ref 17592186580682} {:answer/id #uuid "d171db58-409b-5e77-8fc1-6b70a1ac11c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{9}{2}\\right)" :db/id #edb/ref 17592186580716} {:answer/id #uuid "e3853a5f-a3bd-5d18-8620-4554383b00ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{9}{8}\\right)" :db/id #edb/ref 17592186580745}] :answer-field/correct {:answer/id #uuid "b5431721-a52a-5556-b365-52a555669b07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{16}{9}\\right)" :db/id #edb/ref 17592186580682} :answer-field/id #uuid "1444f051-3ccb-51c7-99bf-4f860a1031ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186580800}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "86968101-fa3c-5286-a648-9b995fa5fe70" :question/math-academy-id "q-114003" :question/problem "Evaluate the integral\n$$\n\\displaystyle {\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x}{{cos}^{3}⁡x+1}\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({cos}^{3}⁡x+1)=-3{cos}^{2}⁡x\\operatorname{sin}⁡x.\n$$\n\nSo, let $u={cos}^{3}⁡x+1.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3{cos}^{2}⁡x\\operatorname{sin}⁡x\\,⟹\\,-\\frac{1}{3}\\text{d}u={cos}^{2}⁡x\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $2$ | $9/8$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x}{{cos}^{3}⁡x+1}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{1}{{cos}^{3}⁡x+1}\\cdot \\operatorname{sin}⁡x{cos}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{2}^{9/8}\\frac{1}{u}\\cdot \\left(-\\frac{1}{3}\\right)\\text{d}u \\\\  & =-\\frac{1}{3}{\\int }_{2}^{9/8}\\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|{|}_{2}^{9/8} \\\\  & =-\\frac{1}{3}(\\operatorname{ln}⁡\\left(\\frac{9}{8}\\right)-\\operatorname{ln}⁡(2)) \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡\\left(\\frac{9}{8}\\right)) \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{2}{\\left(\\frac{9}{8}\\right)}\\right) \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡\\left(\\frac{16}{9}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186601906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1076235e-749e-5a4a-9320-4c7fadf47260" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186601606} {:answer/id #uuid "175ac7d8-8458-5a41-b3c3-c89df547e0fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186601615} {:answer/id #uuid "9c6341ab-6fb8-5ddb-a50c-adef3352e253" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186601719} {:answer/id #uuid "af3073c6-be0b-56c9-82b5-e45a8a289d90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(2)}{2}" :db/id #edb/ref 17592186601734} {:answer/id #uuid "b485a7b4-df9d-511e-8b4f-3dedf91fe647" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186601741}] :answer-field/correct {:answer/id #uuid "af3073c6-be0b-56c9-82b5-e45a8a289d90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(2)}{2}" :db/id #edb/ref 17592186601734} :answer-field/id #uuid "d11d6f61-1356-5f40-bb93-ae94797c1250" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186601874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a066d83-0a5d-5a8a-a634-adb2f5d14194" :question/math-academy-id "q-114004" :question/problem "Evaluate the integral\n$$\n\\displaystyle {\\int }_{0}^{\\sqrt{\\pi }/2}\\frac{x{sec}^{2}⁡({x}^{2})}{1+\\operatorname{tan}⁡({x}^{2})}\\,\\text{d}x.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(1+\\operatorname{tan}⁡({x}^{2}))=2x{sec}^{2}⁡({x}^{2}).\n$$\n\nSo, let $u=1+\\operatorname{tan}⁡({x}^{2}).$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x{sec}^{2}⁡({x}^{2})\\,⟹\\,\\frac{1}{2}\\text{d}u=x{sec}^{2}⁡({x}^{2})\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi }/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi }/2}\\frac{x{sec}^{2}⁡({x}^{2})}{1+\\operatorname{tan}⁡({x}^{2})}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi }/2}\\frac{1}{1+\\operatorname{tan}⁡({x}^{2})}\\cdot x{sec}^{2}⁡({x}^{2})\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|{|}_{1}^{2} \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{\\operatorname{ln}⁡(2)}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186605890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3db550-ee1e-555b-bc06-390b655b9f88" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{cot}⁡z{csc}^{2}⁡z)+C" :db/id #edb/ref 17592186605303} {:answer/id #uuid "8f72f014-9e7c-59fb-98ca-5331183256fc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(\\operatorname{cot}⁡z{csc}^{2}⁡z)+C" :db/id #edb/ref 17592186605506} {:answer/id #uuid "93f3445d-8a85-5c2f-8baa-633dd26d1b5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C" :db/id #edb/ref 17592186605516} {:answer/id #uuid "c36518f3-9d8f-570c-bc9d-9d52b3886265" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C" :db/id #edb/ref 17592186605603} {:answer/id #uuid "f9e87827-2dcf-5ee9-ae1c-1a99767181e1" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C" :db/id #edb/ref 17592186605704}] :answer-field/correct {:answer/id #uuid "c36518f3-9d8f-570c-bc9d-9d52b3886265" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C" :db/id #edb/ref 17592186605603} :answer-field/id #uuid "b32f6229-f7ef-5aeb-8794-e2748decb297" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186605801}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9da80b7e-7d28-5432-bd06-d6318df2aa62" :question/math-academy-id "q-73679" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\frac{\\operatorname{cot}⁡z{csc}^{2}⁡z}{5+{cot}^{2}⁡z}\\,\\text{d}z.\n$$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\frac{\\text{d}}{\\text{d}z}(5+{cot}^{2}⁡z)=-2\\operatorname{cot}⁡z{csc}^{2}⁡z.\n$$\n\nSo, let $u=5+{cot}^{2}⁡z.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=-2\\operatorname{cot}⁡z{csc}^{2}⁡z\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\operatorname{cot}⁡z{csc}^{2}⁡z\\,\\text{d}z.\n$$\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{cot}⁡z{csc}^{2}⁡z}{5+{cot}^{2}⁡z}\\,\\text{d}z & =\\int \\frac{1}{5+{cot}^{2}⁡z}\\cdot (\\operatorname{cot}⁡z{csc}^{2}⁡z)\\,\\text{d}z \\\\  & =\\int \\frac{1}{u}\\cdot \\,(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5+{cot}^{2}⁡z|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(5+{cot}^{2}⁡z)+C\\end{aligned}\n$$\n\nNotice that, in the last step, we used that fact that $5+{cot}^{2}⁡z>0$ for all $z.$"} {:db/id #edb/ref 17592186611592 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abbf2fd-661b-577d-a513-f229acab8823" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x+2|+K" :db/id #edb/ref 17592186611113} {:answer/id #uuid "2bddba74-b12f-51cd-bb38-9bf41ed23c8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x|+K" :db/id #edb/ref 17592186611134} {:answer/id #uuid "47a14ae1-4a94-5f9b-be11-89fb0f1c002d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-\\operatorname{ln}⁡|\\operatorname{sec}⁡x|+K" :db/id #edb/ref 17592186611176} {:answer/id #uuid "736a618d-d978-55b7-b28d-0258c647fa80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x+2|+K" :db/id #edb/ref 17592186611253} {:answer/id #uuid "cb5b8794-e086-5e47-875a-8960900d59f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡x}{2}-2(\\operatorname{sec}⁡x+2)+K" :db/id #edb/ref 17592186611382}] :answer-field/correct {:answer/id #uuid "736a618d-d978-55b7-b28d-0258c647fa80" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x+2|+K" :db/id #edb/ref 17592186611253} :answer-field/id #uuid "39bad3fb-fb66-55d6-a03e-191c31db083f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186611483}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "608e4079-c5cf-5bc1-86f5-dc3d95b6c536" :question/math-academy-id "q-113992" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{{sec}^{2}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x+2}\\,\\text{d}x.\n$$" :question/worked-solution "Let $u=\\operatorname{sec}⁡x+2.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,⟹\\,\\text{d}u=\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{sec}^{2}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x+2}\\,\\text{d}x & =\\int \\frac{1}{\\operatorname{sec}⁡x+2}\\cdot {sec}^{2}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\operatorname{sec}⁡x+2}\\cdot \\operatorname{sec}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}(u-2)\\text{d}u \\\\  & =\\int (1-\\frac{2}{u})\\,\\text{d}u \\\\  & =u-2\\operatorname{ln}⁡|u|+C \\\\  & =(\\operatorname{sec}⁡x+2)-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x+2|+C \\\\  & =\\operatorname{sec}⁡x-2\\operatorname{ln}⁡|\\operatorname{sec}⁡x+2|+K\\end{aligned}\n$$\n\nwhere $K=C+2.$"} {:db/id #edb/ref 17592186611635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f681274-8155-51ee-ad77-348e7876de6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(2-\\frac{\\sqrt{3}}{3}\\right)" :db/id #edb/ref 17592186611184}] :answer-field/correct {:answer/id #uuid "4f681274-8155-51ee-ad77-348e7876de6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(2-\\frac{\\sqrt{3}}{3}\\right)" :db/id #edb/ref 17592186611184} :answer-field/id #uuid "0e64f1c3-2bf6-5c85-8785-62d619c1e862" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186611468}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cb44b163-37d5-508d-9ab8-65534f9ef9d3" :question/math-academy-id "q-350899" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\pi /4}^{\\pi /3}\\frac{{csc}^{2}⁡(x)}{2-\\operatorname{cot}⁡(x)}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=2-\\operatorname{cot}⁡(x),$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={csc}^{2}⁡(x)\\,⟹\\,\\text{d}u={csc}^{2}⁡(x)\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /4$ | $\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2-1/\\sqrt{3}$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /3}\\frac{{csc}^{2}⁡(x)}{2-\\operatorname{cot}⁡(x)}\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /3}\\frac{1}{2-\\operatorname{cot}⁡(x)}\\cdot {csc}^{2}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\,2-1/\\sqrt{3}}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|\\,{|}_{1}^{\\,2-1/\\sqrt{3}} \\\\  & =ln\\,(2-\\frac{1}{\\sqrt{3}})-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡(2-\\frac{1}{\\sqrt{3}})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186658911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c71a0a-4275-5b8a-bccf-d4231b72bd35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln\\left(\\frac{11}{9}\\right)" :db/id #edb/ref 17592186658749}] :answer-field/correct {:answer/id #uuid "e4c71a0a-4275-5b8a-bccf-d4231b72bd35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln\\left(\\frac{11}{9}\\right)" :db/id #edb/ref 17592186658749} :answer-field/id #uuid "b397fe91-52a9-5cb2-bc6b-e513305ae845" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186658883}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "04020b90-365b-571a-8c75-e2c949d4627a" :question/math-academy-id "q-350900" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\pi /6}^{\\pi /3}\\frac{\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u={sin}^{2}⁡(x)+2,$ then\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({sin}^{2}⁡(x)+2)=2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x).\n$$\n\nSo, differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,⟹\\,\\frac{1}{2}\\text{d}u=\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /6$ | $\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $9/4$ | $11/4$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}\\frac{\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)}{{sin}^{2}⁡(x)+2}\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /3}\\frac{1}{{sin}^{2}⁡(x)+2}\\cdot \\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{9/4}^{11/4}\\frac{1}{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{9/4}^{11/4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|{|}_{9/4}^{11/4} \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡\\left(\\frac{11}{4}\\right)-\\operatorname{ln}⁡\\left(\\frac{9}{4}\\right)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡\\left(\\frac{11}{9}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186658945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28e86867-633f-551d-9bf0-b746c8e64385" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(\\frac{3}{2}\\right)" :db/id #edb/ref 17592186658463}] :answer-field/correct {:answer/id #uuid "28e86867-633f-551d-9bf0-b746c8e64385" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln\\left(\\frac{3}{2}\\right)" :db/id #edb/ref 17592186658463} :answer-field/id #uuid "5fdcf189-7f8c-5cef-a469-75e9f58c3e36" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186658856}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "621ac2af-aa8d-5c1e-9e0f-da9ef50c366f" :question/math-academy-id "q-346380" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /2}\\frac{2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)}{{cos}^{2}⁡(x)+2}\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u={cos}^{2}⁡(x)+2,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,⟹\\,-\\text{d}u=2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /2$ |\n| --- | --- | --- |\n| $u$ | $3$ | $2$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\frac{2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)}{{cos}^{2}⁡(x)+2}\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{{cos}^{2}⁡(x)+2}\\cdot 2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{2}\\frac{1}{u}\\,(-\\text{d}u) \\\\  & =-{\\int }_{3}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|\\,{|}_{3}^{2} \\\\  & =-(\\operatorname{ln}⁡2-\\operatorname{ln}⁡3) \\\\  & =\\operatorname{ln}⁡3-\\operatorname{ln}⁡2 \\\\  & =\\operatorname{ln}⁡\\left(\\frac{3}{2}\\right)\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Quotients Containing Trigonometric Functions Using Substitution"}] :topic/math-academy-id 478 :topic/title "Integrating Trigonometric Functions Using Substitution"}]}
