ype/math} :answer/value "\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186268290} {:answer/id #uuid "fe106718-50d2-53cd-a30d-c21520e167e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186268381}] :answer-field/correct {:answer/id #uuid "fe106718-50d2-53cd-a30d-c21520e167e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C" :db/id #edb/ref 17592186268381} :answer-field/id #uuid "19c18458-8765-5ccd-8e3b-95cdb8f39a5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268448}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a1978088-009a-552d-a613-5fc9a66c590e" :question/math-academy-id "q-13474" :question/problem "$$\n\\displaystyle \\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\,\\text{d}x=\n$$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\,\\text{d}x & =4\\int {sec}^{2}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =4\\int {sec}^{2}⁡(u)\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{4}{3}\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡u+C \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a3a928-39e8-519d-8e4b-7c0882dd6b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{cot}⁡({x}^{2})+C" :db/id #edb/ref 17592186266580} {:answer/id #uuid "4bc87232-7fa2-5455-9bba-0f566c45856c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{csc}⁡({x}^{2})+C" :db/id #edb/ref 17592186266815} {: