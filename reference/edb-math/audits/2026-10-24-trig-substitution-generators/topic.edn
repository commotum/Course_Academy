}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307}] :answer-field/correct {:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307} :answer-field/id #uuid "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(- \\frac{\\pi}{16}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{2 \\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{7}{3}\\left(\\frac{3}{4}\\right)\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}}\\\\ &=\\frac{7}{4}\\left(\\sin\\left(\\frac{2 \\pi}{3}\\right)-\\sin\\left(\\frac{\\pi}{4}\\right)\\right)\\\\ &=\\frac{7}{4}\\left(\\left(\\frac{\\sqrt{3}}{2}\\right)-\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\\\ &=- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186676242} {:answer/id #uuid "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186676271} {:answer/id #uuid "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{27}{2}" :db/id #edb/ref 17592186676283} {:answer/id #uuid "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186676287} {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312}] :answer-field/correct {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312} :answer-field/id #uuid "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=\\frac{2 x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{2}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(- \\frac{\\pi}{4}\\right)+\\left(0\\right)=- \\frac{\\pi}{6}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\\\\ &=9\\left(\\frac{3}{2}\\right)\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\left[\\sin\\left(u\\right)\\right]_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}}\\\\ &=\\frac{27}{2}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(- \\frac{\\pi}{6}\\right)\\right)\\\\ &=\\frac{27}{2}\\left(\\left(\\frac{1}{2}\\right)-\\left(- \\frac{1}{2}\\right)\\right)\\\\ &=\\frac{27}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}" :db/id #edb/ref 17592186676260}] :answer-field/correct {:answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}" :db/id #edb/ref 17592186676260} :answer-field/id #uuid "159128b8-e040-5516-a836-f601577308cb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676239}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bde0ea65-e851-569d-a00d-23c578b58f06" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{2}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{2}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{6}\\\\ x=\\frac{15 \\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{15 \\pi}{16}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{7 \\pi}{4}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{2}}^{\\frac{15 \\pi}{16}} \\frac{3}{4}\\sin\\left(\\frac{4 x}{3} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{3}{4}\\left(\\frac{3}{4}\\right)\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\int_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{9}{16}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}}\\\\ &=- \\frac{9}{16}\\left(\\cos\\left(\\frac{7 \\pi}{4}\\right)-\\cos\\left(\\frac{7 \\pi}{6}\\right)\\right)\\\\ &=- \\frac{9}{16}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256}] :answer-field/correct {:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256} :answer-field/id #uuid "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676306}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c367b576-70c2-5965-8278-60a472b975f2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=- \\frac{2 x}{5} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{2}{5},\\qquad \\mathrm{d}x=\\left(- \\frac{5}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{15 \\pi}{4}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(- \\frac{15 \\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{11 \\pi}{6}\\\\ x=\\frac{5 \\pi}{24}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(\\frac{5 \\pi}{24}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{4}{3}\\left(- \\frac{5}{2}\\right)\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}}\\\\ &=\\frac{10}{3}\\left(\\cos\\left(\\frac{\\pi}{4}\\right)-\\cos\\left(\\frac{11 \\pi}{6}\\right)\\right)\\\\ &=\\frac{10}{3}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300}] :answer-field/correct {:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300} :answer-field/id #uuid "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676285}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=- \\frac{3 x}{2} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{3}{2},\\qquad \\mathrm{d}x=\\left(- \\frac{2}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7 \\pi}{9}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{7 \\pi}{9}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{5 \\pi}{3}\\\\ x=- \\frac{\\pi}{6}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{\\pi}{6}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{3 \\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{5}{3}\\left(- \\frac{2}{3}\\right)\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\left[\\sin\\left(u\\right)\\right]_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}}\\\\ &=- \\frac{10}{9}\\left(\\sin\\left(\\frac{3 \\pi}{4}\\right)-\\sin\\left(\\frac{5 \\pi}{3}\\right)\\right)\\\\ &=- \\frac{10}{9}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302}] :answer-field/correct {:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302} :answer-field/id #uuid "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676311}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{\\pi x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\pi}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{\\pi}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{1}{3}&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(\\frac{1}{3}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x\\\\ &=7\\left(\\frac{2}{\\pi}\\right)\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\left[\\sin\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{6}}\\\\ &=\\frac{14}{\\pi}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(0\\right)\\right)\\\\ &=\\frac{14}{\\pi}\\left(\\left(\\frac{1}{2}\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{7}{\\pi}.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Trigonometric Functions With Linear Arguments"} {:db/id #edb/ref 17592186068916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068568 :question/id #uuid "daf5cc74-4c7d-500a-9345-03bd6b73a333" :question/math-academy-id "e-465" :question/problem "Calculate the integral $$\n\\displaystyle\\int 5 \\csc {\\left(6x+\\dfrac \\pi 3\\right)} \\cot {\\left(6x+\\dfrac \\pi 3\\right)} \\,  \\textrm{d}x.\n$$" :question/worked-solution "If we let $u=6x+\\dfrac \\pi 3,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 6\\quad\\Longrightarrow\\quad \\textrm d x =\\dfrac 1 6\\, \\textrm d u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5\\operatorname{csc}⁡(6x+\\frac{\\pi }{3})\\operatorname{cot}⁡(6x+\\frac{\\pi }{3})\\,\\text{d}x & =5\\int \\operatorname{csc}⁡(6x+\\frac{\\pi }{3})\\operatorname{cot}⁡(6x+\\frac{\\pi }{3})\\,\\text{d}x \\\\  & =5\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{5}{6}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{5}{6}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{5}{6}\\operatorname{csc}⁡(6x+\\frac{\\pi }{3})+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "084eb4cc-2f84-5288-90a6-be84066922b6" :knowledge-point/questions [{:db/id #edb/ref 17592186069004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a40602-52d1-5dc9-8e31-c35464767acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186235799} {:answer/id #uuid "3eec2768-c2bf-5731-b512-c6df48d8bb5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186236217} {:answer/id #uuid "4e578f69-909a-523b-8577-e3cdb3de2088" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186236318} {:answer/id #uuid "d4240689-1a4e-5384-9ef2-fdfe11a2085d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186237156} {:answer/id #uuid "e779e3e4-8675-5338-a515-5145e18de6ae" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186237271}] :answer-field/correct {:answer/id #uuid "00a40602-52d1-5dc9-8e31-c35464767acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186235799} :answer-field/id #uuid "ea812aef-b957-50aa-a86e-5bc828f0e956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237741}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8ab6145f-e13a-585c-bc5c-d4f390fce17e" :question/math-academy-id "q-10143" :question/problem "Calculate the integral $$\n\\displaystyle \\int \\operatorname{sec}⁡(7x)\\operatorname{tan}⁡(7x)\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=7x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=7\\,⟹\\,\\text{d}x=\\frac{1}{7}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡(7x)\\operatorname{tan}⁡(7x)\\,\\text{d}x & =\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot \\frac{1}{7}\\,\\text{d}u \\\\  & =\\frac{1}{7}\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{7}\\operatorname{sec}⁡u+C \\\\  & =\\frac{1}{7}\\operatorname{sec}⁡(7x)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f85cf725-3237-5c2c-aa64-a45c7c2a4c32" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc (8x) + C" :db/id #edb/ref 17592186065470} {:answer/id #uuid "f8a92f4d-c241-5c04-a633-0e1a6d38dbbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\csc (8x) + C" :db/id #edb/ref 17592186065471} {:answer/id #uuid "1639954a-f29a-5655-9185-4c5ede14b2a1" :answer/type {:db/ident :answer.type/math} :answer/value "8\\csc (8x) + C" :db/id #edb/ref 17592186065472} {:answer/id #uuid "3f09ad16-8c32-567b-88f6-1ca96ba704c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}\\csc (8x) + C" :db/id #edb/ref 17592186065473} {:answer/id #uuid "4ff43ea7-a48a-5ab2-b9b1-77d7fc4ac4c2" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\csc (8x) + C" :db/id #edb/ref 17592186065474}] :answer-field/id #uuid "1ec74542-ab43-577e-9fef-7369f259e3e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065469}] :question/id #uuid "f0f4b98b-3f84-50e2-bc7f-218a4abdb553" :question/math-academy-id "q-10157" :question/problem "Calculate the integral $$\n\\displaystyle \\int\\csc (8x)\\cot (8x)dx.\n$$"} {:db/id #edb/ref 17592186250146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33da3ed1-1777-5bf4-8cfc-9e5a29ccb4c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{tan}^{3}⁡x}{3}+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186247891} {:answer/id #uuid "62494273-c0c0-5f7f-8ebb-533f7f201a63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186248310} {:answer/id #uuid "89765658-5c5b-5edc-a80e-0d5330eacbc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248646} {:answer/id #uuid "8df579a6-b4b7-59be-810b-4b8fd64e8efe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{3}⁡x}{3}+C" :db/id #edb/ref 17592186248688} {:answer/id #uuid "ce4aa2aa-cecd-5b62-ae9a-109027768536" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{tan}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249252}] :answer-field/correct {:answer/id #uuid "89765658-5c5b-5edc-a80e-0d5330eacbc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248646} :answer-field/id #uuid "812aa8aa-0438-595b-bab8-2d74de8d3b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9801153f-b480-580e-a696-7b55c194e174" :question/math-academy-id "q-113983" :question/problem "Calculate the integral $$\n\\displaystyle \\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=\\operatorname{sec}⁡x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,⟹\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int ({sec}^{2}⁡x+1)\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\int ({u}^{2}+1)\\,\\text{d}u \\\\  & =\\frac{{u}^{3}}{3}+u+C \\\\  & =\\frac{{sec}^{3}⁡x}{3}+\\operatorname{sec}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519b8fb0-5928-5ec9-8613-12c9d1306f72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266873} {:answer/id #uuid "60890db1-c6f4-5143-9b9a-ae422da31c9c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186266994} {:answer/id #uuid "87157abc-6212-562b-a343-90c57626ecf4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186267338} {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} {:answer/id #uuid "919ec147-de01-530b-97cb-da754894b913" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186267439}] :answer-field/correct {:answer/id #uuid "8b99c65a-2714-56e5-af5f-38d5a8ea0940" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186267396} :answer-field/id #uuid "8c52e3dd-dd13-5927-892c-f499bebd302f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268655}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "996adb7b-cb39-5733-9d5d-ec3bcfe1a670" :question/math-academy-id "q-13663" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /9$ | $\\pi /6$ |\n| --- | --- | --- |\n| $u$ | $\\pi /3$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /9}^{\\pi /6}2{csc}^{2}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /3}^{\\pi /2}2{csc}^{2}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{\\pi /3}^{\\pi /2}{csc}^{2}⁡u\\,\\text{d}u \\\\  & =-\\frac{2}{3}\\operatorname{cot}⁡u{|}_{\\pi /3}^{\\pi /2} \\\\  & =-\\frac{2}{3}(\\operatorname{cot}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cot}⁡\\left(\\frac{\\pi }{3}\\right)) \\\\  & =-\\frac{2}{3}(0-\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{2\\sqrt{3}}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c351233-a918-5f2c-867c-b36c3e634b45" :answer/type {:db/ident :answer.type/math} :answer/value "10\\operatorname{sec}⁡(10x)+C" :db/id #edb/ref 17592186288675} {:answer/id #uuid "6387ca6c-9af3-5305-93ac-6ba215b43157" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{csc}⁡(10x)+C" :db/id #edb/ref 17592186288729} {:answer/id #uuid "6c47091c-3dbb-514d-926c-70024a19ee8c" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡(10x)+C" :db/id #edb/ref 17592186288795} {:answer/id #uuid "9c25054c-c830-5cdc-9739-35307de9de4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186289083} {:answer/id #uuid "a683964a-9c75-50e4-b041-7650006dc260" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sec}⁡(10x)+C" :db/id #edb/ref 17592186289134}] :answer-field/correct {:answer/id #uuid "a683964a-9c75-50e4-b041-7650006dc260" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sec}⁡(10x)+C" :db/id #edb/ref 17592186289134} :answer-field/id #uuid "0a9a7120-01c4-56ed-a4cb-cf7ba476dd9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289753}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "799e6798-92e1-543f-a4d9-7d772e9877f8" :question/math-academy-id "q-2203" :question/problem "$$\n\\displaystyle \\int \\operatorname{sec}⁡(10x)\\operatorname{tan}⁡(10x)\\,\\text{d}x=\n$$" :question/worked-solution "If we let $u=10x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,⟹\\,\\text{d}x=\\frac{1}{10}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡(10x)\\operatorname{tan}⁡(10x)\\,\\text{d}x & =\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot \\frac{1}{10}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{10}\\operatorname{sec}⁡u+C \\\\  & =\\frac{1}{10}\\operatorname{sec}⁡(10x)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eb82788-efbe-50de-b226-6bde5d6aedf2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186317886}] :answer-field/correct {:answer/id #uuid "5eb82788-efbe-50de-b226-6bde5d6aedf2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186317886} :answer-field/id #uuid "47ffe2b0-f398-575b-afe8-d12d64c3f4fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318580}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ec7ce12f-cbf4-5c03-8053-383589db4d45" :question/math-academy-id "q-346368" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{2\\pi /3}^{2\\pi }\\operatorname{csc}⁡\\left(\\frac{x}{4}\\right)\\operatorname{cot}⁡\\left(\\frac{x}{4}\\right)\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=\\frac{x}{4},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $2\\pi /3$ | $2\\pi $ |\n| --- | --- | --- |\n| $u$ | $\\pi /6$ | $\\pi /2$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{2\\pi /3}^{2\\pi }\\operatorname{csc}⁡\\left(\\frac{x}{4}\\right)\\operatorname{cot}⁡\\left(\\frac{x}{4}\\right)\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /2}\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\cdot 4\\,\\text{d}u \\\\  & =4{\\int }_{\\pi /6}^{\\pi /2}\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =4(-\\operatorname{csc}⁡(u))\\,{|}_{\\pi /6}^{\\pi /2} \\\\  & =4(-\\operatorname{csc}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{csc}⁡\\left(\\frac{\\pi }{6}\\right)) \\\\  & =4(-1+2) \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9793ffe-67cc-5645-9b00-c140cc88e2aa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318233}] :answer-field/correct {:answer/id #uuid "c9793ffe-67cc-5645-9b00-c140cc88e2aa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318233} :answer-field/id #uuid "24f68f41-ba58-5d4c-9946-589591e9529a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318497}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8ccae74f-35c6-57d0-a03f-750b899cc692" :question/math-academy-id "q-350060" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /4}3{sec}^{2}⁡(x-\\frac{\\pi }{4})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=x-\\frac{\\pi }{4},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /4$ |\n| --- | --- | --- |\n| $u$ | $-\\pi /4$ | $0$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}3{sec}^{2}⁡(x-\\frac{\\pi }{4})\\,\\text{d}x & =3{\\int }_{-\\pi /4}^{0}{sec}^{2}⁡(u)\\,\\text{d}u \\\\  & =3\\operatorname{tan}⁡(u){|}_{-\\pi /4}^{0} \\\\  & =3(0-(-1)) \\\\  & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85c49c8e-61d5-5e58-a395-01a4e606b7d6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318020}] :answer-field/correct {:answer/id #uuid "85c49c8e-61d5-5e58-a395-01a4e606b7d6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318020} :answer-field/id #uuid "773a7395-c2f8-5568-bc4a-ffe056234383" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318675}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d188146f-1019-54e0-bddf-9c317ac884d3" :question/math-academy-id "q-350071" :question/problem "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\pi /3}^{2\\pi /3}4\\operatorname{csc}⁡(x-\\frac{\\pi }{6})\\operatorname{cot}⁡(x-\\frac{\\pi }{6})\\,\\text{d}x=\n$$\n{{field-1}}" :question/worked-solution "If we let $u=x-\\frac{\\pi }{6},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /3$ | $2\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $\\pi /6$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /3}^{2\\pi /3}4\\operatorname{csc}⁡(x-\\frac{\\pi }{6})\\operatorname{cot}⁡(x-\\frac{\\pi }{6})\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /2}4\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =4{\\int }_{\\pi /6}^{\\pi /2}\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =-4\\operatorname{csc}⁡(u){|}_{\\pi /6}^{\\pi /2} \\\\  & =-4(\\operatorname{csc}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{csc}⁡\\left(\\frac{\\pi }{6}\\right)) \\\\  & =-4(1-2) \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186429931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bde6a22f-af92-5d05-a00e-ee43025b38b1" 