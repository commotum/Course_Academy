^{x}\\cdot \\left(\\frac{1}{y}\\right)+{x}^{7}\\cdot (1) \\\\  & =\\frac{{e}^{x}}{y}+{x}^{7}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $\\left(1,\\frac{1}{2}\\right):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1/2)} & =\\frac{{e}^{1}}{\\left(\\frac{1}{2}\\right)}+{1}^{7} \\\\  & =2e+1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dacf2f-9956-5eff-b30e-18510d8360b3" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186275708} {:answer/id #uuid "56d691d2-2344-50e8-b755-1515d6701246" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186276253} {:answer/id #uuid "8909b9e2-69c1-5292-8bb6-bb0f8619ca13" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276715} {:answer/id #uuid "be12f9bb-678a-5eac-a78c-690ff881310b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277173} {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507}] :answer-field/correct {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507} :answer-field/id #uuid "16fdfad6-c4ab-5074-9d21-20b8c8a78547" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277765}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "099a0674-bec3-5a03-b0cd-02423c11a6a6" :question/math-academy-id "q-159602" :question/problem "For the function $f(x,y)=4y{x}^{2}-x{y}^{4},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(4y{x}^{2}-x{y}^{4}) \\\\  & =\\frac{∂}{∂y}(4y{x}^{2})-\\frac{∂}{∂y}(x{y}^{4}) \\\\  & =4{x}^{2}\\cdot \\frac{∂}{∂y}(y)-x\\cdot \\frac{∂}{∂y}({y}^{4}) \\\\  & =4{x}^{2}\\cdot (1)-x\\cdot (4{y}^{3}) \\\\  & =4{x}^{2}-4x{y}^{3}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(2,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,1)} & =4\\cdot {2}^{2}-4\\cdot 2\\cdot {1}^{3} \\\\  & =16-8 \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} {:answer/id #uuid "2307c0e9-79a7-5b71-94fb-81d1846549c4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186275789} {:answer/id #uuid "24ba32c9-8d5c-5863-b6a3-b590ddbbf12f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275808} {:answer/id #uuid "2bdb0760-9291-5b88-884e-ce3f76c09234" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275876} {:answer/id #uuid "cfdca77f-9773-5630-851d-65b8078cfedf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277318}] :answer-field/correct {:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} :answer-field/id #uuid "370efeef-a1d5-51c2-8154-bfdd43bcb49d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277810}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "761131e3-fd5c-5281-9b00-7e9bad552026" :question/math-academy-id "q-159607" :question/problem "For the function $f(x,y)=x\\operatorname{sec}⁡y+{x}^{4}y,$ evaluate ${f}_{y}\\left(\\sqrt{2},\\frac{\\pi }{4}\\right).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y+{x}^{4}y) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y)+\\frac{∂}{∂y}({x}^{4}y) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\operatorname{sec}⁡y)+{x}^{4}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot (\\operatorname{sec}⁡y\\operatorname{tan}⁡y)+{x}^{4}\\cdot (1) \\\\  & =x\\operatorname{sec}⁡y\\operatorname{tan}⁡y+{x}^{4}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $\\left(\\sqrt{2},\\frac{\\pi }{4}\\right):$\n\n$$\n\\begin{aligned}{f}_{y}\\left(\\sqrt{2},\\frac{\\pi }{4}\\right) & =\\sqrt{2}\\cdot \\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)\\cdot \\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)+{(\\sqrt{2})}^{4} \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1+4 \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383a34d-6e32-5f0f-87b8-e7ec3d81fb75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186381183} {:answer/id #uuid "f18943a3-6ebe-57f1-9bae-7fc754040e67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186381184} {:answer/id #uuid "062115ff-ad39-57f6-a416-c53bab27effc" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186381185} {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} {:answer/id #uuid "5f7541dc-dac5-5424-9421-52ce964411eb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186381187}] :answer-field/correct {:answer/id #uuid "b69cec9b-5a43-5293-af5f-d7b292e1fc03" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186381186} :answer-field/id #uuid "7d6eafe7-491c-520d-9960-7135619c340c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "83c38041-fc9b-546f-afa6-2d3c332d1b5a" :question/math-academy-id "q-159587" :question/problem "For the function $f(x,y)={y}^{2}\\sqrt{x}+\\frac{x}{y},$ evaluate $\\frac{∂f}{∂y}$ at the point $(4,2).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}\\left({y}^{2}\\sqrt{x}+\\frac{x}{y}\\right) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x}+x{y}^{-1}) \\\\  & =\\frac{∂}{∂y}({y}^{2}\\sqrt{x})+\\frac{∂}{∂y}(x{y}^{-1}) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂y}({y}^{2})+x\\cdot \\frac{∂}{∂y}({y}^{-1}) \\\\  & =\\sqrt{x}\\cdot (2y)+x\\cdot (-{y}^{-2}) \\\\  & =2y\\sqrt{x}-x{y}^{-2}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(4,2):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(4,2)} & =2\\cdot 2\\cdot \\sqrt{4}-4\\cdot {2}^{-2} \\\\  & =8-1 \\\\  & =7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb46f74-a6ac-51dd-9716-053467775795" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186381197} {:answer/id #uuid "7c752b1e-3494-58b3-91b3-bc63d9070f67" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381198} {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} {:answer/id #uuid "57c21eba-c639-589d-a590-6b2758f94e7d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #e