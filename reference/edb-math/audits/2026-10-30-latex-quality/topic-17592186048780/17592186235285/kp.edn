 opposite directions\n\nHence, $\\overset{\\to }{PC}=-2.5a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-b-2.5a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-b=-2.5a-b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-2.5\n$$"} {:db/id #edb/ref 17592186235582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} {:answer/id #uuid "2b5b4c72-e340-52b5-be53-6903f63361a5" :answer/type {:db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186234611} {:answer/id #uuid "cbe36434-9519-583f-9b69-c587e4937715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234866} {:answer/id #uuid "ce1ea7c1-61ca-56ba-a7d9-91573e3d6a5b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186234869} {:answer/id #uuid "f46ca5b6-1fd3-597e-9657-e4197a5f9d69" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234933}] :answer-field/correct {:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} :answer-field/id #uuid "1aa48e98-a238-5102-8717-85e261cb4e21" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186234997}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "adcdd06d-1586-51df-9df4-c005428c239d" :question/math-academy-id "q-77451" :question/problem "![](images/28/28faea3a553c505a8a5ab9bc7dd6e784dd23a47c336c70d31218fbe249d57cff.png)\n\nConsider the picture above. Given that $c=\\lambda a+3b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+3b.\n$$\n\nWe are given that one of the components is $3b.$ So, we first draw the vector $3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/52/52421034c2919620a0a9aae844db0eba2d396e5d6f1152d69bee40ff56c4d8ad.png)\n\nLet $P$ be the endpoint of the vector $3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+3b=-3a+3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"} {:db/id #edb/ref 17592186515712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4da28143-ae1e-53c2-85bd-91c7c535e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186515716}] :answer-field/correct {:answer/id #uuid "4da28143-ae1e-53c2-85bd-91c7c535e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186515716} :answer-field/id #uuid "b8ab3833-1274-5984-a0a3-6805b92bafd7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186515728}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "060319a5-0bfc-5149-907b-0b9762872943" :question/problem "![](images/bb/bbba20dcef04ed64a7e92425c0e5a05146264225718c42a2343e29b2db6d65ab.png)\n\nConsider the picture above. If $c=\\lambda a+b,$ then$\\,\\lambda =$\n{{field-1}}." :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+b.\n$$\n\nWe are given that one of the components is $b.$ So, we first draw the vector $b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/78/78afd350dba16899e827e5e8a70cc42512d2466440495ef192f93b2b29357540.png)\n\nLet $P$ be the endpoint of the vector $b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+b=-3a+b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"} {:db/id #edb/ref 17592186515721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52f27c57-6e11-56bc-9c31-145871e25550" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186515719} {:answer/id #uuid "5ca86c3f-6682-5ebd-994f-73db90ea5e0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186515720} {:answer/id #uuid "75c889ff-833b-5752-a882-570604d73b49" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186515724} {:answer/id #uuid "c860ecc2-edc7-5f60-b973-d274a09c4a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186515729} {:answer/id #uuid "ec004c24-d148-5708-9571-cd0fcfcecb0a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186515733}] :answer-field/correct {:answer/id #uuid "75c889ff-833b-5752-a882-570604d73b49" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186515724} :answer-field/id #uuid "c902e0cf-62a8-5d36-922f-004b7c3cc826" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515731}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5f5af3e1-dbc7-5800-92e9-4c4976903ec1" :question/problem "![](images/be/beda5b067e95a146c3d0f9c3de76ecd07049db21db4d13c76ee846