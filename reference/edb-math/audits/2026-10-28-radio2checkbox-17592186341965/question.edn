#{[{:db/id #edb/ref 17592186341965 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aee028a-5473-56b8-aee5-bdb011708151" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 17592186339222} {:answer/id #uuid "38edbb45-8a8f-5c9f-89e6-a14df9e79c49" :answer/type {:db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id #edb/ref 17592186339640} {:answer/id #uuid "4c17b524-97bf-5d55-bc46-acf8d26004be" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186339813} {:answer/id #uuid "62113950-85db-5a6d-98d6-ae248b3847ad" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186340002} {:answer/id #uuid "d6ac01be-6526-5f9f-b3ca-56e460493d3b" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$" :db/id #edb/ref 17592186341031}] :answer-field/correct {:answer/id #uuid "62113950-85db-5a6d-98d6-ae248b3847ad" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186340002} :answer-field/id #uuid "a711b931-a46e-513a-9ac0-e43329d1aa18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341671}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3747ead0-6028-5b33-a0a9-4b842fbf83b2" :question/math-academy-id "q-73401" :question/problem "![](images/48/48569328379c72215884b759687c7c40ced06f9864d05d2638e4389694f90630.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the stationary points?" :question/worked-solution "A stationary point of $f(x)$ is the value of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that at $x=0,$ the tangent to the graph is horizontal, so we have ${f}^{′}(0)=0.$\n\n![](images/57/576d25a420f1f4ebcbd0e9b055d7a27159caa8f1721ff5f35a32b86c3e3a0fb3.png)\n\n  \n\nTherefore, there is only one stationary point, and its $x$-coordinate is $x=0.$\n\n**Note:** At $x=2$, there is a sharp corner, so ${f}^{′}(2)$ doesn't exist. This gives one more critical point. But this is not a stationary point." :task-item/_content [{:db/id #edb/ref 17592186729422 :task-item/content {:db/id #edb/ref 17592186341965} :task-item/elapsed-seconds 21.574 :task-item/id #uuid "069e03e8-6fd5-4015-81a8-2af125dcd7df" :task-item/next {:db/id #edb/ref 17592186729440} :task-item/responses [{:answer/id #uuid "62113950-85db-5a6d-98d6-ae248b3847ad" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186340002}] :task-item/status {:db/ident :task-item.status/correct} :task-item/working-ended-at #inst "2026-10-28T16:40:26.086Z"}]}]}
