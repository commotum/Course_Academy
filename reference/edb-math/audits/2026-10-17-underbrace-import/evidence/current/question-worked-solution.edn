{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2}\\end{bmatrix}\\,⟹\\,\\left\\{\\begin{aligned}{x}_{1} &=\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2} \\\\ {x}_{2} &=\\frac{1}{\\sqrt{2}}{y}_{1}+\\frac{1}{\\sqrt{2}}{y}_{2},\\end{aligned}\\right.\n$$\n\nWe know that the given change of variables reduces $Q(x)$ to its canonical form. Therefore, performing the change of variables on $C,$ we obtain \n\n$$\n\\begin{aligned}{x}_{1}^{2}+2{x}_{1}{x}_{2}+{x}_{2}^{2}+4\\sqrt{2}{x}_{1} & =4 \\\\ 2{y}_{1}^{2}+4\\sqrt{2}(\\frac{1}{\\sqrt{2}}{y}_{1}-\\frac{1}{\\sqrt{2}}{y}_{2}) & =4 \\\\ 2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4\\end{aligned}\n$$\n\n \n\nNow, we complete the square for the variable ${y}_{1}:$ \n\n$$\n\\begin{aligned}2{y}_{1}^{2}+4{y}_{1}-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1})-4{y}_{2} & =4 \\\\ 2({y}_{1}^{2}+2{y}_{1}+1-1)-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2}-2\\cdot 1-4{y}_{2} & =4 \\\\ 2({y}_{1}+1)^{2} & =4{y}_{2}+6 \\\\ 2({y}_{1}+1)^{2} & =4({y}_{2}+\\frac{3}{2})\\end{aligned}\n$$\n\nFinally, performing the change of variables \n\n$$\n\\left\\{\\begin{aligned}{z}_{1} &={y}_{1}+1, \\\\ {z}_{2} &={y}_{2}+\\frac{3}{2},\\end{aligned}\\right.\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}2({y}_{1}+1)^{2} & =4({y}_{2}+\\frac{3}{2}) \\\\ 2{z}_{1}^{2} & =4{z}_{2} \\\\ {z}_{1}^{2} & =2{z}_{2}\\end{aligned}\n$$\n\n \n\nThis represents a parabola that opens in the direction of the positive ${z}_{2}$-axis." 13194139535661 17592186045443] [17592186367561 "Recall that for any $2\\times 2$ real matrix $A$ with complex eigenvalues, we have $A=PC{P}^{-1},$ where \n\n$$\nP=\\begin{bmatrix}| & | \\\\ \\text{Re}(v) & \\text{Im}(v) \\\\ | & |\\end{bmatrix},\\,C=\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix},\n$$\n\nand $v$ is an eigenvector of $A$ corresponding to the complex eigenvalue  $\\lambda .$\n\nFirst, notice that \n\n$$\n\\begin{bmatrix}\\text{Re}(\\lambda ) & \\text{Im}(\\lambda ) \\\\ -\\text{Im}(\\lambda ) & \\text{Re}(\\lambda )\\end{bmatrix}=\\begin{bmatrix}2 & -2 \\\\ 2 & 2\\end{bmatrix}\\ne C,\n$$\n\nwhile\n\n$$\n\\begin{bmatrix}\\text{Re}(\\overset{―}{\\lambda }) & \\text{Im}(\\overset{―}{\\lambda }) \\\\ -\\text{Im}(\\overset{―}{\\lambda }) & \\text{Re}(\\overset{―}{\\lambda })\\end{bmatrix}=\\begin{bmatrix}2 & 2 \\\\ -2 & 2\\end{bmatrix}=C.\n$$\n\nSo, our rotation-scaling matrix $C$ corresponds to the eigenvalue $\\overset{―}{\\lambda }=2+2\\text{i},$ \n the complex conjugate of $\\lambda .$ Hence, to construct the matrix $P,$ we use the eigenvector $\\overset{―}{v},$ the complex conjugate of $v.$\n\nNext, we find the real and imaginary parts of our eigenvector:\n\n$$\n\\begin{aligned}\\overset{―}{v} & =\\begin{bmatrix}3\\text{i} \\\\ -5-8\\text{i}\\end{bmatrix}={{\\begin{bmatrix}0 \\\\ -5\\end{bmatrix}}_{⏟}}_{\\text{Re}(\\overset{―}{v})}+\\text{i}{{\\begin{bmatrix}3 \\\\ -8\\end{bmatrix}}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & 3 \\\\ -5 & -8\\end{bmatrix}.\\end{aligned}\n$$" 13194139535488 17592186045443] [17592186369106 "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$ So, we want to find ${x}_{1},{x}_{2},{x}_{3}\\in R$ such that \n\n$$\n{x}_{1}{{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}}_{⏟}}_{{a}_{1}}+{x}_{2}{{\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix}}_{⏟}}_{{a}_{2}}+{x}_{3}{{\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}}_{⏟}}_{{a}_{3}}={{\\begin{bmatrix}6 \\\\ 15 \\\\ -4\\end{bmatrix}}_{⏟}}_{{a}_{4}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3} &=6 \\\\ 2{x}_{1}+3{x}_{2}+2{x}_{3} &=15 \\\\ -{x}_{1}-{x}_{2} &=-4\\end{aligned}\\right.\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,\\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 2 & 3 & 2 & 15 \\\\ -1 & -1 & 0 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 0 & 1 & 0 & 3 \\\\ -1 & -1 & 0 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 1 & 6 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 2\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 1 & 0 & 4 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 2\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that the pivot columns are the $1$st, $2$nd, and $3$rd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$\nAlso, the matrix tells us that ${x}_{1}=1,$ ${x}_{2}=3,$ and ${x}_{3}=2,$ meaning that\n\n$$\n1\\cdot {{\\begin{bmatrix}1 \\\\ 2 \\\\ -1\\end{bmatrix}}_{⏟}}_{{a}_{1}}+3\\cdot {{\\begin{bmatrix}1 \\\\ 3 \\\\ -1\\end{bmatrix}}_{⏟}}_{{a}_{2}}+2\\cdot {{\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}}_{⏟}}_{{a}_{3}}={{\\begin{bmatrix}6 \\\\ 15 \\\\ -4\\end{bmatrix}}_{⏟}}_{{a}_{4}}.\n$$\n\nTherefore, ${x}_{1}+{x}_{2}+{x}_{3}=1+3+2=6.$" 13194139535661 17592186045443] [17592186369553 "Using the constant multiple, the addition rule for limits, and the fact that both functions are continuous, we get\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}[2f(t)+g(t)] & ={lim}_{t\\to 1}2f(t)+{lim}_{t\\to 1}g(t) \\\\  & =2{lim}_{t\\to 1}f(t)+{lim}_{t\\to 1}g(t) \\\\  & =2f(1)+g(1) \\\\  & =2{{⟨0,1,-2⟩}_{⏟}}_{f(1)}+g(1) \\\\  & =⟨0,2,-4⟩+g(1).\\end{aligned}\n$$\n\nOn the other hand, we are told that\n\n$$\n{lim}_{t\\to 1}[2f(t)+g(t)]=⟨-1,4,2⟩.\n$$\n\nTherefore, we obtain the following equation which we can solve for $g(1):$ \n\n$$\n\\begin{aligned}{lim}_{t\\to 1}[2f(t)+g(t)] & =⟨-1,4,2⟩ \\\\ ⟨0,2,-4⟩+g(1) & =⟨-1,4,2⟩ \\\\ g(1) & =⟨-1,4,2⟩-⟨0,2,-4⟩ \\\\ g(1) & =⟨-1,2,6⟩\\end{aligned}\n$$" 13194139533452 17592186045417] [17592186369755 "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-3 \\\\ -1 \\\\ 2 \\\\ 3 \\\\ 5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 32\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2.8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=-2.8+2x.$" 13194139535488 17592186045443] [17592186369762 "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 4 \\\\ 7 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\n \n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}6 & -2 \\\\ -2 & 4\\end{bmatrix}\\begin{bmatrix}22 \\\\ 26\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=4+3x.$" 13194139535488 17592186045443] [17592186369894 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=2x+2y$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-2,\\,-2,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=0,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨2,\\,2,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=0.\n$$\n\nSince we require a downward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is negative. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨2,\\,2,\\,-1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨2,\\,2,\\,-1⟩}{\\sqrt{{2}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{1}{3}⟨2,\\,2,\\,-1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=2x+2y$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨3-x,\\,x+y,\\,z-2x⟩\\cdot \\frac{1}{3}⟨2,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{3}⟨3-x,\\,x+y,\\,2y⟩\\cdot ⟨2,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{3}(2(3-x)+2(x+y)-2y) \\\\  & =\\frac{1}{3}(6-2x+2x+2y-2y) \\\\  & =\\frac{6}{3} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text