// Arrows show processing, dependencies, and recovery in the CURRENT capture code.
// Traced 2026-10-10. Unlike engine-dependencies.dots, this describes implemented paths.
// Solid = live flow. Dotted = stored evidence / supporting input.
// Dashed amber = recovery; dashed purple = separately reviewed held-question batches.
// Render: dot -Tsvg capture-process.dots -o capture-process.svg
//         dot -Tpng -Gdpi=160 capture-process.dots -o capture-process.png
// Code: ../scripts/question_capture/{capture,browser,activities,assessment,multistep,
//       diagnostic,authoritative,math_content,math_database,database,image_library,
//       saved_imports,capture_repair,priorities,answer_policy}.py and dom.js.
// Live source preparation does NOT yet include the recent broad worked-solution
// matching, manual field binding, image -a-1 heuristic, or batch empty-MathML guard.
// Those are shown only in the separate reviewed-recovery node.

digraph CaptureProcess {
  graph [label="Course Academy - Capture Process\nCurrent capture, source preparation, storage, and recovery",
    labelloc=t, labeljust=l, fontname="DejaVu Sans", fontsize=23, bgcolor="white",
    rankdir=TB, nodesep=0.34, ranksep=0.62, pad=0.35,
    splines=polyline, outputorder=edgesfirst, compound=true, newrank=true];
  node [shape=box, style=filled, fillcolor="#f3f4f6", color="#374151",
    fontcolor="#111827", fontname="DejaVu Sans", fontsize=12,
    margin="0.18,0.13", penwidth=1.1];
  edge [color="#64748b", arrowsize=0.7, penwidth=1.1,
    fontname="DejaVu Sans", fontsize=10, fontcolor="#475569"];

  subgraph cluster_start {
    label="1. Start, recover saved work, and select an activity";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Start [label="Start selected account workers\nscripts/ma-workers -> question_capture run",
      fillcolor="#111827", fontcolor=white, fontsize=14];
    Accounts [label="Four independent account profiles\nMethods / Linear Algebra\nMultivariable Calculus / Differential Equations\nEach owns its browser, lock, checkpoints, and solver sessions"];
    Sweep [label="Retry eligible completed version-2 captures\nStartup + final sweeps; max 20 per sweep\nSkip in capture-only / dry-run; unchanged failures wait",
      tooltip="saved_imports.py: skip legacy captures; pause sweeps during unfinished assessment/diagnostic; retain exact pending intents"];
    Resume [label="Resume saved checkpoint?", shape=diamond, fillcolor="#eef2ff"];
    ResumeRead [label="Reopen saved activity and inspect actual state\nReuse solved answers; match shuffled choices by value\nObserve existing grades before any further submission"];
    Queue [label="Read Math Academy /learn queue\nTask type, IDs, availability, test requirements\nExclude captured tasks; recognize fresh reassigned lessons"];
    Priorities [label="Read study targets, assignments, deadlines,\nprerequisite graph + latest account progress snapshot\nCalculate priorities; no learner-state writes",
      fillcolor="#eff6ff"];
    Select [label="Choose available work\nDiagnostic -> required assessment -> quiz retake\n-> ranked lesson/review -> queue fallback\n-> optional quiz when other eligible work is exhausted"];
    InspectOnly [label="--dry-run: report queue or checkpoint\nExit before starting an activity", shape=oval, fillcolor="#eff6ff"];
    Dispatch [label="Start or resume the selected activity\nSave task identity, policy, and checkpoint"];
    Start -> Sweep -> Resume;
    Accounts -> Start [style=dotted];
    { rank=same; Accounts; Start; }
    Resume -> ResumeRead [label="unfinished capture"];
    Resume -> Queue [label="new work"];
    Priorities -> Select [style=dotted];
    Queue -> Select -> Dispatch;
    Select -> InspectOnly [label="dry-run"];
    Resume -> InspectOnly [label="dry-run", constraint=false];
    ResumeRead -> Dispatch;
  }

  subgraph cluster_capture {
    label="2. Capture the activity and interact with Math Academy";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Lesson [label="LESSON\nTutorial HTML, canonical Examples,\nKnowledge points, practice Questions\nCWCWC / WCWCC; perfect-retake override",
      fillcolor="#eef2ff", URL="../scripts/question_capture/browser.py"];
    Review [label="REVIEW\nServed Questions and source KP links\nCWCWC / WCWCC; perfect-retake override",
      fillcolor="#eef2ff", URL="../scripts/question_capture/browser.py"];
    Multi [label="MULTISTEP\nInitial shared context + ordered parts\nKeep each part's original local problem\nAim for correct answers",
      fillcolor="#eef2ff", URL="../scripts/question_capture/multistep.py"];
    Assessment [label="ASSESSMENT / QUIZ\nInstructions, fixed question set, time limit\nFill all Questions before whole-test submission\nAim for correct answers; saved pacing plan",
      fillcolor="#eef2ff", URL="../scripts/question_capture/assessment.py"];
    Diagnostic [label="DIAGNOSTIC\nInstructions + frozen answer/skip policy\nAdaptive question slots; classify covered skills\nHistory later resolves source Question IDs",
      fillcolor="#eef2ff", URL="../scripts/question_capture/diagnostic.py"];
    { rank=same; Lesson; Review; Multi; Assessment; Diagnostic; }
    Lesson -> Review -> Multi -> Assessment -> Diagnostic [style=invis, weight=20];
    Before [label="BEFORE ANSWERING\nCapture original Question + Answer fields + Answers\nradio / select / blank; original choices and field positions\nDOM/HTML, formulas, graphics, calculator instructions, screenshot"];
    Solve [label="One persistent solver session per activity\nUse captured examples/context and original choices\nChoose response under the activity's answer policy\nSave predictions and reasoning separately from source evidence"];
    Enter [label="Enter and verify the actual visible response\nCheck selected option or typed value; save entered screenshot\nCheckpoint before submission; observe pacing budget"];
    Skip [label="Diagnostic policy says skip\nSave classification + Don't Know intent"];
    SubmitOne [label="Submit current Question / proof stage\nLesson / Review / Multistep / Diagnostic"];
    After [label="AFTER ANSWERING\nCapture available MA grade, worked solution,\ncorrect-response evidence, and field feedback"];
    Interpret [label="Review revealed solution when needed\nSave solver interpretation and disagreement evidence\nKeep MA observations unchanged"];
    Continue [label="Continue / next question / next proof stage\nStaged proofs retain accepted fields and stage evidence\nCheckpoint each transition"];
    FillTest [label="Assessment: save each filled Question\nContinue filling until the fixed set is complete\nSave assessment-answered.html"];
    SubmitTest [label="Checkpoint -> submit whole test -> confirm once\nPer-question grades and solutions come from history"];
    Terminal [label="Verify terminal completion\nFinal screen / analysis, counts, outcome, and screenshots"];
    Lesson -> Before; Review -> Before; Multi -> Before;
    Assessment -> Before; Diagnostic -> Before;
    Before -> Solve -> Enter;
    Before -> Skip [label="diagnostic skip"];
    Skip -> SubmitOne;
    Enter -> SubmitOne [label="interactive activity"];
    Enter -> FillTest [label="assessment"];
    FillTest -> Before [label="next unfilled question", style=dashed, constraint=false];
    FillTest -> SubmitTest [label="all filled"];
    SubmitOne -> After -> Interpret -> Continue;
    Continue -> Before [label="more questions / fields", style=dashed, constraint=false];
    Continue -> Terminal [label="activity finished"];
    SubmitTest -> Terminal;
  }
  Dispatch -> Lesson; Dispatch -> Review; Dispatch -> Multi;
  Dispatch -> Assessment; Dispatch -> Diagnostic;

  subgraph cluster_completion {
    label="3. Complete the source record";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Progress [label="Capture post-activity course progress\nDiscover account's course scopes; read progress pages\nSave displayed topic colors + differences in knowledge-state/",
      fillcolor="#eff6ff"];
    History [label="Read completed activity history\nJoin source Question IDs, topic/KP/example references,\ndifficulty, grades, and expanded worked solutions\nCheck history against the questions actually captured"];
    TopicPage [label="LESSON: authenticated /topics/<topic-id>\nRead the complete source lesson, including unvisited sections\nCapture every tutorial/example placement and its graphics\nSave lesson-topic.html + lesson-definition.json"];
    Content [label="Finalize content.json (capture_version: 2)\nOriginal Questions, Examples, Tutorials and structure evidence\nJournal capture completion separately from database import",
      fillcolor="#dbeafe"];
    QueueAfter [label="Refresh and save the next queue observation\nEven after the last activity allowed by --limit"];
    Terminal -> Progress -> History;
    History -> TopicPage [label="lesson"];
    History -> Content [label="other activity types"];
    TopicPage -> Content -> QueueAfter;
  }

  subgraph cluster_evidence {
    label="Local capture evidence - reference/mathacademy/<stream>/<task-id>/";
    fontname="DejaVu Sans"; fontsize=16; color="#93c5fd"; style=rounded;
    Evidence [label="state.json / source HTML/JSON / screenshots\ncontent.json / activity metadata / solver session\nassets/ + manifest: original bytes, URLs, hashes",
      shape=folder, fillcolor="#eff6ff"];
    Observations [label="Retained for later use\nSubmitted responses, grades, timing, XP,\ndiagnostic classifications, and progress observations\nThese do not become learner / engine facts",
      shape=folder, fillcolor="#eff6ff"];
    Content -> Evidence [style=dotted];
    Evidence -> Observations [style=invis];
    Progress -> Observations [style=dotted, constraint=false];
  }

  subgraph cluster_prepare {
    label="4. Prepare source-attributed content for math";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    ImportMode [label="Database import enabled?", shape=diamond, fillcolor="#eef2ff"];
    CaptureOnly [label="--capture-only\nKeep captured evidence + import-deferred.json\nSkip EDB previews, commits, and saved-import sweeps",
      shape=oval, fillcolor="#eff6ff"];
    Authority [label="Rebuild from original MA evidence\nRestore source prompt and worked solution\nRebuild original Answer fields / choices\nKeep solver interpretations out of source content",
      URL="../scripts/question_capture/authoritative.py"];
    Keys [label="Establish each :answer-field/correct\nDisplayed history key -> explicit DOM key\n-> correct field grade / explicit single-field conclusion\n-> positively graded whole-question submission"];
    AnswerGate [label="Source content complete and all\npractice answer fields confirmed?",
      shape=diamond, fillcolor="#eef2ff"];
    Notes [label="answer-review.json\nSource/solver disagreements and unresolved keys\nPreserve MA originals, including source errors",
      shape=folder, fillcolor="#eff6ff"];
    Images [label="Prepare all content images\nValidate bytes / SVG -> SHA-256 -> reuse or atomic copy\nRewrite prompts, solutions, tutorial/context content,\nimage choices AND matching correct_value",
      URL="../scripts/question_capture/image_library.py"];
    Library [label="SSD image library\n/media/jake/SSD/EDB/math/images/\n<first 2 hash chars>/<full hash>.<extension>\nContent references: images/xx/hash.ext",
      shape=cylinder, fillcolor="#ecfdf5"];
    Snapshot [label="Read one current math database basis\nResolve Topic and Knowledge point identities\nCompare existing Question, Tutorial, Step, and Activity records"];
    Questions [label="Question + Answer field + Answer + KP membership\nReuse existing Question UUIDs\nUnchanged fields reuse their entities\nChanged fields get new definitions; retain old entities"];
    LessonStructure [label="LESSON structure\nActivity -> ordered Steps -> Tutorial or Knowledge point\nKnowledge point -> canonical Example + practice Questions\nCompare source placements; preserve UUIDs; update first/next links"];
    MultiStructure [label="MULTISTEP structure\nAssignment Activity -> Step -> Assigned problem\n-> Multistep (shared context) -> ordered Steps -> Questions\nPreserve part order and source-local problems; require all parts"];
    OtherContent [label="REVIEW / ASSESSMENT / DIAGNOSTIC\nPrepare reusable Questions and KP membership\nTheir attempt order, instructions, and routing remain evidence",
      fillcolor="#eff6ff"];
    Transaction [label="Build transaction.edn + exact replacement guards\nSource: :org/Math-Academy\nContent facts only; retain immutable history",
      fillcolor="#dbeafe", URL="../scripts/question_capture/math_database.py"];
    QueueAfter -> ImportMode;
    ImportMode -> CaptureOnly [label="capture-only"];
    ImportMode -> Authority [label="normal / preview"];
    Authority -> Keys -> AnswerGate;
    Keys -> Notes [style=dotted];
    AnswerGate -> Images [label="yes"];
    Images -> Library [style=dotted, label="files + relative references"];
    Images -> Snapshot;
    Snapshot -> Questions -> Transaction;
    Snapshot -> LessonStructure [label="lesson"];
    Snapshot -> MultiStructure [label="multistep"];
    Snapshot -> OtherContent [label="other types"];
    LessonStructure -> Transaction; MultiStructure -> Transaction;
    OtherContent -> Transaction;
  }
  SavedRoute [label="Eligible completed capture
Proceed to source preparation (4)", shape=oval, fillcolor="#fffbeb"];
  Sweep -> SavedRoute [style=dashed, color="#d97706", label="no pending intent"];
  SavedRetry [label="Pending intent: exact request / receipt recovery (5)\nReuse frozen payload, basis, and request key\nPreview leaves an unresolved intent deferred", shape=oval, fillcolor="#fffbeb"];
  Sweep -> SavedRetry [style=dashed, color="#d97706", label="pending intent"];
  Evidence -> Authority [style=dotted];

  subgraph cluster_commit {
    label="5. Preview, commit, and verify";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Changes [label="Any content changes?", shape=diamond, fillcolor="#eef2ff"];
    Noop [label="Already current\nSave no-op verification; no transaction", shape=oval, fillcolor="#ecfdf5"];
    Preview [label="EDB with: preview against expected basis\nCheck MA attribution, allowed content attributes,\nexact retractions, and immutable Answer/Answer-field definitions"];
    PreviewOnly [label="--preview\nSave preview and return without an EDB commit\nThe MA activity has still been performed", shape=oval, fillcolor="#eff6ff"];
    Intent [label="Persist exact commit intent BEFORE writing\nDatabase, source, basis, payload hashes, and request key"];
    Writer [label="Transact into math\nExisting writer: /tmp/edb-math/writer.sock\nPostgreSQL socket /tmp/edb-math : 55432",
      fillcolor="#111827", fontcolor=white, fontsize=14];
    Verify [label="Verify committed receipt at its database basis\nEvery changed fact attributed to Math Academy\nRead back and replan: reimport must make no changes"];
    Receipts [label="edb-import-math/\nPrepared content / reviews / matching/activity reports\nEDN / preview / exact intent / commit.edn / verification.json\nLegacy edb-import/ receipts belong to the old database",
      shape=folder, fillcolor="#eff6ff"];
    Complete [label="Mark import complete only after verification\nCapture completion remains a separate checkpoint",
      fillcolor="#ecfdf5"];
    Next [label="Continue the worker loop\nPace / cooldown; run eligible capture maintenance\nSelect next work, or final saved-import sweep and exit",
      shape=oval, fillcolor="#111827", fontcolor=white];
    Transaction -> Changes;
    Changes -> Noop [label="no"];
    Changes -> Preview [label="yes"];
    Preview -> PreviewOnly [label="preview mode"];
    Preview -> Intent [label="apply mode; checks pass"];
    Intent -> Writer -> Verify -> Complete;
    Intent -> Receipts [style=dotted];
    Verify -> Receipts [style=dotted];
    Complete -> Next; Noop -> Next; PreviewOnly -> Next;
  }
  CaptureOnly -> Next;

    Held [label="Defer this activity's import; retain all evidence\nAny unresolved practice key holds the whole live import\nMissing images / ambiguous identities also stop preparation\nContinue other available activities",
      fillcolor="#fffbeb"];
    Reviewed [label="SEPARATE REVIEWED RECOVERY\nInspect saved HTML and bind worked-solution answers to fields\nUse original image-choice -a-1 evidence where applicable\nPrepare verified-question batches; transact when requested\nBroader recovery is not wired into the live preparer",
      fillcolor="#f5f3ff", color="#8b5cf6"];
    Stale [label="Confirmed stale-basis rejection\nArchive rejected plan; bounded replan (up to 3 attempts)", fillcolor="#fffbeb"];
    Unknown [label="Unknown commit outcome / timeout\nKeep original intent; recover receipt or retry exact request\nNever replan an unresolved commit", fillcolor="#fffbeb"];
    Fault [label="Capture / navigation fault\nSave checkpoint, DOM, screenshot, traceback, and diagnostics\nRead failures / throttling: bounded backoff\nReconcile actual grades before continuing", fillcolor="#fffbeb"];
    Repair [label="Eligible capture-code repair\nRead-only diagnosis -> isolated patch + regression/offline tests\nInstall tested change under shared lock\nRestart worker with saved checkpoint, RNG, and counters",
      fillcolor="#fffbeb"];
    Stop [label="Authentication / access block / user interrupt\nSave checkpoint and stop this worker", shape=oval, fillcolor="#fee2e2"];
    AnswerGate -> Held [label="no", color="#d97706"];
    Images -> Held [label="unresolved graphic", style=dashed, color="#d97706", constraint=false];
    Snapshot -> Held [label="ambiguous identity", style=dashed, color="#d97706", constraint=false];
    Held -> Reviewed [style=dashed, color="#8b5cf6", label="separate review task"];
    ReviewRoute [label="Verified batch -> image preparation (4)
Then matching, preview, and requested commit", shape=oval, fillcolor="#f5f3ff", color="#8b5cf6"];
    Reviewed -> ReviewRoute [style=dashed, color="#8b5cf6"];

    Writer -> Stale [style=dashed, color="#d97706", label="definitive rejection"];
    Replan [label="Return to current-basis planning (4)", shape=oval, fillcolor="#fffbeb"];
    Stale -> Replan [style=dashed, color="#d97706"];
    Writer -> Unknown [style=dashed, color="#d97706", label="uncertain outcome"];

    Before -> Fault [style=dashed, color="#d97706", label="capture fault"];
    ResumeRoute [label="Return to saved checkpoint (1)
Reconcile source state before continuing", shape=oval, fillcolor="#fffbeb"];
    Fault -> ResumeRoute [style=dashed, color="#d97706", label="safe resume"];
    Fault -> Repair [style=dashed, color="#d97706", label="eligible persistent failure"];
    Repair -> ResumeRoute [style=dashed, color="#d97706", label="tested repair"];
    Fault -> Stop [label="blocking condition", color="#b91c1c"];


  Legend [shape=note, fillcolor=white, color="#cbd5e1", fontsize=11,
    label="READING THE CHART\nSolid arrows: live processing\nDotted arrows: evidence or supporting input\nAmber dashed arrows: recovery\nPurple dashed arrows: separate reviewed recovery\nBlue: retained evidence / inspection modes\nGreen: shared image storage / verified outcomes"];
  Start -> Legend [style=invis];
}
