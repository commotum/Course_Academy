[[:db/retract 17592186108045 :answer-field/choices 17592186108046] [:db/cas 17592186111048 :question/worked-solution nil "First, we take $\\log_3$ of both sides of the equation:\n\n$$\n\\begin{aligned}\n3^{x-2}&=6\\\\\n\\log_3\\left(3^{x-2}\\right)&=\\log_3(6).\n\\end{aligned}\n$$\n\nUsing $\\log_b(b^c)=c$ gives $x-2=\\log_3(6)$. Adding $2$ to both sides, we obtain\n\n$$\nx=\\log_3(6)+2.\n$$"] [:db/cas 17592186108045 :answer-field/correct nil 17592186108050] [:db/ensure 17592186111048 :question/validate] [:db/ensure 17592186108045 :answer-field/validate] [:db/ensure 17592186108046 :answer/validate] [:db/ensure 17592186108047 :answer/validate] [:db/ensure 17592186108048 :answer/validate] [:db/ensure 17592186108049 :answer/validate] [:db/ensure 17592186108050 :answer/validate] [:db/cas 17592186111370 :question/worked-solution nil "We take $\\log_5$ of both sides of the equation:\n\n$$\n\\begin{aligned}\n5^x&=15\\\\\n\\log_5\\left(5^x\\right)&=\\log_5(15).\n\\end{aligned}\n$$\n\nUsing $\\log_b(b^c)=c$, we obtain the exact solution\n\n$$\nx=\\log_5(15).\n$$"] [:db/cas 17592186109945 :answer-field/correct nil 17592186109946] [:db/ensure 17592186111370 :question/validate] [:db/ensure 17592186109945 :answer-field/validate] [:db/ensure 17592186109946 :answer/validate] [:db/ensure 17592186109947 :answer/validate] [:db/ensure 17592186109948 :answer/validate] [:db/ensure 17592186109949 :answer/validate] [:db/ensure 17592186109950 :answer/validate] {:db/id "answer-3fa04703-fe2d-542a-8f19-112ed7778aa6" :answer/id #uuid "3fa04703-fe2d-542a-8f19-112ed7778aa6" :answer/type :answer.type/math :answer/value "x=\\log_3(2)-3" :db/ensure [:answer/validate]} {:db/id 17592186108045 :answer-field/choices ["answer-3fa04703-fe2d-542a-8f19-112ed7778aa6"] :db/ensure [:answer-field/validate]} {:db/id "question-2dd924e4-dd60-54b1-9a1e-93f6380c91b5" :question/id #uuid "2dd924e4-dd60-54b1-9a1e-93f6380c91b5" :question/problem "Find the exact solution of the equation $4^{x-3}=7$." :question/worked-solution "First, we take $\\log_4$ of both sides of the equation:\n\n$$\n\\begin{aligned}\n4^{x-3}&=7\\\\\n\\log_4\\left(4^{x-3}\\right)&=\\log_4(7).\n\\end{aligned}\n$$\n\nUsing $\\log_b(b^c)=c$ gives $x-3=\\log_4(7)$. Adding $3$ to both sides, we obtain\n\n$$\nx=\\log_4(7)+3.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4bf2134a-3874-5cc1-a766-7b0ab88d1f62"] :db/ensure [:question/validate]} {:db/id "answer-field-4bf2134a-3874-5cc1-a766-7b0ab88d1f62" :answer-field/id #uuid "4bf2134a-3874-5cc1-a766-7b0ab88d1f62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53b750a1-8105-5e33-9337-52923d87b0d8" :answer-field/choices ["answer-8c1b6242-0822-57a3-9079-17b3964c9f0f" "answer-edaf6372-97f4-5c6d-9fcb-21c5c8075fd9" "answer-53b750a1-8105-5e33-9337-52923d87b0d8" "answer-6f42eeb6-c582-5d6a-ae51-c64831537082" "answer-54b5c430-53fb-585d-9b74-100c2bc3eff1"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c1b6242-0822-57a3-9079-17b3964c9f0f" :answer/id #uuid "8c1b6242-0822-57a3-9079-17b3964c9f0f" :answer/type :answer.type/math :answer/value "x=\\log_4(7)-3" :db/ensure [:answer/validate]} {:db/id "answer-edaf6372-97f4-5c6d-9fcb-21c5c8075fd9" :answer/id #uuid "edaf6372-97f4-5c6d-9fcb-21c5c8075fd9" :answer/type :answer.type/math :answer/value "x=\\log_7(4)+3" :db/ensure [:answer/validate]} {:db/id "answer-53b750a1-8105-5e33-9337-52923d87b0d8" :answer/id #uuid "53b750a1-8105-5e33-9337-52923d87b0d8" :answer/type :answer.type/math :answer/value "x=\\log_4(7)+3" :db/ensure [:answer/validate]} {:db/id "answer-6f42eeb6-c582-5d6a-ae51-c64831537082" :answer/id #uuid "6f42eeb6-c582-5d6a-ae51-c64831537082" :answer/type :answer.type/math :answer/value "x=\\frac{\\log_4(7)}{3}" :db/ensure [:answer/validate]} {:db/id "answer-54b5c430-53fb-585d-9b74-100c2bc3eff1" :answer/id #uuid "54b5c430-53fb-585d-9b74-100c2bc3eff1" :answer/type :answer.type/math :answer/value "x=\\log_4(10)" :db/ensure [: