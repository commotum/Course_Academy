db/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286148} :answer-field/id #uuid "74129432-415b-5281-9fec-f1b9a1a1cec0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287392} {:answer-field/choices [{:answer/id #uuid "38e21092-76b6-5a4c-b117-1001115db845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285321} {:answer/id #uuid "553afa5a-4338-5c57-b279-ff0312e09a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186285569} {:answer/id #uuid "811b0f7f-9402-5653-bc54-13686f987440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186285974} {:answer/id #uuid "e236c333-2153-5146-b193-5ef3d6ec8ca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186286848} {:answer/id #uuid "efd75d20-6069-5efc-a801-26f5c278e695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286988}] :answer-field/correct {:answer/id #uuid "38e21092-76b6-5a4c-b117-1001115db845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285321} :answer-field/id #uuid "9ab7d9b8-1d47-56d4-a66f-0f80a739dcdf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287464}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dab3d6dc-4b31-53f2-8ab3-bc64485c9198" :question/math-academy-id "q-181688" :question/problem "![](images/46/4628a6e45445a585361f7d32586b27e29bc726d4ed8b7f072679e5537df59644.png)\n\nDescribe the shaded region shown above using set-builder notation." :question/worked-solution "The points in our set include all those that lie *above* the line $y=x+1$ and *below* the line $y=3x.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>x+1,\\,y<3x.\n$$\n\nCombining this into a single condition, we have\n\n$$\nx+1<y<3x.\n$$\n\nWe must also include the line $y=3x$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\nx+1<y\\le 3x\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x+1<y\\le 3x}.\n$$"}] [{:db/id #edb/ref 17592186409900 :knowledge-point/_questions [{:db/id #edb/ref 17592186198477 :knowledge-point/id #uuid "36fa0f2f-3812-521a-aca3-900556be84ff" :knowledge-point/title "Describing Non-Rectangular Sets Using Set-Builder Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9099832-9536-5764-b8f9-82d9f50c96e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186409896}] :answer-field/correct {:answer/id #uuid "d9099832-9536-5764-b8f9-82d9f50c96e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186409896} :answer-field/id #uuid "1979d639-7c7b-51e8-9e83-40721047de2a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186409897} {:answer-field/choices [{:answer/id #uuid "53607ff6-5913-50ea-923c-e269930ccd31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186409894}] :answer-field/correct {:answer/id #uuid "53607ff6-5913-50ea-923c-e269930ccd31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186409894} :answer-field/id #uuid "38cdacac-1881-5ec8-b9e9-d206d7013904" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186409898} {:answer-field/choices [{:answer/id #uuid "d74e258e-f0dd-579c-9148-3c83bfa32b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186409895}] :answer-field/correct {:answer/id #uuid "d74e258e-f0dd-579c-9148-3c83bfa32b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186409895} :answer-field/id #uuid "9a1c0edf-ff99-50f4-9ecf-942f2ee605d1" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186409899}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6164b43d-cb18-5fe7-a896-e7c6ff8846af" :question/math-academy-id "q-181810" :question/problem "![](images/59/592dc9d0d4713406cf9bf9c6ad966cb4446420113aa0e94fcfdcdb35b6471a9c.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$144$\n\n$}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=3$ and vertical radius $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{16} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n16{x}^{2}+9{y}^{2}=144.\n$$\n\nWe're interested in describing all points that lie *inside* the ellipse. So, let's pick any point inside the region, say, $(0,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n16(0)^{2}+9(0)^{2}\\,<\\,144.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n16{x}^{2}+9{y}^{2}<144.\n$$\n\nNotice that we use $<$ since the boundary is excluded from the set (the boundary curve is dashed).\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,16{x}^{2}+9{y}^{2}<144}.\n$$"}] [{:db/id #edb/ref 17592186287781 :knowledge-point/_questions [{:db/id #edb/ref 17592186198475 :knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3" :knowledge-point/title "Linear Boundaries, One Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155eddcc-7b10-5882-9c3b-e997a278e33e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186284974} {:answer/id #uuid "4afae310-a2c1-52ac-8b9d-c50e017595d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186285483} {:answer/id #uuid "bb683912-97b7-522d-a4bb-58f482c2718a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286494} {:answer/id #uuid "c9ae26c6-2ac6-5819-931c-9d430094433e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286627}] :answer-field/correct {:answer/id #uuid "bb683912-97b7-522d-a4bb-58f482c2718a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286494} :answer-field/id #uuid "4d4c6ec5-c4d7-5d7a-a2f5-0c291edde648" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287320} {:answer-field/choices [{:answer/id #uuid "3d680f06-6809-5a16-96e1-d5b2b3b1d6e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285367} {:answer/id #uuid "4b32c95c-a97c-5769-9d0e-66fe5b6c0b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186285485} {:answer/id #uuid "8a002afb-df41-5e87-96b1-fabd6d1407ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186286048} {:answer/id #uuid "c77d5982-2411-5283-8b3a-faa916d95088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286615} {:answer/id #uuid "dc41e0fb-5599-5945-9510-c040584ad374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186286790}] :answer-field/correct {:answer/id #uuid "3d680f06-6809-5a16-96e1-d5b2b3b1d6e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186285367} :answer-field/id #uuid "f785468f-299b-5f38-9497-09ddea8e7e4d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "827675a7-728a-52ab-b17b-7e94ef593363" :question/math-academy-id "q-181976" :question/problem "![](images/11/11ec43034f97e66840da012f3beaf2d933fb03cfbe69f510ca5b68f1fd861f83.png)\n\nDescribe the shaded region shown above using set-builder notation." :question/worked-solution "The points in our set include all those that lie *above* the line $y=-x+1.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>-x+1\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>-x+1.\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y>-x+1}.\n$$"}] [{:db/id #edb/ref 17592186287786 :knowledge-point/_questions [{:db/id #edb/ref 17592186198475 :knowledge-point/id #uuid "e694b201-5ec6-5cc3-a608-2447d1cc1ed3" :knowledge-point/title "Linear Boundaries, One Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ff83ff-a85e-5759-9a2a-3d799b7146cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285009} {:answer/id #uuid "22dcd8b2-76cb-51d8-aa88-be7ec7d0f316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{C}^{2}" :db/id #edb/ref 17592186285101} {:answer/id #uuid "31cf8ca8-2c9c-5660-b2d4-d28776812fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186285240} {:answer/id #uuid "888939e6-2972-505a-a344-1b5368a90f02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186286039}] :answer-field/correct {:answer/id #uuid "18ff83ff-a85e-5759-9a2a-3d799b7146cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285009} :answer-field/id #uuid "15922b56-5dee-5494-8dfc-80286a88342e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287186} {:answer-field/choices [{:answer/id #uuid "0e641f7d-97d5-592f-b908-a83d570e3900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ne " :db/id #edb/ref 17592186284910} {:answer/id #uuid "510bea55-bf55-5cea-8b52-95fe8b458fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge " :db/id #edb/ref 17592186285534} {:answer/id #uuid "8373ff27-35ba-51b2-b72c-2a5884d86109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186285994} {:answer/id #uuid "a7bf6367-06aa-5f5d-8157-3a9ba937b6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286318} {:answer/id #uuid "b08deaa3-fc46-587f-8575-c5dc0208de7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186286402}] :answer-field/correct {:answer/id #uuid "a7bf6367-06aa-5f5d-8157-3a9ba937b6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186286318} :answer-field/id #uuid "8ea164f5-ab88-5833-8f94-dcbc1b0c609b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186287441}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53ac5dfb-f75e-5ef2-a84c-e58da3b6698e" :question/math-academy-id "q-181999" :question/problem "![](images/c7/c7f7b1dc9bf4da61b573345aaf92fe0d29ea00ef5558a9fca985d8af25fa0a03.png)\n\nDescribe the shaded region shown above using set-builder notation." :question/worked-solution "The points in our set include all those that lie *above* the line $y=2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>2\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny>2.\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y>2}.\n$$"}]}
