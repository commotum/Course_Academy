ata-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0</mn></mpadded></mstyle></mtd><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>1</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup></mpadded></mstyle></mtd><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>5</mn></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><msub><mi>x</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><msub><mi>x</mi><mn>2</mn></msub></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>+</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mi>t</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></msup></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
