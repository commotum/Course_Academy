scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\" symmetric=\"true\">‖</mo><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\" symmetric=\"true\">‖</mo></mrow><mrow><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
