#{[{:db/id #edb/ref 17592186375930 :knowledge-point/_questions [{:db/id #edb/ref 17592186119750 :knowledge-point/id #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" :knowledge-point/title "Finding the Curvature Given the Arc Length Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3a2b495-5ade-5c9a-9d43-e728c9e4e7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186375932} {:answer/id #uuid "c6b5f8c0-9dbf-52e2-b352-6bda2e491150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186375933} {:answer/id #uuid "8e89e463-6ffe-5364-93ab-503d653f6f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375934} {:answer/id #uuid "7497e593-0737-5859-a271-48d7055fc136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375935} {:answer/id #uuid "a2b1a993-2545-55a0-85bf-22a1c6300847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186375936}] :answer-field/correct {:answer/id #uuid "7497e593-0737-5859-a271-48d7055fc136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375935} :answer-field/id #uuid "bb321e95-8036-5305-85cc-8daac472f444" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19f64431-6e90-56df-bce1-3e6c04731f56" :question/math-academy-id "q-131930" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where\n\n$$\nr(s)=⟨\\operatorname{sin}⁡s,\\,1,\\,\\operatorname{cos}⁡s⟩,\\,0\\le s<2\\pi .\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s):$\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{sin}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(1),\\,\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡s)⟩ \\\\  & =⟨\\operatorname{cos}⁡s,\\,0,\\,-\\operatorname{sin}⁡s⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(0),\\,\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡s)⟩ \\\\  & =⟨-\\operatorname{sin}⁡s,\\,0,\\,-\\operatorname{cos}⁡s⟩\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\sqrt{{(-\\operatorname{sin}⁡s)}^{2}+{0}^{2}+{(-\\operatorname{cos}⁡s)}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡s+{cos}^{2}⁡s} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335732 :knowledge-point/_questions [{:db/id #edb/ref 17592186119749 :knowledge-point/id #uuid "2c9d719f-4936-5994-90eb-c33da57639cc" :knowledge-point/title "Finding the Curvature Given a General Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37af32ac-6d56-59b7-af88-a83bd549c119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186333502} {:answer/id #uuid "89b6e43c-5175-58b9-a703-c4d3bd3ea434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334213} {:answer/id #uuid "ec91d17d-8a59-5d87-b344-af638420e8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186335062} {:answer/id #uuid "f164ca79-a714-5ace-a91e-f41a09d97456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186335104} {:answer/id #uuid "fd455317-5a16-56c0-bbb9-11acb365385d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186335216}] :answer-field/correct {:answer/id #uuid "ec91d17d-8a59-5d87-b344-af638420e8b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186335062} :answer-field/id #uuid "91f964f4-328c-5d44-bbab-649563165d63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335517}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe9f4359-a5d3-51ab-bfaf-67dd4916cffb" :question/math-academy-id "q-64666" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=\\operatorname{sin}⁡t\\,i+\\sqrt{3}\\,j+\\operatorname{cos}⁡t\\,k,\\,{T}^{′}(t)=\\frac{\\operatorname{cos}⁡t}{2}\\,i-\\frac{\\operatorname{sin}⁡t}{2}\\,k\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\sqrt{{(\\frac{\\operatorname{cos}⁡t}{2})}^{2}+{(0)}^{2}+{(\\frac{-\\operatorname{sin}⁡t}{2})}^{2}} \\\\  & =\\sqrt{\\frac{1}{4}({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\frac{1}{2} \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(\\operatorname{sin}⁡t)^{2}+(\\sqrt{3})^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+3} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nHence, the curvature is \n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{(\\frac{1}{2})}{2}=\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348411 :knowledge-point/_questions [{:db/id #edb/ref 17592186119750 :knowledge-point/id #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" :knowledge-point/title "Finding the Curvature Given the Arc Length Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4803543c-d61e-5f5c-968e-bc681feef549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-2s}}" :db/id #edb/ref 17592186345969} {:answer/id #uuid "4ca68699-5d12-50bb-b538-dd82a35e755d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2s}}" :db/id #edb/ref 17592186346010} {:answer/id #uuid "724bf20d-270c-5376-b989-0685a8f99019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2s(1-2s)}}" :db/id #edb/ref 17592186346362} {:answer/id #uuid "7f95752a-9af9-56bd-b358-ebcec0812d80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2s(1-2s)}" :db/id #edb/ref 17592186346470} {:answer/id #uuid "fd88f132-9956-5edd-b9a1-d15e9c7f24c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186347583}] :answer-field/correct {:answer/id #uuid "724bf20d-270c-5376-b989-0685a8f99019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2s(1-2s)}}" :db/id #edb/ref 17592186346362} :answer-field/id #uuid "c8a7def3-c10e-5e3b-9fa8-80d05175b949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "61dc28ce-9be1-5118-b764-acd32225832e" :question/math-academy-id "q-80545" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s,$ where\n\n$$\nr(s)=⟨\\frac{1}{3}(1-2s)^{3/2},\\,\\frac{1}{3}(2s)^{3/2}⟩,\\,0<s<\\frac{1}{2}.\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s):$\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{1}{3}(1-2s)^{3/2}),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{1}{3}(2s)^{3/2})⟩ \\\\  & =⟨\\frac{1}{3}\\cdot \\frac{3}{2}\\cdot (1-2s)^{1/2}\\cdot (-2),\\,\\frac{1}{3}\\cdot \\frac{3}{2}\\cdot (2s)^{1/2}\\cdot 2⟩ \\\\  & =⟨-(1-2s)^{1/2},\\,(2s)^{1/2}⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-(1-2s)^{1/2}),\\,\\frac{\\text{d}}{\\text{d}s}((2s)^{1/2})⟩ \\\\  & =⟨-\\frac{1}{2}\\cdot (1-2s)^{-1/2}\\cdot (-2),\\,\\frac{1}{2}(2s)^{-1/2}\\cdot 2⟩ \\\\  & =⟨(1-2s)^{-1/2},\\,(2s)^{-1/2}⟩\\end{aligned}\n$$\n\n  \n\nFinally, the curvature is  \n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\sqrt{{((1-2s)^{-1/2})}^{2}+{((2s)^{-1/2})}^{2}} \\\\  & =\\sqrt{(1-2s)^{-1}+(2s)^{-1}} \\\\  & =\\sqrt{\\frac{1}{1-2s}+\\frac{1}{2s}} \\\\  & =\\frac{1}{\\sqrt{2s(1-2s)}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480641 :knowledge-point/_questions [{:db/id #edb/ref 17592186119749 :knowledge-point/id #uuid "2c9d719f-4936-5994-90eb-c33da57639cc" :knowledge-point/title "Finding the Curvature Given a General Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "080f6753-8c70-5915-9a0d-bd865b290678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,{e}^{t}" :db/id #edb/ref 17592186480125} {:answer/id #uuid "6cdb4830-f175-5239-a293-3eeaeb64ec02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\,{e}^{t}}{2}" :db/id #edb/ref 17592186480286} {:answer/id #uuid "79a108d2-31f6-5580-a65c-9af14c23117c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-t}" :db/id #edb/ref 17592186480310} {:answer/id #uuid "9ce60844-2f9b-561b-af0b-96198d74c1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\,{e}^{-t}}{2}" :db/id #edb/ref 17592186480369} {:answer/id #uuid "cebd021e-80fb-5feb-a087-fc29f42f4665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,{e}^{-t}" :db/id #edb/ref 17592186480457}] :answer-field/correct {:answer/id #uuid "9ce60844-2f9b-561b-af0b-96198d74c1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\,{e}^{-t}}{2}" :db/id #edb/ref 17592186480369} :answer-field/id #uuid "fbef7b1b-2a5f-5dce-929c-f5b8a633c936" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480630}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1fed5aa4-7f90-50cb-8379-da324cfd5754" :question/math-academy-id "q-80612" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t)={e}^{t}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩,\\,{T}^{′}(t)=-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t),$ we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|\\sqrt{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+({sin}^{2}⁡t+{cos}^{2}⁡t)+(2\\operatorname{cos}⁡t\\operatorname{sin}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{1+1+0} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & ={e}^{t}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t} \\\\  & ={e}^{t}\\sqrt{({cos}^{2}⁡t+{sin}^{2}⁡t)+({cos}^{2}⁡t+{sin}^{2}⁡t)+(-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)} \\\\  & ={e}^{t}\\sqrt{1+1+0} \\\\  & =\\sqrt{2}\\,{e}^{t}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\sqrt{2}\\,{e}^{t}}=\\frac{\\sqrt{2}\\,{e}^{-t}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377777 :knowledge-point/_questions [{:db/id #edb/ref 17592186119750 :knowledge-point/id #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" :knowledge-point/title "Finding the Curvature Given the Arc Length Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c819a8-69c1-5f0d-ba40-eb78fd2be723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377779} {:answer/id #uuid "39f59b00-cc03-55ab-b6b8-1ab9c1ffeae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377780} {:answer/id #uuid "b4a6473f-4085-5582-85ae-4516ab8e6591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186377781} {:answer/id #uuid "f7652fff-4d92-5f23-894d-77bffbcfe791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377782} {:answer/id #uuid "6fa70a7e-2036-5502-bde5-0309ee363352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186377783}] :answer-field/correct {:answer/id #uuid "f7652fff-4d92-5f23-894d-77bffbcfe791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377782} :answer-field/id #uuid "f0a1617d-d91d-575d-bb6f-36a897794ae3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377778}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "729c5739-583c-5a71-86c4-2b95ece46c63" :question/math-academy-id "q-80615" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where:\n\n$$\nr(s)=⟨\\frac{3s+1}{5},\\,\\frac{3-4s}{5}⟩,\\,s\\ge 0\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s):$\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{3s+1}{5}),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{3-4s}{5})⟩ \\\\  & =⟨\\frac{3}{5},\\,-\\frac{4}{5}⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{3}{5}),\\,\\frac{\\text{d}}{\\text{d}s}(-\\frac{4}{5})⟩ \\\\  & =⟨0,\\,0⟩\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\sqrt{{(0)}^{2}+{(0)}^{2}} \\\\  & =0.\\end{aligned}\n$$"}]}
