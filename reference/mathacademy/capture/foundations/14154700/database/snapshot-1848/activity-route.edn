#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186476995} :activity/id #uuid "3dfbf288-a291-5393-a094-9be13293a8e2" :activity/scope {:db/id #edb/ref 17592186049099 :topic/id #uuid "da82e0bb-7193-5348-9d38-5f5b8f5913d8" :topic/math-academy-id 2741} :activity/steps [{:db/id #edb/ref 17592186476979 :step/content {:db/id #edb/ref 17592186476932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f302d50-9ca1-586e-b1f2-bb16774e9a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x" :db/id #edb/ref 17592186476342} {:answer/id #uuid "7d1af17e-b2e8-5dca-b48a-32244e7c918d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x" :db/id #edb/ref 17592186476481} {:answer/id #uuid "9b5a0dcd-a0d2-5099-876c-b65c9f336a52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x" :db/id #edb/ref 17592186476540} {:answer/id #uuid "ca922ede-2598-5bbd-91ed-2c115cc7ea1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x" :db/id #edb/ref 17592186476658} {:answer/id #uuid "cfd949c2-5044-5076-a445-a9bbc18e3e7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x" :db/id #edb/ref 17592186476667}] :answer-field/correct {:db/id #edb/ref 17592186476342} :answer-field/id #uuid "fdeabe96-7dc2-5825-b44a-1ef489407f4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186476869}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a134fdbb-21b9-55b4-a24e-2df884a5e2a3" :question/math-academy-id "q-81396" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+25y=0\n$$\n\nhas the general solution\n\n$$\ny=A\\operatorname{sin}⁡5x+B\\operatorname{cos}⁡5x,\n$$\n\nsolve the following initial value problem:\n\n$$\n{y}^{″}+25y=0,\\,y(0)=2,\\,{y}^{′}(0)=5.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\n\\begin{aligned}B & =2.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=5,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=5A\\operatorname{cos}⁡5x-5B\\operatorname{sin}⁡5x.\n$$\n\nSubstituting ${y}^{′}(0)=5$ into the above gives\n\n$$\n\\begin{aligned}5=5A\\,⟹\\,A=1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{sin}⁡5x+2\\operatorname{cos}⁡5x.\n$$"} :step/id #uuid "1306b1e8-f6cc-5b8f-9885-e46a06e6b7d6" :step/next {:db/id #edb/ref 17592186476981}} {:db/id #edb/ref 17592186476981 :step/content {:db/id #edb/ref 17592186357628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4de3cea3-9ce1-5117-8440-1c848ea22d4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+2\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355356} {:answer/id #uuid "82b9aacb-816c-533f-8f18-7bad4adc1c9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+3\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355814} {:answer/id #uuid "90f20f88-ad66-5e68-9ff3-f7c959e067cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x-2\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355943} {:answer/id #uuid "a0a0b4b1-1e9c-550c-b5cf-d7579feaa3f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x-\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356089} {:answer/id #uuid "f366d31e-4d24-5d08-beff-fd3ad156a6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356793}] :answer-field/correct {:db/id #edb/ref 17592186356793} :answer-field/id #uuid "fdfe16cc-d998-5278-adcf-1b050e572699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357355}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ecd297d2-0d03-5232-81da-fdcaeb168238" :question/math-academy-id "q-94030" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+6{y}^{′}+13y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+6{y}^{′}+13y=0,\\,y(0)=2,\\,{y}^{′}(0)=-4.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\n- To apply the condition ${y}^{′}(0)=-4,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-3{e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)+{e}^{-3x}(-2P\\operatorname{sin}⁡2x+2Q\\operatorname{cos}⁡2x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-4$ into the above to get\n\n$$\n-3P+2Q=-4.\n$$\n\nUsing the fact that $P=2$ gives $Q=1.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny={e}^{-3x}(2\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x).\n$$"} :step/id #uuid "175938d0-fece-5a13-994e-7f2a8a04c450" :step/next {:db/id #edb/ref 17592186476986}} {:db/id #edb/ref 17592186476986 :step/content {:db/id #edb/ref 17592186476916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "501007c1-1237-54a3-8146-49746a54174b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{x}-4x{e}^{x}" :db/id #edb/ref 17592186476368} {:answer/id #uuid "6133a790-bf37-5624-a5e5-d93d8aac76a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{x}+x{e}^{x}" :db/id #edb/ref 17592186476424} {:answer/id #uuid "90703a07-a49f-5b3e-9f80-5fb5897a85ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{x}+2x{e}^{x}" :db/id #edb/ref 17592186476512} {:answer/id #uuid "e78a3592-edab-5dca-829b-212313e22fe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{x}+4x{e}^{x}" :db/id #edb/ref 17592186476720} {:answer/id #uuid "f6418223-cfc1-5b18-8627-68adb9ed9afd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{x}+8x{e}^{x}" :db/id #edb/ref 17592186476746}] :answer-field/correct {:db/id #edb/ref 17592186476720} :answer-field/id #uuid "ca796d4b-8681-5245-bc1d-c35792d5e364" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186476844}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7e57d61a-2fa5-55d2-aed6-295e67c97f51" :question/math-academy-id "q-130350" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}-2{y}^{′}+y=0\n$$\n\nhas the general solution\n\n$$\ny=A{e}^{x}+Bx{e}^{x},\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}-2{y}^{′}+y=0,\\,y(0)=4,\\,{y}^{′}(0)=8.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions. \n\n- Substituting $y(0)=4$ into the general solution gives\n\n$$\nA=4.\n$$\n\n- To apply the condition ${y}^{′}(0)=8,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=A{e}^{x}+B{e}^{x}+Bx{e}^{x}.\n$$\n\nSubstituting ${y}^{′}(0)=8$ into the above gives\n\n$$\nA+B=8.\n$$\n\nUsing the fact that $A=4$ gives $B=4.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=4{e}^{x}+4x{e}^{x}.\n$$"} :step/id #uuid "5749455f-9503-59fa-a876-a1ec4ac2fd2e" :step/next {:db/id #edb/ref 17592186476989}} {:db/id #edb/ref 17592186476989 :step/content {:db/id #edb/ref 17592186265898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505e2df8-db79-59e7-a583-99babc506741" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186263697} {:answer/id #uuid "5654280f-88bb-59f1-b9d2-19091ada66cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2{e}^{-x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263743} {:answer/id #uuid "79b176c8-c019-5f2d-89b9-2523faf24214" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-4\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264055} {:answer/id #uuid "d4e423e9-b332-5cd9-a6ed-b6e6e50a5c8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264852} {:answer/id #uuid "e7b0ac67-5324-577a-afe9-536d41e51116" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186265018}] :answer-field/correct {:db/id #edb/ref 17592186263743} :answer-field/id #uuid "9cf4956a-8f92-55a5-93db-74651c950270" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265525}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c95764b1-5855-5fb2-b3ad-f0b7d5850b93" :question/math-academy-id "q-130374" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+2{y}^{′}+2y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+2{y}^{′}+2y=0,\\,y(0)=2,\\,{y}^{′}(0)=-2.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\n- To apply the condition ${y}^{′}(0)=-2,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-{e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)+{e}^{-x}(-P\\operatorname{sin}⁡x+Q\\operatorname{cos}⁡x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-2$ into the above to get\n\n$$\n-P+Q=-2.\n$$\n\nUsing the fact that $P=2$ gives $Q=0.$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y & =2{e}^{-x}\\operatorname{cos}⁡x.\\end{aligned}\n$$"} :step/id #uuid "6b359008-56cc-5644-a2dc-31e108447e77"} {:db/id #edb/ref 17592186476995 :step/content {:db/id #edb/ref 17592186152639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16afed35-5463-5e89-b46a-71267d7d4dfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186333191} {:answer/id #uuid "c0d2b579-81ed-55f0-86c7-1541a3ed079c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186334660} {:answer/id #uuid "f16df0e0-2094-5727-8779-eedca1e17dee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335105} {:answer/id #uuid "fc2ea755-747f-5b1b-81ec-4430d746d47b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335202} {:answer/id #uuid "fc44ffb2-d97c-5268-8493-a8451eaabd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335206}] :answer-field/correct {:db/id #edb/ref 17592186335105} :answer-field/id #uuid "87dc976c-f470-53a5-ae6e-a363a677d1ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335500}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0006dc55-4e80-5e2f-bc47-1762d506390e" :question/math-academy-id "q-65117" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+16y=0\n$$\n\nhas the general solution\n\n$$\ny=A\\operatorname{sin}⁡4x+B\\operatorname{cos}⁡4x,\n$$\n\nsolve the following initial value problem:\n\n$$\n{y}^{″}+16y=0,\\,y(0)=1,\\,{y}^{′}(0)=-4.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}B & =1.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=-4,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=4A\\operatorname{cos}⁡4x-4B\\operatorname{sin}⁡4x.\n$$\n\nSubstituting ${y}^{′}(0)=-4$ into the above gives\n\n$$\n\\begin{aligned}-4=4A\\,⟹\\,A=-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x.\n$$"} :step/id #uuid "c1685e0e-fc49-5045-b7b4-a59aeaeaad30" :step/next {:db/id #edb/ref 17592186476979}}] :activity/title "Second-Order Homogeneous Initial Value Problems" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186476199}]}
