#{[{:db/id #edb/ref 17592186265898 :knowledge-point/_questions [{:db/id #edb/ref 17592186152287 :knowledge-point/id #uuid "20e5f532-d99f-5406-b006-f34aa9074819" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505e2df8-db79-59e7-a583-99babc506741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186263697} {:answer/id #uuid "5654280f-88bb-59f1-b9d2-19091ada66cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263743} {:answer/id #uuid "79b176c8-c019-5f2d-89b9-2523faf24214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-4\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264055} {:answer/id #uuid "d4e423e9-b332-5cd9-a6ed-b6e6e50a5c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186264852} {:answer/id #uuid "e7b0ac67-5324-577a-afe9-536d41e51116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186265018}] :answer-field/correct {:answer/id #uuid "5654280f-88bb-59f1-b9d2-19091ada66cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{e}^{-x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263743} :answer-field/id #uuid "9cf4956a-8f92-55a5-93db-74651c950270" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c95764b1-5855-5fb2-b3ad-f0b7d5850b93" :question/math-academy-id "q-130374" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+2{y}^{′}+2y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+2{y}^{′}+2y=0,\\,y(0)=2,\\,{y}^{′}(0)=-2.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\n- To apply the condition ${y}^{′}(0)=-2,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-{e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)+{e}^{-x}(-P\\operatorname{sin}⁡x+Q\\operatorname{cos}⁡x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-2$ into the above to get\n\n$$\n-P+Q=-2.\n$$\n\nUsing the fact that $P=2$ gives $Q=0.$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y & =2{e}^{-x}\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186152639 :knowledge-point/_questions [{:db/id #edb/ref 17592186152286 :knowledge-point/id #uuid "8ebb2332-3e40-5627-bc43-258ca4a80424" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Imaginary Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16afed35-5463-5e89-b46a-71267d7d4dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186333191} {:answer/id #uuid "c0d2b579-81ed-55f0-86c7-1541a3ed079c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186334660} {:answer/id #uuid "f16df0e0-2094-5727-8779-eedca1e17dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335105} {:answer/id #uuid "fc2ea755-747f-5b1b-81ec-4430d746d47b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335202} {:answer/id #uuid "fc44ffb2-d97c-5268-8493-a8451eaabd4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335206}] :answer-field/correct {:answer/id #uuid "f16df0e0-2094-5727-8779-eedca1e17dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x" :db/id #edb/ref 17592186335105} :answer-field/id #uuid "87dc976c-f470-53a5-ae6e-a363a677d1ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0006dc55-4e80-5e2f-bc47-1762d506390e" :question/math-academy-id "q-65117" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+16y=0\n$$\n\nhas the general solution\n\n$$\ny=A\\operatorname{sin}⁡4x+B\\operatorname{cos}⁡4x,\n$$\n\nsolve the following initial value problem:\n\n$$\n{y}^{″}+16y=0,\\,y(0)=1,\\,{y}^{′}(0)=-4.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}B & =1.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=-4,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=4A\\operatorname{cos}⁡4x-4B\\operatorname{sin}⁡4x.\n$$\n\nSubstituting ${y}^{′}(0)=-4$ into the above gives\n\n$$\n\\begin{aligned}-4=4A\\,⟹\\,A=-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x.\n$$"}] [{:db/id #edb/ref 17592186357628 :knowledge-point/_questions [{:db/id #edb/ref 17592186152287 :knowledge-point/id #uuid "20e5f532-d99f-5406-b006-f34aa9074819" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4de3cea3-9ce1-5117-8440-1c848ea22d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+2\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355356} {:answer/id #uuid "82b9aacb-816c-533f-8f18-7bad4adc1c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+3\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355814} {:answer/id #uuid "90f20f88-ad66-5e68-9ff3-f7c959e067cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x-2\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355943} {:answer/id #uuid "a0a0b4b1-1e9c-550c-b5cf-d7579feaa3f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x-\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356089} {:answer/id #uuid "f366d31e-4d24-5d08-beff-fd3ad156a6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356793}] :answer-field/correct {:answer/id #uuid "f366d31e-4d24-5d08-beff-fd3ad156a6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-3x}(2\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356793} :answer-field/id #uuid "fdfe16cc-d998-5278-adcf-1b050e572699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecd297d2-0d03-5232-81da-fdcaeb168238" :question/math-academy-id "q-94030" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+6{y}^{′}+13y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+6{y}^{′}+13y=0,\\,y(0)=2,\\,{y}^{′}(0)=-4.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\n- To apply the condition ${y}^{′}(0)=-4,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-3{e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)+{e}^{-3x}(-2P\\operatorname{sin}⁡2x+2Q\\operatorname{cos}⁡2x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-4$ into the above to get\n\n$$\n-3P+2Q=-4.\n$$\n\nUsing the fact that $P=2$ gives $Q=1.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny={e}^{-3x}(2\\operatorname{cos}⁡2x+\\operatorname{sin}⁡2x).\n$$"}]}
