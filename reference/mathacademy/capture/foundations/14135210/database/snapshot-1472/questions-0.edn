#{[{:db/id #edb/ref 17592186435930 :knowledge-point/_questions [{:db/id #edb/ref 17592186083393 :knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de2057b-88f3-5eae-a4be-76fa3eb87360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19\\,\\text{m/s}" :db/id #edb/ref 17592186435900} {:answer/id #uuid "12fdb718-5b20-5e1f-bedc-4a924bf08daa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{m/s}" :db/id #edb/ref 17592186435901} {:answer/id #uuid "28abf313-cb2f-5450-b131-e9fc73d1c015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,\\text{m/s}" :db/id #edb/ref 17592186435902} {:answer/id #uuid "d2363bc7-c793-5cae-a7a0-fdb45b1f9144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{m/s}" :db/id #edb/ref 17592186435916} {:answer/id #uuid "df95a53e-89cb-595f-b895-96655799381a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11\\,\\text{m/s}" :db/id #edb/ref 17592186435919}] :answer-field/correct {:answer/id #uuid "0de2057b-88f3-5eae-a4be-76fa3eb87360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19\\,\\text{m/s}" :db/id #edb/ref 17592186435900} :answer-field/id #uuid "ba55cb3c-40db-5e24-bdf4-2cb74a217cfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "856c86c0-9a1d-541f-bee9-93df07ee1d90" :question/math-academy-id "q-102697" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=6t-2$, where $t$ is the time in seconds. If the particle has velocity $v=-1\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s}$, calculate the speed of the particle at the moment $t=3\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (6t-2)\\text{d}t \\\\  & =3{t}^{2}-2t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=-1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-1 & =3(1)^{2}-2(1)+C \\\\ -1 & =3-2+C \\\\ C & =-2.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=3{t}^{2}-2t-2.$\n\nWe evaluate the velocity at time $t=3\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(3) & =3(3)^{2}-2(3)-2 \\\\  & =27-6-2 \\\\  & =19\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $19\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186241013 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814bed9d-2cbb-5df1-896f-d87d4713951f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,12\\}" :db/id #edb/ref 17592186435909} {:answer/id #uuid "bd06c2c2-b428-571e-8760-4cbeaa7dcc7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1\\}" :db/id #edb/ref 17592186435911} {:answer/id #uuid "d162144b-b4a5-51ba-9d97-5bb11fc0f3da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,10,12,14\\}" :db/id #edb/ref 17592186435915} {:answer/id #uuid "d89d63a8-9075-5e20-bc27-e5a349ddda2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,4,8,16\\}" :db/id #edb/ref 17592186435918} {:answer/id #uuid "fb4e1fb8-de8c-57db-9ec1-0460004b76fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,16\\}" :db/id #edb/ref 17592186435922}] :answer-field/correct {:answer/id #uuid "d162144b-b4a5-51ba-9d97-5bb11fc0f3da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,10,12,14\\}" :db/id #edb/ref 17592186435915} :answer-field/id #uuid "a3174f2e-e4fe-5b15-9ca8-8ba15281d2ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1c945ab-a73d-5e4c-9433-39a80d9da5a4" :question/math-academy-id "q-105217" :question/problem "If $A=\\{1,2,4,8,16\\}$ and $B=\\{2,4,6,8,10,12,14,16\\},$ then $B∖A=$" :question/worked-solution "The set $B∖A$ is the set of all elements belonging to $B$ but *not* $A.$ Note that the elements $2,4,8,16\\in A$ are also in $B,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}B∖A & =B-A \\\\  & =\\{2,4,6,8,10,12,14,16\\}-\\{1,2,4,8,16\\} \\\\  & =\\{6,10,12,14\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186241023 :knowledge-point/_questions [{:db/id #edb/ref 17592186119809 :knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be" :knowledge-point/title "Determining Whether a Vector Lies on a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202fca4b-d4db-559c-86f9-155db3d13c64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186238333} {:answer/id #uuid "2b56c1db-87eb-5ec9-914d-30a522b26fe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238442} {:answer/id #uuid "6182bb36-df22-5b55-8de2-18be6f4e6edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186238911} {:answer/id #uuid "a846d2c7-f2b2-52b6-aa5d-db3effda179c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186239517} {:answer/id #uuid "f503a4ab-d69a-5e93-a2e0-b67020545fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186240218}] :answer-field/correct {:answer/id #uuid "6182bb36-df22-5b55-8de2-18be6f4e6edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186238911} :answer-field/id #uuid "13f36fa9-d65b-5d54-8f7f-9bbf30419197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "caedc8c2-ba3c-5e61-ad1f-0d5eafbb8652" :question/math-academy-id "q-105257" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,-2,-1⟩$, $c=⟨-4,5,-1⟩$, and  $u=⟨1,1,4⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}s-4t=1 \\\\ -2s+5t=1 \\\\ -s-t=4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -4 & 1 \\\\ -2 & 5 & 1 \\\\ -1 & -1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & -3 & 3 \\\\ -1 & -1 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & -3 & 3 \\\\ 0 & -5 & 5\\end{aligned}] & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & -5 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}s-4t=1 \\\\ t=-1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-1.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-4t & =1 \\\\ s-4(-1) & =1 \\\\ s+4 & =1 \\\\ s & =-3.\\end{aligned}\n$$\n\nSince we found a solution $s=-3,\\,t=-1,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-3b-c.\n$$\n\nFinally, $s\\cdot t=(-3)\\cdot (-1)=3.$"}] [{:db/id #edb/ref 17592186435931 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040f7834-f2bb-5ae7-8210-05603a349336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k" :db/id #edb/ref 17592186435899} {:answer/id #uuid "43972e47-c74a-5e2c-9406-cab735613c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435904} {:answer/id #uuid "608e3def-5a47-5698-9d7c-8d83b91fa89d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435906} {:answer/id #uuid "d760d291-db5c-53dc-aa0b-1513d577346d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{k}" :db/id #edb/ref 17592186435917} {:answer/id #uuid "e7b5533f-c67d-5f63-858e-8153fcb2ff84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435920}] :answer-field/correct {:answer/id #uuid "608e3def-5a47-5698-9d7c-8d83b91fa89d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435906} :answer-field/id #uuid "acc41c54-687c-5d89-a864-5e4fafdd6f79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435925}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d437ae95-9320-5f38-963e-97e760ec1b57" :question/math-academy-id "q-129384" :question/problem "Calculate $\\text{Var}[{2}^{k}]$ where $k$ is a constant." :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore,\n\n$$\n\\text{Var}[{2}^{k}]=0.\n$$"}] [{:db/id #edb/ref 17592186272056 :knowledge-point/_questions [{:db/id #edb/ref 17592186129132 :knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85da12d4-ccb2-5dce-93ac-5e138a668cbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186270429} {:answer/id #uuid "9fb9db6d-cb8c-529c-98b2-df8e6c79a815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "46" :db/id #edb/ref 17592186270688} {:answer/id #uuid "a0c6ca61-603a-5e8a-89b1-f8e286912157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186270695} {:answer/id #uuid "a38d5a79-23af-54f5-b33c-13fd728ca281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186270726} {:answer/id #uuid "c1fce5ad-0b4c-5edd-8aa1-b1eaf719d57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186270985}] :answer-field/correct {:answer/id #uuid "c1fce5ad-0b4c-5edd-8aa1-b1eaf719d57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186270985} :answer-field/id #uuid "1d009f0a-0694-5fcc-8aef-3470ada89bbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271562}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11dcfffe-2217-5164-89c5-20cf281ca601" :question/math-academy-id "q-140325" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}-3-9\\text{i} & -7+\\text{i} \\\\ -5-2\\text{i} & -4\\text{i}\\end{aligned}]\\,$ then what is the value of $bc-ef?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3-9\\text{i} & -7+\\text{i} \\\\ -5-2\\text{i} & -4\\text{i}\\end{aligned}] \\\\ A & =[\\begin{aligned}-3-9\\text{i} & -7+\\text{i} \\\\ -5-2\\text{i} & 0-4\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-3 & -7 \\\\ -5 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-9 & 1 \\\\ -2 & -4\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $b=-7,c=-5,e=-9$ and $f=1.$ Therefore,\n\n$$\nbc-ef=(-7)\\cdot (-5)-(-9)\\cdot 1=44.\n$$"}] [{:db/id #edb/ref 17592186435928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115355 :knowledge-point/id #uuid "74a1499c-080d-5008-bcc3-492ef469d3dc" :knowledge-point/title "Domains of Functions With Exponential and Logarithmic Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b564ded-2d25-5252-a530-06b94ce11880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (0,\\infty )" :db/id #edb/ref 17592186435903} {:answer/id #uuid "8972d48e-41d2-5611-92db-f9c29b7de45d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,0)" :db/id #edb/ref 17592186435910} {:answer/id #uuid "c4aa47c9-6cf7-51d6-b801-5bc91a5fc512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (0,3)" :db/id #edb/ref 17592186435913} {:answer/id #uuid "e8ef6ccf-95c6-56c8-af3b-01ccd8f18aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,3)" :db/id #edb/ref 17592186435921} {:answer/id #uuid "fc681ce4-d810-5c12-bf19-bf52552bebbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (3,\\infty )" :db/id #edb/ref 17592186435923}] :answer-field/correct {:answer/id #uuid "8972d48e-41d2-5611-92db-f9c29b7de45d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,0)" :db/id #edb/ref 17592186435910} :answer-field/id #uuid "a8f3c7fa-d0ee-5ec1-aa68-12f5aac82ca4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435924}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d6379e5-5dfa-520a-ae85-5ee99eafe5a8" :question/math-academy-id "q-162655" :question/problem "Find the domain of the vector-valued function $f(t)=⟨\\operatorname{ln}⁡(-t),\\,3,\\,\\sqrt{{t}^{2}+2}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{ln}⁡(-t)$ is $t\\in (-\\infty ,0).$\n\n- The domain of the 2nd component $3$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\sqrt{{t}^{2}+2}$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/39/39266e152f7a52ee6cf56ad872704a110765e22c5d3fcea6f4b4c7565276ee24.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-\\infty ,0).$"}] [{:db/id #edb/ref 17592186338872 :knowledge-point/_questions [{:db/id #edb/ref 17592186119827 :knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5" :knowledge-point/title "Finding the Cartesian Equation of a Line Given in Parametric or Vector Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009411d3-d832-5609-913e-acebd7d7bf4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{5}=\\frac{z}{-6}" :db/id #edb/ref 17592186336035} {:answer/id #uuid "092a7315-5896-5792-a85d-57b6c0dd114b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{2}=\\frac{y+5}{-3}=\\frac{z-6}{7}" :db/id #edb/ref 17592186336111} {:answer/id #uuid "462f0843-eb05-5ebd-9a15-d012956547f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-4}{2}=\\frac{y-5}{-3}=\\frac{z+6}{7}" :db/id #edb/ref 17592186336684} {:answer/id #uuid "68221d0f-377e-5a6b-b460-b93c5443528c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{4}=\\frac{y+3}{5}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186336961} {:answer/id #uuid "bca2c6fa-f347-5c3e-83d6-457baf506743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{4}=\\frac{y-3}{5}=\\frac{z+7}{-6}" :db/id #edb/ref 17592186337709}] :answer-field/correct {:answer/id #uuid "68221d0f-377e-5a6b-b460-b93c5443528c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2}{4}=\\frac{y+3}{5}=\\frac{z-7}{-6}" :db/id #edb/ref 17592186336961} :answer-field/id #uuid "457d9519-cf87-50e2-920f-0c4455b746d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cadba95b-e6bb-5c0e-9d1a-07af961b4052" :question/math-academy-id "q-71020" :question/problem "Consider the straight line with the parametric equations\n\n$$\n\\{\\begin{aligned}x=2+4t \\\\ y=-3+5t \\\\ z=7-6t\\end{aligned}\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+4t \\\\ -3+5t \\\\ 7-6t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ 7\\end{aligned}]+[\\begin{aligned}4t \\\\ 5t \\\\ -6t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ 7\\end{aligned}]+t[\\begin{aligned}4 \\\\ 5 \\\\ -6\\end{aligned}] \\\\ r & =[\\begin{aligned}2 \\\\ -3 \\\\ 7\\end{aligned}]+t[\\begin{aligned}4 \\\\ 5 \\\\ -6\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the given line passes through the point $P(2,-3,7)$ and is parallel to the vector $v=⟨4,5,-6⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{4}=\\frac{y-(-3)}{5}=\\frac{z-7}{-6}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{4}=\\frac{y+3}{5}=\\frac{z-7}{-6}.\n$$"}] [{:db/id #edb/ref 17592186435929 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ecaf329-877a-5184-b3cf-13e81c99934a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186435905} {:answer/id #uuid "6bdcc3ed-d3b8-5907-ba40-01803c02c9cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186435907} {:answer/id #uuid "73df3086-3d04-5a6a-abd1-f9c01e475b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186435908} {:answer/id #uuid "c250bb51-b7ca-503c-842d-002259888993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186435912} {:answer/id #uuid "ccc703f5-adf8-5933-89b8-12fe5ea4b4ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186435914}] :answer-field/correct {:answer/id #uuid "5ecaf329-877a-5184-b3cf-13e81c99934a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186435905} :answer-field/id #uuid "eb49e450-3c82-56fd-b065-47510e61dd32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "751ef612-b871-5a13-b5db-9f9345197dd4" :question/math-academy-id "q-80813" :question/problem "Which of the following are subsets of ${Q}_{0}^{+}$ (the set of non-negative rational numbers)?\n\nI. ${Z}^{-}$ (the set of negative integers)\n\nII. $N$\n\nIII. ${Z}_{0}^{+}$ (the set of non-negative integers)" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Z}^{-}$ is not a subset of ${Q}_{0}^{+}.$ For example, $-1\\in {Z}^{-}$ but $-1\\notin {Q}_{0}^{+}.$\n\n- $N$ is a subset of ${Q}^{+}.$ Indeed, every natural number is also a positive rational number.\n\n- ${Z}_{0}^{+}$ is a subset of ${Q}_{0}^{+}.$ Indeed, every positive integer is also a positive rational number. Notice also that  $0$ is in both  ${Z}_{0}^{+}$ and ${Q}_{0}^{+}.$\n\nTherefore, the correct answer is \"II and III  only\"."}] [{:db/id #edb/ref 17592186362318 :knowledge-point/_questions [{:db/id #edb/ref 17592186147495 :knowledge-point/id #uuid "4535b48e-a33f-5f62-95d3-a5c0991c1f6d" :knowledge-point/title "Classifying Equilibrium Points Using a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10267759-948c-5e21-b819-eea0a52b9c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186360894} {:answer/id #uuid "21c0f117-930c-5f72-bd6c-e01d53d016cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186360984} {:answer/id #uuid "8db2a840-a6b6-51d4-8f6c-92bd0dad5406" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186361466} {:answer/id #uuid "b5c1cb60-43c1-5cc0-a644-c5f45b9d687b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186361644} {:answer/id #uuid "c000b11d-6918-5ea4-9dcf-dd56873b8480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186361695}] :answer-field/correct {:answer/id #uuid "c000b11d-6918-5ea4-9dcf-dd56873b8480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186361695} :answer-field/id #uuid "7e224e7e-dfd1-5c42-9dff-859b4fa1ddef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362086}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1d8d74b-55cf-51de-803f-0cecc60a4fb1" :question/math-academy-id "q-98714" :question/problem "![](images/6b/6b9b15bd3c8cda84156d5461fb9f80f892a1dba26151cc37d381757f9f659fa1.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\nI. $y=-3$ is a node.\n\nII. $y=2$ is a sink.\n\nIII. $y=2$ is a source." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/36/362ffe8871efa8dc597708b039fa766c3603777ba12460e84d9af1fc39800288.png)\n\nTherefore, we have:\n\n- Statement I is true. From the phase line, we see that $y=-3$ is a node.\n\n- Statement II is true, while statement III is false. From the phase line, we see that $y=2$ is a sink.\n\nTherefore, the correct answer is \"I and II only\"."}]}
