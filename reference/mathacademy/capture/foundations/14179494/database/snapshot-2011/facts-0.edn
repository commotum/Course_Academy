7-e72f161ebfb3" #edb/ref 17592186045417] [17592186120790 #edb/ref 1063 #edb/ref 17592186121079 #edb/ref 17592186045417] [17592186120791 #edb/ref 1058 #edb/ref 17592186120978 #edb/ref 17592186045417] [17592186120791 #edb/ref 1061 32531 #edb/ref 17592186045417] [17592186120791 #edb/ref 1062 #uuid "84aafb0e-a1fc-506a-aa26-8b23e04c1756" #edb/ref 17592186045417] [17592186120791 #edb/ref 1063 #edb/ref 17592186121080 #edb/ref 17592186045417] [17592186120792 #edb/ref 1058 #edb/ref 17592186120979 #edb/ref 17592186045417] [17592186120792 #edb/ref 1061 32532 #edb/ref 17592186045417] [17592186120792 #edb/ref 1062 #uuid "60fca522-e8ee-530d-9936-cc7ec084b35f" #edb/ref 17592186045417] [17592186120792 #edb/ref 1063 #edb/ref 17592186121081 #edb/ref 17592186045417] [17592186120976 #edb/ref 1058 #edb/ref 17592186120977 #edb/ref 17592186045417] [17592186120976 #edb/ref 1061 9874 #edb/ref 17592186045417] [17592186120976 #edb/ref 1062 #uuid "a65b687f-5aa2-5d59-93d7-c89fdaa5d539" #edb/ref 17592186045417] [17592186120976 #edb/ref 1063 #edb/ref 17592186120995 #edb/ref 17592186045417] [17592186120977 #edb/ref 1058 #edb/ref 17592186120790 #edb/ref 17592186045417] [17592186120977 #edb/ref 1061 9881 #edb/ref 17592186045417] [17592186120977 #edb/ref 1062 #uuid "40ba1e04-bcee-59a8-8c09-889d763a2116" #edb/ref 17592186045417] [17592186120977 #edb/ref 1063 #edb/ref 17592186119980 #edb/ref 17592186045417] [17592186120978 #edb/ref 1058 #edb/ref 17592186120792 #edb/ref 17592186045417] [17592186120978 #edb/ref 1061 9884 #edb/ref 17592186045417] [17592186120978 #edb/ref 1062 #uuid "bef0ec93-3b3d-56a7-b85c-4ffde2f524ad" #edb/ref 17592186045417] [17592186120978 #edb/ref 1063 #edb/ref 17592186119981 #edb/ref 17592186045417] [17592186120979 #edb/ref 1061 9894 #edb/ref 17592186045417] [17592186120979 #edb/ref 1062 #uuid "7a2a2545-f4a7-5b95-93cf-cc4160242986" #edb/ref 17592186045417] [17592186120979 #edb/ref 1063 #edb/ref 17592186119982 #edb/ref 17592186045417] [17592186120995 #edb/ref 1064 "Since the integration of vector functions is done component-by-component, the properties of integrals of vector functions are immediately inherited from those of the integrals of real-valued functions. \n\nSuppose that $\\mathbf f(t)$ and $\\mathbf g(t)$ are vector-valued functions that are continuous on a closed interval $[a,b],$ and $\\alpha$ is a scalar. \nThen, the *vector addition and scalar multiplication rules* are as follows:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}(f(t)+g(t))\\text{d}t={\\int }_{a}^{b}f(t)\\,\\text{d}t\\,+\\,{\\int }_{a}^{b}g(t)\\,\\text{d}t\\, & \\text{vector addition rule} \\\\ {\\int }_{a}^{b}\\alpha \\,f(t)\\,\\text{d}t=\\alpha \\,{\\int }_{a}^{b}f(t)\\,\\text{d}t\\, & \\text{scalar constant multiple rule}\\end{aligned}\n$$\n\n  \n\nFor example, if $\\mathbf f(t) = \\left\\langle t, \\: \\cos t\\right\\rangle$ and $\\mathbf g(t) = \\left\\langle -t^2, \\: \\sin t \\right\\rangle,$ then we have\n\n$$\n\\begin{aligned}\\int [f(t)+2g(t)]\\text{d}t & =\\int f(t)\\,\\text{d}t+2\\int g(t)\\,\\text{d}t \\\\  & =\\int ⟨t,\\,\\operatorname{cos}⁡t⟩\\,\\text{d}t+2\\int ⟨-{t}^{2},\\,\\operatorname{sin}⁡t⟩\\,\\text{d}t \\\\  & =⟨\\int t\\,\\text{d}t,\\,\\int \\operatorname{cos}⁡t\\,\\text{d}t⟩+⟨2\\int -{t}^{2}\\,\\text{d}t,\\,2\\int \\operatorname{sin}⁡t\\,\\text{d}t⟩ \\\\  & =⟨\\frac{{t}^{2}}{2}+{C}_{1},\\,\\operatorname{sin}⁡t+{C}_{2}⟩+⟨-\\frac{2{t}^{3}}{3}+{C}_{3},\\,-2\\operatorname{cos}⁡t+{C}_{4}⟩ \\\\  & =⟨\\frac{3{t}^{2}-4{t}^{3}}{6},\\,\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t⟩+C\\end{aligned}\n$$\n\n  \n\nwhere $C_1, \\, C_2, \\, C_3, \\, C_4$ are arbitrary real constants and ${\\mathbf C} = \\langle C_1+C_3, C_2+C_4 \\rangle$ is a constant vector." #edb/ref 17592186045417] [17592186120995 #edb/ref 1065 2342 #edb/ref 17592186045417] [17592186120995 #edb/ref 1066 #uuid "b3d07bd2-8d66-5645-a140-c638f5e9f002" #edb/ref 17592186045417] [17592186120995 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121079 #edb/ref 1064 "Given a vector-valued function $\\mathbf f(t)$ that is continuous on a closed interval $[a,b],$ the *rule for reversal of integration limits* states the following:\n\n$$\n\\begin{aligned}{\\int }_{b}^{a}f(t)\\,\\text{d}t=-{\\int }_{a}^{b}f(t)\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121079 #edb/ref 1065 5177 #edb/ref 17592186045417] [17592186121079 #edb/ref 1066 #uuid "43078f08-37bf-59a3-8462-3b3efc865eb1" #edb/ref 17592186045417] [17592186121079 #edb/ref 1067 "The Rule for Reversal of Integration Limits" #edb/ref 17592186045417] [17592186121080 #edb/ref 1064 "Given a vector-valued function $\\mathbf f(t)$ that is continuous on a closed interval $[a,b]$ and $p \\in (a,b),$ the *adjacent intervals rule* states the following:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}f(t)\\,\\text{d}t={\\int }_{a}^{p}f(t)\\,\\text{d}t+{\\int }_{p}^{b}f(t)\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121080 #edb/ref 1065 5178 #edb/ref 17592186045417] [17592186121080 #edb/ref 1066 #uuid "ef0617f3-7ee0-5300-8795-10adbdc19d3b" #edb/ref 17592186045417] [17592186121080 #edb/ref 1067 "The Adjacent Intervals Rule" #edb/ref 17592186045417] [17592186121081 #edb/ref 1064 "Suppose that $\\mathbf f(t)$ is a vector-valued function that is continuous on a closed interval $[a,b]$ and $\\mathbf c$ is a constant vector. \nThen, the *products rules* are as follows:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}[c\\cdot f(t)]\\text{d}t=c\\cdot ({\\int }_{a}^{b}f(t)\\,\\text{d}t)\\, & \\text{dot product rule} \\\\ {\\int }_{a}^{b}[c\\times f(t)]\\text{d}t=c\\times {\\int }_{a}^{b}f(t)\\,\\text{d}t\\, & \\text{cross product rule}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121081 #edb/ref 1065 5179 #edb/ref 17592186045417] [17592186121081 #edb/ref 1066 #uuid "2531e67a-b5ed-5052-a97f-34abca386c58" #edb/ref 17592186045417] [17592186121081 #edb/ref 1067 "The Product Rules" #edb/ref 17592186045417] [17592186360956 #edb/ref 1080 "⟨7,\\,8,\\,-5⟩" #edb/ref 17592186045417] [17592186360956 #edb/r