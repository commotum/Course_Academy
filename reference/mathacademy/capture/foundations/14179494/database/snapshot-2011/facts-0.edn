45417] [17592186362274 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362274 #edb/ref 1071 "Calculate \n${\\int }_{0}^{2}f(t)+⟨2,\\,1,\\,3⟩\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-5,\\,1⟩.$" #edb/ref 17592186045417] [17592186362274 #edb/ref 1072 #uuid "96839d78-4518-5037-87da-021c22bf4ebf" #edb/ref 17592186045417] [17592186362274 #edb/ref 1074 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-4,\\,-5,\\,1⟩ \\\\  & =⟨4,\\,5,\\,-1⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)+⟨2,\\,1,\\,3⟩\\,\\text{d}t & ={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{0}^{2}⟨2,\\,1,\\,3⟩\\,\\text{d}t \\\\  & =⟨4,\\,5,\\,-1⟩+{⟨2t,\\,t,\\,3t⟩|}_{0}^{2} \\\\  & =⟨4,\\,5,\\,-1⟩+⟨4,\\,2,\\,6⟩\\text{ } \\\\  & =⟨8,\\,7,\\,5⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186362280 #edb/ref 1068 #edb/ref 17592186362173 #edb/ref 17592186045417] [17592186362280 #edb/ref 1069 "q-98279" #edb/ref 17592186045417] [17592186362280 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362280 #edb/ref 1071 "Find ${\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{2}^{3}f(t)\\,\\text{d}t=6\\,i-4\\,j+3\\,k$ \nand \n$c=i-2\\,j+2\\,k.$" #edb/ref 17592186045417] [17592186362280 #edb/ref 1072 #uuid "a1abbcff-4b27-5160-b258-2d2220b77c3e" #edb/ref 17592186045417] [17592186362280 #edb/ref 1074 "The cross-product rule states that\n\n$$\n{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t \\\\  & =(i-2\\,j+2\\,k)\\times (6\\,i-4\\,j+3\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & -2 & 2 \\\\ 6 & -4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 2 \\\\ -4 & 3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 6 & 3\\end{aligned}|j+|\\begin{aligned}1 & -2 \\\\ 6 & -4\\end{aligned}|k \\\\  & =(-6+8)i-(3-12)j+(-4+12)k \\\\  & =2\\,i+9\\,j+8\\,k.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186395458 #edb/ref 1068 #edb/ref 17592186395459 #edb/ref 17592186045417] [17592186395458 #edb/ref 1069 "q-98186" #edb/ref 17592186045417] [17592186395458 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186395458 #edb/ref 1071 "Calculate \n${\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{0}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,-2⟩.$" #edb/ref 17592186045417] [17592186395458 #edb/ref 1072 #uuid "f6362c37-2e32-54b3-8aa0-c3cb9e6d3761" #edb/ref 17592186045417] [17592186395458 #edb/ref 1074 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)\\,\\text{d}t & =-{\\int }_{3}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨5,\\,-1,\\,-2⟩ \\\\  & =⟨-5,\\,1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{0}^{3}⟨-1,\\,1,\\,-1⟩\\,\\text{d}t \\\\  & =⟨-5,\\,1,\\,2⟩+{⟨-t,\\,t,\\,-t⟩|}_{0}^{3} \\\\  & =⟨-5,\\,1,\\,2⟩+⟨-3,\\,3,\\,-3⟩\\text{ } \\\\  & =⟨-8,\\,4,\\,-1⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186395459 #edb/ref 1075 #edb/ref 17592186395460 #edb/ref 17592186045417] [17592186395459 #edb/ref 1075 #edb/ref 17592186395461 #edb/ref 17592186045417] [17592186395459 #edb/ref 1075 #edb/ref 17592186395462 #edb/ref 17592186045417] [17592186395459 #edb/ref 1075 #edb/ref 17592186395463 #edb/ref 17592186045417] [17592186395459 #edb/ref 1075 #edb/ref 17592186395464 #edb/ref 17592186045417] [17592186395459 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186395459 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186395459 #edb/ref 1078 #edb/ref 17592186395462 #edb/ref 17592186045417] [17592186395459 #edb/ref 1079 #uuid "41b5d00f-231c-5d5e-9824-656cae587369" #edb/ref 17592186045417] [17592186395460 #edb/ref 1080 "⟨-8,\\,2,\\,1⟩" #edb/ref 17592186045417] [17592186395460 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395460 #edb/ref 1083 #uuid "6f78597b-fe94-5d3b-a150-9662a2903e53" #edb/ref 17592186045417] [17592186395461 #edb/ref 1080 "⟨8,\\,4,\\,1⟩" #edb/ref 17592186045417] [17592186395461 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395461 #edb/ref 1083 #uuid "54233a06-2e66-5ab0-bfb0-15ca60c09e48" #edb/ref 17592186045417] [17592186395462 #edb/ref 1080 "⟨-8,\\,4,\\,-1⟩" #edb/ref 17592186045417] [17592186395462 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395462 #edb/ref 1083 #uuid "2f8ee068-02df-52c1-8b28-1bce069cc447" #edb/ref 17592186045417] [17592186395463 #edb/ref 1080 "⟨2,\\,2,\\,-1⟩" #edb/ref 17592186045417] [17592186395463 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395463 #edb/ref 1083 #uuid "4dc8b035-a308-57f9-911c-85c571aca7df" #edb/ref 17592186045417] [17592186395464 #edb/ref 1080 "⟨2,\\,-2,\\,0⟩" #edb/ref 17592186045417] [17592186395464 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395464 #edb/ref 1083 #uuid "522f82da-1bbc-554e-89ea-d20bd82ed703" #edb/ref 17592186045417] [17592186458664 #edb/ref 1080 "⟨13,\\,-3,\\,10⟩" #edb/ref 17592186045417] [17592186458664 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458664 #edb/ref 1083 #uuid "1770cd34-f70c-5405-bc7b-b9d4f95e4c22" #edb/ref 17592186045417] [17592186458770 #edb/ref 1080 "⟨5,\\,3,\\,-2⟩" #edb/ref 17592186045417] [17592186458770 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458770 #edb/ref 1083 #uuid "510a2381-6080-5830-8cfb-ceaa0df9ee22" #edb/ref 17592186045417] [17592186458929 #edb/ref 1080 "⟨5,\\,-3,\\,10⟩" #edb/ref 17592186045417] [17592186458929 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458929 #edb/ref 1083 #uuid "a7c760d4-b497-537f-89c0-c6189aeab7dc" #edb/ref 17592186045417] [17592186459035 #edb/ref 1080 "⟨5,\\,3,\\,4⟩" #edb/ref 17592186045417] [17592186459035 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186459035 #edb/ref 1083 #uuid "e8f911cc-6f46-5833-a95c-f41133ebf040" #edb/ref 17592186045417] [17592186459053 #edb/ref 1080 "⟨13,\\,-3,\\,5⟩" #edb/ref 17592186045417] [17592186459053 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186459053 #edb/ref 1083 #uuid "efba41c7-5000-5054-9377-b76b30b98b78" #edb/ref 17592186045417] [17592186459089 #edb/ref 1075 #edb/ref 17592186458664 #edb/ref 17592186045417] [17592186459089 #edb/ref 1075 #edb/ref 17592186458770 #edb/ref 17592186045417] [17592186459089 #edb/ref 1075 #edb/ref 17592186458929 #edb/ref 17592186045417] [17592186459089 #edb/ref 1075 #edb/ref 17592186459035 #edb/ref 17592186045417] [17592186459089 #edb/ref 1075 #edb/ref 17592186459053 #edb/ref 17592186045417] [17592186459089 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186459089 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186459089 #edb/ref 1078 #edb/ref 17592186458770 #edb/ref 17592186045417] [17592186459089 #edb/ref 1079 #uuid "0b926433-52e8-50f6-bf33-fa54c61d9250" #edb/ref 17592186045417] [17592186459224 #edb/ref 1068 #edb/ref 17592186459089 #edb/ref 17592186045417] [17592186459224 #edb/ref 1069 "q-129274" #edb/ref 17592186045417] [17592186459224 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186459224 #edb/ref 1071 "Calculate \n${\\int }_{2}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-6,\\,4⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨9,\\,9,\\,-6⟩.$" #edb/ref 17592186045417] [17592186459224 #edb/ref 1072 #uuid "32ebf6aa-8547-5777-9834-260892a9ca32" #edb/ref 17592186045417] [17592186459224 #edb/ref 1074 "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{2}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{2}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t-(-{\\int }_{2}^{0}f(t)\\,\\text{d}t) \\\\  & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =⟨9,\\,9,\\,-6⟩+⟨-4,\\,-6,\\,4⟩ \\\\  & =⟨5,\\,3,\\,-2⟩.\\end{aligned}\n$$" #edb/ref 17592186045417]}
