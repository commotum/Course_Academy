#{[{:db/id #edb/ref 17592186459224 :knowledge-point/_questions [{:db/id #edb/ref 17592186119981 :knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1770cd34-f70c-5405-bc7b-b9d4f95e4c22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,\\,-3,\\,10⟩" :db/id #edb/ref 17592186458664} {:answer/id #uuid "510a2381-6080-5830-8cfb-ceaa0df9ee22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,3,\\,-2⟩" :db/id #edb/ref 17592186458770} {:answer/id #uuid "a7c760d4-b497-537f-89c0-c6189aeab7dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,-3,\\,10⟩" :db/id #edb/ref 17592186458929} {:answer/id #uuid "e8f911cc-6f46-5833-a95c-f41133ebf040" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,3,\\,4⟩" :db/id #edb/ref 17592186459035} {:answer/id #uuid "efba41c7-5000-5054-9377-b76b30b98b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,\\,-3,\\,5⟩" :db/id #edb/ref 17592186459053}] :answer-field/correct {:answer/id #uuid "510a2381-6080-5830-8cfb-ceaa0df9ee22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,3,\\,-2⟩" :db/id #edb/ref 17592186458770} :answer-field/id #uuid "0b926433-52e8-50f6-bf33-fa54c61d9250" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186459089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32ebf6aa-8547-5777-9834-260892a9ca32" :question/math-academy-id "q-129274" :question/problem "Calculate \n${\\int }_{2}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-6,\\,4⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨9,\\,9,\\,-6⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{2}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{2}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t-(-{\\int }_{2}^{0}f(t)\\,\\text{d}t) \\\\  & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =⟨9,\\,9,\\,-6⟩+⟨-4,\\,-6,\\,4⟩ \\\\  & =⟨5,\\,3,\\,-2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496273 :knowledge-point/_questions [{:db/id #edb/ref 17592186119982 :knowledge-point/id #uuid "1c8ee97e-f2b0-587e-9171-8008f1e0c4aa" :knowledge-point/title "Applying the Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00242b83-572e-53ab-ab15-9ac11dfbe5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,i-\\frac{2}{3}\\,i+\\frac{1}{3}\\,k" :db/id #edb/ref 17592186495510} {:answer/id #uuid "894bdd9e-e9ef-5b86-8bbe-ae7c9838996f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\,i+\\frac{2}{3}\\,j+\\frac{2}{3}\\,k" :db/id #edb/ref 17592186495810} {:answer/id #uuid "b0f9e00c-950f-52ef-bbb0-f302706bc8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+\\frac{2}{3}\\,j+k" :db/id #edb/ref 17592186495907} {:answer/id #uuid "da523dad-c39c-5d16-88c2-713bc37dc420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\,i-\\frac{1}{3}\\,j" :db/id #edb/ref 17592186495991} {:answer/id #uuid "ea456b64-55aa-56ac-80e7-2621dd218995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\,i+\\frac{2}{3}\\,k" :db/id #edb/ref 17592186496026}] :answer-field/correct {:answer/id #uuid "ea456b64-55aa-56ac-80e7-2621dd218995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\,i+\\frac{2}{3}\\,k" :db/id #edb/ref 17592186496026} :answer-field/id #uuid "3fb741de-a765-5845-9e59-3f7b8e4242c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496102}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "773cbe61-ec11-5375-8f39-d897f1cb3120" :question/math-academy-id "q-64333" :question/problem "Find ${\\int }_{0}^{1}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{1}f(t)\\,\\text{d}t=i+\\frac{2}{3}\\,j+k$ \nand \n$c=i+k.$" :question/worked-solution "The cross-product rule states that\n\n$$\n{\\int }_{0}^{1}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{0}^{1}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}c\\times f(t)\\,dt & =c\\times {\\int }_{0}^{1}f(t)\\,dt \\\\  & =(i+k)\\times (i+\\frac{2}{3}\\,j+k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 1 & \\frac{2}{3} & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ \\frac{2}{3} & 1\\end{aligned}|i-|\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 1 & \\frac{2}{3}\\end{aligned}|k \\\\  & =(0-\\frac{2}{3})i-(1-1)j+(\\frac{2}{3}-0)k \\\\  & =-\\frac{2}{3}\\,i+\\frac{2}{3}\\,k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362274 :knowledge-point/_questions [{:db/id #edb/ref 17592186119879 :knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6df5e8-4c1e-5aea-8cda-882d1fa60778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,\\,8,\\,-5⟩" :db/id #edb/ref 17592186360956} {:answer/id #uuid "2fdefba1-6c55-55e9-acd4-8e3a36502ff9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,7,\\,7⟩" :db/id #edb/ref 17592186361052} {:answer/id #uuid "51dfb9cf-bce3-5ae5-9bd5-05c83286d4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,\\,7,\\,5⟩" :db/id #edb/ref 17592186361196} {:answer/id #uuid "880f9476-34e4-51c1-8a5d-d982831989fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,7,\\,6⟩" :db/id #edb/ref 17592186361443} {:answer/id #uuid "c20a0625-de13-5856-9327-e11a2064ea2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\,-3,\\,5⟩" :db/id #edb/ref 17592186361707}] :answer-field/correct {:answer/id #uuid "51dfb9cf-bce3-5ae5-9bd5-05c83286d4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,\\,7,\\,5⟩" :db/id #edb/ref 17592186361196} :answer-field/id #uuid "14f6ad9f-df02-5eed-be88-87306efac820" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361998}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96839d78-4518-5037-87da-021c22bf4ebf" :question/math-academy-id "q-98185" :question/problem "Calculate \n${\\int }_{0}^{2}f(t)+⟨2,\\,1,\\,3⟩\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-5,\\,1⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-4,\\,-5,\\,1⟩ \\\\  & =⟨4,\\,5,\\,-1⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)+⟨2,\\,1,\\,3⟩\\,\\text{d}t & ={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{0}^{2}⟨2,\\,1,\\,3⟩\\,\\text{d}t \\\\  & =⟨4,\\,5,\\,-1⟩+{⟨2t,\\,t,\\,3t⟩|}_{0}^{2} \\\\  & =⟨4,\\,5,\\,-1⟩+⟨4,\\,2,\\,6⟩\\text{ } \\\\  & =⟨8,\\,7,\\,5⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395458 :knowledge-point/_questions [{:db/id #edb/ref 17592186119879 :knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f78597b-fe94-5d3b-a150-9662a2903e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,\\,2,\\,1⟩" :db/id #edb/ref 17592186395460} {:answer/id #uuid "54233a06-2e66-5ab0-bfb0-15ca60c09e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,\\,4,\\,1⟩" :db/id #edb/ref 17592186395461} {:answer/id #uuid "2f8ee068-02df-52c1-8b28-1bce069cc447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,\\,4,\\,-1⟩" :db/id #edb/ref 17592186395462} {:answer/id #uuid "4dc8b035-a308-57f9-911c-85c571aca7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,2,\\,-1⟩" :db/id #edb/ref 17592186395463} {:answer/id #uuid "522f82da-1bbc-554e-89ea-d20bd82ed703" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-2,\\,0⟩" :db/id #edb/ref 17592186395464}] :answer-field/correct {:answer/id #uuid "2f8ee068-02df-52c1-8b28-1bce069cc447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,\\,4,\\,-1⟩" :db/id #edb/ref 17592186395462} :answer-field/id #uuid "41b5d00f-231c-5d5e-9824-656cae587369" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395459}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6362c37-2e32-54b3-8aa0-c3cb9e6d3761" :question/math-academy-id "q-98186" :question/problem "Calculate \n${\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{0}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,-2⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)\\,\\text{d}t & =-{\\int }_{3}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨5,\\,-1,\\,-2⟩ \\\\  & =⟨-5,\\,1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{0}^{3}⟨-1,\\,1,\\,-1⟩\\,\\text{d}t \\\\  & =⟨-5,\\,1,\\,2⟩+{⟨-t,\\,t,\\,-t⟩|}_{0}^{3} \\\\  & =⟨-5,\\,1,\\,2⟩+⟨-3,\\,3,\\,-3⟩\\text{ } \\\\  & =⟨-8,\\,4,\\,-1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362280 :knowledge-point/_questions [{:db/id #edb/ref 17592186119982 :knowledge-point/id #uuid "1c8ee97e-f2b0-587e-9171-8008f1e0c4aa" :knowledge-point/title "Applying the Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34155e97-7b5d-5333-bd91-590faf37bb09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+6\\,j+9\\,k" :db/id #edb/ref 17592186361065} {:answer/id #uuid "45fe8286-d1b6-5e56-ab17-5cac01ac2b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+9\\,j+8\\,k" :db/id #edb/ref 17592186361139} {:answer/id #uuid "82ccc70f-01f6-504f-a89e-2214dbcf16e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i-9\\,j-8\\,k" :db/id #edb/ref 17592186361418} {:answer/id #uuid "cb1e0ae0-ce3c-5925-992b-a2181bc3eed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,i-6\\,j+8\\,k" :db/id #edb/ref 17592186361753} {:answer/id #uuid "db780415-7197-56c4-84b1-eae048959926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-6\\,j-9\\,k" :db/id #edb/ref 17592186361813}] :answer-field/correct {:answer/id #uuid "45fe8286-d1b6-5e56-ab17-5cac01ac2b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+9\\,j+8\\,k" :db/id #edb/ref 17592186361139} :answer-field/id #uuid "d30ed4af-6fcc-5dba-96bc-287d8a2c2db5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362173}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1abbcff-4b27-5160-b258-2d2220b77c3e" :question/math-academy-id "q-98279" :question/problem "Find ${\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{2}^{3}f(t)\\,\\text{d}t=6\\,i-4\\,j+3\\,k$ \nand \n$c=i-2\\,j+2\\,k.$" :question/worked-solution "The cross-product rule states that\n\n$$\n{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t \\\\  & =(i-2\\,j+2\\,k)\\times (6\\,i-4\\,j+3\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & -2 & 2 \\\\ 6 & -4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 2 \\\\ -4 & 3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 6 & 3\\end{aligned}|j+|\\begin{aligned}1 & -2 \\\\ 6 & -4\\end{aligned}|k \\\\  & =(-6+8)i-(3-12)j+(-4+12)k \\\\  & =2\\,i+9\\,j+8\\,k.\\end{aligned}\n$$"}]}
