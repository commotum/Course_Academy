465-a3ff-27207f2d93f5" #edb/ref 17592186045417] [17592186278144 #edb/ref 1075 #edb/ref 17592186275678 #edb/ref 17592186045417] [17592186278144 #edb/ref 1075 #edb/ref 17592186276085 #edb/ref 17592186045417] [17592186278144 #edb/ref 1075 #edb/ref 17592186276114 #edb/ref 17592186045417] [17592186278144 #edb/ref 1075 #edb/ref 17592186276764 #edb/ref 17592186045417] [17592186278144 #edb/ref 1075 #edb/ref 17592186277260 #edb/ref 17592186045417] [17592186278144 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278144 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278144 #edb/ref 1078 #edb/ref 17592186277260 #edb/ref 17592186045417] [17592186278144 #edb/ref 1079 #uuid "ee01c459-7210-576f-9970-8c94b5818c33" #edb/ref 17592186045417] [17592186278345 #edb/ref 1068 #edb/ref 17592186277804 #edb/ref 17592186045417] [17592186278345 #edb/ref 1069 "q-160925" #edb/ref 17592186045417] [17592186278345 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278345 #edb/ref 1071 "![](images/c8/c86259b973101d17d732f4ac8c29a1b61de9fadfc67424a2ab6d28a2ceaa9a01.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,\\sqrt{2}\\le u\\le 4,\\,\\,\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nFind the image of $Δ$ under the action of $T.$" #edb/ref 17592186045417] [17592186278345 #edb/ref 1072 #uuid "1bfb95ad-c905-51fe-8cac-7a80399c1f9c" #edb/ref 17592186045417] [17592186278345 #edb/ref 1074 "To map the entire region $Δ$ onto the $xy$-plane, we transform each side of $Δ$ separately:\n\n- Consider the image of the bottom side, where we have $v=\\frac{7\\pi }{6}$ and $\\sqrt{2}\\le u\\le 4.$ \n\nSubstituting $v=\\frac{7\\pi }{6}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{7\\pi }{6}),\\,u\\operatorname{sin}⁡(\\frac{7\\pi }{6})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{7\\pi }{6}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $\\sqrt{2}$ and $4$ centered at $O.$\n\n- Consider the image of the top side, where we have $v=\\frac{9\\pi }{5}$ and $\\sqrt{2}\\le u\\le 4.$ \n\nSubstituting $v=\\frac{9\\pi }{5}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(u\\operatorname{cos}⁡(\\frac{9\\pi }{5}),\\,u\\operatorname{sin}⁡(\\frac{9\\pi }{5})).\\end{aligned}\n$$\n\nThis line segment makes an angle of $\\frac{9\\pi }{5}$ with the positive $x$-axis in the $xy$-plane. Moreover, this segment lies on a line that passes through the origin, and its endpoints lie on the circles of radii $\\sqrt{2}$ and $4$ centered at $O.$\n\n- Consider the image of the left side, where we have $u=\\sqrt{2}$ and $\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}.$ \n\nSubstituting $u=\\sqrt{2}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(\\sqrt{2}\\operatorname{cos}⁡v,\\,\\sqrt{2}\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $\\sqrt{2}$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5}.$\n\n- Consider the image of the right side, where we have $u=4$ and $\\frac{7\\pi }{6}\\le v\\le \\frac{9\\pi }{5}.$ \n\nSubstituting $u=4$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y)=(4\\operatorname{cos}⁡v,\\,4\\operatorname{sin}⁡v).\\end{aligned}\n$$\n\nThis is an arc of the circle of radius $4$ centered at the origin in the $xy$-plane. The arc lies in the first quadrant between the polar rays $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5}.$\n\nTherefore, the image $D$ of $Δ$ under the action of $T$ is the region that is enclosed between \n\n- two circles with polar equations $r=\\sqrt{2}$ and $r=4,$ and\n\n- two rays with polar equations $\\theta =\\frac{7\\pi }{6}$ and $\\theta =\\frac{9\\pi }{5},$\n\nas shown in the diagram below.\n\n![](images/a0/a0beb4e2dfd69e902b927915771985d9e8180ec7910993c3485cc85002956d1e.png)" #edb/ref 17592186045417] [17592186278346 #edb/ref 1068 #edb/ref 17592186278144 #edb/ref 17592186045417] [17592186278346 #edb/ref 1069 "q-160942" #edb/ref 17592186045417] [17592186278346 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278346 #edb/ref 1071 "![](images/04/0412da40e0e04e8da5ec92db1ad665251209a718333ec008ceeebbe308c71855.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 1,\\,\\,0\\le v\\le \\frac{\\pi }{4}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nWhich of the following could be the image of the left side of $Δ$ under the action of $T?$" #edb/ref 17592186045417] [17592186278346 #edb/ref 1072 #uuid "eb782379-9f8a-586a-90e0-b8ba4fd007cb" #edb/ref 17592186045417] [17592186278346 #edb/ref 1074 "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the left side.\n\nFor the left side, we have $u=0$ and $0\\le v\\le \\frac{\\pi }{4}.$ \n\nSubstituting $u=0$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(0\\operatorname{cos}⁡v,\\,0\\operatorname{sin}⁡v) \\\\  & =(0,\\,0),\\,0\\le v\\le \\frac{\\pi }{4}.\\end{aligned}\n$$\n\nThis gives us the point $(0,0)$ in the $xy$-plane, as shown below.\n\n![](images/32/32aa42ca7dc665fb0a486f9a4f984916857d3964934c7a74c50723f1018fd833.png)" #edb/ref 17592186045417] [17592186278347 #edb/ref 1068 #edb/ref 17592186277795 #edb/ref 17592186045417] [17592186278347 #edb/ref 1069 "q-160945" #edb/ref 17592186045417] [17592186278347 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278347 #edb/ref 1071 "![](images/29/2932639855f3031da6adcca7eaee38b992a145809f119902e93958fee47ff2a6.png)\n\nConsider the rectangular region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,1\\le u\\le \\sqrt{3},\\,\\,\\frac{\\pi }{6}\\le v\\le \\frac{\\pi }{2}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nWhich of the following could be the image of the left side of $Δ$ under the action of $T?$" #edb/ref 17592186045417] [17592186278347 #edb/ref 1072 #uuid "f157d340-55fe-5182-98c8-272f8763a3d4" #edb/ref 17592186045417] [17592186278347 #edb/ref 1074 "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the left side.\n\nFor the left side, we have $u=1$ and $\\frac{\\pi }{6}\\le v\\le \\frac{\\pi }{2}.$ \n\nSubstituting $u=1$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(1\\operatorname{cos}⁡v,\\,1\\operatorname{sin}⁡v) \\\\  & =(\\operatorname{cos}⁡v,\\,\\operatorname{sin}⁡v),\\,\\frac{\\pi }{6}\\le v\\le \\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThis is an equation of a circular arc of radius $1$ centered at the origin in the $xy$-plane. \nThe arc lies in the first quadrant between the polar rays $\\theta =\\frac{\\pi }{6}$ and $\\theta =\\frac{\\pi }{2},$ as shown below.\n\n![](images/b8/b829ff7e7a51ed9f8089b0b8fc22f727ccf5dc7b2e937ec90f6a1affb8d29064.png)" #edb/ref 17592186045417]}
