#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186492090} :activity/id #uuid "3a218002-61a4-554f-ad7b-1fff0bdc3316" :activity/scope {:db/id #edb/ref 17592186049678 :topic/id #uuid "0a37136e-6c85-53df-835c-5cf2f76303d3" :topic/math-academy-id 1969} :activity/steps [{:db/id #edb/ref 17592186492080 :step/content {:db/id #edb/ref 17592186354492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0838f7e1-1e2a-5de4-899d-0534f10f1b2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & 4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186351641} {:answer/id #uuid "4bdae80f-03b9-55c3-aadd-11684fd45d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186352262} {:answer/id #uuid "836126d0-86c5-54f1-8f69-77f8c1c3afc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 4 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186352716} {:answer/id #uuid "e3a16fcf-857f-5b60-adf6-cb3cf7586045" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & -4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186353550} {:answer/id #uuid "f648b42e-29eb-56ba-be95-7cf583a892a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186353717}] :answer-field/correct {:db/id #edb/ref 17592186351641} :answer-field/id #uuid "29f200b4-abd8-556b-96a6-d61eebe5f500" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353886}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "18c9e3a0-322a-5b85-8d72-26e41db87e30" :question/math-academy-id "q-86682" :question/problem "Find ${A}^{71},$ where\n\n$$\nA=[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{2} & -1 \\\\ 0 & 1\\end{aligned}].\n$$" :question/worked-solution "First, notice that\n\n$$\n{[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{2} & -1 \\\\ 0 & 1\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}].\n$$\n\nSo, we have been given the following diagonalization of $A:$\n\n$$\nA={{[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{71} & =P{D}^{71}{P}^{-1} \\\\  & =[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}]{[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]}^{71}(\\frac{1}{2}[\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}(-1)^{71} & 0 \\\\ 0 & {1}^{71}\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-2 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "1ba7f498-1881-5ab1-ad8c-dead16debd6e" :step/next {:db/id #edb/ref 17592186492103}} {:db/id #edb/ref 17592186492090 :step/content {:db/id #edb/ref 17592186323905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75e25684-50a9-57d5-a453-f3280d5e984e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 2\\end{aligned}]$" :db/id #edb/ref 17592186322066} {:answer/id #uuid "8f8f40aa-17fd-543a-b848-7fa918e8d3e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}5 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ -1\\end{aligned}]$" :db/id #edb/ref 17592186322287} {:answer/id #uuid "b4b7aa57-385e-526d-af9f-e30495eb3d9b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}2 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 1\\end{aligned}]$" :db/id #edb/ref 17592186322558} {:answer/id #uuid "c02288ab-4da1-566a-bfba-eadf1b8d9b04" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -2\\end{aligned}]$" :db/id #edb/ref 17592186322639} {:answer/id #uuid "e7df6b33-d577-517b-8051-21b8cf6af137" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 2\\end{aligned}]$" :db/id #edb/ref 17592186322963}] :answer-field/correct {:db/id #edb/ref 17592186322066} :answer-field/id #uuid "3c700357-79a1-56bc-aa05-cd5a7a8ba8ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323288}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55fe01d2-18d3-58de-b08f-22bbfece1371" :question/math-academy-id "q-37362" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $N$ given that \n\n$$\nN[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $N:$\n\n$$\nN={{[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $N$ is diagonalizable. The eigenvalues of $N$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-1$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$"} :step/id #uuid "3bdc3345-f3fe-56c7-9d48-45ed67552ad2" :step/next {:db/id #edb/ref 17592186492080}} {:db/id #edb/ref 17592186492095 :step/content {:db/id #edb/ref 17592186272030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c36a09-640e-5f2f-bee6-5e3ec7470874" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}12 & 9 \\\\ -24 & -3\\end{aligned}]" :db/id #edb/ref 17592186269293} {:answer/id #uuid "3064e2aa-2353-5c23-8c5a-c90a2e00dae4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}15 & 9 \\\\ -21 & -6\\end{aligned}]" :db/id #edb/ref 17592186269705} {:answer/id #uuid "47e19908-9201-5477-8a4f-5d2e1bcb5a23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}6 & 3 \\\\ -12 & -9\\end{aligned}]" :db/id #edb/ref 17592186269921} {:answer/id #uuid "6eb22d41-12a9-5433-9689-c05376bd7c15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}15 & 6 \\\\ -12 & -3\\end{aligned}]" :db/id #edb/ref 17592186270252} {:answer/id #uuid "918b8499-30b8-5523-aa6d-ee8503603d93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}12 & 6 \\\\ -18 & -21\\end{aligned}]" :db/id #edb/ref 17592186270536}] :answer-field/correct {:db/id #edb/ref 17592186270252} :answer-field/id #uuid "68aed225-1b65-5210-aa67-e6df22bc4d41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271698}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a83d9fbf-2f37-5a9f-b9ba-27fe8d23afc4" :question/math-academy-id "q-140132" :question/problem "Find ${C}^{36},$ where\n\n$$\nC=[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}\\sqrt[18]{3} & 0 \\\\ 0 & \\sqrt[36]{3}\\end{aligned}][\\begin{aligned}\\frac{2}{3} & \\frac{1}{3} \\\\ 1 & 1\\end{aligned}].\n$$" :question/worked-solution "First, notice that\n\n$$\n{[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{2}{3} & \\frac{1}{3} \\\\ 1 & 1\\end{aligned}]=\\frac{1}{3}[\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}].\n$$\n\nSo, we have been given the following diagonalization of $C:$\n\n$$\nC={{[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}\\sqrt[18]{3} & 0 \\\\ 0 & \\sqrt[36]{3}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $C=PD{P}^{-1}$, we can compute ${C}^{k}$ by using the formula \n\n$$\n{C}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{C}^{36} & =P{D}^{36}{P}^{-1} \\\\  & =[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}]{[\\begin{aligned}\\sqrt[18]{3} & 0 \\\\ 0 & \\sqrt[36]{3}\\end{aligned}]}^{36}(\\frac{1}{3}[\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}]) \\\\  & =\\frac{1}{3}[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}(\\sqrt[18]{3})^{36} & 0 \\\\ 0 & (\\sqrt[36]{3})^{36}\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}{3}^{2} & 0 \\\\ 0 & {3}^{1}\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}3 & -1 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}9 & 0 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}27 & -3 \\\\ -27 & 6\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}15 & 6 \\\\ -12 & -3\\end{aligned}]\\end{aligned}\n$$"} :step/id #uuid "702b377c-b5a4-541e-aae2-92f1f1c6521f"} {:db/id #edb/ref 17592186492096 :step/content {:db/id #edb/ref 17592186354496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123147cc-29a9-5a9b-8197-5141287824db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-4 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -1\\end{aligned}]$" :db/id #edb/ref 17592186351722} {:answer/id #uuid "13590b66-311d-5d93-824a-b8885d95a619" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-4 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}6 \\\\ -7\\end{aligned}]$" :db/id #edb/ref 17592186351733} {:answer/id #uuid "5ce46df1-f81c-53bf-9562-397b90e58c93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-2 \\\\ 8\\end{aligned}]$ and $[\\begin{aligned}7 \\\\ -1\\end{aligned}]$" :db/id #edb/ref 17592186352387} {:answer/id #uuid "d8e2a4f2-1115-53ef-a5a2-b66e4951afd5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-2 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -7\\end{aligned}]$" :db/id #edb/ref 17592186353452} {:answer/id #uuid "e2dc21a8-005f-55af-bc53-974ee66b05b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}-3 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -5\\end{aligned}]$" :db/id #edb/ref 17592186353540}] :answer-field/correct {:db/id #edb/ref 17592186353452} :answer-field/id #uuid "ece55d7d-c7d4-5233-ba8f-7f279a6be42b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186354222}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5dc95dbe-f9a5-583f-bd3e-71e914c88035" :question/math-academy-id "q-86694" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $T$ given that \n\n$$\n[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]T=[\\begin{aligned}5 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $T:$\n\n$$\nT={{{[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}5 & 0 \\\\ 0 & -4\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $T$ is diagonalizable. The eigenvalues of $T$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-4$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}^{-1}=\\frac{1}{-1}[\\begin{aligned}2 & -5 \\\\ -3 & 7\\end{aligned}]=[\\begin{aligned}-2 & 5 \\\\ 3 & -7\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}5 \\\\ -7\\end{aligned}]$"} :step/id #uuid "74909bc5-d999-58f8-826a-ad660fd937ab" :step/next {:db/id #edb/ref 17592186492095}} {:db/id #edb/ref 17592186492103 :step/content {:db/id #edb/ref 17592186354495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121c30d3-381d-5eec-812d-224e51ec2ed5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}2 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 8\\end{aligned}]$" :db/id #edb/ref 17592186351718} {:answer/id #uuid "28b0ed5c-9277-577c-b0f4-46d45ce08e7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 6\\end{aligned}]$" :db/id #edb/ref 17592186351944} {:answer/id #uuid "82f7010b-3ded-54da-922f-5d2a3139d0b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}3 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 8\\end{aligned}]$" :db/id #edb/ref 17592186352711} {:answer/id #uuid "b584defc-90ec-51d9-af5c-7473d8c554a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}2 \\\\ -6\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186353119} {:answer/id #uuid "c68fd66d-ff23-5aca-a7e5-22e416ac2158" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$[\\begin{aligned}1 \\\\ -3\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 4\\end{aligned}]$" :db/id #edb/ref 17592186353290}] :answer-field/correct {:db/id #edb/ref 17592186351718} :answer-field/id #uuid "41d0c1c4-db7a-5402-823c-10bcfe18c23c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353929}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a0ebddfd-78f1-5dda-8990-10394fcd7459" :question/math-academy-id "q-86693" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\n[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]B=[\\begin{aligned}-2 & 0 \\\\ 0 & 7\\end{aligned}][\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $B:$ \n\n$$\nB={{{[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}-2 & 0 \\\\ 0 & 7\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=7$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}2 & -3 \\\\ -5 & 8\\end{aligned}]=[\\begin{aligned}2 & -3 \\\\ -5 & 8\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 8\\end{aligned}]$"} :step/id #uuid "a769baed-2a11-58f0-9d78-7ebc9197c7d0" :step/next {:db/id #edb/ref 17592186492096}}] :activity/title "Properties of Diagonalization" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186491442}]}
