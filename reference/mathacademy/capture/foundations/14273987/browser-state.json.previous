><mo stretchy=\"false\">(</mo><msup><mn>8</mn><mn>2</mn></msup><mo>−</mo><msup><mn>6</mn><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>13</mn><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>64</mn><mo>−</mo><mn>36</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>13</mn><mo>⋅</mo><mn>28</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>364.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
