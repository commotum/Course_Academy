#{[{:activity/first-step {:db/id #edb/ref 17592186193619} :activity/id #uuid "e3d33137-c31a-567d-baff-3e933e4f2403" :activity/scope {:db/id #edb/ref 17592186048538 :topic/id #uuid "a7907bdb-038e-5baa-a4ae-df7b362e291b" :topic/math-academy-id 4100} :activity/steps [{:db/id #edb/ref 17592186193618 :step/content {:db/id #edb/ref 17592186192760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192479 :question/id #uuid "3f141210-8194-5346-9e2a-c47f98bb3443" :question/math-academy-id "e-10840"} :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048750}] :knowledge-point/questions [{:db/id #edb/ref 17592186193396} {:db/id #edb/ref 17592186193398} {:db/id #edb/ref 17592186262582} {:db/id #edb/ref 17592186262583} {:db/id #edb/ref 17592186262584} {:db/id #edb/ref 17592186262585} {:db/id #edb/ref 17592186262586} {:db/id #edb/ref 17592186354561}] :knowledge-point/title "Computing a Probability Over an Unbounded Interval"} :step/id #uuid "d9a24908-03a6-51d6-b5f1-3155cc2dccaf" :step/math-academy-id 41081} {:db/id #edb/ref 17592186193619 :step/content {:db/id #edb/ref 17592186193868 :tutorial/content "Recall that the **probability density function** (or **pdf**) of a continuous random variable $X$ defined over a set $S$ is a function $f(x)$ that satisfies the following conditions:\n\n- $f(x) \\geq 0$ for all $x$ in $S$\n\n- $\\displaystyle \\int_{S} f(x) \\, \\textrm dx = 1$\n\nIt is common for the set $S$ of a continuous random variable $X$ to be an infinite interval. Therefore, we often need to evaluate improper integrals when determining whether a function is a valid pdf and to compute probabilities associated with such a random variable.\n\nFor example, let's consider the following function:\n\n$$\n{\\begin{aligned}{e}^{-x},\\, & x>0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nIs $f(x)$ a valid probability density function? Let's start by sketching its graph:\n\n![](images/35/3559a998491a004c159683aaf0946bb4fdf87f4afe873fdc93235e840b4b0ac8.png)\n\nClearly, $f(x)\\geq 0$ for all $x,$ so this function satisfies the first condition.\n\nTo check that $f(x)$ satisfies the second condition, we need to compute the following integral:\n\n$$\n\\int_S f(x)\\,\\textrm d x = \\int_0^\\infty e^{-x}\\,\\textrm d x\n$$\n\nCalculating this integral using the usual methods, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-x}\\,\\text{d}x & ={[-{e}^{-x}]}_{0}^{\\infty } \\\\  & =[-{e}^{-\\infty }]-[-{e}^{0}] \\\\  & =0-(-1) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, since $f(x)$ satisfies both conditions, we conclude that $f(x)$ is a valid probability density function.\n\nLet's see another example." :tutorial/id #uuid "f9c0835e-afeb-5f5c-b296-1e37ad68d3fa" :tutorial/math-academy-id 6775 :tutorial/title "Introduction"} :step/id #uuid "00b1a7d3-74fb-5434-befa-306fc78d3a8a" :step/math-academy-id 41119 :step/next {:db/id #edb/ref 17592186193699}} {:db/id #edb/ref 17592186193620 :step/content {:db/id #edb/ref 17592186192761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192480 :question/id #uuid "d40a67bd-7d98-58fb-b4a1-7a556e91556a" :question/math-academy-id "e-10851"} :knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7" :knowledge-point/questions [{:db/id #edb/ref 17592186193397} {:db/id #edb/ref 17592186193400} {:db/id #edb/ref 17592186278313} {:db/id #edb/ref 17592186278314} {:db/id #edb/ref 17592186278315} {:db/id #edb/ref 17592186278316} {:db/id #edb/ref 17592186278317} {:db/id #edb/ref 17592186354564} {:db/id #edb/ref 17592186354565}] :knowledge-point/title "Solving for a Constant Given a PDF"} :step/id #uuid "cccafa59-dc36-5d28-96de-c705cc5a1797" :step/math-academy-id 41121 :step/next {:db/id #edb/ref 17592186193618}} {:db/id #edb/ref 17592186193699 :step/content {:db/id #edb/ref 17592186192807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192535 :question/id #uuid "5f988175-cdd9-5ddf-94b5-3b995dc75fce" :question/math-academy-id "e-12329"} :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048121} {:db/id #edb/ref 17592186049644} {:db/id #edb/ref 17592186051021}] :knowledge-point/questions [{:db/id #edb/ref 17592186193139} {:db/id #edb/ref 17592186193210} {:db/id #edb/ref 17592186278308} {:db/id #edb/ref 17592186278309} {:db/id #edb/ref 17592186278310} {:db/id #edb/ref 17592186278311}] :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"} :step/id #uuid "369bab2a-0778-58cb-b362-2b26468c8bd0" :step/math-academy-id 44173 :step/next {:db/id #edb/ref 17592186193620}}] :activity/title "Continuous Random Variables Over Infinite Domains" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192931}]}
