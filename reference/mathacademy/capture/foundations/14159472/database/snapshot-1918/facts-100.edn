5417] [17592186483321 #edb/ref 1075 #edb/ref 17592186482969 #edb/ref 17592186045417] [17592186483321 #edb/ref 1075 #edb/ref 17592186483048 #edb/ref 17592186045417] [17592186483321 #edb/ref 1075 #edb/ref 17592186483110 #edb/ref 17592186045417] [17592186483321 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186483321 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186483321 #edb/ref 1078 #edb/ref 17592186482969 #edb/ref 17592186045417] [17592186483321 #edb/ref 1079 #uuid "d571972e-d66f-51ff-ad55-ae539c035701" #edb/ref 17592186045417] [17592186483332 #edb/ref 1075 #edb/ref 17592186482850 #edb/ref 17592186045417] [17592186483332 #edb/ref 1075 #edb/ref 17592186483040 #edb/ref 17592186045417] [17592186483332 #edb/ref 1075 #edb/ref 17592186483112 #edb/ref 17592186045417] [17592186483332 #edb/ref 1075 #edb/ref 17592186483212 #edb/ref 17592186045417] [17592186483332 #edb/ref 1075 #edb/ref 17592186483229 #edb/ref 17592186045417] [17592186483332 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186483332 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186483332 #edb/ref 1078 #edb/ref 17592186483040 #edb/ref 17592186045417] [17592186483332 #edb/ref 1079 #uuid "ead372e1-7a0e-5867-a1cd-4c08293d91a3" #edb/ref 17592186045417] [17592186483346 #edb/ref 1068 #edb/ref 17592186483332 #edb/ref 17592186045417] [17592186483346 #edb/ref 1069 "q-106761" #edb/ref 17592186045417] [17592186483346 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483346 #edb/ref 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & -2 \\\\ 3 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}],\\,A=[\\begin{aligned}9 & -18 \\\\ 15 & 0\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186483346 #edb/ref 1072 #uuid "04ab001d-eb12-502f-a292-54d2ac24e44a" #edb/ref 17592186045417] [17592186483346 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & -2 \\\\ 3 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}] & =[\\begin{aligned}9 & -18 \\\\ 15 & 0\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1}+{x}_{2} & -2{x}_{1}+2{x}_{2} \\\\ 3{x}_{1}+{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}9 & -18 \\\\ 15 & 0\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}=9 \\\\ -2{x}_{1}+2{x}_{2}=-18 \\\\ 3{x}_{1}+{x}_{2}=15.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 1 & 9 \\\\ -2 & 2 & -18 \\\\ 3 & 1 & 15\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 1 & 9 \\\\ -2 & 2 & -18 \\\\ 3 & 1 & 15\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{3}{2}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 1 & 9 \\\\ 0 & 3 & -9 \\\\ 0 & -\\frac{1}{2} & \\frac{3}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}=9 \\\\ 3{x}_{2}=-9 \\\\ -\\frac{{x}_{2}}{2}=\\frac{3}{2}.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=-3.$ From the first equation, we get \n\n$$\n\\begin{aligned}2{x}_{1}+{x}_{2} & =9 \\\\ 2{x}_{1}+(-3) & =9 \\\\ {x}_{1} & =6.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}6 \\\\ -3\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=6+(-3)=3.$" #edb/ref 17592186045417] [17592186483363 #edb/ref 1068 #edb/ref 17592186483286 #edb/ref 17592186045417] [17592186483363 #edb/ref 1069 "q-106783" #edb/ref 17592186045417] [17592186483363 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483363 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=1+t,\\,{p}_{2}(t)=1-t+{t}^{2},\\,q(t)=4+2{t}^{2}.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186483363 #edb/ref 1072 #uuid "3f47118a-6b16-5a1a-918c-cf6f9d98f21a" #edb/ref 17592186045417] [17592186483363 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(1+t)+{x}_{2}(1-t+{t}^{2}) & =4+2{t}^{2} \\\\ ({x}_{1}+{x}_{2})+({x}_{1}-{x}_{2})t+{x}_{2}{t}^{2} & =4+2{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=4 \\\\ {x}_{1}-{x}_{2}=0 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 1 & 4 \\\\ 1 & -1 & 0 \\\\ 0 & 1 & 2\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & 4 \\\\ 1 & -1 & 0 \\\\ 0 & 1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & 4 \\\\ 0 & -2 & -4 \\\\ 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=4 \\\\ -2{x}_{2}=-4 \\\\ {x}_{2}=2.\\end{aligned}\n$$\n\nFrom the second and third  equations, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+(2)=4\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}2 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=2+2=4.$" #edb/ref 17592186045417] [17592186483389 #edb/ref 1068 #edb/ref 17592186483289 #edb/ref 17592186045417] [17592186483389 #edb/ref 1069 "q-95006" #edb/ref 17592186045417] [17592186483389 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186483389 #edb/ref 1071 "Consider the polynomials ${p}_{1}(t)$ and ${p}_{2}(t),$ given by\n\n$$\n{p}_{1}(t)=1+2t+3{t}^{2},\\,{p}_{2}(t)=-3-t-2{t}^{3}.\n$$\n\nFind $p(t)$ given that $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1},{p}_{2}\\},$ and the coordinates of $p(t)$ relative to $B$ are $[p(t)]_{B}=[\\begin{aligned}3 \\\\ -1\\end{aligned}].$" #edb/ref 17592186045417] [17592186483389 #edb/ref 1072 #uuid "974d5dad-6c2d-5354-babc-ebd956728577" #edb/ref 17592186045417] [17592186483389 #edb/ref 1074 "Any vector in  $\\text{Span}\\{{p}_{1},{p}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =3\\cdot (1+2t+3{t}^{2})+(-1)\\cdot (-3-t-2{t}^{3}) \\\\  & =3+6t+9{t}^{2}-(-3-t-2{t}^{3}) \\\\  & =6+7t+9{t}^{2}+2{t}^{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483390 #edb/ref 1068 #edb/ref 17592186483256 #edb/ref 17592186045417] [17592186483390 #edb/ref 1069 "q-106737" #edb/ref 17592186045417] [17592186483390 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186483390 #edb/ref 1071 "$$\n{A}_{1}=[\\begin{aligned}-1 & 1 \\\\ 2 & -3\\end{aligned}],\\,{A}_{2}=[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}]\n$$\n\nConsider the matrices shown above. Find the matrix $C$ given that $B=\\{{A}_{1},{A}_{2}\\}$ is a basis of $\\text{Span}\\{{A}_{1},{A}_{2}\\},$ and the coordinates of the matrix $C$ relative to $B$ are $[C]_{B}=[\\begin{aligned}4 \\\\ 3\\end{aligned}].$" #edb/ref 17592186045417] [17592186483390 #edb/ref 1072 #uuid "a6139fff-4bc1-54e3-9731-cfafa322d577" #edb/ref 17592186045417] [17592186483390 #edb/ref 1074 "Any vector in $\\text{Span}\\{{A}_{1},{A}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{A}_{1}+{x}_{2}{A}_{2}.\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[C]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}4 \\\\ 3\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}C & =4\\cdot [\\begin{aligned}-1 & 1 \\\\ 2 & -3\\end{aligned}]+3\\cdot [\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 4 \\\\ 8 & -12\\end{aligned}]+[\\begin{aligned}3 & 3 \\\\ 0 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 7 \\\\ 8 & -6\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483409 #edb/ref 1068 #edb/ref 17592186483321 #edb/ref 17592186045417] [17592186483409 #edb/ref 1069 "q-106778" #edb/ref 17592186045417] [17592186483409 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186483409 #edb/ref 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & 0 \\\\ -1 & 1\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}-2 & 3 \\\\ 0 & 1\\end{aligned}],\\,A=[\\begin{aligned}-2 & 9 \\\\ -2 & 5\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then $2{x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186483409 #edb/ref 1072 #uuid "c4795a7a-dbd7-5cec-b948-e685d7225538" #edb/ref 17592186045417] [17592186483409 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & 0 \\\\ -1 & 1\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 & 3 \\\\ 0 & 1\\end{aligned}] & =[\\begin{aligned}-2 & 9 \\\\ -2 & 5\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1}-2{x}_{2} & 3{x}_{2} \\\\ -{x}_{1} & {x}_{1}+{x}_{2}\\end{aligned}] & =[\\begin{aligned}-2 & 9 \\\\ -2 & 5\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}-2{x}_{2}=-2 \\\\ 3{x}_{2}=9 \\\\ -{x}_{1}=-2 \\\\ {x}_{1}+{x}_{2}=5.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & -2 & -2 \\\\ 0 & 3 & 9 \\\\ -1 & 0 & -2 \\\\ 1 & 1 & 5\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & -2 & -2 \\\\ 0 & 3 & 9 \\\\ -1 & 0 & -2 \\\\ 1 & 1 & 5\\end{aligned}] &  & \\begin{aligned}{R}_{1}↔{R}_{4}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 1 & 5 \\\\ 0 & 3 & 9 \\\\ -1 & 0 & -2 \\\\ 2 & -2 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{1} \\\\ {R}_{4}:={R}_{4}+(-2){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 1 & 5 \\\\ 0 & 3 & 9 \\\\ 0 & 1 & 3 \\\\ 0 & -4 & -12\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=5 \\\\ 3{x}_{2}=9 \\\\ {x}_{2}=3 \\\\ -4{x}_{2}=-12.\\end{aligned}\n$$\n\nFrom the second,  third and fourth equations, we get ${x}_{2}=3.$ From the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+3 & =5 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}2 \\\\ 3\\end{aligned}].$\n\nFinally, $2{x}_{1}+{x}_{2}=2\\cdot 2+3=7.$" #edb/ref 17592186045417] [17592186483426 #edb/ref 1068 #edb/ref 17592186483248 #edb/ref 17592186045417] [17592186483426 #edb/ref 1069 "q-106859" #edb/ref 17592186045417] [17592186483426 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186483426 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=1-t+{t}^{3},\\,{p}_{2}(t)=1+t-{t}^{3},\\,{p}_{3}(t)=2+t+{t}^{2},\\,\\,q(t)=-2t-2{t}^{2}.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}],$ then ${x}_{1}=$" #edb/ref 17592186045417] [17592186483426 #edb/ref 1072 #uuid "ed08ece1-de84-563e-9900-4e9012e55ca8" #edb/ref 17592186045417] [17592186483426 #edb/ref 1074 "We need to find ${x}_{1},{x}_{2}$ and ${x}_{3}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)+{x}_{3}{p}_{3}(t)=q(t).\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(1-t+{t}^{3})+{x}_{2}(1+t-{t}^{3})+{x}_{3}(2+t+{t}^{2}) & =-2t-2{t}^{2} \\\\ ({x}_{1}+{x}_{2}+2{x}_{3})+(-{x}_{1}+{x}_{2}+{x}_{3})t+{x}_{3}{t}^{2}+({x}_{1}-{x}_{2}){t}^{3} & =-2t-2{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}+2{x}_{3}=0 \\\\ -{x}_{1}+{x}_{2}+{x}_{3}=-2 \\\\ {x}_{3}=-2 \\\\ {x}_{1}-{x}_{2}=0.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 0 \\\\ -1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & -2 \\\\ 1 & -1 & 0 & 0\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & 2 & 0 \\\\ -1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & -2 \\\\ 1 & -1 & 0 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{4}:={R}_{4}+(-1){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 2 & 3 & -2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & -2 & -2 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{4}:={R}_{4}+{R}_{2}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 2 & 3 & -2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 1 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{4}:={R}_{4}+(-1){R}_{3}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 2 & 3 & -2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}+2{x}_{3}=0 \\\\ 2{x}_{2}+3{x}_{3}=-2 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the  third equation, we get ${x}_{3}=-2.$ Substituting this into the second equation, we get\n\n$$\n2{x}_{2}+3(-2)=-2\\,⟹\\,{x}_{2}=2.\n$$\n\nNow, substituting the obtained values into the first equation, we get\n\n$$\n{x}_{1}+(2)+2(-2)=0\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}],$ and therefore ${x}_{1}=2.$" #edb/ref 17592186045417]}
