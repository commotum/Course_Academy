#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186193493} :activity/id #uuid "555c23df-016c-5847-bcc4-15704704dfb4" :activity/scope {:db/id #edb/ref 17592186049801 :topic/id #uuid "14fbe17c-9f56-5dba-963a-a64e379ba05f" :topic/math-academy-id 4012} :activity/steps [{:db/id #edb/ref 17592186193493 :step/content {:db/id #edb/ref 17592186193814 :tutorial/content "The **expected value** (also known as the **expectation** or **mean**) of a continuous random variable is the average value we'd expect to get if we observed the random variable many times.\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\textrm E[X] = \\int_S x \\cdot f(x) \\, \\textrm dx\n$$\n\n \n\nFor example, consider the continuous random variable $X$ with the following probability density function:\n\n$$\nf(x) = \\dfrac{x}{4}, \\quad 1 < x < 3\n$$\n\nWe compute the expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{3}x\\cdot \\frac{x}{4}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{{x}^{2}}{4}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{12}|}_{1}^{3} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$" :tutorial/id #uuid "727440ce-9bc9-544c-889f-00c2107d4977" :tutorial/math-academy-id 4804 :tutorial/title "Introduction"} :step/id #uuid "49df91fa-7474-5cd7-bce7-3052e981b2e4" :step/math-academy-id 29818 :step/next {:db/id #edb/ref 17592186193494}} {:db/id #edb/ref 17592186193494 :step/content {:db/id #edb/ref 17592186192675 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192617 :question/id #uuid "61c51284-18f0-5398-857b-7687228e8df8" :question/math-academy-id "e-7985"} :knowledge-point/id #uuid "d3da4448-71cc-5671-8f32-a9f293ad5054" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048317} {:db/id #edb/ref 17592186049638}] :knowledge-point/questions [{:db/id #edb/ref 17592186193396} {:db/id #edb/ref 1759218619