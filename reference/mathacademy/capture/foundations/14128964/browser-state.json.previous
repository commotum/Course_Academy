.7em 0.2em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>3</mn></mrow></msup><mn>2</mn></mfrac></mstyle><mo>,</mo></mtd><mtd><mi>x</mi><mo>&lt;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>1</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>3</mn></mrow></msup><mn>2</mn></mfrac></mstyle></mstyle></mpadded></mstyle><mo>,</mo></mtd><mtd><mi>x</mi><mo>≥</mo><mn>0.</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
