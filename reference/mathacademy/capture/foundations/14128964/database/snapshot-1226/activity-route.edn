#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424891} :activity/id #uuid "dc977e81-fd96-5729-9752-b43ae05cc6d8" :activity/scope {:db/id #edb/ref 17592186050750 :topic/id #uuid "6390206c-1add-5ea0-84f9-8288f56f20b5" :topic/math-academy-id 2163} :activity/steps [{:db/id #edb/ref 17592186424889 :step/content {:db/id #edb/ref 17592186424886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "492f777b-8264-55ab-9be1-d1359bd9513d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{e}^{-x/3}}{2}" :db/id #edb/ref 17592186424871} {:answer/id #uuid "4a7a5540-6762-5260-9b7f-2a98061bf95e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{{e}^{-x/3}}{4}" :db/id #edb/ref 17592186424872} {:answer/id #uuid "50e4b7f0-64ef-587b-bfde-a4520b836560" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\frac{{e}^{-x/3}}{2}" :db/id #edb/ref 17592186424873} {:answer/id #uuid "d60102cb-368c-5209-b3c3-06d9c44b89a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}-\\frac{{e}^{-x/3}}{2}" :db/id #edb/ref 17592186424880} {:answer/id #uuid "ef55c585-a616-50c9-9382-ffb7b5a8ceda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{{e}^{-x/3}}{2}" :db/id #edb/ref 17592186424881}] :answer-field/correct {:db/id #edb/ref 17592186424881} :answer-field/id #uuid "ce55fccd-c2b9-544b-881d-b59a7e7c0f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424884}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b70eaac-0c45-5da5-8a2f-2002d9071035" :question/math-academy-id "q-89727" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|x/3|}}{6},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x/3}}{2},\\, & x<0 \\\\ h(x),\\, & x\\ge 0.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t/3}}{6}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{t/3}}{6}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t/3}}{6}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t/3}}{6}\\,\\text{d}t & ={\\frac{{e}^{t/3}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{x/3}}{2},\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t/3}}{6}\\,\\text{d}t & ={\\frac{{e}^{x/3}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-t/3}}{6}\\,\\text{d}t & =-{\\frac{{e}^{-t/3}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-x/3}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{-t/3}}{6}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t/3}}{6}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-x/3}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-x/3}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x/3}}{2}, & x<0 \\\\ 1-\\frac{{e}^{-x/3}}{2}, & x\\ge 0.\\end{aligned}\n$$"} :step/id #uuid "3f2429d9-8a43-540c-8ee1-21b8c07473a4" :step/next {:db/id #edb/ref 17592186424890}} {:db/id #edb/ref 17592186424890 :step/content {:db/id #edb/ref 17592186424888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f33f1e-6e04-5ef0-8a18-a9a9635e495a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{11}{27}" :db/id #edb/ref 17592186424869} {:answer/id #uuid "7bc40166-55c4-53b3-bf06-562cddc8e868" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{11}{27}" :db/id #edb/ref 17592186424875} {:answer/id #uuid "8a0df617-e565-5181-bd27-09321bb7abfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{1}{3}" :db/id #edb/ref 17592186424877} {:answer/id #uuid "a3e9b386-cf97-5734-82c8-f8b9318ea865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{1}{3}" :db/id #edb/ref 17592186424878} {:answer/id #uuid "fbbc1dbf-3cbe-5835-99b1-f9050b0ed224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{27}{x}^{3}-\\frac{5}{9}{x}^{2}+\\frac{8}{9}x+\\frac{1}{3}" :db/id #edb/ref 17592186424882}] :answer-field/correct {:db/id #edb/ref 17592186424875} :answer-field/id #uuid "5340e926-2580-5f2f-bf08-46d25e342346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424883}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "97c91681-ff70-5452-bbfe-e1a92bb2e9d1" :question/math-academy-id "q-126156" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}-\\frac{2}{9}(x-1)(x-4),\\, & 1\\le x\\le 4 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<1 \\\\ h(x),\\, & 1\\le x\\le 4 \\\\ 1,\\, & x>4.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that is strictly positive only for $1\\le x\\le 4,$ the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}0, & x<1 \\\\ {\\int }_{1}^{x}f(t)\\,\\text{d}t, & 1\\le x\\le 4 \\\\ 1, & x>4\\end{aligned}\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{x}f(t)\\,\\text{d}t & ={\\int }_{1}^{x}-\\frac{2}{9}(t-1)(t-4)\\,\\text{d}t \\\\  & ={\\int }_{1}^{x}-\\frac{2}{9}({t}^{2}-5t+4)\\,\\text{d}t \\\\  & ={(-\\frac{2}{27}{t}^{3}+\\frac{5}{9}{t}^{2}-\\frac{8}{9}t)|}_{1}^{x} \\\\  & =-\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x-(-\\frac{2}{27}+\\frac{5}{9}-\\frac{8}{9}) \\\\  & =-\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{11}{27}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<1 \\\\ -\\frac{2}{27}{x}^{3}+\\frac{5}{9}{x}^{2}-\\frac{8}{9}x+\\frac{11}{27}, & 1\\le x\\le 4 \\\\ 1, & x>4.\\end{aligned}\n$$"} :step/id #uuid "9bf4404a-eca3-5f58-9aa8-59a46fdb29aa"} {:db/id #edb/ref 17592186424891 :step/content {:db/id #edb/ref 17592186424887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d43dadc-2415-595b-83bd-07293e62a4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186424868} {:answer/id #uuid "2d728c61-ee7a-5242-b976-dff68318b24a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186424870} {:answer/id #uuid "54302da3-4ffd-5ae6-9474-e5f95bb705f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186424874} {:answer/id #uuid "86635ef4-b567-5842-a8be-7564b4bc47cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186424876} {:answer/id #uuid "c53339f9-decf-5456-b59e-339275bad539" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186424879}] :answer-field/correct {:db/id #edb/ref 17592186424870} :answer-field/id #uuid "cf2e7998-6dc3-5838-ae14-0d427c2b4449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424885}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5d72a8e6-eda0-59be-829b-e0298d5412e1" :question/math-academy-id "q-89695" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<1 \\\\ 1-\\frac{1}{x}, & x\\ge 1,\\end{aligned}\n$$\n\nfind $P(X\\le 5).$" :question/worked-solution "The cumulative distribution function of a continuous random variable $X$ is the function $F(x)$ defined by\n\n$$\nF(x)=P(X\\le x).\n$$\n\nHence, the required probability is $F(5)=1-\\frac{1}{5}=\\frac{4}{5}.$"} :step/id #uuid "b81f8974-1a7b-53cb-bb5f-1b47021e293e" :step/next {:db/id #edb/ref 17592186424889}}] :activity/title "Cumulative Distribution Functions for Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424867}]}
