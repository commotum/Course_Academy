#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186419655} :activity/id #uuid "abdc4a65-40f3-528e-9141-f38a1d8b8f37" :activity/scope {:db/id #edb/ref 17592186050546 :topic/id #uuid "5269dbdc-fe3c-5ce7-b18c-f9aa0c7f6711" :topic/math-academy-id 2000} :activity/steps [{:db/id #edb/ref 17592186419655 :step/content {:db/id #edb/ref 17592186129848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc8e0ee-42d1-5e33-ab3e-d149ce209193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20e" :db/id #edb/ref 17592186128574} {:answer/id #uuid "216a895e-32d8-5d87-938d-db65b2d1bddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19e-2" :db/id #edb/ref 17592186419645} {:answer/id #uuid "4a5a35ab-9584-5250-9b05-bab514871947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19-20e" :db/id #edb/ref 17592186419646} {:answer/id #uuid "c482d14a-968e-5fba-92dc-75544ab448dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20-19e" :db/id #edb/ref 17592186419647} {:answer/id #uuid "c6534224-e681-59ea-874f-2267428a83f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16+20e" :db/id #edb/ref 17592186419648}] :answer-field/correct {:db/id #edb/ref 17592186419647} :answer-field/id #uuid "5432046c-908f-53bb-aa5e-d0f6af32c211" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128569}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9bb5733-5b86-5301-9267-6ae190810785" :question/math-academy-id "q-71994" :question/problem "Evaluate the double integral ${∬}_{R}\\frac{1-3x{y}^{2}}{x}\\,\\text{d}A$,  where $R=[1,e]\\times [2,3].$" :question/worked-solution "Using the linearity property of double integrals, we get\n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1-3x{y}^{2}}{x}\\,\\text{d}A & ={∬}_{R}(\\frac{1}{x}-3{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{R}\\frac{1}{x}\\,\\text{d}A-{∬}_{R}3{y}^{2}\\text{ }\\text{d}A.\\end{aligned}\n$$\n\nThe function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1}{x}\\text{ }\\text{d}A & =(3-2){\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡|x|]_{1}^{e} \\\\  & =\\operatorname{ln}⁡(e)-\\operatorname{ln}⁡(1) \\\\  & =1.\\end{aligned}\n$$\n\nThe function under the second integral is independent of $x.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}3{y}^{2}\\text{ }\\text{d}A & =(e-1){\\int }_{2}^{3}3{y}^{2}\\,\\text{d}y \\\\  & =(e-1)[{y}^{3}]_{2}^{3} \\\\  & =(e-1)({3}^{3}-{2}^{3}) \\\\  & =19(e-1).\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{1-3x{y}^{2}}{x}\\,\\text{d}A=1-19(e-1)=20-19e.\\end{aligned}\n$$"} :step/id #uuid "8b0d3e0f-96a8-599d-92f9-04874e8f5b73" :step/next {:db/id #edb/ref 17592186419656}} {:db/id #edb/ref 17592186419656 :step/content {:db/id #edb/ref 17592186129873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60fb41e7-e3b3-596b-9de2-56afe6dd5f07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A" :db/id #edb/ref 17592186346193} {:answer/id #uuid "6c9ef82d-4456-5d25-ad26-90ed8d7f4c1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}x\\,\\text{d}A+{∬}_{T}{x}^{2}y\\,\\text{d}A" :db/id #edb/ref 17592186346295} {:answer/id #uuid "705f8690-2e07-5932-b07c-8089792360e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{T}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A" :db/id #edb/ref 17592186346333} {:answer/id #uuid "9666eb71-130a-59fc-8098-2ba78743d703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}x\\,\\text{d}A+{∬}_{T}y\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A" :db/id #edb/ref 17592186346666} {:answer/id #uuid "c006f721-3d51-5d16-a6a8-1b8222268571" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∬}_{S}x\\,\\text{d}A+{∬}_{T}(x+{x}^{2}y)\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A" :db/id #edb/ref 17592186347011}] :answer-field/correct {:db/id #edb/ref 17592186346193} :answer-field/id #uuid "8ef450e5-1471-5ba8-8652-38a2e4337160" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e01cd29-3b44-5c08-bc75-551f046b44dd" :question/math-academy-id "q-80452" :question/problem "![](images/ed/ed0be2aca8d43d733e91f3a8feaaca0649957dcbd516a8218b1e7dea136170d8.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)={\\begin{aligned}x, & (x,y)\\in S, \\\\ 0, & (x,y)\\in T, \\\\ {x}^{2}y, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" :question/worked-solution "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}x\\,\\text{d}A+{∬}_{T}0\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A \\\\  & ={∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A.\\end{aligned}\n$$"} :step/id #uuid "b57250fe-0a51-501d-8a2f-9f787d4986a6" :step/next {:db/id #edb/ref 17592186419657}} {:db/id #edb/ref 17592186419657 :step/content {:db/id #edb/ref 17592186419654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168581f2-f17c-5d44-a38c-f447560aea9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186419644} {:answer/id #uuid "c6d9732d-dbc5-596f-ab65-73c4ce86f71e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186419649} {:answer/id #uuid "d0b906bf-abf8-5f7b-aa2d-46eb0fb79934" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186419650} {:answer/id #uuid "da997437-2a62-59ee-9431-4e9d511ef420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186419651} {:answer/id #uuid "f67323c5-5cdb-58d8-a3cb-89a513553c59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186419652}] :answer-field/correct {:db/id #edb/ref 17592186419644} :answer-field/id #uuid "35e876f8-837f-5088-b5c0-91f0a9d62487" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a49df285-b000-551a-958c-a18cbfff682c" :question/math-academy-id "q-80659" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-3,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=5,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}-2f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}-2f(x,y)\\text{ }\\text{d}A & =-2\\cdot \\,\\,\\,{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =-2\\cdot ({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =-2\\cdot (-3+5) \\\\  & =-4\\end{aligned}\n$$"} :step/id #uuid "f337f9e2-418d-5c24-9790-11f1621a546e"}] :activity/title "Properties of Double Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419643}]}
