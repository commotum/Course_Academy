\"false\">)</mo><mo data-mjx-alternate=\"1\">′</mo></msup><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>5</mn><mi>x</mi></mrow></msup></mtd></mtr><mtr><mtd><msubsup><mi>u</mi><mn>1</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msubsup><mi>u</mi><mn>2</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup><mo>=</mo><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">⟹</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mtable columnalign=\"left left\" columnspacing=\"1em\" rowspacing=\"0.7em 0.2em\"><mtr><mtd><msubsup><mi>u</mi><mn>1</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mn>2</mn><msubsup><mi>u</mi><mn>2</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>5</mn><mi>x</mi></mrow></msup></mtd></mtr><mtr><mtd><msubsup><mi>u</mi><mn>1</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msubsup><mi>u</mi><mn>2</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>x</mi></mrow></msup><mo>=</mo><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We wish to find an integral expression for <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"20\