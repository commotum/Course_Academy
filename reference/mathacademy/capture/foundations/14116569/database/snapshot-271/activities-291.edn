86064954} {:db/id #edb/ref 17592186064955} {:db/id #edb/ref 17592186233133} {:db/id #edb/ref 17592186234379} {:db/id #edb/ref 17592186234380} {:db/id #edb/ref 17592186247110} {:db/id #edb/ref 17592186247111} {:db/id #edb/ref 17592186247112} {:db/id #edb/ref 17592186247113} {:db/id #edb/ref 17592186247130} {:db/id #edb/ref 17592186297355} {:db/id #edb/ref 17592186297356} {:db/id #edb/ref 17592186297357} {:db/id #edb/ref 17592186317294} {:db/id #edb/ref 17592186317295} {:db/id #edb/ref 17592186317296} {:db/id #edb/ref 17592186317297} {:db/id #edb/ref 17592186317298} {:db/id #edb/ref 17592186317299} {:db/id #edb/ref 17592186345153} {:db/id #edb/ref 17592186345179} {:db/id #edb/ref 17592186345181} {:db/id #edb/ref 17592186345182} {:db/id #edb/ref 17592186345184} {:db/id #edb/ref 17592186366274}] :knowledge-point/title "Finding a Derivative Using Properties of Inverse Functions"} :step/id #uuid "7584e271-65ff-5831-8847-5f5e3a737754" :step/math-academy-id 187691}] :activity/title "Differentiating an Inverse Function at a Point" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064396}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409839} :activity/id #uuid "f566dc84-1e6c-5c3c-9fcc-e05918f8418d" :activity/scope {:db/id #edb/ref 17592186048441 :topic/id #uuid "9faf7c3f-8d4f-5e48-97ed-6c10e2c5383a" :topic/math-academy-id 291} :activity/steps [{:db/id #edb/ref 17592186409837 :step/content {:db/id #edb/ref 17592186409835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f3f95aa-4ff5-5778-912a-4e72354aee90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186409824} {:answer/id #uuid "58770571-0d16-5811-81f1-369401a6b261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186409825} {:answer/id #uuid "59d1a2f1-8dc8-5d29-a302-08e96496fd6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186409826} {:answer/id #uuid "bb476700-47a3-54b6-8384-b9eab15af2bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186409829} {:answer/id #uuid "ff95022d-0315-5d9e-babd-36b52f088340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186409832}] :answer-field/correct {:db/id #edb/ref 17592186409826} :answer-field/id #uuid "cd53fe12-9eba-5b4c-ab0e-a56e97b0b5d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409834}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14d699f1-906b-5c36-8ad3-387a50daa57f" :question/math-academy-id "q-16098" :question/problem "The following table gives the values of functions $f(x)$ and ${f}^{′}(x)$ at some points. Find $({f}^{-1})^{′}(0).$\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ |\n| --- | --- | --- |\n| $0$ | $2$ | $4$ |\n| $2$ | $0$ | $-1$ |" :question/worked-solution "The formula for the derivative of the inverse is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=0,$ we have\n\n$$\n({f}^{-1})^{′}(0)=\\frac{1}{{f}^{′}({f}^{-1}(0))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(0)=2$ and ${f}^{′}(2)=-1.$ Therefore, \n\n$$\n\\begin{aligned}({f}^{-1})^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(2)} \\\\  & =\\frac{1}{(-1)} \\\\  & =-1.\\end{aligned}\n$$"} :step/id #uuid "176bf3b7-7f3b-537d-967f-47062e4a2221" :step/next {:db/id #edb/ref 17592186409838}} {:db/id #edb/ref 17592186409838 :step/content {:db/id #edb/ref 17592186247113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01506915-9279-5845-be61-c4c35f7caa00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186244319} {:answer/id #uuid "13eba5b3-5ee1-54a2-a165-599feede7427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186244494} {:answer/id #uuid "1e2f0aad-80c7-52df-b8b1-92ab89cc1a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186244578} {:answer/id #uuid "74346772-ee82-5598-92fc-961da1e54b1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186245348} {:answer/id #uuid "933b4cc2-b259-5d0b-aed0-2acad610e648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186245597}] :answer-field/correct {:db/id #edb/ref 17592186244578} :answer-field/id #uuid "35c107e1-441a-5e9e-a64c-c9d6f455a387" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34f629c1-9fcd-59d6-b73f-996bb1a66a78" :question/math-academy-id "q-110347" :question/problem "Consider the function $f(x)=-3+5{e}^{x+1}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(2).$" :question/worked-solution "To determine $({f}^{-1})^{′}(2),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(2)=\\frac{1}{{f}^{′}({f}^{-1}(2))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(2).$ To do this, we solve the equation ${f}^{-1}(2)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(2) & =x \\\\ f(x) & =2 \\\\ -3+5{e}^{x+1} & =2 \\\\ 5{e}^{x+1} & =5 \\\\ {e}^{x+1} & =1 \\\\ x+1 & =0 \\\\ x & =-1.\\end{aligned}\n$$\n\nTherefore, ${f}^{-1}(2)=-1.$\n\nNow, we calculate ${f}^{′}(-1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =-3+5{e}^{x+1} \\\\ {f}^{′}(x) & =5{e}^{x+1} \\\\ {f}^{′}(-1) & =5{e}^{0} \\\\ {f}^{′}(-1) & =5\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(2) & =\\frac{1}{{f}^{′}({f}^{-1}(2))} \\\\  & =\\frac{1}{{f}^{′}(-1)} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$"} :step/id #uuid "a496245c-b30d-521d-bb6c-1805665cc858"} {:db/id #edb/ref 17592186409839 :step/content {:db/id #edb/ref 17592186409836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ecb3b6c-5f9d-519e-ac19-a3e22b342ea6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186409823} {:answer/id #uuid "614852f7-d26e-56cc-93b6-f07f9c417f8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186409827} {:answer/id #uuid "8f042161-1e15-525d-8dc1-31568976162b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186409828} {:answer/id #uuid "bc7bca2f-0e02-5b17-90a9-f17776a41ae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186409830} {:answer/id #uuid "ed1bca86-26ee-5bcf-a659-0ec759203aee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186409831}] :answer-field/correct {:db/id #edb/ref 17592186409823} :answer-field/id #uuid "65142116-0d83-53ff-8a22-53c3c70d6112" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409833}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9c5ee55a-541c-5782-b80c-3f5d6eae3256" :question/math-academy-id "q-15643" :question/problem "Consider the function $f(x)=12-6x$ and the point $P(3,-6)$ that lies on $y=f(x).$ Given that $f(x)$ is invertible in the vicinity of $P,$ determine the slope of $y={f}^{-1}(x)$ at the point $(-6,3).$" :question/worked-solution "We start by calculating the derivative of $f$ at the point $(3,-6).$\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =12-6x \\\\ {f}^{′}(x) & =-6 \\\\ {f}^{′}(3) & =-6\\end{aligned}\\end{aligned}\n$$\n\nSince $(3,-6)$ lies on $y=f(x),$ we know that the corresponding point $(-6,3)$ lies on $y={f}^{-1}(x).$\n\nFurthermore, the slopes of the tangents to the two respective points are reciprocals. Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}({f}^{-1})^{′}(-6) & =\\frac{1}{{f}^{′}({f}^{-1}(-6))} \\\\  & =\\frac{1}{{f}^{′}(3)} \\\\  & =\\frac{1}{(-6)} \\\\  & =-\\frac{1}{6}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "b0da1a86-46b3-5c10-bca9-de55fa913cde" :step/next {:db/id #edb/ref 17592186409837}}] :activity/title "Differentiating an Inverse Function at a Point" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409822}]}
