 17592186045417] [17592186360371 #edb/ref 1075 #edb/ref 17592186359718 #edb/ref 17592186045417] [17592186360371 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360371 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360371 #edb/ref 1078 #edb/ref 17592186359292 #edb/ref 17592186045417] [17592186360371 #edb/ref 1079 #uuid "d86a4006-7e81-5ee9-a91c-4ead86d71714" #edb/ref 17592186045417] [17592186360524 #edb/ref 1068 #edb/ref 17592186360205 #edb/ref 17592186045417] [17592186360524 #edb/ref 1069 "q-94873" #edb/ref 17592186045417] [17592186360524 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360524 #edb/ref 1071 "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=1$ given that $∇f(x,y)=2x\\,i+2y\\,j$ and $r(t)={e}^{-t}\\,i+{e}^{t}\\,j.$" #edb/ref 17592186045417] [17592186360524 #edb/ref 1072 #uuid "97fd3ba8-8ab5-5d07-adaa-98357dd8d4e1" #edb/ref 17592186045417] [17592186360524 #edb/ref 1074 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=2x\\,i+2y\\,j.\n$$\n\nFirst, we substitute $x={e}^{-t}$ and $y={e}^{t}$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =2{e}^{-t}\\,i+2{e}^{t}\\,j.\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j \\\\  & =(-{e}^{-t})\\,i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2{e}^{-t}\\,i+2{e}^{t}\\,j)\\cdot ((-{e}^{-t})\\,i+{e}^{t}\\,j) \\\\  & =2{e}^{-t}\\cdot (-{e}^{-t})+2{e}^{t}\\cdot {e}^{t} \\\\  & =2{e}^{2t}-2{e}^{-2t}.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(1))] & =2{e}^{2(1)}-2{e}^{-2(1)} \\\\  & =2{e}^{2}-2{e}^{-2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360529 #edb/ref 1068 #edb/ref 17592186360026 #edb/ref 17592186045417] [17592186360529 #edb/ref 1069 "q-94891" #edb/ref 17592186045417] [17592186360529 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186360529 #edb/ref 1071 "Compute the rate of change of the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})$ with respect to $t$ along the curve $r(t)=⟨t-1,3,2t⟩$ at the point $t=0.$" #edb/ref 17592186045417] [17592186360529 #edb/ref 1072 #uuid "530f5767-4f31-5ef7-a6dd-bdeac420a724" #edb/ref 17592186045417] [17592186360529 #edb/ref 1074 "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂z}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))⟩ \\\\  & =⟨\\frac{2x}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2y}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2z}{{x}^{2}+{y}^{2}+{z}^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=t-1,$ $y=3$ and $z=2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\frac{2(t-1)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(3)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(2t)}{(t-1)^{2}+(3)^{2}+(2t)^{2}}⟩ \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t-1),\\frac{\\text{d}}{\\text{d}t}(3),2t⟩ \\\\  & =⟨1,0,2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\cdot ⟨1,0,2⟩ \\\\  & =\\frac{2t-2}{5{t}^{2}-2t+10}\\cdot 1+\\frac{6}{5{t}^{2}-2t+10}\\cdot 0+\\frac{4t}{5{t}^{2}-2t+10}\\cdot 2 \\\\  & =\\frac{2t-2+8t}{5{t}^{2}-2t+10} \\\\  & =\\frac{10t-2}{5{t}^{2}-2t+10}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=0$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(0))] & =\\frac{10(0)-2}{5(0)^{2}-2(0)+10} \\\\  & =\\frac{-2}{10} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360579 #edb/ref 1068 #edb/ref 17592186360371 #edb/ref 17592186045417] [17592186360579 #edb/ref 1069 "q-95149" #edb/ref 17592186045417] [17592186360579 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360579 #edb/ref 1071 "If $f(x,y,z)=\\operatorname{ln}⁡(xz)+{e}^{y}$ and $r(t)=\\operatorname{sin}⁡t\\,i+{t}^{2}\\,j+\\frac{1}{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" #edb/ref 17592186045417] [17592186360579 #edb/ref 1072 #uuid "312e3468-92a5-5996-9fc8-ac654be83975" #edb/ref 17592186045417] [17592186360579 #edb/ref 1074 "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,k \\\\  & =\\frac{1}{x}\\,i+{e}^{y}\\,j+\\frac{1}{z}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,y={t}^{2},$ and $z=\\frac{1}{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})k \\\\  & =\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k) \\\\  & =\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+2t{e}^{{t}^{2}}-\\frac{t}{{t}^{2}} \\\\  & =\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186428466 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186428466 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account multivariable: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1]; waits [1]. Separate account estimates: multivariable=1 (1/1). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/multivariable-frequency-estimates.json, pair 1936->1934. All account evidence retained in the prepared import's selected-relationships.json." #edb/ref 17592186045436] [17592186428466 #edb/ref 1036 #edb/ref 17592186050143 #edb/ref 17592186045436] [17592186428467 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186428467 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account multivariable: 1 rises / 1 eligible passed source activities = 1.000000; nearest selected fraction = 1. Cr