f 17592186045417] [17592186246816 #edb/ref 1075 #edb/ref 17592186244942 #edb/ref 17592186045417] [17592186246816 #edb/ref 1075 #edb/ref 17592186245139 #edb/ref 17592186045417] [17592186246816 #edb/ref 1075 #edb/ref 17592186246533 #edb/ref 17592186045417] [17592186246816 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186246816 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186246816 #edb/ref 1078 #edb/ref 17592186244770 #edb/ref 17592186045417] [17592186246816 #edb/ref 1079 #uuid "9a537b41-fc08-51bb-8826-c2fd66615e7a" #edb/ref 17592186045417] [17592186247245 #edb/ref 1068 #edb/ref 17592186246816 #edb/ref 17592186045417] [17592186247245 #edb/ref 1069 "q-112149" #edb/ref 17592186045417] [17592186247245 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186247245 #edb/ref 1071 "Given the matrix $A=[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 1 & 1 & 3 & -1\\end{aligned}]$, find a basis of $\\text{Null}(A).$" #edb/ref 17592186045417] [17592186247245 #edb/ref 1072 #uuid "6a443b9d-71e4-51fa-a6eb-49cd9e6d62f7" #edb/ref 17592186045417] [17592186247245 #edb/ref 1074 "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 1 & 1 & 3 & -1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & -1 \\\\ 2 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & -1 \\\\ 0 & 1 & -6 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 9 & -4 \\\\ 0 & 1 & -6 & 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+9{x}_{3}-4{x}_{4}=0 \\\\ {x}_{2}-6{x}_{3}+3{x}_{4}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-9{x}_{3}+4{x}_{4}$ and ${x}_{2}=6{x}_{3}-3{x}_{4},$ where ${x}_{3}$ and ${x}_{4}$ are free variables. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\