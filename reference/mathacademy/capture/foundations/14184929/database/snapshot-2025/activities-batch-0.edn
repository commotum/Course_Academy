#{[{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186125479} :activity/id #uuid "9e51b578-3c1e-53f2-bd6c-584e173a601f" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186125477 :step/content {:db/id #edb/ref 17592186124565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124374 :question/id #uuid "8ebce398-b228-51b0-8506-e0c6124478a5" :question/math-academy-id "e-6852"} :knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707}] :knowledge-point/questions [{:db/id #edb/ref 17592186125052} {:db/id #edb/ref 17592186125056} {:db/id #edb/ref 17592186284575} {:db/id #edb/ref 17592186348265} {:db/id #edb/ref 17592186348266} {:db/id #edb/ref 17592186348267} {:db/id #edb/ref 17592186348268} {:db/id #edb/ref 17592186348269} {:db/id #edb/ref 17592186393982} {:db/id #edb/ref 17592186446872} {:db/id #edb/ref 17592186446873}] :knowledge-point/title "Computing the Differential of a Multivariable Function"} :step/id #uuid "bf1f5b6c-b40c-5ff9-9ed6-50ee5d23ff70" :step/math-academy-id 25383 :step/next {:db/id #edb/ref 17592186125478}} {:db/id #edb/ref 17592186125478 :step/content {:db/id #edb/ref 17592186124566 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124375 :question/id #uuid "bb3ab0dc-7e26-58f5-a0c2-564c01c77f2e" :question/math-academy-id "e-6854"} :knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/questions [{:db/id #edb/ref 17592186125053} {:db/id #edb/ref 17592186125057} {:db/id #edb/ref 17592186284605} {:db/id #edb/ref 17592186348270} {:db/id #edb/ref 17592186348271} {:db/id #edb/ref 17592186348321} {:db/id #edb/ref 17592186372349} {:db/id #edb/ref 17592186375377} {:db/id #edb/ref 17592186375384} {:db/id #edb/ref 17592186393968} {:db/id #edb/ref 17592186446874}] :knowledge-point/title "Computing a Differential in a Geometrical Context"} :step/id #uuid "34d39ab5-5a0c-5548-9b37-4b9ff25664cc" :step/math-academy-id 25385 :step/next {:db/id #edb/ref 17592186125480}} {:db/id #edb/ref 17592186125479 :step/content {:db/id #edb/ref 17592186125813 :tutorial/content "The **differential** of a multivariable function $f(x,y)$ is denoted $\\textrm df(x,y)$ and represents the infinitesimal change in the function value that occurs when the inputs $x$ and $y$ are changed by infinitesimal amounts $\\textrm dx$ and $\\textrm dy.$\n\nThe formula for the differential comes from the multivariable chain rule, which can be expressed as\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y.\\end{aligned}\n$$\n\nNote that the differential can be extended to any number of variables. For example, for a three-variable function $f(x,y,z),$ we have\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z.\\end{aligned}\n$$" :tutorial/id #uuid "549aa462-1d86-5880-b6e2-2f6b1d79b41d" :tutorial/math-academy-id 4191 :tutorial/title "Introduction"} :step/id #uuid "ca5fbd6f-0bec-58b1-a606-32a0d7df8952" :step/math-academy-id 25416 :step/next {:db/id #edb/ref 17592186125477}} {:db/id #edb/ref 17592186125480 :step/content {:db/id #edb/ref 17592186125814 :tutorial/content "Given a multivariable function $f(x,y),$ the differential\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y\\end{aligned}\n$$\n\ntells us how infinitesimal changes in $x$ and $y,$ denoted $\\textrm dx$ and $\\textrm dy,$ result in an infinitesimal change in $f,$ denoted $\\textrm df.$\n\nConsequently, we can use the differential to *approximate* the change in $f$ as we move from one point to another. If we move from a point $(x,y)$ to a point $(x + \\Delta x, y + \\Delta y),$ then the approximate change in $f$ is given by\n\n$$\n\\begin{aligned}Δf(x,y) & ≈(\\frac{∂f}{∂x})\\,Δx+(\\frac{∂f}{∂y})\\,Δy.\\end{aligned}\n$$\n\nThe above formula is very similar to the differential formula, except the $\\textrm d$'s are replaced with $\\Delta$'s. The $\\textrm d$'s refer to infinitesimal changes, while the $\\Delta$'s refer to changes that can actually be measured." :tutorial/id #uuid "c2d5565a-cb57-537b-bd6e-64ebd0b91783" :tutorial/math-academy-id 4214 :tutorial/title "Approximating Change Using Differentials"} :step/id #uuid "98241263-1948-5c19-9eb8-bdad86fba771" :step/math-academy-id 25515 :step/next {:db/id #edb/ref 17592186125481}} {:db/id #edb/ref 17592186125481 :step/content {:db/id #edb/ref 17592186124567 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124376 :question/id #uuid "0c4816ed-fba0-5dc7-94ba-646b875d653d" :question/math-academy-id "e-6875"} :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/questions [{:db/id #edb/ref 17592186125055} {:db/id #edb/ref 17592186125226} {:db/id #edb/ref 17592186284577} {:db/id #edb/ref 17592186284578} {:db/id #edb/ref 17592186348287} {:db/id #edb/ref 17592186348289} {:db/id #edb/ref 17592186348290} {:db/id #edb/ref 17592186348291} {:db/id #edb/ref 17592186348292} {:db/id #edb/ref 17592186348293} {:db/id #edb/ref 17592186354501} {:db/id #edb/ref 17592186354502}] :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"} :step/id #uuid "382f7b0c-adae-5236-b08b-ef5b7008f906" :step/math-academy-id 25516 :step/next {:db/id #edb/ref 17592186125482}} {:db/id #edb/ref 17592186125482 :step/content {:db/id #edb/ref 17592186124568 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124377 :question/id #uuid "febc72d4-b1b8-52c9-a805-013b30695077" :question/math-academy-id "e-6876"} :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/questions [{:db/id #edb/ref 17592186125051} {:db/id #edb/ref 17592186125227} {:db/id #edb/ref 17592186284580} {:db/id #edb/ref 17592186284581} {:db/id #edb/ref 17592186348300} {:db/id #edb/ref 17592186348301} {:db/id #edb/ref 17592186348302} {:db/id #edb/ref 17592186348303} {:db/id #edb/ref 17592186348304} {:db/id #edb/ref 17592186348306} {:db/id #edb/ref 17592186354503} {:db/id #edb/ref 17592186373237}] :knowledge-point/title "Using Differentials to Approximate the Value of a Function"} :step/id #uuid "896f3d03-adff-53cf-be59-7b4310e8b280" :step/math-academy-id 25517}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124739}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186481467} :activity/id #uuid "52ee3973-52bc-556a-8616-fb2686b552f2" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186481450 :step/content {:db/id #edb/ref 17592186348271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} {:answer/id #uuid "33de2cd4-781a-5e11-9d06-401da624c0ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345803} {:answer/id #uuid "6c775b28-e659-58c3-afb4-970c5a4d0320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186346292} {:answer/id #uuid "80dabf23-d4b2-59f9-93af-a8e0472606a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186346477} {:answer/id #uuid "ef0dac21-38b0-572f-851b-fdb97e5e86a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186347461}] :answer-field/correct {:db/id #edb/ref 17592186345359} :answer-field/id #uuid "c0653cbc-f79b-58c9-bc1b-48709188cc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0e792d-8d7d-5fba-9784-ec8ac9d90e29" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"} :step/id #uuid "36110881-4f06-5b62-a14a-640b5c8ecaec" :step/next {:db/id #edb/ref 17592186481470}} {:db/id #edb/ref 17592186481459 :step/content {:db/id #edb/ref 17592186348293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18aa2d29-4200-55a9-9049-eec28d6ce46d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186345569} {:answer/id #uuid "28d8915f-3339-5227-a3ee-86c79928eb21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{\\pi }{2}" :db/id #edb/ref 17592186345717} {:answer/id #uuid "39be8076-d1a4-53bc-beb7-69d5faf74820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186345843} {:answer/id #uuid "e580e49f-e01d-5220-aa00-628de33ae96e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -2" :db/id #edb/ref 17592186347372} {:answer/id #uuid "fb111822-7947-5e96-ad01-3bd29918f4a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186347567}] :answer-field/correct {:db/id #edb/ref 17592186345569} :answer-field/id #uuid "da7d86ef-4dea-5ade-8600-60a413066868" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a50b343-0303-5110-8cf9-6975a85c04cf" :question/math-academy-id "q-79815" :question/problem "If $f(x,y,z)=x\\operatorname{sin}⁡y+y\\operatorname{cos}⁡z,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+(x\\operatorname{cos}⁡y+\\operatorname{cos}⁡z)\\,\\text{d}y-y\\operatorname{sin}⁡z\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,0,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,0,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(0)\\,\\text{d}x+(1\\cdot \\operatorname{cos}⁡(0)+\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\,\\text{d}y-0\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}z \\\\  & =0\\,\\text{d}x+1\\,\\text{d}y+0\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,0+Δy,\\frac{\\pi }{2}+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+1\\,Δy+0\\,Δz.\n$$\n\nMoving from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1),$ we have\n\n$$\n\\begin{aligned}Δx & =0-1=-1, \\\\ Δy & =1-0=1 \\\\ Δz & =1-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+1\\,Δy+0\\,Δz \\\\  & ≈0\\cdot (-1)+1\\cdot (1)+0\\cdot (1-\\frac{\\pi }{2}) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ increases by approximately $1.$"} :step/id #uuid "82baedff-1f18-5874-ab86-496b5c5150c2" :step/next {:db/id #edb/ref 17592186481465}} {:db/id #edb/ref 17592186481465 :step/content {:db/id #edb/ref 17592186284581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9f4654-e89d-5d9e-a79c-0bb5f857defd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.521" :db/id #edb/ref 17592186282101} {:answer/id #uuid "85c51f51-7216-584b-b827-69d84ec4f79d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.652" :db/id #edb/ref 17592186282842} {:answer/id #uuid "beb360a4-ee13-5f31-9c0a-e76bcd78e6b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.359" :db/id #edb/ref 17592186283346} {:answer/id #uuid "e2d331ae-1ad5-5557-89ef-e15bbaae3a68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.482" :db/id #edb/ref 17592186283667} {:answer/id #uuid "e74c9b4d-a866-5c53-8a6c-93a7e66b72ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.274" :db/id #edb/ref 17592186283703}] :answer-field/correct {:db/id #edb/ref 17592186283346} :answer-field/id #uuid "aff6cf4f-69f4-50e0-b11a-e6431b91e83f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284241}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9eb149a3-bdcc-552e-a682-ced670cd4013" :question/math-academy-id "q-167171" :question/problem "Estimate $\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\operatorname{sin}⁡(\\sqrt{x}+y)$ at the point $({\\pi }^{2},0).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\operatorname{cos}⁡(\\sqrt{x}+y)}{2\\sqrt{x}}\\,\\text{d}x+\\operatorname{cos}⁡(\\sqrt{x}+y)\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $({\\pi }^{2},0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{\\operatorname{cos}⁡(\\pi )}{2\\pi }\\,\\text{d}x+\\operatorname{cos}⁡(\\pi )\\,\\text{d}y \\\\  & =-\\frac{1}{2\\pi }\\,\\text{d}x-\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $({\\pi }^{2}+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈-\\frac{1}{2\\pi }\\,Δx-\\,Δy\n$$\n\nNote that \n\n$$\n\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)=f({\\pi }^{2}+1,0.2),\n$$\n\nso we want to move to the point $({\\pi }^{2}+1,0.2).$\n\nMoving from $({\\pi }^{2},0)$ to $({\\pi }^{2}+1,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =({\\pi }^{2}+1)-{\\pi }^{2}=1, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈(-\\frac{1}{2\\pi })\\cdot (1)-1\\cdot (0.2) \\\\  & =-\\frac{1}{2\\pi }-0.2 \\\\  & ≈-0.359.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $-0.359.$ Consequently, we have\n\n$$\n\\begin{aligned}f({\\pi }^{2}+1,0.2) & ≈f({\\pi }^{2},0)-0.359 \\\\ \\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2) & ≈\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}}+0)-0.359 \\\\  & =0-0.359 \\\\  & =-0.359.\\end{aligned}\n$$"} :step/id #uuid "b86e363e-7ec4-59af-9dfb-ebd22f051bfc"} {:db/id #edb/ref 17592186481467 :step/content {:db/id #edb/ref 17592186348265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dad359-25f2-59b1-a326-992f7d8f2be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{2}+{x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345374} {:answer/id #uuid "37a0854b-5ffd-53b5-a97e-3fc8c049dafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345828} {:answer/id #uuid "78a766e2-5151-5cd4-bd3b-cdc71e40524c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346407} {:answer/id #uuid "9d887fd2-2962-51ac-ad91-2c074402c2fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2})\\text{d}x+({x}^{3}-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346722} {:answer/id #uuid "cbcdcfbb-2ee8-5177-94d0-d8a8b2bddfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({x}^{3}-3{y}^{2})\\text{d}x+(2x+3{x}^{2}y)\\text{d}y" :db/id #edb/ref 17592186347137}] :answer-field/correct {:db/id #edb/ref 17592186345828} :answer-field/id #uuid "53ddc30c-7b7f-5181-82b4-b214c29b463f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af353571-e5f3-5cb8-87db-52892f4fbe38" :question/math-academy-id "q-79739" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "cd2d74e5-abec-550d-9ecd-251a39a898c0" :step/next {:db/id #edb/ref 17592186481450}} {:db/id #edb/ref 17592186481470 :step/content {:db/id #edb/ref 17592186348292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5f0ff3-67c3-5156-80d4-3b1056e54271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186345456} {:answer/id #uuid "aa5c1f15-75a4-5090-ab69-ed2b1d6b4397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186346839} {:answer/id #uuid "b34d8f8b-645c-5063-9782-d98391879677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186346918} {:answer/id #uuid "c7663d80-ea3d-53cf-9cff-cd7f8bff08ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186347085} {:answer/id #uuid "de53245c-33e1-5dc2-9980-d68bbba16eee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186347307}] :answer-field/correct {:db/id #edb/ref 17592186345456} :answer-field/id #uuid "6d29f153-5da4-5bde-bade-0dc96a9e6da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347802}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01cbcb4d-5667-5e3e-806c-ef99a5773f2c" :question/math-academy-id "q-79813" :question/problem "If $f(x,y)=xy+x{e}^{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,0)$ to $(1,-0.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(y+{e}^{y})\\,\\text{d}x+(x+x{e}^{y})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,0) & =(0+{e}^{0})\\,\\text{d}x+(2+2\\cdot {e}^{0})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+4\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+4\\,Δy.\n$$\n\nMoving from $(2,0)$ to $(1,-0.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-0.5-0=-0.5.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+4\\,Δy \\\\  & ≈1\\cdot (-1)+4\\cdot (-0.5) \\\\  & ≈-3.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $3.$"} :step/id #uuid "e1760d0a-7b68-5369-867b-8060b5dc8d02" :step/next {:db/id #edb/ref 17592186481459}}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186480733}]}
