#{[{:db/id #edb/ref 17592186079206 :knowledge-point/_questions [{:db/id #edb/ref 17592186078495 :knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/title "Finding General Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bec9d70-f8de-51cf-9e64-a849b809ce13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-4x}" :db/id #edb/ref 17592186342607} {:answer/id #uuid "8f0ed665-7b86-5adb-85fc-2c91f4201111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{4x}" :db/id #edb/ref 17592186343490} {:answer/id #uuid "c479827f-1f07-57f4-80cf-2fa9049345a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{6x}+B{e}^{8x}" :db/id #edb/ref 17592186343966} {:answer/id #uuid "c65f01c2-eff5-56e3-8d94-e7a8e6fe2b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{3x}" :db/id #edb/ref 17592186343978} {:answer/id #uuid "f51f0ae1-02ed-5b8f-a1ff-80e0e5ce8f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{-4x}" :db/id #edb/ref 17592186344396}] :answer-field/correct {:answer/id #uuid "2bec9d70-f8de-51cf-9e64-a849b809ce13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-4x}" :db/id #edb/ref 17592186342607} :answer-field/id #uuid "c56404db-2432-58f9-a3d9-cc82f8d56420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4af7b02-aa3b-5c89-83b9-f0034ff7803a" :question/math-academy-id "q-7781" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +8=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =-4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{-4x}.\n$$"}] [{:db/id #edb/ref 17592186357470 :knowledge-point/_questions [{:db/id #edb/ref 17592186078495 :knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/title "Finding General Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1ea764-4dca-5820-9034-d4b4f70f730b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{-3x}" :db/id #edb/ref 17592186355221} {:answer/id #uuid "5ae4ce25-9e97-5331-8ed8-96b2d9024430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{3x}" :db/id #edb/ref 17592186355466} {:answer/id #uuid "8ba0b662-5fc6-5644-94c1-0e8b93d1e722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{6x}" :db/id #edb/ref 17592186355900} {:answer/id #uuid "aff3c5d4-9583-5b46-a41e-d92a6fb9fbce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{-3x}" :db/id #edb/ref 17592186356214} {:answer/id #uuid "d0936d80-a410-5f00-b078-134eaae76756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-6x}+B{e}^{-x}" :db/id #edb/ref 17592186356488}] :answer-field/correct {:answer/id #uuid "8ba0b662-5fc6-5644-94c1-0e8b93d1e722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{6x}" :db/id #edb/ref 17592186355900} :answer-field/id #uuid "8bf81e32-4f57-597a-af29-291088b46e14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb0ac50b-6a2d-5d53-997b-cb65e0ad2bb8" :question/math-academy-id "q-90720" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-7\\frac{\\text{d}y}{\\text{d}x}+6y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-7\\lambda {e}^{\\lambda x}+6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-7\\lambda +6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-7\\lambda +6=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -1)(\\lambda -6)=0,\n$$\n\nand so $\\lambda =1$ or $\\lambda =6.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{x}+B{e}^{6x}.\n$$"}]}
