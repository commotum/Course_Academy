#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186427573} :activity/id #uuid "227e8665-3923-5e3b-9f94-01de1d340546" :activity/scope {:db/id #edb/ref 17592186048391 :topic/id #uuid "9b93c13d-3e57-5a78-b8a6-0f0a4d64062e" :topic/math-academy-id 614} :activity/steps [{:db/id #edb/ref 17592186427573 :step/content {:db/id #edb/ref 17592186079206 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bec9d70-f8de-51cf-9e64-a849b809ce13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{-4x}" :db/id #edb/ref 17592186342607} {:answer/id #uuid "8f0ed665-7b86-5adb-85fc-2c91f4201111" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+B{e}^{4x}" :db/id #edb/ref 17592186343490} {:answer/id #uuid "c479827f-1f07-57f4-80cf-2fa9049345a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{6x}+B{e}^{8x}" :db/id #edb/ref 17592186343966} {:answer/id #uuid "c65f01c2-eff5-56e3-8d94-e7a8e6fe2b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{3x}" :db/id #edb/ref 17592186343978} {:answer/id #uuid "f51f0ae1-02ed-5b8f-a1ff-80e0e5ce8f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+B{e}^{-4x}" :db/id #edb/ref 17592186344396}] :answer-field/correct {:db/id #edb/ref 17592186342607} :answer-field/id #uuid "c56404db-2432-58f9-a3d9-cc82f8d56420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344837}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4af7b02-aa3b-5c89-83b9-f0034ff7803a" :question/math-academy-id "q-7781" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +8=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =-4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{-4x}.\n$$"} :step/id #uuid "2c217041-6e07-5b2b-ab0b-44e2beb8265c" :step/next {:db/id #edb/ref 17592186427575}} {:db/id #edb/ref 17592186427574 :step/content {:db/id #edb/ref 17592186357470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1ea764-4dca-5820-9034-d4b4f70f730b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+B{e}^{-3x}" :db/id #edb/ref 17592186355221} {:answer/id #uuid "5ae4ce25-9e97-5331-8ed8-96b2d9024430" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+B{e}^{3x}" :db/id #edb/ref 17592186355466} {:answer/id #uuid "8ba0b662-5fc6-5644-94c1-0e8b93d1e722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+B{e}^{6x}" :db/id #edb/ref 17592186355900} {:answer/id #uuid "aff3c5d4-9583-5b46-a41e-d92a6fb9fbce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{-3x}" :db/id #edb/ref 17592186356214} {:answer/id #uuid "d0936d80-a410-5f00-b078-134eaae76756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-6x}+B{e}^{-x}" :db/id #edb/ref 17592186356488}] :answer-field/correct {:db/id #edb/ref 17592186355900} :answer-field/id #uuid "8bf81e32-4f57-597a-af29-291088b46e14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357166}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb0ac50b-6a2d-5d53-997b-cb65e0ad2bb8" :question/math-academy-id "q-90720" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-7\\frac{\\text{d}y}{\\text{d}x}+6y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-7\\lambda {e}^{\\lambda x}+6{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-7\\lambda +6) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-7\\lambda +6=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -1)(\\lambda -6)=0,\n$$\n\nand so $\\lambda =1$ or $\\lambda =6.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{x}+B{e}^{6x}.\n$$"} :step/id #uuid "90c0dd24-f5ff-5d53-a9db-2ea11550684f"} {:db/id #edb/ref 17592186427575 :step/content {:db/id #edb/ref 17592186427572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bda799f-2dc1-508a-b332-a2dc15ad6469" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{e}^{-5t}-4{e}^{2t}" :db/id #edb/ref 17592186427566} {:answer/id #uuid "463b0c74-3f5f-5ede-984f-20e81cf9dab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{-5t}+6{e}^{2t}" :db/id #edb/ref 17592186427567} {:answer/id #uuid "6a3822e6-4ea3-5bd8-88d6-1f35c1d51f37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{e}^{-5t}+2{e}^{-2t}" :db/id #edb/ref 17592186427568} {:answer/id #uuid "bbd12f7d-a1de-5498-8a07-57a3b71dfca4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{e}^{-5t}" :db/id #edb/ref 17592186427569} {:answer/id #uuid "e0c2bf7c-2f4c-5e0e-8a59-5fd6f0e6f6d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{e}^{2t}" :db/id #edb/ref 17592186427570}] :answer-field/correct {:db/id #edb/ref 17592186427568} :answer-field/id #uuid "8f1bdcac-c8f7-5ea7-bb80-b176a1307c71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186427571}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "128c4108-f47c-515a-aaac-ed93eb92e39c" :question/math-academy-id "q-64708" :question/problem "Given that $y=y(t)$ satisfies the equation ${y}^{″}+3{y}^{′}-10y=0,$ which of the following **cannot** be $y(t)?$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+3\\lambda {e}^{\\lambda t}-10{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+3\\lambda -10) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3\\lambda -10 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +5)(\\lambda -2)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-5$ or $\\lambda =2.$\n\nTherefore, any linear combination of the functions ${e}^{-5t}$ and ${e}^{2t}$ is a solution to the original differential equation. \n\nAmong the given options, only $-3{e}^{-5t}+2{e}^{-2t}$ is not a solution."} :step/id #uuid "b72723e4-6cca-52eb-af62-fa6496045372" :step/next {:db/id #edb/ref 17592186427574}}] :activity/title "Second-Order Homogeneous ODEs: Characteristic Equations With Distinct Real Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186427565}]}
