bounded Interval"} :step/id #uuid "629db14c-6e82-5798-a452-f00da2492dfb" :step/math-academy-id 31588}] :activity/title "Approximating Discrete Random Variables as Continuous" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162160}]}
