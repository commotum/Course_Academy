\\\\  & =(2)\\,i+(-8)\\,j \\\\  & =⟨2,-8⟩\\end{aligned}\n$$\n\nHence, $∇f(1,-2)=⟨2,-8⟩$ is a normal vector to the curve at $(1,-2).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(1)}{2} & =\\frac{y-(-2)}{-8} \\\\ (-8)(x-(1)) & =(2)(y-(-2)) \\\\ (-4)(x-(1)) & =(1)(y-(-2)) \\\\ 4 - 4 x & =y + 2 \\\\ 4 x + y - 2 & =0\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186537100 #edb/ref 1068 #edb/ref 17592186537096 #edb/ref 17592186045443] [17592186537100 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186537100 #edb/ref 1071 "Consider the plane curve $2 x^{2} + y^{2}=17.$  Find the equation of the normal line to the curve at the point $(-2,-3).$" #edb/ref 17592186045443] [17592186537100 #edb/ref 1072 #uuid "3df7d364-776e-5dbb-9f2e-436f4e9fc804" #edb/ref 17592186045443] [17592186537100 #edb/ref 1074 "If we set $f(x,y)=2 x^{2} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=17.$  \n\nA normal vector to the level curve that passes through the point $(-2,-3)$ can be found by computing $∇f(-2,-3).$ \n\nSo, we find the gradient and evaluate it at $(-2,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} + y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} + y^{2})\\,j \\\\  & =(4 x)\\,i+(2 y)\\,j \\\\ ∇f(-2,-3) & =(4 (-2))\\,i+(2 (-3))\\,j \\\\  & =(-8)\\,i+(-6)\\,j \\\\  & =⟨-8,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(-2,-3)=⟨-8,-6⟩$ is a normal vector to the curve at $(-2,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(-2)}{-8} & =\\frac{y-(-3)}{-6} \\\\ (-6)(x-(-2)) & =(-8)(y-(-3)) \\\\ (-3)(x-(-2)) & =(-4)(y-(-3)) \\\\ - 3 x - 6 & =- 4 y - 12 \\\\ 3 x - 4 y - 6 & =0\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186537113 #edb/ref 1068 #edb/ref 17592186537085 #edb/ref 17592186045443] [17592186537113 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186537113 #edb/ref 1071 "Consider the plane curve $3 x^{2} + y^{2}=36.$  Find the equation of the normal line to the curve at the point $(3,-3).$" #edb/ref 17592186045443] [17592186537113 #edb/ref 1072 #uuid "a06355a9-e2d0-5a7e-bed1-e1b39de7ef4e" #edb/ref 17592186045443] [17592186537113 #edb/ref 1074 "If we set $f(x,y)=3 x^{2} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=36.$  \n\nA normal vector to the level curve that passes through the point $(3,-3)$ can be found by computing $∇f(3,-3).$ \n\nSo, we find the gradient and evaluate it at $(3,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(3 x^{2} + y^{2})\\,i+\\frac{∂}{∂y}(3 x^{2} + y^{2})\\,j \\\\  & =(6 x)\\,i+(2 y)\\,j \\\\ ∇f(3,-3) & =(6 (3))\\,i+(2 (-3))\\,j \\\\  & =(18)\\,i+(-6)\\,j \\\\  & =⟨18,-6⟩\\end{aligned}\n$$\n\nHence, $∇f(3,-3)=⟨18,-6⟩$ is a normal vector to the curve at $(3,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(3)}{18} & =\\frac{y-(-3)}{-6} \\\\ (-6)(x-(3)) & =(18)(y-(-3)) \\\\ (-1)(x-(3)) & =(3)(y-(-3)) \\\\ 3 - x & =3 y + 9 \\\\ x + 3 y + 6 & =0\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186537122 #edb/ref 1068 #edb/ref 17592186537114 #edb/ref 17592186045443] [17592186537122 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186537122 #edb/ref 1071 "Consider the plane curve $4 x^{2} + 2 y^{2}=22.$  Find the equation of the normal line to the curve at the point $(-1,3).$" #edb/ref 17592186045443] [17592186537122 #edb/ref 1072 #uuid "c34c8b85-1410-5a9f-8287-4a3353c69bd2" #edb/ref 17592186045443] [17592186537122 #edb/ref 1074 "If we set $f(x,y)=4 x^{2} + 2 y^{2}$, our curve can be viewed as the level curve $f(x,y)=22.$  \n\nA normal vector to the level curve that passes through the point $(-1,3)$ can be found by computing $∇f(-1,3).$ \n\nSo, we find the gradient and evaluate it at $(-1,3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(4 x^{2} + 2 y^{2})\\,i+\\frac{∂}{∂y}(4 x^{2} + 2 y^{2})\\,j \\\\  & =(8 x)\\,i+(4 y)\\,j \\\\ ∇f(-1,3) & =(8 (-1))\\,i+(4 (3))\\,j \\\\  & =(-8)\\,i+(12)\\,j \\\\  & =⟨-8,12⟩\\end{aligned}\n$$\n\nHence, $∇f(-1,3)=⟨-8,12⟩$ is a normal vector to the curve at $(-1,3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(-1)}{-8} & =\\frac{y-(3)}{12} \\\\ (12)(x-(-1)) & =(-8)(y-(3)) \\\\ (3)(x-(-1)) & =(-2)(y-(3)) \\\\ 3 x + 3 & =6 - 2 y \\\\ 3 x + 2 y - 3 & =0\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186537130 #edb/ref 1068 #edb/ref 17592186537131 #edb/ref 17592186045443] [17592186537130 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186537130 #edb/ref 1071 "Consider the plane curve $\\frac{x^{2}}{9} + y^{2}=1.$  Find the equation of the normal line to the curve at the point $(-3,0).$" #edb/ref 17592186045443] [17592186537130 #edb/ref 1072 #uuid "fa107303-abd7-5cc9-bd95-cc8524938adb" #edb/ref 17592186045443] [17592186537130 #edb/ref 1074 "If we set $f(x,y)=\\frac{x^{2}}{9} + y^{2}$, our curve can be viewed as the level curve $f(x,y)=1.$  \n\nA normal vector to the level curve that passes through the point $(-3,0)$ can be found by computing $∇f(-3,0).$ \n\nSo, we find the gradient and evaluate it at $(-3,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\frac{x^{2}}{9} + y^{2})\\,i+\\frac{∂}{∂y}(\\frac{x^{2}}{9} + y^{2})\\,j \\\\  & =(\\frac{2 x}{9})\\,i+(2 y)\\,j \\\\ ∇f(-3,0) & =(\\frac{2 (-3)}{9})\\,i+(2 (0))\\,j \\\\  & =(- \\frac{2}{3})\\,i+(0)\\,j \\\\  & =⟨- \\frac{2}{3},0⟩\\end{aligned}\n$$\n\nHence, $∇f(-3,0)=⟨- \\frac{2}{3},0⟩$ is a normal vector to the curve at $(-3,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-(-3))(0)-(y-(0))(- \\frac{2}{3}) & =0 \\\\ \\frac{2 y}{3} & =0 \\\\ y & =0\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186537133 #edb/ref 1168 "generate/scratch/17592186124462.py" #edb/ref 17592186045443] [17592186537133 #edb/ref 1169 #uuid "0b2d95c9-6d9e-5b87-bc06-9168b9223277" #edb/ref 17592186045443] [17592186544072 #edb/ref 1043 #edb/ref 17592186544902 #edb/ref 17592186045417] [17592186544072 #edb/ref 1043 #edb/ref 17592186544916 #edb/ref 17592186045417] [17592186544072 #edb/ref 1043 #edb/ref 17592186544954 #edb/ref 17592186045417] [17592186544072 #edb/ref 1043 #edb/ref 17592186544974 #edb/ref 17592186045417] [17592186544072 #edb/ref 1043 #edb/ref 17592186544983 #edb/ref 17592186045417] [17592186544072 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186544072 #edb/ref 1045 "Modeling With the Exponential Distribution" #edb/ref 17592186045417] [17592186544072 #edb/ref 1046 #edb/ref 17592186544983 #edb/ref 17592186045417] [17592186544072 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186544072 #edb/ref 1049 #edb/ref 17592186048224 #edb/ref 17592186045417] [17592186544072 #edb/ref 1053 #uuid "281bfa6d-174e-50b3-ac57-05c41fca1504" #edb/ref 17592186045417] [17592186544073 #edb/ref 1043 #edb/ref 17592186544910 #edb/ref 17592186045417] [17592186544073 #edb/ref 1043 #edb/ref 17592186544912 #edb/ref 17592186045417] [17592186544073 #edb/ref 1043 #edb/ref 17592