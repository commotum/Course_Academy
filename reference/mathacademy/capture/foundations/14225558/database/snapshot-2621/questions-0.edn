#{[{:db/id #edb/ref 17592186243975 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "844c9f0e-446b-5016-9b76-e7e445bdbd08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461467} {:answer/id #uuid "1dc4d0a4-6d49-5f2e-aa11-b4018d2ef796" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461468}] :answer-field/correct {:answer/id #uuid "844c9f0e-446b-5016-9b76-e7e445bdbd08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461467} :answer-field/id #uuid "8891a4fb-5ede-5445-a9fd-00d3e743bb62" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462487} {:answer-field/choices [{:answer/id #uuid "808eb96b-21d3-55b3-9334-bef1392eaad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461469} {:answer/id #uuid "58c883b2-35bd-528c-a6b1-d5516f9bd5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461470}] :answer-field/correct {:answer/id #uuid "808eb96b-21d3-55b3-9334-bef1392eaad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461469} :answer-field/id #uuid "1bbd0ccb-df41-5cb9-b11a-d086bca693ea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462488} {:answer-field/choices [{:answer/id #uuid "5c96af62-46ae-56c7-88a0-22bb5ebc957b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461471} {:answer/id #uuid "a41e4398-f1c9-51f3-b2d3-cc1222c5d906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461472}] :answer-field/correct {:answer/id #uuid "a41e4398-f1c9-51f3-b2d3-cc1222c5d906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461472} :answer-field/id #uuid "8e4ca1a8-ea04-5785-aaa6-1097c70f54ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c2f74bb-ddf4-5d4c-b244-ad5b6a694598" :question/math-academy-id "q-106897" :question/problem "Which of the following vector spaces has a dimension of $10?$\n- **I.** ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10$\n- **II.** ${\\text{M}}_{5}(R)$, the vector space of all $5\\times 5$ matrices over $R$\n- **III.** ${R}^{10}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n}(\\text{R}))={n}^{2}.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{5}(R))={5}^{2}=25\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{10})=10.\\,✓\n$$\n\nHence, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186259647 :knowledge-point/_questions [{:db/id #edb/ref 17592186179772 :knowledge-point/id #uuid "b99071b9-d463-5e3e-9a0d-71711af836cb" :knowledge-point/title "Inverting Affine Transformations Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5221f3d2-3945-59bf-8f2a-8074c4d35eac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257481} {:answer/id #uuid "6335888e-8880-5dda-bb22-cb264ba5e045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257656} {:answer/id #uuid "65be3f91-2307-5b7c-a45f-3cfedff40838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257678} {:answer/id #uuid "90189be9-60a0-5430-b1cf-cb0e4429164f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258050} {:answer/id #uuid "cf076746-fa92-51fc-a391-045e00ab93d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581}] :answer-field/correct {:answer/id #uuid "cf076746-fa92-51fc-a391-045e00ab93d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258581} :answer-field/id #uuid "ddb82f61-7d4c-5474-a0b0-ba491f22517e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259422}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4865ae47-4fd4-593e-a597-ec2a2d5aa88e" :question/math-academy-id "q-124276" :question/problem "The affine transformation $T$ is defined as\n\n$$\nx=4u+7v+2,\\,y=u+2v+1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-7y+3,\\,v=by+cx-2,\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix} & =\\begin{bmatrix}4u+7v+2 \\\\ u+2v+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4u+7v \\\\ u+2v\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & ={{\\begin{bmatrix}4 & 7 \\\\ 1 & 2\\end{bmatrix}}_{⏟}}_{A}\\cdot {{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u}+{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 4-7\\cdot 1}\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{\\begin{bmatrix}u \\\\ v\\end{bmatrix}}_{⏟}}_{u} & ={{\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}}_{⏟}}_{{A}^{-1}}\\cdot ({{\\begin{bmatrix}x \\\\ y\\end{bmatrix}}_{⏟}}_{x}-{{\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}) \\\\  & =\\begin{bmatrix}2 & -7 \\\\ -1 & 4\\end{bmatrix}\\begin{bmatrix}x-2 \\\\ y-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot (x-2)+(-7)\\cdot (y-1) \\\\ (-1)\\cdot (x-2)+4\\cdot (y-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x-7y+3 \\\\ 4y-x-2\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-7y+3,\\,v=4y+(-1)x-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+4+(-1)=5.\n$$"}] [{:db/id #edb/ref 17592186381118 :knowledge-point/_questions [{:db/id #edb/ref 17592186166851 :knowledge-point/id #uuid "29a290a2-bc9e-57bc-84f5-a21cba4848de" :knowledge-point/title "Reducing a First-Order ODE to a Simpler Form Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5f92bbf-f87d-57e4-a09f-bd3578ea1801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\,\\operatorname{ln}⁡z+1" :db/id #edb/ref 17592186381120} {:answer/id #uuid "ae0911c8-0afc-5d04-a14b-c86b8755f154" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\,\\operatorname{ln}⁡z" :db/id #edb/ref 17592186381121} {:answer/id #uuid "d960268c-49c0-5bf5-8531-969a71b6d803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\operatorname{ln}⁡z-1" :db/id #edb/ref 17592186381122} {:answer/id #uuid "00742b97-d52c-53d6-8721-8e15c6bf04c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡z" :db/id #edb/ref 17592186381123} {:answer/id #uuid "efea176e-ebef-5214-b3f5-e851df1e8e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-\\operatorname{ln}⁡z" :db/id #edb/ref 17592186381124}] :answer-field/correct {:answer/id #uuid "d960268c-49c0-5bf5-8531-969a71b6d803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\operatorname{ln}⁡z-1" :db/id #edb/ref 17592186381122} :answer-field/id #uuid "f5d8b9da-2e10-512b-a08c-50b084b89d21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381119}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c035203-351a-592d-b1dd-a7ea354f996d" :question/math-academy-id "q-149711" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\operatorname{ln}⁡(6y-x).\n$$\n\nUsing a substitution of the form $z=6y-x,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=6y-x.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=6\\,\\frac{\\text{d}y}{\\text{d}x}-1\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{6}\\,\\frac{\\text{d}z}{\\text{d}x}+\\frac{1}{6}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{6}\\,\\frac{\\text{d}z}{\\text{d}x}+\\frac{1}{6} & =-\\operatorname{ln}⁡z\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=-6\\operatorname{ln}⁡z-1.\n$$\n\nTherefore, $f(z)=-6\\operatorname{ln}⁡z-1.$"}] [{:db/id #edb/ref 17592186125098 :knowledge-point/_questions [{:db/id #edb/ref 17592186124536 :knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a98a42c-989a-5419-857e-7af1bacf37c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9I + 3A - A^{2}" :db/id #edb/ref 17592186123189} {:answer/id #uuid "accf5181-8ec7-5d56-b9e1-8ad6d7dd40b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3I + 9A - A^{2}" :db/id #edb/ref 17592186123190} {:answer/id #uuid "d119404e-7f6c-533d-8c8d-f4ac1be8094b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9I - 9A + A^{2}" :db/id #edb/ref 17592186123191} {:answer/id #uuid "e9f237fd-5d8a-5c69-ad6e-33d910b05b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3I - 9A + A^{2}" :db/id #edb/ref 17592186123192} {:answer/id #uuid "f10b6eb6-5570-58f8-b81d-ed6703bc1c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9I + A + A^{2}" :db/id #edb/ref 17592186123193}] :answer-field/id #uuid "a3364b42-0269-5bbd-853e-2a760baddc1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123188}] :question/id #uuid "1aab1c27-1f53-564d-b691-068d98d1a09c" :question/math-academy-id "q-37780" :question/problem "If $A = \\begin{bmatrix}4 & -7 & 3 \\\\ 0 & 1 & 0 \\\\ 5 & -3 & 4\\end{bmatrix}$, then $A^{-1} =$"}]}
