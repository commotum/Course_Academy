 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449650} {:answer/id #uuid "444ee7a0-efba-54ea-bdd4-105d434eca39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449651}] :answer-field/correct {:answer/id #uuid "3e5738f6-983e-551f-b134-397efd15e8e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449650} :answer-field/id #uuid "994914f2-286f-5b0f-b0ef-a7e7ba9ae1e9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450779}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2fc1f275-1b92-5d39-91a9-c77fc478abd0" :question/math-academy-id "q-141461" :question/problem "Which of the following statements are true given that $T:{R}^{4}\\to {R}^{4}$ is a linear transformation whose standard matrix is $T,$ and $T$ is a bijection?\n\nSelect all that apply.\n\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{rank}(T)=4$\n- **III.** $T(v)=0$ for some $v\\ne 0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=4.$\n\n- Statement III is false. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0},$ which means there is no non-zero vector $v$ such that $T(v)=0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186272302 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32d41688-d441-5144-8654-a972f8be5b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464222} {:answer/id #uuid "8e89bfdc-e0ea-5cb6-9225-4a56ce59f56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464223}] :answer-field/correct {:answer/id #uuid "8e89bfdc-e0ea-5cb6-9225-4a56ce59f56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464223} :answer-field/id #uuid "72f72fce-9abb-5a6c-9689-b54025b14cfe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465045} {:answer-field/choices [{:answer/id #uuid "7398f9ee-d9ed-555a-acc0-735e4fdaa78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464224} {:answer/id #uuid "73635a76-1329-52e8-bd4c-7b079d5a02a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464225}] :answer-field/correct {:answer/id #uuid "7398f9ee-d9ed-555a-acc0-735e4fdaa78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464224} :answer-field/id #uuid "e5214e79-29e2-5009-b0e1-02450bcb5417" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465046} {:answer-field/choices [{:answer/id #uuid "9a9be739-fcf6-5a16-8afe-a003efb9a3a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464226} {:answer/id #uuid "786a548c-28ba-5e22-835f-02191b3b2922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464227}] :answer-field/correct {:answer/id #uuid "786a548c-28ba-5e22-835f-02191b3b2922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464227} :answer-field/id #uuid "53569532-51d7-56fd-b1b2-b9c1761560c6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465047}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2805dfb0-8d9a-5775-8051-a005b74b03a8" :question/math-academy-id "q-141584" :question/problem "Let $T:{R}^{6}\\to {R}^{6}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If ${v}_{1}\\ne {v}_{2}$ vectors such that $T({v}_{1})=T({v}_{2})$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)\\ne {0}$\n- **II.** $\\text{Im}(T)={R}^{6}$\n- **III.** $T$ is not a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne {0},$ the transformation $T$ and the matrix $T$ are not invertible. Since $T$ is not invertible, by the invertible matrix theorem, we must have that $\\text{Im}(T)\\ne {R}^{6}.$\n\n- Statement III is true. Since $\\text{Im}(T)\\ne {R}^{6},$ the invertible matrix theorem implies that the transformation $T$ is not a bijection.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186364213 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae1d25d6-8ed3-59df-911c-7d0cb3fdc8ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469044} {:answer/id #uuid "5ceb7842-8979-5416-aad4-760e628285f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469045}] :answer-field/correct {:answer/id #uuid "5ceb7842-8979-5416-aad4-760e628285f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469045} :answer-field/id #uuid "e42f00c6-6c84-5fb6-8df5-83a524e29e2c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470134} {:answer-field/choices [{:answer/id #uuid "21598207-e841-5f39-8f2a-4ec2cfbec0fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469046} {:answer/id #uuid "c901c73f-ddc2-5d19-aeaa-5345c49b20f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469047}] :answer-field/correct {:answer/id #uuid "21598207-e841-5f39-8f2a-4ec2cfbec0fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469046} :answer-field/id #uuid "e45cb722-742a-5576-a0d9-c95cfa6bdb62" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470135} {:answer-field/choices [{:answer/id #uuid "74ba564d-eeea-5879-b8d0-f329022e980d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469048} {:answer/id #uuid "2b4543b5-7c0b-5482-af32-ce6dac305545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469049}] :answer-field/correct {:answer/id #uuid "74ba564d-eeea-5879-b8d0-f329022e980d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469048} :answer-field/id #uuid "5c7852e2-0fb8-517d-a85f-e3a3e578317a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470136}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3c1b6231-ddc6-5ac3-a5c8-9d11b32158e5" :question/math-academy-id "q-47456" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T).$ Consider the following statement:\n\n*If ${v}_{1}-2{v}_{2}+{v}_{3}=0$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{nullity}(T)\\ne 0$\n- **II.** $\\text{rank}(T)=3$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since the columns of $T$ satisfies ${v}_{1}-2{v}_{2}+{v}_{3}=0$, then they are linearly dependent, which gives us $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Therefore, according to the Invertible Matrix Theorem, we must have $\\text{nullity}(T)\\ne 0.$\n\n- Statement II is false. Since $\\text{Im}(T)\\ne {R}^{3}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the transformation $T$ can't be a bijection.\n\nTherefore, the correct answer is \"I only.\""}]}
