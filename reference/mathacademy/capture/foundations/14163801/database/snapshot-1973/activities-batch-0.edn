-ad79-5dd3-b698-91a9f29f4e9d" :step/math-academy-id 37611 :step/next {:db/id #edb/ref 17592186125405}}] :activity/title "The Invertible Matrix Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124747}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186417707} :activity/id #uuid "a321f5ff-d1ce-5778-90d0-3e0d34ad246d" :activity/scope {:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962} :activity/steps [{:db/id #edb/ref 17592186417705 :step/content {:db/id #edb/ref 17592186417704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c07dae18-53b8-50d8-9953-c286f053f130" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473452} {:answer/id #uuid "f544fe4b-2071-53b8-8fd7-eb03478e4a89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473453}] :answer-field/correct {:db/id #edb/ref 17592186473452} :answer-field/id #uuid "2548af25-17a2-5afb-af86-44ee79ccc156" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474121} {:answer-field/choices [{:answer/id #uuid "0fea2177-f886-5ea3-bcfa-edb19fb1d593" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473454} {:answer/id #uuid "210dadc5-e8c8-5ceb-a5ce-5ab0c4ff06d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473455}] :answer-field/correct {:db/id #edb/ref 17592186473455} :answer-field/id #uuid "4e057aa0-f318-5406-860f-b5b16d8d2d93" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474122} {:answer-field/choices [{:answer/id #uuid "ff6fa49d-2a3b-50f4-b709-7cf191c1f26a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473456} {:answer/id #uuid "fc1113bc-9c71-5f2b-98a5-ba108659a934" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473457}] :answer-field/correct {:db/id #edb/ref 17592186473456} :answer-field/id #uuid "2f0c4b97-3dd5-51e1-96d0-6bc6a154c613" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474123}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c77aeb41-578d-533f-87d1-e33216f35c1e" :question/math-academy-id "q-84053" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T$ and ${u}_{1},{u}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If ${u}_{1}-{u}_{2}\\ne 0$ and $T({u}_{1})-T({u}_{2})=0,$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{rank}(T)\\ne 3$\n- **III.** $T$ is invertible\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T$ is a linear transformation and $T({u}_{1})-T({u}_{2})=0,$ we have $T({u}_{1}-{u}_{2})=0.$ So ${u}_{1}-{u}_{2}\\in \\text{Ker}(T)$ and ${u}_{1}-{u}_{2}\\ne 0.$ Therefore, we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Ker}(T)\\ne {0}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 3,$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "291db6d3-4728-529e-a9be-f15ca20db25d"} {:db/id #edb/ref 17592186417706 :step/content {:db/id #edb/ref 17592186125164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da97a065-c9ea-545d-9832-58ba5595c282" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460017} {:answer/id #uuid "44b485c0-4b9e-522d-95c5-7ceba53f1f39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460018}] :answer-field/correct {:db/id #edb/ref 17592186460017} :answer-field/id #uuid "efff0b18-702b-56a0-8bdf-765f60a773b3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460875} {:answer-field/choices [{:answer/id #uuid "74ec198b-aef3-59b6-b091-30d662e9f4cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460019} {:answer/id #uuid "a7f8d74d-cce4-5aab-b18a-c61877075bdb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460020}] :answer-field/correct {:db/id #edb/ref 17592186460020} :answer-field/id #uuid "9908404e-2262-51c4-b8db-2672114ba2d0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460876} {:answer-field/choices [{:answer/id #uuid "a0734130-7b87-5408-bf8e-b097433b8280" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460021} {:answer/id #uuid "b49d1b8e-67c2-5af5-8d46-21f059350ab6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460022}] :answer-field/correct {:db/id #edb/ref 17592186460021} :answer-field/id #uuid "6141e94f-e3cc-500f-ba91-1f18aa4e01ca" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460877}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a059dc0b-5296-5e25-93e6-3ffd38125f6c" :question/math-academy-id "q-47556" :question/problem "Let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $[1,-1]^{T}\\notin \\text{Im}(T)$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- **I.** $\\text{Ker}(T)=\\{0\\}$\n\n- **II.** $\\text{rank}(T)\\ne 2$\n\n- **III.** $T$ is invertible\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{2}$ into ${R}^{2},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{2} \\\\  & \\text{rank}(T)=2 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the vector $[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ does not lie in $\\text{Im}(T)$, then $\\text{Im}(T)\\ne {R}^{2}.$ Therefore, according to the invertible matrix theorem, we must have $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement II is true. Since $\\text{Im}(T)\\ne {R}^{2}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 2.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{2},$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "3efa04eb-3c5c-549f-ac5a-28d6ca38cb8b" :step/next {:db/id #edb/ref 17592186417705}} {:db/id #edb/ref 17592186417707 :step/content {:db/id #edb/ref 17592186417703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453892} {:answer/id #uuid "a3c74f36-a3a0-589c-a45b-af2f83dc7942" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453893}] :answer-field/correct {:db/id #edb/ref 17592186453892} :answer-field/id #uuid "88425be4-23e4-530d-894d-7ba2ee67cacc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454696} {:answer-field/choices [{:answer/id #uuid "42b1c9af-14b9-5566-a390-e0cfcfb93713" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453894} {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453895}] :answer-field/correct {:db/id #edb/ref 17592186453895} :answer-field/id #uuid "6eccd02e-cd48-5da5-a4d4-40a643e437ff" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454697} {:answer-field/choices [{:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453896} {:answer/id #uuid "998a225c-9aad-55b1-9522-e1b176e1886c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453897}] :answer-field/correct {:db/id #edb/ref 17592186453896} :answer-field/id #uuid "7b61e149-64e1-57db-98c8-d0a11bc647eb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454698}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution?\n\nSelect all that apply.\n\n- **I.** $T$ is invertible\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement II is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "8823976c-e582-552f-a786-db586ba8c928" :step/next {:db/id #edb/ref 17592186417706}}] :activity/title "The Invertible Matrix Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186417684}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186491234} :activity/id #uuid "b46dcd91-903b-5d2e-987d-47f39b7bd951" :activity/scope {:db/id #edb/ref 17592186049371 :topic/id #uuid "ef6bb570-cff7-5ef3-a4ba-79063f5d81ad" :topic/math-academy-id 1962} :activity/steps [{:db/id #edb/ref 17592186491234 :step/content {:db/id #edb/ref 17592186364213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae1d25d6-8ed3-59df-911c-7d0cb3fdc8ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469044} {:answer/id #uuid "5ceb7842-8979-5416-aad4-760e628285f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469045}] :answer-field/correct {:db/id #edb/ref 17592186469045} :answer-field/id #uuid "e42f00c6-6c84-5fb6-8df5-83a524e29e2c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470134} {:answer-field/choices [{:answer/id #uuid "21598207-e841-5f39-8f2a-4ec2cfbec0fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469046} {:answer/id #uuid "c901c73f-ddc2-5d19-aeaa-5345c49b20f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469047}] :answer-field/correct {:db/id #edb/ref 17592186469046} :answer-field/id #uuid "e45cb722-742a-5576-a0d9-c95cfa6bdb62" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470135} {:answer-field/choices [{:answer/id #uuid "74ba564d-eeea-5879-b8d0-f329022e980d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469048} {:answer/id #uuid "2b4543b5-7c0b-5482-af32-ce6dac305545" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469049}] :answer-field/correct {:db/id #edb/ref 17592186469048} :answer-field/id #uuid "5c7852e2-0fb8-517d-a85f-e3a3e578317a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470136}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3c1b6231-ddc6-5ac3-a5c8-9d11b32158e5" :question/math-academy-id "q-47456" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T).$ Consider the following statement:\n\n*If ${v}_{1}-2{v}_{2}+{v}_{3}=0$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{nullity}(T)\\ne 0$\n- **II.** $\\text{rank}(T)=3$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since the columns of $T$ satisfies ${v}_{1}-2{v}_{2}+{v}_{3}=0$, then they are linearly dependent, which gives us $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Therefore, according to the Invertible Matrix Theorem, we must have $\\text{nullity}(T)\\ne 0.$\n\n- Statement II is false. Since $\\text{Im}(T)\\ne {R}^{3}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the transformation $T$ can't be a bijection.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "492653ce-e0e3-57fb-97bc-5d7f36d893d1" :step/next {:db/id #edb/ref 17592186491251}} {:db/id #edb/ref 17592186491240 :step/content {:db/id #edb/ref 17592186272288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2f591c8-5dc6-5a9b-9834-d348ea0ba55c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449646} {:answer/id #uuid "d971d1ca-d302-5135-9b9b-8a59d4eedb5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449647}] :answer-field/correct {:db/id #edb/ref 17592186449647} :answer-field/id #uuid "901e996e-5f74-5811-9119-b09127f872b7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450777} {:answer-field/choices [{:answer/id #uuid "8fa48495-2a69-53c0-a6eb-907afb28c8eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449648} {:answer/id #uuid "0fd370f2-c3e7-59ac-9b60-dbdab11ac477" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449649}] :answer-field/correct {:db/id #edb/ref 17592186449649} :answer-field/id #uuid "8f7b6165-7688-5b31-b8de-bb5f0df45e64" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450778} {:answer-field/choices [{:answer/id #uuid "3e5738f6-983e-551f-b134-397efd15e8e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186449650} {:answer/id #uuid "444ee7a0-efba-54ea-bdd4-105d434eca39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186449651}] :answer-field/correct {:db/id #edb/ref 17592186449650} :answer-field/id #uuid "994914f2-286f-5b0f-b0ef-a7e7ba9ae1e9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186450779}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2fc1f275-1b92-5d39-91a9-c77fc478abd0" :question/math-academy-id "q-141461" :question/problem "Which of the following statements are true given that $T:{R}^{4}\\to {R}^{4}$ is a linear transformation whose standard matrix is $T,$ and $T$ is a bijection?\n\nSelect all that apply.\n\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{rank}(T)=4$\n- **III.** $T(v)=0$ for some $v\\ne 0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=4.$\n\n- Statement III is false. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0},$ which means there is no non-zero vector $v$ such that $T(v)=0.$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "604d3714-832d-51bd-9fb5-c20fe1903624" :step/next {:db/id #edb/ref 17592186491262}} {:db/id #edb/ref 17592186491251 :step/content {:db/id #edb/ref 17592186491133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cc0094-bac1-5f58-90e7-0542270cfe41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186490545} {:answer/id #uuid "26362897-13ad-56e5-b914-73711e4101e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186490579} {:answer/id #uuid "3a373190-4d45-5034-8914-6d455e9c0585" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186490618} {:answer/id #uuid "6c259be5-acf0-54dd-8223-55148358afdf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186490721} {:answer/id #uuid "ab8bcf39-4575-5bf9-89c4-0e0c13cd32a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186490852}] :answer-field/correct {:db/id #edb/ref 17592186490721} :answer-field/id #uuid "440926a7-d150-590e-8da5-b5a15d06d323" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491032}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "360fdc6a-8e68-5e59-be91-60b011ed6613" :question/math-academy-id "q-141459" :question/problem "Which of the following statements are true given that $T:{R}^{3}\\to {R}^{3}$ is a linear transformation whose standard matrix is $T,$ and $T(v)=0$ for some vector $v\\ne 0?$ \n\nI. $\\text{Ker}(T)\\ne \\{0\\}$\n\nII. $T$ is invertible\n\nIII. $\\text{Im}(T)={R}^{3}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $v\\in \\text{Ker}(T)$ and $v\\ne 0,$ we must have that $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne \\{0\\},$ the transformation $T$ is not a bijection and the matrix $T$ is not invertible.\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{Im}(T)\\ne {R}^{3}.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "8188ea3f-faad-5417-8dd7-ce49d3aa7e10" :step/next {:db/id #edb/ref 17592186491240}} {:db/id #edb/ref 17592186491262 :step/content {:db/id #edb/ref 17592186491115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4431191c-327a-560c-ae2e-0a936d7eb7b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186490640} {:answer/id #uuid "986f71ff-e7ec-55cd-9394-82b48c3bf3b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186490825} {:answer/id #uuid "aed3b03d-3ae1-5ed6-9414-6be7b69ae7c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186490857} {:answer/id #uuid "ce62f560-86ad-52eb-8dca-7d8fcdf559c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186490900} {:answer/id #uuid "dd2b2d92-434b-5242-adbe-1f59d584cccd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186490929}] :answer-field/correct {:db/id #edb/ref 17592186490900} :answer-field/id #uuid "e4dca603-a431-59c9-afde-0218f7a30964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491095}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0cc9c978-a013-5a19-912d-5fcfcd8af303" :question/math-academy-id "q-141487" :question/problem "Let $T:{R}^{7}\\to {R}^{7}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $T({v}_{1})=T({v}_{2})$ if and only if ${v}_{1}={v}_{2},$  then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\text{Ker}(T)\\ne \\{0\\}$\n\nII. $T$ is a bijection\n\nIII. $\\text{rank}(T)=7$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{7}$ into ${R}^{7},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{7} \\\\  & \\text{rank}(T)=7 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T({v}_{1})=T({v}_{2})$ if and only if ${v}_{1}={v}_{2},$ we must have that $\\text{Ker}(T)=\\{0\\}.$\n\n- Statement II is true. According to the invertible matrix theorem, since $\\text{Ker}(T)=\\{0\\},$ the transformation $T$ is a bijection.\n\n- Statement III is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=7.$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "b9c78f66-b08f-5798-8277-4bd48e8f9bee" :step/next {:db/id #edb/ref 17592186491273}} {:db/id #edb/ref 17592186491273 :step/content {:db/id #edb/ref 17592186272302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32d41688-d441-5144-8654-a972f8be5b21" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464222} {:answer/id #uuid "8e89bfdc-e0ea-5cb6-9225-4a56ce59f56c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464223}] :answer-field/correct {:db/id #edb/ref 17592186464223} :answer-field/id #uuid "72f72fce-9abb-5a6c-9689-b54025b14cfe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465045} {:answer-field/choices [{:answer/id #uuid "7398f9ee-d9ed-555a-acc0-735e4fdaa78b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464224} {:answer/id #uuid "73635a76-1329-52e8-bd4c-7b079d5a02a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464225}] :answer-field/correct {:db/id #edb/ref 17592186464224} :answer-field/id #uuid "e5214e79-29e2-5009-b0e1-02450bcb5417" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465046} {:answer-field/choices [{:answer/id #uuid "9a9be739-fcf6-5a16-8afe-a003efb9a3a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186464226} {:answer/id #uuid "786a548c-28ba-5e22-835f-02191b3b2922" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186464227}] :answer-field/correct {:db/id #edb/ref 17592186464227} :answer-field/id #uuid "53569532-51d7-56fd-b1b2-b9c1761560c6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186465047}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2805dfb0-8d9a-5775-8051-a005b74b03a8" :question/math-academy-id "q-141584" :question/problem "Let $T:{R}^{6}\\to {R}^{6}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If ${v}_{1}\\ne {v}_{2}$ vectors such that $T({v}_{1})=T({v}_{2})$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)\\ne {0}$\n- **II.** $\\text{Im}(T)={R}^{6}$\n- **III.** $T$ is not a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne {0},$ the transformation $T$ and the matrix $T$ are not invertible. Since $T$ is not invertible, by the invertible matrix theorem, we must have that $\\text{Im}(T)\\ne {R}^{6}.$\n\n- Statement III is true. Since $\\text{Im}(T)\\ne {R}^{6},$ the invertible matrix theorem implies that the transformation $T$ is not a bijection.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "e7bbe3c7-afd2-571d-8c8c-ff79627d78d1"}] :activity/title "The Invertible Matrix Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490508}]}
