-choiceLetterCircle-141461-b\" class=\"questionWidget-choiceLetterCircle\">b</div></td><td class=\"questionWidget-choiceText\">II and III only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-141461-c\" class=\"questionWidget-choiceLetterCircle\">c</div></td><td class=\"questionWidget-choiceText\">II only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-141461-d\" class=\"questionWidget-choiceLetterCircle\">d</div></td><td class=\"questionWidget-choiceText\">I, II, and III</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-141461-e\" class=\"questionWidget-choiceLetterCircle\">e</div></td><td class=\"questionWidget-choiceText\">I only</td></tr></tbody></table><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/correct-answer.svg\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>Since <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"49\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow></math></mjx-assistive-mml></mjx-container> is a linear transformation from <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"50\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c211D TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">R</mi></mrow><mn>4</mn></msup></math></mjx-assistive-mml></mjx-container> into <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"51\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c211D TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">R</mi></mrow><mn>4</mn></msup><mo>,</mo></math></mjx-assistive-mml></mjx-container> the invertible matrix theorem states the following:</p>\n<blockquote>\n<p> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"52\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow></math></mjx-assistive-mml></mjx-container> is a bijection (an invertible transformation) <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"53\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mspace style=\"width: 2em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c27FA\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 2em;\"></mjx-mspace></mjx-mstyle><mjx-mrow space=\"4\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-v class=\"mjx-c7B\" style=\"height: 5.042em; vertical-align: -2.271em;\"><mjx-beg><mjx-c></mjx-c></mjx-beg><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mid><mjx-c></mjx-c></mjx-mid><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-end><mjx-c></mjx-c></mjx-end><mjx-mark></mjx-mark></mjx-stretchy-v></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.278em;\"></mjx-mspace></mjx-mstyle><mjx-mtable style=\"min-width: 6.275em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.15em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.15em;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c49\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c211D TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.15em; padding-bottom: 0.15em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.15em; padding-bottom: 0.15em;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6B\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.15em; padding-bottom: 0.15em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.15em; padding-bottom: 0.15em;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c4B\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mn class=\"mjx-b\"><mjx-c class=\"mjx-c1D7CE TEX-B\"></mjx-c></mjx-mn></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7D\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.15em;\"><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.15em;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c75\"></mjx-c><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c79\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable><mjx-mo class=\"mjx-n\" style=\"vertical-align: 0.25em;\"></mjx-mo></mjx-mrow></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mo stretchy=\"false\">⟺</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"3pt\"><mtr><mtd></mtd><mtd><mtext>Im</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">R</mi></mrow><mn>4</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mtext>rank</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd></mtd><mtd><mtext>Ker</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">0</mn></mrow><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr><mtr><mtd></mtd><mtd><mtext>nullity</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow></math></mjx-assistive-mml></mjx-container> </p>\n</blockquote>\n<p>With that in mind, let's examine each statement in turn.</p>\n<ul>\n<li><p>Statement I is true. Since <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"54\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow></math></mjx-assistive-mml></mjx-container> is a bijection, the invertible matrix theorem implies that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"55\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c4B\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mn class=\"mjx-b\"><mjx-c class=\"mjx-c1D7CE TEX-B\"></mjx-c></mjx-mn></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>Ker</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">0</mn></mrow><mo fence=\"false\" stretchy=\"false\">}</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container> </p>\n</li>\n<li><p>Statement II is true. Since <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"56\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow></math></mjx-assistive-mml></mjx-container> is a bijection, the invertible matrix theorem implies that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"57\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6B\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>rank</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mn>4.</mn></math></mjx-assistive-mml></mjx-container> </p>\n</li>\n<li><p>Statement III is false. Since <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"58\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow></math></mjx-assistive-mml></mjx-container> is a bijection, the invertible matrix theorem implies that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"59\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c4B\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mn class=\"mjx-b\"><mjx-c class=\"mjx-c1D7CE TEX-B\"></mjx-c></mjx-mn></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>Ker</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">0</mn></mrow><mo fence=\"false\" stretchy=\"false\">}</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> which means there is no non-zero vector <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"60\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42F TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow></math></mjx-assistive-mml></mjx-container> such that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"61\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D413 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42F TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0.</mn></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n<p>Therefore, the correct answer is \"I and II only.\"</p>\n</div></div>",
