7] [17592186534498 #edb/ref 1083 #uuid "6f38908e-4bd6-5384-9925-30477dcb4253" #edb/ref 17592186045417] [17592186534644 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186534644 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186534644 #edb/ref 1083 #uuid "a9dc44c0-ba2d-5163-911a-1574cea8f06f" #edb/ref 17592186045417] [17592186534676 #edb/ref 1080 "I, II, and III" #edb/ref 17592186045417] [17592186534676 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186534676 #edb/ref 1083 #uuid "b7a3190f-7df3-50ea-a76a-7f1032b8c225" #edb/ref 17592186045417] [17592186534915 #edb/ref 1075 #edb/ref 17592186534390 #edb/ref 17592186045417] [17592186534915 #edb/ref 1075 #edb/ref 17592186534395 #edb/ref 17592186045417] [17592186534915 #edb/ref 1075 #edb/ref 17592186534498 #edb/ref 17592186045417] [17592186534915 #edb/ref 1075 #edb/ref 17592186534644 #edb/ref 17592186045417] [17592186534915 #edb/ref 1075 #edb/ref 17592186534676 #edb/ref 17592186045417] [17592186534915 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186534915 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186534915 #edb/ref 1078 #edb/ref 17592186534390 #edb/ref 17592186045417] [17592186534915 #edb/ref 1079 #uuid "986ff1d6-a817-5ff7-8aed-97a0eafbf95e" #edb/ref 17592186045417] [17592186535065 #edb/ref 1068 #edb/ref 17592186534915 #edb/ref 17592186045417] [17592186535065 #edb/ref 1069 "q-334744" #edb/ref 17592186045417] [17592186535065 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186535065 #edb/ref 1071 "Which of the following global truncation error expressions represent a fourth-order numerical method?\n\nI. $e(Δx)=4(Δx)^{4}+2(Δx)^{7}$\n\nII. $e(Δx)=11(Δx)^{4}+0.5(Δx)^{5}$\n\nIII. $e(Δx)=0.2Δx+6(Δx)^{4}$" #edb/ref 17592186045417] [17592186535065 #edb/ref 1072 #uuid "c354aefb-fffc-5ecc-8cac-e2625bd63b47" #edb/ref 17592186045417] [17592186535065 #edb/ref 1074 "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $e(Δx)=4(Δx)^{4}+2(Δx)^{7},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{4}.$\nSo, statement I corresponds to an order $4$ method.\n\n- For $e(Δx)=11(Δx)^{4}+0.5(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $11(Δx)^{4}.$\nSo, statement II corresponds to an order $4$ method.\n\n- For $e(Δx)=0.2Δx+6(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $0.2Δx.$\nSo, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I and II only\"." #edb/ref 17592186045417] [17592186535091 #edb/ref 1062 #uuid "003358a9-f2af-59ba-b62d-17d3096b53b8" #edb/ref 17592186045417] [17592186535091 #edb/ref 1063 #edb/ref 17592186482539 #edb/ref 17592186045417] [17592186535102 #edb/ref 1058 #edb/ref 17592186535111 #edb/ref 17592186045417] [17592186535102 #edb/ref 1062 #uuid "27637d35-ea70-516e-ae4d-2f2b9a81ce00" #edb/ref 17592186045417] [17592186535102 #edb/ref 1063 #edb/ref 17592186308665 #edb/ref 17592186045417] [17592186535111 #edb/ref 1058 #edb/ref 17592186535112 #edb/ref 17592186045417] [17592186535111 #edb/ref 1062 #uuid "77786643-b29c-5c9c-ac94-7ecbfe592858" #edb/ref 17592186045417] [17592186535111 #edb/ref 1063 #edb/ref 17592186535065 #edb/ref 17592186045417] [17592186535112 #edb/ref 1058 #edb/ref 17592186535091 #edb/ref 17592186045417] [17592186535112 #edb/ref 1062 #uuid "77da484d-f99e-564b-b4c3-19d24cde8a96" #edb/ref 17592186045417] [17592186535112 #edb/ref 1063 #edb/ref 17592186308687 #edb/ref 17592186045417] [17592186535126 #edb/ref 1058 #edb/ref 17592186535102 #edb/ref 17592186045417] [17592186535126 #edb/ref 1062 #uuid "c4ecef28-9728-5f9f-986f-392086d6b9d1" #edb/ref 17592186045417] [17592186535126 #edb/ref 1063 #edb/ref 17592186221986 #edb/ref 17592186045417]}
