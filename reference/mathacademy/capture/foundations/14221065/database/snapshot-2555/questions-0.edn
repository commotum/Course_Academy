#{[{:db/id #edb/ref 17592186221986 :knowledge-point/_questions [{:db/id #edb/ref 17592186221402 :knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d20c43b-aebe-57e6-9524-dcd0d1e5d276" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186305899} {:answer/id #uuid "4e918a44-c564-5fed-a0ad-e307dda2bb46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186305917} {:answer/id #uuid "6cb35312-b7af-5bdf-9c23-68c4c07a3a11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186306191} {:answer/id #uuid "ba45bf27-6034-5a2b-b224-609af04300e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306888} {:answer/id #uuid "f1834450-0072-5bfe-83d8-37d9f92b8791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186307368}] :answer-field/correct {:answer/id #uuid "ba45bf27-6034-5a2b-b224-609af04300e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306888} :answer-field/id #uuid "346676e0-48f8-5066-ac65-2d01b43c9ccf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307684}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07099fdd-1348-5e3a-a68e-3d7b94b8ddb9" :question/math-academy-id "q-333702" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.08,$ the observed local truncation error is $τ(0.08)=0.13.$\n\n- With step size $Δx=0.02,$ the observed local truncation error is $τ(0.02)=0.002.$\n\nEstimate the order of the numerical method." :question/requires-calculator true :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.08$ to $0.02.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.08}{0.02}=4.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={4}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.13$ to $0.002.$ So, it reduces by a factor of\n\n$$\n\\frac{0.13}{0.002}=65.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{4}^{p+1} & ≈65 \\\\ p+1 & ≈{log}_{4}⁡(65) \\\\ p+1 & ≈3.011… \\\\ p & ≈2.011….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $2.$"}] [{:db/id #edb/ref 17592186308665 :knowledge-point/_questions [{:db/id #edb/ref 17592186221402 :knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cb8cbf-2525-5aa2-adfe-cd481e3a035f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186305203} {:answer/id #uuid "21bfa1f7-f19d-56ce-b7f8-e855ea310574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305475} {:answer/id #uuid "2eabd2c9-c08e-5c90-8a9a-e97ba53e2e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186305595} {:answer/id #uuid "7458f81a-c783-575e-87db-c6a1d925d0af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186306256} {:answer/id #uuid "8c4785ce-99ec-52cb-ac88-d882b4bd6fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186306484}] :answer-field/correct {:answer/id #uuid "21bfa1f7-f19d-56ce-b7f8-e855ea310574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186305475} :answer-field/id #uuid "b8a56bc7-802d-5130-a340-47dd3d54165b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8e9fee6-366d-51d7-82a2-1629aefe0b96" :question/math-academy-id "q-334647" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.15,$ the observed local truncation error is $τ(0.15)=0.54.$\n\n- With step size $Δx=0.05,$ the observed local truncation error is $τ(0.05)=0.003.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.15$ to $0.05.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.15}{0.05}=3.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={3}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.54$ to $0.003.$ So, it reduces by a factor of\n\n$$\n\\frac{0.54}{0.003}=180.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{3}^{p+1} & ≈180 \\\\ p+1 & ≈{log}_{3}⁡(180) \\\\ p+1 & ≈4.726… \\\\ p & ≈3.726….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $4.$"}] [{:db/id #edb/ref 17592186308687 :knowledge-point/_questions [{:db/id #edb/ref 17592186221404 :knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d077e1b-69a5-5689-b7f2-27863f84eb6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01" :db/id #edb/ref 17592186305418}] :answer-field/correct {:answer/id #uuid "1d077e1b-69a5-5689-b7f2-27863f84eb6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01" :db/id #edb/ref 17592186305418} :answer-field/id #uuid "c9664d18-5c13-5c23-a303-4d40a0de2cc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308149}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d047c5c7-9757-5ee5-9e01-a79118905089" :question/math-academy-id "q-334796" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $2.$  Suppose that using step size $Δx=0.15$ produces a global truncation error (GTE) of $e(0.15)≈0.0225.$  If we instead use a step size $Δx=0.10,$ what GTE should we expect?\n\n$e(0.10)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.15$ to $0.10.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.15}{0.10}=1.5.\n$$\n\nNow, since the numerical method is of order $2,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{2}=(1.5)^{2}=2.25.\n$$\n\nTherefore, using a step size of $Δx=0.10,$ the expected GTE is\n\n$$\ne(0.10)≈\\frac{0.0225}{2.25}=0.01.\n$$"}] [{:db/id #edb/ref 17592186482539 :knowledge-point/_questions [{:db/id #edb/ref 17592186221404 :knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2414084d-978d-5852-9a75-b14f36d5dc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186481869}] :answer-field/correct {:answer/id #uuid "2414084d-978d-5852-9a75-b14f36d5dc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186481869} :answer-field/id #uuid "817219d2-4fac-5374-9c4a-6822ef9e7011" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b679574-cdae-5555-900f-72dfd634fac3" :question/math-academy-id "q-334797" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $3.$  Suppose that using step size $Δx=0.25$ produces a global truncation error (GTE) of $e(0.25)≈0.125.$  If we instead use a step size $Δx=0.10,$ what GTE should we expect?\n\n$e(0.10)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.25$ to $0.10.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.25}{0.10}=2.5.\n$$\n\nNow, since the numerical method is of order $3,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{3}=(2.5)^{3}=15.625.\n$$\n\nTherefore, using a step size of $Δx=0.10,$ the expected GTE is\n\n$$\ne(0.10)≈\\frac{0.125}{15.625}=0.008.\n$$\n\nSo,\n\n$$\ne(0.10)≈0.008.\n$$"}]}
