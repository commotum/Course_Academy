 17592186045498} :answer/value "{\\lambda }_{1}>0" :db/id #edb/ref 17592186445837} {:answer/id #uuid "f70ca550-c753-5da0-af3c-d6d815aa1079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{1}=0" :db/id #edb/ref 17592186445858} {:answer/id #uuid "f847bfb7-8a78-5e29-8c15-501d82768ca3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{1}<0" :db/id #edb/ref 17592186445859}] :answer-field/correct {:db/id #edb/ref 17592186445859} :answer-field/id #uuid "9e98a717-1020-58a1-98b6-af9af8b934fd" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186445867} {:answer-field/choices [{:answer/id #uuid "53c726e6-a3ba-50b4-95e0-5792dd7f4c3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "toward the origin" :db/id #edb/ref 17592186445838} {:answer/id #uuid "83514dc6-fda1-583f-9a2c-cfed43f1f88e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "away from the origin" :db/id #edb/ref 17592186445846}] :answer-field/correct {:db/id #edb/ref 17592186445838} :answer-field/id #uuid "bcbad54d-f867-5cb4-a3d1-b77df5e9596a" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186445868} {:answer-field/choices [{:answer/id #uuid "2b304673-dff6-52bc-8311-4a1fff9ecbd5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "the origin" :db/id #edb/ref 17592186445836} {:answer/id #uuid "7a0bda8e-ed27-5d9e-bbe1-a1b8939dd25e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinity" :db/id #edb/ref 17592186445843}] :answer-field/correct {:db/id #edb/ref 17592186445836} :answer-field/id #uuid "d8146d50-0408-5f7b-b1a2-f1e395142b72" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186445869} {:answer-field/choices [{:answer/id #uuid "1ae8b196-5ad9-5a3f-a6de-6fcd3c9f127c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{2}>0" :db/id #edb/ref 17592186445832} {:answer/id #uuid "8f80a572-c0b6-59e5-97bf-e2ef08669d1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{2}=0" :db/id #edb/ref 17592186445848} {:answer/id #uuid "be011e2d-c5c8-58c2-ad97-6e9186c1c734" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{2}<0" :db/id #edb/ref 17592186445852}] :answer-field/correct {:db/id #edb/ref 17592186445852} :answer-field/id #uuid "dd6456d4-ab5d-51e3-9fa0-c2d1cb06877f" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186445870} {:answer-field/choices [{:answer/id #uuid "6a3e4a1c-c6ba-518c-a073-ef3580a687e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{2}" :db/id #edb/ref 17592186445842} {:answer/id #uuid "b4f91994-a0ed-50cc-8db4-764ca1da532e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{1}" :db/id #edb/ref 17592186445849}] :answer-field/correct {:db/id #edb/ref 17592186445849} :answer-field/id #uuid "f2d0de9b-f4b3-5990-bc03-9e94612c7ac1" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186445871}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0b89fafc-c196-5520-9710-898a3b3a16af" :question/math-academy-id "q-333488" :question/problem "![](images/a2/a21b978aaab9569ae4dcae346116e51b5248fdf8f3cff461411a2140f70a6a4c.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two real, distinct eigenvalues is shown above. The eigenvalues of the system's matrix are ${\\lambda }_{1}$ and ${\\lambda }_{2},$ for which the corresponding eigenvectors are ${v}_{1}=[2,1]^{T}$ and ${v}_{2}=[-1,1]^{T},$ respectively. Select the correct options in the reasoning below.\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ has the equation\n\n$$\ny={{field-1}}.\n$$\n\nThe tangents along this line are pointing \n{{field-2}},\nmeaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$\nmust approach \n{{field-3}} \nas $t\\to \\infty .$ So, we must have \n{{field-4}}.\n\nThe line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ has the equation\n\n$$\ny={{field-5}}.\n$$\n\nThe tangents along this line are pointing \n{{field-6}},\nmeaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$\nmust approach \n{{field-7}} \nas $t\\to \\infty .$ So, we must have \n{{field-8}}.\n\nFinally, since the solutions become parallel to the straight-line solution containing the vector {{field-9}} as they move towards the origin, the eigenvalue that determines the long-term behavior (dominant eigenvalue) is \n{{field-10}}.\n\nTherefore,\n{{field-11}} \n$<0.$" :question/worked-solution "The straight-line solutions of the system have the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ has the equation\n\n$$\ny=\\frac{1}{2}x,\n$$\n\nas shown below.\n\n![](images/ab/abdb72ad4cd1bbde4e53c901b6b285904078f456a3fa52ab667bf1675d2d68dd.png)\n\nThe tangents along this line are pointing $\\text{toward the origin},$ meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$\nmust approach $\\text{the origin}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}<0.$\n\nThe line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ has the equation\n\n$$\ny=-x,\n$$\n\nas shown below.\n\n![](images/cf/cf3cb4b5756e5f382cd798d371e3d3e797f5ba0a146cdb8424ed1c62c051564b.png)\n\nThe tangents along this line are pointing $\\text{toward the origin},$ meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$\nmust approach $\\text{the origin}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}<0.$\n\nSo, for this particular system, both eigenvalues are negative. The eigenvalue that determines the long-term behavior (dominant eigenvalue) is the one closest to $0.$\n\nNow, since the solutions become parallel to the straight-line solution containing the vector ${v}_{1}$ as they move towards the origin, the eigenvalue that determines the long-term behavior is ${\\lambda }_{1}.$\n\nTherefore, ${\\lambda }_{2}<{\\lambda }_{1}<0.$"} :step/id #uuid "fbfc2c04-e3d2-560f-8831-93c9e7b92836"}] :activity/title "Phase Portraits for Linear Systems With Real Distinct Eigenvalues" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186445831}]}
