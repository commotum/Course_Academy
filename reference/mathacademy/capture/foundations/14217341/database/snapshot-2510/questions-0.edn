0a-e407-5a08-937d-75df54b7f163" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308269} {:answer-field/choices [{:answer/id #uuid "4e4606bd-bdbf-5a40-b2d1-eb4cb9a360e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}<0" :db/id #edb/ref 17592186305912} {:answer/id #uuid "7bdcb352-3ca3-5f67-bf30-1c5d5f6a4a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "away from the origin" :db/id #edb/ref 17592186306333} {:answer/id #uuid "c102c8f9-e034-516d-9783-e9c6e02c3273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}=0" :db/id #edb/ref 17592186306951} {:answer/id #uuid "f06d6940-61dc-55b5-a142-72ebda876a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}>0" :db/id #edb/ref 17592186307360}] :answer-field/correct {:answer/id #uuid "7bdcb352-3ca3-5f67-bf30-1c5d5f6a4a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "away from the origin" :db/id #edb/ref 17592186306333} :answer-field/id #uuid "f0c2c19c-3caf-5df3-a645-d91316296dff" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308283}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b5a36f6-c7fc-5f39-8a18-1389505413c3" :question/math-academy-id "q-333503" :question/problem "![](images/e5/e5c236defa66a00f12cd338ed0012cf91e4d7c15aa4865fc2b1edf5b0e2ea1da.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two real, distinct eigenvalues is shown above.\nThe eigenvalues of the system's matrix are ${\\lambda }_{1}$ and ${\\lambda }_{2},$ for which the corresponding eigenvectors are ${v}_{1}=[2,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }1]^{T},$ respectively. \nSelect the correct options in the reasoning below.The line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny={{field-1}}.\n$$\n\nThe tangents along this line are pointing \n{{field-2}},\nmeaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$\nmust approach \n{{field-3}} \nas $t\\to \\infty .$ So, we must have \n{{field-4}}.\n\nThe line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny={{field-5}}.\n$$\n\nThe tangents along this line are pointing \n{{field-6}},\nmeaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$\nmust approach \n{{field-7}} \nas $t\\to \\infty .$ So, we must have \n{{field-8}}.\n\nFinally, since the solutions become parallel to the straight-line solution containing the vector {{field-9}} as they move away from the origin, the dominant eigenvalue is \n{{field-10}}.\n\nTherefore,\n{{field-11}} \n$>0.$" :question/worked-solution "The straight-line solutions of the system have the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=\\frac{1}{2}x,\n$$\n\nas shown below.\n\n![](images/97/97f7eb1fbddcd9d927447978efd4c42e705d6835bf0cc74525d42ded8c35346b.png)\n\nThe tangents along this line are pointing $\\text{away from the origin},$ meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$\nmust approach $\\text{infinity}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}>0.$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=-x,\n$$\n\nas shown below.\n\n![](images/ed/edc697ab38ae9a56d46181e0a45982b7045224de0cc3c4a786ddbc515f22196c.png)\n\nThe tangents along this line are pointing $\\text{away from the origin},$ meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$\nmust approach $\\text{infinity}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}>0.$\n\nSo, for this particular system, both eigenvalues are positive. The dominant eigenvalue is the one with the greatest magnitude.\n\nNow, since the solutions become parallel to the straight-line solution containing the vector ${v}_{1}$ as they move away from the origin, the dominant eigenvalue is ${\\lambda }_{1}.$\n\nTherefore, ${\\lambda }_{1}>{\\lambda }_{2}>0.$"}] [{:db/id #edb/ref 17592186422155 :knowledge-point/_questions [{:db/id #edb/ref 17592186166918 :knowledge-point/id #uuid "35492718-d2d7-5c9d-9c02-1ef6ae0445d0" :knowledge-point/title "Classifying Systems of Linear Differential Equations With Distinct Real Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c7c5dd4-985b-5405-bb39-51253042d52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186422021} {:answer/id #uuid "7e7acc82-e6c4-5dec-befb-675ccec0903d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x" :db/id #edb/ref 17592186422072} {:answer/id #uuid "919301d7-68f2-5782-915a-8f4d378d4451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186422084} {:answer/id #uuid "cffa05d2-1031-5c3b-942d-069e218dd818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186422105}] :answer-field/correct {:answer/id #uuid "cffa05d2-1031-5c3b-942d-069e218dd818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186422105} :answer-field/id #uuid "17f61bfc-2b2f-5780-a0d3-c92c029fb198" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186422122} {:answer-field/choices [{:answer/id #uuid "14bc55e1-31d7-5798-9f51-9e810ae5b145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186422027} {:answer/id #uuid "b39d43c4-a1f9-54c2-8f94-0bfd592ebd10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186422093}] :answer-field/correct {:answer/id #uuid "b39d43c4-a1f9-54c2-8f94-0bfd592ebd10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186422093} :answer-field/id #uuid "2b80139d-bc1e-5645-8de4-30d2db8afdf1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186422127} {:answer-field/choices [{:answer/id #uuid "6a24f1ef-649e-5645-995e-2f802b1f4380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186422061} {:answer/id #uuid "c09b78a5-7042-5294-99d6-32a590ecb504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186422099}] :answer-field/correct {:answer/id #uuid "6a24f1ef-649e-5645-995e-2f802b1f4380" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186422061} :answer-field/id #uuid "4ad00cd6-77d9-5b4b-9995-246f45c8c4b3" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186422132} {:answer-field/choices [{:answer/id #uuid "116aa627-74f3-55db-9c3e-276499470af8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable node (sink)" :db/id #edb/ref 17592186422023} {:answer/id #uuid "2e978d2d-0d3b-58eb-a366-69213e6f3246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a saddle point" :db/id #edb/ref 17592186422034} {:answer/id #uuid "88101903-0398-5bd1-af51-4e947d7e70ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable node (source)" :db/id #edb/ref 17592186422077}] :answer-field/correct {:answer/id #uuid "2e978d2d-0d3b-58eb-a366-69213e6f3246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a saddle point" :db/id #edb/ref 17592186422034} :answer-field/id #uuid "80de76c1-383f-57a7-b028-3b3844fe8b00" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186422144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c8c49ce-183e-525d-b069-5b56d43e69f7" :question/math-academy-id "q-333625" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=x(t)+y(t) \\\\ {y}^{′}(t) &=3x(t)-y(t)\\end{aligned}\\right.\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-2,$ for which the corresponding eigenvectors are ${v}_{1}=[1,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }3]^{T},$ respectively. Select the correct options below regarding the given system.\n\n$\\,$\n{{field-1}} is {{field-2}} line.\n\n$\\,$\n$y=-3x$ is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}{e}^{2t}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+{c}_{2}{e}^{-2t}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{2t}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$\nlie on that line and approach infinity as $t\\to \\infty .$ So, $y=x$ is $\\text{an unstable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$ has the equation \n\n$$\ny=-3x.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{-t}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}$\nlie on that line and approach the origin as $t\\to \\infty .$ So, $y=-3x$ is $\\text{a stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a saddle point}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/f2/f20c6478af528b45ab2ea7dfded3e835c49a79178e11d7dd06bb13760874bbdb.png)"}] [{:db/id #edb/ref 17592186308481 :knowledge-point/_questions [{:db/id #edb/ref 17592186166918 :knowledge-point/id #uuid "35492718-d2d7-5c9d-9c02-1ef6ae0445d0" :knowledge-point/title "Classifying Systems of Linear Differential Equations With Distinct Real Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5edddb8d-f8be-588f-bd8b-edcd12fbaf71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186306065} {:answer/id #uuid "c8c4960d-a6f2-56aa-ac63-26b326dbeeb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "an unstable" :db/id #edb/ref 17592186307019} {:answer/id #uuid "c973fd6a-c086-5d79-be1f-0a6dd1ad4fa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186307026}] :answer-field/correct {:answer/id #uuid "c8c4960d-a6f2-56aa-ac63-26b326dbeeb6" :answer/type {:db/id #e