/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "infinity" :db/id #edb/ref 17592186422031} :answer-field/id #uuid "7fbadde8-a887-5982-a0c4-352802ef2291" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186422143}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16c55b82-84fe-59ee-bb9a-f6d748d9f231" :question/math-academy-id "q-333025" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=2x(t)+3y(t) \\\\ {y}^{′}(t) &=5y(t)\\end{aligned}\\right.\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=2,$ for which the corresponding eigenvectors are ${v}_{1}=[1,\\text{ }1]^{T}$ and ${v}_{2}=[1,\\text{ }0]^{T},$ respectively. Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}\\cdot {{field-1}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+{c}_{2}\\cdot {{field-2}}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{5t}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$\nlie on that line. \n\nSince ${e}^{5t}\\to $ \n{{field-4}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-5}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/2a/2ab8c69672acf64e93615960fdbb34445d4f81617cae16f90a8e4f30252607ba.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ has the equation \n\n$$\ny={{field-6}}\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on that line.\n\nSince ${e}^{2t}\\to $ \n{{field-7}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-8}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/d1/d1b7ffd22ad77fe94a994659fb7a091692b23bafb3012a705e964419fb71e8aa.png)\n\nFinally, since the dominant eigenvalue is \n{{field-9}},\nsolutions become parallel to the straight-line solution containing the vector\n{{field-10}} \nas they move away from the origin.\n\nThe phase portrait of our system looks as follows:\n\n![](images/7a/7a87773278ef8c921a9e7002a376bac1de99e969c2eb10e4a6f104a854094469.png)" :question/worked-solution "The general solution of the system is\n\n$$\n\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}={c}_{1}{e}^{5t}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+{c}_{2}{e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ has the equation \n\n$$\ny=x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{5t}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$\nlie on that line. \n\nSince ${e}^{5t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach $\\text{infinity}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/2a/2ab8c69672acf64e93615960fdbb34445d4f81617cae16f90a8e4f30252607ba.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ has the equation \n\n$$\ny=0\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{2t}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nlie on that line. \n\nSince ${e}^{2t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach $\\text{infinity}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/d1/d1b7ffd22ad77fe94a994659fb7a091692b23bafb3012a705e964419fb71e8aa.png)\n\nFor this particular system, we have\n\n$$\n0<{\\lambda }_{2}<{\\lambda }_{1}\n$$\n\nthus, ${\\lambda }_{1}=5$ is the dominant eigenvalue.\n\nSince the dominant eigenvalue is ${\\lambda }_{1}=5,$ solutions become parallel to the straight-line solution containing the vector ${v}_{1}$ as they move away from the origin.\n\nThe phase portrait of our system looks as follows:\n\n![](images/7a/7a87773278ef8c921a9e7002a376bac1de99e969c2eb10e4a6f104a854094469.png)"}] [{:db/id #edb/ref 17592186530436 :knowledge-point/_questions [{:db/id #edb/ref 17592186166917 :knowledge-point/id #uuid "13af6d27-628d-5bdb-b396-299d9cfd64e7" :knowledge-point/title "Identifying the Parameters of a System Given Its Phase Portrait"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ba0ee72-f98e-5452-b0ab-851fc7dee945" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}=0" :db/id #edb/ref 17592186529635} {:answer/id #uuid "64868afb-1001-5a9d-99c2-2b2230a9edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}<0" :db/id #edb/ref 17592186529828} {:answer/id #uuid "ecb01b62-5037-5dd9-a766-4716610f0f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}>0" :db/id #edb/ref 17592186530173}] :answer-field/correct {:answer/id #uuid "64868afb-1001-5a9d-99c2-2b2230a9edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }_{1}<0" :db/id #edb/ref 17592186529828} :answer-field/id #uuid "05e61a3b-bbaf-5bab-b901-9321031c732c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186530219} {:answer-field/choices [{:answer/id #uuid "47a4601c-9108-57e2-9ba0-39e7fea9913b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186529748} {:answer/id #uuid "521cc0d6-9128-5cdb-8865-fa00b45f6b36" :answer/type {:db/id #edb/ref 175921860454