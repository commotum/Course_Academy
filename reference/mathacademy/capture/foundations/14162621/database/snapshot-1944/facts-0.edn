b/ref 1080 "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡(3x)-1)+C" #edb/ref 17592186045417] [17592186258851 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186258851 #edb/ref 1083 #uuid "eec4b01f-b497-53f1-8b34-4b8b2d67f6ec" #edb/ref 17592186045417] [17592186259215 #edb/ref 1075 #edb/ref 17592186257411 #edb/ref 17592186045417] [17592186259215 #edb/ref 1075 #edb/ref 17592186257525 #edb/ref 17592186045417] [17592186259215 #edb/ref 1075 #edb/ref 17592186258336 #edb/ref 17592186045417] [17592186259215 #edb/ref 1075 #edb/ref 17592186258785 #edb/ref 17592186045417] [17592186259215 #edb/ref 1075 #edb/ref 17592186258851 #edb/ref 17592186045417] [17592186259215 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259215 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259215 #edb/ref 1078 #edb/ref 17592186258851 #edb/ref 17592186045417] [17592186259215 #edb/ref 1079 #uuid "6b1e6c3d-3d86-5dab-9cbb-0d0320668747" #edb/ref 17592186045417] [17592186259419 #edb/ref 1075 #edb/ref 17592186257544 #edb/ref 17592186045417] [17592186259419 #edb/ref 1075 #edb/ref 17592186257557 #edb/ref 17592186045417] [17592186259419 #edb/ref 1075 #edb/ref 17592186257676 #edb/ref 17592186045417] [17592186259419 #edb/ref 1075 #edb/ref 17592186258192 #edb/ref 17592186045417] [17592186259419 #edb/ref 1075 #edb/ref 17592186258446 #edb/ref 17592186045417] [17592186259419 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259419 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259419 #edb/ref 1078 #edb/ref 17592186258446 #edb/ref 17592186045417] [17592186259419 #edb/ref 1079 #uuid "dbae28f0-aedd-5317-b5f3-02a112b05036" #edb/ref 17592186045417] [17592186259841 #edb/ref 1068 #edb/ref 17592186259419 #edb/ref 17592186045417] [17592186259841 #edb/ref 1069 "q-12566" #edb/ref 17592186045417] [17592186259841 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259841 #edb/ref 1071 "Calculate $\\int {x}^{2}{log}_{2}⁡(x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186259841 #edb/ref 1072 #uuid "6d30efc2-05d5-57a7-a888-f5dbfc3f16de" #edb/ref 17592186045417] [17592186259841 #edb/ref 1074 "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}={x}^{2}\\, & ⟹\\,v=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}{log}_{2}⁡(x)\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =({log}_{2}⁡(x))(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡(x)}{3}-\\frac{1}{3\\operatorname{ln}⁡2}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3\\operatorname{ln}⁡2}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}(3\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$" #edb/ref 17592186045417] [17592186319717 #edb/ref 1080 "\\frac{4}{49}(13{e}^{14}+1)" #edb/ref 17592186045417] [17592186319717 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319717 #edb/ref 1083 #uuid "6a2dedfa-ce0e-5837-9aa6-948ae0fbefbb" #edb/ref 17592186045417] [17592186320111 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186320111 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186320111 #edb/ref 1083 #uuid "f00d9a8d-19f9-59ab-a52c-04f26061eaeb" #edb/ref 17592186045417] [17592186320540 #edb/ref 1075 #edb/ref 17592186319717 #edb/ref 17592186045417] [17592186320540 #edb/ref 1075 #edb/ref 17592186486807 #edb/ref 17592186045417] [17592186320540 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320540 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320540 #edb/ref 1078 #edb/ref 17592186486807 #edb/ref 17592186045417] [17592186320540 #edb/ref 1079 #uuid "b91ebf90-9329-5211-901e-f7e1002ebff9" #edb/ref 17592186045417] [17592186320675 #edb/ref 1075 #edb/ref 17592186320111 #edb/ref 17592186045417] [17592186320675 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320675 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320675 #edb/ref 1078 #edb/ref 17592186320111 #edb/ref 17592186045417] [17592186320675 #edb/ref 1079 #uuid "f261cb5e-8b25-581f-a45f-89fb8e53daa1" #edb/ref 17592186045417] [17592186320762 #edb/ref 1068 #edb/ref 17592186320540 #edb/ref 17592186045417] [17592186320762 #edb/ref 1069 "q-350965" #edb/ref 17592186045417] [17592186320762 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320762 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}4{x}^{6}\\operatorname{ln}⁡x\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320762 #edb/ref 1072 #uuid "e85cfc96-f5dd-5d18-a1c7-6c52affb5618" #edb/ref 17592186045417] [17592186320762 #edb/ref 1074 "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=4{x}^{6} & \\,⟹\\,v=\\int 4{x}^{6}\\,dx=\\frac{4{x}^{7}}{7}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}4{x}^{6}\\operatorname{ln}⁡(x)\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{4{x}^{7}}{7}){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}(\\frac{4{x}^{7}}{7})(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\frac{4({e}^{2})^{7}\\operatorname{ln}⁡({e}^{2})}{7}-\\frac{4(1)^{7}\\operatorname{ln}⁡(1)}{7}]-\\frac{4}{7}{\\int }_{1}^{{e}^{2}}{x}^{6}\\,\\text{d}x \\\\  & =\\frac{4{e}^{14}\\operatorname{ln}⁡({e}^{2})}{7}-\\frac{4{x}^{7}}{49}{|}_{1}^{{e}^{2}} \\\\  & =\\frac{8{e}^{14}}{7}-(\\frac{4{e}^{14}}{49}-\\frac{4}{49}) \\\\  & =\\frac{1}{49}(56{e}^{14}-4{e}^{14}+4) \\\\  & =\\frac{4}{49}(13{e}^{14}+1).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186320763 #edb/ref 1068 #edb/ref 17592186320675 #edb/ref 17592186045417] [17592186320763 #edb/ref 1069 "q-350967" #edb/ref 17592186045417] [17592186320763 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320763 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320763 #edb/ref 1072 #uuid "d4539aae-02db-5cfd-beb0-0a96bbadcc38" #edb/ref 17592186045417] [17592186320763 #edb/ref 1074 "First, we write the integral as\n\n$$\n{\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x={\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x & ={\\int }_{1/2}^{e/2}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1/2}^{e/2}-{\\int }_{1/2}^{e/2}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(2x)\\,(x){|}_{1/2}^{e/2}-{\\int }_{1/2}^{e/2}x(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡(2\\cdot \\frac{e}{2})\\,(\\frac{e}{2})-\\operatorname{ln}⁡(2\\cdot \\frac{1}{2})\\,(\\frac{1}{2})]-{\\int }_{1/2}^{e/2}\\text{d}x \\\\  & =\\frac{e}{2}\\operatorname{ln}⁡(e)-\\frac{1}{2}\\operatorname{ln}⁡(1)-x{|}_{1/2}^{e/2} \\\\  & =\\frac{1}{2}e-\\frac{1}{2}e+\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186345794 #edb/ref 1080 "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186345794 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345794 #edb/ref 1083 #uuid "32f9a77b-5187-5f1e-91ab-58857644655e" #edb/ref 17592186045417] [17592186346306 #edb/ref 1080 "\\frac{3{x}^{3}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡(2x)-1)+C" #edb/ref 17592186045417] [17592186346306 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346306 #edb/ref 1083 #uuid "6d858571-c742-53a0-8b0c-77739cb65295" #edb/ref 17592186045417] [17592186346472 #edb/ref 1080 "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186346472 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346472 #edb/ref 1083 #uuid "7ff153a9-ddfd-5137-be96-19b18d9528c2" #edb/ref 17592186045417] [17592186346603 #edb/ref 1080 "\\frac{9{x}^{3}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡(2x)-1)+C" #edb/ref 17592186045417] [17592186346603 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346603 #edb/ref 1083 #uuid "8feedb2c-04a2-53e5-977e-8f184d2cf677" #edb/ref 17592186045417] [17592186346932 #edb/ref 1080 "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186346932 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346932 #edb/ref 1083 #uuid "b5bb072c-6dc8-522d-8e1e-52a3e26e7e2a" #edb/ref 17592186045417] [17592186347130 #edb/ref 1080 "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C" #edb/ref 17592186045417] [17592186347130 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347130 #edb/ref 1083 #uuid "cb6a35da-5e50-5868-9ffe-c00ba27afa4c" #edb/ref 17592186045417] [17592186347136 #edb/ref 1080 "\\frac{{x}^{3}}{\\operatorname{ln}⁡3}(3\\operatorname{ln}⁡(2x)-1)+C" #edb/ref 17