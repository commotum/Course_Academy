">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><msup><mi>e</mi><mn>2</mn></msup></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><msup><mi>e</mi><mn>6</mn></msup></mrow><mn>3</mn></mfrac></mstyle><mo>−</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><msup><mi>e</mi><mn>6</mn></msup></mrow><mn>9</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mn>9</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>9</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>12</mn><msup><mi>e</mi><mn>6</mn></msup><mo>−</mo><mn>2</mn><msup><mi>e</mi><mn>6</mn></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mn>9</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>5</mn><msup><mi>e</mi><mn>6</mn></msup><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
