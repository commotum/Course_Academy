#{[{:db/id #edb/ref 17592186265872 :knowledge-point/_questions [{:db/id #edb/ref 17592186124459 :knowledge-point/id #uuid "ff351d3f-449b-5c41-8f72-d1917b2b7536" :knowledge-point/title "Finding the Direction of Maximum Increase or Maximum Decrease of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371188b1-b7ec-57b7-b295-164f4505e38f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-2\\,j" :db/id #edb/ref 17592186263494} {:answer/id #uuid "468d5107-6a48-54fc-a274-623f490c7ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+j" :db/id #edb/ref 17592186263617} {:answer/id #uuid "5224940d-41f5-5791-9620-631ff60b6036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,i+10\\,j" :db/id #edb/ref 17592186263707} {:answer/id #uuid "5a9a260e-6d34-52c4-a50b-774f0edf8d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,i+j" :db/id #edb/ref 17592186263781} {:answer/id #uuid "c1f338bb-07ad-5dd5-a554-45630ad32b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,i-5\\,j" :db/id #edb/ref 17592186264684}] :answer-field/correct {:answer/id #uuid "5224940d-41f5-5791-9620-631ff60b6036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,i+10\\,j" :db/id #edb/ref 17592186263707} :answer-field/id #uuid "82b1bccb-f245-5952-bbe0-74fd47a6963c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "234c72df-7b34-5698-b613-f1acebf8fd8e" :question/math-academy-id "q-130276" :question/problem "In what direction does the function $f(x,y)={x}^{2}+3xy+2{y}^{2}$ increase most rapidly at the point $(2,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(2,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+3xy+2{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+3xy+2{y}^{2})\\,j \\\\  & =(2x+3y)\\,i+(3x+4y)\\,j \\\\ ∇f(2,1) & =(2(2)+3(1))\\,i+(3(2)+4(1))\\,j \\\\  & =7\\,i+10\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $7\\,i+10\\,j.$"}] [{:db/id #edb/ref 17592186504655 :knowledge-point/_questions [{:db/id #edb/ref 17592186124459 :knowledge-point/id #uuid "ff351d3f-449b-5c41-8f72-d1917b2b7536" :knowledge-point/title "Finding the Direction of Maximum Increase or Maximum Decrease of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4055cd-dc46-58cf-9414-ebd3aeced26d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i-\\sqrt{\\pi }\\,j" :db/id #edb/ref 17592186504052} {:answer/id #uuid "169a9454-865f-5c99-afad-24018fd51b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,i-j" :db/id #edb/ref 17592186504072} {:answer/id #uuid "24013cd6-fd21-5ea4-a444-92864f2d2b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi \\,j" :db/id #edb/ref 17592186504094} {:answer/id #uuid "24c7ddcb-f4c6-55ee-80f6-45bc59cf1057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{\\pi }\\,i+2\\,j" :db/id #edb/ref 17592186504096} {:answer/id #uuid "2fefcbb7-1707-5b33-9ea0-368b42c461ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,i" :db/id #edb/ref 17592186504115}] :answer-field/correct {:answer/id #uuid "24c7ddcb-f4c6-55ee-80f6-45bc59cf1057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{\\pi }\\,i+2\\,j" :db/id #edb/ref 17592186504096} :answer-field/id #uuid "ba947109-a6e8-5648-9e45-f1bf117b385d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504568}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93366598-9424-5753-a6aa-f85435a0ef2f" :question/math-academy-id "q-130279" :question/problem "In what direction does the function $f(x,y)={e}^{2y}\\operatorname{tan}⁡({x}^{2})$ increase most rapidly at the point $(\\frac{\\sqrt{\\pi }}{2},0)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,i+\\frac{∂}{∂y}({e}^{2y}\\operatorname{tan}⁡({x}^{2}))\\,j \\\\  & =2x{e}^{2y}{sec}^{2}⁡({x}^{2})\\,i+2{e}^{2y}\\operatorname{tan}⁡({x}^{2})\\,j \\\\ ∇f(\\frac{\\sqrt{\\pi }}{2},0) & =2(\\frac{\\sqrt{\\pi }}{2}){e}^{0}{sec}^{2}⁡(\\frac{\\pi }{4})\\,i+2{e}^{0}\\operatorname{tan}⁡(\\frac{\\pi }{4})\\,j \\\\  & =2\\sqrt{\\pi }\\,i+2\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $2\\sqrt{\\pi }\\,i+2\\,j.$"}] [{:db/id #edb/ref 17592186265978 :knowledge-point/_questions [{:db/id #edb/ref 17592186124460 :knowledge-point/id #uuid "c330648f-69ad-5778-98cb-bd48a0b160dd" :knowledge-point/title "Finding the Rate of Change of a Function in a Given Direction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5cc75b-1aa1-5b30-9362-5f8752961da4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186263250} {:answer/id #uuid "1d98f894-779c-5822-84b3-85b9a53ad6b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263271} {:answer/id #uuid "4efb98a8-8a82-5879-9aee-9a09d6afe439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263687} {:answer/id #uuid "bcb30fc7-6c64-5f56-9344-f70ad5eab684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264636} {:answer/id #uuid "e5a55fec-f5cc-59e3-8bae-75fcaf8ea6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265001}] :answer-field/correct {:answer/id #uuid "e5a55fec-f5cc-59e3-8bae-75fcaf8ea6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265001} :answer-field/id #uuid "f0ef6581-d8af-5b79-a84d-4f8dc281dbef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265678}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "129e769a-9e81-5bb8-a357-71dd7d678811" :question/math-academy-id "q-130801" :question/problem "Consider the function $g(x,y)=\\frac{x}{y}+\\frac{y}{x}.$ What is the rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of the vector $v=⟨1,-\\sqrt{2}⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(-1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+(-\\sqrt{2})^{2}}=\\sqrt{3} \\\\ u & =\\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{x}{y}+\\frac{y}{x}),\\,\\frac{∂}{∂y}(\\frac{x}{y}+\\frac{y}{x})⟩ \\\\  & =⟨\\frac{1}{y}-\\frac{y}{{x}^{2}},\\,\\frac{1}{x}-\\frac{x}{{y}^{2}}⟩ \\\\ ∇g(-1,1) & =⟨\\frac{1}{1}-\\frac{1}{(-1)^{2}},\\frac{1}{(-1)}-\\frac{(-1)}{{1}^{2}}⟩ \\\\  & =⟨0,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(-1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(-1,1) & =∇g(-1,1)\\cdot u \\\\  & =⟨0,0⟩\\cdot \\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩ \\\\  & =\\frac{0(1)+0(-\\sqrt{2})}{\\sqrt{3}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323791 :knowledge-point/_questions [{:db/id #edb/ref 17592186124460 :knowledge-point/id #uuid "c330648f-69ad-5778-98cb-bd48a0b160dd" :knowledge-point/title "Finding the Rate of Change of a Function in a Given Direction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f931965-4230-53c9-9c4e-51f593f9d015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186321267} {:answer/id #uuid "57f67efd-2b45-5e67-a5e4-4b0fd709ba1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{8}" :db/id #edb/ref 17592186321837} {:answer/id #uuid "7b1a8d46-fbc3-5f92-8b69-6709f7023c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{80}" :db/id #edb/ref 17592186322114} {:answer/id #uuid "cda4641b-3880-5a2f-a60a-2d4b84c1090a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186322750} {:answer/id #uuid "d4216551-4828-50f1-870a-15d1ba740ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{82}" :db/id #edb/ref 17592186322802}] :answer-field/correct {:answer/id #uuid "d4216551-4828-50f1-870a-15d1ba740ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{82}" :db/id #edb/ref 17592186322802} :answer-field/id #uuid "9e6c5b32-a96f-564b-b174-aa4099e65f9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323476}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a13cba05-5f4a-5d75-8f65-f72eb54e0d73" :question/math-academy-id "q-36300" :question/problem "Consider the function $f(x,y)=2xy+{e}^{3x-y}.$ What is the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction in which the function decreases most rapidly?" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(1,3):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}(2xy+{e}^{3x-y})\\text{ }i-\\frac{∂}{∂y}(2xy+{e}^{3x-y})\\text{ }j \\\\  & =-(2y+3{e}^{3x-y})\\text{ }i-(2x-{e}^{3x-y})\\text{ }j \\\\ -∇\\,f(1,3) & =-(2\\cdot 3+3\\cdot {e}^{3\\cdot 1-3})\\text{ }i-(2\\cdot 1-{e}^{3\\cdot 1-3})\\text{ }j \\\\  & =-9\\text{ }i-\\text{ }j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction of $-∇f(1,3)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(1,3)‖ & =‖-9\\text{ }i-\\text{ }j‖ \\\\  & =\\sqrt{(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{82}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124965 :knowledge-point/_questions [{:db/id #edb/ref 17592186124459 :knowledge-point/id #uuid "ff351d3f-449b-5c41-8f72-d1917b2b7536" :knowledge-point/title "Finding the Direction of Maximum Increase or Maximum Decrease of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ff85bb-8ce2-5025-a0a1-83fc98417ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2\\pi ,-2,-\\pi ⟩" :db/id #edb/ref 17592186321217} {:answer/id #uuid "636513d9-9ad2-5bbe-b8b3-cd67a4bf8d3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,2,1⟩" :db/id #edb/ref 17592186321920} {:answer/id #uuid "9f98fa5a-9408-52f3-8b7e-8f25e3ab2ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\pi ,-1,\\pi ⟩" :db/id #edb/ref 17592186322407} {:answer/id #uuid "c672059e-d68f-556c-9a70-117d11270e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322686} {:answer/id #uuid "cdeb1fca-19f0-5446-8266-9a4f0c5b2778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322752}] :answer-field/correct {:answer/id #uuid "cdeb1fca-19f0-5446-8266-9a4f0c5b2778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322752} :answer-field/id #uuid "cd3b7500-df79-56f9-843a-ede4ff70a4be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9a412c3a-6b92-5f8b-8cf9-ec76f9ca97fa" :question/math-academy-id "q-36305" :question/problem "In what direction does the function $g(x,y,z)={y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)$ increase most rapidly at the point $(1,1,2)?$" :question/worked-solution "At a given point, a function $g(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇g(x,y,z)$ and evaluate it at the point $(1,1,2):$\n\n$$\n\\begin{aligned}∇g(x,y,z) & =⟨\\frac{∂}{∂x}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)),\\,\\frac{∂}{∂y}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)),\\,\\frac{∂}{∂z}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z))⟩ \\\\  & =⟨2\\pi \\operatorname{cos}⁡(2\\pi x+\\pi z),\\,2y,\\,\\pi \\operatorname{cos}⁡(2\\pi x+\\pi z)⟩ \\\\ ∇g(1,1,2) & =⟨2\\pi \\operatorname{cos}⁡(2\\pi \\cdot 1+\\pi \\cdot 2),\\,2\\cdot 1,\\,\\pi \\operatorname{cos}⁡(2\\pi \\cdot 1+\\pi \\cdot 2)⟩ \\\\  & =⟨2\\pi \\operatorname{cos}⁡(4\\pi ),\\,2,\\,\\pi \\operatorname{cos}⁡(4\\pi )⟩ \\\\  & =⟨2\\pi ,\\,2,\\,\\pi ⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨2\\pi ,\\,2,\\,\\pi ⟩.$"}]}
