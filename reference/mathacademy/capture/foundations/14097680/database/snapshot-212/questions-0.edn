#{[{:db/id #edb/ref 17592186192478 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192759 :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839" :question/problem "Compute $P\\left( 1 \\lt   X \\lt 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/39/394c60a510e39043cda5072c0b57a663b200275035d72c15f20c5a257e6c4fc0.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\lt   X \\lt      b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{18}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{\\int }_{1}^{3}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{[\\frac{1}{3}{x}^{3}-x]}_{1}^{3} \\\\  & =\\frac{1}{18}([\\frac{1}{3}(3)^{3}-(3)]-[\\frac{1}{3}(1)^{3}-(1)]) \\\\  & =\\frac{1}{18}([9-3]-[\\frac{1}{3}-1]) \\\\  & =\\frac{1}{18}(6+\\frac{2}{3}) \\\\  & =\\frac{1}{18}\\cdot \\frac{20}{3} \\\\  & =\\frac{10}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192518 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192794 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036" :question/problem "Compute $P\\left(  X \\leq 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/1c/1cd6271fdb46d54db66d2b4f5acd10146f42a0dd64a3326ea7e53e07d4915633.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq X \\leq  b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSince $f(x)$ is identical to zero for all $x \\lt  2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{2x}{45}\\,\\text{d}x \\\\  & ={[\\frac{1}{45}\\,{x}^{2}]}_{2}^{3} \\\\  & =\\frac{1}{45}({3}^{2}-{2}^{2}) \\\\  & =\\frac{1}{45}\\cdot 5 \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192519 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038" :question/problem "Compute $P\\left( 2 \\leq          X \\leq          4 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/e0/e01b36a6a2b00b47ce36b59d5b3e1a4fea4cbc26b0b7d46d60e40638161982d8.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq        X \\leq        b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2\\le X\\le 4) & ={\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{9}x\\,\\text{d}x+{\\int }_{3}^{4}(x-3)\\,\\text{d}x \\\\  & ={[\\frac{1}{18}{x}^{2}]}_{2}^{3}+{[\\frac{1}{2}{x}^{2}-3x]}_{3}^{4} \\\\  & =\\frac{1}{18}[{3}^{2}-{2}^{2}]+([\\frac{1}{2}(4)^{2}-3(4)]-[\\frac{1}{2}(3)^{2}-3(3)]) \\\\  & =\\frac{5}{18}-4+\\frac{9}{2} \\\\  & =\\frac{14}{18} \\\\  & =\\frac{7}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278191 :knowledge-point/_questions [{:db/id #edb/ref 17592186192795 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37a48388-2bab-577e-b3fc-ef5d85354f71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186275977} {:answer/id #uuid "52335667-e9ab-5c39-a40f-ac908fefa494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186276216} {:answer/id #uuid "a514a2ee-a5b5-58f7-99f4-e1aefb256c68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186276973} {:answer/id #uuid "ba3431c2-fdec-5030-bef8-76e4881f3f81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186277135} {:answer/id #uuid "c531fdd1-513c-5a30-9e26-04dd5456d859" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186277237}] :answer-field/correct {:answer/id #uuid "37a48388-2bab-577e-b3fc-ef5d85354f71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186275977} :answer-field/id #uuid "a5b0873d-3a7a-5181-858a-c7d1ba8a1bad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a416229-b58d-58b1-a133-9fc7c0c01068" :question/math-academy-id "q-158436" :question/problem "Compute $P(0\\le X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{5}x(x+1),\\, & 0\\le x<1, \\\\ \\frac{1}{6}x & 1\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0\\le X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}x(x+1)\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{6}x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}({x}^{2}+x)\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{6}x\\,\\text{d}x \\\\  & =\\frac{2}{5}{[\\frac{1}{3}{x}^{3}+\\frac{1}{2}{x}^{2}]}_{0}^{1}+{[\\frac{1}{12}{x}^{2}]}_{1}^{2} \\\\  & =\\frac{2}{5}([\\frac{1}{3}(1)^{3}+\\frac{1}{2}(1)^{2}]-[\\frac{1}{3}(0)^{3}+\\frac{1}{2}(0)^{2}])+\\frac{1}{12}[{2}^{2}-{1}^{2}] \\\\  & =\\frac{2}{5}(\\frac{5}{6})+\\frac{1}{4} \\\\  & =\\frac{1}{3}+\\frac{1}{4} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}]}
