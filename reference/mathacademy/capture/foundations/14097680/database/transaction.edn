[{:db/id 17592186192759 :knowledge-point/questions ["question-70b7a02c-90a1-5f9d-b1b7-a374071b4308" "question-77d8a3b9-ab3f-5af1-ac16-cd6ceeb35611"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192478 :question/problem "Compute $P\\left( 1 \\lt   X \\lt 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/70/7059e7c4cb42e405342d34cd53ee7852f8abfffff2c3f54a95df30cdd44ef3c8.svg)" :db/ensure [:question/validate]} {:db/id 17592186192794 :knowledge-point/questions ["question-71e34130-ba0f-56bf-99cf-bcd67e888e34" "question-c5e575cf-c390-5240-8f9f-2e2ff4fb107f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192518 :question/problem "Compute $P\\left(  X \\leq 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/b0/b083c72bc5c3bb6ea1a4f5036a57e5671c884d585def9e71f17a1ac72845d984.svg)" :db/ensure [:question/validate]} {:db/id 17592186192795 :knowledge-point/questions ["question-70e45506-8937-5eb7-832e-8c6f85a45f1e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192519 :question/problem "Compute $P\\left( 2 \\leq          X \\leq          4 \\right)$ given that the random variable $X$ has the probability density function\n\n![](images/b4/b4da93ec01e058c31044ba7022c1e7109a7bacd4fd56c264df2ccfad5fbe2457.svg)" :db/ensure [:question/validate]} {:db/id "question-70b7a02c-90a1-5f9d-b1b7-a374071b4308" :question/id #uuid "70b7a02c-90a1-5f9d-b1b7-a374071b4308" :question/math-academy-id "q-158352" :question/problem "Compute $P(0<X<1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{4}x(2-x),\\, & 0\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0<X<1) & ={\\int }_{0}^{1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{4}x(2-x)\\,\\text{d}x \\\\  & =\\frac{3}{4}{\\int }_{0}^{1}-{x}^{2}+2x\\,\\text{d}x \\\\  & =\\frac{3}{4}{[-\\frac{1}{3}{x}^{3}+{x}^{2}]}_{0}^{1} \\\\  & =\\frac{3}{4}([-\\frac{1}{3}(1)^{3}+(1)^{2}]-[-\\frac{1}{3}(0)^{3}+(0)^{2}]) \\\\  & =\\frac{3}{4}([-\\frac{1}{3}+1]-0) \\\\  & =\\frac{3}{4}\\cdot \\frac{2}{3} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2819a566-5ed8-5910-94b3-ea46282d78d0"] :db/ensure [:question/validate]} {:db/id "answer-field-2819a566-5ed8-5910-94b3-ea46282d78d0" :answer-field/id #uuid "2819a566-5ed8-5910-94b3-ea46282d78d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83221410-a10d-5d0e-83cf-13c429350eb6" :answer-field/choices ["answer-83221410-a10d-5d0e-83cf-13c429350eb6" "answer-9abc5f15-a3ff-5d2b-9f5e-c96ef4c927ad" "answer-a4064c0a-6aa8-5917-b98d-ddc4782ccc34" "answer-fbf93cb8-21ed-52ed-b5b8-e67b0f616bcc" "answer-9dda9524-0d12-5c08-9e65-638d5e2ca147"] :db/ensure [:answer-field/validate]} {:db/id "answer-83221410-a10d-5d0e-83cf-13c429350eb6" :answer/id #uuid "83221410-a10d-5d0e-83cf-13c429350eb6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9abc5f15-a3ff-5d2b-9f5e-c96ef4c927ad" :answer/id #uuid "9abc5f15-a3ff-5d2b-9f5e-c96ef4c927ad" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a4064c0a-6aa8-5917-b98d-ddc4782ccc34" :answer/id #uuid "a4064c0a-6aa8-5917-b98d-ddc4782ccc34" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-fbf93cb8-21ed-52ed-b5b8-e67b0f616bcc" :answer/id #uuid "fbf93cb8-21ed-52ed-b5b8-e67b0f616bcc" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9dda9524-0d12-5c08-9e65-638d5e2ca147" :answer/id #uuid "9dda9524-0d12-5c08-9e65-638d5e2ca147" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "question-77d8a3b9-ab3f-5af1-ac16-cd6ceeb35611" :question/id #uuid "77d8a3b9-ab3f-5af1-ac16-cd6ceeb35611" :question/math-academy-id "q-87213" :question/problem "Compute $P(1<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{18}x,\\, & 0\\le x\\le 6, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X\\le 5) & ={\\int }_{1}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{5}\\frac{1}{18}x\\,\\text{d}x \\\\  & ={[\\frac{1}{36}{x}^{2}]}_{1}^{5} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97997922-270d-5956-b157-409ccbb997d8"] :db/ensure [:question/validate]} {:db/id "answer-field-97997922-270d-5956-b157-409ccbb997d8" :answer-field/id #uuid "97997922-270d-5956-b157-409ccbb997d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-90f92edc-d0c5-5a32-ba22-e172277f28a3" :answer-field/choices ["answer-8f9616d5-ee83-53e1-8dc5-492827d8a46f" "answer-e5c1b6f1-8629-5f1d-8828-dbc4c3ad5ba8" "answer-5b4c000b-c921-5509-a96b-cb9f0d93c9ec" "answer-90f92edc-d0c5-5a32-ba22-e172277f28a3" "answer-670ba1f9-ed3f-5406-a924-34d394e42af4"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f9616d5-ee83-53e1-8dc5-492827d8a46f" :answer/id #uuid "8f9616d5-ee83-53e1-8dc5-492827d8a46f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e5c1b6f1-8629-5f1d-8828-dbc4c3ad5ba8" :answer/id #uuid "e5c1b6f1-8629-5f1d-8828-dbc4c3ad5ba8" :answer/type :answer.type/math :answer/value "\\frac{