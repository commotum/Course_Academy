39e8336e-8823-5190-8258-986854592e5f" "answer-ceff823a-381d-55c5-8f08-28d5ad75ecd8" "answer-a4262a2b-8e1a-56af-8617-c7da79b0d0c0" "answer-e1005a2d-863c-5e8e-9016-26d842f75de8" "answer-37263c1d-3a90-5cbf-a914-8e3374163496"] :db/ensure [:answer-field/validate]} {:db/id "answer-39e8336e-8823-5190-8258-986854592e5f" :answer/id #uuid "39e8336e-8823-5190-8258-986854592e5f" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-ceff823a-381d-55c5-8f08-28d5ad75ecd8" :answer/id #uuid "ceff823a-381d-55c5-8f08-28d5ad75ecd8" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a4262a2b-8e1a-56af-8617-c7da79b0d0c0" :answer/id #uuid "a4262a2b-8e1a-56af-8617-c7da79b0d0c0" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "answer-e1005a2d-863c-5e8e-9016-26d842f75de8" :answer/id #uuid "e1005a2d-863c-5e8e-9016-26d842f75de8" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "answer-37263c1d-3a90-5cbf-a914-8e3374163496" :answer/id #uuid "37263c1d-3a90-5cbf-a914-8e3374163496" :answer/type :answer.type/math :answer/value "\\frac{7}{18}" :db/ensure [:answer/validate]} {:db/id "question-c5e575cf-c390-5240-8f9f-2e2ff4fb107f" :question/id #uuid "c5e575cf-c390-5240-8f9f-2e2ff4fb107f" :question/math-academy-id "q-158308" :question/problem "Compute $P(X<1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{8}{x}^{2},\\, & 0\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X<1) & ={\\int }_{0}^{1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3}{8}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{8}{x}^{3}]}_{0}^{1} \\\\  & =\\frac{1}{8}[1-0] \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-092612b2-00fa-53f2-9670-ce20788500b5"] :db/ensure [:question/validate]} {:db/id "answer-field-092612b2-00fa-53f2-9670-ce20788500b5" :answer-field/id #uuid "092612b2-00fa-53f2-9670-ce20788500b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc4990e6-36da-5175-b799-75a15592dbaf" :answer-field/choices ["answer-7e67f1ca-b2f4-549e-815d-e10ef48f7256" "answer-38f73634-8e2d-501c-be17-972c94091082" "answer-cc4990e6-36da-5175-b799-75a15592dbaf" "answer-6ff15794-2a8c-5b30-8865-ea10f20a2b20" "answer-1faf4f36-14d4-5079-9551-250ad4e3cf1f"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e67f1ca-b2f4-549e-815d-e10ef48f7256" :answer/id #uuid "7e67f1ca-b2f4-549e-815d-e10ef48f7256" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-38f73634-8e2d-501c-be17-972c94091082" :answer/id #uuid "38f73634-8e2d-501c-be17-972c94091082" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-cc4990e6-36da-5175-b799-75a15592dbaf" :answer/id #uuid "cc4990e6-36da-5175-b799-75a15592dbaf" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-6ff15794-2a8c-5b30-8865-ea10f20a2b20" :answer/id #uuid "6ff15794-2a8c-5b30-8865-ea10f20a2b20" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "answer-1faf4f36-14d4-5079-9551-250ad4e3cf1f" :answer/id #uuid "1faf4f36-14d4-5079-9551-250ad4e3cf1f" :answer/type :answer.type/math :answer/value "\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "question-70e45506-8937-5eb7-832e-8c6f85a45f1e" :question/id #uuid "70e45506-8937-5eb7-832e-8c6f85a45f1e" :question/math-academy-id "q-158435" :question/problem "Compute $P(1<X<3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{8}({x}^{3}+x),\\, & 0\\le x\\le 2, \\\\ \\frac{1}{8}(x-2) & 2<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{8}({x}^{3}+x)\\,\\text{d}x+{\\int }_{2}^{3}\\frac{1}{8}(x-2)\\,\\text{d}x \\\\  & =\\frac{1}{8}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{1}^{2}+\\frac{1}{8}{[\\frac{1}{2}{x}^{2}-2x]}_{2}^{3} \\\\  & =\\frac{1}{8}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(1)^{4}+\\frac{1}{2}(1)^{2}])+\\frac{1}{8}([\\frac{1}{2}(3)^{2}-2(3)]-[\\frac{1}{2}(2)^{2}-2(2)]) \\\\  & =\\frac{1}{8}(6-\\frac{3}{4})+\\frac{1}{8}(\\frac{9}{2}-4) \\\\  & =\\frac{1}{8}(\\frac{21}{4})+\\frac{1}{8}(\\frac{1}{2}) \\\\  & =\\frac{21}{32}+\\frac{1}{16} \\\\  & =\\frac{23}{32}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9af9df66-4779-52c1-bd4c-a452e7989789"] :db/ensure [:question/validate]} {:db/id "answer-field-9af9df66-4779-52c1-bd4c-a452e7989789" :answer-field/id #uuid "9af9df66-4779-52c1-bd4c-a452e7989789" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0adb4037-3d21-5577-98db-0520851d8ec6" :answer-field/choices ["answer-ec9cd385-a95e-5534-93cc-032926c3dedc" "answer-0cdf27d3-c6d5-5df4-bb15-db45cd603f84" "answer-0adb4037-3d21-5577-98db-0520851d8ec6" "answer-60218c40-e5fc-5799-88a4-377813f3a491" "answer-e92906ad-768d-5f7e-a293-b12fcc80bf8b"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec9cd385-a95e-5534-93cc-032926c3dedc" :answer/id #uuid "ec9cd385-a95e-5534-93cc-032926c3dedc" :answer/type :answer.type/math :ans