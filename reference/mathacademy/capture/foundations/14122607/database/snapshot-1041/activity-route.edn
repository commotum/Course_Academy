#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420096} :activity/id #uuid "d63840d2-3609-5c32-bdc9-4fe9ce0a42cd" :activity/scope {:db/id #edb/ref 17592186049186 :topic/id #uuid "e1c10e80-3811-5fcd-98a3-8118c49347e4" :topic/math-academy-id 1737} :activity/steps [{:db/id #edb/ref 17592186420094 :step/content {:db/id #edb/ref 17592186420093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54811e57-5329-5901-9031-55945bdb3aaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\pi n" :db/id #edb/ref 17592186420082} {:answer/id #uuid "656b42d3-126c-5abb-9880-9e0fc6a9e621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+2\\pi n" :db/id #edb/ref 17592186420083} {:answer/id #uuid "6d5d9399-1eaf-57c4-b24e-dd1b89bcd1e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{4}" :db/id #edb/ref 17592186420085} {:answer/id #uuid "976cc8f2-04f3-53c2-a86c-c645ed2fbec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{2}" :db/id #edb/ref 17592186420087} {:answer/id #uuid "da650f9b-762e-5944-b6e9-28cdf4865151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186420089}] :answer-field/correct {:db/id #edb/ref 17592186420082} :answer-field/id #uuid "02673689-46fa-584e-88ff-1a1c967a1b0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8302ddf-29cf-570b-b7dd-dab545b3b824" :question/math-academy-id "q-162647" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{sec}⁡(t+\\frac{\\pi }{4})\\,i+{e}^{t-1}\\,j+{t}^{2}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sec}⁡(t+\\frac{\\pi }{4})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{4}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 2nd component ${e}^{t-1}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component ${t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "0dbe3293-2708-527b-b605-9fe12b6e37f9" :step/next {:db/id #edb/ref 17592186420098}} {:db/id #edb/ref 17592186420095 :step/content {:db/id #edb/ref 17592186420092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1000e325-da05-5f3a-9e1d-24312518777d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186420080} {:answer/id #uuid "2478ad2d-b6eb-59d1-b76b-abe7a69ec247" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,0)" :db/id #edb/ref 17592186420081} {:answer/id #uuid "691ebfd7-4000-5575-996f-d102ad66730b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186420084} {:answer/id #uuid "94b764b3-edc6-585d-9049-19b093287871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)" :db/id #edb/ref 17592186420086} {:answer/id #uuid "b312f764-3451-5f4e-9cfb-871263b18b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (0,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186420088}] :answer-field/correct {:db/id #edb/ref 17592186420080} :answer-field/id #uuid "02381afc-745d-58f1-8f0d-9b55ea92ca31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a104075-f533-58ab-b79b-2a5e66b667e2" :question/math-academy-id "q-162660" :question/problem "Find the domain of the vector-valued function $f(t)=⟨{e}^{-t},\\,\\frac{1}{t},\\,\\operatorname{ln}⁡(t+1)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{t}$ is $t\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(t+1)$ is $t\\in (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/a5/a55ef2c927b26c9beba9b44f669c817cf749b79de163b4bf0505d15c6ec31630.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-1,0)\\cup (0,\\infty ).$"} :step/id #uuid "69b7e384-7af7-55ae-bcb8-73eecb04e14a"} {:db/id #edb/ref 17592186420096 :step/content {:db/id #edb/ref 17592186115513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590ce956-fa57-52c8-b676-c7a081a32b28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,1)" :db/id #edb/ref 17592186276280} {:answer/id #uuid "8d377bcc-370f-51f9-b994-f8649f51617b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,1)" :db/id #edb/ref 17592186276755} {:answer/id #uuid "928012b6-5d37-57e3-ab1c-585b2c67c370" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (0,1)" :db/id #edb/ref 17592186276802} {:answer/id #uuid "c07039d3-aec7-5e92-9950-c14bc1351f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,0)" :db/id #edb/ref 17592186277186} {:answer/id #uuid "eee05247-e752-5968-abb0-796894121233" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,\\infty )" :db/id #edb/ref 17592186277576}] :answer-field/correct {:db/id #edb/ref 17592186276280} :answer-field/id #uuid "2c4c6d8a-57de-5558-ae04-0e3791190f90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277797}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "56023ec9-5ce1-5f4b-8f47-3c4d6d6b2dd7" :question/math-academy-id "q-160789" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\operatorname{ln}⁡(1+s),\\,\\operatorname{ln}⁡(1-s),\\,\\frac{1}{1+s}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\operatorname{ln}⁡(1+s)$ is $s\\in (-1,\\infty )$ .\n\n- The domain of $\\operatorname{ln}⁡(1-s)$ is $s\\in (-\\infty ,1).$\n\n- The domain of $\\frac{1}{1+s}$ is  $s\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/3a/3ac2933afc460e42ad5bffb8b01b9fc3ff9275ab3bcf2ac3ab710a8094b36637.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is\n\n$\\,$ $s\\in (-1,1).$"} :step/id #uuid "743b0666-1b94-5795-b0db-227efb4df31d" :step/next {:db/id #edb/ref 17592186420097}} {:db/id #edb/ref 17592186420097 :step/content {:db/id #edb/ref 17592186281514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b2176-ecc6-57f2-bc6d-f1652a33636a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\pi n" :db/id #edb/ref 17592186278767} {:answer/id #uuid "2444e896-56b2-5fe6-9c12-ded17b4df5eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186278916} {:answer/id #uuid "5fb99ab6-2b20-5f51-ac07-2107a5729fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186279469} {:answer/id #uuid "9484619f-2ead-592d-844c-a164a8fc5f1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi n}{3}" :db/id #edb/ref 17592186279912} {:answer/id #uuid "d1436dab-1fe3-50c6-a9d0-651b17cd161f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186280437}] :answer-field/correct {:db/id #edb/ref 17592186278767} :answer-field/id #uuid "064586b1-f0a2-55e9-ab4f-1edb28541b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "355588e1-74ab-5c1c-9491-56bf772d1b60" :question/math-academy-id "q-162645" :question/problem "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "85c58b22-fe0d-57c2-b692-2346cf29a3ec" :step/next {:db/id #edb/ref 17592186420094}} {:db/id #edb/ref 17592186420098 :step/content {:db/id #edb/ref 17592186281522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172da4c2-2750-5a8d-a86a-b97c9604fbad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)" :db/id #edb/ref 17592186278799} {:answer/id #uuid "7684847d-5d27-5cac-b143-1ec0db86e152" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,\\infty )" :db/id #edb/ref 17592186279647} {:answer/id #uuid "9ea5e2b2-027e-5a73-b7b3-004b4999d8bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186279999} {:answer/id #uuid "9fec719b-cb40-5f1c-9f1f-fe5c3833e5f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,2)" :db/id #edb/ref 17592186280014} {:answer/id #uuid "f1ac898a-8049-5e2b-8b24-531f56c455b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)" :db/id #edb/ref 17592186280697}] :answer-field/correct {:db/id #edb/ref 17592186280697} :answer-field/id #uuid "951bda09-c9a0-55cd-9b45-dcd0ac3017cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86e56d87-8f7f-5aac-9c51-653244b0266e" :question/math-academy-id "q-162659" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\sqrt{s},\\,\\operatorname{ln}⁡(2-s),\\,\\sqrt{3}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{s}$ is $s\\in [0,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{ln}⁡(2-s)$ is $s\\in (-\\infty ,2).$\n\n- The domain of the 3rd component $\\sqrt{3}$ is $s\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/80/808abeaa59d7bcea3b24e741fde5296791de32b4170d60f05f2a5af203c20ba2.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in [0,2).$"} :step/id #uuid "e7ce2d54-5c14-540f-93a3-4a8f924d9288" :step/next {:db/id #edb/ref 17592186420095}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186