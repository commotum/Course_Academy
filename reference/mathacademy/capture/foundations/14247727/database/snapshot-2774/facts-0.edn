[17592186166752 #edb/ref 1038 #edb/ref 17592186559788 #edb/ref 17592186045417] [17592186166752 #edb/ref 1038 #edb/ref 17592186559870 #edb/ref 17592186045417] [17592186166752 #edb/ref 1038 #edb/ref 17592186565421 #edb/ref 17592186045417] [17592186166752 #edb/ref 1038 #edb/ref 17592186565478 #edb/ref 17592186045417] [17592186166752 #edb/ref 1039 "Finding the Coordinates of a Vector With Respect to a Given Basis in a Matrix Vector Space" #edb/ref 17592186045417] [17592186166752 #edb/ref 1041 #edb/ref 17592186166590 #edb/ref 17592186045417] [17592186166752 #edb/ref 1042 #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d" #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186167308 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186167310 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186243954 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186243963 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186360540 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186360542 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186360543 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186366587 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186366594 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186366601 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186483363 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186483426 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186565420 #edb/ref 17592186045417] [17592186166753 #edb/ref 1038 #edb/ref 17592186565445 #edb/ref 17592186045417] [17592186166753 #edb/ref 1039 "Finding the Coordinates of a Vector With Respect to a Given Basis in a Polynomial Vector Space" #edb/ref 17592186045417] [17592186166753 #edb/ref 1041 #edb/ref 17592186166591 #edb/ref 17592186045417] [17592186166753 #edb/ref 1042 #uuid "2d8f8be0-0fe9-5734-87d3-5c432b7f298f" #edb/ref 17592186045417] [17592186166996 #edb/ref 1043 #edb/ref 17592186167580 #edb/ref 17592186045417] [17592186166996 #edb/ref 1043 #edb/ref 17592186167581 #edb/ref 17592186045417] [17592186166996 #edb/ref 1043 #edb/ref 17592186167582 #edb/ref 17592186045417] [17592186166996 #edb/ref 1043 #edb/ref 17592186167583 #edb/ref 17592186045417] [17592186166996 #edb/ref 1043 #edb/ref 17592186167584 #edb/ref 17592186045417] [17592186166996 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186166996 #edb/ref 1045 "The Coordinates of a Vector Relative to a Basis in Abstract Vector Spaces" #edb/ref 17592186045417] [17592186166996 #edb/ref 1046 #edb/ref 17592186167580 #edb/ref 17592186045417] [17592186166996 #edb/ref 1049 #edb/ref 17592186048333 #edb/ref 17592186045417] [17592186166996 #edb/ref 1050 840.0 #edb/ref 17592186045417] [17592186166996 #edb/ref 1053 #uuid "494e7d10-63cc-5ac1-aeb6-77e53987c48f" #edb/ref 17592186045417] [17592186167330 #edb/ref 1068 #edb/ref 17592186165189 #edb/ref 17592186045417] [17592186167330 #edb/ref 1069 "q-95022" #edb/ref 17592186045417] [17592186167330 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167330 #edb/ref 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & 7 \\\\ -5 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 3 \\\\ -1 & 0\\end{aligned}],\\,A=[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186167330 #edb/ref 1072 #uuid "431d0042-1670-53b6-9a71-1178cea2315a" #edb/ref 17592186045417] [17592186167330 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & 7 \\\\ -5 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 3 \\\\ -1 & 0\\end{aligned}] & =[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1} & 7{x}_{1}+3{x}_{2} \\\\ -5{x}_{1}-{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}=-2 \\\\ 7{x}_{1}+3{x}_{2}=-1 \\\\ -5{x}_{1}-{x}_{2}=3.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 0 & -2 \\\\ 7 & 3 & -1 \\\\ -5 & -1 & 3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 0 & -2 \\\\ 7 & 3 & -1 \\\\ -5 & -1 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-\\frac{7}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+\\frac{5}{2}{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 0 & -2 \\\\ 0 & 3 & 6 \\\\ 0 & -1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}2{x}_{1}=-2 \\\\ 3{x}_{2}=6 \\\\ -{x}_{2}=-2.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=2.$ From the first equation, we get ${x}_{1}=-1.$ \n\nTherefore, $[A]_{B}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-1+2=1.$" #edb/ref 17592186045417] [17592186167580 #edb/ref 1058 #edb/ref 17592186167581 #edb/ref 17592186045417] [17592186167580 #edb/ref 1061 653397 #edb/ref 17592186045417] [17592186167580 #edb/ref 1062 #uuid "e61da532-1350-59ec-be76-0a0464423ad6" #edb/ref 17592186045417] [17592186167580 #edb/ref 1063 #edb/ref 17592186168064 #edb/ref 17592186045417] [17592186167581 #edb/ref 1058 #edb/ref 17592186167582 #edb/ref 17592186045417] [17592186167581 #edb/ref 1061 653398 #edb/ref 17592186045417] [17592186167581 #edb/ref 1062 #uuid "9a4ae83d-c5c3-5b9f-bd08-97b2e0bc398a" #edb/ref 17592186045417] [17592186167581 #edb/ref 1063 #edb/ref 17592186166751 #edb/ref 17592186045417] [17592186167582 #edb/ref 1058 #edb/ref 17592186167583 #edb/ref 17592186045417] [17592186167582 #edb/ref 1061 653401 #edb/ref 17592186045417] [17592186167582 #edb/ref 1062 #uuid "8e896c1e-d15c-5ab8-ab0f-39877293d9e4" #edb/ref 17592186045417] [17592186167582 #edb/ref 1063 #edb/ref 17592186166752 #edb/ref 17592186045417] [17592186167583 #edb/ref 1058 #edb/ref 17592186167584 #edb/ref 17592186045417] [17592186167583 #edb/ref 1061 653404 #edb/ref 17592186045417] [17592186167583 #edb/ref 1062 #uuid "6b14a3b6-adad-5d10-bce3-5e05e7cf5144" #edb/ref 17592186045417] [17592186167583 #edb/ref 1063 #edb/ref 17592186166753 #edb/ref 17592186045417] [17592186167584 #edb/ref 1061 653407 #edb/ref 17592186045417] [17592186167584 #edb/ref 1062 #uuid "f13dd7dd-f256-5871-9c5b-37fcd35b85a3" #edb/ref 17592186045417] [17592186167584 #edb/ref 1063 #edb/ref 17592186168065 #edb/ref 17592186045417] [17592186168064 #edb/ref 1064 "We've already seen how to write the coordinates of a vector $\\mathbf v\\in \\mathbb R^n$ relative some general basis $\\mathcal B$ of $\\mathbb R^n.$ In this lesson, we will generalize this concept to abstract vector spaces.\n\nAs an example, consider the matrices $A_1$ and $A_2,$ given by\n\n![](images/28/2828c037a750f078b4d98b93248e800ec05d4899d7eb390dd135326314c44e70.svg)\n\nThe set $\\mathcal{B}=\\big\\{ A_1, A_2 \\big\\}$ is a basis of the vector space $V = \\textrm{Span}\\big\\{ A_1, A_2 \\big\\}.$ Now, suppose that the coordinates of the matrix $C$ relative to $\\mathcal{B}$ are \n\n![](images/2d/2db3ab1e4452eff2f19151cc87a805452433c7f305a80e5480c25241cba42c38.svg)\n\nLet's find the matrix $C$ using this information. \n\nAs usual, any vector in $\\textrm{Span}\\big\\{ A_1, A_2 \\big\\}$ can be written as\n\n$$\nx_1 A_1  + x_2 A_2,\n$$\n\nwhere $x_1,x_2$ are the coordinates of the vector relative to the basis. \n\nIn our case, we have \n\n![](images/64/6489e130a9237881664e1649cc5408cdff87cfb12dcf44c0342b9961cdf7bc81.svg)\n\nTherefore, \n\n$$\n\\begin{aligned}C & =2\\cdot [\\begin{aligned}3 & -1 \\\\ 0 & 5\\end{aligned}]+4\\cdot [\\begin{aligned}0 & 3 \\\\ 2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -2 \\\\ 0 & 10\\end{aligned}]+[\\begin{aligned}0 & 12 \\\\ 8 & -8\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 10 \\\\ 8 & 2\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186168064 #edb/ref 1065 4962 #edb/ref 17592186045417] [17592186168064 #edb/ref 1066 #uuid "6638787f-3ef3-5623-bcec-de4b89ebfd02" #edb/ref 17592186045417] [17592186168064 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186168065 #edb/ref 1064 "Suppose we fix a basis $\\mathcal{B}=\\{ \\mathbf{b}_1, \\mathbf{b}_2, \\ldots, \\mathbf{b}_n \\}$ of a finite-dimensional vector space $V$ with scalars from $\\mathbb{R}$ (note that \"finite-dimensional\" means that the basis contains a finite number of elements). Then, we can represent any element $\\mathbf{v} \\in V$ using the coordinates of $\\mathbf{v}$ relative to the basis $\\mathcal{B} \\mathbin{:}$\n\n![](images/c9/c9297a30f87baf08295a752cb23f2d314139508f875b4ffa2fffc8763656bd54.svg)\n\nThis defines a bijective mapping $\\phi: V\\to \\mathbb{R}^n.$ Moreover, this particular mapping has some nice properties:\n\n- $\\phi(\\mathbf{u}+\\mathbf{v}) = \\phi(\\mathbf{u}) + \\phi(\\mathbf{v})$ for any $\\mathbf{u}, \\mathbf{v} \\in V,$ and\n\n- $\\phi(\\alpha \\mathbf{v}) = \\alpha \\phi(\\mathbf{v})$ for any $\\mathbf{v} \\in V$ and any $\\alpha \\in \\mathbb{R}.$\n\nBecause of this, we say that $V$ is **isomorphic** to $\\mathbb{R}^n.$ Intuitively, this means that $V$ and $\\mathbb R^n$ have identical structures.\n\nSo, any finite-dimensional vector space is isomorphic to $\\mathbb{R}^n$ for some particular $n.$ This means that instead of studying all possible vector spaces, we can simply study only one family of vector spaces, namely $\\mathbb{R}^n$ for $n\\geq 1.$" #edb/ref 17592186045417] [17592186168065 #edb/ref 1065 4964 #edb/ref 17592186045417] [17592186168065 #edb/ref 1066 #uuid "e501b24f-7ea0-5110-a4c5-e8739ea9ac11" #edb/ref 17592186045417] [17592186168065 #edb/ref 1067 "Isomorphisms of Vector Spaces" #edb/ref 17592186045417] [17592186242439 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186242439 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242439 #edb/ref 1083 #uuid "8f04b25d-f38d-5fc1-9876-423c80368bba" #edb/ref 17592186045417] [17592186242724 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186242724 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242724 #edb/ref 1083 #uuid "b15931fb-52e5-5c41-a258-369e7d1fb1c9" #edb/ref 17592186045417] [17592186242754 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186242754 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186242754 #edb/ref 1083 #uuid "b42567a6-9890-5794-8a22-d6d56c1dc629" #edb/ref 17592186045417] [17592186243013 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186243013 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243013 #edb/ref 1083 #uuid "d0121691-eca2-5974-80e3-dbeade97f6d2" #edb/ref 17592186045417] [17592186243380 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186243380 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186243380 #edb/ref 1083 #uuid "f9e06cb0-4838-5459-9758-b2749164bf96" #edb/ref 17592186045417] [17592186243839 #edb/ref 1075 #edb/ref 17592186242439 #edb/ref 17592186045417] [17592186243839 #edb/ref 1075 #edb/ref 17592186242724 #edb/ref 17592186045417] [17592186243839 #edb/ref 1075 #edb/ref 17592186242754 #edb/ref 17592186045417] [17592186243839 #edb/ref 1075 #edb/ref 17592186243013 #edb/ref 17592186045417] [17592186243839 #edb/ref 1075 #edb/ref 17592186243380 #edb/ref 17592186045417] [17592186243839 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186243839 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186243839 #edb/ref 1078 #edb/ref 17592186242724 #edb/ref 1759