/ref 1075 #edb/ref 17592186565226 #edb/ref 17592186045417] [17592186565388 #edb/ref 1075 #edb/ref 17592186565302 #edb/ref 17592186045417] [17592186565388 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565388 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565388 #edb/ref 1078 #edb/ref 17592186564974 #edb/ref 17592186045417] [17592186565388 #edb/ref 1079 #uuid "d2e25b77-025f-5093-8bf8-7b6467b74964" #edb/ref 17592186045417] [17592186565402 #edb/ref 1075 #edb/ref 17592186565119 #edb/ref 17592186045417] [17592186565402 #edb/ref 1075 #edb/ref 17592186565166 #edb/ref 17592186045417] [17592186565402 #edb/ref 1075 #edb/ref 17592186565184 #edb/ref 17592186045417] [17592186565402 #edb/ref 1075 #edb/ref 17592186565220 #edb/ref 17592186045417] [17592186565402 #edb/ref 1075 #edb/ref 17592186565280 #edb/ref 17592186045417] [17592186565402 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565402 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565402 #edb/ref 1078 #edb/ref 17592186565119 #edb/ref 17592186045417] [17592186565402 #edb/ref 1079 #uuid "eef364c2-b743-5663-ae5b-bf40b13e0fd5" #edb/ref 17592186045417] [17592186565420 #edb/ref 1068 #edb/ref 17592186565402 #edb/ref 17592186045417] [17592186565420 #edb/ref 1069 "q-95029" #edb/ref 17592186045417] [17592186565420 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565420 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=-1-t+2{t}^{2},\\,{p}_{2}(t)=t-{t}^{2},\\,q(t)=3-3t.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186565420 #edb/ref 1072 #uuid "2d45985d-1bef-55fa-a31c-73d51b4f78be" #edb/ref 17592186045417] [17592186565420 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(-1-t+2{t}^{2})+{x}_{2}(t-{t}^{2}) & =3-3t \\\\ -{x}_{1}+(-{x}_{1}+{x}_{2})t+(2{x}_{1}-{x}_{2}){t}^{2} & =3-3t.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ -{x}_{1}+{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=0.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{3}:={R}_{3}+2{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & -1 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ {x}_{2}=-6.\\end{aligned}\n$$\n\nFrom the first and second equations, we get ${x}_{1}=-3$ and ${x}_{2}=-6.$ \n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ -6\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+(-6)=-9.$" #edb/ref 17592186045417] [17592186565421 #edb/ref 1068 #edb/ref 17592186565388 #edb/ref 17592186045417] [17592186565421 #edb/ref 1069 "q-106779" #edb/ref 17592186045417] [17592186565421 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565421 #edb/ref 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}],\\,A=[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186565421 #edb/ref 1072 #uuid "2e84799f-e1a6-5cc6-b626-825322837015" #edb/ref 17592186045417] [17592186565421 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}] & =[\\begin{aligned}-6 & -2 \\\\ 0 & 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} & -{x}_{1}+{x}_{2} \\\\ 0 & {x}_{1}-{x}_{2}\\end{aligned}] & =[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ -{x}_{1}+{x}_{2}=-2 \\\\ {x}_{1}-{x}_{2}=2.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 0 & 6 \\\\ 0 & 1 & 4 \\\\ 0 & -1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ {x}_{2}=4 \\\\ -{x}_{2}=-4.\\end{aligned}\n$$\n\n \nFrom the second and third equations, we get ${x}_{2}=4.$ From the first equation, we get  ${x}_{1}=6.$\n\nTherefore, $[A]_{B}=[\\begin{aligned}6 \\\\ 4\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=6+4=10.$" #edb/ref 17592186045417] [17592186565445 #edb/ref 1068 #edb/ref 17592186565375 #edb/ref 17592186045417] [17592186565445 #edb/ref 1069 "q-106782" #edb/ref 17592186045417] [17592186565445 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565445 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=2-t,\\,{p}_{2}(t)=3-2{t}^{2},\\,q(t)=3t-4{t}^{2}.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186565445 #edb/ref 1072 #uuid "881394e4-d1e2-502e-8f1c-cafafb97686c" #edb/ref 17592186045417] [17592186565445 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2-t)+{x}_{2}(3-2{t}^{2}) & =3t-4{t}^{2} \\\\ (2{x}_{1}+3{x}_{2})-{x}_{1}t-2{x}_{2}{t}^{2} & =3t-4{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}+3{x}_{2}=0 \\\\ -{x}_{1}=3 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 2 & 3 & 0 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 3 & 6 \\\\ 0 & -2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ 3{x}_{2}=6 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\nFrom the second and third equations we get ${x}_{2}=2.$ From the  first equation, we obtain ${x}_{1}=-3.$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+2=-1.$" #edb/ref 17592186045417] [17592186565478 #edb/ref 1068 #edb/ref 17592186565343 #edb/ref 17592186045417] [17592186565478 #edb/ref 1069 "q-95018" #edb/ref 17592186045417] [17592186565478 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565478 #edb/ref 1071 "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}],\\,A=[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045417] [17592186565478 #edb/ref 1072 #uuid "edf4a097-cde0-5ac1-86d1-cd429ba599d0" #edb/ref 17592186045417] [17592186565478 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 6{x}_{1}+9{x}_{2} \\\\ -3{x}_{1}-6{x}_{2} & 3{x}_{1}\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -3{x}_{1}-6{x}_{2}=-5 \\\\ 3{x}_{1}=1.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{1}{2}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}6 & 9 & 8 \\\\ 0 & -\\frac{3}{2} & -1 \\\\ 0 & -\\frac{9}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -\\frac{3}{2}{x}_{2}=-1 \\\\ -\\frac{9}{2}{x}_{2}=-3.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=\\frac{2}{3}.$ From the first equation, we get \n\n$$\n\\begin{aligned}6{x}_{1}+9\\cdot \\frac{2}{3} & =8 \\\\ 6{x}_{1} & =2 \\\\ {x}_{1} & =\\frac{1}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=\\frac{1}{3}+\\frac{2}{3}=1.$" #edb/ref 17592186045417] [17592186565504 #edb/ref 1058 #edb/ref 17592186565530 #edb/ref 17592186045417] [17592186565504 #edb/ref 1062 #uuid "5373f673-5213-5338-a1d0-efbf6f780dfb" #edb/ref 17592186045417] [17592186565504 #edb/ref 1063 #edb/ref 17592186565421 #edb/ref 17592186045417] [17592186565508 #edb/ref 1058 #edb/ref 17592186565518 #edb/ref 17592186045417] [17592186565508 #edb/ref 1062 #uuid "5f56d862-c86a-51b4-936f-ff4084ece379" #edb/ref 17592186045417] [17592186565508 #edb/ref 1063 #edb/ref 17592186565478 #edb/ref 17592186045417] [17592186565518 #edb/ref 1058 #edb/ref 17592186565527 #edb/ref 17592186045417] [17592186565518 #edb/ref 1062 #uuid "8e5bef8a-6e29-5055-9cfa-a6cc36b1ecde" #edb/ref 17592186045417] [17592186565518 #edb/ref 1063 #edb/ref 17592186167330 #edb/ref 17592186045417] [17592186565527 #edb/ref 1058 #edb/ref 17592186565504 #edb/ref 17592186045417] [17592186565527 #edb/ref 1062 #uuid "bcb7938f-e53a-5c04-9c08-1c79bbb07158" #edb/ref 17592186045417] [17592186565527 #edb/ref 1063 #edb/ref 17592186565420 #edb/ref 17592186045417] [17592186565530 #edb/ref 1062 #uuid "c426b9e2-f2e5-5535-8167-63c608a5c5aa" #edb/ref 17592186045417] [17592186565530 #edb/ref 1063 #edb/ref 17592186565445 #edb/ref 17592186045417]}
