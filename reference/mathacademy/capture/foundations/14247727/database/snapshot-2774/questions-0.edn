#{[{:db/id #edb/ref 17592186565421 :knowledge-point/_questions [{:db/id #edb/ref 17592186166752 :knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Matrix Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16f90a27-6313-5109-bbb8-4f7772524d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186564974} {:answer/id #uuid "2bd13daf-ca48-59e9-825a-a46dcf520048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186565008} {:answer/id #uuid "9d32efd9-ca00-5319-9be6-643c6af3ff42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186565179} {:answer/id #uuid "bd09020a-ccf6-5dd6-a0c1-117aa3597348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186565226} {:answer/id #uuid "f157e119-b980-53fb-8f72-ef9064237542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186565302}] :answer-field/correct {:answer/id #uuid "16f90a27-6313-5109-bbb8-4f7772524d5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186564974} :answer-field/id #uuid "d2e25b77-025f-5093-8bf8-7b6467b74964" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e84799f-e1a6-5cc6-b626-825322837015" :question/math-academy-id "q-106779" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}],\\,A=[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}] & =[\\begin{aligned}-6 & -2 \\\\ 0 & 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} & -{x}_{1}+{x}_{2} \\\\ 0 & {x}_{1}-{x}_{2}\\end{aligned}] & =[\\begin{aligned}6 & -2 \\\\ 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ -{x}_{1}+{x}_{2}=-2 \\\\ {x}_{1}-{x}_{2}=2.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 0 & 6 \\\\ -1 & 1 & -2 \\\\ 1 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 0 & 6 \\\\ 0 & 1 & 4 \\\\ 0 & -1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}=6 \\\\ {x}_{2}=4 \\\\ -{x}_{2}=-4.\\end{aligned}\n$$\n\n \nFrom the second and third equations, we get ${x}_{2}=4.$ From the first equation, we get  ${x}_{1}=6.$\n\nTherefore, $[A]_{B}=[\\begin{aligned}6 \\\\ 4\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=6+4=10.$"}] [{:db/id #edb/ref 17592186565445 :knowledge-point/_questions [{:db/id #edb/ref 17592186166753 :knowledge-point/id #uuid "2d8f8be0-0fe9-5734-87d3-5c432b7f298f" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Polynomial Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4beb3a66-909a-5284-8f19-4108f422c07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186565048} {:answer/id #uuid "b8494486-b6be-5318-969d-dd99f4d62997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186565215} {:answer/id #uuid "c322b0fe-2579-53a9-a017-e308cf16a5b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186565234} {:answer/id #uuid "d7634f67-a8f6-59d4-a750-b899dde278d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186565257} {:answer/id #uuid "e34854be-3584-5770-a376-eca2a97d5e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186565277}] :answer-field/correct {:answer/id #uuid "e34854be-3584-5770-a376-eca2a97d5e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186565277} :answer-field/id #uuid "ae5852dc-829f-545a-9915-7bda8a3606ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565375}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "881394e4-d1e2-502e-8f1c-cafafb97686c" :question/math-academy-id "q-106782" :question/problem "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=2-t,\\,{p}_{2}(t)=3-2{t}^{2},\\,q(t)=3t-4{t}^{2}.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2-t)+{x}_{2}(3-2{t}^{2}) & =3t-4{t}^{2} \\\\ (2{x}_{1}+3{x}_{2})-{x}_{1}t-2{x}_{2}{t}^{2} & =3t-4{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}+3{x}_{2}=0 \\\\ -{x}_{1}=3 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 3 & 0 \\\\ -1 & 0 & 3 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 2 & 3 & 0 \\\\ 0 & -2 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 3 & 6 \\\\ 0 & -2 & -4\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ 3{x}_{2}=6 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\nFrom the second and third equations we get ${x}_{2}=2.$ From the  first equation, we obtain ${x}_{1}=-3.$\n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+2=-1.$"}] [{:db/id #edb/ref 17592186565478 :knowledge-point/_questions [{:db/id #edb/ref 17592186166752 :knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Matrix Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "107579c4-226c-56f4-a2e2-579b1beca778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186564965} {:answer/id #uuid "722274c3-742b-5a48-b51d-ae59fbe68344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186565111} {:answer/id #uuid "991ed807-57db-5621-8684-6e0503cebcf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186565169} {:answer/id #uuid "e0e1b4b5-e50a-5c14-9473-88dec5bbe338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186565271} {:answer/id #uuid "fb160850-a523-56ec-9e9b-f5b031875117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186565322}] :answer-field/correct {:answer/id #uuid "fb160850-a523-56ec-9e9b-f5b031875117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186565322} :answer-field/id #uuid "358ca9bd-a430-5e36-accd-2c83f3de20f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edf4a097-cde0-5ac1-86d1-cd429ba599d0" :question/math-academy-id "q-95018" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}],\\,A=[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}0 & 6 \\\\ -3 & 3\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 9 \\\\ -6 & 0\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 6{x}_{1}+9{x}_{2} \\\\ -3{x}_{1}-6{x}_{2} & 3{x}_{1}\\end{aligned}] & =[\\begin{aligned}0 & 8 \\\\ -5 & 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -3{x}_{1}-6{x}_{2}=-5 \\\\ 3{x}_{1}=1.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}6 & 9 & 8 \\\\ -3 & -6 & -5 \\\\ 3 & 0 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{1}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{1}{2}){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}6 & 9 & 8 \\\\ 0 & -\\frac{3}{2} & -1 \\\\ 0 & -\\frac{9}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}6{x}_{1}+9{x}_{2}=8 \\\\ -\\frac{3}{2}{x}_{2}=-1 \\\\ -\\frac{9}{2}{x}_{2}=-3.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=\\frac{2}{3}.$ From the first equation, we get \n\n$$\n\\begin{aligned}6{x}_{1}+9\\cdot \\frac{2}{3} & =8 \\\\ 6{x}_{1} & =2 \\\\ {x}_{1} & =\\frac{1}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=\\frac{1}{3}+\\frac{2}{3}=1.$"}] [{:db/id #edb/ref 17592186167330 :knowledge-point/_questions [{:db/id #edb/ref 17592186166752 :knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Matrix Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c89b52a5-e7a3-566a-9918-62a16e6087de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186165190} {:answer/id #uuid "f55fc263-98d6-5acb-9fd4-97e311d62182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186165191} {:answer/id #uuid "02da13f5-fbac-5188-9cb2-808df4049ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186165192} {:answer/id #uuid "2ce84c4e-ac4e-5985-bea6-5f1e1ad5ff0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186165193} {:answer/id #uuid "30554f8d-ed15-55d9-9885-c078507c90c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186165194}] :answer-field/correct {:answer/id #uuid "30554f8d-ed15-55d9-9885-c078507c90c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186165194} :answer-field/id #uuid "1590187d-85cc-5ce7-9d74-f442d233c0fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165189}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "431d0042-1670-53b6-9a71-1178cea2315a" :question/math-academy-id "q-95022" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & 7 \\\\ -5 & 0\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}0 & 3 \\\\ -1 & 0\\end{aligned}],\\,A=[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & 7 \\\\ -5 & 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 & 3 \\\\ -1 & 0\\end{aligned}] & =[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1} & 7{x}_{1}+3{x}_{2} \\\\ -5{x}_{1}-{x}_{2} & 0\\end{aligned}] & =[\\begin{aligned}-2 & -1 \\\\ 3 & 0\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}2{x}_{1}=-2 \\\\ 7{x}_{1}+3{x}_{2}=-1 \\\\ -5{x}_{1}-{x}_{2}=3.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 0 & -2 \\\\ 7 & 3 & -1 \\\\ -5 & -1 & 3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 0 & -2 \\\\ 7 & 3 & -1 \\\\ -5 & -1 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-\\frac{7}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+\\frac{5}{2}{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 0 & -2 \\\\ 0 & 3 & 6 \\\\ 0 & -1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}2{x}_{1}=-2 \\\\ 3{x}_{2}=6 \\\\ -{x}_{2}=-2.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=2.$ From the first equation, we get ${x}_{1}=-1.$ \n\nTherefore, $[A]_{B}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-1+2=1.$"}] [{:db/id #edb/ref 17592186565420 :knowledge-point/_questions [{:db/id #edb/ref 17592186166753 :knowledge-point/id #uuid "2d8f8be0-0fe9-5734-87d3-5c432b7f298f" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Polynomial Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77f754b6-3412-584d-ba89-67035e23606c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186565119} {:answer/id #uuid "9749750d-293f-5863-817e-e6019efcfb73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186565166} {:answer/id #uuid "a1d21a6a-0db9-5004-bce9-f0f22743dbc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186565184} {:answer/id #uuid "ba52f496-ec86-590f-89ec-2e6d908c3e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186565220} {:answer/id #uuid "e63f7738-750c-5af7-b550-1409a521290c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186565280}] :answer-field/correct {:answer/id #uuid "77f754b6-3412-584d-ba89-67035e23606c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186565119} :answer-field/id #uuid "eef364c2-b743-5663-ae5b-bf40b13e0fd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186565402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d45985d-1bef-55fa-a31c-73d51b4f78be" :question/math-academy-id "q-95029" :question/problem "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=-1-t+2{t}^{2},\\,{p}_{2}(t)=t-{t}^{2},\\,q(t)=3-3t.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\},$ and $[q(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(-1-t+2{t}^{2})+{x}_{2}(t-{t}^{2}) & =3-3t \\\\ -{x}_{1}+(-{x}_{1}+{x}_{2})t+(2{x}_{1}-{x}_{2}){t}^{2} & =3-3t.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ -{x}_{1}+{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=0.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 0 & 3 \\\\ -1 & 1 & -3 \\\\ 2 & -1 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{3}:={R}_{3}+2{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & -1 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{2}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 1 & -6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}=3 \\\\ {x}_{2}=-6.\\end{aligned}\n$$\n\nFrom the first and second equations, we get ${x}_{1}=-3$ and ${x}_{2}=-6.$ \n\nTherefore, $[q(t)]_{B}=[\\begin{aligned}-3 \\\\ -6\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-3+(-6)=-9.$"}]}
