ow, the $B$-matrix for $T$ is a matrix  whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$ Therefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}-4 & 3 \\\\ 3 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186125122 :knowledge-point/_questions [{:db/id #edb/ref 17592186124539 :knowledge-point/id #uuid "56260e5b-1f89-58db-8833-b8efa77b5e9f" :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to a Basis in a Two-Dimensional Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0deaa4-54c0-5e66-9726-7cb37a188bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -10 \\\\ 1 & 13\\end{aligned}]" :db/id #edb/ref 17592186324069} {:answer/id #uuid "9cc2a3cd-d71e-5ea6-b3a8-ed4c9778b955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -10 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186325302} {:answer/id #uuid "bc13a111-7810-5671-a465-2526d2325376" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -1 \\\\ 10 & 1\\end{aligned}]" :db/id #edb/ref 17592186325586} {:answer/id #uuid "c95bdbf9-8a00-5746-b6a7-264f1d71eef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -13 \\\\ 1 & 10\\end{aligned}]" :db/id #edb/ref 17592186325718} {:answer/id #uuid "edebfe63-7b23-5372-ab6d-d2f08dc41e4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 \\\\ 10 & 13\\end{aligned}]" :db/id #edb/ref 17592186326066}] :answer-field/correct {:answer/id #uuid "0b0deaa4-54c0-5e66-9726-7cb37a188bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -10 \\\\ 1 & 13\\end{aligned}]" :db/id #edb/ref 17592186324069} :answer-f