in{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -4 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & 8 \\\\ 0 & 1 & -4 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186394388 #edb/ref 1075 #edb/ref 17592186394389 #edb/ref 17592186045417] [17592186394388 #edb/ref 1075 #edb/ref 17592186394390 #edb/ref 17592186045417] [17592186394388 #edb/ref 1075 #edb/ref 17592186394391 #edb/ref 17592186045417] [17592186394388 #edb/ref 1075 #edb/ref 17592186394392 #edb/ref 17592186045417] [17592186394388 #edb/ref 1075 #edb/ref 17592186394393 #edb/ref 17592186045417] [17592186394388 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186394388 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186394388 #edb/ref 1078 #edb/ref 17592186394391 #edb/ref 17592186045417] [17592186394388 #edb/ref 1079 #uuid "72a65dc9-b255-52da-b03a-40cb9a533324" #edb/ref 17592186045417] [17592186394389 #edb/ref 1080 "[\\begin{aligned}7 & -4 \\\\ 8 & -3\\end{aligned}]" #edb/ref 17592186045417] [17592186394389 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186394389 #edb/ref 1083 #uuid "c3622319-a74c-5864-a08e-fb807db69c94" #edb/ref 17592186045417] [17592186394390 #edb/ref 1080 "[\\begin{aligned}-4 & -3 \\\\ 7 & 8\\end{aligned}]" #edb/ref 17592186045417] [17592186394390 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186394390 #edb/ref 1083 #uuid "f07ffe3a-649c-5adf-8b2b-7ab2496a8fd5" #edb/ref 17592186045417] [17592186394391 #edb/ref 1080 "[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}]" #edb/ref 17592186045417] [17592186394391 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186394391 #edb/ref 1083 #uuid "3b91e62e-ada8-52a8-a4ff-c619299814db" #edb/ref 17592186045417] [17592186394392 #edb/ref 1080 "[\\begin{aligned}8 & 7 \\\\ -3 & -4\\end{align