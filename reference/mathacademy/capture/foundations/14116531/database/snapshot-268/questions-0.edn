#{[{:db/id #edb/ref 17592186409710 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc08d88-96fa-5f9d-8557-7fd8fe262961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II" :db/id #edb/ref 17592186409700} {:answer/id #uuid "4f20ef63-3480-55f7-95e5-2cc853da0048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409702} {:answer/id #uuid "573b7e2b-ff52-5029-b107-d0355f51c237" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186409703} {:answer/id #uuid "846d05a9-d44d-5e50-8190-0ce86e7971a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186409705} {:answer/id #uuid "a9dc495a-c9d0-52b6-b7d2-7e013a5139c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186409706}] :answer-field/correct {:answer/id #uuid "4f20ef63-3480-55f7-95e5-2cc853da0048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186409702} :answer-field/id #uuid "0677d12a-c058-55e0-b0e6-dbd13fd6e32a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c5afa8a-a09e-5d94-9d6f-17bde8db6cd3" :question/math-academy-id "q-105422" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,2\\le x\\le 4,\\,0<{y}^{2}\\le 5}$\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<7}$\n- ${(x,y)\\in {R}^{2}\\,:\\,1\\le x<4,\\,{y}^{2}<9}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,\\sqrt{5}).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\n- The second set is *open* since it doesn't contain any of its boundary points (the corresponding inequality is strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,0).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186241054 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41e37c6d-8931-5cb2-bc23-b2c99d1188ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238627} {:answer/id #uuid "53ed240f-0f1d-542b-905b-5b6dfb8ecc38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238774} {:answer/id #uuid "7f76bc95-401b-5344-ab0d-79b936598539" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186239164} {:answer/id #u