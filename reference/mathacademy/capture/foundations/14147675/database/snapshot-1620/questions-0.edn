#{[{:db/id #edb/ref 17592186430390 :knowledge-point/_questions [{:db/id #edb/ref 17592186157370 :knowledge-point/id #uuid "c834972a-1ed0-585c-803c-906fcea8cea8" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Three-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1204147e-9d6e-5e43-8474-be634d7db4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186430366} {:answer/id #uuid "1efa5566-7842-5b7d-abc6-3035b571fbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{36}" :db/id #edb/ref 17592186430367} {:answer/id #uuid "4b1cc392-4060-5a10-aaea-a16a825992de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186430373} {:answer/id #uuid "635dd8c1-f102-56ce-a2d5-2b936e82ad9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{72}" :db/id #edb/ref 17592186430376} {:answer/id #uuid "ee6aa4d5-c7a1-5ab9-8654-14774348fc7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186430384}] :answer-field/correct {:answer/id #uuid "635dd8c1-f102-56ce-a2d5-2b936e82ad9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{72}" :db/id #edb/ref 17592186430376} :answer-field/id #uuid "03117e06-c0a6-56f8-b0fb-52f9c75a1cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "572f0ee2-d90d-5ec7-a063-65cce5fd61fa" :question/math-academy-id "q-131262" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{6},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3x}{2}, & 0<x<1 \\\\ \\frac{1}{{x}^{5}},\\, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3x}{2}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{3}}{2}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{3{x}^{4}}{8}|}_{0}^{1}+(-\\frac{1}{2{x}^{2}}){|}_{1}^{\\infty } \\\\  & =\\frac{3}{8}+\\frac{1}{2} \\\\  & =\\frac{7}{8}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{7}{8}-{(\\frac{5}{6})}^{2} \\\\  & =\\frac{13}{72}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430391 :knowledge-point/_questions [{:db/id #edb/ref 17592186157370 :knowledge-point/id #uuid "c834972a-1ed0-585c-803c-906fcea8cea8" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Three-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441dd7e3-e030-5310-9ecb-7b67a3982bac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.98" :db/id #edb/ref 17592186430370} {:answer/id #uuid "4f0b7271-9bb4-550c-b029-e79bed346a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186430374} {:answer/id #uuid "81542d0a-0fb0-50ab-9035-5794eba4e936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.43" :db/id #edb/ref 17592186430380} {:answer/id #uuid "c9be22c8-e40d-5cc8-8a81-8a499de04f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.12" :db/id #edb/ref 17592186430382} {:answer/id #uuid "e9cd7562-368d-5fd1-be77-af5eda236982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.54" :db/id #edb/ref 17592186430383}] :answer-field/correct {:answer/id #uuid "4f0b7271-9bb4-550c-b029-e79bed346a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186430374} :answer-field/id #uuid "49546c79-a4c5-5d04-8800-05585ba7aeb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430386}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5874ecb6-66d6-5729-9147-ef1e0e5bab53" :question/math-academy-id "q-90539" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{17}{24},$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{4}, & 0<x<1, \\\\ \\frac{1}{{x}^{5}}, & 1\\le x, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{2}}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{4}|}_{0}^{1}+{(-\\frac{1}{2{x}^{2}})|}_{1}^{\\infty } \\\\  & =\\frac{3}{4}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{3}{4}-{(\\frac{17}{24})}^{2} \\\\  & =\\frac{143}{576} \\\\  & ≈0.25\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}]}
