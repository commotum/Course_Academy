#{[{:db/id #edb/ref 17592186444791 :knowledge-point/_questions [{:db/id #edb/ref 17592186157369 :knowledge-point/id #uuid "697e5bea-20b4-5de0-9992-7a67ee932809" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Two-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e9efdb4-7f80-5918-beaf-297fded0d1a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186444772} {:answer/id #uuid "32231228-53fe-53d5-bdc4-f2108fb66469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186444774} {:answer/id #uuid "543d492f-4858-541f-821f-46b005347464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186444775} {:answer/id #uuid "90be949d-ed37-5555-9606-534582ba1286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186444779} {:answer/id #uuid "dc814aab-899d-5c15-be40-875f5ab22753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186444783}] :answer-field/correct {:answer/id #uuid "dc814aab-899d-5c15-be40-875f5ab22753" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186444783} :answer-field/id #uuid "a0c7e56e-c625-533d-aa7a-794522008c4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444788}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51c295b5-218d-536a-afb4-4f24a659df27" :question/math-academy-id "q-131168" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{20(x-1)}{{x}^{6}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{20(x-1)}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20x-20}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20}{{x}^{4}}-\\frac{20}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{20}{3{x}^{3}}+\\frac{5}{{x}^{4}}{|}_{1}^{\\infty } \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{20(x-1)}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20x-20}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20}{{x}^{3}}-\\frac{20}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{10}{{x}^{2}}+\\frac{20}{3{x}^{3}}{|}_{1}^{\\infty } \\\\  & =\\frac{10}{3}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{10}{3}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430390 :knowledge-point/_questions [{:db/id #edb/ref 17592186157370 :knowledge-point/id #uuid "c834972a-1ed0-585c-803c-906fcea8cea8" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Three-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1204147e-9d6e-5e43-8474-be634d7db4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186430366} {:answer/id #uuid "1efa5566-7842-5b7d-abc6-3035b571fbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{36}" :db/id #edb/ref 17592186430367} {:answer/id #uuid "4b1cc392-4060-5a10-aaea-a16a825992de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186430373} {:answer/id #uuid "635dd8c1-f102-56ce-a2d5-2b936e82ad9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{72}" :db/id #edb/ref 17592186430376} {:answer/id #uuid "ee6aa4d5-c7a1-5ab9-8654-14774348fc7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186430384}] :answer-field/correct {:answer/id #uuid "635dd8c1-f102-56ce-a2d5-2b936e82ad9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{72}" :db/id #edb/ref 17592186430376} :answer-field/id #uuid "03117e06-c0a6-56f8-b0fb-52f9c75a1cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "572f0ee2-d90d-5ec7-a063-65cce5fd61fa" :question/math-academy-id "q-131262" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{6},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3x}{2}, & 0<x<1 \\\\ \\frac{1}{{x}^{5}},\\, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3x}{2}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{3}}{2}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{3{x}^{4}}{8}|}_{0}^{1}+(-\\frac{1}{2{x}^{2}}){|}_{1}^{\\infty } \\\\  & =\\frac{3}{8}+\\frac{1}{2} \\\\  & =\\frac{7}{8}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{7}{8}-{(\\frac{5}{6})}^{2} \\\\  & =\\frac{13}{72}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186444790 :knowledge-point/_questions [{:db/id #edb/ref 17592186157370 :knowledge-point/id #uuid "c834972a-1ed0-585c-803c-906fcea8cea8" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Three-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f169529-16b9-5970-b3fb-d0c797adbd00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186444773} {:answer/id #uuid "5afefafb-20e1-5716-b02e-540539f314ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{9}" :db/id #edb/ref 17592186444776} {:answer/id #uuid "65707762-b12f-554d-aba1-2a960aba5f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{9}" :db/id #edb/ref 17592186444777} {:answer/id #uuid "683e74a6-80ae-5bde-af5a-1ba88edd8aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{19}{6}" :db/id #edb/ref 17592186444778} {:answer/id #uuid "b772c7d7-0de6-57a8-9652-c7c648566917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186444781}] :answer-field/correct {:answer/id #uuid "b772c7d7-0de6-57a8-9652-c7c648566917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186444781} :answer-field/id #uuid "2208588d-645c-5de7-972e-8974e29492ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444787}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "066a3d21-35aa-5e6a-8d2f-0980dd8ef30f" :question/math-academy-id "q-131263" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{3},$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{x}{3}, & 0<x<2 \\\\ \\frac{2(3-x)}{3},\\, & 2\\le x<3 \\\\ 0 & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{x}{3}\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot \\frac{2(3-x)}{3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{3}}{3}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{6{x}^{2}-2{x}^{3}}{3}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{12}|}_{0}^{2}+(\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{6}){|}_{2}^{3} \\\\  & =\\frac{4}{3}+(18-\\frac{27}{2})-(\\frac{16}{3}-\\frac{8}{3}) \\\\  & =\\frac{4}{3}+\\frac{11}{6} \\\\  & =\\frac{19}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{19}{6}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{7}{18}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186444792 :knowledge-point/_questions [{:db/id #edb/ref 17592186157369 :knowledge-point/id #uuid "697e5bea-20b4-5de0-9992-7a67ee932809" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Two-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5575a9f-2ab2-5d7f-a9f8-276caa836627" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186444780} {:answer/id #uuid "d0832666-aa34-5722-9c73-1e8c1c1870ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444782} {:answer/id #uuid "dd759a9a-fce0-5c1b-a261-33cbdb2e7216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186444784} {:answer/id #uuid "e1dfce71-5ec8-5a3c-bd1e-1e6fb3662f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186444785} {:answer/id #uuid "f8e19652-da47-5018-894c-72ff00f667d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186444786}] :answer-field/correct {:answer/id #uuid "e1dfce71-5ec8-5a3c-bd1e-1e6fb3662f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186444785} :answer-field/id #uuid "c501e9ae-0a39-5e88-9d3f-80627d2d0978" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e581a350-34fb-5bb6-8fc4-e9d06576ecf2" :question/math-academy-id "q-90531" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{4}}\\,\\text{d}x \\\\  & ={(-\\frac{4}{3{x}^{3}})|}_{1}^{\\infty } \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={(-\\frac{2}{{x}^{2}})|}_{1}^{\\infty } \\\\  & =2\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =2-{(\\frac{4}{3})}^{2} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186430391 :knowledge-point/_questions [{:db/id #edb/ref 17592186157370 :knowledge-point/id #uuid "c834972a-1ed0-585c-803c-906fcea8cea8" :knowledge-point/title "Computing the Variance of a Continuous Random Variable Given a Three-Branch PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441dd7e3-e030-5310-9ecb-7b67a3982bac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.98" :db/id #edb/ref 17592186430370} {:answer/id #uuid "4f0b7271-9bb4-550c-b029-e79bed346a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer