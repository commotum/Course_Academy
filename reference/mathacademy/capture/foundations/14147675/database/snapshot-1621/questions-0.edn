2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{2}}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{4}|}_{0}^{1}+{(-\\frac{1}{2{x}^{2}})|}_{1}^{\\infty } \\\\  & =\\frac{3}{4}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{3}{4}-{(\\frac{17}{24})}^{2} \\\\  & =\\frac{143}{576} \\\\  & ≈0.25\\end{aligned}\n$$\n\n \nrounded to $2$ decimal places."}]}
