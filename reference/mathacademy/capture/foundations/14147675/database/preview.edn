534933 17592186045417 true] [17592186444788 1075 #edb/ref 17592186444775 13194139534933 17592186045417 true] [17592186444788 1075 #edb/ref 17592186444779 13194139534933 17592186045417 true] [17592186444788 1075 #edb/ref 17592186444783 13194139534933 17592186045417 true] [17592186444788 1076 #edb/ref 17592186045493 13194139534933 17592186045417 true] [17592186444788 1077 "selection" 13194139534933 17592186045417 true] [17592186444788 1078 #edb/ref 17592186444783 13194139534933 17592186045417 true] [17592186444788 1079 #uuid "a0c7e56e-c625-533d-aa7a-794522008c4d" 13194139534933 17592186045417 true] [17592186444789 1075 #edb/ref 17592186444780 13194139534933 17592186045417 true] [17592186444789 1075 #edb/ref 17592186444782 13194139534933 17592186045417 true] [17592186444789 1075 #edb/ref 17592186444784 13194139534933 17592186045417 true] [17592186444789 1075 #edb/ref 17592186444785 13194139534933 17592186045417 true] [17592186444789 1075 #edb/ref 17592186444786 13194139534933 17592186045417 true] [17592186444789 1076 #edb/ref 17592186045493 13194139534933 17592186045417 true] [17592186444789 1077 "selection" 13194139534933 17592186045417 true] [17592186444789 1078 #edb/ref 17592186444785 13194139534933 17592186045417 true] [17592186444789 1079 #uuid "c501e9ae-0a39-5e88-9d3f-80627d2d0978" 13194139534933 17592186045417 true] [17592186444790 1068 #edb/ref 17592186444787 13194139534933 17592186045417 true] [17592186444790 1069 "q-131263" 13194139534933 17592186045417 true] [17592186444790 1070 #edb/ref 17592186045487 13194139534933 17592186045417 true] [17592186444790 1071 "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{5}{3},$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{x}{3}, & 0<x<2 \\\\ \\frac{2(3-x)}{3},\\, & 2\\le x<3 \\\\ 0 & \\text{otherwise}\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444790 1072 #uuid "066a3d21-35aa-5e6a-8d2f-0980dd8ef30f" 13194139534933 17592186045417 true] [17592186444790 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{2}\\cdot \\frac{x}{3}\\,\\text{d}x+{\\int }_{2}^{3}{x}^{2}\\cdot \\frac{2(3-x)}{3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{3}}{3}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{6{x}^{2}-2{x}^{3}}{3}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{12}|}_{0}^{2}+(\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{6}){|}_{2}^{3} \\\\  & =\\frac{4}{3}+(18-\\frac{27}{2})-(\\frac{16}{3}-\\frac{8}{3}) \\\\  & =\\frac{4}{3}+\\frac{11}{6} \\\\  & =\\frac{19}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{19}{6}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{7}{18}.\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444791 1068 #edb/ref 17592186444788 13194139534933 17592186045417 true] [17592186444791 1069 "q-131168" 13194139534933 17592186045417 true] [17592186444791 1070 #edb/ref 17592186045487 13194139534933 17592186045417 true] [17592186444791 1071 "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{20(x-1)}{{x}^{6}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444791 1072 #uuid "51c295b5-218d-536a-afb4-4f24a659df27" 13194139534933 17592186045417 true] [17592186444791 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{20(x-1)}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20x-20}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20}{{x}^{4}}-\\frac{20}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{20}{3{x}^{3}}+\\frac{5}{{x}^{4}}{|}_{1}^{\\infty } \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{20(x-1)}{{x}^{6}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20x-20}{{x}^{4}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{20}{{x}^{3}}-\\frac{20}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{10}{{x}^{2}}+\\frac{20}{3{x}^{3}}{|}_{1}^{\\infty } \\\\  & =\\frac{10}{3}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{10}{3}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444792 1068 #edb/ref 17592186444789 13194139534933 17592186045417 true] [17592186444792 1069 "q-90531" 13194139534933 17592186045417 true] [17592186444792 1070 #edb/ref 17592186045487 13194139534933 17592186045417 true] [17592186444792 1071 "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444792 1072 #uuid "e581a350-34fb-5bb6-8fc4-e9d06576ecf2" 13194139534933 17592186045417 true] [17592186444792 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{1}^{\\infty }x\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{4}}\\,\\text{d}x \\\\  & ={(-\\frac{4}{3{x}^{3}})|}_{1}^{\\infty } \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{1}^{\\infty }{x}^{2}\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={(-\\frac{2}{{x}^{2}})|}_{1}^{\\infty } \\\\  & =2\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =2-{(\\frac{4}{3})}^{2} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$" 13194139534933 17592186045417 true] [17592186444793 1058 #edb/ref 17592186444795 13194139534933 17592186045417 true] [17592186444793 1062 #uuid "3d3ca8a5-5e8c-5065-8776-a34522517e00" 13194139534933 17592186045417 true] [17592186444793 1063 #edb/ref 17592186444792 13194139534933 17592186045417 true] [17592186444794 1058 #edb/ref 17592186444797 13194139534933 17592186045417 true] [17592186444794 1062 #uuid "581089fb-ba1b-5011-b705-bf6aeed4884e" 13194139534933 17592186045417 true] [17592186444794 1063 #edb/ref 17592186444791 13194139534933 17592186045417 true] [17592186444795 1058 #edb/ref 17592186444794 13194139534933 17592186045417 true] [17592186444795 1062 #uuid "7003b13e-c8c5-5ff3-8c6f-c0164d0ecf2d" 13194139534933 17592186045417 true] [17592186444795 1063 #edb/ref 17592186430391 13194139534933 17592186045417 true] [17592186444796 1062 #uuid "7c709c4d-931f-560c-b9a0-530b648f2ff4" 13194139534933 17592186045417 true] [17592186444796 1063 #edb/ref 17592186444790 13194139534933 17592186045417 true] [17592186444797 1058 #edb/ref 17592186444796 13194139534933 17592186045417 true] [17592186444797 1062 #uuid "933683ca-d2b