\\\\  & ={\\int }_{0}^{2}\\frac{{x}^{3}}{3}\\,\\text{d}x+{\\int }_{2}^{3}\\frac{6{x}^{2}-2{x}^{3}}{3}\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{12}|}_{0}^{2}+(\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{6}){|}_{2}^{3} \\\\  & =\\frac{4}{3}+(18-\\frac{27}{2})-(\\frac{16}{3}-\\frac{8}{3}) \\\\  & =\\frac{4}{3}+\\frac{11}{6} \\\\  & =\\frac{19}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{19}{6}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{7}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2208588d-645c-5de7-972e-8974e29492ca"] :db/ensure [:question/validate]} {:db/id "answer-field-2208588d-645c-5de7-972e-8974e29492ca" :answer-field/id #uuid "2208588d-645c-5de7-972e-8974e29492ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b772c7d7-0de6-57a8-9652-c7c648566917" :answer-field/choices ["answer-683e74a6-80ae-5bde-af5a-1ba88edd8aee" "answer-65707762-b12f-554d-aba1-2a960aba5f32" "answer-5afefafb-20e1-5716-b02e-540539f314ef" "answer-b772c7d7-0de6-57a8-9652-c7c648566917" "answer-1f169529-16b9-5970-b3fb-d0c797adbd00"] :db/ensure [:answer-field/validate]} {:db/id "answer-683e74a6-80ae-5bde-af5a-1ba88edd8aee" :answer/id #uuid "683e74a6-80ae-5bde-af5a-1ba88edd8aee" :answer/type :answer.type/math :answer/value "\\frac{19}{6}" :db/ensure [:answer/validate]} {:db/id "answer-65707762-b12f-554d-aba1-2a960aba5f32" :answer/id #uuid "65707762-b12f-554d-aba1-2a960aba5f32" :answer/type :answer.type/math :answer/value "\\frac{19}{9}" :db/ensure [:answer/validate]} {:db/id "answer-5afefafb-20e1-5716-b02e-540539f314ef" :answer/id #uuid "5afefafb-20e1-5716-b02e-540539f314ef" :answer/type :answer.type/math :answer/value "\\frac{25}{9}" :db/ensure [:answer/validate]} {:db/id "answer-b772c7d7-0de6-57a8-9652-c7c648566917" :answer/id #uuid "b772c7d7-0de6-57a8-9652-c7c648566917" :answ