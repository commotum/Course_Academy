#{[{:activity/first-step {:db/id #edb/ref 17592186120736} :activity/id #uuid "9bad4bff-0bb7-5ce9-89c2-cbdc3bbadd77" :activity/scope {:db/id #edb/ref 17592186050028 :topic/id #uuid "26e7d665-1fe7-5eaf-8ec8-486cb95ff36f" :topic/math-academy-id 1867} :activity/steps [{:db/id #edb/ref 17592186120736 :step/content {:db/id #edb/ref 17592186121058 :tutorial/content "The dimension of the column space of a matrix $A$ is called the **rank of $A$**. It's usually denoted by $\\textrm{rank}(A)$. So, \n\n$$\n\\textrm{rank}(A) = \\textrm{dim}(\\textrm{Col}(A)).\n$$\n\nFor example, to find the rank of \n\n$$\n[\\begin{aligned}3 & 2 & 5 \\\\ 0 & 1 & 0 \\\\ 6 & 4 & 10\\end{aligned}]\n$$\n\nwe write $A$ in row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}3 & 2 & 5 \\\\ 0 & 1 & 0 \\\\ 6 & 4 & 10\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 2 & 5 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that there are $2$ pivot columns, namely, the $1$st and the $2$nd. This implies that the first and the second columns of $A$ form a basis of $\\textrm{Col}(A)$ and, therefore, the dimension of $\\textrm{Col}(A)$ is equal to $2.$" :tutorial/id #uuid "6318f9cd-930b-5b7b-acc7-c27b5b241825" :tutorial/math-academy-id 3519 :tutorial/title "Introduction"} :step/id #uuid "df182889-cfbe-5906-abbc-45fc241177c2" :step/math-academy-id 19977 :step/next {:db/id #edb/ref 17592186120737}} {:db/id #edb/ref 17592186120737 :step/content {:db/id #edb/ref 17592186119847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119661 :question/id #uuid "7cce27e9-e2b2-599c-9f4e-437caf1a23ae" :question/math-academy-id "e-5415"} :knowledge-point/id #uuid "be3d5a74-259e-58b9-948d-47ba7412ab08" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049723}] :knowledge-point/questions [{:db/id #edb/ref 17592186120363} {:db/id #edb/ref 17592186120366} {:db/id #edb/ref 17592186271973} {:db/id #edb/ref 17592186271975} {:db/id #edb/ref 17592186319237} {:db/id #edb/ref 17592186348220}] :knowledge-point/title "Determining the Rank of a Matrix Given the Number of Pivot Columns"} :step/id #uuid "fd1734a2-5193-5182-9a6f-4a024ee32ce5" :step/math-academy-id 19978 :step/next {:db/id #edb/ref 17592186120761}} {:db/id #edb/ref 17592186120738 :step/content {:db/id #edb/ref 17592186119848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119662 :question/id #uuid "a6a3db41-6033-537a-bc9d-03fde02dc869" :question/math-academy-id "e-5417"} :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/questions [{:db/id #edb/ref 17592186120364} {:db/id #edb/ref 17592186120384} {:db/id #edb/ref 17592186271978} {:db/id #edb/ref 17592186319236} {:db/id #edb/ref 17592186321043} {:db/id #edb/ref 17592186348236} {:db/id #edb/ref 17592186348239}] :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"} :step/id #uuid "8cc42d44-bd5b-5eb5-9e55-ef7a7d93c31a" :step/math-academy-id 19980 :step/next {:db/id #edb/ref 17592186120739}} {:db/id #edb/ref 17592186120739 :step/content {:db/id #edb/ref 17592186119849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119663 :question/id #uuid "b3e4eb01-0669-586b-a716-aef87d1c3580" :question/math-academy-id "e-5418"} :knowledge-point/id #uuid "7f5a44c9-16e5-55fb-a10f-15435a0a9a4c" :knowledge-point/questions [{:db/id #edb/ref 17592186120385} {:db/id #edb/ref 17592186120386} {:db/id #edb/ref 17592186319238} {:db/id #edb/ref 17592186319240} {:db/id #edb/ref 17592186321035} {:db/id #edb/ref 17592186321049}] :knowledge-point/title "Finding the Rank of a Matrix Using Row Reduction"} :step/id #uuid "c27d4e1c-92bf-502f-9c02-c0bf68357dbf" :step/math-academy-id 19981} {:db/id #edb/ref 17592186120761 :step/content {:db/id #edb/ref 17592186121068 :tutorial/content "Note that the number of pivot columns always coincides with the number of non-zero rows in the corresponding row echelon form matrix.\nSo, technically, \n\n> $\\textrm{rank}(A)$ is the number of *pivot columns* in the corresponding row echelon form matrix of $A$.\n\nOr, equivalently,\n\n> $\\textrm{rank}(A)$ is the number of *non-zero rows* in the corresponding row echelon form matrix of $A$." :tutorial/id #uuid "c062d466-946c-526b-aba8-0a0895671218" :tutorial/math-academy-id 4151 :tutorial/title "An Alternative Definition of the Rank"} :step/id #uuid "1383e230-aa34-5f36-a91f-c60846be8cc4" :step/math-academy-id 25259 :step/next {:db/id #edb/ref 17592186120738}}] :activity/title "The Rank of a Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120057}]}
