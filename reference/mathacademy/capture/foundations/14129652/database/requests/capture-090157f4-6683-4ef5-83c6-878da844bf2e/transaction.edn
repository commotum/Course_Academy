id #uuid "94de2c24-0666-5987-a3e2-ff3510e0a531" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1bfcd141-3e36-5f68-a168-3e5e85d0afaa" :answer-field/choices ["answer-01c2d7ad-da5d-5526-b55d-0bfbbbfa0ca8" "answer-1bfcd141-3e36-5f68-a168-3e5e85d0afaa" "answer-a66cc7c7-996a-5420-9e86-cb5f158857e4" "answer-d02c53ba-5869-5c02-9d9d-790814704f1a" "answer-16dc19e7-86e4-53a4-8e1f-0b47a22255f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-01c2d7ad-da5d-5526-b55d-0bfbbbfa0ca8" :answer/id #uuid "01c2d7ad-da5d-5526-b55d-0bfbbbfa0ca8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-1bfcd141-3e36-5f68-a168-3e5e85d0afaa" :answer/id #uuid "1bfcd141-3e36-5f68-a168-3e5e85d0afaa" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-a66cc7c7-996a-5420-9e86-cb5f158857e4" :answer/id #uuid "a66cc7c7-996a-5420-9e86-cb5f158857e4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-d02c53ba-5869-5c02-9d9d-790814704f1a" :answer/id #uuid "d02c53ba-5869-5c02-9d9d-790814704f1a" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-16dc19e7-86e4-53a4-8e1f-0b47a22255f9" :answer/id #uuid "16dc19e7-86e4-53a4-8e1f-0b47a22255f9" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-8c046845-0154-54e8-9266-c14fc31a0fbc" :question/id #uuid "8c046845-0154-54e8-9266-c14fc31a0fbc" :question/math-academy-id "q-79560" :question/problem "Which of the following matrices has a rank of $3?$" :question/worked-solution "First, notice that a matrix of rank $3$ must have at least $3$ columns and at least $3$ rows. \nSo, we disregard the following matrices:\n\n- $A$ since it has only $2$ rows.\n\n- $B$ since it has only $2$ rows (and only $2$ columns).\n\n- $E$ since it has only $2$ columns.\n\nAlso, the matrix must have $3$ pivot columns. As we can see, the matrix $C$ has exactly $3$ pivot columns, while the matrix $D$ has only $2$ pivot columns. So, $\\text{rank}(C)=3$ and $\\text{rank}(D)=2.$\n\nTherefore, the correct answer is the matrix $C.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c3c987d-47cd-5e40-a273-46742d15f9a1"] :db/ensure [:question/validate]} {:db/id "answer-field-6c3c987d-47cd-5e40-a273-46742d15f9a1" :answer-field/id #uuid "6c3c987d-47cd-5e40-a273-46742d15f9a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9c751ce-2bdb-5742-bae8-b0d52ba986db" :answer-field/choices ["answer-c56ff60f-9868-5d39-a38d-a5e22b0c66cb" "answer-5ded1fff-9517-5427-baeb-9e6226b1a956" "answer-c9c751ce-2bdb-5742-bae8-b0d52ba986db" "answer-fd4e3c03-ae1c-5130-988c-c64b1fac85e1" "answer-dc879383-a282-5736-9d82-b936dcdd959d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c56ff60f-9868-5d39-a38d-a5e22b0c66cb" :answer/id #uuid "c56ff60f-9868-5d39-a38d-a5e22b0c66cb" :answer/type :answer.type/math :answer/value "A=[\\begin{aligned}2 & 1 & 0 & 1 & 0 \\\\ 0 & -1 & 0 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5ded1fff-9517-5427-baeb-9e6226b1a956" :answer/id #uuid "5ded1fff-9517-5427-baeb-9e6226b1a956" :answer/type :answer.type/math :answer/value "B=[\\begin{aligned}5 & -1 \\\\ 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c9c751ce-2bdb-5742-bae8-b0d52ba986db" :answer/id #uuid "c9c751ce-2bdb-5742-bae8-b0d52ba986db" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}2 & 1 & 3 & 1 & 0 \\\\ 0 & -1 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fd4e3c03-ae1c-5130-988c-c64b1fac85e1" :answer/id #uuid "fd4e3c03-ae1c-5130-988c-c64b1fac85e1" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}3 & 2 & 1 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dc879383-a282-5736-9d82-b936dcdd959d" :answer/id #uuid "dc879383-a282-5736-9d82-b936dcdd959d" :answer/type :answer.type/math :answer/value "E=[\\begin{aligned}-1 & 2 \\\\ 0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-cf208166-634c-5dd4-a095-ee064f03b9e3" :question/id #uuid "cf208166-634c-5dd4-a095-ee064f03b9e3" :question/math-academy-id "q-79559" :question/problem "Which of the following matrices has a rank of $5?$" :question/worked-solution "First, notice that a matrix of rank $5$ must have at least $5$ columns and at least $5$ rows. \nSo, we disregard the following matrices:\n\n- $B$ since it has only $2$ rows.\n\n- $C$ since it has only $3$ columns.\n\n- $D$ since it has only $3$ rows (and only $3$ columns).\n\nAlso, the matrix must have $5$ pivot columns. As we can see, the matrix $A$ has exactly $5$ pivot columns, while the matrix $E$ has only $4$ pivot columns. So, $\\text{rank}(A)=5$ and $\\text{rank}(E)=4.$\n\nTherefore, the correct answer is the matrix $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2de97f4-e366-599b-83d2-129fe88a95e1"] :db/ensure [:question/validate]} {:db/id "answer-field-e2de97f4-e366-599b-83d2-129fe88a95e1" :answer-field/id #uuid "e2de97f4-e366-599b-83d2-129fe88a95e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3832d573-dc8a-5fff-8a6f-0ff08e4abb46" :answer-field/choices ["answer-3832d573-dc8a-5fff-8a6f-0ff08e4abb46" "answer-711cd429-416c-5181-843f-682cf70b3ece" "answer-bca51055-1f1e-5521-bd01-c39592fb5371" "answer-3e5b22e8-a843-5061-9e8c-a7ec0e374b26" "answer-ecd8e36f-09e5-5476-92a0-43203761eee2"] :db/ensure [:answer-field/validate]} {:db/id "answer-3832d573-dc8a-5fff-8a6f-0ff08e4abb46" :answer/id #uuid "3832d573-dc8a-5fff-8a6f-0ff08e4abb46" :answer/type :answer.type/math :answer/value "A=[\\begin{aligned}1 & 2 & 1 & 3 & 0 \\\\ 0 & 3 & 2 & -5 & 12 \\\\ 