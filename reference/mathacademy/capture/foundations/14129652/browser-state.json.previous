  "live_records": {
    "q-79157": {
      "dom_id": "step-q79157",
      "name": "Question 1",
      "problem": "Let $B$ be a $4\\times 5$ matrix that has $3$ **pivot** columns. What is the rank of the matrix?",
      "worked_solution": "We know that $\\text{rank}(B)$ is the number of pivot columns in $B.$ \n\nSince we are told that $B$ has $3$ pivot columns, we have \n\n$$\n\\text{rank}(B)=3.\n$$",
