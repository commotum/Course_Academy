b/ref 17592186045417] [17592186479818 #edb/ref 1075 #edb/ref 17592186479653 #edb/ref 17592186045417] [17592186479818 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186479818 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186479818 #edb/ref 1078 #edb/ref 17592186479422 #edb/ref 17592186045417] [17592186479818 #edb/ref 1079 #uuid "f4498ce2-5816-50b4-b958-14ca5968f0b8" #edb/ref 17592186045417] [17592186479851 #edb/ref 1068 #edb/ref 17592186479764 #edb/ref 17592186045417] [17592186479851 #edb/ref 1069 "q-77997" #edb/ref 17592186045417] [17592186479851 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479851 #edb/ref 1071 "![](images/d6/d6a750225b9912b9b4735f5dbc0f8b0a8b63fbe7616405e0e53bff31d10fc61d.png)\n\nIn the diagram above,  $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and  ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" #edb/ref 17592186045417] [17592186479851 #edb/ref 1072 #uuid "4d5db12b-aca4-5679-a4bf-a23907fa0446" #edb/ref 17592186045417] [17592186479851 #edb/ref 1074 "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186479862 #edb/ref 1068 #edb/ref 17592186479803 #edb/ref 17592186045417] [17592186479862 #edb/ref 1069 "q-77952" #edb/ref 17592186045417] [17592186479862 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479862 #edb/ref 1071 "Given that $\\{i,j,k\\}$ is the standard basis of ${R}^{3}$ and that the images of $i,$ $j,$ and $k$ under the action of a linear transformation $T$ are $⟨1,-4,-1⟩,$ $⟨-3,-2,5⟩,$ and $⟨1,0,0⟩,$ respectively, what is the standard matrix of $T?$" #edb/ref 17592186045417] [17592186479862 #edb/ref 1072 #uuid "659a44e7-6c36-5b88-91e1-e77f6a2823f8" #edb/ref 17592186045417] [17592186479862 #edb/ref 1074 "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}1 & -3 & 1 \\\\ -4 & -2 & 0 \\\\ -1 & 5 & 0\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186479866 #edb/ref 1068 #edb/ref 17592186479818 #edb/ref 17592186045417] [17592186479866 #edb/ref 1069 "q-43831" #edb/ref 17592186045417] [17592186479866 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479866 #edb/ref 1071 "Given that $\\{i,j\\}$ is the standard basis of ${R}^{2}$ and that the images of $i$ and $j$ under the action of a linear transformation $T$ are $⟨-4,3⟩$ and $⟨5,0⟩$, respectively, what is the standard matrix of $T?$" #edb/ref 17592186045417] [17592186479866 #edb/ref 1072 #uuid "7db25f7d-3356-5632-8759-eb38fc83f21e" #edb/ref 17592186045417] [17592186479866 #edb/ref 1074 "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nTherefore, the standard matrix for this linear transformation is \n\n$$\nT=[\\begin{aligned}-4 & 5 \\\\ 3 & 0\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186479898 #edb/ref 1068 #edb/ref 17592186479807 #edb/ref 17592186045417] [17592186479898 #edb/ref 1069 "q-77951" #edb/ref 17592186045417] [17592186479898 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479898 #edb/ref 1071 "Given that $\\{i,j,k\\}$ is the standard basis of ${R}^{3}$ and that the images of $i,$ $j,$ and $k$ under the action of a linear transformation $T$ are $⟨1,-1,3⟩,$ $⟨-4,3,5⟩,$ and $⟨0,-3,1⟩,$ respectively, what is the standard matrix of $T?$" #edb/ref 17592186045417] [17592186479898 #edb/ref 1072 #uuid "e7e40f9d-527f-556e-806c-7a796edd693d" #edb/ref 17592186045417] [17592186479898 #edb/ref 1074 "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}1 & -4 & 0 \\\\ -1 & 3 & -3 \\\\ 3 & 5 & 1\\end{aligned}].\n$$" #edb/ref 17592186045417]}
