& -10 & -3 \\\\ 0 & 0 & 11 & -1 \\\\ 0 & 0 & 0 & -3\\end{aligned}].\n$$\n\nFinally, since ${l}_{41}=-2$ and ${u}_{33}=11,$ we get\n\n$$\n{l}_{41}\\cdot {u}_{33}=(-2)\\cdot 11=-22.\n$$"}] [{:db/id #edb/ref 17592186302334 :knowledge-point/_questions [{:db/id #edb/ref 17592186119885 :knowledge-point/id #uuid "e28bd3d9-649d-5cc3-a12e-e1f821caaf24" :knowledge-point/title "Finding the LU Factorization of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f75d8f5-95a0-575d-bf5b-8a950225640c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186300022} {:answer/id #uuid "1b8dae1a-4161-5391-bb7e-3c8f740a33ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186300089} {:answer/id #uuid "389608b6-9f5e-5b60-abd7-98607139d9c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300235} {:answer/id #uuid "4ebe4f92-863a-5315-b6cb-2db53229498e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186300373} {:answer/id #uuid "cf58a871-09ba-503d-af1f-bc8780ad8fd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186300996}] :answer-field/correct {:answer/id #uuid "389608b6-9f5e-5b60-abd7-98607139d9c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300235} :answer-field/id #uuid "3fbc3d08-c28b-5507-a81c-958a63ad9f3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0bc11750-a747-519f-92bc-e4276b877d58" :question/math-academy-id "q-32742" :question/problem "$$\nC=[\\begin{aligned}-1 & -2 & -2 \\\\ 4 & 2 & 1 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}]\n$$\n\nIf $C=LU$ is the LU decomposition of the matrix $C$ given above, what is the value of ${l}_{32}\\cdot {u}_{22}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $C$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}-1 & -2 & -2 \\\\ 4 & 2 & 1 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -2 & -2 \\\\ -4 & -6 & -7 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -2 & -2 \\\\ -4 & -6 & -7 \\\\ \\,\\,0\\,\\, & -\\frac{1}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}],\\,U=[\\begin{aligned}-1 & -2 & -2 \\\\ 0 & -6 & -7 \\\\ 0 & 0 & -3\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=-\\frac{1}{2}$ and ${u}_{22}=-6,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{22}=(-\\frac{1}{2})\\cdot (-6)=3.\n$$"}] [{:db/id #edb/ref 17592186479130 :knowledge-point/_questions [{:db/id #edb/ref 17592186119797 :knowledge-point/id #uuid "a86c24c2-97c2-534e-9c03-9735b031bb23" :knowledge-point/title "Finding the LU Factorization of a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "084731b6-abcd-5961-9a37-2ef7b52e1069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186478573} {:answer/id #uuid "28c444a0-0a8a-5797-85a0-cfab96c11f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478621} {:answer/id #uuid "5f54f013-a313-54f7-90d2-9ba7f58060ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186478696} {:answer/id #uuid "7a747a03-c2ae-51d2-aebb-940ddaae0961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186478740} {:answer/id #uuid "bf287ee3-99f4-5ce6-ac82-36fc56d0f69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186478868}] :answer-field/correct {:answer/id #uuid "28c444a0-0a8a-5797-85a0-cfab96c11f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186478621} :answer-field/id #uuid "7ed63d67-e255-5be1-823d-6cf879129aac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479007}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cebd5e32-1e9f-58eb-ba57-35dfca46f953" :question/math-academy-id "q-32748" :question/problem "$$\nB=[\\begin{aligned}3 & 5 & -6 & -2 \\\\ -9 & -16 & 16 & 3 \\\\ 0 & -4 & -3 & -11 \\\\ 0 & 5 & 10 & 17\\end{aligned}]\n$$\n\n \n\nIf $B=LU$ is the LU decomposition of the matrix $B$ given above, what is the value of ${l}_{42}\\cdot {u}_{34}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $B$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}3 & 5 & -6 & -2 \\\\ -9 & -16 & 16 & 3 \\\\ 0 & -4 & -3 & -11 \\\\ 0 & 5 & 10 & 17\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 5 & -6 & -2 \\\\ -3 & -1 & -2 & -3 \\\\ 0 & -4 & -3 & -11 \\\\ 0 & 5 & 10 & 17\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}3 & 5 & -6 & -2 \\\\ -3 & -1 & -2 & -3 \\\\ 0 & \\,\\,4\\,\\, & 5 & 1 \\\\ 0 & 5 & 10 & 17\\end{aligned}] & {R}_{4} & :={R}_{4}+5{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 5 & -6 & -2 \\\\ -3 & -1 & -2 & -3 \\\\ 0 & \\,\\,4\\,\\, & 5 & 1 \\\\ 0 & -5 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ -3 & 1 & 0 & 0 \\\\ 0 & 4 & 1 & 0 \\\\ 0 & -5 & 0 & 1\\end{aligned}],\\,U=[\\begin{aligned}3 & 5 & -6 & -2 \\\\ 0 & -1 & -2 & -3 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 2\\end{aligned}].\n$$\n\nFinally, since ${l}_{42}=-5$ and ${u}_{34}=1,$ we get\n\n$$\n{l}_{42}\\cdot {u}_{33}=(-5)\\cdot 1=-5.\n$$"}] [{:db/id #edb/ref 17592186302335 :knowledge-point/_questions [{:db/id #edb/ref 17592186119885 :knowledge-point/id #uuid "e28bd3d9-649d-5cc3-a12e-e1f821caaf24" :knowledge-point/title "Finding the LU Factorization of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e744601-b0f0-5c80-90b1-52f424880be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300010} {:answer/id #uuid "3356f367-46a8-5259-baf4-8992f15adc4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186300217} {:answer/id #uuid "33e7c7a9-e193-5761-8a7d-e1615296fe7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186300220} {:answer/id #uuid "55d34e98-fabd-5bc8-815f-0ec9c01d9998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300408} {:answer/id #uuid "a4a3d08a-fc50-5895-88e3-57cafeb804fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300792}] :answer-field/correct {:answer/id #uuid "55d34e98-fabd-5bc8-815f-0ec9c01d9998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300408} :answer-field/id #uuid "13417974-b035-52d3-865d-f3ffcc9608f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27eaf5c2-ea09-500f-97aa-b8eb299f8da3" :question/math-academy-id "q-32749" :question/problem "$$\nD=[\\begin{aligned}3 & 4 & 5 \\\\ -9 & -6 & -6 \\\\ -3 & -2 & -2\\end{aligned}]\n$$\n\nIf $D=LU$ is the LU decomposition of the matrix $D$ given above, what is the value of ${l}_{32}\\cdot {u}_{23}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $D$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}3 & 4 & 5 \\\\ -9 & -6 & -6 \\\\ -3 & -2 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -3 & -2 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+1{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -1 & 2 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -1 & \\,\\frac{1}{3}\\, & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ -1 & \\frac{1}{3} & 1\\end{aligned}],\\,U=[\\begin{aligned}3 & 4 & 5 \\\\ 0 & 6 & 9 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=\\frac{1}{3}$ and ${u}_{23}=9,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{23}=\\frac{1}{3}\\cdot 9=3.\n$$"}] [{:db/id #edb/ref 17592186120206 :knowledge-point/_questions [{:db/id #edb/ref 17592186119884 :knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24743710-ccae-5ce6-b9bd-ec3e3a56e15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-2,\\,3" :db/id #edb/ref 17592186402062} {:answer/id #uuid "d50d3f79-94d2-5665-9a7d-33432a11e564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,3" :db/id #edb/ref 17592186402063} {:answer/id #uuid "aa28f05d-2582-5b23-a7d7-5ac2da1040ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,1" :db/id #edb/ref 17592186402064} {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id #edb/ref 17592186402065} {:answer/id #uuid "4746c90f-6d0d-57b3-b8bf-7604a4ec6128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-2,\\,4" :db/id #edb/ref 17592186402066}] :answer-field/correct {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id #edb/ref 17592186402065} :answer-field/id #uuid "a81fb830-b280-555b-983a-34f12dd2e101" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402061}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce5c7307-c449-5fe7-8928-1317176c796c" :question/math-academy-id "q-32772" :question/problem "$$\n{{[\\begin{aligned}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{aligned}]}_{⏟}}_{A}={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot {{[\\begin{aligned}2 & 3 & -1 \\\\ \\boxed{} & \\boxed{} & \\boxed{} \\\\ 0 & 0 & -2\\end{aligned}]}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make $0$ at the position ${a}_{21}$ of the matrix $A,$ we proceed as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 3 & -1 \\\\ 0 & -5 & 4 \\\\ 4 & 6 & -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, from left to right, the elements from the second row of $U$ are $0,-5,$ and $4.$"}] [{:db/id #edb/ref 17592186120208 :knowledge-point/_questions [{:db/id #edb/ref 17592186119798 :knowledge-point/id #uuid "d216cc0e-58a7-5fab-b5fe-60c7656338cc" :knowledge-point/title "Finding Missing Numbers in the Matrix L of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84e2ddec-f20e-53a0-8f48-3a2e7c640f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186117410} {:answer/id #uuid "ad0b2ad4-5008-5a28-9baf-78629788dc19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186117411} {:answer/id #uuid "29d44870-1bac-5f1d-b5ed-9cc388140037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186117412} {:answer/id #uuid "429de2de-d947-585a-9e51-c40146bf674e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186117413} {:answer/id #uuid "7c1729d1-5eec-5401-bc05-8749723a55ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186117414}] :answer-field/correct {:answer/id #uuid "ad0b2ad4-5008-5a28-9baf-78629788dc19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186117411} :answer-field/id #uuid "95a8e23f-3ba8-5417-b280-b1146cb19862" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9544c436-69ea-5799-a310-14a5c40ac4f4" :question/math-academy-id "q-32805" :question/problem "$$\n{{[\\begin{aligned}3 & 2 & -5 \\\\ 12 & 9 & 0 \\\\ 9 & 7 & -12\\end{aligned}]}_{⏟}}_{A}={{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 3 & \\boxed{} & 1\\end{aligned}]}_{⏟}}_{L}\\cdot {{[\\begin{aligned}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 0 & -17\\end{aligned}]}_{⏟}}_{U}\n$$\n\nConsider the LU factorization of the matrix $A$ above. What is the value of the entry ${l}_{32}$ in the matrix $L?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make zeros below the main diagonal, we proceed as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}3 & 2 & -5 \\\\ 12 & 9 & 0 \\\\ 9 & 7 & -12\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 9 & 7 & -12\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we want to make $0$ at the position ${a}_{32}$ using Gaussian elimination. To do this, we take the $3$rd row of $A,$ and we add the $2$nd row of $A$ multiplied by $-1:$\n\n$$\n\\begin{aligned} & \\,\\,[\\begin{aligned}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 1 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}3 & 2 & -5 \\\\ 0 & 1 & 20 \\\\ 0 & 0 & -17\\end{aligned}]\\end{aligned}\n$$\n\nThe entry ${l}_{32}$ of the matrix $L$ is the factor next to ${R}_{2},$ taken with the opposite sign:\n\n$$\n{l}_{32}=-(-1)=1.\n$$"}]}
