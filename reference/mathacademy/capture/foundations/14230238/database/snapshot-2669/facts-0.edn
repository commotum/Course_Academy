})^{2}}{{5}^{2}} \\\\  & =1-\\frac{20}{25} \\\\  & =\\frac{25}{25}-\\frac{20}{25} \\\\  & =\\frac{5}{25}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡v & =\\pm \\sqrt{\\frac{5}{25}} \\\\  & =\\pm \\frac{\\sqrt{5}}{5}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡v=-\\frac{\\sqrt{5}}{5}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{15}}{4})(-\\frac{\\sqrt{5}}{5})-(\\frac{1}{4})(-\\frac{2\\sqrt{5}}{5}) \\\\  & =\\frac{5\\sqrt{3}}{20}+\\frac{2\\sqrt{5}}{20} \\\\  & =\\frac{5\\sqrt{3}+2\\sqrt{5}}{20}\\end{aligned}\n$$\n\nFinally, $a=5,b=2,$ and $a+b=7.$" #edb/ref 17592186045417] [17592186552460 #edb/ref 1068 #edb/ref 17592186552383 #edb/ref 17592186045417] [17592186552460 #edb/ref 1069 "q-141441" #edb/ref 17592186045417] [17592186552460 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186552460 #edb/ref 1071 "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{cos}⁡u=\\frac{5}{7},\\,\\operatorname{sin}⁡u=-\\frac{2\\sqrt{6}}{7},\\,\\operatorname{cos}⁡v=-\\frac{1}{2}.\n$$\n\nGiven that $v$ lies in the third quadrant, and\n\n$$\n\\operatorname{cos}⁡(u+v)=-\\frac{a\\sqrt{2}+b}{14},\n$$\n\ncalculate the value of $a+b.$" #edb/ref 17592186045417] [17592186552460 #edb/ref 1072 #uuid "77e70b3f-8704-511e-87c9-d67cfcbe9ec9" #edb/ref 17592186045417] [17592186552460 #edb/ref 1074 "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{cos}⁡u,$ $\\operatorname{sin}⁡u,$ and $\\operatorname{cos}⁡v.$ To find the missing value of $\\operatorname{sin}⁡v,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡v+{cos}^{2}⁡v=1\\,⟹\\,{sin}^{2}⁡v=1-{cos}^{2}⁡v\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡v & =1-{cos}^{2}⁡v \\\\  & =1-{(-\\frac{1}{2})}^{2} \\\\  & =1-\\frac{1}{{2}^{2}} \\\\  & =1-\\frac{1}{4} \\\\  & =\\frac{4}{4}-\\frac{1}{4} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡v & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe're given that $v$ lies in the third quadrant, where sine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{sin}⁡v=-\\frac{\\sqrt{3}}{2}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(\\frac{5}{7})(-\\frac{1}{2})-(-\\frac{2\\sqrt{6}}{7})(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{5}{14}-\\frac{6\\sqrt{2}}{14} \\\\  & =-\\frac{6\\sqrt{2}+5}{14}\\end{aligned}\n$$\n\nFinally, $a=6,b=5,$ and $a+b=11.$" #edb/ref 17592186045417] [17592186552478 #edb/ref 1068 #edb/ref 17592186552348 #edb/ref 17592186045417] [17592186552478 #edb/ref 1069 "q-143842" #edb/ref 17592186045417] [17592186552478 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186552478 #edb/ref 1071 "Suppose that for the angles $u$ and $v,$ we have \n\n$$\n\\operatorname{sin}⁡u=\\frac{4}{5},\\,\\operatorname{cos}⁡u=\\frac{3}{5},\\,\\operatorname{sin}⁡v=\\frac{2\\sqrt{2}}{3}.\n$$\n\nGiven that $v$ lies in the first quadrant, find the value of $\\operatorname{cos}⁡(u-v).$" #edb/ref 17592186045417] [17592186552478 #edb/ref 1072 #uuid "97e789b8-dcb1-527a-b969-3a0ccc1e1111" #edb/ref 17592186045417] [17592186552478 #edb/ref 1074 "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorn