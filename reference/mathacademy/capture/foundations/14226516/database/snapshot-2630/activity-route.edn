#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186545931} :activity/id #uuid "3acbe0bd-f475-593d-b042-bf6068b13815" :activity/scope {:db/id #edb/ref 17592186048997 :topic/id #uuid "d20a7fc8-1ce1-5256-b63f-ebdb4499588c" :topic/math-academy-id 2053} :activity/steps [{:db/id #edb/ref 17592186545903 :step/content {:db/id #edb/ref 17592186281297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8b5270-0b9e-58a2-b38b-c3790a1d138e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186278886} {:answer/id #uuid "539c47eb-4e33-5a30-8709-954ebe399f2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186279352} {:answer/id #uuid "66acf6b9-46c7-5698-bd66-ee1438fb10b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186279522} {:answer/id #uuid "a07dafa9-e281-5089-8e13-5ee1c80e5bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186280017} {:answer/id #uuid "b24bc621-c454-5e2f-9a35-a4af21e6cb9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186280166}] :answer-field/correct {:db/id #edb/ref 17592186278886} :answer-field/id #uuid "5d9404cc-4df0-50a5-9ff1-a9c703daf425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280996}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "45246a73-90c4-530d-b058-98109082ad22" :question/math-academy-id "q-161685" :question/problem "Find the volume of the solid region enclosed by the $xz$-plane and the surface $y=5-3{z}^{2},$ and the planes $x=0,$ $x=1,$ $z=-1,$ $z=0.$" :question/worked-solution "Notice that our solid can be written as a type III region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,-1\\le z\\le 0,\\,\\,0\\le y\\le 5-3{z}^{2}\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}{\\int }_{0}^{5-3{z}^{2}}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}[y]_{y=0}^{y=5-3{z}^{2}}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}5-3{z}^{2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}[5z-{z}^{3}]_{z=-1}^{z=0}\\,dx \\\\  & ={\\int }_{0}^{1}0-(5(-1)-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{1}5-1\\,dx \\\\  & =4{\\int }_{0}^{1}dx \\\\  & =4[x]_{x=0}^{x=1} \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "2c68a282-fb8d-5473-b214-328eb1dfb504" :step/next {:db/id #edb/ref 17592186545959}} {:db/id #edb/ref 17592186545931 :step/content {:db/id #edb/ref 17592186129762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85287494-343a-5f08-8ce3-ddb465ec63b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186128054} {:answer/id #uuid "95b618bf-4be2-55d9-bc12-c665f2e6b2d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186128055} {:answer/id #uuid "9b237bdf-4e5a-52ce-8767-7d03eb67eccd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{2}" :db/id #edb/ref 17592186128056} {:answer/id #uuid "ec24a157-5b5e-5058-9e5e-049671ca1051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186128057} {:answer/id #uuid "49464d90-4a8f-5d53-9d01-28c5d5654e10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186128058}] :answer-field/correct {:db/id #edb/ref 17592186128058} :answer-field/id #uuid "1adf921f-3910-55f5-9228-74e4653b36b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128053}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58e657fe-ad6a-53ef-9cfa-164db29f5116" :question/math-academy-id "q-40312" :question/problem "![](images/c2/c24eb387b430ae40e7c5ec0747eb8570df21ebbe4535fd1305676219ad5c83f1.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/d0/d00feacd712c1ca185a8975e8b6343f9937f254631614242003f1d76c1427ffe.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2+y-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/59/59b7304dcc07ac38c093b7d8d29d4b4079f192cd9fd0385db9f1981e4640eceb.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2,\\,\\,0\\le x\\le 2+y-z\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{2+y-z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}[x]_{x=0}^{x=2+y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(2+y-z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2+y-z\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{[(2+y)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dy \\\\  & ={\\int }_{0}^{3}((2+y)(2)-\\frac{{2}^{2}}{2})-0\\,dy \\\\  & ={\\int }_{0}^{3}2+2y\\,dy \\\\  & =[2y+{y}^{2}]_{y=0}^{y=3} \\\\  & =(2(3)+{3}^{2})-0 \\\\  & =15.\\end{aligned}\n$$"} :step/id #uuid "5f678a58-ebc6-50b7-bfbb-3b3bd2f77536" :step/next {:db/id #edb/ref 17592186545981}} {:db/id #edb/ref 17592186545959 :step/content {:db/id #edb/ref 17592186235408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1131cf03-59d7-52b7-a961-e57867699e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-{y}^{2}-4{z}^{2}" :db/id #edb/ref 17592186234565} {:answer/id #uuid "56b94ec6-98a3-5534-b3fb-6cf915cc915b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}-2{y}^{2}+4{z}^{2}" :db/id #edb/ref 17592186234682} {:answer/id #uuid "71dd748e-5518-5244-b3e8-24b94c177871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-3{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186234717} {:answer/id #uuid "b7a2151f-a2c5-5515-b414-6ee4b6cdf444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-2{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186234826} {:answer/id #uuid "e67bf2ad-b6cd-5894-bb82-3d92ee92c03e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+6{y}^{2}-4{z}^{2}" :db/id #edb/ref 17592186234907}] :answer-field/correct {:db/id #edb/ref 17592186234826} :answer-field/id #uuid "66b28244-bc08-5da0-8ef2-5ba05c93c8db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186235081}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0df5261b-5237-5119-912e-df4a2c80b73e" :question/math-academy-id "q-161715" :question/problem "Consider the solid enclosed between the paraboloid $x=-2+{y}^{2}+4{z}^{2}$ and the parabolic cylinder $x=-1+2{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-2+{y}^{2}+4{z}^{2} & =-1+2{z}^{2} \\\\ {y}^{2}+2{z}^{2} & =1 \\\\ {y}^{2}+2{z}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,-2+{y}^{2}+4{z}^{2}\\le x\\le -1+2{z}^{2}\\},\n$$\n\nwhere $D$ is the interior of the ellipse ${y}^{2}+2{z}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-2+{y}^{2}+4{z}^{2}}^{-1+2{z}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(-1+2{z}^{2})-(-2+{y}^{2}+4{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{1-{y}^{2}}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{1-{y}^{2}}{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{(1-{y}^{2})/2}}^{\\sqrt{(1-{y}^{2})/2}}\\,1-{y}^{2}-2{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+{(\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =\\frac{1-{y}^{2}}{2}+\\frac{1-{y}^{2}}{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =2-2{y}^{2}-2{z}^{2}.\\end{aligned}\n$$"} :step/id #uuid "a29fc4a4-b0fb-5b9b-a936-4edfa87ff06b" :step/next {:db/id #edb/ref 17592186545972}} {:db/id #edb/ref 17592186545972 :step/content {:db/id #edb/ref 17592186281316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00df58ac-ae19-5439-acd9-c31097afed15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186278591} {:answer/id #uuid "48cff7f4-cd5b-57fd-b9dd-13586d249b89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186279241} {:answer/id #uuid "732667ef-9f60-5d95-8202-d7d8f147202b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186279637} {:answer/id #uuid "adbfe291-1ad7-5bd3-9a75-fd6dcb2faa31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280129} {:answer/id #uuid "ff7f58e5-5448-5e72-80b2-ebe69b806f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186280829}] :answer-field/correct {:db/id #edb/ref 17592186279637} :answer-field/id #uuid "8472cdd0-f6c1-5f91-9a65-fe36f92148f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281072}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "28a17934-c155-5435-8a27-ac142e1e8af3" :question/math-academy-id "q-161742" :question/problem "![](images/77/770cdf03e988f811ccc3ff805889cef55304b01b6e8009e25ba128fbdbb89066.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/8e/8e5f3095cac4e068e54d9b3ac2bb55dc4789e7ca68d4524dce4d25a55abd5be6.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 4-2x-4z\\},\n$$\n\nwhere $D$ is the projection of $R$ onto the $xz$-plane.\n\nTo find the top boundary curve of $D$ in the form $z=z(x),$ we substitute $y=0$  into the equation $y=4-2x-4z:$\n\n$$\n0=4-2x-4z\\,⟹\\,z=1-\\frac{x}{2}\n$$\n\nThen, we have\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2}\\},\n$$\n\nas shown below.\n\n![](images/76/76fcca4251a904a08ac2f6ba8181d92c2c2fa7e07e596ef6276f1d21b574817a.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2},\\,\\,0\\le y\\le 4-2x-4z\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}{\\int }_{0}^{4-2x-4z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}[y]_{y=0}^{y=4-2x-4z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}(4-2x-4z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}4-2x-4z\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[(4-2x)z-2{z}^{2}]}_{z=0}^{z=1-x/2}\\,dx \\\\  & ={\\int }_{0}^{2}((4-2x)(1-\\frac{x}{2})-2{(1-\\frac{x}{2})}^{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}(1-\\frac{x}{2})((4-2x)-2(1-\\frac{x}{2}))\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(2-x)(2-x)\\,dx \\\\  & ={\\int }_{0}^{2}2-2x+\\frac{{x}^{2}}{2}\\,dx \\\\  & ={[2x-{x}^{2}+\\frac{{x}^{3}}{6}]}_{x=0}^{x=2} \\\\  & =(2(2)-{2}^{2}+\\frac{{2}^{3}}{6})-0 \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"} :step/id #uuid "b8e034ac-74ed-5ee7-86d4-526d9fcddec2"} {:db/id #edb/ref 17592186545981 :step/content {:db/id #edb/ref 17592186129766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aa5673c-b507-5eb0-b945-e8326bea0f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{2}" :db/id #edb/ref 17592186412098} {:answer/id #uuid "6e45224d-66f6-5baf-b658-0f0390c00d1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186412117} {:answer/id #uuid "b950298e-588d-50e8-91e2-a245f827cbf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186412145} {:answer/id #uuid "e74dcd89-af2d-524e-810b-cae923b4eb4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{93}{2}" :db/id #edb/ref 17592186412162} {:answer/id #uuid "f4c2ff78-cfe5-5246-b9cd-7e49b93095ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186412167}] :answer-field/correct {:db/id #edb/ref 17592186412145} :answer-field/id #uuid "27c4624f-447a-5116-b81e-664c77c5bd9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fac0ad3-f7f8-517d-a7fd-3686f90064e2" :question/math-academy-id "q-40396" :question/problem "Find the volume of the solid region enclosed by the $yz$-plane, the surface $x=6yz+12,$ and the planes $y=0,$ $y=2,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 6yz+12\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{6yz+12}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[x]_{x=0}^{x=6yz+12}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(6yz+12)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}6yz+12\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}[3y{z}^{2}+12z]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{2}(3y(1)^{2}+12(1))-0\\,dy \\\\  & ={\\int }_{0}^{2}3y+12\\,dy \\\\  & ={[\\frac{3}{2}{y}^{2}+12y]}_{y=0}^{y=2} \\\\  & =\\frac{3}{2}({2}^{2}-0)+12(2-0) \\\\  & =30.\\end{aligned}\n$$"} :step/id #uuid "c60f261b-2160-5d1d-a644-128afd94f52c" :step/next {:db/id #edb/ref 17592186545903}}] :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545184}]}
