#{[{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186130098} :activity/id #uuid "8ed94446-a68c-54d6-8877-20405d94dc8c" :activity/scope {:db/id #edb/ref 17592186048997 :topic/id #uuid "d20a7fc8-1ce1-5256-b63f-ebdb4499588c" :topic/math-academy-id 2053} :activity/steps [{:db/id #edb/ref 17592186130098 :step/content {:db/id #edb/ref 17592186130410 :tutorial/content "Recall that the double Integral of the function $f(x,y) = 1$ over a domain $D\\subset \\mathbb R^2$ is simply the area of $D\\mathbin{:}$\n\n$$\n\\textrm{Area}\\ \\!(D) = \\displaystyle \\iint\\limits_{D} 1 \\cdot \\textrm d A = \\displaystyle \\iint\\limits_{D}  \\ \\textrm d A\n$$\n\nWe have a similar result for triple integrals:\n\n*If $R$ is a region in three-dimensional space, then the volume of $R$ is given by*\n\n$$\n\\textrm{Volume}(R) = \\iiint\\limits_{R} \\textrm{d}V.\n$$\n\nIn other words, the volume of $R$ equals the triple integral of the function $f(x,y,z)=1$ over $R.$ \n\nFor example, let's use triple integrals to find the volume of the rectangular prism shown below.\n\n![](images/8f/8f9ab5db03f1cdf84ef484aca1ab89995237e7ef333c9b7c563d0080d317e981.png)\n\n \n\nNotice that our solid can be written in set-builder notation as\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: 0 \\leq x \\leq 1, \\:\\: 0 \\leq y \\leq 2, \\:\\: 0 \\leq z \\leq 3 \\big\\}.\n$$\n\nTherefore, the volume of $R$ is \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{3}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}dx\\cdot {\\int }_{0}^{2}dy\\cdot {\\int }_{0}^{3}dz \\\\  & =(1-0)\\cdot (2-0)\\cdot (3-0) \\\\  & =6.\\end{aligned}\n$$\n\n**Note:** We get the same value using the formula for the volume of a rectangular prism:\n\n$$\n\\begin{aligned}V & =\\text{length}\\cdot \\text{width}\\cdot \\text{height} \\\\  & =1\\cdot 2\\cdot 3 \\\\  & =6\\end{aligned}\n$$\n\nLet's see some more examples." :tutorial/id #uuid "8b8f4748-190d-5fda-9a83-139e6a994d94" :tutorial/math-academy-id 4911 :tutorial/title "Introduction"} :step/id #uuid "f8517a18-fa1d-5284-b1cb-8c87ef3c4a7f" :step/math-academy-id 657225 :step/next {:db/id #edb/ref 17592186130099}} {:db/id #edb/ref 17592186130099 :step/content {:db/id #edb/ref 17592186129205 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129024 :question/id #uuid "7dcea6be-fd16-5312-b50c-157bafcc2d65" :question/math-academy-id "e-8189"} :knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050165} {:db/id #edb/ref 17592186050197} {:db/id #edb/ref 17592186050524}] :knowledge-point/questions [{:db/id #edb/ref 17592186129763} {:db/id #edb/ref 17592186129764} {:db/id #edb/ref 17592186281285} {:db/id #edb/ref 17592186281286} {:db/id #edb/ref 17592186281287} {:db/id #edb/ref 17592186281288} {:db/id #edb/ref 17592186412195} {:db/id #edb/ref 17592186412201} {:db/id #edb/ref 17592186412202} {:db/id #edb/ref 17592186412205} {:db/id #edb/ref 17592186412210} {:db/id #edb/ref 17592186521539}] :knowledge-point/title "Finding the Volume of a Solid Given in Set Notation"} :step/id #uuid "5606b802-fe70-5ed7-9a0d-af46a1e7bdb7" :step/math-academy-id 657226 :step/next {:db/id #edb/ref 17592186130100}} {:db/id #edb/ref 17592186130100 :step/content {:db/id #edb/ref 17592186129206 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129025 :question/id #uuid "b0ad2f24-6f0c-5d66-9312-5e41840b4fe5" :question/math-academy-id "e-8190"} :knowledge-point/id #uuid "43198aae-a4dd-5b79-803a-1bb625a96355" :knowledge-point/questions [{:db/id #edb/ref 17592186129762} {:db/id #edb/ref 17592186129765} {:db/id #edb/ref 17592186235536} {:db/id #edb/ref 17592186281299} {:db/id #edb/ref 17592186281300} {:db/id #edb/ref 17592186281301} {:db/id #edb/ref 17592186281314} {:db/id #edb/ref 17592186281316} {:db/id #edb/ref 17592186281606} {:db/id #edb/ref 17592186412194} {:db/id #edb/ref 17592186412197} {:db/id #edb/ref 17592186412200} {:db/id #edb/ref 17592186412207} {:db/id #edb/ref 17592186412209} {:db/id #edb/ref 17592186433113} {:db/id #edb/ref 17592186521466}] :knowledge-point/title "Finding the Volume of a Solid Given a Diagram"} :step/id #uuid "10a0d833-bae3-51f0-86fa-4e40e909b391" :step/math-academy-id 657230 :step/next {:db/id #edb/ref 17592186362451}} {:db/id #edb/ref 17592186130101 :step/content {:db/id #edb/ref 17592186129207 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129026 :question/id #uuid "7883263b-110b-558f-83b2-0f6ec28be2c5" :question/math-academy-id "e-8191"} :knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd" :knowledge-point/questions [{:db/id #edb/ref 17592186129703} {:db/id #edb/ref 17592186129766} {:db/id #edb/ref 17592186281292} {:db/id #edb/ref 17592186281293} {:db/id #edb/ref 17592186281294} {:db/id #edb/ref 17592186281295} {:db/id #edb/ref 17592186281296} {:db/id #edb/ref 17592186281297} {:db/id #edb/ref 17592186412193} {:db/id #edb/ref 17592186412199} {:db/id #edb/ref 17592186412204} {:db/id #edb/ref 17592186433111}] :knowledge-point/title "Finding the Volume of a Solid Given a Description"} :step/id #uuid "920555d7-5a28-5187-9ea9-a47f47e41429" :step/math-academy-id 657235 :step/next {:db/id #edb/ref 17592186362454}} {:db/id #edb/ref 17592186362442 :step/content {:db/id #edb/ref 17592186235284 :knowledge-point/canonical-example {:db/id #edb/ref 17592186234975 :question/id #uuid "4031c8a9-0559-5d8d-a1a5-6e3402c19b27" :question/math-academy-id "e-26133"} :knowledge-point/id #uuid "13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions [{:db/id #edb/ref 17592186235405} {:db/id #edb/ref 17592186235406} {:db/id #edb/ref 17592186235407} {:db/id #edb/ref 17592186235408} {:db/id #edb/ref 17592186235409} {:db/id #edb/ref 17592186235410} {:db/id #edb/ref 17592186235411} {:db/id #edb/ref 17592186412196} {:db/id #edb/ref 17592186412198} {:db/id #edb/ref 17592186412203} {:db/id #edb/ref 17592186412206} {:db/id #edb/ref 17592186412208} {:db/id #edb/ref 17592186433112}] :knowledge-point/title "Finding a Double-Integral Formula for Volume"} :step/id #uuid "00c1d246-4d5e-5f8e-b7d4-2c141141c41f" :step/math-academy-id 657240} {:db/id #edb/ref 17592186362444 :step/content {:db/id #edb/ref 17592186362410 :tutorial/content "Consider the volume of the solid region enclosed by the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane, the plane ![](images/af/af57fba1cdb37044c8a4f922ba0ce95fcae5347960e050ac391af840198aca28.svg) and the planes ![](images/89/89c97ad93c125fc2b6f61d44fe9a90845fd289329d79d506c857f970d7586540.svg) ![](images/48/480183a1321e5b4fdff9500a551818f6fb0ab2713c0fdd8fa9df88a640394af9.svg) ![](images/8d/8de04eef03bf4f5fd455bcd39f1d747bc5e38650a1f8c6dd5249166cf5fc022d.svg) and ![](images/ca/ca7dadeea1df352335554e1c48b6398167035636994354744737e4c75a1b0134.svg)\n\nNotice that our solid can be written as a type I region.\n\nFirst, the phrase **enclosed by the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane** tells us that the bottom of the solid is\n![](images/ef/efcfb7a56c85727ded8a9d5c9bd75fd79ac0bc20ba202c2da6aaca3c4e3ba503.svg)\n\nThe plane\n![](images/21/211cfe0529803c8450173dbcaa60c66f276389b5944047bc390738703f657309.svg)\nis the top of the solid.\n\nAlso, the planes\n![](images/a3/a3fe77f111727e68d20276851f67f7fc662eaea5df49eaf96695a9234f6304bf.svg)\ndescribe the projection of the solid onto the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane. So the base region is the rectangle\n![](images/59/5925cb0d118a2a3457f4683c7b38bfa59bc5e8bbc106af32f0364a0207f9af25.svg)\n\nTherefore, for each point ![](images/e7/e76592a69e19fffc93e0e39005deba219d59736a203a18c95ebbe2496bd772a7.svg) in this rectangle, the variable ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg) runs from the bottom surface to the top surface:\n![](images/b1/b1af88023edd0b854bb6b598521693ebf4e941d8a5567e6801801f1deeacb902.svg)\n\nSo the volume is\n![](images/bd/bd9acbbd0fb9472aafdc28fe38d7cf6a103c123ff999116cefca75f8dbf624a8.svg)\n\nNow we evaluate:\n\n![](images/fa/fa67106261e7d847a0be115b74ca3ebaa5d5aff7ceca30b0b94b950fb1b741cd.svg)\n\nTherefore, the volume of the solid is ![](images/85/85ab4d14e4ae710116ac84de4b03b3cf35723ab969b7abfba97889c497974147.svg)\n\nIn problems like this, the planes involving only ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) usually describe the base region in the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane, while the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane and the surface or plane involving ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg) describe the lower and upper bounds for ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg)." :tutorial/id #uuid "ca3b6881-db7f-536a-b48b-77adde0a1b19" :tutorial/math-academy-id 15981 :tutorial/title "Setting Up Volume from a Verbal Description"} :step/id #uuid "151541fd-37a6-5cc8-a5fc-bc2d3ff14d79" :step/math-academy-id 657234 :step/next {:db/id #edb/ref 17592186130101}} {:db/id #edb/ref 17592186362447 :step/content {:db/id #edb/ref 17592186362411 :tutorial/content "Alternatively, we can conceptualize the volume of a solid using a **triple integral**. \n\nRevisiting the previous example enclosed between the paraboloids, our solid can be formally written as a 3D region:\n![](images/17/17cee1ab33ee8dcd73e0c3a0151c563a6c64ca1c898383dbbca4d8ac7f1e0ff5.svg)\n\nThis means that for each point ![](images/e7/e76592a69e19fffc93e0e39005deba219d59736a203a18c95ebbe2496bd772a7.svg) in the projection region ![](images/87/87e7e0743ecd6609730f4b9a9b3681b1f360ca86bcb209e03561a197b18782f3.svg) the variable ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg) runs from the lower surface \n![](images/6a/6a37b724b57c8f5650e5970d1f90da49fe6a482582c7776aa567d41c2f6c406b.svg)\nup to the upper surface \n![](images/58/585d8d094c7eea9f1d7b242bebd015c27b39692e2cddbbaa76c0a87ce65b3ea5.svg)\n\nThe volume of ![](images/08/085f4d77675f3cb7323d94feaa9eaa38f2fecb26c0f8483895f9ddf36b8d319d.svg) is given by evaluating a triple integral of ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) over the region. By computing the innermost integral with respect to ![](images/90/9032cb23a878659e74b670d3779a8cd4793b28af921eab1a6b3f2041a815e03b.svg), this calculation logically reduces to the double integral formula:\n![](images/8e/8e024d3e6c21346148c18139918dc5780683039bb34749489e188740ec3fa836.svg)\n\nIf we write ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) using ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) as the outer variable, then\n![](images/d4/d4cdea1370f4184ff8a5387dd95ed1cedd1b81d6027c32eea9240549d0dff0a4.svg)\nso\n![](images/10/109e5d163609178b9c69ae87bd236d3e0a8830157556082f92f2933c8b6d215b.svg)" :tutorial/id #uuid "ea755805-d530-504f-965f-afb35bf9a5b0" :tutorial/math-academy-id 15983 :tutorial/title "Connecting Triple Integrals and Double Integrals for Volume"} :step/id #uuid "8287853b-9ed9-5b6c-be64-14f1c8c00238" :step/math-academy-id 657239 :step/next {:db/id #edb/ref 17592186362442}} {:db/id #edb/ref 17592186362451 :step/content {:db/id #edb/ref 17592186362409 :tutorial/content "When a solid is described in words, we first identify its bounding surfaces and then decide how to describe the entire region with inequalities.\n\nA useful strategy is:\n\n- identify the variable that lies between a lower surface and an upper surface,\n\n- determine the projection of the solid onto a coordinate plane,\n\n- write bounds for the projected region,\n\n- use those bounds to set up a triple integral with integrand equal to ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg).\n\nIn many volume problems, the solid lies between a bottom surface\n![](images/8e/8eeea9a9caa745d87342df718b249603d257e35820bea2df1f1d647d61877c0c.svg)\nand a top surface\n![](images/21/211a455fb9c563450b5b5225f0d3615467c89870e467920ad73beacb802375b8.svg)\n\nIn that case, we describe the solid by\n![](images/eb/eb36f1bb66ca8c06c73de972395684c368cc3cdba4d05b9300dee9f852c3174b.svg)\nwhere ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) is the projection of the solid onto the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane.\n\nSo, to find the volume, we use\n![](images/c6/c6fd71393350dac5cd3d1067227863cab1e92534812ea083231408ce660143bf.svg)\n\nSo, the verbal description tells us two things:\n\n- which surface is below and which is above,\n\n- which points ![](images/e7/e76592a69e19fffc93e0e39005deba219d59736a203a18c95ebbe2496bd772a7.svg) belong to the base region ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg).\n\nBefore integrating, it is always a good idea to check that the upper surface is actually above the lower surface on the entire projected region." :tutorial/id #uuid "8f80f606-7a23-56be-8c78-48b9eeaa0fd7" :tutorial/math-academy-id 15980 :tutorial/title "Interpreting a Verbal Description of a Solid"} :step/id #uuid "c05a1568-2d05-5343-8282-ea2d803952c6" :step/math-academy-id 657233 :step/next {:db/id #edb/ref 17592186362444}} {:db/id #edb/ref 17592186362454 :step/content {:db/id #edb/ref 17592186362412 :tutorial/content "Sometimes a solid is enclosed between two surfaces. In these cases, we can compute its volume using a double integral over the projection region in the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane.\n\nSuppose a solid is enclosed between the paraboloids\n![](images/7b/7b63c2c4326ca1b7c5001ce0fbed7a7f0e4c5f54a8b4b26eca446f2b2b65dfa5.svg)\n\nTo compute its volume, we use\n![](images/83/83fed741dc600a6aa368543b2522f90191579e318c653b03a6924fc9ffa1868d.svg)\nwhere ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) is the projection region in the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane.\n\nFirst, we find where the two surfaces intersect. This gives the boundary of the projection region in the ![](images/39/39303ee53d6cd0a654e183557bb493fd0ba5b887f96f5d7d871a9be772ce1808.svg)-plane:\n![](images/3d/3d710d141ba98ae84f8c82b8ba0233781fa3627b639857710981c6c657fac203.svg)\n\nSo, the projection region ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) is the disk\n![](images/d5/d5eef3331fa2e621c6a523f562fc759540299b92a24dfb1502b0d73c11377157.svg)\n\nThe height of the solid is the difference between the upper surface (![](images/cd/cdac8cf874dd0689e35a1c8d1a790bd5279d33ca80f0fd6fb4a2034e4a8b35f4.svg)) and the lower surface (![](images/69/6963e5988546516a47de0a33528be8c2c1b4626d97d9730e8bb950aa9100fe92.svg)):\n![](images/50/50c6958184049a24a56265775b5500b62bac9face27b2893824ed7d1b58d70ec.svg)\n\nIf we write ![](images/59/5914524b1d3db63c66998b75ca1d00a5dc4e294d2a8f10fe384d2b2ebf2af38e.svg) using ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) as the outer variable, then\n![](images/67/671080e239a3f478bcd6b47f0b6b31bdd3bef18de65edc92ac956d4a5cf07683.svg)\n\nThe volume is given by the iterated integral:\n![](images/18/180f43f3029d64ca0fe7971d108167a900d05ddbaa9aed0e017e3ef85cf2c279.svg)" :tutorial/id #uuid "efa958a5-e1ae-5402-b9a3-980b67367758" :tutorial/math-academy-id 15982 :tutorial/title "Using a Projection Region to Set Up a Double Integral"} :step/id #uuid "e2570f57-bf8b-5b23-afe2-d29bc994397c" :step/math-academy-id 657238 :step/next {:db/id #edb/ref 17592186362447}}] :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129386}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186433116} :activity/id #uuid "0bc8f6b6-23d6-5738-be30-08a0c3cfbf5e" :activity/scope {:db/id #edb/ref 17592186048997 :topic/id #uuid "d20a7fc8-1ce1-5256-b63f-ebdb4499588c" :topic/math-academy-id 2053} :activity/steps [{:db/id #edb/ref 17592186433114 :step/content {:db/id #edb/ref 17592186433111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d76d167-e492-51ee-9cfd-8d82c4f98110" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17}{9}" :db/id #edb/ref 17592186433096} {:answer/id #uuid "73bbbd95-9078-522a-a479-9f6cd50aa8e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186433097} {:answer/id #uuid "75ef54fd-3fd5-53a2-9cc3-b6d5ef0e7696" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{6}" :db/id #edb/ref 17592186433099} {:answer/id #uuid "89078605-cf1e-5560-98b3-4b7333c47f0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186433101} {:answer/id #uuid "8f882acc-8e4c-55d3-b6d7-84fb97565dbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186433103}] :answer-field/correct {:db/id #edb/ref 17592186433103} :answer-field/id #uuid "a2bfe536-1acc-532a-b70b-2b468372d22d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433109}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6188e65a-2be8-551f-95a7-3b11de49478d" :question/math-academy-id "q-163119" :question/problem "Find the volume of the solid region enclosed by the plane $x=-2,$ the surface $x={z}^{2}+y,$ and the planes $y=0,$ $y=2,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,-2\\le x\\le {z}^{2}+y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{-2}^{{z}^{2}+y}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[x]_{x=-2}^{x={z}^{2}+y}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{z}^{2}+y-(-2)\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{z}^{2}+y+2\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{3}{z}^{3}+(y+2)z]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{2}\\frac{1}{3}+y+2\\,dy \\\\  & ={\\int }_{0}^{2}\\frac{7}{3}+y\\,dy \\\\  & ={[\\frac{7}{3}y+\\frac{1}{2}{y}^{2}]}_{y=0}^{y=2} \\\\  & =\\frac{7}{3}\\cdot 2+\\frac{1}{2}\\cdot {2}^{2}-0 \\\\  & =\\frac{20}{3}\\end{aligned}\n$$"} :step/id #uuid "15cb8356-aeba-5ea0-a7ab-4e524fdb6298"} {:db/id #edb/ref 17592186433115 :step/content {:db/id #edb/ref 17592186433113 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5239f75a-0829-5cc8-a34d-c4a20eabec56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186433094} {:answer/id #uuid "87567b3e-7270-57b1-acc7-cab013de2d09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186433100} {:answer/id #uuid "8d0c5b03-77db-5e64-8a51-12b2e2349e9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186433102} {:answer/id #uuid "9c1e2b57-9bf1-517e-ac51-8b35d51e8bb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186433104} {:answer/id #uuid "ffc1ff97-663c-52fc-b66c-d6dbd7166ad9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186433107}] :answer-field/correct {:db/id #edb/ref 17592186433100} :answer-field/id #uuid "678a936d-2d59-5cda-bb5b-7ba53ed50f15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433108}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8fb4dc8a-610a-5632-95eb-19ebf2c9f8b3" :question/math-academy-id "q-161697" :question/problem "![](images/a0/a0ad9cb5ea68b0018680d57d86d88a8dfcf7581a238e9368f566b2396f119579.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/d7/d72b3c8aac80a46894d2b7c0c4956ced9eb5b4ebd663b73ba86096550e993bb8.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3+\\frac{x}{3}-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 3,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/a2/a2dbcefff1b7c28156f117b012c522dd65bca1c1ddd9e2bac4bf2e6ea1ce3722.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 3,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 3+\\frac{x}{3}-z\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{3+x/3-z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}[y]_{y=0}^{y=3+x/3-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(3+\\frac{x}{3}-z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}3+\\frac{x}{3}-z\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{[(3+\\frac{x}{3})z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{3}((3+\\frac{x}{3})(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{3}4+\\frac{2x}{3}\\,dx \\\\  & ={[4x+\\frac{{x}^{2}}{3}]}_{x=0}^{x=3} \\\\  & =(12+3)-0 \\\\  & =15.\\end{aligned}\n$$"} :step/id #uuid "3af6cb17-64ea-5a89-8d5c-b4cd183ea4db" :step/next {:db/id #edb/ref 17592186433118}} {:db/id #edb/ref 17592186433116 :step/content {:db/id #edb/ref 17592186129762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85287494-343a-5f08-8ce3-ddb465ec63b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186128054} {:answer/id #uuid "95b618bf-4be2-55d9-bc12-c665f2e6b2d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186128055} {:answer/id #uuid "9b237bdf-4e5a-52ce-8767-7d03eb67eccd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{2}" :db/id #edb/ref 17592186128056} {:answer/id #uuid "ec24a157-5b5e-5058-9e5e-049671ca1051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186128057} {:answer/id #uuid "49464d90-4a8f-5d53-9d01-28c5d5654e10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186128058}] :answer-field/correct {:db/id #edb/ref 17592186128058} :answer-field/id #uuid "1adf921f-3910-55f5-9228-74e4653b36b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128053}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58e657fe-ad6a-53ef-9cfa-164db29f5116" :question/math-academy-id "q-40312" :question/problem "![](images/c2/c24eb387b430ae40e7c5ec0747eb8570df21ebbe4535fd1305676219ad5c83f1.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/d0/d00feacd712c1ca185a8975e8b6343f9937f254631614242003f1d76c1427ffe.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2+y-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/59/59b7304dcc07ac38c093b7d8d29d4b4079f192cd9fd0385db9f1981e4640eceb.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2,\\,\\,0\\le x\\le 2+y-z\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{2+y-z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}[x]_{x=0}^{x=2+y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(2+y-z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2+y-z\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{[(2+y)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dy \\\\  & ={\\int }_{0}^{3}((2+y)(2)-\\frac{{2}^{2}}{2})-0\\,dy \\\\  & ={\\int }_{0}^{3}2+2y\\,dy \\\\  & =[2y+{y}^{2}]_{y=0}^{y=3} \\\\  & =(2(3)+{3}^{2})-0 \\\\  & =15.\\end{aligned}\n$$"} :step/id #uuid "808ca638-ac49-5675-8a17-db421c44f255" :step/next {:db/id #edb/ref 17592186433117}} {:db/id #edb/ref 17592186433117 :step/content {:db/id #edb/ref 17592186129763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef77ed18-249f-537b-8615-5306a3284672" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186128061} {:answer/id #uuid "4062cf11-2488-5c94-8710-b203cad7b0c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186128063} {:answer/id #uuid "5d0de3e4-c134-5ea7-b5dc-a5a628bbec37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186128064} {:answer/id #uuid "4e0627ca-90a4-5c2d-835c-b255053c8381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186433093} {:answer/id #uuid "e249f9ca-86be-5b5a-b69e-663670da563c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186433105}] :answer-field/correct {:db/id #edb/ref 17592186128063} :answer-field/id #uuid "25782da8-dd94-5fd2-acba-47173bb4f81d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128059}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "77433c48-7de7-5d10-a89d-7533049beb31" :question/math-academy-id "q-40317" :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le \\pi ,\\,-2\\le y\\le 2,\\,0\\le z\\le \\operatorname{sin}⁡x\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{-2}^{2}{\\int }_{0}^{\\operatorname{sin}⁡x}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{-2}^{2}[z]_{z=0}^{z=\\operatorname{sin}⁡x}\\,dy\\,dx \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{-2}^{2}\\operatorname{sin}⁡x-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{-2}^{2}\\operatorname{sin}⁡x\\,dy\\,dx \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡x[y]_{y=-2}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,(2-(-2))\\,dx \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,dx \\\\  & =-4[\\operatorname{cos}⁡x]_{x=0}^{x=\\pi } \\\\  & =-4(-1-1) \\\\  & =8.\\end{aligned}\n$$"} :step/id #uuid "c83aa896-3d0a-5926-8f0d-13b4a640fdef" :step/next {:db/id #edb/ref 17592186433115}} {:db/id #edb/ref 17592186433118 :step/content {:db/id #edb/ref 17592186433112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3740f966-0f93-528e-8cf0-ad5178dfa0c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9-6{y}^{2}+{z}^{2}" :db/id #edb/ref 17592186433091} {:answer/id #uuid "4dbf4c0b-b5df-5421-9edb-f86c8c2c705e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-6{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186433092} {:answer/id #uuid "53329c60-d1ff-54b3-961f-07a95f0e51c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+3{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186433095} {:answer/id #uuid "75a7954b-84e1-59d9-a8f5-f24af99eff69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6+9{y}^{2}+2{z}^{2}" :db/id #edb/ref 17592186433098} {:answer/id #uuid "e57d5e52-da19-5261-a231-8c6edbb04f78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-3{y}^{2}-{z}^{2}" :db/id #edb/ref 17592186433106}] :answer-field/correct {:db/id #edb/ref 17592186433092} :answer-field/id #uuid "b0c34a23-22e6-559b-8ba1-968780133734" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433110}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6fae9a19-909c-5d4f-9c8f-4d34e1cb3eba" :question/math-academy-id "q-161713" :question/problem "Consider the solid enclosed between the paraboloid $x={y}^{2}+2{z}^{2}$ and the parabolic cylinder $x=3-2{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}{y}^{2}+2{z}^{2} & =3-2{y}^{2} \\\\ 3{y}^{2}+2{z}^{2} & =3\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,{y}^{2}+2{z}^{2}\\le x\\le 3-2{y}^{2}\\},\n$$\n\nwhere $D$ is the interior of the ellipse $3{y}^{2}+2{z}^{2}=3.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{{y}^{2}+2{z}^{2}}^{3-2{y}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(3-2{y}^{2})-({y}^{2}+2{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}3-3{y}^{2}-2{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{3(1-{y}^{2})}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{3(1-{y}^{2})}{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}3-3{y}^{2}-2{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{3(1-{y}^{2})/2}}^{\\sqrt{3(1-{y}^{2})/2}}\\,3-3{y}^{2}-2{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{3(1-{y}^{2})}{2}})}^{2}+{(\\sqrt{\\frac{3(1-{y}^{2})}{2}})}^{2}+(3-3{y}^{2}-2{z}^{2}) \\\\  & =\\frac{3(1-{y}^{2})}{2}+\\frac{3(1-{y}^{2})}{2}+(3-3{y}^{2}-2{z}^{2}) \\\\  & =6-6{y}^{2}-2{z}^{2}.\\end{aligned}\n$$"} :step/id #uuid "fe1c9984-4492-5bc7-9f8a-f367a564a7b2" :step/next {:db/id #edb/ref 17592186433114}}] :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186433090}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186521604} :activity/id #uuid "f971a949-3d29-572a-8147-5fc1f2847887" :activity/scope {:db/id #edb/ref 17592186048997 :topic/id #uuid "d20a7fc8-1ce1-5256-b63f-ebdb4499588c" :topic/math-academy-id 2053} :activity/steps [{:db/id #edb/ref 17592186521591 :step/content {:db/id #edb/ref 17592186281299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ae8429-f69d-5ace-9302-7610fc9d936c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186278786} {:answer/id #uuid "558b62f0-5307-5c8d-b221-d64f4a347db2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186279373} {:answer/id #uuid "67bcdefa-ae0f-563d-a606-0b4fc3264810" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186279535} {:answer/id #uuid "b3dac8f5-8001-5b88-b8f5-8efb16420750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186280176} {:answer/id #uuid "f2dd39da-a465-5001-a8a3-a1dadc0b4509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186280709}] :answer-field/correct {:db/id #edb/ref 17592186278786} :answer-field/id #uuid "95e414d6-af68-52cc-a7c3-68806836a587" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281103}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e6adf41-eeec-5787-910a-9b879a193cb7" :question/math-academy-id "q-161695" :question/problem "![](images/21/214d629cdac48642a7a8b4d435f91098388a7a799bd7e70d5b7c91ae028714c3.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/bf/bf9c4790a8e31e000d2aeb7f7e557661683d3f52d737ba1b99abd407c15d6e99.png)\n\n  \n\nNotice that our solid can be written as the type I region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 3+x-y\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](images/74/74954715928551ebb271cdfd461d783778b02b7944cbfd5502d6d06011408ad8.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2,\\,\\,0\\le z\\le 3+x-y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{3+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[z]_{z=0}^{z=3+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(3+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}3+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(3+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{2}((3+x)(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}4+2x\\,dx \\\\  & =[4x+{x}^{2}]_{x=0}^{x=2} \\\\  & =(8+4)-0 \\\\  & =12.\\end{aligned}\n$$"} :step/id #uuid "3af25230-3314-5d99-92ec-e984f7db309b"} {:db/id #edb/ref 17592186521604 :step/content {:db/id #edb/ref 17592186281285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b3410aa-3741-574c-a561-ca42745d30c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "39" :db/id #edb/ref 17592186278698} {:answer/id #uuid "27773d7f-25a8-52fe-bf01-68d9f7772331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186278943} {:answer/id #uuid "355cd015-3c29-5af2-b4f6-238cf9b24f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186279057} {:answer/id #uuid "4bc0b319-2b34-5da0-9a70-f1965d979755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{3}" :db/id #edb/ref 17592186279268} {:answer/id #uuid "51b7c11f-8dbf-5b54-9513-c9741d294524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186279336}] :answer-field/correct {:db/id #edb/ref 17592186278698} :answer-field/id #uuid "862cee1d-edf0-59fb-96ad-6bf304ab07ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281077}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "edd7e04c-fb5f-5755-adfd-ac7811c6b1ad" :question/math-academy-id "q-161653" :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 4,\\,2\\le z\\le 3y+x\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}{\\int }_{2}^{3y+x}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}[z]_{z=2}^{z=3y+x}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}3y+x-2\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[\\frac{3}{2}{y}^{2}+xy-2y]}_{y=1}^{y=4}\\,dx \\\\  & ={\\int }_{0}^{2}\\,[(24+4x-8)-(\\frac{3}{2}+x-2)]\\,dx \\\\  & =4{\\int }_{0}^{2}3x+\\frac{33}{2}\\,dx \\\\  & ={[\\frac{3{x}^{2}}{2}+\\frac{33}{2}x]}_{x=0}^{x=2} \\\\  & =\\frac{3(2)^{2}}{2}+\\frac{33}{2}(2)-0 \\\\  & =39.\\end{aligned}\n$$"} :step/id #uuid "5faef48e-5cda-55d7-a57a-164d8871091d" :step/next {:db/id #edb/ref 17592186521609}} {:db/id #edb/ref 17592186521609 :step/content {:db/id #edb/ref 17592186412201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ec6ec01-733e-5f02-af23-9cc8caaac3a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186412118} {:answer/id #uuid "7908b9c9-85f1-5fb7-8993-c1b1c1be6014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186412124} {:answer/id #uuid "b9a79b99-32b0-5d67-90f5-be49d7031cdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186412146} {:answer/id #uuid "bc206240-eb24-501d-9e9e-fc7fd50a7902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186412147} {:answer/id #uuid "d8ffd103-8f74-5398-842a-0cf2cb86197a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186412160}] :answer-field/correct {:db/id #edb/ref 17592186412147} :answer-field/id #uuid "3acdc6ec-2a12-547a-88f2-73cc8411f0a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412179}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89162549-49ec-507f-b56c-dea9e66a6c30" :question/math-academy-id "q-161654" :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,1-x\\le y\\le 1+x,\\,0\\le z\\le xy\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}{\\int }_{0}^{xy}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}[z]_{z=0}^{z=xy}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}xy\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}x{[\\frac{{y}^{2}}{2}]}_{y=1-x}^{y=1+x}\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}((1+x)^{2}-(1-x)^{2})\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}((1+2x+{x}^{2})-(1-2x+{x}^{2}))\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}(4x)\\,dx \\\\  & ={\\int }_{0}^{1}2{x}^{2}\\,dx \\\\  & ={[\\frac{2}{3}{x}^{3}]}_{x=0}^{x=1} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} :step/id #uuid "68eda359-115c-504f-bacc-ef7faead6b39" :step/next {:db/id #edb/ref 17592186521625}} {:db/id #edb/ref 17592186521625 :step/content {:db/id #edb/ref 17592186521539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343954e9-c53f-5136-9342-da031d631171" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186520872} {:answer/id #uuid "5f8618f2-a4c1-5463-ab9a-c3032c367b51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186520980} {:answer/id #uuid "9cfbf36d-43f4-55af-88f8-c9911c1d33e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186521120} {:answer/id #uuid "a0a41433-b3e1-5c92-a9c4-ccd8e0742151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186521124} {:answer/id #uuid "ff83ce28-20eb-50da-bedd-918638dace6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186521326}] :answer-field/correct {:db/id #edb/ref 17592186520872} :answer-field/id #uuid "8a20ef1d-6ee3-5383-abac-10a8cde3ea7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521393}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b01530fa-080b-571d-ad1e-cd03aad8ce73" :question/math-academy-id "q-161660" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,-1\\le x\\le 1,\\,0\\le z\\le 2-{x}^{2},\\,-1\\le y\\le x\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}{\\int }_{-1}^{x}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}[y]_{y=-1}^{y=x}\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}(x-(-1))\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}x+1\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1){[z]}_{z=0}^{z=2-{x}^{2}}\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1)(2-{x}^{2}-0)\\,dx \\\\  & ={\\int }_{-1}^{1}-{x}^{3}-{x}^{2}+2x+2\\,dx \\\\  & ={[-\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}+{x}^{2}+2x]}_{x=-1}^{x=1} \\\\  & =(-\\frac{1}{4}-\\frac{1}{3}+1+2)-(-\\frac{1}{4}+\\frac{1}{3}+1-2) \\\\  & =2(2-\\frac{1}{3}) \\\\  & =\\frac{10}{3}.\\end{aligned}\n$$"} :step/id #uuid "9f523ef4-394e-50e4-9b0c-e0ef1659a991" :step/next {:db/id #edb/ref 17592186521647}} {:db/id #edb/ref 17592186521647 :step/content {:db/id #edb/ref 17592186521466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b297e7c-d769-53ea-8c65-407ff3d71965" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186520782} {:answer/id #uuid "365194f6-bbdb-5806-b6cb-a366405227b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186520880} {:answer/id #uuid "7bd533fa-b6df-5f0a-82f8-f039d177607d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186521045} {:answer/id #uuid "ad5c1fce-95e2-5a1d-b0c8-18244b6208ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186521151} {:answer/id #uuid "b1bd0eaf-67d3-50f4-afcf-748a5d55eeac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186521158}] :answer-field/correct {:db/id #edb/ref 17592186520782} :answer-field/id #uuid "bb4d67ee-c5f9-5907-9389-cb8d07771ac8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521420}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1f0b5299-7a35-5c1a-9b72-d6af14bd952f" :question/math-academy-id "q-161694" :question/problem "![](images/43/4315e0e20d37935d3f5454063475fdfa5ed7a1915f82ae96194e83880ba02e76.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/0b/0ba756dacf72b89b06c3c214e1582a74fa803f567082f57538e7a78c84d4591f.png)\n\n \n\nNotice that our solid can be written as the type I region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 2+x-y\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](images/65/65c61ad7dc2964cd0de9a6bbdf259fcf3388e25da4eaabf155d58ff0c05c8d55.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le 2+x-y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{2+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[z]_{z=0}^{z=2+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(2+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}2+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(2+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=1}\\,dx \\\\  & ={\\int }_{0}^{2}2+x-\\frac{1}{2}\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{3}{2}+x\\,dx \\\\  & ={[\\frac{3}{2}x+\\frac{1}{2}{x}^{2}]}_{x=0}^{x=2} \\\\  & =(3+2)-0 \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "dd20223b-26e1-5350-99dc-f7563663a33f" :step/next {:db/id #edb/ref 17592186521591}}] :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520760}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186545931} :activity/id #uuid "3acbe0bd-f475-593d-b042-bf6068b13815" :activity/scope {:db/id #edb/ref 17592186048997 :topic/id #uuid "d20a7fc8-1ce1-5256-b63f-ebdb4499588c" :topic/math-academy-id 2053} :activity/steps [{:db/id #edb/ref 17592186545903 :step/content {:db/id #edb/ref 17592186281297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8b5270-0b9e-58a2-b38b-c3790a1d138e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186278886} {:answer/id #uuid "539c47eb-4e33-5a30-8709-954ebe399f2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186279352} {:answer/id #uuid "66acf6b9-46c7-5698-bd66-ee1438fb10b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186279522} {:answer/id #uuid "a07dafa9-e281-5089-8e13-5ee1c80e5bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186280017} {:answer/id #uuid "b24bc621-c454-5e2f-9a35-a4af21e6cb9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186280166}] :answer-field/correct {:db/id #edb/ref 17592186278886} :answer-field/id #uuid "5d9404cc-4df0-50a5-9ff1-a9c703daf425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280996}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "45246a73-90c4-530d-b058-98109082ad22" :question/math-academy-id "q-161685" :question/problem "Find the volume of the solid region enclosed by the $xz$-plane and the surface $y=5-3{z}^{2},$ and the planes $x=0,$ $x=1,$ $z=-1,$ $z=0.$" :question/worked-solution "Notice that our solid can be written as a type III region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,-1\\le z\\le 0,\\,\\,0\\le y\\le 5-3{z}^{2}\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}{\\int }_{0}^{5-3{z}^{2}}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}[y]_{y=0}^{y=5-3{z}^{2}}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}5-3{z}^{2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}[5z-{z}^{3}]_{z=-1}^{z=0}\\,dx \\\\  & ={\\int }_{0}^{1}0-(5(-1)-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{1}5-1\\,dx \\\\  & =4{\\int }_{0}^{1}dx \\\\  & =4[x]_{x=0}^{x=1} \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "2c68a282-fb8d-5473-b214-328eb1dfb504" :step/next {:db/id #edb/ref 17592186545959}} {:db/id #edb/ref 17592186545931 :step/content {:db/id #edb/ref 17592186129762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85287494-343a-5f08-8ce3-ddb465ec63b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186128054} {:answer/id #uuid "95b618bf-4be2-55d9-bc12-c665f2e6b2d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186128055} {:answer/id #uuid "9b237bdf-4e5a-52ce-8767-7d03eb67eccd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{2}" :db/id #edb/ref 17592186128056} {:answer/id #uuid "ec24a157-5b5e-5058-9e5e-049671ca1051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186128057} {:answer/id #uuid "49464d90-4a8f-5d53-9d01-28c5d5654e10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186128058}] :answer-field/correct {:db/id #edb/ref 17592186128058} :answer-field/id #uuid "1adf921f-3910-55f5-9228-74e4653b36b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186128053}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "58e657fe-ad6a-53ef-9cfa-164db29f5116" :question/math-academy-id "q-40312" :question/problem "![](images/c2/c24eb387b430ae40e7c5ec0747eb8570df21ebbe4535fd1305676219ad5c83f1.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/d0/d00feacd712c1ca185a8975e8b6343f9937f254631614242003f1d76c1427ffe.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2+y-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/59/59b7304dcc07ac38c093b7d8d29d4b4079f192cd9fd0385db9f1981e4640eceb.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2,\\,\\,0\\le x\\le 2+y-z\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{2+y-z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}[x]_{x=0}^{x=2+y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(2+y-z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2+y-z\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{[(2+y)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dy \\\\  & ={\\int }_{0}^{3}((2+y)(2)-\\frac{{2}^{2}}{2})-0\\,dy \\\\  & ={\\int }_{0}^{3}2+2y\\,dy \\\\  & =[2y+{y}^{2}]_{y=0}^{y=3} \\\\  & =(2(3)+{3}^{2})-0 \\\\  & =15.\\end{aligned}\n$$"} :step/id #uuid "5f678a58-ebc6-50b7-bfbb-3b3bd2f77536" :step/next {:db/id #edb/ref 17592186545981}} {:db/id #edb/ref 17592186545959 :step/content {:db/id #edb/ref 17592186235408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1131cf03-59d7-52b7-a961-e57867699e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-{y}^{2}-4{z}^{2}" :db/id #edb/ref 17592186234565} {:answer/id #uuid "56b94ec6-98a3-5534-b3fb-6cf915cc915b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}-2{y}^{2}+4{z}^{2}" :db/id #edb/ref 17592186234682} {:answer/id #uuid "71dd748e-5518-5244-b3e8-24b94c177871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-3{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186234717} {:answer/id #uuid "b7a2151f-a2c5-5515-b414-6ee4b6cdf444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-2{y}^{2}-2{z}^{2}" :db/id #edb/ref 17592186234826} {:answer/id #uuid "e67bf2ad-b6cd-5894-bb82-3d92ee92c03e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+6{y}^{2}-4{z}^{2}" :db/id #edb/ref 17592186234907}] :answer-field/correct {:db/id #edb/ref 17592186234826} :answer-field/id #uuid "66b28244-bc08-5da0-8ef2-5ba05c93c8db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186235081}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0df5261b-5237-5119-912e-df4a2c80b73e" :question/math-academy-id "q-161715" :question/problem "Consider the solid enclosed between the paraboloid $x=-2+{y}^{2}+4{z}^{2}$ and the parabolic cylinder $x=-1+2{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-2+{y}^{2}+4{z}^{2} & =-1+2{z}^{2} \\\\ {y}^{2}+2{z}^{2} & =1 \\\\ {y}^{2}+2{z}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,-2+{y}^{2}+4{z}^{2}\\le x\\le -1+2{z}^{2}\\},\n$$\n\nwhere $D$ is the interior of the ellipse ${y}^{2}+2{z}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-2+{y}^{2}+4{z}^{2}}^{-1+2{z}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(-1+2{z}^{2})-(-2+{y}^{2}+4{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{1-{y}^{2}}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{1-{y}^{2}}{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{(1-{y}^{2})/2}}^{\\sqrt{(1-{y}^{2})/2}}\\,1-{y}^{2}-2{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+{(\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =\\frac{1-{y}^{2}}{2}+\\frac{1-{y}^{2}}{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =2-2{y}^{2}-2{z}^{2}.\\end{aligned}\n$$"} :step/id #uuid "a29fc4a4-b0fb-5b9b-a936-4edfa87ff06b" :step/next {:db/id #edb/ref 17592186545972}} {:db/id #edb/ref 17592186545972 :step/content {:db/id #edb/ref 17592186281316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00df58ac-ae19-5439-acd9-c31097afed15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186278591} {:answer/id #uuid "48cff7f4-cd5b-57fd-b9dd-13586d249b89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186279241} {:answer/id #uuid "732667ef-9f60-5d95-8202-d7d8f147202b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186279637} {:answer/id #uuid "adbfe291-1ad7-5bd3-9a75-fd6dcb2faa31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280129} {:answer/id #uuid "ff7f58e5-5448-5e72-80b2-ebe69b806f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186280829}] :answer-field/correct {:db/id #edb/ref 17592186279637} :answer-field/id #uuid "8472cdd0-f6c1-5f91-9a65-fe36f92148f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281072}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "28a17934-c155-5435-8a27-ac142e1e8af3" :question/math-academy-id "q-161742" :question/problem "![](images/77/770cdf03e988f811ccc3ff805889cef55304b01b6e8009e25ba128fbdbb89066.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](images/8e/8e5f3095cac4e068e54d9b3ac2bb55dc4789e7ca68d4524dce4d25a55abd5be6.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 4-2x-4z\\},\n$$\n\nwhere $D$ is the projection of $R$ onto the $xz$-plane.\n\nTo find the top boundary curve of $D$ in the form $z=z(x),$ we substitute $y=0$  into the equation $y=4-2x-4z:$\n\n$$\n0=4-2x-4z\\,⟹\\,z=1-\\frac{x}{2}\n$$\n\nThen, we have\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2}\\},\n$$\n\nas shown below.\n\n![](images/76/76fcca4251a904a08ac2f6ba8181d92c2c2fa7e07e596ef6276f1d21b574817a.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2},\\,\\,0\\le y\\le 4-2x-4z\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}{\\int }_{0}^{4-2x-4z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}[y]_{y=0}^{y=4-2x-4z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}(4-2x-4z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}4-2x-4z\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[(4-2x)z-2{z}^{2}]}_{z=0}^{z=1-x/2}\\,dx \\\\  & ={\\int }_{0}^{2}((4-2x)(1-\\frac{x}{2})-2{(1-\\frac{x}{2})}^{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}(1-\\frac{x}{2})((4-2x)-2(1-\\frac{x}{2}))\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(2-x)(2-x)\\,dx \\\\  & ={\\int }_{0}^{2}2-2x+\\frac{{x}^{2}}{2}\\,dx \\\\  & ={[2x-{x}^{2}+\\frac{{x}^{3}}{6}]}_{x=0}^{x=2} \\\\  & =(2(2)-{2}^{2}+\\frac{{2}^{3}}{6})-0 \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"} :step/id #uuid "b8e034ac-74ed-5ee7-86d4-526d9fcddec2"} {:db/id #edb/ref 17592186545981 :step/content {:db/id #edb/ref 17592186129766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aa5673c-b507-5eb0-b945-e8326bea0f51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{81}{2}" :db/id #edb/ref 17592186412098} {:answer/id #uuid "6e45224d-66f6-5baf-b658-0f0390c00d1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186412117} {:answer/id #uuid "b950298e-588d-50e8-91e2-a245f827cbf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186412145} {:answer/id #uuid "e74dcd89-af2d-524e-810b-cae923b4eb4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{93}{2}" :db/id #edb/ref 17592186412162} {:answer/id #uuid "f4c2ff78-cfe5-5246-b9cd-7e49b93095ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186412167}] :answer-field/correct {:db/id #edb/ref 17592186412145} :answer-field/id #uuid "27c4624f-447a-5116-b81e-664c77c5bd9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412178}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fac0ad3-f7f8-517d-a7fd-3686f90064e2" :question/math-academy-id "q-40396" :question/problem "Find the volume of the solid region enclosed by the $yz$-plane, the surface $x=6yz+12,$ and the planes $y=0,$ $y=2,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 6yz+12\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{6yz+12}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[x]_{x=0}^{x=6yz+12}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(6yz+12)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}6yz+12\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}[3y{z}^{2}+12z]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{2}(3y(1)^{2}+12(1))-0\\,dy \\\\  & ={\\int }_{0}^{2}3y+12\\,dy \\\\  & ={[\\frac{3}{2}{y}^{2}+12y]}_{y=0}^{y=2} \\\\  & =\\frac{3}{2}({2}^{2}-0)+12(2-0) \\\\  & =30.\\end{aligned}\n$$"} :step/id #uuid "c60f261b-2160-5d1d-a644-128afd94f52c" :step/next {:db/id #edb/ref 17592186545903}}] :activity/title "Calculating Volumes of Solids Using Triple Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545184}]}
