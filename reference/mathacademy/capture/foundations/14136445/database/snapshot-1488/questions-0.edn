#{[{:db/id #edb/ref 17592186436465 :knowledge-point/_questions [{:db/id #edb/ref 17592186119813 :knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26159372-b71c-53aa-b5de-cd66262e13d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186436450} {:answer/id #uuid "30b01182-4cb9-5d97-bf75-ba208916b906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186436452} {:answer/id #uuid "7bcf1b8a-8c6e-5d2f-89fa-e89e9f45ad26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186436455} {:answer/id #uuid "8053bf30-d2ef-56f4-8354-9c959a10f447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436456} {:answer/id #uuid "e19d83c2-3ef3-5b10-a767-87a0e48125c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436460}] :answer-field/correct {:answer/id #uuid "e19d83c2-3ef3-5b10-a767-87a0e48125c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186436460} :answer-field/id #uuid "2ce54b5e-3110-587b-a5da-74e4583bb5ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f9d6921-1029-58c3-84e2-79c33a9e57b1" :question/math-academy-id "q-111104" :question/problem "Consider the matrix $A=[\\begin{aligned}1 & -2 & -1 \\\\ -2 & 4 & 2\\end{aligned}]$ and the vector $b=[\\begin{aligned}3 \\\\ k \\\\ 1\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}1 & -2 & -1 \\\\ -2 & 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ k \\\\ 1\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-2k+2 \\\\ 4k-4\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\{\\begin{aligned}-2k+2=0 \\\\ 4k-4=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=1.$"}] [{:db/id #edb/ref 17592186247206 :knowledge-point/_questions [{:db/id #edb/ref 17592186119813 :knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8444e8ba-c379-5ef0-962e-f9d3045ba621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245478} {:answer/id #uuid "b41037e1-6cef-58fa-beb9-77fb072e4a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186245916} {:answer/id #uuid "bcd02285-f046-5ef2-bc6a-5641e47bade5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186245997} {:answer/id #uuid "c1b65297-ae0b-506f-9fdb-2295eade2da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186246041} {:answer/id #uuid "c711b889-46b6-59bf-970c-71a8d8049a7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186246078}] :answer-field/correct {:answer/id #uuid "8444e8ba-c379-5ef0-962e-f9d3045ba621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245478} :answer-field/id #uuid "2e10cd01-df1b-5da5-9789-385a9c2f8dac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91993936-f250-5744-8e70-dfa072854477" :question/math-academy-id "q-111106" :question/problem "Consider the matrix $A=[\\begin{aligned}3 & -1 & -2 \\\\ -12 & 4 & 8\\end{aligned}]$ and the vector $b=[\\begin{aligned}2 \\\\ 2k \\\\ 5\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}3 & -1 & -2 \\\\ -12 & 4 & 8\\end{aligned}][\\begin{aligned}2 \\\\ 2k \\\\ 5\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-2k-4 \\\\ 8k+16\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n\\{\\begin{aligned}-2k-4=0 \\\\ 8k+16=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=-2.$"}] [{:db/id #edb/ref 17592186436466 :knowledge-point/_questions [{:db/id #edb/ref 17592186119814 :knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbca735-134e-51b1-aa7d-1ae1dcf3526f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436448} {:answer/id #uuid "207eceb9-2f6c-5231-8711-6fe00f2f5ba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}3{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436449} {:answer/id #uuid "278fe98f-e5e3-5f01-ba15-bc21fad992ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{1} \\\\ 3{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186436451} {:answer/id #uuid "9eeec1b5-b07a-5d06-b4a8-79874cf73995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}2{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436457} {:answer/id #uuid "b6e10da3-1a9f-5d6d-ae50-a5481958989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186436458}] :answer-field/correct {:answer/id #uuid "207eceb9-2f6c-5231-8711-6fe00f2f5ba6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}3{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186436449} :answer-field/id #uuid "efeb7b02-1be6-5efa-9bd8-eb3062a43a07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436464}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "312e3366-ac87-55a7-a43b-4cbe0aecef1d" :question/math-academy-id "q-111115" :question/problem "Consider the matrix $A=[\\begin{aligned}4 & -12 \\\\ -2 & 6\\end{aligned}].$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & -12 \\\\ -2 & 6\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 \\\\ -2 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}=0 \\\\ 0=0\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have one free variable, ${x}_{2}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}.$\n\nFrom the first equation we get ${x}_{1}=3{x}_{2},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{[\\begin{aligned}3{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}.\n$$"}] [{:db/id #edb/ref 17592186317454 :knowledge-point/_questions [{:db/id #edb/ref 17592186119814 :knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6572e448-2a1b-54fa-b7eb-b164a363dfcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{1} \\\\ -2{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430957} {:answer/id #uuid "77ade1d1-f580-5223-b0a2-1bf51cbff285" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2} \\\\ 2{x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430959} {:answer/id #uuid "9e92c0f2-12f6-52e4-bc39-5f630e281daf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}2{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/id #edb/ref 17592186430962} {:answer/id #uuid "b0b063f1-874e-516d-844c-6910584fd9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{1} \\\\ -3{x}_{1}\\end{aligned}]\\,:\\,{x}_{1}\\in R\\}" :db/id #edb/ref 17592186430964} {:answer/id #uuid "bd56a073-7763-5f3e-8627-e620cdb34e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186430966}] :answer-field/correct {:answer/id #uuid "bd56a073-7763-5f3e-8627-e620cdb34e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186430966} :answer-field/id #uuid "7741c95a-c056-57b4-9397-7a01a1ba8764" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "870e5cfd-95f3-5e52-b251-41fd48145e5a" :question/math-academy-id "q-34392" :question/problem "Consider the matrix $A=[\\begin{aligned}2 & 4 \\\\ 2 & 5\\end{aligned}].$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 4 \\\\ 2 & 5\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 \\\\ 2 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=0 \\\\ {x}_{2}=0\\end{aligned}\n$$\n\nThe second equation tells us that ${x}_{2}=0.$ Substituting this into the first equation, we get \n\n$$\n{x}_{1}+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSo, we conclude that $x=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the only solution to this system.\n\nTherefore, $\\text{Null}(A)=\\{0\\}.$"}] [{:db/id #edb/ref 17592186436467 :knowledge-point/_questions [{:db/id #edb/ref 17592186119814 :knowledge-point/id #uuid "465ce2b7-352e-5050-a5e4-0753fbacebf5" :knowledge-point/title "Finding the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c3ebd9-a42e-5c1a-8426-98e7d5e3d271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186436447} {:answer/id #uuid "33ab5a52-8fe6-5223-b21e-fdcf36d0f3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436453} {:answer/id #uuid "73ca3d47-be47-5546-93ee-f037f5752428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436454} {:answer/id #uuid "cdb8c109-a288-5915-8204-b0852f404fb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2}-{x}_{3} \\\\ {x}_{1}+{x}_{3} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436459} {:answer/id #uuid "f36c9e43-5eb7-51e7-9804-19a6c9a93b03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{2}-{x}_{1}\\end{aligned}]\\,:\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436461}] :answer-field/correct {:answer/id #uuid "33ab5a52-8fe6-5223-b21e-fdcf36d0f3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{[\\begin{aligned}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{2},{x}_{3}\\in R\\}" :db/id #edb/ref 17592186436453} :answer-field/id #uuid "7879cf33-2aec-51b3-9623-83b7a16a99c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436463}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6c9ad88-847a-5bc3-8131-a821e5ea8f1f" :question/math-academy-id "q-34952" :question/problem "Consider the matrix $A=[\\begin{aligned}1 & -1 & 1 \\\\ 7 & -7 & 7\\end{aligned}].$ Find $\\text{Null}(A).$" :question/worked-solution "We need to solve the equation $Ax=0.$ First, we find the row echelon form of $A$ as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -1 & 1 \\\\ 7 & -7 & 7\\end{aligned}] & {R}_{2} & :={R}_{2}+(-7){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThis corresponds to the following system:\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3}=0 \\\\ 0=0\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is ${x}_{1}$, and we have two free variables, ${x}_{2}$ and ${x}_{3}.$ That means we need to find ${x}_{1}$ in terms of ${x}_{2}$ and ${x}_{3}.$\n\nFrom the first equation we get ${x}_{1}={x}_{2}-{x}_{3},$ so the set of all the solutions of $Ax=0$ is\n\n$$\n\\text{Null}(A)=\\{[\\begin{aligned}{x}_{2}-{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\\,:\\,{x}_{2},{x}_{3}\\in R\\}.\n$$"}]}
