#{[{:activity/first-step {:db/id #edb/ref 17592186120621} :activity/id #uuid "1cf102a8-b50b-50b9-b9e1-ba6d06bcd005" :activity/scope {:db/id #edb/ref 17592186048505 :topic/id #uuid "a564c0d5-78a2-53e7-86da-2f6c443f5501" :topic/math-academy-id 1770} :activity/steps [{:db/id #edb/ref 17592186120621 :step/content {:db/id #edb/ref 17592186121018 :tutorial/content "Sometimes there are lots of calculations involved in finding the determinant of a matrix using a cofactor expansion across the first row. \n\nFortunately, however, we don't always have to use the first row! We can use *any* row we like. A cofactor expansion across any general row is known as a **Laplace expansion**.\n\nAcross the row $i,$ the Laplace expansion of an $n\\!\\times\\! n$ matrix $A$ is given by the formula\n\n$$\n\\begin{aligned}det(A) & ={\\sum }_{j=1}^{n}{a}_{ij}{C}_{ij} \\\\  & ={a}_{i1}{C}_{i1}+{a}_{i2}{C}_{i2}+⋯+{a}_{in}{C}_{in},\\end{aligned}\n$$\n\nwhere ${\\color{blue}C_{ij}}$ is the cofactor of the entry $\\color{red}a_{ij}$ in $A.$ Remember the cofactor of the entry $\\color{red}a_{ij}$ is \n\n$$\n{\\color{black}C_{ij}}=(-1)^{i+j}{\\color{black}M_{ij}},\n$$\n\nwhere ${\\color{black}M_{ij}}$ is the minor of the entry.\n\nFor example, consider the following matrix:\n\n$$\n[\\begin{aligned}-1 & 2 & 1 & 1 \\\\ 0 & -1 & 1 & 1 \\\\ 0 & 2 & 0 & 0 \\\\ 0 & 1 & 0 & -3\\end{aligned}]\n$$\n\nTo compute the determinant of the matrix above, it is most convenient to use a Laplace expansion along the row with the most zeros. So, let's use Laplace expansion across the third row ($i=3$) as follows:\n\n![](images/6e/6e8d5f7f4111e8963a6d4c7daf2bd5116d8099e18f41c53f2dae73f659f01e35.svg)\n\nSo, we reduced a $4 \\times 4$ determinant to a $3 \\times 3$ determinant." :tutorial/id #uuid "e9ee666a-da25-5521-b0bf-5d90a89b6e5d" :tutorial/math-academy-id 3001 :tutorial/title "Introduction"} :step/id #uuid "cd1eda6c-ca73-5cc1-91b6-a6fdef05cb05" :step/math-academy-id 16206 :step/next {:db/id #edb/ref 17592186120730}} {:db/id #edb/ref 17592186120622 :step/content {:db/id #edb/ref 17592186119773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119587 :question/id #uuid "8235213e-4e88-57f6-89b0-de589ad2b38d" :question/math-academy-id "e-4418"} :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/questions [{:db/id #edb/ref 17592186120424} {:db/id #edb/ref 17592186120425} {:db/id #edb/ref 17592186338749} {:db/id #edb/ref 17592186338750} {:db/id #edb/ref 17592186338751} {:db/id #edb/ref 17592186338752} {:db/id #edb/ref 17592186345306} {:db/id #edb/ref 17592186345307} {:db/id #edb/ref 17592186345337} {:db/id #edb/ref 17592186345338} {:db/id #edb/ref 17592186369686} {:db/id #edb/ref 17592186370933} {:db/id #edb/ref 17592186371077}] :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"} :step/id #uuid "c97ef0ce-8fe0-5462-8edf-ea6b6fce37f7" :step/math-academy-id 16207 :step/next {:db/id #edb/ref 17592186120623}} {:db/id #edb/ref 17592186120623 :step/content {:db/id #edb/ref 17592186121019 :tutorial/content "We can also use the Laplace expansion across any *column* to find the determinant. Across the column $j,$ the Laplace expansion is given by the formula\n\n$$\n\\begin{aligned}det(A) & ={\\sum }_{i=1}^{n}{a}_{ij}{C}_{ij} \\\\  & ={a}_{1j}{C}_{1j}+{a}_{2j}{C}_{2j}+⋯+{a}_{nj}{C}_{nj},\\end{aligned}\n$$\n\nwhere $\\color{blue}C_{ij}$ is the cofactor of the entry ${\\color{red}a_{ij}}.$\n\nIn other words, the Laplace expansion across a row or column is the sum of the entries in the row or column multiplied by their respective cofactors.\n\nTo find the determinant of a matrix, we can choose to use the Laplace expansion across any row or column, so choose the row or column that has the most zeros, to cut down on the calculations!" :tutorial/id #uuid "3c3bdfc6-9f31-558b-9e75-725b2a92027f" :tutorial/math-academy-id 3002 :tutorial/title "Laplace Expansion Across a Column"} :step/id #uuid "678f4e20-a38c-51ea-909d-5d7d1577436d" :step/math-academy-id 16208 :step/next {:db/id #edb/ref 17592186120624}} {:db/id #edb/ref 17592186120624 :step/content {:db/id #edb/ref 17592186119774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119588 :question/id #uuid "6f0a6499-03db-5833-b175-4835325d34d6" :question/math-academy-id "e-4419"} :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/questions [{:db/id #edb/ref 17592186120404} {:db/id #edb/ref 17592186120423} {:db/id #edb/ref 17592186265821} {:db/id #edb/ref 17592186323769} {:db/id #edb/ref 17592186326927} {:db/id #edb/ref 17592186338731} {:db/id #edb/ref 17592186345311} {:db/id #edb/ref 17592186345341} {:db/id #edb/ref 17592186345342} {:db/id #edb/ref 17592186369693} {:db/id #edb/ref 17592186370926} {:db/id #edb/ref 17592186392468} {:db/id #edb/ref 17592186393709} {:db/id #edb/ref 17592186393716}] :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"} :step/id #uuid "bb444283-a8b6-5668-8558-32d154a2839b" :step/math-academy-id 16209} {:db/id #edb/ref 17592186120730 :step/content {:db/id #edb/ref 17592186119843 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119657 :question/id #uuid "5cc1443c-03cd-5f86-bcfc-b9b7f4c6a565" :question/math-academy-id "e-5182"} :knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050092}] :knowledge-point/questions [{:db/id #edb/ref 17592186120402} {:db/id #edb/ref 17592186120403} {:db/id #edb/ref 17592186265802} {:db/id #edb/ref 17592186336026} {:db/id #edb/ref 17592186345305} {:db/id #edb/ref 17592186345335} {:db/id #edb/ref 17592186345336} {:db/id #edb/ref 17592186392973}] :knowledge-point/title "Applying a Laplace Expansion Across a Row"} :step/id #uuid "ada1363c-ec10-55ea-a2b2-e872dcb901ad" :step/math-academy-id 19018 :step/next {:db/id #edb/ref 17592186120622}}] :activity/title "Finding Determinants Using Laplace Expansions" :activity/type {:db/i