#{[{:db/id #edb/ref 17592186265821 :knowledge-point/_questions [{:db/id #edb/ref 17592186119774 :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "664a8be3-c96f-5f40-a756-b75cb919d17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\cdot |\\begin{aligned}-1 & 1 & 5 \\\\ 7 & 3 & -2 \\\\ 2 & -4 & -1\\end{aligned}|" :db/id #edb/ref 17592186263884} {:answer/id #uuid "7a1201de-9f59-557b-b8e0-5e3a27178624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186264059} {:answer/id #uuid "a56002a4-5702-52ca-a68b-b7c638eeda99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186264417} {:answer/id #uuid "e5560c16-93e7-5932-afa1-a7786605d913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186264997} {:answer/id #uuid "fad808be-4742-57d4-9e6a-a4df52b11186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3|\\begin{aligned}3 & 1 & 5 \\\\ -3 & 2 & 7 \\\\ 2 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186265196}] :answer-field/correct {:answer/id #uuid "e5560c16-93e7-5932-afa1-a7786605d913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|" :db/id #edb/ref 17592186264997} :answer-field/id #uuid "51bf7c37-6d3e-5b7f-9709-5d6988af45d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265393}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba53d6e2-edac-5757-8fc8-0a9f2f226683" :question/math-academy-id "q-130092" :question/problem "$|\\begin{aligned}0 & 3 & 1 & 5 \\\\ -7 & 2 & -4 & 1 \\\\ 0 & 7 & 2 & -3 \\\\ 0 & 2 & -3 & -1\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $1$st column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 3 & 1 & 5 \\\\ -7 & 2 & -4 & 1 \\\\ 0 & 7 & 2 & -3 \\\\ 0 & 2 & -3 & -1\\end{aligned}| & =0\\cdot {C}_{11}+-7\\cdot {C}_{21}+0\\cdot {C}_{31}+0\\cdot {C}_{41} \\\\  & =(-7)\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}| \\\\  & =7\\cdot |\\begin{aligned}3 & 1 & 5 \\\\ 7 & 2 & -3 \\\\ 2 & -3 & -1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338752 :knowledge-point/_questions [{:db/id #edb/ref 17592186119773 :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ac0f97-eeb8-5783-936b-1cb59033a9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186336679} {:answer/id #uuid "4b236f4f-c6e5-553f-9345-4b6a8bba7c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186336725} {:answer/id #uuid "6029e681-c7c2-5a8b-96eb-6ad30cbe83ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186336903} {:answer/id #uuid "72576609-7b8d-50eb-8ffa-8aef7ffc7d00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186337056} {:answer/id #uuid "862a7584-abcb-5134-9117-8e928e486ca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186337244}] :answer-field/correct {:answer/id #uuid "45ac0f97-eeb8-5783-936b-1cb59033a9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186336679} :answer-field/id #uuid "907db199-a612-5898-a313-2594bace9c74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338542}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa886c44-6fbc-583a-a5aa-8d0e7dbb66ff" :question/math-academy-id "q-70133" :question/problem "Calculate\n$|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|.$" :question/worked-solution "The $4$th row of the given matrix contains two zeros, more than any other row. So, using a Laplace expansion along the $4$th row, we have   \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}| & =2\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+3\\cdot {C}_{44} \\\\  & =2\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =-2|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}|+3|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$  determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 3 \\\\ -1 & 2 & 0 \\\\ 1 & 1 & 1\\end{aligned}| & =(-1)\\cdot {C}_{21}+2\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =(-1)\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & 1\\end{aligned}|+2|\\begin{aligned}1 & 3 \\\\ 1 & 1\\end{aligned}| \\\\  & =(-2-3)+2(1-3) \\\\  & =-5+2\\cdot (-2) \\\\  & =-9\\end{aligned}\n$$\n\nFinally, we compute the second $3\\times 3$ determinant by applying a Laplace expansion along its $3$rd row:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -2 \\\\ -1 & -1 & 2 \\\\ 0 & 1 & 1\\end{aligned}| & =0\\cdot {C}_{31}+1\\cdot {C}_{32}+1\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+1\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-|\\begin{aligned}2 & -2 \\\\ -1 & 2\\end{aligned}|+|\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}| \\\\  & =-(4-2)+(-2+1) \\\\  & =-2+(-1) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}2 & 1 & -2 & 3 \\\\ -1 & -1 & 2 & 0 \\\\ 0 & 1 & 1 & 1 \\\\ 2 & 0 & 0 & 3\\end{aligned}|=-2\\cdot (-9)+3\\cdot (-3)=18-9=9.\n$$"}] [{:db/id #edb/ref 17592186425353 :knowledge-point/_questions [{:db/id #edb/ref 17592186119773 :knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f4bae87-8e07-5dc7-9219-6f715b2ead18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186425341} {:answer/id #uuid "67de8883-fc93-5260-a637-aad0f0e00eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186425343} {:answer/id #uuid "9ad5be32-123d-550b-a8af-5eb97cc44261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186425344} {:answer/id #uuid "a3bfe935-3937-5ddc-93c2-d9d7115d3c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186425346} {:answer/id #uuid "eec09744-a423-5762-9061-2c0d2667e27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-86" :db/id #edb/ref 17592186425349}] :answer-field/correct {:answer/id #uuid "eec09744-a423-5762-9061-2c0d2667e27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-86" :db/id #edb/ref 17592186425349} :answer-field/id #uuid "836f09e9-0332-59b3-a2c7-f5f742bda069" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425350}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f2f19b4d-d8c8-5ecf-9fc4-030f5c14f82f" :question/math-academy-id "q-77803" :question/problem "Compute the following determinant using a cofactor expansion along the $3$rd row:\n\n$$\n|\\begin{aligned}3 & 2 & 1 & 0 \\\\ 0 & -2 & -3 & -4 \\\\ 0 & 0 & 4 & 3 \\\\ 1 & 0 & -1 & 2\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & 1 & 0 \\\\ 0 & -2 & -3 & -4 \\\\ 0 & 0 & 4 & 3 \\\\ 1 & 0 & -1 & 2\\end{aligned}| & =0\\cdot {C}_{31}+0\\cdot {C}_{32}+4\\cdot {C}_{33}+3\\cdot {C}_{34} \\\\  & =4\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}3 & 2 & 0 \\\\ 0 & -2 & -4 \\\\ 1 & 0 & 2\\end{aligned}|+3\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}3 & 2 & 1 \\\\ 0 & -2 & -3 \\\\ 1 & 0 & -1\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}3 & 2 & 0 \\\\ 0 & -2 & -4 \\\\ 1 & 0 & 2\\end{aligned}|-3\\cdot |\\begin{aligned}3 & 2 & 1 \\\\ 0 & -2 & -3 \\\\ 1 & 0 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & 0 \\\\ 0 & -2 & -4 \\\\ 1 & 0 & 2\\end{aligned}| & =0\\cdot {C}_{21}+(-2)\\cdot {C}_{22}+(-4)\\cdot {C}_{23} \\\\  & =(-2)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}3 & 0 \\\\ 1 & 2\\end{aligned}|+(-4)\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}3 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}3 & 0 \\\\ 1 & 2\\end{aligned}|+4\\cdot |\\begin{aligned}3 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-2(6-0)+4(0-2) \\\\  & =-12-8 \\\\  & =-20\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain: \n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & 1 \\\\ 0 & -2 & -3 \\\\ 1 & 0 & -1\\end{aligned}| & =1\\cdot {C}_{31}+0\\cdot {C}_{32}+-1\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}2 & 1 \\\\ -2 & -3\\end{aligned}|+(-1)\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}3 & 2 \\\\ 0 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ -2 & -3\\end{aligned}|-|\\begin{aligned}3 & 2 \\\\ 0 & -2\\end{aligned}| \\\\  & =(-6+2)-(-6-0) \\\\  & =-4+6 \\\\  & =2\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n|\\begin{aligned}3 & 2 & 1 & 0 \\\\ 0 & -2 & -3 & -4 \\\\ 0 & 0 & 4 & 3 \\\\ 1 & 0 & -1 & 2\\end{aligned}|=4(-20)-3(2)=-86.\n$$"}] [{:db/id #edb/ref 17592186425352 :knowledge-point/_questions [{:db/id #edb/ref 17592186119774 :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e448fea-5855-52bc-a7dd-48d77cb4df08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|-7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|" :db/id #edb/ref 17592186425340} {:answer/id #uuid "573033dd-3b24-588e-815d-f15a4d5a4ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|+7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|" :db/id #edb/ref 17592186425342} {:answer/id #uuid "a302af15-3d2f-5841-a490-4042a6be47b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|" :db/id #edb/ref 17592186425345} {:answer/id #uuid "cd4a358d-1348-54aa-b944-266d98876cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|" :db/id #edb/ref 17592186425347} {:answer/id #uuid "ea7ef906-9479-54e2-b634-98c804680ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|-3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|" :db/id #edb/ref 17592186425348}] :answer-field/correct {:answer/id #uuid "573033dd-3b24-588e-815d-f15a4d5a4ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|+7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|" :db/id #edb/ref 17592186425342} :answer-field/id #uuid "ed2a715c-bbc0-55b9-9770-63cc37682a33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425351}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cd765ff8-911d-50bf-a599-8cf7e9df87e6" :question/math-academy-id "q-77807" :question/problem "$|\\begin{aligned}-4 & 0 & -3 & 0 \\\\ 5 & 3 & -4 & 0 \\\\ 4 & 6 & 5 & -3 \\\\ 8 & -9 & 6 & 7\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}-4 & 0 & -3 & 0 \\\\ 5 & 3 & -4 & 0 \\\\ 4 & 6 & 5 & -3 \\\\ 8 & -9 & 6 & 7\\end{aligned}| & =0\\cdot {C}_{14}+0\\cdot {C}_{24}+(-3)\\cdot {C}_{34}+7\\cdot {C}_{44} \\\\  & =(-3)\\cdot (-1)^{3+4}|\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|+7\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 8 & -9 & 6\\end{aligned}|+7\\cdot |\\begin{aligned}-4 & 0 & -3 \\\\ 5 & 3 & -4 \\\\ 4 & 6 & 5\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345342 :knowledge-point/_questions [{:db/id #edb/ref 17592186119774 :knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf7cfbc-f2b0-5684-bbfc-df2a4dfe1cd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|+7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|" :db/id #edb/ref 17592186343018} {:answer/id #uuid "6745fcba-99f1-5578-83b5-4b228c41d687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ 2 & 6 & -2 \\\\ -2 & -9 & 4\\end{aligned}|-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|" :db/id #edb/ref 17592186343115} {:answer/id #uuid "96c34368-3ce8-50f2-93cc-27f082bae5c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\cdot |\\begin{aligned}1 & -4 & 3 \\\\ -1 & 5 & -1 \\\\ 2 & 6 & -2\\end{aligned}|" :db/id #edb/ref 17592186343556} {:answer/id #uuid "a6f5b999-091a-5e45-b917-5e6ca067d8b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math