5-f74c2a28d4bf" 13194139533548 17592186045585 true] [17592186407659 1081 "\\frac{1}{y}\\,i-\\operatorname{sin}⁡x\\,j+3y{z}^{2}\\,k" 13194139533548 17592186045585 true] [17592186407659 1083 #edb/ref 17592186045499 13194139533548 17592186045585 true] [17592186407659 1084 #uuid "eecb625e-fb38-58c5-8c7d-425f0374e2c6" 13194139533548 17592186045585 true] [17592186407660 1075 #edb/ref 17592186407646 13194139533548 17592186045585 true] [17592186407660 1075 #edb/ref 17592186407647 13194139533548 17592186045585 true] [17592186407660 1075 #edb/ref 17592186407653 13194139533548 17592186045585 true] [17592186407660 1075 #edb/ref 17592186407654 13194139533548 17592186045585 true] [17592186407660 1075 #edb/ref 17592186407657 13194139533548 17592186045585 true] [17592186407660 1076 #edb/ref 17592186045493 13194139533548 17592186045585 true] [17592186407660 1077 "selection" 13194139533548 17592186045585 true] [17592186407660 1079 #edb/ref 17592186407646 13194139533548 17592186045585 true] [17592186407660 1080 #uuid "55f12593-79dd-5e1b-8574-a974a94bfc5a" 13194139533548 17592186045585 true] [17592186407661 1075 #edb/ref 17592186407645 13194139533548 17592186045585 true] [17592186407661 1075 #edb/ref 17592186407648 13194139533548 17592186045585 true] [17592186407661 1075 #edb/ref 17592186407649 13194139533548 17592186045585 true] [17592186407661 1075 #edb/ref 17592186407651 13194139533548 17592186045585 true] [17592186407661 1075 #edb/ref 17592186407655 13194139533548 17592186045585 true] [17592186407661 1076 #edb/ref 17592186045493 13194139533548 17592186045585 true] [17592186407661 1077 "selection" 13194139533548 17592186045585 true] [17592186407661 1079 #edb/ref 17592186407645 13194139533548 17592186045585 true] [17592186407661 1080 #uuid "f0ff6b8b-be06-5d38-bc53-8c8fbff6866c" 13194139533548 17592186045585 true] [17592186407662 1075 #edb/ref 17592186407650 13194139533548 17592186045585 true] [17592186407662 1075 #edb/ref 17592186407652 13194139533548 17592186045585 true] [17592186407662 1075 #edb/ref 17592186407656 13194139533548 17592186045585 true] [17592186407662 1075 #edb/ref 17592186407658 13194139533548 17592186045585 true] [17592186407662 1075 #edb/ref 17592186407659 13194139533548 17592186045585 true] [17592186407662 1076 #edb/ref 17592186045493 13194139533548 17592186045585 true] [17592186407662 1077 "selection" 13194139533548 17592186045585 true] [17592186407662 1079 #edb/ref 17592186407650 13194139533548 17592186045585 true] [17592186407662 1080 #uuid "fafbd1ee-fb02-5785-b3f4-4426b308c48e" 13194139533548 17592186045585 true] [17592186407663 1068 #edb/ref 17592186407661 13194139533548 17592186045585 true] [17592186407663 1069 "q-105572" 13194139533548 17592186045585 true] [17592186407663 1070 #edb/ref 17592186045487 13194139533548 17592186045585 true] [17592186407663 1071 "![](images/58/584016c88e5916984e181118d52caab95dba1fd0d861e0fd248a4e023d1b07da.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" 13194139533548 17592186045585 true] [17592186407663 1072 #uuid "2847820b-e13e-563d-bfbb-bab640514e5b" 13194139533548 17592186045585 true] [17592186407663 1074 "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vectors decrease as we move horizontally and vertically towards the origin. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\"" 13194139533548 17592186045585 true] [17592186407664 1068 #edb/ref 17592186407660 13194139533548 17592186045585 true] [17592186407664 1069 "q-105559" 13194139533548 17592186045585 true] [17592186407664 1070 #edb/ref 17592186045487 13194139533548 17592186045585 true] [17592186407664 1071 "Consider the vector field $F=\\operatorname{cos}⁡\\pi x\\,i+y\\operatorname{sin}⁡\\pi y\\,j+{e}^{2z}\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(0,1,0).$" 13194139533548 17592186045585 true] [17592186407664 1072 #uuid "f48c368c-417f-5ffe-9791-056b549ac545" 13194139533548 17592186045585 true] [17592186407664 1074 "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡\\pi x)+\\frac{∂}{∂y}(y\\operatorname{sin}⁡\\pi y)+\\frac{∂}{∂z}({e}^{2z}) \\\\  & =-\\pi \\operatorname{sin}⁡\\pi x+\\operatorname{sin}⁡\\pi y+\\pi y\\operatorname{cos}⁡\\pi y+2{e}^{2z}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(0,1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(0,1,0) & =-\\pi \\operatorname{sin}⁡(0)+\\operatorname{sin}⁡(\\pi )+\\pi \\operatorname{cos}⁡(\\pi )+2{e}^{0} \\\\  & =0+0-\\pi +2 \\\\  & =2-\\pi .\\end{aligned}\n$$" 13194139533548 17592186045585 true] [17592186407665 1058 #edb/ref 17592186407667 13194139533548 17592186045585 true] [17592186407665 1062 #uuid "1d73206f-cfb2-5389-b819-954a52ec5c0a" 13194139533548 17592186045585 true] [17592186407665 1063 #edb/ref 17592186407664 13194139533548 17592186045585 true] [17592186407666 1058 #edb/ref 17592186407665 13194139533548 17592186045585 true] [17592186407666 1062 #uuid "43f42226-1025-58c1-878e-7c4041f020a2" 13194139533548 17592186045585 true] [17592186407666 1063 #edb/ref 17592186134071 13194139533548 17592186045585 true] [17592186407667 1062 #uuid "84dd7364-713d-5340-9f9c-2da553617182" 13194139533548 17592186045585 true] [17592186407667 1063 #edb/ref 17592186407663 13194139533548 17592186045585 true]] :edb/tempids {"activity-23bb149c-27d7-5070-88b1-a3124f094ad2" 17592186407644 "answer-03e74b99-ee56-54e9-ae3f-42d5ee7c0a33" 17592186407645 "answer-08e054f8-7842-51d9-944e-506f086c64ff" 17592186407646 "answer-30bd69d5-9aed-5f53-bd57-88c0d8b71e93" 17592186407647 "answer-5070438f-bcf7-51c2-8463-01a5c462b9d7" 17592186407648 "answer-67f8c8f5-44cd-5c0e-a53a-65de21b3fa5a" 17592186407649 "answer-6c79d74f-4409-57e4-b361-e941cc41aa8f" 17592186407650 "answer-803f938a-69cc-5cc9-9644-a563d2a7cf5f" 17592186407651 "answer-941fb884-9dbd-5e6e-bdb3-9c13326a2f3e" 17592186407652 "answer-951b5e1a-06b7-5f54-b81b-2e7935528e41" 17592186407653 "answer-b2537554-7ead-5776-b7ea-b0a5c6ea2d72" 17592186407654 "answer-c3b2e55e-a370-570d-ba5a-e8f0f307eabf" 17592186407655 "answer-d9966256-2b26-5637-969d-ec652f55ff58" 17592186407656 "answer-de576d13-a320-57ea-81fe-65cb1f522e77" 17592186407657 "answer-ec0916bb-4bf2-5bfb-8625-f74c2a28d4bf" 17592186407658 "answer-eecb625e-fb38-58c5-8c7d-425f0374e2c6" 17592186407659 "answer-field-55f12593-79dd-5e1b-8574-a974a94bfc5a" 17592186407660 "answer-field-f0ff6b8b-be06-5d38-bc53-8c8fbff6866c" 17592186407661 "answer-field-fafbd1ee-fb02-5785-b3f4-4426b308c48e" 17592186407662 "question-2847820b-e13e-563d-bfbb-bab640514e5b" 17592186407663 "question-f48c368c-417f-5ffe-9791-056b549ac545" 17592186407664 "step-1d73206f-cfb2-5389-b819-954a52ec5c0a" 17592186407665 "step-43f42226-1025-58c1-878e-7c4041f020a2" 17592186407666 "step-84dd7364-713