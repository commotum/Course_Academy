#{[{:db/id #edb/ref 17592186262630 :knowledge-point/_questions [{:db/id #edb/ref 17592186133898 :knowledge-point/id #uuid "6b65b190-b587-5827-a160-b8df85b6227c" :knowledge-point/title "Calculating the Scalar Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221ac97f-6559-509a-a3d9-2450bf49633e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186260172} {:answer/id #uuid "a2757385-050d-54a8-8369-31a9aa26112c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+2x{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186261289} {:answer/id #uuid "b7289054-f9d1-5ae6-bd2a-f55dcf3e02b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186261483} {:answer/id #uuid "fbb179e1-20cb-58d0-b8da-a19ff4125371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262076} {:answer/id #uuid "fcd94cc3-eb96-53bb-8a15-64be7834efb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262088}] :answer-field/correct {:answer/id #uuid "fbb179e1-20cb-58d0-b8da-a19ff4125371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262076} :answer-field/id #uuid "8edf0788-7859-57f4-ac13-2b85b5bf5d5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b1f3451-5b4c-525b-84a2-e17f8516fc90" :question/math-academy-id "q-126547" :question/problem "Given that $F(x,y)={y}^{2}\\operatorname{ln}⁡({x}^{2}+1)\\,i+({x}^{2}-y)\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}({x}^{2}-y)-\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡({x}^{2}+1)) \\\\  & =2x-2y\\operatorname{ln}⁡({x}^{2}+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266079 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} {:answer/id #uuid "7a46d360-0b63-59bd-8d4c-b0aa9e72d4a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437857}] :answer-field/correct {:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} :answer-field/id #uuid "24781376-5a9f-5184-b064-24b3c476bb79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438957} {:answer-field/choices [{:answer/id #uuid "d33cbee7-fc8b-5c3d-bfba-41b228bb82bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437858} {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859}] :answer-field/correct {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859} :answer-field/id #uuid "dfb64428-9f16-5737-8c74-c42a032a0297" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438958} {:answer-field/choices [{:answer/id #uuid "058fa0b3-ef79-5a7a-afc6-113a760e3e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437860} {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861}] :answer-field/correct {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861} :answer-field/id #uuid "52c67e92-c96c-5d8b-b9f6-cc9263317637" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438959} {:answer-field/choices [{:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} {:answer/id #uuid "e701c30a-31e0-5846-a5ac-4931665193d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437863}] :answer-field/correct {:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} :answer-field/id #uuid "387cbfbf-b068-513c-93c4-71cb2f6085f2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a88235e-0bbc-5c38-af1d-92f6a6eda26f" :question/math-academy-id "q-131361" :question/problem "![](images/17/1709a94b7361a1e8764d94199f9e84802ae925a09e6481250d0846b83bb6549f.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the negative $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/7c/7c831425eae7afd709d546a8e05100f495adc04bba6450cfa56d370b415a28f5.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point into the screen. Therefore, $\\text{curl}\\,F$ also points into from the screen, in the direction of decreasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""}]}
