      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228291/observations/step-q345122-a53548f0110dc5b6aaed.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228291/observations/step-q345122-a53548f0110dc5b6aaed.png",
      "source_url": "https://mathacademy.com/tasks/14228291/topics/1845/review",
      "captured_at": 1792068297.650375,
      "math_academy_id": "q-345122",
      "topic_id": "1845",
      "sequence_position": null,
      "source_step": {
