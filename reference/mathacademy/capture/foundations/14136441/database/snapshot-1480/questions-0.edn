#{[{:db/id #edb/ref 17592186386696 :knowledge-point/_questions [{:db/id #edb/ref 17592186124496 :knowledge-point/id #uuid "5ee52fd3-6c79-5016-ade5-46e7bfbb557a" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given the Inverse Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef569771-c4e7-5291-a02a-eccb98516f64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186386698} {:answer/id #uuid "19f40148-c027-5e57-83ca-f9ce5e2e487f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 13\\end{aligned}]" :db/id #edb/ref 17592186386699} {:answer/id #uuid "f2dbac90-d79d-5e74-a3e8-3e28846fd99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386700} {:answer/id #uuid "8aadec7c-66e6-5275-836d-0b2d825fbd7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}28 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186386701} {:answer/id #uuid "54154bb7-e3f6-55f0-b690-aed92908791b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 \\\\ 26\\end{aligned}]" :db/id #edb/ref 17592186386702}] :answer-field/correct {:answer/id #uuid "8aadec7c-66e6-5275-836d-0b2d825fbd7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}28 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186386701} :answer-field/id #uuid "30675a92-d5d0-5d0c-a77d-9c525c8b8db4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386697}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ed39867-0f3e-5f3d-ab65-536828c9ba67" :question/math-academy-id "q-113573" :question/problem "The change-of-coordinates matrix from $B={{b}_{1},{b}_{2}}$ to $C={{c}_{1},{c}_{2}}$ is given below. Find $[x]_{B}$ given that $x=2{c}_{1}-4{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot (-8)-(-3)\\cdot 5}[\\begin{aligned}-8 & 3 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x=2{c}_{1}-4{c}_{2},$ we obtain\n\n$$\n[x]_{C}=[\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}28 \\\\ 18\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247379 :knowledge-point/_questions [{:db/id #edb/ref 17592186124497 :knowledge-point/id #uuid "7f58bd46-07f7-54a5-8499-5e4e3515b610" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in the Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05662116-9ed5-51f3-a508-b1ed64f2e349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186244359} {:answer/id #uuid "33a9596f-e4e0-5e92-b079-84b8cbdda157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ -11\\end{aligned}]" :db/id #edb/ref 17592186244776} {:answer/id #uuid "7294001d-9a70-5e64-8833-bfc2b3f3c0db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}25 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186245337} {:answer/id #uuid "b6b79f00-6365-55a2-9673-e57f0f1960c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 21\\end{aligned}]" :db/id #edb/ref 17592186245947} {:answer/id #uuid "f5b08e24-4041-566d-9201-1f4cbd15de31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186246483}] :answer-field/correct {:answer/id #uuid "05662116-9ed5-51f3-a508-b1ed64f2e349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186244359} :answer-field/id #uuid "12b31fac-75a2-50ec-9978-bbb512fe8ff1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "162a4f62-2177-5623-998d-5746dbddde07" :question/math-academy-id "q-113606" :question/problem "$$\nB=\\{[\\begin{aligned}5 \\\\ -3\\end{aligned}],[\\begin{aligned}-7 \\\\ 6\\end{aligned}]\\},\\,[x]_{S}=[\\begin{aligned}18 \\\\ -9\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}5 & -7 \\\\ -3 & 6\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 6-(-7)\\cdot (-3)}[\\begin{aligned}6 & 7 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}\\frac{2}{3} & \\frac{7}{9} \\\\ \\frac{1}{3} & \\frac{5}{9}\\end{aligned}][\\begin{aligned}18 \\\\ -9\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323807 :knowledge-point/_questions [{:db/id #edb/ref 17592186124496 :knowledge-point/id #uuid "5ee52fd3-6c79-5016-ade5-46e7bfbb557a" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given the Inverse Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e412cca-3de6-5980-bb99-cf3bccf43fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186321257} {:answer/id #uuid "137c55e3-1ce7-52fa-871f-4778b481186a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186321301} {:answer/id #uuid "930eac4b-99c1-548d-911a-4f0dbf0771a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186322310} {:answer/id #uuid "9dd98043-a25b-5027-a9f0-593fb49217d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186322391} {:answer/id #uuid "d2cab1f4-06ce-5d69-9f7d-a3f736d395e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186322794}] :answer-field/correct {:answer/id #uuid "9dd98043-a25b-5027-a9f0-593fb49217d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186322391} :answer-field/id #uuid "3e47d3d8-0d42-5d02-8f6a-ceceea2fa24c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323291}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76994fe0-8052-50ba-9dfa-9fe567d9b172" :question/math-academy-id "q-36485" :question/problem "The change-of-coordinates matrix from $B$ to $C$ and the coordinates of the vector $x$ relative to the basis $C$ are given below. What is $[x]_{B}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}],\\,[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-4)-3\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\end{aligned}\n$$"}]}
