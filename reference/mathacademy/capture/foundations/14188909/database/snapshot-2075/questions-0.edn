#{[{:db/id #edb/ref 17592186490290 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9115f7-c967-552e-babd-64a7c492372a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186489621} {:answer/id #uuid "375f59e1-b6c5-51a0-ad58-23511b54c59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186489638} {:answer/id #uuid "3c97f35c-4480-5e3e-a894-f3effca05b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489651} {:answer/id #uuid "5959bb5d-4929-5707-80e3-51ab7b1c379f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186489733} {:answer/id #uuid "cc31709a-e3d1-56b4-9a97-dea545336cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186489966}] :answer-field/correct {:answer/id #uuid "3c97f35c-4480-5e3e-a894-f3effca05b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186489651} :answer-field/id #uuid "59271587-d957-593c-984d-f14328120bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abc95782-56f0-5602-a797-77bbd8bc8d07" :question/math-academy-id "q-160382" :question/problem "For the transformation $T,$ defined as\n\n$$\nT([\\begin{aligned}u \\\\ v\\end{aligned}])⟶[\\begin{aligned}uv \\\\ \\operatorname{ln}⁡(\\frac{u}{v})\\end{aligned}]\n$$\n\n  \n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 3\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\operatorname{ln}⁡(\\frac{u}{v}).$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =\\frac{1}{u} & \\,\\frac{∂y}{∂v} & =-\\frac{1}{v}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v & u \\\\ \\frac{1}{u} & -\\frac{1}{v}\\end{aligned}| \\\\  & =v\\cdot (-\\frac{1}{v})-u\\cdot \\frac{1}{u} \\\\  & =-2.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 3\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,3)}=-2.\n$$"}] [{:db/id #edb/ref 17592186389195 :knowledge-point/_questions [{:db/id #edb/ref 17592186129283 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2407dcd5-06ff-568b-bb6d-b2494e2bd942" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c244350524a52123e2e97db4cd8eb4f57737b8b15746eb72a8d54eac32a4f3cf.png" :db/id #edb/ref 17592186389197} {:answer/id #uuid "07712d2e-2b92-521c-b6ae-d43d00f464d9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/13/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186389198} {:answer/id #uuid "cc3ba601-6388-5b1c-ac01-5522063f4425" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fd2a51ca3a1654c2e857018268bf251366472a2c5d7f90009d5ccfbf1b1edd9d.png" :db/id #edb/ref 17592186389199} {:answer/id #uuid "dc797ebb-78cb-5a5b-ac03-97f75fe59dce" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389200} {:answer/id #uuid "2201cc6c-a008-5122-982f-2699a2c582b8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/95bf5e059fda0fc1ba8423b35fffa57d9cae0cc2a2a7e40b0c2539b6a7ae7678.png" :db/id #edb/ref 17592186389201}] :answer-field/correct {:answer/id #uuid "2407dcd5-06ff-568b-bb6d-b2494e2bd942" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c244350524a52123e2e97db4cd8eb4f57737b8b15746eb72a8d54eac32a4f3cf.png" :db/id #edb/ref 17592186389197} :answer-field/id #uuid "644861a4-b1bb-5e40-b887-ad0f73e8386a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "82d50c5e-c224-54bc-84fa-f5633f671803" :question/math-academy-id "q-161840" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}+{v}^{2} \\\\ v-u\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}+{v}^{2} \\\\ v-u\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & 2v \\\\ -1 & 1\\end{aligned}| \\\\  & =2u\\cdot 1-(-1)\\cdot (2v) \\\\  & =2u+2v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2u+2v & <0 \\\\ 2v & <-2u \\\\ v & <-u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-u\n$$\n\ndefines a straight line, and the coordinates of, say, $(-1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/c2/c244350524a52123e2e97db4cd8eb4f57737b8b15746eb72a8d54eac32a4f3cf.png)"}] [{:db/id #edb/ref 17592186389209 :knowledge-point/_questions [{:db/id #edb/ref 17592186129283 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72f242ce-c65f-5c89-b0bc-7d65d210918f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c244350524a52123e2e97db4cd8eb4f57737b8b15746eb72a8d54eac32a4f3cf.png" :db/id #edb/ref 17592186389211} {:answer/id #uuid "62f79a35-0524-561a-ba91-d11cf1227837" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4d/4d944eb13437b86c0cf6ae4fa8bca09031ed0f2f85a9f20bcb0050a6de9f8ebb.png" :db/id #edb/ref 17592186389212} {:answer/id #uuid "cfa99b0c-e94e-5958-a986-2c13e020da52" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389213} {:answer/id #uuid "acff9e64-428c-54e8-8971-9f328584d347" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389214} {:answer/id #uuid "2b75873a-335e-5bb0-9312-2f0d35d3633e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7bc22ac4dfd2d7015952144ece63f91ecccef2a992649aece60dc8a70f1d018.png" :db/id #edb/ref 17592186389215}] :answer-field/correct {:answer/id #uuid "cfa99b0c-e94e-5958-a986-2c13e020da52" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389213} :answer-field/id #uuid "317c3736-80dd-5537-ba65-91575de09aa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389210}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e552dcc6-87b8-5585-84f4-2c455a9099f1" :question/math-academy-id "q-161856" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}+2v \\\\ -2u-{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}+2v \\\\ -2u-{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & 2 \\\\ -2 & -2v\\end{aligned}| \\\\  & =2u\\cdot (-2v)-(-2)\\cdot 2 \\\\  & =-4uv+4.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-4uv+4 & <0 \\\\ -4uv & <-4 \\\\ uv & >1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v>\\frac{1}{u}$ for $u>0$ and $v<\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,2)$ and $(-1,-2)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n   \n\n![](images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png)"}] [{:db/id #edb/ref 17592186281367 :knowledge-point/_questions [{:db/id #edb/ref 17592186129282 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9515a0-7aca-5bd0-93c2-b5138c7c3052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,\\delta A" :db/id #edb/ref 17592186279294} {:answer/id #uuid "62fb6c42-d7b5-5116-b4d8-c608240b0020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279491} {:answer/id #uuid "65e00832-3370-516f-bf0e-931f9e463a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\,\\delta A" :db/id #edb/ref 17592186279521} {:answer/id #uuid "c042a147-a78a-546c-adff-8d9859d6b5eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186280284} {:answer/id #uuid "df364235-b831-5c0a-a5fa-907e835f3022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186280559}] :answer-field/correct {:answer/id #uuid "62fb6c42-d7b5-5116-b4d8-c608240b0020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279491} :answer-field/id #uuid "3c8c07a6-1fb4-5da8-abe5-ac2081b48db6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9201622d-d447-58b4-8006-2fbea11393d4" :question/math-academy-id "q-161874" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(4,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\sqrt{u}+{v}^{2} \\\\ uv\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{2\\sqrt{u}} & 2v \\\\ v & u\\end{aligned}| \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot u-v\\cdot 2v \\\\  & =\\frac{1}{2}\\sqrt{u}-2{v}^{2} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(4,2)} & ={\\frac{1}{2}\\sqrt{u}-2{v}^{2}\\,|}_{u=4\\,v=2} \\\\  & =\\frac{1}{2}\\sqrt{4}-2(2)^{2} \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-7|\\cdot \\delta A \\\\  & =7\\,\\delta A.\\end{aligned}\n$$"}]}
