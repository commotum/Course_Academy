#{[{:db/id #edb/ref 17592186167078 :knowledge-point/_questions [{:db/id #edb/ref 17592186166856 :knowledge-point/id #uuid "269d8bf1-f092-5352-a689-35b2978b163b" :knowledge-point/title "The Variance of a  Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1608335-135d-518f-b0f8-9d14f1148e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186163547} {:answer/id #uuid "bf4d0544-6ad8-5103-8c56-091eafd7f5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186163548} {:answer/id #uuid "049f0e31-087f-545b-a089-f313f3063bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186163549} {:answer/id #uuid "0e250c9e-c165-578b-9fe5-a70487768653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186163550} {:answer/id #uuid "23e3423b-695d-56f2-9c74-65be2374abc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.04" :db/id #edb/ref 17592186163551}] :answer-field/correct {:answer/id #uuid "0e250c9e-c165-578b-9fe5-a70487768653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186163550} :answer-field/id #uuid "5b75e96e-6286-569e-8a97-9f97357e7c1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b606a84e-9f53-5e58-b319-b9877d0150ac" :question/math-academy-id "q-112759" :question/problem "Given that $X∼\\text{Exp}(0.2),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(0.2),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(0.2)}^{2}} \\\\  & =\\frac{1}{0.04} \\\\  & =25\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442841 :knowledge-point/_questions [{:db/id #edb/ref 17592186166856 :knowledge-point/id #uuid "269d8bf1-f092-5352-a689-35b2978b163b" :knowledge-point/title "The Variance of a  Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fdcd7a-935f-5b89-954e-94cfe53551b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442818} {:answer/id #uuid "4ec31d2e-690a-53af-8152-9fa7d7a9b34e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442823} {:answer/id #uuid "6af5ae31-0114-5767-80ce-a1faf0e59131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186442826} {:answer/id #uuid "d09b5346-0b32-599f-8cfd-4d40bae72ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186442835} {:answer/id #uuid "f43ab765-767d-579c-9eae-df2ab5f23f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186442836}] :answer-field/correct {:answer/id #uuid "08fdcd7a-935f-5b89-954e-94cfe53551b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442818} :answer-field/id #uuid "381abdbc-0501-57da-9b23-4cb39840288c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc4b9d8-5da7-5586-a518-10322d637373" :question/math-academy-id "q-132362" :question/problem "Given that $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442844 :knowledge-point/_questions [{:db/id #edb/ref 17592186166868 :knowledge-point/id #uuid "ddb0f6dc-ae8d-59e3-abf9-744916a0bfb1" :knowledge-point/title "Modeling With the Mean of an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aa5558-5072-53e7-bd58-cf7c7ba5a133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ seconds" :db/id #edb/ref 17592186442819} {:answer/id #uuid "33219482-ef34-597b-b10a-a5cf5d960dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ minute" :db/id #edb/ref 17592186442822} {:answer/id #uuid "530f6bf8-4fcb-5c94-9cee-6007d643f0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ minutes" :db/id #edb/ref 17592186442824} {:answer/id #uuid "8acfbc95-a05b-5d37-8140-8a62e5da7a2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds" :db/id #edb/ref 17592186442828} {:answer/id #uuid "d06dab70-fbd9-57eb-9947-fb23ab39c34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ minutes" :db/id #edb/ref 17592186442834}] :answer-field/correct {:answer/id #uuid "d06dab70-fbd9-57eb-9947-fb23ab39c34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ minutes" :db/id #edb/ref 17592186442834} :answer-field/id #uuid "e7049d2d-fc9f-5f20-8e5c-02896d997034" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bbd9b202-0edb-5252-b84c-96bc38834bd7" :question/math-academy-id "q-132627" :question/problem "The time $X,$ in minutes, between two visitors entering a restaurant can be modeled as an exponential random variable $X∼\\text{Exp}(\\frac{1}{2}).$ If a visitor has just entered the restaurant, what is the average time until the next visitor enters?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(\\frac{1}{2}).$ Therefore, $\\lambda =\\frac{1}{2},$ and\n\n$$\n\\text{E}[X]=\\frac{1}{(\\frac{1}{2})}\\,\\text{min}=2\\,\\text{min}.\n$$\n\nTherefore, the average time until the next visitor is $2$ minutes."}] [{:db/id #edb/ref 17592186442843 :knowledge-point/_questions [{:db/id #edb/ref 17592186166868 :knowledge-point/id #uuid "ddb0f6dc-ae8d-59e3-abf9-744916a0bfb1" :knowledge-point/title "Modeling With the Mean of an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe74356-49b8-543c-8d6e-d896f6be8ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ weeks" :db/id #edb/ref 17592186442821} {:answer/id #uuid "894f80a8-661c-52a9-bf68-6f0f805aa1ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ days" :db/id #edb/ref 17592186442827} {:answer/id #uuid "991ebd97-1bba-53d6-8eb0-37ded272c11a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ week" :db/id #edb/ref 17592186442830} {:answer/id #uuid "ac92feca-9b24-5ba3-8997-1c3b5fdc560b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ day" :db/id #edb/ref 17592186442832} {:answer/id #uuid "bba18b49-af2d-51f5-a5ee-8ea2b7824778" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ days" :db/id #edb/ref 17592186442833}] :answer-field/correct {:answer/id #uuid "ac92feca-9b24-5ba3-8997-1c3b5fdc560b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ day" :db/id #edb/ref 17592186442832} :answer-field/id #uuid "972739f9-2ca7-5e51-8be2-cdc627574abe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ced14e8-8144-5a90-a159-85ee1ea70744" :question/math-academy-id "q-138314" :question/problem "The time $X,$ in weeks, between two grandkids visiting their grandma can be modeled as an exponential random variable $X∼\\text{Exp}(7).$ If a grandkid has just visited their grandma, what is the average time until the next grandkid visits their grandma?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(7).$ Therefore, $\\lambda =7,$ which means that grandkids visit their grandma at an average rate of $7$ visits per week. Hence,\n\n$$\n\\text{E}[X]=\\frac{1}{7}\\,\\text{week}=1\\,\\text{day}.\n$$\n\nTherefore, the average time until the next grandkid's visit is $1$ day."}] [{:db/id #edb/ref 17592186442842 :knowledge-point/_questions [{:db/id #edb/ref 17592186166868 :knowledge-point/id #uuid "ddb0f6dc-ae8d-59e3-abf9-744916a0bfb1" :knowledge-point/title "Modeling With the Mean of an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05547d8f-b729-55a9-8be3-036d66839167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ hours" :db/id #edb/ref 17592186442817} {:answer/id #uuid "2520da57-e0e2-58df-b3cf-ec9420890983" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ days" :db/id #edb/ref 17592186442820} {:answer/id #uuid "611a9703-d8be-5d7c-b587-568f34b6ac1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ days" :db/id #edb/ref 17592186442825} {:answer/id #uuid "902763c5-4b29-5719-bd61-94b503ffbf10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ hours" :db/id #edb/ref 17592186442829} {:answer/id #uuid "9f233499-e299-5d78-8480-e3546726af7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours" :db/id #edb/ref 17592186442831}] :answer-field/correct {:answer/id #uuid "9f233499-e299-5d78-8480-e3546726af7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours" :db/id #edb/ref 17592186442831} :answer-field/id #uuid "8efe295c-e280-5ef7-a7b5-b62fe5c12fd4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "358a711e-17d9-56a3-a7f2-d4538d452099" :question/math-academy-id "q-138321" :question/problem "The time $X,$ in days, between two doses of medication in a patient's treatment can be modeled as an exponential random variable $X∼\\text{Exp}(6).$ If a dose has just been taken by the patient, what is the average time until the next dose?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(6).$ Therefore, $\\lambda =6,$ which means that $6$ doses are taken each day. Hence,\n\n$$\n\\text{E}[X]=\\frac{1}{6}\\,\\text{day}=4\\,\\text{h}.\n$$\n\nTherefore, the average time until the next dose is $4$ hours."}]}
