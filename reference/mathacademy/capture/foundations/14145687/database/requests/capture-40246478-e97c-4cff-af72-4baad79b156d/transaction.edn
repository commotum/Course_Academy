[{:db/id 17592186166856 :knowledge-point/questions ["question-0dc4b9d8-5da7-5586-a518-10322d637373"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167078 :question/problem "Given that $X∼\\text{Exp}(0.2),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(0.2),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(0.2)}^{2}} \\\\  & =\\frac{1}{0.04} \\\\  & =25\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186163546 :answer-field/correct 17592186163550 :db/ensure [:answer-field/validate]} {:db/id "question-0dc4b9d8-5da7-5586-a518-10322d637373" :question/id #uuid "0dc4b9d8-5da7-5586-a518-10322d637373" :question/math-academy-id "q-132362" :question/problem "Given that $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-381abdbc-0501-57da-9b23-4cb39840288c"] :db/ensure [:question/validate]} {:db/id "answer-field-381abdbc-0501-57da-9b23-4cb39840288c" :answer-field/id #uuid "381abdbc-0501-57da-9b23-4cb39840288c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08fdcd7a-935f-5b89-954e-94cfe53551b5" :answer-field/choices ["answer-08fdcd7a-935f-5b89-954e-94cfe53551b5" "answer-4ec31d2e-690a-53af-8152-9fa7d7a9b34e" "answer-6af5ae31-0114-5767-