#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186551466} :activity/id #uuid "c46cfffe-18b2-5eac-8e1f-91eedc4c8269" :activity/scope {:db/id #edb/ref 17592186050615 :topic/id #uuid "58ea9fa1-e1b7-56f7-a58d-173ed320b2af" :topic/math-academy-id 6369} :activity/steps [{:db/id #edb/ref 17592186551385 :step/content {:db/id #edb/ref 17592186368088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71126cdc-4db1-5d85-972e-cd3f7216926d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{{s}^{3}}+\\frac{5}{(s-1)^{5}}" :db/id #edb/ref 17592186368090} {:answer/id #uuid "1f938eca-5b97-5407-a40f-c988b2a16b67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{{s}^{3}}+\\frac{120}{(s-1)^{5}}" :db/id #edb/ref 17592186368091} {:answer/id #uuid "9820ac7b-3cc2-5748-8cbc-e6f3462796e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{{s}^{3}}+\\frac{24}{(s-1)^{5}}" :db/id #edb/ref 17592186368092} {:answer/id #uuid "8afdd9ac-60ed-53f4-9d08-0c4a351de9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{{s}^{3}}+\\frac{120}{(s-1)^{5}}" :db/id #edb/ref 17592186368093} {:answer/id #uuid "37dc610f-9fa4-543d-8aae-3cf583648376" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{{s}^{2}}+\\frac{120}{(s-1)^{4}}" :db/id #edb/ref 17592186368094}] :answer-field/correct {:db/id #edb/ref 17592186368093} :answer-field/id #uuid "5ff80550-7623-5ff1-866b-cae616e84c57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368089}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7b5c8893-14eb-5d02-a313-3aa760c297c7" :question/math-academy-id "q-332128" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)=7{t}^{2}+5{t}^{4}{e}^{t}$ for $s>1.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{7{t}^{2}+5{t}^{4}{e}^{t}\\} \\\\  & =L\\{7{t}^{2}\\}+L\\{5{t}^{4}{e}^{t}\\} \\\\  & =7L\\{{t}^{2}\\}+5L\\{{t}^{4}{e}^{t}\\}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L\\{{t}^{2}\\} & =\\frac{2}{{s}^{3}} \\\\ L\\{{t}^{4}\\} & =\\frac{24}{{s}^{5}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L\\{f(t)\\}=F(s),$ then $L\\{{e}^{at}f(t)\\}=F(s-a).$ Therefore,\n\n$$\nL\\{{t}^{4}{e}^{t}\\}=\\frac{24}{(s-1)^{5}}.\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =7L\\{{t}^{2}\\}+5L\\{{t}^{4}{e}^{t}\\} \\\\  & =7\\cdot \\frac{2}{{s}^{3}}+5\\cdot \\frac{24}{(s-1)^{5}} \\\\  & =\\frac{14}{{s}^{3}}+\\frac{120}{(s-1)^{5}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>1.$"} :step/id #uuid "34e3daa2-8ba3-59ec-8c00-c52a7eef4a03"} {:db/id #edb/ref 17592186551395 :step/content {:db/id #edb/ref 17592186551330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01421a14-fbdd-550a-bb28-30816a633bd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(s)" :db/id #edb/ref 17592186550373} {:answer/id #uuid "b4e2249c-de4b-59f7-8146-a8b2909f33c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(s-6)" :db/id #edb/ref 17592186550862} {:answer/id #uuid "e1a8eccc-9669-52a0-a6c4-8e5789eba8f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "W(s+6)" :db/id #edb/ref 17592186550985}] :answer-field/correct {:db/id #edb/ref 17592186550985} :answer-field/id #uuid "0be05dc0-5dcb-5229-97d5-3889f2b77acc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551069} {:answer-field/choices [{:answer/id #uuid "bc516240-edf6-50de-a972-2d32bd44c276" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186550886} {:answer/id #uuid "e60983fa-e6a9-5ac0-89a9-689d559fbabd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}-6" :db/id #edb/ref 17592186550993} {:answer/id #uuid "e9fce1b0-8710-5564-a541-83b6838d2cc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}+6" :db/id #edb/ref 17592186550999}] :answer-field/correct {:db/id #edb/ref 17592186550993} :answer-field/id #uuid "3e04132d-f893-5504-93e7-bc8007db050d" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551104} {:answer-field/choices [{:answer/id #uuid "743d231d-3125-555f-a732-b18231046dba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s-6)t}" :db/id #edb/ref 17592186550661} {:answer/id #uuid "7dadd7cf-b74d-5865-8e1f-964dae9d2bb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s+6)t}" :db/id #edb/ref 17592186550679} {:answer/id #uuid "87a865e2-5879-5874-8e7e-ed9ac14c8e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s-6)t}" :db/id #edb/ref 17592186550710} {:answer/id #uuid "96edeea9-662f-543c-958b-a437a0bb825b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s+6)t}" :db/id #edb/ref 17592186550751}] :answer-field/correct {:db/id #edb/ref 17592186550679} :answer-field/id #uuid "5331794b-edb9-5987-ad14-749201d4047c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551114} {:answer-field/choices [{:answer/id #uuid "150effe3-7d43-5fa4-9d1a-07dccdbc82d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{6t}w(t)" :db/id #edb/ref 17592186550412} {:answer/id #uuid "3f14ab23-4462-5f82-981d-d6cd0d7fa272" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{-6t}w(t)" :db/id #edb/ref 17592186550510} {:answer/id #uuid "adb382f7-cd8b-5a3c-9d6e-49dc55e97be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{-6t}w(t)" :db/id #edb/ref 17592186550836} {:answer/id #uuid "ff58dc45-b2dd-597e-b3ee-585688a5229f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{6t}w(t)" :db/id #edb/ref 17592186551054}] :answer-field/correct {:db/id #edb/ref 17592186550836} :answer-field/id #uuid "74110f7b-0273-51e4-a4d8-5ebb7a3df510" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551132}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/math-academy-id "q-331792" :question/problem "Consider a function $w(t)$ such that its Laplace transform is $L\\{w(t)\\}=W(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{-6t}w(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,w(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-6t}\\,w(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $W(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,w(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t=W(s+6),\n$$\n\nwhere \n\n$$\ns+6>{s}_{0}\\,⇒\\,s>{s}_{0}-6.\n$$"} :step/id #uuid "4352ef4f-23b6-5c61-ac25-56e4098a43c6" :step/next {:db/id #edb/ref 17592186551385}} {:db/id #edb/ref 17592186551466 :step/content {:db/id #edb/ref 17592186551233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f4facf-480c-575f-b09c-5c3bfbccd39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s-3)t}" :db/id #edb/ref 17592186550382} {:answer/id #uuid "21fff9cb-25a4-576b-bbc7-e8761dd6a9ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s+3)t}" :db/id #edb/ref 17592186550443} {:answer/id #uuid "8d0f5080-456e-5190-ba35-fb2f45ed0d10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s-3)t}" :db/id #edb/ref 17592186550728} {:answer/id #uuid "9fd3ad9c-eb6c-5075-bd57-91281dbc1bee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s+3)t}" :db/id #edb/ref 17592186550779}] :answer-field/correct {:db/id #edb/ref 17592186550382} :answer-field/id #uuid "02bc9620-90dd-5010-be23-891afbacbab1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551062} {:answer-field/choices [{:answer/id #uuid "06378f8e-e69c-5cd0-b88f-0bbbf42e9a3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}+3" :db/id #edb/ref 17592186550387} {:answer/id #uuid "d3b50d8f-1121-5e49-9edb-b9db592fac11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}-3" :db/id #edb/ref 17592186550942} {:answer/id #uuid "ebfbc9f8-0e10-5337-8153-ddd9ca9629f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186551005}] :answer-field/correct {:db/id #edb/ref 17592186550387} :answer-field/id #uuid "0cfeab26-b8e8-5d3e-bf00-0e9d0ae6a55c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551070} {:answer-field/choices [{:answer/id #uuid "b3e29a46-3178-54ff-a783-5f42dc9353f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s-3)" :db/id #edb/ref 17592186550857} {:answer/id #uuid "bf777f37-7483-5e9e-b2a9-35c6aa3ac7b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)" :db/id #edb/ref 17592186550893} {:answer/id #uuid "cd7b1c65-0a50-5c1c-aa84-63f14f5a3427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s+3)" :db/id #edb/ref 17592186550919}] :answer-field/correct {:db/id #edb/ref 17592186550857} :answer-field/id #uuid "7870880a-6cb4-54d1-9b74-b04ea6ec049c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551135} {:answer-field/choices [{:answer/id #uuid "42977ec0-6216-5444-bbcb-9b089427c15c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{3t}r(t)" :db/id #edb/ref 17592186550524} {:answer/id #uuid "74329352-03c2-598b-b3b8-cf7fa3c1748f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{-3t}r(t)" :db/id #edb/ref 17592186550660} {:answer/id #uuid "a81fbb90-ddcd-5c5b-a412-d6fee1a8fc5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{-3t}r(t)" :db/id #edb/ref 17592186550812} {:answer/id #uuid "aabb5487-1892-55ca-ba49-3577102d61e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{3t}r(t)" :db/id #edb/ref 17592186550826}] :answer-field/correct {:db/id #edb/ref 17592186550826} :answer-field/id #uuid "b2cf6229-1b40-568c-b2ae-1e954c9aa404" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186551173}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "002b6494-db6e-5c52-baa6-f8349498d2c1" :question/math-academy-id "q-331789" :question/problem "Consider a function $r(t)$ such that its Laplace transform is $L\\{r(t)\\}=R(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{3t}r(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{3t}r(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,r(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{3t}r(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{3t}\\,r(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-3)t}\\,r(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $R(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,r(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-3)t}\\,r(t)\\,\\text{d}t=R(s-3),\n$$\n\nwhere \n\n$$\ns-3>{s}_{0}\\,⇒\\,s>{s}_{0}+3.\n$$"} :step/id #uuid "f579c56e-583e-5d0a-8431-cb59e1d5eecc" :step/next {:db/id #edb/ref 17592186551395}}] :activity/title "The First Shifting Theorem of Laplace Transforms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550360}]}
