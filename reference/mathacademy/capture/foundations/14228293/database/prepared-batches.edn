52-baa6-f8349498d2c1" :question/answer-fields "answer-field-02bc9620-90dd-5010-be23-891afbacbab1"] ["question-002b6494-db6e-5c52-baa6-f8349498d2c1" :question/answer-fields "answer-field-7870880a-6cb4-54d1-9b74-b04ea6ec049c"] ["question-002b6494-db6e-5c52-baa6-f8349498d2c1" :question/answer-fields "answer-field-0cfeab26-b8e8-5d3e-bf00-0e9d0ae6a55c"] [17592186221436 :knowledge-point/questions "question-002b6494-db6e-5c52-baa6-f8349498d2c1"] ["question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/id #uuid "bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28"] ["question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/math-academy-id "q-331792"] ["question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/problem "Consider a function $w(t)$ such that its Laplace transform is $L\\{w(t)\\}=W(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{-6t}w(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,w(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$"] ["question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{-6t}w(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-6t}\\,w(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $W(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,w(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+6)t}\\,w(t)\\,\\text{d}t=W(s+6),\n$$\n\nwhere \n\n$$\ns+6>{s}_{0}\\,⇒\\,s>{s}_{0}-6.\n$$"] ["question-bf25d1c4-52d6-5c8a-89b9-2f0b3253eb28" :question/difficulty :question.difficulty/easy] ["answer-field-74110f7b-0273-51e4-a4d8-5ebb7a3df510" :answer-field/id #uuid "74110f7b-0273-51e4-a4d8-5ebb7a3df510"] ["answer-adb382f7