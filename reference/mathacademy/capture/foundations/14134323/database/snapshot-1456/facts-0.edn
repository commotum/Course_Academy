f 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280088 #edb/ref 1083 #uuid "a8e99c71-ce7b-5a57-8b35-eff03f28886a" #edb/ref 17592186045417] [17592186280271 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186280271 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280271 #edb/ref 1083 #uuid "bee5e71a-fc3b-5642-9353-bcf840af6970" #edb/ref 17592186045417] [17592186280483 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186280483 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280483 #edb/ref 1083 #uuid "d650e02b-bf8f-5b88-a546-cd6aa55f62f1" #edb/ref 17592186045417] [17592186280628 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186280628 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280628 #edb/ref 1083 #uuid "e733f81f-7e5b-56da-a2cd-22f5cd7afff6" #edb/ref 17592186045417] [17592186280960 #edb/ref 1075 #edb/ref 17592186278761 #edb/ref 17592186045417] [17592186280960 #edb/ref 1075 #edb/ref 17592186280088 #edb/ref 17592186045417] [17592186280960 #edb/ref 1075 #edb/ref 17592186280271 #edb/ref 17592186045417] [17592186280960 #edb/ref 1075 #edb/ref 17592186280483 #edb/ref 17592186045417] [17592186280960 #edb/ref 1075 #edb/ref 17592186280628 #edb/ref 17592186045417] [17592186280960 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280960 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280960 #edb/ref 1078 #edb/ref 17592186280483 #edb/ref 17592186045417] [17592186280960 #edb/ref 1079 #uuid "4f5d13f4-2cb9-5ffa-b608-20e5bb1d0372" #edb/ref 17592186045417] [17592186281404 #edb/ref 1068 #edb/ref 17592186280960 #edb/ref 17592186045417] [17592186281404 #edb/ref 1069 "q-162195" #edb/ref 17592186045417] [17592186281404 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281404 #edb/ref 1071 "Consider the affine transformation $T,$ defined as\n\n$$\nx=2u-2v-3,\\,y=u-v+2.\n$$\n\nWhat is the area scale factor of the transformation?" #edb/ref 17592186045417] [17592186281404 #edb/ref 1072 #uuid "79b6b1e2-201b-5b88-aae8-abebb7edf5f4" #edb/ref 17592186045417] [17592186281404 #edb/ref 1074 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-2v-3 \\\\ u-v+2\\end{aligned}] \\\\  & =[\\begin{aligned}2u-2v \\\\ u-v\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-3 \\\\ 2\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}].$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}|=2\\cdot (-1)-1\\cdot (-2)=0.\n$$\n\nSo, the area scale factor of the transformation is\n\n$$\n|det(A)|=|0|=0.\n$$" #edb/ref 17592186045417] [17592186364914 #edb/ref 1075 #edb/ref 17592186364915 #edb/ref 17592186045417] [17592186364914 #edb/ref 1075 #edb/ref 17592186364916 #edb/ref 17592186045417] [17592186364914 #edb/ref 1075 #edb/ref 17592186364917 #edb/ref 17592186045417] [17592186364914 #edb/ref 1075 #edb/ref 17592186364918 #edb/ref 17592186045417] [17592186364914 #edb/ref 1075 #edb/ref 17592186364919 #edb/ref 17592186045417] [17592186364914 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186364914 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186364914 #edb/ref 1078 #edb/ref 17592186364917 #edb/ref 17592186045417] [17592186364914 #edb/ref 1079 #uuid "3654e763-779e-5611-b4b5-b394a98f43a3" #edb/ref 17592186045417] [17592186364915 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186364915 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364915 #edb/ref 1083 #uuid "2c730df9-6548-5576-ba64-558226099add" #edb/ref 17592186045417] [17592186364916 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186364916 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364916 #edb/ref 1083 #uuid "b366d454-2c12-5c37-a81b-f48f317a5394" #edb/ref 17592186045417] [17592186364917 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186364917 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364917 #edb/ref 1083 #uuid "86c803ea-012c-568d-90f8-bce9b0ec9560" #edb/ref 17592186045417] [17592186364918 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186364918 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364918 #edb/ref 1083 #uuid "cb699b26-8700-53e1-89a0-b258c6ab715c" #edb/ref 17592186045417] [17592186364919 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186364919 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186364919 #edb/ref 1083 #uuid "a9a37d2a-7bd5-528f-9255-1cf91b830b77" #edb/ref 17592186045417] [17592186387519 #edb/ref 1068 #edb/ref 17592186387520 #edb/ref 17592186045417] [17592186387519 #edb/ref 1069 "q-124569" #edb/ref 17592186045417] [17592186387519 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186387519 #edb/ref 1071 "![](images/de/deff964a1833339681fc38b30e32ebd3081e7ba1c4b5aabd0f4998f60a2aa78c.png)\n\nConsider the triangle $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,-1\\le v\\le 1,\\,\\frac{v-1}{2}\\le u\\le \\frac{1-v}{2}}.\n$$\n\nThe transformation $T$ is defined as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nWhich of the following gives the image of $Δ$ in the $xy$-plane under the action of $T?$" #edb/ref 17592186045417] [17592186387519 #edb/ref 1072 #uuid "e48d3f9e-79f6-5f88-9764-fe40dc9cde3f" #edb/ref 17592186045417] [17592186387519 #edb/ref 1074 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation is already in matrix form \n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & ={{[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nThe transformation $T$ maps the boundary of $Δ$ to the boundary of the image. So, to find the image of $Δ,$ we find the images of each side.\n\n![](images/da/daefc9e14775a955e5210f965e474c06bc7cac1df9306941b73190cc8bf62219.png)\n\n          \n\nTo quickly carry out this calculation, we set up the following matrices:\n\n- The matrix $U$ containing all vertices of our triangle:\n\n$$\nU=[\\begin{aligned}-1 & 1 & 0 \\\\ -1 & -1 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ that has the same shape as $U$ and with the vector $b$ in each column:\n\n$$\nB=[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\n$$\n\nThe image of $u$ under $T$ is given by $Au+b.$ So, by applying $T$ to $U,$ we get\n\n$$\n\\begin{aligned}AU+B & =[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}-1 & 1 & 0 \\\\ -1 & -1 & 1\\end{aligned}]+[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 & 1 \\\\ -3 & 1 & 1\\end{aligned}]+[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -1 & 0 \\\\ -2 & 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the vertices of the image in the $xy$-plane are $(-3,-2),(-1,2),$ and $(0,2).$ \n\nDrawing this region in the $xy$-plane, we get the following:\n\n![](images/94/94a2a90dae43d1edb1f0154a8c7ac60b8c35352fd72d5193014b9bba204d192f.png)\n\n          \n\nFinally, since $det(A)=-1<0,$ this transformation is not orientation-preserving." #edb/ref 17592186045417] [17592186387520 #edb/ref 1075 #edb/ref 17592186387521 #edb/ref 17592186045417] [17592186387520 #edb/ref 1075 #edb/ref 17592186387522 #edb/ref 17592186045417] [17592186387520 #edb/ref 1075 #edb/ref 17592186387523 #edb/ref 17592186045417] [17592186387520 #edb/ref 1075 #edb/ref 17592186387524 #edb/ref 17592186045417] [17592186387520 #edb/ref 1075 #edb/ref 17592186387525 #edb/ref 17592186045417] [17592186387520 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186387520 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186387520 #edb/ref 1078 #edb/ref 17592186387521 #edb/ref 17592186045417] [17592186387520 #edb/ref 1079 #uuid "a762fefe-1fcc-5387-9367-a649dcf93ef2" #edb/ref 17592186045417] [17592186387521 #edb/ref 1080 "images/e1/e181f53d2f99a2374739769ea5e5837de0acf8526717f0607e0e81dba4da0c1e.png" #edb/ref 17592186045417] [17592186387521 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186387521 #edb/ref 1083 #uuid "3e0716d6-0de1-55dd-aa8f-f9f8c7dfcca7" #edb/ref 17592186045417] [17592186387522 #edb/ref 1080 "images/a1/a1c56986c6de278a24b0d83d69b26822b4330d815b8f501db7da8f3d10e625da.png" #edb/ref 17592186045417] [17592186387522 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186387522 #edb/ref 1083 #uuid "977680f2-b11c-5c52-b5b6-570b836e607f" #edb/ref 17592186045417] [17592186387523 #edb/ref 1080 "images/01/01a8419fe9a435734f69c1913764423739b881fd6aa377a08f085e2ea7aab10b.png" #edb/ref 17592186045417] [17592186387523 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186387523 #edb/ref 1083 #uuid "0e1c7f4c-e3ef-5bde-9962-d7cea4dc6a76" #edb/ref 17592186045417] [17592186387524 #edb/ref 1080 "images/9e/9ebbc28d7bf9b1ec3e5adb15a036570f1a7025d0dcedab7f61610c09b0c4c423.png" #edb/ref 17592186045417] [17592186387524 #edb/ref 1082 #edb/ref 175921860454