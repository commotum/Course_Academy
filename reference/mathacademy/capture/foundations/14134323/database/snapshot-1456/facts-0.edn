77f765-f98c-5020-8e45-8da2c5f092e6" #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180553 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180554 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180555 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180556 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180557 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180558 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180564 #edb/ref 17592186045417] [17592186179859 #edb/ref 1043 #edb/ref 17592186180567 #edb/ref 17592186045417] [17592186179859 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179859 #edb/ref 1045 "The Image of an Affine Transformation" #edb/ref 17592186045417] [17592186179859 #edb/ref 1046 #edb/ref 17592186180553 #edb/ref 17592186045417] [17592186179859 #edb/ref 1049 #edb/ref 17592186049035 #edb/ref 17592186045417] [17592186179859 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186179859 #edb/ref 1053 #uuid "c9655728-f410-56c7-8943-6d053246e392" #edb/ref 17592186045417] [17592186179989 #edb/ref 1068 #edb/ref 17592186259193 #edb/ref 17592186045417] [17592186179989 #edb/ref 1069 "q-124101" #edb/ref 17592186045417] [17592186179989 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186179989 #edb/ref 1071 "Consider the transformation $T$ defined as\n\n$$\nx=3u+v-2,\\,y=u-2v+1.\n$$\n\nLet $P(3,2)$ be a point in the $uv$-plane. Suppose that the image of $P$ under the action of $T$ is the point ${P}^{′}$ in the $xy$-plane. What are the coordinates of ${P}^{′}?$" #edb/ref 17592186045417] [17592186179989 #edb/ref 1072 #uuid "fea0aad7-f097-5052-bac7-eb29df7cbe2f" #edb/ref 17592186045417] [17592186179989 #edb/ref 1074 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}3u+v-2 \\\\ u-2v+1\\end{aligned}] \\\\  & =[\\begin{aligned}3u+v \\\\ u-2v\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 & 1 \\\\ 1 & -2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nNow, to find the image of $P$ under the action of $T,$ we first create a column vector $u$ containing the coordinates of $P:$\n\n$$\nu=[\\begin{aligned}3 \\\\ 2\\end{aligned}].\n$$\n\nApplying $T$ to $u,$ we get\n\n$$\n[\\begin{aligned}3 & 1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1\\end{aligned}]=[\\begin{aligned}9 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the coordinates of ${P}^{′}$ are $(9,0).$" #edb/ref 17592186045417] [17592186180004 #edb/ref 1068 #edb/ref 17592186177693 #edb/ref 17592186045417] [17592186180004 #edb/ref 1068 #edb/ref 17592186364914 #edb/ref 17592186045417] [17592186180004 #edb/ref 1069 "q-124199" #edb/ref 17592186045417] [17592186180004 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186180004 #edb/ref 1071 "Consider the affine transformation $T$ defined as\n\n$$\nx=3u-v+2,\\,y=v-u.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\n- $A=[\\begin{aligned}3 & -1 \\\\ 1 & -1\\end{aligned}]$\n- $det(A)=-2$\n- The transformation $T$ is orientation-preserving" #edb/ref 17592186045417] [17592186180004 #edb/ref 1072 #uuid "91a59d9f-f2b5-5450-b850-f776f534f3f4" #edb/ref 17592186045417] [17592186180004 #edb/ref 1074 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}3u-v+2 \\\\ v-u\\end{aligned}] \\\\  & =[\\begin{aligned}3u-v \\\\ -u+v\\end{aligned}]+[\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ 0\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}].$\n\n- Statement II is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}|=3\\cdot 1-(-1)\\cdot (-1)=2.\n$$\n\n- Statement III is true. Indeed, since $det(A)>0,$ the affine transformation $T$ is orientation-preserving.\n\nTherefore, the correct answer is \"III only.\"" #edb/ref 17592186045417] [17592186180553 #edb/ref 1058 #edb/ref 17592186180554 #edb/ref 17592186045417] [17592186180553 #edb/ref 1061 44648 #edb/ref 17592186045417] [17592186180553 #edb/ref 1062 #uuid "7e42cdff-0162-5f00-9062-0bbf4e7ef4c8" #edb/ref 17592186045417] [17592186180553 #edb/ref 1063 #edb/ref 17592186180754 #edb/ref 17592186045417] [17592186180554 #edb/ref 1058 #edb/ref 17592186180555 #edb/ref 17592186045417] [17592186180554 #edb/ref 1061 44649 #edb/ref 17592186045417] [17592186180554 #edb/ref 1062 #uuid "130575e3-c9fd-5688-a557-9be7454f3b61" #edb/ref 17592186045417] [17592186180554 #edb/ref 1063 #edb/ref 17592186179767 #edb/ref 17592186045417] [17592186180555 #edb/ref 1058 #edb/ref 17592186180556 #edb/ref 17592186045417] [17592186180555 #edb/ref 1061 44652 #edb/ref 17592186045417] [17592186180555 #edb/ref 1062 #uuid "804e3ae7-0f27-5ff7-9101-bf7c7b3dfa01" #edb/ref 17592186045417] [17592186180555 #edb/ref 1063 #edb/ref 17592186180755 #edb/ref 17592186045417] [17592186180556 #edb/ref 1058 #edb/ref 17592186180557 #edb/ref 17592186045417] [17592186180556 #edb/ref 1061 44653 #edb/ref 17592186045417] [17592186180556 #edb/ref 1062 #uuid "3f2a959e-2593-532e-916d-db411d030416" #edb/ref 17592186045417] [17592186180556 #edb/ref 1063 #edb/ref 17592186180756 #edb/ref 17592186045417] [17592186180557 #edb/ref 1058 #edb/ref 17592186180558 #edb/ref 17592186045417] [17592186180557 #edb/ref 1061 44654 #edb/ref 17592186045417] [17592186180557 #edb/ref 1062 #uuid "bfcdd1b6-82a4-5529-8d93-b859895ed88c" #edb/ref 17592186045417] [17592186180557 #edb/ref 1063 #edb/ref 17592186179768 #edb/ref 17592186045417] [17592186180558 #edb/ref 1058 #edb/ref 17592186180567 #edb/ref 17592186045417] [17592186180558 #edb/ref 1061 44657 #edb/ref 17592186045417] [17592186180558 #edb/ref 1062 #uuid "db19ad89-86be-5bd4-8aba-82b5b0c23c42" #edb/ref 17592186045417] [17592186180558 #edb/ref 1063 #edb/ref 17592186179769 #edb/ref 17592186045417] [17592186180564 #edb/ref 1061 44685 #edb/ref 17592186045417] [17592186180564 #edb/ref 1062 #uuid "6e8df5a8-690a-5bd7-acaa-c40815a5fca6" #edb/ref 17592186045417] [17592186180564 #edb/ref 1063 #edb/ref 17592186179773 #edb/ref 17592186045417] [17592186180567 #edb/ref 1058 #edb/ref 17592186180564 #edb/ref 17592186045417] [17592186180567 #edb/ref 1061 44703 #edb/ref 17592186045417] [17592186180567 #edb/ref 1062 #uuid "0c8f36a3-dfdb-59b6-82cb-0413df0361cd" #edb/ref 17592186045417] [17592186180567 #edb/ref 1063 #edb/ref 17592186180760 #edb/ref 17592186045417] [17592186180754 #edb/ref 1064 "To find the image of a point under an affine transformation, all we need to do is substitute the position vector of the point into the formula for the affine transformation.\n\nFor example, consider the affine transformation $\\mathbf T:\\Bbb R^2 \\to \\Bbb R^2,$ defined by\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & ={{[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\n \n\nSuppose that the point $P({\\color{black}-1},{\\color{black}1})$ with position vector $\\mathbf p$ lies in the $uv$-plane, as shown below. \n\n![](images/06/06c9283bde54e329d31d5892702e4a75c0ca78bd21ee3bb23f9a2b748239bf14.png)\n\nWe can find the image of $P$ under the action of $\\mathbf T$ by substituting $\\mathbf p$ into the affine transformation formula: \n\n$$\n\\begin{aligned}T(P) & =Ap+b \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the image of $P$ is the point $P'({\\color{black}-1},{\\color{black}3})$ in the $xy$-plane.\n\nWe can visualize $P$ and its image under $\\mathbf T$ using a diagram like the one below.\n\n![](images/89/893933990225c54e0a3327de70f29b3d73af2b829cf53053d155bb52d5202e63.png)\n\nWe can use a similar method to map multiple points from the $uv$-plane to the $xy$-plane using just one calculation. Let's see how." #edb/ref 17592186045417] [17592186180754 #edb/ref 1065 7694 #edb/ref 17592186045417] [17592186180754 #edb/ref 1066 #uuid "b71d5e38-7267-5428-89f5-941492316127" #edb/ref 17592186045417] [17592186180754 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180755 #edb/ref 1064 "Consider the triangle $\\Delta$ with sides $S_1, S_2,$ and $S_3,$  shown below. Let's imagine that we traverse the boundary once in the counterclockwise direction starting from the origin.\n\n![](images/23/231dd5f96cd36d21940fcee894382edc9eabc91b0bf72bb4a8724c8444f76a8c.png)\n\nLet the affine transformation $\\mathbf T$ be defined as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & ={{[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}1 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTo find the image of $\\Delta$ under the action of $\\mathbf T,$ we set up the following matrices:\n\n- The matrix $U$ containing all vertices of our triangle, presented in the order shown in the diagram:\n![](images/34/34be6d7cd24938fb72976910cf3ad6a790eb93574915829f621da99f4aec3838.svg)\n\n- The matrix $B$ that has the same shape as $U$ and with the vector $\\mathbf b$ in each column:\n![](images/be/bed30fcc6a1003bee7f2f7888af9c301314b2aba351497db35cf2ee37710c0a1.svg)\n\nThe image of $\\mathbf u$ under $T$ is given by $A\\mathbf u + \\mathbf b.$ So, by applying $\\mathbf T$ to $U,$ we get\n\n$$\n\\begin{aligned}AU+B & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]+[\\begin{aligned}1 & 1 & 1 \\\\ -1 & -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]+[\\begin{aligned}1 & 1 & 1 \\\\ -1 & -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{aligned}].\\end{aligned}\n$$\n\nThe vertices of the image are given by the columns of the above matrix. Drawing these vertices in the order shown, i.e.\n\n$$\n(1,-1) \\to (1,0) \\to (2,-1),\n$$\n\nwe get the following picture:\n\n![](images/d5/d514834e6e9f108f478002416e863cf9c98d00add230c2e9321664ea14e5db0e.png)\n\n          \n\nNotice that the polygon $D$ is traversed in the *clockwise* direction." #edb/ref 17592186045417] [17592186180755 #edb/ref 1065 7695 #edb/ref 17592186045417] [17592186180755 #edb/ref 1066 #uuid "c717442d-1c85-597b-bfc9-3bacde35a1f0" #edb/ref 17592186045417] [17592186180755 #edb/ref 1067 "Finding the Image of a Polygon" #edb/ref 17592186045417] [17592186180756 #edb/ref 1064 "An invertible affine transformation is **orientation-preserving** if it preserves the orientation of any polygon in the plane.\n\nTo understand this, let's go back to our triangle $\\Delta$ in the $uv$-plane and its image $D$ in the $xy$-plane under the action of the affine transformation $\\mathbf T.$ \n\n![](images/b5/b5c33feb218ae0c1c32aa61984d01b5a317ab88f78277e01c20111a2c0c4efe5.png)\n\nThis transformation does *not* preserve orientation because when we traverse $\\Delta$ *counterclockwise*, its image $D$ is traversed *clockwise.*\n\nWe can identify whether an affine transformation is orientation-preserving or not by examining the matrix $A$ of the associated linear map. We have the following theorem:\n\n*Suppose an affine transformation $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is defined as* \n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\n*where $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix. Then, $\\mathbf{T}$ preserves orientation if*\n\n$$\n\\det(A) > 0,\n$$\n\n*and does not preserve orientation if*\n\n$$\n\\det(A) < 0.\n$$\n\nWe sometimes refer to cases where $\\det(A) < 0$ as **orientation-reversing.**" #edb/ref 17592186045417] [17592186180756 #edb/ref 1065 7696 #edb/ref 17592186045417] [17592186180756 #edb/ref 1066 #uuid "0444feba-dbdb-5165-942a-79da29a810e0" #edb/ref 17592186045417] [17592186180756 #edb/ref 1067 "Orientation-Preserving Transformations" #edb/ref 17592186045417] [17592186180760 #edb/ref 1064 "Suppose an affine transformation $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$  is defined as\n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix.\n\nSimilar to the case of linear transformations, the ** area scale factor** of $\\mathbf T$ is given by the determinant of $A.$\n\nWe can identify whether an affine transformation increases or decreases the area of a polygon $\\mathcal P$ by examining the area scale factor:\n\n- If $|\\det(A)|>1,$ the image of $\\mathcal P$ under the action of $\\mathbf T$ will have a *larger* area than $\\mathcal P.$\n\n- If $|\\det(A)|=1,$ the image of $\\mathcal P$ under the action of $\\mathbf T$ will have the *same* area as $\\mathcal P.$\n\n- If $0 < |\\det(A)| < 1,$ the image of $\\mathcal P$ under the action of $\\mathbf T$ will have a *smaller* area than $\\mathcal P.$\n\nNote that if $\\det(A) = 0,$ the image of $\\mathcal P$ is not a polygon. We discuss this case in more detail in a separate lesson.\n\nFor example, consider the affine transformation $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2,$ from the previous discussion, defined as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & ={{[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}1 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nComputing the determinant of $A,$ we get\n![](images/7c/7c637211f31b2e8e49fb56f6e60573c47bada4fa36b6c6e0fa7474c3e4d106fc.svg)\n\nSo, the area scale factor of the transformation is\n\n$$\n|\\det(A)| = |-1| = 1.\n$$\n\nThus, the area of triangle $\\Delta$ in the $uv$-plane and its image $D$ under $\\mathbf T$ in the $xy$-plane have the same area. \n\n![](images/b5/b5c33feb218ae0c1c32aa61984d01b5a317ab88f78277e01c20111a2c0c4efe5.png)" #edb/ref 17592186045417] [17592186180760 #edb/ref 1065 7705 #edb/ref 17592186045417] [17592186180760 #edb/ref 1066 #uuid "e306ae2c-f307-52ed-a9fc-9376bdfeaa2e" #edb/ref 17592186045417] [17592186180760 #edb/ref 1067 "The Area Scale Factor of an Affine Transformation" #edb/ref 17592186045417] [17592186256907 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186256907 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186256907 #edb/ref 1083 #uuid "0ccab3c0-0254-5090-9c86-829a851b15b0" #edb/ref 17592186045417] [17592186256949 #edb/ref 1080 "(9,0)" #edb/ref 17592186045417] [17592186256949 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186256949 #edb/ref 1083 #uuid "124ccea5-c558-54e8-931d-ac8f24d5e647" #edb/ref 17592186045417] [17592186257179 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186257179 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257179 #edb/ref 1083 #uuid "2c4c2cb2-f173-5288-817b-371883d27529" #edb/ref 17592186045417] [17592186257325 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186257325 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257325 #edb/ref 1083 #uuid "3cbf8e90-0fcd-5e9d-ad8e-5d029388c5ac" #edb/ref 17592186045417] [17592186257379 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186257379 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257379 #edb/ref 1083 #uuid "43d247fa-abed-5958-b466-10fc02c6fd8a" #edb/ref 17592186045417] [17592186257398 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186257398 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257398 #edb/ref 1083 #uuid "4681c1f9-2a9f-5136-9cf7-ed7506a00643" #edb/ref 17592186045417] [17592186257593 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186257593 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257593 #edb/ref 1083 #uuid "5d0eefab-460e-5b30-b83c-d3d6a7dee230" #edb/ref 17592186045417] [17592186257630 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186257630 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257630 #edb/ref 1083 #uuid "60740839-3d41-5df6-8849-4084e44e6ec1" #edb/ref 17592186045417] [17592186257788 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186257788 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186257788 #edb/ref 1083 #uuid "7277e3e9-81db-502b-97dc-3210914ad7a7" #edb/ref 17592186045417] [17592186257813 #edb/ref 1080 "images/d1/d1e93d9ce18d7c75ab6432d53ae9ff72fd3fe2c89125a12dcd2d41a13100465d.png" #edb/ref 17592186045417] [17592186257813 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186257813 #edb/ref 10