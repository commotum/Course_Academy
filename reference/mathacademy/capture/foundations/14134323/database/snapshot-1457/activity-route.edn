#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186435513} :activity/id #uuid "6576ae72-76b4-5f19-bc0f-f5d6a65eb6eb" :activity/scope {:db/id #edb/ref 17592186049035 :topic/id #uuid "d53c1458-9af5-589b-8d7b-d3dbe4e7a946" :topic/math-academy-id 3706} :activity/steps [{:db/id #edb/ref 17592186435513 :step/content {:db/id #edb/ref 17592186179989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124ccea5-c558-54e8-931d-ac8f24d5e647" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,0)" :db/id #edb/ref 17592186256949} {:answer/id #uuid "91981231-c419-532a-b1a0-f3d52aacc432" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(13,0)" :db/id #edb/ref 17592186258068} {:answer/id #uuid "9389800b-ab1e-59a9-990e-685c251fb1bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(11,2)" :db/id #edb/ref 17592186258082} {:answer/id #uuid "c439a84e-99e8-5cc9-a96d-e5fe22288db1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(11,1)" :db/id #edb/ref 17592186258499} {:answer/id #uuid "f08db5c5-f719-59c7-88c9-4c17884b91d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,2)" :db/id #edb/ref 17592186258875}] :answer-field/correct {:db/id #edb/ref 17592186256949} :answer-field/id #uuid "5cac29fa-2311-5bc0-9f73-f59e7d67297f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fea0aad7-f097-5052-bac7-eb29df7cbe2f" :question/math-academy-id "q-124101" :question/problem "Consider the transformation $T$ defined as\n\n$$\nx=3u+v-2,\\,y=u-2v+1.\n$$\n\nLet $P(3,2)$ be a point in the $uv$-plane. Suppose that the image of $P$ under the action of $T$ is the point ${P}^{′}$ in the $xy$-plane. What are the coordinates of ${P}^{′}?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}3u+v-2 \\\\ u-2v+1\\end{aligned}] \\\\  & =[\\begin{aligned}3u+v \\\\ u-2v\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 & 1 \\\\ 1 & -2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nNow, to find the image of $P$ under the action of $T,$ we first create a column vector $u$ containing the coordinates of $P:$\n\n$$\nu=[\\begin{aligned}3 \\\\ 2\\end{aligned}].\n$$\n\nApplying $T$ to $u,$ we get\n\n$$\n[\\begin{aligned}3 & 1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1\\end{aligned}]=[\\begin{aligned}9 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the coordinates of ${P}^{′}$ are $(9,0).$"} :step/id #uuid "7a0b96ab-0e8f-5f84-b9de-02610ea22220" :step/next {:db/id #edb/ref 17592186435516}} {:db/id #edb/ref 17592186435514 :step/content {:db/id #edb/ref 17592186281404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1283e1d9-5638-5cf5-8afe-fccb48c4513e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186278761} {:answer/id #uuid "a8e99c71-ce7b-5a57-8b35-eff03f28886a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186280088} {:answer/id #uuid "bee5e71a-fc3b-5642-9353-bcf840af6970" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186280271} {:answer/id #uuid "d650e02b-bf8f-5b88-a546-cd6aa55f62f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186280483} {:answer/id #uuid "e733f81f-7e5b-56da-a2cd-22f5cd7afff6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186280628}] :answer-field/correct {:db/id #edb/ref 17592186280483} :answer-field/id #uuid "4f5d13f4-2cb9-5ffa-b608-20e5bb1d0372" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "79b6b1e2-201b-5b88-aae8-abebb7edf5f4" :question/math-academy-id "q-162195" :question/problem "Consider the affine transformation $T,$ defined as\n\n$$\nx=2u-2v-3,\\,y=u-v+2.\n$$\n\nWhat is the area scale factor of the transformation?" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-2v-3 \\\\ u-v+2\\end{aligned}] \\\\  & =[\\begin{aligned}2u-2v \\\\ u-v\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-3 \\\\ 2\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}].$\n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}2 & -2 \\\\ 1 & -1\\end{aligned}|=2\\cdot (-1)-1\\cdot (-2)=0.\n$$\n\nSo, the area scale factor of the transformation is\n\n$$\n|det(A)|=|0|=0.\n$$"} :step/id #uuid "8e6a316c-c2fc-577f-ab80-35087f6f4a4b"} {:db/id #edb/ref 17592186435515 :step/content {:db/id #edb/ref 17592186387519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e0716d6-0de1-55dd-aa8f-f9f8c7dfcca7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e1/e181f53d2f99a2374739769ea5e5837de0acf8526717f0607e0e81dba4da0c1e.png" :db/id #edb/ref 17592186387521} {:answer/id #uuid "977680f2-b11c-5c52-b5b6-570b836e607f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a1/a1c56986c6de278a24b0d83d69b26822b4330d815b8f501db7da8f3d10e625da.png" :db/id #edb/ref 17592186387522} {:answer/id #uuid "0e1c7f4c-e3ef-5bde-9962-d7cea4dc6a76" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/01a8419fe9a435734f69c1913764423739b881fd6aa377a08f085e2ea7aab10b.png" :db/id #edb/ref 17592186387523} {:answer/id #uuid "4383caed-4158-5bd4-9a17-59fbd5c146d3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9e/9ebbc28d7bf9b1ec3e5adb15a036570f1a7025d0dcedab7f61610c09b0c4c423.png" :db/id #edb/ref 17592186387524} {:answer/id #uuid "5fce7b22-4627-502a-b774-fdb9a47268e1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f1/f17eeed2b5ab0b065ab0c4c7c7c669108ce4f0d8de8f69979316d12c2885d73e.png" :db/id #edb/ref 17592186387525}] :answer-field/correct {:db/id #edb/ref 17592186387521} :answer-field/id #uuid "a762fefe-1fcc-5387-9367-a649dcf93ef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387520}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e48d3f9e-79f6-5f88-9764-fe40dc9cde3f" :question/math-academy-id "q-124569" :question/problem "![](images/de/deff964a1833339681fc38b30e32ebd3081e7ba1c4b5aabd0f4998f60a2aa78c.png)\n\nConsider the triangle $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le v\\le 1,\\,\\frac{v-1}{2}\\le u\\le \\frac{1-v}{2}\\}.\n$$\n\nThe transformation $T$ is defined as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nWhich of the following gives the image of $Δ$ in the $xy$-plane under the action of $T?$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nNotice that the given transformation is already in matrix form \n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & ={{[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nThe transformation $T$ maps the boundary of $Δ$ to the boundary of the image. So, to find the image of $Δ,$ we find the images of each side.\n\n![](images/da/daefc9e14775a955e5210f965e474c06bc7cac1df9306941b73190cc8bf62219.png)\n\n          \n\nTo quickly carry out this calculation, we set up the following matrices:\n\n- The matrix $U$ containing all vertices of our triangle:\n\n$$\nU=[\\begin{aligned}-1 & 1 & 0 \\\\ -1 & -1 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ that has the same shape as $U$ and with the vector $b$ in each column:\n\n$$\nB=[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}]\n$$\n\nThe image of $u$ under $T$ is given by $Au+b.$ So, by applying $T$ to $U,$ we get\n\n$$\n\\begin{aligned}AU+B & =[\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}-1 & 1 & 0 \\\\ -1 & -1 & 1\\end{aligned}]+[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 & 1 \\\\ -3 & 1 & 1\\end{aligned}]+[\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -1 & 0 \\\\ -2 & 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the vertices of the image in the $xy$-plane are $(-3,-2),(-1,2),$ and $(0,2).$ \n\nDrawing this region in the $xy$-plane, we get the following:\n\n![](images/94/94a2a90dae43d1edb1f0154a8c7ac60b8c35352fd72d5193014b9bba204d192f.png)\n\n          \n\nFinally, since $det(A)=-1<0,$ this transformation is not orientation-preserving."} :step/id #uuid "d663c1fb-e568-5737-ad46-ace94b52d55c" :step/next {:db/id #edb/ref 17592186435517}} {:db/id #edb/ref 17592186435516 :step/content {:db/id #edb/ref 17592186180004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c730df9-6548-5576-ba64-558226099add" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186364915} {:answer/id #uuid "b366d454-2c12-5c37-a81b-f48f317a5394" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186364916} {:answer/id #uuid "86c803ea-012c-568d-90f8-bce9b0ec9560" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186364917} {:answer/id #uuid "cb699b26-8700-53e1-89a0-b258c6ab715c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186364918} {:answer/id #uuid "a9a37d2a-7bd5-528f-9255-1cf91b830b77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186364919}] :answer-field/correct {:db/id #edb/ref 17592186364917} :answer-field/id #uuid "3654e763-779e-5611-b4b5-b394a98f43a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "91a59d9f-f2b5-5450-b850-f776f534f3f4" :question/math-academy-id "q-124199" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=3u-v+2,\\,y=v-u.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nI. $A=[\\begin{aligned}3 & -1 \\\\ 1 & -1\\end{aligned}]$\n\nII. $det(A)=-2$\n\nIII. The transformation $T$ is orientation-preserving" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}3u-v+2 \\\\ v-u\\end{aligned}] \\\\  & =[\\begin{aligned}3u-v \\\\ -u+v\\end{aligned}]+[\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ 0\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}].$\n\n- Statement II is false. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}3 & -1 \\\\ -1 & 1\\end{aligned}|=3\\cdot 1-(-1)\\cdot (-1)=2.\n$$\n\n- Statement III is true. Indeed, since $det(A)>0,$ the affine transformation $T$ is orientation-preserving.\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "e086bf25-638a-5567-9fa8-97f5dc9d1a52" :step/next {:db/id #edb/ref 17592186435515}} {:db/id #edb/ref 17592186435517 :step/content {:db/id #edb/ref 17592186417837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc4fab2-f286-5943-a45f-a20492b01ffd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186417824} {:answer/id #uuid "76b47f26-b551-5ab2-a16b-a5772ef735ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186417827} {:answer/id #uuid "ca24dbee-3bf2-5067-b768-9753b1ef80ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186417831} {:answer/id #uuid "d2847d2c-57b6-59e8-b9ce-cd6f7d5c8fab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186417832} {:answer/id #uuid "f0b0cc75-4660-5f89-b375-205d3cc92d47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186417833}] :answer-field/correct {:db/id #edb/ref 17592186417827} :answer-field/id #uuid "cc6bf158-bc5a-5b83-aecb-e172b7a9b66e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417835}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "914af94d-7042-54e6-acb1-fed694c9a4de" :question/math-academy-id "q-162181" :question/problem "Consider the affine transformation $T,$ defined as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n \n\nWhat is the area scale factor of the transformation?" :question/worked-solution "The matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}].$ \n\nComputing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}|=1\\cdot 4-3\\cdot 2=-2.\n$$\n\nSo, the area scale factor of the transformation is\n\n$$\n|det(A)|=|-2|=2.\n$$"} :step/id #uuid "fe3a87c9-9231-55eb-8c5d-d5ab24f9c1a9" :step/next {:db/id #edb/ref 17592186435514}}] :activity/title "The Image of an Affine Transformation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186435512}]}
