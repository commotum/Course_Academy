      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14134323/observations/step-q124199-faf95b1dbec8714c5090.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14134323/observations/step-q124199-faf95b1dbec8714c5090.png",
      "source_url": "https://mathacademy.com/tasks/14134323/topics/3706/review",
      "captured_at": 1791804272.5909786,
      "math_academy_id": "q-124199",
      "topic_id": "3706",
      "sequence_position": null,
      "source_step": {
