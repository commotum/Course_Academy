#{[{:db/id #edb/ref 17592186256505 :knowledge-point/_questions [{:db/id #edb/ref 17592186175953 :knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc3154c-7f17-5dcc-bb31-930622dcafb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186253774} {:answer/id #uuid "3f96a88c-b947-5800-83b1-40b9ae2dd8fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186254218} {:answer/id #uuid "9fa5e6e3-2942-5b7c-a1e0-7dfb42831f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186255078} {:answer/id #uuid "a54c9c95-31d0-5da7-89f9-2f3bb024aa7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255129} {:answer/id #uuid "ce4a7d81-2c42-5445-ba8e-c26c37ca413d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255503}] :answer-field/correct {:answer/id #uuid "0cc3154c-7f17-5dcc-bb31-930622dcafb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186253774} :answer-field/id #uuid "430d2f90-87f1-5b6a-b4f7-8f59c9e4caec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256048}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fcacee3-c17a-5da5-b61c-c5f1fb560ec6" :question/math-academy-id "q-121011" :question/problem "![](images/18/18904539463b95f9d681f61f0d8f875ad0cb03b35d4037e75c227d4523502193.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=5?$" :question/worked-solution "The position of the particle at $t=5$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,5].$ Therefore, we can calculate it as follows:\n\n$$\nx(5)=x(1)+{\\int }_{1}^{5}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=2,$ and we can compute the integral ${\\int }_{1}^{5}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=5.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{5}v(t)\\,\\text{d}t=6.\n$$\n\nTherefore,\n\n$$\nx(5)=2+6=8.\n$$\n\nSo, the position of the particle at $t=5$ is $x=8.$"}] [{:db/id #edb/ref 17592186320845 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41fa1897-966f-5891-897e-aad8aa6187ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186319590}] :answer-field/correct {:answer/id #uuid "41fa1897-966f-5891-897e-aad8aa6187ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186319590} :answer-field/id #uuid "fa6f42be-08dc-58b6-b148-964000724c26" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320701}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e713da54-01ea-5836-a919-ed65d371d799" :question/math-academy-id "q-351445" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={sec}^{2}⁡(t).$ At time $t=0$ the particle is located at the position $x=-2.$ \nFind the position of the particle at time $t=\\frac{\\pi }{4}.$ Do not round the answer.\n\nThe position of the particle at $t=\\frac{\\pi }{4}$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{4}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{4}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{4})=x(0)+{\\int }_{0}^{\\pi /4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{4}) & =-2+{\\int }_{0}^{\\pi /4}{sec}^{2}⁡(t)\\,\\text{d}t \\\\  & =-2+{[\\operatorname{tan}⁡(t)]}_{0}^{\\pi /4} \\\\  & =-2+\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0) \\\\  & =-2+1-0 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\frac{\\pi }{4}$ is $x=-1.$"}] [{:db/id #edb/ref 17592186354299 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a311448-307a-5885-822c-de1f67c73961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+2" :db/id #edb/ref 17592186351656} {:answer/id #uuid "3623a535-7600-5434-a62f-0911f44d8886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186352070} {:answer/id #uuid "6a4adfd7-77b9-546a-bc81-e523cb9570cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186352510} {:answer/id #uuid "76677d74-af34-5645-9484-6b29d1203697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186352608} {:answer/id #uuid "930a88c2-c9ae-517e-b0a5-eb3fe4246b6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186352839}] :answer-field/correct {:answer/id #uuid "3623a535-7600-5434-a62f-0911f44d8886" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186352070} :answer-field/id #uuid "2261016b-0ae5-5f9a-aa37-bfcb71ba8e18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353871}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eb6db786-b30b-50d9-8212-ed249e4ffd0a" :question/math-academy-id "q-84265" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)={e}^{t-1}.$ At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=2?$" :question/worked-solution "The position of the particle at $t=2$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,2].$ Therefore, we can calculate it as follows:\n\n$$\nx(2)=x(1)+{\\int }_{1}^{2}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(2) & =2+{\\int }_{1}^{2}{e}^{t-1}\\,\\text{d}t \\\\  & =2+{[{e}^{t-1}]}_{1}^{2} \\\\  & =2+({e}^{2-1}-{e}^{1-1}) \\\\  & =2+({e}^{1}-{e}^{0}) \\\\  & =2+e-1 \\\\  & =e+1.\\end{aligned}\n$$\n\nSo the position of the particle at $t=2$ is $x=e+1.$"}]}
