b/ref 17592186045417] [17592186176679 #edb/ref 1058 #edb/ref 17592186176680 #edb/ref 17592186045417] [17592186176679 #edb/ref 1061 26222 #edb/ref 17592186045417] [17592186176679 #edb/ref 1062 #uuid "09c4b204-3997-5b1e-93ae-6692ddd42f27" #edb/ref 17592186045417] [17592186176679 #edb/ref 1063 #edb/ref 17592186175952 #edb/ref 17592186045417] [17592186176680 #edb/ref 1061 26224 #edb/ref 17592186045417] [17592186176680 #edb/ref 1062 #uuid "b17adac8-c89d-52de-a152-36164f473554" #edb/ref 17592186045417] [17592186176680 #edb/ref 1063 #edb/ref 17592186175953 #edb/ref 17592186045417] [17592186176949 #edb/ref 1064 "The **total displacement** $d$ of a particle over the time interval $t \\in [a,b]$ is the difference in the position of the particle between $t=a$ and $t=b.$\n\n$$\nd = x(b) - x(a).\n$$\n\nNow, the fundamental theorem of calculus states that\n\n$$\nd = x(b) - x(a) = \\int_a^b x'(t) \\, \\textrm dt\n$$\n\nand since $x'(t) = v(t),$ we can find the total displacement of a particle by integrating the velocity:\n\n$$\nd = x(b) - x(a) = \\int_a^b v(t) \\, \\textrm dt\n$$\n\nTo summarize, the total displacement of a particle over the time interval $t \\in [a,b]$ can be found by integrating the velocity $v(t)$ over the time interval $t\\in[a,b].$\n\n$$\n\\begin{aligned}d & ={\\int }_{a}^{b}v(t)\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186176949 #edb/ref 1065 1018 #edb/ref 17592186045417] [17592186176949 #edb/ref 1066 #uuid "eaade9c6-bf5a-51de-b56f-538581c3c761" #edb/ref 17592186045417] [17592186176949 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186253774 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186253774 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186253774 #edb/ref 1083 #uuid "0cc3154c-7f17-5dcc-bb31-930622dcafb1" #edb/ref 17592186045417] [17592186254218 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186254218 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186254218 #edb/ref 1083 #uuid "3f96a88c-b947-5800-83b1-40b9ae2dd8fc" #edb/ref 17592186045417] [17592186255078 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186255078 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186255078 #edb/ref 1083 #uuid "9fa5e6e3-2942-5b7c-a1e0-7dfb42831f6b" #edb/ref 17592186045417] [17592186255129 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186255129 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186255129 #edb/ref 1083 #uuid "a54c9c95-31d0-5da7-89f9-2f3bb024aa7c" #edb/ref 17592186045417] [17592186255503 #edb/ref 1080 "10" #edb/ref 17592186045417] [17592186255503 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186255503 #edb/ref 1083 #uuid "ce4a7d81-2c42-5445-ba8e-c26c37ca413d" #edb/ref 17592186045417] [17592186256048 #edb/ref 1075 #edb/ref 17592186253774 #edb/ref 17592186045417] [17592186256048 #edb/ref 1075 #edb/ref 17592186254218 #edb/ref 17592186045417] [17592186256048 #edb/ref 1075 #edb/ref 17592186255078 #edb/ref 17592186045417] [17592186256048 #edb/ref 1075 #edb/ref 17592186255129 #edb/ref 17592186045417] [17592186256048 #edb/ref 1075 #edb/ref 17592186255503 #edb/ref 17592186045417] [17592186256048 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186256048 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186256048 #edb/ref 1078 #edb/ref 17592186253774 #edb/ref 17592186045417] [17592186256048 #edb/ref 1079 #uuid "430d2f90-87f1-5b6a-b4f7-8f59c9e4caec" #edb/ref 17592186045417] [17592186256505 #edb/ref 1068 #edb/ref 17592186256048 #edb/ref 17592186045417] [17592186256505 #edb/ref 1069 "q-121011" #edb/ref 17592186045417] [17592186256505 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186256505 #edb/ref 1071 "![](images/18/18904539463b95f9d681f61f0d8f875ad0cb03b35d4037e75c227d4523502193.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=5?$" #edb/ref 17592186045417] [17592186256505 #edb/ref 1072 #uuid "3fcacee3-c17a-5da5-b61c-c5f1fb560ec6" #edb/ref 17592186045417] [17592186256505 #edb/ref 1074 "The position of the particle at $t=5$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,5].$ Therefore, we can calculate it as follows:\n\n$$\nx(5)=x(1)+{\\int }_{1}^{5}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=2,$ and we can compute the integral ${\\int }_{1}^{5}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=5.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{5}v(t)\\,\\text{d}t=6.\n$$\n\nTherefore,\n\n$$\nx(5)=2+6=8.\n$$\n\nSo, the position of the particle at $t=5$ is $x=8.$" #edb/ref 17592186045417] [17592186319590 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186319590 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319590 #edb/ref 1083 #uuid "41fa1897-966f-5891-897e-aad8aa6187ef" #edb/ref 17592186045417] [17592186320701 #edb/ref 1075 #edb/ref 17592186319590 #edb/ref 17592186045417] [17592186320701 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320701 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320701 #edb/ref 1078 #edb/ref 17592186319590 #edb/ref 17592186045417] [17592186320701 #edb/ref 1079 #uuid "fa6f42be-08dc-58b6-b148-964000724c26" #edb/ref 17592186045417] [17592186320845 #edb/ref 1068 #edb/ref 17592186320701 #edb/ref 17592186045417] [17592186320845 #edb/ref 1069 "q-351445" #edb/ref 17592186045417] [17592186320845 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320845 #edb/ref 1071 "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={sec}^{2}⁡(t).$ At time $t=0$ the particle is located at the position $x=-2.$ \nFind the position of the particle at time $t=\\frac{\\pi }{4}.$ Do not round the answer.\n\nThe position of the particle at $t=\\frac{\\pi }{4}$ is $x=$\n{{field-1}}." #edb/ref 17592186045417] [17592186320845 #edb/ref 1072 #uuid "e713da54-01ea-5836-a919-ed65d371d799" #edb/ref 17592186045417] [17592186320845 #edb/ref 1074 "The position of the particle at $t=\\frac{\\pi }{4}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{4}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{4})=x(0)+{\\int }_{0}^{\\pi /4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{4}) & =-2+{\\int }_{0}^{\\pi /4}{sec}^{2}⁡(t)\\,\\text{d}t \\\\  & =-2+{[\\operatorname{tan}⁡(t)]}_{0}^{\\pi /4} \\\\  & =-2+\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0) \\\\  & =-2+1-0 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\frac{\\pi }{4}$ is $x=-1.$" #edb/ref 17592186045417] [17592186351656 #edb/ref 1080 "e+2" #edb/ref 17592186045417] [17592186351656 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351656 #edb/ref 1083 #uuid "0a311448-307a-5885-822c-de1f67c73961" #edb/ref 17592186045417] [17592186352070 #edb/ref 1080 "e+1" #edb/ref 17592186045417] [17592186352070 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352070 #edb/ref 1083 #uuid "3623a535-7600-5434-a62f-0911f44d8886" #edb/ref 17592186045417] [17592186352510 #edb/ref 1080 "2e+1" #edb/ref 17592186045417] [17592186352510 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352510 #edb/ref 1083 #uuid "6a4adfd7-77b9-546a-bc81-e523cb9570cb" #edb/ref 17592186045417] [17592186352608 #edb/ref 1080 "e" #edb/ref 17592186045417] [17592186352608 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352608 #edb/ref 1083 #uuid "76677d74-af34-5645-9484-6b29d1203697" #edb/ref 17592186045417] [17592186352839 #edb/ref 1080 "2e" #edb/ref 17592186045417] [17592186352839 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352839 #edb/ref 1083 #uuid