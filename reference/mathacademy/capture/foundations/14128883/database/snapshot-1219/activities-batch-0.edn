#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186120699} :activity/id #uuid "59d43d6d-e407-5159-a37a-73328284da1e" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186120699 :step/content {:db/id #edb/ref 17592186121043 :tutorial/content "Let's consider the basis $\\mathcal{C}= \\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$ of $\\mathbb{R}^2$ and the vector\n\n![](images/2d/2dabd318dc49628f9333642f06492d3303617a0ea1cade93c0470c7a767121f5.svg)\n\nNow, let $\\mathcal{B}= \\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be another basis of $\\mathbb{R}^2,$ such that\n\n$$\n\\mathbf{b}_1 = \\mathbf{c}_2 \\quad \\textrm{and} \\quad \\mathbf{b}_2 = -2\\mathbf{c}_1.\n$$\n\nHow can we find the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{B}?$\n\nSince ![](images/3e/3e330c07260a16bc76853ca1d275bbd9759f60179dce22500ee6dd38f326ca20.svg) we can write the vector $\\mathbf{x}$ relative to the basis $\\mathcal B$ as follows:\n\n$$\n\\begin{aligned}x & =2{c}_{1}-{c}_{2} \\\\  & =-{c}_{2}+2{c}_{1} \\\\  & =-({c}_{2})-(-2{c}_{1}) \\\\  & =-{b}_{1}-{b}_{2}\\end{aligned}\n$$\n\nTherefore, ![](images/5d/5d39ae32e2bad5125e6d7cf8ba7b943f2c926e1f1d6525ce019fd9a40c263bce.svg)" :tutorial/id #uuid "d5021c80-ecd5-57d1-b176-3ac06c0c4b38" :tutorial/math-academy-id 3209 :tutorial/title "Introduction"} :step/id #uuid "cbbd8b68-9c01-5dc1-a46f-54a0bc690766" :step/math-academy-id 17517 :step/next {:db/id #edb/ref 17592186120700}} {:db/id #edb/ref 17592186120700 :step/content {:db/id #edb/ref 17592186119823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119634 :question/id #uuid "6a082146-0d63-59dd-9224-a319d73ca59c" :question/math-academy-id "e-4827"} :knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826} {:db/id #edb/ref 17592186050638}] :knowledge-point/questions [{:db/id #edb/ref 17592186120359} {:db/id #edb/ref 17592186120383} {:db/id #edb/ref 17592186247301} {:db/id #edb/ref 17592186247303} {:db/id #edb/ref 17592186321001} {:db/id #edb/ref 17592186351266} {:db/id #edb/ref 17592186380622} {:db/id #edb/ref 17592186410059} {:db/id #edb/ref 17592186410061}] :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"} :step/id #uuid "4b2867fd-9b0b-58c0-86fd-8aee91a58c36" :step/math-academy-id 17519 :step/next {:db/id #edb/ref 17592186120701}} {:db/id #edb/ref 17592186120701 :step/content {:db/id #edb/ref 17592186119824 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119635 :question/id #uuid "f07356b8-aeb3-50ac-b017-c370d87395d2" :question/math-academy-id "e-4828"} :knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/questions [{:db/id #edb/ref 17592186120360} {:db/id #edb/ref 17592186120362} {:db/id #edb/ref 17592186247305} {:db/id #edb/ref 17592186247306} {:db/id #edb/ref 17592186247307} {:db/id #edb/ref 17592186351160} {:db/id #edb/ref 17592186351162} {:db/id #edb/ref 17592186351269} {:db/id #edb/ref 17592186380636} {:db/id #edb/ref 17592186382427} {:db/id #edb/ref 17592186410060}] :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"} :step/id #uuid "b2e04f32-eaf4-5a63-8709-0ac4376c51b7" :step/math-academy-id 17520 :step/next {:db/id #edb/ref 17592186120763}} {:db/id #edb/ref 17592186120702 :step/content {:db/id #edb/ref 17592186119825 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119636 :question/id #uuid "91fac4cd-7097-5244-a385-9f3f76395912" :question/math-academy-id "e-4829"} :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049060}] :knowledge-point/questions [{:db/id #edb/ref 17592186120361} {:db/id #edb/ref 17592186120532} {:db/id #edb/ref 17592186247308} {:db/id #edb/ref 17592186247309} {:db/id #edb/ref 17592186351164} {:db/id #edb/ref 17592186351165} {:db/id #edb/ref 17592186351169} {:db/id #edb/ref 17592186351171} {:db/id #edb/ref 17592186351270} {:db/id #edb/ref 17592186382414} {:db/id #edb/ref 17592186382434} {:db/id #edb/ref 17592186410058} {:db/id #edb/ref 17592186410062}] :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"} :step/id #uuid "344d2e0b-3884-5f31-a733-c6d1b647154b" :step/math-academy-id 17521} {:db/id #edb/ref 17592186120763 :step/content {:db/id #edb/ref 17592186121070 :tutorial/content "Let $\\mathcal{B}= \\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be a basis of $\\mathbb{R}^2$ and ![](images/be/bec3577dd261660f2545adb66b9c26fbb520ea60aa6b0337094347dbc1937ff4.svg) What are the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{C}= \\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\},$ where $\\mathbf{b}_1 = 2\\mathbf{c}_1-\\mathbf{c}_2$ and $\\mathbf{b}_2 = \\mathbf{c}_1+\\mathbf{c}_2?$\n\nSince ![](images/20/200509c629fdf3d263ff375722f57ed77012a8a91a58a7e7f507fad3765b3782.svg) we can write the vector $\\mathbf{x}$ in terms of the vectors $\\mathbf c_1$ and $\\mathbf c_2,$ as follows:\n\n$$\n\\begin{aligned}x & =5{b}_{1}-2{b}_{2} \\\\  & =5(2{c}_{1}-{c}_{2})-2({c}_{1}+{c}_{2}) \\\\  & =10{c}_{1}-5{c}_{2}-2{c}_{1}-2{c}_{2} \\\\  & =8{c}_{1}-7{c}_{2}\\end{aligned}\n$$\n\nTherefore, ![](images/6b/6bc09e66faaef40bba491f31c9342d4d08a8fb6eb3fd4dd1a3e2acdd77421741.svg)" :tutorial/id #uuid "189050f1-7dc3-53be-a9f6-52abe95d9915" :tutorial/math-academy-id 4287 :tutorial/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"} :step/id #uuid "a41a07f8-567e-599b-ae5d-a130ad3aae2c" :step/math-academy-id 26017 :step/next {:db/id #edb/ref 17592186120702}}] :activity/title "Writing Vectors in Different Bases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120055}]}
