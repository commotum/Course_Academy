dent :question.difficulty/moderate} :question/id #uuid "7c19afb3-436b-5bc9-8f6f-99c189134e6d" :question/math-academy-id "q-112812" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}4 \\\\ -6 \\\\ 8\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=4{b}_{3}$, ${c}_{2}=2{b}_{1}$ and ${c}_{3}=3{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}4 \\\\ -6 \\\\ 8\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =4{b}_{1}-6{b}_{2}+8{b}_{3} \\\\  & =8{b}_{3}+4{b}_{1}-6{b}_{2} \\\\  & =2(4{b}_{3})+2(2{b}_{1})-2(3{b}_{2}) \\\\  & =2{c}_{1}+2{c}_{2}-2{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].$"}] [{:db/id #edb/ref 17592186351160 :knowledge-point/_questions [{:db/id #edb/ref 17592186119824 :knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1521a735-440e-5594-83fc-552a8de81b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186348626} {:answer/id #uuid "6a8320a6-b66a-50c6-966f-ec2b07922217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186349430} {:answer/id #uuid "6f8ac099-04dd-5736-8947-f97096f61cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186349469} {:answer/id #uuid "ee795864-027f-5202-bbf2-2a8d67b17d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186350530} {:answer/id #uuid "fc1f1b8a-56b4-5f6d-896b-8508eb1fe82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186350670}] :answer-field/correct {:answer/id #uuid "1521a735-440e-5594-83fc-552a8de81b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186348626} :answer-field/id #uuid "2b9dd274-e82b-583b-8183-dfabcc8cb925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5391d763-accb-53ad-9d75-896f6a1f5e41" :question/math-academy-id "q-80814" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -3 \\\\ 6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=-{b}_{2}$, ${c}_{2}=2{b}_{3}$ and ${c}_{3}={b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}1 \\\\ -3 \\\\ 6\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-3{b}_{2}+6{b}_{3} \\\\  & =-3{b}_{2}+6{b}_{3}+{b}_{1} \\\\  & =3(-{b}_{2})+3(2{b}_{3})+{b}_{1} \\\\  & =3{c}_{1}+3{c}_{2}+{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ 1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186351164 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b8abef8-6bb8-54af-9cab-7f8200ea2b4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186348983} {:answer/id #uuid "7d38cee2-216a-50f7-9ee2-2046c8fd2070" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186349595} {:answer/id #uuid "7f5e25ed-9a4e-51e9-91a9-88573309ce14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186349614} {:answer/id #uuid "da13cf86-203f-5c39-afea-626810d1dd97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ 29\\end{aligned}]" :db/id #edb/ref 17592186350359} {:answer/id #uuid "decdfd78-92ff-5e5e-bfcb-c0b319ddfdff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{29}{2} \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186350395}] :answer-field/correct {:answer/id #uuid "3b8abef8-6bb8-54af-9cab-7f8200ea2b4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186348983} :answer-field/id #uuid "c9346877-f860-5d75-8662-7c418ed4209e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c9bca47-36fc-5691-b4a4-81a309a1be29" :question/math-academy-id "q-80826" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=4{b}_{1}+{b}_{2}$ and ${c}_{2}=2{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=4{b}_{1}+{b}_{2} \\\\ {c}_{2}=2{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=4(\\frac{1}{2}{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}-2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-7{b}_{2} \\\\  & =\\frac{1}{2}{c}_{2}-7({c}_{1}-2{c}_{2}) \\\\  & =\\frac{1}{2}{c}_{2}-7{c}_{1}+14{c}_{2} \\\\  & =-7{c}_{1}+\\frac{29}{2}{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}].$"}]}
