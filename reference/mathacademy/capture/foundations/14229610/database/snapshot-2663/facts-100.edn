i x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))+{b}_{n}\\cdot \\frac{n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,-3(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{6}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -3\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-3{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-3{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,\\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{6}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n\\left\\{\\begin{aligned}-3\\cdot \\frac{{a}_{0}}{2} &=-2 \\\\ \\frac{{b}_{n}n\\pi }{3}-3{a}_{n} &=0 \\\\ -\\frac{{a}_{n}n\\pi }{3}-3{b}_{n} &=\\frac{6}{n\\pi }\\end{aligned}\\right.\n$$\n\nFrom the first equation, ${a}_{0}=\\frac{4}{3},$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=\\frac{2}{3}.\n$$\n\nNext, from the second equation, ${b}_{n}=\\frac{9{a}_{n}}{n\\pi }.$ Substituting this into the third equation, gives\n\n$$\n-\\frac{{a}_{n}n\\pi }{3}-3(\\frac{9{a}_{n}}{n\\pi })=\\frac{6}{n\\pi }\\,⇒\\,{a}_{n}=-\\frac{18}{{n}^{2}{\\pi }^{2}+81}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{9{a}_{n}}{n\\pi } \\\\  & =\\frac{9}{n\\pi }\\cdot (-\\frac{18}{{n}^{2}{\\pi }^{2}+81}) \\\\  & =-\\frac{162}{n\\pi ({n}^{2}{\\pi }^{2}+81)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼\\frac{2}{3} & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{18}{{n}^{2}{\\pi }^{2}+81}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{162}{n\\pi ({n}^{2}{\\pi }^{2}+81)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186397663 #edb/ref 1075 #edb/ref 17592186397664 #edb/ref 17592186045417] [17592186397663 #edb/ref 1075 #edb/ref 17592186397665 #edb/ref 17592186045417] [17592186397663 #edb/ref 1075 #edb/ref 17592186397666 #edb/ref 17592186045417] [17592186397663 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186397663 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186397663 #edb/ref 1078 #edb/ref 17592186397666 #edb/ref 17592186045417] [17592186397663 #edb/ref 1079 #uuid "865ba785-fbd6-5a07-957c-16cb2c1df477" #edb/ref 17592186045417] [17592186397664 #edb/ref 1080 "\\frac{54}{n\\pi ({n}^{2}{\\pi }^{2}+81)}" #edb/ref 17592186045417] [17592186397664 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186397664 #edb/ref 1083 #uuid "af7b840f-2e0c-52c0-b79f-c78277457040" #edb/ref 17592186045417] [17592186397665 #edb/ref 1080 "\\frac{162}{n\\pi ({n}^{2}{\\pi }^{2}+81)}" #edb/ref 17592186045417] [17592186397665 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [175921863