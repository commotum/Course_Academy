592186045417] [17592186119750 #edb/ref 1042 #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" #edb/ref 17592186045417] [17592186120033 #edb/ref 1043 #edb/ref 17592186120580 #edb/ref 17592186045417] [17592186120033 #edb/ref 1043 #edb/ref 17592186120581 #edb/ref 17592186045417] [17592186120033 #edb/ref 1043 #edb/ref 17592186120582 #edb/ref 17592186045417] [17592186120033 #edb/ref 1043 #edb/ref 17592186120583 #edb/ref 17592186045417] [17592186120033 #edb/ref 1043 #edb/ref 17592186120594 #edb/ref 17592186045417] [17592186120033 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186120033 #edb/ref 1045 "Introduction to Curvature" #edb/ref 17592186045417] [17592186120033 #edb/ref 1046 #edb/ref 17592186120580 #edb/ref 17592186045417] [17592186120033 #edb/ref 1049 #edb/ref 17592186049196 #edb/ref 17592186045417] [17592186120033 #edb/ref 1050 1020.0 #edb/ref 17592186045417] [17592186120033 #edb/ref 1053 #uuid "2660cd04-6f2d-5dd7-95c2-55cf96cdbf95" #edb/ref 17592186045417] [17592186120326 #edb/ref 1068 #edb/ref 17592186118095 #edb/ref 17592186045417] [17592186120326 #edb/ref 1069 "q-34355" #edb/ref 17592186045417] [17592186120326 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186120326 #edb/ref 1071 "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where\n\n$$\nr(s)=⟨\\frac{s}{\\sqrt{10}},\\,3\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}}),\\,3\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}})⟩,\\,0\\le s<2\\sqrt{10}\\,\\pi .\n$$" #edb/ref 17592186045417] [17592186120326 #edb/ref 1072 #uuid "4aa7d1da-7858-5140-849b-d462fe65d915" #edb/ref 17592186045417] [17592186120326 #edb/ref 1074 "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s)$:\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{s}{\\sqrt{10}}),\\,\\frac{\\text{d}}{\\text{d}s}(3\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}})),\\,\\frac{\\text{d}}{\\text{d}s}(3\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}}))⟩ \\\\  & =⟨\\frac{1}{\\sqrt{10}},\\,-3\\cdot \\frac{1}{\\sqrt{10}}\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}}),\\,3\\cdot \\frac{1}{\\sqrt{10}}\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}})⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨1,\\,-3\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}}),\\,3\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}})⟩ \\\\ {r}^{″}(s) & =\\frac{1}{\\sqrt{10}}⟨\\frac{\\text{d}}{\\text{d}s}(1),\\,-3\\frac{\\text{d}}{\\text{d}s}(\\operatorname{sin}⁡\\frac{s}{\\sqrt{10}}),\\,3\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡\\frac{s}{\\sqrt{10}})⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨0,\\,-3\\cdot \\frac{1}{\\sqrt{10}}\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}}),\\,-3\\cdot \\frac{1}{\\sqrt{10}}\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}})⟩ \\\\  & =\\frac{3}{10}⟨0,\\,-\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}}),\\,-\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}})⟩\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\frac{3}{10}\\sqrt{{0}^{2}+{(-\\operatorname{cos}⁡(\\frac{s}{\\sqrt{10}}))}^{2}+{(-\\operatorname{sin}⁡(\\frac{s}{\\sqrt{10}}))}^{2}} \\\\  & =\\frac{3}{10}\\sqrt{0+{cos}^{2}⁡(\\frac{s}{\\sqrt{10}})+{sin}^{2}⁡(\\frac{s}{\\sqrt{10}})} \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120494 #edb/ref 1068 #edb/ref 17592186119078 #edb/ref 17592186045417] [17592186120494 #edb/ref 1069 "q-64584" #edb/ref 17592186045417] [17592186120494 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120494 #edb/ref 1071 "Consider the curve $r(s)$ parametrized by arc length $s.$ Find the curvature at the point where $s=\\frac{3\\pi }{2}$ if the unit tangent vector of the curve is given by\n\n$$\nT(s)=⟨-\\operatorname{sin}⁡\\frac{s}{3},\\,\\operatorname{cos}⁡\\frac{s}{3},\\,0⟩.\n$$" #edb/ref 17592186045417] [17592186120494 #edb/ref 1072 #uuid "ff2e0fe9-5f3d-51ba-a9a0-292022683d43" #edb/ref 17592186045417] [17592186120494 #edb/ref 1074 "Since we are given that the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖\n$$\n\nNow, we differentiate $T(s)$ with respect to $s$ and evaluate it at $s=\\frac{3\\pi }{2}$:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡\\frac{s}{3}),\\,\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡\\frac{s}{3}),\\,\\frac{\\text{d}}{\\text{d}s}(0)⟩ \\\\  & =⟨-\\frac{1}{3}\\operatorname{cos}⁡\\frac{s}{3},\\,-\\frac{1}{3}\\operatorname{sin}⁡\\frac{s}{3},\\,0⟩ \\\\ {T}^{′}(\\frac{3\\pi }{2}) & =⟨-\\frac{1}{3}\\operatorname{cos}⁡(\\frac{1}{3}\\cdot \\frac{3\\pi }{2}),\\,-\\frac{1}{3}\\operatorname{sin}⁡(\\frac{1}{3}\\cdot \\frac{3\\pi }{2}),\\,0⟩ \\\\  & =⟨-\\frac{1}{3}\\operatorname{cos}⁡(\\frac{\\pi }{2}),\\,-\\frac{1}{3}\\operatorname{sin}⁡(\\frac{\\pi }{2}),\\,0⟩ \\\\  & =⟨0,\\,-\\frac{1}{3},\\,0⟩\\end{aligned}\n$$\n\nFinally, we obtain the curvature:\n\n$$\n\\begin{aligned}κ(\\frac{3\\pi }{2}) & =‖{T}^{′}(\\frac{3\\pi }{2})‖=\\sqrt{{0}^{2}+{(-\\frac{1}{3})}^{2}+{0}^{2}}=\\frac{1}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120580 #edb/ref 1058 #edb/ref 17592186120581 #edb/ref 17592186045417] [17592186120580 #edb/ref 1061 10650 #edb/ref 17592186045417] [17592186120580 #edb/ref 1062 #uuid "12125b22-92e2-567c-9dc7-87e721cb0430" #edb/ref 17592186045417] [17592186120580 #edb/ref 1063 #edb/ref 17592186121002 #edb/ref 17592186045417] [17592186120581 #edb/ref 1058 #edb/ref 17592186120583 #edb/ref 17592186045417] [17592186120581 #edb/ref 1061 10651 #edb/ref 17592186045417] [17592186120581 #edb/ref 1062 #uuid "9b2d3984-cd37-5bc8-b3ce-f427ae5bd607" #edb/ref 17592186045417] [17592186120581 #edb/ref 1063 #edb/ref 17592186119748 #edb/ref 17592186045417] [17592186120582 #edb/ref 1061 10657 #edb/ref 17592186045417] [17592186120582 #edb/ref 1062 #uuid "cd83eef1-8999-5702-814d-b4f011d666e1" #edb/ref 17592186045417] [17592186120582 #edb/ref 1063 #edb/ref 17592186119749 #edb/ref 17592186045417] [17592186120583 #edb/ref 1058 #edb/ref 17592186120594 #edb/ref 17592186045417] [17592186120583 #edb/ref 1061 10658 #edb/ref 17592186045417] [17592186120583 #edb/ref 1062 #uuid "3a00b3b6-447c-5ccc-97a8-7cd65929b702" #edb/ref 17592186045417] [17592186120583 #edb/ref 1063 #edb/ref 17592186119750 #edb/ref 17592186045417] [17592186120594 #edb/ref 1058 #edb/ref 17592186120582 #edb/ref 17592186045417] [17592186120594 #edb/ref 1061 11099 #edb/ref 17592186045417] [17592186120594 #edb/ref 1062 #uuid "d9dd47a2-479b-5929-a71d-4ad46370bfb7" #edb/ref 17592186045417] [17592186120594 #edb/ref 1063 #edb/ref 17592186121007 #edb/ref 17592186045417] [17592186121002 #edb/ref 1064 "The **curvature** of a curve measures how much the curve \"bends\" at a given point. It can also be thought of as a measure of how much the curve deviates from being a straight line. Curvature is denoted by the Greek letter $\\kappa$ (pronounced \"kappa\"). \n\nIf $\\kappa=0$ at some point on a curve, then that curve looks like a straight line in some neighborhood of the point.\n\nIf the curve $\\mathbf{r}(s)$ is parametrized by the arc length $s,$ then the curvature $\\kappa$ is the magnitude of the change of direction of the unit tangent vector $\\mathbf T$ per unit of arc length. That is,\n\n$$\n\\kappa(s) = \\left\\| \\dfrac{\\textrm{d}\\mathbf T}{\\textrm{d}s}  \\right\\|= \\| \\mathbf T'(s) \\|.\n$$\n\nNote that $|| \\mathbf v ||$ denotes the magnitude of the vector $\\mathbf v.$\n\nFor example, suppose we are given the curve \n\n$$\n\\mathbf r(s)= \\left\\langle \\sin\\left(\\dfrac s2\\right), \\: \\dfrac{\\sqrt{3}s}{2}, \\: -\\cos\\left(\\dfrac s2\\right)\\right\\rangle\n$$\n\n \nwhich is parametrized by arc length $s.$ Let's find the curvature of  $\\mathbf r(s)$  at the point where $s={\\pi}.$\n\nFirst, we find the unit tangent vector:\n\n$$\n\\mathbf T(s) =\\dfrac 12 \\left\\langle \\cos\\left( \\dfrac s2\\right), \\: \\sqrt{3}, \\: \\sin \\left(\\dfrac s2\\right)\\right\\rangle\n$$\n\n \n\nNext, we differentiate $\\mathbf{T}(s)$ and evaluate its absolute value at $s=\\pi\\mathbin{:}$\n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{1}{2}⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡(\\frac{s}{2})),\\,\\frac{\\text{d}}{\\text{d}s}(\\sqrt{3}),\\,\\frac{\\text{d}}{\\text{d}s}(\\operatorname{sin}⁡(\\frac{s}{2}))⟩ \\\\  & =\\frac{1}{4}⟨-\\operatorname{sin}⁡(\\frac{s}{2}),\\,0,\\,\\operatorname{cos}⁡(\\frac{s}{2})⟩ \\\\ {T}^{′}(\\pi ) & =\\frac{1}{4}⟨-\\operatorname{sin}⁡(\\frac{\\pi }{2}),\\,0,\\,\\operatorname{cos}⁡(\\frac{\\pi }{2})⟩ \\\\  & =\\frac{1}{4}⟨-1,\\,0,\\,0⟩\\end{aligned}\n$$\n\nFinally, we obtain the curvature by taking the magnitude:\n\n$$\n\\begin{aligned}κ(\\pi ) & =‖{T}^{′}(\\pi )‖=\\frac{1}{4}\\sqrt{(-1)^{2}+{(0)}^{2}+{0}^{2}}=\\frac{1}{4}\\end{aligned}\n$$\n\n \n\n**Note:** To calculate $\\kappa,$ the function $\\mathbf{r}(s)$ should be at least twice differentiable with respect to $s.$" #edb/ref 17592186045417] [17592186121002 #edb/ref 1065 2402 #edb/ref 17592186045417] [17592186121002 #edb/ref 1066 #uuid "d74577d5-5fe6-5544-bd86-b20fee42defa" #edb/ref 17592186045417] [17592186121002 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121007 #edb/ref 1064 "If the curve $\\mathbf r(t)$ is parametrized by a general parameter $t,$ then\n\n$$\n\\kappa(t) = \\dfrac{\\|\\mathbf T'(t)\\|}{\\|\\mathbf r'(t)\\|}.\n$$\n\nTo understand why this is, remember that the arc length $s$ and the parameter $t$ are related by the formula \n\n$$\n\\displaystyle s(t)= \\int_0^t\\left\\| \\mathbf  r'(x)\\right\\|\\, \\textrm dx.\n$$\n\nBy the chain rule and the fundamental theorem of calculus, then, we have\n\n$$\n\\dfrac{\\textrm d  \\mathbf T}{\\textrm d t} = \\dfrac{\\textrm d  \\mathbf T}{\\textrm d s} \\dfrac{\\textrm d  s}{\\textrm d t}= \\dfrac{\\textrm d  \\mathbf T}{\\textrm d s} \\left\\| \\mathbf r'(t)\\right\\|.\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}‖\\frac{\\text{d}T}{\\text{d}t}‖ & =‖\\frac{\\text{d}T}{\\text{d}s}‖‖{r}^{′}(t)‖ \\\\ ‖{T}^{′}(t)‖ & =κ(t)‖{r}^{′}(t)‖ \\\\ κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121007 #edb/ref 1065 2484 #edb/ref 17592186045417] [17592186121007 #edb/ref 1066 #uuid "a3b41506-4cd1-5589-b3a6-4cd3f4ecbdb2" #edb/ref 17592186045417] [17592186121007 #edb/ref 1067 "The Curvature of Curves Parametrized Using a General Parameter" #edb/ref 17592186045417] [17592186264354 #edb/ref 1080 "\\frac{3t}{(9{t}^{2}+4)^{3/2}}" #edb/ref 17592186045417] [17592186264354 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264354 #edb/ref 1083 #uuid "9eac219c-4267-522b-be92-b62f92ac7ce4" #edb/ref 17592186045417] [17592186265007 #edb/ref 1080 "\\frac{6t}{(9{t}^{2}+4)^{2}}" #edb/ref 17592186045417] [17592186265007 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186265007 #edb/ref 1083 #uuid "e68618c1-a36d-5a2e-8722-fe2f8bcb89eb" #edb/ref 17592186045417] [17592186265010 #edb/ref 1080 "\\frac{6}{t(9{t}^{2}+4)^{3/2}}" #edb/ref 17592186045417] [17592186265010 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186265010 #edb/ref 1083 #uuid "e6a88715-d9ff-5280-9ca0-7d4d09ce406e" #edb/ref 17592186045417] [17592186265040 #edb/ref 1080 "\\frac{2}{\\sqrt{9{t}^{2}+4}}" #edb/ref 17592186045417] [17592186265040 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186265040 #edb/ref 1083 #uuid "ea457c6f-f692-586f-a47e-3cee22c3a295" #edb/ref 17592186045417] [17592186265058 #edb/ref 1080 "\\frac{3}{{t}^{2}\\sqrt{9{t}^{2}+4}}" #edb/ref 17592186045417] [17592186265058 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186265058 #edb/ref 1083 #uuid "eb89aad6-b8f7-5874-819d-e14ad0619362" #edb/ref 17592186045417] [17592186265554 #edb/ref 1075 #edb/ref 17592186264354 #edb/ref 17592186045417] [17592186265554 #edb/ref 1075 #edb/ref 17592186265007 #edb/ref 17592186045417] [17592186265554 #edb/ref 1075 #edb/ref 17592186265010 #edb/ref 17592186045417] [17592186265554 #edb/ref 1075 #edb/ref 17592186265040 #edb/ref 17592186045417] [17592186265554 #edb/ref 1075 #edb/ref 17592186265058 #edb/ref 17592186045417] [17592186265554 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265554 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265554 #edb/ref 1078 #edb/ref 17592186265010 #edb/ref 17592186045417] [17592186265554 #edb/ref 1079 #uuid "acc4f200-5c92-55c4-96c5-049c32e35817" #edb/ref 17592186045417] [17592186266065 #edb/ref 1068 #edb/ref 17592186265554 #edb/ref 17592186045417] [17592186266065 #edb/ref 1069 "q-131230" #edb/ref 17592186045417] [17592186266065 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186266065 #edb/ref 1071 "Find the curvature at an arbitrary point $t>0$ on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=⟨2t,\\,-3{t}^{2}⟩,\\,{T}^{′}(t)=-\\frac{6}{(9{t}^{2}+4)^{3/2}}⟨3t,\\,2⟩,\\,t\\ge 0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186266065 #edb/ref 1072 #uuid "ead3e0bf-d7e4-5bdd-88de-03a4e6ed527b" #edb/ref 17592186045417] [17592186266065 #edb/ref 1074 "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\frac{6}{(9{t}^{2}+4)^{3/2}}\\cdot \\sqrt{{(3t)}^{2}+{(2)}^{2}} \\\\  & =\\frac{6}{(9{t}^{2}+4)^{3/2}}\\cdot \\sqrt{9{t}^{2}+4} \\\\  & =\\frac{6}{9{t}^{2}+4} \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(2t)}^{2}+{(-3{t}^{2})}^{2}} \\\\  & =\\sqrt{4{t}^{2}+9{t}^{4}} \\\\  & =t\\sqrt{9{t}^{2}+4}\\end{aligned}\n$$\n\nHence, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖} \\\\  & =\\frac{(\\frac{6}{9{t}^{2}+4})}{t\\sqrt{9{t}^{2}+4}} \\\\  & =\\frac{6}{t(9{t}^{2}+4)^{3/2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186266243 #edb/ref 1080 "\\frac{1}{\\sqrt{{s}^{2}+1}}" #edb/ref 17592186045417] [17592186266243 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266243 #edb/ref 1083 #uuid "0adad88a-ab1b-5262-9f58-e77aaec08261" #edb/ref 17592186045417] [17592186266731 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186266731 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266731 #edb/ref 1083 #uuid "411f2175-9bdc-56de-9535-626f1db416bd" #edb/ref 17592186045417] [17592186267440 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186267440 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267440 #edb/ref 1083 #uuid "91be173e-099f-5c0e-be22-34b304fd7283" #edb/ref 17592186045417] [17592186267746 #edb/ref 1080 "\\frac{2}{{s}^{2}+1}" #edb/ref 17592186045417] [17592186267746 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267746 #edb/ref 1083 #uuid "b2f9fbee-c825-5d6c-8b8b-ea7d62f0db9a" #edb/ref 17592186045417] [17592186268172 #edb/ref 1080 "\\frac{s}{({s}^{2}+1)^{2}}" #edb/ref 17592186045417] [17592186268172 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186268172 #edb/ref 1083 #uuid "e579c2d9-705c-540e-bad7-22f86cbdddc9" #edb/ref 17592186045417] [17592186268504 #edb/ref 1075 #edb/ref 17592186266243 #edb/ref 17592186045417] [17592186268504 #edb/ref 1075 #edb/ref 17592186266731 #edb/ref 17592186045417] [17592186268504 #edb/ref 1075 #edb/ref 17592186267440 #edb/ref 17592186045417] [17592186268504 #edb/ref 1075 #edb/ref 17592186267746 #edb/ref 17592186045417] [17592186268504 #edb/ref 1075 #edb/ref 17592186268172 #edb/ref 17592186045417] [17592186268504 #edb/ref 1076 #edb/