 \\sqrt{4{s}^{4}+8{s}^{2}+4} \\\\  & =\\frac{1}{({s}^{2}+1)^{2}}\\cdot \\sqrt{4({s}^{2}+1)^{2}} \\\\  & =\\frac{2({s}^{2}+1)}{({s}^{2}+1)^{2}} \\\\  & =\\frac{2}{{s}^{2}+1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186333037 #edb/ref 1080 "\\frac{1}{3}" #edb/ref 17592186045417] [17592186333037 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186333037 #edb/ref 1083 #uuid "05a3aa75-660c-575d-82d3-d2c2e0ba5b84" #edb/ref 17592186045417] [17592186333069 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186333069 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186333069 #edb/ref 1083 #uuid "08550f3e-58a7-5558-9ee9-f59ca8cf9e3f" #edb/ref 17592186045417] [17592186333416 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186333416 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186333416 #edb/ref 1083 #uuid "2d5a98c6-f26e-5720-87d6-4668e8efbc20" #edb/ref 17592186045417] [17592186334048 #edb/ref 1080 "\\frac{1}{8}" #edb/ref 17592186045417] [17592186334048 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334048 #edb/ref 1083 #uuid "756b6572-d426-55d5-8a1f-860fff859319" #edb/ref 17592186045417] [17592186334757 #edb/ref 1080 "\\frac{1}{4}" #edb/ref 17592186045417] [17592186334757 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334757 #edb/ref 1083 #uuid "cb26701c-39d6-5b44-91a1-7766d3a0f3e8" #edb/ref 17592186045417] [17592186335259 #edb/ref 1075 #edb/ref 17592186333037 #edb/ref 17592186045417] [17592186335259 #edb/ref 1075 #edb/ref 17592186333069 #edb/ref 17592186045417] [17592186335259 #edb/ref 1075 #edb/ref 17592186333416 #edb/ref 17592186045417] [17592186335259 #edb/ref 1075 #edb/ref 17592186334048 #edb/ref 17592186045417] [17592186335259 #edb/ref 1075 #edb/ref 17592186334757 #edb/ref 17592186045417] [17592186335259 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186335259 #edb/ref 1077 "selection" #edb/ref 17592186045417] [175921