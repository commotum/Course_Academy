#{[{:db/id #edb/ref 17592186247159 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d3026ef-0c9f-56f6-9c82-deeb31d5c484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186244850} {:answer/id #uuid "9497acc2-e957-5d08-b023-f36e5c982edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245613} {:answer/id #uuid "b34b7ad9-ca5d-5d2e-8c18-a98455f051ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186245911} {:answer/id #uuid "b9e6cab8-baf8-54e3-aa8d-7bdaa5531b01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245973} {:answer/id #uuid "def3c3d6-726e-5345-9da6-7f08cc46817e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246290}] :answer-field/correct {:answer/id #uuid "def3c3d6-726e-5345-9da6-7f08cc46817e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246290} :answer-field/id #uuid "4c72e079-6317-5a21-9e66-00a4c7adfda0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246673}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "49bd226a-4547-5889-a62c-e6c2912a1520" :question/math-academy-id "q-110760" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:x-4y=1\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:x=-2y\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}<0\\}$" :question/worked-solution "Let's analyze each subset.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. For instance, $0=⟨0,0,0⟩$ does not satisfy the equation $x-4y=1$ since $0-4\\cdot 0=0\\ne 1.$\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x=-2y$ since $0=-2\\cdot 0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace. No point in ${R}^{3}$ satisfies the equation ${x}^{2}+{y}^{2}+{z}^{2}<0.$ Hence, $C=∅.$ The empty set is not a subspace since it does not contain the zero vector.\n\nIn conclusion, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186275442 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14ca2bb0-45fa-515e-86a8-cce64866690b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186272574} {:answer/id #uuid "604d7a59-1fef-523e-bf07-a9f5dd400e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273219} {:answer/id #uuid "6afe9e0d-cdbd-5294-ac31-28a3a86f03a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186273310} {:answer/id #uuid "a4a6743f-b156-512b-8812-e7ac6baca636" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273808} {:answer/id #uuid "dfde1b99-be1a-5fba-9ccf-784956f7918d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186274365}] :answer-field/correct {:answer/id #uuid "dfde1b99-be1a-5fba-9ccf-784956f7918d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186274365} :answer-field/id #uuid "73ce813a-1598-5c11-b720-fcf588d7f65b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ce01e6e-4d84-5a03-940c-8de7146f3c76" :question/math-academy-id "q-158101" :question/problem "![](images/27/2739a0225640ff20cc9678edf8c41ba45ff637b17a40d0322ca792bef1346f06.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram III represents a line passing through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186317349 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef4ac66-d953-5fba-ac6a-17597fb2834c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186315208} {:answer/id #uuid "28317ab6-956f-51f4-9c07-7893dc4262d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186315349} {:answer/id #uuid "6c9c2bd9-cb6c-5ceb-9adb-bb9bf53c2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186315732} {:answer/id #uuid "8cada019-11c7-5af3-83c1-8512283cb4ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186315902} {:answer/id #uuid "c19aff71-14a7-558f-9b3f-f6060cbbd5ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186316205}] :answer-field/correct {:answer/id #uuid "6c9c2bd9-cb6c-5ceb-9adb-bb9bf53c2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186315732} :answer-field/id #uuid "fbb47da4-af36-516e-a2d7-8a35d392e1aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317144}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "113a385d-0512-508f-a50c-e45bc26c3c1f" :question/math-academy-id "q-34300" :question/problem "![](images/cc/ccb3b1dc1f175f6f018cb10e47db43a2ac5b4377c565dec4ee389b2a80455203.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram I is not a subspace of ${R}^{2}.$\n\n- Diagram II is a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\n- Diagram III does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ lies outside the subset.\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186342187 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db4180e-9e56-5615-a261-a06b057afbc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339254} {:answer/id #uuid "44382309-a210-5068-b421-83edd371f540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339728} {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} {:answer/id #uuid "a661de8b-e986-5edb-ae2a-54d4fbff884d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340638} {:answer/id #uuid "ec1d59d6-b1c0-5ab1-b672-2772922e372b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341209}] :answer-field/correct {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} :answer-field/id #uuid "b4646991-5d1f-5339-9e5a-2aa1bae21d22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e93e600-4a01-5ada-842d-9b175b57ee56" :question/math-academy-id "q-74217" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\n- $A={⟨x,y,z⟩\\in {R}^{3}:1-x-y=0}$\n- $B={⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}\\le 1}$\n- $C={⟨x,y,z⟩\\in {R}^{3}:2x+3y-z=0}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $1-x-y=0$ since $1-0-0\\ne 0.$\n\n- The set $B$ is not a subspace. Indeed, the vector $u=⟨1,0,0⟩$ is in $B$, but $2u=⟨2,0,0⟩$ is not in $B$, since ${2}^{2}+{0}^{2}+{0}^{2}≰1.$ So, $B$ is not closed under scalar multiplication.\n\n- The set $C$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $2x+3y-z=0$ since $2\\cdot 0+3\\cdot 0-0=0.$ So $0$ lies in $C.$\n\nIn conclusion, the correct answer is \"III only.\""}]}
