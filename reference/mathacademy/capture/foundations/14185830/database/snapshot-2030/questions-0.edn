#{[{:db/id #edb/ref 17592186363031 :knowledge-point/_questions [{:db/id #edb/ref 17592186124455 :knowledge-point/id #uuid "348fa49f-2af8-5562-91f6-3f70bb93ea90" :knowledge-point/title "Finding a Tangent Vector to a Plane Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f3795a-9c5d-564b-99c5-8234a8f8adae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,j" :db/id #edb/ref 17592186363033} {:answer/id #uuid "17117ea5-c48d-5a75-87dd-44fd4b306516" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-2\\,j" :db/id #edb/ref 17592186363034} {:answer/id #uuid "a1a1d040-84f6-5093-b8b7-a02c512a3ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,i-2\\,j" :db/id #edb/ref 17592186363035} {:answer/id #uuid "afb47ff5-03cb-5158-9e15-6ff6eeca5436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,i" :db/id #edb/ref 17592186363036} {:answer/id #uuid "0c788786-b66b-5944-b4ad-21c56064f8a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186363037}] :answer-field/correct {:answer/id #uuid "0c788786-b66b-5944-b4ad-21c56064f8a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186363037} :answer-field/id #uuid "d07c4d10-4f15-5f81-9aca-9c05aa1a4821" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363032}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55fb49e6-3301-5747-997a-6aea4f919a61" :question/math-academy-id "q-130201" :question/problem "Consider the plane curve $xy=3-{x}^{2}-{y}^{3}.$ Find a tangent vector to that curve at the point $(-1,-1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}xy & =3-{x}^{2}-{y}^{3} \\\\ xy+{x}^{2}+{y}^{3} & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)=xy+{x}^{2}+{y}^{3},$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve that passes through the point $(-1,-1)$ can be computed as follows:\n\n$$\nt(-1,-1)={f}_{y}(-1,-1)i-{f}_{x}(-1,-1)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,-1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(xy+{x}^{2}+{y}^{3})i-\\frac{∂}{∂x}(xy+{x}^{2}+{y}^{3})j \\\\  & =(x+3{y}^{2})i-(y+2x)j \\\\ t(-1,-1) & =(-1+3(-1)^{2})i-(-1+2(-1))j \\\\  & =2\\,i+3\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $2\\,i+3\\,j.$"}] [{:db/id #edb/ref 17592186124970 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cece21e-845c-5406-87a0-7fadb456d6b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439641} {:answer/id #uuid "de5a9a5b-9a4a-5dff-ae52-46bed3fefdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439642}] :answer-field/correct {:answer/id #uuid "de5a9a5b-9a4a-5dff-ae52-46bed3fefdc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439642} :answer-field/id #uuid "96d13053-52c8-5327-9cdc-96cbda5b9553" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440178} {:answer-field/choices [{:answer/id #uuid "035c9f0e-cadd-5cfc-8ae0-b3b87f593d82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false