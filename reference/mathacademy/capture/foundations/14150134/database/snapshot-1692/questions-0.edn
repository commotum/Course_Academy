3 & 0 \\\\ 0 & 0 & 3 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 2 & 2 & 0 & 6 \\\\ 0 & 0 & 0 & 0 & 2 \\\\ 0 & 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 1 & 6 \\\\ 0 & 0 & 2 & -3\\end{aligned}]\n$$" :question/worked-solution "First, notice that a matrix of rank $3$ must have at least $3$ columns and at least $3$ rows. \nSo, we disregard the matrix $C$ since it has only $2$ rows. \n\nAlso, the matrix must have $3$ pivot columns. As we can see, the matrices  $A$ and $B$ have exactly $3$ pivot columns.  So, $\\text{rank}(A)=\\text{rank}(B)=3.$\n\nTherefore, the correct answers are \"$A$  and $B$ only.\""}] [{:db/id #edb/ref 17592186321043 :knowledge-point/_questions [{:db/id #edb/ref 17592186119848 :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "293ae16a-3b0c-55c8-8fd1-0b62cdbc95fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186319523} {:answer/id #uuid "9746878c-7c14-5d13-a1ef-36f1e770e71c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186319840} {:answer/id #uuid "a2fa24c4-cd40-5277-9097-8340a67b9342" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186319876} {:answer/id #uuid "bf31823e-18bc-580e-b915-028a69bb1c8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186319977} {:answer/id #uuid "ce6a7b23-9a34-5d28-9f7b-301a3b7c8c12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186320024}] :answer-field/correct {:answer/id #uuid "ce6a7b23-9a34-5d28-9f7b-301a3b7c8c12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186320024} :answer-field/id #uuid "28e7ddf0-1cef-5068-bb9a-a3a4cbecd4b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43599508-ddd2-50d6-b640-692e29bcfb0e" :question/math-academy-id "q-35283" :question/problem "Which of the following matrices have a rank of $6?$\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 & 6 \\\\ 0 & 0 & 3 & 7 & 5 \\\\ 0 & 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 & 6 \\\\ 0 & 4 & 2 & -3 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 2 & 2 & 5 & 2 \\\\ 0 & 1 & 3 & 1 & 0 & 1 \\\\ 0 & 0 & 3 & 4 & 7 & 2 \\\\ 0 & 0 & 0 & 1 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & 4 & 1 \\\\ 0 & 0 & 0 & 0 & 0 & 2\\end{aligned}]\n$$" :question/worked-solution "First, notice that a matrix of rank $6$ must have at least $6$ columns and at least $6$ rows. \nSo, we disregard the matrix $A$ since it has only $5$ columns and the matrix $B$ since it has only $4$ columns.\n\nAlso, the matrix must have $6$ pivot columns. As we can see, the matrix $C$ has exactly $6$ pivot columns. So, $\\text{rank}(C)=6.$\n\nTherefore, the correct answer is \"$C$ only\"."}]}
