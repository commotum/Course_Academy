[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186166957 :knowledge-point/questions ["question-e7016461-6868-574f-be42-632e56b55fe8" "question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166958 :knowledge-point/questions ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" "question-6da2a50a-0f62-59bb-a9db-a784f084c0f1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166959 :knowledge-point/questions ["question-3fb491ae-d461-5efd-a743-cfec479bf958" "question-55d2ffed-9ece-55ed-baea-5ef5a75af131"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e7016461-6868-574f-be42-632e56b55fe8" :question/id #uuid "e7016461-6868-574f-be42-632e56b55fe8" :question/math-academy-id "q-341253" :question/problem "Let $F(x)=x{e}^{x}$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is the value of $f(-2)?$\n\n$f(-2)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x){e}^{-x} \\\\  & =-x{e}^{-x}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-2) & =-(-2){e}^{-(-2)}=2{e}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca"] :db/ensure [:question/validate]} {:db/id "answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/id #uuid "33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer-field/choices ["answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer/id #uuid "c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer/type :answer.type/math :answer/value "2e^{2}" :db/ensure [:answer/validate]} {:db/id "question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/id #uuid "c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/math-academy-id "q-341248" :question/problem "Let $F(x)=3{e}^{x}+x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =3{e}^{(-x)}+(-x) \\\\  & =3{e}^{-x}-x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d"] :db/ensure [:question/validate]} {:db/id "answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/id #uuid "1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53f8248e-b61e-57c4-9472-cf097523c0cc" :answer-field/choices ["answer-8a035a53-368d-5ef3-a187-6c5da17a9adb" "answer-cbf6290f-8f7d-5951-80e5-580a05d0949d" "answer-53f8248e-b61e-57c4-9472-cf097523c0cc" "answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3" "answer-a68a74b2-3252-5129-925b-06ed8785be3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a035a53-368d-5ef3-a187-6c5da17a9adb" :answer/id #uuid "8a035a53-368d-5ef3-a187-6c5da17a9adb" :answer/type :answer.type/math :answer/value "-3{e}^{x}+x" :db/ensure [:answer/validate]} {:db/id "answer-cbf6290f-8f7d-5951-80e5-580a05d0949d" :answer/id #uuid "cbf6290f-8f7d-5951-80e5-580a05d0949d" :answer/type :answer.type/math :answer/value "-3{e}^{x}-x" :db/ensure [:answer/validate]} {:db/id "answer-53f8248e-b61e-57c4-9472-cf097523c0cc" :answer/id #uuid "53f8248e-b61e-57c4-9472-cf097523c0cc" :answer/type :answer.type/math :answer/value "3{e}^{-x}-x" :db/ensure [:answer/validate]} {:db/id "answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3" :answer/id #uuid "4c3e4b13-f674-524e-998b-ca67fbac5bf3" :answer/type :answer.type/math :answer/value "3{e}^{-x}-|x|" :db/ensure [:answer/validate]} {:db/id "answer-a68a74b2-3252-5129-925b-06ed8785be3a" :answer/id #uuid "a68a74b2-3252-5129-925b-06ed8785be3a" :answer/type :answer.type/math :answer/value "|3{e}^{x}-x|" :db/ensure [:answer/validate]} {:db/id 17592186315070 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186314028 :answer-field/correct "answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer-field/choices ["answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer/id #uuid "21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer/type :answer.type/math :answer/value "2\\pi^{2}+4" :db/ensure [:answer/validate]} {:db/id "question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/id #uuid "6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/math-academy-id "q-341274" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=5{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{5{x}^{3}}{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{5{\\pi }^{3}}{3}+\\pi )-0 \\\\  & =2(\\frac{5{\\pi }^{2}}{3}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba"] :db/ensure [:question/validate]} {:db/id "answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/id #uuid "fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer-field/choices ["answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39"] :db/ensure [:answer-field/validate]} {:db/id "answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer/id #uuid "72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer/type :answer.type/math :answer/value "2(\\frac{5\\pi^{2}}{3}+1)" :db/ensure [:answer/validate]} {:db/id "question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/id #uuid "6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/math-academy-id "q-341277" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=6{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=6{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(6{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[2{x}^{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(2{\\pi }^{3}+\\pi )-0 \\\\  & =2(2{\\pi }^{2}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48"] :db/ensure [:question/validate]} {:db/id "answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/id #uuid "989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-50462a04-0887-512d-8b96-cd650e92389f" :answer-field/choices ["answer-50462a04-0887-512d-8b96-cd650e92389f"] :db/ensure [:answer-field/validate]} {:db/id "answer-50462a04-0887-512d-8b96-cd650e92389f" :answer/id #uuid "50462a04-0887-512d-8b96-cd650e92389f" :answer/type :answer.type/math :answer/value "4\\pi^{2}+2" :db/ensure [:answer/validate]} {:db/id 17592186314316 :answer-field/correct "answer-07aa64d0-a645-5949-a1b8-1717374a9409" :answer-field/choices ["answer-07aa64d0-a645-5949-a1b8-1717374a9409"] :db/ensure [:answer-field/validate]} {:db/id "answer-07aa64d0-a645-5949-a1b8-1717374a9409" :answer/id #uuid "07aa64d0-a645-5949-a1b8-1717374a9409" :answer/type :answer.type/math :answer/value "2(\\frac{5\\pi^{2}}{3}+2)" :db/ensure [:answer/validate]} {:db/id 17592186372764 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-4x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$" :db/ensure [:question/validate]} {:db/id "question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/id #uuid "3fb491ae-d461-5efd-a743-cfec479bf958" :question/math-academy-id "q-341272" :question/problem "Let $F(x)=7x-4$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=7x-4$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(7x-4)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=7x-4\\, & ⇒\\,{u}^{′}=7 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(7x-4)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{7}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((7\\pi -4)\\operatorname{sin}⁡(n\\pi )+4\\operatorname{sin}⁡(0))+\\frac{7}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{7}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{14(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" "answer-field-e947fd84-1d63-5d10-af30-150e8c1aaa94"] :db/ensure [:question/validate]} {:db/id "answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/id #uuid "d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-dca6add2-e954-506c-a341-17bf48c25508" :answer-field/choices ["answer-dca6add2-e954-506c-a341-17bf48c25508" "answer-53619ed7-f716-5872-bb91-4731ed352f3e" "answer-af2db65f-09c0-5208-935f-ed4720f1faa4" "answer-bd23cd8e-42fd-5b65-a59e-dd4b56e28318"] :db/ensure [:answer-field/validate]} {:db/id "answer-dca6add2-e954-506c-a341-17bf48c25508" :answer/id #uuid "dca6add2-e954-506c-a341-17bf48c25508" :answer/type :answer.type/math :answer/value "\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-53619ed7-f716-5872-bb91-4731ed352f3e" :answer/id #uuid "53619ed7-f716-5872-bb91-4731ed352f3e" :answer/type :answer.type/math :answer/value "\\frac{14(-1)^{n}}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-af2db65f-09c0-5208-935f-ed4720f1faa4" :answer/id #uuid "af2db65f-09c0-5208-935f-ed4720f1faa4" :answer/type :answer.type/math :answer/value "\\frac{7(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-bd23cd8e-42fd-5b65-a59e-dd4b56e28318" :answer/id #uuid "bd23cd8e-42fd-5b65-a59e-dd4b56e28318" :answer/type :answer.type/math :answer/value "\\frac{7(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-field-e947fd84-1d63-5d10-af30-150e8c1aaa94" :answer-field/id #uuid "e947fd84-1d63-5d10-af30-150e8c1aaa94" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ae359aa2-bf84-57b5-a9b5-a73878b31559" :answer-field/choices ["answer-b86447de-2c58-5341-ad44-f2f7823d34e6" "answer-ae359aa2-bf84-57b5-a9b5-a73878b31559" "answer-e939c31e-32f1-563a-b202-962cdcdaa980" "answer-576ea93a-944b-514c-b440-bd611ca2b89d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b86447de-2c58-5341-ad44-f2f7823d34e6" :answer/id #uuid "b86447de-2c58-5341-ad44-f2f7823d34e6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-ae359aa2-bf84-57b5-a9b5-a73878b31559" :answer/id #uuid "ae359aa2-bf84-57b5-a9b5-a73878b31559" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "answer-e939c31e-32f1-563a-b202-962cdcdaa980" :answer/id #uuid "e939c31e-32f1-563a-b202-962cdcdaa980" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-576ea93a-944b-514c-b440-bd611ca2b89d" :answer/id #uuid "576ea93a-944b-514c-b440-bd611ca2b89d" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/id #uuid "55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/math-academy-id "q-341270" :question/problem "Let $F(x)=4x-1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=4x-1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(4x-1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=4x-1\\, & ⇒\\,{u}^{′}=4 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(4x-1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{4}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((4\\pi -1)\\operatorname{sin}⁡(n\\pi )+\\operatorname{sin}⁡(0))+\\frac{4}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{4}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" "answer-field-901c601c-f36e-56ff-8079-21f7d8654a35"] :db/ensure [:question/validate]} {:db/id "answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/id #uuid "98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-056c1313-4dba-5537-a415-25f647daba6b" :answer-field/choices ["answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf" "answer-0eff6f24-e788-53dc-aa43-0b1981e833d5" "answer-056c1313-4dba-5537-a415-25f647daba6b" "answer-f025807f-1fdc-5d45-89ab-f5216051c571"] :db/ensure [:answer-field/validate]} {:db/id "answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf" :answer/id #uuid "58ac06ce-36f1-5449-b206-87a2a6fdd1bf" :answer/type :answer.type/math :answer/value "\\frac{4(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-0eff6f24-e788-53dc-aa43-0b1981e833d5" :answer/id #uuid "0eff6f24-e788-53dc-aa43-0b1981e833d5" :answer/type :answer.type/math :answer/value "\\frac{4(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-056c1313-4dba-5537-a415-25f647daba6b" :answer/id #uuid "056c1313-4dba-5537-a415-25f647daba6b" :answer/type :answer.type/math :answer/value "\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-f025807f-1fdc-5d45-89ab-f5216051c571" :answer/id #uuid "f025807f-1fdc-5d45-89ab-f5216051c571" :answer/type :answer.type/math :answer/value "\\frac{8(-1)^{n}}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/id #uuid "901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-29b55494-ac2b-59d3-bb0c-453e8c568926" :answer-field/choices ["answer-eae7207f-15cc-547a-b08d-546f2343cef6" "answer-29b55494-ac2b-59d3-bb0c-453e8c568926" "answer-5cd2ef81-c957-504d-a56d-8a2440f1685a" "answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-eae7207f-15cc-547a-b08d-546f2343cef6" :answer/id #uuid "eae7207f-15cc-547a-b08d-546f2343cef6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-29b55494-ac2b-59d3-bb0c-453e8c568926" :answer/id #uuid "29b55494-ac2b-59d3-bb0c-453e8c568926" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "answer-5cd2ef81-c957-504d-a56d-8a2440f1685a" :answer/id #uuid "5cd2ef81-c957-504d-a56d-8a2440f1685a" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4" :answer/id #uuid "ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id 17592186372771 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-8x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$" :db/ensure [:question/validate]} {:db/id 17592186168044 :tutorial/content "In the earlier topics, we saw that *symmetry* can force many Fourier coefficients to be zero automatically.\nIn particular, if a $2\\pi$-periodic function is *even*, then its Fourier series has *cosine terms only*.\n\nA **Fourier cosine series** uses this idea when a function is initially given only on the half-interval $[0,\\pi),$ but we want a full Fourier series on $[-\\pi,\\pi)$ (and then a $2\\pi$-periodic extension to all real $x$).\n\nTo do this, we start with a function $F(x)$ on $[0,\\pi)$ and define its **even extension** $f(x)$ to $(-\\pi,\\pi)$ by\n![](images/e2/e2e07048ac4750968947e45443f59096f395b159d4f7a846410a711194b11a14.svg)\n\nFor example, a function $F(x),$ defined on $x \\in [0,1),$ and its even extension $f(x)$ to $x \\in (-1,1)$ are shown below.\n\n![](images/33/33d92f280a5672c8d9d94553ccc1ada2a9c5ea1ff12344ca8c9aeca9f44c40c6.png)\n\nBy construction, $f$ is an *even* function, meaning $f(-x)=f(x)$. Because $f$ is even, its Fourier series on $[-\\pi,\\pi)$ has *cosine terms only*:\n\n$$\nf(x)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty} a_n\\cos(nx)\n$$\n\nSince $f(x)$ is even and $\\cos(nx)$ is even for any $n\\ge 1,$ the product $f(x)\\cos(nx)$ is even too. Therefore, the cosine coefficients can be computed using the *half-range formulas*:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x,\\end{aligned}\n$$\n\nand for $n\\ge 1,$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\\end{aligned}\n$$\n\nSo in practice, the workflow is the following:\n\n1\\. Start with $F$ on $[0,\\pi)$ and form the even extension $f$ on $(-\\pi,\\pi).$\n\n2\\. Compute $a_0$ and $a_n$ from the half-range integrals on $[0,\\pi).$\n\n3\\. Write the Fourier cosine series of $f.$\n\nLet's see some concrete examples." :db/ensure [:tutorial/validate]}] "assertions" [["question-e7016461-6868-574f-be42-632e56b55fe8" :question/id #uuid "e7016461-6868-574f-be42-632e56b55fe8"] ["question-e7016461-6868-574f-be42-632e56b55fe8" :question/math-academy-id "q-341253"] ["question-e7016461-6868-574f-be42-632e56b55fe8" :question/problem "Let $F(x)=x{e}^{x}$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is the value of $f(-2)?$\n\n$f(-2)=$\n{{field-1}}"] ["question-e7016461-6868-574f-be42-632e56b55fe8" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x){e}^{-x} \\\\  & =-x{e}^{-x}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-2) & =-(-2){e}^{-(-2)}=2{e}^{2}.\\end{aligned}\n$$"] ["question-e7016461-6868-574f-be42-632e56b55fe8" :question/difficulty :question.difficulty/moderate] ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/id #uuid "33c5cf45-afa5-52d9-bf6d-70e8f10c09ca"] ["answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer/id #uuid "c1cad84c-acf8-5668-92f8-e74a909e2dd0"] ["answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer/type :answer.type/math] ["answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0" :answer/value "2e^{2}"] ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/key "field-1"] ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/type :answer-field.type/blank] ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/correct "answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0"] ["answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca" :answer-field/choices "answer-c1cad84c-acf8-5668-92f8-e74a909e2dd0"] ["question-e7016461-6868-574f-be42-632e56b55fe8" :question/answer-fields "answer-field-33c5cf45-afa5-52d9-bf6d-70e8f10c09ca"] [17592186166957 :knowledge-point/questions "question-e7016461-6868-574f-be42-632e56b55fe8"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/id #uuid "c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/math-academy-id "q-341248"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/problem "Let $F(x)=3{e}^{x}+x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =3{e}^{(-x)}+(-x) \\\\  & =3{e}^{-x}-x.\\end{aligned}\n$$"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/difficulty :question.difficulty/easy] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/id #uuid "1d248267-7b72-5ad1-a04c-f3637b43ad5d"] ["answer-8a035a53-368d-5ef3-a187-6c5da17a9adb" :answer/id #uuid "8a035a53-368d-5ef3-a187-6c5da17a9adb"] ["answer-8a035a53-368d-5ef3-a187-6c5da17a9adb" :answer/type :answer.type/math] ["answer-8a035a53-368d-5ef3-a187-6c5da17a9adb" :answer/value "-3{e}^{x}+x"] ["answer-cbf6290f-8f7d-5951-80e5-580a05d0949d" :answer/id #uuid "cbf6290f-8f7d-5951-80e5-580a05d0949d"] ["answer-cbf6290f-8f7d-5951-80e5-580a05d0949d" :answer/type :answer.type/math] ["answer-cbf6290f-8f7d-5951-80e5-580a05d0949d" :answer/value "-3{e}^{x}-x"] ["answer-53f8248e-b61e-57c4-9472-cf097523c0cc" :answer/id #uuid "53f8248e-b61e-57c4-9472-cf097523c0cc"] ["answer-53f8248e-b61e-57c4-9472-cf097523c0cc" :answer/type :answer.type/math] ["answer-53f8248e-b61e-57c4-9472-cf097523c0cc" :answer/value "3{e}^{-x}-x"] ["answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3" :answer/id #uuid "4c3e4b13-f674-524e-998b-ca67fbac5bf3"] ["answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3" :answer/type :answer.type/math] ["answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3" :answer/value "3{e}^{-x}-|x|"] ["answer-a68a74b2-3252-5129-925b-06ed8785be3a" :answer/id #uuid "a68a74b2-3252-5129-925b-06ed8785be3a"] ["answer-a68a74b2-3252-5129-925b-06ed8785be3a" :answer/type :answer.type/math] ["answer-a68a74b2-3252-5129-925b-06ed8785be3a" :answer/value "|3{e}^{x}-x|"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/key "selection"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/type :answer-field.type/radio] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/correct "answer-53f8248e-b61e-57c4-9472-cf097523c0cc"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/choices "answer-8a035a53-368d-5ef3-a187-6c5da17a9adb"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/choices "answer-cbf6290f-8f7d-5951-80e5-580a05d0949d"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/choices "answer-53f8248e-b61e-57c4-9472-cf097523c0cc"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/choices "answer-4c3e4b13-f674-524e-998b-ca67fbac5bf3"] ["answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d" :answer-field/choices "answer-a68a74b2-3252-5129-925b-06ed8785be3a"] ["question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" :question/answer-fields "answer-field-1d248267-7b72-5ad1-a04c-f3637b43ad5d"] [17592186166957 :knowledge-point/questions "question-c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf"] [17592186315070 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$"] ["answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer/id #uuid "21b1871f-2843-5201-8ffe-93f44e6e1f8f"] ["answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer/type :answer.type/math] ["answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f" :answer/value "2\\pi^{2}+4"] [17592186314028 :answer-field/correct "answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f"] [17592186314028 :answer-field/choices "answer-21b1871f-2843-5201-8ffe-93f44e6e1f8f"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/id #uuid "6c123c90-9e3c-534f-a040-61cb255aa0e6"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/math-academy-id "q-341274"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=5{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{5{x}^{3}}{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{5{\\pi }^{3}}{3}+\\pi )-0 \\\\  & =2(\\frac{5{\\pi }^{2}}{3}+1).\\end{aligned}\n$$"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/difficulty :question.difficulty/easy] ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/id #uuid "fdceacd7-e832-59cd-b2a8-3585e4638dba"] ["answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer/id #uuid "72a81ffa-dc5e-51a3-a7da-856e67b88f39"] ["answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer/type :answer.type/math] ["answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39" :answer/value "2(\\frac{5\\pi^{2}}{3}+1)"] ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/key "field-1"] ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/type :answer-field.type/blank] ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/correct "answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39"] ["answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba" :answer-field/choices "answer-72a81ffa-dc5e-51a3-a7da-856e67b88f39"] ["question-6c123c90-9e3c-534f-a040-61cb255aa0e6" :question/answer-fields "answer-field-fdceacd7-e832-59cd-b2a8-3585e4638dba"] [17592186166958 :knowledge-point/questions "question-6c123c90-9e3c-534f-a040-61cb255aa0e6"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/id #uuid "6da2a50a-0f62-59bb-a9db-a784f084c0f1"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/math-academy-id "q-341277"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=6{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=6{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(6{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[2{x}^{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(2{\\pi }^{3}+\\pi )-0 \\\\  & =2(2{\\pi }^{2}+1).\\end{aligned}\n$$"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/difficulty :question.difficulty/easy] ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/id #uuid "989a790f-36d6-537f-bac0-75e070b26f48"] ["answer-50462a04-0887-512d-8b96-cd650e92389f" :answer/id #uuid "50462a04-0887-512d-8b96-cd650e92389f"] ["answer-50462a04-0887-512d-8b96-cd650e92389f" :answer/type :answer.type/math] ["answer-50462a04-0887-512d-8b96-cd650e92389f" :answer/value "4\\pi^{2}+2"] ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/key "field-1"] ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/type :answer-field.type/blank] ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/correct "answer-50462a04-0887-512d-8b96-cd650e92389f"] ["answer-field-989a790f-36d6-537f-bac0-75e070b26f48" :answer-field/choices "answer-50462a04-0887-512d-8b96-cd650e92389f"] ["question-6da2a50a-0f62-59bb-a9db-a784f084c0f1" :question/answer-fields "answer-field-989a790f-36d6-537f-bac0-75e070b26f48"] [17592186166958 :knowledge-point/questions "question-6da2a50a-0f62-59bb-a9db-a784f084c0f1"] ["answer-07aa64d0-a645-5949-a1b8-1717374a9409" :answer/id #uuid "07aa64d0-a645-5949-a1b8-1717374a9409"] ["answer-07aa64d0-a645-5949-a1b8-1717374a9409" :answer/type :answer.type/math] ["answer-07aa64d0-a645-5949-a1b8-1717374a9409" :answer/value "2(\\frac{5\\pi^{2}}{3}+2)"] [17592186314316 :answer-field/correct "answer-07aa64d0-a645-5949-a1b8-1717374a9409"] [17592186314316 :answer-field/choices "answer-07aa64d0-a645-5949-a1b8-1717374a9409"] [17592186372764 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-4x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/id #uuid "3fb491ae-d461-5efd-a743-cfec479bf958"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/math-academy-id "q-341272"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/problem "Let $F(x)=7x-4$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=7x-4$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(7x-4)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=7x-4\\, & ⇒\\,{u}^{′}=7 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(7x-4)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{7}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((7\\pi -4)\\operatorname{sin}⁡(n\\pi )+4\\operatorname{sin}⁡(0))+\\frac{7}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{7}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{14(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/difficulty :question.difficulty/moderate] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/id #uuid "d8649ec8-1d2d-592d-8063-88c05a6c45a3"] ["answer-dca6add2-e954-506c-a341-17bf48c25508" :answer/id #uuid "dca6add2-e954-506c-a341-17bf48c25508"] ["answer-dca6add2-e954-506c-a341-17bf48c25508" :answer/type :answer.type/math] ["answer-dca6add2-e954-506c-a341-17bf48c25508" :answer/value "\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}"] ["answer-53619ed7-f716-5872-bb91-4731ed352f3e" :answer/id #uuid "53619ed7-f716-5872-bb91-4731ed352f3e"] ["answer-53619ed7-f716-5872-bb91-4731ed352f3e" :answer/type :answer.type/math] ["answer-53619ed7-f716-5872-bb91-4731ed352f3e" :answer/value "\\frac{14(-1)^{n}}{\\pi {n}^{2}}"] ["answer-af2db65f-09c0-5208-935f-ed4720f1faa4" :answer/id #uuid "af2db65f-09c0-5208-935f-ed4720f1faa4"] ["answer-af2db65f-09c0-5208-935f-ed4720f1faa4" :answer/type :answer.type/math] ["answer-af2db65f-09c0-5208-935f-ed4720f1faa4" :answer/value "\\frac{7(-1)^{n}}{\\pi n}"] ["answer-bd23cd8e-42fd-5b65-a59e-dd4b56e28318" :answer/id #uuid "bd23cd8e-42fd-5b65-a59e-dd4b56e28318"] ["answer-bd23cd8e-42fd-5b65-a59e-dd4b56e28318" :answer/type :answer.type/math] ["answer-bd23cd8e-42fd-5b65-a59e-dd4b56e28318" :answer/value "\\frac{7(1-(-1)^{n})}{\\pi n}"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/key "field-1"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/type :answer-field.type/select] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/correct "answer-dca6add2-e954-506c-a341-17bf48c25508"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/choices "answer-dca6add2-e954-506c-a341-17bf48c25508"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/choices "answer-53619ed7-f716-5872-bb91-4731ed352f3e"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/choices "answer-af2db65f-09c0-5208-935f-ed4720f1faa4"] ["answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3" :answer-field/choices "answer-bd23cd8e-42fd-5b65-a59e