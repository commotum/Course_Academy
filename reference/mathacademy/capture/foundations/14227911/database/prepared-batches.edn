440-bd611ca2b89d"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/answer-fields "answer-field-d8649ec8-1d2d-592d-8063-88c05a6c45a3"] ["question-3fb491ae-d461-5efd-a743-cfec479bf958" :question/answer-fields "answer-field-e947fd84-1d63-5d10-af30-150e8c1aaa94"] [17592186166959 :knowledge-point/questions "question-3fb491ae-d461-5efd-a743-cfec479bf958"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/id #uuid "55d2ffed-9ece-55ed-baea-5ef5a75af131"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/math-academy-id "q-341270"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/problem "Let $F(x)=4x-1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=4x-1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(4x-1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=4x-1\\, & ⇒\\,{u}^{′}=4 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(4x-1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{4}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((4\\pi -1)\\operatorname{sin}⁡(n\\pi )+\\operatorname{sin}⁡(0))+\\frac{4}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{4}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/difficulty :question.difficulty/moderate] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/id #uuid "98620a41-f0fa-569b-a3ec-5642c8206fa4"] ["answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf" :answer/id #uuid "58ac06ce-36f1-5449-b206-87a2a6fdd1bf"] ["answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf" :answer/type :answer.type/math] ["answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf" :answer/value "\\frac{4(-1)^{n}}{\\pi n}"] ["answer-0eff6f24-e788-53dc-aa43-0b1981e833d5" :answer/id #uuid "0eff6f24-e788-53dc-aa43-0b1981e833d5"] ["answer-0eff6f24-e788-53dc-aa43-0b1981e833d5" :answer/type :answer.type/math] ["answer-0eff6f24-e788-53dc-aa43-0b1981e833d5" :answer/value "\\frac{4(1-(-1)^{n})}{\\pi n}"] ["answer-056c1313-4dba-5537-a415-25f647daba6b" :answer/id #uuid "056c1313-4dba-5537-a415-25f647daba6b"] ["answer-056c1313-4dba-5537-a415-25f647daba6b" :answer/type :answer.type/math] ["answer-056c1313-4dba-5537-a415-25f647daba6b" :answer/value "\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}"] ["answer-f025807f-1fdc-5d45-89ab-f5216051c571" :answer/id #uuid "f025807f-1fdc-5d45-89ab-f5216051c571"] ["answer-f025807f-1fdc-5d45-89ab-f5216051c571" :answer/type :answer.type/math] ["answer-f025807f-1fdc-5d45-89ab-f5216051c571" :answer/value "\\frac{8(-1)^{n}}{\\pi {n}^{2}}"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/key "field-1"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/type :answer-field.type/select] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/correct "answer-056c1313-4dba-5537-a415-25f647daba6b"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/choices "answer-58ac06ce-36f1-5449-b206-87a2a6fdd1bf"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/choices "answer-0eff6f24-e788-53dc-aa43-0b1981e833d5"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/choices "answer-056c1313-4dba-5537-a415-25f647daba6b"] ["answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4" :answer-field/choices "answer-f025807f-1fdc-5d45-89ab-f5216051c571"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/id #uuid "901c601c-f36e-56ff-8079-21f7d8654a35"] ["answer-eae7207f-15cc-547a-b08d-546f2343cef6" :answer/id #uuid "eae7207f-15cc-547a-b08d-546f2343cef6"] ["answer-eae7207f-15cc-547a-b08d-546f2343cef6" :answer/type :answer.type/math] ["answer-eae7207f-15cc-547a-b08d-546f2343cef6" :answer/value "\\operatorname{cos}⁡(\\pi x)"] ["answer-29b55494-ac2b-59d3-bb0c-453e8c568926" :answer/id #uuid "29b55494-ac2b-59d3-bb0c-453e8c568926"] ["answer-29b55494-ac2b-59d3-bb0c-453e8c568926" :answer/type :answer.type/math] ["answer-29b55494-ac2b-59d3-bb0c-453e8c568926" :answer/value "\\operatorname{cos}⁡(nx)"] ["answer-5cd2ef81-c957-504d-a56d-8a2440f1685a" :answer/id #uuid "5cd2ef81-c957-504d-a56d-8a2440f1685a"] ["answer-5cd2ef81-c957-504d-a56d-8a2440f1685a" :answer/type :answer.type/math] ["answer-5cd2ef81-c957-504d-a56d-8a2440f1685a" :answer/value "\\operatorname{sin}⁡(\\pi x)"] ["answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4" :answer/id #uuid "ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4"] ["answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4" :answer/type :answer.type/math] ["answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4" :answer/value "\\operatorname{sin}⁡(nx)"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/key "field-2"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/type :answer-field.type/select] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/correct "answer-29b55494-ac2b-59d3-bb0c-453e8c568926"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/choices "answer-eae7207f-15cc-547a-b08d-546f2343cef6"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/choices "answer-29b55494-ac2b-59d3-bb0c-453e8c568926"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/choices "answer-5cd2ef81-c957-504d-a56d-8a2440f1685a"] ["answer-field-901c601c-f36e-56ff-8079-21f7d8654a35" :answer-field/choices "answer-ad4fbc5f-b76c-5ff7-bf3b-9523ba3c19b4"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/answer-fields "answer-field-98620a41-f0fa-569b-a3ec-5642c8206fa4"] ["question-55d2ffed-9ece-55ed-baea-5ef5a75af131" :question/answer-fields "answer-field-901c601c-f36e-56ff-8079-21f7d8654a35"] [17592186166959 :knowledge-point/questions "question-55d2ffed-9ece-55ed-baea-5ef5a75af131"] [17592186372771 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-8x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$"] [17592186168044 :tutorial/content "In the earlier topics, we saw that *symmetry* can force many Fourier coefficients to be zero automatically.\nIn particular, if a $2\\pi$-periodic function is *even*, then its Fourier series has *cosine terms only*.\n\nA **Fourier cosine series** uses this idea when a function is initially given only on the half-interval $[0,\\pi),$ but we want a full Fourier series on $[-\\pi,\\pi)$ (and then a $2\\pi$-periodic extension to all real $x$).\n\nTo do this, we start with a function $F(x)$ on $[0,\\pi)$ and define its **even extension** $f(x)$ to $(-\\pi,\\pi)$ by\n![](images/e2/e2e07048ac4750968947e45443f59096f395b159d4f7a846410a711194b11a14.svg)\n\nFor example, a function $F(x),$ defined on $x \\in [0,1),$ and its even extension $f(x)$ to $x \\in (-1,1)$ are shown below.\n\n![](images/33/33d92f280a5672c8d9d94553ccc1ada2a9c5ea1ff12344ca8c9aeca9f44c40c6.png)\n\nBy construction, $f$ is an *even* function, meaning $f(-x)=f(x)$. Because $f$ is even, its Fourier series on $[-\\pi,\\pi)$ has *cosine terms only*:\n\n$$\nf(x)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty} a_n\\cos(nx)\n$$\n\nSince $f(x)$ is even and $\\cos(nx)$ is even for any $n\\ge 1,$ the product $f(x)\\cos(nx)$ is even too. Therefore, the cosine coefficients can be computed using the *half-range formulas*:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x,\\end{aligned}\n$$\n\nand for $n\\ge 1,$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\\end{aligned}\n$$\n\nSo in practice, the workflow is the following:\n\n1\\. Start with $F$ on $[0,\\pi)$ and form the even extension $f$ on $(-\\pi,\\pi).$\n\n2\\. Compute $a_0$ and $a_n$ from the half-range integrals on $[0,\\pi).$\n\n3\\. Write the Fourier cosine series of $f.$\n\nLet's see some concrete examples."]] "retractions" [[17592186315070 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$"] [17592186314028 :answer-field/correct 17592186313126] [17592186314316 :answer-field/correct 17592186312153] [17592186372764 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-4x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$"] [17592186372771 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-8x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$"] [17592186168044 :tutorial/content "In the earlier topics, we saw that *symmetry* can force many Fourier coefficients to be zero automatically.\nIn particular, if a $2\\pi$-periodic function is *even*, then its Fourier series has *cosine terms only*.\n\nA **Fourier cosine series** uses this idea when a function is initially given only on the half-interval $[0,\\pi),$ but we want a full Fourier series on $[-\\pi,\\pi)$ (and then a $2\\pi$-periodic extension to all real $x$).\n\nTo do this, we start with a function $F(x)$ on $[0,\\pi)$ and define its **even extension** $f(x)$ to $(-\\pi,\\pi)$ by\n![](images/e2/e2e07048ac4750968947e45443f59096f395b159d4f7a846410a711194b11a14.svg)\n\nFor example, a function $F(x),$ defined on $x \\in [0,1),$ and its even extension $f(x)$ to $x \\in (-1,1)$ are shown below.\n\n![](images/33/33d92f280a5672c8d9d94553ccc1ada2a9c5ea1ff12344ca8c9aeca9f44c40c6.png)\n\nBy construction, $f$ is an *even* function, meaning $f(-x)=f(x)$. Because $f$ is even, its Fourier series on $[-\\pi,\\pi)$ has *cosine terms only*:\n\n$$\nf(x)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty} a_n\\cos(nx)\n$$\n\nSince $f(x)$ is even and $\\cos(nx)$ is even for any $n\\ge 1,$ the product $f(x)\\cos(nx)$ is even too. Therefore, the cosine coefficients can be computed using the *half-range formulas*:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x,\\end{aligned}\n$$\n\nand for $n\\ge 1,$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot 2{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\\end{aligned}\n$$\n\nSo in practice, the workflow is the following:\n\n- Start with $F$ on $[0,\\pi)$ and form the even extension $f$ on $(-\\pi,\\pi).$\n\n- Compute $a_0$ and $a_n$ from the half-range integrals on $[0,\\pi).$\n\n- Write the Fourier cosine series of $f.$\n\nLet's see some concrete examples."]]}]