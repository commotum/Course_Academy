1aaa94" #edb/ref 17592186045417] [17592186549923 #edb/ref 1075 #edb/ref 17592186549535 #edb/ref 17592186045417] [17592186549923 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186549923 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186549923 #edb/ref 1078 #edb/ref 17592186549535 #edb/ref 17592186045417] [17592186549923 #edb/ref 1079 #uuid "fdceacd7-e832-59cd-b2a8-3585e4638dba" #edb/ref 17592186045417] [17592186549957 #edb/ref 1068 #edb/ref 17592186549905 #edb/ref 17592186045417] [17592186549957 #edb/ref 1068 #edb/ref 17592186549909 #edb/ref 17592186045417] [17592186549957 #edb/ref 1069 "q-341272" #edb/ref 17592186045417] [17592186549957 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186549957 #edb/ref 1071 "Let $F(x)=7x-4$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" #edb/ref 17592186045417] [17592186549957 #edb/ref 1072 #uuid "3fb491ae-d461-5efd-a743-cfec479bf958" #edb/ref 17592186045417] [17592186549957 #edb/ref 1074 "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=7x-4$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(7x-4)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=7x-4\\, & ⇒\\,{u}^{′}=7 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(7x-4)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{7}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((7\\pi -4)\\operatorname{sin}⁡(n\\pi )+4\\operatorname{sin}⁡(0))+\\frac{7}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{7}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{14(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-4+\\frac{7\\pi }{2})+{\\sum }_{n=1}^{\\infty }\\frac{14((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" #edb/ref 17592186045417] [17592186549962 #edb/ref 1068 #edb/ref 17592186549867 #edb/ref 17592186045417] [17592186549962 #edb/ref 1068 #edb/ref 17592186549874 #edb/ref 17592186045417] [17592186549962 #edb/ref 1069 "q-341270" #edb/ref 17592186045417] [17592186549962 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186549962 #edb/ref 1071 "Let $F(x)=4x-1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" #edb/ref 17592186045417] [17592186549962 #edb/ref 1072 #uuid "55d2ffed-9ece-55ed-baea-5ef5a75af131" #edb/ref 17592186045417] [17592186549962 #edb/ref 1074 "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=4x-1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(4x-1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=4x-1\\, & ⇒\\,{u}^{′}=4 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(4x-1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{4}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((4\\pi -1)\\operatorname{sin}⁡(n\\pi )+\\operatorname{sin}⁡(0))+\\frac{4}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{4}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(-1+2\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{8((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" #edb/ref 17592186045417] [17592186549968 #edb/ref 1068 #edb/ref 17592186549923 #edb/ref 17592186045417] [17592186549968 #edb/ref 1069 "q-341274" #edb/ref 17592186045417] [17592186549968 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186549968 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=5{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" #edb/ref 17592186045417] [17592186549968 #edb/ref 1072 #uuid "6c123c90-9e3c-534f-a040-61cb255aa0e6" #edb/ref 17592186045417] [17592186549968 #edb/ref 1074 "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{5{x}^{3}}{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{5{\\pi }^{3}}{3}+\\pi )-0 \\\\  & =2(\\frac{5{\\pi }^{2}}{3}+1).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186549969 #edb/ref 1068 #edb/ref 17592186549875 #edb/ref 17592186045417] [17592186549969 #edb/ref 1069 "q-341277" #edb/ref 17592186045417] [17592186549969 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186549969 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=6{x}^{2}+1$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" #edb/ref 17592186045417] [17592186549969 #edb/ref 1072 #uuid "6da2a50a-0f62-59bb-a9db-a784f084c0f1" #edb/ref 17592186045417] [17592186549969 #edb/ref 1074 "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=6{x}^{2}+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(6{x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[2{x}^{3}+x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(2{\\pi }^{3}+\\pi )-0 \\\\  & =2(2{\\pi }^{2}+1).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186549996 #edb/ref 1068 #edb/ref 17592186549809 #edb/ref 17592186045417] [17592186549996 #edb/ref 1069 "q-341248" #edb/ref 17592186045417] [17592186549996 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186549996 #edb/ref 1071 "Let $F(x)=3{e}^{x}+x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" #edb/ref 17592186045417] [17592186549996 #edb/ref 1072 #uuid "c67b1cfd-40e2-5a99-9d17-b7d5268f4dcf" #edb/ref 17592186045417] [17592186549996 #edb/ref 1074 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =3{e}^{(-x)}+(-x) \\\\  & =3{e}^{-x}-x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186550008 #edb/ref 1068 #edb/ref 17592186549824 #edb/ref 17592186045417] [17592186550008 #edb/ref 1069 "q-341253" #edb/ref 17592186045417] [17592186550008 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186550008 #edb/ref 1071 "Let $F(x)=x{e}^{x}$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is the value of $f(-2)?$\n\n$f(-2)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186550008 #edb/ref 1072 #uuid "e7016461-6868-574f-be42-632e56b55fe8" #edb/ref 17592186045417] [17592186550008 #edb/ref 1074 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x){e}^{-x} \\\\  & =-x{e}^{-x}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-2) & =-(-2){e}^{-(-2)}=2{e}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
