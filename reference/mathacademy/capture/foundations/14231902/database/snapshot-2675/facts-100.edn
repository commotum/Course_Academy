 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186553263 #edb/ref 1083 #uuid "c691a6d3-d876-51c8-b913-9e1a8fbf2d8a" #edb/ref 17592186045417] [17592186553285 #edb/ref 1080 "\\{\\begin{aligned}{u}^{′}(t)=2{u}^{2}(t)+v(t) \\\\ {v}^{′}(t)=-u(t)-{v}^{2}(t)\\end{aligned}" #edb/ref 17592186045417] [17592186553285 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186553285 #edb/ref 1083 #uuid "d0155f97-773b-5d90-9876-d81f9a834c19" #edb/ref 17592186045417] [17592186553319 #edb/ref 1080 "{u}^{′}=[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]u+[\\begin{aligned}1 \\\\ 1\\end{aligned}]" #edb/ref 17592186045417] [17592186553319 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186553319 #edb/ref 1083 #uuid "e2d4bacd-b2da-531e-8234-b3604fea9dc3" #edb/ref 17592186045417] [17592186553336 #edb/ref 1080 "{u}^{′}=[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]u" #edb/ref 17592186045417] [17592186553336 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186553336 #edb/ref 1083 #uuid "eb6f2836-2dba-56ff-9d23-d8bc722d1e8b" #edb/ref 17592186045417] [17592186553346 #edb/ref 1080 "The shifted system still has exactly three equilibrium points." #edb/ref 17592186045417] [17592186553346 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186553346 #edb/ref 1083 #uuid "f395de86-b03b-5a4b-97b8-39a4f1f73ad4" #edb/ref 17592186045417] [17592186553366 #edb/ref 1080 "{u}^{′}=[\\begin{aligned}0 & 1 \\\\ -2 & 0\\end{aligned}]u" #edb/ref 17592186045417] [17592186553366 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186553366 #edb/ref 1083 #uuid "fae32f0d-4f34-5b6e-8153-95de23dd818e" #edb/ref 17592186045417] [17592186553445 #edb/ref 1075 #edb/ref 17592186552950 #edb/ref 17592186045417] [17592186553445 #edb/ref 1075 #edb/ref 17592186553113 #edb/ref 17592186045417] [17592186553445 #edb/ref 1075 #edb/ref 17592186553130 #edb/ref 17592186045417] [17592186553445 #edb/ref 1075 #edb/ref 17592186553336 #edb/ref 17592186045417] [17592186553445 #edb/ref 1075 #edb/ref 17592186553366 #edb/ref 17592186045417] [17592186553445 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186553445 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186553445 #edb/ref 1078 #edb/ref 17592186553336 #edb/ref 17592186045417] [17592186553445 #edb/ref 1079 #uuid "9249f96b-64b8-59e4-9bf4-1d116673b015" #edb/ref 17592186045417] [17592186553477 #edb/ref 1075 #edb/ref 17592186553049 #edb/ref 17592186045417] [17592186553477 #edb/ref 1075 #edb/ref 17592186553061 #edb/ref 17592186045417] [17592186553477 #edb/ref 1075 #edb/ref 17592186553206 #edb/ref 17592186045417] [17592186553477 #edb/ref 1075 #edb/ref 17592186553258 #edb/ref 17592186045417] [17592186553477 #edb/ref 1075 #edb/ref 17592186553319 #edb/ref 17592186045417] [17592186553477 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186553477 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186553477 #edb/ref 1078 #edb/ref 17592186553049 #edb/ref 17592186045417] [17592186553477 #edb/ref 1079 #uuid "dfd3e00c-418a-520a-80fa-a7b949ac974e" #edb/ref 17592186045417] [17592186553479 #edb/ref 1075 #edb/ref 17592186552903 #edb/ref 17592186045417] [17592186553479 #edb/ref 1075 #edb/ref 17592186553016 #edb/ref 17592186045417] [17592186553479 #edb/ref 1075 #edb/ref 17592186553205 #edb/ref 17592186045417] [17592186553479 #edb/ref 1075 #edb/ref 17592186553246 #edb/ref 17592186045417] [17592186553479 #edb/ref 1075 #edb/ref 17592186553346 #edb/ref 17592186045417] [17592186553479 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186553479 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186553479 #edb/ref 1078 #edb/ref 17592186553346 #edb/ref 17592186045417] [17592186553479 #edb/ref 1079 #uuid "ebef8073-cadc-5d1c-afa4-6048d68ae08d" #edb/ref 17592186045417] [17592186553536 #edb/ref 1068 #edb/ref 17592186553479 #edb/ref 17592186045417] [17592186553536 #edb/ref 1069 "q-335520" #edb/ref 17592186045417] [17592186553536 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553536 #edb/ref 1071 "A nonlinear system of ODEs has exactly three equilibrium points.  The system is then shifted using the transformation $u=x-{x}^{∗},$ where ${x}^{∗}$ is one of the equilibria. Which of the following statements about the number of equilibria in the shifted system is guaranteed to be true?" #edb/ref 17592186045417] [17592186553536 #edb/ref 1072 #uuid "76bd165c-3511-57a4-8be2-2180b605d203" #edb/ref 17592186045417] [17592186553536 #edb/ref 1074 "A shift of coordinates is a translation of the phase space and does not alter the structure of the system’s equilibrium set. Each equilibrium point of the original system is translated to a corresponding equilibrium in the shifted coordinates.\n\nThus, although one of the equilibria is moved to the origin, the total number of equilibrium points remains the same.\n\nTherefore, the correct answer is \"The shifted system still has exactly three equilibrium points.\"" #edb/ref 17592186045417] [17592186553539 #edb/ref 1068 #edb/ref 17592186553477 #edb/ref 17592186045417] [17592186553539 #edb/ref 1069 "q-335078" #edb/ref 17592186045417] [17592186553539 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553539 #edb/ref 1071 "$$\n{x}^{′}=[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]x+[\\begin{aligned}-1 \\\\ -3\\end{aligned}]\n$$\n\nConsider the system of ODEs above. The equilibrium point of the system is $[1,\\,1]^{T}.$ Which of the following is the system obtained by shifting the equilibrium to the origin?" #edb/ref 17592186045417] [17592186553539 #edb/ref 1072 #uuid "7a810631-1bae-5445-bc88-4aea289acecc" #edb/ref 17592186045417] [17592186553539 #edb/ref 1074 "To shift the system's equilibrium from ${x}^{∗}$ to the origin, we define the deviation vector\n\n$$\nu=x-{x}^{∗}.\n$$\n\nIn our case, we have\n\n$$\nu=x-[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,⇒\\,x=u+[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,\\text{and}\\,{x}^{′}={u}^{′}.\n$$\n\nSubstituting $x$ and ${x}^{′}$ into the given system, we obtain\n\n$$\n\\begin{aligned}{x}^{′} & =[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]x+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\ {u}^{′} & =[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}](u+[\\begin{aligned}1 \\\\ 1\\end{aligned}])+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]u+[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]u+[\\begin{aligned}1 \\\\ 3\\end{aligned}]+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]u.\\end{aligned}\n$$\n\nTherefore, the shifted system is\n\n$$\n{u}^{′}=[\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}]u.\n$$" #edb/ref 17592186045417] [17592186553563 #edb/ref 1068 #edb/ref 17592186553445 #edb/ref 17592186045417] [17592186553563 #edb/ref 1069 "q-335195" #edb/ref 17592186045417] [17592186553563 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186553563 #edb/ref 1071 "$$\n{x}^{′}=[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]x+[\\begin{aligned}-5 \\\\ -2\\end{aligned}]\n$$\n\nConsider the system of ODEs above. The equilibrium point of the system is $[1,\\,2]^{T}.$ Which of the following is the system obtained by shifting the equilibrium to the origin?" #edb/ref 17592186045417] [17592186553563 #edb/ref 1072 #uuid "b02e6de2-bb8c-5f1a-89b9-7e259d335937" #edb/ref 17592186045417] [17592186553563 #edb/ref 1074 "To shift the system's equilibrium from ${x}^{∗}$ to the origin, we define the deviation vector\n\n$$\nu=x-{x}^{∗}.\n$$\n\nIn our case, we have\n\n$$\nu=x-[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\,⇒\\,x=u+[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\,\\text{and}\\,{x}^{′}={u}^{′}.\n$$\n\nSubstituting $x$ and ${x}^{′}$ into the given system, we obtain\n\n$$\n\\begin{aligned}{x}^{′} & =[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]x+[\\begin{aligned}-5 \\\\ -2\\end{aligned}] \\\\ {u}^{′} & =[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}](u+[\\begin{aligned}1 \\\\ 2\\end{aligned}])+[\\begin{aligned}-5 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]u+[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]+[\\begin{aligned}-5 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]u+[\\begin{aligned}5 \\\\ 2\\end{aligned}]+[\\begin{aligned}-5 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]u.\\end{aligned}\n$$\n\nTherefore, the shifted system is\n\n$$\n{u}^{′}=[\\begin{aligned}3 & 1 \\\\ -2 & 2\\end{aligned}]u.\n$$" #edb/ref 17592186045417]}
