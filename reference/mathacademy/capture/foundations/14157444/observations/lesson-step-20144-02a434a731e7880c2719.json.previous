"4.261ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 1834.7 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">[\\mathbf{T}]_{\\color{red}\\mathcal{C}}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAIN-5B\" d=\"M118 -250V750H255V710H158V-210H255V-250H118Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAINB-54\" d=\"M41 425Q41 426 51 545T62 669V675H737V669Q738 665 748 546T758 425V419H696V425Q687 517 669 555T595 607Q578 612 522 613H478V62H631V0H615Q585 3 399 3Q214 3 184 0H168V62H321V613H277H263Q164 613 134 561Q113 527 103 425V419H41V425Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-5D\" d=\"M22 710V750H159V-250H22V-210H119V710H22Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJCAL-43\" d=\"M201 -25Q167 -25 136 -14T75 23T29 94T12 202Q12 290 50 394T161 574Q227 642 303 673T433 704Q435 705 457 705Q533 701 533 640Q533 606 507 548T464 474Q431 444 396 444Q381 444 381 453Q381 459 388 473T407 513T428 563Q433 580 433 594Q433 636 381 636Q314 636 260 594T175 489T128 363T112 247Q112 157 153 101T273 44Q347 44 398 121Q413 144 437 157T481 171Q496 171 496 160Q496 150 476 123Q426 56 350 16T201 -25Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMAIN-5B\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAINB-54\" x=\"278\" y=\"0\"></use>\n<g transform=\"translate(1079,0)\">\n <use xlink:href=\"#E2-MJMAIN-5D\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(278,-155)\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJCAL-43\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span> of a linear transformation <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"10.985ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 4729.6 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\\mathbf{T} : V \\to V</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAINB-54\" d=\"M41 425Q41 426 51 545T62 669V675H737V669Q738 665 748 546T758 425V419H696V425Q687 517 669 555T595 607Q578 612 522 613H478V62H631V0H615Q585 3 399 3Q214 3 184 0H168V62H321V613H277H263Q164 613 134 561Q113 527 103 425V419H41V425Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-3A\" d=\"M78 370Q78 394 95 412T138 430Q162 430 180 414T199 371Q199 346 182 328T139 310T96 327T78 370ZM78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMATHI-56\" d=\"M52 648Q52 670 65 683H76Q118 680 181 680Q299 680 320 683H330Q336 677 336 674T334 656Q329 641 325 637H304Q282 635 274 635Q245 630 242 620Q242 618 271 369T301 118L374 235Q447 352 520 471T595 594Q599 601 599 609Q599 633 555 637Q537 637 537 648Q537 649 539 661Q542 675 545 679T558 683Q560 683 570 683T604 682T668 681Q737 681 755 683H762Q769 676 769 672Q769 655 760 640Q757 637 743 637Q730 636 719 635T698 630T682 623T670 615T660 608T652 599T645 592L452 282Q272 -9 266 -16Q263 -18 259 -21L241 -22H234Q216 -22 216 -15Q213 -9 177 305Q139 623 138 626Q133 637 76 637H59Q52 642 52 648Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E3-MJMAINB-54\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-3A\" x=\"1078\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-56\" x=\"1634\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2192\" x=\"2681\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-56\" x=\"3960\" y=\"0\"></use>\n</g>\n</svg></span> relative to two bases <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.543ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 664.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">\\color{blue}\\mathcal{B}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJCAL-42\" d=\"M304 342Q292 342 292 353Q292 372 323 391Q331 396 417 428T533 487Q563 512 563 555V562Q563 575 557 589T530 618T475 636Q429 636 396 613T330 539Q263 446 210 238Q196 183 173 120Q135 31 121 16Q108 1 85 -10T47 -22T32 -10Q32 -5 44 18T77 93T112 206Q135 296 154 395T182 550T191 615Q191 616 190 616Q188 616 179 611T157 601T131 594Q113 594 113 605Q113 623 144 644Q154 650 205 676T267 703Q277 705 279 705Q295 705 295 693Q295 686 288 635T278 575Q278 572 287 582Q336 635 402 669T540 704Q603 704 633 673T664 599Q664 559 638 523T580 462Q553 440 504 413L491 407L504 402Q566 381 596 338T627 244Q627 172 575 110T444 13T284 -22Q208 -22 158 28Q144 42 146 50Q150 67 178 85T230 103Q236 103 246 95T267 75T302 56T357 47Q436 47 486 93Q526 136 526 198V210Q526 228 518 249T491 292T436 330T350 345Q335 345 321 344T304 342Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E4-MJCAL-42\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span> and <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.239ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 533.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">\\color{red}\\mathcal{C}</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJCAL-43\" d=\"M201 -25Q167 -25 136 -14T75 23T29 94T12 202Q12 290 50 394T161 574Q227 642 303 673T433 704Q435 705 457 705Q533 701 533 640Q533 606 507 548T464 474Q431 444 396 444Q381 444 381 453Q381 459 388 473T407 513T428 563Q433 580 433 594Q433 636 381 636Q314 636 260 594T175 489T128 363T112 247Q112 157 153 101T273 44Q347 44 398 121Q413 144 437 157T481 171Q496 171 496 160Q496 150 476 123Q426 56 350 16T201 -25Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n<g fill=\"red\" stroke=\"red\">\n <use xlink:href=\"#E5-MJCAL-43\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span> of a vector space <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.787ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 769.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-6-Title\">\n<title id=\"MathJax-SVG-6-Title\">V</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E6-MJMATHI-56\" d=\"M52 648Q52 670 65 683H76Q118 680 181 680Q299 680 320 683H330Q336 677 336 674T334 656Q329 641 325 637H304Q282 635 274 635Q245 630 242 620Q242 618 271 369T301 118L374 235Q447 352 520 471T595 594Q599 601 599 609Q599 633 555 637Q537 637 537 648Q537 649 539 661Q542 675 545 679T558 683Q560 683 570 683T604 682T668 681Q737 681 755 683H762Q769 676 769 672Q769 655 760 640Q757 637 743 637Q730 636 719 635T698 630T682 623T670 615T660 608T652 599T645 592L452 282Q272 -9 266 -16Q263 -18 259 -21L241 -22H234Q216 -22 216 -15Q213 -9 177 305Q139 623 138 626Q133 637 76 637H59Q52 642 52 648Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E6-MJMATHI-56\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> are different.</p>\n<p>If we are given the matrix <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"5.123ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 2205.9 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-7-Title\">\n<title id=\"MathJax-SVG-7-Title\">[\\mathbf{T}]_{\\color{blue}\\mathcal{B}},</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E7-MJMAIN-5B\" d=\"M118 -250V750H255V710H158V-210H255V-250H118Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMAINB-54\" d=\"M41 425Q41 426 51 545T62 669V675H737V669Q738 665 748 546T758 425V419H696V425Q687 517 669 555T595 607Q578 612 522 613H478V62H631V0H615Q585 3 399 3Q214 3 184 0H168V62H321V613H277H263Q164 613 134 561Q113 527 103 425V419H41V425Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMAIN-5D\" d=\"M22 710V750H159V-250H22V-210H119V710H22Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJCAL-42\" d=\"M304 342Q292 342 292 353Q292 372 323 391Q331 396 417 428T533 487Q563 512 563 555V562Q563 575 557 589T530 618T475 636Q429 636 396 613T330 539Q263 446 210 238Q196 183 173 120Q135 31 121 16Q108 1 85 -10T47 -22T32 -10Q32 -5 44 18T77 93T112 206Q135 296 154 395T182 550T191 615Q191 616 190 616Q188 616 179 611T157 601T131 594Q113 594 113 605Q113 623 144 644Q154 650 205 676T267 703Q277 705 279 705Q295 705 295 693Q295 686 288 635T278 575Q278 572 287 582Q336 635 402 669T540 704Q603 704 633 673T664 599Q664 559 638 523T580 462Q553 440 504 413L491 407L504 402Q566 381 596 338T627 244Q627 172 575 110T444 13T284 -22Q208 -22 158 28Q144 42 146 50Q150 67 178 85T230 103Q236 103 246 95T267 75T302 56T357 47Q436 47 486 93Q526 136 526 198V210Q526 228 518 249T491 292T436 330T350 345Q335 345 321 344T304 342Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E7-MJMAIN-5B\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E7-MJMAINB-54\" x=\"278\" y=\"0\"></use>\n<g transform=\"translate(1079,0)\">\n <use xlink:href=\"#E7-MJMAIN-5D\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(278,-155)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E7-MJCAL-42\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E7-MJMAIN-2C\" x=\"1927\" y=\"0\"></use>\n</g>\n</svg></span> how do we find the matrix <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"5.359ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 2307.2 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-8-Title\">\n<title id=\"MathJax-SVG-8-Title\">[\\mathbf{T}]_{\\color{red}\\mathcal{C}}?</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E8-MJMAIN-5B\" d=\"M118 -250V750H255V710H158V-210H255V-250H118Z\"></path>\n<path stroke-width=\"1\" id=\"E8-MJMAINB-54\" d=\"M41 425Q41 426 51 545T62 669V675H737V66