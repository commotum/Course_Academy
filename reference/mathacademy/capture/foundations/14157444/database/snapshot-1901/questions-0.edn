 & 3\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}3 & -2 \\\\ -4 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -4 \\\\ -8 & -5\\end{aligned}][\\begin{aligned}3 & -2 \\\\ -4 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480673 :knowledge-point/_questions [{:db/id #edb/ref 17592186129131 :knowledge-point/id #uuid "969220db-a686-511b-b33a-0b4f6ab66b1a" :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to the Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d0c1b4-61e7-5e25-9833-9ff8521f8e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -11 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186480171} {:answer/id #uuid "a84373ce-6910-52c1-988d-e8fbee200996" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 8 & 7\\end{aligned}]" :db/id #edb/ref 17592186480395} {:answer/id #uuid "b1a541f3-2fce-5116-8f9a-bbdea23325fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 15 \\\\ 3 & -8\\end{aligned}]" :db/id #edb/ref 17592186480409} {:answer/id #uuid "c5c07fb2-8a16-5c6a-8258-d32151d0964c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 4 \\\\ 5 & 12\\end{aligned}]" :db/id #edb/ref 17592186480440} {:answer/id #uuid "f7563451-68a5-5c50-b602-20f48ffbfffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 3 \\\\ -3 & -3\\end{aligned}]" :db/id #edb/ref 17592186480519}] :answer-field/correct {:answer/id #uuid "25d0c1b4-61e7-5e25-9833-9ff8521f8e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -11 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186480171} :answer-field/id #uuid "86fb28cc-fb24-5ba3-a4c6-598034db31b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480578}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79dda897-ef6c-5dc8-918f-90eef254a83f" :question/math-academy-id "q-97132" :question/problem "$$\nB=\\{[\\begin{aligned}3 \\\\ 1\\end{aligned}],[\\begin{aligned}7 \\\\ 2\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}3 & 2 \\\\ 1 & 5\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](images/db/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}3 & 7 \\\\ 1 & 2\\end{aligned}].\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={[\\begin{aligned}3 & 7 \\\\ 1 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot 3-1\\cdot 7}[\\begin{aligned}2 & -7 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 7 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =[\\begin{aligned}3 & 7 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 1 & 5\\end{aligned}][\\begin{aligned}-2 & 7 \\\\ 1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}16 & 41 \\\\ 5 & 12\\end{aligned}][\\begin{aligned}-2 & 7 \\\\ 1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}9 & -11 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360776 :knowledge-point/_questions [{:db/id #edb/ref 17592186129155 :knowledge-point/id #uuid "86028fae-a119-5194-975d-a6d9fad6faf5" :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acbfcf4-eef4-5e10-9293-955304ed4643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & -6 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186357982} {:answer/id #uuid "2518ebb0-c04b-5a83-9b14-2a22b6592f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -12 \\\\ -10 & 18\\end{aligned}]" :db/id #edb/ref 17592186358083} {:answer/id #uuid "2a9c0121-9fc8-5689-9ab5-b5f35ce55187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 3 \\\\ 5 & 3\\end{aligned}]" :db/id #edb/ref 17592186358138} {:answer/id #uuid "3288b5fc-9467-576f-90f6-b17447b3185d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ -3 & 5\\end{aligned}]" :db/id #edb/ref 17592186358202} {:answer/id #uuid "eac08a40-1ec6-5f86-8789-bd6a699a855d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 \\\\ 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186359843}] :answer-field/correct {:answer/id #uuid "1acbfcf4-eef4-5e10-9293-955304ed4643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & -6 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186357982} :answer-field/id #uuid "b6b18c30-7bb0-5953-baef-6b75d504f744" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360315}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9c1ef303-e889-5fc1-8e48-5dba05ad5f94" :question/math-academy-id "q-97278" :question/problem "$$\nB=\\{[\\begin{aligned}-1 \\\\ 4\\end{aligned}],[\\begin{aligned}-1 \\\\ 3\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ -1\\end{aligned}],[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}-1 & -3 \\\\ 4 & 6\\end{aligned}]\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & -1 & -1 \\\\ -1 & 3 & 4 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 & -1 \\\\ 0 & 1 & 3 & 2\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 5 & 3 \\\\ 0 & 1 & 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}5 & 3 \\\\ 3 & 2\\end{aligned}].\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}5 & 3 \\\\ 3 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot 5-3\\cdot 3}[\\begin{aligned}2 & -3 \\\\ -3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ -3 & 5\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}5 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}-1 & -3 \\\\ 4 & 6\\end{aligned}][\\begin{aligned}2 & -3 \\\\ -3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 3 \\\\ 5 & 3\\end{aligned}][\\begin{aligned}2 & -3 \\\\ -3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -6 \\\\ 1 & 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419685 :knowledge-point/_questions [{:db/id #edb/ref 17592186129155 :knowledge-point/id #uuid "86028fae-a119-5194-975d-a6d9fad6faf5" :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094350f2-e017-53e0-b0e9-5075268dbe4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186419659} {:answer/id #uuid "248c47da-3dc5-5333-809d-acf62be00f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -12 \\\\ 7 & 14\\end{aligned}]" :db/id #edb/ref 17592186419663} {:answer/id #uuid "7d527527-44f7-5758-b7fd-4c2cd30a0912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 9 \\\\ 0 & -7\\end{aligned}]" :db/id #edb/ref 17592186419670} {:answer/id #uuid "c7cdd80b-8123-585f-9ada-143e7f38d137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 6 \\\\ 1 & -4\\end{aligned}]" :db/id #edb/ref 17592186419674} {:answer/id #uuid "cd75b99f-ca84-5149-9b32-732c0d712c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-11 & -18 \\\\ -9 & -16\\end{aligned}]" :db/id #edb/ref 17592186419675}] :answer-field/correct {:answer/id #uuid "248c47da-3dc5-5333-809d-acf62be00f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -12 \\\\ 7 & 14\\end{aligned}]" :db/id #edb/ref 17592186419663} :answer-field/id #uuid "2c3a3177-a079-5cdb-a624-7225c5f182a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419680}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7afd5a54-c223-5e70-9582-9406545b2d06" :question/math-academy-id "q-97279" :question/problem "$$\nB=\\{[\\begin{aligned}0 \\\\ 3\\end{aligned}],[\\begin{aligned}-1 \\\\ -4\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ -1\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}4 & 3 \\\\ 2 & 5\\end{aligned}]\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 0 & -1 \\\\ -2 & -1 & 3 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & -1 \\\\ 0 & 3 & 3 & -6\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & -1 \\\\ 0 & 1 & 1 & -2\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 3 \\\\ 0 & 1 & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 3 \\\\ 1 & -2\\end{aligned}].\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}-2 & 3 \\\\ 1 & -2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-2)-1\\cdot 3}[\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}-2 & 3 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}4 & 3 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 9 \\\\ 0 & -7\\end{aligned}][\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -12 \\\\ 7 & 14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360777 :knowledge-point/_questions [{:db/id #edb/ref 17592186129155 :knowledge-point/id #uuid "86028fae-a119-5194-975d-a6d9fad6faf5" :knowledge-point/title "Finding the Matrix of a Linear Transformation Relative to a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0250b576-7f5a-5cdb-8d5f-4ac4eb5eea0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & 9 \\\\ 8 & 11\\end{aligned}]" :db/id #edb/ref 17592186357778} {:answer/id #uuid "5d643694-922c-500b-9562-ceda51bb281d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -7 \\\\ 8 & -7\\end{aligned}]" :db/id #edb/ref 17592186358565} {:answer/id #uuid "bcab7151-1545-5adb-9acc-5a85e3563222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 2 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186359394} {:answer/id #uuid "cf01b12a-1505-5270-a98f-d1009d985cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 3 \\\\ 6 & -4\\end{aligned}]" :db/id #edb/ref 17592186359571} {:answer/id #uuid "e9c09573-bff3-5408-8c4e-15427f964077" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 6 \\\\ 7 & 8\\end{aligned}]" :db/id #edb/ref 17592186359829}] :answer-field/correct {:answer/id #uuid "bcab7151-1545-5adb-9acc-5a85e3563222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 2 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186359394} :answer-field/id #uuid "4184f1b0-a361-5e25-b40e-1d65214674e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360088}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af8cde90-b41c-51e7-9e5a-28cfa06594f7" :question/math-academy-id "q-97282" :question/problem "$$\nB=\\{[\\begin{aligned}8 \\\\ -7\\end{aligned}],[\\begin{aligned}-5 \\\\ 4\\end{aligned}]\\},\\,C=\\{[\\begin{aligned}1 \\\\ -2\\end{aligned}],[\\begin{aligned}3 \\\\ -3\\end{aligned}]\\},\\,[T]_{B}=[\\begin{aligned}4 & 2 \\\\ 3 & 5\\end{aligned}]\n$$\n\nConsider the bases $B$ and $C$ of ${R}^{2},$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to the basis $B$, shown above. Find the matrix of $T$ relative to the basis $C.$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nFirst, let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of vectors from $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ To do this, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce $M$ using Gaussian elimination until we get the identity matrix on the left. By doing this, we obtain the required change-of-coordinates matrix on the right.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 8 & -5 \\\\ -2 & -3 & -7 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -5 \\\\ 0 & 3 & 9 & -6\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -5 \\\\ 0 & 1 & 3 & -2\\end{aligned}] & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 1 \\\\ 0 & 1 & 3 & -2\\end{aligned}]\\end{aligned}\n$$\n\nHence,\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-1 & 1 \\\\ 3 & -2\\end{aligned}].\n$$\n\nNow, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{B\\to C}^{-1} & ={[\\begin{aligned}-1 & 1 \\\\ 3 & -2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-1)-3\\cdot 1}[\\begin{aligned}-2 & -1 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we can compute the matrix of $T$ relative to the basis $C:$\n\n$$\n\\begin{aligned}[T]_{C} & ={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1} \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 3 & 5\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 3 \\\\ 6 & -4\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 2 \\\\ 0 & 2\\end{aligned}]\\end{aligned}\n$$"}]}
