/ref 17592186045417] [17592186533920 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186533920 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186533920 #edb/ref 1078 #edb/ref 17592186533145 #edb/ref 17592186045417] [17592186533920 #edb/ref 1079 #uuid "c5ad5d54-7dab-5f4d-91cd-7fa772695521" #edb/ref 17592186045417] [17592186534050 #edb/ref 1068 #edb/ref 17592186533920 #edb/ref 17592186045417] [17592186534050 #edb/ref 1069 "q-161145" #edb/ref 17592186045417] [17592186534050 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186534050 #edb/ref 1071 "Find the surface area of the portion of the cylinder $z=\\sqrt{1-{y}^{2}}$ whose projection onto the $xy$-plane is bounded by $y=\\operatorname{sin}⁡x,$ $x=1,$ and the $x$-axis." #edb/ref 17592186045417] [17592186534050 #edb/ref 1072 #uuid "af89df79-e52d-58d8-85da-a2767435fe32" #edb/ref 17592186045417] [17592186534050 #edb/ref 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=\\sqrt{1-{y}^{2}},\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\operatorname{sin}⁡x\\},\n$$\n\nas shown in the diagram below.\n\n![](images/03/03b9d0f5ae212262bc82e2e2986dfeb6cd3b85f5c8217aba1c7c3c39c97db3d7.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(\\sqrt{1-{y}^{2}})=0, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(\\sqrt{1-{y}^{2}})=-\\frac{y}{\\sqrt{1-{y}^{2}}},\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(0)^{2}+{(-\\frac{y}{\\sqrt{1-{y}^{2}}})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+\\frac{{y}^{2}}{1-{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{\\frac{1}{1-{y}^{2}}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\operatorname{sin}⁡x}\\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\operatorname{arcsin}⁡y\\,{|}_{0}^{\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{2}\\,|}_{0}^{1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186534089 #edb/ref 1068 #edb/ref 17592186533817 #edb/ref 17592186045417] [17592186534089 #edb/ref 1069 "q-161148" #edb/ref 17592186045417] [17592186534089 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186534089 #edb/ref 1071 "Find the surface area of the portion of the plane $z=3y-\\sqrt{6}x$ whose projection onto the $xy$-plane is bounded by $y={x}^{3},$ $y=1,$ and the $y$-axis." #edb/ref 17592186045417] [17592186534089 #edb/ref 1072 #uuid "f3502cd8-8f26-545b-a53a-aaefaf7bd37e" #edb/ref 17592186045417] [17592186534089 #edb/ref 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=3y-\\sqrt{6}x,\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le 1\\},\n$$\n\nas shown in the diagram below.\n\n![](images/9f/9f6192b3c3c61fc0abfd6c4ec46d127431265c870bc38d7deac79353b6923fdd.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(3y-\\sqrt{6}x)=-\\sqrt{6}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(3y-\\sqrt{6}x)=3,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(-\\sqrt{6})}^{2}+(3)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{16}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{x}^{3}}^{1}4\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4\\cdot y\\,{|}_{{x}^{3}}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4-4{x}^{3}\\,\\text{d}x \\\\  & =(4x-{x}^{4}){|}_{0}^{1} \\\\  & =(4-1)-0 \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417]}
