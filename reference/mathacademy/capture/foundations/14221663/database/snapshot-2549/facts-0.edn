186045436] [17592186049883 #edb/ref 1035 #uuid "1adf18d4-239e-50f8-b7e4-88f56c72baad" #edb/ref 17592186045417] [17592186049997 #edb/ref 1027 #edb/ref 17592186049084 #edb/ref 17592186045417] [17592186049997 #edb/ref 1027 #edb/ref 17592186050264 #edb/ref 17592186045417] [17592186049997 #edb/ref 1027 #edb/ref 17592186050705 #edb/ref 17592186045417] [17592186049997 #edb/ref 1028 #edb/ref 17592186133833 #edb/ref 17592186045417] [17592186049997 #edb/ref 1028 #edb/ref 17592186133834 #edb/ref 17592186045417] [17592186049997 #edb/ref 1028 #edb/ref 17592186133835 #edb/ref 17592186045417] [17592186049997 #edb/ref 1028 #edb/ref 17592186133836 #edb/ref 17592186045417] [17592186049997 #edb/ref 1029 #edb/ref 17592186428676 #edb/ref 17592186045436] [17592186049997 #edb/ref 1029 #edb/ref 17592186428677 #edb/ref 17592186045436] [17592186049997 #edb/ref 1029 #edb/ref 17592186428678 #edb/ref 17592186045436] [17592186049997 #edb/ref 1031 "Double Integrals Over Type I Regions" #edb/ref 17592186045417] [17592186049997 #edb/ref 1033 2151 #edb/ref 17592186045417] [17592186049997 #edb/ref 1034 1.1044540289337517 #edb/ref 17592186045436] [17592186049997 #edb/ref 1035 #uuid "24e61144-3626-5d23-b2e6-a33ee94f32f3" #edb/ref 17592186045417] [17592186050816 #edb/ref 1027 #edb/ref 17592186049883 #edb/ref 17592186045417] [17592186050816 #edb/ref 1028 #edb/ref 17592186175979 #edb/ref 17592186045417] [17592186050816 #edb/ref 1028 #edb/ref 17592186175980 #edb/ref 17592186045417] [17592186050816 #edb/ref 1028 #edb/ref 17592186175996 #edb/ref 17592186045417] [17592186050816 #edb/ref 1028 #edb/ref 17592186176065 #edb/ref 17592186045417] [17592186050816 #edb/ref 1029 #edb/ref 17592186429097 #edb/ref 17592186045436] [17592186050816 #edb/ref 1029 #edb/ref 17592186429098 #edb/ref 17592186045436] [17592186050816 #edb/ref 1031 "Areas of Surfaces" #edb/ref 17592186045417] [17592186050816 #edb/ref 1033 3602 #edb/ref 17592186045417] [17592186050816 #edb/ref 1034 0.7650666334417916 #edb/ref 17592186045436] [17592186050816 #edb/ref 1035 #uuid "68d7fe91-eb10-55fb-afa7-8dfde9672cfe" #edb/ref 17592186045417] [17592186173524 #edb/ref 1075 #edb/ref 17592186533358 #edb/ref 17592186045417] [17592186173524 #edb/ref 1075 #edb/ref 17592186533530 #edb/ref 17592186045417] [17592186173524 #edb/ref 1075 #edb/ref 17592186533695 #edb/ref 17592186045417] [17592186173524 #edb/ref 1075 #edb/ref 17592186533746 #edb/ref 17592186045417] [17592186173524 #edb/ref 1075 #edb/ref 17592186533751 #edb/ref 17592186045417] [17592186173524 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186173524 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186173524 #edb/ref 1078 #edb/ref 17592186533746 #edb/ref 17592186045417] [17592186173524 #edb/ref 1079 #uuid "40f25b6b-11c0-5f63-8728-912fd81b80c9" #edb/ref 17592186045417] [17592186175710 #edb/ref 1069 "e-12379" #edb/ref 17592186045417] [17592186175710 #edb/ref 1071 "Find the surface area of the part of the cone $z=\\sqrt{x^2+y^2}$ that is subject to the constraints  $x^2 + y^2 \\leq 4,\\, x\\geq 0$ and $y\\geq 0.$" #edb/ref 17592186045417] [17592186175710 #edb/ref 1072 #uuid "7498df7d-a340-599e-b4ba-496f5142c28c" #edb/ref 17592186045417] [17592186175710 #edb/ref 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1+\\left(\\dfrac{\\partial z}{\\partial x}\\right)^2+\\left(\\dfrac{\\partial z}{\\partial y}\\right)^2} \\: \\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz = \\sqrt{x^2+y^2}, \\qquad (x,y)\\in D,\n$$\n\nwhere the region $D$ is given by\n\n$$\nD = \\big\\{ (x,y) \\: : \\: x^2+y^2\\leq 4, \\, x\\geq 0, \\, y\\geq 0 \\big\\},\n$$\n\nas shown below.\n\n![](images/be/be8246dc3bfe1bf16af5d9913fc4e6aef58ddad282646a00d3e31120f6bf31e8.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}+{y}^{2}})=\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}})=\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}},\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}})}^{2}+{(\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}+\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+\\frac{{x}^{2}+{y}^{2}}{{x}^{2}+{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nIn polar coordinates $(r, \\theta),$ the region $D$ can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 2, \\: 0 \\leq \\theta \\leq \\dfrac{\\pi}{2}\\right\\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{2}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{2}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}r\\sqrt{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}\\,\\text{d}\\theta {\\int }_{0}^{2}r\\,\\text{d}r \\\\  & =\\sqrt{2}\\cdot [\\theta ]_{0}^{\\pi /2}\\cdot {[\\frac{{r}^{2}}{2}]}_{0}^{2} \\\\  & =\\sqrt{2}\\cdot \\frac{\\pi }{2}\\cdot 2 \\\\  & =\\pi \\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175829 #edb/ref 1069 "e-8948" #edb/ref 17592186045417] [17592186175829 #edb/ref 1071 "Find the surface area of the part of the plane $x =y+\\sqrt 2 z$ whose projection onto the $yz$-plane is bounded by the constraints $1 \\leq y\\leq 2$ and $1 \\leq z \\leq 3.$" #edb/ref 17592186045417] [17592186175829 #edb/ref 1072 #uuid "bcdc7b9f-b5f8-5516-a0e6-8ca54fb80a48" #edb/ref 17592186045417] [17592186175829 #edb/ref 1074 "For a surface $S$ defined by $x=f(y,z)$ with $(y,z)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1+\\left(\\dfrac{\\partial x}{\\partial y}\\right)^2+\\left(\\dfrac{\\partial x}{\\partial z}\\right)^2} \\: \\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nx = y+\\sqrt 2 z, \\qquad (y,z)\\in D,\n$$\n\nwhere \n\n$$\nD = \\big\\{ (y,z) \\: : \\: 1 \\leq y \\leq 2, \\: 1 \\leq z \\leq 3\\big\\},\n$$\n\nas shown in the diagram below.\n\n![](images/24/240ac546b0dd725e392dd0bd475b2ef00eebce2594be5921285e227137538c46.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂x}{∂y} & =\\frac{∂}{∂y}(y+\\sqrt{2}z)=1, \\\\ \\frac{∂x}{∂z} & =\\frac{∂}{∂z}(y+\\sqrt{2}z)=\\sqrt{2},\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂x}{∂y})}^{2}+{(\\frac{∂x}{∂z})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(1)}^{2}+{(\\sqrt{2})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{4}\\,\\text{d}A \\\\  & =2{∬}_{D}\\,\\text{d}A \\\\  & =2\\cdot \\text{Area}(D) \\\\  & =2\\cdot (2-1)\\cdot (3-1) \\\\  & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175830 #edb/ref 1069 "e-8959" #edb/ref 17592186045417] [17592186175830 #edb/ref 1071 "Find the surface area of the part of the plane $z = y - 4x$ that is bounded by the constraints $0 \\leq x \\leq 2$ and $0 \\leq y \\leq 1.$" #edb/ref 17592186045417] [17592186175830 #edb/ref 1072 #uuid "80c2abda-a1d9-569e-936e-fc44ba77eb50" #edb/ref 17592186045417] [17592186175830 #edb/ref 1074 "For a surface $S$ defined by $z = f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1 + \\left(\\dfrac{\\partial z}{\\partial x}\\right)^2 + \\left(\\dfrac{\\partial z}{\\partial y}\\right)^2} \\: \\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz = y - 4x, \\qquad 0 \\leq x \\leq 2, \\quad 0 \\leq y \\leq 1.\n$$\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(y-4x)=-4, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(y-4x)=1,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(-4)^{2}+(1)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+16+1}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{18}\\,\\text{d}A \\\\  & ={∬}_{D}3\\sqrt{2}\\,\\text{d}A \\\\  & =3\\sqrt{2}{∬}_{D}\\text{d}A \\\\  & =3\\sqrt{2}\\cdot \\text{Area}(D) \\\\  & =3\\sqrt{2}\\cdot (2-0)\\cdot (1-0) \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175848 #edb/ref 1069 "e-9141" #edb/ref 17592186045417] [17592186175848 #edb/ref 1071 "Find the surface area of the portion of the plane $z = 2y+2x$ whose projection onto the $xy$-plane is bounded by $y=\\cos{x}$ and the $x$-axis from $x=0$ to $x=\\dfrac{\\pi}{2}.$" #edb/ref 17592186045417] [17592186175848 #edb/ref 1072 #uuid "77e8fb3e-1858-5831-b740-a0c133c8180f" #edb/ref 17592186045417] [17592186175848 #edb/ref 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n\\iint\\limits_S \\,  \\text{d}S = \\iint\\limits_D \\sqrt{1+\\left(\\dfrac{\\partial z}{\\partial x}\\right)^2+\\left(\\dfrac{\\partial z}{\\partial y}\\right)^2} \\: \\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz = 2y+2x, \\qquad (x,y)\\in D,\n$$\n\nwhere the region $D$ is given by\n\n$$\nD = \\left\\{ (x,y) \\: : \\: 0 \\leq x \\leq \\dfrac{\\pi}{2}, \\: 0 \\leq y \\leq \\cos{x} \\right\\},\n$$\n\nas shown in the diagram below.\n\n![](images/e7/e74d609a1288446f0f3adc0de65b814f2a6daaf2d398478e7834882f3be68c8c.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(2y+2x)=2, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(2y+2x)=2,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(2)^{2}+(2)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}3\\,\\text{d}A \\\\  & =3{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡x}\\,\\text{d}y\\,\\text{d}x \\\\  & =3{\\int }_{0}^{\\pi /2}y\\,{|}_{0}^{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /2} \\\\  & =3(1-0) \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186176213 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186176214 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186278410 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186278428 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186278429 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186278435 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186278511 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186415938 #edb/ref 17592186045417] [17592186175979 #edb/ref 1038 #edb/ref 17592186415941 #edb/ref 17592186045417] [17592186175979 #edb/ref 1039 "Surface Areas of Surfaces Defined as X=F(Y,Z) or Y=F(X,Z)" #edb/ref 17592186045417] [17592186175979 #edb/ref 1041 #edb/ref 17592186175829 #edb/ref 17592186045417] [17592186175979 #edb/ref 1042 #uuid "e2dfd0a7-f9f0-5f64-b1bc-6788ff864113" #edb/ref 17592186045417] [17592186175980 #edb/ref 1037 #edb/ref 17592186048384 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186176211 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186176242 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186278390 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186278392 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186278401 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186278402 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186415940 #edb/ref 17592186045417] [17592186175980 #edb/ref 1038 #edb/ref 17592186415942 #edb/ref 1759218604