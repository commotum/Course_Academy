#{[{:db/id #edb/ref 17592186259490 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71cbe9b9-abfb-59ee-9a3b-f7f689c26688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186257781} {:answer/id #uuid "88b7f1be-ad85-5371-a6af-84faa05bd3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186257981} {:answer/id #uuid "d1c60dec-38f0-52c7-b0aa-6a4369234d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186258609} {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} {:answer/id #uuid "edb9593d-e1cc-5ea7-ae77-b57065d0d67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186258838}] :answer-field/correct {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} :answer-field/id #uuid "31c01b0b-506b-5b5b-95a1-7bc8278302dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259120}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "74e7bf88-8da6-528c-84d5-ded22deb1ee4" :question/math-academy-id "q-123200" :question/problem "Consider the vector field $F=(x-y)^{3}\\,i+(y+z)^{3}\\,j+(x+z)^{3}\\,k.$ Evaluate $\\text{div}\\,F$ at the point $(-2,2,2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((x-y)^{3})+\\frac{∂}{∂y}((y+z)^{3})+\\frac{∂}{∂z}((x+z)^{3}) \\\\  & =3(x-y)^{2}+3(y+z)^{2}+3(x+z)^{2}.\\end{aligned}\n$$\n\n \n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-2,2,2),$ and obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F(-2,2,2) & =3((-2)-(2))^{2}+3((2)+(2))^{2}+3((-2)+(2))^{2} \\\\  & =3(-4)^{2}+3(4)^{2}+3(0)^{2} \\\\  & =96.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266056 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bcdd62-0b56-5da2-a50a-586faa6696b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy{z}^{2}+xz" :db/id #edb/ref 17592186263155} {:answer/id #uuid "295ca0f4-57e7-5a42-ac1c-c9565fd958a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{z}^{2}+xy{e}^{y}" :db/id #edb/ref 17592186263355} {:answer/id #uuid "2be15acb-dbc4-5b00-98a8-38e26089e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y{z}^{2}+x{e}^{y}" :db/id #edb/ref 17592186263371} {:answer/id #uuid "40fe9bd6-26ef-51ba-a8ee-4aa3a8d37085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{z}^{2}+xy+y" :db/id #edb/ref 17592186263576} {:answer/id #uuid "fe783955-ec8b-51ba-88fd-5f0cc372a593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+{e}^{y}+{z}^{2}" :db/id #edb/ref 17592186265240}] :answer-field/correct {:answer/id #uuid "2be15acb-dbc4-5b00-98a8-38e26089e1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5y{z}^{2}+x{e}^{y}" :db/id #edb/ref 17592186263371} :answer-field/id #uuid "6647713f-61bd-5d5d-9904-3d926c79511c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01f7efc1-008b-5b39-b852-37db53b31085" :question/math-academy-id "q-131176" :question/problem "Consider the vector field $F=2xy{z}^{2}\\,i+x{e}^{y}\\,j+y{z}^{3}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(2xy{z}^{2})+\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂z}(y{z}^{3}) \\\\  & =2y{z}^{2}+x{e}^{y}+3y{z}^{2} \\\\  & =5y{z}^{2}+x{e}^{y}.\\end{aligned}\n$$"}]}
