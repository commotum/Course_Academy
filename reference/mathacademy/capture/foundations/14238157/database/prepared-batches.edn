[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186175666 :answer-field/choices 17592186175667] [:db/retract 17592186175666 :answer-field/choices 17592186175668] [:db/retract 17592186175666 :answer-field/choices 17592186175669] [:db/retract 17592186175666 :answer-field/choices 17592186175670] [:db/retract 17592186175666 :answer-field/choices 17592186175671] {:db/id 17592186176088 :knowledge-point/questions ["question-7d1c2efa-cbed-55e3-967d-daf6bf46e742"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186176588 :question/problem "Let\n$T=[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(2,2),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{2-0}{2-0}=1.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=x.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186175666 :answer-field/correct "answer-3cc44505-66d5-5275-ab67-b9b56ad13597" :answer-field/choices ["answer-51381d98-4b2c-5d35-b328-a422e2a36439" "answer-53c0aaa8-38d2-5451-8a27-0bab44551579" "answer-175bf4de-4457-5893-9e70-48b016ba1c87" "answer-3cc44505-66d5-5275-ab67-b9b56ad13597" "answer-9049bcb9-bcf9-552e-88ca-aa47961cecd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-51381d98-4b2c-5d35-b328-a422e2a36439" :answer/id #uuid "51381d98-4b2c-5d35-b328-a422e2a36439" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-53c0aaa8-38d2-5451-8a27-0bab44551579" :answer/id #uuid "53c0aaa8-38d2-5451-8a27-0bab44551579" :answer/type :answer.type/math :answer/value "y=-2x" :db/ensure [:answer/validate]} {:db/id "answer-175bf4de-4457-5893-9e70-48b016ba1c87" :answer/id #uuid "175bf4de-4457-5893-9e70-48b016ba1c87" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}x" :db/ensure [:answer/validate]} {:db/id "answer-3cc44505-66d5-5275-ab67-b9b56ad13597" :answer/id #uuid "3cc44505-66d5-5275-ab67-b9b56ad13597" :answer/type :answer.type/math :answer/value "y=x" :db/ensure [:answer/validate]} {:db/id "answer-9049bcb9-bcf9-552e-88ca-aa47961cecd9" :answer/id #uuid "9049bcb9-bcf9-552e-88ca-aa47961cecd9" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "question-7d1c2efa-cbed-55e3-967d-daf6bf46e742" :question/id #uuid "7d1c2efa-cbed-55e3-967d-daf6bf46e742" :question/math-academy-id "q-97069" :question/problem "Let\n$T=[\\begin{aligned}2 & -1 \\\\ -6 & 3\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(2,-6)$ and $(-1,3),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-(-6)}{-1-2}=-3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-3x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bfa28e82-e7a7-5631-a9aa-0b573881c151"] :db/ensure [:question/validate]} {:db/id "answer-field-bfa28e82-e7a7-5631-a9aa-0b573881c151" :answer-field/id #uuid "bfa28e82-e7a7-5631-a9aa-0b573881c151" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aee37cb9-5834-51b9-a3fe-6104df070ec9" :answer-field/choices ["answer-620a4056-288f-5313-ad88-b1b0f5b5687b" "answer-aee37cb9-5834-51b9-a3fe-6104df070ec9" "answer-63ce0689-59e9-51d3-8840-c15ea78dfa8f" "answer-a12b6a7f-7604-5711-86fc-b635e4b043ba" "answer-1dd0d15c-be74-50b4-a48c-b8617532b07b"] :db/ensure [:answer-field/validate]} {:db/id "answer-620a4056-288f-5313-ad88-b1b0f5b5687b" :answer/id #uuid "620a4056-288f-5313-ad88-b1b0f5b5687b" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "answer-aee37cb9-5834-51b9-a3fe-6104df070ec9" :answer/id #uuid "aee37cb9-5834-51b9-a3fe-6104df070ec9" :answer/type :answer.type/math :answer/value "y=-3x" :db/ensure [:answer/validate]} {:db/id "answer-63ce0689-59e9-51d3-8840-c15ea78dfa8f" :answer/id #uuid "63ce0689-59e9-51d3-8840-c15ea78dfa8f" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}x" :db/ensure [:answer/validate]} {:db/id "answer-a12b6a7f-7604-5711-86fc-b635e4b043ba" :answer/id #uuid "a12b6a7f-7604-5711-86fc-b635e4b043ba" :answer/type :answer.type/math :answer/value "y=2x" :db/ensure [:answer/validate]} {:db/id "answer-1dd0d15c-be74-50b4-a48c-b8617532b07b" :answer/id #uuid "1dd0d15c-be74-50b4-a48c-b8617532b07b" :answer/type :answer.type/math :answer/value "y={R}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186176273 :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nI. $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$\n\nII. $\\text{rank}(T)=0$\n\nIII. $\\text{Ker}(T)=\\{0\\}$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\n- Statement II is false. We have that\n\n$$\n\\text{rank}(T)=2.\n$$\n\n- Statement III is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to\n\n$$\n\\text{Ker}(T)=\\{0\\}.\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186173896 :answer-field/correct 17592186173900 :db/ensure [:answer-field/validate]} {:db/id "activity-9ea48e0e-20fc-57ae-8fc6-7c2c77548e20" :activity/id #uuid "9ea48e0e-20fc-57ae-8fc6-7c2c77548e20" :activity/title "The Image of a Linear Transformation in the Cartesian Plane" :activity/type :activity.type/review :activity/scope 17592186049895 :activity/course 17592186046660 :activity/steps ["step-1855919c-4174-5759-93cf-11a0280966ca" "step-521a6f9a-99a3-57bc-b710-6c05998470da" "step-cea9ce61-7dee-5a91-9c27-e1a1933f13fb" "step-af32582e-7c99-52e2-a82b-8a159c337dcb" "step-33095b71-1333-5602-a459-f3798f52eba0"] :activity/first-step "step-1855919c-4174-5759-93cf-11a0280966ca" :db/ensure [:activity/validate]} {:db/id "step-1855919c-4174-5759-93cf-11a0280966ca" :step/id #uuid "1855919c-4174-5759-93cf-11a0280966ca" :step/content 17592186176588 :step/next "step-521a6f9a-99a3-57bc-b710-6c05998470da" :db/ensure [:step/validate]} {:db/id "step-521a6f9a-99a3-57bc-b710-6c05998470da" :step/id #uuid "521a6f9a-99a3-57bc-b710-6c05998470da" :step/content "question-7d1c2efa-cbed-55e3-967d-daf6bf46e742" :step/next "step-cea9ce61-7dee-5a91-9c27-e1a1933f13fb" :db/ensure [:step/validate]} {:db/id "step-cea9ce61-7dee-5a91-9c27-e1a1933f13fb" :step/id #uuid "cea9ce61-7dee-5a91-9c27-e1a1933f13fb" :step/content 17592186382648 :step/next "step-af32582e-7c99-52e2-a82b-8a159c337dcb" :db/ensure [:step/validate]} {:db/id "step-af32582e-7c99-52e2-a82b-8a159c337dcb" :step/id #uuid "af32582e-7c99-52e2-a82b-8a159c337dcb" :step/content 17592186398081 :step/next "step-33095b71-1333-5602-a459-f3798f52eba0" :db/ensure [:step/validate]} {:db/id "step-33095b71-1333-5602-a459-f3798f52eba0" :step/id #uuid "33095b71-1333-5602-a459-f3798f52eba