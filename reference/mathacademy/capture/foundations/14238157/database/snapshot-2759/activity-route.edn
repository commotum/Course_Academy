#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186564545} :activity/id #uuid "9ea48e0e-20fc-57ae-8fc6-7c2c77548e20" :activity/scope {:db/id #edb/ref 17592186049895 :topic/id #uuid "1c611a71-aaa1-5a41-a6cd-aa83bbba97af" :topic/math-academy-id 3645} :activity/steps [{:db/id #edb/ref 17592186564545 :step/content {:db/id #edb/ref 17592186176588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "175bf4de-4457-5893-9e70-48b016ba1c87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186564001} {:answer/id #uuid "3cc44505-66d5-5275-ab67-b9b56ad13597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x" :db/id #edb/ref 17592186564070} {:answer/id #uuid "51381d98-4b2c-5d35-b328-a422e2a36439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186564098} {:answer/id #uuid "53c0aaa8-38d2-5451-8a27-0bab44551579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2x" :db/id #edb/ref 17592186564103} {:answer/id #uuid "9049bcb9-bcf9-552e-88ca-aa47961cecd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186564194}] :answer-field/correct {:db/id #edb/ref 17592186564070} :answer-field/id #uuid "2b1ac556-d4ef-5630-9e88-eb68dd60c483" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186175666}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "950ea572-58c1-514e-8c7a-a1bc5bc62c33" :question/math-academy-id "q-97038" :question/problem "Let\n$T=[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(2,2),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{2-0}{2-0}=1.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=x.$"} :step/id #uuid "1855919c-4174-5759-93cf-11a0280966ca" :step/next {:db/id #edb/ref 17592186564561}} {:db/id #edb/ref 17592186564552 :step/content {:db/id #edb/ref 17592186176273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874ac1f7-0153-507d-91ce-fd04d90ca247" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186173897} {:answer/id #uuid "02f0558b-35a2-5e4d-a4f1-1d0d49844653" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186173898} {:answer/id #uuid "04310fd5-0111-5f80-b616-19512cf451da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186173899} {:answer/id #uuid "061f9b11-0217-5760-abc1-a8399b5515c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186173900} {:answer/id #uuid "45945036-7b0c-58a7-8eb0-c915cb38566e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186173901}] :answer-field/correct {:db/id #edb/ref 17592186173900} :answer-field/id #uuid "55c9a14f-7b63-589d-a835-3fb38b9d252c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186173896}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86bc6bae-46fe-5b21-aa49-70bad1578afa" :question/math-academy-id "q-111791" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nI. $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$\n\nII. $\\text{rank}(T)=0$\n\nIII. $\\text{Ker}(T)=\\{0\\}$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\n- Statement II is false. We have that\n\n$$\n\\text{rank}(T)=2.\n$$\n\n- Statement III is true. Indeed, the condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to\n\n$$\n\\text{Ker}(T)=\\{0\\}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "33095b71-1333-5602-a459-f3798f52eba0"} {:db/id #edb/ref 17592186564561 :step/content {:db/id #edb/ref 17592186564499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dd0d15c-be74-50b4-a48c-b8617532b07b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={R}^{2}" :db/id #edb/ref 17592186564007} {:answer/id #uuid "620a4056-288f-5313-ad88-b1b0f5b5687b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186564122} {:answer/id #uuid "63ce0689-59e9-51d3-8840-c15ea78dfa8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2}x" :db/id #edb/ref 17592186564125} {:answer/id #uuid "a12b6a7f-7604-5711-86fc-b635e4b043ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x" :db/id #edb/ref 17592186564213} {:answer/id #uuid "aee37cb9-5834-51b9-a3fe-6104df070ec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3x" :db/id #edb/ref 17592186564238}] :answer-field/correct {:db/id #edb/ref 17592186564238} :answer-field/id #uuid "bfa28e82-e7a7-5631-a9aa-0b573881c151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564436}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7d1c2efa-cbed-55e3-967d-daf6bf46e742" :question/math-academy-id "q-97069" :question/problem "Let\n$T=[\\begin{aligned}2 & -1 \\\\ -6 & 3\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(2,-6)$ and $(-1,3),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-(-6)}{-1-2}=-3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-3x.$"} :step/id #uuid "521a6f9a-99a3-57bc-b710-6c05998470da" :step/next {:db/id #edb/ref 17592186564586}} {:db/id #edb/ref 17592186564581 :step/content {:db/id #edb/ref 17592186398081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dda9e3d7-e6ee-5825-845d-f01fdb4e4b75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186398083} {:answer/id #uuid "cdba0602-2fd0-52ae-8f15-118e4a6f97e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2}x" :db/id #edb/ref 17592186398084} {:answer/id #uuid "f2332fcb-d82d-5111-a699-5798822a8e76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,0)" :db/id #edb/ref 17592186398085} {:answer/id #uuid "3cf49b0b-ca8d-5df2-944e-152ab812be35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x" :db/id #edb/ref 17592186398086} {:answer/id #uuid "75145a95-95a2-5300-a3b1-4c2ffbe7d0e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2x" :db/id #edb/ref 17592186398087}] :answer-field/correct {:db/id #edb/ref 17592186398084} :answer-field/id #uuid "39de4ad4-8ca2-5e4e-a502-b05807674875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398082}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96dc0ffa-c035-5c4a-b42f-7a4928dfb8df" :question/math-academy-id "q-111789" :question/problem "Let\n$T=\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(2,-1),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{-1-0}{2-0}=-\\frac{1}{2}.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-\\frac{1}{2}x.$"} :step/id #uuid "af32582e-7c99-52e2-a82b-8a159c337dcb" :step/next {:db/id #edb/ref 17592186564552}} {:db/id #edb/ref 17592186564586 :step/content {:db/id #edb/ref 17592186382648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48d21b03-b4aa-5edf-97d9-e8d82ba76aa6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454250} {:answer/id #uuid "a4df005b-76b4-5349-9381-8a02c4118a9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454251}] :answer-field/correct {:db/id #edb/ref 17592186454250} :answer-field/id #uuid "1e0c8fb9-1191-5fbe-89aa-082fed4cfe5c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454875} {:answer-field/choices [{:answer/id #uuid "46db31c3-b479-5b1f-9f99-dea7a4e5f9d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454252} {:answer/id #uuid "6adfd406-7a7b-520c-b675-6259bd0b2894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454253}] :answer-field/correct {:db/id #edb/ref 17592186454252} :answer-field/id #uuid "61692f77-337b-53e8-9104-052d1bee29b9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454876} {:answer-field/choices [{:answer/id #uuid "5bf8b14e-2ea8-5937-a61f-4fbf1ad7451e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454254} {:answer/id #uuid "3f5d6c2c-7493-5064-bdb2-fd8b5146ef90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454255}] :answer-field/correct {:db/id #edb/ref 17592186454255} :answer-field/id #uuid "5cfa9f97-b5ce-506a-a8e7-d728d9426d04" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454877}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5aa9ee11-e88d-5123-8f62-331a18227a4a" :question/math-academy-id "q-97075" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ to the origin. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{nullity}(T)=0$\n- **II.** $\\text{Ker}(T)={0}$\n- **III.** $\\text{rank}(T)=0$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is the zero-subspace ${0},$ then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=0\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. We have that\n\n$$\n\\text{nullity}(T)=2.\n$$\n\n- Statement II is false. The condition $\\text{nullity}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={R}^{2}.\n$$\n\n- Statement III is true. Indeed, we have\n\n$$\n\\text{rank}(T)=0.\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "cea9ce61-7dee-5a91-9c27-e1a1933f13fb" :step/next {:db/id #edb/ref 17592186564581}}] :activity/title "The Image of a Linear Transformation in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186563964}]}
