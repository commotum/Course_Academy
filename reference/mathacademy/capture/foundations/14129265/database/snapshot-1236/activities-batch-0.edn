#{[{:activity/first-step {:db/id #edb/ref 17592186162847} :activity/id #uuid "f83b8c51-727f-5eb0-9f6f-bcc3b133cfd6" :activity/scope {:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118} :activity/steps [{:db/id #edb/ref 17592186162847 :step/content {:db/id #edb/ref 17592186163222 :tutorial/content "A square matrix $A$ is **symmetric** if it is equal to its transpose:\n\n$$A^T = A$$\n\nEquivalently, an $n\\times n$ matrix is symmetric if $a_{ij} = a_{ji}$ for all $1 \\leq i,j\\leq n.$\n\nIf $A$ is symmetric, this really means that it is symmetric across its main diagonal.\n\nFor example, the matrix\n\n$$A=[\\begin{aligned}3 & 4 \\\\ 4 & -5\\end{aligned}]$$\n\nis symmetric since $A^T = A.$\n\nOn the other hand, the matrix\n\n$$B=[\\begin{aligned}3 & 4 \\\\ 2 & -5\\end{aligned}]$$\n\nis not symmetric. Indeed, since $b_{12} \\neq b_{21},$ we have $B^T \\neq B.$" :tutorial/id #uuid "1fe9d8bc-6133-5ab4-8b4f-af2b40817e02" :tutorial/math-academy-id 4880 :tutorial/title "Introduction"} :step/id #uuid "9c19c64f-0597-5273-8ff3-50729d7a67fc" :step/math-academy-id 30531 :step/next {:db/id #edb/ref 17592186162859}} {:db/id #edb/ref 17592186162859 :step/content {:db/id #edb/ref 17592186161979 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161771 :question/id #uuid "c68d70a2-e4f8-5f08-8220-3df420a1e199" :question/math-academy-id "e-8156"} :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050727}] :knowledge-point/questions [{:db/id #edb/ref 17592186162586} {:db/id #edb/ref 17592186162613} {:db/id #edb/ref 17592186272114} {:db/id #edb/ref 17592186275133} {:db/id #edb/ref 17592186275134} {:db/id #edb/ref 17592186357611} {:db/id #edb/ref 17592186357612} {:db/id #edb/ref 17592186357613} {:db/id #edb/ref 17592186366553} {:db/id #edb/ref 17592186366560} {:db/id #edb/ref 17592186425154}] :knowledge-point/title "Identifying Symmetric Matrices"} :step/id #uuid "f2c61bc7-19cc-5e6a-a533-0450e49aa5dd" :step/math-academy-id 30550 :step/next {:db/id #edb/ref 17592186162924}} {:db/id #edb/ref 17592186162924 :step/content {:db/id #edb/ref 17592186163254 :tutorial/content "Suppose that $A$ is a symmetric matrix. Then, we have the following properties:\n\n- $-A$ is symmetric\n- $A^m$ is symmetric for any positive integer $m$\n- $A^{-1}$ is symmetric for nonsingular $A$\n\nIf $A$ and $B$ are $n\\times n$ symmetric matrices, we have the following properties:\n\n- $A+B$ is symmetric\n- The product $A\\cdot B$ is *not* always symmetric. For example, if $$A = [\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}], \\qquad B = [\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]$$ then the product $A\\cdot B$ is $$\\begin{aligned}A\\cdot B & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]\\,\\,\\times \\end{aligned}$$ which is *not* symmetric.\n\nFinally, the following two properties can be used to construct symmetric matrices:\n\n- $A + A^T$ is symmetric for any *square* matrix $A$\n- $A^T A$ and $A A^T$ are symmetric for *any* matrix $A$\n\nThe last property is true for *any* $m\\times n$ matrix. This property is particularly useful, as we'll discover in future lessons." :tutorial/id #uuid "c20572b7-1e75-5be2-a39c-b2327caff234" :tutorial/math-academy-id 5043 :tutorial/title "Properties of Symmetric Matrices"} :step/id #uuid "a119eca9-e695-53d9-9049-eef3212a6e22" :step/math-academy-id 31545 :step/next {:db/id #edb/ref 17592186162925}} {:db/id #edb/ref 17592186162925 :step/content {:db/id #edb/ref 17592186162024 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161816 :question/id #uuid "b159d52a-a436-5743-9151-2e147364a41d" :question/math-academy-id "e-8478"} :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050446}] :knowledge-point/questions [{:db/id #edb/ref 17592186162676} {:db/id #edb/ref 17592186162694} {:db/id #edb/ref 17592186275135} {:db/id #edb/ref 17592186275136} {:db/id #edb/ref 17592186275137} {:db/id #edb/ref 17592186275138} {:db/id #edb/ref 17592186360684} {:db/id #edb/ref 17592186360685} {:db/id #edb/ref 17592186360686} {:db/id #edb/ref 17592186365108} {:db/id #edb/ref 17592186366739}] :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices"} :step/id #uuid "dd82fa90-8f6a-5c31-a6bd-faa30ff2ee22" :step/math-academy-id 31546}] :activity/title "Symmetric Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162214}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186425156} :activity/id #uuid "4147fa8b-5ff8-579d-afae-acd5982a7b2d" :activity/scope {:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118} :activity/steps [{:db/id #edb/ref 17592186425155 :step/content {:db/id #edb/ref 17592186360684 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345e70f6-3b7f-5da0-bde7-5d6dee2d58b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186358217} {:answer/id #uuid "3826a4d7-56d7-5e10-a722-00186a58d1cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186358247} {:answer/id #uuid "a417c4ea-e08a-5c5c-9298-aba87be43f9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186359178} {:answer/id #uuid "a7e30533-75d2-5c1b-95fd-97a38042507a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186359200} {:answer/id #uuid "d543ae34-7a48-5fe8-abcf-7b864c0a60f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186359619}] :answer-field/correct {:db/id #edb/ref 17592186359178} :answer-field/id #uuid "f979226a-2f92-55ff-a0a9-14997d804f85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360437}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6c182c5-819c-5206-a031-9309a3557f8d" :question/math-academy-id "q-96589" :question/problem "Which of the following statements are true?\n\nI. If $A$ is *any*  $n\\times n$ matrix, then ${A}^{2}$ is always symmetric.\n\nII. The product of two $n\\times n$ symmetric matrices is always symmetric.\n\nIII. If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. As a counterexample, consider the matrix \n\n$\\,$ $A=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}].$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}].$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "13d711fe-4f91-5fa4-8a59-b8df54fc9061" :step/next {:db/id #edb/ref 17592186425157}} {:db/id #edb/ref 17592186425156 :step/content {:db/id #edb/ref 17592186357611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aed7340-5f0e-5165-ab13-314353711b81" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186355333} {:answer/id #uuid "8963ef11-348f-5e5f-8b9b-9f406cee908f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186355880} {:answer/id #uuid "97fba95d-9f14-57b0-a978-2376e948fa78" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186356004} {:answer/id #uuid "bf821222-3076-59f2-8a78-9a7dfb62f4df" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186356340} {:answer/id #uuid "e046d0c3-8ff2-5bd0-8adf-c6c8f1901ef7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186356626}] :answer-field/correct {:db/id #edb/ref 17592186355880} :answer-field/id #uuid "e67b1e1e-56ae-5451-a8ba-26dd0254b3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357327}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "225f8bdf-5da4-5137-973e-d6466e5f7f7a" :question/math-academy-id "q-93985" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}],\\,Q=[\\begin{aligned}0 & -1 \\\\ -1 & 2\\end{aligned}],\\,R=[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}]\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$Q$ only.\""} :step/id #uuid "850fd871-11f1-5a64-9c68-516ffbeed054" :step/next {:db/id #edb/ref 17592186425155}} {:db/id #edb/ref 17592186425157 :step/content {:db/id #edb/ref 17592186425154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa99686-720d-5c83-8792-909de2767703" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186425148} {:answer/id #uuid "13edd389-e8cd-52c8-8f6e-2c34ed7ad05c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186425149} {:answer/id #uuid "33ef6a26-6c4e-56d3-8e19-d9dc460624f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186425150} {:answer/id #uuid "655424c1-b811-5aaf-8538-b1da76023605" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186425151} {:answer/id #uuid "65dc2a15-12f3-5c0d-999e-1bc8c09548b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186425152}] :answer-field/correct {:db/id #edb/ref 17592186425150} :answer-field/id #uuid "2dcd0455-6677-5df3-b08a-01a2a95723e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425153}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ea940e2f-7cf1-5b69-9241-9cde37e5f341" :question/math-academy-id "q-140503" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 0 & 0\\end{aligned}],\\,Q=[\\begin{aligned}2 & \\sqrt{2} & -2 \\\\ \\sqrt{2} & -1 & 0 \\\\ -2 & 0 & 3\\end{aligned}],\\,R=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 0 & 0\\end{aligned}]\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$Q$ and $R$ only.\""} :step/id #uuid "ae65fa76-f15c-5a90-8603-42143fe53ed6"}] :activity/title "Symmetric Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425147}]}
