#{[{:db/id #edb/ref 17592186357611 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aed7340-5f0e-5165-ab13-314353711b81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186355333} {:answer/id #uuid "8963ef11-348f-5e5f-8b9b-9f406cee908f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186355880} {:answer/id #uuid "97fba95d-9f14-57b0-a978-2376e948fa78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186356004} {:answer/id #uuid "bf821222-3076-59f2-8a78-9a7dfb62f4df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186356340} {:answer/id #uuid "e046d0c3-8ff2-5bd0-8adf-c6c8f1901ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186356626}] :answer-field/correct {:answer/id #uuid "8963ef11-348f-5e5f-8b9b-9f406cee908f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186355880} :answer-field/id #uuid "e67b1e1e-56ae-5451-a8ba-26dd0254b3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "225f8bdf-5da4-5137-973e-d6466e5f7f7a" :question/math-academy-id "q-93985" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}],\\,Q=[\\begin{aligned}0 & -1 \\\\ -1 & 2\\end{aligned}],\\,R=[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}]\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$Q$ only.\""}] [{:db/id #edb/ref 17592186360684 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "345e70f6-3b7f-5da0-bde7-5d6dee2d58b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358217} {:answer/id #uuid "3826a4d7-56d7-5e10-a722-00186a58d1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358247} {:answer/id #uuid "a417c4ea-e08a-5c5c-9298-aba87be43f9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359178} {:answer/id #uuid "a7e30533-75d2-5c1b-95fd-97a38042507a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359200} {:answer/id #uuid "d543ae34-7a48-5fe8-abcf-7b864c0a60f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359619}] :answer-field/correct {:answer/id #uuid "a417c4ea-e08a-5c5c-9298-aba87be43f9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359178} :answer-field/id #uuid "f979226a-2f92-55ff-a0a9-14997d804f85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6c182c5-819c-5206-a031-9309a3557f8d" :question/math-academy-id "q-96589" :question/problem "Which of the following statements are true?\n\n- If $A$ is *any*  $n\\times n$ matrix, then ${A}^{2}$ is always symmetric.\n- The product of two $n\\times n$ symmetric matrices is always symmetric.\n- If $A$ is a symmetric matrix, then ${A}^{-1}$ is always symmetric (if it exists)." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. As a counterexample, consider the matrix \n\n$\\,$ $A=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}].$\n\nHowever, ${A}^{2}$ is not symmetric:\n\n$$\n\\begin{aligned}{A}^{2} & =[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}].$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any non-singular symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}({A}^{-1})^{T} & =({A}^{T})^{-1} \\\\  & ={A}^{-1}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""}]}
