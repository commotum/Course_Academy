#{[{:activity/first-step {:db/id #edb/ref 17592186162847} :activity/id #uuid "f83b8c51-727f-5eb0-9f6f-bcc3b133cfd6" :activity/scope {:db/id #edb/ref 17592186050021 :topic/id #uuid "268943d4-aaa4-5e39-9db5-48d7523acdc3" :topic/math-academy-id 3118} :activity/steps [{:db/id #edb/ref 17592186162847 :step/content {:db/id #edb/ref 17592186163222 :tutorial/content "A square matrix $A$ is **symmetric** if it is equal to its transpose:\n\n$$A^T = A$$\n\nEquivalently, an $n\\times n$ matrix is symmetric if $a_{ij} = a_{ji}$ for all $1 \\leq i,j\\leq n.$\n\nIf $A$ is symmetric, this really means that it is symmetric across its main diagonal.\n\nFor example, the matrix\n\n$$A=[\\begin{aligned}3 & 4 \\\\ 4 & -5\\end{aligned}]$$\n\nis symmetric since $A^T = A.$\n\nOn the other hand, the matrix\n\n$$B=[\\begin{aligned}3 & 4 \\\\ 2 & -5\\end{aligned}]$$\n\nis not symmetric. Indeed, since $b_{12} \\neq b_{21},$ we have $B^T \\neq B.$" :tutorial/id #uuid "1fe9d8bc-6133-5ab4-8b4f-af2b40817e02" :tutorial/math-academy-id 4880 :tutorial/title "Introduction"} :step/id #uuid "9c19c64f-0597-5273-8ff3-50729d7a67fc" :step/math-academy-id 30531 :step/next {:db/id #edb/ref 17592186162859}} {:db/id #edb/ref 17592186162859 :step/content {:db/id #edb/ref 17592186161979 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161771 :question/id #uuid "c68d70a2-e4f8-5f08-8220-3df420a1e199" :question/math-academy-id "e-8156"} :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050727}] :knowledge-point/questions [{:db/id #edb/ref 17592186162586} {:db/id #edb/ref 17592186162613} {:db/id #edb/ref 17592186272114} {:db/id #edb/ref 17592186275133} {:db/id #edb/ref 17592186275134} {:db/id #edb/ref 17592186357611} {:db/id #edb/ref 17592186357612} {:db/id #edb/ref 17592186357613} {:db/id #edb/ref 17592186366553} {:db/id #edb/ref 17592186366560}] :knowledge-point/title "Identifying Symmetric Matrices"} :step/id #uuid "f2c61bc7-19cc-5e6a-a533-0450e49aa5dd" :step/math-academy-id 30550 :step/next {:db/id #edb/ref 17592186162924}} {:db/id #edb/ref 17592186162924 :step/content {:db/id #edb/ref 17592186163254 :tutorial/content "Suppose that $A$ is a symmetric matrix. Then, we have the following properties:\n\n- $-A$ is symmetric\n- $A^m$ is symmetric for any positive integer $m$\n- $A^{-1}$ is symmetric for nonsingular $A$\n\nIf $A$ and $B$ are $n\\times n$ symmetric matrices, we have the following properties:\n\n- $A+B$ is symmetric\n- The product $A\\cdot B$ is *not* always symmetric. For example, if $$A = [\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}], \\qquad B = [\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]$$ then the product $A\\cdot B$ is $$\\begin{aligned}A\\cdot B & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]\\,\\,\\times \\end{aligned}$$ which is *not* symmetric.\n\nFinally, the following two properties can be used to construct symmetric matrices:\n\n- $A + A^T$ is symmetric for any *square* matrix $A$\n- $A^T A$ and $A A^T$ are symmetric for *any* matrix $A$\n\nThe last property is true for *any* $m\\times n$ matrix. This property is particularly useful, as we'll discover in future lessons." :tutorial/id #uuid "c20572b7-1e75-5be2-a39c-b2327caff234" :tutorial/math-academy-id 5043 :tutorial/title "Properties of Symmetric Matrices"} :step/id #uuid "a119eca9-e695-53d9-9049-eef3212a6e22" :step/math-academy-id 31545 :step/next {:db/id #edb/ref 17592186162925}} {:db/id #edb/ref 17592186162925 :step/content {:db/id #edb/ref 17592186162024 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161816 :question/id #uuid "b159d52a-a436-5743-9151-2e147364a41d" :question/math-academy-id "e-8478"} :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050446}] :knowledge-point/questions [{:db/id #edb/ref 17592186162676} {:db/id #edb/ref 17592186162694} {:db/id #edb/ref 17592186275135} {:db/id #edb/ref 17592186275136} {:db/id #edb/ref 17592186275137} {:db/id #edb/ref 17592186275138} {:db/id #edb/ref 17592186360684} {:db/id #edb/ref 17592186360685} {:db/id #edb/ref 17592186360686} {:db/id #edb/ref 17592186365108} {:db/id #edb/ref 17592186366739}] :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices"} :step/id #uuid "dd82fa90-8f6a-5c31-a6bd-faa30ff2ee22" :step/math-academy-id 31546}] :activity/title "Symmetric Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162214}]}
