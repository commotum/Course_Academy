lse\">)</mo><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>2</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle></mrow><mn>4</mn></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
