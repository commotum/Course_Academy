/msqrt></mrow><mrow><mo stretchy=\"false\">(</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
