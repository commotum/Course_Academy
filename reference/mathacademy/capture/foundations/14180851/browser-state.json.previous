rt></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">⟨</mo><mo>−</mo><mn>9</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>t</mi><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mn>9</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>t</mi></mrow><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow></mtd></mtr><mtr><mtd><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>10</mn></msqrt></mfrac></mstyle><msqrt><mo stretchy=\"false\">(</mo><mn>9</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>t</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>9</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><msup><mn>0</mn><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>10</mn></msqrt></mfrac></mstyle><msqrt><msup><mn>9</mn><mn>2</mn></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>t</mi><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>t</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" s