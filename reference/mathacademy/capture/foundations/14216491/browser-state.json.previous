l\">d</mi></mrow><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∬</mo><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></munder><mi>y</mi><mi>z</mi><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mi>z</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∬</mo><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></munder><mi>y</mi><mi>z</mi><mo stretchy=\"false\">(</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>y</mi><mi>z</mi><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∬</mo><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></munder><msup><mi>y</mi><mn>3</mn></msup><mi>z</mi><mo>+</mo><mn>2</mn><msup><mi>y</mi><mn>2</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mi>y</mi><msup><mi>z</mi><mn>3</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>A</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We must now evaluate the double integral above over the region <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"193\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D437 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi></mat