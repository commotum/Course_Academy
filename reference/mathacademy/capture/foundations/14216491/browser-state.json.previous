      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216491/observations/step-q40208-d4bfd576857e2411ac7b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216491/observations/step-q40208-d4bfd576857e2411ac7b.png",
      "source_url": "https://mathacademy.com/tasks/14216491/topics/2141/lesson",
      "captured_at": 1792015444.9734485,
      "math_academy_id": "q-40208",
      "topic_id": "2141",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q40208",
        "placement_id": null,
