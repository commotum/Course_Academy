ata-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>0</mn></mstyle></mrow></mtd><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mo>+</mo><mn>3</mn></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>107</mn></mtd><mtd><mn>215</mn></mtd></mtr><mtr><mtd><mn>6</mn></mtd><mtd><mn>8</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>107</mn><mo>⋅</mo><mn>8</mn><mo>−</mo><mn>215</mn><mo>⋅</mo><mn>6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>434</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
