/ref 17592186444680 #edb/ref 17592186045417] [17592186444690 #edb/ref 1075 #edb/ref 17592186444683 #edb/ref 17592186045417] [17592186444690 #edb/ref 1075 #edb/ref 17592186444685 #edb/ref 17592186045417] [17592186444690 #edb/ref 1075 #edb/ref 17592186444686 #edb/ref 17592186045417] [17592186444690 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186444690 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186444690 #edb/ref 1078 #edb/ref 17592186444686 #edb/ref 17592186045417] [17592186444690 #edb/ref 1079 #uuid "4dfff41f-ad79-57e1-bbe0-18110bfed6e2" #edb/ref 17592186045417] [17592186444691 #edb/ref 1075 #edb/ref 17592186444665 #edb/ref 17592186045417] [17592186444691 #edb/ref 1075 #edb/ref 17592186444668 #edb/ref 17592186045417] [17592186444691 #edb/ref 1075 #edb/ref 17592186444672 #edb/ref 17592186045417] [17592186444691 #edb/ref 1075 #edb/ref 17592186444673 #edb/ref 17592186045417] [17592186444691 #edb/ref 1075 #edb/ref 17592186444677 #edb/ref 17592186045417] [17592186444691 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186444691 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186444691 #edb/ref 1078 #edb/ref 17592186444673 #edb/ref 17592186045417] [17592186444691 #edb/ref 1079 #uuid "a97de606-d3e0-57f4-9214-46ea151db54d" #edb/ref 17592186045417] [17592186444692 #edb/ref 1075 #edb/ref 17592186444659 #edb/ref 17592186045417] [17592186444692 #edb/ref 1075 #edb/ref 17592186444660 #edb/ref 17592186045417] [17592186444692 #edb/ref 1075 #edb/ref 17592186444666 #edb/ref 17592186045417] [17592186444692 #edb/ref 1075 #edb/ref 17592186444667 #edb/ref 17592186045417] [17592186444692 #edb/ref 1075 #edb/ref 17592186444669 #edb/ref 17592186045417] [17592186444692 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186444692 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186444692 #edb/ref 1078 #edb/ref 17592186444666 #edb/ref 17592186045417] [17592186444692 #edb/ref 1079 #uuid "f1ed9b22-e11c-5770-9922-e0f3dca90fb8" #edb/ref 17592186045417] [17592186444693 #edb/ref 1068 #edb/ref 17592186444692 #edb/ref 17592186045417] [17592186444693 #edb/ref 1069 "q-97706" #edb/ref 17592186045417] [17592186444693 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186444693 #edb/ref 1071 "Find the center and radius of the osculating circle to the curve $r(t)$ at the point $P(1,1)$ where $t=0,$ given that $‖{r}^{′}(0)‖=1,$ and the unit tangent vector to the curve is \n\n$$\nT(t)=⟨\\frac{2t}{\\sqrt{1+4{t}^{2}}},\\,\\frac{1}{\\sqrt{1+4{t}^{2}}}⟩.\n$$" #edb/ref 17592186045417] [17592186444693 #edb/ref 1072 #uuid "21c086f0-0661-5c6d-8a42-5fe15673cf33" #edb/ref 17592186045417] [17592186444693 #edb/ref 1074 "Since we are given both the value of $‖{r}^{′}(0)‖$ and the unit tangent $T(t)$, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nNotice that $r(0)=⟨1,1⟩,$ since the point $P(1,1)$ is at the tip of $r(0).$ \n\nNow, we find ${T}^{′}(t),$ ${T}^{′}(0)$ and $‖{T}^{′}(0)‖:$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{1+4{t}^{2}}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{1+4{t}^{2}}})⟩ \\\\  & =⟨\\frac{2}{\\sqrt{(1+4{t}^{2})^{3}}},\\,-\\frac{4t}{\\sqrt{(1+4{t}^{2})^{3}}}⟩ \\\\ {T}^{′}(0) & =⟨\\frac{2}{\\sqrt{(1+4(0)^{2})^{3}}},\\,-\\frac{4(0)}{\\sqrt{(1+4(0)^{2})^{3}}}⟩=⟨2,0⟩ \\\\ ‖{T}^{′}(0)‖ & =\\sqrt{{2}^{2}+{0}^{2}}=2\\end{aligned}\n$$\n\nHence, the radius of curvature is\n\n$$\n\\begin{aligned}R(0) & =\\frac{‖{r}^{′}(0)‖}{‖{T}^{′}(0)‖}=\\frac{1}{2}.\\end{aligned}\n$$\n\nNext, we find the principal normal vector at $t=0$ as\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖}=\\frac{1}{2}⟨2,0⟩=⟨1,0⟩.\\end{aligned}\n$$\n\nFinally, the center of the osculating circle is given by\n\n$$\n\\begin{aligned}r(0)+R(0)N(0) & =⟨1,1⟩+\\frac{1}{2}⟨1,0⟩=⟨\\frac{3}{2},1⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444694 #edb/ref 1068 #edb/ref 17592186444691 #edb/ref 17592186045417] [17592186444694 #edb/ref 1069 "q-132206" #edb/ref 17592186045417] [17592186444694 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186444694 #edb/ref 1071 "Find the center and radius of the osculating circle to the curve $r(t)$ at the point $P(\\frac{1}{2},\\frac{2}{3})$ where $t=1,$ given that $‖{r}^{′}(1)‖=\\sqrt{2},$ and the unit tangent vector $T(t)$ to the curve is\n\n$$\nT(t)=⟨\\sqrt{\\frac{t}{t+1}},\\,\\frac{1}{\\sqrt{t+1}}⟩.\n$$" #edb/ref 17592186045417] [17592186444694 #edb/ref 1072 #uuid "455e62c8-3b81-5de7-9ef0-5fb64015c1fb" #edb/ref 17592186045417] [17592186444694 #edb/ref 1074 "Since we are given both the value of $‖{r}^{′}(1)‖$ and the unit tangent $T(t)$, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nNotice that $r(1)=⟨\\frac{1}{2},\\frac{2}{3}⟩,$ since the point $P(\\frac{1}{2},\\frac{2}{3})$ is at the tip of $r(1).$ \n\nNow, we find ${T}^{′}(t)$, ${T}^{′}(1)$ and $‖{T}^{′}(1)‖:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\sqrt{\\frac{t}{t+1}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{t+1}})⟩ \\\\  & =⟨\\frac{1}{2\\sqrt{t}(t+1)^{3/2}},\\,-\\frac{1}{2(t+1)^{3/2}}⟩ \\\\ {T}^{′}(1) & =⟨\\frac{1}{2\\sqrt{1}(1+1)^{3/2}},\\,-\\frac{1}{2(1+1)^{3/2}}⟩ \\\\  & =⟨\\frac{1}{2(2)^{3/2}},-\\frac{1}{2(2)^{3/2}}⟩ \\\\  & =\\frac{1}{4\\sqrt{2}}⟨1,-1⟩ \\\\ ‖{T}^{′}(1)‖ & =\\frac{1}{4\\sqrt{2}}\\cdot \\sqrt{{1}^{2}+(-1)^{2}} \\\\  & =\\frac{1}{4\\sqrt{2}}\\cdot \\sqrt{2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nHence, the radius of curvature is\n\n$$\n\\begin{aligned}R(1) & =\\frac{‖{r}^{′}(1)‖}{‖{T}^{′}(1)‖} \\\\  & =\\frac{\\sqrt{2}}{(\\frac{1}{4})} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$\n\nNext, we find the principal normal vector at $t=1$ as\n\n$$\n\\begin{aligned}N(1) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖}=\\frac{1}{\\sqrt{2}}⟨1,-1⟩.\\end{aligned}\n$$\n\nFinally, the center of the osculating circle is given by\n\n$$\n\\begin{aligned}r(1)+R(1)N(1) & =⟨\\frac{1}{2},\\frac{2}{3}⟩+4\\sqrt{2}\\cdot \\frac{1}{\\sqrt{2}}⟨1,-1⟩ \\\\  & =⟨\\frac{1}{2},\\frac{2}{3}⟩+4⟨1,-1⟩ \\\\  & =⟨\\frac{1}{2},\\frac{2}{3}⟩+⟨4,-4⟩ \\\\  & =⟨\\frac{9}{2},-\\frac{10}{3}⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444695 #edb/ref 1068 #edb/ref 17592186444690 #edb/ref 17592186045417] [17592186444695 #edb/ref 1069 "q-132119" #edb/ref 17592186045417] [17592186444695 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186444695 #edb/ref 1071 "Find the radius of the osculating circle at the point where $t=2$ for the curve $r(t)=⟨t,\\,\\sqrt{t}⟩.$" #edb/ref 17592186045417] [17592186444695 #edb/ref 1072 #uuid "577c86ab-d1fb-551c-9998-1ea74c39e37e" #edb/ref 17592186045417] [17592186444695 #edb/ref 1074 "Since we are given only the curve $r(t)$, we will use the cross product formula to find the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t){‖}^{3}}{‖{r}^{′}(t)\\times {r}^{″}(t)‖}\n$$\n\nFirst, we calculate ${r}^{′}(t)$, ${r}^{′}(2),$ and $‖{r}^{′}(2)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨1,\\,\\frac{1}{2\\sqrt{t}}⟩ \\\\ {r}^{′}(2) & =⟨1,\\frac{1}{2\\sqrt{2}}⟩ \\\\ ‖{r}^{′}(2)‖ & =\\sqrt{(1)^{2}+{(\\frac{1}{2\\sqrt{2}})}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{8}} \\\\  & =\\frac{3}{2\\sqrt{2}}\\end{aligned}\n$$\n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1),\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2\\sqrt{t}})⟩ \\\\  & =⟨0,\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩ \\\\ {r}^{″}(2) & =⟨0,-\\frac{1}{4\\sqrt{{2}^{3}}}⟩ \\\\  & =⟨0,-\\frac{1}{8\\sqrt{2}}⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(2)$ and ${r}^{″}(2)$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(2)\\times {r}^{″}(2) & =⟨1,\\,\\frac{1}{2\\sqrt{2}},\\,0⟩\\times ⟨0,\\,-\\frac{1}{8\\sqrt{2}},\\,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & \\frac{1}{2\\sqrt{2}} & 0 \\\\ 0 & -\\frac{1}{8\\sqrt{2}} & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}1 & \\frac{1}{2\\sqrt{2}} \\\\ 0 & -\\frac{1}{8\\sqrt{2}}\\end{aligned}\\right|\\,k \\\\  & =-\\frac{1}{8\\sqrt{2}}\\,k \\\\ ‖{r}^{′}(2)\\times {r}^{″}(2)‖ & =\\frac{1}{8\\sqrt{2}}\\end{aligned}\n$$\n\nTherefore, the radius of curvature at $t=2$ is\n\n$$\n\\begin{aligned}R(2) & =\\frac{‖{r}^{′}(2){‖}^{3}}{‖{r}^{′}(2)\\times {r}^{″}(2)‖} \\\\  & =\\frac{{(\\frac{3}{2\\sqrt{2}})}^{3}}{(\\frac{1}{8\\sqrt{2}})} \\\\  & =\\frac{(\\frac{27}{16\\sqrt{2}})}{(\\frac{1}{8\\sqrt{2}})} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444696 #edb/ref 1068 #edb/ref 17592186444689 #edb/ref 17592186045417] [17592186444696 #edb/ref 1069 "q-132107" #edb/ref 17592186045417] [17592186444696 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186444696 #edb/ref 1071 "Consider a curve $r(s)$ parametrized by its arc length $s.$ Find the radius of curvature of $r(s)$ at an arbitrary point knowing that its unit tangent vector $T(s)$ is given by\n\n$$\nT(s)=\\frac{1}{2}⟨\\operatorname{cos}⁡(\\frac{s}{8}),\\,-\\operatorname{sin}⁡(\\frac{s}{8}),\\,\\sqrt{3}⟩.\n$$" #edb/ref 17592186045417] [17592186444696 #edb/ref 1072 #uuid "6116bb62-b350-5926-8756-9fc43f77db50" #edb/ref 17592186045417] [17592186444696 #edb/ref 1074 "Since the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by arc length $s$, we will use the following formula for the radius of curvature:\n\n$$\nR(s)=\\frac{1}{κ(s)}=\\frac{1}{‖{T}^{′}(s)‖}\n$$\n\nWe differentiate $T(s)$ with respect to $s$ and calculate its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{1}{2}⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡(\\frac{s}{8})),\\,\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡(\\frac{s}{8})),\\,\\frac{\\text{d}}{\\text{d}s}(\\sqrt{3})⟩ \\\\  & =\\frac{1}{2}⟨-\\frac{1}{8}\\operatorname{sin}⁡(\\frac{s}{8}),\\,-\\frac{1}{8}\\operatorname{cos}⁡(\\frac{s}{8}),\\,0⟩ \\\\  & =-\\frac{1}{16}⟨\\operatorname{sin}⁡(\\frac{s}{8}),\\,\\operatorname{cos}⁡(\\frac{s}{8}),\\,0⟩ \\\\ ‖{T}^{′}(s)‖ & =\\frac{1}{16}\\cdot \\sqrt{{(\\operatorname{sin}⁡(\\frac{s}{8}))}^{2}+{(\\operatorname{sin}⁡(\\frac{s}{8}))}^{2}+{(0)}^{2}} \\\\  & =\\frac{1}{16}\\cdot \\sqrt{{sin}^{2}⁡(\\frac{s}{8})+{cos}^{2}⁡(\\frac{s}{8})} \\\\  & =\\frac{1}{16}\\cdot \\sqrt{1} \\\\  & =\\frac{1}{16}\\cdot 1 \\\\  & =\\frac{1}{16}\\end{aligned}\n$$\n\nTherefore, the radius of curvature is\n\n$$\nR(s)=\\frac{1}{‖{T}^{′}(s)‖}=\\frac{1}{(\\frac{1}{16})}=16.\n$$" #edb/ref 17592186045417] [17592186444697 #edb/ref 1068 #edb/ref 17592186444688 #edb/ref 17592186045417] [17592186444697 #edb/ref 1069 "q-98717" #edb/ref 17592186045417] [17592186444697 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186444697 #edb/ref 1071 "Find the radius of the osculating circle at the point where $t=\\frac{\\pi }{4}$ for the curve $r(t)=⟨\\operatorname{sin}⁡2t,2\\operatorname{cos}⁡2t⟩.$" #edb/ref 17592186045417] [17592186444697 #edb/ref 1072 #uuid "8e82dd54-dc76-5073-8b6d-fd7d44dc815e" #edb/ref 17592186045417] [17592186444697 #edb/ref 1074 "Since we are given only the curve $r(t)$, we will use the cross product formula to find the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t){‖}^{3}}{‖{r}^{′}(t)\\times {r}^{″}(t)‖}\n$$\n\nFirst, we calculate ${r}^{′}(t),$ ${r}^{′}(\\frac{\\pi }{4})$ and $‖{r}^{′}(\\frac{\\pi }{4})‖:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡2t)⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,-4\\operatorname{sin}⁡2t⟩ \\\\ {r}^{′}(\\frac{\\pi }{4}) & =⟨2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4}),-4\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})⟩ \\\\  & =⟨2\\operatorname{cos}⁡(\\frac{\\pi }{2}),-4\\operatorname{sin}⁡(\\frac{\\pi }{2})⟩ \\\\  & =⟨0,-4⟩ \\\\ ‖{r}^{′}(\\frac{\\pi }{4})‖ & =\\sqrt{{0}^{2}+(-4)^{2}}=4\\end{aligned}\n$$\n\n \n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=\\frac{\\pi }{4}:$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(-4\\operatorname{sin}⁡2t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡2t,-8\\operatorname{cos}⁡2t⟩ \\\\ {r}^{″}(\\frac{\\pi }{4}) & =⟨-4\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}),-8\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4})⟩ \\\\  & =⟨-4\\operatorname{sin}⁡(\\frac{\\pi }{2}),-8\\operatorname{cos}⁡(\\frac{\\pi }{2})⟩ \\\\  & =⟨-4,0⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(\\frac{\\pi }{4})$ and ${r}^{″}(\\frac{\\pi }{4})$ as $3$-dimensional vectors with zero $z$-components: \n\n$$\n\\begin{aligned}{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4}) & =⟨0,-4,0⟩\\times ⟨-4,0,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & \\,\\,-4 & 0 \\\\ -4 & 0 & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}0 & \\,\\,-4 \\\\ -4 & 0\\end{aligned}\\right|\\,k \\\\  & =-16\\,k \\\\ ‖{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4})‖ & =16\\end{aligned}\n$$\n\n  \n\nTherefore, the radius of the osculating circle at  $t=\\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}R(\\frac{\\pi }{4}) & =\\frac{{‖{r}^{′}(\\frac{\\pi }{4})‖}^{3}}{‖{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4})‖}=\\frac{{4}^{3}}{\\,16\\,}=4.\\end{aligned}\n$$" #edb/ref 17592186045417]}
