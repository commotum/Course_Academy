483 #edb/ref 17592186045417] [17592186179861 #edb/ref 1043 #edb/ref 17592186180484 #edb/ref 17592186045417] [17592186179861 #edb/ref 1043 #edb/ref 17592186180485 #edb/ref 17592186045417] [17592186179861 #edb/ref 1043 #edb/ref 17592186180486 #edb/ref 17592186045417] [17592186179861 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179861 #edb/ref 1045 "Properties of Line Integrals With Respect to X and Y" #edb/ref 17592186045417] [17592186179861 #edb/ref 1046 #edb/ref 17592186180479 #edb/ref 17592186045417] [17592186179861 #edb/ref 1049 #edb/ref 17592186050687 #edb/ref 17592186045417] [17592186179861 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186179861 #edb/ref 1053 #uuid "545f2edf-8d2f-583e-8ce1-05c1095b6170" #edb/ref 17592186045417] [17592186179999 #edb/ref 1068 #edb/ref 17592186259230 #edb/ref 17592186045417] [17592186179999 #edb/ref 1069 "q-124146" #edb/ref 17592186045417] [17592186179999 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186179999 #edb/ref 1071 "![](images/ac/ac639fb08d54d2004aec96708ffd19bc080b028e739075687a84a09158cd4fd2.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}x,$ where $C$ is the path along a semicircle of radius $2,$ traversed from the point $(2,1)$ to the point $(-2,1),$ shown above." #edb/ref 17592186045417] [17592186179999 #edb/ref 1072 #uuid "c2ecd409-704d-58f0-912b-02eaced8c539" #edb/ref 17592186045417] [17592186179999 #edb/ref 1074 "The line integral of unity with respect to $x$ along a path $C$ is equal to the net change in $x$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1},\n$$\n\nwhere ${x}_{2}$ is the $x$-coordinate of the terminal point, and ${x}_{1}$ is the $x$-coordinate of the initial point.\n\nIn our case, ${x}_{2}=-2$ and ${x}_{1}=2.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1}=(-2)-2=-4.\n$$" #edb/ref 17592186045417] [17592186180001 #edb/ref 1068 #edb/ref 17592186259322 #edb/ref 17592186045417] [17592186180001 #edb/ref 1069 "q-124148" #edb/ref 17592186045417] [17592186180001 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180001 #edb/ref 1071 "![](images/24/2400f92070b4f7d4e0ad0309574b729da86754bc64b6d7a3c508433d1bbc7f76.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the line segment between the points $(4,0)$ to the point $(0,3),$ as shown above." #edb/ref 17592186045417] [17592186180001 #edb/ref 1072 #uuid "46935a1e-c060-58a7-ab7d-a527906c3000" #edb/ref 17592186045417] [17592186180001 #edb/ref 1074 "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=3$ and ${y}_{1}=0.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=3-0=3.\n$$" #edb/ref 17592186045417] [17592186180003 #edb/ref 1068 #edb/ref 17592186415668 #edb/ref 17592186045417] [17592186180003 #edb/ref 1069 "q-124150" #edb/ref 17592186045417] [17592186180003 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186180003 #edb/ref 1071 "If ${\\int }_{C}f(x,y)\\,\\text{d}y=12$ and ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=8,$ calculate ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" #edb/ref 17592186045417] [17592186180003 #edb/ref 1072 #uuid "e3ca1583-0f44-5bd8-a174-1f7bba09e7fc" #edb/ref 17592186045417] [17592186180003 #edb/ref 1074 "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 12 & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 12 & =-8-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 20 & =-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=-20.\n$$" #edb/ref 17592186045417] [17592186180479 #edb/ref 1058 #edb/ref 17592186180483 #edb/ref 17592186045417] [17592186180479 #edb/ref 1061 35641 #edb/ref 17592186045417] [17592186180479 #edb/ref 1062 #uuid "e23b5a77-ead0-581f-bcc1-2f32ba803361" #edb/ref 17592186045417] [17592186180479 #edb/ref 1063 #edb/ref 17592186180713 #edb/ref 17592186045417] [17592186180480 #edb/ref 1058 #edb/ref 17592186180485 #edb/ref 17592186045417] [17592186180480 #edb/ref 1061 35654 #edb/ref 17592186045417] [17592186180480 #edb/ref 1062 #uuid "ba17887b-5323-555c-9d19-93a2e99bcb3d" #edb/ref 17592186045417] [17592186180480 #edb/ref 1063 #edb/ref 17592186179731 #edb/ref 17592186045417] [17592186180481 #edb/ref 1058 #edb/ref 17592186180484 #edb/ref 17592186045417] [17592186180481 #edb/ref 1061 35655 #edb/ref 17592186045417] [17592186180481 #edb/ref 1062 #uuid "97614692-6b8b-51e8-88ea-05390514a3cc" #edb/ref 17592186045417] [17592186180481 #edb/ref 1063 #edb/ref 17592186179732 #edb/ref 17592186045417] [17592186180482 #edb/ref 1058 #edb/ref 17592186180486 #edb/ref 17592186045417] [17592186180482 #edb/ref 1061 35660 #edb/ref 17592186045417] [17592186180482 #edb/ref 1062 #uuid "5792d95e-415c-55aa-9d58-b81c51e1404f" #edb/ref 17592186045417] [17592186180482 #edb/ref 1063 #edb/ref 17592186179733 #edb/ref 17592186045417] [17592186180483 #edb/ref 1058 #edb/ref 17592186180480 #edb/ref 17592186045417] [17592186180483 #edb/ref 1061 35673 #edb/ref 17592186045417] [17592186180483 #edb/ref 1062 #uuid "b7182be2-ddc6-5d8c-9367-0bf313338059" #edb/ref 17592186045417] [17592186180483 #edb/ref 1063 #edb/ref 17592186180714 #edb/ref 17592186045417] [17592186180484 #edb/ref 1058 #edb/ref 17592186180482 #edb/ref 17592186045417] [17592186180484 #edb/ref 1061 35674 #edb/ref 17592186045417] [17592186180484 #edb/ref 1062 #uuid "fb92124a-a40c-5b95-8acb-21f039c39f10" #edb/ref 17592186045417] [17592186180484 #edb/ref 1063 #edb/ref 17592186180715 #edb/ref 17592186045417] [17592186180485 #edb/ref 1058 #edb/ref 17592186180481 #edb/ref 17592186045417] [17592186180485 #edb/ref 1061 35675 #edb/ref 17592186045417] [17592186180485 #edb/ref 1062 #uuid "e5542a0f-35f9-5d2c-a937-679f3e3b6ef6" #edb/ref 17592186045417] [17592186180485 #edb/ref 1063 #edb/ref 17592186180716 #edb/ref 17592186045417] [17592186180486 #edb/ref 1061 35676 #edb/ref 17592186045417] [17592186180486 #edb/ref 1062 #uuid "a896d261-9315-51e1-80bb-4191a37e68b3" #edb/ref 17592186045417] [17592186180486 #edb/ref 1063 #edb/ref 17592186180717 #edb/ref 17592186045417] [17592186180713 #edb/ref 1064 "The line integral with respect to $x$ of the function $f(x,y)$ along the path $C$ can be calculated using the formula\n\n$$\n\\int_C f(x,y)\\,\\textrm d x = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\dfrac{\\text{d}x}{\\text{d}t} \\, \\textrm{d}t,\n$$\n\nwhere $\\mathbf r (t)$ for $a\\leq t\\leq b$ is a parametrization of $C.$ \n\nNow, if we set $f(x,y) = 1,$ then by the change of variables formula, we have\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}x & ={\\int }_{a}^{b}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{{x}_{1}}^{{x}_{2}}\\,\\text{d}x \\\\  & ={x}_{2}-{x}_{1},\\end{aligned}\n$$\n\nwhere $x_1$ and $x_2$ are the $x$-coordinates at the initial and terminal points of $C,$ respectively. To summarize,\n\n$$\n\\int_C \\,\\textrm d x = x_2 - x_1.\n$$\n\nLet's use this result to calculate $\\displaystyle\\int_C\\,\\textrm d x,$ where $C$ is the path along the quarter-circle of radius $2$ centered at $O$ in the first quadrant, traversed in the clockwise direction, as shown below:\n\n![](images/01/01b5f21b2c778f62f7dd884065ee4ce17dd01bd021063fc7c788f09a89feea86.png)\n\nThe initial point is $(0,2)$ and the terminal point is $(2,0).$ So, we have $x_1 = 0, x_2 = 2,$ and therefore,\n\n$$\n\\int_C \\,\\textrm d x = 2-0 = 2.\n$$" #edb/ref 17592186045417] [17592186180713 #edb/ref 1065 5814 #edb/ref 17592186045417] [17592186180713 #edb/ref 1066 #uuid "c57d3ca1-3c93-5d88-8e4f-5bee849ea14e" #edb/ref 17592186045417] [17592186180713 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180714 #edb/ref 1064 "In addition, we note the following regarding line integrals with respect to $x\\mathbin{:}$\n\n- If $C = C_1\\cup C_2$ is a piecewise-smooth curve, then\n\n$$\n\\int_C f(x,y)\\,\\textrm d x = \\int_{C_1} f(x,y)\\,\\textrm d x +  \\int_{C_2} f(x,y)\\,\\textrm d x.\n$$\n\n- When $C$ is a *closed* curve, we sometimes use the following notation:\n\n$$\n\\oint_C f(x,y)\\,\\textrm d x\n$$\n\n \nIf the curve is traversed once, the initial and terminal points are the same, so $x_1 = x_2.$ Therefore, for line integrals of unity with respect to $x,$ we have\n\n$$\n\\oint_C \\,\\textrm d x = 0.\n$$" #edb/ref 17592186045417] [17592186180714 #edb/ref 1065 5817 #edb/ref 17592186045417] [17592186180714 #edb/ref 1066 #uuid "7c1ae4ef-4256-598c-b44d-3421c8c4ebe1" #edb/ref 17592186045417] [17592186180714 #edb/ref 1067 "Some Remarks" #edb/ref 17592186045417] [17592186180715 #edb/ref 1064 "Earlier, we showed that\n\n$$\n\\int_{C}\\,\\textrm d x = 2,\n$$\n\nwhere $C$ is the path along the quarter-circle shown below.\n\n![](images/01/01b5f21b2c778f62f7dd884065ee4ce17dd01bd021063fc7c788f09a89feea86.png)\n\nIf we reverse the orientation of the curve, we get the following path:\n\n![](images/46/469675e85a6ca1d23de6da985d36e8e86c859ceff38ea6849984ea3c2cd34abe.png)\n\nThe initial and terminal points have swapped, and so we now have $x_1 = 2$ and $x_2 = 0.$ Applying our formula, we have\n\n$$\n\\begin{aligned}{\\int }_{-C}\\,\\text{d}x & ={x}_{2}-{x}_{1} \\\\  & =0-2 \\\\  & =-2.\\end{aligned}\n$$\n\nThis example illustrates an important property of line integrals with respect to $x,$ described in full as follows:\n\n*Let $C$ be a piecewise-smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. Then,*\n\n$$\n\\displaystyle\\int_{-C} f(x,y)\\,\\textrm d x = -\\int_{C} f(x,y)\\,\\textrm d x.\n$$\n\n*Similarly, *\n\n$$\n\\displaystyle\\int_{-C} f(x,y)\\,\\textrm d y = -\\int_{C} f(x,y)\\,\\textrm d y.\n$$\n\nIn other words, line integrals with respect to $x$ and $y$ are *dependent on orientation*. This is quite different from the case for line integrals with respect to arc length, which are independent of orientation." #edb/ref 17592186045417] [17592186180715 #edb/ref 1065 5818 #edb/ref 17592186045417] [17592186180715 #edb/ref 1066 #uuid "6fb52502-a498-5599-851c-64cf19d11bf3" #edb/ref 17592186045417] [17592186180715 #edb/ref 1067 "Further Properties of Line Integrals With Respect to X and Y" #edb/ref 17592186045417] [17592186180716 #edb/ref 1064 "Similar to line integrals of unity with respect to $x,$ the line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n\\int_C \\,\\textrm d y = y_2 - y_1,\n$$\n\nwhere $y_2$ is the $y$-coordinate of the terminal point, and $y_1$ is the $y$-coordinate of the initial point. \n\nAlso, if $C$ is a closed, positively oriented curve traversed once in the counterclockwise direction, then\n\n$$\n\\oint_C \\,\\textrm d y = 0.\n$$" #edb/ref 17592186045417] [17592186180716 #edb/ref 1065 5819 #edb/ref 17592186045417] [17592186180716 #edb/ref 1066 #uuid "16485104-9964-58c8-8611-2769190cbf9c" #edb/ref 17592186045417] [17592186180716 #edb/ref 1067 "Line Integrals of Unity With Respect to Y" #edb/ref 17592186045417] [17592186180717 #edb/ref 1064 "![](images/c2/c2ab6be66d91822186ee94c846f8cd1a247da776b89d7d9220b836193b9b04d3.png)\n\nConsider the path $C$ above. Earlier, we showed that\n\n$$\n\\int_{C}\\,\\textrm d x = 2,\n$$\n\nWe note the following:\n\n- In the context of our usual interpretation of line integrals with respect to $x,$ this result represents the total area accumulated when the function $z=1$ is projected onto the plane $y=0$ as $C$ is traversed from the initial point $(0,2)$ to the terminal point $(2,0).$ \n\n![](images/29/297e4e302b0cec7f4448ec7e8b36ab6c1f84d79d5f71aad1c6887d86d54dc328.png)\n\nFrom the diagram, we see that this projection generates a rectangle of length $x_2 - x_1 = 2$ and height $z=1.$ Since the integral of unity with respect to $x$ along $C$ is equal to the area of this rectangle, we have\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}x & =1\\cdot ({x}_{2}-{x}_{1}) \\\\  & ={x}_{2}-{x}_{1} \\\\  & =2.\\end{aligned}\n$$\n\nFurthermore, this result is *positive* because the rectangle is traced out in the direction of *increasing* $x.$\n\n- If we reverse the direction of the curve then we get a *negative* result. This is because the rectangle is traced out in the direction of *decreasing* $x,$ as shown below.\n\n![](images/17/179713734445f85818ef4e46cfa5948115cea936538acd3095cbfa706d381972.png)" #edb/ref 17592186045417] [17592186180717 #edb/ref 1065 5820 #edb/ref 17592186045417] [17592186180717 #edb/ref 1066 #uuid "1ba2d901-3b8c-5ce9-a7bd-ace7643f3277" #edb/ref 17592186045417] [17592186180717 #edb/ref 1067 "Intuition Behind Some of the Results" #edb/ref 17592186045417] [17592186256845 #edb/ref 1080 "Impossible to determine" #edb/ref 17592186045417] [17592186256845 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186256845 #edb/ref 1083 #uuid "075ffae1-ea68-5f4d-bb63-f49b56d8e6b0" #edb/ref 17592186045417] [17592186256900 #edb/ref 1080 "\\sqrt{13}" #edb/ref 17592186045417] [17592186256900 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186256900 #edb/ref 1083 #uuid "0c2ec8d6-1a05-588c-997f-14cc9bfb0ab8" #edb/ref 1759218604541