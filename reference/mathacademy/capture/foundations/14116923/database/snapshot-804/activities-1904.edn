#{[{:activity/first-step {:db/id #edb/ref 17592186125332} :activity/id #uuid "987e1e0c-bea1-5c9c-84ad-c50c09fe4abb" :activity/scope {:db/id #edb/ref 17592186049723 :topic/id #uuid "0e15397e-6c32-508c-b6ea-90f1a9e5a237" :topic/math-academy-id 1904} :activity/steps [{:db/id #edb/ref 17592186125332 :step/content {:db/id #edb/ref 17592186125757 :tutorial/content "The **pivots** of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nFor example, given the matrix \n\n$$\n[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 1 & 5 & 0 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nwhich is in row echelon form, let's find the pivots of $A.$\n\n- The first non-zero entry in the first row is the entry $a_{11}=1.$ So this is a pivot.\n\n- The first non-zero entry of the second row is $a_{22}=1.$ So this is also a pivot.\n\n- The first non-zero entry in the third row is $a_{34}=1.$ Therefore this is a pivot.\n\nThe pivots of $A$ are highlighted below.\n\n$$\n[\\begin{aligned}1 & 0 & -2 & 0 \\\\ 0 & 1 & 5 & 0 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nThe **pivot columns** of a matrix in row echelon form are simply the columns in which the pivots appear.\n\nFor our matrix $A$, we can see that the pivot columns are the $1$st, $2$nd, and $4$th columns.\n\nThe non-pivot columns are the columns that do not contain a pivot. So for the matrix $A,$ the only non-pivot column is the $3$rd column." :tutorial/id #uuid "feec6418-f447-5ee0-8c62-7d6b690f9228" :tutorial/math-academy-id 3157 :tutorial/title "Introduction"} :step/id #uuid "a9d24104-f86a-5d95-8475-56e2dbec3b1c" :step/math-academy-id 17200 :step/next {:db/id #edb/ref 17592186125333}} {:db/id #edb/ref 17592186125333 :step/content {:db/id #edb/ref 17592186124477 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124290 :question/id #uuid "ccfdc303-534f-530e-810b-f475a997f5d8" :question/math-academy-id "e-4703"} :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048980}] :knowledge-point/questions [{:db/id #edb/ref 17592186124903} {:db/id #edb/ref 17592186124909} {:db/id #edb/ref 17592186266016} {:db/id #edb/ref 17592186266017} {:db/id #edb/ref 17592186342028} {:db/id #edb/ref 17592186342030} {:db/id #edb/ref 17592186342031} {:db/id #edb/ref 17592186400520} {:db/id #edb/ref 17592186400527} {:db/id #edb/ref 17592186400534} {:db/id #edb/ref 17592186403661}] :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"} :step/id #uuid "791285ec-5594-542a-8408-63f1e171f030" :step/math-academy-id 17201 :step/next {:db/id #edb/ref 17592186125334}} {:db/id #edb/ref 17592186125334 :step/content {:db/id #edb/ref 17592186124478 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124291 :question/id #uuid "22a77802-4114-516f-a0e0-4cda2e069361" :question/math-academy-id "e-4704"} :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/questions [{:db/id #edb/ref 17592186124880} {:db/id #edb/ref 17592186124904} {:db/id #edb/ref 17592186266018} {:db/id #edb/ref 17592186266019} {:db/id #edb/ref 17592186266020} {:db/id #edb/ref 17592186266021} {:db/id #edb/ref 17592186342032} {:db/id #edb/ref 17592186342033} {:db/id #edb/ref 17592186342035} {:db/id #edb/ref 17592186364337} {:db/id #edb/ref 17592186393327} {:db/id #edb/ref 17592186400541} {:db/id #edb/ref 17592186400548} {:db/id #edb/ref 17592186403668}] :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"} :step/id #uuid "a8ae7cc9-0379-5556-914f-78c73a269672" :step/math-academy-id 17202 :step/next {:db/id #edb/ref 17592186125335}} {:db/id #edb/ref 17592186125335 :step/content {:db/id #edb/ref 17592186125758 :tutorial/content "To find the pivots and pivot columns of a general matrix, we first need to convert the matrix to row echelon form (REF).\n\n- The pivots of any matrix are the pivots of its row equivalent REF matrix.\n\n- The pivot columns of a matrix are the pivot columns of its row equivalent REF matrix.\n\nTo reduce a general $n\\times m$ matrix to row echelon form, we follow a similar procedure to the $2\\times 2$ and $3\\times 3$ cases, as we'll see in the next example." :tutorial/id #uuid "d45a4eba-96ce-5bef-92b7-b8f0d4cd8b72" :tutorial/math-academy-id 3158 :tutorial/title "Pivot Columns of a General Matrix"} :step/id #uuid "c86295bd-d79e-5f83-97d7-9a828e1b01e3" :step/math-academy-id 17203 :step/next {:db/id #edb/ref 17592186125336}} {:db/id #edb/ref 17592186125336 :step/content {:db/id #edb/ref 17592186124479 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124292 :question/id #uuid "6e4b2e85-86a8-5050-a60a-ae8d40453ad0" :question/math-academy-id "e-4705"} :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049120}] :knowledge-point/questions [{:db/id #edb/ref 17592186124884} {:db/id #edb/ref 17592186124885} {:db/id #edb/ref 17592186266022} {:db/id #edb/ref 17592186266023} {:db/id #edb/ref 17592186266024} {:db/id #edb/ref 17592186266025} {:db/id #edb/ref 17592186266026} {:db/id #edb/ref 17592186323676} {:db/id #edb/ref 17592186323677} {:db/id #edb/ref 17592186342037} {:db/id #edb/ref 17592186342040} {:db/id #edb/ref 17592186342041} {:db/id #edb/ref 17592186342043} {:db/id #edb/ref 17592186342044} {:db/id #edb/ref 17592186367331} {:db/id #edb/ref 17592186368482}] :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"} :step/id #uuid "3bd0dda5-f697-5c86-9873-bdf79b5a2e7e" :step/math-academy-id 17204 :step/next {:db/id #edb/ref 17592186125337}} {:db/id #edb/ref 17592186125337 :step/content {:db/id #edb/ref 17592186124480 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124293 :question/id #uuid "3ac076bd-5add-5c08-bb96-7b11c0a37d54" :question/math-academy-id "e-4706"} :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/questions [{:db/id #edb/ref 17592186124905} {:db/id #edb/ref 17592