#{[{:db/id #edb/ref 17592186323677 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6819e4-8455-5b92-950f-ef80d03e3a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321384} {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} {:answer/id #uuid "3c1f36d6-2f31-5193-baa9-352cb4ec2d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186321613} {:answer/id #uuid "e42fdf84-b6d0-5da0-bf66-8b251052d501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322934} {:answer/id #uuid "e52ea9bd-c2ff-5f62-8bce-c9950d05029d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322941}] :answer-field/correct {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} :answer-field/id #uuid "0d8d06a1-5f1a-5dd9-a91d-202d54fedda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f943d34-2384-5dae-913e-74d32b4a024f" :question/math-academy-id "q-35453" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & -3 & -6 & 4 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186124905 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf31528-154d-5036-a970-e4ca91cb017f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186122031} {:answer/id #uuid "f4bff001-041e-5115-9b97-148bb00b96ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186122032} {:answer/id #uuid "fbf6f178-c842-59d9-8c1b-5ab20341815e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186122033} {:answer/id #uuid "16e1a635-5c19-5397-afa3-0e47de57ad39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186122034} {:answer/id #uuid "4bbdc26f-36ff-5592-8fb6-fa05dd41633b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186122035}] :answer-field/id #uuid "2007f835-e416-5901-a4d8-dcb889a38634" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122030} {:answer-field/choices [{:answer/id #uuid "d902d5f9-286f-59ed-ad2f-a940f9d64e13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186402456} {:answer/id #uuid "59e21a65-e54b-529e-af01-45eee909fed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186402457} {:answer/id #uuid "9e3a2e7f-88af-59d2-b10b-0f6888607047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186402458} {:answer/id #uuid "5c862c29-b1f0-5ae3-9332-7d1761b0bb60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402459} {:answer/id #uuid "56592c5b-5ea8-5015-81bc-3667c1634320" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186402460}] :answer-field/correct {:answer/id #uuid "5c862c29-b1f0-5ae3-9332-7d1761b0bb60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402459} :answer-field/id #uuid "b7425100-9aef-51c1-8d0e-fb3c989d9fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c93d2ae4-7e7b-5500-9b27-fd939892ffa9" :question/math-academy-id "q-35732" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{4} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."}] [{:db/id #edb/ref 17592186402461 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e2cc6e3-e6bd-532d-8f1f-9b390c501b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186402463} {:answer/id #uuid "6fdb0769-e31b-5103-99f8-7c1edc831761" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186402464} {:answer/id #uuid "a11b1eb4-e2a7-524e-a084-458df3eaa259" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186402465} {:answer/id #uuid "fc893d60-072c-5dca-bf01-c98cdfe541a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186402466} {:answer/id #uuid "697bc745-dc44-59f7-92ec-a23865a1d921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402467}] :answer-field/correct {:answer/id #uuid "697bc745-dc44-59f7-92ec-a23865a1d921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402467} :answer-field/id #uuid "b29827dc-7c2e-5a8a-9cf8-9120c56fe561" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d0368b2-c48d-55b9-a038-5636deca9c98" :question/math-academy-id "q-35757" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 0\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 5 & 7 \\\\ 0 & 2 & 4 & 6 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."}] [{:db/id #edb/ref 17592186342043 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "470abe29-2542-5865-96c9-702c10206992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339757} {:answer/id #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339984} {:answer/id #uuid "7975c256-a582-594f-915f-ca709cab8f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340211} {:answer/id #uuid "c7ff069b-8d25-52fc-bb50-e97180724410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340899} {:answer/id #uuid "cc96cd99-7932-5285-85c2-b574ef3ae1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340939}] :answer-field/correct {:answer/id #uuid "600d14b0-e227-5cd2-baf1-b373cb377c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339984} :answer-field/id #uuid "8dfe9dc9-fee0-5440-81d7-9f98049c1f83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ddee6b4-1b01-50b9-84af-b697c22f2675" :question/math-academy-id "q-73633" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & 0 & 0 & 7 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}]}
