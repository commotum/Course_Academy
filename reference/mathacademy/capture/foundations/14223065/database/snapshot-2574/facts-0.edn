5417] [17592186133893 #edb/ref 1041 #edb/ref 17592186133709 #edb/ref 17592186045417] [17592186133893 #edb/ref 1042 #uuid "e9b45822-868e-51bb-b551-345739e9ca44" #edb/ref 17592186045417] [17592186133995 #edb/ref 1043 #edb/ref 17592186134851 #edb/ref 17592186045417] [17592186133995 #edb/ref 1043 #edb/ref 17592186134852 #edb/ref 17592186045417] [17592186133995 #edb/ref 1043 #edb/ref 17592186134853 #edb/ref 17592186045417] [17592186133995 #edb/ref 1043 #edb/ref 17592186134854 #edb/ref 17592186045417] [17592186133995 #edb/ref 1043 #edb/ref 17592186134855 #edb/ref 17592186045417] [17592186133995 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186133995 #edb/ref 1045 "Line Integrals With Respect to X and Y" #edb/ref 17592186045417] [17592186133995 #edb/ref 1046 #edb/ref 17592186134851 #edb/ref 17592186045417] [17592186133995 #edb/ref 1049 #edb/ref 17592186051000 #edb/ref 17592186045417] [17592186133995 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186133995 #edb/ref 1053 #uuid "cc83e826-b428-5261-8109-f36f4450dc4f" #edb/ref 17592186045417] [17592186134082 #edb/ref 1068 #edb/ref 17592186369252 #edb/ref 17592186045417] [17592186134082 #edb/ref 1069 "q-124120" #edb/ref 17592186045417] [17592186134082 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186134082 #edb/ref 1071 "![](images/f5/f531f2467284ef84e0af0758a8e8554f1e5f72ea08d30d0b80c83076fbe5d7a3.png)\n\nEvaluate ${\\int }_{C}(x+\\pi \\operatorname{cos}⁡\\pi y)\\,\\text{d}x,$ where $C$ is the path traversed along the line segment from the point $(1,0)$ to the point $(2,1),$ as shown above." #edb/ref 17592186045417] [17592186134082 #edb/ref 1072 #uuid "bdf2c9bf-2367-5618-ad0e-1a35e799a6f9" #edb/ref 17592186045417] [17592186134082 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\nThe curve $C$ is a line segment with endpoints $(1,0)$ and $(2,1).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(1+t(2-1)),\\,(0+t(1-0))⟩ \\\\  & =⟨1+t,\\,t⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+t)=1\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+\\pi \\operatorname{cos}⁡\\pi y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(1+t)+\\pi \\operatorname{cos}⁡\\pi t \\\\  & =1+t+\\pi \\operatorname{cos}⁡\\pi t.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(1+t+\\pi \\operatorname{cos}⁡\\pi t)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}1+t+\\pi \\operatorname{cos}⁡\\pi t\\,\\text{d}t \\\\  & ={[t+\\frac{{t}^{2}}{2}+\\operatorname{sin}⁡\\pi t]}_{0}^{1} \\\\  & =(1+\\frac{{1}^{2}}{2}+\\operatorname{sin}⁡\\pi )-(0+\\operatorname{sin}⁡0) \\\\  & =\\frac{3}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186134083 #edb/ref 1068 #edb/ref 17592186259142 #edb/ref 17592186045417] [17592186134083 #edb/ref 1069 "q-124121" #edb/ref 17592186045417] [17592186134083 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186134083 #edb/ref 1071 "![](images/36/36b985c811eb28d8220017c6b7407b3a104554d785dafdb35f17553c262bdc35.png)\n\nWhich of the following is equivalent to ${\\int }_{C}xy\\,\\text{d}y,$ where $C$ is the path along the line segment from the point $(-1,-2)$ to the point $(2,4),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨3t-1,\\,6t-2⟩.$*" #edb/ref 17592186045417] [17592186134083 #edb/ref 1072 #uuid "c9417c70-141e-5010-bf56-db9beb8a2e51" #edb/ref 17592186045417] [17592186134083 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a line segment with endpoints $(-1,-2)$ and $(2,4).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(-1+t(2-(-1))),\\,(-2+t(4-(-2)))⟩ \\\\  & =⟨3t-1,\\,6t-2⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6t-2)=6\\end{aligned}\n$$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3t-1)\\cdot (6t-2) \\\\  & =18{t}^{2}-12t+2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(18{t}^{2}-12t+2)\\cdot 6\\cdot \\text{d}t \\\\  & =12{\\int }_{0}^{1}(9{t}^{2}-6t+1)\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186134086 #edb/ref 1068 #edb/ref 17592186369279 #edb/ref 17592186045417] [17592186134086 #edb/ref 1069 "q-124283" #edb/ref 17592186045417] [17592186134086 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186134086 #edb/ref 1071 "![](images/f8/f83043b44a8ad9181e66de57357397deb49c4b0e79b5e6e16330305a58391148.png)\n\nWhich of the following is equivalent to ${\\int }_{C}xy\\,\\text{d}y,$ where $C$ is the path along a circle of radius $4,$ traversed from the point $(4,0)$ to the point $(-4,0),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186134086 #edb/ref 1072 #uuid "e1880828-25c5-5042-afdb-e835de5c511c" #edb/ref 17592186045417] [17592186134086 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $4$ centered at $O.$ It can be parameterized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\pi .\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(4\\operatorname{cos}⁡t)(4\\operatorname{sin}⁡t) \\\\  & =16\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{\\pi }f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }16\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot 4\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =64{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186134851 #edb/ref 1058 #edb/ref 17592186134852 #edb/ref 17592186045417] [17592186134851 #edb/ref 1061 35614 #edb/ref 17592186045417] [17592186134851 #edb/ref 1062 #uuid "4a502006-31bd-5b97-b374-0fc7fe27b6e6" #edb/ref 17592186045417] [17592186134851 #edb/ref 1063 #edb/ref 17592186135122 #edb/ref 17592186045417] [17592186134852 #edb/ref 1058 #edb/ref 17592186134855 #edb/ref 17592186045417] [17592186134852 #edb/ref 1061 35615 #edb/ref 17592186045417] [17592186134852 #edb/ref 1062 #uuid "836166ec-b6a4-5203-a460-a9fbed3d6962" #edb/ref 17592186045417] [17592186134852 #edb/ref 1063 #edb/ref 17592186133891 #edb/ref 17592186045417] [17592186134853 #edb/ref 1058 #edb/ref 17592186134854 #edb/ref 17592186045417] [17592186134853 #edb/ref 1061 35616 #edb/ref 17592186045417] [17592186134853 #edb/ref 1062 #uuid "3c7d4502-6f95-54db-ae3c-2f1adac21e09" #edb/ref 17592186045417] [17592186134853 #edb/ref 1063 #edb/ref 17592186133892 #edb/ref 17592186045417] [17592186134854 #edb/ref 1061 35642 #edb/ref 17592186045417] [17592186134854 #edb/ref 1062 #uuid "10fbb7b7-ba3c-5cff-a825-8a6c4e82bc79" #edb/ref 17592186045417] [17592186134854 #edb/ref 1063 #edb/ref 17592186133893 #edb/ref 17592186045417] [17592186134855 #edb/ref 1058 #edb/ref 17592186134853 #edb/ref 17592186045417] [17592186134855 #edb/ref 1061 35670 #edb/ref 17592186045417] [17592186134855 #edb/ref 1062 #uuid "452fc7d7-48f9-5478-a20c-0ad745c8bca0" #edb/ref 17592186045417] [17592186134855 #edb/ref 1063 #edb/ref 17592186135123 #edb/ref 17592186045417] [17592186135122 #edb/ref 1064 "Until now, we've been dealing with line integrals with respect to arc length. In this lesson, we will learn about other types of line integral. \n\nSuppose that $C$ is a path in the $xy$-plane with initial point $A$ and terminal point $B.$ The line integral of the function $f(x,y)$ **with respect to $\\boldsymbol x$** along the path $C$ is denoted\n\n$$\n\\int_C f(x,y)\\,\\textrm d x.\n$$\n\nTo understand what this integral represents, we imagine traversing $C$ from $A$ to $B.$ At each point $P$ that lies on $C,$ we project the point on $f$ that lies directly above $P$ onto the plane $y=0.$ Doing this for every point on $C$ traces out a curve. The line integral of $f$ with respect to $x$ gives the (signed) area bounded by this curve and the $x$-axis.\n\n![](images/62/62c07a36cbf79459021ee7be125536a8f9c1bc3c193a99eabfcd3fc851b8eb0c.png)\n\nTo calculate a line integral with respect to $x,$ we must first parameterize $C$ using a parameter $t\\in [a,b].$ Then, we apply the change of variables formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}x  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\dfrac{\\text{d}x}{\\text{d}t} \\, \\textrm{d}t.\n$$\n\n \n\nLet's take a look at a concrete example." #edb/ref 17592186045417] [17592186135122 #edb/ref 1065 5812 #edb/ref 17592186045417] [17592186135122 #edb/ref 1066 #uuid "2f1254b7-43b2-5b19-b5e9-cf33ff6cffe8" #edb/ref 17592186045417] [17592186135122 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135123 #edb/ref 1064 "The **line integral with respect to** $\\boldsymbol y$ of the function $f(x,y)$ along the path $C$ is denoted\n\n$$\n\\int_C f(x,y)\\,\\textrm d y.\n$$\n\nThis integral represents the total area accumulated when $f$ is projected on the plane $x=0$ as $C$ is traversed from the initial point $A$ to the terminal point $B.$ \n\n![](images/9c/9ccbabd17ff18511ed26e8098b2fad41104bbd921a32eb639ae1a74bcab6f94b.png)\n\nTo calculate a line integral with respect to $y,$ we must first parameterize $C$ using a parameter $t\\in [a,b].$ Then, we apply the change of variables formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}y  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\dfrac{\\text{d}y}{\\text{d}t} \\, \\textrm{d}t.\n$$" #edb/ref 17592186045417] [17592186135123 #edb/ref 1065 5816 #edb/ref 17592186045417] [17592186135123 #edb/ref 1066 #uuid "e58d5cab-69bb-507b-a225-b621efc9b93f" #edb/ref 17592186045417] [17592186135123 #edb/ref 1067 "Line Integrals With Respect to Y" #edb/ref 17592186045417] [17592186256802 #edb/ref 1080 "\\frac{10}{3}" #edb/ref 17592186045417] [17592186256802 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186256802 #edb/ref 1083 #uuid "021c19b6-a87f-59bb-986b-654c56b918a1" #edb/ref 17592186045417] [17592186256862 #edb/ref 1080 "12{\\int }_{0}^{1}({t}^{2}-6t+9)\\,\\text{d}t" #edb/ref 17592186045417] [17592186256862 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186256862 #edb/ref 1083 #uuid "091b6b7e-813c-5b73-865c-f669e169c171" #edb/ref 17592186045417] [17592186257507 #edb/ref 1080 "\\frac{1}{3}" #edb/ref 17592186045417] [17592186257507 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186257507 #edb/ref 1083 #uuid "54fdfd50-de07-5cfb-b6d6-270b66947185" #edb/ref 17592186045417] [17592186257567 #edb/ref 1080 "12{\\int }_{0}^{1}(9{t}^{2}-6t+1)\\,\\text{d}t" #edb/ref 17592186045417] [17592186257567 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186257567 #edb/ref 1083 #uuid "5a2d80f4-0dad-59e0-a83c-87ee7e93fd9a" #edb/ref 17592186045417] [17592186257723 #edb/ref 1080 "\\frac{13}{6}" #edb/ref 17592186045417] [17592186257723 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186257723 #edb/ref 1083 #uuid "6abe279c-1db9-56ef-99fe-6e272def1150" #edb/ref 17592186045417] [17592186258045 #edb/ref 1080 "18{\\int }_{0}^{1}({t}^{2}-6t+9)\\,\\text{d}t" #edb/ref 17592186045417] [17592186258045 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186258045 #edb/ref 1083 #uuid "8fb0bf06-323d-5f15-8bf3-af2b48419f63" #edb/ref 17592186045417] [17592186258505 #edb/ref 1080 "18{\\int }_{0}^{1}({t}^{2}+6t+9)\\,\\text{d}t" #edb/ref 17592186045417] [17592186258505 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186258505 #edb/ref 1083 #uuid "c51659c0-3351-506b-83b7-da83cb4dac4b" #edb/ref 17592186045417] [17592186258722 #edb/ref 1080 "\\frac{15}{4}" #edb/ref 17592186045417] [17592186258722 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186258722 #edb/ref 1083 #uuid "debdbff0-5139-5a2f-ac8e-84956824c0b1" #edb/ref 17592186045417] [17592186258938 #edb/ref 1080 "\\frac{3}{5}" #edb/ref 17592186045417] [17592186258938 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186258938 #edb/ref 1083 #uuid "f66ec332-aeec-5f7f-8bb0-93630c7f3749" #edb/ref 17592186045417] [17592186259025 #edb/ref 1080 "6{\\int }_{0}^{1}(9{t}^{2}-6t+1)\\,\\text{d}t" #edb/ref 17592186045417] [17592186259025 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186259025 #edb/ref 1083 #uuid "ff3799de-5093-52dd-b475-702c04f8913f" #edb/ref 17592186045417] [17592186259142 #edb/ref 1075 #edb/ref 17592186256862 #edb/ref 17592186045417] [17592186259142 #edb/ref 1075 #edb/ref 17592186257567 #edb/ref 17592186045417] [17592186259142 #edb/ref 1075 #edb/ref 17592186258045 #edb/ref 17592186045417] [17592186259142 #edb/ref 1075 #edb/ref 17592186258505 #edb/ref 17592186045417] [17592186259142 #edb/ref 1075 #edb/ref 17592186259025 #edb/ref 17592186045417] [17592186259142 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259142 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259142 #edb/ref 1078 #edb/ref 17592186257567 #edb/ref 17592186045417] [17592186259142 #edb/ref 1079 #uuid "3cc17d7b-1584-5ada-831d-f64a488b2cef" #edb/ref 17592186045417] [17592186259155 #edb/ref 1075 #edb/ref 17592186256802 #edb/ref 17592186045417] [17592186259155 #edb/ref 1075 #edb/ref 17592186257507 #edb/ref 17592186045417] [17592186259155 #edb/ref 1075 #edb/ref 17592186257723 #edb/ref 17592186045417] [17592186259155 #edb/ref 1075 #edb/ref 17592186258722 #edb/ref 17592186045417] [17592186259155 #edb/ref 1075 #edb/ref 17592186258938 #edb/ref 17592186045417] [17592186259155 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259155 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259155 #edb/ref 1078 #edb/ref 17592186257723 #edb/ref 17592186045417] [17592186259155 #edb/ref 1079 #uuid "4358961a-328e-53e0-ad60-06b7463ba396" #edb/ref 17592186045417] [17592186259605 #edb/ref 1068 #edb/ref 17592186259155 #edb/ref 17592186045417] [17592186259605 #edb/ref 1069 "q-124175" #edb/ref 17592186045417] [17592186259605 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259605 #edb/ref 1071 "![](images/ab/ab95b870025708090e40cbd7645072e8f4453cf50047b2a00036a30171c81994.png)\n\nEvaluate ${\\int }_{C}(\\sqrt{x-1}+y)\\,\\text{d}x,$ where $C$ is the path traversed along the line segment from the point $(1,2)$ to the point $(2,1),$ as shown above." #edb/ref 17592186045417] [17592186259605 #edb/ref 1072 #uuid "bd888ac9-9398-5cd7-abd9-7da37aaa7d68" #edb/ref 17592186045417] [17592186259605 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\nThe curve $C$ is a line segment with endpoints $(1,2)$ and $(2,1).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(1+t(2-1)),\\,(2+t(1-2))⟩ \\\\  & =⟨1+t,\\,2-t⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+t)=1\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\sqrt{x-1}+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\sqrt{(1+t)-1}+2-t \\\\  & =\\sqrt{t}-t+2.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(\\sqrt{t}-t+2)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{1/2}-t+2)\\,\\text{d}t \\\\  & ={[\\frac{2{t}^{3/2}}{3}-\\frac{{t}^{2}}{2}+2t]}_{0}^{1} \\\\  & =(\\frac{2}{3}-\\frac{1}{2}+2)-(0) \\\\  & =\\frac{13}{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369252 #edb/ref 1075 #edb/ref 17592186369253 #edb/ref 17592186045417] [17592186369252 #edb/ref 1075 #edb/ref 17592186369254 #edb/ref 17592186045417] [17592186369252 #edb/ref 1075 #edb/ref 17592186369255 #edb/ref 17592186045417] [17592186369252 #edb/ref 1075 #edb/ref 17592186369256 #edb/ref 17592186045417] [17592186369252 #edb/ref 1075 #edb/ref 17592186369257 #edb/ref 17592186045417] [17592186369252 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369252 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369252 #edb/ref 1078 #edb/ref 17592186369257 #edb/ref 17592186045417] [17592186369252 #edb/ref 1079 #uuid "29184995-008b-5dbe-af80-c01d22170858" #edb/ref 17592186045417] [17592186369253 #edb/ref 1080 "\\frac{5}{2}" #edb/ref 17592186045417] [17592186369253 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369253 #edb/ref 1083 #uuid "4f5c27e6-6d15-5543-baca-509a958d1428" #edb/ref 17592186045417] [17592186369254 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186369254 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369254 #edb/ref 1083 #uuid "81b4c97c-6573-5711-9cd1-f51a4a264e66" #edb/ref 17592186045417] [17592186369255 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186369255 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369255 #edb/ref 1083 #uuid "4b80e13c-c214-5a76-9bff-a55badcb706d" #edb/ref 17592186045417] [17592186369256 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186369256 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369256 #edb/ref 1083 #uuid "938debfc-b447-5b7c-a524-0c933d4da736" #edb/ref 17592186045417] [17592186369257 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186369257 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369257 #edb/ref 1083 #uuid "977e7ec8-5c46-57e8-b421-0c2f023be513" #edb/ref 17592186045417] [17592186369279 #edb/ref 1075 #edb/ref 17592186369280 #edb/ref 17592186045417] [17592186369279 #edb/ref 1075 #edb/ref 17592186369281 #edb/ref 17592186045417] [17592186369279 #edb/ref 1075 #edb/ref 17592186369282 #edb/ref 17592186045417] [17592186369279 #edb/ref 1075 #edb/ref 17592186369283 #edb/ref 17592186045417] [17592186369279 #edb/ref 1075 #edb/ref 17592186369284 #edb/ref 17592186045417] [17592186369279 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369279 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369279 #edb/ref 1078 #edb/ref 17592186369281 #edb/ref 17592186045417] [17592186369279 #edb/ref 1079 #uuid "11a352f7-9105-5249-b023-dd67c620d14d" #edb/ref 17592186045417] [17592186369280 #edb/ref 1080 "32{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369280 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369280 #edb/ref 1083 #uuid "4a01ac03-516d-5191-b62a-df55277746ed" #edb/ref 17592186045417] [17592186369281 #edb/ref 1080 "64{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369281 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369281 #edb/ref 1083 #uuid "ae2ea435-9b78-5237-b1de-d27c14d67721" #edb/ref 17592186045417] [17592186369282 #edb/ref 1080 "64{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369282 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369282 #edb/ref 1083 #uuid "340e5763-cb2f-5d3a-ab41-9e4aab2f5062" #edb/ref 17592186045417] [17592186369283 #edb/ref 1080 "16{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡t+{cos}^{2}⁡t)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369283 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369283 #edb/ref 1083 #uuid "12a066d8-58b4-511c-9cb2-861f5afc7e73" #edb/ref 17592186045417] [17592186369284 #edb/ref 1080 "4{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369284 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369284 #edb/ref 1083 #uuid "99c2fa33-7e84-5fa9-b445-20cdce34028b" #edb/ref 17592186045417] [17592186387498 #edb/ref 1068 #edb/ref 17592186387499 #edb/ref 17592186045417] [17592186387498 #edb/ref 1069 "q-124298" #edb/ref 17592186045417] [17592186387498 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186387498 #edb/ref 1071 "![](images/fd/fd1956c8291f1bcecd7d37082110861ed7265fa40f7f85cbc69221cfdc5bea2d.png)\n\nWhich of the following is equivalent to ${\\int }_{C}(3{x}^{2}+{y}^{2})\\,\\text{d}y,$ where $C$ is the path along the ellipse $16{x}^{2}+4{y}^{2}=64,$ traversed from the point $(-2,0)$ to the point $(2,0),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨2\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186387498 #edb/ref 1072 #uuid "9d9bcf07-4605-5aed-9b42-699d630fbd7b" #edb/ref 17592186045417] [17592186387498 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ can be parameterized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le 2\\pi .\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=3{x}^{2}+{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3(2\\operatorname{cos}⁡t)^{2}+(4\\operatorname{sin}⁡t)^{2} \\\\  & =12{cos}^{2}⁡t+16{sin}^{2}⁡t \\\\  & =4{sin}^{2}⁡t+12({sin}^{2}⁡t+{cos}^{2}⁡t) \\\\  & =4{sin}^{2}⁡t+12 \\\\  & =4({sin}^{2}⁡t+3).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{\\pi }^{2\\pi }f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }4({sin}^{2}⁡t+3)\\cdot 4\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =16{\\int }_{\\pi }^{2\\pi }({sin}^{2}⁡t+3)\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186387499 #edb/ref 1075 #edb/ref 17592186387500 #edb/ref 17592186045417] [17592186387499 #edb/ref 1075 #edb/ref 17592186387501 #edb/ref 17592186045417] [17592186387499 #edb/ref 1075 #edb/ref 17592186387502 #edb/ref 17592186045417] [17592186387499 #edb/ref 1075 #edb/ref 17592186387503 #edb/ref 17592186045417] [17592186387499 #edb/ref 1075 #edb/ref 17592186387504 #edb/ref 17592186045417] [17592186387499 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186387499 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186387499 #edb/ref 1078 #edb/ref 17592186387503 #edb/ref 17592186045417] [17592186387499 #edb/ref 1079 #uuid "164502c8-6757-5ba5-b73c-b45e5adc8b09" #edb/ref 17592186045417] [17592186387500 #edb/ref 1080 "16{\\int }_{\\pi }^{2\\pi }(3{sin}^{2}⁡t+1)\\operatorname{cos}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186387500 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387500 #edb/ref 1083 #uuid "8bf68642-1bc2-5ac7-9a05-766d932162e8" #edb/ref 17592186045417] [17592186387501 #edb/ref 