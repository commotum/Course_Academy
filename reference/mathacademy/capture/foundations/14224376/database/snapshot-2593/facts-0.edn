/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) has the following probability mass function:\n\n![](images/21/21bb1ed33c23f67b65a0c2337d7a34c17cd3e4f663b0b95737fff31bbafdf055.svg)\n\nIn particular, the probability of needing ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) tosses until we get heads is \n\n![](images/3c/3c965ff9951df068207847eb1c5eb105d486195f44f79adb654e43c8e50690c2.svg)" #edb/ref 17592186045417] [17592186158492 #edb/ref 1065 4527 #edb/ref 17592186045417] [17592186158492 #edb/ref 1066 #uuid "d8664a30-c69c-59c8-9e1f-c2e46333f9be" #edb/ref 17592186045417] [17592186158492 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186158494 #edb/ref 1064 "The shape of the graph of the geometric distribution depends on the value of $p.$ When $p$ is large, the probabilities are concentrated at small values of $x.$ When $p$ is smaller, the probabilities are more spread out.\n\n![](images/51/51c0438105701a9ef6a19c280dde7bdddf6ccb82bd1ab487d2fdaf902bcca534.png)" #edb/ref 17592186045417] [17592186158494 #edb/ref 1065 4535 #edb/ref 17592186045417] [17592186158494 #edb/ref 1066 #uuid "4ed7d42f-4e9c-5a46-9270-1af8549e921d" #edb/ref 17592186045417] [17592186158494 #edb/ref 1067 "The Graph of the Geometric Distribution" #edb/ref 17592186045417] [17592186539471 #edb/ref 1043 #edb/ref 17592186540122 #edb/ref 17592186045417] [17592186539471 #edb/ref 1043 #edb/ref 17592186540142 #edb/ref 17592186045417] [17592186539471 #edb/ref 1043 #edb/ref 17592186540144 #edb/ref 17592186045417] [17592186539471 #edb/ref 1043 #edb/ref 17592186540155 #edb/ref 17592186045417] [17592186539471 #edb/ref 1043 #edb/ref 17592186540169 #edb/ref 17592186045417] [17592186539471 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186539471 #edb/ref 1045 "Modeling With the Geometric Distribution" #edb/ref 17592186045417] [17592186539471 #edb/ref 1046 #edb/ref 17592186540144 #edb/ref 17592186045417] [17592186539471 #edb/re