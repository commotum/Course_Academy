#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186158168} :activity/id #uuid "4e86130c-1f86-5c43-8ce5-5c7ae15aaad2" :activity/scope {:db/id #edb/ref 17592186050305 :topic/id #uuid "3e79aaa0-2529-5780-914b-ea52f01a197f" :topic/math-academy-id 2839} :activity/steps [{:db/id #edb/ref 17592186158161 :step/content {:db/id #edb/ref 17592186157314 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157118 :question/id #uuid "f86e3e4f-53a7-5a77-a97a-e019ab8bc9aa" :question/math-academy-id "e-7500"} :knowledge-point/id #uuid "06c1ce9a-bad7-50d6-b6c7-a1423ccce4bb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050757}] :knowledge-point/questions [{:db/id #edb/ref 17592186157856} {:db/id #edb/ref 17592186157864} {:db/id #edb/ref 17592186265910} {:db/id #edb/ref 17592186265915} {:db/id #edb/ref 17592186265917} {:db/id #edb/ref 17592186265919} {:db/id #edb/ref 17592186354436} {:db/id #edb/ref 17592186491174} {:db/id #edb/ref 17592186491178} {:db/id #edb/ref 17592186491200} {:db/id #edb/ref 17592186491215}] :knowledge-point/title "Identifying Random Variables that Follow a Geometric Distribution"} :step/id #uuid "1fa58b97-b6b2-5edd-8734-614f560a7651" :step/math-academy-id 27844 :step/next {:db/id #edb/ref 17592186158162}} {:db/id #edb/ref 17592186158162 :step/content {:db/id #edb/ref 17592186157315 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157119 :question/id #uuid "e43bd196-6952-5cce-bc7b-7dccc06e3b57" :question/math-academy-id "e-7501"} :knowledge-point/id #uuid "88cf7c0e-8c1d-5a92-805f-0a81ee887546" :knowledge-point/questions [{:db/id #edb/ref 17592186157865} {:db/id #edb/ref 17592186157866} {:db/id #edb/ref 17592186265952} {:db/id #edb/ref 17592186292908} {:db/id #edb/ref 17592186305018} {:db/id #edb/ref 17592186305020} {:db/id #edb/ref 17592186491124} {:db/id #edb/ref 17592186491132} {:db/id #edb/ref 17592186491142} {:db/id #edb/ref 17592186491155} {:db/id #edb/ref 17592186491176} {:db/id #edb/ref 17592186540080}] :knowledge-point/title "Computing the Probability of a Geometric Random Variable at a Point"} :step/id #uuid "22e52493-867b-5374-829e-6bc8df9e2158" :step/math-academy-id 27845 :step/next {:db/id #edb/ref 17592186158163}} {:db/id #edb/ref 17592186158163 :step/content {:db/id #edb/ref 17592186157316 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157120 :question/id #uuid "04a21022-edc8-54c0-b5c9-232e600ac014" :question/math-academy-id "e-7502"} :knowledge-point/id #uuid "32cd0921-2ed0-5b05-985a-e1849e98da10" :knowledge-point/questions [{:db/id #edb/ref 17592186157867} {:db/id #edb/ref 17592186157868} {:db/id #edb/ref 17592186265976} {:db/id #edb/ref 17592186265977} {:db/id #edb/ref 17592186305023} {:db/id #edb/ref 17592186305024} {:db/id #edb/ref 17592186491134} {:db/id #edb/ref 17592186491138} {:db/id #edb/ref 17592186491139} {:db/id #edb/ref 17592186491161} {:db/id #edb/ref 17592186491197} {:db/id #edb/ref 17592186540073}] :knowledge-point/title "Computing the Probability of a Geometric Random Variable on a Bounded Interval"} :step/id #uuid "7a7fc129-73fd-5136-a99a-5948c4181281" :step/math-academy-id 27846 :step/next {:db/id #edb/ref 17592186158164}} {:db/id #edb/ref 17592186158164 :step/content {:db/id #edb/ref 17592186157317 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157121 :question/id #uuid "69ee8489-db49-5121-9a0a-34da81a02c22" :question/math-academy-id "e-7503"} :knowledge-point/id #uuid "42f47d95-9f20-5488-98c4-cb80278a7cf3" :knowledge-point/questions [{:db/id #edb/ref 17592186157869} {:db/id #edb/ref 17592186157870} {:db/id #edb/ref 17592186305025} {:db/id #edb/ref 17592186305026} {:db/id #edb/ref 17592186305027} {:db/id #edb/ref 17592186305028} {:db/id #edb/ref 17592186491148} {:db/id #edb/ref 17592186491209} {:db/id #edb/ref 17592186540087} {:db/id #edb/ref 17592186540104}] :knowledge-point/title "Computing the Probability of a Geometric Random Variable on an Unbounded Interval"} :step/id #uuid "23f94e12-bb19-5644-a2f6-54b67243d945" :step/math-academy-id 27847} {:db/id #edb/ref 17592186158168 :step/content {:db/id #edb/ref 17592186158492 :tutorial/content "A **geometric distribution** is a probability distribution that models the total number of independent Bernoulli trials until the first success occurs.\n\nIf ![](images/48/48c7b594e8628a17b991d4e65e7bee6ffe6680dd410f036cfae83154bbd55fc6.svg) is the probability of success on each experiment, then the number of experiments needed before the first success has the following probability mass function:\n\n![](images/c6/c64756e38cf4152fdbcd3c3cb3c99e6368b7ec2549f6ea96e6badedeb7607cd8.svg)\n\nIf a random variable ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) follows a geometric distribution with probability ![](images/f4/f43942df7283a860efbcb722d0d28b46eca1b4d2ffc58a91a1858e36b0947101.svg) then we write ![](images/d1/d196f25e129c7b7bb4bdfff7f0383f5fa79d352b82ca3a0d8634fe7a64e0dc8c.svg)\n\nFor example, suppose we repeatedly flip a coin until we get heads. Each flip of the coin is a binomial experiment, and the probability of success is ![](images/f9/f98838fb4a565f05ea528dffcab8dad9e199e52bb3a2dfe071d6e11955e9ceb6.svg)\n\nLet ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) be the number of flips needed in order to get heads. Then ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) has the following probability mass function:\n\n![](images/21/21bb1ed33c23f67b65a0c2337d7a34c17cd3e4f663b0b95737fff31bbafdf055.svg)\n\nIn particular, the probability of needing ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) tosses until we get heads is \n\n![](images/3c/3c965ff9951df068207847eb1c5eb105d486195f44f79adb654e43c8e50690c2.svg)" :tutorial/id #uuid "d8664a30-c69c-59c8-9e1f-c2e46333f9be" :tutorial/math-academy-id 4527 :tutorial/title "Introduction"} :step/id #uuid "6ff378f4-047d-5e9f-ba7d-3a98770af4f5" :step/math-academy-id 27852 :step/next {:db/id #edb/ref 17592186158171}} {:db/id #edb/ref 17592186158171 :step/content {:db/id #edb/ref 17592186158494 :tutorial/content "The shape of the graph of the geometric distribution depends on the value of $p.$ When $p$ is large, the probabilities are concentrated at small values of $x.$ When $p$ is smaller, the probabilities are more spread out.\n\n![](images/51/51c0438105701a9ef6a19c280dde7bdddf6ccb82bd1ab487d2fdaf902bcca534.png)" :tutorial/id #uuid "4ed7d42f-4e9c-5a46-9270-1af8549e921d" :tutorial/math-academy-id 4535 :tutorial/title "The Graph of the Geometric Distribution"} :step/id #uuid "b13c477a-3272-5b6f-bce5-91e1831d0674" :step/math-academy-id 27933 :step/next {:db/id #edb/ref 17592186158161}}] :activity/title "Modeling With the Geometric Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157494}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186540144} :activity/id #uuid "66c8dbdf-3c5b-559a-b97b-93f058b0fde3" :activity/scope {:db/id #edb/ref 17592186050305 :topic/id #uuid "3e79aaa0-2529-5780-914b-ea52f01a197f" :topic/math-academy-id 2839} :activity/steps [{:db/id #edb/ref 17592186540122 :step/content {:db/id #edb/ref 17592186540087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09471886-d6ef-5fda-b2ee-571efe3d7fd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5472" :db/id #edb/ref 17592186539497} {:answer/id #uuid "2c351f9d-e6dd-5545-9507-2a8c593f35e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4980" :db/id #edb/ref 17592186539561} {:answer/id #uuid "570a9d04-2464-5cc1-8a35-0e5260d61d27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5120" :db/id #edb/ref 17592186539628} {:answer/id #uuid "6bb6214c-874c-56eb-ac10-bd965a94ea7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4795" :db/id #edb/ref 17592186539658} {:answer/id #uuid "92ca3ed3-4800-5b9b-9a1e-c2593faee6b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.4096" :db/id #edb/ref 17592186539722}] :answer-field/correct {:db/id #edb/ref 17592186539722} :answer-field/id #uuid "f5a73d02-83b1-5576-b29f-c152341639c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540016}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bc079e51-1277-52af-9686-51765572e614" :question/math-academy-id "q-85898" :question/problem "A professional soccer team participates in a championship. On average, the team has a $20%$ chance of losing each game. What is the probability that the team plays at least $4$ games without losing (i.e., the first loss occurs after the $4$th game)?" :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of games played until they lose their first game. Since the chance of losing each game is $20%,$ the number of games played before the team loses can be modeled as a geometric random variable with a probability of success\n\n$$\np=20%=\\frac{20}{100}=0.2.\n$$\n\nSo, $X∼\\text{Geom}(0.2).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & =(1-0.2)^{x-1}(0.2) \\\\  & =(0.8)^{x-1}(0.2)\\end{aligned}\n$$\n\nTo compute $P(X>4),$ we will use the complement:\n\n$$\nP(X>4)=1-P(X\\le 4)\n$$\n\nComputing the probability of the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.8)^{1-1}(0.2)+(0.8)^{2-1}(0.2)+(0.8)^{3-1}(0.2)+(0.8)^{4-1}(0.2) \\\\  & =(0.2)+(0.8)(0.2)+(0.8)^{2}(0.2)+(0.8)^{3}(0.2) \\\\  & =[1+0.8+(0.8)^{2}+(0.8)^{3}](0.2) \\\\  & =0.5904.\\end{aligned}\n$$\n\nTherefore, the probability that the team will play at least $4$ games before their first loss\n\n$$\n\\begin{aligned}P(X>4) & =1-P(X\\le 4) \\\\  & =1-0.5904 \\\\  & =0.4096.\\end{aligned}\n$$"} :step/id #uuid "11a70fe3-9b0a-5634-8d0e-34e26561e654"} {:db/id #edb/ref 17592186540142 :step/content {:db/id #edb/ref 17592186540073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed681c4-3034-59aa-a498-ea702cbb65c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.512" :db/id #edb/ref 17592186539540} {:answer/id #uuid "2e6c7f4a-9255-55cc-ab48-64524d9d60bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.478" :db/id #edb/ref 17592186539566} {:answer/id #uuid "2f594278-070e-5cca-b2b4-69634d02b41b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.391" :db/id #edb/ref 17592186539568} {:answer/id #uuid "82348db0-740d-5037-8bfb-dd1638b0599c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.423" :db/id #edb/ref 17592186539694} {:answer/id #uuid "bb376c02-f849-5a37-bcfc-6f47602f5bc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.501" :db/id #edb/ref 17592186539803}] :answer-field/correct {:db/id #edb/ref 17592186539566} :answer-field/id #uuid "0d865ca2-a464-54ee-8571-e4cc8b40fa53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539925}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "934447c8-2b56-5fbe-8d1c-94052a2dad02" :question/math-academy-id "q-85889" :question/problem "A lottery decides that $3$ out of every $20$ lottery tickets will win a special prize. If a player wants to win a special prize, what is the probability of finding a prize before purchasing their $5$th ticket? Round your answer to $3$ decimal places." :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of tickets purchased until a special prize is found. On average, the chance of finding a special prize on a single ticket is \n\n$$\np=\\frac{3}{20}=0.15.\n$$\n\nSo, the number of tickets that the player should purchase before they find a special prize can be modeled as a geometric random variable with a probability of success $p=0.15.$\n\nSo, $X∼\\text{Geom}(0.15).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & =(1-0.15)^{x-1}(0.15) \\\\  & =(0.85)^{x-1}(0.15)\\end{aligned}\n$$\n\nTherefore, the probability of finding a special prize before the $5$th ticket is\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.85)^{1-1}(0.15)+(0.85)^{2-1}(0.15)+(0.85)^{3-1}(0.15)+(0.85)^{4-1}(0.15) \\\\  & =(0.15)+(0.85)(0.15)+(0.85)^{2}(0.15)+(0.85)^{3}(0.15) \\\\  & =[1+0.85+(0.85)^{2}+(0.85)^{3}](0.15) \\\\  & ≈0.478\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "5dbd1cdf-7537-5f2a-b30a-6dc52b03a1a2" :step/next {:db/id #edb/ref 17592186540169}} {:db/id #edb/ref 17592186540144 :step/content {:db/id #edb/ref 17592186157868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "986ab300-81b2-59eb-a0cd-62ba8d6c153b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.035" :db/id #edb/ref 17592186156130} {:answer/id #uuid "e87d6839-b3dc-5320-bed5-098444affde1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.132" :db/id #edb/ref 17592186156131} {:answer/id #uuid "ed5c021d-8d89-5701-95fa-2b18fa234975" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.078" :db/id #edb/ref 17592186156132} {:answer/id #uuid "15a992f6-84bc-5672-9e51-80d812a13f47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.159" :db/id #edb/ref 17592186156133} {:answer/id #uuid "2b95dd55-35e9-5aca-a0cb-2370b157a2a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.097" :db/id #edb/ref 17592186156134}] :answer-field/correct {:db/id #edb/ref 17592186156132} :answer-field/id #uuid "433b26e7-cbdf-5a51-bc6c-19eb63ac7ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186156129}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1c241a6a-1a9e-5d8e-adf5-2fd9b0826eb3" :question/math-academy-id "q-85277" :question/problem "At a water bottle factory, every batch of $1\\,000$ water bottles has $20$ water bottles (on average) on which the label is upside down. If an inspector comes to inspect the water bottles, what is the probability that they will find an upside down label before checking the $5$th bottle? Round your answer to $3$ decimal places." :question/requires-calculator true :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of bottles checked until a defect is found. On average, the chance of finding an upside down label on any water bottle is \n\n$$\np=\\frac{20}{1\\,000}=0.02.\n$$\n\nSo, the number of bottles that the inspector checks before finding an upside down label can be modeled as a geometric random variable with a probability of success $p=0.02.$\n\nSo, $X∼\\text{Geom}(0.02).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & =(1-0.02)^{x-1}(0.02) \\\\  & =(0.98)^{x-1}(0.02)\\end{aligned}\n$$\n\nTherefore, the probability of finding an upside down label before checking the $5$th bottle is\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.98)^{1-1}(0.02)+(0.98)^{2-1}(0.02)+(0.98)^{3-1}(0.02)+(0.98)^{4-1}(0.02) \\\\  & =(0.02)+(0.98)(0.02)+(0.98)^{2}(0.02)+(0.98)^{3}(0.02) \\\\  & =[1+0.98+(0.98)^{2}+(0.98)^{3}](0.02) \\\\  & ≈0.078\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "689fdd30-f221-5416-a743-4ed6517268b3" :step/next {:db/id #edb/ref 17592186540155}} {:db/id #edb/ref 17592186540155 :step/content {:db/id #edb/ref 17592186540080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a40095-28ea-5b29-9f46-5d1722a2dc00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.095" :db/id #edb/ref 17592186539584} {:answer/id #uuid "4ecdbb4d-cd29-5c6c-8d54-821afb7fd664" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.160" :db/id #edb/ref 17592186539619} {:answer/id #uuid "511ee1e7-4a2e-5ac2-b693-bbdf3c003f14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.098" :db/id #edb/ref 17592186539621} {:answer/id #uuid "bd14f852-afc2-5508-a508-f915bcd1125c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.112" :db/id #edb/ref 17592186539806} {:answer/id #uuid "c19ac48b-f028-591b-b391-957b90b26cb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.125" :db/id #edb/ref 17592186539813}] :answer-field/correct {:db/id #edb/ref 17592186539813} :answer-field/id #uuid "02f2874f-c8cb-5424-9558-d25dbc1321ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539918}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "adc9ba22-54ae-50d6-b1c5-428a57977aea" :question/math-academy-id "q-85881" :question/problem "An experiment consists of tossing a fair coin until it comes up heads. What is the probability that we get our first head on the $3$rd toss? Round your answer to $3$ decimal places." :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of times the coin is tossed until it comes up heads. Since the chance of getting a head in every toss is $50%,$ the number of tosses until it comes up heads can be modeled as a geometric random variable with a probability of success\n\n$$\np=50%=\\frac{50}{100}=0.5.\n$$\n\nSo, $X∼\\text{Geom}(0.5).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & =(1-0.5)^{x-1}(0.5) \\\\  & =(0.5)^{x-1}(0.5)\\end{aligned}\n$$\n\nTherefore, the probability that head appears in the $3$rd toss is \n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & =(0.5)^{3-1}(0.5) \\\\  & =(0.5)^{2}(0.5) \\\\  & ≈0.125\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "8eb6ad6a-8dea-571b-b04b-4da7ec78d1ae" :step/next {:db/id #edb/ref 17592186540142}} {:db/id #edb/ref 17592186540169 :step/content {:db/id #edb/ref 17592186540104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d7504b-2828-5ed4-ab73-97d26b31abe0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.34" :db/id #edb/ref 17592186539513} {:answer/id #uuid "79e93ad4-10ea-55a5-b833-af0a652dd041" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.62" :db/id #edb/ref 17592186539683} {:answer/id #uuid "923cac8c-34f5-5ea2-bb76-7bdba561dd9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.49" :db/id #edb/ref 17592186539721} {:answer/id #uuid "ab51231a-c4b2-5897-b2e4-e89b02c56f79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.38" :db/id #edb/ref 17592186539768} {:answer/id #uuid "b141e339-58d5-542d-a915-4a9424c25f13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.59" :db/id #edb/ref 17592186539780}] :answer-field/correct {:db/id #edb/ref 17592186539721} :answer-field/id #uuid "e64d04fb-cb14-517f-be04-f2bf97158deb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e49d61e7-549c-5568-9bc1-1e99e4e1790c" :question/math-academy-id "q-85897" :question/problem "In a town, blood tests are being carried out on all inhabitants to determine whether they have caught a virus. On average, $30%$ of the inhabitants test positive for the virus. What is the probability that the first positive test result will be made on the $3$rd test or later?" :question/worked-solution "A geometric random variable $X$ with probability of success $p$ has the following probability mass function:\n\n$$\nf(x)=(1-p)^{x-1}p\n$$\n\nLet $X$ be the number of inhabitants checked until the first infected patient is found. Since the chance of a single patient being infected is $30%,$ the number of inhabitants checked until the first infected patient is found can be modeled as a geometric random variable with a probability of success\n\n$$\np=30%=\\frac{30}{100}=0.3.\n$$\n\nSo, $X∼\\text{Geom}(0.3).$ In this case, $X$ has the following probability mass function:\n\n$$\n\\begin{aligned}f(x) & =(1-0.3)^{x-1}(0.3) \\\\  & =(0.7)^{x-1}(0.3)\\end{aligned}\n$$\n\nTo compute $P(X\\ge 3),$ we will use the complement:\n\n$$\nP(X\\ge 3)=1-P(X<3)\n$$\n\nComputing the probability of the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(0.7)^{1-1}(0.3)+(0.7)^{2-1}(0.3) \\\\  & =(0.3)+(0.7)(0.3) \\\\  & =[1+0.7](0.3) \\\\  & =0.51.\\end{aligned}\n$$\n\nTherefore, the probability of finding the first positive patient on the $3$rd test or later is\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & =1-0.51 \\\\  & =0.49.\\end{aligned}\n$$"} :step/id #uuid "d779f666-116f-5872-bbc1-9263cc0c06b4" :step/next {:db/id #edb/ref 17592186540122}}] :activity/title "Modeling With the Geometric Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539471}]}
