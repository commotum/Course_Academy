e "Computing the Probability of a Geometric Random Variable at a Point"} :step/id #uuid "22e52493-867b-5374-829e-6bc8df9e2158" :step/math-academy-id 27845 :step/next {:db/id #edb/ref 17592186158163}} {:db/id #edb/ref 17592186158163 :step/content {:db/id #edb/ref 17592186157316 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157120 :question/id #uuid "04a21022-edc8-54c0-b5c9-232e600ac014" :question/math-academy-id "e-7502"} :knowledge-point/id #uuid "32cd0921-2ed0-5b05-985a-e1849e98da10" :knowledge-point/questions [{:db/id #edb/ref 17592186157867} {:db/id #edb/ref 17592186157868} {:db/id #edb/ref 17592186265976} {:db/id #edb/ref 17592186265977} {:db/id #edb/ref 17592186305023} {:db/id #edb/ref 17592186305024} {:db/id #edb/ref 17592186491134} {:db/id #edb/ref 17592186491138} {:db/id #edb/ref 17592186491139} {:db/id #edb/ref 17592186491161} {:db/id #edb/ref 17592186491197}] :knowledge-point/title "Computing the Probability of a Geometric Random Variable on a Bounded Interval"} :step/id #uuid "7a7fc129-73fd-5136-a99a-5948c4181281" :step/math-academy-id 27846 :step/next {:db/id #edb/ref 17592186158164}} {:db/id #edb/ref 17592186158164 :step/content {:db/id #edb/ref 17592186157317 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157121 :question/id #uuid "69ee8489-db49-5121-9a0a-34da81a02c22" :question/math-academy-id "e-7503"} :knowledge-point/id #uuid "42f47d95-9f20-5488-98c4-cb80278a7cf3" :knowledge-point/questions [{:db/id #edb/ref 17592186157869} {:db/id #edb/ref 17592186157870} {:db/id #edb/ref 17592186305025} {:db/id #edb/ref 17592186305026} {:db/id #edb/ref 17592186305027} {:db/id #edb/ref 17592186305028} {:db/id #edb/ref 17592186491148} {:db/id #edb/ref 17592186491209}] :knowledge-point/title "Computing the Probability of a Geometric Random Variable on an Unbounded Interval"} :step/id #uuid "23f94e12-bb19-5644-a2f6-54b67243d945" :step/math-academy-id 27847} {:db/id #edb/ref 17592186158168 :step/content {:db/id #edb/ref 17592186158492 :tutorial/content "A **geometric distribution** is a probability distribution that models the total number of independent Bernoulli trials until the first success occurs.\n\nIf ![](images/48/48c7b594e8628a17b991d4e65e7bee6ffe6680dd410f036cfae83154bbd55fc6.svg) is the probability of success on each experiment, then the number of experiments needed before the first success has the following probability mass function:\n\n![](images/c6/c64756e38cf4152fdbcd3c3cb3c99e6368b7ec2549f6ea96e6badedeb7607cd8.svg)\n\nIf a random variable ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) follows a geometric distribution with probability ![](images/f4/f43942df7283a860efbcb722d0d28b46eca1b4d2ffc58a91a1858e36b0947101.svg) then we write ![](images/d1/d196f25e129c7b7bb4bdfff7f0383f5fa79d352b82ca3a0d8634fe7a64e0dc8c.svg)\n\nFor example, suppose we repeatedly flip a coin until we get heads. Each flip of the coin is a binomial experiment, and the probability of success is ![](images/f9/f98838fb4a565f05ea528dffcab8dad9e199e52bb3a2dfe071d6e11955e9ceb6.svg)\n\nLet ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) be the number of flips needed in order to get heads. Then ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) has the following probability mass function:\n\n![](images/21/21bb1ed33c23f67b65a0c2337d7a34c17cd3e4f663b0b95737fff31bbafdf055.svg)\n\nIn particular, the probability of needing ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) tosses until we get heads is \n\n![](images/3c/3c965ff9951df068207847eb1c5eb105d486195f44f79adb654e43c8e50690c2.svg)" :tutorial/id #uuid "d8664a30-c69c-59c8-9e1f-c2e46333f9be" :tutorial/math-academy-id 4527 :tutorial/title "Introduction"} :step/id #uuid "6ff378f4-047d-5e9f-ba7d-3a98770af4f5" :step/math-academy-id 27852 :step/next {:db/id #edb/ref 17592186158171}} {:db/id #edb/ref 17592186158171 :step/content {:db/id #edb/ref 17592186158494 :tutorial/content "The shape of the graph of the geometric distribution depends on the value of $p.$ When $p$ is large, the probabilities are concentrated at small values of $x.$ When $p$ is smaller, the probabilities are more spread out.\n\n![](images/51/51c0438105701a9ef6a19c280dde7bdddf6ccb82bd1ab487d2fdaf902bcca534.png)" :tutorial/id #uuid "4ed7d42f-4e9c-5a46-9270-1af8549e921d" :tutorial/math-academy-id 4535 :tutorial/title "The Graph of the Geometric Distribution"} :step/id #uuid "b13c477a-3272-5b6f-bce5-91e1831d0674" :step/math-academy-id 27933 :step/next {:db/id #edb/ref 17592186158161}}] :activity/title "Modeling With the Geometric Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157494}]}
