ign=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$40x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$39$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n</tbody></table>\n\nTherefore, we can write ${x}^{4}$ as \n\n$$\n\\begin{aligned}{x}^{4} & =q(x)p(x)+(-40x-39),\\end{aligned}\n$$\n\nwhere $q(x)={x}^{2}-4x+13.$  Replacing $x$ with $A,$ we have\n\n$$\n{A}^{4}=q(A)p(A)+(-40A-39I).\n$$\n\nNow, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}{A}^{4} & =q(A)p(A)+(-40A-39I) \\\\  & =q(A)\\cdot O+(-40A-39I) \\\\  & =-40A-39I.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186125106 :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda ):$\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =|\\begin{aligned}3-\\lambda  & -2 \\\\ 4 & -3-\\lambda \\end{aligned}| \\\\  & =(3-\\lambda )(-3-\\lambda )+8 \\\\  & ={\\lambda }^{2}-1\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" height=\"20\" width=\"20\">$\\,\\,{x}^{20}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}-1\\,$</td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{22}\\,-\\,{x}^{20}\\,+\\,3x\\,-\\,2\\phantom{|}}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{22}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{20}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$3x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$2$</td>\n</tr>\n</tbody></table>\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(3x-2)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{20}.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(3A-2I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(3A-2I) \\\\  & =q(A)\\cdot O+(3A-2I) \\\\  & =3A-2I \\\\  & =3[\\begin{aligned}3 & -2 \\\\ 4 & -3\\end{aligned}]-2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}9 & -6 \\\\ 12 & -9\\end{aligned}]-[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -6 \\\\ 12 & -11\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186354448 :question/worked-solution "First, let's divide the polynomial $f(x)={x}^{3}$ by characteristic polynomial $p(x)={x}^{2}-x-20,$ using long division:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" height=\"20\" width=\"20\">$\\,\\,x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}-x-20\\,$</td>\n<td align=\"left\" colspan=\"9\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{3}\\phantom{|}\\,\\,}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$20x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$20x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$20$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$21x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$20$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n</tbody></table>\n\nTherefore, we can write ${x}^{3}$ as \n\n$$\n\\begin{aligned}{x}^{3} & =q(x)p(x)+(21x+20),\\end{aligned}\n$$\n\nwhere $q(x)=x+1.$  Replacing $x$ with $A,$ we have\n\n$$\n{A}^{3}=q(A)p(A)+(21A+20I).\n$$\n\nNow, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}{A}^{3} & =q(A)p(A)+(21A+20I) \\\\  & =q(A)\\cdot O+(21A+20I) \\\\  & =21A+20I.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
