padding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" height=\"20\" width=\"20\">$\\,\\,{x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}+x-2\\,$</td>\n<td align=\"left\" colspan=\"9\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{4}\\phantom{|}\\,\\,\\,}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{4}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$2{x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$2{x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{3}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$2x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$3{x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$2x$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$3{x}^{2}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$3x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$5x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$+$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n</tbody></table>\n\nTherefore, we can write ${x}^{4}$ as \n\n$$\n\\begin{aligned}{x}^{4} & =q(x)p(x)+(-5x+6),\\end{aligned}\n$$\n\nwhere $q(x)={x}^{2}-x+3.$  Replacing $x$ with $A,$ we have\n\n$$\n{A}^{4}=q(A)p(A)+(-5A+6I).\n$$\n\nNow, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}{A}^{4} & =q(A)p(A)+(-5A+6I) \\\\  & =q(A)\\cdot O+(-5A+6I) \\\\  & =-5A+6I.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323939 :knowledge-point/_questions [{:db/id #edb/ref 17592186124538 :knowledge-point/id #uuid "787173e1-f957-5ff0-9d14-a6ccb11de1d8" :knowledge-point/title "Evaluating a Matrix Polynomial Using the Cayley-Hamilton Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c52bd4-76d8-5cfe-8125-60f3edd92a1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-A-3I" :db/id #edb/ref 17592186321522} {:answer/id #uuid "5df2621e-e2bc-593f-bda1-8c039e99ab00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-39A-40I" :db/id #edb/ref 17592186321889} {:answer/id #uuid "61c84397-8ec0-5980-a5c0-eda0d794047