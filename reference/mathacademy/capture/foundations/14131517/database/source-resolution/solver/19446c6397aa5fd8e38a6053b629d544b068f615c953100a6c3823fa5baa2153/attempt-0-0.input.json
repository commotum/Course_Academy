"center\">$2{x}^{2}$</td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\">$-$</td>\n<td width=\"20\" height=\"20\" align=\"center\">${x}^{3}$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$-$</td>\n<td width=\"20\" height=\"20\" align=\"center\">${x}^{2}$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$+$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$2x$</td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\">$3{x}^{2}$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$-$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$2x$</td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\">$3{x}^{2}$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$+$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$3x$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$-$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$6$</td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\">$-$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$5x$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$+$</td>\n<td width=\"20\" height=\"20\" align=\"center\">$6$</td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n<td width=\"20\" height=\"20\" align=\"center\"></td>\n</tr>\n\n</tbody></table>\n\nTherefore, we can write ${x}^{4}$ as \n\n$$\n\\begin{aligned}{x}^{4} & =q(x)p(x)+(-5x+6),\\end{aligned}\n$$\n\nwhere $q(x)={x}^{2}-x+3.$  Replacing $x$ with $A,$ we have\n\n$$\n{A}^{4}=q(A)p(A)+(-5A+6I).\n$$\n\nNow, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}{A}^{4} & =q(A)p(A)+(-5A+6I) \\\\  & =q(A)\\cdot O+(-5A+6I) \\\\  & =-5A+6I.\\end{aligned}\n$$",
