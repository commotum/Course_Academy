 & 3 \\\\ -3 & 1\\end{aligned}]$" #edb/ref 17592186045417] [17592186555316 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555316 #edb/ref 1083 #uuid "87b92cc8-999d-5cf3-bf8b-bdd8e08a2989" #edb/ref 17592186045417] [17592186555318 #edb/ref 1080 "$D=[\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}]$\nand\n$P=[\\begin{aligned}\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186555318 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555318 #edb/ref 1083 #uuid "88323906-807d-5c80-975d-3c3a60ac5954" #edb/ref 17592186045417] [17592186555395 #edb/ref 1080 "$D=[\\begin{aligned}5 & 0 \\\\ 0 & 10\\end{aligned}]$\nand\n$P=[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]$" #edb/ref 17592186045417] [17592186555395 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555395 #edb/ref 1083 #uuid "a5853336-65bd-51a4-8d09-1814205711bd" #edb/ref 17592186045417] [17592186555398 #edb/ref 1080 "$D=[\\begin{aligned}9 & 0 \\\\ 0 & -8\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186555398 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555398 #edb/ref 1083 #uuid "a706c372-7bf9-519b-bf47-eec640055a09" #edb/ref 17592186045417] [17592186555463 #edb/ref 1080 "$D=[\\begin{aligned}9 & 0 \\\\ 0 & -8\\end{aligned}]$ and $P=[\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}]$" #edb/ref 17592186045417] [17592186555463 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555463 #edb/ref 1083 #uuid "c0eaea37-d763-51e1-b779-86ad5cab32fb" #edb/ref 17592186045417] [17592186555478 #edb/ref 1080 "$D=[\\begin{aligned}5 & 0 \\\\ 0 & 10\\end{aligned}]$\nand\n$P=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186555478 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555478 #edb/ref 1083 #uuid "c5ca4907-7b6a-5cd0-ad7e-2e9a14158a1b" #edb/ref 17592186045417] [17592186555507 #edb/ref 1080 "$D=[\\begin{aligned}7 & 0 \\\\ 0 & -8\\end{aligned}]$ and $P=[\\begin{aligned}-4 & 1 \\\\ 1 & 4\\end{aligned}]$" #edb/ref 17592186045417] [17592186555507 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555507 #edb/ref 1083 #uuid "d5816e57-b424-539b-bcae-e9c26275321d" #edb/ref 17592186045417] [17592186555612 #edb/ref 1080 "$D=[\\begin{aligned}9 & 0 \\\\ 0 & -5\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186555612 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555612 #edb/ref 1083 #uuid "f73191f0-64c8-52a9-bb54-a9dff6856396" #edb/ref 17592186045417] [17592186555627 #edb/ref 1080 "$D=[\\begin{aligned}9 & 0 \\\\ 0 & -8\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{aligned}]$" #edb/ref 17592186045417] [17592186555627 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186555627 #edb/ref 1083 #uuid "fc03ffd9-3aab-5745-80b2-933e00a5c3a9" #edb/ref 17592186045417] [17592186555685 #edb/ref 1075 #edb/ref 17592186555398 #edb/ref 17592186045417] [17592186555685 #edb/ref 1075 #edb/ref 17592186555463 #edb/ref 17592186045417] [17592186555685 #edb/ref 1075 #edb/ref 17592186555507 #edb/ref 17592186045417] [17592186555685 #edb/ref 1075 #edb/ref 17592186555612 #edb/ref 17592186045417] [17592186555685 #edb/ref 1075 #edb/ref 17592186555627 #edb/ref 17592186045417] [17592186555685 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186555685 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186555685 #edb/ref 1078 #edb/ref 17592186555627 #edb/ref 17592186045417] [17592186555685 #edb/ref 1079 #uuid "6125238e-cd95-58be-8f9d-65d56d196e45" #edb/ref 17592186045417] [17592186555870 #edb/ref 1068 #edb/ref 17592186555685 #edb/ref 17592186045417] [17592186555870 #edb/ref 1069 "q-94051" #edb/ref 17592186045417] [17592186555870 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186555870 #edb/ref 1071 "$$\nA=[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]\n$$\n\nThe matrix $A$ above has eigenvalues ${\\lambda }_{1}=9$ and ${\\lambda }_{2}=-8.$ Find a diagonal matrix $D$ and an orthogonal matrix $P$ such that $D={P}^{T}\\,AP.$" #edb/ref 17592186045417] [17592186555870 #edb/ref 1072 #uuid "f4374452-85e0-5d4e-85af-02cf21a24ee9" #edb/ref 17592186045417] [17592186555870 #edb/ref 1074 "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nNote that $A$ is symmetric. Therefore, it is orthogonally diagonalizable. Let's now go through the process.\n\n**Step 1.**  Notice that we already have the eigenvalues of $A:$\n\n$\\,$ ${\\lambda }_{1}=9\\,$ and $\\,{\\lambda }_{2}=-8$\n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=9,$ we have\n\n$$\n\\begin{aligned}A-9I & =[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]-9[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -4 \\\\ -4 & -16\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-8I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}-4 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{17},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{4}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=-8,$ we have\n\n$$\n\\begin{aligned}A-(-8)I & =[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]+8[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}16 & -4 \\\\ -4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-8)I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{17},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]=[\\begin{aligned}\\frac{1}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}}\\end{aligned}].\n$$\n\n**Step 3.** We construct the diagonal matrix $D$ and the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}9 & 0 \\\\ 0 & -8\\end{aligned}],\\,P=[\\begin{aligned}-\\frac{4}{\\sqrt{17}} & \\frac{1}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}} & \\frac{4}{\\sqrt{17}}\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186555883 #edb/ref 1058 #edb/ref 17592186555908 #edb/ref 17592186045417] [17592186555883 #edb/ref 1062 #uuid "157496fd-75d6-56b5-bfa4-94bcbd0776e1" #edb/ref 17592186045417] [17592186555883 #edb/ref 1063 #edb/ref 17592186492002 #edb/ref 17592186045417]}
