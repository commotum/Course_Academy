      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234548/observations/step-q94024-c15fa5be3600f863f760.png",
      "source_url": "https://mathacademy.com/tasks/14234548/topics/3335/review",
