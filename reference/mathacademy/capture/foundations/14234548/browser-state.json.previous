      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234548/observations/step-q93602-8a9ecaedba5ddd7711d9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234548/observations/step-q93602-8a9ecaedba5ddd7711d9.png",
      "source_url": "https://mathacademy.com/tasks/14234548/topics/3335/review",
