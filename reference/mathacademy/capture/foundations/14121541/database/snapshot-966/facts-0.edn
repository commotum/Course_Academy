6045417] [17592186124710 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124710 #edb/ref 1045 "Changing a Basis Using the Change-of-Coordinates Matrix" #edb/ref 17592186045417] [17592186124710 #edb/ref 1046 #edb/ref 17592186125361 #edb/ref 17592186045417] [17592186124710 #edb/ref 1049 #edb/ref 17592186048769 #edb/ref 17592186045417] [17592186124710 #edb/ref 1053 #uuid "e6e3df9f-205d-5b79-a182-6a881367dca2" #edb/ref 17592186045417] [17592186124993 #edb/ref 1068 #edb/ref 17592186323298 #edb/ref 17592186045417] [17592186124993 #edb/ref 1069 "q-36488" #edb/ref 17592186045417] [17592186124993 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186124993 #edb/ref 1071 "$$\nB={[\\begin{aligned}3 \\\\ -2\\end{aligned}],[\\begin{aligned}9 \\\\ -8\\end{aligned}]},\\,[x]_{S}=[\\begin{aligned}-6 \\\\ 4\\end{aligned}]\n$$\n\nThe basis $B$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}.$" #edb/ref 17592186045417] [17592186124993 #edb/ref 1072 #uuid "9b5f682f-a0de-52f6-930d-b54c3a22eede" #edb/ref 17592186045417] [17592186124993 #edb/ref 1074 "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{S\\to B}[\\,x\\,]_{S}.\n$$\n\nFirst, recall that the change-of-coordinates matrix from $B$ to $S$ is the matrix whose columns are the vectors of $B$ relative to the standard basis $S.$ As a result, we have\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}3 & 9 \\\\ -2 & -8\\end{aligned}].\n$$\n\nNow, we need to find the change-of-coordinates matrix ${P}_{S\\to B}$ from $S$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{S\\to B} & ={P}_{B\\to S}^{-1} \\\\  & ={[\\begin{aligned}3 & 9 \\\\ -2 & -8\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{3\\cdot (-8)-9\\cdot (-2)}[\\begin{aligned}-8 & -9 \\\\ 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{4}{3} & \\frac{3}{2} \\\\ -\\frac{1}{3} & -\\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{S\\to B}[\\,x\\,]_{S} \\\\  & =[\\begin{aligned}\\frac{4}{3} & \\frac{3}{2} \\\\ -\\frac{1}{3} & -\\frac{1}{2}\\end{aligned}][\\begin{aligned}-6 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186124994 #edb/ref 1068 #edb/ref 17592186122564 #edb/ref 17592186045417] [17592186124994 #edb/ref 1068 #edb/ref 17592186391998 #edb/ref 17592186045417] [17592186124994 #edb/ref 1069 "q-36503" #edb/ref 17592186045417] [17592186124994 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186124994 #edb/ref 1071 "The change-of-coordinates matrix from $B$ to $C$ and the coordinates of the vector $x$ relative to the basis $C$ are given below. What is $[x]_{B}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}],\\,[x]_{C}=[\\begin{aligned}5 \\\\ 4\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186124994 #edb/ref 1072 #uuid "f503090a-50ea-5c09-941f-e82b557a90db" #edb/ref 17592186045417] [17592186124994 #edb/ref 1074 "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}5 & -3 \\\\ -3 & 2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 2-(-3)\\cdot (-3)}[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}][\\begin{aligned}5 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}22 \\\\ 35\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125036 #edb/ref 1068 #edb/ref 17592186122816 #edb/ref 17592186045417] [17592186125036 #edb/ref 1069 "q-37160" #edb/ref 17592186045417] [17592186125036 #edb/ref 1071 "$B = {\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}, \\begin{bmatrix}5 \\\\ 16\\end{bmatrix}}, [x]_{S} = \\begin{bmatrix}2 \\\\ 7\\end{bmatrix}$\n\nThe basis $B$ of $R^{2}$ and the coordinates of the vector $x$ relative to the standard basis $S$ are given above. Find $[x]_{B}$." #edb/ref 17592186045417] [17592186125036 #edb/ref 1072 #uuid "618e1711-d591-5872-b815-9d14ad33b674" #edb/ref 17592186045417] [17592186125361 #edb/ref 1058 #edb/ref 17592186125500 #edb/ref 17592186045417] [17592186125361 #edb/ref 1061 17537 #edb/ref 17592186045417] [17592186125361 #edb/ref 1062 #uuid "910841a1-0516-546a-8aac-f188c965b763" #edb/ref 17592186045417] [17592186125361 #edb/ref 1063 #edb/ref 17592186125768 #edb/ref 17592186045417] [17592186125362 #edb/ref 1058 #edb/ref 17592186125363 #edb/ref 17592186045417] [17592186125362 #edb/ref 1061 17538 #edb/ref 17592186045417] [17592186125362 #edb/ref 1062 #uuid "ad493885-054b-5d5e-a186-80a2c3801b8b" #edb/ref 17592186045417] [17592186125362 #edb/ref 1063 #edb/ref 17592186124495 #edb/ref 17592186045417] [17592186125363 #edb/ref 1058 #edb/ref 17592186125364 #edb/ref 17592186045417] [17592186125363 #edb/ref 1061 17541 #edb/ref 17592186045417] [17592186125363 #edb/ref 1062 #uuid "45243fec-9ed2-54d8-b6ef-0d2c0a1e7087" #edb/ref 17592186045417] [17592186125363 #edb/ref 1063 #edb/ref 17592186124496 #edb/ref 17592186045417] [17592186125364 #edb/ref 1058 #edb/ref 17592186125667 #edb/ref 17592186045417] [17592186125364 #edb/ref 1061 17542 #edb/ref 17592186045417] [17592186125364 #edb/ref 1062 #uuid "9fa2d20c-055f-5364-a1f7-12e38362db0d" #edb/ref 17592186045417] [17592186125364 #edb/ref 1063 #edb/ref 17592186124497 #edb/ref 17592186045417] [17592186125498 #edb/ref 1061 26946 #edb/ref 17592186045417] [17592186125498 #edb/ref 1062 #uuid "2c41659c-3fb0-58d9-904f-2296e677eb6c" #edb/ref 17592186045417] [17592186125498 #edb/ref 1063 #edb/ref 17592186124577 #edb/ref 17592186045417] [17592186125500 #edb/ref 1058 #edb/ref 17592186125362 #edb/ref 17592186045417] [17592186125500 #edb/ref 1061 27272 #edb/ref 17592186045417] [17592186125500 #edb/ref 1062 #uuid "4c4259ae-ebd7-5d31-ae41-72156cefc066" #edb/ref 17592186045417] [17592186125500 #edb/ref 1063 #edb/ref 17592186125822 #edb/ref 17592186045417] [17592186125667 #edb/ref 1058 #edb/ref 17592186125498 #edb/ref 17592186045417] [17592186125667 #edb/ref 1061 462199 #edb/ref 17592186045417] [17592186125667 #edb/ref 1062 #uuid "184b8c31-de1a-5e34-ad87-2f626c830182" #edb/ref 17592186045417] [17592186125667 #edb/ref 1063 #edb/ref 17592186125708 #edb/ref 17592186045417] [17592186125708 #edb/ref 1064 "Let $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}$ and $\\mathcal{C}=\\{ \\mathbf{c}_1,\\mathbf{c}_2 \\}$ be bases of $\\mathbb{R}^2.$ Now, suppose we would like to find the coordinates of $\\mathbf{b}_1$ and $\\mathbf{b}_2$ relative to the basis $\\mathcal{C}.$ \n\n- We first need to find $x_1$ and $x_2$ such that \n\n$$\nx_1 \\mathbf{c}_1+x_2 \\mathbf{c}_2 = \\mathbf{b}_1,\n$$\n\nwhich is equivalent to solving the system with the augmented matrix\n\n$$\n\\begin{aligned}| & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} \\\\ | & | & |\\end{aligned}\n$$\n\n- Similarly, we need to find $y_1$ and $y_2$ such that \n\n$$\ny_1 \\mathbf{c}_1+y_2 \\mathbf{c}_2 = \\mathbf{b}_2,\n$$\n\nwhich is equivalent to solving the system with the augmented matrix\n\n$$\n\\begin{aligned}| & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{2} \\\\ | & | & |\\end{aligned}\n$$\n\nWe can solve both systems using Gaussian elimination. However, we can do that simultaneously by considering the matrix\n\n$$\n\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}\n$$\n\nReducing the left-hand side to reduced row-echelon form using Gaussian elimination, we get a matrix of the form\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 0 & {x}_{1} & {y}_{1} \\\\ 0 & 1 & {x}_{2} & {y}_{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhere the required coefficients will be stored in the columns on the right-hand side." #edb/ref 17592186045417] [17592186125708 #edb/ref 1065 13287 #edb/ref 17592186045417] [17592186125708 #edb/ref 1066 #uuid "d42ee304-2e1f-5cc2-b334-65d083ea7323" #edb/ref 17592186045417] [17592186125708 #edb/ref 1067 "Using Gaussian Elimination to Find the Coordinates of a Vector in a New Basis" #edb/ref 17592186045417] [17592186125768 #edb/ref 1064 "Suppose that $\\mathbf x \\in V$ for some vector space $V,$ and that $\\mathcal B$ and $\\mathcal C$ are two bases of $V.$ \n\nTo find the coordinates of $\\mathbf{x}$ relative to $\\mathcal{C}$ given its coordinates relative to $\\mathcal B,$ we can use the **change-of-basis formula**\n\n$$\n\\begin{aligned}[\\,x\\,]_{C}={P}_{B\\to C}\\cdot [\\,x\\,]_{B},\\end{aligned}\n$$\n\nwhere we recall that\n\n- $[\\,\\mathbf x\\,]_{\\color{blue}\\mathcal{B}}$ and $[\\,\\mathbf x\\,]_{\\color{red}\\mathcal{C}}$ are the coordinates of $\\mathbf{x}$ relative to the bases $\\color{blue}\\mathcal{B}$ and ${\\color{red}\\mathcal{C}},$ respectively, and\n\n- $P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}$ is the change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to ${\\color{red}\\mathcal{C}},$ whose columns are the coordinates of vectors of the basis $\\color{blue}\\mathcal{B}$ relative to the basis ${\\color{red}\\mathcal{C}}.$\n\nAs an example, suppose we are given two bases $\\mathcal{B}=\\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ and $\\mathcal{C}=\\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$ of a vector space $V,$ and we already know that the change-of-coordinates matrix from $\\mathcal{B}$ to $\\mathcal{C}$ is given by\n\n$$\n[\\begin{aligned}-1 & 2 \\\\ 2 & 1\\end{aligned}]\n$$\n\nLet $\\mathbf{v} \\in V$ and $[\\begin{aligned}2 \\\\ 2\\end{aligned}]$ Then we can easily find $[\\,\\mathbf{v}\\,]_{\\mathcal{C}},$ as follows:\n\n$$\n\\begin{aligned}[\\,v\\,]_{C} & =\\overset{{P}_{B\\to C}}{\\overset{⏞}{[\\begin{aligned}-1 & 2 \\\\ 2 & 1\\end{aligned}]}}\\cdot \\overset{[v]_{B}}{\\overset{⏞}{[\\begin{aligned}2 \\\\ 2\\end{aligned}]}} \\\\  & =[\\begin{aligned}2 \\\\ 6\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125768 #edb/ref 1065 3217 #edb/ref 17592186045417] [17592186125768 #edb/ref 1066 #uuid "827e9581-9fde-5941-ad91-2c364796e5b1" #edb/ref 17592186045417] [17592186125768 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125822 #edb/ref 1064 "We've seen that to find the coordinates of a vector $\\mathbf{x}$ relative to a basis $\\mathcal{C}$ given its coordinates relative to a basis $\\mathcal B,$ we can use the formula\n\n$$\n\\begin{aligned}[\\,x\\,]_{C}={P}_{B\\to C}\\cdot [\\,x\\,]_{B}.\\end{aligned}\n$$\n\nIn expanded form, the formula looks as follows:\n\n$$\n\\begin{aligned}| \\\\ [x]_{C} \\\\ |\\end{aligned}\n$$\n\nAlso, remember that the change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to $\\color{red}\\mathcal{C}$ and from $\\color{red}\\mathcal{C}$ to $\\color{blue}\\mathcal{B}$ are the inverses of each other:\n\n$$\nP_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}} = P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}^{-1}\n\t\\quad\\textrm{and}\\quad\n\tP_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}} = P_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}}^{-1}\n$$" #edb/ref 17592186045417] [17592186125822 #edb/ref 1065 4435 #edb/ref 17592186045417] [17592186125822 #edb/ref 1066 #uuid "cfffdf8e-9e9f-5304-8249-54a094cc7c11" #edb/ref 17592186045417] [17592186125822 #edb/ref 1067 "The Change-of-Basis Formula in Expanded Form" #edb/ref 17592186045417] [17592186244435 #edb/ref 1080 "[\\begin{aligned}5 \\\\ 2\\end{aligned}]" #edb/ref 17592186045417] [17592186244435 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186244435 #edb/ref 1083 