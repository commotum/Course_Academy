derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sin}⁡y)=\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}y\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y.\\end{aligned}\n$$"] ["question-325cb3ef-db56-5f90-98ae-212e45702d0f" :question/difficulty :question.difficulty/easy] ["answer-field-64fdecf4-7be9-5050-b772-01b00e36fa6a" :answer-field/id #uuid "64fdecf4-7be9-5050-b772-01b00e36fa6a"] ["answer-5126c3d8-978f-582d-85b3-1b273093c176" :answer/id #uuid "5126c3d8-978f-582d-85b3-1b273093c176"] ["answer-5126c3d8-978f-582d-85b3-1b273093c176" :answer/type :answer.type/math] ["answer-5126c3d8-978f-582d-85b3-1b273093c176" :answer/value "2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡y\\sqrt{1+{sin}^{2}⁡y}\\,\\text{d}y"] ["answer-8ba1a2b2-1160-53df-9d34-b83861b916c1" :answer/id #uuid "8ba1a2b2-1160-53df-9d34-b83861b916c1"] ["answer-8ba1a2b2-1160-53df-9d34-b83861b916c1" :answer/type :answer.type/math] ["answer-8ba1a2b2-1160-53df-9d34-b83861b916c1" :answer/value "2\\pi {\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y"] ["answer-d151476d-b4bb-5405-af19-fe054e71c98a" :answer/id #uuid "d151476d-b4bb-5405-af19-fe054e71c98a"] ["answer-d151476d-b4bb-5405-af19-fe054e71c98a" :answer/type :answer.type/math] ["answer-d151476d-b4bb-5405-af19-fe054e71c98a" :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{cos}^{2}⁡y}\\,\\text{d}y"] ["answer-b59b2a2c-fb0b-5db0-9b18-977f28ffedf9" :answer/id #uuid "b59b2a2c-fb0b-5db0-9b18-977f28ffedf9"] ["answer-b59b2a2c-fb0b-5db0-9b18-977f28ffedf9" :answer/type :answer.type/math] ["answer-b59b2a2c-fb0b-5db0-9b18-977f28ffedf9" :answer/value "2\\pi {\\int }_{0}^{\\pi /3}y\\sqrt{1+{sec}^{2}⁡y}\\,\\text{d}y"] ["answer-d70bd935-3591-5e22-b322-ce29e2d33415" :answer/id #uuid "d70bd935-3591-5e22-b322-ce2