#{[{:db/id #edb/ref 17592186425753 :knowledge-point/_questions [{:db/id #edb/ref 17592186162107 :knowledge-point/id #uuid "6eac4a2e-cfa8-5476-919e-fd3c26d01d75" :knowledge-point/title "Finding the Standard Error"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.41" :db/id #edb/ref 17592186425734} {:answer/id #uuid "3e89daf0-19fa-53f4-b72d-31d6ed1621bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.77" :db/id #edb/ref 17592186425737} {:answer/id #uuid "84db3eb9-187b-5476-8ae3-4fc97bb737af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.12" :db/id #edb/ref 17592186425742} {:answer/id #uuid "b7436ec0-730a-5723-89b9-c51e09d25df2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.33" :db/id #edb/ref 17592186425746}] :answer-field/correct {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.41" :db/id #edb/ref 17592186425734} :answer-field/id #uuid "5fa84345-5063-5b45-a9a8-f4e3ac36fb05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425752}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27d2a840-69cf-5325-b960-367fa82827bd" :question/math-academy-id "q-143424" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{8}$ is a sample of size $n=8$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=16,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=16$ and the sample size is $n=8,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{16}{8} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{2}≈1.41.\n$$"}] [{:db/id #edb/ref 17592186418459 :knowledge-point/_questions [{:db/id #edb/ref 17592186162107 :knowledge-point/id #uuid "6eac4a2e-cfa8-5476-919e-fd3c26d01d75" :knowledge-point/title "Finding the Standard Error"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "397deda3-79ec-54be-8324-ca298ce871b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.50$" :db/id #edb/ref 17592186418424} {:answer/id #uuid "4d08f4df-3304-5238-9ee4-c8a784de2239" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.78$" :db/id #edb/ref 17592186418425} {:answer/id #uuid "5de5b927-f54f-54d4-bb10-51cc65020f8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.86$" :db/id #edb/ref 17592186418428} {:answer/id #uuid "b226dd71-89e3-53ba-931c-f7309d4db475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.22$" :db/id #edb/ref 17592186418437} {:answer/id #uuid "bb154b3d-66ec-5d69-b172-03533be8a6b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.61$" :db/id #edb/ref 17592186418439}] :answer-field/correct {:answer/id #uuid "b226dd71-89e3-53ba-931c-f7309d4db475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.22$" :db/id #edb/ref 17592186418437} :answer-field/id #uuid "35c53bd6-fdb5-5d5f-980b-becaa30267cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de928809-8125-57ca-bec0-eb6d36dc320c" :question/math-academy-id "q-143428" :question/problem "A sample ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ of four bills is drawn from a population. The population has bills of two different denominations, $$5$ and $$10,$ distributed in the ratio $3:2.$ Calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the bills in the population have denominations $$5$ and $$10,$ and these are distributed in the ratio $3:2.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $3+2=5$ bills only with the following denominations:\n\n$$\n$5,\\,$5,\\,$5,\\,$10\\,$10.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(3\\cdot 5+2\\cdot 10) \\\\  & =\\frac{1}{5}(15+20) \\\\  & =\\frac{35}{5} \\\\  & =$7,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(3\\cdot {5}^{2}+2\\cdot {10}^{2})-{7}^{2} \\\\  & =\\frac{1}{5}(275)-49 \\\\  & =55-49 \\\\  & =6.\\end{aligned}\n$$\n\nSince the sample size is $n=4,$ we have\n\n$$\n\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}=\\frac{6}{4}=1.5.\n$$\n\nFinally,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{1.5}≈$1.22.\n$$"}] [{:db/id #edb/ref 17592186418454 :knowledge-point/_questions [{:db/id #edb/ref 17592186162108 :knowledge-point/id #uuid "9453a0f1-029b-5436-94c1-47ee311f6e4d" :knowledge-point/title "Calculating an Appropriate Sample Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353a41d3-498d-5a8a-a9e6-efadecfbdf97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186418422} {:answer/id #uuid "51e57186-4049-585f-8889-b1eedaf9cb49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "251" :db/id #edb/ref 17592186418426} {:answer/id #uuid "772d9248-19f9-5fe6-9b77-c1a0f57c290b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62\\,501" :db/id #edb/ref 17592186418430} {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} {:answer/id #uuid "bb42c329-8069-528c-b75c-f226cec7f9fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,001" :db/id #edb/ref 17592186418440}] :answer-field/correct {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} :answer-field/id #uuid "795337c1-be28-5aa3-ba9d-a058d2de96cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c52d3d8-d8c0-58d1-b731-d5f1789535ad" :question/math-academy-id "q-143439" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =5$ and variance ${\\sigma }^{2}=4,$  determine the smallest sample size required so that the standard error of the mean is less than $0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{4}=2,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{2}{0.02} \\\\ \\sqrt{n} & >100 \\\\ n & >{100}^{2} \\\\ n & >10\\,000.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=10\\,001.$"}] [{:db/id #edb/ref 17592186491183 :knowledge-point/_questions [{:db/id #edb/ref 17592186162108 :knowledge-point/id #uuid "9453a0f1-029b-5436-94c1-47ee311f6e4d" :knowledge-point/title "Calculating an Appropriate Sample Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2340fb78-3bc0-52f2-8490-70b953ad6bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186490575} {:answer/id #uuid "5361feae-c64c-5ad9-9e88-dc19f7cade4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "401" :db/id #edb/ref 17592186490670} {:answer/id #uuid "78e50466-a068-54f3-a9e1-1405af2707ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "201" :db/id #edb/ref 17592186490751} {:answer/id #uuid "96643632-e50d-5725-b254-61e0b31e5d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,001" :db/id #edb/ref 17592186490816} {:answer/id #uuid "e63fe34a-b9f7-5470-aaa5-176d56673f6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41" :db/id #edb/ref 17592186490951}] :answer-field/correct {:answer/id #uuid "2340fb78-3bc0-52f2-8490-70b953ad6bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186490575} :answer-field/id #uuid "2aee0077-edc2-5b86-802c-50ab5c7a8951" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491023}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f4e58b8-0514-5aa4-9211-b553375a01af" :question/math-academy-id "q-143489" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ coins is drawn from a population. The population has coins of two different denominations, $$1$ and $$0.50,$ distributed in the ratio $1:4.$ Determine the smallest sample size required so that the standard error of the mean is less than $$0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the coins in the population have denominations $$1$ and $$0.50,$ and these are distributed in the ratio $1:4.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+4=5$ coins only with the following denominations:\n\n$$\n$1,\\,$0.5,\\,$0.5,\\,$0.5,\\,$0.5.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(1+4\\cdot 0.5) \\\\  & =\\frac{1}{5}(1+2) \\\\  & =\\frac{3}{5} \\\\  & =$0.6,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}({1}^{2}+4\\cdot {0.5}^{2})-{0.6}^{2} \\\\  & =\\frac{1}{5}(2)-0.36 \\\\  & =0.4-0.36 \\\\  & =0.04.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.04}=0.2,$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{0.2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $$0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{0.2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{0.2}{0.02} \\\\ \\sqrt{n} & >10 \\\\ n & >{10}^{2} \\\\ n & >100.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=101.$"}]}
