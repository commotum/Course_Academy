:db/id #edb/ref 17592186045498} :answer/value "201" :db/id #edb/ref 17592186447163} {:answer/id #uuid "bc3f329b-2d56-5c65-8fd5-ce307d766978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186447164} {:answer/id #uuid "c6919965-008c-583a-804a-02b29893ad0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "401" :db/id #edb/ref 17592186447165} {:answer/id #uuid "f7eb1986-1eeb-5a7e-94d4-f2aae2d2a16c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "901" :db/id #edb/ref 17592186447166}] :answer-field/correct {:db/id #edb/ref 17592186447165} :answer-field/id #uuid "962adc96-285b-55db-b3b2-45bc705d2628" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186447167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "74bfeec3-3f4e-5c4f-b7e4-18502ff50810" :question/math-academy-id "q-143443" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =100$ and variance ${\\sigma }^{2}=25,$  determine the smallest sample size required so that the standard error of the mean is less than $0.25.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{25}=5,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{5}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.25.$ Therefore\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{n}} & <0.25 \\\\ \\sqrt{n} & >\\frac{5}{0.25} \\\\ \\sqrt{n} & >20 \\\\ n & >{20}^{2} \\\\ n & >400.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=401.$"} :step/id #uuid "5815b438-b2dd-53fb-b220-9ae07c35776e"} {:db/id #edb/ref 17592186447171 :step/content {:db/id #edb/ref 17592186418454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353a41d3-498d-5a8a-a9e6-efadecfbdf97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186418422} {:answer/id #uuid "51e57186-4049-585f-8889-b1eedaf9cb49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "251" :db/id #edb/ref 17592186418426} {:answer/id #uuid "772d9248-19f9-5fe6-9b77-c1a0f57c290b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "62\\,501" :db/id #edb/ref 17592186418430} {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} {:answer/id #uuid "bb42c329-8069-528c-b75c-f226cec7f9fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186418440}] :answer-field/correct {:db/id #edb/ref 17592186418432} :answer-field/id #uuid "795337c1-be28-5aa3-ba9d-a058d2de96cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186418450}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c52d3d8-d8c0-58d1-b731-d5f1789535ad" :question/math-academy-id "q-143439" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =5$ and variance ${\\sigma }^{2}=4,$  determine the smallest sample size required so that the standard error of the mean is less than $0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{4}=2,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{2}{0.02} \\\\ \\sqrt{n} & >100 \\\\ n & >{100}^{2} \\\\ n & >10\\,000.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=10\\,001.$"} :step/id #uuid "86db7aa4-526f-594e-98bb-07bf1f02e96b" :step/next {:db/id #edb/ref 17592186447170}} {:db/id #edb/ref 17592186447172 :step/content {:db/id #edb/ref 17592186425753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.41" :db/id #edb/ref 17592186425734} {:answer/id #uuid "3e89daf0-19fa-53f4-b72d-31d6ed1621bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.77" :db/id #edb/ref 17592186425737} {:answer/id #uuid "84db3eb9-187b-5476-8ae3-4fc97bb737af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.12" :db/id #edb/ref 17592186425742} {:answer/id #uuid "b7436ec0-730a-5723-89b9-c51e09d25df2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33" :db/id #edb/ref 17592186425746}] :answer-field/correct {:db/id #edb/ref 17592186425734} :answer-field/id #uuid "5fa84345-5063-5b45-a9a8-f4e3ac36fb05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425752}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27d2a840-69cf-5325-b960-367fa82827bd" :question/math-academy-id "q-143424" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{8}$ is a sample of size $n=8$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=16,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=16$ and the sample size is $n=8,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{16}{8} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{2}≈1.41.\n$$"} :step/id #uuid "92bf9caa-0a99-5b2b-8d0b-624598682601" :step/next {:db/id #edb/ref 17592186447171}} {:db/id #edb/ref 17592186447173 :step/content {:db/id #edb/ref 17592186162381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d48c9f9b-3549-5764-b708-d84d1a81277e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.09" :db/id #edb/ref 17592186159489} {:answer/id #uuid "078e2955-6c71-5d06-b3c7-66ce9b2711c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3" :db/id #edb/ref 17592186159490} {:answer/id #uuid "17f2bf08-271e-5210-9635-b7feef509a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.9" :db/id #edb/ref 17592186159491} {:answer/id #uuid "7709bcf7-4a06-5cb8-8170-55b19bc2fce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.35" :db/id #edb/ref 17592186159492} {:answer/id #uuid "7793508a-e542-5e32-af73-86d3caa2d640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.55" :db/id #edb/ref 17592186159493}] :answer-field/correct {:db/id #edb/ref 17592186159490} :answer-field/id #uuid "1673aac7-1c38-545e-83b9-0f96062e75d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "503fe913-6b66-5820-b334-367782412a2a" :question/math-academy-id "q-143197" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{100}$ is a sample of size $n=100$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=9,$ calculate the standard error of $\\overset{―}{X}.$" :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance ${\\sigma }^{2}=9$ and the sample size $n=100,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{9}{100} \\\\  & =0.09.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.09}=0.3.\n$$"} :step/id #uuid "e819b894-7ed2-5c6c-9756-eea6cdfe101a" :step/next {:db/id #edb/ref 17592186447169}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186447161}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186491271} :activity/id #uuid "c64c48fd-6421-5002-b8ac-ec2858dbbea6" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186491224 :step/content {:db/id #edb/ref 17592186491194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d27b381-2583-5b7a-9fca-f1b985469a8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.24" :db/id #edb/ref 17592186490564} {:answer/id #uuid "285d902e-e585-5afb-b7d0-a096327f6bdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08" :db/id #edb/ref 17592186490584} {:answer/id #uuid "720b4a42-214e-5e9a-9503-6877dcdc5e91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.28" :db/id #edb/ref 17592186490736} {:answer/id #uuid "88c5126e-12bf-54b2-b915-69e90cd55a29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.12" :db/id #edb/ref 17592186490783} {:answer/id #uuid "cfaa20be-1127-571b-9b08-97a73a594545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.36" :db/id #edb/ref 17592186490903}] :answer-field/correct {:db/id #edb/ref 17592186490736} :answer-field/id #uuid "a928408c-e2bb-5ac3-8926-8be8d60e417f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bbae1413-e0da-5920-9a81-9f35b978911e" :question/math-academy-id "q-143422" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{50}$ is a sample of size $n=50$ drawn from a population with mean $\\mu =12$ and variance ${\\sigma }^{2}=4,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=4$ and the sample size is $n=50,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{4}{50} \\\\  & =0.08.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.08}≈0.28.\n$$"} :step/id #uuid "145bbf22-1749-5090-aadc-e3554ab59101" :step/next {:db/id #edb/ref 17592186491278}} {:db/id #edb/ref 17592186491233 :step/content {:db/id #edb/ref 17592186491183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2340fb78-3bc0-52f2-8490-70b953ad6bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186490575} {:answer/id #uuid "5361feae-c64c-5ad9-9e88-dc19f7cade4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "401" :db/id #edb/ref 17592186490670} {:answer/id #uuid "78e50466-a068-54f3-a9e1-1405af2707ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "201" :db/id #edb/ref 17592186490751} {:answer/id #uuid "96643632-e50d-5725-b254-61e0b31e5d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186490816} {:answer/id #uuid "e63fe34a-b9f7-5470-aaa5-176d56673f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186490951}] :answer-field/correct {:db/id #edb/ref 17592186490575} :answer-field/id #uuid "2aee0077-edc2-5b86-802c-50ab5c7a8951" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f4e58b8-0514-5aa4-9211-b553375a01af" :question/math-academy-id "q-143489" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ coins is drawn from a population. The population has coins of two different denominations, $$1$ and $$0.50,$ distributed in the ratio $1:4.$ Determine the smallest sample size required so that the standard error of the mean is less than $$0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the coins in the population have denominations $$1$ and $$0.50,$ and these are distributed in the ratio $1:4.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+4=5$ coins only with the following denominations:\n\n$$\n$1,\\,$0.5,\\,$0.5,\\,$0.5,\\,$0.5.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(1+4\\cdot 0.5) \\\\  & =\\frac{1}{5}(1+2) \\\\  & =\\frac{3}{5} \\\\  & =$0.6,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}({1}^{2}+4\\cdot {0.5}^{2})-{0.6}^{2} \\\\  & =\\frac{1}{5}(2)-0.36 \\\\  & =0.4-0.36 \\\\  & =0.04.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.04}=0.2,$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{0.2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $$0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{0.2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{0.2}{0.02} \\\\ \\sqrt{n} & >10 \\\\ n & >{10}^{2} \\\\ n & >100.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=101.$"} :step/id #uuid "46254631-f53c-514a-8d4a-8cae395482d2" :step/next {:db/id #edb/ref 17592186491274}} {:db/id #edb/ref 17592186491271 :step/content {:db/id #edb/ref 17592186162382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210567c7-e894-5b02-9ee8-c6893172df38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.18\\,\\text{cm}" :db/id #edb/ref 17592186425735} {:answer/id #uuid "60c93555-b34b-575f-95b2-f38de1599831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.15\\,\\text{cm}" :db/id #edb/ref 17592186425739} {:answer/id #uuid "ca20eb7d-1ae8-5c45-ab85-1bae5f9c5811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.32\\,\\text{cm}" :db/id #edb/ref 17592186425747} {:answer/id #uuid "cce28df6-b4e2-5293-9860-139a95e35caa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.24\\,\\text{cm}" :db/id #edb/ref 17592186425748} {:answer/id #uuid "cfed1752-e352-5a6b-9e2d-7dc6a36ff6ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33\\,\\text{cm}" :db/id #edb/ref 17592186425749}] :answer-field/correct {:db/id #edb/ref 17592186425739} :answer-field/id #uuid "e23ca134-e512-533c-83e5-e06d13cf4c5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bcb58811-e371-5576-bf66-5ecfddbfc1fb" :question/math-academy-id "q-143202" :question/problem "A sample ${X}_{1},{X}_{2},{X}_{3}$ of three nails is drawn from a population. The population has nails of two different lengths, $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ distributed in the ratio $4:1.$ Calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the nails in the population have lengths $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ and these are distributed in the ratio $4:1.$ Therefore, to compute the population mean and variance, we can consider a population consisting of $4+1=5$ nails only with the following lengths:\n\n$$\n5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm}\\,10\\,\\text{cm}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(4\\cdot 5+10) \\\\  & =\\frac{1}{5}(20+10) \\\\  & =\\frac{30}{5} \\\\  & =6\\,\\text{cm},\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(4\\cdot {5}^{2}+{10}^{2})-{6}^{2} \\\\  & =\\frac{1}{5}(200)-36 \\\\  & =40-36 \\\\  & =4\\,{\\text{cm}}^{2}.\\end{aligned}\n$$\n\nSince the sample size $n=3,$ we have\n\n$$\n\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}=\\frac{4}{3}\\,{\\text{cm}}^{2}.\n$$\n\nFinally,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{4}{3}}≈1.15\\,\\text{cm}\n$$\n\nrounded to two decimal places."} :step/id #uuid "e09f4a70-dbb4-5510-9c9f-f62ce6e6b9da" :step/next {:db/id #edb/ref 17592186491224}} {:db/id #edb/ref 17592186491274 :step/content {:db/id #edb/ref 17592186491123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00419cc9-1483-5e06-b0b3-661e4e54899f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186490512} {:answer/id #uuid "47723024-b4a1-584b-a829-85dceb9329c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186490643} {:answer/id #uuid "80b0e3c0-0da7-58eb-94d5-d78a9853d5ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186490770} {:answer/id #uuid "ccb60d40-47ca-586a-82af-614639d331fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186490897} {:answer/id #uuid "e18c0630-b233-59ad-b582-a2188863f6f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186490936}] :answer-field/correct {:db/id #edb/ref 17592186490897} :answer-field/id #uuid "c686f557-e13f-5945-8efd-5e2a53507af7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "18073722-b26c-57f1-b864-bfe7c648363b" :question/math-academy-id "q-143495" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ shirts is drawn from a population. The population has shirts of two different sizes, $8$ and $10,$ distributed in the ratio $1:3.$ Determine the smallest sample size required so that the standard error of the mean is less than $0.5.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the shirts in the population have sizes $8$ and $10,$ and these are distributed in the ratio $1:3.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+3=4$ shirts only with the following sizes:\n\n$$\n8,\\,10,\\,10,\\,10.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{4}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{4}(8+3\\cdot 10) \\\\  & =\\frac{1}{4}(8+30) \\\\  & =\\frac{38}{4} \\\\  & =9.5,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{4}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{4}({8}^{2}+3\\cdot {10}^{2})-{9.5}^{2} \\\\  & =\\frac{1}{4}(364)-90.25 \\\\  & =91-90.25 \\\\  & =0.75.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.75},$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{0.75}{n}}.\n$$\n\nWe require that the standard error is less than $0.5.$ Therefore\n\n$$\n\\begin{aligned}\\sqrt{\\frac{0.75}{n}} & <0.5 \\\\ \\sqrt{n} & >\\frac{\\sqrt{0.75}}{0.5} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{{0.5}^{2}}} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{0.25}} \\\\ \\sqrt{n} & >\\sqrt{3} \\\\ n & >3.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=4.$"} :step/id #uuid "f623e816-8a9f-53dc-ac9b-5d259ddbb546"} {:db/id #edb/ref 17592186491278 :step/content {:db/id #edb/ref 17592186491203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb4622f-90b6-5a96-a333-ac1ffe1c4ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "122" :db/id #edb/ref 17592186490568} {:answer/id #uuid "7156e35a-a0cd-5c4a-9cfe-86803b267024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186490734} {:answer/id #uuid "cad96efa-207b-59ed-9afb-6c27a870f1d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,305" :db/id #edb/ref 17592186490895} {:answer/id #uuid "db47dba0-0807-5e27-ac1c-6bd558d9926c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186490927} {:answer/id #uuid "dc1775bd-6de6-57e4-b281-5dc5531234f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186490928}] :answer-field/correct {:db/id #edb/ref 17592186490928} :answer-field/id #uuid "a38d7fe4-d3d9-5f07-8a46-a68180a20afb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491067}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df86b42c-6e72-556f-b425-3d68c35d4d8d" :question/math-academy-id "q-143440" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =24$ and variance ${\\sigma }^{2}=1,$  determine the smallest sample size required so that the standard error of the mean is less than $0.5.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{1}=1,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{1}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.5.$ Therefore\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{n}} & <0.5 \\\\ \\sqrt{n} & >\\frac{1}{0.5} \\\\ \\sqrt{n} & >2 \\\\ n & >{2}^{2} \\\\ n & >4.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=5.$"} :step/id #uuid "faa8d334-a6c2-5d81-9e07-13cab6f2da50" :step/next {:db/id #edb/ref 17592186491233}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490511}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186555874} :activity/id #uuid "0d2a4412-2dac-5e68-9ef6-8871a2ce8889" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186555874 :step/content {:db/id #edb/ref 17592186555852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202c2206-09ba-5f9b-b455-39671ad1087d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.025" :db/id #edb/ref 17592186555061} {:answer/id #uuid "26ea0188-d3a8-578a-947b-3ff305dc87fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.7" :db/id #edb/ref 17592186555082} {:answer/id #uuid "aadddd80-82a5-5508-bc30-2242f6328bc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.005" :db/id #edb/ref 17592186555409} {:answer/id #uuid "c446f581-f180-508c-8472-c4be11334fdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1" :db/id #edb/ref 17592186555475} {:answer/id #uuid "ece61310-9e1e-5d98-9a54-46b33668a004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.05" :db/id #edb/ref 17592186555582}] :answer-field/correct {:db/id #edb/ref 17592186555409} :answer-field/id #uuid "c8d2d1ba-3527-52e7-870f-e223ed442407" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555735}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c2a27711-6c10-58d5-b2f3-5f2c3c569a97" :question/math-academy-id "q-143400" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{20}$ is a sample of size $n=20$ drawn from a population with mean $\\mu =0.7$ and variance ${\\sigma }^{2}=0.1,$ calculate the value of $\\text{Var}[\\overset{―}{X}].$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}.\n$$\n\nSince the population variance ${\\sigma }^{2}=0.1$ and the sample size $n=20,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{0.1}{20} \\\\  & =0.005.\\end{aligned}\n$$"} :step/id #uuid "00d8fa95-6258-55b6-83d5-e04b9f3228b7" :step/next {:db/id #edb/ref 17592186555925}} {:db/id #edb/ref 17592186555885 :step/content {:db/id #edb/ref 17592186418459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "397deda3-79ec-54be-8324-ca298ce871b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$1.50$" :db/id #edb/ref 17592186418424} {:answer/id #uuid "4d08f4df-3304-5238-9ee4-c8a784de2239" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.78$" :db/id #edb/ref 17592186418425} {:answer/id #uuid "5de5b927-f54f-54d4-bb10-51cc65020f8c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.86$" :db/id #edb/ref 17592186418428} {:answer/id #uuid "b226dd71-89e3-53ba-931c-f7309d4db475" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$1.22$" :db/id #edb/ref 17592186418437} {:answer/id #uuid "bb154b3d-66ec-5d69-b172-03533be8a6b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.61$" :db/id #edb/ref 17592186418439}] :answer-field/correct {:db/id #edb/ref 17592186418437} :answer-field/id #uuid "35c53bd6-fdb5-5d5f-980b-becaa30267cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186418449}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de928809-8125-57ca-bec0-eb6d36dc320c" :question/math-academy-id "q-143428" :question/problem "A sample ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ of four bills is drawn from a population. The population has bills of two different denominations, $$5$ and $$10,$ distributed in the ratio $3:2.$ Calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the bills in the population have denominations $$5$ and $$10,$ and these are distributed in the ratio $3:2.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $3+2=5$ bills only with the following denominations:\n\n$$\n$5,\\,$5,\\,$5,\\,$10\\,$10.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(3\\cdot 5+2\\cdot 10) \\\\  & =\\frac{1}{5}(15+20) \\\\  & =\\frac{35}{5} \\\\  & =$7,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(3\\cdot {5}^{2}+2\\cdot {10}^{2})-{7}^{2} \\\\  & =\\frac{1}{5}(275)-49 \\\\  & =55-49 \\\\  & =6.\\end{aligned}\n$$\n\nSince the sample size is $n=4,$ we have\n\n$$\n\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}=\\frac{6}{4}=1.5.\n$$\n\nFinally,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{1.5}≈$1.22.\n$$"} :step/id #uuid "1ed18c81-e6cc-5550-b6aa-5ce254478730" :step/next {:db/id #edb/ref 17592186555955}} {:db/id #edb/ref 17592186555925 :step/content {:db/id #edb/ref 17592186425753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.41" :db/id #edb/ref 17592186425734} {:answer/id #uuid "3e89daf0-19fa-53f4-b72d-31d6ed1621bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.77" :db/id #edb/ref 17592186425737} {:answer/id #uuid "84db3eb9-187b-5476-8ae3-4fc97bb737af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.12" :db/id #edb/ref 17592186425742} {:answer/id #uuid "b7436ec0-730a-5723-89b9-c51e09d25df2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33" :db/id #edb/ref 17592186425746}] :answer-field/correct {:db/id #edb/ref 17592186425734} :answer-field/id #uuid "5fa84345-5063-5b45-a9a8-f4e3ac36fb05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425752}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27d2a840-69cf-5325-b960-367fa82827bd" :question/math-academy-id "q-143424" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{8}$ is a sample of size $n=8$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=16,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=16$ and the sample size is $n=8,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{16}{8} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{2}≈1.41.\n$$"} :step/id #uuid "ad80f446-b473-51f1-9360-f55320183fab" :step/next {:db/id #edb/ref 17592186555885}} {:db/id #edb/ref 17592186555931 :step/content {:db/id #edb/ref 17592186491183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2340fb78-3bc0-52f2-8490-70b953ad6bad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186490575} {:answer/id #uuid "5361feae-c64c-5ad9-9e88-dc19f7cade4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "401" :db/id #edb/ref 17592186490670} {:answer/id #uuid "78e50466-a068-54f3-a9e1-1405af2707ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "201" :db/id #edb/ref 17592186490751} {:answer/id #uuid "96643632-e50d-5725-b254-61e0b31e5d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186490816} {:answer/id #uuid "e63fe34a-b9f7-5470-aaa5-176d56673f6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186490951}] :answer-field/correct {:db/id #edb/ref 17592186490575} :answer-field/id #uuid "2aee0077-edc2-5b86-802c-50ab5c7a8951" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491023}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9f4e58b8-0514-5aa4-9211-b553375a01af" :question/math-academy-id "q-143489" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ coins is drawn from a population. The population has coins of two different denominations, $$1$ and $$0.50,$ distributed in the ratio $1:4.$ Determine the smallest sample size required so that the standard error of the mean is less than $$0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the coins in the population have denominations $$1$ and $$0.50,$ and these are distributed in the ratio $1:4.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $1+4=5$ coins only with the following denominations:\n\n$$\n$1,\\,$0.5,\\,$0.5,\\,$0.5,\\,$0.5.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(1+4\\cdot 0.5) \\\\  & =\\frac{1}{5}(1+2) \\\\  & =\\frac{3}{5} \\\\  & =$0.6,\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}({1}^{2}+4\\cdot {0.5}^{2})-{0.6}^{2} \\\\  & =\\frac{1}{5}(2)-0.36 \\\\  & =0.4-0.36 \\\\  & =0.04.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.04}=0.2,$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{0.2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $$0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{0.2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{0.2}{0.02} \\\\ \\sqrt{n} & >10 \\\\ n & >{10}^{2} \\\\ n & >100.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=101.$"} :step/id #uuid "c1d31ec5-a85e-563d-bde8-c3408887140b"} {:db/id #edb/ref 17592186555955 :step/content {:db/id #edb/ref 17592186418454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353a41d3-498d-5a8a-a9e6-efadecfbdf97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "101" :db/id #edb/ref 17592186418422} {:answer/id #uuid "51e57186-4049-585f-8889-b1eedaf9cb49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "251" :db/id #edb/ref 17592186418426} {:answer/id #uuid "772d9248-19f9-5fe6-9b77-c1a0f57c290b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "62\\,501" :db/id #edb/ref 17592186418430} {:answer/id #uuid "8a57d240-911f-55ae-81aa-4c9727b14650" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,001" :db/id #edb/ref 17592186418432} {:answer/id #uuid "bb42c329-8069-528c-b75c-f226cec7f9fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,001" :db/id #edb/ref 17592186418440}] :answer-field/correct {:db/id #edb/ref 17592186418432} :answer-field/id #uuid "795337c1-be28-5aa3-ba9d-a058d2de96cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186418450}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c52d3d8-d8c0-58d1-b731-d5f1789535ad" :question/math-academy-id "q-143439" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ drawn from a population with mean $\\mu =5$ and variance ${\\sigma }^{2}=4,$  determine the smallest sample size required so that the standard error of the mean is less than $0.02.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}\n$$\n\nSince the population standard deviation is $\\sigma =\\sqrt{4}=2,$ we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\frac{2}{\\sqrt{n}}.\n$$\n\nWe require that the standard error is less than $0.02.$ Therefore\n\n$$\n\\begin{aligned}\\frac{2}{\\sqrt{n}} & <0.02 \\\\ \\sqrt{n} & >\\frac{2}{0.02} \\\\ \\sqrt{n} & >100 \\\\ n & >{100}^{2} \\\\ n & >10\\,000.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=10\\,001.$"} :step/id #uuid "e9d3d209-2fad-5117-88ff-6259a20aa11c" :step/next {:db/id #edb/ref 17592186555931}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554987}]}
