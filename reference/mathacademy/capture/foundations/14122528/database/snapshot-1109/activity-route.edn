#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420933} :activity/id #uuid "e616bf48-afee-5693-88d5-4ed73b51c3cc" :activity/scope {:db/id #edb/ref 17592186049809 :topic/id #uuid "156d2779-eafb-5c80-bd7a-1ed2ab0b5ca6" :topic/math-academy-id 1937} :activity/steps [{:db/id #edb/ref 17592186420931 :step/content {:db/id #edb/ref 17592186362293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c5637de-9cd7-5f67-a225-8bc3edaa10f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.72" :db/id #edb/ref 17592186361167} {:answer/id #uuid "71543430-b5a0-5270-904e-759c928c2fd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.04" :db/id #edb/ref 17592186361337} {:answer/id #uuid "c44dcf61-95dc-5835-9ab0-c46e40faab33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.84" :db/id #edb/ref 17592186361720} {:answer/id #uuid "e6886e83-9bbe-5001-aaf4-2aaa990f8f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.96" :db/id #edb/ref 17592186361866} {:answer/id #uuid "fa86c204-610a-5866-ba1b-3e096237ed19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.28" :db/id #edb/ref 17592186361956}] :answer-field/correct {:db/id #edb/ref 17592186361866} :answer-field/id #uuid "11250460-0d69-591d-a461-3a1f48f9b053" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186361995}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "52cca677-fb8e-5fcb-a6f2-9f28e4bd054c" :question/math-academy-id "q-98344" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\n\\begin{aligned} & f(-3,-1,-2)=1, &  & {f}_{x}(-3,-1,-2)=4, \\\\  & {f}_{y}(-3,-1,-2)=-3, &  & {f}_{z}(-3,-1,-2)=-2.\\end{aligned}\n$$\n\nUsing a linear approximation of $f$ at the point $(-3,-1,-2)$ estimate the value of $f(-3.04,-1.02,-2.03).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-3,-1,-2)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(-3,-1,-2)+∇f(-3,-1,-2)\\cdot ⟨x+3,y+1,z+2⟩ \\\\  & =f(-3,-1,-2) \\\\  & \\,+⟨{f}_{x}(-3,-1,-2),{f}_{y}(-3,-1,-2),{f}_{z}(-3,-1,-2)⟩\\cdot ⟨x+3,y+1,z+2⟩ \\\\  & =1+⟨4,-3,-2⟩\\cdot ⟨x+3,y+1,z+2⟩.\\end{aligned}\n$$\n\nWe can approximate $f(-3.04,-1.02,-2.03)$ by evaluating the linear approximation at $x=-3.04,$ $y=-1.02,$ and $z=-2.03$ as follows:\n\n$$\n\\begin{aligned}f(-3.04,-1.02,-2.03) & ≈1+⟨4,-3,-2⟩\\cdot ⟨-3.04+3,-1.02+1,-2.03+2⟩ \\\\  & =1+⟨4,-3,-2⟩\\cdot ⟨-0.04,-0.02,-0.03⟩ \\\\  & =1-0.16+0.06+0.06 \\\\  & =0.96\\end{aligned}\n$$"} :step/id #uuid "271dc584-8067-5c79-8663-42f0cf534fe1" :step/next {:db/id #edb/ref 17592186420935}} {:db/id #edb/ref 17592186420932 :step/content {:db/id #edb/ref 17592186420930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a5d7fe-a63b-5e32-949d-b3f2969e0db8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y)≈-2x-y" :db/id #edb/ref 17592186420919} {:answer/id #uuid "3a60a799-4271-555e-b402-ed7491785238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y)≈-1-2x+y" :db/id #edb/ref 17592186420921} {:answer/id #uuid "9c37dd2d-538f-57a0-aa67-b6fb35e4d8ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y)≈2+x+2y" :db/id #edb/ref 17592186420923} {:answer/id #uuid "b8cdea38-23c3-571a-bf79-4dd2da2d05bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y)≈-x-2y" :db/id #edb/ref 17592186420924} {:answer/id #uuid "fe73bc79-52e6-53a8-9039-023077c29e7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y)≈-1-2x-4y" :db/id #edb/ref 17592186420928}] :answer-field/correct {:db/id #edb/ref 17592186420921} :answer-field/id #uuid "71f2f20d-59aa-5f4b-b243-cfacb310155a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420929}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55146915-2d47-5b59-9386-37303589ba19" :question/math-academy-id "q-129741" :question/problem "Let $f(x,y)={x}^{2}{e}^{y}.$ Find the linear approximation of $f$ at the point $(-1,0).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-1,0)$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-1,0)+∇f(-1,0)\\cdot ⟨x+1,y⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(-1,0)=1.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =2x{e}^{y}\\, &  & ⇒\\, & {f}_{x}(-1,0)=-2, \\\\ {f}_{y} & ={x}^{2}{e}^{y} &  & ⇒\\, & {f}_{y}(-1,0)=1.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(-1,0)$ is given by\n\n$$\n\\begin{aligned}∇f(-1,0) & =⟨-2,1⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-1,0)+∇f(-1,0)\\cdot ⟨x+1,y⟩ \\\\  & ≈1+⟨-2,1⟩\\cdot ⟨x+1,y⟩ \\\\  & ≈1-2(x+1)+y \\\\  & ≈-1-2x+y.\\end{aligned}\n$$"} :step/id #uuid "428b58fe-7d44-5904-bbbf-8158fe8c3758"} {:db/id #edb/ref 17592186420933 :step/content {:db/id #edb/ref 17592186125007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3996a57d-3ca8-524e-b713-371dae9f92c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y,z)≈\\pi -1-x-z" :db/id #edb/ref 17592186420920} {:answer/id #uuid "783e5bf5-dd91-511c-81fe-eca19c21cfc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y,z)≈-1+x" :db/id #edb/ref 17592186420922} {:answer/id #uuid "bb0f50fc-3f9e-56b0-874f-3d40ee14ed33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y,z)≈-2-x+y" :db/id #edb/ref 17592186420925} {:answer/id #uuid "df1e2f42-abc0-5025-a335-6ed1280fc719" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y,z)≈1-x" :db/id #edb/ref 17592186420926} {:answer/id #uuid "f7a0590c-c153-5bd3-ab0a-b20fc19d4881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(x,y,z)≈-1-x" :db/id #edb/ref 17592186420927}] :answer-field/correct {:db/id #edb/ref 17592186420927} :answer-field/id #uuid "d6db9cae-9882-5bc9-bc06-4b3bc77a65e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186122642}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "051e613f-42d1-5b65-a3d0-8638cacfa921" :question/math-academy-id "q-36746" :question/problem "Let $f(x,y,z)={e}^{xy}\\operatorname{cos}⁡(z).$ Find the linear approximation of $f$ at the point $(0,1,\\pi ).$" :question/requires-calculator true :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(0,1,\\pi )$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(0,1,\\pi )+∇f(0,1,\\pi )\\cdot ⟨x,y-1,z-\\pi ⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(0,1,\\pi )=-1.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =y{e}^{xy}\\operatorname{cos}⁡z\\,⇒\\,{f}_{x}(0,1,\\pi )=-1, \\\\ {f}_{y} & =x{e}^{xy}\\operatorname{cos}⁡z\\,⇒\\,{f}_{y}(0,1,\\pi )=0, \\\\ {f}_{z} & =-{e}^{xy}\\operatorname{sin}⁡z\\,⇒\\,{f}_{z}(0,1,\\pi )=0.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(0,1,\\pi )$ is given by\n\n$$\n\\begin{aligned}∇f(0,1,\\pi ) & =⟨{f}_{x}(0,1,\\pi ),{f}_{y}(0,1,\\pi ),{f}_{z}(0,1,\\pi )⟩ \\\\  & =⟨-1,0,0⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(0,1,\\pi )+∇f(0,1,\\pi )\\cdot ⟨x,y-1,z-\\pi ⟩ \\\\  & ≈-1+⟨-1,0,0⟩\\cdot ⟨x,y-1,z-\\pi ⟩ \\\\  & ≈-1-x.\\end{aligned}\n$$"} :step/id #uuid "ac2d8892-990a-561c-b817-20d63c4e20b5" :step/next {:db/id #edb/ref 17592186420934}} {:db/id #edb/ref 17592186420934 :step/content {:db/id #edb/ref 17592186125255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87af71d8-c14b-5e93-8a58-f967155726ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.2" :db/id #edb/ref 17592186124131} {:answer/id #uuid "8c132d2f-f0e1-55c6-8681-fe71e2237c65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.85" :db/id #edb/ref 17592186124132} {:answer/id #uuid "bc3bd8a9-f201-5d6b-bf76-51931b9ad32b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.06" :db/id #edb/ref 17592186124133} {:answer/id #uuid "d42ce0c3-890f-5ac1-a33f-8104d2a260ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.91" :db/id #edb/ref 17592186124134} {:answer/id #uuid "46c19a80-75d5-5b32-b217-f47c15153172" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.9" :db/id #edb/ref 17592186124135}] :answer-field/correct {:db/id #edb/ref 17592186124131} :answer-field/id #uuid "b665f142-dd59-559d-9742-e6ed101ab440" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186124130}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1d1a53d9-3ef8-57e5-86e4-66648db12db7" :question/math-academy-id "q-97877" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(2,-2,-1)=4,\\,{f}_{x}(2,-2,-1)=2,\\,{f}_{y}(2,-2,-1)=-2,\\,{f}_{z}(2,-2,-1)=-4.\n$$\n\nUsing a linear approximation of $f$ at the point $(2,-2,-1)$ estimate the value of $f(2.02,-1.98,-1.05)$" :question/requires-calculator true :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(2,-2,-1)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,-2,-1)+∇f(2,-2,-1)\\cdot ⟨x-2,y+2,z+1⟩ \\\\  & =f(2,-2,-1)+⟨{f}_{x}(2,-2,-1),{f}_{y}(2,-2,-1),{f}_{z}(2,-2,-1)⟩\\cdot ⟨x-2,y+2,z+1⟩ \\\\  & =4+⟨2,-2,-4⟩\\cdot ⟨x-2,y+2,z+1⟩.\\end{aligned}\n$$\n\nWe can approximate $f(2.02,-1.98,-1.05)$ by evaluating the linear approximation at $x=2.02,$ $y=-1.98,$ and $z=-1.05$ as follows:\n\n$$\n\\begin{aligned}f(2.02,-1.98,-1.05) & ≈4+⟨2,-2,-4⟩\\cdot ⟨2.02-2,-1.98+2,-1.05+1⟩ \\\\  & =4+⟨2,-2,-4⟩\\cdot ⟨0.02,0.02,-0.05⟩ \\\\  & =4+(0.04-0.04+0.2) \\\\  & =4.2\\end{aligned}\n$$"} :step/id #uuid "de8e0d3a-aa28-5870-806b-fac6775a1e3e" :step/next {:db/id #edb/ref 17592186420931}} {:db/id #edb/ref 17592186420935 :step/content {:db/id #edb/ref 17592186265764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ff1e57-06de-5f95-bbfb-858cc1b13fcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.09" :db/id #edb/ref 17592186263206} {:answer/id #uuid "3b04143b-57f8-52cd-a738-9fc5fdf9d65e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.37" :db/id #edb/ref 17592186263525} {:answer/id #uuid "3fbbad2d-eebb-5dca-a3ea-e0c4084284e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.95" :db/id #edb/ref 17592186263563} {:answer/id #uuid "431cea10-5e99-5fae-b2da-32b333bb11c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.22" :db/id #edb/ref 17592186263591} {:answer/id #uuid "fcdaec9c-037d-5591-9664-14a70772a823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.82" :db/id #edb/ref 17592186265222}] :answer-field/correct {:db/id #edb/ref 17592186263525} :answer-field/id #uuid "3afc059a-63a4-57e9-911d-aba7f14a7f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3f88dd94-3a57-5874-9049-b04644f1e878" :question/math-academy-id "q-129657" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(1,2,3)=6,\\,{f}_{x}(1,2,3)=6,\\,{f}_{y}(1,2,3)=3,\\,{f}_{z}(1,2,3)=2.\n$$\n\nUsing a linear approximation of $f$ at the point $(1,2,3)$ estimate the value of $f(1.08,1.93,3.05)$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,2,3)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,2,3)+∇f(1,2,3)\\cdot ⟨x-1,y-2,z-3⟩ \\\\  & =6+⟨{f}_{x}(1,2,3),{f}_{y}(1,2,3),{f}_{z}(1,2,3)⟩\\cdot ⟨x-1,y-2,z-3⟩ \\\\  & =6+⟨6,3,2⟩\\cdot ⟨x-1,y-2,z-3⟩.\\end{aligned}\n$$\n\nWe can approximate $f(1.08,1.93,3.05)$ by evaluating the linear approximation at $x=1.08,$ $y=1.93,$ and $z=3.05$ as follows:\n\n$$\n\\begin{aligned}f(1.08,1.93,3.05) & ≈6+⟨6,3,2⟩\\cdot ⟨1.08-1,1.93-2,3.05-3⟩ \\\\  & =6+⟨6,3,2⟩\\cdot ⟨0.08,-0.07,0.05⟩ \\\\  & =6+6(0.08)+3(-0.07)+2(0.05) \\\\  & =6+0.48-0.21+0.1 \\\\  & =6.37\\end{aligned}\n$$"} :step/id #uuid "f9443769-9265-54cf-81f2-24a4db8a375c" :step/next {:db/id #edb/ref 17592186420932}}] :activity/title "Linearization of Multivariable Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420918}]}
