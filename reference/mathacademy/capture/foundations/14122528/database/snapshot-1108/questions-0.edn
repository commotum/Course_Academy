#{[{:db/id #edb/ref 17592186265764 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ff1e57-06de-5f95-bbfb-858cc1b13fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.09" :db/id #edb/ref 17592186263206} {:answer/id #uuid "3b04143b-57f8-52cd-a738-9fc5fdf9d65e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.37" :db/id #edb/ref 17592186263525} {:answer/id #uuid "3fbbad2d-eebb-5dca-a3ea-e0c4084284e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.95" :db/id #edb/ref 17592186263563} {:answer/id #uuid "431cea10-5e99-5fae-b2da-32b333bb11c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.22" :db/id #edb/ref 17592186263591} {:answer/id #uuid "fcdaec9c-037d-5591-9664-14a70772a823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.82" :db/id #edb/ref 17592186265222}] :answer-field/correct {:answer/id #uuid "3b04143b-57f8-52cd-a738-9fc5fdf9d65e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.37" :db/id #edb/ref 17592186263525} :answer-field/id #uuid "3afc059a-63a4-57e9-911d-aba7f14a7f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f88dd94-3a57-5874-9049-b04644f1e878" :question/math-academy-id "q-129657" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(1,2,3)=6,\\,{f}_{x}(1,2,3)=6,\\,{f}_{y}(1,2,3)=3,\\,{f}_{z}(1,2,3)=2.\n$$\n\nUsing a linear approximation of $f$ at the point $(1,2,3)$ estimate the value of $f(1.08,1.93,3.05)$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,2,3)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,2,3)+∇f(1,2,3)\\cdot ⟨x-1,y-2,z-3⟩ \\\\  & =6+⟨{f}_{x}(1,2,3),{f}_{y}(1,2,3),{f}_{z}(1,2,3)⟩\\cdot ⟨x-1,y-2,z-3⟩ \\\\  & =6+⟨6,3,2⟩\\cdot ⟨x-1,y-2,z-3⟩.\\end{aligned}\n$$\n\nWe can approximate $f(1.08,1.93,3.05)$ by evaluating the linear approximation at $x=1.08,$ $y=1.93,$ and $z=3.05$ as follows:\n\n$$\n\\begin{aligned}f(1.08,1.93,3.05) & ≈6+⟨6,3,2⟩\\cdot ⟨1.08-1,1.93-2,3.05-3⟩ \\\\  & =6+⟨6,3,2⟩\\cdot ⟨0.08,-0.07,0.05⟩ \\\\  & =6+6(0.08)+3(-0.07)+2(0.05) \\\\  & =6+0.48-0.21+0.1 \\\\  & =6.37\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125007 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84c47a09-7498-51f4-9037-3b0914134866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x, y, z) \\approx - 1 + x" :db/id #edb/ref 17592186122643} {:answer/id #uuid "e9f760b0-f13c-5959-a2d8-7d41f3dcd38e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x, y, z) \\approx π - 1 - x - z" :db/id #edb/ref 17592186122644} {:answer/id #uuid "ef85820b-e8f4-549f-ba77-a8f0d055680d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x, y, z) \\approx 1 - x" :db/id #edb/ref 17592186122645} {:answer/id #uuid "3870eb84-b32c-53ef-a642-8f2c9d924cc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x, y, z) \\approx - 1 - x" :db/id #edb/ref 17592186122646} {:answer/id #uuid "3c93bd06-c881-5187-8abd-3d174225671f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x, y, z) \\approx - 2 - x + y" :db/id #edb/ref 17592186122647}] :answer-field/id #uuid "d6db9cae-9882-5bc9-bc06-4b3bc77a65e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122642}] :question/id #uuid "051e613f-42d1-5b65-a3d0-8638cacfa921" :question/math-academy-id "q-36746" :question/problem "Let $f(x, y, z) = e^{xy}\\cos (z)$. Find the linear approximation of $f$ at the point $(0, 1, π)$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186125255 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87af71d8-c14b-5e93-8a58-f967155726ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186124131} {:answer/id #uuid "8c132d2f-f0e1-55c6-8681-fe71e2237c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.85" :db/id #edb/ref 17592186124132} {:answer/id #uuid "bc3bd8a9-f201-5d6b-bf76-51931b9ad32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.06" :db/id #edb/ref 17592186124133} {:answer/id #uuid "d42ce0c3-890f-5ac1-a33f-8104d2a260ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.91" :db/id #edb/ref 17592186124134} {:answer/id #uuid "46c19a80-75d5-5b32-b217-f47c15153172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.9" :db/id #edb/ref 17592186124135}] :answer-field/id #uuid "b665f142-dd59-559d-9742-e6ed101ab440" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124130}] :question/id #uuid "1d1a53d9-3ef8-57e5-86e4-66648db12db7" :question/math-academy-id "q-97877" :question/problem "Suppose that $f(x, y, z)$ is a differentiable function such that\n$f(2,-2,-1) = 4, f_{x}(2,-2,-1) = 2, f_{y}(2,-2,-1) =-2, f_{z}(2,-2,-1) =-4$.\nUsing a linear approximation of $f$ at the point $(2,-2,-1)$ estimate the value of $f(2.02,-1.98,-1.05)$\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186362293 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c5637de-9cd7-5f67-a225-8bc3edaa10f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186361167} {:answer/id #uuid "71543430-b5a0-5270-904e-759c928c2fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.04" :db/id #edb/ref 17592186361337} {:answer/id #uuid "c44dcf61-95dc-5835-9ab0-c46e40faab33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.84" :db/id #edb/ref 17592186361720} {:answer/id #uuid "e6886e83-9bbe-5001-aaf4-2aaa990f8f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.96" :db/id #edb/ref 17592186361866} {:answer/id #uuid "fa86c204-610a-5866-ba1b-3e096237ed19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.28" :db/id #edb/ref 17592186361956}] :answer-field/correct {:answer/id #uuid "e6886e83-9bbe-5001-aaf4-2aaa990f8f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.96" :db/id #edb/ref 17592186361866} :answer-field/id #uuid "11250460-0d69-591d-a461-3a1f48f9b053" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361995}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52cca677-fb8e-5fcb-a6f2-9f28e4bd054c" :question/math-academy-id "q-98344" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\n\\begin{aligned} & f(-3,-1,-2)=1, &  & {f}_{x}(-3,-1,-2)=4, \\\\  & {f}_{y}(-3,-1,-2)=-3, &  & {f}_{z}(-3,-1,-2)=-2.\\end{aligned}\n$$\n\nUsing a linear approximation of $f$ at the point $(-3,-1,-2)$ estimate the value of $f(-3.04,-1.02,-2.03).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-3,-1,-2)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(-3,-1,-2)+∇f(-3,-1,-2)\\cdot ⟨x+3,y+1,z+2⟩ \\\\  & =f(-3,-1,-2) \\\\  & \\,+⟨{f}_{x}(-3,-1,-2),{f}_{y}(-3,-1,-2),{f}_{z}(-3,-1,-2)⟩\\cdot ⟨x+3,y+1,z+2⟩ \\\\  & =1+⟨4,-3,-2⟩\\cdot ⟨x+3,y+1,z+2⟩.\\end{aligned}\n$$\n\nWe can approximate $f(-3.04,-1.02,-2.03)$ by evaluating the linear approximation at $x=-3.04,$ $y=-1.02,$ and $z=-2.03$ as follows:\n\n$$\n\\begin{aligned}f(-3.04,-1.02,-2.03) & ≈1+⟨4,-3,-2⟩\\cdot ⟨-3.04+3,-1.02+1,-2.03+2⟩ \\\\  & =1+⟨4,-3,-2⟩\\cdot ⟨-0.04,-0.02,-0.03⟩ \\\\  & =1-0.16+0.06+0.06 \\\\  & =0.96\\end{aligned}\n$$"}]}
