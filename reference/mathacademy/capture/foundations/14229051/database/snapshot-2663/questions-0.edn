ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447615} {:answer-field/choices [{:answer/id #uuid "236dfc34-4dba-5219-acac-2997b2644b7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186447493} {:answer/id #uuid "59ad1058-0ebc-5235-bf5a-82c369a6cdde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186447520}] :answer-field/correct {:answer/id #uuid "59ad1058-0ebc-5235-bf5a-82c369a6cdde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186447520} :answer-field/id #uuid "b9c3a9ee-8984-5450-8ce4-4d60f9ef3558" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447616} {:answer-field/choices [{:answer/id #uuid "043c9e6c-3a11-5aaf-8219-a664d47467a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186447482} {:answer/id #uuid "4d43900b-7876-5b97-8e02-78af5f282635" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186447512} {:answer/id #uuid "f2b6495b-9492-557a-ad44-08522dcba0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186447595}] :answer-field/correct {:answer/id #uuid "f2b6495b-9492-557a-ad44-08522dcba0d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186447595} :answer-field/id #uuid "ef7b60fb-4d25-5d6e-aabc-ba323132e09c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447625} {:answer-field/choices [{:answer/id #uuid "049f5769-5fd9-5a84-b0cd-5f4a4a5f43f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n}}{n}" :db/id #edb/ref 17592186447483} {:answer/id #uuid "6552293c-ef9b-5d65-a476-a37433b05e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{n}" :db/id #edb/ref 17592186447532} {:answer/id #uuid "86e73d39-0624-56f2-a8d1-76729f74462b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n}}{{n}^{2}}" :db/id #edb/ref 17592186447550} {:answer/id #uuid "99e364a6-757e-5bd5-8586-8ffbdfd41393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{{n}^{2}}" :db/id #edb/ref 17592186447561}] :answer-field/correct {:answer/id #uuid "6552293c-ef9b-5d65-a476-a37433b05e66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14(-1)^{n+1}}{n}" :db/id #edb/ref 17592186447532} :answer-field/id #uuid "f55713f6-e85d-551a-86cb-466027170f89" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186447626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5d5810a-d922-539c-8f81-743a41d8a84a" :question/math-academy-id "q-343315" :question/problem "Let $f(x)$ be the $2\\pi $-periodic extension of the function $F(x)=\\frac{7}{2}{x}^{2}+3$ defined on $[-\\pi ,\\pi ).$ Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $2\\pi $-periodic extension of $G(x)=7x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n\\frac{7}{2}{x}^{2}+3∼3+\\frac{7{\\pi }^{2}}{6}+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n7x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=\\pi $ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼3+\\frac{7{\\pi }^{2}}{6}+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}\\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-\\pi ,\\pi ),$\n\n- continuous on $[-\\pi ,\\pi ),$ and\n\n- satisfies $F(-\\pi )=F(\\pi ),$ if we extend the value at $x=\\pi $ using the formula $F(x)=\\frac{7}{2}{x}^{2}+3.$\n\nTherefore, the $2\\pi $-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{7}{2}{x}^{2}+3) & ∼\\frac{\\text{d}}{\\text{d}x}(3+\\frac{7{\\pi }^{2}}{6})+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{14(-1)^{n}}{{n}^{2}}\\operatorname{cos}⁡(nx)) \\\\ 7x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{14(-1)^{n}}{{n}^{2}}\\cdot (-n\\operatorname{sin}⁡(nx)) \\\\ 7x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-14(-1)^{n}}{n}\\operatorname{sin}⁡(nx) \\\\ 7x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{14(-1)^{n+1}}{n}\\cdot \\operatorname{sin}⁡(nx)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186551348 :knowledge-point/_questions [{:db/id #edb/ref 17592186221451 :knowledge-point/id #uuid "c1e01d04-6c13-52eb-a4b6-ad9a5cde8134" :knowledge-point/title "Integrating a Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01413d91-53a9-5c2f-95f0-dd975a28a04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n+1}}{{n}^{2}}" :db/id #edb/ref 17592186550372} {:answer/id #uuid "4178c511-d518-5d4a-9339-82483116d69c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n}}{{n}^{2}}" :db/id #edb/ref 17592186550521} {:answer/id #uuid "6e66f12f-7817-5b79-8dae-5467ced5edfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n+1}}{{n}^{3}}" :db/id #edb/ref 17592186550642} {:answer/id #uuid "a55f5e68-f562-519c-8030-f810985e9c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n}}{{n}^{3}}" :db/id #edb/ref 17592186550801}] :answer-field/correct {:answer/id #uuid "a55f5e68-f562-519c-8030-f810985e9c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n}}{{n}^{3}}" :db/id #edb/ref 17592186550801} :answer-field/id #uuid "07ef0176-9972-561f-b028-e97ddd2d78db" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186551065} {:answer-field/choices [{:answer/id #uuid "8777b0ac-3a0e-5d31-a627-3b0c9dbebe84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise continuous" :db/id #edb/ref 17592186550709} {:answer/id #uuid "99bfd701-6515-5005-8a6e-47fa0952ac7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186550759} {:answer/id #uuid "c682cd8a-5047-5bd5-a8d6-6a17186d63e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186550903} {:answer/id #uuid "e5abb8c6-bda3-5383-a2ac-4d9524e3087c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186550992}] :answer-field/correct {:answer/id #uuid "8777b0ac-3a0e-5d31-a627-3b0c9dbebe84" :