uuid "edf7d37e-5d75-5f27-bc9f-0079cc8b3b41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186425633}] :answer-field/correct {:answer/id #uuid "edf7d37e-5d75-5f27-bc9f-0079cc8b3b41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186425633} :answer-field/id #uuid "f6f9f671-11c9-5940-b954-9ff8e3b7a115" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186425674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4b9a1ad-55e6-52d3-8f59-ef1cc199427a" :question/math-academy-id "q-342459" :question/problem "$$\nF(x)=\\{\\begin{aligned}2x, & x\\in [-3,0) \\\\ {x}^{2}, & x\\in [0,3)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-3,3).$ Let $f(x)$ be the $6$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-3,3)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-3,3)$ | {{field-2}} |\n| III. | ${lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to {3}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{true}.$ The function $F(x)$ is continuous on $x\\in (-3,3).$ Its graph is shown below.\n\n![](images/11/11f9718c9384ad2fea0bf3f5cc7da720559c512a5b3cebbc11ca966d5ec0f28b.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-3,3).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{false}.$ Indeed, we have\n\n$$\n{lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to -{3}^{+}}2x=2(-3)=-6\n$$\n\nand \n\n$$\n{lim}_{x\\to {3}^{-}}F(x)={lim}_{x\\to {3}^{-}}{x}^{2}=(3)^{2}=9.\n$$\n\nSo, ${lim}_{x\\to -{3}^{+}}F(x)\\ne {lim}_{x\\to {3}^{-}}F(x).$\n\n- Statement IV is $\\text{false}$ since statement III is false.\n\n**Note:** The $6$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/d0/d0212ece76aba288e88b0c4d9f2e0f6163f4fd1f594cee30e9ea5f764ebc5f69.png)"}] [{:db/id #edb/ref 17592186551347 :knowledge-point/_questions [{:db/id #edb/ref 17592186221449 :knowledge-point/id #uuid "2ae32a2a-438f-547c-8510-7e9f760c3cb6" :knowledge-point/title "Identifying Properties of Periodic Extensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a4d026-4e1a-5cce-880b-42dd87fa4270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550610} {:answer/id #uuid "733c52bb-6afa-5bc5-95c0-a7e66333b6e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550658}] :answer-field/correct {:answer/id #uuid "64a4d026-4e1a-5cce-880b-42dd87fa4270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550610} :answer-field/id #uuid "37dba421-36d3-5977-b5b1-852f9e3aa421" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186551100} {:answer-field/choices [{:answer/id #uuid "2c1a0160-ca7d-5739-9abb-99203387c9b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550477} {:answer/id #uuid "c4ef0c6d-3fca-5c4f-88d3-d5d53bd3106c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550901}] :answer-field/correct {:answer/id #uuid "c4ef0c6d-3fca-5c4f-88d3-d5d53bd3106c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550901} :answer-field/id #uuid "56723ba2-cf0d-57bb-8655-32504888775c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186551116} {:answer-field/choices [{:answer/id #uuid "ae29e0f7-ed28-5cbf-85ca-f73138f17f52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550837} {:answer/id #uuid "ae6c9b1a-0549-532b-b72f-ea08c4affb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550840}] :answer-field/correct {:answer/id #uuid "ae6c9b1a-0549-532b-b72f-ea08c4affb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550840} :answer-field/id #uuid "69e99acf-1398-5692-8061-029fa2a74beb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186551126} {:answer-field/choices [{:answer/id #uuid "5f06001d-c0a8-5110-aaab-05496df93977" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "True" :db/id #edb/ref 17592186550599} {:answer/id #uuid "82fb8f4e-8153-5912-b8f4-8e162eb48f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550698}] :answer-field/correct {:answer/id #uuid "82fb8f4e-8153-5912-b8f4-8e162eb48f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "False" :db/id #edb/ref 17592186550698} :answer-field/id #uuid "c454f910-39f4-514e-b488-5dfacc09ef1d" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186551186}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3e7079a-616c-59e7-8130-14cd0fb2782d" :question/math-academy-id "q-342492" :question/problem "$$\nF(x)=\\{\\begin{aligned}-2x+1, & x\\in [-3,0) \\\\ {x}^{2}+1, & x\\in [0,3)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-3,3).$ Let $f(x)$ be the $6$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-3,3)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-3,3)$ | {{field-2}} |\n| III. | ${lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to {3}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{true}.$ The function $F(x)$ is continuous on $x\\in (-3,3).$ Its graph is shown below.\n\n![](images/66/66b91f732d36469ded18df5404b3f12dddad7474168efd47ddf038835b67b831.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-3,3).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{false}.$ Indeed, we have\n\n$$\n{lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to -{3}^{+}}(-2x+1)=-2(-3)+1=7\n$$\n\nand \n\n$$\n{lim}_{x\\to {3}^{-}}F(x)={lim}_{x\\to {3}^{-}}({x}^{2}+1)=(3)^{2}+1=10.\n$$\n\nSo, ${lim}_{x\\to -{3}^{+}}F(x)\\ne {lim}_{x\\to {3}^{-}}F(x).$\n\n- Statement IV is $\\text{false}$ since statement III is false.\n\n**Note:** The $6$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/88/888053858d845bd47a56b953a5eb9a6f7f6b4ddffc0ecc70fa280e1a7d543f24.png)"}] [{:db/id #edb/ref 17592186222036 :knowledge-point/_questions [{:db/id #edb/ref 17592186221450 :knowledge-point/id #uuid "f2e37d37-007c-569b-a44c-cb6a9d075371" :knowledge-point/title "Differentiating a Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ee7e427-46c3-5aed-9b19-381c6b43ae67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{nx}{\\pi })" :db/id #edb/ref 17592186447524} {:answer/