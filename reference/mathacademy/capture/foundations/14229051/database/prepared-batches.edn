6-298a9e0180fb" :answer/id #uuid "9d567457-ffee-58cf-88c6-298a9e0180fb" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "answer-8d023eb8-c4b2-5e63-b903-0a4aad1a6e6f" :answer/id #uuid "8d023eb8-c4b2-5e63-b903-0a4aad1a6e6f" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id 17592186222030 :question/problem "Let $f(x)$ be the $4$-periodic extension of the function $F(x)=8x$ defined on $[-2,2).$ Select the correct options in the reasoning below, showing the derivation of a series converging to the $4$-periodic extension of \n\n$$\nG(x)=4{x}^{2}={\\int }_{0}^{x}f(t)\\,\\text{d}t\n$$\n\nfrom the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n8x∼{\\sum }_{n=1}^{\\infty }\\frac{32(-1)^{n+1}}{n\\pi }{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}} \non $R,$ we may integrate its Fourier series term-by-term to get\n\n$$\n4{x}^{2}∼{\\sum }_{n=1}^{\\infty }{{field-3}}\\cdot {{field-4}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186316776 :answer-field/correct 17592186316129 :db/ensure [:answer-field/validate]}] "assertions" [["question-6acce05c-927e-54a3-ab7e-dea3332ed930" :question/id #uuid "6acce05c-927e-54a3-ab7e-dea3332ed930"] ["question-6acce05c-927e-54a3-ab7e-dea3332ed930" :question/math-academy-id "q-342257"] ["question-6acce05c-927e-54a3-ab7e-dea3332ed930" :question/problem "$$\nF(x)=\\{\\begin{aligned}-5x, & x\\in [-2,0) \\\\ \\frac{5}{2}{x}^{2}, & x\\in [0,2)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-2,2).$ Let $f(x)$ be the $4$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-2,2)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-2,2)$ | {{field-2}} |\n| III. | ${lim}_{x\\to -{2}^{+}}F(x)={lim}_{x\\to {2}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |"] ["question-6acce05c-927e-54a3-ab7e-dea3332ed930" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{true}.$ The function $F(x)$ is continuous on $x\\in (-2,2).$ Its graph is shown below.\n\n![](images/64/64b557365c3642ae7a4206794080804bf2bbccb07230dfa46a4f415570f85329.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-2,2).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{true}.$ Indeed, we have\n\n$$\n{lim}_{x\\to -{2}^{+}}F(x)={lim}_{x\\to -{2}^{+}}-5x=-5(-2)=10\n$$\n\nand \n\n$$\n{lim}_{x\\to {2}^{-}}F(x)={lim}_{x\\to {2}^{-}}\\frac{5}{2}{x}^{2}=\\frac{5}{2}(2)^{2}=10.\n$$\n\nSo, ${lim}_{x\\to -{2}^{+}}F(x)={lim}_{x\\to {2}^{-}}F(x).$\n\n- Statement IV is $\\text{true}$ since statements I, II, and III are all true.\n\n**Note:** The $4$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/cd/cd37979eada411b68755dfa85ec3b1e22585df2bff5c4bdd4b27cf06463706d6.png)"] ["question-6acce05c-927e-54a3-ab7e-dea3332ed930" :question/difficulty :question.difficulty/easy] ["answer-field-a7c63119-6c8c-562e-abc9-23fca39a632c" :answer-field/id #uuid "a7c63119-6c8c-562e-abc9-23fca39a632c"] ["answer-6dac34b7-0afe-57b3-92dd-0f1fe22e6081" :answer/id #uuid "6dac34b7-0afe-57b3-92dd-0f1fe22e6081"] ["answer-6dac34b7-0afe-57b3-92dd-0f1fe22e6081" :answer/type :answer.type/text] ["answer-6dac34b7-0afe-57b3-92dd-0f1fe22e6081" :answer/value "False"] ["answer-4dc4a3af-4483-521b-bb70-d53ecf298569" :answer/id #uuid "4dc4a3af-4483-521b-bb70-d53ecf298569"] ["answer-4dc4a3af-4483-521b-bb70-d53ecf298569" :answer/type :answer.type/text] ["answer-4dc4a3af-4483-521b-bb70-d53ecf298569" :answer/value "True"] ["answer-field-a7c63119-6c8c-562e-abc9-23fca39a632c" :answer-field/key "field-1"] ["answer-field-a7c63119-6c8c-562e-abc9-23fca39a632c" :answer-field/type :answer-field.type/select] ["answer-field-a7c63119-6c8c-562e-abc9-23fca