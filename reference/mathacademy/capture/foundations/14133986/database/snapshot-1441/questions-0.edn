#{[{:db/id #edb/ref 17592186250178 :knowledge-point/_questions [{:db/id #edb/ref 17592186064250 :knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06349d8e-8391-574b-b6ee-d09717af159e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247480} {:answer/id #uuid "28b08c9d-77c7-5bea-8de3-24e47c4a6b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186247786} {:answer/id #uuid "4b4c8ae4-b8b1-5ed2-b232-73c90f37ed26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186248097} {:answer/id #uuid "97ffb8aa-ac92-5db2-a3d4-4a6b34576f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{8}}{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248778} {:answer/id #uuid "b9b1dd01-2ffe-53eb-9456-1dfad676593b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\frac{x}{\\sqrt{8}})+C" :db/id #edb/ref 17592186249084}] :answer-field/correct {:answer/id #uuid "28b08c9d-77c7-5bea-8de3-24e47c4a6b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186247786} :answer-field/id #uuid "f124bfeb-924c-5974-b5d6-5bac9d8b7458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250090}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d978df6a-8484-5ed1-885e-b4758185514d" :question/math-academy-id "q-114056" :question/problem "Calculate $\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\text{d}x=\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{8}x.$\n\nSo, let's substitute $u=\\sqrt{8}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{8}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{8}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\,\\text{d}x \\\\  & =8\\sqrt{8}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{8}}\\text{d}u) \\\\  & =8\\sqrt{8}\\cdot \\frac{1}{\\sqrt{8}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =8\\,\\text{arcsec }u+C \\\\  & =8\\,\\text{arcsec}(\\sqrt{8}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186435082 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec2e130-ad0b-5d90-874b-cafee34e58c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186435066} {:answer/id #uuid "6bf5a0c1-0205-502f-9cbc-8cd0d9139fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186435067} {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} {:answer/id #uuid "d090baef-9223-53ba-b7a5-e64a993a1878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435074} {:answer/id #uuid "dcc4abca-dbd0-5a8c-8460-f14372be7eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186435075}] :answer-field/correct {:answer/id #uuid "a0d4331d-d76a-550e-af61-65f77866dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186435069} :answer-field/id #uuid "3d3eb90b-b341-501f-a49e-f9c67d7e1ee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fba38d94-94f1-5e40-9342-c81f8eabc355" :question/math-academy-id "q-124296" :question/problem "The matrix form of the affine transformation\n\n$$\nx=6u+4v+2,\\,y=5v-1\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6 & a \\\\ 0 & b\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}2 \\\\ c\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6u+4v+2 \\\\ 5v-1\\end{aligned}].\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}6u+4v+2 \\\\ 5v-1\\end{aligned}] \\\\  & =[\\begin{aligned}6u+4v \\\\ 5v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}6 & 4 \\\\ 0 & 5\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=4+5+(-1)=8.\n$$"}] [{:db/id #edb/ref 17592186387796 :knowledge-point/_questions [{:db/id #edb/ref 17592186119737 :knowledge-point/id #uuid "3ff1822c-afad-54f8-aa36-7e0de79d9d04" :knowledge-point/title "Finding the Unit Tangent Vector at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193b4900-4d07-53e2-be4e-48d5ec8d43ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\frac{\\sqrt{3}}{4},-1⟩" :db/id #edb/ref 17592186387798} {:answer/id #uuid "1f8b69e0-aa2b-5483-90dc-48d46fb9dab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩" :db/id #edb/ref 17592186387799} {:answer/id #uuid "f829b1b0-0a47-5ec0-9116-1383df3f1616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{4},\\frac{\\sqrt{3}}{2},2⟩" :db/id #edb/ref 17592186387800} {:answer/id #uuid "74a4e07c-290d-5499-a014-7387d054ab73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},\\frac{1}{4}⟩" :db/id #edb/ref 17592186387801} {:answer/id #uuid "83f0b0aa-1ec1-5f8f-9713-262b37261532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\frac{\\sqrt{3}}{2},4⟩" :db/id #edb/ref 17592186387802}] :answer-field/correct {:answer/id #uuid "1f8b69e0-aa2b-5483-90dc-48d46fb9dab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩" :db/id #edb/ref 17592186387799} :answer-field/id #uuid "f7f87249-b6b1-5efb-aa0a-6f8127d0855d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387797}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3540ef43-cb67-51c1-8423-cebf06f99cf4" :question/math-academy-id "q-127221" :question/problem "Find the unit tangent vector to the curve $r(t)=⟨-\\sqrt{3}\\operatorname{cos}⁡t,\\,-\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩$ at the point where $t=\\frac{\\pi }{3}.$" :question/worked-solution "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\sqrt{3}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\sqrt{3}\\operatorname{sin}⁡t,\\,\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t⟩ \\\\ {r}^{′}(\\frac{\\pi }{3}) & =⟨\\sqrt{3}\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,2\\operatorname{cos}⁡(\\frac{\\pi }{3})⟩ \\\\  & =⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}(\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}‖{r}^{′}(\\frac{\\pi }{3})‖ & =\\sqrt{{(\\frac{3}{2})}^{2}+{(\\frac{\\sqrt{3}}{2})}^{2}+(1)^{2}} \\\\  & =\\sqrt{\\frac{9}{4}+\\frac{3}{4}+1} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(\\frac{\\pi }{3})$ and obtain the unit tangent vector to the given curve at the point where $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}T(\\frac{\\pi }{3}) & =\\frac{{r}^{′}(\\frac{\\pi }{3})}{‖{r}^{′}(\\frac{\\pi }{3})‖} \\\\  & =\\frac{1}{2}⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩ \\\\  & =⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186435080 :knowledge-point/_questions [{:db/id #edb/ref 17592186115249 :knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d53923c-6f45-51dc-ae6c-80093cc282ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{2}:={R}_{2}-\\frac{1}{2}{R}_{1}" :db/id #edb/ref 17592186435061} {:answer/id #uuid "5d6c20a2-6c34-50ec-a6f8-5f88f21271d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}-{R}_{1},\\,{R}_{2}:=\\frac{1}{4}{R}_{2}" :db/id #edb/ref 17592186435065} {:answer/id #uuid "b5d7da9d-5400-5cbe-862a-032387dd245d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}-2{R}_{1},\\,{R}_{2}:=2{R}_{2}" :db/id #edb/ref 17592186435072} {:answer/id #uuid "bf0407bf-4311-58c0-b114-98ed3e8ee02a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186435073} {:answer/id #uuid "f5ac1651-aac3-521c-a66f-1cec99bd6d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{1},\\,{R}_{2}:=2{R}_{2}" :db/id #edb/ref 17592186435076}] :answer-field/correct {:answer/id #uuid "bf0407bf-4311-58c0-b114-98ed3e8ee02a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186435073} :answer-field/id #uuid "1b9000ab-e8bd-5f5c-84a8-8cef429e6f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435077}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4527164d-e7cb-52d0-bbe2-36d132296780" :question/math-academy-id "q-132004" :question/problem "The inverse of the matrix $N$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[N\\,|\\,I] & =[\\begin{aligned}-2 & 2 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ -2 & 2 & 1 & 0\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ 0 & 2 & 1 & 2\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ 0 & 1 & \\frac{1}{2} & 1\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $N$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $N$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[N\\,|\\,I] & =[\\begin{aligned}-2 & 2 & 1 & 0 \\\\ 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ -2 & 2 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ 0 & 2 & 1 & 2\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ 0 & 1 & \\frac{1}{2} & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}↔\\frac{1}{2}{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=\\frac{1}{2}{R}_{2}.\n$$\n\nThe matrix ${N}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{N}^{-1}=[\\begin{aligned}0 & 1 \\\\ \\frac{1}{2} & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186275237 :knowledge-point/_questions [{:db/id #edb/ref 17592186129259 :knowledge-point/id #uuid "08375770-c610-5dae-b01b-c457de086cba" :knowledge-point/title "Applying the Product Rule and Swap Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429fc6d3-040f-5f6d-9562-a7483a6f7e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186272960} {:answer/id #uuid "915bd91d-510a-52c4-8eda-cace36b4483c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186273651} {:answer/id #uuid "944ddaaf-6718-5e13-8c8a-dfc92fe0837b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140" :db/id #edb/ref 17592186273677} {:answer/id #uuid "9dcdc226-b480-5014-a556-e5f26733ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186273749} {:answer/id #uuid "b99838c4-4a0a-5c0c-9aef-ec1151de3c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186274000}] :answer-field/correct {:answer/id #uuid "9dcdc226-b480-5014-a556-e5f26733ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186273749} :answer-field/id #uuid "c248cc1a-247a-52fe-80b9-786545ae3c63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274974}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c995cbf9-c89f-5f4e-b314-1e2fc502c516" :question/math-academy-id "q-149717" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{20}({a}_{i}+1)({b}_{j}-1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{5}{a}_{i}=20,\\,{\\sum }_{j=1}^{20}{b}_{j}=26.\n$$" :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{20}({a}_{i}+1)({b}_{j}-1) & ={\\sum }_{i=1}^{5}({a}_{i}+1){\\sum }_{j=1}^{20}({b}_{j}-1).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}({a}_{i}+1){\\sum }_{j=1}^{20}({b}_{j}-1) & =({\\sum }_{i=1}^{5}{a}_{i}+{\\sum }_{i=1}^{5}1)\\cdot ({\\sum }_{j=1}^{20}{b}_{j}-{\\sum }_{j=1}^{20}1) \\\\  & =(20+5)\\cdot (26-20) \\\\  & =(25)\\cdot (6) \\\\  & =150.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304939 :knowledge-point/_questions [{:db/id #edb/ref 17592186087868 :knowledge-point/id #uuid "739a8f10-413a-5a1d-a47e-4afd0b14eb44" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2459a5ff-007e-530b-8edd-f46a552247c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302688} {:answer/id #uuid "5b4a8220-7054-525a-8afa-9194364f34cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186303014} {:answer/id #uuid "86c7d469-f99c-5c11-aeb9-bf421146bc71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303299} {:answer/id #uuid "923a9172-9e8c-54b3-b41b-41a15e5952e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186303364} {:answer/id #uuid "efe9d738-6b6f-52a9-a41b-35b9bd06d1fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303958}] :answer-field/correct {:answer/id #uuid "2459a5ff-007e-530b-8edd-f46a552247c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302688} :answer-field/id #uuid "c46c2ddf-b5c1-516e-be0e-d85055c76fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304611}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8cfe21c-18ac-5f6d-9859-3a5cbe483542" :question/math-academy-id "q-331729" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nI. ${y}^{′}+7xy=5$\n\nII. ${y}^{′}+7xy=0$\n\nIII. ${y}^{′}+7xy=-2y$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+7xy=5.\n$$\n\nThe presence of the constant term $5$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+7xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+7xy=-2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+7xy & =-2y \\\\ {y}^{′}+7xy+2y & =0 \\\\ {y}^{′}+(7x+2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186435081 :knowledge-point/_questions [{:db/id #edb/ref 17592186124499 :knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313bb2ba-1cbe-5a55-988a-686dd9f3cfca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186435062} {:answer/id #uuid "519e2e68-d953-5a17-b243-f7d7baf0d48c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186435063} {:answer/id #uuid "5a986f85-269d-547a-a60f-07e7c95d8225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186435064} {:answer/id #uuid "a026363f-0997-50ef-819e-7238a42e62f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186435068} {:answer/id #uuid "ad9d7702-93e0-58b6-a557-5d52deb4131f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186435071}] :answer-field/correct {:answer/id #uuid "519e2e68-d953-5a17-b243-f7d7baf0d48c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186435063} :answer-field/id #uuid "9fdab432-8653-5165-9ae6-72fb1a348731" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435079}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8744c31a-0769-5670-8154-7878dd8f3f11" :question/math-academy-id "q-70713" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n\\{\\begin{aligned}x=t-2 \\\\ y=2-3t \\\\ z=2t-1\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}t-2 \\\\ 2-3t \\\\ 2t-1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]+[\\begin{aligned}t \\\\ -3t \\\\ 2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}] \\\\ r & =[\\begin{aligned}-2 \\\\ \\,2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $(-2,2,-1)$  and is parallel to the vector $v=[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}].$"}] [{:db/id #edb/ref 17592186162613 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f81f07bf-266c-58e8-94e3-8cfa01cf265b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186160971} {:answer/id #uuid "18d75f87-e9c3-5ee8-afca-a302ff64370a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186160972} {:answer/id #uuid "468fbe72-f92e-5c22-ba24-b0a82fad5ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186160973} {:answer/id #uuid "65506c80-57ad-5396-af74-c8842d1251dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186160974} {:answer/id #uuid "a1875ce6-b60f-545c-9f54-6753f8dd61d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P,$ $Q,$ and $R$" :db/id #edb/ref 17592186435070}] :answer-field/correct {:answer/id #uuid "468fbe72-f92e-5c22-ba24-b0a82fad5ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186160973} :answer-field/id #uuid "69fbb242-b9bc-5ed7-ab56-6bc94e2ac473" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f59c753-3356-5eb7-a27a-598f27f0d76a" :question/math-academy-id "q-93994" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & -3 & -2 \\\\ 1 & -2 & 1\\end{aligned}],\\,Q=[\\begin{aligned}-1 & 4 \\\\ 3 & -1\\end{aligned}],\\,R=[\\begin{aligned}5 & 8 \\\\ 8 & -5\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{12}\\ne {q}_{21},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=[\\begin{aligned}-1 & 4 \\\\ 3 & -1\\end{aligned}]\n$$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""}]}
