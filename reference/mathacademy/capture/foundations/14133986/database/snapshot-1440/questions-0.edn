#{[{:db/id #edb/ref 17592186250178 :knowledge-point/_questions [{:db/id #edb/ref 17592186064250 :knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06349d8e-8391-574b-b6ee-d09717af159e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247480} {:answer/id #uuid "28b08c9d-77c7-5bea-8de3-24e47c4a6b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186247786} {:answer/id #uuid "4b4c8ae4-b8b1-5ed2-b232-73c90f37ed26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186248097} {:answer/id #uuid "97ffb8aa-ac92-5db2-a3d4-4a6b34576f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{8}}{8}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248778} {:answer/id #uuid "b9b1dd01-2ffe-53eb-9456-1dfad676593b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\frac{x}{\\sqrt{8}})+C" :db/id #edb/ref 17592186249084}] :answer-field/correct {:answer/id #uuid "28b08c9d-77c7-5bea-8de3-24e47c4a6b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{arcsec}(\\sqrt{8}x)+C" :db/id #edb/ref 17592186247786} :answer-field/id #uuid "f124bfeb-924c-5974-b5d6-5bac9d8b7458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250090}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d978df6a-8484-5ed1-885e-b4758185514d" :question/math-academy-id "q-114056" :question/problem "Calculate $\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\text{d}x=\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{8}x.$\n\nSo, let's substitute $u=\\sqrt{8}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{8}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{8}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\,\\text{d}x \\\\  & =8\\sqrt{8}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{8}}\\text{d}u) \\\\  & =8\\sqrt{8}\\cdot \\frac{1}{\\sqrt{8}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =8\\,\\text{arcsec }u+C \\\\  & =8\\,\\text{arcsec}(\\sqrt{8}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387796 :knowledge-point/_questions [{:db/id #edb/ref 17592186119737 :knowledge-point/id #uuid "3ff1822c-afad-54f8-aa36-7e0de79d9d04" :knowledge-point/title "Finding the Unit Tangent Vector at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193b4900-4d07-53e2-be4e-48d5ec8d43ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\frac{\\sqrt{3}}{4},-1⟩" :db/id #edb/ref 17592186387798} {:answer/id #uuid "1f8b69e0-aa2b-5483-90dc-48d46fb9dab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩" :db/id #edb/ref 17592186387799} {:answer/id #uuid "f829b1b0-0a47-5ec0-9116-1383df3f1616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{4},\\frac{\\sqrt{3}}{2},2⟩" :db/id #edb/ref 17592186387800} {:answer/id #uuid "74a4e07c-290d-5499-a014-7387d054ab73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},\\frac{1}{4}⟩" :db/id #edb/ref 17592186387801} {:answer/id #uuid "83f0b0aa-1ec1-5f8f-9713-262b37261532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\frac{\\sqrt{3}}{2},4⟩" :db/id #edb/ref 17592186387802}] :answer-field/correct {:answer/id #uuid "1f8b69e0-aa2b-5483-90dc-48d46fb9dab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩" :db/id #edb/ref 17592186387799} :answer-field/id #uuid "f7f87249-b6b1-5efb-aa0a-6f8127d0855d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387797}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3540ef43-cb67-51c1-8423-cebf06f99cf4" :question/math-academy-id "q-127221" :question/problem "Find the unit tangent vector to the curve $r(t)=⟨-\\sqrt{3}\\operatorname{cos}⁡t,\\,-\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩$ at the point where $t=\\frac{\\pi }{3}.$" :question/worked-solution "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\sqrt{3}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\sqrt{3}\\operatorname{sin}⁡t,\\,\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t⟩ \\\\ {r}^{′}(\\frac{\\pi }{3}) & =⟨\\sqrt{3}\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,2\\operatorname{cos}⁡(\\frac{\\pi }{3})⟩ \\\\  & =⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}(\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}‖{r}^{′}(\\frac{\\pi }{3})‖ & =\\sqrt{{(\\frac{3}{2})}^{2}+{(\\frac{\\sqrt{3}}{2})}^{2}+(1)^{2}} \\\\  & =\\sqrt{\\frac{9}{4}+\\frac{3}{4}+1} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(\\frac{\\pi }{3})$ and obtain the unit tangent vector to the given curve at the point where $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}T(\\frac{\\pi }{3}) & =\\frac{{r}^{′}(\\frac{\\pi }{3})}{‖{r}^{′}(\\frac{\\pi }{3})‖} \\\\  & =\\frac{1}{2}⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩ \\\\  & =⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275237 :knowledge-point/_questions [{:db/id #edb/ref 17592186129259 :knowledge-point/id #uuid "08375770-c610-5dae-b01b-c457de086cba" :knowledge-point/title "Applying the Product Rule and Swap Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429fc6d3-040f-5f6d-9562-a7483a6f7e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186272960} {:answer/id #uuid "915bd91d-510a-52c4-8eda-cace36b4483c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186273651} {:answer/id #uuid "944ddaaf-6718-5e13-8c8a-dfc92fe0837b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140" :db/id #edb/ref 17592186273677} {:answer/id #uuid "9dcdc226-b480-5014-a556-e5f26733ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186273749} {:answer/id #uuid "b99838c4-4a0a-5c0c-9aef-ec1151de3c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186274000}] :answer-field/correct {:answer/id #uuid "9dcdc226-b480-5014-a556-e5f26733ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186273749} :answer-field/id #uuid "c248cc1a-247a-52fe-80b9-786545ae3c63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274974}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c995cbf9-c89f-5f4e-b314-1e2fc502c516" :question/math-academy-id "q-149717" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{20}({a}_{i}+1)({b}_{j}-1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{5}{a}_{i}=20,\\,{\\sum }_{j=1}^{20}{b}_{j}=26.\n$$" :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{20}({a}_{i}+1)({b}_{j}-1) & ={\\sum }_{i=1}^{5}({a}_{i}+1){\\sum }_{j=1}^{20}({b}_{j}-1).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}({a}_{i}+1){\\sum }_{j=1}^{20}({b}_{j}-1) & =({\\sum }_{i=1}^{5}{a}_{i}+{\\sum }_{i=1}^{5}1)\\cdot ({\\sum }_{j=1}^{20}{b}_{j}-{\\sum }_{j=1}^{20}1) \\\\  & =(20+5)\\cdot (26-20) \\\\  & =(25)\\cdot (6) \\\\  & =150.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304939 :knowledge-point/_questions [{:db/id #edb/ref 17592186087868 :knowledge-point/id #uuid "739a8f10-413a-5a1d-a47e-4afd0b14eb44" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2459a5ff-007e-530b-8edd-f46a552247c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302688} {:answer/id #uuid "5b4a8220-7054-525a-8afa-9194364f34cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186303014} {:answer/id #uuid "86c7d469-f99c-5c11-aeb9-bf421146bc71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303299} {:answer/id #uuid "923a9172-9e8c-54b3-b41b-41a15e5952e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186303364} {:answer/id #uuid "efe9d738-6b6f-52a9-a41b-35b9bd06d1fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303958}] :answer-field/correct {:answer/id #uuid "2459a5ff-007e-530b-8edd-f46a552247c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302688} :answer-field/id #uuid "c46c2ddf-b5c1-516e-be0e-d85055c76fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304611}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8cfe21c-18ac-5f6d-9859-3a5cbe483542" :question/math-academy-id "q-331729" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\n- ${y}^{′}+7xy=5$\n- ${y}^{′}+7xy=0$\n- ${y}^{′}+7xy=-2y$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+7xy=5.\n$$\n\nThe presence of the constant term $5$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+7xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+7xy=-2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+7xy & =-2y \\\\ {y}^{′}+7xy+2y & =0 \\\\ {y}^{′}+(7x+2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186162613 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f81f07bf-266c-58e8-94e3-8cfa01cf265b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186160971} {:answer/id #uuid "18d75f87-e9c3-5ee8-afca-a302ff64370a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186160972} {:answer/id #uuid "468fbe72-f92e-5c22-ba24-b0a82fad5ec9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186160973} {:answer/id #uuid "65506c80-57ad-5396-af74-c8842d1251dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186160974} {:answer/id #uuid "7cf1e190-10a1-524c-b9b5-7dcba96e7ccb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$, $Q$, and $R$" :db/id #edb/ref 17592186160975}] :answer-field/id #uuid "69fbb242-b9bc-5ed7-ab56-6bc94e2ac473" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160970}] :question/id #uuid "4f59c753-3356-5eb7-a27a-598f27f0d76a" :question/math-academy-id "q-93994" :question/problem "Which of the following matrices are symmetric?\n\n$P = \\begin{bmatrix}2 & 0 & 1 \\\\ 0 & -3 & -2 \\\\ 1 & -2 & 1\\end{bmatrix}, Q = \\begin{bmatrix}-1 & 4 \\\\ 3 & -1\\end{bmatrix}, R = \\begin{bmatrix}5 & 8 \\\\ 8 & -5\\end{bmatrix}$"}]}
