86045498 #edb/ref 17592186045417] [17592186350693 #edb/ref 1083 #uuid "ff271755-5ab5-5878-ac9a-ac9de7768498" #edb/ref 17592186045417] [17592186351048 #edb/ref 1075 #edb/ref 17592186349025 #edb/ref 17592186045417] [17592186351048 #edb/ref 1075 #edb/ref 17592186349251 #edb/ref 17592186045417] [17592186351048 #edb/ref 1075 #edb/ref 17592186350066 #edb/ref 17592186045417] [17592186351048 #edb/ref 1075 #edb/ref 17592186350200 #edb/ref 17592186045417] [17592186351048 #edb/ref 1075 #edb/ref 17592186350433 #edb/ref 17592186045417] [17592186351048 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186351048 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186351048 #edb/ref 1078 #edb/ref 17592186350200 #edb/ref 17592186045417] [17592186351048 #edb/ref 1079 #uuid "c4b562c5-e9cf-59ac-9cdb-dd371b9f4a63" #edb/ref 17592186045417] [17592186351119 #edb/ref 1075 #edb/ref 17592186348600 #edb/ref 17592186045417] [17592186351119 #edb/ref 1075 #edb/ref 17592186349394 #edb/ref 17592186045417] [17592186351119 #edb/ref 1075 #edb/ref 17592186349667 #edb/ref 17592186045417] [17592186351119 #edb/ref 1075 #edb/ref 17592186350302 #edb/ref 17592186045417] [17592186351119 #edb/ref 1075 #edb/ref 17592186350502 #edb/ref 17592186045417] [17592186351119 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186351119 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186351119 #edb/ref 1078 #edb/ref 17592186349667 #edb/ref 17592186045417] [17592186351119 #edb/ref 1079 #uuid "e929c9d6-0a89-5b39-8782-8590a74cb865" #edb/ref 17592186045417] [17592186351145 #edb/ref 1075 #edb/ref 17592186348545 #edb/ref 17592186045417] [17592186351145 #edb/ref 1075 #edb/ref 17592186349436 #edb/ref 17592186045417] [17592186351145 #edb/ref 1075 #edb/ref 17592186349896 #edb/ref 17592186045417] [17592186351145 #edb/ref 1075 #edb/ref 17592186350658 #edb/ref 17592186045417] [17592186351145 #edb/ref 1075 #edb/ref 17592186350693 #edb/ref 17592186045417] [17592186351145 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186351145 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186351145 #edb/ref 1078 #edb/ref 17592186350693 #edb/ref 17592186045417] [17592186351145 #edb/ref 1079 #uuid "f7d1f385-1fe4-55c3-910c-932efd80aeb9" #edb/ref 17592186045417] [17592186351394 #edb/ref 1068 #edb/ref 17592186351145 #edb/ref 17592186045417] [17592186351394 #edb/ref 1069 "q-82135" #edb/ref 17592186045417] [17592186351394 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186351394 #edb/ref 1071 "![](images/41/4174f3930bb19223300539e1b4e9b7b191669aa4f701bff51e8349d0710ce6fb.png)\n\nConsider the finite region $D$ in the $xy$-plane enclosed by the curves $y={e}^{x},$ $y=\\operatorname{ln}⁡x,$ and the lines $y=1+e-x$  and $y=1-x,$ as shown in the picture. Express the double integral of the function $f(x,y)$ over the region $D$ as a sum of repeated integrals over type II regions." #edb/ref 17592186045417] [17592186351394 #edb/ref 1072 #uuid "96fc8cbf-3b1e-5dd2-9a47-105985216141" #edb/ref 17592186045417] [17592186351394 #edb/ref 1074 "First, let's write our equations in terms of $y,$ as follows:\n\n$$\n\\begin{aligned}y={e}^{x} & \\,⟹\\,x=\\operatorname{ln}⁡y \\\\ y=\\operatorname{ln}⁡x & \\,⟹\\,x={e}^{y} \\\\ y=1+e-x & \\,⟹\\,x=1+e-y \\\\ y=1-x & \\,⟹\\,x=1-y\\end{aligned}\n$$\n\nThe region $D$ can be partitioned into two type II regions ${D}_{1}$ and ${D}_{2},$ as shown below.\n\n![](images/4d/4df7cf2f33520a80270341d4a40b4a83d9f3c11ed8adb69fe1131a42bcd61d5a.png)\n\n    \n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,1-y\\le x\\le {e}^{y}\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,1\\le y\\le e,\\,\\operatorname{ln}⁡y\\le x\\le 1+e-y\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={∬}_{{D}_{1}}f(x,y)\\,dA+{∬}_{{D}_{2}}f(x,y)\\,dA \\\\  & ={\\int }_{0}^{1}{\\int }_{1-y}^{{e}^{y}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{e}{\\int }_{\\operatorname{ln}⁡y}^{1+e-y}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351418 #edb/ref 1068 #edb/ref 17592186351048 #edb/ref 17592186045417] [17592186351418 #edb/ref 1069 "q-82360" #edb/ref 17592186045417] [17592186351418 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351418 #edb/ref 1071 "![](images/ad/ad8d4069ab0effd57ba58ccc4bf5792d5a014b114afb086e6d4b71d69ba14d2c.png)\n\nThe region $D$ is enclosed by the the curves $y={x}^{2}$ and $y=|x|,$ as shown in the picture. Evaluate ${∬}_{D}2x\\,dA.$" #edb/ref 17592186045417] [17592186351418 #edb/ref 1072 #uuid "a00687a3-f424-5ed9-b2df-91dc74b795c2" #edb/ref 17592186045417] [17592186351418 #edb/ref 1074 "The region $D$ can be partitioned into two type I regions ${D}_{1}$ and ${D}_{2},$ as shown below. \n\n![](images/2f/2fcb30778db2f051a7a819ae701808af59ac18d27c25a9c57ce678caa6c3ee3b.png)\n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-1\\le x\\le 0,\\,{x}^{2}\\le y\\le -x\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{2}\\le y\\le x\\}.\n$$\n\n \n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2x\\,dA & ={∬}_{{D}_{1}}2x\\,dA+{∬}_{{D}_{2}}2x\\,dA \\\\  & ={\\int }_{-1}^{0}{\\int }_{{x}^{2}}^{-x}2x\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x}2x\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}2xy{|}_{{x}^{2}}^{-x}\\text{d}x+{\\int }_{0}^{1}2xy{|}_{{x}^{2}}^{x}\\text{d}x \\\\  & ={\\int }_{-1}^{0}2x[-x-{x}^{2}]\\text{d}x+{\\int }_{0}^{1}2x[x-{x}^{2}]\\text{d}x \\\\  & ={\\int }_{-1}^{0}(-2{x}^{2}-2{x}^{3})\\text{d}x+{\\int }_{0}^{1}(2{x}^{2}-2{x}^{3})\\text{d}x \\\\  & ={[-\\frac{2}{3}{x}^{3}-\\frac{1}{2}{x}^{4}]}_{-1}^{0}+{[\\frac{2}{3}{x}^{3}-\\frac{1}{2}{x}^{4}]}_{0}^{1} \\\\  & =((0-(-\\frac{2}{3}(-1)^{3}-\\frac{1}{2}(-1)^{4}))+((\\frac{2}{3}(1)^{3}-\\frac{1}{2}(1)^{4})-0)) \\\\  & =-\\frac{1}{6}+\\frac{1}{6} \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351419 #edb/ref 1068 #edb/ref 17592186351119 #edb/ref 17592186045417] [17592186351419 #edb/ref 1069 "q-82362" #edb/ref 17592186045417] [17592186351419 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186351419 #edb/ref 1071 "![](images/13/13275042f8b7b74e394b3cee1350c19cfa50ddf63899066682cbd0109f42d6bf.png)\n\nEvaluate ${∬}_{D}4xy\\,dA,$ where $D$ is the region shown in the picture above." #edb/ref 17592186045417] [17592186351419 #edb/ref 1072 #uuid "46c81894-7275-5b32-b94a-f373714d0ee2" #edb/ref 17592186045417] [17592186351419 #edb/ref 1074 "The region $D$ can be partitioned into two type II regions ${D}_{1}$ and ${D}_{2},$ as shown below.\n\n![](images/64/648121ff2a676f6a472a6e221dffe813eca55f914aed0ca9a285bb0d4cd81ab3.png)\n\n   \n\nAs a result, we get \n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 3\\},\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,2\\le x\\le 3,\\,0\\le y\\le 3\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}4xy\\,dA & ={∬}_{{D}_{1}}4xy\\,dA+{∬}_{{D}_{2}}4xy\\,dA \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{3}4xy\\,\\text{d}y\\,\\text{d}x+{\\int }_{2}^{3}{\\int }_{0}^{3}4xy\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{[2x{y}^{2}]}_{1}^{3}\\,\\text{d}x+{\\int }_{2}^{3}{[2x{y}^{2}]}_{0}^{3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}2x(9-1)\\,\\text{d}x+{\\int }_{2}^{3}2x(9-0)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}16x\\,\\text{d}x+{\\int }_{2}^{3}18x\\,\\text{d}x \\\\  & =8{x}^{2}{|}_{0}^{2}+9{x}^{2}{|}_{2}^{3} \\\\  & =8(4-0)+9(9-4) \\\\  & =77.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388258 #edb/ref 1068 #edb/ref 17592186388259 #edb/ref 17592186045417] [17592186388258 #edb/ref 1069 "q-132290" #edb/ref 17592186045417] [17592186388258 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186388258 #edb/ref 1071 "![](images/79/797cddb4ea3cb41959df88e56517e9ee71e76e3cd08a9a93d2957b9792d14abb.png)\n\nConsider the finite region $D$ in the $xy$-plane enclosed by the lines $y=-\\frac{2x}{3},$ $y=\\frac{4x}{3}$ and $y=\\frac{x}{3}+3,$ as shown in the picture. Express the double integral of the function $f(x,y)$ over the region $D$ as a sum of repeated integrals over type I regions." #edb/ref 17592186045417] [17592186388258 #edb/ref 1072 #uuid "7aeb314a-1c40-56e8-9c79-581f6c42093d" #edb/ref 17592186045417] [17592186388258 #edb/ref 1074 "The region $D$ can be partitioned into two type I regions ${D}_{1}$ and ${D}_{2},$ as shown below.\n\n![](images/0e/0e69b1cb480b87216273db4336adff57cbf9d9bc450aac4b0cdb58b1ae63f6f7.png)\n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-3\\le x\\le 0,\\,-\\frac{2x}{3}\\le y\\le \\frac{x}{3}+3\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\frac{4x}{3}\\le y\\le \\frac{x}{3}+3\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={∬}_{{D}_{1}}f(x,y)\\,dA+{∬}_{{D}_{2}}f(x,y)\\,dA \\\\  & ={\\int }_{-3}^{0}{\\int }_{-2x/3}^{x/3+3}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{3}{\\int }_{4x/3}^{x/3+3}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388259 #edb/ref 1075 #edb/ref 17592186388260 #edb/ref 17592186045417] [17592186388259 #edb/ref 1075 #edb/ref 17592186388261 #edb/ref 17592186045417] [17592186388259 #edb/ref 1075 #edb/ref 17592186388262 #edb/ref 17592186045417] [17592186388259 #edb/ref 1075 #edb/ref 17592186388263 #edb/ref 17592186045417] [17592186388259 #edb/ref 1075 #edb/ref 17592186388264 #edb/ref 17592186045417] [17592186388259 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186388259 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186388259 #edb/ref 1078 #edb/ref 17592186388262 #edb/ref 17592186045417] [17592186388259 #edb/ref 1079 #uuid "01d8ecb4-b73c-52f7-b5ea-ebc19c6bb540" #edb/ref 17592186045417] [17592186388260 #edb/ref 1080 "{\\int }_{-3}^{0}{\\in