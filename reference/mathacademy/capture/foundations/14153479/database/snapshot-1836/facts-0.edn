9039" #edb/ref 17592186045417] [17592186268840 #edb/ref 1075 #edb/ref 17592186266170 #edb/ref 17592186045417] [17592186268840 #edb/ref 1075 #edb/ref 17592186266896 #edb/ref 17592186045417] [17592186268840 #edb/ref 1075 #edb/ref 17592186267319 #edb/ref 17592186045417] [17592186268840 #edb/ref 1075 #edb/ref 17592186268134 #edb/ref 17592186045417] [17592186268840 #edb/ref 1075 #edb/ref 17592186268184 #edb/ref 17592186045417] [17592186268840 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268840 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268840 #edb/ref 1078 #edb/ref 17592186266896 #edb/ref 17592186045417] [17592186268840 #edb/ref 1079 #uuid "f6e5d9bc-6499-5164-b964-ecec40b5ee15" #edb/ref 17592186045417] [17592186268857 #edb/ref 1068 #edb/ref 17592186268423 #edb/ref 17592186045417] [17592186268857 #edb/ref 1069 "q-132292" #edb/ref 17592186045417] [17592186268857 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186268857 #edb/ref 1071 "Consider the finite region $D$ in the $xy$-plane enclosed by the curve $y=\\frac{{x}^{2}}{2}+2,$ and the lines $y=x+2,$ $x=-2$ and $x=2.$ Express ${∬}_{D}f(x,y)\\,dA$ as a sum of repeated integrals over type I regions." #edb/ref 17592186045417] [17592186268857 #edb/ref 1072 #uuid "30e25dca-92f8-5821-a1fd-77fa555fb29c" #edb/ref 17592186045417] [17592186268857 #edb/ref 1074 "First, let's sketch our region.\n\n![](images/01/019f0f9f83ddf323d543d109677335cb3ae72a200baf834453a0eca16a9353ba.png)\n\nThe region $D$ can be partitioned into two type I regions ${D}_{1}$ and ${D}_{2},$ as shown below.\n\n![](images/d2/d222e86f6af7c3ed2b35711114c9062d6f0c9b0f2551aa44cac33318c6e5813f.png)\n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-2\\le x\\le 0,\\,x+2\\le y\\le \\frac{{x}^{2}}{2}+2\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\frac{{x}^{2}}{2}+2\\le y\\le x+2\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={∬}_{{D}_{1}}f(x,y)\\,dA+{∬}_{{D}_{2}}f(x,y)\\,dA \\\\  & ={\\int }_{-2}^{0}{\\int }_{x+2}^{{x}^{2}/2+2}f(x,y)\\,dy\\,dx+{\\int }_{0}^{2}{\\int }_{{x}^{2}/2+2}^{x+2}f(x,y)\\,dy\\,dx.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186268861 #edb/ref 1068 #edb/ref 17592186268700 #edb/ref 17592186045417] [17592186268861 #edb/ref 1069 "q-132397" #edb/ref 17592186045417] [17592186268861 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186268861 #edb/ref 1071 "Consider the finite region $D$ in the $xy$-plane enclosed by the lines $y=-x,$ $y=6-4x$ and $y=2x.$ Express ${∬}_{D}f(x,y)\\,dA$ as a sum of repeated integrals over type II regions." #edb/ref 17592186045417] [17592186268861 #edb/ref 1072 #uuid "6b2a0247-2a7d-59f9-9d65-c62df94a034f" #edb/ref 17592186045417] [17592186268861 #edb/ref 1074 "First, let's write our equations in terms of $y,$ as follows:\n\n$$\n\\begin{aligned}y=-x & \\,⟹\\,x=-y \\\\ y=6-4x & \\,⟹\\,x=\\frac{3}{2}-\\frac{y}{4} \\\\ y=2x & \\,⟹\\,x=\\frac{y}{2}\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/08/08237d1ca2e01d0cf620dfa06a4265d8053b7ee34d0b65036aad7d5734726e1c.png)\n\n \n\nThe region $D$ can be partitioned into two type II regions ${D}_{1}$ and ${D}_{2},$ as shown below. \n\n![](images/c7/c756dc7924fc4c116601da907eb3b767b8a40647e063c146dad83b0ea660933b.png)\n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-2\\le y\\le 0,\\,-y\\le x\\le \\frac{3}{2}-\\frac{y}{4}\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\frac{y}{2}\\le x\\le \\frac{3}{2}-\\frac{y}{4}\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={∬}_{{D}_{1}}f(x,y)\\,dA+{∬}_{{D}_{2}}f(x,y)\\,dA \\\\  & ={\\int }_{-2}^{0}{\\int }_{-y}^{3/2-y/4}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{2}{\\int }_{y/2}^{3/2-y/4}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186268864 #edb/ref 1068 #edb/ref 17592186268840 #edb/ref 17592186045417] [17592186268864 #edb/ref 1069 "q-132423" #edb/ref 17592186045417] [17592186268864 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186268864 #edb/ref 1071 "![](images/a4/a4265e8993b5c7ea5756fe55facd5313e5c2237cbdbc851195ebf458e5246060.png)\n\nEvaluate ${∬}_{D}2y\\,dA,$ where $D$ is the region shown in the picture above." #edb/ref 17592186045417] [17592186268864 #edb/ref 1072 #uuid "c752feee-1897-55d8-b588-b76cf85bcde9" #edb/ref 17592186045417] [17592186268864 #edb/ref 1074 "The region $D$ can be partitioned into two type I regions ${D}_{1}$ and ${D}_{2},$ as shown below. \n\n![](images/33/33a38da74b282f0ec1fb2fae9cb155feb2a5fd39128c7607b80c6b84fedd29b4.png)\n\nAs a result, we get\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,x-1\\le y\\le 3-x\\}\n$$\n\nand \n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,2\\le x\\le 4,\\,3-x\\le y\\le x-1\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2y\\,dA & ={∬}_{{D}_{1}}2y\\,dA+{∬}_{{D}_{2}}2y\\,dA \\\\  & ={\\int }_{1}^{2}{\\int }_{x-1}^{3-x}2y\\,\\text{d}y\\,\\text{d}x+{\\int }_{2}^{4}{\\int }_{3-x}^{x-1}2y\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{y}^{2}\\,{|}_{x-1}^{3-x}\\,\\text{d}x+{\\int }_{2}^{4}{y}^{2}\\,{|}_{3-x}^{x-1}\\text{d}x \\\\  & ={\\int }_{1}^{2}[(3-x)^{2}-(x-1)^{2}]\\text{d}x+{\\int }_{2}^{4}[(x-1)^{2}-(3-x)^{2}]\\text{d}x \\\\  & ={\\int }_{1}^{2}(8-4x)\\text{d}x+{\\int }_{2}^{4}(4x-8)\\text{d}x \\\\  & =(8x-2{x}^{2}){|}_{1}^{2}+(2{x}^{2}-8x){|}_{2}^{4} \\\\  & =8(2-1)-2({2}^{2}-{1}^{2})+2({4}^{2}-{2}^{2})-8(4-2) \\\\  & =8-6+24-16 \\\\  & =10.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186321449 #edb/ref 1080 "\\frac{51}{4}" #edb/ref 17592186045417] [17592186321449 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321449 #edb/ref 1083 #uuid "2685a435-3b0b-5556-928d-8890e89f39c0" #edb/ref 17592186045417] [17592186322209 #edb/ref 1080 "\\frac{61}{5}" #edb/ref 17592186045417] [17592186322209 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322209 #edb/ref 1083 #uuid "85db0642-7d1c-5c8d-a791-5339d42f6b66" #edb/ref 17592186045417] [17592186322658 #edb/ref 1080 "-\\frac{81}{6}" #edb/ref 17592186045417] [17592186322658 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322658 #edb/ref 1083 #uuid "c2d61461-1e0a-5e92-8afb-016303b4ade2" #edb/ref 17592186045417] [17592186322689 #edb/ref 1080 "\\frac{71}{3}" #edb/ref 17592186045417] [17592186322689 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322689 #edb/ref 1083 #uuid "c6ee0989-2908-5bfb-9f66-c112c2783214" #edb/ref 17592186045417] [17592186322976 #edb/ref 1080 "\\frac{41}{6}" #edb/ref 17592186045417] [17592186322976 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186322976 #edb/ref 1083 #uuid "e9bcd73f-4f44-5e3e-887d-09a600ad1503" #edb/ref 17592186045417] [17592186323181 #edb/ref 1075 #edb/ref 17592186321449 #edb/ref 17592186045417] [17592186323181 #edb/ref 1075 #edb/ref 17592186322209 #edb/ref 17592186045417] [17592186323181 #edb/ref 1075 #edb/ref 17592186322658 #edb/ref 17592186045417] [17592186323181 #edb/ref 1075 #edb/ref 17592186322689 #edb/ref 17592186045417] [17592186323181 #edb/ref 1075 #edb/ref 17592186322976 #edb/ref 17592186045417] [17592186323181 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186323181 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186323181 #edb/ref 1078 #edb/ref 17592186322689 #edb/ref 17592186045417] [17592186323181 #edb/ref 1079 #uuid "07f87830-aaf6-5bb1-abec-9ce4771189f1" #edb/ref 17592186045417] [17592186323935 #edb/ref 1068 #edb/ref 17592186323181 #edb/ref 17592186045417] [17592186323935 #edb/ref 1069 "q-37767" #edb/ref 17592186045417] [17592186323935 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186323935 #edb/ref 1071 "![](images/8d/8de0dad0436135ef40aa26666d10659f4041275a915de153b6b4b45312c1c52f.png)\n\nEvaluate ${∬}_{D}{x}^{2}y\\,dA,$ where $D$ is the region shown in the picture above." #edb/ref 17592186045417] [17592186323935 #edb/ref 1072 #uuid "1e162c6a-7b02-5223-a553-b91cdf5010fb" #edb/ref 17592186045417] [17592186323935 #edb/ref 1074 "The region $D$ can be partitioned into three type II regions ${D}_{1},$ ${D}_{2},$ and ${D}_{3},$ as shown below.\n\n![](images/b5/b58fc3909d5be467999053336f67d41b88b43c984208c60f3d46ee8b7479df58.png)\n\nAs a result, we get \n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,-2\\le x\\le -1\\},\n$$\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,1\\le x\\le 2\\}\n$$\n\nand \n\n$$\n{D}_{3}=\\{(x,y)\\,:\\,1\\le y\\le 3,\\,-2\\le x\\le 2\\}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{x}^{2}y\\,dA & ={∬}_{{D}_{1}}{x}^{2}y\\,dA+{∬}_{{D}_{2}}{x}^{2}y\\,dA+{∬}_{{D}_{3}}{x}^{2}y\\,dA \\\\  & ={\\int }_{0}^{1}{\\int }_{-2}^{-1}{x}^{2}y\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{1}^{2}{x}^{2}y\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{3}{\\int }_{-2}^{2}{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{y\\text{ }\\,{x}^{3}}{3}]}_{-2}^{-1}\\,\\text{d}y+{\\int }_{0}^{1}{[\\frac{y\\text{ }\\,{x}^{3}}{3}]}_{1}^{2}\\,\\text{d}y+{\\int }_{1}^{3}{[\\frac{y\\text{ }\\,{x}^{3}}{3}]}_{-2}^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{7y}{3}\\,\\text{d}y+{\\int }_{0}^{1}\\frac{7y}{3}\\,\\text{d}y+{\\int }_{1}^{3}\\frac{16y}{3}\\,\\text{d}y \\\\  & =2\\cdot \\frac{7}{3}\\cdot {[\\frac{{y}^{2}}{2}]}_{0}^{1}+\\frac{16}{3}\\cdot {[\\frac{{y}^{2}}{2}]}_{1}^{3} \\\\  & =\\frac{7}{3}+\\frac{64}{3} \\\\  & =\\frac{71}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186348545 #edb/ref 1080 "{\\int }_{0}^{1/2}{\\int }_{1-y+e}^{\\operatorname{ln}⁡y}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1/2}^{e}{\\int }_{\\operatorname{ln}⁡y}^{1-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" #edb/ref 17592186045417] [17592186348545 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17