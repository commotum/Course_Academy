94948 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186494948 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186494948 #edb/ref 1078 #edb/ref 17592186494355 #edb/ref 17592186045417] [17592186494948 #edb/ref 1079 #uuid "46da6bbf-df72-58cf-ab47-22a431cba277" #edb/ref 17592186045417] [17592186495014 #edb/ref 1075 #edb/ref 17592186494352 #edb/ref 17592186045417] [17592186495014 #edb/ref 1075 #edb/ref 17592186494532 #edb/ref 17592186045417] [17592186495014 #edb/ref 1075 #edb/ref 17592186494730 #edb/ref 17592186045417] [17592186495014 #edb/ref 1075 #edb/ref 17592186494848 #edb/ref 17592186045417] [17592186495014 #edb/ref 1075 #edb/ref 17592186494881 #edb/ref 17592186045417] [17592186495014 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186495014 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186495014 #edb/ref 1078 #edb/ref 17592186494730 #edb/ref 17592186045417] [17592186495014 #edb/ref 1079 #uuid "cc8e448d-ca79-54b8-bab8-a1334af95399" #edb/ref 17592186045417] [17592186495049 #edb/ref 1068 #edb/ref 17592186494948 #edb/ref 17592186045417] [17592186495049 #edb/ref 1069 "q-118683" #edb/ref 17592186045417] [17592186495049 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186495049 #edb/ref 1071 "${\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186495049 #edb/ref 1072 #uuid "01e135d3-05cc-5121-8735-150ba42cbf5d" #edb/ref 17592186045417] [17592186495049 #edb/ref 1074 "First, we substitute $u=2x-3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x-3$ is as follows:\n\n| $x$ | $1$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-1$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-5}\\,\\text{d}x \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }{[\\frac{{u}^{-4}}{-4}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{4}}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }[1-\\frac{1}{{a}^{4}}] \\\\  & =-\\frac{1}{8}\\cdot (1-0) \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186495156 #edb/ref 1068 #edb/ref 17592186495014 #edb/ref 17592186045417] [17592186495156 #edb/ref 1069 "q-152780" #edb/ref 17592186045417] [17592186495156 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186495156 #edb/ref 1071 "Evaluate ${\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t.$" #edb/ref 17592186045417] [17592186495156 #edb/ref 1072 #uuid "e3a99356-f2d9-5da7-917f-fe8d47cb0308" #edb/ref 17592186045417] [17592186495156 #edb/ref 1074 "First, we substitute $u=3t-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=3\\,⟹\\,\\text{d}u=3\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=3t-2$ is as follows:\n\n| $t$ | $2$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $4$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t & ={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{\\infty }{u}^{-5/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{4}^{a}{u}^{-5/2}\\,\\text{d}u \\\\  & =\\cdot {lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{(a)^{3/2}}-\\frac{1}{(4)^{3/2}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186495225 #edb/ref 1062 #uuid "8ea1a116-b474-5b97-8117-34755770b888" #edb/ref 17592186045417] [17592186495225 #edb/ref 1063 #edb/ref 17592186320712 #edb/ref 17592186045417] [17592186495240 #edb/ref 1058 #edb/ref 17592186495269 #edb/ref 17592186045417] [17592186495240 #edb/ref 1062 #uuid "af144e75-8905-5e11-b96e-a2f91cc5bd59" #edb/ref 17592186045417] [17592186495240 #edb/ref 1063 #edb/ref 17592186495156 #edb/ref 17592186045417] [17592186495255 #edb/ref 1058 #edb/ref 17592186495240 #edb/ref 17592186045417] [17592186495255 #edb/ref 1062 #uuid "d36f2e0e-ef3b-5312-bd25-ac0395e3b0cb" #edb/ref 17592186045417] [17592186495255 #edb/ref 1063 #edb/ref 17592186495049 #edb/ref 17592186045417] [17592186495265 #edb/ref 1058 #edb/ref 17592186495255 #edb/ref 17592186045417] [17592186495265 #edb/ref 1062 #uuid "e86cd12e-6343-5c01-a6b5-bba0b3bd1814" #edb/ref 17592186045417] [17592186495265 #edb/ref 1063 #edb/ref 17592186083837 #edb/ref 17592186045417] [17592186495269 #edb/ref 1058 #edb/ref 17592186495225 #edb/ref 17592186045417] [17592186495269 #edb/ref 1062 #uuid "f46133c2-8521-5dce-9203-0f4254e54e86" #edb/ref 17592186045417] [17592186495269 #edb/ref 1063 #edb/ref 17592186319371 #edb/ref 17592186045417]}
