#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186495265} :activity/id #uuid "9628825a-c202-5d36-bd75-c73eb4a112e0" :activity/scope {:db/id #edb/ref 17592186048115 :topic/id #uuid "80368ff1-7296-5f6c-aa32-63547e29e578" :topic/math-academy-id 758} :activity/steps [{:db/id #edb/ref 17592186495225 :step/content {:db/id #edb/ref 17592186320712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f9a0336-53d4-5bf4-982f-e1f8dd06d1ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186319868}] :answer-field/correct {:db/id #edb/ref 17592186319868} :answer-field/id #uuid "484db524-b951-5719-aef0-f5c80cf2155c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320316}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "45df630e-f651-5e97-a712-bb9ab8cb5834" :question/math-academy-id "q-350540" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=2x+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x+1$ is as follows:\n\n| $x$ | $-\\infty $ | $-1$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-1$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x={\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u & =3{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-4}\\,\\text{d}u \\\\  & =3{lim}_{a\\to -\\infty }{[-\\frac{1}{3}{u}^{-3}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{3}}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{3}}-\\frac{1}{{a}^{3}}] \\\\  & =-(-1-0) \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "8ea1a116-b474-5b97-8117-34755770b888"} {:db/id #edb/ref 17592186495240 :step/content {:db/id #edb/ref 17592186495156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aeb1d6-3a6d-5d19-bcaa-cfdc021ab9c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral diverges" :db/id #edb/ref 17592186494352} {:answer/id #uuid "695c0ea1-77ec-56ce-a589-ce5482b85acc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186494532} {:answer/id #uuid "b03dad7b-0e07-5cb2-b401-99a18df64f52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186494730} {:answer/id #uuid "e02b37dc-ebae-57b4-af31-87e189cd4c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186494848} {:answer/id #uuid "ed16ccaa-3b79-5f36-a20f-c1259e6c3bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186494881}] :answer-field/correct {:db/id #edb/ref 17592186494730} :answer-field/id #uuid "cc8e448d-ca79-54b8-bab8-a1334af95399" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495014}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e3a99356-f2d9-5da7-917f-fe8d47cb0308" :question/math-academy-id "q-152780" :question/problem "Evaluate ${\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t.$" :question/worked-solution "First, we substitute $u=3t-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=3\\,⟹\\,\\text{d}u=3\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=3t-2$ is as follows:\n\n| $t$ | $2$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $4$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t & ={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{\\infty }{u}^{-5/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{4}^{a}{u}^{-5/2}\\,\\text{d}u \\\\  & =\\cdot {lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{(a)^{3/2}}-\\frac{1}{(4)^{3/2}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"} :step/id #uuid "af144e75-8905-5e11-b96e-a2f91cc5bd59" :step/next {:db/id #edb/ref 17592186495269}} {:db/id #edb/ref 17592186495255 :step/content {:db/id #edb/ref 17592186495049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1449b75d-0e64-501c-8d2a-cce137f4b608" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186494355} {:answer/id #uuid "16ccf152-39ad-58ab-b622-b32a7cb53d17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186494362} {:answer/id #uuid "34be0800-1b32-5b90-8444-e88edf6c9a34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186494423} {:answer/id #uuid "47fea95f-c75b-556a-9356-f42d7572185d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494462} {:answer/id #uuid "72662bf2-ec94-5cdc-8665-4b665b80f3e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186494563}] :answer-field/correct {:db/id #edb/ref 17592186494355} :answer-field/id #uuid "46da6bbf-df72-58cf-ab47-22a431cba277" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494948}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "01e135d3-05cc-5121-8735-150ba42cbf5d" :question/math-academy-id "q-118683" :question/problem "${\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x=$" :question/worked-solution "First, we substitute $u=2x-3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x-3$ is as follows:\n\n| $x$ | $1$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-1$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-5}\\,\\text{d}x \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }{[\\frac{{u}^{-4}}{-4}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{4}}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }[1-\\frac{1}{{a}^{4}}] \\\\  & =-\\frac{1}{8}\\cdot (1-0) \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$"} :step/id #uuid "d36f2e0e-ef3b-5312-bd25-ac0395e3b0cb" :step/next {:db/id #edb/ref 17592186495240}} {:db/id #edb/ref 17592186495265 :step/content {:db/id #edb/ref 17592186083837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd9b6d3c-0057-574c-87f0-e4101749ea2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186377616} {:answer/id #uuid "3737c8d2-a0da-5074-ba6f-697e878e8a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186377617} {:answer/id #uuid "d2c32b1a-b4cd-59d4-99ae-00c65bacae91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral is divergent" :db/id #edb/ref 17592186377618} {:answer/id #uuid "d2acd056-6854-53f2-9f3f-d23ce96038ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186377619} {:answer/id #uuid "1eac7a83-db29-5df2-847e-ba35f30a046a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\operatorname{ln}⁡(2)}" :db/id #edb/ref 17592186377620}] :answer-field/correct {:db/id #edb/ref 17592186377618} :answer-field/id #uuid "88a03e6d-8814-51d2-8edb-239663fe528e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186377615}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "322fb4b3-6749-5356-82bf-9541f4f0d3ad" :question/math-academy-id "q-6294" :question/problem "${\\int }_{0}^{\\infty }\\frac{1}{2x+1}\\,\\text{d}x=$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{2x+1}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{2x+1}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[\\frac{1}{2}\\cdot \\operatorname{ln}⁡|2x+1|]}_{0}^{a} \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{[\\operatorname{ln}⁡|2x+1|]}_{0}^{a} \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }(\\operatorname{ln}⁡|2a+1|-\\operatorname{ln}⁡|1|) \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }(\\operatorname{ln}⁡|2a+1|) \\\\  & =\\frac{1}{2}\\cdot (\\infty ) \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."} :step/id #uuid "e86cd12e-6343-5c01-a6b5-bba0b3bd1814" :step/next {:db/id #edb/ref 17592186495255}} {:db/id #edb/ref 17592186495269 :step/content {:db/id #edb/ref 17592186319371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c05ccd85-237f-566b-a79f-e8d9590a5726" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186318202}] :answer-field/correct {:db/id #edb/ref 17592186318202} :answer-field/id #uuid "624feba0-3d98-5dfb-b8fe-2f49ece6f4cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186318634}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e009094e-338f-5586-9e0b-28bba5f98113" :question/math-academy-id "q-350331" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{\\int }_{1}^{a}{y}^{-8/3}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{[-\\frac{3}{5}{y}^{-5/3}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{{y}^{5}}}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{{a}^{5}}}-\\frac{1}{\\sqrt[3]{{1}^{5}}}) \\\\  & =-3(0-1) \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "f46133c2-8521-5dce-9203-0f4254e54e86" :step/next {:db/id #edb/ref 17592186495225}}] :activity/title "Improper Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494310}]}
