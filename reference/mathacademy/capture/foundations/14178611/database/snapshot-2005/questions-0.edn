#{[{:db/id #edb/ref 17592186319371 :knowledge-point/_questions [{:db/id #edb/ref 17592186083195 :knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c05ccd85-237f-566b-a79f-e8d9590a5726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318202}] :answer-field/correct {:answer/id #uuid "c05ccd85-237f-566b-a79f-e8d9590a5726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318202} :answer-field/id #uuid "624feba0-3d98-5dfb-b8fe-2f49ece6f4cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e009094e-338f-5586-9e0b-28bba5f98113" :question/math-academy-id "q-350331" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{\\int }_{1}^{a}{y}^{-8/3}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{[-\\frac{3}{5}{y}^{-5/3}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{{y}^{5}}}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{{a}^{5}}}-\\frac{1}{\\sqrt[3]{{1}^{5}}}) \\\\  & =-3(0-1) \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320712 :knowledge-point/_questions [{:db/id #edb/ref 17592186083200 :knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Lower Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f9a0336-53d4-5bf4-982f-e1f8dd06d1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319868}] :answer-field/correct {:answer/id #uuid "9f9a0336-53d4-5bf4-982f-e1f8dd06d1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319868} :answer-field/id #uuid "484db524-b951-5719-aef0-f5c80cf2155c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45df630e-f651-5e97-a712-bb9ab8cb5834" :question/math-academy-id "q-350540" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=2x+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x+1$ is as follows:\n\n| $x$ | $-\\infty $ | $-1$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-1$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x={\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u & =3{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-4}\\,\\text{d}u \\\\  & =3{lim}_{a\\to -\\infty }{[-\\frac{1}{3}{u}^{-3}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{3}}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{3}}-\\frac{1}{{a}^{3}}] \\\\  & =-(-1-0) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083837 :knowledge-point/_questions [{:db/id #edb/ref 17592186083201 :knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00" :knowledge-point/title "Identifying Divergent Improper Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a05f443-cd9a-598f-a9ae-c4349667382f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\ln (2)" :db/id #edb/ref 17592186081954} {:answer/id #uuid "df3a4679-7471-577a-861c-2625ed7ffca0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1)/(\\ln (2))" :db/id #edb/ref 17592186081955} {:answer/id #uuid "468596aa-3bff-52e3-a8fe-04acbcbe758a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186081956} {:answer/id #uuid "5e0ce69d-d45d-56fb-936d-2c902f48ecce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186081957} {:answer/id #uuid "72633a19-e145-5976-9043-e1c1144756e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186081958}] :answer-field/id #uuid "be0c1132-fc63-58d6-b4f4-f42202ba3f5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186081953} {:answer-field/choices [{:answer/id #uuid "dd9b6d3c-0057-574c-87f0-e4101749ea2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186377616} {:answer/id #uuid "3737c8d2-a0da-5074-ba6f-697e878e8a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186377617} {:answer/id #uuid "d2c32b1a-b4cd-59d4-99ae-00c65bacae91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186377618} {:answer/id #uuid "d2acd056-6854-53f2-9f3f-d23ce96038ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186377619} {:answer/id #uuid "1eac7a83-db29-5df2-847e-ba35f30a046a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡(2)}" :db/id #edb/ref 17592186377620}] :answer-field/correct {:answer/id #uuid "d2c32b1a-b4cd-59d4-99ae-00c65bacae91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186377618} :answer-field/id #uuid "88a03e6d-8814-51d2-8edb-239663fe528e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "322fb4b3-6749-5356-82bf-9541f4f0d3ad" :question/math-academy-id "q-6294" :question/problem "${\\int }_{0}^{\\infty }\\frac{1}{2x+1}\\,\\text{d}x=$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{2x+1}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{2x+1}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[\\frac{1}{2}\\cdot \\operatorname{ln}⁡|2x+1|]}_{0}^{a} \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{[\\operatorname{ln}⁡|2x+1|]}_{0}^{a} \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }(\\operatorname{ln}⁡|2a+1|-\\operatorname{ln}⁡|1|) \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }(\\operatorname{ln}⁡|2a+1|) \\\\  & =\\frac{1}{2}\\cdot (\\infty ) \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."}]}
