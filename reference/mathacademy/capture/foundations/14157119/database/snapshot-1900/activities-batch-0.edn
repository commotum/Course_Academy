#{[{:activity/first-step {:db/id #edb/ref 17592186125440} :activity/id #uuid "9faeb18a-39f2-528b-927a-5e59d0f90fc7" :activity/scope {:db/id #edb/ref 17592186048582 :topic/id #uuid "ab43842c-a68a-5473-977a-14bce3aa134e" :topic/math-academy-id 1967} :activity/steps [{:db/id #edb/ref 17592186125440 :step/content {:db/id #edb/ref 17592186125799 :tutorial/content "Let's suppose we have the linear map\n\n$$\n\\mathbf T: {\\color{blue}V} \\to {\\color{red}W}\n$$\n\nwhere the bases of the vector spaces $\\color{blue}V$ and ${\\color{red}W}$ respectively are given by\n\n$$\n{\\color{blue}\\mathcal{B}}=\\{ {\\color{blue}\\mathbf{b}_1},{\\color{blue}\\mathbf{b}_2}, {\\color{blue}\\mathbf{b}_3} \\}, \\qquad \\qquad {\\color{red}\\mathcal{C}} = \\{ {\\color{red}\\mathbf{c}_1},{\\color{red}\\mathbf{c}_2} \\}.\n$$\n\nThe **matrix of $\\mathbf{T}$ with respect to the bases $\\color{blue}\\mathcal{B}$ and $\\color{red}\\mathcal{C}$** is the matrix whose columns are the coordinates of the vectors $\\mathbf{T}({\\color{blue}\\mathbf{b}_1}),$ $\\mathbf{T}(\\color{blue}{\\mathbf{b}_2}),$ and $\\mathbf{T}({\\color{blue}\\mathbf{b}_3})$ relative to the basis ${\\color{red}\\mathcal{C}}\\mathbin{:}$\n\n$$\n\\begin{aligned}[T]_{B|C} & =[\\begin{aligned}| & | & | \\\\ [T({b}_{1})]_{C} & [T({b}_{2})]_{C} & [T({b}_{3})]_{C} \\\\ | & | & |\\end{aligned}]\\end{aligned}\n$$\n\nFor example, if \n\n$$\n[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nthen\n\n$$\n\\begin{aligned}[T]_{B|C} & =[\\begin{aligned}3 & 10 & -12 \\\\ 1 & -1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nIn general, given a linear transformation [math]\\mathbf{T}\\!:{\\color{black}V}\\!\\rightarrow {\\color{black}W}[/math], where the vector spaces [math]\\color{black}V[/math] and [math]\\color{black}W[/math] have the bases [math]{\\color{black}\\mathcal{B}}=\\{ {\\color{black}\\mathbf{b}_1}, {\\color{black}\\ldots}, {\\color{black}\\mathbf{b}_n} \\}[/math] and [math]{\\color{black}\\mathcal{C}}= \\{ {\\color{black}\\mathbf{c}_1}, {\\color{black}\\ldots}, {\\color{black}\\mathbf{c}_m} \\}[/math] respectively, the matrix of the map [math]\\mathbf{T}[/math] with respect to the bases [math]\\color{black}\\mathcal{B}[/math] and [math]\\color{black}\\mathcal{C}[/math] is constructed in the same way:\n\\[\n\t[\\mathbf{T}]_{{\\color{black}\\mathcal{B}}|{\\color{black}\\mathcal{C}}} = \n\t\\begin{bmatrix}\n\t\t\\vert &  & \\vert \\\\\n\t\t[\\mathbf{T}({\\color{black}\\mathbf{b}_1})]_{\\color{black}\\mathcal{C}} \n\t\t& \\cdots & \n\t\t[\\mathbf{T}({\\color{black}\\mathbf{b}_n})]_{\\color{black}\\mathcal{C}} \\\\\n\t\t\\vert &  & \\vert \n\t\\end{bmatrix}.\n\\]" :tutorial/id #uuid "da91373e-0973-56a4-91c9-aa2a2b1de0b1" :tutorial/math-academy-id 3589 :tutorial/title "Introduction"} :step/id #uuid "9ee24e02-1f78-5b25-8d1c-f19b4a0052ee" :step/math-academy-id 20152 :step/next {:db/id #edb/ref 17592186125546}} {:db/id #edb/ref 17592186125441 :step/content {:db/id #edb/ref 17592186124542 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124351 :question/id #uuid "e9539818-ad55-5bb3-8c5d-5b85303f9e6d" :question/math-academy-id "e-5521"} :knowledge-point/id #uuid "84947238-f446-5261-8ecd-ee263f64e04f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050252}] :knowledge-point/questions [{:db/id #edb/ref 17592186125124} {:db/id #edb/ref 17592186125129} {:db/id #edb/ref 17592186326723} {:db/id #edb/ref 17592186362215} {:db/id #edb/ref 17592186362216} {:db/id #edb/ref 17592186364996} {:db/id #edb/ref 17592186388695} {:db/id #edb/ref 17592186392238}] :knowledge-point/title "Finding the Image of a Vector Under a Linear Map Given the Matrix Relative to Two Bases"} :step/id #uuid "d4cf88b7-d61d-5b12-a8f6-f786898cb8c3" :step/math-academy-id 20154 :step/next {:db/id #edb/ref 17592186125442}} {:db/id #edb/ref 17592186125442 :step/content {:db/id #edb/ref 17592186124543 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124352 :question/id #uuid "8a371b65-8c57-5d10-88aa-2d4928fb028c" :question/math-academy-id "e-5522"} :knowledge-point/id #uuid "8725caed-481c-5fbe-a0c4-cffdcb308881" :knowledge-point/questions [{:db/id #edb/ref 17592186125130} {:db/id #edb/ref 17592186125253} {:db/id #edb/ref 17592186272091} {:db/id #edb/ref 17592186362217} {:db/id #edb/ref 17592186392205} {:db/id #edb/ref 17592186395295} {:db/id #edb/ref 17592186395302} {:db/id #edb/ref 17592186395309}] :knowledge-point/title "Finding the Image of a Vector Given With Respect to the Standard Basis Under a Linear Map"} :step/id #uuid "80774b4b-be41-5637-b9a9-f728e8911827" :step/math-academy-id 20155} {:db/id #edb/ref 17592186125546 :step/content {:db/id #edb/ref 17592186124603 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124415 :question/id #uuid "01b46867-ba6d-5085-9543-b77ded581194" :question/math-academy-id "e-8604"} :knowledge-point/id #uuid "a7f1e542-f0a2-54ea-ba7f-0a9928415907" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050065}] :knowledge-point/questions [{:db/id #edb/ref 17592186125127} {:db/id #edb/ref 17592186125128} {:db/id #edb/ref 17592186272084} {:db/id #edb/ref 17592186326689} {:db/id #edb/ref 17592186326724}] :knowledge-point/title "Finding the Matrix of a Linear Map Relative to Two Bases Using the Definition"} :step/id #uuid "a48f8724-cd55-576f-8431-f47c3d90338a" :step/math-academy-id 31941 :step/next {:db/id #edb/ref 17592186125547}} {:db/id #edb/ref 17592186125547 :step/content {:db/id #edb/ref 17592186124604 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124416 :question/id #uuid "3d6b0aec-c282-581e-ae4a-560654d80e3b" :question/math-academy-id "e-8605"} :knowledge-point/id #uuid "0587fad6-5ef2-5200-9b60-ddbd0bc21ba7" :knowledge-point/questions [{:db/id #edb/ref 17592186125131} {:db/id #edb/ref 17592186125142} {:db/id #edb/ref 17592186362212} {:db/id #edb/ref 17592186362213} {:db/id #edb/ref 17592186362214} {:db/id #edb/ref 17592186364989} {:db/id #edb/ref 17592186388688} {:db/id #edb/ref 17592186395276}] :knowledge-point/title "Finding the Matrix of a Linear Map Relative to Two Bases Given One Basis"} :step/id #uuid "f3a9b6e8-c0c7-5e91-a3fa-8081e91b886a" :step/math-academy-id 31942 :step/next {:db/id #edb/ref 17592186125548}} {:db/id #edb/ref 17592186125548 :step/content {:db/id #edb/ref 17592186125843 :tutorial/content "Given the matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of a linear map $\\mathbf{T}:V \\to W$ relative to the bases $\\mathcal{B}$ and $\\mathcal{C},$ and the coordinates $[\\mathbf{x}]_{\\mathcal{B}}$ of a vector $\\mathbf{x}$ relative to $\\mathcal{B},$ the image of $\\mathbf{x}$ under $\\mathbf{T}$ with respect to the basis $\\mathcal{C}$ can be found as \n\n$$\n[\\mathbf{T}(\\mathbf{x})]_{\\mathcal{C}} = \n[\\mathbf{T}]_{{\\mathcal{B}}|{\\mathcal{C}}}\\cdot [\\mathbf{x}]_{\\mathcal{B}}\n$$\n\nFor example, if\n\n$$\n[\\begin{aligned}1 & 3 & -2 \\\\ 1 & 2 & 0\\end{aligned}]\n$$\n\nthen the image of $\\mathbf x$ under $\\mathbf T$ relative to $\\mathcal C$ is given by\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[\\begin{aligned}1 & 3 & -2 \\\\ 1 & 2 & 0\\end{aligned}][\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$" :tutorial/id #uuid "db73b6f4-55d4-5d30-856e-463bc6cc9964" :tutorial/math-academy-id 5093 :tutorial/title "The Image of a Vector Under a Linear Map Given by a Matrix Relative to Two Bases"} :step/id #uuid "14e61c95-f43b-5c3d-8e38-75c4db0838d1" :step/math-academy-id 31944 :step/next {:db/id #edb/ref 17592186125441}}] :activity/title "The Matrix of a Linear Map Relative to Two Bases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124752}]}
