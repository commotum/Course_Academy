pt\">C</mi></mrow></mrow></msub></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">[</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><msub><mo stretchy=\"false\">]</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">B</mi></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">C</mi></mrow></mrow></mrow></msub><mo>⋅</mo><mo stretchy=\"false\">[</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><msub><mo stretchy=\"false\">]</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">B</mi></mrow></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>3</mn></mtd><mtd><mn>7</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>8</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>6</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mn>11</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mn>5</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-