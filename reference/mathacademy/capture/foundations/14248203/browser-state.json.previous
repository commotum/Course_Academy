              "html": " <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"4\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-msubsup><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\" texclass=\"ORD\" style=\"margin-left: 0.647em;\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 0.9em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 0.9em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-texatom><mjx-spacer style=\"margin-top: 1.372em;\"></mjx-spacer><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-script></mjx-msubsup><mjx-msubsup space=\"2\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\" texclass=\"ORD\" style=\"margin-left: 0.647em;\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 3.881em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 3.881em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.281em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-box></mjx-sqrt></mjx-msqrt><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-texatom><mjx-spacer style=\"margin-top: 1.077em;\"></mjx-spacer><mjx-texat