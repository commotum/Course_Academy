{sin}⁡(5t)" #edb/ref 17592186045417] [17592186499194 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499194 #edb/ref 1083 #uuid "d1098f1c-859a-50c4-99fe-1eb8a2a4e374" #edb/ref 17592186045417] [17592186499197 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186499197 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499197 #edb/ref 1083 #uuid "d23c71b1-938d-5c3c-896d-64a1b9e36fad" #edb/ref 17592186045417] [17592186499230 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186499230 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499230 #edb/ref 1083 #uuid "e06340a0-7e4c-5772-a063-3ea903fbcb38" #edb/ref 17592186045417] [17592186499238 #edb/ref 1080 "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+5q=10" #edb/ref 17592186045417] [17592186499238 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499238 #edb/ref 1083 #uuid "e1b404c5-802e-5a1a-a90d-3dcb65998bd8" #edb/ref 17592186045417] [17592186499242 #edb/ref 1080 "\\frac{{d}^{2}q}{d{t}^{2}}+4\\,\\frac{dq}{dt}+10q=3\\operatorname{cos}⁡(5t)" #edb/ref 17592186045417] [17592186499242 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499242 #edb/ref 1083 #uuid "e39afebc-fd32-5996-9855-d2bef0af1a4f" #edb/ref 17592186045417] [17592186499246 #edb/ref 1080 "\\frac{3}{4}" #edb/ref 17592186045417] [17592186499246 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499246 #edb/ref 1083 #uuid "e4a70e6b-af1c-5577-8af3-126ce8b4aabf" #edb/ref 17592186045417] [17592186499288 #edb/ref 1080 "\\frac{{d}^{2}q}{d{t}^{2}}+2\\,\\frac{dq}{dt}+0.1q=3\\operatorname{cos}⁡(5t)" #edb/ref 17592186045417] [17592186499288 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186499288 #edb/ref 1083 #uuid "f8fc04d2-ee9b-5d88-9e30-1df86999a8e8" #edb/ref 17592186045417] [17592186499290 #edb/ref 1080 "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+5q=\\frac{1}{5}" #edb/ref 17592186045417] [17592186499290 #edb/ref 10