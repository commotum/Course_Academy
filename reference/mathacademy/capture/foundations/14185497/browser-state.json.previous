      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345128-384e3f1b2d22cf7139d1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345128-384e3f1b2d22cf7139d1.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791921084.0286524,
      "math_academy_id": "q-345128",
      "topic_id": "1845",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q345128",
        "placement_id": null,
        "content_id": null,
        "type": null
