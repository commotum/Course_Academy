      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345098-8d9ecd3b08b4335e1732.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345098-8d9ecd3b08b4335e1732.png",
