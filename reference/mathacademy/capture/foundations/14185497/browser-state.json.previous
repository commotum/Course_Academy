      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345126-902c5588a1b999a4c78d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345126-902c5588a1b999a4c78d.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791921034.29918,
      "math_academy_id": "q-345126",
      "topic_id": "1845",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q345126",
        "placement_id": null,
        "content_id": null,
