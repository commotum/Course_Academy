      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345129-843d798601960fe7762c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345129-843d798601960fe7762c.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791921108.0692937,
      "math_academy_id": "q-345129",
      "topic_id": "1845",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q345129",
        "placement_id": null,
        "content_id": null,
