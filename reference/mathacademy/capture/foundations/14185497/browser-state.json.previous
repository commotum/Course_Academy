          "html": "<img src=\"/graphics/q-345130\">",
          "extraction_part": "problem",
          "dom_index": 0,
          "source_url": "https://mathacademy.com/graphics/q-345130",
          "render_ready": true,
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/assets/50bb98a563a0ee061a0faa4d4390aaf459a2fdfccb4721d5d7e6ddd3102c98b1.png",
          "sha256": "50bb98a563a0ee061a0faa4d4390aaf459a2fdfccb4721d5d7e6ddd3102c98b1",
