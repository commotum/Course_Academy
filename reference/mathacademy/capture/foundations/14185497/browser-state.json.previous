          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:35px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"109\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"111\"><span class=\"mq-numerator\" mathquill-block-id=\"113\"><span mathquill-command-id=\"112\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"115\"><span mathquill-command-id=\"114\">2</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "12​",
          "choices_complete": false
        }
