      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345106-80bf04f5ad316a61468e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345106-80bf04f5ad316a61468e.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791920937.7048986,
      "math_academy_id": "q-345106",
      "topic_id": "1845",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q345106",
        "placement_id": null,
        "content_id": null,
