      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345120-b2adea72508c54a6fd92.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345120-b2adea72508c54a6fd92.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791920882.7884054,
      "math_academy_id": "q-345120",
