      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345144-97b76a5012ec6a367c91.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14185497/observations/step-q345144-97b76a5012ec6a367c91.png",
      "source_url": "https://mathacademy.com/tasks/14185497/topics/1845/lesson",
      "captured_at": 1791921217.0568397,
      "math_academy_id": "q-345144",
