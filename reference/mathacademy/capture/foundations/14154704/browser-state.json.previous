rt></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><msqrt><mn>3</mn></msqrt></mrow></mtd></mtr><mtr><mtd><mi>ϕ</mi></mtd><mtd><mi></mi><mo>=</mo><mi>arctan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><msqrt><mn>3</mn></msqrt></mrow><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>ϕ</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>60</mn></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><msup><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>∘</mo></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
