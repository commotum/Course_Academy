      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226903/observations/step-q127223-d0ffc29a78d964d45e23.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226903/observations/step-q127223-d0ffc29a78d964d45e23.png",
      "source_url": "https://mathacademy.com/tasks/14226903/topics/3716/review",
