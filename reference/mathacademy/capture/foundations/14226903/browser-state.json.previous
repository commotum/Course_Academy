      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226903/observations/step-q127149-88b84478a0d69a383f96.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226903/observations/step-q127149-88b84478a0d69a383f96.png",
      "source_url": "https://mathacademy.com/tasks/14226903/topics/3716/review",
