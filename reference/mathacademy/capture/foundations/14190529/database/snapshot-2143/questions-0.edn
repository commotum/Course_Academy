#{[{:db/id #edb/ref 17592186179909 :knowledge-point/_questions [{:db/id #edb/ref 17592186179688 :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143af2bb-452a-5104-bc81-562dee768a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2x){e}^{2x}+2xz" :db/id #edb/ref 17592186238219} {:answer/id #uuid "7c350bea-10b9-5854-9b70-41a8fa29fd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{2x}+xz" :db/id #edb/ref 17592186239128} {:answer/id #uuid "99cb3b1b-8973-5a5f-b31a-75e39652f5ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{2x}+{z}^{2}" :db/id #edb/ref 17592186239390} {:answer/id #uuid "bb06be3e-7cda-5bd7-9ebe-adf35ee7424b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+x){e}^{2x}+xz" :db/id #edb/ref 17592186239682} {:answer/id #uuid "eb86eb60-f49f-59ee-9e69-1943bea23394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x}+z" :db/id #edb/ref 17592186240127}] :answer-field/correct {:answer/id #uuid "7c350bea-10b9-5854-9b70-41a8fa29fd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{2x}+xz" :db/id #edb/ref 17592186239128} :answer-field/id #uuid "ea3400a6-fe4f-5f4f-afae-01b7fad81fd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240740}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "208c1557-4948-59e8-ace1-5a9ccf87465a" :question/math-academy-id "q-105633" :question/problem "Calculate $∇\\cdot (\\frac{1}{2}F)$ for the vector field $F$ where\n\n$$\nF=x{e}^{2x}\\,i-y{e}^{2x}\\,j+x{z}^{2}\\,k.\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F)=\\frac{1}{2}∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}(x{e}^{2x})+\\frac{∂}{∂y}(-y{e}^{2x})+\\frac{∂}{∂z}(x{z}^{2}) \\\\  & ={e}^{2x}+2x{e}^{2x}-{e}^{2x}+2xz \\\\  & =2x{e}^{2x}+2xz.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F) & =\\frac{1}{2}∇\\cdot F \\\\  & =\\frac{1}{2}\\cdot (2x{e}^{2x}+2xz) \\\\  & =x{e}^{2x}+xz.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505751 :knowledge-point/_questions [{:db/id #edb/ref 17592186179688 :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04afe455-673f-5b0e-a6fd-b296db94bc7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\,{e}^{\\operatorname{sin}⁡x}-6y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505114} {:answer/id #uuid "4665da7c-47c6-56a6-8a63-2cd951c60e91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\,{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186505249} {:answer/id #uuid "54b3d62c-789b-5344-8eb8-1b87f779cb9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}+6y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505274} {:answer/id #uuid "da097bd7-2039-56d9-b3a9-5eda69cefcfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186505523} {:answer/id #uuid "e85c3dd7-de42-550d-b590-57c43fa3e773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}-12y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505558}] :answer-field/correct {:answer/id #uuid "da097bd7-2039-56d9-b3a9-5eda69cefcfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186505523} :answer-field/id #uuid "4ffd1f69-02c8-5ee4-adf9-edd55635cbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505646}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2c768058-b351-51d4-a894-a96f2a63f5a2" :question/math-academy-id "q-105639" :question/problem "Calculate $∇\\cdot (3F+2G)$ for the vector fields $F$ and $G,$ where\n\n$$\nF={e}^{\\operatorname{sin}⁡x}\\,i+\\operatorname{cos}⁡({y}^{2})\\,j,\\,∇\\cdot G=3y\\operatorname{sin}⁡({y}^{2}).\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (3F+2G) & =∇\\cdot (3F)+∇\\cdot (2G) \\\\  & =3∇\\cdot F+2∇\\cdot G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({e}^{\\operatorname{sin}⁡x})+\\frac{∂}{∂y}(\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\operatorname{cos}⁡x{e}^{\\operatorname{sin}⁡x}-2y\\operatorname{sin}⁡({y}^{2}).\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (3F+2G) & =3∇\\cdot F+2∇\\cdot G \\\\  & =3(\\operatorname{cos}⁡x{e}^{\\operatorname{sin}⁡x}-2y\\operatorname{sin}⁡({y}^{2}))+2\\cdot (3y\\operatorname{sin}⁡({y}^{2})) \\\\  & =3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}-6y\\operatorname{sin}⁡({y}^{2})+6y\\operatorname{sin}⁡({y}^{2}) \\\\  & =3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366829 :knowledge-point/_questions [{:db/id #edb/ref 17592186179690 :knowledge-point/id #uuid "44d953c5-21bb-5326-bfac-e793cfe26cd2" :knowledge-point/title "Finding the Divergence of a Vector Field Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb80e6b3-5eec-5bc1-b118-b2f215f56474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(y-x){e}^{-x}-x(x+y){e}^{y}" :db/id #edb/ref 17592186366831} {:answer/id #uuid "f71527c4-7d0b-5d0c-824e-c74e01fec90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-x){e}^{-x}-(x+y){e}^{y}" :db/id #edb/ref 17592186366832} {:answer/id #uuid "45d127b0-856e-53d2-9108-fa49820d507a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1-x){e}^{-x}-x(1+y){e}^{y}" :db/id #edb/ref 17592186366833} {:answer/id #uuid "482f638e-33f3-58fb-9ace-068365945fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2-x){e}^{-x}+x(2+y){e}^{y}" :db/id #edb/ref 17592186366834} {:answer/id #uuid "5d73ac97-8242-529d-aec9-f7267dcb85b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1+x){e}^{-x}+x(1-y){e}^{y}" :db/id #edb/ref 17592186366835}] :answer-field/correct {:answer/id #uuid "45d127b0-856e-53d2-9108-fa49820d507a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1-x){e}^{-x}-x(1+y){e}^{y}" :db/id #edb/ref 17592186366833} :answer-field/id #uuid "03cf2268-b570-5c67-90e0-2744f755a552" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366830}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b1a781a-78fd-56cb-a627-519454aac978" :question/math-academy-id "q-105654" :question/problem "Given that $F(x,y)=⟨y{e}^{-x},-y{e}^{y}⟩$ and $f(x,y)=x,$ calculate $∇\\cdot (f\\,F).$" :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨1,0⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(y{e}^{-x})+\\frac{∂}{∂y}(-y{e}^{y})=-y{e}^{-x}-{e}^{y}-y{e}^{y}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =x(-y{e}^{-x}-{e}^{y}-y{e}^{y})+⟨y{e}^{-x},-y{e}^{y}⟩\\cdot ⟨1,0⟩ \\\\  & =-yx{e}^{-x}-x{e}^{y}-yx{e}^{y}+y{e}^{-x} \\\\  & =y{e}^{-x}-yx{e}^{-x}-x{e}^{y}-yx{e}^{y} \\\\  & =y(1-x){e}^{-x}-x(1+y){e}^{y}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505762 :knowledge-point/_questions [{:db/id #edb/ref 17592186179688 :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321ce1f2-898d-5430-9186-5d15072c22b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-12{y}^{2}" :db/id #edb/ref 17592186505192} {:answer/id #uuid "40bcbcfd-b0a9-5f9e-b620-2401616f5850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1-12{y}^{2}" :db/id #edb/ref 17592186505229} {:answer/id #uuid "51f59a6c-efd5-5c01-9c0b-9478a549ed93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xyz+{y}^{2}+1" :db/id #edb/ref 17592186505267} {:answer/id #uuid "558eb743-ed39-5b77-8c92-39d8417ede55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{y}^{2}+1" :db/id #edb/ref 17592186505275} {:answer/id #uuid "f9c811ea-cec4-5a24-807f-3cb9271e236c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16xyz-12{y}^{2}" :db/id #edb/ref 17592186505593}] :answer-field/correct {:answer/id #uuid "321ce1f2-898d-5430-9186-5d15072c22b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-12{y}^{2}" :db/id #edb/ref 17592186505192} :answer-field/id #uuid "dc2ee70c-3ea3-5fe5-8d90-cd968896e62f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c942870-19a7-5088-91ca-fc84364e3087" :question/math-academy-id "q-131243" :question/problem "Calculate $∇\\cdot (-4F)$ for the vector field $F$ where\n\n$$\nF={x}^{2}yz\\,i+({y}^{3}-y)\\,j-xy{z}^{2}\\,k.\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (-4F)=-4∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({x}^{2}yz)+\\frac{∂}{∂y}({y}^{3}-y)+\\frac{∂}{∂z}(-xy{z}^{2}) \\\\  & =2xyz+3{y}^{2}-1-2xyz \\\\  & =3{y}^{2}-1.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (-4F) & =-4∇\\cdot F \\\\  & =-4\\cdot (3{y}^{2}-1) \\\\  & =4-12{y}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505757 :knowledge-point/_questions [{:db/id #edb/ref 17592186179690 :knowledge-point/id #uuid "44d953c5-21bb-5326-bfac-e793cfe26cd2" :knowledge-point/title "Finding the Divergence of a Vector Field Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39889727-a276-5682-8ef7-8911020878d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(3xz+\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505204} {:answer/id #uuid "4441e299-9c2b-5890-9b2f-cf910acd93da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(1+xz+\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505243} {:answer/id #uuid "5670544a-efa4-5dea-bb60-d1317fd8ae11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(1+3yxz+2y\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505277} {:answer/id #uuid "b1f47d0b-4c4f-560a-896d-281726884e02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(1+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505452} {:answer/id #uuid "c2a78d89-bcff-52b4-a64b-a195e189c0f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(1+3xz+2\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505481}] :answer-field/correct {:answer/id #uuid "c2a78d89-bcff-52b4-a64b-a195e189c0f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xz(1+3xz+2\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505481} :answer-field/id #uuid "8ba8f018-adaf-5841-94d1-797bd241ddf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505670}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "37458a2a-1dd8-5f4b-97d7-084609fd0a20" :question/math-academy-id "q-131291" :question/problem "Given that $F(x,y,z)=⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩$ and $f(x,y,z)={x}^{2}z,$ calculate $∇\\cdot (f\\,F).$" :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨2xz,0,{x}^{2}⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\operatorname{ln}⁡x)+\\frac{∂}{∂y}(x{z}^{3})+\\frac{∂}{∂z}({z}^{2})=\\frac{1}{x}+2z.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & ={x}^{2}z(\\frac{1}{x}+2z)+⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩\\cdot ⟨2xz,0,{x}^{2}⟩ \\\\  & =xz+2{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x+{x}^{2}{z}^{2} \\\\  & =xz+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x \\\\  & =xz(1+3xz+2\\operatorname{ln}⁡x).\\end{aligned}\n$$"}]}
