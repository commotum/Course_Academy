#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186180420} :activity/id #uuid "0488d093-c253-570d-ae9f-e5f079caa8b4" :activity/scope {:db/id #edb/ref 17592186049765 :topic/id #uuid "11e8eee6-f42e-5ccd-91ca-02c0e23d2681" :topic/math-academy-id 3701} :activity/steps [{:db/id #edb/ref 17592186180411 :step/content {:db/id #edb/ref 17592186179688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179547 :question/id #uuid "bb7ae99a-b8d9-5e4d-906c-9e18d22c1404" :question/math-academy-id "e-8742"} :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049459}] :knowledge-point/questions [{:db/id #edb/ref 17592186179909} {:db/id #edb/ref 17592186180185} {:db/id #edb/ref 17592186241093} {:db/id #edb/ref 17592186241096} {:db/id #edb/ref 17592186241097} {:db/id #edb/ref 17592186241098} {:db/id #edb/ref 17592186367359} {:db/id #edb/ref 17592186367366} {:db/id #edb/ref 17592186490261} {:db/id #edb/ref 17592186490329}] :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"} :step/id #uuid "9f1489d0-1edc-5435-abb3-f714edd9024b" :step/math-academy-id 32555 :step/next {:db/id #edb/ref 17592186180471}} {:db/id #edb/ref 17592186180414 :step/content {:db/id #edb/ref 17592186179690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179549 :question/id #uuid "7de054d4-8384-5aab-b2c4-a43b1f86a16c" :question/math-academy-id "e-8928"} :knowledge-point/id #uuid "44d953c5-21bb-5326-bfac-e793cfe26cd2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186050885}] :knowledge-point/questions [{:db/id #edb/ref 17592186179910} {:db/id #edb/ref 17592186180310} {:db/id #edb/ref 17592186241099} {:db/id #edb/ref 17592186241100} {:db/id #edb/ref 17592186266067} {:db/id #edb/ref 17592186266068} {:db/id #edb/ref 17592186366829} {:db/id #edb/ref 17592186366850} {:db/id #edb/ref 17592186490220} {:db/id #edb/ref 17592186490254}] :knowledge-point/title "Finding the Divergence of a Vector Field Using the Product Rule"} :step/id #uuid "a493e9bd-6c19-5c41-b9fb-05fe7d5357d8" :step/math-academy-id 33326} {:db/id #edb/ref 17592186180420 :step/content {:db/id #edb/ref 17592186180689 :tutorial/content "Recall that if $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j + R\\,\\mathbf k$ is a vector field on $\\mathbb R^3,$ then the divergence of $\\mathbf F$ is given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla\\cdot \\mathbf F = \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} + \\dfrac{\\partial R}{\\partial z}.\n$$\n\nSince divergence is computed using derivatives, it's unsurprising that it shares similar properties with derivatives.\n\nFor example, if $\\mathbf F$ and $\\mathbf H$ are vector fields and $k$ is a scalar constant, then we have the following linearity properties:\n\n$$\n\\begin{aligned} & ∇\\cdot (k\\,F)=k\\,(∇\\cdot F) \\\\  & ∇\\cdot (F+H)=∇\\cdot F+∇\\cdot H\\end{aligned}\n$$\n\nApplying these rules can often help us to save time when computing divergence. Let's see some examples." :tutorial/id #uuid "f5f31027-65f9-53ab-bd9a-c3454d049b07" :tutorial/math-academy-id 5529 :tutorial/title "Introduction"} :step/id #uuid "6062f3c7-6f7f-55fd-81a5-fe282d53dde8" :step/math-academy-id 34372 :step/next {:db/id #edb/ref 17592186180411}} {:db/id #edb/ref 17592186180471 :step/content {:db/id #edb/ref 17592186180709 :tutorial/content "Recall that for functions $f(x)$ and $g(x),$ the product rule for differentiation is given by\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(f\\cdot g) = f\\dfrac{\\textrm d }{\\textrm d x}(g) +  g\\dfrac{\\textrm d }{\\textrm d x}(f).\n$$\n\nThere is an analogous rule for computing the divergence of the product of a vector field and a scalar field.\n\nSuppose that $\\mathbf F$ is a vector field and $f$ is a scalar field. Then, we have the following identity:\n\n$$\n\\nabla \\cdot (f\\,\\mathbf F) = f\\, \\nabla \\cdot \\mathbf {F}+  \\mathbf F \\cdot \\nabla \\! f\n$$\n\n  \n\nwhere $\\nabla f$ is the gradient of $f.$\n\nNotice that the del operator $\\nabla$ acts on the terms in the same way as the $\\dfrac{\\textrm d}{\\textrm d x}$ operator in the product rule for differentiation!\n\nThere are a few other tips that we can use to remember this rule:\n\n- The term $\\nabla \\cdot (f\\,\\mathbf F)$ on the left-hand side must be a scalar field because it's a divergence. So, the two terms on the right-hand side must be scalar fields, too.\n\n- The term $f\\, \\nabla \\cdot \\mathbf {F}$ on the right-hand side is a scalar field because both $f$ and $\\nabla \\cdot \\mathbf F$ are scalar fields, and the product of two scalar fields is a scalar field. Note that this \"product\" is just regular multiplication.\n\n- The term $\\mathbf F \\cdot \\nabla \\! f$ on the right-hand side is a scalar field because both $\\mathbf F$ and $\\nabla f$ are *vector* fields, and the *dot product* of two vector fields is a scalar field." :tutorial/id #uuid "c0316ea0-9d48-5155-82e8-948d53b0f677" :tutorial/math-academy-id 5795 :tutorial/title "The Product Rule for Divergence"} :step/id #uuid "6797ef0f-9f84-5dda-8b36-6c76a5fe635c" :step/math-academy-id 35539 :step/next {:db/id #edb/ref 17592186180414}}] :activity/title "Properties of the Divergence Operator" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179855}]}
