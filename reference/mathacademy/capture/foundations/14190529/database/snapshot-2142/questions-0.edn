#{[{:db/id #edb/ref 17592186179909 :knowledge-point/_questions [{:db/id #edb/ref 17592186179688 :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143af2bb-452a-5104-bc81-562dee768a4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+2x){e}^{2x}+2xz" :db/id #edb/ref 17592186238219} {:answer/id #uuid "7c350bea-10b9-5854-9b70-41a8fa29fd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{2x}+xz" :db/id #edb/ref 17592186239128} {:answer/id #uuid "99cb3b1b-8973-5a5f-b31a-75e39652f5ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{2x}+{z}^{2}" :db/id #edb/ref 17592186239390} {:answer/id #uuid "bb06be3e-7cda-5bd7-9ebe-adf35ee7424b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+x){e}^{2x}+xz" :db/id #edb/ref 17592186239682} {:answer/id #uuid "eb86eb60-f49f-59ee-9e69-1943bea23394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2x}+z" :db/id #edb/ref 17592186240127}] :answer-field/correct {:answer/id #uuid "7c350bea-10b9-5854-9b70-41a8fa29fd20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{2x}+xz" :db/id #edb/ref 17592186239128} :answer-field/id #uuid "ea3400a6-fe4f-5f4f-afae-01b7fad81fd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240740}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "208c1557-4948-59e8-ace1-5a9ccf87465a" :question/math-academy-id "q-105633" :question/problem "Calculate $∇\\cdot (\\frac{1}{2}F)$ for the vector field $F$ where\n\n$$\nF=x{e}^{2x}\\,i-y{e}^{2x}\\,j+x{z}^{2}\\,k.\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F)=\\frac{1}{2}∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}(x{e}^{2x})+\\frac{∂}{∂y}(-y{e}^{2x})+\\frac{∂}{∂z}(x{z}^{2}) \\\\  & ={e}^{2x}+2x{e}^{2x}-{e}^{2x}+2xz \\\\  & =2x{e}^{2x}+2xz.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F) & =\\frac{1}{2}∇\\cdot F \\\\  & =\\frac{1}{2}\\cdot (2x{e}^{2x}+2xz) \\\\  & =x{e}^{2x}+xz.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366829 :knowledge-point/_questions [{:db/id #edb/ref 17592186179690 :knowledge-point/id #uuid "44d953c5-21bb-5326-bfac-e793cfe26cd2" :knowledge-point/title "Finding the Divergence of a Vector Field Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb80e6b3-5eec-5bc1-b118-b2f215f56474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(y-x){e}^{-x}-x(x+y){e}^{y}" :db/id #edb/ref 17592186366831} {:answer/id #uuid "f71527c4-7d0b-5d0c-824e-c74e01fec90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-x){e}^{-x}-(x+y){e}^{y}" :db/id #edb/ref 17592186366832} {:answer/id #uuid "45d127b0-856e-53d2-9108-fa49820d507a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1-x){e}^{-x}-x(1+y){e}^{y}" :db/id #edb/ref 17592186366833} {:answer/id #uuid "482f638e-33f3-58fb-9ace-068365945fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2-x){e}^{-x}+x(2+y){e}^{y}" :db/id #edb/ref 17592186366834} {:answer/id #uuid "5d73ac97-8242-529d-aec9-f7267dcb85b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1+x){e}^{-x}+x(1-y){e}^{y}" :db/id #edb/ref 17592186366835}] :answer-field/correct {:answer/id #uuid "45d127b0-856e-53d2-9108-fa49820d507a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(1-x){e}^{-x}-x(1+y){e}^{y}" :db/id #edb/ref 17592186366833} :answer-field/id #uuid "03cf2268-b570-5c67-90e0-2744f755a552" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366830}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b1a781a-78fd-56cb-a627-519454aac978" :question/math-academy-id "q-105654" :question/problem "Given that $F(x,y)=⟨y{e}^{-x},-y{e}^{y}⟩$ and $f(x,y)=x,$ calculate $∇\\cdot (f\\,F).$" :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨1,0⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(y{e}^{-x})+\\frac{∂}{∂y}(-y{e}^{y})=-y{e}^{-x}-{e}^{y}-y{e}^{y}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =x(-y{e}^{-x}-{e}^{y}-y{e}^{y})+⟨y{e}^{-x},-y{e}^{y}⟩\\cdot ⟨1,0⟩ \\\\  & =-yx{e}^{-x}-x{e}^{y}-yx{e}^{y}+y{e}^{-x} \\\\  & =y{e}^{-x}-yx{e}^{-x}-x{e}^{y}-yx{e}^{y} \\\\  & =y(1-x){e}^{-x}-x(1+y){e}^{y}.\\end{aligned}\n$$"}]}
