      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223987/observations/step-q126516-5fa047d08abbbf340ef9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223987/observations/step-q126516-5fa047d08abbbf340ef9.png",
      "source_url": "https://mathacademy.com/tasks/14223987/topics/3627/lesson",
