∬</mo><mi mathvariant=\"normal\">Δ</mi></munder><mo stretchy=\"false\">(</mo><mo>−</mo><mi>r</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>r</mi><mtext>d</mtext><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mn>6</mn></msubsup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>r</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>−</mo><mi>r</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>θ</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
