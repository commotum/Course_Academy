      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223987/observations/step-q126708-6f6700f64edff3b83719.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223987/observations/step-q126708-6f6700f64edff3b83719.png",
      "source_url": "https://mathacademy.com/tasks/14223987/topics/3627/lesson",
      "captured_at": 1792038726.5689154,
      "math_academy_id": "q-126708",
