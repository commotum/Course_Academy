/mrow></msub><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>q</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>t</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>t</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>4</mn><mi>t</mi><mo>−</mo><mn>3.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>    </p>\n</div></div>",
