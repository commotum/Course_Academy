><mi>g</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mi>t</mi><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mi>t</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>        </p>\n</div></div>",
