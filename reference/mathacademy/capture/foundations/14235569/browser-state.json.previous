TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>=</mo><msub><mi>c</mi><mn>1</mn></msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>4</mn></mrow></msup><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>4</mn></mrow></msup><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">R</mi></mrow><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
