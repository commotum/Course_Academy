#{[{:db/id #edb/ref 17592186363038 :knowledge-point/_questions [{:db/id #edb/ref 17592186078589 :knowledge-point/id #uuid "7ff7f935-dcec-5b4c-ba1d-e0b4c9e197a4" :knowledge-point/title "Applying Differential Operators With Functions of X as Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ae9dacd-9221-5bef-a3e2-054140ce493a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186363040} {:answer/id #uuid "9d49b809-9260-5d2e-bf3c-edbf1cfbe326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x}" :db/id #edb/ref 17592186363041} {:answer/id #uuid "311f4edb-1ed9-5bdd-a81b-ea812b499a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186363042} {:answer/id #uuid "8cf0b43a-7db8-50c5-a40c-5a36e706ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x}" :db/id #edb/ref 17592186363043} {:answer/id #uuid "857a50bb-2584-5d08-9f49-c2a69907123b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{2}}" :db/id #edb/ref 17592186363044}] :answer-field/correct {:answer/id #uuid "7ae9dacd-9221-5bef-a3e2-054140ce493a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186363040} :answer-field/id #uuid "438741cb-1bf1-5078-92c8-7fcd9f079cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a136203-dd8c-5077-8693-b3c3a213b678" :question/math-academy-id "q-130248" :question/problem "Given that $D={x}^{2}\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}+3x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-\\frac{\\text{d}}{\\text{d}x},$ what is $D(y)$ for $y=\\frac{1}{x}?$" :question/worked-solution "The given operator is a third-order differential operator of the form\n\n$$\nD(y)={f}_{3}(x)\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y.\n$$\n\nwith ${f}_{3}={x}^{2},{f}_{2}=3x,{f}_{1}=-1,$ and ${f}_{0}=0.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y$:\n\n$$\n\\begin{aligned}D(y) & =D(\\frac{1}{x}) \\\\  & =({x}^{2}\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}+3x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-\\frac{\\text{d}}{\\text{d}x})(\\frac{1}{x}) \\\\  & ={x}^{2}\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}(\\frac{1}{x})+3x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\frac{1}{x})-\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}) \\\\  & ={x}^{2}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(-\\frac{1}{{x}^{2}})+3x\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})-(-\\frac{1}{{x}^{2}}) \\\\  & ={x}^{2}\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{3}})+3x(\\frac{2}{{x}^{3}})+\\frac{1}{{x}^{2}} \\\\  & =-\\frac{6}{{x}^{2}}+\\frac{6}{{x}^{2}}+\\frac{1}{{x}^{2}} \\\\  & =\\frac{1}{{x}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078867 :knowledge-point/_questions [{:db/id #edb/ref 17592186078590 :knowledge-point/id #uuid "7066d712-f0a3-554f-9d10-3d6fe4b95a18" :knowledge-point/title "Applying Differential Operators With Multivariable Functions as Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e5e6c5-ab44-55be-aa90-70e3ce45de4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(3-x)" :db/id #edb/ref 17592186308749} {:answer/id #uuid "532ca6a0-76bf-59b9-ac93-ed25573ae8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(2-x)" :db/id #edb/ref 17592186309379} {:answer/id #uuid "a8c61d17-3bb6-5ef5-910a-22a07c3083bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(3+x)" :db/id #edb/ref 17592186310110} {:answer/id #uuid "bfaa76f0-ebc0-54cd-9a74-7c0e1bc19d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(1+3x)" :db/id #edb/ref 17592186310294} {:answer/id #uuid "f828d022-1ad4-577a-a879-55bc73919c57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(2+x)" :db/id #edb/ref 17592186310724}] :answer-field/correct {:answer/id #uuid "00e5e6c5-ab44-55be-aa90-70e3ce45de4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4x}(3-x)" :db/id #edb/ref 17592186308749} :answer-field/id #uuid "faf11ab5-29be-5943-bd83-83fafb691233" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311530}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3aca8975-6bdc-5d74-9fd7-116773d083f3" :question/math-academy-id "q-337559" :question/problem "If $D(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy\\frac{\\text{d}y}{\\text{d}x}+2{y}^{2},$ then $D({e}^{2x})=$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x,y)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x,y)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x,y)y\n$$\n\nwith ${f}_{2}=y,{f}_{1}=-xy,$ and ${f}_{0}=2y.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y={e}^{2x}:$\n\n$$\n\\begin{aligned}D({e}^{2x}) & ={e}^{2x}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}({e}^{2x})-x({e}^{2x})\\frac{\\text{d}}{\\text{d}x}({e}^{2x})+2({e}^{2x})^{2} \\\\  & ={e}^{2x}\\frac{\\text{d}}{\\text{d}x}(2{e}^{2x})-x{e}^{2x}\\cdot 2{e}^{2x}+2{e}^{4x} \\\\  & ={e}^{2x}\\cdot 4{e}^{2x}-2x{e}^{4x}+2{e}^{4x} \\\\  & =4{e}^{4x}-2x{e}^{4x}+2{e}^{4x} \\\\  & =6{e}^{4x}-2x{e}^{4x} \\\\  & =2{e}^{4x}(3-x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348247 :knowledge-point/_questions [{:db/id #edb/ref 17592186078589 :knowledge-point/id #uuid "7ff7f935-dcec-5b4c-ba1d-e0b4c9e197a4" :knowledge-point/title "Applying Differential Operators With Functions of X as Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f46a15-0ca3-5841-b2b5-75e0e85c81df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{3}}" :db/id #edb/ref 17592186345982} {:answer/id #uuid "60b84d6c-d8f3-52d7-8796-88e3110d630d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186346189} {:answer/id #uuid "adbb7b5a-753f-5d50-9dee-99ba55ca3aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186346866} {:answer/id #uuid "b2aa1892-d783-5d98-8e84-8e8aa43ec658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{x}^{2}}" :db/id #edb/ref 17592186346908} {:answer/id #uuid "b54dbd62-5d7e-5ae5-8499-c4d6f981662d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{2}}" :db/id #edb/ref 17592186346930}] :answer-field/correct {:answer/id #uuid "b2aa1892-d783-5d98-8e84-8e8aa43ec658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{x}^{2}}" :db/id #edb/ref 17592186346908} :answer-field/id #uuid "e68a9f18-b7c7-5562-af22-77d1084739c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348009}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e13f24b1-d2d1-59a7-beb7-3c206203362c" :question/math-academy-id "q-79607" :question/problem "Given that $D=x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-\\frac{\\text{d}}{\\text{d}x},$ what is $D(y)$ for $y=\\frac{1}{x}?$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}=x,{f}_{1}=-1,$ and ${f}_{0}=0.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y$:\n\n$$\n\\begin{aligned}D(y) & =D(\\frac{1}{x}) \\\\  & =(x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-\\frac{\\text{d}}{\\text{d}x})\\frac{1}{x} \\\\  & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\frac{1}{x})-\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}) \\\\  & =x\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})-(-\\frac{1}{{x}^{2}}) \\\\  & =x\\cdot (\\frac{2}{{x}^{3}})+\\frac{1}{{x}^{2}} \\\\  & =\\frac{2}{{x}^{2}}+\\frac{1}{{x}^{2}} \\\\  & =\\frac{3}{{x}^{2}}\\end{aligned}\n$$"}]}
