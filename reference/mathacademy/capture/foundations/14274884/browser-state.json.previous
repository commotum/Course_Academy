      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q143740-7e7437bf991114a3dc3f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q143740-7e7437bf991114a3dc3f.png",
      "source_url": "https://mathacademy.com/tasks/14274884/topics/3640/lesson",
      "captured_at": 1792224063.3746176,
      "math_academy_id": "q-143740",
      "topic_id": "3640",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q143740",
        "placement_id": null,
        "content_id": null,
