      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q143746-a3e39db5a4e6cd080497.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q143746-a3e39db5a4e6cd080497.png",
      "source_url": "https://mathacademy.com/tasks/14274884/topics/3640/lesson",
      "captured_at": 1792224084.988041,
      "math_academy_id": "q-143746",
      "topic_id": "3640",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q143746",
        "placement_id": null,
        "content_id": null,
