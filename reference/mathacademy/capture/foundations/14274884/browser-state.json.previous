      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q111909-8dee95b260e15f8bdde2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q111909-8dee95b260e15f8bdde2.png",
      "source_url": "https://mathacademy.com/tasks/14274884/topics/3640/lesson",
      "captured_at": 1792224105.4418354,
      "math_academy_id": "q-111909",
      "topic_id": "3640",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q111909",
        "placement_id": null,
