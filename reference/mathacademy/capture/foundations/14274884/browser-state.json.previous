      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q137896-3abeecab2ad9be7d3547.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274884/observations/step-q137896-3abeecab2ad9be7d3547.png",
      "source_url": "https://mathacademy.com/tasks/14274884/topics/3640/lesson",
      "captured_at": 1792224043.0366747,
      "math_academy_id": "q-137896",
