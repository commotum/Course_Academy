  "proof_feedback": null,
  "html": "<div id=\"step-38160\" class=\"step\" style=\"display: block\" stepid=\"38160\" steptype=\"example\" contentid=\"10118\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-38160\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-11\">Finding Part of a Joint CDF from a Joint PDF</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"38160\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                     