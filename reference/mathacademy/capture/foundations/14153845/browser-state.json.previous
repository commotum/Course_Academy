ay=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 1.3em 0.8em 0.8em 0.3em\"><mtr><mtd><mi mathvariant=\"normal\">∇</mi><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><msub><mi>f</mi><mi>x</mi></msub><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>+</mo><msub><mi>f</mi><mi>y</mi></msub><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><msub><mi>f</mi><mi>z</mi></msub><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>z</mi><msup><mi>x</mi><mn>4</mn></msup><mo>−</mo><mi>x</mi><mo>−</mo><mn>2</mn><msup><mi>y</mi><mn>3</mn></msup><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>z</mi><msup><mi>x</mi><mn>4</mn></msup><mo>−</mo><mi>x</mi><mo>−</mo><mn>2</mn><msup><mi>y</mi><mn>3</mn></msup><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>z</mi><msup><mi>x</mi><mn>4</mn></msup><mo>−</mo><mi>x</mi><mo>−</mo><mn>2</mn><msup><mi>y</mi><mn>3</mn></msup><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>z</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mn>6</mn><msup><mi>y</mi><mn>2</mn></msup><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><msup><mi>x</mi><mn>4</mn></msup><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">∇</mi><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mn>6</mn><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mtext>&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>11</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>−</mo><mn>24</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">k</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>11</mn><mo>,</mo><mo>−</mo><mn>24</mn><mo>,</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"158\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 18.585em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.3em;\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c2207\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msub space=\"2\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"