t=\"normal\">∇</mi><mi>f</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mo>−</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>y</mi><mo>+</mo><mn>2</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>z</mi><mo>−</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>4</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>⋅</mo><mo fence=\"false\" stretchy=\"false\">⟨</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>y</mi><mo>+</mo><mn>2</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi>z</mi><mo>−</mo><mn>1</mn><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mi>z</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>4</mn><mi>z</mi><mo>−</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
