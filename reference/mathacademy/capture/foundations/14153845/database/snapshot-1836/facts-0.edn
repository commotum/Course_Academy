17] [17592186475885 #edb/ref 1075 #edb/ref 17592186475640 #edb/ref 17592186045417] [17592186475885 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186475885 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186475885 #edb/ref 1078 #edb/ref 17592186475533 #edb/ref 17592186045417] [17592186475885 #edb/ref 1079 #uuid "bd5c8610-318e-58b9-8590-725b9e0fa2c5" #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475591 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475601 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475653 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475673 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475792 #edb/ref 17592186045417] [17592186475905 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186475905 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186475905 #edb/ref 1078 #edb/ref 17592186475673 #edb/ref 17592186045417] [17592186475905 #edb/ref 1079 #uuid "f5f7cc0c-f2cb-5ebd-8a19-e3ddc8cdda4a" #edb/ref 17592186045417] [17592186475907 #edb/ref 1075 #edb/ref 17592186475545 #edb/ref 17592186045417] [17592186475907 #edb/ref 1075 #edb/ref 17592186475554 #edb/ref 17592186045417] [17592186475907 #edb/ref 1075 #edb/ref 17592186475571 #edb/ref 17592186045417] [17592186475907 #edb/ref 1075 #edb/ref 17592186475681 #edb/ref 17592186045417] [17592186475907 #edb/ref 1075 #edb/ref 17592186475724 #edb/ref 17592186045417] [17592186475907 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186475907 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186475907 #edb/ref 1078 #edb/ref 17592186475724 #edb/ref 17592186045417] [17592186475907 #edb/ref 1079 #uuid "fcbbc700-14d3-56d7-9524-57ed54783857" #edb/ref 17592186045417] [17592186475921 #edb/ref 1068 #edb/ref 17592186475907 #edb/ref 17592186045417] [17592186475921 #edb/ref 1069 "q-102708" #edb/ref 17592186045417] [17592186475921 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186475921 #edb/ref 1071 "Given the function $f(x,y,z)={y}^{3}z-xy+x{z}^{3}$, find the equation of the tangent plane to the level surface that passes through the point where $(x,y,z)=(2,-1,1).$" #edb/ref 17592186045417] [17592186475921 #edb/ref 1072 #uuid "213d84af-097e-53bb-ad1d-ed8419f53f21" #edb/ref 17592186045417] [17592186475921 #edb/ref 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(2,-1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({y}^{3}z-xy+x{z}^{3})\\text{ }i+\\frac{∂}{∂y}({y}^{3}z-xy+x{z}^{3})\\text{ }j+\\frac{∂}{∂z}({y}^{3}z-xy+x{z}^{3})\\text{ }k \\\\  & =({z}^{3}-y)\\text{ }i+(3z{y}^{2}-x)\\text{ }j+(3x{z}^{2}+{y}^{3})k \\\\ ∇\\,f(2,-1,1) & =({1}^{3}-(-1))\\text{ }i+(3(1)(-1)^{2}-2)\\text{ }j+(3(2)(1)^{2}+(-1)^{3})k \\\\  & =2\\,i+\\,j+5k \\\\  & =⟨2,1,5⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows: \n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(2,-1,1)\\cdot ⟨x-2,\\,y+1,\\,z-1⟩ & =0 \\\\ ⟨2,1,5⟩\\cdot ⟨x-2,\\,y+1,\\,z-1⟩ & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186475928 #edb/ref 1068 #edb/ref 17592186475905 #edb/ref 17592186045417] [17592186475928 #edb/ref 1069 "q-102714" #edb/ref 17592186045417] [17592186475928 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186475928 #edb/ref 1071 "Consider the surface $x{y}^{2}+6=z{x}^{2}.$ Find the equation of the tangent plane to that surface at the point $(-2,-1,1).$" #edb/ref 17592186045417] [17592186475928 #edb/ref 1072 #uuid "2dcb9c2a-7362-5965-b423-4b434eec8d3a" #edb/ref 17592186045417] [17592186475928 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{y}^{2}+6 & =z{x}^{2} \\\\ x{y}^{2}-z{x}^{2} & =-6\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=x{y}^{2}-z{x}^{2}$, our surface can be viewed as the level surface $f(x,y,z)=-6.$ \n\nRecall that the equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(-2,-1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-z{x}^{2})\\text{ }i+\\frac{∂}{∂y}(x{y}^{2}-z{x}^{2})\\text{ }j+\\frac{∂}{∂z}(x{y}^{2}-z{x}^{2})\\text{ }k \\\\  & =({y}^{2}-2xz)\\text{ }i+2xy\\text{ }j-{x}^{2}\\text{ }k \\\\ ∇\\,f(-2,-1,1) & =((-1)^{2}-2(-2)(1))\\text{ }i+2(-2)(-1)\\text{ }j-(-2)^{2}\\text{ }k \\\\  & =5\\,i+4j-4\\,k \\\\  & =⟨5,4,-4⟩\\end{aligned}\n$$\n\nFinally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(-2,-1,1)\\cdot ⟨x+2,\\,y+1,\\,z-1⟩ & =0 \\\\ ⟨5,4,-4⟩\\cdot ⟨x+2,\\,y+1,\\,z-1⟩ & =0 \\\\ 5(x+2)+4(y+1)-4(z-1) & =0 \\\\ 5x+4y-4z+18 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186475932 #edb/ref 1068 #edb/ref 17592186475833 #edb/ref 17592186045417] [17592186475932 #edb/ref 1069 "q-80781" #edb/ref 17592186045417] [17592186475932 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186475932 #edb/ref 1071 "Consider the surface ${x}^{2}{y}^{2}+{e}^{z-1}=17.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(2,-2,1),$ what is the value of $\\frac{a}{c}?$" #edb/ref 17592186045417] [17592186475932 #edb/ref 1072 #uuid "417fb447-d242-53ba-be44-8afd73288884" #edb/ref 17592186045417] [17592186475932 #edb/ref 1074 "Let's define  $f(x,y,z)={x}^{2}{y}^{2}+{e}^{z-1}.$ Then, our surface can be viewed as the level surface $f(x,y,z)=17.$   \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(2,-2,1):$ \n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+{e}^{z-1}))i+\\frac{∂}{∂y}({x}^{2}{y}^{2}+{e}^{z-1})j+\\frac{∂}{∂z}({x}^{2}{y}^{2}+{e}^{z-1}))k \\\\  & =2x{y}^{2}i+2y{x}^{2}j+{e}^{z-1}k \\\\ ∇f(2,-2,1) & =2(2)(-2)^{2}\\text{ }i+2(-2){2}^{2}\\text{ }j+{e}^{1-1}\\text{ }k \\\\  & =16\\text{ }i-16\\text{ }j+\\text{ }k \\\\  & =⟨16,\\,-16,\\,1⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨16,\\,-16,\\,1⟩.$ \n\nFinally, $\\frac{a}{c}=\\frac{16}{1}=16.$" #edb/ref 17592186045417] [17592186475934 #edb/ref 1068 #edb/ref 17592186475843 #edb/ref 17592186045417] [17592186475934 #edb/ref 1069 "q-102713" #edb/ref 17592186045417] [17592186475934 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186475934 #edb/ref 1071 "Consider the surface $z\\operatorname{cos}⁡(x+y)-xyz=2+\\frac{{\\pi }^{2}}{2}.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2),$ what is the value of $\\frac{a}{b}?$" #edb/ref 17592186045417] [17592186475934 #edb/ref 1072 #uuid "480ef21f-535f-5e73-9903-6cc50742dda8" #edb/ref 17592186045417] [17592186475934 #edb/ref 1074 "Let's define  $f(x,y,z)=z\\operatorname{cos}⁡(x+y)-xyz.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2+\\frac{{\\pi }^{2}}{2}.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(z\\operatorname{cos}⁡(x+y)-xyz)i+\\frac{∂}{∂y}(z\\operatorname{cos}⁡(x+y)-xyz)j+\\frac{∂}{∂z}(z\\operatorname{cos}⁡(x+y)-xyz)k \\\\  & =(-z\\operatorname{sin}⁡(x+y)-yz)i+(-z\\operatorname{sin}⁡(x+y)-xz)j+(\\operatorname{cos}⁡(x+y)-xy)k \\\\ ∇f(\\frac{\\pi }{2},-\\frac{\\pi }{2},2) & =(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2(-\\frac{\\pi }{2}))\\text{ }i+(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2(\\frac{\\pi }{2}))\\text{ }j+(\\operatorname{cos}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-(\\frac{\\pi }{2})(-\\frac{\\pi }{2}))\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+(1+\\frac{{\\pi }^{2}}{4})\\text{ }k \\\\  & =⟨\\pi ,\\,-\\pi ,\\,1+\\frac{{\\pi }^{2}}{4}⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨\\pi ,\\,-\\pi ,\\,\\frac{{\\pi }^{2}+4}{4}⟩.$\n\nFinally, $\\frac{a}{b}=\\frac{\\pi }{-\\pi }=-1.$" #edb/ref 17592186045417] [17592186475937 #edb/ref 1068 #edb/ref 17592186475885 #edb/ref 17592186045417] [17592186475937 #edb/ref 1069 "q-102707" #edb/ref 17592186045417] [17592186475937 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186475937 #edb/ref 1071 "Given the function $f(x,y,z)={x}^{2}z+{z}^{2}y+{y}^{2}x$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(1,1,-1).$" #edb/ref 17592186045417] [17592186475937 #edb/ref 1072 #uuid "58a67d8c-4e10-594d-863e-d6da9c98fcce" #edb/ref 17592186045417] [17592186475937 #edb/ref 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(1,1,-1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }i+\\frac{∂}{∂y}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }j+\\frac{∂}{∂z}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }k \\\\  & =(2xz+{y}^{2})\\text{ }i+({z}^{2}+2yx)\\text{ }j+({x}^{2}+2zy)k \\\\ ∇\\,f(1,1,-1) & =(2(1)(-1)+{1}^{2})\\text{ }i+((-1)^{2}+2(1)(1))\\text{ }j+({1}^{2}+2(-1)(1))k \\\\  & =-\\,i+3\\,j-k \\\\  & =⟨-1,3,-1⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,1,-1)\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ ⟨-1,3,-1⟩\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ -(x-1)+3(y-1)-(z+1) & =0 \\\\ -x+3y-z-3 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186475970 #edb/ref 1068 #edb/ref 17592186475882 #edb/ref 17592186045417] [17592186475970 #edb/ref 1069 "q-80763" #edb/ref 17592186045417] [17592186475970 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186475970 #edb/ref 1071 "Given the function $f(x,y,z)=x+{y}^{2}-{x}^{2}z$, find the equation of the tangent plane to the level surface that passes through the point where $(x,y,z)=(1,1,2).$" #edb/ref 17592186045417] [17592186475970 #edb/ref 1072 #uuid "d960c3a0-bbd5-5487-b90e-ade524992bee" #edb/ref 17592186045417] [17592186475970 #edb/ref 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(1,1,2):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(x+{y}^{2}-{x}^{2}z)\\text{ }i+\\frac{∂}{∂y}(x+{y}^{2}-{x}^{2}z)\\text{ }j+\\frac{∂}{∂z}(x+{y}^{2}-{x}^{2}z)\\text{ }k \\\\  & =(1-2xz)\\text{ }i+2y\\text{ }j-{x}^{2}k \\\\ ∇\\,f(1,1,2) & =(\\,1-2(1)(2)\\,)\\text{ }i+2(1)\\text{ }j-(1)^{2}k \\\\  & =-3\\,i+2\\,j-1\\,k \\\\  & =⟨-3,2,-1⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows: \n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,1,2)\\cdot ⟨x-1,\\,y-1,\\,z-2⟩ & =0 \\\\ ⟨-3,2,-1⟩\\cdot ⟨x-1,\\,y-1,\\,z-2⟩ & =0\\end{aligned}\n$$" #edb/ref 17592186045417]}
