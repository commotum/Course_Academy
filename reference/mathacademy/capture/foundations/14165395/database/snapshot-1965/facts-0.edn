-54dd-9b16-5ae500db93ee" #edb/ref 17592186045417] [17592186178226 #edb/ref 1080 "F(x, y) = ye^{xy}(2 + y)i - (y^{3}e^{xy} + 2x)j" #edb/ref 17592186045417] [17592186178226 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186178226 #edb/ref 1083 #uuid "79325398-1ef5-5639-aff5-a093511d2b64" #edb/ref 17592186045417] [17592186178227 #edb/ref 1075 #edb/ref 17592186178228 #edb/ref 17592186045417] [17592186178227 #edb/ref 1075 #edb/ref 17592186178229 #edb/ref 17592186045417] [17592186178227 #edb/ref 1075 #edb/ref 17592186178230 #edb/ref 17592186045417] [17592186178227 #edb/ref 1075 #edb/ref 17592186178231 #edb/ref 17592186045417] [17592186178227 #edb/ref 1075 #edb/ref 17592186178232 #edb/ref 17592186045417] [17592186178227 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186178227 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186178227 #edb/ref 1079 #uuid "712e9e01-c44e-5384-90fb-ae7811625631" #edb/ref 17592186045417] [17592186178228 #edb/ref 1080 "I, II, and III" #edb/ref 17592186045417] [17592186178228 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186178228 #edb/ref 1083 #uuid "8719c4c1-296a-5308-8304-35f3d974ce70" #edb/ref 17592186045417] [17592186178229 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186178229 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186178229 #edb/ref 1083 #uuid "90a5767b-02fa-5b05-a4c9-973f6b09f516" #edb/ref 17592186045417] [17592186178230 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186178230 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186178230 #edb/ref 1083 #uuid "996baf61-e5f6-5df1-aa32-1851db148914" #edb/ref 17592186045417] [17592186178231 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186178231 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186178231 #edb/ref 1083 #uuid "ff342f1d-0cbd-5406-9161-19ff3ff1afe0" #edb/ref 17592186045417] [17592186178232 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186178232 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186178232 #edb/ref 1083 #uuid "7776b280-63fe-5dc8-85a0-f54e021ddc7b" #edb/ref 17592186045417] [17592186179426 #edb/ref 1069 "e-12395" #edb/ref 17592186045417] [17592186179426 #edb/ref 1071 "Construct the vector field that has the stream function $\\psi(x,y) = e^{x} \\cos{y}.$" #edb/ref 17592186045417] [17592186179426 #edb/ref 1072 #uuid "a779f67a-21ee-5eb4-8355-c69476ee0d3e" #edb/ref 17592186045417] [17592186179426 #edb/ref 1074 "A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if the following equations hold:\n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y},\\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}\n$$\n\nComputing the partial derivatives of the function $\\psi(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡y) \\\\  & =-{e}^{x}\\operatorname{sin}⁡y, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}({e}^{x}\\operatorname{cos}⁡y) \\\\  & =-{e}^{x}\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $\\psi(x,y) = e^{x} \\cos{y}$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =-{e}^{x}\\operatorname{sin}⁡y\\,i-{e}^{x}\\operatorname{cos}⁡y\\,j.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179427 #edb/ref 1069 "e-12396" #edb/ref 17592186045417] [17592186179427 #edb/ref 1071 "Which of the following vector fields have a stream function?\n\n- $\\mathbf{F}(x,y) = x^4y\\,\\mathbf{i} - 2x^3y^2\\,\\mathbf{j}$\n\n- $\\mathbf{F}(x,y) = \\sin x \\sin y\\,\\mathbf{i} + \\cos x \\cos y\\,\\mathbf{j}$\n\n- $\\mathbf{F}(x,y) = 4x^2y\\,\\mathbf{i} -4x^2y^2\\,\\mathbf{j}$" #edb/ref 17592186045417] [17592186179427 #edb/ref 1072 #uuid "69a293cc-ff8c-5485-8329-12e87e1addff" #edb/ref 17592186045417] [17592186179427 #edb/ref 1074 "A vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=4{x}^{3}y,\\,\\frac{∂Q}{∂y} & =-4{x}^{3}y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= 4x^3y + (- 4x^3y)\n= 0\n$$\n\n- Vector field II has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\operatorname{cos}⁡x\\operatorname{sin}⁡y,\\,\\frac{∂Q}{∂y} & =-\\operatorname{cos}⁡x\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= \\cos x \\sin y + (- \\cos x \\sin y)\n= 0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=8xy,\\,\\frac{∂Q}{∂y} & =-8{x}^{2}y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}\n= 8xy + (- 8x^2y)\n\\neq 0.\n$$\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186179435 #edb/ref 1069 "e-12439" #edb/ref 17592186045417] [17592186179435 #edb/ref 1071 "Determine the equation of the streamline that passes through the point $P(-1,1)$ for the vector field $\\mathbf{F}(x,y) = (x^3-3xy^2)\\,\\mathbf{i} + (y^3-3x^2y)\\,\\mathbf{j}.$" #edb/ref 17592186045417] [17592186179435 #edb/ref 1072 #uuid "6cb53e89-c4a9-57a6-b54f-f6a09d3a17d4" #edb/ref 17592186045417] [17592186179435 #edb/ref 1074 "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $\\mathbf F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nNote that $\\mathbf{F}(x,y) = (x^3-3xy^2)\\,\\mathbf{i} + (y^3-3x^2y)\\,\\mathbf{j}$ is a vector field with simply connected domain $D=\\mathbb{R}^2,$ where $P(x,y) = x^3-3xy^2$ and $Q(x,y) = y^3 - 3x^2y.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}-3{y}^{2},\\,\\frac{∂Q}{∂y} & =3{y}^{2}-3{x}^{2}.\\end{aligned}\n$$\n\nHence, $\\mathbf F$ has a stream function, since\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = (3x^2-3y^2) + (3y^2 - 3x^2) = 0.\n$$\n\nNext, we find a stream function. A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if \n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.\n$$\n\nIn our case, we have\n\n$$\n\\dfrac{\\partial \\psi}{\\partial y} = x^3-3xy^2, \\qquad \\dfrac{\\partial \\psi}{\\partial x} = -y^3+3x^2y.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\n\\psi(x,y) = x^3y - xy^3 + f(x), \\qquad \n\\psi(x,y) = -xy^3 + x^3y + g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\n\\psi(x,y) = x^3y - xy^3.\n$$\n\nFinally, we find the level curve of the stream function $\\psi(x,y) = x^3y - xy^3$ that passes through $P.$\nFirst, we find the value of the stream function at $P{:}$\n\n$$\n\\begin{aligned}ψ(-1,1) & =(-1)^{3}(1)-(-1)(1)^{3} \\\\  & =-1-(-1) \\\\  & =0\\end{aligned}\n$$\n\nHence, the streamline that passes through $P(-1,1)$ is the $0$-level curve:\n\n$$\n\\begin{aligned}ψ(x,y) & =0 \\\\ {x}^{3}y-x{y}^{3} & =0 \\\\ xy({x}^{2}-{y}^{2}) & =0 \\\\ xy(x+y)(x-y) & =0\\end{aligned}\n$$\n\nTherefore, our possible streamlines are $x=0,$ $y=0,$ $y=-x,$ or $y=x.$ The streamline that passes through $P(-1,1)$ is $y=-x.$\nThe vector field and the streamline through the point $P$ are shown below.\n\n![](images/29/29512dff5cf2dfe6dbebc0fadeee51ee3043b0161dc1729cc89877e6b39512af.png)" #edb/ref 17592186045417] [17592186179437 #edb/ref 1069 "e-12446" #edb/ref 17592186045417] [17592186179437 #edb/ref 1071 "Find a stream function for the vector field $\\mathbf F,$ given by\n\n$$\n\\mathbf{F}(x,y) = 2y\\,\\mathbf{i} +2x\\,\\mathbf{j}.\n$$" #edb/ref 17592186045417] [17592186179437 #edb/ref 1072 #uuid "6cf11fc9-874f-5d59-bff0-1ed3debcbd40" #edb/ref 17592186045417] [17592186179437 #edb/ref 1074 "A vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ with a simply connected domain $D \\subseteq \\mathbb{R}^2$ has a stream function $\\psi(x,y)$ if and only if\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.\n$$\n\nNote that $\\mathbf{F}(x,y) =  2y\\,\\mathbf{i} +2x\\,\\mathbf{j}$ is a vector field with simply connected domain $D=\\mathbb{R}^2,$ where $P(x,y) = 2y$ and $Q(x,y) =2x.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=0,\\,\\frac{∂Q}{∂y} & =0.\\end{aligned}\n$$\n\nHence, $\\mathbf F$ has a stream function, since\n\n$$\n\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0 + 0 = 0.\n$$\n\nNext, we find a stream function. A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if \n\n$$\nP = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.\n$$\n\nIn our case, we have\n\n$$\n\\dfrac{\\partial \\psi}{\\partial y} = 2y, \\qquad \\dfrac{\\partial \\psi}{\\partial x} = -2x.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\n\\psi(x,y) = y^2 + f(x), \\qquad \n\\psi(x,y) = -x^2+ g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f(x)=-x^2$ and $g(y)=y^2,$ we have\n\n$$\n\\psi(x,y) = y^2-x^2.\n$$" #edb/ref 17592186045417] [17592186179765 #edb/ref 1037 #edb/ref 17592186049511 #edb/ref 17592186045417] [17592186179765 #edb/ref 1037 #edb/ref 17592186050412 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186180083 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186180092 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186372034 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186372041 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186372048 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186389319 #edb/ref 17592186045417] [17592186179765 #edb/ref 1038 #edb/ref 17592186389326 #edb/ref 17592186045417] [17592186179765 #edb/ref 1039 "Constructing a Vector Field From Its Stream Function" #edb/ref 17592186045417] [17592186179765 #edb/ref 1041 #edb/ref 17592186179426 #edb/ref 17592186045417] [17592186179765 #edb/ref 1042 #uuid "b7abceeb-620d-5e95-93ca-30bc557cf007" #edb/ref 17592186045417] [17592186179766 #edb/ref 1037 #edb/ref 17592186050189 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186180084 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186180093 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186372153 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186372160 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186372167 #edb/ref 17592186045417] [17592186179766 #edb/ref 1038 #edb/ref 17592186372174 #edb/ref 17592186045417] [17592186179766 #edb/ref 1039 "Determining Cases Where a Stream Function Exists" #edb/ref 17592186045417] [17592186179766 #edb/ref 1041 #edb/ref 17592186179427 #edb/ref 17592186045417] [17592186179766 #edb/ref 1042 #uuid "dc613be0-2d34-5253-8fbe-7d2a5fcd0840" #edb/ref 17592186045417] [17592186179774 #edb/ref 1037 #edb/ref 17592186048917 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186180088 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186180091 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186372146 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186372181 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186389339 #edb/ref 17592186045417] [17592186179774 #edb/ref 1038 #edb/ref 17592186389346 #edb/ref 17592186045417] [17592186179774 #edb/ref 1039 "Finding Streamlines of Vector Fields" #edb/ref 17592186045417] [17592186179774 #edb/ref 1041 #edb/ref 17592186179435 #edb/ref 17592186045417] [17592186179774 #edb/ref 1042 #uuid "f30cae81-5bda-52dc-8de4-9ad5fd587e48" #edb/ref 17592186045417] [17592186179776 #edb/ref 1037 #edb/ref 17592186049380 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186180033 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186180085 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186372062 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186372069 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186372076 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186372083 #edb/ref 17592186045417] [17592186179776 #edb/ref 1038 #edb/ref 17592186401357 #edb/ref 17592186045417] [17592186179776 #edb/ref 1039 "Determining a Stream Function for a Vector Field" #edb/ref 17592186045417] [17592186179776 #edb/ref 1041 #edb/ref 17592186179437 #edb/ref 17592186045417] [17592186179776 #edb/ref 1042 #uuid "ffa79034-bdcc-5524-aa39-e81a79b48ded" #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180508 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180551 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180552 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180565 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180566 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180571 #edb/ref 17592186045417] [17592186179868 #edb/ref 1043 #edb/ref 17592186180572 #edb/ref 17592186045417] [17592186179868 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179868 #edb/ref 1045 "Stream Functions" #edb/ref 17592186045417] [17592186179868 #edb/ref 1046 #edb/ref 17592186180508 #edb/ref 17592186045417] [17592186179868 #edb/ref 1049 #edb/ref 17592186049617 #edb/ref 17592186045417] [17592186179868 #edb/ref 1053 #uuid "564a18a1-f71e-5757-9e58-d7176c63906f" #edb/ref 17592186045417] [17592186180033 #edb/ref 1068 #edb/ref 17592186177867 #edb/ref 17592186045417] [17592186180033 #edb/ref 1069 "q-126829" #edb/ref 17592186045417] [17592186180033 #edb/ref 1071 "Which of the following is a stream function for the vector field\n$F(x, y) = x^{2}i - 2xyj$?" #edb/ref 17592186045417] [17592186180033 #edb/ref 1072 #uuid "60134b61-53f9-50e7-85c6-4445150f503c" #edb/ref 17592186045417] [17592186180085 #edb/ref 1068 #edb/ref 17592186178179 #edb/ref 17592186045417] [17592186180085 #edb/ref 1069 "q-161437" #edb/ref 17592186045417] [17592186180085 #edb/ref 1071 "Which of the following is a stream function for the vector field\n$F(x, y) = (1 - 2xy)i - y^{2}j$?" #edb/ref 17592186045417] [17592186180085 #edb/ref 1072 #uuid "4bf80022-982e-52f6-a693-b1484ab92175" #edb/ref 17592186045417] [17592186180091 #edb/ref 1068 #edb/ref 17592186178215 #edb/ref 17592186045417] [17592186180091 #edb/ref 1068 #edb/ref 17592186372014 #edb/ref 17592186045417] [17592186180091 #edb/ref 1069 "q-162209" #edb/ref 17592186045417] [17592186180091 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186180091 #edb/ref 1071 "Determine the equation of the streamline that passes through the point $P(-1,-1)$ for the vector field $F(x,y)={x}^{2}\\,i-2xy\\,j.$" #edb/ref 17592186045417] [17592186180091 #edb/ref 1072 #uuid "eca1e58e-6616-5dd0-8afa-579d4de9a32a" #edb/ref 17592186045417] [17592186180091 #edb/ref 1074 "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n. \n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that $F(x,y)={x}^{2}\\,i-2xy\\,j$ is a vector field with simply connected domain $D={R}^{2},$ where $P(x,y)={x}^{2}$ and $Q(x,y)=-2xy.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =-2x.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2x+(-2x)=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}={x}^{2},\\,\\frac{∂ψ}{∂x}=2xy.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)={x}^{2}y+f(x),\\,ψ(x,y)={x}^{2}y+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\nψ(x,y)={x}^{2}y.\n$$\n\nFinally, we find the level curve of the stream function $ψ(x,y)={x}^{2}y$ that passes through $P.$\nFirst, we find the value of the stream function at $P:$\n\n$$\n\\begin{aligned}ψ(-1,-1) & =(-1)^{2}\\cdot (-1) \\\\  & =1\\cdot (-1) \\\\  & =-1\\end{aligned}\n$$\n\nHence, the streamline that passes through $P(-1,-1)$ is the $-1$-level curve:\n\n$$\n\\begin{aligned}ψ(x,y) & =-1 \\\\ {x}^{2}y & =-1 \\\\ y & =-\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nTherefore, the streamline that passes through $P(-1,-1)$ is $y=-\\frac{1}{{x}^{2}}.$\nThe vector field and the streamline through the point $P$ are shown below.\n\n![](images/b8/b803554d852d985c8feca61804a9e52423391fc4624a01c4199d0744fbf2e28d.png)" #edb/ref 17592186045417] [17592186180092 #edb/ref 1068 #edb/ref 17592186178221 #edb/ref 17592186045417] [17592186180092 #edb/ref 1069 "q-162514" #edb/ref 17592186045417] [17592186180092 #edb/ref 1071 "Construct the vector field that has the stream function $ψ(x, y) = y^{2}e^{xy} + x^{2}$." #edb/ref 17592186045417] [17592186180092 #edb/ref 1072 #uuid "2b583ac2-a10b-5624-9dd5-8092730bcd5a" #edb/ref 17592186045417] [17592186180093 #edb/ref 1068 #edb/ref 17592186178227 #edb/ref 17592186045417] [17592186180093 #edb/ref 1069 "q-162640" #edb/ref 17592186045417] [17592186180093 #edb/ref 1071 "Which of the following vector fields have a stream function?\n\n1. $F(x, y) = 4xyi + y^{4}j$\n2. $F(x, y) = \\cos (3x)i + 3y\\sin (3x)j$\n3. $F(x, y) = e^{xy}i - ye^{x}j$" #edb/ref 17592186045417] [17592186180093 #edb/ref 1072 #uuid "58115dca-1aaa-5449-a87f-7951d165abcc" #edb/ref 17592186045417] [17592186180508 #edb/ref 1058 #edb/ref 17592186180551 #edb/ref 17592186045417] [17592186180508 #edb/ref 1061 35867 #edb/ref 17592186045417] [17592186180508 #edb/ref 1062 #uuid "8704325f-a4d0-5908-8630-87a2fdd6ce55" #edb/ref 17592186045417] [17592186180508 #edb/ref 1063 #edb/ref 17592186180726 #edb/ref 17592186045417] [17592186180551 #edb/ref 1058 #edb/ref 17592186180572 #edb/ref 17592186045417] [17592186180551 #edb/ref 1061 44491 #edb/ref 17592186045417] [17592186180551 #edb/ref 1062 #uuid "f95a8abc-f190-54e3-ab9c-c5ca8d31c613" #edb/ref 17592186045417] [17592186180551 #edb/ref 1063 #edb/ref 17592186179765 #edb/ref 17592186045417] [17592186180552 #edb/ref 1058 #edb/ref 17592186180566 #edb/ref 17592186045417] [17592186180552 #edb/ref 1061 44492 #edb/ref 17592186045417] [17592186180552 #edb/ref 1062 #uuid "0aa49923-0dc0-553a-a533-d846d4f56429" #edb/ref 17592186045417] [17592186180552 #edb/ref 1063 #edb/ref 17592186179766 #edb/ref 17592186045417] [17592186180565 #edb/ref 1061 44698 #edb/ref 17592186045417] [17592186180565 #edb/ref 1062 #uuid "dcb816eb-91e7-58ce-82b1-214fe5d095a2" #edb/ref 17592186045417] [17592186180565 #edb/ref 1063 #edb/ref 17592186179774 #edb/ref 17592186045417] [17592186180566 #edb/ref 1058 #edb/ref 17592186180571 #edb/ref 17592186045417] [17592186180566 #edb/ref 1061 44700 #edb/ref 17592186045417] [17592186180566 #edb/ref 1062 #uuid "173559da-bde2-5974-ae89-c0d7f7949615" #edb/ref 17592186045417] [17592186180566 #edb/ref 1063 #edb/ref 17592186180759 #edb/ref 17592186045417] [17592186180571 #edb/ref 1058 #edb/ref 17592186180565 #edb/ref 17592186045417] [17592186180571 #edb/ref 1061 44750 #edb/ref 17592186045417] [17592186180571 #edb/ref 1062 #uuid "f7a796a3-baa3-5a37-a25b-6048cc6cce34" #edb/ref 17592186045417] [17592186180571 #edb/ref 1063 #edb/ref 17592186179776 #edb/ref 17592186045417] [17592186180572 #edb/ref 1058 #edb/ref 17592186180552 #edb/ref 17592186045417] [17592186180572 #edb/ref 1061 44836 #edb/ref 17592186045417] [17592186180572 #edb/ref 1062 #uuid "fb48f733-4224-542a-8186-b1bda7425749" #edb/ref 17592186045417] [17592186180572 #edb/ref 1063 #edb/ref 17592186180763 #edb/ref 17592186045417] [17592186180726 #edb/ref 1064 "Let $\\psi(x,y)$ be a two-variable function defined on a simply connected open set $D \\subseteq \\mathbb{R}^2.$ We know that for a point $(x_0,y_0)\\in D,$ the vector\n\n$$\\left.\\left(\\dfrac{\\partial \\psi}{\\partial y}\\,\\mathbf i -\\dfrac{\\partial \\psi}{\\partial x}\\,\\mathbf j\\right)\\right|_{(x_0,y_0)}$$ is *tangential* to the level curve $\\psi(x,y) = \\psi(x_0,y_0).$\n\nBy computing this tangent vector at *every* point, we can generate a vector *field* tangential to the level curves of $\\psi$ at every point.\n\nWith that in mind, let\n\n$$\\mathbf F(x,y)= P(x,y)\\,\\mathbf{i} + Q(x,y)\\,\\mathbf{j}$$\n\nbe a vector field defined on $D.$ A function $\\psi(x,y)$ is said to be a **stream function** of $\\mathbf F$ if it satisfies\n\n$$P = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.$$\n\nFor example, let's consider the function\n\n$$\\psi(x,y) = x^2+y^2.$$\n\nTo construct a vector field with this stream function, we first compute the partial derivatives:\n\n$$\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\ & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}) \\\\ & =2y, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\ & =-\\frac{∂}{∂x}({x}^{2}+{y}^{2}) \\\\ & =-2x.\\end{aligned}$$\n\nThus, the vector field with the stream function $\\psi$ is given by\n\n$$\\begin{aligned}F(x,y) & =P\\,i+Q\\,j=2y\\,i-2x\\,j.\\end{aligned}$$\n\nA diagram showing the surface $z = \\psi(x,y),$ its level curves, and the vector field $\\mathbf F$ are shown below.\n\n![](images/69/696e6c623dbc3ecfae2643a7317d3d176294624289ecf6efb16debdc947d0394.png)\n\nNote the following:\n\n- The level curves of $\\psi(x,y)$ are circles of the form $x^2+y^2=c$, and the vector field $\\mathbf{F}$ in the $xy$-plane is tangential to these level curves.\n- Suppose $\\mathbf F$ represents the velocity of a fluid in the $xy$-plane. Then, the level curves of $\\psi(x,y)$ represent the path of a massless particle in the $xy$-plane moving with the flow. For this reason, the level curves of $\\psi$ are called **streamlines.**\n- The stream function of a vector field is typically not unique since we can add any constant to $\\psi$ to generate another valid stream function." #edb/ref 17592186045417] [17592186180726 #edb/ref 1065 5856 #edb/ref 17592186045417] [17592186180726 #edb/ref 1066 #uuid "9feba9cd-6bee-5c74-a1ab-940f686f38e7" #edb/ref 17592186045417] [17592186180726 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180759 #edb/ref 1064 "Let's find a stream function for the following vector field:\n\n$$\\mathbf{F}(x,y) = e^x \\sin y\\,\\mathbf{i} + e^x \\cos y\\,\\mathbf{j}$$\n\nNote that our vector field $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ has the simply connected domain $D=\\mathbb{R}^2,$ where\n\n$$P(x,y) = e^x\\sin y, \\qquad Q(x,y) = e^x\\cos y.$$\n\nLet's start by checking that a stream function exists. Computing the partial derivatives, we have\n\n$$\\begin{aligned}\\frac{∂P}{∂x}={e}^{x}\\operatorname{sin}y,\\,\\frac{∂Q}{∂y} & =-{e}^{x}\\operatorname{sin}y.\\end{aligned}$$\n\nHence, $\\mathbf F$ has a stream function since $\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.$\n\nNext, we find a stream function. A function $\\psi(x,y)$ is a stream function of the vector field $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ if\n\n$$P = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.$$\n\nIn our case, we have\n\n$$\\dfrac{\\partial \\psi}{\\partial y} = e^x\\sin y, \\qquad \\dfrac{\\partial \\psi}{\\partial x} = -e^x\\cos y.$$\n\nTo find a stream function, we **partially integrate** these two equations and compare the results:\n\n- For the first equation, we have $$\\dfrac{\\partial \\psi}{\\partial y} = e^x\\sin y$$ Partially integrating this equation with respect to $y$ (that is, treating $x$ as though it were a constant), we get $$\\begin{aligned}ψ(x,y) & =\\int {e}^{x}\\operatorname{sin}y\\,\\text{d}y+f(x) \\\\ & =-{e}^{x}\\operatorname{cos}y+f(x),\\end{aligned}$$ where $f$ is an arbitrary function.\n- For the second equation, we have $$\\dfrac{\\partial \\psi}{\\partial x} = -e^x\\cos y.$$ Partially integrating this equation with respect to $x$ (that is, treating $y$ as though it were a constant), we get $$\\begin{aligned}ψ(x,y) & =\\int -{e}^{x}\\operatorname{cos}y\\,\\text{d}x+g(y) \\\\ & =-{e}^{x}\\operatorname{cos}y+g(y)\\end{aligned}$$ where $g$ is an arbitrary function.\n\nComparing our two expressions for $\\psi,$ we get equality by setting $f=g=0.$ Therefore, we have\n\n$$\\psi(x,y) = -e^x \\cos y.$$\n\nFinally, remember that the streamlines of $\\mathbf F$ are given by the level curves of $\\psi.$ So, to find the streamlines of $\\mathbf F,$ we plot the curves $\\psi = k$ for different values of $k.$ The level curves of $\\psi$ are always tangential to $\\mathbf F.$" #edb/ref 17592186045417] [17592186180759 #edb/ref 1065 7704 #edb/ref 17592186045417] [17592186180759 #edb/ref 1066 #uuid "bc3ea425-1287-5a1d-ad21-3528a9c3d57e" #edb/ref 17592186045417] [17592186180759 #edb/ref 1067 "Calculating a Stream Function From Its Vector Field" #edb/ref 17592186045417] [17592186180763 #edb/ref 1064 "Not all vector fields have an associated stream function! So, it's useful to have some way of determining whether a given vector field has a stream function or not. For this, we have the following theorem:\n\n*Let $\\mathbf F= P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ be a vector field defined in a simply connected open set $D \\subseteq \\mathbb{R}^2.$ The vector field $\\mathbf{F}$ has a stream function $\\psi(x,y)$ if and only if* $$\\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} = 0.$$\n\nIn other words, the divergence of $\\mathbf F$ must be zero everywhere for a stream function to exist.\n\nWe won't give a detailed proof of this result here, but it's quite easy to see why it may be true.\n\nRecall that if $\\psi(x,y)$ is a stream function of $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j$ if it satisfies\n\n$$P = \\dfrac{\\partial \\psi}{\\partial y}, \\qquad Q = -\\dfrac{\\partial \\psi}{\\partial x}.$$\n\nCalculating the divergence of this vector field, we get\n\n$$\\begin{aligned}\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} & =\\frac{∂}{∂x}(\\frac{∂ψ}{∂y})+\\frac{∂}{∂y}(-\\frac{∂ψ}{∂x}) \\\\ & =\\frac{{∂}^{2}ψ}{∂x∂y}-\\frac{{∂}^{2}ψ}{∂y∂x} \\\\ & =\\frac{{∂}^{2}ψ}{∂x∂y}-\\frac{{∂}^{2}ψ}{∂x∂y} \\\\ & =0\\end{aligned}$$" #edb/ref 17592186045417] [17592186180763 #edb/ref 1065 7744 #edb/ref 17592186045417] [17592186180763 #edb/ref 1066 #uuid "61b21c71-3509-5455-86ba-1898b599345d" #edb/ref 17592186045417] [17592186180763 #edb/ref 1067 "An Existence Condition for Stream Functions" #edb/ref 17592186045417] [17592186372014 #edb/ref 1075 #edb/ref 17592186372015 #edb/ref 17592186045417] [17592186372014 #edb/ref 1075 #edb/ref 17592186372016 #edb/ref 17592186045417] [17592186372014 #edb/ref 1075 #edb/ref 17592186372017 #edb/ref 17592186045417] [17592186372014 #edb/ref 1075 #edb/ref 17592186372018 #edb/ref 17592186045417] [17592186372014 #edb/ref 1075 #edb/ref 17592186372019 #edb/ref 17592186045417] [17592186372014 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186372014 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186372014 #edb/ref 1078 #edb/ref 17592186372017 #edb/ref 17592186045417] [17592186372014 #edb/ref 1079 #uuid "5729d00f-ef28-5624-a8a5-015c4a539268" #edb/ref 17592186045417] [17592186372015 #edb/ref 1080 "y=-\\frac{2}{{x}^{2}}-3" #edb/ref 17592186045417] [17592186372015 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372015 #edb/ref 1083 #uuid "6eac7ad4-820f-5c18-9773-ebf398898a16" #edb/ref 17592186045417] [17592186372016 #edb/ref 1080 "y=\\frac{2}{{x}^{2}}-1" #edb/ref 17592186045417] [17592186372016 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372016 #edb/ref 1083 #uuid "282750a9-b937-50f2-972a-4e331bd8e692" #edb/ref 17592186045417] [17592186372017 #edb/ref 1080 "y=-\\frac{1}{{x}^{2}}" #edb/ref 17592186045417] [17592186372017 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372017 #edb/ref 1083 #uuid "373316d8-46cd-53f6-9b91-7cb17ade342b" #edb/ref 17592186045417] [17592186372018 #edb/ref 1080 "y=\\frac{1}{x}" #edb/ref 17592186045417] [17592186372018 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372018 #edb/ref 1083 #uuid "27a69ac4-2f12-5bf5-8488-d73f81f4be67" #edb/ref 17592186045417] [17592186372019 #edb/ref 1080 "x=-\\frac{1}{{y}^{2}}" #edb/ref 17592186045417] [17592186372019 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372019 #edb/ref 1083 #uuid "4883ebfa-3093-54d8-a60b-84cb2521bc67" #edb/ref 17592186045417] [17592186372034 #edb/ref 1068 #edb/ref 17592186372035 #edb/ref 17592186045417] [17592186372034 #edb/ref 1069 "q-162492" #edb/ref 17592186045417] [17592186372034 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186372034 #edb/ref 1071 "Construct the vector field that has the stream function $ψ(x,y)={x}^{3}-3x{y}^{2}.$" #edb/ref 17592186045417] [17592186372034 #edb/ref 1072 #uuid "65d2f94e-229a-51fd-a26e-3f0815f0eb18" #edb/ref 17592186045417] [17592186372034 #edb/ref 1074 "A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if the following equations hold:\n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}\n$$\n\nComputing the partial derivatives of the function $ψ(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}({x}^{3}-3x{y}^{2}) \\\\  & =-6xy, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}({x}^{3}-3x{y}^{2}) \\\\  & =-3{x}^{2}+3{y}^{2}.\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $ψ(x,y)={x}^{3}-3x{y}^{2}$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =-6xy\\,i-(3{x}^{2}-3{y}^{2})\\,j.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186372035 #edb/ref 1075 #edb/ref 17592186372036 #edb/ref 17592186045417] [17592186372035 #edb/ref 1075 #edb/ref 17592186372037 #edb/ref 17592186045417] [17592186372035 #edb/ref 1075 #edb/ref 17592186372038 #edb/ref 17592186045417] [17592186372035 #edb/ref 1075 #edb/ref 17592186372039 #edb/ref 17592186045417] [17592186372035 #edb/ref 1075 #edb/ref 17592186372040 #edb/ref 17592186045417] [17592186372035 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186372035 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186372035 #edb/ref 1078 #edb/ref 17592186372040 #edb/ref 17592186045417] [17592186372035 #edb/ref 1079 #uuid "c25bb45f-532f-5ba4-9fd3-2f3c979bc106" #edb/ref 17592186045417] [17592186372036 #edb/ref 1080 "F(x,y)=(6{x}^{2}+3xy)\\,i-3{x}^{2}y\\,j" #edb/ref 17592186045417] [17592186372036 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372036 #edb/ref 1083 #uuid "6596a7e1-33c8-5770-ad3d-4bd6746339f9" #edb/ref 17592186045417] [17592186