03 #edb/ref 17592186045417] [17592186335574 #edb/ref 1075 #edb/ref 17592186334306 #edb/ref 17592186045417] [17592186335574 #edb/ref 1075 #edb/ref 17592186334623 #edb/ref 17592186045417] [17592186335574 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186335574 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186335574 #edb/ref 1078 #edb/ref 17592186334306 #edb/ref 17592186045417] [17592186335574 #edb/ref 1079 #uuid "b47f96a3-e6a8-5ed6-8d03-4b9a5051d156" #edb/ref 17592186045417] [17592186339115 #edb/ref 1068 #edb/ref 17592186440324 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440325 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440326 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440327 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440328 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440329 #edb/ref 17592186045436] [17592186339115 #edb/ref 1068 #edb/ref 17592186440330 #edb/ref 17592186045436] [17592186339115 #edb/ref 1069 "q-72440" #edb/ref 17592186045417] [17592186339115 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186339115 #edb/ref 1071 "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-4,1)$\n- **II.** $(-4,4)$\n- **III.** $(-2,4)$\n- **IV.** $(-1,1)$\n- **V.** $(-1,4)$\n- **VI.** $(1,1)$\n- **VII.** $(4,-4)$" #edb/ref 17592186045436] [17592186339115 #edb/ref 1072 #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" #edb/ref 17592186045417] [17592186339115 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$" #edb/ref 17592186045417] [17592186354754 #edb/ref 1080 "\\frac{\\sqrt{3}}{6}" #edb/ref 17592186045417] [17592186354754 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186354754 #edb/ref 1083 #uuid "09b13814-4c69-5bb6-8b57-73e807680e9e" #edb/ref 17592186045417] [17592186355277 #edb/ref 1080 "p=7" #edb/ref 17592186045417] [17592186355277 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186355277 #edb/ref 1083 #uuid "44ca90e4-8cb7-55b8-a354-4e9dc097fb72" #edb/ref 17592186045417] [17592186355354 #edb/ref 1080 "p=\\frac{7}{2}" #edb/ref 17592186045417] [17592186355354 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186355354 #edb/ref 1083 #uuid "4dd7fbc0-1387-5d34-8f46-c4279237b187" #edb/ref 17592186045417] [17592186355356 #edb/ref 1080 "y={e}^{-3x}(2\\operatorname{cos}⁡2x+2\\operatorname{sin}⁡2x)" #edb/ref 17592186045417] [17592186355356 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186355356 #edb/ref 1083 #uuid "4de3cea3-9ce1-5117-8440-1c848ea22d4f" #ed