rrect {:db/id #edb/ref 17592186439927} :answer-field/id #uuid "150d32c1-350a-571d-834f-71f20d3a563a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440321} {:answer-field/choices [{:answer/id #uuid "ed83a8d6-9e07-5905-be1f-34b393c3d6da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439929} {:answer/id #uuid "dcef0c5c-1acb-5551-97b3-3f576bf135b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439930}] :answer-field/correct {:db/id #edb/ref 17592186439929} :answer-field/id #uuid "1e3dbaf6-9358-5c2a-9801-aef6c67ddc06" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440322} {:answer-field/choices [{:answer/id #uuid "065e1081-b5f1-5f33-a472-b91a349b1ad0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439931} {:answer/id #uuid "4bed7d93-95ff-5f0a-9e8a-462b709673d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439932}] :answer-field/correct {:db/id #edb/ref 17592186439932} :answer-field/id #uuid "a537d884-e552-57b7-b8f8-e2de9abb83a0" :answer-field/key "VI" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440323}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9c0801c9-8ff6-5c1f-a200-5a0877707694" :question/math-academy-id "q-72410" :question/problem "At which points on the curve ${y}^{2}+2xy={x}^{2}+8$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-2,-2)$\n- **II.** $(0,2)$\n- **III.** $(1,2)$\n- **IV.** $(2,0)$\n- **V.** $(2,1)$\n- **VI.** $(2,2)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2xy & ={x}^{2}+8 \\\\ {y}^{2}+2xy-{x}^{2} & =8\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2xy-{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=8.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2xy-{x}^{2})i-\\frac{∂}{∂x}({y}^{2}+2xy-{x}^{2})j \\\\  & =2(y+x)\\,i-2(y-x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ (2(y+x)\\,i-2(y-x)\\,j)\\cdot j & =0 \\\\ -2(y-x) & =0 \\\\ y & =x\\end{aligned}\n$$\n\nSubstituting $y=x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2xy-{x}^{2} & =8 \\\\ (x)^{2}+2x(x)-{x}^{2} & =8 \\\\ {x}^{2}+2{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nFinally:\n\n- If $x=2$, we get $y=2$ and the corresponding point is $(2,2).$\n\n- If $x=-2$, we get $y=-2$ and the corresponding point is $(-2,-2).$"} :step/id #uuid "8010488e-cbf0-5349-af76-b70ec53c1a3b" :step/next {:db/id #edb/ref 17592186482636}} {:db/id #edb/ref 17592186482651 :step/content {:db/id #edb/ref 17592186373757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439519} {:answer/id #uuid "8c88915e-5b21-5b50-b76c-b452eb74095d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439520}] :answer-field/correct {:db/id #edb/ref 17592186439519} :answer-field/id #uuid "cb7991eb-11ab-5be8-9cff-8cb4c831a986" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440117} {:answer-field/choices [{:answer/id #uuid "bee1c3fd-7f28-5bd0-8439-264f31d9f15a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439521} {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439522}] :answer-field/correct {:db/id #edb/ref 17592186439522} :answer-field/id #uuid "f05aaa51-707b-51f8-bed1-c062eb9077c6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440118} {:answer-field/choices [{:answer/id #uuid "049822ce-ef15-5b5d-9864-ade62a37ec43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439523} {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439524}] :answer-field/correct {:db/id #edb/ref 17592186439524} :answer-field/id #uuid "24967753-af42-5895-a050-8e8c6b225ad6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440119} {:answer-field/choices [{:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439525} {:answer/id #uuid "65a64ec9-6cdd-507e-9bfb-590aab6a8b2f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439526}] :answer-field/correct {:db/id #edb/ref 17592186439525} :answer-field/id #uuid "ed98d8f5-235d-543c-a23d-ff763ed379a9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440120}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,1)$\n- **II.** $(0,0)$\n- **III.** $(0,\\frac{1}{3})$\n- **IV.** $(1,1)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"} :step/id #uuid "d3f5afa9-3e2d-58c5-8c55-a63599bc185e"}] :activity/title "Tangent Lines to Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481766}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186499569} :activity/id #uuid "5ef3df9a-43f6-544e-9018-3bb84592edfe" :activity/scope {:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940} :activity/steps [{:db/id #edb/ref 17592186499569 :step/content {:db/id #edb/ref 17592186124970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cece21e-845c-5406-87a0-7fadb456d6b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439641} {:answer/id #uuid "de5a9a5b-9a4a-5dff-ae52-46bed3fefdc0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "tru