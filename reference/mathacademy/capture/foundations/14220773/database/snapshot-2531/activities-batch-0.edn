af-55d2-b87e-abf9b7184442" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439649} {:answer/id #uuid "223a19d3-0ddf-546c-8353-4b22a48e3261" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439650}] :answer-field/correct {:db/id #edb/ref 17592186439650} :answer-field/id #uuid "1b25df16-15af-5c49-a2f0-8d1d38790392" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440182}] :question/id #uuid "fa8c1acf-fd5d-5946-ab8b-13077cafbbf0" :question/math-academy-id "q-36332" :question/problem "At which points on the curve $2xy + 3y^{2} = x^{2} + 4$ is the tangent vector to the curve perpendicular to the vector $j$?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,-1)$\n- **II.** $(-1,0)$\n- **III.** $(0,1)$\n- **IV.** $(1,-1)$\n- **V.** $(1,1)$" :question/worked-solution "Write the curve as F(x,y)=0. A tangent is (F_y,-F_x); its dot product with the given vector is $2 x - 2 y$. Solving this with the curve equation gives $(-1,-1), (1,1)$, and the tangent is nonzero at each point."} :step/id #uuid "05a2099a-d88b-5b18-b5ca-d033c5db5614" :step/next {:db/id #edb/ref 17592186499600}} {:db/id #edb/ref 17592186499577 :step/content {:db/id #edb/ref 17592186499527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-1)$ only" :db/id #edb/ref 17592186498822} {:answer/id #uuid "9c2fce83-b1b2-5397-8cab-576be2461576" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,2)$ only" :db/id #edb/ref 17592186499059} {:answer/id #uuid "a70e370b-8012-5ba7-8c81-0ea9db91d6f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,-1)$ only" :db/id #edb/ref 17592186499097} {:answer/id #uuid "d553a226-27d4-508f-a4c8-4c5c6f0cd0cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,-1)$  and $(1,2)$" :db/id #edb/ref 17592186499207} {:answer/id #uuid "e67fa0c9-ee34-5eea-a810-dee87b7233d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,-2)$  and $(1,2)$" :db/id #edb/ref 17592186499253}] :answer-field/correct {:db/id #edb/ref 17592186498822} :answer-field/id #uuid "f38fea1a-0a62-5cc4-9aaa-d50dbb5879df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499427}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b5a12ff0-24e0-5963-9f16-1e9a01270fba" :question/math-academy-id "q-72439" :question/problem "At which points on the curve ${y}^{2}-xy=x+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-xy & =x+1 \\\\ {y}^{2}-xy-x & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-xy-x$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-xy-x)i-\\frac{∂}{∂x}({y}^{2}-xy-x)j \\\\  & =(2y-x)\\,i+(y+1)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-x)\\,i+(y+1)\\,j)\\cdot i & =0 \\\\ 2y-x & =0 \\\\ x & =2y\\end{aligned}\n$$\n\nSubstituting $x=2y$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-(2y)y-(2y) & =1 \\\\ {y}^{2}-2{y}^{2}-2y-1 & =0 \\\\ -{y}^{2}-2y-1 & =0 \\\\ {y}^{2}+2y+1 & =0 \\\\ (y+1)^{2} & =0 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally:\n\n- If $y=-1$, we get $x=-2$ and the corresponding point is $(-2,-1).$"} :step/id #uuid "2f4293a9-a10e-5b28-82a5-1a8b2fd293b4" :step/next {:db/id #edb/ref 17592186499584}} {:db/id #edb/ref 17592186499584 :step/content {:db/id #edb/ref 17592186363031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f3795a-9c5d-564b-99c5-8234a8f8adae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,j" :db/id #edb/ref 17592186363033} {:answer/id #uuid "17117ea5-c48d-5a75-87dd-44fd4b306516" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "i-2\\,j" :db/id #edb/ref 17592186363034} {:answer/id #uuid "a1a1d040-84f6-5093-b8b7-a02c512a3ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,i-2\\,j" :db/id #edb/ref 17592186363035} {:answer/id #uuid "afb47ff5-03cb-5158-9e15-6ff6eeca5436" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\,i" :db/id #edb/ref 17592186363036} {:answer/id #uuid "0c788786-b66b-5944-b4ad-21c56064f8a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186363037}] :answer-field/correct {:db/id #edb/ref 17592186363037} :answer-field/id #uuid "d07c4d10-4f15-5f81-9aca-9c05aa1a4821" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186363032}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55fb49e6-3301-5747-997a-6aea4f919a61" :question/math-academy-id "q-130201" :question/problem "Consider the plane curve $xy=3-{x}^{2}-{y}^{3}.$ Find a tangent vector to that curve at the point $(-1,-1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}xy & =3-{x}^{2}-{y}^{3} \\\\ xy+{x}^{2}+{y}^{3} & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)=xy+{x}^{2}+{y}^{3},$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve that passes through the point $(-1,-1)$ can be computed as follows:\n\n$$\nt(-1,-1)={f}_{y}(-1,-1)i-{f}_{x}(-1,-1)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,-1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(xy+{x}^{2}+{y}^{3})i-\\frac{∂}{∂x}(xy+{x}^{2}+{y}^{3})j \\\\  & =(x+3{y}^{2})i-(y+2x)j \\\\ t(-1,-1) & =(-1+3(-1)^{2})i-(-1+2(-1))j \\\\  & =2\\,i+3\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $2\\,i+3\\,j.$"} :step/id #uuid "4cfb1824-7d95-5b0c-8d42-9c86792c679d"} {:db/id #edb/ref 17592186499600 :step/content {:db/id #edb/ref 17592186499529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39ba8864-9639-569c-861f-6e638330546b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "i-j" :db/id #edb/ref 17592186498857} {:answer/id #uuid "7b5ff22c-2612-54bb-bf13-52b4667b899d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i-j" :db/id #edb/ref 17592186499006} {:answer/id #uuid "9d918342-1efd-5f5f-a70c-62d3002a283b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i" :db/id #edb/ref 17592186499065} {:answer/id #uuid "b5fcce98-7907-5c3f-8f29-c741eb4b7cca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i+j" :db/id #edb/ref 17592186499135} {:answer/id #uuid "ca1550ba-8b0e-51be-878a-b2b84082b1f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-j" :db/id #edb/ref 17592186499172}] :answer-field/correct {:db/id #edb/ref 17592186499172} :answer-field/id #uuid "f7015fd4-ab37-5009-8ea6-02df343db6e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499428}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b96af04a-99a9-59d6-b4b4-fac54542ff08" :question/math-academy-id "q-65205" :question/problem "Consider the plane curve $x{e}^{y}-1=xy.$ Find a tangent vector to that curve at the point $(1,0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{e}^{y}-1 & =xy \\\\ x{e}^{y}-xy & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=x{e}^{y}-xy$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve that passes through the point $(1,0)$ can be computed as follows:\n\n$$\nt(1,0)={f}_{y}(1,0)i-{f}_{x}(1,0)j\n$$\n\n \n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,0):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(x{e}^{y}-xy)i-\\frac{∂}{∂x}(x{e}^{y}-xy)j \\\\  & =(x{e}^{y}-x)i-({e}^{y}-y)j \\\\ t(1,0) & =((1){e}^{0}-(1))i-({e}^{0}-(0))j \\\\  & =-j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-j.$"} :step/id #uuid "8b2ff19d-a282-5f52-b7ed-a3b65431ddba" :step/next {:db/id #edb/ref 17592186499624}} {:db/id #edb/ref 17592186499624 :step/content {:db/id #edb/ref 17592186499554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1052d2-3a28-5ca0-9e37-9f2ccf48871c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i-j" :db/id #edb/ref 17592186498760} {:answer/id #uuid "0f687a71-756e-59f6-bc52-a42d2a1ff16b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i-3\\,j" :db/id #edb/ref 17592186498761} {:answer/id #uuid "1ac23b03-c1ad-5ab7-be63-a35fc34705f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-3\\,j" :db/id #edb/ref 17592186498787} {:answer/id #uuid "5cf883f8-d823-5d14-9a1b-8d3c64093c5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,i-2\\,j" :db/id #edb/ref 17592186498942} {:answer/id #uuid "fac357f6-d241-5f53-aa60-7685a0cfadeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-j" :db/id #edb/ref 17592186499292}] :answer-field/correct {:db/id #edb/ref 17592186498760} :answer-field/id #uuid "0f7da737-6ab6-5dc3-a356-5e38af59041a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499319}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea587ab0-d077-5468-b262-1697c88c7094" :question/math-academy-id "q-72389" :question/problem "Consider the plane curve $2{e}^{xy}=x+y+1.$ Find a tangent vector to that curve at the point $(0,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{e}^{xy} & =x+y+1 \\\\ 2{e}^{xy}-x-y-1 & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{e}^{xy}-x-y-1$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,1)$ can be computed as follows:\n\n$$\nt(0,1)={f}_{y}(0,1)\\,i-{f}_{x}(0,1)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2{e}^{xy}-x-y-1)\\,i-\\frac{∂}{∂x}(2{e}^{xy}-x-y-1)\\,j \\\\  & =(2x{e}^{xy}-1)\\,i-(2y{e}^{xy}-1)\\,j \\\\ t(0,1) & =(2(0){e}^{(0)(1)}-1)\\,i-(2(1){e}^{(0)(1)}-1)\\,j \\\\  & =-i-j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i-j.$"} :step/id #uuid "dcad53eb-6ded-5184-a27b-881f5dbfc54b" :step/next {:db/id #edb/ref 17592186499577}}] :activity/title "Tangent Lines to Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498722}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186500429} :activity/id #uuid "28f0525e-a9ec-575c-a608-1d31d5ce784d" :activity/scope {:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940} :activity/steps [{:db/id #edb/ref 17592186500393 :step/content {:db/id #edb/ref 17592186500338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0c0406-ae8d-54c8-b629-8afd582156ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,2)$ only" :db/id #edb/ref 17592186499678} {:answer/id #uuid "23b36d38-920a-5a19-90af-0d58ea66b6c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,2)$ only" :db/id #edb/ref 17592186499733} {:answer/id #uuid "4e379d7d-a44b-5b19-ae49-edc70a8dad28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(\\sqrt[3]{4},-\\sqrt[3]{4})$" :db/id #edb/ref 17592186499802} {:answer/id #uuid "930ec2dc-3268-5e8c-bb20-3557f9ac1938" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(-2,-2)$" :db/id #edb/ref 17592186499942} {:answer/id #uuid "fd6ba7c0-fd84-5eed-9805-7ee46c6511bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(2,2)$" :db/id #edb/ref 17592186500174}] :answer-field/correct {:db/id #edb/ref 17592186499678} :answer-field/id #uuid "956e93fd-6df8-5b5f-8f5c-3b6f83220074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186500239}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a5f3b132-60d1-51a8-b2e5-d8b20ae5add9" :question/math-academy-id "q-65209" :question/problem "At which points on the curve $3y{x}^{2}=48+3x{y}^{2}$ is the tangent vector to the curve perpendicular to the vector $i-j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{x}^{2}-3x{y}^{2} & =48\\end{aligned}\n$$\n\nIf we set $f(x,y)=3y{x}^{2}-3x{y}^{2}$, our curve can be viewed as the level curve $f(x,y)=48.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(3y{x}^{2}-3x{y}^{2})i-\\frac{∂}{∂x}(3y{x}^{2}-3x{y}^{2})j \\\\  & =(3{x}^{2}-6xy)i-(6xy-3{y}^{2})j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot (i-j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i-j) & =0 \\\\ ((3{x}^{2}-6xy)i-(6xy-3{y}^{2})j)\\cdot (i-j) & =0 \\\\ 3{x}^{2}-6xy+6xy-3{y}^{2} & =0 \\\\ 3{x}^{2}-3{y}^{2} & =0 \\\\ {x}^{2}-{y}^{2} & =0 \\\\ (x-y)(x+y) & =0\\end{aligned}\n$$\n\nTherefore, $x=y$ or $x=-y.$ Substituting $x=y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{y}^{2} & =48+3y{y}^{2} \\\\ 3{y}^{3} & =48+3{y}^{3} \\\\ 0 & =48\\end{aligned}\n$$\n\nSince we get a false statement, we conclude that does not exist points of the form $(x,x)$ on the curve. Substituting $x=-y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y(-y)^{2} & =48+3(-y){y}^{2} \\\\ 3{y}^{3} & =48-3{y}^{3} \\\\ 6{y}^{3} & =48 \\\\ {y}^{3} & =8 \\\\ y & =\\sqrt[3]{8} \\\\ y & =2\\end{aligned}\n$$\n\nFinally:\n\n- If $y=2$, we get $x=-2$ and the corresponding point is $(-2,2).$"} :step/id #uuid "2240391e-6239-5c26-8753-fbe476494f29"} {:db/id #edb/ref 17592186500429 :step/content {:db/id #edb/ref 17592186125191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} {:answer/id #uuid "043f0c6b-beee-5929-91a6-329b0aba6cab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364298} {:answer/id #uuid "6c7f3a73-6bb3-57e1-b890-8a39b32ac5a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}\\,i+j" :db/id #edb/ref 17592186364299} {:answer/id #uuid "b9bd5e2f-eea5-58c3-8f18-2c41ef884348" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i-j" :db/id #edb/ref 17592186364300} {:answer/id #uuid "cb787b13-c2e5-5275-b510-4a2ee9675a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}\\,i-j" :db/id #edb/ref 17592186364301}] :answer-field/correct {:db/id #edb/ref 17592186364297} :answer-field/id #uuid "4633732e-7712-5dd5-9f2e-d57d7262b765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad74cdc7-0885-5bf3-989d-0d3835ead91a" :question/math-academy-id "q-65204" :question/problem "Consider the plane curve $\\operatorname{cos}⁡x\\operatorname{cos}⁡y=\\operatorname{sin}⁡(xy).$ Find a tangent vector to that curve at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\operatorname{cos}⁡y & =\\operatorname{sin}⁡xy \\\\ \\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy) & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡xy$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,\\frac{\\pi }{2})$ can be computed as follows:\n\n$$\nt(0,\\frac{\\pi }{2})={f}_{y}(0,\\frac{\\pi }{2})i-{f}_{x}(0,\\frac{\\pi }{2})j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,i-\\frac{∂}{∂x}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,j \\\\  & =(-\\operatorname{cos}⁡x\\operatorname{sin}⁡y-x\\operatorname{cos}⁡(xy))i-(-\\operatorname{sin}⁡x\\operatorname{cos}⁡y-y\\operatorname{cos}⁡(xy))\\,j \\\\ t(0,\\frac{\\pi }{2}) & =(-\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))i-(-\\operatorname{sin}⁡(0)\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))j \\\\  & =-i+\\frac{\\pi }{2}\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i+\\frac{\\pi }{2}\\,j.$"} :step/id #uuid "9e08735b-2a3b-57c7-99b1-ddcbb644aa6b" :step/next {:db/id #edb/ref 17592186500448}} {:db/id #edb/ref 17592186500448 :step/content {:db/id #edb/ref 17592186125192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce07dfdf-2d2a-50b4-b231-394b5d5d097f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439857} {:answer/id #uuid "85dfbd24-c291-5c08-b3d8-efa72d2bebc9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439858}] :answer-field/correct {:db/id #edb/ref 17592186439857} :answer-field/id #uuid "76b7e8b2-e034-52dd-9da2-5852ff35bd1c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440286} {:answer-field/choices [{:answer/id #uuid "75afdcde-1b54-58d6-b950-1389a729ce22" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439859} {:answer/id #uuid "ddc181f6-b619-50be-b805-c3f50013f219" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439860}] :answer-field/correct {:db/id #edb/ref 17592186439860} :answer-field/id #uuid "32972e40-590f-5893-946b-6bd1c90198c0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440287} {:answer-field/choices [{:answer/id #uuid "38c129c4-6cdd-5109-a4f7-14ddc43a724a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439861} {:answer/id #uuid "3e06be53-d9b1-54cd-bff2-19c4f3681747" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439862}] :answer-field/correct {:db/id #edb/ref 17592186439862} :answer-field/id #uuid "30e09a55-e1b1-529e-9575-29c8323f08a4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440288} {:answer-field/choices [{:answer/id #uuid "5278cce0-690a-57d3-9f99-59786668dd25" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439863} {:answer/id #uuid "c194ddff-249d-568f-bbed-b5a98a9cbf2b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439864}] :answer-field/correct {:db/id #edb/ref 17592186439864} :answer-field/id #uuid "4f6cf21c-f929-519d-97e8-9c947398a3c9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440289} {:answer-field/choices [{:answer/id #uuid "fd09c21d-1862-5911-bc93-7b66b39ffdd2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439865} {:answer/id #uuid "800ae177-fe54-5efa-bdce-f8e4327de277" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439866}] :answer-field/correct {:db/id #edb/ref 17592186439865} :answer-field/id #uuid "50868321-e216-553a-b3ca-72efe4f524e3" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440290}] :question/id #uuid "142e660e-5b1f-5e61-a343-ee1945f69615" :question/math-academy-id "q-65208" :question/problem "At which points on the curve $9x^{2}y = 3y^{3} - 6x$ is the tangent vector to the curve perpendicular to the vector $i$?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,-1)$\n- **II.** $(-1,1)$\n- **III.** $(0,0)$\n- **IV.** $(1,-1)$\n- **V.** $(1,1)$" :question/worked-solution "Write the curve as F(x,y)=0. A tangent is (F_y,-F_x); its dot product with the given vector is $9 x^{2} - 9 y^{2}$. Solving this with the curve equation gives $(-1,1), (0,0), (1,-1)$, and the tangent is nonzero at each point."} :step/id #uuid "e52e5366-4dc8-5cb0-a9bb-eeeb3bfd45c4" :step/next {:db/id #edb/ref 17592186500393}}] :activity/title "Tangent Lines to Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186499643}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186125282} :activity/id #uuid "4335d62f-6a14-5864-be7f-c04874251357" :activity/scope {:db/id #edb/ref 17592186049696 :topic/id #uuid "0bfad6b0-12ee-58d9-8324-1f301647b82f" :topic/math-academy-id 1957} :activity/steps [{:db/id #edb/ref 17592186125282 :step/content {:db/id #edb/ref 17592186125729 :tutorial/content "Suppose that $f(x,y) = x y^2 - x^3 y.$ Then the first-order partial derivatives are\n\n$$\n\\dfrac{\\partial f}{\\partial x} (x,y) = y^2 -3x^2y \\quad \\mathrm{and} \\quad \\dfrac{\\partial f}{\\partial y}(x,y) = 2xy -x^3,\n$$\n\nand the second-order **mixed partial derivatives** are \n\n$$\n\\dfrac{\\partial^2 f}{\\partial y\\, \\partial x}(x,y) = 2y -3x^2 \\quad \\mathrm{and} \\quad  \\dfrac{\\partial^2 f}{\\partial x\\, \\partial y}(x,y) = 2y-3x^2.\n$$\n\nNotice that these two mixed partial derivatives are equal, i.e., \n\n$$\n\\dfrac{\\partial^2 f}{\\partial y\\, \\partial x}=\\dfrac{\\partial^2 f}{\\partial x\\, \\partial y}.\n$$\n\nIn general, if a function $f(x,y)$ has continuous first-order partial derivatives on an open set $U,$ and the second-order mixed partial derivatives exist and are continuous on $U,$ then the mixed partial derivatives are equal everywhere on $U.$" :tutorial/id #uuid "96f3873b-8f1b-5481-827e-503e557bbe9c" :tutorial/math-academy-id 2408 :tutorial/title "Introduction"} :step/id #uuid "81952bcf-8d7d-50aa-9c3d-0f75127d5ba3" :step/math-academy-id 10705 :step/next {:db/id #edb/ref 17592186125283}} {:db/id #edb/ref 17592186125283 :step/content {:db/id #edb/ref 17592186124448 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124252 :question/id #uuid "2247dc40-0c71-596c-9da4-a3bffd85e106" :question/math-academy-id "e-3152"} :knowledge-point/id #uuid "43ee40fd-e452-5593-9a35-7c46d1f0cca0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048781}] :knowledge-point/questions [{:db/id #edb/ref 17592186125003} {:db/id #edb/ref 17592186125187} {:db/id #edb/ref 17592186348428} {:db/id #edb/ref 17592186348430} {:db/id #edb/ref 17592186383321} {:db/id #edb/ref 17592186385734} {:db/id #edb/ref 17592186385741} {:db/id #edb/ref 17592186400688} {:db/id #edb/ref 17592186403186} {:db/id #edb/ref 17592186404121} {:db/id #edb/ref 17592186437089} {:db/id #edb/ref 17592186437090}] :knowledge-point/title "Finding Missing Constants in First-Order Partial Derivative Expressions"} :step/id #uuid "3cac5a52-91a4-530b-93a7-3b880c3d7869" :step/math-academy-id 10709 :step/next {:db/id #edb/ref 17592186125285}} {:db/id #edb/ref 17592186125284 :step/content {:db/id #edb/ref 17592186124449 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124253 :question/id #uuid "d45926a5-0126-50b4-bdc7-a9f686408986" :question/math-academy-id "e-3153"} :knowledge-point/id #uuid "a7619454-7a2b-5c0b-927c-24dca2e564c3" :knowledge-point/questions [{:db/id #edb/ref 17592186124990} {:db/id #edb/ref 17592186124999} {:db/id #edb/ref 17592186268928} {:db/id #edb/ref 17592186268929} {:db/id #edb/ref 17592186268930} {:db/id #edb/ref 17592186268931} {:db/id #edb/ref 17592186323822} {:db/id #edb/ref 17592186335801} {:db/id #edb/ref 17592186383356} {:db/id #edb/ref 17592186385467} {:db/id #edb/ref 17592186385748} {:db/id #edb/ref 17592186403179} {:db/id #edb/ref 17592186409650} {:db/id #edb/ref 17592186409651} {:db/id #edb/ref 17592186437088} {:db/id #edb/ref 17592186479870}] :knowledge-point/title "Evaluating Expressions of Partial Derivatives at a Point"} :step/id #uuid "03eb0268-bd36-5a13-83fe-9c238bbe818f" :step/math-academy-id 10710} {:db/id #edb/ref 17592186125285 :step/content {:db/id #edb/ref 17592186124450 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124254 :question/id #uuid "d62e8502-b3c5-5923-8ab3-ef988507cd2c" :question/math-academy-id "e-3154"} :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/questions [{:db/id #edb/ref 17592186124998} {:db/id #edb/ref 17592186125186} {:db/id #edb/ref 17592186268926} {:db/id #edb/ref 17592186268927} {:db/id #edb/ref 17592186348444} {:db/id #edb/ref 17592186348445} {:db/id #edb/ref 17592186383328} {:db/id #edb/ref 17592186383335} {:db/id #edb/ref 17592186383342} {:db/id #edb/ref 17592186383349} {:db/id #edb/ref 17592186394023} {:db/id #edb/ref 17592186394057} {:db/id #edb/ref 17592186394064} {:db/id #edb/ref 17592186479833} {:db/id #edb/ref 17592186489263}] :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"} :step/id #uuid "e1813dc3-f991-54bc-bf74-b3e674f858b0" :step/math-academy-id 10713 :step/next {:db/id #edb/ref 17592186125330}} {:db/id #edb/ref 17592186125330 :step/content {:db/id #edb/ref 17592186125755 :tutorial/content "If $f(x,y)$ is a function whose first-order and second-order mixed partial derivatives are continuous on an open set $U,$ then the second-order mixed partial derivatives are equal everywhere on $U.$\n\n$$\n\\dfrac{\\partial^2 f}{\\partial x\\, \\partial y} =\\dfrac{\\partial^2 f}{\\partial y\\, \\partial x}\n$$\n\nThis result also extends to higher-order partial derivatives. For example, if the third-order partial derivatives of $f(x,y)$ are also continuous everywhere on $U,$ then the third-order mixed partial derivatives are independent of the order in which the differentiation is performed. \n\nFor example,\n\n$$\n\\dfrac{\\partial^3 f}{\\color{blue}\\partial x\\, \\partial x\\, \\partial y} =\\dfrac{\\partial^3 f}{\\color{red}\\partial y\\, \\partial x \\, \\partial x}.\n$$\n\nIn this case, we can think of $\\color{blue}\\partial x\\, \\partial x\\, \\partial y$ and $\\color{red}\\partial y\\, \\partial x \\, \\partial x$ as distinct permutations of the symbols $\\partial x,\\partial x,$ and $\\partial y.$ Any permutation of these symbols gives the same result. For example,\n\n$$\n\\dfrac{\\partial^3 f}{\\color{blue}\\partial x\\, \\partial x\\, \\partial y} = \\dfrac{\\partial^3 f}{\\color{purple}\\partial x\\, \\partial y\\, \\partial x}.\n$$\n\n**Watch out!** This does **not** mean that *all* third partial derivatives are equal! For example, it is generally true that\n\n$$\n\\dfrac{\\partial^3 f}{\\color{blue}\\partial x\\, \\partial x\\, \\partial y} \\neq \\dfrac{\\partial^3 f}{\\partial x\\, \\partial y\\, \\partial y}.\n$$\n\n \nThese are not equal because $\\partial x\\, \\partial y\\, \\partial y$ (in the right-hand side denominator) is a permutation of the symbols $\\partial x, \\partial y, \\partial y,$ not $\\partial x, \\partial x, \\partial y.$" :tutorial/id #uuid "2267ab49-4a4d-553c-ba46-127edac4a2e8" :tutorial/math-academy-id 2884 :tutorial/title "Equality of Higher-Order Partial Derivatives"} :step/id #uuid "fec110b5-a92e-591e-b9da-4dceefec8548" :step/math-academy-id 15480 :step/next {:db/id #edb/ref 17592186125284}}] :activity/title "Equality of Mixed Partial Derivatives" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124742}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409654} :activity/id #uuid "3c715a18-b04f-5fa8-b565-cd1d87a53bb9" :activity/scope {:db/id #edb/ref 17592186049696 :topic/id #uuid "0bfad6b0-12ee-58d9-8324-1f301647b82f" :topic/math-academy-id 1957} :activity/steps [{:db/id #edb/ref 17592186409652 :step/content {:db/id #edb/ref 17592186409651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4421a8c6-aea6-5d62-9cd0-8a06f8915dcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186409638} {:answer/id #uuid "45730328-f0dc-5c33-a6c2-53d71d04445d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409639} {:answer/id #uuid "4d58c242-f6fd-5d67-8e96-0273fcae35a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409641} {:answer/id #uuid "59fd5070-c975-5965-b9d4-d62ba5834853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186409642} {:answer/id #uuid "d26ca855-4a28-50fd-bba1-040fec87c89e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186409647}] :answer-field/correct {:db/id #edb/ref 17592186409642} :answer-field/id #uuid "504a276b-9fed-5959-a86c-c2b987992901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409648}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "923e8280-3481-5e90-8081-225a78ef2cea" :question/math-academy-id "q-133393" :question/problem "Evaluate ${f}_{zxz}(2,\\frac{1}{2},1)$ given that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n{f}_{zz}(x,y,z)=2z\\operatorname{ln}⁡(x-2y)+x{e}^{z-2y}\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{zzx}(x,y,z) & ={f}_{zxz}(x,y,z) \\\\  & =\\frac{∂}{∂x}({f}_{zz}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(2z\\operatorname{ln}⁡(x-2y)+x{e}^{z-2y}) \\\\  & =2z\\cdot \\frac{1}{x-2y}+{e}^{z-2y} \\\\  & =\\frac{2z}{x-2y}+{e}^{z-2y}.\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point  $(2,\\frac{1}{2},1):$\n\n$$\n\\begin{aligned}{f}_{zxz}(2,\\frac{1}{2},1) & =\\frac{2\\cdot 1}{2-2\\cdot \\frac{1}{2}}+{e}^{1-2\\cdot 1/2} \\\\  & =\\frac{2}{2-1}+{e}^{1-1} \\\\  & =2+1 \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "035a465c-a1c6-5467-ae17-a4aa635d3e19"} {:db/id #edb/ref 17592186409653 :step/content {:db/id #edb/ref 17592186348445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad486eb1-3af5-599d-a9fa-a159211f22e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469206} {:answer/id #uuid "34be447a-67c4-5a73-8480-4c9e222a6cf7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469207}] :answer-field/correct {:db/id #edb/ref 17592186469206} :answer-field/id #uuid "25cbfe12-d294-5245-8577-5393288ad9f4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470215} {:answer-field/choices [{:answer/id #uuid "b396de7c-837a-5a29-89f1-49cbd1530aca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469208} {:answer/id #uuid "8cec73c4-a0c4-5d0f-b9fe-a203948ac871" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469209}] :answer-field/correct {:db/id #edb/ref 17592186469209} :answer-field/id #uuid "a8af40fc-fffa-522e-a59f-f12c36507ded" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470216} {:answer-field/choices [{:answer/id #uuid "dcdf7232-c17f-5a4f-aed3-4cd3d5ebaa84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469210} {:answer/id #uuid "45e16277-28a2-510b-88f0-c7b6217947e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469211}] :answer-field/correct {:db/id #edb/ref 17592186469211} :answer-field/id #uuid "f6521383-885b-5c99-af14-d69ae9a433ee" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470217}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0fedf8ed-0c48-5105-b489-f0efda76d273" :question/math-academy-id "q-80759" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)={e}^{-2x}-y$ and ${f}_{y}(x,y)={e}^{-y}-2x$\n- **II.** ${f}_{x}(x,y)={e}^{x}\\operatorname{cos}⁡x$ and ${f}_{y}(x,y)=5$\n- **III.** ${f}_{x}(x,y)=2{y}^{2}\\operatorname{cos}⁡xy+{y}^{2}$ and ${f}_{y}(x,y)=2\\operatorname{sin}⁡xy+2xy\\operatorname{cos}⁡xy+2xy$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{-2x}-y)=-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{-y}-2x)=-2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡x)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(5)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2{y}^{2}\\operatorname{cos}⁡xy+{y}^{2})=4y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2\\operatorname{sin}⁡xy+2xy\\operatorname{cos}⁡xy+2xy) \\\\  & =2y\\operatorname{cos}⁡xy+2y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y \\\\  & =4y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."} :step/id #uuid "55584015-c136-5819-9111-6b2b98328a75" :step/next {:db/id #edb/ref 17592186409652}} {:db/id #edb/ref 17592186409654 :step/content {:db/id #edb/ref 17592186124998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "537b62fe-d484-51a3-9b9d-3eac384ae86b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459871} {:answer/id #uuid "ebb00923-d31f-50a0-8430-a21e4ada7116" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459872}] :answer-field/correct {:db/id #edb/ref 17592186459871} :answer-field/id #uuid "ff56698d-432b-5f8c-a2f0-aff9cac4c567" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460802} {:answer-field/choices [{:answer/id #uuid "ab765baa-eeb1-592d-b1f7-a75e1fec7c72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459873} {:answer/id #uuid "49651fcd-eecc-5a62-ac69-569a5ab448f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459874}] :answer-field/correct {:db/id #edb/ref 17592186459874} :answer-field/id #uuid "d032d783-9324-58fd-b325-e0e4ffdbb557" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460803} {:answer-field/choices [{:answer/id #uuid "45153bf2-25d4-5bce-aa67-9b8cdbe22edb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459875} {:answer/id #uuid "8fe20793-5aef-5f1d-a189-e87f42839efd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459876}] :answer-field/correct {:db/id #edb/ref 17592186459876} :answer-field/id #uuid "108ed4b8-6596-5afb-b079-663c97064ef5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460804}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "574e3825-54df-5b43-b74f-6544e0543982" :question/math-academy-id "q-36518" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)=x+4y$ and ${f}_{y}(x,y)=3x-y$\n- **II.** ${f}_{x}(x,y)=2x$ and ${f}_{y}(x,y)=0$\n- **III.** ${f}_{x}(x,y)=2x+\\operatorname{cos}⁡x\\operatorname{cos}⁡y$ and ${f}_{y}(x,y)={e}^{y}-\\operatorname{sin}⁡x\\operatorname{sin}⁡y$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(x+4y)=4 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3x-y)=3.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2x)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(0)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2x+\\operatorname{cos}⁡x\\operatorname{cos}⁡y) \\\\  & =0+\\operatorname{cos}⁡x\\cdot (-\\operatorname{sin}⁡y) \\\\  & =-\\operatorname{cos}⁡x\\operatorname{sin}⁡y, \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{y}-\\operatorname{sin}⁡x\\operatorname{sin}⁡y) \\\\  & =0-\\operatorname{sin}⁡y\\cdot \\operatorname{cos}⁡x \\\\  & =-\\operatorname{cos}⁡x\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."} :step/id #uuid "87e1e468-067a-5b37-817d-ee60c3d401bf" :step/next {:db/id #edb/ref 17592186409655}} {:db/id #edb/ref 17592186409655 :step/content {:db/id #edb/ref 17592186409650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a2bcb36-868f-5f54-a6d3-5044da4b78ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186409640} {:answer/id #uuid "5c1bdf62-5e9d-55fa-82ff-dab50af9bc96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409643} {:answer/id #uuid "70500de8-c6d4-538a-a490-a042ef069ca3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186409644} {:answer/id #uuid "92afcd1e-56b0-514b-aa96-d6441ab63941" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409645} {:answer/id #uuid "b6d893f9-d5e3-5e3f-8ad1-b21394af5064" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186409646}] :answer-field/correct {:db/id #edb/ref 17592186409646} :answer-field/id #uuid "c178518b-a0fe-5bb1-9ccb-2e562d423be4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409649}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "08ef8961-263a-5251-a28f-91bd26031d10" :question/math-academy-id "q-36523" :question/problem "Consider that the function $f(x,y)$ and all of its first, second and third-order partial derivatives are continuous on an open set $U.$ What is the value of ${f}_{yxy}(1,0)-{f}_{yy}(1,0)-{f}_{xyy}(1,0)$ given that ${f}_{yy}(x,y)={x}^{3}\\operatorname{cos}⁡xy?$" :question/worked-solution "As the function and its first, second, and third-order partial derivatives are continuous on an open set $U,$ we must have ${f}_{yxy}(x,y)={f}_{xyy}(x,y).$ \n\nTherefore, we can swap the order of the subscripts in the first term. This gives\n\n$$\n\\begin{aligned}{f}_{yxy}(1,0)-{f}_{yy}(1,0)-{f}_{xyy}(1,0) & ={f}_{xyy}(1,0)-{f}_{yy}(1,0)-{f}_{xyy}(1,0) \\\\  & =\\cancel{{f}_{xyy}(1,0)}-{f}_{yy}(1,0)-\\cancel{{f}_{xyy}(1,0)} \\\\  & =-{f}_{yy}(1,0) \\\\  & =-(1)^{3}\\cdot \\operatorname{cos}⁡(1\\cdot 0) \\\\  & =-1\\cdot \\operatorname{cos}⁡0 \\\\  & =-1.\\end{aligned}\n$$"} :step/id #uuid "95f751f2-5411-50b2-8387-307a1ef77bce" :step/next {:db/id #edb/ref 17592186409656}} {:db/id #edb/ref 17592186409656 :step/content {:db/id #edb/ref 17592186394023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c18f0539-74a8-596c-852b-0d4f3da74f70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471633} {:answer/id #uuid "da87614c-db0e-5e0d-85a3-4f809e951445" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471634}] :answer-field/correct {:db/id #edb/ref 17592186471633} :answer-field/id #uuid "1f5174ed-11cb-5dac-8790-f507ecda6be1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472322} {:answer-field/choices [{:answer/id #uuid "cc7392ed-77ee-5baa-b9bc-16067d951374" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471635} {:answer/id #uuid "fc39236e-b074-5bb4-8887-3fc17013ce23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471636}] :answer-field/correct {:db/id #edb/ref 17592186471636} :answer-field/id #uuid "a26127c3-e674-5d2b-a403-9fdb7056fadf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472323} {:answer-field/choices [{:answer/id #uuid "614463b9-6217-51ba-a62e-5077088acdf9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471637} {:answer/id #uuid "beab60f2-37b0-54a2-8506-e97f08da4b29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471638}] :answer-field/correct {:db/id #edb/ref 17592186471637} :answer-field/id #uuid "f171c56b-5039-5e7e-825f-8cf0186be360" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472324}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24df999b-6ea6-5095-ada6-d510b0d36076" :question/math-academy-id "q-80652" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)=4x+{y}^{2}$ and ${f}_{y}(x,y)=4xy-y$\n- **II.** ${f}_{x}(x,y)=2x+y$ and ${f}_{y}(x,y)=x+\\sqrt{y}$\n- **III.** ${f}_{x}(x,y)=2xy+{y}^{2}$ and ${f}_{y}(x,y)={x}^{2}y+2x$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(4x+{y}^{2})=2y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(4xy-y)=4y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2x+y)=1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x+\\sqrt{y})=1.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2xy+{y}^{2})=2x+2y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({x}^{2}y+2x)=2xy+2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II only'."} :step/id #uuid "dd83cd33-8573-5ef5-a0d5-36235eb60d0a" :step/next {:db/id #edb/ref 17592186409653}}] :activity/title "Equality of Mixed Partial Derivatives" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409637}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186481716} :activity/id #uuid "3c12d8df-59d7-51f9-9588-92c3d42e2238" :activity/scope {:db/id #edb/ref 17592186049696 :topic/id #uuid "0bfad6b0-12ee-58d9-8324-1f301647b82f" :topic/math-academy-id 1957} :activity/steps [{:db/id #edb/ref 17592186481675 :step/content {:db/id #edb/ref 17592186479833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002afc6b-3ae6-5e4d-9e87-6404be2be05d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186479355} {:answer/id #uuid "a95258ee-6056-5703-bec4-79d09d5e79de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186479610} {:answer/id #uuid "d3510268-8c4c-529e-8b03-2fd8c635e27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186479679} {:answer/id #uuid "dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186479686} {:answer/id #uuid "dfc862f5-359e-590e-930c-858b88ff0363" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186479689}] :answer-field/correct {:db/id #edb/ref 17592186479686} :answer-field/id #uuid "ff4a0306-bebb-5a0b-88e8-580bcd8a3741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479825}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0c2a62d8-6d93-5394-bb23-b474c6edf899" :question/math-academy-id "q-65128" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=\\operatorname{cos}⁡x-\\operatorname{sin}⁡y$ and ${f}_{y}(x,y)=\\operatorname{cos}⁡y-\\operatorname{sin}⁡x$\n\nII. ${f}_{x}(x,y)=y{e}^{xy}$ and ${f}_{y}(x,y)=x{e}^{xy}$\n\nIII. ${f}_{x}(x,y)=2y+1$ and ${f}_{y}(x,y)=2y+1$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)=-\\operatorname{cos}⁡y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{cos}⁡y-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(y{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy) \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2y+1)=2 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2y+1)=0\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II only'."} :step/id #uuid "0330742a-33ff-5afc-89cc-0f92fa6fe78f" :step/next {:db/id #edb/ref 17592186481724}} {:db/id #edb/ref 17592186481716 :step/content {:db/id #edb/ref 17592186124999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3e26fd3-6f10-57ac-9734-b2dbccddcc7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186385358} {:answer/id #uuid "7ca4c3e9-3be8-5181-ba90-8364eb252764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186385359} {:answer/id #uuid "a1d7bc4e-c57e-5018-af71-503efedc8f32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186385360} {:answer/id #uuid "be8924f2-9c7d-5be9-8109-8089f340a29f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186385361} {:answer/id #uuid "2094e71e-1eb0-5d91-a373-c7101206e62e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186385362}] :answer-field/correct {:db/id #edb/ref 17592186385361} :answer-field/id #uuid "a6caccd5-2239-5eb0-a506-3902ad0cde8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385357}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d93fe54-16d4-572d-b03f-303a7e6e19a0" :question/math-academy-id "q-36521" :question/problem "Suppose that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}=(x{y}^{2}+2y){e}^{xy}+2{z}^{3},\\,\\frac{{∂}^{2}f}{∂x∂z}=6x{z}^{2}.\n$$\n\n \n\nEvaluate the following expression at the point $(1,0,1):$\n\n$$\n\\frac{{∂}^{3}f}{∂x∂y∂x}+\\frac{{∂}^{3}f}{∂z∂x∂z}\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nHence, we have\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂x∂y∂x} & =\\frac{{∂}^{3}f}{∂y∂{x}^{2}} \\\\  & =\\frac{∂}{∂y}(\\frac{{∂}^{2}f}{∂{x}^{2}}) \\\\  & =\\frac{∂}{∂y}((x{y}^{2}+2y){e}^{xy}+2{z}^{3}) \\\\  & =(x{y}^{2}+2y)\\cdot x{e}^{xy}+(2xy+2)\\cdot {e}^{xy}+0 \\\\  & =({x}^{2}{y}^{2}+4xy+2){e}^{xy}.\\end{aligned}\n$$\n\nIn addition, we have\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂z∂x∂z} & =\\frac{∂}{∂z}(\\frac{{∂}^{2}f}{∂x∂z}) \\\\  & =\\frac{∂}{∂z}(6x{z}^{2}) \\\\  & =12xz.\\end{aligned}\n$$\n\nNow, we evaluate both partial derivatives at the point $(1,0,1):$\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂x∂y∂x}{|}_{(1,0,1)} & =(0+0+2){e}^{0}=2 \\\\ \\frac{{∂}^{3}f}{∂z∂x∂z}{|}_{(1,0,1)} & =12(1)(1)=12\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂x∂y∂x}{|}_{(1,0,1)}+\\frac{{∂}^{3}f}{∂z∂x∂z}{|}_{(1,0,1)} & =2+12=14.\\end{aligned}\n$$"} :step/id #uuid "7f5bbb0a-88b6-5f7d-9f06-8a26f6ee53a3" :step/next {:db/id #edb/ref 17592186481675}} {:db/id #edb/ref 17592186481724 :step/content {:db/id #edb/ref 17592186479870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23f5ce90-f71e-52dc-8beb-408f7faeaa27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186479415} {:answer/id #uuid "48a543dd-5073-5eff-a396-7a9535994086" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186479465} {:answer/id #uuid "4a8aa56b-9b6e-5e43-81d5-2db6976aeebe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2+\\frac{\\pi }{2}" :db/id #edb/ref 17592186479471} {:answer/id #uuid "684701da-26b3-560c-8537-f88180932fce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+\\frac{\\pi }{2}" :db/id #edb/ref 17592186479514} {:answer/id #uuid "eeb1a895-8ba1-56dc-9e30-7108e7d80a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186479711}] :answer-field/correct {:db/id #edb/ref 17592186479415} :answer-field/id #uuid "50f2ed47-78e7-59d4-a40f-57fb0a2f9402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87b5b3e0-dcda-563d-b53d-0df7f66aab12" :question/math-academy-id "q-65129" :question/problem "Given that the function $f(x,y)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ evaluate ${f}_{yxy}(1,\\frac{\\pi }{2})$ if ${f}_{yy}(x,y)=-{x}^{2}\\operatorname{cos}⁡(xy).$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have\n\n$$\n\\begin{aligned}{f}_{yxy}(x,y) & ={f}_{yyx}(x,y) \\\\  & =\\frac{∂}{∂x}({f}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-{x}^{2}\\operatorname{cos}⁡(xy)) \\\\  & =-2x\\cdot \\operatorname{cos}⁡(xy)+(-{x}^{2})\\cdot (-y\\operatorname{sin}⁡(xy)) \\\\  & =-2x\\operatorname{cos}⁡(xy)+{x}^{2}y\\operatorname{sin}⁡(xy).\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point $(1,\\frac{\\pi }{2}):$\n\n$$\n{f}_{yxy}(1,\\frac{\\pi }{2})=-2(1)\\operatorname{cos}⁡(1\\cdot \\frac{\\pi }{2})+(1)^{2}\\cdot \\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡(1\\cdot \\frac{\\pi }{2})=\\frac{\\pi }{2}\\,\\,\n$$"} :step/id #uuid "a01dfe7c-004d-5b4b-a3ba-f0b7986950c5" :step/next {:db/id #edb/ref 17592186481744}} {:db/id #edb/ref 17592186481739 :step/content {:db/id #edb/ref 17592186409651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4421a8c6-aea6-5d62-9cd0-8a06f8915dcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186409638} {:answer/id #uuid "45730328-f0dc-5c33-a6c2-53d71d04445d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409639} {:answer/id #uuid "4d58c242-f6fd-5d67-8e96-0273fcae35a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409641} {:answer/id #uuid "59fd5070-c975-5965-b9d4-d62ba5834853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186409642} {:answer/id #uuid "d26ca855-4a28-50fd-bba1-040fec87c89e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186409647}] :answer-field/correct {:db/id #edb/ref 17592186409642} :answer-field/id #uuid "504a276b-9fed-5959-a86c-c2b987992901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409648}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "923e8280-3481-5e90-8081-225a78ef2cea" :question/math-academy-id "q-133393" :question/problem "Evaluate ${f}_{zxz}(2,\\frac{1}{2},1)$ given that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n{f}_{zz}(x,y,z)=2z\\operatorname{ln}⁡(x-2y)+x{e}^{z-2y}\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{zzx}(x,y,z) & ={f}_{zxz}(x,y,z) \\\\  & =\\frac{∂}{∂x}({f}_{zz}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(2z\\operatorname{ln}⁡(x-2y)+x{e}^{z-2y}) \\\\  & =2z\\cdot \\frac{1}{x-2y}+{e}^{z-2y} \\\\  & =\\frac{2z}{x-2y}+{e}^{z-2y}.\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point  $(2,\\frac{1}{2},1):$\n\n$$\n\\begin{aligned}{f}_{zxz}(2,\\frac{1}{2},1) & =\\frac{2\\cdot 1}{2-2\\cdot \\frac{1}{2}}+{e}^{1-2\\cdot 1/2} \\\\  & =\\frac{2}{2-1}+{e}^{1-1} \\\\  & =2+1 \\\\  & =3\\end{aligned}\n$$"} :step/id #uuid "dce668a8-ef22-5a60-bb9c-32f6ba050503"} {:db/id #edb/ref 17592186481744 :step/content {:db/id #edb/ref 17592186348445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad486eb1-3af5-599d-a9fa-a159211f22e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469206} {:answer/id #uuid "34be447a-67c4-5a73-8480-4c9e222a6cf7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469207}] :answer-field/correct {:db/id #edb/ref 17592186469206} :answer-field/id #uuid "25cbfe12-d294-5245-8577-5393288ad9f4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470215} {:answer-field/choices [{:answer/id #uuid "b396de7c-837a-5a29-89f1-49cbd1530aca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469208} {:answer/id #uuid "8cec73c4-a0c4-5d0f-b9fe-a203948ac871" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469209}] :answer-field/correct {:db/id #edb/ref 17592186469209} :answer-field/id #uuid "a8af40fc-fffa-522e-a59f-f12c36507ded" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470216} {:answer-field/choices [{:answer/id #uuid "dcdf7232-c17f-5a4f-aed3-4cd3d5ebaa84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469210} {:answer/id #uuid "45e16277-28a2-510b-88f0-c7b6217947e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469211}] :answer-field/correct {:db/id #edb/ref 17592186469211} :answer-field/id #uuid "f6521383-885b-5c99-af14-d69ae9a433ee" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470217}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0fedf8ed-0c48-5105-b489-f0efda76d273" :question/math-academy-id "q-80759" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)={e}^{-2x}-y$ and ${f}_{y}(x,y)={e}^{-y}-2x$\n- **II.** ${f}_{x}(x,y)={e}^{x}\\operatorname{cos}⁡x$ and ${f}_{y}(x,y)=5$\n- **III.** ${f}_{x}(x,y)=2{y}^{2}\\operatorname{cos}⁡xy+{y}^{2}$ and ${f}_{y}(x,y)=2\\operatorname{sin}⁡xy+2xy\\operatorname{cos}⁡xy+2xy$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{-2x}-y)=-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{-y}-2x)=-2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡x)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(5)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2{y}^{2}\\operatorname{cos}⁡xy+{y}^{2})=4y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2\\operatorname{sin}⁡xy+2xy\\operatorname{cos}⁡xy+2xy) \\\\  & =2y\\operatorname{cos}⁡xy+2y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y \\\\  & =4y\\operatorname{cos}⁡xy-2x{y}^{2}\\operatorname{sin}⁡xy+2y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."} :step/id #uuid "efa110b9-bada-584b-9f76-02913ac29d55" :step/next {:db/id #edb/ref 17592186481739}}] :activity/title "Equality of Mixed Partial Derivatives" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481568}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186489359} :activity/id #uuid "c50fc124-2e70-50d8-bf4f-018c42fcb65d" :activity/scope {:db/id #edb/ref 17592186049696 :topic/id #uuid "0bfad6b0-12ee-58d9-8324-1f301647b82f" :topic/math-academy-id 1957} :activity/steps [{:db/id #edb/ref 17592186489329 :step/content {:db/id #edb/ref 17592186268930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b6c9d7c-6f8b-549f-ade8-d1e4ebbf0134" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186266377} {:answer/id #uuid "2db15dbd-e51f-532f-9bfd-157b9f779945" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186266548} {:answer/id #uuid "3c660db5-3c31-5643-8113-78583f356468" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186266674} {:answer/id #uuid "a5eecdbb-ca77-56e2-9dcd-5a6810654073" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186267646} {:answer/id #uuid "f8a5f3a4-eed9-50d5-8e07-a411ebbe09d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186268346}] :answer-field/correct {:db/id #edb/ref 17592186266377} :answer-field/id #uuid "50bb18b4-57b1-5ebe-9423-935bc3b0a3cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268551}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9379a450-3ef7-54fa-b6cb-c35ea0f78eee" :question/math-academy-id "q-133382" :question/problem "Suppose that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n\\frac{{∂}^{2}f}{∂{y}^{2}}=\\frac{x{e}^{yz}}{x+y},\\,\\frac{{∂}^{2}f}{∂x∂z}=-\\frac{z{e}^{yz}}{x+y}.\n$$\n\n \n\nEvaluate the following expression at the point $(1,1,0):$\n\n$$\n\\frac{{∂}^{3}f}{∂y∂x∂y}+\\frac{{∂}^{3}f}{∂z∂x∂z}\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nHence, we have\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂y∂x∂y} & =\\frac{{∂}^{3}f}{∂x∂{y}^{2}} \\\\  & =\\frac{∂}{∂x}(\\frac{{∂}^{2}f}{∂{y}^{2}}) \\\\  & =\\frac{∂}{∂x}(\\frac{x{e}^{yz}}{x+y}) \\\\  & ={e}^{yz}\\cdot (\\frac{1\\cdot (x+y)-x\\cdot 1}{(x+y)^{2}}) \\\\  & =\\frac{y{e}^{yz}}{(x+y)^{2}}.\\end{aligned}\n$$\n\nIn addition, we have\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂z∂x∂z} & =\\frac{∂}{∂z}(\\frac{{∂}^{2}f}{∂x∂z}) \\\\  & =\\frac{∂}{∂z}(-\\frac{z{e}^{yz}}{x+y}) \\\\  & =-\\frac{1}{x+y}\\cdot ({e}^{yz}+yz{e}^{yz}) \\\\  & =-\\frac{{e}^{yz}(1+yz)}{x+y}.\\end{aligned}\n$$\n\nNow, we evaluate both partial derivatives at the point $(1,1,0):$\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂x∂y∂x}{|}_{(1,1,0)} & =\\frac{1\\cdot {e}^{1\\cdot 0}}{(1+1)^{2}}=\\frac{1}{4} \\\\ \\frac{{∂}^{3}f}{∂z∂x∂z}{|}_{(1,1,0)} & =-\\frac{{e}^{1\\cdot 0}(1+1\\cdot 0)}{1+1}=-\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\frac{{∂}^{3}f}{∂x∂y∂x}{|}_{(1,1,0)}+\\frac{{∂}^{3}f}{∂z∂x∂z}{|}_{(1,1,0)} & =\\frac{1}{4}-\\frac{1}{2}=-\\frac{1}{4}.\\end{aligned}\n$$"} :step/id #uuid "769313f6-43dc-5919-9553-b36396031990"} {:db/id #edb/ref 17592186489350 :step/content {:db/id #edb/ref 17592186479833 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002afc6b-3ae6-5e4d-9e87-6404be2be05d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186479355} {:answer/id #uuid "a95258ee-6056-5703-bec4-79d09d5e79de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186479610} {:answer/id #uuid "d3510268-8c4c-529e-8b03-2fd8c635e27b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186479679} {:answer/id #uuid "dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186479686} {:answer/id #uuid "dfc862f5-359e-590e-930c-858b88ff0363" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186479689}] :answer-field/correct {:db/id #edb/ref 17592186479686} :answer-field/id #uuid "ff4a0306-bebb-5a0b-88e8-580bcd8a3741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479825}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0c2a62d8-6d93-5394-bb23-b474c6edf899" :question/math-academy-id "q-65128" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=\\operatorname{cos}⁡x-\\operatorname{sin}⁡y$ and ${f}_{y}(x,y)=\\operatorname{cos}⁡y-\\operatorname{sin}⁡x$\n\nII. ${f}_{x}(x,y)=y{e}^{xy}$ and ${f}_{y}(x,y)=x{e}^{xy}$\n\nIII. ${f}_{x}(x,y)=2y+1$ and ${f}_{y}(x,y)=2y+1$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)=-\\operatorname{cos}⁡y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{cos}⁡y-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(y{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy) \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2y+1)=2 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2y+1)=0\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II only'."} :step/id #uuid "aae4262b-4042-5b50-9965-2172062f55a5" :step/next {:db/id #edb/ref 17592186489355}} {:db/id #edb/ref 17592186489355 :step/content {:db/id #edb/ref 17592186268929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f60ae37-1165-5440-bde6-f01cffce801b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186266987} {:answer/id #uuid "8e8382b2-cf1c-5bb5-b534-beacbde2bdfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267414} {:answer/id #uuid "a7b8eef4-ff75-5267-860e-a762c49305b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186267662} {:answer/id #uuid "c4658edd-5348-55cc-a2aa-5ce494911f0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267898} {:answer/id #uuid "f3239213-7c2d-5989-a3bf-a19a7229c158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186268307}] :answer-field/correct {:db/id #edb/ref 17592186267414} :answer-field/id #uuid "a30a187b-9301-5273-a095-e7add20e9085" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268696}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33686134-3f7d-5a05-9109-0d2ac79b776f" :question/math-academy-id "q-133373" :question/problem "Given that the function $f(x,y)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ evaluate ${f}_{yxy}(6,\\frac{\\pi }{3})$ if ${f}_{xy}(x,y)=7+x\\operatorname{sin}⁡y.$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have\n\n$$\n\\begin{aligned}{f}_{yxy}(x,y) & ={f}_{xyy}(x,y) \\\\  & =\\frac{∂}{∂y}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂y}(7+x\\operatorname{sin}⁡y) \\\\  & =x\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point $(6,\\frac{\\pi }{3}):$\n\n$$\n{f}_{yxy}(6,\\frac{\\pi }{3})=6\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{3})=3\n$$"} :step/id #uuid "b1968108-fe35-55fa-b259-cedf76219668" :step/next {:db/id #edb/ref 17592186489329}} {:db/id #edb/ref 17592186489359 :step/content {:db/id #edb/ref 17592186489263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b45857f-4c74-59d9-8e35-85de5f5c9034" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186488645} {:answer/id #uuid "7d0ab324-a63f-56ba-b911-46caeedd3017" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186488721} {:answer/id #uuid "88ad4c18-6273-5c23-9f0f-fff73fe14cc9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186488740} {:answer/id #uuid "a2acdb8d-7243-568f-a9db-fdae13525746" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186488792} {:answer/id #uuid "aed29a6c-7da5-5f41-b70d-1d66d427908e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186488818}] :answer-field/correct {:db/id #edb/ref 17592186488740} :answer-field/id #uuid "df0c4030-39f2-5bc9-a0e8-ac2b199792a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186489148}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c68f1c1a-c6a6-5448-b77c-02d88ae0390d" :question/math-academy-id "q-36482" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=y{x}^{2}-4y$ and ${f}_{y}(x,y)=\\frac{{x}^{3}}{3}-4x$\n\nII. ${f}_{x}(x,y)=3-5x$ and ${f}_{y}(x,y)=1$\n\nIII. ${f}_{x}(x,y)=3{x}^{2}+\\operatorname{sin}⁡x\\operatorname{sin}⁡y$ and ${f}_{y}(x,y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-2{y}^{3}{e}^{{y}^{2}}$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(y{x}^{2}-4y)={x}^{2}-4 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{3}-4x)={x}^{2}-4.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(3-5x)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(1)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(3{x}^{2}+\\operatorname{sin}⁡x\\operatorname{sin}⁡y) \\\\  & =0+\\operatorname{sin}⁡x\\cdot \\operatorname{cos}⁡y \\\\  & =\\operatorname{sin}⁡x\\operatorname{cos}⁡y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-2{y}^{3}{e}^{{y}^{2}}) \\\\  & =(-\\operatorname{sin}⁡x)\\cdot \\operatorname{cos}⁡y-0 \\\\  & =-\\operatorname{sin}⁡x\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'I and II only'."} :step/id #uuid "be2117cb-2320-5d47-9072-a89c15136337" :step/next {:db/id #edb/ref 17592186489384}} {:db/id #edb/ref 17592186489384 :step/content {:db/id #edb/ref 17592186125186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6926f5e-dc21-5da5-b35d-b718df8a66ad" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477365} {:answer/id #uuid "f0f6a95f-1511-52d2-946b-1d648665d214" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477366}] :answer-field/correct {:db/id #edb/ref 17592186477365} :answer-field/id #uuid "c6da62ee-a826-5879-91f1-9c7966d71193" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477652} {:answer-field/choices [{:answer/id #uuid "f4cb90f6-70fc-53f0-9088-772c160341cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477367} {:answer/id #uuid "26573f3b-930d-57c0-9106-c38022948389" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477368}] :answer-field/correct {:db/id #edb/ref 17592186477368} :answer-field/id #uuid "23b11426-2cab-5199-bc57-42df399c747e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477653} {:answer-field/choices [{:answer/id #uuid "9478de04-8fb1-57f2-973d-3770f1978c1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477369} {:answer/id #uuid "a7bf79dc-14ad-5ba5-85de-39e95f01562c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477370}] :answer-field/correct {:db/id #edb/ref 17592186477370} :answer-field/id #uuid "766dd905-2ba1-5ac0-b3f1-1f815b83a4fe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477654}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3caf1655-4ce4-5a5f-995b-a06e33069b3a" :question/math-academy-id "q-65127" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)={x}^{3}y-x$ and ${f}_{y}(x,y)=x{y}^{3}-y$\n- **II.** ${f}_{x}(x,y)={e}^{x+y}-2y$ and ${f}_{y}(x,y)={e}^{x+y}-2x$\n- **III.** ${f}_{x}(x,y)=\\sqrt{x-1}$ and ${f}_{y}(x,y)=-3$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({x}^{3}y-x)={x}^{3} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x{y}^{3}-y)={y}^{3}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x+y}-2y)={e}^{x+y}-2 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{x+y}-2x)={e}^{x+y}-2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{x-1})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-3)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."} :step/id #uuid "fdc1b998-1ffd-53d7-9edb-119354e86ad0" :step/next {:db/id #edb/ref 17592186489350}}] :activity/title "Equality of Mixed Partial Derivatives" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186488462}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186125348} :activity/id #uuid "f4bd8552-cbfe-5cdf-9c63-a1215aabe6f0" :activity/scope {:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907} :activity/steps [{:db/id #edb/ref 17592186125348 :step/content {:db/id #edb/ref 17592186125762 :tutorial/content "Given a vector space $V$, any subset $H$ of $V,$ which is itself a vector space, is called a **subspace** of $V$. \n\nFortunately, we do not need to check all vector space axioms to determine whether a subset of some vector space is a subspace. Instead, we only need to check the **subspace criterion**, which states the following:\n\n*A subset $H$ of a vector space $V$ is a subspace of $V$ if and only if $H$ is closed under vector addition and scalar multiplication. That is to say, both of the following conditions hold:*\n\n- *If $\\mathbf{u}$ and $\\mathbf{v}$ lie in $H$, then their sum $\\mathbf{u}+\\mathbf{v}$ also lies in $H$. Formally,*\n\n$$\n\\mathbf{u},\\mathbf{v} \\in H \\quad\\Rightarrow\\quad  \\mathbf{u}+\\mathbf{v} \\in H.\n$$\n\n- *If $\\mathbf{u}$ lies in $H$, then $k \\cdot \\mathbf{u}$ also lies in $H$ for any scalar  $k$. Formally,* \n\n$$\nk \\in \\mathbb{R}, \\,\\mathbf{u} \\in H \\quad\\Rightarrow\\quad  k\\cdot\\mathbf{u} \\in H.\n$$\n\nFor example, consider the vector space $\\mathbb{R}_3[t]$ containing all polynomials of degree at most $3,$ along with the subset \n\n$$\nA = \\{ at^2 \\:|\\: a \\in \\mathbb{R} \\}.\n$$\n\nIs $A$ a subspace? Let's check the two subspace criterion conditions: \n\n- Suppose $p_1(t)=a_1 t^2$ and $p_2(t)=a_2 t^2$ are two polynomials from $A$. Summing the two polynomials, we get\n\n$$\n\\begin{aligned}{p}_{1}(t)+{p}_{2}(t) & =({a}_{1}{t}^{2})+({a}_{2}{t}^{2}) \\\\  & ={{({a}_{1}+{a}_{2})}_{⏟}}_{a\\in R}{t}^{2}.\\end{aligned}\n$$\n\n \nThus, $p_1(t)+p_2(t)$ is a polynomial of the form $at^2,$ which belongs to $A$.\n\n- If $p_1(t)=a_1 t^2 \\in A$ and $k \\in \\mathbb{R},$ then \n\n$$\n\\begin{aligned}k{p}_{1}(t) & =k({a}_{1}{t}^{2}) \\\\  & ={{(k{a}_{1})}_{⏟}}_{a\\in R}{t}^{2}.\\end{aligned}\n$$\n\n \nThus, $kp_1(t)$ is a polynomial of the form $at^2,$ which belongs to $A$.\n\nSince both conditions hold, we conclude that $A$ is a subspace $\\mathbb{R}_3[t].$" :tutorial/id #uuid "4274a05d-d402-5dfc-a339-e5a6b5a8e5b0" :tutorial/math-academy-id 3205 :tutorial/title "Introduction"} :step/id #uuid "c9024def-0495-5d67-911a-9b23824e8187" :step/math-academy-id 653353 :step/next {:db/id #edb/ref 17592186125595}} {:db/id #edb/ref 17592186125349 :step/content {:db/id #edb/ref 17592186124488 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124301 :question/id #uuid "69da2e7c-7ede-5966-8ff9-13bca51c0420" :question/math-academy-id "e-4813"} :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048176}] :knowledge-point/questions [{:db/id #edb/ref 17592186125156} {:db/id #edb/ref 17592186125157} {:db/id #edb/ref 17592186244032} {:db/id #edb/ref 17592186244034} {:db/id #edb/ref 17592186244035} {:db/id #edb/ref 17592186329727} {:db/id #edb/ref 17592186329728} {:db/id #edb/ref 17592186357738} {:db/id #edb/ref 17592186360465} {:db/id #edb/ref 17592186360466} {:db/id #edb/ref 17592186360467} {:db/id #edb/ref 17592186360468} {:db/id #edb/ref 17592186378355} {:db/id #edb/ref 17592186378362} {:db/id #edb/ref 17592186446399} {:db/id #edb/ref 17592186446401} {:db/id #edb/ref 17592186493915}] :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"} :step/id #uuid "e3832943-8321-5094-b97b-66a6951219cb" :step/math-academy-id 653361} {:db/id #edb/ref 17592186125524 :step/content {:db/id #edb/ref 17592186124590 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124401 :question/id #uuid "7fed39de-7304-52a0-a94d-e55703175d7d" :question/math-academy-id "e-8233"} :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/questions [{:db/id #edb/ref 17592186125154} {:db/id #edb/ref 17592186125155} {:db/id #edb/ref 17592186244021} {:db/id #edb/ref 17592186244022} {:db/id #edb/ref 17592186244023} {:db/id #edb/ref 17592186244025} {:db/id #edb/ref 17592186329724} {:db/id #edb/ref 17592186329725} {:db/id #edb/ref 17592186360461} {:db/id #edb/ref 17592186360462} {:db/id #edb/ref 17592186360463} {:db/id #edb/ref 17592186360464} {:db/id #edb/ref 17592186378348} {:db/id #edb/ref 17592186380284} {:db/id #edb/ref 17592186380291}] :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"} :step/id #uuid "78c3b58c-ad85-58e8-8baf-c63bf9e544b1" :step/math-academy-id 653358 :step/next {:db/id #edb/ref 17592186125349}} {:db/id #edb/ref 17592186125525 :step/content {:db/id #edb/ref 17592186124591 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124402 :question/id #uuid "05151ae0-102c-5ce8-8bc6-082e22aa77d0" :question/math-academy-id "e-8234"} :knowledge-point/id #uuid "9b1bb974-826a-590f-8d32-cdc868ca827c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049064} {:db/id #edb/ref 17592186051046}] :knowledge-point/questions [{:db/id #edb/ref 17592186125152} {:db/id #edb/ref 17592186125153} {:db/id #edb/ref 17592186244019} {:db/id #edb/ref 17592186329726} {:db/id #edb/ref 17592186360459} {:db/id #edb/ref 17592186360460} {:db/id #edb/ref 17592186446400} {:db/id #edb/ref 17592186481385} {:db/id #edb/ref 17592186496300}] :knowledge-point/title "Identifying Subspaces of Polynomial Vector Spaces"} :step/id #uuid "f647c92d-413b-597e-a1c7-89a867776426" :step/math-academy-id 653355 :step/next {:db/id #edb/ref 17592186125524}} {:db/id #edb/ref 17592186125595 :step/content {:db/id #edb/ref 17592186125858 :tutorial/content "Let's now look at an example of a subset of a vector space that is not a subspace.\n\nConsider the vector space $\\mathbb R_2[t]$ of all polynomials in the variable $t$ of degree at most $2,$ and its subset \n\n$$\nB = \\big\\{ at+b \\: | \\: a,b  \\in\\mathbb{Z} \\big\\}.\n$$\n\nRecall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\n- $B$ is closed under polynomial addition. Indeed, suppose that $f(t)=a_1t+b_1$ and $g(t)=a_2t+b_2$ are two polynomials from $B.$ Then,\n\n$$\n\\begin{aligned}f(t)+g(t) & =({a}_{1}t+{b}_{1})+({a}_{2}t+{b}_{2}) \\\\  & =({a}_{1}+{a}_{2})t+({b}_{1}+{b}_{2}),\\end{aligned}\n$$\n\nwhich is a polynomial from $B$ since $a_1+a_2$ and $b_1+b_2$ are in $\\Bbb Z.$\n\n- $B$ is *not* closed under scalar multiplication. As a counterexample, consider $f(t)=t$ and $k=0.5,$ then \n\n$$\n\\begin{aligned}kf(t) & =0.5t,\\end{aligned}\n$$\n\nwhich is *not* a polynomial from $B,$ because $0.5 \\notin \\Bbb Z.$\n\nTherefore, $B$ is not a subspace of $\\mathbb R_2[t].$" :tutorial/id #uuid "532d5411-c233-58a0-88e3-bd13bc8fcd1e" :tutorial/math-academy-id 6193 :tutorial/title "Example of a Subset That Is Not a Subspace"} :step/id #uuid "fa129907-91b4-5bfa-8c65-22954ea25d25" :step/math-academy-id 653354 :step/next {:db/id #edb/ref 17592186125525}}] :activity/title "Subspaces of Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124707}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186481698} :activity/id #uuid "2d5bd931-ddfc-5c73-a933-79079c0774b8" :activity/scope {:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907} :activity/steps [{:db/id #edb/ref 17592186481698 :step/content {:db/id #edb/ref 17592186329724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38cb7c6e-48d5-5719-9bc4-f341096b9869" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186450666} {:answer/id #uuid "acf32b73-2582-59f7-b014-ea9ea8e2b727" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186450667}] :answer-field/correct {:db/id #edb/ref 17592186450667} :answer-field/id #uuid "deb7b878-00d8-573f-9c0a-f510c2c287a1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186451287} {:answer-field/choices [{:answer/id #uuid "9e105135-fd28-5ebd-a7a8-7fa54306d756" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186450668} {:answer/id #uuid "45355d1b-48c6-519a-96e3-bbc8d43f590d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186450669}] :answer-field/correct {:db/id #edb/ref 17592186450669} :answer-field/id #uuid "ea3082d2-a25f-5513-8dfb-ccff48a59f9f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186451288} {:answer-field/choices [{:answer/id #uuid "a8d51c46-ebc6-5ee6-8799-43361686c56d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186450670} {:answer/id #uuid "dbd955e0-f434-5f0d-9f8e-17ed74539b21" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186450671}] :answer-field/correct {:db/id #edb/ref 17592186450671} :answer-field/id #uuid "e2280d44-e6e2-5192-96b3-c76661eb0a1c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186451289} {:answer-field/choices [{:answer/id #uuid "8a3c8024-a57d-59ab-916d-48c342bfd6e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186450672} {:answer/id #uuid "594cdb2e-1903-5d5b-a568-00aa3983c13d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186450673}] :answer-field/correct {:db/id #edb/ref 17592186450672} :answer-field/id #uuid "2a204198-fcd4-5ddf-9145-17e9ce86b916" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186451290}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "32e0dd88-b99c-539d-9214-7424ba73f602" :question/math-academy-id "q-43775" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $E$ containing all $2\\times 2$ matrices of the form $\\alpha A$ where $A$ is some fixed $2\\times 2$ matrix and $\\alpha \\in R.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under matrix addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $E$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}={\\alpha }_{1}A$ and ${A}_{2}={\\alpha }_{2}A$ are two matrices from $E,$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & ={\\alpha }_{1}A+{\\alpha }_{2}A=({\\alpha }_{1}+{\\alpha }_{2})A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under addition.\n\n- Statement II is true. If $B=\\alpha A$ is an element of $E$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kB & =k\\alpha A=(k\\alpha )A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "50493f64-ffe9-5fa7-9d7b-f97ed6fe8636" :step/next {:db/id #edb/ref 17592186481717}} {:db/id #edb/ref 17592186481708 :step/content {:db/id #edb/ref 17592186378362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9c8b6f7-a765-51f0-bdc1-0e20609fa1e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453226} {:answer/id #uuid "75058ef8-65b5-5339-9bcb-1c1175a9c585" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453227}] :answer-field/correct {:db/id #edb/ref 17592186453226} :answer-field/id #uuid "603a8296-6812-5aa0-acca-2e58013b4290" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454363} {:answer-field/choices [{:answer/id #uuid "aea5044e-ffdb-5981-9a0d-1e77af7bb0ea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453228} {:answer/id #uuid "5e12f28f-5d7e-5ae4-9e88-d666b37d25f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453229}] :answer-field/correct {:db/id #edb/ref 17592186453228} :answer-field/id #uuid "2086fc9f-b317-5fdc-9df7-fec846619a6b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454364} {:answer-field/choices [{:answer/id #uuid "73efe5e7-86d9-56bf-883f-fdf28547d599" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453230} {:answer/id #uuid "a85494a0-51a8-59e6-96b9-be4532a22c50" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453231}] :answer-field/correct {:db/id #edb/ref 17592186453230} :answer-field/id #uuid "a819ffc8-0ac7-5428-aa18-b902a7881f2c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454365} {:answer-field/choices [{:answer/id #uuid "94acce7b-7200-5224-a551-0f52dea34c37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453232} {:answer/id #uuid "5cef8fe4-d2dc-5067-8776-abd7c9ca57d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453233}] :answer-field/correct {:db/id #edb/ref 17592186453233} :answer-field/id #uuid "88425d2a-b4ad-54eb-89a3-3a3b986d9505" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454366}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ecd1a414-f091-5cfd-86f0-d0c82f6d9564" :question/math-academy-id "q-107147" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $K$ containing all nonconstant functions.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $K$ is closed under function addition\n- **II.** $K$ is closed under scalar multiplication\n- **III.** $K$ is a subspace of $C[0,1]$\n- **IV.** $K$ is **not** a subspace of $C[0,1]$\n\n*Hint: $f$ is a constant function if $f(x)=\\text{constant}$ for all $x\\in [0,1].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, the functions $f(x)=x+2$ and $f(x)=-x-1$ are in $K$, however\n\n$$\n(f+g)(x)=1\n$$\n\nfor all $x\\in [0,1]$ and hence $f+g$ is a constant function. \nSo, $K$ is *not* closed under addition.\n\n- Statement II is false. For example, the product of the scalar zero by any function is the constant function zero. So, $K$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $K$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""} :step/id #uuid "67adba61-524d-57c0-85ec-fefe501262e8"} {:db/id #edb/ref 17592186481710 :step/content {:db/id #edb/ref 17592186360467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb2d723d-c8b0-5e00-b156-69d0e470f0ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452001} {:answer/id #uuid "5b1f3a41-57bb-56b5-b700-a05f59bcdb05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452002}] :answer-field/correct {:db/id #edb/ref 17592186452001} :answer-field/id #uuid "eaed178b-0ca9-53db-93f2-6c3fe7166a1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452848} {:answer-field/choices [{:answer/id #uuid "02d54602-5430-531a-a7c5-47d26991c196" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452003} {:answer/id #uuid "99d476b2-00d2-510e-ab51-4d3a23898225" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452004}] :answer-field/correct {:db/id #edb/ref 17592186452003} :answer-field/id #uuid "aeee6e44-1273-539a-b514-732ed6cf2323" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452849} {:answer-field/choices [{:answer/id #uuid "63d370e5-07ba-54c6-84b2-d2152f843127" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452005} {:answer/id #uuid "3b739ff6-ecb6-5572-a58c-6817071a785d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452006}] :answer-field/correct {:db/id #edb/ref 17592186452005} :answer-field/id #uuid "dd8599eb-5b6c-5f72-9e7f-4c37a37b62cd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452850} {:answer-field/choices [{:answer/id #uuid "aca4493b-8547-5286-83fb-deaf509091f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452007} {:answer/id #uuid "a167ab0d-34f6-5000-8bef-7f7a8ae3ed10" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452008}] :answer-field/correct {:db/id #edb/ref 17592186452008} :answer-field/id #uuid "1aa85b89-bf70-5661-b433-3d5ffe0aa95a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452851}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0f62d508-5cf6-5993-b139-949d11db546e" :question/math-academy-id "q-94635" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $C$ containing all polynomials of degree exactly $3.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $C$ is closed under function addition\n- **II.** $C$ is closed under scalar multiplication\n- **III.** $C$ is a subspace of $C[0,1]$\n- **IV.** $C$ is **not** a subspace of $C[0,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(x)={x}^{3}$ and $g(x)=1-{x}^{3},$ then\n\n$$\n\\begin{aligned}f(x)+g(x) & ={x}^{3}+(1-{x}^{3}) \\\\  & =({x}^{3}-{x}^{3})+1 \\\\  & =1.\\end{aligned}\n$$\n\nSo, $C$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(x)={x}^{3}$ and $k=0,$ then\n\n$$\nkf(x)=0\\cdot {x}^{3}=0.\n$$\n\n \nSo, $C$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $C$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""} :step/id #uuid "72385174-3ed7-5267-8531-11fa251308c2" :step/next {:db/id #edb/ref 17592186481708}} {:db/id #edb/ref 17592186481717 :step/content {:db/id #edb/ref 17592186481385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c159e3-322b-5045-961d-a4bb6de6bf28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186480754} {:answer/id #uuid "0be6e3fd-a982-5d87-84bd-f85e41333d20" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III only" :db/id #edb/ref 17592186480763} {:answer/id #uuid "62c9945e-be6a-5851-bfe4-b314ac1b71d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186480920} {:answer/id #uuid "7f0c6a78-5937-5a8c-b3a3-be973c02f31d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186480978} {:answer/id #uuid "a6d54a74-6c6a-5da4-9499-7d05f911b9ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "IV only" :db/id #edb/ref 17592186481053}] :answer-field/correct {:db/id #edb/ref 17592186481053} :answer-field/id #uuid "a24ecf47-9c4a-5174-a968-bb79cd6b4d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481295}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75f0d82a-dd66-5d66-8858-8e85c7e74ab7" :question/math-academy-id "q-94610" :question/problem "Consider the vector space ${R}_{3}[t]$ of all polynomials in the variable $t$ of degree at most $3,$ and its subset $B=\\{a{t}^{3}+bt+1\\,|\\,a,b\\in R\\}.$\n\nWhich of the following statements are true?\n\nI. $B$ is closed under polynomial addition\n\nII. $B$ is closed under scalar multiplication\n\nIII. $B$ is a subspace of ${R}_{3}[t]$\n\nIV. $B$ is **not** a subspace of ${R}_{3}[t]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(t)=g(t)=t+1,$ then\n\n$$\n\\begin{aligned}f(t)+g(t) & =(t+1)+(t+1) \\\\  & =2t+2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(t)=t+1$ and $k=2,$ then \n\n$$\n\\begin{aligned}kf(t) & =2(t+1)=2t+2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""} :step/id #uuid "81941ef7-5939-5d4c-84c0-696db12e35ad" :step/next {:db/id #edb/ref 17592186481747}} {:db/id #edb/ref 17592186481747 :step/content {:db/id #edb/ref 17592186360462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "795fc022-fb5b-5f27-a5d8-aa4c2ad9dca7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451961} {:answer/id #uuid "566a3a56-16f1-5b90-bea1-2f3ee57bb51e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451962}] :answer-field/correct {:db/id #edb/ref 17592186451961} :answer-field/id #uuid "b0f4fd63-51fe-513d-929c-04e865c20a46" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452828} {:answer-field/choices [{:answer/id #uuid "39e01aaf-2818-586e-bb60-43cf7bd3de14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451963} {:answer/id #uuid "e083d6c2-56a6-577a-92e4-6ba01e342ee7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451964}] :answer-field/correct {:db/id #edb/ref 17592186451963} :answer-field/id #uuid "5913234f-6a30-58d7-aabd-166bad7da71b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452829} {:answer-field/choices [{:answer/id #uuid "82e2ad3e-07c9-5fb2-9b3d-fe00002b1fb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451965} {:answer/id #uuid "40263c7a-0627-5200-bf3d-c2777958353f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451966}] :answer-field/correct {:db/id #edb/ref 17592186451965} :answer-field/id #uuid "963e43d6-331a-56e1-be82-da9c3690ac1f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452830} {:answer-field/choices [{:answer/id #uuid "18189e21-c99c-5d19-a3a8-4e8060b0797b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451967} {:answer/id #uuid "e6eb60f2-98a4-5b24-a94e-92f9324e2a78" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451968}] :answer-field/correct {:db/id #edb/ref 17592186451968} :answer-field/id #uuid "3bfdc7e3-3ad3-5cba-9513-6068b167a525" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452831}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "32515201-cdee-5802-875e-aaeaf04119b1" :question/math-academy-id "q-94625" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $B={\\begin{bmatrix}0 & a \\\\ 1-a & 0\\end{bmatrix}\\,|\\,a\\in R}.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is closed under matrix addition\n- **II.** $B$ is closed under scalar multiplication\n- **III.** $B$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $B$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if ${A}_{1}={A}_{2}=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 0 & 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $A=\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix}$ and $k=2,$ then \n\n$$\n\\begin{aligned}kA & =2\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 0 & 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is a *not* subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""} :step/id #uuid "f553b660-9aa6-5b79-a74c-70bbaa7d5027" :step/next {:db/id #edb/ref 17592186481710}}] :activity/title "Subspaces of Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481565}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186494030} :activity/id #uuid "bba4c4cc-2793-5afd-91e2-7a137ae53cb5" :activity/scope {:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907} :activity/steps [{:db/id #edb/ref 17592186494008 :step/content {:db/id #edb/ref 17592186493915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ce7efb-3ad5-579b-809f-0dd2e31fe7e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "IV only" :db/id #edb/ref 17592186493451} {:answer/id #uuid "87f00bc1-a093-5b90-a9c9-83e2777d88d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III only" :db/id #edb/ref 17592186493604} {:answer/id #uuid "aca0bca7-0e7a-58b7-a3c4-843dab2110e5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186493662} {:answer/id #uuid "be1fae9a-76f7-5ae7-af20-eb786be794c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186493703} {:answer/id #uuid "f14395c6-36b4-5cb6-8085-7a9935a781a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186493780}] :answer-field/correct {:db/id #edb/ref 17592186493451} :answer-field/id #uuid "28ce3e2a-2275-50a0-b25b-b9f3436f743c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493812}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3ec301c4-26d6-5f2a-9132-b21928f5ee67" :question/math-academy-id "q-94638" :question/problem "Consider the vector space $C[0,3]$ of all continuous functions $f:[0,3]\\to R$ and its subset $N$ containing all functions that return a nonzero value at exactly one point in $[0,3].$\n\nWhich of the following statements are true?\n\nI. $N$ is closed under function addition\n\nII. $N$ is closed under scalar multiplication\n\nIII. $N$ is a subspace of $C[0,3]$\n\nIV. $N$ is **not** a subspace of $C[0,3]$\n\n*Hint: Different functions from $N$ might give a nonzero value at different points in $[0,3].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f({a}_{1})\\ne 0$ and $g({a}_{2})\\ne 0,$ where ${a}_{1},{a}_{2}$ are distinct points in $[0,3],$ then\n\n$$\n\\begin{aligned}f({a}_{1})+g({a}_{1}) & \\ne 0 \\\\ f({a}_{2})+g({a}_{2}) & \\ne 0.\\end{aligned}\n$$\n\nTherefore, $f(x)+g(x)\\ne 0$ at two distinct points. So, $N$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(a)\\ne 0$ for some $a\\in [0,3],$ and $k=0,$ then\n\n$$\nkf(x)=0\n$$\n\n \nfor any $x\\in [0,3].$ So, $N$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $N$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""} :step/id #uuid "61b43f65-40c4-5ee2-a729-b625837e3d66" :step/next {:db/id #edb/ref 17592186494067}} {:db/id #edb/ref 17592186494029 :step/content {:db/id #edb/ref 17592186329727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b3a3727-45a2-5fb4-95ae-a91e8f4f3239" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451353} {:answer/id #uuid "560e913c-ce8a-5991-9d57-1efe0344f54f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451354}] :answer-field/correct {:db/id #edb/ref 17592186451354} :answer-field/id #uuid "7994875a-855a-584f-b0b1-e9adddf96e49" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452524} {:answer-field/choices [{:answer/id #uuid "f71e555b-f6a2-5bfa-a969-f07e226574ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451355} {:answer/id #uuid "cfe4cba6-6e86-5be1-8135-57a663228532" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451356}] :answer-field/correct {:db/id #edb/ref 17592186451356} :answer-field/id #uuid "ae639aa0-32cb-59c4-89fa-57a75c8e85c1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452525} {:answer-field/choices [{:answer/id #uuid "d934afb8-4872-512d-b557-15198d1a48a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451357} {:answer/id #uuid "a5f2982f-15e7-58c5-94f1-438da460594b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451358}] :answer-field/correct {:db/id #edb/ref 17592186451358} :answer-field/id #uuid "d5a8d921-2a8a-515d-b4dc-86f366326881" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452526} {:answer-field/choices [{:answer/id #uuid "bc6f1bb2-59b1-5487-b01f-c8947e4f8b79" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186451359} {:answer/id #uuid "ee66f17e-227c-5e22-9f23-dbee97ac1f55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186451360}] :answer-field/correct {:db/id #edb/ref 17592186451359} :answer-field/id #uuid "f9876e54-bdbd-59af-a25c-ae629c2446e5" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452527}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ed6c488-d6f4-5c35-b1ec-2f3c2d68e465" :question/math-academy-id "q-43779" :question/problem "Consider the vector space $C[-1,1]$ of all continuous functions $f:[-1,1]\\to R$ and its subset $B={f\\in C[-1,1]\\,|\\,f(1)=f(-1)}.$ \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is closed under function addition\n- **II.** $B$ is closed under scalar multiplication\n- **III.** $B$ is a subspace of $C[-1,1]$\n- **IV.** $B$ is **not** a subspace of $C[-1,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in B,$ then\n\n$$\n\\begin{aligned}(f+g)(1) & =f(1)+g(1) \\\\  & =f(-1)+g(-1) \\\\  & =(f+g)(-1).\\end{aligned}\n$$\n\nSo, $B$ is closed under addition.\n\n- Statement II is true. If $f(x)\\in B$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}(kf)(1) & =kf(1) \\\\  & =kf(-1) \\\\  & =(kf)(-1).\\end{aligned}\n$$\n\nSo, $B$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $B$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "876842ab-2531-5a55-8715-683cc46f3d77" :step/next {:db/id #edb/ref 17592186494008}} {:db/id #edb/ref 17592186494030 :step/content {:db/id #edb/ref 17592186125154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8536f8a6-1bfc-5275-95ca-8a1fda0afe28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186123525} {:answer/id #uuid "b659c777-4549-54ab-9f1f-bae85db6256b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186123526} {:answer/id #uuid "5da722ba-7c66-52bf-862c-fc5ad59257b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "IV only" :db/id #edb/ref 17592186123527} {:answer/id #uuid "64f059cc-f403-5120-b592-b5803d968b43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III only" :db/id #edb/ref 17592186123528} {:answer/id #uuid "79c277c4-a05b-5a16-ab06-0142128ff522" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186123529}] :answer-field/correct {:db/id #edb/ref 17592186123528} :answer-field/id #uuid "856e0bc2-ed8c-5746-a814-6831d1a835e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123524}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "027d54ca-a5e1-5f8e-b0e8-aea8a3580062" :question/math-academy-id "q-43770" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $C=\\{\\begin{bmatrix}a & 0 \\\\ 0 & 0\\end{bmatrix}\\,|\\,a\\in R\\}.$\n\nWhich of the following statements are true?\n\nI. $C$ is closed under matrix addition\n\nII. $C$ is closed under scalar multiplication\n\nIII. $C$ is a subspace of ${\\text{M}}_{2}(R)$\n\nIV. $C$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}=\\begin{bmatrix}{a}_{1} & 0 \\\\ 0 & 0\\end{bmatrix}$ and ${A}_{2}=\\begin{bmatrix}{a}_{2} & 0 \\\\ 0 & 0\\end{bmatrix}$ are two matrices from $C,$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =\\begin{bmatrix}{a}_{1} & 0 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}{a}_{2} & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}{a}_{1}+{a}_{2} & 0 \\\\ 0 & 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhich is a matrix from $C.$ So, $C$ is closed under addition.\n\n- Statement II is true. If $A=\\begin{bmatrix}a & 0 \\\\ 0 & 0\\end{bmatrix}$ is an element of $C$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kA & =k\\begin{bmatrix}a & 0 \\\\ 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}ka & 0 \\\\ 0 & 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhich is a matrix from $C.$ So, $C$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $C$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "87d932f6-49ba-5c24-8d19-a6ad3580ecf9" :step/next {:db/id #edb/ref 17592186494029}} {:db/id #edb/ref 17592186494067 :step/content {:db/id #edb/ref 17592186360468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991f2f73-ac23-5191-ab80-7de9efee7e9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452009} {:answer/id #uuid "2ead1013-7e82-50d2-9ea0-c2b7d5a04066" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452010}] :answer-field/correct {:db/id #edb/ref 17592186452010} :answer-field/id #uuid "506cf49e-9f52-5299-8ed3-6ff8e24478db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452852} {:answer-field/choices [{:answer/id #uuid "fed6d2ec-aee8-5542-8372-ae559f20b93f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452011} {:answer/id #uuid "c05c0c3e-d50a-5489-b880-65368c86a869" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452012}] :answer-field/correct {:db/id #edb/ref 17592186452012} :answer-field/id #uuid "5b6ad786-f4e4-5537-b235-5beb1d76d0c8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452853} {:answer-field/choices [{:answer/id #uuid "1e1613e4-3825-5163-955a-c508dc5a7424" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452013} {:answer/id #uuid "f5a4d7ea-1e52-5939-b1ad-c82fa09897e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452014}] :answer-field/correct {:db/id #edb/ref 17592186452014} :answer-field/id #uuid "860bab32-e063-5c7b-9daf-21735a207ce5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452854} {:answer-field/choices [{:answer/id #uuid "902ecaea-e103-52f1-8446-e92ffd5c7e4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186452015} {:answer/id #uuid "b5359c31-2887-5291-8d2f-9c2c74acea93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186452016}] :answer-field/correct {:db/id #edb/ref 17592186452015} :answer-field/id #uuid "063b6651-61e1-5617-8f54-44670f58aa5b" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186452855}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44096d11-ac2c-5302-8668-0431e5543e9f" :question/math-academy-id "q-94642" :question/problem "Consider the vector space $C[-2,2]$ of all continuous functions $f:[-2,2]\\to R$ and its subset $E$ containing all even functions.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under function addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of $C[-2,2]$\n- **IV.** $E$ is **not** a subspace of $C[-2,2]$\n\n*Hint: $f$ is even if $f(-x)=f(x)$ for all $x\\in [-2,2].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in E,$ then\n\n$$\n\\begin{aligned}(f+g)(-x) & =f(-x)+g(-x) \\\\  & =f(x)+g(x) \\\\  & =(f+g)(x)\\end{aligned}\n$$\n\nSo, $E$ is closed under addition.\n\n- Statement II is true. If $f(x)\\in E$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}(kf)(-x) & =kf(-x) \\\\  & =kf(x) \\\\  & =(kf)(x)\\end{aligned}\n$$\n\nSo, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "ef5989bf-617a-54c7-bbc7-9e531c1f1c5b"}] :activity/title "Subspaces of Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493386}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186496372} :activity/id #uuid "791577cc-8390-5b1f-8943-709d12535de5" :activity/scope {:db/id #edb/ref 17592186050453 :topic/id #uuid "4a436386-bf41-55c7-b1d3-02adad8f3faf" :topic/math-academy-id 1907} :activity/steps [{:db/id #edb/ref 17592186496337 :step/content {:db/id #edb/ref 17592186244022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af81d6e6-3cad-5c8a-99a9-13bc107158af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447854} {:answer/id #uuid "4921fc50-ffd5-5037-85e5-4437f4da71a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447855}] :answer-field/correct {:db/id #edb/ref 17592186447855} :answer-field/id #uuid "31478e71-bb60-536e-8adc-4001942eec0d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448967} {:answer-field/choices [{:answer/id #uuid "7871ce40-048e-5347-b7c4-782324459d1f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447856} {:answer/id #uuid "54e54e39-08f5-53d6-b847-857578e17e69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447857}] :answer-field/correct {:db/id #edb/ref 17592186447857} :answer-field/id #uuid "19481cce-f1a9-5f87-8a34-93aac01ae946" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448968} {:answer-field/choices [{:answer/id #uuid "a5f3b98c-c4eb-5c6c-ace2-f7e5a2fd7de5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447858} {:answer/id #uuid "3b35c2e7-4cc8-5a23-9d0a-9ee7e8200d90" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447859}] :answer-field/correct {:db/id #edb/ref 17592186447859} :answer-field/id #uuid "e99ca2b0-1668-5738-9b06-76be8f1daed7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448969} {:answer-field/choices [{:answer/id #uuid "c0081fe2-ba7a-565b-921c-11dc8bd79c3f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186447860} {:answer/id #uuid "fc911407-1e5d-58b7-8982-c859119fe356" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186447861}] :answer-field/correct {:db/id #edb/ref 17592186447860} :answer-field/id #uuid "e7b988c1-5329-5cf2-9e2b-7bef7867ab8c" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186448970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89286e95-724b-57e9-aee8-7d71e484cafb" :question/math-academy-id "q-107113" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $A={\\begin{bmatrix}0 & a \\\\ b & 0\\end{bmatrix}\\,|\\,a,b\\in R}.$  \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is closed under matrix addition\n- **II.** $A$ is closed under scalar multiplication\n- **III.** $A$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $A$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}=\\begin{bmatrix}0 & {a}_{1} \\\\ {b}_{1} & 0\\end{bmatrix}$ and ${A}_{2}=\\begin{bmatrix}0 & {a}_{2} \\\\ {b}_{2} & 0\\end{bmatrix}$ are two matrices from $A,$ then \n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =\\begin{bmatrix}0 & {a}_{1} \\\\ {b}_{1} & 0\\end{bmatrix}+\\begin{bmatrix}0 & {a}_{2} \\\\ {b}_{2} & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & {a}_{1}+{a}_{2} \\\\ {b}_{1}+{b}_{2} & 0\\end{bmatrix},\\end{aligned}\n$$\n\n \nwhich is a matrix from $A.$ So, $A$ is closed under addition.\n\n- Statement II is true. If $A=\\begin{bmatrix}0 & a \\\\ b & 0\\end{bmatrix}$ is an element of $A$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kA & =k\\begin{bmatrix}0 & a \\\\ b & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & ka \\\\ kb & 0\\end{bmatrix},\\end{aligned}\n$$\n\nwhich is a matrix from $A.$ So, $A$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $A$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "0ed3ae68-425d-5f79-89c2-02931274fc3e" :step/next {:db/id #edb/ref 17592186496353}} {:db/id #edb/ref 17592186496353 :step/content {:db/id #edb/ref 17592186378348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "913e0931-a878-5504-b8b6-00f819edf9a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453210} {:answer/id #uuid "461ff5c7-f262-59e0-9e6a-5ccd795fb660" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453211}] :answer-field/correct {:db/id #edb/ref 17592186453210} :answer-field/id #uuid "9e294ac2-b715-5c6e-b139-8e2b8b489e3a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454355} {:answer-field/choices [{:answer/id #uuid "e10c2846-bfa3-5599-a565-ba95e776088c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453212} {:answer/id #uuid "dfd1227a-6d81-5364-a894-22a85a885507" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453213}] :answer-field/correct {:db/id #edb/ref 17592186453213} :answer-field/id #uuid "5eca9126-955c-5afe-833c-fc32a0b53bb9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454356} {:answer-field/choices [{:answer/id #uuid "076b77e2-6bf3-5918-86f9-98829053c98d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453214} {:answer/id #uuid "d46b15b3-6f74-5c05-b218-76f6180d184c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453215}] :answer-field/correct {:db/id #edb/ref 17592186453214} :answer-field/id #uuid "ab876604-ae7b-5692-8d5d-ac2e83bc51d1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454357} {:answer-field/choices [{:answer/id #uuid "0a38d2c4-5da1-58d9-ad2f-9024e96c37be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186453216} {:answer/id #uuid "9261a407-a47e-58cf-876d-d1ebb17244ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186453217}] :answer-field/correct {:db/id #edb/ref 17592186453217} :answer-field/id #uuid "5823a91a-8b7b-550d-a8ed-1b40a6c306e7" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454358}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "29e169b1-20c5-5789-9178-14e4b85ea9c1" :question/math-academy-id "q-107117" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R,$ and its subset $S$ containing $2\\times 2$ matrices that are not invertible. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $S$ is closed under matrix addition\n- **II.** $S$ is closed under scalar multiplication\n- **III.** $S$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $S$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is false. For example, if ${A}_{1}=\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix}$ and ${A}_{2}=\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix},$ then\n${A}_{1}$ and ${A}_{2}$ each contain a row consisting only of zeros, so they are not invertible. However,\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nis invertible. So, $S$ is *not* closed under addition.\n\n- Statement II is true. Indeed, if $A$ is a $2\\times 2$ matrix that is not invertible then $det(A)=0$ and therefore for all $\\alpha \\in R$ \n\n$$\ndet(\\alpha A)={\\alpha }^{2}\\cdot det(A)={\\alpha }^{2}\\cdot 0=0.\n$$\n\nTherefore,  $S$ is closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $S$ is a *not* subspace because it's not closed under addition.\n\nTherefore, the correct answer is \"II and IV only.\""} :step/id #uuid "63e36469-71e6-559b-91cf-c38fe33932ef"} {:db/id #edb/ref 17592186496372 :step/content {:db/id #edb/ref 17592186496300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2121065c-b843-5046-8de5-d3cd11c91cc5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186495580} {:answer/id #uuid "40147242-1ff3-5589-bd5f-2562944166ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "IV only" :db/id #edb/ref 17592186495657} {:answer/id #uuid "7c969901-88f0-5143-89a5-a836078136cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III only" :db/id #edb/ref 17592186495777} {:answer/id #uuid "8ee5cbac-98dc-5804-b9ee-b5c755e31be5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186495825} {:answer/id #uuid "ca0b96fa-4065-5336-8b0e-48692fa39925" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186495950}] :answer-field/correct {:db/id #edb/ref 17592186495777} :answer-field/id #uuid "cf373aed-aad4-52b7-aa07-ba88e991e0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186496182}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b24b6cb2-194b-5c78-a36d-8250b69a2b91" :question/math-academy-id "q-94614" :question/problem "Consider the vector space ${R}_{2}[t]$ of all polynomials in the variable $t$ of degree at most $2,$ and its subset $A$ containing all polynomials of the form $a{t}^{2},$ where $a\\in R.$\n\nWhich of the following statements are true?\n\nI. $A$ is closed under polynomial addition\n\nII. $A$ is closed under scalar multiplication\n\nIII. $A$ is a subspace of ${R}_{2}[t]$\n\nIV. $A$ is **not** a subspace of ${R}_{2}[t]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(t)={a}_{1}{t}^{2}$ and $g(t)={a}_{2}{t}^{2}$ are two polynomials from $A,$ then\n\n$$\n\\begin{aligned}f(t)+g(t) & ={a}_{1}{t}^{2}+{a}_{2}{t}^{2} \\\\  & =({a}_{1}+{a}_{2}){t}^{2},\\end{aligned}\n$$\n\nwhich is a polynomial from $A.$ So, $A$ is closed under addition.\n\n- Statement II is true. If $f(t)=a{t}^{2}\\in A$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kf(t) & =k(a{t}^{2}) \\\\  & =(ka){t}^{2},\\end{aligned}\n$$\n\nwhich is a polynomial from $A.$ So, $A$ is closed under scalar multiplication.\n\n- Statement III is true while statement IV is false. $A$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""} :step/id #uuid "ac3720e5-0f1c-5687-afab-3cf0e63cc0b8" :step/next {:db/id #edb/ref 17592186496337}}] :activity/title "Subspaces of Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495500}] [{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186134812} :activity/id #uuid "e5c7e80a-2ee4-5b4a-a66d-c98773047176" :activity/scope {:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132} :activity/steps [{:db/id #edb/ref 17592186134812 :step/content {:db/id #edb/ref 17592186135103 :tutorial/content "Suppose that $\\mathbf F$ is a vector field on $\\mathbb R^3,$ expressed in terms of its component functions as\n\n$$\\mathbf F(x,y,z) = P(x,y,z)\\,\\mathbf i + Q(x,y,z)\\,\\mathbf j + R(x,y,z)\\,\\mathbf k.$$\n\nIf the first partial derivatives of $P, Q,$ and $R$ all exist, then the **curl** of $\\mathbf F,$ denoted $\\textrm{curl}\\,\\mathbf F,$ is a vector field on $\\mathbb R^3$ given by\n\n$$\\textrm{curl}\\,\\mathbf F = \\left(\\dfrac{\\partial R}{\\partial y} - \\dfrac{\\partial Q}{\\partial z} \\right)\\,\\mathbf i + \\left(\\dfrac{\\partial P}{\\partial z} - \\dfrac{\\partial R}{\\partial x}\\right)\\,\\mathbf j + \\left(\\dfrac{\\partial Q }{\\partial x} - \\dfrac{\\partial P }{\\partial y}\\right)\\,\\mathbf k.$$\n\nThe formula above is pretty tough to remember. Luckily, there is an easier way. If we define the differential operator $\\nabla$ (a.k.a. the \"del\" operator) as\n\n$$\\nabla = \\mathbf i\\,\\dfrac{\\partial }{\\partial x} + \\mathbf j\\,\\dfrac{\\partial }{\\partial y} + \\mathbf k\\,\\dfrac{\\partial }{\\partial z}$$\n\nthen the curl of $\\mathbf F$ is given by the cross product\n\n$$\\textrm{curl}\\,\\mathbf F = \\nabla \\times\\mathbf F.$$\n\nExpressing the quantity on the right-hand side as a determinant, we have\n\n$$\\textrm{curl}\\,\\mathbf F = \\nabla \\times\\mathbf F = \\left| \\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned} \\right|.$$\n\nFor example, suppose that the vector field $\\mathbf F$ is given by\n\n$$\\mathbf{F}(x,y,z)=xz\\,\\mathbf{i}+ xy\\,\\mathbf{j}+yz\\,\\mathbf{k}.$$\n\nThen we can calculate $\\textrm{curl}\\,\\mathbf{F}$ using the determinant formula as follows:\n\n$$\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ xz & xy & yz\\end{aligned}| \\\\ & =[\\frac{∂}{∂y}(yz)-\\frac{∂}{∂z}(xy)]i-[\\frac{∂}{∂x}(yz)-\\frac{∂}{∂z}(xz)]j+[\\frac{∂}{∂x}(xy)-\\frac{∂}{∂y}(xz)]k \\\\ & =(z-0)\\,i-(0-x)\\,j+(y-0)\\,k \\\\ & =z\\,i+x\\,j+y\\,k\\end{aligned}$$" :tutorial/id #uuid "748e0ff5-caab-5725-a53e-a87f3322d0b4" :tutorial/math-academy-id 5141 :tutorial/title "Introduction"} :step/id #uuid "cd896bf6-f61b-5f98-b1ed-40e9aa1214a5" :step/math-academy-id 32355 :step/next {:db/id #edb/ref 17592186134845}} {:db/id #edb/ref 17592186134823 :step/content {:db/id #edb/ref 17592186133877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133693 :question/id #uuid "4e4236a9-d99f-50b1-803a-ab3aea5a673e" :question/math-academy-id "e-8743"} :knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707} {:db/id #edb/ref 17592186049132}] :knowledge-point/questions [{:db/id #edb/ref 17592186134370} {:db/id #edb/ref 17592186134371} {:db/id #edb/ref 17592186235539} {:db/id #edb/ref 17592186241107} {:db/id #edb/ref 17592186241111} {:db/id #edb/ref 17592186266075} {:db/id #edb/ref 17592186382847} {:db/id #edb/ref 17592186383258} {:db/id #edb/ref 17592186383265} {:db/id #edb/ref 17592186383272} {:db/id #edb/ref 17592186385913}] :knowledge-point/title "Calculating the Curl of a Vector Field"} :step/id #uuid "ed910a8f-f9f5-5744-a048-0db164b576a3" :step/math-academy-id 32563 :step/next {:db/id #edb/ref 17592186134874}} {:db/id #edb/ref 17592186134827 :step/content {:db/id #edb/ref 17592186133881 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133697 :question/id #uuid "cb99a3e1-9cd1-5335-b20c-01ad598d14bf" :question/math-academy-id "e-8929"} :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048917}] :knowledge-point/questions [{:db/id #edb/ref 17592186134062} {:db/id #edb/ref 17592186134063} {:db/id #edb/ref 17592186241106} {:db/id #edb/ref 17592186241108} {:db/id #edb/ref 17592186241110} {:db/id #edb/ref 17592186241116} {:db/id #edb/ref 17592186241117} {:db/id #edb/ref 17592186266079} {:db/id #edb/ref 17592186266080} {:db/id #edb/ref 17592186382833} {:db/id #edb/ref 17592186382840} {:db/id #edb/ref 17592186409610} {:db/id #edb/ref 17592186446572} {:db/id #edb/ref 17592186446573}] :knowledge-point/title "Interpreting the Curl of a Vector Field"} :step/id #uuid "9c1c4ab6-b310-57fe-81bc-08a0edb50c57" :step/math-academy-id 33327} {:db/id #edb/ref 17592186134843 :step/content {:db/id #edb/ref 17592186135115 :tutorial/content "We know how to compute the curl of a vector field. Our goal now is to develop an intuitive understanding of what the curl of a vector field measures.\n\nConsider the vector field $\\mathbf F(x,y,z)$ shown below. Assume that $\\mathbf F$ is independent of $z.$ \n\n![](images/13/13db0656977bb206ccca66fd25fee08ee2b3c8724173b74aeb4e856109ce0be5.png)\n\nIt's helpful to imagine that this vector field represents the velocity field of a stream of flowing water. \n\nNow, we pick an arbitrary point in the $xy$-plane and place a paddlewheel at our point with the axis of rotation pointing in the $z$-direction (the direction of the curl).\n\n![](images/0e/0eb70168474799d1b94311f444aef72e1904b0c8e13042ba1ba182cd23e57dba.png)\n\nThe curl of the vector field at our point measures how much the paddlewheel rotates due to the action of the water. There are two possible cases, illustrated below.\n\n![](images/86/86aee33cdfa96ac0a61468cc9657e791e399f31c024cdbc3a932193dc897d534.png)\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl. In other words, $\\textrm{curl}\\,\\mathbf F \\neq  \\mathbf 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then $\\textrm{curl}\\,\\mathbf F =  \\mathbf 0.$ In this case, we say that $\\mathbf F$ is **irrotational**.\n\nFor the particular point we've chosen in our example, we can see that the action of the water will cause the paddleboard to rotate counterclockwise.\n\n![](images/96/96bfb9c08d2d5ea0c119e8e4ee6a54e8aaa9fee0eabe8fb13b7c65cc586c3094.png)\n\nSince the water causes the paddleboard to rotate, we must have $\\textrm{curl}\\,\\mathbf F \\neq \\mathbf 0.$\n\nFinally, note that if $\\textrm{curl}\\,\\mathbf F =\\mathbf 0,$ then it does not point in any particular direction." :tutorial/id #uuid "b69ffb3c-f0ed-59d1-b022-ccb162de3d67" :tutorial/math-academy-id 5519 :tutorial/title "Physical Interpretation of the Curl"} :step/id #uuid "b31fa9fe-8595-5f98-bdde-8a55d53eccb1" :step/math-academy-id 34360 :step/next {:db/id #edb/ref 17592186134846}} {:db/id #edb/ref 17592186134845 :step/content {:db/id #edb/ref 17592186135117 :tutorial/content "We can only compute the curl of a *vector* field, and a vector field's curl is also a vector field. So if $\\mathbf G = \\textrm{curl}\\,\\mathbf F,$ then we have the following map:\n\n$$\n\\underbrace{\\,\\,\\,\\mathbf F(x,y,z)\\,\\,\\,}_{\\textrm{vector field}} \\mapsto\\underbrace{\\,\\,\\,\\mathbf G(x,y,z)\\,\\,\\,}_{\\textrm{vector field}}\n$$\n\nIn contrast, if $f(x,y, z)$ is a scalar field, then the statement $\\textrm{curl}\\, f$ has no meaning.\n\nThe curl of a vector field at a point $P$ gives us helpful information about the rotational behavior of the vector field at $P.$ We'll describe this in more detail shortly." :tutorial/id #uuid "c5a7bd6a-0498-53af-afe7-1a9974db120d" :tutorial/math-academy-id 5789 :tutorial/title "Some Notes About the Curl of a Vector Field"} :step/id #uuid "a02eaa37-2a1d-55e1-98e9-5eda118d61d2" :step/math-academy-id 35528 :step/next {:db/id #edb/ref 17592186134823}} {:db/id #edb/ref 17592186134846 :step/content {:db/id #edb/ref 17592186135118 :tutorial/content "In general, when we compute the curl of a vector field at a point, the result is a vector. This vector gives us two pieces of information about the rotation of a paddleboard placed at that point:\n\n- The magnitude of the curl vector indicates the speed of the rotation of the paddleboard.\n\n- The direction of the curl vector gives us the *axis of rotation* on which the paddlewheel should be placed for maximum rotation.\n\nThe orientation of the curl vector is determined by the so-called **right-hand rule**. To understand this, let's return to our example:\n\n![](images/96/96bfb9c08d2d5ea0c119e8e4ee6a54e8aaa9fee0eabe8fb13b7c65cc586c3094.png)\n\nUsing our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point *away* from the screen. Therefore, $\\textrm{curl}\\,\\mathbf F$ also points away from the screen, in the direction of increasing $z.$ \n\nThe situation is reversed when the rotation of the vector field is clockwise:\n\n![](images/4b/4b13f2a96f05124184ad8b7f2007b2267a55679b55e5ed6344a2609696abe0be.png)\n\nUsing our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point *into* the screen. Therefore, $\\textrm{curl}\\,\\mathbf F$ also points into from the screen, in the direction of decreasing $z.$" :tutorial/id #uuid "4456c748-e7a9-5576-b733-c6033799f9f2" :tutorial/math-academy-id 5790 :tutorial/title "The Right-Hand Rule"} :step/id #uuid "7edf68a9-c5bd-5bbc-82e9-a0291639597e" :step/math-academy-id 35529 :step/next {:db/id #edb/ref 17592186134847}} {:db/id #edb/ref 17592186134847 :step/content {:db/id #edb/ref 17592186135119 :tutorial/content "The following two vector fields would both cause a paddleboard to rotate counterclockwise. Therefore, their curl is nonzero.\n\n![](images/92/92654626dae292c06a227622c6eb590df6e7c898eebe1c06d2b3cd57630dfea0.png)\n\nThe following two vector fields would both cause a paddleboard to rotate clockwise. Therefore, their curl is nonzero.\n\n![](images/2c/2cda9e8468dff1fdfe3d60c4069054f1f85ea4c6356075b576f69228def7496c.png)\n\nThe following vector fields are irrotational (i.e., they each have zero curl).\n\n![](images/fd/fd66b65e3b9bdba852e9bfa2826f3950d4b901cab2c76ce0a153491daf338b21.png)" :tutorial/id #uuid "83e8ceb0-2e0b-502b-bfd5-8571ac38410c" :tutorial/math-academy-id 5792 :tutorial/title "Examples of Vector Fields With Curl and Irrotational Vector Fields"} :step/id #uuid "48e5d042-5f59-5eae-8bb5-54d78cbde685" :step/math-academy-id 35534 :step/next {:db/id #edb/ref 17592186134827}} {:db/id #edb/ref 17592186134869 :step/content {:db/id #edb/ref 17592186133898 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133714 :question/id #uuid "39577555-e9cb-563a-8f5e-8b9ea4b57364" :question/math-academy-id "e-9556"} :knowledge-point/id #uuid "6b65b190-b587-5827-a160-b8df85b6227c" :knowledge-point/question-generator {:db/id #edb/ref 17592186520658} :knowledge-point/questions [{:db/id #edb/ref 17592186134094} {:db/id #edb/ref 17592186134095} {:db/id #edb/ref 17592186235527} {:db/id #edb/ref 17592186262624} {:db/id #edb/ref 17592186262626} {:db/id #edb/ref 17592186262627} {:db/id #edb/ref 17592186262629} {:db/id #edb/ref 17592186262630} {:db/id #edb/ref 17592186266076} {:db/id #edb/ref 17592186266078} {:db/id #edb/ref 17592186362536} {:db/id #edb/ref 17592186383062} {:db/id #edb/ref 17592186383069} {:db/id #edb/ref 17592186383076} {:db/id #edb/ref 17592186409609} {:db/id #edb/ref 17592186446574}] :knowledge-point/title "Calculating the Scalar Curl of a Vector Field"} :step/id #uuid "7ee830f5-6150-5cbf-b49c-f6582be4799a" :step/math-academy-id 35806 :step/next {:db/id #edb/ref 17592186134843}} {:db/id #edb/ref 17592186134874 :step/content {:db/id #edb/ref 17592186135135 :tutorial/content "Technically, we can only find the curl of a vector field on $\\mathbb R^3.$ If $\\mathbf F$ is a vector field on $\\mathbb R^2,$ then (strictly speaking) $\\textrm{curl}\\, \\mathbf F$ has no meaning. \n\nHowever, it's sometimes helpful to avoid this issue by considering $\\mathbf F$ as a vector field on $\\mathbb R^3$ whose $\\mathbf k$ component is zero everywhere. \n\nAssuming that the $\\mathbf k$ component of $\\mathbf F$ is zero everywhere, the curl must point in the $z$-direction perpendicular to your screen. To see why, note that if we start from\n\n$$\n\\mathbf F(x,y,z) = P(x,y,z)\\,\\mathbf i + Q(x,y,z)\\,\\mathbf j + R(x,y,z)\\,\\mathbf k,\n$$\n\nthen set \n\n$$\nR(x,y,z) = 0, \\qquad \\dfrac{\\partial P}{\\partial z}= \\dfrac{\\partial Q}{\\partial z} = 0\n$$\n\nand, finally, substitute the above into our curl formula, then we get\n\n$$\n\\textrm{curl}\\,\\mathbf F \n= \n\\left(\\dfrac{\\partial Q }{\\partial x} - \\dfrac{\\partial P }{\\partial y}\\right)\\,\\mathbf k.\n$$\n\nNote that the quantity \n\n$$\n\\dfrac{\\partial Q }{\\partial x} - \\dfrac{\\partial P }{\\partial y}\n$$\n\n \nis called the **scalar curl** of $\\mathbf F.$ The scalar curl is associated with two-dimensional vector fields only." :tutorial/id #uuid "07a27175-fb76-5663-98dd-203ead020fc3" :tutorial/math-academy-id 5848 :tutorial/title "The Curl of a Two-Dimensional Vector Field"} :step/id #uuid "2f58e72d-0cd5-5224-8856-908ecd564b96" :step/math-academy-id 35822 :step/next {:db/id #edb/ref 17592186134869}}] :activity/title "The Curl of a Vector Field" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134011}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409612} :activity/id #uuid "e5b5f674-7783-5eb4-b089-af373cffcaf2" :activity/scope {:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132} :activity/steps [{:db/id #edb/ref 17592186409611 :step/content {:db/id #edb/ref 17592186409610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8286c6dd-7fea-5018-b722-69a0848b0bcc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437502} {:answer/id #uuid "5d52abdf-7ac5-55e3-92ae-9aec71a85bbf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437503}] :answer-field/correct {:db/id #edb/ref 17592186437502} :answer-field/id #uuid "cb53bf33-5552-5395-8fd4-4d42b50a2a01" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438780} {:answer-field/choices [{:answer/id #uuid "a4939bd9-e529-5af3-b533-59e09598d0e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437504} {:answer/id #uuid "2b9d89e5-98a9-5520-8de9-5ddb178c0664" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437505}] :answer-field/correct {:db/id #edb/ref 17592186437505} :answer-field/id #uuid "2a596bab-34c8-5ee7-9e82-c47a2988e863" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438781} {:answer-field/choices [{:answer/id #uuid "273314f4-9ed1-52ac-8d9b-6701a93d8748" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437506} {:answer/id #uuid "265725b9-3d43-5f84-a380-552591b33792" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437507}] :answer-field/correct {:db/id #edb/ref 17592186437507} :answer-field/id #uuid "05fd84cc-0dd3-5f03-9595-e86a0cb51c38" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438782} {:answer-field/choices [{:answer/id #uuid "5fc09d16-5459-5df8-9d7e-c5304315ffbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437508} {:answer/id #uuid "3423417a-d67c-5bac-8ed6-720f61a5aa60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437509}] :answer-field/correct {:db/id #edb/ref 17592186437508} :answer-field/id #uuid "31b1fd93-e1ee-539e-8481-cca67e61611b" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438783}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "656969c6-847a-533c-a9b8-d526f82e1ab3" :question/math-academy-id "q-105694" :question/problem "![](images/17/17637e938a25e91b9a03921dbbe0f22c8ea760f09cfed9b4a76d07bd5e3b9301.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the negative $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/f3/f385add60afac473a5734f8c1ed57c6575bada03c9c16b24fed73b200c38e2c5.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point into the screen. Therefore, $\\text{curl}\\,F$ also points into the screen, in the direction of decreasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "3e935ab0-b71e-5b6d-b820-ffbfd12a9752" :step/next {:db/id #edb/ref 17592186409614}} {:db/id #edb/ref 17592186409612 :step/content {:db/id #edb/ref 17592186241110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf86ba1-b225-5f4e-a85f-182bd2bdbc53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437478} {:answer/id #uuid "c7744411-0aa5-54ef-9c74-d6ca7e53bdb6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437479}] :answer-field/correct {:db/id #edb/ref 17592186437479} :answer-field/id #uuid "af1fc1b7-1f6d-5789-bbaf-748a9803bc96" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438768} {:answer-field/choices [{:answer/id #uuid "9168e608-76cb-5350-991f-3427546bf922" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437480} {:answer/id #uuid "6acf104d-e9d0-56e0-a85c-9b1ece39cee2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437481}] :answer-field/correct {:db/id #edb/ref 17592186437480} :answer-field/id #uuid "6aa0313b-ee82-5436-b649-0b4504bba2d2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438769} {:answer-field/choices [{:answer/id #uuid "bf15f6c8-cfc5-5bbe-886a-d7a4c35fe3b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437482} {:answer/id #uuid "5ab85c7d-e507-5369-a231-49fca8b2c436" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437483}] :answer-field/correct {:db/id #edb/ref 17592186437483} :answer-field/id #uuid "c223aec0-697d-56a5-825e-44718ec7f2d3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438770} {:answer-field/choices [{:answer/id #uuid "a4d8d559-74b6-5016-bfae-9833564ce138" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437484} {:answer/id #uuid "ee14db71-cbc6-5c05-87b0-f9afe0453fbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437485}] :answer-field/correct {:db/id #edb/ref 17592186437484} :answer-field/id #uuid "28f80fe3-8688-556e-8b02-a42b1e403d0f" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438771}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "54529993-0bd1-511f-b362-f0eafc672ef8" :question/math-academy-id "q-105671" :question/problem "![](images/4c/4c38294780ac6d5079b759f39a7dbd4944b1c3c21495245dfd314ec180c0434e.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the positive $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/97/979b63f21e56924bd7880f9487cf829089e38cf14d287e70196c7a661e41f97f.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statement III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "9367b403-efcf-5ce5-86fa-9fe85e17890b" :step/next {:db/id #edb/ref 17592186409611}} {:db/id #edb/ref 17592186409613 :step/content {:db/id #edb/ref 17592186409609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd5ff55-9267-592c-8f53-54d27c28ddbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2({y}^{2}-{x}^{2})}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409591} {:answer/id #uuid "64ee45f8-90e8-584e-9ee0-f763b1794d3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409596} {:answer/id #uuid "81f3041d-6679-5b2e-8990-3525e4b2226c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409598} {:answer/id #uuid "9811b973-e6d5-574c-9870-5a2db507cfc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409600} {:answer/id #uuid "d498b33f-c852-5e73-bfc6-bc624cb1045e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409602}] :answer-field/correct {:db/id #edb/ref 17592186409591} :answer-field/id #uuid "3d405633-3d03-5b83-b9d8-c7d039eaf05b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a957b95-e78d-5791-8e30-44fc756d4a5e" :question/math-academy-id "q-131343" :question/problem "Given that $F(x,y)=\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}})-\\frac{∂}{∂y}(\\frac{y}{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{{y}^{2}-{x}^{2}}{{({x}^{2}+{y}^{2})}^{2}}-\\frac{{x}^{2}-{y}^{2}}{{({x}^{2}+{y}^{2})}^{2}} \\\\  & =\\frac{2({y}^{2}-{x}^{2})}{{({x}^{2}+{y}^{2})}^{2}}\\end{aligned}\n$$"} :step/id #uuid "94cf6f34-eb3b-582a-a36f-1fccec5bf9a0"} {:db/id #edb/ref 17592186409614 :step/content {:db/id #edb/ref 17592186134095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613b73ad-b4bd-580f-91d8-dabafde0761e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186409595} {:answer/id #uuid "8cf92fb5-00f1-572a-8207-d72045cf4a6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186409599} {:answer/id #uuid "9a5d28d8-413b-530d-ad6e-efa5df8905f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\pi " :db/id #edb/ref 17592186409601} {:answer/id #uuid "ee35c795-c099-5c49-977b-052171747158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186409603} {:answer/id #uuid "f7113576-7a9c-589a-960b-40c8d014ca07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186409604}] :answer-field/correct {:db/id #edb/ref 17592186409601} :answer-field/id #uuid "9898eac0-330a-51e3-bb68-1c7f9a46f935" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409607}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "494f0061-8555-5747-be24-aea11c4501ae" :question/math-academy-id "q-126428" :question/problem "Consider the vector field $F(x,y)=x\\operatorname{sin}⁡y\\,i+\\operatorname{cos}⁡(xy)\\,j.$ Evaluate the scalar curl of $F$ at the point $(\\pi ,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(xy))-\\frac{∂}{∂y}(x\\operatorname{sin}⁡y) \\\\  & =-\\operatorname{sin}⁡(xy)\\cdot y-x\\operatorname{cos}⁡y \\\\  & =-y\\operatorname{sin}⁡(xy)-x\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(\\pi ,0),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(\\pi ,0)} & =-0\\cdot \\operatorname{sin}⁡(\\pi \\cdot 0)-\\pi \\cdot \\operatorname{cos}⁡(0) \\\\  & =0-\\pi \\cdot 1 \\\\  & =-\\pi .\\end{aligned}\n$$"} :step/id #uuid "b9f70b49-6fa6-5fee-a84d-6cdc4f073bd2" :step/next {:db/id #edb/ref 17592186409615}} {:db/id #edb/ref 17592186409615 :step/content {:db/id #edb/ref 17592186262624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13264dd3-32ca-5425-ae4a-10ae592d25f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186260044} {:answer/id #uuid "1ad4275e-e84f-5e99-9926-6ed1c4bda7e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186260108} {:answer/id #uuid "5ec4d041-01f8-5cba-bbc5-711d818eb654" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186260692} {:answer/id #uuid "7344edf5-4fa2-53cc-aefd-2082b97c5134" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186260883} {:answer/id #uuid "deb142df-e54d-5f60-a501-f62bc2ccccc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186261841}] :answer-field/correct {:db/id #edb/ref 17592186260108} :answer-field/id #uuid "6208b069-a1cc-5b39-96a3-5295dfbd12c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262291}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84980841-460b-507f-8790-439efc8ff63f" :question/math-academy-id "q-126525" :question/problem "Consider the vector field $F(x,y)=\\operatorname{sin}⁡(x+y)\\,i+(x{y}^{2}+1)\\,j.$ Evaluate the scalar curl of $F$ at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(x{y}^{2}+1)-\\frac{∂}{∂y}(\\operatorname{sin}⁡(x+y)) \\\\  & ={y}^{2}-\\operatorname{cos}⁡(x+y).\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(0,\\frac{\\pi }{2}),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(0,\\pi /2)} & ={(\\frac{\\pi }{2})}^{2}-\\operatorname{cos}⁡(0+\\frac{\\pi }{2}) \\\\  & =\\frac{{\\pi }^{2}}{4}-0 \\\\  & =\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$"} :step/id #uuid "e05e6b0f-4f4c-5280-957e-b076cba38cb7" :step/next {:db/id #edb/ref 17592186409613}}] :activity/title "The Curl of a Vector Field" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409590}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186481728} :activity/id #uuid "0fc222ec-8ee3-576a-8975-559e2c61b885" :activity/scope {:db/id #edb/ref 17592186051085 :topic/id #uuid "7fdf89be-7454-5a23-9d34-17c62e869eea" :topic/math-academy-id 2132} :activity/steps [{:db/id #edb/ref 17592186481700 :step/content {:db/id #edb/ref 17592186266079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437856} {:answer/id #uuid "7a46d360-0b63-59bd-8d4c-b0aa9e72d4a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437857}] :answer-field/correct {:db/id #edb/ref 17592186437856} :answer-field/id #uuid "24781376-5a9f-5184-b064-24b3c476bb79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438957} {:answer-field/choices [{:answer/id #uuid "d33cbee7-fc8b-5c3d-bfba-41b228bb82bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437858} {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437859}] :answer-field/correct {:db/id #edb/ref 17592186437859} :answer-field/id #uuid "dfb64428-9f16-5737-8c74-c42a032a0297" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438958} {:answer-field/choices [{:answer/id #uuid "058fa0b3-ef79-5a7a-afc6-113a760e3e70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437860} {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437861}] :answer-field/correct {:db/id #edb/ref 17592186437861} :answer-field/id #uuid "52c67e92-c96c-5d8b-b9f6-cc9263317637" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438959} {:answer-field/choices [{:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437862} {:answer/id #uuid "e701c30a-31e0-5846-a5ac-4931665193d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437863}] :answer-field/correct {:db/id #edb/ref 17592186437862} :answer-field/id #uuid "387cbfbf-b068-513c-93c4-71cb2f6085f2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438960}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a88235e-0bbc-5c38-af1d-92f6a6eda26f" :question/math-academy-id "q-131361" :question/problem "![](images/17/1709a94b7361a1e8764d94199f9e84802ae925a09e6481250d0846b83bb6549f.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the negative $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/7c/7c831425eae7afd709d546a8e05100f495adc04bba6450cfa56d370b415a28f5.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point into the screen. Therefore, $\\text{curl}\\,F$ also points into from the screen, in the direction of decreasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "5cb2647d-9528-5c30-ba8e-54caf973f4e8" :step/next {:db/id #edb/ref 17592186481740}} {:db/id #edb/ref 17592186481728 :step/content {:db/id #edb/ref 17592186446573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c74d4b9-7ed4-529a-b818-13e80317f0ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186446560} {:answer/id #uuid "976ecb2e-4f04-5610-8207-c96b23772842" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186446561} {:answer/id #uuid "b06370cf-7aa1-54f8-9e46-dc3a42a8d19d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186446563} {:answer/id #uuid "c7df0803-65d5-5e82-a045-a191ec18b671" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186446564} {:answer/id #uuid "e214b4cf-1c30-5601-8ce0-ad80b4de52ae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186446567}] :answer-field/correct {:db/id #edb/ref 17592186446560} :answer-field/id #uuid "b667cd59-08f8-5c6e-82c5-8b3ea70d6405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186446570}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "40fa6adc-4679-5e13-a9fc-cb698f54e0e6" :question/math-academy-id "q-105700" :question/problem "![](images/18/183ea541b33b8389de46f9ee1560ed1da2b999191477d7490eb4970922bdc43c.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nI. $\\text{curl}\\,F=0$\n\nII. $\\text{curl}\\,F\\ne 0$\n\nIII. $F$ is not irrotational\n\nIV. $\\text{curl}\\,F$ points in the positive $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/b1/b1520791fcb3808604758b7d8f99443020d12075d4cc8bff78659880575b6ef2.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statements III and IV are false. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational. And, since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "ad78c5c9-ad7f-533a-a2ae-0ae1700b578f" :step/next {:db/id #edb/ref 17592186481749}} {:db/id #edb/ref 17592186481731 :step/content {:db/id #edb/ref 17592186262630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221ac97f-6559-509a-a3d9-2450bf49633e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}-{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186260172} {:answer/id #uuid "a2757385-050d-54a8-8369-31a9aa26112c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}+2x{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186261289} {:answer/id #uuid "b7289054-f9d1-5ae6-bd2a-f55dcf3e02b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186261483} {:answer/id #uuid "fbb179e1-20cb-58d0-b8da-a19ff4125371" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262076} {:answer/id #uuid "fcd94cc3-eb96-53bb-8a15-64be7834efb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262088}] :answer-field/correct {:db/id #edb/ref 17592186262076} :answer-field/id #uuid "8edf0788-7859-57f4-ac13-2b85b5bf5d5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262376}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b1f3451-5b4c-525b-84a2-e17f8516fc90" :question/math-academy-id "q-126547" :question/problem "Given that $F(x,y)={y}^{2}\\operatorname{ln}⁡({x}^{2}+1)\\,i+({x}^{2}-y)\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}({x}^{2}-y)-\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡({x}^{2}+1)) \\\\  & =2x-2y\\operatorname{ln}⁡({x}^{2}+1).\\end{aligned}\n$$"} :step/id #uuid "c486f1f0-e8fa-5c16-9036-44a2ad1aee07" :step/next {:db/id #edb/ref 17592186481700}} {:db/id #edb/ref 17592186481740 :step/content {:db/id #edb/ref 17592186446572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f352f1a-1af2-5144-a245-10854ead8b02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and IV only" :db/id #edb/ref 17592186446554} {:answer/id #uuid "41e8b7d6-5c7a-5cf8-9c06-4d00a18513e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and IV only" :db/id #edb/ref 17592186446557} {:answer/id #uuid "834c390d-d089-5913-89c4-08a44764f21a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186446558} {:answer/id #uuid "dcefe323-f572-5c28-853b-0586c0615884" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186446565} {:answer/id #uuid "f3c44a28-6809-582c-b411-ffd64f99822a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186446568}] :answer-field/correct {:db/id #edb/ref 17592186446565} :answer-field/id #uuid "dfc4e87e-69ab-505e-8ac2-a813c8707da5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186446571}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "322bc9a1-81a0-53ce-920d-1108825e3484" :question/math-academy-id "q-131363" :question/problem "![](images/5a/5ac051f640c2b4eae760eee9c567ec35ce3169384ec2305554e21c6d2d587bbe.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nI. $\\text{curl}\\,F=0$\n\nII. $\\text{curl}\\,F\\ne 0$\n\nIII. $\\text{curl}\\,F$ points in the negative $z$-direction.\n\nIV. $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/80/80c67e624f960147b7980ee90700be800a414ab1e2a2e47faf7e8821ee0c0623.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate counterclockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is false. Using our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point away from the screen. Therefore, $\\text{curl}\\,F$ also points away from the screen, in the direction of increasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "dda57262-1ccc-5da1-bbd4-59647bd6412a"} {:db/id #edb/ref 17592186481749 :step/content {:db/id #edb/ref 17592186446574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d194d4-bd3d-507f-8c59-044dbc7c81ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186446555} {:answer/id #uuid "2afb3ad3-3542-5efb-92a8-0a844c4e01a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186446556} {:answer/id #uuid "8854556c-9dbd-5890-ab92-8f478346b8b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186446559} {:answer/id #uuid "98578e86-a0e6-513f-9db5-c6b91293012b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186446562} {:answer/id #uuid "e0f07f8f-3a33-5658-92ff-2b538d7dcca1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186446566}] :answer-field/correct {:db/id #edb/ref 17592186446555} :answer-field/id #uuid "9999ac46-6f4e-593f-907b-51eaf6bed9c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186446569}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aedf76f0-5451-58bc-9366-057502daac94" :question/math-academy-id "q-126522" :question/problem "Consider the vector field $F(x,y)=(3x+2y)\\,i+({y}^{2}-{x}^{2})\\,j.$ Evaluate the scalar curl of $F$ at the point $(-2,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}({y}^{2}-{x}^{2})-\\frac{∂}{∂y}(3x+2y) \\\\  & =-2x-2.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(-2,1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(-2,1)} & =-2(-2)-2 \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "f9980b60-ddef-518f-9c60-dd36d6feb6c5" :step/next {:db/id #edb/ref 17592186481731}}] :activity/title "The Curl of a Vector Field" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481564}]}
