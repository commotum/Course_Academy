"347053fb-b31c-5623-b4db-4c770ada4d18" #edb/ref 17592186045417] [17592186069905 #edb/ref 1058 #edb/ref 17592186069906 #edb/ref 17592186045417] [17592186069905 #edb/ref 1061 655420 #edb/ref 17592186045417] [17592186069905 #edb/ref 1062 #uuid "944ebf60-fe41-58ac-91a8-63c93b565add" #edb/ref 17592186045417] [17592186069905 #edb/ref 1063 #edb/ref 17592186070031 #edb/ref 17592186045417] [17592186069906 #edb/ref 1058 #edb/ref 17592186069907 #edb/ref 17592186045417] [17592186069906 #edb/ref 1061 655421 #edb/ref 17592186045417] [17592186069906 #edb/ref 1062 #uuid "f13b1e1c-2034-5d26-b6a0-2b5227d65b96" #edb/ref 17592186045417] [17592186069906 #edb/ref 1063 #edb/ref 17592186068919 #edb/ref 17592186045417] [17592186069907 #edb/ref 1058 #edb/ref 17592186069908 #edb/ref 17592186045417] [17592186069907 #edb/ref 1061 655424 #edb/ref 17592186045417] [17592186069907 #edb/ref 1062 #uuid "c22a3f17-9151-565b-8158-62703c1da221" #edb/ref 17592186045417] [17592186069907 #edb/ref 1063 #edb/ref 17592186068920 #edb/ref 17592186045417] [17592186069908 #edb/ref 1061 655427 #edb/ref 17592186045417] [17592186069908 #edb/ref 1062 #uuid "fbb28f81-ea51-5172-9911-15b8c5ea0ef5" #edb/ref 17592186045417] [17592186069908 #edb/ref 1063 #edb/ref 17592186068921 #edb/ref 17592186045417] [17592186070031 #edb/ref 1064 "We know that we can use the method of integration by parts to evaluate $\\displaystyle \\int xe^{4x} \\textrm{d}x.$ Now, suppose that we want to calculate $\\displaystyle \\int x^2e^{4x} \\textrm{d}x.$ Can we use integration by parts in this case?\n\nLet's  try. We define $u$ and $v$ as follows:\n\n$$\n\\begin{aligned}u={x}^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{4x} & \\,⟹\\,v=\\int {e}^{4x}\\text{d}x=\\frac{1}{4}\\,{e}^{4x}\\,.\\end{aligned}\n$$\n\nSo the formula for integration by parts leads to\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{4x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={x}^{2}(\\frac{1}{4}\\,{e}^{4x})-\\int (\\frac{1}{4}\\,{e}^{4x})2x\\,\\text{d}x \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}\\int x{e}^{4x}\\text{d}x.\\end{aligned}\n$$\n\nWe still don't have an answer, but the problem is reduced to the calculation of a simpler integral  $\\displaystyle \\int xe^{4x} \\textrm{d}x.$ To compute this integral, we just need to apply the integration by parts formula again. For this second integral, we take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{4x} & \\,⟹\\,v=\\int {e}^{4x}\\text{d}x=\\frac{1}{4}\\,{e}^{4x}\\,.\\end{aligned}\n$$\n\nNow, integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{4x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =x(\\frac{1}{4}\\,{e}^{4x})-\\int (\\frac{1}{4}\\,{e}^{4x})\\cdot 1\\,\\text{d}x \\\\  & =\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{4}(\\frac{1}{4}\\,{e}^{4x})+{C}_{1} \\\\  & =\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{16}\\,{e}^{4x}+{C}_{1}\\,,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{4x}\\text{d}x & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}\\int x{e}^{4x}\\text{d}x \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}(\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{16}\\,{e}^{4x}+{C}_{1}) \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{8}\\,x{e}^{4x}+\\frac{1}{32}\\,{e}^{4x}-\\frac{{C}_{1}}{2} \\\\  & =\\frac{1}{32}\\,{e}^{4x}(8{x}^{2}-4x+1)+C\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{C_1}{2}.$" #edb/ref 17592186045417] [17592186070031 #edb/ref 1065 901 #edb/ref 17592186045417] [17592186070031 #edb/ref 1066 #uuid "35a2eb7b-569b-5939-bcc0-2261596617e8" #edb/ref 17592186045417] [17592186070031 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186247495 #edb/ref 1080 "2{e}^{2}-1" #edb/ref 17592186045417] [17592186247495 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247495 #edb/ref 1083 #uuid "082f5ffa-db8f-5b86-9f1f-66bec8888277" #edb/ref 17592186045417] [17592186247869 #edb/ref 1080 "\\frac{{e}^{2}+2}{{ln}^{2}⁡3}" #edb/ref 17592186045417] [17592186247869 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247869 #edb/ref 1083 #uuid "312a7284-86a2-58d1-925a-aae469b9cc31" #edb/ref 17592186045417] [17592186248052 #edb/ref 1080 "\\frac{1-2e}{{ln}^{2}⁡3}" #edb/ref 17592186045417] [17592186248052 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248052 #edb/ref 1083 #uuid "4646f294-569b-5c9a-8e3f-8b4bffc32dd4" #edb/ref 17592186045417] [17592186248654 #edb/ref 1080 "\\frac{{e}^{2}-1}{{ln}^{2}⁡3}" #edb/ref 17592186045417] [17592186248654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248654 #edb/ref 1083 #uuid "8a1ab61f-f876-54ff-ac9a-719572398e93" #edb/ref 17592186045417] [17592186248988 #edb/ref 1080 "8e" #edb/ref 17592186045417] [17592186248988 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248988 #edb/ref 1083 #uuid "aed8ce21-2fef-51ea-932a-bf3d76234eac" #edb/ref 17592186045417] [17592186249928 #edb/ref 1075 #edb/ref 17592186247495 #edb/ref 17592186045417] [17592186249928 #edb/ref 1075 #edb/ref 17592186247869 #edb/ref 17592186045417] [17592186249928 #edb/ref 1075 #edb/ref 17592186248052 #edb/ref 17592186045417] [17592186249928 #edb/ref 1075 #edb/ref 17592186248654 #edb/ref 17592186045417] [17592186249928 #edb/ref 1075 #edb/ref 17592186248988 #edb/ref 17592186045417] [17592186249928 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249928 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249928 #edb/ref 1078 #edb/ref 17592186248654 #edb/ref 17592186045417] [17592186249928 #edb/ref 1079 #uuid "90297971-15bc-5633-a065-ce4100255f03" #edb/ref 17592186045417] [17592186250319 #edb/ref 1068 #edb/ref 17592186249928 #edb/ref 17592186045417] [17592186250319 #edb/ref 1069 "q-114900" #edb/ref 17592186045417] [17592186250319 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250319 #edb/ref 1071 "Evaluate ${\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250319 #edb/ref 1072 #uuid "dca36867-5a6f-51bd-9e64-ad043dde12a1" #edb/ref 17592186045417] [17592186250319 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=4x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 4x\\,\\text{d}x=2{x}^{2}.\\end{aligned}\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(2{x}^{2})-\\int (2{x}^{2})(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}\\int x{log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{log}_{3}⁡(x)\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{log}_{3}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡x)(\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{1}{2\\operatorname{ln}⁡3}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}(\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D) \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{2{x}^{2}{log}_{3}⁡x}{\\operatorname{ln}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{2{x}^{2}{ln}^{2}⁡x}{{ln}^{2}⁡3}-\\frac{2{x}^{2}\\operatorname{ln}⁡x}{{ln}^{2}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{4D}{\\operatorname{ln}⁡3}.$ \n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)]}_{1}^{e} \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡e-2\\operatorname{ln}⁡e+1)-\\frac{{1}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡1-2\\operatorname{ln}⁡1+1) \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2-2+1)-\\frac{1}{{ln}^{2}⁡3}(0-0+1) \\\\  & =\\frac{{e}^{2}-1}{{ln}^{2}⁡3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186319448 #edb/ref 1080 "5{e}^{3}-2" #edb/ref 17592186045417] [17592186319448 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319448 #edb/ref 1083 #uuid "14560af1-da74-5f36-a18b-b748d25b48a9" #edb/ref 17592186045417] [17592186319719 #edb/ref 1080 "\\frac{3{e}^{4}-3{e}^{2}}{4}" #edb/ref 17592186045417] [17592186319719 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319719 #edb/ref 1083 #uuid "6b075ced-5a58-52b1-9238-36dc27c2ec56" #edb/ref 17592186045417] [17592186319741 #edb/ref 1080 "e-2" #edb/ref 17592186045