0531 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320531 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320531 #edb/ref 1078 #edb/ref 17592186319448 #edb/ref 17592186045417] [17592186320531 #edb/ref 1079 #uuid "b77a2913-0af3-5bc9-8b65-91a3fcf636d6" #edb/ref 17592186045417] [17592186320668 #edb/ref 1075 #edb/ref 17592186319786 #edb/ref 17592186045417] [17592186320668 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320668 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320668 #edb/ref 1078 #edb/ref 17592186319786 #edb/ref 17592186045417] [17592186320668 #edb/ref 1079 #uuid "f0269145-0ae9-55e4-a07c-12dcf8ceee64" #edb/ref 17592186045417] [17592186320933 #edb/ref 1068 #edb/ref 17592186320187 #edb/ref 17592186045417] [17592186320933 #edb/ref 1069 "q-351983" #edb/ref 17592186045417] [17592186320933 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320933 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320933 #edb/ref 1072 #uuid "1a2f1472-983a-5988-9015-40ac8b729fa5" #edb/ref 17592186045417] [17592186320933 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}=3{e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int 3{e}^{2t+2}\\,\\text{d}t=\\frac{3}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2})(\\frac{3}{2}{e}^{2t+2})-\\int (\\frac{3}{2}{e}^{2t+2})(2t)\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int t{e}^{2t+2}\\,\\text{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+2}\\,\\text{d}t=\\frac{1}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{1}{2}{e}^{2t+2})-\\int (\\frac{1}{2}{e}^{2t+2})(1)\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{2}\\int {e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3(\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D) \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2}+C,\\end{aligned}\n$$\n\nwhere $C=-3D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =(\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2})\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}({1}^{2}){e}^{2(1)+2}-\\frac{3}{2}(1){e}^{2(1)+2}+\\frac{3}{4}{e}^{2(1)+2})-(\\frac{3}{2}({0}^{2}){e}^{2(0)+2}-\\frac{3}{2}(0){e}^{2(0)+2}+\\frac{3}{4}{e}^{2(0)+2}) \\\\  & =\\frac{3}{4}{e}^{4}-\\frac{3}{4}{e}^{2} \\\\  & =\\frac{3{e}^{4}-3{e}^{2}}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186320934 #edb/ref 1068 #edb/ref 17592186320668 #edb/ref 17592186045417] [17592186320934 #edb/ref 1069 "q-351991" #edb/ref 17592186045417] [17592186320934 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320934 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320934 #edb/ref 1072 #uuid "e235b03c-6338-5aac-b78a-cee6da78b778" #edb/ref 17592186045417] [17592186320934 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+3\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+3)(\\frac{{e}^{2y-1}}{2})-\\int (\\frac{{e}^{2y-1}}{2})(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y-1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)(\\frac{{e}^{2y-1}}{2})-\\int (\\frac{{e}^{2y-1}}{2})(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{1}{2}\\int {e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-(\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D) \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\frac{y\\,{e}^{2y-1}}{2}+\\frac{{e}^{2y-1}}{4}-D \\\\  & =\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & ={[\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)]}_{1}^{2} \\\\  & =(\\frac{{e}^{2(2)-1}}{4}(2(2)^{2}-2(2)+7))-(\\frac{{e}^{2(1)-1}}{4}(2(1)^{2}-2(1)+7)) \\\\  & =\\frac{{e}^{3}}{4}(8-4+7)-\\frac{e}{4}(2-2+7) \\\\  & =\\frac{11{e}^{3}}{4}-\\frac{7e}{4} \\\\  & =\\frac{11{e}^{3}-7e}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186320935 #edb/ref 1068 #edb/ref 17592186320497 #edb/ref 17592186045417] [17592186320935 #edb/ref 1069 "q-351994" #edb/ref 17592186045417] [17592186320935 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320935 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320935 #edb/ref 1072 #uuid "ddd7fba2-ad87-5331-9a58-1b0e4fa091f2" #edb/ref 17592186045417] [17592186320935 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+4\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+4)(\\frac{{e}^{2y+1}}{2})-\\int (\\frac{{e}^{2y+1}}{2})(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y+1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)(\\frac{{e}^{2y+1}}{2})-\\int (\\frac{{e}^{2y+1}}{2})(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{1}{2}\\int {e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-(\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D) \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\frac{y\\,{e}^{2y+1}}{2}+\\frac{{e}^{2y+1}}{4}-D \\\\  & =\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & ={[\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)]}_{0}^{2} \\\\  & =(\\frac{{e}^{2(2)+1}}{4}(2(2)^{2}-2(2)+9))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+9)) \\\\  & =\\frac{{e}^{5}}{4}(8-4+9)-\\frac{e}{4}(0-0+9) \\\\  & =\\frac{13{e}^{5}}{4}-\\frac{9e}{4} \\\\  & =\\frac{13{e}^{5}-9e}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186320945 #edb/ref 1068 #edb/ref 17592186320392 #edb/ref 17592186045417] [17592186320945 #edb/ref 1069 "q-352040" #edb/ref 17592186045417] [17592186320945 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320945 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/3}^{e/3}3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320945 #edb/ref 1072 #uuid "c1d37f39-dd10-54e5-8b85-a29e10f1a31c" #edb/ref 17592186045417] [17592186320945 #edb/ref 1074 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(3x))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(3x)}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=3 & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 3\\,\\text{d}x=3x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡(3x))^{2}(3x)-\\int (3x)(\\frac{2\\operatorname{ln}⁡(3x)}{x})\\,\\text{d}x \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=6 & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 6\\,\\text{d}x=6x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)(6x)-\\int (6x)(\\frac{1}{x})\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-\\int 6\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-6x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =3x(\\operatorname{ln}⁡(3x))^{2}-\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-(6x\\operatorname{ln}⁡(3x)-6x+D) \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-6x\\operatorname{ln}⁡(3x)+6x-D \\\\  & =3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}3(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)]}_{1/3}^{e/3} \\\\  & =[3(\\frac{e}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+2)]-[3(\\frac{1}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+2)] \\\\  & =[e((\\operatorname{ln}⁡e)^{2}-2\\operatorname{ln}⁡e+2)]-[1((\\operatorname{ln}⁡1)^{2}-2\\operatorname{ln}⁡1+2)] \\\\  & =[e(1-2+2)]-[1(0-0+2)] \\\\  & =e-2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186320947 #edb/ref 1068 #edb/ref 17592186320531 #edb/ref 17592186045417] [17592186320947 #edb/ref 1069 "q-352056" #edb/ref 17592186045417] [17592186320947 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320947 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{e-1}27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320947 #edb/ref 1072 #uuid "4d3bd2be-c388-5990-aa44-fdfa96c596f9" #edb/ref 17592186045417] [17592186320947 #edb/ref 1074 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(x+1))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(x+1)}{x+1}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=27(x+1)^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 27(x+1)^{2}\\,\\text{d}x=9(x+1)^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡(x+1))}^{2}(9(x+1)^{3})-\\int (9(x+1)^{3})(\\frac{2\\operatorname{ln}⁡(x+1)}{x+1})\\,\\text{d}x \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x+1) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x+1}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=(x+1)^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int (x+1)^{2}\\,\\text{d}x=\\frac{(x+1)^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x+1)(\\frac{(x+1)^{3}}{3})-\\int (\\frac{(x+1)^{3}}{3})(\\frac{1}{x+1})\\,\\text{d}x \\\\  & =\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{1}{3}\\int (x+1)^{2}\\,\\text{d}x \\\\  & =\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{(x+1)^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18(\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{(x+1)^{3}}{9}+D) \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-6(x+1)^{3}\\operatorname{ln}⁡(x+1)+2(x+1)^{3}-18D \\\\  & =(x+1)^{3}(9{(\\operatorname{ln}⁡(x+1))}^{2}-6\\operatorname{ln}⁡(x+1)+2)+C,\\end{aligned}\n$$\n\nwhere $C=-18D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{e-1}27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\text{d}x & ={[(x+1)^{3}(9{(\\operatorname{ln}⁡(x+1))}^{2}-6\\operatorname{ln}⁡(x+1)+2)]}_{0}^{e-1} \\\\  & =[{e}^{3}(9{(\\operatorname{ln}⁡e)}^{2}-6\\operatorname{ln}⁡e+2)]-[{1}^{3}(9{(\\operatorname{ln}⁡1)}^{2}-6\\operatorname{ln}⁡1+2)] \\\\  & =[{e}^{3}(9-6+2)]-2 \\\\  & =5{e}^{3}-2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186330227 #edb/ref 1080 "-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{3}{8}\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x" #edb/ref 17592186045417] [17592186330227 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330227 #edb/ref 1083 #uuid "2049d209-f71d-5036-a5ed-1c707b8cca2d" #edb/ref 17592186045417] [17592186330322 #edb/ref 1080 "\\frac{\\operatorname{cos}⁡(4x)}{3}+\\frac{5}{3}\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x" #edb/ref 17592186045417] [17592186330322 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330322 #edb/ref 1083 #uuid "2a1e5edf-0eb9-5389-987f-0ab7fb0a9f0e" #edb/ref 17592186045417] [17592186330609 #edb/ref 1080 "-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{8}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x" #edb/ref 17592186045417] [17592186330609 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186330609 #edb/ref 1083 #uuid "498eeb73-48b5-5b64-8c4a-7b75c33fa56e