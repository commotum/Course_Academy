#edb/ref 17592186045417] [17592186546952 #edb/ref 1075 #edb/ref 17592186546745 #edb/ref 17592186045417] [17592186546952 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546952 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546952 #edb/ref 1078 #edb/ref 17592186546457 #edb/ref 17592186045417] [17592186546952 #edb/ref 1079 #uuid "f3718fae-c042-5c2d-a11b-debd358108e7" #edb/ref 17592186045417] [17592186546978 #edb/ref 1068 #edb/ref 17592186546861 #edb/ref 17592186045417] [17592186546978 #edb/ref 1069 "q-114887" #edb/ref 17592186045417] [17592186546978 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186546978 #edb/ref 1071 "Evaluate ${\\int }_{1}^{e}({log}_{2}⁡x)^{2}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186546978 #edb/ref 1072 #uuid "2441fae2-b285-52be-9809-5b0ff2ea594e" #edb/ref 17592186045417] [17592186546978 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{2}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{2}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{2}⁡x)}^{2}(x)-\\int (x)(\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =x{({log}_{2}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡2}\\int {log}_{2}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{2}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{2}⁡x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{2}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{2}⁡x)(x)-\\int (x)(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =x{log}_{2}⁡x-\\frac{1}{\\operatorname{ln}⁡2}\\int \\,\\text{d}x \\\\  & =x{log}_{2}⁡x-\\frac{x}{\\operatorname{ln}⁡2}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{2}⁡x)^{2}\\,\\text{d}x & =x{({log}_{2}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡2}(x{log}_{2}⁡x-\\frac{x}{\\operatorname{ln}⁡2}+D) \\\\  & =x{({log}_{2}⁡x)}^{2}-\\frac{2x{log}_{2}⁡x}{\\operatorname{ln}⁡2}+\\frac{2x}{{ln}^{2}⁡2}+C \\\\  & =\\frac{x{ln}^{2}⁡x}{{ln}^{2}⁡2}-\\frac{2x\\operatorname{ln}⁡x}{{ln}^{2}⁡2}+\\frac{2x}{{ln}^{2}⁡2}+C \\\\  & =\\frac{x}{{ln}^{2}⁡2}({ln}^{2}⁡x-2\\operatorname{ln}⁡x+2)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡2}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}({log}_{2}⁡x)^{2}\\,\\text{d}x & ={[\\frac{x}{{ln}^{2}⁡2}({ln}^{2}⁡x-2\\operatorname{ln}⁡x+2)]}_{1}^{e} \\\\  & =\\frac{e}{{ln}^{2}⁡2}({ln}^{2}⁡e-2\\operatorname{ln}⁡e+2)-\\frac{1}{{ln}^{2}⁡2}({ln}^{2}⁡1-2\\operatorname{ln}⁡1+2) \\\\  & =\\frac{e}{{ln}^{2}⁡2}-\\frac{2}{{ln}^{2}⁡2} \\\\  & =\\frac{e-2}{{ln}^{2}⁡2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186546981 #edb/ref 1068 #edb/ref 17592186546843 #edb/ref 17592186045417] [17592186546981 #edb/ref 1069 "q-114874" #edb/ref 17592186045417] [17592186546981 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186546981 #edb/ref 1071 "Evaluate the integral ${\\int }_{0}^{\\pi }({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186546981 #edb/ref 1072 #uuid "29a95d8e-b457-570f-bf3b-6c486e09dbc5" #edb/ref 17592186045417] [17592186546981 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+1)(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(2x)\\,\\text{d}x \\\\  & =({x}^{2}+1)\\operatorname{sin}⁡x-2\\int x\\operatorname{sin}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x & \\,⟹\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(1)dx \\\\  & =-x\\operatorname{cos}⁡x+\\int \\operatorname{cos}⁡x\\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int ({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x & =({x}^{2}+1)\\operatorname{sin}⁡x-2\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =({x}^{2}+1)\\operatorname{sin}⁡x-2(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =({x}^{2}+1)\\operatorname{sin}⁡x+2x\\operatorname{cos}⁡x-2\\operatorname{sin}⁡x+C\\end{aligned}\n$$\n\nwhere $C=-2D.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x & ={[({x}^{2}+1)\\operatorname{sin}⁡x+2x\\operatorname{cos}⁡x-2\\operatorname{sin}⁡x]}_{0}^{\\pi } \\\\  & =({\\pi }^{2}+1)\\operatorname{sin}⁡\\pi +2\\pi \\operatorname{cos}⁡\\pi -2\\operatorname{sin}⁡\\pi -(({0}^{2}+1)\\operatorname{sin}⁡0+2\\cdot 0\\cdot \\operatorname{cos}⁡0-2\\operatorname{sin}⁡0) \\\\  & =({\\pi }^{2}+1)\\cdot 0+2\\pi (-1)-2\\cdot 0-0 \\\\  & =-2\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186546984 #edb/ref 1068 #edb/ref 17592186546917 #edb/ref 17592186045417] [17592186546984 #edb/ref 1069 "q-114869" #edb/ref 17592186045417] [17592186546984 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186546984 #edb/ref 1071 "$\\int {x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186546984 #edb/ref 1072 #uuid "2f4365a0-c1aa-5cdc-8199-72e9694e40fc" #edb/ref 17592186045417] [17592186546984 #edb/ref 1074 "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2})(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(2x)\\,\\text{d}x \\\\  & =\\frac{{x}^{2}\\operatorname{sin}⁡(2x)}{2}-\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547038 #edb/ref 1068 #edb/ref 17592186546836 #edb/ref 17592186045417] [17592186547038 #edb/ref 1069 "q-12701" #edb/ref 17592186045417] [17592186547038 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547038 #edb/ref 1071 "Calculate the integral $\\int ({x}^{2}+3x)\\operatorname{sin}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186547038 #edb/ref 1072 #uuid "a2a087e4-737f-55e1-b912-34c295e29547" #edb/ref 17592186045417] [17592186547038 #edb/ref 1074 "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+3x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x+3 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({x}^{2}+3x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+3x)(-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))(2x+3)\\,\\text{d}x \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2\\int x\\operatorname{cos}⁡(x)\\text{d}x+3\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2\\int x\\operatorname{cos}⁡(x)\\text{d}x+3\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{cos}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\text{d}x=\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(x)(\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))(1)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({x}^{2}+3x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2(x\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+D)+3\\operatorname{sin}⁡(x) \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2x\\operatorname{sin}⁡(x)+2\\operatorname{cos}⁡(x)+C+3\\operatorname{sin}⁡(x) \\\\  & =(-{x}^{2}-3x+2)\\operatorname{cos}⁡(x)+(2x+3)\\operatorname{sin}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C=2D.$" #edb/ref 17592186045417] [17592186547044 #edb/ref 1068 #edb/ref 17592186546944 #edb/ref 17592186045417] [17592186547044 #edb/ref 1069 "q-14739" #edb/ref 17592186045417] [17592186547044 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547044 #edb/ref 1071 "Calculate the integral $\\int (3{x}^{2}+2){e}^{3x}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186547044 #edb/ref 1072 #uuid "b68d5307-5a40-5cd7-a13f-e872bf3c3818" #edb/ref 17592186045417] [17592186547044 #edb/ref 1074 "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}+2\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int (3{x}^{2}+2){e}^{3x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2}+2)(\\frac{{e}^{3x}}{3})-\\int (\\frac{{e}^{3x}}{3})(6x)\\,\\text{d}x \\\\  & =\\frac{(3{x}^{2}+2){e}^{3x}}{3}-\\frac{6}{3}\\int x{e}^{3x}\\,\\text{d}x \\\\  & =\\frac{(3{x}^{2}+2){e}^{3x}}{3}-2\\int x{e}^{3x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{e}^{3x}\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{3x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(\\frac{{e}^{3x}}{3})-\\int (\\frac{{e}^{3x}}{3})(1)\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{1}{3}\\int {e}^{3x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{{e}^{3x}}{9}+D \\\\  & =\\frac{{e}^{3x}}{9}(3x-1)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int (3{x}^{2}+2){e}^{3x}\\,\\text{d}x & =\\frac{(3{x}^{2}+2){e}^{3x}}{3}-2(\\frac{{e}^{3x}}{9}(3x-1)+D) \\\\  & =\\frac{(3{x}^{2}+2){e}^{3x}}{3}-\\frac{2{e}^{3x}}{9}(3x-1)-2D \\\\  & =\\frac{{e}^{3x}}{9}(3(3{x}^{2}+2)-2(3x-1))-2D \\\\  & =\\frac{{e}^{3x}}{9}(9{x}^{2}-6x+8)+C,\\end{aligned}\n$$\n\nwhere $C=-2D.$" #edb/ref 17592186045417] [17592186547046 #edb/ref 1068 #edb/ref 17592186546952 #edb/ref 17592186045417] [17592186547046 #edb/ref 1069 "q-49929" #edb/ref 17592186045417] [17592186547046 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186547046 #edb/ref 1071 "Evaluate the integral ${\\int }_{0}^{1}4({z}^{2}+1){e}^{2z}\\,\\text{d}z.$" #edb/ref 17592186045417] [17592186547046 #edb/ref 1072 #uuid "b7ebc1ef-47dd-5be6-aa58-7b0c8c511acd" #edb/ref 17592186045417] [17592186547046 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={z}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}z}=2z, \\\\ \\frac{\\text{d}v}{\\text{d}z}=4{e}^{2z}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z=4\\int {e}^{2z}\\,\\text{d}z=2{e}^{2z}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 4({z}^{2}+1){e}^{2z}\\,\\text{d}z & =\\int u\\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}z}\\,\\text{d}z \\\\  & =({z}^{2}+1)(2{e}^{2z})-\\int (2{e}^{2z})(2z)\\,\\text{d}z \\\\  & =2({z}^{2}+1){e}^{2z}-4\\int z{e}^{2z}\\,\\text{d}z.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int z{e}^{2z}\\text{d}z.$ We take\n\n$$\n\\begin{aligned}u=z\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}z}=1 \\\\ \\frac{\\text{d}v}{\\text{d}z}={e}^{2z}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z=\\frac{{e}^{2z}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int z{e}^{2z}\\,\\text{d}z & =\\int u\\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}z}\\,\\text{d}z \\\\  & =(z)(\\frac{{e}^{2z}}{2})-\\int (\\frac{{e}^{2z}}{2})(1)\\,\\text{d}z \\\\  & =\\frac{z{e}^{2z}}{2}-\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}z \\\\  & =\\frac{z{e}^{2z}}{2}-\\frac{{e}^{2z}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int 4({z}^{2}+1){e}^{2z}\\,\\text{d}z & =2({z}^{2}+1){e}^{2z}-4\\int z{e}^{2z}\\,\\text{d}z \\\\  & =2({z}^{2}+1){e}^{2z}-4(\\frac{z{e}^{2z}}{2}-\\frac{{e}^{2z}}{4}+D) \\\\  & =2({z}^{2}+1){e}^{2z}-2z{e}^{2z}+{e}^{2z}+C,\\end{aligned}\n$$\n\nwhere $C=-4D.$ \n\nFinally, then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4({z}^{2}+1){e}^{2z}\\,\\text{d}z & =(2({z}^{2}+1){e}^{2z}-2z{e}^{2z}+{e}^{2z}){|}_{0}^{1} \\\\  & =(2({1}^{2}+1){(e)}^{2}-2(1)^{2}{e}^{2}+{e}^{2})-(2(0+1){e}^{0}-2\\cdot 0\\cdot {e}^{0}+{e}^{0}) \\\\  & =3{e}^{2}-3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547050 #edb/ref 1068 #edb/ref 17592186546915 #edb/ref 17592186045417] [17592186547050 #edb/ref 1069 "q-3395" #edb/ref 17592186045417] [17592186547050 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547050 #edb/ref 1071 "Calculate the integral $\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186547050 #edb/ref 1072 #uuid "c07f9c82-279d-54bf-a7cc-232522a75290" #edb/ref 17592186045417] [17592186547050 #edb/ref 1074 "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+2x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x+2 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+2x)(\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))(2x+2)\\,\\text{d}x \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2\\int x\\operatorname{sin}⁡(x)\\text{d}x-2\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2\\int x\\operatorname{sin}⁡(x)\\text{d}x+2\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(x)(-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))(1)\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡(x)+\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2(-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D)+2\\operatorname{cos}⁡(x) \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)+2x\\operatorname{cos}⁡(x)-2\\operatorname{sin}⁡(x)+C+2\\operatorname{cos}⁡(x) \\\\  & =({x}^{2}+2x-2)\\operatorname{sin}⁡(x)+2(x+1)\\operatorname{cos}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C=-2D.$" #edb/ref 17592186045417] [17592186547073 #edb/ref 1068 #edb/ref 17592186546856 #edb/ref 17592186045417] [17592186547073 #edb/ref 1069 "q-50230" #edb/ref 17592186045417] [17592186547073 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547073 #edb/ref 1071 "$\\int 4{x}^{2}{(\\operatorname{ln}⁡{x}^{2})}^{2}\\,\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186547073 #edb/ref 1072 #uuid "eec4d3ca-fb39-5950-ae42-a7772eee1331" #edb/ref 17592186045417] [17592186547073 #edb/ref 1074 "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={(\\operatorname{ln}⁡{x}^{2})}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{ln}⁡{x}^{2}\\cdot \\frac{1}{{x}^{2}}\\cdot 2x=\\frac{4\\operatorname{ln}⁡{x}^{2}}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=4{x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 4{x}^{2}\\,\\,\\text{d}x=\\frac{4{x}^{3}}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{(\\operatorname{ln}⁡{x}^{2})}^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡{x}^{2})}^{2}(\\frac{4{x}^{3}}{3})-\\int (\\frac{4{x}^{3}}{3})(\\frac{4\\operatorname{ln}⁡{x}^{2}}{x})\\,\\text{d}x \\\\  & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16}{3}\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{2})\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡({x}^{2}))(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{2}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{(\\operatorname{ln}⁡{x}^{2})}^{2}\\,\\text{d}x & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16}{3}(\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2{x}^{3}}{9}+D) \\\\  & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16{x}^{3}\\operatorname{ln}⁡({x}^{2})}{9}+\\frac{32{x}^{3}}{27}-\\frac{16D}{3} \\\\  & =\\frac{4{x}^{3}}{27}(9{(\\operatorname{ln}⁡{x}^{2})}^{2}-12\\operatorname{ln}⁡{x}^{2}+8)+C,\\end{aligned}\n$$\n\nWhere, $C=-\\frac{16D}{3}.$" #edb/ref 17592186045417] [17592186547115 #edb/ref 1062 #uuid "64a57aef-d6e9-5810-96e6-0a4d5d4de0bb" #edb/ref 17592186045417] [17592186547115 #edb/ref 1063 #edb/ref 17592186320955 #edb/ref 17592186045417] [17592186547135 #edb/ref 1058 #edb/ref 17592186547150 #edb/ref 17592186045417] [17592186547135 #edb/ref 1062 #uuid "a4bbd805-d804-517d-a8e5-32021f33212a" #edb/ref 17592186045417] [17592186547135 #edb/ref 1063 #edb/ref 17592186547030 #edb/ref 17592186045417] [17592186547138 #edb/ref 1058 #edb/ref 17592186547135 #edb/ref 17592186045417] [17592186547138 #edb/ref 1062 #uuid "aeb6cf6a-16c5-5b68-852d-5618fe48037e" #edb/ref 17592186045417] [17592186547138 #edb/ref 1063 #edb/ref 17592186250314 #edb/ref 17592186045417] [17592186547150 #edb/ref 1058 #edb/ref 17592186547115 #edb/ref 17592186045417] [17592186547150 #edb/ref 1062 #uuid "c9eb948f-4211-54cf-b715-46e2e89288c3" #edb/ref 17592186045417] [17592186547150 #edb/ref 1063 #edb/ref 17592186320942 #edb/ref 17592186045417] [17592186547156 #edb/ref 1058 #edb/ref 17592186547138 #edb/ref 17592186045417] [17592186547156 #edb/ref 1062 #uuid "d6dd1fb5-7500-53b2-92b3-d30c54396c8f" #edb/ref 17592186045417] [17592186547156 #edb/ref 1063 #edb/ref 17592186547049 #edb/ref 17592186045417]}
