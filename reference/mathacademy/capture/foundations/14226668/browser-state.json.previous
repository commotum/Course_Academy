jx-texclass=\"NONE\">⁡</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><msup><mi>e</mi><mn>3</mn></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>9</mn><mo>−</mo><mn>6</mn><mo>+</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>5</mn><msup><mi>e</mi><mn>3</mn></msup><mo>−</mo><mn>2</mn></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
