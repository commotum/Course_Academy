alse\">)</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>+</mo><mn>2</mn><mo>⋅</mo><mn>0</mn><mo>⋅</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><msup><mi>π</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>0</mn><mo>+</mo><mn>2</mn><mi>π</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mo>⋅</mo><mn>0</mn><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>π</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
