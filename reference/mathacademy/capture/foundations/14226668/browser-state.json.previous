n>2</mn><mi>z</mi></mrow></msup><mo>−</mo><mn>2</mn><mi>z</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>z</mi></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>z</mi></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">|</mo></mrow><mn>0</mn><mn>1</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>2</mn><mo stretchy=\"false\">(</mo><msup><mn>1</mn><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>e</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo stretchy=\"false\">(</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>2</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msup><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>⋅</mo><mn>0</mn><mo>⋅</mo><msup><mi>e</mi><mn>0</mn></msup></mrow><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><msup><mi>e</mi><mn>0</mn></msup></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
