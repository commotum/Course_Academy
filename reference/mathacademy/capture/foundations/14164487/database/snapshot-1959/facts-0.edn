96 #edb/ref 17592186045417] [17592186064429 #edb/ref 1049 #edb/ref 17592186050299 #edb/ref 17592186045417] [17592186064429 #edb/ref 1050 1080.0 #edb/ref 17592186045436] [17592186064429 #edb/ref 1053 #uuid "22d1805e-71b9-5243-96d1-5454b5d68ac6" #edb/ref 17592186045417] [17592186064865 #edb/ref 1068 #edb/ref 17592186063246 #edb/ref 17592186045417] [17592186064865 #edb/ref 1069 "q-49458" #edb/ref 17592186045417] [17592186064865 #edb/ref 1071 "Calculate $\\displaystyle \\int\\frac{4x^{2} - 17x + 4}{x - 4}dx$." #edb/ref 17592186045417] [17592186064865 #edb/ref 1072 #uuid "ea9dfa89-06eb-5760-a821-cda00c20e204" #edb/ref 17592186045417] [17592186065096 #edb/ref 1058 #edb/ref 17592186065102 #edb/ref 17592186045417] [17592186065096 #edb/ref 1061 1707 #edb/ref 17592186045417] [17592186065096 #edb/ref 1062 #uuid "83b3796b-b6b4-589d-a5b3-e83dd146da2d" #edb/ref 17592186045417] [17592186065096 #edb/ref 1063 #edb/ref 17592186065438 #edb/ref 17592186045417] [17592186065102 #edb/ref 1058 #edb/ref 17592186065103 #edb/ref 17592186045417] [17592186065102 #edb/ref 1061 1708 #edb/ref 17592186045417] [17592186065102 #edb/ref 1062 #uuid "4eb00783-0e9f-5f56-a7c2-2671083182b4" #edb/ref 17592186045417] [17592186065102 #edb/ref 1063 #edb/ref 17592186064235 #edb/ref 17592186045417] [17592186065103 #edb/ref 1058 #edb/ref 17592186065113 #edb/ref 17592186045417] [17592186065103 #edb/ref 1061 1711 #edb/ref 17592186045417] [17592186065103 #edb/ref 1062 #uuid "8a270b04-626b-5faf-b8e7-a60d62b9d521" #edb/ref 17592186045417] [17592186065103 #edb/ref 1063 #edb/ref 17592186064236 #edb/ref 17592186045417] [17592186065113 #edb/ref 1061 1714 #edb/ref 17592186045417] [17592186065113 #edb/ref 1062 #uuid "5f0e5f61-e451-55c5-a8ca-ae1e6b3c2676" #edb/ref 17592186045417] [17592186065113 #edb/ref 1063 #edb/ref 17592186064244 #edb/ref 17592186045417] [17592186065438 #edb/ref 1064 "How do we calculate $\\displaystyle \\int\\dfrac{3x+2}{x+2}\\,\\textrm d x\\,?$\n\nWe need to write the integrand so that it's something we can integrate. One way to do this is to divide $3x+2$ by $x+2$ using polynomial or synthetic division. We'll use synthetic division because it's faster. \n\nTo rewrite $\\dfrac{3x+2}{x+2},$ we complete a synthetic division table.\n\n|  | $x^1$ | $x^0$ |\n| --- | --- | --- |\n| $\\color{red}-2$ | $3$ | $2$ |\n|  | $\\color{gray}\\downarrow$ | $-6$ |\n|  | $3$ | $-4$ |\n\nThis tells us that $\\dfrac{3x+2}{x+2}$ can be decomposed into a quotient and remainder as\n\n$$\n\\dfrac{3x+2}{x+2}= 3 - \\dfrac{4}{x+2}.\n$$\n\nNow, we can integrate the function, which gives\n\n$$\n\\begin{aligned}\\int \\frac{3x+2}{x+2}\\,\\text{d}x & =\\int (3-\\frac{4}{x+2})\\,\\text{d}x \\\\  & =\\int 3\\,\\text{d}x-4\\int \\frac{1}{x+2}\\,\\text{d}x \\\\  & =3x-4\\operatorname{ln}|x+2|+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186065438 #edb/ref 1065 884 #edb/ref 17592186045417] [17592186065438 #edb/ref 1066 #uuid "2437a8a0-d1de-5b85-8577-7e7493c4d520" #edb/ref 17592186045417] [17592186065438 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186247516 #edb/ref 1080 "\\frac{1}{36}(1+2\\operatorname{ln}⁡3)" #edb/ref 17592186045417] [17592186247516 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247516 #edb/ref 1083 #uuid "0a9826cc-221a-58f0-a949-003259d10830" #edb/ref 17592186045417] [17592186247651 #edb/ref 1080 "\\frac{1}{16}(1+5\\operatorname{ln}⁡2)" #edb/ref 17592186045417] [17592186247651 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247651 #edb/ref 1083 #uuid "1935d4e4-d30d-5335-ab50-3b3fa04366e1" #edb/ref 17592186045417] [17592186247959 #edb/ref 1080 "\\frac{1}{25}(5+\\operatorname{ln}⁡5)" #edb/ref 17592186045417] [17592186247959 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247959 #edb/ref 1083 #uuid "3c9aeadf-fded-5a2b-861d-58af4c73c465" #edb/ref 17592186045417] [17592186248185 #edb/ref 1080 "\\frac{1}{16}(3+\\operatorname{ln}⁡3)" #edb/ref 17592186045417] [17592186248185 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248185 #edb/ref 1083 #uuid "54ac800d-c455-530d-b963-3aea2be7c145" #edb/ref 17592186045417] [17592186248379 #edb/ref 1080 "\\frac{1}{36}(1+4\\operatorname{ln}⁡2)" #edb/ref 17592186045417] [17592186248379 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248379 #edb/ref 1083 #uuid "6b902fe9-3b07-57e2-870c-2a793e643e2d" #edb/ref 17592186045417] [17592186249958 #edb/ref 1075 #edb/ref 17592186247516 #edb/ref 17592186045417] [17592186249958 #edb/ref 1075 #edb/ref 17592186247651 #edb/ref 17592186045417] [17592186249958 #edb/ref 1075 #edb/ref 17592186247959 #edb/ref 17592186045417] [17592186249958 #edb/ref 1075 #edb/ref 17592186248185 #edb/ref 17592186045417] [17592186249958 #edb/ref 1075 #edb/ref 17592186248379 #edb/ref 17592186045417] [17592186249958 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249958 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249958 #edb/ref 1078 #edb/ref 17592186248379 #edb/ref 17592186045417] [17592186249958 #edb/ref 1079 #uuid "a3226bde-c895-54e8-98cf-b5b2df79f6fb" #edb/ref 17592186045417] [17592186250317 #edb/ref 1068 #edb/ref 17592186249958 #edb/ref 17592186045417] [17592186250317 #edb/ref 1069 "q-114896" #edb/ref 17592186045417] [17592186250317 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250317 #edb/ref 1071 "${\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186250317 #edb/ref 1072 #uuid "462b058c-0216-5b9a-aa39-6bb6d7bc768e" #edb/ref 17592186045417] [17592186250317 #edb/ref 1074 "First, we pull out the factor of $6$ from the denominator:\n\n$$\n\\begin{aligned}{\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x & ={\\int }_{-1/12}^{0}\\frac{2x+1}{6(x+\\frac{1}{6})}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{-1/12}^{0}\\frac{2x+1}{(x+\\frac{1}{6})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -\\frac{1}{6} & 2 & 1 \\\\  & ↓ & -\\frac{1}{3} \\\\  & 2 & \\frac{2}{3}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{2x+1}{(x+\\frac{1}{6})} & =2+\\frac{(\\frac{2}{3})}{(x+\\frac{1}{6})} \\\\  & =2+\\frac{4}{6x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x & =\\frac{1}{6}{\\int }_{-1/12}^{0}(2+\\frac{4}{6x+1})\\text{d}x \\\\  & =\\frac{1}{6}[2{\\int }_{-1/12}^{0}\\text{d}x+4{\\int }_{-1/12}^{0}\\frac{1}{6x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{6}{[2x+\\frac{4}{6}\\operatorname{ln}⁡|6x+1|]}_{-1/12}^{0} \\\\  & =\\frac{1}{6}{[2x+\\frac{2}{3}\\operatorname{ln}⁡|6x+1|]}_{-1/12}^{0} \\\\  & =\\frac{1}{6}[2(0-(-\\frac{1}{12}))+\\frac{2}{3}(\\operatorname{ln}⁡|6(0)+1|-\\operatorname{ln}⁡|6(-\\frac{1}{12})+1|)] \\\\  & =\\frac{1}{6}[2(\\frac{1}{12})+\\frac{2}{3}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\frac{1}{2}))] \\\\  & =\\frac{1}{6}[\\frac{1}{6}+\\frac{2}{3}\\operatorname{ln}⁡2] \\\\  & =\\frac{1}{36}(1+4\\operatorname{ln}⁡2).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186319866 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186319866 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319866 #edb/ref 1083 #uuid "9eaa259b-afa9-5deb-8159-7c3b66adff9b" #edb/ref 17592186045417] [17592186319919 #edb/ref 1080 "27" #edb/ref 17592186045417] [17592186319919 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319919 #edb/ref 1083 #uuid "adb6b3c7-0cf3-5820-a797-a5dce7bcb453" #edb/ref 17592186045417] [17592186320515 #edb/ref 1075 #edb/ref 17592186319866 #edb/ref 17592186045417] [17592186320515 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320515 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186320515 #edb/ref 1078 #edb/ref 17592186319866 #edb/ref 17592186045417] [17592186320515 #edb/ref 1079 #uuid "aec87038-1d77-52ab-aa