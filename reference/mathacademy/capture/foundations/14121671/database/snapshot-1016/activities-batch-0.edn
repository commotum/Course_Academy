#{[{:activity/first-step {:db/id #edb/ref 17592186116367} :activity/id #uuid "b5ef0f4d-28ef-57bb-a6d8-a44c7baf171f" :activity/scope {:db/id #edb/ref 17592186048233 :topic/id #uuid "8aa7a809-99bd-5db1-b49c-848be170eabe" :topic/math-academy-id 1738} :activity/steps [{:db/id #edb/ref 17592186116367 :step/content {:db/id #edb/ref 17592186116440 :tutorial/content "Many of the known properties of derivatives of scalar functions extend naturally to derivatives of vector functions. \n\nSuppose that $\\mathbf f(t)$ and $\\mathbf g(t)$ are vector-valued functions, $u(t)$ is a scalar function, and $\\alpha$ and $\\mathbf c$ are scalar and vector constants, respectively. \n\nThe **sum and multiple rules** for differentiating vector-valued functions are as follows:\n\n$$\n\\begin{aligned}(f+g)^{'}(t)={f}^{'}(t)+{g}^{'}(t)\\, & \\text{sum rule} \\\\ (\\alpha f)^{'}(t)=\\alpha {f}^{'}(t),\\,(uc)^{'}(t)={u}^{'}(t)c\\, & \\text{constant multiple rules} \\\\ (uf)^{'}(t)={u}^{'}(t)f(t)+u(t){f}^{'}(t)\\, & \\text{scalar function multiple rule}\\end{aligned}\n$$" :tutorial/id #uuid "10b4a11f-6ada-568e-9a43-dbeeeb1826c6" :tutorial/math-academy-id 2143 :tutorial/title "Introduction"} :step/id #uuid "eb0a96a9-97f7-54a8-91fe-e18c9fa61102" :step/math-academy-id 8378 :step/next {:db/id #edb/ref 17592186116370}} {:db/id #edb/ref 17592186116368 :step/content {:db/id #edb/ref 17592186116441 :tutorial/content "The **chain rule** for differentiating vector-valued functions states that\n\n![](images/57/57f880045af93f552c2736659e377c7ac4c6f41f78a2df446f241783f472f8aa.svg)\n\nwhere ![](images/bc/bcf7f1c428a975daf939f469deb8e13c050d912fb5a2548fbb6b60ea6d413a86.svg) is a vector-valued function while ![](images/cd/cd94c3404a0b6460dd11ffac737b2ce09af9f26b21de28ccedf8d028bd6ec38a.svg) is a scalar function." :tutorial/id #uuid "e299896a-b9ca-574f-8c05-ef656d9c5cd2" :tutorial/math-academy-id 2144 :tutorial/title "The Chain Rule for Differentiation"} :step/id #uuid "24ff6243-dc48-530e-9e8c-76468e0f51b7" :step/math-academy-id 8379 :step/next {:db/id #edb/ref 17592186116372}} {:db/id #edb/ref 17592186116369 :step/content {:db/id #edb/ref 17592186116442 :tutorial/content "When working with vector functions, there are two types of products: the dot product and the cross product. So, there are two **product rules** for derivatives:\n\n$$\n\\begin{aligned}(f\\cdot g)^{'}(t)=f(t)\\cdot {g}^{'}(t)+{f}^{'}(t)\\cdot g(t)\\, & \\text{dot product rule} \\\\ (f\\times g)^{'}(t)={f}^{'}(t)\\times g(t)+f(t)\\times {g}^{'}(t)\\, & \\text{cross product rule}\\end{aligned}\n$$\n\n**Watch out!** Remember that the cross product is anticommutative, meaning that $\\mathbf f \\times \\mathbf g = - \\mathbf g \\times \\mathbf f.$ Therefore,\n\n$$\n\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\times \\mathbf g)(t) = -\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf g \\times \\mathbf f)(t).\n$$\n\nWhen applying the cross product rule, the order in which the operations are applied is important." :tutorial/id #uuid "babb1734-198a-5751-b78c-b333b6e38d5e" :tutorial/math-academy-id 2145 :tutorial/title "The Product Rules for Differentiation"} :step/id #uuid "13df4a33-8393-5b6a-a1df-d349deaa17b2" :step/math-academy-id 8380 :step/next {:db/id #edb/ref 17592186116373}} {:db/id #edb/ref 17592186116370 :step/content {:db/id #edb/ref 17592186115390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114970 :question/id #uuid "ce098ff9-2ef1-5483-b057-b3fef12af16d" :question/math-academy-id "e-2477"} :knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186048999}] :knowledge-point/questions [{:db/id #edb/ref 17592186115775} {:db/id #edb/ref 17592186115776} {:db/id #edb/ref 17592186262878} {:db/id #edb/ref 17592186262897} {:db/id #edb/ref 17592186262900} {:db/id #edb/ref 17592186302170} {:db/id #edb/ref 17592186302172} {:db/id #edb/ref 17592186304891} {:db/id #edb/ref 17592186338805} {:db/id #edb/ref 17592186387859} {:db/id #edb/ref 17592186387866}] :knowledge-point/title "Using the Sum and Constant Multiple Rules for Differentiation"} :step/id #uuid "4ac8a89c-dc16-5903-a731-4a3fa01f503f" :step/math-academy-id 8381 :step/next {:db/id #edb/ref 17592186116371}} {:db/id #edb/ref 17592186116371 :step/content {:db/id #edb/ref 17592186115391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114971 :question/id #uuid "3668609c-7f98-53ef-8aa7-6f9c3209dfee" :question/math-academy-id "e-2478"} :knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/questions [{:db/id #edb/ref 17592186115760} {:db/id #edb/ref 17592186115768} {:db/id #edb/ref 17592186262905} {:db/id #edb/ref 17592186262909} {:db/id #edb/ref 17592186262910} {:db/id #edb/ref 17592186262911} {:db/id #edb/ref 17592186262914} {:db/id #edb/ref 17592186338806} {:db/id #edb/ref 17592186338920} {:db/id #edb/ref 17592186338921} {:db/id #edb/ref 17592186387880} {:db/id #edb/ref 17592186393001} {:db/id #edb/ref 17592186393105} {:db/id #edb/ref 17592186393112}] :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"} :step/id #uuid "15461d2a-a63a-5340-8afc-8c7599c24c85" :step/math-academy-id 8382 :step/next {:db/id #edb/ref 17592186116368}} {:db/id #edb/ref 17592186116372 :step/content {:db/id #edb/ref 17592186115392 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114972 :question/id #uuid "cbb15346-028c-59c0-9b20-cd2f408c3bcb" :question/math-academy-id "e-2479"} :knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186115767} {:db/id #edb/ref 17592186115772} {:db/id #edb/ref 17592186262923} {:db/id #edb/ref 17592186262924} {:db/id #edb/ref 17592186302171} {:db/id #edb/ref 17592186304789} {:db/id #edb/ref 17592186304791} {:db/id #edb/ref 17592186305066} {:db/id #edb/ref 17592186373118} {:db/id #edb/ref 17592186387901} {:db/id #edb/ref 17592186387908} {:db/id #edb/ref 17592186393008}] :knowledge-point/title "Using the Chain Rule for Differentiation"} :step/id #uuid "90197991-2635-5dee-8772-2c779a733d8a" :step/math-academy-id 8383 :step/next {:db/id #edb/ref 17592186116369}} {:db/id #edb/ref 17592186116373 :step/content {:db/id #edb/ref 17592186115393 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114973 :question/id #uuid "228ae66f-9dad-5e6d-b405-9fbe62ecb7e9" :question/math-academy-id "e-2480"} :knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048954}] :knowledge-point/questions [{:db/id #edb/ref 17592186115762} {:db/id #edb/ref 17592186115764} {:db/id #edb/ref 17592186262925} {:db/id #edb/ref 17592186262926} {:db/id #edb/ref 17592186262930} {:db/id #edb/ref 17592186302392} {:db/id #edb/ref 17592186302426} {:db/id #edb/ref 17592186302435} {:db/id #edb/ref 17592186308444} {:db/id #edb/ref 17592186308623} {:db/id #edb/ref 17592186387971} {:db/id #edb/ref 17592186390737} {:db/id #edb/ref 17592186390798}] :knowledge-point/title "Using the Product Rules for Differentiation"} :step/id #uuid "2d325e5d-2cb2-5a4d-9ff0-0babe8095a2f" :step/math-academy-id 8384}] :activity/title "Differentiation Rules for Vector-Valued Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115483}] [{:activity/first-step {:db/id #edb/ref 17592186158117} :activity/id #uuid "93123186-af04-50ed-9f1a-970323c9acfd" :activity/scope {:db/id #edb/ref 17592186048681 :topic/id #uuid "b45261a2-56f4-554a-ba13-6946f5dc3f8c" :topic/math-academy-id 2828} :activity/steps [{:db/id #edb/ref 17592186158113 :step/content {:db/id #edb/ref 17592186157284 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157088 :question/id #uuid "35acfa60-3395-5f11-94f9-627499386932" :question/math-academy-id "e-7159"} :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/questions [{:db/id #edb/ref 17592186157764} {:db/id #edb/ref 17592186157786} {:db/id #edb/ref 17592186241012} {:db/id #edb/ref 17592186241013} {:db/id #edb/ref 17592186241015} {:db/id #edb/ref 17592186241129} {:db/id #edb/ref 17592186241130} {:db/id #edb/ref 17592186256652} {:db/id #edb/ref 17592186256677} {:db/id #edb/ref 17592186256702} {:db/id #edb/ref 17592186351174} {:db/id #edb/ref 17592186367198} {:db/id #edb/ref 17592186368561}] :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"} :step/id #uuid "ca424c53-0556-5e18-9bc0-d39fdd10d96b" :step/math-academy-id 26359 :step/next {:db/id #edb/ref 17592186158114}} {:db/id #edb/ref 17592186158114 :step/content {:db/id #edb/ref 17592186157285 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157089 :question/id #uuid "89c94a89-21de-5a4f-a365-85701b2e4ef2" :question/math-academy-id "e-7160"} :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/questions [{:db/id #edb/ref 17592186157767} {:db/id #edb/ref 17592186157789} {:db/id #edb/ref 17592186241016} {:db/id #edb/ref 17592186241018} {:db/id #edb/ref 17592186241020} {:db/id #edb/ref 17592186323767} {:db/id #edb/ref 17592186351176} {:db/id #edb/ref 17592186351367} {:db/id #edb/ref 17592186354499} {:db/id #edb/ref 17592186354500} {:db/id #edb/ref 17592186366857} {:db/id #edb/ref 17592186368798}] :knowledge-point/title "Finding Differences of Sets Given Verbally"} :step/id #uuid "94c5e547-ed98-5f00-a17f-fb87e8db7939" :step/math-academy-id 26360} {:db/id #edb/ref 17592186158117 :step/content {:db/id #edb/ref 17592186158474 :tutorial/content "The **difference** of two sets $A$ and $B,$ denoted by $A \\setminus B$ or $A - B,$ is the set of all elements belonging to $A$ and *not* belonging to $B.$\n\nFor example, consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ We can represent these sets using a Venn diagram, as follows:\n\n![](images/4a/4a2d3be8c64b5527dcb37ac68d99cd1e36009725d0847597c5bbd417bbd5f7ad.png)\n\nThe difference $A \\setminus B$ consists of all the elements that are in $A$ but not $B.$ To represent $A \\setminus B,$ we will shade in all the area that is contained within $A$ but not $B.$\n\n![](images/49/49743d4647817294c2287bc15a496fb5d6c73070ed52cfd8934d1babe93c1b25.png)\n\nThe elements $a$ and $c$ are contained in $A$ but not $B.$ Therefore,\n\n$$\nA \\setminus B = A - B = \\{ a,c \\}.\n$$\n\n**Note:** The difference can be defined using set-builder notation as follows:\n\n$$\nA \\setminus B = A - B = \\{ x \\mid x \\in A \\text { and } x \\notin B \\}\n$$\n\nThe condition \"$x \\in A \\text { and } x \\notin B$\" means that $x$ must belong to $A$ but $x$ must *not* belong to $B.$" :tutorial/id #uuid "48529a2b-cc59-57e8-8624-78fd4339f88c" :tutorial/math-academy-id 4333 :tutorial/title "Introduction"} :step/id #uuid "1e4b9023-ad62-55c8-950f-2d1e0371a65e" :step/math-academy-id 26364 :step/next {:db/id #edb/ref 17592186158122}} {:db/id #edb/ref 17592186158122 :step/content {:db/id #edb/ref 17592186157289 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157093 :question/id #uuid "9e0d2770-a884-558f-becb-a38fe709b2a5" :question/math-academy-id "e-7167"} :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049065}] :knowledge-point/questions [{:db/id #edb/ref 17592186157808} {:db/id #edb/ref 17592186157809} {:db/id #edb/ref 17592186241008} {:db/id #edb/ref 17592186241010} {:db/id #edb/ref 17592186241128} {:db/id #edb/ref 17592186351317} {:db/id #edb/ref 17592186351340} {:db/id #edb/ref 17592186351347} {:db/id #edb/ref 17592186351366} {:db/id #edb/ref 17592186354497} {:db/id #edb/ref 17592186354498}] :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"} :step/id #uuid "46adbc13-f6f2-55a5-861d-63519ad07f7b" :step/math-academy-id 26372 :step/next {:db/id #edb/ref 17592186158129}} {:db/id #edb/ref 17592186158129 :step/content {:db/id #edb/ref 17592186158480 :tutorial/content "Although Venn diagrams can be useful to visualize differences, we do not have to draw a Venn diagram every time we wish to compute a difference.\n\nFor example, let's again consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ This time, we will compute the difference $A \\setminus B$ without using a Venn diagram. We just need to find all the elements that are in $A$ but not $B.$\n\nSo, we will go through the elements of $A$ and check if each element is also in $B.$ Remember that we are looking for elements that are *not* in $B.$\n\n- For the element $a \\in A,$ we have $a \\not\\in B. \\quad \\color{green}\\checkmark$\n\n- For the element $b \\in A,$ we have $b \\in B. \\quad \\color{red}\\times$\n\n- For the element $c \\in A,$ we have $c \\not\\in B. \\quad \\color{green}\\checkmark$\n\nThe elements of $A$ that are not in $B$ are $a$ and $c.$\n\nTherefore, the difference is\n\n$$\nA \\setminus B = A - B = \\{ a,c \\}.\n$$" :tutorial/id #uuid "14afef0e-fec6-5cdf-82c4-98391973df49" :tutorial/math-academy-id 4342 :tutorial/title "Differences Without Venn Diagrams"} :step/id #uuid "2ef8179b-8279-55d0-b781-5afd8ba23248" :step/math-academy-id 26397 :step/next {:db/id #edb/ref 17592186158113}}] :activity/title "The Difference of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157485}] [{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186106673} :activity/id #uuid "e8bbfc2d-b5f4-57c0-9027-1b66b844109b" :activity/scope {:db/id #edb/ref 17592186048819 :topic/id #uuid "c29ac9c3-f2c1-572b-9251-f82101c5a30e" :topic/math-academy-id 1375} :activity/steps [{:db/id #edb/ref 17592186106673 :step/content {:db/id #edb/ref 17592186107090 :tutorial/content "Given a matrix $A,$ an **eigenvector** of $A$ is a *non-zero* vector $\\mathbf{v}$ such that \n\n$$\nA \\mathbf{v} = \\lambda \\mathbf{v}\n$$\n\nfor some scalar $\\lambda \\in \\mathbb{R}.$ The scalar $\\lambda$ is called the **eigenvalue** corresponding to the eigenvector $\\mathbf{v}.$\n\nFor example, consider the matrix \n![](images/63/63e2c65a23a0680412a14084d543b6cc19c0529fd80863b09c99987d309eaa4f.svg) \nand the vector ![](images/b7/b7811b74d8d3075357925864b5be27f57b292dadca9c04d222954baa1e66ba2a.svg) Computing the product $A \\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}2 & 2 \\\\ 2 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 4\\end{aligned}] \\\\  & =(-2)\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =-2v.\\end{aligned}\n$$\n\nWe've discovered that $A {\\color{blue}\\mathbf{v}} = {\\color{red}-2} {\\color{blue}\\mathbf{v}}.$ Therefore,\n\n- the vector ![](images/13/13a28e543647ede7a88b30fb652bd7fba6c9adb8ee3142161a102de947ef2d2a.svg) is an *eigenvector* of $A,$ and\n\n- the scalar $\\color{red}\\lambda=-2$ is the *eigenvalue* corresponding to the eigenvector ${\\color{blue}\\mathbf{v}}.$\n\n**Caution:** Remember that an eigenvector must be a *non-zero* vector. This is very important." :tutorial/id #uuid "1014a8e8-38ce-568b-86d7-22f32ef8f697" :tutorial/math-academy-id 3557 :tutorial/title "Introduction"} :step/id #uuid "9b7139a7-3f19-5d72-857b-7a01a291e46b" :step/math-academy-id 20075 :step/next {:db/id #edb/ref 17592186106674}} {:db/id #edb/ref 17592186106674 :step/content {:db/id #edb/ref 17592186105768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105620 :question/id #uuid "61bb0d60-a61e-5485-9df5-308e16dfd1aa" :question/math-academy-id "e-5476"} :knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050136} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186106092} {:db/id #edb/ref 17592186106296} {:db/id #edb/ref 17592186243944} {:db/id #edb/ref 17592186244106} {:db/id #edb/ref 17592186323871} {:db/id #edb/ref 17592186338848} {:db/id #edb/ref 17592186345104} {:db/id #edb/ref 17592186345105} {:db/id #edb/ref 17592186399538} {:db/id #edb/ref 17592186411285}] :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"} :step/id #uuid "4921a5cc-f26d-5b7a-9865-e447eec1d53e" :step/math-academy-id 20077 :step/next {:db/id #edb/ref 17592186106746}} {:db/id #edb/ref 17592186106675 :step/content {:db/id #edb/ref 17592186105769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105621 :question/id #uuid "f4ff15d3-1a6e-56c0-a7c4-13f18ef1a8e1" :question/math-academy-id "e-5477"} :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/questions [{:db/id #edb/ref 17592186106297} {:db/id #edb/ref 17592186106298} {:db/id #edb/ref 17592186244030} {:db/id #edb/ref 17592186244045} {:db/id #edb/ref 17592186244115} {:db/id #edb/ref 17592186323843} {:db/id #edb/ref 17592186323858} {:db/id #edb/ref 17592186323877} {:db/id #edb/ref 17592186345121} {:db/id #edb/ref 17592186345122} {:db/id #edb/ref 17592186411286}] :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"} :step/id #uuid "64cdc019-4015-5867-b014-691bcc52330a" :step/math-academy-id 20078} {:db/id #edb/ref 17592186106676 :step/content {:db/id #edb/ref 17592186105770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105622 :question/id #uuid "6cba45d6-5a69-5b83-937c-c19368aaeea9" :question/math-academy-id "e-5478"} :knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186106091} {:db/id #edb/ref 17592186106093} {:db/id #edb/ref 17592186243959} {:db/id #edb/ref 17592186243978} {:db/id #edb/ref 17592186243986} {:db/id #edb/ref 17592186243987} {:db/id #edb/ref 17592186244107} {:db/id #edb/ref 17592186244108} {:db/id #edb/ref 17592186287815} {:db/id #edb/ref 17592186345108} {:db/id #edb/ref 17592186345109} {:db/id #edb/ref 17592186369017}] :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"} :step/id #uuid "6e9a9912-8def-5a76-892f-0608e119d89c" :step/math-academy-id 20081 :step/next {:db/id #edb/ref 17592186106675}} {:db/id #edb/ref 17592186106711 :step/content {:db/id #edb/ref 17592186105787 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105628 :question/id #uuid "df40f37e-0d8f-5eb2-ad8a-9257440851df" :question/math-academy-id "e-5891"} :knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/questions [{:db/id #edb/ref 17592186106295} {:db/id #edb/ref 17592186106299} {:db/id #edb/ref 17592186243973} {:db/id #edb/ref 17592186243974} {:db/id #edb/ref 17592186345123} {:db/id #edb/ref 17592186345124} {:db/id #edb/ref 17592186369010} {:db/id #edb/ref 17592186386229} {:db/id #edb/ref 17592186392017} {:db/id #edb/ref 17592186393542} {:db/id #edb/ref 17592186393549} {:db/id #edb/ref 17592186393556}] :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"} :step/id #uuid "5b97f2fc-3025-5372-9dc4-19c05d084b76" :step/math-academy-id 21410 :step/next {:db/id #edb/ref 17592186106676}} {:db/id #edb/ref 17592186106746 :step/content {:db/id #edb/ref 17592186107098 :tutorial/content "Eigenvectors and eigenvalues can be interpreted geometrically.\n\nFirst, recall that if the matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is the standard matrix of some linear transformation ![](images/80/80d488fc9d8168cecdf882f1aa178325bb36bd387dd9f86f2b0cd98a5c54f4dc.svg) then the product ![](images/dc/dcc52971e9a7e86ebbe8bf972c562fce13d389f9261b69cba05dcabb1426b9dc.svg) gives the image of ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) under the action of ![](images/a1/a1af41bdb2f2fe410c6f8e02d1a2a0048f0aa470ceef4508753090444ca039be.svg) The image of ![](images/4f/4fa2300af121b336bb0d7845b8e2b3e34be5a517a1bca45b4ec7b6514b2c544d.svg) under the action of ![](images/c1/c15eeb9e7a3ff525fbdcd2f175622bd034f0b34899224f9ce2e08a5300d625de.svg) can appear quite different from the original vector ![](images/92/9221d4dc55c1df8da019956ea23f9d4f9ff3f5b04921ec2158804a31a50e636b.svg)\n\nHowever, for an eigenvector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) with corresponding eigenvalue ![](images/4a/4a2f3891f0b4c8b852767d556e1607028035219b70ab83b4910e95159a930b9c.svg) we get\n\n![](images/ee/eed93a562368727b490c2b63d14f46580dcd0439ac90df23a23f75a31de9e971.svg)\n\nIn other words, when the matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) is applied to an eigenvector ![](images/b2/b2766af4a0fe79e81fbd5ac113f0446ce1d111def401abbf09ced1ee62ca1cf1.svg) the image of ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) is a scaled version of the original vector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg), and the scale factor is ![](images/44/44db815dcaf0a9d405026460a655495e055df7e55a785f542f8920ca90af5418.svg)\n\nTo demonstrate, consider once again the following matrix:\n\n![](images/43/43e76f5a5e889ec18a6893be8cdbf4837d3dedfab149a0981ce6619a62718170.svg)\n\nWe've already seen that ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) has an eigenvector ![](images/fe/fef256ade4f52003da67fac5af68ff4b0d4e7f04ef55e72bb0279bdc8f1e8c3c.svg) with corresponding eigenvalue ![](images/b5/b5cdbd2f286044241daca2565a1ab7f70196ecc2cf6503965d9a820faad9b06e.svg) So we have\n\n![](images/2d/2da94bfdde0e3650ded2622748ead5a4c09cabf610f9d181d48ae158d9bd0986.svg)\n\nPlotting the vector ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) and its image ![](images/ab/abe8027351c1645f4c582440b8b536f48f3ec35d008570f3432f322fa468e861.svg) in the plane, we get the following picture.\n\n![](images/9a/9aca41e0597b0b1698e8ec24da9966fd9b7e5fee3951081d8abdb0cc0caaac7b.png)\n\nIn general, when we apply a matrix ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) to an eigenvector ![](images/b2/b2766af4a0fe79e81fbd5ac113f0446ce1d111def401abbf09ced1ee62ca1cf1.svg) the resulting vector ![](images/be/befecb9d885ee3bbbb7313401ca3671428e4aced68a4bfdb4b2fc9a005ea2b43.svg) always lies on the same line as ![](images/1f/1f3d1a60926323e963d7563529669e5cf8210771c8cbb0379f7a7d90e7c6aeec.svg)\n\nIf ![](images/8c/8c453358dacec49655b560be52a99066e3cab1d34cfbdbdbaa7bd74d868fef82.svg) then the matrix stretches the vector. For ![](images/ea/ea6d742051f82ff2f258e08ed09c3b3dc6d4c7f9bbbe40fea718aec8183dc44f.svg) the matrix compresses the vector. In addition, a negative eigenvalue ![](images/c9/c91cda6703c5767aaafeca807b07e466f160cb0ade84472ade5fa85d71a5713e.svg) means that ![](images/77/771507e21f2935d77160257f7d56c3f5fcef1d0a114ac8a38c373c49790dd854.svg) is flipped in the opposite direction as well as scaled." :tutorial/id #uuid "cdf6ca75-e37b-552a-a106-ee8ac2f36a61" :tutorial/math-academy-id 3963 :tutorial/title "The Geometric Interpretation of Eigenvalues and Eigenvectors"} :step/id #uuid "ab53090e-96b8-5dcc-b77f-6ff038689cac" :step/math-academy-id 23514 :step/next {:db/id #edb/ref 17592186106711}}] :activity/title "The Eigenvalues and Eigenvectors of a 2x2 Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106002}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106635} :activity/id #uuid "0211c399-b12f-5dd5-8ac4-97409f9a60bc" :activity/scope {:db/id #edb/ref 17592186048853 :topic/id #uuid "c62c1f45-0d31-598a-b3ca-31da6d205f4d" :topic/math-academy-id 1373} :activity/steps [{:db/id #edb/ref 17592186106635 :step/content {:db/id #edb/ref 17592186107080 :tutorial/content "Let's consider a system of linear equations where the corresponding coefficient matrix is singular. For example, consider the following system and its associated augmented matrix:\n![](images/6a/6a69daf7712312876b0ec97c540bbc472e46a7938beb8a59e694a04ad0b1d8c6.svg)\n\nTo solve the system, we can reduce $M$ to row echelon form using Gaussian elimination, as usual. We have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -2 & -5 \\\\ -3 & 6 & 15\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -5 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/a8/a8bfe3f6b27247ee9b27db8346fd94fb9068c85dec6f4a71517a821dee48dbf3.svg)\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y = 0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx - 2y = -5.\n$$\n\nFinally, we describe the **general solution** of our system.\n\n- The first variable in our equation, $x,$ is called a **basic variable**.\n\n- The second variable in our equation, $y,$ is called a **free variable**.\n\nSolving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x = -5+2y.$ So the general solution of the system is\n![](images/0b/0ba4a232f29dd6fce2a8f6d7cda39b4f5b192c20fc91fe4403dfe648231382c5.svg)\nwhere the free variable $y$ is any number.\n\nIn vector form, this solution is written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-5+2y \\\\ y\\end{aligned}]=[\\begin{aligned}-5 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nNotice that this is the equation of a straight line on a plane. Any point on this line satisfies our system of equations.\n\nIf we want to find some **particular solution** of the system, we simply choose some particular value of $y$ and find the corresponding value of $x$ on the line. For example, if we choose $y=0,$ then the corresponding value is $x=-5$ and the particular solution is $x=-5,$ $y=0.$" :tutorial/id #uuid "0c91df0b-40c7-5a65-9fda-5d2d6438dfa3" :tutorial/math-academy-id 3153 :tutorial/title "Introduction"} :step/id #uuid "2b66da6f-e7b3-547c-b47a-3bfe17bbc205" :step/math-academy-id 17192 :step/next {:db/id #edb/ref 17592186106636}} {:db/id #edb/ref 17592186106636 :step/content {:db/id #edb/ref 17592186105745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105602 :question/id #uuid "7bfabbd2-9988-5c0e-9c17-3d430b3e7a0f" :question/math-academy-id "e-4699"} :knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049422} {:db/id #edb/ref 17592186050240}] :knowledge-point/questions [{:db/id #edb/ref 17592186106312} {:db/id #edb/ref 17592186106313} {:db/id #edb/ref 17592186266011} {:db/id #edb/ref 17592186288008} {:db/id #edb/ref 17592186288020} {:db/id #edb/ref 17592186342000} {:db/id #edb/ref 17592186342072} {:db/id #edb/ref 17592186342073} {:db/id #edb/ref 17592186342074} {:db/id #edb/ref 17592186390388} {:db/id #edb/ref 17592186392488} {:db/id #edb/ref 17592186402782} {:db/id #edb/ref 17592186403689} {:db/id #edb/ref 17592186414184}] :knowledge-point/title "Reducing an Augmented Matrix for a Singular 2x2 System to REF and Solving the Resulting System"} :step/id #uuid "414f018d-78f3-5c78-86b8-6363d86d3a9e" :step/math-academy-id 17193 :step/next {:db/id #edb/ref 17592186106744}} {:db/id #edb/ref 17592186106637 :step/content {:db/id #edb/ref 17592186105746 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105603 :question/id #uuid "681fce57-6be7-5907-b575-8c34b4819ae5" :question/math-academy-id "e-4700"} :knowledge-point/id #uuid "07f2ae4c-ff07-5b99-a7b0-90f460081eef" :knowledge-point/questions [{:db/id #edb/ref 17592186106314} {:db/id #edb/ref 17592186106316} {:db/id #edb/ref 17592186266012} {:db/id #edb/ref 17592186266013} {:db/id #edb/ref 17592186288009} {:db/id #edb/ref 17592186288021} {:db/id #edb/ref 17592186329635} {:db/id #edb/ref 17592186342079} {:db/id #edb/ref 17592186342080} {:db/id #edb/ref 17592186379994} {:db/id #edb/ref 17592186390395} {:db/id #edb/ref 17592186392481} {:db/id #edb/ref 17592186393355} {:db/id #edb/ref 17592186414183} {:db/id #edb/ref 17592186414185} {:db/id #edb/ref 17592186414186}] :knowledge-point/title "Solving a Singular 2x2 System of Equations Using Gaussian Elimination"} :step/id #uuid "00d5123d-64a7-5878-9b67-ac7b7a2bf0a0" :step/math-academy-id 17194 :step/next {:db/id #edb/ref 17592186106638}} {:db/id #edb/ref 17592186106638 :step/content {:db/id #edb/ref 17592186107081 :tutorial/content "Given a $2 \\times 2$ system of linear equations, we have the following possibilities for the number of solutions:\n\n- The system has exactly *one solution* if and only if the respective coefficient matrix is non-singular (meaning that the determinant is not zero). Such systems are called **consistent independent**.\n\n- The system has *infinitely many solutions* if the second row in the standard echelon form contains only $0$'s. These systems are called **consistent dependent**.\n\n- The system has *no solution* if the second row in the standard echelon form contains only $0$'s on the left-hand side and a non-zero element on the right-hand side. These are called **inconsistent** systems.\n\n![](images/16/1692fbea298339ff839cf2f14986d51af45d1ec72b2b7d0de179336bdef40c0e.png)\n\n**Note:** A system of linear equations of the form \n![](images/cb/cb397dd01794f28ff11c01079e287d63175e439c8bbaa85cd02dc61689780fa8.svg)\nwhere we have only $0$'s on the right-hand side, is called **homogeneous**. A homogeneous system always has at least one solution, namely, the solution $x=0$ and $y=0.$ Or, in vector form, $\\langle 0,0 \\rangle.$" :tutorial/id #uuid "b885f832-9e76-5008-a764-7375b1c25e35" :tutorial/math-academy-id 3154 :tutorial/title "The Number of Solutions of a 2x2 System"} :step/id #uuid "dc00947a-2ca5-59a7-a7a8-349b27d59bf2" :step/math-academy-id 17195} {:db/id #edb/ref 17592186106744 :step/content {:db/id #edb/ref 17592186107097 :tutorial/content "Sometimes, a system of equations might not have any solutions. For example, consider the following augmented matrix:\n\n$$\n\\begin{aligned}M=[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 0 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is\n![](images/e8/e8c64d8be247afd3e8ab02abc69e33635ef0234dbcbbc60f42379021a39a58a2.svg)\n\nThe final equation, $0x+0y=10,$ has no solution. It simplifies to $0=10,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." :tutorial/id #uuid "20c281f5-a455-581a-a7f7-fec6cfaa114e" :tutorial/math-academy-id 3901 :tutorial/title "Singular Systems with No Solution"} :step/id #uuid "e6eff47b-880f-55d6-94ac-af8b9767c4fd" :step/math-academy-id 23052 :step/next {:db/id #edb/ref 17592186106637}}] :activity/title "Solving 2x2 Singular Systems of Equations Using Gaussian Elimination" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106000}] [{:activity/first-step {:db/id #edb/ref 17592186173004} :activity/id #uuid "81efeb5d-b89e-5c14-80c7-9be44b7d6319" :activity/scope {:db/id #edb/ref 17592186049012 :topic/id #uuid "d38bd816-27de-5026-97de-662b6ee04439" :topic/math-academy-id 3387} :activity/steps [{:db/id #edb/ref 17592186173001 :step/content {:db/id #edb/ref 17592186172092 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171898 :question/id #uuid "91f986c6-c305-50eb-a5b7-36043279d128" :question/math-academy-id "e-9505"} :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048203}] :knowledge-point/questions [{:db/id #edb/ref 17592186172293} {:db/id #edb/ref 17592186172296} {:db/id #edb/ref 17592186259630} {:db/id #edb/ref 17592186259631} {:db/id #edb/ref 17592186259635} {:db/id #edb/ref 17592186259636} {:db/id #edb/ref 17592186259637} {:db/id #edb/ref 17592186259638}] :knowledge-point/title "Identifying Affine Transformations"} :step/id #uuid "0a350174-3107-5bfc-b7cf-86f7ef4d3531" :step/math-academy-id 35594 :step/next {:db/id #edb/ref 17592186173003}} {:db/id #edb/ref 17592186173002 :step/content {:db/id #edb/ref 17592186172093 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171899 :question/id #uuid "9779a982-2048-58e2-8a90-df2bcb366d96" :question/math-academy-id "e-9506"} :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/questions [{:db/id #edb/ref 17592186172294} {:db/id #edb/ref 17592186172298} {:db/id #edb/ref 17592186259652} {:db/id #edb/ref 17592186259653} {:db/id #edb/ref 17592186259655} {:db/id #edb/ref 17592186259656} {:db/id #edb/ref 17592186259657}] :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"} :step/id #uuid "7d8f185d-3b89-591e-8ca2-fdba1ecfbeff" :step/math-academy-id 35595} {:db/id #edb/ref 17592186173003 :step/content {:db/id #edb/ref 17592186172094 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171900 :question/id #uuid "2ddc4e15-3729-5425-953c-1cb95edc201b" :question/math-academy-id "e-9508"} :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/questions [{:db/id #edb/ref 17592186172295} {:db/id #edb/ref 17592186172297} {:db/id #edb/ref 17592186259639} {:db/id #edb/ref 17592186259640} {:db/id #edb/ref 17592186259641} {:db/id #edb/ref 17592186259642} {:db/id #edb/ref 17592186259643} {:db/id #edb/ref 17592186259644}] :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"} :step/id #uuid "27929e1f-7191-5a61-bf7e-56af8100e9f0" :step/math-academy-id 35598 :step/next {:db/id #edb/ref 17592186173002}} {:db/id #edb/ref 17592186173004 :step/content {:db/id #edb/ref 17592186173206 :tutorial/content "An **affine transformation** $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is a function that can be expressed in the form\n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix. \n\nUnder this notation, \n\n- $[\\begin{aligned}u \\\\ v\\end{aligned}]$ represents vectors belonging to the input space, and\n\n- $[\\begin{aligned}x \\\\ y\\end{aligned}]$  represents vectors belonging to the output space.\n\nFor example,\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]\n$$\n\nis an affine transformation because it can be expressed in the form $\\mathbf x = A\\mathbf u + \\mathbf b,$ as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u-v+1 \\\\ 2u+v-3\\end{aligned}] \\\\  & =[\\begin{aligned}u-v \\\\ 2u+v\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}1 \\\\ -3\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nHowever, the transformation\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]\n$$\n\nis not affine since it contains the quadratic term $uv.$\n\nFinally, note the following relationships between affine and linear transformations:\n\n- A linear transformation $\\mathbf x = A \\mathbf u$ is a special case of an affine transformation with $\\mathbf b = \\mathbf 0.$\n\n- For an affine transformation $\\mathbf T$ given by $\\mathbf x = A\\mathbf u + \\mathbf b,$ we say that $A$ is *the matrix representation of the linear transformation associated with* $\\mathbf T.$" :tutorial/id #uuid "4b154eb4-94cc-5d7b-8120-56085be85703" :tutorial/math-academy-id 5808 :tutorial/title "Introduction"} :step/id #uuid "d639fa1f-d747-5b31-9f98-2bdd4bf28119" :step/math-academy-id 35599 :step/next {:db/id #edb/ref 17592186173001}}] :activity/title "Affine Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172189}] [{:activity/first-step {:db/id #edb/ref 17592186230052} :activity/id #uuid "50e3d3cb-c536-5096-8b7d-f9b0d3a94b49" :activity/scope {:db/id #edb/ref 17592186050392 :topic/id #uuid "45561e84-38ff-5ce1-9f3c-76fdda09730b" :topic/math-academy-id 6680} :activity/steps [{:db/id #edb/ref 17592186230052 :step/content {:db/id #edb/ref 17592186230176 :tutorial/content "Consider the first-order inhomogeneous ODE with **constant coefficients**\n\n$$\na y' + b y = f(x),\n$$\n\nwhere $a$ and $b$ are constants ($a \\neq 0$).\n\nAs we know, the method of finding the general solution is to find the sum of the complementary solution $y_c(x)$ and a particular solution $y_p(x).$\n\n$$\ny(x) = y_c(x) + y_p(x)\n$$\n\nTo find the particular solution $y_p(x),$ we examine the functional form of the forcing term $f(x)$ and guess a form for $y_p(x)$ that matches it. \n\nAn ODE exhibits **sinusoidal forcing** if the forcing term $f(x)$ is a sine or cosine function, or a combination of both. It is typically written as\n\n$$\nf(x) = C \\cos(\\omega x) + D \\sin(\\omega x)\n$$\n\nwhere $C$ and $D$ are constants (not both zero).\n\nNow, if we choose only a sine or only a cosine as a trial function for the particular solution, differentiation will introduce the other sinusoidal term, since the derivative of a sinusoid is another sinusoid. Substituting such a trial solution into the ODE therefore produces both sine and cosine terms.\n\nTo ensure that this combination can match the forcing term $f(x),$ the trial guess *must* include both sine and cosine terms of the same frequency $\\omega,$ even when $f(x)$ itself contains only one of them.\n\nTherefore, our trial guess for the particular solution is\n\n$$\ny_p(x) = \\alpha \\cos(\\omega x) + \\beta \\sin(\\omega x),\n$$\n\nwhere $\\alpha$ and $\\beta$ are to be determined.\n\nIn this lesson, we focus on solving first-order inhomogeneous ODEs with sinusoidal forcing. Let's look at a concrete example." :tutorial/id #uuid "16ccaf79-f39a-5c97-8b7e-a768583a8704" :tutorial/math-academy-id 14448 :tutorial/title "Introduction"} :step/id #uuid "b08bbcd6-b2d0-5926-b5e9-48a853cbad03" :step/math-academy-id 597581 :step/next {:db/id #edb/ref 17592186230053}} {:db/id #edb/ref 17592186230053 :step/content {:db/id #edb/ref 17592186230230 :tutorial/content "Consider the differential equation\n\n$$\n\\frac {\\textrm {d} y} {\\textrm {d} x} + 2 y = 10\\sin x.\n$$\n\nThe associated homogeneous equation is\n\n$$\n\\frac {\\textrm {d} y} {\\textrm {d} x} + 2 y = 0\n$$\n\nand therefore, the complementary solution is\n\n$$\ny_c(x) = Ae^{-2x}\n$$\n\nwhere $A$ is an arbitrary constant. Let's find the particular solution $y_p(x)$ to this equation.\n\nSince the right-hand side of the inhomogeneous equation is the sinusoidal function $f(x) = 10\\sin x,$ we assume a particular solution of the form\n\n$$\ny_p(x) = \\alpha \\cos x + \\beta  \\sin x,\n$$\n\nwhere $\\alpha$ and $\\beta$ are constants to be determined. \n\nCalculating the first derivative of $y_p$ gives\n\n$$\n\\frac{\\textrm{d}y_p}{\\textrm{d}x} =   - \\alpha \\sin x +  \\beta \\cos x.\n$$\n\nTo find the values of $\\alpha$ and $\\beta,$ we substitute $y_p$ and its derivative into the differential equation:\n\n$$\n( - \\alpha \\sin x +  \\beta \\cos x) + 2(\\alpha \\cos x + \\beta  \\sin x) = 10\\sin x.\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(2\\alpha+\\beta)\\cos x + (-\\alpha + 2\\beta) \\sin x = 10\\sin x + 0\\cos x.\n$$\n\nEquating the coefficients of $\\sin x$ and $\\cos x$ on both sides of the equation, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}2\\alpha +\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}x) \\\\ -\\alpha +2\\beta =10\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha=-2, \\beta=4.$\n\nTherefore, the particular solution $y_p(x)$ is\n\n$$\ny_p(x) = -2\\cos x + 4\\sin x\n$$\n\nand the general solution to the equation is\n\n$$\ny(x) = y_c(x) + y_p(x) = Ae^{-2x} -2\\cos x + 4\\sin x.\n$$" :tutorial/id #uuid "e265842b-cb73-5fe7-9aa0-d7cdf4b3625c" :tutorial/math-academy-id 14704 :tutorial/title "A Worked Example"} :step/id #uuid "0b2e8dc8-73e2-5e78-bf03-55587295628f" :step/math-academy-id 597582 :step/next {:db/id #edb/ref 17592186230054}} {:db/id #edb/ref 17592186230054 :step/content {:db/id #edb/ref 17592186229166 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228899 :question/id #uuid "90e0e1d2-ca8a-5919-9891-599af549f2d5" :question/math-academy-id "e-21618"} :knowledge-point/id #uuid "6af40e66-155c-57b8-b427-95259a2c1034" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049370} {:db/id #edb/ref 17592186050789}] :knowledge-point/questions [{:db/id #edb/ref 17592186229629} {:db/id #edb/ref 17592186229640} {:db/id #edb/ref 17592186305073} {:db/id #edb/ref 17592186305091} {:db/id #edb/ref 17592186305092} {:db/id #edb/ref 17592186305113} {:db/id #edb/ref 17592186305134} {:db/id #edb/ref 17592186305136} {:db/id #edb/ref 17592186305137} {:db/id #edb/ref 17592186372638}] :knowledge-point/title "Finding a Particular Solution to a First-Order Inhomogeneous ODE With Sinusoidal Forcing"} :step/id #uuid "2e90e3f1-e6d3-565d-9cf8-a3fff2ab9c62" :step/math-academy-id 597583 :step/next {:db/id #edb/ref 17592186230055}} {:db/id #edb/ref 17592186230055 :step/content {:db/id #edb/ref 17592186229167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228900 :question/id #uuid "5769fd27-5fa4-5c85-b927-c87bedca3ea3" :question/math-academy-id "e-21619"} :knowledge-point/id #uuid "ef7a2bbc-4172-591e-98eb-f7586d3ae06b" :knowledge-point/questions [{:db/id #edb/ref 17592186229630} {:db/id #edb/ref 17592186229648} {:db/id #edb/ref 17592186305115} {:db/id #edb/ref 17592186305116} {:db/id #edb/ref 17592186305127} {:db/id #edb/ref 17592186305128} {:db/id #edb/ref 17592186305129} {:db/id #edb/ref 17592186305131} {:db/id #edb/ref 17592186305138} {:db/id #edb/ref 17592186305139} {:db/id #edb/ref 17592186305140} {:db/id #edb/ref 17592186372628} {:db/id #edb/ref 17592186372633} {:db/id #edb/ref 17592186377132}] :knowledge-point/title "Finding the General Solution to a First-Order Inhomogeneous ODE With Sinusoidal Forcing"} :step/id #uuid "7f4df209-44ae-5584-b4b1-bb5e57ba48b3" :step/math-academy-id 597587 :step/next {:db/id #edb/ref 17592186230056}} {:db/id #edb/ref 17592186230056 :step/content {:db/id #edb/ref 17592186229168 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228901 :question/id #uuid "3b584b5f-8398-5f18-923d-47a3fb09adca" :question/math-academy-id "e-21620"} :knowledge-point/id #uuid "05d3144f-53da-5608-a07b-d1d5d672bf0b" :knowledge-point/questions [{:db/id #edb/ref 17592186229631} {:db/id #edb/ref 17592186229651} {:db/id #edb/ref 17592186308349} {:db/id #edb/ref 17592186308351} {:db/id #edb/ref 17592186308352} {:db/id #edb/ref 17592186308353} {:db/id #edb/ref 17592186308355} {:db/id #edb/ref 17592186308356} {:db/id #edb/ref 17592186308363} {:db/id #edb/ref 17592186308450} {:db/id #edb/ref 17592186308451}] :knowledge-point/title "Solving an Initial Value Problem"} :step/id #uuid "daae17f0-2223-5441-8a1a-41931c66d349" :step/math-academy-id 597591}] :activity/title "Solving First-Order Linear ODEs With Sinusoidal Forcing" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186229251}]}
