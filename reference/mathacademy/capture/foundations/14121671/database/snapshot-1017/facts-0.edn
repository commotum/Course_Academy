2392 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186302426 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186302435 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186308444 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186308623 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186387971 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186390737 #edb/ref 17592186045417] [17592186115393 #edb/ref 1038 #edb/ref 17592186390798 #edb/ref 17592186045417] [17592186115393 #edb/ref 1039 "Using the Product Rules for Differentiation" #edb/ref 17592186045417] [17592186115393 #edb/ref 1041 #edb/ref 17592186114973 #edb/ref 17592186045417] [17592186115393 #edb/ref 1042 #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116367 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116368 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116369 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116370 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116371 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116372 #edb/ref 17592186045417] [17592186115483 #edb/ref 1043 #edb/ref 17592186116373 #edb/ref 17592186045417] [17592186115483 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186115483 #edb/ref 1045 "Differentiation Rules for Vector-Valued Functions" #edb/ref 17592186045417] [17592186115483 #edb/ref 1046 #edb/ref 17592186116367 #edb/ref 17592186045417] [17592186115483 #edb/ref 1049 #edb/ref 17592186048233 #edb/ref 17592186045417] [17592186115483 #edb/ref 1053 #uuid "b5ef0f4d-28ef-57bb-a6d8-a44c7baf171f" #edb/ref 17592186045417] [17592186115767 #edb/ref 1068 #edb/ref 17592186301808 #edb/ref 17592186045417] [17592186115767 #edb/ref 1069 "q-32498" #edb/ref 17592186045417] [17592186115767 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186115767 #edb/ref 1071 "If $f(u)=[\\begin{aligned}2u \\\\ {u}^{2} \\\\ 3\\end{aligned}]$ and $u(t)=2t+2$, then $(f∘u)^{′}(t)=$" #edb/ref 17592186045417] [17592186115767 #edb/ref 1072 #uuid "0fd1def5-bd75-572c-939f-770f964a1db9" #edb/ref 17592186045417] [17592186115767 #edb/ref 1074 "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(2u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(3)\\end{aligned}]=[\\begin{aligned}2 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t+2)=2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}2 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}2 \\\\ 2(2t+2) \\\\ 0\\end{aligned}]\\cdot 2 \\\\  & =[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186116367 #edb/ref 1058 #edb/ref 17592186116370 #edb/ref 17592186045417] [17592186116367 #edb/ref 1061 8378 #edb/ref 17592186045417] [17592186116367 #edb/ref 1062 #uuid "eb0a96a9-97f7-54a8-91fe-e18c9fa61102" #edb/ref 17592186045417] [17592186116367 #edb/ref 1063 #edb/ref 17592186116440 #edb/ref 17592186045417] [17592186116368 #edb/ref 1058 #edb/ref 17592186116372 #edb/ref 17592186045417] [17592186116368 #edb/ref 1061 8379 #edb/ref 17592186045417] [17592186116368 #edb/ref 1062 #uuid "24ff6243-dc48-530e-9e8c-76468e0f51b7" #edb/ref 17592186045417] [17592186116368 #edb/ref 1063 #edb/ref 17592186116441 #edb/ref 17592186045417] [17592186116369 #edb/ref 1058 #edb/ref 17592186116373 #edb/ref 17592186045417] [17592186116369 #edb/ref 1061 8380 #edb/ref 17592186045417] [17592186116369 #edb/ref 1062 #uuid "13df4a33-8393-5b6a-a1df-d349deaa17b2" #edb/ref 17592186045417] [17592186116369 #edb/ref 1063 #edb/ref 17592186116442 #edb/ref 17592186045417] [17592186116370 #edb/ref 1058 #edb/ref 17592186116371 #edb/ref 17592186045417] [17592186116370 #edb/ref 1061 8381 #edb/ref 17592186045417] [17592186116370 #edb/ref 1062 #uuid "4ac8a89c-dc16-5903-a731-4a3fa01f503f" #edb/ref 17592186045417] [17592186116370 #edb/ref 1063 #edb/ref 17592186115390 #edb/ref 17592186045417] [17592186116371 #edb/ref 1058 #edb/ref 17592186116368 #edb/ref 17592186045417] [17592186116371 #edb/ref 1061 8382 #edb/ref 17592186045417] [17592186116371 #edb/ref 1062 #uuid "15461d2a-a63a-5340-8afc-8c7599c24c85" #edb/ref 17592186045417] [17592186116371 #edb/ref 1063 #edb/ref 17592186115391 #edb/ref 17592186045417] [17592186116372 #edb/ref 1058 #edb/ref 17592186116369 #edb/ref 17592186045417] [17592186116372 #edb/ref 1061 8383 #edb/ref 17592186045417] [17592186116372 #edb/ref 1062 #uuid "90197991-2635-5dee-8772-2c779a733d8a" #edb/ref 17592186045417] [17592186116372 #edb/ref 1063 #edb/ref 17592186115392 #edb/ref 17592186045417] [17592186116373 #edb/ref 1061 8384 #edb/ref 17592186045417] [17592186116373 #edb/ref 1062 #uuid "2d325e5d-2cb2-5a4d-9ff0-0babe8095a2f" #edb/ref 17592186045417] [17592186116373 #edb/ref 1063 #edb/ref 17592186115393 #edb/ref 17592186045417] [17592186116440 #edb/ref 1064 "Many of the known properties of derivatives of scalar functions extend naturally to derivatives of vector functions. \n\nSuppose that $\\mathbf f(t)$ and $\\mathbf g(t)$ are vector-valued functions, $u(t)$ is a scalar function, and $\\alpha$ and $\\mathbf c$ are scalar and vector constants, respectively. \n\nThe **sum and multiple rules** for differentiating vector-valued functions are as follows:\n\n$$\n\\begin{aligned}(f+g)^{'}(t)={f}^{'}(t)+{g}^{'}(t)\\, & \\text{sum rule} \\\\ (\\alpha f)^{'}(t)=\\alpha {f}^{'}(t),\\,(uc)^{'}(t)={u}^{'}(t)c\\, & \\text{constant multiple rules} \\\\ (uf)^{'}(t)={u}^{'}(t)f(t)+u(t){f}^{'}(t)\\, & \\text{scalar function multiple rule}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186116440 #edb/ref 1065 2143 #edb/ref 17592186045417] [17592186116440 #edb/ref 1066 #uuid "10b4a11f-6ada-568e-9a43-dbeeeb1826c6" #edb/ref 17592186045417] [17592186116440 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186116441 #edb/ref 1064 "The **chain rule** for differentiating vector-valued functions states that\n\n![](images/57/57f880045af93f552c2736659e377c7ac4c6f41f78a2df446f241783f472f8aa.svg)\n\nwhere ![](images/bc/bcf7f1c428a975daf939f469deb8e13c050d912fb5a2548fbb6b60ea6d413a86.svg) is a vector-valued function while ![](images/cd/cd94c3404a0b6460dd11ffac737b2ce09af9f26b21de28ccedf8d028bd6ec38a.svg) is a scalar function." #edb/ref 17592186045417] [17592186116441 #edb/ref 1065 2144 #edb/ref 17592186045417] [17592186116441 #edb/ref 1066 #uuid "e299896a-b9ca-574f-8c05-ef656d9c5cd2" #edb/ref 17592186045417] [17592186116441 #edb/ref 1067 "The Chain Rule for Differentiation" #edb/ref 17592186045417] [17592186116442 #edb/ref 1064 "When working with vector functions, there are two types of products: the dot product and the cross product. So, there are two **product rules** for derivatives:\n\n$$\n\\begin{aligned}(f\\cdot g)^{'}(t)=f(t)\\cdot {g}^{'}(t)+{f}^{'}(t)\\cdot g(t)\\, & \\text{dot product rule} \\\\ (f\\times g)^{'}(t)={f}^{'}(t)\\times g(t)+f(t)\\times {g}^{'}(t)\\, & \\text{cross product rule}\\end{aligned}\n$$\n\n**Watch out!** Remember that the cross product is anticommutative, meaning that $\\mathbf f \\times \\mathbf g = - \\mathbf g \\times \\mathbf f.$ Therefore,\n\n$$\n\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\times \\mathbf g)(t) = -\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf g \\times \\mathbf f)(t).\n$$\n\nWhen applying the cross product rule, the order in which the operations are applied is important." #edb/ref 17592186045417] [17592186116442 #edb/ref 1065 2145 #edb/ref 17592186045417] [17592186116442 #edb/ref 1066 #uuid "babb1734-198a-5751-b78c-b333b6e38d5e" #edb/ref 17