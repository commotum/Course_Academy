#{[{:db/id #edb/ref 17592186241129 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "068fdbf6-8854-5e41-8385-479ca927ddb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{△,♢,♣}" :db/id #edb/ref 17592186238134} {:answer/id #uuid "46f64025-571e-5821-88ed-7eeeb50024fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{♣}" :db/id #edb/ref 17592186238671} {:answer/id #uuid "4f358968-cc70-5e23-ac1a-270efae9e4ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{♡,△,♢}" :db/id #edb/ref 17592186238734} {:answer/id #uuid "8dd99651-4d70-505b-bdae-0143e3b75159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{△,♢}" :db/id #edb/ref 17592186239284} {:answer/id #uuid "ff3888a7-9c0d-556c-b076-24ac21d8769f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{♢}" :db/id #edb/ref 17592186240316}] :answer-field/correct {:answer/id #uuid "8dd99651-4d70-505b-bdae-0143e3b75159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{△,♢}" :db/id #edb/ref 17592186239284} :answer-field/id #uuid "1b6dafcb-68da-579c-accc-d5712fd724f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240377}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4c8e9ed-6552-597b-936f-fc4ee3da32f6" :question/math-academy-id "q-105810" :question/problem "Given the sets $X={♠,◻,♡,♢,△}$ and $Y={♠,◻,♣,♡},$ find $X∖Y.$" :question/worked-solution "The set  $X∖Y$ is the set of all elements belonging to $X$ but *not* $Y.$ Note that the elements $♠,◻,♡\\in X$ are also in $Y,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}X∖Y & =X-Y \\\\  & ={♠,◻,♡,♢,△}-{♠,◻,♣,♡} \\\\  & ={△,♢}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259637 :knowledge-point/_questions [{:db/id #edb/ref 17592186172092 :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/title "Identifying Affine Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b02e3f-baf3-57d3-a076-ab452fdeef0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ only" :db/id #edb/ref 17592186256799} {:answer/id #uuid "22814352-2c48-5958-9dee-a9a29d563b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257066} {:answer/id #uuid "27a5552d-e286-524b-8546-cef93fa80826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1},$ ${T}_{2},$ and ${T}_{3}$" :db/id #edb/ref 17592186257133} {:answer/id #uuid "2f4661b6-b14e-5456-9974-00d318903de3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257199} {:answer/id #uuid "f916b4e3-4292-594a-9059-6b10083c974a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{1}$ and ${T}_{2}$ only" :db/id #edb/ref 17592186258968}] :answer-field/correct {:answer/id #uuid "22814352-2c48-5958-9dee-a9a29d563b86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${T}_{2}$ and ${T}_{3}$ only" :db/id #edb/ref 17592186257066} :answer-field/id #uuid "206fb4ee-adb0-528a-87ee-8ada6b197a84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13d7af34-5a26-56da-8335-dcbefb3a99a7" :question/math-academy-id "q-124251" :question/problem "Which of the following are affine transformations?\n\n- ${T}_{1}:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-{v}^{2} \\\\ v-u\\end{aligned}]$\n- ${T}_{2}:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}6v-4u \\\\ 3u+3v\\end{aligned}]$\n- ${T}_{3}:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v+9 \\\\ v-9\\end{aligned}]$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWith this in mind, let's look at each transformation in turn.\n\n- Transformation ${T}_{1}$ is not affine since it contains the quadratic terms ${u}^{2}$ and ${v}^{2}.$\n\n- Transformation ${T}_{2}$ is affine. Notice that ${T}_{2}$ can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}6v-4u \\\\ 3u+3v\\end{aligned}] \\\\  & =[\\begin{aligned}-4u+6v \\\\ 3u+3v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & ={{[\\begin{aligned}-4 & 6 \\\\ 3 & 3\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nIn fact, the transformation ${T}_{2}$ is a linear transformation.\n\n- Transformation ${T}_{3}$ is affine. Notice that ${T}_{3}$ can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u+v+9 \\\\ v-9\\end{aligned}] \\\\  & =[\\begin{aligned}u+v \\\\ v\\end{aligned}]+[\\begin{aligned}9 \\\\ -9\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}9 \\\\ -9\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"${T}_{2}$ and ${T}_{3}$ only.\""}] [{:db/id #edb/ref 17592186115767 :knowledge-point/_questions [{:db/id #edb/ref 17592186115392 :knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/title "Using the Chain Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041da615-473a-59b3-bd74-078cc5cac382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186299946} {:answer/id #uuid "278a088d-66ff-5fc3-9def-6ae04de020b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4t+4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300150} {:answer/id #uuid "67ce37ea-b2ab-5a58-86f8-69d3f8240639" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300484} {:answer/id #uuid "ab0ec50a-1d0e-532d-ab8d-7cf840b59340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 2t \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300820} {:answer/id #uuid "f2329096-2544-59c2-a74f-b394b5ad02bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4t+4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186301157}] :answer-field/correct {:answer/id #uuid "041da615-473a-59b3-bd74-078cc5cac382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186299946} :answer-field/id #uuid "b1a16360-6703-53e1-9901-03f44bb4aa65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0fd1def5-bd75-572c-939f-770f964a1db9" :question/math-academy-id "q-32498" :question/problem "If $f(u)=[\\begin{aligned}2u \\\\ {u}^{2} \\\\ 3\\end{aligned}]$ and $u(t)=2t+2$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(2u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(3)\\end{aligned}]=[\\begin{aligned}2 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t+2)=2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}2 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}2 \\\\ 2(2t+2) \\\\ 0\\end{aligned}]\\cdot 2 \\\\  & =[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308363 :knowledge-point/_questions [{:db/id #edb/ref 17592186229168 :knowledge-point/id #uuid "05d3144f-53da-5608-a07b-d1d5d672bf0b" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d79074e-27e9-5f57-9e8f-e7df67ac74b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{-2x}+2\\operatorname{cos}(3x)+3\\operatorname{sin}(3x)" :db/id #edb/ref 17592186306621} {:answer/id #uuid "5603a9d7-e763-5725-9826-34a52919369c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e^{-2x}+2\\cos(3x)+3\\sin(3x)" :db/id #edb/ref 17592186419109}] :answer-field/correct {:answer/id #uuid "5603a9d7-e763-5725-9826-34a52919369c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e^{-2x}+2\\cos(3x)+3\\sin(3x)" :db/id #edb/ref 17592186419109} :answer-field/id #uuid "59c70ecc-7755-5121-a34e-713ab4626109" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307799}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58d13845-465e-5368-a086-659bbbd2ba3a" :question/math-academy-id "q-333044" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}+2y=13\\operatorname{cos}⁡(3x),\\,y(0)=5\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}+2y=13\\operatorname{cos}⁡(3x)\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{-2x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c}$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-2x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is $13\\operatorname{cos}⁡(3x).$ So, we assume the particular solution to be \n\n$$\n{y}_{p}(x)=\\alpha \\operatorname{cos}⁡(3x)+\\beta \\operatorname{sin}⁡(3x).\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n{y}_{p}^{′}=-3\\alpha \\operatorname{sin}⁡(3x)+3\\beta \\operatorname{cos}⁡(3x).\n$$\n\nTo find the values of $\\alpha ,$ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(-3\\alpha \\operatorname{sin}⁡(3x)+3\\beta \\operatorname{cos}⁡(3x))+2(\\alpha \\operatorname{cos}⁡(3x)+\\beta \\operatorname{sin}⁡(3x))=13\\operatorname{cos}⁡(3x)\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(3\\beta +2\\alpha )\\operatorname{cos}⁡(3x)+(-3\\alpha +2\\beta )\\operatorname{sin}⁡(3x)=13\\operatorname{cos}⁡(3x).\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}3\\beta +2\\alpha =13\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(3x)) \\\\ -3\\alpha +2\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(3x))\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =2,\\beta =3.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=2\\operatorname{cos}⁡(3x)+3\\operatorname{sin}⁡(3x).\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{-2x}+2\\operatorname{cos}⁡(3x)+3\\operatorname{sin}⁡(3x).\n$$\n\nNow, we can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=5$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{-2\\cdot 0}+2\\operatorname{cos}⁡(3\\cdot 0)+3\\operatorname{sin}⁡(3\\cdot 0) & =5 \\\\ A+2+0 & =5 \\\\ A & =3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=3{e}^{-2x}+2\\operatorname{cos}⁡(3x)+3\\operatorname{sin}⁡(3x).\n$$"}] [{:db/id #edb/ref 17592186392017 :knowledge-point/_questions [{:db/id #edb/ref 17592186105787 :knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7025706-5edb-5416-92d4-c3864a411c44" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e53fd4d2bcde7cbe59d4be00f8e6a14a9f3bc979388791c46e0faef3d51d158.png" :db/id #edb/ref 17592186392019} {:answer/id #uuid "8a226b1b-b31e-54f7-a43c-b81bf1cb7eda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3c202b0f2c679121f4c51a57514aea8a8d6bf5706e67e4d8986b9ec624a74574.png" :db/id #edb/ref 17592186392020} {:answer/id #uuid "1b3e8424-aba1-53e6-9522-8116ce095fef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7e/7e74dbc626472e00e42db273ef7d005ec9b3103f8708214871912382fed66663.png" :db/id #edb/ref 17592186392021} {:answer/id #uuid "f1fea4dc-19dc-589a-973a-ef51baa4ef02" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/221b02b2df0cd292a41593f52b96be20c0ed20c1b1ccad080157f4729d871f0c.png" :db/id #edb/ref 17592186392022} {:answer/id #uuid "cbaeacd0-a3d9-57e0-9905-3d6d4fd3a10e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e56f6feb61896097941f2df3ff6b38dff9972820180f571383635d29b95ba8bc.png" :db/id #edb/ref 17592186392023}] :answer-field/correct {:answer/id #uuid "f1fea4dc-19dc-589a-973a-ef51baa4ef02" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/221b02b2df0cd292a41593f52b96be20c0ed20c1b1ccad080157f4729d871f0c.png" :db/id #edb/ref 17592186392022} :answer-field/id #uuid "b37c1798-9174-5ff1-b8c2-f0de21f94988" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "885a86b4-4c0a-595d-852f-a00f02fd8acf" :question/math-academy-id "q-36869" :question/problem "![](images/0f/0fb9b5442b5721d4dc273978f30fa79d5b5555faac0672ea44e11ebf79387d6c.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $1.$ Find the vector $Av.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =1.$ So, \n\n$$\n\\begin{aligned}Av & =1v.\\end{aligned}\n$$\n\nThus, we have the following picture:\n\n![](images/22/221b02b2df0cd292a41593f52b96be20c0ed20c1b1ccad080157f4729d871f0c.png)"}] [{:db/id #edb/ref 17592186342073 :knowledge-point/_questions [{:db/id #edb/ref 17592186105745 :knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c" :knowledge-point/title "Reducing an Augmented Matrix for a Singular 2x2 System to REF and Solving the Resulting System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c87faa6-b893-53ba-92f4-903ccf2dd32d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & -2 & 0\\end{aligned}]" :db/id #edb/ref 17592186339374} {:answer/id #uuid "359295b0-82ba-5167-85b6-7dd0bfdb6bf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186339603} {:answer/id #uuid "60eaf115-9b83-5456-8a7e-58465ef148d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186339993} {:answer/id #uuid "64ccd9c1-b048-5406-90fe-2f5854979f7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186340021} {:answer/id #uuid "6ac239fb-67c1-5152-911c-d8d3251c0f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 16\\end{aligned}]" :db/id #edb/ref 17592186340075}] :answer-field/correct {:answer/id #uuid "60eaf115-9b83-5456-8a7e-58465ef148d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186339993} :answer-field/id #uuid "8b1f506b-8f53-50ce-aefc-1cc168e288d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341624}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9dd0d4fd-091a-5d63-898d-8efe81821dbb" :question/math-academy-id "q-73742" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$"}]}
