/ref 17592186045585] [17592186280217 #edb/ref 1084 #uuid "b815cee2-db42-5d6f-beef-5073c80b1726" #edb/ref 17592186045585] [17592186280238 #edb/ref 1081 "2{u}^{2}{v}^{2}" #edb/ref 17592186045585] [17592186280238 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186280238 #edb/ref 1084 #uuid "ba0b239b-6293-5a6c-a399-4c20fbd9ba89" #edb/ref 17592186045585] [17592186280342 #edb/ref 1081 "-2" #edb/ref 17592186045585] [17592186280342 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186280342 #edb/ref 1084 #uuid "c706e56c-9384-5437-a653-797286bbede3" #edb/ref 17592186045585] [17592186280365 #edb/ref 1081 "-u{v}^{2}" #edb/ref 17592186045585] [17592186280365 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186280365 #edb/ref 1084 #uuid "c9d8a949-98c9-53b2-a5c0-d91ecebaaf5b" #edb/ref 17592186045585] [17592186280795 #edb/ref 1081 "\\frac{1}{9}" #edb/ref 17592186045585] [17592186280795 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186280795 #edb/ref 1084 #uuid "fa5dc6c7-df6e-5fdb-b0fa-59f45de8fd17" #edb/ref 17592186045585] [17592186280825 #edb/ref 1081 "-8" #edb/ref 17592186045585] [17592186280825 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186280825 #edb/ref 1084 #uuid "feaf148b-7dd0-5012-95f0-0e1627a40f3e" #edb/ref 17592186045585] [17592186280855 #edb/ref 1075 #edb/ref 17592186279228 #edb/ref 17592186045585] [17592186280855 #edb/ref 1075 #edb/ref 17592186279412 #edb/ref 17592186045585] [17592186280855 #edb/ref 1075 #edb/ref 17592186279422 #edb/ref 17592186045585] [17592186280855 #edb/ref 1075 #edb/ref 17592186280238 #edb/ref 17592186045585] [17592186280855 #edb/ref 1075 #edb/ref 17592186280365 #edb/ref 17592186045585] [17592186280855 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186280855 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186280855 #edb/ref 1079 #edb/ref 17592186279422 #edb/ref 17592186045585] [17592186280855 #edb/ref 1080 #uuid "095a93fc-962d-5e7a-8222-89b127de9857" #edb/ref 17592186045585] [17592186280883 #edb/ref 1075 #edb/ref 17592186278815 #edb/ref 17592186045585] [17592186280883 #edb/ref 1075 #edb/ref 17592186279371 #edb/ref 17592186045585] [17592186280883 #edb/ref 1075 #edb/ref 17592186280130 #edb/ref 17592186045585] [17592186280883 #edb/ref 1075 #edb/ref 17592186280217 #edb/ref 17592186045585] [17592186280883 #edb/ref 1075 #edb/ref 17592186280825 #edb/ref 17592186045585] [17592186280883 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186280883 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186280883 #edb/ref 1079 #edb/ref 17592186279371 #edb/ref 17592186045585] [17592186280883 #edb/ref 1080 #uuid "1a2c215b-9be4-534d-b695-b69d79a8eec9" #edb/ref 17592186045585] [17592186280897 #edb/ref 1075 #edb/ref 17592186279279 #edb/ref 17592186045585] [17592186280897 #edb/ref 1075 #edb/ref 17592186279479 #edb/ref 17592186045585] [17592186280897 #edb/ref 1075 #edb/ref 17592186280171 #edb/ref 17592186045585] [17592186280897 #edb/ref 1075 #edb/ref 17592186280342 #edb/ref 17592186045585] [17592186280897 #edb/ref 1075 #edb/ref 17592186280795 #edb/ref 17592186045585] [17592186280897 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186280897 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186280897 #edb/ref 1079 #edb/ref 17592186280795 #edb/ref 17592186045585] [17592186280897 #edb/ref 1080 #uuid "22d4e8c1-df31-56ff-9384-be31853aa6b8" #edb/ref 17592186045585] [17592186281331 #edb/ref 1068 #edb/ref 17592186280855 #edb/ref 17592186045585] [17592186281331 #edb/ref 1069 "q-161792" #edb/ref 17592186045585] [17592186281331 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186281331 #edb/ref 1071 "Find the Jacobian determinant of the transformation $T$ that maps the $uvw$-space into the $xyz$-space by means of the equations\n\n$$\nx=u{v}^{2}+w,\\,y={u}^{3}+v,\\,z=uv.\n$$" #edb/ref 17592186045585] [17592186281331 #edb/ref 1072 #uuid "ba1e3545-8702-5a08-88b1-f7be09c82e4e" #edb/ref 17592186045585] [17592186281331 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & ={v}^{2} & \\,\\frac{∂x}{∂v} & =2uv & \\,\\frac{∂x}{∂w} & =1 \\\\ \\frac{∂y}{∂u} & =3{u}^{2} & \\,\\frac{∂y}{∂v} & =1 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =v & \\,\\frac{∂z}{∂v} & =u & \\,\\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}{v}^{2} & 2uv & 1 \\\\ 3{u}^{2} & 1 & 0 \\\\ v & u & 0\\end{aligned}| \\\\  & =1(-1)^{1+3}|\\begin{aligned}3{u}^{2} & 1 \\\\ v & u\\end{aligned}| \\\\  & =3{u}^{3}-v.\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186281335 #edb/ref 1068 #edb/ref 17592186280883 #edb/ref 17592186045585] [17592186281335 #edb/ref 1069 "q-161798" #edb/ref 17592186045585] [17592186281335 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186281335 #edb/ref 1071 "Find the Jacobian determinant of the transformation $T:(u,v,w)\\to (x(u,v,w),y(u,v,w),z(u,v,w)),$ given that \n\n$$\nu=x+y,\\,v=z,\\,w=4y-2{z}^{2}.\n$$" #edb/ref 17592186045585] [17592186281335 #edb/ref 1072 #uuid "867c4c3a-9ff3-5bda-af78-c2d51483fcb4" #edb/ref 17592186045585] [17592186281335 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =1 & \\,\\frac{∂u}{∂y} & =1 & \\,\\frac{∂u}{∂z} & =0 \\\\ \\frac{∂v}{∂x} & =0 & \\,\\frac{∂v}{∂y} & =0 & \\,\\frac{∂v}{∂z} & =1 \\\\ \\frac{∂w}{∂x} & =0 & \\,\\frac{∂w}{∂y} & =4 & \\,\\frac{∂w}{∂z} & =-4z\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 4 & -4z\\end{aligned}| \\\\  & =1|\\begin{aligned}0 & 1 \\\\ 4 & -4z\\end{aligned}| \\\\  & =1(0-4) \\\\  & =-4.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1} \\\\  & =\\frac{1}{(-4)} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186281337 #edb/ref 1068 #edb/ref 17592186280897 #edb/ref 17592186045585] [17592186281337 #edb/ref 1069 "q-161801" #edb/ref 17592186045585] [17592186281337 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186281337 #edb/ref 1071 "Find the Jacobian determinant of the transformation $T:(u,v,w)\\to (x(u,v,w),y(u,v,w),z(u,v,w)),$ given that \n\n$$\nu=y-3z,\\,v=x+2z,\\,w=3x-y.\n$$" #edb/ref 17592186045585] [17592186281337 #edb/ref 1072 #uuid "4f0a4eb6-83e4-58b7-81d7-e22ca020da04" #edb/ref 17592186045585] [17592186281337 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =0 & \\,\\frac{∂u}{∂y} & =1 & \\,\\frac{∂u}{∂z} & =-3 \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =0 & \\,\\frac{∂v}{∂z} & =2 \\\\ \\frac{∂w}{∂x} & =3 & \\,\\frac{∂w}{∂y} & =-1 & \\,\\frac{∂w}{∂z} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 & -3 \\\\ 1 & 0 & 2 \\\\ 3 & -1 & 0\\end{aligned}| \\\\  & =-1|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}|-3|\\begin{aligned}1 & 0 \\\\ 3 & -1\\end{aligned}| \\\\  & =-1(0-6)-3(-1-0) \\\\  & =6+3 \\\\  & =9\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1} \\\\  & =\\frac{1}{9}\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186401281 #edb/ref 1068 #edb/ref 17592186401282 #edb/ref 17592186045585] [17592186401281 #edb/ref 1069 "q-161814" #edb/ref 17592186045585] [17592186401281 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186401281 #edb/ref 1071 "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+2w \\\\ v-u \\\\ uw\\end{aligned}].\n$$" #edb/ref 17592186045585] [17592186401281 #edb/ref 1072 #uuid "d8752c18-2285-5bd2-a3b2-ba4d0420bd04" #edb/ref 17592186045585] [17592186401281 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+2w,\\,y(u,v,w)=v-u,\\,z(u,v,w)=uw.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =2 \\\\ \\frac{∂y}{∂u} & =-1 & \\,\\frac{∂y}{∂v} & =1 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =w & \\,\\frac{∂z}{∂v} & =0 & \\,\\frac{∂z}{∂w} & =u\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & 0 & 2 \\\\ -1 & 1 & 0 \\\\ w & 0 & u\\end{aligned}| \\\\  & =1|\\begin{aligned}1 & 0 \\\\ 0 & u\\end{aligned}|+2|\\begin{aligned}-1 & 1 \\\\ w & 0\\end{aligned}| \\\\  & =1(u-0)+2(0-w) \\\\  & =u-2w.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ u-2w & =0.\\end{aligned}\n$$\n\nThe equation $u-2w=0$ defines the plane $u=2w.$" #edb/ref 17592186045585] [17592186401282 #edb/ref 1075 #edb/ref 17592186401283 #edb/ref 17592186045585] [17592186401282 #edb/ref 1075 #edb/ref 17592186401284 #edb/ref 17592186045585] [17592186401282 #edb/ref 1075 #edb/ref 17592186401285 #edb/ref 17592186045585] [17592186401282 #edb/ref 1075 #edb/ref 17592186401286 #edb/ref 17592186045585] [17592186401282 #edb/ref 1075 #edb/ref 17592186401287 #edb/ref 17592186045585] [17592186401282 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186401282 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186401282 #edb/ref 1079 #edb/ref 17592186401287 #edb/ref 17592186045585] [17592186401282 #edb/ref 1080 #uuid "65676948-b2fa-585d-8619-ca89f50c6f34" #edb/ref 17592186045585] [17592186401283 #edb/ref 1081 "The critical points lie on the plane $u+v-2w=0.$" #edb/ref 17592186045585] [17592186401283 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186401283 #edb/ref 1084 #uuid "53f14d31-90ea-5326-97dc-45022d0835ee" #edb/ref 17592186045585] [17592186401284 #edb/ref 1081 "The critical points lie on the elliptic cylinder ${u}^{2}+2{w}^{2}=1.$" #edb/ref 17592186045585] [17592186401284 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186401284 #edb/ref 1084 #uuid "b740b568-485c-5311-a423-33ea2f3eeffb" #edb/ref 17592186045585] [17592186401285 #edb/ref 1081 "The critical points lie on the parabolic cylinder $v={u}^{2}.$" #edb/ref 17592186045585] [17592186401285 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186401285 #edb/ref 1084 #uuid "a6795027-5482-5bff-8214-2dd2cc097fe2" #edb/ref 17592186045585] [17592186401286 #edb/ref 1081 "The critical points lie on the $vw-$ plane." #edb/ref 17592