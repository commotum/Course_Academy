 17592186045585 true] [17592186406800 1075 #edb/ref 17592186406793 13194139533516 17592186045585 true] [17592186406800 1075 #edb/ref 17592186406794 13194139533516 17592186045585 true] [17592186406800 1075 #edb/ref 17592186406797 13194139533516 17592186045585 true] [17592186406800 1075 #edb/ref 17592186406799 13194139533516 17592186045585 true] [17592186406800 1076 #edb/ref 17592186045493 13194139533516 17592186045585 true] [17592186406800 1077 "selection" 13194139533516 17592186045585 true] [17592186406800 1079 #edb/ref 17592186406791 13194139533516 17592186045585 true] [17592186406800 1080 #uuid "06a97003-66fd-5b44-944b-7b4ac3d8364b" 13194139533516 17592186045585 true] [17592186406801 1075 #edb/ref 17592186406790 13194139533516 17592186045585 true] [17592186406801 1075 #edb/ref 17592186406792 13194139533516 17592186045585 true] [17592186406801 1075 #edb/ref 17592186406795 13194139533516 17592186045585 true] [17592186406801 1075 #edb/ref 17592186406796 13194139533516 17592186045585 true] [17592186406801 1075 #edb/ref 17592186406798 13194139533516 17592186045585 true] [17592186406801 1076 #edb/ref 17592186045493 13194139533516 17592186045585 true] [17592186406801 1077 "selection" 13194139533516 17592186045585 true] [17592186406801 1079 #edb/ref 17592186406792 13194139533516 17592186045585 true] [17592186406801 1080 #uuid "bc7e9e1f-8201-5457-9ae8-866cb0a50e5b" 13194139533516 17592186045585 true] [17592186406802 1068 #edb/ref 17592186406800 13194139533516 17592186045585 true] [17592186406802 1069 "q-161810" 13194139533516 17592186045585 true] [17592186406802 1070 #edb/ref 17592186045487 13194139533516 17592186045585 true] [17592186406802 1071 "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+vw \\\\ {v}^{2} \\\\ w+v\\end{aligned}].\n$$" 13194139533516 17592186045585 true] [17592186406802 1072 #uuid "84951e54-c705-5b01-85eb-275b777e397c" 13194139533516 17592186045585 true] [17592186406802 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+vw,\\,y(u,v,w)={v}^{2},\\,z(u,v,w)=w+v.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =w & \\,\\frac{∂x}{∂w} & =v \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =2v & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & w & v \\\\ 0 & 2v & 0 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2v & 0 \\\\ 1 & 1\\end{aligned}| \\\\  & =1(2v-0) \\\\  & =2v.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 2v & =0 \\\\ v & =0.\\end{aligned}\n$$\n\nThe equation $v=0$ defines the plane $v=0,$ i.e., $uw$-plane." 13194139533516 17592186045585 true] [17592186406803 1068 #edb/ref 17592186406801 13194139533516 17592186045585 true] [17592186406803 1069 "q-39710" 13194139533516 17592186045585 true] [17592186406803 1070 #edb/ref 17592186045487 13194139533516 17592186045585 true] [17592186406803 1071 "Find the Jacobian determinant of the transformation $T$ that maps the $uvw$-space into the $xyz$-space by means of the equations\n\n$$\nx={u}^{2}+vw,\\,y=2-uv,\\,z={v}^{2}-w.\n$$" 13194139533516 17592186045585 true] [17592186406803 1072 #uuid "9eac1497-79c1-5ed3-be68-00cfa0edfef5" 13194139533516 17592186045585 true] [17592186406803 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2u & \\,\\frac{∂x}{∂v} & =w & \\,\\frac{∂x}{∂w} & =v \\\\ \\frac{∂y}{∂u} & =-v & \\,\\frac{∂y}{∂v} & =-u & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =2v & \\,\\frac{∂z}{∂w} & =-1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}2u & w & v \\\\ -v & -u & 0 \\\\ 0 & 2v & -1\\end{aligned}| \\\\  & =2u(-1)^{1+1}|\\begin{aligned}-u & 0 \\\\ 2v & -1\\end{aligned}|+(-v)(-1)^{2+1}|\\begin{aligned}w & v \\\\ 2v & -1\\end{aligned}| \\\\  & =2u(u-0)+v(-w-2{v}^{2}) \\\\  & =2{u}^{2}-2{v}^{3}-vw.\\end{aligned}\n$$" 13194139533516 17592186045585 true]] :edb/tempids {"answer-03b82058-2ed1-5ab3-8be0-f2ccd9e791be" 17592186406790 "answer-06cfa4e4-4978-5d07-b498-b67163d323ba" 17592186406791 "answer-2b07851c-5666-5e08-93b4-ea52710578c9" 17592186406792 "answer-47f0e73b-3fcc-5922-ac4c-5cbbb15dc078" 17592186406793 "answer-4cd27081-6df8-5fcc-87e8-0b763e12dd24" 17592186406794 "answer-4e04d287-7eaa-501d-ba5e-706a25e1adcd" 17592186406795 "answer-78a6574d-a7a7-5dd3-9372-265b4fd8dfa8" 17592186406796 "answer-bdd4d236-b060-5654-b754-6a3374d3448b" 17592186406797 "answer-c5d7dba0-5d86-5a7b-97ed-55ed0cf1cb1c" 17592186406798 "answer-ddaabaf5-f0e8-54a9-9f5a-d6c4751feaf2" 17592186406799 "answer-fie