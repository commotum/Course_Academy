db/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe230bdd-3a20-59d7-b749-5cc881ab022a" :question/math-academy-id "q-42605" :question/problem "Consider the system of equations \n\n$$\n\\{\\begin{aligned}x-3y=2 \\\\ x+5y=10.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $x=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}x-3y=2 \\\\ x+5y=10.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}1 & -3 \\\\ 1 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nNow, we construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}2 & -3 \\\\ 10 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{|\\begin{aligned}2 & -3 \\\\ 10 & 5\\end{aligned}|}{|\\begin{aligned}1 & -3 \\\\ 1 & 5\\end{aligned}|}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329669 :knowledge-point/_questions [{:db/id #edb/ref 17592186119788 :knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4" :knowledge-point/title "Expressing an Unknown in Terms of 2x2 Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530f7601-74e9-540a-82ef-db390518a6fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}3 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|}" :db/id #edb/ref 17592186327654} {:answer/id #uuid "79e605a3-e423-5657-86b5-efaa7336486b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}-4 & 32 \\\\ -3 & 26\\end{aligned}|}" :db/id #edb/ref 17592186327978} {:answer/id #uuid "81226cb7-cf78-526b-97c8-cf96fa7e7496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}10 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}6 & 4 \\\\ 5 & 3\\end{aligned}|}" :db/id #edb/ref 17592186328047} {:answer/id #uuid "964a6cc0-3d53-58e3-a342-0e852fe595d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}32 & 6 \\\\ 6 & 15\\end{aligned}|}{|\\begin{aligned}4 & -6 \\\\ 3 & 5\\end{aligned}|}" :db/id #edb/ref 17592186328240} {:answer/id #uuid "b8b4809e-a7e6-57f1-8a82-dee22d55f5e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|}" :db/id #edb/ref 17592186328541}] :answer-field/correct {:answer/id #uuid "b8b4809e-a7e6-57f1-8a82-dee22d55f5e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|}" :db/id #edb/ref 17592186328541} :answer-field/id #uuid "9d31b58d-0925-5521-9b7e-3d57b98648de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8917d445-979c-51b8-8583-088afcba0337" :question/math-academy-id "q-42607" :question/problem "Consider the system of equations\n\n$$\n\\{\\begin{aligned}4x+6y=32 \\\\ 3x+5y=26.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $x=$" :question/worked-solution "We are given the system\n\n$$\n\\{\\begin{aligned}4x+6y=32 \\\\ 3x+5y=26.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nNow, we construct ${D}_{x}$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{|\\begin{aligned}32 & 6 \\\\ 26 & 5\\end{aligned}|}{|\\begin{aligned}4 & 6 \\\\ 3 & 5\\end{aligned}|}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329671 :knowledge-point/_questions [{:db/id #edb/ref 17592186119844 :knowledge-point/id #uuid "e7580024-f357-57d4-94f2-85c25e2c144b" :knowledge-point/title "Identifying the Parts of Cramer's Rule Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5083ccb3-327d-53a5-8c33-8e6294c999da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & -12 \\\\ 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186327634} {:answer/id #uuid "6c2e11cf-dc76-557e-a61b-719092f1274e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-3 & 4 \\\\ 2 & -12\\end{aligned}|" :db/id #edb/ref 17592186327866} {:answer/id #uuid "c9f17ee1-590d-5ded-93bf-55b539b0104a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & -3 \\\\ -12 & -4\\end{aligned}|" :db/id #edb/ref 17592186328706} {:answer/id #uuid "cabe9e7e-4ce2-5251-99b0-0d3e1845f9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-12 & -3 \\\\ 4 & -4\\end{aligned}|" :db/id #edb/ref 17592186328709} {:answer/id #uuid "d825455f-6ee6-5acd-802a-73d7c9648bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & -3 \\\\ -12 & 2\\end{aligned}|" :db/id #edb/ref 17592186328829}] :answer-field/correct {:answer/id #uuid "c9f17ee1-590d-5ded-93bf-55b539b0104a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & -3