#{[{:activity/first-step {:db/id #edb/ref 17592186120652} :activity/id #uuid "acb4d472-a6fc-5c2c-a30f-1918865acaa4" :activity/scope {:db/id #edb/ref 17592186050129 :topic/id #uuid "2eee4710-3f26-5186-948b-a819cfaf4083" :topic/math-academy-id 1775} :activity/steps [{:db/id #edb/ref 17592186120647 :step/content {:db/id #edb/ref 17592186119788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119599 :question/id #uuid "4efedc4e-19e9-552c-bc27-814df953e141" :question/math-academy-id "e-4575"} :knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4" :knowledge-point/questions [{:db/id #edb/ref 17592186120437} {:db/id #edb/ref 17592186120438} {:db/id #edb/ref 17592186329669} {:db/id #edb/ref 17592186329670} {:db/id #edb/ref 17592186329701} {:db/id #edb/ref 17592186338748} {:db/id #edb/ref 17592186388632} {:db/id #edb/ref 17592186393681}] :knowledge-point/title "Expressing an Unknown in Terms of 2x2 Determinants"} :step/id #uuid "8cb786bc-aa30-57b8-aa52-e09a7018f11b" :step/math-academy-id 16704 :step/next {:db/id #edb/ref 17592186120650}} {:db/id #edb/ref 17592186120650 :step/content {:db/id #edb/ref 17592186119790 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119601 :question/id #uuid "311ba12f-de22-580c-9e0d-6766f7864d1a" :question/math-academy-id "e-4578"} :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/questions [{:db/id #edb/ref 17592186120439} {:db/id #edb/ref 17592186120448} {:db/id #edb/ref 17592186271990} {:db/id #edb/ref 17592186271991} {:db/id #edb/ref 17592186329673} {:db/id #edb/ref 17592186329702} {:db/id #edb/ref 17592186338767} {:db/id #edb/ref 17592186345293} {:db/id #edb/ref 17592186345294}] :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule"} :step/id #uuid "0691d00f-77e7-57d5-b71b-b1153b0b4afa" :step/math-academy-id 16710} {:db/id #edb/ref 17592186120652 :step/content {:db/id #edb/ref 17592186121027 :tutorial/content "**Cramer's Rule** is a method for solving a linear system of equations using determinants.\n\nSuppose we have a square system of linear equations\n\n$$\n{\\begin{aligned}{a}_{11}x+{a}_{12}y={b}_{1} \\\\ {a}_{21}x+{a}_{22}y={b}_{2},\\end{aligned}\n$$\n\nwhere $|\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}|$ Then Cramer's rule states that\n\n$$\nx =  \\dfrac{D_x}{D}, \\qquad y = \\dfrac{D_y}{D}\n$$\n\nis the unique solution of the system, where\n\n$$\n|\\begin{aligned}{b}_{1} & {a}_{12} \\\\ {b}_{2} & {a}_{22}\\end{aligned}|\n$$\n\nFor example, let's use Cramer's rule to solve the following system of equations:\n\n$$\n{\\begin{aligned}3x-2y=-1 \\\\ -1x+2y=3\\end{aligned}\n$$\n\nWe start by finding the **determinant of the coefficient matrix**:\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}3 & -2 \\\\ -1 & 2\\end{aligned}| \\\\  & =3\\cdot 2-(-1)\\cdot (-2) \\\\  & =4\\end{aligned}\n$$\n\nNow, we compute $D_x$ and $D_y\\mathbin{:}$\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}-1 & -2 \\\\ 3 & 2\\end{aligned}| \\\\  & =(-1)\\cdot 2-3\\cdot (-2) \\\\  & =4 \\\\ {D}_{y} & =|\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}| \\\\  & =3\\cdot 3-(-1)\\cdot (-1) \\\\  & =8\\end{aligned}\n$$\n\nFinally, the solution to the system is given by\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{4}{4}=1, \\\\ y & =\\frac{{D}_{y}}{D}=\\frac{8}{4}=2.\\end{aligned}\n$$\n\nIt is common to write the solutions to a linear system as a vector. So, in this case, we have\n\n$$\n\\left< x,y \\right> = \\left< 1,2 \\right>.\n$$" :tutorial/id #uuid "3adc5c1c-58e5-5c0a-a8f7-da6abd6f06e2" :tutorial/math-academy-id 3102 :tutorial/title "Introduction"} :step/id #uuid "48887938-d6a0-5822-b084-3bf10a3a4461" :step/math-academy-id 16830 :step/next {:db/id #edb/ref 17592186120731}} {:db/id #edb/ref 17592186120731 :step/content {:db/id #edb/ref 17592186119844 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119658 :question/id #uuid "d81e32a1-bd93-5a95-bb4a-e8df9063b5aa" :question/math-academy-id "e-5230"} :knowledge-point/id #uuid "e7580024-f357-57d4-94f2-85c25e2c144b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049044}] :knowledge-point/questions [{:db/id #edb/ref 17592186120446} {:db/id #edb/ref 17592186120447} {:db/id #edb/ref 17592186271976} {:db/id #edb/ref 17592186329671} {:db/id #edb/ref 17592186329672} {:db/id #edb/ref 17592186338763} {:db/id #edb/ref 17592186338764} {:db/id #edb/ref 17592186392541} {:db/id #edb/ref 17592186402854}] :knowledge-point/title "Identifying the Parts of Cramer's Rule Formula"} :step/id #uuid "720a6f93-380c-5e70-8c81-e99f44a4ef11" :step/math-academy-id 19262 :step/next {:db/id #edb/ref 17592186120647}}] :activity/title "Cramer’s Rule for 2x2 Systems of Linear Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186119997}]}
