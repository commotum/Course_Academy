#{[{:db/id #edb/ref 17592186265762 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3caa2291-4781-5d49-9cf0-05616cc899e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.88" :db/id #edb/ref 17592186263542} {:answer/id #uuid "6b2d1e6e-8f7d-5fad-ad7a-3806bd5dc59e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.98" :db/id #edb/ref 17592186263924} {:answer/id #uuid "707ba34c-bab5-5a04-b941-dc29d462b79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.93" :db/id #edb/ref 17592186263973} {:answer/id #uuid "73de42ef-7102-53a5-ae70-a213df8590b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.03" :db/id #edb/ref 17592186264008} {:answer/id #uuid "b0b5cd27-fbea-5768-a42b-ce72b13039ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.09" :db/id #edb/ref 17592186264523}] :answer-field/correct {:answer/id #uuid "3caa2291-4781-5d49-9cf0-05616cc899e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.88" :db/id #edb/ref 17592186263542} :answer-field/id #uuid "cc70e084-f962-56a8-b409-6b4140bd2930" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73178492-8508-56c4-9569-cdff37299fa0" :question/math-academy-id "q-129654" :question/problem "Suppose that $f(x,y,z)$ is a differentiable function such that\n\n$$\nf(1,0,-1)=1,\\,{f}_{x}(1,0,-1)=-1,\\,{f}_{y}(1,0,-1)=-1,\\,{f}_{z}(1,0,-1)=0.\n$$\n\nUsing a linear approximation of $f$ at the point $(1,0,-1)$ estimate the value of $f(1.02,0.1,-0.96)$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,0,-1)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,0,-1)+∇f(1,0,-1)\\cdot ⟨x-1,y-0,z-(-1)⟩ \\\\  & =f(1,0,-1)+⟨{f}_{x}(1,0,-1),{f}_{y}(1,0,-1),{f}_{z}(1,0,-1)⟩\\cdot ⟨x-1,y,z+1⟩ \\\\  & =1+⟨-1,-1,0⟩\\cdot ⟨x-1,y,z+1⟩.\\end{aligned}\n$$\n\nWe can approximate $f(1.02,0.1,-0.96)$ by evaluating the linear approximation at $x=1.02,$ $y=0.1,$ and $z=-0.96$ as follows:\n\n$$\n\\begin{aligned}f(1.02,0.1,-0.96) & ≈1+⟨-1,-1,0⟩\\cdot ⟨1.02-1,0.1,-0.96+1⟩ \\\\  & =1+⟨-1,-1,0⟩\\cdot ⟨0.02,0.1,0.04⟩ \\\\  & =1-1(0.02)-1(0.1)+0(0.04) \\\\  & =1-0.02-0.1+0 \\\\  & =0.88\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489249 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7d0aa5-2342-5d6f-a521-a62d6d54725c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈-\\frac{1}{6}-\\frac{x}{108}+\\frac{y}{54}+\\frac{z}{54}" :db/id #edb/ref 17592186488506} {:answer/id #uuid "4c8e5783-e729-5001-b425-9bd95d7f94c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488619} {:answer/id #uuid "52aebee7-a1be-5094-b50c-2fecab43978c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈-\\frac{1}{6}-\\frac{x}{108}-\\frac{y}{108}-\\frac{z}{108}" :db/id #edb/ref 17592186488628} {:answer/id #uuid "8b357635-83ca-53f3-be6f-efc2212bf65c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}+\\frac{x}{108}+\\frac{y}{54}+\\frac{z}{54}" :db/id #edb/ref 17592186488749} {:answer/id #uuid "bac0b568-47cf-5aed-a2d1-d6ae3ec5aafb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{54}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488846}] :answer-field/correct {:answer/id #uuid "4c8e5783-e729-5001-b425-9bd95d7f94c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y,z)≈\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}" :db/id #edb/ref 17592186488619} :answer-field/id #uuid "c5948ebf-b36f-50ef-996a-235488992a7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489127}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d2fd7c0-6fec-5b30-98fe-3b0bf10ba9a4" :question/math-academy-id "q-65338" :question/problem "Let $f(x,y,z)=\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}.$ Find the linear approximation of $f$ at the point $(2,4,4).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(2,4,4)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,4,4)+∇f(2,4,4)\\cdot ⟨x-2,y-4,z-4⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(2,4,4)=\\frac{1}{6}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =-\\frac{x}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{x}(2,4,4)=-\\frac{2}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{108}, \\\\ {f}_{y} & =-\\frac{y}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{y}(2,4,4)=-\\frac{4}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{54}, \\\\ {f}_{z} & =-\\frac{z}{{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}}\\,⇒\\,{f}_{z}(2,4,4)=-\\frac{4}{{({2}^{2}+{4}^{2}+{4}^{2})}^{3/2}}=-\\frac{1}{54}.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(2,4,4)$ is given by\n\n$$\n\\begin{aligned}∇f(2,4,4) & =⟨{f}_{x}(2,4,4),{f}_{y}(2,4,4),{f}_{z}(2,4,4)⟩ \\\\  & =⟨-\\frac{1}{108},-\\frac{1}{54},-\\frac{1}{54}⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(2,4,4)+∇f(2,4,4)\\cdot ⟨x-2,y-4,z-4⟩ \\\\  & =\\frac{1}{6}+⟨-\\frac{1}{108},-\\frac{1}{54},-\\frac{1}{54}⟩\\cdot ⟨x-2,y-4,z-4⟩ \\\\  & =\\frac{1}{6}-\\frac{1}{108}(x-2)-\\frac{1}{54}(y-4)-\\frac{1}{54}(z-4) \\\\  & =\\frac{1}{6}-\\frac{x}{108}+\\frac{1}{54}-\\frac{y}{54}+\\frac{4}{54}-\\frac{z}{54}+\\frac{4}{54} \\\\  & =\\frac{1}{3}-\\frac{x}{108}-\\frac{y}{54}-\\frac{z}{54}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186425853 :knowledge-point/_questions [{:db/id #edb/ref 17592186124610 :knowledge-point/id #uuid "b1639105-dca4-50d1-8d86-a7aed03ba0b5" :knowledge-point/title "Estimating the Value of a Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d1682a6-0223-5ed8-8277-0f5be1c651f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.48" :db/id #edb/ref 17592186425837} {:answer/id #uuid "5c547bf0-6a15-5b93-836e-c0f81afbd41f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.72" :db/id #edb/ref 17592186425840} {:answer/id #uuid "c614f0d9-6fb7-53fc-b7ea-7df222acd263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.61" :db/id #edb/ref 17592186425843} {:answer/id #uuid "ce98542a-f5c0-51c4-ab6c-242d4d9c6e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.55" :db/id #edb/ref 17592186425845} {:answer/id #uuid "d5f80dc7-8dae-5243-9e68-a3715cc5329a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.95" :db/id #edb/ref 17592186425847}] :answer-field/correct {:answer/id #uuid "c614f0d9-6fb7-53fc-b7ea-7df222acd263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.61" :db/id #edb/ref 17592186425843} :answer-field/id #uuid "b0b6b4b5-7cfe-50c1-9f11-ac3785660947" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e7afc5f-975b-58b4-8d28-e717181d277e" :question/math-academy-id "q-98349" :question/problem "Let $f(x,y,z)$ be a differentiable function such that\n\n$$\n\\begin{aligned}f(1,0,3)=-9,\\,{f}_{x}(x,y,z)=y,\\,{f}_{y}(x,y,z)=x,\\,{f}_{z}(x,y,z)=-2z.\\end{aligned}\n$$\n\nUsing a linear approximation of $f$ at the point $(1,0,3),$ estimate the value of $f(0.98,-0.01,3.1).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,0,3)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,0,3)+∇f(1,0,3)\\cdot ⟨x-1,y-0,z-3⟩ \\\\  & =-9+⟨{f}_{x}(1,0,3),{f}_{y}(1,0,3),{f}_{z}(1,0,3)⟩\\cdot ⟨x-1,y,z-3⟩.\\end{aligned}\n$$\n\nNow, we find ${f}_{x}(1,0,3)$, ${f}_{y}(1,0,3)$ and ${f}_{z}(1,0,3),$ using the given partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(1,0,3) & =0 \\\\ {f}_{y}(1,0,3) & =1 \\\\ {f}_{z}(1,0,3) & =-6\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nf(x,y,z)≈-9+⟨0,1,-6⟩\\cdot ⟨x-1,y,z-3⟩.\n$$\n\nFinally, we can estimate $f(0.98,-0.01,3.1)$ by evaluating the linear approximation at $x=0.98,y=-0.01$ and $z=3.1,$ as follows:\n\n$$\n\\begin{aligned}f(0.98,-0.01,3.1) & ≈-9+⟨0,1,-6⟩\\cdot ⟨0.98-1,-0.01,3.1-3⟩ \\\\  & =-9+⟨0,1,-6⟩\\cdot ⟨-0.02,-0.01,0.1⟩ \\\\  & =-9-0.01-0.6 \\\\  & =-9.61\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489212 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2731dfc7-d2c6-5c2c-a042-6a0654dbb592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈35+9x+12y" :db/id #edb/ref 17592186488553} {:answer/id #uuid "699fa767-12e0-5e62-9b8f-2b731f1a39e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈41+6x+12y" :db/id #edb/ref 17592186488677} {:answer/id #uuid "7a449c97-159a-5f59-a721-89db59ab69e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈23-9x-6y" :db/id #edb/ref 17592186488714} {:answer/id #uuid "a8fec697-0895-5a3c-96df-884cfd51b791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈35-9x+6y" :db/id #edb/ref 17592186488806} {:answer/id #uuid "fb391dd4-bbf2-513b-9210-bd1b8336cab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈23+9x-6y" :db/id #edb/ref 17592186489003}] :answer-field/correct {:answer/id #uuid "2731dfc7-d2c6-5c2c-a042-6a0654dbb592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈35+9x+12y" :db/id #edb/ref 17592186488553} :answer-field/id #uuid "dbb4d8a0-1307-529a-b016-d7f1bd8d71e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489144}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a523061-b982-5542-a530-946bca7d0e33" :question/math-academy-id "q-98552" :question/problem "Let $f(x,y)=x{y}^{2}-1.$ Find the linear approximation of $f$ at the point $(-2,-3).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-2,-3)$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-2,-3)+∇f(-2,-3)\\cdot ⟨x+2,y+3⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(-2,-3)=-19.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & ={y}^{2}\\, &  & ⇒\\,{f}_{x}(-2,-3)=(-3)^{2}=9, \\\\ {f}_{y} & =2xy &  & ⇒\\,{f}_{y}(-2,-3)=2(-2)(-3)=12.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(-2,-3)$ is given by\n\n$$\n\\begin{aligned}∇f(-2,-3) & =⟨9,12⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-2,-3)+∇\\,f(-2,-3)\\cdot ⟨x+2,\\,y+3⟩ \\\\  & =-19+⟨9,12⟩\\cdot ⟨x+2,\\,y+3⟩ \\\\  & =-19+9(x+2)+12(y+3) \\\\  & =35+9x+12y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404946 :knowledge-point/_questions [{:db/id #edb/ref 17592186124451 :knowledge-point/id #uuid "0015e19e-222b-5c5b-a020-93392c50c10e" :knowledge-point/title "Finding the Best Linear Approximation of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2803179-deb8-5b5d-8dc3-c87b7f30ccbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈2\\operatorname{ln}⁡2-x-y" :db/id #edb/ref 17592186404948} {:answer/id #uuid "00a43c2f-3146-563d-a70e-8ed6a8db819c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈2\\operatorname{ln}⁡2+2x+y" :db/id #edb/ref 17592186404949} {:answer/id #uuid "06c16dd4-4550-535b-882e-e29298a652c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈-2-x+y" :db/id #edb/ref 17592186404950} {:answer/id #uuid "1bf2d0ae-13a3-53c2-9b69-e902b7337d53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈-2+2x-2y" :db/id #edb/ref 17592186404951} {:answer/id #uuid "311b8139-e8df-52d9-8b84-27e1171d5a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈2\\operatorname{ln}⁡2+2x-2y" :db/id #edb/ref 17592186404952}] :answer-field/correct {:answer/id #uuid "311b8139-e8df-52d9-8b84-27e1171d5a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x,y)≈2\\operatorname{ln}⁡2+2x-2y" :db/id #edb/ref 17592186404952} :answer-field/id #uuid "ecf12e78-7f08-5ce3-b44f-e89da0101f91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404947}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02cd9397-a795-5b68-a5d4-f55d0d92f60a" :question/math-academy-id "q-98553" :question/problem "Let $f(x,y)=x{e}^{y}.$ Find the linear approximation of $f$ at the point $(-1,\\operatorname{ln}⁡2).$" :question/worked-solution "The linear approximation of the function $f$ at the point $(a,b)$ is given by\n\n$$\nf(x,y)≈f(a,b)+∇f(a,b)\\cdot ⟨x-a,y-b⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(-1,\\operatorname{ln}⁡2)$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-1,\\operatorname{ln}⁡2)+∇f(-1,\\operatorname{ln}⁡2)\\cdot ⟨x+1,y-\\operatorname{ln}⁡2⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(-1,\\operatorname{ln}⁡2)=-2.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & ={e}^{y}\\, &  & ⇒\\, & {f}_{x}(-1,\\operatorname{ln}⁡2)={e}^{\\operatorname{ln}⁡2}=2, \\\\ {f}_{y} & =x{e}^{y} &  & ⇒\\, & {f}_{y}(-1,\\operatorname{ln}⁡2)=-1{e}^{\\operatorname{ln}⁡2}=-2.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(-1,\\operatorname{ln}⁡2)$ is given by\n\n$$\n\\begin{aligned}∇f(-1,\\operatorname{ln}⁡2) & =⟨2,-2⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(-1,\\operatorname{ln}⁡2)+∇\\,f(-1,\\operatorname{ln}⁡2)\\cdot ⟨x+1,\\,y-\\operatorname{ln}⁡2⟩ \\\\  & =-2+⟨2,-2⟩\\cdot ⟨x+1,\\,y-\\operatorname{ln}⁡2⟩ \\\\  & =-2+2(x+1)-2(y-\\operatorname{ln}⁡2) \\\\  & =2\\operatorname{ln}⁡2+2x-2y.\\end{aligned}\n$$"}]}
