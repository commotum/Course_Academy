03574 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186503574 #edb/ref 1078 #edb/ref 17592186503351 #edb/ref 17592186045417] [17592186503574 #edb/ref 1079 #uuid "7e77c422-979d-5619-b2c9-5f0629b862dd" #edb/ref 17592186045417] [17592186503580 #edb/ref 1075 #edb/ref 17592186503004 #edb/ref 17592186045417] [17592186503580 #edb/ref 1075 #edb/ref 17592186503232 #edb/ref 17592186045417] [17592186503580 #edb/ref 1075 #edb/ref 17592186503247 #edb/ref 17592186045417] [17592186503580 #edb/ref 1075 #edb/ref 17592186503265 #edb/ref 17592186045417] [17592186503580 #edb/ref 1075 #edb/ref 17592186503379 #edb/ref 17592186045417] [17592186503580 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186503580 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186503580 #edb/ref 1078 #edb/ref 17592186503232 #edb/ref 17592186045417] [17592186503580 #edb/ref 1079 #uuid "83693d58-e295-516a-afbd-27422e50c864" #edb/ref 17592186045417] [17592186503655 #edb/ref 1068 #edb/ref 17592186503580 #edb/ref 17592186045417] [17592186503655 #edb/ref 1069 "q-109092" #edb/ref 17592186045417] [17592186503655 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186503655 #edb/ref 1071 "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=2,$ calculate $\\text{Var}[\\sqrt{3}X-5].$ \n\n| $x$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |" #edb/ref 17592186045417] [17592186503655 #edb/ref 1072 #uuid "0fdadb20-0f32-5fc9-95d6-7a680685f826" #edb/ref 17592186045417] [17592186503655 #edb/ref 1074 "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{3}$ and $b=-5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & ={\\sqrt{3}}^{2}\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=2.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =4\\cdot \\frac{1}{3}+16\\cdot \\frac{1}{3} \\\\  & =\\frac{20}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{20}{3}-{2}^{2} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & =3\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\frac{8}{3} \\\\  & =8.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186503675 #edb/ref 1068 #edb/ref 17592186503574 #edb/ref 17592186045417] [17592186503675 #edb/ref 1069 "q-109042" #edb/ref 17592186045417] [17592186503675 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186503675 #edb/ref 1071 "Calculate $\\text{Var}[\\sqrt{b}]$ where $b\\ge 0$ is a constant." #edb/ref 17592186045417] [17592186503675 #edb/ref 1072 #uuid "359cefbe-6818-5849-92c9-d932909be650" #edb/ref 17592186045417] [17592186503675 #edb/ref 1074 "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore, since $b$ is a constant, we have\n\n$$\n\\text{Var}[\\sqrt{b}]=0.\n$$" #edb/ref 17592186045417] [17592186503707 #edb/ref 1068 #edb/ref 17592186503568 #edb/ref 17592186045417] [17592186503707 #edb/ref 1069 "q-108938" #edb/ref 17592186045417] [17592186503707 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186503707 #edb/ref 1071 "If $\\text{Var}[X]=6,$ calculate $\\text{Var}[-3X].$" #edb/ref 17592186045417] [17592186503707 #edb/ref 1072 #uuid "8094ceca-7731-54ab-bb63-d28e40db7d50" #edb/ref 17592186045417] [17592186503707 #edb/ref 1074 "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\text{Var}[X].\n$$\n\nIn our case, $a=-3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-3X] & =(-3)^{2}\\cdot \\text{Var}[X] \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186503772 #edb/ref 1058 #edb/ref 17592186503779 #edb/ref 17592186045417] [17592186503772 #edb/ref 1062 #uuid "23144d7f-489b-5b2c-8362-1966c6bcebea" #edb/ref 17592186045417] [17592186503772 #edb/ref 1063 #edb/ref 17592186420138 #edb/ref 17592186045417] [17592186503774 #edb/ref 1058 #edb/ref 17592186503835 #edb/ref 17592186045417] [17592186503774 #edb/ref 1062 #uuid "2b268847-a40d-5cb1-9002-041f5606d47e" #edb/ref 17592186045417] [17592186503774 #edb/ref 1063 #edb/ref 17592186162266 #edb/ref 17592186045417] [17592186503779 #edb/ref 1062 #uuid "424ccc4b-8399-55e5-854c-ab879e6c171a" #edb/ref 17592186045417] [17592186503779 #edb/ref 1063 #edb/ref 17592186503655 #edb/ref 17592186045417] [17592186503791 #edb/ref 1058 #edb/ref 17592186503774 #edb/ref 17592186045417] [17592186503791 #edb/ref 1062 #uuid "5c0b7eb0-1a52-51a1-9c96-7fa97306cc01" #edb/ref 17592186045417] [17592186503791 #edb/ref 1063 #edb/ref 17592186503707 #edb/ref 17592186045417] [17592186503835 #edb/ref 1058 #edb/ref 17592186503772 #edb/ref 17592186045417] [17592186503835 #edb/ref 1062 #uuid "ee13848c-afef-59a9-a58f-0082bc13ce48" #edb/ref 17592186045417] [17592186503835 #edb/ref 1063 #edb/ref 17592186503675 #edb/ref 17592186045417]}
