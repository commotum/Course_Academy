#{[{:db/id #edb/ref 17592186503707 :knowledge-point/_questions [{:db/id #edb/ref 17592186162057 :knowledge-point/id #uuid "8a3752a0-431d-5520-97b1-493c36bbce54" :knowledge-point/title "Computing the Variance of a Scaled Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013b7439-a140-520f-a3ac-519c465f78f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186502980} {:answer/id #uuid "29e976a2-85af-553f-9ce9-c7465b54a556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186503060} {:answer/id #uuid "57bfcaf4-7c52-5d64-a48a-af0c76f08b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186503151} {:answer/id #uuid "65ebf54d-2206-5935-9b35-5ab2a66dca75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186503182} {:answer/id #uuid "6cf3c46e-e77a-5c78-b951-5c6d1e51165d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-54" :db/id #edb/ref 17592186503199}] :answer-field/correct {:answer/id #uuid "013b7439-a140-520f-a3ac-519c465f78f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186502980} :answer-field/id #uuid "7470db9e-9f89-5eb5-aa1d-a389b249518e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503568}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8094ceca-7731-54ab-bb63-d28e40db7d50" :question/math-academy-id "q-108938" :question/problem "If $\\text{Var}[X]=6,$ calculate $\\text{Var}[-3X].$" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\text{Var}[X].\n$$\n\nIn our case, $a=-3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-3X] & =(-3)^{2}\\cdot \\text{Var}[X] \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162266 :knowledge-point/_questions [{:db/id #edb/ref 17592186162057 :knowledge-point/id #uuid "8a3752a0-431d-5520-97b1-493c36bbce54" :knowledge-point/title "Computing the Variance of a Scaled Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df20dc58-5b67-5b4a-a4b8-eca19f0be704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186158799} {:answer/id #uuid "1253e8d1-5192-596f-970c-1553a00ebc59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186158800} {:answer/id #uuid "2610e250-1e87-5e70-911e-ced87d38d5a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186158801} {:answer/id #uuid "322e03be-95c4-5fdf-9538-cfd90f4a2b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186158802} {:answer/id #uuid "7d810ec3-fb2e-5820-ae2e-d55f7775e2d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186158803}] :answer-field/correct {:answer/id #uuid "2610e250-1e87-5e70-911e-ced87d38d5a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186158801} :answer-field/id #uuid "fdd49fee-8241-5a92-8763-eb72406aa943" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f809e4ca-96d1-5ff3-9f14-e230cdb13096" :question/math-academy-id "q-108945" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=7,$ calculate $\\text{Var}[5X].$ \n\n| $x$ | $5$ | $6$ | $9$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ | $\\frac{2}{5}$ |" :question/requires-calculator true :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & ={5}^{2}\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=7.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{9}^{2}\\cdot f(9) \\\\  & =25(\\frac{1}{5})+36(\\frac{2}{5})+81(\\frac{2}{5}) \\\\  & =\\frac{259}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{259}{5}-{7}^{2} \\\\  & =\\frac{259}{5}-49 \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & =25\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\frac{14}{5} \\\\  & =14\\cdot 5 \\\\  & =70.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503675 :knowledge-point/_questions [{:db/id #edb/ref 17592186162056 :knowledge-point/id #uuid "405984cd-1e1b-54c6-bc75-268e127b9812" :knowledge-point/title "Computing the Variance of a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aca28fc-b435-5f30-827e-ee7d02529481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{b}" :db/id #edb/ref 17592186503090} {:answer/id #uuid "8e88be9e-beec-5707-8a75-1d982aa90617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b" :db/id #edb/ref 17592186503267} {:answer/id #uuid "9e23a02a-2881-5785-a934-6bc6623f7104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{b}}" :db/id #edb/ref 17592186503297} {:answer/id #uuid "b518096f-1014-55cc-a4c7-95699e9c75b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186503351} {:answer/id #uuid "f44c1787-6ed5-5b2b-96cb-f32a094f7386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186503482}] :answer-field/correct {:answer/id #uuid "b518096f-1014-55cc-a4c7-95699e9c75b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186503351} :answer-field/id #uuid "7e77c422-979d-5619-b2c9-5f0629b862dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503574}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "359cefbe-6818-5849-92c9-d932909be650" :question/math-academy-id "q-109042" :question/problem "Calculate $\\text{Var}[\\sqrt{b}]$ where $b\\ge 0$ is a constant." :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore, since $b$ is a constant, we have\n\n$$\n\\text{Var}[\\sqrt{b}]=0.\n$$"}] [{:db/id #edb/ref 17592186420138 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fcdc20-d9ce-5918-a799-224704442b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186420107} {:answer/id #uuid "954c32d9-778b-5b43-8961-535d53b7d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186420118} {:answer/id #uuid "e64a66c3-6dac-5766-9242-dc560f828481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186420127} {:answer/id #uuid "f1ae131d-893b-5552-852c-ce4ade2b310c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186420129} {:answer/id #uuid "fda015bf-920f-56ce-89d7-ad20ffbb10db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186420130}] :answer-field/correct {:answer/id #uuid "954c32d9-778b-5b43-8961-535d53b7d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186420118} :answer-field/id #uuid "190cfb56-9bd3-537b-9e67-03ec6f08f929" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34f8f239-f24a-50f7-8925-78cd969b209c" :question/math-academy-id "q-109079" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=\\frac{9}{2},$ calculate $\\text{Var}[3-\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $3$ | $6$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\frac{1}{2}$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & ={(-\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=\\frac{9}{2}.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{3}^{2}\\cdot f(3)+{6}^{2}\\cdot f(6) \\\\  & =9\\cdot \\frac{1}{4}+36\\cdot \\frac{5}{8} \\\\  & =\\frac{99}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{99}{4}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{2} \\\\  & =\\frac{9}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503655 :knowledge-point/_questions [{:db/id #edb/ref 17592186162058 :knowledge-point/id #uuid "85388f7d-b2ee-520b-b711-a7721c6f620c" :knowledge-point/title "Computing the Variance of a Transformed Random Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7be9f5-de5a-5df0-8290-cf74e1a39a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186503004} {:answer/id #uuid "7af11f73-ca21-565a-a0d6-ab60cd498b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186503232} {:answer/id #uuid "8144080a-f640-5f95-9f81-bd52d80ef293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186503247} {:answer/id #uuid "8c9997f0-4985-5f75-af77-04e011b3dc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{3}-5}{3}" :db/id #edb/ref 17592186503265} {:answer/id #uuid "c82fefd9-904f-59e3-a3c8-f25e5d950641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{3}}{3}" :db/id #edb/ref 17592186503379}] :answer-field/correct {:answer/id #uuid "7af11f73-ca21-565a-a0d6-ab60cd498b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186503232} :answer-field/id #uuid "83693d58-e295-516a-afbd-27422e50c864" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fdadb20-0f32-5fc9-95d6-7a680685f826" :question/math-academy-id "q-109092" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=2,$ calculate $\\text{Var}[\\sqrt{3}X-5].$ \n\n| $x$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{3}$ and $b=-5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & ={\\sqrt{3}}^{2}\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=2.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =4\\cdot \\frac{1}{3}+16\\cdot \\frac{1}{3} \\\\  & =\\frac{20}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{20}{3}-{2}^{2} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & =3\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\frac{8}{3} \\\\  & =8.\\end{aligned}\n$$"}]}
