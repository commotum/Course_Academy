\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})^{3/4}\\,\\text{d}A & ={∬}_{Δ}{((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})}^{3/4}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}({r}^{2})^{3/4}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}{r}^{3/2}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}{r}^{5/2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[\\frac{2}{7}{r}^{7/2}]}_{1}^{4}\\,\\text{d}\\theta  \\\\  & =\\frac{2}{7}{\\int }_{0}^{2\\pi }(128-1)\\,\\text{d}\\theta  \\\\  & =\\frac{254}{7}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{254}{7}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{254}{7}\\cdot 2\\pi  \\\\  & =\\frac{508\\pi }{7}.\\end{aligned}\n$$" 13194139534805 17592186045417 true] [17592186436643 1058 #edb/ref 17592186436644 13194139534805 17592186045417 true] [17592186436643 1062 #uuid "33c2babf-7e9f-5c44-9eaf-3599485acba6" 13194139534805 17592186045417 true] [17592186436643 1063 #edb/ref 17592186354278 13194139534805 17592186045417 true] [17592186436644 1058 #edb/ref 17592186436645 13194139534805 17592186045417 true] [17592186436644 1062 #uuid "51af2359-06ac-53f8-aa4f-f5e32f6dd195" 13194139534805 17592186045417 true] [17592186436644 1063 #edb/ref 17592186354390 13194139534805 17592186045417 true] [17592186436645 1058 #edb/ref 17592186436646 13194139534805 17592186045417 true] [17592186436645 1062 #uuid "590ece9b-2d9c-50b1-94a0-0c369f325824" 13194139534805 17592186045417 true] [17592186436645 1063 #edb/ref 17592186354403 13194139534805 17592186045417 true] [17592186436646 1058 #edb/ref 17592186436647 13194139534805 17592186045417 true] [17592186436646 1062 #uuid "c4072710-5fb0-565b-81f2-33d2fc972335" 13194139534805 17592186045417 true] [17592186436646 1063 #edb/ref 17592186354406 13194139534805 17592186045417 true] [17592186436647 1062 #uuid "d00b50a9-8e9b-5ecf-92b4-773bdb165274" 13194139534805 