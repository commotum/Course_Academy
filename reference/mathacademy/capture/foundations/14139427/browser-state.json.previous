      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14139427/observations/step-q85065-a2bafe0f5ce4e2f9bedf.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14139427/observations/step-q85065-a2bafe0f5ce4e2f9bedf.png",
      "source_url": "https://mathacademy.com/tasks/14139427/topics/2835/review",
      "captured_at": 1791818322.7182693,
      "math_academy_id": "q-85065",
      "topic_id": "2835",
      "sequence_position": null,
