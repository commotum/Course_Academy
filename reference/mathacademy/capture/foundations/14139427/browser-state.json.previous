      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14139427/observations/step-q83999-a83be7a744451473de18.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14139427/observations/step-q83999-a83be7a744451473de18.png",
      "source_url": "https://mathacademy.com/tasks/14139427/topics/2835/review",
      "captured_at": 1791818272.8138857,
      "math_academy_id": "q-83999",
      "topic_id": "2835",
      "sequence_position": null,
