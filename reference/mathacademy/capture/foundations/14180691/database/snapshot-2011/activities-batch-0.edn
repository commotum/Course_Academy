#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186162887} :activity/id #uuid "86e18590-207d-5dd0-a239-bda46bcecd0a" :activity/scope {:db/id #edb/ref 17592186050751 :topic/id #uuid "63937777-cc36-5732-9734-cc239dfdbe45" :topic/math-academy-id 3025} :activity/steps [{:db/id #edb/ref 17592186162887 :step/content {:db/id #edb/ref 17592186163240 :tutorial/content "The **modes of a random variable $X$** with probability density function $f(x)$ are the values of $x$ at the global maxima of $f(x).$\n\nFor example, the modes of the random variable $X$ with the probability density function shown below are ${\\color{blue}5}$ and ${\\color{blue}9}$ (the values of $x$ that correspond to the global maxima):\n\n![](images/49/49e3f3c63c01ce5c00e9d2ff51bcd03d7516f7866f510ce091071a13a8496210.png)" :tutorial/id #uuid "e0f59103-34ab-59f2-b4c8-397a02d782d1" :tutorial/math-academy-id 4943 :tutorial/title "Introduction"} :step/id #uuid "b08187da-7bd5-55f1-ab34-d07dd9eff9c6" :step/math-academy-id 30822 :step/next {:db/id #edb/ref 17592186162888}} {:db/id #edb/ref 17592186162888 :step/content {:db/id #edb/ref 17592186162001 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161793 :question/id #uuid "21160b89-bb32-5dc5-9a4a-f7589905c913" :question/math-academy-id "e-8241"} :knowledge-point/id #uuid "a6553801-8b7e-5584-940d-a85600b44ec6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048123}] :knowledge-point/questions [{:db/id #edb/ref 17592186162648} {:db/id #edb/ref 17592186162656} {:db/id #edb/ref 17592186482522} {:db/id #edb/ref 17592186482546} {:db/id #edb/ref 17592186482564} {:db/id #edb/ref 17592186482568} {:db/id #edb/ref 17592186482573}] :knowledge-point/title "Finding the Mode of a Continuous Random Variable Using a Graph: One Mode"} :step/id #uuid "a92590f7-aa6f-5fea-a68a-758cda01da2f" :step/math-academy-id 30823 :step/next {:db/id #edb/ref 17592186162889}} {:db/id #edb/ref 17592186162889 :step/content {:db/id #edb/ref 17592186162002 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161794 :question/id #uuid "32f1849f-60e5-58bd-823a-f6bbbdb51153" :question/math-academy-id "e-8242"} :knowledge-point/id #uuid "469819e4-0596-5aba-944a-52609afc8af7" :knowledge-point/questions [{:db/id #edb/ref 17592186162649} {:db/id #edb/ref 17592186162657} {:db/id #edb/ref 17592186482553} {:db/id #edb/ref 17592186482555} {:db/id #edb/ref 17592186482572} {:db/id #edb/ref 17592186482595} {:db/id #edb/ref 17592186482610}] :knowledge-point/title "Finding the Mode of a Continuous Random Variable Using a Graph: Multiple Modes"} :step/id #uuid "1a48bd4a-b0a3-502d-aa65-671deff1ee2f" :step/math-academy-id 30824 :step/next {:db/id #edb/ref 17592186162950}} {:db/id #edb/ref 17592186162890 :step/content {:db/id #edb/ref 17592186162003 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161795 :question/id #uuid "e1167d53-7cfb-5ec2-96df-250e226d60b1" :question/math-academy-id "e-8243"} :knowledge-point/id #uuid "12f0497c-3359-5aeb-83d7-930ba3d1ab0d" :knowledge-point/questions [{:db/id #edb/ref 17592186162651} {:db/id #edb/ref 17592186162705} {:db/id #edb/ref 17592186482506} {:db/id #edb/ref 17592186482524} {:db/id #edb/ref 17592186482592} {:db/id #edb/ref 17592186482617}] :knowledge-point/title "Finding the Mode of a Continuous Random Variable Algebraically: Multiple Modes"} :step/id #uuid "d5933bd2-e414-5eef-bf2e-16c7bba99353" :step/math-academy-id 30825} {:db/id #edb/ref 17592186162891 :step/content {:db/id #edb/ref 17592186162004 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161796 :question/id #uuid "8be540db-a27c-537c-a804-35ed7cc45168" :question/math-academy-id "e-8244"} :knowledge-point/id #uuid "6e51181c-2074-5d7d-a9b8-d6f6128bc44c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048162}] :knowledge-point/questions [{:db/id #edb/ref 17592186162650} {:db/id #edb/ref 17592186162658} {:db/id #edb/ref 17592186482542} {:db/id #edb/ref 17592186482550} {:db/id #edb/ref 17592186482565} {:db/id #edb/ref 17592186482588} {:db/id #edb/ref 17592186482596}] :knowledge-point/title "Finding the Mode of a Continuous Random Variable Algebraically: One Mode"} :step/id #uuid "aecb909d-327f-5105-aed5-aa3bf9d6a261" :step/math-academy-id 30826 :step/next {:db/id #edb/ref 17592186162890}} {:db/id #edb/ref 17592186162950 :step/content {:db/id #edb/ref 17592186163259 :tutorial/content "Now, suppose we are given the random variable $X$ with the probability density function shown below. \n\n![](images/ec/ec48a5d839f3d843fe4738707ec3d067a19db9b009f4bf29673d899b321248a3.svg)\n\nHow can we find the mode of $X$ algebraically? \n\nTo find the global maximum of $f(x),$ we find the critical points of $f(x)$ and then apply the candidates test.\n\nFirst, we find the critical points.\n\n- The piece of $f(x)$ defined on $0 \\leq x \\leq 1$ is $f(x) =2x.$ Taking the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2.\\end{aligned}\n$$\n\nSo, there are no solutions  of  $f'(x) = 0.$\n\n- The derivative doesn't exist at the endpoints $x = 0,1.$ So, these are critical points.\n\nNow, we evaluate $f(x)$ at the critical points $x=0,1{:}$\n\n$$\n\\begin{aligned}f(0) & =2(0)=0 \\\\ f(1) & =2(1)=2\\end{aligned}\n$$\n\nFinally, we compare all of the values above. The largest value is\n\n$$\nf({\\color{blue}1}) =2.\n$$\n\nTherefore, the mode of $X$ is ${\\color{blue}1}.$" :tutorial/id #uuid "5f6e1736-8d9b-5bc6-8af5-d7618de6d2f8" :tutorial/math-academy-id 5172 :tutorial/title "Finding the Mode of a Continuous Random Variable Algebraically"} :step/id #uuid "45276fe4-2cb4-586a-9f20-43a83aff5f9f" :step/math-academy-id 32476 :step/next {:db/id #edb/ref 17592186162891}}] :activity/title "Finding the Mode of a Continuous Random Variable" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162179}]}
