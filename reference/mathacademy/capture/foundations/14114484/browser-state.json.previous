      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114484/observations/step-q72120-b4f32e58f70d4152d9c1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114484/observations/step-q72120-b4f32e58f70d4152d9c1.png",
