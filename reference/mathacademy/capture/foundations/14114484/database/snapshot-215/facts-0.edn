186284614 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186339075 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186339076 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186339077 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186342018 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186401592 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186403570 #edb/ref 17592186045585] [17592186129175 #edb/ref 1038 #edb/ref 17592186403653 #edb/ref 17592186045585] [17592186129175 #edb/ref 1039 "Classifying a Region as Type I, Type II, Both, or Neither" #edb/ref 17592186045585] [17592186129175 #edb/ref 1041 #edb/ref 17592186128994 #edb/ref 17592186045585] [17592186129175 #edb/ref 1042 #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130029 #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130030 #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130031 #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130032 #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130033 #edb/ref 17592186045585] [17592186129333 #edb/ref 1043 #edb/ref 17592186130034 #edb/ref 17592186045585] [17592186129333 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045585] [17592186129333 #edb/ref 1045 "Type I and II Regions in Two-Dimensional Space" #edb/ref 17592186045585] [17592186129333 #edb/ref 1046 #edb/ref 17592186130029 #edb/ref 17592186045585] [17592186129333 #edb/ref 1049 #edb/ref 17592186050828 #edb/ref 17592186045585] [17592186129333 #edb/ref 1053 #uuid "c092012f-6280-5531-b39f-09c65d20ea5d" #edb/ref 17592186045585] [17592186130029 #edb/ref 1058 #edb/ref 17592186130030 #edb/ref 17592186045585] [17592186130029 #edb/ref 1061 22589 #edb/ref 17592186045585] [17592186130029 #edb/ref 1062 #uuid "0b518252-fe1c-57d7-bc6f-6a00d3addac9" #edb/ref 17592186045585] [17592186130029 #edb/ref 1063 #edb/ref 17592186130377 #edb/ref 17592186045585] [17592186130030 #edb/ref 1058 #edb/ref 17592186130031 #edb/ref 17592186045585] [17592186130030 #edb/ref 1061 22590 #edb/ref 17592186045585] [17592186130030 #edb/ref 1062 #uuid "1b6899de-a336-56a9-809a-31cc01aeebb8" #edb/ref 17592186045585] [17592186130030 #edb/ref 1063 #edb/ref 17592186129173 #edb/ref 17592186045585] [17592186130031 #edb/ref 1058 #edb/ref 17592186130032 #edb/ref 17592186045585] [17592186130031 #edb/ref 1061 22591 #edb/ref 17592186045585] [17592186130031 #edb/ref 1062 #uuid "4858561d-380d-50d9-901d-e33ce219f2d6" #edb/ref 17592186045585] [17592186130031 #edb/ref 1063 #edb/ref 17592186130378 #edb/ref 17592186045585] [17592186130032 #edb/ref 1058 #edb/ref 17592186130033 #edb/ref 17592186045585] [17592186130032 #edb/ref 1061 22592 #edb/ref 17592186045585] [17592186130032 #edb/ref 1062 #uuid "952b663b-02bc-55c3-b391-c854df6de6fb" #edb/ref 17592186045585] [17592186130032 #edb/ref 1063 #edb/ref 17592186129174 #edb/ref 17592186045585] [17592186130033 #edb/ref 1058 #edb/ref 17592186130034 #edb/ref 17592186045585] [17592186130033 #edb/ref 1061 22593 #edb/ref 17592186045585] [17592186130033 #edb/ref 1062 #uuid "eafe2c8b-e7b1-59e6-9468-2c731ee86e98" #edb/ref 17592186045585] [17592186130033 #edb/ref 1063 #edb/ref 17592186130379 #edb/ref 17592186045585] [17592186130034 #edb/ref 1061 22594 #edb/ref 17592186045585] [17592186130034 #edb/ref 1062 #uuid "3b78b691-c694-59d1-b1ef-5ea8a77ad679" #edb/ref 17592186045585] [17592186130034 #edb/ref 1063 #edb/ref 17592186129175 #edb/ref 17592186045585] [17592186130377 #edb/ref 1064 "Let's consider the region that lies between the curves ${\\color{red}y=f(x)}$ and ${\\color{blue}y=g(x)}$ over a closed interval $[a,b]$ on the $x$-axis, as shown below.\n\n![](images/a4/a45abf7904382a16daaa38ff617a9487b5c274cf65ef44f89e7feb0c32c496e0.png)\n\nThis region is an example of a **type I region**. Generally, a type I region is any region bounded by two vertical lines $x=a$ and $x=b,$ and two curves $y=g(x)$ and $y=f(x),$ where $f$ and $g$ are continuous functions. \n\nUsing set notation, a type I region can be written as\n\n$$\nD = \\big\\{ (x,y) \\: : \\: a \\leq x  \\leq b, \\quad g(x) \\leq y \\leq f(x) \\big\\}.\n$$\n\nIn a type I region, any vertical line drawn through the region should intersect the region in a *single* interval, as shown below.\n\n![](images/f7/f7282efbe2c9244c77ce6bbbeca047ee3ab29dd2fc90e0d2440c519328cb5973.png)\n\nBy contrast, the following region is *not* a type I region since there is a vertical line whose intersection with the region results in two *separate* line segments. In other words, the vertical line enters and leaves the region more than once.\n\n![](images/a2/a26c7588e297a8af35f1e709210596a94f3fb4bd84e8237dc1462f48b961630e.png)" #edb/ref 17592186045585] [17592186130377 #edb/ref 1065 3854 #edb/ref 17592186045585] [17592186130377 #edb/ref 1066 #uuid "2658cc5e-d169-5ff8-871c-4ccaab428eb7" #edb/ref 17592186045585] [17592186130377 #edb/ref 1067 "Introduction" #edb/ref 17592186045585] [17592186130378 #edb/ref 1064 "Let's consider the region that lies between the curves ${\\color{red}x=f(y)}$ and ${\\color{blue}x=g(y)}$ over a closed interval $[a,b]$ on the $y$-axis, as shown below.\n\n![](images/cf/cf2a2a41d63f21b279215fd1aa8d7361eb638e831b970bb3de861673f67612e6.png)\n\nThis region is an example of a **type II region**. In general, a type II region is any region that is bounded by two horizontal lines $y=a$ and $y=b,$ and two curves $x=g(y)$ and $x=f(y),$ where $f$ and $g$ are continuous functions.\n\nUsing set notation, a type II region can be written as\n\n$$\nD = \\big\\{ (x,y) \\: : \\: a \\leq y  \\leq b, \\quad g(y) \\leq x \\leq f(y) \\big\\}.\n$$\n\nIn a type II region, any horizontal line drawn through the region should intersect the region in a *single* interval, as shown below.\n\n![](images/56/56019e8cc2b1146b99fa6f6532356281fdb847c342c25c63f843ddee4f8cb197.png)\n\nBy contrast, the following region is *not* a type II region since there is a horizontal line whose intersection with the region results in two *separate* line segments. In other words, the horizontal line enters and leaves the region more than once.\n\n![](images/a7/a7c1ead1274250f7184b132eff58a3028ce648715dcbfa7c7046077fd4e680ef.png)" #edb/ref 17592186045585] [17592186130378 #edb/ref 1065 3855 #edb/ref 17592186045585] [17592186130378 #edb/ref 1066 #uuid "d089f833-c09a-5229-9be0-8cffa2510d60" #edb/ref 17592186045585] [17592186130378 #edb/ref 1067 "Type II Regions" #edb/ref 17592186045585] [17592186130379 #edb/ref 1064 "In general, a given region can be type I, type II, both, or neither.\n\nFor example, let's consider the region in the coordinate plane bounded between the circle ${\\color{blue}x^2+y^2=2}$ and the lines ${\\color{red}x=-1},$ ${\\color{red}x=1},$ ${\\color{red}y=-1}$, and ${\\color{red}y=1},$ as shown below.\n\n![](images/db/db43502c2b096c912ac38d297c3a06e7dcbf4945af6fbc7f5e365a40d11fcde8.png)\n\nThere is a vertical line (for instance, the $y$-axis) whose intersection with the region results in two separate line segments. In other words, the vertical line enters and leaves the region more than once. So, this region *cannot* be a type I region.\n\n![](images/dc/dc1dca3b3015da15f554d95dae7add65aeee0b83a0075ec5295716a3e86d71f5.png)\n\nSimilarly, there is a horizontal line (for instance, the $x$-axis) whose intersection with the region results in two separate line segments. In other words, the horizontal line enters and leaves the region more than once. So, this region *cannot* be a type II region.\n\n![](images/82/82720f4b69fc3e63bbf54cb22d60299035faf91a6021f09d41e9f62dad571581.png)\n\nIn conclusion, this region is *neither* type I nor type II.\n\nLet's now look at an example that is *both* type I and type II." #edb/ref 17592186045585] [17592186130379 #edb/ref 1065 3856 #edb/ref 17592186045585] [17592186130379 #edb/ref 1066 #uuid "09369aae-8943-5475-9739-20e6619b16d7" #edb/ref 17592186045585] [17592186130379 #edb/ref 1067 "Regions that are Neither Type I Nor Type II" #edb/ref 17592186045585] [17592186336123 #edb/ref 1081 "None of the listed" #edb/ref 17592186045585] [17592186336123 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186336123 #edb/ref 1084 #uuid "099efdac-6222-5744-b3c1-1dad27d41b85" #edb/ref 17592186045585] [17592186336490 #edb/ref 1081 "images/6c/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" #edb/ref 17592186045585] [17592186336490 #edb/ref 1083 #edb/ref 17592186045498 #edb/ref 17592186045585] [17592186336490 #edb/ref 1084 #uuid "2f51b9b3-9edb-5ad5-a10c-52cfdfd9e751" #edb/ref 17592186045585] [17592186336756 #edb/ref 1081 "III only" #edb/ref 17592186045585] [17592186336756 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186336756 #edb/ref 1084 #uuid "4d5dfdf6-e50a-544c-a082-757d6a3cc45e" #edb/ref 17592186045585] [17592186336861 #edb/ref 1081 "images/5a/5a14be084ba22e33b636465156276fc489904a650077612c15fdec3634f8d902.png" #edb/ref 17592186045585] [17592186336861 #edb/ref 1083 #edb/ref 17592186045498 #edb/ref 17592186045585] [17592186336861 #edb/ref 1084 #uuid "5a4f7dba-2306-55b0-ad53-f7348ae38b3c" #edb/ref 17592186045585] [17592186337023 #edb/ref 1081 "II only" #edb/ref 17592186045585] [17592186337023 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186337023 #edb/ref 1084 #uuid "6f3a5eba-d4b1-5a73-b36e-ccfbf5537a92" #edb/ref 17592186045585] [17592186337056 #edb/ref 1081 "I and II only" #edb/ref 17592186045585] [17592186337056 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186337056 #edb/ref 1084 #uuid "71d9509f-880d-594a-ad0c-8f134a4a17bb" #edb/ref 17592186045585] [17592186337262 #edb/ref 1081 "I only" #edb/ref 17592186045585] [17592186337262 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186337262 #edb/ref 1084 #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" #edb/ref 17592186045585] [17592186337925 #edb/ref 1081 "images/5e/5e41509dcb689a5f16822eea9b8700171a74124789e12990ee4fd292d52aa2ea.png" #edb/ref 17592186045585] [17592186337925 #edb/ref 1083 #edb/ref 17592186045498 #edb/ref 17592186045585] [17592186337925 #edb/ref 1084 #uuid "d8f500b5-47d1-5c54-82d7-03d7175ff4bd" #edb/ref 17592186045585] [17592186338166 #edb/ref 1081 "images/81/81b206d34bfa12b8623329616368ea3e6a978cf7963dbe5f09b23cafffb76dae.png" #edb/ref 17592186045585] [17592186338166 #edb/ref 1083 #edb/ref 17592186045498 #edb/ref 17592186045585] [17592186338166 #edb/ref 1084 #uuid "f39c32b9-aa95-5261-a245-c6851bf03b8c" #edb/ref 17592186045585] [17592186338258 #edb/ref 1081 "I and III only" #edb/ref 17592186045585] [17592186338258 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186338258 #edb/ref 1084 #uuid "fc897d08-7b5c-5946-a0d6-80162b7a9c92" #edb/ref 17592186045585] [17592186338446 #edb/ref 1075 #edb/ref 17592186336756 #edb/ref 17592186045585] [17592186338446 #edb/ref 1075 #edb/ref 17592186337023 #edb/ref 17592186045585] [17592186338446 #edb/ref 1075 #edb/ref 17592186337056 #edb/ref 17592186045585] [17592186338446 #edb/ref 1075 #edb/ref 17592186337262 #edb/ref 17592186045585] [17592186338446 #edb/ref 1075 #edb/ref 17592186338258 #edb/ref 17592186045585] [17592186338446 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186338446 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186338446 #edb/ref 1079 #edb/ref 17592186337262 #edb/ref 17592186045585] [17592186338446 #edb/ref 1080 #uuid "5dc16394-01fd-51be-9be9-07cf0cfe3cbb" #edb/ref 17592186045585] [17592186338606 #edb/ref 1075 #edb/ref 17592186336123 #edb/ref 17592186045585] [17592186338606 #edb/ref 1075 #edb/ref 17592186336490 #edb/ref 17592186045585] [17592186338606 #edb/ref 1075 #edb/ref 17592186336861 #edb/ref 17592186045585] [17592186338606 #edb/ref 1075 #edb/ref 17592186337925 #edb/ref 17592186045585] [17592186338606 #edb/ref 1075 #edb/ref 17592186338166 #edb/ref 17592186045585] [17592186338606 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186338606 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186338606 #edb/ref 1079 #edb/ref 17592186336490 #edb/ref 17592186045585] [17592186338606 #edb/ref 1080 #uuid "b0492a08-2d29-5eca-af88-ac3ff00ea955" #edb/ref 17592186045585] [17592186339055 #edb/ref 1068 #edb/ref 17592186338606 #edb/ref 17592186045585] [17592186339055 #edb/ref 1069 "q-72049" #edb/ref 17592186045585] [17592186339055 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045585] [17592186339055 #edb/ref 1071 "Which of the following is a type II region in two-dimensional space?" #edb/ref 17592186045585] [17592186339055 #edb/ref 1072 #uuid "efbcfea6-0f26-55f3-9790-4f12e94364d5" #edb/ref 17592186045585] [17592186339055 #edb/ref 1074 "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/7c/7c159c025f0b7ae4bfa8984f637a492cda21ec2dd39e87be724324e1334c06a3.png)" #edb/ref 17592186045585] [17592186339076 #edb/ref 1068 #edb/ref 17592186338446 #edb/ref 17592186045585] [17592186339076 #edb/ref 1069 "q-72186" #edb/ref 17592186045585] [17592186339076 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186339076 #edb/ref 1071 "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" #edb/ref 17592186045585] [17592186339076 #edb/ref 1072 #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" #edb/ref 17592186045585] [17592186339076 #edb/ref 1074 "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true." #edb/ref 17592186045585] [17592186373180 #edb/ref 1068 #edb/ref 17592186373181 #edb/ref 17592186045585] [17592186373180 #edb/ref 1069 "q-72143" #edb/ref 17592186045585] [17592186373180 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186373180 #edb/ref 1071 "![](images/76/768046952484d181a404486547db84882424d98da4f677254484e1083580a39b.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" #edb/ref 17592186045585] [17592186373180 #edb/ref 1072 #uuid "ef441fce-64e9-5f90-b9fb-0d44af6b333e" #edb/ref 17592186045585] [17592186373180 #edb/ref 1074 "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nThe function $x=y$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=0$ and $y=1.$ So, we have $0\\le y\\le 1.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/d5/d55cb7ea67d9865368c744577bb4a4b22a3635e8e62869ee65e945612d6c0e98.png)\n\nThe horizontal line enters the region through the lower function $x=y$ and leaves through the upper function $x=\\sqrt{y}.$ So, we have $y\\le x\\le \\sqrt{y}.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}.\n$$" #edb/ref 17592186045585] [17592186373181 #edb/ref 1075 #edb/ref 17592186373182 #edb/ref 17592186045585] [17592186373181 #edb/ref 1075 #edb/ref 17592186373183 #edb/ref 17592186045585] [17592186373181 #edb/ref 1075 #edb/ref 17592186373184 #edb/ref 17592186045585] [17592186373181 #edb/ref 1075 #edb/ref 17592186373185 #edb/ref 17592186045585] [17592186373181 #edb/ref 1075 #edb/ref 17592186373186 #edb/ref 17592186045585] [17592186373181 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186373181 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186373181 #edb/ref 1079 #edb/ref 17592186373182 #edb/ref 17592186045585] [17592186373181 #edb/ref 1080 #uuid "257fac2f-8a02-59c7-aca1-ef19cbb1795a" #edb/ref 17592186045585] [17592186373182 #edb/ref 1081 "D={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}" #edb/ref 17592186045585] [17592186373182 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186373182 #edb/ref 1084 #uuid "6a975ac4-7eb7-5fd7-877f-3b02d86d178c" #edb/ref 17592186045585] [17592186373183 #edb/ref 1081 "D={(x,y)\\,:\\,0\\le y\\le {x}^{2},\\,0\\le x\\le 1}" #edb/ref 17592186045585] [17592186373183 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186373183 #edb/ref 1084 #uuid "39895c7e-c47a-544c-91d0-9dfd7ed83606" #edb/ref 17592186045585] [17592186373184 #edb/ref 1081 "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le y}" #edb/ref 17592186045585] [17592186373184 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186373184 #edb/ref 1084 #uuid "a9081b22-1a7d-5fe6-a42e-28c78f31adb1" #edb/ref 17592186045585] [17592186373185 #edb/ref 1081 "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 1}" #edb/ref 17592186045585] [17592186373185 #edb/ref 1083 #edb/ref 17592186045499