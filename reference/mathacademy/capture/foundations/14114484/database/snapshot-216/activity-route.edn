#{[{:activity/course {:db/id #edb/ref 17592186046665} :activity/first-step {:db/id #edb/ref 17592186407015} :activity/id #uuid "3da669c9-a862-59b7-84e5-f7ce7ac62942" :activity/scope {:db/id #edb/ref 17592186050828 :topic/id #uuid "6961ffb7-2e37-5f54-ac39-0331f4517bbc" :topic/math-academy-id 1979} :activity/steps [{:db/id #edb/ref 17592186407014 :step/content {:db/id #edb/ref 17592186393200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5bce626-d9bb-5dbb-905a-7daed41e086c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/a2/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/id #edb/ref 17592186393202} {:answer/id #uuid "c9d47ae6-371d-5f7f-a924-edcd6ec62dd3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "None of the listed" :db/id #edb/ref 17592186393203} {:answer/id #uuid "693ea9c7-f1ff-5a1c-b288-3ea683ff953d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/20/205fdc7a29c94d36b5bd8847a2600c41d7e3fd2ac0fd92947dddcb241bdae012.png" :db/id #edb/ref 17592186393204} {:answer/id #uuid "349c2643-543b-501a-b8d3-7af986d4a0af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/25/254691f56d0586b2cbfd75a3fce34ecc1062b0f0fde538d3885860ed1b71555c.png" :db/id #edb/ref 17592186393205} {:answer/id #uuid "d7836927-19a4-54a2-aabf-fc9fd48ada96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/ed/edbcc3bcef921ef736f9bd31bec56f69736c632bf835cf4c9c1c46026fda8083.png" :db/id #edb/ref 17592186393206}] :answer-field/correct {:db/id #edb/ref 17592186393202} :answer-field/id #uuid "7683d677-08f6-57b3-b924-04b4d1ba5f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393201}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13be6924-14b7-5b8e-8469-18a97723bd20" :question/math-academy-id "q-72120" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/e4/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)"} :step/id #uuid "0868f274-6d6e-5256-97a9-564c4f1a8169" :step/next {:db/id #edb/ref 17592186407016}} {:db/id #edb/ref 17592186407015 :step/content {:db/id #edb/ref 17592186339055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "099efdac-6222-5744-b3c1-1dad27d41b85" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "None of the listed" :db/id #edb/ref 17592186336123} {:answer/id #uuid "2f51b9b3-9edb-5ad5-a10c-52cfdfd9e751" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/6c/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" :db/id #edb/ref 17592186336490} {:answer/id #uuid "5a4f7dba-2306-55b0-ad53-f7348ae38b3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/5a/5a14be084ba22e33b636465156276fc489904a650077612c15fdec3634f8d902.png" :db/id #edb/ref 17592186336861} {:answer/id #uuid "d8f500b5-47d1-5c54-82d7-03d7175ff4bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/5e/5e41509dcb689a5f16822eea9b8700171a74124789e12990ee4fd292d52aa2ea.png" :db/id #edb/ref 17592186337925} {:answer/id #uuid "f39c32b9-aa95-5261-a245-c6851bf03b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/81/81b206d34bfa12b8623329616368ea3e6a978cf7963dbe5f09b23cafffb76dae.png" :db/id #edb/ref 17592186338166}] :answer-field/correct {:db/id #edb/ref 17592186336490} :answer-field/id #uuid "b0492a08-2d29-5eca-af88-ac3ff00ea955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "efbcfea6-0f26-55f3-9790-4f12e94364d5" :question/math-academy-id "q-72049" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/7c/7c159c025f0b7ae4bfa8984f637a492cda21ec2dd39e87be724324e1334c06a3.png)"} :step/id #uuid "11bc950f-28ab-5ada-8524-78d17fbdb0fc" :step/next {:db/id #edb/ref 17592186407014}} {:db/id #edb/ref 17592186407016 :step/content {:db/id #edb/ref 17592186373180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a975ac4-7eb7-5fd7-877f-3b02d86d178c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}" :db/id #edb/ref 17592186373182} {:answer/id #uuid "39895c7e-c47a-544c-91d0-9dfd7ed83606" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "D={(x,y)\\,:\\,0\\le y\\le {x}^{2},\\,0\\le x\\le 1}" :db/id #edb/ref 17592186373183} {:answer/id #uuid "a9081b22-1a7d-5fe6-a42e-28c78f31adb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le y}" :db/id #edb/ref 17592186373184} {:answer/id #uuid "cdc5c900-890c-5102-b2c4-66ae4d181695" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 1}" :db/id #edb/ref 17592186373185} {:answer/id #uuid "9ec0e614-7e69-564e-8bef-ca2ee0f86847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt{y}}" :db/id #edb/ref 17592186373186}] :answer-field/correct {:db/id #edb/ref 17592186373182} :answer-field/id #uuid "257fac2f-8a02-59c7-aca1-ef19cbb1795a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373181}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef441fce-64e9-5f90-b9fb-0d44af6b333e" :question/math-academy-id "q-72143" :question/problem "![](images/76/768046952484d181a404486547db84882424d98da4f677254484e1083580a39b.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nThe function $x=y$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=0$ and $y=1.$ So, we have $0\\le y\\le 1.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/d5/d55cb7ea67d9865368c744577bb4a4b22a3635e8e62869ee65e945612d6c0e98.png)\n\nThe horizontal line enters the region through the lower function $x=y$ and leaves through the upper function $x=\\sqrt{y}.$ So, we have $y\\le x\\le \\sqrt{y}.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt{y}}.\n$$"} :step/id #uuid "1c227960-e1d3-5f07-b75a-31b153d00a8a" :step/next {:db/id #edb/ref 17592186407018}} {:db/id #edb/ref 17592186407017 :step/content {:db/id #edb/ref 17592186339076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5dfdf6-e50a-544c-a082-757d6a3cc45e" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186336756} {:answer/id #uuid "6f3a5eba-d4b1-5a73-b36e-ccfbf5537a92" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186337023} {:answer/id #uuid "71d9509f-880d-594a-ad0c-8f134a4a17bb" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186337056} {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186337262} {:answer/id #uuid "fc897d08-7b5c-5946-a0d6-80162b7a9c92" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and III only" :db/id #edb/ref 17592186338258}] :answer-field/correct {:db/id #edb/ref 17592186337262} :answer-field/id #uuid "5dc16394-01fd-51be-9be9-07cf0cfe3cbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338446}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."} :step/id #uuid "52cd1fa6-d29c-562d-9d88-cade3cec5a66"} {:db/id #edb/ref 17592186407018 :step/content {:db/id #edb/ref 17592186407013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ecb354-bca2-5a72-beb3-0f34f2bbf979" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186407007} {:answer/id #uuid "20731cc6-c38c-5d60-ad49-b4b85b44d30a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186407008} {:answer/id #uuid "2548e166-c6fa-5f0c-9863-ed09f3c8467c" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186407009} {:answer/id #uuid "4e41d7a4-75e3-58cd-839a-7c89df99b321" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186407010} {:answer/id #uuid "b32afa94-923e-5681-a943-6f823eddc017" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186407011}] :answer-field/correct {:db/id #edb/ref 17592186407010} :answer-field/id #uuid "1ba14fe2-fe7c-5c94-b156-885bef914d7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407012}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0d779a1b-dcae-59f0-822c-7860f9483ab7" :question/math-academy-id "q-72160" :question/problem "Which of the following statements are true regarding the finite region bounded between the curves $y={x}^{3}$ and $y=\\sqrt[3]{x},$ in the first quadrant?\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}y={x}^{3}\\, & ⟹\\,x=\\sqrt[3]{y} \\\\ y=\\sqrt[3]{x}\\, & ⟹\\,x={y}^{3}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/89/899357795c6d5b81d3cb619d71493ad787645697fe1f2fcecda78c1b875f388e.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le \\sqrt[3]{x}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{3}\\le x\\le \\sqrt[3]{y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."} :step/id #uuid "fd242e61-69b5-5bfd-bc83-d7379d3f45c8" :step/next {:db/id #edb/ref 17592186407017}}] :activity/title "Type I and II Regions in Two-Dimensional Space" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407006}]}
