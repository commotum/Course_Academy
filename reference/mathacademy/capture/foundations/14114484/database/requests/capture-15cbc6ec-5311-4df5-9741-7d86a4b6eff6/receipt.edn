0c-9863-ed09f3c8467c" 13194139533528 17592186045585 true] [17592186407010 1081 "I and II only" 13194139533528 17592186045585 true] [17592186407010 1083 #edb/ref 17592186045500 13194139533528 17592186045585 true] [17592186407010 1084 #uuid "4e41d7a4-75e3-58cd-839a-7c89df99b321" 13194139533528 17592186045585 true] [17592186407011 1081 "I only" 13194139533528 17592186045585 true] [17592186407011 1083 #edb/ref 17592186045500 13194139533528 17592186045585 true] [17592186407011 1084 #uuid "b32afa94-923e-5681-a943-6f823eddc017" 13194139533528 17592186045585 true] [17592186407012 1075 #edb/ref 17592186407007 13194139533528 17592186045585 true] [17592186407012 1075 #edb/ref 17592186407008 13194139533528 17592186045585 true] [17592186407012 1075 #edb/ref 17592186407009 13194139533528 17592186045585 true] [17592186407012 1075 #edb/ref 17592186407010 13194139533528 17592186045585 true] [17592186407012 1075 #edb/ref 17592186407011 13194139533528 17592186045585 true] [17592186407012 1076 #edb/ref 17592186045493 13194139533528 17592186045585 true] [17592186407012 1077 "selection" 13194139533528 17592186045585 true] [17592186407012 1079 #edb/ref 17592186407010 13194139533528 17592186045585 true] [17592186407012 1080 #uuid "1ba14fe2-fe7c-5c94-b156-885bef914d7d" 13194139533528 17592186045585 true] [17592186407013 1068 #edb/ref 17592186407012 13194139533528 17592186045585 true] [17592186407013 1069 "q-72160" 13194139533528 17592186045585 true] [17592186407013 1070 #edb/ref 17592186045487 13194139533528 17592186045585 true] [17592186407013 1071 "Which of the following statements are true regarding the finite region bounded between the curves $y={x}^{3}$ and $y=\\sqrt[3]{x},$ in the first quadrant?\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" 13194139533528 17592186045585 true] [17592186407013 1072 #uuid "0d779a1b-dcae-59f0-822c-7860f9483ab7" 13194139533528 17592186045585 true] [17592186407013 1074 "First, notice that\n\n$$\n\\begin{aligned}y={x}^{3}\\, & ⟹\\,x=\\sqrt[3]{y} \\\\ y=\\sqrt[3]{x}\\, & ⟹\\,x={y}^{3}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/89/899357795c6d5b81d3cb619d71493ad787645697fe1f2fcecda78c1b875f388e.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le \\sqrt[3]{x}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{3}\\le x\\le \\sqrt[3]{y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true." 13194139533528 17592186045585 true] [17592186407014 1058 #edb/ref 17592186407016 13194139533528 17592186045585 true] [17592186407014 1062 #uuid "0868f274-6d6e-5256-97a9-564c4f1a8169" 13194139533528 17592186045585 true] [17592186407014 1063 #edb/ref 17592186393200 13194139533528 17592186045585 true] [17592186407015 1058 #edb/ref 17592186407014 13194139533528 17592186045585 true] [17592186407015 1062 #uuid "11bc950f-28ab-5ada-8524-78d17fbdb0fc" 13194139533528 17592186045585 true] [17592186407015 1063 #edb/ref 17592186339055 13194139533528 17592186045585 true] [17592186407016 1058 #edb/ref 17592186407018 13194139533528 17592186045585 true] [17592186407016 1062 #uuid "1c227960-e1d3-5f07-b75a-31b153d00a8a" 13194139533528 17592186045585 true] [17592186407016 1063 #edb/ref 17592186373180 13194139533528 17592186045585 true] [17592186407017 1062 #uuid "52cd1fa6-d29c-562d-9d88-cade3cec5a66" 13194139533528 17592186045585 true] [17592186407017 1063 #edb/ref 17592186339076 13194139533528 17592186045585 true] [17592186407018 1058 #edb/ref 17592186407017 13194139533528 17592186045585 true] [17592186407018 1062 #uuid "fd242e61-69b5-5bfd-bc83-d7379d3f45c8" 13194139533528 17592186045585 true] [17592186407018 1063 #edb/ref 17592186407013 1