17592186050376 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092229 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092230 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092231 #edb/ref 17592186045417] [17592186050001 #edb/ref 1028 #edb/ref 17592186092232 #edb/ref 17592186045417] [17592186050001 #edb/ref 1031 "Calculating the Eigenvalues of a 2x2 Matrix" #edb/ref 17592186045417] [17592186050001 #edb/ref 1033 990 #edb/ref 17592186045417] [17592186050001 #edb/ref 1035 #uuid "25757680-24c4-582e-828e-48263c608c8b" #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186048555 #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186048726 #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186049606 #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186050447 #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186050470 #edb/ref 17592186045417] [17592186050376 #edb/ref 1027 #edb/ref 17592186050820 #edb/ref 17592186045417] [17592186050376 #edb/ref 1028 #edb/ref 17592186124522 #edb/ref 17592186045417] [17592186050376 #edb/ref 1028 #edb/ref 17592186124523 #edb/ref 17592186045417] [17592186050376 #edb/ref 1028 #edb/ref 17592186124571 #edb/ref 17592186045417] [17592186050376 #edb/ref 1031 "The Characteristic Equation of a Matrix" #edb/ref 17592186045417] [17592186050376 #edb/ref 1033 1964 #edb/ref 17592186045417] [17592186050376 #edb/ref 1035 #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186048116 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186048475 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186048681 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186048965 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186049022 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186049244 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186049490 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186049499 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186049814 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186050209 #edb/ref 17592186045417] [17592186050465 #edb/ref 1027 #edb/ref 17592186050334 #edb/ref 17592186045417] [17592186050465 #edb/ref 1028 #edb/ref 17592186068793 #edb/ref 17592186045417] [17592186050465 #edb/ref 1028 #edb/ref 17592186068862 #edb/ref 17592186045417] [17592186050465 #edb/ref 1028 #edb/ref 17592186068863 #edb/ref 17592186045417] [17592186050465 #edb/ref 1028 #edb/ref 17592186068864 #edb/ref 17592186045417] [17592186050465 #edb/ref 1031 "The Quadratic Formula" #edb/ref 17592186045417] [17592186050465 #edb/ref 1033 422 #edb/ref 17592186045417] [17592186050465 #edb/ref 1035 #uuid "4bbf23bd-b30a-5ef9-8f1c-5c3855237fe0" #edb/ref 17592186045417] [17592186092074 #edb/ref 1069 "e-5479" #edb/ref 17592186045417] [17592186092074 #edb/ref 1071 "Find the characteristic equation of the matrix \n![](images/36/36c1ce5342657231cd78154ab4821a6a5bf9b78b74297ae5a4cdccdc2f6d5dcd.svg)" #edb/ref 17592186045417] [17592186092074 #edb/ref 1072 #uuid "aebe3048-cc5b-5340-a15e-d577ae2ee72a" #edb/ref 17592186045417] [17592186092074 #edb/ref 1074 "First, we find the matrix $\\, A-\\lambda I\\mathbin{:}$\n﻿﻿﻿![](images/1c/1cab5be2ed7c560a3a5192473be4ff7b6cf6dc5728552f1d179c73affebefe20.svg)\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 4 \\\\ 3 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(2-\\lambda )-4\\cdot 3 & =0 \\\\ 4-4\\lambda +{\\lambda }^{2}-12 & =0 \\\\ {\\lambda }^{2}-4\\lambda -8 & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092075 #edb/ref 1069 "e-5480" #edb/ref 17592186045417] [17592186092075 #edb/ref 1071 "Find all real eigenvalues of the matrix\n![](images/2c/2c669dd6f7c5fa368c5ea28961d2ef57cac9deaf7ba453f75a441b05206f6276.svg)" #edb/ref 17592186045417] [17592186092075 #edb/ref 1072 #uuid "55e695b2-4581-5ba7-9604-506234b88323" #edb/ref 17592186045417] [17592186092075 #edb/ref 1074 "Let's start by writing the matrix $B-\\lambda I\\mathbin{:}$\n![](images/e4/e4e91261ec7f4a9a48847005a57730afa25f5e69a1f3818ad583acaadae639f8.svg)\n\nNow, let's find and solve the characteristic equation $\\det(B-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}4-\\lambda  & 0 \\\\ 0 & 4-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )(4-\\lambda )-0\\cdot 0 & =0 \\\\ (\\lambda -4)^{2} & =0\\end{aligned}\n$$\n\nTherefore, the matrix $B$ has only one eigenvalue $\\lambda=4,$ which is a double root of the characteristic equation. \n\n**Note:** We also say that $\\lambda=4$ has an **algebraic multiplicity** of $2.$" #edb/ref 17592186045417] [17592186092076 #edb/ref 1069 "e-5481" #edb/ref 17592186045417] [17592186092076 #edb/ref 1071 "Find all real eigenvalues of the matrix ![](images/9f/9f13c3379e0613ce91669f6e52473dd11dc95360c422943764f30220dbccf430.svg)" #edb/ref 17592186045417] [17592186092076 #edb/ref 1072 #uuid "a42d0af8-869c-5c2a-8182-22b14b9546e2" #edb/ref 17592186045417] [17592186092076 #edb/ref 1074 "Let's start by writing the matrix $A - \\lambda I\\mathbin{:}$\n﻿﻿![](images/03/039ee6073538580614cc07453132b811a4da81f438abf37197bb686057b4b66c.svg)\n\nNow, let's find and solve the characteristic equation $\\det(A-\\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}10-\\lambda  & 3 \\\\ 6 & 7-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )(7-\\lambda )-3\\cdot 6 & =0 \\\\ 70-7\\lambda -10\\lambda +{\\lambda }^{2}-18 & =0 \\\\ {\\lambda }^{2}-17\\lambda +52 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{17\\pm \\sqrt{(-17)^{2}-4\\cdot 1\\cdot 52}}{2\\cdot 1} \\\\  & =\\frac{17\\pm \\sqrt{81}}{2} \\\\  & =\\frac{17\\pm 9}{2} \\\\  & =13,4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda=13$ and $\\lambda=4.$" #edb/ref 17592186045417] [17592186092077 #edb/ref 1069 "e-5482" #edb/ref 17592186045417] [17592186092077 #edb/ref 1071 "Find all real eigenvalues of the matrix ![](images/e3/e34b5bf690a1dd8f5275f2d742b264494386b95394bc7c32aaafb9eeba68e058.svg)" #edb/ref 17592186045417] [17592186092077 #edb/ref 1072 #uuid "9e40836e-18e9-5df6-a930-05875b920335" #edb/ref 17592186045417] [17592186092077 #edb/ref 1074 "Let's start by writing the matrix $A - \\lambda I \\mathbin{:}$\n﻿﻿﻿![](images/37/37f547d6ad345415a1cc2480adf227ec29e31a351cf935e584b9544e44347310.svg)\n\nNow, let's find and solve the characteristic equation $\\det (A - \\lambda I) = 0\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 0 \\\\ 9 & -2\\sqrt{3}-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(-2\\sqrt{3}-\\lambda )-9\\cdot 0 & =0 \\\\ (\\lambda -3)(\\lambda +2\\sqrt{3}) & =0\\end{aligned}\n$$\n\nSo, we get the eigenvalues $\\lambda={\\color{red}3}$ and $\\lambda={\\color{blue}-2\\sqrt{3}}.$\n\nIf we look again at the matrix ![](images/f4/f4e86a797cafe4857d5f135ec37d57e33368469767e50793f55b89ec7185c2eb.svg)\nwe see that the eigenvalues are the entries on the main diagonal. This is true in general: the eigenvalues of a *triangular* or *diagonal* matrix are *always* given by the entries on the main diagonal!\n\n**Watch out!** For a general matrix (which is neither triangular nor diagonal), this might not be the case!" #edb/ref 17592186045417] [17592186092229 #edb/ref 1037 #edb/ref 17592186049044 #edb/ref 17592186045417] [17592186092229 #edb/ref 1038 #edb/ref 17592186092689 #edb/ref 17592186045417] [17592186092229 #edb/ref 1038 #edb/ref 17592186092690 #edb/ref 17592186045417] [17592186092229 #edb/ref 1038 #edb/ref 17592186243988 #edb/ref 17592186045417] [17592186092229 #edb/ref 1038 #edb/ref 17592186244111 #ed