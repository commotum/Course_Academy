 #edb/ref 17592186045417] [17592186486340 #edb/ref 1075 #edb/ref 17592186486223 #edb/ref 17592186045417] [17592186486340 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186486340 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186486340 #edb/ref 1078 #edb/ref 17592186485929 #edb/ref 17592186045417] [17592186486340 #edb/ref 1079 #uuid "f53e6153-04c5-5452-83ee-5ea082519b93" #edb/ref 17592186045417] [17592186486343 #edb/ref 1075 #edb/ref 17592186485906 #edb/ref 17592186045417] [17592186486343 #edb/ref 1075 #edb/ref 17592186486027 #edb/ref 17592186045417] [17592186486343 #edb/ref 1075 #edb/ref 17592186486029 #edb/ref 17592186045417] [17592186486343 #edb/ref 1075 #edb/ref 17592186486142 #edb/ref 17592186045417] [17592186486343 #edb/ref 1075 #edb/ref 17592186486210 #edb/ref 17592186045417] [17592186486343 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186486343 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186486343 #edb/ref 1078 #edb/ref 17592186486027 #edb/ref 17592186045417] [17592186486343 #edb/ref 1079 #uuid "f62014e6-f54a-5a90-8d80-ae64d3c76c60" #edb/ref 17592186045417] [17592186486405 #edb/ref 1068 #edb/ref 17592186486340 #edb/ref 17592186045417] [17592186486405 #edb/ref 1069 "q-99421" #edb/ref 17592186045417] [17592186486405 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486405 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at the point $t=3,$ given that\n\n$$\n\\begin{aligned}T(3) & =\\frac{1}{5}⟨0,3,4⟩, \\\\ N(3) & =\\frac{1}{5}⟨0,4,-3⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." #edb/ref 17592186045417] [17592186486405 #edb/ref 1072 #uuid "818ba628-d4d7-5ed9-973b-a4ac0ea776b4" #edb/ref 17592186045417] [17592186486405 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(3) & =T(3)\\times N(3) \\\\  & =\\frac{1}{5}⟨0,3,4⟩\\times \\frac{1}{5}⟨0,4,-3⟩ \\\\  & =\\frac{1}{25}\\left|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ 0 & 4 & -3\\end{aligned}\\right| \\\\  & =\\frac{1}{25}[\\text{ }\\left|\\begin{aligned}3 & 4 \\\\ 4 & -3\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & 4 \\\\ 0 & -3\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & 3 \\\\ 0 & 4\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{25}⟨(-9-16),-(0-0),(0-0)⟩ \\\\  & =\\frac{1}{25}⟨-25,0,0⟩ \\\\  & =⟨-1,0,0⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486409 #edb/ref 1068 #edb/ref 17592186486343 #edb/ref 17592186045417] [17592186486409 #edb/ref 1069 "q-127617" #edb/ref 17592186045417] [17592186486409 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486409 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,2t,0⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,1,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." #edb/ref 17592186045417] [17592186486409 #edb/ref 1072 #uuid "8bfa2936-0cfa-5b9c-b815-96a80b635940" #edb/ref 17592186045417] [17592186486409 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,2t,0⟩\\times \\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,1,0⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ 1 & 2t & 0 \\\\ -2t & 1 & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{1+4{t}^{2}}[\\text{ }\\left|\\begin{aligned}2t & 0 \\\\ 1 & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}1 & 0 \\\\ -2t & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}1 & 2t \\\\ -2t & 1\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0-0,-(0-0),1+4{t}^{2}⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0,0,1+4{t}^{2}⟩ \\\\  & =⟨0,0,1⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486413 #edb/ref 1068 #edb/ref 17592186486311 #edb/ref 17592186045417] [17592186486413 #edb/ref 1069 "q-98807" #edb/ref 17592186045417] [17592186486413 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486413 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{10}}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,1⟩, \\\\ N(t) & =⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." #edb/ref 17592186045417] [17592186486413 #edb/ref 1072 #uuid "8febc0ce-a013-5227-b117-55a62f849158" #edb/ref 17592186045417] [17592186486413 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{10}}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,1⟩\\times ⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩ \\\\  & =\\frac{1}{\\sqrt{10}}\\,\\left|\\begin{aligned}i & j & k \\\\ -3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t & 1 \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{10}}[\\text{ }\\left|\\begin{aligned}3\\operatorname{cos}⁡t & 1 \\\\ -\\operatorname{sin}⁡t & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 1 \\\\ -\\operatorname{cos}⁡t & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{10}}⟨(0+\\operatorname{sin}⁡t),-(0+\\operatorname{cos}⁡t),(3{sin}^{2}⁡t+3{cos}^{2}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨\\operatorname{sin}⁡t,-\\operatorname{cos}⁡t,3⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486428 #edb/ref 1068 #edb/ref 17592186486284 #edb/ref 17592186045417] [17592186486428 #edb/ref 1069 "q-99651" #edb/ref 17592186045417] [17592186486428 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186486428 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{4{t}^{2}+5}}⟨2t,\\,2,\\,-1⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." #edb/ref 17592186045417] [17592186486428 #edb/ref 1072 #uuid "b10a522e-2ca7-50dc-98ce-c79fed01cd4f" #edb/ref 17592186045417] [17592186486428 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{4{t}^{2}+5}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{4{t}^{2}+5}}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{1}{\\sqrt{4{t}^{2}+5}})⟩ \\\\  & =⟨\\frac{10}{(4{t}^{2}+5)^{3/2}},\\,-\\frac{8t}{(4{t}^{2}+5)^{3/2}},\\,\\frac{4t}{(4{t}^{2}+5)^{3/2}}⟩ \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}⟨5,\\,-4t,\\,2t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{(5)^{2}+(-4t)^{2}+(2t)^{2}} \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{25+16{t}^{2}+4{t}^{2}} \\\\  & =\\frac{2}{(4{t}^{2}+5)^{3/2}}\\sqrt{20{t}^{2}+25} \\\\  & =\\frac{2\\sqrt{5}}{(4{t}^{2}+5)^{3/2}}\\sqrt{4{t}^{2}+5} \\\\  & =\\frac{2\\sqrt{5}}{4{t}^{2}+5}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{2}{(4{t}^{2}+5)^{3/2}}⟨5,\\,-4t,\\,2t⟩}{(\\frac{2\\sqrt{5}}{4{t}^{2}+5})}=\\frac{1}{\\sqrt{5}\\sqrt{4{t}^{2}+5}}⟨5,\\,-4t,\\,2t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{4{t}^{2}+5}}⟨2t,2,-1⟩\\times \\frac{1}{\\sqrt{5}\\sqrt{4{t}^{2}+5}}⟨5,\\,-4t,\\,2t⟩ \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}\\,\\left|\\begin{aligned}i & j & k \\\\ 2t & 2 & -1 \\\\ 5 & -4t & 2t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}[\\text{ }\\left|\\begin{aligned}2 & -1 \\\\ -4t & 2t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2t & -1 \\\\ 5 & 2t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2t & 2 \\\\ 5 & -4t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}⟨4t-4t,-(4{t}^{2}+5),-8{t}^{2}-10⟩ \\\\  & =\\frac{1}{\\sqrt{5}(4{t}^{2}+5)}⟨0,\\,-(4{t}^{2}+5),\\,-2(4{t}^{2}+5)⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨0,\\,-1,\\,-2⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486433 #edb/ref 1068 #edb/ref 17592186486242 #edb/ref 17592186045417] [17592186486433 #edb/ref 1069 "q-99652" #edb/ref 17592186045417] [17592186486433 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186486433 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{3}⟨\\operatorname{sin}⁡(t+1),2\\sqrt{2},\\operatorname{cos}⁡(t+1)⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." #edb/ref 17592186045417] [17592186486433 #edb/ref 1072 #uuid "bb6bca21-eef1-511a-9545-14146c32b845" #edb/ref 17592186045417] [17592186486433 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t+1)),\\,\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(t+1))⟩ \\\\  & =\\frac{1}{3}⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(\\operatorname{cos}⁡(t+1))^{2}+{(0)}^{2}+{(-\\operatorname{sin}⁡(t+1))}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{cos}^{2}⁡(t+1)+{sin}^{2}⁡(t+1)} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩}{(\\frac{1}{3})}=⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨\\operatorname{sin}⁡(t+1),2\\sqrt{2},\\operatorname{cos}⁡(t+1)⟩\\times ⟨\\operatorname{cos}⁡(t+1),\\,0,\\,-\\operatorname{sin}⁡(t+1)⟩ \\\\  & =\\frac{1}{3}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{sin}⁡(t+1) & 2\\sqrt{2} & \\operatorname{cos}⁡(t+1) \\\\ \\operatorname{cos}⁡(t+1) & 0 & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right| \\\\  & =\\frac{1}{3}[\\text{ }\\left|\\begin{aligned}2\\sqrt{2} & \\operatorname{cos}⁡(t+1) \\\\ 0 & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{sin}⁡(t+1) & \\operatorname{cos}⁡(t+1) \\\\ \\operatorname{cos}⁡(t+1) & -\\operatorname{sin}⁡(t+1)\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{sin}⁡(t+1) & 2\\sqrt{2} \\\\ \\operatorname{cos}⁡(t+1) & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1)-0,-(-{sin}^{2}⁡(t+1)-{cos}^{2}⁡(t+1)),0-2\\sqrt{2}\\operatorname{cos}⁡(t+1)⟩ \\\\  & =\\frac{1}{3}⟨-2\\sqrt{2}\\operatorname{sin}⁡(t+1),\\,1,\\,-2\\sqrt{2}\\operatorname{cos}⁡(t+1)⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486436 #edb/ref 1068 #edb/ref 17592186486266 #edb/ref 17592186045417] [17592186486436 #edb/ref 1069 "q-127612" #edb/ref 17592186045417] [17592186486436 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486436 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{2}⟨\\sqrt{3},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩, \\\\ N(t) & =⟨0,-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." #edb/ref 17592186045417] [17592186486436 #edb/ref 1072 #uuid "c2c660e0-cf11-56d9-9d4f-3449a41167f3" #edb/ref 17592186045417] [17592186486436 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{2}⟨\\sqrt{3},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{2}\\left|\\begin{aligned}i & j & k \\\\ \\sqrt{3} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{2}[\\text{ }\\left|\\begin{aligned}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\sqrt{3} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\sqrt{3} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{2}⟨({sin}^{2}⁡t-(-{cos}^{2}⁡t)),-(-\\sqrt{3}\\operatorname{sin}⁡t-0),(-\\sqrt{3}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{2}⟨1,\\sqrt{3}\\operatorname{sin}⁡t,-\\sqrt{3}\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486440 #edb/ref 1068 #edb/ref 17592186486265 #edb/ref 17592186045417] [17592186486440 #edb/ref 1069 "q-127694" #edb/ref 17592186045417] [17592186486440 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186486440 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡5t,\\,-1,\\,\\operatorname{sin}⁡5t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." #edb/ref 17592186045417] [17592186486440 #edb/ref 1072 #uuid "c8e555e8-b363-57e5-af62-374122f991ee" #edb/ref 17592186045417] [17592186486440 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{2}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡5t),\\,\\frac{\\text{d}}{\\text{d}t}(-1),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡5t)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-5\\operatorname{sin}⁡5t,\\,0,\\,5\\operatorname{cos}⁡5t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{2}}\\sqrt{(-5\\operatorname{sin}⁡5t)^{2}+{(0)}^{2}+{(5\\operatorname{cos}⁡5t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{2}}\\sqrt{25{sin}^{2}⁡5t+25{cos}^{2}⁡5t} \\\\  & =\\frac{5}{\\sqrt{2}}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{\\sqrt{2}}⟨-5\\operatorname{sin}⁡5t,\\,0,\\,5\\operatorname{cos}⁡5t⟩}{(\\frac{5}{\\sqrt{2}})}=⟨-\\operatorname{sin}⁡5t,\\,0,\\,\\operatorname{cos}⁡5t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡5t,\\,-1,\\,\\operatorname{sin}⁡5t⟩\\times ⟨-\\operatorname{sin}⁡5t,\\,0,\\,\\operatorname{cos}⁡5t⟩ \\\\  & =\\frac{1}{\\sqrt{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{cos}⁡5t & -1 & \\operatorname{sin}⁡5t \\\\ -\\operatorname{sin}⁡5t & 0 & \\operatorname{cos}⁡5t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{2}}[\\text{ }\\left|\\begin{aligned}-1 & \\operatorname{sin}⁡5t \\\\ 0 & \\operatorname{cos}⁡5t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{cos}⁡5t & \\operatorname{sin}⁡5t \\\\ -\\operatorname{sin}⁡5t & \\operatorname{cos}⁡5t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{cos}⁡5t & -1 \\\\ -\\operatorname{sin}⁡5t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡5t-0,-({cos}^{2}⁡5t+{sin}^{2}⁡5t),0-\\operatorname{sin}⁡5t⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡5t,\\,-1,\\,-\\operatorname{sin}⁡5t⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186486450 #edb/ref 1068 #edb/ref 17592186486304 #edb/ref 17592186045417] [17592186486450 #edb/ref 1069 "q-99266" #edb/ref 17592186045417] [17592186486450 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186486450 #edb/ref 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{{t}^{2}+1}⟨{t}^{2},\\sqrt{2}t,1⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{2}({t}^{2}+1)}⟨2t,\\sqrt{2}(1-{t}^{2}),-2t⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." #edb/ref 17592186045417] [17592186486450 #edb/ref 1072 #uuid "da6d9860-f69d-5d57-89ed-5b37be24ddaf" #edb/ref 17592186045417] [17592186486450 #edb/ref 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{{t}^{2}+1}⟨{t}^{2},\\sqrt{2}t,1⟩\\times \\frac{1}{\\sqrt{2}({t}^{2}+1)}⟨2t,\\sqrt{2}(1-{t}^{2}),-2t⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ {t}^{2} & \\sqrt{2}t & 1 \\\\ 2t & \\sqrt{2}(1-{t}^{2}) & -2t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}[\\text{ }\\left|\\begin{aligned}\\sqrt{2}t & 1 \\\\ \\sqrt{2}(1-{t}^{2}) & -2t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}{t}^{2} & 1 \\\\ 2t & -2t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}{t}^{2} & \\sqrt{2}t \\\\ 2t & \\sqrt{2}(1-{t}^{2})\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-2\\sqrt{2}{t}^{2}-\\sqrt{2}(1-{t}^{2}),-(-2{t}^{3}-2t),(\\sqrt{2}{t}^{2}(1-{t}^{2})-2\\sqrt{2}{t}^{2})⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-\\sqrt{2}{t}^{2}-\\sqrt{2},2{t}^{3}+2t,-\\sqrt{2}{t}^{4}-\\sqrt{2}{t}^{2}⟩ \\\\  & =\\frac{1}{\\sqrt{2}({t}^{2}+1)^{2}}⟨-\\sqrt{2}({t}^{2}+1),2t({t}^{2}+1),-\\sqrt{2}{t}^{2}({t}^{2}+1)⟩ \\\\  & =\\frac{1}{{t}^{2}+1}⟨-1,\\sqrt{2}t,-{t}^{2}⟩.\\end{aligned}\n$$" #edb/ref 17592186045417]}
