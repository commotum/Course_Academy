86405}] :knowledge-point/title "Calculating a Specific Binormal Vector to a Curve Given the Unit Tangent and Principal Normal"} :step/id #uuid "171b5dbe-8666-5a5c-8f90-fe3b44d099a2" :step/math-academy-id 31929 :step/next {:db/id #edb/ref 17592186167678}} {:db/id #edb/ref 17592186167678 :step/content {:db/id #edb/ref 17592186166837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166679 :question/id #uuid "e805dcee-247b-5aa3-9856-f7bd48bd1a78" :question/math-academy-id "e-8597"} :knowledge-point/id #uuid "93d895a2-73eb-5141-b56d-48090debf57b" :knowledge-point/questions [{:db/id #edb/ref 17592186167498} {:db/id #edb/ref 17592186167544} {:db/id #edb/ref 17592186362381} {:db/id #edb/ref 17592186373435} {:db/id #edb/ref 17592186373442} {:db/id #edb/ref 17592186387817} {:db/id #edb/ref 17592186395693} {:db/id #edb/ref 17592186486428} {:db/id #edb/ref 17592186486433} {:db/id #edb/ref 17592186486440}] :knowledge-point/title "Calculating the General Binormal Vector to a Curve Given the Unit Tangent"} :step/id #uuid "45a7a61e-103e-532f-aa53-42180b78442d" :step/math-academy-id 31930} {:db/id #edb/ref 17592186167731 :step/content {:db/id #edb/ref 17592186168115 :tutorial/content "The **binormal vector** to a curve $C$ defined by the vector-valued function $\\mathbf{r}(t)$ is defined as\n\n$$\n\\mathbf{B}(t) = \\mathbf{T}(t) \\times \\mathbf{N}(t),\n$$\n\nwhere $\\mathbf{T}$ and $\\mathbf{N}$ denote the unit tangent and principal normal vectors, respectively.\n\nThe diagram below shows the binormal vector to a curve at some point $P$ on the curve. \n\n![](images/95/95a892eb30b26d1255d29dcaaac552663443c00b2db6fe1e9168a77be061f2c0.png)\n\nSince $\\mathbf B = \\mathbf T\\times \\mathbf N,$ we can conclude that $\\mathbf B$ is perpendicular to both $\\mathbf T$ and $\\mathbf N,$ and it's pointing downward.\n\nAlso, since $\\mathbf T$ and $\\mathbf N$ are perpendicular *unit* vectors, it follows that $\\mathbf B$ is also a unit vector." :tutorial/id #uuid "eeccaac7-95df-5a69-8449-18e90f7ef33a" :tutorial/math-academy-id 5544 :tutorial/title "Introduction"} :step/id #uuid "ec2925b5-6f20-57e1-ac41-26fc9b56da32" :step/math-academy-id 34413 :step/next {:db/id #edb/ref 17592186167676}}] :activity/title "Binormal Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186166979}]}
