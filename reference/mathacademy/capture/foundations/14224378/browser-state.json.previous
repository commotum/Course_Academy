><mi>C</mi></msub><mi mathvariant=\"normal\">∇</mi><mi>f</mi><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mi>π</mi><mo>,</mo><mi>π</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mo>⋅</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>⋅</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msup><mo>+</mo><mn>1</mn><mo>⋅</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>π</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
