data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow><mo stretchy=\"false\">(</mo><mi>π</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>π</mi><mo>,</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>π</mi><mn>2</mn></msup><mo>⋅</mo><mn>2</mn><mo>−</mo><msup><mn>2</mn><mn>2</mn></msup><mo>⋅</mo><mi>π</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><msup><mn>0</mn><mn>2</mn></msup><mo>⋅</mo><mn>0</mn><mo>−</mo><msup><mn>0</mn><mn>2</mn></msup><mo>⋅</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>2</mn><msup><mi>π</mi><mn>2</mn></msup><mo>−</mo><mn>4</mn><mi>π</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>π</mi><mn>2</mn></msup><mo>−</mo><mn>4</mn><mi>π</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
