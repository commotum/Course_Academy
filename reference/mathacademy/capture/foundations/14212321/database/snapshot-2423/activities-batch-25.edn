d #edb/ref 17592186414928}] :knowledge-point/title "Line Integrals Over Line Segments"} :step/id #uuid "2bd70267-cee5-535e-880d-6ade2c843224" :step/math-academy-id 35693 :step/next {:db/id #edb/ref 17592186180490}}] :activity/title "Line Integrals of Vector-Valued Functions Over General Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179864}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186199393} :activity/id #uuid "f3742955-3684-5655-938c-85f92fc58b37" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186199392 :step/content {:db/id #edb/ref 17592186198442 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198088 :question/id #uuid "ed6483ae-971a-543b-adb6-72ac5809b602" :question/math-academy-id "e-12662"} :knowledge-point/id #uuid "a9d4e49c-202b-564f-839d-64b5d71a3783" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050820}] :knowledge-point/questions [{:db/id #edb/ref 17592186198560} {:db/id #edb/ref 17592186198562} {:db/id #edb/ref 17592186269176} {:db/id #edb/ref 17592186284631} {:db/id #edb/ref 17592186284632} {:db/id #edb/ref 17592186378955} {:db/id #edb/ref 17592186388524} {:db/id #edb/ref 17592186389629} {:db/id #edb/ref 17592186389636} {:db/id #edb/ref 17592186410196} {:db/id #edb/ref 17592186442114} {:db/id #edb/ref 17592186514484}] :knowledge-point/title "Finding Where the Extrema of a Quadratic Form Are Attained on the Unit Sphere"} :step/id #uuid "81974eea-7a73-591a-8f79-590de81df808" :step/math-academy-id 45752 :step/next {:db/id #edb/ref 17592186199396}} {:db/id #edb/ref 17592186199393 :step/content {:db/id #edb/ref 17592186199515 :tutorial/content "If $A$ is the matrix corresponding to the quadratic form $Q(\\mathbf{x}),$ then:  \n\n- The maximum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the largest eigenvalue $\\lambda_{\\textrm{max}}$ of $A,$ and the maximum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{max}}.$\n\n- The minimum value of $Q(\\mathbf{x}),$ when $\\| \\mathbf{x} \\|=1,$ is equal to the smallest eigenvalue $\\lambda_{\\textrm{min}}$ of $A,$ and the minimum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{min}}.$\n\nWe'll prove this result at the end of the lesson.\n\nSuppose we're given that the maximum value of the quadratic form \n\n$$\nQ(\\mathbf{x})=x_1^2-10\\: \\! x_1x_2+x_2^2\n$$\n\n \n\nwhen $\\| \\mathbf{x} \\| = 1$ is $6.$ Let's use this to find a unit vector $\\mathbf{u}_{\\textrm{max}}$ where this maximum value is attained. \n\nSo first, we write down the matrix of our quadratic form:\n\n![](images/a6/a6165f41eb43e8f6e8fd4399f1c428f73481de9d4b5ec41293f3ec0e4f062fc6.svg)\n\nNext, we find the unit eigenvector that corresponds to the eigenvalue $\\lambda_{\\textrm{max}}=6{:}$\n\n$$\n\\begin{aligned}A-6I & =\\begin{bmatrix}1 & -5 \\\\ -5 & 1\\end{bmatrix}-6\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-5 & -5 \\\\ -5 & -5\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-6I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](images/30/30699c4f0abcb099a6f7a76cbd76674757c3f7de313e034d0870d1fce27fdd8c.svg) \n\nFinally, dividing $\\mathbf{v}$ by its norm $\\| \\mathbf{v} \\| = \\sqrt{2},$ we get \n\n![](images/ef/ef14ea5facf5010b99721cf915f44162dfa52e089508fb78c2d02d9aad66f1a4.svg)  \n\nLet's check that this is indeed the vector we were looking for: \n\n$$\n\\begin{aligned}Q({u}_{\\text{max}}) & ={(\\frac{-1}{\\sqrt{2}})}^{2}-10(\\frac{-1}{\\sqrt{2}})(\\frac{1}{\\sqrt{2}})+{(\\frac{1}{\\sqrt{2}})}^{2} \\\\  & =\\frac{1}{2}+\\frac{10}{2}+\\frac{1}{2} \\\\  & =6\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "c50ae6a7-1f29-5274-bd82-d2d8acfef6b7" :tutorial/math-academy-id 7954 :tutorial/title "Introduction"} :step/id #uuid "08dd4ae6-a6ab-54da-a4ca-840835781b76" :step/math-academy-id 45755 :step/next {:db/id #edb/ref 17592186199394}} {:db/id #edb/ref 17592186199394 :step/content {:db/id #edb/ref 17592186198443 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198089 :question/id #uuid "8a1adb2a-e9c5-52e1-bfa0-6977884fae42" :question/math-academy-id "e-12663"} :knowledge-point/id #uuid "6115493b-482c-5360-8d19-52582228e21d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048775} {:db/id #edb/ref 17592186050447}] :knowledge-point/questions [{:db/id #edb/ref 17592186198559} {:db/id #edb/ref 17592186198561} {:db/id #edb/ref 17592186269174} {:db/id #edb/ref 17592186284630} {:db/id #edb/ref 17592186389622} {:db/id #edb/ref 17592186410198} {:db/id #edb/ref 17592186492836}] :knowledge-point/title "Finding Where the Extrema of a Quadratic Form Is Attained on the Unit Circle"} :step/id #uuid "47cdbdea-03d3-506b-a42b-a5ac82733039" :step/math-academy-id 45756 :step/next {:db/id #edb/ref 17592186199392}} {:db/id #edb/ref 17592186199395 :step/content {:db/id #edb/ref 17592186198444 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198090 :question/id #uuid "a6abb2f6-6e59-59ac-8549-62d25b3b6e9b" :question/math-academy-id "e-12664"} :knowledge-point/id #uuid "17fd5c3d-d4c6-5f78-b262-fbc6b7209501" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048300} {:db/id #edb/ref 17592186049456}] :knowledge-point/questions [{:db/id #edb/ref 17592186198684} {:db/id #edb/ref 17592186198685} {:db/id #edb/ref 17592186284641} {:db/id #edb/ref 17592186284645} {:db/id #edb/ref 17592186284646} {:db/id #edb/ref 17592186378962} {:db/id #edb/ref 17592186378969} {:db/id #edb/ref 17592186389643} {:db/id #edb/ref 17592186389855} {:db/id #edb/ref 17592186410195} {:db/id #edb/ref 17592186410197} {:db/id #edb/ref 17592186492837}] :knowledge-point/title "Finding Where the Extrema of a Quadratic Form Is Attained Over an Ellipse"} :step/id #uuid "d2f76172-74c1-501b-a19c-68e6454733cb" :step/math-academy-id 45757 :step/next {:db/id #edb/ref 17592186199404}} {:db/id #edb/ref 17592186199396 :step/content {:db/id #edb/ref 17592186199516 :tutorial/content "Suppose we're given that the maximum value of the quadratic form \n\n$$\nQ(\\mathbf{x})=x_1^2-2x_1x_2+x_2^2,\n$$\n\n over the ellipse $4x_1^2+x_2^2=4$ equals $5.$ How can we find a vector $\\mathbf{x}$ at which this maximum is attained?\n\nWe can find this vector by applying a suitable change of variable. This change of variable should transform our problem into one where we need to maximize a related quadratic form $Q'$ on the unit circle. Let's see how this is done.\n\nFirst, we write down the matrix of our quadratic form:\n\n![](images/7b/7b1fd813963e16887c57d6c10be1bfe288e3209fd3a02ca6e6236b7261feb7b1.svg)\n\nNotice that we can write the constraint equation as follows:\n\n$$\n{x_1^2}+ \\dfrac{x_2^2}{2^2}=1\n$$\n\nwhich  represents an ellipse with semiaxes $a=1$ (along the $x_1$-axis) and $b=2$ (along the $x_2$-axis). \n\nIf we introduce new variables\n\n$$\ny_1={x_1}, \\qquad y_2 = \\dfrac{x_2}{2},\n$$\n\nthe equation of the ellipse will transform into $y_1^2+y_2^2 = 1,$ or $\\|\\mathbf{y}\\|=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n![](images/80/80f8e821a60b63dde0f314460adfd31faca5d82315243fb2a3ebdec75bc61538.svg) \n\nwe obtain that $\\mathbf{x} = P \\mathbf{y}.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(\\mathbf{x}) = \\mathbf{x}^T \\! A \\mathbf{x} = (P\\mathbf{y})^T A \\, (P\\mathbf{y}) = \\mathbf{y}^T \\! (P^TAP) \\mathbf{y}=Q'(\\mathbf{y}).\n$$\n\nAs a result, since $P^T=P,$ the matrix of our quadratic form in the new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ -2 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, the goal is to maximize $Q'(\\mathbf{y})$ when $\\| \\mathbf{y} \\|=1,$ which we do using our usual methods.  \n\nSince we are told that the maximum value of the quadratic form is $5,$ we have\n\n$$\n\\max \\{ Q'(\\mathbf{y}) \\: | \\: \\| \\mathbf{y} \\|=1 \\} = \\lambda_{\\max} = 5.\n$$\n\nNext, we find the unit eigenvector that corresponds to the eigenvalue $\\lambda_{\\textrm{max}}=5{:}$\n\n$$\n\\begin{aligned}B-5I & =\\begin{bmatrix}1 & -2 \\\\ -2 & 4\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -2 \\\\ -2 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-5I)\\mathbf{y}=\\mathbf{0}$ gives the eigenvector ![](images/4b/4b51afece6e21c2fe073a5346557f42f9f03ae3400407d18ed6af3af8f32e310.svg) Dividing $\\mathbf{v}$ by its norm $\\| \\mathbf{v} \\| = \\sqrt{5},$ we get \n\n![](images/ce/ce571338fc1d83f0b0892a356bca56073c096a1f5191a21a4baef56b6d5a399f.svg) \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 4\\end{bmatrix}\\end{aligned}\n$$" :tutorial/id #uuid "e750f422-509a-598a-858a-c11360c80eea" :tutorial/math-academy-id 7955 :tutorial/title "Constrained Optimization of Quadratic Forms Over Ellipses"} :step/id #uuid "f3b4db0d-8fec-573f-8597-7e9b0d0a4474" :step/math-academy-id 45758 :step/next {:db/id #edb/ref 17592186199395}} {:db/id #edb/ref 17592186199404 :step/content {:db/id #edb/ref 17592186199547 :tutorial/content "To complete the picture, let's prove the main theorem of this lesson:\n\n*The maximum value of a quadratic form $Q(\\mathbf{x})=\\mathbf{x}^T A \\mathbf{x},$ when $\\| \\mathbf{x} \\|=1,$ is equal to the largest eigenvalue of $A{:}$* \n\n$$\n\\max \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\lambda_{\\textrm{max}}\n$$\n\n*The maximum is attained on the corresponding unit eigenvector $\\mathbf{u}_{\\textrm{max}}.$*\n\n**Note:** We'll show only the first part (about the maximum value) since a similar argument can be used to prove the second part (about the minimum value).\n\nLet $A$ be a real $n \\times n$ symmetric matrix corresponding to a quadratic form $Q(\\mathbf x)\\mathbin.$ As a result, there must be an *orthonormal* matrix $P$ such that \n\n- $D=P^{-1}AP=P^TAP,$ where $D$ is a diagonal matrix.\n\n- The diagonal entries of $D$ are the eigenvalues of $A$. Without loss of generality, we can assume that the eigenvalues are $\\lambda_1 \\geq \\lambda_2 \\geq \\ldots \\geq \\lambda_n,$ where $\\lambda_{\\textrm{max}} = \\lambda_1.$\n\n- The columns $\\mathbf{u}_1,\\mathbf{u}_2, \\ldots, \\mathbf{u}_n$ of $P$ form an orthonormal set of unit eigenvectors of $A.$ So, $\\mathbf{u}_{\\textrm{max}} = \\mathbf{u}_1.$\n\nTake $\\mathbf x=P\\mathbf y.$ Since, $P$ is orthonormal, we have\n\n$$\n\\|\\mathbf x\\| = \\|P \\mathbf y \\| = \\|\\mathbf y\\|\n$$\n\nand\n\n$$\nQ(\\mathbf x) = \\mathbf x^T\\!A\\mathbf x = (P\\mathbf y)^T\\!A(P\\mathbf y) = \\mathbf{y}^T (P^T\\!AP) \\mathbf{y} = \\mathbf{y}^T D \\mathbf{y}\n$$\n\nfor all $\\mathbf{y} \\in \\mathbb{R}^n.$\n\nTherefore, we can conclude the following:\n\n- $\\|\\mathbf x\\| =1 \\Longleftrightarrow \\|\\mathbf y\\| =1$ for all $\\mathbf y$ such that $\\mathbf x=P\\mathbf y$\n\n- Restricted to the unit sphere of $\\Bbb R^n,$ the images of the quadratic forms $Q(\\mathbf x)$  and $Q'(\\mathbf y)= \\mathbf y^T D\\mathbf y$ coincide: \n\n$$\n\\{\\mathbf x^TA\\mathbf x: \\: \\: \\|\\mathbf x\\|=1\\}= \\{\\mathbf y^TD\\mathbf y: \\: \\: \\|\\mathbf y\\|=1\\}  \\subset \\mathbb R\n$$\n\nNow, for any unit vector $\\mathbf{y} \\in \\mathbb{R}^n,$ we obtain\n\n$$\n\\begin{aligned}Q(x) & ={Q}^{′}(y) \\\\  & ={\\lambda }_{1}{y}_{1}^{2}+{\\lambda }_{2}{y}_{2}^{2}+⋯+{\\lambda }_{n}{y}_{n}^{2} \\\\  & \\le {\\lambda }_{\\text{max}}\\,{y}_{1}^{2}+{\\lambda }_{\\text{max}}\\,{y}_{2}^{2}+⋯+{\\lambda }_{\\text{max}}\\,{y}_{n}^{2} \\\\  & ={\\lambda }_{\\text{max}}({y}_{1}^{2}+{y}_{2}^{2}+⋯+{y}_{n}^{2}) \\\\  & ={\\lambda }_{\\text{max}}\\,‖y{‖}^{2} \\\\  & ={\\lambda }_{\\text{max}}.\\end{aligned}\n$$\n\nSo, we have that  that \n\n$$\nM = \\max \\{ Q(\\mathbf{x}) \\: | \\:  \\| \\mathbf{x} \\| = 1 \\} = \\max \\{ Q'(\\mathbf{y}) \\: | \\:  \\| \\mathbf{y} \\| = 1 \\} \\le \\lambda_{\\textrm{max}}.\n$$\n\n \n\nOn the other hand, if we take ![](images/53/53a051ea36059c9222e717c65adc6531bc313c9807d44a39b262433acfdcbc5c.svg) then $Q(P\\mathbf{e}_1) = Q'(\\mathbf{e}_1) = \\lambda_{\\textrm{max}}.$ So, we conclude that $M = \\lambda_{\\textrm{max}}.$\n\nFinally, since $\\mathbf{u}_1 = P\\mathbf{e}_1$ we have that \n$Q(\\mathbf u_1) =  \\mathbf e_1^T D \\mathbf e_1 = \\lambda_{\\textrm{max}}.$ \nTherefore, the maximum value is attained at $\\mathbf u_{\\textrm{max}}.$" :tutorial/id #uuid "364005f5-f0fc-5d17-9d6b-288d52abe715" :tutorial/math-academy-id 8176 :tutorial/title "Proof of the Main Theorem"} :step/id #uuid "3a8e9986-4b85-5793-91b8-d47f73b67205" :step/math-academy-id 54038}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198510}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186410202} :activity/id #uuid "f2727b60-7a6b-5f3a-a237-6a67bfb8139d" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186410199 :step/content {:db/id #edb/ref 17592186410196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1700f9a6-fd4f-55e6-a5b2-c7c162c8b09c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186410167} {:answer/id #uuid "56db98f5-8954-5a74-9db5-ea9ad36d4145" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410174} {:answer/id #uuid "5fd6a7be-2123-5e1c-93b5-fa6a69ebca48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410178} {:answer/id #uuid "6f32c544-2ebd-5102-86f5-09f04cfa659e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410179} {:answer/id #uuid "8b0dcfdc-b7d8-5406-814d-16ab7d147b59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410181}] :answer-field/correct {:db/id #edb/ref 17592186410179} :answer-field/id #uuid "62b7e0f0-3a2a-5bad-a1a2-7313ccefaabb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410192}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e6637da-fa52-5317-a60a-ab7680b44bc0" :question/math-academy-id "q-138128" :question/problem "The minimum value of the quadratic form $Q(x)=7{x}_{1}^{2}+8{x}_{2}^{2}+5{x}_{3}^{2}-4{x}_{2}{x}_{3},$ when $‖x‖=1,$ is equal to $4.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 8 & -2 \\\\ 0 & -2 & 5\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=4:$\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}7 & 0 & 0 \\\\ 0 & 8 & -2 \\\\ 0 & -2 & 5\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}3 & 0 & 0 \\\\ 0 & 4 & -2 \\\\ 0 & -2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector $v=\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}.\n$$"} :step/id #uuid "0d7e6a3a-4e90-51f7-9e6d-1f36e15dea08" :step/next {:db/id #edb/ref 17592186410203}} {:db/id #edb/ref 17592186410200 :step/content {:db/id #edb/ref 17592186410197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27fa6c83-fea5-559c-b3af-e6a7e1618346" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}8 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186410169} {:answer/id #uuid "3bb153c6-9455-5e09-b9d4-e4c936682c6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410172} {:answer/id #uuid "566bcdea-96b1-557a-bdcd-81a53378a8b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410173} {:answer/id #uuid "a93b100e-c392-5adc-a3ed-bee963bcaac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410185} {:answer/id #uuid "b119d151-632a-5e08-8a6e-94f8c7ba763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410186}] :answer-field/correct {:db/id #edb/ref 17592186410169} :answer-field/id #uuid "b5b0d1a4-b3d8-5bd2-80e4-83dea5aa94c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410194}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dea55e7b-1cc0-500b-8640-ae39dddce75c" :question/math-academy-id "q-170560" :question/problem "The maximum value of $Q(x)=4{x}_{1}^{2}+4{x}_{1}{x}_{2}+{x}_{2}^{2},$ when $9{x}_{1}^{2}+4{x}_{2}^{2}=36,$ is $25.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{3}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=3$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{3},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 4 \\\\ 6 & 3\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & 12 \\\\ 12 & 9\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the maximum value of the quadratic form is $25,$ we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{max}=25.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=25:$\n\n$$\n\\begin{aligned}B-25I & =\\begin{bmatrix}16 & 12 \\\\ 12 & 9\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-9 & 12 \\\\ 12 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-25I)y=0$ gives the eigenvector $v=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=5,$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{5}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}8 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "3781c4aa-7e7b-5b51-9af4-d354711b0091"} {:db/id #edb/ref 17592186410201 :step/content {:db/id #edb/ref 17592186410195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579c753-1597-556d-8bd8-51a8deed3084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410166} {:answer/id #uuid "1c96736a-b709-578c-8d05-cc73305aecdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410168} {:answer/id #uuid "31146e93-a5b1-5fe1-90a1-7f9c284f1056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410171} {:answer/id #uuid "5dd5c912-e67d-530f-a2c1-baaeaac814c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410177} {:answer/id #uuid "a21806c6-2164-532f-ac84-142d42881117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186410184}] :answer-field/correct {:db/id #edb/ref 17592186410168} :answer-field/id #uuid "5dc24884-5d5e-5b11-b5e7-3763c0022ada" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410191}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3f433543-b9f1-5f20-b0ed-749a73af3fa7" :question/math-academy-id "q-170506" :question/problem "The maximum value of $Q(x)={x}_{1}^{2}+16{x}_{1}{x}_{2}+4{x}_{2}^{2},$ when ${x}_{1}^{2}+4{x}_{2}^{2}=4,$ is $20.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}={x}_{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 16 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the maximum value of the quadratic form is $20,$ we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{max}=20.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=20:$\n\n$$\n\\begin{aligned}B-20I & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}-20\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-16 & 16 \\\\ 16 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-20I)y=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get  \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "80ab5b9e-fd44-5cd4-b555-7638c14ed974" :step/next {:db/id #edb/ref 17592186410200}} {:db/id #edb/ref 17592186410202 :step/content {:db/id #edb/ref 17592186198560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5991713d-c756-5033-8e5a-4d4d4ed69367" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410175} {:answer/id #uuid "5dd4da5f-a084-569f-9c7d-65ba6f2fa2d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410176} {:answer/id #uuid "7a09264a-e062-5b32-b960-ce1fdd0596f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410180} {:answer/id #uuid "a18e2980-f7b3-5399-bdf5-0e6bab2f2d73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410183} {:answer/id #uuid "f781d714-082f-5b5c-9033-4f6f86bf4d82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410188}] :answer-field/correct {:db/id #edb/ref 17592186410176} :answer-field/id #uuid "9a69a67c-d671-56dc-a201-31f05adf2afb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13f589cb-239b-530f-99ce-e58d907d8d98" :question/math-academy-id "q-136828" :question/problem "The minimum value of the quadratic form $Q(x)=-{x}_{1}^{2}-{x}_{2}^{2}+2{x}_{3}^{2}+2{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $-2.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-2:$\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "cd806b8f-e6cf-5b59-a4ed-ccc0cfee81a2" :step/next {:db/id #edb/ref 17592186410199}} {:db/id #edb/ref 17592186410203 :step/content {:db/id #edb/ref 17592186410198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0403e816-9a8a-5caa-a60f-9e0db37c2581" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186410165} {:answer/id #uuid "2ad356f6-e2a2-578b-805e-5d220905af93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410170} {:answer/id #uuid "9cbc00fe-d9dc-5e75-8939-93c74926f323" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410182} {:answer/id #uuid "c87e6493-0b51-5dfe-8402-a4a84620be0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410187} {:answer/id #uuid "fa1e17c0-a680-5fd1-840a-1550ea0d3fa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410189}] :answer-field/correct {:db/id #edb/ref 17592186410170} :answer-field/id #uuid "59381183-ff09-50a9-9c38-82023491a255" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410190}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0bc9465-a035-5136-b09d-b009ddf817a7" :question/math-academy-id "q-170400" :question/problem "The minimum value of the quadratic form $Q(x)={x}_{1}^{2}-10{x}_{1}{x}_{2}+{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $-4.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n \nThe  maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & -5 \\\\ -5 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-4:$\n\n$$\n\\begin{aligned}A-(-4)I & =\\begin{bmatrix}1 & -5 \\\\ -5 & 1\\end{bmatrix}-(-4)\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}5 & -5 \\\\ -5 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-4)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$  \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "f08afe40-e4fb-52cb-a8c1-acffe9c0cb58" :step/next {:db/id #edb/ref 17592186410201}}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410164}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186414677} :activity/id #uuid "dc255669-05a8-5b16-b22c-2690d4b2f343" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186414674 :step/content {:db/id #edb/ref 17592186284641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f3ea30-3f9d-5508-ab40-ee2dba4f0888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186281708} {:answer/id #uuid "2a5452df-294d-5701-b4af-bbf16d6e0530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186282056} {:answer/id #uuid "4e6d984c-3905-5e24-bf07-c5dd11a46a31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186282364} {:answer/id #uuid "bb2908d2-0e8d-5999-a64a-a03cd4b68ae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186283306} {:answer/id #uuid "c1eb5798-946a-56c8-9937-6c6a91e2207e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186283374}] :answer-field/correct {:db/id #edb/ref 17592186283306} :answer-field/id #uuid "e3ab9ad5-298c-5e24-9d44-dc14f057d818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284336}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80991c77-0c00-52ac-bae2-41a3b83ff730" :question/math-academy-id "q-170515" :question/problem "Find the maximum value of $Q(x)={x}_{1}^{2}-18{x}_{1}{x}_{2}+81{x}_{2}^{2}$ given that ${x}_{1}^{2}+9{x}_{2}^{2}=9.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & -9 \\\\ -9 & 81\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{3}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=3$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{3}\\,$ and $\\,{y}_{2}={x}_{2},$ \n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -9 \\\\ -9 & 81\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -27 \\\\ -9 & 81\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -27 \\\\ -27 & 81\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following:\n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & -27 \\\\ -27 & 81-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(81-\\lambda )-729 & =0 \\\\ {\\lambda }^{2}-90\\lambda  & =0 \\\\ \\lambda (\\lambda -90) & =0 \\\\ \\lambda  & =0,\\,90\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{max}}=90.\n$$"} :step/id #uuid "14546d02-e8ca-5bbd-82f2-37c20dd8c152" :step/next {:db/id #edb/ref 17592186414675}} {:db/id #edb/ref 17592186414675 :step/content {:db/id #edb/ref 17592186410197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27fa6c83-fea5-559c-b3af-e6a7e1618346" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}8 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186410169} {:answer/id #uuid "3bb153c6-9455-5e09-b9d4-e4c936682c6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410172} {:answer/id #uuid "566bcdea-96b1-557a-bdcd-81a53378a8b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410173} {:answer/id #uuid "a93b100e-c392-5adc-a3ed-bee963bcaac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186410185} {:answer/id #uuid "b119d151-632a-5e08-8a6e-94f8c7ba763c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410186}] :answer-field/correct {:db/id #edb/ref 17592186410169} :answer-field/id #uuid "b5b0d1a4-b3d8-5bd2-80e4-83dea5aa94c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410194}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "dea55e7b-1cc0-500b-8640-ae39dddce75c" :question/math-academy-id "q-170560" :question/problem "The maximum value of $Q(x)=4{x}_{1}^{2}+4{x}_{1}{x}_{2}+{x}_{2}^{2},$ when $9{x}_{1}^{2}+4{x}_{2}^{2}=36,$ is $25.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{3}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=3$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{3},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 4 \\\\ 6 & 3\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & 12 \\\\ 12 & 9\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the maximum value of the quadratic form is $25,$ we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{max}=25.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=25:$\n\n$$\n\\begin{aligned}B-25I & =\\begin{bmatrix}16 & 12 \\\\ 12 & 9\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-9 & 12 \\\\ 12 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-25I)y=0$ gives the eigenvector $v=\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=5,$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{5}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 \\\\ 3\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}8 \\\\ 9\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "310e7c10-e8a2-5719-93d8-e4b398b84456"} {:db/id #edb/ref 17592186414676 :step/content {:db/id #edb/ref 17592186389629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33fcc9d7-da26-566b-892f-8ca0dccbf100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186389631} {:answer/id #uuid "a86affbe-00af-5daa-9d5d-d6b4c732cb8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389632} {:answer/id #uuid "da2b263a-4cb7-517f-88b9-8ca97ec6707e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186389633} {:answer/id #uuid "b5f8b750-04ea-55ad-b825-30a6ece0925e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186389634} {:answer/id #uuid "0ceac102-859c-568b-8eb7-f0592356b505" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389635}] :answer-field/correct {:db/id #edb/ref 17592186389631} :answer-field/id #uuid "205f15e5-0108-5b4a-888b-1b37b338482c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186389630}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8daa1f82-58aa-5738-bbe7-9b509869abcc" :question/math-academy-id "q-170411" :question/problem "The minimum value of the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+4{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $-1.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin{Q(x)\\,|\\,‖x‖=1}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 2 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-1:$\n\n$$\n\\begin{aligned}A-(-1)I & =\\begin{bmatrix}1 & 2 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}-(-1)\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & 2 & 0 \\\\ 2 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-1)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "5eb99804-d9c9-598f-850b-ee8266ef1130" :step/next {:db/id #edb/ref 17592186414674}} {:db/id #edb/ref 17592186414677 :step/content {:db/id #edb/ref 17592186198562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1512bf0f-a0b6-5737-8456-15bf7348d13a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186414668} {:answer/id #uuid "189d044b-20ef-594f-9050-30d36ea1c805" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186414669} {:answer/id #uuid "3cba96ef-b9b9-582c-9ce3-fb19b45e7859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186414670} {:answer/id #uuid "b75669b6-5915-5577-8d99-85ede9b169dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186414671} {:answer/id #uuid "e53e0f0c-01ad-5114-93c5-0442b0a0663a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186414672}] :answer-field/correct {:db/id #edb/ref 17592186414668} :answer-field/id #uuid "72e392f4-71c8-5797-8085-77f0d25ff7b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414673}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "48e09a9b-efe0-5a6d-96f4-c82dbcd33806" :question/math-academy-id "q-138095" :question/problem "The maximum value of the quadratic form $Q(x)=-{x}_{1}^{2}+2{x}_{2}^{2}+{x}_{3}^{2}+4{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $3.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=3:$\n\n$$\n\\begin{aligned}A-3I & =\\begin{bmatrix}-1 & 2 & 0 \\\\ 2 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}-3\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & 2 & 0 \\\\ 2 & -1 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "7e114801-7198-5362-a3fa-04ef157723ae" :step/next {:db/id #edb/ref 17592186414678}} {:db/id #edb/ref 17592186414678 :step/content {:db/id #edb/ref 17592186284631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8332a7-4bd1-52e2-98d7-9038f8ce3235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186281930} {:answer/id #uuid "6c39f138-7816-5f6d-a956-7902c5315703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186282617} {:answer/id #uuid "97a55d9e-4e6c-5c38-b529-32f84ac78a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186283001} {:answer/id #uuid "acab738c-9574-5721-b030-a0b0df4c366b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186283185} {:answer/id #uuid "dfa10416-ed51-536c-89e2-fee3615750c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186283642}] :answer-field/correct {:db/id #edb/ref 17592186283642} :answer-field/id #uuid "96932f9e-93ef-50d0-97d7-7284d7425f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "496fb18e-ba8b-54b4-a477-d1058ddecd7f" :question/math-academy-id "q-170410" :question/problem "The maximum value of the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+6{x}_{1}{x}_{3},$ when $‖x‖=1,$ is equal to $4.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=4:$\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-3 & 0 & 3 \\\\ 0 & -3 & 0 \\\\ 3 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "e083e187-8c7e-5c25-92c0-ae78700dc8ac" :step/next {:db/id #edb/ref 17592186414676}}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414667}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186422487} :activity/id #uuid "e4ae88a2-fa24-5481-a701-cc4fa393aaa7" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186422486 :step/content {:db/id #edb/ref 17592186284645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58e43fd8-bedb-54d5-9723-4873762018ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186282444} {:answer/id #uuid "6080b967-b1e5-508e-9eb9-b06f08ffc56b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186282507} {:answer/id #uuid "b44dda1b-d74d-5302-ac25-2322f81791f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186283250} {:answer/id #uuid "f9c243a3-3d78-5363-a946-67271923a982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186283874} {:answer/id #uuid "fdac630b-fc7e-5910-8320-fe5c826d997e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186283913}] :answer-field/correct {:db/id #edb/ref 17592186282444} :answer-field/id #uuid "b28de760-832c-5bd3-997a-40bc410c2fcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284244}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "315ff370-acb2-54c0-a94c-7932c53e50d7" :question/math-academy-id "q-170525" :question/problem "Find the maximum value of $Q(x)=-3{x}_{1}^{2}+16{x}_{1}{x}_{2}+12{x}_{2}^{2}$ given that ${x}_{1}^{2}+4{x}_{2}^{2}=4.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-3 & 8 \\\\ 8 & 12\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}={x}_{2},$ \n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 8 \\\\ 8 & 12\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 16 \\\\ 8 & 12\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & 16 \\\\ 16 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following: \n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ \\begin{vmatrix}-12-\\lambda  & 16 \\\\ 16 & 12-\\lambda \\end{vmatrix} & =0 \\\\ (-12-\\lambda )(12-\\lambda )-256 & =0 \\\\ {\\lambda }^{2}-400 & =0 \\\\ (\\lambda -20)(\\lambda +20) & =0 \\\\ \\lambda  & =20,\\,-20\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{max}}=20.\n$$"} :step/id #uuid "0b1d2308-18cf-5d1f-9792-a558d12df58b"} {:db/id #edb/ref 17592186422487 :step/content {:db/id #edb/ref 17592186198560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5991713d-c756-5033-8e5a-4d4d4ed69367" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410175} {:answer/id #uuid "5dd4da5f-a084-569f-9c7d-65ba6f2fa2d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410176} {:answer/id #uuid "7a09264a-e062-5b32-b960-ce1fdd0596f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410180} {:answer/id #uuid "a18e2980-f7b3-5399-bdf5-0e6bab2f2d73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410183} {:answer/id #uuid "f781d714-082f-5b5c-9033-4f6f86bf4d82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186410188}] :answer-field/correct {:db/id #edb/ref 17592186410176} :answer-field/id #uuid "9a69a67c-d671-56dc-a201-31f05adf2afb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410193}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13f589cb-239b-530f-99ce-e58d907d8d98" :question/math-academy-id "q-136828" :question/problem "The minimum value of the quadratic form $Q(x)=-{x}_{1}^{2}-{x}_{2}^{2}+2{x}_{3}^{2}+2{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $-2.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-2:$\n\n$$\n\\begin{aligned}A-(-2)I & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}-(-2)\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "429adbe2-a892-5b81-a3eb-a56fa1a1ea41" :step/next {:db/id #edb/ref 17592186422488}} {:db/id #edb/ref 17592186422488 :step/content {:db/id #edb/ref 17592186198561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb041804-f145-50b4-816c-fcab9c17bcdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186388519} {:answer/id #uuid "b2e13d89-d82e-50de-b738-ce617b4eb4c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388520} {:answer/id #uuid "4da080a5-de45-50af-a433-06854c96c579" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186388521} {:answer/id #uuid "3e2330d3-d405-54f2-a9a6-48d3b6275ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388522} {:answer/id #uuid "3e679990-9d14-53c0-a924-3aa2912773d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388523}] :answer-field/correct {:db/id #edb/ref 17592186388522} :answer-field/id #uuid "c1c95db7-7a90-557c-8b94-0b154d58f86d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e8e756a-b2ab-5c3c-9c14-7a7f8b61663e" :question/math-academy-id "q-138085" :question/problem "The minimum value of the quadratic form $Q(x)=3{x}_{1}^{2}-2{x}_{1}{x}_{2}+3{x}_{2}^{2},$ when $‖x‖=1,$ is equal to $2.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}3 & -1 \\\\ -1 & 3\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=2:$\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}3 & -1 \\\\ -1 & 3\\end{bmatrix}-2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$  \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "6c3129e5-b4ea-5dec-8fac-9e628947093f" :step/next {:db/id #edb/ref 17592186422490}} {:db/id #edb/ref 17592186422489 :step/content {:db/id #edb/ref 17592186389643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e97a677c-7cd3-5ab4-a853-3e58af95ef68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186389645} {:answer/id #uuid "d626e8f2-6f92-5b4c-b77d-4433976b4f8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186389646} {:answer/id #uuid "388c0d7a-2358-5cd2-b7be-8784a5eb4f83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186389647} {:answer/id #uuid "5bee8a5d-5168-5c30-886c-aa5b72b8ba65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}5 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186389648} {:answer/id #uuid "34eaf1be-fb4e-53d6-9abd-f05704e7c071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186389649}] :answer-field/correct {:db/id #edb/ref 17592186389648} :answer-field/id #uuid "807b9eea-f22c-56a9-981a-517ef2430f4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186389644}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "546ae5ae-d06c-5386-b960-6a8c9d016f97" :question/math-academy-id "q-170514" :question/problem "The minimum value of $Q(x)=8{x}_{1}^{2}-30{x}_{1}{x}_{2}-50{x}_{2}^{2},$ when $4{x}_{1}^{2}+25{x}_{2}^{2}=100,$ is $-250.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}8 & -15 \\\\ -15 & -50\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{5}^{2}}+\\frac{{x}_{2}^{2}}{{2}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=5$ (along the ${x}_{1}$-axis) and $b=2$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{5}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}5 & 0 \\\\ 0 & 2\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}5 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}8 & -15 \\\\ -15 & -50\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}40 & -75 \\\\ -30 & -100\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}200 & -150 \\\\ -150 & -200\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we minimize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the minimum value of the quadratic form is $-250,$ we have\n\n$$\nmin\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{min}=-250.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-250:$\n\n$$\n\\begin{aligned}B-(-250I) & =\\begin{bmatrix}200 & -150 \\\\ -150 & -200\\end{bmatrix}+250\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}450 & -150 \\\\ -150 & 50\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-(-250I))y=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{10},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{min}} & =P{u}_{\\text{min}} \\\\  & =\\begin{bmatrix}5 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{10}}\\begin{bmatrix}5 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "8691c397-86b9-56c4-bc27-77cec1d7f354" :step/next {:db/id #edb/ref 17592186422486}} {:db/id #edb/ref 17592186422490 :step/content {:db/id #edb/ref 17592186284632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f787485-bbf8-5fcc-8585-8b059c6d1316" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186281970} {:answer/id #uuid "30948e13-e0e4-533a-a6f9-5aaa08610944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186282120} {:answer/id #uuid "ebb4dd99-b1d6-5677-9be4-afce453696e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186283750} {:answer/id #uuid "f22aaf14-e55f-5ffd-ba05-b66de4ba750f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186283802} {:answer/id #uuid "fb81bdb4-f9c2-5f58-a975-316cb82f7bda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186283890}] :answer-field/correct {:db/id #edb/ref 17592186283890} :answer-field/id #uuid "e275f989-8b1b-539a-87a4-fba67d62a361" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284333}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bda4f08-ef7b-5966-96c3-3621b7deb316" :question/math-academy-id "q-170412" :question/problem "The maximum value of the quadratic form $Q(x)=-4{x}_{1}^{2}+{x}_{2}^{2}+14{x}_{3}^{2}-24{x}_{1}{x}_{3},$ when $‖x‖=1,$ is equal to $20.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-4 & 0 & -12 \\\\ 0 & 1 & 0 \\\\ -12 & 0 & 14\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=20:$\n\n$$\n\\begin{aligned}A-20I & =\\begin{bmatrix}-4 & 0 & -12 \\\\ 0 & 1 & 0 \\\\ -12 & 0 & 14\\end{bmatrix}-20\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-24 & 0 & -12 \\\\ 0 & -19 & 0 \\\\ -12 & 0 & -6\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-20I)x=0$ gives the eigenvector $v=\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}.\n$$"} :step/id #uuid "d3d621c0-f7fd-55c5-881a-bf98c73f81f7" :step/next {:db/id #edb/ref 17592186422489}}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186422485}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186442115} :activity/id #uuid "007e2f87-bfd3-551c-b1fd-ebba47bfe21b" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186442115 :step/content {:db/id #edb/ref 17592186388524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "659e6953-7cee-5b96-970f-fa397b86ee27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388526} {:answer/id #uuid "326d7edd-18b0-5a3b-b08d-0b77a365bbd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186388527} {:answer/id #uuid "b7f8657c-b325-5796-aed4-2807063c509c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186388528} {:answer/id #uuid "aeba8346-f317-5cca-9056-2ca0f6aec458" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186388529} {:answer/id #uuid "76dc6aea-81a8-5e26-8056-6496647263c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186388530}] :answer-field/correct {:db/id #edb/ref 17592186388530} :answer-field/id #uuid "43aa64d2-1826-583b-afa1-0a5a086f07b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388525}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aacc9ef4-d33c-5e64-bc37-708eaf7597fc" :question/math-academy-id "q-138090" :question/problem "The minimum value of the quadratic form $Q(x)=3{x}_{1}^{2}+{x}_{2}^{2}+3{x}_{3}^{2}-2{x}_{1}{x}_{3},$ when $‖x‖=1,$ is equal to $1.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}3 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=1:$\n\n$$\n\\begin{aligned}A-I & =\\begin{bmatrix}3 & 0 & -1 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 3\\end{bmatrix}-\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ -1 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector $v=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.$ \n\nSo, we get \n\n$$\n{u}_{\\text{min}}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "196c1ec1-7222-5bfa-b1e9-032cecfa7659" :step/next {:db/id #edb/ref 17592186442116}} {:db/id #edb/ref 17592186442116 :step/content {:db/id #edb/ref 17592186378955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1abf8ba-5015-5e34-9d28-40c9e16c5051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186378957} {:answer/id #uuid "7e25a544-0386-5dd2-90b3-f72b783a6d7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186378958} {:answer/id #uuid "8dc40c71-4e19-5d2e-9a55-2819fdf76de2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186378959} {:answer/id #uuid "837c2e94-e346-5431-b6dc-4355f5750761" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186378960} {:answer/id #uuid "1728f548-b3f3-5e1a-a4ca-c1075de1983c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186378961}] :answer-field/correct {:db/id #edb/ref 17592186378957} :answer-field/id #uuid "27b09819-07dd-5a76-a6ac-f1f25cee7fe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378956}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c347ff46-ff27-55bd-81ad-5c194a632dd8" :question/math-academy-id "q-170414" :question/problem "The minimum value of the quadratic form $Q(x)=-{x}_{1}^{2}-17{x}_{2}^{2}+7{x}_{3}^{2}-18{x}_{2}{x}_{3},$ when $‖x‖=1,$ is equal to $-20.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -17 & -9 \\\\ 0 & -9 & 7\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-20:$\n\n$$\n\\begin{aligned}A-(-20)I & =\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -17 & -9 \\\\ 0 & -9 & 7\\end{bmatrix}+20\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}19 & 0 & 0 \\\\ 0 & 3 & -9 \\\\ 0 & -9 & 27\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-20)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{10},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "3bf30ed1-f62d-5db0-95c3-bae2ee7a2121" :step/next {:db/id #edb/ref 17592186442118}} {:db/id #edb/ref 17592186442117 :step/content {:db/id #edb/ref 17592186410195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579c753-1597-556d-8bd8-51a8deed3084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410166} {:answer/id #uuid "1c96736a-b709-578c-8d05-cc73305aecdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410168} {:answer/id #uuid "31146e93-a5b1-5fe1-90a1-7f9c284f1056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410171} {:answer/id #uuid "5dd5c912-e67d-530f-a2c1-baaeaac814c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410177} {:answer/id #uuid "a21806c6-2164-532f-ac84-142d42881117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186410184}] :answer-field/correct {:db/id #edb/ref 17592186410168} :answer-field/id #uuid "5dc24884-5d5e-5b11-b5e7-3763c0022ada" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410191}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3f433543-b9f1-5f20-b0ed-749a73af3fa7" :question/math-academy-id "q-170506" :question/problem "The maximum value of $Q(x)={x}_{1}^{2}+16{x}_{1}{x}_{2}+4{x}_{2}^{2},$ when ${x}_{1}^{2}+4{x}_{2}^{2}=4,$ is $20.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}={x}_{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 16 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the maximum value of the quadratic form is $20,$ we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{max}=20.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=20:$\n\n$$\n\\begin{aligned}B-20I & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}-20\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-16 & 16 \\\\ 16 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-20I)y=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get  \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "5f8ca3b8-f2b1-5dda-8678-447d69f170dd" :step/next {:db/id #edb/ref 17592186442119}} {:db/id #edb/ref 17592186442118 :step/content {:db/id #edb/ref 17592186442114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2daa7e54-1e63-51fd-a83f-c84ab1ec9d14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186442108} {:answer/id #uuid "44864e9b-3b6d-5ead-83f1-bf2b06aa99bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186442109} {:answer/id #uuid "47e556d0-ace5-5cd4-bce8-0b8edffbc42a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186442110} {:answer/id #uuid "b628a5cd-923e-5683-b6ff-5e0fdf447fc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186442111} {:answer/id #uuid "f5d0fa24-c8cf-52e6-90a5-639dbcfbac97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186442112}] :answer-field/correct {:db/id #edb/ref 17592186442108} :answer-field/id #uuid "9a8a33df-b62e-5f61-90ea-9cf4c2ac4093" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186442113}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95026062-b044-5134-829b-f9813c55ce41" :question/math-academy-id "q-170503" :question/problem "The minimum value of the quadratic form $Q(x)={x}_{1}^{2}-9{x}_{2}^{2}-{x}_{3}^{2}-6{x}_{2}{x}_{3},$ when $‖x‖=1,$ is equal to $-10.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -9 & -3 \\\\ 0 & -3 & -1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-10:$\n\n$$\n\\begin{aligned}A-(-10)I & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & -9 & -3 \\\\ 0 & -3 & -1\\end{bmatrix}+10\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}11 & 0 & 0 \\\\ 0 & 1 & -3 \\\\ 0 & -3 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-10)I)x=0$ gives the eigenvector $v=\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{10},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{10}}\\begin{bmatrix}0 \\\\ 3 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "92250051-c04a-54d1-8629-4491dfcb275a" :step/next {:db/id #edb/ref 17592186442117}} {:db/id #edb/ref 17592186442119 :step/content {:db/id #edb/ref 17592186378969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fea291ee-6497-5ad3-94fc-370909961651" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378971} {:answer/id #uuid "d36d82c5-f411-510f-b777-9fca82b43277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378972} {:answer/id #uuid "34611fcc-fc75-5837-8815-4b563c9bc527" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186378973} {:answer/id #uuid "a08c13c3-88ad-550d-9cc8-cabd76a06564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186378974} {:answer/id #uuid "a6d304bd-fbab-5bd6-8c82-afcb34c6646e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378975}] :answer-field/correct {:db/id #edb/ref 17592186378971} :answer-field/id #uuid "59fbad7d-97f9-581f-9baa-b0e8b8e58fe8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378970}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d3c8fe2-1d6d-57e9-bf5c-5e70cb30abf3" :question/math-academy-id "q-170561" :question/problem "The minimum value of $Q(x)=4{x}_{1}^{2}-36{x}_{1}{x}_{2}+9{x}_{2}^{2},$ when $4{x}_{1}^{2}+9{x}_{2}^{2}=36,$ is $-72.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}4 & -18 \\\\ -18 & 9\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{3}^{2}}+\\frac{{x}_{2}^{2}}{{2}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=3$ (along the ${x}_{1}$-axis) and $b=2$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{3}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}4 & -18 \\\\ -18 & 9\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & -54 \\\\ -36 & 18\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}36 & -108 \\\\ -108 & 36\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we minimize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the minimum value of the quadratic form is $-72,$ we have\n\n$$\nmin\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{min}=-72.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-72:$\n\n$$\n\\begin{aligned}B-(-72)I & =\\begin{bmatrix}36 & -108 \\\\ -108 & 36\\end{bmatrix}+72\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}108 & -108 \\\\ -108 & 108\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-(-72)I)x=0$ gives the  eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{min}} & =P{u}_{\\text{min}} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "e31c99b8-71b1-5ecf-a2b4-f70c0a3c9f33"}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442107}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186502197} :activity/id #uuid "6d08b23d-f09b-57ac-8094-5a3a4b9cb9fe" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186502171 :step/content {:db/id #edb/ref 17592186284631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8332a7-4bd1-52e2-98d7-9038f8ce3235" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186281930} {:answer/id #uuid "6c39f138-7816-5f6d-a956-7902c5315703" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186282617} {:answer/id #uuid "97a55d9e-4e6c-5c38-b529-32f84ac78a16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186283001} {:answer/id #uuid "acab738c-9574-5721-b030-a0b0df4c366b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186283185} {:answer/id #uuid "dfa10416-ed51-536c-89e2-fee3615750c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186283642}] :answer-field/correct {:db/id #edb/ref 17592186283642} :answer-field/id #uuid "96932f9e-93ef-50d0-97d7-7284d7425f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "496fb18e-ba8b-54b4-a477-d1058ddecd7f" :question/math-academy-id "q-170410" :question/problem "The maximum value of the quadratic form $Q(x)={x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}+6{x}_{1}{x}_{3},$ when $‖x‖=1,$ is equal to $4.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=4:$\n\n$$\n\\begin{aligned}A-4I & =\\begin{bmatrix}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}-4\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-3 & 0 & 3 \\\\ 0 & -3 & 0 \\\\ 3 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$"} :step/id #uuid "203e3740-ec3e-5f05-bb23-784b804df740" :step/next {:db/id #edb/ref 17592186502182}} {:db/id #edb/ref 17592186502174 :step/content {:db/id #edb/ref 17592186284645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58e43fd8-bedb-54d5-9723-4873762018ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186282444} {:answer/id #uuid "6080b967-b1e5-508e-9eb9-b06f08ffc56b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186282507} {:answer/id #uuid "b44dda1b-d74d-5302-ac25-2322f81791f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186283250} {:answer/id #uuid "f9c243a3-3d78-5363-a946-67271923a982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186283874} {:answer/id #uuid "fdac630b-fc7e-5910-8320-fe5c826d997e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186283913}] :answer-field/correct {:db/id #edb/ref 17592186282444} :answer-field/id #uuid "b28de760-832c-5bd3-997a-40bc410c2fcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284244}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "315ff370-acb2-54c0-a94c-7932c53e50d7" :question/math-academy-id "q-170525" :question/problem "Find the maximum value of $Q(x)=-3{x}_{1}^{2}+16{x}_{1}{x}_{2}+12{x}_{2}^{2}$ given that ${x}_{1}^{2}+4{x}_{2}^{2}=4.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-3 & 8 \\\\ 8 & 12\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}={x}_{2},$ \n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-3 & 8 \\\\ 8 & 12\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 16 \\\\ 8 & 12\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 & 16 \\\\ 16 & 12\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following: \n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ \\begin{vmatrix}-12-\\lambda  & 16 \\\\ 16 & 12-\\lambda \\end{vmatrix} & =0 \\\\ (-12-\\lambda )(12-\\lambda )-256 & =0 \\\\ {\\lambda }^{2}-400 & =0 \\\\ (\\lambda -20)(\\lambda +20) & =0 \\\\ \\lambda  & =20,\\,-20\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{max}}=20.\n$$"} :step/id #uuid "2d9889da-3200-5318-891b-ae6984507147" :step/next {:db/id #edb/ref 17592186502189}} {:db/id #edb/ref 17592186502182 :step/content {:db/id #edb/ref 17592186284641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f3ea30-3f9d-5508-ab40-ee2dba4f0888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186281708} {:answer/id #uuid "2a5452df-294d-5701-b4af-bbf16d6e0530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186282056} {:answer/id #uuid "4e6d984c-3905-5e24-bf07-c5dd11a46a31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186282364} {:answer/id #uuid "bb2908d2-0e8d-5999-a64a-a03cd4b68ae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186283306} {:answer/id #uuid "c1eb5798-946a-56c8-9937-6c6a91e2207e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186283374}] :answer-field/correct {:db/id #edb/ref 17592186283306} :answer-field/id #uuid "e3ab9ad5-298c-5e24-9d44-dc14f057d818" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284336}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "80991c77-0c00-52ac-bae2-41a3b83ff730" :question/math-academy-id "q-170515" :question/problem "Find the maximum value of $Q(x)={x}_{1}^{2}-18{x}_{1}{x}_{2}+81{x}_{2}^{2}$ given that ${x}_{1}^{2}+9{x}_{2}^{2}=9.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & -9 \\\\ -9 & 81\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{3}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=3$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{3}\\,$ and $\\,{y}_{2}={x}_{2},$ \n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -9 \\\\ -9 & 81\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -27 \\\\ -9 & 81\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -27 \\\\ -27 & 81\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following:\n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & -27 \\\\ -27 & 81-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(81-\\lambda )-729 & =0 \\\\ {\\lambda }^{2}-90\\lambda  & =0 \\\\ \\lambda (\\lambda -90) & =0 \\\\ \\lambda  & =0,\\,90\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{max}}=90.\n$$"} :step/id #uuid "592400bd-60ae-541a-a9a4-3378b493d7a4" :step/next {:db/id #edb/ref 17592186502174}} {:db/id #edb/ref 17592186502189 :step/content {:db/id #edb/ref 17592186284646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60fcdee7-7ac9-56de-88c2-bc6e649d3116" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186282514} {:answer/id #uuid "8401fb17-15b9-5dc5-a5e7-d89a3bfa1e4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186282829} {:answer/id #uuid "94cc9450-39d8-5e58-92e4-93954393e7bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186282971} {:answer/id #uuid "c7b2ebcc-3812-51ec-b6fd-80b665e2ed43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186283429} {:answer/id #uuid "f4181463-8020-5bfc-b239-9574c62c514c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186283821}] :answer-field/correct {:db/id #edb/ref 17592186283821} :answer-field/id #uuid "a4313712-6e47-551e-bc79-54931942e74b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40232e39-995b-5a30-a61d-aaa5fd4339dd" :question/math-academy-id "q-170526" :question/problem "Find the maximum value of $Q(x)=8{x}_{1}^{2}-8{x}_{1}{x}_{2}-{x}_{2}^{2}$ given that $4{x}_{1}^{2}+{x}_{2}^{2}=16.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}8 & -4 \\\\ -4 & -1\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{4}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=4$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{4},$ \n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}8 & -4 \\\\ -4 & -1\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & -8 \\\\ -16 & -4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}32 & -32 \\\\ -32 & -16\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following:\n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ \\begin{vmatrix}32-\\lambda  & -32 \\\\ -32 & -16-\\lambda \\end{vmatrix} & =0 \\\\ (32-\\lambda )(-16-\\lambda )-1\\,024 & =0 \\\\ {\\lambda }^{2}-16\\lambda -1\\,536 & =0 \\\\ (\\lambda -48)(\\lambda +32) & =0 \\\\ \\lambda  & =48,\\,-32\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{max}}=48.\n$$"} :step/id #uuid "7bf3d4cf-e223-589d-aaf4-04a241fecd3c"} {:db/id #edb/ref 17592186502197 :step/content {:db/id #edb/ref 17592186269176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228b048a-6de3-56b6-a3e7-0871c1de3843" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186266453} {:answer/id #uuid "22995146-b5cd-5ac6-8749-c7773c7a4883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186266456} {:answer/id #uuid "722a44b6-ca00-50fc-94b1-d4f12a5f8cfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186267145} {:answer/id #uuid "a8194835-83cc-5f13-b03f-53bc498ecbc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186267666} {:answer/id #uuid "ce67314a-1abb-56f6-b237-a46f04d3d378" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186267988}] :answer-field/correct {:db/id #edb/ref 17592186267145} :answer-field/id #uuid "8681df6c-6663-5b99-800e-3e89e88d4c91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268645}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cc5eba78-8576-573c-99ab-7374b3ba103b" :question/math-academy-id "q-138132" :question/problem "The maximum value of the quadratic form $Q(x)=-2{x}_{1}^{2}+{x}_{2}^{2}-{x}_{3}^{2}+4{x}_{1}{x}_{2},$ when $‖x‖=1,$ is equal to $2.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n \nThe maximum is attained on the corresponding unit eigenvector ${u}_{\\text{max}}.$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\n \nThe minimum is attained on the corresponding unit eigenvector ${u}_{\\text{min}}.$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}-2 & 2 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\nNow, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=2:$\n\n$$\n\\begin{aligned}A-2I & =\\begin{bmatrix}-2 & 2 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}-2\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & 2 & 0 \\\\ 2 & -1 & 0 \\\\ 0 & 0 & -3\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.$ \n\nFinally, dividing $v$ by its norm $‖v‖=\\sqrt{5},$ we get \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2 \\\\ 0\\end{bmatrix}.\n$$"} :step/id #uuid "ac5650ea-7fcf-5017-b806-6806b8006acb" :step/next {:db/id #edb/ref 17592186502171}}] :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501454}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186514546} :activity/id #uuid "a689b044-d854-52e7-a771-5a0c8c6fa555" :activity/scope {:db/id #edb/ref 17592186048933 :topic/id #uuid "cd37bb30-463c-55ad-8ec5-08aa1d921272" :topic/math-academy-id 4238} :activity/steps [{:db/id #edb/ref 17592186514515 :step/content {:db/id #edb/ref 17592186378969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fea291ee-6497-5ad3-94fc-370909961651" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378971} {:answer/id #uuid "d36d82c5-f411-510f-b777-9fca82b43277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378972} {:answer/id #uuid "34611fcc-fc75-5837-8815-4b563c9bc527" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186378973} {:answer/id #uuid "a08c13c3-88ad-550d-9cc8-cabd76a06564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186378974} {:answer/id #uuid "a6d304bd-fbab-5bd6-8c82-afcb34c6646e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186378975}] :answer-field/correct {:db/id #edb/ref 17592186378971} :answer-field/id #uuid "59fbad7d-97f9-581f-9baa-b0e8b8e58fe8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378970}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6d3c8fe2-1d6d-57e9-bf5c-5e70cb30abf3" :question/math-academy-id "q-170561" :question/problem "The minimum value of $Q(x)=4{x}_{1}^{2}-36{x}_{1}{x}_{2}+9{x}_{2}^{2},$ when $4{x}_{1}^{2}+9{x}_{2}^{2}=36,$ is $-72.$ Which of the following is a vector $x$ at which the minimum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}4 & -18 \\\\ -18 & 9\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{3}^{2}}+\\frac{{x}_{2}^{2}}{{2}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=3$ (along the ${x}_{1}$-axis) and $b=2$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{3}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}\\begin{bmatrix}4 & -18 \\\\ -18 & 9\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & -54 \\\\ -36 & 18\\end{bmatrix}\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}36 & -108 \\\\ -108 & 36\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we minimize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the minimum value of the quadratic form is $-72,$ we have\n\n$$\nmin\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{min}=-72.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{min}}=-72:$\n\n$$\n\\begin{aligned}B-(-72)I & =\\begin{bmatrix}36 & -108 \\\\ -108 & 36\\end{bmatrix}+72\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}108 & -108 \\\\ -108 & 108\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-(-72)I)x=0$ gives the  eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get \n\n$$\n{u}_{\\text{min}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{min}} & =P{u}_{\\text{min}} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "7b55ab94-44ca-5e5f-8316-aab35be9951d"} {:db/id #edb/ref 17592186514542 :step/content {:db/id #edb/ref 17592186410195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1579c753-1597-556d-8bd8-51a8deed3084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}-3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410166} {:answer/id #uuid "1c96736a-b709-578c-8d05-cc73305aecdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410168} {:answer/id #uuid "31146e93-a5b1-5fe1-90a1-7f9c284f1056" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186410171} {:answer/id #uuid "5dd5c912-e67d-530f-a2c1-baaeaac814c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186410177} {:answer/id #uuid "a21806c6-2164-532f-ac84-142d42881117" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186410184}] :answer-field/correct {:db/id #edb/ref 17592186410168} :answer-field/id #uuid "5dc24884-5d5e-5b11-b5e7-3763c0022ada" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410191}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3f433543-b9f1-5f20-b0ed-749a73af3fa7" :question/math-academy-id "q-170506" :question/problem "The maximum value of $Q(x)={x}_{1}^{2}+16{x}_{1}{x}_{2}+4{x}_{2}^{2},$ when ${x}_{1}^{2}+4{x}_{2}^{2}=4,$ is $20.$ Which of the following is a vector $x$ at which the maximum is attained?" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{1}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=1$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}={x}_{2},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinate matrix \n\n$$\nP=\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\n \n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 8 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 16 \\\\ 8 & 4\\end{bmatrix}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}.\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual.\n\nSince we are told that the maximum value of the quadratic form is $20,$ we have\n\n$$\nmax\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{max}=20.\n$$\n\nNext, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{\\text{max}}=20:$\n\n$$\n\\begin{aligned}B-20I & =\\begin{bmatrix}4 & 16 \\\\ 16 & 4\\end{bmatrix}-20\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-16 & 16 \\\\ 16 & -16\\end{bmatrix}\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(B-20I)y=0$ gives the eigenvector $v=\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.$ Dividing $v$ by its norm $‖v‖=\\sqrt{2},$ we get  \n\n$$\n{u}_{\\text{max}}=\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}.\n$$\n\n \n\nFinally, we map this vector back to the initial coordinate  system using the change-of-coordinates matrix:\n\n$$\n\\begin{aligned}{x}_{\\text{max}} & =P{u}_{\\text{max}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "ebe10e4f-7dda-5f32-aa46-5a154ec9adc2" :step/next {:db/id #edb/ref 17592186514515}} {:db/id #edb/ref 17592186514543 :step/content {:db/id #edb/ref 17592186514484 :question/answer-fields [{