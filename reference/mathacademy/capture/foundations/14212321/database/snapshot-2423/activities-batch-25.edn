f9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186415579 :step/content {:db/id #edb/ref 17592186415575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cdbbac-81f1-5a5a-8c0b-cc9eada2874c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186415544} {:answer/id #uuid "62cb00c2-7471-5b2f-86f0-ee1821df8b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186415553} {:answer/id #uuid "903124f2-18ad-506a-90f1-7a04c1d43894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415559} {:answer/id #uuid "a9a954e9-faca-5755-872b-2adf607495f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186415561} {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567}] :answer-field/correct {:db/id #edb/ref 17592186415567} :answer-field/id #uuid "2ee60de8-7912-55ad-80bc-fd51fae2e264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5" :question/math-academy-id "q-95362" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 0 \\\\ 0 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(2-\\lambda ) & =0 \\\\ \\lambda  & =8,\\,2\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{8} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2}\\end{aligned}\n$$"} :step/id #uuid "12c4c78d-1201-5f3b-8360-4897312bf437" :step/next {:db/id #edb/ref 17592186415582}} {:db/id #edb/ref 17592186415580 :step/content {:db/id #edb/ref 17592186415578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a190c4a-9cc2-50ab-a107-16fc3f92fc4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3},\\,2,\\,0" :db/id #edb/ref 17592186415545} {:answer/id #uuid "1e594ce1-22ea-5fd6-afb9-6b06b4b9255c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415546} {:answer/id #uuid "70323d57-c32e-523a-902e-eb0de24ca0c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415554} {:answer/id #uuid "83f12e6b-62c0-5595-a194-e0065cfb501d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415557} {:answer/id #uuid "c6eb0c7d-ecb7-57ee-81fb-a558588e214e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2},\\,1,\\,0" :db/id #edb/ref 17592186415564}] :answer-field/correct {:db/id #edb/ref 17592186415564} :answer-field/id #uuid "646b1b63-2cd4-5c4d-b0e4-160d844e1954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea" :question/math-academy-id "q-95378" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$  \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 1 & 0 \\\\ 1 & 1-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}1-\\lambda  & 1 \\\\ 1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((1-\\lambda )^{2}-1) & =0 \\\\ (1-\\lambda )(1-2\\lambda +{\\lambda }^{2}-1) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -2) & =0 \\\\ \\lambda  & =2,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "5d5c433e-0023-555a-a2d0-920150952da3"} {:db/id #edb/ref 17592186415581 :step/content {:db/id #edb/ref 17592186415577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f16480c-d86a-5db9-b802-4ced71c8377c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5},\\,2,\\,0" :db/id #edb/ref 17592186415549} {:answer/id #uuid "5febb191-7c5d-5f4e-82d6-efc23b4d4485" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186415551} {:answer/id #uuid "73c9cf54-1f9b-52f1-b8ed-dd9e193c12b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415555} {:answer/id #uuid "9d3fcfba-14a5-5b55-ba3e-4a632953d6dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415560} {:answer/id #uuid "be6dbb3a-d9f4-5182-87d2-f89ac41af4ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,3,\\,0" :db/id #edb/ref 17592186415562}] :answer-field/correct {:db/id #edb/ref 17592186415560} :answer-field/id #uuid "b838eb18-ab2d-5fe6-b6c3-92ea8e153a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415573}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ba2e577-1f2d-586f-a5db-7d03c7c71c22" :question/math-academy-id "q-95375" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -1 & 2 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 4 & 0 \\\\ 4 & 5 & -2 \\\\ 0 & -2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & -2 \\\\ 0 & -2 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 4-\\lambda \\end{vmatrix}-4\\begin{vmatrix}4 & -2 \\\\ 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )[(5-\\lambda )(4-\\lambda )-4)]-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +16)-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (4-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "70681b4b-0f8d-5f23-9042-59cb06bbe55f" :step/next {:db/id #edb/ref 17592186415580}} {:db/id #edb/ref 17592186415582 :step/content {:db/id #edb/ref 17592186415574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fab31e-219e-5d18-813a-a8d06acc3248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186415548} {:answer/id #uuid "7f5778c2-893f-5035-ae58-7208c5dc0a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,1" :db/id #edb/ref 17592186415556} {:answer/id #uuid "8e8616be-5d4c-5647-8715-109f64e7adf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186415558} {:answer/id #uuid "c1276a11-417f-5453-89d9-104681d36b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8,\\,4,\\,0" :db/id #edb/ref 17592186415563} {:answer/id #uuid "cf324114-3726-57f4-b073-13b1533f0488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415565}] :answer-field/correct {:db/id #edb/ref 17592186415565} :answer-field/id #uuid "2503f0e3-6a58-532b-b8da-6c772b852974" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415569}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2512d16d-c375-5bf3-9c3b-0ab4d79702bf" :question/math-academy-id "q-95374" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & -1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & -2 \\\\ 0 & -2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 0 & 0 \\\\ 0 & 2-\\lambda  & -2 \\\\ 0 & -2 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}2-\\lambda  & -2 \\\\ -2 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((2-\\lambda )(2-\\lambda )-4) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-4\\lambda ) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -4) & =0 \\\\ \\lambda  & =4,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{4}=2 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "944a1de7-f0ef-562b-9fc3-c518a5f0b063" :step/next {:db/id #edb/ref 17592186415581}} {:db/id #edb/ref 17592186415583 :step/content {:db/id #edb/ref 17592186415576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "226f1dbb-e586-5c42-93b7-43b8c5544971" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,3,\\,0" :db/id #edb/ref 17592186415547} {:answer/id #uuid "4f6c601f-dc07-56ea-bef7-25b4a444358f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15,\\,9,\\,0" :db/id #edb/ref 17592186415550} {:answer/id #uuid "6266bf60-cbee-534e-aaad-f1b70c7c6e56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186415552} {:answer/id #uuid "e2b2ea65-38c0-59e1-8092-216f0cd8d2d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415566} {:answer/id #uuid "f993a82a-65cc-57a6-9da0-7876fb553640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415568}] :answer-field/correct {:db/id #edb/ref 17592186415568} :answer-field/id #uuid "9da244a1-6637-5db7-b8ef-33283dce2b41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415572}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42bc3fa3-d1ed-5eee-8e63-dbe17bc3a3c7" :question/math-academy-id "q-95349" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 & 0 \\\\ 2 & 5 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 2 & 0 \\\\ 2 & 5-\\lambda  & 0 \\\\ 0 & 0 & 0-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "bd730162-8216-5edd-a4e4-aa3f9eb30275" :step/next {:db/id #edb/ref 17592186415579}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415543}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186434793} :activity/id #uuid "f7bf5624-eb3d-524c-adc4-5621731bf40f" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186434791 :step/content {:db/id #edb/ref 17592186368920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17453e7d-2501-500c-988d-632cc6dfbc65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $0$" :db/id #edb/ref 17592186368922} {:answer/id #uuid "3e7fa423-ce11-5e4b-941d-b20daa102519" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186368923} {:answer/id #uuid "7cf839ad-4dca-5536-a5e6-2102abbf3175" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186368924} {:answer/id #uuid "d0871187-035d-52b5-b781-f70eaa3bf24c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186368925} {:answer/id #uuid "0183a8ef-a247-5fec-a72f-23430bb57861" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368926}] :answer-field/correct {:db/id #edb/ref 17592186368925} :answer-field/id #uuid "bbd50738-594a-50f0-9455-2e79aec8430d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368921}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80bd1a5b-eef3-57d3-b7a8-ea1d67708737" :question/math-academy-id "q-95364" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ -3 & -1\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & -6 \\\\ -6 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}10-\\lambda  & -6 \\\\ -6 & 10-\\lambda \\end{vmatrix} & =0 \\\\ (10-\\lambda )(10-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-20\\lambda +100-36 & =0 \\\\ {\\lambda }^{2}-20\\lambda +64 & =0 \\\\ (\\lambda -4)(\\lambda -16) & =0 \\\\ \\lambda  & =16,\\,4\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{16}=4 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2\\end{aligned}\n$$"} :step/id #uuid "0b89f8b4-c620-53dc-98a8-673f79519cb0" :step/next {:db/id #edb/ref 17592186434794}} {:db/id #edb/ref 17592186434792 :step/content {:db/id #edb/ref 17592186368906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aacda77-04a2-5890-a544-02a590c4abbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $1$" :db/id #edb/ref 17592186368908} {:answer/id #uuid "d7d351a9-304d-59f9-bb2a-64ac42ed426b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $0$" :db/id #edb/ref 17592186368909} {:answer/id #uuid "37198688-7720-5bf5-9d97-18a4fc4f1eae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ and $0$" :db/id #edb/ref 17592186368910} {:answer/id #uuid "11993b50-f9b2-5859-af25-cf8175b4ff5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $0$" :db/id #edb/ref 17592186368911} {:answer/id #uuid "4633659c-497d-54ae-9280-c13bf99f6b0b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ and $1$" :db/id #edb/ref 17592186368912}] :answer-field/correct {:db/id #edb/ref 17592186368909} :answer-field/id #uuid "08930f82-1a1a-57e2-874c-8663b93ed935" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368907}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc0c7469-fdf7-5096-ab3b-9c5617b672e6" :question/math-academy-id "q-95316" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}3 & 4\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & 4\\end{bmatrix}}^{T}\\begin{bmatrix}3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\\begin{bmatrix}3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 12 \\\\ 12 & 16\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & 12 \\\\ 12 & 16-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(16-\\lambda )-144 & =0 \\\\ {\\lambda }^{2}-9\\lambda -16\\lambda +144-144 & =0 \\\\ {\\lambda }^{2}-25\\lambda  & =0 \\\\ \\lambda (\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "579fd70b-a4f5-506a-a516-6e2012961957" :step/next {:db/id #edb/ref 17592186434791}} {:db/id #edb/ref 17592186434793 :step/content {:db/id #edb/ref 17592186184878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea50afa6-cf48-5a28-88f9-d3e965d42d17" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186404740} {:answer/id #uuid "58501d70-837f-5aaa-b030-23424dea0d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186404741} {:answer/id #uuid "5b30f13e-19e7-5a1b-8f5a-9d9ae0821275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186404742} {:answer/id #uuid "09c94f4b-6a80-5db2-b8a4-38435a2f0752" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $1$" :db/id #edb/ref 17592186404743} {:answer/id #uuid "185ef847-122c-55fe-afa8-642c48c26e9f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186404744}] :answer-field/correct {:db/id #edb/ref 17592186404743} :answer-field/id #uuid "d1608723-f0ef-5251-b5a7-f10ee403c96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404739}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a7c1d3e-ea07-5462-b92b-00ccbee66e53" :question/math-academy-id "q-94982" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(5-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +25-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +9 & =0 \\\\ (\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "7fbe2269-e57f-5576-bab4-acdbbf9470a5" :step/next {:db/id #edb/ref 17592186434792}} {:db/id #edb/ref 17592186434794 :step/content {:db/id #edb/ref 17592186385852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57ba2282-d4ab-5fbf-9130-d06a2eed65a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186385854} {:answer/id #uuid "b45ecc1a-07a7-50a1-a446-cf4a96064ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186385855} {:answer/id #uuid "f1a83de7-3a30-52e2-a29e-09bdd3418bd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,2,\\,1" :db/id #edb/ref 17592186385856} {:answer/id #uuid "01e6f9da-3643-528a-9879-9df01fb0203d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186385857} {:answer/id #uuid "d58280f6-ca95-52bf-80d9-6a8986b3c8bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186385858}] :answer-field/correct {:db/id #edb/ref 17592186385854} :answer-field/id #uuid "7a01643e-564d-5068-bf87-5773a11495bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63c30a7c-7d2d-5a6c-adcf-5b929543dd1a" :question/math-academy-id "q-95369" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ -2 & 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 5 & -2 \\\\ 0 & -2 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}0-\\lambda  & 0 & 0 \\\\ 0 & 5-\\lambda  & -2 \\\\ 0 & -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((5-\\lambda )(8-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ -\\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "a3a70805-ef62-5a01-8da2-b71b9b73402a" :step/next {:db/id #edb/ref 17592186434795}} {:db/id #edb/ref 17592186434795 :step/content {:db/id #edb/ref 17592186383410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81eab9b6-2c22-56c2-8b09-bb7ba88bb023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $2,$ $1$" :db/id #edb/ref 17592186383412} {:answer/id #uuid "45fdf803-5c63-5fd1-98ac-6d33e693cf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $3,$ $1$" :db/id #edb/ref 17592186383413} {:answer/id #uuid "8b43b2a5-0f26-58bc-89b2-44f5ea0b5aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $4,$ $4$" :db/id #edb/ref 17592186383414} {:answer/id #uuid "e057365e-ebcb-5deb-8291-d5e0f828271e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3,$ $2,$ $1$" :db/id #edb/ref 17592186383415} {:answer/id #uuid "8afd4451-cbc1-5888-a4c6-5aa0879d00a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2,$ $2,$ $2$" :db/id #edb/ref 17592186383416}] :answer-field/correct {:db/id #edb/ref 17592186383415} :answer-field/id #uuid "2d2e9298-f7ae-583b-b56c-2427f10af7e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a2eadfc-214c-5e6d-a649-83f2e39bac57" :question/math-academy-id "q-139505" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 & 0 \\\\ 4 & 5 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & 0 \\\\ 0 & 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((5-\\lambda )(5-\\lambda )-16) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-10\\lambda +9) & =0 \\\\ (4-\\lambda )(\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "b00be353-af3c-5697-8948-437078c60988"}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434790}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186508145} :activity/id #uuid "3ae952a1-d458-5f9b-a574-b6f1f970522e" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186508120 :step/content {:db/id #edb/ref 17592186383410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81eab9b6-2c22-56c2-8b09-bb7ba88bb023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $2,$ $1$" :db/id #edb/ref 17592186383412} {:answer/id #uuid "45fdf803-5c63-5fd1-98ac-6d33e693cf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $3,$ $1$" :db/id #edb/ref 17592186383413} {:answer/id #uuid "8b43b2a5-0f26-58bc-89b2-44f5ea0b5aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $4,$ $4$" :db/id #edb/ref 17592186383414} {:answer/id #uuid "e057365e-ebcb-5deb-8291-d5e0f828271e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3,$ $2,$ $1$" :db/id #edb/ref 17592186383415} {:answer/id #uuid "8afd4451-cbc1-5888-a4c6-5aa0879d00a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2,$ $2,$ $2$" :db/id #edb/ref 17592186383416}] :answer-field/correct {:db/id #edb/ref 17592186383415} :answer-field/id #uuid "2d2e9298-f7ae-583b-b56c-2427f10af7e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a2eadfc-214c-5e6d-a649-83f2e39bac57" :question/math-academy-id "q-139505" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 & 0 \\\\ 4 & 5 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & 0 \\\\ 0 & 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((5-\\lambda )(5-\\lambda )-16) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-10\\lambda +9) & =0 \\\\ (4-\\lambda )(\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "133f1769-65af-55a0-a3e5-d73c5f21e18d"} {:db/id #edb/ref 17592186508123 :step/content {:db/id #edb/ref 17592186404794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7b9b80-3654-5da0-af41-f1dd281a1ec6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,3,\\,1" :db/id #edb/ref 17592186404796} {:answer/id #uuid "adfd1028-f71d-5fb8-bf65-f6a904a4cad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,1,\\,0" :db/id #edb/ref 17592186404797} {:answer/id #uuid "421f5096-6ffe-58b8-95fd-205273c0d9f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,1,\\,0" :db/id #edb/ref 17592186404798} {:answer/id #uuid "2a9e32e2-6234-54e2-a995-a9f7bc9f67fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,2,\\,0" :db/id #edb/ref 17592186404799} {:answer/id #uuid "b769f855-028a-56bf-bb0f-d1970e2ab6bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,\\,1,\\,0" :db/id #edb/ref 17592186404800}] :answer-field/correct {:db/id #edb/ref 17592186404798} :answer-field/id #uuid "3e48eb31-ad56-59b2-a6ab-bf3fcb90c449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de321704-9fad-5ba9-910c-dac492b8f0a2" :question/math-academy-id "q-95377" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -2 & \\,\\,-2 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 8 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & -2 & 0 \\\\ -2 & 8-\\lambda  & 2 \\\\ 0 & 2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{vmatrix}+2\\begin{vmatrix}-2 & 2 \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )[(8-\\lambda )(1-\\lambda )-4)]+2(-2)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4)+(-4)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ \\lambda (1-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "2d8686d7-e3c0-5b66-a1a1-2340938e1450" :step/next {:db/id #edb/ref 17592186508120}} {:db/id #edb/ref 17592186508139 :step/content {:db/id #edb/ref 17592186416486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17199cb6-adea-5b61-919d-b8c404e0acce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454196} {:answer/id #uuid "8d2c651a-9fde-5d68-8dc6-db31d39c222f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454197}] :answer-field/correct {:db/id #edb/ref 17592186454197} :answer-field/id #uuid "4075aa54-0dff-530d-8aaa-0316bbe68384" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454848} {:answer-field/choices [{:answer/id #uuid "ecfe78bb-58cf-5df3-9fec-25b0e56a5cf4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454198} {:answer/id #uuid "1cdaafa5-1a83-54e7-855b-cedee6333689" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454199}] :answer-field/correct {:db/id #edb/ref 17592186454198} :answer-field/id #uuid "ebe209e3-0b27-5e04-917c-a2a111895c0f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454849} {:answer-field/choices [{:answer/id #uuid "72750c08-7405-534f-a4d7-2b63080f7417" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454200} {:answer/id #uuid "cf58434d-bb62-5004-8244-73fdeaf3e6f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454201}] :answer-field/correct {:db/id #edb/ref 17592186454200} :answer-field/id #uuid "7b11c932-8a01-5b51-9317-14a5c84895c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454850}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fef86daf-091a-52fa-bcf0-1d2b609bb348" :question/math-academy-id "q-95281" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $6\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- **II.** The matrix $A=\\begin{bmatrix}-1 & -1 \\\\ -1 & -2\\end{bmatrix}$ has one negative singular value.\n- **III.** Any $4\\times 5$ matrix $A$ has at most $4$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is false. Since $A$ is a $4\\times 5$ matrix and ${A}^{T}$ is a $5\\times 4$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 4}\\times {A}_{4\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "65534646-ddcd-5bd8-a87f-2133012193c1" :step/next {:db/id #edb/ref 17592186508123}} {:db/id #edb/ref 17592186508145 :step/content {:db/id #edb/ref 17592186184877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d4ed93-75bb-5db0-9900-2362979d6c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,3,\\,0" :db/id #edb/ref 17592186404734} {:answer/id #uuid "aac056f1-2c7a-51fc-b3b8-c7516856527b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186404735} {:answer/id #uuid "2ef4562a-20e9-5af5-80a4-ced17b367b83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186404736} {:answer/id #uuid "fd4157e7-a2cf-562a-af6a-fea80f5a7f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186404737} {:answer/id #uuid "95d80c78-37a1-5b82-8b12-a47780191024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186404738}] :answer-field/correct {:db/id #edb/ref 17592186404735} :answer-field/id #uuid "ce3dc232-fc1d-50e4-99b4-15ed1b8fa187" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404733}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9152817-159b-5a54-868d-fe52d19640cc" :question/math-academy-id "q-94981" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ -1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & -2 \\\\ 0 & 4 & -4 \\\\ -2 & -4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & -2 \\\\ 0 & 4-\\lambda  & -4 \\\\ -2 & -4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & -4 \\\\ -4 & 5-\\lambda \\end{vmatrix}-2\\begin{vmatrix}0 & 4-\\lambda  \\\\ -2 & -4\\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(5-\\lambda )-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )(20-4\\lambda -5\\lambda +{\\lambda }^{2}-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "9e4e734e-1d30-5972-b2b0-d48c4de710d5" :step/next {:db/id #edb/ref 17592186508146}} {:db/id #edb/ref 17592186508146 :step/content {:db/id #edb/ref 17592186184878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea50afa6-cf48-5a28-88f9-d3e965d42d17" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186404740} {:answer/id #uuid "58501d70-837f-5aaa-b030-23424dea0d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186404741} {:answer/id #uuid "5b30f13e-19e7-5a1b-8f5a-9d9ae0821275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186404742} {:answer/id #uuid "09c94f4b-6a80-5db2-b8a4-38435a2f0752" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $1$" :db/id #edb/ref 17592186404743} {:answer/id #uuid "185ef847-122c-55fe-afa8-642c48c26e9f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186404744}] :answer-field/correct {:db/id #edb/ref 17592186404743} :answer-field/id #uuid "d1608723-f0ef-5251-b5a7-f10ee403c96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404739}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a7c1d3e-ea07-5462-b92b-00ccbee66e53" :question/math-academy-id "q-94982" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(5-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +25-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +9 & =0 \\\\ (\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "a11d8c53-0d85-5382-8004-1a8f6e94884d" :step/next {:db/id #edb/ref 17592186508139}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507599}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186509031} :activity/id #uuid "25c36865-a3f4-539d-ab87-b42995a49a22" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186509001 :step/content {:db/id #edb/ref 17592186493969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b31b5f-4d45-56bb-9d27-10f181056843" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186493405} {:answer/id #uuid "1f5ebfbd-349c-5710-ab1d-bffdb6d4d025" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186493445} {:answer/id #uuid "21c0505d-1159-59fb-ba8b-2bd5ac4199de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186493447} {:answer/id #uuid "94c66a12-70a7-529f-ba21-ac7f034b13c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186493623} {:answer/id #uuid "e4ada2c6-ebf0-5d58-9a21-8f0d7d2bddb7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186493752}] :answer-field/correct {:db/id #edb/ref 17592186493447} :answer-field/id #uuid "6457d0d0-1968-5324-849a-7bcaae3a3d7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493831}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dfba6eb1-d0b6-5cbc-ac16-d682a2e1cc93" :question/math-academy-id "q-95286" :question/problem "Which of the following statements are true?\n\nI. Any $6\\times 5$ matrix $A$ has at most $6$ distinct singular values.\n\nII. Any $8\\times 9$ matrix $A$ has at most $9$ distinct singular values.\n\nIII. The matrix $A=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}$ has at most two non-negative distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $6\\times 5$ matrix and ${A}^{T}$ is a $5\\times 6$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 6}\\times {A}_{6\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\n- Statement II is true. Indeed, since $A$ is a $8\\times 9$ matrix and ${A}^{T}$ is a $9\\times 8$ matrix, ${A}^{T}\\,A$ must be a $9\\times 9$ matrix: \n\n$$\n{{A}^{T}}_{9\\times 8}\\times {A}_{8\\times 9}={{A}^{T}\\,A}_{9\\times 9}\n$$\n\nHence, $A$ has at most $9$ distinct singular values.\n\n- Statement III is true.  Indeed, all singular values of any matrix are non-negative.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "08b16f9c-1a48-5e48-899f-7bdd30c63128" :step/next {:db/id #edb/ref 17592186509043}} {:db/id #edb/ref 17592186509031 :step/content {:db/id #edb/ref 17592186184876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ac2533-62db-535c-8dc9-3e42649cc9f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $2$" :db/id #edb/ref 17592186368873} {:answer/id #uuid "40993328-f48a-5d16-8477-6064543ac098" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $0$" :db/id #edb/ref 17592186368874} {:answer/id #uuid "02e843f4-0fc7-5f0b-a07b-3fa3bfc2abd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186368875} {:answer/id #uuid "98d65d3b-180c-559c-9c5f-db57ec8866a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186368876} {:answer/id #uuid "f0117d76-d5c6-543b-9609-b905ac185a64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186368877}] :answer-field/correct {:db/id #edb/ref 17592186368875} :answer-field/id #uuid "9f0db150-06f0-53a7-8afc-b9734abea2f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368872}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5015d1af-a116-557e-a448-94566c652f07" :question/math-academy-id "q-94773" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 4 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 4 \\\\ 4 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(8-\\lambda )-16 & =0 \\\\ 16-2\\lambda -8\\lambda +{\\lambda }^{2}-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda  & =0 \\\\ \\lambda (\\lambda -10) & =0 \\\\ \\lambda  & =10,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{10} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "b7075bef-316c-5493-a497-4195378a1e59" :step/next {:db/id #edb/ref 17592186509045}} {:db/id #edb/ref 17592186509040 :step/content {:db/id #edb/ref 17592186415575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cdbbac-81f1-5a5a-8c0b-cc9eada2874c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186415544} {:answer/id #uuid "62cb00c2-7471-5b2f-86f0-ee1821df8b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186415553} {:answer/id #uuid "903124f2-18ad-506a-90f1-7a04c1d43894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415559} {:answer/id #uuid "a9a954e9-faca-5755-872b-2adf607495f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186415561} {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567}] :answer-field/correct {:db/id #edb/ref 17592186415567} :answer-field/id #uuid "2ee60de8-7912-55ad-80bc-fd51fae2e264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5" :question/math-academy-id "q-95362" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 0 \\\\ 0 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(2-\\lambda ) & =0 \\\\ \\lambda  & =8,\\,2\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{8} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2}\\end{aligned}\n$$"} :step/id #uuid "d6b3e1f2-3037-5a02-a9b8-d618b9003666"} {:db/id #edb/ref 17592186509043 :step/content {:db/id #edb/ref 17592186368913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186368915} {:answer/id #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $0$" :db/id #edb/ref 17592186368916} {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} {:answer/id #uuid "a9aa8865-fb8b-5614-b9f2-9c3837814ef1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368918} {:answer/id #uuid "7be86b9d-e96c-5fac-9a1f-8fb3684e2c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186368919}] :answer-field/correct {:db/id #edb/ref 17592186368917} :answer-field/id #uuid "fd34787a-f30f-575c-9f6f-407c026f6c03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368914}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "40523132-fd0a-5a78-90b5-ce48c89eb124" :question/math-academy-id "q-95317" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}3 & -2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & -2\\end{bmatrix}}^{T}\\begin{bmatrix}3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}\\begin{bmatrix}3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -6 \\\\ -6 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & -6 \\\\ -6 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(4-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-9\\lambda -4\\lambda +36-36 & =0 \\\\ {\\lambda }^{2}-13\\lambda  & =0 \\\\ \\lambda (\\lambda -13) & =0 \\\\ \\lambda  & =13,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{13} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "e0f1a8d8-c027-55c3-946a-482b070b07cc" :step/next {:db/id #edb/ref 17592186509040}} {:db/id #edb/ref 17592186509045 :step/content {:db/id #edb/ref 17592186184879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186508445} {:answer/id #uuid "2a9003af-2b01-57da-a933-16ff4579b8dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25,\\,4,\\,0" :db/id #edb/ref 17592186508455} {:answer/id #uuid "80e9ab77-14e2-509c-baf9-6e9048da53b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186508580} {:answer/id #uuid "e99a56fa-1127-5a1f-872f-bba0b1b2c89b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,3,\\,0" :db/id #edb/ref 17592186508761} {:answer/id #uuid "ebe89adf-37a2-5724-a8e8-777891808839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186508767}] :answer-field/correct {:db/id #edb/ref 17592186508445} :answer-field/id #uuid "32eedbf9-e833-5743-ba35-1e838f8db9de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186183883}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "421dde5b-98b5-58e5-8139-6656005b4621" :question/math-academy-id "q-94983" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]}^{T}[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ -4 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 & -12 \\\\ 0 & 16 & 0 \\\\ -12 & 0 & 16\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & 0 & -12 \\\\ 0 & 16-\\lambda  & 0 \\\\ -12 & 0 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )|\\begin{aligned}9-\\lambda  & -12 \\\\ -12 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )((9-\\lambda )(16-\\lambda )-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-9\\lambda -16\\lambda +144-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-25\\lambda ) & =0 \\\\ \\lambda (\\lambda -16)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,16,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{16}=4 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "f17c08c3-3583-5a53-8194-3b1d81d7c6a0" :step/next {:db/id #edb/ref 17592186509001}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508379}] [{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186163068} :activity/id #uuid "fdff7ccc-5a47-5748-b28e-bcf8de0682a8" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186163068 :step/content {:db/id #edb/ref 17592186163326 :tutorial/content "Recall that if $X_1, X_2, \\ldots, X_{n}$ is a random sample of size $n$ drawn from a population with mean $\\mu$ and variance $\\sigma^2,$ then the sample mean, denoted $\\overline{X},$ is given by\n\n$$\n\\overline{X} = \\dfrac1n\\sum_{i=1}^n X_i.\n$$\n\nThe sample mean is a random variable whose probability distribution (also called the **sampling distribution**) has an expected value of $\\mu\\mathbin{:}$\n\n$$\n\\textrm{E}[\\overline{X}] = \\mu\n$$\n\n \n\nIn other words, the sample mean $\\overline{X}$ is an unbiased estimate of the population mean $\\mu.$\n\nLet's now find the variance of the sampling distribution of $\\overline{X}.$ Using the properties of variance for sums of independent random variables, we obtain the following:\n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\text{Var}[\\frac{1}{n}{\\sum }_{i=1}^{n}{X}_{i}] \\\\  & ={(\\frac{1}{n})}^{2}\\cdot \\text{Var}[{\\sum }_{i=1}^{n}{X}_{i}] \\\\  & =\\frac{1}{{n}^{2}}\\cdot \\text{Var}[{X}_{1}+{X}_{2}+⋯+{X}_{n}] \\\\  & =\\frac{1}{{n}^{2}}\\cdot (\\text{Var}[{X}_{1}]+\\text{Var}[{X}_{2}]+⋯+\\text{Var}[{X}_{n}]) \\\\  & =\\frac{1}{{n}^{2}}\\cdot ({\\sigma }^{2}+{\\sigma }^{2}+⋯+{\\sigma }^{2}) \\\\  & =\\frac{1}{{n}^{2}}\\cdot n{\\sigma }^{2} \\\\  & =\\frac{{\\sigma }^{2}}{n}\\end{aligned}\n$$\n\nTo summarize, we have the following important result:\n\n$$\n\\textrm{Var}[\\overline{X}] = \\dfrac{\\sigma^2}{n}\n$$\n\nIt should be noted that we don't yet know the sampling distribution of $\\overline{X}.$ What we *do* know is that whatever the sampling distribution of $\\overline{X}$ is, it has mean $\\mu$ and variance $\\dfrac{\\sigma^2}{n}.$" :tutorial/id #uuid "58763c8a-23b3-55bb-9b5c-4781a3c271b4" :tutorial/math-academy-id 6276 :tutorial/title "Introduction"} :step/id #uuid "0fb9bf51-5dff-5207-8c2c-54d18ba6afd9" :step/math-academy-id 38034 :step/next {:db/id #edb/ref 17592186163069}} {:db/id #edb/ref 17592186163069 :step/content {:db/id #edb/ref 17592186162106 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161672 :question/id #uuid "486f4292-2f50-5d89-be1a-b3c054b449e2" :question/math-academy-id "e-10082"} :knowledge-point/id #uuid "bebcdc0f-dc9b-54ec-9cc5-49b2c046e8b7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048914} {:db/id #edb/ref 17592186050327} {:db/id #edb/ref 17592186050606}] :knowledge-point/questions [{:db/id #edb/ref 17592186162379} {:db/id #edb/ref 17592186162380} {:db/id #edb/ref 17592186418456} {:db/id #edb/ref 17592186418457} {:db/id #edb/ref 17592186435313} {:db/id #edb/ref 17592186435315}] :knowledge-point/title "Finding the Variance of a Sample Mean"} :step/id #uuid "0828c240-f63f-5c50-a2e8-eba11979ee4c" :step/math-academy-id 38036 :step/next {:db/id #edb/ref 17592186163086}} {:db/id #edb/ref 17592186163070 :step/content {:db/id #edb/ref 17592186162107 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161673 :question/id #uuid "41713dda-2195-5bd5-b0be-941b8188cb25" :question/math-academy-id "e-10083"} :knowledge-point/id #uuid "6eac4a2e-cfa8-5476-919e-fd3c26d01d75" :knowledge-point/questions [{:db/id #edb/ref 17592186162381} {:db/id #edb/ref 17592186162382} {:db/id #edb/ref 17592186418458} {:db/id #edb/ref 17592186418459} {:db/id #edb/ref 17592186425753} {:db/id #edb/ref 17592186425754} {:db/id #edb/ref 17592186435314} {:db/id #edb/ref 17592186491194}] :knowledge-point/title "Finding the Standard Error"} :step/id #uuid "ae3ab16a-d830-544c-8331-c62d1505d7dd" :step/math-academy-id 38037 :step/next {:db/id #edb/ref 17592186163087}} {:db/id #edb/ref 17592186163071 :step/content {:db/id #edb/ref 17592186162108 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161674 :question/id #uuid "0f59a118-79ce-5746-8917-6f4092dcbc6a" :question/math-academy-id "e-10084"} :knowledge-point/id #uuid "9453a0f1-029b-5436-94c1-47ee311f6e4d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049435} {:db/id #edb/ref 17592186050315} {:db/id #edb/ref 17592186050383}] :knowledge-point/questions [{:db/id #edb/ref 17592186162383} {:db/id #edb/ref 17592186162394} {:db/id #edb/ref 17592186410430} {:db/id #edb/ref 17592186418454} {:db/id #edb/ref 17592186418455} {:db/id #edb/ref 17592186425755} {:db/id #edb/ref 17592186447168} {:db/id #edb/ref 17592186491123} {:db/id #edb/ref 17592186491183} {:db/id #edb/ref 17592186491203}] :knowledge-point/title "Calculating an Appropriate Sample Size"} :step/id #uuid "6c760552-8a9d-54b8-962b-87e6f849c3da" :step/math-academy-id 38040} {:db/id #edb/ref 17592186163086 :step/content {:db/id #edb/ref 17592186163333 :tutorial/content "The standard deviation of the sample mean is called the **standard error** of the sample mean and is denoted $\\textrm{SE}[\\overline{X}]\\mathbin{:}$ \n\n$$\n\\textrm{SE}[\\overline{X}] = \\sqrt{\\textrm{Var}[\\overline{X}]}\n$$\n\nSo, if we have a random sample of size $n$ drawn from a population with mean $\\mu$ and variance $\\sigma^2,$ then the  standard error is given by\n\n$$\n\\textrm{SE}[\\overline{X}] = \\sqrt{\\dfrac{\\sigma^2}{n}} = \\dfrac{\\sigma}{\\sqrt n}.\n$$" :tutorial/id #uuid "c2217692-f38f-597c-9295-cd25f1d4d026" :tutorial/math-academy-id 6300 :tutorial/title "The Standard Error"} :step/id #uuid "2f745e7f-72c3-508a-96ad-ef71ea659d96" :step/math-academy-id 38149 :step/next {:db/id #edb/ref 17592186163070}} {:db/id #edb/ref 17592186163087 :step/content {:db/id #edb/ref 17592186163334 :tutorial/content "Suppose we have a random sample ![](images/ff/ff40ddf134336ef15bcaf81b5b23aa8fb7c5ea13276e0f86fa6dde15841e0c5d.svg) of size ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg) from a population with mean ![](images/75/75d2faaecd7646e08d87276399a471f8f713fbeda95e358e94410ac2e23b42a5.svg) and variance ![](images/1a/1af459c3f0307649888db8b148eef968a9c5da6a77788c4ab7fe32d6ea30717e.svg) We know that the sample mean \n\n![](images/51/513b88bd8fa93336cc949758da79cac238f871b477d1682ab6b20635a4149361.svg)\n\nis an unbiased estimator of ![](images/98/9878f65a2daf16e1fbd2b0c4929e4407c4ddc406c147dab8a5f6b1a8ee25af33.svg) \n\nHowever, it should be noted that selecting a single observation ![](images/3c/3c8b064868e0622effd6b83427f453ecdb3e033319c9e02969bb988b22ec7cb6.svg) to represent the whole could *also* be considered an unbiased estimator of the population mean. Recall that, by assumption\n\n![](images/e7/e7cc0631f5e6b060f0b9fc77dcac428c2b853d0e19be2e9b20e6e9f8d5d7aaad.svg)\n\nIn what sense is ![](images/84/84269b1ed65c2a169ac4246065d27cbba714010309ddb03a65f7fa878b7b65ea.svg) a \"better\" estimator of ![](images/75/75d2faaecd7646e08d87276399a471f8f713fbeda95e358e94410ac2e23b42a5.svg) than, say, ![](images/c3/c3bb2b6f3769acd8b9c9ce9f929b5bc6c7ec840ab18503cf4c878a1fe8f8f41d.svg) The answer lies in their respective variances. \n\nAs the sample size ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg) becomes larger and larger, the variance and standard error of ![](images/84/84269b1ed65c2a169ac4246065d27cbba714010309ddb03a65f7fa878b7b65ea.svg) become smaller and smaller. It is easy to see that, as ![](images/f4/f4d85c2aac179db9322aef2478cfa080e9d602f8aeb8c0436f646f0e2321c139.svg)\n we have\n![](images/d5/d5676c70b4fcb7f68704ba0bb46fc262c7d8f764748e252aa989d6e82e88283b.svg)\n\nSo, when the sample size ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg) is large, there is less variance in the sampling distribution of ![](images/dc/dc01b2699b68bb8be585039efc249eaeeba5e4ad17a5c687a8811bf266cabc87.svg) Therefore, the larger the sample, the more likely it is that ![](images/84/84269b1ed65c2a169ac4246065d27cbba714010309ddb03a65f7fa878b7b65ea.svg) will give good estimates for ![](images/98/9878f65a2daf16e1fbd2b0c4929e4407c4ddc406c147dab8a5f6b1a8ee25af33.svg) The individual sample elements do not have this property since ![](images/63/631e2156cfdd9541694e1238fb8c717e721e0ef452de4bb898beb2c4509abc6b.svg)\n\nThe key takeaway is that the sample mean ![](images/84/84269b1ed65c2a169ac4246065d27cbba714010309ddb03a65f7fa878b7b65ea.svg) becomes a better estimator for the corresponding population mean ![](images/75/75d2faaecd7646e08d87276399a471f8f713fbeda95e358e94410ac2e23b42a5.svg) as the sample size ![](images/fb/fb2a8560bbc7122a4dd4f1a0bb9862d4368a63f4b03968884a3a60e7423a852c.svg) increases." :tutorial/id #uuid "2fc54f89-7780-558c-8193-28d92a025bc8" :tutorial/math-academy-id 6301 :tutorial/title "The Sample Mean and Large Samples"} :step/id #uuid "c79d4341-23ea-55d9-84aa-e073291790d1" :step/math-academy-id 38150 :step/next {:db/id #edb/ref 17592186163071}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162169}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186425756} :activity/id #uuid "7fa56d66-b299-55c7-8a43-47f002ff063b" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186425756 :step/content {:db/id #edb/ref 17592186162382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "210567c7-e894-5b02-9ee8-c6893172df38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.18\\,\\text{cm}" :db/id #edb/ref 17592186425735} {:answer/id #uuid "60c93555-b34b-575f-95b2-f38de1599831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.15\\,\\text{cm}" :db/id #edb/ref 17592186425739} {:answer/id #uuid "ca20eb7d-1ae8-5c45-ab85-1bae5f9c5811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.32\\,\\text{cm}" :db/id #edb/ref 17592186425747} {:answer/id #uuid "cce28df6-b4e2-5293-9860-139a95e35caa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.24\\,\\text{cm}" :db/id #edb/ref 17592186425748} {:answer/id #uuid "cfed1752-e352-5a6b-9e2d-7dc6a36ff6ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33\\,\\text{cm}" :db/id #edb/ref 17592186425749}] :answer-field/correct {:db/id #edb/ref 17592186425739} :answer-field/id #uuid "e23ca134-e512-533c-83e5-e06d13cf4c5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bcb58811-e371-5576-bf66-5ecfddbfc1fb" :question/math-academy-id "q-143202" :question/problem "A sample ${X}_{1},{X}_{2},{X}_{3}$ of three nails is drawn from a population. The population has nails of two different lengths, $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ distributed in the ratio $4:1.$ Calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the nails in the population have lengths $5\\,\\text{cm}$ and $\\text{10}\\,\\text{cm},$ and these are distributed in the ratio $4:1.$ Therefore, to compute the population mean and variance, we can consider a population consisting of $4+1=5$ nails only with the following lengths:\n\n$$\n5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm},\\,5\\,\\text{cm}\\,10\\,\\text{cm}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(4\\cdot 5+10) \\\\  & =\\frac{1}{5}(20+10) \\\\  & =\\frac{30}{5} \\\\  & =6\\,\\text{cm},\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(4\\cdot {5}^{2}+{10}^{2})-{6}^{2} \\\\  & =\\frac{1}{5}(200)-36 \\\\  & =40-36 \\\\  & =4\\,{\\text{cm}}^{2}.\\end{aligned}\n$$\n\nSince the sample size $n=3,$ we have\n\n$$\n\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}=\\frac{4}{3}\\,{\\text{cm}}^{2}.\n$$\n\nFinally,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{4}{3}}≈1.15\\,\\text{cm}\n$$\n\nrounded to two decimal places."} :step/id #uuid "26fcd0c3-24b3-5951-9b42-4462bd2fac3d" :step/next {:db/id #edb/ref 17592186425759}} {:db/id #edb/ref 17592186425757 :step/content {:db/id #edb/ref 17592186425753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116200b8-f0e0-5d54-986b-cdb0d1f93684" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.13" :db/id #edb/ref 17592186425732} {:answer/id #uuid "19e33d38-75d1-531e-92cf-f39947aea28c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.41" :db/id #edb/ref 17592186425734} {:answer/id #uuid "3e89daf0-19fa-53f4-b72d-31d6ed1621bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.77" :db/id #edb/ref 17592186425737} {:answer/id #uuid "84db3eb9-187b-5476-8ae3-4fc97bb737af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.12" :db/id #edb/ref 17592186425742} {:answer/id #uuid "b7436ec0-730a-5723-89b9-c51e09d25df2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.33" :db/id #edb/ref 17592186425746}] :answer-field/correct {:db/id #edb/ref 17592186425734} :answer-field/id #uuid "5fa84345-5063-5b45-a9a8-f4e3ac36fb05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425752}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27d2a840-69cf-5325-b960-367fa82827bd" :question/math-academy-id "q-143424" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{8}$ is a sample of size $n=8$ drawn from a population with mean $\\mu =30$ and variance ${\\sigma }^{2}=16,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=16$ and the sample size is $n=8,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{16}{8} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{2}≈1.41.\n$$"} :step/id #uuid "3e79243e-67ec-56e0-9d13-5331e6398a52" :step/next {:db/id #edb/ref 17592186425760}} {:db/id #edb/ref 17592186425758 :step/content {:db/id #edb/ref 17592186162394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8420157b-408c-5305-9a9c-8bd7f4b5f5e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186159567} {:answer/id #uuid "cebb23ff-c448-538e-b197-5f1fefdfaf82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186159568} {:answer/id #uuid "34924901-abbb-58af-a06c-4d9ff03048f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186159569} {:answer/id #uuid "4e216592-6644-5ba7-91d9-81d6f47ad0f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186159570} {:answer/id #uuid "560505f7-e1a5-5ea3-b88a-4c5d794b42fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186159571}] :answer-field/correct {:db/id #edb/ref 17592186159571} :answer-field/id #uuid "c12e791e-1ac8-53c0-861b-6e4d348b043d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186159566}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e399cca8-8b5c-5ff9-b9d5-05eda26fea4d" :question/math-academy-id "q-143498" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ employees is drawn from a population. The population has employees with two different working hours, $38\\,\\text{h/week}$ and $40\\,\\text{h/week},$ distributed in the ratio $3:1.$ Determine the smallest sample size required so that the standard error of the mean is less than  $0.5\\,\\text{h/week}.$" :question/requires-calculator true :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the employees in the population have working hours $38\\,\\text{h/week}$ and $40\\,\\text{h/week},$ and these are distributed in the ratio $3:1.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $3+1=4$ employees only with the following working hours:\n\n$$\n38\\,\\text{h/week},\\,38\\,\\text{h/week},\\,38\\,\\text{h/week},\\,40\\,\\text{h/week}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{4}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{4}(3\\cdot 38+40) \\\\  & =\\frac{1}{4}(114+40) \\\\  & =\\frac{154}{4} \\\\  & =38.5\\,\\text{h/week},\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{4}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{4}(3\\cdot {38}^{2}+{40}^{2})-{38.5}^{2} \\\\  & =\\frac{1}{4}(5\\,932)-1\\,482.25 \\\\  & =1\\,483-1\\,482.25 \\\\  & =0.75\\,{(\\text{h/week})}^{2}.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.75},$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{0.75}{n}}.\n$$\n\nWe require that the standard error is less than $0.5\\,\\text{h/week}.$ Therefore\n\n$$\n\\begin{aligned}\\sqrt{\\frac{0.75}{n}} & <0.5 \\\\ \\sqrt{n} & >\\frac{\\sqrt{0.75}}{0.5} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{{0.5}^{2}}} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.75}{0.25}} \\\\ \\sqrt{n} & >\\sqrt{3} \\\\ n & >3.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=4.$"} :step/id #uuid "a723e053-b0fa-5616-b5a2-e66027d73c57"} {:db/id #edb/ref 17592186425759 :step/content {:db/id #edb/ref 17592186425754 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2ebf1d-6b21-517e-8473-6b5520ced24c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.17" :db/id #edb/ref 17592186425730} {:answer/id #uuid "25a99cc8-8701-579f-b7ef-cb9e7b7f1e7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.22" :db/id #edb/ref 17592186425736} {:answer/id #uuid "55e8daa5-4432-5f7f-b7b9-25ac21b5f238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.50" :db/id #edb/ref 17592186425738} {:answer/id #uuid "785ab3f2-459a-5180-8933-34aa9440618c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.05" :db/id #edb/ref 17592186425740} {:answer/id #uuid "92d71196-a3a0-5ab1-b5f5-5721df71e75d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.71" :db/id #edb/ref 17592186425744}] :answer-field/correct {:db/id #edb/ref 17592186425736} :answer-field/id #uuid "5943d631-1c0b-56a0-a90d-e9d31d030f54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425751}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "748a2779-e90d-59a2-9916-b0ad2a8182a7" :question/math-academy-id "q-143423" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{20}$ is a sample of size $n=20$ drawn from a population with mean $\\mu =6$ and variance ${\\sigma }^{2}=1,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=1$ and the sample size is $n=20,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{1}{20} \\\\  & =0.05.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.05}≈0.22.\n$$"} :step/id #uuid "c77ffddd-aed2-56b6-b329-53374af11408" :step/next {:db/id #edb/ref 17592186425757}} {:db/id #edb/ref 17592186425760 :step/content {:db/id #edb/ref 17592186425755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7b64bf-b6ca-57e9-aaa1-181aed3d622b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "197" :db/id #edb/ref 17592186425731} {:answer/id #uuid "160f3d12-5eab-5995-9f63-e81fe88512ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "241" :db/id #edb/ref 17592186425733} {:answer/id #uuid "78a69e66-0db0-56b0-9e49-ac78e00b8276" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "441" :db/id #edb/ref 17592186425741} {:answer/id #uuid "8e2a8088-2557-53ce-b8f2-d4dcab799771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "194" :db/id #edb/ref 17592186425743} {:answer/id #uuid "ae7b1ee7-ec01-58b0-9c87-f819883b152a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,401" :db/id #edb/ref 17592186425745}] :answer-field/correct {:db/id #edb/ref 17592186425745} :answer-field/id #uuid "0e022f4b-ff74-5796-8a0f-0137d56c7a63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186425750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d1b6912a-93b9-571b-8ea5-2d8ab50d8a7a" :question/math-academy-id "q-143486" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{n}$ of $n$ bushes is drawn from a population. The population has bushes of two different heights, $4\\,\\text{ft}$ and $5\\,\\text{ft},$ distributed in the ratio $3:2.$ Determine the smallest sample size required so that the standard error of the mean is less than $0.01\\,\\text{ft}.$" :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nWe're told that the bushes in the population have heights $4\\,\\text{ft}$ and $5\\,\\text{ft},$ and these are distributed in the ratio $3:2.$ Therefore, to compute the population's mean and variance, we can consider a population consisting of $3+2=5$ bushes only with the following heights:\n\n$$\n4\\,\\text{ft},\\,4\\,\\text{ft},\\,4\\,\\text{ft},\\,5\\,\\text{ft},\\,5\\,\\text{ft}.\n$$\n\nTherefore, the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\frac{1}{5}{\\sum }_{i}{x}_{i} \\\\  & =\\frac{1}{5}(3\\cdot 4+2\\cdot 5) \\\\  & =\\frac{1}{5}(12+10) \\\\  & =\\frac{22}{5} \\\\  & =4.4\\,\\text{ft},\\end{aligned}\n$$\n\nand the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{5}{\\sum }_{i}{x}_{i}^{2}-{\\mu }^{2} \\\\  & =\\frac{1}{5}(3\\cdot {4}^{2}+2\\cdot {5}^{2})-{4.4}^{2} \\\\  & =\\frac{1}{5}(98)-19.36 \\\\  & =19.6-19.36 \\\\  & =0.24\\,{\\text{ft}}^{2}.\\end{aligned}\n$$\n\nThus, the population standard deviation is $\\sigma =\\sqrt{0.24},$ and we have that \n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\frac{0.24}{n}}.\n$$\n\nWe require that the standard error is less than $0.01\\,\\text{ft}.$ Therefore\n\n$$\n\\begin{aligned}\\sqrt{\\frac{0.24}{n}} & <0.01 \\\\ \\sqrt{n} & >\\frac{\\sqrt{0.24}}{0.01} \\\\ \\sqrt{n} & >\\sqrt{\\frac{0.24}{{0.01}^{2}}} \\\\ \\sqrt{n} & >\\sqrt{2\\,400} \\\\ n & >2\\,400.\\end{aligned}\n$$\n\nTherefore, the smallest sample size is $n=2\\,401.$"} :step/id #uuid "fe9fb3ff-fe13-546b-ad08-eeb0688c4db2" :step/next {:db/id #edb/ref 17592186425758}}] :activity/title "Variance of Sample Means" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186425729}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186447173} :activity/id #uuid "2f3ba771-5853-531e-b5df-7ce8360fb615" :activity/scope {:db/id #edb/ref 17592186049674 :topic/id #uuid "09e82368-7656-5709-b72f-b4db605d6406" :topic/math-academy-id 3013} :activity/steps [{:db/id #edb/ref 17592186447169 :step/content {:db/id 