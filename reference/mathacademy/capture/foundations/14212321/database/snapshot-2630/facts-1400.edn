5417] [17592186278139 #edb/ref 1075 #edb/ref 17592186277423 #edb/ref 17592186045417] [17592186278139 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278139 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278139 #edb/ref 1078 #edb/ref 17592186277394 #edb/ref 17592186045417] [17592186278139 #edb/ref 1079 #uuid "ebadb5d8-fe72-566c-b39f-5c8e9dc439a5" #edb/ref 17592186045417] [17592186278465 #edb/ref 1068 #edb/ref 17592186278088 #edb/ref 17592186045417] [17592186278465 #edb/ref 1069 "q-161291" #edb/ref 17592186045417] [17592186278465 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186278465 #edb/ref 1071 "![](images/97/9795c04bf6d4bfa407a7b9176cd5c4b97b3d89bfcc6fff17d1d78190047b3a54.png)\n\nEvaluate the surface integral \n\n$$\n{∬}_{S}6y\\,\\text{d}S,\n$$\n\nwhere $S$ is defined by $z=x+y$ and whose domain is the upper half-circle of radius $1$ centered at $O,$ as shown above." #edb/ref 17592186045417] [17592186278465 #edb/ref 1072 #uuid "5610a24a-7851-5e97-8ed8-8bbb2532b7e3" #edb/ref 17592186045417] [17592186278465 #edb/ref 1074 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(x+y)=1,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(x+y)=1.\n$$\n\nTherefore, the surface integral can be expressed as follows:\n\n$$\n\\begin{aligned}{∬}_{S}6y\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}6y\\cdot \\sqrt{1+{1}^{2}+(1)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}6y\\cdot \\sqrt{3}\\,\\text{d}A \\\\  & =\\sqrt{3}{∬}_{D}\\,6y\\,\\text{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta ),$ our domain can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}\\sqrt{3}{∬}_{D}\\,6y\\,\\text{d}A & =\\sqrt{3}{∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta  \\\\  & =\\sqrt{3}{∬}_{Δ}6r\\operatorname{sin}⁡\\theta \\cdot r\\cdot \\text{d}r\\text{d}\\theta  \\\\  & =6\\sqrt{3}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta {\\int }_{0}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =6\\sqrt{3}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta {[\\frac{{r}^{3}}{3}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{3}{\\int }_{0}^{\\pi }\\frac{1}{3}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2\\sqrt{3}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2\\sqrt{3}[-\\operatorname{cos}⁡\\theta ]_{0}^{\\pi } \\\\  & =2\\sqrt{3}(1+1) \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278586 #edb/ref 1080 "18\\,\\text{kg}\\cdot {\\text{m}}^{2}" #edb/ref 17592186045417] [17592186278586 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278586 #edb/ref 1083 #uuid "00586df5-9953-5e7a-a58f-2329aa16a468" #edb/ref 17592186045417] [17592186278738 #edb/ref 1080 "23" #edb/ref 17592186045417] [17592186278738 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278738 #edb/ref 1083 #uuid "104b5f45-a5a5-53b8-81f3-1afa7e730667" #edb/ref 17592186045417] [17592186278798 #edb/ref 1080 "\\frac{7\\pi }{6}" #edb/ref 17592186045417] [17592186278798 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278798 #edb/ref 1083 #uuid "17226919-ce93-5049-994f-31d7cd5c10fb" #edb/ref 17592186045417] [17592186278854 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186278854 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278854 #edb/ref 108