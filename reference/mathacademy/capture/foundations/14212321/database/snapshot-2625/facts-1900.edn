}_{2}\\end{bmatrix}$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}=-\\frac{6}{\\sqrt{10}}-\\frac{5}{\\sqrt{5}}=-\\frac{11}{\\sqrt{5}} \\\\ {x}_{2} & =\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}\\cdot \\begin{bmatrix}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}=-\\frac{3}{\\sqrt{5}}+\\frac{10}{\\sqrt{10}}=\\frac{7}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=\\begin{bmatrix}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186351746 #edb/ref 1080 "2\\sqrt[4]{e}" #edb/ref 17592186045417] [17592186351746 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351746 #edb/ref 1083 #uuid "148c3c70-3db7-55f7-8111-88c0343f9bd4" #edb/ref 17592186045417] [17592186351960 #edb/ref 1080 "2{e}^{-2}" #edb/ref 17592186045417] [17592186351960 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351960 #edb/ref 1083 #uuid "2b5b8adf-77e5-5a78-94b3-8706a2ac286c" #edb/ref 17592186045417] [17592186352805 #edb/ref 1080 "${f}_{min}=-7$ and ${f}_{max}=-1$" #edb/ref 17592186045417] [17592186352805 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186352805 #edb/ref 1083 #uuid "8dfe7cc3-7e1e-531b-9679-17d6282f66cc" #edb/ref 17592186045417] [17592186352855 #edb/ref 1080 "${f}_{min}=-2$ and ${f}_{max}=7$" #edb/ref 17592186045417] [17592186352855 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186352855 #edb/ref 1083 #uuid "9480fe29-ef08-57e8-a109-77655e61781e" #edb/ref 17592186045417] [17592186352863 #edb/ref 1080 "${f}_{min}=-2$ and ${f}_{max}=-1$" #edb/ref 17592186045417] [17592186352863 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186352863 #edb/ref 1083 #uuid "959a80c9-8d6f-5ebf-854d-92e4451dd1a9" #edb/ref 1759