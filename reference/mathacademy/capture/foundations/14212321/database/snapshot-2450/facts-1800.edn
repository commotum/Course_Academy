{v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 1 \\\\ 0\\end{bmatrix}-\\frac{8}{8}\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 3.** We find the vector ${v}_{3}$ orthogonal to $\\text{Span}\\{{v}_{1},{v}_{2}\\}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2} \\\\  & =\\begin{bmatrix}4 \\\\ 8 \\\\ -1\\end{bmatrix}-\\frac{6}{8}\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}-\\frac{18}{9}\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 \\\\ 8 \\\\ -1\\end{bmatrix}-\\frac{3}{4}\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}-2\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\  & =\\frac{1}{4}(4\\begin{bmatrix}4 \\\\ 8 \\\\ -1\\end{bmatrix}-3\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}-8\\begin{bmatrix}2 \\\\ 1 \\\\ -2\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-\\frac{3}{2} \\\\ 6 \\\\ \\frac{3}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $a=-\\frac{3}{2},$ $c=\\frac{3}{2},$ and $\\frac{a}{c}=\\frac{(-\\frac{3}{2})}{(\\frac{3}{2})}=-1.$" #edb/ref 17592186045443] [17592186366133 #edb/ref 1075 #edb/ref 17592186366134 #edb/ref 17592186045417] [17592186366133 #edb/ref 1075 #edb/ref 17592186366135 #edb/ref 17592186045417] [17592186366133 #edb/ref 1075 #edb/ref 17592186366136 #edb/ref 17592186045417] [17592186366133 #edb/ref 1075 #edb/ref 17592186366137 #edb/ref 17592186045417] [17592186366133 #edb/ref 1075 #edb/ref 17592186366138 #edb/ref 17592186045417] [17592186366133 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186366133 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186366133 #edb/ref 1078 #edb/ref 17592186366138 #edb/ref 17592186045417] [17592186366133 #edb/ref 1079 #uuid "22bd81a8-fc97-5b1d-aab5-22729b7310