tegrals Over Line Segments" #edb/ref 17592186045417] [17592186179737 #edb/ref 1041 #edb/ref 17592186179599 #edb/ref 17592186045417] [17592186179737 #edb/ref 1042 #uuid "0983e1e6-46a9-53de-83f5-a28d5b1eee47" #edb/ref 17592186045417] [17592186179864 #edb/ref 1043 #edb/ref 17592186180488 #edb/ref 17592186045417] [17592186179864 #edb/ref 1043 #edb/ref 17592186180489 #edb/ref 17592186045417] [17592186179864 #edb/ref 1043 #edb/ref 17592186180490 #edb/ref 17592186045417] [17592186179864 #edb/ref 1043 #edb/ref 17592186180491 #edb/ref 17592186045417] [17592186179864 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179864 #edb/ref 1045 "Line Integrals of Vector-Valued Functions Over General Curves" #edb/ref 17592186045417] [17592186179864 #edb/ref 1046 #edb/ref 17592186180488 #edb/ref 17592186045417] [17592186179864 #edb/ref 1049 #edb/ref 17592186048916 #edb/ref 17592186045417] [17592186179864 #edb/ref 1050 1080.0 #edb/ref 17592186045417] [17592186179864 #edb/ref 1053 #uuid "081747a0-57ee-5aec-8eb5-e43238a80d3d" #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180341 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180342 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180343 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180344 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180345 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180346 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180347 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180348 #edb/ref 17592186045417] [17592186179866 #edb/ref 1043 #edb/ref 17592186180349 #edb/ref 17592186045417] [17592186179866 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179866 #edb/ref 1045 "Flux in Two-Dimensional Vector Fields" #edb/ref 17592186045417] [17592186179866 #edb/ref 1046 #edb/ref 17592186180341 #edb/ref 17592186045417] [17592186179866 #edb/ref 1049 #edb/ref 17592186048376 #edb/ref 17592186045417] [17592186179866 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186179866 #edb/ref 1053 #uuid "90074413-5fe3-5632-8eb0-3e0dc053df00" #edb/ref 17592186045417] [17592186180341 #edb/ref 1058 #edb/ref 17592186180342 #edb/ref 17592186045417] [17592186180341 #edb/ref 1061 184955 #edb/ref 17592186045417] [17592186180341 #edb/ref 1062 #uuid "1e80fc64-e097-5e8d-a35c-056416216619" #edb/ref 17592186045417] [17592186180341 #edb/ref 1063 #edb/ref 17592186180787 #edb/ref 17592186045417] [17592186180342 #edb/ref 1058 #edb/ref 17592186180343 #edb/ref 17592186045417] [17592186180342 #edb/ref 1061 184956 #edb/ref 17592186045417] [17592186180342 #edb/ref 1062 #uuid "9dac0bb5-3a03-56c0-a614-dc9f045cb3e3" #edb/ref 17592186045417] [17592186180342 #edb/ref 1063 #edb/ref 17592186180788 #edb/ref 17592186045417] [17592186180343 #edb/ref 1058 #edb/ref 17592186180344 #edb/ref 17592186045417] [17592186180343 #edb/ref 1061 184957 #edb/ref 17592186045417] [17592186180343 #edb/ref 1062 #uuid "a000a04f-fdd8-5b25-9b23-e59a14a3592d" #edb/ref 17592186045417] [17592186180343 #edb/ref 1063 #edb/ref 17592186180789 #edb/ref 17592186045417] [17592186180344 #edb/ref 1058 #edb/ref 17592186180345 #edb/ref 17592186045417] [17592186180344 #edb/ref 1061 184958 #edb/ref 17592186045417] [17592186180344 #edb/ref 1062 #uuid "4f8760a0-8c8e-5ec6-9492-0ecc32789da6" #edb/ref 17592186045417] [17592186180344 #edb/ref 1063 #edb/ref 17592186179644 #edb/ref 17592186045417] [17592186180345 #edb/ref 1058 #edb/ref 17592186180346 #edb/ref 17592186045417] [17592186180345 #edb/ref 1061 184961 #edb/ref 17592186045417] [17592186180345 #edb/ref 1062 #uuid "ab771459-c3a6-5f4b-9e75-cfa3f13b9add" #edb/ref 17592186045417] [17592186180345 #edb/ref 1063 #edb/ref 17592186180790 #edb/ref 17592186045417] [17592186180346 #edb/ref 1058 #edb/ref 17592186180347 #edb/ref 17592186045417] [17592186180346 #edb/ref 1061 184962 #edb/ref 17592186045417] [17592186180346 #edb/ref 1062 #uuid "2c288a88-997c-5ef1-98ff-24092e7506f9" #edb/ref 17592186045417] [17592186180346 #edb/ref 1063 #edb/ref 17592186179645 #edb/ref 17592186045417] [17592186180347 #edb/ref 1058 #edb/ref 17592186180348 #edb/ref 17592186045417] [17592186180347 #edb/ref 1061 184965 #edb/ref 17592186045417] [17592186180347 #edb/ref 1062 #uuid "5c82115b-5b07-5765-b4a2-64382478cffb" #edb/ref 17592186045417] [17592186180347 #edb/ref 1063 #edb/ref 17592186180791 #edb/ref 17592186045417] [17592186180348 #edb/ref 1058 #edb/ref 17592186180349 #edb/ref 17592186045417] [17592186180348 #edb/ref 1061 184966 #edb/ref 17592186045417] [17592186180348 #edb/ref 1062 #uuid "3b16b4e1-26b3-5b3f-a7bb-3a7ea8b7f740" #edb/ref 17592186045417] [17592186180348 #edb/ref 1063 #edb/ref 17592186179646 #edb/ref 17592186045417] [17592186180349 #edb/ref 1061 184969 #edb/ref 17592186045417] [17592186180349 #edb/ref 1062 #uuid "ff88b373-d7aa-57f4-97d5-9266bed9219b" #edb/ref 17592186045417] [17592186180349 #edb/ref 1063 #edb/ref 17592186179647 #edb/ref 17592186045417] [17592186180488 #edb/ref 1058 #edb/ref 17592186180491 #edb/ref 17592186045417] [17592186180488 #edb/ref 1061 35690 #edb/ref 17592186045417] [17592186180488 #edb/ref 1062 #uuid "7b85eebf-c70c-58a0-9476-5bcb73727ad3" #edb/ref 17592186045417] [17592186180488 #edb/ref 1063 #edb/ref 17592186180718 #edb/ref 17592186045417] [17592186180489 #edb/ref 1061 35691 #edb/ref 17592186045417] [17592186180489 #edb/ref 1062 #uuid "c535e9dc-5505-59aa-ae55-5a85fcb5135c" #edb/ref 17592186045417] [17592186180489 #edb/ref 1063 #edb/ref 17592186179735 #edb/ref 17592186045417] [17592186180490 #edb/ref 1058 #edb/ref 17592186180489 #edb/ref 17592186045417] [17592186180490 #edb/ref 1061 35692 #edb/ref 17592186045417] [17592186180490 #edb/ref 1062 #uuid "922dce6d-b939-516c-95ed-a47bcba850e1" #edb/ref 17592186045417] [17592186180490 #edb/ref 1063 #edb/ref 17592186179736 #edb/ref 17592186045417] [17592186180491 #edb/ref 1058 #edb/ref 17592186180490 #edb/ref 17592186045417] [17592186180491 #edb/ref 1061 35693 #edb/ref 17592186045417] [17592186180491 #edb/ref 1062 #uuid "2bd70267-cee5-535e-880d-6ade2c843224" #edb/ref 17592186045417] [17592186180491 #edb/ref 1063 #edb/ref 17592186179737 #edb/ref 17592186045417] [17592186180718 #edb/ref 1064 "The line integral of a vector-valued function $\\mathbf F$ along a piecewise smooth curve $C$ is denoted\n\n$$\n\\int\\limits_C \\mathbf F \\cdot \\textrm d\\mathbf r .\n$$\n\nThis integral represents the total work done by $\\mathbf F$ in moving a particle from an initial point $A$ to a terminal point $B$ along the curve.\n\nIf the curve can be parameterized by the function $\\mathbf r(t)$ for $t\\in [a,b],$ then we can calculate the line integral using the following formula:\n\n$$\n\\int\\limits_C \\mathbf F \\cdot \\textrm d\\mathbf r= \\int_a^b \\mathbf F(\\mathbf r(t)) \\cdot \\mathbf r'(t)\\,\\textrm dt\n$$\n\nOften, the trickiest part is finding a parameterization for $C.$ In this lesson, we'll consider several different cases" #edb/ref 17592186045417] [17592186180718 #edb/ref 1065 5823 #edb/ref 17592186045417] [17592186180718 #edb/ref 1066 #uuid "ec010a30-571c-5ad5-b30a-c18ffdd997e1" #edb/ref 17592186045417] [17592186180718 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180787 #edb/ref 1064 "Let $\\mathbf F$ be a vector field on $\\mathbb R^2$ and $C$ be a *closed* curve in the $xy$-plane. Imagine that $\\mathbf F$ represents the velocity field of a stream of flowing water, and $C$ is a curve that allows water to flow through it (like a fishing net). \n\nThe **flux of $\\mathbf F$ across $\\boldsymbol C$** is a scalar number that tells us how much water is escaping the region bounded by $C.$ \n\nWe have three possible scenarios: \n\n- If more water flows out through $C$ than in through $C$ (i.e., there is a net flow *out* through $C$), the flux is *positive*.\n\n![](images/6f/6ff4d006d3fbf4a434f35a13c8591fc166ff6c74adf2b7969752b7541e486df2.png)\n\n- If more water flows in through $C$ than out through $C$ (i.e., there is a net flow *in* through $C$), the flux is *negative*.\n\n![](images/38/3812148e855a84e3233316acc8bbf59bd7cd802a874c9e4807c6efd7ca6754cf.png)\n\n- If the net flow through $C$ is zero, the flux equals zero.\n\nThe following vector field has zero flux across $C$ because the amount of water flowing in through $C$ equals the amount of water flowing out through $C.$\n\n![](images/56/56aef4f217e9981755826745a97e8389d86b49518ffd7d3ebc75e5ee2dc28f8b.png)\n\nThe following two vector fields also have a zero flux across $C$ because the water flow is tangential to $C$ at every point along $C.$\n\n![](images/63/637677324152af3d428e405c89025f35dbe5d71e2e8f0a0797ef3aca30bae7e1.png)" #edb/ref 17592186045417] [17592186180787 #edb/ref 1065 9521 #edb/ref 17592186045417] [17592186180787 #edb/ref 1066 #uuid "ecd8591f-8e5b-50b2-91a1-4f15bd97b2c2" #edb/ref 17592186045417] [17592186180787 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180788 #edb/ref 1064 "If $\\mathbf{F}(x,y)$ is a vector field on $\\mathbb{R}^2$ and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by the line integral\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ The symbol $\\oint\\limits$ means integration over the closed curve.\n\nIt's helpful to spend some time understanding where this definition comes from, so let's derive it using the closed curve $C$ below.\n\n![](images/6d/6dfe8a071798c93f19507808596b7d32af90367b2666643d092a7c50afe5e929.png)\n\nFirst, we pick a point $P$ on $C.$ At this point, we draw the vector field $\\mathbf F$ and the outward-pointing normal vector $\\mathbf n$ to $C.$\n\n![](images/49/498e1afbaac8bc8297213eae09cc8bf8742b29f45dda1dfafff868c67ebb9de9.png)\n\nWe wish to calculate the flow of $\\mathbf F$ through $C$ at $P.$ Now, $\\mathbf F$ is made up of two components:\n\n- a component parallel to $\\mathbf n,$ which contributes to the flow of $\\mathbf F$ through $C,$ and\n\n- a component perpendicular to $\\mathbf n,$ which does *not* contribute to the flow of $\\mathbf F$ through $C.$\n\nWe're only interested in the contribution made to the flow of $\\mathbf F$ through $C.$ This is given by the scalar projection of $\\mathbf F$ in the direction of $\\mathbf n.$\n\n![](images/ac/ac3aae49f372908f2f9aeb53e3fc98bff117846fca05a8c696009e443390811c.png)\n\nTherefore, the flow of $\\mathbf F$ through $C$ at $P$ is given by\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}F & =\\frac{F\\cdot n}{||n||}=F\\cdot n.\\end{aligned}\n$$\n\nThe expression above represents the flow of $\\mathbf F$ through $C$ at a single point only. Therefore, to calculate the total net flow of $\\mathbf F$ through $C,$ we sum (integrate) this expression over the entire curve. This gives\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s.\n$$" #edb/ref 17592186045417] [17592186180788 #edb/ref 1065 9522 #edb/ref 17592186045417] [17592186180788 #edb/ref 1066 #uuid "a328d4d8-bfe8-50eb-8bbd-281b3bb07afe" #edb/ref 17592186045417] [17592186180788 #edb/ref 1067 "Constructing an Integral Formula for the Flux" #edb/ref 17592186045417] [17592186180789 #edb/ref 1064 "Consider the circle $S$ and vector field $\\mathbf F$ below. Let $C$ be any path where $S$ is traversed once in the counterclockwise direction. \n\n![](images/e6/e679efaa2612d45bbfe8b918de7148853b64eaf530af34a525ef1735e0946b09.png)\n\nBy drawing an outward-pointing unit normal vector, it's clear that there is a net flow *out* through $C.$ \n\n![](images/fb/fbcd6fd0fadcc955212a145de9edb4654ddb92ddebb8ba31eb775cff676efeeb.png)\n\nTherefore, the flux of $\\mathbf F$ across $C$ is positive, and we have\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s > 0.\n$$\n\nWhen measuring flux through a closed curve, the curve's orientation does not matter because the outward-pointing unit normal vector is the same in either case. \n\n![](images/a3/a3d398d382e6bc94ddde77e650d50a6b5ec050083f89f64104f6f2fd172a9239.png)\n\nSo, the flux of $\\mathbf F$ across $-C$ is also positive, and we have\n\n$$\n\\oint\\limits_{-C} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s > 0.\n$$" #edb/ref 17592186045417] [17592186180789 #edb/ref 1065 9523 #edb/ref 17592186045417] [17592186180789 #edb/ref 1066 #uuid "36b855d8-9994-5c22-bbc4-e28065875f84" #edb/ref 17592186045417] [17592186180789 #edb/ref 1067 "Orientation-Independence" #edb/ref 17592186045417] [17592186180790 #edb/ref 1064 "To calculate the flux of a vector field over a smooth, closed curve, we can use the formula\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s.\n$$\n\nIf $C=C_1\\cup C_2 \\cup \\cdots \\cup C_n$ is piecewise smooth, we have to calculate the flux of $\\mathbf F$ over each smooth face. That is,\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s  =  \\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s + \\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n+ \\cdots +\n\\int\\limits_{C_n} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C$ on $C_i.$\n\nAs an example, let's consider the vector field $\\mathbf F(x,y) = xy\\,\\mathbf i + (y-x)^3\\,\\mathbf j$ and the rectangle $C$ shown below. \n\n![](images/5c/5cbd62feddcce7a676a76117de09154da21abdd8b039c0e45a7a0e7d5fb00e9c.png)\n\n \n\nTo calculate the flux of $\\mathbf F$ over $C,$ we sum the fluxes of $\\mathbf F$ over each side:\n\n$$\n\\oint\\limits_{C} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n=\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n+\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n+\n\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n+\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n$$\n\nTo demonstrate how to compute these integrals, let's construct the flux integral across the side $C_4,$ given by\n\n$$\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s.\n$$\n\nThe side $C_4$ and its outward-pointing unit normal are shown below.\n\n![](images/06/06fd5a2ecbd709e8e835f2a57ef3ada772526366d51e5e16474d9b8635500e8e.png)\n\nSince this side is perpendicular to the $y$-axis and we require an outward-pointing unit normal vector, we must have \n\n$$\n\\mathbf n = -\\mathbf j.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{4}}F\\cdot n\\,\\text{d}s & ={\\int }_{{C}_{4}}(xy\\,i+(y-x)^{3}\\,j)\\cdot (-j)\\,\\text{d}s \\\\  & ={\\int }_{{C}_{4}}(xy\\,i)\\cdot (-j)+((y-x)^{3}\\,j))\\cdot (-j)\\,\\text{d}s \\\\  & ={\\int }_{{C}_{4}}0-(y-x)^{3}\\,\\text{d}s \\\\  & ={\\int }_{{C}_{4}}(x-y)^{3}\\,\\text{d}s.\\end{aligned}\n$$\n\nFollowing a similar procedure for the other sides, we can construct the full expression for the flux of $\\mathbf F$ over $C.$" #edb/ref 17592186045417] [17592186180790 #edb/ref 1065 9524 #edb/ref 17592186045417] [17592186180790 #edb/ref 1066 #uuid "472c362c-27a5-5041-90c3-4533c63b736d" #edb/ref 17592186045417] [17592186180790 #edb/ref 1067 "Calculating Flux" #edb/ref 17592186045417] [17592186180791 #edb/ref 1064 "Calculating the flux of a vector field across a rectangle or square requires computing four flux integrals. However, we can often simplify our calculations if the vector field displays symmetry.\n\nTo demonstrate, consider the vector field $\\mathbf F = -5\\,\\mathbf i$ and a square $C$ with side length $6$ centered at $O,$ as shown below. Let's calculate the flux of $\\mathbf F$ across $C.$\n\n![](images/8e/8e1767b9bea45e742df4953f0ec50b2d43c9622994035342307dc2be6abba8de.png)\n\nIf $\\mathbf{F}$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n=\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n+\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n}_2 \\: \\textrm{d}s\n+\n\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s\n+\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n}_4 \\: \\textrm{d}s,\n$$\n\nwhere the sides $C_i$ and unit vectors $\\mathbf n_i$ are shown below.\n\n![](images/65/65a8c37c64580f7d1f41f32722f20dfee2b8fd98333920a0feae781ea8d9541e.png)\n\nSince the vector field $\\mathbf F = -5\\,\\mathbf i$ is parallel to $C_2$ and $C_4,$ there is zero net flow through these two sides. Therefore,\n\n$$\n\\int\\limits_{C_2} \\mathbf F \\cdot \\mathbf{n}_2 \\: \\textrm{d}s\n=\n\\int\\limits_{C_4} \\mathbf F \\cdot \\mathbf{n}_4 \\: \\textrm{d}s = 0.\n$$\n\nThis is easy to verify, since, \n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}-5\\,i\\cdot j\\,\\text{d}s \\\\  & ={\\int }_{{C}_{2}}0\\,\\text{d}s \\\\  & =0\\end{aligned}\n$$\n\nand similarly for the integral along $C_4.$ \n\nSo, our expression for the flux reduces to\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s\n=\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n+\n\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s.\n$$\n\nSince the vector field is uniform, the net inflow through $C_1$ will cancel with the net outflow through $C_3.$ That is\n\n$$\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n=\n-\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s\n\\quad\\Longrightarrow\\quad\n\\int\\limits_{C_1} \\mathbf F \\cdot \\mathbf{n}_1 \\: \\textrm{d}s\n+\\int\\limits_{C_3} \\mathbf F \\cdot \\mathbf{n}_3 \\: \\textrm{d}s\n=0.\n$$\n\nTherefore, we conclude that\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = 0.\n$$" #edb/ref 17592186045417] [17592186180791 #edb/ref 1065 9525 #edb/ref 17592186045417] [17592186180791 #edb/ref 1066 #uuid "53e768e4-a3bb-5b89-83b9-a97e9ff4a921" #edb/ref 17592186045417] [17592186180791 #edb/ref 1067 "Using  Symmetry to Simplify Flux Calculations" #edb/ref 17592186045417] [17592186183883 #edb/ref 1075 #edb/ref 17592186508445 #edb/ref 17592186045417] [17592186183883 #edb/ref 1075 #edb/ref 17592186508455 #edb/ref 17592186045417] [17592186183883 #edb/ref 1075 #edb/ref 17592186508580 #edb/ref 17592186045417] [17592186183883 #edb/ref 1075 #edb/ref 17592186508761 #edb/ref 17592186045417] [17592186183883 #edb/ref 1075 #edb/ref 17592186508767 #edb/ref 17592186045417] [17592186183883 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186183883 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186183883 #edb/ref 1078 #edb/ref 17592186508445 #edb/ref 17592186045417] [17592186183883 #edb/ref 1079 #uuid "32eedbf9-e833-5743-ba35-1e838f8db9de" #edb/ref 17592186045417] [17592186184197 #edb/ref 1037 #edb/ref 17592186050205 #edb/ref 17592186045417] [17592186184197 #edb/ref 1037 #edb/ref 17592186050407 #edb/ref 17592186045417] [17592186184197 #edb/ref 1037 #edb/ref 17592186050727 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186184875 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186184880 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186368899 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186416481 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186416485 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186416486 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186493969 #edb/ref 17592186045417] [17592186184197 #edb/ref 1038 #edb/ref 17592186496298 #edb/ref 17592186045417] [17592186184197 #edb/ref 1039 "Identifying True Statements Regarding the Singular Values 