TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2016\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2016\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">‖</mo><mo>=</mo><mn>1</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> is equal to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1291\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2.</mn></math></mjx-assistive-mml></mjx-container> Which of the following is a vector <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1292\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow></math></mjx-assistive-mml></mjx-container> at which the maximum is attained? </p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Wed, Oct 14th @ 1:08 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 5:09</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
