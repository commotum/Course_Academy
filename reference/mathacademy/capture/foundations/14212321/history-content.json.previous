></msub><mo>−</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div></mjx-mrow><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"right left\" columnspacing=\"0em\" displaystyle=\"true\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">L</mi></mrow><mo fence=\"false\" stretchy=\"false\">{</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></msup><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">∞</mi></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>s</mi><mi>t</mi></mrow></msup><mo>⋅</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></msup><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>0</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">∞</mi></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mi>t</mi></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>1</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>B</mi><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mtext>for</mtext><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>s</mi><mo>&gt;</mo><msub><mi>s</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Wed, Oct 14th @ 11:33 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 5:31</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
    },
    {
      "dom_id": "question-343061",
      "name": null,
      "problem": "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+3y=\\operatorname{sin}⁡2t+\\operatorname{cos}⁡2t,\\,y(0)=1\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms. You may make use of the following results:\n\n$$\nL\\{\\operatorname{sin}⁡\\omega t\\}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L\\{\\operatorname{cos}⁡\\omega t\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$\n\nLet $Y(s)=L\\{y(t)\\}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$",
      "worked_solution": "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL\\{{y}^{′}\\}+3L\\{y\\}=L\\{\\operatorname{sin}⁡2t\\}+L\\{\\operatorname{cos}⁡2t\\}.\n$$\n\nUsing the formula for the transform of a derivative $L\\{{y}^{′}\\}=sY(s)-y(0)$ and the standard trigonometric transforms\n\n$$\nL\\{\\operatorname{sin}⁡2t\\}=\\frac{2}{{s}^{2}+4},\\,L\\{\\operatorname{cos}⁡2t\\}=\\frac{s}{{s}^{2}+4},\n$$\n\nwe substitute the known values. Note that $y(0)=1:$\n\n$$\n\\begin{aligned}(sY(s)-1)+3Y(s) & =\\frac{2}{{s}^{2}+4}+\\frac{s}{{s}^{2}+4} \\\\ (s+3)Y(s)-1 & =\\frac{s+2}{{s}^{2}+4}\\end{aligned}\n$$\n\nWe rearrange to solve for $Y(s).$ First, add $1$ to the right-hand side and find a common denominator:\n\n$$\n\\begin{aligned}(s+3)Y(s) & =1+\\frac{s+2}{{s}^{2}+4} \\\\ (s+3)Y(s) & =\\frac{{s}^{2}+4}{{s}^{2}+4}+\\frac{s+2}{{s}^{2}+4} \\\\ (s+3)Y(s) & =\\frac{{s}^{2}+s+6}{{s}^{2}+4}\\end{aligned}\n$$\n\nDividing by $(s+3),$ we obtain\n\n$$\nY(s)=\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}.\n$$\n\nNext, we perform a partial fraction decomposition. Since the denominator has a linear factor $(s+3)$ and an irreducible quadratic factor $({s}^{2}+4),$ we write\n\n$$\n\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}=\\frac{A}{s+3}+\\frac{Bs+C}{{s}^{2}+4}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\n{s}^{2}+s+6=A({s}^{2}+4)+(Bs+C)(s+3)\n$$\n\n- Setting $s=-3,$ we have\n \n\n$$\n(-3)^{2}+(-3)+6=A((-3)^{2}+4)+0\\,⟹\\,12=13A\\,⟹\\,A=\\frac{12}{13}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n  \n\n$$\n1=A+B\\,⟹\\,1=\\frac{12}{13}+B\\,⟹\\,B=\\frac{1}{13}.\n$$\n\n- Comparing the constant terms, we have\n \n\n$$\n6=4A+3C\\,⟹\\,6=4(\\frac{12}{13})+3C\\,⟹\\,C=\\frac{10}{13}.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{(\\frac{12}{13})}{13(s+3)}+\\frac{(\\frac{1}{13}s+\\frac{10}{13})}{{s}^{2}+4}=\\frac{12}{13(s+3)}+\\frac{s+10}{13({s}^{2}+4)}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}\\{\\frac{1}{s+3}\\} & ={e}^{-3t} \\\\ {L}^{-1}\\{\\frac{s}{{s}^{2}+4}\\} & =\\operatorname{cos}⁡2t \\\\ {L}^{-1}\\{\\frac{2}{{s}^{2}+4}\\} & =\\operatorname{sin}⁡2t\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =\\frac{12}{13}{L}^{-1}\\{\\frac{1}{s+3}\\}+\\frac{1}{13}{L}^{-1}\\{\\frac{s}{{s}^{2}+4}\\}+\\frac{5}{13}{L}^{-1}\\{\\frac{2}{{s}^{2}+4}\\} \\\\ y(t) & =\\frac{12}{13}{e}^{-3t}+\\frac{5}{13}\\operatorname{sin}⁡2t+\\frac{1}{13}\\operatorname{cos}⁡2t.\\end{aligned}\n$$",
      "calculator_instructions": "",
