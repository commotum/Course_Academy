-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mstyle space=\"3\"><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c63\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>12</mn><mn>13</mn></mfrac></mstyle><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mi>t</mi></mrow></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>13</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>13</mn></mfrac></mstyle><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div></mjx-mrow><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>12</mn><mn>13</mn></mfrac></mstyle><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mi>t</mi></mrow></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>13</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>13</mn></mfrac></mstyle><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mo>.</mo></math></mjx-assistive-mml></mjx-container></span></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Wed, Oct 14th @ 11:39 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 5:59</span><span class=\"answerResult\"><span style=\"color: green;\">Full Credit</span></span></div></div>"
    },
    {
      "dom_id": "question-143625",
      "name": null,
      "problem": "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\operatorname{sin}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X<Y\\,|\\,Y=\\frac{\\pi }{3}).$",
      "worked_solution": "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(X<Y\\,|\\,Y=\\frac{\\pi }{3}) & =P(X<\\frac{\\pi }{3}\\,|\\,Y=\\frac{\\pi }{3}) \\\\  & ={\\int }_{0}^{\\pi /3}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{\\pi }{3})\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =[-\\operatorname{cos}⁡x]_{0}^{\\pi /3} \\\\  & =(-\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [],
      "problem_field_keys": [],
      "answer_fields_complete": null,
      "result": "Incorrect",
      "proof_feedback": null,
      "html": "<div id=\"question-143625\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">5.</span><a class=\"questionKP\" href=\"/topics/3022#10100\">Computing a Conditional Probability</a><span class=\"helpButton\" questionid=\"143625\">?</span></div><div class=\"questionText\"><p>Let <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"384\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44B TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi></math></mjx-assistive-mml></mjx-container> and <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"385\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44C TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math></mjx-assistive-mml></mjx-container> be two continuous random variables with the following conditional probability density function:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"386\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.176em; margin-left: -0.06em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44B TEX-I\"></mjx-c></mjx-mi><mjx-mstyle style=\"font-size: 141.4%;\"><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><