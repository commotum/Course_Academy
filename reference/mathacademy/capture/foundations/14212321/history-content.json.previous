jx-c27E8\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.06em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msub space=\"2\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.06em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c27E9\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo fence=\"false\" stretchy=\"false\">⟨</mo><msub><mi>f</mi><mn>2</mn></msub><mo>,</mo><msub><mi>f</mi><mn>3</mn></msub><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>=</mo><mn>0.</mn></math></mjx-assistive-mml></mjx-container></em><p></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Wed, Oct 14th @ 12:30 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:01</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
    },
    {
      "dom_id": "question-105400",
      "name": null,
      "problem": "Let $V=C[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$ \n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,g(t)=15t+3\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}$ equals $15t.$",
      "worked_solution": "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=15t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(15t+3)\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}15{t}^{3}+3{t}^{2}\\,\\text{d}t \\\\  & ={[\\frac{15}{4}{t}^{4}+{t}^{3}]}_{-1}^{1} \\\\  & =(\\frac{15}{4}+1)-(\\frac{15}{4}-1) \\\\  & =2,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}{f}_{2}(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{2}\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t \\\\  & ={\\frac{1}{5}{t}^{5}|}_{-1}^{1} \\\\  & =\\frac{1}{5}-(-\\frac{1}{5}) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{2}{(\\frac{2}{5})}\\cdot {t}^{2}=5{t}^{2}.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =15t+5{t}^{2}.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [],
      "problem_field_keys": [],
      "answer_fields_complete": null,
      "result": "Incorrect",
      "proof_feedback": null,
      "html": "<div id=\"question-105400\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">26.</span><a class=\"questionKP\" href=\"/topics/2126#8730\">Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors</a><span class=\"helpButton\" questionid=\"105400\">?</span></div><div class=\"questionText\"><p>Let <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"999\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D449 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-i\"><mjx-c class=\"mjx-c43 TEX-C\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">C</mi></mrow><mo stretchy=\"false\">[</mo><mo>−</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">]</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> the vector space of continuous functions over <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"1000\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\