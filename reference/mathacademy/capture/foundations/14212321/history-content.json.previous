tached_0\" ctxtmenu_counter=\"1790\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math></mjx-assistive-mml></mjx-container>-axis is a <div class=\"selectList\" id=\"selectList-333213-1\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrame correctSelection\" id=\"selectListFrame-333213-1\" style=\"width: 75px; height: 17px; line-height: 17px;\">unstable</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">unstable</div><div class=\"selectListOption\" style=\"height: 17px;\">stable</div></div></div> line.<p></p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1791\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mstyle><mjx-mspace style=\"width: 2em;\"></mjx-mspace></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container>\nThe equilibrium point (origin) is <div class=\"selectList\" id=\"selectList-333213-2\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrame correctSelection\" id=\"selectListFrame-333213-2\" style=\"width: 192px; height: 17px; line-height: 17px;\">a saddle point</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">a saddle point</div><div class=\"selectListOption\" style=\"height: 17px;\">an unstable node (source)</div><div class=\"selectListOption\" style=\"height: 17px;\">a stable node (sink)</div></div></div>.</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Wed, Oct 14th @ 1:42 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 5:43</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
