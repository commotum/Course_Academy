      "raw_html": "<div class=\"question\" id=\"question-146270\"><div class=\"questionHeader\"><span class=\"questionNumber\">24.</span><a class=\"questionKP\" href=\"/topics/3926#10306\">Calculating a Conditional Variance Using Column Totals</a><span class=\"helpButton\" questionid=\"146270\">?</span></div><div class=\"questionText\"><table align=\"center\" cellpadding=\"10\" rules=\"all\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n<tbody><tr>\n<td style=\"text-align:center\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"933\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi></math></mjx-assistive-mml></mjx-container></td>\n<td bgcolor=\"#D6EAF8\" style=\"text-align:center\" width=\"30\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"934\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44C TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi><mo>=</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></td>\n<td bgcolor=\"#D6EAF8\" style=\"text-align:center\" width=\"30\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"935\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-