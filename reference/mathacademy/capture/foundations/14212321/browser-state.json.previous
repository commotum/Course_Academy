            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-39418-a",
              "type": "math",
              "value": "{\\int }_{0}^{\\pi /4}{\\int }_{0}^{1}{\\int }_{\\operatorname{arctan}⁡x}^{\\pi /4}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z",
