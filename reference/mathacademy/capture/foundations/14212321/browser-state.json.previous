o data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow></msubsup><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msup><mi>u</mi><mn>2</mn></msup><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">|</mo></mrow><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>3</mn><msqrt><mn>3</mn></msqrt><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mn>0</mn><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo>⋅</mo><mn>27</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>81</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
