mjx-texclass=\"OPEN\">(</mo><msup><mn>0</mn><mn>3</mn></msup><mo>⋅</mo><msup><mn>1</mn><mn>3</mn></msup><mo>+</mo><msup><mn>0</mn><mn>2</mn></msup><mo>−</mo><mn>2</mn><mo>⋅</mo><msup><mn>1</mn><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mn>3</mn></msup><mo>+</mo><mn>1</mn><mo>−</mo><mn>2</mn><msup><mi>e</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mn>3</mn></msup><mo>−</mo><mn>2</mn><msup><mi>e</mi><mn>2</mn></msup><mo>+</mo><mn>3.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
