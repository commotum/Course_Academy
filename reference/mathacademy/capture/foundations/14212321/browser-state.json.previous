      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-40-c0591719188d1783d67a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-40-c0591719188d1783d67a.png",
      "source_url": "https://mathacademy.com/tasks/14212321/diagnostics/453778",
      "captured_at": 1792008171.433644,
