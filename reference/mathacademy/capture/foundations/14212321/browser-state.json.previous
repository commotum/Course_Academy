      "extraction_error_parts": {},
      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-36-d5510b479f4d279a0d9b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-36-d5510b479f4d279a0d9b.png",
      "source_url": "https://mathacademy.com/tasks/14212321/diagnostics/453778",
      "captured_at": 1792007847.8836386,
      "math_academy_id": "q-338907",
