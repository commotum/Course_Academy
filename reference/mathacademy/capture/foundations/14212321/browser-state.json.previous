      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-46-8d785b4bd0f7fb478745.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-46-8d785b4bd0f7fb478745.png",
      "source_url": "https://mathacademy.com/tasks/14212321/diagnostics/453778",
      "captured_at": 1792009844.6583588,
