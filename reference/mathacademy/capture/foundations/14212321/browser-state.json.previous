><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>12</mn><mn>13</mn></mfrac></mstyle><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mi>t</mi></mrow></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>13</mn></mfrac></mstyle><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>13</mn></mfrac></mstyle><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
