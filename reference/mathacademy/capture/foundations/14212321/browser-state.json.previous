      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-32-e6ecc867c7397589422c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-32-e6ecc867c7397589422c.png",
      "source_url": "https://mathacademy.com/tasks/14212321/diagnostics/453778",
      "captured_at": 1792007257.1984618,
