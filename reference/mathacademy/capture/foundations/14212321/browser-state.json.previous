      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-3-001f9e746cdc32750977.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14212321/observations/diagnostic-3-001f9e746cdc32750977.png",
      "source_url": "https://mathacademy.com/tasks/14212321/diagnostics/453778",
