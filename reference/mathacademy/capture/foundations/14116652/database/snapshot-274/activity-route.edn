#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409924} :activity/id #uuid "7ba4c449-235c-593b-b418-e0c725f2348d" :activity/scope {:db/id #edb/ref 17592186050045 :topic/id #uuid "28837c1e-d226-56e8-b958-b4375cfa8078" :topic/math-academy-id 1978} :activity/steps [{:db/id #edb/ref 17592186409923 :step/content {:db/id #edb/ref 17592186409922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075b7e9b-145b-5c05-9d44-d25bd4906906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z={y}^{2}-{x}^{2}" :db/id #edb/ref 17592186409902} {:answer/id #uuid "2ebb8400-2445-5e48-a715-3c49140534aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z={x}^{2}-{y}^{2}" :db/id #edb/ref 17592186409903} {:answer/id #uuid "3e1d8da5-60a8-5dd3-b8c1-c0a4396407a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z={y}^{2}-{x}^{2}+2" :db/id #edb/ref 17592186409904} {:answer/id #uuid "d72a7a8d-f6c0-55af-9c80-47300b8e44cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z={y}^{2}-{x}^{2}-2" :db/id #edb/ref 17592186409911} {:answer/id #uuid "f658e47e-1f73-55ca-b61e-916ac3975ae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z={y}^{2}-{x}^{2}-4" :db/id #edb/ref 17592186409915}] :answer-field/correct {:db/id #edb/ref 17592186409902} :answer-field/id #uuid "c684e12d-e352-5e5e-a84d-c529f9dea534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409918}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ef96fb6f-8651-5bcd-8700-e66e3e1a4bf5" :question/math-academy-id "q-129189" :question/problem "Find the equation of the level surface for the function $f(x,y,z)={y}^{2}-{x}^{2}-z$ that passes through the point $P(0,-2,4).$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(0,2,4) & ={2}^{2}-{0}^{2}-4 \\\\  & =4-0-4 \\\\  & =0\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {y}^{2}-{x}^{2}-z & =0 \\\\ z & ={y}^{2}-{x}^{2}.\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(0,-2,4)$ is the hyperbolic paraboloid $z={y}^{2}-{x}^{2}.$"} :step/id #uuid "a94aecad-6d06-5584-9ae6-ff5e4c972c6e" :step/next {:db/id #edb/ref 17592186409927}} {:db/id #edb/ref 17592186409924 :step/content {:db/id #edb/ref 17592186409920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d9747b-5cb9-522d-836f-d3553c78f3a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of planes: $x+y-{z}^{2}-\\sqrt{c}=0$" :db/id #edb/ref 17592186409906} {:answer/id #uuid "b986da89-36d0-55a1-8a48-c9bd757d18db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of spheres: ${x}^{2}+{y}^{2}+{z}^{2}={c}^{2}$" :db/id #edb/ref 17592186409907} {:answer/id #uuid "c52cd181-65a2-5882-be1e-55e40ba886c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of hyperboloids of one sheet: ${c}^{2}{x}^{2}+{c}^{2}{y}^{2}-{c}^{2}{z}^{2}=1$" :db/id #edb/ref 17592186409909} {:answer/id #uuid "d11d59ab-ca32-5bdd-988e-9f236a634db6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of planes: $x+y+z\\pm \\sqrt{c}=0$" :db/id #edb/ref 17592186409910} {:answer/id #uuid "e4bedb04-7179-51c0-917b-125bf66e2a73" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of surfaces given by $z=(x+y+c)^{2}$" :db/id #edb/ref 17592186409912}] :answer-field/correct {:db/id #edb/ref 17592186409910} :answer-field/id #uuid "44405f81-ea2c-5ec0-9035-361601af3ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409917}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00fd1a7d-44b2-529b-bcff-08a778520166" :question/math-academy-id "q-71586" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=(x+y+z)^{2}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ (x+y+z)^{2} & =c \\\\ x+y+z & =\\pm \\sqrt{c} \\\\ x+y+z\\pm \\sqrt{c} & =0\\end{aligned}\n$$\n\nNotice that $f(x,y,z)$ can't be negative. Therefore, we get a family of planes:\n\n$$\nx+y+z\\pm \\sqrt{c}=0,\\,c\\in [0,\\infty ).\n$$"} :step/id #uuid "bfbdcc24-f373-559b-9261-b97d80ffba78" :step/next {:db/id #edb/ref 17592186409925}} {:db/id #edb/ref 17592186409925 :step/content {:db/id #edb/ref 17592186409921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7161819e-ecce-539e-a7d9-dd1392ee66bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+{y}^{2}-{z}^{2}=0" :db/id #edb/ref 17592186409905} {:answer/id #uuid "bf6e5c59-e63b-5d91-add0-3fc776b81f35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}+{y}^{2}-{z}^{2}=0" :db/id #edb/ref 17592186409908} {:answer/id #uuid "f1e2ddba-6b1f-50a3-8f82-6a0e5406e403" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+{y}^{2}-{z}^{2}=0" :db/id #edb/ref 17592186409913} {:answer/id #uuid "f41b80f9-1883-5d0f-a39d-6bf74d468448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+{y}^{2}-z=0" :db/id #edb/ref 17592186409914} {:answer/id #uuid "fab3e1ad-3d44-56bd-8a1c-54fb07d88d5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-{y}^{2}-{z}^{2}=0" :db/id #edb/ref 17592186409916}] :answer-field/correct {:db/id #edb/ref 17592186409905} :answer-field/id #uuid "e10467a3-d69e-5402-aad3-4b64333f090a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409919}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "595252cd-1afe-5f16-ae97-13c476966ff1" :question/math-academy-id "q-71594" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=\\frac{{x}^{2}}{2{x}^{2}+{y}^{2}-{z}^{2}}$ that passes through the point $P(2,\\sqrt{5},3).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(2,\\sqrt{5},3) & =\\frac{(2)^{2}}{2(2)^{2}+(\\sqrt{5})^{2}-(3)^{2}} \\\\  & =\\frac{4}{4} \\\\  & =1\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{{x}^{2}}{2{x}^{2}+{y}^{2}-{z}^{2}} & =1 \\\\ {x}^{2} & =2{x}^{2}+{y}^{2}-{z}^{2} \\\\ {x}^{2}+{y}^{2}-{z}^{2} & =0\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(2,\\sqrt{5},3)$ is the surface ${x}^{2}+{y}^{2}-{z}^{2}=0.$"} :step/id #uuid "d981e48e-0b28-5d2c-b93e-70be17e1dbbd" :step/next {:db/id #edb/ref 17592186409926}} {:db/id #edb/ref 17592186409926 :step/content {:db/id #edb/ref 17592186338966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341c06af-d1ba-5272-bb61-52ad376125d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=4{x}^{2}+6{y}^{2}+2" :db/id #edb/ref 17592186336522} {:answer/id #uuid "5700ae9e-968d-5bb9-b16c-fb2495caa581" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=4{x}^{2}+6{y}^{2}-2" :db/id #edb/ref 17592186336830} {:answer/id #uuid "726140df-5488-5e91-b878-03e0a7dc18a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=2{x}^{2}+3{y}^{2}-1" :db/id #edb/ref 17592186337057} {:answer/id #uuid "caa01bba-d8dc-529e-84eb-7a172fdebb43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=4{x}^{2}+6{y}^{2}" :db/id #edb/ref 17592186337815} {:answer/id #uuid "f1709cb8-4e61-5ab7-a2f4-a614c896f494" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=2{x}^{2}+3{y}^{2}" :db/id #edb/ref 17592186338145}] :answer-field/correct {:db/id #edb/ref 17592186337815} :answer-field/id #uuid "8165f0ea-43de-5434-a42c-9e10144a7415" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338506}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e38a7de1-ef3c-50e7-9539-8728abb34f00" :question/math-academy-id "q-71597" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=z-4{x}^{2}-6{y}^{2}$ that passes through the point $P(2,1,22).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(2,1,22) & =22-4(2)^{2}-6(1)^{2}=0\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ z-4{x}^{2}-6{y}^{2} & =0 \\\\ z & =4{x}^{2}+6{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(2,1,22)$ is the elliptic paraboloid $z=4{x}^{2}+6{y}^{2}.$"} :step/id #uuid "f363fade-7d87-58eb-bf21-09d29aa00dc3" :step/next {:db/id #edb/ref 17592186409923}} {:db/id #edb/ref 17592186409927 :step/content {:db/id #edb/ref 17592186262977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f39980-6ad0-53d7-ad63-fbb34a382f5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of elliptic paraboloids: $z={x}^{2}+3{y}^{2}+C$" :db/id #edb/ref 17592186259949} {:answer/id #uuid "1456f86c-f369-5c8a-aa73-f917e987fcd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of elliptic cones: ${z}^{2}={x}^{2}+3{y}^{2}+C$" :db/id #edb/ref 17592186260057} {:answer/id #uuid "64d0fc97-78ec-5077-acfa-96dd790ebb7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of elliptic paraboloids: $z=-{x}^{2}-3{y}^{2}+C$" :db/id #edb/ref 17592186260745} {:answer/id #uuid "9b989c09-44c2-5eab-8bb7-5a6b7ceb875f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of planes: $z=x+3y+C$" :db/id #edb/ref 17592186261222} {:answer/id #uuid "a1c9051c-074f-5a24-a621-b2a3449ab493" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A family of hyperbolic paraboloids: $z={x}^{2}-3{y}^{2}+C$" :db/id #edb/ref 17592186261283}] :answer-field/correct {:db/id #edb/ref 17592186259949} :answer-field/id #uuid "653d007f-928b-501b-88fc-8c02a0e38f08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262296}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9849d588-2a95-5d11-993e-dd1a8d5d4837" :question/math-academy-id "q-129196" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=-{x}^{2}-3{y}^{2}+z+3?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ -{x}^{2}-3{y}^{2}+z+3 & =c \\\\ z & ={x}^{2}+3{y}^{2}+c-3\\end{aligned}\n$$\n\nIf we let $c-3=C,$ we get a family of elliptic paraboloids:\n\n$$\nz={x}^{2}+3{y}^{2}+C,\\,C\\in (-\\infty ,\\infty )\n$$"} :step/id #uuid "f4887751-62f7-5565-b96d-ce810c1af7bd"}] :activity/title "Level Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409901}]}
