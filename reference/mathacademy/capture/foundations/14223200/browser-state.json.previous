      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125394-9feac5ca75ede1a8b63c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125394-9feac5ca75ede1a8b63c.png",
