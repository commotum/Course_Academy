      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125668-7a05f80c738e63dedfbf.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125668-7a05f80c738e63dedfbf.png",
