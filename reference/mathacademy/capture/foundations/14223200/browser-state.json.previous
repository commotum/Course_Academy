      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125645-071c67a5c3cd9073b1da.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14223200/observations/step-q125645-071c67a5c3cd9073b1da.png",
