ow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>2</mn></mfrac></mstyle><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>2</mn></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>t</mi></mrow><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">|</mo></mrow><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>4</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
