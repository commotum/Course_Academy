edb/ref 17592186048642 #edb/ref 17592186045417] [17592186050293 #edb/ref 1027 #edb/ref 17592186049809 #edb/ref 17592186045417] [17592186050293 #edb/ref 1028 #edb/ref 17592186129177 #edb/ref 17592186045417] [17592186050293 #edb/ref 1028 #edb/ref 17592186129178 #edb/ref 17592186045417] [17592186050293 #edb/ref 1028 #edb/ref 17592186129180 #edb/ref 17592186045417] [17592186050293 #edb/ref 1029 #edb/ref 17592186428523 #edb/ref 17592186045436] [17592186050293 #edb/ref 1031 "Tangent Planes to Surfaces" #edb/ref 17592186045417] [17592186050293 #edb/ref 1033 1980 #edb/ref 17592186045417] [17592186050293 #edb/ref 1035 #uuid "3d717848-5743-5882-aa66-adea2ee38d55" #edb/ref 17592186045417] [17592186050940 #edb/ref 1027 #edb/ref 17592186048367 #edb/ref 17592186045417] [17592186050940 #edb/ref 1028 #edb/ref 17592186204076 #edb/ref 17592186045417] [17592186050940 #edb/ref 1028 #edb/ref 17592186204077 #edb/ref 17592186045417] [17592186050940 #edb/ref 1028 #edb/ref 17592186204078 #edb/ref 17592186045417] [17592186050940 #edb/ref 1031 "Total and Tensor Derivatives" #edb/ref 17592186045417] [17592186050940 #edb/ref 1033 5845 #edb/ref 17592186045417] [17592186050940 #edb/ref 1035 #uuid "738cac6f-eca5-5a18-9894-32e0395cb5a2" #edb/ref 17592186045417] [17592186194429 #edb/ref 1075 #edb/ref 17592186427508 #edb/ref 17592186045417] [17592186194429 #edb/ref 1075 #edb/ref 17592186427509 #edb/ref 17592186045417] [17592186194429 #edb/ref 1075 #edb/ref 17592186427513 #edb/ref 17592186045417] [17592186194429 #edb/ref 1075 #edb/ref 17592186427514 #edb/ref 17592186045417] [17592186194429 #edb/ref 1075 #edb/ref 17592186427516 #edb/ref 17592186045417] [17592186194429 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186194429 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186194429 #edb/ref 1078 #edb/ref 17592186427516 #edb/ref 17592186045417] [17592186194429 #edb/ref 1079 #uuid "d21567a5-5f65-5300-b094-9bc5b4d4fdfd" #edb/ref 17592186045417] [17592186198053 #edb/ref 1069 "e-12477" #edb/ref 17592186045417] [17592186198053 #edb/ref 1071 "For the transformation $f:\\mathbb R^2\\to\\mathbb R,$ defined as\n\n![](images/55/55831f05bb13347baf6816e77b462b893906cead512607cc4caf796440bbc2d7.svg)\n\ncalculate $\\boldsymbol f'$ at ![](images/ab/abac407b29e870cfe7090d3a263109f10a122fe1de14abbd76baef6d7101b3d2.svg)" #edb/ref 17592186045417] [17592186198053 #edb/ref 1072 #uuid "ea202ce3-07d4-5324-9ee4-f5617b430772" #edb/ref 17592186045417] [17592186198053 #edb/ref 1074 "Suppose a transformation $\\boldsymbol{f}:\\mathbb R^n\\to\\mathbb R^m$ is defined by \n\n![](images/28/286bec34ba72c733264e8223150d56566d0f61797cb221bed0af0323c3e190c9.svg) \n\nwhere $f_1,f_2,\\ldots,f_m$ are scalar functions with $n$ variables. If $\\boldsymbol f$ is differentiable at $\\mathbf{x},$ then the total derivative of $\\boldsymbol f$ at $\\mathbf{x},$ denoted $\\boldsymbol{f}'(\\mathbf{x}),$ is given by the $m \\times n$ matrix\n\n![](images/33/33b42ebfc6c3f32ef92212f61a138080543e2e2981088f7b5760b23f7ac31c6c.svg)\n\nIn our case, we have the following:\n\n![](images/35/354f034a96ffe5bde885644792f50636dc8cbde6f00d65159b0bdefdd836fa09.svg)\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}y)=2xy, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}y)={x}^{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n![](images/90/900488a105afb5aa10e9113db36cd9f2e834eac46300d7c0a521a7100ae0d88f.svg)\n\nand $\\boldsymbol{f}'$ at ![](images/ed/ed7c974c8fca89e98f542231572e558caf867b200843d2b222ccda4c68a1c33b.svg) is\n\n![](images/ab/abd152888f711ecd43a47e31269e40985178782591546e9d96912fd4c230afa0.svg)" #edb/ref 17592186045417] [17592186198054 #edb/ref 1069 "e-12478" #edb/ref 17592186045417] [17592186198054 #edb/ref 1071 "For the transformation $\\boldsymbol{f}:\\mathbb R^2\\to\\mathbb R^3,$ defined as\n\n![](images/bb/bbb9192192b4d73f4993b3131a2b0bb1d0a0cddb77b754940d1b7684bfb08336.svg)\n\nthe total derivative $\\boldsymbol f'$ is given by \n\n![](images/2c/2cf231879630af578e33b201e5be0f65d019da9c49da7789f5921c05a8249c09.svg)\nFrom top to bottom, what are the missing entries?" #edb/ref 17592186045417] [17592186198054 #edb/ref 1072 #uuid "ea76d21f-eff8-5634-975f-2b5bd24caf54" #edb/ref 17592186045417] [17592186198054 #edb/ref 1074 "Suppose a transformation $\\boldsymbol{f}:\\mathbb R^n\\to\\mathbb R^m$ is defined by \n\n![](images/49/49c118b037a1589c6feb2c96afeaccb15fe905663393800638baff8cef327a3a.svg) \n\nwhere $f_1,f_2,\\ldots,f_m$ are scalar functions with $n$ variables. If $\\boldsymbol{f}$ is differentiable at $\\mathbf{x},$ then the total derivative of $\\boldsymbol{f}$ at $\\mathbf{x},$ denoted $\\boldsymbol{f}'(\\mathbf{x}),$ is given by the $m \\times n$ matrix\n\n![](images/a5/a5ed3766e8ed6a2a5fd249078e244dfab19b1c20d55548c27a7053bd0130c278.svg)\n\nIn our case, we have the following:\n\n![](images/23/23d7804912a10685756bb4ec89d12e3f6659b435ebe4d22c436684fb6eef9df8.svg)\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(xy)=y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(xy)=x, \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({y}^{2})=0,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({y}^{2})=2y, \\\\ \\frac{∂{f}_{3}}{∂x} & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x)=\\frac{y}{x},\\, & \\frac{∂{f}_{3}}{∂y} & =\\frac{∂}{∂y}(y\\operatorname{ln}⁡x)=\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nTherefore, we have\n\n![](images/ea/eae5dd91db0cc17bec3af0a4781c7a58e8c65edb6c4139642f9c806dfc9c2473.svg)\nThus, the missing entries are $y,\\:$ $0,\\:$ and $\\ln{x}.$" #edb/ref 17592186045417] [17592186198055 #edb/ref 1069 "e-12479" #edb/ref 17592186045417] [17592186198055 #edb/ref 1071 "Consider the function $f:\\mathbb R^2\\to\\mathbb R,$ defined as\n\n![](images/7c/7c033fac25d53675fc47eaf5184d33f95c6e3524d82a4c547fb900e13c5205f7.svg)\n\nIf the tangent to $f$ at ![](images/9c/9c89326030e3216291d4c0fbd715cdd634a567b6dae3f0d26620d19ee5f470ea.svg) is given by\n\n![](images/62/62ad44fc4734bc7006e9cc72a3e142d2df1d932f3fcdf1c0c6c125e8bd19d626.svg)\n\nfind the missing values." #edb/ref 17592186045417] [17592186198055 #edb/ref 1072 #uuid "db0be438-94fe-52de-9daf-60d1727ce7b9" #edb/ref 17592186045417] [17592186198055 #edb/ref 1074 "Suppose a transformation $\\boldsymbol{f}:\\mathbb R^n\\to\\mathbb R^m$ is defined by \n\n![](images/82/826e5972b8b35e46f759dfb8f465316db48e36b12ef37d73b7bce6931f65a3d9.svg) \n\nwhere $f_1,f_2,\\ldots,f_m$ are scalar functions with $n$ variables. If $\\boldsymbol{f}$ is differentiable at $\\mathbf{x},$ then the total derivative of $\\boldsymbol{f}$ at $\\mathbf{x},$ denoted $\\boldsymbol{f}'(\\mathbf{x}),$ is given by the $m \\times n$ matrix\n\n![](images/85/85c62ebacb5d1aaf052165a76d44b42dc83a2918020320326fd4bbe8cc4da14c.svg)\n\nIn our case, we have the following:\n\n![](images/93/93faf7b5ccbadf7600ec47c7e63cac088211130f0f30109fbc71f2d7081139b9.svg)\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{3}+{e}^{y})=3{x}^{2},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}+{e}^{y})={e}^{y}\\end{aligned}\n$$\n\nTherefore, we have\n\n![](images/65/65e55a996288ffb34ef5b44b9b49dc7adaf681d379625733e7e74f8363f3f36f.svg)\n\nEvaluating $f$ and its derivative at ![](images/6a/6a0a72041eadc608c5f2ef7217a5e627115cee3bce332751a5cb46acd9dc0c24.svg) we have\n\n![](images/ee/ee17f93ff906242db59f3ef934b9501e7335a46ba5710e3fd89645e83be5ba34.svg)\n\nThe tangent to $f$ at $\\mathbf x = \\mathbf a$ is given by\n\n$$\nz - f(\\mathbf a) = \\boldsymbol{f}'(\\mathbf a)(\\mathbf x - \\mathbf a).\n$$\n\nSubstituting $f(\\mathbf a),$ $\\boldsymbol{f}'(\\mathbf a),$ and $\\mathbf a$ in the equation above, we obtain\n\n![](images/42/42b3574762b1d9b14d27f8ba29b5c89bca66ec03724fbec7557c7bf6e5524972.svg)" #edb/ref 17592186045417] [17592186198056 #edb/ref 1069 "e-12484" #edb/ref 17592186045417] [17592186198056 #edb/ref 1071 "Consider the transformation $\\boldsymbol{f}:\\mathbb R^2\\to\\mathbb R^2,$ defined as\n\n![](images/f8/f8eb8b775c1645d73acd7313f54bdff4cdb55830ac6ebea2165c9263321ffb9e.svg)\n\nIf the linear approximation of $\\boldsymbol f$ at ![](images/18/18b82def6f36d90157e99ef72f14b857cd1e0c3007e684c660c31fd61f805040.svg) is given by\n\n![](images/91/91e5867a6be8302649edc9c2e1e4c4642c60853c7c3ad9bb2d25f9c649b5889d.svg)\n\nwhat are the missing values?" #edb/ref 17592186045417] [17592186198056 #edb/ref 1072 #uuid "f3540571-9159-50b4-a46c-4cf28a454602" #edb/ref 17592186045417] [17592186198056 #edb/ref 1074 "Suppose a transformation $\\boldsymbol{f}:\\mathbb R^n\\to\\mathbb R^m$ is defined by \n\n![](images/43/43ffd01ab7a6d78ea0343953b985d9c4165ee76085f345bcd500c053550e3ec9.svg) \n\nwhere $f_1,f_2,\\ldots,f_m$ are scalar functions with $n$ variables. If $\\boldsymbol{f}$ is differentiable at $\\mathbf{x},$ then the total derivative of $\\boldsymbol{f}$ at $\\mathbf{x},$ denoted $\\boldsymbol{f}'(\\mathbf{x}),$ is given by the $m \\times n$ matrix\n\n![](images/51/51191f4e8b1417de7b391a71d68c7c5917ed7083cc3b7a630662d6a0912b969c.svg)\n\nIn our case, we have the following:\n\n![](images/06/066be34bb8bd7f585bc3d2666007e189f6c82f2e3b7f7a699928066825fd765d.svg)\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}\\operatorname{sin}⁡{x}_{1})={x}_{2}\\operatorname{cos}⁡{x}_{1},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}\\operatorname{sin}⁡{x}_{1})=\\operatorname{sin}⁡{x}_{1} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(\\operatorname{sin}⁡{x}_{2})=0,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(\\operatorname{sin}⁡{x}_{2})=\\operatorname{cos}⁡{x}_{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n![](images/86/869b2f5de537961c4c83523ac6fcfd96329fc062e34509d88b8516b7a2259b84.svg)\n\nEvaluating $\\boldsymbol{f}$ and its derivative at ![](images/b3/b35d7585ed24aea694c3a31e69c1406744986db30cddf8842a5bae8d6d745e4b.svg) we have\n\n![](images/9f/9f3dbb19be577a74b8f19fd1eb5d42910fd0e46637388a3daab80c17d6edd833.svg)\n\nThe linear approximation of $\\boldsymbol{f}$ at $\\mathbf x = \\mathbf a$ is given by\n\n$$\n\\boldsymbol{f}\\left(\\mathbf x \\right) \\approx \\boldsymbol{f}(\\mathbf a) + \\boldsymbol{f}'(\\mathbf a)(\\mathbf x - \\mathbf a).\n$$\n\nSubstituting $\\boldsymbol{f}(\\mathbf a),$ $\\boldsymbol{f}'(\\mathbf a),$ and $\\mathbf a$ in the equation above, we obtain\n\n![](images/5d/5d526b2485b53b029bc119e66e6a385d0ba228ecca1ffd0c58e7934e83a97a7b.svg)" #edb/ref 17592186045417] [17592186198411 #edb/ref 1037 #edb/ref 17592186049809 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186198634 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186198642 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186235543 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281579 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281580 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281581 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186367755 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186367762 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389381 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389388 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389395 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186427518 #edb/ref 17592186045417] [17592186198411 #edb/ref 1039 "Finding the Derivative of a Scalar Function" #edb/ref 17592186045417] [17592186198411 #edb/ref 1041 #edb/ref 17592186198053 #edb/ref 17592186045417] [17592186198411 #edb/ref 1042 #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756" #edb/ref 17592186045417] [17592186198412 #edb/ref 1037 #edb/ref 17592186048219 #edb/ref 17592186045417] [17592186198412 #edb/ref 1038 #edb/ref 17592186198632 #edb/ref 17592186045417] [175