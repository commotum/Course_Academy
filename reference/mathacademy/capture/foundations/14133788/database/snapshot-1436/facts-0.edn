281591 #edb/ref 1068 #edb/ref 17592186280938 #edb/ref 17592186045417] [17592186281591 #edb/ref 1069 "q-163078" #edb/ref 17592186045417] [17592186281591 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281591 #edb/ref 1071 "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={x}^{2}+xy,\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 \\\\ 1\\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" #edb/ref 17592186045417] [17592186281591 #edb/ref 1072 #uuid "c2ef07bc-cc92-59f4-ab07-cedcba745cfb" #edb/ref 17592186045417] [17592186281591 #edb/ref 1074 "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}+xy)=2x+y,\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}+xy)=x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}2x+y & x\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}],$ we have\n\n$$\nf(a)=2,\\,{f}^{′}(a)=[\\begin{aligned}-3 & -2\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-2=[\\begin{aligned}-3 & -2\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 \\\\ 1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n2+(-3)+(-2)=-3.\n$$" #edb/ref 17592186045417] [17592186281598 #edb/ref 1068 #edb/ref 17592186281006 #edb/ref 17592186045417] [17592186281598 #edb/ref 1069 "q-163093" #edb/ref 17592186045417] [17592186281598 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186281598 #edb/ref 1071 "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}\\operatorname{ln}⁡({x}_{1})+{x}_{2} \\\\ {x}_{2}^{2}+1\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nIf the linear approximation of $f$ at  $a=[\\begin{aligned}e \\\\ -1\\end{aligned}]$ is given by\n\n$$\nf(x)≈[\\begin{aligned}∗ \\\\ 2\\end{aligned}]+[\\begin{aligned}∗ & 1 \\\\ 0 & ∗\\end{aligned}](x-[\\begin{aligned}e \\\\ -1\\end{aligned}]),\n$$\n\nwhat is the sum of the missing values?" #edb/ref 17592186045417] [17592186281598 #edb/ref 1072 #uuid "47bfa96d-bfdf-5b9f-a011-3a66ebe7f2b8" #edb/ref 17592186045417] [17592186281598 #edb/ref 1074 "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(\\operatorname{ln}⁡({x}_{1})+{x}_{2})=\\frac{1}{{x}_{1}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(\\operatorname{ln}⁡({x}_{1})+{x}_{2})=1 \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}^{2}+1)=0,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}^{2}+1)=2{x}_{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}{x}_{1}^{-1} & 1 \\\\ 0 & 2{x}_{2}\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}e \\\\ -1\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}0 \\\\ 2\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}{e}^{-1} & 1 \\\\ 0 & -2\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}{e}^{-1} & 1 \\\\ 0 & -2\\end{aligned}](x-[\\begin{aligned}e \\\\ -1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n0+{e}^{-1}+(-2)={e}^{-1}-2.\n$$" #edb/ref 17592186045417] [17592186281601 #edb/ref 1068 #edb/ref 17592186281061 #edb/ref 17592186045417] [17592186281601 #edb/ref 1069 "q-163099" #edb/ref 17592186045417] [17592186281601 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281601 #edb/ref 1071 "For the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}\\frac{x}{y} \\\\ {e}^{x-y}\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" #edb/ref 17592186045417] [17592186281601 #edb/ref 1072 #uuid "754cc616-7c79-55a6-8b43-74dd54ff339a" #edb/ref 17592186045417] [17592186281601 #edb/ref 1074 "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({e}^{x-y})={e}^{x-y},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({e}^{x-y})=-{e}^{x-y}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{1}{y} & -\\frac{x}{{y}^{2}} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186367832 #edb/ref 1068 #edb/ref 17592186367833 #edb/ref 17592186045417] [17592186367832 #edb/ref 1069 "q-163162" #edb/ref 17592186045417] [17592186367832 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186367832 #edb/ref 1071 "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}{x}_{1}^{3}-{x}_{2} \\\\ {x}_{2}{e}^{{x}_{1}}\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nIf the linear approximation of $f$ at $a=[\\begin{aligned}0 \\\\ -1\\end{aligned}]$ is given by\n\n$$\nf(x)≈[\\begin{aligned}∗ \\\\ -1\\end{aligned}]+[\\begin{aligned}0 & -1 \\\\ ∗ & ∗\\end{aligned}](x-[\\begin{aligned}0 \\\\ -1\\end{aligned}]),\n$$\n\nwhat is the sum of the missing values?" #edb/ref 17592186045417] [17592186367832 #edb/ref 1072 #uuid "b78101c4-fecc-5cba-9eee-2c628a3b3929" #edb/ref 17592186045417] [17592186367832 #edb/ref 1074 "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{1}^{3}-{x}_{2})=3{x}_{1}^{2},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{1}^{3}-{x}_{2})=-1 \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}{e}^{{x}_{1}})={x}_{2}{e}^{{x}_{1}},\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}{e}^{{x}_{1}})={e}^{{x}_{1}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}3{x}_{1}^{2} & -1 \\\\ {x}_{2}{e}^{{x}_{1}} & {e}^{{x}_{1}}\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}0 \\\\ -1\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}1 \\\\ -1\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}0 & -1 \\\\ -1 & 1\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}1 \\\\ -1\\end{aligned}]+[\\begin{aligned}0 & -1 \\\\ -1 & 1\\end{aligned}](x-[\\begin{aligned}0 \\\\ -1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n1+(-1)+1=1.\n$$" #edb/ref 17592186045417] [17592186367833 #edb/ref 1075 #edb/ref 17592186367834 #edb/ref 17592186045417] [17592186367833 #edb/ref 1075 #edb/ref 17592186367835 #edb/ref 17592186045417] [17592186367833 #edb/ref 1075 #edb/ref 17592186367836 #edb/ref 17592186045417] [17592186367833 #edb/ref 1075 #edb/ref 17592186367837 #edb/ref 17592186045417] [17592186367833 #edb/ref 1075 #edb/ref 17592186367838 #edb/ref 17592186045417] [17592186367833 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186367833 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186367833 #edb/ref 1078 #edb/ref 17592186367836 #edb/ref 17592186045417] [17592186367833 #edb/ref 1079 #uuid "703aea1e-c64a-581f-b4f6-a53c00907653" #ed