  "live_records": {
    "q-83949": {
      "dom_id": "step-q83949",
      "name": "Question 1",
      "problem": "Compute $\\text{E}[(A+1)(A-3)]$ if $\\text{E}[{A}^{2}]=7$ and $\\text{E}[A]=2.$",
      "worked_solution": "Expanding out the square inside the expected value, using the properties of the expected value, and substituting in the given information, we get\n\n$$\n\\begin{aligned}\\text{E}[(A+1)(A-3)] & =\\text{E}[{A}^{2}-2A-3] \\\\  & =\\text{E}[{A}^{2}]+\\text{E}[-2A]+\\text{E}[-3] \\\\  & =\\text{E}[{A}^{2}]-2\\text{E}[A]-3 \\\\  & =7-2(2)-3 \\\\  & =0.\\end{aligned}\n$$",
      "calculator_instructions": "",
