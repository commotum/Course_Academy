</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>A</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><msup><mi>A</mi><mn>2</mn></msup><mo stretchy=\"false\">]</mo><mo>+</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><mo>−</mo><mn>2</mn><mi>A</mi><mo stretchy=\"false\">]</mo><mo>+</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><msup><mi>A</mi><mn>2</mn></msup><mo stretchy=\"false\">]</mo><mo>−</mo><mn>2</mn><mtext>E</mtext><mo stretchy=\"false\">[</mo><mi>A</mi><mo stretchy=\"false\">]</mo><mo>−</mo><mn>3</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>7</mn><mo>−</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>3</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
