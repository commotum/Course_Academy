id "1786d23c-6b2b-5b25-8a34-a3df54af58bf" :step/content 17592186339043 :step/next "step-06a4b700-aa67-595f-ad77-c3a9c2d08fa3" :db/ensure [:step/validate]} {:db/id "step-06a4b700-aa67-595f-ad77-c3a9c2d08fa3" :step/id #uuid "06a4b700-aa67-595f-ad77-c3a9c2d08fa3" :step/content "question-538fdcf0-8dcd-525c-becd-0317742dbf1a" :step/next "step-61817e36-5704-54ae-b054-a7bf550b56c7" :db/ensure [:step/validate]} {:db/id "step-61817e36-5704-54ae-b054-a7bf550b56c7" :step/id #uuid "61817e36-5704-54ae-b054-a7bf550b56c7" :step/content "question-5744243e-c58b-5537-916f-bee0cb473253" :step/next "step-be87cbb6-8a21-5895-a193-08d9d1a311c5" :db/ensure [:step/validate]} {:db/id "step-be87cbb6-8a21-5895-a193-08d9d1a311c5" :step/id #uuid "be87cbb6-8a21-5895-a193-08d9d1a311c5" :step/content "question-0a3b6388-98bd-5083-8d1c-f60a05890b23" :db/ensure [:step/validate]}]
