86045417] [17592186537815 #edb/ref 1075 #edb/ref 17592186537504 #edb/ref 17592186045417] [17592186537815 #edb/ref 1075 #edb/ref 17592186537591 #edb/ref 17592186045417] [17592186537815 #edb/ref 1075 #edb/ref 17592186537643 #edb/ref 17592186045417] [17592186537815 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537815 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537815 #edb/ref 1078 #edb/ref 17592186537284 #edb/ref 17592186045417] [17592186537815 #edb/ref 1079 #uuid "8bc18207-a6fd-5437-a68d-b3d6fef6d67e" #edb/ref 17592186045417] [17592186540271 #edb/ref 1068 #edb/ref 17592186540272 #edb/ref 17592186045443] [17592186540271 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186540271 #edb/ref 1071 "![](images/e4/e46488d991bf461eacc51ecfcd490497bf13fcdf2b7ff998b54fdc501caf40ab.png)\n\nConsider the vector field $F=3\\,i$ and a square $C$ with side length $10$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$" #edb/ref 17592186045443] [17592186540271 #edb/ref 1072 #uuid "35cb0fe5-8d22-5821-8dbb-8da5656983ba" #edb/ref 17592186045443] [17592186540271 #edb/ref 1074 "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/a2/a2964076c4126d6277625260c45479d1a4fb2028f7e75223a0f5942b15f5a2d2.png)\n\nNow, since the vector field $F=3\\,i$ is parallel to ${C}_{2}$ and ${C}_{4},$ there is zero net flow through these two sides. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=0.\n$$\n\nSo, our expression for the flux reduces to\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s.\n$$\n\nNow, since the vector field is uniform, the net outflow through ${C}_{1}$ will cancel with the net inflow through ${C}_{3}.$ That is\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s=-{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s\\,⟹\\,{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=0.\n$$\n\nTherefore, we conclude that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=0.\n$$" #edb/ref 17592186045443] [17592186540276 #edb/ref 1168 "generate/scratch/17592186179646.py" #edb/ref 17592186045443] [17592186540276 #edb/ref 1169 #uuid "2559158e-ccf7-5367-8a90-3d49434ee990" #edb/ref 17592186045443] [17592186551659 #edb/ref 1043 #edb/ref 17592186552533 #edb/ref 17592186045417] [17592186551659 #edb/ref 1043 #edb/ref 17592186552535 #edb/ref 17592186045417] [17592186551659 #edb/ref 1043 #edb/ref 17592186552567 #edb/ref 17592186045417] [17592186551659 #edb/ref 1043 #edb/ref 17592186552601 #edb/ref 17592186045417] [17592186551659 #edb/ref 1043 #edb/ref 17592186552605 #edb/ref 17592186045417] [17592186551659 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186551659 #edb/ref 1045 "Flux in Two-Dimensional Vector Fields" #edb/ref 17592186045417] [17592186551659 #edb/ref 1046 #edb/ref 17592186552535 #edb/ref 17592186045417] [17592186551659 #edb/ref 1048 #edb/ref 17592186046669 #edb/ref 17592186045417] [17592186551659 #edb/ref 1049 #edb/ref 17592186048376 #edb/ref 17592186045417] [17592186551659 #edb/ref 1053 #uuid "b0acf0c5-df93-5a94-be91-5f6d79d75ec4" #edb/ref 17592186045417] [17592186551740 #edb/ref 1080 "{x}^{3}y+{x}^{2}y" #edb/ref 17592186045417] [17592186551740 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186551740 #edb/ref 1083 #uuid "21a7742d-0ab1-5cb1-a4e0-9f04009f380a" #