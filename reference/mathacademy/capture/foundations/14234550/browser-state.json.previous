      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234550/observations/step-q127205-b477eddbec70a8ee28fa.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234550/observations/step-q127205-b477eddbec70a8ee28fa.png",
      "source_url": "https://mathacademy.com/tasks/14234550/topics/3715/review",
      "captured_at": 1792079664.3672373,
      "math_academy_id": "q-127205",
      "topic_id": "3715",
