      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234550/observations/step-q127190-66513f17fa446a2afbc3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14234550/observations/step-q127190-66513f17fa446a2afbc3.png",
      "source_url": "https://mathacademy.com/tasks/14234550/topics/3715/review",
      "captured_at": 1792079647.6330361,
      "math_academy_id": "q-127190",
