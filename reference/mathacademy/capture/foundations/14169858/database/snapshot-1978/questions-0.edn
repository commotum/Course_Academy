#{[{:db/id #edb/ref 17592186435413 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a520ba4-1bc5-52a1-8b92-4fc8f8534ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{3}+\\frac{(y+1)^{2}}{5}=1" :db/id #edb/ref 17592186435396} {:answer/id #uuid "9d0bb612-0c9d-520f-8d2d-1cd458c72942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{9}+\\frac{(y-3)^{2}}{25}=1" :db/id #edb/ref 17592186435401} {:answer/id #uuid "d3edf35a-4f87-5270-a7f9-9191deeedcf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-1)^{2}}{9}+\\frac{(y+3)^{2}}{25}=1" :db/id #edb/ref 17592186435403} {:answer/id #uuid "f2f00129-bfef-5325-bde1-618b368cc3e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25}=1" :db/id #edb/ref 17592186435406} {:answer/id #uuid "f94ac654-4ebc-5c1d-bd20-dcd10dcce606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{9}+\\frac{(y-1)^{2}}{25}=1" :db/id #edb/ref 17592186435407}] :answer-field/correct {:answer/id #uuid "f2f00129-bfef-5325-bde1-618b368cc3e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25}=1" :db/id #edb/ref 17592186435406} :answer-field/id #uuid "e9fa936b-ac16-50be-bf66-4d709c62af39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435410}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37e33b7e-4ee9-510a-871b-336b8d3b6afc" :question/math-academy-id "q-16551" :question/problem "![](images/0f/0faaa905476ef6b6224a4b6b24ceb1adde4b14680507a7c6289885dce1bdd997.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(3,-1),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{{3}^{2}}+\\frac{(y-(-1))^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088041 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "881a9718-ed21-5a7e-ac57-c950457790b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((x - 3)^{2})/(4) + ((y + 1)^{2})/(9) = 1" :db/id #edb/ref 17592186084981} {:answer/id #uuid "eed75e08-d690-57f9-8729-4b625142ffa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((x - 3)^{2})/(4) + ((y - 1)^{2})/(9) = 1" :db/id #edb/ref 17592186084982} {:answer/id #uuid "f20a2b01-61e7-59cc-bf61-455439366161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((x + 3)^{2})/(4) + ((y - 1)^{2})/(9) = 1" :db/id #edb/ref 17592186084983} {:answer/id #uuid "15581073-48c7-54e3-8a53-7aab35d607f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "((x + 3)^{2})/(9) + ((y - 1)^{2})/(4) = 1" :db/id #edb/ref 175921