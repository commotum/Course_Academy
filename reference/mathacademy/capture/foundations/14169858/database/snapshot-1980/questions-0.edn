#{[{:db/id #edb/ref 17592186492030 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0641d0ca-b167-5aaf-92a4-df902db5bdf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{4}+\\frac{(y-3)^{2}}{16}=1" :db/id #edb/ref 17592186491465} {:answer/id #uuid "848ca13d-1092-5bbe-81af-61e3b49d6f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{4}+\\frac{(y-3)^{2}}{8}=1" :db/id #edb/ref 17592186491681} {:answer/id #uuid "97500f59-4348-5c60-acf4-81c969612b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y+3)^{2}}{9}=1" :db/id #edb/ref 17592186491714} {:answer/id #uuid "d4aaf30c-1f13-562e-8e25-4ed56fbe93a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186491817} {:answer/id #uuid "fe0e2bfa-c5ad-5c73-8757-afd62a05edcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{2}+\\frac{(y-3)^{2}}{4}=1" :db/id #edb/ref 17592186491884}] :answer-field/correct {:answer/id #uuid "0641d0ca-b167-5aaf-92a4-df902db5bdf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{4}+\\frac{(y-3)^{2}}{16}=1" :db/id #edb/ref 17592186491465} :answer-field/id #uuid "e9014d83-8f77-5e76-ac5f-07c2cc345510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491976}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "848c711c-9734-5cc4-9451-94c013a46d17" :question/math-academy-id "q-115295" :question/problem "![](images/7f/7f67ba6003b5d22d8e6a325cd2aa66add1479b6d50b1e3cede350db9f06441f3.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,3),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{2}^{2}}+\\frac{(y-3)^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x+2)^{2}}{4}+\\frac{(y-3)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186435413 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a520ba4-1bc5-52a1-8b92-4fc8f8534ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{3}+\\frac{(y+1)^{2}}{5}=1" :db/id #edb/ref 17592186435396} {:answer/id #uuid "9d0bb612-0c9d-520f-8d2d-1cd458c72942" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+1)^{2}}{9}+\\frac{(y-3)^{2}}{25}=1" :db/id #edb/ref 17592186435401} {:answer/id #uuid "d3edf35a-4f87-5270-a7f9-9191deeedcf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-1)^{2}}{9}+\\frac{(y+3)^{2}}{25}=1" :db/id #edb/ref 17592186435403} {:answer/id #uuid "f2f00129-bfef-5325-bde1-618b368cc3e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25}=1" :db/id #edb/ref 17592186435406} {:answer/id #uuid "f94ac654-4ebc-5c1d-bd20-dcd10dcce606" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{9}+\\frac{(y-1)^{2}}{25}=1" :db/id #edb/ref 17592186435407}] :answer-field/correct {:answer/id #uuid "f2f00129-bfef-5325-bde1-618b368cc3e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25}=1" :db/id #edb/ref 17592186435406} :answer-field/id #uuid "e9fa936b-ac16-50be-bf66-4d709c62af39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435410}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37e33b7e-4ee9-510a-871b-336b8d3b6afc" :question/math-academy-id "q-16551" :question/problem "![](images/0f/0faaa905476ef6b6224a4b6b24ceb1adde4b14680507a7c6289885dce1bdd997.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(3,-1),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{{3}^{2}}+\\frac{(y-(-1))^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088041 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88eaea4a-3a5d-5f29-b51d-6ff654b9b802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{9}+\\frac{(y+1)^{2}}{4}=1" :db/id #edb/ref 17592186491687} {:answer/id #uuid "8af024a3-f50a-5379-a004-a68dec18af94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y+1)^{2}}{9}=1" :db/id #edb/ref 17592186491690} {:answer/id #uuid "94a30ef1-870c-5470-86cd-9470e2f159d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-1)^{2}}{9}=1" :db/id #edb/ref 17592186491709} {:answer/id #uuid "9e21a6d5-ee40-51a4-b0e4-922e26d7ffce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{9}+\\frac{(y-1)^{2}}{4}=1" :db/id #edb/ref 17592186491731} {:answer/id #uuid "9fb9fe80-fb14-544d-bba6-1bdd23f087ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y-1)^{2}}{9}=1" :db/id #edb/ref 17592186491736}] :answer-field/correct {:answer/id #uuid "8af024a3-f50a-5379-a004-a68dec18af94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y+1)^{2}}{9}=1" :db/id #edb/ref 17592186491690} :answer-field/id #uuid "8895e13d-025f-550f-b1c1-48a6109df7e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084980}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "083fc356-9796-54f8-936c-7872764a7183" :question/math-academy-id "q-16557" :question/problem "![](images/aa/aa0b48e9042aafdd70db2d008c826abc6dc04bcb916504860117b87cd86c7fbe.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(3,-1),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{{2}^{2}}+\\frac{(y-(-1))^{2}}{{3}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{4}+\\frac{(y+1)^{2}}{9} & =1.\\end{aligned}\n$$"}]}
