d56b5a" #edb/ref 17592186045417] [17592186511555 #edb/ref 1068 #edb/ref 17592186511325 #edb/ref 17592186045417] [17592186511555 #edb/ref 1068 #edb/ref 17592186511398 #edb/ref 17592186045417] [17592186511555 #edb/ref 1069 "q-340808" #edb/ref 17592186045417] [17592186511555 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186511555 #edb/ref 1071 "Consider the function $f(x)=\\operatorname{sin}⁡(2x)$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the \n{{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." #edb/ref 17592186045417] [17592186511555 #edb/ref 1072 #uuid "cd373585-64b2-5a1f-ad55-f3dee081e651" #edb/ref 17592186045417] [17592186511555 #edb/ref 1074 "To determine whether $f$ is even or odd, we compare $f(-x)$ and $f(x):$\n\n$$\n\\begin{aligned}f(-x) & =\\operatorname{sin}⁡(2(-x)) \\\\  & =\\operatorname{sin}⁡(-2x) \\\\  & =-\\operatorname{sin}⁡(2x) \\\\  & =-f(x).\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ we have that $f$ is odd.\n\nFor Fourier series on $[-\\pi ,\\pi ],$ the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x,\n$$\n\nand the constant coefficient is\n\n$$\n{a}_{0}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nHere, $f(x)$ is odd and $\\operatorname{cos}⁡(nx)$ is even, so $f(x)\\operatorname{cos}⁡(nx)$ is odd. Also, $f(x)$ itself is odd.\n\nNow, the integral of an odd function over $[-\\pi ,\\pi ]$ is $0.$ Thus, ${a}_{n}=0$ for all $n\\ge 1,$ and ${a}_{0}=0.$\n\nTherefore, the function $f(x)$ is $\\text{odd}$ and the $\\text{cosine terms}$ in its Fourier series must be zero." #edb/ref 17592186045417] [17592186511576 #edb/ref 1068 #edb/ref 17592186511315 #edb/ref 17592186045417] [17592186511576 #edb/ref 1069 "q-340784" #edb/ref 17592186045417] [17592186511576 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186511576 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $f(x)$ be the $2\\pi $-periodic extension of a function from $x\\in [-\\pi ,\\pi )$ to $x\\in R$ with the Fourier series shown above. What is the $5$th cosine Fourier coefficient of $f(-x)?$" #edb/ref 17592186045417] [17592186511576 #edb/ref 1072 #uuid "f0bd5207-abfa-5ab3-9c43-fac18e98df50" #edb/ref 17592186045417] [17592186511576 #edb/ref 1074 "The Fourier series of $f(x)$ is\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nRecall that the corresponding Fourier coefficients of $f(-x)$ are\n\n- ${a}_{0}$ for the constant coefficient,\n\n- ${a}_{n},$ $n\\ge 1,$ for the cosine coefficients, and\n\n- $-{b}_{n},$ $n\\ge 1,$ for the sine coefficients.\n\nTherefore, the $5$th cosine coefficient of $f(-x)$ is ${a}_{5}.$" #edb/ref 17592186045417] [17592186511624 #edb/ref 1058 #edb/ref 17592186511672 #edb/ref 17592186045417] [17592186511624 #edb/ref 1062 #uuid "59e44bcc-0c2e-57a7-8e71-45cfd8dd1e87" #edb/ref 17592186045417] [17592186511624 #edb/ref 1063 #edb/ref 17592186511524 #edb/ref 17592186045417] [17592186511638 #edb/ref 1058 #edb/ref 17592186511624 #edb/ref 17592186045417] [17592186511638 #edb/ref 1062 #uuid "8c2976be-ba7a-5dd8-a390-f8f1e5aa8929" #edb/ref 17592186045417] [17592186511638 #edb/ref 1063 #edb/ref 17592186511576 #edb/ref 17592186045417] [17592186511644 #edb/ref 1058 #edb/ref 17592186511655 #edb/ref 17592186045417] [17592186511644 #edb/ref 1062 #uuid "9c211d01-9532-5ebc-88b5-b6935d393a65" #edb/ref 17592186045417] [17592186511644 #edb/ref 1063 #edb/ref 17592186511472 #edb/ref 17592186045417] [17592186511655 #edb/ref 1058 #edb/ref 17592186511638 #edb/ref 17592186045417] [17592186511655 #edb/ref 1062 #uuid "b2b11a51-d093-57da-a2af-6ee6f4f4690b" #edb/ref 17592186045417] [17592186511655 #edb/ref 1063 #edb/ref 17592186315020 #edb/ref 1