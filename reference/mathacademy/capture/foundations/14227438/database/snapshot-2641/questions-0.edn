 #edb/ref 17592186229174 :knowledge-point/id #uuid "f30ca427-3074-56c3-828a-1327d7b172b0" :knowledge-point/title "Identifying Effects of Vertical Shifting and Horizontal Reflection on Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360a2aae-0860-5d4c-9bf5-4484cdd5104b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}_{4}" :db/id #edb/ref 17592186312411} {:answer/id #uuid "6cd2c601-f75a-5664-bbef-1e5daa7b033c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}_{4}+1" :db/id #edb/ref 17592186312832} {:answer/id #uuid "76bd612d-507b-59b5-9d91-11296e214d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{4}" :db/id #edb/ref 17592186312924} {:answer/id #uuid "b666a993-d14a-58bf-bd13-496ce08cff0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{a}_{4}" :db/id #edb/ref 17592186313390} {:answer/id #uuid "eefb1f19-ef85-5855-89a3-489eb9dc0928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{b}_{4}" :db/id #edb/ref 17592186313882}] :answer-field/correct {:answer/id #uuid "eefb1f19-ef85-5855-89a3-489eb9dc0928" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{b}_{4}" :db/id #edb/ref 17592186313882} :answer-field/id #uuid "042fd6c6-ad22-5265-b9ad-fad4f164704f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314024}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8c05686-6715-5793-92a6-af4818e9ee99" :question/math-academy-id "q-340780" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $f(x)$ be the $2\\pi $-periodic extension of a function from $x\\in [-\\pi ,\\pi )$ to $x\\in R$ with the Fourier series shown above. What is the $4$th sine Fourier coefficient of $f(-x)?$" :question/worked-solution "The Fourier series of $f(x)$ is\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nRecall that the corresponding Fourier coefficients of $f(-x)$ are\n\n- ${a}_{0}$ for the constant coefficient,\n\n- ${a}_{n}$ $n\\ge 1,$ for the cosine coefficients, and\n\n- $-{b}_{n}$ $n\\ge 1,$ for the sine coefficients.\n\nTherefore, the $4$th sine coefficient of $f(-x)$ is $-{b}_{4}.$"}] [{:db/id #edb/ref 17592186548078 :knowledge-point/_questions [{:db/id #edb/ref 17592186229174 :knowledge-point/id #uuid "f30ca427-3074-56c3-828a-1327d7b172b0" :knowledge-point/title "Identifying Effects of Vertical Shifting and Horizontal Reflection on Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd89a27-c4c0-53aa-962f-0e5c6ddbfe2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{a}_{7}" :db/id #edb/ref 17592186547402} {:answer/id #uuid "3f9653b6-553b-589f-934f-3613554f8e73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{7}" :db/id #edb/ref 17592186547456} {:answer/id #uuid "6b2bb11f-802e-5b7e-a5e5-6469b637a4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{b}_{7}" :db/id #edb/ref 17592186547554} {:answer/id #uuid "a403c4cc-8f2a-599c-bbc0-6590042d47dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}_{7}" :db/id #edb/ref 17592186547676} {:answer/id #uuid "e1001811-ea46-5806-9d27-14901ea38eac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}_{7}-1" :db/id #edb/ref 17592186547785}] :answer-field/correct {:answer/id #uuid "6b2bb11f-802e-5b7e-a5e5-6469b637a4cf" :answer/type {:db/id #edb/ref 17592186045498 :db/