f 17592186385249 :knowledge-point/_questions [{:db/id #edb/ref 17592186229175 :knowledge-point/id #uuid "532a73e6-e026-57c9-9bad-57cd2f75b6df" :knowledge-point/title "Parity Recognition and Series Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cc31d3-0a5f-5438-9901-3d29400d9339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186385251} {:answer/id #uuid "f892fb1a-160c-514f-acc7-15a08e9612c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186385252}] :answer-field/correct {:answer/id #uuid "23cc31d3-0a5f-5438-9901-3d29400d9339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186385251} :answer-field/id #uuid "6aa8af8c-ea7f-5240-9b15-8efe9a280fd2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186385250} {:answer-field/choices [{:answer/id #uuid "3b4bad5e-85cd-581a-b7d1-e88b9c75a8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186385254} {:answer/id #uuid "1679e739-2261-5c6b-9566-91034d03b7d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "cosine terms" :db/id #edb/ref 17592186385255}] :answer-field/correct {:answer/id #uuid "3b4bad5e-85cd-581a-b7d1-e88b9c75a8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186385254} :answer-field/id #uuid "aed2ad4f-5183-5142-b383-ac97dc4e9ac6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186385253}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e2d9d40-82f9-50ff-9728-6b0838a55384" :question/math-academy-id "q-340799" :question/problem "Consider the function $f(x)={x}^{2}\\operatorname{cos}⁡(2x)$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the {{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :question/worked-solution "To check whether $f$ is even or odd, we compare $f(-x)$ and $f(x):$\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{2}\\operatorname{cos}⁡(2(-x)) \\\\  & ={x}^{2}\\operatorname{cos}⁡(-2x) \\\\  & ={x}^{2}\\operatorname{cos}⁡(2x) \\\\  & =f(x).\\end{aligned}\n$$\n\nSince $f(-x)=f(x),$ we have that $f$ is even.\n\nFor the Fourier series on $[-\\pi ,\\pi ],$ the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nHere, $f(x)$ is even and $\\operatorname{sin}⁡(nx)$ is odd, so $f(x)\\operatorname{sin}⁡(nx)$ is odd.\n\nNow, the integral of an odd function over $[-\\pi ,\\pi ]$ is $0.$ Thus, ${b}_{n}=0$ for all $n\\ge 1.$\n\nTherefore, the function $f(x)$ is $\\text{even}$ and the $\\text{sine terms}$ in its Fourier series must be zero."}] [{:db/id #edb/ref 17592186547983 :knowledge-point/_questions [{:db/id #edb/ref 17592186229175 :knowledge-point/id #uuid "532a73e6-e026-57c9-9bad-57cd2f75b6df" :knowledge-point/title "Parity Recognition and Series Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403a5171-c76a-585a-8404-59d8cf8da5e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186547459} {:answer/id #uuid "d039172d-a4c1-57bd-9a38-a0c72987e9c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "cosine terms" :db/id #edb/ref 17592186547762}] :answer-field/correct {:answer/id #uuid "d039172d-a4c1-57bd-9a38-a0c72987e9c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answe