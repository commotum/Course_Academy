</mjx-mrow></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">L</mi></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>t</mi><mo>−</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>⋅</mo><mi>sin</mi><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>3</mn><mi>t</mi><mo>−</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>2</mn></mfrac><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn><mo stretchy=\"false\">)</mo><mi>s</mi></mrow></msup><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">L</mi></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mi>sin</mi><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>3</mn><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>t</mi><mo>+</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>2</mn></mfrac><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn><mo stretchy=\"false\">)</mo><mi>s</mi></mrow></msup><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-calligraphic\" mathvariant=\"script\">L</mi></mrow><mo fence=\"false\" stretchy=\"false\">{</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>t</mi><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn><mo stretchy=\"false\">)</mo><mi>s</mi></mrow></msup><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mrow><msup><mi>s</mi><mn>2</mn></msup><mo>+</mo><mn>9</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>π</mi><mi>s</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mi>s</mi><mn>2</mn></msup><mo>+</mo><mn>9</mn></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, we substitute these back into our transformed differential equation:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"44\" style=\"font-size: 119.4%; position: relative;\"><