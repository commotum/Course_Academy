t=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msup></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
