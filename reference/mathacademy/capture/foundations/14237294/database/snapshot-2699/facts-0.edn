T} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}{(\\begin{bmatrix}1 & 2 & -3\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & 2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}\\cdot (14)^{-1}\\begin{bmatrix}1 & 2 & -3\\end{bmatrix} \\\\  & =\\frac{1}{14}\\begin{bmatrix}1 \\\\ 2 \\\\ -3\\end{bmatrix}\\begin{bmatrix}1 & 2 & -3\\end{bmatrix} \\\\  & =\\frac{1}{14}\\begin{bmatrix}1 & 2 & -3 \\\\ 2 & 4 & -6 \\\\ -3 & -6 & 9\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186133600 #edb/ref 1069 "e-5578" #edb/ref 17592186045417] [17592186133600 #edb/ref 1071 "Which of the following are orthogonal projection matrices?\n\n![](images/13/13213fe5fbeaaa288ba5dadeadf50e24d8b285f4641c3291c90b45352249f8ec.svg)" #edb/ref 17592186045417] [17592186133600 #edb/ref 1072 #uuid "5f72c4ca-3bd8-5398-8dc4-ee790127f844" #edb/ref 17592186045417] [17592186133600 #edb/ref 1074 "Recall that $Q$ is an orthogonal projection matrix if and only if $Q^2=Q$ and $Q^T=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n$A^T = A$\nbut \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 5 \\\\ 5 & 10\\end{bmatrix} \\\\  & \\ne A.\\end{aligned}\n$$\n\n- $B$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{B}^{T}\\ne B.\\end{aligned}\n$$\n\n- $C$ is an orthogonal projection matrix. Indeed,\n$C^T = C$\nand\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{bmatrix}\\begin{bmatrix}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\frac{1}{25}\\begin{bmatrix}20 & 10 \\\\ 10 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{5} & \\frac{2}{5} \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{bmatrix} \\\\  & =C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$C$ only.\"" #edb/ref 17592186045443] [17592186133601 #edb/ref 1069 "e-5580" #edb/ref 17592186045417] [17592186133601 #edb/ref 1071 "![](images/66/662db584d066906126cb4e247ccd39e286a46bad59a383931dca8a35cdbcb53d.svg)\nGiven that the vector $\\mathbf{a}$ above spans $S^\\perp,$ and that $P$ is the orthogonal projection matrix of $\\mathbb{R}^3$ onto the subspace $S$, what is the value of $p_{13} + p_{32}?$" #edb/ref 17592186045417] [17592186133601 #edb/ref 1072 #uuid "ac4c3c85-2831-57b2-bef7-5be9c61ea365" #edb/ref 17592186045417] [17592186133601 #edb/ref 1074 "First, we find the orthogonal projection matrix onto $S^\\perp = \\textrm{Span}\\{\\mathbf{a}\\}.$\n\nUsing the formula for the orthogonal projection matrix\n\n$$\nP_{S^\\perp} = \\mathbf{a} (\\mathbf{a}^T\\!\\mathbf{a})^{-1} \\mathbf{a}^T,\n$$\n\nwe obtain the following:\n\n$$\n\\begin{aligned}{P}_{{S}^{⊥}} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}{(\\begin{bmatrix}1 & 1 & 2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & 1 & 2\\end{bmatrix} \\\\  & ={6}^{-1}\\begin{bmatrix}1 \\\\ 1 \\\\ 2\\end{bmatrix}\\begin{bmatrix}1 & 1 & 2\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & 1 & 2 \\\\ 1 & 1 & 2 \\\\ 2 & 2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nRecall that $P_S  + P_{S^\\perp} = I.$ Therefore, \n\n$$\n\\begin{aligned}{P}_{S} & =I-{P}_{{S}^{⊥}} \\\\  & =I-\\frac{1}{6}\\begin{bmatrix}1 & 1 & 2 \\\\ 1 & 1 & 2 \\\\ 2 & 2 & 4\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}5 & -1 & -2 \\\\ -1 & 5 & -2 \\\\ -2 & -2 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $p_{13} + p_{32} = (-2) + (-2) = -4.$" #edb/ref 17592186045443] [17592186133676 #edb/ref 1069 "e-8316" #edb/ref 17592186045417] [17592186133676 #edb/ref 1071 "Find a matrix that defines the orthogonal projection of $\\mathbb{R}^3$ onto the plane whose parametric equation is $\\mathbf{r}=s\\mathbf{v} + t\\mathbf{w}$, where\n![](images/79/79765ab48a76c8f3d5ed1f4c35be519cf0f928c0622e3b7a0319b522395ccb86.svg)" #edb/ref 17592186045417] [17592186133676 #edb/ref 1072 #uuid "57eab3ab-095d-5ba4-b071-7053e7a7df0d" #edb/ref 17592186045417] [17592186133676 #edb/ref 1074 "Recall that the matrix $P_S = A(A^T\\!A)^{-1}\\!A^T$ maps any vector $\\mathbf x\\in \\mathbb{R}^n$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $\\mathbf{r}=s\\mathbf{v}+t\\mathbf{w}$ is actually the subspace $\\text{Span}\\{\\mathbf{v}, \\mathbf{w}\\}.$ \nHence, we have \n![](images/7d/7d7d41e02a65634517225adc2736cef6ebce4056bb6feca1ac3b9e9e865c7927.svg)\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{bmatrix}{(\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{bmatrix})}^{-1}\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{bmatrix}{\\begin{bmatrix}6 & 0 \\\\ 0 & 3\\end{bmatrix}}^{-1}\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 & 1 \\\\ 1 & -1 & 1\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & 1 \\\\ 2 & -1 \\\\ 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 & 1 \\\\ 2 & -2 & 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186133790 #edb/ref 1037 #edb/ref 17592186049970 #edb/ref 17592186045417] [17592186133790 #edb/ref 1038 #edb/ref 17592186134253