5615-b660-6b8705f12fef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d4d0ee-ad5b-53e7-956e-b02eb6cf177b" :question/math-academy-id "q-106901" :question/problem "Which of the following vector spaces has a dimension of $20?$\n- **I.** ${R}_{20}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $20$\n- **II.** ${\\text{M}}_{4\\times 5}(R),$ the vector space of all $4\\times 5$ matrices over $R$\n- **III.** ${R}^{20}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{20}[t])=20+1=21\\ne 20.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{4\\times 5}(R))=4\\cdot 5=20.\\,✓\n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{20})=20.\\,✓\n$$\n\nHence, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186364723 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54cbfca0-bff0-52dc-a7d3-f7f9ea5acb20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468858} {:answer/id #uuid "ab8db7bb-912a-549b-8dc7-d4e68d879053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468859}] :answer-field/correct {:answer/id #uuid "ab8db7bb-912a-549b-8dc7-d4e68d879053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468859} :answer-field/id #uuid "cc9b4d17-b28a-526f-8892-83a499708178" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470041} {:answer-field/choices [{:answer/id #uuid "5c5112c1-4747-5e8b-a12b-430126d5ce9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468860} {:answer/id #uuid "cb8614be-f12e-5507-b395-aa4a960dd2ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468861}] :answer-field/correct {:answer/id #uuid "5c5112c1-4747-5e8b-a12b-430126d5ce9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468860} :answer-field/id #uuid "e370841a-5acd-57e5-9802-a92d25d0133e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470042} {:answer-field/choices [{:answer/id #uuid "ae1bff07-aba3-5a99-aece-07d510737e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468862} {:answer/id #uuid "1a402636-9d56-5283-8679-8961a991afe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468863}] :answer-field/correct {:answer/id #uuid "ae1bff07-aba3-5a99-aece-07d510737e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468862} :answer-field/id #uuid "ea2f7538-5026-507b-a35a-db7e12ed1e93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a2340ea-4d69-565f-a0a6-1a2327573430" :question/math-academy-id "q-106904" :question/problem "Which of the following vector spaces has a dimension of $11?$\n- **I.** ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10$\n- **II.** ${\\text{M}}_{2\\times 6}(R),$ the vector space of all $2\\times 6$ matrices over $R$\n- **III.** ${R}^{10}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11.\\,✓\n$$\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{2\\times 6}(R))=2\\cdot 6=12\\ne 11.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{10})=10\\ne 11.\\,\\times \n$$\n\nHence, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186484202 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "669a7248-1c24-559e-a71d-8f66e1746ab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483765} {:answer/id #uuid "a5afe100-53bc-582e-9c9d-51b2ca9a2fb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483907} {:answer/id #uuid "be9800d0-e10b-5f0a-8dcc-401127133dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186483945} {:answer/id #uuid "f7a5cf94-9e7a-57f8-8988-e47dd72afd09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186484067} {:answer/id #uuid "fab28ac9-0f5f-5bb6-a39e-cad6000f1dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186484074}] :answer-field/correct {:answer/id #uuid "a5afe100-53bc-582e-9c9d-51b2ca9a2fb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483907} :answer-field/id #uuid "457c1e5e-1340-5563-b21f-d892f440444e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "133975da-da96-5b76-a610-069fd7ba3c88" :question/math-academy-id "q-106908" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${R}^{900}$\n\nII. ${R}_{100}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $100$\n\nIII. ${R}^{\\infty },$ the vector space of infinite real sequences" :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}^{900}$ and  and ${R}_{100}[t]$ are finite-dimensional. Indeed,  are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{900})=900,\n$$\n\nand\nand\n\n$$\n\\text{dim}({R}_{100}[t])=100+1=101,\n$$\n\nare both finite numbers.\n\n- ${R}^{\\infty }$ is *not* finite-dimensional. To understand why, we first note that the following set of sequences is linearly independent:\n\n$$\n\\{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}\\},\\,n\\in N\n$$\n\nwhere, for each $j\\in \\{1,2,…,n\\},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${R}^{\\infty }$ of size $n,$ which imples that  ${R}^{\\infty }$ cannot have finite dimension.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186484260 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32025752-fc90-5834-aa8b-8e70dd161592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483654} {:answer/id #uuid "6d339a4e-134e-50dd-8fbb-27d20a2bb9c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186483780} {:answer/id #uuid "8643fec9-a9a9-51c6-9add-31f52b9fd94d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483842} {:answer/id #uuid "b394bbca-ed45-583f-bd47-032af78ad067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186483924} {:answer/id #uuid "f11b8019-3e51-51f6-9dd1-eea212aff2ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186484046}] :answer-field/correct {:answer/id #uuid "b394bbca-ed45-583f-bd47-032af78ad067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186483924} :answer-field/id #uuid "fdbac630-16a8-5c87-bde5-a8a5e299fc15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a563102c-022c-5259-8c2a-2cd56b2b3d49" :question/math-academy-id "q-106910" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. $C[0,1],$ the vector space of all continuous functions $f:[0,1]\\to R$\n\nII. ${\\text{M}}_{200\\times 300}(R),$ the vector space of all $200\\times 300$ matrices over $R$\n\nIII. ${R}_{20}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $20$" :question/worked-solution "Let's examine our vector spaces.\n\n- $C[0,1]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in [0,1]$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $C[0,1]$ of size $n,$ which imples that $C[0,1]$ cannot have finite dimension.\n\n- ${\\text{M}}_{200\\times 300}(R)$ and ${R}_{20}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{200\\times 300}(R))=200\\cdot 300=60\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{20}[t])=20+1=21\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186243979 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101d4aef-a0cb-5f59-804c-2d0912201356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461485} {:answer/id #uuid "79a8eb56-c474-574e-bfc9-b522256a029e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461486}] :answer-field/correct {:answer/id #uuid "101d4aef-a0cb-5f59-804c-2d0912201356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.