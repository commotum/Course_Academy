],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{6\\times 4}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{6\\times 4}(R))=6\\cdot 4=24.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"}] [{:db/id #edb/ref 17592186360584 :knowledge-point/_questions [{:db/id #edb/ref 17592186152222 :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19295612-c37d-5d12-a2bd-d9e3d3190165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186357973} {:answer/id #uuid "43d957d6-a406-5fc0-89ac-e558f5385934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186358332} {:answer/id #uuid "8291e989-30da-596c-9329-97f50fc939b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186358897} {:answer/id #uuid "840d738a-d64e-59df-aa33-1da6f0865be3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186358913} {:answer/id #uuid "906172b7-c7a4-5308-bdb0-d00e129149b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186359012}] :answer-field/correct {:answer/id #uuid "19295612-c37d-5d12-a2bd-d9e3d3190165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186357973} :answer-field/id #uuid "fa0266e5-db5e-546e-b