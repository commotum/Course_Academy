b/ref 17592186484288 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388f7644-62de-5c89-93cb-4b95a7747960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186483670} {:answer/id #uuid "72eff4f6-5faa-5d17-b12d-0ca5555b029f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186483795} {:answer/id #uuid "8586c54e-4169-569b-9fa7-9db12b01e5e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483837} {:answer/id #uuid "a4629518-5170-52ce-9635-bfa24990c2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483906} {:answer/id #uuid "f0c74f33-a5ae-56ed-a34e-bcb965e674d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186484045}] :answer-field/correct {:answer/id #uuid "388f7644-62de-5c89-93cb-4b95a7747960" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186483670} :answer-field/id #uuid "43f70436-d419-5c52-ab3f-3c077ef9f332" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484110}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec7f0e0d-aeea-55dc-8d79-107780421320" :question/math-academy-id "q-95223" :question/problem "Which of the following vector spaces has a dimension of $49?$\n\nI. ${R}_{7}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $7$\n\nII. ${R}^{7}$\n\nIII. ${\\text{M}}_{7}(R),$ the vector space of all $7\\times 7$ matrices over $R$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\nI. Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n  $$\n  \\text{dim}({R}_{7}[t])=7+1=8\\ne 49.\\,\\times \n  $$\n\nII. Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n  $$\n  \\text{dim}({R}^{7})=7\\ne 49.\\,\\times \n  $$\n\nIII. Recall that $\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.$ Therefore, \n\n  $$\n  \\text{dim}({\\text{M}}_{7}(R))={7}^{2}=49.\\,✓\n  $$\n\nHence, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186360590 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021e2b2f-1cfa-5e7f-a34a-b7f2570312cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469758} {:answer/id #uuid "bdb72ca2-146b-5bb8-8385-38863e97843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469759}] :answer-field/correct {:answer/id #uuid "bdb72ca2-146b-5bb8-8385-38863e97843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469759} :answer-field/id #uuid "29eb04aa-7838-546a-bb99-32c656373b29" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470491} {:answer-field/choices [{:answer/id #uuid "4771ff23-e6f3-5c09-9038-6c2677900baa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469760} {:answer/id #uuid "e7201a40-a402-5dd1-be24-316d02c7b70f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469761}] :answer-field/correct {:answer/id #uuid "e7201a40-a402-5dd1-be24-316d02c7b70f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469761} :answer-field/id #uuid "67e735b4-4170-55a6-b050-658c79ff7a90" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470492} {:answer-field/choices [{:answer/id #uuid "0d82bb2f-ac86-5000-956c-61719812870d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469762} {:answer/id #uuid "e939c23c-8529-587d-843f-30d45e082086" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469763}] :answer-field/correct {:answer/id #uuid "e939c23c-8529-587d-843f-30d45e082086" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469763} :answer-field/id #uuid "0531dddc-ea4a-5f2c-bd79-4fdd1a0039fc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470493}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e94aa3d-a675-513e-b4ce-d62e1028540d" :question/math-academy-id "q-95240" :question/problem "Which of the following vector spaces are finite-dimensional?\n- **I.** ${R}_{1000}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $1\\,000$\n- **II.** ${\\text{M}}_{200\\times 500}(R),$ the vector space of all $200\\times 500$ matrices over $R$\n- **III.** $C,$ as a vector space over $R$\n\nSelect all that apply." :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}_{1000}[t]$ and ${\\text{M}}_{200\\times 500}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}_{1000}[t])=1\\,000+1=1\\,001,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{200\\times 500}(R))=200\\cdot 500=100\\,000\n$$\n\n \nare both finite numbers.\n\n- $C$ is also finite-dimensional. To understand why, we first note that the following set of complex numbers is linearly independent:\n\n$$\n{1,i}\n$$\n\nIndeed, we have that \n\n$$\na\\cdot 1+b\\cdot i=0\n$$\n\nif and only if $a=0$ and $b=0.$ Since our vector space is also spanned by this linearly independent subset, we have that $\\text{dim}(C)=2.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186484277 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07489262-ab19-5dda-972d-e7af5c99c210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483584} {:answer/id #uuid "6cd2b2ce-60d3-5125-a64e-47ec4eab3fe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186483779} {:answer/id #uuid "8661c4e6-413f-5971-8bb1-f2120409cbb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186483844} {:answer/id #uuid "ceda1b10-888b-5a36-94a5-72930f4ae57e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483984} {:answer/id #uuid "f1a57b3a-1a45-5832-a308-b6c6f9235735" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186484049}] :answer-field/correct {:answer/id #uuid "07489262-ab19-5dda-972d-e7af5c99c210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483584} :answer-field/id #uuid "97097530-2c80-53fc-9378-f2df46ce5c98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf79cbf5-5d8d-5861-a04b-30929c364cf0" :question/math-academy-id "q-95385" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${\\text{M}}_{400}(R),$ the vector space of all $400\\times 400$ matrices over $R$\n\nII. $C[-1,1],$ the vector space of all continuous functions $f:[-1,1]\\to R$\n\nIII. ${R}^{400}$" :question/worked-solution "Let's examine our vector spaces.\n\n- $C[-1,1]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in [-1,1]$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $C[-1,1]$ of size $n,$ which imples that $C[-1,1]$ cannot have finite dimension.\n\n- ${\\text{M}}_{400}(R)$ and ${R}^{400}$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{400}(R))={400}^{2}=160\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}^{400})=400\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"I and III only.\""}]}
