#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186153161} :activity/id #uuid "656cb00f-9a01-5d98-b674-14d57dda7e9a" :activity/scope {:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759} :activity/steps [{:db/id #edb/ref 17592186153161 :step/content {:db/id #edb/ref 17592186153408 :tutorial/content "The standard basis of the vector space $\\mathbb{R}_2[t]$ of all polynomials in the variable $t$ over $\\mathbb{R}$ with degree at most $2$ is \n\n$$\n\\{1, \\: t, \\: t^2\\}.\n$$\n\nAnother basis of $\\mathbb{R}_2[t]$ is\n\n$$\n\\big\\{ t^2-1, \\: t+3, \\: 2t-1 \\big\\}.\n$$\n\nIn general, vector spaces have infinitely many bases. \n\nLet's now consider the following theorem:\n\n*If a basis of a vector space $V$ has $n$ elements, then every basis of $V$ has $n$ elements.*\n\nThe number $n$ is called the **dimension** of the vector space, and we write $\\textrm{dim}(V)=n.$\n\nSo, since the standard basis of $\\mathbb{R}_2[t]$ has $3$ elements, all of its bases have $3$ elements, and we write\n\n$$\n\\textrm{dim}(\\mathbb{R}_2[t])=3.\n$$" :tutorial/id #uuid "91a87b01-a3a9-5fd9-865d-2e7fa9fb4636" :tutorial/math-academy-id 4971 :tutorial/title "Introduction"} :step/id #uuid "1c281721-48ee-5e84-901c-07d72bf77044" :step/math-academy-id 653421 :step/next {:db/id #edb/ref 17592186153162}} {:db/id #edb/ref 17592186153162 :step/content {:db/id #edb/ref 17592186152219 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152029 :question/id #uuid "2bcc7bb9-1b5e-5858-811d-1e5c14f0bc29" :question/math-academy-id "e-8288"} :knowledge-point/id #uuid "2a8bf202-99c5-5bfd-8df3-5bd27cd65640" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048218} {:db/id #edb/ref 17592186048552}] :knowledge-point/questions [{:db/id #edb/ref 17592186152584} {:db/id #edb/ref 17592186152875} {:db/id #edb/ref 17592186243970} {:db/id #edb/ref 17592186243971} {:db/id #edb/ref 17592186397856} {:db/id #edb/ref 17592186397863} {:db/id #edb/ref 17592186484197} {:db/id #edb/ref 17592186484206} {:db/id #edb/ref 17592186484214} {:db/id #edb/ref 17592186484265}] :knowledge-point/title "Determining the Dimension of a Polynomial Vector Space Given Its Standard Monomial Basis"} :step/id #uuid "977a3893-c3c0-5448-ab25-3271a4a3a0ff" :step/math-academy-id 653422 :step/next {:db/id #edb/ref 17592186153166}} {:db/id #edb/ref 17592186153163 :step/content {:db/id #edb/ref 17592186152220 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152030 :question/id #uuid "e1ae146f-04ae-5662-9ea3-178a23b3c366" :question/math-academy-id "e-8289"} :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/questions [{:db/id #edb/ref 17592186152586} {:db/id #edb/ref 17592186152587} {:db/id #edb/ref 17592186243975} {:db/id #edb/ref 17592186243976} {:db/id #edb/ref 17592186243977} {:db/id #edb/ref 17592186360587} {:db/id #edb/ref 17592186360588} {:db/id #edb/ref 17592186364723} {:db/id #edb/ref 17592186484271} {:db/id #edb/ref 17592186484288} {:db/id #edb/ref 17592186484294}] :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"} :step/id #uuid "32c06dcf-98e2-59eb-83b8-eaa3a8573b55" :step/math-academy-id 653428 :step/next {:db/id #edb/ref 17592186153164}} {:db/id #edb/ref 17592186153164 :step/content {:db/id #edb/ref 17592186153409 :tutorial/content "When a vector space $V$ has a finite dimension $\\textrm{dim}(V) = n < \\infty,$ the vector space is **finite-dimensional**.\n\nSome vector spaces can have arbitrarily large linearly independent sets. In such cases, the vector space is **infinite-dimensional**.\n\nAn example of an infinite-dimensional vector space is the space of all continuous functions $C(\\mathbb{R})$ defined on $f : \\mathbb{R} \\to \\mathbb{R}.$\n\nTo understand why $C(\\mathbb{R})$ is an infinite-dimensional vector space, we note that for any positive integer $n,$ the following set of continuous functions is linearly independent:\n\n$$\n\\big\\{ 1, \\: t, \\: t^2, \\: \\ldots, t^n \\big\\}\n$$\n\nIndeed, we have that\n\n$$\n\\sum\\limits_{i=0}^n x_i t^i = 0\n$$\n\nfor all $t\\in\\mathbb{R}$ if and only if $x_i=0$ for all $i=0,1,2,\\ldots,n.$ Since $n$ can be arbitrarily large, our vector space cannot have finite dimension." :tutorial/id #uuid "cdc61d9a-3a5b-5d82-b2f8-17ebc848ac95" :tutorial/math-academy-id 4972 :tutorial/title "Infinite-Dimensional Vector Spaces"} :step/id #uuid "17e7956b-85c4-535f-b3e9-ef87f6a27c75" :step/math-academy-id 653431 :step/next {:db/id #edb/ref 17592186153165}} {:db/id #edb/ref 17592186153165 :step/content {:db/id #edb/ref 17592186152221 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152031 :question/id #uuid "6d2ba662-f58e-56ec-bf87-c1f26c12c1c1" :question/math-academy-id "e-8290"} :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/questions [{:db/id #edb/ref 17592186152873} {:db/id #edb/ref 17592186152876} {:db/id #edb/ref 17592186243979} {:db/id #edb/ref 17592186360589} {:db/id #edb/ref 17592186360590} {:db/id #edb/ref 17592186360591} {:db/id #edb/ref 17592186360600} {:db/id #edb/ref 17592186364730} {:db/id #edb/ref 17592186366608} {:db/id #edb/ref 17592186484202} {:db/id #edb/ref 17592186484260} {:db/id #edb/ref 17592186484277}] :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"} :step/id #uuid "7a4fa43c-f576-546c-b417-c6b36b6e838e" :step/math-academy-id 653432} {:db/id #edb/ref 17592186153166 :step/content {:db/id #edb/ref 17592186152222 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152032 :question/id #uuid "61fa85c6-5b27-5f81-a7ba-363eb68e8d3e" :question/math-academy-id "e-8315"} :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/questions [{:db/id #edb/ref 17592186152585} {:db/id #edb/ref 17592186152874} {:db/id #edb/ref 17592186360584} {:db/id #edb/ref 17592186360585} {:db/id #edb/ref 17592186360586} {:db/id #edb/ref 17592186397870} {:db/id #edb/ref 17592186397877} {:db/id #edb/ref 17592186399282} {:db/id #edb/ref 17592186484212} {:db/id #edb/ref 17592186484285}] :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"} :step/id #uuid "cb8f5e62-9e00-5ea4-b454-29f57b6bd487" :step/math-academy-id 653425 :step/next {:db/id #edb/ref 17592186153163}}] :activity/title "Dimension in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152367}]}
