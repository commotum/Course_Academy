e-5e0e-9720-49e89128d035" #edb/ref 17592186045417] [17592186484182 #edb/ref 1075 #edb/ref 17592186483636 #edb/ref 17592186045417] [17592186484182 #edb/ref 1075 #edb/ref 17592186483640 #edb/ref 17592186045417] [17592186484182 #edb/ref 1075 #edb/ref 17592186483649 #edb/ref 17592186045417] [17592186484182 #edb/ref 1075 #edb/ref 17592186483946 #edb/ref 17592186045417] [17592186484182 #edb/ref 1075 #edb/ref 17592186484078 #edb/ref 17592186045417] [17592186484182 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186484182 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186484182 #edb/ref 1078 #edb/ref 17592186483649 #edb/ref 17592186045417] [17592186484182 #edb/ref 1079 #uuid "d7065f58-a8b6-53db-ba79-b62ee1013bc0" #edb/ref 17592186045417] [17592186484186 #edb/ref 1075 #edb/ref 17592186483651 #edb/ref 17592186045417] [17592186484186 #edb/ref 1075 #edb/ref 17592186483692 #edb/ref 17592186045417] [17592186484186 #edb/ref 1075 #edb/ref 17592186483731 #edb/ref 17592186045417] [17592186484186 #edb/ref 1075 #edb/ref 17592186483809 #edb/ref 17592186045417] [17592186484186 #edb/ref 1075 #edb/ref 17592186483975 #edb/ref 17592186045417] [17592186484186 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186484186 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186484186 #edb/ref 1078 #edb/ref 17592186483975 #edb/ref 17592186045417] [17592186484186 #edb/ref 1079 #uuid "ebc4ac2a-43cd-5a9b-b9bf-122a9819ccdf" #edb/ref 17592186045417] [17592186484191 #edb/ref 1075 #edb/ref 17592186483654 #edb/ref 17592186045417] [17592186484191 #edb/ref 1075 #edb/ref 17592186483780 #edb/ref 17592186045417] [17592186484191 #edb/ref 1075 #edb/ref 17592186483842 #edb/ref 17592186045417] [17592186484191 #edb/ref 1075 #edb/ref 17592186483924 #edb/ref 17592186045417] [17592186484191 #edb/ref 1075 #edb/ref 17592186484046 #edb/ref 17592186045417] [17592186484191 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186484191 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186484191 #edb/ref 1078 #edb/ref 17592186483924 #edb/ref 17592186045417] [17592186484191 #edb/ref 1079 #uuid "fdbac630-16a8-5c87-bde5-a8a5e299fc15" #edb/ref 17592186045417] [17592186484197 #edb/ref 1068 #edb/ref 17592186484107 #edb/ref 17592186045417] [17592186484197 #edb/ref 1069 "q-95213" #edb/ref 17592186045417] [17592186484197 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484197 #edb/ref 1071 "What is the dimension of ${R}_{11}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $11?$" #edb/ref 17592186045417] [17592186484197 #edb/ref 1072 #uuid "097f3ed9-cfa8-5b5e-b19c-f247430007b1" #edb/ref 17592186045417] [17592186484197 #edb/ref 1074 "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{11}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{11}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{11}[t])=11+1=12.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" #edb/ref 17592186045417] [17592186484202 #edb/ref 1068 #edb/ref 17592186484112 #edb/ref 17592186045417] [17592186484202 #edb/ref 1069 "q-106908" #edb/ref 17592186045417] [17592186484202 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484202 #edb/ref 1071 "Which of the following vector spaces are finite-dimensional?\n\nI. ${R}^{900}$\n\nII. ${R}_{100}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $100$\n\nIII. ${R}^{\\infty },$ the vector space of infinite real sequences" #edb/ref 17592186045417] [17592186484202 #edb/ref 1072 #uuid "133975da-da96-5b76-a610-069fd7ba3c88" #edb/ref 17592186045417] [17592186484202 #edb/ref 1074 "Let's examine our vector spaces.\n\n- ${R}^{900}$ and  and ${R}_{100}[t]$ are finite-dimensional. Indeed,  are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{900})=900,\n$$\n\nand\nand\n\n$$\n\\text{dim}({R}_{100}[t])=100+1=101,\n$$\n\nare both finite numbers.\n\n- ${R}^{\\infty }$ is *not* finite-dimensional. To understand why, we first note that the following set of sequences is linearly independent:\n\n$$\n\\{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}\\},\\,n\\in N\n$$\n\nwhere, for each $j\\in \\{1,2,…,n\\},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${R}^{\\infty }$ of size $n,$ which imples that  ${R}^{\\infty }$ cannot have finite dimension.\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186484206 #edb/ref 1068 #edb/ref 17592186484172 #edb/ref 17592186045417] [17592186484206 #edb/ref 1069 "q-95209" #edb/ref 17592186045417] [17592186484206 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484206 #edb/ref 1071 "What is the dimension of ${R}_{12}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $12?$" #edb/ref 17592186045417] [17592186484206 #edb/ref 1072 #uuid "2f4f1592-f4a6-5a3b-9667-d0da6a6cffb4" #edb/ref 17592186045417] [17592186484206 #edb/ref 1074 "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{12}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{12}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{12}[t])=12+1=13.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" #edb/ref 17592186045417] [17592186484212 #edb/ref 1068 #edb/ref 17592186484182 #edb/ref 17592186045417] [17592186484212 #edb/ref 1069 "q-95219" #edb/ref 17592186045417] [17592186484212 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484212 #edb/ref 1071 "What is the dimension of ${\\text{M}}_{9}(R),$ the vector space of all $9\\times 9$ matrices over $R?$" #edb/ref 17592186045417] [17592186484212 #edb/ref 1072 #uuid "3c2b1907-307d-594c-b98e-a2835933e73a" #edb/ref 17592186045417] [17592186484212 #edb/ref 1074 "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{9}(R))={9}^{2}=81.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$" #edb/ref 17592186045417] [17592186484214 #edb/ref 1068 #edb/ref 17592186484094 #edb/ref 17592186045417] [17592186484214 #edb/ref 1069 "q-95212" #edb/ref 17592186045417] [17592186484214 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484214 #edb/ref 1071 "What is the dimension of ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10?$" #edb/ref 17592186045417] [17592186484214 #edb/ref 1072 #uuid "3d3c2164-c9a8-58f5-b6ac-e24eb41f738f" #edb/ref 17592186045417] [17592186484214 #edb/ref 1074 "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{10}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{10}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" #edb/ref 17592186045417] [17592186484260 #edb/ref 1068 #edb/ref 17592186484191 #edb/ref 17592186045417] [17592186484260 #edb/ref 1069 "q-106910" #edb/ref 17592186045417] [17592186484260 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484260 #edb/ref 1071 "Which of the following vector spaces are finite-dimensional?\n\nI. $C[0,1],$ the vector space of all continuous functions $f:[0,1]\\to R$\n\nII. ${\\text{M}}_{200\\times 300}(R),$ the vector space of all $200\\times 300$ matrices over $R$\n\nIII. ${R}_{20}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $20$" #edb/ref 17592186045417] [17592186484260 #edb/ref 1072 #uuid "a563102c-022c-5259-8c2a-2cd56b2b3d49" #edb/ref 17592186045417] [17592186484260 #edb/ref 1074 "Let's examine our vector spaces.\n\n- $C[0,1]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in [0,1]$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $C[0,1]$ of size $n,$ which imples that $C[0,1]$ cannot have finite dimension.\n\n- ${\\text{M}}_{200\\times 300}(R)$ and ${R}_{20}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{200\\times 300}(R))=200\\cdot 300=60\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{20}[t])=20+1=21\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186484265 #edb/ref 1068 #edb/ref 17592186484186 #edb/ref 17592186045417] [17592186484265 #edb/ref 1069 "q-95211" #edb/ref 17592186045417] [17592186484265 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484265 #edb/ref 1071 "What is the dimension of ${R}_{4}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $4?$" #edb/ref 17592186045417] [17592186484265 #edb/ref 1072 #uuid "aae52b85-1a03-58d9-a743-b61980bd2082" #edb/ref 17592186045417] [17592186484265 #edb/ref 1074 "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{4}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,{t}^{3},\\,{t}^{4}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{4}[t])=5.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" #edb/ref 17592186045417] [17592186484271 #edb/ref 1068 #edb/ref 17592186484133 #edb/ref 17592186045417] [17592186484271 #edb/ref 1069 "q-106898" #edb/ref 17592186045417] [17592186484271 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484271 #edb/ref 1071 "Which of the following vector spaces has a dimension of $15?$\n\nI. ${R}^{14}$\n\nII. ${\\text{M}}_{3\\times 5}(R),$ the vector space of all $3\\times 5$ matrices over $R$\n\nIII. ${R}_{14}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $14$" #edb/ref 17592186045417] [17592186484271 #edb/ref 1072 #uuid "c2dac37f-1586-5572-8aef-afd7b8fea459" #edb/ref 17592186045417] [17592186484271 #edb/ref 1074 "Let's examine each of the vector spaces in turn.\n\nI. Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n  $$\n  \\text{dim}({R}^{14})=14\\ne 15.\\,\\times \n  $$\n\nII. Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n  $$\n  \\text{dim}({\\text{M}}_{3\\times 5}(R))=3\\cdot 5=15.\\,✓\n  $$\n\nIII. Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n  $$\n  \\text{dim}({R}_{14}[t])=14+1=15.\\,✓\n  $$\n\nHence, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186484277 #edb/ref 1068 #edb/ref 17592186484158 #edb/ref 17592186045417] [17592186484277 #edb/ref 1069 "q-95385" #edb/ref 17592186045417] [17592186484277 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484277 #edb/ref 1071 "Which of the following vector spaces are finite-dimensional?\n\nI. ${\\text{M}}_{400}(R),$ the vector space of all $400\\times 400$ matrices over $R$\n\nII. $C[-1,1],$ the vector space of all continuous functions $f:[-1,1]\\to R$\n\nIII. ${R}^{400}$" #edb/ref 17592186045417] [17592186484277 #edb/ref 1072 #uuid "cf79cbf5-5d8d-5861-a04b-30929c364cf0" #edb/ref 17592186045417] [17592186484277 #edb/ref 1074 "Let's examine our vector spaces.\n\n- $C[-1,1]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in [-1,1]$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $C[-1,1]$ of size $n,$ which imples that $C[-1,1]$ cannot have finite dimension.\n\n- ${\\text{M}}_{400}(R)$ and ${R}^{400}$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{400}(R))={400}^{2}=160\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}^{400})=400\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045417] [17592186484285 #edb/ref 1068 #edb/ref 17592186484126 #edb/ref 17592186045417] [17592186484285 #edb/ref 1069 "q-95214" #edb/ref 17592186045417] [17592186484285 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484285 #edb/ref 1071 "What is the dimension of ${\\text{M}}_{5\\times 7}(R),$ the vector space of all $5\\times 7$ matrices over $R?$" #edb/ref 17592186045417] [17592186484285 #edb/ref 1072 #uuid "e90af7eb-4ed1-5ce3-8ebf-5e64d3a26828" #edb/ref 17592186045417] [17592186484285 #edb/ref 1074 "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 