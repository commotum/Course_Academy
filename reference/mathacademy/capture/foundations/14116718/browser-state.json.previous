  "live_records": {
    "q-35260": {
      "dom_id": "step-q35260",
      "name": "Question 1",
      "problem": "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=5{b}_{2}$ and ${c}_{2}=-3{b}_{1}?$",
      "worked_solution": "Since $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-5{b}_{2} \\\\  & =-5{b}_{2}+{b}_{1} \\\\  & =-(5{b}_{2})-(-{b}_{1}) \\\\  & =-(5{b}_{2})-\\frac{1}{3}(-3{b}_{1}) \\\\  & =-{c}_{1}-\\frac{1}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-1 \\\\ -\\frac{1}{3}\\end{aligned}].$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-35260-a",
