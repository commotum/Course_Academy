1},{c}_{2}},$ where ${c}_{1}=5{b}_{2}$ and ${c}_{2}=4{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}3 \\\\ -7\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =3{b}_{1}-7{b}_{2} \\\\  & =-7{b}_{2}+3{b}_{1} \\\\  & =-\\frac{7}{5}(5{b}_{2})+\\frac{3}{4}(4{b}_{1}) \\\\  & =-\\frac{7}{5}{c}_{1}+\\frac{3}{4}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{7}{5} \\\\ \\frac{3}{4}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186410059 :knowledge-point/_questions [{:db/id #edb/ref 17592186119823 :knowledge-point/id #uuid "29b27833-e930-5339-89b3-c5651d791dcd" :knowledge-point/title "Writing a Two-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003997e3-71e3-5fd0-8716-b578a050327a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186410016} {:answer/id #uuid "54025de4-e25d-59ae-86a9-1ee27366fc6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{5} \\\\ -\\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186410026} {:answer/id #uuid "5c547e71-e775-5595-94ae-8b1df8563107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ -\\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186410027} {:answer/id #uuid "98bdd91b-9e6f-5202-91b7-08635ee7916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{5} \\\\ \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186410033} {:answer/id #uuid "9e39fb95-43e2-541a-8451-cb5e1a8b5d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -\\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186410034}] :answer-field/correct {:answer/id #uuid "5c547e71-e775-5595-94ae-8b1df8563107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ -\\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186410027} :answer-field/id #uuid "d0279881-209b-5f19-932e-f90a7a749d9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1819c1f8-4cd2-5652-80f1-d185af0479c5" :question/math-academy-id "q-35260" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=5{b}_{2}$ and ${c}_{2}=-3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-5{b}_{2} \\\\  & =-5{b}_{2}+{b}_{1} \\\\  & =-(5{b}_{2})-(-{b}_{1}) \\\\  & =-(5{b}_{2})-\\frac{1}{3}(-3{b}_{1}) \\\\  & =-{c}_{1}-\\frac{1}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-1 \\\\ -\\frac{1}{3}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186120532 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f70848-64e2-5a94-90fd-e1f2b7e3d679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{5}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186345983} {:answer/id #uuid "6537a611-fcd7-568a-9601-b81937251d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186346233} {:answer/id #uuid "795d20fc-2f91-5397-8210-b27b01a471fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ -\\frac{4}{3}\\end{aligned}]" :db/id #edb/ref 17592186346414} {:answer/id #uuid "c3c43852-87af-51a6-be1f-90b3e59f2e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{2}{3} \\\\ \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186347041} {:answer/id #uuid "dd2bb630-c228-5f6a-909a-e8010089efeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186347289}] :answer-field/correct {:answer/id #uuid "6537a611-fcd7-568a-9601-b81937251d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}]" :db/id #edb/ref 17592186346233} :answer-field/id #uuid "68e7d678-d060-59d1-9497-9ed2b25f012c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a2b67a92-2b23-5739-813e-476de8609802" :question/math-academy-id "q-80635" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}-2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}-2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $2$ and adding the equations, we get \n\n$$\n{c}_{1}+2{c}_{2}=3{b}_{1}\\,⟹\\,{b}_{1}=\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-2{b}_{2}\\,⟹\\,{b}_{2}=-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =2{b}_{1}-3{b}_{2} \\\\  & =2(\\frac{1}{3}{c}_{1}+\\frac{2}{3}{c}_{2})-3(-\\frac{1}{3}{c}_{1}+\\frac{1}{3}{c}_{2}) \\\\  & =\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2}+{c}_{1}-{c}_{2} \\\\  & =\\frac{5}{3}{c}_{1}+\\frac{1}{3}{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{5}{3} \\\\ \\frac{1}{3}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186382414 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2801f550-4675-529c-9816-dd8a23db76c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186382416} {:answer/id #uuid "2f07e5b9-afbe-5c2b-b50d-ca2ba18cbd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186382417} {:answer/id #uuid "479985cb-ae73-575a-9723-06896df42896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186382418} {:answer/id #uuid "76864b61-c2e6-5e5d-bd13-3d16528b7fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186382419} {:answer/id #uuid "01d55737-a0c3-5fd7-a933-79093ccad987" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186382420}] :answer-field/correct {:answer/id #uuid "2f07e5b9-afbe-5c2b-b50d-ca2ba18cbd38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186382417} :answer-field/id #uuid "1e14df49-1faa-5b6c-9183-3916f3b4a9e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9afa10d7-c3ed-563c-ba20-3506bbbbfeb8" :question/math-academy-id "q-80830" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}3 \\\\ 5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}=-{b}_{2}$ and ${c}_{2}={b}_{2}-{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}=-{b}_{2} \\\\ {c}_{2}={b}_{2}-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=-{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}=-{c}_{1}-{b}_{1}\\,⟹\\,{b}_{1}=-{c}_{1}-{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}3 \\\\ 5\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =3{b}_{1}+5{b}_{2} \\\\  & =3(-{c}_{1}-{c}_{2})+5(-{c}_{1}) \\\\  & =-3{c}_{1}-3{c}_{2}-5{c}_{1} \\\\  & =-8{c}_{1}-3{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3\\end{aligned}]$"}] [{:db/id #edb/ref 17592186382427 :knowledge-point/_questions [{:db/id #edb/ref 17592186119824 :knowledge-point/id #uuid "df96d21a-e1bc-5a9b-b528-d6e7b30d8451" :knowledge-point/title "Writing a Three-Dimensional Vector in a Different Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9e7207-f73d-53ee-8eea-c28fc296a8ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ -8 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186382429} {:answer/id #uuid "9a35966c-bc96-5e1e-a448-8501426b955b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ 8 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186382430} {:answer/id #uuid "5d6ee5d8-68ee-59a3-b947-9b6be042f3c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ 2 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186382431} {:answer/id #uuid "a3e67ff0-33de-5988-9be8-65a3853d47a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-4 \\\\ -4 \\\\ \\frac{7}{2}\\end{aligned}]" :db/id #edb/ref 17592186382432} {:answer/id #uuid "bf081b28-a050-5ec7-95f3-c7be3546bdd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ \\frac{1}{2} \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186382433}] :answer-field/correct {:answer/id #uuid "9a35966c-bc96-5e1e-a448-8501426b955b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ 8 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186382430} :answer-field/id #uuid "cb8cf9da-96ae-5d88-83d0-d8588cf154a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382428}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99687278-d62b-5cdc-9583-90e343f4b850" :question/math-academy-id "q-81227" :question/problem "Let $B={{b}_{1},{b}_{2},{b}_{3}}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}4 \\\\ -2 \\\\ 7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2},{c}_{3}},$ where ${c}_{1}=-{b}_{3}$, ${c}_{2}=\\frac{1}{2}{b}_{1}$ and ${c}_{3}=2{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}4 \\\\ -2 \\\\ 7\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =4{b}_{1}-2{b}_{2}+7{b}_{3} \\\\  & =7{b}_{3}+4{b}_{1}-2{b}_{2} \\\\  & =-7(-{b}_{3})+8(\\frac{1}{2}{b}_{1})-(2{b}_{2}) \\\\  & =-7{c}_{1}+8{c}_{2}-{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-7 \\\\ 8 \\\\ -1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186410062 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bb3464-f73d-5921-8cdf-f112ab14ead9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186410019} {:answer/id #uuid "36299c18-1f12-5691-a4cc-cf600875d435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186410022} {:answer/id #uuid "7f7a28ee-dddd-5aff-9301-8500542e8d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186410031} {:answer/id #uuid "d1ea2e8b-285d-5d4a-86b6-3118e3eacc94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186410041} {:answer/id #uuid "e5b40102-f333-5f07-9467-4d1fb5ba690a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186410046}] :answer-field/correct {:answer/id #uuid "20bb3464-f73d-5921-8cdf-f112ab14ead9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186410019} :answer-field/id #uuid "d8e25391-7c4e-5c7c-8ae1-5b47ead04007" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410055}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f46f0e34-3d5c-5e7a-9fb4-690993802dbe" :question/math-academy-id "q-81230" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}+{b}_{2}$ and ${c}_{2}={b}_{2}-{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}+{b}_{2} \\\\ {c}_{2}={b}_{2}-{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. By adding the equations, we get \n\n$$\n{c}_{1}+{c}_{2}=2{b}_{2}\\,⟹\\,{b}_{2}=\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}={b}_{1}+(\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2})\\,⟹\\,{b}_{1}=\\frac{1}{2}{c}_{1}-\\frac{1}{2}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =7{b}_{1}+{b}_{2} \\\\  & =7(\\frac{1}{2}{c}_{1}-\\frac{1}{2}{c}_{2})+(\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2}) \\\\  & =\\frac{7}{2}{c}_{1}-\\frac{7}{2}{c}_{2}+\\frac{1}{2}{c}_{1}+\\frac{1}{2}{c}_{2} \\\\  & =4{c}_{1}-3{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}4 \\\\ -3\\end{aligned}].$"}] [{:db/id #edb/ref 17592186382434 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1b575e-fa01-51f5-b88d-283c9336ee0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186382436} {:answer/id #uuid "5757bcb0-1793-5c4b-a36d-da0ddc690d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}8 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186382437} {:answer/id #uuid "2db15541-a9d2-5290-a335-80a3f8f7b7ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}6 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186382438} {:answer/id #uuid "4122fd9a-e1eb-5881-8e54-90119cdba595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186382439} {:answer/id #uuid "48831eba-196d-5db6-a3d4-3b4736fdb543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186382440}] :answer-field/correct {:answer/id #uuid "4122fd9a-e1eb-5881-8e54-90119cdba595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186382439} :answer-field/id #uuid "e1ae9640-12bf-561a-992d-513ae104cb9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382435}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c8f8f3b4-bc3b-5876-ac7a-65d4abd5765a" :question/math-academy-id "q-81231" :question/problem "Let $B={{b}_{1},{b}_{2}}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C={{c}_{1},{c}_{2}},$ where ${c}_{1}={b}_{1}-\\frac{1}{2}{b}_{2}$ and ${c}_{2}={b}_{2}-\\frac{1}{2}{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n{\\begin{aligned}{c}_{1}={b}_{1}-\\frac{1}{2}{b}_{2} \\\\ {c}_{2}={b}_{2}-\\frac{1}{2}{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. Multiplying the second equation by $2$ and adding the equations, we get \n\n$$\n{c}_{1}+2{c}_{2}=\\frac{3}{2}{b}_{2}\\,⟹\\,{b}_{2}=\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}={b}_{1}-\\frac{1}{2}(\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2})\\,⟹\\,{b}_{1}=\\frac{4}{3}{c}_{1}+\\frac{2}{3}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ 4\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}+4{b}_{2} \\\\  & =(\\frac{4}{3}{c}_{1}+\\frac{2}{3}{c}_{2})+4(\\frac{2}{3}{c}_{1}+\\frac{4}{3}{c}_{2}) \\\\  & =\\frac{4}{3}{c}_{1}+\\frac{2}{3}{c}_{2}+\\frac{8}{3}{c}_{1}+\\frac{16}{3}{c}_{2} \\\\  & =4{c}_{1}+6{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}4 \\\\ 6\\end{aligned}].$"}]}
