#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186116120} :activity/id #uuid "3b658871-23f8-5b8d-92ee-5294fec9bba3" :activity/scope {:db/id #edb/ref 17592186048445 :topic/id #uuid "a01c36d3-5643-5685-845e-29c37e89238f" :topic/math-academy-id 1733} :activity/steps [{:db/id #edb/ref 17592186116120 :step/content {:db/id #edb/ref 17592186116493 :tutorial/content "We can use Gaussian elimination to find the general solutions of systems with any number of equations and variables. For instance, consider the system of linear equations\n\n$$\n{\\begin{aligned}x-y+z=1, \\\\ y+3z=0.\\end{aligned}\n$$\n\nThis system has the augmented matrix\n![](images/8a/8a8452587098eed9b697c3999c356359b949429f29ce16af2c81cf728be9480e.svg)\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 1 & 1 \\\\ 0 & 1 & 3 & 0\\end{aligned}]\\, & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & 1 \\\\ 0 & 1 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+4z=1 \\\\ y+3z=0.\\end{aligned}\n$$\n\nWe see that the basic variables are $x$ and $y,$ and we have one free variable $z.$ From the second equation, we get $y=-3z,$ and from the first equation, we obtain $x=1-4z.$ Therefore, the general solution is\n\n$$\n{\\begin{aligned}x=1-4z, \\\\ y=-3z, \\\\ z=z.\\end{aligned}\n$$\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1-4z \\\\ -3z \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-4 \\\\ -3 \\\\ 1\\end{aligned}],\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :tutorial/id #uuid "3eff050b-e4ba-52e5-aa10-7bba2feef2fc" :tutorial/math-academy-id 3162 :tutorial/title "Introduction"} :step/id #uuid "6022e9b9-60ab-5ac5-b16a-17583fa649c3" :step/math-academy-id 17213 :step/next {:db/id #edb/ref 17592186116121}} {:db/id #edb/ref 17592186116121 :step/content {:db/id #edb/ref 17592186115241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115070 :question/id #uuid "dc6dd9b4-de7f-52d0-8ff9-a7a7f7a9abd7" :question/math-academy-id "e-4711"} :knowledge-point/id #uuid "2d81e3f1-d930-59ee-b439-2a3645aebb6c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048742}] :knowledge-point/questions [{:db/id #edb/ref 17592186115751} {:db/id #edb/ref 17592186115830} {:db/id #edb/ref 17592186266111} {:db/id #edb/ref 17592186266112} {:db/id #edb/ref 17592186302108} {:db/id #edb/ref 17592186302193} {:db/id #edb/ref 17592186326924} {:db/id #edb/ref 17592186400625} {:db/id #edb/ref 17592186402009} {:db/id #edb/ref 17592186402756} {:db/id #edb/ref 17592186417081}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"} :step/id #uuid "79bb6bd1-8c36-5f56-9575-8a1b8388eb57" :step/math-academy-id 17214 :step/next {:db/id #edb/ref 17592186116122}} {:db/id #edb/ref 17592186116122 :step/content {:db/id #edb/ref 17592186116494 :tutorial/content "Recall that a system of linear equations is called **consistent** if it has at least one solution. Otherwise, if there are no solutions, the system is called **inconsistent**. \n\nFor a consistent system, \n\n- the system is called **consistent independent** if the solution is unique, while\n\n- the system is called **consistent dependent** if there are infinitely many solutions.\n\n![](images/f5/f5b808eac6e1d865b13b68ce2a4f7d317560ae3965928e478531fcd2148c2c6b.png)" :tutorial/id #uuid "e0c85152-daea-5a87-a3ba-81870558c7a2" :tutorial/math-academy-id 3163 :tutorial/title "Consistent and Inconsistent Systems of Linear Equations"} :step/id #uuid "2fa6eba1-6298-51b5-bbc9-bd8c46a79468" :step/math-academy-id 17215 :step/next {:db/id #edb/ref 17592186116209}} {:db/id #edb/ref 17592186116123 :step/content {:db/id #edb/ref 17592186115242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115071 :question/id #uuid "f2c7cfd3-da43-5208-bd0e-21692357fabe" :question/math-academy-id "e-4712"} :knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5" :knowledge-point/questions [{:db/id #edb/ref 17592186115753} {:db/id #edb/ref 17592186115831} {:db/id #edb/ref 17592186266116} {:db/id #edb/ref 17592186266117} {:db/id #edb/ref 17592186266118} {:db/id #edb/ref 17592186266119} {:db/id #edb/ref 17592186266120} {:db/id #edb/ref 17592186302109} {:db/id #edb/ref 17592186302143} {:db/id #edb/ref 17592186344961} {:db/id #edb/ref 17592186344969} {:db/id #edb/ref 17592186344971} {:db/id #edb/ref 17592186398982} {:db/id #edb/ref 17592186417082}] :knowledge-point/title "Determining the Value of a Constant for Which a Given Linear System Is Consistent or Inconsistent"} :step/id #uuid "1d1a97f8-c872-5285-b963-d1938948df37" :step/math-academy-id 17216} {:db/id #edb/ref 17592186116209 :step/content {:db/id #edb/ref 17592186115299 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115124 :question/id #uuid "cd56314d-f45a-55be-9762-983fe507a1a0" :question/math-academy-id "e-6173"} :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050240}] :knowledge-point/questions [{:db/id #edb/ref 17592186115752} {:db/id #edb/ref 17592186115832} {:db/id #edb/ref 17592186266113} {:db/id #edb/ref 17592186266114} {:db/id #edb/ref 17592186266115} {:db/id #edb/ref 17592186344956} {:db/id #edb/ref 17592186344957} {:db/id #edb/ref 17592186363108} {:db/id #edb/ref 17592186364365} {:db/id #edb/ref 17592186400632} {:db/id #edb/ref 17592186400639} {:db/id #edb/ref 17592186400646} {:db/id #edb/ref 17592186402763} {:db/id #edb/ref 17592186403787}] :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"} :step/id #uuid "e80cfcd9-1219-52d8-96c7-0ee06cdf52fc" :step/math-academy-id 23072 :step/next {:db/id #edb/ref 17592186116123}}] :activi