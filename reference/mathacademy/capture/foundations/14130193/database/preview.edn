6425946 1082 #edb/ref 17592186045498 13194139534567 17592186045417 true] [17592186425946 1083 #uuid "a1294db0-0da9-5a02-b9e5-791ef34dcf11" 13194139534567 17592186045417 true] [17592186425947 1080 "k=5" 13194139534567 17592186045417 true] [17592186425947 1082 #edb/ref 17592186045498 13194139534567 17592186045417 true] [17592186425947 1083 #uuid "cf6dc1f0-4ead-53bf-8e9f-9b57805aa51d" 13194139534567 17592186045417 true] [17592186425948 1075 #edb/ref 17592186425938 13194139534567 17592186045417 true] [17592186425948 1075 #edb/ref 17592186425940 13194139534567 17592186045417 true] [17592186425948 1075 #edb/ref 17592186425944 13194139534567 17592186045417 true] [17592186425948 1075 #edb/ref 17592186425946 13194139534567 17592186045417 true] [17592186425948 1075 #edb/ref 17592186425947 13194139534567 17592186045417 true] [17592186425948 1076 #edb/ref 17592186045493 13194139534567 17592186045417 true] [17592186425948 1077 "selection" 13194139534567 17592186045417 true] [17592186425948 1078 #edb/ref 17592186425947 13194139534567 17592186045417 true] [17592186425948 1079 #uuid "80130b9b-78a0-54cc-bf84-e036ce6c2ff0" 13194139534567 17592186045417 true] [17592186425949 1068 #edb/ref 17592186425948 13194139534567 17592186045417 true] [17592186425949 1069 "q-42021" 13194139534567 17592186045417 true] [17592186425949 1070 #edb/ref 17592186045486 13194139534567 17592186045417 true] [17592186425949 1071 "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\{\\begin{aligned}x+2y=3 \\\\ -3x-(k+1)y=-9\\end{aligned}\n$$" 13194139534567 17592186045417 true] [17592186425949 1072 #uuid "db005b4e-86cd-5194-b2fd-10ca4ee59c03" 13194139534567 17592186045417 true] [17592186425949 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & -3 \\\\ -3 & -(k+1) & -9\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 3 \\\\ -3 & -(k+1) & -9\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 \\\\ 0 & -k+5 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\{\\begin{aligned}1-2y=3 \\\\ -(k-5)y=0.\\end{aligned}\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=5,$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+2y=3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=5.$" 13194139534567 17592186045417 true] [17592186425950 1058 #edb/ref 17592186425952 13194139534567 17592186045417 true] [17592186425950 1062 #uuid "2c3254d8-7342-5cba-aa85-c696386c710a" 13194139534567 17592186045417 true] [17592186425950 1063 #edb/ref 17592186425949 13194139534567 17592186045417 true] [17592186425951 1062 #uuid "3b9e4957-843e-5d56-8704-c60e6e8f032c" 13194139534567 17592186045417 true] [17592186425951 1063 #edb/ref 17592186115832 13194139534567 17592186045417 true] [17592186425952 1058 #edb/ref 17592186425951 13194139534567 17592186045417 true] [17592186425952 1062 #uuid "e9dff08f-68e1-5fe8-9586-d7f8edd2598c" 13194139534567 17592186045417 true] [17592186425952 1063 #edb/ref 17592186115831 13194139534567 17592186045417 true]] :edb/tempids {"activity-080f971c-621c-5ccf-b883-b98c49745b79" 17592186425937 "answer-17602323-8777-51fe-9a70-fac173438e8d" 17592186425938 "answer-359439f2-81e1-5ced-8482-b2cf08a71409" 17592186425939 "answer-3745dd5b-bc8f-5c5f-bfbb-0a70d0ee8eee" 17592186425940 "answer-478b28da-a8a3-51e4-963d-8ac53adc010e" 17592186425941 "answer-545c0eb7-c35a-5d44-b8e2-b045ff203715" 17592186425942 "answer-684ddf9d-dd44-53