45417] [17592186431178 #edb/ref 1079 #uuid "42e70451-3a35-5ee4-bde4-603fef9a0a12" #edb/ref 17592186045417] [17592186431181 #edb/ref 1075 #edb/ref 17592186431149 #edb/ref 17592186045417] [17592186431181 #edb/ref 1075 #edb/ref 17592186431152 #edb/ref 17592186045417] [17592186431181 #edb/ref 1075 #edb/ref 17592186431157 #edb/ref 17592186045417] [17592186431181 #edb/ref 1075 #edb/ref 17592186431159 #edb/ref 17592186045417] [17592186431181 #edb/ref 1075 #edb/ref 17592186431174 #edb/ref 17592186045417] [17592186431181 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186431181 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186431181 #edb/ref 1078 #edb/ref 17592186431152 #edb/ref 17592186045417] [17592186431181 #edb/ref 1079 #uuid "e84d6437-9ec9-5b4b-a3b3-8f14a689f608" #edb/ref 17592186045417] [17592186431183 #edb/ref 1068 #edb/ref 17592186431181 #edb/ref 17592186045417] [17592186431183 #edb/ref 1069 "q-162229" #edb/ref 17592186045417] [17592186431183 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186431183 #edb/ref 1071 "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=-y\\,i+x\\,j$ along the closed curve $C$ given by $r(t)=2\\operatorname{cos}⁡(\\pi t)\\,i+\\operatorname{sin}⁡(\\pi t)\\,j+2\\,k$ for $t\\in [0,2).$" #edb/ref 17592186045417] [17592186431183 #edb/ref 1072 #uuid "1d416162-8b5b-53c3-aa15-9f678fcebfbf" #edb/ref 17592186045417] [17592186431183 #edb/ref 1074 "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=2.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =-y\\,i+x\\,j \\\\  & =-\\operatorname{sin}⁡(\\pi t)\\,i+2\\operatorname{cos}⁡(\\pi t)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(2)\\,k \\\\  & =-2\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+0\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(-\\operatorname{sin}⁡(\\pi t)\\,i+2\\operatorname{cos}⁡(\\pi t)\\,j)\\cdot (-2\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+0\\,k) \\\\  & =-\\operatorname{sin}⁡(\\pi t)\\cdot (-2\\pi \\operatorname{sin}⁡(\\pi t))+2\\operatorname{cos}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t)+0\\cdot 0 \\\\  & =2\\pi {sin}^{2}⁡(\\pi t)+2\\pi {cos}^{2}⁡(\\pi t) \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}2\\pi \\,\\text{d}t \\\\  & =2\\pi [t]_{0}^{2} \\\\  & =2\\pi (2-0) \\\\  & =4\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431184 #edb/ref 1068 #edb/ref 17592186431177 #edb/ref 17592186045417] [17592186431184 #edb/ref 1069 "q-162373" #edb/ref 17592186045417] [17592186431184 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186431184 #edb/ref 1071 "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨x+y,\\,-x+y,\\,-2z⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ The curve $C$ is oriented counter-clockwise when viewed from above." #edb/ref 17592186045417] [17592186431184 #edb/ref 1072 #uuid "4f7d4767-ad54-585a-81f3-9a4a8f681379" #edb/ref 17592186045417] [17592186431184 #edb/ref 1074 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=(x-1)^{2}+(y+1)^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}((x-1)^{2}+(y+1)^{2})=2(x-1) \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}((x-1)^{2}+(y+1)^{2})=2(y+1)\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨x+y,\\,-x+y,\\,-2z⟩{|}_{z=(x-1)^{2}+(y+1)^{2}} \\\\  & =⟨{{x+y}_{⏟}}_{P},\\,{{-x+y}_{⏟}}_{Q},\\,{{-2(x-1)^{2}-2(y+1)^{2}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x+y)\\cdot 2(x-1)-(-x+y)\\cdot 2(y+1)-2((x-1)^{2}+(y+1)^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2((x+y)(1-x)+(x-y)(y+1)-(x-1)^{2}-(y+1)^{2})\\,\\text{d}A \\\\  & ={∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }4(-{r}^{2}+2r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta -1)\\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{\\int }_{0}^{2\\pi }(-{r}^{3}+2{r}^{2}\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡\\theta -r)\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{[-{r}^{3}\\theta +2{r}^{2}\\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta -r\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}(-2\\pi {r}^{3}-2\\pi r)\\,\\text{d}r \\\\  & =-8\\pi {[-\\frac{{r}^{4}}{4}-\\frac{{r}^{2}}{2}]}_{0}^{1} \\\\  & =-8\\pi (-\\frac{1}{4}-\\frac{1}{2}) \\\\  & =-6\\pi .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186431188 #edb/ref 1068 #edb/ref 17592186431178 #edb/ref 17592186045417] [17592186431188 #edb/ref 1069 "q-162228" #edb/ref 17592186045417] [17592186431188 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186431188 #edb/ref 1071 "Calculate the circulation $Γ$ of the vector field $F(x,y,z)=z\\,j-y\\,k$ along the closed curve $C$ given by $r(t)=({t}^{2}-t)\\,i+\\operatorname{cos}⁡(2\\pi t)\\,j+\\operatorname{sin}⁡(2\\pi t)\\,k$ for $t\\in [0,1)$" #edb/ref 17592186045417] [17592186431188 #edb/ref 1072 #uuid "9f4551bd-d0a1-5978-99b9-17e8a12314a5" #edb/ref 17592186045417] [17592186431188 #edb/ref 1074 "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}-t,\\,y=\\operatorname{cos}⁡(2\\pi t),\\,z=\\operatorname{sin}⁡(2\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =z\\,j-y\\,k \\\\  & =\\operatorname{sin}⁡(2\\pi t)\\,j-\\operatorname{cos}⁡(2\\pi t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(2\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2\\pi t))\\,k \\\\  & =(2t-1)\\,i-2\\pi \\operatorname{sin}⁡(2\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(2\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡(2\\pi t)\\,j-\\operatorname{cos}⁡(2\\pi t)\\,k)\\cdot ((2t-1)\\,i-2\\pi \\operatorname{sin}⁡(2\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(2\\pi t)\\,k) \\\\  & =0\\cdot (2t-1)+\\operatorname{sin}⁡(2\\pi t)\\cdot (-2\\pi \\operatorname{sin}⁡(2\\pi t))+(-\\operatorname{cos}⁡(2\\pi t))\\cdot 2\\pi \\operatorname{cos}⁡(2\\pi t) \\\\  & =-2\\pi {sin}^{2}⁡(2\\pi t)-2\\pi {cos}^{2}⁡(2\\pi t) \\\\  & =-2\\pi .\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(-2\\pi )\\,\\text{d}t \\\\  & =-2\\pi [t]_{0}^{1} \\\\  & =-2\\pi (1-0) \\\\  & =-2\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520746 #edb/ref 1043 #edb/ref 17592186521580 #edb/ref 17592186045417] [17592186520746 #edb/ref 1043 #edb/ref 17592186521583 #edb/ref 17592186045417] [17592186520746 #edb/ref 1043 #edb/ref 17592186521614 #edb/ref 17592186045417] [17592186520746 #edb/ref 1043 #edb/ref 17592186521621 #edb/ref 17592186045417] [17592186520746 #edb/ref 1043 #edb/ref 17592186521642 #edb/ref 17592186045417] [17592186520746 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186520746 #edb/ref 1045 "Stokes' Theorem" #edb/ref 17592186045417] [17592186520746 #edb/ref 1046 #edb/ref 17592186521621 #edb/ref 17592186045417] [17592186520746 #edb/ref 1048 #edb/ref 17592186046644 #edb/ref 17592186045417] [17592186520746 #edb/ref 1049 #edb/ref 17592186049762 #edb/ref 17592186045417] [17592186520746 #edb/ref 1053 #uuid "0dba044f-9105-5f4d-82c7-11978f1438fc" #edb/ref 17592186045417] [17592186520786 #edb/ref 1080 "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,{x}^{2}-{y}^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186520786 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186