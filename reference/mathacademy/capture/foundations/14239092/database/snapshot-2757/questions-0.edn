id #uuid "125e28c0-bbb7-5d93-95b9-69fe92e1f551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186278759} {:answer/id #uuid "3eefc9e2-c929-54c3-9081-01b14d2b4379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279147} {:answer/id #uuid "5764f77b-9cd0-5e34-8a78-c0ca6ff9d828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186279393} {:answer/id #uuid "d9a7cfdf-beb6-5886-9078-290c6cf747ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186280514} {:answer/id #uuid "dad10f5c-6829-52c8-b539-d1d5a5320bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186280524}] :answer-field/correct {:answer/id #uuid "d9a7cfdf-beb6-5886-9078-290c6cf747ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186280514} :answer-field/id #uuid "51f8a8c0-e049-5f88-9126-dfef6847e2bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "268c6ade-bfb9-5104-a3ea-6d4f751fe4fb" :question/math-academy-id "q-162324" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡(\\pi t)\\,i+\\operatorname{sin}⁡(\\pi t)\\,j+\\operatorname{cos}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=y\\,i+x\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=\\operatorname{cos}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,k \\\\  & =\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,k \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j-\\pi \\operatorname{sin}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡(\\pi t)\\,i+\\operatorname{cos}⁡(\\pi t)\\,k)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j-\\pi \\operatorname{sin}⁡(\\pi t)\\,k) \\\\  & =\\operatorname{sin}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t))+0\\cdot \\pi \\operatorname{cos}⁡(\\pi t)+\\operatorname{cos}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)) \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)-\\pi {sin}^{2}⁡(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)-\\pi {sin}^{2}⁡(\\pi t))\\,\\text{d}t \\\\  & =-{\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t)\\operatorname{cos}⁡(\\pi t)+\\frac{\\pi }{2}(1-\\operatorname{cos}⁡(2\\pi t)))\\,\\text{d}t \\\\  & =-{[\\frac{{sin}^{2}⁡(\\pi t)}{2}+\\frac{\\pi t}{2}-\\frac{\\operatorname{sin}⁡(2\\pi t)}{4}]}_{-1}^{1} \\\\  & =-[0+\\frac{\\pi }{2}+0-(0-\\frac{\\pi }{2}+0)] \\\\  & =-\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521469 :knowledge-point/_questions [{:db/id #edb/ref 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c4b66cf-ec3e-5130-bf78-dab2acbc861c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,{x}^{2}-{y}^{2}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520786} {:answer/id #uuid "3598a050-8338-5881-8c7e-00b829e53f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520878} {:answer/id #uuid "531bef77-5bda-58b0-b731-a0a09745931d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{x}\\,4+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520953} {:answer/id #uuid "580a54b0-7193-5059-b069-221fd5506992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2+2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186520963} {:answer/id #uuid "735bc584-a512-58b1-8842-88d84b62c851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186521022}] :answer-field/correct {:answer/id #uuid "735bc584-a512-58b1-8842-88d84b62c851" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186521022} :answer-field/id #uuid "bce8cadb-6f17-5458-a146-66e868571308" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22c4166d-7812-5cc0-89d7-bc30157982f0" :question/math-academy-id "q-162363" :question/problem "Let $C$ be the intersection of the hyperbolic paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x=\\pm 1,$ $y=\\pm 2.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨y,\\,x,\\,2⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}-{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)={x}^{2}-{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({x}^{2}-{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,x,\\,2⟩{|}_{z={x}^{2}-{y}^{2}} \\\\  & =⟨y,\\,x,\\,2⟩ \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{x}_{⏟}}_{Q},\\,{{2}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-x\\cdot (-2y)+2)\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/5f/5f2f4cb03b3b0232c9debd1f4ed64bd683fe788ccba16cfbe395d9c3b629972d.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}2\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-2}^{2}\\,2\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401336 :knowledge-point/_questions [{:db/id #edb/ref 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69eaa3fe-4c03-532c-9d1a-cd84b8703ad2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{4}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401338} {:answer/id #uuid "460112aa-e36b-52a6-a02b-783fee9d05b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{xy}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401339} {:answer/id #uuid "9d2fbcee-821a-5cd9-8a6e-f9412bd4ab5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,\\frac{{x}^{2}}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401340} {:answer/id #uuid "e12cffd5-0b22-5b0b-a3e3-7270fff61900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401341} {:answer/id #uuid "1540b931-3add-5e5c-99b4-77aa9c86e5f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{{y}^{2}}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401342}] :answer-field/correct {:answer/id #uuid "e12cffd5-0b22-5b0b-a3e3-7270fff61900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401341} :answer-field/id #uuid "17de6bba-7478-572d-9fe3-ada91a6e9edc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a28026ac-9427-5db7-b40f-31513274adc4" :question/math-academy-id "q-162365" :question/problem "Let $C$ be the intersection of the surface $z=\\frac{1}{{x}^{2}+{y}^{2}+1}$ and the boundary of the infinite vertical column enclosed by the planes $x=\\pm 1,$ and $y=\\pm 1.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨x,\\,y,\\,-2z⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the surface $z=\\frac{1}{{x}^{2}+{y}^{2}+1}$ and the boundary of our infinite vertical column. One such surface is our surface $S$ with the equation \n\n$$\nz=g(x,y)=\\frac{1}{{x}^{2}+{y}^{2}+1}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{{x}^{2}+{y}^{2}+1})=\\frac{-2x}{({x}^{2}+{y}^{2}+1)^{2}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{{x}^{2}+{y}^{2}+1})=\\frac{-2y}{({x}^{2}+{y}^{2}+1)^{2}}\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨x,\\,y,\\,-2z⟩{|}_{z=1/({x}^{2}+{y}^{2}+1)} \\\\  & =⟨{{x}_{⏟}}_{P},\\,{{y}_{⏟}}_{Q},\\,{{-\\frac{2}{{x}^{2}+{y}^{2}+1}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-x\\cdot \\frac{-2x}{({x}^{2}+{y}^{2}+1)^{2}}-y\\cdot \\frac{-2y}{({x}^{2}+{y}^{2}+1)^{2}}-\\frac{2}{{x}^{2}+{y}^{2}+1})\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/b2/b215ec1e3330f96e7e606e085721b2dd1f50d113f0151e36ec98e6d0a6f54e73.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372020 :knowledge-point/_questions [{:db/id #edb/ref 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3886a830-f807-532a-8dff-ac10e7ec4914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-72\\pi " :db/id #edb/ref 17592186372022} {:answer/id #uuid "7607b49a-d23b-55b8-8e3c-b7353e88eeeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144\\pi " :db/id #edb/ref 17592186372023} {:answer/id #uuid "c46e2782-3e03-5ada-93b7-ba596554275e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36\\pi " :db/id #edb/ref 17592186372024} {:answer/id #uuid "0f26e94b-0e7f-527e-a515-9f633c3e5b33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186372025} {:answer/id #uuid "5c50dc6b-1088-5cb6-baa6-a6a933d4f39e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\pi " :db/id #edb/ref 17592186372026}] :answer-field/correct {:answer/id #uuid "3886a830-f807-532a-8dff-ac10e7ec4914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-72\\pi " :db/id #edb/ref 17592186372022} :answer-field/id #uuid "10810889-3a2d-5477-b575-bc6677b334ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372021}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "da6c973e-9e1d-506f-8988-7e41ce9a8511" :question/math-academy-id "q-162371" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨y,\\,2yz,\\,-{z}^{2}+1⟩,$ and $C$ is the intersection of the half-cone $z=-\\sqrt{{x}^{2}+{y}^{2}}$ and the plane $z=-3.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the half-cone $z=-\\sqrt{{x}^{2}+{y}^{2}}$ and the plane $z=-3.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=-3.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(-3)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(-3)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,2yz,\\,-{z}^{2}+1⟩{|}_{z=-3} \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{-6y}_{⏟}}_{Q},\\,{{-8}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot 0-(-6y)\\cdot 0-8)\\,\\text{d}A \\\\  & ={∬}_{D}-8\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=9$ with radius $3$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}-8\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}-8\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =-8{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\cdot {\\int }_{0}^{3}r\\,\\text{d}r \\\\  & =-8[\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{{r}^{2}}{2}]}_{r=0}^{r=3} \\\\  & =-8(2\\pi -0)\\cdot (\\frac{9}{2}-0) \\\\  & =-72\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372027 :knowledge-point/_questions [{:db/id #edb/ref 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff3a9c27-f34b-5594-94af-40a7c58297f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186372029} {:answer/id #uuid "b5a89c10-18a7-59cb-8a1b-3a18b2a90938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\pi " :db/id #edb/ref 17592186372030} {:answer/id #uuid "f2ff01ff-40d6-5616-bd3a-9376f9415536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186372031} {:answer/id #uuid "14cd568a-621b-5de0-baca-80df932e47d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186372032} {:answer/id #uuid "daa9659f-982a-5882-a68f-e91cd62724ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186372033}] :answer-field/correct {:answer/id #uuid "14cd568a-621b-5de0-baca-80df932e47d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186372032} :answer-field/id #uuid "5674f149-9ce3-5602-89ab-1339d40392d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372028}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00a16c1c-6465-5edc-becb-61f3932da901" :question/math-academy-id "q-162372" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨-y,\\,z,\\,-2x⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=2+2x-y.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=2+2x-y.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=2+2x-y.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(2+2x-y)=2 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(2+2x-y)=-1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨-y,\\,z,\\,-2x⟩{|}_{z=2+2x-y} \\\\  & =⟨{{-y}_{⏟}}_{P},\\,{{2+2x-y}_{⏟}}_{Q},\\,{{-2x}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(-y)\\cdot (2)-(2+2x-y)\\cdot (-1)-2x)\\,\\text{d}A \\\\  & ={∬}_{D}(2y+2+2x-y-2x)\\,\\text{d}A \\\\  & ={∬}_{D}(2+y)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2+y)\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}(2+r\\operatorname{sin}⁡\\theta )\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}2r+{r}^{2}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[{r}^{2}+\\frac{{r}^{3}}{3}\\operatorname{sin}⁡\\theta ]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(1+\\frac{1}{3}\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={[\\theta -\\frac{1}{3}\\operatorname{cos}⁡\\theta ]}_{0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431184 :knowledge-point/_questions [{:db/id #edb/ref 17592186133927 :knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f86a33-c575-56fe-bdb7-9730885ac9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186431147} {:answer/id #uuid "20c46104-aaee-5f81-87c8-e9c611ae6afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\pi " :db/id #edb/ref 17592186431151} {:answer/id #uuid "54da2db0-1ce1-5f93-af27-c7663a8c8354" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\pi " :db/id #edb/ref 17592186431155} {:answer/id #uuid "c8614eac-4ce9-50b5-a743-5b04a0329efb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186431170} {:answer/id #uuid "fe3f8a13-dd60-5d9d-81be-3575b6037de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186431176}] :answer-field/correct {:answer/id #uuid "20c46104-aaee-5f81-87c8-e9c611ae6afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\pi " :db/id #edb/ref 17592186431151} :answer-field/id #uuid "257fc3b0-4eee-568e-ab48-ba72ee13cf19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431177}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f7d4767-ad54-585a-81f3-9a4a8f681379" :question/math-academy-id "q-162373" :question/problem "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨x+y,\\,-x+y,\\,-2z⟩,$ and $C$ is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ The curve $C$ is oriented counter-clockwise when viewed from above." :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the paraboloid $z=(x-1)^{2}+(y+1)^{2}.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=(x-1)^{2}+(y+1)^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}((x-1)^{2}+(y+1)^{2})=2(x-1) \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}((x-1)^{2}+(y+1)^{2})=2(y+1)\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨x+y,\\,-x+y,\\,-2z⟩{|}_{z=(x-1)^{2}+(y+1)^{2}} \\\\  & =⟨{{x+y}_{⏟}}_{P},\\,{{-x+y}_{⏟}}_{Q},\\,{{-2(x-1)^{2}-2(y+1)^{2}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x+y)\\cdot 2(x-1)-(-x+y)\\cdot 2(y+1)-2((x-1)^{2}+(y+1)^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2((x+y)(1-x)+(x-y)(y+1)-(x-1)^{2}-(y+1)^{2})\\,\\text{d}A \\\\  & ={∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}4(-{x}^{2}-{y}^{2}+2x-y-1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }4(-{r}^{2}+2r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta -1)\\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{\\int }_{0}^{2\\pi }(-{r}^{3}+2{r}^{2}\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡\\theta -r)\\,\\text{d}\\theta \\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}{[-{r}^{3}\\theta +2{r}^{2}\\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta -r\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =4{\\int }_{0}^{1}(-2\\pi {r}^{3}-2\\pi r)\\,\\text{d}r \\\\  & =-8\\pi {[-\\frac{{r}^{4}}{4}-\\frac{{r}^{2}}{2}]}_{0}^{1} \\\\  & =-8\\pi (-\\frac{1}{4}-\\frac{1}{2}) \\\\  & =-6\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281554 :knowledge-point/_questions [{:db/id #edb/ref 17592186133928 :knowledge-point/id #uuid "d65a039f-6022-547d-a852-c249da5bd8ab" :knowledge-point/title "Evaluating a Surface Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d80d2d-e154-51fd-a594-5eba0a5e6b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{15}" :db/id #edb/ref 17592186278765} {:answer/id #uuid "14b8499c-89bd-5bc3-931b-c40e7ce37aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{45}" :db/id #edb/ref 17592186278777} {:answer/id #uuid "72b205e0-a52e-5333-be4c-5c18dbe481a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186279634} {:answer/id #uuid "aa3aff6a-8638-5f77-8507-0d3f55b19bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186280102} {:answer/id #uuid "f732e6da-e394-595c-9b7c-3f0005986060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186280757}] :answer-field/correct {:answer/id #uuid "f732e6da-e394-595c-9b7c-3f0005986060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186280757} :answer-field/id #uuid "ea93f9f9-61f9-5ba5-a529-0a7b5d54ca7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "915ccbd6-d5b8-5b79-ba41-8aee577baac0" :question/math-academy-id "q-162886" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=({t}^{2}+t)\\,i+({t}^{3}+{t}^{2})\\,j+(2{t}^{2}+2t)\\,k$ for $t\\in [-1,0).$\nGiven that $F(x,y,z)=y\\,i+z\\,j+x\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{2}+t,\\,y={t}^{3}+{t}^{2},\\,z=2{t}^{2}+2t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+z\\,j+x\\,k \\\\  & =({t}^{3}+{t}^{2})\\,i+(2{t}^{2}+2t)\\,j+({t}^{2}+t)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+2t)\\,k \\\\  & =(2t+1)\\,i+(3{t}^{2}+2t)\\,j+(4t+2)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{3}+{t}^{2})\\,i+(2{t}^{2}+2t)\\,j+({t}^{2}+t)\\,k)\\cdot ((2t+1)\\,i+(3{t}^{2}+2t)\\,j+(4t+2)\\,k) \\\\  & =({t}^{3}+{t}^{2})(2t+1)+(2{t}^{2}+2t)(3{t}^{2}+2t)+({t}^{2}+t)(4t+2) \\\\  & =2t+11{t}^{2}+17{t}^{3}+8{t}^{4}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{0}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}(2t+11{t}^{2}+17{t}^{3}+8{t}^{4})\\,\\text{d}t \\\\  & ={[{t}^{2}+\\frac{11}{3}{t}^{3}+\\frac{17}{4}{t}^{4}+\\frac{8}{5}{t}^{5}]}_{-1}^{0} \\\\  & =0-(1-\\frac{11}{3}+\\frac{17}{4}-\\frac{8}{5}) \\\\  & =\\frac{1}{60}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281555 :knowledge-point/_questions [{:db/id #edb/ref 17592186133928 :knowledge-point/id #uuid "d65a039f-6022-547d-a852-c249da5bd8ab" :knowledge-point/title "Evaluating a Surface Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77a49d17-1ccd-5d21-8067-3cc28c01dfc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186279659} {:answer/id #uuid "9498af25-8e31-5391-9c5d-57b5a039adb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{10}" :db/id #edb/ref 17592186279913} {:answer/id #uuid "9af2af40-8464-54ca-9c05-b548baff602f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186279964} {:answer/id #uuid "b3c29f02-dc00-5dc7-805e-51068b29a448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{15}" :db/id #edb/ref 17592186280175} {:answer/id #uuid "e84e4b95-0c02-5828-a503-1bc5e276aa93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186280637}] :answer-field/correct {:answer/id #uuid "b3c29f02-dc00-5dc7-805e-51068b29a448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{15}" :db/id #edb/ref 17592186280175} :answer-field/id #uuid "98a966d4-0bb1-5c55-b273-7cce49dd0df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281104}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c852df75-6989-5a7d-bc7f-0618226da77b" :question/math-academy-id "q-162887" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=({t}^{3}-t)\\,i+(2{t}^{2}+1)\\,j+({t}^{2}-1)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=y\\,i+3\\,j+yz\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx={t}^{3}-t,\\,y=2{t}^{2}+1,\\,z={t}^{2}-1.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+3\\,j+yz\\,k \\\\  & =(2{t}^{2}+1)\\,i+3\\,j+(2{t}^{2}+1)({t}^{2}-1)\\,k \\\\  & =(2{t}^{2}+1)\\,i+3\\,j+(2{t}^{4}-{t}^{2}-1)\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+1)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,k \\\\  & =(3{t}^{2}-1)\\,i+4t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((2{t}^{2}+1)\\,i+3\\,j+(2{t}^{4}-{t}^{2}-1)\\,k)\\cdot ((3{t}^{2}-1)\\,i+4t\\,j+2t\\,k) \\\\  & =(2{t}^{2}+1)(3{t}^{2}-1)+3(4t)+(2{t}^{4}-{t}^{2}-1)(2t) \\\\  & =-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-1+10t+{t}^{2}-2{t}^{3}+6{t}^{4}+4{t}^{5})\\,\\text{d}t \\\\  & ={[-t+5{t}^{2}+\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{4}+\\frac{6}{5}{t}^{5}+\\frac{2}{3}{t}^{6}]}_{-1}^{1} \\\\  & =(-1+5+\\frac{1}{3}-\\frac{1}{2}+\\frac{6}{5}+\\frac{2}{3})-(1+5-\\frac{1}{3}-\\frac{1}{2}-\\frac{6}{5}+\\frac{2}{3}) \\\\  & =-2+\\frac{2}{3}+\\frac{12}{5} \\\\  & =\\frac{16}{15}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281556 :knowledge-point/_questions [{:db/id #edb/ref 17592186133928 :knowledge-point/id #uuid "d65a039f-6022-547d-a852-c249da5bd8ab" :knowledge-point/title "Evaluating a Surface Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c5b07f3-4813-5a4a-a0e6-a5bf77edd48d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186278852} {:answer/id #uuid "24161e0a-0b08-5db9-9481-589c38c2931e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186278915} {:answer/id #uuid "3927e74a-4b53-5c18-92e5-d51492930769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186279093} {:answer/id #uuid "bc856658-afbb-5fe8-bdf2-8d82839c6b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186280249} {:answer/id #uuid "f923d8f6-fbaa-5b3e-a1a9-91366f82223e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280779}] :answer-field/correct {:answer/id #uuid "bc856658-afbb-5fe8-bdf2-8d82839c6b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186280249} :answer-field/id #uuid "99cbe268-3f0b-5f24-95dd-226717656d00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281106}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "203be68d-096d-564c-bf44-7d62e44d7418" :question/math-academy-id "q-162892" :question/problem "Let $S$ be an oriented piecewise-smooth surface bounded by the closed curve $C$ with positive orientation and parametrization $r(t)=\\operatorname{cos}⁡(\\pi t)\\,i+\\operatorname{sin}⁡(\\pi t)\\,j+2\\operatorname{sin}⁡(\\pi t)\\,k$ for $t\\in [-1,1).$\nGiven that $F(x,y,z)=2y\\,i-2x\\,j+{e}^{z-2y}\\,k,$ evaluate the integral\n\n$$\n{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡(\\pi t),\\,y=\\operatorname{sin}⁡(\\pi t),\\,z=2\\operatorname{sin}⁡(\\pi t).\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =2y\\,i-2x\\,j+{e}^{z-2y}\\,k \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+{e}^{2\\operatorname{sin}⁡(\\pi t)-2\\operatorname{sin}⁡(\\pi t)}\\,k \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\pi t))\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t))\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(\\pi t))\\,k \\\\  & =-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(\\pi t)\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2\\operatorname{sin}⁡(\\pi t)\\,i-2\\operatorname{cos}⁡(\\pi t)\\,j+k)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t)\\,i+\\pi \\operatorname{cos}⁡(\\pi t)\\,j+2\\pi \\operatorname{cos}⁡(\\pi t)\\,k) \\\\  & =2\\operatorname{sin}⁡(\\pi t)\\cdot (-\\pi \\operatorname{sin}⁡(\\pi t))-2\\operatorname{cos}⁡(\\pi t)\\cdot \\pi \\operatorname{cos}⁡(\\pi t)+1\\cdot 2\\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =-2\\pi {sin}^{2}⁡(\\pi t)-2\\pi {cos}^{2}⁡(\\pi t)+2\\pi \\operatorname{cos}⁡(\\pi t) \\\\  & =-2\\pi +2\\pi \\operatorname{cos}⁡(\\pi t).\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∮}_{C}F\\cdot dr \\\\  & ={\\int }_{-1}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(-2\\pi +2\\pi \\operatorname{cos}⁡(\\pi t))\\,\\text{d}t \\\\  & =[-2\\pi t+2\\operatorname{sin}⁡(\\pi t)]_{-1}^{1} \\\\  & =(-2\\pi (1)+0)-(-2\\pi (-1)+0) \\\\  & =-4\\pi \\end{aligned}\n$$"}]}
