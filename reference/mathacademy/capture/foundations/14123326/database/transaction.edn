[{:db/id 17592186192754 :knowledge-point/questions ["question-168818a7-6140-5751-9382-8a48afe2a16e" "question-942a9198-9a9b-5910-a327-96717799bf91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-168818a7-6140-5751-9382-8a48afe2a16e" :question/id #uuid "168818a7-6140-5751-9382-8a48afe2a16e" :question/math-academy-id "q-87221" :question/problem "Compute $P(X<-5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}4{e}^{4x},\\, & x\\le 0, \\\\ 0,\\, & x>0.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X<-5) & =P(-\\infty <X<-5) \\\\  & ={\\int }_{-\\infty }^{-5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-5}4{e}^{4x}\\,\\text{d}x \\\\  & ={[{e}^{4x}]}_{-\\infty }^{-5} \\\\  & ={e}^{-20}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55603476-e287-5779-991f-12f57c478278"] :db/ensure [:question/validate]} {:db/id "answer-field-55603476-e287-5779-991f-12f57c478278" :answer-field/id #uuid "55603476-e287-5779-991f-12f57c478278" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer-field/choices ["answer-f5c19772-5317-5a44-8357-af32f4360941" "answer-146aee1a-528b-5bbf-a4b6-4fbf2f271f49" "answer-e008e939-3bb6-57fd-a8f3-41e658e78a3e" "answer-7e007eff-0deb-57f5-a6ba-37ea62edbf05" "answer-27715182-2cb9-52c2-a080-36df60c28e78"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5c19772-5317-5a44-8357-af32f4360941" :answer/id #uuid "f5c19772-5317-5a44-8357-af32f4360941" :answer/type :answer.type/math :answer/value "{e}^{-10}" :db/ensure [:answer/validate]} {:db/id "answer-146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer/id #uuid "146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer/type :answer.type/math :answer/value "{e}^{-20}" :db/ensure [:answer/validate]} {:db/id "answer-e008e939-3bb6-57fd-a8f3-41e658e78a3e" :answer/id #uuid "e008e939-3bb6-57fd-a8f3-41e658e78a3e" :answer/type :answer.type/math :answer/value "{e}^{-4/5}" :db/ensure [:answer/validate]} {:db/id "answer-7e007eff-0deb-57f5-a6ba-37ea62edbf05" :answer/id #uuid "7e007eff-0deb-57f5-a6ba-37ea62edbf05" :answer/type :answer.type/math :answer/value "{e}^{-4}" :db/ensure [:answer/validate]} {:db/id "answer-27715182-2cb9-52c2-a080-36df60c28e78" :answer/id #uuid "27715182-2cb9-52c2-a080-36df60c28e78" :answer/type :answer.type/math :answer/value "{e}^{-5}" :db/ensure [:answer/validate]} {:db/id "question-942a9198-9a9b-5910-a327-96717799bf91" :question/id #uuid "942a9198-9a9b-5910-a327-96717799bf91" :question/math-academy-id "q-87226" :question/problem "Compute $P(X>3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & x<1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>3) & =P(3\\le X<\\infty ) \\\\  & ={\\int }_{3}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{\\infty }\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{{x}^{4}}]}_{3}^{\\infty } \\\\  & =\\frac{1}{81}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8d3bf738-9bc7-5e68-a507-db9436929f3e"] :db/ensure [:question/validate]} {:db/id "answer-field-8d3bf738-9bc7-5e68-a507-db9436929f3e" :answer-field/id #uuid "8d3bf738-9bc7-5e68-a507-db9436929f3e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28308daa-8ddb-545e-8465-8f0a73db0af6" :answer-field/choices ["answer-e8dbe1c3-a9e4-5566-b39f-c692e5091488" "answer-8e8