#{[{:db/id #edb/ref 17592186262578 :knowledge-point/_questions [{:db/id #edb/ref 17592186192754 :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6023af0f-b4dd-541f-b0d2-9db3f518cd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260707} {:answer/id #uuid "d02f4e02-7b6c-5777-aee2-33c54a892f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186261714} {:answer/id #uuid "d6172bf6-5ae9-5323-b13a-c469aa93b4d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186261758} {:answer/id #uuid "ea772249-1b9e-54d7-aff3-07375a0afdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186261933} {:answer/id #uuid "f5989cb2-1e59-5e2c-9106-aaed97e1d35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186262023}] :answer-field/correct {:answer/id #uuid "6023af0f-b4dd-541f-b0d2-9db3f518cd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260707} :answer-field/id #uuid "249bf36d-1590-59fa-bf5d-ae59c8724944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262188}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4715a163-98e1-5514-9f6b-3d69d82eb15c" :question/math-academy-id "q-126028" :question/problem "Compute $P(X>4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(4<X<\\infty ) \\\\  & ={\\int }_{4}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{\\sqrt{x}}]}_{4}^{\\infty } \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}]}
