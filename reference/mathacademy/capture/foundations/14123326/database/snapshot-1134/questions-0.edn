#{[{:db/id #edb/ref 17592186262578 :knowledge-point/_questions [{:db/id #edb/ref 17592186192754 :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6023af0f-b4dd-541f-b0d2-9db3f518cd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260707} {:answer/id #uuid "d02f4e02-7b6c-5777-aee2-33c54a892f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186261714} {:answer/id #uuid "d6172bf6-5ae9-5323-b13a-c469aa93b4d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186261758} {:answer/id #uuid "ea772249-1b9e-54d7-aff3-07375a0afdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186261933} {:answer/id #uuid "f5989cb2-1e59-5e2c-9106-aaed97e1d35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186262023}] :answer-field/correct {:answer/id #uuid "6023af0f-b4dd-541f-b0d2-9db3f518cd70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260707} :answer-field/id #uuid "249bf36d-1590-59fa-bf5d-ae59c8724944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262188}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4715a163-98e1-5514-9f6b-3d69d82eb15c" :question/math-academy-id "q-126028" :question/problem "Compute $P(X>4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(4<X<\\infty ) \\\\  & ={\\int }_{4}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{\\sqrt{x}}]}_{4}^{\\infty } \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421865 :knowledge-point/_questions [{:db/id #edb/ref 17592186192754 :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-20}" :db/id #edb/ref 17592186421853} {:answer/id #uuid "27715182-2cb9-52c2-a080-36df60c28e78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-5}" :db/id #edb/ref 17592186421854} {:answer/id #uuid "7e007eff-0deb-57f5-a6ba-37ea62edbf05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4}" :db/id #edb/ref 17592186421856} {:answer/id #uuid "e008e939-3bb6-57fd-a8f3-41e658e78a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-4/5}" :db/id #edb/ref 17592186421860} {:answer/id #uuid "f5c19772-5317-5a44-8357-af32f4360941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-10}" :db/id #edb/ref 17592186421862}] :answer-field/correct {:answer/id #uuid "146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-20}" :db/id #edb/ref 17592186421853} :answer-field/id #uuid "55603476-e287-5779-991f-12f57c478278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "168818a7-6140-5751-9382-8a48afe2a16e" :question/math-academy-id "q-87221" :question/problem "Compute $P(X<-5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}4{e}^{4x},\\, & x\\le 0, \\\\ 0,\\, & x>0.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X<-5) & =P(-\\infty <X<-5) \\\\  & ={\\int }_{-\\infty }^{-5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-5}4{e}^{4x}\\,\\text{d}x \\\\  & ={[{e}^{4x}]}_{-\\infty }^{-5} \\\\  & ={e}^{-20}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421866 :knowledge-point/_questions [{:db/id #edb/ref 17592186192754 :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28308daa-8ddb-545e-8465-8f0a73db0af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186421855} {:answer/id #uuid "8e8aadca-e9d8-5956-bfd5-24321e9b6037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186421857} {:answer/id #uuid "a495ea88-69a7-52f5-b2d7-6986e9a706f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186421858} {:answer/id #uuid "c724da1c-2c42-5050-aba4-21fa7939277a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{81}" :db/id #edb/ref 17592186421859} {:answer/id #uuid "e8dbe1c3-a9e4-5566-b39f-c692e5091488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186421861}] :answer-field/correct {:answer/id #uuid "28308daa-8ddb-545e-8465-8f0a73db0af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186421855} :answer-field/id #uuid "8d3bf738-9bc7-5e68-a507-db9436929f3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421864}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "942a9198-9a9b-5910-a327-96717799bf91" :question/math-academy-id "q-87226" :question/problem "Compute $P(X>3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & x<1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>3) & =P(3\\le X<\\infty ) \\\\  & ={\\int }_{3}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{\\infty }\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{{x}^{4}}]}_{3}^{\\infty } \\\\  & =\\frac{1}{81}.\\end{aligned}\n$$"}]}
