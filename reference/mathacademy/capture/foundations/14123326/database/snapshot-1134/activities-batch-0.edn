#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186193613} :activity/id #uuid "e3d33137-c31a-567d-baff-3e933e4f2403" :activity/scope {:db/id #edb/ref 17592186048532 :topic/id #uuid "a7907bdb-038e-5baa-a4ae-df7b362e291b" :topic/math-academy-id 4100} :activity/steps [{:db/id #edb/ref 17592186193612 :step/content {:db/id #edb/ref 17592186192754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192473 :question/id #uuid "3f141210-8194-5346-9e2a-c47f98bb3443" :question/math-academy-id "e-10840"} :knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048744}] :knowledge-point/questions [{:db/id #edb/ref 17592186193390} {:db/id #edb/ref 17592186193392} {:db/id #edb/ref 17592186262576} {:db/id #edb/ref 17592186262577} {:db/id #edb/ref 17592186262578} {:db/id #edb/ref 17592186262579} {:db/id #edb/ref 17592186262580} {:db/id #edb/ref 17592186354555} {:db/id #edb/ref 17592186421865} {:db/id #edb/ref 17592186421866}] :knowledge-point/title "Computing a Probability Over an Unbounded Interval"} :step/id #uuid "d9a24908-03a6-51d6-b5f1-3155cc2dccaf" :step/math-academy-id 41081} {:db/id #edb/ref 17592186193613 :step/content {:db/id #edb/ref 17592186193862 :tutorial/content "Recall that the **probability density function** (or **pdf**) of a continuous random variable $X$ defined over a set $S$ is a function $f(x)$ that satisfies the following conditions:\n\n- $f(x) \\geq 0$ for all $x$ in $S$\n\n- $\\displaystyle \\int_{S} f(x) \\, \\textrm dx = 1$\n\nIt is common for the set $S$ of a continuous random variable $X$ to be an infinite interval. Therefore, we often need to evaluate improper integrals when determining whether a function is a valid pdf and to compute probabilities associated with such a random variable.\n\nFor example, let's consider the following function:\n\n![](images/38/38ea105f5dd0cea7784bf73f814e7161b90cfd224eb099084cc33b6539d95fdd.svg)\n\nIs $f(x)$ a valid probability density function? Let's start by sketching its graph:\n\n![](images/35/3559a998491a004c159683aaf0946bb4fdf87f4afe873fdc93235e840b4b0ac8.png)\n\nClearly, $f(x)\\geq 0$ for all $x,$ so this function satisfies the first condition.\n\nTo check that $f(x)$ satisfies the second condition, we need to compute the following integral:\n\n$$\n\\int_S f(x)\\,\\textrm d x = \\int_0^\\infty e^{-x}\\,\\textrm d x\n$$\n\nCalculating this integral using the usual methods, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-x}\\,\\text{d}x & ={[-{e}^{-x}]}_{0}^{\\infty } \\\\  & =[-{e}^{-\\infty }]-[-{e}^{0}] \\\\  & =0-(-1) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, since $f(x)$ satisfies both conditions, we conclude that $f(x)$ is a valid probability density function.\n\nLet's see another example." :tutorial/id #uuid "f9c0835e-afeb-5f5c-b296-1e37ad68d3fa" :tutorial/math-academy-id 6775 :tutorial/title "Introduction"} :step/id #uuid "00b1a7d3-74fb-5434-befa-306fc78d3a8a" :step/math-academy-id 41119 :step/next {:db/id #edb/ref 17592186193693}} {:db/id #edb/ref 17592186193614 :step/content {:db/id #edb/ref 17592186192755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192474 :question/id #uuid "d40a67bd-7d98-58fb-b4a1-7a556e91556a" :question/math-academy-id "e-10851"} :knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7" :knowledge-point/questions [{:db/id #edb/ref 17592186193391} {:db/id #edb/ref 17592186193394} {:db/id #edb/ref 17592186278307} {:db/id #edb/ref 17592186278308} {:db/id #edb/ref 17592186278309} {:db/id #edb/ref 17592186278310} {:db/id #edb/ref 17592186278311} {:db/id #edb/ref 17592186354558} {:db/id #edb/ref 17592186354559} {:db/id #edb/ref 17592186408037}] :knowledge-point/title "Solving for a Constant Given a PDF"} :step/id #uuid "cccafa59-dc36-5d28-96de-c705cc5a1797" :step/math-academy-id 41121 :step/next {:db/id #edb/ref 17592186193612}} {:db/id #edb/ref 17592186193693 :step/content {:db/id #edb/ref 17592186192801 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192529 :question/id #uuid "5f988175-cdd9-5ddf-94b5-3b995dc75fce" :question/math-academy-id "e-12329"} :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048115} {:db/id #edb/ref 17592186049638} {:db/id #edb/ref 17592186051015}] :knowledge-point/questions [{:db/id #edb/ref 17592186193133} {:db/id #edb/ref 17592186193204} {:db/id #edb/ref 17592186278302} {:db/id #edb/ref 17592186278303} {:db/id #edb/ref 17592186278304} {:db/id #edb/ref 17592186278305} {:db/id #edb/ref 17592186408038}] :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"} :step/id #uuid "369bab2a-0778-58cb-b362-2b26468c8bd0" :step/math-academy-id 44173 :step/next {:db/id #edb/ref 17592186193614}}] :activity/title "Continuous Random Variables Over Infinite Domains" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192925}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186421869} :activity/id #uuid "2dc4dabc-aedf-5892-921f-490e984369c4" :activity/scope {:db/id #edb/ref 17592186048532 :topic/id #uuid "a7907bdb-038e-5baa-a4ae-df7b362e291b" :topic/math-academy-id 4100} :activity/steps [{:db/id #edb/ref 17592186421867 :step/content {:db/id #edb/ref 17592186262578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6023af0f-b4dd-541f-b0d2-9db3f518cd70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260707} {:answer/id #uuid "d02f4e02-7b6c-5777-aee2-33c54a892f35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186261714} {:answer/id #uuid "d6172bf6-5ae9-5323-b13a-c469aa93b4d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186261758} {:answer/id #uuid "ea772249-1b9e-54d7-aff3-07375a0afdd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186261933} {:answer/id #uuid "f5989cb2-1e59-5e2c-9106-aaed97e1d35e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186262023}] :answer-field/correct {:db/id #edb/ref 17592186260707} :answer-field/id #uuid "249bf36d-1590-59fa-bf5d-ae59c8724944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4715a163-98e1-5514-9f6b-3d69d82eb15c" :question/math-academy-id "q-126028" :question/problem "Compute $P(X>4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(4<X<\\infty ) \\\\  & ={\\int }_{4}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{\\sqrt{x}}]}_{4}^{\\infty } \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} :step/id #uuid "01b175bd-e667-5a75-b3df-02b40ee2e81b"} {:db/id #edb/ref 17592186421868 :step/content {:db/id #edb/ref 17592186421866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28308daa-8ddb-545e-8465-8f0a73db0af6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186421855} {:answer/id #uuid "8e8aadca-e9d8-5956-bfd5-24321e9b6037" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186421857} {:answer/id #uuid "a495ea88-69a7-52f5-b2d7-6986e9a706f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{64}" :db/id #edb/ref 17592186421858} {:answer/id #uuid "c724da1c-2c42-5050-aba4-21fa7939277a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20}{81}" :db/id #edb/ref 17592186421859} {:answer/id #uuid "e8dbe1c3-a9e4-5566-b39f-c692e5091488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186421861}] :answer-field/correct {:db/id #edb/ref 17592186421855} :answer-field/id #uuid "8d3bf738-9bc7-5e68-a507-db9436929f3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186421864}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "942a9198-9a9b-5910-a327-96717799bf91" :question/math-academy-id "q-87226" :question/problem "Compute $P(X>3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{{x}^{5}},\\, & x\\ge 1, \\\\ 0,\\, & x<1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>3) & =P(3\\le X<\\infty ) \\\\  & ={\\int }_{3}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{\\infty }\\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{{x}^{4}}]}_{3}^{\\infty } \\\\  & =\\frac{1}{81}.\\end{aligned}\n$$"} :step/id #uuid "1be2574c-a3ce-5ec0-bb9f-88e4dc8755a2" :step/next {:db/id #edb/ref 17592186421867}} {:db/id #edb/ref 17592186421869 :step/content {:db/id #edb/ref 17592186421865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146aee1a-528b-5bbf-a4b6-4fbf2f271f49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-20}" :db/id #edb/ref 17592186421853} {:answer/id #uuid "27715182-2cb9-52c2-a080-36df60c28e78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-5}" :db/id #edb/ref 17592186421854} {:answer/id #uuid "7e007eff-0deb-57f5-a6ba-37ea62edbf05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-4}" :db/id #edb/ref 17592186421856} {:answer/id #uuid "e008e939-3bb6-57fd-a8f3-41e658e78a3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-4/5}" :db/id #edb/ref 17592186421860} {:answer/id #uuid "f5c19772-5317-5a44-8357-af32f4360941" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-10}" :db/id #edb/ref 17592186421862}] :answer-field/correct {:db/id #edb/ref 17592186421853} :answer-field/id #uuid "55603476-e287-5779-991f-12f57c478278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186421863}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "168818a7-6140-5751-9382-8a48afe2a16e" :question/math-academy-id "q-87221" :question/problem "Compute $P(X<-5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}4{e}^{4x},\\, & x\\le 0, \\\\ 0,\\, & x>0.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X<-5) & =P(-\\infty <X<-5) \\\\  & ={\\int }_{-\\infty }^{-5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\infty }^{-5}4{e}^{4x}\\,\\text{d}x \\\\  & ={[{e}^{4x}]}_{-\\infty }^{-5} \\\\  & ={e}^{-20}.\\end{aligned}\n$$"} :step/id #uuid "fe10f7a6-87e1-5126-8846-1670d19ab5f3" :step/next {:db/id #edb/ref 17592186421868}}] :activity/title "Continuous Random Variables Over Infinite Domains" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421852}]}
