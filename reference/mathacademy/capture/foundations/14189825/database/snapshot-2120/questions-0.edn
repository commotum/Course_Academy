#{[{:db/id #edb/ref 17592186092134 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/id #uuid "82ba817e-a4a8-5465-b775-6cc601132b49" :question/math-academy-id "e-8383" :question/problem "Evaluate $\\cosh  (\\ln 2).$" :question/worked-solution "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092135 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/id #uuid "fe7322aa-03bf-5d6f-b432-0445510448b9" :question/math-academy-id "e-8384" :question/problem "Evaluate $\\tanh{4}.$" :question/worked-solution "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092139 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092292 :knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/id #uuid "b6742668-0b09-520f-bfb7-28bfa7630808" :question/math-academy-id "e-8738" :question/problem "Evaluate $\\sinh 1.$" :question/worked-solution "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317219 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31e2859b-1911-5ddf-b287-cfd0bab180a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186315407}] :answer-field/correct {:answer/id #uuid "31e2859b-1911-5ddf-b287-cfd0bab180a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186315407} :answer-field/id #uuid "fce87564-03a9-54f2-8024-58cd5097edab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee11962b-06b5-58e5-b379-0ac6c36480e1" :question/math-academy-id "q-342226" :question/problem "Evaluate $\\operatorname{cosh}⁡(-3).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(-3)=\\frac{1}{2}({e}^{-3}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-1) & =\\frac{1}{2}({e}^{-3}+{e}^{-(-3)}) \\\\  & =\\frac{1}{2}({e}^{-3}+{e}^{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317222 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab1e3e8b-9f87-5b5e-a976-a51d0768e2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{-6}" :db/id #edb/ref 17592186316082}] :answer-field/correct {:answer/id #uuid "ab1e3e8b-9f87-5b5e-a976-a51d0768e2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{-6}" :db/id #edb/ref 17592186316082} :answer-field/id #uuid "ba95289f-18dd-5116-a99f-879d1589a142" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b8021d6-72b1-52c8-a3b7-18e10c429aa8" :question/math-academy-id "q-342240" :question/problem "Given that $z>0,$ simplify $\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})=\\frac{1}{2}({z}^{6}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2}) & =\\frac{1}{2}({e}^{3\\operatorname{ln}⁡{z}^{2}}+{e}^{-3\\operatorname{ln}⁡{z}^{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{2})^{3}}+{e}^{\\operatorname{ln}⁡({z}^{2})^{-3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{6})}+{e}^{\\operatorname{ln}⁡({z}^{-6})}) \\\\  & =\\frac{1}{2}({z}^{6}+{z}^{-6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317311 :knowledge-point/_questions [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e47d621e-cdff-5357-b148-3425e4cf58f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4q}-1" :db/id #edb/ref 17592186316383}] :answer-field/correct {:answer/id #uuid "e47d621e-cdff-5357-b148-3425e4cf58f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4q}-1" :db/id #edb/ref 17592186316383} :answer-field/id #uuid "b091536a-d15b-5521-802a-52681500ba90" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316959}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23259978-e7e0-550b-9010-9b9edc527e53" :question/math-academy-id "q-342675" :question/problem "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092914 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a53aa52f-90ac-57a0-b498-dd9f9c7d749b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{3}}" :db/id #edb/ref 17592186091685} {:answer/id #uuid "b689e1d0-c63a-5bae-bb8b-7f3d93