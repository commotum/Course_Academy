\sqrt{y}})" :db/id #edb/ref 17592186358671} {:answer/id #uuid "872aa4d3-4a6e-54ea-a3eb-712760644a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-\\sqrt{y}}-{e}^{\\sqrt{y}})" :db/id #edb/ref 17592186358936} {:answer/id #uuid "9c6c82e5-ead3-5f80-90e3-9b5dd24d5b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({e}^{\\sqrt{y}}+{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186359119}] :answer-field/correct {:answer/id #uuid "575d37ba-596b-5e01-86cc-92dcdb4f4994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186358512} :answer-field/id #uuid "048cc927-9223-5417-96df-12798159ae68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360006}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb16eef-9811-51a5-921b-0ce2e8f2ed22" :question/math-academy-id "q-95493" :question/problem "Given that $y\\ge 0,$ which of the following is equivalent to $\\operatorname{sinh}⁡\\sqrt{y}?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡(\\sqrt{y})=\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}}).\n$$"}]}
