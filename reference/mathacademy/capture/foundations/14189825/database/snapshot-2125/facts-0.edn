frac{4}{\\sqrt{3}}" #edb/ref 17592186045417] [17592186091689 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186091689 #edb/ref 1083 #uuid "0759a8de-7381-51b2-8108-ad24a1cd1780" #edb/ref 17592186045417] [17592186092134 #edb/ref 1069 "e-8383" #edb/ref 17592186045417] [17592186092134 #edb/ref 1071 "Evaluate $\\cosh  (\\ln 2).$" #edb/ref 17592186045417] [17592186092134 #edb/ref 1072 #uuid "82ba817e-a4a8-5465-b775-6cc601132b49" #edb/ref 17592186045417] [17592186092134 #edb/ref 1074 "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092135 #edb/ref 1069 "e-8384" #edb/ref 17592186045417] [17592186092135 #edb/ref 1071 "Evaluate $\\tanh{4}.$" #edb/ref 17592186045417] [17592186092135 #edb/ref 1072 #uuid "fe7322aa-03bf-5d6f-b432-0445510448b9" #edb/ref 17592186045417] [17592186092135 #edb/ref 1074 "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092139 #edb/ref 1069 "e-8738" #edb/ref 17592186045417] [17592186092139 #edb/ref 1071 "Evaluate $\\sinh 1.$" #edb/ref 17592186045417] [17592186092139 #edb/ref 1072 #uuid "b6742668-0b09-520f-bfb7-28bfa7630808" #edb/ref 17592186045417] [17592186092139 #edb/ref 1074 "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092287 #edb/ref 1037 #edb/ref 17592186049879 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186092910 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186092914 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186317219 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186317220 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186317221 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186317222 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186360605 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186503688 #edb/ref 17592186045417] [17592186092287 #edb/ref 1038 #edb/ref 17592186503719 #edb/ref 17592186045417] [17592186092287 #edb/ref 1039 "Evaluating Hyperbolic Cosine" #edb/ref 17592186045417] [17592186092287 #edb/ref 1041 #edb/ref 17592186092134 #edb/ref 17592186045417] [17592186092287 #edb/ref 1042 #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186092908 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186092911 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186317309 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186317310 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186317311 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186360606 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186360607 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186373722 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186375013 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186375577 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186503664 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186503717 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186503752 #edb/ref 17592186045417] [17592186092288 #edb/ref 1038 #edb/ref 17592186503756 #edb/ref 17592186045417] [17592186092288 #edb/ref 1039 "Evaluating Hyperbolic Tangent" #edb/ref 17592186045417] [17592186092288 #edb/ref 1041 #edb/ref 17592186092135 #edb/ref 17592186045417] [17592186092288 #edb/ref 1042 #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186092907 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186092915 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186259802 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186317314 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186360602 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186360603 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186375563 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186503689 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186503718 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186503732 #edb/ref 17592186045417] [17592186092292 #edb/ref 1038 #edb/ref 17592186503737 #edb/ref 17592186045417] [17592186092292 #edb/ref 1039 "Evaluating Hyperbolic Sine" #edb/ref 17592186045417] [17592186092292 #edb/ref 1041 #edb/ref 17592186092139 #edb/ref 17592186045417] [17592186092292 #edb/ref 1042 #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093151 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093152 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093156 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093157 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093161 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093162 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093163 #edb/ref 17592186045417] [17592186092451 #edb/ref 1043 #edb/ref 17592186093164 #edb/ref 17592186045417] [17592186092451 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186092451 #edb/ref 1045 "The Hyperbolic Functions" #edb/ref 17592186045417] [17592186092451 #edb/ref 1046 #edb/ref 17592186093156 #edb/ref 17592186045417] [17592186092451 #edb/ref 1049 #edb/ref 17592186050125 #edb/ref 17592186045417] [17592186092451 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186092451 #edb/ref 1053 #uuid "2b71ea3d-d342-5e39-b2f8-caade1f5c635" #edb/ref 17592186045417] [17592186092914 #edb/ref 1068 #edb/ref 17592186091684 #edb/ref 17592186045417] [17592186092914 #edb/ref 1069 "q-9444" #edb/ref 17592186045417] [17592186092914 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186092914 #edb/ref 1071 "$\\operatorname{cosh}⁡(\\operatorname{ln}⁡\\sqrt{3})=$" #edb/ref 17592186045417] [17592186092914 #edb/ref 1072 #uuid "c4787d6a-19d8-5cd2-8f30-49b11ddf2a09" #edb/ref 17592186045417] [17592186092914 #edb/ref 1074 "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡\\sqrt{3}) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{3}}+{e}^{-\\operatorname{ln}⁡\\sqrt{3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{3}}+{e}^{\\operatorname{ln}⁡(1/\\sqrt{3})}) \\\\  & =\\frac{1}{2}(\\sqrt{3}+\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{1}{2}(\\frac{3+1}{\\sqrt{3}}) \\\\  & =\\frac{4}{2\\sqrt{3}} \\\\  & =\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186093151 #edb/ref 1058 #edb/ref 17592186093162 #edb/ref 17592186045417] [17592186093151 #edb/ref 1061 31232 #edb/ref 17592186045417] [17592186093151 #edb/ref 1062 #uuid "3eb1abcd-41b5-5663-bcb8-e235db24de72" #edb/ref 17592186045417] [17592186093151 #edb/ref 1063 #edb/ref 17592186092287 #edb/ref 17592186045417] [17592186093152 #edb/ref 1058 #edb/ref 17592186093163 #edb/ref 17592186045417] [17592186093152 #edb/ref 1061 31233 #edb/ref 17592186045417] [17592186093152 #edb/ref 1062 #uuid "af761e6d-05bd-5755-bb69-7c203849fd2d" #edb/ref 17592186045417] [17592186093152 #edb/ref 1063 #edb/ref 17592186092288 #edb/ref 17592186045417] [17592186093156 #edb/ref 1058 #edb/ref 17592186093151 #edb/ref 17592186045417] [17592186093156 #edb/ref 1061 32506 #edb/ref 17592186045417] [17592186093156 #edb/ref 1062 #uuid "96536404-77db-5be0-a7b5-e491277534a0" #edb/ref 17592186045417] [17592186093156 #edb/ref 1063 #edb/ref 17592186093453 #edb/ref 17592186045417] [17592186093157 #edb/ref 1058 #edb/ref 17592186093161 #edb/ref 17592186045417] [17592186093157 #edb/ref 1061 32508 #edb/ref 17592186045417] [17592186093157 #edb/ref 1062 #uuid "6f9ada3a-1270-57ef-b7e9-93e0c156fced" #edb/ref 17592186045417] [17592186093157 #edb/ref 1063 #edb/ref 17592186092292 #edb/ref 17592186045417] [17592186093161 #edb/ref 1058 #edb/ref 17592186093152 #edb/ref 17592186045417] [17592186093161 #edb/ref 1061 33478 #edb/ref 17592186045417] [17592186093161 #edb/ref 1062 #uuid "bbbe6b95-5545-53ed-accd-35b1c0f9d7e3" #edb/ref 17592186045417] [17592186093161 #edb/ref 1063 #edb/ref 17592186093456 #edb/ref 17592186045417] [17592186093162 #edb/ref 1058 #edb/ref 17592186093157 #edb/ref 17592186045417] [17592186093162 #edb/ref 1061 33479 #edb/ref 17592186045417] [17592186093162 #edb/ref 1062 #uuid "499cb6ba-3bb8-5878-9f84-8eb8b9375734" #edb/ref 17592186045417] [17592186093162 #edb/ref 1063 #edb/ref 17592186093457 #edb/ref 17592186045417] [17592186093163 #edb/ref 1058 #edb/ref 17592186093164 #edb/ref 17592186045417] [17592186093163 #edb/ref 1061 33480 #edb/ref 17592186045417] [17592186093163 #edb/ref 1062 #uuid "2760223b-967b-5d7a-bf06-8aba754add4f" #edb/ref 17592186045417] [17592186093163 #edb/ref 1063 #edb/ref 17592186093458 #edb/ref 17592186045417] [17592186093164 #edb/ref 1061 33481 #edb/ref 17592186045417] [17592186093164 #edb/ref 1062 #uuid "ddc723e1-15ec-5f40-af96-e10446b0b11f" #edb/ref 17592186045417] [17592186093164 #edb/ref 1063 #edb/ref 17592186093459 #edb/ref 17592186045417] [17592186093453 #edb/ref 1064 "The **hyperbolic functions** are functions defined using the exponential functions $e^x$ and $e^{-x}.$ As we will see at the end of the lesson, hyperbolic functions are closely related to trigonometric functions. \n\nThe **hyperbolic cosine** (abbreviated and pronounced \"cosh\") is defined as\n\n$$\n\\cosh x=  \\dfrac12\\left(e^x+e^{-x}\\right).\n$$\n\nThe graph of $y=\\cosh x$ is shown below.\n\n![](images/28/286e0b946edf5c8a8eb23753aaef79812d7c1e7471ab32f43eda81795fb7f47a.png)\n\nThe function $y=\\cosh x$ is not a parabola, although it may look like one.\n\nNote the following properties of $y=\\cosh x\\mathbin{:}$\n\n- Its domain is $x\\in (-\\infty, \\infty).$\n\n- Its range is $y \\geq 1.$\n\n- It is an even function.\n\nTo evaluate $\\cosh x$ at some value, say $x=2,$ we simply substitute our value into the definition:\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡2=\\frac{1}{2}({e}^{2}+{e}^{-2})≈3.7622\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186093453 #edb/ref 1065 5174 #edb/ref 17592186045417] [17592186093453 #edb/ref 1066 #uuid "f755a3d4-5480-58af-98eb-79632e4e5487" #edb/ref 17592186045417] [17592186093453 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186093456 #edb/ref 1064 "Just as we do with trigonometric functions, we can use the basic hyperbolic functions $\\sinh x$ and $\\cosh x$ to create more hyperbolic functions.\n\nThe **hyperbolic tangent** (pronounced \"tanch\") is defined as \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x=\\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\,\\,\\,.\\end{aligned}\n$$\n\nThe graph of $y=\\tanh x$ is shown below.\n\n![](images/ac/ac244e57465dc7588094b3b6dae74bfc954f4705be6a2f5edbba2db3e6eeaa9d.png)\n\nNote the following properties of $y=\\tanh x\\mathbin{:}$\n\n- Its domain is $x\\in (-\\infty, \\infty).$\n\n- Its range is $y \\in (-1,1).$\n\n- It has horizontal asymptotes $y=\\pm 1.$\n\n- It is an odd function.\n\nWe can write down an equivalent definition of $\\tanh{x}$ by multiplying the numerator and denominator by $e^x\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\cdot \\,\\frac{{e}^{x}}{{e}^{x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1}\\end{aligned}\n$$\n\nThe third definition of $\\tanh{x}$ can be found by multiplying the numerator and denominator of our original definition by $e^{-x}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}}\\,\\cdot \\,\\frac{{e}^{-x}}{{e}^{-x}} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}\\end{aligned}\n$$\n\nWe can use any definition of $\\tanh x$ that we like for a given situation. However, it's often convenient to use the second or third definition when evaluating a function containing $\\tanh{x},$ because they include fewer exponential terms than the first definition." #edb/ref 17592186045417] [17592186093456 #edb/ref 1065 5349 #edb/ref 17592186045417] [17592186093456 #edb/ref 1066 #uuid "7b72785b-08ed-596c-b5ce-087f1a9a30bb" #edb/ref 17592186045417] [17592186093456 #edb/ref 1067 "Hyperbolic Tangent" #edb/ref 17592186045417] [17592186093457 #edb/ref 1064 "The **hyperbolic sine** (pronounced \"shine\") is defined as\n\n$$\n\\sinh x= \\dfrac12\\left(e^x-e^{-x}\\right).\n$$\n\nThe graph of $y=\\sinh x$ is shown below.\n\n![](images/9b/9bf940b5f8d9686e5e188eef00ab1b9c975803efa76dad21070e0697b69fe07b.png)\n\nNote the following properties of $y=\\sinh x\\mathbin{:}$\n\n- Its domain is $x\\in (-\\infty, \\infty).$\n\n- Its range is $y \\in (-\\infty, \\infty).$\n\n- It is an odd function." #edb/ref 17592186045417] [17592186093457 #edb/ref 1065 5350 #edb/ref 17592186045417] [17592186093457 #edb/ref 1066 #uuid "0256e102-6d61-5f40-b571-71cf0b097bc5" #edb/ref 17592186045417] [17592186093457 #edb/ref 1067 "Hyperbolic Sine" #edb/ref 17592186045417] [17592186093458 #edb/ref 1064 "There is a deep connection between trigonometric and hyperbolic functions. This means that we can use a lot of our knowledge of trigonometry to solve problems containing hyperbolic functions.\n\nTo see how they are connected, we need to go back to Euler's formula:\n\n$$\ne^{\\textrm i\\theta} = \\cos\\theta + \\textrm i\\sin\\theta\n$$\n\nBy replacing $\\theta$ with $-\\theta,$ we get\n\n$$\ne^{-\\textrm i\\theta} = \\cos\\theta - \\textrm i\\sin\\theta.\n$$\n\nAdding the two equations gives\n\n$$\ne^{\\textrm i\\theta}  + e^{-\\textrm i\\theta} = 2\\cos\\theta.\n$$\n\nMaking $\\cos\\theta$ the subject, we get\n\n$$\n\\cos\\theta = \\dfrac12\\left(e^{\\textrm i\\theta}  + e^{-\\textrm i\\theta}\\right).\n$$\n\nNotice that the right-hand side is identical to $\\cosh(\\textrm i\\theta).$ This means that we have the identity\n\n$$\n\\cos\\theta = \\cosh(\\textrm i\\theta).\n$$" #edb/ref 17592186045417] [17592186093458 #edb/ref 1065 5351 #edb/ref 17592186045417] [17592186093458 #edb/ref 1066 #uuid "5f503ef1-e265-5556-88fa-e09f0cd4f2b8" #edb/ref 17592186045417] [17592186093458 #edb/ref 1067 "The Relationship Between Trigonometric and Hyperbolic Cosine" #edb/ref 17592186045417] [17592186093459 #edb/ref 1064 "We can similarly derive a link between $\\sin\\theta$ and $\\sinh\\theta.$ To do this, let's recall Euler's formula once more.\n\n$$\ne^{\\textrm i\\theta} = \\cos\\theta + \\textrm i\\sin\\theta\n$$\n\nWe also have\n\n$$\ne^{-\\textrm i\\theta} = \\cos\\theta - \\textrm i\\sin\\theta.\n$$\n\nSubtracting the two equations, we get\n\n$$\ne^{\\textrm i\\theta}  - e^{-\\textrm i\\theta} = 2\\textrm i\\sin\\theta.\n$$\n\nMaking $\\sin\\theta$ the subject of the equation, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{1}{2\\text{i}}({e}^{\\text{i}\\theta }-{e}^{-\\text{i}\\theta }) \\\\  & =-\\frac{\\text{i}}{2}({e}^{\\text{i}\\theta }-{e}^{-\\text{i}\\theta }),\\end{aligned}\n$$\n\nwhich gives us the identity\n\n$$\n\\sin\\theta = -\\textrm i \\sinh(\\textrm i\\theta).\n$$" #edb/ref 17592186045417] [17592186093459 #edb/ref 1065 5352 #edb/ref 17592186045417] [17592186093459 #edb/ref 1066 #uuid "0cbbf1b5-b7b6-5f5f-bd71-38b85f438621" #edb/ref 17592186045417] [17592186093459 #edb/ref 1067 "The Relationship Between Trigonometric and Hyperbolic Sine" #edb/ref 17592186045417] [17592186315407 #edb/ref 1080 "{e}^{3}" #edb/ref 17592186045417] [17592186315407 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315407 #edb/ref 1083 #uuid "31e2859b-1911-5ddf-b287-cfd0bab180a4" #edb/ref 17592186045417] [17592186316082 #edb/ref 1080 "{z}^{-6}" #edb/ref 17592186045417] [17592186316082 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186316082 #edb/ref 1083 #uuid "ab1e3e8b-9f87-5b5e-a976-a51d0768e2a0" #edb/ref 17592186045417] [17592186316383 #edb/ref 1080 "{e}^{4q}-1" #edb/ref 17592186045417] [17592186316383 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186316383 #edb/ref 1083 #uuid "e47d621e-cdff-5357-b148-3425e4cf58f9" #edb/ref 17592186045417] [17592186316959 #edb/ref 1075 #edb/ref 17592186316383 #edb/ref 17592186045417] [17592186316959 #edb/ref 1075 #edb/ref 17592186503065 #edb/ref 17592186045417] [17592186316959 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186316959 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186316959 #edb/ref 1078 #edb/ref 17592186503065 #edb/ref 17592186045417] [17592186316959 #edb/ref 1079 #uuid "b091536a-d15b-5521-802a-52681500ba90" #edb/ref 17592186045417] [17592186316986 #edb/ref 1075 #edb/ref 17592186316082 #edb/ref 17592186045417] [17592186316986 #edb/ref 1075 #edb/ref 17592186503103 #edb/ref 17592186045417] [17592186316986 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186316986 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186316986 #edb/ref 1078 #edb/ref 17592186503103 #edb/ref 17592186045417] [17592186316986 #edb/ref 1079 #uuid "ba95289f-18dd-5116-a99f-879d1589a142" #edb/ref 17592186045417] [17592186317148 #edb/ref 1075 #edb/ref 17592186315407 #edb/ref 17592186045417] [17592186317148 #edb/ref 1075 #edb/ref 17592186503005 #edb/ref 17592186045417] [17592186317148 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186317148 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186317148 #edb/ref 1078 #edb/ref 17592186503005 #edb/ref 17592186045417] [17592186317148 #edb/ref 1079 #uuid "fce87564-03a9-54f2-8024-58cd5097edab" #edb/ref 17592186045417] [17592186317219 #edb/ref 1068 #edb/ref 17592186317148 #edb/ref 17592186045417] [17592186317219 #edb/ref 1069 "q-342226" #edb/ref 17592186045417] [17592186317219 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186317219 #edb/ref 1071 "Evaluate $\\operatorname{cosh}⁡(-3).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(-3)=\\frac{1}{2}({e}^{-3}\\,+$ {{field-1}} $)$" #edb/ref 17592186045417] [17592186317219 #edb/ref 1072 #uuid "ee11962b-06b5-58e5-b379-0ac6c36480e1" #edb/ref 17592186045417] [17592186317219 #edb/ref 1074 "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-1) & =\\frac{1}{2}({e}^{-3}+{e}^{-(-3)}) \\\\  & =\\frac{1}{2}({e}^{-3}+{e}^{3}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186317222 #edb/ref 1068 #edb/ref 17592186316986 #edb/ref 17592186045417] [17592186317222 #edb/ref 1069 "q-342240" #edb/ref 17592186045417] [17592186317222 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186317222 #edb/ref 1071 "Given that $z>0,$ simplify $\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})=\\frac{1}{2}({z}^{6}\\,+$ {{field-1}} $)$" #edb/ref 17592186045417] [17592186317222 #edb/ref 1072 #uuid "6b8021d6-72b1-52c8-a3b7-18e10c429aa8" #edb/ref 17592186045417] [17592186317222 #edb/ref 1074 "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2}) & =\\frac{1}{2}({e}^{3\\operatorname{ln}⁡{z}^{2}}+{e}^{-3\\operatorname{ln}⁡{z}^{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{2})^{3}}+{e}^{\\operatorname{ln}⁡({z}^{2})^{-3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{6})}+{e}^{\\operatorname{ln}⁡({z}^{-6})}) \\\\  & =\\frac{1}{2}({z}^{6}+{z}^{-6}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186317311 #edb/ref 1068 #edb/ref 17592186316959 #edb/ref 17592186045417] [17592186317311 #edb/ref 1069 "q-342675" #edb/ref 17592186045417] [17592186317311 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186317311 #edb/ref 1071 "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" #edb/ref 17592186045417] [17592186317311 #edb/ref 1072 #uuid "23259978-e7e0-550b-9010-9b9edc527e53" #edb/ref 17592186045417] [17592186317311 #edb/ref 1074 "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186358512 #edb/ref 1080 "\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" #edb/ref 17592186045417] [17592186358512 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186358512 #edb/ref 1083 #uuid "575d37ba-596b-5e01-86cc-92dcdb4f4994" #edb/ref 17592186045417] [17592186358596 #edb/ref 1080 "2({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" #edb/ref 17592186045417] [17592186358596 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186358596 #edb/ref 1083 #uuid "608f7525-f317-5fe0-8a22-a5bcd38d02e4" #edb/ref 17592186045417] [17592186358671 #edb/ref 1080 "\\frac{1}{2}({e}^{\\sqrt{y}}+{e}^{-\\sqrt{y}})" #edb/ref 17592186045417] [17592186358671 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186358671 #edb/ref 1083 #uuid "68e76021-dc84-50c5-9aec-a563ee8d1203" #edb/ref 17592186045417] [17592186358936 #edb/ref 1080 "\\frac{1}{2}({e}^{-\\sqrt{y}}-{e}^{\\sqrt{y}})" #edb/ref 17592186045417] [17592186358936 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186358936 #edb/ref 1083 #uuid "872aa4d3-4a6e-54ea-a3eb-712760644a68" #edb/ref 17592186045417] [17592186359119 #edb/ref 1080 "2({e}^{\\sqrt{y}}+{e}^{-\\sqrt{y}})" #edb/ref 17592186045417] [17592186359119 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359119 #edb/ref 1083 #uuid "9c6c82e5-ead3-5f80-90e3-9b5dd24d5b3a" #edb/ref 17592186045417] [17592186360006 #edb/ref 1075 #edb/ref 17592186358512 #edb/ref 17592186045417] [17592186360006 #edb/ref 1075 #edb/ref 17592186358596 #edb/ref 17592186045417] [17592186360006 #edb/ref 1075 #edb/ref 17592186358671 #edb/ref 17592186045417] [17592186360006 #edb/ref 1075 #edb/ref 17592186358936 #edb/ref 17592186045417] [17592186360006 #edb/ref 1075 #edb/ref 17592186359119 #edb/ref 17592186045417] [17592186360006 #edb/ref 1076