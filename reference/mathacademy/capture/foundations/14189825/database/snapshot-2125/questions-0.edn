#{[{:db/id #edb/ref 17592186092134 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/id #uuid "82ba817e-a4a8-5465-b775-6cc601132b49" :question/math-academy-id "e-8383" :question/problem "Evaluate $\\cosh  (\\ln 2).$" :question/worked-solution "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092135 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/id #uuid "fe7322aa-03bf-5d6f-b432-0445510448b9" :question/math-academy-id "e-8384" :question/problem "Evaluate $\\tanh{4}.$" :question/worked-solution "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092139 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092292 :knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/id #uuid "b6742668-0b09-520f-bfb7-28bfa7630808" :question/math-academy-id "e-8738" :question/problem "Evaluate $\\sinh 1.$" :question/worked-solution "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503688 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cf99c6-7c24-52e7-be8a-8a9fb4ef2e41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}}-{e}^{-\\sqrt{5}})" :db/id #edb/ref 17592186503002} {:answer/id #uuid "56552855-f1e7-5ca3-aa77-2b042b5de66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}/2}+{e}^{-\\sqrt{5}/2})" :db/id #edb/ref 17592186503148} {:answer/id #uuid "c91d4c39-01d7-575d-8878-a11bbceababe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-\\sqrt{5}/2}-{e}^{\\sqrt{5}/2})" :db/id #edb/ref 17592186503381} {:answer/id #uuid "e1e53f20-9b6f-54ab-a51f-65baa20ab8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-\\sqrt{5}}-{e}^{\\sqrt{5}})" :db/id #edb/ref 17592186503442} {:answer/id #uuid "f6466783-f231-50c1-96ff-206d27740ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}}+{e}^{-\\sqrt{5}})" :db/id #edb/ref 17592186503484}] :answer-field/correct {:answer/id #uuid "f6466783-f231-50c1-96ff-206d27740ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{5}}+{e}^{-\\sqrt{5}})" :db/id #edb/ref 