 $e$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(-\\frac{3x}{4})=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-\\frac{3x}{4}) & =\\frac{1}{2}({e}^{-3x/4}+{e}^{-(-3x/4)}) \\\\  & =\\frac{1}{2}({e}^{-3x/4}+{e}^{3x/4}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317219 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31e2859b-1911-5ddf-b287-cfd0bab180a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186315407} {:answer/id #uuid "0aab7419-cbe8-5fc5-bb0b-aeb4216e8808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3}" :db/id #edb/ref 17592186503005}] :answer-field/correct {:answer/id #uuid "0aab7419-cbe8-5fc5-bb0b-aeb4216e8808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{3}" :db/id #edb/ref 17592186503005} :answer-field/id #uuid "fce87564-03a9-54f2-8024-58cd5097edab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317148}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee11962b-06b5-58e5-b379-0ac6c36480e1" :question/math-academy-id "q-342226" :question/problem "Evaluate $\\operatorname{cosh}⁡(-3).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(-3)=\\frac{1}{2}({e}^{-3}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-1) & =\\frac{1}{2}({e}^{-3}+{e}^{-(-3)}) \\\\  & =\\frac{1}{2}({e}^{-3}+{e}^{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317222 :knowledge-point/_questions [{:db/id #edb/ref 17592186092287 :knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab1e3e8b-9f87-5b5e-a976-a51d0768e2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{z}^{-6}" :db/id #edb/ref 17592186316082} {:answer/id #uuid "4074f6b7-e649-530f-8bb2-231153d8d5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z^{-6}" :db/id #edb/ref 17592186503103}] :answer-field/correct {:answer/id #uuid "4074f6b7-e649-530f-8bb2-231153d8d5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z^{-6}" :db/id #edb/ref 17592186503103} :answer-field/id #uuid "ba95289f-18dd-5116-a99f-879d1589a142" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b8021d6-72b1-52c8-a3b7-18e10c429aa8" :question/math-academy-id "q-342240" :question/problem "Given that $z>0,$ simplify $\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})=\\frac{1}{2}({z}^{6}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2}) & =\\frac{1}{2}({e}^{3\\operatorname{ln}⁡{z}^{2}}+{e}^{-3\\operatorname{ln}⁡{z}^{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{2})^{3}}+{e}^{\\operatorname{ln}⁡({z}^{2})^{-3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{6})}+{e}^{\\operatorname{ln}⁡({z}^{-6})}) \\\\  & =\\frac{1}{2}({z}^{6}+{z}^{-6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503664 :knowledge-point/_questions [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fca01d-214c-5770-b687-855abe991a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{3}-1" :db/id #edb/ref 17592186503112}] :answer-field/correct {:answer/id #uuid "43fca01d-214c-5770-b687-855abe991a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{3}-1" :db/id #edb/ref 17592186503112} :answer-field/id #uuid "a268cdd9-081d-55c2-903c-5d29e55e0ccc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503598}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1e63bbce-6bf5-50ed-a823-bd6bd4ad0965" :question/math-academy-id "q-342673" :question/problem "Simplify $tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x)$ using the definition of the hyperbolic tangent.\n\n$tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x)=$\n\n| {{field-1}} |\n| --- |\n| ${x}^{3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,(\\frac{3}{2}\\operatorname{ln}⁡x) & =\\frac{{e}^{2(\\frac{3}{2}\\operatorname{ln}⁡x)}-1}{{e}^{2(\\frac{3}{2}\\operatorname{ln}⁡x)}+1} \\\\  & =\\frac{{e}^{3\\operatorname{ln}⁡x}-1}{{e}^{3\\operatorname{ln}⁡x}+1} \\\\  & =\\frac{{e}^{\\operatorname{ln}⁡{x}^{3}}-1}{{e}^{\\operatorname{ln}⁡{x}^{3}}+1} \\\\  & =\\frac{{x}^{3}-1}{{x}^{3}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317311 :knowledge-point/_questions [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e47d621e-cdff-5357-b148-3425e4cf58f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4q}-1" :db/id #edb/ref 17592186316383} {:answer/id #uuid "2decd2dd-0162-5cec-a8e5-6a1fb6aa9937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4q}-1" :db/id #edb/ref 17592186503065}] :answer-field/correct {:answer/id #uuid "2decd2dd-0162-5cec-a8e5-6a1fb6aa9937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4q}-1" :db/id #edb/ref 17592186503065} :answer-field/id #uuid "b091536a-d15b-5521-802a-52681500ba90" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316959}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23259978-e7e0-550b-9010-9b9edc527e53" :question/math-academy-id "q-342675" :question/problem "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503717 :knowledge-point/_questions [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{2k}{3}}-1" :db/id #edb/ref 17592186503362}] :answer-field/correct {:answer/id #uuid "be416ad7-fa5c-5f2a-8f8e-5c23bca4c530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{2k}{3}}-1" :db/id #edb/ref 17592186503362} :answer-field/id #uuid "e28fb333-812f-5331-bf83-e683ff5050d2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "957cf846-05af-527e-b9b5-8a808e2c175e" :question/math-academy-id "q-342677" :question/problem "Simplify $tanh\\,(\\frac{k}{3})$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$tanh\\,(\\frac{k}{3})=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{2k/3}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}tanh\\,(\\frac{k}{3}) & =\\frac{{e}^{2(k/3)}-1}{{e}^{2(k/3)}+1} \\\\  & =\\frac{{e}^{2k/3}-1}{{e}^{2k/3}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186503732 :knowledge-point/_questions [{:db/id #edb/ref 17592186092292 :knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae355e57-f688-5172-8dd6-f32ed5aea3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(e^{5x}-e^{-5x}\\right)" :db/id #edb/ref 17592186503332}] :answer-field/correct {:answer/id #uuid "ae355e57-f688-5172-8dd6-f32ed5aea3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(e^{5x}-e^{-5x}\\right)" :db/id #edb/ref 17592186503332} :answer-field/id #uuid "0c0b8b32-f645-55ea-a6f7-813ca2348e58" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503520}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4db71bf-bb20-5cb8-bf0c-68dc6c798e64" :question/math-academy-id "q-342686" :question/problem "Express $\\operatorname{sinh}⁡5x$ in terms of $e$ using the definition of the hyperbolic sine.\n\n$\\operatorname{sinh}⁡5x=$\n {{field-1}}" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡5x=\\frac{1}{2}({e}^{5x}-{e}^{-5x}).\n$$"}] [{:db/id #edb/ref 17592186503737 :knowledge-point/_questions [{:db/id #edb/ref 17592186092292 :knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186503212}] :answer-field/correct {:answer/id #uuid "71d7d57f-eadd-59fa-9fed-90fc5e33c3bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186503212} :answer-field/id #