 & =\\frac{{z}^{4}-1}{2{z}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360603 :knowledge-point/_questions [{:db/id #edb/ref 17592186092292 :knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "575d37ba-596b-5e01-86cc-92dcdb4f4994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186358512} {:answer/id #uuid "608f7525-f317-5fe0-8a22-a5bcd38d02e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186358596} {:answer/id #uuid "68e76021-dc84-50c5-9aec-a563ee8d1203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{y}}+{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186358671} {:answer/id #uuid "872aa4d3-4a6e-54ea-a3eb-712760644a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-\\sqrt{y}}-{e}^{\\sqrt{y}})" :db/id #edb/ref 17592186358936} {:answer/id #uuid "9c6c82e5-ead3-5f80-90e3-9b5dd24d5b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({e}^{\\sqrt{y}}+{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186359119}] :answer-field/correct {:answer/id #uuid "575d37ba-596b-5e01-86cc-92dcdb4f4994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}})" :db/id #edb/ref 17592186358512} :answer-field/id #uuid "048cc927-9223-5417-96df-12798159ae68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360006}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb16eef-9811-51a5-921b-0ce2e8f2ed22" :question/math-academy-id "q-95493" :question/problem "Given that $y\\ge 0,$ which of the following is equivalent to $\\operatorname{sinh}⁡\\sqrt{y}?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡(\\sqrt{y})=\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}}).\n$$"}] [{:db/id #edb/ref 17592186503752 :knowledge-point/_questions [{:db/id #edb/ref 17592186092288 :knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a3886a5-1d7a-5ca7-8738-12d8ef255d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{e}}{1-\\sqrt{e}}" :db/id #edb/ref 17592186503120} {:answer/id #uuid "79feb6a3-fd63-5722-bf1a-1b17b2a99447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186503231} {:answer/id #uuid "993d1f00-a0df-5f47-8016-9bb479cdc26d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+e}{1-e}" :db/id #edb/ref 17592186503285} {:answer/id #uuid "c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-e}{1+e}" :db/id #edb/ref 17592186503380} {:answer/id #uuid "d3b2a103-ca01-59e5-8aa6-8e7ebc6ce6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{e}}{1+\\sqrt{e}}" :db/id #edb/ref 17592186503401}] :answer-field/correct {:answer/id #uuid "c8cb142d-3a7c-5922-acfe-51b1201c66ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-e}{1+e}" :db/id #edb/ref 17592186503380} :answer-field/id #uuid "3878f530-02bd-58fa-8a92-0929a7b051c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503538}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea77914f-6e86-5cb0-a566-942e82f36dc8" :question/math-academy-id "q-95601" :question/problem "$\\operatorname{tanh}⁡(-\\frac{1}{2})=$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\frac{1}{2}) & =\\frac{1-{e}^{-2(-1/2)}}{1+{e}^{-2(-1/2)}} \\\\  & =\\frac{1-e}{1+e}.\\end{aligned}\n$$"}]}
