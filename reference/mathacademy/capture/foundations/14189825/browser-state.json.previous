    "q-125343": {
      "dom_id": "step-q125343",
      "name": "Question 4",
      "problem": "$\\operatorname{cosh}⁡(\\sqrt{5})=$",
      "worked_solution": "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\sqrt{5}) & =\\frac{1}{2}({e}^{\\sqrt{5}}+{e}^{-\\sqrt{5}}).\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-125343-a",
