end{aligned}\n$$"} :step/id #uuid "7cd92d7a-8193-53d1-bf92-9e1fa1598872" :step/next {:db/id #edb/ref 17592186505848}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505097}]}
