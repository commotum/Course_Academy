#{[{:db/id #edb/ref 17592186406840 :knowledge-point/_questions [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3fa2ee-eac1-54f7-a4c6-ec5b539510f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186406810} {:answer/id #uuid "b15a9656-7038-5a55-bf9f-c3d46f455338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186406823} {:answer/id #uuid "cc277bfe-8316-5960-ad00-41d18d0bb79e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186406826} {:answer/id #uuid "e7eb8255-65e0-55e8-9452-62dfb2f06a3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186406828} {:answer/id #uuid "e84109bf-1001-5843-8805-1788b156098c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186406829}] :answer-field/correct {:answer/id #uuid "e84109bf-1001-5843-8805-1788b156098c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186406829} :answer-field/id #uuid "28b8502d-f01b-56da-9de3-fce2aa5353e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7bb2599b-79c3-5637-9b4b-ca26bce210be" :question/math-academy-id "q-140098" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,y-2z=0}.$" :question/worked-solution "Solving $y-2z=0$ for $y,$ we get $y=2z.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ 2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186365087 :knowledge-point/_questions [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a0bbbf-f8e6-5ff8-a774-523eba137101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186365089} {:answer/id #uuid "5b688d64-abb8-5a38-8edc-bc94b0118770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186365090} {:answer/id #uuid "2121fe31-752e-5401-983c-6d4ca2203ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186365091} {:answer/id #uuid "da4e7866-c227-5c19-a1e3-e2bf043ecaf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186365092} {:answer/id #uuid "65f39a3a-d0a4-51c0-9f76-7f9af3dbe0d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365093}] :answer-field/correct {:answer/id #uuid "2121fe31-752e-5401-983c-6d4ca2203ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186365091} :answer-field/id #uuid "21b56c28-66a7-5c9c-958b-62a19e62e9a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365088}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d46dc660-c500-5191-bb8e-c57af2a79535" :question/math-academy-id "q-141432" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,x-y+2z=0}.$" :question/worked-solution "Solving $x-y+2z=0$ for $y,$ we get $y=x+2z.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ x+2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366427 :knowledge-point/_questions [{:db/id #edb/ref 17592186188273 :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6b563a-739c-5aa6-aa3d-91cf2bda7eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469302} {:answer/id #uuid "0ae5e117-a505-5a04-81e4-439b74052c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303}] :answer-field/correct {:answer/id #uuid "0ae5e117-a505-5a04-81e4-439b74052c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469303} :answer-field/id #uuid "0829ea20-3a9e-5bac-9aac-a20a5031708f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470263} {:answer-field/choices [{:answer/id #uuid "86ea0788-dc9f-5b43-b4d9-3e6d92f4a3f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469304} {:answer/id #uuid "16e976b2-1f3b-5daf-bc6f-ee9f3ff92e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305}] :answer-field/correct {:answer/id #uuid "16e976b2-1f3b-5daf-bc6f-ee9f3ff92e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469305} :answer-field/id #uuid "55766021-6ec3-5fd5-927e-a3d5966052e8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470264} {:answer-field/choices [{:answer/id #uuid "584ceae8-0e69-5969-b025-a8dfde1e4426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} {:answer/id #uuid "24a75a78-d9f9-590b-98ed-a75a55f1195e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469307}] :answer-field/correct {:answer/id #uuid "584ceae8-0e69-5969-b025-a8dfde1e4426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469306} :answer-field/id #uuid "44fe36b7-f90a-541a-a159-56cfdbf08c21" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f6a64ec-417d-5f3c-a079-819cbc656ca3" :question/math-academy-id "q-83440" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2}}$ be a set of linearly independent vectors in ${R}^{3}.$ Consider the following statement:\n\n*If  $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$, then $\\text{__________}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{nullity}(T)=2$\n- **II.** $\\text{rank}(T)=1$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}$ and the set ${{v}_{1},{v}_{2}}$ is linearly independent, we get that $\\text{nullity}(T)=2.$\n\n- Statement II is true. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 3$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I and II only.\""}] [{:db/id #edb/ref 17592186366441 :knowledge-point/_questions [{:db/id #edb/ref 17592186188281 :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248a5e8c-2665-5c3b-bc76-2d4de5451af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information." :db/id #edb/ref 17592186366443} {:answer/id #uuid "a63c65d1-5c18-570e-8960-1b52338c60f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366444} {:answer/id #uuid "b1865736-9107-58e9-aaa4-24fa5ace9aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186366445} {:answer/id #uuid "1cd1c025-f90e-5cb1-8335-7715549b6128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186366446} {:answer/id #uuid "1cd43ae6-1011-54b6-8471-e14df44fd9c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366447}] :answer-field/correct {:answer/id #uuid "a63c65d1-5c18-570e-8960-1b52338c60f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186366444} :answer-field/id #uuid "b01eaafe-12ed-57fc-a8e9-276511a00549" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366442}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2cc1677-8220-5afa-89bb-f3b005d1f893" :question/math-academy-id "q-83447" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and $\\text{Im}(T)={[x,y,z,w]^{T}\\,:\\,x=2z,\\,\\,y=w}.$" :question/worked-solution "Any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}2z \\\\ w \\\\ z \\\\ w\\end{aligned}]=z{{[\\begin{aligned}2 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+w{{[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =4-\\text{rank}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"}]}
