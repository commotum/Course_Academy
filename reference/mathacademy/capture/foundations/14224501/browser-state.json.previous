      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224501/observations/step-q126709-366a7dce5a528ab7c61b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224501/observations/step-q126709-366a7dce5a528ab7c61b.png",
