#{[{:activity/first-step {:db/id #edb/ref 17592186176758} :activity/id #uuid "65577ea0-355f-53b3-aa11-85167afdbda8" :activity/scope {:db/id #edb/ref 17592186050913 :topic/id #uuid "70cae1cb-dd81-5ef6-8e36-14c86064b3f2" :topic/math-academy-id 3628} :activity/steps [{:db/id #edb/ref 17592186176726 :step/content {:db/id #edb/ref 17592186175982 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175832 :question/id #uuid "acac66ab-ff2a-5727-8a2c-9cce3e18806c" :question/math-academy-id "e-9036"} :knowledge-point/id #uuid "cb9cfe3a-6341-5a25-a513-8ef20b5a7f7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049562} {:db/id #edb/ref 17592186051032}] :knowledge-point/questions [{:db/id #edb/ref 17592186176218} {:db/id #edb/ref 17592186176220} {:db/id #edb/ref 17592186244156} {:db/id #edb/ref 17592186244157} {:db/id #edb/ref 17592186244158} {:db/id #edb/ref 17592186244159} {:db/id #edb/ref 17592186244160} {:db/id #edb/ref 17592186244161} {:db/id #edb/ref 17592186244163} {:db/id #edb/ref 17592186275243}] :knowledge-point/title "Reducing a First-Order ODE to a Separable Form by Factoring and Using a Linear Substitution"} :step/id #uuid "00642656-a13d-5043-9aeb-f6ccc6d55737" :step/math-academy-id 33753 :step/next {:db/id #edb/ref 17592186176727}} {:db/id #edb/ref 17592186176727 :step/content {:db/id #edb/ref 17592186175983 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175833 :question/id #uuid "37a41ca0-2205-5368-91ec-d9a4c1a309d2" :question/math-academy-id "e-9038"} :knowledge-point/id #uuid "6655eb29-8410-5a5c-be86-457affcfb4c3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048150} {:db/id #edb/ref 17592186050299}] :knowledge-point/questions [{:db/id #edb/ref 17592186176219} {:db/id #edb/ref 17592186176228} {:db/id #edb/ref 17592186244105} {:db/id #edb/ref 17592186244162} {:db/id #edb/ref 17592186244164} {:db/id #edb/ref 17592186244172} {:db/id #edb/ref 17592186244178} {:db/id #edb/ref 17592186244179} {:db/id #edb/ref 17592186244182} {:db/id #edb/ref 17592186275247}] :knowledge-point/title "Solving a First-Order ODE by Factoring and Using a Linear Substitution"} :step/id #uuid "8e61f914-1134-5ef9-a7da-37e21cae00e8" :step/math-academy-id 33755} {:db/id #edb/ref 17592186176758 :step/content {:db/id #edb/ref 17592186177006 :tutorial/content "Suppose that we're given a differential equation of the form\n\n$$\ny' = F(x,y).\n$$\n\nBy factoring the function $F(x,y),$ we can often convert this differential equation to one that is of the form \n\n$$\ny' = f ( a x + b y ),\n$$\n\nwhere $a$ and $b$ are real constants. Then, using the substitution $z= ax+by,$ we can convert the equation to a separable differential equation. \n\nTo illustrate, let's consider the differential equation\n\n$$\ny'  = 9x^2 - 6xy + y^2.\n$$\n\nNotice that the right-hand side is a perfect square. So, we factor it as follows:\n\n$$\n\\begin{aligned}{y}^{'}=(3x-y)^{2}\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz = 3x - y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x} = 3 - \\,\\dfrac{\\textrm{d}y}{\\textrm{d}x} \n\\quad \\Rightarrow\\quad \n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = 3 - \\,\\dfrac{\\textrm{d}z}{\\textrm{d}x}\n$$\n\nTherefore, we can write our equation in terms of $z$ as\n\n$$\n3 - \\,\\dfrac{\\textrm{d}z}{\\textrm{d}x} = z^2,\n$$\n\nwhich simplifies to\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x}   = 3-z^2.\n$$\n\nWe now have a separable differential equation." :tutorial/id #uuid "d8aada75-8774-521d-9c38-9a755e683eb4" :tutorial/math-academy-id 5510 :tutorial/title "Introduction"} :step/id #uuid "93b65588-48dd-56d7-a249-1757dc172974" :step/math-academy-id 34318 :step/next {:db/id #edb/ref 17592186176726}}] :activity/title "Further Solving First-Order ODEs by Substitution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176146}]}
