#{[{:db/id #edb/ref 17592186314940 :knowledge-point/_questions [{:db/id #edb/ref 17592186166963 :knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a" :knowledge-point/title "Checking Orthogonality of Sines and Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519814f5-ed1b-51b6-be42-701a06d5265e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id #edb/ref 17592186312641} {:answer/id #uuid "95b4bc14-3372-51dc-8763-57839bd1c948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186313172}] :answer-field/correct {:answer/id #uuid "95b4bc14-3372-51dc-8763-57839bd1c948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186313172} :answer-field/id #uuid "bdb0a620-4521-5768-b99c-bcb9e240ba49" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314534} {:answer-field/choices [{:answer/id #uuid "37bd8b3c-bc05-54eb-8f57-a55be5021855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186312424} {:answer/id #uuid "44030d02-2f0e-52b1-b64d-de590270d455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186312522} {:answer/id #uuid "d4075d04-803b-5c99-bdac-b3260aa45ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313642} {:answer/id #uuid "fa59b168-761a-5bf2-b1fd-942fcfe16bcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186313973}] :answer-field/correct {:answer/id #uuid "d4075d04-803b-5c99-bdac-b3260aa45ef2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313642} :answer-field/id #uuid "d9d5f723-31ec-5260-873d-bac32456689b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314613}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77cb7a42-6cad-573a-85fb-a6a039017afb" :question/math-academy-id "q-340369" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(3x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{6}\\operatorname{cos}⁡(3x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{6}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{6}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ $\\text{are orthogonal}$ with respect to the inner product."}] [{:db/id #edb/ref 17592186314970 :knowledge-point/_questions [{:db/id #edb/ref 17592186166963 :knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a" :knowledge-point/title "Checking Orthogonality of Sines and Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f8b6c4-dc61-5952-b970-50080ba23ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186312150} {:answer/id #uuid "77366691-f549-599e-bab1-698ac3eb9e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312930} {:answer/id #uuid "cc46ef65-e857-5164-a7e5-34465ecfdb28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186313571} {:answer/id #uuid "f6401f00-bf5f-521c-a263-60f469691296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313945}] :answer-field/correct {:answer/id #uuid "f6401f00-bf5f-521c-a263-60f469691296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313945} :answer-field/id #uuid "330a3eca-372e-59a7-9bf8-d2efffe99e10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314147} {:answer-field/choices [{:answer/id #uuid "e3bcbcb0-ba3d-57ed-97b9-85742d944618" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id #edb/ref 17592186413377} {:answer/id #uuid "f54e1f11-1b9d-5dcf-819b-ddcca88bb9fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186413381}] :answer-field/correct {:answer/id #uuid "f54e1f11-1b9d-5dcf-819b-ddcca88bb9fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186413381} :answer-field/id #uuid "2d41b053-3b5f-5c34-91f8-1d643d3b5746" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186413386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e763dfc-e659-54e6-9b52-205e19a11f13" :question/math-academy-id "q-340528" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi ]$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{cos}⁡(3x),1⟩=$ \n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(3x)$ and $g(x)=1$ \n{{field-2}}." :question/worked-solution "Evaluating the inner product, we obtain\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(3x),1⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & ={[\\frac{1}{3}\\operatorname{sin}⁡(3x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{3}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{3}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(3x)$ and $g(x)=1$ \n$\\text{are orthogonal}$ with respect to the inner product."}] [{:db/id #edb/ref 17592186314989 :knowledge-point/_questions [{:db/id #edb/ref 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a94b1c8-4d5d-57f8-8d53-ac3a6453ca96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312056} {:answer/id #uuid "53816f6c-3e82-50d9-ac80-035267b9b313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312652} {:answer/id #uuid "7ef6361a-50cc-5c14-ac0e-7f3592