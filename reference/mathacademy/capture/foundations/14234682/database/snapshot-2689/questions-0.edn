)⟩}" :db/id #edb/ref 17592186313739} {:answer/id #uuid "e901f737-5c77-5341-8bc1-b78927986b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}{⟨f(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313830} {:answer/id #uuid "eea50f81-a609-5dd4-97d4-e34cece10fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313880} {:answer/id #uuid "f47e4960-b4d5-5018-96c9-56112e9c7b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186313931}] :answer-field/correct {:answer/id #uuid "eea50f81-a609-5dd4-97d4-e34cece10fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313880} :answer-field/id #uuid "92b52dea-8ebd-59fd-ba10-4790e182f356" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314406} {:answer-field/choices [{:answer/id #uuid "0809e822-7c07-5342-9864-6c3928f81e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186312032} {:answer/id #uuid "1a1286cb-ed57-54d9-895a-f9fc1324b1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1}" :db/id #edb/ref 17592186312167} {:answer/id #uuid "4c55aeab-c6e1-5fbc-b2db-4a738d0cf09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312594} {:answer/id #uuid "72b80f7b-088d-51a1-9120-764f5e7af0ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186312880} {:answer/id #uuid "7938bdd0-ab46-5b80-9a88-703c52b67232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{1}" :db/id #edb/ref 17592186312944}] :answer-field/correct {:answer/id #uuid "4c55aeab-c6e1-5fbc-b2db-4a738d0cf09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312594} :answer-field/id #uuid "bec85f47-7594-555b-98c5-7a111c7fab2e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314539}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c36e0e36-a227-5df1-b273-538c9f56de6b" :question/math-academy-id "q-340652" :question/problem "Let $F(x)={x}^{3}-3{x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{1}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{b}_{1} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡(2x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-(\\operatorname{sin}⁡(-2\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & ={b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ \\\\ {b}_{1} & =\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩} \\\\ {b}_{1} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314991 :knowledge-point/_questions [{:db/id #edb/ref 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c52c11-2a0f-58d6-aff5-fbcff80b806b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(4x)⟩}{⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩}" :db/id #edb/ref 17592186312230} {:answer/id #uuid "286e0c18-97d0-532c-bf41-6751830ae151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(4x)⟩}{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩}" :db/id #edb/ref 17592186312282} {:answer/id #uuid "a350f6d6-24d8-5f63-b205-477f47e6d19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩}{⟨f(x),\\operatorname{sin}⁡(4x)⟩}" :db/id #edb/ref 17592186313260} {:answer/id #uuid "b8b2f783-0c8d-5f89-9d7f-07e8c45faf2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(4x)⟩}{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩}" :db/id #edb/ref 17592186313411} {:answer/id #uuid "e477c6c9-364e-5141-949d-9701044a0b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩}{⟨f(x),\\operatorname{sin}⁡(4x)⟩}" :db/id #edb/ref 17592186313778}] :answer-field/correct {:answer/id #uuid "21c52c11-2a0f-58d6-aff5-fbcff80b806b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(4x)⟩}{⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩}" :db/id #edb/ref 17592186312230} :answer-field/id #uuid "5cc086cc-8293-54fb-ab53-553c0b9185e8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314269} {:answer-field/choices [{:answer/id #uuid "6adb5300-558b-5171-ae85-ccd08169caac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}-6x)\\operatorname{sin}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186312814} {:answer/id #uuid "84bf4de8-2de1-5c8d-aa10-e8dc5e05701b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}-6x)\\operatorname{cos}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186313040} {:answer/id #uuid "b6112b1f-27d0-5ea9-9414-69665412c45e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}-6x)\\operatorname{cos}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186313389} {:answer/id #uuid "c1d80ee5-4b61-5649-991b-08f557a8dc02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}-6x)\\operatorname{sin}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186313493} {:answer/id #uuid "ea34fcb0-83d8-5c60-9aab-be6de2adf3d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}-6x)\\operatorname{cos}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186313839} {:answer/id #uuid "f1ab1a37-3aeb-50e5-ac0c-f636df7e8865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}-6x)\\operatorname{sin}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186313911}] :answer-field/correct {:answer/id #uuid "6adb5300-558b-5171-ae85-ccd08169caac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}-6x)\\operatorname{sin}⁡(4x)\\,\\text{d}x" :db/id #edb/ref 17592186312814} :answer-field/id #uuid "a3676550-2291-58a0-8716-0b0471438972" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314451} {:answer-field/choices [{:answer/id #uuid "21099cf0-6ade-5176-97e2-98b51987b126" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186312226} {:answer/id #uuid "3f9b48c8-5e3a-5bc2-a5ab-b517fd3e8a59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186312487} {:answer/id #uuid "5f73d4a2-4ad0-5837-b408-af5ab8f8dfdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312737} {:answer/id #uuid "b835c93d-0f3b-59f6-8a79-699819da02b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186313406} {:answer/id #uuid "f35dc895-fc13-50f6-aa56-710cb0aafcfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186313922}] :answer-field/correct {:answer/id #uuid "5f73d4a2-4ad0-5837-b408-af5ab8f8dfdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312737} :answer-field/id #uuid "f825e814-46db-5a49-9ae3-db2a2ad9a646" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314683}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc60bc57-5b9c-5f88-9bc5-5ecffd1981e9" :question/math-academy-id "q-340662" :question/problem "Let $F(x)={x}^{2}-6x$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{4}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{b}_{4} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(4x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(4x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(4x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(4x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(4x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{4}⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩ & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡(4x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{16}\\operatorname{sin}⁡(8x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{16}(\\operatorname{sin}⁡(16\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(4x)⟩ & ={b}_{4}⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩ \\\\ {b}_{4} & =\\frac{⟨f(x),\\operatorname{sin}⁡(4x)⟩}{⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩} \\\\ {b}_{4} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{sin}⁡(4x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }({x}^{2}-6x)\\operatorname{sin}⁡(4x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397539 :knowledge-point/_questions [{:db/id #edb/ref 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d7d31a3-b2e8-5955-b7a5-8d0265e34185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186397541} {:answer/id #uuid "14f752d4-26f3-5b55-951a-267514a31272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186397542} {:answer/id #uuid "86ecc11d-d361-56e3-b985-f0af7df41e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186397543} {:answer/i