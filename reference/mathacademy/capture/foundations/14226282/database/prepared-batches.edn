  \\\\  & =3{\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){[\\frac{{r}^{3}}{3}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =[\\,\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{\\pi /2}^{3\\pi /2} \\\\  & =-2.\\end{aligned}\n$$"] ["activity-a7e447dc-efe8-5990-94ca-1d71d0aed212" :activity/id #uuid "a7e447dc-efe8-5990-94ca-1d71d0aed212"] ["step-64217169-0cc8-5c96-92a7-60e0327f3a58" :step/id #uuid "64217169-0cc8-5c96-92a7-60e0327f3a58"] ["step-c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d" :step/id #uuid "c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d"] ["step-6efb6b15-91ab-572a-9dfc-ab077408f2c0" :step/id #uuid "6efb6b15-91ab-572a-9dfc-ab077408f2c0"] ["step-e699603d-7b06-57fa-a1ac-56875ac67a88" :step/id #uuid "e699603d-7b06-57fa-a1ac-56875ac67a88"] ["step-6ffb9c84-ee99-5da3-ab01-c527c118e32a" :step/id #uuid "6ffb9c84-ee99-5da3-ab01-c527c118e32a"] ["step-64217169-0cc8-5c96-92a7-60e0327f3a58" :step/content 17592186278475] ["step-64217169-0cc8-5c96-92a7-60e0327f3a58" :step/next "step-c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d"] ["step-c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d" :step/content 17592186278486] ["step-c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d" :step/next "step-6efb6b15-91ab-572a-9dfc-ab077408f2c0"] ["step-6efb6b15-91ab-572a-9dfc-ab077408f2c0" :step/content 17592186278488] ["step-6efb6b15-91ab-572a-9dfc-ab077408f2c0" :step/next "step-e699603d-7b06-57fa-a1ac-56875ac67a88"] ["step-e699603d-7b06-57fa-a1ac-56875ac67a88" :step/content 17592186415981] ["step-e699603d-7b06-57fa-a1ac-56875ac67a88" :step/next "step-6ffb9c84-ee99-5da3-ab01-c527c118e32a"] ["step-6ffb9c84-ee99-5da3-ab01-c527c118e32a" :step/content 17592186106064] ["activity-a7e447dc-efe8-5990-94ca-1d71d0aed212" :activity/title "Surface Integrals Over Cartesian Surfaces"] ["activity-a7e447dc-efe8-5990-94ca-1d71d0aed212" :activity/type :activity.type/review] ["activity-a7e447dc-e