chy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mi>y</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mi>z</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>w</mi></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>x</mi><mo>−</mo><mn>2</mn><mo>−</mo><mn>2</mn><mi>y</mi><mo>−</mo><mn>2</mn><mo>−</mo><mn>2</mn><mi>z</mi><mo>+</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo>−</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>2</mn><mi>z</mi><mo>+</mo><mi>w</mi><mo>+</mo><mn>2</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mo>−</mo><mn>2</mn><mi>y</mi><mo>−</mo><mn>2</mn><mi>z</mi><mo>−</mo><mi>w</mi><mo>−</mo><mn>2</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
