\">)</mo><mo>−</mo><mi>π</mi><mo stretchy=\"false\">(</mo><mi>y</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mi>z</mi><mo>−</mo><mi>π</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>w</mi></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mi>π</mi><mi>x</mi><mo>+</mo><mi>π</mi><mo>−</mo><mi>π</mi><mi>y</mi><mo>+</mo><mi>π</mi><mo>−</mo><mi>z</mi><mo>+</mo><mi>π</mi></mtd></mtr><mtr><mtd><mi>π</mi><mi>x</mi><mo>+</mo><mi>π</mi><mi>y</mi><mo>+</mo><mi>z</mi><mo>+</mo><mi>w</mi><mo>−</mo><mn>3</mn><mi>π</mi></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
