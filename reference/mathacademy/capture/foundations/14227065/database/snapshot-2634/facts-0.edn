66953 #edb/ref 17592186045417] [17592186049850 #edb/ref 1028 #edb/ref 17592186166954 #edb/ref 17592186045417] [17592186049850 #edb/ref 1031 "Integrating Products of Trigonometric Functions" #edb/ref 17592186045417] [17592186049850 #edb/ref 1033 3224 #edb/ref 17592186045417] [17592186049850 #edb/ref 1035 #uuid "18b6bb33-dbf4-537c-bb41-f5a6dca39be8" #edb/ref 17592186045417] [17592186050783 #edb/ref 1027 #edb/ref 17592186048717 #edb/ref 17592186045417] [17592186050783 #edb/ref 1027 #edb/ref 17592186049850 #edb/ref 17592186045417] [17592186050783 #edb/ref 1028 #edb/ref 17592186064225 #edb/ref 17592186045417] [17592186050783 #edb/ref 1028 #edb/ref 17592186064226 #edb/ref 17592186045417] [17592186050783 #edb/ref 1028 #edb/ref 17592186064227 #edb/ref 17592186045417] [17592186050783 #edb/ref 1029 #edb/ref 17592186428768 #edb/ref 17592186045436] [17592186050783 #edb/ref 1029 #edb/ref 17592186428769 #edb/ref 17592186045436] [17592186050783 #edb/ref 1031 "Integration Using Basic Trigonometric Identities" #edb/ref 17592186045417] [17592186050783 #edb/ref 1033 282 #edb/ref 17592186045417] [17592186050783 #edb/ref 1034 1.5658646068358284 #edb/ref 17592186045436] [17592186050783 #edb/ref 1035 #uuid "66b05ba4-f638-5531-98d7-9a7817e5a7aa" #edb/ref 17592186045417] [17592186164892 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186164892 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186164892 #edb/ref 1079 #uuid "7ed943c4-5d0d-5d06-8135-a0d7948bb9ae" #edb/ref 17592186045417] [17592186164899 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186164899 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186164899 #edb/ref 1079 #uuid "ad646b86-c5af-5b0e-9b9f-e5764cd74edd" #edb/ref 17592186045417] [17592186166569 #edb/ref 1069 "e-21823" #edb/ref 17592186045417] [17592186166569 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int_{\\pi/4}^{\\pi/2} \\cos(9x)\\cos(x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186166569 #edb/ref 1072 #uuid "177a0110-424b-5ac3-a24e-e817cbcf479c" #edb/ref 17592186045417] [17592186166569 #edb/ref 1074 "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(9x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(9x-x)+\\operatorname{cos}⁡(9x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(8x)+\\operatorname{cos}⁡(10x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{cos}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(8x)+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{16}\\operatorname{sin}⁡(8x)+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{\\pi /4}^{\\pi /2} \\\\  & =\\frac{1}{16}(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(2\\pi ))+\\frac{1}{20}(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(\\frac{5\\pi }{2})) \\\\  & =\\frac{1}{16}(0-0)+\\frac{1}{20}(0-1) \\\\  & =-\\frac{1}{20}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166570 #edb/ref 1069 "e-21824" #edb/ref 17592186045417] [17592186166570 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int \\sin(12x)\\sin(5x)\\,\\text{d}x .$" #edb/ref 17592186045417] [17592186166570 #edb/ref 1072 #uuid "ebf57ac7-29e3-595e-8a72-032e10c470aa" #edb/ref 17592186045417] [17592186166570 #edb/ref 1074 "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(12x-5x)-\\operatorname{cos}⁡(12x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(7x)-\\operatorname{cos}⁡(17x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(7x)-\\frac{1}{2}\\operatorname{cos}⁡(17x)\\,\\text{d}x \\\\  & =\\frac{1}{14}\\operatorname{sin}⁡(7x)-\\frac{1}{34}\\operatorname{sin}⁡(17x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." #edb/ref 17592186045417] [17592186166571 #edb/ref 1069 "e-21825" #edb/ref 17592186045417] [17592186166571 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int_{0}^{\\pi/2} \\sin(2x)\\cos(4x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186166571 #edb/ref 1072 #uuid "14466847-40e1-5a4f-b50a-23b62590f0a2" #edb/ref 17592186045417] [17592186166571 #edb/ref 1074 "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(4x) & =\\frac{1}{2}(\\operatorname{sin}⁡(2x+4x)+\\operatorname{sin}⁡(2x-4x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(6x)+\\operatorname{sin}⁡(-2x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(6x)-\\operatorname{sin}⁡(2x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{sin}⁡(6x)-\\frac{1}{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{12}\\operatorname{cos}⁡(6x)+\\frac{1}{4}\\operatorname{cos}⁡(2x)]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{12}(\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{4}(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{12}(-1-1)+\\frac{1}{4}(-1-1) \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166952 #edb/ref 1037 #edb/ref 17592186048319 #edb/ref 17592186045417] [17592186166952 #edb/ref 1037 #edb/ref 17592186050783 #edb/ref 17592186045417] [17592186166952 #edb/r