\\operatorname{sin}⁡(0))+\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{15\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(1-0)+\\frac{1}{10}(-1-0) \\\\  & =\\frac{1}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186546964 :knowledge-point/_questions [{:db/id #edb/ref 17592186166953 :knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1683c09b-9789-53b1-b425-0d82094023df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{18}\\operatorname{sin}⁡(9x)+C" :db/id #edb/ref 17592186546300} {:answer/id #uuid "47eb069d-8f5b-5110-b5ec-8e326b2af849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(9x)-\\frac{1}{18}\\operatorname{sin}⁡(5x)+C" :db/id #edb/ref 17592186546409} {:answer/id #uuid "549aa39a-cf9b-5ee8-971c-63b8771771e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{18}\\operatorname{sin}⁡(9x)+C" :db/id #edb/ref 17592186546435} {:answer/id #uuid "69a917d4-81bf-557f-a12a-0badc9247a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{cos}⁡(5x)-\\frac{1}{18}\\operatorname{cos}⁡(9x)+C" :db/id #edb/ref 17592186546481} {:answer/id #uuid "96f88a53-e227-5a89-aac3-2479e45d5ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{sin}⁡(5x)-\\frac{1}{9}\\operatorname{sin}⁡(9x)+C" :db/id #edb/ref 17592186546586}] :answer-field/correct {:answer/id #uuid "1683c09b-9789-53b1-b425-0d82094023df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{18}\\operatorname{sin}⁡(9x)+C" :db/id #edb/ref 17592186546300} :answer-field/id #uuid "81a545ed-cedf-578d-88b8-d6dd3c4f7bb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e35aedb-cd68-51d1-a6aa-ac0156232c42" :question/math-academy-id "q-340463" :question/problem "$\\int \\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x) & =\\frac{1}{2}(\\operatorname{cos}⁡(7x-2x)-\\operatorname{cos}⁡(7x+2x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(5x)-\\operatorname{cos}⁡(9x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(5x)-\\frac{1}{2}\\operatorname{cos}⁡(9x)\\,\\text{d}x \\\\  & =\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{18}\\operatorname{sin}⁡(9x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186546975 :knowledge-point/_questions [{:db/id #edb/ref 17592186166953 :knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3317ccb1-01b9-5adb-87ce-11acf44e2926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{sin}⁡(5x)-\\frac{1}{13}\\operatorname{sin}⁡(13x)+C" :db/id #edb/ref 17592186546362} {:answer/id #uuid "8d915675-e654-5197-9282-adb454d2ab25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{cos}⁡(5x)-\\frac{1}{26}\\operatorname{cos}⁡(13x)+C" :db/id #edb/ref 17592186546560} {:answer/id #uuid "95f3a3c1-143d-5338-afc7-5b14662fe7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{26}\\operatorname{sin}⁡(13x)+C" :db/id #edb/ref 17592186546582} {:answer/id #uuid "b224bbfe-b93a-56bf-919b-ef26884dc6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{26}\\operatorname{sin}⁡(13x)+C" :db/id #edb/ref 17592186546648} {:answer/id #uuid "fc0b6a9c-9e17-517e-88a9-ce6797203a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(13x)-\\frac{1}{26}\\operatorname{sin}⁡(5x)+C" :db/id #edb/ref 17592186546815}] :answer-field/correct {:answer/id #uuid "b224bbfe-b93a-56bf-919b-ef26884dc6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{26}\\operatorname{sin}⁡(13x)+C" :db/id #edb/ref 17592186546648} :answer-field/id #uuid "8547732e-e542-5b11-97a7-baefd3b98279" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546889}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21f1e80e-c6ef-5f3d-9284-ec7adabd2372" :question/math-academy-id "q-340464" :question/problem "$\\int \\operatorname{sin}⁡(9x)\\operatorname{sin}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(9x)\\operatorname{sin}⁡(4x) & =\\frac{1}{2}(\\operatorname{cos}⁡(9x-4x)-\\operatorname{cos}⁡(9x+4x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(5x)-\\operatorname{cos}⁡(13x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(9x)\\operatorname{sin}⁡(4x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(5x)-\\frac{1}{2}\\operatorname{cos}⁡(13x)\\,\\text{d}x \\\\  & =\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{26}\\operatorname{sin}⁡(13x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186377336 :knowledge-point/_questions [{:db/id #edb/ref 17592186166953 :knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afe8e06b-8a1b-5efd-8e1b-855c951f5a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186377338}] :answer-field/correct {:answer/id #uuid "afe8e06b-8a1b-5efd-8e1b-855c951f5a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186377338} :answer-field/id #uuid "cd5b9f84-42a3-57ce-9ab1-dbc551ef01e8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc5d8ff1-9935-5447-83ed-23682e5487b3" :question/math-academy-id "q-340476" :question/problem "Evaluate the following integral.\n\n${\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(3x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(3x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-3x)-\\operatorname{cos}⁡(5x+3x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(2x)-\\operatorname{cos}⁡(8x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi }\\frac{1}{2}\\operatorname{cos}⁡(2x)-\\frac{1}{2}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & ={[\\frac{1}{4}\\operatorname{sin}⁡(2x)-\\frac{1}{16}\\operatorname{sin}⁡(8x)]}_{\\pi /4}^{\\pi } \\\\  & =\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{2}))-\\frac{1}{16}(\\operatorname{sin}⁡(8\\pi )-\\operatorname{sin}⁡(2\\pi )) \\\\  & =\\frac{1}{4}(0-1)-\\frac{1}{16}(0-0) \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186546974 :knowledge-point/_questions [{:db/id #edb/ref 17592186166953 :knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52f3b306-9a74-5821-a7de-b9abe78cf733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186546432}] :answer-field/correct {:answer/id #uuid "52f3b306-9a74-5821-a7de-b9abe78cf733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186546432} :answer-field/id #uuid "9b988de4-ecca-56c2-b6bc-fc57b5242fce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2194316f-56dc-52e2-8be5-47b08dc370f4" :question/math-academy-id "q-340478" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(x)\\operatorname{sin}⁡(4x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x)\\operatorname{sin}⁡(4x) & =\\frac{1}{2}(\\operatorname{cos}⁡(x-4x)-\\operatorname{cos}⁡(x+4x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)-\\operatorname{cos}⁡(5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)-\\operatorname{cos}⁡(5x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(x)\\operatorname{sin}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{3\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)-\\frac{1}{10}\\operatorname{sin}⁡(5x)]}_{0}^{3\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{9\\pi }{2})-\\operatorname{sin}⁡(0))-\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{15\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(1-0)-\\frac{1}{10}(-1-0) \\\\  & =\\frac{4}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186547027 :knowledge-point/_questions [{:db/id #edb/ref 17592186166954 :knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3" :knowledge-point/title "Integrating a Product of Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0992dba4-8f7b-5bf3-9cee-a37efc4d1f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{28}\\operatorname{cos}⁡(14x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)+C" :db/id #edb/ref 17592186546266} {:answer/id #uuid "75c05976-5265-5960-b4e0-6e7a245f9c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{14}\\operatorname{sin}⁡(14x)-\\frac{1}{6}\\operatorname{sin}⁡(6x)+C" :db/id #edb/ref 17592186546512} {:answer/id #uuid "78292b8f-ac5e-58bb-aead-4c163faa0593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{20}\\operatorname{cos}⁡(10x)+\\frac{1}{8}\\operatorname{sin}⁡(4x)+C" :db/id #edb/ref 17592186546520} {:answer/id #uuid "94dc8ec7-7293-5c84-a872-14c82724d44c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{28}\\operatorname{sin}⁡(14x)+\\frac{1}{24}\\operatorname{sin}⁡(6x)+C" :db/id #edb/ref 17592186546579} {:answer/id #uuid "b94602f1-fd76-5241-944c-f65add77d8e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{28}\\operatorname{cos}⁡(10x)+\\frac{1}{12}\\operatorname{sin}⁡(4x)+C" :db/id #edb/ref 17592186546666}] :answer-field/correct {:answer/id #uuid "0992dba4-8f7b-5bf3-9cee-a37efc4d1f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{28}\\operatorname{cos}⁡(14x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)+C" :db/id #edb/ref 17592186546266} :answer-field/id #uuid "eae38ee7-3db9-5846-94ff-52291ad80ef9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85e8fc1d-5dff-59c4-83a1-b0b53e9abc4c" :question/math-academy-id "q-340482" :question/problem "$\\int \\operatorname{sin}⁡(10x)\\operatorname{cos}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(10x)\\operatorname{cos}⁡(4x) & =\\frac{1}{2}(\\operatorname{sin}⁡(10x+4x)+\\operatorname{sin}⁡(10x-4x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(14x)+\\operatorname{sin}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(10x)\\operatorname{cos}⁡(4x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sin}⁡(14x)+\\frac{1}{2}\\operatorname{sin}⁡(6x)\\,\\text{d}x \\\\  & =-\\frac{1}{28}\\operatorname{cos}⁡(14x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186314960 :knowledge-point/_questions [{:db/id #edb/ref 17592186166954 :knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3" :knowledge-point/title "Integrating a Product of Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9486d2b-7ce0-5f6e-a396-c474a1abd86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186313970}] :answer-field/correct {:answer/id #uuid "f9486d2b-7ce0-5f6e-a396-c474a1abd86a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186313970} :answer-field/id #uuid "56c732ec-4884-5281-a12b-632144414c6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6c293fa-013e-59cd-b66e-3459611554eb" :question/math-academy-id "q-340489" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(3x) & =\\frac{1}{2}(\\operatorname{sin}⁡(9x+3x)+\\operatorname{sin}⁡(9x-3x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(12x)+\\operatorname{sin}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{sin}⁡(12x)+\\frac{1}{2}\\operatorname{sin}⁡(6x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{24}\\operatorname{cos}⁡(12x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{24}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{12}(\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{24}(1-1)-\\frac{1}{12}(-1-1) \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314961 :knowledge-point/_questions [{:db/id #edb/ref 17592186166954 :knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3" :knowledge-point/title "Integrating a Product of Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddeaca9e-e824-533c-bc58-3ec2b3a38f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186313720}] :answer-field/correct {:answer/id #uuid "ddeaca9e-e824-533c-bc58-3ec2b3a38f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186313720} :answer-field/id #uuid "ce118ddd-47bd-5cab-bad9-6d3152c9b1db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314578}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d43d9ab4-a760-5c76-927f-c8696da3c953" :question/math-academy-id "q-340491" :question/problem "Evaluate the following integral.\n\n${\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{sin}⁡(9x+x)+\\operatorname{sin}⁡(9x-x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(10x)+\\operatorname{sin}⁡(8x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{\\pi /2}^{\\pi }\\frac{1}{2}\\operatorname{sin}⁡(10x)+\\frac{1}{2}\\operatorname{sin}⁡(8x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{20}\\operatorname{cos}⁡(10x)-\\frac{1}{16}\\operatorname{cos}⁡(8x)]}_{\\pi /2}^{\\pi } \\\\  & =-\\frac{1}{20}(\\operatorname{cos}⁡(10\\pi )-\\operatorname{cos}⁡(5\\pi ))-\\frac{1}{16}(\\operatorname{cos}⁡(8\\pi )-\\operatorname{cos}⁡(4\\pi )) \\\\  & =-\\frac{1}{20}(1-(-1))-\\frac{1}{16}(1-1) \\\\  & =-\\frac{1}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314962 :knowledge-point/_questions [{:db/id #edb/ref 17592186166954 :knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3" :knowledge-point/title "Integrating a Product of Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d074817c-9881-518c-b1ea-75ba1846c23c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186313605}] :answer-field/correct {:answer/id #uuid "d074817c-9881-518c-b1ea-75ba1846c23c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186313605} :answer-field/id #uuid "ae1a4a9f-47b6-58b2-8ec5-aab72b4b9f7d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314478}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11434a0f-ad34-5cb2-96ed-81af7783f37f" :question/math-academy-id "q-340492" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{3\\pi /4}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{sin}⁡(7x+x)+\\operatorname{sin}⁡(7x-x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(8x)+\\operatorname{sin}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\pi /4}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{0}^{3\\pi /4}\\frac{1}{2}\\operatorname{sin}⁡(8x)+\\frac{1}{2}\\operatorname{sin}⁡(6x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{16}\\operatorname{cos}⁡(8x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)]}_{0}^{3\\pi /4} \\\\  & =-\\frac{1}{16}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{12}(\\operatorname{cos}⁡(\\frac{9\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{16}(1-1)-\\frac{1}{12}(0-1) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"}]}
