}^{2}+2\\lambda -3)+2(2\\lambda -2)-3(2\\lambda -2) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+3\\lambda )+(4\\lambda -4)-(6\\lambda -6) & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+\\lambda +2 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-\\lambda -2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186427385 :knowledge-point/_questions [{:db/id #edb/ref 17592186124522 :knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124" :knowledge-point/title "Calculating the Eigenvalues of a 3x3 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fde5085-a635-5696-9cd7-100b3c72cad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{-1,4,1\\}" :db/id #edb/ref 17592186427374} {:answer/id #uuid "578c36b5-c09b-5821-8e36-ba81ab9528bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{-1,-4,1\\}" :db/id #edb/ref 17592186427376} {:answer/id #uuid "78e32da7-f1e3-50b7-a080-2498d2b37830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{2,0,1\\}" :db/id #edb/ref 17592186427377} {:answer/id #uuid "cfdc823e-90d7-5645-a8fc-5def08fa694a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{2,4,0\\}" :db/id #edb/ref 17592186427381} {:answer/id #uuid "ed7b9e7c-c2fe-5559-be97-bb8125d6fa51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{-1,2,0\\}" :db/id #edb/ref 17592186427382}] :answer-field/correct {:answer/id #uuid "0fde5085-a635-5696-9cd7-100b3c72cad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda \\in \\{-1,4,1\\}" :db/id #edb/ref 17592186427374} :answer-field/id #uuid "0da5b7ce-3185-5f7f-9a0f-797454d122c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ffb7e93-f33c-5adf-acf0-f55e6fbbb059" :question/math-academy-id "q-36831" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$B=[\\begin{aligned}-1 & 0 & 0 \\\\ 2 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-1-\\lambda  & 0 & 0 \\\\ 2 & 4-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nSince the determinant of a triangular (or diagonal) matrix is given by the product of the entries on the main diagonal, we obtain the following: \n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 0 & 0 \\\\ 2 & 4-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )(4-\\lambda )(1-\\lambda ) & =0 \\\\ (\\lambda +1)(\\lambda -4)(\\lambda -1) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=-1,$ $\\,{\\lambda }_{2}=4,$ and ${\\lambda }_{3}=1.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are always the entries on the main diagonal."}] [{:db/id #edb/ref 17592186323857 :knowledge-point/_questions [{:db/id #edb/ref 17592186124522 :knowledge-point/id #uuid "289ae874-f555-50ee-896f-eb2188004124" :knowledge-point/title "Calculating the Eigenvalues of a 3x3 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16474b71-dd87-5c02-90a1-1986cdcc2b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -1)(\\lambda +3)(\\lambda -2)=0" :db/id #edb/ref 17592186321329} {:answer/id #uuid "455b312d-436f-5a59-beed-3c43b768e4a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda +1)(\\lambda -1)(\\lambda +1)=0" :db/id #edb/ref 17592186321696} {:answer/id #uuid "9521fe4a-7fce-5da7-a5cc-1b5de6565706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\lambda (\\lambda -2)(\\lambda +2)=0" :db/id #edb/ref 17592186322336} {:answer/id #uuid "9e18c66c-1798-5646-b90c-5aa3dcdc792b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda +1)(\\lambda +3)(\\lambda -2)=0" :db/id #edb/ref 17592186322392} {:answer/id #uuid "eb00f264-ac0e-52cf-bbb6-b0d74f11988e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda -1)(\\lambda -3)(\\lambda -2)=0" :db/id #edb/ref 17592186322987}] :answer-field/correct {:answer/id #uuid "9e18c66c-1798-5646-b90c-5aa3dcdc792b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\lambda +1)(\\lambda +3)(\\lambda -2)=0" :db/id #edb/ref 17592186322392} :answer-field/id #uuid "05b0b363-ceb3-501c-b8ad-22246e96a7de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a91b44ac-1def-566a-a0ac-b4f797a0bab1" :question/math-academy-id "q-36860" :question/problem "Find the characteristic equation of the matrix \n$A=[\\begin{aligned}-2 & 0 & -2 \\\\ 1 & -1 & -1 \\\\ -2 & 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}-2-\\lambda  & 0 & -2 \\\\ 1 & -1-\\lambda  & -1 \\\\ -2 & 0 & 1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $2$nd column, we obtain the following:  \n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}-2-\\lambda  & 0 & -2 \\\\ 1 & -1-\\lambda  & -1 \\\\ -2 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}-2-\\lambda  & -2 \\\\ -2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )((-2-\\lambda )(1-\\lambda )-(-2)(-2)) & =0 \\\\ (-1-\\lambda )({\\lambda }^{2}+\\lambda -6) & =0 \\\\ (\\lambda +1)(\\lambda +3)(\\lambda -2) & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366006 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fca3927-3f6f-5b44-b4b9-d2ba4ecdca76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186366008} {:answer/id #uuid "e6b39b02-0c43-5154-abf8-74818045d6f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186366009} {:answer/id #uuid "5de737fa-c3ea-5d82-bb67-a96903882581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186366010} {:answer/id #uuid "a8a00a64-39c3-55cd-9978-fe5453d5a40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186366011} {:answer/id #uuid "08349bc9-dea7-5693-842f-2e153b69045e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186366012}] :answer-field/correct {:answer/id #uuid "e6b39b02-0c43-5154-abf8-74818045d6f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186366009} :answer-field/id #uuid "cfcd45ad-3392-56d7-9f7a-f558cdf77f96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366007}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e41ff16d-c666-5918-91e3-4e187ca2af95" :question/math-academy-id "q-37387" :question/problem "$$\nC=[\\begin{aligned}2 & 1 & 4 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ -5 & 2 & -3 & 0 \\\\ 1 & -7 & 6 & 5\\end{aligned}].\n$$\n\nConsider the matrix $C$ given above. Which of the following statements are true?\n\nI. $\\lambda =2$ is an eigenvalue of $C$\n\nII. $\\lambda =5$ is an eigenvalue of $C$\n\nIII. The eigenvalue $\\lambda =5$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=[\\begin{aligned}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $4$th column, as follows:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 1 & 4 & 0 \\\\ 0 & 5-\\lambda  & 0 & 0 \\\\ -5 & 2 & -3-\\lambda  & 0 \\\\ 1 & -7 & 6 & 5-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )|\\begin{aligned}2-\\lambda  & 1 & 4 \\\\ 0 & 5-\\lambda  & 0 \\\\ -5 & 2 & -3-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(5-\\lambda )\\cdot (5-\\lambda )|\\begin{aligned}2-\\lambda  & 4 \\\\ -5 & -3-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )^{2}\\cdot ((2-\\lambda )(-3-\\lambda )+20) & =0 \\\\ (\\lambda -5)^{2}({\\lambda }^{2}+\\lambda +14) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}+\\lambda +14$ we have that the only real eigenvalue is $\\lambda =5$ (with algebraic multiplicity $2$). \n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186323911 :knowledge-point/_questions [{:db/id #edb/ref 17592186124523 :knowledge-point/id #uuid "5abea3ab-76a7-5598-8ede-b4cf88dd47d7" :knowledge-point/title "Finding the Eigenvalues of a General 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02fadbdc-d540-572d-a6fc-e90b0bea45aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}-53\\lambda -36=0" :db/id #edb/ref 17592186321174} {:answer/id #uuid "1d8b6827-a8f5-5e9e-a456-3c1f4b0bd806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -108=0" :db/id #edb/ref 17592186321371} {:answer/id #uuid "53cbf2a7-4b85-5a35-aa42-5f47e5014747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}-37\\lambda +72=0" :db/id #edb/ref 17592186321806} {:answer/id #uuid "5844cdec-8e7d-5d66-a293-f8b40e411e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72=0" :db/id #edb/ref 17592186321840} {:answer/id #uuid "ac8c4ccf-02d4-5b71-8706-613880e25eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+53\\lambda +36=0" :db/id #edb/ref 17592186322498}] :answer-field/correct {:answer/id #uuid "5844cdec-8e7d-5d66-a293-f8b40e411e1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72=0" :db/id #edb/ref 17592186321840} :answer-field/id #uuid "11bd07c2-d426-5569-a039-db8a048a82ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04cda9cf-e19f-5987-86a4-1bd75a963670" :question/math-academy-id "q-37396" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}-9 & 9 & 0 \\\\ 0 & 5 & -8 \\\\ -2 & 1 & 0\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-9-\\lambda  & 9 & 0 \\\\ 0 & 5-\\lambda  & -8 \\\\ -2 & 1 & -\\lambda \\end{aligned}].\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-9-\\lambda  & 9 & 0 \\\\ 0 & 5-\\lambda  & -8 \\\\ -2 & 1 & -\\lambda \\end{aligned}| & =0 \\\\ (-9-\\lambda )|\\begin{aligned}5-\\lambda  & -8 \\\\ 1 & -\\lambda \\end{aligned}|-9|\\begin{aligned}0 & -8 \\\\ -2 & -\\lambda \\end{aligned}| & =0 \\\\ (-9-\\lambda )({\\lambda }^{2}-5\\lambda +8)-9(-16) & =0 \\\\ (-{\\lambda }^{3}-4{\\lambda }^{2}+37\\lambda -72)+144 & =0 \\\\ -{\\lambda }^{3}-4{\\lambda }^{2}+37\\lambda +72 & =0 \\\\ {\\lambda }^{3}+4{\\lambda }^{2}-37\\lambda -72 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366365 :knowledge-point/_questions [{:db/id #edb/ref 17592186124571 :knowledge-point/id #uuid "ef311af0-0e95-5574-a151-2971ad66bd08" :knowledge-point/title "Calculating the Eigenvalues of a 4x4 Matrix Containing a Block of Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27af9af5-40f7-5590-87de-4650f27e5aa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186366367} {:answer/id #uuid "a879185a-10d3-51bd-a415-70db009b2238" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186366368} {:answer/id #uuid "9f7d7228-7d99-5e51-bc6b-b09cd75c534e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186366369} {:answer/id #uuid "152a4a84-a477-515b-8d42-be94175385d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186366370} {:answer/id #uuid "c815e277-06a0-5dd2-ba04-f1aa13bc716f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186366371}] :answer-field/correct {:answer/id #uuid "152a4a84-a477-515b-8d42-be94175385d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186366370} :answer-field/id #uuid "abafa309-3832-58cf-8a1e-a1f4d098470e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366366}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6753a04-a08e-5bc2-a11a-2cad03fb8d3f" :question/math-academy-id "q-80800" :question/problem "$$\nP=[\\begin{aligned}2 & -3 & -8 & 5 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 3 & -2 & 11 \\\\ 0 & 0 & 0 & -14\\end{aligned}].\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nI. $\\lambda =0$ is an eigenvalue of $P$\n\nII. $\\lambda =-14$ is an eigenvalue of $P$\n\nIII. The eigenvalue $\\lambda =2$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & -3 & -8 & 5 \\\\ 0 & -\\lambda  & 0 & 4 \\\\ 0 & 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & 0 & -14-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}-\\lambda  & 0 & 4 \\\\ 3 & -2-\\lambda  & 11 \\\\ 0 & 0 & -14-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $3$rd row, we obtain the following:\n\n$$\n\\begin{aligned}(2-\\lambda )\\cdot (-14-\\lambda )|\\begin{aligned}-\\lambda  & 0 \\\\ 3 & -2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-14-\\lambda )(-\\lambda )(-2-\\lambda ) & =0 \\\\ (\\lambda -2)(\\lambda +14)\\lambda (\\lambda +2) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =2,$ $\\lambda =-2,$ $\\lambda =0,$ and $\\lambda =-14$  (all with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I and II only.\""}]}
