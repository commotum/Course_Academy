#{[{:activity/first-step {:db/id #edb/ref 17592186189078} :activity/id #uuid "e8e2dcd1-d239-5120-a71f-5337f9c0fb01" :activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852} :activity/steps [{:db/id #edb/ref 17592186189060 :step/content {:db/id #edb/ref 17592186188261 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188204 :question/id #uuid "4b196d96-a95f-53d6-a0c5-7233de14a401" :question/math-academy-id "e-5445"} :knowledge-point/id #uuid "9cc062b6-306b-5edc-81db-1a3051cf3f51" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048978} {:db/id #edb/ref 17592186049539} {:db/id #edb/ref 17592186049903}] :knowledge-point/questions [{:db/id #edb/ref 17592186188917} {:db/id #edb/ref 17592186188981} {:db/id #edb/ref 17592186364975} {:db/id #edb/ref 17592186365073} {:db/id #edb/ref 17592186365080} {:db/id #edb/ref 17592186366434}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Using the Rank-Nullity Theorem"} :step/id #uuid "4b289521-18f1-582d-b604-520f11ba29d7" :step/math-academy-id 20021 :step/next {:db/id #edb/ref 17592186189088}} {:db/id #edb/ref 17592186189077 :step/content {:db/id #edb/ref 17592186188273 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188207 :question/id #uuid "0eddf8b0-bdd9-55db-9388-d39bd91c24c1" :question/math-academy-id "e-7251"} :knowledge-point/id #uuid "e12609b7-286b-50a8-8373-a331d60ab904" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049371}] :knowledge-point/questions [{:db/id #edb/ref 17592186188911} {:db/id #edb/ref 17592186188925} {:db/id #edb/ref 17592186366039} {:db/id #edb/ref 17592186366097} {:db/id #edb/ref 17592186366427} {:db/id #edb/ref 17592186366455} {:db/id #edb/ref 17592186406841} {:db/id #edb/ref 17592186406843}] :knowledge-point/title "Identifying True Statements Using the Rank-Nullity Theorem"} :step/id #uuid "626e026a-01da-503f-a127-2b353dbc209b" :step/math-academy-id 26827} {:db/id #edb/ref 17592186189078 :step/content {:db/id #edb/ref 17592186189365 :tutorial/content "The **rank-nullity theorem in terms of linear transformations** states the following:\n\n*If $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is a linear transformation, then* $$\\textrm{dim(Im}(\\mathbf{T})) + \\textrm{dim(Ker}(\\mathbf{T})) = \\textrm{dim}(\\mathbb{R}^n),$$ *or equivalently,* $$\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.$$\n\nFor example, suppose that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ is a linear transformation such that $$\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, y+2z=0\\}.$$\n\nLet's use the rank-nullity theorem to compute $\\textrm{rank}(\\mathbf{T})$ and $\\text{nullity}(\\mathbf{T}).$\n\nFirst, solving $y+2z=0$ for $y,$ we get $y = -2z.$ Therefore, any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as $$\\begin{aligned}[\\begin{aligned}x \\\\ -2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2\\}.$ And since $\\mathbf v_1$ and $\\mathbf v_2$ are linearly independent, we have $\\textrm{rank}(\\mathbf{T})=2.$\n\nFinally, using the rank-nullity theorem, we obtain $$\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\ & =3-2 \\\\ & =1.\\end{aligned}$$" :tutorial/id #uuid "9c4215af-a9cf-5a1a-aabc-40c5395f2df4" :tutorial/math-academy-id 4379 :tutorial/title "Introduction"} :step/id #uuid "9e0c933b-d880-5bfa-804a-944d21dae8a3" :step/math-academy-id 26840 :step/next {:db/id #edb/ref 17592186189060}} {:db/id #edb/ref 17592186189088 :step/content {:db/id #edb/ref 17592186188281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188216 :question/id #uuid "91885df0-9f1d-5c18-acf1-70259cf7f4d9" :question/math-academy-id "e-9987"} :knowledge-point/id #uuid "9a9a16cc-d807-5015-ba40-b4a15fe3a0db" :knowledge-point/questions [{:db/id #edb/ref 17592186188924} {:db/id #edb/ref 17592186188982} {:db/id #edb/ref 17592186365087} {:db/id #edb/ref 17592186365094} {:db/id #edb/ref 17592186366441} {:db/id #edb/ref 17592186366448} {:db/id #edb/ref 17592186406840} {:db/id #edb/ref 17592186406842}] :knowledge-point/title "Finding the Rank or Nullity of a Linear Transformation Given a Description of the Image or Kernel"} :step/id #uuid "6735a644-2990-5e5c-b639-afb52f0b4d15" :step/math-academy-id 37613 :step/next {:db/id #edb/ref 17592186189077}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188448}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186406847} :activity/id #uuid "1a6d8485-0053-526d-9b37-3def23fa3c0b" :activity/scope {:db/id #edb/ref 17592186049880 :topic/id #uuid "1a7775b9-b31c-568f-86d9-182b4c190efc" :topic/math-academy-id 3852} :activity/steps [{:db/id #edb/ref 17592186406844 :step/content {:db/id #edb/ref 17592186406841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8f9232e-9658-51ed-95f2-ac2fd1e78bf9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454078} {:answer/id #uuid "a2a49195-0754-59e8-a736-789d713df706" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454079}] :answer-field/correct {:db/id #edb/ref 17592186454079} :answer-field/id #uuid "3fee3505-d7fb-511a-a74e-2a2d44598ed9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454789} {:answer-field/choices [{:answer/id #uuid "33b58ec5-18ed-565a-8a4c-7a428ef3b660" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454080} {:answer/id #uuid "fa80fb0a-3883-56b5-b6eb-070e8e31d145" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454081}] :answer-field/correct {:db/id #edb/ref 17592186454080} :answer-field/id #uuid "0d6a4961-38f7-5264-b58e-a39849428f01" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454790} {:answer-field/choices [{:answer/id #uuid "642014a7-57ea-5677-bbda-439505c688fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454082} {:answer/id #uuid "fbeac619-768a-5b27-a0a3-6f578395c470" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454083}] :answer-field/correct {:db/id #edb/ref 17592186454082} :answer-field/id #uuid "d0f9063c-3f2e-5e1f-893e-6358b44768be" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454791}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "838322c6-867e-5a73-a18d-bbf81bd1218b" :question/math-academy-id "q-84081" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,y=z=0}$ then $\\text{rank}(T)=2$\n- **II.** If $Tx=[1,0,0]^{T}$ has more than one solution, then $\\text{nullity}(T)=0$\n- **III.** If $\\text{Ker}(T)=\\text{Span}{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]}$, then $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $y=z=0,$ any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ 0 \\\\ 0\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1}}.$ Therefore, $\\text{nullity}(T)=1.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is false. Since $Tx=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]$ has more than one solution, there are ${u}_{1},{u}_{2}\\in {R}^{3}$ such that  ${u}_{1}\\ne {u}_{2}$ and \n\n$$\nT({u}_{1})=T({u}_{2})=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\nThis means, $T$ is not a bijection and according to the invertible matrix theorem, $\\text{nullity}(T)\\ne 0.$\n\n- Statement III is false. Notice that $\\text{Ker}(T)=\\text{Span}{[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]}.$ Therefore, $\\text{nullity}(T)=1.$ So, $T$ is not a bijection or, which is the same, $T$ is not invertible.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "4b0b57c7-2d59-5d20-9983-005e3257de52" :step/next {:db/id #edb/ref 17592186406845}} {:db/id #edb/ref 17592186406845 :step/content {:db/id #edb/ref 17592186406840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3fa2ee-eac1-54f7-a4c6-ec5b539510f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough information." :db/id #edb/ref 17592186406810} {:answer/id #uuid "b15a9656-7038-5a55-bf9f-c3d46f455338" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186406823} {:answer/id #uuid "cc277bfe-8316-5960-ad00-41d18d0bb79e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186406826} {:answer/id #uuid "e7eb8255-65e0-55e8-9452-62dfb2f06a3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186406828} {:answer/id #uuid "e84109bf-1001-5843-8805-1788b156098c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186406829}] :answer-field/correct {:db/id #edb/ref 17592186406829} :answer-field/id #uuid "28b8502d-f01b-56da-9de3-fce2aa5353e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406837}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7bb2599b-79c3-5637-9b4b-ca26bce210be" :question/math-academy-id "q-140098" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,y-2z=0}.$" :question/worked-solution "Solving $y-2z=0$ for $y,$ we get $y=2z.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ 2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "81a2fa92-8011-53d7-b83d-7c048c758080" :step/next {:db/id #edb/ref 17592186406846}} {:db/id #edb/ref 17592186406846 :step/content {:db/id #edb/ref 17592186406843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec4bc02-0df9-5348-9ee4-473b64cacd02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186472718} {:answer/id #uuid "0b06b982-fb9d-5cf4-b752-4ccd290073ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186472719}] :answer-field/correct {:db/id #edb/ref 17592186472719} :answer-field/id #uuid "edc239d3-5a4c-5fa5-98b1-768823c16b23" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473754} {:answer-field/choices [{:answer/id #uuid "72dd48fb-940a-538d-8ccc-7a6e5aa609a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186472720} {:answer/id #uuid "fcd1213a-a7a4-5890-88d8-8de888db8343" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186472721}] :answer-field/correct {:db/id #edb/ref 17592186472720} :answer-field/id #uuid "0ff1d1ba-36f4-5b99-8a47-88e5119e65f7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473755} {:answer-field/choices [{:answer/id #uuid "05116011-77ca-56fd-9a97-eba1d5a68cd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186472722} {:answer/id #uuid "01638de6-6ede-5e18-812c-b75ad72b29e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186472723}] :answer-field/correct {:db/id #edb/ref 17592186472722} :answer-field/id #uuid "dec578f4-3243-5145-b140-1c5ad943604d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186473756}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b72abcb6-85da-5c4d-a8eb-72ce20ae6b72" :question/math-academy-id "q-140100" :question/problem "Let $T:{R}^{5}\\to {R}^{5}$ be a linear transformation whose standard matrix is $T,$ and let ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ be a set of linearly independent vectors in ${R}^{5}.$ Consider the following statement:\n\n*If  $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$, then $\\text{__________}.$ * \n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{rank}(T)=4$\n- **II.** $\\text{nullity}(T)=4$\n- **III.** $T$ is a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=5.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ and the set ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly independent, we get that $\\text{rank}(T)=\\text{rank}(T)=4.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-4 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\text{rank}(T)\\ne 5$ (or since $\\text{nullity}(T)\\ne 0$), the linear transformation $T$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\""} :step/id #uuid "83597e6d-f7ab-5d6b-86d3-62716c58dc6e"} {:db/id #edb/ref 17592186406847 :step/content {:db/id #edb/ref 17592186188925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140e8026-dca4-518e-b2e3-6a5204699c9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448696} {:answer/id #uuid "91598bc4-014d-5d6b-96f5-a46fe7a19ef6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448697}] :answer-field/correct {:db/id #edb/ref 17592186448697} :answer-field/id #uuid "b185c70a-936c-56ce-a09e-491c0f5906d5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449388} {:answer-field/choices [{:answer/id #uuid "5f7fce4d-3fa7-56db-8465-e02eebbb3df7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448698} {:answer/id #uuid "973d8243-55d9-5ba6-9a8d-9dc8eca9d0e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448699}] :answer-field/correct {:db/id #edb/ref 17592186448698} :answer-field/id #uuid "6276cdd8-8c2d-5458-9242-9db53bf98878" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449389} {:answer-field/choices [{:answer/id #uuid "8433f050-2198-5d04-bcdc-9660fdcf23e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186448700} {:answer/id #uuid "3c8ade48-b616-5c30-ace3-11755e23e2b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186448701}] :answer-field/correct {:db/id #edb/ref 17592186448700} :answer-field/id #uuid "9bfb10db-820c-5886-b42e-f40a5038d34d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186449390}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1b3a8f74-a4d2-5020-9ea6-4077acac1b2e" :question/math-academy-id "q-47524" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $\\text{Im}(T)={[x,y,z]^{T}\\,:\\,3x+2y-z=0}$ then $\\text{nullity}(T)=1$\n- **II.** If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T}$ then $T$ is invertible\n- **III.** If ${v}_{1},$ ${v}_{2},$ and ${v}_{3}$ are the columns of $T$ and ${v}_{3}={v}_{1}+2{v}_{2}$, then $\\text{Ker}(T)={0}$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Solving $3x+2y-z=0$ for $z,$ we get $z=3x+2y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ y \\\\ 3x+2y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ 2\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{rank}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. If ${v}_{1}$ and ${v}_{2}$ are two different solutions to $Tx=[1,-2,1]^{T},$ then \n\n$$\nT{v}_{1}=T{v}_{2}\\,⟹\\,T({v}_{1}-{v}_{2})=0,\n$$\n\nwhere ${v}_{1}-{v}_{2}$ is a non-zero vector. This means that $\\text{Ker}(T)=\\text{Null}(T)\\ne {0}$ and, according to the invertible matrix theorem, $T$ can't be invertible.\n\n- Statement III is false. If the columns of $T$ are such that ${v}_{3}={v}_{1}+2{v}_{2},$ then the set of vectors ${{v}_{1},{v}_{2},{v}_{3}}$ is linearly dependent and therefore $\\text{Im}(T)=\\text{Col}(T)\\ne {R}^{3}.$ Now, according to the matrix invertible theorem, we obtain that $\\text{Ker}(T)\\ne {0}.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "962a6c24-9fbc-5081-8aa6-b1e292aead4b" :step/next {:db/id #edb/ref 17592186406848}} {:db/id #edb/ref 17592186406848 :step/content {:db/id #edb/ref 17592186406842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1470852b-03e9-5db4-8d33-ce40b9b312ff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough information." :db/id #edb/ref 17592186406812} {:answer/id #uuid "a80e2855-a004-5120-bf2a-4803a51aedf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186406821} {:answer/id #uuid "af65c1f2-8ae8-5564-a484-7a9735e719d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186406822} {:answer/id #uuid "c038e33b-b13d-5ebb-aa6f-234d43c1d51b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186406825} {:answer/id #uuid "e9530934-50fc-57c8-a93e-515a75115d2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186406830}] :answer-field/correct {:db/id #edb/ref 17592186406830} :answer-field/id #uuid "6c728edd-0030-5f84-bc57-b18190d3fb0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406838}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94b1ad7b-577b-5c7c-8164-0f25bc8b5263" :question/math-academy-id "q-83446" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Ker}(T)={[x,y,z]^{T}\\,:\\,x+y+z=0}.$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ -x-y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "a96e7cad-642a-5c4d-add9-f21b4c3f7cb6" :step/next {:db/id #edb/ref 17592186406844}}] :activity/title "The Rank-Nullity Theorem in Terms of Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406809}]}
