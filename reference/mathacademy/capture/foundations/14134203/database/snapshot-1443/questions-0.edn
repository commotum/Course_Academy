#{[{:db/id #edb/ref 17592186259641 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe1c6ee-1822-5943-a4ab-95e2e8729c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257204} {:answer/id #uuid "42afdead-f7ba-55b9-837b-58a7ebcab735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257371} {:answer/id #uuid "5b54affb-22be-504f-9fc3-75ecc52418c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186257578} {:answer/id #uuid "d4002265-2697-5e13-a97a-e4de62345ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186258638} {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912}] :answer-field/correct {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912} :answer-field/id #uuid "0d42c87d-8e24-585c-849a-f00efbd599ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f13e13-3246-593c-9da3-b608f58de1b5" :question/math-academy-id "q-124262" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+v,\\,y=bu+cv\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ 9 & 3\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =\\overset{A}{\\overset{⏞}{[\\begin{aligned}-2 & 1 \\\\ 9 & 3\\end{aligned}]}}\\cdot \\overset{u}{\\overset{⏞}{[\\begin{aligned}u \\\\ v\\end{aligned}]}}+\\overset{b}{\\overset{⏞}{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}} \\\\  & =[\\begin{aligned}-2u+v \\\\ 9u+3v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2u+v \\\\ 9u+3v\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-2u+v,\\,y=9u+3v\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+9+3=10.\n$$"}] [{:db/id #edb/ref 17592186259642 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e5d8b9-aa23-509f-9d82-cbc0a58b88aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257118} {:answer/id #uuid "523c5ff0-288c-54a6-8984-dab86593561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257483} {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} {:answer/id #uuid "de5a4cff-b039-5894-8b6c-7aad63c636fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258717} {:answer/id #uuid "fb952160-6ec2-5819-80f3-0686d4603494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186258981}] :answer-field/correct {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} :answer-field/id #uuid "514ff102-c238-5181-bd9a-4ee63292ed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "569ad093-da2b-5144-992e-0f84b411665b" :question/math-academy-id "q-124263" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+av-2,\\,y=bu+cv-3\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 & -1 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =\\overset{A}{\\overset{⏞}{[\\begin{aligned}4 & -1 \\\\ 9 & 5\\end{aligned}]}}\\cdot \\overset{u}{\\overset{⏞}{[\\begin{aligned}u \\\\ v\\end{aligned}]}}+\\overset{b}{\\overset{⏞}{[\\begin{aligned}-2 \\\\ -3\\end{aligned}]}} \\\\  & =[\\begin{aligned}4u-v \\\\ 9u+5v\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}4u-v-2 \\\\ 9u+5v-3\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+(-1)v-2,\\,y=9u+5v-3\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+9+5=13.\n$$"}]}
