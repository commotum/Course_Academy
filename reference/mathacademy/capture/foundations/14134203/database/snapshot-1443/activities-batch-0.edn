#{[{:activity/first-step {:db/id #edb/ref 17592186173004} :activity/id #uuid "81efeb5d-b89e-5c14-80c7-9be44b7d6319" :activity/scope {:db/id #edb/ref 17592186049012 :topic/id #uuid "d38bd816-27de-5026-97de-662b6ee04439" :topic/math-academy-id 3387} :activity/steps [{:db/id #edb/ref 17592186173001 :step/content {:db/id #edb/ref 17592186172092 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171898 :question/id #uuid "91f986c6-c305-50eb-a5b7-36043279d128" :question/math-academy-id "e-9505"} :knowledge-point/id #uuid "035a4ded-7b92-5073-a8aa-3ffa47aff9ea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048203}] :knowledge-point/questions [{:db/id #edb/ref 17592186172293} {:db/id #edb/ref 17592186172296} {:db/id #edb/ref 17592186259630} {:db/id #edb/ref 17592186259631} {:db/id #edb/ref 17592186259635} {:db/id #edb/ref 17592186259636} {:db/id #edb/ref 17592186259637} {:db/id #edb/ref 17592186259638}] :knowledge-point/title "Identifying Affine Transformations"} :step/id #uuid "0a350174-3107-5bfc-b7cf-86f7ef4d3531" :step/math-academy-id 35594 :step/next {:db/id #edb/ref 17592186173003}} {:db/id #edb/ref 17592186173002 :step/content {:db/id #edb/ref 17592186172093 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171899 :question/id #uuid "9779a982-2048-58e2-8a90-df2bcb366d96" :question/math-academy-id "e-9506"} :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/questions [{:db/id #edb/ref 17592186172294} {:db/id #edb/ref 17592186172298} {:db/id #edb/ref 17592186259652} {:db/id #edb/ref 17592186259653} {:db/id #edb/ref 17592186259655} {:db/id #edb/ref 17592186259656} {:db/id #edb/ref 17592186259657} {:db/id #edb/ref 17592186435082}] :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"} :step/id #uuid "7d8f185d-3b89-591e-8ca2-fdba1ecfbeff" :step/math-academy-id 35595} {:db/id #edb/ref 17592186173003 :step/content {:db/id #edb/ref 17592186172094 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171900 :question/id #uuid "2ddc4e15-3729-5425-953c-1cb95edc201b" :question/math-academy-id "e-9508"} :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/questions [{:db/id #edb/ref 17592186172295} {:db/id #edb/ref 17592186172297} {:db/id #edb/ref 17592186259639} {:db/id #edb/ref 17592186259640} {:db/id #edb/ref 17592186259641} {:db/id #edb/ref 17592186259642} {:db/id #edb/ref 17592186259643} {:db/id #edb/ref 17592186259644}] :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"} :step/id #uuid "27929e1f-7191-5a61-bf7e-56af8100e9f0" :step/math-academy-id 35598 :step/next {:db/id #edb/ref 17592186173002}} {:db/id #edb/ref 17592186173004 :step/content {:db/id #edb/ref 17592186173206 :tutorial/content "An **affine transformation** $\\mathbf T:\\mathbb R^2\\rightarrow\\mathbb R^2$ is a function that can be expressed in the form\n\n$$\n\\mathbf x = A \\mathbf u + \\mathbf b,\n$$\n\nwhere $\\mathbf x, \\mathbf u,$ and $\\mathbf b$ are column vectors in $\\mathbb R^2,$ and $A$ is a $2\\times 2$ matrix. \n\nUnder this notation, \n\n- $[\\begin{aligned}u \\\\ v\\end{aligned}]$ represents vectors belonging to the input space, and\n\n- $[\\begin{aligned}x \\\\ y\\end{aligned}]$  represents vectors belonging to the output space.\n\nFor example,\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]\n$$\n\nis an affine transformation because it can be expressed in the form $\\mathbf x = A\\mathbf u + \\mathbf b,$ as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u-v+1 \\\\ 2u+v-3\\end{aligned}] \\\\  & =[\\begin{aligned}u-v \\\\ 2u+v\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}1 \\\\ -3\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nHowever, the transformation\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]\n$$\n\nis not affine since it contains the quadratic term $uv.$\n\nFinally, note the following relationships between affine and linear transformations:\n\n- A linear transformation $\\mathbf x = A \\mathbf u$ is a special case of an affine transformation with $\\mathbf b = \\mathbf 0.$\n\n- For an affine transformation $\\mathbf T$ given by $\\mathbf x = A\\mathbf u + \\mathbf b,$ we say that $A$ is *the matrix representation of the linear transformation associated with* $\\mathbf T.$" :tutorial/id #uuid "4b154eb4-94cc-5d7b-8120-56085be85703" :tutorial/math-academy-id 5808 :tutorial/title "Introduction"} :step/id #uuid "d639fa1f-d747-5b31-9f98-2bdd4bf28119" :step/math-academy-id 35599 :step/next {:db/id #edb/ref 17592186173001}}] :activity/title "Affine Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172189}]}
