#{[{:db/id #edb/ref 17592186435170 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e78d75-7cc9-5f8f-a311-f9561d084ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435151} {:answer/id #uuid "5cbd50d4-87c1-52b7-9640-b711a0fd95b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435153} {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} {:answer/id #uuid "7df97388-6b5d-5314-a0e2-f9db5b72c685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435156} {:answer/id #uuid "9e8c9a39-bea2-5dc9-ae9f-054f40df79f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435160}] :answer-field/correct {:answer/id #uuid "66027fe1-2bba-5e05-8206-4ca92bebfb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435155} :answer-field/id #uuid "9adca1c4-5980-5cfc-b795-52fbb2b1c569" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "924019d9-3882-5c74-a8d2-1e7c35a68ea0" :question/math-academy-id "q-124260" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+a,\\,y=6u+bv+c\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 & 0 \\\\ 6 & 2\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ -1\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =\\overset{A}{\\overset{⏞}{[\\begin{aligned}4 & 0 \\\\ 6 & 2\\end{aligned}]}}\\cdot \\overset{u}{\\overset{⏞}{[\\begin{aligned}u \\\\ v\\end{aligned}]}}+\\overset{b}{\\overset{⏞}{[\\begin{aligned}0 \\\\ -1\\end{aligned}]}} \\\\  & =[\\begin{aligned}4u \\\\ 6u+2v\\end{aligned}]+[\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}4u \\\\ 6u+2v-1\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+0,\\,y=6u+2v+(-1)\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+2+(-1)=1.\n$$"}] [{:db/id #edb/ref 17592186259641 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe1c6ee-1822-5943-a4ab-95e2e8729c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257204} {:answer/id #uuid "42afdead-f7ba-55b9-837b-58a7ebcab735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186257371} {:answer/id #uuid "5b54affb-22be-504f-9fc3-75ecc52418c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186257578} {:answer/id #uuid "d4002265-2697-5e13-a97a-e4de62345ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186258638} {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912}] :answer-field/correct {:answer/id #uuid "f3d00b3d-b50a-5be5-8ad2-4acce9512f8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258912} :answer-field/id #uuid "0d42c87d-8e24-585c-849a-f00efbd599ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f13e13-3246-593c-9da3-b608f58de1b5" :question/math-academy-id "q-124262" :question/problem "The matrix form of the affine transformation\n\n$$\nx=au+v,\\,y=bu+cv\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2 & 1 \\\\ 9 & 3\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =\\overset{A}{\\overset{⏞}{[\\begin{aligned}-2 & 1 \\\\ 9 & 3\\end{aligned}]}}\\cdot \\overset{u}{\\overset{⏞}{[\\begin{aligned}u \\\\ v\\end{aligned}]}}+\\overset{b}{\\overset{⏞}{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}} \\\\  & =[\\begin{aligned}-2u+v \\\\ 9u+3v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2u+v \\\\ 9u+3v\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=-2u+v,\\,y=9u+3v\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+9+3=10.\n$$"}] [{:db/id #edb/ref 17592186259642 :knowledge-point/_questions [{:db/id #edb/ref 17592186172094 :knowledge-point/id #uuid "6664fc2f-f776-5da1-823a-c5ab35873e51" :knowledge-point/title "Finding the Parametric Representation of an Affine Transformation Given its Matrix Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e5d8b9-aa23-509f-9d82-cbc0a58b88aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257118} {:answer/id #uuid "523c5ff0-288c-54a6-8984-dab86593561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257483} {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} {:answer/id #uuid "de5a4cff-b039-5894-8b6c-7aad63c636fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258717} {:answer/id #uuid "fb952160-6ec2-5819-80f3-0686d4603494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186258981}] :answer-field/correct {:answer/id #uuid "d6616e69-617a-5980-b92d-3c054b50d9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186258664} :answer-field/id #uuid "514ff102-c238-5181-bd9a-4ee63292ed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "569ad093-da2b-5144-992e-0f84b411665b" :question/math-academy-id "q-124263" :question/problem "The matrix form of the affine transformation\n\n$$\nx=4u+av-2,\\,y=bu+cv-3\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 & -1 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nWe can carry out the matrix operations using the matrix form, as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =\\overset{A}{\\overset{⏞}{[\\begin{aligned}4 & -1 \\\\ 9 & 5\\end{aligned}]}}\\cdot \\overset{u}{\\overset{⏞}{[\\begin{aligned}u \\\\ v\\end{aligned}]}}+\\overset{b}{\\overset{⏞}{[\\begin{aligned}-2 \\\\ -3\\end{aligned}]}} \\\\  & =[\\begin{aligned}4u-v \\\\ 9u+5v\\end{aligned}]+[\\begin{aligned}-2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}4u-v-2 \\\\ 9u+5v-3\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding elements, we obtain\n\n$$\nx=4u+(-1)v-2,\\,y=9u+5v-3\n$$\n\nTherefore, we have\n\n$$\na+b+c=-1+9+5=13.\n$$"}] [{:db/id #edb/ref 17592186435169 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c225a4-fa6b-5ff4-a3be-9440301a14e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186435157} {:answer/id #uuid "99696a64-81b6-56b3-ae94-3cf2f2bf032d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186435159} {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} {:answer/id #uuid "c4beb685-88bd-5864-8597-0ef45eddb0b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435162} {:answer/id #uuid "d78bfad4-b673-5a93-bb2a-0e0334cd3321" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186435164}] :answer-field/correct {:answer/id #uuid "b2f12e59-3811-5fbe-a8bd-eda4370e2e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435161} :answer-field/id #uuid "29e8d3c2-d32c-5baa-954b-7b5d1efc7457" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f1617b1-29a0-58b4-80d3-cf8ca8d2090f" :question/math-academy-id "q-124288" :question/problem "The matrix form of the affine transformation\n\n$$\nx=2u+5v,\\,y=u-3v\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2 & 5 \\\\ a & b\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ c\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2u+5v \\\\ u-3v\\end{aligned}].\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u+5v \\\\ u-3v\\end{aligned}] \\\\  & =[\\begin{aligned}2u+5v \\\\ u-3v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 5 \\\\ 1 & -3\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+(-3)+0=-2.\n$$"}] [{:db/id #edb/ref 17592186435171 :knowledge-point/_questions [{:db/id #edb/ref 17592186172093 :knowledge-point/id #uuid "dd51cf5a-ca8a-5f89-91d6-8f1a58412314" :knowledge-point/title "Finding the Matrix Representation of an Affine Transformation Given its Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5023974e-65e9-50b5-9103-6472584bc9df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186435152} {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} {:answer/id #uuid "88148730-01ef-5f8f-8698-d5c0f9002897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186435158} {:answer/id #uuid "d60c5735-4076-5c3e-b98e-aa72880ddf6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186435163} {:answer/id #uuid "eeb2f54f-b084-5556-a569-1423fbe14b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186435165}] :answer-field/correct {:answer/id #uuid "606c1e22-4819-56b5-82a2-48e43550b035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186435154} :answer-field/id #uuid "8859ffa2-d430-5120-8081-1bbcdaf58a41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435167}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abc616ba-5b7e-5285-91c7-65fdcb2a91f9" :question/math-academy-id "q-124299" :question/problem "The matrix form of the affine transformation\n\n$$\nx=v-7u,\\,y=2v-u\n$$\n\nis shown below. What is the value of $a+b+c?$\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}a & 1 \\\\ -1 & b\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}c \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nFirst, notice that we can express the given transformation as\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}v-7u \\\\ 2v-u\\end{aligned}].\n$$\n\nSeparating the constants and expressing the linear part as a product, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}v-7u \\\\ 2v-u\\end{aligned}] \\\\  & =[\\begin{aligned}-7u+v \\\\ -u+2v\\end{aligned}]+[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & ={{[\\begin{aligned}-7 & 1 \\\\ -1 & 2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+2+0=-5.\n$$"}]}
