a8631-251a-5a00-aa65-16be619ec141" #edb/ref 17592186045417] [17592186265077 #edb/ref 1080 "The center is $⟨-1,0⟩$ and the radius is $\\sqrt{2}$" #edb/ref 17592186045417] [17592186265077 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186265077 #edb/ref 1083 #uuid "edaf1b77-f55a-53de-aaf6-870a334b4eb6" #edb/ref 17592186045417] [17592186265362 #edb/ref 1075 #edb/ref 17592186263096 #edb/ref 17592186045417] [17592186265362 #edb/ref 1075 #edb/ref 17592186263514 #edb/ref 17592186045417] [17592186265362 #edb/ref 1075 #edb/ref 17592186263594 #edb/ref 17592186045417] [17592186265362 #edb/ref 1075 #edb/ref 17592186264341 #edb/ref 17592186045417] [17592186265362 #edb/ref 1075 #edb/ref 17592186264487 #edb/ref 17592186045417] [17592186265362 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265362 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265362 #edb/ref 1078 #edb/ref 17592186263594 #edb/ref 17592186045417] [17592186265362 #edb/ref 1079 #uuid "3ef9e59a-6517-5986-94c0-f586c58a7db0" #edb/ref 17592186045417] [17592186265414 #edb/ref 1075 #edb/ref 17592186263763 #edb/ref 17592186045417] [17592186265414 #edb/ref 1075 #edb/ref 17592186264207 #edb/ref 17592186045417] [17592186265414 #edb/ref 1075 #edb/ref 17592186264300 #edb/ref 17592186045417] [17592186265414 #edb/ref 1075 #edb/ref 17592186264569 #edb/ref 17592186045417] [17592186265414 #edb/ref 1075 #edb/ref 17592186265077 #edb/ref 17592186045417] [17592186265414 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265414 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265414 #edb/ref 1078 #edb/ref 17592186265077 #edb/ref 17592186045417] [17592186265414 #edb/ref 1079 #uuid "61507bf1-0dd4-5fab-a0ea-a38287bd4d32" #edb/ref 17592186045417] [17592186265470 #edb/ref 1075 #edb/ref 17592186263236 #edb/ref 17592186045417] [17592186265470 #edb/ref 1075 #edb/ref 17592186263796 #edb/ref 17592186045417] [17592186265470 #edb/ref 1075 #edb/ref 17592186264413 #edb/ref 17592186045417] [17592186265470 #edb/ref 1075 #edb/ref 17592186264473 #edb/ref 17592186045417] [17592186265470 #edb/ref 1075 #edb/ref 17592186264630 #edb/ref 17592186045417] [17592186265470 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265470 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265470 #edb/ref 1078 #edb/ref 17592186264630 #edb/ref 17592186045417] [17592186265470 #edb/ref 1079 #uuid "805bbad1-9820-5da9-8726-919fd6256468" #edb/ref 17592186045417] [17592186266137 #edb/ref 1068 #edb/ref 17592186265362 #edb/ref 17592186045417] [17592186266137 #edb/ref 1069 "q-132122" #edb/ref 17592186045417] [17592186266137 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186266137 #edb/ref 1071 "Find the radius of the osculating circle at the point where $t=\\frac{\\pi }{4}$ for the curve $r(t)=⟨t,\\,\\operatorname{ln}⁡\\operatorname{cos}⁡t⟩.$" #edb/ref 17592186045417] [17592186266137 #edb/ref 1072 #uuid "258f49b8-8aac-592e-a98b-1492e2d635c8" #edb/ref 17592186045417] [17592186266137 #edb/ref 1074 "Since we are given only the curve $r(t)$, we will use the cross product formula to find the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t){‖}^{3}}{‖{r}^{′}(t)\\times {r}^{″}(t)‖}\n$$\n\nFirst, we calculate ${r}^{′}(t)$, ${r}^{′}(\\frac{\\pi }{4}),$ and $‖{r}^{′}(\\frac{\\pi }{4})‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡\\operatorname{cos}⁡t)⟩ \\\\  & =⟨1,\\,-\\operatorname{tan}⁡t⟩ \\\\ {r}^{′}(\\frac{\\pi }{4}) & =⟨1,-\\operatorname{tan}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨1,-1⟩ \\\\ ‖{r}^{′}(\\frac{\\pi }{4})‖ & =\\sqrt{(1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=\\frac{\\pi }{4}:$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1),\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{tan}⁡t)⟩ \\\\  & =⟨0,\\,-{sec}^{2}⁡t⟩ \\\\ {r}^{″}(\\frac{\\pi }{4}) & =⟨0,-{sec}^{2}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨0,-2⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(\\frac{\\pi }{4})$ and ${r}^{″}(\\frac{\\pi }{4})$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4}) & =⟨1,\\,-1,\\,0⟩\\times ⟨0,\\,-2,\\,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & -1 & 0 \\\\ 0 & -2 & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}1 & -1 \\\\ 0 & -2\\end{aligned}\\right|\\,k \\\\  & =-2\\,k \\\\ ‖{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4})‖ & =2\\end{aligned}\n$$\n\nTherefore, the radius of curvature at $t=\\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}R(\\frac{\\pi }{4}) & =\\frac{{‖{r}^{′}(\\frac{\\pi }{4})‖}^{3}}{‖{r}^{′}(\\frac{\\pi }{4})\\times {r}^{″}(\\frac{\\pi }{4})‖} \\\\  & =\\frac{(\\sqrt{2})^{3}}{2} \\\\  & =\\frac{2\\sqrt{2}}{2} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186266140 #edb/ref 1068 #edb/ref 17592186265470 #edb/ref 17592186045417] [17592186266140 #edb/ref 1069 "q-132129" #edb/ref 17592186045417] [17592186266140 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186266140 #edb/ref 1071 "Find the radius of the osculating circle at the point where $t=\\pi $ for the curve $r(t)=⟨{e}^{-t}\\operatorname{cos}⁡t,\\,{e}^{-t}\\operatorname{sin}⁡t⟩.$" #edb/ref 17592186045417] [17592186266140 #edb/ref 1072 #uuid "7d2943df-d322-57f9-9465-3be5dfbf7067" #edb/ref 17592186045417] [17592186266140 #edb/ref 1074 "Since we are given only the curve $r(t)$, we will use the cross product formula to find the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t){‖}^{3}}{‖{r}^{′}(t)\\times {r}^{″}(t)‖}\n$$\n\nFirst, we calculate ${r}^{′}(t)$, ${r}^{′}(\\pi ),$ and $‖{r}^{′}(\\pi )‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t,\\,{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t⟩ \\\\  & ={e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩ \\\\ {r}^{′}(\\pi ) & ={e}^{-\\pi }⟨-\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi ,\\,\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi ⟩ \\\\  & ={e}^{-\\pi }⟨1,\\,-1⟩ \\\\ ‖{r}^{′}(\\pi )‖ & ={e}^{-\\pi }\\sqrt{{1}^{2}+(-1)^{2}} \\\\  & ={e}^{-\\pi }\\sqrt{2}\\end{aligned}\n$$\n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=\\pi :$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨2{e}^{-t}\\operatorname{sin}⁡t,\\,-2{e}^{-t}\\operatorname{cos}⁡t⟩ \\\\  & =2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩ \\\\ {r}^{″}(\\pi ) & =2{e}^{-\\pi }⟨\\operatorname{sin}⁡\\pi ,\\,-\\operatorname{cos}⁡\\pi ⟩ \\\\  & =2{e}^{-\\pi }⟨0,\\,1⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(\\pi )$ and ${r}^{″}(\\pi )$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(\\pi )\\times {r}^{″}(\\pi ) & ={e}^{-\\pi }⟨1,\\,-1,\\,0⟩\\times 2{e}^{-\\pi }⟨0,\\,1,\\,0⟩ \\\\  & =2{e}^{-2\\pi }\\,\\left|\\begin{aligned}i & j & k \\\\ 1 & -1 & 0 \\\\ 0 & 1 & 0\\end{aligned}\\right| \\\\  & =2{e}^{-2\\pi }\\,\\left|\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}\\right|\\,k \\\\  & =2{e}^{-2\\pi }k \\\\ ‖{r}^{′}(\\pi )\\times {r}^{″}(\\pi )‖ & =2{e}^{-2\\pi }\\end{aligned}\n$$\n\nTherefore, the radius of curvature at $t=\\pi $ is\n\n$$\n\\begin{aligned}R(\\pi ) & =\\frac{‖{r}^{′}(\\pi ){‖}^{3}}{‖{r}^{′}(\\pi )\\times {r}^{″}(\\pi )‖} \\\\  & =\\frac{({e}^{-\\pi }\\sqrt{2})^{3}}{2{e}^{-2\\pi }} \\\\  & =\\frac{2\\sqrt{2}{e}^{-3\\pi }}{2{e}^{-2\\pi }} \\\\  & =\\sqrt{2}{e}^{-\\pi }.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186266149 #edb/ref 1068 #edb/ref 17592186265414 #edb/ref 17592186045417] [17592186266149 #edb/ref 1069 "q-132201" #edb/ref 17592186045417] [17592186266149 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186266149 #edb/ref 1071 "Find the center and radius of the osculating circle to the curve $r(t)$ at the point $P(0,1)$ where $t=0,$ given that $‖{r}^{′}(0)‖=\\sqrt{2},$ and the unit tangent vector $T(t)$ to the curve is\n\n$$\nT(t)=\\frac{\\sqrt{2}}{2}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩.\n$$" #edb/ref 17592186045417] [17592186266149 #edb/ref 1072 #uuid "6665004f-e6b2-5e6c-b764-778c8eb359b7" #edb/ref 17592186045417] [17592186266149 #edb/ref 1074 "Since we are given both the value of $‖{r}^{′}(0)‖$ and the unit tangent $T(t)$, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nNotice that $r(0)=⟨0,1⟩,$ since the point $P(0,1)$ is at the tip of $r(0).$ \n\nNow, we find ${T}^{′}(t)$, ${T}^{′}(0)$ and $‖{T}^{′}(0)‖:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\sqrt{2}}{2}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{\\sqrt{2}}{2}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\ {T}^{′}(0) & =\\frac{\\sqrt{2}}{2}⟨-\\operatorname{sin}⁡0-\\operatorname{cos}⁡0,\\operatorname{sin}⁡0-\\operatorname{cos}⁡0⟩ \\\\  & =\\frac{\\sqrt{2}}{2}⟨-1,-1⟩ \\\\ ‖{T}^{′}(0)‖ & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1\\end{aligned}\n$$\n\nHence, the radius of curvature is\n\n$$\n\\begin{aligned}R(0) & =\\frac{‖{r}^{′}(0)‖}{‖{T}^{′}(0)‖} \\\\  & =\\frac{\\sqrt{2}}{1} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nNext, we find the principal normal vector at $t=0$ as\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖}=\\frac{\\sqrt{2}}{2}⟨-1,\\,-1⟩.\\end{aligned}\n$$\n\nFinally, the center of the osculating circle is given by\n\n$$\n\\begin{aligned}r(0)+R(0)N(0) & =⟨0,1⟩+\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2}⟨-1,-1⟩ \\\\  & =⟨0,1⟩+⟨-1,-1⟩ \\\\  & =⟨-1,0⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360850 #edb/ref 1080 "The center is $(0,1)$ and the radius $\\frac{\\sqrt{2}}{2}$" #edb/ref 17592186045417] [17592186360850 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186360850 #edb/ref 1083 #uuid "0589c295-d29a-5525-8df9-84a2fef5c818" #edb/ref 17592186045417] [17592186360863 #edb/ref 1080 "The center is $(0,1)$ and the radius $\\sqrt{2}$" #edb/ref 17592186045417] [17592186360863 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186360863 #edb/ref 1083 #uuid "07bef1ff-2469-5d35-b897-08a2224bc1bd" #edb/ref 17592186045417] [17592186361178 #edb/ref 1080 "The center is $(0,0)$ and the radius $\\sqrt{2}$" #edb/ref 17592186045417] [17592186361178 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186361178 #edb/ref 1083 #uuid "4e594d6b-dcde-5053-8f5b-521e676bfdea" #edb/ref 17592186045417] [17592186361463 #edb/ref 1080 "The center is $(0,-1)$ and the radius $2$" #edb/ref 17592186045417] [17592186361463 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186361463 #edb/ref 1083 #uuid "8d7bf037-7a41-5080-8e72-6de80d6a14df" #edb/ref 17592186045417] [17592186361642 #edb/ref 1080 "The center is $(0,0)$ and the radius $2$" #edb/ref 17592186045417] [17592186361642 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186361642 #edb/ref 1083 #uuid "b5a6e881-f847-56c1-9261-cac4148a3edc" #edb/ref 17592186045417] [17592186362106 #edb/ref 1075 #edb/ref 17592186360850 #edb/ref 17592186045417] [17592186362106 #edb/ref 1075 #edb/ref 17592186360863 #edb/ref 17592186045417] [17592186362106 #edb/ref 1075 #edb/ref 17592186