 {a}_{nn}\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{aligned}]\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={[\\begin{aligned}\\frac{\\sqrt{2}}{2} & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & \\frac{1}{2}\\end{aligned}]}^{-1}=[\\begin{aligned}\\sqrt{2} & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & 2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7f0646bc-c1e9-57c4-a712-e3f2e567bf18"] :db/ensure [:question/validate]} {:db/id "answer-field-7f0646bc-c1e9-57c4-a712-e3f2e567bf18" :answer-field/id #uuid "7f0646bc-c1e9-57c4-a712-e3f2e567bf18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2976668-e1f8-588b-8a03-b0ef6a8390f9" :answer-field/choices ["answer-ac003b16-7243-5e15-8485-76e4c6793dd2" "answer-3ec4b7db-ca7b-5043-a588-037351f17888" "answer-62ec2d7e-0fc7-5abd-83a6-9b0e89debf34" "answer-a84045f3-8768-57ed-9b3d-c2e98c00a4d8" "answer-b2976668-e1f8-588b-8a03-b0ef6a8390f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac003b16-7243-5e15-8485-76e4c6793dd2" :answer/id #uuid "ac003b16-7243-5e15-8485-76e4c6793dd2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} & 0 & 0 & 0 \\\\ 0 & -1 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3ec4b7db-ca7b-5043-a588-037351f17888" :answer/id #uuid "3ec4b7db-ca7b-5043-a588-037351f17888" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} & 0 & 0 & 0 \\\\ 0 & -1 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-62ec2d7e-0fc7-5abd-83a6-9b0e89debf34" :answer/id #uuid "62ec2d7e-0fc7-5abd-83a6-9b0e89debf34" :answer/type :answer.type/