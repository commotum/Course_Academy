      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14116420/observations/step-q105671-fe657d8407db2e29e5c1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14116420/observations/step-q105671-fe657d8407db2e29e5c1.png",
      "source_url": "https://mathacademy.com/tasks/14116420/topics/2132/review",
