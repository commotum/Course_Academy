      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q160633-4fefeb08226e0eb6eb58.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q160633-4fefeb08226e0eb6eb58.png",
