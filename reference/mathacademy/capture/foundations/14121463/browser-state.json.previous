      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q225160-00b860ee54d3f16d322b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q225160-00b860ee54d3f16d322b.png",
      "source_url": "https://mathacademy.com/tasks/14121463/topics/2832/review",
