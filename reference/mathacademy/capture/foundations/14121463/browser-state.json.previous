      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q225139-5398647196d5ef124208.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14121463/observations/step-q225139-5398647196d5ef124208.png",
      "source_url": "https://mathacademy.com/tasks/14121463/topics/2832/review",
      "captured_at": 1791738402.9451308,
      "math_academy_id": "q-225139",
