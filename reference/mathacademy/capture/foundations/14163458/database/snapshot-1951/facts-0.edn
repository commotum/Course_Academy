86045417] [17592186129271 #edb/ref 1041 #edb/ref 17592186128848 #edb/ref 17592186045417] [17592186129271 #edb/ref 1042 #uuid "d433063f-f145-5bf4-8bd4-8d5e5b36b3d8" #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130210 #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130211 #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130212 #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130213 #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130229 #edb/ref 17592186045417] [17592186129388 #edb/ref 1043 #edb/ref 17592186130234 #edb/ref 17592186045417] [17592186129388 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129388 #edb/ref 1045 "The Jacobian of a Three-Dimensional Transformation" #edb/ref 17592186045417] [17592186129388 #edb/ref 1046 #edb/ref 17592186130212 #edb/ref 17592186045417] [17592186129388 #edb/ref 1049 #edb/ref 17592186049530 #edb/ref 17592186045417] [17592186129388 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186129388 #edb/ref 1053 #uuid "caa59eff-71b4-5d09-9d46-37886ba2c5a7" #edb/ref 17592186045417] [17592186129751 #edb/ref 1068 #edb/ref 17592186326377 #edb/ref 17592186045417] [17592186129751 #edb/ref 1069 "q-39669" #edb/ref 17592186045417] [17592186129751 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186129751 #edb/ref 1071 "Find the Jacobian determinant of the transformation $T:(u,v,w)\\to (x(u,v,w),y(u,v,w),z(u,v,w)),$ given that \n\n$$\nu=2x+y,\\,v=-x+3y-2z,\\,w=3y+4z.\n$$" #edb/ref 17592186045417] [17592186129751 #edb/ref 1072 #uuid "9ad6bc33-7c9a-5d03-8204-18b81f486eea" #edb/ref 17592186045417] [17592186129751 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2 & \\,\\frac{∂u}{∂y} & =1 & \\,\\frac{∂u}{∂z} & =0 \\\\ \\frac{∂v}{∂x} & =-1 & \\,\\frac{∂v}{∂y} & =3 & \\,\\frac{∂v}{∂z} & =-2 \\\\ \\frac{∂w}{∂x} & =0 & \\,\\frac{∂w}{∂y} & =3 & \\,\\frac{∂w}{∂z} & =4\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 0 \\\\ -1 & 3 & -2 \\\\ 0 & 3 & 4\\end{aligned}| \\\\  & =2|\\begin{aligned}3 & -2 \\\\ 3 & 4\\end{aligned}|-1|\\begin{aligned}-1 & -2 \\\\ 0 & 4\\end{aligned}| \\\\  & =2(12+6)-1(-4-0) \\\\  & =40.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1} \\\\  & =\\frac{1}{40}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130210 #edb/ref 1061 42965 #edb/ref 17592186045417] [17592186130210 #edb/ref 1062 #uuid "3cc8dd7f-188a-5699-96ad-6f7b673a3512" #edb/ref 17592186045417] [17592186130210 #edb/ref 1063 #edb/ref 17592186129269 #edb/ref 17592186045417] [17592186130211 #edb/ref 1058 #edb/ref 17592186130210 #edb/ref 17592186045417] [17592186130211 #edb/ref 1061 42966 #edb/ref 17592186045417] [17592186130211 #edb/ref 1062 #uuid "7c37bbbe-760d-5104-b2e3-292b83880dd0" #edb/ref 17592186045417] [17592186130211 #edb/ref 1063 #edb/ref 17592186129270 #edb/ref 17592186045417] [17592186130212 #edb/ref 1058 #edb/ref 17592186130234 #edb/ref 17592186045417] [17592186130212 #edb/ref 1061 43046 #edb/ref 17592186045417] [17592186130212 #edb/ref 1062 #uuid "d8ced6e6-4bb6-52e9-8819-7a54180e8a4f" #edb/ref 17592186045417] [17592186130212 #edb/ref 1063 #edb/ref 17592186130457 #edb/ref 17592186045417] [17592186130213 #edb/ref 1058 #edb/ref 17592186130229 #edb/ref 17592186045417] [17592186130213 #edb/ref 1061 43048 #edb/ref 17592186045417] [17592186130213 #edb/ref 1062 #uuid "d3c03e1b-973d-566a-96d2-32f746decf45" #edb/ref 17592186045417] [17592186130213 #edb/ref 1063 #edb/ref 17592186129271 #edb/ref 17592186045417] [17592186130229 #edb/ref 1058 #edb/ref 17592186130211 #edb/ref 17592186045417] [17592186130229 #edb/ref 1061 44587 #edb/ref 17592186045417] [17592186130229 #edb/ref 1062 #uuid "99520515-6bfa-5265-8e42-e193dc1183f6" #edb/ref 17592186045417] [17592186130229 #edb/ref 1063 #edb/ref 17592186130463 #edb/ref 17592186045417] [17592186130234 #edb/ref 1058 #edb/ref 17592186130213 #edb/ref 17592186045417] [17592186130234 #edb/ref 1061 44764 #edb/ref 17592186045417] [17592186130234 #edb/ref 1062 #uuid "ed9fa5db-a7c0-512a-bb14-c0e7e5dcbcd0" #edb/ref 17592186045417] [17592186130234 #edb/ref 1063 #edb/ref 17592186130467 #edb/ref 17592186045417] [17592186130457 #edb/ref 1064 "Similar to transformations in the plane, we can also consider transformations of three-dimensional regions.\n\nFor example, the transformation\n\n![](images/71/71b4c6b8f2db4890436050206115b94eb57b088be76049cb32667f02986b4f56.svg) \n\nmaps a rectangular prism in Cartesian $uvw$-space onto one-eighth of a sphere in Cartesian $xyz$-space, as shown below.\n\n![](images/3e/3e1ee5a6116d57cc1c3419b55bf0a9701b9f5d4d93931d053ed4a05b83a5d8f0.png)\n\n \n\nIn general, if a transformation\n\n![](images/d1/d175f9eba3a6da7cc7750b3e59fe0e5904df27511a6b64481598e0f0ebfa1f0c.svg) \n\nis a $C^1$ transformation, meaning that it and its first derivatives are continuous, then the Jacobian determinant of $\\mathbf{T}$ is defined as\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\n  \n\nFor example, to compute the Jacobian determinant of our transformation above, we first calculate the required partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =\\operatorname{sin}⁡v\\operatorname{cos}⁡w & \\,\\frac{∂x}{∂v} & =u\\operatorname{cos}⁡v\\operatorname{cos}⁡w & \\,\\frac{∂x}{∂w} & =-u\\operatorname{sin}⁡v\\operatorname{sin}⁡w \\\\ \\frac{∂y}{∂u} & =\\operatorname{sin}⁡v\\operatorname{sin}⁡w & \\,\\frac{∂y}{∂v} & =u\\operatorname{cos}⁡v\\operatorname{sin}⁡w & \\,\\frac{∂y}{∂w} & =u\\operatorname{sin}⁡v\\operatorname{cos}⁡w \\\\ \\frac{∂z}{∂u} & =\\operatorname{cos}⁡v & \\,\\frac{∂z}{∂v} & =-u\\operatorname{sin}⁡v & \\,\\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\operatorname{sin}⁡v\\operatorname{cos}⁡w & u\\operatorname{cos}⁡v\\operatorname{cos}⁡w & -u\\operatorname{sin}⁡v\\operatorname{sin}⁡w \\\\ \\operatorname{sin}⁡v\\operatorname{sin}⁡w & u\\operatorname{cos}⁡v\\operatorname{sin}⁡w & u\\operatorname{sin}⁡v\\operatorname{cos}⁡w \\\\ \\operatorname{cos}⁡v & -u\\operatorname{sin}⁡v & 0\\end{aligned}| \\\\  & =\\operatorname{cos}⁡v|\\begin{aligned}u\\operatorname{cos}⁡v\\operatorname{cos}⁡w & -u\\operatorname{sin}⁡v\\operatorname{sin}⁡w \\\\ u\\operatorname{cos}⁡v\\operatorname{sin}⁡w & u\\operatorname{sin}⁡v\\operatorname{cos}⁡w\\end{aligned}|+u\\operatorname{sin}⁡v|\\begin{aligned}\\operatorname{sin}⁡v\\operatorname{cos}⁡w & -u\\operatorname{sin}⁡v\\operatorname{sin}⁡w \\\\ \\operatorname{sin}⁡v\\operatorname{sin}⁡w & u\\operatorname{sin}⁡v\\operatorname{cos}⁡w\\end{aligned}| \\\\  & =\\operatorname{cos}⁡v\\cdot {u}^{2}\\operatorname{cos}⁡v\\operatorname{sin}⁡v\\cdot ({cos}^{2}⁡w+{sin}^{2}⁡w)+u\\operatorname{sin}⁡v\\cdot u{sin}^{2}⁡v\\cdot ({cos}^{2}⁡w+{sin}^{2}⁡w) \\\\  & ={u}^{2}{cos}^{2}⁡v\\operatorname{sin}⁡v+{u}^{2}{sin}^{2}⁡v\\operatorname{sin}⁡v \\\\  & ={u}^{2}\\operatorname{sin}⁡v\\cdot ({cos}^{2}⁡v+{sin}^{2}⁡v) \\\\  & ={u}^{2}\\operatorname{sin}⁡v.\\end{aligned}\n$$\n\nLet's get some practice at computing Jacobians of three-dimensional transformations." #edb/ref 17592186045417] [17592186130457 #edb/ref 1065 7237 #edb/ref 17592186045417] [17592186130457 #edb/ref 1066 #uuid "610a6348-ed80-507a-b390-560e9bc1e4ef" #edb/ref 17592186045417] [17592186130457 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130463 #edb/ref 1064 "The **critical points** of a transformation $\\mathbf T: \\mathbb R^3\\longrightarrow\\mathbb R^3,$ given by\n\n![](images/0f/0f47dfd79a5147b5628975b26ea21a37288d809fb30a5a90b205ecc7b25ae008.svg)\n\nare the points in Cartesian $uvw$-space where the Jacobian is zero:\n\n$$\n\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}=0\n$$\n\n  \n\nSimilar to the two-dimensional case, the transformation $\\mathbf T$ is locally non-invertible at the critical points.\n\nFinally, provided that $\\mathbf{T}$ is invertible, the connection between the Jacobians of $\\mathbf T$ and $\\mathbf{T}^{-1}$ is as follows:\n\n$$\n\\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)} = \\left( \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right)^{-1}\n$$" #edb/ref 17592186045417] [17592186130463 #edb/ref 1065 7676 #edb/ref 17592186045417] [17592186130463 #edb/ref 1066 #uuid "9dd5b9bc-94c3-5fd0-8752-3fa9be521934" #edb/ref 17592186045417] [17592186130463 #edb/ref 1067 "The Critical Points of a Transformation" #edb/ref 17592186045417] [17592186130467 #edb/ref 1064 "The Jacobian determinant of a spatial transformation can be interpreted similarly to the Jacobian of a plane transformation.\n\nAs before, the Jacobian describes *local* effects, not global ones. \n\nGiven that $J(u_0,v_0,w_0)$ denotes the Jacobian determinant of $\\mathbf{T}$ evaluated at $(u_0, v_0, w_0),$ let's describe $\\mathbf T$'s effect on a *tiny* rectangular prism in Cartesian $uvw$-space whose bottom, back left corner is at the point $(u_0,v_0,w_0).$\n\n![](images/31/31c0a7275acdac0dc217e73f3c1e3d9efe504832419c87486cee980e20ea04da.png)\n\n \n\nIt can be shown that, provided that our prism is very small and $(u_0,v_0, w_0)$ is not a critical point of $\\mathbf T,$ the image of our prism can be approximated by a parallelepiped. \n\nThe Jacobian determinant of $\\mathbf T$ evaluated at $(u_0,v_0,w_0)$ describes the following key features between our tiny rectangular prism and its (approximate) image:\n\n- The local *volume* scale factor of $\\mathbf T$. \n\nSuppose the length, width, and height of our rectangular prism are $\\delta u,$ $\\delta v,$ and $\\delta w,$ so its volume is \n\n$$\n\\delta V = \\delta u \\delta v \\delta w.\n$$\n\n Then, it can be shown that the approximate parallelepiped in $xyz$-space has a volume equal to \n\n$$\n\\left|J(u_0,v_0,w_0)\\right| \\cdot \\delta V,\n$$\n\n as depicted below.\n\n![](images/d6/d669cd5369d33e618ab43cfd3e93ee70c9fea8420b5a829d78826c11524511aa.png)\n\n- Whether the transformation is *locally* orientation-preserving or *locally* orientation-reversing.\n\nIf $J(u_0,v_0,w_0) > 0,$ the transformation is (locally) orientation-preserving. \n\nGeometrically, this means that the transformation maps a triple of vectors onto a triple with the same orientation (right-handed $\\to$ right-handed or left-handed $\\to$ left-handed).\n\n![](images/f0/f05f9a79d9156518e948c46f6c67eb5ff31132fd4a088e14219eada7eb49a441.png)\n\n \n\nIf $J(u_0,v_0, w_0) < 0,$ the transformation is (locally) orientation-reversing.\n\nGeometrically, this means that the transformation maps a triple of vectors onto a triple with the opposite orientation (right-handed $\\to$ left-handed or left-handed $\\to$ right-handed).\n\n![](images/45/45b08e0fec7114db52a05cb42ed46d7d62baa5b01a5dea37752928348802b205.png)\n\n- Whether the transformation is *locally* invertible or *locally* non-invertible.\n\nIf $J(u_0,v_0,w_0) \\neq 0,$ the transformation is (locally) invertible.\n\nGeometrically, this means that the transformation maps our tiny rectangular prism (a three-dimensional region) onto a three-dimensional region (i.e., a parallelepiped).\n\n![](images/61/61557eb2d78d468946375b918ab182da518b7cf2c68a1c0a0593c93b991bcf78.png)\n\n \n\nIf $J(u_0,v_0,w_0)= 0,$ the transformation is (locally) non-invertible.\n\nGeometrically, this means that the transformation maps our tiny rectangular prism (a three-dimensional region) onto a two-dimensional region (a parallelogram), a one-dimensional region (a line segment), or a zero-dimensional region (a point).\n\n![](images/72/726ba518de982ddd0b2924a645463b496ed881ead76a652c812c7a164aa684b8.png)" #edb/ref 17592186045417] [17592186130467 #edb/ref 1065 7718 #edb/ref 17592186045417] [17592186130467 #edb/ref 1066 #uuid "10a3ad60-7124-5508-a053-b827183f5a2a" #edb/ref 17592186045417] [17592186130467 #edb/ref 1067 "Intuition Behind the Jacobian" #edb/ref 17592186045417] [17592186278648 #edb/ref 1080 "3(uvw)^{1/3}" #edb/ref 17592186045417] [17592186278648 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278648 #edb/ref 1083 #uuid "0626020c-ffd0-5d52-be60-af389fc83a02" #edb/ref 17592186045417] [17592186278894 #edb/ref 1080 "\\frac{2}{\\sqrt{uvw}}" #edb/ref 17592186045417] [17592186278894 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278894 #edb/ref 1083 #uuid "21988933-2fdd-5343-979b-14ba2f6e68d4" #edb/ref 17592186045417] [17592186279172 #edb/ref 1080 "\\frac{1}{2\\sqrt{uvw}}" #edb/ref 17592186045417] [17592186279172 #edb/ref 1082 #edb/ref 17592186045498 #