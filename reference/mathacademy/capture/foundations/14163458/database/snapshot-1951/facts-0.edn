/ref 17592186045417] [17592186281170 #edb/ref 1075 #edb/ref 17592186279617 #edb/ref 17592186045417] [17592186281170 #edb/ref 1075 #edb/ref 17592186279651 #edb/ref 17592186045417] [17592186281170 #edb/ref 1075 #edb/ref 17592186279692 #edb/ref 17592186045417] [17592186281170 #edb/ref 1075 #edb/ref 17592186279813 #edb/ref 17592186045417] [17592186281170 #edb/ref 1075 #edb/ref 17592186280655 #edb/ref 17592186045417] [17592186281170 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281170 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281170 #edb/ref 1078 #edb/ref 17592186279813 #edb/ref 17592186045417] [17592186281170 #edb/ref 1079 #uuid "bcf9576c-0ce8-5723-bb46-cfba69aeb672" #edb/ref 17592186045417] [17592186281257 #edb/ref 1075 #edb/ref 17592186278894 #edb/ref 17592186045417] [17592186281257 #edb/ref 1075 #edb/ref 17592186279172 #edb/ref 17592186045417] [17592186281257 #edb/ref 1075 #edb/ref 17592186279306 #edb/ref 17592186045417] [17592186281257 #edb/ref 1075 #edb/ref 17592186279694 #edb/ref 17592186045417] [17592186281257 #edb/ref 1075 #edb/ref 17592186279811 #edb/ref 17592186045417] [17592186281257 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281257 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281257 #edb/ref 1078 #edb/ref 17592186279172 #edb/ref 17592186045417] [17592186281257 #edb/ref 1079 #uuid "efb87408-7532-5806-bc11-5c1c98d338e4" #edb/ref 17592186045417] [17592186281336 #edb/ref 1068 #edb/ref 17592186281257 #edb/ref 17592186045417] [17592186281336 #edb/ref 1069 "q-161806" #edb/ref 17592186045417] [17592186281336 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186281336 #edb/ref 1071 "Consider the transformation $T:(u,v,w)\\to (x(u,v,w),y(u,v,w),z(u,v,w)).$ The inverse transformation ${T}^{-1}(x,y,z)\\to (u(x,y,z),v(x,y,z),w(x,y,z))$ is given by\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}xy \\\\ yz \\\\ xz\\end{aligned}].\n$$\n\nFind the Jacobian determinant of $T.$\n\n*Hint: You can assume that $x,y,z>0.$*" #edb/ref 17592186045417] [17592186281336 #edb/ref 1072 #uuid "9bd3e29c-50b2-5640-b3fa-d0adf89e1fac" #edb/ref 17592186045417] [17592186281336 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v,w)}{∂(x,y,z)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}.\n$$\n\nHere, we have \n\n$$\nu(x,y,z)=xy,\\,v(x,y,z)=yz,\\,w(x,y,z)=xz.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =y & \\,\\frac{∂u}{∂y} & =x & \\,\\frac{∂u}{∂z} & =0 \\\\ \\frac{∂v}{∂x} & =0 & \\,\\frac{∂v}{∂y} & =z & \\,\\frac{∂v}{∂z} & =y \\\\ \\frac{∂w}{∂x} & =z & \\,\\frac{∂w}{∂y} & =0 & \\,\\frac{∂w}{∂z} & =x\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant of ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x & 0 \\\\ 0 & z & y \\\\ z & 0 & x\\end{aligned}| \\\\  & =y|\\begin{aligned}z & y \\\\ 0 & x\\end{aligned}|-x|\\begin{aligned}0 & y \\\\ z & x\\end{aligned}| \\\\  & =y(xz-0)-x(0-yz) \\\\  & =xyz+xyz \\\\  & =2xyz.\\end{aligned}\n$$\n\nWriting down $\\frac{∂(u,v,w)}{∂(x,y,z)}$ in terms of $u,$ $v,$ and $w,$ we obtain\n\n$$\n\\begin{aligned}2xyz & =2\\sqrt{(xyz)^{2}} \\\\  & =2\\sqrt{{x}^{2}{y}^{2}{z}^{2}} \\\\  & =2\\sqrt{xy(yz)(xz)} \\\\  & =2\\sqrt{uvw}\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & ={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1} \\\\  & =\\frac{1}{2\\sqrt{uvw}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281339 #edb/ref 1068 #edb/ref 17592186281170 #edb/ref 17592186045417] [17592186281339 #edb/ref 1069 "q-161812" #edb/ref 17592186045417] [17592186281339 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281339 #edb/ref 1071 "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u \\\\ {v}^{3}+{w}^{3} \\\\ v+w\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186281339 #edb/ref 1072 #uuid "f26bca76-37a5-5f68-8e4a-4d9215b02535" #edb/ref 17592186045417] [17592186281339 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u,\\,y(u,v,w)={v}^{3}+{w}^{3},\\,z(u,v,w)=v+w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =3{v}^{2} & \\,\\frac{∂y}{∂w} & =3{w}^{2} \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3{v}^{2} & 3{w}^{2} \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}3{v}^{2} & 3{w}^{2} \\\\ 1 & 1\\end{aligned}| \\\\  & =1(3{v}^{2}-3{w}^{2}) \\\\  & =3({v}^{2}-{w}^{2}).\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 3({v}^{2}-{w}^{2}) & =0 \\\\ {v}^{2}-{w}^{2} & =0.\\end{aligned}\n$$\n\nThe equation ${v}^{2}-{w}^{2}=0$ defines a pair of intersecting planes $v=w$ and $v=-w.$" #edb/ref 17592186045417] [17592186324062 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186324062 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324062 #edb/ref 1083 #uuid "0a3dfa61-4983-5101-a590-b7cae3069606" #edb/ref 17592186045417] [17592186324490 #edb/ref 1080 "-\\frac{{u}^{2}}{2\\sqrt{w}}" #edb/ref 17592186045417] [17592186324490 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324490 #edb/ref 1083 #uuid "408e29c9-6522-5467-9ab8-def9fe8cfb65" #edb/ref 17592186045417] [17592186324714 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186324714 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324714 #edb/ref 1083 #uuid "5975b6e2-4d63-5522-bc15-85311b4304c4" #edb/ref 17592186045417] [17592186324848 #edb/ref 1080 "\\frac{\\sqrt{w}{u}^{2}}{2}" #edb/ref 17592186045417] [17592186324848 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324848 #edb/ref 1083 #uuid "69224e59-e1c5-54cd-8748-b2d597b5cd76" #edb/ref 17592186045417] [17592186325004 #edb/ref 1080 "\\frac{{u}^{2}}{2\\sqrt{w}}" #edb/ref 17592186045417] [17592186325004 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325004 #edb/ref 1083 #uuid "7b1e869c-a3b7-584b-8e0f-e99423947eb0" #edb/ref 17592186045417] [1759218632