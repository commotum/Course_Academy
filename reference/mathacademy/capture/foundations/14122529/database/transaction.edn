[{:db/id 17592186124649 :knowledge-point/questions ["question-204288b8-790b-5fba-b88f-1aae9820b71f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-204288b8-790b-5fba-b88f-1aae9820b71f" :question/id #uuid "204288b8-790b-5fba-b88f-1aae9820b71f" :question/math-academy-id "q-164316" :question/problem "Given the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2} & =1 \\\\ (z-1)^{2} & =1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4} \\\\ z-1 & =\\pm \\sqrt{1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}\\ge 0 \\\\ \\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}=1$ and its boundary. \n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6e468b59-ed57-5245-8552-ab699c4cd823"] :db/ensure [:question/validate]} {:db/id "answer-field-6e468b59-ed57-5245-8552-ab699c4cd823" :answer-field/id #uuid "6e468b59-ed57-5245-8552-ab699c4cd823" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-564b3d3e-602c-575c-a336-e2050349d8a2" :answer-field/choices ["answer-41aa98ea-6885-56df-99e2-805caed70440" "answer-45e366fb-7b3c-5ab8-9a25-48471cc1bd8f" "answer-bb2b7b99-8dc8-5c2f-a8bb-b22376982638" "answer-e9235824-c3a9-51e0-bed6-3346dcaa38a2" "answer-564b3d3e-602c-575c-a336-e2050349d8a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-41aa98ea-6885-56df-99e2-805caed70440" :answer/id #uuid "41aa98ea-6885-56df-99e2-805caed70440" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}>1}" :db/ensure [:answer/validate]} {:db/id "answer-45e366fb-7b3c-5ab8-9a25-48471cc1bd8f" :answer/id #uuid "45e366fb-7b3c-5ab8-9a25-48471cc1bd8f" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}" :db/ensure [:answer/validate]} {:db/id "answer-bb2b7b99-8dc8-5c2f-a8bb-b22376982638" :answer/id #uuid "bb2b7b99-8dc8-5c2f-a8bb-b22376982638" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}<1}" :db/ensure [:answer/validate]} {:db/id "answer-e9235824-c3a9-51e0-bed6-3346dcaa38a2" :answer/id #uuid "e9235824-c3a9-51e0-bed6-3346dcaa38a2" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}>1}" :db/ensure [:answer/validate]} {:db/id "answer-564b3d3e-602c-575c-a336-e2050349d8a2" :answer/id #uuid "564b3d3e-602c-575c-a336-e2050349d8a2" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}" :db/ensure [:answer/validate]} {:db/id "activity-aca1ff7d-7c65-5187-a6ab-6e74a61c4826" :activity/id #uuid "aca1ff7d-7c65-5187-a6ab-6e74a61c4826" :activity/title "Ellipsoids" :activity/type :activity.type/review :activity/scope 17592186049477 :activity/course 17592186046659 :activity/steps ["step-d758e371-fe79-5bbb-9aa7-109ff13f942f" "step-4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" "step-df29086b-4196-5016-a17b-607b9ccbc4e9" "step-3276d5ad-c70a-52b0-8d3a-754d248220b5" "step-38ef1b20-2bbb-5c96-ab14-7866ebfef469"] :activity/first-step "step-d758e371-fe79-5bbb-9aa7-109ff13f942f" :db/ensure [:activity/validate]} {:db/id "step-d758e371-fe79-5bbb-9aa7-109ff13f942f" :step/id #uuid "d758e371-fe79-5bbb-9aa7-109ff13f942f" :step/content 17592186339018 :step/next "step-4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" :db/ensure [:step/validate]} {:db/id "step-4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" :step/id #uuid "4bbb34e5-8d32-5bf4-847f-6d8da9ec