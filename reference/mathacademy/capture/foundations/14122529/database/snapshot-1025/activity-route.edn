#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186419600} :activity/id #uuid "aca1ff7d-7c65-5187-a6ab-6e74a61c4826" :activity/scope {:db/id #edb/ref 17592186049477 :topic/id #uuid "f843541a-9614-5f09-bac2-fce7637a0932" :topic/math-academy-id 1896} :activity/steps [{:db/id #edb/ref 17592186419597 :step/content {:db/id #edb/ref 17592186419596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41aa98ea-6885-56df-99e2-805caed70440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}>1}" :db/id #edb/ref 17592186419590} {:answer/id #uuid "45e366fb-7b3c-5ab8-9a25-48471cc1bd8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}" :db/id #edb/ref 17592186419591} {:answer/id #uuid "564b3d3e-602c-575c-a336-e2050349d8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}" :db/id #edb/ref 17592186419592} {:answer/id #uuid "bb2b7b99-8dc8-5c2f-a8bb-b22376982638" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}<1}" :db/id #edb/ref 17592186419593} {:answer/id #uuid "e9235824-c3a9-51e0-bed6-3346dcaa38a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}>1}" :db/id #edb/ref 17592186419594}] :answer-field/correct {:db/id #edb/ref 17592186419592} :answer-field/id #uuid "6e468b59-ed57-5245-8552-ab699c4cd823" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419595}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "204288b8-790b-5fba-b88f-1aae9820b71f" :question/math-academy-id "q-164316" :question/problem "Given the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2} & =1 \\\\ (z-1)^{2} & =1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4} \\\\ z-1 & =\\pm \\sqrt{1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}\\ge 0 \\\\ \\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}=1$ and its boundary. \n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}.\n$$"} :step/id #uuid "3276d5ad-c70a-52b0-8d3a-754d248220b5" :step/next {:db/id #edb/ref 17592186419598}} {:db/id #edb/ref 17592186419598 :step/content {:db/id #edb/ref 17592186284477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e625bc8-a4f0-55f8-b453-92f6041add8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $9$ centered at $(3,-1)$" :db/id #edb/ref 17592186281962} {:answer/id #uuid "489bc5c0-5f54-5f70-97cd-aa938800d595" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(-3,1)$" :db/id #edb/ref 17592186282304} {:answer/id #uuid "5138def5-d59a-5f50-89d4-35d223267a92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $9$ centered at $(-3,-1)$" :db/id #edb/ref 17592186282384} {:answer/id #uuid "989e0f17-b369-5205-b190-fa1092c5bee9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,4)$" :db/id #edb/ref 17592186283011} {:answer/id #uuid "a9e164f2-317e-57c2-83ee-264969da7739" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,-1)$" :db/id #edb/ref 17592186283163}] :answer-field/correct {:db/id #edb/ref 17592186282304} :answer-field/id #uuid "d25b7f48-2f3f-5171-a3c9-931824f7ca3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284301}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6afd7b69-5cc1-5a73-9071-703e04661638" :question/math-academy-id "q-164378" :question/problem "Given the sphere $(x+3)^{2}+(y-1)^{2}+(z-4)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-1)^{2}+(z-4)^{2} & =9 \\\\ (z-4)^{2} & =9-((x+3)^{2}+(y-1)^{2}) \\\\ z-4 & =\\pm \\sqrt{9-({x}^{2}+(y+3)^{2})} \\\\ z & =4\\pm \\sqrt{9-((x+3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x+3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x+3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x+3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(-3,1)$ in the $xy$-plane."} :step/id #uuid "38ef1b20-2bbb-5c96-ab14-7866ebfef469"} {:db/id #edb/ref 17592186419599 :step/content {:db/id #edb/ref 17592186339019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ee28c2-2985-581b-8e4f-846f188976a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The circle of radius $\\sqrt{5}$ centered at $(0,2)$" :db/id #edb/ref 17592186337214} {:answer/id #uuid "a716f8fb-2807-5197-8616-199b41c26567" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The circle of radius $6$ centered at $(0,2)$" :db/id #edb/ref 17592186337544} {:answer/id #uuid "b4ba2520-ca20-55e4-ab5c-8f7dbecccb1b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,-2)$" :db/id #edb/ref 17592186337636} {:answer/id #uuid "c9505a17-d88e-595c-b6a3-ee7ceba8ad55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The circle of radius $20$ centered at $(0,-2)$" :db/id #edb/ref 17592186337811} {:answer/id #uuid "d7277dc5-3ba0-5360-8674-c6513318a0cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,2)$" :db/id #edb/ref 17592186337900}] :answer-field/correct {:db/id #edb/ref 17592186337900} :answer-field/id #uuid "1ba416b5-5daf-5e81-b6d8-4eac8b41622c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338326}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6659b2ae-532f-58c0-9b8a-93e7c4f9a624" :question/math-academy-id "q-71949" :question/problem "What is the projection of the intersection between the sphere ${x}^{2}+(y-2)^{2}+(z+1)^{2}=36$ and the plane $z=3$ onto the $xy$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $z=3$, we substitute $z=3$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2}+(3+1)^{2} & =36 \\\\ {x}^{2}+(y-2)^{2}+16 & =36 \\\\ {x}^{2}+(y-2)^{2} & =20 \\\\ {x}^{2}+(y-2)^{2} & =(2\\sqrt{5})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xy$-plane gives us the equation of the circle of radius $2\\sqrt{5}$ centered at $(0,2).$"} :step/id #uuid "4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" :step/next {:db/id #edb/ref 17592186419601}} {:db/id #edb/ref 17592186419600 :step/content {:db/id #edb/ref 17592186339018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572ddd40-8679-5198-b9d6-f4db2a7838d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}+(z-1)^{2}=9" :db/id #edb/ref 17592186336832} {:answer/id #uuid "714c612a-e639-5e65-bb3f-eb12152c55f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}+(z+1)^{2}=3" :db/id #edb/ref 17592186337044} {:answer/id #uuid "81a670a9-b024-5136-80ec-fd25c71d23bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}+(z-1)^{2}=36" :db/id #edb/ref 17592186337209} {:answer/id #uuid "b436f023-060b-5354-9f1c-0dc1682a2c3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186337632} {:answer/id #uuid "e4acb98f-accf-5e18-82c5-10ffd96a9be7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}+(z+1)^{2}=41" :db/id #edb/ref 17592186338026}] :answer-field/correct {:db/id #edb/ref 17592186337632} :answer-field/id #uuid "c11c86a5-f436-5d1a-8f41-6ed3efce843e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338620}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73a6f932-1d38-5734-a9eb-076d70aa6439" :question/math-academy-id "q-71947" :question/problem "What is the trace in the $yz$-plane of the sphere $(x-4)^{2}+{y}^{2}+(z+1)^{2}=25?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0-4)^{2}+{y}^{2}+(z+1)^{2} & =25 \\\\ 16+{y}^{2}+(z+1)^{2} & =25 \\\\ {y}^{2}+(z+1)^{2} & =9\\end{aligned}\n$$"} :step/id #uuid "d758e371-fe79-5bbb-9aa7-109ff13f942f" :step/next {:db/id #edb/ref 17592186419599}} {:db/id #edb/ref 17592186419601 :step/content {:db/id #edb/ref 17592186403613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186403615} {:answer/id #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403616} {:answer/id #uuid "81a50ee6-a29f-5cf2-ba44-251758623d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-4,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403617} {:answer/id #uuid "ef09c53b-97f7-594e-a8f7-fee68af6a063" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(4,0,0)$ only" :db/id #edb/ref 17592186403618} {:answer/id #uuid "b4640bb5-2749-5d8c-bb08-ee4349a6f316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-3\\sqrt{2},0,0)$ and $(3\\sqrt{2},0,0)$" :db/id #edb/ref 17592186403619}] :answer-field/correct {:db/id #edb/ref 17592186403616} :answer-field/id #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403614}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" :question/math-academy-id "q-73190" :question/problem "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$"} :step/id #uuid "df29086b-4196-5016-a17b-607b9ccbc4e9" :step/next {:db/id #edb/ref 17592186419597}}] :activity/title "Ellipsoids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186419589}]}
