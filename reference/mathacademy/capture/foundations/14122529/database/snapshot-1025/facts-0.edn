3 #uuid "45e366fb-7b3c-5ab8-9a25-48471cc1bd8f" #edb/ref 17592186045417] [17592186419592 #edb/ref 1080 "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}" #edb/ref 17592186045417] [17592186419592 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186419592 #edb/ref 1083 #uuid "564b3d3e-602c-575c-a336-e2050349d8a2" #edb/ref 17592186045417] [17592186419593 #edb/ref 1080 "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}<1}" #edb/ref 17592186045417] [17592186419593 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186419593 #edb/ref 1083 #uuid "bb2b7b99-8dc8-5c2f-a8bb-b22376982638" #edb/ref 17592186045417] [17592186419594 #edb/ref 1080 "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}>1}" #edb/ref 17592186045417] [17592186419594 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186419594 #edb/ref 1083 #uuid "e9235824-c3a9-51e0-bed6-3346dcaa38a2" #edb/ref 17592186045417] [17592186419595 #edb/ref 1075 #edb/ref 17592186419590 #edb/ref 17592186045417] [17592186419595 #edb/ref 1075 #edb/ref 17592186419591 #edb/ref 17592186045417] [17592186419595 #edb/ref 1075 #edb/ref 17592186419592 #edb/ref 17592186045417] [17592186419595 #edb/ref 1075 #edb/ref 17592186419593 #edb/ref 17592186045417] [17592186419595 #edb/ref 1075 #edb/ref 17592186419594 #edb/ref 17592186045417] [17592186419595 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186419595 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186419595 #edb/ref 1078 #edb/ref 17592186419592 #edb/ref 17592186045417] [17592186419595 #edb/ref 1079 #uuid "6e468b59-ed57-5245-8552-ab699c4cd823" #edb/ref 17592186045417] [17592186419596 #edb/ref 1068 #edb/ref 17592186419595 #edb/ref 17592186045417] [17592186419596 #edb/ref 1069 "q-164316" #edb/ref 17592186045417] [17592186419596 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186419596 #edb/ref 1071 "Given the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2}=1$, find the domain of $z=z(x,y).$" #edb/ref 17592186045417] [17592186419596 #edb/ref 1072 #uuid "204288b8-790b-5fba-b88f-1aae9820b71f" #edb/ref 17592186045417] [17592186419596 #edb/ref 1074 "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2} & =1 \\\\ (z-1)^{2} & =1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4} \\\\ z-1 & =\\pm \\sqrt{1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}\\ge 0 \\\\ \\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}=1$ and its boundary. \n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}.\n$$" #edb/ref 17592186045417] [17592186419597 #edb/ref 1058 #edb/ref 17592186419598 #edb/ref 17592186045417] [17592186419597 #edb/ref 1062 #uuid "3276d5ad-c70a-52b0-8d3a-754d248220b5" #edb/ref 17592186045417] [17592186419597 #edb/ref 1063 #edb/ref 17592186419596 #edb/ref 17592186045417] [17592186419598 #edb/ref 1062 #uuid "38ef1b20-2bbb-5c96-ab14-7866ebfef469" #edb/ref 17592186045417] [17592186419598 #edb/ref 1063 #edb/ref 17592186284477 #edb/ref 17592186045417] [17592186419599 #edb/ref 1058 #edb/ref 17592186419601 #edb/ref 17592186045417] [17592186419599 #edb/ref 1062 #uuid "4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" #edb/ref 17592186045417] [17592186419599 #edb/ref 1063 #edb/ref 17592186339019 #edb/ref 17592186045417] [17592186419600 #edb/ref 1058 #edb/ref 17592186419599 #edb/ref 17592186045417] [17592186419600 #edb/ref 1062 #uuid "d758e371-fe79-5bbb-9aa7-109ff13f942f" #edb/ref 17592186045417] [17592186419600 #edb/ref 1063 #edb/ref 17592186339018 #edb/ref 17592186045417] [17592186419601 #edb/ref 1058 #edb/ref 17592186419597 #edb/ref 17592186045417] [17592186419601 #edb/ref 1062 #uuid "df