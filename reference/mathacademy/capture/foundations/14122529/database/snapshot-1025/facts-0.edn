db/ref 17592186045485 #edb/ref 17592186045417] [17592186339018 #edb/ref 1071 "What is the trace in the $yz$-plane of the sphere $(x-4)^{2}+{y}^{2}+(z+1)^{2}=25?$" #edb/ref 17592186045417] [17592186339018 #edb/ref 1072 #uuid "73a6f932-1d38-5734-a9eb-076d70aa6439" #edb/ref 17592186045417] [17592186339018 #edb/ref 1074 "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0-4)^{2}+{y}^{2}+(z+1)^{2} & =25 \\\\ 16+{y}^{2}+(z+1)^{2} & =25 \\\\ {y}^{2}+(z+1)^{2} & =9\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186339019 #edb/ref 1068 #edb/ref 17592186338326 #edb/ref 17592186045417] [17592186339019 #edb/ref 1069 "q-71949" #edb/ref 17592186045417] [17592186339019 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186339019 #edb/ref 1071 "What is the projection of the intersection between the sphere ${x}^{2}+(y-2)^{2}+(z+1)^{2}=36$ and the plane $z=3$ onto the $xy$-plane." #edb/ref 17592186045417] [17592186339019 #edb/ref 1072 #uuid "6659b2ae-532f-58c0-9b8a-93e7c4f9a624" #edb/ref 17592186045417] [17592186339019 #edb/ref 1074 "To find the intersection of the sphere and the plane $z=3$, we substitute $z=3$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2}+(3+1)^{2} & =36 \\\\ {x}^{2}+(y-2)^{2}+16 & =36 \\\\ {x}^{2}+(y-2)^{2} & =20 \\\\ {x}^{2}+(y-2)^{2} & =(2\\sqrt{5})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xy$-plane gives us the equation of the circle of radius $2\\sqrt{5}$ centered at $(0,2).$" #edb/ref 17592186045417] [17592186403613 #edb/ref 1068 #edb/ref 17592186403614 #edb/ref 17592186045417] [17592186403613 #edb/ref 1069 "q-73190" #edb/ref 17592186045417] [17592186403613 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186403613 #edb/ref 1071 "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." #edb/ref 17592186045417] [17592186403613 #edb/ref 1072 #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" #edb/ref 17592186045417] [17592186403613 #edb/ref 1074 "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$" #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403615 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403616 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403617 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403618 #edb/ref 17592186045417] [17592186403614 #edb/ref 1075 #edb/ref 17592186403619 #edb/ref 17592186045417] [17592186403614 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186403614 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186403614 #edb/ref 1078 #edb/ref 17592186403616 #edb/ref 17592186045417] [17592186403614 #edb/ref 1079 #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" #edb/ref 17592186045417] [17592186403615 #edb/ref 1080 "$(0,0,0)$ and $(2,0,0)$" #edb/ref 17592186045417] [17592186403615 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403615 #edb/ref 1083 #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" #edb/ref 17592186045417] [17592186403616 #edb/ref 1080 "$(-2,0,0)$ and $(4,0,0)$" #edb/ref 17592186045417] [17592186403616 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403616 #edb/ref 1083 #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" #edb/ref 17592186045417] [17592186403617 #edb/ref 1080 "$(-4,0,0)$ and $(4,0,0)$" #edb/ref 17592186045417] [17592186403617 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403617 #edb/ref 10