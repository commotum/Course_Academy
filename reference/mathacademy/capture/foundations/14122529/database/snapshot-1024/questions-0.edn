#{[{:db/id #edb/ref 17592186284477 :knowledge-point/_questions [{:db/id #edb/ref 17592186124649 :knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e625bc8-a4f0-55f8-b453-92f6041add8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $9$ centered at $(3,-1)$" :db/id #edb/ref 17592186281962} {:answer/id #uuid "489bc5c0-5f54-5f70-97cd-aa938800d595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(-3,1)$" :db/id #edb/ref 17592186282304} {:answer/id #uuid "5138def5-d59a-5f50-89d4-35d223267a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $9$ centered at $(-3,-1)$" :db/id #edb/ref 17592186282384} {:answer/id #uuid "989e0f17-b369-5205-b190-fa1092c5bee9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,4)$" :db/id #edb/ref 17592186283011} {:answer/id #uuid "a9e164f2-317e-57c2-83ee-264969da7739" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,-1)$" :db/id #edb/ref 17592186283163}] :answer-field/correct {:answer/id #uuid "489bc5c0-5f54-5f70-97cd-aa938800d595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(-3,1)$" :db/id #edb/ref 17592186282304} :answer-field/id #uuid "d25b7f48-2f3f-5171-a3c9-931824f7ca3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284301}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6afd7b69-5cc1-5a73-9071-703e04661638" :question/math-academy-id "q-164378" :question/problem "Given the sphere $(x+3)^{2}+(y-1)^{2}+(z-4)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-1)^{2}+(z-4)^{2} & =9 \\\\ (z-4)^{2} & =9-((x+3)^{2}+(y-1)^{2}) \\\\ z-4 & =\\pm \\sqrt{9-({x}^{2}+(y+3)^{2})} \\\\ z & =4\\pm \\sqrt{9-((x+3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x+3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x+3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x+3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(-3,1)$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186339018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572ddd40-8679-5198-b9d6-f4db2a7838d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=9" :db/id #edb/ref 17592186336832} {:answer/id #uuid "714c612a-e639-5e65-bb3f-eb12152c55f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=3" :db/id #edb/ref 17592186337044} {:answer/id #uuid "81a670a9-b024-5136-80ec-fd25c71d23bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=36" :db/id #edb/ref 17592186337209} {:answer/id #uuid "b436f023-060b-5354-9f1c-0dc1682a2c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186337632} {:answer/id #uuid "e4acb98f-accf-5e18-82c5-10ffd96a9be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=41" :db/id #edb/ref 17592186338026}] :answer-field/correct {:answer/id #uuid "b436f023-060b-5354-9f1c-0dc1682a2c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186337632} :answer-field/id #uuid "c11c86a5-f436-5d1a-8f41-6ed3efce843e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73a6f932-1d38-5734-a9eb-076d70aa6439" :question/math-academy-id "q-71947" :question/problem "What is the trace in the $yz$-plane of the sphere $(x-4)^{2}+{y}^{2}+(z+1)^{2}=25?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0-4)^{2}+{y}^{2}+(z+1)^{2} & =25 \\\\ 16+{y}^{2}+(z+1)^{2} & =25 \\\\ {y}^{2}+(z+1)^{2} & =9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339019 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ee28c2-2985-581b-8e4f-846f188976a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $\\sqrt{5}$ centered at $(0,2)$" :db/id #edb/ref 17592186337214} {:answer/id #uuid "a716f8fb-2807-5197-8616-199b41c26567" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $6$ centered at $(0,2)$" :db/id #edb/ref 17592186337544} {:answer/id #uuid "b4ba2520-ca20-55e4-ab5c-8f7dbecccb1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,-2)$" :db/id #edb/ref 17592186337636} {:answer/id #uuid "c9505a17-d88e-595c-b6a3-ee7ceba8ad55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $20$ centered at $(0,-2)$" :db/id #edb/ref 17592186337811} {:answer/id #uuid "d7277dc5-3ba0-5360-8674-c6513318a0cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,2)$" :db/id #edb/ref 17592186337900}] :answer-field/correct {:answer/id #uuid "d7277dc5-3ba0-5360-8674-c6513318a0cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,2)$" :db/id #edb/ref 17592186337900} :answer-field/id #uuid "1ba416b5-5daf-5e81-b6d8-4eac8b41622c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338326}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6659b2ae-532f-58c0-9b8a-93e7c4f9a624" :question/math-academy-id "q-71949" :question/problem "What is the projection of the intersection between the sphere ${x}^{2}+(y-2)^{2}+(z+1)^{2}=36$ and the plane $z=3$ onto the $xy$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $z=3$, we substitute $z=3$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2}+(3+1)^{2} & =36 \\\\ {x}^{2}+(y-2)^{2}+16 & =36 \\\\ {x}^{2}+(y-2)^{2} & =20 \\\\ {x}^{2}+(y-2)^{2} & =(2\\sqrt{5})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xy$-plane gives us the equation of the circle of radius $2\\sqrt{5}$ centered at $(0,2).$"}] [{:db/id #edb/ref 17592186403613 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(2,0,0)$" :db/id #edb/ref 17592186403615} {:answer/id #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403616} {:answer/id #uuid "81a50ee6-a29f-5cf2-ba44-251758623d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403617} {:answer/id #uuid "ef09c53b-97f7-594e-a8f7-fee68af6a063" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(4,0,0)$ only" :db/id #edb/ref 17592186403618} {:answer/id #uuid "b4640bb5-2749-5d8c-bb08-ee4349a6f316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3\\sqrt{2},0,0)$ and $(3\\sqrt{2},0,0)$" :db/id #edb/ref 17592186403619}] :answer-field/correct {:answer/id #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,0,0)$ and $(4,0,0)$" :db/id #edb/ref 17592186403616} :answer-field/id #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403614}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" :question/math-academy-id "q-73190" :question/problem "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$"}]}
