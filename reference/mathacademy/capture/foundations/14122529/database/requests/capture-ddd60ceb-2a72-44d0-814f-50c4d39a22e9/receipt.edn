92 1082 #edb/ref 17592186045498 13194139534337 17592186045417 true] [17592186419592 1083 #uuid "564b3d3e-602c-575c-a336-e2050349d8a2" 13194139534337 17592186045417 true] [17592186419593 1080 "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}<1}" 13194139534337 17592186045417 true] [17592186419593 1082 #edb/ref 17592186045498 13194139534337 17592186045417 true] [17592186419593 1083 #uuid "bb2b7b99-8dc8-5c2f-a8bb-b22376982638" 13194139534337 17592186045417 true] [17592186419594 1080 "{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}>1}" 13194139534337 17592186045417 true] [17592186419594 1082 #edb/ref 17592186045498 13194139534337 17592186045417 true] [17592186419594 1083 #uuid "e9235824-c3a9-51e0-bed6-3346dcaa38a2" 13194139534337 17592186045417 true] [17592186419595 1075 #edb/ref 17592186419590 13194139534337 17592186045417 true] [17592186419595 1075 #edb/ref 17592186419591 13194139534337 17592186045417 true] [17592186419595 1075 #edb/ref 17592186419592 13194139534337 17592186045417 true] [17592186419595 1075 #edb/ref 17592186419593 13194139534337 17592186045417 true] [17592186419595 1075 #edb/ref 17592186419594 13194139534337 17592186045417 true] [17592186419595 1076 #edb/ref 17592186045493 13194139534337 17592186045417 true] [17592186419595 1077 "selection" 13194139534337 17592186045417 true] [17592186419595 1078 #edb/ref 17592186419592 13194139534337 17592186045417 true] [17592186419595 1079 #uuid "6e468b59-ed57-5245-8552-ab699c4cd823" 13194139534337 17592186045417 true] [17592186419596 1068 #edb/ref 17592186419595 13194139534337 17592186045417 true] [17592186419596 1069 "q-164316" 13194139534337 17592186045417 true] [17592186419596 1070 #edb/ref 17592186045486 13194139534337 17592186045417 true] [17592186419596 1071 "Given the ellipsoid $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2}=1$, find the domain of $z=z(x,y).$" 13194139534337 17592186045417 true] [17592186419596 1072 #uuid "204288b8-790b-5fba-b88f-1aae9820b71f" 13194139534337 17592186045417 true] [17592186419596 1074 "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}+(z-1)^{2} & =1 \\\\ (z-1)^{2} & =1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4} \\\\ z-1 & =\\pm \\sqrt{1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{{x}^{2}}{8}-\\frac{(y-2)^{2}}{4}\\ge 0 \\\\ \\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}=1$ and its boundary. \n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{8}+\\frac{(y-2)^{2}}{4}\\le 1}.\n$$" 13194139534337 17592186045417 true] [17592186419597 1058 #edb/ref 17592186419598 13194139534337 17592186045417 true] [17592186419597 1062 #uuid "3276d5ad-c70a-52b0-8d3a-754d248220b5" 13194139534337 17592186045417 true] [17592186419597 1063 #edb/ref 17592186419596 13194139534337 17592186045417 true] [17592186419598 1062 #uuid "38ef1b20-2bbb-5c96-ab14-7866ebfef469" 13194139534337 17592186045417 true] [17592186419598 1063 #edb/ref 17592186284477 13194139534337 17592186045417 true] [17592186419599 1058 #edb/ref 17592186419601 13194139534337 17592186045417 true] [17592186419599 1062 #uuid "4bbb34e5-8d32-5bf4-847f-6d8da9ecd8e8" 13194139534337 17592186045417 true] [17592186419599 1063 #edb/ref 17592186339019 13194139534337 17592186045417 true] [17592186419600 1058 #edb/ref 17592186419599 13194139534337 17592186045417 true] [17592186419600 1062 #uuid "d758e371-fe79-5bbb-9aa7-109ff13f942f" 13194139534337 17592186045417 true] [17592186419600 1063 #edb/ref 17592186339018 13194139534337 17592186045417 true] [17592186419601 1058 #edb/ref 17592186419597 13194139534337 17592186045417 true] [17592186419601 1062 #uuid "df29086b-4196-5016-a17b-607b9ccbc4e9" 13194139534337 17592186045417 true] [17592186419601 1063 #edb/ref 17592186403613 13194139534337 175921860