/ref 17592186123055}] :answer-field/id #uuid "912b4db0-e052-5337-99c9-aff6e5410f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123050}] :question/id #uuid "6369bf45-c149-5591-b6da-b79b10114d99" :question/math-academy-id "q-37517" :question/problem "Given the function $f(x, y) = \\cos (x^{2}) - 3y^{3}$, find the equation of the tangent line to the level curve that passes through the point where $(x, y) = (\\sqrt{π}, 2)$."}] [{:db/id #edb/ref 17592186393208 :knowledge-point/_questions [{:db/id #edb/ref 17592186124454 :knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f817dec0-31ee-5a90-a6ae-2391b9cf9403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,2⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393210} {:answer/id #uuid "d27aae8e-1b41-5a3d-9baf-285744999d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393211} {:answer/id #uuid "1898f2e5-1406-5cc8-82d7-46e5635ddabe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393212} {:answer/id #uuid "4d956027-e0b5-5ae7-a8b7-35ca7afa539e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,3⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393213} {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393214}] :answer-field/correct {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393214} :answer-field/id #uuid "d2b7a822-706f-59e1-aaeb-ea5e1255d429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393209}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85c3a288-e595-578f-a534-db75ed9d872f" :question/math-academy-id "q-72377" :question/problem "Given the function $f(x,y)=2x{y}^{2}+xy+2x$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2x{y}^{2}+xy+2x)\\,i+\\frac{∂}{∂y}(2x{y}^{2}+xy+2x)\\,j \\\\  & =(2{y}^{2}+y+2)\\,i+(4xy+x)\\,j \\\\ ∇\\,f(1,1) & =(2(1)^{2}+(1)+2)\\,i+(4(1)(1)+(1))\\,j \\\\  & =5\\,i+5\\,j \\\\  & =⟨5,5⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,1)\\cdot ⟨x-1,\\,y-1⟩ & =0 \\\\ ⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩ & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339107 :knowledge-point/_questions [{:db/id #edb/ref 17592186124455 :knowledge-point/id #uuid "348fa49f-2af8-5562-91f6-3f70bb93ea90" :knowledge-point/title "Finding a Tangent Vector to a Plane Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a7f7daf-eab5-5f09-9994-fb78510d1452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,i+6\\,j" :db/id #edb/ref 17592186336857} {:answer/id #uuid "5bdf6205-616a-5fe8-bae1-1eafc7069834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186336867} {:answer/id #uuid "5f640f70-dd55-53af-a444-45f3d1013ded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i-j" :db/id #edb/ref 17592186336897} {:answer/id #uuid "6d1b9f33-c38c-59c8-99f2-2467570782ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+6\\,j" :db/id #edb/ref 17592186337000} {:answer/id #uuid "9f2d1ea8-f373-5f19-800d-34e70ba82c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i-6\\,j" :db/id #edb/ref 17592186337470}] :answer-field/correct {:answer/id #uuid "5a7f7daf-eab5-5f09-9994-fb78510d1452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,i+6\\,j" :db/id #edb/ref 17592186336857} :answer-field/id #uuid "31c46a4e-d03a-5a5a-b5e5-3a014deba440" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338371}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "148b9435-dbdc-5e2a-8580-1b7906c6cec6" :question/math-academy-id "q-72400" :question/problem "Consider the plane curve ${x}^{2}+{y}^{2}=2xy+9.$ Find a tangent vector to that curve at the point $(-1,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2xy+9 \\\\ {x}^{2}+{y}^{2}-2xy-9 & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}-2xy-9$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(-1,2)$ can be computed as follows:\n\n$$\nt(-1,2)={f}_{y}(-1,2)\\,i-{f}_{x}(-1,2)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,2):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}-2xy-9)\\,i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}-2xy-9)\\,j \\\\  & =(2y-2x)\\,i-(2x-2y)\\,j \\\\ t(-1,2) & =(2(2)-2(-1))\\,i-(2(-1)-2(2))\\,j \\\\  & =6\\,i+6\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $6\\,i+6\\,j.$"}] [{:db/id #edb/ref 17592186375335 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27399e42-4acc-553e-ba4e-5998ae4da3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-2)$ and $(0,1)$" :db/id #edb/ref 17592186375337} {:answer/id #uuid "a57c1eee-a86d-5c18-9d82-3d9e99558aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(1,0)$" :db/id #edb/ref 17592186375338} {:answer/id #uuid "bfb1fb31-2625-5bc1-9263-d7661c3e1d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ and $(2,0)$" :db/id #edb/ref 17592186375339} {:answer/id #uuid "ec3841f3-4849-5ca6-b655-2344b4b09e89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-2)$ and $(1,0)$" :db/id #edb/ref 17592186375340} {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id #edb/ref 17592186375341}] :answer-field/correct {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id #edb/ref 17592186375341} :answer-field/id #uuid "079e80ed-3676-528f-b478-841f2caa3b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375336}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "703e7046-bcfc-54c8-9bb1-c367d4d9ddb7" :question/math-academy-id "q-72427" :question/problem "At which points on the curve ${y}^{2}+2x=2xy+2y-2$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2x & =2xy+2y-2 \\\\ {y}^{2}+2x-2xy-2y & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2x-2xy-2y$, our curve can be viewed as the level curve $f(x,y)=-2.$  \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2x-2xy-2y)i-\\frac{∂}{∂x}({y}^{2}+2x-2xy-2y)j \\\\  & =(2y-2x-2)\\,i-(2-2y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-2x-2)\\,i-(2-2y)\\,j)\\cdot i & =0 \\\\ 2y-2x-2 & =0 \\\\ 2(y-x-1) & =0 \\\\ y & =x+1\\end{aligned}\n$$\n\nSubstituting $y=x+1$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2x-2xy-2y & =-2 \\\\ (x+1)^{2}+2x-2x(x+1)-2(x+1)+2 & =0 \\\\ (x+1)^{2}-2x(x+1)-2(x+1)+2(x+1) & =0 \\\\ (x+1)^{2}-2x(x+1)-\\cancel{2(x+1)}+\\cancel{2(x+1)} & =0 \\\\ (x+1)^{2}-2x(x+1) & =0 \\\\ (x+1)(x+1-2x) & =0 \\\\ (x+1)(-x+1) & =0 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=0$ and the corresponding point is $(-1,0).$"}] [{:db/id #edb/ref 17592186339122 :knowledge-point/_questions [{:db/id #edb/ref 17592186124455 :knowledge-point/id #uuid "348fa49f-2af8-5562-91f6-3f70bb93ea90" :knowledge-point/title "Finding a Tangent Vector to a Plane Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a24f4b8-a184-5828-8c72-dcc5b94e5943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,i-5\\,j" :db/id #edb/ref 17592186336423} {:answer/id #uuid "2afed586-1f6a-50fd-ad21-c54f17e514f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186336436} {:answer/id #uuid "af297190-71a7-5741-8317-95edf63e83e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+5\\,j" :db/id #edb/ref 17592186337604} {:answer/id #uuid "be71b2b4-857d-5122-ac95-bc07fb632330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,i-j" :db/id #edb/ref 17592186337725} {:answer/id #uuid "c71d302c-3c74-5be4-b48a-d3f52171a59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\,j" :db/id #edb/ref 17592186337799}] :answer-field/correct {:answer/id #uuid "c71d302c-3c74-5be4-b48a-d3f52171a59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\,j" :db/id #edb/ref 17592186337799} :answer-field/id #uuid "26dc6ba3-c35c-5f43-8491-310a9b2258ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338352}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c4a11cf-62cb-5e11-869c-4992e2a1b6f6" :question/math-academy-id "q-72463" :question/problem "Consider the plane curve $2{x}^{3}{y}^{2}-4xy=1-3x.$ Find a tangent vector to that curve at the point $(1,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{3}{y}^{2}-4xy & =1-3x \\\\ 2{x}^{3}{y}^{2}-4xy+3x & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{3}{y}^{2}-4xy+3x$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(1,1)$ can be computed as follows:\n\n$$\nt(1,1)={f}_{y}(1,1)i-{f}_{x}(1,1)j\n$$\n\n \n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2{x}^{3}{y}^{2}-4xy+3x)i-\\frac{∂}{∂x}(2{x}^{3}{y}^{2}-4xy+3x)j \\\\  & =(4y{x}^{3}-4x)i-(6{x}^{2}{y}^{2}-4y+3)j \\\\ t(1,1) & =(4(1)(1)^{3}-4(1))i-(6(1)^{2}(1)^{2}-4(1)+3)j \\\\  & =-5\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-5\\,j.$"}]}
