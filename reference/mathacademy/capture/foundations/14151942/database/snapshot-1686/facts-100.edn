b/ref 17592186447361 #edb/ref 17592186045417] [17592186447369 #edb/ref 1075 #edb/ref 17592186447363 #edb/ref 17592186045417] [17592186447369 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186447369 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186447369 #edb/ref 1078 #edb/ref 17592186447348 #edb/ref 17592186045417] [17592186447369 #edb/ref 1079 #uuid "74d8ed8e-549b-58fd-a410-9d0b085953e8" #edb/ref 17592186045417] [17592186447370 #edb/ref 1068 #edb/ref 17592186447367 #edb/ref 17592186045417] [17592186447370 #edb/ref 1069 "q-130102" #edb/ref 17592186045417] [17592186447370 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186447370 #edb/ref 1071 "Given the function $f(x,y)=\\operatorname{sin}⁡({x}^{2}-y)$ find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(0,\\pi ).$" #edb/ref 17592186045417] [17592186447370 #edb/ref 1072 #uuid "1c716d26-2571-5872-95a3-6c53428692e0" #edb/ref 17592186045417] [17592186447370 #edb/ref 1074 "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(0,\\pi ):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡({x}^{2}-y))\\,i+\\frac{∂}{∂y}(\\operatorname{sin}⁡({x}^{2}-y))\\,j \\\\  & =2x\\operatorname{cos}⁡({x}^{2}-y)\\,i-\\operatorname{cos}⁡({x}^{2}-y)\\,j \\\\ ∇f(0,\\pi ) & =2(0)\\operatorname{cos}⁡({0}^{2}-\\pi )\\,i-\\operatorname{cos}⁡({0}^{2}-\\pi )\\,j \\\\  & =0\\,i+j \\\\  & =⟨0,1⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(0,\\pi )\\cdot ⟨x-0,\\,y-\\pi ⟩ & =0 \\\\ ⟨0,1⟩\\cdot ⟨x,\\,y-\\pi ⟩ & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186447371 #edb/ref 1068 #edb/ref 17592186447366 #edb/ref 17592186045417] [17592186447371 #edb/ref 1069 "q-130227" #edb/ref 17592186045417] [17592186447371 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186447371 #edb/ref 1071 "At which point on the curve ${x}^{2}-{y}^{2}=xy$ is the tangent vector to the curve perpendicular to the vector $i?$" #edb/ref 17592186045417] [17592186447371 #edb/ref 1072 #uuid "2ac861e6-ea7e-53f0-b9c2-bba93cd70561" #edb/ref 17592186045417] [17592186447371 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =xy \\\\ {x}^{2}-{y}^{2}-xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}-{y}^{2}-xy,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}-{y}^{2}-xy)\\,i-\\frac{∂}{∂x}({x}^{2}-{y}^{2}-xy)\\,j \\\\  & =(-2y-x)\\,i-(2x-y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i,$ we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((-2y-x)\\,i-(2x-y)\\,j)\\cdot i & =0 \\\\ -2y-x & =0 \\\\ x & =-2y\\end{aligned}\n$$\n\nSubstituting $x=-2y$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =xy \\\\ (-2y)^{2}-{y}^{2} & =(-2y)y \\\\ 4{y}^{2}-{y}^{2} & =-2{y}^{2} \\\\ 5{y}^{2} & =0 \\\\ y & =0.\\end{aligned}\n$$\n\nFinally, for $y=0,$ we get $x=0,$ and the corresponding point is $(0,0).$" #edb/ref 17592186045417] [17592186447372 #edb/ref 1068 #edb/ref 17592186447369 #edb/ref 17592186045417] [17592186447372 #edb/ref 1069 "q-72403" #edb/ref 17592186045417] [17592186447372 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186447372 #edb/ref 1071 "Consider the plane curve $(x-y)^{2}=2x-y.$ Find a tangent vector to that curve at the point $(2,0).$" #edb/ref 17592186045417] [17592186447372 #edb/ref 1072 #uuid "43788191-a65e-5058-bbfd-37ff934a1aa8" #edb/ref 17592186045417] [17592186447372 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}(x-y)^{2} & =2x-y \\\\ (x-y)^{2}-2x+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=(x-y)^{2}-2x+y$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(2,0)$ can be computed as follows:\n\n$$\nt(2,0)={f}_{y}(2,0)i-{f}_{x}(2,0)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(2,0):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}((x-y)^{2}-2x+y)i-\\frac{∂}{∂x}((x-y)^{2}-2x+y)j \\\\  & =(-2(x-y)+1)i-(2(x-y)-2)j \\\\ t(2,0) & =(-2((2)-(0))+1)\\,i-((2((2)-(0))-2)\\,j \\\\  & =-3\\,i-2\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-3\\,i-2\\,j.$" #edb/ref 17592186045417] [17592186447373 #edb/ref 1068 #edb/ref 17592186447368 #edb/ref 17592186045417] [17592186447373 #edb/ref 1069 "q-36397" #edb/ref 17592186045417] [17592186447373 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186447373 #edb/ref 1071 "Given the function $f(x,y)=3xy+4x+6y-5{y}^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,2).$" #edb/ref 17592186045417] [17592186447373 #edb/ref 1072 #uuid "7d7bf3ca-d3c4-5a27-836b-a5e78d17fbc9" #edb/ref 17592186045417] [17592186447373 #edb/ref 1074 "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,2):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(3xy+4x+6y-5{y}^{2})i+\\frac{∂}{∂y}(3xy+4x+6y-5{y}^{2})j \\\\  & =(3y+4)\\,i+(3x+6-10y)\\,j \\\\ ∇\\,f(1,2) & =(3(2)+4)\\,i+(3(1)+6-10(2))\\,j \\\\  & =10\\,i-11\\,j \\\\  & =⟨10,-11⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,2)\\cdot ⟨x-1,\\,y-2⟩ & =0 \\\\ ⟨10,-11⟩\\cdot ⟨x-1,\\,y-2⟩ & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186447374 #edb/ref 1068 #edb/ref 17592186447365 #edb/ref 17592186045417] [17592186447374 #edb/ref 1069 "q-130213" #edb/ref 17592186045417] [17592186447374 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186447374 #edb/ref 1071 "At which point on the curve $x{y}^{2}=3-2y$ is the tangent vector to the curve perpendicular to the vector $i?$" #edb/ref 17592186045417] [17592186447374 #edb/ref 1072 #uuid "caca4712-f17f-5ed4-8f57-6c6c5c27d1ce" #edb/ref 17592186045417] [17592186447374 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{y}^{2} & =3-2y \\\\ x{y}^{2}+2y & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)=x{y}^{2}+2y,$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(x{y}^{2}+2y)\\,i-\\frac{∂}{∂x}(x{y}^{2}+2y)\\,j \\\\  & =(2xy+2)\\,i-{y}^{2}\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i,$ we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2xy+2)\\,i-{y}^{2}\\,j)\\cdot i & =0 \\\\ 2xy+2 & =0 \\\\ xy+1 & =0 \\\\ y & =-\\frac{1}{x}\\end{aligned}\n$$\n\nSubstituting $y=-\\frac{1}{x}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}x{y}^{2} & =3-2y \\\\ x{(-\\frac{1}{x})}^{2} & =3-2(-\\frac{1}{x}) \\\\ \\frac{1}{x} & =3+\\frac{2}{x} \\\\ \\frac{1}{x} & =-3 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, for $x=-\\frac{1}{3},$ we get $y=3,$ and the corresponding point is $(-\\frac{1}{3},3).$" #edb/ref 17592186045417]}
