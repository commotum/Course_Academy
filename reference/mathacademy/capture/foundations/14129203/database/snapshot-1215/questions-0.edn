#{[{:db/id #edb/ref 17592186284502 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ec10b85-158a-537f-8f3b-7e461f364450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282102} {:answer/id #uuid "312d414b-5db9-57e9-84e6-360219089048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282130} {:answer/id #uuid "95cd6ae2-2d5d-52f3-aec7-fe144815e805" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282982} {:answer/id #uuid "9ba9cfde-201a-5af6-befd-71848e48b210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283049} {:answer/id #uuid "d9f6b844-3abd-5b20-a453-cdc1c62602dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283590}] :answer-field/correct {:answer/id #uuid "312d414b-5db9-57e9-84e6-360219089048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282130} :answer-field/id #uuid "89171ada-3e2f-5819-a223-5db3a30c8df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284171}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "555cf7a1-a40b-509e-b58a-e7cfea474b5b" :question/math-academy-id "q-164516" :question/problem "Identify the following surface: \n\n$$\n{y}^{2}+{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, an elliptic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is an elliptic cylinder whose axis of symmetry is the $x$-axis and $b=c=1.$"}] [{:db/id #edb/ref 17592186284509 :knowledge-point/_questions [{:db/id #edb/ref 17592186124652 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed8708a-539b-5dc4-aeb2-fc6af330696d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186281821} {:answer/id #uuid "6ce0758d-7294-5d05-b56c-13fc4f0f6385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282621} {:answer/id #uuid "6f9f9c26-5c32-5a2c-84d7-43b1c3ee806b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282643} {:answer/id #uuid "af7f7724-53c4-5017-aa18-cddcab68aba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283204} {:answer/id #uuid "fab7a9b7-07be-5a7b-a93a-2fed20308834" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186283882}] :answer-field/correct {:answer/id #uuid "af7f7724-53c4-5017-aa18-cddcab68aba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283204} :answer-field/id #uuid "5a71416d-3a97-52be-8397-a3db5f2cce08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284084}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f6408ec-2d9a-573b-91f2-4270763372c3" :question/math-academy-id "q-164543" :question/problem "Identify the following surface:\n\n$$\n4{y}^{2}-3{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, a hyperbolic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is a hyperbolic cylinder whose axis of symmetry is the $x$-axis and $b=\\frac{1}{2},\\,c=\\frac{1}{\\sqrt{3}}.$"}] [{:db/id #edb/ref 17592186401544 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1243d3b-361e-5bdf-975f-049a3ec6fa01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,-1)$" :db/id #edb/ref 17592186401546} {:answer/id #uuid "fa487f89-3be7-5d40-961d-7546309e11de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186401547} {:answer/id #uuid "025044f2-a8e8-56c9-abcc-e56e1609a263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of two sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401548} {:answer/id #uuid "1c63b753-83a9-5faf-9522-2b10200701ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401549} {:answer/id #uuid "a76c934a-6a50-5b6b-97fe-08774387e03f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,1,1)$" :db/id #edb/ref 17592186401550}] :answer-field/correct {:answer/id #uuid "fa487f89-3be7-5d40-961d-7546309e11de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186401547} :answer-field/id #uuid "fffbfe5a-e6b2-509f-a19b-67c3c7c49922" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401545}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "040e9acf-1af9-5813-86f6-e469cb0eecc9" :question/math-academy-id "q-164553" :question/problem "Identify the surface $5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15 & =0 \\\\ 5({x}^{2}+4x)-{y}^{2}-5({z}^{2}-2z)+15 & =0 \\\\ 5[(x+2)^{2}-4]-{y}^{2}-5[(z-1)^{2}-1]+15 & =0 \\\\ 5(x+2)^{2}-20-{y}^{2}-5(z-1)^{2}+5+15 & =0 \\\\ 5(x+2)^{2}-{y}^{2}-5(z-1)^{2} & =0 \\\\ -5(x+2)^{2}+{y}^{2}+5(z-1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(-2,0,1).$"}] [{:db/id #edb/ref 17592186402488 :knowledge-point/_questions [{:db/id #edb/ref 17592186124597 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf28e93-9856-5b88-a118-c7fdc1ed380b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/id #edb/ref 17592186402490} {:answer/id #uuid "d6d90baa-2f68-5b86-bc0d-0f5ed5239cce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/id #edb/ref 17592186402491} {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} {:answer/id #uuid "2604ccf1-dbcb-5550-afc6-5a2d18ea1503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402493} {:answer/id #uuid "13ce61ca-12c4-556e-a368-7a6ff53f5341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/id #edb/ref 17592186402494}] :answer-field/correct {:answer/id #uuid "09418836-8d85-5969-8422-a7c16a4c010f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186402492} :answer-field/id #uuid "c51d387c-bf0a-5c35-97a8-9dc15337e4ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$"}]}
