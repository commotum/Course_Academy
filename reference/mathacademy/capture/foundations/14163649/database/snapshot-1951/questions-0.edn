0fc383.png)\n\nAmong the given options, the only one that does not satisfy this definition is the following: \n\n![](images/4a/4a67c845fe7993fe0c91784c92201db6ff5c15098db04dc588f5ebe0e8cdc1a1.png)"}] [{:db/id #edb/ref 17592186172291 :knowledge-point/_questions [{:db/id #edb/ref 17592186172091 :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aec1b3a-f253-5279-99f6-12a688430707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186168610} {:answer/id #uuid "acbd015f-0d6c-538b-9f05-45ee71f8c513" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186168611} {:answer/id #uuid "d8e6ebd5-405c-535f-9ceb-b01c692d8bcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186168612} {:answer/id #uuid "53f9ce92-f40b-51c9-86f1-dceb0bbaeb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186168613} {:answer/id #uuid "76624ec5-45cd-5b6f-a504-2ff12623de24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186168614}] :answer-field/id #uuid "2431be4b-89af-5247-a309-422a67c531ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168609}] :question/id #uuid "8379be09-e532-538d-bf76-16e36177bb9c" :question/math-academy-id "q-123890" :question/problem "Which of the following regions are simply connected?\n\n1. ${(x, y) ∈ R^{2} \\mid x^{2} + y^{2} \\le 1}$\n2. ${(x, y) ∈ R^{2} \\mid (x, y) \\ne (1, 1)}$\n3. ${(x, y) ∈ R^{2} \\mid 2x - y \\ne 0}$"}] [{:db/id #edb/ref 17592186259578 :