#{[{:activity/first-step {:db/id #edb/ref 17592186172912} :activity/id #uuid "39f4cc17-5f7c-50ed-be96-16f8865ff40e" :activity/scope {:db/id #edb/ref 17592186050189 :topic/id #uuid "34f05255-901a-5db2-9431-e0175ef37691" :topic/math-academy-id 3357} :activity/steps [{:db/id #edb/ref 17592186172912 :step/content {:db/id #edb/ref 17592186173164 :tutorial/content "A region $D$ is **connected** if every pair of points in $D$ can be joined by a smooth curve or a path that lies entirely in $D.$\n\nThe region below is connected because a smooth path can join any two points.\n\n![](images/90/90fea89e0dabec960edf7eef3552e10cdbccaee80f9ef6ca3d5b2a5b457e6b89.png)\n\nThe region below is not connected. If we take two points $P$ and $Q,$ one in each subregion, we cannot find a path joining these points that lies entirely in the region.\n\n![](images/08/08cd555c38106ec22f2ffe4808a6b62e8f72ffda7baf953836beeca5ee6a1faf.png)" :tutorial/id #uuid "cc905518-dd4e-5791-9cf9-5655233a30a1" :tutorial/math-academy-id 5105 :tutorial/title "Introduction"} :step/id #uuid "201490fd-cd86-52ab-9247-93c541739d39" :step/math-academy-id 32029 :step/next {:db/id #edb/ref 17592186172922}} {:db/id #edb/ref 17592186172922 :step/content {:db/id #edb/ref 17592186172050 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171856 :question/id #uuid "8cbffe56-0a93-59c5-9ea8-c4040e07bb03" :question/math-academy-id "e-8682"} :knowledge-point/id #uuid "d15f8fa8-f265-50da-b172-3ccb90895448" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048655}] :knowledge-point/questions [{:db/id #edb/ref 17592186172666} {:db/id #edb/ref 17592186172667} {:db/id #edb/ref 17592186259573} {:db/id #edb/ref 17592186362296} {:db/id #edb/ref 17592186395514}] :knowledge-point/title "Identifying Connected Regions"} :step/id #uuid "c68b13ae-8c87-5be9-86e9-3707d272d31a" :step/math-academy-id 32247 :step/next {:db/id #edb/ref 17592186172968}} {:db/id #edb/ref 17592186172923 :step/content {:db/id #edb/ref 17592186172051 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171857 :question/id #uuid "053b6396-341c-5b1f-a942-ca1fbf6efa7a" :question/math-academy-id "e-8684"} :knowledge-point/id #uuid "d1af47ea-6253-5d58-9b94-31e52de27106" :knowledge-point/questions [{:db/id #edb/ref 17592186172668} {:db/id #edb/ref 17592186172669} {:db/id #edb/ref 17592186259574} {:db/id #edb/ref 17592186362309} {:db/id #edb/ref 17592186362310}] :knowledge-point/title "Identifying Simply-Connected Regions"} :step/id #uuid "6f9dde17-161c-5a88-8c63-6a5f3ee9022f" :step/math-academy-id 32249 :step/next {:db/id #edb/ref 17592186173000}} {:db/id #edb/ref 17592186172968 :step/content {:db/id #edb/ref 17592186173189 :tutorial/content "A connected region $D$ is **simply connected** if every simple closed curve in $D$ can be contracted to a point.\n\n![](images/7d/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nWhen we have a connected *plane* region (e.g. a region in the $xy$-plane), determining whether it's simply connected is a little simpler: we just need to check whether the region contains holes. \n\nPlane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](images/c3/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nSo, if a connected plane region does not contain any holes, then it is simply connected.\n\nMore precisely, a connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$" :tutorial/id #uuid "a2c2be37-32a5-5b2c-8386-ef9e32684998" :tutorial/math-academy-id 5574 :tutorial/title "Simply-Connected Regions"} :step/id #uuid "bbce5649-95d6-5507-989b-451ad6e19fa2" :step/math-academy-id 34472 :step/next {:db/id #edb/ref 17592186172923}} {:db/id #edb/ref 17592186173000 :step/content {:db/id #edb/ref 17592186172091 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171897 :question/id #uuid "fb87998f-3236-510b-94aa-7db80487d8c9" :question/math-academy-id "e-9498"} :knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048942}] :knowledge-point/questions [{:db/id #edb/ref 17592186172291} {:db/id #edb/ref 17592186172292} {:db/id #edb/ref 17592186259575} {:db/id #edb/ref 17592186259578} {:db/id #edb/ref 17592186259579} {:db/id #edb/ref 17592186259730} {:db/id #edb/ref 17592186259731}] :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"} :step/id #uuid "b521866b-f579-55ce-87fd-6140979c0866" :step/math-academy-id 35576}] :activity/title "Connected and Simply-Connected Regions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172179}]}
