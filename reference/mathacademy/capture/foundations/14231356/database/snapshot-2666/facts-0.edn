64e3c65ff79" #edb/ref 17592186045417] [17592186277688 #edb/ref 1080 "\\frac{19}{2}" #edb/ref 17592186045417] [17592186277688 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186277688 #edb/ref 1083 #uuid "fc0432a2-2750-536b-b704-504d143f0258" #edb/ref 17592186045417] [17592186277739 #edb/ref 1075 #edb/ref 17592186275973 #edb/ref 17592186045417] [17592186277739 #edb/ref 1075 #edb/ref 17592186276076 #edb/ref 17592186045417] [17592186277739 #edb/ref 1075 #edb/ref 17592186276497 #edb/ref 17592186045417] [17592186277739 #edb/ref 1075 #edb/ref 17592186277508 #edb/ref 17592186045417] [17592186277739 #edb/ref 1075 #edb/ref 17592186277597 #edb/ref 17592186045417] [17592186277739 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186277739 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186277739 #edb/ref 1078 #edb/ref 17592186277597 #edb/ref 17592186045417] [17592186277739 #edb/ref 1079 #uuid "066e7a1a-27a5-5cdc-96a1-c8fdeb17fa35" #edb/ref 17592186045417] [17592186277790 #edb/ref 1075 #edb/ref 17592186275567 #edb/ref 17592186045417] [17592186277790 #edb/ref 1075 #edb/ref 17592186275613 #edb/ref 17592186045417] [17592186277790 #edb/ref 1075 #edb/ref 17592186276698 #edb/ref 17592186045417] [17592186277790 #edb/ref 1075 #edb/ref 17592186277163 #edb/ref 17592186045417] [17592186277790 #edb/ref 1075 #edb/ref 17592186277225 #edb/ref 17592186045417] [17592186277790 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186277790 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186277790 #edb/ref 1078 #edb/ref 17592186277163 #edb/ref 17592186045417] [17592186277790 #edb/ref 1079 #uuid "27dcffb3-d41f-5092-b14f-f7e45e7ff8ae" #edb/ref 17592186045417] [17592186277952 #edb/ref 1075 #edb/ref 17592186275550 #edb/ref 17592186045417] [17592186277952 #edb/ref 1075 #edb/ref 17592186276408 #edb/ref 17592186045417] [17592186277952 #edb/ref 1075 #edb/ref 17592186276901 #edb/ref 17592186045417] [17592186277952 #edb/ref 1075 #edb/ref 17592186276905 #edb/ref 17592186045417] [17592186277952 #edb/ref 1075 #edb/ref 17592186277688 #edb/ref 17592186045417] [17592186277952 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186277952 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186277952 #edb/ref 1078 #edb/ref 17592186275550 #edb/ref 17592186045417] [17592186277952 #edb/ref 1079 #uuid "81ca88ac-5791-5a5f-ab97-ee64c4045346" #edb/ref 17592186045417] [17592186278559 #edb/ref 1068 #edb/ref 17592186277739 #edb/ref 17592186045417] [17592186278559 #edb/ref 1069 "q-161570" #edb/ref 17592186045417] [17592186278559 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278559 #edb/ref 1071 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{{y}^{2}+{z}^{2}}}4x\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,0\\le z\\le y}.\n$$" #edb/ref 17592186045417] [17592186278559 #edb/ref 1072 #uuid "0286c07f-b1b2-5473-afd1-f9920e12c0a5" #edb/ref 17592186045417] [17592186278559 #edb/ref 1074 "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{{y}^{2}+{z}^{2}}}4x\\,\\text{d}x]\\text{d}A & ={∬}_{D}2[{x}^{2}]_{x=0}^{x=\\sqrt{{y}^{2}+{z}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}2({(\\sqrt{{y}^{2}+{z}^{2}})}^{2}-0)\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{2}+2{z}^{2}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2{y}^{2}+2{z}^{2}\\,\\text{d}A & ={\\int }_{0}^{3}{\\int }_{0}^{y}2{y}^{2}+2{z}^{2}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}{[2{y}^{2}z+\\frac{2}{3}{z}^{3}]}_{z=0}^{z=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}2{y}^{3}+\\frac{2}{3}{y}^{3}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}\\frac{8}{3}{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{4}]}_{y=0}^{y=3} \\\\  & =\\frac{2}{3}(81-0) \\\\  & =54\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278560 #edb/ref 1068 #edb/ref 17592186277790 #edb/ref 17592186045417] [17592186278560 #edb/ref 1069 "q-161571" #edb/ref 17592186045417] [17592186278560 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278560 #edb/ref 1071 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{2z}}\\frac{x}{2}\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,1\\le y\\le 3,\\,y\\le z\\le y+1}.\n$$" #edb/ref 17592186045417] [17592186278560 #edb/ref 1072 #uuid "4d010482-1691-5f93-8b77-314a6b05233e" #edb/ref 17592186045417] [17592186278560 #edb/ref 1074 "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{2z}}\\frac{x}{2}\\,\\text{d}x]\\text{d}A & ={∬}_{D}\\frac{1}{4}[{x}^{2}]_{x=0}^{x=\\sqrt{2z}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{4}(2z-0)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{2}z\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{2}z\\,\\text{d}A & ={\\int }_{1}^{3}{\\int }_{y}^{y+1}\\frac{1}{2}z\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}[{z}^{2}]_{z=y}^{z=y+1}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}((y+1)^{2}-{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}(2y+1)\\,\\text{d}y \\\\  & =\\frac{1}{4}{[{y}^{2}+y]}_{y=1}^{y=3} \\\\  & =\\frac{1}{4}(9+3)-\\frac{1}{4}(1+1) \\\\  & =\\frac{5}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278564 #edb/ref 1068 #edb/ref 17592186277952 #edb/ref 17592186045417] [17592186278564 #edb/ref 1069 "q-161581" #edb/ref 17592186045417] [17592186278564 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278564 #edb/ref 1071 "Evaluate the triple integral \n\n$$\n{∭}_{R}y\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le y+z+2},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the $z$-axis and the line $z=2-y$ in the first quadrant." #edb/ref 17592186045417] [17592186278564 #edb/ref 1072 #uuid "66331791-83b0-58ae-948f-5ef4e17dacab" #edb/ref 17592186045417] [17592186278564 #edb/ref 1074 "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}y\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{y+z+2}y\\,dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{y+z+2}y\\,dx]dA & ={∬}_{D}y[x]_{x=0}^{x=y+z+2}\\,dA \\\\  & ={∬}_{D}y(y+z+2)\\,dA \\\\  & ={∬}_{D}{y}^{2}+yz+2y\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](images/b4/b473cc75dbbd6fa36ba43f6bbdec4a0133164e6fd8bc5f76ff86cec74714a256.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}+yz+2y\\,dA & ={\\int }_{0}^{2}{\\int }_{0}^{2-y}{y}^{2}+yz+2y\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{0}^{2-y}{y}^{2}+yz+2y\\,dz]dy \\\\  & ={\\int }_{0}^{2}{[({y}^{2}+2y)z+\\frac{1}{2}y{z}^{2}]}_{z=0}^{z=2-y}dy \\\\  & ={\\int }_{0}^{2}({y}^{2}+2y)(2-y)+\\frac{1}{2}y(2-y)^{2}\\,dy \\\\  & ={\\int }_{0}^{2}(4y-{y}^{3})+\\frac{1}{2}y(4-4y+{y}^{2})\\,dy \\\\  & ={\\int }_{0}^{2}-\\frac{1}{2}{y}^{3}-2{y}^{2}+6y\\,dy \\\\  & ={[-\\frac{1}{8}{y}^{4}-\\frac{2}{3}{y}^{3}+3{y}^{2}]}_{y=0}^{y=2} \\\\  & =-2-\\frac{16}{3}+12 \\\\  & =\\frac{14}{3}\\end{aligned}\n$$" #edb/ref 17592186045417]}
