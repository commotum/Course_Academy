#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186158351} :activity/id #uuid "980e0bea-1189-578f-9781-512b76215027" :activity/scope {:db/id #edb/ref 17592186048859 :topic/id #uuid "c6e63ba3-f17e-5d7d-8b1e-f7ca5b0feff7" :topic/math-academy-id 2824} :activity/steps [{:db/id #edb/ref 17592186158351 :step/content {:db/id #edb/ref 17592186158568 :tutorial/content "We've seen how to calculate the total derivative of a function $f: \\mathbb R^n \\to \\mathbb R.$ In this lesson, we will learn how to calculate its second derivative.\n\nFor a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n\n![](images/44/44a95860d7e7bd926f4d94c2ebb5b037e8537ac622f7c86b500aa06b9f959250.svg)\n\nthe total derivative of $f$ is given by the matrix\n\n![](images/e0/e0c9f72b67a531f992342e9f9e0b74f447de5e2b62c9fd81f08804096a912e67.svg)\n\nTo differentiate $f$ once more, we first need to take the transpose of the first derivative:\n\n![](images/4d/4d23282171c39149eeebd7301550ebdf1727b86736a57de6e5d7b6ea96891157.svg)\n\nTo calculate the **second derivative** of $f,$ we simply apply the definition of the total derivative to $\\left(\\boldsymbol f'(\\mathbf x)\\right)^T.$ By doing this, we get the following $n\\times n$ matrix:\n\n![](images/3d/3d62db0c4018fcce47077285aa05e6c4ea3c79e972ab87fccf5165a07083eda9.svg)\n\nNotice that this matrix is *symmetric* due to the equality of mixed partial derivatives. This becomes important later. \n\nThe matrix $\\boldsymbol{f}''(\\mathbf x)$ is sometimes called the **Hessian matrix,** and its determinant, \n\n$$\nH(\\mathbf x) = \\det\\big( \\boldsymbol{f}''(\\mathbf x) \\big)\n$$\n\nis called the **Hessian determinant**.\n\nNote that in the case of a two-variable function $f(x,y),$ the second derivative is given by\n\n![](images/e8/e83195902ce2cdc2e0ff6c1f51ebc679a4bddd51fedd38c4bc6fddc4c73373dd.svg)\n\nIn this lesson, we'll primarily focus on two-variable functions $f(x,y).$ However, we should remember that the techniques discussed here can be applied to scalar functions with an arbitrary number of variables." :tutorial/id #uuid "79cc27de-f461-55d9-ab0f-3dd5a21dd4f4" :tutorial/math-academy-id 7795 :tutorial/title "Introduction"} :step/id #uuid "bac39a49-196c-50bd-99ec-d3c5b74be977" :step/math-academy-id 45105 :step/next {:db/id #edb/ref 17592186158352}} {:db/id #edb/ref 17592186158352 :step/content {:db/id #edb/ref 17592186157423 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157000 :question/id #uuid "332b1d25-852f-51ad-9a38-62b562ae247f" :question/math-academy-id "e-12522"} :knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048781} {:db/id #edb/ref 17592186049696} {:db/id #edb/ref 17592186049962} {:db/id #edb/ref 17592186050021}] :knowledge-point/questions [{:db/id #edb/ref 17592186157540} {:db/id #edb/ref 17592186157791} {:db/id #edb/ref 17592186284388} {:db/id #edb/ref 17592186351224} {:db/id #edb/ref 17592186389421} {:db/id #edb/ref 17592186394112} {:db/id #edb/ref 17592186430444} {:db/id #edb/ref 17592186430447}] :knowledge-point/title "Finding the Second Derivative of a Function Given Its First Derivative"} :step/id #uuid "bdf28805-f615-5f91-bade-c3cb7038cfd2" :step/math-academy-id 45106 :step/next {:db/id #edb/ref 17592186158354}} {:db/id #edb/ref 17592186158353 :step/content {:db/id #edb/ref 17592186157424 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157001 :question/id #uuid "53ca572c-798a-5529-9702-df3291a2b500" :question/math-academy-id "e-12523"} :knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049044}] :knowledge-point/questions [{:db/id #edb/ref 17592186157792} {:db/id #edb/ref 17592186157793} {:db/id #edb/ref 17592186235547} {:db/id #edb/ref 17592186237927} {:db/id #edb/ref 17592186284389} {:db/id #edb/ref 17592186284390} {:db/id #edb/ref 17592186284391} {:db/id #edb/ref 17592186351196} {:db/id #edb/ref 17592186430448}] :knowledge-point/title "Evaluating a Hessian Determinant"} :step/id #uuid "e732cfd5-6c10-55ef-b698-a932a1d233c3" :step/math-academy-id 45109} {:db/id #edb/ref 17592186158354 :step/content {:db/id #edb/ref 17592186157425 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157002 :question/id #uuid "235325ea-4a42-5f63-974a-edd459a4a771" :question/math-academy-id "e-12524"} :knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92" :knowledge-point/questions [{:db/id #edb/ref 17592186157541} {:db/id #edb/ref 17592186157790} {:db/id #edb/ref 17592186351225} {:db/id #edb/ref 17592186351229} {:db/id #edb/ref 17592186351230} {:db/id #edb/ref 17592186394105} {:db/id #edb/ref 17592186430445} {:db/id #edb/ref 17592186430446}] :knowledge-point/title "Finding the Second Derivative of a Function"} :step/id #uuid "8222059e-dad9-55b4-8e1d-ac327c86df18" :step/math-academy-id 45116 :step/next {:db/id #edb/ref 17592186158353}}] :activity/title "The Second Derivative of a Multivariable Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157481}]}
