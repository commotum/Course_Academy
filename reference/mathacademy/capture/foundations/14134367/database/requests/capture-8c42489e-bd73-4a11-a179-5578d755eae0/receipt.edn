4 17592186045417 true] [17592186435391 1077 "selection" 13194139534764 17592186045417 true] [17592186435391 1078 #edb/ref 17592186435385 13194139534764 17592186045417 true] [17592186435391 1079 #uuid "1e2c894b-e18f-5a60-9da4-9f38bca23df7" 13194139534764 17592186045417 true] [17592186435392 1075 #edb/ref 17592186435375 13194139534764 17592186045417 true] [17592186435392 1075 #edb/ref 17592186435377 13194139534764 17592186045417 true] [17592186435392 1075 #edb/ref 17592186435381 13194139534764 17592186045417 true] [17592186435392 1075 #edb/ref 17592186435383 13194139534764 17592186045417 true] [17592186435392 1075 #edb/ref 17592186435387 13194139534764 17592186045417 true] [17592186435392 1076 #edb/ref 17592186045493 13194139534764 17592186045417 true] [17592186435392 1077 "selection" 13194139534764 17592186045417 true] [17592186435392 1078 #edb/ref 17592186435375 13194139534764 17592186045417 true] [17592186435392 1079 #uuid "835cf471-5984-50ad-ac7a-5c92395f40c6" 13194139534764 17592186045417 true] [17592186435393 1068 #edb/ref 17592186435391 13194139534764 17592186045417 true] [17592186435393 1069 "q-81010" 13194139534764 17592186045417 true] [17592186435393 1070 #edb/ref 17592186045485 13194139534764 17592186045417 true] [17592186435393 1071 "Find ${f}^{″}(x,y)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=[\\begin{aligned}y-\\operatorname{cos}⁡x & x+2y\\end{aligned}]$" 13194139534764 17592186045417 true] [17592186435393 1072 #uuid "a68b0724-2e6f-5527-bb88-98de4c797f20" 13194139534764 17592186045417 true] [17592186435393 1074 "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}y-\\operatorname{cos}⁡x & x+2y\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}=y-\\operatorname{cos}⁡x,\\,\\frac{∂f}{∂y}=x+2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y-\\operatorname{cos}⁡x)=\\operatorname{sin}⁡x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x+2y)=1 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y-\\operatorname{cos}⁡x)=1\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x+2y)=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\operatorname{sin}⁡x & 1 \\\\ 1 & 2\\end{aligned}].\\end{aligned}\n$$" 13194139534764 17592186045417 true] [17592186435394 1068 #edb/ref 17592186435390 13194139534764 17592186045417 true] [17592186435394 1069 "q-102452" 13194139534764 17592186045417 true] [17592186435394 1070 #edb/ref 17592186045487 13194139534764 17592186045417 true] [17592186435394 1071 "Find ${f}^{″}(2,1)$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=[\\begin{aligned}-2xy & 2y-{x}^{2}\\end{aligned}]$" 13194139534764 17592186045417 true] [17592186435394 1072 #uuid "d48bb18b-a23a-5640-ba69-c0db05f527bc" 13194139534764 17592186045417 true] [17592186435394 1074 "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}-2xy & 2y-{x}^{2}\\end{aligned}],$ \n we must have\n\n$$\n\\frac{∂f}{∂x}=-2xy,\\,\\frac{∂f}{∂y}=2y-{x}^{2}.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-2xy)=-2y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y-{x}^{2})=-2x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(-2xy)=-2x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y-{x}^{2})=2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}-2y & -2x \\\\ -2x & 2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(2,1).$ This gives\n\n$$\n{f}^{″}(2,1)=[\\begin{aligned}-2 & -4 \\\\ -4 & 2\\end{aligned}].\n$$" 13194139534764 17592186045417 true] [17592186435395 1068 #edb/ref 17592186435392 13194139534764 17592186045417 true] [17592186435395 1069 "q-102686" 13194139534764 17592186045417 true] [17592186435395 1070 #edb/ref 17592186045487 13194139534764 17592186045417 true] [17592186435395 1071 "Given that \n${f}^{′}(x,y)=[\\begin{aligned}2x{y}^{2} & 2y{x}^{2}-1\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,-1).$" 13194139534764 17592186045417 true] [17592186435395 1072 #uuid "e525b492-a29a-585f-8c96-2055a51f2341" 13194139534764 17592186045417 true] [17592186435395 1074 "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}2x{y}^{2} & 2y{x}^{2}-1\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}=2x{y}^{2},\\,\\frac{∂f}{∂y}=2y{x}^{2}-1.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{x}^{2}-1)=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{x}^{2}-1)=2{x}^{2}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2{x}^{2}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,-1)=[\\begin{aligned}2 & -4 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,-1)=2\\cdot 2-(-4)\\cdot (-4)=-12.\n$$" 13194139534764 17592186045417 true]] :edb/tempids {"answer-012e