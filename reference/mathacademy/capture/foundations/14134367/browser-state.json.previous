><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi></mrow></msup></mtd><mtd><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi></mrow></msup><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mi>y</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi></mrow></msup><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mi>y</mi><mo stretchy=\"false\">)</mo></mtd><mtd><msup><mi>x</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi></mrow></msup></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container>"
