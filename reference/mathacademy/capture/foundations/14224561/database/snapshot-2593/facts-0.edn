3 #edb/ref 17592186045417] [17592186278129 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278129 #edb/ref 1078 #edb/ref 17592186276907 #edb/ref 17592186045417] [17592186278129 #edb/ref 1079 #uuid "e799dfb7-bba2-57d2-9a73-5392e0c83466" #edb/ref 17592186045417] [17592186278161 #edb/ref 1075 #edb/ref 17592186275713 #edb/ref 17592186045417] [17592186278161 #edb/ref 1075 #edb/ref 17592186275909 #edb/ref 17592186045417] [17592186278161 #edb/ref 1075 #edb/ref 17592186276086 #edb/ref 17592186045417] [17592186278161 #edb/ref 1075 #edb/ref 17592186276094 #edb/ref 17592186045417] [17592186278161 #edb/ref 1075 #edb/ref 17592186276811 #edb/ref 17592186045417] [17592186278161 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278161 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278161 #edb/ref 1078 #edb/ref 17592186276811 #edb/ref 17592186045417] [17592186278161 #edb/ref 1079 #uuid "f81d9840-6037-5557-81d1-599235b0ea5a" #edb/ref 17592186045417] [17592186278446 #edb/ref 1068 #edb/ref 17592186278018 #edb/ref 17592186045417] [17592186278446 #edb/ref 1069 "q-161249" #edb/ref 17592186045417] [17592186278446 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278446 #edb/ref 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨2x,\\,2y,\\,z⟩,\\,r(u,v)=⟨{u}^{2},\\,-uv,\\,{v}^{2}⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{v}^{2},\\,-4uv,\\,-2{u}^{2}⟩.$*" #edb/ref 17592186045417] [17592186278446 #edb/ref 1072 #uuid "a99addda-c910-54da-a8cb-ae3a5ce916a4" #edb/ref 17592186045417] [17592186278446 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{v}^{2},\\,-4uv,\\,-2{u}^{2}⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨2x,\\,2y,\\,z⟩{|}_{x={u}^{2}\\,y=-uv\\,z={v}^{2}} \\\\  & =⟨2{u}^{2},\\,-2uv,\\,{v}^{2}⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨2{u}^{2},\\,-2uv,\\,{v}^{2}⟩\\cdot ⟨-2{v}^{2},\\,-4uv,\\,-2{u}^{2}⟩ \\\\  & =2{u}^{2}\\cdot (-2{v}^{2})+(-2uv)\\cdot (-4uv)+{v}^{2}\\cdot (-2{u}^{2}) \\\\  & =-4{u}^{2}{v}^{2}+8{u}^{2}{v}^{2}-2{u}^{2}{v}^{2} \\\\  & =2{u}^{2}{v}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,2{u}^{2}{v}^{2}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278450 #edb/ref 1068 #edb/ref 17592186277781 #edb/ref 17592186045417] [17592186278450 #edb/ref 1069 "q-161263" #edb/ref 17592186045417] [17592186278450 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186278450 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨3,\\,z,\\,y⟩\\cdot \\text{d}S\n$$\n\nwhere the parametric surface $S$ is defined by the equations\n\n$$\nr(u,v)=⟨{u}^{2},\\,v,\\,uv⟩\n$$\n\nfor $-1\\le u\\le 1$ and $0\\le v\\le 1.$" #edb/ref 17592186045417] [17592186278450 #edb/ref 1072 #uuid "c5de597f-04b0-56f5-aa9e-d79ce26e7706" #edb/ref 17592186045417] [17592186278450 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}({u}^{2}),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(uv)⟩ \\\\  & =⟨2u,\\,0,\\,v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(uv)⟩ \\\\  & =⟨0,\\,1,\\,u⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 2u & 0 & v \\\\ 0 & 1 & u\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & v \\\\ 1 & 0\\end{aligned}|,-|\\begin{aligned}2u & v \\\\ 0 & u\\end{aligned}|,|\\begin{aligned}2u & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-v,\\,-2{u}^{2},\\,2u⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & ={⟨3,\\,z,\\,y⟩|}_{x={u}^{2}\\,y=v\\,z=uv} \\\\  & =⟨3,\\,uv,\\,v⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3,\\,uv,\\,v⟩\\cdot ⟨-v,\\,-2{u}^{2},\\,2u⟩ \\\\  & =3\\cdot (-v)+uv\\cdot (-2{u}^{2})+v\\cdot 2u \\\\  & =-3v-2{u}^{3}v+2uv\\end{aligned}\n$$\n\nTherefore, the surface integral evaluates to\n\n$$\n\\begin{aligned}{∬}_{S}⟨3,\\,z,\\,y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-3v-2{u}^{3}v+2uv)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}(-3v-2{u}^{3}v+2uv)\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{0}^{1}{[-3uv-\\frac{1}{2}{u}^{4}v+{u}^{2}v]}_{u=-1}^{u=1}\\,\\text{d}v \\\\  & ={\\int }_{0}^{1}(-6v)\\text{d}v \\\\  & =[-3{v}^{2}]_{0}^{1} \\\\  & =-3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278459 #edb/ref 1068 #edb/ref 17592186278070 #edb/ref 17592186045417] [17592186278459 #edb/ref 1069 "q-161278" #edb/ref 17592186045417] [17592186278459 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186278459 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨-x-z,\\,x-y,\\,-z⟩\\cdot \\text{d}S\n$$\n\nwhere the parametric surface $S$ is defined by the equations\n\n$$\nr(u,v)=⟨u+v,\\,v-u,\\,-v⟩\n$$\n\nfor $-1\\le u\\le 0$ and $0\\le v\\le 1.$" #edb/ref 17592186045417] [17592186278459 #edb/ref 1072 #uuid "5f5f7b83-0f5c-511f-9e98-a4ae85732cc3" #edb/ref 17592186045417] [17592186278459 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u+v),\\,\\frac{∂}{∂u}(v-u),\\,\\frac{∂}{∂u}(-v)⟩ \\\\  & =⟨1,\\,-1,\\,0⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u+v),\\,\\frac{∂}{∂v}(v-u),\\,\\frac{∂}{∂v}(-v)⟩ \\\\  & =⟨1,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & 0 \\\\ 1 & 1 & -1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}-1 & 0 \\\\ 1 & -1\\end{aligned}|,-|\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}|,|\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}|⟩ \\\\  & =⟨1,\\,1,\\,2⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & ={⟨-x-z,\\,x-y,\\,-z⟩|}_{x=u+v\\,y=v-u\\,z=-v} \\\\  & =⟨-(u+v)-(-v),\\,u+v-(v-u),\\,-(-v)⟩ \\\\  & =⟨-u,\\,2u,\\,v⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨-u,\\,2u,\\,v⟩\\cdot ⟨1,\\,1,\\,2⟩ \\\\  & =(-u)\\cdot 1+2u\\cdot 1+v\\cdot 2 \\\\  & =-u+2u+2v \\\\  & =u+2v\\end{aligned}\n$$\n\nTherefore, the surface integral evaluates to\n\n$$\n\\begin{aligned}{∬}_{S}⟨-x-z,\\,x-y,\\,-z⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(u+2v)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}(u+2v)\\,\\text{d}v\\,\\text{d}u \\\\  & ={\\int }_{-1}^{0}[uv+{v}^{2}]_{v=0}^{v=1}\\,\\text{d}u \\\\  & ={\\int }_{-1}^{0}(u+1)\\text{d}u \\\\  & ={[\\frac{1}{2}{u}^{2}+u]}_{-1}^{0} \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278470 #edb/ref 1068 #edb/ref 17592186278129 #edb/ref 17592186045417] [17592186278470 #edb/ref 1069 "q-161303" #edb/ref 17592186045417] [17592186278470 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278470 #edb/ref 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨1,\\,0,\\,2⟩,\\,r(u,v)=⟨u+v,\\,{u}^{2}+2v,\\,{u}^{3}+3v⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}a{u}^{2}+bu+c\\,\\text{d}A\n$$\n\nwhat is the value of $a+b+c?$" #edb/ref 17592186045417] [17592186278470 #edb/ref 1072 #uuid "a2d1066e-0b79-5532-9ae3-4e710fbc5bc4" #edb/ref 17592186045417] [17592186278470 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u+v),\\,\\frac{∂}{∂u}({u}^{2}+2v),\\,\\frac{∂}{∂u}({u}^{3}+3v)⟩ \\\\  & =⟨1,\\,2u,\\,3{u}^{2}⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u+v),\\,\\frac{∂}{∂v}({u}^{2}+2v),\\,\\frac{∂}{∂v}({u}^{3}+3v)⟩ \\\\  & =⟨1,\\,2,\\,3⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 2u & 3{u}^{2} \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =⟨|\\begin{aligned}2u & 3{u}^{2} \\\\ 2 & 3\\end{aligned}|,\\,-|\\begin{aligned}1 & 3{u}^{2} \\\\ 1 & 3\\end{aligned}|,\\,|\\begin{aligned}1 & 2u \\\\ 1 & 2\\end{aligned}|⟩ \\\\  & =⟨6u-6{u}^{2},\\,3{u}^{2}-3,\\,2-2u⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨1,\\,0,\\,2⟩{|}_{x=u+v\\,y={u}^{2}+2v\\,z={u}^{3}+3v} \\\\  & =⟨1,\\,0,\\,2⟩.\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨1,\\,0,\\,2⟩\\cdot ⟨6u-6{u}^{2},\\,3{u}^{2}-3,\\,2-2u⟩ \\\\  & =1\\cdot (6u-6{u}^{2})+0\\cdot (3{u}^{2}-3)+2\\cdot (2-2u) \\\\  & =6u-6{u}^{2}+4-4u \\\\  & =-6{u}^{2}+2u+4.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-6)\\cdot {u}^{2}+2\\cdot u+4\\,\\text{d}A.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-6+2+4=0.\n$$" #edb/ref 17592186045417] [17592186278507 #edb/ref 1068 #edb/ref 17592186277771 #edb/ref 17592186045417] [17592186278507 #edb/ref 1069 "q-161384" #edb/ref 17592186045417] [17592186278507 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278507 #edb/ref 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨{z}^{2},\\,{y}^{2},\\,x⟩,\\,r(u,v)=⟨{u}^{2},\\,v,\\,u⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-1,\\,0,\\,2u⟩.$*" #edb/ref 17592186045417] [17592186278507 #edb/ref 1072 #uuid "92e0422d-8551-525d-a92c-4ab1ea25fb60" #edb/ref 17592186045417] [17592186278507 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-1,\\,0,\\,2u⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨{z}^{2},\\,{y}^{2},\\,x⟩{|}_{x={u}^{2}\\,y=v\\,z=u} \\\\  & =⟨{u}^{2},\\,{v}^{2},\\,{u}^{2}⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨{u}^{2},\\,{v}^{2},\\,{u}^{2}⟩\\cdot ⟨-1,\\,0,\\,2u⟩ \\\\  & ={u}^{2}\\cdot (-1)+{v}^{2}\\cdot 0+{u}^{2}\\cdot 2u \\\\  & =2{u}^{3}-{u}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,2{u}^{3}-{u}^{2}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186398507 #edb/ref 1068 #edb/ref 17592186398508 #edb/ref 17592186045417] [17592186398507 #edb/ref 1069 "q-161251" #edb/ref 17592186045417] [17592186398507 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186398507 #edb/ref 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨3x,\\,3y,\\,z⟩,\\,r(u,v)=⟨u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v,\\,{u}^{2}⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩.$*" #edb/ref 17592186045417] [17592186398507 #edb/ref 1072 #uuid "50f21d4c-115f-5f6b-a6fe-50fa77f7169e" #edb/ref 17592186045417] [17592186398507 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨3x,\\,3y,\\,z⟩{|}_{x=u\\operatorname{cos}⁡v\\,y=u\\operatorname{sin}⁡v\\,z={u}^{2}} \\\\  & =⟨3u\\operatorname{cos}⁡v,\\,3u\\operatorname{sin}⁡v,\\,{u}^{2}⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3u\\operatorname{cos}⁡v,\\,3u\\operatorname{sin}⁡v,\\,{u}^{2}⟩\\cdot ⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩ \\\\  & =3u\\operatorname{cos}⁡v\\cdot (-2{u}^{2}\\operatorname{cos}⁡v)+3u\\operatorname{sin}⁡v\\cdot (-2{u}^{2}\\operatorname{sin}⁡v)+{u}^{2}\\cdot u \\\\  & =-6{u}^{3}({cos}^{2}⁡v+{sin}^{2}⁡v)+{u}^{3} \\\\  & =-5{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,-5{u}^{3}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186398508 #edb/ref 1075 #edb/ref 17592186398509 #edb/ref 17592186045417] [17592186398508 #edb/ref 1075 #edb/ref 17592186398510 #edb/ref 17592186045417] [17592186398508 #edb/ref 1075 #edb/ref 17592186398511 #edb/ref 17592186045417] [17592186398508 #edb/ref 1075 #edb/ref 17592186398512 #edb/ref 17592186045417] [17592186398508 #edb/ref 1075 #edb/ref 17592186398513 #edb/ref 17592186045417] [17592186398508 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186398508 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186398508 #edb/ref 1078 #edb/ref 17592186398512 #edb/ref 17592186045417] [17592186398508 #edb/ref 1079 #uuid "f48bed04-e645-581d-90b2-d43b8caed324" #edb/ref 17592186045417] [17592186398509 #edb/ref 1080 "6{u}^{3}" #edb/ref 17592186045417] [17592186398509 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398509 #edb/ref 1083 #uuid "4d89472a-c8a6-58ee-ad06-702bb85242bc" #edb/ref 17592186045417] [17592186398510 #edb/ref 1080 "{u}^{3}\\operatorname{sin}⁡v\\operatorname{cos}⁡v" #edb/ref 17592186045417] [17592186398510 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398510 #edb/ref 1083 #uuid "6ceed292-fdb3-5c81-a5ef-e21d4577bafc" #edb/ref 17592186045417] [17592186398511 #edb/ref 1080 "2{u}^{2}\\operatorname{sin}⁡v\\operatorname{cos}⁡v" #edb/ref 17592186045417] [17592186398511 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398511 #edb/ref 1083 #uuid "2e773ddf-4b3c-5bc1-b538-c1702b36529f" #edb/ref 17592186045417] [17592186398512 #edb/ref 1080 "-5{u}^{3}" #edb/ref 17592186045417] [17592186398512 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398512 #edb/ref 1083 #uuid "06d6268a-1fe9-5430-934f-527eb0153af9" #edb/ref 17592186045417] [17592186398513 #edb/ref 1080 "-3{u}^{2}" #edb/ref 17592186045417] [17592186398513 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 1759218604