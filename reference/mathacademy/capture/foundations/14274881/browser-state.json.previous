      "source_url": "https://mathacademy.com/tasks/14274881/topics/3232/lesson",
      "captured_at": 1792221896.4469817,
      "math_academy_id": "q-331890",
      "topic_id": "3232",
      "sequence_position": null,
      "source_step": {
