      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274881/observations/step-q331948-5a7f8521c8bca17e8117.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274881/observations/step-q331948-5a7f8521c8bca17e8117.png",
      "source_url": "https://mathacademy.com/tasks/14274881/topics/3232/lesson",
      "captured_at": 1792221967.91471,
      "math_academy_id": "q-331948",
      "topic_id": "3232",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q331948",
        "placement_id": null,
        "content_id": null,
        "type": null
