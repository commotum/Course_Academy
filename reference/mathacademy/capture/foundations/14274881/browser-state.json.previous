lspace=\"4pt\" width=\"+8pt\"><mn>2</mn></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>1</mn></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mi>t</mi></mrow></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
