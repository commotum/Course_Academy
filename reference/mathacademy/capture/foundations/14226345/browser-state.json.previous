      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333814-e9e7a53d5b53ce701089.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333814-e9e7a53d5b53ce701089.png",
