      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333832-e2d01be291af1b498430.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333832-e2d01be291af1b498430.png",
      "source_url": "https://mathacademy.com/tasks/14226345/topics/6379/lesson",
      "captured_at": 1792057072.323248,
      "math_academy_id": "q-333832",
