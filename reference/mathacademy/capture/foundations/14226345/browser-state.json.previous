      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333980-b0c4c6e5490bfc0a7823.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333980-b0c4c6e5490bfc0a7823.png",
      "source_url": "https://mathacademy.com/tasks/14226345/topics/6379/lesson",
