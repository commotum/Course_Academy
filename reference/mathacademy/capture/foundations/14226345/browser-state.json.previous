      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333907-9fe79a0c652ab1823c8c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q333907-9fe79a0c652ab1823c8c.png",
