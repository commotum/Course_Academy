      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q334620-09b1bd187b1f57550410.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q334620-09b1bd187b1f57550410.png",
      "source_url": "https://mathacademy.com/tasks/14226345/topics/6379/lesson",
      "captured_at": 1792057217.5315056,
      "math_academy_id": "q-334620",
