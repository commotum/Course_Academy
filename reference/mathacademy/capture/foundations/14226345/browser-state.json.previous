      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q334641-5889e080cd66a96bcb1e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226345/observations/step-q334641-5889e080cd66a96bcb1e.png",
      "source_url": "https://mathacademy.com/tasks/14226345/topics/6379/lesson",
      "captured_at": 1792057159.4427598,
      "math_academy_id": "q-334641",
      "topic_id": "6379",
