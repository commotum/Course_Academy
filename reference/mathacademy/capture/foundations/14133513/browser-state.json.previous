      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133513/observations/step-q81146-809d2e01512d6e420a14.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133513/observations/step-q81146-809d2e01512d6e420a14.png",
      "source_url": "https://mathacademy.com/tasks/14133513/topics/3574/lesson",
