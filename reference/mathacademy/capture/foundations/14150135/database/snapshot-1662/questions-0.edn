 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186357983} {:answer/id #uuid "36a0db23-ac83-59bc-973b-81496b995aca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358235} {:answer/id #uuid "4c82fb7b-68a9-542f-8a72-aecf39118e36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186358415} {:answer/id #uuid "78d426a2-5b18-5538-be7f-d8d7711f2516" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186358797} {:answer/id #uuid "df6d19fb-dc41-5060-a6e5-ee17c97babb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186359714}] :answer-field/correct {:answer/id #uuid "4c82fb7b-68a9-542f-8a72-aecf39118e36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186358415} :answer-field/id #uuid "9653397f-cce0-591e-9443-3d5aacbed087" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360254}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec5fca83-ae3c-5f26-9292-3c61fcf8876c" :question/math-academy-id "q-94615" :question/problem "Consider the vector space ${R}_{4}[t]$ of all polynomials in the variable $t$ of degree at most $4,$ and its subset $B={p(t)\\in {R}_{4}[t]\\,|\\,p(0)=1}.$\n\nWhich of the following statements are true?\n\n- $B$ is closed under polynomial addition\n- $B$ is closed under scalar multiplication\n- $B$ is a subspace of ${R}_{4}[t]$\n- $B$ is **not** a subspace of ${R}_{4}[t]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(0)=g(0)=1,$ then\n\n$$\n\\begin{aligned}f(0)+g(0) & =1+1 \\\\  & =2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(0)=1$ and $k=2,$ then \n\n$$\n\\begin{aligned}kf(0) & =1\\cdot 2=2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186360464 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a3bcb9-87cf-5e9a-a453-b12b6d936c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186357759} {:answer/id #uuid "44258477-180c-53ea-9ca7-2338a1643dcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186358334} {:answer/id #uuid "56da8d21-6470-58b6-8612-c05ed3e6c73e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186358506} {:answer/id #uuid "9e7caca1-2a0b-555a-94b6-8df04eac42e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186359134} {:answer/id #uuid "e9c9dd1d-a17a-54df-a66c-3ac461bac62a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186359831}] :answer-field/correct {:answer/id #uuid "e9c9dd1