#{[{:db/id #edb/ref 17592186176232 :knowledge-point/_questions [{:db/id #edb/ref 17592186175993 :knowledge-point/id #uuid "85ecbb00-cabe-5838-9ac4-50ebc8821c05" :knowledge-point/title "Finding the Number of Generalized Eigenvectors of a Given Rank Using Nullity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9915c4f7-fec8-5821-a1e5-91cb9f24bded" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186375715} {:answer/id #uuid "fbb84d03-63e5-5ac4-bfb3-a8e737d4a931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375716} {:answer/id #uuid "0d440d47-6467-5c2e-935a-ea22542facfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375717} {:answer/id #uuid "c1183feb-ea61-579f-895e-c9fbfacb3ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375718} {:answer/id #uuid "d954d438-acb2-5e8f-94fb-1b1426a9576e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186375719}] :answer-field/correct {:answer/id #uuid "0d440d47-6467-5c2e-935a-ea22542facfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375717} :answer-field/id #uuid "ce26ad16-b594-507c-bab8-79b00e68ef59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2323904-dbe3-5d6e-b9ad-cd7ee2cf8fc9" :question/math-academy-id "q-109121" :question/problem "Suppose that a matrix $A$ has characteristic polynomial $p(\\lambda )=\\lambda (\\lambda -1)(\\lambda -5)^{7},$ the nullity of $(A-5I)^{2}$ equals $1,$ and the nullity of $(A-5I)^{3}$ equals $2.$ If a basis of ${R}^{9}$ consists of linearly independent generalized eigenvectors of $A$, how many of these are generalized eigenvectors of rank $3$ corresponding to the eigenvalue $\\lambda =5?$" :question/worked-solution "For the given matrix $A$ with eigenvalue $\\lambda =5,$ a generalized eigenvector of rank $3$ is a vector $v$ such that \n\n$$\n(A-5I)^{3}v=0\\,\\text{and}\\,(A-5I)^{2}v\\ne 0.\n$$\n\nNotice the following:\n\n- We are given that $\\text{Null}(A-5I)^{2}$ has dimension $1.$ This means that the solutions to $(A-5I)^{2}v=0$ form a subspace of dimension $1.$\n\n- We are given that $\\text{Null}(A-5I)^{3}$ has dimension $2.$ This means that the solutions to $(A-5I)^{3}v=0$ form a subspace of dimension $2.$\n\nNow, since $\\text{Null}(A-5I)^{2}$ is a subspace of dimension $1$ in $\\text{Null}(A-5I)^{3}$, which is a subspace of dimension $2,$ our basis can contain only $1$ vector that lies in $\\text{Null}(A-5I)^{3}$ but does not lie in $\\text{Null}(A-5I)^{2}.$\n\nTherefore, there will be \n\n$$\n\\text{nullity}(A-5I)^{3}-\\text{nullity}(A-5I)^{2}=2-1=1\n$$\n\n generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =5.$"}] [{:db/id #edb/ref 17592186501145 :knowledge-point/_questions [{:db/id #edb/ref 17592186175993 :knowledge-point/id #uuid "85ecbb00-cabe-5838-9ac4-50ebc8821c05" :knowledge-point/title "Finding the Number of Generalized Eigenvectors of a Given Rank Using Nullity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1997f878-2762-56d9-ac49-b26b9ac9edc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186500521} {:answer/id #uuid "379bda0c-41bc-5297-b017-d518173b466b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186500580} {:answer/id #uuid "58f930ba-330b-56ca-943a-67237cb474f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186500648} {:answer/id #uuid "84bfa36c-7054-5b53-81f3-b9e1906d6186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186500742} {:answer/id #uuid "c9c4aa88-43ec-5d07-ae83-df734fe4814c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186500894}] :answer-field/correct {:answer/id #uuid "58f930ba-330b-56ca-943a-67237cb474f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186500648} :answer-field/id #uuid "fc7e5239-25ea-5909-b9ce-6ad812ed18c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18821d40-33b7-5a84-97bc-878b35f96c25" :question/math-academy-id "q-109747" :question/problem "Suppose that a matrix $B$ has characteristic polynomial $p(\\lambda )={\\lambda }^{4}(\\lambda -\\pi )^{5}(\\lambda +3)^{2},$ the nullity of $(B-\\pi I)^{2}$ equals $2,$ and the nullity of $(B-\\pi I)^{3}$ equals $3.$ If a basis of ${R}^{11}$ consists of linearly independent generalized eigenvectors of $B$, how many of these are generalized eigenvectors of rank $3$ corresponding to the eigenvalue $\\lambda =\\pi ?$" :question/worked-solution "For the given matrix $B$ with eigenvalue $\\lambda =\\pi ,$ a generalized eigenvector of rank $3$ is a vector $v$ such that \n\n$$\n(B-\\pi I)^{3}v=0\\,\\text{and}\\,(B-\\pi I)^{2}v\\ne 0.\n$$\n\nNotice the following:\n\n- We are given that $\\text{Null}(B-\\pi I)^{2}$ has dimension $2.$ This means that the solutions to $(B-\\pi I)^{2}v=0$ form a subspace of dimension $2.$\n\n- We are given that $\\text{Null}(B-\\pi I)^{3}$ has dimension $3.$ This means that the solutions to $(B-\\pi I)^{3}v=0$ form a subspace of dimension $3.$\n\nNow, since $\\text{Null}(B-\\pi I)^{2}$ is a subspace of dimension $2$ in $\\text{Null}(B-\\pi I)^{3}$, which is a subspace of dimension $3,$ our basis can contain only $1$ vector that lies in $\\text{Null}(B-\\pi I)^{3}$ but does not lie in $\\text{Null}(B-\\pi I)^{2}.$\n\nTherefore, there will be \n\n$$\n\\text{nullity}(B-\\pi I)^{3}-\\text{nullity}(B-\\pi I)^{2}=3-2=1\n$$\n\n generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =\\pi .$"}] [{:db/id #edb/ref 17592186364434 :knowledge-point/_questions [{:db/id #edb/ref 17592186175946 :knowledge-point/id #uuid "2dbed47b-77e4-53fd-8eb9-17ec13e42a3e" :knowledge-point/title "Finding the Number of Generalized Eigenvectors of a Given Rank"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7df20e00-8b95-5d9c-9ad7-b28badfc60f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186364436} {:answer/id #uuid "95cab23e-3490-5b26-810e-f8f4b6bb69ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186364437} {:answer/id #uuid "9ebef18c-06dd-5776-88b8-f04701e33f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364438} {:answer/id #uuid "25f77071-51f5-53cc-b0f7-f53de32e9e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364439} {:answer/id #uuid "7ee16813-be34-5924-a753-6535fdc0bd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364440}] :answer-field/correct {:answer/id #uuid "7df20e00-8b95-5d9c-9ad7-b28badfc60f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186364436} :answer-field/id #uuid "0d5de73d-f30c-59bc-9085-0f3566bc1afd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364435}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d180b2be-eb75-50b7-9052-2821851f23f8" :question/math-academy-id "q-78494" :question/problem "Suppose that a matrix $A$ has characteristic polynomial $p(\\lambda )=(\\lambda +2)(\\lambda -5)^{19},$ the rank of $(A-5I)^{5}$ equals $12,$ and the rank of $(A-5I)^{6}$ equals $9.$ If a basis of ${R}^{20}$ consists of linearly independent generalized eigenvectors of $A$, how many of these are generalized eigenvectors of rank $6$ corresponding to the eigenvalue $\\lambda =5?$" :question/worked-solution "For the given matrix $A$ with eigenvalue $\\lambda =5,$ a generalized eigenvector of rank $6$ is a vector $v$ such that \n\n$$\n(A-5I)^{6}v=0\\,\\text{and}\\,(A-5I)^{5}v\\ne 0.\n$$\n\nNotice that $A$ must be a $20\\times 20$ matrix.\n\n- Since the rank of $(A-5I)^{5}$ equals $12,$ then by the rank-nullity theorem, we have that\n\n$$\n\\text{nullity}(A-5I)^{5}=20-12=8.\n$$\n\nSo, the solutions to $(A-5I)^{5}v=0$ form a subspace $\\text{Null}(A-5I)^{5}$ of dimension $8$ in ${R}^{20}.$\n\n- Since the rank of $(A-5I)^{6}$ equals $9,$  then by the rank-nullity theorem, we have that\n\n$$\n\\text{nullity}(A-5I)^{6}=20-9=11.\n$$\n\nSo, the solutions to $(A-5I)^{6}v=0$ form a subspace $\\text{Null}(A-5I)^{6}$ of dimension $11$ in ${R}^{20}.$\n\nSince $\\text{Null}(A-2I)^{5}$ is a subspace of dimension $8$ in $\\text{Null}(A-5I)^{6}$, which is a subspace of dimension $11,$ our basis can contain only $3$ vectors that lie in $\\text{Null}(A-5I)^{6}$ but do not lie in $\\text{Null}(A-5I)^{5}.$\n\nTherefore, there will be \n\n$$\n\\text{nullity}(A-5I)^{6}-\\text{nullity}(A-5I)^{5}=11-8=3\n$$\n\n generalized eigenvectors of rank $6$ corresponding to the eigenvalue $\\lambda =5.$"}]}
