2186045498} :answer/value "{e}^{-(s-9)t}" :db/id #edb/ref 17592186368072} {:answer/id #uuid "42388404-5c1c-553a-ad5e-d772fbaedda0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s+9)t}" :db/id #edb/ref 17592186368073} {:answer/id #uuid "27566925-17b0-557c-9087-2becaaac8c26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s+9)t}" :db/id #edb/ref 17592186368074} {:answer/id #uuid "670a204b-dbd0-5762-9954-fc001e5f533d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s-9)t}" :db/id #edb/ref 17592186368075}] :answer-field/correct {:db/id #edb/ref 17592186368072} :answer-field/id #uuid "ec7afe59-29fd-5b24-8255-f5b581a6ba68" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186368071} {:answer-field/choices [{:answer/id #uuid "01a989fc-e8e2-5596-b19b-18c8318b979c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{-9t}q(t)" :db/id #edb/ref 17592186368077} {:answer/id #uuid "e712aa1e-27e0-5c55-b9b9-c4995f8ad8e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{-9t}q(t)" :db/id #edb/ref 17592186368078} {:answer/id #uuid "0b9f5ac0-0ad4-510b-8d06-44e1d96e1da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{9t}q(t)" :db/id #edb/ref 17592186368079} {:answer/id #uuid "2bda30ae-8042-58bd-8658-26b8557e0ed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{9t}q(t)" :db/id #edb/ref 17592186368080}] :answer-field/correct {:db/id #edb/ref 17592186368080} :answer-field/id #uuid "8ff60236-5483-532f-997e-f3321f9ebbbf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186368076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9cd6f01-d8c7-5536-9f5a-869210d50728" :question/math-academy-id "q-331799" :question/problem "Consider a function $q(t)$ such that its Laplace transform is $L\\{q(t)\\}=Q(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{9t}q(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{9t}q(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,q(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{9t}q(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{9t}\\,q(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-9)t}\\,q(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $Q(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,q(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-9)t}\\,q(t)\\,\\text{d}t=Q(s-9),\n$$\n\nwhere \n\n$$\ns-9>{s}_{0}\\,⇒\\,s>{s}_{0}+9.\n$$"} :step/id #uuid "470da428-0379-5a0d-992c-de8783330311" :step/next {:db/id #edb/ref 17592186549150}} {:db/id #edb/ref 17592186549098 :step/content {:db/id #edb/ref 17592186222042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50798ffc-3732-5591-ba0b-04ece45c7da1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{{s}^{3}}+\\frac{3}{(s-3)^{3}}" :db/id #edb/ref 17592186548505} {:answer/id #uuid "5c5f41d3-f5c2-5c17-99da-23a331941594" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{s}^{3}}+\\frac{6}{(s-3)^{4}}" :db/id #edb/ref 17592186548525} {:answer/id #uuid "83c7c20a-5a9a-5e9c-92d4-1db64ddad7aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{s}^{2}}+\\frac{2}{(s-3)^{3}}" :db/id #edb/ref 17592186548607} {:answer/id #uuid "9a625c27-70a6-5cf6-bcf3-a7be0cbcc47f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{{s}^{2}}+\\frac{3}{(s-3)^{2}}" :db/id #edb/ref 17592186548661} {:answer/id #uuid "9fb78983-301f-5651-9fb7-1ab6e18840f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{{s}^{2}}+\\frac{6}{(s-3)^{3}}" :db/id #edb/ref 17592186548667}] :answer-field/correct {:db/id #edb/ref 17592186548667} :answer-field/id #uuid "657c492a-d1c0-573d-a492-e9c1d9f752bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186220936}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "998b7976-7802-594e-8c46-4a5b40b28b4c" :question/math-academy-id "q-64298" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of  $f(t)=5t+3{t}^{2}{e}^{3t}$ for $s>3.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{5t+3{t}^{2}{e}^{3t}\\} \\\\  & =L\\{5t\\}+L\\{3{t}^{2}{e}^{3t}\\} \\\\  & =5L\\{t\\}+3L\\{{t}^{2}{e}^{3t}\\}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L\\{t\\} & =\\frac{1}{{s}^{2}} \\\\ L\\{{t}^{2}\\} & =\\frac{2}{{s}^{3}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L\\{f(t)\\}=F(s),$ then $L\\{{e}^{at}f(t)\\}=F(s-a).$ Therefore,\n\n$$\nL\\{{t}^{2}{e}^{3t}\\}=\\frac{2}{(s-3)^{3}}.\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =5L\\{t\\}+3L\\{{t}^{2}{e}^{3t}\\} \\\\  & =5\\cdot \\frac{1}{{s}^{2}}+3\\cdot \\frac{2}{(s-3)^{3}} \\\\  & =\\frac{5}{{s}^{2}}+\\frac{6}{(s-3)^{3}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>3.$"} :step/id #uuid "517ae331-e78e-5e2c-9909-0a4fabd9ed67" :step/next {:db/id #edb/ref 17592186549104}} {:db/id #edb/ref 17592186549104 :step/content {:db/id #edb/ref 17592186390920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aafd302f-6a35-5d36-98f2-cf4624e295be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{4t}y(t)" :db/id #edb/ref 17592186390922} {:answer/id #uuid "66bf87d7-e6c2-5282-850d-eb9aebd5c3b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{4t}y(t)" :db/id #edb/ref 17592186390923} {:answer/id #uuid "840ad45b-0f89-5529-9777-ad485cc3f205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{-4t}y(t)" :db/id #edb/ref 17592186390924} {:answer/id #uuid "6c39a5b1-75b5-5645-8167-41e89b9c7ea3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{-4t}y(t)" :db/id #edb/ref 17592186390925}] :answer-field/correct {:db/id #edb/ref 17592186390923} :answer-field/id #uuid "8c96bb67-379b-58f3-8bd6-2a12ba02c55d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390921} {:answer-field/choices [{:answer/id #uuid "79a696e3-36c6-5dbb-8054-3e3055fd30c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y(s+4)" :db/id #edb/ref 17592186390927} {:answer/id #uuid "4467ec07-702f-5b21-92b8-2f18a52b2594" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y(s)" :db/id #edb/ref 17592186390928} {:answer/id #uuid "16ae78ce-84c8-5d90-adf4-b4488bc9bc1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y(s-4)" :db/id #edb/ref 17592186390929}] :answer-field/correct {:db/id #edb/ref 17592186390929} :answer-field/id #uuid "8a4081f2-e006-5adb-9730-18555c18e386" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390926} {:answer-field/choices [{:answer/id #uuid "1b0aa3b2-a353-5fad-9f2c-86f80f64a596" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}-4" :db/id #edb/ref 17592186390931} {:answer/id #uuid "70ea0f4e-0f27-54bd-b214-293164546b85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186390932} {:answer/id #uuid "efc8c087-1a40-5a9a-b0e7-6e9a0cfd6c03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}+4" :db/id #edb/ref 17592186390933}] :answer-field/correct {:db/id #edb/ref 17592186390933} :answer-field/id #uuid "3edea668-8171-5b4a-ac6b-95fcbb4e0bc6" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390930} {:answer-field/choices [{:answer/id #uuid "518c7bd4-e0da-52d8-997d-673ca75771ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s+4)t}" :db/id #edb/ref 17592186390935} {:answer/id #uuid "2ff97a43-f336-5953-ad0f-7734328a6b47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s-4)t}" :db/id #edb/ref 17592186390936} {:answer/id #uuid "16f58656-d9ad-55d9-bfbd-701b206d4ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s-4)t}" :db/id #edb/ref 17592186390937} {:answer/id #uuid "91cc341f-4e42-5a66-9854-8c99a495219a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s+4)t}" :db/id #edb/ref 17592186390938}] :answer-field/correct {:db/id #edb/ref 17592186390936} :answer-field/id #uuid "89e9f6b0-7444-50e6-83bb-1ea02dd6ef57" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390934}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "65e33f37-ed72-5eab-bd4d-b7d3ad4f22b8" :question/math-academy-id "q-331791" :question/problem "Consider a function $y(t)$ such that its Laplace transform is $L\\{y(t)\\}=Y(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{4t}y(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{4t}y(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,y(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{4t}y(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{4t}\\,y(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-4)t}\\,y(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $Y(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,y(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-4)t}\\,y(t)\\,\\text{d}t=Y(s-4),\n$$\n\nwhere \n\n$$\ns-4>{s}_{0}\\,⇒\\,s>{s}_{0}+4.\n$$"} :step/id #uuid "5e8902fa-0758-5942-8a51-66f230a0e33d" :step/next {:db/id #edb/ref 17592186549093}} {:db/id #edb/ref 17592186549135 :step/content {:db/id #edb/ref 17592186368081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebfe2578-7c5f-5df7-9d72-39a56be2386e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8d/8daba7e586feeff02624e5d0fb508c9d2adedb23d5a79fe329f83a42e1f8256e.png" :db/id #edb/ref 17592186368083} {:answer/id #uuid "8e2c1dfa-8219-593c-b78b-6240e600685c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/82/82d01729627b5871739120d2e512cf54610eaaf43f6f2f2c454b7e39803937a2.png" :db/id #edb/ref 17592186368084} {:answer/id #uuid "0d7c5a3d-eb7d-5081-ba8b-a26f602f1890" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e6/e6d497165f1dbc9fd9db77e6a8943f6acd45262cb74ebafd4a418d612be884b7.png" :db/id #edb/ref 17592186368085} {:answer/id #uuid "134ca311-f8fb-5d46-8687-e4802cae00a3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a902bac22ba86af8de8b49d5aba5bb34f35433230f303432e1f4327708f41a7d.png" :db/id #edb/ref 17592186368086} {:answer/id #uuid "63430f1f-817b-5c2a-bd77-427ce4f138a1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef457f3f2030bd9399e707ea5bc32f9fe58aae29f848c270c5b971afd98315bd.png" :db/id #edb/ref 17592186368087}] :answer-field/correct {:db/id #edb/ref 17592186368086} :answer-field/id #uuid "84509ec0-1233-5211-bf4c-8b7806b1f61b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368082}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2acfbcc3-d517-5f68-a1bd-d612fba90c87" :question/math-academy-id "q-332104" :question/problem "![](images/82/82d01729627b5871739120d2e512cf54610eaaf43f6f2f2c454b7e39803937a2.png)\n\nConsider a function $f(t)$ for which the graph of the Laplace transform $L\\{f(t)\\}=F(s)$ is shown above. Which of the following could be the graph of $L\\{{e}^{-2t}f(t)\\}?$" :question/worked-solution "The first shifting theorem states that if\n$L\\{f(t)\\}=F(s),$\nthen\n$L\\{{e}^{at}f(t)\\}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L\\{{e}^{-2t}f(t)\\},$ we must shift the graph of $F(s)$ by $2$ units to the left.\n\n![](images/a9/a902bac22ba86af8de8b49d5aba5bb34f35433230f303432e1f4327708f41a7d.png)"} :step/id #uuid "b04bf113-65a4-5948-a558-678fc8e34fe0"} {:db/id #edb/ref 17592186549150 :step/content {:db/id #edb/ref 17592186221947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a2b3a2-2a1c-5657-9a0c-46c3d1d0b071" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $2$ vertically." :db/id #edb/ref 17592186220291} {:answer/id #uuid "c68eb1a4-0e89-5167-8c50-da7595818ba2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $2$ units to the right." :db/id #edb/ref 17592186220292} {:answer/id #uuid "45a5925f-203c-5ff0-ba1d-13bd03e18a2d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $2$ horizontally." :db/id #edb/ref 17592186220293} {:answer/id #uuid "52465464-3cc9-5d3e-be71-9ddda92ffee4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $2$ units to the left." :db/id #edb/ref 17592186220294} {:answer/id #uuid "6b9d9e20-287a-52d4-ae92-343b1c4d6e2c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186220295}] :answer-field/correct {:db/id #edb/ref 17592186220294} :answer-field/id #uuid "87c83dc8-2008-503f-a501-9ad228213d1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186220290}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2fa333ab-b95e-5e37-a5a1-bded577fcc62" :question/math-academy-id "q-332055" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L\\{f(t)\\}=F(s).$ How can we obtain the graph of $L\\{{e}^{-2t}f(t)\\}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L\\{f(t)\\}=F(s),$\nthen\n$L\\{{e}^{at}f(t)\\}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L\\{{e}^{-2t}f(t)\\},$ we must shift the graph of $F(s)$ by $2$ units to the left."} :step/id #uuid "e30ffbbf-6dc6-5d22-8ffd-fc6caa3397ff" :step/next {:db/id #edb/ref 17592186549135}}] :activity/title "The First Shifting Theorem of Laplace Transforms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548349}]}
