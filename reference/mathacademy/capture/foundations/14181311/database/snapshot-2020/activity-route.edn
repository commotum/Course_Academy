#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186497426} :activity/id #uuid "96b6d663-08d7-585e-8073-b5b5fe80dad2" :activity/scope {:db/id #edb/ref 17592186050150 :topic/id #uuid "3185fbd2-cc78-5eb1-ba66-6a65b74ad8a2" :topic/math-academy-id 2547} :activity/steps [{:db/id #edb/ref 17592186497426 :step/content {:db/id #edb/ref 17592186265777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08231897-379f-5465-a685-d58d28a9a029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263074} {:answer/id #uuid "2fdbf991-a81b-541a-86a5-8e9569760048" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186263403} {:answer/id #uuid "894275a3-764c-5ff1-95dd-588429bf5785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186264182} {:answer/id #uuid "90767335-6ee7-503b-aaad-90d180393cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186264241} {:answer/id #uuid "edaad585-b008-5187-9422-f08e3851db74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265076}] :answer-field/correct {:db/id #edb/ref 17592186263074} :answer-field/id #uuid "37094ebd-d0aa-5bec-a937-d45769e3e042" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265344}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "59cfc6f0-d08d-5f61-ba3e-7216ac027397" :question/math-academy-id "q-129797" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=x$ and ${y}_{2}(x)=\\operatorname{sin}⁡x.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nIn our case, we have ${y}_{1}(x)=x$ and ${y}_{2}(x)=\\operatorname{sin}⁡x.$ Therefore\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(x){(\\operatorname{sin}⁡x)}^{′}-(\\operatorname{sin}⁡x){(x)}^{′} \\\\  & =(x)(\\operatorname{cos}⁡x)-(\\operatorname{sin}⁡x)(1) \\\\  & =x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x.\\end{aligned}\n$$"} :step/id #uuid "2155ec54-f705-5c21-80f7-39cc78dc2cd2" :step/next {:db/id #edb/ref 17592186497430}} {:db/id #edb/ref 17592186497430 :step/content {:db/id #edb/ref 17592186497386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466436a8-4af6-538b-9c6f-dc9fef31373c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{3x}-2" :db/id #edb/ref 17592186496811} {:answer/id #uuid "55bfbd25-7cd4-58e5-9f38-dc990ba4a925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{x}" :db/id #edb/ref 17592186496840} {:answer/id #uuid "d0f48d39-9abb-58ad-92f4-b282755cf973" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-2{e}^{3x}" :db/id #edb/ref 17592186497093} {:answer/id #uuid "d8339946-1b5f-5196-bce2-e29dceabf2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{3x}" :db/id #edb/ref 17592186497113} {:answer/id #uuid "f715f065-06d5-5837-ae98-a58247ced1f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{x}-1" :db/id #edb/ref 17592186497187}] :answer-field/correct {:db/id #edb/ref 17592186497113} :answer-field/id #uuid "fcb0452a-b540-5991-8720-5551a36772ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a6522825-4faa-5281-807b-1fb4ff06c302" :question/math-academy-id "q-129799" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=2{e}^{x}$ and ${y}_{2}(x)={e}^{2x}.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nIn our case, we have ${y}_{1}(x)=2{e}^{x}$ and ${y}_{2}(x)={e}^{2x}.$ Therefore\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(2{e}^{x}){({e}^{2x})}^{′}-({e}^{2x}){(2{e}^{x})}^{′} \\\\  & =(2{e}^{x})(2{e}^{2x})-({e}^{2x})(2{e}^{x}) \\\\  & ={4}^{3x}-2{e}^{3x} \\\\  & =2{e}^{3x}.\\end{aligned}\n$$"} :step/id #uuid "32245bef-db4a-5ead-bf54-75deea3e1bbd" :step/next {:db/id #edb/ref 17592186497444}} {:db/id #edb/ref 17592186497434 :step/content {:db/id #edb/ref 17592186308586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcf9011c-88d2-522f-b3b2-7f5e58324603" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466165} {:answer/id #uuid "7c54ae2f-cbec-5b96-bc9f-83b395505baa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466166}] :answer-field/correct {:db/id #edb/ref 17592186466165} :answer-field/id #uuid "3b76786e-84b5-5680-8436-15f590623f91" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466926} {:answer-field/choices [{:answer/id #uuid "e52cab96-26d7-57ef-a7bd-1454284967ff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466167} {:answer/id #uuid "08e922da-3532-5a0c-84aa-77682d68a282" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466168}] :answer-field/correct {:db/id #edb/ref 17592186466168} :answer-field/id #uuid "b1740d26-3686-55da-8705-422b2c2b00b7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466927} {:answer-field/choices [{:answer/id #uuid "1b152814-ca69-5689-a07f-ea7a68ee13fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466169} {:answer/id #uuid "800df2b3-aa45-578a-a674-f96d56bef770" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466170}] :answer-field/correct {:db/id #edb/ref 17592186466169} :answer-field/id #uuid "243b5076-4595-54da-af25-5a1ce4f33b19" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466928}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4674804-88cb-5499-be8a-d4a228b08c3f" :question/math-academy-id "q-334258" :question/problem "$$\n{y}^{″}-2{y}^{′}+5y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n- **I.** ${y}_{1}(x)={e}^{2x}\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- **II.** ${y}_{2}(x)={e}^{x}\\operatorname{sin}⁡(2x)$ is a solution to the equation.\n- **III.** The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & ={e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\ {y}_{1}^{″}(x) & ={e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)-2{e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+5{e}^{2x}\\operatorname{sin}⁡x & =0 \\\\ 2(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x){e}^{2x} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & ={e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x)) \\\\ {y}_{2}^{″}(x) & ={e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))-2{e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x))+5{e}^{x}\\operatorname{sin}⁡(2x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"."} :step/id #uuid "42ed90f3-6e73-597b-a8d4-611af23d26d7" :step/next {:db/id #edb/ref 17592186497485}} {:db/id #edb/ref 17592186497444 :step/content {:db/id #edb/ref 17592186308559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "225a1eff-527f-50a3-a950-0e07356c0c8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "nonzero for at least one $x\\in R$" :db/id #edb/ref 17592186305479} {:answer/id #uuid "88e4ac3e-acf7-5f50-9fef-7c0d6c5127de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "zero for all $x\\in R$" :db/id #edb/ref 17592186306460}] :answer-field/correct {:db/id #edb/ref 17592186306460} :answer-field/id #uuid "164c75dd-1d7b-5483-8626-94f363941660" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186307590} {:answer-field/choices [{:answer/id #uuid "4375f462-ef6a-5d9e-bf5b-d24ce61a1925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186305816} {:answer/id #uuid "6180adb3-8d26-5a19-9ce0-e694e204c090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{x}^{3}" :db/id #edb/ref 17592186306091} {:answer/id #uuid "9f97eab8-1e38-5b7d-963e-d85bc898a662" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}" :db/id #edb/ref 17592186306647} {:answer/id #uuid "d0e467cf-6110-5dc9-a27d-22ab45048e19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x" :db/id #edb/ref 17592186307082}] :answer-field/correct {:db/id #edb/ref 17592186305816} :answer-field/id #uuid "8e38717e-3ffb-5a34-9c57-bc6ca0a2c3bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186307970} {:answer-field/choices [{:answer/id #uuid "129f96e0-7d7f-589c-a331-e0eb85b217cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "independent" :db/id #edb/ref 17592186305314} {:answer/id #uuid "798b8103-db44-5e23-8007-6cac7e843eb0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "dependent" :db/id #edb/ref 17592186306308}] :answer-field/correct {:db/id #edb/ref 17592186306308} :answer-field/id #uuid "b17a5a7a-6c0f-508a-b7cf-5291f1a8c8cc" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186308085}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a272db4-485b-515e-b75d-0755cc7e94a5" :question/math-academy-id "q-334109" :question/problem "$$\n{y}_{1}(x)={x}^{2}+1,\\,{y}_{2}(x)=2+2{x}^{2},\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.\n\n$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  which is \n{{field-2}}.\n\n$\\,$ Therefore, the set $\\{{y}_{1}(x),{y}_{2}(x)\\}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{x}^{2}+1 & 2+2{x}^{2} \\\\ ({x}^{2}+1)^{′} & (2+2{x}^{2})^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2}+1 & 2+2{x}^{2} \\\\ 2x & 4x\\end{aligned}| \\\\  & =({x}^{2}+1)(4x)-(2+2{x}^{2})(2x) \\\\  & =4x({x}^{2}+1)-4x({x}^{2}+1) \\\\  & =0\\end{aligned}\n$$\n\nwhich is $\\text{zero for all }x\\in R.$\n\nTherefore, the set $\\{{y}_{1}(x),{y}_{2}(x)\\}$ is linearly $\\text{dependent}$ on $R.$"} :step/id #uuid "67570e82-1419-5a80-8fbf-4556faa1f82b" :step/next {:db/id #edb/ref 17592186497434}} {:db/id #edb/ref 17592186497485 :step/content {:db/id #edb/ref 17592186308589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b216db04-2d87-5f29-b031-4b8f18aebbe2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466177} {:answer/id #uuid "084e80ea-fab8-56b6-840f-252ff612f881" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466178}] :answer-field/correct {:db/id #edb/ref 17592186466178} :answer-field/id #uuid "1d31f03f-7baf-56e7-b1ac-efd300ef99ba" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466932} {:answer-field/choices [{:answer/id #uuid "ff9dc928-9b30-5b8d-8c18-90d8a6534ab1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466179} {:answer/id #uuid "6eb19be9-60e0-5255-a502-12dbdfe06395" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466180}] :answer-field/correct {:db/id #edb/ref 17592186466180} :answer-field/id #uuid "20d0b221-8cd2-5d31-84e5-81ec105281e0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466933} {:answer-field/choices [{:answer/id #uuid "22e26dd4-c78f-596b-9c14-f45264b02075" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186466181} {:answer/id #uuid "c433f3b3-d4f1-587f-a97d-e0085ce49482" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186466182}] :answer-field/correct {:db/id #edb/ref 17592186466182} :answer-field/id #uuid "98ee50d6-62fb-5851-9ee5-5ce5a71ca168" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186466934}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbddaa01-5158-5d3b-b619-76268088aef1" :question/math-academy-id "q-334266" :question/problem "$$\n{x}^{2}{y}^{″}-3x{y}^{′}+4y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n- **I.** ${y}_{1}(x)={x}^{2}$ is a solution to the equation.\n- **II.** ${y}_{2}(x)={x}^{2}\\operatorname{ln}⁡(x)$ is a solution to the equation for $x>0.$\n- **III.** The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =2x \\\\ {y}_{1}^{″}(x) & =2\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot 2-3x\\cdot 2x+4{x}^{2} & =0 \\\\ 2{x}^{2}-6{x}^{2}+4{x}^{2} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2x\\operatorname{ln}⁡(x)+x \\\\ {y}_{2}^{″}(x) & =2\\operatorname{ln}⁡(x)+3\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(2\\operatorname{ln}⁡(x)+3)-3x(2x\\operatorname{ln}⁡(x)+x)+4{x}^{2}\\operatorname{ln}⁡(x) & =0 \\\\ 2{x}^{2}\\operatorname{ln}⁡(x)+3{x}^{2}-6{x}^{2}\\operatorname{ln}⁡(x)-3{x}^{2}+4{x}^{2}\\operatorname{ln}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is true. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2} & {x}^{2}\\operatorname{ln}⁡(x) \\\\ 2x & 2x\\operatorname{ln}⁡(x)+x\\end{aligned}| \\\\  & ={x}^{2}(2x\\operatorname{ln}⁡(x)+x)-{x}^{2}\\operatorname{ln}⁡(x)\\cdot 2x \\\\  & =2{x}^{3}\\operatorname{ln}⁡(x)+{x}^{3}-2{x}^{3}\\operatorname{ln}⁡(x) \\\\  & ={x}^{3}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0,\\infty ),$ the functions are linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nTherefore, the correct answer is \"I, II, and III\"."} :step/id #uuid "f8efebd5-69c4-553e-b210-51f0453b7375"}] :activity/title "Linear Independence of Solutions to Homogeneous ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186496655}]}
