186045493 #edb/ref 17592186045417] [17592186484124 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186484124 #edb/ref 1078 #edb/ref 17592186483926 #edb/ref 17592186045417] [17592186484124 #edb/ref 1079 #uuid "572b5c18-b30c-522b-af06-1c2750b42b52" #edb/ref 17592186045417] [17592186484128 #edb/ref 1075 #edb/ref 17592186483598 #edb/ref 17592186045417] [17592186484128 #edb/ref 1075 #edb/ref 17592186483708 #edb/ref 17592186045417] [17592186484128 #edb/ref 1075 #edb/ref 17592186483826 #edb/ref 17592186045417] [17592186484128 #edb/ref 1075 #edb/ref 17592186483920 #edb/ref 17592186045417] [17592186484128 #edb/ref 1075 #edb/ref 17592186483931 #edb/ref 17592186045417] [17592186484128 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186484128 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186484128 #edb/ref 1078 #edb/ref 17592186483598 #edb/ref 17592186045417] [17592186484128 #edb/ref 1079 #uuid "64759caf-77ed-5792-a395-f9662dbea5af" #edb/ref 17592186045417] [17592186484219 #edb/ref 1068 #edb/ref 17592186484128 #edb/ref 17592186045417] [17592186484219 #edb/ref 1069 "q-75951" #edb/ref 17592186045417] [17592186484219 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186484219 #edb/ref 1071 "The matrix $Q$ is given below. Let ${q}_{1}$, ${q}_{2}$, and ${q}_{3}$ be the respective columns of $Q.$\nDetermine if $B=\\text{{}{q}_{1},{q}_{2}\\text{}}$ is a basis of $\\text{Col}(Q).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{2}$, where ${q}_{3}={x}_{1}{q}_{1}+{x}_{2}{q}_{2}.$\n\n$$\nQ=[\\begin{aligned}1 & 0 & 2 \\\\ 2 & 2 & 8\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186484219 #edb/ref 1072 #uuid "4e023a9e-c79a-53ca-9a76-a188bd7ab902" #edb/ref 17592186045417] [17592186484219 #edb/ref 1074 "First, we reduce the matrix $Q$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}Q & =[\\begin{aligned}1 & 0 & 2 \\\\ 2 & 2 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 2 & 4\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So, a basis of $\\text{Col}(Q)$ is $\\{{q}_{1},{q}_{2}\\},$ that is to say,\n\n$$\nB=\\{[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\}.\n$$\n\nNow, since the $3$rd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${q}_{3}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n{{[\\begin{aligned}2 \\\\ 8\\end{aligned}]}_{⏟}}_{{q}_{3}}={{(2)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{q}_{1}}+{{(2)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}0 \\\\ 2\\end{aligned}]}_{⏟}}_{{q}_{2}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{2}=2\\cdot 2=4.$" #edb/ref 17592186045417] [17592186484303 #edb/ref 1058 #edb/ref 17592186484311 #edb/ref 17592186045417] [17592186484303 #edb/ref 1062 #uuid "0b8b441f-1ac7-578f-9670-a1e7fdce2cfe" #edb/ref 17592186045417] [17592186484303 #edb/ref 1063 #edb/ref 17592186484219 #edb/ref 17592186045417] [17592186484307 #edb/ref 1058 #edb/ref 17592186484323 #edb/ref 17592186045417] [17592186484307 #edb/ref 1062 #uuid "17548c6c-a0db-59ae-8691-b5c2e89ec05c" #edb/ref 17592186045417] [17592186484307 #edb/ref 1063 #edb/ref 17592186423621 #edb/ref 17592186045417] [17592186484311 #edb/ref 1058 #edb/ref 17592186484307 #edb/ref 17592186045417] [17592186484311 #edb/ref 1062 #uuid "2285bbbb-2b94-5bc1-a8a2-c4f8628b9d46" #edb/ref 17592186045417] [17592186484311 #edb/ref 1063 #edb/ref 17592186345151 #edb/ref 17592186045417] [17592186484323 #edb/ref 1062 #uuid "57e1f077-3a25-541d-a79a-09e739748679" #edb/ref 17592186045417] [17592186484323 #edb/ref 1063 #edb/ref 17592186484287 #edb/ref 17592186045417] [17592186484350 #edb/ref 1058 #edb/ref 17592186484303 #edb/ref 1759