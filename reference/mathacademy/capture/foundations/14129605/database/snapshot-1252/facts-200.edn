21-8ec2-2534d66acfdf" #edb/ref 17592186045417] [17592186425871 #edb/ref 1080 "2\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|" #edb/ref 17592186045417] [17592186425871 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186425871 #edb/ref 1083 #uuid "fb0c8f0c-3314-5bf3-83d0-87976ede682e" #edb/ref 17592186045417] [17592186425872 #edb/ref 1075 #edb/ref 17592186425859 #edb/ref 17592186045417] [17592186425872 #edb/ref 1075 #edb/ref 17592186425861 #edb/ref 17592186045417] [17592186425872 #edb/ref 1075 #edb/ref 17592186425862 #edb/ref 17592186045417] [17592186425872 #edb/ref 1075 #edb/ref 17592186425865 #edb/ref 17592186045417] [17592186425872 #edb/ref 1075 #edb/ref 17592186425870 #edb/ref 17592186045417] [17592186425872 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186425872 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186425872 #edb/ref 1078 #edb/ref 17592186425861 #edb/ref 17592186045417] [17592186425872 #edb/ref 1079 #uuid "375ee444-4376-5150-bb9c-79b09c44be67" #edb/ref 17592186045417] [17592186425873 #edb/ref 1075 #edb/ref 17592186425858 #edb/ref 17592186045417] [17592186425873 #edb/ref 1075 #edb/ref 17592186425860 #edb/ref 17592186045417] [17592186425873 #edb/ref 1075 #edb/ref 17592186425863 #edb/ref 17592186045417] [17592186425873 #edb/ref 1075 #edb/ref 17592186425864 #edb/ref 17592186045417] [17592186425873 #edb/ref 1075 #edb/ref 17592186425868 #edb/ref 17592186045417] [17592186425873 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186425873 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186425873 #edb/ref 1078 #edb/ref 17592186425868 #edb/ref 17592186045417] [17592186425873 #edb/ref 1079 #uuid "8c3bd452-520c-5cac-8263-6875362cc4e5" #edb/ref 17592186045417] [17592186425874 #edb/ref 1075 #edb/ref 17592186425857 #edb/ref 17592186045417] [17592186425874 #edb/ref 1075 #edb/ref 17592186425866 #edb/ref 17592186045417] [17592186425874 #edb/ref 1075 #edb/ref 17592186425867 #edb/ref 17592186045417] [17592186425874 #edb/ref 1075 #edb/ref 17592186425869 #edb/ref 17592186045417] [17592186425874 #edb/ref 1075 #edb/ref 17592186425871 #edb/ref 17592186045417] [17592186425874 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186425874 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186425874 #edb/ref 1078 #edb/ref 17592186425867 #edb/ref 17592186045417] [17592186425874 #edb/ref 1079 #uuid "ed337fba-8f9c-5284-b664-f31a93279b80" #edb/ref 17592186045417] [17592186425875 #edb/ref 1068 #edb/ref 17592186425872 #edb/ref 17592186045417] [17592186425875 #edb/ref 1069 "q-86922" #edb/ref 17592186045417] [17592186425875 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186425875 #edb/ref 1071 "Which of the following are continuous random variables?\n\nI. The outcome of rolling a $10$-sided die\n\nII. The number of aces in a standard deck of playing cards\n\nIII. The weight of a randomly selected person, measured in kilograms" #edb/ref 17592186045417] [17592186425875 #edb/ref 1072 #uuid "2365a6d7-b820-5041-9972-25df8cfa8866" #edb/ref 17592186045417] [17592186425875 #edb/ref 1074 "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $1,2,3,…,10,$ which do not correspond to an interval of real numbers.\n\n- Statement II does *not* describe a continuous random variable. The number of aces in a standard deck of playing cards is not the outcome of a trial or experiment. (By definition, there are $4$ aces in a standard deck of playing cards.)\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real numbers in the interval $(0,\\infty ).$\n\nTherefore, the correct answer is \"III only.\"" #edb/ref 17592186045417] [17592186425876 #edb/ref 1068 #edb/ref 17592186425873 #edb/ref 17592186045417] [17592186425876 #edb/ref 1069 "q-77072" #edb/ref 17592186045417] [17592186425876 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186425876 #edb/ref 1071 "![](images/01/014c2310bcac5b6e9c2be2107bf8a5613b689ff29a8018d2be74fc607dd996db.png)\n\nFind the arc length of the curve $r(t)=⟨7-2{t}^{3},3{t}^{2}+10⟩$\nfrom  $t=0$ to $t=\\sqrt{3}.$" #edb/ref 17592186045417] [17592186425876 #edb/ref 1072 #uuid "2ea583ed-35c3-538b-b597-43518611b1ac" #edb/ref 17592186045417] [17592186425876 #edb/ref 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(7-2{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+10)⟩ \\\\  & =⟨-6{t}^{2},\\,6t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-6{t}^{2})^{2}+(6t)^{2}} \\\\  & =\\sqrt{36{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{36{t}^{2}({t}^{2}+1)} \\\\  & =6t\\sqrt{{t}^{2}+1}\\end{aligned}\n$$\n\nNotice that $t\\ge 0$ for $t\\in [0,\\sqrt{3}].$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\sqrt{3}}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{3}}6t\\sqrt{{t}^{2}+1}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u={t}^{2}+1$, $\\text{d}u=2t\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\sqrt{3}}3\\sqrt{{t}^{2}+1}\\cdot 2t\\text{d}t \\\\  & ={\\int }_{1}^{4}3\\sqrt{u}\\,\\text{d}u \\\\  & =3\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =2{u}^{3/2}{|}_{1}^{4} \\\\  & =2(8-1) \\\\  & =14\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186425877 #edb/ref 1068 #edb/ref 17592186425874 #edb/ref 17592186045417] [17592186425877 #edb/ref 1069 "q-69953" #edb/ref 17592186045417] [17592186425877 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186425877 #edb/ref 1071 "$|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -3 & -1 & 2 & 4 \\\\ -1 & -5 & 5 & 1 \\\\ -2 & -1 & 2 & 3\\end{aligned}|=$" #edb/ref 17592186045417] [17592186425877 #edb/ref 1072 #uuid "eec69fbf-a0cd-50e6-9b17-0f0c96351008" #edb/ref 17592186045417] [17592186425877 #edb/ref 1074 "The $1$st row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 0 & 1 & 0 \\\\ -3 & -1 & 2 & 4 \\\\ -1 & -5 & 5 & 1 \\\\ -2 & -1 & 2 & 3\\end{aligned}| & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+1\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =1\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & -1 & 4 \\\\ -1 & -5 & 1 \\\\ -2 & -1 & 3\\end{aligned}|.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186425878 #edb/ref 1058 #edb/ref 17592186425880 #edb/ref 17592186045417] [17592186425878 #edb/ref 1062 #uuid "1eeb87c5-827d-5f16-8c07-70b850a6644d" #edb/ref 17592186045417] [17592186425878 #edb/ref 1063 #edb/ref 17592186425876 #edb/ref 17592186045417] [17592186425879 #edb/ref 1062 #uuid "40454b93-13bb-56b8-b1f8-96f146abc4d9" #edb/ref 17592186045417] [17592186425879 #edb/ref 1063 #edb/ref 17592186425877 #edb/ref 17592186045417] [17592186425880 #edb/ref 1058 #edb/ref 17592186425879 #edb/ref 17592186045417] [17592186425880 #edb/ref 1062 #uuid "518701d8-bb48-5e81-82cd-b420231888d1" #edb/ref 17592186045417] [17592186425880 #edb/ref 1063 #edb/ref 17592186305109 #edb/ref 17592186045417] [17592186425881 #edb/ref 1058 #edb/ref 17592186425878 #edb/ref 17592186045417] [17592186425881 #edb/ref 1062 #uuid "b8cfa482-64ec-5b16-91c4-308e96891613" #edb/ref 17592186045417] [17592186425881 #edb/ref 1063 #edb/ref 17592186425875 #edb/ref 17592186045417] [17592186425882 #edb/ref 1058 #edb/ref 17592186425881 #edb/ref 17592186045417] [17592186425882 #edb/ref 1062 #uuid "bb759bf3-e1d6-55c4-ad0e-7fff246f2577" #edb/ref 17592186045417] [17592186425882 #edb/ref 1063 #edb/ref 17592186311890 #edb/ref 17592186045417]}
