ef 17592186045417] [17592186130300 #edb/ref 1062 #uuid "c5c27e9e-03cb-5a93-8a56-bd33588960fe" #edb/ref 17592186045417] [17592186130300 #edb/ref 1063 #edb/ref 17592186130449 #edb/ref 17592186045417] [17592186130301 #edb/ref 1058 #edb/ref 17592186130302 #edb/ref 17592186045417] [17592186130301 #edb/ref 1061 618750 #edb/ref 17592186045417] [17592186130301 #edb/ref 1062 #uuid "031d5fb3-1834-595b-8a36-577430a0f9a7" #edb/ref 17592186045417] [17592186130301 #edb/ref 1063 #edb/ref 17592186130466 #edb/ref 17592186045417] [17592186130302 #edb/ref 1058 #edb/ref 17592186130303 #edb/ref 17592186045417] [17592186130302 #edb/ref 1061 618751 #edb/ref 17592186045417] [17592186130302 #edb/ref 1062 #uuid "a6a3e1f3-c536-58d3-a81e-7966262884ce" #edb/ref 17592186045417] [17592186130302 #edb/ref 1063 #edb/ref 17592186129318 #edb/ref 17592186045417] [17592186130303 #edb/ref 1058 #edb/ref 17592186130304 #edb/ref 17592186045417] [17592186130303 #edb/ref 1061 618754 #edb/ref 17592186045417] [17592186130303 #edb/ref 1062 #uuid "622390da-a9e6-55af-8449-1ceed5d4cec3" #edb/ref 17592186045417] [17592186130303 #edb/ref 1063 #edb/ref 17592186130450 #edb/ref 17592186045417] [17592186130304 #edb/ref 1058 #edb/ref 17592186130305 #edb/ref 17592186045417] [17592186130304 #edb/ref 1061 618755 #edb/ref 17592186045417] [17592186130304 #edb/ref 1062 #uuid "ddd7ced1-9fe0-533d-bd7a-9dfbcff663f8" #edb/ref 17592186045417] [17592186130304 #edb/ref 1063 #edb/ref 17592186129319 #edb/ref 17592186045417] [17592186130305 #edb/ref 1061 618758 #edb/ref 17592186045417] [17592186130305 #edb/ref 1062 #uuid "2f4e64a8-3397-5e7e-b805-080c59c56440" #edb/ref 17592186045417] [17592186130305 #edb/ref 1063 #edb/ref 17592186129320 #edb/ref 17592186045417] [17592186130449 #edb/ref 1064 "Recall that when we rotate a curve by $2\\pi$ radians about the $x$-axis, the area generated by this surface of revolution is given by\n\n$$\nS =  \\int 2\\pi y \\, \\textrm{d}s.\n$$\n\nNow suppose we have a parametrically defined curve: \n\n$$\nx = x(t), \\qquad\ny = y(t), \\qquad\nt \\in \\left[t_1,t_2\\right].\n$$\n\nIn the case of a parametric curve, the arc length element $\\textrm{d}s$ is given by\n\n$$\n\\textrm{d}s = \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2} \\, \\textrm{d}t.\n$$\n\nAs a result, we obtain the following formula for the surface area generated by rotating a parametrically defined curve about the $x$-axis:\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} y(t) \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\,\\textrm{d}t\n$$\n\n \n\nLet's see an example." #edb/ref 17592186045417] [17592186130449 #edb/ref 1065 6113 #edb/ref 17592186045417] [17592186130449 #edb/ref 1066 #uuid "36a57433-1c78-58b8-860c-0ea6e3471761" #edb/ref 17592186045417] [17592186130449 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130450 #edb/ref 1064 "When we rotate a curve by $2\\pi$ radians about the $y$-axis, the area generated by this surface of revolution is given by\n\n$$\nS =  \\int 2\\pi x \\, \\textrm{d}s.\n$$\n\nTherefore, in the case of a parametrically defined curve \n\n$$\nx = x(t), \\qquad\ny = y(t), \\qquad\nt \\in [t_1,t_2],\n$$\n\nthe formula for the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis is given by\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x(t) \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\,\\textrm{d}t.\n$$" #edb/ref 17592186045417] [17592186130450 #edb/ref 1065 6145 #edb/ref 17592186045417] [17592186130450 #edb/ref 1066 #uuid "548401c3-a52c-5444-b834-57c50c4bfa72" #edb/ref 17592186045417] [17592186130450 #edb/ref 1067 "Surface Area Generated by Functions of Y" #edb/ref 17592186045417] [17592186130466 #edb/ref 1064 "Consider the curve defined by the parametric equations\n\n$$\nx = \\cos{t}, \\qquad\ny = \\sin{t}, \\qquad\nt \\in [0,\\pi].\n$$\n\nIf we rotate this curve by $2\\pi$ radians about the $x$-axis, we obtain a sphere of radius $1.$ \n\n![](images/d0/d0d323b764b70d3f2830d821636a9bc27b40e7f7e9f45df909c81dd279dc16e4.png)\n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, the surface area of our surface of revolution can be computed as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\sqrt{{(-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =2\\pi (-\\operatorname{cos}⁡t){|}_{0}^{\\pi } \\\\  & =-2\\pi (\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-2\\pi (-1-1) \\\\  & =4\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130466 #edb/ref 1065 7707 #edb/ref 17592186045417] [17592186130466 #edb/ref 1066 #uuid "f849fe7f-670f-5a7f-8dc7-dbbd33a876f1" #edb/ref 17592186045417] [17592186130466 #edb/ref 1067 "A Worked Example" #edb/ref 17592186045417] [17592186266603 #edb/ref 1080 "2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" #edb/ref 17592186045417] [17592186266603 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266603 #edb/ref 1083 #uuid "34815984-fefd-5798-bdd6-d8ac9e63495b" #edb/ref 17592186045417] [17592186266984 #edb/ref 1080 "4\\pi {\\int }_{0}^{2}t\\sqrt{3{t}^{4}+2}\\,\\text{d}t" #edb/ref 17592186045417] [17592186266984 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266984 #edb/ref 1083 #uuid "5f3baba4-8572-53a6-81aa-d3e89b039d05" #edb/ref 17592186045417] [17592186267122 #edb/ref 1080 "6\\pi {\\int }_{0}^{2}{t}^{5}\\,\\text{d}t" #edb/ref 17592186045417] [17592186267122 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267122 #edb/ref 1083 #uuid "6f44b9c5-062e-5836-8fa5-9b241e49df01" #edb/ref 17592186045417] [17592186267539 #edb/ref 1080 "2\\pi {\\int }_{0}^{2}t\\sqrt{{t}^{4}+2}\\,\\text{d}t" #edb/ref 17592186045417] [17592186267539 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267539 #edb/ref 1083 #uuid "9a5f9d3b-c7f5-5304-ad78-7cc3982df96e" #edb/ref 17592186045417] [17592186267740 #edb/ref 1080 "4\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{{t}^{2}+1}\\,\\text{d}t" #edb/ref 17592186045417] [17592186267740 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267740 #edb/ref 1083 #uuid "b26a0858-4124-5ef1-b554-c41d2275431e" #edb/ref 17592186045417] [17592186268714 #edb/ref 1075 #edb/ref 17592186266603 #edb/ref 17592186045417] [17592186268714 #edb/ref 1075 #edb/ref 17592186266984 #edb/ref 17592186045417] [17592186268714 #edb/ref 1075 #edb/ref 17592186267122 #edb/ref 17592186045417] [17592186268714 #edb/ref 1075 #edb/ref 17592186267539 #edb/ref 17592186045417] [17592186268714 #edb/ref 1075 #edb/ref 17592186267740 #edb/ref 17592186045417] [17592186268714 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186268714 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186268714 #edb/ref 1078 #edb/ref 17592186266603 #edb/ref 17592186045417] [17592186268714 #edb/ref 1079 #uuid "ab978d17-dd39-5ce8-a339-813c29c490be" #edb/ref 17592186045417] [17592186269200 #edb/ref 1068 #edb/ref 17592186268714 #edb/ref 17592186045417] [17592186269200 #edb/ref 1069 "q-139056" #edb/ref 17592186045417] [17592186269200 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186269200 #edb/ref 1071 "Consider the curve defined parametrically as \n\n$$\nx={t}^{3},\\,y=2t,\\,t\\in [0,2].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis?" #edb/ref 17592186045417] [17592186269200 #edb/ref 1072 #uuid "3645ded7-1477-514e-b282-7668816fc19c" #edb/ref 17592186045417] [17592186269200 #edb/ref 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t)=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{{(3{t}^{2})}^{2}+{(2)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{2}{t}^{3}\\sqrt{9{t}^{4}+4}\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186367463 #edb/ref 1068 #edb/ref 17592186367464 #edb/ref 17592186045417] [17592186367463 #edb/ref 1069 "q-139026" #edb/ref 17592186045417] [17592186367463 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186367463 #edb/ref 1071 "Consider the curve defined parametrically as \n\n$$\nx=2{e}^{t},\\,y=2{e}^{-t},\\,t\\in [-2,2].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $y$-axis?" #edb/ref 17592186045417] [17592186367463 #edb/ref 1072 #uuid "1cc47049-1d82-526c-84a3-b9c51fd53a09" #edb/ref 17592186045417] [17592186367463 #edb/ref 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=-2$ to ${t}_{2}=2.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})=2{e}^{t} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{e}^{-t})=-2{e}^{-t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{-2}^{2}2{e}^{t}\\sqrt{{(2{e}^{t})}^{2}+{(-2{e}^{-t})}^{2}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{4{e}^{2t}+4{e}^{-2t}}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{4({e}^{2t}+{e}^{-2t})}\\,\\text{d}t \\\\  & =4\\pi {\\int }_{-2}^{2}{e}^{t}\\cdot 2\\cdot \\sqrt{({e}^{2t}+{e}^{-2t})}\\,\\text{d}t \\\\  & =8\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{{e}^{2t}+{e}^{-2t}}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the definition of the hyperbolic cosine $\\operatorname{cosh}⁡2t=\\frac{{e}^{2t}+{e}^{-2t}}{2},$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =8\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{{e}^{2t}+{e}^{-2t}}\\,\\text{d}t \\\\  & =8\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{2\\operatorname{cosh}⁡2t}\\,\\text{d}t \\\\  & =8\\pi {\\int }_{-2}^{2}{e}^{t}\\cdot \\sqrt{2}\\cdot \\sqrt{\\operatorname{cosh}⁡2t}\\,\\text{d}t \\\\  & =8\\sqrt{2}\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{\\operatorname{cosh}⁡2t}\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186367464 #edb/ref 1075 #edb/ref 17592186367465 #edb/ref 17592186045417] [17592186367464 #edb/ref 1075 #edb/ref 17592186367466 #edb/ref 17592186045417] [17592186367464 #edb/ref 1075 #edb/ref 17592186367467 #edb/ref 17592186045417] [17592186367464 #edb/ref 1075 #edb/ref 17592186367468 #edb/ref 17592186045417] [17592186367464 #edb/ref 1075 #edb/ref 17592186367469 #edb/ref 17592186045417] [17592186367464 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186367464 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186367464 #edb/ref 1078 #edb/ref 17592186367467 #edb/ref 17592186045417] [17592186367464 #edb/ref 1079 #uuid "4c091cf5-1213-5f71-95d4-647a3b748c8b" #edb/ref 17592186045417] [17592186367465 #edb/ref 1080 "4\\pi {\\int }_{-2}^{2}{e}^{-t}\\sqrt{\\operatorname{cosh}⁡t}\\,\\text{d}t" #edb/ref 17592186045417] [17592186367465 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186367465 #edb/ref 1083 #uuid "e2e8bc30-41c9-56c8-a5b2-e047a033dedb" #edb/ref 17592186045417] [17592186367466 #edb/ref 1080 "8\\pi {\\int }_{-2}^{2}{e}^{-t}\\sqrt{\\operatorname{sinh}⁡2t}\\,\\text{d}t" #edb/ref 17592186045417] [17592186367466 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186367466 #edb/ref 1083 #uuid "b854c123-c85d-5e04-a948-bd8a101d0416" #edb/ref 17592186045417] [17592186367467 #edb/ref 1080 "8\\sqrt{2}\\pi {\\int }_{-2}^{2}{e}^{t}\\sqrt{\\operatorname{cosh}⁡2t}\\,\\text{d}t" #edb/ref 17592186045417] [17592186367467 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186367467 #edb/ref 1083 #uuid "14edfcb2-c8de-5378-b4d9-078fcd77b9e7" #edb/ref 17592186045417] [17592186367468 #edb/ref 1080 "8\\sqrt{2}\\pi {\\int }_{-2}^{2}{e}^{t}\\,\\text{d}t" #edb/ref 17592186045417] [17592186367468 #edb/ref 1082 #e