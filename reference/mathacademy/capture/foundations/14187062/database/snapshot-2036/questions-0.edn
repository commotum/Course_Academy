#{[{:db/id #edb/ref 17592186500293 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e338a7c-f5c5-55b6-800b-47f10296b1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{112}{729}" :db/id #edb/ref 17592186499686} {:answer/id #uuid "4673f4bc-028d-52bd-b6cb-43a313197f90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{1458}" :db/id #edb/ref 17592186499785} {:answer/id #uuid "60d5eb82-e934-5a50-abfb-6bb988e212e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{230}{729}" :db/id #edb/ref 17592186499844} {:answer/id #uuid "aa8b3642-18a5-59b9-ba90-c44b1dc2ff93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{130}{729}" :db/id #edb/ref 17592186499989} {:answer/id #uuid "b05849a6-fd14-5761-ac6a-f3df6f46c897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{113}{1458}" :db/id #edb/ref 17592186500007}] :answer-field/correct {:answer/id #uuid "60d5eb82-e934-5a50-abfb-6bb988e212e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{230}{729}" :db/id #edb/ref 17592186499844} :answer-field/id #uuid "ecc71117-bad7-5cf6-bbde-8b45ac8873de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500274}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2175ed2b-85f5-5f4e-9b21-fd44965b957e" :question/math-academy-id "q-126173" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{x}{6}-\\frac{{x}^{3}}{1458}, & 0\\le x\\le 9 \\\\ 1, & x>9,\\end{aligned}\n$$\n\nfind $P(1<X\\le 3).$" :question/worked-solution "We can perform this computation as follows:\n\n$$\n\\begin{aligned}P(1<X\\le 3) & =P(X\\le 3)-P(X\\le 1) \\\\  & =F(3)-F(1) \\\\  & =(\\frac{3}{6}-\\frac{{3}^{3}}{1458})-(\\frac{1}{6}-\\frac{{1}^{3}}{1458}) \\\\  & =\\frac{230}{729}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501225 :knowledge-point/_questions [{:db/id #edb/ref 17592186133727 :knowledge-point/id #uuid "7b0ce833-e045-5aff-94a4-f9ad56cdb904" :knowledge-point/title "Computing a CDF Given a PDF That’s Nonzero Over All Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b593b2a-af8d-5c4e-9746-8d5e8f4120fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{e^{-x}}{2}" :db/id #edb/ref 17592186500523}] :answer-field/correct {:answer/id #uuid "1b593b2a-af8d-5c4e-9746-8d5e8f4120fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{e^{-x}}{2}" :db/id #edb/ref 17592186500523} :answer-field/id #uuid "bb588555-9fd1-5660-8555-bc1960f97262" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501104}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0e0e171-2942-5666-9f4c-984a9e7d868a" :question/math-academy-id "q-185531" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|x|}}{2},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x}}{2},\\, & x\\le 0 \\\\ h(x),\\, & x>0\\end{aligned}\n$$\n\nwhere $h(x)=${{field-1}}." :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t}}{2}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t}}{2}\\,\\text{d}t & ={\\frac{{e}^{t}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{x}}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t & ={\\frac{{e}^{x}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t & =-{\\frac{{e}^{-t}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-x}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-x}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-x}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x}}{2},\\, & x\\le 0 \\\\ 1-\\frac{{e}^{-x}}{2},\\, & x>0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501183 :knowledge-point/_questions [{:db/id #edb/ref 17592186133728 :knowledge-point/id #uuid "eedcfa3d-b02b-5f96-99f4-cd0a452d272a" :knowledge-point/title "Finding a CDF Given a PDF With Lower and Upper Bounds"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c522a9a-a340-5730-935a-e853421c44ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75-2x}{75}" :db/id #edb/ref 17592186500525} {:answer/id #uuid "49f3c406-0b5e-5522-a240-414ac7e0f856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-25}{75}" :db/id #edb/ref 17592186500615} {:answer/id #uuid "887364d0-5dcf-5d1a-9cb5-af1322ef590e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{75-{x}^{2}}{75}" :db/id #edb/ref 17592186500754} {:answer/id #uuid "b55dc857-62d1-5ed0-85ee-8b7c291b0260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{75}x" :db/id #edb/ref 17592186500845} {:answer/id #uuid "f364853a-396b-5d86-bdbe-5ffe621626d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{75}{x}^{2}" :db/id #edb/ref 17592186500984}] :answer-field/correct {:answer/id #uuid "49f3c406-0b5e-5522-a240-414ac7e0f856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-25}{75}" :db/id #edb/ref 17592186500615} :answer-field/id #uuid "94adf626-a400-5181-b287-7ccffcedb8aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501085}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "770dc96c-77d3-556b-b303-18d387043365" :question/math-academy-id "q-89606" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{75}x,\\, & 5\\le x\\le 10 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<5 \\\\ h(x),\\, & 5\\le x\\le 10 \\\\ 1,\\, & x>10.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that is strictly positive only for $5\\le x\\le 10,$ the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}0, & x<5 \\\\ {\\int }_{5}^{x}f(t)\\,\\text{d}t, & 5\\le x\\le 10 \\\\ 1, & x>10\\end{aligned}\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}{\\int }_{5}^{x}f(t)\\,\\text{d}t & ={\\int }_{5}^{x}\\frac{2}{75}t\\,\\text{d}t \\\\ \\text{ } & ={\\frac{1}{75}{t}^{2}|}_{5}^{x} \\\\  & =\\frac{1}{75}{x}^{2}-\\frac{1}{3} \\\\  & =\\frac{{x}^{2}-25}{75}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<5, \\\\ \\frac{{x}^{2}-25}{75},\\, & 5\\le x\\le 10, \\\\ 1,\\, & x>10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134540 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f4af3cf-f231-595b-aaf4-49e10d20ff41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186133280} {:answer/id #uuid "e6bd978c-da5d-59dd-85e1-a2c03295ee58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{25}" :db/id #edb/ref 17592186133281} {:answer/id #uuid "f256f7ab-c378-584b-ab95-d8f9f46921ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186133282} {:answer/id #uuid "4a3624d2-d1b2-5d89-8864-4bd4b45113e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{8}{25}" :db/id #edb/ref 17592186500616} {:answer/id #uuid "c3226fc1-cbce-5f81-a7bd-59cad1dcc127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{8}{25}" :db/id #edb/ref 17592186500875}] :answer-field/correct {:answer/id #uuid "e6bd978c-da5d-59dd-85e1-a2c03295ee58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{25}" :db/id #edb/ref 17592186133281} :answer-field/id #uuid "c2ed936f-3ea8-56c4-8eab-fb9925367eff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133278}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc0b739c-e444-5ab3-bcd2-409b731d56fc" :question/math-academy-id "q-89612" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{{x}^{2}}{25}, & 0\\le x\\le 5 \\\\ 1, & x>5,\\end{aligned}\n$$\n\nfind $P(1\\le X\\le 3).$" :question/worked-solution "Remember that for continuous random variables, it doesn't matter whether or not we include the endpoints of the interval. So we can perform the computation as follows:\n\n$$\n\\begin{aligned}P(1\\le X\\le 3) & =P(1<X\\le 3) \\\\  & =P(X\\le 3)-P(X\\le 1) \\\\  & =F(3)-F(1) \\\\  & =\\frac{{3}^{2}}{25}-\\frac{{1}^{2}}{25} \\\\  & =\\frac{8}{25}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186501212 :knowledge-point/_questions [{:db/id #edb/ref 17592186133727 :knowledge-point/id #uuid "7b0ce833-e045-5aff-94a4-f9ad56cdb904" :knowledge-point/title "Computing a CDF Given a PDF That’s Nonzero Over All Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e28268-65ac-57f8-af23-8c479907164b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+1" :db/id #edb/ref 17592186500575} {:answer/id #uuid "3f2d1618-08b3-504b-b2c5-01edf31c29f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{1}{2}" :db/id #edb/ref 17592186500592} {:answer/id #uuid "57509640-0482-58cb-88f2-e1a8054d767c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }-\\frac{1}{2}" :db/id #edb/ref 17592186500644} {:answer/id #uuid "697f3908-8152-5679-962d-8baf5ef9a307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{\\pi }{2}" :db/id #edb/ref 17592186500685} {:answer/id #uuid "acccdbc8-03e2-5723-966d-27a022e016ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }-\\frac{\\pi }{2}" :db/id #edb/ref 17592186500823}] :answer-field/correct {:answer/id #uuid "3f2d1618-08b3-504b-b2c5-01edf31c29f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{1}{2}" :db/id #edb/ref 17592186500592} :answer-field/id #uuid "b07d72d2-93c7-594a-8963-dcc12be62f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b31007d2-c9e1-51d3-8e66-44402735c224" :question/math-academy-id "q-89634" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{3{x}^{2}}{\\pi (1+{x}^{6})},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nfind the cumulative distribution function $F(x).$" :question/worked-solution "The cumulative distribution function of a continuous random variable $X$ is the function $F(x)$ defined by\n\n$$\nF(x)=P(X\\le x)={\\int }_{-\\infty }^{x}f(t)\\,\\text{d}t.\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}F(x) & ={\\int }_{-\\infty }^{x}f(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\infty }^{x}\\frac{3{t}^{2}}{\\pi (1+{t}^{6})}\\,\\text{d}t \\\\  & ={\\frac{\\operatorname{arctan}⁡({t}^{3})}{\\pi }|}_{-\\infty }^{x} \\\\  & =\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{1}{2}\\end{aligned}\n$$"}]}
