#{[{:db/id #edb/ref 17592186500293 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e338a7c-f5c5-55b6-800b-47f10296b1d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{112}{729}" :db/id #edb/ref 17592186499686} {:answer/id #uuid "4673f4bc-028d-52bd-b6cb-43a313197f90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23}{1458}" :db/id #edb/ref 17592186499785} {:answer/id #uuid "60d5eb82-e934-5a50-abfb-6bb988e212e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{230}{729}" :db/id #edb/ref 17592186499844} {:answer/id #uuid "aa8b3642-18a5-59b9-ba90-c44b1dc2ff93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{130}{729}" :db/id #edb/ref 17592186499989} {:answer/id #uuid "b05849a6-fd14-5761-ac6a-f3df6f46c897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{113}{1458}" :db/id #edb/ref 17592186500007}] :answer-field/correct {:answer/id #uuid "60d5eb82-e934-5a50-abfb-6bb988e212e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{230}{729}" :db/id #edb/ref 17592186499844} :answer-field/id #uuid "ecc71117-bad7-5cf6-bbde-8b45ac8873de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500274}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2175ed2b-85f5-5f4e-9b21-fd44965b957e" :question/math-academy-id "q-126173" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{x}{6}-\\frac{{x}^{3}}{1458}, & 0\\le x\\le 9 \\\\ 1, & x>9,\\end{aligned}\n$$\n\nfind $P(1<X\\le 3).$" :question/worked-solution "We can perform this computation as follows:\n\n$$\n\\begin{aligned}P(1<X\\le 3) & =P(X\\le 3)-P(X\\le 1) \\\\  & =F(3)-F(1) \\\\  & =(\\frac{3}{6}-\\frac{{3}^{3}}{1458})-(\\frac{1}{6}-\\frac{{1}^{3}}{1458}) \\\\  & =\\frac{230}{729}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134540 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9065611e-8a7f-5b3d-a226-e3a921058174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 - \\frac{8}{25}" :db/id #edb/ref 17592186133279} {:answer/id #uuid "9f4af3cf-f231-595b-aaf4-49e10d20ff41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186133280} {:answer/id #uuid "e6bd978c-da5d-59dd-85e1-a2c03295ee58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{25}" :db/id #edb/ref 17592186133281} {:answer/id #uuid "f256f7ab-c378-584b-ab95-d8f9f46921ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186133282} {:answer/id #uuid "35bfddc6-b084-5667-a14c-ae334192de2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + \\frac{8}{25}" :db/id #edb/ref 17592186133283}] :answer-field/id #uuid "c2ed936f-3ea8-56c4-8eab-fb9925367eff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133278}] :question/id #uuid "dc0b739c-e444-5ab3-bcd2-409b731d56fc" :question/math-academy-id "q-89612" :question