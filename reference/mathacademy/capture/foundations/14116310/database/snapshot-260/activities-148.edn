#{[{:activity/first-step {:db/id #edb/ref 17592186060675} :activity/id #uuid "5052a9d6-d9c5-5df7-993c-818d53b162fb" :activity/scope {:db/id #edb/ref 17592186050765 :topic/id #uuid "64dbabd7-08e6-5435-b006-ab4997312f47" :topic/math-academy-id 148} :activity/steps [{:db/id #edb/ref 17592186060675 :step/content {:db/id #edb/ref 17592186060938 :tutorial/content "We can use matrices to solve systems of linear equations. To do this, we need to set up the **augmented matrix** for the system.\n\nAs an example, let's consider the system of equations below.\n\n$$\n\\begin{aligned}2x+5y=-1 \\\\ -3x+7y=1\\end{aligned}\n$$\n\nFirst, we find the **coefficient matrix**, which consists of the coefficients of the variables:\n\n$$\n\\begin{aligned}2 & 5 \\\\ -3 & 7\\end{aligned}\n$$\n\nThen, we create the **augmented matrix**. This is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\begin{aligned}2 & 5 & -1 \\\\ -3 & 7 & 1\\end{aligned}\n$$\n\nIn the future, we will learn how to use coefficient and augmented matrices to solve systems of equations. But for now, let's practice setting them up." :tutorial/id #uuid "36b1a271-77b9-59ed-9f12-1b6675c26830" :tutorial/math-academy-id 3146 :tutorial/title "Introduction"} :step/id #uuid "5b2031d1-6747-5c9a-b8e2-711f6dd1e094" :step/math-academy-id 17169 :step/next {:db/id #edb/ref 17592186060678}} {:db/id #edb/ref 17592186060676 :step/content {:db/id #edb/ref 17592186059767 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059576 :question/id #uuid "b2196eb1-6691-549b-950a-a9bab6863a70" :question/math-academy-id "e-4683"} :knowledge-point/id #uuid "cb13e9d9-19f0-5f39-b9f8-e6e2f8fac433" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048678} {:db/id #edb/ref 17592186048896}] :knowledge-point/questions [{:db/id #edb/ref 17592186059972} {:db/id #edb/ref 17592186060394} {:db/id #edb/ref 17592186240971} {:db/id #edb/ref 17592186262931} {:db/id #edb/ref 17592186262932} {:db/id #edb/ref 17592186272222} {:db/id #edb/ref 17592186272223} {:db/id #edb/ref 17592186272224} {:db/id #edb/ref 17592186272225} {:db/id #edb/ref 17592186338974} {:db/id #edb/ref 17592186338975}] :knowledge-point/title "Finding the Coefficient Matrix of a System of Linear Equations"} :step/id #uuid "8e2bc116-2181-5120-9389-ff1ba9b3ee5e" :step/math-academy-id 17170 :step/next {:db/id #edb/ref 17592186060677}} {:db/id #edb/ref 17592186060677 :step/content {:db/id #edb/ref 17592186059768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059577 :question/id #uuid "b5967dd6-bdf9-5cd0-9639-ec2816d04256" :question/math-academy-id "e-4684"} :knowledge-point/id #uuid "3f9ccaa5-d69c-584d-946e-0c57b3050160" :knowledge-point/questions [{:db/id #edb/ref 17592186059969} {:db/id #edb/ref 17592186060201} {:db/id #edb/ref 17592186241007} {:db/id #edb/ref 17592186243890} {:db/id #edb/ref 17592186262947} {:db/id #edb/ref 17592186262948} {:db/id #edb/ref 17592186338976}] :knowledge-point/title "Finding the Augmented Matrix of a System of Linear Equations"} :step/id #uuid "e6584e81-18d3-5c82-b510-c6d84d369be3" :step/math-academy-id 17171 :step/next {:db/id #edb/ref 17592186060679}} {:db/id #edb/ref 17592186060678 :step/content {:db/id #edb/ref 17592186060939 :tutorial/content "We will use mostly systems with the following variables:\n\n- $x,y,z,$ or\n\n- $x_1,x_2,x_3,$ or\n\n- $a,b,c.$\n\nThese sets of variables will always have a *natural* order:\n\n- alphabetical order in the case of $x,y,z$ or $a,b,c,$ and\n\n- numerical order in the case of $x_1, x_2, x_3.$" :tutorial/id #uuid "f6081e68-9014-5a0d-a6bf-084abe5fd28e" :tutorial/math-academy-id 3147 :tutorial/title "The Order of the Variables in a Linear System"} :step/id #uuid "17bd5ecf-ddf0-5755-a7bc-19c589337468" :step/math-academy-id 17172 :step/next {:db/id #edb/ref 17592186060676}} {:db/id #edb/ref 17592186060679 :step/content {:db/id #edb/ref 17592186059769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059578 :question/id #uuid "05942b5f-c165-59c6-8b67-24bc8dd40cca" :question/math-academy-id "e-4685"} :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/questions [{:db/id #edb/ref 17592186060198} {:db/id #edb/ref 17592186060395} {:db/id #edb/ref 17592186262949} {:db/id #edb/ref 17592186287985} {:db/id #edb/ref 17592186287986} {:db/id #edb/ref 17592186338977} {:db/id #edb/ref 17592186338978} {:db/id #edb/ref 17592186400380} {:db/id #edb/ref 17592186400387} {:db/id #edb/ref 17592186401833} {:db/id #edb/ref 17592186409515}] :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"} :step/id #uuid "9c9a13d7-cb68-5563-a0cd-305ad4cad7f7" :step/math-academy-id 17173 :step/next {:db/id #edb/ref 17592186060680}} {:db/id #edb/ref 17592186060680 :step/content {:db/id #edb/ref 17592186059770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059579 :question/id #uuid "161a4327-2356-5779-92a6-8495cfffefb9" :question/math-academy-id "e-4686"} :knowledge-point/id #uuid "14d047c8-f032-5ff3-aced-65d40bfeeaad" :knowledge-point/questions [{:db/id #edb/ref 17592186059976} {:db/id #edb/ref 17592186060396} {:db/id #edb/ref 17592186243994} {:db/id #edb/ref 17592186244042} {:db/id #edb/ref 17592186262950} {:db/id #edb/ref 17592186262953} {:db/id #edb/ref 17592186262954} {:db/id #edb/ref 17592186338979} {:db/id #edb/ref 17592186338980} {:db/id #edb/ref 17592186338981}] :knowledge-point/title "Finding the Augmented Matrix of a Linear System With Variables Other Than x, y, z"} :step/id #uuid "f6cdbf1b-5a64-5b3d-b66b-3ba956756491" :step/math-academy-id 17174}] :activity/title "Systems of Equations as Augmented Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059882}]}
