      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q226103-9581df6dd4f30524c3af.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q226103-9581df6dd4f30524c3af.png",
      "source_url": "https://mathacademy.com/tasks/14224093/topics/3715/lesson",
