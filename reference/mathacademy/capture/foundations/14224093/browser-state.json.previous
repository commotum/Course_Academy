      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127030-e2e7a290e66bf4311292.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127030-e2e7a290e66bf4311292.png",
      "source_url": "https://mathacademy.com/tasks/14224093/topics/3715/lesson",
      "captured_at": 1792039084.238114,
      "math_academy_id": "q-127030",
      "topic_id": "3715",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q127030",
        "placement_id": null,
        "content_id": null,
        "type": null
