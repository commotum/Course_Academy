      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q226136-2c70fd26100bd8e49a32.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q226136-2c70fd26100bd8e49a32.png",
      "source_url": "https://mathacademy.com/tasks/14224093/topics/3715/lesson",
      "captured_at": 1792039234.051441,
      "math_academy_id": "q-226136",
      "topic_id": "3715",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q226136",
        "placement_id": null,
        "content_id": null,
