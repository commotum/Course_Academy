      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127049-985ebc472fb4038962d7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127049-985ebc472fb4038962d7.png",
      "source_url": "https://mathacademy.com/tasks/14224093/topics/3715/lesson",
      "captured_at": 1792039153.2599516,
      "math_academy_id": "q-127049",
      "topic_id": "3715",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q127049",
