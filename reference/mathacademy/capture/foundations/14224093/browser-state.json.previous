      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127193-9eccf2688e8784e6f952.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224093/observations/step-q127193-9eccf2688e8784e6f952.png",
      "source_url": "https://mathacademy.com/tasks/14224093/topics/3715/lesson",
