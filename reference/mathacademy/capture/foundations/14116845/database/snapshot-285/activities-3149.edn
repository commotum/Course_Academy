#{[{:activity/first-step {:db/id #edb/ref 17592186167691} :activity/id #uuid "adc0eea0-4c11-5878-9c7e-48c4aba23d56" :activity/scope {:db/id #edb/ref 17592186050983 :topic/id #uuid "76f021c9-2347-5c45-873f-1f9d1e3473c8" :topic/math-academy-id 3149} :activity/steps [{:db/id #edb/ref 17592186167691 :step/content {:db/id #edb/ref 17592186168082 :tutorial/content "A vector field $\\mathbf F$ is **conservative** if there exists a scalar function $f$ such that \n\n$$\n\\mathbf{F} = \\nabla \\! f.\n$$\n\nIf such a function $f$ exists, it is called a **potential function** for $\\mathbf F.$\n\nFor example, consider the vector field $\\mathbf F,$ given by\n\n$$\n\\mathbf F(x,y) = 2x\\,\\mathbf i + 2y\\,\\mathbf j.\n$$\n\nThe function $f(x,y) = x^2 + y^2$ is a potential function for $\\mathbf F$ because\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\,j \\\\  & =2x\\,i+2y\\,j \\\\  & =F.\\end{aligned}\n$$\n\nNot all vector fields are conservative. However, conservative vector fields have many interesting and useful properties, as we'll soon discover." :tutorial/id #uuid "b1462096-7305-5fe4-ae99-253541521cba" :tutorial/math-academy-id 5152 :tutorial/title "Introduction"} :step/id #uuid "1992388a-9592-55ad-8541-266b5f3c9669" :step/math-academy-id 32405 :step/next {:db/id #edb/ref 17592186167698}} {:db/id #edb/ref 17592186167698 :step/content {:db/id #edb/ref 17592186166846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166696 :question/id #uuid "6ddfa412-1f5a-5ddd-8d61-d7f27b106022" :question/math-academy-id "e-8751"} :knowledge-point/id #uuid "cd281121-21d3-5dc4-8537-af248d0fdf46" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050885}] :knowledge-point/questions [{:db/id #edb/ref 17592186167049} {:db/id #edb/ref 17592186167541} {:db/id #edb/ref 17592186240865} {:db/id #edb/ref 17592186240866} {:db/id #edb/ref 17592186240867} {:db/id #edb/ref 17592186382682} {:db/id #edb/ref 17592186382689} {:db/id #edb/ref 17592186382696} {:db/id #edb/ref 17592186382703}] :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"} :step/id #uuid "774cb7e3-782d-56db-8b29-9c8786c0396b" :step/math-academy-id 32593 :step/next {:db/id #edb/ref 17592186167749}} {:db/id #edb/ref 17592186167747 :step/content {:db/id #edb/ref 17592186166863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166716 :question/id #uuid "3f266f66-1d79-5864-b497-1bc1b138c318" :question/math-academy-id "e-9499"} :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/questions [{:db/id #edb/ref 17592186167051} {:db/id #edb/ref 17592186167319} {:db/id #edb/ref 17592186240898} {:db/id #edb/ref 17592186240901} {:db/id #edb/ref 17592186259580} {:db/id #edb/ref 17592186351310} {:db/id #edb/ref 17592186351360} {:db/id #edb/ref 17592186351361} {:db/id #edb/ref 17592186383048}] :knowledge-point/title "Identifying Conservative Vector Fields"} :step/id #uuid "218a6bf7-b94b-5fa6-bb10-cfd37d79dc0e" :step/math-academy-id 35579} {:db/id #edb/ref 17592186167748 :step/content {:db/id #edb/ref 17592186166864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166717 :question/id #uuid "ae01904d-13f0-5d6e-ad3a-cc714c65765b" :question/math-academy-id "e-9500"} :knowledge-point/id #uuid "d8d73fd7-cdeb-59f1-a84c-aab6defb3aa3" :knowledge-point/questions [{:db/id #edb/ref 17592186167050} {:db/id #edb/ref 17592186167090} {:db/id #edb/ref 17592186235528} {:db/id #edb/ref 17592186240870} {:db/id #edb/ref 17592186240872} {:db/id #edb/ref 17592186259581} {:db/id #edb/ref 17592186259582} {:db/id #edb/ref 17592186259583} {:db/id #edb/ref 17592186362333} {:db/id #edb/ref 17592186383055}] :knowledge-point/title "Finding a Parameter in a Given Conservative Vector Field"} :step/id #uuid "2a21469f-f98e-54de-806c-b0901c562c75" :step/math-academy-id 35582 :step/next {:db/id #edb/ref 17592186167747}} {:db/id #edb/ref 17592186167749 :step/content {:db/id #edb/ref 17592186168124 :tutorial/content "Let $\\mathbf F(x,y) = P(x,y)\\,\\mathbf i+ Q(x,y)\\,\\mathbf j$ be a vector field with domain $D = \\mathbb R^2,$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$\\mathbf F$ *is conservative if and only if $\\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x}$ everywhere on $D.$*\n\nNote that this is equivalent to saying that the scalar curl is zero everywhere on $D,$ i.e.,\n\n$$\\dfrac{\\partial Q}{\\partial x} - \\dfrac{\\partial P}{\\partial y} = 0.$$\n\nIf $D\\neq\\mathbb R^2,$ then the situation gets a little trickier. We'll consider this case in a separate lesson." :tutorial/id #uuid "9a5b26c9-caa5-579e-a57c-c42b07eebafe" :tutorial/math-academy-id 5806 :tutorial/title "A Test to Determine Whether a Given Vector Field is Conservative"} :step/id #uuid "d7a42f9a-6688-59d2-b357-eb5701925961" :step/math-academy-id 35586 :step/next {:db/id #edb/ref 17592186167748}}] :activity/title "Conservative Vector Fields in the Cartesian Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186166975}]}
