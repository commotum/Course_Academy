#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186180392} :activity/id #uuid "b5724cde-5bc2-5852-a8c8-fc07daea7df1" :activity/scope {:db/id #edb/ref 17592186048540 :topic/id #uuid "a83fec6b-7cfc-5d6a-8354-4213d7005db0" :topic/math-academy-id 3703} :activity/steps [{:db/id #edb/ref 17592186180391 :step/content {:db/id #edb/ref 17592186179673 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179529 :question/id #uuid "1cadcaa9-876e-56cb-b8b3-17695827c4f3" :question/math-academy-id "e-7035"} :knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049512} {:db/id #edb/ref 17592186050616}] :knowledge-point/questions [{:db/id #edb/ref 17592186180008} {:db/id #edb/ref 17592186180287} {:db/id #edb/ref 17592186259700} {:db/id #edb/ref 17592186259701} {:db/id #edb/ref 17592186259703} {:db/id #edb/ref 17592186259706} {:db/id #edb/ref 17592186387533} {:db/id #edb/ref 17592186387540} {:db/id #edb/ref 17592186387547} {:db/id #edb/ref 17592186415439} {:db/id #edb/ref 17592186415440}] :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"} :step/id #uuid "b5ba14cd-f6f4-57b8-b3fd-9fe9b4b7cf07" :step/math-academy-id 25934} {:db/id #edb/ref 17592186180392 :step/content {:db/id #edb/ref 17592186180680 :tutorial/content "Let $f(x,y)$ be a function of two variables and $C$ be a path in the $xy$-plane. Recall that the line integral\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm dx +  f(x,y)\\,\\textrm d y\n$$\n\ncan be evaluated by parameterizing $C$ using the parameter $t\\in [a,b]$ and then applying a change of variables, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x+f(x,y)\\,\\text{d}y & ={\\int }_{a}^{b}f(x,y)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+f(x,y)\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{a}^{b}(f(x,y)\\frac{\\text{d}x}{\\text{d}t}+f(x,y)\\frac{\\text{d}y}{\\text{d}t})\\,\\text{d}t\\end{aligned}\n$$\n\nThe hardest part is often finding a suitable parameterization for curve $C.$ We'll discuss a number of different cases in this lesson." :tutorial/id #uuid "ffb7dba6-a1f1-50a3-a8a2-c1bf8b0b495d" :tutorial/math-academy-id 4271 :tutorial/title "Introduction"} :step/id #uuid "4617b3e7-d106-54fa-a698-38ed80409cb9" :step/math-academy-id 25938 :step/next {:db/id #edb/ref 17592186180475}} {:db/id #edb/ref 17592186180393 :step/content {:db/id #edb/ref 17592186179674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179530 :question/id #uuid "5a63ca22-0b1a-5584-8b43-c80457016cd3" :question/math-academy-id "e-7038"} :knowledge-point/id #uuid "9f04a969-e7e0-592f-b5cd-e92fedb217a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048645} {:db/id #edb/ref 17592186049633}] :knowledge-point/questions [{:db/id #edb/ref 17592186180174} {:db/id #edb/ref 17592186180286} {:db/id #edb/ref 17592186259705} {:db/id #edb/ref 17592186259707} {:db/id #edb/ref 17592186326776} {:db/id #edb/ref 17592186351189} {:db/id #edb/ref 17592186351216} {:db/id #edb/ref 17592186351250} {:db/id #edb/ref 17592186357487} {:db/id #edb/ref 17592186357488} {:db/id #edb/ref 17592186415442} {:db/id #edb/ref 17592186544869}] :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Along Cartesian Curves"} :step/id #uuid "85d02000-0eb4-519a-9890-2d8078563dbf" :step/math-academy-id 25939 :step/next {:db/id #edb/ref 17592186180391}} {:db/id #edb/ref 17592186180475 :step/content {:db/id #edb/ref 17592186179728 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179590 :question/id #uuid "9d13f401-5e07-5b07-8916-df2b0b6b8f74" :question/math-academy-id "e-9515"} :knowledge-point/id #uuid "223ec615-045d-543e-96f4-fec8882bec9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048512} {:db/id #edb/ref 17592186050666}] :knowledge-point/questions [{:db/id #edb/ref 17592186180009} {:db/id #edb/ref 17592186180284} {:db/id #edb/ref 17592186259699} {:db/id #edb/ref 17592186259702} {:db/id #edb/ref 17592186259704} {:db/id #edb/ref 17592186326759} {:db/id #edb/ref 17592186351218} {:db/id #edb/ref 17592186415441} {:db/id #edb/ref 17592186415443} {:db/id #edb/ref 17592186535937} {:db/id #edb/ref 17592186536002}] :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Over Segments"} :step/id #uuid "dd47e2fc-0023-5f03-93a4-3412436038e3" :step/math-academy-id 35618 :step/next {:db/id #edb/ref 17592186180393}}] :activity/title "Sums of Line Integrals With Respect to X and Y" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179856}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186544951} :activity/id #uuid "0740e920-8936-5f5e-bfee-033b67698f39" :activity/scope {:db/id #edb/ref 17592186048540 :topic/id #uuid "a83fec6b-7cfc-5d6a-8354-4213d7005db0" :topic/math-academy-id 3703} :activity/steps [{:db/id #edb/ref 17592186544909 :step/content {:db/id #edb/ref 17592186259703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f6d91d8-d6dd-52c9-b3ff-b1db44329a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\pi " :db/id #edb/ref 17592186257620} {:answer/id #uuid "6266e64e-03c1-58e9-a2a7-faa1e9d1ab4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6\\pi -5}{2}" :db/id #edb/ref 17592186257649} {:answer/id #uuid "e5e0d134-f8c3-5cad-825a-eca5a50c39ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\pi +1}{4}" :db/id #edb/ref 17592186258774} {:answer/id #uuid "eef0270e-6352-5435-b70f-a6965924b8db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12\\pi -5}{4}" :db/id #edb/ref 17592186258853} {:answer/id #uuid "fddbbdf7-66ee-5acd-97fd-6d8474436d61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pi " :db/id #edb/ref 17592186259004}] :answer-field/correct {:db/id #edb/ref 17592186257649} :answer-field/id #uuid "e4c70434-b863-58cf-ba58-7f3a3ae42742" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259432}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3189421a-c22a-5fa2-87db-a7498ce87212" :question/math-academy-id "q-124661" :question/problem "Evaluate ${\\int }_{C}(x-y)\\,dx+(x+y)\\,dy,$ where $C$ is part of the ellipse $9{x}^{2}+4{y}^{2}=36$ traversed in the counterclockwise direction from the point $(0,3)$ to the point $(-2,0).$" :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively, it can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=2\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j,\\,t\\in [\\frac{\\pi }{2},\\pi ]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & ={x}^{′}(t)\\,i+{y}^{′}(t)\\,j=-2\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,dx+(x+y)\\,dy & ={\\int }_{\\pi /2}^{\\pi }(x-y)\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t+(x+y)\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }((x-y)\\,\\frac{dx}{\\text{d}t}+(x+y)\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }(2\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t)\\cdot (-2\\operatorname{sin}⁡t)+(2\\operatorname{cos}⁡t+3\\operatorname{sin}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }(-4\\operatorname{cos}⁡t\\operatorname{sin}⁡t+6{sin}^{2}⁡t+6{cos}^{2}⁡t+9\\operatorname{cos}⁡t\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }5\\operatorname{sin}⁡t\\operatorname{cos}⁡t+6\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\frac{5}{2}\\operatorname{sin}⁡2t+6\\,\\text{d}t \\\\  & ={[-\\frac{5}{4}\\operatorname{cos}⁡2t+6t]}_{\\pi /2}^{\\pi } \\\\  & =[(-\\frac{5}{4}\\operatorname{cos}⁡(2\\pi )+6\\pi )-(-\\frac{5}{4}\\operatorname{cos}⁡(\\pi )+3\\pi )] \\\\  & =(-\\frac{5}{4}+6\\pi )-(\\frac{5}{4}+3\\pi ) \\\\  & =3\\pi -\\frac{5}{2} \\\\  & =\\frac{6\\pi -5}{2}\\end{aligned}\n$$"} :step/id #uuid "2239de45-f796-5aa0-9650-16fd55b31717" :step/next {:db/id #edb/ref 17592186544918}} {:db/id #edb/ref 17592186544918 :step/content {:db/id #edb/ref 17592186259705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13fcc3d9-e48a-542e-9d30-6b397fb1a498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186256961} {:answer/id #uuid "1869c282-abb4-524c-be28-650f45a1ebb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{53}{6}" :db/id #edb/ref 17592186256994} {:answer/id #uuid "3697d3f0-d2a9-5157-9c3a-73b0ea60e2e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{49}{8}" :db/id #edb/ref 17592186257260} {:answer/id #uuid "4a0cfb60-19ef-5381-83bb-81e635e37ad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186257429} {:answer/id #uuid "b332b886-e893-52d6-b7df-0c964a1cd0c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{42}{7}" :db/id #edb/ref 17592186258340}] :answer-field/correct {:db/id #edb/ref 17592186256994} :answer-field/id #uuid "8f64dde8-4609-5f96-b95a-2b0b8b027fbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259282}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bbd34e81-f803-5fbc-b7c5-b362f720fe60" :question/math-academy-id "q-124664" :question/problem "If the path $C$ is a part of the graph $y=2\\sqrt{x}$ traversed from the point $P(1,2)$ to point $Q(4,4),$ then ${\\int }_{C}(x-y)\\,dx+(x+y)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y=2\\sqrt{x}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j={t}^{2}\\,i+2t\\,j,\\,t\\in [1,2]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2t\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,dx+(x+y)\\,dy & ={\\int }_{1}^{2}(x-y)\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+(x+y)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}((x-y)\\,\\frac{\\text{d}x}{\\text{d}t}+(x+y)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{2}({t}^{2}-2t)\\cdot 2t+({t}^{2}+2t)\\cdot 2\\,dt \\\\  & =2{\\int }_{1}^{2}t({t}^{2}-2t)+({t}^{2}+2t)\\,dt \\\\  & =2{\\int }_{1}^{2}{t}^{3}-{t}^{2}+2t\\,dt \\\\  & =2{[\\frac{{t}^{4}}{4}-\\frac{{t}^{3}}{3}+{t}^{2}]}_{1}^{2} \\\\  & =2[(\\frac{{2}^{4}}{4}-\\frac{{2}^{3}}{3}+{2}^{2})-(\\frac{{1}^{4}}{4}-\\frac{{1}^{3}}{3}+{1}^{2})] \\\\  & =2[4-\\frac{8}{3}+4-\\frac{1}{4}+\\frac{1}{3}-1] \\\\  & =2\\cdot \\frac{53}{12} \\\\  & =\\frac{53}{6}\\end{aligned}\n$$"} :step/id #uuid "3b7fac8d-ca12-55ac-97d4-a24cb9a1ad25"} {:db/id #edb/ref 17592186544924 :step/content {:db/id #edb/ref 17592186544869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1262143b-7987-5866-b438-9f2860a6f4b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186544124} {:answer/id #uuid "1e590f80-d8cd-59b5-80b8-713187c9aae9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186544153} {:answer/id #uuid "7acbde24-d396-507e-bab6-65ef61f8c0e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186544358} {:answer/id #uuid "b92f50e1-a193-531b-b6de-1ecbee0c7393" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186544478} {:answer/id #uuid "ba6eaf80-e94b-55c5-8508-94c9b3e1a5d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186544483}] :answer-field/correct {:db/id #edb/ref 17592186544478} :answer-field/id #uuid "1c8cb632-7694-5ff5-badc-7d0d79044a59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544665}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b91bd5f9-20da-5be7-a581-8dc4f819e202" :question/math-academy-id "q-90869" :question/problem "If the path $C$ is a part of the curve $y={x}^{3}+1$ traversed from the point $A(0,1)$ to point $B(1,2),$ then ${\\int }_{C}x\\,dx+(y-1)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y={x}^{3}+1.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=t\\,i+({t}^{3}+1)\\,j,\\,t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+3{t}^{2}\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx+(y-1)\\,dy & ={\\int }_{0}^{1}x\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+(y-1)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(x\\,\\frac{\\text{d}x}{\\text{d}t}+(y-1)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\cdot 1+({t}^{3}+1-1)\\cdot 3{t}^{2}\\,dt \\\\  & ={\\int }_{0}^{1}t+3{t}^{5}\\,dt \\\\  & ={[\\frac{{t}^{2}}{2}+\\frac{{t}^{6}}{2}]}_{0}^{1} \\\\  & =[\\frac{1}{2}+\\frac{1}{2}]-[0] \\\\  & =1\\end{aligned}\n$$"} :step/id #uuid "484a8d3f-5a58-551d-b4de-89ea0f4d50be" :step/next {:db/id #edb/ref 17592186544936}} {:db/id #edb/ref 17592186544936 :step/content {:db/id #edb/ref 17592186387540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e75bdd4-9ffa-598b-ba2b-3e4718966455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\,{e}^{3\\operatorname{cos}⁡t}+3\\,\\text{d}t" :db/id #edb/ref 17592186387542} {:answer/id #uuid "d5b5e560-c25e-5180-91e9-4dd26cebdf25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}+\\sqrt{3}\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186387543} {:answer/id #uuid "9e5e8954-0ec8-5e2c-87e8-00cd2ba07083" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186387544} {:answer/id #uuid "e56c1b23-1bc1-5e37-920c-d6b5c4c83b9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /2}^{\\pi }\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{3\\operatorname{cos}⁡t}+1\\,\\text{d}t" :db/id #edb/ref 17592186387545} {:answer/id #uuid "96172456-0f12-5f8e-95b8-f6b631ca3655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{\\int }_{\\pi /2}^{\\pi }\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}+3\\,\\text{d}t" :db/id #edb/ref 17592186387546}] :answer-field/correct {:db/id #edb/ref 17592186387546} :answer-field/id #uuid "4f4769e4-af1d-5493-a3fe-c583f362931e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387541}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c8b59c59-a390-5b22-8421-70bf95742c06" :question/math-academy-id "q-124653" :question/problem "Which of the following is equivalent to ${\\int }_{C}({e}^{x}+y)\\,dx-x\\,dy,$ where $C$ is part of the circle ${x}^{2}+{y}^{2}=3$ traversed in the counterclockwise direction from the point $A(0,\\sqrt{3})$ to the point $B(-\\sqrt{3},0).$" :question/worked-solution "Since $C$ is a circle of radius $\\sqrt{3}$ centered at the origin, it can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=\\sqrt{3}\\operatorname{cos}⁡t\\,i+\\sqrt{3}\\operatorname{sin}⁡t\\,j,\\,t\\in [\\frac{\\pi }{2},\\pi ]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=-\\sqrt{3}\\operatorname{sin}⁡t\\,i+\\sqrt{3}\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({e}^{x}+y)\\,dx-x\\,dy & ={\\int }_{\\pi /2}^{\\pi }({e}^{x}+y)\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t-x\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }(({e}^{x}+y)\\,\\frac{dx}{\\text{d}t}-x\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }({e}^{\\sqrt{3}\\operatorname{cos}⁡t}+\\sqrt{3}\\operatorname{sin}⁡t)\\cdot (-\\sqrt{3}\\operatorname{sin}⁡t)-(\\sqrt{3}\\operatorname{cos}⁡t)\\cdot (\\sqrt{3}\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }-\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{\\pi }-\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}-3\\,\\text{d}t \\\\  & =-{\\int }_{\\pi /2}^{\\pi }\\sqrt{3}\\operatorname{sin}⁡t\\,{e}^{\\sqrt{3}\\operatorname{cos}⁡t}+3\\,\\text{d}t\\end{aligned}\n$$"} :step/id #uuid "6a27ed93-d9fc-5a3b-aed8-ac5ef31f0899" :step/next {:db/id #edb/ref 17592186544909}} {:db/id #edb/ref 17592186544951 :step/content {:db/id #edb/ref 17592186351250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5480a9aa-ad9e-5901-99ef-a4b557010682" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+6\\pi " :db/id #edb/ref 17592186349219} {:answer/id #uuid "9515cda8-658c-596e-82bc-d1176ae74422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+10\\pi " :db/id #edb/ref 17592186349782} {:answer/id #uuid "d708ba15-3640-5e0f-a2cc-8efebb555009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+12\\pi " :db/id #edb/ref 17592186350330} {:answer/id #uuid "e9a9cd99-2cbe-59b5-8edc-4b78ef09dc96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+14\\pi " :db/id #edb/ref 17592186350495} {:answer/id #uuid "f55e6f64-fa6a-5856-9b77-a53e676b505a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+16\\pi " :db/id #edb/ref 17592186350593}] :answer-field/correct {:db/id #edb/ref 17592186350495} :answer-field/id #uuid "2ed4da5c-67f9-5122-bb2a-f6a68757af78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350790}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bbe13972-64bc-5d76-9613-e21318b0221e" :question/math-academy-id "q-81180" :question/problem "If the path $C$ is a part of the parabola $y=\\pi {x}^{2}$ traversed from the point $A(1,\\pi )$ to point $B(2,4\\pi ),$ then ${\\int }_{C}\\operatorname{sin}⁡(\\frac{y}{2{x}^{2}})\\,dx+3x\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y=\\pi {x}^{2}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=t\\,i+\\pi {t}^{2}\\,j,\\,t\\in [1,2]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+2\\pi t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{sin}⁡(\\frac{y}{2{x}^{2}})\\,dx+3x\\,dy & ={\\int }_{1}^{2}\\operatorname{sin}⁡(\\frac{y}{2{x}^{2}})\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+3x\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}(\\operatorname{sin}⁡(\\frac{y}{2{x}^{2}})\\frac{\\text{d}x}{\\text{d}t}+3x\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{2}\\operatorname{sin}⁡(\\frac{\\pi {t}^{2}}{2{t}^{2}})\\cdot 1+3t\\cdot 2\\pi t\\,dt \\\\  & ={\\int }_{1}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})+6\\pi {t}^{2}\\,dt \\\\  & ={\\int }_{1}^{2}1+6\\pi {t}^{2}\\,dt \\\\  & =[t+2\\pi {t}^{3}]_{1}^{2} \\\\  & =[2+2\\pi (2)^{3}]-[1+2\\pi (1)^{3}] \\\\  & =[2+16\\pi ]-[1+2\\pi ] \\\\  & =1+14\\pi \\end{aligned}\n$$"} :step/id #uuid "8a50e86f-8ec5-59ae-85ff-560f47375b3d" :step/next {:db/id #edb/ref 17592186544924}}] :activity/title "Sums of Line Integrals With Respect to X and Y" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544068}]}
