  "live_records": {
    "q-79739": {
      "dom_id": "step-q79739",
      "name": "Question 1",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$",
      "calculator_instructions": "",
