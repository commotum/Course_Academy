6" #edb/ref 17592186045417] [17592186261244 #edb/ref 1080 "⟨-8,2,-11⟩" #edb/ref 17592186045417] [17592186261244 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261244 #edb/ref 1083 #uuid "9e1ed729-7d24-5fef-a919-3b87d20a7b2c" #edb/ref 17592186045417] [17592186261347 #edb/ref 1080 "r=⟨-7,12,-3⟩+s⟨-3,5,1⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186261347 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261347 #edb/ref 1083 #uuid "a8a3a0fb-37c8-5001-bfec-42aa7883b3d8" #edb/ref 17592186045417] [17592186261803 #edb/ref 1080 "⟨-2,-8,-7⟩" #edb/ref 17592186045417] [17592186261803 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261803 #edb/ref 1083 #uuid "da606c57-af3e-52fa-9552-99fdba561ef0" #edb/ref 17592186045417] [17592186262397 #edb/ref 1075 #edb/ref 17592186260203 #edb/ref 17592186045417] [17592186262397 #edb/ref 1075 #edb/ref 17592186260360 #edb/ref 17592186045417] [17592186262397 #edb/ref 1075 #edb/ref 17592186260630 #edb/ref 17592186045417] [17592186262397 #edb/ref 1075 #edb/ref 17592186260648 #edb/ref 17592186045417] [17592186262397 #edb/ref 1075 #edb/ref 17592186261347 #edb/ref 17592186045417] [17592186262397 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262397 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262397 #edb/ref 1078 #edb/ref 17592186260360 #edb/ref 17592186045417] [17592186262397 #edb/ref 1079 #uuid "991622fb-4bb5-597a-a633-df7720b54e4a" #edb/ref 17592186045417] [17592186262532 #edb/ref 1075 #edb/ref 17592186260257 #edb/ref 17592186045417] [17592186262532 #edb/ref 1075 #edb/ref 17592186260737 #edb/ref 17592186045417] [17592186262532 #edb/ref 1075 #edb/ref 17592186261175 #edb/ref 17592186045417] [17592186262532 #edb/ref 1075 #edb/ref 17592186261244 #edb/ref 17592186045417] [17592186262532 #edb/ref 1075 #edb/ref 17592186261803 #edb/ref 17592186045417] [17592186262532 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262532 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262532 #edb/ref 1078 #edb/ref 17592186261175 #edb/ref 17592186045417] [17592186262532 #edb/ref 1079 #uuid "e859b94c-82b3-57fc-b159-f1a0791b5216" #edb/ref 17592186045417] [17592186262916 #edb/ref 1068 #edb/ref 17592186262532 #edb/ref 17592186045417] [17592186262916 #edb/ref 1069 "q-128497" #edb/ref 17592186045417] [17592186262916 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186262916 #edb/ref 1071 "Find a normal vector to the plane\n\n$$\nr=⟨3,\\sqrt{7},-2⟩+t⟨-2,8,0⟩+s⟨3,-1,-1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" #edb/ref 17592186045417] [17592186262916 #edb/ref 1072 #uuid "58d7da64-39e5-5263-82e1-d46d43bc9c9d" #edb/ref 17592186045417] [17592186262916 #edb/ref 1074 "From the parametric equation, we have that $v=⟨-2,8,0⟩$ and $w=⟨3,-1,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -2 & 8 & 0 \\\\ 3 & -1 & -1\\end{aligned}\\right| \\\\  & =-8i-2j-22k \\\\  & =⟨-8,-2,-22⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-8,-2,-22⟩.$" #edb/ref 17592186045417] [17592186262922 #edb/ref 1068 #edb/ref 17592186262397 #edb/ref 17592186045417] [17592186262922 #edb/ref 1069 "q-128536" #edb/ref 17592186045417] [17592186262922 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186262922 #edb/ref 1071 "Find a parametric equation of the plane that passes through the point $B(-7,12,-3)$ and is parallel to the lines $r=⟨-7,2,4⟩+s⟨-5,3,1⟩$ and $r=⟨-22,17,13⟩+t⟨1,5,6⟩.$" #edb/ref 17592186045417] [17592186262922 #edb/ref 1072 #uuid "75465043-c7d7-54b7-b914-8b78a961bb97" #edb/ref 17592186045417] [17592186262922 #edb/ref 1074 "The direction vectors of the lines are ${v}_{1}=⟨-5,3,1⟩$ and ${v}_{2}=⟨1,5,6⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-7,12,-3)$ lies on the plane and its position vector is $b=⟨-7,12,-3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$" #edb/ref 17592186045417] [17592186336052 #edb/ref 1080 "⟨1,2,-1⟩" #edb/ref 17592186045417] [17592186336052 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336052 #edb/ref 1083 #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" #edb/ref 17592186045417] [17592186336439 #edb/ref 1080 "⟨-5,3,1⟩" #edb/ref 17592186045417] [17592186336439 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336439 #edb/ref 1083 #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" #edb/ref 17592186045417] [17592186336605 #edb/ref 1080 "⟨-5,3,0⟩" #edb/ref 17592186045417] [17592186336605 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336605 #edb/ref 1083 #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" #edb/ref 17592186045417] [17592186337090 #edb/ref 1080 "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186337090 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337090 #edb/ref 1083 #uuid "7586c1e4-84f3-5128-898b-c5e464276c0d" #edb/ref 17592186045417] [17592186337221 #edb/ref 1080 "r=⟨4,-1,5⟩+s⟨6,2,1⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186337221 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337221 #edb/ref 1083 #uuid "82d1d2de-9e64-5f24-9d44-872a4f4b17ad" #edb/ref 17592186045417] [17592186337243 #edb/ref 1080 "r=⟨0,2,3⟩+s⟨4,-1,5⟩+t⟨6,2,1⟩,\\,s,t\\in (-\\infty ,\\infty )" #edb/ref 17592186045417] [17592186337243 #edb/ref 1082 #edb/ref 175921860