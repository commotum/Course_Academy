#{[{:db/id #edb/ref 17592186262916 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b4a3c41-2d3e-5406-a2cd-cbab49cb529e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-4,-26⟩" :db/id #edb/ref 17592186260257} {:answer/id #uuid "63d710f5-99cb-53b4-8290-6299023ee722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,-2,17⟩" :db/id #edb/ref 17592186260737} {:answer/id #uuid "95c11743-7580-55cc-a7f1-587f795b6ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186261175} {:answer/id #uuid "9e1ed729-7d24-5fef-a919-3b87d20a7b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,2,-11⟩" :db/id #edb/ref 17592186261244} {:answer/id #uuid "da606c57-af3e-52fa-9552-99fdba561ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-8,-7⟩" :db/id #edb/ref 17592186261803}] :answer-field/correct {:answer/id #uuid "95c11743-7580-55cc-a7f1-587f795b6ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186261175} :answer-field/id #uuid "e859b94c-82b3-57fc-b159-f1a0791b5216" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58d7da64-39e5-5263-82e1-d46d43bc9c9d" :question/math-academy-id "q-128497" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,\\sqrt{7},-2⟩+t⟨-2,8,0⟩+s⟨3,-1,-1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-2,8,0⟩$ and $w=⟨3,-1,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -2 & 8 & 0 \\\\ 3 & -1 & -1\\end{aligned}\\right| \\\\  & =-8i-2j-22k \\\\  & =⟨-8,-2,-22⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-8,-2,-22⟩.$"}] [{:db/id #edb/ref 17592186262922 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259294bf-42a6-5b1f-a914-2eeba4786e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,12,-7⟩+s⟨1,3,-5⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260203} {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} {:answer/id #uuid "586437d1-d3c1-5c04-82a5-9e97897d0755" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,-3,12⟩+s⟨-3,4,2⟩+t⟨1,5,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260630} {:answer/id #uuid "5a80a400-edf2-5ed4-95ef-bc093dec6a28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,-3,12⟩+s⟨3,3,1⟩+t⟨1,5,7⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260648} {:answer/id #uuid "a8a3a0fb-37c8-5001-bfec-42aa7883b3d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-3,5,1⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261347}] :answer-field/correct {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} :answer-field/id #uuid "991622fb-4bb5-597a-a633-df7720b54e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262397}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75465043-c7d7-54b7-b914-8b78a961bb97" :question/math-academy-id "q-128536" :question/problem "Find a parametric equation of the plane that passes through the point $B(-7,12,-3)$ and is parallel to the lines $r=⟨-7,2,4⟩+s⟨-5,3,1⟩$ and $r=⟨-22,17,13⟩+t⟨1,5,6⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-5,3,1⟩$ and ${v}_{2}=⟨1,5,6⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-7,12,-3)$ lies on the plane and its position vector is $b=⟨-7,12,-3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"}] [{:db/id #edb/ref 17592186391682 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e02ac0-3e89-5c73-aee7-9f2de3148d7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,2,-2⟩" :db/id #edb/ref 17592186391684} {:answer/id #uuid "8ffc566d-8d4c-53c3-af4b-b2d7a4d35946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,1,0⟩" :db/id #edb/ref 17592186391685} {:answer/id #uuid "efc39529-4f0f-5e00-b796-0c632007c03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,0,2⟩" :db/id #edb/ref 17592186391686} {:answer/id #uuid "f83846d5-42d7-540e-ad5c-05350b13e9fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-2,-2⟩" :db/id #edb/ref 17592186391687} {:answer/id #uuid "0693f405-c3d1-5022-a785-4b3d44119374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,1,1⟩" :db/id #edb/ref 17592186391688}] :answer-field/correct {:answer/id #uuid "23e02ac0-3e89-5c73-aee7-9f2de3148d7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,2,-2⟩" :db/id #edb/ref 17592186391684} :answer-field/id #uuid "8aebbae6-4b97-5e3f-9a17-15682100023d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391683}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b07ac22-3309-5bc0-ac4b-6e1be0e5a45e" :question/math-academy-id "q-33823" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨1,1,0⟩+t⟨-1,1,1⟩+s⟨0,2,2⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-1,1,1⟩$ and $w=⟨0,2,2⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}\\right| \\\\  & =2j-2k \\\\  & =⟨0,2,-2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨0,2,-2⟩.$"}] [{:db/id #edb/ref 17592186393057 :knowledge-point/_questions [{:db/id #edb/ref 17592186119935 :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840901d2-388a-56b4-b2ed-4aa835792fb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393059} {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} {:answer/id #uuid "a9567360-7eeb-5790-a68a-54789a38c8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393061} {:answer/id #uuid "0abc7499-ef02-5049-b4d5-92446ade1dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393062} {:answer/id #uuid "d56ba868-cc5e-5eb8-8190-756b44636c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393063}] :answer-field/correct {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} :answer-field/id #uuid "74bd7e12-82f3-5b83-88f9-1acb2c12ad74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186429941 :knowledge-point/_questions [{:db/id #edb/ref 17592186119936 :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076c0841-49e0-5efa-932b-cea12451f354" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429935} {:answer/id #uuid "36f17219-1319-57b9-b736-3daca3fe9f64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-2,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429936} {:answer/id #uuid "42182090-ca90-5aff-919b-f97f28d17f45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429937} {:answer/id #uuid "a639639c-9709-5ea4-b9d7-eed8e4f97ee2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186429938} {:answer/id #uuid "dd4f3967-0094-5670-b34b-c4d617495978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,0,-2⟩+s⟨-2,4,3⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429939}] :answer-field/correct {:answer/id #uuid "42182090-ca90-5aff-919b-f97f28d17f45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429937} :answer-field/id #uuid "918bca49-2085-5b3c-9bbd-1ed60948277f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186429940}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e59ecbbf-3ac2-51fb-8da8-83763d787a9a" :question/math-academy-id "q-71033" :question/problem "Find a parametric equation of the plane that passes through the points $D(1,0,-2),\\,E(-2,-2,5)$, and $F(-2,4,3).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨-2,-2,5⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,-2,7⟩ \\\\ \\overset{\\to }{DF} & =⟨-2,4,3⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,4,5⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $d=⟨1,0,-2⟩$ of the point $D,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s\\overset{\\to }{DE}+t\\overset{\\to }{DF} \\\\ r & =⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}]}
