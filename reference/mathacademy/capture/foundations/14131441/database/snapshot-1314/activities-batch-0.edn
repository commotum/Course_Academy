#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186120897} :activity/id #uuid "4a64e93c-7c38-5a2c-bcd0-c1efea32558e" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186120897 :step/content {:db/id #edb/ref 17592186121051 :tutorial/content "Any plane can be uniquely determined by a point and two non-parallel direction vectors. For example, let $\\Pi$ be the plane that passes through the point $P(1,0,2)$ and is parallel to the vectors $\\mathbf{b}= \\langle 0,3,0 \\rangle$  and $\\mathbf{c}= \\langle -1,1,1 \\rangle.$\n\n![](images/ea/ea4ce822abec2b68d2471a2787f4e045493ca43c1c6795a7e0069de80cb5adee.png)\n\nUsing the vectors $\\mathbf{b}$ and $\\mathbf{c},$ we can construct a **parametric equation** of the plane.\n\nFirst, let $R$ be any general point in the plane, with position vector $\\mathbf{r}.$ Notice that we can get from $P$ to $R$ using a linear combination of $\\mathbf{b}$ and $\\mathbf{c}$ with some (unknown for us) coefficients $s$ and $t$, as shown below.\n\n![](images/b4/b40f91c3d75f092c7b29f19770364e7518d37b64ba594a311a762ad79a950e4f.png)\n\nSo, we can write the **parametric equation** of the plane as\n\n$$\n{\\color{red}\\mathbf{r}} = \\mathbf{p}+s{\\color{blue}\\,\\mathbf{b}}+t\\,{\\color{blue}\\mathbf{c}},\n\t\\qquad s,t \\in (-\\infty,\\infty).\n$$\n\nThis formula works whenever $\\mathbf{b}$ and $\\mathbf{c}$ are not parallel.\n\nIn our case, $\\mathbf{b}$ and $\\mathbf{c}$ are indeed not parallel to each other. So, using column vector notation, the parametric equation for the plane $\\Pi$ is given by\n![](images/0d/0d40f8f87e1ed3f3bf5040e925e545169f5528f32cf8dd0052375aa560cc1381.svg)" :tutorial/id #uuid "2828346e-3bca-51a8-a6ef-a86ca7034a62" :tutorial/math-academy-id 3257 :tutorial/title "Introduction"} :step/id #uuid "9e58d46a-ae91-5ee2-88e7-83dddd91cd81" :step/math-academy-id 421992 :step/next {:db/id #edb/ref 17592186120898}} {:db/id #edb/ref 17592186120898 :step/content {:db/id #edb/ref 17592186119933 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119647 :question/id #uuid "a6fded96-287a-53ee-8b1c-dd618562b2c2" :question/math-academy-id "e-4940"} :knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120234} {:db/id #edb/ref 17592186120235} {:db/id #edb/ref 17592186262902} {:db/id #edb/ref 17592186262903} {:db/id #edb/ref 17592186262904} {:db/id #edb/ref 17592186304903} {:db/id #edb/ref 17592186338858} {:db/id #edb/ref 17592186338859} {:db/id #edb/ref 17592186338860} {:db/id #edb/ref 17592186338861} {:db/id #edb/ref 17592186410898} {:db/id #edb/ref 17592186410901} {:db/id #edb/ref 17592186410902}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"} :step/id #uuid "9f747cb6-7704-53df-bc68-9a201f538aa3" :step/math-academy-id 421993 :step/next {:db/id #edb/ref 17592186120899}} {:db/id #edb/ref 17592186120899 :step/content {:db/id #edb/ref 17592186119934 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119664 :question/id #uuid "b86eace4-01cb-5601-8e9b-2658e81fc656" :question/math-academy-id "e-5884"} :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049132}] :knowledge-point/questions [{:db/id #edb/ref 17592186120277} {:db/id #edb/ref 17592186120278} {:db/id #edb/ref 17592186262915} {:db/id #edb/ref 17592186262916} {:db/id #edb/ref 17592186311921} {:db/id #edb/ref 17592186311922} {:db/id #edb/ref 17592186311923} {:db/id #edb/ref 17592186338862} {:db/id #edb/ref 17592186338863} {:db/id #edb/ref 17592186391682} {:db/id #edb/ref 17592186410899} {:db/id #edb/ref 17592186429817}] :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"} :step/id #uuid "aa340a23-a5f7-53c0-a279-cfaa2cb34f68" :step/math-academy-id 421996 :step/next {:db/id #edb/ref 17592186120900}} {:db/id #edb/ref 17592186120900 :step/content {:db/id #edb/ref 17592186119935 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119648 :question/id #uuid "297bda8f-6e33-5cc2-a2e1-5ab6186fa9d0" :question/math-academy-id "e-4941"} :knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/questions [{:db/id #edb/ref 17592186120225} {:db/id #edb/ref 17592186120236} {:db/id #edb/ref 17592186262922} {:db/id #edb/ref 17592186338864} {:db/id #edb/ref 17592186338865} {:db/id #edb/ref 17592186338866} {:db/id #edb/ref 17592186364961} {:db/id #edb/ref 17592186387887} {:db/id #edb/ref 17592186393057} {:db/id #edb/ref 17592186398347}] :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"} :step/id #uuid "0b7d4f28-8841-5518-ad36-74e1aa0d9163" :step/math-academy-id 421999 :step/next {:db/id #edb/ref 17592186120901}} {:db/id #edb/ref 17592186120901 :step/content {:db/id #edb/ref 17592186121052 :tutorial/content "Any plane can be uniquely determined by three non-collinear points. \n\n![](images/08/08e65c4e3465a4bf155dfed6bc0dc2a35bf2eb9326d9bff0c0aa75b86e97d76b.png)\n\nTo write down a parametric equation of the plane, the trick is to use the three non-collinear points to construct two displacement vectors that are parallel to the plane.\n\n![](images/16/1613ea9df76b637b93e0e4b38b70b87892140398eaa7aaccb74f2a5642124dfd.png)\n\nThen we can proceed as usual to find the equation of the plane. Let's practice this technique in the following example." :tutorial/id #uuid "e32f2dc4-38f6-541d-9dc6-9cfd1ac079eb" :tutorial/math-academy-id 3258 :tutorial/title "Finding the Equation of a Plane Passing Through Three Points"} :step/id #uuid "43769a60-5b42-5a2c-82fa-0054a159b437" :step/math-academy-id 422002 :step/next {:db/id #edb/ref 17592186120902}} {:db/id #edb/ref 17592186120902 :step/content {:db/id #edb/ref 17592186119936 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119649 :question/id #uuid "9c36ddd5-fcf1-5c4d-a350-aa8ef3a3ca9e" :question/math-academy-id "e-4942"} :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/questions [{:db/id #edb/ref 17592186120218} {:db/id #edb/ref 17592186120219} {:db/id #edb/ref 17592186262927} {:db/id #edb/ref 17592186262928} {:db/id #edb/ref 17592186262929} {:db/id #edb/ref 17592186304926} {:db/id #edb/ref 17592186338879} {:db/id #edb/ref 17592186338881} {:db/id #edb/ref 17592186366205} {:db/id #edb/ref 17592186387957} {:db/id #edb/ref 17592186387964} {:db/id #edb/ref 17592186393064} {:db/id #edb/ref 17592186410900} {:db/id #edb/ref 17592186429941}] :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"} :step/id #uuid "a2d3f79a-dc28-5d90-9d1f-404334ec9529" :step/math-academy-id 422003}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120017}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186423364} :activity/id #uuid "3089dbbe-cc2f-5f60-8b4c-786b3272c8cf" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186423364 :step/content {:db/id #edb/ref 17592186120225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd010f61-f497-566f-ac0f-c50c695f2870" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390876} {:answer/id #uuid "e4fe09e5-ac83-5e62-97ff-7cc91f6b67c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨0,6,2⟩+s⟨3,2,5⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390877} {:answer/id #uuid "5b991d71-53b1-55cf-8e90-ebe111f71f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390878} {:answer/id #uuid "c86fee90-6ade-5c0b-9714-4278894c742b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390879} {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390880}] :answer-field/correct {:db/id #edb/ref 17592186390880} :answer-field/id #uuid "cf886e4d-3534-5b42-92f4-88d2e9d1dbe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186390875}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "2f9f2ed5-353f-52bf-a2a3-853d4a9582d6" :step/next {:db/id #edb/ref 17592186423365}} {:db/id #edb/ref 17592186423365 :step/content {:db/id #edb/ref 17592186338862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186336052} {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} {:answer/id #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186336605} {:answer/id #uuid "924674c9-4ac4-5fac-bce9-febfcdbeeeee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186337359} {:answer/id #uuid "faf5ff12-8cff-5606-9806-8c51dfe352b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186338232}] :answer-field/correct {:db/id #edb/ref 17592186336439} :answer-field/id #uuid "0006422d-58d9-51c7-8d8f-f4fd7450f036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338278}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2e1c378-a183-516b-92fd-1753dcbc375f" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"} :step/id #uuid "43654397-35b1-5e26-a4f3-f83c5d045414" :step/next {:db/id #edb/ref 17592186423366}} {:db/id #edb/ref 17592186423366 :step/content {:db/id #edb/ref 17592186338865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7586c1e4-84f3-5128-898b-c5e464276c0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337090} {:answer/id #uuid "82d1d2de-9e64-5f24-9d44-872a4f4b17ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨4,-1,5⟩+s⟨6,2,1⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337221} {:answer/id #uuid "85ed694c-09f9-5528-8f94-aa3dcea698e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨0,2,3⟩+s⟨4,-1,5⟩+t⟨6,2,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337243} {:answer/id #uuid "9294f976-ff7c-58c2-93a2-681c99675cba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186337366} {:answer/id #uuid "d0355145-d653-5b7e-b879-a79de4840c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨6,2,1⟩+s⟨\\frac{1}{2},1,9⟩+t⟨3,10,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337854}] :answer-field/correct {:db/id #edb/ref 17592186337090} :answer-field/id #uuid "cb6f8717-8af1-5d47-bcaf-6f6357145f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186338642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63af645f-746e-5e92-b7a0-0217edd376c0" :question/math-academy-id "q-70977" :question/problem "Find a parametric equation of the plane that passes through the point $D(6,2,1)$ and is parallel to the lines $r=⟨\\frac{1}{2},1,9⟩+s⟨4,-1,5⟩$ and $r=⟨\\sqrt{3},10,-1⟩+t⟨0,2,3⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨4,-1,5⟩$ and ${v}_{2}=⟨0,2,3⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $D(6,2,1)$ lies on the plane and its position vector is $d=⟨6,2,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s{v}_{1}+t{v}_{2} \\\\ r & =⟨6,2,1⟩+s⟨4,-1,5⟩+t⟨0,2,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "f22fda97-7410-513e-bdd3-694b01fc4928"}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423363}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186429946} :activity/id #uuid "f1f3e620-4475-5a3a-a265-6ab29906aca2" :activity/scope {:db/id #edb/ref 17592186050308 :topic/id #uuid "3ec7e468-923a-5188-be34-311799abe7bd" :topic/math-academy-id 1806} :activity/steps [{:db/id #edb/ref 17592186429942 :step/content {:db/id #edb/ref 17592186393057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840901d2-388a-56b4-b2ed-4aa835792fb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393059} {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393060} {:answer/id #uuid "a9567360-7eeb-5790-a68a-54789a38c8f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393061} {:answer/id #uuid "0abc7499-ef02-5049-b4d5-92446ade1dde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393062} {:answer/id #uuid "d56ba868-cc5e-5eb8-8190-756b44636c16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393063}] :answer-field/correct {:db/id #edb/ref 17592186393060} :answer-field/id #uuid "74bd7e12-82f3-5b83-88f9-1acb2c12ad74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "6962e54d-afff-5346-b8ad-2f0747169762" :step/next {:db/id #edb/ref 17592186429943}} {:db/id #edb/ref 17592186429943 :step/content {:db/id #edb/ref 17592186429941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076c0841-49e0-5efa-932b-cea12451f354" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429935} {:answer/id #uuid "36f17219-1319-57b9-b736-3daca3fe9f64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,-2,5⟩+t⟨-2,4,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429936} {:answer/id #uuid "42182090-ca90-5aff-919b-f97f28d17f45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429937} {:answer/id #uuid "a639639c-9709-5ea4-b9d7-eed8e4f97ee2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The plane is undefined" :db/id #edb/ref 17592186429938} {:answer/id #uuid "dd4f3967-0094-5670-b34b-c4d617495978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨1,0,-2⟩+s⟨-2,4,3⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186429939}] :answer-field/correct {:db/id #edb/ref 17592186429937} :answer-field/id #uuid "918bca49-2085-5b3c-9bbd-1ed60948277f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186429940}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e59ecbbf-3ac2-51fb-8da8-83763d787a9a" :question/math-academy-id "q-71033" :question/problem "Find a parametric equation of the plane that passes through the points $D(1,0,-2),\\,E(-2,-2,5)$, and $F(-2,4,3).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨-2,-2,5⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,-2,7⟩ \\\\ \\overset{\\to }{DF} & =⟨-2,4,3⟩-⟨1,0,-2⟩ \\\\  & =⟨-3,4,5⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $d=⟨1,0,-2⟩$ of the point $D,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =d+s\\overset{\\to }{DE}+t\\overset{\\to }{DF} \\\\ r & =⟨1,0,-2⟩+s⟨-3,-2,7⟩+t⟨-3,4,5⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :step/id #uuid "80c6a6f7-a534-55d9-a6a9-83c73859670a" :step/next {:db/id #edb/ref 17592186429944}} {:db/id #edb/ref 17592186429944 :step/content {:db/id #edb/ref 17592186262916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b4a3c41-2d3e-5406-a2cd-cbab49cb529e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨6,-4,-26⟩" :db/id #edb/ref 17592186260257} {:answer/id #uuid "63d710f5-99cb-53b4-8290-6299023ee722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8,-2,17⟩" :db/id #edb/ref 17592186260737} {:answer/id #uuid "95c11743-7580-55cc-a7f1-587f795b6ee6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,-2,-22⟩" :db/id #edb/ref 17592186261175} {:answer/id #uuid "9e1ed729-7d24-5fef-a919-3b87d20a7b2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-8,2,-11⟩" :db/id #edb/ref 17592186261244} {:answer/id #uuid "da606c57-af3e-52fa-9552-99fdba561ef0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-2,-8,-7⟩" :db/id #edb/ref 17592186261803}] :answer-field/correct {:db/id #edb/ref 17592186261175} :answer-field/id #uuid "e859b94c-82b3-57fc-b159-f1a0791b5216" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262532}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "58d7da64-39e5-5263-82e1-d46d43bc9c9d" :question/math-academy-id "q-128497" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨3,\\sqrt{7},-2⟩+t⟨-2,8,0⟩+s⟨3,-1,-1⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-2,8,0⟩$ and $w=⟨3,-1,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-2 \\\\ 8 \\\\ 0\\end{aligned}]\\times [\\begin{aligned}3 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -2 & 8 & 0 \\\\ 3 & -1 & -1\\end{aligned}\\right| \\\\  & =-8i-2j-22k \\\\  & =⟨-8,-2,-22⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-8,-2,-22⟩.$"} :step/id #uuid "87cee5fb-f33c-5202-a9b9-1f5b449bede4" :step/next {:db/id #edb/ref 17592186429945}} {:db/id #edb/ref 17592186429945 :step/content {:db/id #edb/ref 17592186262922 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "259294bf-42a6-5b1f-a914-2eeba4786e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-3,12,-7⟩+s⟨1,3,-5⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260203} {:answer/id #uuid "3660d937-cc87-5a73-a31f-13375df8d401" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260360} {:answer/id #uuid "586437d1-d3c1-5c04-82a5-9e97897d0755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,-3,12⟩+s⟨-3,4,2⟩+t⟨1,5,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260630} {:answer/id #uuid "5a80a400-edf2-5ed4-95ef-bc093dec6a28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,-3,12⟩+s⟨3,3,1⟩+t⟨1,5,7⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186260648} {:answer/id #uuid "a8a3a0fb-37c8-5001-bfec-42aa7883b3d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨-7,12,-3⟩+s⟨-3,5,1⟩+t⟨1,6,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186261347}] :answer-field/correct {:db/id #edb/ref 17592186260360} :answer-field/id #uuid "991622fb-4bb5-597a-a633-df7720b54e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262397}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75465043-c7d7-54b7-b914-8b78a961bb97" :question/math-academy-id "q-128536" :question/problem "Find a parametric equation of the plane that passes through the point $B(-7,12,-3)$ and is parallel to the lines $r=⟨-7,2,4⟩+s⟨-5,3,1⟩$ and $r=⟨-22,17,13⟩+t⟨1,5,6⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-5,3,1⟩$ and ${v}_{2}=⟨1,5,6⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $B(-7,12,-3)$ lies on the plane and its position vector is $b=⟨-7,12,-3⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =b+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-7,12,-3⟩+s⟨-5,3,1⟩+t⟨1,5,6⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n$$\n\n$$"} :step/id #uuid "a96d0f38-f22e-54d6-9800-3b945209e167"} {:db/id #edb/ref 17592186429946 :step/content {:db/id #edb/ref 17592186391682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e02ac0-3e89-5c73-aee7-9f2de3148d7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,2,-2⟩" :db/id #edb/ref 17592186391684} {:answer/id #uuid "8ffc566d-8d4c-53c3-af4b-b2d7a4d35946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,1,0⟩" :db/id #edb/ref 17592186391685} {:answer/id #uuid "efc39529-4f0f-5e00-b796-0c632007c03e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-2,0,2⟩" :db/id #edb/ref 17592186391686} {:answer/id #uuid "f83846d5-42d7-540e-ad5c-05350b13e9fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,-2,-2⟩" :db/id #edb/ref 17592186391687} {:answer/id #uuid "0693f405-c3d1-5022-a785-4b3d44119374" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-1,1,1⟩" :db/id #edb/ref 17592186391688}] :answer-field/correct {:db/id #edb/ref 17592186391684} :answer-field/id #uuid "8aebbae6-4b97-5e3f-9a17-15682100023d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186391683}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b07ac22-3309-5bc0-ac4b-6e1be0e5a45e" :question/math-academy-id "q-33823" :question/problem "Find a normal vector to the plane\n\n$$\nr=⟨1,1,0⟩+t⟨-1,1,1⟩+s⟨0,2,2⟩,\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨-1,1,1⟩$ and $w=⟨0,2,2⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}\\right| \\\\  & =2j-2k \\\\  & =⟨0,2,-2⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨0,2,-2⟩.$"} :step/id #uuid "b87c320e-e438-5e5e-b4bc-c722b9da8264" :step/next {:db/id #edb/ref 17592186429942}}] :activity/title "The Parametric Equations of a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186429934}]}
