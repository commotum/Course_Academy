5417] [17592186119963 #edb/ref 1042 #uuid "88990b12-e7e0-5e21-9000-45357c07d04d" #edb/ref 17592186045417] [17592186119964 #edb/ref 1037 #edb/ref 17592186048430 #edb/ref 17592186045417] [17592186119964 #edb/ref 1037 #edb/ref 17592186049442 #edb/ref 17592186045417] [17592186119964 #edb/ref 1037 #edb/ref 17592186050392 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186120258 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186120263 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311735 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311742 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311743 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311744 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311746 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186311759 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186377270 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186377273 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186441931 #edb/ref 17592186045417] [17592186119964 #edb/ref 1038 #edb/ref 17592186441932 #edb/ref 17592186045417] [17592186119964 #edb/ref 1039 "Solving an Equation Governing the Current in an RL Circuit: Sinusoidal EMF" #edb/ref 17592186045417] [17592186119964 #edb/ref 1041 #edb/ref 17592186119543 #edb/ref 17592186045417] [17592186119964 #edb/ref 1042 #uuid "618f0ac5-e21a-5916-85f1-fbdeee648119" #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120942 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120943 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120944 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120945 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120946 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120947 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120948 #edb/ref 17592186045417] [17592186120008 #edb/ref 1043 #edb/ref 17592186120960 #edb/ref 17592186045417] [17592186120008 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186120008 #edb/ref 1045 "Modeling RL Circuits With First-Order ODEs" #edb/ref 17592186045417] [17592186120008 #edb/ref 1046 #edb/ref 17592186120942 #edb/ref 17592186045417] [17592186120008 #edb/ref 1049 #edb/ref 17592186051040 #edb/ref 17592186045417] [17592186120008 #edb/ref 1050 1320.0 #edb/ref 17592186045417] [17592186120008 #edb/ref 1053 #uuid "c4822993-aaa8-5b57-a495-e95fef0a8388" #edb/ref 17592186045417] [17592186120263 #edb/ref 1068 #edb/ref 17592186117722 #edb/ref 17592186045417] [17592186120263 #edb/ref 1069 "q-336463" #edb/ref 17592186045417] [17592186120263 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120263 #edb/ref 1071 "![](images/ea/ea1eb590e18a85672f176188f1bab96d85eb1be92d43edd322d1d032500a97ac.png)\n\nConsider the RL circuit shown above. Given that the current $I(t)$ at time $t$ seconds is given by\n\n$$\nI(t)=A{e}^{-14t}+\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t),\n$$\n\nwhere $A,$ $\\alpha ,$ and $\\beta $ are constants, find the value of $\\alpha +\\beta .$" #edb/ref 17592186045417] [17592186120263 #edb/ref 1072 #uuid "d82ca13b-67a8-5070-a065-c95927f9b6d4" #edb/ref 17592186045417] [17592186120263 #edb/ref 1073 true #edb/ref 17592186045417] [17592186120263 #edb/ref 1074 "The diagram shows a series RL circuit with a source electromotive force (EMF) of $3\\operatorname{sin}⁡(2t)\\,\\text{V},$ a resistor of resistance $7\\,Ω,$ and an inductor of inductance $\\frac{1}{2}\\,\\text{H}.$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=7\\,Ω.$\n\n$$\n{V}_{R}=7I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=\\frac{1}{2}\\,\\text{H}.$\n\n$$\n{V}_{L}=\\frac{1}{2}\\cdot \\frac{dI}{dt}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n3\\operatorname{sin}⁡(2t)=7I+\\frac{1}{2}\\cdot \\frac{dI}{dt}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dI}{dt}+14I=6\\operatorname{sin}⁡(2t).\n$$\n\nThis is a first-order linear equation with constant coefficients. So, to find the general solution, we must find the sum of the complementary and particular solutions.\n\n- To find the complementary solution ${I}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{I}_{c}}{dt}+14{I}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{I}_{c}(t)=A{e}^{-14t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $2t.$ So, we assume that the particular solution is also sinusoidal with argument $2t,$ i.e.,\n\n$$\n{I}_{p}(t)=\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t).\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute\n\n$$\n\\begin{aligned}{I}_{p} & =\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t), \\\\ \\frac{d{I}_{p}}{dt} & =-2\\alpha \\operatorname{sin}⁡(2t)+2\\beta \\operatorname{cos}⁡(2t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}(-2\\alpha \\operatorname{sin}⁡(2t)+2\\beta \\operatorname{cos}⁡(2t))+14(\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t)) & =6\\operatorname{sin}⁡(2t) \\\\ 2(-\\alpha +7\\beta )\\operatorname{sin}⁡(2t)+2(7\\alpha +\\beta )\\operatorname{cos}⁡(2t) & =6\\operatorname{sin}⁡(2t) \\\\ (-\\alpha +7\\beta )\\operatorname{sin}⁡(2t)+(7\\alpha +\\beta )\\operatorname{cos}⁡(2t) & =3\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\{\\begin{aligned}-\\alpha +7\\beta =3\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(2t)) \\\\ 7\\alpha +\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(2t))\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{3}{50},$ $\\beta =\\frac{21}{50}.$ Therefore, the particular solution is\n\n$$\n{I}_{p}(t)=-\\frac{3}{50}\\operatorname{cos}⁡(2t)+\\frac{21}{50}\\operatorname{sin}⁡(2t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t)={I}_{c}(t)+{I}_{p}(t)=A{e}^{-14t}-\\frac{3}{50}\\operatorname{cos}⁡(2t)+\\frac{21}{50}\\operatorname{sin}⁡(2t).\n$$\n\nTherefore, we have\n\n$$\n\\alpha =-\\frac{3}{50},\\,\\beta =\\frac{21}{50}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\\alpha +\\beta  & =-\\frac{3}{50}+\\frac{21}{50} \\\\  & =\\frac{18}{50} \\\\  & =\\frac{9}{25}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120942 #edb/ref 1058 #edb/ref 17592186120960 #edb/ref 17592186045417] [17592186120942 #edb/ref 1061 589205 #edb/ref 17592186045417] [17592186120942 #edb/ref 1062 #uuid "7f52605e-6a3c-5b85-9c20-17d25d7c35d3" #edb/ref 17592186045417] [17592186120942 #edb/ref 1063 #edb/ref 17592186120980 #edb/ref 17592186045417] [17592186120943 #edb/ref 1058 #edb/ref 17592186120944 #edb/ref 17592186045417] [17592186120943 #edb/ref 1061 589206 #edb/ref 17592186045417] [17592186120943 #edb/ref 1062 #uuid "d401f32c-c875-58bb-bc9f-0373d3944885" #edb/ref 17592186045417] [17592186120943 #edb/ref 1063 #edb/ref 17592186120981 #edb/ref 17592186045417] [17592186120944 #edb/ref 1058 #edb/ref 17592186120945 #edb/ref 17592186045417] [17592186120944 #edb/ref 1061 589207 #edb/ref 17592186045417] [17592186120944 #edb/ref 1062 #uuid "8a75cdaf-9cea-5ed6-a4a5-e52dd16330a3" #edb/ref 17592186045417] [17592186120944 #edb/ref 1063 #edb/ref 17592186119962 #edb/ref 17592186045417] [17592186120945 #edb/ref 1058 #edb/ref 17592186120946 #edb/ref 17592186045417] [17592186120945 #edb/ref 1061 589210 #edb/ref 17592186045417] [17592186120945 #edb/ref 1062 #uuid "c18fa2c7-f455-52a1-9d15-2af89c7b3387" #edb/ref 17592186045417] [17592186120945 #edb/ref 1063 #edb/ref 17592186120984 #edb/ref 17592186045417] [17592186120946 #edb/ref 1058 #edb/ref 17592186120947 #edb/ref 17592186045417] [17592186120946 #edb/ref 1061 589211 #edb/ref 17592186045417] [17592186120946 #edb/ref 1062 #uuid "89feae66-82e8-5242-981f-f9b7e94d4e27" #edb/ref 17592186045417] [17592186120946 #edb/ref 1063 #edb/ref 17592186119963 #edb/ref 17592186045417] [17592186120947 #edb/ref 1058 #edb/ref 17592186120948 #edb/ref 17592186045417] [17592186120947 #edb/ref 1061 589215 #edb/ref 17592186045417] [17592186120947 #edb/ref 1062 #uuid "1071dff8-b74d-5864-ade1-84d518b3c702" #edb/ref 17592186045417] [17592186120947 #edb/ref 1063 #edb/ref 17592186120983 #edb/ref 17592186045417] [17592186120948 #edb/ref 1061 589216 #edb/ref 17592186045417] [17592186120948 #edb/ref 1062 #uuid "9457cf05-1395-5f80-89f3-a0f5a2865931" #edb/ref 17592186045417] [17592186120948 #edb/ref 1063 #edb/ref 17592186119964 #edb/ref 17592186045417] [17592186120960 #edb/ref 1058 #edb/ref 17592186120943 #edb/ref 17592186045417] [17592186120960 #edb/ref 1061 608075 #edb/ref 17592186045417] [17592186120960 #edb/ref 1062 #uuid "6bd5d887-600b-5c39-9f37-c936cf2ce2ef" #edb/ref 17592186045417] [17592186120960 #edb/ref 1063 #edb/ref 17592186120989 #edb/ref 17592186045417] [17592186120980 #edb/ref 1064 "One application of differential equations is to model the current in electrical circuits.\n\nAn **electrical circuit** is a closed, continuous path through which an electric charge can flow. The **current**, measured in amperes ($\\textrm{A}$), is the rate at which electric charge flows through the circuit as a function of time.\n\nElectrical circuits can contain many different components.\n\n- A **power source**, such as a **cell** (or **battery**), that supplies energy to the circuit by maintaining a potential difference (electromotive force, EMF), measured in volts ($\\textrm{V}$).\n\n![](images/14/14053a143ddd99905a32b8fac9ce6137630c7ccfeff34180e70f3213af90670c.png)\n\n- **Conducting paths**, such as wires, through which current carriers (electrons) flow.\n\n![](images/0f/0fe1adaaa7a0f9f35fe3db550580585cf147879815c7274241e1cc1f1ca0f8fa.png)\n\n- A **resistor** opposes the current and dissipates energy as heat. Resistance is measured in ohms ($\\Omega$).\n\n![](images/f1/f171d1d5c60acd048f3427dd5bc3119f452c07dee7a3068875646e052a077f49.png)\n\n- An **inductor** opposes *changes* in the current over time by storing energy in a magnetic field. Inductance is measured in henries ($\\textrm{H}$).\n\n![](images/f6/f63114660eb67da4eb5df7592afeb4e02c3668818c9cfc1722d7fadb2415c204.png)\n\nIn the next slide, we will connect these components in series to form an RL circuit." #edb/ref 17592186045417] [17592186120980 #edb/ref 1065 14568 #edb/ref 17592186045417] [17592186120980 #edb/ref 1066 #uuid "1f085c58-a3ab-5386-b857-365fbf6f8696" #edb/ref 17592186045417] [17592186120980 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186120981 #edb/ref 1064 "Consider the RL circuit shown below.  \n\n![](images/7a/7a0d33d5753469532efca3d7bd5bc62e7797a040dde61d7e94423dec829fa589.png)\n\nLet's find the differential equation that describes the current $I$ (in amperes) as a function of time $t$ (in seconds).\n\nThe diagram shows a series RL circuit with a source electromotive force (EMF) of $5\\,\\textrm{V},$ a resistor with resistance $15\\,\\Omega,$ and an inductor with an inductance of $3\\,\\textrm{H}.$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R = 15\\,\\Omega{:}$\n\n$$\nV_R = 15I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L = 3\\,\\textrm{H}{:}$\n\n$$\nV_L = 3\\,\\dfrac{\\mathrm{d}I}{\\mathrm{d}t}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n5 = 15I + 3\\,\\dfrac{\\mathrm{d}I}{\\mathrm{d}t},\n$$\n\nwhich gives\n\n$$\n\\dfrac{\\mathrm{d}I}{\\mathrm{d}t} + 5I = \\dfrac{5}{3}.\n$$" #edb/ref 17592186045417] [17592186120981 #edb/ref 1065 14572 #edb/ref 17592186045417] [17592186120981 #edb/ref 1066 #uuid "515104d6-5d9a-5a57-a4f5-b25826666786" #edb/ref 17592186045417] [17592186120981 #edb/ref 1067 "A Worked Example" #edb/ref 17592186045417] [17592186120983 #edb/ref 1064 "In many cases, the EMF produced by a power source is sinusoidal, not constant. Such a power source is shown in the diagram below.\n\n![](images/43/4398148f91eda2bae1392f79e868e10c8967ecc23ca9f26b791bc1fbacc45ff9.png)\n\nIn a first-order linear RL circuit driven by a sinusoidal voltage, the solution consists of a transient current that decays over time and a steady-state current that oscillates with the same frequency as the input and is independent of the initial condition.\n\nFor example, let's find the amplitude of the steady-state current in the RL circuit shown below.\n\n![](images/59/59fd8a8db1a227a578670d2457011275446c87ba218686f8d1984f4a73a8cfa6.png)\n\nThe diagram shows a series RL circuit with a source electromotive force (EMF) of $3\\sin(4t)\\,\\textrm{V},$ a resistor of resistance $7\\,\\Omega,$ and an inductor of inductance $1\\,\\textrm{H}.$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R = 7\\,\\Omega.$\n\n$$\nV_R = 7I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L = 1\\,\\textrm{H}.$\n\n$$\nV_L = 1\\cdot\\dfrac{\\mathrm{d}I}{\\mathrm{d}t}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n3\\sin(4t) = 7I + 1\\cdot\\dfrac{\\mathrm{d}I}{\\mathrm{d}t}\n$$\n\nwhich gives the equation\n\n$$\n\\dfrac{\\mathrm{d}I}{\\mathrm{d}t} + 7I = 3\\sin(4t).\n$$\n\nThis is a first-order linear equation with constant coefficients. So, to find the general solution, we must find the sum of the complementary and particular solutions.\n\n- To find the complementary solution $I_c,$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\dfrac{\\mathrm{d}I_c}{\\mathrm{d}t} + 7I_c = 0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\nI_c(t) = Ae^{-7t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $4t.$ So, we assume that the particular solution is also sinusoidal with argument $4t,$ i.e.,\n\n$$\nI_p(t) = \\alpha\\cos(4t) + \\beta\\sin(4t).\n$$\n\nTo find the values of $\\alpha$ and $\\beta,$ we substitute\n\n$$\n\\begin{aligned}{I}_{p} & =\\alpha \\operatorname{cos}⁡(4t)+\\beta \\operatorname{sin}⁡(4t), \\\\ \\frac{d{I}_{p}}{dt} & =-4\\alpha \\operatorname{sin}⁡(4t)+4\\beta \\operatorname{cos}⁡(4t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}(-4\\alpha \\operatorname{sin}⁡(4t)+4\\beta \\operatorname{cos}⁡(4t))+7(\\alpha \\operatorname{cos}⁡(4t)+\\beta \\operatorname{sin}⁡(4t)) & =3\\operatorname{sin}⁡(4t) \\\\ (-4\\alpha +7\\beta )\\operatorname{sin}⁡(4t)+(7\\alpha +4\\beta )\\operatorname{cos}⁡(4t) & =3\\operatorname{sin}⁡(4t)\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\{\\begin{aligned}-4\\alpha +7\\beta =3\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(4t)) \\\\ 7\\alpha +4\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(4t))\\end{aligned}\n$$\n\nSolving this system gives $\\alpha = -\\dfrac{12}{65},$ $\\beta = \\dfrac{21}{65}.$ Therefore, the particular solution is\n\n$$\nI_p(t) = -\\dfrac{12}{65}\\cos(4t) + \\dfrac{21}{65}\\sin(4t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t) = I_c(t) + I_p(t) = Ae^{-7t} - \\dfrac{12}{65}\\cos(4t) + \\dfrac{21}{65}\\sin(4t).\n$$\n\nNote the following:\n\n- The quantity $I_c(t) = Ae^{-7t}$ is the *transient current*, since it goes to zero as $t \\to \\infty.$\n\n- The function $I_p(t) =  - \\dfrac{12}{65}\\cos(4t) + \\dfrac{21}{65}\\sin(4t)$ is the *steady-state current*. It governs the current's long-term behavior.\n\nTherefore, as $t\\to\\infty,$ we have\n\n$$\nI(t) \\approx I_p(t) = -\\dfrac{12}{65}\\cos(4t) + \\dfrac{21}{65}\\sin(4t).\n$$\n\nFinally, the amplitude of the steady-state current is given by\n\n$$\n\\sqrt{\\left(-\\dfrac{12}{65}\\right)^2 + \\left(\\dfrac{21}{65}\\right)^2} \\approx 0.37\\,\\textrm{A},\n$$\n\nrounded to two decimal places. This amplitude represents the maximum magnitude of the steady-state current flowing through the circuit." #edb/ref 17592186045417] [17592186120983 #edb/ref 1065 14580 #edb/ref 17592186045417] [17592186120983 #edb/ref 1066 #uuid "e19d072d-824c-5014-9eaf-0cde5336358b" #edb/ref 17592186045417] [17592186120983 #edb/ref 1067 "Steady-State Solutions for Sinusoidal EMFs" #edb/ref 17592186045417] [17592186120984 #edb/ref 1064 "In a first-order linear differential equation, the solution splits into a **transient term** that decays over time and a **steady-state term** that remains as $t \\to \\infty.$\n\nIn an RL circuit with a constant electromotive force (EMF), this steady-state value corresponds to the long-term current in the circuit after all transient effects have died out, independent of the initial condition.\n\nTo demonstrate how to extract the steady-state current from the general solution of an RL circuit model, suppose the current $I(t),$ in amperes, in a series RL circuit governed by the differential equation\n\n$$\n\\dfrac{\\mathrm{d}I}{\\mathrm{d}t} + 6I = 12.\n$$\n\nThis is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution $I_c,$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\dfrac{\\mathrm{d}I_c}{\\mathrm{d}t} + 6I_c = 0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\nI_c(t) = Ae^{-6t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\nI_p(t) = \\alpha.\n$$\n\nTo find the value of $\\alpha,$ we substitute $I_p = \\alpha$ and $\\dfrac{\\mathrm{d}I_p}{\\mathrm{d}t} = (\\alpha)' = 0,$ into the inhomogeneous equation:\n\n$$\n0 + 6\\alpha = 12\n  \\quad\\Longrightarrow\\quad\n  \\alpha = 2\n$$\n\nTherefore, the particular solution is $I_p(t) = 2.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t) = I_c(t) + I_p(t) = Ae^{-6t} + 2.\n$$\n\nNote the following:\n\n- The quantity $I_c = Ae^{-6t}$ is the *transient current*, since it goes to zero as $t \\to \\infty.$\n\n- The constant $I_p = 2$ is the *steady-state current*. As $t\\to\\infty,$ the current $I$ approaches the value of the steady-state current.\n\nTherefore, the steady-state current is $2$ amperes." #edb/ref 17592186045417] [17592186120984 #edb/ref 1065 14581 #edb/ref 17592186045417] [17592186120984 #edb/ref 1066 #uuid "28b9a8ae-9d65-5781-82b1-a5dbde3ac5ee" #edb/ref 17592186045417] [17592186120984 #edb/ref 1067 "Steady-State Solutions for Constant EMFs" #edb/ref 17592186045417] [17592186120989 #edb/ref 1064 "Electrical circuits are said to be **in series** if the components are connected end to end in a single path, so that the same current flows through every component in the circuit.\n\nIn this lesson, we'll look at **RL circuits**, which contain both a resistor and an inductor, most commonly in series with a voltage source. An example is shown below, consisting of a resistance $R,$ in ohms, an inductance $L,$ in henries, and a source EMF $E,$ in volts. \n\n![](images/6c/6c91b527a400a918ca14133c5fb7aa713c6d53cb7dde3e0619ab82f1a846e092.png)\n\nHow do we find a differential equation that best describes the circuit's current $I(t),$ measured in amperes, where $t$ is the time, in seconds?\n\nAccording to conservation of energy, as electric charge moves around a circuit, the energy gained from the source must equal the energy lost in the components. The decrease in voltage across a component is called a **voltage drop**.\n\nFrom this follows **Kirchhoff's Voltage Law**, which states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops around the loop.\n\nIn an RL circuit, there are two voltage drops:\n\n- The resistor *opposes the flow of current*, hence producing a voltage drop proportional to the current, with a constant of proportionality $R{:}$ \n\n$$\nV_R = RI\n$$\n\n- The inductor *opposes changes in current*, hence producing a voltage drop proportional to the rate of change of current, with a constant of proportionality $L{:}$ \n\n$$\nV_L = L\\,\\dfrac{\\mathrm{d}I}{\\mathrm{d}t}\n$$\n\nTherefore, by Kirchhoff's Voltage Law, the source voltage $E$ is the sum of the voltage drops: $E = V_R + V_L.$\n\nAs a result, the basic equation governing the amount of current $I(t)$ in the circuit is\n\n$$\nE = RI + L\\,\\dfrac{\\mathrm{d}I}{\\mathrm{d}t}\n\\quad\\Longrightarrow\\quad\n\\dfrac{\\mathrm{d}I}{\\mathrm{d}t} + \\dfrac{R}{L}I = \\dfrac{E}{L}.\n$$\n\nNext, we will look at a worked example with specific values for $R,$ $L,$ and $E.$" #edb/ref 17592186045417] [17592186120989 #edb/ref 1065 14899 #edb/ref 17592186045417] [17592186120989 #edb/ref 1066 #uuid "e3e37bc6-6596-57dd-b9d7-4e1d03a5beec" #edb/ref 17592186045417] [17592186120989 #edb/ref 1067 "RL Circuits" #edb/ref 17592186045417] [17592186308796 #edb/ref 1080 "\\frac{44}{169}" #edb/ref 17592186045417] [17592186308796 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186308796 #edb/ref 1083 #uuid "0611168e-01b6-5eb5-9bdd-eb0c4ed87d21" #edb/ref 17592186045417] [17592186309579 #edb/ref 1080 "\\frac{40}{169}" #edb/ref 17592186045417] [17592186309579 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186309579 #edb/ref 1083 #uuid "6b10d57c-e7e9-5a1a-9212-88743ad9bdcf" #edb/ref 17592186045417] [17592186309676 #edb/ref 1080 "\\frac{38}{169}" #edb/ref 17592186045417] [17592186309676 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186309676 #edb/ref 1083 #uuid "76c13a1a-1f33-531d-aa9c-39874842b71f" #edb/ref 17592186045417] [17592186310228 #edb/ref 1080 "0.5" #edb/ref 17592186045417] [17592186310228 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186310228 #edb/ref 1083 #uuid "b6d9eb43-6151-57e3-b17e-712357ab932f" #edb/ref 17592186045417] [17592186310320 #edb/ref 1080 "\\frac{45}{169}" #edb/ref 17592186045417] [17592186310320 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186310320 #edb/ref 1083 #uuid "c40b2d25-a48d-5c41-8009-e4d5ff3d8337" #edb/ref 17592186045417] [17592186310503 #edb/ref 1080 "\\frac{42}{169}" #edb/ref 17592186045417] [17592186310503 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186310503 #edb/ref 1083 #uuid "da9e72d4-e5ec-5e8d-a454-39ca5f817a72" #edb/ref 17592186045417] [17592186310974 #edb/ref 1075 #edb/ref 17592186310228 #edb/ref 17592186045417] [17592186310974 #edb/ref 1075 #edb/ref 17592186485818 #edb/ref 17592186045417] [17592186310974 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186310974 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186310974 #edb/ref 1078 #edb/ref 17592186485818 #edb/ref 17592186045417] [17592186310974 #edb/ref 1079 #uuid "43600dac-6d25-5682-8937-5005846b9935" #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186308796 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186309579 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186309676 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186310320 #edb/ref 17592186045417] [17592186311085 #edb/ref 1075 #edb/ref 17592186310503 #edb/ref 17592186045417] [17592186311085 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186311085 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186311085 #edb/ref 1078 #edb/ref 17592186310503 #edb/ref 17592186045417] [17592186311085 #edb/ref 1079 #uuid "6ea618d5-3a70-51f3-bce5-1d4b0166d37f" #edb/ref 17592186045417] [17592186311728 #edb/ref 1068 #edb/ref 17592186310974 #edb/ref 17592186045417] [17592186311728 #edb/ref 1069 "q-336643" #edb/ref 17592186045417] [17592186311728 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186311728 #edb/ref 1071 "The current $I(t),$ in amperes, in a series RL circuit is governed by the differential equation\n\n$$\n\\frac{dI}{dt}+6I=3,\\,I(0)=1.\n$$\n\nFind the steady-state current for this circuit.\n\nThe steady-state current is\n{{field-1}} amperes." #edb/ref 17592186045417] [17592186311728 #edb/ref 1072 #uuid "92ff7b67-920f-5e25-a5d9-2aca35a6388f" #edb/ref 17592186045417] [17592186311728 #edb/ref 1074 "The equation is a first-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${I}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{I}_{c}}{dt}+6{I}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{I}_{c}(t)=A{e}^{-6t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{I}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${I}_{p}=\\alpha $ and $\\frac{d{I}_{p}}{dt}=(\\alpha )^{′}=0,$ into the inhomogeneous equation:\n\n$$\n0+6\\alpha =3\\,⟹\\,\\alpha =\\frac{1}{2}\n$$\n\nTherefore, the particular solution is ${I}_{p}(t)=\\frac{1}{2}.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t)={I}_{c}(t)+{I}_{p}(t)=A{e}^{-6t}+\\frac{1}{2}.\n$$\n\nNote the following:\n\n- The quantity ${I}_{c}=A{e}^{-6t}$ is the *transient current*, since it goes to zero as $t\\to \\infty .$\n\n- The constant ${I}_{p}=\\frac{1}{2}$ is the *steady-state current*. As $t\\to \\infty ,$ the current $I$ approaches the value of the steady-state current.\n\nTherefore, the steady-state current is $\\frac{1}{2}$ amperes." #edb/ref 17592186045417] [17592186311743 #edb/ref 1068 #edb/ref 17592186311085 #edb/ref 17592186045417] [17592186311743 #edb/ref 1069 "q-336741" #edb/ref 17592186045417] [17592186311743 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186311743 #edb/ref 1071 "![](images/00/00d6676b631bd49c0c9b8a82f8dd05de3be6842f18b0c1c6b70f208e1d290d5a.png)\n\nConsider the RL circuit shown above. Given that the current $I(t)$ at time $t$ seconds is given by\n\n$$\nI(t)=A{e}^{-12t}+\\alpha \\operatorname{cos}⁡(5t)+\\beta \\operatorname{sin}⁡(5t),\n$$\n\nwhere $A,$ $\\alpha ,$ and $\\beta $ are constants, find the value of $\\alpha +\\beta .$" #edb/ref 17592186045417] [17592186311743 #edb/ref 1072 #uuid "195c82a8-9f40-5bf0-8acd-c9d6e6363995" #edb/ref 17592186045417] [17592186311743 #edb/ref 1074 "The diagram shows a series RL circuit with a source electromotive force (EMF) of $3\\operatorname{sin}⁡(5t)\\,\\text{V},$ a resistor of resistance $6\\,Ω,$ and an inductor of inductance $\\frac{1}{2}\\,\\text{H}.$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=6\\,Ω.$\n\n$$\n{V}_{R}=6I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=\\frac{1}{2}\\,\\text{H}.$\n\n$$\n{V}_{L}=\\frac{1}{2}\\cdot \\frac{dI}{dt}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n3\\operatorname{sin}⁡(5t)=6I+\\frac{1}{2}\\cdot \\frac{dI}{dt}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dI}{dt}+12I=6\\operatorname{sin}⁡(5t).\n$$\n\nThis is a first-order linear equation with constant coefficients. So, to find the general solution, we must find the sum of the complementary and particular solutions.\n\n- To find the complementary solution ${I}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{I}_{c}}{dt}+12{I}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{I}_{c}(t)=A{e}^{-12t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $5t.$ So, we assume that the particular solution is also sinusoidal with argument $5t,$ i.e.,\n\n$$\n{I}_{p}(t)=\\alpha \\operatorname{cos}⁡(5t)+\\beta \\operatorname{sin}⁡(5t).\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute\n\n$$\n\\begin{aligned}{I}_{p} & =\\alpha \\operatorname{cos}⁡(5t)+\\beta \\operatorname{sin}⁡(5t), \\\\ \\frac{d{I}_{p}}{dt} & =-5\\alpha \\operatorname{sin}⁡(5t)+5\\beta \\operatorname{cos}⁡(5t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}(-5\\alpha \\operatorname{sin}⁡(5t)+5\\beta \\operatorname{cos}⁡(5t))+12(\\alpha \\operatorname{cos}⁡(5t)+\\beta \\operatorname{sin}⁡(5t)) & =6\\operatorname{sin}⁡(5t) \\\\ (-5\\alpha +12\\beta )\\operatorname{sin}⁡(5t)+(12\\alpha +5\\beta )\\operatorname{cos}⁡(5t) & =6\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\{\\begin{aligned}-5\\alpha +12\\beta =6\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(5t)) \\\\ 12\\alpha +5\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(5t))\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{30}{169},$ $\\beta =\\frac{72}{169}.$ Therefore, the particular solution is\n\n$$\n{I}_{p}(t)=-\\frac{30}{169}\\operatorname{cos}⁡(5t)+\\frac{72}{169}\\operatorname{sin}⁡(5t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t)={I}_{c}(t)+{I}_{p}(t)=A{e}^{-12t}-\\frac{30}{169}\\operatorname{cos}⁡(5t)+\\frac{72}{169}\\operatorname{sin}⁡(5t).\n$$\n\nTherefore, we have\n\n$$\n\\alpha =-\\frac{30}{169},\\,\\beta =\\frac{72}{169}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\\alpha +\\beta  & =-\\frac{30}{169}+\\frac{72}{169} \\\\  & =\\frac{42}{169}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186377225 #edb/ref 1068 #edb/ref 17592186377226 #edb/ref 17592186045417] [17592186377225 #edb/ref 1069 "q-336652" #edb/ref 17592186045417] [17592186377225 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186377225 #edb/ref 1071 "A series RL circuit has a source electromotive force (EMF) of $6\\,\\text{V},$ a resistance of $30\\,Ω,$ and an inductance of $3\\,\\text{H}.$ Find, **rounded to two decimal places**, the circuit's current after $0.02$ seconds given that the initial current is $1\\,\\text{A}.$\n\nThe current after $0.02$ seconds is\n{{field-1}} amperes." #edb/ref 17592186045417] [17592186377225 #edb/ref 1072 #uuid "5c397fb9-bf38-5a44-8a25-4f5a4f9ab367" #edb/ref 17592186045417] [17592186377225 #edb/ref 1074 "Kirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RL circuit, there are two voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=30\\,Ω.$\n\n$$\n{V}_{R}=30I\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=3\\,\\text{H}.$\n\n$$\n{V}_{L}=3\\,\\frac{dI}{dt}\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of current $I$ in the circuit is\n\n$$\n6=30I+3\\,\\frac{dI}{dt}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dI}{dt}+10I=2.\n$$\n\nThis is a first-order linear equation with constant coefficients. So, to find the general solution, we must find the sum of the complementary and particular solutions.\n\n- To find the complementary solution ${I}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{d{I}_{c}}{dt}+10{I}_{c}=0.\n$$\n\nSolving using an integration technique, such as separation of variables, we obtain the complementary solution\n\n$$\n{I}_{c}(t)=A{e}^{-10t},\n$$\n\nwhere $A$ is a constant of integration.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ So, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{I}_{p}(t)=\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${I}_{p}=\\alpha $ and $\\frac{d{I}_{p}}{dt}=(\\alpha )^{′}=0,$ into the inhomogeneous equation:\n\n$$\n0+10\\alpha =2\\,⟹\\,\\alpha =\\frac{1}{5}\n$$\n\nTherefore, the particular solution is ${I}_{p}(t)=\\frac{1}{5}.$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nI(t)={I}_{c}(t)+{I}_{p}(t)=A{e}^{-10t}+\\frac{1}{5}.\n$$\n\nWe're told that the circuit starts with an initial current of $1\\,\\text{A}.$ So, we can apply the initial condition $I(0)=1,$ and solve for $A:$\n\n$$\n\\begin{aligned}I(0) & =1 \\\\ A{e}^{-10(0)}+\\frac{1}{5} & =1 \\\\ A & =\\frac{4}{5}\\end{aligned}\n$$\n\nTherefore, we have the following expression for $I(t):$\n\n$$\nI(t)=\\frac{4}{5}{e}^{-10t}+\\frac{1}{5}=\\frac{1}{5}(4{e}^{-10t}+1)\n$$\n\nFinally, the current in the circuit after $t=0.02$ seconds is\n\n$$\nI(0.02)=\\frac{1}{5}(4{e}^{-10(0.02)}+1)≈0.85\\,\\text{A},\n$$\n\nrounded to two decimal places." #edb/ref 17592186045417] [17592186377226 #edb/ref 1075 #edb/ref 17592186377227 #edb/ref 17592186045417] [17592186377226 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186377226 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186377226 #edb/ref 1078 #edb/ref 17592186377227 #edb/ref 17592186045417] [17592186377226 #edb/ref 1079 #uuid "2791feb8-6710-5d48-88a6-a2f36341287f" #edb/ref 17592186045417] [17592186377227 #edb/ref 1080 "0.85" #edb/ref 17592186045417] [17592