qrt[3]{4})$" #edb/ref 17592186045417] [17592186499802 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186499802 #edb/ref 1083 #uuid "4e379d7d-a44b-5b19-ae49-edc70a8dad28" #edb/ref 17592186045417] [17592186499942 #edb/ref 1080 "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(-2,-2)$" #edb/ref 17592186045417] [17592186499942 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186499942 #edb/ref 1083 #uuid "930ec2dc-3268-5e8c-bb20-3557f9ac1938" #edb/ref 17592186045417] [17592186500174 #edb/ref 1080 "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(2,2)$" #edb/ref 17592186045417] [17592186500174 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186500174 #edb/ref 1083 #uuid "fd6ba7c0-fd84-5eed-9805-7ee46c6511bf" #edb/ref 17592186045417] [17592186500239 #edb/ref 1075 #edb/ref 17592186499678 #edb/ref 17592186045417] [17592186500239 #edb/ref 1075 #edb/ref 17592186499733 #edb/ref 17592186045417] [17592186500239 #edb/ref 1075 #edb/ref 17592186499802 #edb/ref 17592186045417] [17592186500239 #edb/ref 1075 #edb/ref 17592186499942 #edb/ref 17592186045417] [17592186500239 #edb/ref 1075 #edb/ref 17592186500174 #edb/ref 17592186045417] [17592186500239 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186500239 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186500239 #edb/ref 1078 #edb/ref 17592186499678 #edb/ref 17592186045417] [17592186500239 #edb/ref 1079 #uuid "956e93fd-6df8-5b5f-8f5c-3b6f83220074" #edb/ref 17592186045417] [17592186500338 #edb/ref 1068 #edb/ref 17592186500239 #edb/ref 17592186045417] [17592186500338 #edb/ref 1069 "q-65209" #edb/ref 17592186045417] [17592186500338 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186500338 #edb/ref 1071 "At which points on the curve $3y{x}^{2}=48+3x{y}^{2}$ is the tangent vector to the curve perpendicular to the vector $i-j?$" #edb/ref 17592186045417] [17592186500338 #edb/ref 1072 #uuid "a5f3b132-60d1-51a8-b2e5-d8b20ae5add9" #edb/ref 17592186045417] [17592186500338 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{x}^{2}-3x{y}^{2} & =48\\end{aligned}\n$$\n\nIf we set $f(x,y)=3y{x}^{2}-3x{y}^{2}$, our curve can be viewed as the level curve $f(x,y)=48.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(3y{x}^{2}-3x{y}^{2})i-\\frac{∂}{∂x}(3y{x}^{2}-3x{y}^{2})j \\\\  & =(3{x}^{2}-6xy)i-(6xy-3{y}^{2})j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot (i-j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i-j) & =0 \\\\ ((3{x}^{2}-6xy)i-(6xy-3{y}^{2})j)\\cdot (i-j) & =0 \\\\ 3{x}^{2}-6xy+6xy-3{y}^{2} & =0 \\\\ 3{x}^{2}-3{y}^{2} & =0 \\\\ {x}^{2}-{y}^{2} & =0 \\\\ (x-y)(x+y) & =0\\end{aligned}\n$$\n\nTherefore, $x=y$ or $x=-y.$ Substituting $x=y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{y}^{2} & =48+3y{y}^{2} \\\\ 3{y}^{3} & =48+3{y}^{3} \\\\ 0 & =48\\end{aligned}\n$$\n\nSince we get a false statement, we conclude that does not exist points of the form $(x,x)$ on the curve. Substituting $x=-y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y(-y)^{2} & =48+3(-y){y}^{2} \\\\ 3{y}^{3} & =48-3{y}^{3} \\\\ 6{y}^{3} & =48 \\\\ {y}^{3} & =8 \\\\ y & =\\sqrt[3]{8} \\\\ y & =2\\end{aligned}\n$$\n\nFinally:\n\n- If $y=2$, we get $x=-2$ and the corresponding point is $(-2,2).$" #edb/ref 17592186045417] [17592186500393 #edb/ref 1062 #uuid "2240391e-6239-5c26-8753-fbe476494f29" #edb/ref 17592186045417] [17592186500393 #edb/ref 1063 #edb/ref 17592186500338 #edb/ref 17592186045417] [17592186500429 #edb/ref 1058 #edb/ref 17592186500448 #edb/ref 17592186045417] [17592186500429 #edb/ref 1062 #uuid "9e08735b-2a3b-57c7-99b1-ddcbb644aa6b" #edb/ref 17592186045417] [17592186500429 #edb/ref 1063 #edb/ref 17592186125191 #edb/ref 17592186045417] [17592186500448 #edb/ref 1058 #edb/ref 17592186500393 #edb/ref 17592186045417] [17592186500448 #edb/ref 1062 #uuid "e52e5366-4dc8-5cb0-a9bb-eeeb3bfd45c4" #edb/ref 17592186045417] [17592186500448 #edb/ref 1063 #edb/ref 17592186125192 #edb/ref 17592186045417]}
