#{[{:db/id #edb/ref 17592186125191 :knowledge-point/_questions [{:db/id #edb/ref 17592186124455 :knowledge-point/id #uuid "348fa49f-2af8-5562-91f6-3f70bb93ea90" :knowledge-point/title "Finding a Tangent Vector to a Plane Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} {:answer/id #uuid "043f0c6b-beee-5929-91a6-329b0aba6cab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364298} {:answer/id #uuid "6c7f3a73-6bb3-57e1-b890-8a39b32ac5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}\\,i+j" :db/id #edb/ref 17592186364299} {:answer/id #uuid "b9bd5e2f-eea5-58c3-8f18-2c41ef884348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i-j" :db/id #edb/ref 17592186364300} {:answer/id #uuid "cb787b13-c2e5-5275-b510-4a2ee9675a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}\\,i-j" :db/id #edb/ref 17592186364301}] :answer-field/correct {:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} :answer-field/id #uuid "4633732e-7712-5dd5-9f2e-d57d7262b765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad74cdc7-0885-5bf3-989d-0d3835ead91a" :question/math-academy-id "q-65204" :question/problem "Consider the plane curve $\\operatorname{cos}⁡x\\operatorname{cos}⁡y=\\operatorname{sin}⁡(xy).$ Find a tangent vector to that curve at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\operatorname{cos}⁡y & =\\operatorname{sin}⁡xy \\\\ \\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy) & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡xy$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,\\frac{\\pi }{2})$ can be computed as follows:\n\n$$\nt(0,\\frac{\\pi }{2})={f}_{y}(0,\\frac{\\pi }{2})i-{f}_{x}(0,\\frac{\\pi }{2})j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,i-\\frac{∂}{∂x}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,j \\\\  & =(-\\operatorname{cos}⁡x\\operatorname{sin}⁡y-x\\operatorname{cos}⁡(xy))i-(-\\operatorname{sin}⁡x\\operatorname{cos}⁡y-y\\operatorname{cos}⁡(xy))\\,j \\\\ t(0,\\frac{\\pi }{2}) & =(-\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))i-(-\\operatorname{sin}⁡(0)\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))j \\\\  & =-i+\\frac{\\pi }{2}\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i+\\frac{\\pi }{2}\\,j.$"}] [{:db/id #edb/ref 17592186125192 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce07dfdf-2d2a-50b4-b231-394b5d5d097f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/val