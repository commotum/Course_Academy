#{[{:db/id #edb/ref 17592186266102 :knowledge-point/_questions [{:db/id #edb/ref 17592186096675 :knowledge-point/id #uuid "95a32907-8304-5dfd-8759-9e91503445bf" :knowledge-point/title "Finding the Reduced Row Echelon Form of a 3x3 System That Is Not in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083caf03-1501-5cba-8190-446a66b010a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,3,-1⟩" :db/id #edb/ref 17592186263075} {:answer/id #uuid "9af8bfe2-063c-5dba-b504-5816b98f9766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-3,0⟩" :db/id #edb/ref 17592186264325} {:answer/id #uuid "b8b913e9-5eb2-5d55-9bc3-2f3b88be543b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-3,1⟩" :db/id #edb/ref 17592186264598} {:answer/id #uuid "da1a8356-2e88-513c-b7fa-151c2d4478c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-2,0⟩" :db/id #edb/ref 17592186264902} {:answer/id #uuid "f5e3c0bf-feab-56d8-8788-d7833ba1031b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,3,0⟩" :db/id #edb/ref 17592186265152}] :answer-field/correct {:answer/id #uuid "9af8bfe2-063c-5dba-b504-5816b98f9766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-3,0⟩" :db/id #edb/ref 17592186264325} :answer-field/id #uuid "71bd9945-c16d-52b1-9144-9035edc43bba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ff5175c-29cf-5e1c-8b8a-50a809738a87" :question/math-academy-id "q-131618" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x-y+2z=5 \\\\  & 2x-y+7z=7 \\\\  & x-y+3z=5\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & 5 \\\\ 2 & -1 & 7 & 7 \\\\ 1 & -1 & 3 & 5\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -1 & 2 & 5 \\\\ 2 & -1 & 7 & 7 \\\\ 1 & -1 & 3 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 5 \\\\ 0 & 1 & 3 & -3 \\\\ 1 & -1 & 3 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 5 \\\\ 0 & 1 & 3 & -3 \\\\ 0 & 0 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 5 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}-2{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & 5 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned} & x=2 \\\\  & y=-3 \\\\  & z=0.\\end{aligned}\n$$\n\nSo, we have the solution $x=2$, $y=-3$, and $z=0.$ Or, in vector form, $⟨2,-3,0⟩.$"}] [{:db/id #edb/ref 17592186097174 :knowledge-point/_questions [{:db/id #edb/ref 17592186096675 :knowledge-point/id #uuid "95a32907-8304-5dfd-8759-9e91503445bf" :knowledge-point/title "Finding the Reduced Row Echelon Form of a 3x3 System That Is Not in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f53140c-1654-5c33-b318-d2cc5cdbf3e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,2,1⟩" :db/id #edb/ref 17592186416405} {:answer/id #uuid "3b8ed053-8c5f-5809-b29d-46bc30062dd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-2,1⟩" :db/id #edb/ref 17592186416409} {:answer/id #uuid "52ed3b97-c09d-5bac-bedf-d8cb30fd9295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-3,1⟩" :db/id #edb/ref 17592186416411} {:answer/id #uuid "ad204329-d0a2-52cb-bab5-d155cba3473f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-2,1⟩" :db/id #edb/ref 17592186416423} {:answer/id #uuid "fa5e31d8-6742-527d-a027-3e41d829bbd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-2,-1⟩" :db/id #edb/ref 17592186416428}] :answer-field/correct {:answer/id #uuid "3b8ed053-8c5f-5809-b29d-46bc30062dd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-2,1⟩" :db/id #edb/ref 17592186416409} :answer-field/id #uuid "4d9c6d72-c8a0-5fe2-aea3-51adff0f94d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb5d2e37-01c6-52dc-86a3-0e3d22b79684" :question/math-academy-id "q-20267" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+z=2 \\\\  & x+2y+z=0 \\\\  & x+y+2z=3\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 1 & 2 & 1 & 0 \\\\ 1 & 1 & 2 & 3\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 1 & 2 & 1 & 0 \\\\ 1 & 1 & 2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & 0 & -2 \\\\ 1 & 1 & 2 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}-{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 1 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 3 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned} & x=3 \\\\  & y=-2 \\\\  & z=1.\\end{aligned}\n$$\n\nSo, we have the solution $x=3$, $y=-2$, and $z=1.$ Or, in vector form, $⟨3,-2,1⟩.$"}] [{:db/id #edb/ref 17592186342242 :knowledge-point/_questions [{:db/id #edb/ref 17592186096675 :knowledge-point/id #uuid "95a32907-8304-5dfd-8759-9e91503445bf" :knowledge-point/title "Finding the Reduced Row Echelon Form of a 3x3 System That Is Not in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f1079e-5752-5de3-a9e1-e19c06fada97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -9 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186339766} {:answer/id #uuid "599056ef-e9ef-5488-965a-9dd9e4140202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -6 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186339942} {:answer/id #uuid "a3e2972b-b0c5-5496-8789-531b77f4e97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186340614} {:answer/id #uuid "bac13010-faae-5ec6-a632-601054299d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -3 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186340802} {:answer/id #uuid "f4632778-f58f-50b4-b85c-9458c6830a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186341280}] :answer-field/correct {:answer/id #uuid "a3e2972b-b0c5-5496-8789-531b77f4e97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186340614} :answer-field/id #uuid "e5965582-0f9c-5d43-87a1-fef40d8e1c11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341788}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1acb1c2-35d8-56f8-bcad-3b6d0c4f6e46" :question/math-academy-id "q-74601" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+2y-z=3 \\\\  & -2x-3y+2z=0 \\\\  & 2x+3y-z=3\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -2 & -3 & 2 & 0 \\\\ 2 & 3 & -1 & 3\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -2 & -3 & 2 & 0 \\\\ 2 & 3 & -1 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 2 & 3 & -1 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & -1 & 1 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & 6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\\end{aligned}\n$$"}]}
