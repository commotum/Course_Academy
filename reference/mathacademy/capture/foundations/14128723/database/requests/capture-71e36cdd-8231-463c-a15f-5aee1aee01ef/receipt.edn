34521 17592186045417 true] [17592186424109 1076 #edb/ref 17592186045493 13194139534521 17592186045417 true] [17592186424109 1077 "selection" 13194139534521 17592186045417 true] [17592186424109 1078 #edb/ref 17592186424105 13194139534521 17592186045417 true] [17592186424109 1079 #uuid "a69e7526-7c64-51e8-b0ec-23524a78858f" 13194139534521 17592186045417 true] [17592186424110 1068 #edb/ref 17592186424109 13194139534521 17592186045417 true] [17592186424110 1069 "q-35572" 13194139534521 17592186045417 true] [17592186424110 1070 #edb/ref 17592186045487 13194139534521 17592186045417 true] [17592186424110 1071 "The matrix $A$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(A).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${x}_{1},{x}_{2}$ and ${x}_{3}$ are real numbers such that $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3},$ and ${a}_{1}$, ${a}_{2}$, and ${a}_{3}$ are the respective columns of $A.$\n\n$$\nA=[\\begin{aligned}1 & 3 & -8 \\\\ 0 & -1 & 4 \\\\ 2 & 0 & -4\\end{aligned}],\\,b=[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\n$$" 13194139534521 17592186045417 true] [17592186424110 1072 #uuid "b249af0d-2baa-56c1-b03f-659223bf8b34" 13194139534521 17592186045417 true] [17592186424110 1074 "In order to determine whether $b$ lies in $\\text{Col}(A),$ we need to check if the equation $Ax=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 2 & 0 & -4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 0 & -6 & 12 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 0 & 0 & -12 & -6\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+3{x}_{2}-8{x}_{3}=-2 \\\\ -{x}_{2}+4{x}_{3}=2 \\\\ -12{x}_{3}=-6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=\\frac{1}{2}.$ Substituting it into the second equation gives \n\n$$\n\\begin{aligned}-{x}_{2}+4(\\frac{1}{2}) & =2 \\\\ -{x}_{2}+2 & =2 \\\\ {x}_{2} & =0.\\end{aligned}\n$$\n\nFinally, from the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+3(0)-8(\\frac{1}{2}) & =-2 \\\\ {x}_{1}-4 & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\nSince we have a solution, the equation $Ax=b$ is consistent, which implies that $b\\in \\text{Col}(A).$ \n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1},$ ${a}_{2},$ and ${a}_{3}:$\n\n$$\n{{[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]}_{⏟}}_{b}=2\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{1}}+0\\cdot {{[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]}_{⏟}}_{{a}_{2}}+\\frac{1}{2}\\cdot {{[\\begin{aligned}-8 \\\\ 4 \\\\ -4\\end{aligned}]}_{⏟}}_{{a}_{3}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 0\\cdot \\frac{1}{2}=0.$" 13194139534521 17592186045417 true] [17592186424111 1058 #edb/ref 17592186424112 13194139534521 17592186045417 true] [17592186424111 1062 #uuid "79efb5b1-7822-50f1-9bbf-67d407d6bfd3" 13194139534521 17592186045417 true] [17592186424111 1063 #edb/ref 17592186120515 13194139534521 17592186045417 true] [17592186424112 1062 #uuid "8300882e-730c-5fc3-9879-32bb95590678" 13194139534521 17592186045417 true] [17592186424112 1063 #edb/ref 17592186247190 13194139534521 17592186045417 true] [17592186424113 1058 #edb/ref 17592186424111 13194139534521 17592186045417 true] [17592186424113 1062 #uuid "a4bd27de-27e6-5be6-9522-5db3c45dc351" 13194139534521 17592186045417 true] [17592186424113 1063 #edb/ref 17592186424110 13194139534521 17592186045417 true] [17592186424114 1058 #edb/ref 17592186424113 13194139534521 17592186045417 true] [17592186424114 1062 #uuid "d8211cae-1c45-5bea-b330-8b808519d1fe" 13194139534521 17592186045417 true] [1759