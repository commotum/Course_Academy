#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424115} :activity/id #uuid "2e13e69f-cc53-5df7-b3bb-fe0183b0f351" :activity/scope {:db/id #edb/ref 17592186050656 :topic/id #uuid "5ce2b050-dd59-54b3-bb85-3a4f08ea0365" :topic/math-academy-id 1850} :activity/steps [{:db/id #edb/ref 17592186424111 :step/content {:db/id #edb/ref 17592186120515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29da3f11-da36-5a93-b224-a37d8e81c149" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186339496} {:answer/id #uuid "3bda870a-e008-5fcd-8921-d9b462b64cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186339661} {:answer/id #uuid "7e4be675-e0f6-5007-9ea2-797607fdb517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186340267} {:answer/id #uuid "8b618a4a-be3e-5ad8-9ca8-4d4102c61425" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b\\notin \\text{Col}(E)" :db/id #edb/ref 17592186340377} {:answer/id #uuid "ff722db2-a186-58ef-bd64-b656f5cfdc12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186341381}] :answer-field/correct {:db/id #edb/ref 17592186340377} :answer-field/id #uuid "1e2b899c-9539-5cca-acdc-bf68af89936a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341434}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0554a363-6902-58e6-8a93-41a3bab0a0ff" :question/math-academy-id "q-74080" :question/problem "The matrix $E$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(E).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}\\cdot {x}_{4}$, where ${x}_{1}$, ${x}_{2}$, ${x}_{3}$, and ${x}_{4}$ are real numbers such that $b={x}_{1}{e}_{1}+{x}_{2}{e}_{2}+{x}_{3}{e}_{3}+{x}_{4}{e}_{4},$ and ${e}_{1}$, ${e}_{2}$, ${e}_{3}$, and ${e}_{4}$ are respective columns of $E.$\n\n$$\nE=[\\begin{aligned}1 & -4 & 7 & 1 \\\\ 4 & -16 & 28 & 4 \\\\ 1 & -3 & 0 & -1\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 7 \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(E),$ we need to check if the equation $Ex=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[E\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[E\\,|\\,b] & =[\\begin{aligned}1 & -4 & 7 & 1 & 2 \\\\ 4 & -16 & 28 & 4 & 7 \\\\ 1 & -3 & 0 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 7 & 1 & 2 \\\\ \\text{ }0 & 0 & 0 & 0 & -1 \\\\ 1 & -3 & 0 & -1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-4{x}_{2}+7{x}_{3}+{x}_{4}=2 \\\\ 0=-1 \\\\ {x}_{1}-3{x}_{2}-{x}_{4}=0.\\end{aligned}\n$$\n\nFrom the second equation, we get a false statement $0=-1.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(E).$"} :step/id #uuid "79efb5b1-7822-50f1-9bbf-67d407d6bfd3" :step/next {:db/id #edb/ref 17592186424112}} {:db/id #edb/ref 17592186424112 :step/content {:db/id #edb/ref 17592186247190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145aaf0d-c740-5655-ae4b-ab7ab839b1d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-32" :db/id #edb/ref 17592186244501} {:answer/id #uuid "3645011b-7dde-5f85-8688-666dc335211c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186244793} {:answer/id #uuid "44437890-b323-5fd5-97ac-226cbb6e05ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186244911} {:answer/id #uuid "cf93de62-0950-5d23-bca5-5947fd12768b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-31" :db/id #edb/ref 17592186246164} {:answer/id #uuid "e1ef9d00-cd89-59a6-b58c-1a2654314dc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-23" :db/id #edb/ref 17592186246324}] :answer-field/correct {:db/id #edb/ref 17592186244911} :answer-field/id #uuid "aa5a0518-d9be-57b6-b478-a86c9d9b1ec7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246855}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc664822-35fb-5c04-9e53-89dd85c50706" :question/math-academy-id "q-110979" :question/problem "Consider the matrix given by $A=[\\begin{aligned}-5 & 1 \\\\ 0 & -3 \\\\ 1 & 1\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}-8 \\\\ k \\\\ 10\\end{aligned}]$ belongs to $\\text{Col}(A).$" :question/worked-solution "If $b$ lies in $\\text{Col}(A),$ then the equation $Ax=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}-5 & 1 & -8 \\\\ 0 & -3 & k \\\\ 1 & 1 & 10\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 10 \\\\ 0 & -3 & k \\\\ -5 & 1 & -8\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 10 \\\\ 0 & -3 & k \\\\ 0 & 6 & 42\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 10 \\\\ 0 & -3 & k \\\\ 0 & 0 & 42+2k\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=10 \\\\ -3{x}_{2}=k \\\\ 0=42+2k.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=42+2k,$ which means that $k=-21.$"} :step/id #uuid "8300882e-730c-5fc3-9879-32bb95590678"} {:db/id #edb/ref 17592186424113 :step/content {:db/id #edb/ref 17592186424110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158fd3b6-b42a-5e9e-b83d-ee548a2f6fa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b\\notin \\text{Col}(A)" :db/id #edb/ref 17592186424104} {:answer/id #uuid "791e7d26-9d1f-5803-b774-f6e2358c4273" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186424105} {:answer/id #uuid "a421f5cb-8c63-56cc-847e-0b15d335d55e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186424106} {:answer/id #uuid "dab0c485-45d4-554d-af12-2b22d279fbd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186424107} {:answer/id #uuid "ed81c627-15f5-5ac5-9a83-8720033ed743" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186424108}] :answer-field/correct {:db/id #edb/ref 17592186424105} :answer-field/id #uuid "a69e7526-7c64-51e8-b0ec-23524a78858f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424109}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b249af0d-2baa-56c1-b03f-659223bf8b34" :question/math-academy-id "q-35572" :question/problem "The matrix $A$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(A).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$, where ${x}_{1},{x}_{2}$ and ${x}_{3}$ are real numbers such that $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3},$ and ${a}_{1}$, ${a}_{2}$, and ${a}_{3}$ are the respective columns of $A.$\n\n$$\nA=[\\begin{aligned}1 & 3 & -8 \\\\ 0 & -1 & 4 \\\\ 2 & 0 & -4\\end{aligned}],\\,b=[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(A),$ we need to check if the equation $Ax=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 2 & 0 & -4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 0 & -6 & 12 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -8 & -2 \\\\ 0 & -1 & 4 & 2 \\\\ 0 & 0 & -12 & -6\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+3{x}_{2}-8{x}_{3}=-2 \\\\ -{x}_{2}+4{x}_{3}=2 \\\\ -12{x}_{3}=-6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=\\frac{1}{2}.$ Substituting it into the second equation gives \n\n$$\n\\begin{aligned}-{x}_{2}+4(\\frac{1}{2}) & =2 \\\\ -{x}_{2}+2 & =2 \\\\ {x}_{2} & =0.\\end{aligned}\n$$\n\nFinally, from the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+3(0)-8(\\frac{1}{2}) & =-2 \\\\ {x}_{1}-4 & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\nSince we have a solution, the equation $Ax=b$ is consistent, which implies that $b\\in \\text{Col}(A).$ \n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1},$ ${a}_{2},$ and ${a}_{3}:$\n\n$$\n{{[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]}_{⏟}}_{b}=2\\cdot {{[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{1}}+0\\cdot {{[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]}_{⏟}}_{{a}_{2}}+\\frac{1}{2}\\cdot {{[\\begin{aligned}-8 \\\\ 4 \\\\ -4\\end{aligned}]}_{⏟}}_{{a}_{3}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 0\\cdot \\frac{1}{2}=0.$"} :step/id #uuid "a4bd27de-27e6-5be6-9522-5db3c45dc351" :step/next {:db/id #edb/ref 17592186424111}} {:db/id #edb/ref 17592186424114 :step/content {:db/id #edb/ref 17592186120397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826165fc-f641-5f1a-94bd-36d5b21a3d8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186118497} {:answer/id #uuid "b7e517cb-5c7c-5901-9fc8-4d62de0ffa87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186118498} {:answer/id #uuid "d09a578d-a4f8-5169-ae0b-3f5e8801df37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186118499} {:answer/id #uuid "1c9f1214-ef5c-5445-be91-c3914d8f5865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186118500} {:answer/id #uuid "20d99621-dbd7-526e-832d-85b050d0bddd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186118501}] :answer-field/correct {:db/id #edb/ref 17592186118500} :answer-field/id #uuid "82d94d35-2966-563a-ae36-53ee87337d99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186118496}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "573bc22a-fac9-5364-8084-060fccb61060" :question/math-academy-id "q-35567" :question/problem "Consider the matrix given by $A=[\\begin{aligned}3 & 8 \\\\ -2 & -11 \\\\ 1 & 6\\end{aligned}].$ Determine the value of $k$ for which the vector $b=[\\begin{aligned}14 \\\\ -15 \\\\ k+5\\end{aligned}]$ belongs to $\\text{Col}(A).$" :question/worked-solution "If $b$ lies in $\\text{Col}(A),$ then the equation $Ax=b$ must be consistent. So, let's find the row echelon form of the augmented matrix $[A\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[A\\,|\\,b] & =[\\begin{aligned}3 & 8 & 14 \\\\ -2 & -11 & -15 \\\\ 1 & 6 & k+5\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 6 & k+5 \\\\ -2 & -11 & -15 \\\\ 3 & 8 & 14\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 6 & k+5 \\\\ 0 & 1 & 2k-5 \\\\ 3 & 8 & 14\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 6 & k+5 \\\\ 0 & 1 & 2k-5 \\\\ 0 & -10 & -3k-1\\end{aligned}] & {R}_{3} & :={R}_{3}+10{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 6 & k+5 \\\\ 0 & 1 & 2k-5 \\\\ 0 & 0 & 17k-51\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+6{x}_{2}=k+5 \\\\ {x}_{2}=2k-5 \\\\ 0=17k-51.\\end{aligned}\n$$\n\nIn order for this system to be consistent, we require $0=17k-51,$ which means that $k=3.$"} :step/id #uuid "d8211cae-1c45-5bea-b330-8b808519d1fe" :step/next {:db/id #edb/ref 17592186424113}} {:db/id #edb/ref 17592186424115 :step/content {:db/id #edb/ref 17592186317416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0137f4f1-683a-5532-86ac-a58609ac6c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186315122} {:answer/id #uuid "36dddeda-f4aa-5342-a56d-21d473781fec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b\\notin \\text{Col}(E)" :db/id #edb/ref 17592186315436} {:answer/id #uuid "40a90e71-399a-5c76-8a51-5bf7d89f38b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186315490} {:answer/id #uuid "5eed2d17-3d66-58ef-b9ca-d14343adcf9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186315652} {:answer/id #uuid "fe5e2b84-4825-5e40-b36f-66a99eaaf9f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186316542}] :answer-field/correct {:db/id #edb/ref 17592186315436} :answer-field/id #uuid "4285fcd0-9fe1-5d74-91ff-bd01e5c9f93a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186316697}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d2325a17-fb51-5bea-98a4-12b407e10918" :question/math-academy-id "q-34364" :question/problem "The matrix $E$ and the vector $b$ are given below.\nDetermine if $b\\in \\text{Col}(E).$ \nIn the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}\\cdot {x}_{4}$, where ${x}_{1}$, ${x}_{2}$, ${x}_{3}$, and ${x}_{4}$ are real numbers such that $b={x}_{1}{e}_{1}+{x}_{2}{e}_{2}+{x}_{3}{e}_{3}+{x}_{4}{e}_{4},$ and ${e}_{1}$, ${e}_{2}$, ${e}_{3}$, and ${e}_{4}$ are respective columns of $E.$\n\n$$\nE=[\\begin{aligned}8 & -2 & 5 & 1 \\\\ 16 & -4 & 10 & 2 \\\\ 11 & -3 & 0 & -1\\end{aligned}],\\,b=[\\begin{aligned}4 \\\\ -1 \\\\ 0\\end{aligned}]\n$$" :question/worked-solution "In order to determine whether $b$ lies in $\\text{Col}(E),$ we need to check if the equation $Ex=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[E\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[E\\,|\\,b] & =[\\begin{aligned}8 & -2 & 5 & 1 & 4 \\\\ 16 & -4 & 10 & 2 & -1 \\\\ 11 & -3 & 0 & -1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}8 & -2 & 5 & 1 & 4 \\\\ 0 & 0 & 0 & 0 & -9 \\\\ 11 & -3 & 0 & -1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}8{x}_{1}-2{x}_{2}+5{x}_{3}+{x}_{4}=4 \\\\ 0=-9 \\\\ 11{x}_{1}-3{x}_{2}-{x}_{4}=0.\\end{aligned}\n$$\n\nFrom the second equation, we get a false statement $0=-9.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(E).$"} :step/id #uuid "fa50bb1e-1a73-5c0f-bd3c-bb3e0f4000d9" :step/next {:db/id #edb/ref 17592186424114}}] :activity/title "The Column Space of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424103}]}
