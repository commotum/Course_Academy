#{[{:db/id #edb/ref 17592186265971 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0f29de-25aa-5107-8046-0dd732f9beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186263097} {:answer/id #uuid "162deb0b-2730-571d-b037-7db47a3aea46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186263209} {:answer/id #uuid "1b8f75e2-26ce-5967-ac8a-f06080423598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186263259} {:answer/id #uuid "66de9e61-f678-5f09-92fa-20666c0a4a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186263891} {:answer/id #uuid "f578aa5a-7ba5-5a91-8942-93f38512c9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186265150}] :answer-field/correct {:answer/id #uuid "0a0f29de-25aa-5107-8046-0dd732f9beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186263097} :answer-field/id #uuid "f00b119d-2bbd-5aff-88de-546820f3c832" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265676}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da7f3dfc-3649-55d6-80af-942a6a83828d" :question/math-academy-id "q-130767" :question/problem "Suppose $X$ is a $6\\times 6$ matrix and $det(X)=28.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operations ${R}_{1}:=\\frac{3}{4}{R}_{1}$ and ${R}_{6}:={R}_{6}+(-7){R}_{2}.$ What is the value of $det(Y)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{6}:={R}_{6}+(-7){R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{1}:=\\frac{3}{4}{R}_{1}$ involves multiplying a row by $\\frac{3}{4},$ so the determinant is multiplied by $\\frac{3}{4}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{3}{4}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(Y) & =\\frac{3}{4}det(X) \\\\  & =\\frac{3}{4}\\cdot 28 \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186424899 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171230a8-065f-5312-91ff-166c6fb3df4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+{R}_{1}" :db/id #edb/ref 17592186424893} {:answer/id #uuid "21bc26a0-57ad-5e62-a6e6-621e2ba24583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-1){R}_{1}" :db/id #edb/ref 17592186424894} {:answer/id #uuid "54d72f80-7a7b-5b93-a0ec-2d6edad08ac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-1){R}_{3}" :db/id #edb/ref 17592186424895} {:answer/id #uuid "6c11e90f-184e-57bd-b3ed-1971d8fb82ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:=-{R}_{2}" :db/id #edb/ref 17592186424896} {:answer/id #uuid "acde6755-f2db-5c6c-bdc1-ac03bdaa2931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186424897}] :answer-field/correct {:answer/id #uuid "21bc26a0-57ad-5e62-a6e6-621e2ba24583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-1){R}_{1}" :db/id #edb/ref 17592186424894} :answer-field/id #uuid "c75bea69-7db0-5820-97b1-b5dd95b8b845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "200dace6-387b-586f-87ab-a5501c01cbe0" :question/math-academy-id "q-130851" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}| & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-1){R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186265993 :knowledge-point/_questions [{:db/id #edb/ref 17592186119850 :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5631a190-3164-5c81-9c22-e6a70c44c09d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186263742} {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264014} {:answer/id #uuid "850ef7c7-1f4b-53c9-b078-25bda4009629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264145} {:answer/id #uuid "df7141db-3b66-5a7a-b89e-874dcb0bbee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186264937} {:answer/id #uuid "e044d557-77d9-53d0-a554-77b04c1a4a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186264947}] :answer-field/correct {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264014} :answer-field/id #uuid "cf6cdcea-ffe0-5e06-a7c5-0284d3815f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002" :question/math-academy-id "q-130855" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329661 :knowledge-point/_questions [{:db/id #edb/ref 17592186119777 :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038f903c-07cf-5804-8ccf-c48c4437fe4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186326971} {:answer/id #uuid "5e5d0fbb-4c6d-516a-bbe1-bc9a4754768c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186327766} {:answer/id #uuid "7edb508d-7daa-5a42-80ea-172f811c7a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186328025} {:answer/id #uuid "cef987a3-28b5-50d6-be17-23ad82b7d421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186328755} {:answer/id #uuid "dce0ee78-0312-5fae-84a0-aea62c27e409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328863}] :answer-field/correct {:answer/id #uuid "cef987a3-28b5-50d6-be17-23ad82b7d421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186328755} :answer-field/id #uuid "91964048-e6f4-5262-9e11-ecd0686eeeaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329428}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44ea0623-3f8f-525c-8344-8d911fbef23b" :question/math-academy-id "q-42504" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=5.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{1}↔{R}_{2}$ and ${R}_{3}:=3{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{2}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=3{R}_{3}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $3$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot (-det(A)) \\\\  & =-3det(A) \\\\  & =-3\\cdot 5 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341855 :knowledge-point/_questions [{:db/id #edb/ref 17592186119851 :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17922ecf-87f8-5af9-872a-3d5dc6da26af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186339339} {:answer/id #uuid "3e3f2587-b4ad-5bf0-81b7-1df62ffb7a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-243" :db/id #edb/ref 17592186339686} {:answer/id #uuid "a21fdf0b-c950-5ec9-b67b-31a39827c266" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186340600} {:answer/id #uuid "ae1d7c41-28d1-55a3-9882-2c2b96500495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186340714} {:answer/id #uuid "f3da6cbc-6c90-5ed2-9aad-88c3625d3d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-192" :db/id #edb/ref 17592186341277}] :answer-field/correct {:answer/id #uuid "f3da6cbc-6c90-5ed2-9aad-88c3625d3d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-192" :db/id #edb/ref 17592186341277} :answer-field/id #uuid "ded707a6-03c1-52cc-8868-8933afddd3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341773}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bce6072f-0fd1-50b6-a305-a94b72b85f4e" :question/math-academy-id "q-72740" :question/problem "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=-3.$ What is the value of $det(4Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(4Y) & ={4}^{3}\\cdot det(Y) \\\\  & =64\\cdot (-3) \\\\  & =-192.\\end{aligned}\n$$"}]}
