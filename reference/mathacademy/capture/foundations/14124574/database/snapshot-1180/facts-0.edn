6383230 #edb/ref 17592186045417] [17592186124464 #edb/ref 1038 #edb/ref 17592186383237 #edb/ref 17592186045417] [17592186124464 #edb/ref 1038 #edb/ref 17592186385377 #edb/ref 17592186045417] [17592186124464 #edb/ref 1038 #edb/ref 17592186403468 #edb/ref 17592186045417] [17592186124464 #edb/ref 1038 #edb/ref 17592186405132 #edb/ref 17592186045417] [17592186124464 #edb/ref 1039 "Finding the Equation of the Normal Line to a Surface Using the Gradient" #edb/ref 17592186045417] [17592186124464 #edb/ref 1041 #edb/ref 17592186124268 #edb/ref 17592186045417] [17592186124464 #edb/ref 1042 #uuid "ce7d6557-ec20-5a40-b799-1a6a36cbe9e6" #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125298 #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125306 #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125307 #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125308 #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125309 #edb/ref 17592186045417] [17592186124731 #edb/ref 1043 #edb/ref 17592186125310 #edb/ref 17592186045417] [17592186124731 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124731 #edb/ref 1045 "The Gradient as a Normal Vector" #edb/ref 17592186045417] [17592186124731 #edb/ref 1046 #edb/ref 17592186125298 #edb/ref 17592186045417] [17592186124731 #edb/ref 1049 #edb/ref 17592186050027 #edb/ref 17592186045417] [17592186124731 #edb/ref 1053 #uuid "00d7af21-acdd-52ae-8ffc-37290b0f0c74" #edb/ref 17592186045417] [17592186125189 #edb/ref 1068 #edb/ref 17592186123734 #edb/ref 17592186045417] [17592186125189 #edb/ref 1068 #edb/ref 17592186398914 #edb/ref 17592186045417] [17592186125189 #edb/ref 1069 "q-65167" #edb/ref 17592186045417] [17592186125189 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186125189 #edb/ref 1071 "For the function $f(x,y,z)=x{y}^{2}-2yz+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" #edb/ref 17592186045417] [17592186125189 #edb/ref 1072 #uuid "15fe86f3-62bf-5e0d-8567-00ad11df9f8d" #edb/ref 17592186045417] [17592186125189 #edb/ref 1074 "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,1)$ can be found by computing \n$∇f(1,-1,1).$ \n\nSo, we first find the gradient of $f(x,y,z)$  and evaluate it at $(x,y,z)=(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-2yz+z)\\,i+\\frac{∂}{∂y}(x{y}^{2}-2yz+z)\\,j+\\frac{∂}{∂z}(x{y}^{2}-2yz+z)\\,k \\\\  & ={y}^{2}\\text{ }i+(2xy-2z)\\text{ }j+(-2y+1)\\text{ }k \\\\ ∇f(1,-1,1) & =(-1)^{2}\\,i+(2(1)(-1)-2(1))\\,j+(-2(-1)+1)\\,k \\\\  & =1\\,i-4j+3\\,k\\end{aligned}\n$$\n\n \n\nTherefore, $\\,i-4\\,j+3\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" #edb/ref 17592186045417] [17592186125298 #edb/ref 1058 #edb/ref 17592186125306 #edb/ref 17592186045417] [17592186125298 #edb/ref 1061 11200 #edb/ref 17592186045417] [17592186125298 #edb/ref 1062 #uuid "35b375f8-a01b-56db-97b7-ac88f2a7883a" #edb/ref 17592186045417] [17592186125298 #edb/ref 1063 #edb/ref 17592186125735 #edb/ref 17592186045417] [17592186125306 #edb/ref 1058 #edb/ref 17592186125307 #edb/ref 17592186045417] [17592186125306 #edb/ref 1061 11376 #edb/ref 17592186045417] [17592186125306 #edb/ref 1062 #uuid "74d5fcb5-d32b-5ddd-92cd-491ff00e4b54" #edb/ref 17592186045417] [17592186125306 #edb/ref 1063 #edb/ref 17592186124461 #edb/ref 17592186045417] [17592186125307 #edb/ref 1058 #edb/ref 17592186125308 #edb/ref 17592186045417] [17592186125307 #edb/ref 1061 11379 #edb/ref 17592186045417] [17592186125307 #edb/ref 1062 #uuid "147b9868-60b3-5d25-8663-966137fb6540" #edb/ref 17592186045417] [17592186125307 #edb/ref 1063 #edb/ref 17592186124462 #edb/ref 17592186045417] [17592186125308 #edb/ref 1058 #edb/ref 17592186125309 #edb/ref 17592186045417] [17592186125308 #edb/ref 1061 11383 #edb/ref 17592186045417] [17592186125308 #edb/ref 1062 #uuid "81eef922-1c17-502c-89a2-3e132f4a64e6" #edb/ref 17592186045417] [17592186125308 #edb/ref 1063 #edb/ref 17592186125740 #edb/ref 17592186045417] [17592186125309 #edb/ref 1058 #edb/ref 17592186125310 #edb/ref 17592186045417] [17592186125309 #edb/ref 1061 11384 #edb/ref 17592186045417] [17592186125309 #edb/ref 1062 #uuid "20b0d4d3-7059-5c01-9a72-d14629d41a1c" #edb/ref 17592186045417] [17592186125309 #edb/ref 1063 #edb/ref 17592186124463 #edb/ref 17592186045417] [17592186125310 #edb/ref 1061 11387 #edb/ref 17592186045417] [17592186125310 #edb/ref 1062 #uuid "266600d8-59f0-586e-ba73-083efb5b7259" #edb/ref 17592186045417] [17592186125310 #edb/ref 1063 #edb/ref 17592186124464 #edb/ref 17592186045417] [17592186125735 #edb/ref 1064 "Given a function $z=f(x,y)$, if both partial derivatives $f_x,$ $f_y$ exist and are continuous in a neighborhood of a point $P(x_0,y_0)$ in the domain of the function, and if $\\nabla \\! f(x_0,y_0) \\neq \\mathbf 0,$ then we have the following result:\n\n*$\\nabla \\! f(x_0,y_0)$ is a normal vector to the level curve $C$ that passes through the point $P.$*\n\nThis property is one of the most important facts in multivariable calculus since it gives a fundamental link between calculus and geometry!\n\nLet's illustrate this property with a concrete example. Consider the paraboloid $z = f (x, y)= x^2 + y^2$ and the level curve $\\color{red}C$ of $f(x,y)$ corresponding to the point $P(1,-1).$ It is easy to see that $\\color{red}C$ is a circle of radius $\\sqrt{2}$ with equation $x^2+y^2 = 2.$\n\n![](images/f2/f2461dbfcde2403e6ed7de9d6288d33a4deb52319d35b7036628c3fa8b3789dc.png)\n\nIn this particular instance, the property says that\n\n*$\\nabla \\! f(1,-1)$ is a normal vector to the level curve $\\color{red}C$ that passes through the point $P(1,-1).$*\n\n![](images/48/481b68af522b9144e232d9c775f734cd998b31a21571cbfd983c23d0f68c3688.png)\n\nLooking at the situation in the $xy$-plane, we see the following:\n\n![](images/ce/ceb353d5164d6aa089a37e77c9469d747ef4430e363e42f9d35ee6d769d9a4e4.png)\n\nLet's verify that $\\nabla f(1,-1)$ is a normal line to the level curve $C$ at the point $P(1,-1).$\n\n- First, computing the gradient, we find that $\\nabla f = \\langle 2x, 2y \\rangle.$ Therefore, $$\\nabla f(1,-1) = \\langle 2, -2 \\rangle.$$\n- Then, using elementary calculus, we can show that the equation of the tangent to $C$ at $P$ is $y=x-2.$ Since this line has slope $m=1,$ it follows that the vector $\\langle 1,1 \\rangle$ is parallel to the level curve.\n- Finally, taking the dot product between the gradient and the tangent vector, we obtain $$\\nabla f(1,-1)\\cdot \\langle 1,1 \\rangle = \\langle 2, -2\\rangle \\cdot \\langle 1,1 \\rangle = 0.$$\n\nThis means that $\\nabla f(1,-1)$ is *perpendicular* to the tangent line to $C$ at $(1,-1).$" #edb/ref 17592186045417] [17592186125735 #edb/ref 1065 2499 #edb/ref 17592186045417] [17592186125735 #edb/ref 1066 #uuid "68a96106-e224-5989-af04-8d464b6e58d5" #edb/ref 17592186045417] [17592186125735 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125740 #edb/ref 1064 "The same property holds true in the case of three or more variables. In general, if $f$ is a differentiable real-valued function of $n$ variables, $\\mathbf y$ is a point in the domain of $f,$ and if the gradient vector is nonzero, i.e.,\n\n$$\\nabla f (\\mathbf y)= \\left \\langle f_{x_1}(\\mathbf y), f_{x_2}(\\mathbf y), \\cdots, f_{x_n}(\\mathbf y)\\right \\rangle \\neq \\mathbf 0,$$\n\nthen we have the following result:\n\n*$\\nabla f (\\mathbf y)$ is a normal vector to the level surface $f(x_1,x_2, \\cdots, x_n) =f(\\mathbf y)$ at $\\mathbf y.$*\n\nTo illustrate, let's consider the function\n\n$$w = f (x, y, z)= \\dfrac 1 2\\left(x^2 + y^2 + z^2-1\\right).$$\n\nThe level surface corresponding to $w=0$ is the sphere $\\mathcal S$ with equation $x^2 + y^2 +z^2 =1.$\n\nThe point $P(0,0,1)$ lies on $\\mathcal S.$ Computing $\\nabla f(0,0,1),$ we get\n\n$$\\eqalign{ \\nabla f(x,y,z) &= \\langle f_x, \\: f_y, \\:f_z\\rangle \\[5pt] &= \\dfrac12\\langle2x, \\: 2y, \\: 2z\\rangle\\[5pt] &= \\langle x, \\: y, \\: z\\rangle\\[10pt] \\nabla f(0,0,1) &= \\langle 0,\\: 0,\\: 1 \\rangle. }$$\n\nNow clearly, $\\nabla f (0,0, 1)$ is perpendicular to $\\mathcal S$ at the point $(0,0,1).$\n\n![](images/88/88bf25de31ae3318379865cdf2590c15216cb984cbf3948f975caa47317be664.png)" #edb/ref 17592186045417] [17592186125740 #edb/ref 1065 2524 #edb/ref 17592186045417] [17592186125740 #edb/ref 1066 #uuid "86223826-30df-5eba-9375-355401199095" #edb/ref 17592186045417] [17592186125740 #edb/ref 1067 "The Gradient as a Normal Vector For Functions of More than Two Variables" #edb/ref 17592186045417] [17592186263005 #edb/ref 1080 "2x-y-5=0" #edb/ref 17592186045417] [17592186263005 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263005 #edb/ref 1083 #uuid "0029eb5c-a868-5b35-b213-3fa6e3a04a1d" #edb/ref 17592186045417] [17592186263384 #edb/ref 1080 "x-3y-5=0" #edb/ref 17592186045417] [17592186263384 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263384 #edb/ref 1083 #uuid "2d9853cb-1b4d-5d99-b740-f207d47a13c3" #edb/ref 17592186045417] [17592186263854 #edb/ref 1080 "x+y-1=0" #edb/ref 17592186045417] [17592186263854 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263854 #edb/ref 1083 #uuid "62cb3b0d-c5e0-5140-9b14-0b73eecbc9ac" #edb/ref 17592186045417] [17592186263976 #edb/ref 1080 "x-2y-4=0" #edb/ref 17592186045417] [17592186263976 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263976 #edb/ref 1083 #uuid "70e32100-046e-5e0e-b9f2-eac7fe211b6f" #edb/ref 17592186045417] [17592186264575 #edb/ref 1080 "x+2y=0" #edb/ref 17592186045417] [17592186264575 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264575 #edb/ref 1083 #uuid "b5d5900d-9aee-5b56-aa97-4e95d9c8f10a" #edb/ref 17592186045417] [17592186265316 #edb/ref 1075 #edb/ref 17592186263005 #edb/ref 17592186045417] [17592186265316 #edb/ref 1075 #edb/ref 17592186263384 #edb/ref 17592186045417] [17592186265316 #edb/ref 1075 #edb/ref 17592186263854 #edb/ref 17592186045417] [17592186265316 #edb/ref 1075 #edb/ref 17592186263976 #edb/ref 17592186045417] [17592186265316 #edb/ref 1075 #edb/ref 17592186264575 #edb/ref 17592186045417] [17592186265316 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186265316 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186265316 #edb/ref 1078 #edb/ref 17592186263005 #edb/ref 17592186045417] [17592186265316 #edb/ref 1079 #uuid "263638a6-9832-58e0-a5f7-da0d13d29e2d" #edb/ref 17592186045417] [17592186373006 #edb/ref 1068 #edb/ref 17592186373007 #edb/ref 17592186045417] [17592186373006 #edb/ref 1069 "q-36351" #edb/ref 17592186045417] [17592186373006 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186373006 #edb/ref 1071 "Find the equation of the normal line to the surface $z=\\operatorname{ln}⁡(2x+y)$ at the point $(1,-1,0).$" #edb/ref 17592186045417] [17592186373006 #edb/ref 1072 #uuid "a1e0fe3a-1bd3-5ee4-ab1a-74e46b29c2c8" #edb/ref 17592186045417] [17592186373006 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}z & =\\operatorname{ln}⁡(2x+y) \\\\ 0 & =\\operatorname{ln}⁡(2x+y)-z\\end{aligned}\n$$\n\n \n\nSo, if we set $f(x,y,z)=\\operatorname{ln}⁡(2x+y)-z$, then our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nA normal vector to the level surface that passes through the point $(1,-1,0)$ can be found by computing $∇f(1,-1,0).$\n\nSo, we find the gradient and evaluate it at $(1,-1,0):$ \n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(2x+y)-z)i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(2x+y)-z)j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(2x+y)-z)k \\\\  & =\\frac{2}{2x+y}\\text{ }i+\\frac{1}{2x+y}\\text{ }j-1\\text{ }k \\\\ ∇f(1,-1,0) & =\\frac{2}{2(1)+(-1)}\\text{ }i+\\frac{1}{2(1)+(-1)}\\text{ }j-k \\\\  & =2\\text{ }i+\\,j-k \\\\  & =⟨2,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nFinally, by using the symmetric form of the equation of the line that is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$,  we get: \n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-1}{2}=\\frac{y-(-1)}{1}=\\frac{z-0}{-1} \\\\ \\frac{x-1}{2}=y+1=-z\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373008 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373009 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373010 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373011 #edb/ref 17592186045417] [17592186373007 #edb/ref 1075 #edb/ref 17592186373012 #edb/ref 17592186045417] [17592186373007 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373007 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373007 #edb/ref 1078 #edb/ref 17592186373010 #edb/ref 17592186045417] [17592186373007 #edb/ref 1079 #uuid "f074ec94-f4ab-59e4-98e4-6833b7d43d47" #edb/ref 17592186045417] [17592186373008 #edb/ref 1080 "\\frac{x-1}{2}=\\frac{y+1}{2}=-z" #edb/ref 17592186045417] [17592186373008 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373008 #edb/ref 1083 #uuid "9dd151b9-79f9-5a66-8557-365b16a9535a" #edb/ref 17592186045417] [17592186373009 #edb/ref 1080 "x-1=\\frac{y}{2}=-z" #edb/ref 17592186045417] [17592186373009 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373009 #edb/ref 1083 #uuid "e407b4cd-b0e3-5ef2-a3e1-1c2c4a208e39" #edb/ref 17592186045417] [17592186373010 #edb/ref 1080 "\\frac{x-1}{2}=y+1=-z" #edb/ref 17592186045417] [17592186373010 #edb/ref 1082 #edb/ref 17592186045498 #edb