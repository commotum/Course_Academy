#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186423055} :activity/id #uuid "4c8248e9-9c46-5103-ac9c-f0a394655226" :activity/scope {:db/id #edb/ref 17592186050027 :topic/id #uuid "26b9f4f0-7964-52b3-9a23-d31ae6927cb5" :topic/math-academy-id 1939} :activity/steps [{:db/id #edb/ref 17592186423052 :step/content {:db/id #edb/ref 17592186398361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed1a1ab0-6d18-5f30-b80b-be9f46dd80b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,i+j+k" :db/id #edb/ref 17592186398363} {:answer/id #uuid "d1cbc8d4-c2ee-5478-860e-c731a5274aec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j-k" :db/id #edb/ref 17592186398364} {:answer/id #uuid "f499f957-93d0-5ca6-8e65-57c931e33b8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,i-2\\,j" :db/id #edb/ref 17592186398365} {:answer/id #uuid "d7aa6514-a3ad-578c-8808-8284836b7b95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-2\\,j-k" :db/id #edb/ref 17592186398366} {:answer/id #uuid "431e58b2-3a4b-54f5-a2fc-05d378bf57ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\,i+k" :db/id #edb/ref 17592186398367}] :answer-field/correct {:db/id #edb/ref 17592186398365} :answer-field/id #uuid "530f90fa-b927-569c-b4dd-79831f2442af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398362}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da3be12b-b270-5258-9b1c-409842422d29" :question/math-academy-id "q-131116" :question/problem "For the function $f(x,y,z)={x}^{3}+{z}^{2}{y}^{2}+2z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,-1)$ can be found by computing \n$∇f(1,-1,-1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,i+\\frac{∂}{∂y}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,j+\\frac{∂}{∂z}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,k \\\\  & =3{x}^{2}\\text{ }i+2{z}^{2}y\\text{ }j+(2z{y}^{2}+2)\\text{ }k \\\\ ∇f(1,-1,-1) & =3(1)^{2}\\,i+2(-1)^{2}(-1)\\,j+(2(-1)(-1)^{2}+2)k \\\\  & =3\\,i-2\\,j\\end{aligned}\n$$\n\nTherefore, $3\\,i-2\\,j$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$"} :step/id #uuid "1470ea07-3b96-5965-8beb-c2e0041edd4a"} {:db/id #edb/ref 17592186423053 :step/content {:db/id #edb/ref 17592186373139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd12d1d6-f236-57c3-bd6d-b0a476bef5f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-1=y+1=\\frac{z-1}{-1}" :db/id #edb/ref 17592186373141} {:answer/id #uuid "e0818182-cafe-552e-a4a0-98b0c1314881" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+1=y+1=\\frac{z+1}{-1}" :db/id #edb/ref 17592186373142} {:answer/id #uuid "df5c957f-327c-59b5-a275-854f61c6c1b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+1=y-1=z-1" :db/id #edb/ref 17592186373143} {:answer/id #uuid "4643467a-d570-58d2-ac66-45f1f209b1ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+1=y+1=z-1" :db/id #edb/ref 17592186373144} {:answer/id #uuid "c777726a-c485-5a89-bead-338bff4761cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+1=y+1=\\frac{z-1}{-1}" :db/id #edb/ref 17592186373145}] :answer-field/correct {:db/id #edb/ref 17592186373145} :answer-field/id #uuid "31f112b8-6ada-53ff-b6b3-be00d57b76b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373140}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d41ffa1d-b743-559f-b433-9851a75bb790" :question/math-academy-id "q-71408" :question/problem "Find the equation of the normal line to the surface ${x}^{2}+{y}^{2}+{z}^{2}=3$ at the point $(-1,-1,1).$" :question/worked-solution "If we set $f(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}$, our surface can be viewed as the level surface $f(x,y,z)=3.$ \n\nA normal vector to the level surface that passes through the point $(-1,-1,1)$ can be found by computing $∇f(-1,-1,1).$ \n\nSo, we find the gradient and evaluate it at $(-1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2})i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}+{z}^{2})j+\\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2})k \\\\  & =2x\\text{ }i+2y\\text{ }j+2z\\text{ }k \\\\ ∇f(-1,-1,1) & =2(-1)\\text{ }i+2(-1)\\text{ }j+2(1)\\text{ }k \\\\  & =-2\\,i-2\\,j+2\\,k \\\\  & =⟨-2,-2,2⟩\\end{aligned}\n$$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-(-1)}{-2}=\\frac{y-(-1)}{-2}=\\frac{z-1}{2} \\\\ \\frac{x+1}{-2}=\\frac{y+1}{-2}=\\frac{z-1}{2} \\\\ \\frac{x+1}{1}=\\frac{y+1}{1}=\\frac{z-1}{-1} \\\\ x+1=y+1=\\frac{z-1}{-1}\\end{aligned}\n$$"} :step/id #uuid "20ee70ca-88be-504d-b7aa-237d8d22e58a" :step/next {:db/id #edb/ref 17592186423054}} {:db/id #edb/ref 17592186423054 :step/content {:db/id #edb/ref 17592186423051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "364ddf2b-cdd1-5e21-88c2-478a7d637e32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+3y-4=0" :db/id #edb/ref 17592186423045} {:answer/id #uuid "415a3975-289f-5c0a-aa48-bc85b813f82a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y-4=0" :db/id #edb/ref 17592186423046} {:answer/id #uuid "6321cb0e-8e68-5a7b-9a36-ac871cc17b89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y-2=0" :db/id #edb/ref 17592186423047} {:answer/id #uuid "82ce7cc2-be21-5dc4-9b04-e941ddd03d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-3y-2=0" :db/id #edb/ref 17592186423048} {:answer/id #uuid "ba63a292-9d83-540d-ac68-00ce4812ebb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+3y-2=0" :db/id #edb/ref 17592186423049}] :answer-field/correct {:db/id #edb/ref 17592186423048} :answer-field/id #uuid "02401848-522e-501b-82ff-6e5cb3f48ab9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f16c0b1-b80b-5067-adaf-a65b04fb7bb4" :question/math-academy-id "q-130721" :question/problem "Consider the plane curve ${e}^{{x}^{2}y}={y}^{2}-{x}^{3}+9.$  Find the equation of the normal line to the curve at the point $(2,0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{e}^{{x}^{2}y} & ={y}^{2}-{x}^{3}+9 \\\\ {e}^{{x}^{2}y}-{y}^{2}+{x}^{3} & =9\\end{aligned}\n$$\n\nIf we set $f(x,y)={e}^{{x}^{2}y}-{y}^{2}+{x}^{3}$, our curve can be viewed as the level curve $f(x,y)=9.$  \n\nA normal vector to the level curve that passes through the point $(2,0)$ can be found by computing $∇f(2,0).$ \n\nSo, we find the gradient and evaluate it at $(2,0):$ \n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({e}^{{x}^{2}y}-{y}^{2}+{x}^{3})i+\\frac{∂}{∂y}({e}^{{x}^{2}y}-{y}^{2}+{x}^{3})j \\\\  & =(2xy{e}^{{x}^{2}y}+3{x}^{2})i+({x}^{2}{e}^{{x}^{2}y}-2y)j \\\\ ∇f(2,0) & =(2(2)(0){e}^{({2}^{2})(0)}+3({2}^{2}))i+(({2}^{2}){e}^{({2}^{2})(0)}-2(0))j \\\\  & =12\\,i+4\\,j \\\\  & =⟨12,4⟩\\end{aligned}\n$$\n\nHence, $∇f(2,0)=⟨12,4⟩$ is a normal vector to the curve at $(2,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-2}{12} & =\\frac{y-0}{4} \\\\ 4(x-2) & =12y \\\\ x-2 & =3y \\\\ x-3y-2 & =0\\end{aligned}\n$$"} :step/id #uuid "68e1c4ea-40a6-5a21-ae75-071da89109f6" :step/next {:db/id #edb/ref 17592186423052}} {:db/id #edb/ref 17592186423055 :step/content {:db/id #edb/ref 17592186373006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dd151b9-79f9-5a66-8557-365b16a9535a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x-1}{2}=\\frac{y+1}{2}=-z" :db/id #edb/ref 17592186373008} {:answer/id #uuid "e407b4cd-b0e3-5ef2-a3e1-1c2c4a208e39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-1=\\frac{y}{2}=-z" :db/id #edb/ref 17592186373009} {:answer/id #uuid "2042c239-c608-579c-a356-780f349dc015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x-1}{2}=y+1=-z" :db/id #edb/ref 17592186373010} {:answer/id #uuid "e11362e5-c68a-5d93-8627-d0fe7c1b9816" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-1=\\frac{y+1}{2}=z" :db/id #edb/ref 17592186373011} {:answer/id #uuid "dad753bd-efc6-5cc5-bf02-04d7fe01e2cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x+1}{2}=\\frac{y-1}{2}=z" :db/id #edb/ref 17592186373012}] :answer-field/correct {:db/id #edb/ref 17592186373010} :answer-field/id #uuid "f074ec94-f4ab-59e4-98e4-6833b7d43d47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373007}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1e0fe3a-1bd3-5ee4-ab1a-74e46b29c2c8" :question/math-academy-id "q-36351" :question/problem "Find the equation of the normal line to the surface $z=\\operatorname{ln}⁡(2x+y)$ at the point $(1,-1,0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}z & =\\operatorname{ln}⁡(2x+y) \\\\ 0 & =\\operatorname{ln}⁡(2x+y)-z\\end{aligned}\n$$\n\n \n\nSo, if we set $f(x,y,z)=\\operatorname{ln}⁡(2x+y)-z$, then our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nA normal vector to the level surface that passes through the point $(1,-1,0)$ can be found by computing $∇f(1,-1,0).$\n\nSo, we find the gradient and evaluate it at $(1,-1,0):$ \n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(2x+y)-z)i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(2x+y)-z)j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(2x+y)-z)k \\\\  & =\\frac{2}{2x+y}\\text{ }i+\\frac{1}{2x+y}\\text{ }j-1\\text{ }k \\\\ ∇f(1,-1,0) & =\\frac{2}{2(1)+(-1)}\\text{ }i+\\frac{1}{2(1)+(-1)}\\text{ }j-k \\\\  & =2\\text{ }i+\\,j-k \\\\  & =⟨2,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nFinally, by using the symmetric form of the equation of the line that is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$,  we get: \n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-1}{2}=\\frac{y-(-1)}{1}=\\frac{z-0}{-1} \\\\ \\frac{x-1}{2}=y+1=-z\\end{aligned}\n$$"} :step/id #uuid "6fe264a7-c045-5612-8184-b7672b802421" :step/next {:db/id #edb/ref 17592186423056}} {:db/id #edb/ref 17592186423056 :step/content {:db/id #edb/ref 17592186125189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a68112ca-e7ee-5f12-8c6b-6f964b2fce64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\,i+4j+2\\,k" :db/id #edb/ref 17592186398915} {:answer/id #uuid "5739b0cd-fba7-5818-952f-616d15f8cd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\,i-4j+3\\,k" :db/id #edb/ref 17592186398916} {:answer/id #uuid "fc61dd7b-3fa9-5347-ad13-eae563990528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-j+3\\,k" :db/id #edb/ref 17592186398917} {:answer/id #uuid "9e270cd2-2ed5-5ff9-a8d2-046b4683fe91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,i+4j+3\\,k" :db/id #edb/ref 17592186398918} {:answer/id #uuid "12f59294-d897-5332-9fd4-6a0a58840be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\,i-2j+6\\,k" :db/id #edb/ref 17592186398919}] :answer-field/correct {:db/id #edb/ref 17592186398916} :answer-field/id #uuid "027e0dd0-8fb0-53bb-95b9-27c1e0e20a6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186398914}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "15fe86f3-62bf-5e0d-8567-00ad11df9f8d" :question/math-academy-id "q-65167" :question/problem "For the function $f(x,y,z)=x{y}^{2}-2yz+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,1)$ can be found by computing \n$∇f(1,-1,1).$ \n\nSo, we first find the gradient of $f(x,y,z)$  and evaluate it at $(x,y,z)=(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-2yz+z)\\,i+\\frac{∂}{∂y}(x{y}^{2}-2yz+z)\\,j+\\frac{∂}{∂z}(x{y}^{2}-2yz+z)\\,k \\\\  & ={y}^{2}\\text{ }i+(2xy-2z)\\text{ }j+(-2y+1)\\text{ }k \\\\ ∇f(1,-1,1) & =(-1)^{2}\\,i+(2(1)(-1)-2(1))\\,j+(-2(-1)+1)\\,k \\\\  & =1\\,i-4j+3\\,k\\end{aligned}\n$$\n\n \n\nTherefore, $\\,i-4\\,j+3\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$"} :step/id #uuid "80a30235-ea9e-5be6-ade1-4b81b30de9fc" :step/next {:db/id #edb/ref 17592186423053}}] :activity/title "The Gradient as a Normal Vector" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186423044}]}
