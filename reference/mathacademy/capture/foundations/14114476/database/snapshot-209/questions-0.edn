#{[{:db/id #edb/ref 17592186278294 :knowledge-point/_questions [{:db/id #edb/ref 17592186129269 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27184dd5-9306-5151-ba71-71c0184555b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275839} {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276805} {:answer/id #uuid "a6b6ecd9-7efa-5fbf-99f4-87cf3cf2fc2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276986} {:answer/id #uuid "a9f4d180-9148-56f8-af89-c87393729376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277013} {:answer/id #uuid "bc4ef6cf-c02f-531a-934f-84c5afac9290" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277159}] :answer-field/correct {:answer/id #uuid "921684d8-1a85-53da-b8a7-23bd356d4d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186276805} :answer-field/id #uuid "3f823688-c59b-5a64-9e51-9b7c368087e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2b1f8f7b-fd82-5c84-a276-7fa2fd9b071a" :question/math-academy-id "q-160383" :question/problem "For the transformation $T,$ defined as \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}uv \\\\ \\frac{v}{u}\\end{aligned}]\n$$\n\n \n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x=uv$ and $y=\\frac{v}{u}.$ \n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =u \\\\ \\frac{∂y}{∂u} & =-\\frac{v}{{u}^{2}} & \\,\\frac{∂y}{∂v} & =\\frac{1}{u}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v & u \\\\ -\\frac{v}{{u}^{2}}\\, & \\frac{1}{u}\\end{aligned}| \\\\  & =v\\cdot \\frac{1}{u}\\text{ }-u\\cdot (-\\frac{v}{{u}^{2}}) \\\\  & =\\frac{2v}{u}.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}-2 \\\\ 3\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(-2,3)}=\\frac{2(3)}{-2}=-3.\n$$"}] [{:db/id #edb/ref 17592186369879 :knowledge-point/_questions [{:db/id #edb/ref 17592186129269 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc0ac04-220f-5368-899c-f4b853d6caf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186369881} {:answer/id #uuid "f515d3db-880a-5d23-99f0-9cb65e633ebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369882} {:answer/id #uuid "57254211-1cc3-5a7f-87e1-0c345d6ba0b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369883} {:answer/id #uuid "0ab4227a-a1c7-56de-9a4e-de04cc753871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369884} {:answer/id #uuid "47ca5fb3-37c5-5519-9b75-0484cfdf1808" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186369885}] :answer-field/correct {:answer/id #uuid "4dc0ac04-220f-5368-899c-f4b853d6caf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186369881} :answer-field/id #uuid "c478e331-2d1a-585a-9599-198d7061ae49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91c905cb-29ef-5cbc-a791-764e51ba7eed" :question/math-academy-id "q-160445" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}2\\operatorname{cos}⁡u \\\\ -3\\operatorname{sin}⁡v\\end{aligned}]\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}\\pi /4 \\\\ \\pi /4\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=2\\operatorname{cos}⁡u$ and $y(u,v)=-3\\operatorname{sin}⁡v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-2\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =0 \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =-3\\operatorname{cos}⁡v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-2\\operatorname{sin}⁡u & 0 \\\\ 0 & -3\\operatorname{cos}⁡v\\end{aligned}| \\\\  & =(-2\\operatorname{sin}⁡u)\\cdot (-3\\operatorname{cos}⁡v)-0\\cdot 0 \\\\  & =6\\operatorname{sin}⁡u\\operatorname{cos}⁡v.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}\\pi /4 \\\\ \\pi /4\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(\\frac{\\pi }{4},\\frac{\\pi }{4})}=6\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4})=3.\n$$"}] [{:db/id #edb/ref 17592186129515 :knowledge-point/_questions [{:db/id #edb/ref 17592186129289 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e468aabf-e6e4-5599-81b1-17dc6d355954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/13/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186389036} {:answer/id #uuid "bdeedbec-6bdf-59e7-9b2b-b9d5e4e3ee50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389037} {:answer/id #uuid "a24ff250-c577-5a6e-8589-b7fa78f56034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389038} {:answer/id #uuid "ddf74745-74d7-5023-8d2f-494bd3a4b62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/15/154f70201a5a00737d8df61952f5600ff91a2373df07b0b54680fe84e048402c.png" :db/id #edb/ref 17592186389039} {:answer/id #uuid "c8a52325-f624-5716-886a-b507033c0141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/09/090bab0ac1c6356010d83a6ad54c59b53b7dd12062fb5e331a936ce3f3a1b411.png" :db/id #edb/ref 17592186389040}] :answer-field/correct {:answer/id #uuid "a24ff250-c577-5a6e-8589-b7fa78f56034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389038} :answer-field/id #uuid "391991ce-c7bf-55cb-8662-29196fd230b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4471fd6f-9a7d-5e2e-b974-bcbd5ed1ceb0" :question/math-academy-id "q-160601" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" :question/worked-solution "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -1 \\\\ 4 & -2v\\end{aligned}| \\\\  & =2u\\cdot (-2v)-4\\cdot (-1) \\\\  & =-4uv+4.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-4uv+4 & >0 \\\\ -4uv & >-4 \\\\ uv & <1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v<\\frac{1}{u}$ for $u>0$ and $v>\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png)"}] [{:db/id #edb/ref 17592186389194 :knowledge-point/_questions [{:db/id #edb/ref 17592186129289 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "773f7224-683a-5657-93fd-0b49bba9ddc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389196} {:answer/id #uuid "3223453f-3db3-5cf7-9170-0776a21f7b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png" :db/id #edb/ref 17592186389197} {:answer/id #uuid "d90c24c3-b6bf-58dc-bb07-e1245dcf6b0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186389198} {:answer/id #uuid "6ae8e4b1-ec09-543b-b30d-54e69ad80dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/10/105e6e8a010b7b9001f75cf17e11cbbc1e031d83cbc2ddfafc3595c745106f3f.png" :db/id #edb/ref 17592186389199} {:answer/id #uuid "682bc6d2-be17-5ccb-842c-4b844ea68ed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/09/090bab0ac1c6356010d83a6ad54c59b53b7dd12062fb5e331a936ce3f3a1b411.png" :db/id #edb/ref 17592186389200}] :answer-field/correct {:answer/id #uuid "3223453f-3db3-5cf7-9170-0776a21f7b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png" :db/id #edb/ref 17592186389197} :answer-field/id #uuid "2bd81eba-4d1a-5e26-b6d5-47144737edcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99972da5-e4e5-5505-b6d1-ad2a467bcb50" :question/math-academy-id "q-161839" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ uv+1\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" :question/worked-solution "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ uv+1\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -1 \\\\ v & u\\end{aligned}| \\\\  & =2u\\cdot u-v\\cdot (-1) \\\\  & =2{u}^{2}+v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2{u}^{2}+v & >0 \\\\ v & >-2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png)"}] [{:db/id #edb/ref 17592186281374 :knowledge-point/_questions [{:db/id #edb/ref 17592186129288 :knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018385f7-7519-5922-8545-718d1e4443e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186278603} {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278694} {:answer/id #uuid "42229dfb-92db-527f-98d4-81e464debdce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "16\\,\\delta A" :db/id #edb/ref 17592186279188} {:answer/id #uuid "5806f5cb-b442-516d-a7af-f295ed7a67a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186279407} {:answer/id #uuid "b63f49ff-6805-5e3d-9a84-bb5bf0cb46d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186280197}] :answer-field/correct {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278694} :answer-field/id #uuid "30341de0-d7c9-531a-935d-0764a34a14a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a571cf4-d621-5149-95d3-896e62b990d5" :question/math-academy-id "q-161875" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{cos}⁡u-{v}^{2} \\\\ u+v\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\operatorname{sin}⁡u & -2v \\\\ 1 & 1\\end{aligned}| \\\\  & =(-\\operatorname{sin}⁡u)\\cdot 1-1\\cdot (-2v) \\\\  & =-\\operatorname{sin}⁡u+2v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(0,3)} & =(-\\operatorname{sin}⁡u+2v)\\,{|}_{u=0\\,v=3} \\\\  & =-\\operatorname{sin}⁡0+2(3) \\\\  & =6\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|6|\\cdot \\delta A \\\\  & =6\\,\\delta A.\\end{aligned}\n$$"}]}
