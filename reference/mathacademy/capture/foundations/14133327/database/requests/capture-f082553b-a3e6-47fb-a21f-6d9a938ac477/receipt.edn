6045417 true] [17592186434424 1075 #edb/ref 17592186434410 13194139534732 17592186045417 true] [17592186434424 1075 #edb/ref 17592186434411 13194139534732 17592186045417 true] [17592186434424 1075 #edb/ref 17592186434412 13194139534732 17592186045417 true] [17592186434424 1076 #edb/ref 17592186045493 13194139534732 17592186045417 true] [17592186434424 1077 "selection" 13194139534732 17592186045417 true] [17592186434424 1078 #edb/ref 17592186434408 13194139534732 17592186045417 true] [17592186434424 1079 #uuid "9c9c34c2-a686-5dff-8116-1e613117e2fd" 13194139534732 17592186045417 true] [17592186434425 1068 #edb/ref 17592186434421 13194139534732 17592186045417 true] [17592186434425 1069 "q-152897" 13194139534732 17592186045417 true] [17592186434425 1070 #edb/ref 17592186045487 13194139534732 17592186045417 true] [17592186434425 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\{\\begin{aligned}x, & 0<x<1, \\\\ \\frac{1}{3}\\,x, & 1\\le x<2.\\end{aligned}\n$$\n\nCalculate $\\text{E}[{X}^{2}].$" 13194139534732 17592186045417 true] [17592186434425 1072 #uuid "1867bd8a-68ea-5fbb-a8c0-a7b43c7381ba" 13194139534732 17592186045417 true] [17592186434425 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the expected value of ${X}^{2}$ is given by\n\n$$\n\\text{E}[{X}^{2}]={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the expected value of ${X}^{2}$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot x\\,\\text{d}x+{\\int }_{1}^{2}{x}^{2}\\cdot \\frac{1}{3}\\,x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{3}\\,\\text{d}x+\\frac{1}{3}{\\int }_{1}^{2}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\,{x}^{4}\\,{|}_{0}^{1}+\\frac{1}{12}\\,{x}^{4}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{4}(1-0)+\\frac{1}{12}(16-1) \\\\  & =\\frac{1}{4}+\\frac{5}{4} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" 13194139534732 17592186045417 true] [17592186434426 1068 #edb/ref 17592186434422 13194139534732 17592186045417 true] [17592186434426 1069 "q-152917" 13194139534732 17592186045417 true] [17592186434426 1070 #edb/ref 17592186045487 13194139534732 17592186045417 true] [17592186434426 1071 "A continuous random variable $X$ has the probability density function \n\n$$\nf(x)=\\frac{1}{2x},\\,1\\le x\\le {e}^{2}.\n$$\n\nCalculate $\\text{E}[{X}^{4}].$" 13194139534732 17592186045417 true] [17592186434426 1072 #uuid "1a18a122-3ad0-51db-8855-5d861bdec3e8" 13194139534732 17592186045417 true] [17592186434426 1074 "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the fourth raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{4}] & ={\\int }_{1}^{{e}^{2}}{x}^{4}\\cdot \\frac{1}{2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{{e}^{2}}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\,{x}^{4}\\,{|}_{1}^{{e}^{2}} \\\\  & =\\frac{1}{8}({e}^{8}-1) \\\\  & =\\frac{{e}^{8}-1}{8}\\end{aligned}\n$$" 13194139534732 17592186045417 true] [17592186434427 1068 #edb/ref 17592186434424 13194139534732 17592186045417 true] [17592186434427 1069 "q-131142" 13194139534732 17592186045417 true] [17592186434427 1070 #edb/ref 17592186045487 13194139534732 17592186045417 true] [17592186434427 1071 "The continuous random variable $X$ has the following probability density function:\n\n$$\nf(x)=\\frac{1}{2},\\,1<x<3\n$$\n\nGiven that $\\text{E}[X]=2,$ compute $\\text{E}[5X-3{X}^{2}].$\n\n*Hint: You may assume that $\\text{E}[aX+bY]=a\\text{E}[X]+b\\text{E}[Y]$ for any random variables $X$ and $Y$ and constants $a$ and $b.$*" 13194139534732 17592186045417 true] [17592186434427 1072 #uuid "cf5c8a43-29b3-589c-9d23-ef6cc2a81919" 13194139534732 17592186045417 true] [17592186434427 1074 "First, we simplify using the hint and the properties of expected value:\n\n$$\n\\text{E}[5X-3{X}^{2}]=5\\text{E}[X]-3\\text{E}[{X}^{2}]\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nWe already know $\\text{E}[X].$ So, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{2}\\cdot \\frac{1}{2}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{{x}^{2}}{2}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{6}\\,|}_{1}^{3} \\\\  & =\\frac{13}{3}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[X]=2$ and $\\text{E}[{X}^{2}]=\\frac{13}{3}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[5X-3{X}^{2}] & =5\\text{E}[X]-3\\text{E}[{X}^{2}] \\\\  & =5\\cdot 2-3\\cdot \\frac{13}{3} \\\\  & =10-13 \\\\  & =-3.\\end{aligned}\n$$" 13194139534732 17592186045417 true] [17592186434428 1068 #edb/ref 17592186434423 13194139534732 17592186045417 true] [17592186434428 1069 "q-90394" 13194139534732 17592186045417 true] [17592186434428 1070 #edb/ref 17592186045485 13194139534732 17592186045417 true] [17592186434428 1071 "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[3{X}^{2}+4].$\n\n$$\nf(x)=2-2x,\\,0<x<1\n$$" 13194139534732 17592186045417 true] [17592186434428 1072 #uuid "fc2748a6-b91a-5b23-b40c-5cede2d8d71d" 13194139534732 17592186045417 true] [17592186434428 1074 "First, we simplify using the properties of expected value:\n\n$$\n\\text{E}[3{X}^{2}+4]=3\\text{E}[{X}^{2}]+4\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ the $n$th raw moment of $X$ is given by\n\n$$\n\\text{E}[{X}^{n}]={\\int }_{S}{x}^{n}\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we compute the second raw moment of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot (2-2x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(2{x}^{2}-2{x}^{3})\\text{d}x \\\\  & ={(\\frac{2{x}^{3}}{3}-\\frac{{x}^{4}}{2})|}_{0}^{1} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nSubstituting $\\text{E}[{X}^{2}]=\\frac{1}{6}$ into the simplified expression, we conclude that\n\n$$\n\\begin{aligned}\\text{E}[3{X}^{2}+4] & =3\\text{E}[{X}^{2}]+4 \\\\  & =3\\cdot \\frac{1}{6}+4 \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$" 13194139534732 17592186045417 true]] :edb/tempids {"answer-0d8146a1-89ab-5805-b0d1-3cb41fad7d9b" 17592186434401 "answer-1d29d5bc-decf-59aa-b33c-d8a3d6abb2c6" 17592186434402 "answer-6acb02d9-6f5a-5313-a4d3-7591b95228cb" 17592186434403 "answer-6b6e4f24-584e-5287-9823-f5033de3e1f5" 17592186434404 "answer-779d58b8-71da-535f-bbb4-074445fcafb2" 17592186434405 "answer-77b5e97e-bc6c-5d70-b0ab-61c62f43eefe" 17592186434406 "answer-7b58a9e1-f2e5-5bab-86c3-1dc62a5bf1dc" 17592186434407 "answer-83994b5b-dec3-525b-9473-71abebd50a27" 17592186434408 "answer-8e261157-b7ed-5a7f-a989-f68de2600a1a" 17592186434409 "answer-908f1924-a4cc-5cae-83ec-6a4c7872904f" 17592186434410 "answer-93d5d0a4-79ad-5a4d-854e-315f284a4eac" 17592186434411 "answer-a25f9bac-857f-5e6a-8fee-76b7ccf2820e" 17592186434412 "answer-abaaaacf-5ed0-57a2-9267-81811b57a5c4" 17592186434413 "answer-b2c4a89b-c4d2-5db7-98e5-df1b9a18f200" 17592186434414 "answer-bcd85839-7391-5b9a-80bf-f734af24df0a" 17592186434415 "answer-c0834f80-0b5a-5af1-a67a-b29a8e35f4d8" 17592186434416 "answer-c189e133-767c-5164-a4a2-027bd0af6f0c" 17592186434417 "answer-c6f4ebd2-8d57-5504-991d-9387171672e9" 17592186434418 "answer-e5fd88a3-2459-5bec-829b-d2f05e7cacbc" 17592186434419 "answer-fb1929e9-31d9-5271-b335-170151a22db2" 17592186434420 "answer-field-24eb573e-08ea-570d-9301-8fa6561f1ac2" 17592186434421 "answer-field-29094946-ea57-508c-a265-54b76fd27fdf" 17592186434422 "answer-field-3b5a9c84-ed66-57e2-9943-2424b