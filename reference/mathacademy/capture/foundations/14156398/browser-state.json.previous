tr><mtd><msqrt><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>y</mi><mn>2</mn><mn>2</mn></msubsup></msqrt></mtd><mtd><mi></mi><mo>=</mo><msqrt><mo stretchy=\"false\">(</mo><mo>−</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>12</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>25</mn><mo>+</mo><mn>144</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>169</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>13.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
