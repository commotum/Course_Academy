6045417] [17592186240524 #edb/ref 1075 #edb/ref 17592186238506 #edb/ref 17592186045417] [17592186240524 #edb/ref 1075 #edb/ref 17592186238782 #edb/ref 17592186045417] [17592186240524 #edb/ref 1075 #edb/ref 17592186239602 #edb/ref 17592186045417] [17592186240524 #edb/ref 1075 #edb/ref 17592186239819 #edb/ref 17592186045417] [17592186240524 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186240524 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186240524 #edb/ref 1078 #edb/ref 17592186238782 #edb/ref 17592186045417] [17592186240524 #edb/ref 1079 #uuid "697b8f6f-9b78-510a-bdce-c0f202963523" #edb/ref 17592186045417] [17592186241124 #edb/ref 1068 #edb/ref 17592186240338 #edb/ref 17592186045417] [17592186241124 #edb/ref 1069 "q-105760" #edb/ref 17592186045417] [17592186241124 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186241124 #edb/ref 1071 "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 \\\\ -10 & 1\\end{aligned}],\\,b=[\\begin{aligned}7 \\\\ -36\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $2\\times 2$ matrix $A,$ find the vector $y$ such that \n\n$$\n\\{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" #edb/ref 17592186045417] [17592186241124 #edb/ref 1072 #uuid "d3a99bb0-e72d-5183-bc18-0817eb820005" #edb/ref 17592186045417] [17592186241124 #edb/ref 1074 "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 0 \\\\ -10 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}] & =[\\begin{aligned}7 \\\\ -36\\end{aligned}].\\end{aligned}\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=7 \\\\ -10{y}_{1}+{y}_{2}=-36.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=7$ and ${y}_{2}=34.$ \n\nTherefore, $y=[\\begin{aligned}7 \\\\ 34\\end{aligned}].$" #edb/ref 17592186045417] [17592186241145 #edb/ref 1068 #edb/ref 17592186240524 #edb/ref 17592186045417] [17592186241145 #edb/ref 1069 "q-105934" #edb/ref 17592186045417] [17592186241145 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186241145 #edb/ref 1071 "Consider the matrix $L$ and the vector $b,$ given by \n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ -9 & 0 & 1\\end{aligned}],\\,b=[\\begin{aligned}9 \\\\ 7 \\\\ -1\\end{aligned}].\n$$\n\nIf $A=LU$ is the LU factorization of some $3\\times 3$ matrix $A,$ find the vector $y$ such that\n\n$$\n\\{\\begin{aligned}Ly=b \\\\ Ux=y\\end{aligned}\n$$\n\nis equivalent to $Ax=b.$" #edb/ref 17592186045417] [17592186241145 #edb/ref 1072 #uuid "90586eea-75b4-50dc-8971-26e34a9a2816" #edb/ref 17592186045417] [17592186241145 #edb/ref 1074 "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ -9 & 0 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{aligned}]=[\\begin{aligned}9 \\\\ 7 \\\\ -1\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=9 \\\\ 7{y}_{1}+{y}_{2}=7 \\\\ -9{y}_{1}+{y}_{3}=-1.\\end{aligned}\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =9, \\\\ {y}_{2} & =7-7{y}_{1} \\\\  & =7-7(9) \\\\  & =-56, \\\\ {y}_{3} & =-1+9{y}_{1} \\\\  & =-1+9(9) \\\\  & =80.\\end{aligned}\n$$\n\nTherefore, \n$y=[\\begin{aligned}9 \\\\ -56 \\\\ 80\\end{aligned}].$" #edb/ref 17592186045417] [17592186241147 #edb/ref 1068 #edb/ref 17592186240485 #edb/ref 17592186045417] [17592186241147 #edb/ref 1069 "q-105953" #edb/ref 17592186045417] [17592186241147 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186241147 #edb/ref 1071 "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}7 & 3 \\\\ 0 & -2\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}5 \\\\ 4\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{2}?$" #edb/ref 17592186045417] [17592186241147 #edb/ref 1072 #uuid "68b89d00-e814-5d60-8ff8-bbe1b29f01fc" #edb/ref 17592186045417] [17592186241147 #edb/ref 1074 "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,\\{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}5 \\\\ 4\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}{y}_{1}=5 \\\\ -2{y}_{1}+{y}_{2}=4.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=5$ and ${y}_{2}=14.$ Therefore, \n\n$$\ny=[\\begin{aligned}5 \\\\ 14\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}7 & 3 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}5 \\\\ 14\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n\\{\\begin{aligned}7{x}_{1}+3{x}_{2}=5 \\\\ -2{x}_{2}=14.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=-7$ and ${x}_{1}=\\frac{26}{7}.$ Therefore, \n\n$$\nx=[\\begin{aligned}\\frac{26}{7} \\\\ -7\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{2}=\\frac{26}{7}\\cdot 14=52.$" #edb/ref 17592186045417] [17592186300250 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186300250 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300250 #edb/ref 1083 #uuid "3be1af41-0c7e-535a-9a86-a5c82122dcdb" #edb/ref 17592186045417] [17592186300659 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186300659 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300659 #edb/ref 1083 #uuid "89b9efd6-ce79-56d0-af07-0e42c41ffec0" #edb/ref 17592186045417] [17592186300728 #edb/ref 1080 "-6" #edb/ref 17592186045417] [17592186300728 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300728 #edb/ref 1083 #uuid "98709d57-b5d1-505c-a13b-2435f487b4d9" #edb/ref 17592186045417] [17592186300866 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186300866 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300866 #edb/ref 1083 #uuid "b5fc1198-c5b8-53d4-8b4a-c8b8adf38ad5" #edb/ref 17592186045417] [17592186300871 #edb/ref 1080 "-3" #edb/ref 17592186045417] [17592186300871 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186300871 #edb/ref 1083 #uuid "b65d5146-dbe1-5221-b3af-8171d063039f" #edb/ref 17592186045417] [17592186301437 #edb/ref 1075 #edb/ref 17592186300250 #edb/ref 17592186045417] [17592186301437 #edb/ref 1075 #edb/ref 17592186300659 #edb/ref 17592186045417] [17592186301437 #edb/ref 1075 #edb/ref 17592186300728 #edb/ref 17592186045417] [17592186301437 #edb/ref 1075 #edb/ref 17592186300866 #edb/ref 17592186045417] [17592186301437 #edb/ref 1075 #edb/ref 17592186300871 #edb/ref 17592186045417] [17592186301437 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186301437 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186301437 #edb/ref 1078 #edb/ref 17592186300728 #edb/ref 17592186045417] [1759218