#{[{:db/id #edb/ref 17592186148165 :knowledge-point/_questions [{:db/id #edb/ref 17592186147446 :knowledge-point/id #uuid "dfa8f9b2-1628-5f9f-8f0e-0fd6c01c70d4" :knowledge-point/title "Constructing a Differential Equation Governing a Damped Harmonic Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8cce54-8d1b-5552-8013-ecc91a4ca4d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+\\sqrt{5}y=0" :db/id #edb/ref 17592186333085} {:answer/id #uuid "27aad3bf-b0f4-5a87-99db-444aae8d77be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+5y=0" :db/id #edb/ref 17592186333353} {:answer/id #uuid "8567aa7e-ea4a-5013-9a78-d111c421b739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+\\sqrt{5}y=0" :db/id #edb/ref 17592186334176} {:answer/id #uuid "c7a03806-83d4-5e14-86fa-53eac968e9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+5y=0" :db/id #edb/ref 17592186334724} {:answer/id #uuid "fddbde14-0a61-5c46-b4ec-42db0bc313c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4{y}^{′}+10y=0" :db/id #edb/ref 17592186335222}] :answer-field/correct {:answer/id #uuid "27aad3bf-b0f4-5a87-99db-444aae8d77be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+5y=0" :db/id #edb/ref 17592186333353} :answer-field/id #uuid "8a0d3c34-b28e-527f-9cd6-b4c78c62ebfe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335502}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39f1ef46-09c9-5bbf-b30f-92ddff3f269a" :question/math-academy-id "q-64544" :question/problem "A particle of mass $2\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=10\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=4\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n2{y}^{″}=-4{y}^{′}-10y.\n$$\n\nRearranging the above equation, we get:\n\n$$\n{y}^{″}+2{y}^{′}+5y=0\n$$"}] [{:db/id #edb/ref 17592186148176 :knowledge-point/_questions [{:db/id #edb/ref 17592186147444 :knowledge-point/id #uuid "aad85367-37ea-500f-8405-f9464bf4f773" :knowledge-point/title "Identifying Equations that Represent Damped Harmonic Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5898a6ac-6276-53c2-8174-421d58a64302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+6{y}^{′}-36y=0" :db/id #edb/ref 17592186492387} {:answer/id #uuid "98baa58c-cc87-572a-a2cc-76a2b22b2949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+6y=t{e}^{2t}" :db/id #edb/ref 17592186492512} {:answer/id #uuid "cf48a76b-b34b-52d6-9b6c-82a901119ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+4y=\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186492627} {:answer/id #uuid "e1ec7c0c-764a-586c-b9c0-5e640d3e5d0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+14y=0" :db/id #edb/ref 17592186492656} {:answer/id #uuid "edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+5{y}^{′}+4y=0" :db/id #edb/ref 17592186492676}] :answer-field/correct {:answer/id #uuid "edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+5{y}^{′}+4y=0" :db/id #edb/ref 17592186492676} :answer-field/id #uuid "5b280057-4b77-5222-8500-d6db2864a327" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146810}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33cf3153-c27d-5bbc-907b-c204e6c3dd74" :question/math-academy-id "q-64589" :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+5{y}^{′}+4y=0.\n$$"}] [{:db/id #edb/ref 17592186335725 :knowledge-point/_questions [{:db/id #edb/ref 17592186147445 :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/title "Identifying Types of Damped Oscillations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f631397-1fc5-5f73-8f1c-6752ba962aca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451465} {:answer/id #uuid "bdd4b1af-69f4-5724-900e-69d4836fcf5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451466}] :answer-field/correct {:answer/id #uuid "bdd4b1af-69f4-5724-900e-69d4836fcf5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451466} :answer-field/id #uuid "6374e92f-3ad0-501c-9e81-fde082964406" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452580} {:answer-field/choices [{:answer/id #uuid "9fca6602-54be-566a-94ca-51a24f960139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451467} {:answer/id #uuid "7ef9320d-e4ac-5a81-bcca-b06cac9ffce1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451468}] :answer-field/correct {:answer/id #uuid "9fca6602-54be-566a-94ca-51a24f960139" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451467} :answer-field/id #uuid "f4230243-b999-5225-8057-f0e153de4518" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452581} {:answer-field/choices [{:answer/id #uuid "e7875532-f5c7-5be9-bb70-9565d2e57d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451469} {:answer/id #uuid "10d8e653-fcc4-5468-9d5b-1c81e9786209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451470}] :answer-field/correct {:answer/id #uuid "e7875532-f5c7-5be9-bb70-9565d2e57d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451469} :answer-field/id #uuid "b08c2525-28fa-502f-a408-27b29f00cddd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dca080f-586e-56e2-9297-7dcd4b704b21" :question/math-academy-id "q-64615" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${y}^{″}+4{y}^{′}+8y=0$ represents an oscillator undergoing light damping.\n- **II.** ${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing heavy damping.\n- **III.** ${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing critical damping." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+4{y}^{′}+8y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +8=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(8) & =-16<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+6{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+6\\lambda +9=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(9) & =0\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+3{y}^{′}+2y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+3\\lambda +2=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(2) & =1>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186492860 :knowledge-point/_questions [{:db/id #edb/ref 17592186147446 :knowledge-point/id #uuid "dfa8f9b2-1628-5f9f-8f0e-0fd6c01c70d4" :knowledge-point/title "Constructing a Differential Equation Governing a Damped Harmonic Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57c78e60-9652-56b2-b93f-2476d1e583aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+2y=0" :db/id #edb/ref 17592186492384} {:answer/id #uuid "616b6e13-f025-52ac-b464-e1464f7dc509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+{y}^{′}+y=0" :db/id #edb/ref 17592186492414} {:answer/id #uuid "98f9ec65-c855-5e81-b0cc-f12a6f566426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+6y=0" :db/id #edb/ref 17592186492513} {:answer/id #uuid "9cf8994c-214a-592c-b261-82613704efbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+6{y}^{′}+6y=0" :db/id #edb/ref 17592186492522} {:answer/id #uuid "f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+2y=0" :db/id #edb/ref 17592186492685}] :answer-field/correct {:answer/id #uuid "f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{″}+2{y}^{′}+2y=0" :db/id #edb/ref 17592186492685} :answer-field/id #uuid "75bd61b2-2c49-5cb8-900c-1fc581123b01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53714f34-122d-5a8f-aba0-bbac28e356b1" :question/math-academy-id "q-94323" :question/problem "A particle of mass $6\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=12\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=12\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n6{y}^{″}=-12{y}^{′}-12y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+2{y}^{′}+2y=0.\n$$"}] [{:db/id #edb/ref 17592186357735 :knowledge-point/_questions [{:db/id #edb/ref 17592186147447 :knowledge-point/id #uuid "48a64312-22d5-57ed-b83b-254aff2ca870" :knowledge-point/title "Calculating the Period of a Damped Oscillation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae5ca6c-b6ab-5388-877b-d5ca6d9eb62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186354765} {:answer/id #uuid "5d972e39-e927-56e2-b99d-4e46df052c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi \\,\\text{s}" :db/id #edb/ref 17592186355493} {:answer/id #uuid "81c20bc1-e47f-5c2e-9a46-0acdaacc1125" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi \\,\\text{s}" :db/id #edb/ref 17592186355805} {:answer/id #uuid "90f39a76-999a-5f5e-af3a-84399b5b4654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}\\,\\text{s}" :db/id #edb/ref 17592186355944} {:answer/id #uuid "e250ca5b-a5c5-5fac-99d7-b0a98c858d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\,\\text{s}" :db/id #edb/ref 17592186356645}] :answer-field/correct {:answer/id #uuid "0ae5ca6c-b6ab-5388-877b-d5ca6d9eb62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186354765} :answer-field/id #uuid "85e1d4a0-4f40-5e9a-ab7c-ce32e079e4e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357156}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5422f95b-90d3-50c4-8d3e-e9b726ff2915" :question/math-academy-id "q-94363" :question/problem "The position $y(t)$ of a particle oscillating with light damped harmonic motion is governed by the equation\n\n$$\n{y}^{″}+12{y}^{′}+52y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the damped oscillation?" :question/worked-solution "The given equation represents the equation of damped harmonic motion. We are looking for solutions of the form $y={e}^{\\lambda t}.$\n\nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+12\\lambda +52=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+12\\lambda +52 & =0 \\\\ ({\\lambda }^{2}+12\\lambda +36)-36+52 & =0 \\\\ (\\lambda +6)^{2}+16 & =0 \\\\ (\\lambda +6)^{2} & =-16 \\\\ \\lambda +6 & =\\pm 4\\text{i} \\\\ \\lambda  & =-6\\pm 4\\text{i}\\end{aligned}\n$$\n\nSo, the general solution is\n\n$$\n{y}_{c}={e}^{-6t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t).\n$$\n\nFrom the solution, the value of the angular frequency is $Ω=4\\,{\\text{s}}^{-1}.$\n\nThe period of the damped oscillation $T$ is related to the angular frequency as follows:\n\n$$\nT=\\frac{2\\pi }{Ω}\n$$\n\nSo the period is\n\n$$\nT=\\frac{2\\pi }{4}=\\frac{\\pi }{2}\\,\\text{s}.\n$$"}]}
