maxsize=\"1.2em\">(</mo></mrow><mn>2</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>4</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mn>8</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><mn>8</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mn>16</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup><mo>−</mo><mn>16</mn><msup><mi>u</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
