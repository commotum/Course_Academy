 data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>98</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>−</mo><mn>7</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">|</mo></mrow><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
