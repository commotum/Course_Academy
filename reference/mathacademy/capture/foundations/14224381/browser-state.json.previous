      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224381/observations/step-q127254-d09e56f893e8b9d1637a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224381/observations/step-q127254-d09e56f893e8b9d1637a.png",
