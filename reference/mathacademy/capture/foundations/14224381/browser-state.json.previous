      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224381/observations/step-q127079-a85f993671090fd1fb1d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224381/observations/step-q127079-a85f993671090fd1fb1d.png",
      "source_url": "https://mathacademy.com/tasks/14224381/topics/3716/lesson",
      "captured_at": 1792041626.8989222,
      "math_academy_id": "q-127079",
