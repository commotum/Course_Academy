#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134602} :activity/id #uuid "50a0ef69-74ee-5204-af04-a18cf1e2ad62" :activity/scope {:db/id #edb/ref 17592186048947 :topic/id #uuid "ce6678f7-de9f-5b74-8e66-34eb49059878" :topic/math-academy-id 2089} :activity/steps [{:db/id #edb/ref 17592186134602 :step/content {:db/id #edb/ref 17592186135024 :tutorial/content "Applying a row operation to any $3\\times 3$ matrix is the same as *pre-multiplying* (multiplying on the left) the matrix by the corresponding elementary matrix.\n\nFor instance, if we wish to swap the first row and the second row of a $3\\times 3$ matrix $A,$ we pre-multiply $A$ by the corresponding elementary matrix \n![](images/2d/2de2ee02cbd3b00b6945fc8df8d84e83920fc0889c76394c1c726c94d68b1d99.svg)\nto get $E_1 A.$\n\nTo perform a sequence of row operations to a $3\\times 3$ matrix, we pre-multiply the matrix by the elementary matrix corresponding to the first operation, and then pre-multiply the result by the elementary matrix corresponding to the second operation.\n\nFor instance, given a $3 \\times 3$ matrix $A,$ suppose that we would like to multiply the second row by $2$ and then add $3$ times the first row to the second row. To do this, we first pre-multiply $A$ by \n![](images/61/61f42ffa5ee0defeb3330421ead9c42f84200b274577c96cffe1d59ed9cf5cef.svg)\nto get $E_2 A.$ Then we pre-multiply the result by \n![](images/be/be5d3785649ca7ac1557b43ca434c2558af417d29db47c10ef2938c1099db6f5.svg) \nto get $E_3 E_2 A.$" :tutorial/id #uuid "c110a2ca-8856-5b26-9ded-2e9f35023747" :tutorial/math-academy-id 3171 :tutorial/title "Introduction"} :step/id #uuid "fa6e7f35-addb-57cf-a360-9e6406254399" :step/math-academy-id 17243 :step/next {:db/id #edb/ref 17592186134603}} {:db/id #edb/ref 17592186134603 :step/content {:db/id #edb/ref 17592186133742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133552 :question/id #uuid "126c85b8-d721-5e7d-a3dc-df997bc0b9ce" :question/math-academy-id "e-4732"} :knowledge-point/id #uuid "b0341b26-9c91-5b8a-a917-20129155e336" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048373} {:db/id #edb/ref 17592186048897}] :knowledge-point/questions [{:db/id #edb/ref 17592186134189} {:db/id #edb/ref 17592186134190} {:db/id #edb/ref 17592186247123} {:db/id #edb/ref 17592186247124} {:db/id #edb/ref 17592186329666} {:db/id #edb/ref 17592186345028} {:db/id #edb/ref 17592186478375} {:db/id #edb/ref 17592186478461}] :knowledge-point/title "Finding the Row Operation Equivalent To Left Multiplication by an Elementary Matrix"} :step/id #uuid "2fd97122-b858-5040-a119-fad68a3d03fd" :step/math-academy-id 17244 :step/next {:db/id #edb/ref 17592186134604}} {:db/id #edb/ref 17592186134604 :step/content {:db/id #edb/ref 17592186133743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133553 :question/id #uuid "f8eb89c4-1cca-5f8c-909c-31e9e0fc8412" :question/math-academy-id "e-4733"} :knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba" :knowledge-point/questions [{:db/id #edb/ref 17592186134187} {:db/id #edb/ref 17592186134396} {:db/id #edb/ref 17592186247125} {:db/id #edb/ref 17592186247126} {:db/id #edb/ref 17592186302068} {:db/id #edb/ref 17592186302070} {:db/id #edb/ref 17592186329662} {:db/id #edb/ref 17592186329664} {:db/id #edb/ref 17592186329665} {:db/id #edb/ref 17592186478453}] :knowledge-point/title "Finding the Matrix Left Multiplication Equivalent To a Given Row Operation"} :step/id #uuid "da013532-9009-5401-a121-9e5bc3920d43" :step/math-academy-id 17245 :step/next {:db/id #edb/ref 17592186134605}} {:db/id #edb/ref 17592186134605 :step/content {:db/id #edb/ref 17592186133744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133554 :question/id #uuid "6e47a532-ba7a-5692-961b-eabc743d74e6" :question/math-academy-id "e-4734"} :knowledge-point/id #uuid "00b69189-1ae1-5625-adfb-e5460845c776" :knowledge-point/questions [{:db/id #edb/ref 17592186134188} {:db/id #edb/ref 17592186134397} {:db/id #edb/ref 17592186247127} {:db/id #edb/ref 17592186247128} {:db/id #edb/ref 17592186247129} {:db/id #edb/ref 17592186302051} {:db/id #edb/ref 17592186302071} {:db/id #edb/ref 17592186329663} {:db/id #edb/ref 17592186345037} {:db/id #edb/ref 17592186478383}] :knowledge-point/title "Finding the Matrix Left Multiplication Equivalent To a Sequence of Row Operations"} :step/id #uuid "ec9418ab-c448-5510-808b-5f8b1a2094a7" :step/math-academy-id 17246}] :activity/title "Row Operations on 3x3 Matrices as Products of Elementary Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186133980}]}
