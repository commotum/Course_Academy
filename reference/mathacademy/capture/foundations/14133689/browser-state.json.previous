ble displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.6em 0.3em\"><mtr><mtd><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy=\"false\">]</mo><mo>−</mo><mtext>E</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><msup><mo stretchy=\"false\">]</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>1.882</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>54</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mn>1.238</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>10</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.35</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> \nrounded to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"63\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
