[{:db/id 17592186192788 :knowledge-point/questions ["question-0ee0de2e-5389-59ac-b881-e7c459d89539"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186275459 :question/problem "Compute $P(X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{24}({x}^{2}+1),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186275460 :question/problem "Compute $P(X>-3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{72}{x}^{2},\\, & -6\\le x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186419853 :question/problem "Compute $P(-1<X<0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{12}({x}^{2}+2),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{8} & 1<x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186278187 :question/problem "Compute $P(0<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}({x}^{3}+1),\\, & -1\\le x<1, \\\\ \\frac{1}{24}x & 1\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-0ee0de2e-5389-59ac-b881-e7c459d89539" :question/id #uuid "0ee0de2e-5389-59ac-b881-e7c459d89539" :question/math-academy-id "q-158461" :question/problem "Compute $P(X\\le 0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{20}(3{x}^{2}+2x+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<-2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 0) & ={\\int }_{-2}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-2}^{0}\\frac{1}{20}(3{x}^{2}+2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{20}{\\int }_{-2}^{0}3{x}^{2}+2x+1\\,\\text{d}x \\\\  & =\\frac{1}{20}{[{x}^{3}+{x}^{2}+x]}_{-2}^{0} \\\\  & =\\frac{1}{20}([{0}^{3}+{0}^{2}+0]-[(-2)^{3}+(-2)^{2}+(-2)]) \\\\  & =\\frac{1}{20}(0-[-8+4-2]) \\\\  & =\\frac{1}{20}\\cdot 6 \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e2057c9f-e99d-5d1c-a575-837b0893982e"] :db/ensure [:question/validate]} {:db/id "answer-field-e2057c9f-e99d-5d1c-a575-837b0893982e" :answer-field/id #uuid "e2057c9f-e99d-5d1c-a575-837b0893982e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer-field/choices ["answer-c0132ea6-fdc2-5a17-acb2-a6b30862b933" "answer-f1b44f8c-0f09-5979-a51a-7558f4d266c3" "answer-c404deb2-b7c8-573d-8c43-7e7ec28f3b65" "answer-57650fd3-48dd-55d0-ac9f-7d32e8ecc4b8" "answer-05e8a10c-8bca-5b60-94fa-c58a19413d8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer/id #uuid "c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer/type :answer.type/math :answer/value "\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-f1b44f8c-0f09-5979-a51a-7558f4d266c3" :answer/id #uuid "f1b44f8c-0f09-5979-a51a-7558f4d266c3" :answer/type :answer.type/math :answer/value "\\frac{3}{20}" :db/ensure [:answer/validate]} {:db/id "answer-c404deb2-b7c8-573d-8c43-7e7ec28f3b65" :answer/id #uuid "c404deb2-b7c8-573d-8c43-7e7ec28f3b65" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-57650fd3-48dd-55d0-ac9f-7d32e8ecc4b8" :answer/id #uuid "57650fd3-48dd-55d0-ac9f-7d32e8ecc4b8" :answer/type :answer.type/math :answer/value "\\frac{7}{10}" :db/ensure [:answer/validate]} {:db/id "answer-05e8