#{[{:db/id #edb/ref 17592186275459 :knowledge-point/_questions [{:db/id #edb/ref 17592186192788 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052459b5-32fe-5a93-b48b-e733fac244d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186272434} {:answer/id #uuid "09f7d73c-c7ee-52c8-9189-640706a28aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186272477} {:answer/id #uuid "c76bdcab-c03f-5229-8d6c-4ac9d282117c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186274120} {:answer/id #uuid "c778c7da-afc4-5bd5-b2f1-bcc32a8fc807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186274122} {:answer/id #uuid "f414363f-835b-53bb-9b0c-4cd9b3378183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274543}] :answer-field/correct {:answer/id #uuid "09f7d73c-c7ee-52c8-9189-640706a28aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186272477} :answer-field/id #uuid "e1f7daa1-80eb-5764-a426-2110070d9e2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275031}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f58db6-2e5f-58ae-a9a5-9aa2f152a653" :question/math-academy-id "q-158309" :question/problem "Compute $P(X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{24}({x}^{2}+1),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{24}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{24}{\\int }_{1}^{3}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{1}{24}{[\\frac{{x}^{3}}{3}+x]}_{1}^{3} \\\\  & =\\frac{1}{24}[(\\frac{{3}^{3}}{3}+3)-(\\frac{1}{3}+1)] \\\\  & =\\frac{1}{24}(12-\\frac{4}{3}) \\\\  & =\\frac{1}{24}\\cdot \\frac{32}{3} \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275460 :knowledge-point/_questions [{:db/id #edb/ref 17592186192788 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a02ae6e-0506-5c3e-842e-2d36e9955a2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186272611} {:answer/id #uuid "1b27c71e-715d-563a-b143-9a7e7dade11e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186272619} {:answer/id #uuid "352fdf1f-1c35-5952-8b5a-ab2dea63c3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186272858} {:answer/id #uuid "44ddfa3a-38ea-5840-9c97-21475c3e27e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272974} {:answer/id #uuid "a09352eb-ece5-548c-9db8-6b063dbf41eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186273778}] :answer-field/correct {:answer/id #uuid "44ddfa3a-38ea-5840-9c97-21475c3e27e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272974} :answer-field/id #uuid "9a0add09-f8b7-5571-85b6-3994fc452dcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274905}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93973542-05ae-5f66-9567-d5a70adf747f" :question/math-academy-id "q-158310" :question/problem "Compute $P(X>-3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{72}{x}^{2},\\, & -6\\le x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>0,$ we have\n\n$$\n\\begin{aligned}P(X>-3) & ={\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}\\frac{1}{72}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{216}{x}^{3}]}_{-3}^{0} \\\\  & =\\frac{1}{216}[(0)^{3}-(-3)^{3}] \\\\  & =\\frac{27}{216} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419853 :knowledge-point/_questions [{:db/id #edb/ref 17592186192789 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384b21df-8a7c-5b30-9125-1330da362a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186419836} {:answer/id #uuid "3e21377a-680e-57d6-80e2-410c96b326e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186419837} {:answer/id #uuid "6c20cdc4-8968-5346-8c22-76a6ecf55625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186419839} {:answer/id #uuid "e2afce84-edf6-5026-8a56-a45c4ffb8701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{36}" :db/id #edb/ref 17592186419843} {:answer/id #uuid "f1943a76-0ce9-5efd-8b74-da642c9f9e88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186419845}] :answer-field/correct {:answer/id #uuid "6c20cdc4-8968-5346-8c22-76a6ecf55625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186419839} :answer-field/id #uuid "d0b9338f-ce76-54a7-9f1b-a16c716aaa54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" :question/math-academy-id "q-158421" :question/problem "Compute $P(-1<X<0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{12}({x}^{2}+2),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{8} & 1<x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X<0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{1}{12}({x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{1}{12}{[\\frac{1}{3}{x}^{3}+2x]}_{-1}^{0} \\\\  & =\\frac{1}{12}([\\frac{1}{3}(0)^{3}+2(0)]-[\\frac{1}{3}(-1)^{3}+2(-1)]) \\\\  & =\\frac{1}{12}(0+\\frac{1}{3}+2) \\\\  & =\\frac{1}{12}(\\frac{7}{3}) \\\\  & =\\frac{7}{36}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278187 :knowledge-point/_questions [{:db/id #edb/ref 17592186192789 :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1028c364-ce75-5836-a84c-a7b8c7109998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186275619} {:answer/id #uuid "37590d2d-228a-54b7-9ea1-ddb7e5c81f4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{24}" :db/id #edb/ref 17592186275969} {:answer/id #uuid "5b184341-4aed-5427-a6ea-c4f9d55ff988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186276293} {:answer/id #uuid "78b9fe3f-4e98-52de-bbf1-6f4e65819078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186276572} {:answer/id #uuid "e782edc4-7e83-59f7-a604-01cdc3eef141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186277501}] :answer-field/correct {:answer/id #uuid "5b184341-4aed-5427-a6ea-c4f9d55ff988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186276293} :answer-field/id #uuid "b41386b3-26a4-5507-8fde-5cf49c81cb7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278040}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2c51ecb-6d65-53cb-ba0b-d70d6940d33b" :question/math-academy-id "q-158443" :question/problem "Compute $P(0<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}({x}^{3}+1),\\, & -1\\le x<1, \\\\ \\frac{1}{24}x & 1\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0<X\\le 5) & ={\\int }_{0}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{4}({x}^{3}+1)\\,\\text{d}x+{\\int }_{1}^{5}\\frac{1}{24}x\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{1}{4}{x}^{4}+x]}_{0}^{1}+{[\\frac{1}{48}{x}^{2}]}_{1}^{5} \\\\  & =\\frac{1}{4}([\\frac{1}{4}(1)^{4}+1]-[\\frac{1}{4}(0)^{4}+0])+\\frac{1}{48}[{5}^{2}-{1}^{2}] \\\\  & =\\frac{1}{4}(\\frac{5}{4})+\\frac{1}{2} \\\\  & =\\frac{5}{16}+\\frac{1}{2} \\\\  & =\\frac{13}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186426229 :knowledge-point/_questions [{:db/id #edb/ref 17592186192788 :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e8a10c-8bca-5b60-94fa-c58a19413d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{20}" :db/id #edb/ref 17592186426223} {:answer/id #uuid "57650fd3-48dd-55d0-ac9f-7d32e8ecc4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186426224} {:answer/id #uuid "c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186426225} {:answer/id #uuid "c404deb2-b7c8-573d-8c43-7e7ec28f3b65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186426226} {:answer/id #uuid "f1b44f8c-0f09-5979-a51a-7558f4d266c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186426227}] :answer-field/correct {:answer/id #uuid "c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186426225} :answer-field/id #uuid "e2057c9f-e99d-5d1c-a575-837b0893982e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ee0de2e-5389-59ac-b881-e7c459d89539" :question/math-academy-id "q-158461" :question/problem "Compute $P(X\\le 0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{20}(3{x}^{2}+2x+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<-2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 0) & ={\\int }_{-2}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-2}^{0}\\frac{1}{20}(3{x}^{2}+2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{20}{\\int }_{-2}^{0}3{x}^{2}+2x+1\\,\\text{d}x \\\\  & =\\frac{1}{20}{[{x}^{3}+{x}^{2}+x]}_{-2}^{0} \\\\  & =\\frac{1}{20}([{0}^{3}+{0}^{2}+0]-[(-2)^{3}+(-2)^{2}+(-2)]) \\\\  & =\\frac{1}{20}(0-[-8+4-2]) \\\\  & =\\frac{1}{20}\\cdot 6 \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$"}]}
