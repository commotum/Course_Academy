#{[{:activity/first-step {:db/id #edb/ref 17592186193669} :activity/id #uuid "d93075cf-1282-5b7f-b71d-4c5f5fd85e47" :activity/scope {:db/id #edb/ref 17592186048627 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186193668 :step/content {:db/id #edb/ref 17592186192792 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192516 :question/id #uuid "00b0d838-163d-5299-beaf-255f9b13cf71" :question/math-academy-id "e-11034"} :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048687} {:db/id #edb/ref 17592186048905} {:db/id #edb/ref 17592186050929} {:db/id #edb/ref 17592186051039}] :knowledge-point/questions [{:db/id #edb/ref 17592186193212} {:db/id #edb/ref 17592186193213} {:db/id #edb/ref 17592186278577} {:db/id #edb/ref 17592186278578} {:db/id #edb/ref 17592186278579} {:db/id #edb/ref 17592186278580} {:db/id #edb/ref 17592186278581} {:db/id #edb/ref 17592186278586} {:db/id #edb/ref 17592186278589} {:db/id #edb/ref 17592186281290} {:db/id #edb/ref 17592186378856} {:db/id #edb/ref 17592186378877}] :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"} :step/id #uuid "a9a56a41-bd42-55bc-97e0-3044e441a107" :step/math-academy-id 41922} {:db/id #edb/ref 17592186193669 :step/content {:db/id #edb/ref 17592186193891 :tutorial/content "The **boundary** of a set $S,$ denoted $\\partial S,$ is the set that contains all the boundary points of $S.$\n\nFor example, consider the set $A,$ given by \n\n$$\nA = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\leq 1, \\, 0 \\lt y \\leq 2 \\big\\}.\n$$\n\nWe can represent this set as the following shaded region.\n\n![](images/50/5033928a09f9c320973a223bfd49b4b67924b433c7ba53e58bc07a95905f4231.png)\n\nThen, the set $\\partial A,$ the boundary of $A,$ has the following representation in the plane.\n\n![](images/e2/e2034b17b6a6834c1d747e2eba4a2522c43e9ff888d5f7feb7bf716b3e2cec00.png)\n\nThe **interior** of a set $S,$ denoted $\\textrm{int}\\, S,$ is the set containing all the interior points of $S.$ It contains every point in $S$ except the boundary points: \n\n$$\n\\textrm{int}\\,S = S - \\partial S\n$$\n\nFor our set $A$ defined above, the interior looks as follows:\n\n![](images/57/57ab8735d761926a36aa0e469b4637482c31880cc446d913f93755a12ec65a8f.png)\n\nMore formally, the interior of $A$ is given by\n\n$$\n\\textrm{int}\\,A = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\lt 1, \\, 0 \\lt y \\lt 2 \\big\\}.\n$$" :tutorial/id #uuid "0e637424-4284-59d5-be69-a86587836ad8" :tutorial/math-academy-id 6925 :tutorial/title "Introduction"} :step/id #uuid "a6d2c5fc-ab0d-5230-b12f-968073fd01a2" :step/math-academy-id 41923 :step/next {:db/id #edb/ref 17592186193702}} {:db/id #edb/ref 17592186193670 :step/content {:db/id #edb/ref 17592186192793 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192517 :question/id #uuid "a8045dd8-90b8-5671-9003-2539c502cb49" :question/math-academy-id "e-11035"} :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/questions [{:db/id #edb/ref 17592186193185} {:db/id #edb/ref 17592186193330} {:db/id #edb/ref 17592186241003} {:db/id #edb/ref 17592186281308} {:db/id #edb/ref 17592186281309} {:db/id #edb/ref 17592186281312} {:db/id #edb/ref 17592186281316} {:db/id #edb/ref 17592186281317} {:db/id #edb/ref 17592186339014} {:db/id #edb/ref 17592186379979} {:db/id #edb/ref 17592186401274}] :knowledge-point/title "Identifying the Interior of a Set"} :step/id #uuid "9d5d8127-b825-594a-81df-e04296e04e38" :step/math-academy-id 41924 :step/next {:db/id #edb/ref 17592186193668}} {:db/id #edb/ref 17592186193702 :step/content {:db/id #edb/ref 17592186192808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192536 :question/id #uuid "44971e25-0367-5b13-a6be-db503c6b4539" :question/math-academy-id "e-12399"} :knowledge-point/id #uuid "e534c006-a5b4-5f