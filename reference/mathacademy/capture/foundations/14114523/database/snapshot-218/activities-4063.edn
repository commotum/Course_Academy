#{[{:activity/first-step {:db/id #edb/ref 17592186193669} :activity/id #uuid "d93075cf-1282-5b7f-b71d-4c5f5fd85e47" :activity/scope {:db/id #edb/ref 17592186048627 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186193668 :step/content {:db/id #edb/ref 17592186192792 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192516 :question/id #uuid "00b0d838-163d-5299-beaf-255f9b13cf71" :question/math-academy-id "e-11034"} :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048687} {:db/id #edb/ref 17592186048905} {:db/id #edb/ref 17592186050929} {:db/id #edb/ref 17592186051039}] :knowledge-point/questions [{:db/id #edb/ref 17592186193212} {:db/id #edb/ref 17592186193213} {:db/id #edb/ref 17592186278577} {:db/id #edb/ref 17592186278578} {:db/id #edb/ref 17592186278579} {:db/id #edb/ref 17592186278580} {:db/id #edb/ref 17592186278581} {:db/id #edb/ref 17592186278586} {:db/id #edb/ref 17592186278589} {:db/id #edb/ref 17592186281290} {:db/id #edb/ref 17592186378856} {:db/id #edb/ref 17592186378877}] :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"} :step/id #uuid "a9a56a41-bd42-55bc-97e0-3044e441a107" :step/math-academy-id 41922} {:db/id #edb/ref 17592186193669 :step/content {:db/id #edb/ref 17592186193891 :tutorial/content "The **boundary** of a set $S,$ denoted $\\partial S,$ is the set that contains all the boundary points of $S.$\n\nFor example, consider the set $A,$ given by \n\n$$\nA = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\leq 1, \\, 0 \\lt y \\leq 2 \\big\\}.\n$$\n\nWe can represent this set as the following shaded region.\n\n![](images/50/5033928a09f9c320973a223bfd49b4b67924b433c7ba53e58bc07a95905f4231.png)\n\nThen, the set $\\partial A,$ the boundary of $A,$ has the following representation in the plane.\n\n![](images/e2/e2034b17b6a6834c1d747e2eba4a2522c43e9ff888d5f7feb7bf716b3e2cec00.png)\n\nThe **interior** of a set $S,$ denoted $\\textrm{int}\\, S,$ is the set containing all the interior points of $S.$ It contains every point in $S$ except the boundary points: \n\n$$\n\\textrm{int}\\,S = S - \\partial S\n$$\n\nFor our set $A$ defined above, the interior looks as follows:\n\n![](images/57/57ab8735d761926a36aa0e469b4637482c31880cc446d913f93755a12ec65a8f.png)\n\nMore formally, the interior of $A$ is given by\n\n$$\n\\textrm{int}\\,A = \\big\\{ (x,y)\\in\\mathbb R^2 \\,:\\, -1 \\lt x \\lt 1, \\, 0 \\lt y \\lt 2 \\big\\}.\n$$" :tutorial/id #uuid "0e637424-4284-59d5-be69-a86587836ad8" :tutorial/math-academy-id 6925 :tutorial/title "Introduction"} :step/id #uuid "a6d2c5fc-ab0d-5230-b12f-968073fd01a2" :step/math-academy-id 41923 :step/next {:db/id #edb/ref 17592186193702}} {:db/id #edb/ref 17592186193670 :step/content {:db/id #edb/ref 17592186192793 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192517 :question/id #uuid "a8045dd8-90b8-5671-9003-2539c502cb49" :question/math-academy-id "e-11035"} :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/questions [{:db/id #edb/ref 17592186193185} {:db/id #edb/ref 17592186193330} {:db/id #edb/ref 17592186241003} {:db/id #edb/ref 17592186281308} {:db/id #edb/ref 17592186281309} {:db/id #edb/ref 17592186281312} {:db/id #edb/ref 17592186281316} {:db/id #edb/ref 17592186281317} {:db/id #edb/ref 17592186339014} {:db/id #edb/ref 17592186379979} {:db/id #edb/ref 17592186401274} {:db/id #edb/ref 17592186407138}] :knowledge-point/title "Identifying the Interior of a Set"} :step/id #uuid "9d5d8127-b825-594a-81df-e04296e04e38" :step/math-academy-id 41924 :step/next {:db/id #edb/ref 17592186193668}} {:db/id #edb/ref 17592186193702 :step/content {:db/id #edb/ref 17592186192808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192536 :question/id #uuid "44971e25-0367-5b13-a6be-db503c6b4539" :question/math-academy-id "e-12399"} :knowledge-point/id #uuid "e534c006-a5b4-5f76-bbd6-451496358d3a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048948}] :knowledge-point/questions [{:db/id #edb/ref 17592186193184} {:db/id #edb/ref 17592186193211} {:db/id #edb/ref 17592186278574} {:db/id #edb/ref 17592186278576} {:db/id #edb/ref 17592186378842} {:db/id #edb/ref 17592186378849} {:db/id #edb/ref 17592186398547} {:db/id #edb/ref 17592186398554} {:db/id #edb/ref 17592186398561}] :knowledge-point/title "Identifying the Boundary of a Set"} :step/id #uuid "96d5ce65-6ad2-5f74-bcdb-8d90d0ff8464" :step/math-academy-id 44507 :step/next {:db/id #edb/ref 17592186193670}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192923}] [{:activity/course {:db/id #edb/ref 17592186046665} :activity/first-step {:db/id #edb/ref 17592186407140} :activity/id #uuid "76e2698b-8be0-5d8e-90fa-0fb9464d3b79" :activity/scope {:db/id #edb/ref 17592186048627 :topic/id #uuid "af65e753-6f2e-5d89-8c0d-d3d5df2fc680" :topic/math-academy-id 4063} :activity/steps [{:db/id #edb/ref 17592186407139 :step/content {:db/id #edb/ref 17592186278578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1762dd7a-cdff-5568-977d-6d80f2adc2de" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II and III only" :db/id #edb/ref 17592186275704} {:answer/id #uuid "89802e03-4038-5079-a2d6-6fbcbfaa4f4f" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I only" :db/id #edb/ref 17592186276725} {:answer/id #uuid "8b30765e-36b9-5ec6-98f6-842bac2a8047" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186276747} {:answer/id #uuid "a64a6892-a119-5289-a94b-626583cc70ba" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186276981} {:answer/id #uuid "af9e721c-402a-5c3f-9692-3951b59def5a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186277057}] :answer-field/correct {:db/id #edb/ref 17592186276725} :answer-field/id #uuid "b45260eb-ab24-5e89-9cc0-6905bd2dcc59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278047}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4104ec23-658c-58b7-8dbf-72086dab259b" :question/math-academy-id "q-161622" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,y\\ge -1+x}.\n$$\n\nWhich of the following statements are true?\n\n- $A$ contains all of its boundary points.\n- $A$ contains none of its boundary points.\n- $\\text{int}\\,A=A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/3e/3e7d8c11ac4b3de8473741a362ad2b78555c764da2d61f955435e8d59771cf46.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points. \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, while statement II is false. As we've seen, $A$ contains all of its boundary points.\n\n- Statement III is false. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "2c059530-0946-5277-be5a-d012a040ea0c" :step/next {:db/id #edb/ref 17592186407141}} {:db/id #edb/ref 17592186407140 :step/content {:db/id #edb/ref 17592186407138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1343a63e-0338-5507-8d29-781c61de7f44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0<x<2" :db/id #edb/ref 17592186407132} {:answer/id #uuid "24a9296e-4eb0-5d98-9be7-848968667f9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2<x<2" :db/id #edb/ref 17592186407133} {:answer/id #uuid "75e8591a-dc02-55dc-ad14-ef68af4fe858" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2<x<0" :db/id #edb/ref 17592186407134} {:answer/id #uuid "c0c3ae09-1abc-5587-9c24-5fe509b146bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2\\le x\\le 0" :db/id #edb/ref 17592186407135} {:answer/id #uuid "f99af401-4a27-5bd3-bd62-ea126d8fc033" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0\\le x\\le 0" :db/id #edb/ref 17592186407136}] :answer-field/correct {:db/id #edb/ref 17592186407134} :answer-field/id #uuid "8f40a659-1e0d-5b32-94de-7b630e906f3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407137}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b1bfea3-dfec-5d1e-9126-a29ce02c9c56" :question/math-academy-id "q-64991" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,-2\\le x<0,\\,0\\le y<2}\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<y<2\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/71/71851a12f638da9604450cae0d50ed15187e850368890845d60b16b89e728bcf.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/ab/abdd434da59bb3a1bdc0ee7de398d7ea4aeae2f617f54b5a26a5bad871ba0ac4.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,-2<x<0,\\,0<y<2\\,}.\n$$"} :step/id #uuid "402d691f-f025-5fda-a714-cdf450986aae" :step/next {:db/id #edb/ref 17592186407139}} {:db/id #edb/ref 17592186407141 :step/content {:db/id #edb/ref 17592186278580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51545767-3cc2-5437-9f48-638348ea4cb8" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and II only" :db/id #edb/ref 17592186276211} {:answer/id #uuid "65e476b0-8d46-5284-adff-7ab3dfc01d42" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "III only" :db/id #edb/ref 17592186276397} {:answer/id #uuid "8a5f5c40-cedb-5337-a6d5-fdb5d40c8667" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "None of the statements are true" :db/id #edb/ref 17592186276734} {:answer/id #uuid "ebbc21fd-75c6-57b1-b5df-f0a1cd6cf1c3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "II only" :db/id #edb/ref 17592186277546} {:answer/id #uuid "fbea97be-23e3-55aa-9854-424f79b2abcb" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "I and III only" :db/id #edb/ref 17592186277692}] :answer-field/correct {:db/id #edb/ref 17592186276397} :answer-field/id #uuid "79c6778a-20db-511f-af8b-42a6afc7a710" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277946}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "be0484aa-ac87-5330-9ede-cd54e1386a15" :question/math-academy-id "q-161625" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,y\\ge 2-x}.\n$$\n\nWhich of the following statements are true?\n\n- $A$ contains none of its boundary points.\n- $A$ contains some (not all) of its boundary points.\n- $\\text{int}\\,A\\ne A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/cd/cdca164d343d8bff4c78a1e366e52c588ca6c54dfdea61acea1900bcbdc79f31.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nNotice that, in this case, the set $A$ contains all of its boundary points.\n\nWith that in mind, let's examine each statement:\n\n- Statements I and II are false. As we have seen, $A$ contains all its boundary points.\n\n- Statement III is true. Since $A$ contains all of its boundary points, we must have $A-∂A⊊A.$ Therefore $\\text{int}\\,A\\ne A.$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "792002f7-8976-53c6-927a-3e52d881bb37" :step/next {:db/id #edb/ref 17592186407143}} {:db/id #edb/ref 17592186407142 :step/content {:db/id #edb/ref 17592186281312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ed68dd-7aef-5656-ac3a-0cafe1572795" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0\\le x<2,\\text{ }0\\le y<2" :db/id #edb/ref 17592186278800} {:answer/id #uuid "38d4ea31-5c92-59e1-b1b8-86206c057d4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0\\le x\\le 2,\\text{ }0<y<2" :db/id #edb/ref 17592186279094} {:answer/id #uuid "5124a441-ffdf-5fb7-9c90-48ab336f851d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0<x<2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186279337} {:answer/id #uuid "df496dda-7913-50b6-b84c-a2e72d9ca9c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0<x<2,\\text{ }0<y<2" :db/id #edb/ref 17592186280566} {:answer/id #uuid "eb4012d7-37e1-5799-babd-f5c1ef441092" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0\\le x\\le 2,\\text{ }0\\le y\\le 2" :db/id #edb/ref 17592186280663}] :answer-field/correct {:db/id #edb/ref 17592186280566} :answer-field/id #uuid "74aee92b-a504-5e91-8eb4-d4d52bb0c27d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eb88fa68-158a-5357-aaca-59045c1933c3" :question/math-academy-id "q-161721" :question/problem "![](images/6d/6debac35386e085a0197cf9eb3f2da65cc719ace67163cad625f58c056fb8f67.png)\n\nConsider the set $A$ shown above. The interior of $A$ is \n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/c0/c0b805c707981b9b6fcfa2ed387ad32a024fc845e6fd355a4b751ede4ad6a97e.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/69/69708aa698c38f8a29d3eb69083f893fd8fca183bd713387456624fc38b86fe9.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<4,\\,0<x<2,\\text{ }0<y<2}.\n$$"} :step/id #uuid "8b91c588-b8dd-5d0f-bb39-1c50d03a3a31"} {:db/id #edb/ref 17592186407143 :step/content {:db/id #edb/ref 17592186281308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1325c53d-2a90-5778-afb8-06fcd3205174" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186278772} {:answer/id #uuid "4728e048-8ecd-5ccd-ac4b-e6cbd5e27ae0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4{x}^{2}+{y}^{2}\\le 4" :db/id #edb/ref 17592186279233} {:answer/id #uuid "6578e51f-39ed-5919-8a55-dbd0a80e7410" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4{x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186279519} {:answer/id #uuid "789e155f-7ca8-5285-8b89-650ea79f4175" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4{x}^{2}+{y}^{2}\\le 2" :db/id #edb/ref 17592186279671} {:answer/id #uuid "ae570040-33fc-5a0b-b3dd-7a737099d6ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186280142}] :answer-field/correct {:db/id #edb/ref 17592186278772} :answer-field/id #uuid "07fc9cff-ef6e-56b5-99d9-20afa2b43a94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280850}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82618995-8e73-5f87-bf17-79a78614a421" :question/math-academy-id "q-161700" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}\\le 4,\\,0\\le x\\le 1}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<x<1}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/d6/d60700d57ddc72bb410b3136f546705676f83d23d9071ffe972c5163d11af549.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/75/75e0132cd3854f18e9ab409b7fd13af3898f78b5174647bf2b33b8438b9228cb.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+{y}^{2}<4,\\,0<x<1}.\n$$"} :step/id #uuid "a1abd988-5a8d-5e08-8366-ca4c63f4e968" :step/next {:db/id #edb/ref 17592186407142}}] :activity/title "Interiors and Boundaries of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407131}]}
