6259472 #edb/ref 1075 #edb/ref 17592186257563 #edb/ref 17592186045417] [17592186259472 #edb/ref 1075 #edb/ref 17592186258111 #edb/ref 17592186045417] [17592186259472 #edb/ref 1075 #edb/ref 17592186258440 #edb/ref 17592186045417] [17592186259472 #edb/ref 1075 #edb/ref 17592186258636 #edb/ref 17592186045417] [17592186259472 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259472 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259472 #edb/ref 1078 #edb/ref 17592186258440 #edb/ref 17592186045417] [17592186259472 #edb/ref 1079 #uuid "fa0f63c4-0bd4-586a-ba7e-dc23082dd8ac" #edb/ref 17592186045417] [17592186259723 #edb/ref 1068 #edb/ref 17592186259220 #edb/ref 17592186045417] [17592186259723 #edb/ref 1069 "q-124712" #edb/ref 17592186045417] [17592186259723 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186259723 #edb/ref 1071 "Evaluate ${\\int }_{C}x\\,dx-z\\,dy+y\\,dz,$ where $C$ is a portion of the curve $r(t)=3{t}^{2}\\,i+3\\operatorname{sin}⁡t\\,j+3\\operatorname{cos}⁡t\\,k$ for $t\\in [0,2\\pi ].$" #edb/ref 17592186045417] [17592186259723 #edb/ref 1072 #uuid "8cf6c777-07aa-500d-afdd-abfd78e3d9eb" #edb/ref 17592186045417] [17592186259723 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=3{t}^{2},\\,y(t)=3\\operatorname{sin}⁡t,\\,z(t)=3\\operatorname{cos}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,k \\\\  & =6t\\,i+3\\operatorname{cos}⁡t\\,j-3\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx-z\\,dy+y\\,dz & ={\\int }_{0}^{2\\pi }x\\frac{\\text{d}x}{\\text{d}t}\\,dt-z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }(x\\frac{\\text{d}x}{\\text{d}t}-z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{2\\pi }3{t}^{2}\\cdot (6t)-3\\operatorname{cos}⁡t\\cdot (3\\operatorname{cos}⁡t)+3\\operatorname{sin}⁡t\\cdot (-3\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9{cos}^{2}⁡t-9{sin}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9\\,dt \\\\  & =(\\frac{9{t}^{4}}{2}-9t){|}_{0}^{2\\pi } \\\\  & =72{\\pi }^{4}-18\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259741 #edb/ref 1068 #edb/ref 17592186259070 #edb/ref 17592186045417] [17592186259741 #edb/ref 1069 "q-124830" #edb/ref 17592186045417] [17592186259741 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259741 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz,$ where $C$ is a portion of the curve $r(t)=2\\operatorname{cos}⁡t\\,i-2\\operatorname{sin}⁡t\\,j+{t}^{2}\\,k$ for $t\\in [0,\\frac{3\\pi }{2}]?$" #edb/ref 17592186045417] [17592186259741 #edb/ref 1072 #uuid "b989f90c-82b4-5851-b56d-21f399df4340" #edb/ref 17592186045417] [17592186259741 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=2\\operatorname{cos}⁡t,\\,y(t)=-2\\operatorname{sin}⁡t,\\,z(t)={t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =-2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz & ={\\int }_{0}^{3\\pi /2}-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+{z}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+{z}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{3\\pi /2}2\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t)+2\\operatorname{cos}⁡t\\cdot (-2\\operatorname{cos}⁡t)+{t}^{4}\\cdot (2t)\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4{sin}^{2}⁡t-4{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259742 #edb/ref 1068 #edb/ref 17592186259072 #edb/ref 17592186045417] [17592186259742 #edb/ref 1069 "q-124832" #edb/ref 17592186045417] [17592186259742 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259742 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}-y\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the helix $r(t)=\\sqrt{2}\\operatorname{cos}⁡t\\,i+\\sqrt{2}\\operatorname{sin}⁡t\\,j+t\\,k$ for $t\\in [\\frac{\\pi }{4},\\frac{\\pi }{3}]?$" #edb/ref 17592186045417] [17592186259742 #edb/ref 1072 #uuid "f06cbe05-4a7e-555b-8b18-98e969a7aace" #edb/ref 17592186045417] [17592186259742 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=\\sqrt{2}\\operatorname{cos}⁡t,\\,y(t)=\\sqrt{2}\\operatorname{sin}⁡t,\\,z(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\sqrt{2}\\operatorname{sin}⁡t\\,i+\\sqrt{2}\\operatorname{cos}⁡t\\,j+k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+z\\,dz & ={\\int }_{\\pi /4}^{\\pi /3}-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}-\\sqrt{2}\\operatorname{sin}⁡t\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t)+\\sqrt{2}\\operatorname{cos}⁡t\\cdot (\\sqrt{2}\\operatorname{cos}⁡t)+t\\cdot 1\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}t+2{sin}^{2}⁡t+2{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}t+2\\,dt\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259748 #edb/ref 1068 #edb/ref 17592186259472 #edb/ref 17592186045417] [17592186259748 #edb/ref 1069 "q-124885" #edb/ref 17592186045417] [17592186259748 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259748 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}x{y}^{2}\\,dx+\\frac{1}{x}\\,dy,$ where $C$ is parametrized by $r(t)=\\frac{1}{t}\\,i+t\\,j$ for $t\\in [1,3]?$" #edb/ref 17592186045417] [17592186259748 #edb/ref 1072 #uuid "b4c0124c-a7c2-5baf-8b6a-e564a05c4df8" #edb/ref 17592186045417] [17592186259748 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=\\frac{1}{t},\\,y(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =-\\frac{1}{{t}^{2}}\\,i+j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,dx+\\frac{1}{x}\\,dy & ={\\int }_{1}^{3}x{y}^{2}\\frac{\\text{d}x}{\\text{d}t}\\,dt+\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{1}^{3}(x{y}^{2}\\frac{\\text{d}x}{\\text{d}t}+\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{1}^{3}\\frac{1}{t}\\cdot {t}^{2}\\cdot (-\\frac{1}{{t}^{2}})+\\frac{1}{(\\frac{1}{t})}\\cdot 1\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}-\\frac{1}{t}+t\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}\\frac{{t}^{2}-1}{t}\\,\\text{d}t\\end{aligned