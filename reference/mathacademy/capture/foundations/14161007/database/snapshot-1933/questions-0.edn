db/ref 17592186485485 :knowledge-point/_questions [{:db/id #edb/ref 17592186166849 :knowledge-point/id #uuid "12feb6dc-fadb-5502-86ed-7a238a3d38f1" :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dda2f50-13d8-5667-afb5-f5523567659f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.625" :db/id #edb/ref 17592186484952} {:answer/id #uuid "4b56302a-07d0-58f1-980d-3209e2c50fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186484984} {:answer/id #uuid "55819b27-f1fa-5e06-9d04-1e6c3f5258ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186485011} {:answer/id #uuid "60531dd7-7a22-59d9-ae87-87dfc502bd01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186485031} {:answer/id #uuid "99f942ec-cf7c-5190-91b3-376a735a96b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186485151}] :answer-field/correct {:answer/id #uuid "55819b27-f1fa-5e06-9d04-1e6c3f5258ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186485011} :answer-field/id #uuid "9c50b93b-457f-5729-865f-8239cdaea8fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04948a98-4203-56b1-a1c8-9d3794661fc0" :question/math-academy-id "q-105983" :question/problem "Given that $P(K|L)=0.25,$ $P(K)=0.75,$ and $P(L)=0.3,$ compute $P(L|K).$" :question/worked-solution "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(L|K) & =\\frac{P(K|L)P(L)}{P(K)} \\\\  & =\\frac{(0.25)(0.3)}{0.75} \\\\  & =\\frac{0.075}{0.75} \\\\  & =0.1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485564 :knowledge-point/_questions [{:db/id #edb/ref 17592186166849 :knowledge-point/id #uuid "12feb6dc-fadb-5502-86ed-7a238a3d38f1" :knowledge-point/title "Computing a Conditional Probability Using Bayes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b273b5f-039c-5dfa-aea1-90c5adefb5c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186484866} {:answer/id #uuid "548ac4a8-1508-57cd-8ade-15cdfda487fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186485005} {:answer/id #uuid "b56522e3-fcab-504e-8f1e-8d92e6d7bdbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186485208} {:answer/id #uuid "c761d015-4d28-595b-93b5-775dc5c5e533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186485245} {:answer/id #uuid "e355b3a1-3bea-5e81-8cfe-737194f9762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186485297}] :answer-field/correct {:answer/id #uuid "e355b3a1-3bea-5e81-8cfe-737194f9762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186485297} :answer-field/id #uuid "38bbc380-b74e-556f-aed5-40d425cfefbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0c5c51a-9ae7-508b-bfcb-a9d35170be46" :question/math-academy-id "q-105988" :question/problem "Given that $P(E|G)=0.15,$ $P(E)=0.75,$ and $P(G)=0.3,$ compute $P(G|E).$" :question/worked-solution "Using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(G|E) & =\\frac{P(E|G)P(G)}{P(E)} \\\\  & =\\frac{(0.15)(0.3)}{0.75} \\\\  & =\\frac{0.045}{0.75} \\\\  & =0.06.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167057 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80bd8518-f2e4-5438-b77e-fb32afc6c593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44%" :db/id #edb/ref 17592186163421} {:answer/id #uuid "864e375b-7540-57ab-b9e7-2eee079e0299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45%" :db/id #edb/ref 17592186163422} {:answer/id #uuid "f17c3e60-c1d4-5190-87ce-9e98882ee21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41%" :db/id #edb/ref 17592186163423} {:answer/id #uuid "61d23347-2338-5133-b670-df6699e4ef63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42%" :db/id #edb/ref 17592186163424} {:answer/id #uuid "79f39b3a-3284-5c5b-9966-bce1bad1cf7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43%" :db/id #edb/ref 17592186163425}] :answer-field/correct {:answer/id #uuid "80bd8518-f2e4-5438-b77e-fb32afc6c593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44%" :db/id #edb/ref 17592186163421} :answer-field/id #uuid "fd43372f-ca49-54b0-bc37-ebf82c8381e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e968a37-57e4-5890-83d9-9bffd788b041" :question/math-academy-id "q-106160" :question/problem "A survey of adult citizens of a certain country showed that $90%$ of all people with a bachelor's degree speak at least one foreign language. Overall, $63%$ of the adult population speaks a foreign language, and $31%$ of the adult ​population has a bachelor's degree. If a person who speaks a foreign language is selected at random, what is the probability of them having a bachelor's degree? Express your answer as a percentage to the nearest percent." :question/requires-calculator true :question/worked-solution "Let $F$ be the event that a randomly selected person speaks a foreign language, and let $B$ be the event that a randomly selected person has a bachelor's degree. Then, we require $P(B|F),$ which we can compute using Bayes' theorem.\n\n$$\nP(B|F)=\\frac{P(F|B)P(B)}{P(F)}.\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(F|B)=0.9,$ since $90%$ of all people who have a bachelor's degree speak a foreign language.\n\n- $P(B)=0.31,$ since $31%$ of the adult population has a bachelor's degree.\n\n- $P(F)=0.63,$ since $63%$ of the adult population speak a foreign language.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(B|F) & =\\frac{P(F|B)P(B)}{P(F)} \\\\  & =\\frac{(0.9)(0.31)}{0.63} \\\\  & ≈44%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186485500 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c943320-5fbb-561e-9a13-e1aa6ba5049d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56%" :db/id #edb/ref 17592186484908} {:answer/id #uuid "83b9c58f-6727-5777-8172-84b980bdbdf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54%" :db/id #edb/ref 17592186485099} {:answer/id #uuid "97416512-5893-58f1-a87c-c954410b3d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "57%" :db/id #edb/ref 17592186485144} {:answer/id #uuid "bbaf2440-0a54-56ad-8fa8-6a363788214a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58%" :db/id #edb/ref 17592186485220} {:answer/id #uuid "c10d5769-8190-5d61-9b02-a170c74f811c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55%" :db/id #edb/ref 17592186485229}] :answer-field/correct {:answer/id #uuid "bbaf2440-0a54-56ad-8fa8-6a363788214a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58%" :db/id #edb/ref 17592186485220} :answer-field/id #uuid "e753034b-662a-52aa-9360-b4d13194111c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "181eb68d-e7ae-553c-958d-610b9662b27f" :question/math-academy-id "q-106226" :question/problem "A survey of Bulgarian citizens showed that $17%$ of all females and  $38%$ of all males smoke. $51%$ of the population are female. If a non-smoker from this population is selected at random, what is the probability of them being female? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $N$ be the event that a randomly selected person doesn't smoke, and let $F$ be the event that they are female. Then, we require $P(F|N),$ which we can compute using Bayes' theorem.\n\n$$\nP(F|N)=\\frac{P(N|F)P(F)}{P(N)}=\\frac{P(N|F)P(F)}{P(N|F)P(F)+P(N|{F}^{′})P({F}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since $17%$ of all females and  $38%$ of all males smoke, we have\n\n$$\nP(N|F)=1-0.17=0.83,\\,P(N|{F}^{′})=1-0.38=0.62.\n$$\n\n- Since $51%$ of the population are female, we have\n\n$$\nP(F)=0.51,\\,P({F}^{′})=1-0.51=0.49.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(F|N) & =\\frac{P(N|F)P(F)}{P(N|F)P(F)+P(N|{F}^{′})P({F}^{′})} \\\\  & =\\frac{(0.83)(0.51)}{(0.83)(0.51)+(0.62)(0.49)} \\\\  & ≈58%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186485552 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "290c59db-26fa-57d1-bbcb-729dd654b6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9%" :db/id #edb/ref 17592186484894} {:answer/id #uuid "29e78ca5-247c-5685-b4ab-103670e45b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10%" :db/id #edb/ref 17592186484900} {:answer/id #uuid "2a5595c2-7fa1-5498-8feb-9d09d0f8a9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13%" :db/id #edb/ref 17592186484902} {:answer/id #uuid "9716a68c-461f-5e4a-ae26-a773cf54ebaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11%" :db/id #edb/ref 17592186485143} {:answer/id #uuid "d101d0e6-9a35-546d-864c-63daa0176ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12%" :db/id #edb/ref 17592186485257}] :answer-field/correct {:answer/id #uuid "2a5595c2-7fa1-5498-8feb-9d09d0f8a9c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13%" :db/id #edb/ref 17592186484902} :answer-field/id #uuid "1d022681-c9f6-5bed-bb1f-10a3b038aa5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485378}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8763b60a-8a9e-5a4f-9933-1a229bcc9ffb" :question/math-academy-id "q-106240" :question/problem "A survey of adult citizens of a particular city showed that $32%$ of all females and  $5%$ of all males don't eat after $6$ p.m. $51%$ of the population are female. If a person who doesn't eat after $6$ p.m. is selected at random, what is the probability of them being male? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $N$ be the event that a randomly selected person doesn't eat after $6$ p.m., and let $M$ be the event that they are male. Then, we require $P(M|N),$ which we can compute using Bayes' theorem.\n\n$$\nP(M|N)=\\frac{P(N|M)P(M)}{P(N)}=\\frac{P(N|M)P(M)}{P(N|M)P(M)+P(N|{M}^{′})P({M}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since $32%$ of all females and  $5%$ of all males don't eat after $6$ p.m, we have\n\n$$\nP(N|M)=0.05,\\,P(N|{M}^{′})=0.32.\n$$\n\n- Since $51%$ of the population are female, we have\n\n$$\nP(M)=1-0.51=0.49,\\,P({M}^{′})=0.51.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(M|N) & =\\frac{P(N|M)P(M)}{P(N|M)P(M)+P(N|{M}^{′})P({M}^{′})} \\\\  & =\\frac{(0.05)(0.49)}{(0.05)(0.49)+(0.32)(0.51)} \\\\  & ≈13%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186167058 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a59ca381-535f-5bb9-9345-b4a1c37081e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0224" :db/id #edb/ref 17592186163427} {:answer/id #uuid "cc8be132-b935-5f7a-ac7c-f9ba4bb6ffc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0352" :db/id #edb/ref 17592186163428} {:answer/id #uuid "e11b5fd7-5365-5449-84f5-62a9f4945f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0178" :db/id #edb/ref 17592186163429} {:answer/id #uuid "08383d98-eb5b-5051-b887-5a8556c6bb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0093" :db/id #edb/ref 17592186163430} {:answer/id #uuid "66a80aec-1f30-501e-869a-aa973f3fd78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0126" :db/id #edb/ref 17592186163431}] :answer-field/correct {:answer/id #uuid "66a80aec-1f30-501e-869a-aa973f3fd78d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0126" :db/id #edb/ref 17592186163431} :answer-field/id #uuid "20ed7c35-3d91-53fa-b36b-564ee7bca2e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38d0744d-4a08-50fe-8448-0c50b6a004f6" :question/math-academy-id "q-106368" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $95%$ of those infected and $2%$ of those not infected tested positive for the disease. Only $20%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested negative is infected?  Round your answer to four decimal places." :question/requires-calculator true :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P(D|{T}^{′}),$ which we can compute using Bayes' theorem.\n\n$$\nP(D|{T}^{′})=\\frac{P({T}^{′}|D)P(D)}{P({T}^{′})}=\\frac{P({T}^{′}|D)P(D)}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $95%,$ and the probability of a non-infected person testing positive is $2%,$ we have\n\n$$\nP({T}^{′}|D)=1-0.95=0.05,\\,P({T}^{′}|{D}^{′})=1-0.02=0.98.\n$$\n\n- Since only $20%$ of the population has the disease, we have\n\n$$\nP(D)=0.2\\,P({D}^{′})=1-0.2=0.8.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(D|{T}^{′}) & =\\frac{P({T}^{′}|D)P(D)}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})} \\\\  & =\\frac{(0.05)(0.2)}{(0.05)(0.2)+(0.98)(0.8)} \\\\  & ≈0.0126\\end{aligned}\n$$\n\nrounded to four decimal places."}] [{:db/id #edb/ref 17592186485545 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3a0d61-25b3-55c9-8d2a-476bfe0c13e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23%" :db/id #edb/ref 17592186484943} {:answer/id #uuid "5e093e4b-60ca-57c8-83c4-ea8459e9bb07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20%" :db/id #edb/ref 17592186485027} {:answer/id #uuid "8a4cbfde-4f69-5472-bab1-4d97868e5db7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10%" :db/id #edb/ref 17592186485120} {:answer/id #uuid "caea0b8c-47a2-5a8d-beb2-e7df061f6841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17%" :db/id #edb/ref 17592186485250} {:answer/id #uuid "f5496fbf-0c7a-5a7b-9a62-e5910dd2ff46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12%" :db/id #edb/ref 17592186485341}] :answer-field/correct {:answer/id #uuid "5e093e4b-60ca-57c8-83c4-ea8459e9bb07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20%" :db/id #edb/ref 17592186485027} :answer-field/id #uuid "41f6207a-16a5-5411-bdda-d3b66a7359f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7540b1df-730f-5d2d-b7a8-be03db2a980d" :question/math-academy-id "q-106497" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $91%$ of those infected and $4%$ of those not infected tested positive for the disease. Only $15%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested positive is not infected? Express your answer as a percentage to the nearest percent." :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P({D}^{′}|T),$ which we can compute using Bayes' theorem.\n\n$$\nP({D}^{′}|T)=\\frac{P(T|{D}^{′})P({D}^{′})}{P(T)}=\\frac{P(T|{D}^{′})P({D}^{′})}{P(T|{D}^{′})P({D}^{′})+P(T|D)P(D)}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $91%,$ and the probability of a non-infected person testing positive is $4%,$ we have\n\n$$\nP(T|D)=0.91,\\,P(T|{D}^{′})=0.04.\n$$\n\n- Since only $15%$ of the population has the disease, we have\n\n$$\nP(D)=0.15,\\,P({D}^{′})=1-0.15=0.85.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P({D}^{′}|T) & =\\frac{P(T|{D}^{′})P({D}^{′})}{P(T|{D}^{′})P({D}^{′})+P(T|D)P(D)} \\\\  & =\\frac{(0.04)(0.85)}{(0.04)(0.85)+(0.91)(0.15)} \\\\  & ≈20%\\end{aligned}\n$$\n\nrounded to the nearest percent."}] [{:db/id #edb/ref 17592186485497 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cf79116-9d92-52e9-9f12-b157d9d9c934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9885" :db/id #edb/ref 17592186484945} {:answer/id #uuid "8c51c1de-261c-5524-a4fc-c29b4bfec824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9824" :db/id #edb/ref 17592186485121} {:answer/id #uuid "b08cff2a-aaed-5655-af11-ea689a7ea24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9760" :db/id #edb/ref 17592186485200} {:answer/id #uuid "d5f5d8e6-2f9d-52a9-9442-17c4f785c098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9980" :db/id #edb/ref 17592186485264} {:answer/id #uuid "dfd6f33e-a95f-532e-851f-47ac6722765f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9715" :db/id #edb/ref 17592186485287}] :answer-field/correct {:answer/id #uuid "8c51c1de-261c-5524-a4fc-c29b4bfec824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9824" :db/id #edb/ref 17592186485121} :answer-field/id #uuid "0a36c630-25c6-582c-be57-3ab7b4dc4069" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10d543bf-463f-57f9-8fa9-461f96d806af" :question/math-academy-id "q-106499" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $90%$ of those infected and $9%$ of those not infected tested positive for the disease. Only $14%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested negative is not infected?  Round your answer to four decimal places." :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P({D}^{′}|{T}^{′}),$ which we can compute using Bayes' theorem.\n\n$$\nP({D}^{′}|{T}^{′})=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′})}=\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $90%,$ and the probability of a non-infected person testing positive is $9%,$ we have\n\n$$\nP({T}^{′}|D)=1-0.9=0.1,\\,P({T}^{′}|{D}^{′})=1-0.09=0.91.\n$$\n\n- Since only $14%$ of the population has the disease, we have\n\n$$\nP(D)=0.14\\,P({D}^{′})=1-0.14=0.86.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P({D}^{′}|{T}^{′}) & =\\frac{P({T}^{′}|{D}^{′})P({D}^{′})}{P({T}^{′}|D)P(D)+P({T}^{′}|{D}^{′})P({D}^{′})} \\\\  & =\\frac{(0.91)(0.86)}{(0.1)(0.14)+(0.91)(0.86)} \\\\  & ≈0.9824\\end{aligned}\n$$\n\nrounded four decimal places."}] [{:db/id #edb/ref 17592186485558 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268d6b-c3b0-50cf-ba9b-3de22683fdf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.59" :db/id #edb/ref 17592186484904} {:answer/id #uuid "702024f1-5c2b-52fe-a66f-36ff26426eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.11" :db/id #edb/ref 17592186485058} {:answer/id #uuid "77265340-2c2c-5241-870c-55efbde8304f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.18" :db/id #edb/ref 17592186485072} {:answer/id #uuid "eedef7dd-ac36-5b19-ab7a-06d7da451edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.67" :db/id #edb/ref 17592186485327} {:answer/id #uuid "f4020995-ec9c-5045-8b97-6421acd3b2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186485338}] :answer-field/correct {:answer/id #uuid "f4020995-ec9c-5045-8b97-6421acd3b2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186485338} :answer-field/id #uuid "df655b6c-59fb-5622-9ea9-612d1e33b110" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93a07e59-f865-5d60-89bb-f9fb0b96134d" :question/math-academy-id "q-42556" :question/problem "A laboratory test for a particular allergy is conducted on some patients. Of the tested patients, $98%$ of allergy sufferers and $4%$ of non-allergic patients tested positive for the allergy. Only $2%$ of the entire population has the allergy. What is the probability that a randomly chosen patient that tested positive is an allergy sufferer? Round your answer to $2$ decimal places." :question/worked-solution "Let $A$ be the event that a randomly chosen patient is an allergy sufferer, and let $T$ be the event they tested positive. Then, we require $P(A|T),$ which we can compute using Bayes' theorem.\n\n$$\nP(A|T)=\\frac{P(T|A)P(A)}{P(T)}=\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of a person who has the allergy  testing positive is $98%,$ and the probability of a  non-allergic person testing positive is $4%,$ we have\n\n$$\nP(T|A)=0.98,\\,P(T|{A}^{′})=0.04.\n$$\n\n- Since only $2%$ of the population suffers the allergy, we have\n\n$$\nP(A)=0.02,\\,P({A}^{′})=1-0.02=0.98.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(A|T) & =\\frac{P(T|A)P(A)}{P(T|A)P(A)+P(T|{A}^{′})P({A}^{′})} \\\\  & =\\frac{(0.98)(0.02)}{(0.98)(0.02)+(0.04)(0.98)} \\\\  & ≈0.33\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485589 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b96479-cd34-54ba-ad92-ef3be8fa5f3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186485000} {:answer/id #uuid "56ed3ec5-ca38-5ee2-87b2-01b3c0107df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186485013} {:answer/id #uuid "becc5747-18cb-5b06-9297-9de39ab4e710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186485227} {:answer/id #uuid "df54899c-0770-5f5e-ad57-f43564302c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.12" :db/id #edb/ref 17592186485285} {:answer/id #uuid "f3f924fe-ad39-5b65-8e80-c2cc5621a979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186485337}] :answer-field/correct {:answer/id #uuid "56ed3ec5-ca38-5ee2-87b2-01b3c0107df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186485013} :answer-field/id #uuid "d9365ada-91e3-54da-a0d9-612ba60324bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485460}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edf69e26-0d8e-540c-b142-6a409309f520" :question/math-academy-id "q-42557" :question/problem "In a particular city, about $60%$ of mornings are cloudy and $30%$ of days are rainy. \nIt is known that $40%$ of rainy days start with cloudy mornings. What is the probability that a randomly selected cloudy morning continues as a rainy day?" :question/worked-solution "Let $C$ be the event that a randomly selected morning is cloudy, and let $R$ be the event that a randomly selected day is rainy. Then, we require $P(R|C),$ which we can compute using Bayes' theorem.\n\n$$\nP(R|C)=\\frac{P(C|R)P(R)}{P(C)}\n$$\n\n- $P(C)=0.6,$ since $60%$ of mornings are cloudy.\n\n- $P(R)=0.3,$ since $30%$ of days are rainy.\n\n- $P(C|R)=0.4,$ since $40%$ of rainy days start with cloudy mornings.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(R|C) & =\\frac{P(C|R)P(R)}{P(C)} \\\\  & =\\frac{0.4\\cdot 0.3}{0.6} \\\\  & =0.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485533 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482fa7a-acb6-51cb-b18a-39cb4c4ce93f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186484856} {:answer/id #uuid "219ed4b9-da91-59a8-9319-14ee2fb5f4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.29" :db/id #edb/ref 17592186484880} {:answer/id #uuid "298703b1-b039-5dcb-8411-b5a447e52c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186484899} {:answer/id #uuid "634ee7db-1b3c-5f13-981d-f99a1c932b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186485034} {:answer/id #uuid "adcc88a4-bd02-5d37-93da-ab373fd66d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186485192}] :answer-field/correct {:answer/id #uuid "219ed4b9-da91-59a8-9319-14ee2fb5f4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.29" :db/id #edb/ref 17592186484880} :answer-field/id #uuid "24cea97d-bd06-585a-9db3-dd09a5d891c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485383}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "56a74bdd-02d9-5cb6-a536-9db069af271c" :question/math-academy-id "q-42558" :question/problem "In a particular school, $70%$ of students attend a history course, and $40%$ of students attend an art course. If $50%$ of art students also attend a history course, what is the probability that a randomly chosen history student also attends an art course? Round your answer to $2$ decimal places." :question/worked-solution "Let $H$ be the event that a randomly selected student attends a history course, and let $A$ be the event that they attend an art course. Then, we require $P(A|H),$ which we can compute using Bayes' theorem.\n\n$$\nP(A|H)=\\frac{P(H|A)P(A)}{P(H)}.\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(H|A)=0.5,$ since $50%$ of art students attend a history course.\n\n- $P(A)=0.4,$ since $40%$ of students attend an art course.\n\n- $P(H)=0.7,$ since $70%$ of students attend a history course.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(A|H) & =\\frac{P(H|A)P(A)}{P(H)} \\\\  & =\\frac{(0.5)(0.4)}{0.7} \\\\  & ≈0.29\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485509 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b09f684-0948-544a-bade-5e1147e654cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.23" :db/id #edb/ref 17592186484940} {:answer/id #uuid "54ab2118-f2a4-5c9d-95c6-ae168c2ee760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186485007} {:answer/id #uuid "5fb6bcf9-a011-5dd7-b82e-a6fd7d8878a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186485030} {:answer/id #uuid "901045bf-e4d7-5b1d-9e5f-c86de363678a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.65" :db/id #edb/ref 17592186485130} {:answer/id #uuid "d6180e7a-c1d8-55e1-a97a-a0d043e0ba93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186485265}] :answer-field/correct {:answer/id #uuid "54ab2118-f2a4-5c9d-95c6-ae168c2ee760" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186485007} :answer-field/id #uuid "5ae9ebe3-646f-5e49-b968-241a2789cb07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "242fce9f-3cc9-573a-8f6b-cabffe543cea" :question/math-academy-id "q-42560" :question/problem "In a particular school, $65%$ of students attend a literature course, and $45%$ of students attend a mathematics course. If $50%$ of mathematics students also attend a literature course, what is the probability that a randomly chosen literature student attends a mathematics course? Round your answer to $2$ decimal places." :question/worked-solution "Let $L$ be the event that a randomly selected student attends a literature course, and let $M$ be the event that they attend a mathematics course. Then, we require $P(M|L),$ which we can compute using Bayes' theorem.\n\n$$\nP(M|L)=\\frac{P(L|M)P(M)}{P(L)}.\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(L|M)=0.5,$ since $50%$ of mathematics students also attend a literature course.\n\n- $P(M)=0.45,$ since $45%$ of students attend a mathematics course.\n\n- $P(L)=0.65,$ since $65%$ of students attend a literature course.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(M|L) & =\\frac{P(L|M)P(M)}{P(L)} \\\\  & =\\frac{(0.5)(0.45)}{0.65} \\\\  & ≈0.35\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485569 :knowledge-point/_questions [{:db/id #edb/ref 17592186166850 :knowledge-point/id #uuid "616b7aa2-2c55-5a29-a908-545a4bad4376" :knowledge-point/title "Applying Bayes’ Theorem to a Situation in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50acda37-3316-5234-ab8b-2f67633ae818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186484990} {:answer/id #uuid "677f941d-5866-587a-917d-66562a4c917f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.43" :db/id #edb/ref 17592186485043} {:answer/id #uuid "8774a09b-47fc-5670-bf8e-966e21995278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.55" :db/id #edb/ref 17592186485110} {:answer/id #uuid "99826990-bdc7-51ce-bcce-d832b15787b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186485149} {:answer/id #uuid "b3469cc4-c6c3-5b23-9603-1edd982206a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186485206}] :answer-field/correct {:answer/id #uuid "99826990-bdc7-51ce-bcce-d832b15787b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.38" :db/id #edb/ref 17592186485149} :answer-field/id #uuid "771b8f37-09d3-5c99-b8ef-a73c9ba31e72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2713c99-1478-532d-bcdd-d19b74d5beb0" :question/math-academy-id "q-42566" :question/problem "In a particular school, $65%$ of students attend a history course, and $55%$ of students attend a language course.  If $45%$ of language students attend a history course, what is the probability that a randomly chosen history student also attends a language course? Round your answer to $2$ decimal places." :question/worked-solution "Let $H$ be the event that a randomly selected student attends a history course, and let $L$ be the event that they attend a language course. Then, we require $P(L|H),$ which we can compute using Bayes' theorem.\n\n$$\nP(L|H)=\\frac{P(H|L)P(L)}{P(H)}.\n$$\n\nFrom the problem statement, we have the following:\n\n- $P(H|L)=0.45$ since $45%$ of language students also attend a history course.\n\n- $P(L)=0.55$, since $55%$ of students attend a language course.\n\n- $P(H)=0.65,$ since $65%$ of students attend a history course.\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(L|H) & =\\frac{P(H|L)P(L)}{P(H)} \\\\  & =\\frac{(0.45)(0.55)}{0.65} \\\\  & ≈0.38\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186167317 :knowledge-point/_questions [{:db/id #edb/ref 17592186166744 :knowledge-point/id #uuid "5b11a5ad-5289-55e6-9a97-4c4544d76673" :knowledge-point/title "Determining the Accuracy of Medical Tests"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeaa6bab-2052-506c-a80b-8aa5935d0531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.17" :db/id #edb/ref 17592186165112} {:answer/id #uuid "bb0e0721-ccf4-5aa0-b643-c5d29afd2e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186165113} {:answer/id #uuid "2d25f16e-3662-523f-a5ed-2a87fa319915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.03" :db/id #edb/ref 17592186165114} {:answer/id #uuid "359d750c-8822-5654-8f13-88de32a53463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.49" :db/id #edb/ref 17592186165115} {:answer/id #uuid "439dbd4d-7ccf-5826-b1ef-ce3ecec86a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.23" :db/id #edb/ref 17592186165116}] :answer-field/correct {:answer/id #uuid "359d750c-8822-5654-8f13-88de32a53463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.49" :db/id #edb/ref 17592186165115} :answer-field/id #uuid "d06a9336-e507-5d68-b7e4-5a35bd5a9b50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165111}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b09b22f9-4f0f-572b-89f8-08c0340fab44" :question/math-academy-id "q-5476" :question/problem "A laboratory test for a particular disease is conducted on some patients. Of the tested patients, $97%$ of those infected and $1%$ of those not infected tested positive for the disease. Only $1%$ of the entire population is infected with the disease. What is the probability that a randomly chosen patient that tested positive is infected? Round your answer to $2$ decimal places." :question/requires-calculator true :question/worked-solution "Let $D$ be the event that a randomly chosen patient is infected with the disease, and let $T$ be the event they tested positive. Then, we require $P(D|T),$ which we can compute using Bayes' theorem.\n\n$$\nP(D|T)=\\frac{P(T|D)P(D)}{P(T)}=\\frac{P(T|D)P(D)}{P(T|D)P(D)+P(T|{D}^{′})P({D}^{′})}\n$$\n\nFrom the problem statement, we have the following:\n\n- Since the probability of an infected person testing positive is $97%,$ and the probability of a non-infected person testing positive is $1%,$ we have\n\n$$\nP(T|D)=0.97,\\,P(T|{D}^{′})=0.01.\n$$\n\n- Since only $1%$ of the population has the disease, we have\n\n$$\nP(D)=0.01,\\,P({D}^{′})=1-0.01=0.99.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(D|T) & =\\frac{P(T|D)P(D)}{P(T|D)P(D)+P(T|{D}^{′})P({D}^{′})} \\\\  & =\\frac{(0.97)(0.01)}{(0.97)(0.01)+(0.01)(0.99)} \\\\  & ≈0.49\\end{aligned}\n$$\n\nrounded to $2$ decimal places."}] [{:db/id #edb/ref 17592186485570 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27958476-7669-58c2-af8f-595b24af1b31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186484890} {:answer/id #uuid "4653ce38-16d0-586d-b7dc-dd5363ef8790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186484966} {:answer/id #uuid "a4b098f4-92dc-583d-af9c-271c9d4f7559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186485176} {:answer/id #uuid "e8dcd98e-359d-5df6-b4be-4ed2b4e91149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186485309} {:answer/id #uuid "fb4515d6-cf30-5fc0-bd8b-5878071b0b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186485357}] :answer-field/correct {:answer/id #uuid "27958476-7669-58c2-af8f-595b24af1b31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186484890} :answer-field/id #uuid "a980bcf9-df31-5948-bb20-037aa185ddd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485439}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b40352ca-72af-5209-909f-bc2acbfcdd56" :question/math-academy-id "q-5791" :question/problem "Two identical boxes contain marbles. The first box contains two black and three red marbles. The second box contains four black and three red marbles. A box is selected at random, and one marble is chosen from the selected box, also at random. If the selected marble is red, what is the probability that it is from the first box?" :question/worked-solution "Let $F$ be the event that the first box is selected, and let $R$ be the event that a randomly selected marble is red. Then, we require $P(F|R),$ which we can compute using Bayes' theorem. \n\n$$\nP(F|R)=\\frac{P(R|F)P(F)}{P(R)}=\\frac{P(R|F)P(F)}{P(R|F)P(F)+P(R|{F}^{′})P({F}^{′})}\n$$\n\nNote that ${F}^{′}$ is the event that the second box is selected.\n\nFrom the problem statement, we have the following:\n\n- Since the first box contains two black and three red marbles, and the second box contains four black and three red marbles, we have\n\n$$\nP(R|F)=\\frac{3}{5},\\,P(R|{F}^{′})=\\frac{3}{7}.\n$$\n\n- Since the box is selected at random, we have\n\n$$\nP(F)=P({F}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(F|R) & =\\frac{P(R|F)P(F)}{P(R|F)P(F)+P(R|{F}^{′})P({F}^{′})} \\\\  & =\\frac{(\\frac{3}{5}\\cdot \\frac{1}{2})}{(\\frac{3}{5}\\cdot \\frac{1}{2}+\\frac{3}{7}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{3}{5})}{(\\frac{3}{5}+\\frac{3}{7})} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485562 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040aea00-58a2-5fca-845d-ab01518f7128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186484824} {:answer/id #uuid "2f0ab6fc-40f3-5916-8be3-ff27866df904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186484914} {:answer/id #uuid "41ac3180-c308-5c00-a48c-c3b297baf6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186484961} {:answer/id #uuid "489b057b-8bb2-59e8-9ee9-66cb865d82a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{17}" :db/id #edb/ref 17592186484973} {:answer/id #uuid "83d6b3b0-95c8-524a-904a-5b529da0fd29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186485100}] :answer-field/correct {:answer/id #uuid "489b057b-8bb2-59e8-9ee9-66cb865d82a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{17}" :db/id #edb/ref 17592186484973} :answer-field/id #uuid "2dc6f092-2dbe-5bcc-b852-dc75e7c56d14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9db6fca8-e341-510d-8f9f-24e493c62cfd" :question/math-academy-id "q-5792" :question/problem "Two identical bins contain chips. The first bin contains four green and two yellow chips. The second bin has three green and one yellow chip. A bin is chosen at random, and a chip is selected from the chosen bin, also at random. If we know that the selected chip is green, what is the probability that it came from the second bin?" :question/worked-solution "Let $S$ be the event that the second bin is selected, and let $G$ be the event that a randomly selected chip is green. Then, we require $P(S|G),$ which we can compute using Bayes' theorem. \n\n$$\nP(S|G)=\\frac{P(G|S)P(S)}{P(G)}=\\frac{P(G|S)P(S)}{P(G|S)P(S)+P(G|{S}^{′})P({S}^{′})}\n$$\n\nNote that ${S}^{′}$ is the event that the first bin is selected.\n\nFrom the problem statement, we have the following:\n\n- Since the first bin contains four green and two yellow chips, and the second bin contains three green and one yellow chip, we have\n\n$$\nP(G|S)=\\frac{3}{4},\\,P(G|{S}^{′})=\\frac{4}{6}=\\frac{2}{3}.\n$$\n\n- Since the bin is selected at random, we have\n\n$$\nP(S)=P({S}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(S|G) & =\\frac{P(G|S)P(S)}{P(G|S)P(S)+P(G|{S}^{′})P({S}^{′})} \\\\  & =\\frac{(\\frac{3}{4}\\cdot \\frac{1}{2})}{(\\frac{3}{4}\\cdot \\frac{1}{2}+\\frac{2}{3}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{3}{4}+\\frac{2}{3})} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{17}{12})} \\\\  & =\\frac{9}{17}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485498 :knowledge-point/_questions [{:db/id #edb/ref 17592186166743 :knowledge-point/id #uuid "e40869c1-4d5a-57af-a2a1-55b514614c4f" :knowledge-point/title "Applying Bayes' Theorem With the Law of Total Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d53f014-4a70-5803-8b79-c932cb717d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186484844} {:answer/id #uuid "77a9763c-013a-5223-9f90-7999a3c47a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186485073} {:answer/id #uuid "8500c686-2515-5751-bd1d-4e17f9147de7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186485103} {:answer/id #uuid "a7c652c8-dc32-53ee-a293-d90dfad528ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186485181} {:answer/id #uuid "b943caa1-1848-5bf8-9949-0cf3348c866e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186485217}] :answer-field/correct {:answer/id #uuid "77a9763c-013a-5223-9f90-7999a3c47a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186485073} :answer-field/id #uuid "21f4a72e-4cba-5a39-ac58-cf6f7496920a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485380}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "111248ff-8060-5580-819b-222a636556c6" :question/math-academy-id "q-5793" :question/problem "Two identical boxes contain marbles. The first box contains two black and four blue marbles. The second box contains one black and five blue marbles. A box is selected at random, and one marble is chosen from the selected box, also at random. If the selected marble is black, what is the probability that it came from the first box?" :question/worked-solution "Let $F$ be the event that the first box is selected, and let $B$ be the event that a randomly selected marble is black. Then, we require $P(F|B),$ which we can compute using Bayes' theorem. \n\n$$\nP(F|B)=\\frac{P(B|F)P(F)}{P(B)}=\\frac{P(B|F)P(F)}{P(B|F)P(F)+P(B|{F}^{′})P({F}^{′})}\n$$\n\nNote that ${F}^{′}$ is the event that the second box is selected.\n\nFrom the problem statement, we have the following:\n\n- Since the first box contains two black and four blue marbles, and the second box contains one black and five blue marbles, we have\n\n$$\nP(B|F)=\\frac{2}{6}=\\frac{1}{3},\\,P(B|{F}^{′})=\\frac{1}{6}.\n$$\n\n- Since the box is selected at random, we have\n\n$$\nP(F)=P({F}^{′})=\\frac{1}{2}.\n$$\n\nTherefore, using Bayes' theorem, we have\n\n$$\n\\begin{aligned}P(F|B) & =\\frac{P(B|F)P(F)}{P(B|F)P(F)+P(B|{F}^{′})P({F}^{′})} \\\\  & =\\frac{(\\frac{1}{3}\\cdot \\frac{1}{2})}{(\\frac{1}{3}\\cdot \\frac{1}{2}+\\frac{1}{6}\\cdot \\frac{1}{2})} \\\\  & =\\frac{(\\frac{1}{6})}{(\\frac{1}{6}+\\frac{1}{12})} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}]}
