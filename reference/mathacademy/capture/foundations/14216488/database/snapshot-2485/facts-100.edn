52-a295-351b61078c2d" #edb/ref 17592186045417] [17592186362237 #edb/ref 1068 #edb/ref 17592186362067 #edb/ref 17592186045417] [17592186362237 #edb/ref 1069 "q-97712" #edb/ref 17592186045417] [17592186362237 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362237 #edb/ref 1071 "Let $V=C[\\pi ,2\\pi ]$ be the vector space of all functions that are continuous on $[\\pi ,2\\pi ],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{\\pi }^{2\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nCalculate the norm of the vector $f(t)=2\\operatorname{cos}⁡t+1.$" #edb/ref 17592186045417] [17592186362237 #edb/ref 1072 #uuid "415714b2-f118-53c1-b9e3-24f1aa607a09" #edb/ref 17592186045417] [17592186362237 #edb/ref 1074 "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{\\pi }^{2\\pi }(f(t))^{2}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }\\,(2\\operatorname{cos}⁡t+1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }\\,(4{cos}^{2}⁡t+4\\operatorname{cos}⁡t+1)\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }((2+2\\operatorname{cos}⁡2t)+4\\operatorname{cos}⁡t+1)\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }(3+2\\operatorname{cos}⁡2t+4\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =(3t+\\operatorname{sin}⁡2t+4\\operatorname{sin}⁡t){|}_{\\pi }^{2\\pi } \\\\  & =(6\\pi +0+0)-(3\\pi +0+0) \\\\  & =3\\pi .\\end{aligned}\n$$\n\nNote that we made use of the trigonometric identity \n\n$$\n{cos}^{2}⁡t=\\frac{1+\\operatorname{cos}⁡2t}{2}.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}‖f(t)‖ & =\\sqrt{3\\pi }.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186362239 #edb/ref 1068 #edb/ref 17592186362016 #edb/ref 17592186045417] [17592186362239 #edb/ref 1069 "q-97721" #edb/ref 17592186045417] [17592186362239 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186362239 #edb/ref 1071 "Let $V=C[0,1]$ be the vector space of all functions that are continuous on $[0,1],$ equipped with the inner product \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNormalize the vector $f(t)=2-3t.$" #edb/ref 17592186045417] [17592186362239 #edb/ref 1072 #uuid "4bb15900-4898-54df-9190-c765e91944f3" #edb/ref 17592186045417] [17592186362239 #edb/ref 1074 "The norm of a vector $f(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n‖f(t)‖=\\sqrt{⟨f(t),f(t)⟩}.\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨f(t),f(t)⟩ & ={\\int }_{0}^{1}{(2-3t)}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\,(4-12t+9{t}^{2})\\,\\text{d}t \\\\  & ={(4t-6{t}^{2}+3{t}^{3})|}_{0}^{1} \\\\  & =4-6+3 \\\\  & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n‖f(t)‖=\\frac{1}{\\sqrt{1}}=1.\n$$\n\nTo normalize the vector $f(t),$ we divide $f(t)$ by its norm $‖f(t)‖:$\n\n$$\n\\begin{aligned}u(t) & =\\frac{f(t)}{‖f(t)‖} \\\\  & =\\frac{2-3t}{1} \\\\  & =2-3t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186362242 #edb/ref 1068 #edb/ref 17592186362145 #edb/ref 17592186045417] [17592186362242 #edb/ref 1069 "q-97726" #edb/ref 17592186045417] [17592186362242 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362242 #edb/ref 1071 "An inner product on $V={R}^{3}$ is defined as $⟨x,y⟩=2{x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+{x}_{3}{y}_{3}.$ \n\nNormalize the  vector $v=\\begin{bmatrix}3 \\\\ 2 \\\\ -3\\end{bmatrix}$ under this inner product." #edb/ref 17592186045443] [17592186362242 #edb/ref 1072 #uuid "cc7a4edb-0118-580e-bca0-ed1f0771c326" #edb/ref 17592186045417] [17592186362242 #edb/ref 1074 "The norm of a vector $v$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖v‖=\\sqrt{⟨v,v⟩}.\\end{aligned}\n$$\n\nComputing the inner product using our definition, we get\n\n$$\n\\begin{aligned}⟨v,v⟩ & =2\\cdot (3\\cdot 3)+2\\cdot (2\\cdot 2)+(-3)\\cdot (-3) \\\\  & =18+8+9 \\\\  & =35.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{35}.\\end{aligned}\n$$\n\nTo normalize the vector $v$, we divide $v$ by its norm $‖v‖:$\n\n$$\n\\begin{aligned}u & =\\frac{v}{‖v‖} \\\\  & =\\frac{1}{\\sqrt{35}}\\begin{bmatrix}3 \\\\ 2 \\\\ -3\\end{bmatrix} \\\\  & =\\frac{\\sqrt{35}}{35}\\begin{bmatrix}3 \\\\ 2 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186364192 #edb/ref 1068 #edb/ref 17592186364193 #edb/ref 17592186045417] [17592186364192 #edb/ref 1069 "q-43918" #edb/ref 17592186045417] [17592186364192 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186364192 #edb/ref 1071 "Let $V={R}_{2}[t]$ be the vector space of all polynomials of degree at most $2,$ equipped with the inner product\n\n$$\n⟨x(t),y(t)⟩=x(1)y(1)+x(2)y(2)+x(3)y(3).\n$$\n\nCalculate the norm of the vector $p(t)=10-2{t}^{2}.$" #edb/ref 17592186045417] [17592186364192 #edb/ref 1072 #uuid "541ce81a-785c-54c8-9270-c091e7c9bd9b" #edb/ref 17592186045417] [17592186364192 #edb/ref 1074 "The norm of a vector $p(t)$ with respect to an inner product $⟨\\cdot ,\\cdot ⟩$ is defined as\n\n$$\n\\begin{aligned}‖p(t)‖=\\sqrt{⟨p(t),p(t)⟩}.\\end{aligned}\n$$\n\nSince $p(t)=10-2{t}^{2},$ we obtain\n\n$$\np(1)=8,\\,p(2)=2,\\,p(3)=-8.\n$$\n\nComputing $‖p(t)‖$ using our definition, we get\n\n$$\n\\begin{aligned}‖p(t)‖ & =\\sqrt{⟨p(t),p(t)⟩} \\\\  & =\\sqrt{p(1)p(1)+p(2)p(2)+p(3)p(3)} \\\\  & =\\sqrt{[p(1)]^{2}+[p(2)]^{2}+[p(3)]^{2}} \\\\  & =\\sqrt{(8)^{2}+(2)^{2}+(-8)^{2}} \\\\  & =\\sqrt{64+4+64} \\\\  & =\\sqrt{132} \\\\  & =2\\sqrt{33}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186364193 #edb/ref 1075 #edb/ref 17592186364194 #edb/ref 17592186045417] [17592186364193 #edb/ref 1075 #edb/ref 17592186364195 #edb/ref 17592186045417] [17592186364193 #edb/ref 1075 #edb/ref 17592186364196 #edb/ref 17592186045417] [17592186364193 #edb/ref 1075 #edb/ref 17592186364197 #edb/ref 17592186045417] [17592186364193 #edb/ref 1075 #edb/ref 175