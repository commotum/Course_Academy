#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186437279} :activity/id #uuid "ec96477c-3148-5d64-92ac-70e802659d96" :activity/scope {:db/id #edb/ref 17592186051063 :topic/id #uuid "7df685b7-b3c7-5f49-ba38-fa8edde1bc9a" :topic/math-academy-id 4392} :activity/steps [{:db/id #edb/ref 17592186437275 :step/content {:db/id #edb/ref 17592186287768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6df847-23fc-5618-8c18-cd3e96bad7a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285059} {:answer/id #uuid "6c7bec6a-d3f9-56f2-b34b-16fcdb511f09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186285782} {:answer/id #uuid "6c934d86-6799-5a6e-be1b-bfcdcd53dd42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186285784} {:answer/id #uuid "aee4f92c-fce7-5537-b85f-5e5708d9ae30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186286382}] :answer-field/correct {:db/id #edb/ref 17592186285059} :answer-field/id #uuid "29d47059-772c-58b6-bf07-0817d7499418" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287238} {:answer-field/choices [{:answer/id #uuid "64d997cd-655e-5365-aaf1-cceff5a5062b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186285704} {:answer/id #uuid "a26003a9-2d9a-5d8a-a1f7-9bc14c3b9449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186286276} {:answer/id #uuid "da2ef479-d8c3-5e76-82bd-a78943a3c260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186286779} {:answer/id #uuid "dececa6b-e086-5d80-a97b-6ce596fac723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186286817} {:answer/id #uuid "e9e62585-e325-5a07-981f-eaa32507d441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286928}] :answer-field/correct {:db/id #edb/ref 17592186286928} :answer-field/id #uuid "5222196a-8c6a-5902-9894-d374f0ebb9a7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287333}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f80556dc-02e0-555b-8ef8-6bae1cda35bf" :question/math-academy-id "q-181808" :question/problem "![](images/66/664c70223ca8a6219b04a287c779d20bf0f88d770920d1357303721574d90787.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,{x}^{2}\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the curve $y={x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny>{x}^{2}\n$$\n\nWe must also include the curve $y={x}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\ge {x}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2}\\}.\n$$"} :step/id #uuid "2c3e1240-c726-51bb-964e-3c47808e7b7e" :step/next {:db/id #edb/ref 17592186437277}} {:db/id #edb/ref 17592186437276 :step/content {:db/id #edb/ref 17592186287798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046745ef-1074-5d42-8d65-17675bc6d170" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186284825} {:answer/id #uuid "2f308477-be91-58c4-907e-5c9ec3af2156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186285212} {:answer/id #uuid "5b4311b5-9883-5865-bff6-655bfc69da58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Z}^{2}" :db/id #edb/ref 17592186285624} {:answer/id #uuid "972dfd2f-ff55-5c49-8f84-82810c9e90d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Z" :db/id #edb/ref 17592186286163} {:answer/id #uuid "bcaac264-b925-5d7f-8a95-f0a603e7d499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186286507} {:answer/id #uuid "dee417d1-8d82-5863-a8e1-b5a99986e8d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{N}^{2}" :db/id #edb/ref 17592186286820}] :answer-field/correct {:db/id #edb/ref 17592186285624} :answer-field/id #uuid "3671592c-a975-5d8b-b7f4-ac76c0cd6a10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287260} {:answer-field/choices [{:answer/id #uuid "01e1bcc3-45c3-5bef-841c-0a12c8af72a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186284804} {:answer/id #uuid "0ace50c8-6b02-5fff-88a9-b8c690ccf356" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186284877} {:answer/id #uuid "580b3142-43d3-5bce-adf7-7b37be40aaee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186285593} {:answer/id #uuid "61ec0d2c-1fc5-5c85-85a1-9c5ffc0199fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186285686} {:answer/id #uuid "884db520-27ea-585c-8a15-5b5db244d56f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186286037}] :answer-field/correct {:db/id #edb/ref 17592186286037} :answer-field/id #uuid "cb0cc407-be95-5a84-a458-d76811518cb8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287567}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8779b713-2ad1-53d1-a3e6-394f41bc52c9" :question/math-academy-id "q-182032" :question/problem "![](images/98/980ae73286ed41ed0c6f074a4bed5b35fa852dd608fb0a1a561f26a7eac60ea7.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,2\\}\n$$" :question/worked-solution "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *to the left* the line $x=2.$ For those points, the following condition is satisfied:\n\n$$\nx<2\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\nx<2.\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n\\{(x,y)\\in {Z}^{2}\\,:\\,x<2\\}\n$$"} :step/id #uuid "2c9136d1-b775-59b9-8793-3bb26263467c"} {:db/id #edb/ref 17592186437277 :step/content {:db/id #edb/ref 17592186287790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d32fcf7-f956-579e-bd12-582e2a8e1218" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186285188} {:answer/id #uuid "8380f9b1-920d-5146-839d-4b75e2f43ca2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186285996} {:answer/id #uuid "d3d0529c-dab6-51e3-9c14-4b29bf91f5fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186286714} {:answer/id #uuid "e6cb933e-eef2-5fbf-b5cf-aa05874b4c95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186286899} {:answer/id #uuid "e92e2838-a3f7-5ff3-a899-3e77a31053e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286920}] :answer-field/correct {:db/id #edb/ref 17592186286920} :answer-field/id #uuid "b1c12478-b402-5f5d-b4da-66a564ce341e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287517} {:answer-field/choices [{:answer/id #uuid "38812c8c-b3a5-564b-b650-983576d4442a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186285315} {:answer/id #uuid "66d676e1-0e6e-5f12-b840-c7214f77aef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186285723} {:answer/id #uuid "d06de7c4-b859-548f-af13-4ddc486c2944" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C" :db/id #edb/ref 17592186286685} {:answer/id #uuid "dca2758b-df2c-54f7-9ccf-9a8e5f9528f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{C}^{2}" :db/id #edb/ref 17592186286797}] :answer-field/correct {:db/id #edb/ref 17592186285315} :answer-field/id #uuid "dbc6ba57-bdbf-5460-a5b9-e829e1bd1802" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287597}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "49192157-aea0-5727-927f-dcfccbbb5607" :question/math-academy-id "q-182013" :question/problem "![](images/77/7703b8c621b268a9fcbb412cd3a0617045145d475024dc91cecfa09a18fc8712.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,x\\,{{field-2}}\\,-2\\}\n$$" :question/worked-solution "The points in our set include all those that lie *right* the line $x=-2.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\nx>-2\n$$\n\nWe must also include the line $x=-2$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\nx\\ge -2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2\\}.\n$$"} :step/id #uuid "5b59b1f7-7c69-53e1-bf66-88abd240720f" :step/next {:db/id #edb/ref 17592186437276}} {:db/id #edb/ref 17592186437278 :step/content {:db/id #edb/ref 17592186287725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b7a7422-0bcf-5706-ae8f-72c9ece61bc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186285166} {:answer/id #uuid "2d166e9a-fcd9-5b6d-89d1-3e838ceada86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186285186} {:answer/id #uuid "626c9538-6fdc-52f9-9f52-20ce738bf7eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186285689} {:answer/id #uuid "9a12840e-a2c3-50de-9e43-87a31770bd26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286199} {:answer/id #uuid "cf4b0e6c-806d-5a0b-ae15-ee9ed923b4a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186286671}] :answer-field/correct {:db/id #edb/ref 17592186285689} :answer-field/id #uuid "19da688f-4cba-51c2-8892-be4247f77378" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287194} {:answer-field/choices [{:answer/id #uuid "0014d307-5e77-586a-b23e-f2aba6c41f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186284789} {:answer/id #uuid "01b659a3-1590-57ce-b570-119d57e48981" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "N" :db/id #edb/ref 17592186284803} {:answer/id #uuid "039df918-b1da-5c3e-a883-a65e7d757d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R" :db/id #edb/ref 17592186284816} {:answer/id #uuid "1206bada-1312-536b-abf6-49e6b4608804" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{C}^{2}" :db/id #edb/ref 17592186284947} {:answer/id #uuid "f14fa278-1c12-5e38-8e80-bef17e66926f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C" :db/id #edb/ref 17592186287002}] :answer-field/correct {:db/id #edb/ref 17592186284789} :answer-field/id #uuid "23d98d1d-86ec-50e6-a361-17bb304ce01c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287225} {:answer-field/choices [{:answer/id #uuid "1ccb9202-85aa-51d1-bf79-1d07d3e5f1a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ne " :db/id #edb/ref 17592186285046} {:answer/id #uuid "6a8d7044-53fb-5b8d-86d6-4bffe486c033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186285764} {:answer/id #uuid "a1976d5e-704e-565f-b6e0-68f91a1716dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ge " :db/id #edb/ref 17592186286263} {:answer/id #uuid "a35e14fb-a0b7-5a65-9581-289f3d7016f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186286285} {:answer/id #uuid "ffd75b34-ae54-57b3-b0a6-a21e435150ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le " :db/id #edb/ref 17592186287133}] :answer-field/correct {:db/id #edb/ref 17592186287133} :answer-field/id #uuid "de93457b-c344-5602-ae70-2eec999e673f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186287602}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "281f8e94-72c2-5b73-8bcb-5cb4814a0f37" :question/math-academy-id "q-181689" :question/problem "![](images/32/32168a2cb1fe14dbc88725347611ae5951198e81dfaa0b41e780106750bbb741.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n\\{(x,y)\\in {{field-1}}\\,:\\,3x\\,{{field-2}}\\,y\\,{{field-3}}\\,\\frac{x}{4}\\}\n$$" :question/worked-solution "The points in our set include all those that lie *above* the line $y=3x$ and *below* the line $y=\\frac{x}{4}.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>3x,\\,y<\\frac{x}{4}.\n$$\n\nCombining this into a single condition, we have\n\n$$\n3x<y<\\frac{x}{4}.\n$$\n\nWe must also include the line $y=3x$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\n3x\\le y<\\frac{x}{4}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,3x\\le y<\\frac{x}{4}\\}.\n$$"} :step/id #uuid "d4b86ca5-af6d-53a9-a974-2a88b2674a7b" :step/next {:db/id #edb/ref 17592186437275}} {:db/id #edb/ref 17592186437279 :step/content {:db/id #edb/ref 17592186198790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46af21cb-361b-5fb4-ab1d-162f6dc19fa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186285439}] :answer-field/correct {:db/id #edb/ref 17592186285439} :answer-field/id #uuid "21b2e6e8-e3a7-5dc9-8ac1-fe4ec9a406fe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287221} {:answer-field/choices [{:answer/id #uuid "750ca960-2d08-58a0-966e-64431106cace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186285868}] :answer-field/correct {:db/id #edb/ref 17592186285868} :answer-field/id #uuid "3fafe7ac-dbc0-5cdf-bc0c-5c63228b3957" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287284} {:answer-field/choices [{:answer/id #uuid "8932e43d-7f5d-54b2-a7c5-53ff42abdde0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186286045}] :answer-field/correct {:db/id #edb/ref 17592186286045} :answer-field/id #uuid "9bf54d46-5083-5c2f-b1b8-5402c86f58b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186287466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dedb72cf-47cf-5e98-a478-6359d9544476" :question/math-academy-id "q-181610" :question/problem "![](images/fb/fbd778f48199acd5b731e739cb527a990ba28a8d88981d50554d135e853f8815.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$\\{(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$36$\n\n$\\}$" :question/worked-solution "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=3$ and vertical radius $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n4{x}^{2}+9{y}^{2}=36.\n$$\n\nWe're interested in describing all points that lie *inside* the ellipse. So, let's pick any point inside the region, say, $(0,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n4(0)^{2}+9(0)^{2}\\,<\\,36.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n4{x}^{2}+9{y}^{2}<36.\n$$\n\nNotice that we use $<$ since the boundary is excluded from the set (the boundary curve is dashed).\n\nTherefore, we can write the set as\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+9{y}^{2}<36\\}.\n$$"} :step/id #uuid "d944585f-3405-5ba6-8dae-d59dced3f322" :step/next {:db/id #edb/ref 17592186437278}}] :activity/title "Describing Planar Regions Using Set-Builder Notation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186437274}]}
