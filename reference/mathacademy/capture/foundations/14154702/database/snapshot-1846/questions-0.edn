#{[{:db/id #edb/ref 17592186262941 :knowledge-point/_questions [{:db/id #edb/ref 17592186119840 :knowledge-point/id #uuid "5a50c5f1-fbda-5c87-afa2-32495c69c18d" :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Simplified Dot Product Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129b0757-3ac6-5753-b6e3-478a8023eb52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260037} {:answer/id #uuid "4de222b6-19ed-5d3c-a87c-f1b937df4849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260536} {:answer/id #uuid "65ac176a-0b06-5588-9781-22d9e0435725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260758} {:answer/id #uuid "816e3b5d-f9fa-5bd9-b29d-3f7e216e3a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261004} {:answer/id #uuid "df122527-7c53-5616-83fd-4d0c7dd7847e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261846}] :answer-field/correct {:answer/id #uuid "4de222b6-19ed-5d3c-a87c-f1b937df4849" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260536} :answer-field/id #uuid "ffc75d90-c023-5fb9-a940-576505f511c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262570}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0498861d-e4e1-5581-aee5-353d6a78f4f9" :question/math-academy-id "q-129102" :question/problem "Given that $Q(4,-2,8)$ lies on the plane $Π:r\\cdot ⟨-3,6,2⟩=-8$, find the shortest distance from $P(3,-4,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-2,8⟩-⟨3,-4,2⟩ \\\\  & =⟨1,2,6⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-3,6,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|1\\cdot (-3)+2\\cdot 6+6\\cdot 2|}{\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}}} \\\\  & =\\frac{|-3+12+12|}{\\sqrt{9+36+4}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262942 :knowledge-point/_questions [{:db/id #edb/ref 17592186119840 :knowledge-point/id #uuid "5a50c5f1-fbda-5c87-afa2-32495c69c18d" :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Simplified Dot Product Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8f6350-fb69-5a5b-bb29-e322e7c392a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260261} {:answer/id #uuid "5f24cf3d-cea3-54d1-9eda-cbee7058c868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260695} {:answer/id #uuid "78b2e517-ef5a-50b6-a3c1-b0a7028cba72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260933} {:answer/id #uuid "964b77d2-f08c-5b17-8d73-500caab4ed24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186261176} {:answer/id #uuid "baf43eb1-d821-5887-8947-2e31570cd345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261518}] :answer-field/correct {:answer/id #uuid "5f24cf3d-cea3-54d1-9eda-cbee7058c868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260695} :answer-field/id #uuid "bdb5524e-d28d-538f-a91e-26dfa96b9bfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c91ce04-7e86-5b0f-8e36-5b36844cedf2" :question/math-academy-id "q-129103" :question/problem "Given that $Q(3,-4,5)$ lies on the plane $Π:r\\cdot ⟨-2,4,-4⟩=-42$, find the shortest distance from $P(1,-5,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-4,5⟩-⟨1,-5,2⟩ \\\\  & =⟨2,1,3⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-2,4,-4⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+1\\cdot 4+3\\cdot (-4)|}{\\sqrt{(-2)^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-4+4-12|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-12|}{\\sqrt{36}} \\\\  & =\\frac{12}{6} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262962 :knowledge-point/_questions [{:db/id #edb/ref 17592186119841 :knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f" :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b72bdaf-c17d-5a6f-a26c-13328e45c2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186260407} {:answer/id #uuid "63966b3b-7d0f-548b-957a-4189afb5ebfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260734} {:answer/id #uuid "654695db-ae2f-5c0a-8492-ff72aa97f271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186260751} {:answer/id #uuid "ae41e977-6f41-536e-a881-63dadca54693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186261412} {:answer/id #uuid "f0ec70a3-7571-53d4-a32a-f4786362a4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261986}] :answer-field/correct {:answer/id #uuid "63966b3b-7d0f-548b-957a-4189afb5ebfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260734} :answer-field/id #uuid "bc0d9b85-acc6-5956-920a-859f666ff369" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262466}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8fc468d7-8c5a-51cb-a422-a6e8deebdd30" :question/math-academy-id "q-129166" :question/problem "Find the shortest distance between the point $P(-2,3,-6)$ and the plane $Π$ with equation $-x+2y+2z=8.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-2$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-x+2y+2z & =8 \\\\ -1(-2)+2(1)+2z & =8 \\\\ 2z & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nSo, we get the point $Q(-2,1,2)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-2,1,2⟩-⟨-2,3,-6⟩ \\\\  & =⟨0,-2,8⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-1,2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|0\\cdot (-1)+(-2)\\cdot 2+8\\cdot 2|}{\\sqrt{(-1)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{|0-4+16|}{\\sqrt{1+4+4}} \\\\  & =\\frac{|12|}{\\sqrt{9}} \\\\  & =\\frac{12}{3} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315010 :knowledge-point/_questions [{:db/id #edb/ref 17592186119840 :knowledge-point/id #uuid "5a50c5f1-fbda-5c87-afa2-32495c69c18d" :knowledge-point/title "Finding the Shortest Distance Between a Point and a Plane Given in Simplified Dot Product Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23c37932-b8d1-516f-abf3-f1748834a7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186312239} {:answer/id #uuid "3f3b0406-2681-5fe8-a9d6-e948d2f27a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{48}{11}" :db/id #edb/ref 17592186312486} {:answer/id #uuid "6b7e35c1-be2d-55da-bd15-0ac93254cb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{11}" :db/id #edb/ref 17592186312817} {:answer/id #uuid "a1272a18-c467-54d3-9f71-ae126c7eade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313242} {:answer/id #uuid "e1afee6d-ef0d-5bae-8b1d-2c7e13dcdbb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{26}}{13}" :db/id #edb/ref 17592186313752}] :answer-field/correct {:answer/id #uuid "6b7e35c1-be2d-55da-bd15-0ac93254cb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{43}{11}" :db/id #edb/ref 17592186312817} :answer-field/id #uuid "c0d43f73-b51f-5e33-b3f5-c33dee8bb5b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314548}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "245878e4-0685-5305-b361-ba9fd660a2d5" :question/math-academy-id "q-34074" :question/problem "Given that $Q(2,4,1)$ lies on the plane $Π:r\\cdot ⟨-6,2,9⟩=5$, find the shortest distance from $P(6,-1,0)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,4,1⟩-⟨6,-1,0⟩ \\\\  & =⟨-4,5,1⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨-6,2,9⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-4)\\cdot (-6)+5\\cdot 2+1\\cdot 9|}{\\sqrt{(-6)^{2}+{2}^{2}+{9}^{2}}} \\\\  & =\\frac{|24+10+9|}{\\sqrt{36+4+81}} \\\\  & =\\frac{|43|}{\\sqrt{121}} \\\\  & =\\frac{43}{11}\\end{aligned}\n$$"}]}
