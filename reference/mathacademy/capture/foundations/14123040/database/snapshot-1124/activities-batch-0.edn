#{[{:activity/first-step {:db/id #edb/ref 17592186184920} :activity/id #uuid "6d30c0b5-be79-5a7a-808d-7678444ef5c3" :activity/scope {:db/id #edb/ref 17592186050492 :topic/id #uuid "4d988bef-0de4-5f06-97fd-2cce9cfe06fb" :topic/math-academy-id 3776} :activity/steps [{:db/id #edb/ref 17592186184918 :step/content {:db/id #edb/ref 17592186184159 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184063 :question/id #uuid "61a0b8a7-332d-5ae1-ad46-a65369bc87d1" :question/math-academy-id "e-4415"} :knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050446}] :knowledge-point/questions [{:db/id #edb/ref 17592186184749} {:db/id #edb/ref 17592186184843} {:db/id #edb/ref 17592186265941} {:db/id #edb/ref 17592186265944} {:db/id #edb/ref 17592186348090} {:db/id #edb/ref 17592186378643} {:db/id #edb/ref 17592186378650} {:db/id #edb/ref 17592186380090} {:db/id #edb/ref 17592186388118} {:db/id #edb/ref 17592186388125} {:db/id #edb/ref 17592186393828} {:db/id #edb/ref 17592186393870}] :knowledge-point/title "Finding a Power of a Nilpotent Matrix"} :step/id #uuid "f2ddcf91-fcb2-581a-af17-8b331c1212e2" :step/math-academy-id 16202 :step/next {:db/id #edb/ref 17592186184921}} {:db/id #edb/ref 17592186184919 :step/content {:db/id #edb/ref 17592186184160 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184064 :question/id #uuid "906ff9b7-c304-5b9a-b152-cef3bf343de1" :question/math-academy-id "e-4416"} :knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e" :knowledge-point/questions [{:db/id #edb/ref 17592186184765} {:db/id #edb/ref 17592186184766} {:db/id #edb/ref 17592186265951} {:db/id #edb/ref 17592186348101} {:db/id #edb/ref 17592186375916} {:db/id #edb/ref 17592186377735} {:db/id #edb/ref 17592186379372} {:db/id #edb/ref 17592186379379} {:db/id #edb/ref 17592186380097} {:db/id #edb/ref 17592186390750} {:db/id #edb/ref 17592186391958} {:db/id #edb/ref 17592186393912}] :knowledge-point/title "Finding a Power of an Idempotent Matrix"} :step/id #uuid "fbec4efc-b26d-5e1e-b905-eda2f46094c5" :step/math-academy-id 16203} {:db/id #edb/ref 17592186184920 :step/content {:db/id #edb/ref 17592186185315 :tutorial/content "A matrix is said to be **nilpotent** if some positive power of the matrix is the zero matrix. For example, the matrix\n\n$$B = [\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$$\n\nis nilpotent because its second power is the zero matrix:\n\n$$\\begin{aligned}{B}^{2} & =[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\ & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\ & =O\\end{aligned}$$\n\nTo state the definition more precisely: a matrix with the property $B^k=O$ for a number $k>0$ is known as a **nilpotent** matrix, and the lowest number $k$ such that $B^k=O$ is called the **index.**\n\nTherefore, our matrix $B$ is a nilpotent matrix of index $2.$" :tutorial/id #uuid "39a61f3b-3f47-5962-a20c-33867d6f1127" :tutorial/math-academy-id 3130 :tutorial/title "Introduction"} :step/id #uuid "fbfd42f1-c449-5a1c-89f3-22f0da76f2bc" :step/math-academy-id 17047 :step/next {:db/id #edb/ref 17592186184918}} {:db/id #edb/ref 17592186184921 :step/content {:db/id #edb/ref 17592186185316 :tutorial/content "A matrix is said to be **idempotent**, when multiplied by itself, yields itself.\n\nFor example, the matrix\n\n$$B = [\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}]$$\n\nis idempotent because $B^2 = B$:\n\n$$\\begin{aligned}{B}^{2} & =[\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}] \\\\ & =[\\begin{aligned}3\\cdot 3+(-6)\\cdot 1 & 3\\cdot (-6)+(-6)\\cdot (-2) \\\\ 1\\cdot 3+(-2)\\cdot 1 & 1\\cdot (-6)+(-2)\\cdot (-2)\\end{aligned}] \\\\ & =[\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}] \\\\ & =B\\end{aligned}$$" :tutorial/id #uuid "3977ba53-51f9-53db-b487-753096fe77e6" :tutorial/math-academy-id 3131 :tutorial/title "Idempotent Matrices"} :step/id #uuid "bfb120ef-6495-557c-acdc-22fecb070cee" :step/math-academy-id 17077 :step/next {:db/id #edb/ref 17592186184919}}] :activity/title "Nilpotent and Idempotent Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184373}]}
