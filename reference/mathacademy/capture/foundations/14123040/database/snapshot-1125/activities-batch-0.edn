17592186421545}] :knowledge-point/title "Finding a Power of an Idempotent Matrix"} :step/id #uuid "fbec4efc-b26d-5e1e-b905-eda2f46094c5" :step/math-academy-id 16203} {:db/id #edb/ref 17592186184920 :step/content {:db/id #edb/ref 17592186185315 :tutorial/content "A matrix is said to be **nilpotent** if some positive power of the matrix is the zero matrix. For example, the matrix\n\n$$B = [\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$$\n\nis nilpotent because its second power is the zero matrix:\n\n$$\\begin{aligned}{B}^{2} & =[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\ & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\ & =O\\end{aligned}$$\n\nTo state the definition more precisely: a matrix with the property $B^k=O$ for a number $k>0$ is known as a **nilpotent** matrix, and the lowest number $k$ such that $B^k=O$ is called the **index.**\n\nTherefore, our matrix $B$ is a nilpotent matrix of index $2.$" :tutorial/id #uuid "39a61f3b-3f47-5962-a20c-33867d6f1127" :tutorial/math-academy-id 3130 :tutorial/title "Introduction"} :step/id #uuid "fbfd42f1-c449-5a1c-89f3-22f0da76f2bc" :step/math-academy-id 17047 :step/next {:db/id #edb/ref 17592186184918}} {:db/id #edb/ref 17592186184921 :step/content {:db/id #edb/ref 17592186185316 :tutorial/content "A matrix is said to be **idempotent**, when multiplied by itself, yields itself.\n\nFor example, the matrix\n\n$$B = [\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}]$$\n\nis idempotent because $B^2 = B$:\n\n$$\\begin{aligned}{B}^{2} & =[\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}] \\\\ & =[\\begin{aligned}3\\cdot 3+(-6)\\cdot 1 & 3\\cdot (-6)+(-6)\\cdot (-2) \\\\ 1\\cdot 3+(-2)\\cdot 1 & 1\\cdot (-6)+(-2)\\cdot (-2)\\end{aligned}] \\\\ & =[\\begin{aligned}3 & -6 \\\\ 1 & -2\\end{aligned}] \\\\ & =B\\end{aligned}$$" :tutorial/id #uuid "3977ba53-51f9-53db-b487-753096fe77e6" :tutorial/math-academy-id 3131 :tutorial/title "Idempotent Matrices"} :step/id #uuid "bfb120ef-6495-557c-acdc-22fecb070cee" :step/math-academy-id 17077 :step/next {:db/id #edb/ref 17592186184919}}] :activity/title "Nilpotent and Idempotent Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184373}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186421547} :activity/id #uuid "b53a0531-aaec-5b14-b9fe-ef1fc818e42f" :activity/scope {:db/id #edb/ref 17592186050492 :topic/id #uuid "4d988bef-0de4-5f06-97fd-2cce9cfe06fb" :topic/math-academy-id 3776} :activity/steps [{:db/id #edb/ref 17592186421546 :step/content {:db/id #edb/ref 17592186265944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "230f8658-c0ec-55d0-a480-24839035e5f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}18 & 0 \\\\ 0 & 18\\end{aligned}]" :db/id #edb/ref 17592186263308} {:answer/id #uuid "537a84f3-e5d6-5919-8f59-fa68e396bdea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 54 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186263718} {:answer/id #uuid "81a8fd32-3158-5f3a-96c4-bee35c88b641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}18 & 54 \\\\ 6 & 18\\end{aligned}]" :db/id #edb/ref 17592186264115} {:answer/id #uuid "c48c76a8-87b3-54a5-9957-b4fab1c3eea9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 3 \\\\ -1 & -3\\end{aligned}]" :db/id #edb/ref 17592186264723} {:answer/id #uuid "e9c6aead-5e9f-5906-9990-0dcf405dc1cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186265033}] :answer-field/correct {:db/id #edb/ref 17592186265033} :answer-field/id #uuid "2df157aa-3ba5-56ae-b49c-932b270763ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265328}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73bc7e3c-0d0e-5c12-afc8-020d832fd510" :question/math-academy-id "q-130621" :question/problem "If $K=[\\begin{aligned}9 & 27 \\\\ -3 & -9\\end{aligned}]$, then ${K}^{4}=$" :question/worked-solution "Computing ${K}^{2},$ we have\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =[\\begin{aligned}9 & 27 \\\\ -3 & -9\\end{aligned}]\\cdot [\\begin{aligned}9 & 27 \\\\ -3 & -9\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${K}^{2}=O,$ the matrix $K$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${K}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{K}^{2} & ={K}^{2}\\cdot {K}^{2} \\\\  & =O\\cdot O \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{K}^{4}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"} :step/id #uuid "1c5a0700-2974-52b2-a5c0-f0b093183853" :step/next {:db/id #edb/ref 17592186421548}} {:db/id #edb/ref 17592186421547 :step/content {:db/id #edb/ref 17592186184843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8d3b2e6-53ce-5675-9719-1e6f7e01b5ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186421538} {:answer/id #uuid "b4c0b97a-bdab-58f5-a07c-79787eb3f94e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186421539} {:answer/id #uuid "bec50d68-081a-5899-b3a9-04ecbfa8e6fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186421540} {:answer/id #uuid "c9eefa24-dc26-5b64-9a24-78a5e468b6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186421541} {:answer/id #uuid "dd800906-eb9a-5ad2-843c-4ad00d0bcb7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186421543}] :answer-field/correct {:db/id #edb/ref 17592186421538} :answer-field/id #uuid "af669ad0-ae47-5a9d-ab8c-914967692ad4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186183667}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ec9f8b4-aba4-50ea-8a5e-5c6fd75fd0f4" :question/math-academy-id "q-78341" :question/problem "If $A=[\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}]$, then ${A}^{4}=$" :question/worked-solution "Computing ${A}^{2},$ we have\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${A}^{2}=O,$ the matrix $A$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${A}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{A}^{2} & ={A}^{2}\\cdot {A}^{2} \\\\  & =O\\cdot O \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{A}^{4}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"} :step/id #uuid "3286b5cd-eb29-594f-8a73-11ddd08bc1ef" :step/next {:db/id #edb/ref 17592186421546}} {:db/id #edb/ref 17592186421548 :step/content {:db/id #edb/ref 17592186421545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8fc809-c7c8-51da-97a9-cd29d45be4a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}9 & 9 \\\\ -4 & -4\\end{aligned}]" :db/id #edb/ref 17592186421534} {:answer/id #uuid "35223ea7-957d-558a-abed-700d6db7d746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 & 3 \\\\ -2 & -2\\end{aligned}]" :db/id #edb/ref 17592186421535} {:answer/id #uuid "3f394fb3-e71c-5ca8-9f2c-6be2526c01f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 & -3 \\\\ 2 & 2\\end{aligned}]" :db/id #edb/ref 17592186421536} {:answer/id #uuid "60dea114-5917-5702-91f4-2d9dcc51d500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}6 & 6 \\\\ 4 & 4\\end{aligned}]" :db/id #edb/ref 17592186421537} {:answer/id #uuid "d7328dc6-408b-5e04-a91b-4f561c57f94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186421542}] :answer-field/correct {:db/id #edb/ref 17592186421535} :answer-field/id #uuid "fd431940-6ae8-53c2-934a-5aaba85bb3f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186421544}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e78f486a-816c-52d1-9895-59ae0c720ab7" :question/math-academy-id "q-130635" :question/problem "If $B=[\\begin{aligned}3 & 3 \\\\ -2 & -2\\end{aligned}]$, then ${B}^{5}=$" :question/worked-solution "First, we compute ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}3 & 3 \\\\ -2 & -2\\end{aligned}]\\cdot [\\begin{aligned}3 & 3 \\\\ -2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -6 & 3\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nNotice that ${B}^{2}=B,$ so $B$ is an idempotent matrix. \n\nWe can use this fact to compute ${B}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{B}^{5} & ={B}^{2}\\cdot {B}^{2}\\cdot B \\\\  & =B\\cdot B\\cdot B \\\\  & ={B}^{2}\\cdot B \\\\  & =B\\cdot B \\\\  & ={B}^{2} \\\\  & =B\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{B}^{5}=[\\begin{aligned}3 & 3 \\\\ -2 & -2\\end{aligned}].\n$$"} :step/id #uuid "5285a05f-cf11-5920-837d-f9098de49325"}] :activity/title "Nilpotent and Idempotent Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421533}]}
