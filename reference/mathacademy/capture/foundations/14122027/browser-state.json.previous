              "value": "I and IV only",
              "html": " I and IV only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-97928-c",
              "type": "text",
              "value": "II only",
              "html": " II only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-97928-d",
              "type": "text",
              "value": "II and III only",
              "html": " II and III only"
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-97928-e",
              "type": "text",
              "value": "I only",
              "html": " I only"
