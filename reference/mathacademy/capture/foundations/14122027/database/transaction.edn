[{:db/id 17592186172049 :knowledge-point/questions ["question-d6641b4f-e396-5ff5-8410-bd9f53c4e8d6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186172048 :knowledge-point/questions ["question-f3651fdc-2d8e-55e9-b5a9-f7f59a5112bf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f3651fdc-2d8e-55e9-b5a9-f7f59a5112bf" :question/id #uuid "f3651fdc-2d8e-55e9-b5a9-f7f59a5112bf" :question/math-academy-id "q-98319" :question/problem "Which of the following curves is *not* closed?" :question/worked-solution "A curve is closed if its terminal point coincides with its initial point. So, a curve whose terminal point does not coincide with its initial point is not closed. \n\nOf the given options, the only one that is not a closed curve is the following:\n\n![](images/22/22a50051d5281880b40c0960c2de28ce077e836a4bf1c84193d13154ff25f6a5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0fd376f-ce32-577b-9dd3-21c563e97b1a"] :db/ensure [:question/validate]} {:db/id "answer-field-b0fd376f-ce32-577b-9dd3-21c563e97b1a" :answer-field/id #uuid "b0fd376f-ce32-577b-9dd3-21c563e97b1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44cb249c-78ea-5c88-8794-19ba3bd7aadb" :answer-field/choices ["answer-87035970-291d-57cf-99b2-27ae082ac3bc" "answer-8bd22568-357c-5669-9cba-b0e0ee0cd4ff" "answer-44cb249c-78ea-5c88-8794-19ba3bd7aadb" "answer-acc32805-5477-58a9-9d2b-3ec91327f610" "answer-19015d56-d409-5e38-9d72-d0a571908ddb"] :db/ensure [:answer-field/validate]} {:db/id "answer-87035970-291d-57cf-99b2-27ae082ac3bc" :answer/id #uuid "87035970-291d-57cf-99b2-27ae082ac3bc" :answer/type :answer.type/image :answer/value "images/1e/1ea7160d343a681d7a81e93eb755c252a17186fe85e66ad83d63c51d179f433b.png" :db/ensure [:answer/validate]} {:db/id "answer-8bd22568-357c-5669-9cba-b0e0ee0cd4ff" :answer/id #uuid "8bd22568-357c-5669-9cba-b0e0ee0cd4ff" :answer/type :answer.type/image :answer/value "images/1f/1fccb402189374def1b1a7c52aabd690364335ee373fb7b6c68f467c085cf585.png" :db/ensure [:answer/validate]} {:db/id "answer-44cb249c-78ea-5c88-8794-19ba3bd7aadb" :answer/id #uuid "44cb249c-78ea-5c88-8794-19ba3bd7aadb" :answer/type :answer.type/image :answer/value "images/22/22a50051d5281880b40c0960c2de28ce077e836a4bf1c84193d13154ff25f6a5.png" :db/ensure [:answer/validate]} {:db/id "answer-acc32805-5477-58a9-9d2b-3ec91327f610" :answer/id #uuid "acc32805-5477-58a9-9d2b-3ec91327f610" :answer/type :answer.type/image :answer/value "images/44/44e7444bde45c40f830ea4ccac708488cbb90a9595cb184dcdc4f5011ff66f58.png" :db/ensure [:answer/validate]} {:db/id "answer-19015d56-d409-5e38-9d72-d0a571908ddb" :answer/id #uuid "19015d56-d409-5e38-9d72-d0a571908ddb" :answer/type :answer.type/image :answer/value "images/e7/e7e2c6fcda97890e06ae12c7f2e175e0c0c75bdcbc66cbd82d9802f92449d6e9.png" :db/ensure [:answer/validate]} {:db/id "question-d6641b4f-e396-5ff5-8410-bd9f53c4e8d6" :question/id #uuid "d6641b4f-e396-5ff5-8410-bd9f53c4e8d6" :question/math-academy-id "q-98339" :question/problem "![](images/98/9836234d763ccb3da6b9ac0360dcb3662cacc5fc90d5ecc2dee20bf29ce0c77d.png)\n\nWhich of the curves above is simple, closed, and negatively oriented?" :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented. \n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is neither simple nor closed.\n\n- Curve II is a simple and closed curve but it is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\n- Curve III is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve IV is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\nTherefore, the correct answer is \"III and IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8230f704-b679-555a-b3ea-6455f032cf02"] :db/ensure [:question/validate]} {:db/id "answer-field-8230f704-b679-555a-b3ea-6455f032cf02" :answer-field/id #uuid "8230f704-b679-555a-b3ea-6455f032cf02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2b798def-9f4c-5c78-939d-4d3fa7b155b5" :answer-field/choices ["answer-36a1e53d-4736-58e7-9183-e39dca9e0ce1" "answer-64b20a39-4422-555e-853c-addaea9024df" "answer-4305aa10-6b9d-5a8d-b5e0-73d08076c6a1" "answer-6db79444-4f16-52ba-8432-cedcce75ea2c" "answer-2b798def-9f4c-5c78-939d-4d3fa7b155b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-36a1e53d-4736-58e7-9183-e39dca9e0ce1" :answer/id #uuid "36a1e53d-4736-58e7-9183-e39dca9e0ce1" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-64b20a39-4422-555e-853c-addaea9024df" :answer/id #uuid "64b20a39-4422-555e-853c-addaea9024df" :answer/type :answer.type/text :answer/value "I, II, and III only" :db/ensure [:answer/validate]} {:db/id "answer-4305aa10-6b9d-5a8d-b5e0-73d08076c6a1" :answer/id #uuid "4305aa10-6b9d-5a8d-b5e0-73d08076c6a1" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-6db79444-4f16-52ba-8432-cedcce75ea2c" :answer/id #uuid "6db79444-4f16-52ba-8432-cedcce75ea2c" :answer/type :answer.type/text :answer/value "II, III, and IV only" :db/ensure [:answer/validate]} {:db/id "answer-2b798def-9f4c-5c78-939d-4d3fa7b155b5" :answer/id #uuid "2b798def-9f4c-5c78-939d-4d3fa7b155b5" :answer/type :answer.type/text :answer/value "III and IV only" :db/ensure [:answer/validate]} {:db/id "activity-efd4467a-4377-5bbc-a79e-4cb35382c6af" :activity/id #uuid "efd4467a-4377-5bbc-a79e-4