      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q140963-1ba40fd4af87c990c60e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q140963-1ba40fd4af87c990c60e.png",
      "source_url": "https://mathacademy.com/tasks/14226283/topics/3133/lesson",
      "captured_at": 1792054358.2098093,
      "math_academy_id": "q-140963",
      "topic_id": "3133",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q140963",
        "placement_id": null,
        "content_id": null,
        "type": null
