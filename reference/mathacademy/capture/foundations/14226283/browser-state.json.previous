      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q98797-cba678d7dd5f3377e4d1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q98797-cba678d7dd5f3377e4d1.png",
      "source_url": "https://mathacademy.com/tasks/14226283/topics/3133/lesson",
      "captured_at": 1792054459.5226946,
      "math_academy_id": "q-98797",
      "topic_id": "3133",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q98797",
        "placement_id": null,
        "content_id": null,
        "type": null
