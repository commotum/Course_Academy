      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q140961-1ae1b014ee36ca8a040d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14226283/observations/step-q140961-1ae1b014ee36ca8a040d.png",
      "source_url": "https://mathacademy.com/tasks/14226283/topics/3133/lesson",
      "captured_at": 1792054327.05042,
      "math_academy_id": "q-140961",
      "topic_id": "3133",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q140961",
        "placement_id": null,
        "content_id": null,
