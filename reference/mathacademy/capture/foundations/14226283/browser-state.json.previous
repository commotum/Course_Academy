criptlevel=\"0\"><mfrac><mn>2</mn><msqrt><mn>5</mn></msqrt></mfrac></mstyle></mtd><mtd><mstyle mathbackground=\"lightgray\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>6</mn></msqrt></mfrac></mstyle></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
