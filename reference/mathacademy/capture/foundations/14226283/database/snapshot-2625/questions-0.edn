db/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186382019} {:answer/id #uuid "3362e4e1-8f8b-5e23-bfe7-e5c71687e3ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382020} {:answer/id #uuid "59510434-3ba1-51d5-85cf-ff843e18cd11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186382021} {:answer/id #uuid "2f1de37a-d0e4-554e-867b-9eddfe4a699c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382022}] :answer-field/correct {:answer/id #uuid "3362e4e1-8f8b-5e23-bfe7-e5c71687e3ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382020} :answer-field/id #uuid "26f6dddc-207b-5ada-a853-8f975e7c1162" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186382018} {:answer-field/choices [{:answer/id #uuid "93229c20-24ce-5d7e-bcb8-de40cff8311c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186382024} {:answer/id #uuid "dc1a7775-fa89-5a70-99d7-50a32a2340da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382025} {:answer/id #uuid "df827696-cccc-524f-8dd7-9a486d655d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186382026} {:answer/id #uuid "57eef191-29b6-557c-bb0d-c552c0ee5cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382027}] :answer-field/correct {:answer/id #uuid "57eef191-29b6-557c-bb0d-c552c0ee5cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382027} :answer-field/id #uuid "82392c3a-f0f6-5951-a926-f66c0787e9b1" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186382023}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d1f0a35-56cb-5370-99fa-b599f7ccb0a4" :question/math-academy-id "q-363840" :question/problem "$$\nA=\\begin{bmatrix}4 & 0 \\\\ 3 & 0 \\\\ 0 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.From the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | $\\frac{3}{5}$ |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as\n\n$$\n\\begin{bmatrix}-\\frac{3}{4}{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}-\\frac{3}{4} \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n| | ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-7}} |  |  |  |\n|  | $0$ |  |  |  | | | ${u}_{3}=\\,\\,$ |  | $0$ |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-8}} |  |  |  |\n|  | {{field-9}} |  |  |  | |  |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n|  | {{field-7}} |  |  |  |\n|  | $0$ |  |  |  |\n| ${u}_{3}=\\,\\,$ |  | $0$ |  |  |\n|  | {{field-8}} |  |  |  |\n|  | {{field-9}} |  |  |  |" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}\\begin{bmatrix}4 & 0 \\\\ 3 & 0 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}4 \\\\ 3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{4}{5}{x}_{1}+\\frac{3}{5}{x}_{2}=0\\,⟹\\,4{x}_{1}+3{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}-\\frac{3}{4}{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}{{\\begin{bmatrix}-\\frac{3}{4} \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}-\\frac{3}{5} \\\\ \\frac{4}{5} \\\\ 0\\end{bmatrix}\\,{u}_{3}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}\\frac{4}{5} & -\\frac{3}{5} & 0 \\\\ \\frac{3}{5} & \\frac{4}{5} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162711 :knowledge-point/_questions [{:db/id #edb/ref 17592186162041 :knowledge-point/id #uuid "44c68619-9cf3-5dd8-b3db-00c9730d3308" :knowledge-point/title "Finding the Third Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88817c4f-c3b9-56bc-adcd-03c60a03192d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161559} {:answer/id #uuid "ab726398-a6bf-5ccb-8b76-7638be326bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161560} {:answer/id #uuid "b6527ce3-e389-5aaa-b56f-28b8e5cb3b6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186161561} {:answer/id #uuid "192d7516-f9d8-5c3c-923d-9aea265083e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161562} {:answer/id #uuid "70c54196-2e1b-509b-a193-ae9743cdbb59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161563}] :answer-field/id #uuid "7b64cb77-d8a8-5314-8588-5996a0ed2a99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161558} {:answer-field/choices [{:answer/id #uuid "fcbb2747-c859-5f45-8d0d-7a05c9e1438c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} {:answer/id #uuid "3a523ac3-cde3-56a8-a0ad-d2ed6c685448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395272} {:answer/id #uuid "0bc93829-a56e-5c44-b5e8-b1f6a5b14a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186395273} {:answer/id #uuid "b256bcc9-0977-57b1-a4d8-3631bdea12e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395274} {:answer/id #uuid "38bfef24-5630-5d56-928e-7a0c767b17da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186395275}] :answer-field/correct {:answer/id #uuid "fcbb2747-c859-5f45-8d0d-7a05c9e1438c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186395271} :answer-field/id #uuid "1d6fa282-78f2-5e39-89f3-9b4093833ea4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4c01100-25ba-535e-8cf2-008c4f230608" :question/math-academy-id "q-97364" :question/problem "$$\nA=\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -2 & -2 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=2.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=9,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-9I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-9\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-9I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=4,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-4I & =\\begin{bmatrix}8 & 2 \\\\ 2 & 5\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-4I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186371408 :knowledge-point/_questions [{:db/id #edb/ref 17592186162041 :knowledge-point/id #uuid "44c68619-9cf3-5dd8-b3db-00c9730d3308" :knowledge-point/title "Finding the Third Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5839e9-80d7-5785-a1f8-7ec9a7ad0f42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186371410} {:answer/id #uuid "b52a5ad3-bf7c-5554-813a-1685302d6428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186371411} {:answer/id #uuid "97a90adf-b856-53e9-909e-a7111d3242c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186371412} {:answer/id #uuid "e7240456-37a5-548b-a3d3-66446f2c4a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186371413} {:answer/id #uuid "663f3418-9b4b-5d7c-9b04-5b73560bd3bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371414}] :answer-field/correct {:answer/id #uuid "8e5839e9-80d7-5785-a1f8-7ec9a7ad0f42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186371410} :answer-field/id #uuid "502d80e5-6dba-5c14-a7f8-67f71951bbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371409}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0eeb953f-3b63-506e-a022-ee4f22f02d5f" :question/math-academy-id "q-98638" :question/problem "$$\nA=\\begin{bmatrix}0 & -2 \\\\ 0 & 4 \\\\ 0 & 4\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -2 \\\\ 0 & 4 \\\\ 0 & 4\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -2 \\\\ 0 & 4 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ -2 & 4 & 4\\end{bmatrix}\\begin{bmatrix}0 & -2 \\\\ 0 & 4 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 36\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=0.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=36,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-36I & =\\begin{bmatrix}0 & 0 \\\\ 0 & 36\\end{bmatrix}-36\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-36 & 0 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-36I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}0 & 0 \\\\ 0 & 36\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 36\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186423860 :knowledge-point/_questions [{:db/id #edb/ref 17592186162041 :knowledge-point/id #uuid "44c68619-9cf3-5dd8-b3db-00c9730d3308" :knowledge-point/title "Finding the Third Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "638544f6-d991-54a5-a4d8-ecaa3debbb1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186423730} {:answer/id #uuid "b8a6236e-9fba-51b6-aa0e-19a3ed14cae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186423776} {:answer/id #uuid "b94d682e-35ca-5739-b2ba-935c81f37a8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{3}} & \\frac{\\sqrt{2}}{\\sqrt{3}} \\\\ \\frac{\\sqrt{2}}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}" :db/id #edb/ref 17592186423778} {:answer/id #uuid "c057de32-8797-5b34-b386-4b093e00ade0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186423783} {:answer/id #uuid "fdb05775-587d-5b72-a2b6-f38cdc8373a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186423820}] :answer-field/correct {:answer/id #uuid "638544f6-d991-54a5-a4d8-ecaa3debbb1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}" :db/id #edb/ref 17592186423730} :answer-field/id #uuid "6ddabdfb-5018-539f-b46b-d3a2b31916f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423833}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80997e16-c7cf-546e-901a-0d8f5c371714" :question/math-academy-id "q-98641" :question/problem "$$\nA=\\begin{bmatrix}0 & \\,\\,2 \\\\ 0 & \\,\\,-2 \\\\ 0 & \\,\\,1\\end{bmatrix},\\,Σ=\\begin{bmatrix}3 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & \\,\\,2 \\\\ 0 & \\,\\,-2 \\\\ 0 & \\,\\,1\\end{bmatrix}}^{T}\\begin{bmatrix}0 & \\,\\,2 \\\\ 0 & \\,\\,-2 \\\\ 0 & \\,\\,1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 2 & -2 & 1\\end{bmatrix}\\begin{bmatrix}0 & \\,\\,2 \\\\ 0 & \\,\\,-2 \\\\ 0 & \\,\\,1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 9\\end{bmatrix}\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=0.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=9,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-9I & =\\begin{bmatrix}0 & 0 \\\\ 0 & 9\\end{bmatrix}-9\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-9 & 0 \\\\ 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-9I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =\\begin{bmatrix}0 & 0 \\\\ 0 & 9\\end{bmatrix}-0\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}0 & 0 \\\\ 0 & 9\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $V:$\n\n$$\nV=\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186408020 :knowledge-point/_questions [{:db/id #edb/ref 17592186162043 :knowledge-point/id #uuid "8b36c482-75a0-5413-8e3e-4a72e3ddb26a" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a847e10-ad2a-5e19-bffe-4f473d1f4614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186407950} {:answer/id #uuid "53b3d1ac-5ba6-5b42-802f-34c001d2a3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186407952} {:answer/id #uuid "7ba9bbe0-a4bd-5d08-aca1-3c1661cf6c5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ -\\frac{1}{2} \\\\ \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186407966} {:answer/id #uuid "e36cd36f-f51a-505a-8f73-b691e55977cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186407993} {:answer/id #uuid "e71af25d-d057-558a-8db8-29ad46847b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186407996}] :answer-field/correct {:answer/id #uuid "e71af25d-d057-558a-8db8-29ad46847b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186407996} :answer-field/id #uuid "1e3568eb-62d3-583e-93bd-bbecf0a0149d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "256724b0-7532-517f-89d9-acc3daa6cf56" :question/math-academy-id "q-98766" :question/problem "$$\nA=\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=3.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-\\frac{5}{\\sqrt{2}} \\\\ \\frac{5}{\\sqrt{2}} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2} &=0 \\\\ -\\frac{1}{3\\sqrt{2}}{x}_{1}-\\frac{1}{3\\sqrt{2}}{x}_{2}-\\frac{4}{3\\sqrt{2}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}-{x}_{1}+{x}_{2} &=0 \\\\ -{x}_{1}-{x}_{2}-4{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ 0 & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186371429 :knowledge-point/_questions [{:db/id #edb/ref 17592186162043 :knowledge-point/id #uuid "8b36c482-75a0-5413-8e3e-4a72e3ddb26a" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d74d4e6a-a2fb-53e8-8e78-2d14949a12fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371431} {:answer/id #uuid "6e1c4a83-8cdf-5b61-8446-22274e2c4d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} \\\\ 0 \\\\ -\\frac{3}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186371432} {:answer/id #uuid "253c1d32-31e5-545e-bf47-15607badcd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371433} {:answer/id #uuid "616c3f04-cce5-5e8c-a2fa-70633c80921f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371434} {:answer/id #uuid "80f3af4a-ee17-5ae0-93d3-4ead53a6e48c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186371435}] :answer-field/correct {:answer/id #uuid "253c1d32-31e5-545e-bf47-15607badcd6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186371433} :answer-field/id #uuid "280b7aa8-2f12-5405-8f23-6f3ea0f0ea3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5dfe9dfb-2de9-5049-bb36-b64e2c2a8946" :question/math-academy-id "q-98770" :question/problem "$$\nA=\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{2} & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{2}$ and ${\\sigma }_{2}=1.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ -1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}\\begin{bmatrix}0 & 1 \\\\ -1 & 0 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{2}+\\frac{1}{\\sqrt{2}}{x}_{3} &=0 \\\\ {x}_{1} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{x}_{2}-{x}_{3} &=0 \\\\ {x}_{1} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186371436 :knowledge-point/_questions [{:db/id #edb/ref 17592186162043 :knowledge-point/id #uuid "8b36c482-75a0-5413-8e3e-4a72e3ddb26a" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3ca5a0b-c8af-5e70-962f-1f5f6f4b7f7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371438} {:answer/id #uuid "1a8785d7-c5ad-518a-acd1-9f9ada9bd015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371439} {:answer/id #uuid "88254370-bfae-5dc3-81e7-adc53cf53476" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186371440} {:answer/id #uuid "7be15a9b-8f59-5064-9812-d260abe9e0d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186371441} {:answer/id #uuid "2cc59cf3-c247-5942-a9f5-c1997970aef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186371442}] :answer-field/correct {:answer/id #uuid "88254370-bfae-5dc3-81e7-adc53cf53476" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186371440} :answer-field/id #uuid "77e9283f-fec6-5979-96c1-f6617f8a4d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fbce2d1-be2d-5c6a-bfaf-0486d4c0daa8" :question/math-academy-id "q-98772" :question/problem "$$\nA=\\begin{bmatrix}0 & 4 \\\\ 4 & 2 \\\\ 4 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=4.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{6}\\begin{bmatrix}0 & 4 \\\\ 4 & 2 \\\\ 4 & 0\\end{bmatrix}\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}\\frac{4}{\\sqrt{5}} \\\\ \\frac{10}{\\sqrt{5}} \\\\ \\frac{8}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{3\\sqrt{5}} \\\\ \\frac{5}{3\\sqrt{5}} \\\\ \\frac{4}{3\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{4}\\begin{bmatrix}0 & 4 \\\\ 4 & 2 \\\\ 4 & 0\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}\\frac{8}{\\sqrt{5}} \\\\ 0 \\\\ -\\frac{4}{\\sqrt{5}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}\\frac{2}{3\\sqrt{5}}{x}_{1}+\\frac{5}{3\\sqrt{5}}{x}_{2}+\\frac{4}{3\\sqrt{5}}{x}_{3} &=0 \\\\ \\frac{2}{\\sqrt{5}}{x}_{1}-\\frac{1}{\\sqrt{5}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}2{x}_{1}+5{x}_{2}+4{x}_{3} &=0 \\\\ 2{x}_{1}-{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}\\frac{2}{3\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & \\frac{1}{3} \\\\ \\frac{5}{3\\sqrt{5}} & 0 & -\\frac{2}{3} \\\\ \\frac{4}{3\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & \\frac{2}{3}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186162725 :knowledge-point/_questions [{:db/id #edb/ref 17592186162043 :knowledge-point/id #uuid "8b36c482-75a0-5413-8e3e-4a72e3ddb26a" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fd0fef2-41cf-5b78-ab4f-6f03d4dacfd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161643} {:answer/id #uuid "17be549c-a1c7-5060-987e-c5b65ac2b51a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161644} {:answer/id #uuid "3bcd3583-93e7-5a4f-bd1e-dbffb277553f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186161645} {:answer/id #uuid "56db7078-0264-534f-afb4-fd027ef181b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186161646} {:answer/id #uuid "6402e77e-c348-5104-b7eb-d18e02ab6813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161647}] :answer-field/id #uuid "a8478cb6-55ac-5ba0-aa86-521b99077edf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161642} {:answer-field/choices [{:answer/id #uuid "e50a614d-fd6f-55be-9356-ebb15749bb1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382663} {:answer/id #uuid "f1a31908-a2f5-584e-8101-a70a1d5408a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382664} {:answer/id #uuid "5fa7355e-413d-5cfe-860d-bd5a74b01f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382665} {:answer/id #uuid "d2048545-37eb-5154-98fb-fbdc70936239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186382666} {:answer/id #uuid "a3ccc71c-705b-55f1-bd7a-216a4ecad2d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186382667}] :answer-field/correct {:answer/id #uuid "a3ccc71c-705b-55f1-bd7a-216a4ecad2d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186382667} :answer-field/id #uuid "601494e0-9a29-5b8f-8afd-34cbf959efa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcd0e8b8-71e5-5dcd-a370-0847d15e9434" :question/math-academy-id "q-98797" :question/problem "$$\nA=\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=4.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{8}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-\\frac{4}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{3\\sqrt{2}}{x}_{1}+\\frac{4}{3\\sqrt{2}}{x}_{2}-\\frac{1}{3\\sqrt{2}}{x}_{3} &=0 \\\\ -\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2}-{x}_{3} &=0 \\\\ -{x}_{1}+{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & \\frac{2}{3} \\\\ \\frac{4}{3\\sqrt{2}} & 0 & \\frac{1}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & \\frac{2}{3}\\end{bmatrix}\n$$"}]}
