 :answer.type/math} :answer/value "{x}_{1}-{x}_{2}-{x}_{3}=0" :db/id #edb/ref 17592186370783}] :answer-field/correct {:answer/id #uuid "79c46fec-a82d-5900-b4fe-a1dc0b5c3123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{1}-{x}_{2}-{x}_{3}=0" :db/id #edb/ref 17592186370783} :answer-field/id #uuid "e455c542-5f61-5285-9c75-c98cfc70148d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370780} {:answer-field/choices [{:answer/id #uuid "b0d5413a-c13c-5d3c-9a69-76e5f447caf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186370785} {:answer/id #uuid "09a41c42-f45b-5403-ade0-2ff3f5354004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370786} {:answer/id #uuid "4b9851b4-97e7-55d3-9a45-9433a9398ddd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186370787} {:answer/id #uuid "83465c04-e18f-546b-8d8d-90aa97a84c6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186370788}] :answer-field/correct {:answer/id #uuid "09a41c42-f45b-5403-ade0-2ff3f5354004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370786} :answer-field/id #uuid "474ee673-3497-5f1e-a5d6-80565a7c7701" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370784} {:answer-field/choices [{:answer/id #uuid "6f28c657-bf02-56b8-a5ce-171c20a9e011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{2}" :db/id #edb/ref 17592186370790} {:answer/id #uuid "e40d9b2e-f692-5e4a-bdeb-acf4cbb897cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}_{2}" :db/id #edb/ref 17592186370791} {:answer/id #uuid "280915e9-b8c4-54c0-8bd6-91e0f0ef5a00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}_{2}" :db/id #edb/ref 17592186370792}] :answer-field/correct {:answer/id #uuid "6f28c657-bf02-56b8-a5ce-171c20a9e011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}_{2}" :db/id #edb/ref 17592186370790} :answer-field/id #uuid "e4a0882a-6783-515b-82d0-8e9c1b124672" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370789}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f78c939-def6-5572-9238-dd9f4998a788" :question/math-academy-id "q-363837" :question/problem "$$\nA=\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & -1\\end{bmatrix},\\,Σ=\\begin{bmatrix}\\sqrt{6} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=\\sqrt{6}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $-\\frac{1}{\\sqrt{3}}$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as:\n\n$$\n\\begin{bmatrix}{x}_{2}+{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}{{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}}.\n$$\n\nNext, we orthogonalize ${b}_{1}$ and ${b}_{2}$ using the Gram-Schmidt process to get the corresponding orthogonal vectors ${c}_{1}$ and ${c}_{2}.$\n\nLet ${c}_{1}={b}_{1},$ then:\n\n|  |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${c}_{2}=\\frac{1}{2}\\,\\,$ |  | $-1$ |  |  |\n|  |  | {{field-7}} |  |  |\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\frac{1}{\\sqrt{2}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-10}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-11}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\frac{2}{\\sqrt{6}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{6}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{6}}\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ -1 & -1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{\\sqrt{6}}\\begin{bmatrix}\\frac{2}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix}\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{3}}{x}_{1}-\\frac{1}{\\sqrt{3}}{x}_{2}-\\frac{1}{\\sqrt{3}}{x}_{3}=0\\,⟹\\,{x}_{1}-{x}_{2}-{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}{x}_{2}+{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}{{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables. \n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are *not* mutually orthogonal. Therefore, we have to orthogonalize them using the Gram-Schmidt process. So, let \n\n$$\n{c}_{1}={b}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$\n\nThen,\n\n$$\n\\begin{aligned}{c}_{2} & ={b}_{2}-\\frac{{b}_{2}\\cdot {c}_{1}}{{c}_{1}\\cdot {c}_{1}}{c}_{1}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}=\\frac{1}{2}\\begin{bmatrix}1 \\\\ -1 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix},\\,{u}_{3}=\\begin{bmatrix}\\frac{1}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}}\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{3}} & 0 & \\frac{2}{\\sqrt{6}}\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186381985 :knowledge-point/_questions [{:db/id #edb/ref 17592186162042 :knowledge-point/id #uuid "a6732620-fad1-5dd3-98c5-07ba59d0b286" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix: Advanced Cases"}] :question/answer-fields 