      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14169255/observations/step-q160853-fddb7c35da886f3f90f0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14169255/observations/step-q160853-fddb7c35da886f3f90f0.png",
      "source_url": "https://mathacademy.com/tasks/14169255/topics/1998/lesson",
      "captured_at": 1791900344.5773778,
      "math_academy_id": "q-160853",
      "topic_id": "1998",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q160853",
        "placement_id": null,
