      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14169255/observations/step-q82874-c2907b762db3b03bdf6a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14169255/observations/step-q82874-c2907b762db3b03bdf6a.png",
