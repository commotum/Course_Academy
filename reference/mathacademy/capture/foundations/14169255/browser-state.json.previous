      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14169255/observations/step-q83943-f8b784e7a50d725835ff.png",
      "source_url": "https://mathacademy.com/tasks/14169255/topics/1998/lesson",
      "captured_at": 1791900475.2853963,
      "math_academy_id": "q-83943",
      "topic_id": "1998",
      "sequence_position": null,
      "source_step": {
