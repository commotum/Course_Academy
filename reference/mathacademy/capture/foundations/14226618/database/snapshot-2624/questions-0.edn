#{[{:db/id #edb/ref 17592186259608 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075ffae1-ea68-5f4d-bb63-f49b56d8e6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186256845} {:answer/id #uuid "51a75927-20c3-52d1-a64d-8ec72f7cabd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257476} {:answer/id #uuid "645886ef-4aa0-5f2b-bb93-dc06146a70f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257662} {:answer/id #uuid "7afaaf8e-21fa-551e-b15c-0317c5d6ef18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257872} {:answer/id #uuid "99fb9ef2-4ee0-53a2-a318-7d1eb71ac286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258136}] :answer-field/correct {:answer/id #uuid "51a75927-20c3-52d1-a64d-8ec72f7cabd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257476} :answer-field/id #uuid "cb49f773-46c7-535f-a9e1-dc1765ec0827" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42bfa60d-7b26-5dc6-9634-a2e58886024d" :question/math-academy-id "q-124179" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=3$ and ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y=5,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-3+5 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259609 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6b1eff-f968-5af6-ab7e-497c5b252f54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257032} {:answer/id #uuid "65fa06b4-0249-5df6-91c8-d1c80fb913d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257681} {:answer/id #uuid "6f4f8d99-5f81-5776-b928-ceb7dbffd985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257760} {:answer/id #uuid "ef1a5375-4524-5e93-b903-4a134bf9563e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186258856} {:answer/id #uuid "fc6782be-6222-5451-a953-3a91a661ea0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258989}] :answer-field/correct {:answer/id #uuid "6f4f8d99-5f81-5776-b928-ceb7dbffd985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257760} :answer-field/id #uuid "2af5069a-1d91-5111-8f4b-2d7bfb92501a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259109}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f705291d-0bfe-5456-9170-c496d39786bb" :question/math-academy-id "q-124180" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=-1$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x=4,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-(-1)-4 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259611 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f8bea7-f157-5532-a468-95b5708e4fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186257264} {:answer/id #uuid "71135936-edfe-5d2f-adb8-755e5f1874d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257776} {:answer/id #uuid "95c3025e-8902-5386-9af8-541222a94080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186258099} {:answer/id #uuid "9d3c0832-365c-5530-ad6d-f0694223072e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186258167} {:answer/id #uuid "b8df599f-5734-5558-9968-7b8c1e6339d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258399}] :answer-field/correct {:answer/id #uuid "b8df599f-5734-5558-9968-7b8c1e6339d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258399} :answer-field/id #uuid "8e045e73-83c1-5097-9b91-3fe86a4cdd62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9aaf57c2-f732-5f6e-81fd-8a42d073c397" :question/math-academy-id "q-124182" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=14$ and ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x=10,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-14+10 \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259678 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "890a190d-bf37-5027-98d5-bd1b47b8457e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186257987} {:answer/id #uuid "9dffee14-86ab-5370-9b6a-5333a24fc305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi +10" :db/id #edb/ref 17592186258172} {:answer/id #uuid "da55bd22-12fc-5d88-af4e-5c356f0aa522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258688} {:answer/id #uuid "e0eba909-0416-5007-b05c-491653b335ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258740} {:answer/id #uuid "ef8bb785-00fe-5438-9215-df8ed8ecac41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi +5\\sqrt{2}" :db/id #edb/ref 17592186258861}] :answer-field/correct {:answer/id #uuid "e0eba909-0416-5007-b05c-491653b335ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258740} :answer-field/id #uuid "f531f888-5ca9-5a2d-a14e-05f5beb01e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259458}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9c15b831-9542-5e2b-8769-835aae0b933e" :question/math-academy-id "q-124347" :question/problem "![](images/03/0361756c09e5f72ddb040240bbec492c0a9dd3562307253ae31bece95bb41d88.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$  where $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is the path comprising of two line segments and a semicircle or radius $4,$ traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}] [{:db/id #edb/ref 17592186259679 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ca0885-40bb-54cb-993c-16ff6bf31c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186256840} {:answer/id #uuid "12fa8929-0c5a-5ace-90d7-c5115bf0058b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186256953} {:answer/id #uuid "183c8bbd-3c11-5936-9ffc-c6982100aaf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256992} {:answer/id #uuid "500abeff-f88a-5e7f-b4d5-355a04de8c57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257467} {:answer/id #uuid "efca4aee-a601-54e9-a99b-317ab7d1d962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258865}] :answer-field/correct {:answer/id #uuid "183c8bbd-3c11-5936-9ffc-c6982100aaf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256992} :answer-field/id #uuid "1ac8b6b8-ab1c-5e1c-a116-351ff4b5cdb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259077}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "239dd34c-3202-5609-97c3-2d198c5bc0b2" :question/math-academy-id "q-124348" :question/problem "![](images/9b/9b3065e58decfca5355252b93ec3283cc5ffc96dc04826aeab1131e95d3a2e64.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along the rectangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}]}
