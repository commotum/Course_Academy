#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186482621} :activity/id #uuid "12b9dfa6-9b29-5bbc-991a-88ee2275afa9" :activity/scope {:db/id #edb/ref 17592186049511 :topic/id #uuid "fabe76f4-9f30-5b59-b906-f5fa71cfb89f" :topic/math-academy-id 1940} :activity/steps [{:db/id #edb/ref 17592186482619 :step/content {:db/id #edb/ref 17592186482608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "644861a7-1cbc-5867-8185-defe9888db93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i-j" :db/id #edb/ref 17592186482005} {:answer/id #uuid "73996ca2-8d53-576d-9599-e7d064a54b16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\,j" :db/id #edb/ref 17592186482042} {:answer/id #uuid "8054282c-e26d-5511-a066-a463f3020bfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,i+2\\,j" :db/id #edb/ref 17592186482072} {:answer/id #uuid "b5877c60-a794-5905-b476-5b03a5663061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i" :db/id #edb/ref 17592186482203} {:answer/id #uuid "f6a04f0f-fb4c-5c47-a171-0ccaf2eedb86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-i+2\\,j" :db/id #edb/ref 17592186482358}] :answer-field/correct {:db/id #edb/ref 17592186482072} :answer-field/id #uuid "7ad3bafa-b0de-589d-9a11-64d4563a5603" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186482443}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eaaccc28-17cb-56b1-b96e-6187ebe91480" :question/math-academy-id "q-130203" :question/problem "Consider the plane curve ${y}^{2}=1-{x}^{2}+2y.$ Find a tangent vector to that curve at the point $(-1,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2} & =1-{x}^{2}+2y \\\\ {x}^{2}+{y}^{2}-2y & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}-2y,$ our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve that passes through the point $(-1,2)$ can be computed as follows:\n\n$$\nt(-1,2)={f}_{y}(-1,2)i-{f}_{x}(-1,2)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,2):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}-2y)i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}-2y)j \\\\  & =(2y-2)i-2x\\,j \\\\ t(-1,2) & =(2(2)-2)i-2(-1)\\,j \\\\  & =2\\,i+2\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $2\\,i+2\\,j.$"} :step/id #uuid "02f310c0-3a63-5ca4-a009-b9bb2d7c2097" :step/next {:db/id #edb/ref 17592186482651}} {:db/id #edb/ref 17592186482621 :step/content {:db/id #edb/ref 17592186323918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cbb66c-c87e-532e-b215-79cebdd50220" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e-8)\\,i+(\\frac{e}{2}-8)j" :db/id #edb/ref 17592186321343} {:answer/id #uuid "25737ab8-5934-517a-82e3-355f226249ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1-4e)\\,i+(\\frac{2}{e}-8)j" :db/id #edb/ref 17592186321438} {:answer/id #uuid "569fd915-b891-5273-a763-b23c030c775d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2-8e)\\,i+(2-8e)j" :db/id #edb/ref 17592186321831} {:answer/id #uuid "91bfacf0-e81a-591f-b5c7-eb843413fffc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2}{e}-8)i+(8e-2)\\,j" :db/id #edb/ref 17592186322304} {:answer/id #uuid "e6c24a19-a0b8-5781-9f03-f3684c7d7f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8-2e)\\,i+(\\frac{8}{e}-2)j" :db/id #edb/ref 17592186322954}] :answer-field/correct {:db/id #edb/ref 17592186322304} :answer-field/id #uuid "2328f82b-ecf4-5e93-897c-028b4fd16484" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12b276e2-b703-55f7-94b8-069326b3f510" :question/math-academy-id "q-37516" :question/problem "Consider the plane curve $2x\\operatorname{ln}⁡y=8xy+2-8e.$ Find a tangent vector to that curve at the point $(1,e).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡y & =8xy+2-8e \\\\ 2x\\operatorname{ln}⁡y-8xy & =2-8e\\end{aligned}\n$$\n\nIf we set $f(x,y)=2x\\operatorname{ln}⁡y-8xy$, our curve can be viewed as the level curve $f(x,y)=2-8e.$ \n\nA tangent vector to the level curve that passes through the point $(1,e)$ can be computed as follows:\n\n$$\nt(1,e)={f}_{y}(1,e)\\,i-{f}_{x}(1,e)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,e):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2x\\operatorname{ln}⁡y-8xy)\\,i-\\frac{∂}{∂x}(2x\\operatorname{ln}⁡y-8xy)\\,j \\\\  & =(\\frac{2x}{y}-8x)i-(2\\operatorname{ln}⁡y-8y)\\,j \\\\ t(1,e) & =(\\frac{2(1)}{e}-8(1))i-(2\\operatorname{ln}⁡e-8(e))\\,j \\\\  & =(\\frac{2}{e}-8)i+(8e-2)j\\end{aligned}\n$$\n\n  \n\nTherefore, our tangent vector is $(\\frac{2}{e}-8)i+(8e-2)\\,j.$"} :step/id #uuid "05e7d7d3-d815-5b26-b630-27644d17a707" :step/next {:db/id #edb/ref 17592186482641}} {:db/id #edb/ref 17592186482636 :step/content {:db/id #edb/ref 17592186403571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3b898a6-e9f5-51f8-8993-b6f0322af5e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(3,2)$ and $(-1,3)$" :db/id #edb/ref 17592186403573} {:answer/id #uuid "3acac861-9675-5531-8e0f-29301bd84beb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,1)$ and $(-1,-1)$" :db/id #edb/ref 17592186403574} {:answer/id #uuid "879099ba-26c3-5eca-b156-1546984f09e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,2)$ and $(-1,-2)$" :db/id #edb/ref 17592186403575} {:answer/id #uuid "56e7a278-62d5-5448-adb4-7672d93764ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-1,2)$ and $(1,-2)$" :db/id #edb/ref 17592186403576} {:answer/id #uuid "c66b876c-2af7-5756-8122-0570c4918dbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(1,3)$ and $(3,-2)$" :db/id #edb/ref 17592186403577}] :answer-field/correct {:db/id #edb/ref 17592186403575} :answer-field/id #uuid "22c59322-d13f-5287-a0fa-c2f86091a95e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403572}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "49dc4b38-854b-53b5-ba44-1bf47c27ef1c" :question/math-academy-id "q-72412" :question/problem "At which points on the curve ${y}^{2}-4xy=-5{x}^{2}+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-4xy & =-5{x}^{2}+1 \\\\ {y}^{2}-4xy+5{x}^{2} & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-4xy+5{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-4xy+5{x}^{2})i-\\frac{∂}{∂x}({y}^{2}-4xy+5{x}^{2})j \\\\  & =2(y-2x)\\,i-(10x-4y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ (2(y-2x)\\,i-(10x-4y)\\,j)\\cdot i & =0 \\\\ 2(y-2x) & =0 \\\\ y & =2x\\end{aligned}\n$$\n\nSubstituting $y=2x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-4xy+5{x}^{2} & =1 \\\\ (2x)^{2}-4x(2x)+5{x}^{2} & =1 \\\\ 4{x}^{2}-8{x}^{2}+5{x}^{2} & =1 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=-2$ and the corresponding point is $(-1,-2).$"} :step/id #uuid "6e92b42c-037c-5e2c-9313-5354ee48f332" :step/next {:db/id #edb/ref 17592186482619}} {:db/id #edb/ref 17592186482641 :step/content {:db/id #edb/ref 17592186339110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c870de58-6cf8-5f55-bffc-f699bc46f20d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439921} {:answer/id #uuid "4e20dcfd-74b5-58d8-ade3-1b14c1ebc0f3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439922}] :answer-field/correct {:db/id #edb/ref 17592186439922} :answer-field/id #uuid "565b9b4c-04a0-5048-a56f-8d5e3070a8f0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440318} {:answer-field/choices [{:answer/id #uuid "7432e782-f930-5a48-b600-2b73137cb5d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439923} {:answer/id #uuid "4ec470d4-03ca-56dd-8409-2a57ffec13e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439924}] :answer-field/correct {:db/id #edb/ref 17592186439923} :answer-field/id #uuid "5445ff51-4242-58f1-82a1-a06ee9872065" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440319} {:answer-field/choices [{:answer/id #uuid "30ab5b7e-3d52-5946-a172-31a0170bd6bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439925} {:answer/id #uuid "1f2acd6c-7f35-567c-a987-dc0e51c9e439" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439926}] :answer-field/correct {:db/id #edb/ref 17592186439925} :answer-field/id #uuid "4f236e9f-2bb6-5678-a8f0-1751832e776f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440320} {:answer-field/choices [{:answer/id #uuid "400433b5-a356-507e-a575-1bc28d48f70d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439927} {:answer/id #uuid "8f505551-c5b9-5992-8523-d0f2ab34f1e6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439928}] :answer-field/correct {:db/id #edb/ref 17592186439927} :answer-field/id #uuid "150d32c1-350a-571d-834f-71f20d3a563a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440321} {:answer-field/choices [{:answer/id #uuid "ed83a8d6-9e07-5905-be1f-34b393c3d6da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439929} {:answer/id #uuid "dcef0c5c-1acb-5551-97b3-3f576bf135b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439930}] :answer-field/correct {:db/id #edb/ref 17592186439929} :answer-field/id #uuid "1e3dbaf6-9358-5c2a-9801-aef6c67ddc06" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440322} {:answer-field/choices [{:answer/id #uuid "065e1081-b5f1-5f33-a472-b91a349b1ad0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439931} {:answer/id #uuid "4bed7d93-95ff-5f0a-9e8a-462b709673d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439932}] :answer-field/correct {:db/id #edb/ref 17592186439932} :answer-field/id #uuid "a537d884-e552-57b7-b8f8-e2de9abb83a0" :answer-field/key "VI" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440323}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9c0801c9-8ff6-5c1f-a200-5a0877707694" :question/math-academy-id "q-72410" :question/problem "At which points on the curve ${y}^{2}+2xy={x}^{2}+8$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-2,-2)$\n- **II.** $(0,2)$\n- **III.** $(1,2)$\n- **IV.** $(2,0)$\n- **V.** $(2,1)$\n- **VI.** $(2,2)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2xy & ={x}^{2}+8 \\\\ {y}^{2}+2xy-{x}^{2} & =8\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2xy-{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=8.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2xy-{x}^{2})i-\\frac{∂}{∂x}({y}^{2}+2xy-{x}^{2})j \\\\  & =2(y+x)\\,i-2(y-x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ (2(y+x)\\,i-2(y-x)\\,j)\\cdot j & =0 \\\\ -2(y-x) & =0 \\\\ y & =x\\end{aligned}\n$$\n\nSubstituting $y=x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2xy-{x}^{2} & =8 \\\\ (x)^{2}+2x(x)-{x}^{2} & =8 \\\\ {x}^{2}+2{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nFinally:\n\n- If $x=2$, we get $y=2$ and the corresponding point is $(2,2).$\n\n- If $x=-2$, we get $y=-2$ and the corresponding point is $(-2,-2).$"} :step/id #uuid "8010488e-cbf0-5349-af76-b70ec53c1a3b" :step/next {:db/id #edb/ref 17592186482636}} {:db/id #edb/ref 17592186482651 :step/content {:db/id #edb/ref 17592186373757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439519} {:answer/id #uuid "8c88915e-5b21-5b50-b76c-b452eb74095d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439520}] :answer-field/correct {:db/id #edb/ref 17592186439519} :answer-field/id #uuid "cb7991eb-11ab-5be8-9cff-8cb4c831a986" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440117} {:answer-field/choices [{:answer/id #uuid "bee1c3fd-7f28-5bd0-8439-264f31d9f15a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439521} {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439522}] :answer-field/correct {:db/id #edb/ref 17592186439522} :answer-field/id #uuid "f05aaa51-707b-51f8-bed1-c062eb9077c6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440118} {:answer-field/choices [{:answer/id #uuid "049822ce-ef15-5b5d-9864-ade62a37ec43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439523} {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439524}] :answer-field/correct {:db/id #edb/ref 17592186439524} :answer-field/id #uuid "24967753-af42-5895-a050-8e8c6b225ad6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440119} {:answer-field/choices [{:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186439525} {:answer/id #uuid "65a64ec9-6cdd-507e-9bfb-590aab6a8b2f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186439526}] :answer-field/correct {:db/id #edb/ref 17592186439525} :answer-field/id #uuid "ed98d8f5-235d-543c-a23d-ff763ed379a9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186440120}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,1)$\n- **II.** $(0,0)$\n- **III.** $(0,\\frac{1}{3})$\n- **IV.** $(1,1)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"} :step/id #uuid "d3f5afa9-3e2d-58c5-8c55-a63599bc185e"}] :activity/title "Tangent Lines to Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481766}]}
