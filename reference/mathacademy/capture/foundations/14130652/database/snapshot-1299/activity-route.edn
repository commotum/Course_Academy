#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186427638} :activity/id #uuid "831bdc32-0d6c-55b8-aa0e-17d1809789f3" :activity/scope {:db/id #edb/ref 17592186049312 :topic/id #uuid "eb826c2f-ae04-5de5-b6a6-7efcf7e974ae" :topic/math-academy-id 2201} :activity/steps [{:db/id #edb/ref 17592186427637 :step/content {:db/id #edb/ref 17592186415475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045918a8-9cd8-5a07-b550-ae46024d9091" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186415446} {:answer/id #uuid "402ee237-56af-5ed0-b68b-15a4eb93a4c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|B|$ and $|C|$ only" :db/id #edb/ref 17592186415451} {:answer/id #uuid "82c9a685-f3be-5652-9e92-444a23e21632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186415458} {:answer/id #uuid "f5705fa2-288d-561a-9ae0-435e05884593" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|,$ $|B|,$ and $|C|$" :db/id #edb/ref 17592186415466} {:answer/id #uuid "fff98d8e-e1e9-59ce-9f45-62d4096f2b19" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|C|$ only" :db/id #edb/ref 17592186415469}] :answer-field/correct {:db/id #edb/ref 17592186415466} :answer-field/id #uuid "3898e8c8-305f-5107-8e55-3fa0057b225c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415470}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "135c5d03-e391-5a5b-8227-7d54c7203318" :question/math-academy-id "q-140048" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}0 & 0 & 0 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ 2 & 1 & 0 & 0 \\\\ 3 & 2 & 1 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 1 \\\\ \\sqrt{2} & 2 & \\sqrt{2} \\\\ -1 & \\sqrt{2} & 1\\end{aligned}|,\\,|C|=|\\begin{aligned}1 & 0 & 5 \\\\ -1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- Since $A$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal:\n\n$$\n|A|=0\\cdot 0\\cdot 0\\cdot 0=0\n$$\n\n- The matrix $B$ has proportional rows: \n\n$$\nB=[\\begin{aligned}1 & \\sqrt{2} & 1 \\\\ \\sqrt{2} & 2 & \\sqrt{2} \\\\ -1 & \\sqrt{2} & 1\\end{aligned}]\n$$\n\n \nAs a result, $|B|=0.$\n\n- The matrix $C$ has a zero column: \n\n$$\nC=[\\begin{aligned}1 & 0 & 5 \\\\ -1 & 0 & 3 \\\\ 2 & 0 & 4\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, $|A|,$ $|B|,$ and $|C|$ are equal to $0.$"} :step/id #uuid "1a88a749-d24f-53f0-b27d-bb6b30fd5b09"} {:db/id #edb/ref 17592186427638 :step/content {:db/id #edb/ref 17592186329653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ffab26-9ad7-506d-a32e-290001bd0683" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186327263} {:answer/id #uuid "8218f764-70b6-55d4-8b25-1cd4c71771d3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186328055} {:answer/id #uuid "ba930e46-114f-5ca4-bd55-ff9ff7367bb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186328559} {:answer/id #uuid "c30c03d6-9daa-5660-bfd1-f61e521c01ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186328638} {:answer/id #uuid "ed725a19-ce5e-5e0d-bc81-259288441adb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186329013}] :answer-field/correct {:db/id #edb/ref 17592186329013} :answer-field/id #uuid "357d9d24-cb3b-5a09-9abd-87033d967adf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329290}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "59d4edee-acd9-59e0-80f8-ec390e2e0ee0" :question/math-academy-id "q-42465" :question/problem "$$\nA=[\\begin{aligned}4 & 8 & 2 & 6 \\\\ 2 & 4 & 1 & 3 \\\\ 3 & \\sqrt{6} & 9 & 3 \\\\ 3 & 2 & 4 & \\sqrt{5}\\end{aligned}]\n$$\n\n \n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\nI. $A$ has proportional rows\n\nII. $A$ has identical columns\n\nIII. $A$ has a zero column" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional rows: \n\n$$\nA=[\\begin{aligned}4 & 8 & 2 & 6 \\\\ 2 & 4 & 1 & 3 \\\\ 3 & \\sqrt{6} & 9 & 3 \\\\ 3 & 2 & 4 & \\sqrt{5}\\end{aligned}]\\,✓\n$$\n\n- $A$ does *not* have identical columns.\n\n- $A$ does *not* have a zero column.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "388fa099-949a-55ed-903a-cb5e3105da1f" :step/next {:db/id #edb/ref 17592186427639}} {:db/id #edb/ref 17592186427639 :step/content {:db/id #edb/ref 17592186134407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba7d7bc9-77ef-583c-8caa-22315aad7aca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$, $|B|$, and $|C|$" :db/id #edb/ref 17592186392523} {:answer/id #uuid "23f02ed7-eb83-5988-a1ca-ee80eac659ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|B|$ only" :db/id #edb/ref 17592186392524} {:answer/id #uuid "d767aec8-a44c-5175-bbcd-b71f577015fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$ and $|C|$ only" :db/id #edb/ref 17592186392525} {:answer/id #uuid "ee7ae539-44fc-5d03-b8b9-5a5b498db62e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$ only" :db/id #edb/ref 17592186392526} {:answer/id #uuid "3737a2a5-a57d-571a-a651-f2cad4ee3049" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$|A|$ and $|B|$ only" :db/id #edb/ref 17592186392527}] :answer-field/correct {:db/id #edb/ref 17592186392525} :answer-field/id #uuid "00ef10bc-f305-5726-8271-949923025e38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392522}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cee2c526-7176-535a-81f7-173bfaefecec" :question/math-academy-id "q-42882" :question/problem "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}2 & -1 & \\sqrt{3} \\\\ \\sqrt[5]{2} & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 0 & 3 & 6 \\\\ 0 & 0 & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 3 & 8 \\\\ 1 & 0 & 4\\end{aligned}|\n$$" :question/worked-solution "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=[\\begin{aligned}2 & -1 & \\sqrt{3} \\\\ \\sqrt[5]{2} & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=1\\cdot 3\\cdot 4=12\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=[\\begin{aligned}1 & \\sqrt{2} & 4 \\\\ 2 & 3 & 8 \\\\ 1 & 0 & 4\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$"} :step/id #uuid "38a574a5-5c5f-57c3-888b-5d032802d120" :step/next {:db/id #edb/ref 17592186427640}} {:db/id #edb/ref 17592186427640 :step/content {:db/id #edb/ref 17592186134414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8e0b89-42bf-519d-9d97-5be58994dc91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186327337} {:answer/id #uuid "43e90ae2-41ae-5a8b-bd0d-a84be897dc3e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186327526} {:answer/id #uuid "cd965883-d1dd-572c-b5e0-9d1d81b810b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186328742} {:answer/id #uuid "e4d7cf84-3b4e-527a-beaf-e866d3ca0aa6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186328938} {:answer/id #uuid "f499f0e7-80e6-54c9-b9ec-b1cb786a0558" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186329076}] :answer-field/correct {:db/id #edb/ref 17592186327337} :answer-field/id #uuid "73a52cef-1ba2-5963-a084-9155ceff6344" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329376}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ef67ff18-5c70-5c00-bdf0-27b79dc90b72" :question/math-academy-id "q-43306" :question/problem "Let $A$ be a $2\\times 2$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\nI. $A$ has two identical rows\n\nII. One of the rows/columns of $A$ is proportional to another row/column of $A$\n\nIII. $A$ has two identical columns" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and III are false. For example, consider the matrix \n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ 2 & 8\\end{aligned}].\n$$\n\nWe have that \n\n$$\n|A|=1\\cdot 8-4\\cdot 2=0\n$$\n\nbut $A$ has neither two identical rows nor two identical columns.\n\n- Statement II is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nIn the case of a $2\\times 2$ matrix, this means that one of the rows/columns must be proportional to another row/column.\n\nTherefore, the correct answer is \"II only\"."} :step/id #uuid "9758fa31-2a83-569c-bfa7-a2c551b1e63f" :step/next {:db/id #edb/ref 17592186427641}} {:db/id #edb/ref 17592186427641 :step/content {:db/id #edb/ref 17592186427636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c03a16b-9dee-5cff-a0ff-6bb3df36fd82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186427630} {:answer/id #uuid "317dd47a-723e-5f7b-bb84-76a98d476a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186427631} {:answer/id #uuid "51f27d1e-2a2e-57fb-a28c-b54b35283c0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186427632} {:answer/id #uuid "a64fab7a-ae4b-5ae6-9ea8-75c59aee1472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186427633} {:answer/id #uuid "c7ae2b06-54e1-5537-a7a1-e4af212bb060" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186427634}] :answer-field/correct {:db/id #edb/ref 17592186427630} :answer-field/id #uuid "25bbbab1-f79f-5a4a-95b4-1d90cbb77585" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186427635}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "df55035e-2530-507b-9e8e-793ed8f0bafc" :question/math-academy-id "q-82284" :question/problem "Find $-4det(A)+3det(B)$, where \n\n$$\nA=[\\begin{aligned}2 & \\sqrt{3} & 0 \\\\ 1 & 3 & 0 \\\\ -1 & 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}\\sqrt{2} & 0 & 1 \\\\ 0 & \\sqrt{2} & -1 \\\\ 0 & 0 & 3\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ has a zero column, we obtain\n\n$$\nA=[\\begin{aligned}2 & \\sqrt{2} & 0 \\\\ 1 & 3 & 0 \\\\ -1 & 1 & 0\\end{aligned}]\\,⟹\\,det(A)=0.\n$$\n\n- Since $B$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\ndet(B)=\\sqrt{2}\\cdot \\sqrt{2}\\cdot 3=6\n$$\n\nTherefore, $-4det(A)+3det(B)=-4\\cdot 0+3\\cdot 6=18.$"} :step/id #uuid "f880731a-4b09-56ca-8e32-d2d537e03030" :step/next {:db/id #edb/ref 17592186427637}}] :activity/title "Conditions When a Determinant Equals Zero" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186427629}]}
