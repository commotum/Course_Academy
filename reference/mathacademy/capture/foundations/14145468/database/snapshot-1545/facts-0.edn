db/ref 17592186117290 #edb/ref 17592186045417] [17592186117289 #edb/ref 1075 #edb/ref 17592186117291 #edb/ref 17592186045417] [17592186117289 #edb/ref 1075 #edb/ref 17592186117292 #edb/ref 17592186045417] [17592186117289 #edb/ref 1075 #edb/ref 17592186117293 #edb/ref 17592186045417] [17592186117289 #edb/ref 1075 #edb/ref 17592186117294 #edb/ref 17592186045417] [17592186117289 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186117289 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186117289 #edb/ref 1079 #uuid "8a12d13e-2577-5a86-b53a-e88da174b659" #edb/ref 17592186045417] [17592186117290 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186117290 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117290 #edb/ref 1083 #uuid "8b0012c2-9e36-5ddc-b432-6223b1ea13ce" #edb/ref 17592186045417] [17592186117291 #edb/ref 1080 "None" #edb/ref 17592186045417] [17592186117291 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117291 #edb/ref 1083 #uuid "d1f8da87-77c9-5d32-8a09-1e3610169e2a" #edb/ref 17592186045417] [17592186117292 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186117292 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117292 #edb/ref 1083 #uuid "eb1b30fa-5a4e-5767-96e1-e58753e03a71" #edb/ref 17592186045417] [17592186117293 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186117293 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117293 #edb/ref 1083 #uuid "038ab4ad-a6fd-517d-9fa5-2542608f8143" #edb/ref 17592186045417] [17592186117294 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186117294 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186117294 #edb/ref 1083 #uuid "727efee5-a824-527e-82ff-d09ae7bd1bcb" #edb/ref 17592186045417] [17592186119603 #edb/ref 1069 "e-4765" #edb/ref 17592186045417] [17592186119603 #edb/ref 1071 "Given ![](images/98/98496fe489edc905b587f42825bd0ef76dffa68bece7e204abae6de259501835.png) find its LU decomposition." #edb/ref 17592186045417] [17592186119603 #edb/ref 1072 #uuid "0e45ac96-0eee-51a3-83e0-192582dcf57d" #edb/ref 17592186045417] [17592186119603 #edb/ref 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}7 & 9 \\\\ -7 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}7 & 9 \\\\ 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}7 & 9 \\\\ 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119604 #edb/ref 1069 "e-4767" #edb/ref 17592186045417] [17592186119604 #edb/ref 1071 "Given \n![](images/4a/4a8b4b988e2f4c93881f577ce12f2aa59a4dbcc00bf4122e23873255c27c2d72.png), find its LU decomposition." #edb/ref 17592186045417] [17592186119604 #edb/ref 1072 #uuid "e1d1f80c-70d1-566d-9cc0-94899b0fa05d" #edb/ref 17592186045417] [17592186119604 #edb/ref 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 3 \\\\ 12 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since $E_1A=U,$ we can invert $E_1$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119668 #edb/ref 1069 "e-6184" #edb/ref 17592186045417] [17592186119668 #edb/ref 1071 "Which of the following products is the LU factorization of a matrix $A?$\n\n- ![](images/f0/f07498a45503a02fa9fb4d3ecfd9bdae54a363b632152016f2f4e5c3f6170656.png)\n\n- ![](images/30/300278e3edb64ab9dcb945668b923f385b9873be5bd33264a7ed10f6072262b7.png)\n\n- ![](images/e2/e26513d3753cd1437a42a9f57f160fb25e2fb9b84e1df1db07579429749eea2c.png)" #edb/ref 17592186045417] [17592186119668 #edb/ref 1072 #uuid "ea39d5ec-9c8f-572d-8708-fdd97d0c04bc" #edb/ref 17592186045417] [17592186119668 #edb/ref 1074 "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n![](images/98/98d64291b8e0d4effe6bb1f3006c3d88d2687697355a83c1b092cdfb54ba4188.png)\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n![](images/10/10a251d4445a3b190e92fa179badfb5e989b577f3c88812334e921522e7a20e5.png)\n\n- The second product is *not* in $LU$ form. Although the left matrix is a lower triangular matrix, it is not a *unit* lower triangular matrix because it does not have $1$'s on the diagonal.\n![](images/51/515f139b62a15ee4b38066e6225066b527e277e904ea97473d2a9f50f0f595cb.png)\n\n- The third product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal.\n![](images/e3/e377b0ff63ac6d7b3938187e47a3b5bca0087ddb6eee1d2c086835f394cdf6b9.png)\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045417] [17592186119792 #edb/ref 1037 #edb/ref 17592186048373 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186120182 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186120187 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186243948 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186243949 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186243950 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186302217 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186302247 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186302266 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186375694 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186402035 #edb/ref 17592186045417] [17592186119792 #edb/ref 1038 #edb/ref 17592186402054 #edb/ref 17592186045417] [17592186119792 #edb/ref 1039 "Finding the LU Factorization of a 2x2 Matrix" #edb/ref 17592186045417] [17592186119792 #edb/ref 1041 #edb/ref 17592186119603 #edb/ref 17592186045417] [17592186119792 #edb/ref 1042 #uuid "9279d979-74ba-5504-b98a-63692db3af72" #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 #edb/ref 17592186120186 #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 #edb/ref 17592186120519 #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 #edb/ref 17592186243951 #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 #edb/ref 17592186243952 #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 #edb/ref 17592186243953 #edb/ref 17592186045417] [17592186119793 #edb/ref 1038 