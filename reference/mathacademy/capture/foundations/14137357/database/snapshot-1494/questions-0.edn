#{[{:db/id #edb/ref 17592186319318 :knowledge-point/_questions [{:db/id #edb/ref 17592186124510 :knowledge-point/id #uuid "f3a0e3b9-931a-52bd-9ed9-b8001c8de67b" :knowledge-point/title "Finding the Nullity of a Matrix Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38fc6530-da0e-5ef8-9489-487b09a244dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186317749} {:answer/id #uuid "56588881-20d6-50d9-9ff9-b07f78c8d62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317854} {:answer/id #uuid "74eb3b2a-e28b-5f5f-8bad-16800439d2bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317966} {:answer/id #uuid "c40e8a26-c0ea-5391-8ea7-86af9f58fbcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186318213} {:answer/id #uuid "d79b5d41-92e6-55a5-93af-01f4431ff8c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186318281}] :answer-field/correct {:answer/id #uuid "74eb3b2a-e28b-5f5f-8bad-16800439d2bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317966} :answer-field/id #uuid "f7f6e57d-01d6-53e7-aeb3-fe75d269ce0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "831c003e-6ab4-5abb-a995-8aece30d7ab6" :question/math-academy-id "q-34906" :question/problem "Given $A=[\\begin{aligned}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 8 & 0 & 3 & 5 \\\\ 0 & 2 & 1 & 0\\end{aligned}],\\,$ what is $\\text{dim}(\\text{Null}(A))?$" :question/worked-solution "To find $\\text{dim}(\\text{Null}(A))$, we reduce $A$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 8 & 0 & 3 & 5 \\\\ 0 & 2 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & -4 & 1 & 1 \\\\ 0 & 2 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 2 & 1 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼[\\begin{aligned}4 & 2 & 1 & 2 \\\\ 0 & 4 & 2 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). \n\nTherefore,\n\n$$\n\\text{dim}(\\text{Null}(A))=1.\n$$"}] [{:db/id #edb/ref 17592186321072 :knowledge-point/_questions [{:db/id #edb/ref 17592186124509 :knowledge-point/id #uuid "f020b27f-1cd4-550b-a83a-2afbb7e5db72" :knowledge-point/title "Identifying the Dimension of the Null Space of Matrices Using Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3481e207-e3b3-5e18-a809-b68d786d6e91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319553} {:answer/id #uuid "49662fce-308a-5973-9daf-90f661164bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319609} {:answer/id #uuid "85f18eb3-e6ce-502e-be45-f3e00050dbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319794} {:answer/id #uuid "b176021e-5d4f-5d30-bf8d-ae821e8d1a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319934} {:answer/id #uuid "ca6939af-8bae-5b13-92b7-db8af3689ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186320010}] :answer-field/correct {:answer/id #uuid "49662fce-308a-5973-9daf-90f661164bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319609} :answer-field/id #uuid "8c4879d1-521b-5d88-bd53-72f2ed650b99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da3efbc4-2fa4-54a8-9aa9-e1c2c723490a" :question/math-academy-id "q-35316" :question/problem "Consider the matrices given below. Find $\\,\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C)).$\n\n$$\nA=[\\begin{aligned}2 & 0 & -3 \\\\ 0 & 7 & 5 \\\\ 0 & 0 & 2\\end{aligned}],\\,B=[\\begin{aligned}-4 & 1 \\\\ 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}4 & 0 & 0 & 1 \\\\ 0 & -5 & 1 & 2 \\\\ 0 & 0 & 4 & -3\\end{aligned}]\n$$" :question/worked-solution "The dimension of the null space of a matrix is the number of non-pivot columns in the matrix. \n\nAlso, all of the given matrices are in row echelon form.\n\nWith that in mind, let's consider each of the statements.\n\n- The matrix $A$ has $3$ pivot columns and no non-pivot column. So, \n\n$$\n\\text{dim(Null}(A))=0.\n$$\n\n- The matrix $B$ has $1$ pivot column and $1$ non-pivot column (namely, the $2$nd column). So, \n\n$$\n\\text{dim(Null}(B))=1.\n$$\n\n- The matrix $C$ has $3$ pivot columns and $1$ non-pivot column (namely, the $4$th column). So, \n\n$$\n\\text{dim(Null}(C))=1.\n$$\n\nTherefore,\n\n$$\n\\text{dim(Null}(A))+\\text{dim(Null}(B))+\\text{dim(Null}(C))=0+1+1=2.\n$$"}] [{:db/id #edb/ref 17592186124876 :knowledge-point/_questions [{:db/id #edb/ref 17592186124510 :knowledge-point/id #uuid "f3a0e3b9-931a-52bd-9ed9-b8001c8de67b" :knowledge-point/title "Finding the Nullity of a Matrix Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28e68488-3044-5580-9e3c-089a9a1d218e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186319521} {:answer/id #uuid "35be0dfc-5948-5bd3-9dac-1c20570872cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319559} {:answer/id #uuid "5502e90e-05b0-5dfe-b4f5-71b52399a4d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319638} {:answer/id #uuid "961f532b-51e7-5809-ad29-5c12359cfab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319833} {:answer/id #uuid "ec49169a-3f2a-5743-b17d-b75c92825009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186320098}] :answer-field/correct {:answer/id #uuid "961f532b-51e7-5809-ad29-5c12359cfab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319833} :answer-field/id #uuid "2a5d0bf9-0555-588a-8937-9468b4e30755" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a0b3d6d-593b-5e4e-ba8b-3eae5b6b11d4" :question/math-academy-id "q-35345" :question/problem "If $D=[\\begin{aligned}1 & -2 & 0 \\\\ 5 & -7 & 9 \\\\ -3 & 6 & -1\\end{aligned}],\\,$ then $\\text{nullity}(D)=$" :question/worked-solution "Recall that by definition, $\\text{nullity}(D)=\\text{dim}(\\text{Null}(D)).$\n\nTo find $\\text{dim}(\\text{Null}(D))$, we reduce $D$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}1 & -2 & 0 \\\\ 5 & -7 & 9 \\\\ -3 & 6 & -1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 0 \\\\ 0 & 3 & 9 \\\\ -3 & 6 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 0 \\\\ 0 & 3 & 9 \\\\ 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns and no non-pivot columns. \n\nTherefore,\n\n$$\n\\text{nullity}(D)=\\text{dim}(\\text{Null}(D))=0.\n$$"}]}
