}^{3}+4{\\lambda }^{2}-\\lambda -6)+(-24\\lambda +72)-(-24\\lambda +72) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-\\lambda -6 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+\\lambda +6 & =0\\end{aligned}\n$$"}]}
