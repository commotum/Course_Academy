#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186442276} :activity/id #uuid "3b7302f6-4f44-5e74-82d2-2ea10325bde3" :activity/scope {:db/id #edb/ref 17592186050376 :topic/id #uuid "44312a5e-e7e0-507f-86f6-c3bcdecfd7fe" :topic/math-academy-id 1964} :activity/steps [{:db/id #edb/ref 17592186442273 :step/content {:db/id #edb/ref 17592186272116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343afa09-d3de-5a19-916a-586f7a7d1e10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda -30=0" :db/id #edb/ref 17592186269747} {:answer/id #uuid "486477e7-c24f-5198-8b45-bd30ea74890e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}+13\\lambda -15=0" :db/id #edb/ref 17592186269929} {:answer/id #uuid "6228aba2-8afa-597c-95c4-f06c42a62e0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}+13{\\lambda }^{2}+2\\lambda +4=0" :db/id #edb/ref 17592186270132} {:answer/id #uuid "d6af2f78-c6df-57d2-ac96-1c55af121e04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10=0" :db/id #edb/ref 17592186271152} {:answer/id #uuid "f703200a-d0b5-505b-8a01-4c910b8e7ab9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-2{\\lambda }^{2}-13\\lambda +25=0" :db/id #edb/ref 17592186271436}] :answer-field/correct {:db/id #edb/ref 17592186271152} :answer-field/id #uuid "d819e362-fc4f-51eb-a589-2bd16ee43e88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271891}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "29164807-d381-53a4-8efb-e16c83f907bf" :question/math-academy-id "q-140515" :question/problem "Find the characteristic equation of the matrix \n$C=[\\begin{aligned}3 & -1 & -1 \\\\ 1 & -3 & 3 \\\\ 1 & 2 & -2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,C-\\lambda I:$\n﻿﻿﻿\n\n$$\nC-\\lambda I=[\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(C-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(C-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}-3-\\lambda  & 3 \\\\ 2 & -2-\\lambda \\end{aligned}|-(-1)|\\begin{aligned}1 & 3 \\\\ 1 & -2-\\lambda \\end{aligned}|+(-1)|\\begin{aligned}1 & -3-\\lambda  \\\\ 1 & 2\\end{aligned}| & =0 \\\\ (3-\\lambda )({\\lambda }^{2}+5\\lambda )+(-\\lambda -5)-(5+\\lambda ) & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+15\\lambda )-\\lambda -5-5-\\lambda  & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+13\\lambda -10 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10 & =0\\end{aligned}\n$$"} :step/id #uuid "3399fe8e-8176-5e35-93d5-9a34329ea9c3"} {:db/id #edb/ref 17592186442274 :step/content {:db/id #edb/ref 17592186442271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0069a32c-24a8-592d-aebc-701756d8bdcd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186442259} {:answer/id #uuid "8e52e58b-8a75-5be5-b33c-025f9395fdc7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186442264} {:answer/id #uuid "95f7c606-fabc-51e1-8528-9632cdd50f62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186442265} {:answer/id #uuid "c80a4f86-8e3e-57b3-9a46-45e60e433bf6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186442267} {:answer/id #uuid "f29dc51e-2c92-5c6d-8ac3-24dd5e961743" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186442268}] :answer-field/correct {:db/id #edb/ref 17592186442265} :answer-field/id #uuid "24804dcb-504d-588f-82a7-fb6fe2bd5e63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186442269}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "970b7afa-4ca1-5d4a-a4eb-b7279227d558" :question/math-academy-id "q-37356" :question/problem "$$\nB=[\\begin{aligned}-5 & 1 & 0 & -1 \\\\ 0 & 3 & 0 & -2 \\\\ 0 & 7 & -3 & 4 \\\\ 0 & 5 & 0 & -1\\end{aligned}].\n$$\n\nConsider the matrix $B$ given above. Which of the following statements are true?\n\nI. $\\lambda =-5$ is an eigenvalue of $B$\n\nII. $\\lambda =-1$ is an eigenvalue of $B$\n\nIII. The eigenvalue $\\lambda =-3$ has algebraic multiplicity $2$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-5-\\lambda  & 1 & 0 & -1 \\\\ 0 & 3-\\lambda  & 0 & -2 \\\\ 0 & 7 & -3-\\lambda  & 4 \\\\ 0 & 5 & 0 & -1-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $1$st column, as follows:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-5-\\lambda  & 1 & 0 & -1 \\\\ 0 & 3-\\lambda  & 0 & -2 \\\\ 0 & 7 & -3-\\lambda  & 4 \\\\ 0 & 5 & 0 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )|\\begin{aligned}3-\\lambda  & 0 & -2 \\\\ 7 & -3-\\lambda  & 4 \\\\ 5 & 0 & -1-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd column, we obtain the following:\n\n$$\n\\begin{aligned}(-5-\\lambda )\\cdot (-3-\\lambda )|\\begin{aligned}3-\\lambda  & -2 \\\\ 5 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-5-\\lambda )\\cdot (-3-\\lambda )((3-\\lambda )(-1-\\lambda )+10) & =0 \\\\ (\\lambda +5)(\\lambda +3)({\\lambda }^{2}-2\\lambda +7) & =0\\end{aligned}\n$$\n\nSince $D<0$ for the polynomial ${\\lambda }^{2}-2\\lambda +7$, we have that the only real eigenvalues are $\\lambda =-5$ and $\\lambda =-3$ (both with algebraic multiplicity $1$).\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "34fc937b-c4ca-51d0-b41f-cc48a4e031b8" :step/next {:db/id #edb/ref 17592186442277}} {:db/id #edb/ref 17592186442275 :step/content {:db/id #edb/ref 17592186442272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0700ae-412d-51b3-a257-618c99674341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lambda \\in \\{-2,1,5\\}" :db/id #edb/ref 17592186442260} {:answer/id #uuid "481860b5-bb3d-58cb-94dc-529c4d401e99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lambda \\in \\{-5,1,3\\}" :db/id #edb/ref 17592186442261} {:answer/id #uuid "558359c6-2d82-546e-a690-6c2a868d98cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lambda \\in \\{1,2,5\\}" :db/id #edb/ref 17592186442262} {:answer/id #uuid "6819477a-eb82-5fe8-9144-a2c3b8ccd8c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lambda \\in \\{-5,-1,2\\}" :db/id #edb/ref 17592186442263} {:answer/id #uuid "974ccec8-a09e-54db-b466-a20773981b7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lambda \\in \\{-5,1,2\\}" :db/id #edb/ref 17592186442266}] :answer-field/correct {:db/id #edb/ref 17592186442266} :answer-field/id #uuid "d8e6f41c-9e5c-55de-9517-8eaa2b14ab20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186442270}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bedee111-5fec-56ad-a271-6904f3e057b2" :question/math-academy-id "q-140475" :question/problem "Determine all real eigenvalues $\\lambda $ of the matrix \n$A=[\\begin{aligned}3 & -1 & -1 \\\\ 1 & -3 & 3 \\\\ 1 & 2 & -2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is given by $det(A-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & -1 & -1 \\\\ 1 & -3-\\lambda  & 3 \\\\ 1 & 2 & -2-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}-3-\\lambda  & 3 \\\\ 2 & -2-\\lambda \\end{aligned}|-(-1)|\\begin{aligned}1 & 3 \\\\ 1 & -2-\\lambda \\end{aligned}|+(-1)|\\begin{aligned}1 & -3-\\lambda  \\\\ 1 & 2\\end{aligned}| & =0 \\\\ (-{\\lambda }^{3}-2{\\lambda }^{2}+15\\lambda )+(-5-\\lambda )+(5+\\lambda ) & =0 \\\\ -{\\lambda }^{3}-2{\\lambda }^{2}+13\\lambda -10 & =0 \\\\ {\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10 & =0\\end{aligned}\n$$\n\nNow, we need to solve this equation. We find the first root by testing some values. According to the rational zeros theorem, a list of good first guesses consists of all divisors of $10:$ \n\n$$\n\\pm 1,\\pm 2,\\pm 5,\\pm 10\n$$\n\nLet's pick $x=1.$ Substituting to the characteristic equation gives\n\n$$\n\\begin{aligned}(1)^{3}+2(1)^{2}-13(1)+10 & =0.\\end{aligned}\n$$\n\nHence, $\\lambda =1$ is a root of the equation. So, we can factor $(\\lambda -1)$ out of ${\\lambda }^{3}+2{\\lambda }^{2}-13\\lambda +10$ using synthetic division:\n\n| $1$ | $1$ | $2$ | $-13$ | $10$ |\n| --- | --- | --- | --- | --- |\n|  | $↓$ | $1$ | $3$ | $-10$ |\n|  | $1$ | $3$ | $-10$ | $0$ |\n\nSo, we obtain the following factorization:\n\n$$\n\\begin{aligned}(\\lambda -1)({\\lambda }^{2}+3\\lambda -10) & =0 \\\\ (\\lambda -1)(\\lambda +5)(\\lambda -2) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are ${\\lambda }_{1}=-5,$ $\\,{\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=2.$"} :step/id #uuid "41fe8de5-4b38-5378-88a7-29da8122c672" :step/next {:db/id #edb/ref 17592186442273}} {:db/id #edb/ref 17592186442276 :step/content {:db/id #edb/ref 17592186125062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b84ff5-4873-5847-ad69-723f5136d9aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186321215} {:answer/id #uuid "3ddd2395-53d8-54c0-bd86-c597005e66e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186321632} {:answer/id #uuid "99197694-172f-58f3-819b-f3608767e4ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186322363} {:answer/id #uuid "d34c4ee0-a109-57af-bb18-6dbdec953f13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186322798} {:answer/id #uuid "dca8a51f-11ad-5fb9-a502-863404f1d921" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186322872}] :answer-field/correct {:db/id #edb/ref 17592186322872} :answer-field/id #uuid "d1deec07-22ce-59a9-8917-9f15fef7cfa4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323582}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c699a77c-6393-5572-b010-6743d9f3bb17" :question/math-academy-id "q-37355" :question/problem "$$\nP=[\\begin{aligned}-1 & -9 & -18 & -3 \\\\ 0 & -10 & 0 & 0 \\\\ 0 & 0 & -10 & 0 \\\\ -18 & 18 & -36 & -4\\end{aligned}].\n$$\n\nConsider the matrix $P$ given above. Which of the following statements are true?\n\nI. $\\lambda =-1$ is an eigenvalue of $P$\n\nII. $\\lambda =-10$ is an eigenvalue of $P$\n\nIII. The eigenvalue $\\lambda =-10$ has algebraic multiplicity $3$" :question/worked-solution "First, we find the matrix $\\,P-\\lambda I:$\n﻿﻿﻿\n\n$$\nP-\\lambda I=[\\begin{aligned}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(P-\\lambda I)=0.$ \n\nNotice that we can expand the $4\\times 4$ determinant across the $2$nd row, as follows:\n\n$$\n\\begin{aligned}det(P-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & -9 & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 & 0 \\\\ 0 & 0 & -10-\\lambda  & 0 \\\\ -18 & 18 & -36 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )|\\begin{aligned}-1-\\lambda  & -18 & -3 \\\\ 0 & -10-\\lambda  & 0 \\\\ -18 & -36 & -4-\\lambda \\end{aligned}| & =0\\end{aligned}\n$$\n\nNow, expanding the $3\\times 3$ determinant across the $2$nd row, we obtain the following:\n\n$$\n\\begin{aligned}(-10-\\lambda )\\cdot (-10-\\lambda )|\\begin{aligned}-1-\\lambda  & -3 \\\\ -18 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-10-\\lambda )^{2}((-1-\\lambda )(-4-\\lambda )-54) & =0 \\\\ (\\lambda +10)^{2}({\\lambda }^{2}+5\\lambda -50) & =0 \\\\ (\\lambda +10)^{2}(\\lambda +10)(\\lambda -5) & =0 \\\\ (\\lambda +10)^{3}(\\lambda -5) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues of $P$ are $\\lambda =-10$ (with algebraic multiplicity $3$) and $\\lambda =5.$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "4407ab4d-760d-5929-a4aa-ceca8bb19594" :step/next {:db/id #edb/ref 17592186442274}} {:db/id #edb/ref 17592186442277 :step/content {:db/id #edb/ref 17592186323910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c92bdd9-561f-50f8-a0af-b026acb7e7d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+\\lambda -52=0" :db/id #edb/ref 17592186321751} {:answer/id #uuid "679f1b6a-bb22-58ad-9008-20f76acaf14c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-10{\\lambda }^{2}+43\\lambda -90=0" :db/id #edb/ref 17592186321955} {:answer/id #uuid "688684d9-f540-59a5-826c-2faac539f6c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}+7{\\lambda }^{2}-5\\lambda -48=0" :db/id #edb/ref 17592186321961} {:answer/id #uuid "a6e445b9-3e7b-5df5-8de9-a07b0a91fd34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+\\lambda +6=0" :db/id #edb/ref 17592186322453} {:answer/id #uuid "c8f0d0d9-d2ec-529d-bfe9-31a08f8548aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }^{3}-4{\\lambda }^{2}+49\\lambda -138=0" :db/id #edb/ref 17592186322711}] :answer-field/correct {:db/id #edb/ref 17592186322453} :answer-field/id #uuid "b4874765-573f-531a-bb89-b09ddf9d2051" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323521}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4b421cae-1cc2-5e38-a509-6349aee206e1" :question/math-academy-id "q-37394" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}-1 & -8 & -4 \\\\ 3 & 8 & 3 \\\\ -6 & -10 & -3\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-1-\\lambda  & -8 & -4 \\\\ 3 & 8-\\lambda  & 3 \\\\ -6 & -10 & -3-\\lambda \\end{aligned}]\n$$\n\nThe characteristic equation is $det(B-\\lambda I)=0.$ \n\nExpanding the determinant across the $1$st row, we get the following:\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-1-\\lambda  & -8 & -4 \\\\ 3 & 8-\\lambda  & 3 \\\\ -6 & -10 & -3-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )|\\begin{aligned}8-\\lambda  & 3 \\\\ -10 & -3-\\lambda \\end{aligned}|-(-8)|\\begin{aligned}3 & 3 \\\\ -6 & -3-\\lambda \\end{aligned}|+(-4)|\\begin{aligned}3 & 8-\\lambda  \\\\ -6 & -10\\end{aligned}| & =0 \\\\ (-1-\\lambda )({\\lambda }^{2}-5\\lambda +6)+8(-3\\lambda +9)-4(-6\\lambda +18) & =0 \\\\ (-{\\lambda }^{3}+4{\\lambda }^{2}-\\lambda -6)+(-24\\lambda +72)-(-24\\lambda +72) & =0 \\\\ -{\\lambda }^{3}+4{\\lambda }^{2}-\\lambda -6 & =0 \\\\ {\\lambda }^{3}-4{\\lambda }^{2}+\\lambda +6 & =0\\end{aligned}\n$$"} :step/id #uuid "e50043bb-5fa2-5c1d-b766-cd5b3092a18e" :step/next {:db/id #edb/ref 17592186442275}}] :activity/title "The Characteristic Equation of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186442258}]}
