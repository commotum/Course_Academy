#{[{:db/id #edb/ref 17592186157614 :knowledge-point/_questions [{:db/id #edb/ref 17592186157247 :knowledge-point/id #uuid "d96918f5-2a27-5413-8fcd-a6c8060a9342" :knowledge-point/title "Cases When a Square’s Side Is Mapped to a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93ce2972-f7c3-5702-ad71-0bbd5e1aa479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 1)$ and $(-1, 1)$" :db/id #edb/ref 17592186153929} {:answer/id #uuid "a2ab1ff4-8df6-5741-8556-a27ccff00c02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-1)$ and $(1, 0)$" :db/id #edb/ref 17592186153930} {:answer/id #uuid "b6a82fca-8ece-5a0e-b77a-76e3884e414f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 1)$ and $(1, 0)$" :db/id #edb/ref 17592186153931} {:answer/id #uuid "24fe6988-471a-5c85-aaea-ee57400f84a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 0)$ and $(1, 1)$" :db/id #edb/ref 17592186153932} {:answer/id #uuid "3201358f-c8d5-5360-8461-b8d1d28d3902" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1, 0)$ and $(1,-1)$" :db/id #edb/ref 17592186153933}] :answer-field/id #uuid "220de041-8a77-59e5-81bf-784ea13caa4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153928}] :question/id #uuid "13842938-0c5a-56c1-b7e1-75af1a627153" :question/math-academy-id "q-160610" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ and its **directed** boundary $∂Δ$ in the $uv$-plane, where $Δ$ is given by\n$Δ = {(u, v): 0 \\le u \\le 1, 0 \\le v \\le 1}$,\n\nand the transformation $T$, given by\n$T: (u, v) → (x(u, v), y(u, v))$,\nwhere\n$x = v, y = u - v^{2}$.\n\nThe image of the side $S_{3}$ under the action of $T$ is a **directed** line segment. Find the endpoints of this segment, stated in the order that they are traversed."}] [{:db/id #edb/ref 17592186157615 :knowledge-point/_questions [{:db/id #edb/ref 17592186157248 :knowledge-point/id #uuid "148c9c1d-236d-571f-89be-d1c03f7c39aa" :knowledge-point/title "Cases When a Square’s Side Is Mapped to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a119cae-6540-5df2-a55c-08d3d60d6a26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(1, 0)$ to $(2,-1)$." :db/id #edb/ref 17592186153935} {:answer/id #uuid "c92aae8f-e388-5856-8663-e4117eb87bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(2,-1)$ to $(1, 0)$." :db/id #edb/ref 17592186153936} {:answer/id #uuid "ee83b760-e545-5561-9015-9cc84cbc7253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(1, 0)$ to $(2,-1)$." :db/id #edb/ref 17592186153937} {:answer/id #uuid "0aeeb286-f7cf-5527-bba5-7a7dae0f59d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(1, 1)$ to $(2, 1)$." :db/id #edb/ref 17592186153938} {:answer/id #uuid "5b47e93f-3bb5-55aa-84e1-48ed28547e52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(2,-1)$ to $(1, 0)$." :db/id #edb/ref 17592186153939}] :answer-field/id #uuid "caa444a1-db64-55ea-bf7d-f219bb8f8199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153934} {:answer-field/choices [{:answer/id #uuid "6cc68d80-39d1-5f0f-933c-89bd1b4b4d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(1,0)$ to $(2,-1).$" :db/id #edb/ref 17592186373897} {:answer/id #uuid "b20916f4-2125-5e54-be30-7b22ca6d6f51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(1,1)$ to $(2,1).$" :db/id #edb/ref 17592186373898} {:answer/id #uuid "f69006ab-7ec1-5771-bd33-a19fe8da912c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(2,-1)$ to $(1,0).$" :db/id #edb/ref 17592186373899} {:answer/id #uuid "4d3fa41a-6316-5747-87cf-e13860d909ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(2,-1)$ to $(1,0).$" :db/id #edb/ref 17592186373900} {:answer/id #uuid "732254b6-7d89-598e-b5b3-79f480fa4f76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(1,0)$ to $(2,-1).$" :db/id #edb/ref 17592186373901}] :answer-field/correct {:answer/id #uuid "6cc68d80-39d1-5f0f-933c-89bd1b4b4d27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(1,0)$ to $(2,-1).$" :db/id #edb/ref 17592186373897} :answer-field/id #uuid "419acef2-b0e8-560d-bfb9-5d30aad77e63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373896}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ebd6f32-1c51-561f-a98e-5d832c9928ee" :question/math-academy-id "q-160611" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx={u}^{2}+{v}^{2},\\,y=-v.\n$$\n\nWhich of the following is the image of the side ${S}_{2}$ under the action of $T?$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{2}.$\n\nFor the side ${S}_{2},$ we have $u=1$ and $0\\le v\\le 1.$ Substituting $u=1$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =({u}^{2}+{v}^{2},\\,-v) \\\\  & =({1}^{2}+{v}^{2},\\,-v) \\\\  & =({v}^{2}+1,\\,-v).\\end{aligned}\n$$\n\nSo, the image of ${S}_{2}$ can be parametrized by\n\n$$\nx={v}^{2}+1,\\,y=-v,\\,0\\le v\\le 1.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx={t}^{2}+1,\\,y=-t,\\,0\\le t\\le 1.\n$$\n\nThese are parametric equations of a parabolic arc. Notice that if we eliminate $t$ from the equations, we get\n\n$$\nx=(-y)^{2}+1\\,⇒\\,{y}^{2}=x-1\n$$\n\nwhich is a right-opening parabola whose vertex is at $(1,0).$\n\nMoreover, the endpoints of ${S}_{2}$ are mapped to the $xy$-plane as follows:\n\n$$\n\\begin{aligned} & T:(1,0)\\to ({1}^{2}+{0}^{2},-0)=(1,0) \\\\  & T:(1,1)\\to ({1}^{2}+{1}^{2},-1)=(2,-1)\\end{aligned}\n$$\n\nTherefore, the image of ${S}_{2}$ is an arc of a right-opening parabola, traversed from $(1,0)$ to $(2,-1).$\n\n![](images/ad/ade48b3f14ed83460a5d818f744103edd75f8394a3f3396a0ff30364bda36c9b.png)"}] [{:db/id #edb/ref 17592186373902 :knowledge-point/_questions [{:db/id #edb/ref 17592186157249 :knowledge-point/id #uuid "efb1958d-6ee8-592e-b503-7b15e6e7b056" :knowledge-point/title "Finding the Image of a Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bd9f9d6-0406-5b60-bf3c-c7fb79ebaf40" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/72e271d6a2282fdf7cdf852308f569de848b8bdc71935e1487969f9ea7ac3eb0.png" :db/id #edb/ref 17592186373904} {:answer/id #uuid "b9c07d75-8dc0-5472-b4ee-118ce7ee6da5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e3/e3cfcf4c6cd7bcc8298a7e3d8c76f4add3f61689cecc1dacb9fa8a48db5a042b.png" :db/id #edb/ref 17592186373905} {:answer/id #uuid "4157d539-f77d-5f54-8554-c73457ce6de7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/648fa48df1bd648d9fbf48efc966698228416ad9bf3a0f69045031e955601d61.png" :db/id #edb/ref 17592186373906} {:answer/id #uuid "c5415f6b-51be-511e-8dcf-7bc985ea09e4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3b/3ba341827d95d261f8def4462a11282051b3605795459343441f9f35284faf33.png" :db/id #edb/ref 17592186373907} {:answer/id #uuid "fd8fcb79-14f8-54fd-8a6b-4be84dab14e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0f/0fd03370c63540a8dc9336305bbf917239f02afce2f73371715d6489eee31c9b.png" :db/id #edb/ref 17592186373908}] :answer-field/correct {:answer/id #uuid "4157d539-f77d-5f54-8554-c73457ce6de7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/648fa48df1bd648d9fbf48efc966698228416ad9bf3a0f69045031e955601d61.png" :db/id #edb/ref 17592186373906} :answer-field/id #uuid "515b035c-875d-5a93-a2bf-bdd77d9642fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4de9b2d-c42a-5fe3-94b3-1b2caac795c3" :question/math-academy-id "q-160636" :question/problem "![](images/5f/5f91cc8b30f9b764021cd84c374a328c7ffb1287a9f0dc6a211a3fadfac2fdbd.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1}\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=u{v}^{2},\\,y={u}^{2}.\n$$\n\nFind the image of $Δ$ under the action of $T.$ \n\n*Hint: You may assume that $T$ has no critical points in the interior of $Δ.$*" :question/worked-solution "We're told that $T$ has no critical points in the interior of $Δ.$ So, to map the entire region $Δ$ onto the $xy$-plane, we transform each side of $Δ$ separately:\n\n- Consider the image of the side ${S}_{1},$ where we have $v=0$ and $0\\le u\\le 1.$ Substituting $v=0$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) &  \\\\  & =(u{v}^{2},\\,{u}^{2}) &  \\\\  & =(u({0}^{2}),\\,{u}^{2}) &  \\\\  & =(0,\\,{u}^{2}), & 0\\le u\\le 1.\\end{aligned}\n$$\n\nThis is a vertical line segment traversed from the point $(0,0)$ to the point $(0,1)$ in the $xy$-plane.\n\n- Consider the image of the side ${S}_{2}.$ Here, we have $u=1$ and $0\\le v\\le 1.$ Substituting $u=1$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) &  \\\\  & =(u{v}^{2},\\,{u}^{2}) &  \\\\  & =(1{v}^{2},\\,{1}^{2}) &  \\\\  & =({v}^{2},\\,1), & 0\\le v\\le 1.\\end{aligned}\n$$\n\nThis is a horizontal line segment traversed from the point $(0,1)$ to the point $(1,1)$ in the $xy$-plane.\n\n- Consider the image of the side ${S}_{3}.$ Here, we have $v=1$ and $1\\ge u\\ge 0.$ Substituting $v=1$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) &  \\\\  & =(u{v}^{2},\\,{u}^{2}) &  \\\\  & =(u({1}^{2}),\\,{u}^{2}) &  \\\\  & =(u,\\,{u}^{2}), & 1\\ge u\\ge 0.\\end{aligned}\n$$\n\nThis is an upward-opening parabola traversed from the point $(1,1)$ to the point $(0,0)$ in the $xy$-plane.\n\n- Consider the image of the side ${S}_{4}.$ Here, we have $u=0$ and $1\\ge v\\ge 0.$ Substituting $u=0$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) &  \\\\  & =(u{v}^{2},\\,{u}^{2}) &  \\\\  & =(0{v}^{2},\\,{0}^{2}) &  \\\\  & =(0,\\,0), & 1\\ge v\\ge 0.\\end{aligned}\n$$\n\n \nThis is the point $(0,0)$ in the $xy$-plane.\n\nDrawing the images of the sides of our square, we obtain the following image of $Δ:$\n\n![](images/64/648fa48df1bd648d9fbf48efc966698228416ad9bf3a0f69045031e955601d61.png)"}] [{:db/id #edb/ref 17592186290419 :knowledge-point/_questions [{:db/id #edb/ref 17592186157247 :knowledge-point/id #uuid "d96918f5-2a27-5413-8fcd-a6c8060a9342" :knowledge-point/title "Cases When a Square’s Side Is Mapped to a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06977182-5497-5c11-a57f-add4aeca5aa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(2,0)$" :db/id #edb/ref 17592186288084} {:answer/id #uuid "2ece2530-2ca7-5ec1-a8cf-c55ac6d46052" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ and $(2,-1)$" :db/id #edb/ref 17592186288347} {:answer/id #uuid "8539bd62-399f-5793-bd3f-e4de85fa29cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0)$ and $(0,-1)$" :db/id #edb/ref 17592186288928} {:answer/id #uuid "b1d93a8c-2868-5548-992e-86797465c0a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(0,0)$" :db/id #edb/ref 17592186289208} {:answer/id #uuid "bdbf2fce-7275-51db-ae2f-706d92628bd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,-1)$ and $(0,0)$" :db/id #edb/ref 17592186289281}] :answer-field/correct {:answer/id #uuid "2ece2530-2ca7-5ec1-a8cf-c55ac6d46052" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ and $(2,-1)$" :db/id #edb/ref 17592186288347} :answer-field/id #uuid "5cf66fd9-3498-5637-8fc1-454524321dda" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13002a7e-2ad6-501a-b8db-7a8abc685d5d" :question/math-academy-id "q-225122" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ and its **directed** boundary $∂Δ$ in the $uv$-plane, where $Δ$ is given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=\\frac{1}{3}(v+6u),\\,y=\\frac{{v}^{3}-2u}{v+2}.\n$$\n\nThe image of the side ${S}_{1}$ under the action of $T$ is a **directed** line segment. Find the endpoints of this segment, stated in the order that they are traversed." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{1}.$\n\nFor the side ${S}_{1},$ we have $v=0$ and $0\\le u\\le 1.$ Substituting $v=0$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(\\frac{1}{3}(v+6u),\\,\\frac{{v}^{3}-2u}{v+2}) \\\\  & =(\\frac{1}{3}(0+6u),\\,\\frac{{0}^{3}-2u}{0+2}) \\\\  & =(2u,-u).\\end{aligned}\n$$\n\nSo, the image of ${S}_{1}$ can be parametrized by\n\n$$\nx=2u,\\,y=-u,\\,0\\le u\\le 1.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx(t)=2t,\\,y(t)=-t,\\,0\\le t\\le 1.\n$$\n\nThis is a line segment with endpoints $(0,0)$ and $(2,-1)$ in the $xy$-plane.\n\n![](images/f0/f068883d1318acdafba39c74bc1279f6cafe803437a9b79249999df461bac8ee.png)"}]}
