#{[{:db/id #edb/ref 17592186256703 :knowledge-point/_questions [{:db/id #edb/ref 17592186179725 :knowledge-point/id #uuid "7a43f82e-6682-56af-994a-b0bdf12b4095" :knowledge-point/title "Sketching the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f1e18b0-1117-563b-8441-3490065e61e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/d3/d3fc823cfcea400219e553f9e6911a312f0a14c7f39aafb49d1af3463cb3e46b.png" :db/id #edb/ref 17592186253945} {:answer/id #uuid "46e3f6a4-7353-56bc-8961-cc92fd971024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/0e/0ea540eb4a48d1fb1777e2d6397e6d38937e9795c4d810b48c0fda0801d1c9ba.png" :db/id #edb/ref 17592186254275} {:answer/id #uuid "64b24222-51a7-5272-9ca7-2db93a07e9b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/ba/ba42a974a78df2c0d228e8f5ae543019841c8a7b47e38f02e139fe2d97b8ecf5.png" :db/id #edb/ref 17592186254578} {:answer/id #uuid "8ad5cb04-3d21-55c7-a532-d1bd2ca52b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/f4/f4f0b2e96fa7ee0f1dca7d57a2815e93d77665c0285fa81f2a8b2c5965a39415.png" :db/id #edb/ref 17592186254901} {:answer/id #uuid "bde88cfd-9cb5-56e6-ba40-080493eb0ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/36/369ebf19405768bcca19f4981f0237647836250548b0a33f9b4fdba92d85ddc9.png" :db/id #edb/ref 17592186255371}] :answer-field/correct {:answer/id #uuid "bde88cfd-9cb5-56e6-ba40-080493eb0ad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/36/369ebf19405768bcca19f4981f0237647836250548b0a33f9b4fdba92d85ddc9.png" :db/id #edb/ref 17592186255371} :answer-field/id #uuid "0e297b46-c5d5-5311-943f-eb3962e376bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f30aab0-000a-5430-bdac-144d62e4296d" :question/math-academy-id "q-122693" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{2}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{2}+{y}^{2}}{2}) \\\\  & =x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{{x}^{2}+{y}^{2}}{2}) \\\\  & =y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =x\\,i+y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-1,1),$ $(2,2),$ and $(2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-1,1) & =-\\,i+j \\\\ ∇f(2,2) & =2\\,i+2\\,j \\\\ ∇f(2,-1) & =2\\,i+(-1)j=2\\,i-j\\end{aligned}\n$$\n\n \n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/36/369ebf19405768bcca19f4981f0237647836250548b0a33f9b4fdba92d85ddc9.png)"}] [{:db/id #edb/ref 17592186387276 :knowledge-point/_questions [{:db/id #edb/ref 17592186179725 :knowledge-point/id #uuid "7a43f82e-6682-56af-994a-b0bdf12b4095" :knowledge-point/title "Sketching the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bec373fa-27cc-5734-871a-ec77749ea6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/0c/0c425b6fcb88f4c958a7c0371a64a815eda5ebf8ed14b0adc06875de1e24003b.png" :db/id #edb/ref 17592186387278} {:answer/id #uuid "6120694d-f5d6-5a30-a9b1-04836470b4fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/af/af7fdf48d36f477174867761b90d9349344029980012f1f7907f544efd3893bc.png" :db/id #edb/ref 17592186387279} {:answer/id #uuid "5738a2a6-58f2-5cb8-befa-f76d6d0fb2c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/48/48c57f24904442c74178682db34aaa0113eb84042c78516a4e6f961e73b0f9eb.png" :db/id #edb/ref 17592186387280} {:answer/id #uuid "11eee978-2cbc-57da-8a9a-9ffddf6422c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/02/020c3ec7cd0e5e57bb4c6de8516988187c9038d9e5598b116966b71fa8b917d8.png" :db/id #edb/ref 17592186387281} {:answer/id #uuid "04551b05-601c-557a-a5a2-69cba4463197" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/25/25ed4b4750662433bf4405b5e63ab78396688a985c76e2d34d449c0689830380.png" :db/id #edb/ref 17592186387282}] :answer-field/correct {:answer/id #uuid "11eee978-2cbc-57da-8a9a-9ffddf6422c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/02/020c3ec7cd0e5e57bb4c6de8516988187c9038d9e5598b116966b71fa8b917d8.png" :db/id #edb/ref 17592186387281} :answer-field/id #uuid "c39f6b60-6db1-56ec-93e1-e634b438a208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14b7ceda-a408-53c9-aeb5-05da06c84fba" :question/math-academy-id "q-122732" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=x{y}^{2}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(x{y}^{2}) \\\\  & ={y}^{2} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(x{y}^{2}) \\\\  & =2xy\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & ={y}^{2}\\,i+2xy\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(2,1),$ and $(-2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,1) & ={1}^{2}\\,i+2\\cdot (-2)\\cdot 1\\,j=i-4j \\\\ ∇f(2,1) & ={1}^{2}\\,i+2\\cdot 2\\cdot 1\\,j=i+4\\,j \\\\ ∇f(-2,-1) & =(-1)^{2}\\,i+2\\cdot (-2)\\cdot (-1)\\,j=i+4\\,j\\end{aligned}\n$$\n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](images/02/020c3ec7cd0e5e57bb4c6de8516988187c9038d9e5598b116966b71fa8b917d8.png)"}] [{:db/id #edb/ref 17592186256726 :knowledge-point/_questions [{:db/id #edb/ref 17592186179718 :knowledge-point/id #uuid "364d2c9a-6e9a-57f8-aa57-c10ee223061b" :knowledge-point/title "Using the Relationship Between the Vector Field of a Function and Its Contour Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00678095-4785-5a48-bfd2-04906406b23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/8b/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png" :db/id #edb/ref 17592186253677} {:answer/id #uuid "03aaca50-6ba1-5767-8a1d-61289921be5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/4c/4c1a0035b37bc0137dc2ac164c980d538f9362feb3b439e663885f8aa7178124.png" :db/id #edb/ref 17592186253705} {:answer/id #uuid "5936829d-c5a5-5317-93a8-8d046c07d07f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/fa/fa8bf282264f1647644cc15b6aece745718bd17617afad2c2530292bfed10b15.png" :db/id #edb/ref 17592186254458} {:answer/id #uuid "70f6299c-8313-5e6f-a9c7-80abdfba5fd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/70/704a1e0712c0c2512e16ac03f1eeb7ecd55996c822eced54ac510f4719485c42.png" :db/id #edb/ref 17592186254677} {:answer/id #uuid "9bf9db65-02b1-5896-a31b-6345273456e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/f9/f9d6304bc9cc6b6e74235c66a7d70b96dbea2db44e9ed82606f6025075b76336.png" :db/id #edb/ref 17592186255049}] :answer-field/correct {:answer/id #uuid "00678095-4785-5a48-bfd2-04906406b23d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/8b/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png" :db/id #edb/ref 17592186253677} :answer-field/id #uuid "a46a2d28-3dee-5856-b9b2-7ac4fb2b706b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256227}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f67d0b79-608f-51fc-afe3-9623997cda39" :question/math-academy-id "q-122810" :question/problem "Which of the following could be the gradient vector field of the function $f(x,y)={x}^{2}-y?$" :question/worked-solution "We start by plotting some level curves of the function:\n\n- Setting $f(x,y)=-1,$ we get ${x}^{2}-y=-1,$ which gives the parabola $y={x}^{2}+1$\n\n- Setting $f(x,y)=0,$ we get ${x}^{2}-y=0,$ that is, the parabola $y={x}^{2}$\n\n- Setting $f(x,y)=2,$ we get ${x}^{2}-y=2,$ that is, the parabola $y={x}^{2}-2$\n\n- $⋯$\n\nContinuing in this way, we get the following contour plot:\n\n![](images/77/77a54ef31c41e0246e3d337a69c7faa161194058e6a5c672ef24d86866a83faf.png)\n\nNote that $f(x,y)$ increases as we move downward and away from the origin $O.$ \n\nNow, we recall the following facts:\n\n- The gradient field vectors of a function $f(x,y)$ always lie perpendicular to its level curves.\n\n- Moreover, the vectors point in the direction where $f(x,y)$ increases.\n\nWith this in mind, we can add the vector field to the contour plot, giving the following picture.\n\n![](images/4e/4e124d5e77ef9a28002aba9aac40f0b7eff1232dd1c08b6bca10b166469675c7.png)\n\nSo, the corresponding gradient field is as follows:\n\n \n\n![](images/8b/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png)"}] [{:db/id #edb/ref 17592186387310 :knowledge-point/_questions [{:db/id #edb/ref 17592186179718 :knowledge-point/id #uuid "364d2c9a-6e9a-57f8-aa57-c10ee223061b" :knowledge-point/title "Using the Relationship Between the Vector Field of a Function and Its Contour Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2280c113-775e-55c4-a01a-374b591fe98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/b8/b8b4cae5128667b4a75097540bddc8dbb853744aee65e96204cf630ccb30fc68.png" :db/id #edb/ref 17592186387312} {:answer/id #uuid "62456e8c-d83a-57a0-89bf-f27036a5952d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/e6/e6598c50e72417a0bff5514fa2b8ff9fba7c617cff10dc83e15472259d040846.png" :db/id #edb/ref 17592186387313} {:answer/id #uuid "5d7deb3d-fec1-58c8-a1ac-06e1e23abd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/41/417f9bd99ad7032ffac7ce258c5122d932b1bb1610237ef030f077ca56815bec.png" :db/id #edb/ref 17592186387314} {:answer/id #uuid "4f9c1117-85a8-52e1-8899-dd286a49cfd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/8e/8e30bba74fad98713f891950fd052d2ddd2cb2dc349bd9bcb7efe3333b7203dd.png" :db/id #edb/ref 17592186387315} {:answer/id #uuid "244086f1-424e-529c-87bd-716006661658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/dc/dcd7de7b52c59ceda71245ef18d7cb1327a0e3f3b93f6f8e0bb8c5e386958217.png" :db/id #edb/ref 17592186387316}] :answer-field/correct {:answer/id #uuid "2280c113-775e-55c4-a01a-374b591fe98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/image} :answer/value "images/b8/b8b4cae5128667b4a75097540bddc8dbb853744aee65e96204cf630ccb30fc68.png" :db/id #edb/ref 17592186387312} :answer-field/id #uuid "da7d6acf-0c52-544c-acec-75dbce89c666" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387311}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84a12606-a26d-58d9-96bf-2e993f7dda01" :question/math-academy-id "q-122813" :question/problem "![](images/50/50bd80ab9aa2f8d5ac2a453ccfe63815a75379efa7502cf1090eb015264206f6.png)\n\nThe gradient vector field of the function $f(x,y)$ is shown above. Which of the following could be a contour plot of $f(x,y)?$" :question/worked-solution "The gradient field vectors of a function $f(x,y)$ always lie perpendicular to its level curves.\n\nObserve that the given field vectors are perpendicular to the level curves in the following picture.\n\n![](images/b7/b73b05cb7f58bcce1d684c7f19c391ecd2033eb4c47c59daf896546956a9d42f.png)\n\nTherefore, the correct answer is the following:\n\n![](images/b8/b8b4cae5128667b4a75097540bddc8dbb853744aee65e96204cf630ccb30fc68.png)"}]}
