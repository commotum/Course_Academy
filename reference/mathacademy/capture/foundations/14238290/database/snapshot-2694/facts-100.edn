qrt{3} & -\\frac{1}{\\sqrt{3}} \\\\ 0 & \\frac{4}{\\sqrt{6}}\\end{bmatrix}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186432334 #edb/ref 1068 #edb/ref 17592186432325 #edb/ref 17592186045417] [17592186432334 #edb/ref 1069 "q-140901" #edb/ref 17592186045417] [17592186432334 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186432334 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ \\frac{{v}_{1}}{‖{v}_{1}‖} & \\frac{{v}_{2}}{‖{v}_{2}‖} & \\frac{{v}_{3}}{‖{v}_{3}‖} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above, where $\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set of vectors. You're given that $‖{v}_{1}‖=1,$ $‖{v}_{2}‖=2,$ $‖{v}_{3}‖=3,$ and that the system of equations below describes the relationship between the columns of $Q$ and the columns of $A.$ \n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-{v}_{1} \\\\ {v}_{3} &={a}_{3}-2{v}_{2}+{v}_{1}\\end{aligned}\\right.\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{33}?$" #edb/ref 17592186045443] [17592186432334 #edb/ref 1072 #uuid "e5f7e59e-edf4-549f-aea0-27ed8989142e" #edb/ref 17592186045417] [17592186432334 #edb/ref 1074 "First, we normalize the vectors ${v}_{1},{v}_{2},{v}_{3}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{{v}_{1}}{1}\\,⟹\\,{v}_{1}={q}_{1} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{{v}_{2}}{2}\\,⟹\\,{v}_{2}=2{q}_{2} \\\\ {q}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{{v}_{3}}{3}\\,⟹\\,{v}_{3}=3{q}_{3}.\\end{aligned}\n$$\n\nNow, the set $\\{{q}_{1},{q}_{2},{q}_{3}\\}$ will be both orthogonal and normalized.\n\nNext, let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\left\\{\\begin{aligned}{v}_{1} &={a}_{1} \\\\ {v}_{2} &={a}_{2}-{v}_{1} \\\\ {v}_{3} &={a}_{3}-2{v}_{2}+{v}_{1}\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}{a}_{1} &={v}_{1}={q}_{1} \\\\ {a}_{2} &={v}_{1}+{v}_{2}={q}_{1}+2{q}_{2} \\\\ {a}_{3} &=-{v}_{1}+2{v}_{2}+{v}_{3}=-{q}_{1}+4{q}_{2}+3{q}_{3}\\end{aligned}\\right.\n$$\n\nThe final system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}1 & 1 & -1 \\\\ 0 & 2 & 4 \\\\ 0 & 0 & 3\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{33}=1+(-1)+3=3.\n$$" #edb/ref 17592186045443] [17592186442803 #edb/ref 1043 #edb/ref 17592186442811 #edb/ref 17592186045417] [17592186442803 #edb/ref 1043 #edb/ref 17592186442812 #edb/ref 17592186045417] [17592186442803 #edb/ref 1043 #edb/ref 17592186442813 #edb/ref 17592186045417] [17592186442803 #edb/ref 1043 #edb/ref 17592186442814 #edb/ref 17592186045417] [17592186442803 #edb/ref 1043 #edb/ref 17592186442815 #edb/ref 17592186045417] [17592186442803 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186442803 #edb/ref 1045 "QR Factorization" #edb/ref 17592186045417] [17592186442803 #edb/ref 1046 #edb/ref 17592186442814 #edb/ref 17592186045417] [17592186442803 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186442803 #edb/ref 1049 #edb/ref 17592186050130 #edb/ref 17592186045417] [17592186442803 #edb/ref 1053 #uuid "4001c9a4-1021-5a1b-9693-811b63a41207" #edb/ref 17592186045417] [17592186442804 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186442804 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186442804 #edb/ref 1083 #uuid "3529dcc2-d908-58eb-8e99-7d1d828d18b3" #edb/ref 17592186