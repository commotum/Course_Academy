qrt{2}} \\\\ \\frac{1}{\\sqrt{3}} & 0\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}2\\sqrt{3} & \\sqrt{3} \\\\ 0 & 2\\sqrt{2}\\end{aligned}]}}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{22}=(\\frac{1}{\\sqrt{2}})\\cdot (2\\sqrt{2})=2.$" #edb/ref 17592186045417] [17592186510504 #edb/ref 1058 #edb/ref 17592186510563 #edb/ref 17592186045417] [17592186510504 #edb/ref 1062 #uuid "558490e4-84ba-51db-b8e6-e71608372b63" #edb/ref 17592186045417] [17592186510504 #edb/ref 1063 #edb/ref 17592186364599 #edb/ref 17592186045417] [17592186510522 #edb/ref 1062 #uuid "8870d163-7037-5417-a28f-0af8d578e0cb" #edb/ref 17592186045417] [17592186510522 #edb/ref 1063 #edb/ref 17592186363231 #edb/ref 17592186045417] [17592186510538 #edb/ref 1058 #edb/ref 17592186510522 #edb/ref 17592186045417] [17592186510538 #edb/ref 1062 #uuid "ba9899ad-e46c-5454-a574-beabe6f5c8c7" #edb/ref 17592186045417] [17592186510538 #edb/ref 1063 #edb/ref 17592186510452 #edb/ref 17592186045417] [17592186510545 #edb/ref 1058 #edb/ref 17592186510504 #edb/ref 17592186045417] [17592186510545 #edb/ref 1062 #uuid "cd1623be-2e54-562c-8cfd-19ef37f01b2e" #edb/ref 17592186045417] [17592186510545 #edb/ref 1063 #edb/ref 17592186134546 #edb/ref 17592186045417] [17592186510563 #edb/ref 1058 #edb/ref 17592186510538 #edb/ref 17592186045417] [17592186510563 #edb/ref 1062 #uuid "f89604cd-9e6c-5431-9cc6-02eee87bc460" #edb/ref 17592186045417] [17592186510563 #edb/ref 1063 #edb/ref 17592186510371 #edb/ref 17592186045417]}
