#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186479903} :activity/id #uuid "a377c8fc-71a6-5b1e-b3f7-2c9b112bec57" :activity/scope {:db/id #edb/ref 17592186048289 :topic/id #uuid "917bf85e-7253-5a9c-8395-ebac6e9e50d7" :topic/math-academy-id 880} :activity/steps [{:db/id #edb/ref 17592186479903 :step/content {:db/id #edb/ref 17592186348068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35f38504-8305-5326-bb00-99730398c72f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{3x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186345815} {:answer/id #uuid "8c2c2f19-a310-51bc-b9f3-c3da0cbade4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186346566} {:answer/id #uuid "bd394e25-e934-5d93-8427-bbaa8ee6cec9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)" :db/id #edb/ref 17592186346996} {:answer/id #uuid "ed6ca764-e4b1-5a07-aa16-c3060f5ba655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186347447} {:answer/id #uuid "ffbe2dda-35f7-576a-b2ef-f74883f82610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186347599}] :answer-field/correct {:db/id #edb/ref 17592186346566} :answer-field/id #uuid "5105fd34-ef14-5354-acd9-1f700b41c1b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347746}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2d0d326e-4d26-506b-9602-c369ca812aa6" :question/math-academy-id "q-7819" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-6\\frac{\\text{d}y}{\\text{d}x}+13y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-6\\lambda {e}^{\\lambda x}+13{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-6\\lambda +13) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-6\\lambda +13=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-6\\lambda +13 & =0 \\\\ ({\\lambda }^{2}-6\\lambda +9)-9+13 & =0 \\\\ (\\lambda -3)^{2}+4 & =0 \\\\ (\\lambda -3)^{2} & =-4 \\\\ \\lambda -3 & =\\pm 2\\text{i} \\\\ \\lambda  & =3\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{3x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x).\\end{aligned}\n$$"} :step/id #uuid "06948950-1b74-5ba9-8396-c217d7f75455" :step/next {:db/id #edb/ref 17592186479907}} {:db/id #edb/ref 17592186479904 :step/content {:db/id #edb/ref 17592186479840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5b5fcd-a29c-562a-bf8b-1f75f85c8212" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{cos}⁡5x}{10}" :db/id #edb/ref 17592186479423} {:answer/id #uuid "45e6c364-109b-5f21-b91f-470d8f1c14dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{sin}⁡10x}{7}" :db/id #edb/ref 17592186479461} {:answer/id #uuid "4d1fee01-a9cc-5f62-9f84-82cfd509796a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{cos}⁡10x}{5}" :db/id #edb/ref 17592186479474} {:answer/id #uuid "6e4da9eb-58ac-5ffd-8391-5239e3f08137" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{cos}⁡10x" :db/id #edb/ref 17592186479525} {:answer/id #uuid "ae0e539b-1e11-52de-8ca7-413cfb665f15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡10x-4\\operatorname{sin}⁡10x" :db/id #edb/ref 17592186479619}] :answer-field/correct {:db/id #edb/ref 17592186479423} :answer-field/id #uuid "916dd54d-8397-5580-93c9-13216913749d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479791}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "217cbddd-95c6-5476-9ab1-c973151ef34b" :question/math-academy-id "q-64695" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+100y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+100{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+100) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+100=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+100 & =0 \\\\ {\\lambda }^{2} & =-100 \\\\ \\lambda  & =\\pm 10\\text{i}.\\end{aligned}\n$$\n\nSo, $\\lambda =\\pm 10\\text{i}$ are the (purely imaginary) roots of the auxiliary equation. \n\nTherefore, any linear combination of the functions $\\text{Re}({e}^{10\\text{i}x})=\\operatorname{cos}⁡10x$ and $\\text{Im}({e}^{10\\text{i}x})=\\operatorname{sin}⁡10x$ is a solution to the original differential equation. \n\nAmong the given options, only $\\frac{\\operatorname{cos}⁡5x}{10}$ is not a solution."} :step/id #uuid "56c91c62-cd7d-583e-8106-f750dde05e74" :step/next {:db/id #edb/ref 17592186479905}} {:db/id #edb/ref 17592186479905 :step/content {:db/id #edb/ref 17592186357482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5391bd40-9dfe-5f5a-9861-a1093409b31b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355408} {:answer/id #uuid "70773ae9-a152-5cc4-ac15-a00c4a6fe1f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186355657} {:answer/id #uuid "8638cc2f-34bc-5d19-b9c9-a973bfd6b17b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186355850} {:answer/id #uuid "aa8fa2b5-ccc3-5c13-a0d7-eb18dcd4119d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{-4x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186356173} {:answer/id #uuid "d9f23479-4054-5fbe-9d96-28a1f746af09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y={e}^{x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x)" :db/id #edb/ref 17592186356577}] :answer-field/correct {:db/id #edb/ref 17592186355408} :answer-field/id #uuid "6282c7db-351d-5818-ac25-77dc1e99dda4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357084}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a885511-1dcf-5606-836f-b33f26907c6e" :question/math-academy-id "q-90802" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-4\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-4\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-4\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-4\\lambda +8=0.\n$$\n\nThe auxiliary equation can be solved by completing the square:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-4\\lambda +8 & =0 \\\\ ({\\lambda }^{2}-4\\lambda +4)-4+8 & =0 \\\\ (\\lambda -2)^{2}+4 & =0 \\\\ (\\lambda -2)^{2} & =-4 \\\\ \\lambda -2 & =\\pm 2\\text{i} \\\\ \\lambda  & =2\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation is\n\n$$\n\\begin{aligned}y & ={e}^{2x}(P\\operatorname{cos}⁡2x+Q\\operatorname{sin}⁡2x).\\end{aligned}\n$$"} :step/id #uuid "94fe629c-0044-5dc0-9a0f-8a48b281c0d9" :step/next {:db/id #edb/ref 17592186479906}} {:db/id #edb/ref 17592186479906 :step/content {:db/id #edb/ref 17592186265886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4696d5-cc1e-5203-b64d-8bf1bd1f0021" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186264079} {:answer/id #uuid "a4016bef-beb0-5db0-82a4-44e41b9e2b9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186264395} {:answer/id #uuid "c1a592ed-3d1c-533a-acce-12ce3e8a08bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡2x" :db/id #edb/ref 17592186264682} {:answer/id #uuid "d7acfab0-f973-57d7-848f-7c92141ba2a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡x-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186264880} {:answer/id #uuid "fe0aed58-ec3b-559f-a069-761233a8e9d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186265236}] :answer-field/correct {:db/id #edb/ref 17592186264682} :answer-field/id #uuid "324549a9-80bb-5ccf-ab12-74bb3177f177" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265335}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91a61312-3bc9-5174-b905-87935cc4c9cf" :question/math-academy-id "q-130335" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+y=0,$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+1) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+1=0.\n$$\n\n \n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2} & =-1 \\\\ \\lambda  & =\\pm \\text{i}.\\end{aligned}\n$$\n\nSo, $\\lambda =\\pm \\text{i}$ are the purely imaginary roots of the auxiliary equation. \n\nTherefore, any linear combination of the functions $\\text{Re}({e}^{\\text{i}x})=\\operatorname{cos}⁡x$ and $\\text{Im}({e}^{\\text{i}x})=\\operatorname{sin}⁡x$ is a solution to the original differential equation. \n\nAmong the given options, only $\\operatorname{sin}⁡2x$ is not a solution."} :step/id #uuid "d40ce1a8-b6a7-582c-8f49-39f5f17648ff"} {:db/id #edb/ref 17592186479907 :step/content {:db/id #edb/ref 17592186479843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10569fcb-7e9f-575e-9509-740ee2036a5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 2\\text{i}" :db/id #edb/ref 17592186479383} {:answer/id #uuid "273613c1-7c87-51dc-8032-d46e680c50a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\pm \\text{i}" :db/id #edb/ref 17592186479416} {:answer/id #uuid "3d4cc1a3-5fc9-57b5-8c0b-aee4588c2693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\pm 2\\text{i}" :db/id #edb/ref 17592186479451} {:answer/id #uuid "5d807d68-7dd1-5e64-a6c9-60f86d530db1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm \\text{i}" :db/id #edb/ref 17592186479493} {:answer/id #uuid "9f6f7437-a625-52be-82dd-a8fe85b8d19f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pm \\text{i}" :db/id #edb/ref 17592186479602}] :answer-field/correct {:db/id #edb/ref 17592186479493} :answer-field/id #uuid "cdc5453e-43b0-5db5-af2d-6f25e95cf391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186479806}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e82d486-592d-55be-b437-74783b93d164" :question/math-academy-id "q-64691" :question/problem "Consider the equation ${y}^{″}+y=0,$ where $y=y(t).$ If $y={e}^{\\lambda t}$ is a solution, then $\\lambda =$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+1) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+1=0.\n$$\n\nSolving the auxiliary equation, we get\n\n$$\n\\begin{aligned}{\\lambda }^{2}+1 & =0 \\\\ {\\lambda }^{2} & =-1 \\\\ \\lambda  & =\\pm \\text{i}.\\end{aligned}\n$$\n\nTherefore,  $\\lambda =\\pm \\text{i}$ are the (purely imaginary) roots of the auxiliary equation."} :step/id #uuid "ff6cb89c-b94f-558e-a5a4-97618d860b31" :step/next {:db/id #edb/ref 17592186479904}}] :activity/title "Second-Order Homogeneous ODEs: Characteristic Equations With Complex Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186479354}]}
