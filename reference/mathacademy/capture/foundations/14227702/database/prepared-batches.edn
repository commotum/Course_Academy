fficulty/easy] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/id #uuid "8429c5f3-10e5-5e89-82ae-2a624d986bbe"] ["answer-8a477f06-b877-5fa0-bce3-9f5744ae6971" :answer/id #uuid "8a477f06-b877-5fa0-bce3-9f5744ae6971"] ["answer-8a477f06-b877-5fa0-bce3-9f5744ae6971" :answer/type :answer.type/math] ["answer-8a477f06-b877-5fa0-bce3-9f5744ae6971" :answer/value "|\\begin{aligned}5 & \\,-28 \\\\ 2 & \\,11\\end{aligned}|"] ["answer-41433e06-ff80-564d-9ce3-d0dc9852a8ee" :answer/id #uuid "41433e06-ff80-564d-9ce3-d0dc9852a8ee"] ["answer-41433e06-ff80-564d-9ce3-d0dc9852a8ee" :answer/type :answer.type/math] ["answer-41433e06-ff80-564d-9ce3-d0dc9852a8ee" :answer/value "|\\begin{aligned}8 & 3 \\\\ 3 & 2\\end{aligned}|"] ["answer-249e501c-2f96-5d3a-aca1-a06ed673e1ac" :answer/id #uuid "249e501c-2f96-5d3a-aca1-a06ed673e1ac"] ["answer-249e501c-2f96-5d3a-aca1-a06ed673e1ac" :answer/type :answer.type/math] ["answer-249e501c-2f96-5d3a-aca1-a06ed673e1ac" :answer/value "|\\begin{aligned}\\,-28 & 5 \\\\ \\,\\,11 & 2\\end{aligned}|"] ["answer-752e27ae-6bc8-5acc-bb2a-b47134fc80d9" :answer/id #uuid "752e27ae-6bc8-5acc-bb2a-b47134fc80d9"] ["answer-752e27ae-6bc8-5acc-bb2a-b47134fc80d9" :answer/type :answer.type/math] ["answer-752e27ae-6bc8-5acc-bb2a-b47134fc80d9" :answer/value "|\\begin{aligned}\\,-28 & 8 \\\\ \\,\\,11 & 3\\end{aligned}|"] ["answer-2592d63c-e1be-5dbf-bf09-9ff0d9f2f561" :answer/id #uuid "2592d63c-e1be-5dbf-bf09-9ff0d9f2f561"] ["answer-2592d63c-e1be-5dbf-bf09-9ff0d9f2f561" :answer/type :answer.type/math] ["answer-2592d63c-e1be-5dbf-bf09-9ff0d9f2f561" :answer/value "|\\begin{aligned}\\,11 & 8 \\\\ \\,-28 & 3\\end{aligned}|"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/key "selection"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/type :answer-field.type/radio] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/correct "answer-752e27ae-6bc8-5acc-bb2a-b47134fc80d9"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/choices "answer-8a477f06-b877-5fa0-bce3-9f5744ae6971"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/choices "answer-41433e06-ff80-564d-9ce3-d0dc9852a8ee"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/choices "answer-249e501c-2f96-5d3a-aca1-a06ed673e1ac"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/choices "answer-752e27ae-6bc8-5acc-bb2a-b47134fc80d9"] ["answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe" :answer-field/choices "answer-2592d63c-e1be-5dbf-bf09-9ff0d9f2f561"] ["question-fc096f25-da43-5ef0-8dca-9310fea097c1" :question/answer-fields "answer-field-8429c5f3-10e5-5e89-82ae-2a624d986bbe"] [17592186119844 :knowledge-point/questions "question-fc096f25-da43-5ef0-8dca-9310fea097c1"] ["question-2595de8f-014d-5db6-a5d3-e22363b7564e" :question/id #uuid "2595de8f-014d-5db6-a5d3-e22363b7564e"] ["question-2595de8f-014d-5db6-a5d3-e22363b7564e" :question/math-academy-id "q-152903"] ["question-2595de8f-014d-5db6-a5d3-e22363b7564e" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{E}[9X+4].$\n\n$$\nf(x)=\\frac{x}{2},\\,0<x<2\n$$"] ["question-2595de8f-014d-5db6-a5d3-e22363b7564e" :question/worked-solution "First, we simplify using the properties of expected value:\n\n$$\n\\text{E}[9X+4]=9\\text{E}[X]+4\n$$\n\nFor a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the expected value using the following formula:\n\n$$\n\\text{E}[X]={\\int }_{S}x\\cdot f(x)\\,\\text{d}x.\n$$\n\nSo, we calculate the expected value of $X$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{S}x\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\cdot \\frac{x}{2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{{x}^{2}}{2}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{6}|}_{0}^{2} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{E}[9X+4] & =9\\text{E}[X]+4 \\\\  & =9\\cdot \\frac{4}{3}+4 \\\\  & =16.\\end{aligned}\n$$"] ["question-2595de8f-014d-5db6-a5d3-e22363b7564e" :question/difficulty :question.difficulty/moderate] ["answer-field-d5917ecc-743e-5b98-928c-b4e265150550" :answer-field/id #uuid "d5917ecc-743e-5b98-928c-b4e265150550"] ["answer-00390579-73db-58de-8e3f-f3ca75d10676" :answer/id #uuid "00390579-73db-58de-8e3f-f3ca75d10676"] ["answer-00390579-73db-58de-8e3f-f3ca75d10676" :answer/type :answer.type/math] ["answer-00390579-73db-58de-8e3f-f3ca75d10676" :answer/value "12"] ["answer-a24492a0-f30c-5760-a699-262c2d5c1e9b" :answer/id #uuid "a24492a0-f30c-5760-a699-262c2d5c1e9b"] ["answer-a24492a0-f30c-5760-a699-262c2d5c1e9b" :answer/type :answer.type/math] ["answer-a24492a0-f30c-5760-a699-262c2d5c1e9b" :answer/value "16"] ["answer-76eeaeb4-2ab6-520a-b6b0-9a2f15095f14" :answer/id #uuid "76eeaeb4-2ab6-520a-b6b0-9a2f15095f14"] ["answer-76eeaeb4-2ab6-520a-b6b0-9a2f15095f14" :answer/type :answer.type/math] ["answer-76eeaeb4-2ab6-520a-b6b0-9a2f15095f14" :answer/value "8"] ["answer-6ca1573d-75dd-57d1-975d-20b4eabf81d0" :answer/id #uuid "6ca1573d-75dd-57d1-975d-20b4eabf81d0"] ["answer-6ca1573d-75dd-57d1-975d-20b4eabf81d0" :answer/type :answer.type/math] ["answer-6ca1573d-75dd-57d1-975d-20b4eabf81d0" :answer/value "\\frac{15}{4}"] ["answer-b388bc7a-f341-596b-93dd-60183e4ec2b1" :answer/id #uuid "b388bc7a-f341-596b-93dd-60183e4ec2b1"] ["answer-b388bc7a-f341-596b-93dd-60183e4ec2b1" :answer/type :answer.type/math] ["answer-b388bc7a-f341-596b-93dd-60183e4ec2b1" :answer/value "\\frac{9}{4}"] ["answer-field-d5917ecc-743e-5b98-928c-b4e265150550" :answer-field/key "selection"] ["answer-field-d5917ecc-743e-5b98-928c-b4e265150550" :answer-field/type :answer-field.type/radio] ["answer-field-d5917ecc-743e-5b98-928c-b4e265150550" :answer-field/correct "answer-a24492a0-f30c-5760-a699-262c2d5c1e9b"] ["answer-field-d5917ecc-743e-5b98-928c-b4e265150550" :answer-field/choices "answer-00390579-73db-58de-8e3f-f3ca75d10676"