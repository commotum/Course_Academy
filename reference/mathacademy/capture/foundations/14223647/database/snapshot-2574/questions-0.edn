{d}r & ={\\int }_{-{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345275 :knowledge-point/_questions [{:db/id #edb/ref 17592186179672 :knowledge-point/id #uuid "70b4357f-d5c5-5946-9022-0602c4217a1d" :knowledge-point/title "Using the Properties of Line Integrals of Vector-Valued Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13931ae7-6354-592e-bb8d-3b8b65db5e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/id #edb/ref 17592186342408} {:answer/id #uuid "6972ed93-4075-55f3-8e30-6e39ad736b80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/id #edb/ref 17592186343138} {:answer/id #uuid "89fe3f10-6eea-55ef-a7d0-6ef8b6929829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/id #edb/ref 17592186343438} {:answer/id #uuid "dcbb6123-6d08-5607-946f-f6b791749bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/id #edb/ref 17592186344176} {:answer/id #uuid "fa39b3aa-fce0-5af7-af46-f90f0199cf53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/id #edb/ref