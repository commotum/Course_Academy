#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409694} :activity/id #uuid "26bcedbd-f502-5256-b322-6d751a0c036d" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186409692 :step/content {:db/id #edb/ref 17592186409691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08098a6b-f06b-51d7-be19-39ddeb566f21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-256" :db/id #edb/ref 17592186409658} {:answer/id #uuid "4da115ec-321e-53f5-9c9a-06b3818508a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409661} {:answer/id #uuid "7105bb69-b089-5e84-ab20-fd40c1edbdff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-864" :db/id #edb/ref 17592186409667} {:answer/id #uuid "b58e6bc8-29ce-5a41-8721-675b80eb22cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-144" :db/id #edb/ref 17592186409673} {:answer/id #uuid "fcd30542-3cc5-5b61-a9af-49753027f933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-48" :db/id #edb/ref 17592186409681}] :answer-field/correct {:db/id #edb/ref 17592186409673} :answer-field/id #uuid "04759499-638f-5548-ad9a-51762b698235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409683}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fded0a2c-cd1a-5de1-a671-20ea991daecd" :question/math-academy-id "q-72737" :question/problem "Suppose $A$ is a $2\\times 2$ matrix and $det(A)=-4.$ What is the value of $det(6A)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A).\\end{aligned}\n$$\n\nIn our case, we have $k=6$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(6A) & ={6}^{2}\\cdot det(A) \\\\  & =36\\cdot (-4) \\\\  & =-144.\\end{aligned}\n$$"} :step/id #uuid "0f93ad19-15c5-55b8-98ea-d5bcee8f0a3a" :step/next {:db/id #edb/ref 17592186409696}} {:db/id #edb/ref 17592186409693 :step/content {:db/id #edb/ref 17592186409688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403dcee3-3eac-5cf3-a329-0558750fb3b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186409660} {:answer/id #uuid "62a1a85b-a36c-54a7-b3bd-55a36f4cb315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186409664} {:answer/id #uuid "77636ea6-fba2-560e-a69f-f3d2282f86f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186409669} {:answer/id #uuid "81cdf51b-4eb6-557c-9452-11d65bc919bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186409671} {:answer/id #uuid "ebe826b2-b0aa-57e0-a4ad-251af663d3fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186409678}] :answer-field/correct {:db/id #edb/ref 17592186409671} :answer-field/id #uuid "1a00ccd6-15ad-566e-9909-ced57101fb7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409684}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a80ad4c-5529-5931-9d7c-574d40c6f47e" :question/math-academy-id "q-72748" :question/problem "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=-7.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=2{R}_{2}$ and ${R}_{1}↔{R}_{3}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=2{R}_{2}$ involves multiplying a row by $2,$ so the determinant is multiplied by $2$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $2$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =2\\cdot (-det(B)) \\\\  & =-2det(B) \\\\  & =-2\\cdot (-7) \\\\  & =14.\\end{aligned}\n$$"} :step/id #uuid "2aef95ee-e7e9-5cac-b9ad-3b67a53db79f"} {:db/id #edb/ref 17592186409694 :step/content {:db/id #edb/ref 17592186120431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e01723b-cc89-5e3f-b933-6517b2094770" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186409662} {:answer/id #uuid "91ff05b8-c923-5cbc-9974-2858e86d4877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186409672} {:answer/id #uuid "b7b3cea5-79ed-5121-8909-27b79eb945a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409674} {:answer/id #uuid "b8a98397-80e5-5a87-b4ed-d166d96908c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186409675} {:answer/id #uuid "eb7338ba-732f-5bfb-aded-530b4a5f8d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186409677}] :answer-field/correct {:db/id #edb/ref 17592186409677} :answer-field/id #uuid "dc16361c-3306-5054-a003-e31388cab6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a9d752b-69e4-5f21-888f-3429a8443f7b" :question/math-academy-id "q-42503" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=12.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{2}↔{R}_{3}$ and ${R}_{1}:={R}_{1}+2{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+2{R}_{3}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"} :step/id #uuid "2df25dd7-50b3-560b-9abe-b6b13654a237" :step/next {:db/id #edb/ref 17592186409695}} {:db/id #edb/ref 17592186409695 :step/content {:db/id #edb/ref 17592186409690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5903e6-2dfb-5988-91aa-d76353ccd959" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186409659} {:answer/id #uuid "6d3a3be9-dab5-5f7f-8e95-4eab3b47ad8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186409665} {:answer/id #uuid "6d7bf72b-a934-51fa-b417-3e7f04a3f3b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{3}" :db/id #edb/ref 17592186409666} {:answer/id #uuid "7190fbd3-e0c2-5f59-a1f5-3e49c40c46d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:=2{R}_{3}" :db/id #edb/ref 17592186409668} {:answer/id #uuid "c8afe3f3-a5ef-55a7-b5dd-30e21d2e58fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{2}" :db/id #edb/ref 17592186409676}] :answer-field/correct {:db/id #edb/ref 17592186409659} :answer-field/id #uuid "7a779adf-221a-5189-a14f-312c86e15c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409685}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ac571f6-6f05-5f70-8bcf-34738f544556" :question/math-academy-id "q-43046" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & =|\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{1}.\n$$"} :step/id #uuid "8e6fad07-ec42-5416-85eb-9ef2b0059cbe" :step/next {:db/id #edb/ref 17592186409692}} {:db/id #edb/ref 17592186409696 :step/content {:db/id #edb/ref 17592186409689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "512abaff-433d-5e4a-864f-f1df10d56d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186409663} {:answer/id #uuid "7a56edfe-4461-57d1-8804-22f3e005401a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186409670} {:answer/id #uuid "f689939f-47fe-5c00-a125-9fe1fc1187ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186409679} {:answer/id #uuid "face2d4d-2a2b-5eb7-8047-8fb6dbd54d8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186409680} {:answer/id #uuid "fcf8031f-e31a-5703-96b3-5a28bec971aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186409682}] :answer-field/correct {:db/id #edb/ref 17592186409682} :answer-field/id #uuid "98c176ba-da66-551c-9c0c-0c257e4d9459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409686}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81c5993c-3d71-5869-bbf5-3e36b2df3a7f" :question/math-academy-id "q-72741" :question/problem "Suppose $Y$ is a $6\\times 6$ matrix and $det(Y)=5.$ What is the value of $det(2Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=2$ and $n=6.$ Therefore,\n\n$$\n\\begin{aligned}det(2Y) & ={2}^{6}\\cdot det(Y) \\\\  & =64\\cdot 5 \\\\  & =320.\\end{aligned}\n$$"} :step/id #uuid "d75809ee-199d-50e2-b002-2326810f1174" :step/next {:db/id #edb/ref 17592186409693}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409657}]}
