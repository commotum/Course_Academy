etchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>2</mn><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>t</mi></mrow></msup></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>t</mi></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>t</mi></mrow></msup><mo>−</mo><mn>2</mn></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
