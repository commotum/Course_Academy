      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14275390/observations/step-q333127-432a04cb763ad1156f8a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14275390/observations/step-q333127-432a04cb763ad1156f8a.png",
      "source_url": "https://mathacademy.com/tasks/14275390/topics/3190/lesson",
      "captured_at": 1792226719.503168,
      "math_academy_id": "q-333127",
