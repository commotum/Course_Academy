          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:140px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"137\"><span mathquill-command-id=\"141\">2</span><var mathquill-command-id=\"143\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"145\"><span class=\"mq-sup\" mathquill-block-id=\"147\"><span mathquill-command-id=\"146\">2</span><var mathquill-command-id=\"148\">t</var></span></span><span mathquill-command-id=\"151\" class=\"mq-binary-operator\">−</span><var mathquill-command-id=\"153\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"155\"><span class=\"mq-sup\" mathquill-block-id=\"157\"><span mathquill-command-id=\"156\">4</span><var mathquill-command-id=\"158\">t</var></span></span><span mathquill-command-id=\"161\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"163\">1</span></span></div></div>",
          "rendered_text": "2e2t−e4t+1",
