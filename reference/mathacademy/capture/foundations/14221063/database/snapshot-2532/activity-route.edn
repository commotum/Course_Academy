#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186532741} :activity/id #uuid "eccbce88-476f-56f7-afed-2a82763ecdf2" :activity/scope {:db/id #edb/ref 17592186050757 :topic/id #uuid "643ac99b-01f2-533f-b1bc-9babbc0cef82" :topic/math-academy-id 3284} :activity/steps [{:db/id #edb/ref 17592186532730 :step/content {:db/id #edb/ref 17592186532628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80c94ff5-e094-5fec-a663-783e3db82388" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.9493" :db/id #edb/ref 17592186532225}] :answer-field/correct {:db/id #edb/ref 17592186532225} :answer-field/id #uuid "efc50829-ddbd-58f0-8a60-4f7a72a20ec5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186532607}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a330685-db48-5728-bb5b-a1b5a0526e38" :question/math-academy-id "q-332929" :question/problem "Given $X∼\\text{Geom}(0.63),$ compute $P(X<4).$ Round your final answer to $4$ decimal places.\n\n$P(X<4)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.63),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.37)}^{x-1}(0.63), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in \\{1,2,3\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(0.37)}^{0}(0.63)+{(0.37)}^{1}(0.63)+{(0.37)}^{2}(0.63) \\\\  & ≈0.9493.\\end{aligned}\n$$"} :step/id #uuid "0cab9f07-f53a-5d32-a373-e6bac7fd4446" :step/next {:db/id #edb/ref 17592186532754}} {:db/id #edb/ref 17592186532741 :step/content {:db/id #edb/ref 17592186532711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4be3563b-85a4-5927-8f14-75809dbb4706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3263" :db/id #edb/ref 17592186532090} {:answer/id #uuid "4e9c899d-e556-5912-93c1-9e3ca0347975" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3074" :db/id #edb/ref 17592186532104} {:answer/id #uuid "551c66e8-4471-5f2d-9a69-c55890cd1f3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3182" :db/id #edb/ref 17592186532116} {:answer/id #uuid "68de0d90-b739-525e-a634-18b6e92914fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2901" :db/id #edb/ref 17592186532167} {:answer/id #uuid "ce1a9056-6d3f-565a-ae29-98e576722262" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.3315" :db/id #edb/ref 17592186532377}] :answer-field/correct {:db/id #edb/ref 17592186532104} :answer-field/id #uuid "cd41d07a-8118-5a4f-af31-10c9c686bf80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186532591}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e7dd6d27-99b8-51e0-8f07-28863587b350" :question/math-academy-id "q-97161" :question/problem "Given that $X∼\\text{Geom}(0.1),$ compute $P(4<X\\le 10)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.1),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.9)}^{x-1}(0.1), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(4<X\\le 10) & =P(X\\in \\{5,6,7,8,9,10\\}) \\\\  & =P(X=5)+P(X=6)+P(X=7)+ \\\\  & \\,P(X=8)+P(X=9)+P(X=10) \\\\  & =f(5)+f(6)+f(7)+f(8)+f(9)+f(10) \\\\  & ={(0.9)}^{4}(0.1)+{(0.9)}^{5}(0.1)+{(0.9)}^{6}(0.1)+ \\\\  & \\,{(0.9)}^{7}(0.1)+{(0.9)}^{8}(0.1)+{(0.9)}^{9}(0.1) \\\\  & ≈0.3074.\\end{aligned}\n$$"} :step/id #uuid "646fc0d5-2e80-5a45-9947-e31e4a48e0e6" :step/next {:db/id #edb/ref 17592186532750}} {:db/id #edb/ref 17592186532750 :step/content {:db/id #edb/ref 17592186532675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ce64594-4d44-5fbb-916a-9540f6c9aad1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1452" :db/id #edb/ref 17592186532092} {:answer/id #uuid "7bc4bd4f-eaf1-5902-990b-f37f8dc13633" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2186" :db/id #edb/ref 17592186532211} {:answer/id #uuid "d55089b5-7956-5fa0-8147-9220f21301db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1630" :db/id #edb/ref 17592186532391} {:answer/id #uuid "e07dadf3-01af-5381-bcd2-159701c2246f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1965" :db/id #edb/ref 17592186532413} {:answer/id #uuid "e1c17dfa-72d1-519b-a04e-f7cb863e8d6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1406" :db/id #edb/ref 17592186532415}] :answer-field/correct {:db/id #edb/ref 17592186532415} :answer-field/id #uuid "5df74f69-e9ee-5e86-8090-3b562192d1f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186532536}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88f1dddc-e661-5d20-9bf7-86d209c9d4bf" :question/math-academy-id "q-97183" :question/problem "Given $X∼\\text{Geom}(\\frac{5}{8}),$ compute $P(X\\ge 3)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{8}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{3}{8})}^{x-1}(\\frac{5}{8}), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 3.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{3}{8})}^{0}(\\frac{5}{8})+{(\\frac{3}{8})}^{1}(\\frac{5}{8}) \\\\  & ≈0.8594.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & ≈1-0.8594 \\\\  & =0.1406.\\end{aligned}\n$$"} :step/id #uuid "b8587c43-02d1-5bdb-a188-5183461899c4" :step/next {:db/id #edb/ref 17592186532751}} {:db/id #edb/ref 17592186532751 :step/content {:db/id #edb/ref 17592186532716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e79b2f4c-88fd-5171-9805-d4c810b84f1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{124}{125}" :db/id #edb/ref 17592186532434}] :answer-field/correct {:db/id #edb/ref 17592186532434} :answer-field/id #uuid "635112d3-93b9-5181-b8a6-34ea068cbead" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186532538}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ef957d04-4e42-5090-b9a6-8e161a911753" :question/math-academy-id "q-332586" :question/problem "Given $X∼\\text{Geom}(\\frac{4}{5}),$ compute the **exact** value of $P(X\\le 3).$\n\n$P(X\\le 3)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{4}{5}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{5})}^{x-1}(\\frac{4}{5}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X\\in \\{1,2,3\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(\\frac{1}{5})}^{0}(\\frac{4}{5})+{(\\frac{1}{5})}^{1}(\\frac{4}{5})+{(\\frac{1}{5})}^{2}(\\frac{4}{5}) \\\\  & =\\frac{124}{125}.\\end{aligned}\n$$"} :step/id #uuid "c3439878-ff61-50b6-9b9a-bbd0ad959b16" :step/next {:db/id #edb/ref 17592186532730}} {:db/id #edb/ref 17592186532754 :step/content {:db/id #edb/ref 17592186532673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84d4b28b-adba-57ec-9abd-1c6eab03e465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0024" :db/id #edb/ref 17592186532232}] :answer-field/correct {:db/id #edb/ref 17592186532232} :answer-field/id #uuid "21503cab-a324-5fe0-bffe-94e6d9d3497e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186532507}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "82d7f69c-d6ad-553d-a4a8-4fc134f8a8d9" :question/math-academy-id "q-335528" :question/problem "Given $X∼\\text{Geom}(0.7),$ compute the value of $P(X>5)$ round to $4$ decimal places.\n\n$P(X>5)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(0.3)^{x-1}(0.7), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>5.$ However, we can simplify the computation by using the complement instead:\n\n$$\nP(X>5)=1-P(X\\le 5)\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 5) & =P(X\\in \\{1,2,3,4,5\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4)+P(X=5) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & =(0.3)^{0}(0.7)+(0.3)^{1}(0.7)+(0.3)^{2}(0.7)+(0.3)^{3}(0.7)+(0.3)^{4}(0.7) \\\\  & =0.99757.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>5) & =1-P(X\\le 5) \\\\  & =1-0.99757 \\\\  & ≈0.0024.\\end{aligned}\n$$"} :step/id #uuid "ceafd4e3-8a65-51ca-9ad8-82f0439b1d22"}] :activity/title "The Geometric Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186531936}]}
