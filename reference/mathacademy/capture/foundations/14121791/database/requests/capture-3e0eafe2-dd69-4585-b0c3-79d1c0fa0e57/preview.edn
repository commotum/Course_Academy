7 true] [17592186417354 1082 #edb/ref 17592186045498 13194139534284 17592186045417 true] [17592186417354 1083 #uuid "df929076-a9d7-5c37-b534-2a48f5c0f2ed" 13194139534284 17592186045417 true] [17592186417355 1075 #edb/ref 17592186417350 13194139534284 17592186045417 true] [17592186417355 1075 #edb/ref 17592186417351 13194139534284 17592186045417 true] [17592186417355 1075 #edb/ref 17592186417352 13194139534284 17592186045417 true] [17592186417355 1075 #edb/ref 17592186417353 13194139534284 17592186045417 true] [17592186417355 1075 #edb/ref 17592186417354 13194139534284 17592186045417 true] [17592186417355 1076 #edb/ref 17592186045493 13194139534284 17592186045417 true] [17592186417355 1077 "selection" 13194139534284 17592186045417 true] [17592186417355 1078 #edb/ref 17592186417353 13194139534284 17592186045417 true] [17592186417355 1079 #uuid "b6520f4c-cce8-5e56-adce-0289e4c3517a" 13194139534284 17592186045417 true] [17592186417356 1068 #edb/ref 17592186417355 13194139534284 17592186045417 true] [17592186417356 1069 "q-160387" 13194139534284 17592186045417 true] [17592186417356 1070 #edb/ref 17592186045485 13194139534284 17592186045417 true] [17592186417356 1071 "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}3{u}^{2}+2v \\\\ u+2{v}^{2}\\end{aligned}].\n$$\n\ncompute the value of the Jacobian determinant at the point where\n$[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$" 13194139534284 17592186045417 true] [17592186417356 1072 #uuid "2756cd36-f06f-563c-8e51-e0b858d03f97" 13194139534284 17592186045417 true] [17592186417356 1074 "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=3{u}^{2}+2v$ and $y(u,v)=u+2{v}^{2}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =6u & \\,\\frac{∂x}{∂v} & =2 \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =4v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}6u & 2 \\\\ 1 & 4v\\end{aligned}| \\\\  & =6u\\cdot 4v-2\\cdot 1 \\\\  & =24uv-2.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,1)}=24(1)(1)-2=22.\n$$" 13194139534284 17592186045417 true] [17592186417357 1058 #edb/ref 17592186417358 13194139534284 17592186045417 true] [17592186417357 1062 #uuid "51873d91-9d02-596a-8782-ed5264ede6c4" 13194139534284 17592186045417 true] [17592186417357 1063 #edb/ref 17592186278298 13194139534284 17592186045417 true] [17592186417358 1062 #uuid "5be3b3f2-cb7d-5d95-8a36-731fef7d85d5" 13194139534284 17592186045417 true] [17592186417358 1063 #edb/ref 17592186281352 13194139534284 17592186045417 true] [17592186417359 1058 #edb/ref 17592186417357 13194139534284 17592186045417 true] [17592186417359 1062 #uuid "8efc25d4-4fc0-5616-89ad-709e46dd706b" 13194139534284 17592186045417 true] [17592186417359 1063 #edb/ref 17592186417356 13194139534284 17592186045417 true]] :edb/tempids {"activity-5eeaa0e4-09d3-5d55-9a9f-ba1c84383049" 17592186417349 "answer-0e0d4b0b-8093-5290-b6b4-484e2a3c019b" 17592186417350 "answer-3f52c558-a8f4-5f12-84e4-136a7b9663ae" 17592186417351 "answer-ad3faf64-35fa-5814-9c5b-2c546aef7f2f" 17592186417352 "answer-c802b759-c3a3-5234-a525-52e3dcf0d733" 17592186417353 "answer-df929076-a9d7-5c37-b534-2a48f5c0f2ed" 17592186417354 "answer-field-b6520f4c-cce8-5e56-adce-0289e4c3517a" 175