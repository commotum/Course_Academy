#{[{:db/id #edb/ref 17592186417356 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0d4b0b-8093-5290-b6b4-484e2a3c019b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186417350} {:answer/id #uuid "3f52c558-a8f4-5f12-84e4-136a7b9663ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186417351} {:answer/id #uuid "ad3faf64-35fa-5814-9c5b-2c546aef7f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186417352} {:answer/id #uuid "c802b759-c3a3-5234-a525-52e3dcf0d733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186417353} {:answer/id #uuid "df929076-a9d7-5c37-b534-2a48f5c0f2ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186417354}] :answer-field/correct {:answer/id #uuid "c802b759-c3a3-5234-a525-52e3dcf0d733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186417353} :answer-field/id #uuid "b6520f4c-cce8-5e56-adce-0289e4c3517a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2756cd36-f06f-563c-8e51-e0b858d03f97" :question/math-academy-id "q-160387" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}3{u}^{2}+2v \\\\ u+2{v}^{2}\\end{aligned}].\n$$\n\ncompute the value of the Jacobian determinant at the point where\n$[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)=3{u}^{2}+2v$ and $y(u,v)=u+2{v}^{2}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =6u & \\,\\frac{∂x}{∂v} & =2 \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =4v\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}6u & 2 \\\\ 1 & 4v\\end{aligned}| \\\\  & =6u\\cdot 4v-2\\cdot 1 \\\\  & =24uv-2.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(1,1)}=24(1)(1)-2=22.\n$$"}] [{:db/id #edb/ref 17592186278298 :knowledge-point/_questions [{:db/id #edb/ref 17592186129263 :knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e0e11f-ca64-573d-aa4a-39c0085748ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275562} {:answer/id #uuid "2571ec42-1410-5512-abb4-5d9f33e67cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275817} {:answer/id #uuid "6056f233-baaf-59fc-ab26-47501271c259" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276339} {:answer/id #uuid "e97346e5-01ac-55ce-b840-edd902ee3c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277517} {:answer/id #uuid "fa81b135-dfdc-52eb-85bc-1dd61c22d3d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277669}] :answer-field/correct {:answer/id #uuid "e97346e5-01ac-55ce-b840-edd902ee3c65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277517} :answer-field/id #uuid "946d36e5-48fa-5671-b5c2-6b9df0953fbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277988}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "876a5d15-9cbd-5150-8246-c71dbabaa45c" :question/math-academy-id "q-160431" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{v}^{2}+uv \\\\ v-u\\end{aligned}]\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}8 \\\\ -2\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)={v}^{2}+uv$ and $y(u,v)=v-u.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =2v+u \\\\ \\frac{∂y}{∂u} & =-1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v & 2v+u \\\\ -1 & 1\\end{aligned}| \\\\  & =v\\cdot 1-(2v+u)\\cdot (-1) \\\\  & =v+2v+u \\\\  & =3v+u.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}8 \\\\ -2\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(8,-2)}=3(-2)+8=2.\n$$"}] [{:db/id #edb/ref 17592186281352 :knowledge-point/_questions [{:db/id #edb/ref 17592186129283 :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48838786-15c4-529e-9b61-9a4ae3631e27" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186279238} {:answer/id #uuid "644450bf-23df-5be6-9017-bc23e84a13fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png" :db/id #edb/ref 17592186279504} {:answer/id #uuid "71de0d63-b9fe-5bf9-98a3-3aa0f0728bad" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186279627} {:answer/id #uuid "743bb53f-15e9-5c76-9499-48070c482fc8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7f/7f214af0b5d71689ec7f21fff043e1779f1d3244c13fdbaf7b8df7f408d66298.png" :db/id #edb/ref 17592186279641} {:answer/id #uuid "9e8384cd-3f08-52be-b19d-6807ce1004b4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/14015cadab7d5dc8a9c33d0c1a57a44a79506bd01ba9b1cfe8ec1d280eb3fbb6.png" :db/id #edb/ref 17592186279998}] :answer-field/correct {:answer/id #uuid "644450bf-23df-5be6-9017-bc23e84a13fa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png" :db/id #edb/ref 17592186279504} :answer-field/id #uuid "158dba50-6c99-530b-a3b4-71c1f3ef60c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "613ff480-77bb-508e-adea-361b7545c613" :question/math-academy-id "q-161838" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ 2u & 2v\\end{aligned}| \\\\  & =1\\cdot (2v)-(2u)\\cdot 1 \\\\  & =2v-2u.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2v-2u & <0 \\\\ 2v & <2u \\\\ v & <u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png)"}]}
