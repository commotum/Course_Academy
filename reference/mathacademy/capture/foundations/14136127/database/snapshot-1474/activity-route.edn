nswer/id #uuid "34fbef3e-ce0c-5e42-8083-bb856bed6a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435977} {:answer/id #uuid "87337578-c732-5754-be09-02283229f965" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186435982} {:answer/id #uuid "9b8996e1-6f9f-5075-9e74-0c9956ec327f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186435983} {:answer/id #uuid "cad3e623-6a5f-55d5-841b-565c29e0e0bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186435988} {:answer/id #uuid "d315913a-19d5-543a-b877-666f53b9143f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186435990}] :answer-field/correct {:db/id #edb/ref 17592186435988} :answer-field/id #uuid "abd7ad31-b561-5286-91ce-40ec287b64f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435997}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f691affc-d374-513b-ace4-47b0fed08cd8" :question/math-academy-id "q-129394" :question/problem "If $\\text{Var}[X]=100,$ calculate $\\text{Var}[3-0.2X].$" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-0.2$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[3-0.2X] & ={(-0.2)}^{2}\\cdot \\text{Var}[X] \\\\  & =0.04\\cdot 100 \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "a774054b-3577-5411-a266-873c0fe2ca4a"} {:db/id #edb/ref 17592186436005 :step/content {:db/id #edb/ref 17592186436000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "771854e8-d892-5203-a97d-09439ca5fe0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186435979} {:answer/id #uuid "7efbea4c-7fba-5238-8596-49239d557793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186435980} {:answer/id #uuid "8456a043-c86f-5008-9d67-2741aff12dc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186435981} {:answer/id #uuid "b334ddce-463a-5f5a-8086-6f71f3ca1947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186435986} {:answer/id #uuid "e9634791-3b57-5087-836f-34d41f943f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186435993}] :answer-field/correct {:db/id #edb/ref 17592186435981} :answer-field/id #uuid "49d01f52-f12f-5f40-8306-2b10fa6ebffd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435995}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab459c95-a786-5463-b6df-ba7f08de2795" :question/math-academy-id "q-109070" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=\\frac{9}{2},$ calculate $\\text{Var}[\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $3$ | $6$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\frac{1}{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{2}X] & ={(\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=\\frac{9}{2}.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{3}^{2}\\cdot f(3)+{6}^{2}\\cdot f(6) \\\\  & =9\\cdot \\frac{1}{4}+36\\cdot \\frac{5}{8} \\\\  & =\\frac{99}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{99}{4}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{2} \\\\  & =\\frac{9}{8}.\\end{aligned}\n$$"} :step/id #uuid "b23b860b-4012-51e9-9c6f-d158c0177636" :step/next {:db/id #edb/ref 17592186436006}} {:db/id #edb/ref 17592186436006 :step/content {:db/id #edb/ref 17592186420139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcfce52-9f77-594e-abb6-a96da80d166b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2" :db/id #edb/ref 17592186420112} {:answer/id #uuid "5dae0172-10cc-5060-bf4a-315f77dba9a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420115} {:answer/id #uuid "6657c628-8660-5023-8ee0-945dab5715e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186420117} {:answer/id #uuid "95c4162c-b36b-54af-9f0c-c093bb7cac5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1" :db/id #edb/ref 17592186420119} {:answer/id #uuid "e3fddd96-3d89-5025-83fd-0275af9c34a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186420126}] :answer-field/correct {:db/id #edb/ref 17592186420126} :answer-field/id #uuid "53761adc-2f46-5607-b9dd-4ae8e7e441a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420133}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64dd6f3a-caa4-5c03-ba3a-d02448881df5" :question/math-academy-id "q-129381" :question/problem "$\\text{Var}[0.2]=$" :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore,\n\n$$\n\\text{Var}[0.2]=0.\n$$"} :step/id #uuid "d680df42-9af5-5d8e-85c5-ee68af73edc3" :step/next {:db/id #edb/ref 17592186436004}} {:db/id #edb/ref 17592186436007 :step/content {:db/id #edb/ref 17592186436001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cce534e-4802-5d94-97bf-80beed889e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "73" :db/id #edb/ref 17592186435976} {:answer/id #uuid "a997e5ce-81f8-5baf-8303-e27befaf4b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186435984} {:answer/id #uuid "bd1bccd5-410f-5b91-93ca-dbe4d676607f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186435987} {:answer/id #uuid "e6c7e480-2dae-55a9-9956-216be43bcfc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{49}" :db/id #edb/ref 17592186435992} {:answer/id #uuid "f5361e88-3d20-5f4f-860f-c82dceb66009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186435994}] :answer-field/correct {:db/id #edb/ref 17592186435984} :answer-field/id #uuid "cee9d609-cf3a-562f-9f5d-2dd12fbb70da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435998}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eff26da6-299d-5b1f-93b8-02b4dbf809cb" :question/math-academy-id "q-109064" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=3,$ calculate $\\text{Var}[7X].$ \n\n| $x$ | $1$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{7}$ | $\\frac{2}{7}$ | $\\frac{4}{7}$ |" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=7.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[7X] & ={7}^{2}\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=3.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =1\\cdot \\frac{1}{7}+4\\cdot \\frac{2}{7}+16\\cdot \\frac{4}{7} \\\\  & =\\frac{73}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{73}{7}-{3}^{2} \\\\  & =\\frac{10}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[7X] & =49\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\frac{10}{7} \\\\  & =70.\\end{aligned}\n$$"} :step/id #uuid "de016c0c-5fd8-5def-85ac-87352e4b87f8" :step/next {:db/id #edb/ref 17592186436005}}] :activity/title "Properties of Variance for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186435974}]}
