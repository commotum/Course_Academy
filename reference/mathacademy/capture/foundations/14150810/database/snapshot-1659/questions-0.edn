id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2 - \\sin (1))i + j" :db/id #edb/ref 17592186122381} {:answer/id #uuid "fb69c42b-63e6-5bbc-ad18-f9fbc6438e6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sin (1) - 2)i - j" :db/id #edb/ref 17592186122382} {:answer/id #uuid "1b2b4fe4-fb54-51f9-b481-aa6353b4c03c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2i + j" :db/id #edb/ref 17592186122383}] :answer-field/id #uuid "0e3d8181-5a0a-57e3-b64b-0cfbd5cc5890" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122378}] :question/id #uuid "e75dd59c-9b9f-50d9-a9a4-c1850c66ee84" :question/math-academy-id "q-36293" :question/problem "In what direction does the function $f(x, y) = \\cos x + x^{2}y$ increase most rapidly at the point $(1, 1)$?"}] [{:db/id #edb/ref 17592186125028 :knowledge-point/_questions [{:db/id #edb/ref 17592186124460 :knowledge-point/id #uuid "c330648f-69ad-5778-98cb-bd48a0b160dd" :knowledge-point/title "Finding the Rate of Change of a Function in a Given Direction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb74f0-7cbb-50ca-b586-f737d6776ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π + e}}{e}" :db/id #edb/ref 17592186122769} {:answer/id #uuid "dc78535a-8c2f-56df-9b87-429982d864c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{π + e}{e}}" :db/id #edb/ref 17592186122770} {:answer/id #uuid "f0fd833e-3cf7-55af-bc07-55bc949b0cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{2} + e^{2}}}{e}" :db/id #edb/ref 17592186122771} {:answer/id #uuid "39f8b7b1-abe0-5cdc-8e14-a6a2092e6f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{4} + e^{2}}}{π}" :db/id #edb/ref 17592186122772} {:answer/id #uuid "6b9b409c-8615-5646-8312-02eb29a5d380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{2} + e^{2}}}{π}" :db/id #edb/ref 17592186122773}] :answer-field/id #uuid "4aca3088-e8f0-5dbc-95a5-523c9e4320d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122768}] :question/id #uuid "8ea3ebc5-2c81-5696-aab4-931973a19233" :question/math-academy-id "q-37074" :question/problem "Consider the function $g(x, y) = \\sin (y\\ln x)$. What is the rate of change of $g(x, y)$ at the point $(e, π)$ in the direction in which the function increases most rapidly?"}] [{:db/id #edb/ref 17592186351517 :knowledge-point/_questions [{:db/id #edb/ref 17592186124459 :knowledge-point/id #uuid "ff351d3f-449b-5c41-8f72-d1917b2b7536" :knowledge-point/title "Finding the Direction of Maximum Increase or Maximum Decrease of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e2d1818-23b6-5bc6-9705-1aa1f8fcde6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{-1}+1)\\text{ }i+({e}^{-1}-1)j" :db/id #edb/ref 17592186349013} {:answer/id #uuid "68eb9247-b932-5869-944e-6c106bd7cb39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e-1)\\text{ }i+ej" :db/id #edb/ref 17592186349413} {:answer/id #uuid "6fd17f28-20e2-5ce1-8906-d302e5e5f909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{-1}+1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349472} {:answer/id #uuid "91bd11c8-e407-5439-bdc4-1470bfd9ed1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{-1}-1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349749} {:answer/id #uuid "df06fa9d-9784-5210-b854-98e07a5502ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(e+1)\\text{ }i+(e-1)j" :db/id #edb/ref 17592186350399}] :answer-field/correct {:answer/id #uuid "91bd11c8-e407-5439-bdc4-1470bfd9ed1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{-1}-1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349749} :answer-field/id #uuid "49ce0ac9-9872-520a-b868-69cd398be0c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350832}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e724341-d4b7-5d33-9112-e9d06eaccd62" :question/math-academy-id "q-83554" :question/problem "In what direction does the function $f(x,y)=x\\operatorname{ln}⁡y+y{e}^{x}-xy$ increase most rapidly at the point $(-1,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y+y{e}^{x}-xy)\\text{ }i+\\frac{∂}{∂y}(x\\operatorname{ln}⁡y+y{e}^{x}-xy)\\text{ }j \\\\  & =(\\operatorname{ln}⁡y+y{e}^{x}-y)\\text{ }i+(\\frac{x}{y}+{e}^{x}-x)\\text{ }j \\\\ ∇f(1,1) & =(\\operatorname{ln}⁡1+1\\cdot {e}^{-1}-1)\\text{ }i+(\\frac{-1}{1}+{e}^{-1}-(-1))\\text{ }j \\\\  & =({e}^{-1}-1)\\text{ }i+{e}^{-1}j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $({e}^{-1}-1)\\text{ }i+{e}^{-1}j.$"}] [{:db/id #edb/ref 17592186354470 :knowledge-point/_questions [{:db/id #edb/ref 17592186124458 :knowledge-point/id #uuid "fd2b430e-fd5d-57ba-bc28-f7c113eda07a" :knowledge-point/title "Calculating a Directional Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1304514c-b435-522f-ad3a-591f2559a22b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{34}}{34}" :db/id #edb/ref 17592186351730} {:answer/id #uuid "7e4fba7a-fe7c-5a9c-9fbe-87782d23df70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{43}}{43}" :db/id #edb/ref 17592186352676} {:answer/id #uuid "c8a1b502-7fbf-5960-aaec-5f60565ea22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{34}}{34}" :db/id #edb/ref 17592186353314} {:answer/id #uuid "c94460ac-494e-513e-82ed-c599cb03d029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{43}}{34}" :db/id #edb/ref 17592186353320} {:answer/id #uuid "f1e9e528-e824-57bb-899a-9e75210a8db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{34}}{34}" :db/id #edb/ref 17592186353676}] :answer-field/correct {:answer/id #uuid "c8a1b502-7fbf-5960-aaec-5f60565ea22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{34}}{34}" :db/id #edb/ref 17592186353314} :answer-field/id #uuid "e9f8833b-3f19-5c49-a196-1b1b54521800" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8f45df0-069c-5e4a-a4d7-bdd2e15f5467" :question/math-academy-id "q-86429" :question/problem "Find the directional derivative of the function $f(x,y)=6{x}^{2}+2y$ at the point $(0,1)$ in the direction of the vector $v=3i+5j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{3}^{2}+{5}^{2}}=\\sqrt{34} \\\\ u & =\\frac{1}{\\sqrt{34}}(3i+5j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(0,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}(6{x}^{2}+2y)\\text{ }i+\\frac{∂}{∂y}(6{x}^{2}+2y)\\text{ }j \\\\  & =12x\\,i+2\\,j \\\\ ∇\\,f(0,1) & =(12\\cdot 0)\\,i+2\\,j \\\\  & =2j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(0,1) & =∇\\,f(0,1)\\cdot u \\\\  & =2j\\cdot (\\frac{3}{\\sqrt{34}}i+\\frac{5}{\\sqrt{34}}j) \\\\  & =\\frac{0\\cdot 3+2\\cdot 5}{\\sqrt{34}} \\\\  & =\\frac{10\\sqrt{34}}{34}.\\end{aligned}\n$$"}]}
