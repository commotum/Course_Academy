#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186410163} :activity/id #uuid "8c885820-a4e6-551c-b58e-779ad796568b" :activity/scope {:db/id #edb/ref 17592186050123 :topic/id #uuid "2eaffcb9-29e5-5903-a02d-080ab3e7a821" :topic/math-academy-id 1895} :activity/steps [{:db/id #edb/ref 17592186410159 :step/content {:db/id #edb/ref 17592186284489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44539af4-0399-5ce0-b529-2ec9422b06c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186282269} {:answer/id #uuid "51b07608-8e61-5926-ac17-e7dd744d0848" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of an ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186282391} {:answer/id #uuid "9a07fe10-cac8-55ba-b581-4e3f67ea9b07" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283031} {:answer/id #uuid "e8ad06f8-c6db-54fb-98ea-a18033a046ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186283716} {:answer/id #uuid "f1578ea5-8a30-5d54-9df7-7a5a0bca3a28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283793}] :answer-field/correct {:db/id #edb/ref 17592186282269} :answer-field/id #uuid "632305da-72ca-5185-8088-00cc26485c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284098}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12ff0311-caaa-5591-a831-5519fc8ddee1" :question/math-academy-id "q-164425" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{{5}^{2}}+\\frac{(y-3)^{2}}{{3}^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$"} :step/id #uuid "1c159990-55c8-5aa1-b89e-ba1b9d7acf3b"} {:db/id #edb/ref 17592186410160 :step/content {:db/id #edb/ref 17592186410158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "242e6d5f-d8c9-5706-a049-e8d876e8cf4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410152} {:answer/id #uuid "2db77962-9dd8-5e3e-afd9-c903fc200b96" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of an ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410153} {:answer/id #uuid "3a86a3b3-9ac2-5bfe-8094-01d6a3bffb3a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(-4,-2)$ with semi-axes of lengths $2$ and $6.$" :db/id #edb/ref 17592186410154} {:answer/id #uuid "70d01c11-f202-5519-a0ea-00fb5b34ce79" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The interior and boundary of an ellipse centered at $(2,\\sqrt{2})$ with semi-axes of lengths $4$ and $36.$" :db/id #edb/ref 17592186410155} {:answer/id #uuid "989114cb-f25b-5fc1-b192-1030cf33ffd9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse centered at $(2,\\sqrt{2})$ with semi-axes of lengths $4$ and $36.$" :db/id #edb/ref 17592186410156}] :answer-field/correct {:db/id #edb/ref 17592186410152} :answer-field/id #uuid "b9e78ba6-8720-5926-8f0b-e52d4b64b7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410157}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6343760b-b53e-5293-9f9e-2e583031956b" :question/math-academy-id "q-164424" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{(x-4)^{2}}{4}+\\frac{(y-2)^{2}}{36}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{(x-4)^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{6}^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(4,2)$ with semi-axes of lengths $2$ and $6.$"} :step/id #uuid "33921a36-2e91-50fa-a06c-a30b1124550d" :step/next {:db/id #edb/ref 17592186410159}} {:db/id #edb/ref 17592186410161 :step/content {:db/id #edb/ref 17592186284485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071d3bcc-39b3-5c99-93b6-62cd8ae9cf5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,1)" :db/id #edb/ref 17592186281754} {:answer/id #uuid "1c8a33f3-7a1b-50fa-a541-ab34e0431905" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-1)" :db/id #edb/ref 17592186281948} {:answer/id #uuid "37a95c20-f2fe-5c07-ada4-469f21d936aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,1)" :db/id #edb/ref 17592186282183} {:answer/id #uuid "57aeb6c0-2182-5711-a54a-f48855583b2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,2)" :db/id #edb/ref 17592186282435} {:answer/id #uuid "e433c482-9e74-566a-8f3b-810a0ce6733a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-1)" :db/id #edb/ref 17592186283678}] :answer-field/correct {:db/id #edb/ref 17592186283678} :answer-field/id #uuid "8bf6386c-b8c7-53b9-abbf-517dbee91f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284173}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d45d5923-cf19-557a-b6bb-276b79a4af56" :question/math-academy-id "q-164414" :question/problem "The projection of the intersection between the parabolic cylinder $4(x-3)^{2}=12(z+1)$ and the plane $y=2$ onto the $xz$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=2,$ we substitute $y=2$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}4(x-3)^{2} & =12(z+1) \\\\ (x-3)^{2} & =3(z+1) \\\\ (x-3)^{2} & =4\\cdot \\frac{3}{4}\\cdot (z+1).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xz$-plane with the vertex at $(3,-1).$"} :step/id #uuid "5707a2b8-ff1e-50c1-9adc-a0aa60ce9a37" :step/next {:db/id #edb/ref 17592186410160}} {:db/id #edb/ref 17592186410162 :step/content {:db/id #edb/ref 17592186401467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff45c2a2-3a41-5311-99ca-5e68d6a5cab4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The parabola $(x+3)^{2}=6z$" :db/id #edb/ref 17592186401469} {:answer/id #uuid "de23290b-1126-571c-a0e8-9a9fda87468d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The line $y=3$" :db/id #edb/ref 17592186401470} {:answer/id #uuid "86e5f373-6dc5-578d-9dab-a014632c2480" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The parabola ${x}^{2}=6(z-3)$" :db/id #edb/ref 17592186401471} {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} {:answer/id #uuid "defd7bf9-9f21-5237-ad4c-3feffa02e09e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The lines $y=-3$ and $y=15$" :db/id #edb/ref 17592186401473}] :answer-field/correct {:db/id #edb/ref 17592186401472} :answer-field/id #uuid "770068c0-e321-5534-9c7a-f0ff2132d3c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401468}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7c06a8e8-6e3d-50f3-ae2e-200f38471a76" :question/math-academy-id "q-164400" :question/problem "What is the trace in the $yz$-plane of the parabolic cylinder $(x+3)^{2}=6y?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(0+3)^{2} & =6y \\\\ 9 & =6y \\\\ y & =\\frac{9}{6} \\\\ y & =\\frac{3}{2}\\end{aligned}\n$$\n\nThis gives us the equation of a line in the $yz$-plane."} :step/id #uuid "62e270dc-12aa-54da-a6ae-4add22cc9797" :step/next {:db/id #edb/ref 17592186410161}} {:db/id #edb/ref 17592186410163 :step/content {:db/id #edb/ref 17592186124879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9039fbb0-0427-5260-9819-2bc08ae0459b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{2}$ and $4$" :db/id #edb/ref 17592186402397} {:answer/id #uuid "f1c93b02-8df2-5914-a21e-f47c872f2f7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186402398} {:answer/id #uuid "ed44325a-1253-529b-97fa-5240ff07dcf9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186402399} {:answer/id #uuid "061693b6-a3c5-5e80-8fdd-66ff86213ad8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186402400} {:answer/id #uuid "e63ce889-a7da-51d5-ba30-855cbdeb579a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2\\sqrt{2}$ and $6$" :db/id #edb/ref 17592186402401}] :answer-field/correct {:db/id #edb/ref 17592186402398} :answer-field/id #uuid "d2749579-8262-5164-918f-9718b15dd845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402396}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4fb4b9c0-1e83-54e2-ab98-0137b703d096" :question/math-academy-id "q-35363" :question/problem "The projection of the intersection between the elliptic cylinder $9{x}^{2}+2(y-1)^{2}=18$ and the plane $z=1$ onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the cylinder and the plane $z=1,$ we substitute $z=1$ into the equation of the cylinder. However, since the equation has no (explicit) $z$ term, we get\n\n$$\n\\begin{aligned}9{x}^{2}+2(y-1)^{2} & =18 \\\\ \\frac{{x}^{2}}{2}+\\frac{(y-1)^{2}}{9} & =1 \\\\ \\frac{{x}^{2}}{(\\sqrt{2})^{2}}+\\frac{(y-1)^{2}}{(3)^{2}} & =1.\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{2}$ and $3.$"} :step/id #uuid "84b4522c-b64f-561e-af00-35a410d9aa0f" :step/next {:db/id #edb/ref 17592186410162}}] :activity/title "Cylinders" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410151}]}
