#{[{:db/id #edb/ref 17592186401467 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff45c2a2-3a41-5311-99ca-5e68d6a5cab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola $(x+3)^{2}=6z$" :db/id #edb/ref 17592186401469} {:answer/id #uuid "de23290b-1126-571c-a0e8-9a9fda87468d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=3$" :db/id #edb/ref 17592186401470} {:answer/id #uuid "86e5f373-6dc5-578d-9dab-a014632c2480" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The parabola ${x}^{2}=6(z-3)$" :db/id #edb/ref 17592186401471} {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} {:answer/id #uuid "defd7bf9-9f21-5237-ad4c-3feffa02e09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $y=-3$ and $y=15$" :db/id #edb/ref 17592186401473}] :answer-field/correct {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401472} :answer-field/id #uuid "770068c0-e321-5534-9c7a-f0ff2132d3c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c06a8e8-6e3d-50f3-ae2e-200f38471a76" :question/math-academy-id "q-164400" :question/problem "What is the trace in the $yz$-plane of the parabolic cylinder $(x+3)^{2}=6y?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(0+3)^{2} & =6y \\\\ 9 & =6y \\\\ y & =\\frac{9}{6} \\\\ y & =\\frac{3}{2}\\end{aligned}\n$$\n\nThis gives us the equation of a line in the $yz$-plane."}] [{:db/id #edb/ref 17592186284485 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071d3bcc-39b3-5c99-93b6-62cd8ae9cf5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186281754} {:answer/id #uuid "1c8a33f3-7a1b-50fa-a541-ab34e0431905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186281948} {:answer/id #uuid "37a95c20-f2fe-5c07-ada4-469f21d936aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186282183} {:answer/id #uuid "57aeb6c0-2182-5711-a54a-f48855583b2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186282435} {:answer/id #uuid "e433c482-9e74-566a-8f3b-810a0ce6733a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186283678}] :answer-field/correct {:answer/id #uuid "e433c482-9e74-566a-8f3b-810a0ce6733a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186283678} :answer-field/id #uuid "8bf6386c-b8c7-53b9-abbf-517dbee91f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284173}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d45d5923-cf19-557a-b6bb-276b79a4af56" :question/math-academy-id "q-164414" :question/problem "The projection of the intersection between the parabolic cylinder $4(x-3)^{2}=12(z+1)$ and the plane $y=2$ onto the $xz$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=2,$ we substitute $y=2$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}4(x-3)^{2} & =12(z+1) \\\\ (x-3)^{2} & =3(z+1) \\\\ (x-3)^{2} & =4\\cdot \\frac{3}{4}\\cdot (z+1).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xz$-plane with the vertex at $(3,-1).$"}] [{:db/id #edb/ref 17592186284489 :knowledge-point/_questions [{:db/id #edb/ref 17592186124587 :knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44539af4-0399-5ce0-b529-2ec9422b06c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186282269} {:answer/id #uuid "51b07608-8e61-5926-ac17-e7dd744d0848" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186282391} {:answer/id #uuid "9a07fe10-cac8-55ba-b581-4e3f67ea9b07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The interior and boundary of an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283031} {:answer/id #uuid "e8ad06f8-c6db-54fb-98ea-a18033a046ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $25$ and $9.$" :db/id #edb/ref 17592186283716} {:answer/id #uuid "f1578ea5-8a30-5d54-9df7-7a5a0bca3a28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,-3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186283793}] :answer-field/correct {:answer/id #uuid "44539af4-0399-5ce0-b529-2ec9422b06c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "An ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$" :db/id #edb/ref 17592186282269} :answer-field/id #uuid "632305da-72ca-5185-8088-00cc26485c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12ff0311-caaa-5591-a831-5519fc8ddee1" :question/math-academy-id "q-164425" :question/problem "What is the domain in the $xy$-plane of the elliptic cylinder $\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "The full expression describing all points on our elliptic cylinder is\n\n$$\n\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{25}+\\frac{(y-3)^{2}}{9}=1}\n$$\n\nwhich can be written as\n\n$$\n{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{{5}^{2}}+\\frac{(y-3)^{2}}{{3}^{2}}=1}.\n$$\n\nThis is an ellipse centered at $(0,3)$ with semi-axes of lengths $5$ and $3.$"}] [{:db/id #edb/ref 17592186124879 :knowledge-point/_questions [{:db/id #edb/ref 17592186124588 :knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "896876a1-9e69-596f-9c61-8f62810fc6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $6$" :db/id #edb/ref 17592186121875} {:answer/id #uuid "8c6a72ce-482a-54c7-976f-b80d3ca276e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186121876} {:answer/id #uuid "abc2db20-0450-5718-8f2f-c1d6f3aa8a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186121877} {:answer/id #uuid "cc6e6581-507d-50e2-a396-732399b77ac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $4$" :db/id #edb/ref 17592186121878} {:answer/id #uuid "754e90dc-cff5-535b-9f36-e0a5754f64c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186121879}] :answer-field/id #uuid "c3d200af-c807-53cb-9c53-d450e64afb6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121874} {:answer-field/choices [{:answer/id #uuid "9039fbb0-0427-5260-9819-2bc08ae0459b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $4$" :db/id #edb/ref 17592186402397} {:answer/id #uuid "f1c93b02-8df2-5914-a21e-f47c872f2f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186402398} {:answer/id #uuid "ed44325a-1253-529b-97fa-5240ff07dcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186402399} {:answer/id #uuid "061693b6-a3c5-5e80-8fdd-66ff86213ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186402400} {:answer/id #uuid "e63ce889-a7da-51d5-ba30-855cbdeb579a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $6$" :db/id #edb/ref 17592186402401}] :answer-field/correct {:answer/id #uuid "f1c93b02-8df2-5914-a21e-f47c872f2f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{2}$ and $3$" :db/id #edb/ref 17592186402398} :answer-field/id #uuid "d2749579-8262-5164-918f-9718b15dd845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4fb4b9c0-1e83-54e2-ab98-0137b703d096" :question/math-academy-id "q-35363" :question/problem "The projection of the intersection between the elliptic cylinder $9{x}^{2}+2(y-1)^{2}=18$ and the plane $z=1$ onto the $xy$-plane is an ellipse. What are the lengths of the semi-axes of the ellipse?" :question/worked-solution "To find the intersection of the cylinder and the plane $z=1,$ we substitute $z=1$ into the equation of the cylinder. However, since the equation has no (explicit) $z$ term, we get\n\n$$\n\\begin{aligned}9{x}^{2}+2(y-1)^{2} & =18 \\\\ \\frac{{x}^{2}}{2}+\\frac{(y-1)^{2}}{9} & =1 \\\\ \\frac{{x}^{2}}{(\\sqrt{2})^{2}}+\\frac{(y-1)^{2}}{(3)^{2}} & =1.\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with semi-axes of lengths $\\sqrt{2}$ and $3.$"}]}
