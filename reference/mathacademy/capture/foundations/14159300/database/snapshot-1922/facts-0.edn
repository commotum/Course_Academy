-53e5-b3ff-d54d2085a716" #edb/ref 17592186045417] [17592186484145 #edb/ref 1075 #edb/ref 17592186483673 #edb/ref 17592186045417] [17592186484145 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186484145 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186484145 #edb/ref 1078 #edb/ref 17592186483673 #edb/ref 17592186045417] [17592186484145 #edb/ref 1079 #uuid "83efe503-c6c7-5398-8b5a-e3c31636860c" #edb/ref 17592186045417] [17592186484208 #edb/ref 1068 #edb/ref 17592186484145 #edb/ref 17592186045417] [17592186484208 #edb/ref 1069 "q-358781" #edb/ref 17592186045417] [17592186484208 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484208 #edb/ref 1071 "$$\nT(t)=\\frac{1}{5}(3\\operatorname{sin}⁡t\\,i-3\\operatorname{cos}⁡t\\,j-4\\,k).\n$$\n\nThe unit tangent vector to a curve at an arbitrary point is given above. Find the principal normal vector to that curve at an arbitrary point on the curve.\n\n$N(t)=$\n{{field-1}}\n$i\\,+\\operatorname{sin}⁡t\\,j$" #edb/ref 17592186045417] [17592186484208 #edb/ref 1072 #uuid "34386db1-c26a-52c0-8482-81ad51998468" #edb/ref 17592186045417] [17592186484208 #edb/ref 1074 "First, we calculate ${T}^{′}(t):$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{5}(3\\operatorname{sin}⁡t\\,i-3\\operatorname{cos}⁡t\\,j-4\\,k)) \\\\  & =\\frac{1}{5}(3\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i-3\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j-\\frac{\\text{d}}{\\text{d}t}(4)\\,k) \\\\  & =\\frac{3}{5}(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\frac{3}{5}‖\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j‖ \\\\  & =\\frac{3}{5}\\sqrt{(\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t)^{2}+{0}^{2}} \\\\  & =\\frac{3}{5}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\frac{3}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{3}{5}(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)}{\\frac{3}{5}} \\\\  & =\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186484275 #edb/ref 1068 #edb/ref 17592186484101 #edb/ref 17592186045417] [17592186484275 #edb/ref 1069 "q-223098" #edb/ref 17592186045417] [17592186484275 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186484275 #edb/ref 1071 "$$\nT(t)=⟨\\operatorname{sin}⁡(2t),\\,-\\operatorname{cos}⁡(2t)⟩.\n$$\n\nThe unit tangent vector to a curve at an arbitrary point is given above. Find the principal normal vector to that curve at an arbitrary point on the curve.\n\n$N(t)=$\n$⟨$\n{{field-1}},\n\n$\\operatorname{sin}⁡(2t)⟩$" #edb/ref 17592186045417] [17592186484275 #edb/ref 1072 #uuid "cd425a39-318f-5566-a2e2-b27e6f8eab87" #edb/ref 17592186045417] [17592186484275 #edb/ref 1074 "First, we calculate ${T}^{′}(t):$ \n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(⟨\\operatorname{sin}⁡(2t),\\,-\\operatorname{cos}⁡(2t)⟩) \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t)),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡(2t))⟩ \\\\  & =⟨2\\operatorname{cos}⁡(2t),\\,2\\operatorname{sin}⁡(2t)⟩ \\\\  & =2⟨\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =2‖⟨\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩‖ \\\\  & =2\\sqrt{{(\\operatorname{cos}⁡(2t))}^{2}+{(\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =2\\sqrt{{cos}^{2}⁡(2t)+{sin}^{2}⁡(2t)} \\\\  & =2\\sqrt{1} \\\\  & =2\\end{aligned}\n$$\n\nFinally, we we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{2⟨\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩}{2} \\\\  & =⟨\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186484317 #edb/ref 1062 #uuid "3dc5246d-6b1c-5f6e-8d4b-2f726b761e7e" #edb/ref 17592186045417] [17592186484317 #edb/ref 1063 #edb/ref 17592186484208 #edb/ref 17592186045417] [17592186484320 #edb/ref 1058 #edb/ref 17592186484335 #edb/ref 17592186045417] [17592186484320 #edb/ref 1062 #uuid "51cd3660-dac6-5f65-9a77-3570d44fead1" #edb/ref 17592186045417] [17592186484320 #edb/ref 1063 #edb/ref 17592186398326 #edb/ref 17592186045417] [17592186484329 #edb/ref 1058 #edb/ref 17592186484320 #edb/ref 17592186045417] [17592186484329 #edb/ref 1062 #uuid "7532dca0-e492-58d7-9fd4-a9d9dfcd23c7" #edb/ref 17592186045417] [17592186484329 #edb/ref 1063 #edb/ref 17592186345091 #edb/ref 17592186045417] [17592186484335 #edb/ref 1058 #edb/ref 17592186484353 #edb/ref 17592186045417] [17592186484335 #edb/ref 1062 #uuid "97701ad9-732a-5b50-b89b-ace9fb233738" #edb/ref 17592186045417] [17592186484335 #edb/ref 1063 #edb/ref 17592186484275 #edb/ref 17592186045417] [17592186484353 #edb/ref 1058 #edb/ref 17592186484317 #edb/ref 17592186045417] [17592186484353 #edb/ref 1062 #uuid "d0a76b8b-38c9-52ec-a2f0-64392234672c" #edb/ref 17592186045417] [17592186484353 #edb/ref 1063 #edb/ref 17592186290399 #edb/ref 17592186045417]}
