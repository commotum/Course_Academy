c8a-fb67-5e74-8896-7a038fa53b08" #edb/ref 17592186045417] [17592186435496 #edb/ref 1075 #edb/ref 17592186435480 #edb/ref 17592186045417] [17592186435496 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186435496 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186435496 #edb/ref 1078 #edb/ref 17592186435480 #edb/ref 17592186045417] [17592186435496 #edb/ref 1079 #uuid "4df0aa64-eae3-5c33-8bf5-0feea3f9c60f" #edb/ref 17592186045417] [17592186435497 #edb/ref 1075 #edb/ref 17592186435483 #edb/ref 17592186045417] [17592186435497 #edb/ref 1075 #edb/ref 17592186435484 #edb/ref 17592186045417] [17592186435497 #edb/ref 1075 #edb/ref 17592186435485 #edb/ref 17592186045417] [17592186435497 #edb/ref 1075 #edb/ref 17592186435489 #edb/ref 17592186045417] [17592186435497 #edb/ref 1075 #edb/ref 17592186435493 #edb/ref 17592186045417] [17592186435497 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186435497 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186435497 #edb/ref 1078 #edb/ref 17592186435489 #edb/ref 17592186045417] [17592186435497 #edb/ref 1079 #uuid "4f620f94-aa7b-56b8-b107-dbbda4003603" #edb/ref 17592186045417] [17592186435498 #edb/ref 1075 #edb/ref 17592186435478 #edb/ref 17592186045417] [17592186435498 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186435498 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186435498 #edb/ref 1078 #edb/ref 17592186435478 #edb/ref 17592186045417] [17592186435498 #edb/ref 1079 #uuid "72ed1eca-9fc4-5b18-a717-801450da7248" #edb/ref 17592186045417] [17592186435499 #edb/ref 1075 #edb/ref 17592186435479 #edb/ref 17592186045417] [17592186435499 #edb/ref 1075 #edb/ref 17592186435482 #edb/ref 17592186045417] [17592186435499 #edb/ref 1075 #edb/ref 17592186435486 #edb/ref 17592186045417] [17592186435499 #edb/ref 1075 #edb/ref 17592186435488 #edb/ref 17592186045417] [17592186435499 #edb/ref 1075 #edb/ref 17592186435494 #edb/ref 17592186045417] [17592186435499 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186435499 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186435499 #edb/ref 1078 #edb/ref 17592186435488 #edb/ref 17592186045417] [17592186435499 #edb/ref 1079 #uuid "cac80f7e-d672-5cc4-9408-ca831ac21b23" #edb/ref 17592186045417] [17592186435500 #edb/ref 1068 #edb/ref 17592186435495 #edb/ref 17592186045417] [17592186435500 #edb/ref 1069 "q-132557" #edb/ref 17592186045417] [17592186435500 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186435500 #edb/ref 1071 "The arrivals of vehicles at a crossing occur continuously in time, independently, and at a constant average rate of one every $10$ seconds. Determine the probability that the next vehicle will arrive at the crossing at least $5$ seconds after the previous vehicle's arrival. Round your answer to four decimal places." #edb/ref 17592186045417] [17592186435500 #edb/ref 1072 #uuid "2327e247-df72-5db4-a448-f8b66a015dc8" #edb/ref 17592186045417] [17592186435500 #edb/ref 1074 "Since arrivals of vehicles at the crossing occur continuously in time, independently, and at a constant average rate, we can model the time until the next vehicle arrives as an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the amount of time between the arrival of two successive vehicles at the crossing. Then, since vehicles arrive every $10$ seconds on average, the rate is $\\lambda =\\frac{1}{10}$ vehicles per second.\n\nThe time between arrivals can be modeled as an exponential random variable with rate $\\lambda =\\frac{1}{10},$ and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{10}).\n$$\n\nSo, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{10}{e}^{-x/10}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability that the next vehicle will arrive at the crossing at least $5$ seconds after the previous vehicle's arrival is\n\n$$\n\\begin{aligned}P(X\\ge 5) & ={\\int }_{5}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{5}^{\\infty }\\frac{1}{10}{e}^{-x/10}\\,\\text{d}x \\\\  & =-{e}^{-x/10}{|}_{5}^{\\infty } \\\\  & =-{e}^{-\\infty }+{e}^{-5/10} \\\\  & =0+{e}^{-1/2} \\\\  & ={e}^{-1/2} \\\\  & ≈0.6065.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186435501 #edb/ref 1068 #edb/ref 17592186435496 #edb/ref 17592186045417] [17592186435501 #edb/ref 1069 "q-254604" #edb/ref 17592186045417] [17592186435501 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186435501 #edb/ref 1071 "Calls to a customer service center occur continuously in time, independently, and at a constant average rate of one call every $10$ minutes. If no calls have been received for $20$ minutes, what is the probability that the next call will come within the next $5$ minutes? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." #edb/ref 17592186045417] [17592186435501 #edb/ref 1072 #uuid "2e0173ce-d070-51b0-81c2-1bf7c8171fcf" #edb/ref 17592186045417] [17592186435501 #edb/ref 1074 "Since calls occur continuously in time, independently, and at a constant average rate, we can model the time until the next call using the exponential distribution.\n\nLet $X$ be the time until the next call in minutes. Since calls occur every $10$ minutes on average, the rate is  $\\lambda =\\frac{1}{10}$ calls per minute, and we can write\n\n$$\nX∼\\text{Exp}(\\frac{1}{10}).\n$$\n\nRecall that exponential random variables have the memoryless property. Therefore, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nWe can compute the complementary conditional probability as follows:\n\n$$\nP(X\\le s+t\\,|\\,X>s)=1-P(X>s+t\\,|\\,X>s)=1-{e}^{-\\lambda t}\n$$\n\nIn our case, we have $\\lambda =\\frac{1}{10},$ $s=20,$ and $t=5.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X\\le 20+5\\,|\\,X>20) & =P(X\\le 5) \\\\  & =1-{e}^{-\\lambda t} \\\\  & =1-{e}^{-(1/10)\\cdot (5)} \\\\  & =1-{e}^{-1/2} \\\\  & ≈0.393.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186435502 #edb/ref 1068 #edb/ref 17592186435499 #edb/ref 17592186045417] [17592186435502 #edb/ref 1069 "q-132551" #edb/ref 17592186045417] [17592186435502 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186435502 #edb/ref 1071 "The lifetime of a certain type of electrical switch varies continuously. Lifetime of different switches of this type are independent, and switches replacements have a constant average rate of one every $2$ years. Determine the probability that a switch fails between the first and the second year. Round your answer to $4$ decimal places." #edb/ref 17592186045417] [17592186435502 #edb/ref 1072 #uuid "4f0c3a40-75d0-54f9-9bbc-0aacfac8fedd" #edb/ref 17592186045417] [17592186435502 #edb/ref 1074 "Since the lifetime of the switches varies continuously, lifetimes of different switches are independent, and switches replacements have a constant average rate, we can model the lifetime of a switch using the exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the lifetime, in years, of a random electrical switch. The lifetime can be modeled as an exponential random variable. Since switches are replaced every $2$ years on average, the rate is $\\lambda =\\frac{1}{2},$ and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{2}).\n$$\n\nIn this case, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2}{e}^{-x/2}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability that a switch fails between the first and the second year is\n\n$$\n\\begin{aligned}P(1<X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{2}{e}^{-x/2}\\,\\text{d}x \\\\  & =-{e}^{-x/2}{|}_{1}^{2} \\\\  & =-{e}^{-1}+{e}^{-1/2} \\\\  & ≈0.2387\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186435503 #edb/ref 1068 #edb/ref 17592186435498 #edb/ref 17592186045417] [17592186435503 #edb/ref 1069 "q-254607" #edb/ref 17592186045417] [17592186435503 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186435503 #edb/ref 1071 "Emails arrive in a professor's inbox continuously in time, independently, and at a constant average rate of $2$ emails per day. If the professor has not received an email for the past $3$ days, what is the probability that an email will arrive in the next $2$ days? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." #edb/ref 17592186045417] [17592186435503 #edb/ref 1072 #uuid "b0991a4b-acbc-5194-a13a-e698ad64e9cb" #edb/ref 17592186045417] [17592186435503 #edb/ref 1074 "Since emails arrive continuously in time, independently, and at a constant average rate, we can model the time until the next email using the exponential distribution.\n\nLet $X$ represent the time, in days, until the next email arrives. Given that emails arrive at an average rate of $2$ per day, the rate parameter is $\\lambda =2$ emails per day, and we can write \n\n$$\nX∼\\text{Exp}(2).\n$$\n\nRecall that exponential random variables have the memoryless property. Therefore, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nWe can compute the complementary conditional probability as follows:\n\n$$\nP(X\\le s+t\\,|\\,X>s)=1-P(X>s+t\\,|\\,X>s)=1-{e}^{-\\lambda t}\n$$\n\nIn our case, we have $\\lambda =2,$ $s=3,$ and $t=2.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X\\le 3+2\\,|\\,X>3) & =P(X\\le 2) \\\\  & =1-{e}^{-\\lambda t} \\\\  & =1-{e}^{-(2)(2)} \\\\  & =1-{e}^{-4} \\\\  & ≈0.982.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186435504 #edb/ref 1068 #edb/ref 17592186435497 #edb/ref 17592186045417] [17592186435504 #edb/ref 1069 "q-96677" #edb/ref 17592186045417] [17592186435504 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186435504 #edb/ref 1071 "Which of the following random variables could be modeled by an exponential distribution?\n\nI. The execution time, in seconds, of a computer program\n\nII. The number of students in a class with blood type $A$\n\nIII. The number of books read by a student in a month" #edb/ref 17592186045417] [17592186435504 #edb/ref 1072 #uuid "e53ee3ed-f667-5b74-b94f-f7c404a83247" #edb/ref 17592186045417] [17592186435504 #edb/ref 1074 "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I could be modeled using an exponential distribution. Executions of a computer program can be modeled as independent events with a constant average rate, and we wish to know the amount of time it takes to complete a single execution.\n\n- Random variable II does *not* follow an exponential distribution. There are no events that occur at a constant average rate, and there is no interval of continuous time or space. The number of students is discrete, not continuous.\n\n- Random variable III does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of books is discrete, not continuous.\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045417]}
