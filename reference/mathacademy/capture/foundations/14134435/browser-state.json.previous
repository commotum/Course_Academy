ow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>30</mn></mrow></msup><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">|</mo></mrow><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>15</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.2652</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
