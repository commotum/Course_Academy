>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow><mn>6</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">∞</mi></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi mathvariant=\"normal\">∞</mi></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>12</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>5</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.0907</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
