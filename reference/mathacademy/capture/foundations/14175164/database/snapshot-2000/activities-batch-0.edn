#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186079565} :activity/id #uuid "f8a08871-6a9b-51b3-ac32-da28357d0c46" :activity/scope {:db/id #edb/ref 17592186050215 :topic/id #uuid "36fbe9c5-6e9c-5bcb-84f4-f05b614b557b" :topic/math-academy-id 626} :activity/steps [{:db/id #edb/ref 17592186079565 :step/content {:db/id #edb/ref 17592186079716 :tutorial/content "The additive properties of integrals are beneficial when we have to integrate a piecewise function, such as $$f(x)= {\\begin{aligned}x, & x<0 \\\\ 5, & x\\ge 0.\\end{aligned}$$\n\nFor example, let's calculate the integral $$\\displaystyle \\int_{-5}^4 f(x) \\,\\textrm{d}x.$$\n\nWe can split the integral into two integrals using the additive property, one integral for each \"piece\" of the piecewise function.\n\n- The first integral will be over the integral $[-5,0],$ and\n- the second integral will be over the integral $[0,4].$\n\nDoing this, we get the following: $$\\begin{aligned}{\\int }_{-5}^{4}f(x)\\,\\text{d}x & ={\\int }_{-5}^{0}f(x)\\,\\text{d}x+{\\int }_{0}^{4}f(x)\\,\\text{d}x \\\\ & ={\\int }_{-5}^{0}x\\,\\text{d}x+{\\int }_{0}^{4}5\\,\\text{d}x \\\\ & =\\frac{1}{2}{x}^{2}{|}_{-5}^{0}+5x{|}_{0}^{4} \\\\ & =\\frac{1}{2}[{0}^{2}-(-5)^{2}]+5[4-0] \\\\ & =-\\frac{25}{2}+20 \\\\ & =\\frac{15}{2}\\end{aligned}$$" :tutorial/id #uuid "3ee5b005-6d82-503b-a69b-0cb98d633bc6" :tutorial/math-academy-id 805 :tutorial/title "Introduction"} :step/id #uuid "c73cec04-a925-5876-81c3-89b6c2a0e2ff" :step/math-academy-id 613819 :step/next {:db/id #edb/ref 17592186079566}} {:db/id #edb/ref 17592186079566 :step/content {:db/id #edb/ref 17592186078597 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078309 :question/id #uuid "df884ed9-c75e-5a38-abe2-425e01ee4aa7" :question/math-academy-id "e-432"} :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534} {:db/id #edb/ref 17592186050819}] :knowledge-point/que