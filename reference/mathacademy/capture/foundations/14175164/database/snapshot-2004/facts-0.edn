 2 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2}+{A}_{3} \\\\  & =2-2+2 \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186309782 #edb/ref 1080 "22.5" #edb/ref 17592186045417] [17592186309782 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186309782 #edb/ref 1083 #uuid "84dcf942-5a22-5fad-824e-f3fa9cfe7925" #edb/ref 17592186045417] [17592186311481 #edb/ref 1075 #edb/ref 17592186309782 #edb/ref 17592186045417] [17592186311481 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186311481 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186311481 #edb/ref 1078 #edb/ref 17592186309782 #edb/ref 17592186045417] [17592186311481 #edb/ref 1079 #uuid "eb50a4f5-9a86-5be7-b5dc-d05a6bfd5893" #edb/ref 17592186045417] [17592186311932 #edb/ref 1068 #edb/ref 17592186311481 #edb/ref 17592186045417] [17592186311932 #edb/ref 1069 "q-338331" #edb/ref 17592186045417] [17592186311932 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186311932 #edb/ref 1071 "![](images/06/06ace831b877406e48fe8f1ab38a7244e7ade878d7c77b99d8230f40ad307207.png)\n\nThe graph of $y=f(x),$ shown above, consists of four line segments. Then,\n\n${\\int }_{-6}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." #edb/ref 17592186045417] [17592186311932 #edb/ref 1072 #uuid "c24171a6-04c2-51af-8603-621f0f04a134" #edb/ref 17592186045417] [17592186311932 #edb/ref 1074 "The graph consists of four parts: the line segment for $x\\in [-6,-3],$ the line segment for $x\\in (-3,0],$ the line segment for $x\\in (0,2],$ and the line segment for $x\\in (2,5].$ Therefore, we can write the required integral as follows:\n\n$$\n{\\int }_{-6}^{5}f(x)\\,\\text{d}x={{{\\int }_{-6}^{-3}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{-3}^{0}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}+{{{\\int }_{0}^{2}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{3}}+{{{\\int }_{2}^{5}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{4}}.\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-6,-3].$ The corresponding region is a right triangle, so\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}3(3) \\\\  & =4.5.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-3,0].$ The corresponding region is a rectangle, so\n\n$$\n\\begin{aligned}{A}_{2} & =bh \\\\  & =3\\cdot 1 \\\\  & =3.\\end{aligned}\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in (0,2].$ The corresponding region is a trapezoid, so\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(4+2)(2) \\\\  & =6.\\end{aligned}\n$$\n\n- The $4$th integral represents the signed area between the curve and the $x$-axis, where $x\\in (2,5].$ The corresponding region is a right triangle, so\n\n$$\n\\begin{aligned}{A}_{4} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}3(6) \\\\  & =9.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-6}^{5}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2}+{A}_{3}+{A}_{4} \\\\  & =4.5+3+6+9 \\\\  & =22.5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186312305 #edb/ref 1080 "\\frac{13\\pi -8}{4}" #edb/ref 17592186045417] [17592186312305 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186312305 #edb/ref 1083 #uuid "2ae9f34e-7db8-57fc-94c6-4949ee0d2b71" #edb/ref 17592186045417] [17592186314684 #edb/ref 1075 #edb/ref 17592186312305 #edb/ref 17592186045417] [17592186314684 #edb/ref 1075 #edb/ref 17592186493687 #edb/ref 17592186045417] [17592186314684 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186314684 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186314684 #edb/ref 1078 #edb/ref 17592186493687 #edb/ref 17592186045417] [17592186314684 #edb/ref 1079 #uuid "f8642157-99dd-5a81-9c8e-ea0475be9d9a" #edb/ref 17592186045417] [17592186314818 #edb/ref 1068 #edb/ref 17592186314