11\\end{aligned}]" #edb/ref 17592186045417] [17592186392237 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186392237 #edb/ref 1083 #uuid "991e6247-97fb-5467-ad97-075e201709bd" #edb/ref 17592186045417] [17592186395229 #edb/ref 1068 #edb/ref 17592186395230 #edb/ref 17592186045417] [17592186395229 #edb/ref 1069 "q-97115" #edb/ref 17592186045417] [17592186395229 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186395229 #edb/ref 1071 "$$\n[T]_{C}=[\\begin{aligned}2 & 1 \\\\ 3 & 4\\end{aligned}],\\,{P}_{C\\to B}=[\\begin{aligned}-5 & 2 \\\\ 3 & -1\\end{aligned}]\n$$\n\nConsider the matrix $[T]_{C}$ of a linear transformation $T$ with respect to the basis $C$ and the change-of-coordinates matrix ${P}_{C\\to B}$ shown above. Find the matrix of $T$ relative to the basis $B.$" #edb/ref 17592186045417] [17592186395229 #edb/ref 1072 #uuid "65dae103-c225-5d3f-8973-42e2dd0c3a80" #edb/ref 17592186045417] [17592186395229 #edb/ref 1074 "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/2e/2e82c232614bec8a98f079ea56d7913ee13e7b457e33e418198278d2e369fc5c.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B}.\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nOur goal is to compute $[T]_{B}.$ Solving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nFirst, we compute the inverse of ${P}_{C\\to B}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B}^{-1} & ={[\\begin{aligned}-5 & 2 \\\\ 3 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-1)\\cdot (-5)-3\\cdot 2}[\\begin{aligned}-1 & -2 \\\\ -3 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the basis $B:$\n\n$$\n\\begin{aligned}[T]_{B} & ={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1} \\\\  & =[\\begin{aligned}-5 & 2 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 7 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186395230 #edb/ref 1075 #edb/ref 17592186395231 #edb/ref 17592186045417] [17592186395230 #edb/ref 1075 #edb/ref 17592186395232 #edb/ref 17592186045417] [17592186395230 #edb/ref 1075 #edb/ref 17592186395233 #edb/ref 17592186045417] [17592186395230 #edb/ref 1075 #edb/ref 17592186395234 #edb/ref 17592186045417] [17592186395230 #edb/ref 1075 #edb/ref 17592186395235 #edb/ref 17592186045417] [17592186395230 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186395230 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186395230 #edb/ref 1078 #edb/ref 17592186395232 #edb/ref 17592186045417] [17592186395230 #edb/ref 1079 #uuid "161f0cc1-c732-5e8a-bdbf-03f067c9d5be" #edb/ref 17592186045417] [17592186395231 #edb/ref 1080 "[\\begin{aligned}-1 & 7 \\\\ -6 & 9\\end{aligned}]" #edb/ref 17592186045417] [17592186395231 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395231 #edb/ref 1083 #uuid "0609b365-00a9-5e3f-b18a-4ae8f0cb6423" #edb/ref 17592186045417] [17592186395232 #edb/ref 1080 "[\\begin{aligned}5 & 7 \\\\ 0 & 1\\end{aligned}]" #edb/ref 17592186045417] [17592186395232 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186395232 #edb/ref 1083 #uuid "900a056b-ff09-5fb7-93ec-d70236eeac1b" #edb/ref 17592186045417] [17592186395233 #edb/ref 1080 "[\\begin{aligned}-7 & 3 \\\\ -3 & 2\\end{aligned}]" #edb/ref 17592186045417] [17592186395233 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [1759218639523