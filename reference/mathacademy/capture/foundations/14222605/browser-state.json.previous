o stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>0</mn><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msup><mi>π</mi><mn>2</mn></msup></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msup><mi>π</mi><mn>2</mn></msup></mrow></msup><mo>−</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
