n><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mn>2</mn><mn>2</mn></msup><mo>⋅</mo><msup><mn>5</mn><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo>+</mo><mn>5</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><msup><mn>0</mn><mn>2</mn></msup><mo>⋅</mo><msup><mn>1</mn><mn>2</mn></msup><mo>+</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>107</mn><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>106.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
