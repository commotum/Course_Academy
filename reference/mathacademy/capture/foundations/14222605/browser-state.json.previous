"bold\">r</mi></mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>⋅</mo><msup><mn>1</mn><mn>2</mn></msup><mo>⋅</mo><msup><mn>1</mn><mn>3</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>⋅</mo><msup><mn>0</mn><mn>2</mn></msup><mo>⋅</mo><msup><mn>0</mn><mn>3</mn></msup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
