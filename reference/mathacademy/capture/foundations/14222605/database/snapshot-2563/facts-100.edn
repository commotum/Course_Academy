db/ref 17592186258122 #edb/ref 17592186045417] [17592186259360 #edb/ref 1075 #edb/ref 17592186258416 #edb/ref 17592186045417] [17592186259360 #edb/ref 1075 #edb/ref 17592186258776 #edb/ref 17592186045417] [17592186259360 #edb/ref 1075 #edb/ref 17592186258887 #edb/ref 17592186045417] [17592186259360 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259360 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259360 #edb/ref 1078 #edb/ref 17592186258416 #edb/ref 17592186045417] [17592186259360 #edb/ref 1079 #uuid "bdaa45ba-790a-5b06-b275-79f77436acf0" #edb/ref 17592186045417] [17592186259584 #edb/ref 1068 #edb/ref 17592186259054 #edb/ref 17592186045417] [17592186259584 #edb/ref 1069 "q-124002" #edb/ref 17592186045417] [17592186259584 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259584 #edb/ref 1071 "Let $f(x,y)={x}^{2}{y}^{2}+x+y.$ Given that $C$ is the path along the curve $r(t)=⟨\\sqrt{t},t+1⟩$ for $t\\in [0,4],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259584 #edb/ref 1072 #uuid "003b8481-988f-56eb-a4c6-1362503d86f0" #edb/ref 17592186045417] [17592186259584 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,1⟩ \\\\ r(4) & =⟨2,5⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,1)$ and $(2,5).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(4))-f(r(0)) \\\\  & =f(2,5)-f(0,1) \\\\  & =({2}^{2}\\cdot {5}^{2}+2+5)-({0}^{2}\\cdot {1}^{2}+0+1) \\\\  & =107-1 \\\\  & =106.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259587 #edb/ref 1068 #edb/ref 17592186259204 #edb/ref 17592186045417] [17592186259587 #edb/ref 1069 "q-124008" #edb/ref 17592186045417] [17592186259587 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259587 #edb/ref 1071 "Let $f(x,y,z)={e}^{x}+{e}^{y}+{e}^{z}.$ Given that $C$ is the path along the curve $r(t)=⟨t,{t}^{2},2{t}^{3}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259587 #edb/ref 1072 #uuid "26e83fe0-4239-5444-b048-589ba5747a08" #edb/ref 17592186045417] [17592186259587 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0,0⟩ \\\\ r(1) & =⟨1,1,2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0,0)$ and $(1,1,2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(1,1,2)-f(0,0,0) \\\\  & =({e}^{1}+{e}^{1}+{e}^{2})-({e}^{0}+{e}^{0}+{e}^{0}) \\\\  & =(2e+{e}^{2})-3 \\\\  & ={e}^{2}+2e-3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259590 #edb/ref 1068 #edb/ref 17592186259233 #edb/ref 17592186045417] [17592186259590 #edb/ref 1069 "q-124029" #edb/ref 17592186045417] [17592186259590 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259590 #edb/ref 1071 "Let $f(x,y)=x\\operatorname{sin}⁡y.$ Given that $C$ is the path along the curve ${y}^{2}=x$ for $y\\in [0,\\frac{\\pi }{2}],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259590 #edb/ref 1072 #uuid "2e457dc8-8930-562f-905f-f48a2ebaba17" #edb/ref 17592186045417] [17592186259590 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨{t}^{2},t⟩,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩, \\\\ r(\\frac{\\pi }{2}) & =⟨\\frac{{\\pi }^{2}}{4},\\frac{\\pi }{2}⟩.\\end{aligned}\n$$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\frac{\\pi }{2}))-f(r(0)) \\\\  & =f(\\frac{{\\pi }^{2}}{4},\\frac{\\pi }{2})-f(0,0) \\\\  & =\\frac{{\\pi }^{2}}{4}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\cdot \\operatorname{sin}⁡0 \\\\  & =\\frac{{\\pi }^{2}}{4}\\cdot 1-0 \\\\  & =\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259592 #edb/ref 1068 #edb/ref 17592186259360 #edb/ref 17592186045417] [17592186259592 #edb/ref 1069 "q-124032" #edb/ref 17592186045417] [17592186259592 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259592 #edb/ref 1071 "Let $f(x,y)={e}^{y}\\operatorname{sin}⁡x.$ Given that $C$ is the path along the curve $y=2x$ for $y\\in [0,\\pi ],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259592 #edb/ref 1072 #uuid "1b4571c4-6fd7-5557-9855-d69404faa890" #edb/ref 17592186045417] [17592186259592 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨\\frac{t}{2},t⟩,\\,t\\in [0,\\pi ].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩, \\\\ r(\\pi ) & =⟨\\frac{\\pi }{2},\\pi ⟩.\\end{aligned}\n$$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\pi ))-f(r(0)) \\\\  & =f(\\frac{\\pi }{2},\\pi )-f(0,0) \\\\  & ={e}^{\\pi }\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-{e}^{0}\\cdot \\operatorname{sin}⁡0 \\\\  & ={e}^{\\pi }\\cdot 1-0 \\\\  & ={e}^{\\pi }.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259594 #edb/ref 1068 #edb/ref 17592186259075 #edb/ref 17592186045417] [17592186259594 #edb/ref 1069 "q-124035" #edb/ref 17592186045417] [17592186259594 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259594 #edb/ref 1071 "Let $f(x,y)={y}^{2}-x.$ Given that $C$ is the path along the curve $x=\\operatorname{cos}⁡y$ for $y\\in [0,\\pi ],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259594 #edb/ref 1072 #uuid "5c2ccfca-31f7-5fd8-9901-48e158e0be78" #edb/ref 17592186045417] [17592186259594 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,t⟩,\\,t\\in [0,\\pi ].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,0⟩, \\\\ r(\\pi ) & =⟨-1,\\pi ⟩.\\end{aligned}\n$$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{al