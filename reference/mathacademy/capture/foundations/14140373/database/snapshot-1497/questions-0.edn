1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186327553} :answer-field/id #uuid "c9822533-fbcf-5b20-a3af-01eaee0b139a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329541}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd3b5a32-f5f9-54aa-b2af-a91ccc349130" :question/math-academy-id "q-42767" :question/problem "Suppose that the following elementary row operations, in the given order, are to be applied to a $2\\times 2$ matrix $A:$\n\n$$\n{R}_{2}:=-2{R}_{2},\\,{R}_{1}↔{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}\n$$\n\nFind the equivalent notation in terms of matrix multiplication." :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first elementary row operation is ${R}_{2}:=-2{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2}:=-2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second elementary row operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third elementary row operation is ${R}_{2}:={R}_{2}+3{R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{2}:={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186436816 :knowledge-point/_questions [{:db/id #edb/ref 17592186115247 :knowledge-point/id #uuid "94c2cd65-810b-52ad-a20d-7b5a0a9eaf2b" :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bdc6917-9114-570c-b655-0097a2be410a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186436774} {:answer/id #uuid "86b0d865-71ce-5220-9638-642262d571c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186436782} {:answer/id #uuid "afc0ce32-cc50-5733-b5e8-eadc123226ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 8 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186436788} {:answer/id #uuid "e3990169-9d67-57a7-8327-43a5424638ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 8\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186436796} {:answer/id #uuid "f6c7a979-ff9d-5864-b885-40fddca4b43c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A\\cdot [\\begin{aligned}8 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186436801}] :answer-field/correct {:answer/id #uuid "86b0d865-71ce-5220-9638-642262d571c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}]\\cdot A" :db/id #edb/ref 17592186436782} :answer-field/id #uuid "76248571-5036-5758-846c-eda5b7a6680e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436808}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e584c32-a3dd-5eaa-a4dc-b23f04848d16" :question/math-academy-id "q-42809" :question/problem "Suppose we are applying the elementary row operation ${R}_{1}:={R}_{1}+8{R}_{2}$ to a $2\\times 2$ matrix $A.$ Find the equivalent notation in terms of matrix multiplication." :question/worked-solution "We need to find an elementary matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}:={R}_{1}+8{R}_{2}$ to $A.$ \n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+8{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}]\\cdot A\n$$"}] [{:db/id #edb/ref 17592186329687 :knowledge-point/_questions [{:db/id #edb/ref 17592186115246 :knowledge-point/id #uuid "f0f47800-98b3-512e-af20-1899e6b0c86d" :knowledge-point/tit