#{[{:activity/first-step {:db/id #edb/ref 17592186116129} :activity/id #uuid "16b40f91-5658-5189-b1b3-5c72e2c31649" :activity/scope {:db/id #edb/ref 17592186048373 :topic/id #uuid "9a47a282-0179-50e0-9d6d-768547252a79" :topic/math-academy-id 1727} :activity/steps [{:db/id #edb/ref 17592186116129 :step/content {:db/id #edb/ref 17592186116497 :tutorial/content "To compute the product of an elementary matrix and another matrix, one option is to perform the matrix multiplication as usual. However, there's an easier, quicker way.\n\nRemember that every elementary matrix is the result of applying an elementary row operation to the identity matrix. If we multiply another matrix by an elementary matrix, we're effectively applying the elementary row operation to the other matrix.\n\nFor example, suppose we are asked to find the product $EA$ where\n\n$$\n[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]\n$$\n\nThe elementary matrix $E$ comes from swapping the two rows of the identity matrix ($R_1 \\leftrightarrow R_2$). So, to compute the product $EA,$ all we have to do is swap the two rows of $A\\mathbin{:}$\n\n$$\n[\\begin{aligned}8 & 6 \\\\ 3 & 4\\end{aligned}]\n$$\n\nThis may seem almost too easy. But it's true! And we can verify it by computing the product the long way, using matrix multiplication. Indeed, we get the same result:\n\n$$\n\\begin{aligned}EA & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}3 & 4 \\\\ 8 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 6 \\\\ 3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nSo, we say that $E \\cdot A$ is equivalent to applying to $A$ the elementary row operation $R_1 \\leftrightarrow R_2.$\n\n**Watch out!** It's important to multiply $A$ from the *left*. If we multiply $A$ by an elementary matrix from the *right*, we will perform a *column* operation on $A$ (not a row operation). In this case, multiplying $A$ by $E$ from the right will have the effect of switching the *columns* of $A,$ not the rows.\n\n$$\n\\begin{aligned}AE & =[\\begin{aligned}3 & 4 \\\\ 8 & 6\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 6 & 8\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "527d3bb7-567f-5115-ad1c-31bd81fe1c23" :tutorial/math-academy-id 3166 :tutorial/title "Introduction"} :step/id #uuid "f7bbedb9-6a2a-55a3-b430-2e2720918232" :step/math-academy-id 17226 :step/next {:db/id #edb/ref 17592186116130}} {:db/id #edb/ref 17592186116130 :step/content {:db/id #edb/ref 17592186115246 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115075 :question/id #uuid "51a437bf-2a11-5eba-a046-4770d41214ca" :question/math-academy-id "e-4720"} :knowledge-point/id #uuid "f0f47800-98b3-512e-af20-1899e6b0c86d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049120} {:db/id #edb/ref 17592186050576}] :knowledge-point/questions [{:db/id #edb/ref 17592186115742} {:db/id #edb/ref 17592186115846} {:db/id #edb/ref 17592186265983} {:db/id #edb/ref 17592186265984} {:db/id #edb/ref 17592186265986} {:db/id #edb/ref 17592186299842} {:db/id #edb/ref 17592186329687}] :knowledge-point/title "Finding a Row Operation That's Equivalent To Left Multiplication by an Elementary Matrix"} :step/id #uuid "7c86254d-65d6-53f5-80cb-058b8e3bc172" :step/math-academy-id 17227 :step/next {:db/id #edb/ref 17592186116131}} {:db/id #edb/ref 17592186116131 :step/content {:db/id #edb/ref 17592186115247 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115076 :question/id #uuid "9927d1a6-a119-5987-9f49-5171a3f2e2d3" :question/math-academy-id "e-4721"} :knowledge-point/id #uuid "94c2cd65-810b-52ad-a20d-7b5a0a9eaf2b" :knowledge-point/questions [{:db/id #edb/ref 17592186115741} {:db/id #edb/ref 17592186115845} {:db/id #edb/ref 17592186265987} {:db/id #edb/ref 17592186265988} {:db/id #edb/ref 17592186265989} {:db/id #edb/ref 17592186265990} {:db/id #edb/ref 17592186265991}] :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Given Row Operation"} :step/id #uuid "3eb5a2ce-3bcb-5884-a872-6bd15f8824da" :step/math-academy-id 17228 :step/next {:db/id #edb/ref 17592186116132}} {:db/id #edb/ref 17592186116132 :step/content {:db/id #edb/ref 17592186115248 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115077 :question/id #uuid "0f08f8aa-63e3-500a-987e-e9888b9b0479" :question/math-academy-id "e-4722"} :knowledge-point/id #uuid "5c6f890b-fab1-51f1-9ac7-b680553c835a" :knowledge-point/questions [{:db/id #edb/ref 17592186115843} {:db/id #edb/ref 17592186115844} {:db/id #edb/ref 17592186265995} {:db/id #edb/ref 17592186265996} {:db/id #edb/ref 17592186265997} {:db/id #edb/ref 17592186299840}] :knowledge-point/title "Finding a Matrix Product That's Equivalent To a Sequence of Row Operations"} :step/id #uuid "5a0e9919-2a74-5681-a749-2ab1434ad705" :step/math-academy-id 17229}] :activity/title "Row Operations on 2x2 Matrices as Products of Elementary Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115473}]}
