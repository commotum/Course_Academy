5417] [17592186497244 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186497244 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186497244 #edb/ref 1078 #edb/ref 17592186497037 #edb/ref 17592186045417] [17592186497244 #edb/ref 1079 #uuid "3d913041-76e7-5e6e-a8c0-9a8b344b6d06" #edb/ref 17592186045417] [17592186497262 #edb/ref 1075 #edb/ref 17592186496861 #edb/ref 17592186045417] [17592186497262 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186497262 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186497262 #edb/ref 1078 #edb/ref 17592186496861 #edb/ref 17592186045417] [17592186497262 #edb/ref 1079 #uuid "624d06da-e063-516f-b272-d7b29fea68c7" #edb/ref 17592186045417] [17592186497353 #edb/ref 1068 #edb/ref 17592186497262 #edb/ref 17592186045417] [17592186497353 #edb/ref 1069 "q-334970" #edb/ref 17592186045417] [17592186497353 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186497353 #edb/ref 1071 "Given that $J(t)={\\int }_{0}^{1}(3x-\\operatorname{cos}⁡(t))^{2}\\,\\text{d}x,$ calculate ${J}^{′}(t)$ for $t\\in R$ by differentiating under the integral sign.\n\n${J}^{′}(t)=\\operatorname{sin}⁡t(\\,$\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186497353 #edb/ref 1072 #uuid "41d2dc29-ff79-5299-80eb-91a0d11f7713" #edb/ref 17592186045417] [17592186497353 #edb/ref 1074 "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as differentiating under the integral sign.\n\nWe wish to compute ${J}^{′}(t),$ where\n\n$$\nJ(t)={\\int }_{0}^{1}(3x-\\operatorname{cos}⁡(t))^{2}\\,\\text{d}x.\n$$\n\nDifferentiating under the integral sign, we get\n\n$$\n{J}^{′}(t)={\\int }_{0}^{1}\\frac{∂}{∂t}[(3x-\\operatorname{cos}⁡(t))^{2}]\\,\\text{d}x.\n$$\n\nNext, let's compute the partial derivative with respect to $t$:\n\n$$\n\\begin{aligned}\\frac{∂}{∂t}[(3x-\\operatorname{cos}⁡(t))^{2}] & =2(3x-\\operatorname{cos}⁡(t))\\cdot \\frac{∂}{∂t}(3x-\\operatorname{cos}⁡(t)) \\\\  & =2(3x-\\operatorname{cos}⁡(t))\\cdot \\operatorname{sin}⁡(t) \\\\  & =2\\operatorname{sin}⁡(t)(3x-\\operatorname{cos}⁡(t))\\end{aligned}\n$$\n\nSubstituting this back into our integral, we get\n\n$$\n\\begin{aligned}{J}^{′}(t) & ={\\int }_{0}^{1}2\\operatorname{sin}⁡(t)(3x-\\operatorname{cos}⁡(t))\\,\\text{d}x \\\\  & =2\\operatorname{sin}⁡(t){\\int }_{0}^{1}(3x-\\operatorname{cos}⁡(t))\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, let's evaluate the remaining integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(3x-\\operatorname{cos}⁡(t))\\,\\text{d}x & ={\\int }_{0}^{1}3x\\,\\text{d}x-{\\int }_{0}^{1}\\operatorname{cos}⁡(t)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}}{2}{|}_{0}^{1}-\\operatorname{cos}⁡(t)\\cdot x{|}_{0}^{1} \\\\  & =\\frac{3}{2}-\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{J}^{′}(t) & =2\\operatorname{sin}⁡(t)(\\frac{3}{2}-\\operatorname{cos}⁡(t)) \\\\  & =\\operatorname{sin}⁡(t)(3-2\\operatorname{cos}⁡(t)).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186497372 #edb/ref 1068 #edb/ref 17592186497244 #edb/ref 17592186045417] [17592186497372 #edb/ref 1069 "q-352889" #edb/ref 17592186045417] [17592186497372 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186497372 #edb/ref 1071 "Given that $K(t)={\\int }_{-1}^{1}(x+\\operatorname{cos}⁡(t))^{3}\\,\\text{d}x,$ calculate ${K}^{′}(t)$ for $t\\in R$ by differentiating under the integral sign.\n\n${K}^{′}(t)=-2\\operatorname{sin}⁡(t)(\\,$\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186497372 #edb/ref 1072 #uuid "74d3e4f5-83dd-544e-8625-a8bd48421738" #edb/ref 17592186045417] [17592186497372 #edb/ref 1074 "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as differentiating under the integral sign.\n\nWe wish to compute ${K}^{′}(t),$ where\n\n$$\nK(t)={\\int }_{-1}^{1}(x+\\operatorname{cos}⁡(t))^{3}\\,\\text{d}x.\n$$\n\nDifferentiating under the integral sign, we get\n\n$$\n{K}^{′}(t)={\\int }_{-1}^{1}\\frac{∂}{∂t}[(x+\\operatorname{cos}⁡(t))^{3}]\\,\\text{d}x.\n$$\n\nNext, let's compute the partial derivative with respect to $t$:\n\n$$\n\\begin{aligned}\\frac{∂}{∂t}[(x+\\operatorname{cos}⁡(t))^{3}] & =3(x+\\operatorname{cos}⁡(t))^{2}\\cdot \\frac{∂}{∂t}(x+\\operatorname{cos}⁡(t)) \\\\  & =3(x+\\operatorname{cos}⁡(t))^{2}\\cdot (-\\operatorname{sin}⁡(t)) \\\\  & =-3(x+\\operatorname{cos}⁡(t))^{2}\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nSubstituting this back into our integral, we get\n\n$$\n\\begin{aligned}{K}^{′}(t) & ={\\int }_{-1}^{1}-3(x+\\operatorname{cos}⁡(t))^{2}\\operatorname{sin}⁡(t)\\,\\text{d}x \\\\  & =-3\\operatorname{sin}⁡(t){\\int }_{-1}^{1}(x+\\operatorname{cos}⁡(t))^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, let's evaluate the remaining integral. We first expand the squared term:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}(x+\\operatorname{cos}⁡(t))^{2}\\,\\text{d}x & ={\\int }_{-1}^{1}({x}^{2}+2x\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t))\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{3}{|}_{-1}^{1}+{x}^{2}\\operatorname{cos}⁡(t){|}_{-1}^{1}+x{cos}^{2}⁡(t){|}_{-1}^{1} \\\\  & =(\\frac{1}{3}-(-\\frac{1}{3}))+(\\operatorname{cos}⁡(t)-\\operatorname{cos}⁡(t))+({cos}^{2}⁡(t)-(-{cos}^{2}⁡(t))) \\\\  & =\\frac{2}{3}+2{cos}^{2}⁡(t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{K}^{′}(t) & =-3\\operatorname{sin}⁡(t)\\cdot (\\frac{2}{3}+2{cos}^{2}⁡(t)) \\\\  & =-2\\operatorname{sin}⁡(t)(1+3{cos}^{2}⁡(t)).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186497438 #edb/ref 1062 #uuid "5f1e8c45-aac6-55f1-8386-0597586bbb27" #edb/ref 17592186045417] [17592186497438 #edb/ref 1063 #edb/ref 17592186497372 #edb/ref 17592186045417] [17592186497445 #edb/ref 1058 #edb/ref 17592186497438 #edb/ref 17592186045417] [17592186497445 #edb/ref 1062 #uuid "6b9aec71-5349-5890-880d-e9cca6269db7" #edb/ref 17592186045417] [17592186497445 #edb/ref 1063 #edb/ref 17592186320721 #edb/ref 17592186045417] [17592186497451 #edb/ref 1058 #edb/ref 17592186497488 #edb/ref 17592186045417] [17592186497451 #edb/ref 1062 #uuid "7fea924a-9132-5c8e-8405-bb171905179c" #edb/ref 17592186045417] [17592186497451 #edb/ref 1063 #edb/ref 17592186311557 #edb/ref 17592186045417] [17592186497478 #edb/ref 1058 #edb/ref 17592186497451 #edb/ref 17592186045417] [17592186497478 #edb/ref 1062 #uuid "d4624cb3-279b-58e4-be04-71f50c9f1d95" #edb/ref 17592186045417] [17592186497478 #edb/ref 1063 #edb/ref 17592186497353 #edb/ref 17592186045417] [17592186497488 #edb/ref 1058 #edb/ref 17592186497445 #edb/ref 17592186045417] [17592186497488 #edb/ref 1062 #uuid "fdb087f1-efc2-5793-8940-c3ea24f5ca43" #edb/ref 17592186045417] [17592186497488 #edb/ref 1063 #edb/ref 17592186311558 #edb/ref 17592186045417]}
