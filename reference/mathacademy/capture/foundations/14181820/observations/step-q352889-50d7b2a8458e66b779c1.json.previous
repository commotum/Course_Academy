e-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"28\"><span mathquill-command-id=\"30\">1</span><span mathquill-command-id=\"32\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"34\">3</span><var mathquill-command-id=\"37\" class=\"mq-operator-name mq-first\">c</var><var mathquill-command-id=\"38\" class=\"mq-operator-name\">o</var><var mathquill-command-id=\"39\" class=\"mq-operator-name\">s</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"41\"><span class=\"mq-sup\" mathquill-block-id=\"43\"><span mathquill-command-id=\"42\">2</span></span></span><span mathquill-command-id=\"45\">(</span><var mathquill-command-id=\"47\">t</var><span mathquill-command-id=\"49\">)</span></span></div></div><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"134\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c29 TEX-S2\"></mjx-c></mjx-mo></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow></math></mjx-assistive-mml></mjx-container></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/correct-answer.svg\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>Suppose <mjx-container class=\"MathJax CtxtM