1}{7}) \\\\  & ≈0.1999.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490274 :knowledge-point/_questions [{:db/id #edb/ref 17592186166829 :knowledge-point/id #uuid "c566525f-9b0f-586f-ba60-277400cb25dd" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Not Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d5ee62-aa42-5f01-b4a5-ab74deed7fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0632" :db/id #edb/ref 17592186489531} {:answer/id #uuid "1a06965d-e607-5ac2-8527-8aaf4db45332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0764" :db/id #edb/ref 17592186489572} {:answer/id #uuid "396ef0a9-9da4-597c-a198-387695bd64a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0583" :db/id #edb/ref 17592186489643} {:answer/id #uuid "c470e502-58aa-5ad8-9844-68f75a95a94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0423" :db/id #edb/ref 17592186489941} {:answer/id #uuid "c57a8780-ca2e-5b63-8e36-e20cefc4f686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0299" :db/id #edb/ref 17592186489942}] :answer-field/correct {:answer/id #uuid "1a06965d-e607-5ac2-8527-8aaf4db45332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0764" :db/id #edb/ref 17592186489572} :answer-field/id #uuid "cf820629-906a-5c04-b58a-8d824afc8c32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89650cb6-ad4a-5818-b55e-8a9dde9d78b4" :question/math-academy-id "q-97164" :question/problem "Given that $X∼\\text{Geom}(\\frac{5}{12}),$ compute $P(4<X<7)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{12}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{7}{12})}^{x-1}(\\frac{5}{12}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(4<X<7) & =P(X\\in \\{5,6\\}) \\\\  & =P(X=5)+P(X=6) \\\\  & =f(5)+f(6) \\\\  & ={(\\frac{7}{12})}^{4}(\\frac{5}{12})+{(\\frac{7}{12})}^{5}(\\frac{5}{12}) \\\\  & ≈0.0764.\\end{aligned}\n$$"}]}
