er.type/math} :answer/value "0.7458" :db/id #edb/ref 17592186489612} {:answer/id #uuid "4fd3f597-cc5c-5239-86c5-defc4c2266c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7599" :db/id #edb/ref 17592186489705} {:answer/id #uuid "a2ba8a60-87e0-51ed-982c-b93a5714686d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7524" :db/id #edb/ref 17592186489876} {:answer/id #uuid "f1dcd0da-5e77-5501-a9b5-177d314a7506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7697" :db/id #edb/ref 17592186490034} {:answer/id #uuid "f8905f57-9f77-5e1f-b352-689e47d528c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7423" :db/id #edb/ref 17592186490055}] :answer-field/correct {:answer/id #uuid "4fd3f597-cc5c-5239-86c5-defc4c2266c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7599" :db/id #edb/ref 17592186489705} :answer-field/id #uuid "304c509f-2d66-5c40-a356-df8a6e57df6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490098}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c144938-ebf0-5b6b-9305-5aba70df7465" :question/math-academy-id "q-97139" :question/problem "Given $X∼\\text{Geom}(0.3),$ compute $P(X\\le 4).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.3),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.7)}^{x-1}(0.3), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(0.7)}^{0}(0.3)+{(0.7)}^{1}(0.3)+{(0.7)}^{2}(0.3)+{(0.7)}^{3}(0.3) \\\\  & =0.7599.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490275 :knowledge-point/_questions [{:db/id #edb/ref 17592186166828 :knowledge-point/id #uuid "120381af-c472-5894-8b19-da2ab61d3a7e" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e61986c-1bf7-5712-b5e5-d12935d819f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9922" :db/id #edb/ref 17592186489546} {:answer/id #uuid "801c1472-5fd9-5531-9c62-b1ea7f3abd78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9941" :db/id #edb/ref 17592186489805} {:answer/id #uuid "a1c67e72-8554-5beb-874f-3052776e6978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9999" :db/id #edb/ref 17592186489872} {:answer/id #uuid "e8a44484-9265-587b-90a8-bf1e9b126b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9871" :db/id #edb/ref 17592186490020} {:answer/id #uuid "fcde2033-8315-57fd-827e-5ac2e8735311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9985" :db/id #edb/ref 17592186490066}] :answer-field/correct {:answer/id #uuid "a1c67e72-8554-5beb-874f-3052776e6978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9999" :db/id #edb/ref 17592186489872} :answer-field/id #uuid "ded0bdeb-142c-521f-88f6-19ac261fa95d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "976a3fe7-7c3e-53a0-9a3a-1795aa3e30b7" :question/math-academy-id "q-97142" :question/problem "Given $X∼\\text{Geom}(0.95),$ compute $P(X<4).$  Round your final answer to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.95),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.05)}^{x-1}(0.95), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in \\{1,2,3\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(0.05)}^{0}(0.95)+{(0.05)}^{1}(0.95)+{(0.05)}^{2}(0.95) \\\\  & ≈0.9999.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490229 :knowledge-point/_questions [{:db/id #edb/ref 17592186166829 :knowledge-point/id #uuid "c566525f-9b0f-586f-ba60-277400cb25dd" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Not Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7a9138-e3f2-59f5-a659-d453de3f4659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0056" :db/id #edb/ref 17592186489584} {:answer/id #uuid "3fc3ec47-e3b7-5812-9ccd-1ec442151913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0017" :db/id #edb/ref 17592186489661} {:answer/id #uuid "bf3ed638-83db-5fce-82cc-aa5c28d1a61f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0005" :db/id #edb/ref 17592186489931} {:answer/id #uuid "cef9b7ec-254a-5349-b752-4905e271220e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0012" :db/id #edb/ref 17592186489973} {:answer/id #uuid "fa1f0722-af81-5137-879e-0be71580c8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0087" :db/id #edb/ref 17592186490059}] :answer-field/correct {:answer/id #uuid "3fc3ec47-e3b7-5812-9ccd-1ec442151913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0017" :db/id #edb/ref 17592186489661} :answer-field/id #uuid "10c44bd4-e5a8-53e6-878a-f99c376f2371" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490081}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f7bb618-1c74-5b28-8d56-423cfe55dc4d" :question/math-academy-id "q-97152" :question/problem "Given that $X∼\\text{Geom}(0.72),$ compute $P(6\\le X\\le 10)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.72),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.28)}^{x-1}(0.72), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(6\\le X\\le 10) & =P(X\\in \\{6,7,8,9,10\\}) \\\\  & =P(X=6)+P(X=7)+P(X=8)+P(X=9)+P(X=10) \\\\  & =f(6)+f(7)+f(8)+f(9)+f(10) \\\\  & ={(0.28)}^{5}(0.72)+{(0.28)}^{6}(0.72)+{(0.28)}^{7}(0.72)+{(0.28)}^{8}(0.72)+{(0.28)}^{9}(0.72) \\\\  & ≈0.0017.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186490255 :knowledge-point/_questions [{:db/id #edb/ref 17592186166829 :knowledge-point/id #uuid "c566525f-9b0f-586f-ba60-277400cb25dd" :knowledge-point/title "Computing a Probability Over a Bounded Interval: Lower Bound is Not Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03707761-65ce-5e18-9eca-bdcf476813eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1905" :db/id #edb/ref 17592186489522} {:answer/id #uuid "3ed878e3-0f93-5c46-9db6-c4306f74717d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/