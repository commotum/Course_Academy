29-5780-914b-ea52f01a197f" #edb/ref 17592186045417] [17592186050654 #edb/ref 1027 #edb/ref 17592186048242 #edb/ref 17592186045417] [17592186050654 #edb/ref 1027 #edb/ref 17592186048956 #edb/ref 17592186045417] [17592186050654 #edb/ref 1028 #edb/ref 17592186162032 #edb/ref 17592186045417] [17592186050654 #edb/ref 1028 #edb/ref 17592186162033 #edb/ref 17592186045417] [17592186050654 #edb/ref 1028 #edb/ref 17592186162034 #edb/ref 17592186045417] [17592186050654 #edb/ref 1028 #edb/ref 17592186162035 #edb/ref 17592186045417] [17592186050654 #edb/ref 1031 "The Negative Binomial Distribution" #edb/ref 17592186045417] [17592186050654 #edb/ref 1033 3072 #edb/ref 17592186045417] [17592186050654 #edb/ref 1035 #uuid "5cdf16c4-ae0c-5595-b17b-ae501641af3c" #edb/ref 17592186045417] [17592186050757 #edb/ref 1027 #edb/ref 17592186050305 #edb/ref 17592186045417] [17592186050757 #edb/ref 1027 #edb/ref 17592186050654 #edb/ref 17592186045417] [17592186050757 #edb/ref 1028 #edb/ref 17592186166827 #edb/ref 17592186045417] [17592186050757 #edb/ref 1028 #edb/ref 17592186166828 #edb/ref 17592186045417] [17592186050757 #edb/ref 1028 #edb/ref 17592186166829 #edb/ref 17592186045417] [17592186050757 #edb/ref 1028 #edb/ref 17592186166830 #edb/ref 17592186045417] [17592186050757 #edb/ref 1029 #edb/ref 17592186428995 #edb/ref 17592186045436] [17592186050757 #edb/ref 1031 "The Geometric Distribution" #edb/ref 17592186045417] [17592186050757 #edb/ref 1033 3284 #edb/ref 17592186045417] [17592186050757 #edb/ref 1034 1.1520553396310114 #edb/ref 17592186045436] [17592186050757 #edb/ref 1035 #uuid "643ac99b-01f2-533f-b1bc-9babbc0cef82" #edb/ref 17592186045417] [17592186166665 #edb/ref 1069 "e-8553" #edb/ref 17592186045417] [17592186166665 #edb/ref 1071 "Given $X \\sim \\textrm{Geom}\\left(\\dfrac{2}{3}\\right),$ compute $P(X = 3).$" #edb/ref 17592186045417] [17592186166665 #edb/ref 1072 #uuid "e3df676d-e1cc-584e-8b14-a6191a8d6831" #edb/ref 17592186045417] [17592186166665 #edb/ref 1074 "If $X \\sim \\textrm{Geom}(p),$ then $X$ has the following probability mass function:\n\n![](images/59/5973b712a92cadd7bc301f7e8e859a1a53a551cfeee0b0ac1404ddbfc352ac56.png)\n\nHere, $X \\sim \\textrm{Geom}\\left(\\dfrac{2}{3}\\right),$ so the distribution of $X$ in this case is\n\n![](images/a7/a7c5af2adc67390439a5d46933083b796c30fc55f0f1f5ff8cd9d374a905695d.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & ={(\\frac{1}{3})}^{2}(\\frac{2}{3}) \\\\  & =\\frac{2}{27}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166666 #edb/ref 1069 "e-8554" #edb/ref 17592186045417] [17592186166666 #edb/ref 1071 "Given $X \\sim \\textrm{Geom}\\left(\\dfrac 37\\right),$ compute $P(X < 5).$" #edb/ref 17592186045417] [17592186166666 #edb/ref 1072 #uuid "f795e566-5cdf-5970-bf94-5b1c838b69f1" #edb/ref 17592186045417] [17592186166666 #edb/ref 1074 "If $X \\sim \\textrm{Geom}(p),$ then $X$ has the following probability mass function:\n\n![](images/e3/e31c12bf515605c7cb46d96a55a8e2a3cab7eaeb5897bb04cfbe87d4d6cc6875.png)\n\nHere, $X \\sim \\textrm{Geom}\\left(\\dfrac 37\\right),$ so the distribution of $X$ in this case is\n\n![](images/5e/5e7f6f2abab85141723e1ef5bd97157968584623433cd5a3e4d0454a39ef000b.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in {1,2,3,4}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(\\frac{4}{7})}^{0}(\\frac{3}{7})+{(\\frac{4}{7})}^{1}(\\frac{3}{7})+{(\\frac{4}{7})}^{2}(\\frac{3}{7})+{(\\frac{4}{7})}^{3}(\\frac{3}{7}) \\\\  & ≈0.893\\end{aligned}\n$$\n\nto  $3$ decimal places." #edb/ref 17592186045417] [17592186166667 #edb/ref 1069 "e-8555" #edb/ref 17592186045417] [17592186166667 #edb/ref 1071 "Given that $X \\sim \\textrm{Geom}\\left(\\dfrac 15\\right),$ compute $P(2 \\leq X \\leq 3).$" #edb/ref 17592186045417] [17592186166667 #edb/ref 1072 #uuid "c23e8b4a-dad2-5c6a-95ee-2a439343ded0" #edb/ref 17592186045417] [17592186166667 #edb/ref 1074 "If $X \\sim \\textrm{Geom}(p),$ then $X$ has the following probability mass function:\n\n![](images/e3/e31c12bf515605c7cb46d96a55a8e2a3cab7eaeb5897bb04cfbe87d4d6cc6875.png)\n\nHere, $X \\sim \\textrm{Geom}\\left(\\dfrac 15\\right),$ so the distribution of $X$ in this case is\n\n![](images/cb/cb4d54529b778e27c44ea6611a366eef6e540d9de5343e3425797f03d51c54de.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(2\\le X\\le 3) & =P(X\\in {2,3}) \\\\  & =P(X=2)+P(X=3) \\\\  & =f(2)+f(3) \\\\  & ={(\\frac{4}{5})}^{1}(\\frac{1}{5})+{(\\frac{4}{5})}^{2}(\\frac{1}{5}) \\\\  & =\\frac{36}{125}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166668 #edb/ref 1069 "e-8556" #edb/ref 17592186045417] [17592186166668 #edb/ref 1071 "Given $X \\sim \\textrm{Geom}\\left(\\dfrac 56\\right),$ compute $P(X > 2).$" #edb/ref 17592186045417] [17592186166668 #edb/ref 1072 #uuid "c798d6ea-a258-5a73-8cd2-366e1b3e9db0" #edb/ref 17592186045417] [17592186166668 #edb/ref 1074 "If $X \\sim \\textrm{Geom}(p),$ then $X$ has the following probability mass function:\n\n![](images/ab/ab3f034397a81b2369008754aef3c05f998f180b5127e543a05ab408c743cf8a.png)\n\nHere, $X \\sim \\textrm{Geom}\\left(\\dfrac 56\\right),$ so the distribution of $X$ in this case is\n\n![](images/ef/efc7a45d9b19867340454ad32abe129214dcca021394f259f79d1e26643da5c7.png)\n\nThere are infinitely many values of $X$ such that $X > 2.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>2) & =1-P(X\\le 2)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in {1,2}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{1}{6})}^{0}(\\frac{5}{6})+{(\\frac{1}{6})}^{1}(\\frac{5}{6}) \\\\  & =\\frac{35}{36}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>2) & =1-P(X\\le 2) \\\\  & =1-\\frac{35}{36} \\\\  & =\\frac{1}{36}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166827 #edb/ref 1037 #edb/ref 17592186048368 #edb/ref 17592186045417] [17592186166827 #edb/ref 1038 #edb/ref 17592186167475 #edb/ref 17592186045417] [1