 "78b84216-c188-5769-a0cf-2f3c4b5d4fe1" #edb/ref 17592186045417] [17592186402864 #edb/ref 1080 "$|A|$ and $|C|$ only" #edb/ref 17592186045417] [17592186402864 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402864 #edb/ref 1083 #uuid "47a2ba38-2156-5dd9-922d-70e7a9112796" #edb/ref 17592186045417] [17592186402865 #edb/ref 1080 "$|C|$ only" #edb/ref 17592186045417] [17592186402865 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402865 #edb/ref 1083 #uuid "bf232768-62b0-5a99-b6ae-c2f1d1ac4e96" #edb/ref 17592186045417] [17592186402866 #edb/ref 1080 "$|A|$ only" #edb/ref 17592186045417] [17592186402866 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402866 #edb/ref 1083 #uuid "5c171a58-43ca-5ac8-896f-be2e38df60c5" #edb/ref 17592186045417] [17592186402867 #edb/ref 1080 "$|A|$ and $|B|$ only" #edb/ref 17592186045417] [17592186402867 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402867 #edb/ref 1083 #uuid "75bb085b-9153-5df0-9e32-3ce23b5de8fb" #edb/ref 17592186045417] [17592186402868 #edb/ref 1068 #edb/ref 17592186402869 #edb/ref 17592186045417] [17592186402868 #edb/ref 1069 "q-43058" #edb/ref 17592186045417] [17592186402868 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186402868 #edb/ref 1071 "Which of the following determinants are equal to $0?$\n\n$$\n|A|=|\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}|,\\,|B|=|\\begin{aligned}2 & 0 & 0 \\\\ 2 & -5 & 0 \\\\ 1 & -\\sqrt{3} & 4\\end{aligned}|,\\,|C|=|\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}|.\n$$" #edb/ref 17592186045417] [17592186402868 #edb/ref 1072 #uuid "56c75f73-8006-5c39-8150-6ad119a3d555" #edb/ref 17592186045417] [17592186402868 #edb/ref 1074 "Let's examine each of the given determinants in turn.\n\n- The matrix $A$ has a zero row: \n\n$$\nA=[\\begin{aligned}\\sqrt{3} & 5 & -1 \\\\ 4 & -3 & 8 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nAs a result, $|A|=0.$\n\n- The matrix $B$ is a triangular matrix, hence \n\n$$\n|B|=2\\cdot (-5)\\cdot 4=-40\\ne 0.\n$$\n\n- The matrix $C$ has proportional columns: \n\n$$\nC=[\\begin{aligned}-2 & 4 & -1 \\\\ 6 & \\sqrt{3} & 3 \\\\ -4 & \\sqrt{7} & -2\\end{aligned}]\n$$\n\nAs a result, $|C|=0.$\n\nTherefore, only $|A|$ and $|C|$ are equal to $0.$" #edb/ref 17592186045417] [17592186402869 #edb/ref 1075 #edb/ref 17592186402870 #edb/ref 17592186045417] [17592186402869 #edb/ref 1075 #edb/ref 17592186402871 #edb/ref 17592186045417] [17592186402869 #edb/ref 1075 #edb/ref 17592186402872 #edb/ref 17592186045417] [17592186402869 #edb/ref 1075 #edb/ref 17592186402873 #edb/ref 17592186045417] [17592186402869 #edb/ref 1075 #edb/ref 17592186402874 #edb/ref 17592186045417] [17592186402869 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186402869 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186402869 #edb/ref 1078 #edb/ref 17592186402871 #edb/ref 17592186045417] [17592186402869 #edb/ref 1079 #uuid "2d0cbd0e-5f98-5252-aa48-893e93a173fa" #edb/ref 17592186045417] [17592186402870 #edb/ref 1080 "$|B|$ and $|C|$ only" #edb/ref 17592186045417] [17592186402870 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402870 #edb/ref 1083 #uuid "665b8959-619e-56ef-8580-a1cb1e4b9558" #edb/ref 17592186045417] [17592186402871 #edb/ref 1080 "$|A|$ and $|C|$ only" #edb/ref 17592186045417] [17592186402871 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402871 #edb/ref 1083 #uuid "64b8f243-2c7b-510f-ba0f-db94cf33bd62" #edb/ref 17592186045417] [17592186402872 #edb/ref 1080 "$|C|$ only" #edb/ref 17592186045417] [17592186402872 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402872 #edb/ref 1083 #uuid "d613850c-c563-547d-bf3d-1ebbc2fd8f08" #edb/ref 17592186045417] [17592186402873 #edb/ref 1080 "$|A|$ only" #edb/ref 17592186045417] [17592186402873 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref