#{[{:activity/course {:db/id #edb/ref 17592186046665} :activity/first-step {:db/id #edb/ref 17592186407956} :activity/id #uuid "dae6af1c-a643-55d8-9eb3-cb620d5edf1b" :activity/scope {:db/id #edb/ref 17592186050270 :topic/id #uuid "3ab583b8-5390-5f48-b28b-1a89db70664f" :topic/math-academy-id 2152} :activity/steps [{:db/id #edb/ref 17592186407956 :step/content {:db/id #edb/ref 17592186323936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022db7d6-74f8-5b70-953b-f7307b30d216" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}" :db/id #edb/ref 17592186321173} {:answer/id #uuid "bfcc41a0-cba5-52a7-ad10-f699b98332a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi }{4}-\\operatorname{ln}⁡2+1" :db/id #edb/ref 17592186322644} {:answer/id #uuid "e0694915-fef8-5ca3-bf30-944201a25f5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi }{4}+\\frac{1}{2}\\,\\operatorname{ln}⁡2-1" :db/id #edb/ref 17592186322908} {:answer/id #uuid "f6ee1da1-9032-5800-bb77-448b86b619a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi }{2}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" :db/id #edb/ref 17592186323090} {:answer/id #uuid "f799216a-905a-5238-a6c7-d799f6ea154d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" :db/id #edb/ref 17592186323098}] :answer-field/correct {:db/id #edb/ref 17592186323098} :answer-field/id #uuid "1fcad131-34ae-5ed3-80c6-2f5bcfe38d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323234}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aab883d4-1f11-56e3-bc34-cc7b53210399" :question/math-academy-id "q-37685" :question/problem "Calculate ${\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy.$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[{\\int }_{y}^{1}dx]\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[x]_{y}^{1}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}(1-y)\\,dy \\\\  & ={\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy & ={[\\operatorname{arctan}⁡y-\\frac{\\operatorname{ln}⁡(1+{y}^{2})}{2}]}_{0}^{1} \\\\  & =(\\operatorname{arctan}⁡1-\\frac{\\operatorname{ln}⁡(1+{1}^{2})}{2}-(\\operatorname{arctan}⁡0-\\frac{\\operatorname{ln}⁡(1+{0}^{2})}{2})) \\\\  & =\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2\\end{aligned}\n$$"} :step/id #uuid "04ef475a-c5cf-51ff-ad2a-7ea0479c4f76" :step/next {:db/id #edb/ref 17592186407960}} {:db/id #edb/ref 17592186407957 :step/content {:db/id #edb/ref 17592186407953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f195090-3d93-59e1-afd9-0a582f1e9403" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{\\int }_{0}^{2}[{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy" :db/id #edb/ref 17592186407931} {:answer/id #uuid "21e012b2-7e2a-55b3-9d7c-1a341837e391" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{\\int }_{0}^{8-{y}^{2}}[{\\int }_{{y}^{2}}^{2}\\operatorname{ln}⁡(xy)\\,dx]dy" :db/id #edb/ref 17592186407932} {:answer/id #uuid "2bdf210e-55ed-5de9-80fd-b8bc3c6300fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{\\int }_{0}^{2}[{\\int }_{8-{y}^{2}}^{{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy" :db/id #edb/ref 17592186407933} {:answer/id #uuid "f8af2e6f-7f53-52a5-b469-925f72fac328" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{\\int }_{{y}^{2}}^{8-{y}^{2}}[{\\int }_{0}^{2}\\operatorname{ln}⁡(xy)\\,dx]dy" :db/id #edb/ref 17592186407947} {:answer/id #uuid "f9c41421-3be2-50e8-9e6b-0a900263854c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{\\int }_{0}^{{y}^{2}}[{\\int }_{2}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy" :db/id #edb/ref 17592186407948}] :answer-field/correct {:db/id #edb/ref 17592186407931} :answer-field/id #uuid "90293907-fe9e-585f-8155-9888c4d916c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407950}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "60195b0c-70fb-5843-93ba-a36d5b0f7537" :question/math-academy-id "q-81292" :question/problem "![](images/df/df3acf049579ec4de948d84d04d4fe3012c2232b9699d0471857227f52c78107.png)\n\nIf $D$ is the finite region enclosed by the curves $x={y}^{2},\\,$ $x=8-{y}^{2},$ and $y=0,$ as shown above, then ${∬}_{D}\\operatorname{ln}⁡(xy)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}8-{y}^{2} & ={y}^{2} \\\\ 8 & =2{y}^{2} \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nSo, $y$-limits are \n$0\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/27/2722224678aeb1f9ea64f42de2dc4fbf6e139350c291de16500957575fd23850.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 2,\\,{y}^{2}\\le x\\le 8-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\operatorname{ln}⁡(xy)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy\\end{aligned}\n$$"} :step/id #uuid "1ac49a49-1255-59a8-8c4e-cccd1b1d9a34" :step/next {:db/id #edb/ref 17592186407958}} {:db/id #edb/ref 17592186407958 :step/content {:db/id #edb/ref 17592186407955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "407ad84e-74ca-5fc0-921f-8337eef03b66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186407935} {:answer/id #uuid "9b8add82-176b-5127-abc9-008b7fd4cd65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186407940} {:answer/id #uuid "d2256d50-cc9a-51f4-9bdc-9c4c49897e53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-3" :db/id #edb/ref 17592186407944} {:answer/id #uuid "d506fb6b-f38e-52d5-99c9-4337a51aff70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186407945} {:answer/id #uuid "f68c810b-465d-52e2-9a5e-049c583ea1a7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186407946}] :answer-field/correct {:db/id #edb/ref 17592186407946} :answer-field/id #uuid "34f449e1-fb1a-5a4b-9b02-dc697805a6ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407949}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af73e85d-c908-5a06-97f4-04484193b6c1" :question/math-academy-id "q-81390" :question/problem "![](images/1b/1b03f2ecd03a89d9484e7d28ab4cb34656b288c3a4554c9a4eeacbe9b61f692c.png)\n\nEvaluate the double integral ${∬}_{D}x\\,dA,\\,$\nwhere $D$ is the region enclosed between the curves ${x}^{2}+{y}^{2}=4$ and $y=2-x,$ above the line $y=1,$ as shown in the picture." :question/worked-solution "Notice that $D$ is a type II region. Since $x\\ge 0,$ we obtain the following equations in terms of $y:$\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=4 & \\,⟹\\,x=\\sqrt{4-{y}^{2}} \\\\ y=2-x & \\,⟹\\,x=2-y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{4-{y}^{2}} & =2-y \\\\ 4-{y}^{2} & =(2-y)^{2} \\\\ 4-{y}^{2} & =4-4y+{y}^{2} \\\\ 2{y}^{2}-4y & =0 \\\\ y(y-2) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the line $y=1,$ the $y$-limits are \n$1\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/f8/f8fedf15e26f64fc344bd7db6ffaa659bd7c130f36f4a39389b6108136836104.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 2,\\,2-y\\le x\\le \\sqrt{4-{y}^{2}}}.\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}x\\,dA={\\int }_{1}^{2}{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}\\,x\\,dx\\,dy\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}\\,x\\,dx\\,dy & ={\\int }_{1}^{2}[{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}x\\,dx]dy \\\\  & ={\\int }_{1}^{2}\\,\\frac{1}{2}[\\,{x}^{2}\\,]_{2-y}^{\\sqrt{4-{y}^{2}}}\\text{ }dy \\\\  & ={\\int }_{1}^{2}\\,\\frac{1}{2}(4-{y}^{2}-(2-y)^{2})dy \\\\  & ={\\int }_{1}^{2}\\,(2y-{y}^{2})dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\,(2y-{y}^{2})dy & ={[{y}^{2}-\\frac{{y}^{3}}{3}]}_{1}^{2} \\\\  & =(4-\\frac{8}{3})-(1-\\frac{1}{3}) \\\\  & =\\frac{2}{3}\\end{aligned}\n$$"} :step/id #uuid "6b60b51b-f512-550b-bd86-63bfa17217f5"} {:db/id #edb/ref 17592186407959 :step/content {:db/id #edb/ref 17592186134525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e8f08bf-1207-5b03-b3ef-9530cb2b5a3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e+\\frac{1}{e}" :db/id #edb/ref 17592186407936} {:answer/id #uuid "84cf6de9-7e2a-5324-b99e-6bcb99cb2037" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2e-\\frac{2}{e}" :db/id #edb/ref 17592186407937} {:answer/id #uuid "961f6414-5e96-5d6f-8c75-fea444892c6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e+\\frac{1}{e}-2" :db/id #edb/ref 17592186407939} {:answer/id #uuid "c4e79523-6046-58bb-bbff-c9138272412a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "{e}^{2}+\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186407942} {:answer/id #uuid "c58ab0f6-8f1f-5fab-87ce-c1f3defe9063" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e-2" :db/id #edb/ref 17592186407943}] :answer-field/correct {:db/id #edb/ref 17592186407939} :answer-field/id #uuid "c010f524-8a53-5bfa-911a-2af5f0f0f3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407951}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93a9e190-c192-5836-a0b9-91bcfd91a0ef" :question/math-academy-id "q-81197" :question/problem "Calculate ${∬}_{D}{e}^{x-y}\\,dA,$ where $D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 2y}.$" :question/worked-solution "The integral is defined over a type II region $D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 2y}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{x-y}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{2y}({e}^{x}\\cdot {e}^{-y})\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{2y}({e}^{x}\\cdot {e}^{-y})\\,dx\\,dy & ={\\int }_{0}^{1}{e}^{-y}[{\\int }_{0}^{2y}{e}^{x}\\,dx]dy \\\\  & ={\\int }_{0}^{1}{e}^{-y}[{e}^{x}]_{0}^{2y}\\,dy \\\\  & ={\\int }_{0}^{1}{e}^{-y}({e}^{2y}-{e}^{0})dy \\\\  & ={\\int }_{0}^{1}({e}^{y}-{e}^{-y})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({e}^{y}-{e}^{-y})\\,dy & =[{e}^{y}+{e}^{-y}]_{0}^{1} \\\\  & =({e}^{1}+{e}^{-1})-({e}^{0}+{e}^{0}) \\\\  & =e+\\frac{1}{e}-2\\end{aligned}\n$$"} :step/id #uuid "ac90c75a-a52d-53a2-be62-82bea3febc78" :step/next {:db/id #edb/ref 17592186407957}} {:db/id #edb/ref 17592186407960 :step/content {:db/id #edb/ref 17592186407954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a312eff-692f-5f36-add7-8d6f7a0791cb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186407929} {:answer/id #uuid "1deb603f-c9fd-595d-8f3d-42a462139aa4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\operatorname{cos}⁡(1)+1" :db/id #edb/ref 17592186407930} {:answer/id #uuid "32f8a409-127f-58c3-b517-447a5ac20acd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1-\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186407934} {:answer/id #uuid "8b2724c9-647b-522d-8e19-f98d5782dae8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\operatorname{sin}⁡(1)-1" :db/id #edb/ref 17592186407938} {:answer/id #uuid "b459c99e-957e-52e0-9bb4-92fd9e78c9d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\operatorname{sin}⁡(1)" :db/id #edb/ref 17592186407941}] :answer-field/correct {:db/id #edb/ref 17592186407934} :answer-field/id #uuid "ef9310b5-68fe-5622-806f-a4683ba15fec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407952}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6b2d2a45-1af2-5bb8-b665-008434b3075e" :question/math-academy-id "q-37855" :question/problem "${\\int }_{0}^{1}{\\int }_{0}^{y}\\operatorname{cos}⁡x\\,dx\\,dy=$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{y}\\operatorname{cos}⁡x\\,dx\\,dy & ={\\int }_{0}^{1}[{\\int }_{0}^{y}\\operatorname{cos}⁡x\\,dx]\\,dy \\\\  & ={\\int }_{0}^{1}[\\operatorname{sin}⁡x]_{0}^{y}\\,dy \\\\  & ={\\int }_{0}^{1}(\\operatorname{sin}⁡y-\\operatorname{sin}⁡0)\\,dy \\\\  & ={\\int }_{0}^{1}\\operatorname{sin}⁡y\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\operatorname{sin}⁡y\\,dy & =[-\\operatorname{cos}⁡y]_{0}^{1} \\\\  & =-\\operatorname{cos}⁡(1)-(-\\operatorname{cos}⁡(0)) \\\\  & =1-\\operatorname{cos}⁡(1)\\end{aligned}\n$$"} :step/id #uuid "e5e63a66-bea9-51c1-84d4-5364df4be361" :step/next {:db/id #edb/ref 17592186407959}}] :activity/title "Double Integrals Over Type II Regions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407928}]}
