b/ref 17592186134769 #edb/ref 17592186045585] [17592186134027 #edb/ref 1043 #edb/ref 17592186134770 #edb/ref 17592186045585] [17592186134027 #edb/ref 1043 #edb/ref 17592186134771 #edb/ref 17592186045585] [17592186134027 #edb/ref 1043 #edb/ref 17592186134772 #edb/ref 17592186045585] [17592186134027 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045585] [17592186134027 #edb/ref 1045 "Double Integrals Over Type II Regions" #edb/ref 17592186045585] [17592186134027 #edb/ref 1046 #edb/ref 17592186134767 #edb/ref 17592186045585] [17592186134027 #edb/ref 1049 #edb/ref 17592186050270 #edb/ref 17592186045585] [17592186134027 #edb/ref 1053 #uuid "912bbbc1-7dd5-5812-ba95-2d17ed90bd7e" #edb/ref 17592186045585] [17592186134525 #edb/ref 1068 #edb/ref 17592186133158 #edb/ref 17592186045585] [17592186134525 #edb/ref 1069 "q-81197" #edb/ref 17592186045585] [17592186134525 #edb/ref 1071 "Calculate $∬_(D)e^{x - y}dA$, where $D = {(x, y): 0 \\le y \\le 1, 0 \\le x \\le 2y}$." #edb/ref 17592186045585] [17592186134525 #edb/ref 1072 #uuid "93a9e190-c192-5836-a0b9-91bcfd91a0ef" #edb/ref 17592186045585] [17592186134767 #edb/ref 1058 #edb/ref 17592186134768 #edb/ref 17592186045585] [17592186134767 #edb/ref 1061 26243 #edb/ref 17592186045585] [17592186134767 #edb/ref 1062 #uuid "212536fd-085f-5bdf-babc-a919d333a568" #edb/ref 17592186045585] [17592186134767 #edb/ref 1063 #edb/ref 17592186135091 #edb/ref 17592186045585] [17592186134768 #edb/ref 1058 #edb/ref 17592186134769 #edb/ref 17592186045585] [17592186134768 #edb/ref 1061 26244 #edb/ref 17592186045585] [17592186134768 #edb/ref 1062 #uuid "cde6f31a-9259-5126-ab62-92a7120fde39" #edb/ref 17592186045585] [17592186134768 #edb/ref 1063 #edb/ref 17592186133844 #edb/ref 17592186045585] [17592186134769 #edb/ref 1058 #edb/ref 17592186134770 #edb/ref 17592186045585] [17592186134769 #edb/ref 1061 26245 #edb/ref 17592186045585] [17592186134769 #edb/ref 1062 #uuid "38689b31-f1db-5afc-801c-860cb6fc929b" #edb/ref 17592186045585] [17592186134769 #edb/ref 1063 #edb/ref 17592186133845 #edb/ref 17592186045585] [17592186134770 #edb/ref 1058 #edb/ref 17592186134771 #edb/ref 17592186045585] [17592186134770 #edb/ref 1061 26246 #edb/ref 17592186045585] [17592186134770 #edb/ref 1062 #uuid "6fd8b1b4-a45f-595a-b748-1d95ba70387d" #edb/ref 17592186045585] [17592186134770 #edb/ref 1063 #edb/ref 17592186135092 #edb/ref 17592186045585] [17592186134771 #edb/ref 1058 #edb/ref 17592186134772 #edb/ref 17592186045585] [17592186134771 #edb/ref 1061 26247 #edb/ref 17592186045585] [17592186134771 #edb/ref 1062 #uuid "97348c88-b232-5f44-bd21-15af51c5d116" #edb/ref 17592186045585] [17592186134771 #edb/ref 1063 #edb/ref 17592186133846 #edb/ref 17592186045585] [17592186134772 #edb/ref 1061 26248 #edb/ref 17592186045585] [17592186134772 #edb/ref 1062 #uuid "0d46d822-c664-59b7-8ccb-0874593592f6" #edb/ref 17592186045585] [17592186134772 #edb/ref 1063 #edb/ref 17592186133847 #edb/ref 17592186045585] [17592186135091 #edb/ref 1064 "How do we represent a double integral over a type II region as a repeated integral? \n\nSpecifically, let's consider\n\n$$\n\\displaystyle \\iint\\limits_D (x+2y) \\, \\textrm d A, \n%= \\int_a^b \\int_c^d (x+2y) \\,\\textrm d y\\, \\textrm d x,\n$$\n\nwhere $D$  is the finite region bounded by the lines $x=0,$ $y=0, y=1$ and the curve $x=e^y,$ as shown below.\n\n![](images/09/09fa628c26853d48f3775945e856763b5a996c431785ecf4194c879ee881aa78.png)\n\nFirst, notice that $D$ is indeed a type II region. \nTo determine the right and left functions, we draw a horizontal arrow through the region, as usual.\n\n![](images/47/47fffd047fe12aacfbcc98fa34750e7afcb32dd06618f2553c65432828fff328.png)\n\nHence, the region $D$ can be defined as \n\n$$\nD = \\left\\{ (x,y) \\: : \\: {\\color{red}0} \\leq y  \\leq {\\color{blue}1}, \\quad {\\color{red}0} \\leq x \\leq {\\color{blue}e^y} \\right\\}.\n$$\n\nNow, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}(x+2y)\\,dA & ={\\int }_{(\\text{lower limit})}^{(\\text{upper limit})}[{\\int }_{(\\text{left function})}^{(\\text{right function})}(x+2y)\\text{ }dx]\\text{ }dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{{e}^{y}}(x+2y)\\text{ }dx]\\text{ }dy\\end{aligned}\n$$\n\nAnd that's our answer! Notice that when we have a type II region, \n\n- the limits for $x$ are functions of $y,$ and\n\n- the limits for $y$ are constants." #edb/ref 17592186045585] [17592186135091 #edb/ref 1065 4318 #edb/ref 17592186045585] [17592186135091 #edb/ref 1066 #uuid "8a9a9898-50b3-5263-9da1-1228ed4ee5e7" #edb/ref 17592186045585] [17592186135091 #edb/ref 1067 "Introduction" #edb/ref 17592186045585] [17592186135092 #edb/ref 1064 "Suppose that we want to evaluate the repeated integral\n\n$$\n\\int_{0}^{1}\\int_{0}^{e^y} (x+2) \\ \\mathrm{d}  x \\, \\mathrm{d}  y.\n$$\n\nNotice that the domain of integration is a type II region. \n\nTo compute this integral, we must bear the following important points in mind.\n\n- We start with the inner integral, as usual.\n\n- When integrating with respect to $x,$ we treat $y$ as though it were a constant.\n\n- The limits of integration for the inner integral are functions of $y.$ Once again, we treat $y$ as though it were a constant and substitute the integration limits as usual. After this step, there should be no more $x$'s in our integral.\n\n- Finally, we compute the outer integral.\n\nLet's apply these steps to solve the given problem.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{{e}^{y}}(x+2)\\text{ }dx]dy & ={\\int }_{0}^{1}{[\\frac{{x}^{2}}{2}+2x]}_{0}^{{e}^{y}}\\text{ }dy \\\\  & ={\\int }_{0}^{1}(\\frac{{e}^{2y}}{2}+2{e}^{y})\\text{ }dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{{e}^{2y}}{2}+2{e}^{y})\\text{ }dy & ={[\\frac{{e}^{2y}}{4}+2{e}^{y}]}_{0}^{1} \\\\  & =\\frac{{e}^{2}}{4}+2e-(\\frac{{e}^{0}}{4}+2{e}^{0}) \\\\  & =\\frac{1}{4}({e}^{2}+8e-9)\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186135092 #edb/ref 1065 4319 #edb/ref 17592186045585] [17592186135092 #edb/ref 1066 #uuid "cf856bdc-a6e0-55d3-a44c-78b2e569f5e0" #edb/ref 17592186045585] [17592186135092 #edb/ref 1067 "Evaluating Repeated Integrals With Variable Limits" #edb/ref 17592186045585] [17592186321173 #edb/ref 1081 "\\frac{\\pi }{4}-\\frac{1}{2}" #edb/ref 17592186045585] [17592186321173 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186321173 #edb/ref 1084 #uuid "022db7d6-74f8-5b70-953b-f7307b30d216" #edb/ref 17592186045585] [17592186322644 #edb/ref 1081 "\\frac{\\pi }{4}-\\operatorname{ln}⁡2+1" #edb/ref 17592186045585] [17592186322644 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186322644 #edb/ref 1084 #uuid "bfcc41a0-cba5-52a7-ad10-f699b98332a3" #edb/ref 17592186045585] [17592186322908 #edb/ref 1081 "\\frac{\\pi }{4}+\\frac{1}{2}\\,\\operatorname{ln}⁡2-1" #edb/ref 17592186045585] [17592186322908 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186322908 #edb/ref 1084 #uuid "e0694915-fef8-5ca3-bf30-944201a25f5e" #edb/ref 17592186045585] [17592186323090 #edb/ref 1081 "\\frac{\\pi }{2}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" #edb/ref 17592186045585] [17592186323090 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186323090 #edb/ref 1084 #uuid "f6ee1da1-9032-5800-bb77-448b86b619a5" #edb/ref 17592186045585] [17592186323098 #edb/ref 1081 "\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" #edb/ref 17592186045585] [17592186323098 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186323098 #edb/ref 1084 #uuid "f799216a-905a-5238-a6c7-d799f6ea154d" #edb/ref 17592186045585] [17592186323234 #edb/ref 1075 #edb/ref 17592186321173 #edb/ref 17592186045585] [17592186323234 #edb/ref 1075 #edb/ref 17592186322644 #edb/ref 17592186045585] [17592186323234 #edb/ref 1075 #edb/ref 17592186322908 #edb/ref 17592186045585] [17592186323234 #edb/ref 1075 #edb/ref 17592186323090 #edb/ref 17592186045585] [17592186323234 #edb/ref 1075 #edb/ref 17592186323098 #edb/ref 17592186045585] [17592186323234 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186323234 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186323234 #edb/ref 1079 #edb/ref 17592186323098 #edb/ref 17592186045585] [17592186323234 #edb/ref 1080 #uuid "1fcad131-34ae-5ed3-80c6-2f5bcfe38d62" #edb/ref 17592186045585] [17592186323936 #edb/ref 1068 #edb/ref 17592186323234 #edb/ref 17592186045585] [17592186323936 #edb/ref 1069 "q-37685" #edb/ref 17592186045585] [17592186323936 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186323936 #edb/ref 1071 "Calculate ${\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy.$" #edb/ref 17592186045585] [17592186323936 #edb/ref 1072 #uuid "aab883d4-1f11-56e3-bc34-cc7b53210399" #edb/ref 17592186045585] [17592186323936 #edb/ref 1074 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[{\\int }_{y}^{1}dx]\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[x]_{y}^{1}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}(1-y)\\,dy \\\\  & ={\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy & ={[\\operatorname{arctan}⁡y-\\frac{\\operatorname{ln}⁡(1+{y}^{2})}{2}]}_{0}^{1} \\\\  & =(\\operatorname{arctan}⁡1-\\frac{\\operatorname{ln}⁡(1+{1}^{2})}{2}-(\\operatorname{arctan}⁡0-\\frac{\\operatorname{ln}⁡(1+{0}^{2})}{2})) \\\\  & =\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2\\end{aligned}\n$$" #edb/ref 17592186045585]}
