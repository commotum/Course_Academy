#{[{:db/id #edb/ref 17592186323936 :knowledge-point/_questions [{:db/id #edb/ref 17592186133846 :knowledge-point/id #uuid "fdce40e5-8ffe-52cb-8a8e-ac8eaea982f0" :knowledge-point/title "Evaluating a Repeated Integral Defined Over a Type II Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022db7d6-74f8-5b70-953b-f7307b30d216" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}" :db/id #edb/ref 17592186321173} {:answer/id #uuid "bfcc41a0-cba5-52a7-ad10-f699b98332a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}-\\operatorname{ln}⁡2+1" :db/id #edb/ref 17592186322644} {:answer/id #uuid "e0694915-fef8-5ca3-bf30-944201a25f5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}+\\frac{1}{2}\\,\\operatorname{ln}⁡2-1" :db/id #edb/ref 17592186322908} {:answer/id #uuid "f6ee1da1-9032-5800-bb77-448b86b619a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" :db/id #edb/ref 17592186323090} {:answer/id #uuid "f799216a-905a-5238-a6c7-d799f6ea154d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" :db/id #edb/ref 17592186323098}] :answer-field/correct {:answer/id #uuid "f799216a-905a-5238-a6c7-d799f6ea154d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2" :db/id #edb/ref 17592186323098} :answer-field/id #uuid "1fcad131-34ae-5ed3-80c6-2f5bcfe38d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323234}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aab883d4-1f11-56e3-bc34-cc7b53210399" :question/math-academy-id "q-37685" :question/problem "Calculate ${\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy.$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{y}^{1}\\frac{1}{1+{y}^{2}}\\,dx\\,dy & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[{\\int }_{y}^{1}dx]\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}[x]_{y}^{1}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{1+{y}^{2}}(1-y)\\,dy \\\\  & ={\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{1}{1+{y}^{2}}-\\frac{y}{1+{y}^{2}})\\,dy & ={[\\operatorname{arctan}⁡y-\\frac{\\operatorname{ln}⁡(1+{y}^{2})}{2}]}_{0}^{1} \\\\  & =(\\operatorname{arctan}⁡1-\\frac{\\operatorname{ln}⁡(1+{1}^{2})}{2}-(\\operatorname{arctan}⁡0-\\frac{\\operatorname{ln}⁡(1+{0}^{2})}{2})) \\\\  & =\\frac{\\pi }{4}-\\frac{1}{2}\\,\\operatorname{ln}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134525 :knowledge-point/_questions [{:db/id #edb/ref 17592186133847 :knowledge-point/id #uuid "90f7718f-e014-5232-acb1-6773ab79f61d" :knowledge-point/title "Calculating a Double Integral Defined Over a Type II Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80122cf2-eb18-5ab4-adaa-9e4ddae6ff46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "e + \\frac{1}{e}" :db/id #edb/ref 17592186133159} {:answer/id #uuid "3812513e-34ae-56f5-8a6a-be6d884399d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "e^{2} + \\frac{1}{e^{2}}" :db/id #edb/ref 17592186133160} {:answer/id #uuid "5965763a-e02b-5ed9-baec-22e9835d8a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "e + \\frac{1}{e} - 2" :db/id #edb/ref 17592186133161} {:answer/id #uuid "71c33b6a-b275-5734-87ac-dfab2ad357dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "2e - \\frac{2}{e}" :db/id #edb/ref 17592186133162} {:answer/id #uuid "7e8f9b1c-5b0c-552c-93c2-d3d9afb4c6ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "e - 2" :db/id #edb/ref 17592186133163}] :answer-field/id #uuid "5d5e2cea-fbcf-56fb-89a3-b824f03ff9b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133158}] :question/id #uuid "93a9e190-c192-5836-a0b9-91bcfd91a0ef" :question/math-academy-id "q-81197" :question/problem "Calculate $∬_(D)e^{x - y}dA$, where $D = {(x, y): 0 \\le y \\le 1, 0 \\le x \\le 2y}$."}]}
