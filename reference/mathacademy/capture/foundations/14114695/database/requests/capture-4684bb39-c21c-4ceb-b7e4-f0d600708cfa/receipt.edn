{:edb/committed true :edb/basis-t 244 :edb/replayed false :edb/tx-hash "2cf0911e684fb3845530388568b029d0804de0aedf5137ced616367ea64a69f7" :edb/db-before-t 243 :edb/db-after-t 244 :edb/tx-data [[13194139533556 50 #inst "2026-10-11T06:12:53.458Z" 13194139533556 17592186045585 true] [17592186133845 1038 #edb/ref 17592186407953 13194139533556 17592186045585 true] [17592186133846 1038 #edb/ref 17592186407954 13194139533556 17592186045585 true] [17592186133847 1038 #edb/ref 17592186407955 13194139533556 17592186045585 true] [17592186134525 1068 #edb/ref 17592186133158 13194139533556 17592186045585 false] [17592186134525 1068 #edb/ref 17592186407951 13194139533556 17592186045585 true] [17592186134525 1070 #edb/ref 17592186045487 13194139533556 17592186045585 true] [17592186134525 1071 "Calculate ${∬}_{D}{e}^{x-y}\\,dA,$ where $D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 2y}.$" 13194139533556 17592186045585 true] [17592186134525 1071 "Calculate $∬_(D)e^{x - y}dA$, where $D = {(x, y): 0 \\le y \\le 1, 0 \\le x \\le 2y}$." 13194139533556 17592186045585 false] [17592186134525 1074 "The integral is defined over a type II region $D={(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 2y}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{x-y}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{2y}({e}^{x}\\cdot {e}^{-y})\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{2y}({e}^{x}\\cdot {e}^{-y})\\,dx\\,dy & ={\\int }_{0}^{1}{e}^{-y}[{\\int }_{0}^{2y}{e}^{x}\\,dx]dy \\\\  & ={\\int }_{0}^{1}{e}^{-y}[{e}^{x}]_{0}^{2y}\\,dy \\\\  & ={\\int }_{0}^{1}{e}^{-y}({e}^{2y}-{e}^{0})dy \\\\  & ={\\int }_{0}^{1}({e}^{y}-{e}^{-y})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({e}^{y}-{e}^{-y})\\,dy & =[{e}^{y}+{e}^{-y}]_{0}^{1} \\\\  & =({e}^{1}+{e}^{-1})-({e}^{0}+{e}^{0}) \\\\  & =e+\\frac{1}{e}-2\\end{aligned}\n$$" 13194139533556 17592186045585 true] [17592186407928 1043 #edb/ref 17592186407956 13194139533556 17592186045585 true] [17592186407928 1043 #edb/ref 17592186407957 13194139533556 17592186045585 true] [17592186407928 1043 #edb/ref 17592186407958 13194139533556 17592186045585 true] [17592186407928 1043 #edb/ref 17592186407959 13194139533556 17592186045585 true] [17592186407928 1043 #edb/ref 17592186407960 13194139533556 17592186045585 true] [17592186407928 1044 #edb/ref 17592186045464 13194139533556 17592186045585 true] [17592186407928 1045 "Double Integrals Over Type II Regions" 13194139533556 17592186045585 true] [17592186407928 1046 #edb/ref 17592186407956 13194139533556 17592186045585 true] [17592186407928 1048 #edb/ref 17592186046665 13194139533556 17592186045585 true] [17592186407928 1049 #edb/ref 17592186050270 13194139533556 17592186045585 true] [17592186407928 1053 #uuid "dae6af1c-a643-55d8-9eb3-cb620d5edf1b" 13194139533556 17592186045585 true] [17592186407929 1081 "\\operatorname{cos}⁡(1)" 13194139533556 17592186045585 true] [17592186407929 1083 #edb/ref 17592186045499 13194139533556 17592186045585 true] [17592186407929 1084 #uuid "1a312eff-692f-5f36-add7-8d6f7a0791cb" 13194139533556 17592186045585 true] [17592186407930 1081 "\\operatorname{cos}⁡(1)+1" 13194139533556 17592186045585 true] [17592186407930 1083 #edb/ref 17592186045499 13194139533556 17592186045585 true] [17592186407930 1084 #uuid "1deb603f-c9fd-595d-8f3d-42a462139aa4" 13194139533556 17592186045585 true] [17592186407931 1081 "{\\int }_{0}^{2}[{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy" 13194139533556 17592186045585 true] [17592186407931 1083 #edb/ref 17592186045499 13194139533556 17592186045585 true] [17592186407931 1084 #uuid "1f195090-3d93-59e1-afd9-0a582f1e9403" 13194139533556 17592186045585 true] [17592186407932 1081 "{\\int }_{0}^{8-{y}^{2}}[{\\int }_{{y}^{2}}^{2}\\operatorname{ln}⁡(xy)\\,dx]dy" 13194139533556 17592186045585 true] [17592186407932