      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114695/observations/step-q81292-07467e02b645a02782b4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114695/observations/step-q81292-07467e02b645a02782b4.png",
      "source_url": "https://mathacademy.com/tasks/14114695/topics/2152/review",
      "captured_at": 1791699098.3107529,
      "math_academy_id": "q-81292",
