#{[{:db/id #edb/ref 17592186272239 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d8c1d-5896-5f10-81c9-bd96ad0517aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269475} {:answer/id #uuid "52e6f0c7-0a62-59e3-a5cb-80e9b7f54638" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270005} {:answer/id #uuid "54208619-14dc-516d-b1aa-20ed09a0bb47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186270018} {:answer/id #uuid "77353fd7-ee88-5664-aec8-e00589b061d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270324} {:answer/id #uuid "af2612fc-39ba-5012-92ba-66032676ab46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186270827}] :answer-field/correct {:answer/id #uuid "af2612fc-39ba-5012-92ba-66032676ab46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186270827} :answer-field/id #uuid "94b73dce-7f8c-597e-ae8e-4e20e2b2ff1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dad0d98-37c5-5af9-9c0a-4f0fabec2bcc" :question/math-academy-id "q-141200" :question/problem "Which of the following statements are true, given that $A$ is a $6\\times 6$ matrix and  $det(A)=-1?$ \n\n- $A$ is invertible\n- $\\text{Null}(A)={0}$\n- $\\text{nullity}(A)=6$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{6} \\\\  & \\text{dim(Col}(A))=6=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Indeed,   a matrix $A$ is invertible if and only if $det(A)\\ne 0.$ Since here we have $det(A)=-1\\ne 0,$ our matrix $A$ must be  invertible.\n\n- Statement II is true. Indeed, by the invertible matrix theorem\n$A$ is invertible $\\,⇔\\,\\text{Null}(A)={0}.$\n\n- Statement III is false. Since $A$ is invertible,  it must be $\\text{nullity}(A)=0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186124863 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef04a305-48e9-5100-9ee7-37ef95dd031d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186121779} {:answer/id #uuid "f8ebd6d4-ef22-55d1-b2fd-1d2f280fa42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186121780} {:answer/id #uuid "5b1a9ac3-b9a3-59ca-891f-c8d93f27fd0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186121781} {:answer/id #uuid "62f0ec41-6c5f-51cb-9439-22250619fa40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186121782} {:answer/id #uuid "730f0ca8-ac97-51bf-ae0d-7facf7eedff8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186121783}] :answer-field/id #uuid "4d952797-9510-50c2-afac-7e03150f3737" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121778}] :question/id #uuid "a5b63a26-4713-5ecd-9d64-befaccc0bd77" :question/math-academy-id "q-34834" :question/problem "Which of the following statements are true, given that $A$ is a $5 \\cdot 5$ matrix and\n$Null(A) = {\\begin{bmatrix}x_{1} \\\\ 3x_{1} \\\\ 0 \\\\ x_{1} \\\\ -2x_{1}\\end{bmatrix} \\mid x_{1} ∈ R}$?\n\n1. $dim(Null(A)) = 0$\n2. $A$ is not invertible\n3. $rank(A) = 5$"}]}
