#{[{:activity/expected-seconds 1320.0 :activity/first-step {:db/id #edb/ref 17592186167825} :activity/id #uuid "3c5e13b1-d0a0-579a-b4f6-fd82128b1d48" :activity/scope {:db/id #edb/ref 17592186050801 :topic/id #uuid "68086256-0558-57ff-bb09-7a45eb02cfce" :topic/math-academy-id 3189} :activity/steps [{:db/id #edb/ref 17592186167825 :step/content {:db/id #edb/ref 17592186167990 :tutorial/content "Consider an **inhomogeneous** linear system of ordinary differential equations in component form:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={a}_{11}{x}_{1}(t)+{a}_{12}{x}_{2}(t)+{f}_{1}(t) \\\\ {x}_{2}^{′}(t)={a}_{21}{x}_{1}(t)+{a}_{22}{x}_{2}(t)+{f}_{2}(t)\\end{aligned}\n$$\n\nHere, we can package the unknown functions into vectors\n![](images/03/037289f6f3a779d750cef23dc18d149786604bd477565e3708d6470f2e3c2f7a.svg)\n\nThen, the system can be written as\n![](images/77/77fc846681e1f0a98675b06f962e42f4491fd07d9bb2eab291e69cd49e4dd5f9.svg)\n\nOften, the **forcing functions** $f_1(t), f_2(t)$ are linear combinations of a few basic functions (such as $e^{3t},$ $t^2,$ or $\\sin t$).\nIn that case, it is useful to write $\\mathbf{g}(t)$ as a sum of those basic functions times constant vectors.\n\nFor example, let's write down the system of linear ODEs below in matrix form.\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+2{x}_{2}(t)+8{e}^{3t} \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+5{x}_{2}(t)+10{e}^{4t}\\end{aligned}\n$$\n\nFirst, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 8+{e}^{4t}\\cdot 0 \\\\ {x}_{2}^{′}(t)=(-3)\\cdot {x}_{1}(t)+5\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 0+{e}^{4t}\\cdot 10\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n![](images/47/47fb751641455ab4cf85756166fa8811bd8fe3ddc6bcb6005c8e6be8c31b6fe1.svg)\nwhere ![](images/f4/f47e1272123fb8f4a5f54931929b9492f54e9d78d590b2ee28394bf29976ce44.svg)" :tutorial/id #uuid "02676de3-99b6-59c3-bb19-fb44e8c8dda4" :tutorial/math-academy-id 14390 :tutorial/title "Introduction"} :step/id #uuid "6c0c815f-38b0-5982-b2ff-0c436a438ef2" :step/math-academy-id 587221 :step/next {:db/id #edb/ref 17592186167826}} {:db/id #edb/ref 17592186167826 :step/content {:db/id #edb/ref 17592186166902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166523 :question/id #uuid "aabc0f35-fdfc-573a-8d86-ada823a380a4" :question/math-academy-id "e-21544"} :knowledge-point/id #uuid "51834713-edc2-5af3-a0dc-fb54ea4040c6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048451}] :knowledge-point/questions [{:db/id #edb/ref 17592186167173} {:db/id #edb/ref 17592186167174} {:db/id #edb/ref 17592186305060} {:db/id #edb/ref 17592186305061} {:db/id #edb/ref 17592186305062} {:db/id #edb/ref 17592186305063} {:db/id #edb/ref 17592186414543} {:db/id #edb/ref 17592186531590} {:db/id #edb/ref 17592186531594} {:db/id #edb/ref 17592186531652}] :knowledge-point/title "Writing Down an Inhomogeneous System of Linear ODEs in Matrix Form"} :step/id #uuid "cef46dd3-49de-53b9-9dd8-4623716995ad" :step/math-academy-id 587222 :step/next {:db/id #edb/ref 17592186167830}} {:db/id #edb/ref 17592186167827 :step/content {:db/id #edb/ref 17592186166903 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166522 :question/id #uuid "a5c44ae4-e55b-512f-ac1c-46f62950c1f4" :question/math-academy-id "e-21543"} :knowledge-point/id #uuid "3eecbfc4-f7eb-5d4c-bea6-8fd21839804c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049146} {:db/id #edb/ref 17592186049370} {:db/id #edb/ref 17592186050392}] :knowledge-point/questions [{:db/id #edb/ref 17592186167171} {:db/id #edb/ref 17592186167219} {:db/id #edb/ref 17592186305065} {:db/id #edb/ref 17592186305112} {:db/id #edb/ref 17592186305123} {:db/id #edb/ref 17592186398746} {:db/id #edb/ref 17592186398753} {:db/id #edb/ref 17592186398760} {:db/id #edb/ref 17592186398767} {:db/id #edb/ref 17592186414542} {:db/id #edb/ref 17592186531581} {:db/id #edb/ref 17592186531615}] :knowledge-point/title "Identifying the Form of a Particular Solution for Inhomogeneous System of Linear ODEs"} :step/id #uuid "316a7c1f-a4af-51c8-a7b8-c3ec021d1f6e" :step/math-academy-id 587225 :step/next {:db/id #edb/ref 17592186167828}} {:db/id #edb/ref 17592186167828 :step/content {:db/id #edb/ref 17592186166904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166520 :question/id #uuid "c5e60742-2571-5100-96be-a7578e6dda07" :question/math-academy-id "e-21540"} :knowledge-point/id #uuid "dddc6159-ac4a-50ac-a366-08a4b809c925" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048452} {:db/id #edb/ref 17592186050309} {:db/id #edb/ref 17592186050450}] :knowledge-point/questions [{:db/id #edb/ref 17592186167169} {:db/id #edb/ref 17592186167170} {:db/id #edb/ref 17592186305135} {:db/id #edb/ref 17592186305149} {:db/id #edb/ref 17592186308357} {:db/id #edb/ref 17592186308358} {:db/id #edb/ref 17592186308359} {:db/id #edb/ref 17592186377137} {:db/id #edb/ref 17592186377142} {:db/id #edb/ref 17592186414541} {:db/id #edb/ref 17592186531575} {:db/id #edb/ref 17592186531578} {:db/id #edb/ref 17592186564501}] :knowledge-point/title "Finding the Particular Solution of an Inhomogeneous System of Linear ODEs"} :step/id #uuid "2c8cd38f-370b-5913-94e0-7f44f9fcda89" :step/math-academy-id 587228 :step/next {:db/id #edb/ref 17592186167829}} {:db/id #edb/ref 17592186167829 :step/content {:db/id #edb/ref 17592186166905 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166521 :question/id #uuid "6f03c3e2-26dc-5ef3-90d9-9b80feac1ad4" :question/math-academy-id "e-21541"} :knowledge-point/id #uuid "6d5ab3ac-770b-58c9-b30f-659773ea1a20" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050098}] :knowledge-point/questions [{:db/id #edb/ref 17592186167172} {:db/id #edb/ref 17592186167238} {:db/id #edb/ref 17592186308470} {:db/id #edb/ref 17592186308472} {:db/id #edb/ref 17592186308473} {:db/id #edb/ref 17592186308474} {:db/id #edb/ref 17592186308479} {:db/id #edb/ref 17592186308480} {:db/id #edb/ref 17592186308482} {:db/id #edb/ref 17592186414540} {:db/id #edb/ref 17592186414544} {:db/id #edb/ref 17592186564480} {:db/id #edb/ref 17592186564532}] :knowledge-point/title "Solving an Initial Value Problem for an Inhomogeneous System of Linear ODEs"} :step/id #uuid "12093e8a-7d9d-5d68-80be-1242a4755c5d" :step/math-academy-id 587231} {:db/id #edb/ref 17592186167830 :step/content {:db/id #edb/ref 17592186168018 :tutorial/content "Recall that an inhomogeneous linear system has the form\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t)+\\mathbf{g}(t),\n$$\n\nwhere $A$ is a constant matrix and $\\mathbf{g}(t)$ is a known forcing term. The associated *homogeneous* system is\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t).\n$$\n\nA *general solution* of the *homogeneous* system is called the **complementary solution** and is denoted by $\\mathbf{x}_c(t)$.\nA **particular solution** is any single function $\\mathbf{x}_p(t)$ that satisfies the full inhomogeneous system.\n\nThese two pieces combine to give the *general solution* of the inhomogeneous system:\n\n$$\n\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t)\n$$\n\nIndeed, notice that\n\n$$\n\\begin{aligned}({x}_{c}+{x}_{p})^{′} & ={x}_{c}^{′}+{x}_{p}^{′} \\\\  & =(A{x}_{c})+(A{x}_{p}+g(t)) \\\\  & =A{x}_{c}+A{x}_{p}+g(t) \\\\  & =A({x}_{c}+{x}_{p})+g(t).\\end{aligned}\n$$\n\nSince $(\\mathbf{x}_c+\\mathbf{x}_p)' = A(\\mathbf{x}_c+\\mathbf{x}_p)+\\mathbf{g}(t)$, the sum is a solution of the inhomogeneous system.\n\nNotice that it doesn't matter which particular solution we take.\nSuppose we found two different particular solutions, $\\mathbf{x}_p(t)$ and $\\mathbf{y}_p(t).$ Let's examine their difference, $\\mathbf{w}(t) = \\mathbf{y}_p(t) - \\mathbf{x}_p(t)$.\n\nBy definition, we know that $\\mathbf{y}_p' = A\\mathbf{y}_p + \\mathbf{g}(t)$ and $\\mathbf{x}_p' = A\\mathbf{x}_p + \\mathbf{g}(t).$\nNow, let's find the derivative of the difference $\\mathbf{w}(t)$:\n\n$$\n\\begin{aligned}{w}^{′} & =({y}_{p}-{x}_{p})^{′} \\\\  & ={y}_{p}^{′}-{x}_{p}^{′} \\\\  & =(A{y}_{p}+g(t))-(A{x}_{p}+g(t)) \\\\  & =A{y}_{p}-A{x}_{p} \\\\  & =A({y}_{p}-{x}_{p}) \\\\  & =Aw\\end{aligned}\n$$\n\nThe result $\\mathbf{w}' = A\\mathbf{w}$ means that the difference between any two particular solutions is itself a solution to the *homogeneous* system.\n\nThis is why *any* particular solution is enough. Any other particular solution can be written as\n\n$$\n\\mathbf{y}_{p} = \\underbrace{(\\mathbf{y}_{p}-\\mathbf{x}_{p})}_{\\text{homogeneous}} \\:\\:\\: + \\underbrace{\\mathbf{x}_{p}}_{\\text{particular}} \\!\\!\\!\\!\\!.\n$$\n\nThe \"variety\" among particular solutions is already captured by the complementary solution $\\mathbf{x}_c(t)$." :tutorial/id #uuid "07b5883c-d1bc-5616-8d06-61b24dc79288" :tutorial/math-academy-id 14560 :tutorial/title "Complementary vs. Particular Solutions"} :step/id #uuid "a0524e0a-51fb-5d06-bc88-e401c42eb515" :step/math-academy-id 587234 :step/next {:db/id #edb/ref 17592186167831}} {:db/id #edb/ref 17592186167831 :step/content {:db/id #edb/ref 17592186168019 :tutorial/content "To solve\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t)+\\mathbf{g}(t),\n$$\n\nwe often look for a particular solution $\\mathbf{x}_p(t)$ whose *form matches the forcing term* $\\mathbf{g}(t)$.\n\nIn each case below, the unknowns are constant vectors (to be determined by substitution).\n\n- **Constant forcing.** If $\\mathbf{g}(t)$ is a constant vector, then we try\n\n$$\n\\mathbf{x}_p(t)=\\mathbf{a}\n$$\n\nwhere $\\mathbf{a}$ is a constant vector.\n\n- **Polynomial forcing.** If $\\mathbf{g}(t)$ is a polynomial of degree $n$, then we try\n\n$$\n\\mathbf{x}_p(t) = \\mathbf{a}_n t^n+\\mathbf{a}_{n-1} t^{n-1}+\\cdots+\\mathbf{a}_1 t+\\mathbf{a}_0\n$$\n\nwhere $\\mathbf{a}_n,\\mathbf{a}_{n-1},\\ldots,\\mathbf{a}_1,\\mathbf{a}_0$ are constant vectors.\n\n- **Exponential forcing.** If $\\mathbf{g}(t)=e^{\\alpha t}\\mathbf{v}$ for some constant vector $\\mathbf{v},$ then we try\n\n$$\n\\mathbf{x}_p(t)=e^{\\alpha t}\\mathbf{a}\n$$\n\nwhere $\\mathbf{a}$ is a constant vector.\n\n- **Trigonometric forcing.** If $\\mathbf{g}(t)=\\cos(\\beta t)\\mathbf{v}$ or $\\mathbf{g}(t)=\\sin(\\beta t)\\mathbf{v}$ for some constant vector $\\mathbf{v},$ then we try\n\n$$\n\\mathbf{x}_p(t)=\\cos(\\beta t)\\mathbf{a}+\\sin(\\beta t)\\mathbf{b}\n$$\n\nwhere $\\mathbf{a}$ and $\\mathbf{b}$ are constant vectors.\n\nIn the next step, we substitute the chosen $\\mathbf{x}_p(t)$ into the differential equation to solve for the unknown vectors.\n\nLet's see some concrete examples." :tutorial/id #uuid "799084bf-9121-5217-8f53-70b9e09e61d2" :tutorial/math-academy-id 14561 :tutorial/title "Choosing the Form of a Particular Solution"} :step/id #uuid "ec433b4b-f6b5-5367-a7c3-7cb160d53783" :step/math-academy-id 587235 :step/next {:db/id #edb/ref 17592186167827}}] :activity/title "Solving Inhomogeneous Systems of ODEs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186166987}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186564583} :activity/id #uuid "cd780238-6561-5335-8628-86c0ec2f992b" :activity/scope {:db/id #edb/ref 17592186050801 :topic/id #uuid "68086256-0558-57ff-bb09-7a45eb02cfce" :topic/math-academy-id 3189} :activity/steps [{:db/id #edb/ref 17592186564558 :step/content {:db/id #edb/ref 17592186564501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93ad8973-8142-5ec3-9098-90c172b538cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186564198}] :answer-field/correct {:db/id #edb/ref 17592186564198} :answer-field/id #uuid "68ebb6bc-8ecd-5644-95d4-7ec3ae49104a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564407} {:answer-field/choices [{:answer/id #uuid "2d3c4717-e0dc-535a-af6f-a87c7e67b231" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186564043}] :answer-field/correct {:db/id #edb/ref 17592186564043} :answer-field/id #uuid "e2f40649-92a8-5fb9-9467-241241b205e5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564450} {:answer-field/choices [{:answer/id #uuid "c8b19b21-147d-5fdc-8f4d-a5e1d36c4409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186564282}] :answer-field/correct {:db/id #edb/ref 17592186564282} :answer-field/id #uuid "ecb59f7c-3318-5766-b4e8-a59390b05bce" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564453}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83030669-b615-545c-b0dd-a292bd26151d" :question/math-academy-id "q-333014" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}\\frac{5}{3} & -\\frac{8}{3} \\\\ -\\frac{4}{3} & \\frac{1}{3}\\end{aligned}]x(t)+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    {{field-2}}\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $-2$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $2.$ Therefore, we assume that the particular solution is also polynomial of degree $2,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2},{c}_{1},{c}_{2}$ are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}\\frac{5}{3} & -\\frac{8}{3} \\\\ -\\frac{4}{3} & \\frac{1}{3}\\end{aligned}][\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}] \\\\ [\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(\\frac{5{a}_{1}-8{a}_{2}}{3}){t}^{2}+(\\frac{5{b}_{1}-8{b}_{2}}{3})t+(\\frac{5{c}_{1}-8{c}_{2}}{3}) \\\\ (\\frac{-4{a}_{1}+{a}_{2}}{3}){t}^{2}+(\\frac{-4{b}_{1}+{b}_{2}}{3})t+(\\frac{-4{c}_{1}+{c}_{2}}{3})\\end{aligned}]+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}] \\\\ [\\begin{aligned}0{t}^{2}+2{a}_{1}t+{b}_{1} \\\\ 0{t}^{2}+2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(\\frac{5{a}_{1}-8{a}_{2}-18}{3}){t}^{2}+(\\frac{5{b}_{1}-8{b}_{2}+41}{3})t+(\\frac{5{c}_{1}-8{c}_{2}-24}{3}) \\\\ (\\frac{-4{a}_{1}+{a}_{2}+9}{3}){t}^{2}+(\\frac{-4{b}_{1}+{b}_{2}-13}{3})t+(\\frac{-4{c}_{1}+{c}_{2}+15}{3})\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding coefficients of like powers of $t,$ we get the following system:\n\n$$\n\\{\\begin{aligned}\\frac{5{a}_{1}-8{a}_{2}-18}{3}=0 \\\\ \\frac{-4{a}_{1}+{a}_{2}+9}{3}=0 \\\\ \\frac{5{b}_{1}-8{b}_{2}+41}{3}=2{a}_{1} \\\\ \\frac{-4{b}_{1}+{b}_{2}-13}{3}=2{a}_{2} \\\\ \\frac{5{c}_{1}-8{c}_{2}-24}{3}={b}_{1} \\\\ \\frac{-4{c}_{1}+{c}_{2}+15}{3}={b}_{2}\\end{aligned}\n$$\n\nSolving the first and second equations, we get\n\n$$\n{a}_{1}=2,\\,{a}_{2}=-1.\n$$\n\nSubstituting these into the second and third equations, and solving for ${b}_{1}$ and ${b}_{2},$ we get\n\n$$\n{b}_{1}=-1,\\,{b}_{2}=3.\n$$\n\nFinally, substituting these last two values into the fourth and sixth equations, and solving for ${c}_{1}$ and ${c}_{2},$ we have\n\n$$\n{c}_{1}=1,\\,{c}_{2}=-2.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}2{t}^{2}-t+1 \\\\ -{t}^{2}+3t-2\\end{aligned}]=[\\begin{aligned}2 \\\\ -1\\end{aligned}]{t}^{2}+[\\begin{aligned}-1 \\\\ 3\\end{aligned}]t+[\\begin{aligned}1 \\\\ -2\\end{aligned}].\n$$"} :step/id #uuid "4b0c53fd-63dc-5e60-91b1-9c112e1416ed" :step/next {:db/id #edb/ref 17592186564567}} {:db/id #edb/ref 17592186564567 :step/content {:db/id #edb/ref 17592186564532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97a52fdf-3469-584f-9753-ff054f6fb144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186564204}] :answer-field/correct {:db/id #edb/ref 17592186564204} :answer-field/id #uuid "6da43cad-9102-5837-b0fd-1a8a586b0473" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564409} {:answer-field/choices [{:answer/id #uuid "bf902f7a-5b81-5b56-a8db-6e1126ebbd99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186564262}] :answer-field/correct {:db/id #edb/ref 17592186564262} :answer-field/id #uuid "9d8e6467-de2d-5e39-8c4a-83e68c137488" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564426}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e4dc2c43-c8eb-5bcf-a39b-abeb3bbb2764" :question/math-academy-id "q-333596" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]x(t)+{e}^{-t}[\\begin{aligned}-1 \\\\ -3\\end{aligned}],\\,x(0)=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]\\,-$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{2(0)} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0\\cdot {e}^{2(0)} \\\\ {e}^{2(0)}\\end{aligned}]+{e}^{-0}[\\begin{aligned}0 \\\\ 1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}0 \\\\ 1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}+1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n\\{\\begin{aligned}{c}_{1}=3 \\\\ {c}_{2}+1=-2\\end{aligned}\n$$\n\nFrom the first equation, we have ${c}_{1}=3.$ From the second equation, we get ${c}_{2}=-3.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=3\\cdot [\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]-3\\cdot [\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$"} :step/id #uuid "8300d53d-a4ca-5fa3-80df-bd513e8ce9c1" :step/next {:db/id #edb/ref 17592186564573}} {:db/id #edb/ref 17592186564571 :step/content {:db/id #edb/ref 17592186305149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed83240c-82bc-5611-99a3-4308ce5cf262" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-4t}" :db/id #edb/ref 17592186303947}] :answer-field/correct {:db/id #edb/ref 17592186303947} :answer-field/id #uuid "2e5932a6-769f-53b0-9887-f3b11bd584b9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186304188} {:answer-field/choices [{:answer/id #uuid "3929f470-8c37-5c1d-acb5-a766af03c21a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186302811}] :answer-field/correct {:db/id #edb/ref 17592186302811} :answer-field/id #uuid "7ce06ca8-7806-59b8-a4f0-083fa8e761f8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186304409}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a4beb5a1-2716-50fa-8921-aa7ead951ee6" :question/math-academy-id "q-332914" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}3 & 0 \\\\ 0 & 5\\end{bmatrix}x(t)+{e}^{-4t}\\begin{bmatrix}-14 \\\\ -27\\end{bmatrix}.\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}\\begin{bmatrix}{e}^{3t} \\\\ 0\\end{bmatrix}+{c}_{2}\\begin{bmatrix}0 \\\\ {e}^{5t}\\end{bmatrix},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n| $x(t)={x}_{c}(t)+$\n{{field-1}}\n$\\cdot \\,\\,$ |  | $2$ |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n{e}^{-4t}\\begin{bmatrix}-14 \\\\ -27\\end{bmatrix}\n$$\n\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n\n$$\n{x}_{p}(t)={e}^{-4t}\\begin{bmatrix}a \\\\ b\\end{bmatrix},\n$$\n\nwhere $a,b$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=-4{e}^{-4t}\\begin{bmatrix}a \\\\ b\\end{bmatrix}.\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}-4{e}^{-4t}\\begin{bmatrix}a \\\\ b\\end{bmatrix} & =\\begin{bmatrix}3 & 0 \\\\ 0 & 5\\end{bmatrix}{e}^{-4t}\\begin{bmatrix}a \\\\ b\\end{bmatrix}+{e}^{-4t}\\begin{bmatrix}-14 \\\\ -27\\end{bmatrix} \\\\ -4\\begin{bmatrix}a \\\\ b\\end{bmatrix} & =\\begin{bmatrix}3 & 0 \\\\ 0 & 5\\end{bmatrix}\\begin{bmatrix}a \\\\ b\\end{bmatrix}+\\begin{bmatrix}-14 \\\\ -27\\end{bmatrix} \\\\ \\begin{bmatrix}-4a \\\\ -4b\\end{bmatrix} & =\\begin{bmatrix}3a \\\\ 5b\\end{bmatrix}+\\begin{bmatrix}-14 \\\\ -27\\end{bmatrix} \\\\ \\begin{bmatrix}-4a \\\\ -4b\\end{bmatrix} & =\\begin{bmatrix}3a-14 \\\\ 5b-27\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}3a-14 &=-4a \\\\ 5b-27 &=-4b\\end{aligned}\\right.\n$$\n\nFrom the first equation, we get\n\n$$\n3a-14=-4a\\,⇒\\,a=2.\n$$\n\nFrom the second equation, we get\n\n$$\n5b-27=-4b\\,⇒\\,b=3.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)={e}^{-4t}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}.\n$$"} :step/id #uuid "8af18c3c-574b-5432-b3c3-e6d29db74282" :step/next {:db/id #edb/ref 17592186564558}} {:db/id #edb/ref 17592186564573 :step/content {:db/id #edb/ref 17592186564480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388279d1-e34b-50a4-9ce3-cc8dace5482c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186564064}] :answer-field/correct {:db/id #edb/ref 17592186564064} :answer-field/id #uuid "1a013588-c06c-5f55-940c-cbbd3057b90b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564382} {:answer-field/choices [{:answer/id #uuid "8cfa8656-14de-5766-be79-8ae7b5309f14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186564189}] :answer-field/correct {:db/id #edb/ref 17592186564189} :answer-field/id #uuid "f188d9c6-552e-5855-a6ab-7fbed03f69d1" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186564460}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "338f9068-6af3-5a99-af8d-48b1ac33890b" :question/math-academy-id "q-333610" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]x(t)+[\\begin{aligned}-{t}^{2}+3t-2 \\\\ -4t+8\\end{aligned}],\\,x(0)=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]\\,-$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{0} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{2(0)}\\end{aligned}]+[\\begin{aligned}{0}^{2}-0+1 \\\\ 2(0)-3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}-3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n\\{\\begin{aligned}{c}_{1}+1=2 \\\\ {c}_{2}-3=-5\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=1.$ From the second equation, we have ${c}_{2}=-2.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=1\\cdot [\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]-2\\cdot [\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}].\n$$"} :step/id #uuid "97a61470-ffa2-5ca9-9f97-05f72a262645"} {:db/id #edb/ref 17592186564583 :step/content {:db/id #edb/ref 17592186305112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab23c90-40c9-571e-9f79-118b3d83869d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{t}\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix}" :db/id #edb/ref 17592186302633} {:answer/id #uuid "3a80ddec-00b8-503c-9044-eea16655f16c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix}" :db/id #edb/ref 17592186302821} {:answer/id #uuid "6db8df92-d1b5-5c11-b43b-cb019986b7a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-t}(t\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix})" :db/id #edb/ref 17592186303128} {:answer/id #uuid "82d10db6-bb4c-56a3-bf37-7b4b1dc5a6f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-t}\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix}" :db/id #edb/ref 17592186303273} {:answer/id #uuid "b20fc247-c254-53ad-977d-2c3be69f1839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix}" :db/id #edb/ref 17592186303559}] :answer-field/correct {:db/id #edb/ref 17592186302821} :answer-field/id #uuid "18ba3146-873b-5a08-989f-9066e7c8cc72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304135}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24c639b5-3938-594c-bf24-83bf8b532823" :question/math-academy-id "q-332749" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=\\begin{bmatrix}-\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{1}{5} & -\\frac{7}{5}\\end{bmatrix}x(t)+\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\n$$\n\nA complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{-t}+{c}_{2}(t\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}){e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n\\begin{bmatrix}3 \\\\ 5\\end{bmatrix}\n$$\n\nof the inhomogeneous system of ODEs is constant. Therefore, we assume that the particular solution is also constant, i.e.\n\n$$\n{x}_{p}(t)=\\begin{bmatrix}{a}_{1} \\\\ {a}_{2}\\end{bmatrix},\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined."} :step/id #uuid "b1481bb9-2ae6-5119-bb02-e73517637dbf" :step/next {:db/id #edb/ref 17592186564571}}] :activity/title "Solving Inhomogeneous Systems of ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186563967}]}
