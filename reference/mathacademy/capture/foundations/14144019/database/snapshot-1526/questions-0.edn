answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\,-2,\\,-1⟩" :db/id #edb/ref 17592186395421} {:answer/id #uuid "2312de20-e709-5b80-a27b-d10d7e0e5430" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,\\,2,\\,1⟩" :db/id #edb/ref 17592186395422}] :answer-field/correct {:answer/id #uuid "29a4ca46-2d86-5674-925d-0fca36cce902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,\\,6,\\,-4⟩" :db/id #edb/ref 17592186395418} :answer-field/id #uuid "5c625c76-a044-5d00-8e7b-aae0bedd3be2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2776fb8a-9df3-5def-8690-2a494e137c16" :question/math-academy-id "q-98096" :question/problem "Calculate \n${\\int }_{0}^{1}2f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨1,\\,-3,\\,2⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨1,\\,-3,\\,2⟩ \\\\  & =⟨-1,\\,3,\\,-2⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2f(t)\\,\\text{d}t & =2{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =2\\cdot ⟨-1,\\,3,\\,-2⟩ \\\\  & =⟨-2,\\,6,\\,-4⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395437 :knowledge-point/_questions [{:db/id #edb/ref 17592186119980 :knowledge-point/id #uuid "0333b70a-2ede-5c8d-b298-4d25ae4d4667" :knowledge-point/title "Applying the Vector Addition and Scalar Multiplication Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fa697c9-4d76-5898-8fb5-ac84a77debdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3-\\operatorname{ln}⁡3,\\,\\sqrt{3}-3,\\,8⟩" :db/id #edb/ref 17592186395439} {:answer/id #uuid "ae8a89ab-8c73-517f-8e47-53ad9f4c06fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-12⟩" :db/id #edb/ref 17592186395440} {:answer/id #uuid "b9fcf75b-c1d0-5f39-9056-7c5640eb928e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8+\\operatorname{ln}⁡3,\\,1,\\,0⟩" :db/id #edb/ref 17592186395441} {:answer/id #uuid "1423503f-a4b1-5ae9-ba3b-0e1efa315d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,\\,\\sqrt{3},\\,1⟩" :db/id #edb/ref 17592186395442} {:answer/id #uuid "ab0fdc34-4ee8-516c-b880-42f9c2fcec55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩" :db/id #edb/ref 17592186395443}] :answer-field/correct {:answer/id #uuid "ab0fdc34-4ee8-516c-b880-42f9c2fcec55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩" :db/id #edb/ref 17592186395443} :answer-field/id #uuid "e5f819ae-49fc-5c26-94b2-5e3cdd0e1a0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c2ff90f-3df2-5a7a-ae8c-1f49f03b53d3" :question/math-academy-id "q-98170" :question/problem "Calculate ${\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩$ and ${\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t & ={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+4⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩ \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+⟨3,\\,2,\\,-10⟩ \\\\  & =⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395444 :knowledge-point/_questions [{:db/id #edb/ref 17592186119879 :knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de2ac76c-9113-5a47-9157-727b5201bce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\,10,\\,14⟩" :db/id #edb/ref 17592186395446} {:answer/id #uuid "47e5a16a-fd42-59c9-8c7f-aefb666ddc96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,\\,5,\\,7⟩" :db/id #edb/ref 17592186395447} {:answer/id #uuid "723d9e2a-b13f-5333-9e82-034a6fe25fc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-4,\\,10,\\,14⟩" :db/id #edb/ref 17592186395448} {:answer/id #uuid "47f5751b-90f0-5f7b-8be3-eb434daf135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-8,\\,15,\\,-7⟩" :db/id #edb/ref 17592186395449} {:answer/id #uuid "45704cad-5ba2-5545-9012-731551bd8d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-5,\\,-7⟩" :db/id #edb/ref 17592186395450}] :answer-field/correct {:answer/id #uuid "47e5a16a-fd42-59c9-8c7f-aefb666ddc96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,\\,5,\\,7⟩" :db/id #edb/ref 17592186395447} :answer-field/id #uuid "e1aae533-8d8a-5285-b8ff-9cc79c87f698" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0a8f71d-793f-5891-8d8f-395df7dbd166" :question/math-academy-id "q-98172" :question/problem "Calculate \n${\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨4,\\,-10,\\,-14⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨4,\\,-10,\\,-14⟩ \\\\  & =⟨-4,\\,10,\\,14⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-4,\\,10,\\,14⟩ \\\\  & =⟨-2,\\,5,\\,7⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362275 :knowledge-point/_questions [{:db/id #edb/ref 17592186119879 :knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03077afc-6571-5573-8c51-f973bd5dc04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,4,\\,1⟩" :db/id #edb/ref 17592186360844} {:answer/id #uuid "1bc174f3-4451-50e9-a65d-ef01a0b49c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,4,\\,-1⟩" :db/id #edb/ref 17592186360945} {:answer/id #uuid "32cfbe48-bd3f-5126-8d64-4fcd36b2cd97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,0,\\,1⟩" :db/id #edb/ref 17592186361060} {:answer/id #uuid "56742ac8-825c-5081-953f-7aff1ec910be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,\\,3,\\,2⟩" :db/id #edb/ref 17592186361228} {:answer/id #uuid "98d04c10-6147-5ef9-a8f0-44feed27e918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,0,\\,-1⟩" :db/id #edb/ref 17592186361517}] :answer-field/correct {:answer/id #uuid "03077afc-6571-5573-8c51-f973bd5dc04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,4,\\,1⟩" :db/id #edb/ref 17592186360844} :answer-field/id #uuid "7a64d838-42a9-50de-a90f-4fbf80d5585a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362082}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "920d3899-d202-5cde-aad8-d129368027e5" :question/math-academy-id "q-98189" :question/problem "Calculate \n${\\int }_{0}^{2}\\frac{1}{2}f(t)-⟨3,\\,-1,\\,-2⟩\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨2,\\,-4,\\,6⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨2,\\,-4,\\,6⟩ \\\\  & =⟨-2,\\,4,\\,-6⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition and scalar multiplication rules, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)-⟨3,\\,-1,\\,-2⟩\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{2}⟨3,\\,-1,\\,-2⟩\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-2,\\,4,\\,-6⟩-{⟨3t,\\,-t,\\,-2t⟩|}_{0}^{2} \\\\  & =⟨-1,\\,2,\\,-3⟩-⟨6,\\,-2,\\,-4⟩\\text{ } \\\\  & =⟨-7,\\,4,\\,1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362277 :knowledge-point/_questions [{:db/id #edb/ref 17592186119981 :knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14f9b6e2-520c-582b-a0f6-265b669e11e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-12,\\,11⟩" :db/id #edb/ref 17592186360919} {:answer/id #uuid "2c4996f5-95d7-5568-a05f-7e424569827c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-9,\\,3⟩" :db/id #edb/ref 17592186361035} {:answer/id #uuid "4e0fa7a7-2201-539c-91bb-5ee5110fb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,-9,\\,11⟩" :db/id #edb/ref 17592186361177} {:answer/id #uuid "57f5a084-1fcc-545e-9ec0-cfd2e84f841d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,14,\\,-7⟩" :db/id #edb/ref 17592186361236} {:answer/id #uuid "72f2ae10-472b-5697-868c-1487ee4657c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,\\,-4,\\,3⟩" :db/id #edb/ref 17592186361341}] :answer-field/correct {:answer/id #uuid "4e0fa7a7-2201-539c-91bb-5ee5110fb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,-9,\\,11⟩" :db/id #edb/ref 17592186361177} :answer-field/id #uuid "0f30ce34-a100-52c6-8920-e8e760ecaf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18499165-c282-509c-946c-50bba51e2c16" :question/math-academy-id "q-98216" :question/problem "Calculate \n${\\int }_{3}^{4}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{6}f(t)\\,\\text{d}t=⟨8,\\,-6,\\,15⟩$\nand\n${\\int }_{4}^{6}f(t)\\,\\text{d}t=⟨-2,\\,3,\\,4⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{3}^{6}f(t)\\,\\text{d}t={\\int }_{3}^{4}f(t)\\,\\text{d}t+{\\int }_{4}^{6}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{3}^{4}f(t)\\,\\text{d}t={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}f(t)\\,\\text{d}t & ={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t \\\\  & =⟨8,\\,-6,\\,15⟩-⟨-2,\\,3,\\,4⟩ \\\\  & =⟨10,\\,-9,\\,11⟩.\\end{aligned}\n$$"}]}
