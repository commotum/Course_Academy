 Product Rules"} :step/id #uuid "7a2a2545-f4a7-5b95-93cf-cc4160242986" :step/math-academy-id 9894}] :activity/title "Integration Rules for Vector-Valued Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186119983}]}
