db/ref 17592186049663 #edb/ref 17592186045417] [17592186119983 #edb/ref 1053 #uuid "87f0cf5a-7b6f-5f30-9395-ce15661f7f42" #edb/ref 17592186045417] [17592186120181 #edb/ref 1068 #edb/ref 17592186117247 #edb/ref 17592186045417] [17592186120181 #edb/ref 1069 "q-32521" #edb/ref 17592186045417] [17592186120181 #edb/ref 1071 "Find $\\displaystyle \\int_{0}^{2}c \\cdot f(t)dt$\ngiven that\n$\\displaystyle \\int_{0}^{2}f(t)dt = 16i + 8j + 2k$\nand\n$c =-i + j$." #edb/ref 17592186045417] [17592186120181 #edb/ref 1072 #uuid "e79507a4-566e-5fff-acc4-da31b5f94ddb" #edb/ref 17592186045417] [17592186120555 #edb/ref 1068 #edb/ref 17592186360402 #edb/ref 17592186045417] [17592186120555 #edb/ref 1069 "q-96943" #edb/ref 17592186045417] [17592186120555 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120555 #edb/ref 1071 "Calculate \n${\\int }_{1}^{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨-2,\\,3,\\,4⟩$\nand\n${\\int }_{2}^{3}f(t)\\,\\text{d}t=⟨8,\\,-6,\\,15⟩.$" #edb/ref 17592186045417] [17592186120555 #edb/ref 1072 #uuid "29982efe-8588-56f9-8a2e-657a512dab79" #edb/ref 17592186045417] [17592186120555 #edb/ref 1074 "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{1}^{3}f(t)\\,\\text{d}t={\\int }_{1}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{2}f(t)\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t-{\\int }_{2}^{3}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}f(t)\\,\\text{d}t & ={\\int }_{1}^{3}f(t)\\,\\text{d}t-{\\int }_{2}^{3}f(t)\\,\\text{d}t \\\\  & =⟨-2,\\,3,\\,4⟩-⟨8,\\,-6,\\,15⟩ \\\\  & =⟨-10,\\,9,\\,-11⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120556 #edb/ref 1068 #edb/ref 17592186119449 #edb/ref 17592186045417] [17592186120556 #edb/ref 1069 "q-98093" #edb/ref 17592186045417] [17592186120556 #edb/ref 1071 "Calculate\n$\\displaystyle \\int_{0}^{1}f(t) + ⟨1, 1, 1⟩dt$\ngiven that\n$\\displaystyle \\int_{1}^{0}f(t)dt = ⟨ - 2, 3, 4⟩$." #edb/ref 17592186045417] [17592186120556 #edb/ref 1072 #uuid "63279440-ddaa-5ce9-9454-481ab5b36e09" #edb/ref 17592186045417] [17592186120557 #edb/ref 1068 #edb/ref 17592186119455 #edb/ref 17592186045417] [17592186120557 #edb/ref 1068 #edb/ref 17592186395417 #edb/ref 17592186045417] [17592186120557 #edb/ref 1069 "q-98096" #edb/ref 17592186045417] [17592186120557 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120557 #edb/ref 1071 "Calculate \n${\\int }_{0}^{1}2f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨1,\\,-3,\\,2⟩.$" #edb/ref 17592186045417] [17592186120557 #edb/ref 1072 #uuid "2776fb8a-9df3-5def-8690-2a494e137c16" #edb/ref 17592186045417] [17592186120557 #edb/ref 1074 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨1,\\,-3,\\,2⟩ \\\\  & =⟨-1,\\,3,\\,-2⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2f(t)\\,\\text{d}t & =2{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =2\\cdot ⟨-1,\\,3,\\,-2⟩ \\\\  & =⟨-2,\\,6,\\,-4⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120789 #edb/ref 1058 #edb/ref 17592186120791 #edb/ref 17592186045417] [17592186120789 #edb/ref 1061 32283 #edb/ref 17592186045417] [17592186120789 #edb/ref 1062 #uuid "b9eea760-99ae-5d7b-82d5-ea90245e119d" #edb/ref 17592186045417] [17592186120789 #edb/ref 1063 #edb/ref 17592186119879 #edb/ref 17592186045417] [17592186120790 #edb/ref 1058 #edb/ref 17592186120789 #edb/ref 17592186045417] [17592186120790 #edb/ref 1061 32530 #edb/ref 17592186045417] [17592186120790 #edb/ref 1062 #uuid "660b20a9-f073-51b0-a1b7-e72f161ebfb3" #edb/ref 17592186045417] [17592186120790 #edb/ref 1063 #edb/ref 17592186121079 #edb/ref 17592186045417] [17592186120791 #edb/ref 1058 #edb/ref 17592186120978 #edb/ref 17592186045417] [17592186120791 #edb/ref 1061 32531 #edb/ref 17592186045417] [17592186120791 #edb/ref 1062 #uuid "84aafb0e-a1fc-506a-aa26-8b23e04c1756" #edb/ref 17592186045417] [17592186120791 #edb/ref 1063 #edb/ref 17592186121080 #edb/ref 17592186045417] [17592186120792 #edb/ref 1058 #edb/ref 17592186120979 #edb/ref 17592186045417] [17592186120792 #edb/ref 1061 32532 #edb/ref 17592186045417] [17592186120792 #edb/ref 1062 #uuid "60fca522-e8ee-530d-9936-cc7ec084b35f" #edb/ref 17592186045417] [17592186120792 #edb/ref 1063 #edb/ref 17592186121081 #edb/ref 17592186045417] [17592186120976 #edb/ref 1058 #edb/ref 17592186120977 #edb/ref 17592186045417] [17592186120976 #edb/ref 1061 9874 #edb/ref 17592186045417] [17592186120976 #edb/ref 1062 #uuid "a65b687f-5aa2-5d59-93d7-c89fdaa5d539" #edb/ref 17592186045417] [17592186120976 #edb/ref 1063 #edb/ref 17592186120995 #edb/ref 17592186045417] [17592186120977 #edb/ref 1058 #edb/ref 17592186120790 #edb/ref 17592186045417] [17592186120977 #edb/ref 1061 9881 #edb/ref 17592186045417] [17592186120977 #edb/ref 1062 #uuid "40ba1e04-bcee-59a8-8c09-889d763a2116" #edb/ref 17592186045417] [17592186120977 #edb/ref 1063 #edb/ref 17592186119980 #edb/ref 17592186045417] [17592186120978 #edb/ref 1058 #edb/ref 17592186120792 #edb/ref 17592186045417] [17592186120978 #edb/ref 1061 9884 #edb/ref 17592186045417] [17592186120978 #edb/ref 1062 #uuid "bef0ec93-3b3d-56a7-b85c-4ffde2f524ad" #edb/ref 17592186045417] [17592186120978 #edb/ref 1063 #edb/ref 17592186119981 #edb/ref 17592186045417] [17592186120979 #edb/ref 1061 9894 #edb/ref 17592186045417] [17592186120979 #edb/ref 1062 #uuid "7a2a2545-f4a7-5b95-93cf-cc4160242986" #edb/ref 17592186045417] [17592186120979 #edb/ref 1063 #edb/ref 17592186119982 #edb/ref 17592186045417] [17592186120995 #edb/ref 1064 "Since the integration of vector functions is done component-by-component, the properties of integrals of vector functions are immediately inherited from those of the integrals of real-valued functions. \n\nSuppose that $\\mathbf f(t)$ and $\\mathbf g(t)$ are vector-valued functions that are continuous on a closed interval $[a,b],$ and $\\alpha$ is a scalar. \nThen, the *vector addition and scalar multiplication rules* are as follows:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}(f(t)+g(t))\\text{d}t={\\int }_{a}^{b}f(t)\\,\\text{d}t\\,+\\,{\\int }_{a}^{b}g(t)\\,\\text{d}t\\, & \\text{vector addition rule} \\\\ {\\int }_{a}^{b}\\alpha \\,f(t)\\,\\text{d}t=\\alpha \\,{\\int }_{a}^{b}f(t)\\,\\text{d}t\\, & \\text{scalar constant multiple rule}\\end{aligned}\n$$\n\n \n\nFor example, if $\\mathbf f(t) = \\left\\langle t, \\: \\cos t\\right\\rangle$ and $\\mathbf g(t) = \\left\\langle -t^2, \\: \\sin t \\right\\rangle,$ then we have\n\n$$\n\\begin{aligned}\\int [f(t)+2g(t)]\\text{d}t & =\\int f(t)\\,\\text{d}t+2\\int g(t)\\,\\text{d}t \\\\  & =\\int ⟨t,\\,\\operatorname{cos}t⟩\\,\\text{d}t+2\\int ⟨-{t}^{2},\\,\\operatorname{sin}t⟩\\,\\text{d}t \\\\  & =⟨\\int t\\,\\text{d}t,\\,\\int \\operatorname{cos}t\\,\\text{d}t⟩+⟨2\\int -{t}^{2}\\,\\text{d}t,\\,2\\int \\operatorname{sin}t\\,\\text{d}t⟩ \\\\  & =⟨\\frac{{t}^{2}}{2}+{C}_{1},\\,\\operatorname{sin}t+{C}_{2}⟩+⟨-\\frac{2{t}^{3}}{3}+{C}_{3},\\,-2\\operatorname{cos}t+{C}_{4}⟩ \\\\  & =⟨\\frac{3{t}^{2}-4{t}^{3}}{6},\\,\\operatorname{sin}t-2\\operatorname{cos}t⟩+C\\end{aligned}\n$$\n\n \n\nwhere $C_1, \\, C_2, \\, C_3, \\, C_4$ are arbitrary real constants and ${\\mathbf C} = \\langle C_1+C_3, C_2+C_4 \\rangle$ is a constant vector." #edb/ref 17592186045417] [17592186120995 #edb/ref 1065 2342 #edb/ref 17592186045417] [17592186120995 #edb/ref 1066 #uuid "b3d07bd2-8d66-5645-a140-c638f5e9f002" #edb/ref 17592186045417] [17592186120995 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121079 #edb/ref 1064 "Given a vector-valued function $\\mathbf f(t)$ that is continuous on a closed interval $[a,b],$ the *rule for reversal of integration limits* states the following:\n\n$$\n\\begin{aligned}{\\int }_{b}^{a}f(t)\\,\\text{d}t=-{\\int }_{a}^{b}f(t)\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121079 #edb/ref 1065 5177 #edb/ref 17592186045417] [17592186121079 #edb/ref 1066 #uuid "43078f08-37bf-59a3-8462-3b3efc865eb1" #edb/ref 17592186045417] [17592186121079 #edb/ref 1067 "The Rule for Reversal of Integration Limits" #edb/ref 17592186045417] [17592186121080 #edb/ref 1064 "Given a vector-valued function $\\mathbf f(t)$ that is continuous on a closed interval $[a,b]$ and $p \\in (a,b),$ the *adjacent intervals rule* states the following:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}f(t)\\,\\text{d}t={\\int }_{a}^{p}f(t)\\,\\text{d}t+{\\int }_{p}^{b}f(t)\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121080 #edb/ref 1065 5178 #edb/ref 17592186045417] [17592186121080 #edb/ref 1066 #uuid "ef0617f3-7ee0-5300-8795-10adbdc19d3b" #edb/ref 17592186045417] [17592186121080 #edb/ref 1067 "The Adjacent Intervals Rule" #edb/ref 17592186045417] [17592186121081 #edb/ref 1064 "Suppose that $\\mathbf f(t)$ is a vector-valued function that is continuous on a closed interval $[a,b]$ and $\\mathbf c$ is a constant vector. \nThen, the *products rules* are as follows:\n\n$$\n\\begin{aligned}{\\int }_{a}^{b}[c\\cdot f(t)]\\text{d}t=c\\cdot ({\\int }_{a}^{b}f(t)\\,\\text{d}t)\\, & \\text{dot product rule} \\\\ {\\int }_{a}^{b}[c\\times f(t)]\\text{d}t=c\\times {\\int }_{a}^{b}f(t)\\,\\text{d}t\\, & \\text{cross product rule}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121081 #edb/ref 1065 5179 #edb/ref 17592186045417] [17592186121081 #edb/ref 1066 #uuid "2531e67a-b5ed-5052-a97f-34abca386c58" #edb/ref 17592186045417] [17592186121081 #edb/ref 1067 "The Product Rules" #edb/ref 17592186045417] [17592186259920 #edb/ref 1080 "⟨2-\\operatorname{ln}⁡2,\\,-8,\\,6⟩" #edb/ref 17592186045417] [17592186259920 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186259920 #edb/ref 1083 #uuid "0549aad0-d3df-5bda-b5ff-a2a28949ce32" #edb/ref 17592186045417] [17592186261212 #edb/ref 1080 "⟨\\operatorname{ln}⁡2-1,\\,2,\\,-2⟩" #edb/ref 17592186045417] [17592186261212 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261212 #edb/ref 1083 #uuid "9a34877b-0c90-54bc-a15c-e4ef580ff774" #edb/ref 17592186045417] [17592186261260 #edb/ref 1080 "⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩" #edb/ref 17592186045417] [17592186261260 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261260 #edb/ref 1083 #uuid "9fbe6911-5632-5913-a554-2c6c9b2cd4ac" #edb/ref 17592186045417] [17592186261361 #edb/ref 1080 "⟨2+\\operatorname{ln}⁡2,\\,-6,\\,1⟩" #edb/ref 17592186045417] [17592186261361 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261361 #edb/ref 1083 #uuid "a9dcd6b2-1af9-52b2-863a-f10202e72cc5" #edb/ref 17592186045417] [17592186261389 #edb/ref 1080 "⟨\\operatorname{ln}⁡2,\\,-5,\\,2⟩" #edb/ref 17592186045417] [17592186261389 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261389 #edb/ref 1083 #uuid "ad108365-5066-5f63-ba54-eb2a13ec2de6" #edb/ref 17592186045417] [17592186262333 #edb/ref 1075 #edb/ref 17592186259920 #edb/ref 17592186045417] [17592186262333 #edb/ref 1075 #edb/ref 17592186261212 #edb/ref 17592186045417] [17592186262333 #edb/ref 1075 #edb/ref 17592186261260 #edb/ref 17592186045417] [17592186262333 #edb/ref 1075 #edb/ref 17592186261361 #edb/ref 17592186045417] [17592186262333 #edb/ref 1075 #edb/ref 17592186261389 #edb/ref 17592186045417] [17592186262333 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262333 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262333 #edb/ref 1078 #edb/ref 17592186261260 #edb/ref 17592186045417] [17592186262333 #edb/ref 1079 #uuid "7e799d64-76f3-5753-a340-9612a01bb001" #edb/ref 17592186045417] [17592186262951 #edb/ref 1068 #edb/ref 17592186262333 #edb/ref 17592186045417] [17592186262951 #edb/ref 1069 "q-129140" #edb/ref 17592186045417] [17592186262951 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186262951 #edb/ref 1071 "Calculate \n${\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{4}f(t)\\,\\text{d}t=⟨-1,\\,-2,\\,1⟩$\nand \n${\\int }_{0}^{4}g(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩.$" #edb/ref 17592186045417] [17592186262951 #edb/ref 1072 #uuid "595f95a8-e242-59b0-85cf-ad884a52eaa6" #edb/ref 17592186045417] [17592186262951 #edb/ref 1074 "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t=3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t & =3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t \\\\  & =3⟨-1,\\,-2,\\,1⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3,\\,-6,\\,3⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186263020 #edb/ref 1080 "⟨-13,\\,-5,\\,3⟩" #edb/ref 17592186045417] [17592186263020 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263020 #edb/ref 1083 #uuid "02719984-1eed-5b45-abb8-f9d57dc603d6" #edb/ref 17592186045417] [17592186263656 #edb/ref 1080 "-2\\,i+2\\,j-k" #edb/ref 17592186045417] [17592186263656 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263656 #edb/ref 1083 #uuid "4c08ea4b-77bf-5be9-95f7-6f7a1369c182" #edb/ref 17592186045417] [17592186263830 #edb/ref 1080 "2\\,i-5\\,j+k" #edb/ref 17592186045417] [17592186263830 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263830 #edb/ref 1083 #uuid "5ffc9ed7-eb98-5a8d-b53f-7bb55b6b45aa" #edb/ref 17592186045417] [17592186264156 #edb/ref 1080 "⟨-9,\\,-8,\\,10⟩" #edb/ref 17592186045417] [17592186264156 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264156 #edb/ref 1083 #uuid "860b18bb-4f4a-53c7-963e-483683ca820f" #edb/ref 17592186045417] [17592186264479 #edb/ref 1080 "⟨-9,\\,-10,\\,8⟩" #edb