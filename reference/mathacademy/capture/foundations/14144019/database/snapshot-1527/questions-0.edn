\\,-10,\\,-14⟩ \\\\  & =⟨-4,\\,10,\\,14⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-4,\\,10,\\,14⟩ \\\\  & =⟨-2,\\,5,\\,7⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362275 :knowledge-point/_questions [{:db/id #edb/ref 17592186119879 :knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03077afc-6571-5573-8c51-f973bd5dc04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,4,\\,1⟩" :db/id #edb/ref 17592186360844} {:answer/id #uuid "1bc174f3-4451-50e9-a65d-ef01a0b49c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,4,\\,-1⟩" :db/id #edb/ref 17592186360945} {:answer/id #uuid "32cfbe48-bd3f-5126-8d64-4fcd36b2cd97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,0,\\,1⟩" :db/id #edb/ref 17592186361060} {:answer/id #uuid "56742ac8-825c-5081-953f-7aff1ec910be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-6,\\,3,\\,2⟩" :db/id #edb/ref 17592186361228} {:answer/id #uuid "98d04c10-6147-5ef9-a8f0-44feed27e918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,\\,0,\\,-1⟩" :db/id #edb/ref 17592186361517}] :answer-field/correct {:answer/id #uuid "03077afc-6571-5573-8c51-f973bd5dc04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-7,\\,4,\\,1⟩" :db/id #edb/ref 17592186360844} :answer-field/id #uuid "7a64d838-42a9-50de-a90f-4fbf80d5585a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362082}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "920d3899-d202-5cde-aad8-d129368027e5" :question/math-academy-id "q-98189" :question/problem "Calculate \n${\\int }_{0}^{2}\\frac{1}{2}f(t)-⟨3,\\,-1,\\,-2⟩\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨2,\\,-4,\\,6⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨2,\\,-4,\\,6⟩ \\\\  & =⟨-2,\\,4,\\,-6⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition and scalar multiplication rules, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)-⟨3,\\,-1,\\,-2⟩\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{2}⟨3,\\,-1,\\,-2⟩\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-2,\\,4,\\,-6⟩-{⟨3t,\\,-t,\\,-2t⟩|}_{0}^{2} \\\\  & =⟨-1,\\,2,\\,-3⟩-⟨6,\\,-2,\\,-4⟩\\text{ } \\\\  & =⟨-7,\\,4,\\,1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362277 :knowledge-point/_questions [{:db/id #edb/ref 17592186119981 :knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14f9b6e2-520c-582b-a0f6-265b669e11e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-12,\\,11⟩" :db/id #edb/ref 17592186360919} {:answer/id #uuid "2c4996f5-95d7-5568-a05f-7e424569827c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,-9,\\,3⟩" :db/id #edb/ref 17592186361035} {:answer/id #uuid "4e0fa7a7-2201-539c-91bb-5ee5110fb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,-9,\\,11⟩" :db/id #edb/ref 17592186361177} {:answer/id #uuid "57f5a084-1fcc-545e-9ec0-cfd2e84f841d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,14,\\,-7⟩" :db/id #edb/ref 17592186361236} {:answer/id #uuid "72f2ae10-472b-5697-868c-1487ee4657c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨8,\\,-4,\\,3⟩" :db/id #edb/ref 17592186361341}] :answer-field/correct {:answer/id #uuid "4e0fa7a7-2201-539c-91bb-5ee5110fb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨10,\\,-9,\\,11⟩" :db/id #edb/ref 17592186361177} :answer-field/id #uuid "0f30ce34-a100-52c6-8920-e8e760ecaf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18499165-c282-509c-946c-50bba51e2c16" :question/math-academy-id "q-98216" :question/problem "Calculate \n${\\int }_{3}^{4}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{6}f(t)\\,\\text{d}t=⟨8,\\,-6,\\,15⟩$\nand\n${\\int }_{4}^{6}f(t)\\,\\text{d}t=⟨-2,\\,3,\\,4⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{3}^{6}f(t)\\,\\text{d}t={\\int }_{3}^{4}f(t)\\,\\text{d}t+{\\int }_{4}^{6}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{3}^{4}f(t)\\,\\text{d}t={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}f(t)\\,\\text{d}t & ={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t \\\\  & =⟨8,\\,-6,\\,15⟩-⟨-2,\\,3,\\,4⟩ \\\\  & =⟨10,\\,-9,\\,11⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186440627 :knowledge-point/_questions [{:db/id #edb/ref 17592186119981 :knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aaa82b-134d-5ac3-8299-d9ab861ac6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,\\,7,\\,-3⟩" :db/id #edb/ref 17592186440574} {:answer/id #uuid "15863b1c-cda3-5899-907a-75cfcee2a5c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\,7,\\,-1⟩" :db/id #edb/ref 17592186440576} {:answer/id #uuid "1bd98d57-852f-5bdb-bd6a-571e37b35316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,\\,-9,\\,-1⟩" :db/id #edb/ref 17592186440579} {:answer/id #uuid "26cb0adc-a799-5679-8285-567c012449b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,\\,-9,\\,3⟩" :db/id #edb/ref 17592186440583} {:answer/id #uuid "a5e0035b-953e-5269-97ce-c86bb0d7f0b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,\\,-4,\\,-5⟩" :db/id #edb/ref 17592186440602}] :answer-field/correct {:answer/id #uuid "1bd98d57-852f-5bdb-bd6a-571e37b35316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,\\,-9,\\,-1⟩" :db/id #edb/ref 17592186440579} :answer-field/id #uuid "a178f3a9-4495-5692-ab36-8240a8fd4002" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440623}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "099cadcd-00ea-506e-8b07-43c526063b36" :question/math-academy-id "q-98263" :question/problem "Calculate \n${\\int }_{0}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{4}\\frac{1}{2}f(t)\\,\\text{d}t=⟨6,\\,-2,\\,-4⟩$\nand\n${\\int }_{3}^{4}f(t)\\,\\text{d}t=⟨3,\\,5,\\,-7⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{4}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{4}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t \\\\  & =2\\cdot {\\int }_{0}^{4}\\frac{1}{2}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t \\\\  & =2\\cdot ⟨6,\\,-2,\\,-4⟩-⟨3,\\,5,\\,-7⟩ \\\\  & =⟨12,\\,-4,\\,-8⟩-⟨3,\\,5,\\,-7⟩ \\\\  & =⟨9,\\,-9,\\,-1⟩.\\end{aligned}\n$$"}]}
