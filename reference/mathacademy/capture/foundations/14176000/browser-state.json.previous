data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msub><mi>F</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>≈</mo><mn>0.040</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>rounded to three decimal places.</p>\n</div></div>",
