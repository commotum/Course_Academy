      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274617/observations/step-q335310-f42e3ebbf1798c59d9a7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274617/observations/step-q335310-f42e3ebbf1798c59d9a7.png",
      "source_url": "https://mathacademy.com/tasks/14274617/topics/3245/lesson",
