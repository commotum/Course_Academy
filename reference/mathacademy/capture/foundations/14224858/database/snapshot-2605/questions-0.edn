#{[{:db/id #edb/ref 17592186373862 :knowledge-point/_questions [{:db/id #edb/ref 17592186188292 :knowledge-point/id #uuid "474f9c82-4ae7-58e0-9457-6bda9cab8973" :knowledge-point/title "Translating Coordinate Plane Problems Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2c4829e-9ff5-5c77-8160-757948c34286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=3|x|" :db/id #edb/ref 17592186373864} {:answer/id #uuid "7e16602c-ea2a-5cbc-a3ed-6fcf2ad9b012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=8|x|" :db/id #edb/ref 17592186373865} {:answer/id #uuid "80b53aba-6c00-50c6-bef0-87cc4e4f247b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=4\\sqrt{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186373866} {:answer/id #uuid "4c0ceb4b-3c4e-561d-b09c-109e90eae4ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=\\frac{24|y|}{5}" :db/id #edb/ref 17592186373867} {:answer/id #uuid "a9af8465-e86d-58d5-908e-3721348d588c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=\\frac{\\sqrt{{x}^{2}+{y}^{2}}}{3}" :db/id #edb/ref 17592186373868}] :answer-field/correct {:answer/id #uuid "7e16602c-ea2a-5cbc-a3ed-6fcf2ad9b012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{′}(x)=8|x|" :db/id #edb/ref 17592186373865} :answer-field/id #uuid "81b73e2e-d50c-5e49-8505-3ee73aad8826" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6b89f7e-afce-55f3-8c93-dbf9b7119d01" :question/math-academy-id "q-143139" :question/problem "At each point $P$ on a particular curve, the derivative ${y}^{′}(x)$ is proportional to the shortest distance from $P$ to the $y$-axis. The derivative at the point $(3,-5)$ equals $24.$ What differential equation describes this curve?" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*At each point $P$ on a particular curve, the **derivative** ${y}^{′}(x)$ is **proportional** to the **shortest distance from $P$ to the $y$-axis**.*\n\nWe note the following:\n\n- The *shortest distance from $P$ to the $y$-axis* is given by $|x|.$\n\n- Since the *derivative* is *proportional to* the shortest distance from $P$ to the $y$-axis, we have \n\n$$\n{y}^{′}(x)=k\\cdot |x|\n$$\n\nwhere $k$ is a constant.\n\nSo, our differential equation is\n\n$$\n{y}^{′}(x)=k|x|.\n$$\n\nIn addition, we're told that ${y}^{′}(x)=24$ when at the point $(3,-5).$ We can use this to determine the value of the coefficient $k:$\n\n$$\n\\begin{aligned}24=k|3|\\,⟹\\,k=8\\end{aligned}\n$$\n\nFinally, the differential equation describing the curve is\n\n$$\n{y}^{′}(x)=8|x|.\n$$"}]}
