<msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>+</mo><msup><mi>ln</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn></mrow><mn>4</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msup></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><msup><mi>ln</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn></mrow><mrow><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><msup><mi>ln</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
