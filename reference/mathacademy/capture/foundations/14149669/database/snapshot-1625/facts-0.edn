d-bdec-1a04c311fcf1" #edb/ref 17592186045417] [17592186118335 #edb/ref 1080 "2\\sqrt{2}" #edb/ref 17592186045417] [17592186118335 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118335 #edb/ref 1083 #uuid "9dc2a5bf-fc50-5bdf-a0af-5f1a4575ac15" #edb/ref 17592186045417] [17592186118336 #edb/ref 1080 "((1 + e)^{3/2})/(e)" #edb/ref 17592186045417] [17592186118336 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118336 #edb/ref 1083 #uuid "ac062cf8-af09-58a7-bd19-bf3f3d13a2bb" #edb/ref 17592186045417] [17592186118337 #edb/ref 1080 "\\frac{1}{\\sqrt[3]{4}}" #edb/ref 17592186045417] [17592186118337 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118337 #edb/ref 1083 #uuid "ec6b22ad-4809-5bb5-bd45-2c29a5f05f04" #edb/ref 17592186045417] [17592186118338 #edb/ref 1080 "\\frac{\\sqrt{2}}{4}" #edb/ref 17592186045417] [17592186118338 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118338 #edb/ref 1083 #uuid "fb8bdbbb-355b-54d4-a806-644ad3ceeeff" #edb/ref 17592186045417] [17592186118339 #edb/ref 1080 "\\sqrt[3]{4}" #edb/ref 17592186045417] [17592186118339 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186118339 #edb/ref 1083 #uuid "76f203ed-87c5-59b7-8132-51c8335abec5" #edb/ref 17592186045417] [17592186119577 #edb/ref 1069 "e-3452" #edb/ref 17592186045417] [17592186119577 #edb/ref 1071 "Find the radius of curvature for the curve  $\\mathbf r(t) =  t \\, \\mathbf i + \\sin t\\, \\mathbf j$ at $t = \\dfrac \\pi 2.$" #edb/ref 17592186045417] [17592186119577 #edb/ref 1072 #uuid "1f374865-c7f7-510c-b361-fbad352d86c6" #edb/ref 17592186045417] [17592186119577 #edb/ref 1074 "The curvature $\\kappa(t)$ of a plane curve $\\mathbf r(t) = x(t) \\, \\mathbf i + y(t)\\,\\mathbf j$ is given by\n\n$$\n\\kappa (t) = \\dfrac {|x'(t) y''(t) - y'(t) x''(t)|} {\\big([x'(t)]^2 + [y'(t)]^2\\big)^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t) = \\dfrac 1 {\\kappa(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t) = t, \\qquad y(t) = \\sin t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =1,\\, & {y}^{′}(t) & =\\operatorname{cos}⁡t \\\\ {x}^{″}(t) & =0,\\, & {y}^{″}(t) & =-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|1\\cdot (-\\operatorname{sin}⁡t)-\\operatorname{cos}⁡t\\cdot 0|}{{({1}^{2}+(\\operatorname{cos}⁡t)^{2})}^{3/2}} \\\\  & =\\frac{|\\operatorname{sin}⁡t|}{{(1+{cos}^{2}⁡t)}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t = \\dfrac{\\pi}2$ is\n\n$$\n\\begin{aligned}κ(\\frac{\\pi }{2}) & =\\frac{|\\operatorname{sin}⁡(\\frac{\\pi }{2})|}{{(1+{cos}^{2}⁡(\\frac{\\pi }{2}))}^{3/2}} \\\\  & =\\frac{1}{{(1+{0}^{2})}^{3/2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t = \\dfrac{\\pi}2$ is\n\n$$\n\\begin{aligned}R(\\frac{\\pi }{2}) & =\\frac{1}{κ(\\frac{\\pi }{2})}=1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119578 #edb/ref 1069 "e-3453" #edb/ref 17592186045417] [17592186119578 #edb/ref 1071 "Find the curvature of the curve $y = x^3$ at $x=-1.$" #edb/ref 17592186045417] [17592186119578 #edb/ref 1072 #uuid "2ff129e7-a923-5510-a35b-a6be403152ac" #edb/ref 17592186045417] [17592186119578 #edb/ref 1074 "The curvature $\\kappa(x)$ of a plane curve $y = y(x)$ is given by\n\n$$\n\\kappa(x) = \\dfrac {|y''(x)|} {(1+[y'(x)]^2)^{3/2}}.\n$$\n\nFirst, we calculate $y'(x)$ and $y''(x){:}$\n\n$$\n\\begin{aligned}{y}^{′}(x) & =3{x}^{2},\\, & {y}^{″}(x) & =6x\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(x) & =\\frac{|6x|}{{[1+{(3{x}^{2})}^{2}]}^{3/2}} \\\\  & =\\frac{|6x|}{{(1+9{x}^{4})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=-1$ is\n\n$$\n\\begin{aligned}κ(-1) & =\\frac{|6(-1)|}{{(1+9(-1)^{4})}^{3/2}} \\\\  & =\\frac{|-6|}{{(1+9)}^{3/2}} \\\\  & =\\frac{6}{{10}^{3/2}} \\\\  & =\\frac{6}{10\\sqrt{10}} \\\\  & =\\frac{3\\sqrt{10}}{50}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119579 #edb/ref 1069 "e-3454" #edb/ref 17592186045417] [17592186119579 #edb/ref 1071 "The signed curvature of the plane curve $\\mathbf r(t) = \\big\\langle t, \\: \\sin t \\big\\rangle$ is given by\n\n$$\nk (t) = \\dfrac{\\bbox[2pt, border: 1pt solid black]{\\phantom{AA}}}{\\sqrt{ (1+\\cos^2 t)^3 } }, \\quad t\\neq 0.\n$$\n\nWhat is the missing part of the expression?" #edb/ref 17592186045417] [17592186119579 #edb/ref 1072 #uuid "d8e470ad-6a9a-5a03-a90e-b21b24cb6862" #edb/ref 17592186045417] [17592186119579 #edb/ref 1074 "The signed curvature $k(t)$ of a plane curve $\\mathbf r(t) =  \\left \\langle x(t), y(t) \\right \\rangle$ is given by\n\n$$\nk (t) = \\dfrac {x'(t) y''(t) - y'(t) x''(t)} {\\big([x'(t)]^2 + [y'(t)]^2\\big)^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t) = t, \\qquad y(t) = \\sin t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =1,\\, & {y}^{′}(t) & =\\operatorname{cos}⁡t \\\\ {x}^{″}(t) & =0,\\, & {y}^{″}(t) & =-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nSubstituting these into the formula for the signed curvature, we get:\n\n$$\n\\begin{aligned}k(t) & =\\frac{1\\cdot (-\\operatorname{sin}⁡t)-0\\cdot \\operatorname{cos}⁡t}{{({1}^{2}+(\\operatorname{cos}⁡t)^{2})}^{3/2}} \\\\  & =\\frac{-\\operatorname{sin}⁡t}{{(1+{cos}^{2}⁡t)}^{3/2}} \\\\  & =\\frac{-\\operatorname{sin}⁡t}{\\sqrt{(1+{cos}^{2}⁡t)^{3}}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186119761 #edb/ref 1037 #edb/ref 17592186048339 #edb/ref 17592186045417] [17592186119761 #edb/ref 1038 #edb/ref 17592186120370 #edb/ref 17592186045417] [17592186119761 #edb/ref 1038 #edb/ref 17592186120499 #edb/ref 17592186045417] [17592186119761 #edb/ref 1038 #edb/ref 17592186281465 #edb/ref 17592186045417] [17592186119761 #edb/ref 1038 #edb/ref 17592186281468 #edb/ref 17592186045417] [17592186119761 #ed