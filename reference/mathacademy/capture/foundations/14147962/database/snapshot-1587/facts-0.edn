f0-5cad-a899-3c2f13b651db" #edb/ref 17592186045417] [17592186308212 #edb/ref 1075 #edb/ref 17592186305574 #edb/ref 17592186045417] [17592186308212 #edb/ref 1075 #edb/ref 17592186305740 #edb/ref 17592186045417] [17592186308212 #edb/ref 1075 #edb/ref 17592186305886 #edb/ref 17592186045417] [17592186308212 #edb/ref 1075 #edb/ref 17592186306949 #edb/ref 17592186045417] [17592186308212 #edb/ref 1075 #edb/ref 17592186307229 #edb/ref 17592186045417] [17592186308212 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186308212 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186308212 #edb/ref 1078 #edb/ref 17592186305886 #edb/ref 17592186045417] [17592186308212 #edb/ref 1079 #uuid "dc585d07-d772-5e65-84ec-8fbe4a5c3c81" #edb/ref 17592186045417] [17592186308638 #edb/ref 1068 #edb/ref 17592186307523 #edb/ref 17592186045417] [17592186308638 #edb/ref 1069 "q-33454" #edb/ref 17592186045417] [17592186308638 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186308638 #edb/ref 1071 "Find the shortest distance between the point $P(4,-2,7)$ and the plane $Π$ with equation $r\\cdot ⟨-3,2,3⟩=27.$" #edb/ref 17592186045417] [17592186308638 #edb/ref 1072 #uuid "1df7d5a8-576c-5e6b-b09e-347611e72e67" #edb/ref 17592186045417] [17592186308638 #edb/ref 1074 "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-3,2,3⟩ & =27 \\\\ -3x+2y+3z & =27 \\\\ 3z & =27+3x-2y \\\\ z & =9+x-\\frac{2}{3}y.\\end{aligned}\n$$\n\nSetting $x=6$ and $y=3,$ we get \n\n$$\nz=9+6-\\frac{2}{3}(3)=13.\n$$\n\nSo, the point $Q(6,3,13)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,3,13⟩-⟨4,-2,7⟩ \\\\  & =⟨2,5,6⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-3,2,3⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-3)+5\\cdot 2+6\\cdot 3|}{\\sqrt{(-3)^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|-6+10+18|}{\\sqrt{9+4+9}} \\\\  & =\\frac{|22|}{\\sqrt{22}} \\\\  & =\\sqrt{22}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186345558 #edb/ref 1080 "2\\sqrt{6}" #edb/ref 17592186045417] [17592186345558 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345558 #edb/ref 1083 #uuid "176d1602-8bf5-5374-a9e6-a11eb56ac6e7" #edb/ref 17592186045417] [17592186345586 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186345586 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345586 #edb/ref 1083 #uuid "1ae5898c-91fd-500e-a18d-9a613793916b" #edb/ref 17592186045417] [17592186345614 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186345614 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345614 #edb/ref 1083 #uuid "1e17bee3-8a02-51a0-902b-648ddcb92270" #edb/ref 17592186045417] [17592186345703 #edb/ref 1080 "11" #edb/ref 17592186045417] [17592186345703 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345703 #edb/ref 1083 #uuid "27496ca3-7fad-5a26-b5da-f602f9ca180b" #edb/ref 17592186045417] [17592186345859 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186345859 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345859 #edb/ref 1083 #uuid "3bf469ee-bfa5-54ad-9ee7-3e8686851ee9" #edb/ref 17592186045417] [17592186346067 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186346067 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346067 #edb/ref 1083 #uuid "547fec09-9ac4-53fe-bc5f-235373563b18" #edb/ref 17592186045417] [17592186346071 #edb/ref 1080 "\\frac{4}{3}" #edb/ref 17592186045417] [17592186346071 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346071 #edb/ref 1083 #uuid "55089e0f-7f2d-5f0a-af43-9bef