ef30a5ab8" 13194139534899 17592186045417 true] [17592186443261 1075 #edb/ref 17592186443241 13194139534899 17592186045417 true] [17592186443261 1075 #edb/ref 17592186443242 13194139534899 17592186045417 true] [17592186443261 1075 #edb/ref 17592186443246 13194139534899 17592186045417 true] [17592186443261 1075 #edb/ref 17592186443253 13194139534899 17592186045417 true] [17592186443261 1075 #edb/ref 17592186443254 13194139534899 17592186045417 true] [17592186443261 1076 #edb/ref 17592186045493 13194139534899 17592186045417 true] [17592186443261 1077 "selection" 13194139534899 17592186045417 true] [17592186443261 1078 #edb/ref 17592186443241 13194139534899 17592186045417 true] [17592186443261 1079 #uuid "161dc5e7-caef-534f-b118-60aceff59caf" 13194139534899 17592186045417 true] [17592186443262 1075 #edb/ref 17592186443245 13194139534899 17592186045417 true] [17592186443262 1075 #edb/ref 17592186443248 13194139534899 17592186045417 true] [17592186443262 1075 #edb/ref 17592186443249 13194139534899 17592186045417 true] [17592186443262 1075 #edb/ref 17592186443258 13194139534899 17592186045417 true] [17592186443262 1075 #edb/ref 17592186443260 13194139534899 17592186045417 true] [17592186443262 1076 #edb/ref 17592186045493 13194139534899 17592186045417 true] [17592186443262 1077 "selection" 13194139534899 17592186045417 true] [17592186443262 1078 #edb/ref 17592186443258 13194139534899 17592186045417 true] [17592186443262 1079 #uuid "1d64e0b6-2371-55aa-b403-0c4879d7c148" 13194139534899 17592186045417 true] [17592186443263 1075 #edb/ref 17592186443244 13194139534899 17592186045417 true] [17592186443263 1075 #edb/ref 17592186443252 13194139534899 17592186045417 true] [17592186443263 1075 #edb/ref 17592186443256 13194139534899 17592186045417 true] [17592186443263 1075 #edb/ref 17592186443257 13194139534899 17592186045417 true] [17592186443263 1075 #edb/ref 17592186443259 13194139534899 17592186045417 true] [17592186443263 1076 #edb/ref 17592186045493 13194139534899 17592186045417 true] [17592186443263 1077 "selection" 13194139534899 17592186045417 true] [17592186443263 1078 #edb/ref 17592186443256 13194139534899 17592186045417 true] [17592186443263 1079 #uuid "3647b522-cc39-5b80-86fd-13996ce4e48f" 13194139534899 17592186045417 true] [17592186443264 1075 #edb/ref 17592186443243 13194139534899 17592186045417 true] [17592186443264 1075 #edb/ref 17592186443247 13194139534899 17592186045417 true] [17592186443264 1075 #edb/ref 17592186443250 13194139534899 17592186045417 true] [17592186443264 1075 #edb/ref 17592186443251 13194139534899 17592186045417 true] [17592186443264 1075 #edb/ref 17592186443255 13194139534899 17592186045417 true] [17592186443264 1076 #edb/ref 17592186045493 13194139534899 17592186045417 true] [17592186443264 1077 "selection" 13194139534899 17592186045417 true] [17592186443264 1078 #edb/ref 17592186443255 13194139534899 17592186045417 true] [17592186443264 1079 #uuid "4a75b517-d88b-5fde-8c47-3acf225f13a9" 13194139534899 17592186045417 true] [17592186443265 1068 #edb/ref 17592186443261 13194139534899 17592186045417 true] [17592186443265 1069 "q-129126" 13194139534899 17592186045417 true] [17592186443265 1070 #edb/ref 17592186045487 13194139534899 17592186045417 true] [17592186443265 1071 "Find the shortest distance between the point $P(-3,4,7)$ and the plane $Π$ with equation $r\\cdot ⟨-3,1,1⟩=9.$" 13194139534899 17592186045417 true] [17592186443265 1072 #uuid "072e9e45-d148-5a1a-9029-08725d744a80" 13194139534899 17592186045417 true] [17592186443265 1074 "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-3,1,1⟩ & =9 \\\\ -3x+y+z & =9 \\\\ z & =9+3x-y.\\end{aligned}\n$$\n\nSetting $x=1$ and $y=1,$ we get \n\n$$\nz=9+3(1)-(1)=11.\n$$\n\nSo, the point $Q(1,1,11)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,11⟩-⟨-3,4,7⟩ \\\\  & =⟨4,-3,4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-3,1,1⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|4\\cdot (-3)+(-3)\\cdot 1+4\\cdot 1|}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{|-12-3+4|}{\\sqrt{9+1+1}} \\\\  & =\\frac{|-11|}{\\sqrt{11}} \\\\  & =\\frac{11}{\\sqrt{11}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$" 13194139534899 17592186045417 true] [17592186443266 1068 #edb/ref 17592186443264 13194139534899 17592186045417 true] [17592186443266 1069 "q-34033" 13194139534899 17592186045417 true] [17592186443266 1070 #edb/ref 17592186045487 13194139534899 17592186045417 true] [17592186443266 1071 "Find the shortest distance between the point $P(-1,0,2)$ and the plane $Π$ with equation $2x-y+2z=-1.$" 13194139534899 17592186045417 true] [17592186443266 1072 #uuid "152abe46-196c-57ed-801a-b01b3b6e9019" 13194139534899 17592186045417 true] [17592186443266 1074 "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=2$ and $y=3$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}2x-y+2z & =-1 \\\\ 2(2)-(3)+2z & =-1 \\\\ 2z & =-2 \\\\ z & =-1.\\end{aligned}\n$$\n\nSo, we get the point $Q(2,3,-1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,3,-1⟩-⟨-1,0,2⟩ \\\\  & =⟨3,3,-3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨2,-1,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot 2+3\\cdot (-1)+(-3)\\cdot 2|}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{|6-3-6|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|\\,-3\\,|}{\\sqrt{9}} \\\\  & =1\\end{aligned}\n$$" 13194139534899 17592186045417 true] [17592186443267 1068 #edb/ref 17592186443262 13194139534899 17592186045417 true] [17592186443267 1069 "q-34071" 13194139534899 17592186045417 true] [17592186443267 1070 #edb/ref 17592186045485 13194139534899 17592186045417 true] [17592186443267 1071 "Find the shortest distance between the point $P(1,1,-1)$ and the plane $Π$ with equation $(r-⟨3,0,1⟩)\\cdot ⟨1,-8,4⟩=0.$" 13194139534899 17592186045417 true] [17592186443267 1072 #uuid "c2de4bc9-44ca-5148-a12b-218413513154" 13194139534899 17592186045417 true] [17592186443267 1074 "Let's pick a point on the plane, for instance, $Q(3,0,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,0,1⟩-⟨1,1,-1⟩ \\\\  & =⟨2,-1,2⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨1,-8,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 1+(-1)\\cdot (-8)+2\\cdot 4|}{\\sqrt{{1}^{2}+(-8)^{2}+{4}^{2}}} \\\\  & =\\frac{|2+8+8|}{\\sqrt{1+64+16}} \\\\  & =\\frac{|18|}{\\sqrt{81}} \\\\  & =2\\end{aligned}\n$$" 13194139534899 17592186045417 true] [17592186443268 1068 #edb/ref 17592186443263 13194139534899 17592186045417 true] [17592186443268 1069 "q-129142" 13194139534899 17592186045417 true] [17592186443268 1070 #edb/ref 17592186045487 13194139534899 17592186045417 true] [17592186443268 1071 "Find the shortest distance between the point $P(-3,2,6)$ and the plane $Π$ with equation $r\\cdot ⟨-2,4,4⟩=8.$" 13194139534899 17592186045417 true] [17592186443268 1072 #uuid "ee5f2c99-4524-5cc2-872a-3bdd6d04d82a" 13194139534899 17592186045417 true] [17592186443268 1074 "First, we need to find a point on the plane. If $r=⟨x,y,z⟩,$ we obtain\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-2,4,4⟩ & =8 \\\\ -2x+4y+4z & =8 \\\\ 4z & =8+2x-4y \\\\ z & =2+\\frac{x}{2}-y.\\end{aligned}\n$$\n\nSetting $x=2$ and $y=1,$ we get \n\n$$\nz=2+\\frac{2}{2}-1=2.\n$$\n\nSo, the point $Q(2,1,2)$ lies on the plane. \n\nNow, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,1,2⟩-⟨-3,2,6⟩ \\\\  & =⟨5,-1,-4⟩.\\end{aligned}\n$$\n\nFrom the equation of a plane, we get a normal vector $n=⟨-2,4,4⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|5\\cdot (-2)+(-1)\\cdot 4+(-4)\\cdot 4|}{\\sqrt{(-2)^{2}+{4}^{2}+{4}^{2}}} \\\\  & =\\frac{|-10-4-16|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|-30|}{\\sqrt{36}} \\\\  & =\\frac{30}{6} \\\\  & =5.\\end{aligned}\n$$" 13194139534899 17592186045417 true]] :edb/tempids {"answer-088db5f4-36d3-5c78-98a0-f200bd4afcc7" 17592186443241 "answer-168db077-1d3d-5cb0-b6aa-9a45c778361c" 17592186443242 "answer-1d85d58b-d2c6-50e6-b647-b9ac50af4bb1" 17592186443243 "answer-31b8c44f-f4d9-57d8-90d2-99d7decf9188" 17592186443244 "answer-466771cc-d368-518c-a407-118cef3850d5" 17592186443245 "answer-4a2a87c7-4871-52b2-9751-1dcf545d8473" 17592186443246 "answer-5ad1e3d5-d1ee-5ca4-bb25-a289369682c6" 17592186443247 "answer-5cbe681d-c67b-512a-b210-fd917c390fd5" 17592186443248 "answer-63d845d3-365f-535b-afff-d5908b0a7da2" 17592186443249 "answer-66952a23-b25c-549f-a606-5d6dda11f34c" 17592186443250 "answer-75964f2d-1d14-5218-b72a-c985ff68e537" 17592186443251 "answer-8c1