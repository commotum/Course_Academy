}{4})\\text{m}" #edb/ref 17592186045417] [17592186445735 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445735 #edb/ref 1083 #uuid "a2ef1d89-d277-5de1-9f67-b528494c18f1" #edb/ref 17592186045417] [17592186445736 #edb/ref 1080 "y(2)=(\\frac{\\operatorname{sin}⁡12}{6}-\\frac{1}{2})\\text{cm}" #edb/ref 17592186045417] [17592186445736 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445736 #edb/ref 1083 #uuid "c8676819-95da-5da8-9760-80284b82e282" #edb/ref 17592186045417] [17592186445737 #edb/ref 1080 "y(\\pi )=({e}^{\\pi }-1)\\text{m}" #edb/ref 17592186045417] [17592186445737 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445737 #edb/ref 1083 #uuid "ebb0d34a-111a-5f03-a468-2ba62a9a6c8f" #edb/ref 17592186045417] [17592186445738 #edb/ref 1080 "y(\\pi )=(2{e}^{\\pi }+\\frac{1}{2})\\text{m}" #edb/ref 17592186045417] [17592186445738 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186445738 #edb/ref 1083 #uuid "ec44def9-9e39-53ed-aff9-0f399cc5b8fb" #edb/ref 17592186045417] [17592186445739 #edb/ref 1075 #edb/ref 17592186445729 #edb/ref 17592186045417] [17592186445739 #edb/ref 1075 #edb/ref 17592186445732 #edb/ref 17592186045417] [17592186445739 #edb/ref 1075 #edb/ref 17592186445733 #edb/ref 17592186045417] [17592186445739 #edb/ref 1075 #edb/ref 17592186445734 #edb/ref 17592186045417] [17592186445739 #edb/ref 1075 #edb/ref 17592186445736 #edb/ref 17592186045417] [17592186445739 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186445739 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186445739 #edb/ref 1078 #edb/ref 17592186445732 #edb/ref 17592186045417] [17592186445739 #edb/ref 1079 #uuid "97ee9863-7827-5ffb-961e-95840bc8f69d" #edb/ref 17592186045417] [17592186445740 #edb/ref 1075 #edb/ref 17592186445730 #edb/ref 17592186045417] [17592186445740 #edb/ref 1075 #edb/ref 17592186445731 #edb/ref 17592186045417] [17592186445740 #edb/ref 1075 #edb/ref 17592186445735 #edb/ref 17592186045417] [17592186445740 #edb/ref 1075 #edb/ref 17592186445737 #edb/ref 17592186045417] [17592186445740 #edb/ref 1075 #edb/ref 17592186445738 #edb/ref 17592186045417] [17592186445740 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186445740 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186445740 #edb/ref 1078 #edb/ref 17592186445737 #edb/ref 17592186045417] [17592186445740 #edb/ref 1079 #uuid "aa0a7def-a246-5553-afa4-48288b187ed4" #edb/ref 17592186045417] [17592186445741 #edb/ref 1068 #edb/ref 17592186445740 #edb/ref 17592186045417] [17592186445741 #edb/ref 1069 "q-94301" #edb/ref 17592186045417] [17592186445741 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186445741 #edb/ref 1071 "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\n{y}^{″}+16y=17{e}^{t},\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $\\pi $ seconds." #edb/ref 17592186045417] [17592186445741 #edb/ref 1072 #uuid "071695a5-71a8-5be3-9519-3660055fc2db" #edb/ref 17592186045417] [17592186445741 #edb/ref 1074 "The general solution to the equation of forced harmonic motion without damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ represents simple harmonic motion and can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration.\n\nIn our case,\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThus, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t.\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is an exponential force. The constant factor in the exponent is $1,$ which is not a root of the auxiliary equation. Therefore, we assume a particular exponential solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{t},\n$$\n\nwhere $\\alpha $ is a constant to be determined.\n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =1.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)={e}^{t},\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t+{e}^{t}.\n$$\n\nSince the particle is initially at the origin with zero velocity, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=0.$\n\nSolving with these conditions for $A$ and $B$ gives\n\n$$\nA=-1,\\,B=-\\frac{1}{4}.\n$$\n\nSo our solution is\n\n$$\ny(t)=-\\operatorname{cos}⁡4t-\\frac{1}{4}\\operatorname{sin}⁡4t+{e}^{t}.\n$$\n\nTo find the position of the particle after $\\pi $ seconds, we substitute into the equation $t=\\pi .$ We get\n\n$$\n\\begin{aligned}y(\\pi ) & =-\\operatorname{cos}⁡4\\pi -\\frac{1}{4}\\operatorname{sin}⁡4\\pi +{e}^{\\pi } \\\\  & =({e}^{\\pi }-1)\\text{m}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445742 #edb/ref 1068 #edb/ref 17592186445739 #edb/ref 17592186045417] [17592186445742 #edb/ref 1069 "q-94309" #edb/ref 17592186045417] [17592186445742 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186445742 #edb/ref 1071 "The position $y(t),$ measured in centimeters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\n{y}^{″}+36y=18t,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with velocity $1\\,\\text{cm/s},$ find the position of the particle after $2$ seconds." #edb/ref 17592186045417] [17592186445742 #edb/ref 1072 #uuid "f3e9f427-a3b5-5de3-bad3-b21c91d9d341" #edb/ref 17592186045417] [17592186445742 #edb/ref 1074 "The general solution to the equation of forced harmonic motion without damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ represents simple harmonic motion and can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration.\n\nIn our case,\n\n$$\n{\\omega }^{2}=36\\,⟹\\,\\omega =6.\n$$\n\nThus, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡6t+B\\operatorname{sin}⁡6t.\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is a linear polynomial. Therefore, we assume that the particular integral is also a linear polynomial, i.e.\n\n$$\n{y}_{p}=\\alpha +\\beta t,\n$$\n\nwhere $\\alpha ,\\beta $ are constants to be determined.\n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =0,\\beta =\\frac{1}{2}.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=\\frac{t}{2},\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡6t+B\\operatorname{sin}⁡6t+\\frac{t}{2}.\n$$\n\nSince the particle is initially at the origin with velocity $1\\,\\text{cm/s}$, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=1.$\n\nSolving with these conditions for $A$ and $B$ gives\n\n$$\nA=0,\\,B=\\frac{1}{12}\n$$\n\nSo our solution is\n\n$$\ny(t)=\\frac{\\operatorname{sin}⁡6t}{12}+\\frac{t}{2}.\n$$\n\nTo find the position of the particle after $2$ seconds, we substitute into the equation $t=2.$ We get\n\n$$\n\\begin{aligned}y(2) & =\\frac{\\operatorname{sin}⁡6(2)}{12}+\\frac{(2)}{2} \\\\  & =(\\frac{\\operatorname{sin}⁡12}{12}+1)\\text{cm}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186445743 #edb/ref 1058 #edb/ref 17592186445745 #edb/ref 17592186045417] [17592186445743 #edb/ref 1062 #uuid "5a511ebc-694e-548d-808d-9bde7882c044" #edb/ref 17592186045417] [17592186445743 #edb/ref 1063 #edb/ref 17592186445742 #edb/ref 17592186045417] [17592186445744 #edb/ref 1058 #edb/ref 17592186445746 #edb/ref 17592186045417] [17592186445744 #edb/ref 1062 #uuid "84c18301-1b51-5f16-bb6b-0040c628eb02" #edb/ref 