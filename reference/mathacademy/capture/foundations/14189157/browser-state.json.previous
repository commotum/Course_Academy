      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336822-b116145a37f95bdd8d00.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336822-b116145a37f95bdd8d00.png",
      "source_url": "https://mathacademy.com/tasks/14189157/topics/1713/lesson",
      "captured_at": 1791928878.775466,
      "math_academy_id": "q-336822",
