      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336632-d3f7a3dfd33161b2a788.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336632-d3f7a3dfd33161b2a788.png",
      "source_url": "https://mathacademy.com/tasks/14189157/topics/1713/lesson",
      "captured_at": 1791928844.2308233,
      "math_academy_id": "q-336632",
      "topic_id": "1713",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q336632",
        "placement_id": null,
        "content_id": null,
