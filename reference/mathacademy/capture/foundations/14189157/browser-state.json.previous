      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336727-1fd534ae0da3913484ef.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336727-1fd534ae0da3913484ef.png",
      "source_url": "https://mathacademy.com/tasks/14189157/topics/1713/lesson",
      "captured_at": 1791928902.983784,
      "math_academy_id": "q-336727",
