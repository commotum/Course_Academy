      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336826-6e87b924718b575ee1ab.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14189157/observations/step-q336826-6e87b924718b575ee1ab.png",
      "source_url": "https://mathacademy.com/tasks/14189157/topics/1713/lesson",
      "captured_at": 1791928927.0596979,
      "math_academy_id": "q-336826",
