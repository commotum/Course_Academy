4139534333 17592186045417 true] [17592186419418 1077 "field-1" 13194139534333 17592186045417 true] [17592186419418 1078 #edb/ref 17592186419411 13194139534333 17592186045417 true] [17592186419418 1079 #uuid "51f6537d-feab-5ce3-9fc6-f89624d037a2" 13194139534333 17592186045417 true] [17592186419419 1075 #edb/ref 17592186419403 13194139534333 17592186045417 true] [17592186419419 1075 #edb/ref 17592186419405 13194139534333 17592186045417 true] [17592186419419 1075 #edb/ref 17592186419406 13194139534333 17592186045417 true] [17592186419419 1075 #edb/ref 17592186419410 13194139534333 17592186045417 true] [17592186419419 1075 #edb/ref 17592186419412 13194139534333 17592186045417 true] [17592186419419 1076 #edb/ref 17592186045493 13194139534333 17592186045417 true] [17592186419419 1077 "selection" 13194139534333 17592186045417 true] [17592186419419 1078 #edb/ref 17592186419405 13194139534333 17592186045417 true] [17592186419419 1079 #uuid "b30e511f-0a3e-547f-96f1-0bfc53ad4766" 13194139534333 17592186045417 true] [17592186419420 1075 #edb/ref 17592186419407 13194139534333 17592186045417 true] [17592186419420 1076 #edb/ref 17592186045492 13194139534333 17592186045417 true] [17592186419420 1077 "field-2" 13194139534333 17592186045417 true] [17592186419420 1078 #edb/ref 17592186419407 13194139534333 17592186045417 true] [17592186419420 1079 #uuid "c79424ce-ee00-57d0-b195-b7db6dde7351" 13194139534333 17592186045417 true] [17592186419421 1068 #edb/ref 17592186419416 13194139534333 17592186045417 true] [17592186419421 1068 #edb/ref 17592186419418 13194139534333 17592186045417 true] [17592186419421 1068 #edb/ref 17592186419420 13194139534333 17592186045417 true] [17592186419421 1069 "q-330576" 13194139534333 17592186045417 true] [17592186419421 1070 #edb/ref 17592186045485 13194139534333 17592186045417 true] [17592186419421 1071 "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$\\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.$\n\n{{field-1}}\n$x\\,+4y\\,-$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0$" 13194139534333 17592186045417 true] [17592186419421 1072 #uuid "53aad395-ec2e-5a47-9cdb-e404625e4482" 13194139534333 17592186045417 true] [17592186419421 1074 "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$" 13194139534333 17592186045417 true] [17592186419422 1068 #edb/ref 17592186419419 13194139534333 17592186045417 true] [17592186419422 1069 "q-70807" 13194139534333 17592186045417 true] [17592186419422 1070 #edb/ref 17592186045485 13194139534333 17592186045417 true] [17592186419422 1071 "Find a Cartesian equation of the plane that passes through the point $P(1,-1,1)$ and is perpendicular to the line \n$\\frac{x-2}{-1}=\\frac{y-1}{2}=\\frac{z+1}{1}.$" 13194139534333 17592186045417 true] [17592186419422 1072 #uuid "70aeaa22-2b90-533e-ab1d-9dbd9f885f48" 13194139534333 17592186045417 true] [17592186419422 1074 "First, we note that the position vector of $P$ is $p=⟨1,-1,1⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨-1,2,1⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨-1,2,1⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,1⟩ & =⟨1,-1,1⟩\\cdot ⟨-1,2,1⟩ \\\\ r\\cdot ⟨-1,2,1⟩ & =-2\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨-1,2,1⟩ & =-2 \\\\ -x+2y+z & =-2 \\\\ -x+2y+z+2 & =0 \\\\ x-2y-z-2 & =0.\\end{aligned}\n$$" 13194139534333 17592186045417 true] [17592186419423 1068 #edb/ref 17592186419417 13194139534333 17592186045417 true] [17592186419423 1069 "q-128459" 13194139534333 17592186045417 true] [17592186419423 1070 #edb/ref 17592186045486 13194139534333 17592186045417 true] [17592186419423 1071 "Find a Cartesian equation of the plane that passes through the points $A(1,-2,0)$, $P(3,-4,1)$ and $Q(2,1,-2).$" 13194139534333 17592186045417 true] [17592186419423 1072 #uuid "e08b1f6c-36a3-5d41-8737-49d26e8563c5" 13194139534333 17592186045417 true] [17592186419423 1074 "Note that the position vectors of the points $A,P$ and $Q$ are $a=⟨1,-2,0⟩,\\,p=⟨3,-4,1⟩,$ and $q=⟨2,1,-2⟩.$\n\nFirst, using the $3$ points we build $2$ vectors parallel to the plane:\n\n$$\n\\begin{aligned}{v}_{1} & =\\overset{\\to }{AP} \\\\  & =⟨3,-4,1⟩-⟨1,-2,0⟩ \\\\  & =⟨2,-2,1⟩ \\\\ {v}_{2} & =\\overset{\\to }{AQ} \\\\  & =⟨2,1,-2⟩-⟨1,-2,0⟩ \\\\  & =⟨1,3,-2⟩\\end{aligned}\n$$\n\n \n\nNow, we need to find the normal vector of the plane. To do that, we use the cross product of ${v}_{1}$ and ${v}_{2}$ as follows:\n\n$$\n\\begin{aligned}n & ={v}_{1}\\times {v}_{2} \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -2 & 1 \\\\ 1 & 3 & -2\\end{aligned}\\right| \\\\  & =i+5j+8k \\\\  & =⟨1,5,8⟩\\end{aligned}\n$$\n\nThen, using the dot product, we can find the equation of the plane:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨1,5,8⟩ & =⟨3,-4,1⟩\\cdot ⟨1,5,8⟩ \\\\ r\\cdot ⟨1,5,8⟩ & =-9\\end{aligned}\n$$\n\nFinally, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨1,5,8⟩ & =-9 \\\\ x+5y+8z & =-9 \\\\ x+5y+8z+9 & =0.\\end{aligned}\n$$" 13194139534333 17592186045417 true] [17592186419424 1058 #edb/ref 17592186419428 13194139534333 17592186045417 true] [17592186419424 1062 #uuid "4426cd88-0ed0-5a8a-bd40-151d1e9d59dd" 13194139534333 17592186045417 true] [17592186419424 1063 #edb/ref 17592186419422 13194139534333 17592186045417 true] [17592186419425 1058 #edb/ref 17592186419426 13194139534333 17592186045417 true] [17592186419425 1062 #uuid "62621dfb-b37e-5d44-bdc0-8c2aa74e902d" 13194139534333 17592186045417 true] [17592186419425 1063 #edb/ref 17592186419421 13194139534333 17592186045417 true] [17592186419426 1062 #uuid "6908c1c1-4988-5f64-8e7b-f1732fcb1a7f" 13194139534333 17592186045417 true] [17592186419426 1063 #edb/ref 17592186311671 13194139534333 17592186045417 true] [17592186419427 1058 #edb/ref 17592186419425 13194139534333 17592186045417 true] [17592186419427 1062 #uuid "6d308039-35f2-59e5-b262-324c1a8c2bf2" 13194139534333 17592186045417 true] [17592186419427 1063 #edb/ref 17592186419423 13194139534333 17592186045417 true] [17592186419428 1058 #edb/ref 17592186419427 13194139534333 17592186045417 true] [17592186419428 1062 #uuid "c018d688-d281-50de-9674-51b7847b124c" 13194139534333 17592186045417 true] [17592186419428 1063 #edb/ref 17592186262889 13194139534333 17592186045417 true]] :edb/tempids {"activity-0a7d7d24-69e8-5aec-803a-f5712a252473" 17592186419402 "answer-08c0fd5d-eb30-51ed-9d57-ff0d86d1b905" 17592186419403 "answer-102de1fa-9039-5418-a721-6fc419237fc4" 17592186419404 "answer-25dcf144-1a51-5366-9800-5383c00b5a7d" 17592186419405 "answer-2b822cf8-78b8-5c6f-ba5e-a61ce1027e3a" 17592186419406 "answer-373d6628-e7af-5c99-8ea7-bda3f45e1294" 17592186419407 "answer-66b70f6a-e851-54e5-aa28-b6a025e9ece5" 17592186419408 "answer-90536ec6-2590-5af2-a702-9be2e4b1ecdc" 17592186419409 "answer-aaf4ea99-1c7e-5b6b-af27-f81db06966e0" 17592186419410 "answer-b0061273-aae7-5a50-ba3b-7dbc44ba608c" 17592186419411 "answ