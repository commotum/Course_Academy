#{[{:db/id #edb/ref 17592186262889 :knowledge-point/_questions [{:db/id #edb/ref 17592186119834 :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f87268c-9742-5090-b7cb-521a5d8bbe66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,1⟩)\\cdot ⟨2,4,-4⟩=0" :db/id #edb/ref 17592186260021} {:answer/id #uuid "a390ff13-0937-5eb3-b38b-3df5883b8889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨-4,4,-2⟩=0" :db/id #edb/ref 17592186261300} {:answer/id #uuid "def43d7d-583f-5acb-a4e0-a37562571a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,-2,4⟩=0" :db/id #edb/ref 17592186261844} {:answer/id #uuid "f4c13bd5-c05b-5f70-93b5-0ba177da222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩=0" :db/id #edb/ref 17592186262013} {:answer/id #uuid "ffcc7a65-376c-57d0-ac3e-a501019e18ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨4,4,2⟩=0" :db/id #edb/ref 17592186262119}] :answer-field/correct {:answer/id #uuid "f4c13bd5-c05b-5f70-93b5-0ba177da222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩=0" :db/id #edb/ref 17592186262013} :answer-field/id #uuid "7b80e560-2ad7-58b7-9b2c-28eb67acbc7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f6aca53-4308-58bc-afcc-f2738d69d1e0" :question/math-academy-id "q-128380" :question/problem "Given the Cartesian equation $4x+4y-2z=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨4,4,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}4x+4y-2z & =0 \\\\ 2z & =4x+4y \\\\ z & =2x+2y.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=0.$ Hence, the point $P(0,0,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,0⟩)\\cdot ⟨4,4,-2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311671 :knowledge-point/_questions [{:db/id #edb/ref 17592186119834 :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ac71e4-1f43-51f8-bfa4-a92855f4700b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309261}] :answer-field/correct {:answer/id #uuid "43ac71e4-1f43-51f8-bfa4-a92855f4700b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186309261} :answer-field/id #uuid "7faaceec-cd8b-568a-858c-271760090279" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311144} {:answer-field/choices [{:answer/id #uuid "580b7964-a0b4-59ea-bd21-b56d80484ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309413}] :answer-field/correct {:answer/id #uuid "580b7964-a0b4-59ea-bd21-b56d80484ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186309413} :answer-field/id #uuid "93f3390e-533a-5d25-83c0-c5daa77f3ccf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311213} {:answer-field/choices [{:answer/id #uuid "0ccc2dae-6d3d-5c97-a2ff-2660720cb731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186308836}] :answer-field/correct {:answer/id #uuid "0ccc2dae-6d3d-5c97-a2ff-2660720cb731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186308836} :answer-field/id #uuid "95d0ab30-64b1-59c5-b1be-e3cbd8256de2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04886b81-54da-502a-b95c-1502eb418ce2" :question/math-academy-id "q-336241" :question/problem "Given the Cartesian equation $12y-6z-30=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$\n\n$(r-⟨0,0,$\n{{field-1}}\n$⟩)\\cdot ⟨0,$\n{{field-2}}\n,\n{{field-3}}\n$⟩=0$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,12,-6⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}12y-6z-30 & =0 \\\\ -6z & =-12y+30 \\\\ z & =2y-5\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-5.$ Hence, the point $P(0,0,-5)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-5⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-5⟩)\\cdot ⟨0,12,-6⟩ & =0.\\end{aligned}\n$$"}]}
