#{[{:db/id #edb/ref 17592186087569 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087753 :knowledge-point/id #uuid "f63a7522-8d05-5d3a-aafb-3450292f910f" :knowledge-point/title "Determining the Components of a Linear Map"}] :question/id #uuid "ae56bd17-f7f2-5c66-ac2a-663f05c6a838" :question/math-academy-id "e-5518" :question/problem "![](images/8d/8d5b37b3da99f0b93625ab8fd6ea72615da3159a8360fe267c3ae4a470fdd7af.svg)\nConsider the standard matrix $T$ of the linear transformation $\\mathbf{T}:\\mathbb{R}^2 \\to \\mathbb{R}^3$ shown above. What is the value of $a-b?$" :question/worked-solution "Given the vector ![](images/01/01841df44c0029de31dd06a446211abb0bc0f6852d7bc76797204ae1d9a71e6c.svg) we have\n\n$$\n\\begin{aligned}[\\begin{aligned}-8 & -5 \\\\ -3 & -6 \\\\ -4 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}-8x-5y \\\\ -3x-6y \\\\ -4x+5y\\end{aligned}] \\\\  & =[\\begin{aligned}-5y-8x \\\\ -3x-6y \\\\ 5y-4x\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\mathbf{T}$ is given by\n![](images/74/74c14f8d5615c146713a3c8ed31368a9843ed06f91d88a8745adf41764f8a003.svg)\n\nFinally, $a-b=(-5)-(-4)=-1.$"}] [{:db/id #edb/ref 17592186087570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087754 :knowledge-point/id #uuid "fb96cd29-b9f6-5b68-b43e-4a55ef8ffab2" :knowledge-point/title "Finding the Image of a Vector Under a Linear Map"}] :question/id #uuid "0ae354ba-19f3-570c-bbfc-56dd5dbbafa8" :question/math-academy-id "e-5519" :question/problem "Consider the matrix $T$ and the vector $\\mathbf{v}$ given below. If $T$ is the standard matrix of the linear transformation $\\mathbf{T}:\\mathbb{R}^3 \\to \\mathbb{R}^2,$ find $\\mathbf{T}(\\mathbf{v}).$\n\n![](images/46/46bb3e9777a3944eb6b2f458911571442f57a5fae2f7aed1bb924522c51cad4a.svg)" :question/worked-solution "Using the fact that $\\,\\mathbf{T}(\\mathbf{v})=T\\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}1 & -1 & 2 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087762 :knowledge-point/id #uuid "0e35b58a-530f-5b9b-8df2-eb737f8af581" :knowledge-point/title "Finding the Standard Matrix of a Linear Transformation"}] :question/id #uuid "9c24c0bb-f779-5518-8c44-70b3e51065a2" :question/math-academy-id "e-5901" :question/problem "Find the standard matrix that  represents  the  linear  transformation $\\mathbf{T}:\\mathbb{R}^3 \\to \\mathbb{R}^2,$ where\n![](images/fa/facc0c74a881851fc58355c5bf85ebb1e073d543a6c5e708e025ebbd61c69043.svg)" :question/worked-solution "We require a $2\\times 3$ matrix ${T}$ such that\n![](images/98/9839b4e4af6ba3ee215318c0a9b69844f33c0eea9bf426eb11701e60f3be91b3.svg)\n\nNotice that\n![](images/26/2697e4b0883667c64a7f1c24c370c6fb1f2e0b02c1c97d146cd9d5d9be17d963.svg)\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    ![](images/5c/5cb3e4da19858e479f72aa783381f97e846d820117c141681d5791b09490f8e8.svg)"}] [{:db/id #edb/ref 17592186436074 :knowledge-point/_questions [{:db/id #edb/ref 17592186087762 :knowledge-point/id #uuid "0e35b58a-530f-5b9b-8df2-eb737f8af581" :knowledge-point/title "Finding the Standard Matrix of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2966ef61-eca9-5559-a74b-278b39bfedaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 10 & -1 \\\\ 3 & -2 & 7 \\\\ -6 & 1 & 0 \\\\ 3 & -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186436048} {:answer/id #uuid "628defca-3da6-558b-ae06-2b8a5c25cb83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 5 & -1 \\\\ 3 & -2 & 7 \\\\ -6 & 1 & 0 \\\\ -3 & 8 & 0\\end{aligned}]" :db/id #edb/ref 17592186436054} {:answer/id #uuid "a0bb2cb9-6ad1-55c0-a805-436c0d8fe895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 5 & -1 \\\\ 3 & -2 & 1 \\\\ -6 & 1 & 0 \\\\ -5 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186436060} {:answer/id #uuid "c19c982f-5333-5821-8069-e8c510e12f7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 5 & -1 \\\\ 3 & -7 & 2 \\\\ -6 & 1 & 0 \\\\ -3 & 8 & 0\\end{aligned}]" :db/id #edb/ref 17592186436062} {:answer/id #uuid "fbc2ebcb-2249-5acb-9a0f-fbb1e11bec20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 5 & -1 \\\\ 0 & -2 & 7 \\\\ -6 & -2 & 0 \\\\ -3 & 8 & 0\\end{aligned}]" :db/id #edb/ref 17592186436066}] :answer-field/correct {:answer/id #uuid "628defca-3da6-558b-ae06-2b8a5c25cb83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 5 & -1 \\\\ 3 & -2 & 7 \\\\ -6 & 1 & 0 \\\\ -3 & 8 & 0\\end{aligned}]" :db/id #edb/ref 17592186436054} :answer-field/id #uuid "195d08c6-5530-555c-af06-ff33fffc4ac3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d43f6aa4-a331-53b3-b9d7-aed1378d0872" :question/math-academy-id "q-140366" :question/problem "Find the standard matrix that represents  the  linear  transformation $T:{R}^{3}\\to {R}^{4},$ where\n$T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}-4x-z+5y \\\\ 3x+7z-2y \\\\ -6x+y \\\\ 8y-3x\\end{aligned}].$" :question/worked-solution "We require a $4\\times 3$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}(-4)x+5y+(-1)z \\\\ 3x+(-2)y+7z \\\\ (-6)x+1y+0z \\\\ (-3)x+8y+0z\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-4 & 5 & -1 \\\\ 3 & -2 & 7 \\\\ -6 & 1 & 0 \\\\ -3 & 8 & 0\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-4x-z+5y \\\\ 3x+7z-2y \\\\ -6x+y \\\\ 8y-3x\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-4 & 5 & -1 \\\\ 3 & -2 & 7 \\\\ -6 & 1 & 0 \\\\ -3 & 8 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186088162 :knowledge-point/_questions [{:db/id #edb/ref 17592186087753 :knowledge-point/id #uuid "f63a7522-8d05-5d3a-aafb-3450292f910f" :knowledge-point/title "Determining the Components of a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "198f9d3a-d8f8-5868-bb18-4cfc9f66246e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324188} {:answer/id #uuid "3a2b3a9f-6493-5123-835f-ba98095037e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324441} {:answer/id #uuid "70ba5785-c92f-59c9-a7c6-8ed80e0956be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324899} {:answer/id #uuid "95820e02-504b-5f44-acca-c46158dff008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325244} {:answer/id #uuid "f01bdb77-f3e9-5308-85c9-d286613d7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186326088}] :answer-field/correct {:answer/id #uuid "95820e02-504b-5f44-acca-c46158dff008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325244} :answer-field/id #uuid "29aa0874-2f47-52c3-ba2d-b366fc704e05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37118a2e-2a8e-5cb5-9d41-f658c8b8e89f" :question/math-academy-id "q-38272" :question/problem "$$\nT=[\\begin{aligned}-3 & 1 \\\\ -2 & -8 \\\\ -9 & 7\\end{aligned}],\\,T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+y \\\\ ax-8y \\\\ -9x+by\\end{aligned}]\n$$\n\nConsider the standard matrix $T$ of the linear transformation $T:{R}^{2}\\to {R}^{3}$ shown above. What is the value of $a+b?$" :question/worked-solution "Given the vector $\\,[\\begin{aligned}x \\\\ y\\end{aligned}]\\,$ we have\n\n$$\n\\begin{aligned}[\\begin{aligned}-3 & 1 \\\\ -2 & -8 \\\\ -9 & 7\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}-3x+y \\\\ -2x-8y \\\\ -9x+7y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $T$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+y \\\\ -2x-8y \\\\ -9x+7y\\end{aligned}].\n$$\n\nFinally, $a+b=-2+7=5.$"}] [{:db/id #edb/ref 17592186436072 :knowledge-point/_questions [{:db/id #edb/ref 17592186087762 :knowledge-point/id #uuid "0e35b58a-530f-5b9b-8df2-eb737f8af581" :knowledge-point/title "Finding the Standard Matrix of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c79ee30-af5f-5bcf-8919-2afd0111f993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186436049} {:answer/id #uuid "848ef172-7da8-5389-b025-51826e69cb7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 & 1 \\\\ 1 & -1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186436056} {:answer/id #uuid "942631c7-0b88-56df-bbb6-0d0f79c6bd86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 & 0 \\\\ -1 & -1 & 0 \\\\ 1 & -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186436059} {:answer/id #uuid "b2cd1aa7-af9a-53f0-85ea-5b710aa150d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 & 1 \\\\ 1 & -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186436061} {:answer/id #uuid "e56ff332-5e02-5683-904b-61aded3e9a3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186436064}] :answer-field/correct {:answer/id #uuid "b2cd1aa7-af9a-53f0-85ea-5b710aa150d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 & 1 \\\\ 1 & -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186436061} :answer-field/id #uuid "c212f72a-279f-54ef-b120-28592cf65c59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43480c80-f56c-525c-8e3a-4535ddf6aa7b" :question/math-academy-id "q-8028" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T:{R}^{3}\\to {R}^{2},$ where\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2x-y+z \\\\ x-y-z\\end{aligned}].\n$$" :question/worked-solution "We require a $2\\times 3$ matrix $T$ such that\n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2x+(-1)y+1z \\\\ 1x+(-1)y+(-1)z\\end{aligned}].\n$$\n\nNotice that\n\n$$\n[\\begin{aligned}2 & -1 & 1 \\\\ 1 & -1 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2x-y+z \\\\ x-y-z\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}2 & -1 & 1 \\\\ 1 & -1 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186436073 :knowledge-point/_questions [{:db/id #edb/ref 17592186087753 :knowledge-point/id #uuid "f63a7522-8d05-5d3a-aafb-3450292f910f" :knowledge-point/title "Determining the Components of a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb5a88e-2c16-50c0-a11b-1857fef41b83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186436051} {:answer/id #uuid "4df16430-0c5c-51d3-b20c-0818ccaee58e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186436053} {:answer/id #uuid "89fb8e93-7da5-59dc-a467-6a051fba4e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186436057} {:answer/id #uuid "8db1b7fe-f0f1-5029-831c-002c537419e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436058} {:answer/id #uuid "d4787125-f5f3-5522-b754-798f786e8b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186436063}] :answer-field/correct {:answer/id #uuid "8db1b7fe-f0f1-5029-831c-002c537419e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436058} :answer-field/id #uuid "927c6a5b-b400-51f5-ba26-11160c313dcf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436069}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93b16baf-60a0-5351-9b6d-e1dbecba8523" :question/math-academy-id "q-96976" :question/problem "$$\nT=[\\begin{aligned}5 & 3 \\\\ -2 & 4 \\\\ 3 & -1\\end{aligned}]\\,\\,T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}3y+ax \\\\ bx+4y \\\\ cy+3x\\end{aligned}]\n$$\n\nConsider the standard matrix $T$ of the linear transformation $T:{R}^{2}\\to {R}^{3}$ shown above. What is the value of $a+b+c?$" :question/worked-solution "Given the vector $\\,[\\begin{aligned}x \\\\ y\\end{aligned}]\\,$ we have\n\n$$\n\\begin{aligned}[\\begin{aligned}5 & 3 \\\\ -2 & 4 \\\\ 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}5x+3y \\\\ -2x+4y \\\\ 3x-y\\end{aligned}] \\\\  & =[\\begin{aligned}3y+5x \\\\ -2x+4y \\\\ -y+3x\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the linear transformation $T$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}3y+5x \\\\ (-2)x+4y \\\\ (-1)y+3x\\end{aligned}].\n$$\n\nFinally, $a+b+c=5+(-2)+(-1)=2.$"}] [{:db/id #edb/ref 17592186360746 :knowledge-point/_questions [{:db/id #edb/ref 17592186087754 :knowledge-point/id #uuid "fb96cd29-b9f6-5b68-b43e-4a55ef8ffab2" :knowledge-point/title "Finding the Image of a Vector Under a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce84ad1-2326-5d42-bf5a-617d9c215fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 5 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358154} {:answer/id #uuid "45cad482-7744-5860-b54c-2ebc9db9e736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ 8 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186358347} {:answer/id #uuid "8764559c-4acd-5314-8718-808a666c54d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186358937} {:answer/id #uuid "a764a257-5424-5d56-9cc3-7feaa96c3b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ 5 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186359197} {:answer/id #uuid "e338e103-85c3-543b-80df-394716f7f4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 3 \\\\ -15\\end{aligned}]" :db/id #edb/ref 17592186359763}] :answer-field/correct {:answer/id #uuid "8764559c-4acd-5314-8718-808a666c54d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186358937} :answer-field/id #uuid "04ac022c-99a1-5efb-a042-aaaaa443a977" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92e50827-c106-565d-b3bc-40d269fedf11" :question/math-academy-id "q-97027" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T:{R}^{2}\\to {R}^{3},$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-4 & 2 \\\\ 2 & 1 \\\\ 3 & -5\\end{aligned}],\\,v=[\\begin{aligned}2 \\\\ 3\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-4 & 2 \\\\ 2 & 1 \\\\ 3 & -5\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436071 :knowledge-point/_questions [{:db/id #edb/ref 17592186087754 :knowledge-point/id #uuid "fb96cd29-b9f6-5b68-b43e-4a55ef8ffab2" :knowledge-point/title "Finding the Image of a Vector Under a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dde21cb-d15c-5e2a-8f75-04c7a50e62ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 28 \\\\ 15 \\\\ -14\\end{aligned}]" :db/id #edb/ref 17592186436047} {