#{[{:db/id #edb/ref 17592186087569 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087753 :knowledge-point/id #uuid "f63a7522-8d05-5d3a-aafb-3450292f910f" :knowledge-point/title "Determining the Components of a Linear Map"}] :question/id #uuid "ae56bd17-f7f2-5c66-ac2a-663f05c6a838" :question/math-academy-id "e-5518" :question/problem "![](images/bf/bfdf3147fb8488c3a0032f9dad326b5d8c3ff68be46738dc39215e5098af6272.png)\nConsider the standard matrix $T$ of the linear transformation $\\mathbf{T}:\\mathbb{R}^2 \\to \\mathbb{R}^3$ shown above. What is the value of $a-b?$" :question/worked-solution "Given the vector ![](images/35/35814ac6d965ac688907d162b45d9b0b194ea40375d4e474466e4fb4b1de1c1b.png) we have\n\n$$\n\\begin{aligned}[\\begin{aligned}-8 & -5 \\\\ -3 & -6 \\\\ -4 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}-8x-5y \\\\ -3x-6y \\\\ -4x+5y\\end{aligned}] \\\\  & =[\\begin{aligned}-5y-8x \\\\ -3x-6y \\\\ 5y-4x\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\mathbf{T}$ is given by\n![](images/f5/f59824c26875665fcbd8adfc5414fa7b0c60254e01f725f9ca72cf1d370a3e8b.png)\n\nFinally, $a-b=(-5)-(-4)=-1.$"}] [{:db/id #edb/ref 17592186087570 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087754 :knowledge-point/id #uuid "fb96cd29-b9f6-5b68-b43e-4a55ef8ffab2" :knowledge-point/title "Finding the Image of a Vector Under a Linear Map"}] :question/id #uuid "0ae354ba-19f3-570c-bbfc-56dd5dbbafa8" :question/math-academy-id "e-5519" :question/problem "Consider the matrix $T$ and the vector $\\mathbf{v}$ given below. If $T$ is the standard matrix of the linear transformation $\\mathbf{T}:\\mathbb{R}^3 \\to \\mathbb{R}^2,$ find $\\mathbf{T}(\\mathbf{v}).$\n\n![](images/7a/7a6d4db6774da29f9b89996e348fad61b281737db6b44e9a39efa016fa2f15f3.png)" :question/worked-solution "Using the fact that $\\,\\mathbf{T}(\\mathbf{v})=T\\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}1 & -1 & 2 \\\\ 3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087584 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087762 :knowledge-point/id #uuid "0e35b58a-530f-5b9b-8df2-eb737f8af581" :knowledge-point/title "Finding the Standard Matrix of a Linear Transformation"}] :question/id #uuid "9c24c0bb-f779-5518-8c44-70b3e51065a2" :question/math-academy-id "e-5901" :question/problem "Find the standard matrix that  represents  the  linear  transformation $\\mathbf{T}:\\mathbb{R}^3 \\to \\mathbb{R}^2,$ where\n![](images/81/81d01f5d724e8b9d186bc53a15b488868c5c2d5d661f09d7c1febd862011afba.png)" :question/worked-solution "We require a $2\\times 3$ matrix ${T}$ such that\n![](images/41/412113c303aa31d5a9c23d5b0fa45201a8803b96f5239b9b1d007fc5128413c9.png)\n\nNotice that\n![](images/bc/bcd58c5310e4312fdbcc5619e0a89a03afb9bd5a6adff9a851e34d19e2bafb0b.png)\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    ![](images/67/67da7147fc2e767f6c1fe15d2664d7f0b0e5f7b0778b168c6f702d2b999a2799.png)"}] [{:db/id #edb/ref 17592186088162 :knowledge-point/_questions [{:db/id #edb/ref 17592186087753 :knowledge-point/id #uuid "f63a7522-8d05-5d3a-aafb-3450292f910f" :knowledge-point/title "Determining the Components of a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "198f9d3a-d8f8-5868-bb18-4cfc9f66246e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186324188} {:answer/id #uuid "3a2b3a9f-6493-5123-835f-ba98095037e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324441} {:answer/id #uuid "70ba5785-c92f-59c9-a7c6-8ed80e0956be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324899} {:answer/id #uuid "95820e02-504b-5f44-acca-c46158dff008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325244} {:answer/id #uuid "f01bdb77-f3e9-5308-85c9-d286613d7118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186326088}] :answer-field/correct {:answer/id #uuid "95820e02-504b-5f44-acca-c46158dff008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186325244} :answer-field/id #uuid "29aa0874-2f47-52c3-ba2d-b366fc704e05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37118a2e-2a8e-5cb5-9d41-f658c8b8e89f" :question/math-academy-id "q-38272" :question/problem "$$\nT=[\\begin{aligned}-3 & 1 \\\\ -2 & -8 \\\\ -9 & 7\\end{aligned}],\\,T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+y \\\\ ax-8y \\\\ -9x+by\\end{aligned}]\n$$\n\nConsider the standard matrix $T$ of the linear transformation $T:{R}^{2}\\to {R}^{3}$ shown above. What is the value of $a+b?$" :question/worked-solution "Given the vector $\\,[\\begin{aligned}x \\\\ y\\end{aligned}]\\,$ we have\n\n$$\n\\begin{aligned}[\\begin{aligned}-3 & 1 \\\\ -2 & -8 \\\\ -9 & 7\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}-3x+y \\\\ -2x-8y \\\\ -9x+7y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $T$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+y \\\\ -2x-8y \\\\ -9x+7y\\end{aligned}].\n$$\n\nFinally, $a+b=-2+7=5.$"}] [{:db/id #edb/ref 17592186360746 :knowledge-point/_questions [{:db/id #edb/ref 17592186087754 :knowledge-point/id #uuid "fb96cd29-b9f6-5b68-b43e-4a55ef8ffab2" :knowledge-point/title "Finding the Image of a Vector Under a Linear Map"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce84ad1-2326-5d42-bf5a-617d9c215fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 5 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186358154} {:answer/id #uuid "45cad482-7744-5860-b54c-2ebc9db9e736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ 8 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186358347} {:answer/id #uuid "8764559c-4acd-5314-8718-808a666c54d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186358937} {:answer/id #uuid "a764a257-5424-5d56-9cc3-7feaa96c3b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ 5 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186359197} {:answer/id #uuid "e338e103-85c3-543b-80df-394716f7f4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 3 \\\\ -15\\end{aligned}]" :db/id #edb/ref 17592186359763}] :answer-field/correct {:answer/id #uuid "8764559c-4acd-5314-8718-808a666c54d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186358937} :answer-field/id #uuid "04ac022c-99a1-5efb-a042-aaaaa443a977" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92e50827-c106-565d-b3bc-40d269fedf11" :question/math-academy-id "q-97027" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T:{R}^{2}\\to {R}^{3},$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-4 & 2 \\\\ 2 & 1 \\\\ 3 & -5\\end{aligned}],\\,v=[\\begin{aligned}2 \\\\ 3\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-4 & 2 \\\\ 2 & 1 \\\\ 3 & -5\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 7 \\\\ -9\\end{aligned}].\\end{aligned}\n$$"}]}
