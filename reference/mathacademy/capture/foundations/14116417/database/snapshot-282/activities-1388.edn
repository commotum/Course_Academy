#{[{:activity/first-step {:db/id #edb/ref 17592186106768} :activity/id #uuid "515492e4-a1e3-5a32-b6be-2b3b52ae8e6b" :activity/scope {:db/id #edb/ref 17592186050327 :topic/id #uuid "4036942d-b5d5-592a-a620-1e02dcc440fc" :topic/math-academy-id 1388} :activity/steps [{:db/id #edb/ref 17592186106766 :step/content {:db/id #edb/ref 17592186105823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105657 :question/id #uuid "9a5697c7-0aa6-55d9-898c-6e954960df42" :question/math-academy-id "e-7388"} :knowledge-point/id #uuid "4f8fd8a4-1ca2-521d-8542-d11311bcc586" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048317}] :knowledge-point/questions [{:db/id #edb/ref 17592186106502} {:db/id #edb/ref 17592186106503} {:db/id #edb/ref 17592186369609} {:db/id #edb/ref 17592186369616} {:db/id #edb/ref 17592186371180} {:db/id #edb/ref 17592186371187}] :knowledge-point/title "Computing Variance Using the Definition Given a Probability Mass Function"} :step/id #uuid "028fa34b-a8a4-59cc-9914-96d5fd012ef1" :step/math-academy-id 27395 :step/next {:db/id #edb/ref 17592186106773}} {:db/id #edb/ref 17592186106767 :step/content {:db/id #edb/ref 17592186105824 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105658 :question/id #uuid "ee9c8798-408e-507a-8205-8f16c672c767" :question/math-academy-id "e-7390"} :knowledge-point/id #uuid "1e448e28-466c-5051-9ada-5e030e6a8ff7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048914}] :knowledge-point/questions [{:db/id #edb/ref 17592186106504} {:db/id #edb/ref 17592186106505} {:db/id #edb/ref 17592186369623} {:db/id #edb/ref 17592186371146} {:db/id #edb/ref 17592186371153} {:db/id #edb/ref 17592186371229} {:db/id #edb/ref 17592186371236} {:db/id #edb/ref 17592186382538} {:db/id #edb/ref 17592186382545} {:db/id #edb/ref 17592186410471} {:db/id #edb/ref 17592186410474}] :knowledge-point/title "Computing the Standard Deviation of a Random Variable"} :step/id #uuid "6c8ce025-dadf-5d0d-8ee0-545c8dfe0d11" :step/math-academy-id 27397 :step/next {:db/id #edb/ref 17592186106811}} {:db/id #edb/ref 17592186106768 :step/content {:db/id #edb/ref 17592186107104 :tutorial/content "The **variance** of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\\textrm{Var}[X] = \\sum\\limits_{x \\in S} (x - \\textrm E[X])^2 \\cdot f(x).$$\n\nIn other words, the variance is the expected value of the squared difference between $X$ and the expected value of $X{:}$\n\n$$\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ]$$\n\nThe variance quantifies how \"spread out\" a probability distribution is. The expected value $\\textrm E[X]$ can be interpreted as the \"center\" of a probability distribution, and the squared difference $(X - \\textrm E[X])^2$ represents the squared distance between $X$ and the center. So, the variance quantifies how far the possible values of $X$ are from the center, on average.\n\nIn general,\n\n- a probability distribution that is *spread out* over many possible values will have a *high* variance, while\n- a probability distribution that is *concentrated* (or *clumped*) near a single value will have a *low* variance." :tutorial/id #uuid "3f7e3cc9-a0b0-5b16-8e87-4f10bbf73aee" :tutorial/math-academy-id 4450 :tutorial/title "Introduction"} :step/id #uuid "a71679e2-16b2-5111-beea-f73fd76821b5" :step/math-academy-id 27399 :step/next {:db/id #edb/ref 17592186106766}} {:db/id #edb/ref 17592186106773 :step/content {:db/id #edb/ref 17592186107106 :tutorial/content "Using the properties of the expected value of a discrete random variable $X,$ we can arrive at the following alternative formula for the variance of $X{:}$\n\n$$\\textrm{Var}[X] = \\textrm E [ X^2 ] - \\textrm E[X]^2$$\n\nAs we will see in the following example, using this formula often speeds up the process of computing the variance." :tutorial/id #uuid "ce108c7b-5e89-59e8-846f-bcf203c4ee79" :tutorial/math-academy-id 4467 :tutorial/title "A Formula for Quickly Computing the Variance"} :step/id #uuid "76a6780c-6404-599d-aa2e-2e6aa5ac7552" :step/math-academy-id 27500 :step/next {:db/id #edb/ref 17592186106775}} {:db/id #edb/ref 17592186106774 :step/content {:db/id #edb/ref 17592186105828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105662 :question/id #uuid "fcd99105-cd96-57d0-b5df-b6230f18a181" :question/math-academy-id "e-7415"} :knowledge-point/id #uuid "0e6a0c79-9597-5fca-9d41-305c541a7bdf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048516}] :knowledge-point/questions [{:db/id #edb/ref 17592186106506} {:db/id #edb/ref 17592186106507} {:db/id #edb/ref 17592186369630} {:db/id #edb/ref 17592186369637} {:db/id #edb/ref 17592186371208} {:db/id #edb/ref 17592186371215} {:db/id #edb/ref 17592186371222} {:db/id #edb/ref 17592186380782} {:db/id #edb/ref 17592186410472}] :knowledge-point/title "Computing Variance Given a Probability Mass Function"} :step/id #uuid "1a2016b4-48a7-5dfc-93b3-a9521cc2b661" :step/math-academy-id 27501 :step/next {:db/id #edb/ref 17592186106778}} {:db/id #edb/ref 17592186106775 :step/content {:db/id #edb/ref 17592186105829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105663 :question/id #uuid "f07a0b1e-2b90-5b83-b9e2-a8da0bedf044" :question/math-academy-id "e-7416"} :knowledge-point/id #uuid "11b6d79a-b13d-5e77-899d-8b1b91c872b8" :knowledge-point/questions [{:db/id #edb/ref 17592186106508} {:db/id #edb/ref 17592186106509} {:db/id #edb/ref 17592186367254} {:db/id #edb/ref 17592186369588} {:db/id #edb/ref 17592186369595} {:db/id #edb/ref 17592186369602} {:db/id #edb/ref 17592186382531} {:db/id #edb/ref 17592186410470} {:db/id #edb/ref 17592186410473}] :knowledge-point/title "Computing Variance Given the Expected Value of a Random Variable and Its Square"} :step/id #uuid "12f495d3-24c3-58a9-82e9-2a310279a966" :step/math-academy-id 27502 :step/next {:db/id #edb/ref 17592186106774}} {:db/id #edb/ref 17592186106778 :step/content {:db/id #edb/ref 17592186107108 :tutorial/content "The **standard deviation** of a random variable $X$ is defined as the square root of the variance:\n\n$$\n\\textrm{SD}[X] = \\sqrt{\\textrm{Var}[X]}\n$$\n\nAs we will see in the future, the standard deviation is often used when we observe a random variable and wish to quantify how \"surprising\" a particular observation was.\n\nIn those contexts, we often compute how many standard deviations the observed value was away from the expected value: the further away, the more surprising the observation.\n\nFor now, though, let's get some practice computing the standard deviation of a random variable." :tutorial/id #uuid "802e056f-a5ea-57cc-bc0b-a1ff76db978f" :tutorial/math-academy-id 4508 :tutorial/title "The Standard Deviation of a Random Variable"} :step/id #uuid "69237ed9-885c-540d-8048-db64edded5dd" :step/math-academy-id 27749 :step/next {:db/id #edb/ref 17592186106767}} {:db/id #edb/ref 17592186106811 :step/content {:db/id #edb/ref 17592186107122 :tutorial/content "We wish to prove the following formula for the variance:\n\n$$\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2$$\n\nTo begin, recall that the variance of a random variable $X$ is defined as\n\n$$\\textrm{Var}[X] = \\textrm E [ (X - \\textrm E[X])^2 ].$$\n\nExpanding out the perfect square, we get\n\n$$\\textrm{Var}[X] =\\textrm E [ X^2 - 2\\textrm E[X] \\cdot X + \\textrm E[X]^2 ] .$$\n\nThen, distributing the expectation over the sum, we get\n\n$$\\textrm{Var}[X] = \\textrm E [ X^2 ] + \\textrm E[ - 2\\textrm E[X] \\cdot X ] + \\textrm E[ \\textrm E[X]^2 ] .$$\n\nNow, we make the following simplifications:\n\n- Since $\\textrm E[aX] = a \\textrm E[X]$ for any constant $a,$ we can write $$\\textrm E[{\\color{blue}-2 \\textrm E[X]} \\cdot X] = {\\color{blue}- 2\\textrm E[X]} \\cdot \\textrm E[ X ] = - 2\\textrm E[X]^2.$$\n- Since $\\textrm{E}[X]$ is a constant, and $\\textrm E[a] = a$ for any constant $a,$ we can write $$\\textrm E[ {\\color{blue}\\textrm E[X]^2} ] = {\\color{blue}\\textrm E[X]^2}.$$\n\nSo, we have\n\n$$\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]+\\text{E}[-2\\text{E}[X]\\cdot X]+\\text{E}[E[X]^{2}] \\\\ & =\\text{E}[{X}^{2}]-2\\text{E}[X]^{2}+\\text{E}[X]^{2} \\\\ & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\\end{aligned}$$" :tutorial/id #uuid "839800ad-eaf8-58c6-b040-ec22eea833bf" :tutorial/math-academy-id 5259 :tutorial/title "Proving the Formula For the Variance in Terms of First and Second Raw Moments"} :step/id #uuid "8309d975-89e3-537f-8957-da5440c1379a" :step/math-academy-id 32921}] :activity/title "Variance of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106011}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186410478} :activity/id #uuid "e5b31a51-b371-5488-b122-30f345567779" :activity/scope {:db/id #edb/ref 17592186050327 :topic/id #uuid "4036942d-b5d5-592a-a620-1e02dcc440fc" :topic/math-academy-id 1388} :activity/steps [{:db/id #edb/ref 17592186410475 :step/content {:db/id #edb/ref 17592186410474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10210515-50f6-5fd6-8a48-684006b7b4c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186410441} {:answer/id #uuid "399366e9-b329-589f-b6b7-c66173898456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{25}" :db/id #edb/ref 17592186410445} {:answer/id #uuid "5ae5a64a-b213-5535-92c5-38a856f25be0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186410449} {:answer/id #uuid "c554640b-d225-5526-832d-c61f7bfe9dd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{3}}{5}" :db/id #edb/ref 17592186410458} {:answer/id #uuid "dcd4de70-0442-5c0e-83ef-ae71c8ba8451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{5}}{3}" :db/id #edb/ref 17592186410460}] :answer-field/correct {:db/id #edb/ref 17592186410458} :answer-field/id #uuid "02c755b2-7fc7-5fd5-a6c9-1e35ce8c1cf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410465}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ff9e2b0-8e44-5179-bc73-cbf11e934efb" :question/math-academy-id "q-84312" :question/problem "Two biased coins are tossed several times. The results are recorded below. Based on this data, if the random variable $X$ represents the number of heads obtained on a random toss, what is $\\text{SD}[X]?$\n\n| Number of heads | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| Frequency | $4$ | $12$ | $9$ |" :question/worked-solution "The standard deviation of a random variable $X$ is defined as\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]},\n$$\n\nwhere the variance can be computed using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we need to compute the probability mass function $f(x).$ To do this, we divide each frequency by the total, which is $4+12+9=25.$ We get the following result:\n\n| $x$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{4}{25}$ | $\\frac{12}{25}$ | $\\frac{9}{25}$ |\n\nNow, we compute $\\text{E}[X]$ by summing up the products of each value of $X$ and its associated probability:\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2) \\\\  & =0(\\frac{4}{25})+1(\\frac{12}{25})+2(\\frac{9}{25}) \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nThen, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2) \\\\  & =0(\\frac{4}{25})+1(\\frac{12}{25})+4(\\frac{9}{25}) \\\\  & =\\frac{48}{25}.\\end{aligned}\n$$\n\nSo, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{48}{25}-{(\\frac{6}{5})}^{2} \\\\  & =\\frac{48}{25}-\\frac{36}{25} \\\\  & =\\frac{12}{25}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]} \\\\  & =\\sqrt{\\frac{12}{25}} \\\\  & =\\frac{2\\sqrt{3}}{5}.\\end{aligned}\n$$"} :step/id #uuid "2b426a90-801f-55fb-8b5f-1d3d9be30906" :step/next {:db/id #edb/ref 17592186410479}} {:db/id #edb/ref 17592186410476 :step/content {:db/id #edb/ref 17592186410471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628c0069-f4dc-53cd-aed0-ecb82d580e1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{4}" :db/id #edb/ref 17592186410451} {:answer/id #uuid "7343a751-cd78-5b59-8011-1e74e9d823c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{16}" :db/id #edb/ref 17592186410452} {:answer/id #uuid "bc3fe6f1-6e29-5dfa-896a-f38bb44b409d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{4}" :db/id #edb/ref 17592186410456} {:answer/id #uuid "e169670d-6976-5ddd-bc4f-8bbaef5c24d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{2}" :db/id #edb/ref 17592186410461} {:answer/id #uuid "f1b9a1a2-e3e4-59b1-8b62-123fabfad613" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{21}}{4}" :db/id #edb/ref 17592186410463}] :answer-field/correct {:db/id #edb/ref 17592186410456} :answer-field/id #uuid "54f3e13c-4881-5f73-95a1-cd084b9b5b78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410468}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4ddfb506-4076-564a-9cbf-01888893404d" :question/math-academy-id "q-129110" :question/problem "Two fair  four-sided dice are rolled and $X$ is the absolute difference of their scores. The probability mass function $f(x)$ of $X$ is shown in the table below. What is $\\text{SD}[X]?$ \n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{4}$ | $\\frac{3}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |" :question/worked-solution "The standard deviation of a random variable $X$ is defined as\n\n$$\n\\text{SD}[X]=\\sqrt{\\text{Var}[X]},\n$$\n\nwhere the variance can be computed using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we need to compute $\\text{E}[X].$ Summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{1}{4})+1(\\frac{3}{8})+2(\\frac{1}{4})+3(\\frac{1}{8}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$\n\nNext, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{3}^{2}\\cdot f(3) \\\\  & =0(\\frac{1}{4})+1(\\frac{3}{8})+4(\\frac{1}{4})+9(\\frac{1}{8}) \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$\n\nSo, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{2}-{(\\frac{5}{4})}^{2} \\\\  & =\\frac{5}{2}-\\frac{25}{16} \\\\  & =\\frac{15}{16}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]} \\\\  & =\\sqrt{\\frac{15}{16}} \\\\  & =\\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$"} :step/id #uuid "4b5ba88d-07e2-53f4-8395-7114e2e0abf0" :step/next {:db/id #edb/ref 17592186410477}} {:db/id #edb/ref 17592186410477 :step/content {:db/id #edb/ref 17592186410472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047e735d-3969-505a-9203-00c72a2a1536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186410440} {:answer/id #uuid "40d9a509-d081-50a4-b65c-ab3d251ab47f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{16}" :db/id #edb/ref 17592186410447} {:answer/id #uuid "89c3d463-5efb-5519-a3d9-13f042900afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{64}" :db/id #edb/ref 17592186410453} {:answer/id #uuid "a10dddf4-6af0-5fe9-b6c8-1e9bdf070f41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{399}{16}" :db/id #edb/ref 17592186410454} {:answer/id #uuid "d9fb09aa-f54c-525c-8398-39a7537c8a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{399}{256}" :db/id #edb/ref 17592186410459}] :answer-field/correct {:db/id #edb/ref 17592186410459} :answer-field/id #uuid "1c1ad2dd-49e4-5c02-ac98-f746b50c5d1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410467}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "967806ee-7237-5a36-94c7-46285ecfda95" :question/math-academy-id "q-129376" :question/problem "Let $X$ be the number obtained by a spinner with five sections labeled $-2,-1,0,1,2.$ The probability mass function $f(x)$ of $X$ is shown in the table below. What is $\\text{Var}[X]?$\n\n| $x$ | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{3}{8}$ | $\\frac{1}{16}$ | $\\frac{3}{16}$ |" :question/worked-solution "We can compute the variance of a discrete random variable $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we compute $\\text{E}[X].$ Summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =(-2)\\cdot f(-2)+(-1)\\cdot f(-1)+0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2) \\\\  & =(-2)(\\frac{1}{8})+(-1)(\\frac{1}{4})+0(\\frac{3}{8})+1(\\frac{1}{16})+2(\\frac{3}{16}) \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$\n\nNext, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & =(-2)^{2}\\cdot f(-2)+(-1)^{2}\\cdot f(-1)+{0}^{2}\\cdot f(0)+{1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2) \\\\  & =4(\\frac{1}{8})+1(\\frac{1}{4})+0(\\frac{3}{8})+1(\\frac{1}{16})+4(\\frac{3}{16}) \\\\  & =\\frac{25}{16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{25}{16}-{(-\\frac{1}{16})}^{2} \\\\  & =\\frac{25}{16}-\\frac{1}{256} \\\\  & =\\frac{400}{256}-\\frac{1}{256} \\\\  & =\\frac{399}{256}.\\end{aligned}\n$$"} :step/id #uuid "82ecb467-de22-5a65-9b65-2ff0b4a44bd1"} {:db/id #edb/ref 17592186410478 :step/content {:db/id #edb/ref 17592186410473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123d88b7-9486-5594-8990-9a41d6aa27a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{39}{50}" :db/id #edb/ref 17592186410442} {:answer/id #uuid "3e2bbc05-907f-5fa2-9ace-d03b3459805d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{19}{20}" :db/id #edb/ref 17592186410446} {:answer/id #uuid "5dfbb2b0-4850-57fe-8e1c-d722559c182b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{71}{100}" :db/id #edb/ref 17592186410450} {:answer/id #uuid "c23e1601-7810-56cc-855c-b729ce1acc00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186410457} {:answer/id #uuid "f787ac39-f172-5118-a383-007f850a6ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{20}" :db/id #edb/ref 17592186410464}] :answer-field/correct {:db/id #edb/ref 17592186410450} :answer-field/id #uuid "5db94061-cdf0-57e7-b013-67cd72f1cc89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410469}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9682caf0-f7aa-52f6-bd4c-fbe55d6bcce7" :question/math-academy-id "q-84011" :question/problem "If $\\text{E}[X]=\\frac{1}{5}$ and $\\text{E}[{X}^{2}]=\\frac{3}{4},$ then what is $\\text{Var}[X]?$" :question/worked-solution "We can compute the variance of a discrete random variable $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nSubstituting the given values, we get\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{3}{4}-{(\\frac{1}{5})}^{2} \\\\  & =\\frac{3}{4}-\\frac{1}{25} \\\\  & =\\frac{71}{100}.\\end{aligned}\n$$"} :step/id #uuid "830532d5-435c-5cac-81d0-fdec53f8680a" :step/next {:db/id #edb/ref 17592186410475}} {:db/id #edb/ref 17592186410479 :step/content {:db/id #edb/ref 17592186410470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed145e5-087e-56e2-80eb-24dc50414611" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.75" :db/id #edb/ref 17592186410443} {:answer/id #uuid "3937a3f3-920e-5c2f-98af-12f757383422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.25" :db/id #edb/ref 17592186410444} {:answer/id #uuid "53f16ff1-450b-5809-bf24-4f3c185fd10d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14.5" :db/id #edb/ref 17592186410448} {:answer/id #uuid "b4f52ebb-0c61-592e-8a74-5f0d2f15fc74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.75" :db/id #edb/ref 17592186410455} {:answer/id #uuid "e9f8b5b6-10b0-5105-b628-7b0dc2fbd0c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.75" :db/id #edb/ref 17592186410462}] :answer-field/correct {:db/id #edb/ref 17592186410443} :answer-field/id #uuid "07f8e5d2-1889-5242-bed6-fdf3e44b48d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410466}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0683e8b5-6ceb-57c0-9d04-c3d2e66cf5c1" :question/math-academy-id "q-129041" :question/problem "If $\\text{E}[X]=3.5$ and $\\text{E}[{X}^{2}]=18,$ then what is $\\text{Var}[X]?$" :question/worked-solution "We can compute the variance of a discrete random variable $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nSubstituting the given values, we get\n\n$$\n\\begin{aligned}\\text{Var}[X] & =18-{3.5}^{2} \\\\  & =18-12.25 \\\\  & =5.75.\\end{aligned}\n$$"} :step/id #uuid "a0fe4695-9b16-52f4-92f9-3e4ce0243984" :step/next {:db/id #edb/ref 17592186410476}}] :activity/title "Variance of Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410439}]}
