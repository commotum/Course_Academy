ng=\"0em\" rowspacing=\"0.8em 0.8em 0.8em\"><mtr><mtd><mtext>SD</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><msqrt><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>15</mn><mn>16</mn></mfrac></mstyle></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>15</mn></msqrt><mn>4</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
