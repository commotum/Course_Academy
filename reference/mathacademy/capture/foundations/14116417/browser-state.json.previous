em 0.6em 0.3em\"><mtr><mtd><mtext>Var</mtext><mo stretchy=\"false\">[</mo><mi>X</mi><mo stretchy=\"false\">]</mo></mtd><mtd><mi></mi><mo>=</mo><mn>18</mn><mo>−</mo><msup><mn>3.5</mn><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>18</mn><mo>−</mo><mn>12.25</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5.75</mn><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
