7] [17592186485482 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186485482 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186485482 #edb/ref 1078 #edb/ref 17592186485313 #edb/ref 17592186045417] [17592186485482 #edb/ref 1079 #uuid "fe3adf2d-5dd2-5bae-9739-e53579bef45b" #edb/ref 17592186045417] [17592186485486 #edb/ref 1068 #edb/ref 17592186485401 #edb/ref 17592186045417] [17592186485486 #edb/ref 1069 "q-105586" #edb/ref 17592186045417] [17592186485486 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485486 #edb/ref 1071 "What is the remainder when $3{x}^{3}+7{x}^{2}-6x+2$ is divided by $3{x}^{2}-2x+1?$" #edb/ref 17592186045417] [17592186485486 #edb/ref 1072 #uuid "055a4a11-a8c1-52ea-9a96-5ba018fca1a6" #edb/ref 17592186045417] [17592186485486 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x+3 \\\\  & 3{x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+7{x}^{2}-6x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,9{x}^{2}-7x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{9{x}^{2}-6x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x-1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $x+3,$ and\n\n- the remainder is $-x-1.$" #edb/ref 17592186045417] [17592186485487 #edb/ref 1068 #edb/ref 17592186485375 #edb/ref 17592186045417] [17592186485487 #edb/ref 1069 "q-114524" #edb/ref 17592186045417] [17592186485487 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186485487 #edb/ref 1071 "$\\frac{{x}^{4}-3{x}^{2}+2x+1}{{x}^{2}-2x+1}=$" #edb/ref 17592186045417] [17592186485487 #edb/ref 1072 #uuid "081856a1-5ee4-5d5e-9555-d794c0719197" #edb/ref 17592186045417] [17592186485487 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{3}$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n{x}^{4}-3{x}^{2}+2x+1={x}^{4}+0{x}^{3}-3{x}^{2}+2x+1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+2x\\,\\,\\,\\,\\, \\\\  & {x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+0{x}^{2}-3{x}^{2}+2x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}-2{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,2{x}^{3}-4{x}^{2}+2x+1 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{2{x}^{3}-4{x}^{2}+2x+0}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,1\\end{aligned}\n$$\n\n  \n\nAs a result, \n\n- the quotient is ${x}^{2}+2x,$ and\n\n- the remainder is $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{{x}^{4}-3{x}^{2}+2x+1}{{x}^{2}-2x+1} & ={x}^{2}+2x+\\frac{1}{{x}^{2}-2x+1} \\\\ .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186485488 #edb/ref 1068 #edb/ref 17592186485432 #edb/ref 17592186045417] [17592186485488 #edb/ref 1069 "q-324442" #edb/ref 17592186045417] [17592186485488 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485488 #edb/ref 1071 "What is the remainder of $-2{x}^{3}-8$ divided by $-{x}^{2}+2x-3?$\n\nThe remainder is\n{{field-1}}." #edb/ref 17592186045417] [17592186485488 #edb/ref 1072 #uuid "09911eb6-f7c1-5633-957d-b9003c3e05af" #edb/ref 17592186045417] [17592186485488 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-2{x}^{3}-8=-2{x}^{3}+0{x}^{2}+0x-8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x+4 \\\\  & -{x}^{2}+2x-3\\,\\enclose{longdiv}{\\,\\,-2{x}^{3}+0{x}^{2}+0x-\\phantom{0}8\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{-2{x}^{3}+4{x}^{2}-6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-4{x}^{2}+6x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-4{x}^{2}+8x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-\\,2x+4\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $2x+4,$ and\n\n- the remainder is $-2x+4.$" #edb/ref 17592186045417] [17592186485490 #edb/ref 1068 #edb/ref 17592186485468 #edb/ref 17592186045417] [17592186485490 #edb/ref 1069 "q-325144" #edb/ref 17592186045417] [17592186485490 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485490 #edb/ref 1071 "What is the remainder of $-4{x}^{4}-{x}^{2}-9$ divided by ${x}^{2}-2x+3?$\n\nThe remainder is\n{{field-1}}." #edb/ref 17592186045417] [17592186485490 #edb/ref 1072 #uuid "0aed3cc1-c2b0-58fe-afde-dbd43b0a8ab9" #edb/ref 17592186045417] [17592186485490 #edb/ref 1074 "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-4{x}^{4}-{x}^{2}-9=-4{x}^{4}+0{x}^{3}-{x}^{2}+0x-9\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-4{x}^{2}-8x-5 \\\\  & {x}^{2}-2x+3\\,\\enclose{longdiv}{\\,\\,-4{x}^{4}+0{x}^{3}-\\phantom{00}{x}^{2}+\\phantom{0}0x-\\phantom{0}9\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,{\\,-4{x}^{4}+8{x}^{3}-12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-8{x}^{3}+11{x}^{2}+0x-9 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-\\,8{x}^{3}+16{x}^{2}-24x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,-5{x}^{2}+24x-9 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-5{x}^{2}+10x-15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,14x+6\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-4{x}^{2}-8x-5,$ and\n\n- the remainder is $14x+6.$" #edb/ref 17592186045417] [17592186485501 #edb/ref 1068 #edb/ref 17592186485365 #edb/ref 17592186045417] [17592186485501 #edb/ref 1069 "q-105619" #edb/ref 17592186045417] [17592186485501 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485501 #edb/ref 1071 "What is the quotient of $2{x}^{4}-2{x}^{3}+7{x}^{2}-x+2$ divided by ${x}^{2}-x+3?$" #edb/ref 17592186045417] [17592186485501 #edb/ref 1072 #uuid "181fbf98-acb9-50e0-be18-f71c1745254f" #edb/ref 17592186045417] [17592186485501 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}+1 \\\\  & {x}^{2}-x+3\\,\\enclose{longdiv}{\\,\\,2{x}^{4}-2{x}^{3}+7{x}^{2}-x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}-2{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,{x}^{2}-x+2 \\\\  & \\,\\,\\,\\,\\,\\,{{x}^{2}-x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $2{x}^{2}+1,$ and\n\n- the remainder is $-1.$" #edb/ref 17592186045417] [17592186485502 #edb/ref 1068 #edb/ref 17592186485394 #edb/ref 17592186045417] [17592186485502 #edb/ref 1068 #edb/ref 17592186485445 #edb/ref 17592186045417] [17592186485502 #edb/ref 1069 "q-322775" #edb/ref 17592186045417] [17592186485502 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485502 #edb/ref 1071 "Express $\\frac{18{x}^{3}+15{x}^{2}-53x+32}{3{x}^{2}-5x+2}$ in the form $q(x)+\\frac{r(x)}{3{x}^{2}-5x+2},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $18{x}^{3}+15{x}^{2}-53x+32$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $3{x}^{2}-5x+2$ | __ |  |  | $3{x}^{2}-5x+2$ |" #edb/ref 17592186045417] [17592186485502 #edb/ref 1072 #uuid "19e2fba4-263d-5d97-b42a-74a9677543ff" #edb/ref 17592186045417] [17592186485502 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6x+15 \\\\  & 3{x}^{2}-5x+2\\,\\enclose{longdiv}{\\,\\,18{x}^{3}+15{x}^{2}-53x+32\\,\\,} \\\\  & \\,\\,\\,\\,\\,{18{x}^{3}-30{x}^{2}+12x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,45{x}^{2}-65x+32 \\\\  & \\,\\,\\,\\,\\,{\\,\\,45{x}^{2}-75x+30}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,10x+2\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $6x+15,$ and\n\n- the remainder is $10x+2.$\n\nTherefore,\n\n$$\n\\frac{18{x}^{3}+15{x}^{2}-53x+32}{3{x}^{2}-5x+2}=6x+15+\\frac{10x+2}{3{x}^{2}-5x+2}.\n$$" #edb/ref 17592186045417] [17592186485531 #edb/ref 1068 #edb/ref 17592186485451 #edb/ref 17592186045417] [17592186485531 #edb/ref 1068 #edb/ref 17592186485466 #edb/ref 17592186045417] [17592186485531 #edb/ref 1069 "q-270162" #edb/ref 17592186045417] [17592186485531 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186485531 #edb/ref 1071 "Express $\\frac{-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10}{2{x}^{3}-3{x}^{2}+4x-2}$ in the form $q(x)+\\frac{r(x)}{2{x}^{3}-3{x}^{2}+4x-2},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{3}-3{x}^{2}+4x-2$ | __ |  |  | $2{x}^{3}-3{x}^{2}+4x-2$ |" #edb/ref 17592186045417] [17592186485531 #edb/ref 1072 #uuid "50f23ba0-92ed-55f7-8001-c1ea7b79fdae" #edb/ref 17592186045417] [17592186485531 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-3x-4 \\\\  & 2{x}^{3}-3{x}^{2}+4x-2\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+\\phantom{0}{x}^{3}-\\phantom{0}2{x}^{2}+\\phantom{00}x-10\\,\\,} \\\\  & \\,\\,\\,\\,\\,{\\,-\\,6{x}^{4}+9{x}^{3}-12{x}^{2}+6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-8{x}^{3}+10{x}^{2}-5x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,{\\,-\\,8{x}^{3}+12{x}^{2}-16x+8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,-\\,2{x}^{2}+11x-18\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $-3x-4,$ and\n\n- the remainder is $-2{x}^{2}+11x-18.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10}{2{x}^{3}-3{x}^{2}+4x-2} & =-3x-4+\\frac{(-2{x}^{2}+11x-18)}{2{x}^{3}-3{x}^{2}+4x-2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186485574 #edb/ref 1068 #edb/ref 17592186485481 #edb/ref 17592186045417] [17592186485574 #edb/ref 1069 "q-321932" #edb/ref 17592186045417] [17592186485574 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186485574 #edb/ref 1071 "What is the remainder when $4{x}^{3}-13{x}^{2}-35x+17$ is divided by ${x}^{2}-3x-10?$\n\nThe remainder is\n{{field-1}}." #edb/ref 17592186045417] [17592186485574 #edb/ref 1072 #uuid "b7b36623-4cad-581d-9fdb-5ce9b684b932" #edb/ref 17592186045417] [17592186485574 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4x-1 \\\\  & {x}^{2}-3x-10\\,\\enclose{longdiv}{\\,\\,4{x}^{3}-13{x}^{2}-35x+17\\,\\,} \\\\  & \\,\\,\\,\\,\\,{4{x}^{3}-12{x}^{2}-40x}_{―} \\\\  & \\,\\,\\,\\,\\,-{x}^{2}+5x+17 \\\\  & \\,\\,\\,\\,\\,\\,{-{x}^{2}+3x+10}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,2x+7\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $4x-1,$ and\n\n- the remainder is $2x+7.$" #edb/ref 17592186045417] [17592186485586 #edb/ref 1068 #edb/ref 17592186485367 #edb/ref 17592186045417] [17592186485586 #edb/ref 1069 "q-114523" #edb/ref 17592186045417] [17592186485586 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485586 #edb/ref 1071 "What is the remainder when $3{x}^{4}+2{x}^{3}+5{x}^{2}-1$ is divided by $3{x}^{2}+2x-1?$" #edb/ref 17592186045417] [17592186485586 #edb/ref 1072 #uuid "e0e14597-882f-5740-a997-7cf558df262d" #edb/ref 17592186045417] [17592186485586 #edb/ref 1074 "Notice that the dividend is missing the $x$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n3{x}^{4}+2{x}^{3}+5{x}^{2}-1=3{x}^{4}+2{x}^{3}+5{x}^{2}+0x-1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+2 \\\\  & 3{x}^{2}+2x-1\\,\\enclose{longdiv}{\\,\\,3{x}^{4}+2{x}^{3}+5{x}^{2}+0x-1\\,\\,} \\\\  & \\,\\,\\,{\\,\\,3{x}^{4}+2{x}^{3}-{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\text{ }6{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,{6{x}^{2}+4x-2}_{―} \\\\  & \\,\\,\\,\\,-\\,4x+1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}+2,$ and\n\n- the remainder is $-4x+1.$" #edb/ref 17592186045417] [17592186485587 #edb/ref 1068 #edb/ref 17592186485482 #edb/ref 17592186045417] [17592186485587 #edb/ref 1069 "q-325109" #edb/ref 17592186045417] [17592186485587 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186485587 #edb/ref 1071 "What is the remainder of $-8{x}^{4}+18{x}^{3}-13{x}^{2}-12x+8$ divided by $2{x}^{3}-3{x}^{2}+x+5?$\n\nThe remainder is\n{{field-1}}." #edb/ref 17592186045417] [17592186485587 #edb/ref 1072 #uuid "e87d282e-0d52-5290-b71b-daa1fd77975b" #edb/ref 17592186045417] [17592186485587 #edb/ref 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-4x+3 \\\\  & 2{x}^{3}-3{x}^{2}+x+5\\,\\enclose{longdiv}{\\,\\,-8{x}^{4}+18{x}^{3}-13{x}^{2}-12x+\\phantom{0}8\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,8{x}^{4}+12{x}^{3}-4{x}^{2}-20x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,6{x}^{3}-9{x}^{2}+8x+8 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-9{x}^{2}+3x+15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5x-7\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-4x+3,$ and\n\n- the remainder is $5x-7.$" #edb/ref 17592186045417]}
