#{[{:db/id #edb/ref 17592186068599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/id #uuid "a2aac357-23c5-5038-84c6-bc263bd45afa" :question/math-academy-id "e-5143" :question/problem "Determine the quotient and remainder of $6x^3-x^2+3x+1$ divided by $3x^2+x+2.$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-1 \\\\  & 3{x}^{2}+x+2\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-\\phantom{0}{x}^{2}+3x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+2{x}^{2}+4x}_{―} \\\\  & \\,\\,\\,\\,\\,-3{x}^{2}-x+1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${\\color{blue}2x-1},$ and\n\n- the remainder is ${\\color{red}3}.$"}] [{:db/id #edb/ref 17592186068600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/id #uuid "bd9a160c-574e-506e-865c-d08061c75aed" :question/math-academy-id "e-5144" :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x + 8}{x^2 - 1}\n$$" :question/worked-solution "Notice that the dividend is missing the $x^3$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2x^4-7x^2-x+8 = 2x^4+{\\color{red}0}x^3-7x^2-x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}-5 \\\\  & {x}^{2}-1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-7{x}^{2}-\\phantom{0}x+8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+0{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-x+8 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}+0x+5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x+3\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is ${2x^2 - 5},$ and\n\n- the remainder is ${-x+3}.$\n\nTherefore,\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 + \\dfrac{-x+3}{x^2-1}.\n$$\n\nWe can rewrite this result as follows:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 - \\dfrac{x-3}{x^2-1}\n$$"}] [{:db/id #edb/ref 17592186068660 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/id #uuid "9438b41b-2ad4-5248-881c-cb938b6cf1c3" :question/math-academy-id "e-8932" :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac {5x^4- 2x^3 - 18x^2 + 11x - 13} {5x^2-2x+2}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-4 \\\\  & 5{x}^{2}-2x+2\\,\\enclose{longdiv}{\\,\\,5{x}^{4}-2{x}^{3}-18{x}^{2}+11x-13\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{4}-2{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-20{x}^{2}+11x-13 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,20{x}^{2}+8x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-5\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is $x^2-4,$ and\n\n- the remainder is $3x-5.$\n\nTherefore, \n\n$$\n\\dfrac{5x^4-2x^3-18x^2+11x-13}{5x^2-2x+2}=x^2-4 + \\dfrac{3x-5}{5x^2-2x+2}.\n$$"}] [{:db/id #edb/ref 17592186485486 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f22a760-4eff-5fab-8cb2-c21e78e5614c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2" :db/id #edb/ref 17592186484848} {:answer/id #uuid "ad4f0f20-94ac-5305-8dd3-f36fdad09d0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2" :db/id #edb/ref 17592186485190} {:answer/id #uuid "be34c76d-bd07-5137-b154-241674337dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186485225} {:answer/id #uuid "cab645fe-2a17-5552-9ea5-1134a9e3d8f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-x" :db/id #edb/ref 17592186485249} {:answer/id #uuid "d49ecec8-c14f-5aba-a6d4-502f775afe38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x-1" :db/id #edb/ref 17592186485262}] :answer-field/correct {:answer/id #uuid "d49ecec8-c14f-5aba-a6d4-502f775afe38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x-1" :db/id #edb/ref 17592186485262} :answer-field/id #uuid "53d9a03f-d48f-58cb-b825-f2ee722c3226" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "055a4a11-a8c1-52ea-9a96-5ba018fca1a6" :question/math-academy-id "q-105586" :question/problem "What is the remainder when $3{x}^{3}+7{x}^{2}-6x+2$ is divided by $3{x}^{2}-2x+1?$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x+3 \\\\  & 3{x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+7{x}^{2}-6x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,9{x}^{2}-7x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{9{x}^{2}-6x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x-1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $x+3,$ and\n\n- the remainder is $-x-1.$"}] [{:db/id #edb/ref 17592186485501 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0734a952-dc65-5b73-a0ac-42bb5c00de1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-1" :db/id #edb/ref 17592186484830} {:answer/id #uuid "2106ff9c-2d6f-57eb-b089-6338b3cf678d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-x+1" :db/id #edb/ref 17592186484879} {:answer/id #uuid "31d3149e-62e0-5553-8a53-0780ff5bea82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+1" :db/id #edb/ref 17592186484920} {:answer/id #uuid "47e6fbc6-16ce-5c95-b3e2-0c7ae79faa24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+x-1" :db/id #edb/ref 17592186484972} {:answer/id #uuid "517bd432-634c-5160-a7c1-2798b49ac31f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+x+1" :db/id #edb/ref 17592186484994}] :answer-field/correct {:answer/id #uuid "31d3149e-62e0-5553-8a53-0780ff5bea82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+1" :db/id #edb/ref 17592186484920} :answer-field/id #uuid "010cb54c-0f9d-56c9-9967-ad2ac4ae38eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485365}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "181fbf98-acb9-50e0-be18-f71c1745254f" :question/math-academy-id "q-105619" :question/problem "What is the quotient of $2{x}^{4}-2{x}^{3}+7{x}^{2}-x+2$ divided by ${x}^{2}-x+3?$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}+1 \\\\  & {x}^{2}-x+3\\,\\enclose{longdiv}{\\,\\,2{x}^{4}-2{x}^{3}+7{x}^{2}-x+2\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}-2{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,{x}^{2}-x+2 \\\\  & \\,\\,\\,\\,\\,\\,{{x}^{2}-x+3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $2{x}^{2}+1,$ and\n\n- the remainder is $-1.$"}] [{:db/id #edb/ref 17592186485586 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c9aef9-8d56-536c-ad1a-eb90516a9b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x+1" :db/id #edb/ref 17592186484823} {:answer/id #uuid "4b2dda59-97b3-52ee-81d9-8f054c2d2d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2" :db/id #edb/ref 17592186484983} {:answer/id #uuid "795d8634-6770-5957-a96e-73e55b38e58d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186485079} {:answer/id #uuid "b8e776e2-99e2-59fa-8d6c-567b839a4af9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x-4" :db/id #edb/ref 17592186485215} {:answer/id #uuid "d3ce406c-15be-5d89-a8b8-a32986a9e199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x" :db/id #edb/ref 17592186485261}] :answer-field/correct {:answer/id #uuid "02c9aef9-8d56-536c-ad1a-eb90516a9b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x+1" :db/id #edb/ref 17592186484823} :answer-field/id #uuid "092b7512-31b4-5a29-bf6c-0f1cca26713c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485367}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0e14597-882f-5740-a997-7cf558df262d" :question/math-academy-id "q-114523" :question/problem "What is the remainder when $3{x}^{4}+2{x}^{3}+5{x}^{2}-1$ is divided by $3{x}^{2}+2x-1?$" :question/worked-solution "Notice that the dividend is missing the $x$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n3{x}^{4}+2{x}^{3}+5{x}^{2}-1=3{x}^{4}+2{x}^{3}+5{x}^{2}+0x-1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+2 \\\\  & 3{x}^{2}+2x-1\\,\\enclose{longdiv}{\\,\\,3{x}^{4}+2{x}^{3}+5{x}^{2}+0x-1\\,\\,} \\\\  & \\,\\,\\,{\\,\\,3{x}^{4}+2{x}^{3}-{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\text{ }6{x}^{2}+0x-1 \\\\  & \\,\\,\\,\\,\\,{6{x}^{2}+4x-2}_{―} \\\\  & \\,\\,\\,\\,-\\,4x+1\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${x}^{2}+2,$ and\n\n- the remainder is $-4x+1.$"}] [{:db/id #edb/ref 17592186485487 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a078755-5f4a-57c8-926a-232b6508dd5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x-\\frac{1}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186484834} {:answer/id #uuid "9576bb1b-4a4e-5873-90a7-bbd7c225f503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+x-\\frac{x}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186485140} {:answer/id #uuid "9ae7fcb4-3a41-50f8-98a8-794d4f79c750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x-1+\\frac{2}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186485154} {:answer/id #uuid "ee3ed9c8-febc-5465-8a71-f9072050b20c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+\\frac{1}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186485323} {:answer/id #uuid "f7ddbe3a-e66f-5392-b989-1e189e9be995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x-1-\\frac{2}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186485347}] :answer-field/correct {:answer/id #uuid "ee3ed9c8-febc-5465-8a71-f9072050b20c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+\\frac{1}{{x}^{2}-2x+1}" :db/id #edb/ref 17592186485323} :answer-field/id #uuid "12f76e1a-9a3d-5ac6-bfbf-3674987fa283" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485375}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "081856a1-5ee4-5d5e-9555-d794c0719197" :question/math-academy-id "q-114524" :question/problem "$\\frac{{x}^{4}-3{x}^{2}+2x+1}{{x}^{2}-2x+1}=$" :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n{x}^{4}-3{x}^{2}+2x+1={x}^{4}+0{x}^{3}-3{x}^{2}+2x+1\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}+2x\\,\\,\\,\\,\\, \\\\  & {x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,{x}^{4}+0{x}^{2}-3{x}^{2}+2x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{4}-2{x}^{3}+{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,2{x}^{3}-4{x}^{2}+2x+1 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{2{x}^{3}-4{x}^{2}+2x+0}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,1\\end{aligned}\n$$\n\n  \n\nAs a result, \n\n- the quotient is ${x}^{2}+2x,$ and\n\n- the remainder is $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{{x}^{4}-3{x}^{2}+2x+1}{{x}^{2}-2x+1} & ={x}^{2}+2x+\\frac{1}{{x}^{2}-2x+1} \\\\ .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485531 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e056ca2c-08b9-5433-8225-0a719c3ef8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+11x-18" :db/id #edb/ref 17592186485290}] :answer-field/correct {:answer/id #uuid "e056ca2c-08b9-5433-8225-0a719c3ef8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+11x-18" :db/id #edb/ref 17592186485290} :answer-field/id #uuid "c4ada65e-58e7-559a-beba-d26715127a20" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485451} {:answer-field/choices [{:answer/id #uuid "aac526c4-f867-521e-a7e6-3e043c31ec08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-4" :db/id #edb/ref 17592186485187}] :answer-field/correct {:answer/id #uuid "aac526c4-f867-521e-a7e6-3e043c31ec08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-4" :db/id #edb/ref 17592186485187} :answer-field/id #uuid "e6a6f954-cc7f-5c76-abb2-676e04e4d6bc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485466}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "50f23ba0-92ed-55f7-8001-c1ea7b79fdae" :question/math-academy-id "q-270162" :question/problem "Express $\\frac{-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10}{2{x}^{3}-3{x}^{2}+4x-2}$ in the form $q(x)+\\frac{r(x)}{2{x}^{3}-3{x}^{2}+4x-2},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{3}-3{x}^{2}+4x-2$ | __ |  |  | $2{x}^{3}-3{x}^{2}+4x-2$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-3x-4 \\\\  & 2{x}^{3}-3{x}^{2}+4x-2\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+\\phantom{0}{x}^{3}-\\phantom{0}2{x}^{2}+\\phantom{00}x-10\\,\\,} \\\\  & \\,\\,\\,\\,\\,{\\,-\\,6{x}^{4}+9{x}^{3}-12{x}^{2}+6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-8{x}^{3}+10{x}^{2}-5x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,{\\,-\\,8{x}^{3}+12{x}^{2}-16x+8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,-\\,2{x}^{2}+11x-18\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $-3x-4,$ and\n\n- the remainder is $-2{x}^{2}+11x-18.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{-6{x}^{4}+{x}^{3}-2{x}^{2}+x-10}{2{x}^{3}-3{x}^{2}+4x-2} & =-3x-4+\\frac{(-2{x}^{2}+11x-18)}{2{x}^{3}-3{x}^{2}+4x-2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186485574 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2915697b-699e-5131-b7a6-11d2d22e5d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+7" :db/id #edb/ref 17592186484895}] :answer-field/correct {:answer/id #uuid "2915697b-699e-5131-b7a6-11d2d22e5d20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+7" :db/id #edb/ref 17592186484895} :answer-field/id #uuid "fdde6b88-2bcb-59a9-a552-8cc51dc4dfa1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485481}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7b36623-4cad-581d-9fdb-5ce9b684b932" :question/math-academy-id "q-321932" :question/problem "What is the remainder when $4{x}^{3}-13{x}^{2}-35x+17$ is divided by ${x}^{2}-3x-10?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,4x-1 \\\\  & {x}^{2}-3x-10\\,\\enclose{longdiv}{\\,\\,4{x}^{3}-13{x}^{2}-35x+17\\,\\,} \\\\  & \\,\\,\\,\\,\\,{4{x}^{3}-12{x}^{2}-40x}_{―} \\\\  & \\,\\,\\,\\,\\,-{x}^{2}+5x+17 \\\\  & \\,\\,\\,\\,\\,\\,{-{x}^{2}+3x+10}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,2x+7\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $4x-1,$ and\n\n- the remainder is $2x+7.$"}] [{:db/id #edb/ref 17592186302125 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6f397b-e69a-5f66-b1e1-d558d85937ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23x+51" :db/id #edb/ref 17592186300377}] :answer-field/correct {:answer/id #uuid "4f6f397b-e69a-5f66-b1e1-d558d85937ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23x+51" :db/id #edb/ref 17592186300377} :answer-field/id #uuid "1be67ada-4933-575c-bf49-880b89796d17" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301316} {:answer-field/choices [{:answer/id #uuid "3c5502a4-1313-5bfc-bb25-3614f5e19bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9" :db/id #edb/ref 17592186300255}] :answer-field/correct {:answer/id #uuid "3c5502a4-1313-5bfc-bb25-3614f5e19bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9" :db/id #edb/ref 17592186300255} :answer-field/id #uuid "2cbe4faa-5b1d-5731-9a3e-e98fee19c553" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffc55b0b-d2bb-5785-9bad-343d08c921b4" :question/math-academy-id "q-322774" :question/problem "Express $\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}$ in the form $q(x)+\\frac{r(x)}{2{x}^{2}-3x+5},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $12{x}^{3}-20x+96$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{2}-3x+5$ | __ |  |  | $2{x}^{2}-3x+5$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6x+9 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,12{x}^{3}+\\phantom{0}0{x}^{2}-20x+96\\,\\,} \\\\  & \\,\\,\\,\\,\\,{12{x}^{3}-18{x}^{2}+30x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,18{x}^{2}-50x+96 \\\\  & \\,\\,\\,\\,\\,\\,{\\,\\,18{x}^{2}-27x+45}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-23x+51\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $6x+9,$ and\n\n- the remainder is $-23x+51.$\n\nTherefore,\n\n$$\n\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}=6x+9+\\frac{(-23x+51)}{2{x}^{2}-3x+5}.\n$$"}] [{:db/id #edb/ref 17592186485502 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d6c5488-8909-568f-a42e-e89e6b133cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x+2" :db/id #edb/ref 17592186484986}] :answer-field/correct {:answer/id #uuid "4d6c5488-8909-568f-a42e-e89e6b133cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10x+2" :db/id #edb/ref 17592186484986} :answer-field/id #uuid "3b46f401-635f-539a-b7a6-61f061a7d7cd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485394} {:answer-field/choices [{:answer/id #uuid "8cbd5e88-4232-5919-892f-a641f432c3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+15" :db/id #edb/ref 17592186485122}] :answer-field/correct {:answer/id #uuid "8cbd5e88-4232-5919-892f-a641f432c3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+15" :db/id #edb/ref 17592186485122} :answer-field/id #uuid "b5aece7f-4616-5dcd-a42e-331a18bbd733" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485445}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19e2fba4-263d-5d97-b42a-74a9677543ff" :question/math-academy-id "q-322775" :question/problem "Express $\\frac{18{x}^{3}+15{x}^{2}-53x+32}{3{x}^{2}-5x+2}$ in the form $q(x)+\\frac{r(x)}{3{x}^{2}-5x+2},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $18{x}^{3}+15{x}^{2}-53x+32$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $3{x}^{2}-5x+2$ | __ |  |  | $3{x}^{2}-5x+2$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6x+15 \\\\  & 3{x}^{2}-5x+2\\,\\enclose{longdiv}{\\,\\,18{x}^{3}+15{x}^{2}-53x+32\\,\\,} \\\\  & \\,\\,\\,\\,\\,{18{x}^{3}-30{x}^{2}+12x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,45{x}^{2}-65x+32 \\\\  & \\,\\,\\,\\,\\,{\\,\\,45{x}^{2}-75x+30}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,10x+2\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $6x+15,$ and\n\n- the remainder is $10x+2.$\n\nTherefore,\n\n$$\n\\frac{18{x}^{3}+15{x}^{2}-53x+32}{3{x}^{2}-5x+2}=6x+15+\\frac{10x+2}{3{x}^{2}-5x+2}.\n$$"}] [{:db/id #edb/ref 17592186485488 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdf31618-0080-5092-b97f-1983fd960faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+4" :db/id #edb/ref 17592186485363}] :answer-field/correct {:answer/id #uuid "fdf31618-0080-5092-b97f-1983fd960faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+4" :db/id #edb/ref 17592186485363} :answer-field/id #uuid "9b5296c6-8466-5ac4-ae38-14da36126aa8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485432}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09911eb6-f7c1-5633-957d-b9003c3e05af" :question/math-academy-id "q-324442" :question/problem "What is the remainder of $-2{x}^{3}-8$ divided by $-{x}^{2}+2x-3?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-2{x}^{3}-8=-2{x}^{3}+0{x}^{2}+0x-8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x+4 \\\\  & -{x}^{2}+2x-3\\,\\enclose{longdiv}{\\,\\,-2{x}^{3}+0{x}^{2}+0x-\\phantom{0}8\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{-2{x}^{3}+4{x}^{2}-6x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-4{x}^{2}+6x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-4{x}^{2}+8x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-\\,2x+4\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $2x+4,$ and\n\n- the remainder is $-2x+4.$"}] [{:db/id #edb/ref 17592186302174 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e98326f-ca6b-5184-b454-5b358c2f9398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186300267}] :answer-field/correct {:answer/id #uuid "3e98326f-ca6b-5184-b454-5b358c2f9398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186300267} :answer-field/id #uuid "50bc8c0f-557c-5e52-93ce-a4dfbf65cb8c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301491}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e902eb71-f118-50ae-bfee-7615e9d48833" :question/math-academy-id "q-325106" :question/problem "What is the quotient of $-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3$ divided by $-{x}^{3}+4{x}^{2}-2x+1?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-3 \\\\  & -{x}^{3}+4{x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,2{x}^{4}+8{x}^{3}-4{x}^{2}+2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}-13{x}^{2}+x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-12{x}^{2}+6x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}-5x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $2x-3,$ and\n\n- the remainder is $-{x}^{2}-5x+6.$"}] [{:db/id #edb/ref 17592186485587 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9cd52c7-ae5b-5a9d-99b9-ae90c2a70d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-7" :db/id #edb/ref 17592186485313}] :answer-field/correct {:answer/id #uuid "e9cd52c7-ae5b-5a9d-99b9-ae90c2a70d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-7" :db/id #edb/ref 17592186485313} :answer-field/id #uuid "fe3adf2d-5dd2-5bae-9739-e53579bef45b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485482}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e87d282e-0d52-5290-b71b-daa1fd77975b" :question/math-academy-id "q-325109" :question/problem "What is the remainder of $-8{x}^{4}+18{x}^{3}-13{x}^{2}-12x+8$ divided by $2{x}^{3}-3{x}^{2}+x+5?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-4x+3 \\\\  & 2{x}^{3}-3{x}^{2}+x+5\\,\\enclose{longdiv}{\\,\\,-8{x}^{4}+18{x}^{3}-13{x}^{2}-12x+\\phantom{0}8\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,8{x}^{4}+12{x}^{3}-4{x}^{2}-20x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,6{x}^{3}-9{x}^{2}+8x+8 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-9{x}^{2}+3x+15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5x-7\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-4x+3,$ and\n\n- the remainder is $5x-7.$"}] [{:db/id #edb/ref 17592186302177 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05398a96-d5a6-5c23-b30b-c2ff2ca1f0cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-7x+6" :db/id #edb/ref 17592186299955} {:answer/id #uuid "35ab54f6-7707-5402-80d0-dc69bbc677d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{2}-7x+6" :db/id #edb/ref 17592186484930}] :answer-field/correct {:answer/id #uuid "35ab54f6-7707-5402-80d0-dc69bbc677d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{2}-7x+6" :db/id #edb/ref 17592186484930} :answer-field/id #uuid "0ea76cea-33ad-57d3-941e-2341085ff69a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0daf2810-8b21-5a33-a2a3-5dad72a7a14f" :question/math-academy-id "q-325110" :question/problem "What is the remainder of $-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2$ divided by $3{x}^{3}-2{x}^{2}+5x-4?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x+1 \\\\  & 3{x}^{3}-2{x}^{2}+5x-4\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+7{x}^{3}-\\phantom{0}8{x}^{2}+6x+2\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,6{x}^{4}+4{x}^{3}-10{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}+2{x}^{2}-\\,2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+5x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{2}-7x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-2x+1,$ and\n\n- the remainder is $4{x}^{2}-7x+6.$"}] [{:db/id #edb/ref 17592186302185 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a5f30b-dcb4-5cab-8a9d-c2fcd8243624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186300208}] :answer-field/correct {:answer/id #uuid "31a5f30b-dcb4-5cab-8a9d-c2fcd8243624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186300208} :answer-field/id #uuid "4aa18da1-c7e8-5c56-9c36-c81d68a4cf4c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e563c3b5-1035-5672-9ab4-671fa924b598" :question/math-academy-id "q-325143" :question/problem "What is the remainder of $-4{x}^{3}+16$ divided by $2{x}^{2}-3x+5?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-4{x}^{3}+16=-4{x}^{3}+0{x}^{2}+0x+16\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x-3 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,-4{x}^{3}+0{x}^{2}+\\phantom{0}0x+6\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{-4{x}^{3}+6{x}^{2}-10x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-6{x}^{2}+10x+16 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-\\,6{x}^{2}+9x-15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,x+31\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-2x-3,$ and\n\n- the remainder is $x+31.$"}] [{:db/id #edb/ref 17592186485490 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fea29c4-724d-5592-acaa-fa8c9360ef14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14x+6" :db/id #edb/ref 17592186484956}] :answer-field/correct {:answer/id #uuid "3fea29c4-724d-5592-acaa-fa8c9360ef14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14x+6" :db/id #edb/ref 17592186484956} :answer-field/id #uuid "e76a0f26-821e-5882-8ff1-70b08ab07b0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186485468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0aed3cc1-c2b0-58fe-afde-dbd43b0a8ab9" :question/math-academy-id "q-325144" :question/problem "What is the remainder of $-4{x}^{4}-{x}^{2}-9$ divided by ${x}^{2}-2x+3?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Notice that the dividend is missing the ${x}^{3}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-4{x}^{4}-{x}^{2}-9=-4{x}^{4}+0{x}^{3}-{x}^{2}+0x-9\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-4{x}^{2}-8x-5 \\\\  & {x}^{2}-2x+3\\,\\enclose{longdiv}{\\,\\,-4{x}^{4}+0{x}^{3}-\\phantom{00}{x}^{2}+\\phantom{0}0x-\\phantom{0}9\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,{\\,-4{x}^{4}+8{x}^{3}-12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-8{x}^{3}+11{x}^{2}+0x-9 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-\\,8{x}^{3}+16{x}^{2}-24x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,-5{x}^{2}+24x-9 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-5{x}^{2}+10x-15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,14x+6\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-4{x}^{2}-8x-5,$ and\n\n- the remainder is $14x+6.$"}] [{:db/id #edb/ref 17592186069307 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09119ba9-7069-5c48-9bf8-897c67cce065" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-1+\\frac{16}{{x}^{2}+x+9}" :db/id #edb/ref 17592186484833} {:answer/id #uuid "478bda68-4a2f-5923-b944-e44d5ec764c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3+\\frac{12}{{x}^{2}+x+9}" :db/id #edb/ref 17592186484969} {:answer/id #uuid "a894975e-16ab-5052-bdc4-b86ef962e5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3+\\frac{21}{{x}^{2}+x+9}" :db/id #edb/ref 17592186485182} {:answer/id #uuid "ae7ace86-fe28-5ff6-952f-e50ef4a0d5cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3+\\frac{13}{{x}^{2}+x+9}" :db/id #edb/ref 17592186485194} {:answer/id #uuid "d1558d43-d0e6-5519-bcfd-30ab9f190abf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+3+\\frac{12}{{x}^{2}+x+9}" :db/id #edb/ref 17592186485259}] :answer-field/correct {:answer/id #uuid "a894975e-16ab-5052-bdc4-b86ef962e5db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-3+\\frac{21}{{x}^{2}+x+9}" :db/id #edb/ref 17592186485182} :answer-field/id #uuid "776629ae-b33f-5b3c-b31e-2e7f9edeaade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067012}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "52f9ae75-5f32-5217-bf48-06fe3e8b58c6" :question/math-academy-id "q-37908" :question/problem "$\\frac{{x}^{3}-2{x}^{2}+6x-6}{{x}^{2}+x+9}=$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x-3 \\\\  & {x}^{2}+x+9\\,\\enclose{longdiv}{\\,\\,{x}^{3}-2{x}^{2}+6x-6\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}+{x}^{2}+9x}_{―} \\\\  & \\,\\,\\,\\,\\,-3{x}^{2}-3x-6 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-3x-27}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,21\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $x-3,$ and\n\n- the remainder is $21.$\n\nTherefore, \n\n$$\n\\frac{{x}^{3}-2{x}^{2}+6x-6}{{x}^{2}+x+9}=x-3+\\frac{21}{{x}^{2}+x+9}.\n$$"}]}
