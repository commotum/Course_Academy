#{[{:db/id #edb/ref 17592186068599 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/id #uuid "a2aac357-23c5-5038-84c6-bc263bd45afa" :question/math-academy-id "e-5143" :question/problem "Determine the quotient and remainder of $6x^3-x^2+3x+1$ divided by $3x^2+x+2.$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-1 \\\\  & 3{x}^{2}+x+2\\,\\enclose{longdiv}{\\,\\,6{x}^{3}-{x}^{2}+3x+1\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+2{x}^{2}+4x}_{―} \\\\  & \\,\\,\\,\\,\\,-3{x}^{2}-x+1 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is ${\\color{blue}2x-1},$ and\n\n- the remainder is ${\\color{red}3}.$"}] [{:db/id #edb/ref 17592186068600 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/id #uuid "bd9a160c-574e-506e-865c-d08061c75aed" :question/math-academy-id "e-5144" :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x + 8}{x^2 - 1}\n$$" :question/worked-solution "Notice that the dividend is missing the $x^3$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2x^4-7x^2-x+8 = 2x^4+{\\color{red}0}x^3-7x^2-x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2{x}^{2}-5 \\\\  & {x}^{2}-1\\,\\enclose{longdiv}{\\,\\,2{x}^{4}+0{x}^{3}-7{x}^{2}-x+8\\,\\,} \\\\  & \\,\\,\\,\\,\\,{2{x}^{4}+0{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-5{x}^{2}-x+8 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,5{x}^{2}+0x+5}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-x+3\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is ${2x^2 - 5},$ and\n\n- the remainder is ${-x+3}.$\n\nTherefore,\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 + \\dfrac{-x+3}{x^2-1}.\n$$\n\nWe can rewrite this result as follows:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} \n= \n2x^2-5 - \\dfrac{x-3}{x^2-1}\n$$"}] [{:db/id #edb/ref 17592186068660 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/id #uuid "9438b41b-2ad4-5248-881c-cb938b6cf1c3" :question/math-academy-id "e-8932" :question/problem "Find the quotient and remainder of the following division problem:\n\n$$\n\\dfrac {5x^4- 2x^3 - 18x^2 + 11x - 13} {5x^2-2x+2}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-4 \\\\  & 5{x}^{2}-2x+2\\,\\enclose{longdiv}{\\,\\,5{x}^{4}-2{x}^{3}-18{x}^{2}+11x-13\\,\\,} \\\\  & \\,\\,\\,\\,\\,{5{x}^{4}-2{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,-20{x}^{2}+11x-13 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,20{x}^{2}+8x-8}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,3x-5\\end{aligned}\n$$\n\nAs a result,\n\n- the quotient is $x^2-4,$ and\n\n- the remainder is $3x-5.$\n\nTherefore, \n\n$$\n\\dfrac{5x^4-2x^3-18x^2+11x-13}{5x^2-2x+2}=x^2-4 + \\dfrac{3x-5}{5x^2-2x+2}.\n$$"}] [{:db/id #edb/ref 17592186302125 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6f397b-e69a-5f66-b1e1-d558d85937ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23x+51" :db/id #edb/ref 17592186300377}] :answer-field/correct {:answer/id #uuid "4f6f397b-e69a-5f66-b1e1-d558d85937ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23x+51" :db/id #edb/ref 17592186300377} :answer-field/id #uuid "1be67ada-4933-575c-bf49-880b89796d17" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301316} {:answer-field/choices [{:answer/id #uuid "3c5502a4-1313-5bfc-bb25-3614f5e19bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9" :db/id #edb/ref 17592186300255}] :answer-field/correct {:answer/id #uuid "3c5502a4-1313-5bfc-bb25-3614f5e19bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9" :db/id #edb/ref 17592186300255} :answer-field/id #uuid "2cbe4faa-5b1d-5731-9a3e-e98fee19c553" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffc55b0b-d2bb-5785-9bad-343d08c921b4" :question/math-academy-id "q-322774" :question/problem "Express $\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}$ in the form $q(x)+\\frac{r(x)}{2{x}^{2}-3x+5},$ where $q(x)$ is the quotient and $r(x)$ is the reminder of the division.$$\n\n| $12{x}^{3}-20x+96$ | __ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- | --- |\n| $2{x}^{2}-3x+5$ | __ |  |  | $2{x}^{2}-3x+5$ |" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,6x+9 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,12{x}^{3}+0{x}^{2}-20x+96\\,\\,} \\\\  & \\,\\,\\,\\,\\,{12{x}^{3}-18{x}^{2}+30x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,18{x}^{2}-50x+96 \\\\  & \\,\\,\\,\\,\\,\\,{\\,\\,18{x}^{2}-27x+45}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-23x+51\\end{aligned}\n$$\n\nAs a result, \n\n- the quotient is $6x+9,$ and\n\n- the remainder is $-23x+51.$\n\nTherefore,\n\n$$\n\\frac{12{x}^{3}-20x+96}{2{x}^{2}-3x+5}=6x+9+\\frac{(-23x+51)}{2{x}^{2}-3x+5}.\n$$"}] [{:db/id #edb/ref 17592186302174 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e98326f-ca6b-5184-b454-5b358c2f9398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186300267}] :answer-field/correct {:answer/id #uuid "3e98326f-ca6b-5184-b454-5b358c2f9398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3" :db/id #edb/ref 17592186300267} :answer-field/id #uuid "50bc8c0f-557c-5e52-93ce-a4dfbf65cb8c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301491}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e902eb71-f118-50ae-bfee-7615e9d48833" :question/math-academy-id "q-325106" :question/problem "What is the quotient of $-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3$ divided by $-{x}^{3}+4{x}^{2}-2x+1?$\n\nThe quotient is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,2x-3 \\\\  & -{x}^{3}+4{x}^{2}-2x+1\\,\\enclose{longdiv}{\\,\\,-2{x}^{4}+11{x}^{3}-17{x}^{2}+3x+3\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,2{x}^{4}+8{x}^{3}-4{x}^{2}+2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}-13{x}^{2}+x+3 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-12{x}^{2}+6x-3}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}-5x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $2x-3,$ and\n\n- the remainder is $-{x}^{2}-5x+6.$"}] [{:db/id #edb/ref 17592186302177 :knowledge-point/_questions [{:db/id #edb/ref 17592186068817 :knowledge-point/id #uuid "76a7314b-4ebf-52eb-b464-97865ea9a81e" :knowledge-point/title "Dividing a Quartic Polynomial by a Quadratic or Cubic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05398a96-d5a6-5c23-b30b-c2ff2ca1f0cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-7x+6" :db/id #edb/ref 17592186299955}] :answer-field/correct {:answer/id #uuid "05398a96-d5a6-5c23-b30b-c2ff2ca1f0cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-7x+6" :db/id #edb/ref 17592186299955} :answer-field/id #uuid "0ea76cea-33ad-57d3-941e-2341085ff69a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0daf2810-8b21-5a33-a2a3-5dad72a7a14f" :question/math-academy-id "q-325110" :question/problem "What is the remainder of $-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2$ divided by $3{x}^{3}-2{x}^{2}+5x-4?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x+1 \\\\  & 3{x}^{3}-2{x}^{2}+5x-4\\,\\enclose{longdiv}{\\,\\,-6{x}^{4}+7{x}^{3}-8{x}^{2}+6x+2\\,\\,} \\\\  & \\,\\,\\,\\,{\\,\\,-\\,6{x}^{4}+4{x}^{3}-10{x}^{2}+8x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,3{x}^{3}+2{x}^{2}-\\,2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}-2{x}^{2}+5x-4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{2}-7x+6\\end{aligned}\n$$\n\nTherefore,\n\n- the quotient is $-2x+1,$ and\n\n- the remainder is $4{x}^{2}-7x+6.$"}] [{:db/id #edb/ref 17592186302185 :knowledge-point/_questions [{:db/id #edb/ref 17592186068762 :knowledge-point/id #uuid "525be9c7-af11-506b-be69-444dfc640add" :knowledge-point/title "Dividing Polynomials When the Dividend Contains Zero Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a5f30b-dcb4-5cab-8a9d-c2fcd8243624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186300208}] :answer-field/correct {:answer/id #uuid "31a5f30b-dcb4-5cab-8a9d-c2fcd8243624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+31" :db/id #edb/ref 17592186300208} :answer-field/id #uuid "4aa18da1-c7e8-5c56-9c36-c81d68a4cf4c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e563c3b5-1035-5672-9ab4-671fa924b598" :question/math-academy-id "q-325143" :question/problem "What is the remainder of $-4{x}^{3}+16$ divided by $2{x}^{2}-3x+5?$\n\nThe remainder is\n{{field-1}}." :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$ and $x$ terms. So, we first rewrite it by including the missing terms with zero coefficients, as follows:\n\n$$\n-4{x}^{3}+16=-4{x}^{3}+0{x}^{2}+0x+16\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x-3 \\\\  & 2{x}^{2}-3x+5\\,\\enclose{longdiv}{\\,\\,-4{x}^{3}+0{x}^{2}+0x+6\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,{-4{x}^{3}+6{x}^{2}-10x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-6{x}^{2}+10x+16 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{-\\,6{x}^{2}+9x-15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,x+31\\end{aligned}\n$$\n\nTherefore, \n\n- the quotient is $-2x-3,$ and\n\n- the remainder is $x+31.$"}] [{:db/id #edb/ref 17592186069307 :knowledge-point/_questions [{:db/id #edb/ref 17592186068761 :knowledge-point/id #uuid "da0ca17e-50f3-5f67-bb1c-27868f7b4f45" :knowledge-point/title "Dividing a Cubic Polynomial by a Quadratic Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86803cfb-4efe-5566-9004-e0ac847e7091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x + 3 + \\frac{13}{x^{2} + x + 9}" :db/id #edb/ref 17592186067013} {:answer/id #uuid "a576514f-42d1-5a1d-880e-eb9b1212ea93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x - 3 + \\frac{21}{x^{2} + x + 9}" :db/id #edb/ref 17592186067014} {:answer/id #uuid "aafcfaac-f0f5-50ea-8bfc-c6c198944f71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x + 3 + \\frac{12}{x^{2} + x + 9}" :db/id #edb/ref 17592186067015} {:answer/id #uuid "caf84b96-65ec-5a78-88d6-a7f7d3449802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x - 1 + \\frac{16}{x^{2} + x + 9}" :db/id #edb/ref 17592186067016} {:answer/id #uuid "14d06546-5aae-500b-ba15-8f821f54729d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x - 3 + \\frac{12}{x^{2} + x + 9}" :db/id #edb/ref 17592186067017}] :answer-field/id #uuid "776629ae-b33f-5b3c-b31e-2e7f9edeaade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067012}] :question/id #uuid "52f9ae75-5f32-5217-bf48-06fe3e8b58c6" :question/math-academy-id "q-37908" :question/problem "What is $\\frac{x^{3} - 2x^{2} + 6x - 6}{x^{2} + x + 9}$?"}]}
