          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:80px;\n                                        margin-left:0px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"25\"><span mathquill-command-id=\"29\">6</span><var mathquill-command-id=\"31\">x</var><span mathquill-command-id=\"33\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"35\">9</span></span></div></div>",
          "rendered_text": "6x+9",
