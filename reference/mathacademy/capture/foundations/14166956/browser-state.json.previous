      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14166956/observations/step-q161082-619162b46037eda44126.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14166956/observations/step-q161082-619162b46037eda44126.png",
      "source_url": "https://mathacademy.com/tasks/14166956/topics/4134/lesson",
      "captured_at": 1791897237.4599621,
      "math_academy_id": "q-161082",
      "topic_id": "4134",
