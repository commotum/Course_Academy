b/ref 17592186045417] [17592186198479 #edb/ref 1049 #edb/ref 17592186050482 #edb/ref 17592186045417] [17592186198479 #edb/ref 1050 1020.0 #edb/ref 17592186045417] [17592186198479 #edb/ref 1053 #uuid "8416c2c4-cff0-5744-94c6-6f83c5fc5709" #edb/ref 17592186045417] [17592186199250 #edb/ref 1058 #edb/ref 17592186199251 #edb/ref 17592186045417] [17592186199250 #edb/ref 1061 26976 #edb/ref 17592186045417] [17592186199250 #edb/ref 1062 #uuid "5a4dcbdc-b666-5ac5-82b5-d1e2d96f958e" #edb/ref 17592186045417] [17592186199250 #edb/ref 1063 #edb/ref 17592186199451 #edb/ref 17592186045417] [17592186199251 #edb/ref 1058 #edb/ref 17592186199273 #edb/ref 17592186045417] [17592186199251 #edb/ref 1061 26978 #edb/ref 17592186045417] [17592186199251 #edb/ref 1062 #uuid "38215948-f2f7-5757-b967-2b0aad077150" #edb/ref 17592186045417] [17592186199251 #edb/ref 1063 #edb/ref 17592186198361 #edb/ref 17592186045417] [17592186199273 #edb/ref 1058 #edb/ref 17592186199274 #edb/ref 17592186045417] [17592186199273 #edb/ref 1061 44170 #edb/ref 17592186045417] [17592186199273 #edb/ref 1062 #uuid "418d8ff2-cd87-5ef1-b69c-c511c7c5b360" #edb/ref 17592186045417] [17592186199273 #edb/ref 1063 #edb/ref 17592186198373 #edb/ref 17592186045417] [17592186199274 #edb/ref 1061 44171 #edb/ref 17592186045417] [17592186199274 #edb/ref 1062 #uuid "e9c97e5e-4063-57fd-b261-2a276cea9f27" #edb/ref 17592186045417] [17592186199274 #edb/ref 1063 #edb/ref 17592186198374 #edb/ref 17592186045417] [17592186199451 #edb/ref 1064 "Suppose that \n\n$$\n\\mathbf T: (u,v) \\to \\left(x(u,v),y(u,v)\\right)\n$$\n\nis a $C^1$ transformation that has no critical points (i.e., it is invertible) inside some region $\\Delta\\subset \\mathbb R^2,$ and that $\\mathbf T(\\Delta) = D,$ as shown below.\n\n![](images/66/668b8a0dae060c7929b92c6abe3601b0ede0b8444d92f33f4a8b5627410a4447.png)\n\n \n\nWe've already seen how the area of a non-trivial region $D$ can be computed using the change of variables formula:\n\n$$\n\\iint\\limits_{D} \\mathrm d x \\mathrm d y = \\iint\\limits_{\\Delta} \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right|  \\ \\mathrm d u \\mathrm d v\n$$\n\nWe can extend this formula to compute the integral of a function $f(x,y)$ over $D,$ as follows:\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d x \\mathrm d y = \\iint\\limits_{\\Delta} \\ f(x(u,v), y(u,v)) \\:  \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right|  \\ \\mathrm d u \\mathrm d v\n$$\n\nNote the similarity with the change of variables formula for the integral of a single-variable function $f(x)$ over $D = (a,b){:}$\n\n$$\n\\int\\limits_D f(x)\\,\\textrm d x = \\int\\limits_{\\Delta} f(x(u))\\,\\dfrac{\\textrm d x}{\\textrm d u}\\, \\textrm d u\n$$\n\nApplying the change of variables formula is similar to when we were restricting our attention to areas in the plane. The only difference now is that we must also express the integrand $f(x,y)$ in terms of $u$ and $v.$\n\nLet's see an example." #edb/ref 17592186045417] [17592186199451 #edb/ref 1065 4402 #edb/ref 17592186045417] [17592186199451 #edb/ref 1066 #uuid "2fb63b1e-64c3-58e1-94d8-3d7a87445cd7" #edb/ref 17592186045417] [17592186199451 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186373930 #edb/ref 1068 #edb/ref 17592186373931 #edb/ref 17592186045417] [17592186373930 #edb/ref 1069 "q-160911" #edb/ref 17592186045417] [17592186373930 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186373930 #edb/ref 1071 "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}(x-1){e}^{2x+2y}\\,dxdy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,1\\le x\\le 3,\\,-1\\le x+y\\le 1\\}.$" #edb/ref 17592186045417] [17592186373930 #edb/ref 1072 #uuid "077db48c-c6f6-5981-a54c-8cbea8e78815" #edb/ref 17592186045417] [17592186373930 #edb/ref 1074 "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le x\\le 3,\\,-1\\le x+y\\le 1,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=x\\,\\text{and}\\,v=x+y.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 3,\\,-1\\le v\\le 1\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}| \\\\  & =1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(x-1){e}^{2x+2y}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}(u-1){e}^{2v}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}(u-1){e}^{2v}|1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{1}^{3}(u-1)[{\\int }_{-1}^{1}{e}^{2v}\\,dv]du \\\\  & ={\\int }_{1}^{3}(u-1){[\\frac{1}{2}{e}^{2v}]}_{-1}^{1}\\,dv \\\\  & =\\frac{{e}^{2}-{e}^{-2}}{2}{\\int }_{1}^{3}(u-1)\\,dv \\\\  & =\\frac{{e}^{2}-{e}^{-2}}{2}{[\\frac{1}{2}{u}^{2}-u]}_{1}^{3} \\\\  & =\\frac{{e}^{2}-{e}^{-2}}{2}\\cdot 2 \\\\  & ={e}^{2}-{e}^{-2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186373931 #edb/ref 1075 #edb/ref 17592186373932 #edb/ref 17592186045417] [17592186373931 #edb/ref 1075 #edb/ref 17592186373933 #edb/ref 17592186045417] [17592186373931 #edb/ref 1075 #edb/ref 17592186373934 #edb/ref 17592186045417] [17592186373931 #edb/ref 1075 #edb/ref 17592186373935 #edb/ref 17592186045417] [17592186373931 #edb/ref 1075 #edb/ref 17592186373936 #edb/ref 17592186045417] [17592186373931 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373931 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373931 #edb/ref 1078 #edb/ref 17592186373933 #edb/ref 17592186045417] [17592186373931 #edb/ref 1079 #uuid "83574290-1e94-5b24-a81e-a0a3bedf25ca" #edb/ref 17592186045417] [17592186373932 #edb/ref 1080 "1-{e}^{-2}" #edb/ref 17592186045417] [17592186373932 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373932 #edb/ref 1083 #uuid "081fd6aa-767f-5e6c-8063-fd90ac7a2f8b" #edb/ref 17592186045417] [17592186373933 #edb/ref 1080 "{e}^{2}-{e}^{-2}" #edb/ref 17592186045417] [17592186373933 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373933 #edb/ref 1083 #uuid "b5b43986-8188-5a82-ad1b-7a891ddf5d41" #edb/ref 17592186045417] [17592186373934 #edb/ref 1080 "2(e-{e}^{-1})" #edb/ref 17592186045417] [17592186373934 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373934 #edb/ref 1083 #uuid "89664c48-9f18-5fb8-a023-18d5e5ef618f" #edb/ref 17592186045417] [17592186373935 #edb/ref 1080 "\\frac{2({e}^{2}-{e}^{-2})}{3}" #edb/ref 17592186045417] [17592186373935 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373935 #edb/ref 1083 #uuid "0760685b-3486-5566-8fb0-251787b04fe1" #edb/ref 17592186045417] [17592186373936 #edb/ref 1080 "3({e}^{2}-1)" #edb/ref 17592186045417] [17592186373936 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186373936 #edb/ref 1083 #uuid "541abc1d-61aa-5674-93ce-046f9a061a47" #edb/ref 17592186045417] [17592186375103 #edb/ref 1068 #edb/ref 17592186375104 #edb/ref 17592186045417] [17592186375103 #edb/ref 1069 "q-38369" #edb/ref 17592186045417] [17592186375103 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186375103 #edb/ref 1071 "Consider the region $D$ in the $xy$-plane, given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le 2x+y\\le 5,\\,0\\le y\\le 1\\}.\n$$\n\n  \n\nBy performing the change of variables $u=2x+y$ and $v=y,$ the integral \n\n$$\n{∬}_{D}(2xy+{x}^{2})\\,dx\\,dy\n$$\n\ncan be written in terms of $u$ and $v$ as" #edb/ref 17592186045417] [17592186375103 #edb/ref 1072 #uuid "db1fee9d-f261-54f6-9563-ad9a8f609d1f" #edb/ref 17592186045417] [17592186375103 #edb/ref 1074 "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 5,\\,0\\le v\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 0 & \\text{ }\\text{ }1\\end{aligned}| \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nIn this case, we first need to solve the transformation equations\n\n$$\nu=2x+y,\\,v=y\n$$\n\n \nfor $x$ and $y$, which gives\n\n$$\nx=\\frac{u-v}{2},\\,y=v.\n$$\n\n \n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+{x}^{2})\\,dx\\,dy & ={∬}_{Δ}[2\\cdot \\frac{u-v}{2}\\cdot v+{(\\frac{u-v}{2})}^{2}]|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}(uv-{v}^{2}+\\frac{{u}^{2}-2uv+{v}^{2}}{4})\\frac{1}{2}\\,du\\,dv \\\\  & =\\frac{1}{8}{\\int }_{0}^{1}{\\int }_{0}^{5}(2uv-3{v}^{2}+{u}^{2})\\,du\\,dv.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186375104 #edb/ref 1075 #edb/ref 17592186375105 #edb/ref 17592186045417] [17592186375104 #edb/ref 1075 #edb/ref 17592186375106 #edb/ref 17592186045417] [17592186375104 #edb/ref 1075 #edb/ref 17592186375107 #edb/ref 17592186045417] [17592186375104 #edb/ref 1075 #edb/ref 17592186375108 #edb/ref 17592186045417] [17592186375104 #edb/ref 1075 #edb/ref 17592186375109 #edb/ref 17592186045417] [17592186375104 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186375104 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186375104 #edb