,v)}{∂(x,y)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}3(x+y)^{2}\\,dx\\,dy & ={∬}_{Δ}3{u}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}3{u}^{2}|\\frac{1}{2}|\\text{d}u\\,\\text{d}v \\\\  & =\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186375510 #edb/ref 1075 #edb/ref 17592186375511 #edb/ref 17592186045417] [17592186375510 #edb/ref 1075 #edb/ref 17592186375512 #edb/ref 17592186045417] [17592186375510 #edb/ref 1075 #edb/ref 17592186375513 #edb/ref 17592186045417] [17592186375510 #edb/ref 1075 #edb/ref 17592186375514 #edb/ref 17592186045417] [17592186375510 #edb/ref 1075 #edb/ref 17592186375515 #edb/ref 17592186045417] [17592186375510 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186375510 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186375510 #edb/ref 1078 #edb/ref 17592186375514 #edb/ref 17592186045417] [17592186375510 #edb/ref 1079 #uuid "da395623-3256-578e-8977-74807708542d" #edb/ref 17592186045417] [17592186375511 #edb/ref 1080 "6{\\int }_{-1}^{3}{\\int }_{-4}^{-1}{u}^{2}\\,dv\\,du" #edb/ref 17592186045417] [17592186375511 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186375511 #edb/ref 1083 #uuid "0b519e50-b326-56a3-8360-01cf01bef0a1" #edb/ref 17592186045417] [17592186375512 #edb/ref 1080 "\\frac{3}{2}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}(u+v)^{2}\\,dv\\,du" #edb/ref 17592186045417] [17592186375512 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186375512 #edb/ref 1083 #uuid "8717345d-af4e-5f8b-876a-46ab0b5392c5" #edb/ref 17592186045417] [17592186375513 #edb/ref 1080 "\\frac{3}{4}{\\int }_{-1}^{3}{\\int }_{-4}^{-1}(u+v)^{2}\\,dv\\,du" #edb/ref 17592186045417] [1759218