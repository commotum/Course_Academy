} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5 \\\\  & \\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2x+13 \\\\  & 2x-1\\,\\enclose{longdiv}{\\,\\,4{x}^{2}+24x-8\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{2}-\\,\\,2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,26x-8 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{26x-13}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,5 \\\\  & \\end{aligned}\n$$\n\nTherefore, the missing expressions are \n\n$\\,$ $2x+13\\,$ and $\\,26x-8.$"}] [{:db/id #edb/ref 17592186476961 :knowledge-point/_questions [{:db/id #edb/ref 17592186129118 :knowledge-point/id #uuid "26c342f1-881b-5f3e-8c76-448eec165168" :knowledge-point/title "Dividing a Polynomial With Some Zero Coefficients by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f9d7713-3036-58bc-9aae-4e2c571f059d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-3x+5\\,$ and $\\,5x+0$" :db/id #edb/ref 17592186476419} {:answer/id #uuid "7272d4d7-e192-57a2-87cf-7e4296d5ca47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-3x-5\\,$ and $\\,-5x+10$" :db/id #edb/ref 17592186476463} {:answer/id #uuid "d8bc22b9-8843-51e4-95e8-8b4fa273adf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-3x-2\\,$ and $\\,2x+10$" :db/id #edb/ref 17592186476692} {:answer/id #uuid "dbd8932f-525a-5d8f-b046-0cd6b41e0bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}+3x+2\\,$ and $\\,2x+0$" :db/id #edb/ref 17592186476699} {:answer/id #uuid "e5b0d648-9017-5564-82d1-ffd713a93731" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}+3x+5\\,$ and $\\,5x+0$" :db/id #edb/ref 17592186476716}] :answer-field/correct {:answer/id #uuid "5f9d7713-3036-58bc-9aae-4e2c571f059d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-3x+5\\,$ and $\\,5x+0$" :db/id #edb/ref 17592186476419} :answer-field/id #uuid "4dfddf89-cb53-53d6-b1cb-c4915d35d4af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476790}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cef5d5b2-6629-5ea4-a46e-769dfb554ec8" :question/math-academy-id "q-37962" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\boxed{} \\\\  & x+3\\,\\enclose{longdiv}{\\,\\,{x}^{3}+0{x}^{2}-4x+\\phantom{1}0\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}+3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,3{x}^{2}-4x+0 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & \\,\\,\\,\\,\\,\\,\\,{5x+15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,15\\end{aligned}\n$$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$-term and the constant term. So, we write it using a zero coefficient, as follows:\n\n$$\n{x}^{3}+0{x}^{2}-4x+0\n$$\n\nUsing the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,{x}^{2}-3x+5 \\\\  & x+3\\,\\enclose{longdiv}{\\,\\,{x}^{3}+0{x}^{2}-4x+\\phantom{1}0\\,\\,} \\\\  & \\,\\,\\,\\,\\,{{x}^{3}+3{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,3{x}^{2}-4x+0 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,5x+0 \\\\  & \\,\\,\\,\\,\\,\\,\\,{5x+15}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,15\\end{aligned}\n$$\n\nTherefore, the missing expressions are\n\n$\\,$ ${x}^{2}-3x+5\\,$ and $\\,5x+0.$"}] [{:db/id #edb/ref 17592186476971 :knowledge-point/_questions [{:db/id #edb/ref 17592186129118 :knowledge-point/id #uuid "26c342f1-881b-5f3e-8c76-448eec165168" :knowledge-point/title "Dividing a Polynomial With Some Zero Coefficients by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00690689-3ae4-5a92-bc2e-e97364d44b87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x+3\\,$ and $\\,3x+6$" :db/id #edb/ref 17592186476203} {:answer/id #uuid "1fe4db4b-48ee-5078-99d2-c89a9a1e786a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x+1\\,$ and $\\,3x+2$" :db/id #edb/ref 17592186476274} {:answer/id #uuid "37a69f9e-088b-562d-91eb-cd8f8d33d181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x+3\\,$ and $\\,6x+3$" :db/id #edb/ref 17592186476326} {:answer/id #uuid "54550716-4af7-538c-8f3d-c31c24df9c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x-1\\,$ and $\\,2x+1$" :db/id #edb/ref 17592186476379} {:answer/id #uuid "d507c352-679c-50e6-8ae7-473b8d757a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x-3\\,$ and $\\,6x+3$" :db/id #edb/ref 17592186476678}] :answer-field/correct {:answer/id #uuid "37a69f9e-088b-562d-91eb-cd8f8d33d181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x+3\\,$ and $\\,6x+3$" :db/id #edb/ref 17592186476326} :answer-field/id #uuid "182693e0-0012-5b4d-9614-71a4b11bfc11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5d7e360-3d1a-54c3-a890-be5694ec9bb1" :question/math-academy-id "q-37965" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\boxed{} \\\\  & 2x+1\\,\\enclose{longdiv}{\\,\\,2{x}^{2}+7x+0} \\\\  & \\,\\,\\,\\,\\,{2{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,6x+0 \\\\  & \\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,-3\\end{aligned}\n$$" :question/worked-solution "Notice that the dividend is missing the constant term. So, we write it using a zero coefficient, as follows:\n\n$$\n2{x}^{2}+7x+0\n$$\n\nUsing the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,x+3\\, \\\\  & 2x+1\\,\\enclose{longdiv}{\\,\\,2{x}^{2}+7x+0} \\\\  & \\,\\,\\,\\,\\,{2{x}^{2}+x}_{―} \\\\  & \\,\\,\\,\\,\\,6x+0 \\\\  & \\,\\,\\,\\,\\,\\,\\,{6x+3}_{―} \\\\  & \\,\\,\\,\\,\\,-3\\end{aligned}\n$$\n\nTherefore, the missing expressions are\n\n$\\,$ $x+3\\,$ and $\\,6x+3.$"}] [{:db/id #edb/ref 17592186476899 :knowledge-point/_questions [{:db/id #edb/ref 17592186129117 :knowledge-point/id #uuid "dd4abd5d-2642-5f0d-af2f-5ed5c265526a" :knowledge-point/title "Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a6d6d47-4c1a-54c0-97fe-343a702d6c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-2x+1\\,$ and $\\,4{x}^{2}-6x$" :db/id #edb/ref 17592186476253} {:answer/id #uuid "59cb128e-8165-5a74-a2e6-8447632b54e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-2x+2\\,$ and $\\,-6{x}^{2}-4x$" :db/id #edb/ref 17592186476401} {:answer/id #uuid "8fb0433c-553a-55b0-b8f4-0ae152c8079c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-x+2\\,$ and $\\,-6{x}^{2}+4$" :db/id #edb/ref 17592186476507} {:answer/id #uuid "a551a0b4-801d-5320-b90a-8bb566c23b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}-2x+2\\,$ and $\\,6{x}^{2}-4$" :db/id #edb/ref 17592186476566} {:answer/id #uuid "b512e66f-0d89-5493-8244-73454af6f90c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-2x+1\\,$ and $\\,-4{x}^{2}+6x$" :db/id #edb/ref 17592186476615}] :answer-field/correct {:answer/id #uuid "59cb128e-8165-5a74-a2e6-8447632b54e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${x}^{2}-2x+2\\,$ and $\\,-6{x}^{2}-4x$" :db/id #edb/ref 17592186476401} :answer-field/id #uuid "5e0675ac-ffcc-5fa2-9611-c72d3057fb81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "598c7e39-8f4c-5258-a940-b21dbb59f6fe" :question/math-academy-id "q-38068" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 3x+2\\,\\enclose{longdiv}{3{x}^{3}-4{x}^{2}+2x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,6{x}^{2}+2x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x+4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{x}^{2}-2x+2 \\\\  & 3x+2\\,\\enclose{longdiv}{3{x}^{3}-4{x}^{2}+2x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{3{x}^{3}+2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,6{x}^{2}+2x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{-\\,6{x}^{2}-4x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x+4}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ ${x}^{2}-2x+2\\,$ and $\\,-6{x}^{2}-4x.$"}] [{:db/id #edb/ref 17592186476910 :knowledge-point/_questions [{:db/id #edb/ref 17592186129120 :knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf" :knowledge-point/title "Writing the Result of Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6121daca-c8d6-5f33-8349-0df5c6c8e0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14x-2+\\frac{26}{x+2}" :db/id #edb/ref 17592186476422} {:answer/id #uuid "7fd92c1c-a5b4-5d9f-9c95-22a310e80009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14x+28+\\frac{77}{x+2}" :db/id #edb/ref 17592186476485} {:answer/id #uuid "92a4537e-75a4-53bd-bd2c-d625341b0c25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x-14+\\frac{27}{x+2}" :db/id #edb/ref 17592186476518} {:answer/id #uuid "c3485231-8e5e-51d2-838a-2a05f2103a24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-7+\\frac{72}{x+2}" :db/id #edb/ref 17592186476642} {:answer/id #uuid "f3ec1ec7-c326-5c31-a5fa-2a4a18f563e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1+\\frac{14}{x+2}" :db/id #edb/ref 17592186476742}] :answer-field/correct {:answer/id #uuid "92a4537e-75a4-53bd-bd2c-d625341b0c25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x-14+\\frac{27}{x+2}" :db/id #edb/ref 17592186476518} :answer-field/id #uuid "4a408997-1f40-5ca8-9346-68a33d5f43ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d7283af-f396-5468-82fb-4bc5cf7a26db" :question/math-academy-id "q-38074" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x-14 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,-2{x}^{2}-18x-\\phantom{1}1\\,\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{-2{x}^{2}-4x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-14x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-14x-28}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,27\\end{aligned}\n$$\n\nFrom the above, $\\frac{-2{x}^{2}-18x-1}{x+2}=$" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,-2x-14 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,-2{x}^{2}-18x-\\phantom{1}1\\,\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{-2{x}^{2}-4x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,-14x-1 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-14x-28}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,27\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $-2{x}^{2}-18x-1$ by the linear binomial $x+2$ gives\n\n- the quotient $-2x-14,$ and\n\n- the remainder $27.$\n\nTherefore, we obtain\n\n$$\n\\frac{-2{x}^{2}-18x-1}{x+2}=-2x-14+\\frac{27}{x+2}.\n$$"}] [{:db/id #edb/ref 17592186476894 :knowledge-point/_questions [{:db/id #edb/ref 17592186129118 :knowledge-point/id #uuid "26c342f1-881b-5f3e-8c76-448eec165168" :knowledge-point/title "Dividing a Polynomial With Some Zero Coefficients by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd98812-61b5-5ff4-9406-13a68de9fc9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}+3x-5\\,$ and $\\,-5x+20$" :db/id #edb/ref 17592186476260} {:answer/id #uuid "2e23c518-4127-5d89-ad22-11745eab87b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-6x+10\\,$ and $\\,10x+5$" :db/id #edb/ref 17592186476305} {:answer/id #uuid "ab9d4c04-1593-54ac-a096-03d06183bf9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-6x+10\\,$ and $\\,20x+5$" :db/id #edb/ref 17592186476583} {:answer/id #uuid "b10db460-724b-5352-814a-3b123df62556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}+6x-10\\,$ and $\\,-20x-5$" :db/id #edb/ref 17592186476599} {:answer/id #uuid "e6788818-475c-590e-852b-e90d260074b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-3x+5\\,$ and $\\,20x-5$" :db/id #edb/ref 17592186476719}] :answer-field/correct {:answer/id #uuid "ab9d4c04-1593-54ac-a096-03d06183bf9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3{x}^{2}-6x+10\\,$ and $\\,20x+5$" :db/id #edb/ref 17592186476583} :answer-field/id #uuid "77cb842f-af82-5e3c-b273-ad897c801074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d09c9f5-beb6-5a3a-99b2-d8098f93c67b" :question/math-academy-id "q-38104" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\boxed{} \\\\  & 2x+4\\,\\enclose{longdiv}{\\,\\,6{x}^{3}+\\phantom{1}0{x}^{2}-\\phantom{1}4x+\\phantom{1}5\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,12{x}^{2}-4x+5 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,12{x}^{2}-24x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & \\,\\,\\,\\,\\,\\,\\,{20x+40}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,35\\end{aligned}\n$$" :question/worked-solution "Notice that the dividend is missing the ${x}^{2}$-term. So, we write it using a zero coefficient, as follows:\n\n$$\n6{x}^{3}+0{x}^{2}-4x+5\n$$\n\nUsing the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}-6x+10 \\\\  & 2x+4\\,\\enclose{longdiv}{\\,\\,6{x}^{3}+\\phantom{1}0{x}^{2}-\\phantom{1}4x+\\phantom{1}5\\,\\,} \\\\  & \\,\\,\\,\\,\\,{6{x}^{3}+12{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,12{x}^{2}-4x+5 \\\\  & \\,\\,\\,\\,\\,\\,{-\\,12{x}^{2}-24x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,20x+5 \\\\  & \\,\\,\\,\\,\\,\\,\\,{20x+40}_{―} \\\\  & \\,\\,\\,\\,\\,\\,-\\,35\\end{aligned}\n$$\n\nTherefore, the missing expressions are\n\n$\\,$ $3{x}^{2}-6x+10\\,$ and $\\,20x+5.$"}] [{:db/id #edb/ref 17592186476941 :knowledge-point/_questions [{:db/id #edb/ref 17592186129118 :knowledge-point/id #uuid "26c342f1-881b-5f3e-8c76-448eec165168" :knowledge-point/title "Dividing a Polynomial With Some Zero Coefficients by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fb0fd1-4f91-57c9-9d97-59b378fa032e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x+49\\,$ and $\\,49x-6$" :db/id #edb/ref 17592186476214} {:answer/id #uuid "218d462b-d6f8-5a2c-8cce-b48fe895db83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x+7\\,$ and $\\,7x-42$" :db/id #edb/ref 17592186476279} {:answer/id #uuid "566bc607-57aa-57b9-a3c9-0ee36ce6ebc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x-49\\,$ and $\\,-49x+6$" :db/id #edb/ref 17592186476386} {:answer/id #uuid "8714f9d8-0aeb-569c-bc14-f4d10d14a5e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x+49\\,$ and $\\,49x-343$" :db/id #edb/ref 17592186476497} {:answer/id #uuid "ee24db36-8bfa-5be2-9784-f61aed7f16ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x-49\\,$ and $\\,-49x-6$" :db/id #edb/ref 17592186476734}] :answer-field/correct {:answer/id #uuid "05fb0fd1-4f91-57c9-9d97-59b378fa032e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7x+49\\,$ and $\\,49x-6$" :db/id #edb/ref 17592186476214} :answer-field/id #uuid "bc476439-d624-5e0c-b41e-7cea26dc47b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad64733e-6511-5f51-b164-9b0ad359ab1e" :question/math-academy-id "q-38112" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\boxed{} \\\\  & x-7\\,\\enclose{longdiv}{\\,\\,7{x}^{2}+\\phantom{0}0x-\\phantom{00}6} \\\\  & \\,\\,\\,\\,\\,{7{x}^{2}-49x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & \\,\\,\\,\\,\\,\\,\\,{49x-343}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,337\\end{aligned}\n$$" :question/worked-solution "Notice that the dividend is missing the $x$-term. So, we write it using a zero coefficient, as follows:\n\n$$\n7{x}^{2}+0x-6\n$$\n\nUsing the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,7x+49 \\\\  & x-7\\,\\enclose{longdiv}{\\,\\,7{x}^{2}+\\phantom{0}0x-\\phantom{00}6} \\\\  & \\,\\,\\,\\,\\,{7{x}^{2}-49x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,49x-6 \\\\  & \\,\\,\\,\\,\\,\\,\\,{49x-343}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,337\\end{aligned}\n$$\n\nTherefore, the missing expressions are\n\n$\\,$ $7x+49\\,$ and $\\,49x-6.$"}]}
