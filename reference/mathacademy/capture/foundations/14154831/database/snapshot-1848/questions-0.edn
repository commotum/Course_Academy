,\\,14{x}^{2}+75x+80 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{14{x}^{2}+56x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,19x+80 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{19x+76}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,4\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ $15{x}^{2}+14x+19\\,$ and $\\,14{x}^{2}+75x+80.$"}] [{:db/id #edb/ref 17592186476938 :knowledge-point/_questions [{:db/id #edb/ref 17592186129117 :knowledge-point/id #uuid "dd4abd5d-2642-5f0d-af2f-5ed5c265526a" :knowledge-point/title "Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ce55d8d-bc57-5a4a-8fa5-5b7412b96544" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}-2x+2\\,$ and $\\,4{x}^{2}+4x+1$" :db/id #edb/ref 17592186476409} {:answer/id #uuid "5e971f14-87ba-5077-847a-5c6cdf159be1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}+2x-1\\,$ and $\\,-4{x}^{2}-4x+1$" :db/id #edb/ref 17592186476414} {:answer/id #uuid "5f21f279-2886-58d0-a40c-77142122dc73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}+2x-2\\,$ and $\\,-4{x}^{2}+4x-1$" :db/id #edb/ref 17592186476415} {:answer/id #uuid "9b2625da-e958-5eac-9a20-c34b020e190d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}+2x+1\\,$ and $\\,4{x}^{2}+4x-1$" :db/id #edb/ref 17592186476539} {:answer/id #uuid "e5526748-76c0-563c-9189-d6ae5c135baf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{2}-2x+1\\,$ and $\\,-4{x}^{2}+4x+1$" :db/id #edb/ref 17592186476715}] :answer-field/correct {:answer/id #uuid "e5526748-76c0-563c-9189-d6ae5c135baf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2{x}^{