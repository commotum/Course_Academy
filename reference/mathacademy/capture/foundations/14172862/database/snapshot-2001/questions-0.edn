ions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b3a3727-45a2-5fb4-95ae-a91e8f4f3239" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451353} {:answer/id #uuid "560e913c-ce8a-5991-9d57-1efe0344f54f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451354}] :answer-field/correct {:answer/id #uuid "560e913c-ce8a-5991-9d57-1efe0344f54f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451354} :answer-field/id #uuid "7994875a-855a-584f-b0b1-e9adddf96e49" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452524} {:answer-field/choices [{:answer/id #uuid "f71e555b-f6a2-5bfa-a969-f07e226574ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451355} {:answer/id #uuid "cfe4cba6-6e86-5be1-8135-57a663228532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451356}] :answer-field/correct {:answer/id #uuid "cfe4cba6-6e86-5be1-8135-57a663228532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451356} :answer-field/id #uuid "ae639aa0-32cb-59c4-89fa-57a75c8e85c1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452525} {:answer-field/choices [{:answer/id #uuid "d934afb8-4872-512d-b557-15198d1a48a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451357} {:answer/id #uuid "a5f2982f-15e7-58c5-94f1-438da460594b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451358}] :answer-field/correct {:answer/id #uuid "a5f2982f-15e7-58c5-94f1-438da460594b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451358} :answer-field/id #uuid "d5a8d921-2a8a-515d-b4dc-86f366326881" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452526} {:answer-field/choices [{:answer/id #uuid "bc6f1bb2-59b1-5487-b01f-c8947e4f8b79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451359} {:answer/id #uuid "ee66f17e-227c-5e22-9f23-dbee97ac1f55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451360}] :answer-field/correct {:answer/id #uuid "bc6f1bb2-59b1-5487-b01f-c8947e4f8b79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451359} :answer-field/id #uuid "f9876e54-bdbd-59af-a25c-ae629c2446e5" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ed6c488-d6f4-5c35-b1ec-2f3c2d68e465" :question/math-academy-id "q-43779" :question/problem "Consider the vector space $C[-1,1]$ of all continuous functions $f:[-1,1]\\to R$ and its subset $B={f\\in C[-1,1]\\,|\\,f(1)=f(-1)}.$ \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is closed under function addition\n- **II.** $B$ is closed under scalar multiplication\n- **III.** $B$ is a subspace of $C[-1,1]$\n- **IV.** $B$ is **not** a subspace of $C[-1,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in B,$ then\n\n$$\n\\begin{aligned}(f+g)(1) & =f(1)+g(1) \\\\  & =f(-1)+g(-1) \\\\  & =(f+g)(-1).\\end{aligned}\n$$\n\nSo, $B$ is closed under addition.\n\n- Statement II is true. If $f(x)\\in B$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}(kf)(1) & =kf(1) \\\\  & =kf(-1) \\\\  & =(kf)(-1).\\end{aligned}\n$$\n\nSo, $B$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $B$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186360468 :knowledge-point/_questions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991f2f73-ac23-5191-ab80-7de9efee7e9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452009} {:answer/id #uuid "2ead1013-7e82-50d2-9ea0-c2b7d5a04066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452010}] :answer-field/correct {:answer/id #uuid "2ead1013-7e82-50d2-9ea0-c2b7d5a04066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452010} :answer-field/id #uuid "506cf49e-9f52-5299-8ed3-6ff8e24478db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452852} {:answer-field/choices [{:answer/id #uuid "fed6d2ec-aee8-5542-8372-ae559f20b93f" :answer/ty