xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>cos</mi><mn>4</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi>s</mi></mrow><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">i</mi></mrow><mo>+</mo><msup><mi>sin</mi><mn>4</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi>s</mi></mrow><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">j</mi></mrow></math></mjx-assistive-mml></mjx-container> "
