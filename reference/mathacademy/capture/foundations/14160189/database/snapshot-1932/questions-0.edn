#{[{:db/id #edb/ref 17592186262817 :knowledge-point/_questions [{:db/id #edb/ref 17592186119746 :knowledge-point/id #uuid "4aecbb8b-bda3-5956-9b0f-98509330a84d" :knowledge-point/title "Finding the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024627dc-383d-5860-af06-8aa6e2da6ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{\\sqrt{3}})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{\\sqrt{3}})⟩" :db/id #edb/ref 17592186259889} {:answer/id #uuid "373cd070-c493-5aea-bf0e-9215551aac13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡3s-2,\\,1-3\\operatorname{sin}⁡3s⟩" :db/id #edb/ref 17592186260368} {:answer/id #uuid "9e6395f8-6ebe-5c9f-b14e-154974e4a4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{2}⟨\\operatorname{sin}⁡2s,\\,\\operatorname{cos}⁡2s⟩" :db/id #edb/ref 17592186261248} {:answer/id #uuid "e4ce8f43-76db-5d23-b911-0dec03f55f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=-3⟨\\operatorname{sin}⁡(\\frac{s}{3}),\\,\\operatorname{cos}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186261887} {:answer/id #uuid "fab3aaa0-4b41-5a1b-9408-231dbe0c5b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186262067}] :answer-field/correct {:answer/id #uuid "fab3aaa0-4b41-5a1b-9408-231dbe0c5b7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186262067} :answer-field/id #uuid "db150d83-e01a-590a-b532-af881f45cce8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262504}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40071fab-d489-5d46-9356-22b420cd3a67" :question/math-academy-id "q-127732" :question/problem "What is the parametrization of the curve $r(t)=⟨3\\operatorname{cos}⁡t-2,\\,1-3\\operatorname{sin}⁡t⟩,$ $t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-2),\\,\\frac{\\text{d}}{\\text{d}t}(1-3\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-3\\operatorname{sin}⁡t,\\,-3\\operatorname{cos}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(-3\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\sqrt{9{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}3\\,\\text{d}u \\\\  & =3u\\,{|}_{0}^{t} \\\\  & =3t\\end{aligned}\n$$\n\nSince $s=3t,$ we have that $t=\\frac{s}{3}.$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{3}) \\\\  & =⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120356 :knowledge-point/_questions [{:db/id #edb/ref 17592186119747 :knowledge-point/id #uuid "fc7343e3-fa7d-58c8-b4c7-49ef5b85110b" :knowledge-point/title "Finding a Unit Tangent Given the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8945c753-d17f-5a69-9d32-c06a9b9981f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T(s) = \\frac{s}{2}i + \\frac{\\sqrt{2}s}{2}j - \\frac{s}{2}k" :db/id #edb/ref 17592186118251} {:answer/id #uuid "94b5c61c-ab99-5951-9d10-9d65874b051c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T(s) = \\frac{1}{2}i + \\frac{\\sqrt{2}}{2}j + \\frac{1}{2}k" :db/id #edb/ref 17592186118252} {:answer/id #uuid "f7f034b3-ae5c-5b2e-a78c-baf63d26b16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T(s) = \\frac{1}{2}i - \\frac{\\sqrt{3}}{2}j - \\frac{1}{2}k" :db/id #edb/ref 17592186118253} {:answer/id #uuid "16d28e95-d1a3-584d-8367-054f53036bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T(s) = i + \\sqrt{3}j - k" :db/id #edb/ref 17592186118254} {:answer/id #uuid "4644116a-9b2f-52bf-8b75-e979948232b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T(s) = \\frac{1}{2}i + \\frac{\\sqrt{2}}{2}j - \\frac{1}{2}k" :db/id #edb/ref 17592186118255}] :answer-field/id #uuid "b10f0145-3d4d-5529-9dac-9ea4a90d8cc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118250}] :question/id #uuid "dcc2eb2b-f195-52bb-b223-b20a6a536e9f" :question/math-academy-id "q-34666" :question/problem "Given the curve $r(t) = (t + 2)i + (\\sqrt{2}t - 2)j - tk$, $t \\ge 0$, for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s = 2t$, find the corresponding unit tangent $T(s)$, parametrized by $s$."}] [{:db/id #edb/ref 17592186393842 :knowledge-point/_questions [{:db/id #edb/ref 17592186119746 :knowledge-point/id #uuid "4aecbb8b-bda3-5956-9b0f-98509330a84d" :knowledge-point/title "Finding the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fc4c695-abde-5448-ab84-839794d4b9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(s)\\,i+\\operatorname{cos}⁡(s)\\,j" :db/id #edb/ref 17592186393844} {:answer/id #uuid "82715f51-4266-5316-ba54-15a96b26aea9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{4}⁡(s)\\,i+{sin}^{4}⁡(s)\\,j" :db/id #edb/ref 17592186393845} {:answer/id #uuid "986a4e80-ffd7-5103-99bd-9d5fbf8fa7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡({s}^{4})\\,i+\\operatorname{cos}⁡({s}^{4})\\,j" :db/id #edb/ref 17592186393846} {:answer/id #uuid "7aeedef8-6d70-5a50-8672-9a39d5a5f8be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(s)\\,i+\\operatorname{sin}⁡(s)\\,j" :db/id #edb/ref 17592186393847} {:answer/id #uuid "12c6fdf5-7cf6-53c1-8053-8f7bd4a787ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡({s}^{3})\\,i-\\operatorname{sin}⁡({s}^{3})\\,j" :db/id #edb/ref 17592186393848}] :answer-field/correct {:answer/id #uuid "7aeedef8-6d70-5a50-8672-9a39d5a5f8be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(s)\\,i+\\operatorname{sin}⁡(s)\\,j" :db/id #edb/ref 17592186393847} :answer-field/id #uuid "96e7a5ea-46f6-52ca-814b-b0356c2e00b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d899d29b-8ceb-54bb-99b6-823abccec15f" :question/math-academy-id "q-78391" :question/problem "What is the parametrization of the curve $r(t)=\\operatorname{cos}⁡({t}^{4})\\,i+\\operatorname{sin}⁡({t}^{4})\\,j,$  $\\,t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡({t}^{4}))i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡({t}^{4}))j \\\\  & =-4{t}^{3}\\operatorname{sin}⁡({t}^{4})\\,i+4{t}^{3}\\operatorname{cos}⁡({t}^{4})\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{[-4{t}^{3}\\operatorname{sin}⁡({t}^{4})]}^{2}+{[4{t}^{3}\\operatorname{cos}⁡({t}^{4})]}^{2}} \\\\  & =4|t{|}^{3}\\sqrt{{sin}^{2}⁡({t}^{4})+{cos}^{2}⁡({t}^{4})} \\\\  & =4{t}^{3}\\end{aligned}\n$$\n\nNext, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}4{u}^{3}\\,\\text{d}u \\\\  & ={u}^{4}\\,{|}_{0}^{t} \\\\  & ={t}^{4}\\end{aligned}\n$$\n\n  \n\nNow, since $s={t}^{4}$, we have that\n\n$$\n\\begin{aligned}{t}^{4} & =s \\\\ t & =\\sqrt[4]{s}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\sqrt[4]{s}) \\\\  & =cos\\,((\\sqrt[4]{s})^{4})\\,i+sin\\,((\\sqrt[4]{s})^{4})\\,j \\\\  & =\\operatorname{cos}⁡(s)\\,i+\\operatorname{sin}⁡(s)\\,j.\\end{aligned}\n$$"}]}
