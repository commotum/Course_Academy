#{[{:db/id #edb/ref 17592186323940 :knowledge-point/_questions [{:db/id #edb/ref 17592186124536 :knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d94a386-0e3f-5fd6-82d2-7e3b9d7cbeec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321252} {:answer/id #uuid "2cbc3e40-f109-58b8-872a-95626283c9f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186321493} {:answer/id #uuid "389d0b0e-b88a-5ab8-9fa3-85ae37139eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321578} {:answer/id #uuid "73fc0bbe-4d33-5b94-bad1-7a748598633e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186322053} {:answer/id #uuid "f9936d7e-e12d-5d02-a132-90f3f19d81e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186323111}] :answer-field/correct {:answer/id #uuid "0d94a386-0e3f-5fd6-82d2-7e3b9d7cbeec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321252} :answer-field/id #uuid "399304a9-7f1c-5273-8e27-ae2b68d805f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323284}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a72555f5-f964-563d-a2c6-2e5bad5e5508" :question/math-academy-id "q-37778" :question/problem "Given that $\\,A=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]\\,$ and $\\,{A}^{-1}=pI+qA$, find the value $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 3 \\\\ 1 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(2-\\lambda )-3 & =0 \\\\ {\\lambda }^{2}-4\\lambda +1 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-4A+I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-4A+I) & =O \\\\ A-4I+{A}^{-1} & =O \\\\ {A}^{-1} & =4I-A\\end{aligned}\n$$\n\nTherefore, $p=4,$ $q=-1$ and\n\n$$\np+q=4+(-1)=3.\n$$"}] [{:db/id #edb/ref 17592186125140 :knowledge-point/_questions [{:db/id #edb/ref 17592186124537 :knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38" :knowledge-point/title "Expressing a Power of a Matrix as a Linear Combination of Smaller Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "486030d8-debf-5bf3-8646-937755b93331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2A+{A}^{2}" :db/id #edb/ref 17592186324558} {:answer/id #uuid "7cb39a68-d9fa-5afc-a46e-1646bc050802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{A}^{2}-A" :db/id #edb/ref 17592186325023} {:answer/id #uuid "8f700b32-f8f5-50c2-8448-a2e3950f6cf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{A}^{2}-I" :db/id #edb/ref 17592186325188} {:answer/id #uuid "d2abfec0-1ad1-5263-bbad-6dc6f697cbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2A-I" :db/id #edb/ref 17592186325799} {:answer/id #uuid "ec99ac0a-a7c2-59e7-88f3-37b0874d74a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2A-I" :db/id #edb/ref 17592186326052}] :answer-field/correct {:answer/id #uuid "ec99ac0a-a7c2-59e7-88f3-37b0874d74a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2A-I" :db/id #edb/ref 17592186326052} :answer-field/id #uuid "9ae27e9b-e1c9-591e-ae97-64fbf12bf64f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326497}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "241347e1-d70b-502b-97bb-5ffa2634f0a1" :question/math-academy-id "q-38723" :question/problem "Let $A$ be a $3\\times 3$ matrix with the characteristic polynomial $p(\\lambda )=-{\\lambda }^{3}-2\\lambda -1.$ Then, ${A}^{3}=$" :question/worked-solution "Using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ -{A}^{3}-2A-I & =O \\\\ {A}^{3} & =-2A-I.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392225 :knowledge-point/_questions [{:db/id #edb/ref 17592186124538 :knowledge-point/id #uuid "787173e1-f957-5ff0-9d14-a6ccb11de1d8" :knowledge-point/title "Evaluating a Matrix Polynomial Using the Cayley-Hamilton Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee48dc36-244e-5623-8162-9e5def5de475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 & -22 \\\\ 6 & -6\\end{aligned}]" :db/id #edb/ref 17592186392227} {:answer/id #uuid "4e10d15f-edfd-50e4-802f-39336ec76684" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -22 \\\\ 6 & 12\\end{aligned}]" :db/id #edb/ref 17592186392228} {:answer/id #uuid "7b98b20b-4948-5630-912d-d10854621cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & -22 \\\\ 6 & 18\\end{aligned}]" :db/id #edb/ref 17592186392229} {:answer/id #uuid "e5ce0307-f7b7-5df0-93a8-a3b0f9edcea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & -22 \\\\ 18 & 6\\end{aligned}]" :db/id #edb/ref 17592186392230} {:answer/id #uuid "52829169-8b9a-5477-a7ca-27875b4c0680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-22 & -6 \\\\ 6 & 18\\end{aligned}]" :db/id #edb/ref 17592186392231}] :answer-field/correct {:answer/id #uuid "7b98b20b-4948-5630-912d-d10854621cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & -22 \\\\ 6 & 18\\end{aligned}]" :db/id #edb/ref 17592186392229} :answer-field/id #uuid "f2234961-7a5f-5c89-bdd3-f09c2cf9ab03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c6e1cb3-d3e5-5ac7-9b61-9f6c0c45ae57" :question/math-academy-id "q-38728" :question/problem "Given the matrix\n$\\,A=[\\begin{aligned}6 & 11 \\\\ -3 & -6\\end{aligned}]$\nand $f(x)={x}^{15}-3{x}^{13}+{x}^{3}-5x+6$, find $f(A).$" :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda )$:\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =|\\begin{aligned}6-\\lambda  & 11 \\\\ -3 & -6-\\lambda \\end{aligned}| \\\\  & =(6-\\lambda )(-6-\\lambda )+33 \\\\  & ={\\lambda }^{2}-3\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n|  | $\\,\\,{x}^{13}$ | $+$ | $x$ |  |  |  |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| ${x}^{2}-3\\,$ | $\\,\\enclose{longdiv}{{x}^{15}-3{x}^{13}+{x}^{3}-5x+6}$ |  |  |  |  |  |  |  |\n|  | ${x}^{15}$ | $\\,\\,\\,\\,-$ | $\\,\\,\\,\\,3{x}^{13}$ |  |  |  |  |  |\n|  |  |  |  | ${x}^{3}\\,\\,\\,\\,\\,\\,$ | $-\\,\\,$ | $\\,\\,5x$ | $\\,\\,\\,\\,\\,+$ | $\\,\\,\\,\\,\\,\\,\\,6$ |\n|  |  |  |  | ${x}^{3}\\,\\,\\,\\,\\,\\,$ | $-\\,\\,$ | $\\,\\,3x$ |  |  |\n|  |  |  |  |  | $-\\,\\,$ | $\\,\\,2x$ | $\\,\\,\\,\\,\\,+$ | $\\,\\,\\,\\,\\,\\,\\,6$ |\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(-2x+6)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{13}+x.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(-2A+6I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(-2A+6I) \\\\  & =q(A)\\cdot O+(-2A+6I) \\\\  & =-2A+6I \\\\  & =-2[\\begin{aligned}6 & 11 \\\\ -3 & -6\\end{aligned}]+6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & -22 \\\\ 6 & 12\\end{aligned}]+[\\begin{aligned}6 & 0 \\\\ 0 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -22 \\\\ 6 & 18\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326811 :knowledge-point/_questions [{:db/id #edb/ref 17592186124536 :knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bf09fd-3fd5-5fa9-bd7c-9bb8300133ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}I-\\frac{1}{2}A-\\frac{3}{2}{A}^{2}" :db/id #edb/ref 17592186324178} {:answer/id #uuid "2196ad3b-dc18-575d-9ac5-f3e82f2cf1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}I-\\frac{1}{2}A-\\frac{1}{2}{A}^{2}" :db/id #edb/ref 17592186324248} {:answer/id #uuid "ae47339b-004d-5c20-8d9d-8aab1f4f98f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2I-A-2{A}^{2}" :db/id #edb/ref 17592186325449} {:answer/id #uuid "bc9f773a-008b-571e-8538-a3402ba6e607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}I-\\frac{7}{2}A-\\frac{1}{2}{A}^{2}" :db/id #edb/ref 17592186325590} {:answer/id #uuid "d899671a-8147-5a25-9c47-966430b53806" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9I-A-{A}^{2}" :db/id #edb/ref 17592186325855}] :answer-field/correct {:answer/id #uuid "2196ad3b-dc18-575d-9ac5-f3e82f2cf1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}I-\\frac{1}{2}A-\\frac{1}{2}{A}^{2}" :db/id #edb/ref 17592186324248} :answer-field/id #uuid "f00c9e90-925d-5d82-b4f9-f2d77c2b5637" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326651}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d383f46-698f-5924-8d8d-4466dfa087b0" :question/math-academy-id "q-40168" :question/problem "If $A=[\\begin{aligned}2 & 1 & 1 \\\\ 0 & -4 & -3 \\\\ 0 & 1 & 1\\end{aligned}],$ then ${A}^{-1}=$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 1 & 1 \\\\ 0 & -4-\\lambda  & -3 \\\\ 0 & 1 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )|\\begin{aligned}-4-\\lambda  & -3 \\\\ 1 & 1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )((-4-\\lambda )(1-\\lambda )+3) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}+3\\lambda -1) & =0 \\\\ {\\lambda }^{3}+{\\lambda }^{2}-7\\lambda +2 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{3}+{A}^{2}-7A+2I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{3}+{A}^{2}-7A+2I) & =O \\\\ {A}^{2}+A-7I+2{A}^{-1} & =O \\\\ 2{A}^{-1} & =7I-A-{A}^{2} \\\\ {A}^{-1} & =\\frac{7}{2}I-\\frac{1}{2}A-\\frac{1}{2}{A}^{2}\\end{aligned}\n$$"}]}
