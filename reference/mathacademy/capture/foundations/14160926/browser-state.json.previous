      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14160926/observations/step-q38723-73e05b67dc01cfeab06c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14160926/observations/step-q38723-73e05b67dc01cfeab06c.png",
      "source_url": "https://mathacademy.com/tasks/14160926/topics/1972/review",
      "captured_at": 1791881442.4958584,
      "math_academy_id": "q-38723",
