1}$ and then ${R}_{3}:={R}_{3}+6\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 6 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={[\\begin{aligned}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 6 & 0 & 1\\end{aligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -6 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ -6 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302329 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2c73-b3f3-5f9e-bdca-1b5b280e8ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186299976} {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300075} {:answer/id #uuid "19c8433d-ce31-55b1-ace0-59e14900aabb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300076} {:answer/id #uuid "7190b1cb-7787-5bdb-9600-71dbc81662e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300527} {:answer/id #uuid "c9f2b7f6-5083-5e02-a198-e7a6dbb7f6c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300969}] :answer-field/correct {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300075} :answer-field/id #uuid "1a4a2fa1-bb43-517d-8181-7f72736b0a79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" :question/math-academy-id "q-32722" :question/problem "Given that\n$K=[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}]$\nhas the LU decomposition $K=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}^{-1}U \\\\ K & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}])U \\\\ K & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186478389 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "620d1ff8-8a66-524c-9a18-4611eb533903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186477936} {:answer/id #uuid "a8229c2f-308b-597c-935f-037b198c514e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186478059} {:answer/id #uuid "b5565a18-21c8-5f36-812d-03ab73d8cc7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186478092} {:answer/id #uuid "bf53dc00-7696-5298-9aab-cc5fc495c6b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186478108} {:answer/id #uuid "d38c971f-5ff4-53b0-8bed-f841f5adc5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186478155}] :answer-field/correct {:answer/id #uuid "b5565a18-21c8-5f36-812d-03ab73d8cc7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186478092} :answer-field/id #uuid "bcb88867-c746-5858-a1d1-212c8c3726d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478332}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36db6e8d-a408-5095-ac80-d2586ba2ff72" :question/math-academy-id "q-75103" :question/problem "Given that \n$A=[\\begin{aligned}1 & -3 & 0 \\\\ 4 & -8 & -2 \\\\ -5 & 15 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -3 & 0 \\\\ 4 & -8 & -2 \\\\ -5 & 15 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 4 & -2 \\\\ -5 & 15 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 4 & -2 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -3 & 0 \\\\ 0 & 4 & -2 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=-5,{u}_{22}=4,$ and ${l}_{31}\\cdot {u}_{22}=-20.$"}] [{:db/id #edb/ref 17592186478385 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7f7f5-fc72-5752-849f-dd392dc67063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186477756} {:answer/id #uuid "12b75b29-bad6-5c35-80f2-edeb27a01c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186477768} {:answer/id #uuid "1c445559-7267-5297-9c5a-68d5a53864a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186477786} {:answer/id #uuid "902048e6-162f-5f83-b702-3baaf39b7262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186478022} {:answer/id #uuid "e5d89713-1ab5-55e2-a0fa-594c33b016e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186478190}] :answer-field/correct {:answer/id #uuid "0bb7f7f5-fc72-5752-849f-dd392dc67063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186477756} :answer-field/id #uuid "e7369fce-c748-5601-8fcb-67f8bc1ae355" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "277999dd-79b5-5a59-931f-a7b78502d7ff" :question/math-academy-id "q-75104" :question/problem "Given that \n$A=[\\begin{aligned}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-1 & 1 & -4 \\\\ 3 & -5 & 6 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-1 & 1 & -4 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & -2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{1}{2},{u}_{33}=-2,$ and ${l}_{32}\\cdot {u}_{33}=1.$"}] [{:db/id #edb/ref 17592186478435 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148aeac6-9429-5975-8721-cae7f8b07799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -\\frac{1}{2} & \\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186477772} {:answer/id #uuid "3005c1d7-1c6a-5f2d-adca-97d0c2b4775a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186477822} {:answer/id #uuid "3d120f50-4d8d-5a4e-b725-2b885385d0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ \\frac{1}{2} & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186477848} {:answer/id #uuid "c7f77f4d-fe4c-5031-adbe-7f23e6d3b3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -\\frac{1}{2} & -\\frac{3}{2} & 1\\end{aligned}]" :db/id #edb/ref 17592186478130} {:answer/id #uuid "fb1df5bb-c79a-547f-9735-ac4096fa61a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186478236}] :answer-field/correct {:answer/id #uuid "3005c1d7-1c6a-5f2d-adca-97d0c2b4775a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186477822} :answer-field/id #uuid "46cb0807-3b4d-5bc8-8e82-18d595a4e58c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478274}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b3806686-48f6-58e2-b9ed-3e1024804191" :question/math-academy-id "q-75105" :question/problem "Given that \n$A=[\\begin{aligned}2 & -6 & 4 \\\\ 3 & -6 & -2 \\\\ -1 & 0 & -5\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & -6 & 4 \\\\ 3 & -6 & -2 \\\\ -1 & 0 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ -1 & 0 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ 0 & 0 & -11\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ \\frac{1}{2} & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{2} & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{3}{2} & 1 & 0 \\\\ -\\frac{1}{2} & -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & -6 & 4 \\\\ 0 & 3 & -8 \\\\ 0 & 0 & -11\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}]}
