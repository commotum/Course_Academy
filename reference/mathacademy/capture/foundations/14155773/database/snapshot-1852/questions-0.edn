ed}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 8 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 8 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399566 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fed22c0d-0f9b-57d1-92a2-caecdc72420b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399568} {:answer/id #uuid "3dfb8aa6-6f92-55b7-84d4-1a32fd997449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399569} {:answer/id #uuid "ac6e2e5e-e175-5321-89f2-b8167e85c478" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186399570} {:answer/id #uuid "b3fa4db5-51d1-519e-a890-420dd4b64ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399571} {:answer/id #uuid "4e8948a3-a5b2-529f-a83b-2897c1197641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399572}] :answer-field/correct {:answer/id #uuid "4e8948a3-a5b2-529f-a83b-2897c1197641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399572} :answer-field/id #uuid "35865859-bc92-5d3f-aac6-8f0761f92bd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4eefc328-7753-58ac-9913-74a31d74d60d" :question/math-academy-id "q-106849" :question/problem "Suppose that a $3\\times 3$ matrix $H$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{3}:={R}_{3}-4{R}_{1}.\n$$\n\nGiven that $H$ has the LU factorization $H=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+1\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-4)\\cdot {R}_{1}$ is equivalent to multiplying $H$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243968 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0103ed51-38eb-56e1-b5b6-506ac5114dcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186241194} {:answer/id #uuid "28f58628-e349-51a5-9381-2a6c3f3e63d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186241538} {:answer/id #uuid "362edb3b-c2c6-5e35-b27f-a4726544a314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186241655} {:answer/id #uuid "88c00484-3dac-50cd-9b40-2f30d2fe5429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186242384} {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243101}] :answer-field/correct {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186243101} :answer-field/id #uuid "97841af7-3445-571b-82d4-01c790eeec83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243720}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "715f2529-cb8e-5152-b727-a6588c23a27e" :question/math-academy-id "q-106856" :question/problem "Given that \n$A=[\\begin{aligned}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{aligned}]$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$"}] [{:db/id #edb/ref 17592186120190 :knowledge-point/_questions [{:db/id #edb/ref 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82aab95b-303c-53e6-8ab2-84f6327c5ee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117302} {:answer/id #uuid "bcb99789-0a50-51fa-bdd2-8edcdb147b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117303} {:answer/id #uuid "c1646219-17da-5382-a70c-29be623f2a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 5 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117304} {:answer/id #uuid "6fa6c065-8e80-5891-9d48-f1f2b1d88af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117305} {:answer/id #uuid "7d799ac4-cfd7-50f4-84fe-96c72faba44f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117306}] :answer-field/id #uuid "eb09a7a1-1cf1-5147-b432-0481d5365f80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117301} {:answer-field/choices [{:answer/id #uuid "0b7abb7a-38b8-51e1-aca2-0d2b5391e4f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402049} {:answer/id #uuid "1602c8f1-24ac-5bc4-886f-c23bd7016636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186402050} {:answer/id #uuid "9cc39e06-17c8-5b75-b657-4b4e1555cf14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186402051} {:answer/id #uuid "c3f664b1-8db7-5e54-b116-e1469468f127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402052} {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402053}] :answer-field/correct {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402053} :answer-field/id #uuid "b453da57-6eef-5d7a-9c79-162c447ab3b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10430503-ea48-51a6-b4f8-6c1fb5c683b2" :question/math-academy-id "q-32569" :question/problem "Given that \n$A=[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302309 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2ebc4b-5389-54bf-a2fa-d9bfc4a8f26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300018} {:answer/id #uuid "2c9153f4-2e30-5c37-8b1e-09ae03d171c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300179} {:answer/id #uuid "432fa160-28fe-59c0-b329-f317a7313416" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186300293} {:answer/id #uuid "4acc2614-a841-5f02-8de0-c500389e0674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300346} {:answer/id #uuid "7907818c-57cc-5eaf-9979-1133fc70f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186300558}] :answer-field/correct {:answer/id #uuid "4acc2614-a841-5f02-8de0-c500389e0674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300346} :answer-field/id #uuid "174c33e3-c3b7-56d0-872e-43efb4f0dfa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "142d0252-9564-5605-b794-3e443fd3c338" :question/math-academy-id "q-32685" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-3{R}_{1},\\,{R}_{3}:={R}_{3}+3{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+3\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}^{-1}U \\\\ C & =([\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}])U \\\\ C & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302329 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2c73-b3f3-5f9e-bdca-1b5b280e8ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186299976} {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300075} {:answer/id #uuid "19c8433d-ce31-55b1-ace0-59e14900aabb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186300076} {:answer/id #uuid "7190b1cb-7787-5bdb-9600-71dbc81662e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300527} {:answer/id #uuid "c9f2b7f6-5083-5e02-a198-e7a6dbb7f6c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300969}] :answer-field/correct {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186300075} :answer-field/id #uuid "1a4a2fa1-bb43-517d-8181-7f72736b0a79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" :question/math-academy-id "q-32722" :question/problem "Given that\n$K=[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}]$\nhas the LU decomposition $K=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}^{-1}U \\\\ K & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}])U \\\\ K & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}]}
