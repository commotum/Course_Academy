      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274301/observations/step-q127153-849cfec2c5e7e3fdcb4d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14274301/observations/step-q127153-849cfec2c5e7e3fdcb4d.png",
