{\\sqrt{2}}{2} \\\\ 0 \\\\ 0\\end{bmatrix}$ \nand\n$\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}$" #edb/ref 17592186045443] [17592186356237 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186356237 #edb/ref 1083 #uuid "b2a5541d-7944-5a33-9a5b-efd6cfaa8758" #edb/ref 17592186045417] [17592186357249 #edb/ref 1075 #edb/ref 17592186355745 #edb/ref 17592186045417] [17592186357249 #edb/ref 1075 #edb/ref 17592186355869 #edb/ref 17592186045417] [17592186357249 #edb/ref 1075 #edb/ref 17592186356192 #edb/ref 17592186045417] [17592186357249 #edb/ref 1075 #edb/ref 17592186356205 #edb/ref 17592186045417] [17592186357249 #edb/ref 1075 #edb/ref 17592186356237 #edb/ref 17592186045417] [17592186357249 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357249 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357249 #edb/ref 1078 #edb/ref 17592186356205 #edb/ref 17592186045417] [17592186357249 #edb/ref 1079 #uuid "b7490596-2fa1-53bc-8ada-e942488fb1b8" #edb/ref 17592186045417] [17592186357273 #edb/ref 1075 #edb/ref 17592186355074 #edb/ref 17592186045417] [17592186357273 #edb/ref 1075 #edb/ref 17592186355082 #edb/ref 17592186045417] [17592186357273 #edb/ref 1075 #edb/ref 17592186355303 #edb/ref 17592186045417] [17592186357273 #edb/ref 1075 #edb/ref 17592186355528 #edb/ref 17592186045417] [17592186357273 #edb/ref 1075 #edb/ref 17592186356069 #edb/ref 17592186045417] [17592186357273 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186357273 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186357273 #edb/ref 1078 #edb/ref 17592186356069 #edb/ref 17592186045417] [17592186357273 #edb/ref 1079 #uuid "c5346222-44b8-5c0f-9c03-abcf827a4a5f" #edb/ref 17592186045417] [17592186363197 #edb/ref 1075 #edb/ref 17592186363198 #edb/ref 17592186045417] [17592186363197 #edb/ref 1075 #edb/ref 17592186363199 #edb/ref 17592186045417] [17592186363197 #edb/ref 1075 #edb/ref 17592186363200 #edb/ref 17592186045417] [17592186363197 #ed