      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14229404/observations/step-q94266-15fbbabe9356348a479f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14229404/observations/step-q94266-15fbbabe9356348a479f.png",
      "source_url": "https://mathacademy.com/tasks/14229404/topics/3119/review",
