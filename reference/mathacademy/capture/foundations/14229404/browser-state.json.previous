      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14229404/observations/step-q94302-527edb27bfab777014cf.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14229404/observations/step-q94302-527edb27bfab777014cf.png",
      "source_url": "https://mathacademy.com/tasks/14229404/topics/3119/review",
      "captured_at": 1792076260.419341,
