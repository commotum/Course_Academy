ext{i} & \\frac{(3-8\\text{i})(1-\\text{i})+12+4\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i}-4\\text{i} & \\frac{7-7\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-961a39a1-77cb-5489-8c6d-22b69afbac88"] :db/ensure [:question/validate]} {:db/id "answer-field-961a39a1-77cb-5489-8c6d-22b69afbac88" :answer-field/id #uuid "961a39a1-77cb-5489-8c6d-22b69afbac88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bcb0a500-cf0c-5985-b340-90eb8712b3cf" :answer-field/choices ["answer-9769bb50-848c-5920-82ba-87f7b67a494d" "answer-bcb0a500-cf0c-5985-b340-90eb8712b3cf" "answer-092aa0ee-669f-58ac-8093-1ecf670ae5a2" "answer-995ce79a-bb1e-52f4-bc46-4fc9d05b34f7" "answer-ccd5a9c5-86bd-5701-9d6c-7703094c6fee"] :db/ensure [:answer-field/validate]} {:db/id "answer-9769bb50-848c-5920-82ba-87f7b67a494d" :answer/id #uuid "9769bb50-848c-5920-82ba-87f7b67a494d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 2-\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bcb0a500-cf0c-5985-b340-90eb8712b3cf" :answer/id #uuid "bcb0a500-cf0c-5985-b340-90eb8712b3cf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-092aa0ee-669f-58ac-8093-1ecf670ae5a2" :answer/id #uuid "092aa0ee-669f-58ac-8093-1ecf670ae5a2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 2-\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-995ce79a-bb1e-52f4-bc46-4fc9d05b34f7" :answer/id #uuid "995ce79a-bb1e-52f4-bc46-4fc9d05b34f7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 4\\text{i}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ccd5a9c5-86bd-5701-9d6c-7703094c6fee" :answer/id #uuid "ccd5a9c5-86bd-5701-9d6c-7703094c6fee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186229186 :knowledge-point/questions ["question-3e3fe7c4-ab73-58d1-aefb-b68674cbd3b7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e3fe7c4-ab73-58d1-aefb-b68674cbd3b7" :question/id #uuid "3e3fe7c4-ab73-58d1-aefb-b68674cbd3b7" :question/math-academy-id "q-332553" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-y=-{x}^{2}+5x-5.\n$$\n\nFind the general solution to this equation given that the complementary solution is ${y}_{c}(x)=A{e}^{x},$ where $A$ is an arbitrary constant." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}-{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular integral is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta $, and $\\gamma $ are constants that are to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta .\n$$\n\nTo find the values of $\\alpha ,$ $\\beta ,$ and $\\gamma ,$  we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(2\\alpha x+\\beta )-(\\alpha {x}^{2}+\\beta x+\\gamma )=-{x}^{2}+5x-5\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n-\\alpha {x}^{2}+(2\\alpha -\\beta )x+(\\beta -\\gamma )=-{x}^{2}+5x-5\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-\\alpha =-1\\, & (\\text{equating the coefficients of}\\,\\,{x}^{2}) \\\\ 2\\alpha -\\beta =5\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ \\beta -\\gamma =-5\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =1,\\beta =-3,\\gamma =2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)={x}^{2}-3x+2.\n$$\n\nNow, since the general solution is given by\n\n$$\ny={y}_{c}+{y}_{p}\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{x}+{x}^{2}-3x+2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b2422140-a39d-5b08-9798-a757e48d525d"] :db/ensure [:question/validate]} {:db/id "answer-field-b2422140-a39d-5b08-9798-a757e48d525d" :answer-field/id #uuid "b2422140-a39d-5b08-9798-a757e48d525d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1973b29-842d-57e5-961d-6601b7418003" :answer-field/choices ["answer-c0da0d33-6e72-56ae-830b-3416c27f81d2" "answer-f1973b29-842d-57e5-961d-6601b7418003" "answer-d5dd231e-a392-5c29-813f-39a19f908ed9" "answer-dbbe6d33-ff39-5e5d-b9fb-6582734fde29" "answer-ad36ad0e-c801-5519-8cf3-dc430330868c"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0da0d33-6e72-56ae-830b-3416c27f81d2" :answer/id #uuid "c0da0d33-6e72-56ae-830b-3416c27f81d2" :answer/type :answer.type/math :answer/value "y=A{e}^{x}+2{x}^{2}-3x+2" :db/ensure [:answer/validate]} {:db/id "answer-f1973b29-842d-57e5-961d-6601b7418003" :answer/id #uuid "f1973b29-842d-57e5-961d-6601b7418003" :answer/type :answer.type/math :answer/value "y=A{e}^{x}+{x}^{2}-3x+2" :db/ensure [:answer/validate]} {:db/id "answer-d5dd231e-a392-5c29-813f-39a19f908ed9" :answer/id #uuid "d5dd231e-a392-5c29-813f-39a19f908ed9" :answer/type :answer.type/math :answer/value "y=A{e}^{x}+{x}^{2}-3x-2" :db/ensure [:answer/validate]} {:db/id "answer-dbbe6d33-ff39-5e5d-b9fb-6582734fde29" :answer/id #uuid "dbbe6d33-ff39-5e5d-b9fb-6582734fde29" :answer/type :answer.type/math :answer/value "y=A{e}^{x}+{x}^{2}-x+2" :db/ensure [:answer/validate]} {:db/id "answer-ad36ad0e-c801-5519-8cf3-dc430330868c" :answer/id #uuid "ad36ad0e-c801-5519-8cf3-dc430330868c" :answer/type :answer.type/math :answer/value "y=A{e}^{x}-{x}^{2}-3x+2" :db/ensure [:answer/validate]} {:db/id 17592186278186 :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}k(x+1),\\, & 2<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186162073 :knowledge-point/questions ["question-451b002c-8ebd-53f3-82f6-93d93d564dd9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-451b002c-8ebd-53f3-82f6-93d93d564dd9" :question/id #uuid "451b002c-8ebd-53f3-82f6-93d93d564dd9" :question/math-academy-id "q-110933" :question/problem "|  | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{9}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n\nCalculate $P(X=2,Y=2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the table, we have\n\n$$\nP(X=2,Y=2)=f(2,2)=\\frac{1}{6}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f6c7cc0f-00da-5a90-bc06-1408540bbde4"] :db/ensure [:question/validate]} {:db/id "answer-field-f6c7cc0f-00da-5a90-bc06-140854