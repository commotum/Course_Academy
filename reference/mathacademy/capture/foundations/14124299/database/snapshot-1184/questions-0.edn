#{[{:db/id #edb/ref 17592186240946 :knowledge-point/_questions [{:db/id #edb/ref 17592186172032 :knowledge-point/id #uuid "1fdf7e44-a092-5990-a10e-d48b175dcef0" :knowledge-point/title "Writing a Function Using Arrow Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d64d53-9b2f-57ba-ae66-00d361f41b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Z\\to Q" :db/id #edb/ref 17592186238697} {:answer/id #uuid "5b6b4e5c-e30d-5901-9e3c-d647641d6787" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Z\\to Z" :db/id #edb/ref 17592186238847} {:answer/id #uuid "94bd6867-a594-591a-a858-18374147272c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Q\\to Z" :db/id #edb/ref 17592186239341} {:answer/id #uuid "bd9a8619-9664-5f90-b823-edd28ae0a5f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Z\\to R" :db/id #edb/ref 17592186239710} {:answer/id #uuid "e0c5b799-4412-57c1-9c3e-9a1e5e7c754a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:R\\to Z" :db/id #edb/ref 17592186240026}] :answer-field/correct {:answer/id #uuid "49d64d53-9b2f-57ba-ae66-00d361f41b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "g:Z\\to Q" :db/id #edb/ref 17592186238697} :answer-field/id #uuid "a35606cb-5bb9-5ad1-9e6b-622ff9614d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240620}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a267466-27f9-5907-b5d3-8a64993c6282" :question/math-academy-id "q-104845" :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n*\"The function $g$ maps the set of integers to the set of rational numbers.\"*" :question/worked-solution "The sentence *\"The function $g$ maps the set of integers to the set of rational numbers\"* is equivalent to the following symbolic notation:\n\n$\\,$ $g:Z\\to Q$\n\nHere, the domain of $g$ is $Z,$ and the codomain of $g$ is $Q.$"}] [{:db/id #edb/ref 17592186266018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1348b18e-cd6f-5470-aeb7-1dc2e503b959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186263182} {:answer/id #uuid "297d61f2-cb88-51f7-9997-9c3505aaf0ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186263356} {:answer/id #uuid "34f81a52-240d-5419-9297-dc3d4103363f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186263467} {:answer/id #uuid "bef4cc09-e4db-597f-b29c-001a00b4a13b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186264663} {:answer/id #uuid "c7bb2965-8cad-5bfe-b224-742a706d54b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186264746}] :answer-field/correct {:answer/id #uuid "34f81a52-240d-5419-9297-dc3d4103363f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186263467} :answer-field/id #uuid "37f3949b-96c0-5579-a5af-c7efac7bcd67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7dfd4e6-f98f-5d70-9672-fbeae076cac0" :question/math-academy-id "q-130948" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $2$ pivots in the $2$nd and $3$rd columns:\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $1$st column."}] [{:db/id #edb/ref 17592186054999 :knowledge-point/_questions [{:db/id #edb/ref 17592186054696 :knowledge-point/id #uuid "6eea26e0-2a9c-5d4c-91d3-12e7682e1858" :knowledge-point/title "Inverting a Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e1af38-633a-57f4-9e71-85d2947b0d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186410549} {:answer/id #uuid "6811f6df-390d-51f5-bc0f-d96e7d661c36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186410553} {:answer/id #uuid "92867a08-d171-5092-9bb8-8df51b376ab3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410554} {:answer/id #uuid "92dcfb35-90d5-5cef-b823-e951de3a78ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410555} {:answer/id #uuid "edc9528f-0241-5970-b67a-4394965cb7d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & \\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410558}] :answer-field/correct {:answer/id #uuid "6811f6df-390d-51f5-bc0f-d96e7d661c36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186410553} :answer-field/id #uuid "58e6ab5e-8906-5de2-9159-242df4d0797a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410559}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c20e2d6b-ec12-50bd-afe4-b9325272aef2" :question/math-academy-id "q-135354" :question/problem "Find the inverse of the following matrix: \n\n$$\nA=[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]\n$$" :question/worked-solution "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{[\\begin{aligned}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{aligned}]\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]}^{-1}=[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186278186 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23104f3a-32df-5eb8-b625-6064a0927bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186275790} {:answer/id #uuid "4782f702-6fe4-5d9d-ac7f-0cbf1d5585b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186276109} {:answer/id #uuid "c4d9a75e-ef16-53b2-91a4-a58f25730b94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277227} {:answer/id #uuid "d69f8bf4-08dd-5e99-b4bd-7e77b6e86109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186277368} {:answer/id #uuid "fded7981-ac59-53d8-a59e-57b524b6aaff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277705}] :answer-field/correct {:answer/id #uuid "23104f3a-32df-5eb8-b625-6064a0927bc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186275790} :answer-field/id #uuid "b52cd5b8-493f-5839-b0c1-450922ded456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278044}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c628a4a3-1d03-5b7a-9d8c-d548c59d8196" :question/math-academy-id "q-158442" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}k(x+1),\\, & 2<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{2}^{3}k(x+1)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}k(x+1)\\,\\text{d}x & =k{[\\frac{{x}^{2}}{2}+x]}_{2}^{3} \\\\  & =k([\\frac{9}{2}+3]-[\\frac{4}{2}+2]) \\\\  & =k(\\frac{9}{2}-1) \\\\  & =\\frac{7}{2}k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{7}{2}k=1\\,⟹\\,k=\\frac{2}{7}.\n$$"}] [{:db/id #edb/ref 17592186364112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119782 :knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75cb1d88-be8f-565a-8892-48a303e64be2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 2 & 0 & -1 \\\\ 3 & 0 & 0 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 11 & 0 & -9 & 0\\end{aligned}|" :db/id #edb/ref 17592186364114} {:answer/id #uuid "e8e4de03-83b4-5eb7-85e7-5082d3d5faf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & -8 & 0 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 0 & -1 & 6 & -4 \\\\ 11 & 3 & -9 & 0\\end{aligned}|" :db/id #edb/ref 17592186364115} {:answer/id #uuid "18a26160-0ecc-5cb6-a8e9-2502d70ef054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & -8 & 2 & 0 \\\\ 3 & 5 & 0 & 0 \\\\ 4 & 0 & 3 & 8 \\\\ 11 & 3 & 0 & -9\\end{aligned}|" :db/id #edb/ref 17592186364116} {:answer/id #uuid "14b9fa6f-497e-5ef2-9a76-8cd1a476c61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186364117} {:answer/id #uuid "192fe4e1-90f7-57bb-9824-063dbac2dd60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186364118}] :answer-field/correct {:answer/id #uuid "14b9fa6f-497e-5ef2-9a76-8cd1a476c61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186364117} :answer-field/id #uuid "c3453afe-00bf-5199-ac64-1a8b6d15168a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e657c376-dc40-5550-9d65-c80b82ab3edb" :question/math-academy-id "q-36048" :question/problem "Find the cofactor of ${d}_{34}$ in \n$D=[\\begin{aligned}0 & -8 & 2 & 0 & -1 \\\\ 3 & 5 & 0 & 0 & 1 \\\\ 0 & -1 & -5 & 6 & -4 \\\\ 4 & 0 & 3 & 8 & 3 \\\\ 11 & 3 & 0 & -9 & 0\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${d}_{34}$, we remove the $3$rd row and $4$th column: \n\n$$\nD=[\\begin{aligned}0 & -8 & 2 & ∗ & -1 \\\\ 3 & 5 & 0 & ∗ & 1 \\\\ ∗ & ∗ & ∗ & 6 & ∗ \\\\ 4 & 0 & 3 & ∗ & 3 \\\\ 11 & 3 & 0 & ∗ & 0\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|.\n$$\n\nNow, the cofactor of ${d}_{34}$ is\n\n$$\n\\begin{aligned}{C}_{34} & =(-1)^{3+4}{M}_{34} \\\\  & =-{M}_{34} \\\\  & =-|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$"}]}
