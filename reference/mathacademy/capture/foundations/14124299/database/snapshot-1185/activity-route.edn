#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186423161} :activity/id #uuid "3f4f41c2-27bf-5159-a8f6-6570e14a207b" :activity/steps [{:db/id #edb/ref 17592186423161 :step/content {:db/id #edb/ref 17592186266018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1348b18e-cd6f-5470-aeb7-1dc2e503b959" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186263182} {:answer/id #uuid "297d61f2-cb88-51f7-9997-9c3505aaf0ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186263356} {:answer/id #uuid "34f81a52-240d-5419-9297-dc3d4103363f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$st only" :db/id #edb/ref 17592186263467} {:answer/id #uuid "bef4cc09-e4db-597f-b29c-001a00b4a13b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$nd only" :db/id #edb/ref 17592186264663} {:answer/id #uuid "c7bb2965-8cad-5bfe-b224-742a706d54b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$rd only" :db/id #edb/ref 17592186264746}] :answer-field/correct {:db/id #edb/ref 17592186263467} :answer-field/id #uuid "37f3949b-96c0-5579-a5af-c7efac7bcd67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265346}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7dfd4e6-f98f-5d70-9672-fbeae076cac0" :question/math-academy-id "q-130948" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $2$ pivots in the $2$nd and $3$rd columns:\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $1$st column."} :step/id #uuid "0a6d729b-6546-5988-a8b2-ff1c871c9b65" :step/next {:db/id #edb/ref 17592186423165}} {:db/id #edb/ref 17592186423162 :step/content {:db/id #edb/ref 17592186278186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23104f3a-32df-5eb8-b625-6064a0927bc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186275790} {:answer/id #uuid "4782f702-6fe4-5d9d-ac7f-0cbf1d5585b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186276109} {:answer/id #uuid "c4d9a75e-ef16-53b2-91a4-a58f25730b94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186277227} {:answer/id #uuid "d69f8bf4-08dd-5e99-b4bd-7e77b6e86109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186277368} {:answer/id #uuid "fded7981-ac59-53d8-a59e-57b524b6aaff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186277705}] :answer-field/correct {:db/id #edb/ref 17592186275790} :answer-field/id #uuid "b52cd5b8-493f-5839-b0c1-450922ded456" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278044}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c628a4a3-1d03-5b7a-9d8c-d548c59d8196" :question/math-academy-id "q-158442" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}k(x+1),\\, & 2<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{2}^{3}k(x+1)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}k(x+1)\\,\\text{d}x & =k{[\\frac{{x}^{2}}{2}+x]}_{2}^{3} \\\\  & =k([\\frac{9}{2}+3]-[\\frac{4}{2}+2]) \\\\  & =k(\\frac{9}{2}-1) \\\\  & =\\frac{7}{2}k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{7}{2}k=1\\,⟹\\,k=\\frac{2}{7}.\n$$"} :step/id #uuid "19aea924-7038-5a67-94c0-4f850121cff5" :step/next {:db/id #edb/ref 17592186423166}} {:db/id #edb/ref 17592186423163 :step/content {:db/id #edb/ref 17592186364112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75cb1d88-be8f-565a-8892-48a303e64be2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|\\begin{aligned}0 & 2 & 0 & -1 \\\\ 3 & 0 & 0 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 11 & 0 & -9 & 0\\end{aligned}|" :db/id #edb/ref 17592186364114} {:answer/id #uuid "e8e4de03-83b4-5eb7-85e7-5082d3d5faf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-|\\begin{aligned}0 & -8 & 0 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 0 & -1 & 6 & -4 \\\\ 11 & 3 & -9 & 0\\end{aligned}|" :db/id #edb/ref 17592186364115} {:answer/id #uuid "18a26160-0ecc-5cb6-a8e9-2502d70ef054" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|\\begin{aligned}0 & -8 & 2 & 0 \\\\ 3 & 5 & 0 & 0 \\\\ 4 & 0 & 3 & 8 \\\\ 11 & 3 & 0 & -9\\end{aligned}|" :db/id #edb/ref 17592186364116} {:answer/id #uuid "14b9fa6f-497e-5ef2-9a76-8cd1a476c61b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186364117} {:answer/id #uuid "192fe4e1-90f7-57bb-9824-063dbac2dd60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186364118}] :answer-field/correct {:db/id #edb/ref 17592186364117} :answer-field/id #uuid "c3453afe-00bf-5199-ac64-1a8b6d15168a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186364113}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e657c376-dc40-5550-9d65-c80b82ab3edb" :question/math-academy-id "q-36048" :question/problem "Find the cofactor of ${d}_{34}$ in \n$D=[\\begin{aligned}0 & -8 & 2 & 0 & -1 \\\\ 3 & 5 & 0 & 0 & 1 \\\\ 0 & -1 & -5 & 6 & -4 \\\\ 4 & 0 & 3 & 8 & 3 \\\\ 11 & 3 & 0 & -9 & 0\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${d}_{34}$, we remove the $3$rd row and $4$th column: \n\n$$\nD=[\\begin{aligned}0 & -8 & 2 & ∗ & -1 \\\\ 3 & 5 & 0 & ∗ & 1 \\\\ ∗ & ∗ & ∗ & 6 & ∗ \\\\ 4 & 0 & 3 & ∗ & 3 \\\\ 11 & 3 & 0 & ∗ & 0\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|.\n$$\n\nNow, the cofactor of ${d}_{34}$ is\n\n$$\n\\begin{aligned}{C}_{34} & =(-1)^{3+4}{M}_{34} \\\\  & =-{M}_{34} \\\\  & =-|\\begin{aligned}0 & -8 & 2 & -1 \\\\ 3 & 5 & 0 & 1 \\\\ 4 & 0 & 3 & 3 \\\\ 11 & 3 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$"} :step/id #uuid "5a85ef5f-8a7a-54b2-94f2-56cba543e4af" :step/next {:db/id #edb/ref 17592186423164}} {:db/id #edb/ref 17592186423164 :step/content {:db/id #edb/ref 17592186423158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad36ad0e-c801-5519-8cf3-dc430330868c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}-{x}^{2}-3x+2" :db/id #edb/ref 17592186423144} {:answer/id #uuid "c0da0d33-6e72-56ae-830b-3416c27f81d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+2{x}^{2}-3x+2" :db/id #edb/ref 17592186423147} {:answer/id #uuid "d5dd231e-a392-5c29-813f-39a19f908ed9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+{x}^{2}-3x-2" :db/id #edb/ref 17592186423149} {:answer/id #uuid "dbbe6d33-ff39-5e5d-b9fb-6582734fde29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+{x}^{2}-x+2" :db/id #edb/ref 17592186423150} {:answer/id #uuid "f1973b29-842d-57e5-961d-6601b7418003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{x}+{x}^{2}-3x+2" :db/id #edb/ref 17592186423152}] :answer-field/correct {:db/id #edb/ref 17592186423152} :answer-field/id #uuid "b2422140-a39d-5b08-9798-a757e48d525d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423155}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3e3fe7c4-ab73-58d1-aefb-b68674cbd3b7" :question/math-academy-id "q-332553" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-y=-{x}^{2}+5x-5.\n$$\n\nFind the general solution to this equation given that the complementary solution is ${y}_{c}(x)=A{e}^{x},$ where $A$ is an arbitrary constant." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}-{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular integral is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta $, and $\\gamma $ are constants that are to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta .\n$$\n\nTo find the values of $\\alpha ,$ $\\beta ,$ and $\\gamma ,$  we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(2\\alpha x+\\beta )-(\\alpha {x}^{2}+\\beta x+\\gamma )=-{x}^{2}+5x-5\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n-\\alpha {x}^{2}+(2\\alpha -\\beta )x+(\\beta -\\gamma )=-{x}^{2}+5x-5\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-\\alpha =-1\\, & (\\text{equating the coefficients of}\\,\\,{x}^{2}) \\\\ 2\\alpha -\\beta =5\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ \\beta -\\gamma =-5\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =1,\\beta =-3,\\gamma =2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)={x}^{2}-3x+2.\n$$\n\nNow, since the general solution is given by\n\n$$\ny={y}_{c}+{y}_{p}\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{x}+{x}^{2}-3x+2.\n$$"} :step/id #uuid "acf66a31-ee63-5797-9c15-6d48c11ac821" :step/next {:db/id #edb/ref 17592186423167}} {:db/id #edb/ref 17592186423165 :step/content {:db/id #edb/ref 17592186423157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e5c1f6-5233-50a9-a0c7-3d8454d96058" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+5y+2z-49=0" :db/id #edb/ref 17592186423137} {:answer/id #uuid "44b25bde-c138-5e61-9bfe-10c541da03de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x-4y-2z-53=0" :db/id #edb/ref 17592186423138} {:answer/id #uuid "8a9aa20e-7044-5fe9-999a-ca209eb00faf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x+4y+2z-36=0" :db/id #edb/ref 17592186423140} {:answer/id #uuid "b722b988-b76f-5900-8ce4-497e838c929c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-5y-2z-17=0" :db/id #edb/ref 17592186423145} {:answer/id #uuid "dd9f7bca-6210-53d4-939e-d73b38d6642a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5x+4y-2z-57=0" :db/id #edb/ref 17592186423151}] :answer-field/correct {:db/id #edb/ref 17592186423151} :answer-field/id #uuid "ab781c91-252d-5387-b0ba-ee29d18b5ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423154}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a383fb4-f81d-5536-bfab-907adbefb459" :question/math-academy-id "q-128372" :question/problem "Find a Cartesian equation of the plane that passes through the point $P(7,4,-3)$ and is perpendicular to the line \n$\\frac{x-3}{5}=\\frac{y-2}{4}=\\frac{z+1}{-2}.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨7,4,-3⟩.$ From the canonical equation, we find that the line is parallel to the vector $⟨5,4,-2⟩.$ So, the normal vector of the plane is \n\n$$\nn=⟨5,4,-2⟩.\n$$\n\nUsing the dot product, we can find the equation of the plane as follows:\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨5,4,-2⟩ & =⟨7,4,-3⟩\\cdot ⟨5,4,-2⟩ \\\\ r\\cdot ⟨5,4,-2⟩ & =57\\end{aligned}\n$$\n\nNow, to obtain the Cartesian equation of the plane, we substitute $r=⟨x,y,z⟩$ into the equation above and get\n\n$$\n\\begin{aligned}⟨x,y,z⟩\\cdot ⟨5,4,-2⟩ & =57 \\\\ 5x+4y-2z & =57 \\\\ 5x+4y-2z-57 & =0.\\end{aligned}\n$$"} :step/id #uuid "b5447a0d-9c15-5a9a-95c3-217c896bfd8a" :step/next {:db/id #edb/ref 17592186423168}} {:db/id #edb/ref 17592186423166 :step/content {:db/id #edb/ref 17592186423159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ed6ec1-1769-59ad-91d0-d048d5c22646" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186423133} {:answer/id #uuid "1e0d3e9f-9d0c-5981-8395-27bd84ff21c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186423135} {:answer/id #uuid "2eb2713a-b498-549e-8640-12a432b25ec2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186423136} {:answer/id #uuid "5dcbf8a2-b213-5973-9620-f9bf34863eef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186423139} {:answer/id #uuid "9b7e82c5-6bbd-5457-961a-5ee0677981a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186423143}] :answer-field/correct {:db/id #edb/ref 17592186423139} :answer-field/id #uuid "f6c7cc0f-00da-5a90-bc06-1408540bbde4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423156}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "451b002c-8ebd-53f3-82f6-93d93d564dd9" :question/math-academy-id "q-110933" :question/problem "|  | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{6}$ | $\\frac{1}{3}$ |\n| $X=2$ | $\\frac{1}{9}$ | $\\frac{1}{6}$ |\n| $X=3$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n\nCalculate $P(X=2,Y=2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the table, we have\n\n$$\nP(X=2,Y=2)=f(2,2)=\\frac{1}{6}.\n$$"} :step/id #uuid "b60bd261-e970-557c-a9a0-348d0de15d38"} {:db/id #edb/ref 17592186423167 :step/content {:db/id #edb/ref 17592186240946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d64d53-9b2f-57ba-ae66-00d361f41b61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g:Z\\to Q" :db/id #edb/ref 17592186238697} {:answer/id #uuid "5b6b4e5c-e30d-5901-9e3c-d647641d6787" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g:Z\\to Z" :db/id #edb/ref 17592186238847} {:answer/id #uuid "94bd6867-a594-591a-a858-18374147272c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g:Q\\to Z" :db/id #edb/ref 17592186239341} {:answer/id #uuid "bd9a8619-9664-5f90-b823-edd28ae0a5f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g:Z\\to R" :db/id #edb/ref 17592186239710} {:answer/id #uuid "e0c5b799-4412-57c1-9c3e-9a1e5e7c754a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g:R\\to Z" :db/id #edb/ref 17592186240026}] :answer-field/correct {:db/id #edb/ref 17592186238697} :answer-field/id #uuid "a35606cb-5bb9-5ad1-9e6b-622ff9614d62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240620}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5a267466-27f9-5907-b5d3-8a64993c6282" :question/math-academy-id "q-104845" :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n*\"The function $g$ maps the set of integers to the set of rational numbers.\"*" :question/worked-solution "The sentence *\"The function $g$ maps the set of integers to the set of rational numbers\"* is equivalent to the following symbolic notation:\n\n$\\,$ $g:Z\\to Q$\n\nHere, the domain of $g$ is $Z,$ and the codomain of $g$ is $Q.$"} :step/id #uuid "cc8438f1-408f-5295-ade1-275a125268e0" :step/next {:db/id #edb/ref 17592186423162}} {:db/id #edb/ref 17592186423168 :step/content {:db/id #edb/ref 17592186423160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092aa0ee-669f-58ac-8093-1ecf670ae5a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 2-\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186423134} {:answer/id #uuid "9769bb50-848c-5920-82ba-87f7b67a494d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 2-\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186423141} {:answer/id #uuid "995ce79a-bb1e-52f4-bc46-4fc9d05b34f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 4\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186423142} {:answer/id #uuid "bcb0a500-cf0c-5985-b340-90eb8712b3cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186423146} {:answer/id #uuid "ccd5a9c5-86bd-5701-9d6c-7703094c6fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 1 & 7\\end{aligned}]" :db/id #edb/ref 17592186423148}] :answer-field/correct {:db/id #edb/ref 17592186423146} :answer-field/id #uuid "961a39a1-77cb-5489-8c6d-22b69afbac88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186423153}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a9bbaed4-c824-539a-9b36-056d32d45438" :question/math-academy-id "q-140382" :question/problem "Given the matrix $A=[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i} & 3-8\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+(-\\frac{4\\text{i}}{1-\\text{i}}){R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i} & 3-8\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{4\\text{i}}{1-\\text{i}}){R}_{1} \\\\  & ∼[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i}+(-\\frac{4\\text{i}(1-\\text{i})}{1-\\text{i}}) & 3-8\\text{i}+(-\\frac{4\\text{i}(-1+3\\text{i})}{1-\\text{i}})\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i}-4\\text{i} & \\frac{(3-8\\text{i})(1-\\text{i})+12+4\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 4\\text{i}-4\\text{i} & \\frac{7-7\\text{i}}{1-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1-\\text{i} & -1+3\\text{i} \\\\ 0 & 7\\end{aligned}].\n$$"} :step/id #uuid "cd6fad27-b96d-559e-9673-f4f8fcfde3c8" :step/next {:db/id #edb/ref 17592186423169}} {:db/id #edb/ref 17592186423169 :step/content {:db/id #edb/ref 17592186054999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e1af38-633a-57f4-9e71-85d2947b0d28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186410549} {:answer/id #uuid "6811f6df-390d-51f5-bc0f-d96e7d661c36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186410553} {:answer/id #uuid "92867a08-d171-5092-9bb8-8df51b376ab3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410554} {:answer/id #uuid "92dcfb35-90d5-5cef-b823-e951de3a78ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410555} {:answer/id #uuid "edc9528f-0241-5970-b67a-4394965cb7d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & \\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -\\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186410558}] :answer-field/correct {:db/id #edb/ref 17592186410553} :answer-field/id #uuid "58e6ab5e-8906-5de2-9159-242df4d0797a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410559}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c20e2d6b-ec12-50bd-afe4-b9325272aef2" :question/math-academy-id "q-135354" :question/problem "Find the inverse of the following matrix: \n\n$$\nA=[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]\n$$" :question/worked-solution "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{[\\begin{aligned}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{aligned}]\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={[\\begin{aligned}\\frac{1}{3} & 0 & 0 & 0 \\\\ 0 & -\\frac{1}{5} & 0 & 0 \\\\ 0 & 0 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & \\frac{1}{4}\\end{aligned}]}^{-1}=[\\begin{aligned}3 & 0 & 0 & 0 \\\\ 0 & -5 & 0 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 4\\end{aligned}].\n$$"} :step/id #uuid "d373ae1d-7cca-5251-9938-2a16fb3c3dd1" :step/next {:db/id #edb/ref 17592186423163}}] :activity/title "Quiz 3" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186423132}]}
