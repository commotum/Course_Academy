      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228741/observations/step-q125706-180e3113a6e953068566.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228741/observations/step-q125706-180e3113a6e953068566.png",
