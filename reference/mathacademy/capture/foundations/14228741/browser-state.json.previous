      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228741/observations/step-q125497-340762c39dc0af9cef9b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228741/observations/step-q125497-340762c39dc0af9cef9b.png",
      "source_url": "https://mathacademy.com/tasks/14228741/topics/3694/review",
      "captured_at": 1792068534.5666592,
      "math_academy_id": "q-125497",
      "topic_id": "3694",
      "sequence_position": null,
