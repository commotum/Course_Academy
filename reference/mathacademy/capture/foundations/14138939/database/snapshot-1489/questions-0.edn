2186436497} :answer-field/id #uuid "1c1b91bd-c02a-54c1-9144-7cdad3e92265" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e42534d-d33e-5203-bcb9-d3b1ae0266de" :question/math-academy-id "q-73643" :question/problem "Find the inverse of the elementary matrix \n$Q=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}].$" :question/worked-solution "We write down $Q$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[Q\\,|\\,I\\,] & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 2 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{Q}^{-1}=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186436531 :knowledge-point/_questions [{:db/id #edb/ref 17592186115245 :knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd0fc74-bae7-5ca6-8b3d-6e3dc367d94c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 6 & 25\\end{aligned}]" :db/id #edb/ref 17592186436476} {:answer/id #uuid "154c032f-809a-5efc-89c5-4f1d4dd4d1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}25 & 4 \\\\ 6 & 1\\end{aligned}]" :db/id #edb/ref 17592186436479} {:answer/id #uuid "226082c9-2e79-5379-b639-80b5394d6a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 2\\end{aligned}]" :db/id #edb/ref 17592186436480} {:answer/id #uuid "d335ae16-8497-5078-b422-95a4ecd43940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186436512} {:answer/id #uuid "f8657687-c509-5554-80a8-e863a3769213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 25\\end{aligned}]" :db/id #edb/ref 17592186436516}] :answer-field/correct {:answer/id #uuid "f8657687-c509-5554-80a8-e863a3769213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 25\\end{aligned}]" :db/id #edb/ref 17592186436516} :answer-field/id #uuid "3a5a16fb-2a91-54b4-a37d-03216a65fec6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf425079-a50e-5390-afb0-f23f208d7e4f" :question/math-academy-id "q-73648" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 6 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -4 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 4 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{1}^{-1} & =[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}1 & 6 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 6 \\\\ 4 & 25\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186342049 :knowledge-point/_questions [{:db/id #edb/ref 17592186115245 :knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83492424-920b-57cd-af61-ba623f57ae3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186340309} {:answer/id #uuid "a427d688-565d-53d1-b8fd-e30111538319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186340617} {:answer/id #uuid "a85df999-36e6-5904-90aa-ef8fb7e9f7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 0 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186340657} {:answer/id #uuid "ca7fd710-5ec3-5eb4-8da8-2bcceb41a777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186340921} {:answer/id #uuid "f7492f13-1197-54f9-9aa1-0d629e866114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 3 & -4\\end{aligned}]" :db/id #edb/ref 17592186341315}] :answer-field/correct {:answer/id #uuid "f7492f13-1197-54f9-9aa1-0d629e866114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 3 & -4\\end{aligned}]" :db/id #edb/ref 17592186341315} :answer-field/id #uuid "dfa3d820-5e84-505b-89c4-ef77e5bd5391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd46d64d-aaae-5435-b750-329b869c363c" :question/math-academy-id "q-73651" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & -\\frac{1}{4}\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -\\frac{1}{4} & 0 & 1\\end{aligned}] &  & {R}_{2}:=(-4){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =[\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 3 & -4\\end{aligned}]\n$$"}]}
