c93cf1c7-72f6-55fa-af18-5a9af1c96229" "answer-67551fa0-1107-5e9c-8dd4-07e24766c9ef" "answer-03632a2d-f2ff-5829-baea-8d2ea743e840" "answer-faf7db38-64d7-5ea9-97e3-0a1a7e7038d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-d03b30de-8afc-5054-b722-b112b8c0b486" :answer/id #uuid "d03b30de-8afc-5054-b722-b112b8c0b486" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -5 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c93cf1c7-72f6-55fa-af18-5a9af1c96229" :answer/id #uuid "c93cf1c7-72f6-55fa-af18-5a9af1c96229" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-67551fa0-1107-5e9c-8dd4-07e24766c9ef" :answer/id #uuid "67551fa0-1107-5e9c-8dd4-07e24766c9ef" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-03632a2d-f2ff-5829-baea-8d2ea743e840" :answer/id #uuid "03632a2d-f2ff-5829-baea-8d2ea743e840" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-faf7db38-64d7-5ea9-97e3-0a1a7e7038d9" :answer/id #uuid "faf7db38-64d7-5ea9-97e3-0a1a7e7038d9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 5 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-682600e4-1f6c-58ba-ae45-caa8f795950e" :question/id #uuid "682600e4-1f6c-58ba-ae45-caa8f795950e" :question/math-academy-id "q-130800" :question/problem "Find the inverse of the elementary matrix \n$W=[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{6}\\end{aligned}].$" :question/worked-solution "We write down $V$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[W\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & \\frac{1}{6} & 0 & 1\\end{aligned}] &  & {R}_{2}:=6{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 6\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{W}^{-1}=[\\begin{aligned}1 & 0 \\\\ 0 & 6\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-57d2ad5f-fd97-5e2d-883f-36f12c7f88c8"] :db/ensure [:question/validate]} {:db/id "answer-field-57d2ad5f-fd97-5e2d-883f-36f12c7f88c8" :answer-field/id #uuid "57d2ad5f-fd97-5e2d-883f-36f12c7f88c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b54b601-afa4-54fb-9b81-8e1a343fbbd9" :answer-field/choices ["answer-74fbade3-24cf-5469-a14c-c1b53476a0da" "answer-3b54b601-afa4-54fb-9b81-8e1a343fbbd9" "answer-afe75d39-2b1f-5943-9262-25e98dd52004" "answer-a943f519-fb72-5834-9e86-9b373dc13537" "answer-722609aa-a0d5-5e3b-9591-7ee5f0d9b3af"] :db/ensure [:answer-field/validate]} {:db/id "answer-74fbade3-24cf-5469-a14c-c1b53476a0da" :answer/id #uuid "74fbade3-24cf-5469-a14c-c1b53476a0da" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3b54b601-afa4-54fb-9b81-8e1a343fbbd9" :answer/id #uuid "3b54b601-afa4-54fb-9b81-8e1a343fbbd9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-afe75d39-2b1f-5943-9262-25e98dd52004" :answer/id #uuid "afe75d39-2b1f-5943-9262-25e98dd52004" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 1 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a943f519-fb72-5834-9e86-9b373dc13537" :answer/id #uuid "a943f519-fb72-5834-9e86-9b373dc13537" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 1 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-722609aa-a0d5-5e3b-9591-7ee5f0d9b3af" :answer/id #uuid "722609aa-a0d5-5e3b-9591-7ee5f0d9b3af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186115842 :question/problem "Find the inverse of the elementary matrix \n$A=[\\begin{aligned}1 & 0 \\\\ -7 & 1\\end{aligned}].$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -7 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 7 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 0 \\\\ 7 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186113989 :answer-field/correct "answer-bcd5f231-30de-5f93-92ba-901fd84afa6a" :answer-field/choices ["answer-34da3084-a21c-5f11-a32e-01588ddf5fab" "answer-e5167b06-7c0b-5f26-8c68-4d6d734b259b" "answer-c7c585a9-2f07-5403-bcb1-dabce9f67e3a" "answer-bcd5f231-30de-5f93-92ba-901fd84afa6a" "answer-bba143df-3184-57ce-bc93-47ed7a3522c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-34da3084-a21c-5f11-a32e-01588ddf5fab" :answer/id #uuid "34da3084-a21c-5f11-a32e-01588ddf5fab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -7 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-e5167b06-7c0b-5f26-8c68-4d6d734b259b" :answer/id #uuid "e5167b06-7c0b-5f26-8c68-4d6d734b259b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ -7 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c7c585a9-2f07-5403-bcb1-dabce9f67e3a" :answer/id #uuid "c7c585a9-2f07-5403-bcb1-dabce9f67e3a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bcd5f231-30de-5f93-92ba-901fd84afa6a" :answer/id #uuid "bcd5f231-30de-5f93-92ba-901fd84afa6a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 7 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bba143df-3184-57ce-bc93-47ed7a3522c9" :answer/id #uuid "bba143df-3184-57ce-bc93-47ed7a3522c9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-cf425079-a50e-5390-afb0-f23f208d7e4f" :question/id #uuid "cf425079-a50e-5390-afb0-f23f208d7e4f" :question/math-academy-id "q-73648" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 6 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -4 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 4 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{1}^{-1} & =[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}1 & 6 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 6 \\\\ 4 & 25\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3a5a16fb-2a91-54b4-a37d-03216a65fec6"] :db/ensure [:question/validate]} {:db/id "answer-field-3a5a16fb-2a91-54b4-a37d-03216a65fec6" :answer-field/id #uuid "3a5a16fb-2a91-54b4-a37d-03216a65fec6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8657687-c509-5554-80a8-e863a3769213" :answer-field/choices ["answer-0dd0fc74-bae7-5ca6-8b3d-6e3dc367d94c" "answer-f8657687-c509-5554-80a8-e863a3769213" "answer-226082c9-2e79-5379-b639-80b5394d6a03" "answer-d335ae16-8497-5078-b422-95a4ecd43940" "answer-154c032f-809a-5efc-89c5-4f1d4dd4d1e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-0dd0fc74-bae7-5ca6-8b3d-6e3dc367d94c" :answer/id #uuid "0dd0fc74-bae7-5ca6-8b3d-6e3dc367d94c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 \\\\ 6 & 25\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f8657687-c509-5554-80a8-e863a3769213" :answer/id #uuid "f8657687-c509-5554-80a8-e863a3769213" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 25\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-226082c9-2e79-5379-b639-80b5394d6a03" :answer/id #uuid "226082c9-2e79-5379-b639-80b5394d6a03" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d335ae16-8497-5078-b422-95a4ecd43940" :answer/id #uuid "d335ae16-8497-5078-b422-95a4ecd43940" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 6 \\\\ 4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-154c032f-809a-5efc-89c5-4f1d4dd4d1e3" :answer/id #uuid "154c032f-809a-5efc-89c5-4f1d4dd4d1e3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}25 & 4 \\\\ 6 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186115735 :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 3 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & 4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}]=[\\begin{aligned}-11 & 4 \\\\ -3 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186113376 :answer-field/correct "answer-9bfc713a-679b-5cfa-9d6f-08a36b86fb51" :answer-field/choices ["answer-e25a7759-8c03-50b5-a54a-8024f5ffd9a8" "answer-9bfc713a-679b-5cfa-9d6f-08a36b86fb51" "answer-a8f73949-1a41-5465-a743-a686174de006" "answer-c0bb3be0-28be-55c7-a77b-ae02e4febeba" "answer-a74234e5-d97b-566c-bed3-339abfaef5b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-e25a7759-8c03-50b5-a54a-8024f5ffd9a8" :answer/id #uuid "e25a7759-8c03-50b5-a54a-8024f5ffd9a8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-11 & -3 \\\\ 4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9bfc713a-679b-5cfa-9d6f-08a36b86fb51" :answer/id #uuid "9bfc713a-679b-5cfa-9d6f-08a36b86fb51" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-11 & 4 \\\\ -3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a8f73949-1a41-5465-a743-a686174de006" :answer/id #uuid "a8f73949-1a41-5465-a743-a686174de006" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-11 & 4 \\\\ 1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c0bb3be0-28be-55c7-a77b-ae02e4febeba" :answer/id #uuid "c0bb3be0-28be-55c7-a77b-ae02e4febeba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 \\\\ -3 & -11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a74234e5-d97b-566c-bed3-339abfaef5b1" :answer/id #uuid "a74234e5-d97b-566c-bed3-339abfaef5b1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 4 \\\\ -11 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-c2f3128b-e14c-5d17-b8ee-71ffa4c47e70" :question/id #uuid "c2f3128b-e14c-5d17-b8ee-71ffa4c47e70" :question/math-academy-id "q-130825" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =[\\begin{aligned}1 & -1 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a181bc03-12d6-5f9e-af68-66c71236d0b4"] :db/ensure [:question/validate]} {:db/id "answer-field-a181bc03-12d6-5f9e-af68-66c71236d0b4" :answer-field/id #uuid "a181bc03-12d6-5f9e-af68-66c71236d0b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d99ac86-82e5-5e0a-9493-269c69c2ba02" :answer-field/choices ["answer-2eb70ba9-1167-5fc0-a5c7-cfac02437eab" "answer-8d99ac86-82e5-5e0a-9493-269c69c2ba02" "answer-111040c6-f52f-5fe4-8365-864262986013" "answer-bcbeb476-106e-56ab-bc8d-5ea75f68ee56" "answer-f3f4c4eb-37ab-559c-af8f-9eacddcde995"] :db/ensure [:answer-field/validate]} {:db/id "answer-2eb70ba9-1167-5fc0-a5c7-cfac02437eab" :answer/id #uuid "2eb70ba9-1167-5fc0-a5c7-cfac02437eab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8d99ac86-82e5-5e0a-9493-269c69c2ba02" :answer/id #uuid "8d99ac86-82e5-5e0a-9493-269c69c2ba02" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-111040c6-f52f-5fe4-8365-864262986013" :answer/id #uuid "111040c6-f52f-5fe4-8365-864262986013" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bcbeb476-106e-56ab-bc8d-5ea75f68ee56" :answer/id #uuid "bcbeb476-106e-56ab-bc8d-5ea75f68ee56" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f3f4c4eb-37ab-559c-af8f-9eacddcde995" :answer/id #uuid "f3f4c4eb-37ab-559c-af8f-9eacddcde995" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186116495 :tutorial/content "An **elementary matrix** is a matrix that can be obtained from the identity matrix by applying *only one* elementary row operation.\n\nFor example, starting with the $2 \\times 2$ identity matrix ![](images/09/09dfa5716dbd500a4684f62a5c409a392761e7546c7ac5e4b592133623552506.svg) we can apply a single elementary row operation to get any of the matrices below:\n\n![](images/44/44bf82527f952ba4d01bbc16f0b81a47fe9e82f447a996f75bccef5171d92242.svg)\n\n- $E_1$ is obtained from $I_2$ by applying the row operation $R_1 \\leftrightarrow R_2.$\n\n- $E_2$ is obtained from $I_2$ by applying the row operation $R_1:=2R_1.$\n\n- $E_3$ is obtained from $I_2$ by applying the row operation $R_2 := R_2 + (-7)R_1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186116496 :tutorial/content "Each elementary matrix $E$ is invertible, and the corresponding inverse is always an elementary matrix of the same type as $E$.\nTo illustrate, let's consider the matrix \n\n![](images/01/0144b651cc6eff46265156e1491f58aacfc167da6dce571dbf4a92c9d94e7177.svg)\nTo find the inverse of $E,$ we proceed as follows:\n\n**Step 1:** Write down $\\color{blue}E$ and the identity matrix $I_2$ side-by-side, as shown below:\n![](images/fb/fbb291c4f2d7ccc79939cf9368579b07f6649709f123fb70a1383deefaec6fc1.svg)\n\n**Step 2:** Apply an elementary row operation that transforms the left matrix into the identity matrix. In our case, we need to apply the transformation $R_2 := R_2 + (-4)R_1.$ We apply the operation to the entire row (not only the left part):\n\n$$\n\\begin{aligned}[E\\,|\\,{I}_{2}] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -4 & 1\\end{aligned}] \\\\  & =[{I}_{2}\\,|\\,{E}^{-1}]\\end{aligned}\n$$\n\nThe matrix $E^{-1}$ is obtained on the right-hand side of our big matrix after the transformation. Therefore,\n![](images/1e/1e71a52dda452f98fa77c01117f40d055fa0661100a0e4ffc25147d9baefc0af.svg)\n\nWe can work out the inverse of all elementary $2 \\times 2$ matrices in a similar way." :db/ensure [:tutorial/validate]} {:db/id 17592186115472 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}]
