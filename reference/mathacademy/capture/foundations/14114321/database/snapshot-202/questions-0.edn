#{[{:db/id #edb/ref 17592186406739 :knowledge-point/_questions [{:db/id #edb/ref 17592186124658 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3ab956-770c-53a8-9eae-f40c61e6c769" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406733} {:answer/id #uuid "3ecb645c-1e57-5c3b-b1b2-ed0e71e55fd5" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406734} {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406735} {:answer/id #uuid "ebb132bf-25ae-5df7-92f2-c8b762f82e71" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406736} {:answer/id #uuid "f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406737}] :answer-field/correct {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406735} :answer-field/id #uuid "c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186406738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/math-academy-id "q-164515" :question/problem "Identify the surface $\\frac{{y}^{2}}{5}=\\frac{{x}^{2}}{2}+\\frac{{z}^{2}}{2}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $y$-axis and $b=\\sqrt{5},\\,a=c=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186284516 :knowledge-point/_questions [{:db/id #edb/ref 17592186124658 :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232f26c9-79a9-5402-b0f7-63e58ec7851c" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282006} {:answer/id #uuid "7c568ec1-5072-5178-846a-7f2b606d9954" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A couple of planes" :db/id #edb/ref 17592186282767} {:answer/id #uuid "9283fa33-e3d9-51e6-a60b-d84331b8323d" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282958} {:answer/id #uuid "ce57cf6e-a823-5536-bf65-94a57901af34" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283498} {:answer/id #uuid "eefd41c3-ba1b-5b3d-8bc1-3c2122e2528a" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283778}] :answer-field/correct {:answer/id #uuid "232f26c9-79a9-5402-b0f7-63e58ec7851c" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282006} :answer-field/id #uuid "05d7e5ed-5266-504a-b7eb-960c915d96ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe349944-268d-5340-92ca-d28764061da5" :question/math-academy-id "q-164548" :question/problem "Identify the following surface:\n\n$$\n{z}^{2}=-12y,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{z}^{2}=4py.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=-3.$"}] [{:db/id #edb/ref 17592186284517 :knowledge-point/_questions [{:db/id #edb/ref 17592186124603 :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cde161-28f6-55e5-986b-ad9855da614a" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,2,3)$" :db/id #edb/ref 17592186281850} {:answer/id #uuid "122b7f1a-d06c-5752-b881-d3aaf0a1f656" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-2,3)$" :db/id #edb/ref 17592186281869} {:answer/id #uuid "49873a52-1e06-5d10-9048-c31a56b3f6fa" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,-3)$" :db/id #edb/ref 17592186282319} {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283463} {:answer/id #uuid "d9275452-1c1f-54aa-9f44-b0b79feef1b1" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283586}] :answer-field/correct {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283463} :answer-field/id #uuid "fd434c9b-d384-57dd-8332-85e7b5ec2000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b66372b-0da7-5bff-8ad5-ecdf16f5fac5" :question/math-academy-id "q-164549" :question/problem "Identify the surface ${y}^{2}-{z}^{2}-x-4y-6z-4=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2}-x-4y-6z-4 & =0 \\\\ ({y}^{2}-4y)-({z}^{2}+6z)-x-4 & =0 \\\\ (y-2)^{2}-4-(z+3)^{2}+9-x-4 & =0 \\\\ (y-2)^{2}-(z+3)^{2}+1-x & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(y-2)^{2}-(z+3)^{2}+1-x & =0 \\\\ (y-2)^{2}-(z+3)^{2} & =x-1\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-3).$"}]}
