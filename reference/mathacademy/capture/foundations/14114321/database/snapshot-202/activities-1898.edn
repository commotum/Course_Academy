#{[{:activity/first-step {:db/id #edb/ref 17592186125654} :activity/id #uuid "128c541d-1422-5228-a02e-c5d080886a64" :activity/scope {:db/id #edb/ref 17592186050011 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186125542 :step/content {:db/id #edb/ref 17592186124603 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124415 :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313"} :knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/questions [{:db/id #edb/ref 17592186124839} {:db/id #edb/ref 17592186124953} {:db/id #edb/ref 17592186284517} {:db/id #edb/ref 17592186284518} {:db/id #edb/ref 17592186323760} {:db/id #edb/ref 17592186323761} {:db/id #edb/ref 17592186323847} {:db/id #edb/ref 17592186381354} {:db/id #edb/ref 17592186401550} {:db/id #edb/ref 17592186401557} {:db/id #edb/ref 17592186402494}] :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"} :step/id #uuid "c326de48-b43d-56d2-9c9e-007c179f58ec" :step/math-academy-id 31030} {:db/id #edb/ref 17592186125647 :step/content {:db/id #edb/ref 17592186124657 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124220 :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559"} :knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048516} {:db/id #edb/ref 17592186048533} {:db/id #edb/ref 17592186049483} {:db/id #edb/ref 17592186050129} {:db/id #edb/ref 17592186050462}] :knowledge-point/questions [{:db/id #edb/ref 17592186124835} {:db/id #edb/ref 17592186124836} {:db/id #edb/ref 17592186284500} {:db/id #edb/ref 17592186284501} {:db/id #edb/ref 17592186284502} {:db/id #edb/ref 17592186372327} {:db/id #edb/ref 17592186381333} {:db/id #edb/ref 17592186401487} {:db/id #edb/ref 17592186401508} {:db/id #edb/ref 17592186401515} {:db/id #edb/ref 17592186401522} {:db/id #edb/ref 17592186401529}] :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"} :step/id #uuid "c5b55480-9dcd-56e9-acf7-87ada2ec2005" :step/math-academy-id 45294 :step/next {:db/id #edb/ref 17592186125649}} {:db/id #edb/ref 17592186125648 :step/content {:db/id #edb/ref 17592186125889 :tutorial/content "A table showing the most common cylinders whose base curve is centered at the origin in the $xy$-plane is given below.\n\n| Surface | Equation | Image |\n| --- | --- | --- |\n| Elliptic Cylinder | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} = 1$ | ![](images/2b/2b8788f027b93593a025542face33546425b057d1eb3b8e18da26e7774f6ed20.png) |\n| Parabolic Cylinder | $x^2=4py$<br><br>$y^2=4px$ | ![](images/d3/d3f31aae01222e6a63e5de185c5b9f5a8af5aed8a750c6bc230e20e9fd93871a.png) |\n| Hyperbolic Cylinder | $\\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}=1$<br><br>$\\dfrac{y^2}{b^2}-\\dfrac{x^2}{a^2}=1$ | ![](images/15/159bb67600e079d9943ba6f79fcc6e580e3718f822dce50620c2bb6d2d9b76c8.png) |\n\nSimilar to quadric surfaces:\n\n- We can generate cylinders with alternative orientation axes by describing a base curve in the $xz$-or $yz$-planes.\n\nFor example, the equation of an elliptic cylinder with its axis of symmetry along the $y$-axis is given by $$\\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2} = 1.$$\n- We can shift the center/vertex of the base curve in the usual way." :tutorial/id #uuid "41c3acb2-b2af-59b4-a6bb-3883e59406f4" :tutorial/math-academy-id 7843 :tutorial/title "A Table of Common Cylinders"} :step/id #uuid "b00e77f6-434b-5bca-9612-5405fa8cbcd1" :step/math-academy-id 45296 :step/next {:db/id #edb/ref 17592186125647}} {:db/id #edb/ref 17592186125649 :step/content {:db/id #edb/ref 17592186124658 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124221 :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560"} :knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/questions [{:db/id #edb/ref 17592186124837} {:db/id #edb/ref 17592186124838} {:db/id #edb/ref 17592186284503} {:db/id #edb/ref 17592186284504} {:db/id #edb/ref 17592186284506} {:db/id #edb/ref 17592186284507} {:db/id #edb/ref 17592186284508} {:db/id #edb/ref 17592186284515} {:db/id #edb/ref 17592186284516} {:db/id #edb/ref 17592186381340} {:db/id #edb/ref 17592186381347} {:db/id #edb/ref 17592186401536} {:db/id #edb/ref 17592186406739}] :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"} :step/id #uuid "45bf287e-52f8-5fe1-a4fe-73b8c92a2ec7" :step/math-academy-id 45300 :step/next {:db/id #edb/ref 17592186125542}} {:db/id #edb/ref 17592186125654 :step/content {:db/id #edb/ref 17592186125894 :tutorial/content "The most common quadric surfaces are those centered at the origin. We describe these common surfaces in the table below.\n\n| Surface | Equation | Image |\n| --- | --- | --- |\n| Ellipsoid | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}+\\dfrac{z^2}{c^2} = 1$ | ![](images/09/09dc100248a28a5518bcd8428368edefc7c3ee8d5ef0e50515cb7552ee54a376.png) |\n| Elliptic Paraboloid | $z = \\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}$ | ![](images/76/76e4ad8cb1e83eadae4dce865e100c9a716f9830e7f12adb367b2a9b74d1a651.png) |\n| Hyperbolic Paraboloid | $z = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}$ | ![](images/cb/cbc04d7f98e1bb7ce0d62eda71102a6abad708dfcedd7aabee8fff23281471dd.png) |\n| Hyperboloid of One Sheet | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}-\\dfrac{z^2}{c^2}=1$ | ![](images/df/df6ef914bc78e121d75baf9f5147784d0e6e434d76800eff60dcb3c3d764477c.png) |\n| Hyperboloid of Two Sheets | $\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}-\\dfrac{z^2}{c^2}=-1$ | ![](images/08/0870b95c5ce1133d6645e3063174157e36c4354df370c05e48218111ea714838.png) |\n| Elliptic Cone | $\\dfrac{z^2}{c^2}=\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}$ | ![](images/0f/0f492bf07e573ec7858977e48fa4bf81635e61520b5caa9edef14bd259184347.png) |\n\nAlso, recall the following from previous lessons:\n\n- We can generate paraboloids, hyperboloids, and cones with alternative orientation axes by permuting the variables in the corresponding equation.\n\nFor example, the equation of an elliptic cone with its vertex at $O$ and axis of symmetry along the $y$-axis is given by $$\\dfrac{y^2}{b^2} = \\dfrac{x^2}{a^2} + \\dfrac{z^2}{c^2}.$$\n- We can shift the center/vertex/saddle point of a quadric surface to $(x_0,y_0,z_0)$ using the usual coordinate transformation: $$(x,y,z) \\longrightarrow (x-x_0,y-y_0,z-z_0)$$\n\nFinally, there is a simple way to distinguish between hyperboloids with one and two sheets by simply looking at the equations:\n\n- *one* minus sign indicates hyperboloids of *one* sheet: $$\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}=1$$\n- *two* minus signs indicate hyperboloids of *two* sheets: $$\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}= \\bbox[3pt,Gainsboro]{\\color{red}-}1$$" :tutorial/id #uuid "e806c3d0-0e3e-584e-93eb-1406ac607ad3" :tutorial/math-academy-id 7860 :tutorial/title "Introduction"} :step/id #uuid "7440cca3-653a-5d59-a5d4-2b047f4c7357" :step/math-academy-id 45333 :step/next {:db/id #edb/ref 17592186125648}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124706}] [{:activity/course {:db/id #edb/ref 17592186046665} :activity/first-step {:db/id #edb/ref 17592186406742} :activity/id #uuid "75844770-2009-58f0-837f-3b53539c54cc" :activity/scope {:db/id #edb/ref 17592186050011 :topic/id #uuid "25b1fb2e-aa54-5955-88cd-263118f65faa" :topic/math-academy-id 1898} :activity/steps [{:db/id #edb/ref 17592186406740 :step/content {:db/id #edb/ref 17592186284516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232f26c9-79a9-5402-b0f7-63e58ec7851c" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282006} {:answer/id #uuid "7c568ec1-5072-5178-846a-7f2b606d9954" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A couple of planes" :db/id #edb/ref 17592186282767} {:answer/id #uuid "9283fa33-e3d9-51e6-a60b-d84331b8323d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186282958} {:answer/id #uuid "ce57cf6e-a823-5536-bf65-94a57901af34" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283498} {:answer/id #uuid "eefd41c3-ba1b-5b3d-8bc1-3c2122e2528a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186283778}] :answer-field/correct {:db/id #edb/ref 17592186282006} :answer-field/id #uuid "05d7e5ed-5266-504a-b7eb-960c915d96ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283949}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe349944-268d-5340-92ca-d28764061da5" :question/math-academy-id "q-164548" :question/problem "Identify the following surface:\n\n$$\n{z}^{2}=-12y,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{z}^{2}=4py.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=-3.$"} :step/id #uuid "51825ebc-a150-59a7-947c-57e352dcf16a" :step/next {:db/id #edb/ref 17592186406741}} {:db/id #edb/ref 17592186406741 :step/content {:db/id #edb/ref 17592186284517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10cde161-28f6-55e5-986b-ad9855da614a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbolic paraboloid centered at $(-1,2,3)$" :db/id #edb/ref 17592186281850} {:answer/id #uuid "122b7f1a-d06c-5752-b881-d3aaf0a1f656" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbolic paraboloid centered at $(1,-2,3)$" :db/id #edb/ref 17592186281869} {:answer/id #uuid "49873a52-1e06-5d10-9048-c31a56b3f6fa" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An ellipsoid centered at $(1,2,-3)$" :db/id #edb/ref 17592186282319} {:answer/id #uuid "ca420948-0b66-53de-bd82-72e7dc4965ff" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283463} {:answer/id #uuid "d9275452-1c1f-54aa-9f44-b0b79feef1b1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186283586}] :answer-field/correct {:db/id #edb/ref 17592186283463} :answer-field/id #uuid "fd434c9b-d384-57dd-8332-85e7b5ec2000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284388}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1b66372b-0da7-5bff-8ad5-ecdf16f5fac5" :question/math-academy-id "q-164549" :question/problem "Identify the surface ${y}^{2}-{z}^{2}-x-4y-6z-4=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2}-x-4y-6z-4 & =0 \\\\ ({y}^{2}-4y)-({z}^{2}+6z)-x-4 & =0 \\\\ (y-2)^{2}-4-(z+3)^{2}+9-x-4 & =0 \\\\ (y-2)^{2}-(z+3)^{2}+1-x & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(y-2)^{2}-(z+3)^{2}+1-x & =0 \\\\ (y-2)^{2}-(z+3)^{2} & =x-1\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-3).$"} :step/id #uuid "665f3a47-aeb6-5a7d-a9e0-03a57d44f9e3"} {:db/id #edb/ref 17592186406742 :step/content {:db/id #edb/ref 17592186406739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3ab956-770c-53a8-9eae-f40c61e6c769" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406733} {:answer/id #uuid "3ecb645c-1e57-5c3b-b1b2-ed0e71e55fd5" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186406734} {:answer/id #uuid "e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406735} {:answer/id #uuid "ebb132bf-25ae-5df7-92f2-c8b762f82e71" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406736} {:answer/id #uuid "f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186406737}] :answer-field/correct {:db/id #edb/ref 17592186406735} :answer-field/id #uuid "c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/math-academy-id "q-164515" :question/problem "Identify the surface $\\frac{{y}^{2}}{5}=\\frac{{x}^{2}}{2}+\\frac{{z}^{2}}{2}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $y$-axis and $b=\\sqrt{5},\\,a=c=\\sqrt{2}.$"} :step/id #uuid "ab2c596e-de3a-5f30-b94c-c0be5480593a" :step/next {:db/id #edb/ref 17592186406740}}] :activity/title "Identifying Quadric Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406732}]}
