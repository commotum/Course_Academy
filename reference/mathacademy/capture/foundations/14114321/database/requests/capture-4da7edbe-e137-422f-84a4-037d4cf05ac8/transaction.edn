[{:db/id 17592186124658 :knowledge-point/questions ["question-b09b4d78-7ddd-5094-835d-967fc1cbc732"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/id #uuid "b09b4d78-7ddd-5094-835d-967fc1cbc732" :question/math-academy-id "q-164515" :question/problem "Identify the surface $\\frac{{y}^{2}}{5}=\\frac{{x}^{2}}{2}+\\frac{{z}^{2}}{2}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $y$-axis and $b=\\sqrt{5},\\,a=c=\\sqrt{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c5993f8a-2816-578b-805e-be93a0d45e93"] :db/ensure [:question/validate]} {:db/id "answer-field-c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/id #uuid "c5993f8a-2816-578b-805e-be93a0d45e93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e04fe96a-a5e5-509f-b5fc-299d30d29c7c" :answer-field/choices ["answer-f356ea58-4f17-52df-9c6d-71add425ebf1" "answer-2c3ab956-770c-53a8-9eae-f40c61e6c769" "answer-e04fe96a-a5e5-509f-b5fc-299d30d29c7c" "answer-3ecb645c-1e57-5c3b-b1b2-ed0e71e55fd5" "answer-ebb132bf-25ae-5df7-92f2-c8b762f82e71"] :db/ensure [:answer-field/validate]} {:db/id "answer-f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/id #uuid "f356ea58-4f17-52df-9c6d-71add425ebf1" :answer/type :answer.type/text :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/ensure [:answer/validate]} {:db/id "answer-2c3ab956-770c-53a8-9eae-f40c61e6c769" :answer/id #uuid "2c3ab956-770c-53a8-9eae-f40c61e6c769