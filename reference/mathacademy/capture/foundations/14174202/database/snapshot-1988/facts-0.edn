b/ref 17592186097574 #edb/ref 17592186045417] [17592186096904 #edb/ref 1043 #edb/ref 17592186097633 #edb/ref 17592186045417] [17592186096904 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186096904 #edb/ref 1045 "Calculating Intercepts of Parabolas" #edb/ref 17592186045417] [17592186096904 #edb/ref 1046 #edb/ref 17592186097633 #edb/ref 17592186045417] [17592186096904 #edb/ref 1049 #edb/ref 17592186048350 #edb/ref 17592186045417] [17592186096904 #edb/ref 1050 720.0 #edb/ref 17592186045417] [17592186096904 #edb/ref 1050 720.0 #edb/ref 17592186045436] [17592186096904 #edb/ref 1053 #uuid "f97acdea-187e-5327-a13f-1e14931b5e5f" #edb/ref 17592186045417] [17592186097571 #edb/ref 1058 #edb/ref 17592186097572 #edb/ref 17592186045417] [17592186097571 #edb/ref 1061 19720 #edb/ref 17592186045417] [17592186097571 #edb/ref 1062 #uuid "47e80884-1762-5551-9161-e2231dbed002" #edb/ref 17592186045417] [17592186097571 #edb/ref 1063 #edb/ref 17592186097855 #edb/ref 17592186045417] [17592186097572 #edb/ref 1058 #edb/ref 17592186097574 #edb/ref 17592186045417] [17592186097572 #edb/ref 1061 19721 #edb/ref 17592186045417] [17592186097572 #edb/ref 1062 #uuid "fd6bd854-7c41-5db8-95d8-5be58a99e006" #edb/ref 17592186045417] [17592186097572 #edb/ref 1063 #edb/ref 17592186096706 #edb/ref 17592186045417] [17592186097573 #edb/ref 1058 #edb/ref 17592186097571 #edb/ref 17592186045417] [17592186097573 #edb/ref 1061 19724 #edb/ref 17592186045417] [17592186097573 #edb/ref 1062 #uuid "003b2c9e-f558-5f16-ae29-70cb592bdea5" #edb/ref 17592186045417] [17592186097573 #edb/ref 1063 #edb/ref 17592186096707 #edb/ref 17592186045417] [17592186097574 #edb/ref 1061 19725 #edb/ref 17592186045417] [17592186097574 #edb/ref 1062 #uuid "82273a54-9ebb-549c-bc34-a98726936b3c" #edb/ref 17592186045417] [17592186097574 #edb/ref 1063 #edb/ref 17592186096708 #edb/ref 17592186045417] [17592186097633 #edb/ref 1058 #edb/ref 17592186097573 #edb/ref 17592186045417] [17592186097633 #edb/ref 1061 23091 #edb/ref 17592186045417] [17592186097633 #edb/ref 1062 #uuid "3eccc6e2-615b-5126-b1a2-9f9bb514c40d" #edb/ref 17592186045417] [17592186097633 #edb/ref 1063 #edb/ref 17592186097868 #edb/ref 17592186045417] [17592186097855 #edb/ref 1064 "Suppose we want to know what are the $x$-intercepts of the parabola below.\n\n![](images/5d/5d3493115eb11315849d3d7c247b9f63a399c6ab7ba2c226b0b84958a47d3a21.png)\n\nThen, we proceed as follows: \n\nFirst, we find the equation of the parabola. From the diagram, we see that the parabola has its vertex at $\\displaystyle\\left(\\frac 32, -1\\right)$ and passes through the point $\\displaystyle\\left(1,-\\frac 34\\right).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nSubstituting $(h,k) = \\left(\\dfrac 32, -1\\right)$ into the above gives\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $\\displaystyle\\left(1,-\\frac 34\\right),$ we substitute $x= 1$ and $y=-\\dfrac34$ into the equation and get\n\n$$\n\\begin{aligned}{(1-\\frac{3}{2})}^{2} & =4p(-\\frac{3}{4}+1) \\\\ \\frac{1}{4} & =4p(\\frac{1}{4}) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y= 0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x{:}$\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2} & =(0+1) \\\\ {(x-\\frac{3}{2})}^{2} & =1 \\\\ x-\\frac{3}{2} & =\\pm 1 \\\\ x & =\\frac{3}{2}\\pm 1\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $\\dfrac12$ and $\\dfrac52.$" #edb/ref 17592186045417] [17592186097855 #edb/ref 1065 3484 #edb/ref 17592186045417] [17592186097855 #edb/ref 1066 #uuid "04c720cc-0a5d-5a6c-acf5-65c378ef274b" #edb/ref 17592186045417] [17592186097855 #edb/ref 1067 "Calculating the Intercepts of a Parabola Given a Graph of the Parabola" #edb/ref 17592186045417] [17592186097868 #edb/ref 1064 "Let's consider the parabola $(x-1)^2 = \\dfrac 1 2 (y+3) ,$ shown below.\n\n![](images/bb/bbe360c9580cab435e5b737c80c5381f039d1871250cdae3c16bc686e3d0a53d.png)\n\n  \n\nTo calculate the $y$-intercept of the parabola (shown as the point $A$ in the diagram), we set $x=0$ and solve for $y.$ In our case, this gives\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (0-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (-1)^{2} & =\\frac{1}{2}(y+3) \\\\ 1 & =\\frac{1}{2}(y+3) \\\\ 2 & =y+3 \\\\ y & =2-3 \\\\ y & =-1.\\end{aligned}\n$$\n\nSo the coordinates of the $y$-intercept are $(0,-1).$\n\nOn the other hand, to find the $x$-intercepts (shown as the points $B$ and $C$ in the diagram), we set $y=0$ and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2} & =\\frac{1}{2}(y+3) \\\\ (x-1)^{2} & =\\frac{1}{2}(0+3) \\\\ (x-1)^{2} & =\\frac{3}{2} \\\\ x-1 & =\\pm \\sqrt{\\frac{3}{2}} \\\\ x & =1\\pm \\sqrt{\\frac{3}{2}}.\\end{aligned}\n$$\n\nSo, the coordinates of $B$ are $\\left(1-\\sqrt{\\dfrac{3}{2}},0\\right)$ and the coordinates of $C$ are $\\left(1+\\sqrt{\\dfrac{3}{2}},0\\right).$" #edb/ref 17592186045417] [17592186097868 #edb/ref 1065 3905 #edb/ref 17592186045417] [17592186097868 #edb/ref 1066 #uuid "f9511803-ede3-5b03-b34f-87d1bb050901" #edb/ref 17592186045417] [17592186097868 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186441399 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186441399 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441399 #edb/ref 1083 #uuid "3326bfbc-602b-5b97-a232-910eb4540d34" #edb/ref 17592186045417] [17592186441414 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186441414 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186441414 #edb/ref 1083 #uuid "c1fd71a3-f959-5632-b94a-c770e9c6d2a3" #edb/ref 17592186045417] [17592186441425 #edb/ref 1075 #edb/ref 17592186441399 #edb/ref 17592186045417] [17592186441425 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186441425 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186441425 #edb/ref 1078 #edb/ref 17592186441399 #edb/ref 17592186045417] [17592186441425 #edb/ref 1079 #uuid "78edd9c5-7539-5d54-8eb1-437fb325e3d3" #edb/ref 17592186045417] [17592186441428 #edb/ref 1075 #edb/ref 17592186441414 #edb/ref 17592186045417] [17592186441428 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186441428 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186441428 #edb/ref 1078 #edb/ref 17592186441414 #edb/ref 17592186045417] [17592186441428 #edb/ref 1079 #uuid "91e3b777-9db3-51a5-ab92-8bddd54cd065" #edb/ref 17592186045417] [17592186441439 #edb/ref 1068 #edb/ref 17592186441425 #edb/ref 17592186045417] [17592186441439 #edb/ref 1068 #edb/ref 17592186441428 #edb/ref 17592186045417] [17592186441439 #edb/ref 1069 "q-251826" #edb/ref 17592186045417] [17592186441439 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186441439 #edb/ref 1071 "![](images/0e/0e95f9087b5b607f2d33d49c0f5db123eede589e53adc94747f3a33c1fe68f90.png)\n\n**From top to bottom**, the **exact** values of the $y$-intercepts of the parabola shown above are{{field-1}}\nand \n{{field-2}}." #edb/ref 17592186045417] [17592186441439 #edb/ref 1072 #uuid "a25c3b40-7f3b-57d8-a341-b7f66aac34c1" #edb/ref 17592186045417] [17592186441439 #edb/ref 1074 "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-8,-1)$ and passes through the point $(-6,1).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(-8,-1)$ into the above gives\n\n$$\n(y+1)^{2}=4p(x+8).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,1),$ we substitute $x=-6$ and $y=1$ into the equation and get\n\n$$\n\\begin{aligned}(1+1)^{2} & =4p(-6+8) \\\\ 4 & =4p(2) \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+1)^{2} & =2(x+8).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y+1)^{2} & =2(0+8) \\\\ (y+1)^{2} & =16 \\\\ y+1 & =\\pm \\sqrt{16} \\\\ y & =\\pm 4-1 \\\\ y & =-5,3\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are $3$ and  $-5.$" #edb/ref 17592186045417] [17592186492207 #edb/ref 1043 #edb/ref 17592186492971 #edb/ref 17592186045417] [17592186492207 #edb/ref 1043 #edb/ref 17592186492979 #edb/ref 17592186045417] [17592186492207 #edb/ref 1043 #edb/ref 17592186492993 #edb/ref 17592186045417] [17592186492207 #edb/ref 1043 #edb/ref 17592186493003 #edb/ref 17592186045417] [17592186492207 #edb/ref 1043 #edb/ref 17592186493005 #edb/ref 17592186045417] [17592186492207 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186492207 #edb/ref 1045 "Calculating Intercepts of Parabolas" #edb/ref 17592186045417] [17592186492207 #edb/ref 1046 #edb/ref 17592186493003 #edb/ref 17592186045417] [17592186492207 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186492207 #edb/ref 1049 #edb/ref 17592186048350 #edb/ref 17592186045417] [17592186492207 #edb/ref 1053 #uuid "3866c2aa-e5f1-566e-84b6-7cace07a50a6" #edb/ref 17592186045417] [17592186492237 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186492237 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186492237 #edb/ref 1083 #uuid "0d6f31a7-12c7-533a-a616-32df997a304f" #edb/ref 17592186045417] [17592186492259 #edb/ref 1080 "-1+\\sqrt{6}" #edb/ref 17592186045417] [17592186492259 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186492259 #edb/ref 1083 #uuid "168bd404-2959-5371-bc5c-7fbba3473aa1" #edb/ref 17592186045417] [17592186492273 #edb/ref 1080 "5" #edb/ref 1759