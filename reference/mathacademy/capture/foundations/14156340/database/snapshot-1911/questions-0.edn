4e8060b0797b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451967} {:answer/id #uuid "e6eb60f2-98a4-5b24-a94e-92f9324e2a78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451968}] :answer-field/correct {:answer/id #uuid "e6eb60f2-98a4-5b24-a94e-92f9324e2a78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451968} :answer-field/id #uuid "3bfdc7e3-3ad3-5cba-9513-6068b167a525" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32515201-cdee-5802-875e-aaeaf04119b1" :question/math-academy-id "q-94625" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $B={[\\begin{aligned}0 & a \\\\ 1-a & 0\\end{aligned}]\\,|\\,a\\in R}.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is closed under matrix addition\n- **II.** $B$ is closed under scalar multiplication\n- **III.** $B$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $B$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if ${A}_{1}={A}_{2}=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]+[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $A=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$ and $k=2,$ then \n\n$$\n\\begin{aligned}kA & =2[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is a *not* subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186360467 :knowledge-point/_questions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb2d723d-c8b0-5e00-b156-69d0e470f0ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452001} {:answer/id #uuid "5b1f3a41-57bb-56b5-b700-a05f59bcdb05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452002}] :answer-field/correct {:answer/id #uuid "bb2d723d-c8b0-5e00-b156-69d0e470f0ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452001} :answer-field/id #uuid "eaed178b-0ca9-53db-93f2-6c3fe7166a1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452848} {:answer-field/choices [{:answer/id #uuid "02d54602-5430-531a-a7c5-47d26991c196" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452003} {:answer/id #uuid "99d476b2-00d2-510e-ab51-4d3a23898225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452004}] :answer-field/correct {:answer/id #uuid "02d54602-5430-531a-a7c5-47d26991c196" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452003} :answer-field/id #uuid "aeee6e44-1273-539a-b514-732ed6cf2323" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452849} {:answer-field/choices [{:answer/id #uuid "63d370e5-07ba-54c6-84b2-d2152f843127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452005} {:answer/id #uuid "3b739ff6-ecb6-5572-a58c-6817071a785d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452006}] :answer-field/correct {:answer/id #uuid "63d370e5-07ba-54c6-84b2-d2152f843127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452005} :answer-field/id #uuid "dd8599eb-5b6c-5f72-9e7f-4c37a37b62cd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452850} {:answer-field/choices [{:answer/id #uuid "aca4493b-8547-5286-83fb-deaf509091f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452007} {:answer/id #uuid "a167ab0d-34f6-5000-8bef-7f7a8ae3ed10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452008}] :answer-field/correct {:answer/id #uuid "a167ab0d-34f6-5000-8bef-7f7a8ae3ed10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452008} :answer-field/id #uuid "1aa85b89-bf70-5661-b433-3d5ffe0aa95a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452851}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0f62d508-5cf6-5993-b139-949d11db546e" :question/math-academy-id "q-94635" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $C$ containing all polynomials of degree exactly $3.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $C$ is closed under function addition\n- **II.** $C$ is closed under scalar multiplication\n- **III.** $C$ is a subspace of $C[0,1]$\n- **IV.** $C$ is **not** a subspace of $C[0,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(x)={x}^{3}$ and $g(x)=1-{x}^{3},$ then\n\n$$\n\\begin{aligned}f(x)+g(x) & ={x}^{3}+(1-{x}^{3}) \\\\  & =({x}^{3}-{x}^{3})+1 \\\\  & =1.\\end{aligned}\n$$\n\nSo, $C$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(x)={x}^{3}$ and $k=0,$ then\n\n$$\nkf(x)=0\\cdot {x}^{3}=0.\n$$\n\n \nSo, $C$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $C$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}]}
