9 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453230} {:answer/id #uuid "a85494a0-51a8-59e6-96b9-be4532a22c50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453231}] :answer-field/correct {:answer/id #uuid "73efe5e7-86d9-56bf-883f-fdf28547d599" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453230} :answer-field/id #uuid "a819ffc8-0ac7-5428-aa18-b902a7881f2c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454365} {:answer-field/choices [{:answer/id #uuid "94acce7b-7200-5224-a551-0f52dea34c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453232} {:answer/id #uuid "5cef8fe4-d2dc-5067-8776-abd7c9ca57d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453233}] :answer-field/correct {:answer/id #uuid "5cef8fe4-d2dc-5067-8776-abd7c9ca57d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453233} :answer-field/id #uuid "88425d2a-b4ad-54eb-89a3-3a3b986d9505" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454366}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ecd1a414-f091-5cfd-86f0-d0c82f6d9564" :question/math-academy-id "q-107147" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $K$ containing all nonconstant functions.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $K$ is closed under function addition\n- **II.** $K$ is closed under scalar multiplication\n- **III.** $K$ is a subspace of $C[0,1]$\n- **IV.** $K$ is **not** a subspace of $C[0,1]$\n\n*Hint: $f$ is a constant function if $f(x)=\\text{constant}$ for all $x\\in [0,1].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, the functions $f(x)=x+2$ and $f(x)=-x-1$ are in $K$, however\n\n$$\n(f+g)(x)=1\n$$\n\nfor all $x\\in [0,1]$ and hence $f+g$ is a constant function. \nSo, $K$ is *not* closed under addition.\n\n- Statement II is false. For example, the product of the scalar zero by any function is the constant function zero. So, $K$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $K$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186329724 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38cb7c6e-48d5-5719-9bc4-f341096b9869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450666} {:answer/id #uuid "acf32b73-2582-59f7-b014-ea9ea8e2b727" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450667}] :answer-field/correct {:answer/id #uuid "acf32b73-2582-59f7-b014-ea9ea8e2b727" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450667} :answer-field/id #uuid "deb7b878-00d8-573f-9c0a-f510c2c287a1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451287} {:answer-field/choices [{:answer/id #uuid "9e105135-fd28-5ebd-a7a8-7fa54306d756" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450668} {:answer/id #uuid "45355d1b-48c6-519a-96e3-bbc8d43f590d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450669}] :answer-field/correct {:answer/id #uuid "45355d1b-48c6-519a-96e3-bbc8d43f590d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450669} :answer-field/id #uuid "ea3082d2-a25f-5513-8dfb-ccff48a59f9f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451288} {:answer-field/choices [{:answer/id #uuid "a8d51c46-ebc6-5ee6-8799-43361686c56d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450670} {:answer/id #uuid "dbd955e0-f434-5f0d-9f8e-17ed74539b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450671}] :answer-field/correct {:answer/id #uuid "dbd955e0-f434-5f0d-9f8e-17ed74539b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450671} :answer-field/id #uuid "e2280d44-e6e2-5192-96b3-c76661eb0a1c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451289} {:answer-field/choices [{:answer/id #uuid "8a3c8024-a57d-59ab-916d-48c342bfd6e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450672} {:answer/id #uuid "594cdb2e-1903-5d5b-a568-00aa3983c13d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450673}] :answer-field/correct {:answer/id #uuid "8a3c8024-a57d-59ab-916d-48c342bfd6e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450672} :answer-field/id #uuid "2a204198-fcd4-5ddf-9145-17e9ce86b916" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451290}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e0dd88-b99c-539d-9214-7424ba73f602" :question/math-academy-id "q-43775" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $E$ containing all $2\\times 2$ matrices of the form $\\alpha A$ where $A$ is some fixed $2\\times 2$ matrix and $\\alpha \\in R.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under matrix addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $E$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}={\\alpha }_{1}A$ and ${A}_{2}={\\alpha }_{2}A$ are two matrices from $E,$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & ={\\alpha }_{1}A+{\\alpha }_{2}A=({\\alpha }_{1}+{\\alpha }_{2})A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under addition.\n\n- Statement II is true. If $B=\\alpha A$ is an element of $E$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kB & =k\\alpha A=(k\\alpha )A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186481385 :knowledge-point/_questions [{:db/id #edb/ref 17592186124591 :knowledge-point/id #uuid "9b1bb974-826a-590f-8d32-cdc868ca827c" :knowledge-point/title "Identifying Subspaces of Polynomial Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c159e3-322b-5045-961d-a4bb6de6bf28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186480754} {:answer/id #uuid "0be6e3fd-a982-5d87-84bd-f85e41333d20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186480763} {:answer/id #uuid "62c9945e-be6a-5851-bfe4-b314ac1b71d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186480920} {:answer/id #uuid "7f0c6a78-5937-5a8c-b3a3-be973c02f31d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186480978} {:answer/id #uuid "a6d54a74-6c6a-5da4-9499-7d05f911b9ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186481053}] :answer-field/correct {:answer/id #uuid "a6d54a74-6c6a-5da4-9499-7d05f911b9ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186481053} :answer-field/id #uuid "a24ecf47-9c4a-5174-a968-bb79cd6b4d3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75f0d82a-dd66-5d66-8858-8e85c7e74ab7" :question/math-academy-id "q-94610" :question/problem "Consider the vector space ${R}_{3}[t]$ of all polynomials in the variable $t$ of degree at most $3,$ and its subset $B=\\{a{t}^{3}+bt+1\\,|\\,a,b\\in R\\}.$\n\nWhich of the following statements are true?\n\nI. $B$ is closed under polynomial addition\n\nII. $B$ is closed under scalar multiplication\n\nIII. $B$ is a subspace of ${R}_{3}[t]$\n\nIV. $B$ is **not** a subspace of ${R}_{3}[t]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(t)=g(t)=t+1,$ then\n\n$$\n\\begin{aligned}f(t)+g(t) & =(t+1)+(t+1) \\\\  & =2t+2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(t)=t+1$ and $k=2,$ then \n\n$$\n\\begin{aligned}kf(t) & =2(t+1)=2t+2,\\end{aligned}\n$$\n\nwhich is not a polynomial from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186360462 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "795fc022-fb5b-5f27-a5d8-aa4c2ad9dca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451961} {:answer/id #uuid "566a3a56-16f1-5b90-bea1-2f3ee57bb51e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451962}] :answer-field/correct {:answer/id #uuid "795fc022-fb5b-5f27-a5d8-aa4c2ad9dca7" :answer/type {:db/