igned}0, & x<\\frac{1}{2}, \\\\ 1-\\frac{1}{8{x}^{3}}, & x\\ge \\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419947 :knowledge-point/_questions [{:db/id #edb/ref 17592186133726 :knowledge-point/id #uuid "1d7509fa-a254-5b78-b307-3e0c4ef4d9ec" :knowledge-point/title "Finding a CDF Given a PDF With a Lower Bound"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1608a6a2-ef7d-5264-a5b5-e47796062000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{42}{{x}^{8}}" :db/id #edb/ref 17592186419863} {:answer/id #uuid "5f215aa0-6421-5dd2-9e39-875332acba0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{1}{{x}^{6}}" :db/id #edb/ref 17592186419878} {:answer/id #uuid "6fdf2e24-d0fd-503f-a916-289e0fb74567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{x}^{7}+1}" :db/id #edb/ref 17592186419884} {:answer/id #uuid "a0c5aada-ee2d-584d-bd82-102f09606a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{1}{{x}^{6}}" :db/id #edb/ref 17592186419902} {:answer/id #uuid "b97304b0-2f60-5182-8a38-e54a262d9d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\frac{1}{{x}^{8}}" :db/id #edb/ref 17592186419909}] :answer-field/correct {:answer/id #uuid "5f215aa0-6421-5dd2-9e39-875332acba0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{1}{{x}^{6}}" :db/id #edb/ref 17592186419878} :answer-field/id #uuid "a835c292-a833-5026-9266-1d083a85fb56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6056a54f-50c5-51bf-9c90-30d0151550be" :question/math-academy-id "q-89652" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{6}{{x}^{7}},\\, & x\\ge 1 \\\\ 0,\\, & x<1\\end{aligned}\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)={\\begin{aligned}0,\\, & x<1 \\\\ h(x),\\, & x\\ge 1.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that is strictly positive only for $x\\ge 1,$ the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)={\\begin{aligned}0, & x<1 \\\\ {\\int }_{1}^{x}f(t)\\,\\text{d}t, & x\\ge 1\\end{aligned}\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{x}f(t)\\,\\text{d}t & ={\\int }_{1}^{x}\\frac{6}{{t}^{7}}\\,\\text{d}t \\\\ \\text{ } & ={-\\frac{1}{{t}^{6}}|}_{1}^{x} \\\\  & =-\\frac{1}{{x}^{6}}+1 \\\\  & =1-\\frac{1}{{x}^{6}}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)={\\begin{aligned}0, & x<1 \\\\ 1-\\frac{1}{{x}^{6}}, & x\\ge 1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419949 :knowledge-point/_questions [{:db/id #edb/ref 17592186133728 :knowledge-point/id #uuid "eedcfa3d-b02b-5f96-99f4-cd0a452d272a" :knowledge-point/title "Finding a CDF Given a PDF With Lower and Upper Bounds"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3713bbf7-8cf6-556f-9963-5d4f811dfef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{2}+12x-20}{15}" :db/id #edb/ref 17592186419869} {:answer/id #uuid "7579f568-8475-5f5b-8c86-9498d6ae9355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-12" :db/id #edb/ref 17592186419886} {:answer/id #uuid "907813c6-ec0c-5b8a-a9ca-a322238090df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2{x}^{2}+12x-8}{15}" :db/id #edb/ref 17592186419895} {:answer/id #uuid "df7344a3-6751-5056-8424-2ea934d23b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-12x-20" :db/id #edb/ref 17592186419921} {:answer/id #uuid "e53e4edf-d1ef-53f7-aa8f-37ab74e89205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-10x-8}{15}" :db/id #edb/ref 17592186419922}] :answer-field/correct {:answer/id #uuid "3713bbf7-8cf6-556f-9963-5d4f811dfef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-{x}^{2}+12x-20}{15}" :db/id #edb/ref 17592186419869} :answer-field/id #uuid "43d0599e-de67-5781-8910-15575fd37739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9853f7b8-7c5d-5c25-8113-542fa8b8a6a4" :question/math-academy-id "q-89664" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{15}(6-x),\\, & 2\\le x\\le 5 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)={\\begin{aligned}0,\\, & x<2 \\\\ h(x),\\, & 2\\le x\\le 5 \\\\ 1,\\, & x>5.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that is strictly positive only for $2\\le x\\le 5,$ the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)={\\begin{aligned}0, & x<2 \\\\ {\\int }_{2}^{x}f(t)\\,\\text{d}t, & 2\\le x\\le 5 \\\\ 1, & x>5\\end{aligned}\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{x}f(t)\\,\\text{d}t & ={\\int }_{2}^{x}\\frac{2}{15}(6-t)\\,\\text{d}t \\\\ \\text{ } & ={-\\frac{1}{15}t(t-12)|}_{2}^{x} \\\\  & =-\\frac{1}{15}x(x-12)-\\frac{4}{3} \\\\  & =\\frac{-{x}^{2}+12x-20}{15}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)={\\begin{aligned}0, & x<2 \\\\ \\frac{-{x}^{2}+12x-20}{15}, & 2\\le x\\le 5 \\\\ 1, & x>5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419945 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12669211-70db-53f2-9325-6e1ec5835553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-{e}^{-3}" :db/id #edb/ref 17592186419861} {:answer/id #uuid "6f38d0bc-036c-5a3d-8b34-69100927b81a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}-e" :db/id #edb/ref 17592186419883} {:answer/id #uuid "c527eec8-cb67-54f5-b73e-08cbe13ad25c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3}-{e}^{-1}" :db/id #edb/ref 17592186419912} {:answer/id #uuid "c7fa11db-9788-537c-8a72-0aede63cc2a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{1}-{e}^{3}" :db/id #edb/ref 17592186419914} {:answer/id #uuid "e8a92539-674d-59a9-aa2a-68f113db4e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}+{e}^{-3}" :db/id #edb/ref 17592186419924}] :answer-field/correct {:answer/id #uuid "12669211-70db-53f2-9325-6e1ec5835553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-1}-{e}^{-3}" :db/id #edb/ref 17592186419861} :answer-field/id #uuid "8abf257c-5f7a-58cf-ac37-0d4ffd9399e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419934}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ffe741c-4355-5cb4-a113-2fae2e76fdee" :question/math-academy-id "q-89700" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)={\\begin{aligned}0, & x<1 \\\\ 1-{e}^{1-x}, & x\\ge 1,\\end{aligned}\n$$\n\nfind $P(2<X\\le 4).$" :question/worked-solution "We can perform this computation as follows:\n\n$$\n\\begin{aligned}P(2<X\\le 4) & =P(X\\le 4)-P(X\\le 2) \\\\  & =F(4)-F(2) \\\\  & =1-{e}^{-3}-(1-{e}^{-1}) \\\\  & ={e}^{-1}-{e}^{-3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419948 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "588e72ed-c4d3-5982-8daf-db7b4cfb2955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-30}+{e}^{-48}" :db/id #edb/ref 17592186419876} {:answer/id #uuid "6127124c-024d-5286-8963-795ce40b1454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-({e}^{-30}-{e}^{-48})" :db/id #edb/ref 17592186419879} {:answer/id #uuid "813bdb77-ccc7-5860-9046-506a4f6e91a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-30}-{e}^{-48}" :db/id #edb/ref 17592186419889} {:answer/id #uuid "c2583976-feec-54f6-a03e-5fbf264986d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{30}-{e}^{-48}" :db/id #edb/ref 17592186419911} {:answer/id #uuid "d018b541-4be1-5c04-b19b-380ff23fb6ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-30}-{e}^{48}" :db/id #edb/ref 17592186419919}] :answer-field/correct {:answer/id #uuid "813bdb77-ccc7-5860-9046-506a4f6e91a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-30}-{e}^{-48}" :db/id #edb/ref 17592186419889} :answer-field/id #uuid "ac8d7e22-8e94-5eb5-a89b-c464e93eefa6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83a3d348-6693-5dcc-af5c-61cd638a0bb7" :question/math-academy-id "q-89746" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)={\\begin{aligned}0, & x<0 \\\\ 1-{e}^{-6x}, & x\\ge 0,\\end{aligned}\n$$\n\nfind $P(5\\le X\\le 8).$" :question/worked-solution "Remember that for continuous random variables, it doesn't matter whether or not we include the endpoints of the interval. So we can perform this computation as follows:\n\n$$\n\\begin{aligned}P(5\\le X\\le 8) & =P(5<X\\le 8) \\\\  & =P(X\\le 8)-P(X\\le 5) \\\\  & =F(8)-F(5) \\\\  & =1-{e}^{-48}-(1-{e}^{-30}) \\\\  & ={e}^{-30}-{e}^{-48}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419946 :knowledge-point/_questions [{:db/id #edb/ref 17592186133729 :knowledge-point/id #uuid "3cbc399b-90f3-5acd-ac70-7345a8436978" :knowledge-point/title "Computing a Probability Over an Interval Using a CDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14cb2e76-8027-5b58-bb92-91643b6d3815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186419862} {:answer/id #uuid "8798db5a-c6d4-56be-a275-6e7ec6c07b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186419892} {:answer/id #uuid "a46bd425-c7b0-500c-a2c5-f64e18a9b985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186419903} {:answer/id #uuid "a710d925-f2d3-59de-a577-1ad51b028b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186419904} {:answer/id #uuid "d4131973-c13d-5487-b2ad-0c1861102e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186419920}] :answer-field/correct {:answer/id #uuid "a710d925-f2d3-59de-a577-1ad51b028b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186419904} :answer-field/id #uuid "4b0b3092-8249-5f35-a2f6-31dcce7858c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419932}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "502fa5ed-8192-5239-85ce-b51fd4a6a69d" :question/math-academy-id "q-89747" :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)={\\begin{aligned}0, & x<2 \\\\ \\frac{{x}^{2}-4}{21}, & 2\\le x\\le 5 \\\\ 1, & x>5,\\end{aligned}\n$$\n\nfind $P(3<X<4).$" :question/worked-solution "Remember that for continuous random variables, it doesn't matter whether or not we include the endpoints of the interval. So we can perform this computation as follows:\n\n$$\n\\begin{aligned}P(3<X<4) & =P(3<X\\le 4) \\\\  & =P(X\\le 4)-P(X\\le 3) \\\\  & =F(4)-F(3) \\\\  & =\\frac{{4}^{2}-4}{21}-\\frac{{3}^{2}-4}{21} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$"}]}
