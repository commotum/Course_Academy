      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14158460/observations/step-q81774-d20008039a696224a799.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14158460/observations/step-q81774-d20008039a696224a799.png",
      "source_url": "https://mathacademy.com/tasks/14158460/topics/2151/review",
      "captured_at": 1791868238.0162768,
      "math_academy_id": "q-81774",
