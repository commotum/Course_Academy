"0em\" rowspacing=\"3pt\"><mtr><mtd><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><msup><mi>x</mi><mn>3</mn></msup></mrow></msubsup><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mo>+</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>−</mo><mi>x</mi></mrow></msubsup><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mroot><mi>y</mi><mn>3</mn></mroot></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>−</mo><mi>y</mi></mrow></msubsup><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-