3e7c32fc-b2a5-5b01-be28-7f715f065fb1" #edb/ref 17592186045417] [17592186120918 #edb/ref 1063 #edb/ref 17592186121136 #edb/ref 17592186045417] [17592186120919 #edb/ref 1058 #edb/ref 17592186120923 #edb/ref 17592186045417] [17592186120919 #edb/ref 1061 45443 #edb/ref 17592186045417] [17592186120919 #edb/ref 1062 #uuid "182c4b73-5dc9-53a4-835c-6d143dc732a6" #edb/ref 17592186045417] [17592186120919 #edb/ref 1063 #edb/ref 17592186119947 #edb/ref 17592186045417] [17592186120920 #edb/ref 1058 #edb/ref 17592186120921 #edb/ref 17592186045417] [17592186120920 #edb/ref 1061 45446 #edb/ref 17592186045417] [17592186120920 #edb/ref 1062 #uuid "405daa49-6e22-58fb-86e9-6e879a856c32" #edb/ref 17592186045417] [17592186120920 #edb/ref 1063 #edb/ref 17592186121137 #edb/ref 17592186045417] [17592186120921 #edb/ref 1058 #edb/ref 17592186120922 #edb/ref 17592186045417] [17592186120921 #edb/ref 1061 45447 #edb/ref 17592186045417] [17592186120921 #edb/ref 1062 #uuid "bf0440fe-1ba1-52ce-be45-c99625d9108a" #edb/ref 17592186045417] [17592186120921 #edb/ref 1063 #edb/ref 17592186119948 #edb/ref 17592186045417] [17592186120922 #edb/ref 1061 45450 #edb/ref 17592186045417] [17592186120922 #edb/ref 1062 #uuid "1ca0f550-1726-5b03-9c0f-4d507624654b" #edb/ref 17592186045417] [17592186120922 #edb/ref 1063 #edb/ref 17592186121138 #edb/ref 17592186045417] [17592186120923 #edb/ref 1058 #edb/ref 17592186120920 #edb/ref 17592186045417] [17592186120923 #edb/ref 1061 45507 #edb/ref 17592186045417] [17592186120923 #edb/ref 1062 #uuid "390940d4-be4b-5226-9968-df737ec5e680" #edb/ref 17592186045417] [17592186120923 #edb/ref 1063 #edb/ref 17592186119949 #edb/ref 17592186045417] [17592186121136 #edb/ref 1064 "Recall that if the curve $\\mathbf r(s)$ is parametrized by arc length $s,$ then the curvature of $\\mathbf{r}$ is defined as\n\n$$\n\\kappa(s) =  \\left\\| \\dfrac{\\textrm{d}\\mathbf T}{\\textrm{d}s}  \\right\\|.\n$$\n\nMoreover, if $\\mathbf r(t)$ is parametrized by a general parameter $t,$ we have the following formula for the curvature:\n\n$$\n\\kappa(t) = \\dfrac{\\|\\mathbf T'(t)\\|}{\\|\\mathbf r'(t)\\|}\n$$\n\nwhere $\\mathbf T(t) = \\dfrac{\\mathbf r'(t)}{\\|\\mathbf r'(t)\\|}$ is the unit tangent vector to the curve. \n\nIt can be shown that the curvature of $\\mathbf r(t)$ can also be found using the following cross product formula:\n\n$$\n\\kappa(t) = \\dfrac{\\|\\mathbf r'(t) \\times \\mathbf r''(t)\\|}{\\|\\mathbf r'(t)\\|^3}\n$$\n\nWe'll derive this formula at the end of the lesson. For now, let's get some practice at applying it." #edb/ref 17592186045417] [17592186121136 #edb/ref 1065 7883 #edb/ref 17592186045417] [17592186121136 #edb/ref 1066 #uuid "699ec19c-b03f-5cc8-8096-613245aa4961" #edb/ref 17592186045417] [17592186121136 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121137 #edb/ref 1064 "Suppose we have a plane curve $C$ that is parametrized by the vector-valued function\n\n$$\n\\mathbf{r}(t) = \\langle x(t), \\: y(t) \\rangle.\n$$\n\nAt first glance, it looks as though the cross product curvature formula cannot be applied since cross products apply to three-dimensional vectors, whereas the given vector $\\mathbf{r}(t)$ has only two dimensions.\n\nHowever, this curve can also be viewed as a curve in three-dimensional space that lies on the plane $z=0.$ In this case, $\\mathbf{r}(t)$ can be considered as a vector-valued function with $z$-component equal to zero:\n\n$$\n\\mathbf r(t)= \\langle x(t), \\: y(t), \\: 0 \\rangle\n$$\n\nAs a result, the curvature $\\kappa$ of our plane curve $C$ can be calculated using our cross product formula:\n\n$$\n\\kappa(t)=\\dfrac{\\|{\\mathbf{r}^{\\prime}(t)}\\times {\\mathbf{r}^{\\prime\\prime}(t)}\\|}{\\|{\\mathbf{r}^{\\prime}(t)}\\|^3}\n$$" #edb/ref 17592186045417] [17592186121137 #edb/ref 1065 7884 #edb/ref 17592186045417] [17592186121137 #edb/ref 1066 #uuid "2ae1ba4c-311d-5298-8526-146a426bda14" #edb/ref 17592186045417] [17592186121137 #edb/ref 1067 "Applying the Cross Product Formula to Plane Curves" #edb/ref 17592186045417] [17592186121138 #edb/ref 1064 "Recall that if the curve $\\mathbf r(t)$ is parametrized by a general parameter $t,$ then the curvature of $\\mathbf{r}$ is given by\n\n$$\n\\kappa(t) = \\dfrac{\\|\\mathbf T'(t)\\|}{\\|\\mathbf r'(t)\\|},\n$$\n\nwhere $\\mathbf T(t) = \\dfrac{\\mathbf r'(t)}{\\|\\mathbf r'(t)\\|}$ is the unit tangent vector to the curve. \n\nHere, $\\mathbf r'(t)$ is a vector function and $\\|\\mathbf r'(t)\\|$ is a scalar function.\nSo, we differentiate $\\mathbf T(t)$ by using the chain rule:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{∂}{∂t}(T) \\\\  & =\\frac{∂}{∂t}(\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}) \\\\  & =\\frac{∂}{∂t}(\\frac{1}{‖{r}^{′}(t)‖}\\cdot {r}^{′}(t)) \\\\  & =\\frac{∂}{∂t}(\\frac{1}{‖{r}^{′}(t)‖})\\cdot {r}^{′}(t)+\\frac{1}{‖{r}^{′}(t)‖}\\cdot \\frac{∂}{∂t}({r}^{′}(t)) \\\\  & =\\frac{∂}{∂t}(\\frac{1}{‖{r}^{′}(t)‖})\\cdot {r}^{′}(t)+\\frac{1}{‖{r}^{′}(t)‖}\\cdot {r}^{″}(t)\\end{aligned}\n$$\n\nNow, since the cross product of a vector with itself equals $\\mathbf{0},$ we get\n\n$$\n\\begin{aligned}T(t)\\times {T}^{′}(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\\times (\\frac{∂}{∂t}(\\frac{1}{‖{r}^{′}(t)‖})\\cdot {r}^{′}(t)+\\frac{1}{‖{r}^{′}(t)‖}\\cdot {r}^{″}(t)) \\\\  & =\\frac{1}{‖{r}^{′}(t){‖}^{2}}\\,({r}^{′}(t)\\times {r}^{″}(t)).\\end{aligned}\n$$\n\nNext, we find the magnitude of both sides and use the fact that $\\mathbf T$ is a unit vector:\n\n$$\n\\begin{aligned}‖T(t)\\times {T}^{′}(t)‖ & =\\frac{1}{‖{r}^{′}(t){‖}^{2}}\\,‖{r}^{′}(t)\\times {r}^{″}(t)‖ \\\\ ‖T(t)‖\\cdot ‖{T}^{′}(t)‖ & =\\frac{1}{‖{r}^{′}(t){‖}^{2}}\\,‖{r}^{′}(t)\\times {r}^{″}(t)‖ \\\\ 1\\cdot ‖{T}^{′}(t)‖ & =\\frac{1}{‖{r}^{′}(t){‖}^{2}}\\,‖{r}^{′}(t)\\times {r}^{″}(t)‖ \\\\ ‖{T}^{′}(t)‖ & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{2}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\kappa(t) = \\dfrac{\\|\\mathbf T'(t)\\|}{\\|\\mathbf r'(t)\\|} = \\dfrac{\\left\\| \\mathbf r'(t) \\times \\mathbf r''(t) \\right\\|}{\\|\\mathbf r'(t)\\|^3}.\n$$" #edb/ref 17592186045417] [17592186121138 #edb/ref 1065 7885 #edb/ref 17592186045417] [17592186121138 #edb/ref 1066 #uuid "f59936dc-ef8e-53d7-be8e-244d577dd658" #edb/ref 17592186045417] [17592186121138 #edb/ref 1067 "Deriving the Cross Product Formula" #edb/ref 17592186045417] [17592186315120 #edb/ref 1080 "\\frac{18}{t(4+9{t}^{2})^{3/2}}" #edb/ref 17592186045417] [17592186315120 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315120 #edb/ref 1083 #uuid "012ce73b-ccad-5736-8a98-79181d781399" #edb/ref 17592186045417] [17592186315371 #edb/ref 1080 "\\frac{6}{t(4+9{t}^{2})^{1/2}}" #edb/ref 17592186045417] [17592186315371 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315371 #edb/ref 1083 #uuid "2b42cc41-9300-5600-adab-14f258488843" #edb/ref 17592186045417] [17592186315796 #edb/ref 1080 "\\frac{6t}{(4+9{t}^{2})^{3/2}}" #edb/ref 17592186045417] [17592186315796 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315796 #edb/ref 1083 #uuid "7903666a-0bc5-545c-8cca-acb01e2c736b" #edb/ref 17592186045417] [17592186316204 #edb/ref 1080 "\\frac{6}{t(4+9{t}^{2})^{3/2}}" #edb/ref 17592186045417] [17592186316204 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186316204 #edb/ref 1083 #uuid "c16bf73b-f3b4-5ef9-bf8c-52d15609bd27" #edb/ref 17592186045417] [17592186316248 #edb/ref 1080 "\\frac{6{t}^{2}}{(4+9{t}^{2})^{3/2}}" #edb/ref 17592186045417] [17592186316248 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186316248 #edb/ref 1083 #uuid "c85c337a-02ca-5277-ab4f-284e2592cc3c" #edb/ref 17592186045417] [17592186316735 #edb/ref 1075 #edb/ref 17592186315120 #edb/ref 17592186045417] [17592186316735 #edb/ref 1075 #edb/ref 17592186315371 #edb/ref 17592186045417] [17592186316735 #edb/ref 1075 #edb/ref 17592186315796 #edb/ref 17592186045417] [17592186316735 #edb/ref 1075 #edb/ref 17592186316204 #edb/ref 17592186045417] [17592186316735 #edb/ref 1075 #edb/ref 17592186316248 #edb/ref 17592186045417] [17592186316735 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186316735 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186316735 #edb/ref 1078 #edb/ref 17592186316204 #edb/ref 17592186045417] [17592186316735 #edb/ref 1079 #uuid "517a7074-69ee-57e9-839f-2627066da920" #edb/ref 17592186045417] [17592186317438 #edb/ref 1068 #edb/ref 17592186316735 #edb/ref 17592186045417] [17592186317438 #edb/ref 1069 "q-34381" #edb/ref 17592186045417] [17592186317438 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186317438 #edb/ref 1071 "What is the curvature of the curve $r(t)=⟨{t}^{2},{t}^{3}⟩$, for $t>0?$" #edb/ref 17592186045417] [17592186317438 #edb/ref 1072 #uuid "a8320061-9385-5e97-8a78-62a775ef29e2" #edb/ref 17592186045417] [17592186317438 #edb/ref 1074 "The curvature $κ$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{{‖{r}^{′}(t)‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖$:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\frac{\\text{d}}{\\text{d}t}({t}^{3})⟩=⟨2t,3{t}^{2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(2t)^{2}+(3{t}^{2})^{2}} \\\\  & =\\sqrt{4{t}^{2}+9{t}^{4}} \\\\  & =t\\sqrt{4+9{t}^{2}}\\end{aligned}\n$$\n\nNotice that since $t>0$, we have $|t|=t.$\n\nNow, we find the second derivative:\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩=⟨2,6t⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(t)$ and ${r}^{″}(t)$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(t)\\times {r}^{″}(t) & =⟨2t,\\,3{t}^{2},\\,0⟩\\times ⟨2,\\,6t,\\,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2t & 3{t}^{2} & 0 \\\\ 2 & 6t & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}2t & 3{t}^{2} \\\\ 2 & 6t\\end{aligned}\\right|\\,k \\\\  & =6{t}^{2}\\,k\\end{aligned}\n$$\n\nSo, the magnitude of the cross product is\n\n$$\n‖{r}^{′}(t)\\times {r}^{″}(t)‖=6{t}^{2}.\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{6{t}^{2}}{(t\\sqrt{4+9{t}^{2}})^{3}} \\\\  & =\\frac{6{t}^{2}}{{t}^{3}(4+9{t}^{2})^{3/2}} \\\\  & =\\frac{6}{t(4+9{t}^{2})^{3/2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351753 #edb/ref 1080 "\\frac{1}{{sin}^{2}⁡(t)}" #edb/ref 17592186045417] [17592186351753 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351753 #edb/ref 1083 #uuid "1531abda-6b9e-57a0-85f8-a314eedab0cb" #edb/ref 17592186045417] [17592186352760 #edb/ref 1080 "\\frac{\\operatorname{sin}⁡t}{\\sqrt{1+{cos}^{2}⁡(t)}}" #edb/ref 17592186045417] [17592186352760 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352760 #edb/ref 1083 #uuid "88309aca-4d50-5129-b6ef-7913f78d97f3" #edb/ref 17592186045417] [17592186352769 #edb/ref 1080 "\\frac{\\operatorname{sin}⁡t}{(1+{cos}^{2}⁡(t))^{3/2}}" #edb/ref 17592186045417] [17592186352769 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352769 #edb/ref 1083 #uuid "89c7f87a-5e05-5ea2-9af4-aa43698ddf5d" #edb/ref 17592186045417] [17592186353214 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186353214 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353214 #edb/ref 1083 #uuid "bfbd59e6-4ef2-5b7d-8bb7-23097c14bac6" #edb/ref 17592186045417] [17592186353473 #edb/ref 1080 "\\frac{\\operatorname{cos}⁡t}{(1+{cos}^{2}⁡(t))^{3/2}}" #edb/ref 17592186045417] [17592186353473 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353473 #edb/ref 1083 #uuid "db666671-7f53-5434-afee-7634c681014c" #edb/ref 17592186045417] [17592186353963 #edb/ref 1075 #edb/ref 17592186351753 #edb/ref 17592186045417] [17592186353963 #edb/ref 1075 #edb/ref 17592186352760 #edb/ref 17592186045417] [17592186353963 #edb/ref 1075 #edb/ref 17592186352769 #edb/ref 17592186045417] [17592186353963 #edb/ref 1075 #edb/ref 17592186353214 #edb/ref 17592186045417] [17592186353963 #edb/ref 1075 #edb/ref 17592186353473 #edb/ref 17592186045417] [17592186353963 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186353963 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186353963 #edb/ref 1078 #edb/ref 17592186352769 #edb/ref 17592186045417] [17592186353963 #edb/ref 1079 #uuid "54ee2fe4-94d2-55d2-8a33-2d8eb87dbae3" #edb/ref 17592186045417] [17592186354511 #edb/ref 1068 #edb/ref 17592186353963 #edb/ref 17592186045417] [17592186354511 #edb/ref 1069 "q-86799" #edb/ref 17592186045417] [17592186354511 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186354511 #edb/ref 1071 "Given the curve $r(t)=⟨-t,\\,4,\\,1+\\operatorname{sin}⁡t⟩$ for $0\\le t\\le \\pi $, use the cross product curvature formula to find the curvature as a function of $t.$" #edb/ref 17592186045417] [17592186354511 #edb/ref 1072 #uuid "bcaa2ffa-aada-5b80-a745-a2dbdb67535d" #edb/ref 17592186045417] [17592186354511 #edb/ref 1074 "The curvature $κ(t)$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-t),\\,\\frac{\\text{d}}{\\text{d}t}(4),\\,\\frac{\\text{d}}{\\text{d}t}(1+\\operatorname{sin}⁡t)⟩=⟨-1,\\,0,\\,\\operatorname{cos}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-1)^{2}+{0}^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{1+{cos}^{2}⁡(t)}\\end{aligned}\n$$\n\nNext, we find the second derivative ${r}^{″}(t):$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-1),\\,\\frac{\\text{d}}{\\text{d}t}(0),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩=⟨0,\\,0,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nNow, we compute the cross-product:\n\n$$\n\\begin{aligned}{r}^{′}(t)\\times {r}^{″}(t) & =⟨-1,0,\\operatorname{cos}⁡t⟩\\times ⟨0,0,-\\operatorname{sin}⁡t⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & \\operatorname{cos}⁡t \\\\ 0 & 0 & -\\operatorname{sin}⁡t\\end{aligned}| \\\\  & =|\\begin{aligned}0 & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}|i-|\\begin{aligned}-1 & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 0 & 0\\end{aligned}|k \\\\  & =-\\operatorname{sin}⁡t\\,j\\end{aligned}\n$$\n\nThen, we compute the magnitude of the above:\n\n$$\n\\begin{aligned}‖{r}^{′}(t)\\times {r}^{″}(t)‖ & =|\\operatorname{sin}⁡t|=\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t\\ge 0$ when $0\\le t\\le \\pi .$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}=\\frac{\\operatorname{sin}⁡t}{(1+{cos}^{2}⁡(t))^{3/2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186368805 #edb/ref 1068 #edb/ref 17592186368806 #edb/ref 17592186045417] [17592186368805 #edb/ref 1069 "q-83403" #edb/ref 17592186045417] [17592186368805 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186368805 #edb/ref 1071 "Given the curve $r(t)=⟨3\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t,\\,4t⟩,$ use the cross product curvature formula to find the curvature of this curve as a function of $t.$ \n\n*Hint: You can use the fact that ${r}^{′}(t)\\times {r}^{″}(t)=12\\operatorname{cos}⁡t\\,i-12\\operatorname{sin}⁡t\\,j-9k.$*" #edb/ref 17592186045417] [17592186368805 #edb/ref 1072 #uuid "eff11497-0bb2-5558-843d-3319ac120d5d" #edb/ref 17592186045417] [17592186368805 #edb/ref 1074 "The curvature $κ(t)$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(4t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡t,\\,-3\\operatorname{sin}⁡t,\\,4⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3\\operatorname{cos}⁡t)}^{2}+{(-3\\operatorname{sin}⁡t)}^{2}+{4}^{2}} \\\\  & =\\sqrt{9{cos}^{2}⁡t+9{sin}^{2}⁡t+16} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$\n\nSince we are told that\n\n$$\n{r}^{′}(t)\\times {r}^{″}(t)=12\\operatorname{cos}⁡t\\,i-12\\operatorname{sin}⁡t\\,j-9k,\n$$\n\nwe have\n\n$$\n\\begin{aligned}‖{r}^{′}(t)\\times {r}^{″}(t)‖ & =\\sqrt{{(12\\operatorname{cos}⁡t)}^{2}+{(-12\\operatorname{sin}⁡t)}^{2}+{(-9)}^{2}} \\\\  & =\\sqrt{144+81} \\\\  & =15\\end{aligned}\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{15}{{5}^{3}} \\\\  & =\\frac{3}{25}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186368806 #edb/ref 1075 #edb/ref 17592186368807 #edb/ref 17592186045417] [17592186368806 #edb/ref 1075 #edb/ref 17592186368808 #edb/ref 17592186045417] [17592186368806 #edb/ref 1075 #edb/ref 17592186368809 #edb/ref 17592186045417] [17592186368806 #edb/ref 1075 #edb/ref 17592186368810 #edb/ref 17592186045417] [17592186368806 #edb/ref 1075 #edb/ref 17592186368811 #edb/ref 17592186045417] [17592186368806 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186368806 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186368806 #edb/ref 1078 #edb/ref 17592186368807 #edb/ref 17592186045417] [17592186368806 #edb/ref 1079 #uuid "6cce1805-1c9a-5fca-a977-0fbb55ad4d80" #edb/ref 17592186045417] [17592186368807 #edb/ref 1080 "\\frac{3}{25}" #edb/ref 17592186045417] [17592186368807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368807 #edb/ref 1083 #uuid "2477f3d1-be5e-5e0e-bc3f-f8f5b8edbca1" #edb/ref 17592186045417] [17592186368808 #edb/ref 1080 "\\frac{\\sqrt{5}\\,t}{10}" #edb/ref 17592186045417] [17592186368808 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368808 #edb/ref 1083 #uuid "973685dc-4766-5b17-a27c-c29e7950b014" #edb/ref 17592186045417] [17592186368809 #edb/ref 1080 "\\frac{2\\sqrt{3}