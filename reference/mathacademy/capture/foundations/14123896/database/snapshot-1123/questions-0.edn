#{[{:db/id #edb/ref 17592186262943 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8f524a-9681-5a5a-aa6a-8d21d370c6a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef27f12eb1ee6872210bf8cadb6908efd31c1bb54e9e7d34cc3456df2ee03a77.png" :db/id #edb/ref 17592186260656} {:answer/id #uuid "90a9daad-d37b-5bdf-8f0c-1e578a2870e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186261134} {:answer/id #uuid "a19c1461-ef0c-529e-9726-029d4c772ce7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c570cc9958db69a30dc400920b6ff27574e79bd26a53b35e086cb03034c5b6d.png" :db/id #edb/ref 17592186261280} {:answer/id #uuid "c30db028-ad8b-5802-9d7d-fe2ee0d636d7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png" :db/id #edb/ref 17592186261596} {:answer/id #uuid "d4894fee-b5e1-59e2-86ca-ba516e7266bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d774c444ad33c68ec5d507611324030f2005671265ba5f855f322d8db57b69b4.png" :db/id #edb/ref 17592186261746}] :answer-field/correct {:answer/id #uuid "c30db028-ad8b-5802-9d7d-fe2ee0d636d7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png" :db/id #edb/ref 17592186261596} :answer-field/id #uuid "93f1dce4-27ec-501b-8cb3-8ca95b44d739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae6e3096-5c3b-5202-84b9-abfe5e790c65" :question/math-academy-id "q-129113" :question/problem "Which of the following represents the level curves of $f(x,y)=3\\operatorname{sin}⁡x?$" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-3,3].$ So, we will consider only $c$-level curves for $c\\in [-3,3].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 3\\operatorname{sin}⁡x & =c \\\\ x & =\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $x=\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n$ do not depend on $y.$ So, for a given $c\\in [-3,3]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of vertical lines, as shown below.\n\n![](images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png)"}] [{:db/id #edb/ref 17592186421492 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cac3057-4676-5ed3-95e8-e4e063eba65b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ae/ae78f21487e5883b278f0b62a92b2b44ffe8e83e9bd942cf6c94ed4c46d18c67.png" :db/id #edb/ref 17592186421486} {:answer/id #uuid "61cd2c81-8156-5dbe-b41f-65c5a923eb06" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e405503abc7c773cde77a3631e3e39ed1693e3aac958731a9a8ae52e618b03fa.png" :db/id #edb/ref 17592186421487} {:answer/id #uuid "928d4148-96cc-555a-8460-275af511b8a3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f9/f9f6a496ebabedfb6f73db014080b64a3830214b337bd61c4ac4f4d996a93bd5.png" :db/id #edb/ref 17592186421488} {:answer/id #uuid "b23cb473-4c8b-55bf-98c3-c301ef278556" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d7cde978fe7dd74efe8deb0b7b6e507c7ddf549bb45f1eeda81ee82a8b4a002.png" :db/id #edb/ref 17592186421489} {:answer/id #uuid "ed3cc711-dc0b-5b9e-a281-a519fe0fd7e8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ff1117065d7475786dd6c45f71f14d78b32cb3273123ced1adf5a67b750dacdd.png" :db/id #edb/ref 17592186421490}] :answer-field/correct {:answer/id #uuid "ed3cc711-dc0b-5b9e-a281-a519fe0fd7e8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ff1117065d7475786dd6c45f71f14d78b32cb3273123ced1adf5a67b750dacdd.png" :db/id #edb/ref 17592186421490} :answer-field/id #uuid "6a04a0ad-4057-596b-b2f3-8b4c7bc755f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421491}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca25fed3-89e3-5069-b0f1-d69395195a30" :question/math-academy-id "q-129115" :question/problem "Which of the following represents the level curves of $f(x,y)=2x+y?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 2x+y & =c \\\\ y & =-2x+c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-2.$ Therefore, the correct graph is as follows:\n\n![](images/ff/ff1117065d7475786dd6c45f71f14d78b32cb3273123ced1adf5a67b750dacdd.png)"}] [{:db/id #edb/ref 17592186387992 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ffca37-cace-5fde-98f2-279fdf4f3975" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/56/56e923e4c1e2603c9bd3c621df0a5a4043fcc6a37ac73427be14541407fc19d8.png" :db/id #edb/ref 17592186387994} {:answer/id #uuid "9ef1d420-a12a-56ca-a25f-8624b9640b47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09f1a18e1a6fdcd29a40026cbffd8e8bdec23511bb692a1e920c18f942042470.png" :db/id #edb/ref 17592186387995} {:answer/id #uuid "6719fa96-fc32-59ff-ad37-8586f87f620f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186387996} {:answer/id #uuid "2c7de16e-8fae-51b2-b167-c594ccf39873" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/aa/aa4d0cd189808c717648640c5543a632c099970a19d38d44298d409054f2627c.png" :db/id #edb/ref 17592186387997} {:answer/id #uuid "3995e781-cbde-5cfd-b61f-9c376d6d3f49" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf0f4b592cde648f63b21523aba1a49aeeb3b4dcaf909ba72c4629e088ca372a.png" :db/id #edb/ref 17592186387998}] :answer-field/correct {:answer/id #uuid "6719fa96-fc32-59ff-ad37-8586f87f620f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186387996} :answer-field/id #uuid "5053c438-eb23-5e9c-bd54-db15189721dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387993}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9ec437fa-7d05-53d2-8259-19727f28f519" :question/math-academy-id "q-129117" :question/problem "![](images/03/037422e7b1ce3b3d9067aba39c4fa85c6311770e63e70758c34aa61629c7f58e.png)\n\nWhich of the following could represent the level curves of the surface $z=-\\operatorname{sin}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -\\operatorname{sin}⁡y & =c \\\\ y & =-\\operatorname{arcsin}⁡c+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $y=-\\operatorname{arcsin}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png)"}] [{:db/id #edb/ref 17592186125014 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca9aedb9-5c6e-5ab9-b703-822e9744cd18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186122685} {:answer/id #uuid "dd17347f-22ff-571f-a6d7-807b93a366b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122686} {:answer/id #uuid "18531f6c-e1f0-5729-80f5-92a693529d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122687} {:answer/id #uuid "1ea134b6-4449-59bd-be9f-503cfe8288e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186122688} {:answer/id #uuid "6d0a480c-dbb2-5e27-a839-546a7c305a98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186122689}] :answer-field/correct {:answer/id #uuid "18531f6c-e1f0-5729-80f5-92a693529d56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122687} :answer-field/id #uuid "89f9deee-f7c4-5ce2-84fc-017b6026db36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122684}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "592215bc-9340-546e-9e8f-8c90c87cd2d2" :question/math-academy-id "q-36829" :question/problem "The level curves of the function $f(x,y)={x}^{3}y-{y}^{2}x$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=-1$ gives a line\n\nII. $c=0$ gives a parabola and the axes $x=0$ and $y=0$\n\nIII. $c=1$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}{x}^{3}y-{y}^{2}x & =c \\\\ xy({x}^{2}-y) & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=\\pm 1$ then the level curves are $xy({x}^{2}-y)=\\pm 1,$ which are not lines.\n\n- If $c=0$ then the level curves are $xy({x}^{2}-y)=0,$ which consists of the axes $x=0$ and $y=0$, and the parabola $y={x}^{2}.$\n\nSo, only statement II is true."}] [{:db/id #edb/ref 17592186338937 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a905dcc-7062-5ba9-9481-732d5b5264b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336131} {:answer/id #uuid "92663878-d31f-5b9a-82dc-e0531f783d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337363} {:answer/id #uuid "9e18aeef-f61b-5c4d-a0f7-d57397008dc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337462} {:answer/id #uuid "a5ece99e-e9d1-5800-b5d5-2a569fbee7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337538} {:answer/id #uuid "c045c018-7da4-5278-a1f9-dc81aff7cf6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337739}] :answer-field/correct {:answer/id #uuid "92663878-d31f-5b9a-82dc-e0531f783d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337363} :answer-field/id #uuid "c4f5ebcf-28da-59c5-ae3f-90358c258495" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b94a6f8a-60a9-5806-9e18-4814d39c5835" :question/math-academy-id "q-71395" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}-2{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=1$ gives a line\n\nII. $c=2$ gives a hyperbola\n\nIII. $c=0$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-2{y}^{2}} & =c \\\\ {x}^{2}-2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${x}^{2}-2{y}^{2}=1,$ which is not a line.\n\n- If $c=2$ then the level curve is ${x}^{2}-2{y}^{2}=4,$ which is a hyperbola.\n\n- If $c=0$ then the level curve is $y=\\pm \\frac{x}{\\sqrt{2}},$ which consists of two lines.\n\nSo, only statements II and III are true."}]}
