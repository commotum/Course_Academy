#{[{:db/id #edb/ref 17592186247349 :knowledge-point/_questions [{:db/id #edb/ref 17592186124493 :knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1006640e-9d75-599c-877c-96d359a3fa69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 3 \\\\ 9 & 7\\end{aligned}]" :db/id #edb/ref 17592186244462} {:answer/id #uuid "42160313-d20d-5459-8d6f-cbc3455b020c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -9 \\\\ -3 & 7\\end{aligned}]" :db/id #edb/ref 17592186244891} {:answer/id #uuid "757412d1-09bb-588e-8eab-d5175af0ed23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]" :db/id #edb/ref 17592186245359} {:answer/id #uuid "d2e37099-402c-5b14-93b8-cb301499b55a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -3 \\\\ -9 & 4\\end{aligned}]" :db/id #edb/ref 17592186246190} {:answer/id #uuid "e1d65427-e485-5f40-ae92-d2540533f8bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -7 \\\\ -4 & 3\\end{aligned}]" :db/id #edb/ref 17592186246323}] :answer-field/correct {:answer/id #uuid "757412d1-09bb-588e-8eab-d5175af0ed23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]" :db/id #edb/ref 17592186245359} :answer-field/id #uuid "a490c9f0-7a30-569b-b5f7-30e0b6190adc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6524c152-aeba-5139-803b-30e61293f48c" :question/math-academy-id "q-113413" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}7 & 3 \\\\ 9 & 4\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}7 & 3 \\\\ 9 & 4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{7\\cdot 4-3\\cdot 9}[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}] \\\\  & =1\\cdot [\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247362 :knowledge-point/_questions [{:db/id #edb/ref 17592186124494 :knowledge-point/id #uuid "f989cbaf-2d99-5267-8864-48a48db2d535" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d256c9b-ca10-5ea9-a696-f3ed6a0a6b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -4 \\\\ -4 & 16\\end{aligned}]" :db/id #edb/ref 17592186245135} {:answer/id #uuid "74e82f9c-7a8a-5418-962f-6a02b594b33e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 2 & 17\\end{aligned}]" :db/id #edb/ref 17592186245356} {:answer/id #uuid "a5603449-58ca-55fa-b9cf-370a1ffff990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 4 & \\frac{1}{17}\\end{aligned}]" :db/id #edb/ref 17592186245798} {:answer/id #uuid "e9322699-dec2-5ff2-921c-2b01f57dd42a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ -4 & 4\\end{aligned}]" :db/id #edb/ref 17592186246380} {:answer/id #uuid "eda62fbe-9a7c-5138-b269-2ee24eacf510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ -4 & 17\\end{aligned}]" :db/id #edb/ref 17592186246412}] :answer-field/correct {:answer/id #uuid "eda62fbe-9a7c-5138-b269-2ee24eacf510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ -4 & 17\\end{aligned}]" :db/id #edb/ref 17592186246412} :answer-field/id #uuid "a077ac69-607f-57ea-a0ce-e946298ab8c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246829}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb921b26-a20c-5f23-a094-49ac99b2c6bd" :question/math-academy-id "q-113515" :question/problem "Let $B={[\\begin{aligned}17 \\\\ 4\\end{aligned}],[\\begin{aligned}4 \\\\ 1\\end{aligned}]}$  be a basis of ${R}^{2}$ and let $S$ be the standard basis of ${R}^{2}.$ Find the change-of-coordinates matrix from $S$ to $B.$" :question/worked-solution "Let's denote the vectors of $B$ and $S$ as ${{b}_{1},{b}_{2}}$ and ${{e}_{1},{e}_{2}}$, respectively. Recall that the standard basis of ${R}^{2}$ consists of the vectors\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $S$ to $B$ is a matrix whose columns are the coordinates of the vectors of $S$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${e}_{1}$ and ${e}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {e}_{1} & {e}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}17 & 4 & 1 & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{17}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 0 & \\frac{1}{17} & -\\frac{4}{17} & 1\\end{aligned}] & {R}_{2} & :=17{R}_{2} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 0 & 1 & -4 & 17\\end{aligned}] & {R}_{1} & :={R}_{1}+(-\\frac{4}{17}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -4 \\\\ 0 & 1 & -4 & 17\\end{aligned}]\\end{aligned}\n$$\n\nOn the right-hand side, we obtain the change-of-coordinates matrix from $S$ to $B.$ Therefore, we have\n\n$$\n{P}_{S\\to B}=[\\begin{aligned}1 & -4 \\\\ -4 & 17\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186394305 :knowledge-point/_questions [{:db/id #edb/ref 17592186124493 :knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb6b89d9-5ecc-523c-9fe0-a98270e715c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & \\frac{2}{3} \\\\ -3 & \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394307} {:answer/id #uuid "b48cca5a-57d5-5e3e-85fc-5f7371b9a168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ -\\frac{2}{3} & -\\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394308} {:answer/id #uuid "ebadf3ae-54e1-5e2d-ac3c-70c2f31c63ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{3} & \\frac{2}{3} \\\\ -3 & -1\\end{aligned}]" :db/id #edb/ref 17592186394309} {:answer/id #uuid "0f308fd4-f8a6-5e5f-860e-48792c8fbbdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{3} & -\\frac{2}{3} \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186394310} {:answer/id #uuid "00d59288-f8b5-5054-8c1f-b5518246d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394311}] :answer-field/correct {:answer/id #uuid "00d59288-f8b5-5054-8c1f-b5518246d305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394311} :answer-field/id #uuid "5d1bd593-f01f-5378-b1fe-6d41f9f01e52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394306}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a27a3c1e-ad3c-56e4-aa1a-d2aedbc7058d" :question/math-academy-id "q-81859" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot (-3)-2\\cdot (-9)}[\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}].\\end{aligned}\n$$"}]}
