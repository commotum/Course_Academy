#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186426288} :activity/id #uuid "17862355-72a6-5fb8-967b-537e8771192b" :activity/scope {:db/id #edb/ref 17592186050008 :topic/id #uuid "25ec858d-77d3-5737-88a7-6eeadae45d1d" :topic/math-academy-id 1928} :activity/steps [{:db/id #edb/ref 17592186426287 :step/content {:db/id #edb/ref 17592186394305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb6b89d9-5ecc-523c-9fe0-a98270e715c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & \\frac{2}{3} \\\\ -3 & \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394307} {:answer/id #uuid "b48cca5a-57d5-5e3e-85fc-5f7371b9a168" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 3 \\\\ -\\frac{2}{3} & -\\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394308} {:answer/id #uuid "ebadf3ae-54e1-5e2d-ac3c-70c2f31c63ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{5}{3} & \\frac{2}{3} \\\\ -3 & -1\\end{aligned}]" :db/id #edb/ref 17592186394309} {:answer/id #uuid "0f308fd4-f8a6-5e5f-860e-48792c8fbbdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{5}{3} & -\\frac{2}{3} \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186394310} {:answer/id #uuid "00d59288-f8b5-5054-8c1f-b5518246d305" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}]" :db/id #edb/ref 17592186394311}] :answer-field/correct {:db/id #edb/ref 17592186394311} :answer-field/id #uuid "5d1bd593-f01f-5378-b1fe-6d41f9f01e52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186394306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a27a3c1e-ad3c-56e4-aa1a-d2aedbc7058d" :question/math-academy-id "q-81859" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}5 & 2 \\\\ -9 & -3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot (-3)-2\\cdot (-9)}[\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =\\frac{1}{3}\\cdot [\\begin{aligned}-3 & -2 \\\\ 9 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -\\frac{2}{3} \\\\ 3 & \\frac{5}{3}\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "047626a4-44a1-518d-a9b8-705468162bf9" :step/next {:db/id #edb/ref 17592186426289}} {:db/id #edb/ref 17592186426288 :step/content {:db/id #edb/ref 17592186426286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33773b31-42d5-5b22-b69d-d51cba57075a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=7,$ $b=3,$ and $c=2.$" :db/id #edb/ref 17592186426274} {:answer/id #uuid "38d68fa8-7de7-5c1e-a154-a690cae0ed7e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=0,$ $b=2,$ and $c=5.$" :db/id #edb/ref 17592186426275} {:answer/id #uuid "4c86e4c7-bde7-518f-883c-d6733741d589" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=7,$ $b=2,$ and $c=3.$" :db/id #edb/ref 17592186426276} {:answer/id #uuid "90c0ac77-fbcb-52ce-b243-0e75ec356a91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=-1,$ $b=-4,$ and $c=2.$" :db/id #edb/ref 17592186426279} {:answer/id #uuid "b56f736f-e3af-523b-9386-b38726eccfb7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=0,$ $b=5,$ and $c=2.$" :db/id #edb/ref 17592186426280}] :answer-field/correct {:db/id #edb/ref 17592186426275} :answer-field/id #uuid "9be8ac92-24b2-5071-9ee2-8d0a8572a03d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426284}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b83d51a4-64e8-5d15-b4eb-1a14ddbe497b" :question/math-academy-id "q-81851" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and let $S$ be the standard basis of ${R}^{3}.$ What are the values of $a,b,$ and $c$ if \n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ -4 \\\\ 7\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ 5\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}],\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is \n\n$$\n{P}_{B\\to S}=[\\begin{aligned}a & 3 & -1 \\\\ -4 & 1 & b \\\\ 7 & c & 0\\end{aligned}].\n$$" :question/worked-solution "Recall  that the standard basis of ${R}^{3}$ consists of the vectors ${e}_{1},{e}_{2},$ and ${e}_{3},$ given by\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{e}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nThe components of the vectors in $B$ are just the coordinates relative to the standard basis:\n\n$$\n[{b}_{1}]_{S}=[\\begin{aligned}0 \\\\ -4 \\\\ 7\\end{aligned}],\\,[{b}_{2}]_{S}=[\\begin{aligned}3 \\\\ 1 \\\\ 5\\end{aligned}],\\,[{b}_{3}]_{S}=[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}]\n$$\n\nThe change-of-coordinates matrix from $B$ to $S$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $S.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}0 & 3 & -1 \\\\ -4 & 1 & 2 \\\\ 7 & 5 & 0\\end{aligned}].\n$$\n\nFinally, $a=0,$ $b=2,$ and $c=5.$"} :step/id #uuid "14b98c73-3778-5d7d-bd8f-d1f3c481dbdf" :step/next {:db/id #edb/ref 17592186426287}} {:db/id #edb/ref 17592186426289 :step/content {:db/id #edb/ref 17592186426285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aa3648-2a29-5251-b63d-d4b7f8b86f0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}8 & -5 \\\\ -5 & 7\\end{aligned}]" :db/id #edb/ref 17592186426273} {:answer/id #uuid "4ec21016-7e3e-5b63-aa64-0f06d50c5c24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-8 & -7 \\\\ 5 & 5\\end{aligned}]" :db/id #edb/ref 17592186426277} {:answer/id #uuid "58f4f17b-6aad-55e7-b1d1-014e99ce6351" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}7 & 8 \\\\ -5 & -5\\end{aligned}]" :db/id #edb/ref 17592186426278} {:answer/id #uuid "cd2f609f-5e0d-57ff-8535-d184b581b518" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}8 & 7 \\\\ -5 & -5\\end{aligned}]" :db/id #edb/ref 17592186426281} {:answer/id #uuid "d0371c07-7afd-5a4b-8c13-05d0d0aba1ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}7 & 5 \\\\ 5 & 8\\end{aligned}]" :db/id #edb/ref 17592186426282}] :answer-field/correct {:db/id #edb/ref 17592186426281} :answer-field/id #uuid "7ce86fa9-4f61-508b-a2b4-29ba44037897" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426283}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "abe1f7cc-b85d-54fe-b1a8-40e514a9b913" :question/math-academy-id "q-81906" :question/problem "Let $B=\\{[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}2 \\\\ 3\\end{aligned}]\\}$ and $C=\\{[\\begin{aligned}1 \\\\ -1\\end{aligned}],[\\begin{aligned}1 \\\\ -2\\end{aligned}]\\}$ be bases of ${R}^{2}.$ Find the change-of-coordinates matrix from $B$ to $C.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{c}_{1},{c}_{2}\\}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the coordinates of the vectors of $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 3 & 2 \\\\ -1 & -2 & 2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 2 \\\\ 0 & -1 & 5 & 5\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 2 \\\\ 0 & 1 & -5 & -5\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 8 & 7 \\\\ 0 & 1 & -5 & -5\\end{aligned}]\\end{aligned}\n$$\n\nOn the right-hand side, we obtain the change-of-coordinates matrix from $B$ to $C.$ Therefore, we have\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}8 & 7 \\\\ -5 & -5\\end{aligned}].\n$$"} :step/id #uuid "2efe5e7e-1009-5580-b1b3-51c076c0ff38" :step/next {:db/id #edb/ref 17592186426291}} {:db/id #edb/ref 17592186426290 :step/content {:db/id #edb/ref 17592186247362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d256c9b-ca10-5ea9-a696-f3ed6a0a6b0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 & -4 \\\\ -4 & 16\\end{aligned}]" :db/id #edb/ref 17592186245135} {:answer/id #uuid "74e82f9c-7a8a-5418-962f-6a02b594b33e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 2 \\\\ 2 & 17\\end{aligned}]" :db/id #edb/ref 17592186245356} {:answer/id #uuid "a5603449-58ca-55fa-b9cf-370a1ffff990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 4 \\\\ 4 & \\frac{1}{17}\\end{aligned}]" :db/id #edb/ref 17592186245798} {:answer/id #uuid "e9322699-dec2-5ff2-921c-2b01f57dd42a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & -4 \\\\ -4 & 4\\end{aligned}]" :db/id #edb/ref 17592186246380} {:answer/id #uuid "eda62fbe-9a7c-5138-b269-2ee24eacf510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & -4 \\\\ -4 & 17\\end{aligned}]" :db/id #edb/ref 17592186246412}] :answer-field/correct {:db/id #edb/ref 17592186246412} :answer-field/id #uuid "a077ac69-607f-57ea-a0ce-e946298ab8c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246829}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cb921b26-a20c-5f23-a094-49ac99b2c6bd" :question/math-academy-id "q-113515" :question/problem "Let $B=\\{[\\begin{aligned}17 \\\\ 4\\end{aligned}],[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\}$  be a basis of ${R}^{2}$ and let $S$ be the standard basis of ${R}^{2}.$ Find the change-of-coordinates matrix from $S$ to $B.$" :question/worked-solution "Let's denote the vectors of $B$ and $S$ as $\\{{b}_{1},{b}_{2}\\}$ and $\\{{e}_{1},{e}_{2}\\}$, respectively. Recall that the standard basis of ${R}^{2}$ consists of the vectors\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $S$ to $B$ is a matrix whose columns are the coordinates of the vectors of $S$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${e}_{1}$ and ${e}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {e}_{1} & {e}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}17 & 4 & 1 & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{17}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 0 & \\frac{1}{17} & -\\frac{4}{17} & 1\\end{aligned}] & {R}_{2} & :=17{R}_{2} \\\\  & ∼[\\begin{aligned}1 & \\frac{4}{17} & \\frac{1}{17} & 0 \\\\ 0 & 1 & -4 & 17\\end{aligned}] & {R}_{1} & :={R}_{1}+(-\\frac{4}{17}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -4 \\\\ 0 & 1 & -4 & 17\\end{aligned}]\\end{aligned}\n$$\n\nOn the right-hand side, we obtain the change-of-coordinates matrix from $S$ to $B.$ Therefore, we have\n\n$$\n{P}_{S\\to B}=[\\begin{aligned}1 & -4 \\\\ -4 & 17\\end{aligned}].\n$$"} :step/id #uuid "43b3afd1-0b21-5d59-9760-22f54f558dd0"} {:db/id #edb/ref 17592186426291 :step/content {:db/id #edb/ref 17592186247349 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1006640e-9d75-599c-877c-96d359a3fa69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & 3 \\\\ 9 & 7\\end{aligned}]" :db/id #edb/ref 17592186244462} {:answer/id #uuid "42160313-d20d-5459-8d6f-cbc3455b020c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & -9 \\\\ -3 & 7\\end{aligned}]" :db/id #edb/ref 17592186244891} {:answer/id #uuid "757412d1-09bb-588e-8eab-d5175af0ed23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}]" :db/id #edb/ref 17592186245359} {:answer/id #uuid "d2e37099-402c-5b14-93b8-cb301499b55a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}7 & -3 \\\\ -9 & 4\\end{aligned}]" :db/id #edb/ref 17592186246190} {:answer/id #uuid "e1d65427-e485-5f40-ae92-d2540533f8bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}9 & -7 \\\\ -4 & 3\\end{aligned}]" :db/id #edb/ref 17592186246323}] :answer-field/correct {:db/id #edb/ref 17592186245359} :answer-field/id #uuid "a490c9f0-7a30-569b-b5f7-30e0b6190adc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186246838}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6524c152-aeba-5139-803b-30e61293f48c" :question/math-academy-id "q-113413" :question/problem "The change-of-coordinates matrix from the basis $C$ to the basis $B$ is given by\n${P}_{C\\to B}=[\\begin{aligned}7 & 3 \\\\ 9 & 4\\end{aligned}].$ Find the change-of-coordinates matrix from $B$ to $C$  ." :question/worked-solution "The change-of-coordinates matrix from $B$ to $C$ is the inverse of the change-of-coordinates matrix from $C$ to $B.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{C\\to B}$, we get\n\n$$\n\\begin{aligned}{P}_{B\\to C} & ={P}_{C\\to B}^{-1} \\\\  & ={[\\begin{aligned}7 & 3 \\\\ 9 & 4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{7\\cdot 4-3\\cdot 9}[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}] \\\\  & =1\\cdot [\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -3 \\\\ -9 & 7\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "c97d309f-4d0e-5752-9011-015efc23599f" :step/next {:db/id #edb/ref 17592186426290}}] :activity/title "The Change-of-Coordinates Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186426272}]}
