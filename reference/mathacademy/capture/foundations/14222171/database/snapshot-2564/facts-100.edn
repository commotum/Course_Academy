/ref 17592186045417] [17592186535909 #edb/ref 1078 #edb/ref 17592186535574 #edb/ref 17592186045417] [17592186535909 #edb/ref 1079 #uuid "cee9f237-ef40-55b1-b748-bc0ff7960913" #edb/ref 17592186045417] [17592186535937 #edb/ref 1068 #edb/ref 17592186535858 #edb/ref 17592186045417] [17592186535937 #edb/ref 1069 "q-124659" #edb/ref 17592186045417] [17592186535937 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186535937 #edb/ref 1071 "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,3)$ to the point $N(3,-1),$ then ${\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy=$" #edb/ref 17592186045417] [17592186535937 #edb/ref 1072 #uuid "1c089741-5544-5275-8ceb-bbd95cf5e4fe" #edb/ref 17592186045417] [17592186535937 #edb/ref 1074 "The position vectors of the endpoints of our line segment are $a=i+3\\,j$ and $b=3\\,i-j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+3\\,j+t(3\\,i-j-(i+3\\,j)) \\\\  & =i+3\\,j+t(2\\,i-4\\,j) \\\\  & =(2t+1)\\,i+(3-4t)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=3-4t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i-4\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy & ={\\int }_{0}^{1}{e}^{x-y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+{e}^{x-y}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{x-y}(\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t+1-(3-4t)}(2+(-4))\\,\\text{d}t \\\\  & =-2{\\int }_{0}^{1}{e}^{6t-2}\\,\\text{d}t \\\\  & =-\\frac{1}{3}{e}^{6t-2}\\,{|}_{0}^{1} \\\\  & =-\\frac{1}{3}[{e}^{6(1)-2}-{e}^{6(0)-2}] \\\\  & =-\\frac{1}{3}[{e}^{4}-\\frac{1}{{e}^{2}}] \\\\  & =\\frac{1-{e}^{6}}{3{e}^{2}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186536002 #edb/ref 1068 #edb/ref 17592186535909 #edb/ref 17592186045417] [17592186536002 #edb/ref 1069 "q-124662" #edb/ref 17592186045417] [17592186536002 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186536002 #edb/ref 1071 "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,1)$ to the point $N(3,3),$ then ${\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy=$" #edb/ref 17592186045417] [17592186536002 #edb/ref 1072 #uuid "e6367608-0b6c-56a6-854c-a12592ac7a14" #edb/ref 17592186045417] [17592186536002 #edb/ref 1074 "The position vectors of the endpoints of our line segment are $a=i+j$ and $b=3\\,i+3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+j+t(3\\,i+3\\,j-(i+j)) \\\\  & =i+j+t(2\\,i+2\\,j) \\\\  & =(2t+1)\\,i+(2t+1)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=2t+1$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy & ={\\int }_{0}^{1}\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}\\frac{1}{2t+1}\\cdot 2+\\frac{1}{(2t+1)^{2}}\\cdot 2\\,dt \\\\  & ={[\\operatorname{ln}⁡(2t+1)-\\frac{1}{2t+1}]}_{0}^{1} \\\\  & =[\\operatorname{ln}⁡(2\\cdot 1+1)-\\frac{1}{2\\cdot 1+1}]-[\\operatorname{ln}⁡(2\\cdot 0+1)-\\frac{1}{2\\cdot 0+1}] \\\\  & =\\operatorname{ln}⁡3-\\frac{1}{3}+1 \\\\  & =\\operatorname{ln}⁡3+\\frac{2}{3} \\\\  & =\\frac{3\\operatorname{ln}⁡3+2}{3}\\end{aligned}\n$$" #edb/ref 17592186045417]}
