{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-1}^{0}{[3+2x]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}({[3-2{x}^{2}]}^{2}-{[3+2x]}^{2})\\,\\text{d}x.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186096570 1071 "The region enclosed by the curves $x=-y^2$ and $x = -y$ is rotated $360^\\circ$ about the line $x={1}$. Find an integral that gives the volume of the resulting solid.\n\n![](images/64/6471c937fb79a2266188668ebdb698eb926655b6002f8f259410b96efcb15247.png)" 13194139535876 17592186045417 false] [17592186096570 1071 "The region enclosed by the curves $x=-y^2$ and $x = -y$ is rotated $360^\\circ$ about the line $x={1}.$ Find an integral that gives the volume of the resulting solid.\n\n![](images/64/6471c937fb79a2266188668ebdb698eb926655b6002f8f259410b96efcb15247.png)" 13194139535876 17592186045417 true] [17592186096570 1074 "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\n-y^{2} &= -y \\\\\ny^{2} - y &= 0 \\\\\ny(y - 1) &= 0 \\\\\ny &= 0, 1\n\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y=1$.\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/4d/4da6108728a226e19cea708a09381c9054b129590d2a6d2c07fbfacdc30367a5.png)\n\nThe horizontal arrow\n\n- *enters* the region through the inner curve $x=-{y}^2$, and\n- *leaves* though the outer curve $x=-y$.\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=-y$.![](images/02/02798e08e1eb8cae41e4754cfed267401298d454ce2ef856f47f2ae87a8543ee.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}\nV_{outer} &= π\\int_{0}^{1}[(right) - (left)]^{2}dy \\\\\n&= π\\int_{0}^{1}[(1) - (-y)]^{2}dy \\\\\n&= π\\int_{0}^{1}[1 + y]^{2}dy\n\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=-{y}^2$.![](images/5c/5c5e2060b1321856349719987e43b3424d49b465255295b8777002d85cbe6792.png)\nThe corresponding volume is given by\n$V_{inner}|= π\\displaystyle \\int_{0}^{1}[(right) - (left)]^{2}dy; = π\\displaystyle \\int_{0}^{1}[(1) - (-y^{2})]^{2}dy; = π\\displaystyle \\int_{0}^{1}[1 + y^{2}]^{2}dy$.\n- **Step III.** Find the difference.Finally, we can write the volume of the original solid as\n$V|= V_{outer} - V_{inner}; = π\\displaystyle \\int_{0}^{1}[1 + y]^{2}dy - π\\displaystyle \\int_{0}^{1}[1 + y^{2}]^{2}dy; = π\\displaystyle \\int_{0}^{1}([1 + y]^{2} - [1 + y^{2}]^{2})dy$." 13194139535876 17592186045417 false] [17592186096570 1074 "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}-{y}^{2} & =-y \\\\ {y}^{2}-y & =0 \\\\ y(y-1) & =0 \\\\ y & =0,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y=1.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/4d/4da6108728a226e19cea708a09381c9054b129590d2a6d2c07fbfacdc30367a5.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=-{y}^2,$ and\n\n- *leaves* though the outer curve $x=-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=-y.$\n\n![](images/02/02798e08e1eb8cae41e4754cfed267401298d454ce2ef856f47f2ae87a8543ee.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[\\,(1)-(-y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[1+y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=-{y}^2.$\n\n![](images/5c/5c5e2060b1321856349719987e43b3424d49b465255295b8777002d85cbe6792.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[\\,(1)-(-{y}^{2})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[1+{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[1+y]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{1}{[1+{y}^{2}]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[1+y]}^{2}-{[1+{y}^{2}]}^{2})\\text{d}y.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186096718 1038 17592186535954 13194139535876 17592186045417 true] [17592186096719 1038 17592186535989 13194139535876 17592186045417 true] [17592186096720 1038 17592186535972 13194139535876 17592186045417 true] [17592186096729 1038 17592186535940 13194139535876 17592186045417 true] [17592186096729 1038 17592186535951 13194139535876 17592186045417 true] [17592186096729 1038 17592186535983 13194139535876 17592186045417 true] [17592186096729 1038 17592186535996 13194139535876 17592186045417 true] [17592186096730 1038 17592186535928 13194139535876 17592186045417 true] [17592186096730 1038 17592186535970 13194139535876 17592186045417 true] [17592186096730 1038 17592186535998 13194139535876 17592186045417 true] [17592186096730 1038 17592186536006 13194139535876 17592186045417 true] [17592186096764 1038 17592186535944 13194139535876 17592186045417 true] [17592186096764 1038 17592186535969 13194139535876 17592186045417 true] [17592186096764 1038 17592186535976 13194139535876 17592186045417 true] [17592186096764 1038 17592186535984 13194139535876 17592186045417 true] [17592186096764 1038 17592186535988 13194139535876 17592186045417 true] [17592186096765 1038 17592186535926 13194139535876 17592186045417 true] [17592186096765 1038 17592186535957 13194139535876 17592186045417 true] [17592186096765 1038 17592186535965 13194139535876 17592186045417 true] [17592186096765 1038 17592186535977 13194139535876 17592186045417 true] [17592186096765 1038 17592186536001 13194139535876 17592186045417 true] [17592186096784 1038 17592186535991 13194139535876 17592186045417 true] [17592186096785 1038 17592186536000 13194139535876 17592186045417 true] [17592186096870 1050 720.0 13194139535876 17592186045417 true] [17592186096871 1050 1380.0 13194139535876 17592186045417 true] [17592186097149 1070 17592186045487 13194139535876 17592186045417 true] [17592186097149 1071 "Find the solution of the following system:\n\n$$\n\\{\\begin{aligned}0.2p+0.3q=0.6 \\\\ 0.2p-0.1q=0.4\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186097149 1071 "Find the solution of the following system:\n\n${0.2p + 0.3q = 0.6; 0.2p - 0.1q = 0.4$" 13194139535876 17592186045417 false] [17592186097149 1074 "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n\\{\\begin{aligned}0.2p+0.3q=0.6 & |\\times 10 \\\\ 0.2p-0.1q=0.4 & |\\times 10\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p+3q=6 \\\\ 2p-q=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-1,$ then we will get a $-2p$ term that can cancel with the $2p$ term in the first equation:\n\n$$\n\\{\\begin{aligned}2p+3q=6 &  \\\\ 2p-q=4 & |\\,\\times (-1)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p+3q=6 \\\\ -2p+q=-4\\end{aligned}\n$$\n\nAdding the two equations eliminates the $p$-variable and allows us to solve for $q:$\n\n$$\n\\begin{aligned}\\cancel{2p}+3q & =6 \\\\ -\\cancel{2p}+q & =-4 \\\\ (3q+q) & =(6-4) \\\\ 4q & =2 \\\\ q & =\\frac{2}{4} \\\\ q & =0.5\\end{aligned}\n$$\n\nFinally, we can substitute $q=0.5$ into the equation $2p-q=4$ to solve for $p:$\n\n$$\n\\begin{aligned}2p-q & =4 \\\\ 2p-0.5 & =4 \\\\ 2p & =4.5 \\\\ p & =\\frac{4.5}{2} \\\\ p & =2.25\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=2.25,\\,q=0.5.$" 13194139535876 17592186045417 true] [17592186097209 1070 17592186045487 13194139535876 17592186045417 true] [17592186097209 1071 "![](images/c6/c62793a0dc7ff37a4d6b7cf157239f21e6b0cdef8c3d428916f074584462598b.png)\n\nThe region enclosed by the curves $y = x^{2}$ and $y = 3x$ for $y ∈ [0, 9]$ is rotated $2π$ radians about the line $x = 5$. Find the volume of the resulting solid.\n\n> A scientific calculator is required to answer this question." 13194139535876 17592186045417 false] [17592186097209 1071 "![](images/c6/c62793a0dc7ff37a4d6b7cf157239f21e6b0cdef8c3d428916f074584462598b.png)\n\nThe region enclosed by the curves $y={x}^{2}$ and $y=3x$ for $y\\in [0,9]$ is rotated $2\\pi $ radians about the line $x=5.$ Find the volume of the resulting solid." 13194139535876 17592186045417 true] [17592186097209 1074 "First, since we are rotating about a vertical line, we need to solve the equations of our curves for $x:$ \n\n$$\n\\begin{aligned}y & ={x}^{2}\\,⟹\\,x=\\sqrt{y} \\\\ y & =3x\\,⟹\\,x=\\frac{1}{3}y\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/bd/bd75a7448cfda8237a403f4ea67a99c38e41788839f5c88b89487106e49547d3.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\sqrt{y},$ and\n\n- *leaves* through the outer curve $x=\\frac{1}{3}y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{1}{3}y.$\n\n![](images/0e/0ec13c4447954916af6e3b72abffefb69a46a12671b7b8388a873835654ec921.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{9}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}{[\\,(5)-(\\frac{1}{3}y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}{[5-\\frac{1}{3}y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\sqrt{y}.$\n\n![](images/74/7404d889d1388540821bbd282f82322e3249534b8d4518a6236e9f4bf3164d2c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{9}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}[\\,(5)-(\\sqrt{y})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}[5-\\sqrt{y}]^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{9}({(5-\\frac{1}{3}y)}^{2}-{(5-\\sqrt{y})}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}(\\frac{1}{9}{y}^{2}-\\frac{13}{3}y+10\\sqrt{y})\\,\\,\\text{d}y \\\\  & =\\pi {(\\frac{20{y}^{3/2}}{3}+\\frac{{y}^{3}}{27}-\\frac{13{y}^{2}}{6})|}_{0}^{9} \\\\  & =\\pi [(\\frac{20\\cdot {9}^{3/2}}{3}+\\frac{{9}^{3}}{27}-\\frac{13\\cdot {9}^{2}}{6})-0] \\\\  & =\\frac{63\\pi }{2}.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186097229 1070 17592186045486 13194139535876 17592186045417 true] [17592186097229 1071 "![](images/e8/e8d2665ab162ff21e358a80a6e42659b0385244a08d94f8de3ad5df12b434a9a.png)\n\nThe region above enclosed by the curves $y = x^{2}$ and $y = \\sqrt{x}$ is rotated $2π$ radians about the line $y = 1$. Find the volume of the resulting solid.\n\n> A scientific calculator is required to answer this question." 13194139535876 17592186045417 false] [17592186097229 1071 "![](images/e8/e8d2665ab162ff21e358a80a6e42659b0385244a08d94f8de3ad5df12b434a9a.png)\n\nThe region above enclosed by the curves $y={x}^{2}$ and $y=\\sqrt{x}$ is rotated $2\\pi $ radians about the line $y=1.$ Find the volume of the resulting solid." 13194139535876 17592186045417 true] [17592186097229 1074 "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{2} & =\\sqrt{x} \\\\ {x}^{2}-\\sqrt{x} & =0 \\\\ \\sqrt{x}({x}^{3/2}-1) & =0 \\\\ x & =0,\\,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/7a/7aaa03f21130529bdf5572acac29bfe7566724d8acacc99ca5fc0b035de0398b.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=\\sqrt{x},$ and\n\n- *leaves* through the outer curve $y={x}^{2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{2}.$\n\n![](images/a7/a7bd5b7f8e61be991cb6a54e9b1277bd6df4fd874dbd72ec90802b4f957c31bd.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-({x}^{2})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=\\sqrt{x}.$\n\n![](images/ee/ee93f00e178fa7fd7b8702538298a15a5c98d94205deeb71401a49d8dd891545.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-(\\sqrt{x})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-\\sqrt{x}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[1-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[1-\\sqrt{x}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}((1-{x}^{2})^{2}-(1-\\sqrt{x})^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({x}^{4}-2{x}^{2}-x+2\\sqrt{x})\\,\\,\\text{d}x \\\\  & =\\pi {(\\frac{1}{5}\\,{x}^{5}-\\frac{2}{3}\\,{x}^{3}-\\frac{1}{2}\\,{x}^{2}+\\frac{4}{3}\\,{x}^{3/2}\\text{ })|}_{0}^{1} \\\\  & =\\pi ((\\frac{1}{5}\\,(1)^{5}-\\frac{2}{3}\\,(1)^{3}-\\frac{1}{2}\\,(1)^{2}+\\frac{4}{3}\\,(1)^{3/2})-(0)) \\\\  & =\\pi (\\frac{11}{30}) \\\\  & =\\frac{11\\pi }{30}.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186097292 1070 17592186045485 13194139535876 17592186045417 true] [17592186097292 1071 "A cat’s position relative to a fixed origin $O$ is given by the function $x(t) = 3t^{2} + t$ meters, where $t$ is the time in hours. Find the average position of the cat between $2$ and $4$ hours.\n\n> A scientific calculator is required to answer this question." 13194139535876 17592186045417 false] [17592186097292 1071 "A cat’s position relative to a fixed origin $O$ is given by the function $x(t)=3{t}^{2}+t$ meters, where $t$ is the time in hours. Find the average position of the cat between $2$ and $4$ hours." 13194139535876 17592186045417 true] [17592186097292 1074 "To calculate the average value of the position on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{x}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}\\,{\\int }_{{t}_{1}}^{{t}_{2}}x(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{x}_{\\text{avg}} & =\\frac{1}{4-2}\\,{\\int }_{2}^{4}(3{t}^{2}+t)\\,\\text{d}t \\\\  & =\\frac{1}{2}{({t}^{3}+\\frac{{t}^{2}}{2})|}_{2}^{4} \\\\  & =\\frac{1}{2}[({4}^{3}+\\frac{{4}^{2}}{2})-({2}^{3}+\\frac{{2}^{2}}{2})] \\\\  & =\\frac{1}{2}[(64+8)-(8+2)] \\\\  & =31.\\end{aligned}\n$$\n\nTherefore, the average position is $31\\,\\text{m}.$" 13194139535876 17592186045417 true] [17592186097294 1070 17592186045485 13194139535876 17592186045417 true] [17592186097294 1071 "A train is moving north-east with velocity $v(t) = 6t^{2} + 8t + 100km/h$, where $t$ is the time in hours. Find the average velocity of the train on the interval $t ∈ [1, 4]$.\n\n> A scientific calculator is required to answer this question." 13194139535876 17592186045417 false] [17592186097294 1071 "A train is moving north-east with velocity $v(t)=6{t}^{2}+8t+100\\,\\text{km/h},$ where $t$ is the time in hours. Find the average velocity of the train on the interval $t\\in [1,4].$" 13194139535876 17592186045417 true] [17592186097294 1074 "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{4-1}\\,{\\int }_{1}^{4}(6{t}^{2}+8t+100)\\text{d}t \\\\  & =\\frac{1}{3}(2{t}^{3}+4{t}^{2}+100t){|}_{1}^{4} \\\\  & =\\frac{1}{3}((2(4)^{3}+4(4)^{2}+100(4))-(2(1)^{3}+4(1)^{2}+100(1))) \\\\  & =\\frac{1}{3}((128+64+400)-(2+4+100)) \\\\  & =162.\\end{aligned}\n$$\n\nTherefore, the average velocity is $162\\,\\text{km/h}.$" 13194139535876 17592186045417 true] [17592186097608 1061 2092 13194139535876 17592186045417 false] [17592186097608 1061 638288 13194139535876 17592186045417 true] [17592186097609 1061 2093 13194139535876 17592186045417 false] [17592186097609 1061 638292 13194139535876 17592186045417 true] [17592186097610 1061 2097 13194139535876 17592186045417 false] [17592186097610 1061 638295 13194139535876 17592186045417 true] [17592186097611 1061 2098 13194139535876 17592186045417 false] [17592186097611 1061 638299 13194139535876 17592186045417 true] [17592186097659 1061 27864 13194139535876 17592186045417 false] [17592186097659 1061 638289 13194139535876 17592186045417 true] [17592186097660 1061 27865 13194139535876 17592186045417 false] [17592186097660 1061 638296 13194139535876 17592186045417 true] [17592186097796 1064 "The region enclosed by the curves $y=x^4$ and $y=x$ is shown below. Suppose that this region is rotated $2\\pi$ radians about the horizontal line $y=-1$, generating a solid of revolution. How can we write an integral expression that gives the volume of the solid?\n\n![](images/18/1880138e4a20cb5a47ba89cb3177d5dc6e74f998d7fdd428cdded7af38cadd02.png)\n\nFirst, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\nx^{4} &= x \\\\\nx^{4} - x &= 0 \\\\\nx(x^{3} - 1) &= 0 \\\\\nx &= 0, 1\n\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1$.\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/49/49da0885bbf23e586b488e2b2a9bcaa0d923d3591833c9b8beb31a611c1d8b43.png)\n\nThe vertical arrow\n\n- *enters* the region through the inner curve $y=x^4$, and\n- *leaves* though the outer curve $y=x$.\n\nNow, we can express the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves, as follows:\n\n- **Step I.** Figure out the volume generated by the outer curve $y=x$.![](images/35/352ff26bb5dce0a923c102c4528bd89555b49203c212fb73a42cf31cdf8b226e.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}\nV_{outer} &= π\\int_{0}^{1}[(upper) - (lower)]^{2}dx \\\\\n&= π\\int_{0}^{1}[(x) - (-1)]^{2}dx \\\\\n&= π\\int_{0}^{1}[x + 1]^{2}dx\n\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=x^4$.![](images/ee/ee0fa31b61acd4a1f2a9b6bb21dcd0e5eed3c529780fcb67096d40dccf90c20c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}\nV_{inner} &= π\\int_{0}^{1}[(upper) - (lower)]^{2}dx \\\\\n&= π\\int_{0}^{1}[(x^{4}) - (-1)]^{2}dx \\\\\n&= π\\int_{0}^{1}[x^{4} + 1]^{2}dx\n\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\nFinally, we can write the volume of the original solid as\n$V|= V_{outer} - V_{inner}; = π\\displaystyle \\int_{0}^{1}[x + 1]^{2}dx - π\\displaystyle \\int_{0}^{1}[x^{4} + 1]^{2}dx; = π\\displaystyle \\int_{0}^{1}([x + 1]^{2} - [x^{4} + 1]^{2})dx$." 13194139535876 17592186045417 false] [17592186097796 1064 "The region enclosed by the curves $y=x^4$ and $y=x$ is shown below. Suppose that this region is rotated $2\\pi$ radians about the horizontal line $y=-1,$ generating a solid of revolution. How can we write an integral expression that gives the volume of the solid?\n\n![](images/18/1880138e4a20cb5a47ba89cb3177d5dc6e74f998d7fdd428cdded7af38cadd02.png)\n\nFirst, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{4} & =x \\\\ {x}^{4}-x & =0 \\\\ x({x}^{3}-1) & =0 \\\\ x & =0,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/49/49da0885bbf23e586b488e2b2a9bcaa0d923d3591833c9b8beb31a611c1d8b43.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=x^4,$ and\n\n- *leaves* though the outer curve $y=x.$\n\nNow, we can express the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves, as follows:\n\n- **Step I.** Figure out the volume generated by the outer curve $y=x.$\n\n![](images/35/352ff26bb5dce0a923c102c4528bd89555b49203c212fb73a42cf31cdf8b226e.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(x)-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[x+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=x^4.$\n\n![](images/ee/ee0fa31b61acd4a1f2a9b6bb21dcd0e5eed3c529780fcb67096d40dccf90c20c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[\\,({x}^{4})-(-1)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[{x}^{4}+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[x+1]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[{x}^{4}+1]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[x+1]}^{2}-{[{x}^{4}+1]}^{2})\\text{d}x.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186097797 1064 "Now, suppose that the region enclosed by the curves\n\n$$\ny=\\dfrac x2\n$$\n\nand\n\n$$\ny=\\sqrt x\n$$\n\nis rotated $360^\\circ$ about the vertical line $x=-2$. Let's find the volume of the resulting solid.\n\n![](images/78/7876211e2781a079ac2444436e671e2d61c28ec09774c0acad65e96fb537927a.png)\n\nFirst, since we are rotating about a vertical line, we need to solve the equations of our curves for $x$:\n\n$$\n\\begin{bmatrix}y = \\frac{x}{2} & ⟹x = 2y \\\\ y = \\sqrt{x} & ⟹x = y^{2}\\end{bmatrix}\n$$\n\nNow, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\n2y &= y^{2} \\\\\ny^{2} - 2y &= 0 \\\\\ny(y - 2) &= 0 \\\\\ny &= 0, 2\n\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y={2}$.\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/c3/c3fd84335240208fb158da9b67aaffa07cf490c67f8a77bf28947df998180b76.png)\n\nThe horizontal arrow\n\n- *enters* the region through the inner curve $x={y^2}$, and\n- *leaves* though the outer curve $x=2y$.\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=2y$.![](images/6a/6a075f9b5fb64923de7037b31ec6dd0408e88aa6d965ebb8b204b6c560e23ec1.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}\nV_{outer} &= π\\int_{0}^{2}[(right) - (left)]^{2}dy \\\\\n&= π\\int_{0}^{2}[(2y) - (-2)]^{2}dy \\\\\n&= π\\int_{0}^{2}[2y + 2]^{2}dy\n\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y^2$.![](images/cc/cca4c498956a16cb374a8d0b3341a09e52844026593557710525d07be79a233a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}\nV_{inner} &= π\\int_{0}^{2}[(right) - (left)]^{2}dy \\\\\n&= π\\int_{0}^{2}[(y^{2}) - (-2)]^{2}dy \\\\\n&= π\\int_{0}^{2}[y^{2} + 2]^{2}dy\n\\end{aligned}\n$$\n\n- **Step III.** Find the difference.Finally, we can write the volume of the original solid as\n$V|= V_{outer} - V_{inner}; = π\\displaystyle \\int_{0}^{2}[2y + 2]^{2}dy - π\\displaystyle \\int_{0}^{2}[y^{2} + 2]^{2}dy; = π\\displaystyle \\int_{0}^{2}([2y + 2]^{2} - [y^{2} + 2]^{2})dy; = π\\displaystyle \\int_{0}^{2}(-y^{4} + 8y)dy; = \\left.π(-\\frac{y^{5}}{5} + 4y^{2})\\right|_{0}^{2}; = π[(-\\frac{32}{5} + 16) - 0]; = \\frac{48π}{5}$." 13194139535876 17592186045417 false] [17592186097797 1064 "Now, suppose that the region enclosed by the curves $y=\\dfrac x2$ and $y=\\sqrt x$ is rotated $360^\\circ$ about the vertical line $x=-2.$ Let's find the volume of the resulting solid.\n\n![](images/78/7876211e2781a079ac2444436e671e2d61c28ec09774c0acad65e96fb537927a.png)\n\nFirst, since we are rotating about a vertical line, we need to solve the equations of our curves for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}y=\\frac{x}{2} & \\,⟹\\,x=2y \\\\ y=\\sqrt{x} & \\,⟹\\,x={y}^{2}\\end{aligned}\n$$\n\nNow, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}2y & ={y}^{2} \\\\ {y}^{2}-2y & =0 \\\\ y(y-2) & =0 \\\\ y & =0,2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y={2}.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/c3/c3fd84335240208fb158da9b67aaffa07cf490c67f8a77bf28947df998180b76.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x={y^2},$ and\n\n- *leaves* though the outer curve $x=2y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=2y.$\n\n![](images/6a/6a075f9b5fb64923de7037b31ec6dd0408e88aa6d965ebb8b204b6c560e23ec1.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[\\,(2y)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[2y+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y^2.$\n\n![](images/cc/cca4c498956a16cb374a8d0b3341a09e52844026593557710525d07be79a233a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[\\,({y}^{2})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[{y}^{2}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{2}{[2y+2]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{2}{[{y}^{2}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}({[2y+2]}^{2}-{[{y}^{2}+2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}(-{y}^{4}+8y)\\,\\text{d}y \\\\  & =\\pi {(-\\frac{{y}^{5}}{5}+4{y}^{2})|}_{0}^{2} \\\\  & =\\pi [(-\\frac{32}{5}+16)-0] \\\\  & =\\frac{48\\pi }{5}.\\end{aligned}\n$$" 13194139535876 17592186045417 true] [17592186097810 1064 "Sometimes, we might have a system of equations with decimal coefficients, such as the following:\n\n$$\n\\left\\{\\begin{aligned}0.2x+y &=1 \\\\ 0.15x-0.04y &=0.2\\end{aligned}\\right.\n$$\n\nTo make the system easier to solve, we turn it into a system involving integer coefficients only.\n\nIn general, we multiply each equation by $10,$ or $100,$ or $1000,$ etc. depending on how many decimal places we need to eliminate. In this particular instance:\n\n- We need to eliminate one decimal place in the top equation, so we multiply by $10.$\n\n- We need to eliminate two decimal places in the bottom equation, so we multiply by $100.$\n\nSo, we multiply the first equation by $10$ and the second equation by $100,$ as follows:\n\n$$\n\\left\\{\\begin{aligned}0.2x+y &=1 && |\\times 10 \\\\ 0.15x-0.04y &=0.2 && |\\times 100\\end{aligned}\\right.\n$$\n\nFrom here, we can solve the system of equations using either substitution or elimination." 13194139535876 17592186045417 false] [17592186097810 1064 "Sometimes, we might have a system of equations with decimal coefficients, such as the following:\n\n$$\n\\{\\begin{aligned}0.2x+y=1 \\\\ 0.15x-0.04y=0.2\\end{aligned}\n$$\n\nTo make the system easier to solve, we turn it into a system involving integer coefficients only.\n\nIn general, we multiply each equation by $10,$ or $100,$ or $1000,$ etc. depending on how many decimal places we need to eliminate. In this particular instance:\n\n- We need to eliminate one decimal place in the top equation, so we multiply by $10.$\n\n- We need to eliminate two decimal places in the bottom equation, so we multiply by $100.$\n\nSo, we multiply the first equation by $10$ and the second equation by $100,$ as follows:\n\n![](images/1d/1de5984af7b