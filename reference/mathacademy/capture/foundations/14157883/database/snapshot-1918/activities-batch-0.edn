#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186120625} :activity/id #uuid "faea29b6-21e9-5455-abc1-ad6fe37387f0" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186120625 :step/content {:db/id #edb/ref 17592186121020 :tutorial/content "Remember the following three standard elementary row operations: \n\n  I. Swapping two rows\n\n  II. Multiplying a row by a non-zero number\n\n  III. Adding a multiple of one row to another row\n\nOf these three elementary row operations, only III (adding a multiple of one row to another row) *preserves* the determinant. The other two operations, switching two rows or multiplying a row by a non-zero number, *change* the determinant.\n\nTo demonstrate, let's consider the matrix ![](images/fa/fa51d7c585db408c47e8640ae839c1a3bbf94e2b0097e1ade511e5773461f1e8.svg) Taking the determinant, we have\n![](images/bc/bcf5c5dc9f5b7ed3849e719665f802040cf51e3334ae99e25ea7648cbb0f6134.svg)\n\nIf we swap the two rows, we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4 \\\\  & =2 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nLikewise, if we multiply top row by ${\\color{red}2},$ then we get a different determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}| & =|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| \\\\  & =2\\cdot 4-3\\cdot 4 \\\\  & =-4 \\\\  & \\ne -2\\,\\times \\end{aligned}\n$$\n\nHowever, if we add twice the top row to the bottom row, then we get the same determinant:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3+2\\cdot 1 & 4+2\\cdot 2\\end{aligned}| & =|\\begin{aligned}1 & 2 \\\\ 5 & 8\\end{aligned}| \\\\  & =1\\cdot 8-2\\cdot 5 \\\\  & =-2\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "e5ae8e63-4d2c-5491-9908-96fe94243ab9" :tutorial/math-academy-id 3004 :tutorial/title "Introduction"} :step/id #uuid "57d74627-70e0-5830-ba95-6cb026f4de4b" :step/math-academy-id 16213 :step/next {:db/id #edb/ref 17592186120703}} {:db/id #edb/ref 17592186120626 :step/content {:db/id #edb/ref 17592186119775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119589 :question/id #uuid "596aa514-d598-5ffe-affe-f5580d130bd0" :question/math-academy-id "e-4422"} :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049120}] :knowledge-point/questions [{:db/id #edb/ref 17592186120452} {:db/id #edb/ref 17592186120454} {:db/id #edb/ref 17592186265957} {:db/id #edb/ref 17592186265958} {:db/id #edb/ref 17592186341848} {:db/id #edb/ref 17592186341849} {:db/id #edb/ref 17592186385422} {:db/id #edb/ref 17592186385557} {:db/id #edb/ref 17592186411964} {:db/id #edb/ref 17592186411965} {:db/id #edb/ref 17592186411967}] :knowledge-point/title "Calculating a Determinant After Switching Two Rows"} :step/id #uuid "07d38f85-837d-577c-a3fa-ed4adb824e28" :step/math-academy-id 16214 :step/next {:db/id #edb/ref 17592186120704}} {:db/id #edb/ref 17592186120627 :step/content {:db/id #edb/ref 17592186119776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119590 :question/id #uuid "89152146-8f04-5b4f-8436-15b82431c35d" :question/math-academy-id "e-4423"} :knowledge-point/id #uuid "2f11b223-edd2-59b8-b761-164d56e29746" :knowledge-point/questions [{:db/id #edb/ref 17592186120453} {:db/id #edb/ref 17592186120455} {:db/id #edb/ref 17592186265963} {:db/id #edb/ref 17592186265964} {:db/id #edb/ref 17592186329660} {:db/id #edb/ref 17592186341851} {:db/id #edb/ref 17592186383167} {:db/id #edb/ref 17592186383174} {:db/id #edb/ref 17592186383181} {:db/id #edb/ref 17592186411968} {:db/id #edb/ref 17592186411969} {:db/id #edb/ref 17592186411970} {:db/id #edb/ref 17592186411971}] :knowledge-point/title "Calculating a Determinant After Multiplying a Row by a Number"} :step/id #uuid "b2bed0ab-d12e-5d90-bbf5-94e480bceb4c" :step/math-academy-id 16215 :step/next {:db/id #edb/ref 17592186120743}} {:db/id #edb/ref 17592186120628 :step/content {:db/id #edb/ref 17592186119777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119591 :question/id #uuid "6d46c442-4675-5e0e-a834-a8b10ad2b86a" :question/math-academy-id "e-4424"} :knowledge-point/id #uuid "24e5e193-5e30-5480-9e5d-b7b8f1d5de87" :knowledge-point/questions [{:db/id #edb/ref 17592186120431} {:db/id #edb/ref 17592186120432} {:db/id #edb/ref 17592186265971} {:db/id #edb/ref 17592186265972} {:db/id #edb/ref 17592186329636} {:db/id #edb/ref 17592186329661} {:db/id #edb/ref 17592186341856} {:db/id #edb/ref 17592186383202} {:db/id #edb/ref 17592186383209} {:db/id #edb/ref 17592186385429} {:db/id #edb/ref 17592186385564} {:db/id #edb/ref 17592186385571} {:db/id #edb/ref 17592186409688} {:db/id #edb/ref 17592186411966} {:db/id #edb/ref 17592186440484}] :knowledge-point/title "Calculating a Determinant After Applying Several Elementary Operations"} :step/id #uuid "9c7f038a-e114-5e98-bc36-49762d4031f6" :step/math-academy-id 16216 :step/next {:db/id #edb/ref 17592186120742}} {:db/id #edb/ref 17592186120629 :step/content {:db/id #edb/ref 17592186121021 :tutorial/content "Since $\\det(A^T)=\\det(A),$ the corresponding elementary column operations on determinants have the same properties as the elementary row ones.\n\n- Swapping two columns changes the sign of the determinant.\n\n- Multiplying a column by a number scales the determinant by that number.\n\n- Adding a multiple of one column to another column does not change the determinant." :tutorial/id #uuid "bac0b72b-b76a-5a06-9312-d2b7b8ac4247" :tutorial/math-academy-id 3005 :tutorial/title "Column Operations on Determinants"} :step/id #uuid "d5da1bd5-0cc1-56fe-a8d7-36aa6576326a" :step/math-academy-id 16217} {:db/id #edb/ref 17592186120703 :step/content {:db/id #edb/ref 17592186121044 :tutorial/content "As we saw, swapping two rows does not preserve the determinant. However, the only difference is the sign of the determinant changes. \n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}| & =3\\cdot 2-1\\cdot 4=2\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =-|\\begin{aligned}3 & 4 \\\\ 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nIn general, swapping any two rows of a matrix changes the sign of the determinant to the opposite one. That is to say, \n\n$$\n\\begin{aligned}det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]=-det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮ \\\\ ◻ & ◻ & … & ◻ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}].\\end{aligned}\n$$" :tutorial/id #uuid "f151b612-1bdb-5723-af50-a48439141fbc" :tutorial/math-academy-id 3236 :tutorial/title "Switching Two Rows Changes the Sign of the Determinant"} :step/id #uuid "1889d210-a2bc-5893-b7e3-879d8fc8961f" :step/math-academy-id 17635 :step/next {:db/id #edb/ref 17592186120626}} {:db/id #edb/ref 17592186120704 :step/content {:db/id #edb/ref 17592186121045 :tutorial/content "As we have seen, multiplying a row by a number does not preserve the determinant. However, it does affect the determinant in a predictable way: multiplying a row by a number scales the determinant by that number as well.\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 3 & 4\\end{aligned}|=|\\begin{aligned}2 & 4 \\\\ 3 & 4\\end{aligned}| & =2\\cdot 4-3\\cdot 4=-4\\end{aligned}\n$$\n\nSo, in the above example, we have\n![](images/08/0826c05fe2eabec96065eb2c83228168129b42c309764df4b101f4a520c4a0f9.svg)\n\nIn general, multiplying a row of a matrix by a number multiplies the determinant by that number. That is to say, we can factor out the common multiplier from the row of the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ k△ & k△ & … & k△ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]=k\\cdot det[\\begin{aligned}⋮ & ⋮ & … & ⋮ \\\\ △ & △ & … & △ \\\\ ⋮ & ⋮ & … & ⋮\\end{aligned}]\\end{aligned}\n$$" :tutorial/id #uuid "09c28da6-5340-56f9-bbf5-427a824977ee" :tutorial/math-academy-id 3237 :tutorial/title "Multiplying a Row By a Number Scales the Determinant By That Number"} :step/id #uuid "0cc1f27c-f5d8-5b74-9602-32ce4d87b799" :step/math-academy-id 17658 :step/next {:db/id #edb/ref 17592186120627}} {:db/id #edb/ref 17592186120742 :step/content {:db/id #edb/ref 17592186119850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119665 :question/id #uuid "cbd9b4bc-146a-57f7-a03f-f045f86f3c21" :question/math-academy-id "e-6143"} :knowledge-point/id #uuid "9a0ab53e-79ff-5520-bb50-069fd381d29d" :knowledge-point/questions [{:db/id #edb/ref 17592186120420} {:db/id #edb/ref 17592186120456} {:db/id #edb/ref 17592186265985} {:db/id #edb/ref 17592186265992} {:db/id #edb/ref 17592186265993} {:db/id #edb/ref 17592186265994} {:db/id #edb/ref 17592186329659} {:db/id #edb/ref 17592186329708} {:db/id #edb/ref 17592186378657} {:db/id #edb/ref 17592186383216} {:db/id #edb/ref 17592186385442} {:db/id #edb/ref 17592186409690} {:db/id #edb/ref 17592186411963} {:db/id #edb/ref 17592186424899} {:db/id #edb/ref 17592186483371}] :knowledge-point/title "Identifying a Row Operation Given the Connection Between Two Determinants"} :step/id #uuid "e1ec39b0-859a-5c8a-a8ca-f8a0f6371e76" :step/math-academy-id 22905 :step/next {:db/id #edb/ref 17592186120629}} {:db/id #edb/ref 17592186120743 :step/content {:db/id #edb/ref 17592186121061 :tutorial/content "Let's check what happens if we multiply the entire matrix (not only one row) by a number. For example,\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}| & =1\\cdot 4-2\\cdot 3=-2 \\\\ |\\begin{aligned}3\\cdot 1 & 3\\cdot 2 \\\\ 3\\cdot 3 & 3\\cdot 4\\end{aligned}|=|\\begin{aligned}3 & 6 \\\\ 9 & 12\\end{aligned}| & =3\\cdot 12-6\\cdot 9=-18\\end{aligned}\n$$\n\nSo, in the above example, we have\n\n![](images/fe/fe02091dde43a8a2405f6b588f619bc9fa3f54b31ac8a1ac39d318761f00cc3e.svg)\n\nThe above is equivalent to multiplying both rows of the matrix by $3$. Multiplying the first row scales the determinant by $3$, and then multiplying the second row scales it by $3$ once more.\n\nIn general, multiplying an entire $n \\times n$ matrix by a number multiplies the determinant by that number to the power of $n$. That is to say, we can factor out the common multiplier from the entire matrix, as follows:\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A),\\end{aligned}\n$$\n\nwhere $A$ is an $n \\times n$ matrix." :tutorial/id #uuid "1c99dfd1-b583-5247-9ac5-c2ada47c0ee9" :tutorial/math-academy-id 3880 :tutorial/title "Multiplying a Matrix By a Scalar"} :step/id #uuid "ebb7b384-6a1f-56e3-9927-8911a4ec3563" :step/math-academy-id 22922 :step/next {:db/id #edb/ref 17592186120744}} {:db/id #edb/ref 17592186120744 :step/content {:db/id #edb/ref 17592186119851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119666 :question/id #uuid "ce910ef2-c3af-5173-84d4-ee2a4c957954" :question/math-academy-id "e-6148"} :knowledge-point/id #uuid "272d9a54-ba97-5175-86df-0a78337da7b9" :knowledge-point/questions [{:db/id #edb/ref 17592186120512} {:db/id #edb/ref 17592186120513} {:db/id #edb/ref 17592186265965} {:db/id #edb/ref 17592186265966} {:db/id #edb/ref 17592186265967} {:db/id #edb/ref 17592186265968} {:db/id #edb/ref 17592186341854} {:db/id #edb/ref 17592186341855} {:db/id #edb/ref 17592186379980} {:db/id #edb/ref 17592186379987} {:db/id #edb/ref 17592186383188} {:db/id #edb/ref 17592186383195} {:db/id #edb/ref 17592186409689} {:db/id #edb/ref 17592186409691} {:db/id #edb/ref 17592186440485}] :knowledge-point/title "Calculating a Determinant After Multiplying a Matrix by a Scalar"} :step/id #uuid "6bb5981c-60d1-56ed-a146-3ef4d9c0f6bb" :step/math-academy-id 22923 :step/next {:db/id #edb/ref 17592186120628}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186119994}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186409694} :activity/id #uuid "26bcedbd-f502-5256-b322-6d751a0c036d" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186409692 :step/content {:db/id #edb/ref 17592186409691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08098a6b-f06b-51d7-be19-39ddeb566f21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-256" :db/id #edb/ref 17592186409658} {:answer/id #uuid "4da115ec-321e-53f5-9c9a-06b3818508a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409661} {:answer/id #uuid "7105bb69-b089-5e84-ab20-fd40c1edbdff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-864" :db/id #edb/ref 17592186409667} {:answer/id #uuid "b58e6bc8-29ce-5a41-8721-675b80eb22cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-144" :db/id #edb/ref 17592186409673} {:answer/id #uuid "fcd30542-3cc5-5b61-a9af-49753027f933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-48" :db/id #edb/ref 17592186409681}] :answer-field/correct {:db/id #edb/ref 17592186409673} :answer-field/id #uuid "04759499-638f-5548-ad9a-51762b698235" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409683}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fded0a2c-cd1a-5de1-a671-20ea991daecd" :question/math-academy-id "q-72737" :question/problem "Suppose $A$ is a $2\\times 2$ matrix and $det(A)=-4.$ What is the value of $det(6A)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot A)={k}^{n}\\cdot det(A).\\end{aligned}\n$$\n\nIn our case, we have $k=6$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(6A) & ={6}^{2}\\cdot det(A) \\\\  & =36\\cdot (-4) \\\\  & =-144.\\end{aligned}\n$$"} :step/id #uuid "0f93ad19-15c5-55b8-98ea-d5bcee8f0a3a" :step/next {:db/id #edb/ref 17592186409696}} {:db/id #edb/ref 17592186409693 :step/content {:db/id #edb/ref 17592186409688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403dcee3-3eac-5cf3-a329-0558750fb3b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186409660} {:answer/id #uuid "62a1a85b-a36c-54a7-b3bd-55a36f4cb315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186409664} {:answer/id #uuid "77636ea6-fba2-560e-a69f-f3d2282f86f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186409669} {:answer/id #uuid "81cdf51b-4eb6-557c-9452-11d65bc919bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186409671} {:answer/id #uuid "ebe826b2-b0aa-57e0-a4ad-251af663d3fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186409678}] :answer-field/correct {:db/id #edb/ref 17592186409671} :answer-field/id #uuid "1a00ccd6-15ad-566e-9909-ced57101fb7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409684}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a80ad4c-5529-5931-9d7c-574d40c6f47e" :question/math-academy-id "q-72748" :question/problem "Suppose $B$ is a $3\\times 3$ matrix and $det(B)=-7.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=2{R}_{2}$ and ${R}_{1}↔{R}_{3}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=2{R}_{2}$ involves multiplying a row by $2,$ so the determinant is multiplied by $2$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $2$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =2\\cdot (-det(B)) \\\\  & =-2det(B) \\\\  & =-2\\cdot (-7) \\\\  & =14.\\end{aligned}\n$$"} :step/id #uuid "2aef95ee-e7e9-5cac-b9ad-3b67a53db79f"} {:db/id #edb/ref 17592186409694 :step/content {:db/id #edb/ref 17592186120431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e01723b-cc89-5e3f-b933-6517b2094770" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186409662} {:answer/id #uuid "91ff05b8-c923-5cbc-9974-2858e86d4877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186409672} {:answer/id #uuid "b7b3cea5-79ed-5121-8909-27b79eb945a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186409674} {:answer/id #uuid "b8a98397-80e5-5a87-b4ed-d166d96908c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186409675} {:answer/id #uuid "eb7338ba-732f-5bfb-aded-530b4a5f8d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186409677}] :answer-field/correct {:db/id #edb/ref 17592186409677} :answer-field/id #uuid "dc16361c-3306-5054-a003-e31388cab6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a9d752b-69e4-5f21-888f-3429a8443f7b" :question/math-academy-id "q-42503" :question/problem "Suppose $A$ is a $4\\times 4$ matrix and $det(A)=12.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{2}↔{R}_{3}$ and ${R}_{1}:={R}_{1}+2{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{2}↔{R}_{3}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{1}:={R}_{1}+2{R}_{3}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =-det(A) \\\\  & =-(12) \\\\  & =-12.\\end{aligned}\n$$"} :step/id #uuid "2df25dd7-50b3-560b-9abe-b6b13654a237" :step/next {:db/id #edb/ref 17592186409695}} {:db/id #edb/ref 17592186409695 :step/content {:db/id #edb/ref 17592186409690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5903e6-2dfb-5988-91aa-d76353ccd959" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186409659} {:answer/id #uuid "6d3a3be9-dab5-5f7f-8e95-4eab3b47ad8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186409665} {:answer/id #uuid "6d7bf72b-a934-51fa-b417-3e7f04a3f3b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{3}" :db/id #edb/ref 17592186409666} {:answer/id #uuid "7190fbd3-e0c2-5f59-a1f5-3e49c40c46d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:=2{R}_{3}" :db/id #edb/ref 17592186409668} {:answer/id #uuid "c8afe3f3-a5ef-55a7-b5dd-30e21d2e58fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+(-3){R}_{2}" :db/id #edb/ref 17592186409676}] :answer-field/correct {:db/id #edb/ref 17592186409659} :answer-field/id #uuid "7a779adf-221a-5189-a14f-312c86e15c0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409685}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ac571f6-6f05-5f70-8bcf-34738f544556" :question/math-academy-id "q-43046" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}],\\,B=[\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -3 & -1 \\\\ 5 & -4 & -3 \\\\ 4 & 6 & 1\\end{aligned}| & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & =|\\begin{aligned}2 & -3 & -1 \\\\ 1 & 2 & -1 \\\\ 4 & 6 & 1\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{1}.\n$$"} :step/id #uuid "8e6fad07-ec42-5416-85eb-9ef2b0059cbe" :step/next {:db/id #edb/ref 17592186409692}} {:db/id #edb/ref 17592186409696 :step/content {:db/id #edb/ref 17592186409689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "512abaff-433d-5e4a-864f-f1df10d56d6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186409663} {:answer/id #uuid "7a56edfe-4461-57d1-8804-22f3e005401a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186409670} {:answer/id #uuid "f689939f-47fe-5c00-a125-9fe1fc1187ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "180" :db/id #edb/ref 17592186409679} {:answer/id #uuid "face2d4d-2a2b-5eb7-8047-8fb6dbd54d8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "160" :db/id #edb/ref 17592186409680} {:answer/id #uuid "fcf8031f-e31a-5703-96b3-5a28bec971aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186409682}] :answer-field/correct {:db/id #edb/ref 17592186409682} :answer-field/id #uuid "98c176ba-da66-551c-9c0c-0c257e4d9459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186409686}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81c5993c-3d71-5869-bbf5-3e36b2df3a7f" :question/math-academy-id "q-72741" :question/problem "Suppose $Y$ is a $6\\times 6$ matrix and $det(Y)=5.$ What is the value of $det(2Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=2$ and $n=6.$ Therefore,\n\n$$\n\\begin{aligned}det(2Y) & ={2}^{6}\\cdot det(Y) \\\\  & =64\\cdot 5 \\\\  & =320.\\end{aligned}\n$$"} :step/id #uuid "d75809ee-199d-50e2-b002-2326810f1174" :step/next {:db/id #edb/ref 17592186409693}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186409657}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424902} :activity/id #uuid "11b6f742-f965-5993-a06f-bca8dfba7485" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186424900 :step/content {:db/id #edb/ref 17592186265993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5631a190-3164-5c81-9c22-e6a70c44c09d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186263742} {:answer/id #uuid "74e1b546-dc5d-5c39-8615-b03158b816ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186264014} {:answer/id #uuid "850ef7c7-1f4b-53c9-b078-25bda4009629" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186264145} {:answer/id #uuid "df7141db-3b66-5a7a-b89e-874dcb0bbee8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186264937} {:answer/id #uuid "e044d557-77d9-53d0-a554-77b04c1a4a41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186264947}] :answer-field/correct {:db/id #edb/ref 17592186264014} :answer-field/id #uuid "cf6cdcea-ffe0-5e06-a7c5-0284d3815f01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265614}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e099506-9b8a-52ad-a7eb-ff6f42b6d002" :question/math-academy-id "q-130855" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=5$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 1 & -2 \\\\ -3 & 2 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ -3 & 2 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(5) \\\\  & =-5.\\end{aligned}\n$$"} :step/id #uuid "0950983d-5529-5332-ba75-7636f5397a6b"} {:db/id #edb/ref 17592186424901 :step/content {:db/id #edb/ref 17592186265971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0f29de-25aa-5107-8046-0dd732f9beb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186263097} {:answer/id #uuid "162deb0b-2730-571d-b037-7db47a3aea46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186263209} {:answer/id #uuid "1b8f75e2-26ce-5967-ac8a-f06080423598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186263259} {:answer/id #uuid "66de9e61-f678-5f09-92fa-20666c0a4a57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186263891} {:answer/id #uuid "f578aa5a-7ba5-5a91-8942-93f38512c9ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186265150}] :answer-field/correct {:db/id #edb/ref 17592186263097} :answer-field/id #uuid "f00b119d-2bbd-5aff-88de-546820f3c832" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265676}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da7f3dfc-3649-55d6-80af-942a6a83828d" :question/math-academy-id "q-130767" :question/problem "Suppose $X$ is a $6\\times 6$ matrix and $det(X)=28.$ The matrix $Y$ is obtained from $X$ by applying the elementary row operations ${R}_{1}:=\\frac{3}{4}{R}_{1}$ and ${R}_{6}:={R}_{6}+(-7){R}_{2}.$ What is the value of $det(Y)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{6}:={R}_{6}+(-7){R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\n- The operation ${R}_{1}:=\\frac{3}{4}{R}_{1}$ involves multiplying a row by $\\frac{3}{4},$ so the determinant is multiplied by $\\frac{3}{4}$ as well.\n\nTherefore, we only have to multiply the determinant by $\\frac{3}{4}.$ Consequently, we get\n\n$$\n\\begin{aligned}det(Y) & =\\frac{3}{4}det(X) \\\\  & =\\frac{3}{4}\\cdot 28 \\\\  & =21.\\end{aligned}\n$$"} :step/id #uuid "5a731d48-68b1-58c7-b15e-4a787d1f4b44" :step/next {:db/id #edb/ref 17592186424903}} {:db/id #edb/ref 17592186424902 :step/content {:db/id #edb/ref 17592186329661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038f903c-07cf-5804-8ccf-c48c4437fe4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186326971} {:answer/id #uuid "5e5d0fbb-4c6d-516a-bbe1-bc9a4754768c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186327766} {:answer/id #uuid "7edb508d-7daa-5a42-80ea-172f811c7a6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186328025} {:answer/id #uuid "cef987a3-28b5-50d6-be17-23ad82b7d421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-15" :db/id #edb/ref 17592186328755} {:answer/id #uuid "dce0ee78-0312-5fae-84a0-aea62c27e409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186328863}] :answer-field/correct {:db/id #edb/ref 17592186328755} :answer-field/id #uuid "91964048-e6f4-5262-9e11-ecd0686eeeaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186329428}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44ea0623-3f8f-525c-8344-8d911fbef23b" :question/math-academy-id "q-42504" :question/problem "Suppose $A$ is a $5\\times 5$ matrix and $det(A)=5.$ The matrix $B$ is obtained from $A$ by applying the elementary row operations ${R}_{1}↔{R}_{2}$ and ${R}_{3}:=3{R}_{3}.$ What is the value of $det(B)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{1}↔{R}_{2}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{3}:=3{R}_{3}$ involves multiplying a row by $3,$ so the determinant is multiplied by $3$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $3$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(B) & =3\\cdot (-det(A)) \\\\  & =-3det(A) \\\\  & =-3\\cdot 5 \\\\  & =-15.\\end{aligned}\n$$"} :step/id #uuid "5b098fcf-c1b8-5f75-8b3a-28dc83ab8997" :step/next {:db/id #edb/ref 17592186424904}} {:db/id #edb/ref 17592186424903 :step/content {:db/id #edb/ref 17592186424899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171230a8-065f-5312-91ff-166c6fb3df4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+{R}_{1}" :db/id #edb/ref 17592186424893} {:answer/id #uuid "21bc26a0-57ad-5e62-a6e6-621e2ba24583" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:={R}_{3}+(-1){R}_{1}" :db/id #edb/ref 17592186424894} {:answer/id #uuid "54d72f80-7a7b-5b93-a0ec-2d6edad08ac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-1){R}_{3}" :db/id #edb/ref 17592186424895} {:answer/id #uuid "6c11e90f-184e-57bd-b3ed-1971d8fb82ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:=-{R}_{2}" :db/id #edb/ref 17592186424896} {:answer/id #uuid "acde6755-f2db-5c6c-bdc1-ac03bdaa2931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186424897}] :answer-field/correct {:db/id #edb/ref 17592186424894} :answer-field/id #uuid "c75bea69-7db0-5820-97b1-b5dd95b8b845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424898}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "200dace6-387b-586f-87ab-a5501c01cbe0" :question/math-academy-id "q-130851" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 2 & 3 & 5\\end{aligned}| & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & =|\\begin{aligned}2 & -1 & 3 \\\\ 3 & -5 & 6 \\\\ 0 & 4 & 2\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+(-1){R}_{1}.\n$$"} :step/id #uuid "796d84ed-30ec-5eef-9c9e-3ecd61007abc" :step/next {:db/id #edb/ref 17592186424900}} {:db/id #edb/ref 17592186424904 :step/content {:db/id #edb/ref 17592186341855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17922ecf-87f8-5af9-872a-3d5dc6da26af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-36" :db/id #edb/ref 17592186339339} {:answer/id #uuid "3e3f2587-b4ad-5bf0-81b7-1df62ffb7a09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-243" :db/id #edb/ref 17592186339686} {:answer/id #uuid "a21fdf0b-c950-5ec9-b67b-31a39827c266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186340600} {:answer/id #uuid "ae1d7c41-28d1-55a3-9882-2c2b96500495" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-48" :db/id #edb/ref 17592186340714} {:answer/id #uuid "f3da6cbc-6c90-5ed2-9aad-88c3625d3d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-192" :db/id #edb/ref 17592186341277}] :answer-field/correct {:db/id #edb/ref 17592186341277} :answer-field/id #uuid "ded707a6-03c1-52cc-8868-8933afddd3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341773}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bce6072f-0fd1-50b6-a305-a94b72b85f4e" :question/math-academy-id "q-72740" :question/problem "Suppose $Y$ is a $3\\times 3$ matrix and $det(Y)=-3.$ What is the value of $det(4Y)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot Y)={k}^{n}\\cdot det(Y).\\end{aligned}\n$$\n\nIn our case, we have $k=4$ and $n=3.$ Therefore,\n\n$$\n\\begin{aligned}det(4Y) & ={4}^{3}\\cdot det(Y) \\\\  & =64\\cdot (-3) \\\\  & =-192.\\end{aligned}\n$$"} :step/id #uuid "9e253f5b-694c-5716-b2be-ec3f736b8398" :step/next {:db/id #edb/ref 17592186424901}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424892}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186440490} :activity/id #uuid "f4aebbc3-f038-5073-b26d-b3a33a4479cf" :activity/scope {:db/id #edb/ref 17592186048462 :topic/id #uuid "a1bb4ea4-3502-539f-8843-4f544ac297ef" :topic/math-academy-id 1772} :activity/steps [{:db/id #edb/ref 17592186440486 :step/content {:db/id #edb/ref 17592186378657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319beb45-da82-5928-83bf-d29bc52ed19f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186378659} {:answer/id #uuid "a259e746-f501-54ae-be55-fef569b47320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186378660} {:answer/id #uuid "21d9eeeb-c150-51f2-9c34-5dfbb8074a06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186378661} {:answer/id #uuid "ca0902b3-371c-5ed1-bcca-bdf20d2b6da8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186378662} {:answer/id #uuid "6227f8a3-0c1e-5bad-a5c1-bba85528c3cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186378663}] :answer-field/correct {:db/id #edb/ref 17592186378660} :answer-field/id #uuid "addc5023-5343-5d6e-94d4-459e9803d13f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186378658}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fbcc8a51-42ac-5cb8-a6bc-0647017d9ba5" :question/math-academy-id "q-130858" :question/problem "Consider the matrices given below. Given that $X$ and $Y$ are row equivalent matrices and $det(X)=14$, find $det(Y).$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 1 & 4 & -2 \\\\ 5 & 3 & -1\\end{aligned}],\\,Y=[\\begin{aligned}2 & -3 & 1 \\\\ 5 & 3 & -1 \\\\ 1 & 4 & -2\\end{aligned}].\n$$" :question/worked-solution "Notice that $Y$ can be obtained from $X$ by swapping the $2$nd and the $3$rd rows. \n\nThis changes the sign of the determinant to the opposite one.\nTherefore, we obtain\n\n$$\n\\begin{aligned}det(Y) & =-det(X) \\\\  & =-(14) \\\\  & =-14.\\end{aligned}\n$$"} :step/id #uuid "0b56b3f3-0eed-5dd2-8e0f-81ffa9b89ff3"} {:db/id #edb/ref 17592186440487 :step/content {:db/id #edb/ref 17592186265972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c504d34-49a8-5293-9654-9bb371251af7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-90" :db/id #edb/ref 17592186263118} {:answer/id #uuid "668e2da3-ac3d-5bec-b6b1-16504c2d81fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186263886} {:answer/id #uuid "7573103e-73e5-56e6-832d-af6582780369" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186264021} {:answer/id #uuid "90344634-d8cd-51fb-85d7-7f08481a8bde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186264236} {:answer/id #uuid "c168c56a-3c78-5c71-873d-48190da505aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-75" :db/id #edb/ref 17592186264678}] :answer-field/correct {:db/id #edb/ref 17592186264236} :answer-field/id #uuid "37455212-8943-576e-a134-59b320488bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265345}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b71bc5d0-3557-578c-8a3d-25da59fcce16" :question/math-academy-id "q-130771" :question/problem "Suppose $B$ is a $6\\times 6$ matrix and $det(B)=-75.$ The matrix $C$ is obtained from $B$ by applying the elementary row operations ${R}_{2}:=\\frac{4}{5}{R}_{2}$ and ${R}_{5}↔{R}_{6}.$ What is the value of $det(C)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{5}↔{R}_{6}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{2}:=\\frac{4}{5}{R}_{2}$ involves multiplying a row by $\\frac{4}{5},$ so the determinant is multiplied by $\\frac{4}{5}$ as well.\n\nTherefore, we have to change the sign of the determinant to the opposite one and multiply by $\\frac{4}{5}$ as well. Consequently, we get\n\n$$\n\\begin{aligned}det(C) & =\\frac{4}{5}\\cdot (-det(B)) \\\\  & =-\\frac{4}{5}det(B) \\\\  & =-\\frac{4}{5}\\cdot (-75) \\\\  & =60.\\end{aligned}\n$$"} :step/id #uuid "1776f775-68f2-5dfe-9a78-5fcd889a28cc" :step/next {:db/id #edb/ref 17592186440488}} {:db/id #edb/ref 17592186440488 :step/content {:db/id #edb/ref 17592186383216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59b9b5a2-8dd1-5764-aa90-63de7756ab2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186383218} {:answer/id #uuid "bea9ac5f-6965-5feb-9890-9a84bb8fa9c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+3{R}_{3}" :db/id #edb/ref 17592186383219} {:answer/id #uuid "c930d2e4-f0f9-5e23-b593-fbc36215932d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{1}:={R}_{1}+(-3){R}_{3}" :db/id #edb/ref 17592186383220} {:answer/id #uuid "dce12cc1-6fe9-5710-9501-662de6d6ea91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{3}:=-3{R}_{3}" :db/id #edb/ref 17592186383221} {:answer/id #uuid "5c5d3036-4719-5fd7-ba58-918a06722081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}_{2}:={R}_{2}+(-3){R}_{3}" :db/id #edb/ref 17592186383222}] :answer-field/correct {:db/id #edb/ref 17592186383220} :answer-field/id #uuid "d2936d46-0370-550d-9d6e-65ba694a9efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38a459ba-c9b0-57c4-8ac3-81669bb1022e" :question/math-academy-id "q-130848" :question/problem "Given that $det(A)=det(B),$ which of the following elementary row operations transforms matrix $A$ to matrix $B,$ where\n\n$$\nA=[\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}],\\,B=[\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}]?\n$$" :question/worked-solution "Since $det(A)=det(B)$, the row operation applied to $A$ must be to add or subtract a multiple of one row to another row. In other words, it is of the form \n\n$$\n{R}_{j}:={R}_{j}+(k){R}_{i},\\,i\\ne j.\n$$\n\nBy considering the given row operations that are of the above form, we notice that\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & -2 & 1 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| & {R}_{1} & :={R}_{1}+(-3){R}_{3} \\\\  & =|\\begin{aligned}0 & -8 & 10 \\\\ 2 & -1 & 3 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =det(B).\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-3){R}_{3}.\n$$"} :step/id #uuid "bc80a516-1dfa-5188-a931-81163ba5b5d8" :step/next {:db/id #edb/ref 17592186440486}} {:db/id #edb/ref 17592186440489 :step/content {:db/id #edb/ref 17592186440484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017c23cc-c363-5c6e-87b5-6e7c3ae5e977" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-60" :db/id #edb/ref 17592186440472} {:answer/id #uuid "0d4fda87-7e6e-55cf-a40d-16eb860dbe92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-75" :db/id #edb/ref 17592186440474} {:answer/id #uuid "81b440ea-43a7-5db4-bd71-d49d81ed4b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-30" :db/id #edb/ref 17592186440477} {:answer/id #uuid "b26eabf3-1144-53cd-932b-1525e01f62fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90" :db/id #edb/ref 17592186440479} {:answer/id #uuid "fd7979e9-0f01-5714-b611-2b2303ead7b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186440481}] :answer-field/correct {:db/id #edb/ref 17592186440474} :answer-field/id #uuid "e1483cc5-4c9b-5aca-8098-5a910582cb85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440483}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ba8abd45-3c22-5be5-a8a7-0f2c616dbcc7" :question/math-academy-id "q-130770" :question/problem "Suppose $Y$ is a $9\\times 9$ matrix and $det(Y)=75.$ The matrix $Z$ is obtained from $Y$ by applying the elementary row operations ${R}_{8}↔{R}_{9}$ and ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}.$ What is the value of $det(Z)?$" :question/worked-solution "First, let's figure out what each operation does to the determinant.\n\n- The operation ${R}_{8}↔{R}_{9}$ involves swapping two rows, so it changes the sign of the determinant to the opposite one.\n\n- The operation ${R}_{7}:={R}_{7}+\\frac{2}{5}{R}_{2}$ involves adding a multiple of one row to another row,  so it does not change the determinant.\n\nTherefore, we only have to change the sign of the determinant to the opposite one. Consequently, we get\n\n$$\n\\begin{aligned}det(Z) & =-det(Y) \\\\  & =-(75) \\\\  & =-75.\\end{aligned}\n$$"} :step/id #uuid "dddee882-e3d5-5fc5-bf4f-fc432c1be973" :step/next {:db/id #edb/ref 17592186440487}} {:db/id #edb/ref 17592186440490 :step/content {:db/id #edb/ref 17592186440485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a794be-72e1-5850-a9e7-4f09532bb4d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-42" :db/id #edb/ref 17592186440473} {:answer/id #uuid "2c9a3462-424a-5e23-93a1-21351e2c8529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-384" :db/id #edb/ref 17592186440475} {:answer/id #uuid "3aad9ad4-b303-5b2b-9d26-6d2c4b559298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-21" :db/id #edb/ref 17592186440476} {:answer/id #uuid "8a223201-44a6-5017-aa80-a127d44a8e76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-147" :db/id #edb/ref 17592186440478} {:answer/id #uuid "c00986c8-2ab1-5ba7-aed5-8ac51531c5fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-294" :db/id #edb/ref 17592186440480}] :answer-field/correct {:db/id #edb/ref 17592186440478} :answer-field/id #uuid "ad94b206-3ccb-5817-8ec1-05230e22359f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440482}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc497788-364d-5c29-8657-a4f1556e2704" :question/math-academy-id "q-72744" :question/problem "Suppose $X$ is a $2\\times 2$ matrix and $det(X)=-3.$ What is the value of $det(7X)?$" :question/worked-solution "Multiplying a $n\\times n$ matrix by a scalar $k$ is equivalent to multiplying each row by $k,$ and this occurs $n$ times. This leads to the result\n\n$$\n\\begin{aligned}det(k\\cdot X)={k}^{n}\\cdot det(X).\\end{aligned}\n$$\n\nIn our case, we have $k=7$ and $n=2.$ Therefore,\n\n$$\n\\begin{aligned}det(7X) & ={7}^{2}\\cdot det(X) \\\\  & =49\\cdot (-3) \\\\  & =-147.\\end{aligned}\n$$"} :step/id #uuid "ea78220d-d076-5d61-804b-70c264ba0078" :step/next {:db/id #edb/ref 17592186440489}}] :activity/title "Row and Column Operations on Determinants" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186440471}] [{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186230044} :activity/id #uuid "e1f24137-95a9-5d07-991d-2ce3ba7ada0d" :activity/scope {:db/id #edb/ref 17592186049146 :topic/id #uuid "de6ce0f8-a513-5c11-b2ac-9d3484be570b" :topic/math-academy-id 6679} :activity/steps [{:db/id #edb/ref 17592186230044 :step/content {:db/id #edb/ref 17592186230177 :tutorial/content "Consider the first-order inhomogeneous ODE with constant coefficients given by\n\n$$\nay' + by = f(x),\n$$\n\nwhere $a$ and $b$ are constants.\n\nAs we know, the method of finding the general solution is to find the sum of the complementary solution $y_c(x)$ and a particular solution $y_p(x).$\n\n$$\ny(x) = y_c(x) + y_p(x)\n$$\n\nTo find the particular solution $y_p(x),$ we examine the functional form of the forcing term $f(x)$ and guess a form for $y_p(x)$ that matches it. \n\nAn ODE exhibits **exponential forcing** if the forcing term $f(x)$ is an exponential function\n\n$$\nf(x) = Ke^{k x},\n$$\n\nwhere $K$ is a constant. \n\nProvided that the forcing function $e^{kx}$ is not a term in the complementary solution, our trial guess for the particular solution is an exponential function with the same exponent. That is\n\n$$\ny_p(x) = \\alpha\\,e^{k x},\n$$\n\nwhere $\\alpha$ is a constant to be determined.\n\nIn this lesson, we focus on solving first-order inhomogeneous ODEs with **exponential forcing**. Let's look at a concrete example." :tutorial/id #uuid "7a60ff4f-cb9d-522a-a94a-d16f43b6a04a" :tutorial/math-academy-id 14449 :tutorial/title "Introduction"} :step/id #uuid "0804d262-6611-5c45-bc86-10e3c26e86a2" :step/math-academy-id 597439 :step/next {:db/id #edb/ref 17592186230045}} {:db/id #edb/ref 17592186230045 :step/content {:db/id #edb/ref 17592186230227 :tutorial/content "Consider the differential equation \n\n$$\n\\frac {\\textrm{d} y} {\\textrm{d} x} + 3 y = 4 e ^ {2x}.\n$$\n\nThe associated homogeneous equation is\n\n$$\n\\frac {\\textrm{d} y} {\\textrm{d} x} + 3 y = 0\n$$\n\nand therefore, the complementary solution is \n\n$$\ny_c(x) =  A e^{-3x},\n$$\n\n \n\nwhere $A$ is an arbitrary constant. Let's now find the **particular solution** $y_p(x)$ to this equation.\n\nSince the right-hand side of the inhomogeneous equation is the exponential function $f(x) = 4 e^{2x},$ and this is not incorporated within the complementary solution, we assume a particular solution of the form\n\n$$\ny_p(x) = \\alpha e^{2x},\n$$\n\nwhere $\\alpha$ is a constant to be determined.\n\nCalculating the first derivative of $y_p$ gives\n\n$$\n\\frac{\\textrm{d}y_p}{\\textrm{d}x} = 2\\alpha e ^{2x}.\n$$\n\nTo find the value of $\\alpha,$ we substitute $y_p$ and $y_p'$ into the differential equation and solve for $\\alpha{:}$\n\n$$\n\\begin{aligned}(2\\alpha {e}^{2x})+3(\\alpha {e}^{2x}) & =4{e}^{2x} \\\\ (2+3)\\alpha {e}^{2x} & =4{e}^{2x} \\\\ 5\\alpha {e}^{2x} & =4{e}^{2x} \\\\ \\alpha  & =\\frac{4}{5}\\end{aligned}\n$$\n\nTherefore, the particular solution $y_p(x)$ is\n\n$$\ny_p(x) = \\dfrac{4}{5} e ^{2x}.\n$$\n\nFinally, the **general solution** is given by\n\n$$\ny = y_c + y_p = A e^{-3x} + \\dfrac{4}{5} e ^{2x}.\n$$\n\nWe can employ a similar strategy when the forcing function is a sum of exponential functions. Let's see an example." :tutorial/id #uuid "62cac4a5-105b-5e43-8d88-63ce73a86e94" :tutorial/math-academy-id 14700 :tutorial/title "A Worked Example"} :step/id #uuid "c3a6d6f6-44d9-519b-8417-7113691d787c" :step/math-academy-id 597440 :step/next {:db/id #edb/ref 17592186230046}} {:db/id #edb/ref 17592186230046 :step/content {:db/id #edb/ref 17592186229162 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228896 :question/id #uuid "5e56989a-feb1-590a-8684-9442dee1b1cb" :question/math-academy-id "e-21615"} :knowledge-point/id #uuid "42bcc7e2-88f7-5ef9-8c51-77c1e2c8e8af" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049370} {:db/id #edb/ref 17592186050271}] :knowledge-point/questions [{:db/id #edb/ref 17592186229626} {:db/id #edb/ref 17592186229641} {:db/id #edb/ref 17592186305078} {:db/id #edb/ref 17592186305080} {:db/id #edb/ref 17592186305083} {:db/id #edb/ref 17592186305085} {:db/id #edb/ref 17592186305086} {:db/id #edb/ref 17592186305087} {:db/id #edb/ref 17592186305088} {:db/id #edb/ref 17592186305089}] :knowledge-point/title "Finding a Particular Solution to a First-Order Inhomogeneous ODE With Exponential Forcing"} :step/id #uuid "bfa02bee-ddb6-54c2-afc0-6e67786db1f4" :step/math-academy-id 597441 :step/next {:db/id #edb/ref 17592186230047}} {:db/id #edb/ref 17592186230047 :step/content {:db/id #edb/ref 17592186230178 :tutorial/content "So far, our guesses for the particular solution have worked because the forcing term did not already appear in the complementary solution.\n\nSometimes, however, the right-hand side of the differential equation has the same form as a term that appears in the complementary solution $y_c(x).$ When this happens, our usual guess for $y_p(x)$ fails because it duplicates part of the complementary solution and cannot produce a new solution.\n\nIn this situation, we must modify our guess by *multiplying it by $x.$* Specifically, if the forcing term has the form $K e^{kx}$ and the complementary solution contains a term like $Ae^{kx},$ then instead of guessing\n\n$$\ny_p(x) = \\alpha e^{kx},\n$$\n\nwe try\n\n$$\ny_p(x) = \\alpha \\boldsymbol{x} e^{kx}.\n$$\n\nThis works because multiplying by $x$ creates a new function that is *linearly independent* of the complementary solution. As a result, our guess no longer overlaps with $y_c(x)$ and can serve as a valid particular solution. We'll discuss linear independence of functions in more detail in future lessons.\n\nLet’s see how this works in practice using a concrete example." :tutorial/id #uuid "e6655774-c9ab-58c6-bfec-5013b08b7918" :tutorial/math-academy-id 14450 :tutorial/title "Cases When the Forcing Term is Part of the Complementary Solution"} :step/id #uuid "b7dc2094-d676-591f-98e7-87919cdf8889" :step/math-academy-id 597445 :step/next {:db/id #edb/ref 17592186230048}} {:db/id #edb/ref 17592186230048 :step/content {:db/id #edb/ref 17592186230229 :tutorial/content "Consider the differential equation\n\n$$\ny' + 5y = 10e^{-5x}.\n$$\n\nThe associated homogeneous equation is\n\n$$\ny' + 5y = 0\n$$\n\nand so the complementary solution is \n\n$$\ny_c(x) = Ae^{-5x},\n$$\n\nwhere $A$ is an arbitrary constant. \n\nNotice that the forcing term is $f(x) = 10 e^{-5x},$ and yet $e^{-5x}$ is a term in the complementary solution. So, in this case, we assume a particular solution that takes the form \n\n$$\ny_p(x) = \\alpha x  e ^ {-5 x} ,\n$$\n\nwhere $\\alpha$ is a constant to be determined.\n\nWe calculate the first derivative of $y_p$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{'} & =(\\alpha x{e}^{-5x})^{'} \\\\  & =\\alpha (x{e}^{-5x})^{'} \\\\  & =\\alpha ({e}^{-5x}-5x{e}^{-5x}) \\\\  & =\\alpha (1-5x){e}^{-5x}\\end{aligned}\n$$\n\nTo find the value of $\\alpha,$ we substitute $y_p$ and $y_p'$ into the differential equation and solve for $\\alpha.$\n\n$$\n\\begin{aligned}(\\alpha (1-5x){e}^{-5x})+5\\alpha x{e}^{-5x} & =10{e}^{-5x} \\\\ (1-5x+5x)\\alpha {e}^{-5x} & =10{e}^{-5x} \\\\ \\alpha {e}^{-5x} & =10{e}^{-5x} \\\\ \\alpha  & =10\\end{aligned}\n$$\n\nTherefore, the particular solution $y_p(x)$ is\n\n$$\ny_p(x) = 10x  e ^ {-5x}\n$$\n\nand thus the general solution to the equation is\n\n$$\ny(x) = y_c(x) + y_p(x) = Ae^{-5x} + 10xe^{-5x}.\n$$" :tutorial/id #uuid "c5cb7b6d-2997-5082-a597-8a0e6e4eaf5b" :tutorial/math-academy-id 14703 :tutorial/title "A Worked Example"} :step/id #uuid "11a3780c-c51f-5b21-bfc3-9b6034b2e639" :step/math-academy-id 597446 :step/next {:db/id #edb/ref 17592186230049}} {:db/id #edb/ref 17592186230049 :step/content {:db/id #edb/ref 17592186229163 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228902 :question/id #uuid "1ea06d66-de30-514a-817f-8749abb4ab25" :question/math-academy-id "e-21621"} :knowledge-point/id #uuid "3c7ce128-42e5-5a5a-8fa2-0e897504ff9d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/questions [{:db/id #edb/ref 17592186229627} {:db/id #edb/ref 17592186229643} {:db/id #edb/ref 17592186305094} {:db/id #edb/ref 17592186305107} {:db/id #edb/ref 17592186305109} {:db/id #edb/ref 17592186305110} {:db/id #edb/ref 17592186305120} {:db/id #edb/ref 17592186305130} {:db/id #edb/ref 17592186305132} {:db/id #edb/ref 17592186308395} {:db/id #edb/ref 17592186363739} {:db/id #edb/ref 17592186420166} {:db/id #edb/ref 17592186483350}] :knowledge-point/title "Finding a Particular Solution When the Forcing Term is Part of the Complementary Solution"} :step/id #uuid "3bc4e70a-50ff-55b4-930f-052f89424e30" :step/math-academy-id 597447 :step/next {:db/id #edb/ref 17592186230050}} {:db/id #edb/ref 17592186230050 :step/content {:db/id #edb/ref 17592186229164 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228897 :question/id #uuid "a63b7c7a-2565-5330-8994-54abefbdd191" :question/math-academy-id "e-21616"} :knowledge-point/id #uuid "af1f1fb7-3e26-5624-ac07-0be869d2bd5e" :knowledge-point/questions [{:db/id #edb/ref 17592186229634} {:db/id #edb/ref 17592186229635} {:db/id #edb/ref 17592186305122} {:db/id #edb/ref 17592186305141} {:db/id #edb/ref 17592186305142} {:db/id #edb/ref 17592186305143} {:db/id #edb/ref 17592186308398} {:db/id #edb/ref 17592186308401} {:db/id #edb/ref 17592186308402} {:db/id #edb/ref 17592186308403}] :knowledge-point/title "Finding the General Solution to a First-Order Inhomogeneous ODE With Exponential Forcing"} :step/id #uuid "5976dd4e-9c4c-50fb-83c5-3e9bcb60cd32" :step/math-academy-id 597451 :step/next {:db/id #edb/ref 17592186230051}} {:db/id #edb/ref 17592186230051 :step/content {:db/id #edb/ref 17592186229165 :knowledge-point/canonical-example {:db/id #edb/ref 17592186228898 :question/id #uuid "d2382def-85b2-5002-9614-692f272355c8" :question/math-academy-id "e-21617"} :knowledge-point/id #uuid "570160ff-c937-57e7-bd78-702f7f018e64" :knowledge-point/questions [{:db/id #edb/ref 17592186229628} {:db/id #edb/ref 17592186229649} {:db/id #edb/ref 17592186305144} {:db/id #edb/ref 17592186305145} {:db/id #edb/ref 17592186305146} {:db/id #edb/ref 17592186305147} {:db/id #edb/ref 17592186305148} {:db/id #edb/ref 17592186308343} {:db/id #edb/ref 17592186308344} {:db/id #edb/ref 17592186308345} {:db/id #edb/ref 17592186308346} {:db/id #edb/ref 17592186308397} {:db/id #edb/ref 17592186308400} {:db/id #edb/ref 17592186363742} {:db/id #edb/ref 17592186363758}] :knowledge-point/title "Solving an Initial Value Problem"} :step/id #uuid "fc2e409a-3ef9-58dc-81db-f72435bd3a6c" :step/math-academy-id 597454}] :activity/title "Solving First-Order Linear ODEs With Exponential Forcing" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186229250}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420169} :activity/id #uuid "bc665116-5a76-55aa-9353-754f3071777d" :activity/scope {:db/id #edb/ref 17592186049146 :topic/id #uuid "de6ce0f8-a513-5c11-b2ac-9d3484be570b" :topic/math-academy-id 6679} :activity/steps [{:db/id #edb/ref 17592186420167 :step/content {:db/id #edb/ref 17592186308398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87aacf8e-bc15-5baf-95e2-dc84ee4735c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{e}^{7x}+5x{e}^{7x}" :db/id #edb/ref 17592186306441} {:answer/id #uuid "a6180aa2-764b-5335-9218-b9ecd269a77d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5x+A)e^{7x}" :db/id #edb/ref 17592186420162}] :answer-field/correct {:db/id #edb/ref 17592186420162} :answer-field/id #uuid "ef304257-c02b-5b9a-91de-da2bbd172314" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186308275}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cafd04c6-8f34-538e-bfbf-4314bcafa2be" :question/math-academy-id "q-333168" :question/problem "Consider the differential equation \n\n$$\n{y}^{′}-7y=5{e}^{7x}.\n$$\n\nFind the general solution to this equation given that the complementary solution is ${y}_{c}(x)=A{e}^{7x},$ where $A$ is an arbitrary constant.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-7{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{7x}.\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nWe see that the right-hand side is $5{e}^{7x},$ and ${e}^{7x}$ is a term in the complementary solution, so we assume that a particular solution takes the form \n\n$$\n{y}_{p}=\\alpha x{e}^{7x},\n$$\n\nwhere $\\alpha $ is a constant to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{7x})^{′} \\\\  & =\\alpha (x{e}^{7x})^{′} \\\\  & =\\alpha ({e}^{7x}+7x{e}^{7x}) \\\\  & =\\alpha (1+7x){e}^{7x}.\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1+7x){e}^{7x})-7\\alpha x{e}^{7x} & =5{e}^{7x} \\\\ (1+7x-7x)\\alpha {e}^{7x} & =5{e}^{7x} \\\\ \\alpha {e}^{7x} & =5{e}^{7x} \\\\ \\alpha  & =5.\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=5x{e}^{7x}.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{7x}+5x{e}^{7x}.\n$$"} :step/id #uuid "2c91bcfc-99f4-5bfe-804e-7364e7854038"} {:db/id #edb/ref 17592186420168 :step/content {:db/id #edb/ref 17592186229643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6d8db23-4013-5d8a-8bb0-41b6f6fa3c28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6xe^{2x}" :db/id #edb/ref 17592186420163}] :answer-field/correct {:db/id #edb/ref 17592186420163} :answer-field/id #uuid "9d7b7917-2ac5-5b52-a8e9-071c6e798cfb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186228087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "036131be-8602-586a-8ee5-fe7271608cce" :question/math-academy-id "q-332723" :question/problem "Given that the differential equation \n\n$$\n{y}^{′}-2y=6{e}^{2x},\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{2x}$, find the particular solution to the equation.\n\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $6{e}^{2x},$ and ${e}^{2x}$ is a term in the complementary solution, so we assume that a particular solution takes the form \n\n$$\n{y}_{p}=\\alpha x{e}^{2x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{2x})^{′} \\\\  & =\\alpha (x{e}^{2x})^{′} \\\\  & =\\alpha ({e}^{2x}+2x{e}^{2x}) \\\\  & =\\alpha (1+2x){e}^{2x}\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1+2x){e}^{2x})-2\\alpha x{e}^{2x} & =6{e}^{2x} \\\\ (1+2x-2x)\\alpha {e}^{2x} & =6{e}^{2x} \\\\ \\alpha {e}^{2x} & =6{e}^{2x} \\\\ \\alpha  & =6\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=6x{e}^{2x}.\n$$"} :step/id #uuid "748c2caa-2098-5b2d-8ce4-acf93b07faac" :step/next {:db/id #edb/ref 17592186420170}} {:db/id #edb/ref 17592186420169 :step/content {:db/id #edb/ref 17592186420166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b3766c-24fe-5e39-af92-4bf51a3a4723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9xe^{-6x}" :db/id #edb/ref 17592186420164}] :answer-field/correct {:db/id #edb/ref 17592186420164} :answer-field/id #uuid "f31cbcf7-0ca7-5dff-a5ff-a27c6b8e3c33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186420165}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "388312be-28d6-5dd3-90fa-f6561f195420" :question/math-academy-id "q-332708" :question/problem "Given that the differential equation \n\n$$\n{y}^{′}+6y=9{e}^{-6x},\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-6x}$, find the particular solution to the equation.\n\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $9{e}^{-6x},$ and ${e}^{-6x}$ is a term in the complementary solution, so we assume that a particular solution takes the form \n\n$$\n{y}_{p}=\\alpha x{e}^{-6x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{-6x})^{′} \\\\  & =\\alpha (x{e}^{-6x})^{′} \\\\  & =\\alpha ({e}^{-6x}-6x{e}^{-6x}) \\\\  & =\\alpha (1-6x){e}^{-6x}\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1-6x){e}^{-6x})+6\\alpha x{e}^{-6x} & =9{e}^{-6x} \\\\ (1-6x+6x)\\alpha {e}^{-6x} & =9{e}^{-6x} \\\\ \\alpha {e}^{-6x} & =9{e}^{-6x} \\\\ \\alpha  & =9\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=9x{e}^{-6x}.\n$$"} :step/id #uuid "7a3db07d-09b8-53c0-a769-ee5a0527289c" :step/next {:db/id #edb/ref 17592186420168}} {:db/id #edb/ref 17592186420170 :step/content {:db/id #edb/ref 17592186308343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0041758a-5182-50fb-a219-5d3f3ef02024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{-2x}+8x{e}^{-2x}" :db/id #edb/ref 17592186305153} {:answer/id #uuid "55f5feee-d649-5b39-a104-bdb383b1096c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8x-1)e^{-2x}" :db/id #edb/ref 17592186420161}] :answer-field/correct {:db/id #edb/ref 17592186420161} :answer-field/id #uuid "19d58e7d-e179-5799-97c4-0c9c22e0553a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186307604}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d63971f5-c416-5771-8c44-552fcfc50a79" :question/math-academy-id "q-332936" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}+2y=8{e}^{-2x},\\,y(0)=-1\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}+2y=8{e}^{-2x}\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{-2x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-2x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nWe see that the right-hand side is $8{e}^{-2x},$ and ${e}^{-2x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha x{e}^{-2x},\n$$\n\nwhere $\\alpha $ is a constant to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{-2x})^{′} \\\\  & =\\alpha (x{e}^{-2x})^{′} \\\\  & =\\alpha ({e}^{-2x}-2x{e}^{-2x}) \\\\  & =\\alpha (1-2x){e}^{-2x}.\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1-2x){e}^{-2x})+2(\\alpha x{e}^{-2x}) & =8{e}^{-2x} \\\\ (1-2x+2x)\\alpha {e}^{-2x} & =8{e}^{-2x} \\\\ \\alpha {e}^{-2x} & =8{e}^{-2x} \\\\ \\alpha  & =8.\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=8x{e}^{-2x}.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{-2x}+8x{e}^{-2x}.\n$$\n\nWe can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=-1$ into the general solution gives\n\n$$\n\\begin{aligned}A+0 & =-1 \\\\ A & =-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-{e}^{-2x}+8x{e}^{-2x}.\n$$"} :step/id #uuid "adfad238-f91c-58f5-8dc5-b475c8a368d7" :step/next {:db/id #edb/ref 17592186420171}} {:db/id #edb/ref 17592186420171 :step/content {:db/id #edb/ref 17592186308345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca491ec8-db7c-5b57-b504-cd04e9792609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{5x}+15x{e}^{5x}" :db/id #edb/ref 17592186307030} {:answer/id #uuid "3e468feb-d4ae-5e37-bcbd-d076dac5bb84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{5x}+15xe^{5x}" :db/id #edb/ref 17592186420160}] :answer-field/correct {:db/id #edb/ref 17592186420160} :answer-field/id #uuid "416fb058-4b84-52e5-8668-5c9c862047fa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186307722}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ceb57bf0-d702-511f-a8e6-4fe4eee1bf79" :question/math-academy-id "q-332938" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-5y=15{e}^{5x},\\,y(0)=1\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}-5y=15{e}^{5x}\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{5x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-5{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{5x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nWe see that the right-hand side is $15{e}^{5x},$ and ${e}^{5x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha x{e}^{5x},\n$$\n\nwhere $\\alpha $ is a constant to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{5x})^{′} \\\\  & =\\alpha (x{e}^{5x})^{′} \\\\  & =\\alpha ({e}^{5x}+5x{e}^{5x}) \\\\  & =\\alpha (1+5x){e}^{5x}.\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1+5x){e}^{5x})-5(\\alpha x{e}^{5x}) & =15{e}^{5x} \\\\ (1+5x-5x)\\alpha {e}^{5x} & =15{e}^{5x} \\\\ \\alpha {e}^{5x} & =15{e}^{5x} \\\\ \\alpha  & =15.\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=15x{e}^{5x}.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{5x}+15x{e}^{5x}.\n$$\n\nWe can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}A+0 & =1 \\\\ A & =1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny={e}^{5x}+15x{e}^{5x}.\n$$"} :step/id #uuid "c64f98e2-0858-55ea-8d34-04c204a10d14" :step/next {:db/id #edb/ref 17592186420167}}] :activity/title "Solving First-Order Linear ODEs With Exponential Forcing" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420159}] [{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186167722} :activity/id #uuid "775b7c3e-3e96-5ea8-a95f-883523a63b42" :activity/scope {:db/id #edb/ref 17592186049423 :topic/id #uuid "f3e0d484-510c-5c15-beb2-bef21881c55b" :topic/math-academy-id 3235} :activity/steps [{:db/id #edb/ref 17592186167722 :step/content {:db/id #edb/ref 17592186168109 :tutorial/content "Suppose that a particle $P$ moves along the $x$-axis with acceleration $a(t),$ velocity $v(t)$ and displacement $x(t),$ where $t$ is the time. If we want to calculate the acceleration of $P,$ we use the relationship \n\n$$\na(t) = \\dfrac{\\textrm d v}{\\textrm d t}.\n$$\n\nSimilarly, if we know the acceleration and we want to find the velocity, we use the relationship\n\n$$\nv(t) = \\int a(t)\\,\\textrm d t.\n$$\n\nIn both of these relationships, we require $a$ and $v$ to be expressed as functions of $t.$ \n\nNow suppose that we're given the acceleration as a function of the displacement $x.$ How do we calculate the velocity in this case?\n\nFor example, suppose that the acceleration of a particle is given by $a(x) = 4x\\,\\textrm{m/s}^2.$ A sketch of the situation is shown below.\n\n![](images/01/017463f3ac8abac9c2b00c4d9a715a4109a5f4bc1b070e0a12c4d3a7bac64351.png)\n\nSince the acceleration of the particle $P$ equals $4x,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} = 4x.\n$$\n\nUsing the chain rule for differentiation, we can rewrite the left-hand side of this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=4x.\\end{aligned}\n$$\n\nNow, since $v= \\dfrac{\\textrm{d}x}{\\textrm{d}t}$ by definition, we have\n\n$$\nv \\dfrac{\\textrm{d}v}{\\textrm{d}x} = 4x.\\qquad \\qquad (\\ast)\n$$\n\nAlso, by the chain rule for differentiation, we have\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(v^2) = 2v\\dfrac{\\textrm d v}{\\textrm d x}\n\\quad\\Longrightarrow\\quad \n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = v\\dfrac{\\textrm d v}{\\textrm d x}.\n$$\n\nTherefore, we can write the differential equation $(\\ast)$ as\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = 4x.\n$$\n\nBy solving this differential equation, we can find an expression for the velocity $v$ in terms of displacement $x.$\n\nLet's see another example." :tutorial/id #uuid "291c6fee-a1ab-554d-b0b8-5508bd23eb2e" :tutorial/math-academy-id 5369 :tutorial/title "Introduction"} :step/id #uuid "af56a6fb-d731-5179-b8b7-de268aeb13f2" :step/math-academy-id 33520 :step/next {:db/id #edb/ref 17592186167727}} {:db/id #edb/ref 17592186167727 :step/content {:db/id #edb/ref 17592186166853 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166705 :question/id #uuid "e8353dba-48d7-5f4f-8ba5-97e4e22b6e44" :question/math-academy-id "e-9050"} :knowledge-point/id #uuid "25214773-e6cb-5663-95fe-a04408844902" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048746} {:db/id #edb/ref 17592186050901} {:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186167067} {:db/id #edb/ref 17592186167071} {:db/id #edb/ref 17592186256598} {:db/id #edb/ref 17592186256600} {:db/id #edb/ref 17592186256601} {:db/id #edb/ref 17592186256602} {:db/id #edb/ref 17592186256604} {:db/id #edb/ref 17592186256606} {:db/id #edb/ref 17592186256608} {:db/id #edb/ref 17592186367191} {:db/id #edb/ref 17592186378470}] :knowledge-point/title "Finding a Differential Equation That Relates the Velocity and Displacement of a Particle"} :step/id #uuid "ea23ed7c-763e-54fa-af53-bdcd85190355" :step/math-academy-id 33782 :step/next {:db/id #edb/ref 17592186167728}} {:db/id #edb/ref 17592186167728 :step/content {:db/id #edb/ref 17592186166854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166706 :question/id #uuid "49e02115-6211-564b-8221-d5835a98a064" :question/math-academy-id "e-9051"} :knowledge-point/id #uuid "1320d414-11eb-58a9-b59f-a6f760e87578" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050905}] :knowledge-point/questions [{:db/id #edb/ref 17592186167068} {:db/id #edb/ref 17592186167069} {:db/id #edb/ref 17592186256612} {:db/id #edb/ref 17592186256613} {:db/id #edb/ref 17592186256614} {:db/id #edb/ref 17592186256615} {:db/id #edb/ref 17592186256616} {:db/id #edb/ref 17592186256617} {:db/id #edb/ref 17592186256620} {:db/id #edb/ref 17592186256621} {:db/id #edb/ref 17592186256622} {:db/id #edb/ref 17592186382971}] :knowledge-point/title "Solving a Differential Equation That Relates the Velocity and Displacement of a Particle"} :step/id #uuid "87d6c80e-5ac1-5210-accd-0df7f165185b" :step/math-academy-id 33783 :step/next {:db/id #edb/ref 17592186167746}} {:db/id #edb/ref 17592186167746 :step/content {:db/id #edb/ref 17592186166862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166715 :question/id #uuid "80b653d0-5dff-5621-86ee-e1fd336ad740" :question/math-academy-id "e-9455"} :knowledge-point/id #uuid "550bb33b-c427-5667-977d-56ff8c6b458e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048282}] :knowledge-point/questions [{:db/id #edb/ref 17592186167070} {:db/id #edb/ref 17592186167089} {:db/id #edb/ref 17592186256603} {:db/id #edb/ref 17592186256605} {:db/id #edb/ref 17592186256607} {:db/id #edb/ref 17592186256609} {:db/id #edb/ref 17592186256610} {:db/id #edb/ref 17592186256618} {:db/id #edb/ref 17592186256619} {:db/id #edb/ref 17592186256623} {:db/id #edb/ref 17592186256625} {:db/id #edb/ref 17592186400058}] :knowledge-point/title "Calculating the Displacement of a Particle as a Function of Time"} :step/id #uuid "2a283e70-969e-5e03-8f63-5c695f48086d" :step/math-academy-id 35398}] :activity/title "Velocity and Acceleration as Functions of Displacement" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167007}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420431} :activity/id #uuid "058e9265-ff9b-5baf-8f41-85e7c7868e51" :activity/scope {:db/id #edb/ref 17592186049423 :topic/id #uuid "f3e0d484-510c-5c15-beb2-bef21881c55b" :topic/math-academy-id 3235} :activity/steps [{:db/id #edb/ref 17592186420429 :step/content {:db/id #edb/ref 17592186256625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39825938-ad5f-5161-82be-a58bd1817a1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)={e}^{-2t}" :db/id #edb/ref 17592186254173} {:answer/id #uuid "8ee5c0c6-750e-5668-bdc0-064e5c9b4f07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=4\\operatorname{ln}⁡(2t+1)-1" :db/id #edb/ref 17592186254925} {:answer/id #uuid "a5170868-e27c-5ec2-bb54-083bfe57da02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=2{e}^{-2t}-1" :db/id #edb/ref 17592186255126} {:answer/id #uuid "dcd96b2d-0804-5239-be68-eadc7bae04bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=2\\operatorname{ln}⁡(2t+1)+1" :db/id #edb/ref 17592186255629} {:answer/id #uuid "e85d341b-3675-5698-9153-635f1bc811e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\operatorname{ln}⁡(t+1)+1" :db/id #edb/ref 17592186255710}] :answer-field/correct {:db/id #edb/ref 17592186255629} :answer-field/id #uuid "795c6c90-3b12-5b40-b826-7991e61fdee3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256144}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ac389cb5-50b0-5d9d-9387-c7be6e7524a6" :question/math-academy-id "q-122352" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin $O$ is $x\\,\\text{m},$ the magnitude of its acceleration is $8{e}^{1-x}\\,{m/s}^{2}$ and is directed toward $O.$ Initially, $P$ is at $x=1\\,m$ and has velocity $v=4\\,m/s.$ Find $x$ as a function of time $t.$" :question/worked-solution "![](images/f0/f08c9d1e8dce3c0ae7c37719cadc3fc60bf5de3030ce8c44ca7528a98f3abf7e.png)\n\nSince the acceleration of the particle $P$ has magnitude $8{e}^{1-x}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-8{e}^{1-x}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-8{e}^{1-x}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -8{e}^{1-x}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8{e}^{1-x}+K.\\end{aligned}\n$$\n\nNow, since $v=4\\,m/s$ when $x=1\\,m,$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8{e}^{1-x}+K \\\\ \\frac{1}{2}(4)^{2} & =8{e}^{0}+K \\\\ 8 & =8+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =8{e}^{1-x} \\\\ {v}^{2} & =16{e}^{1-x} \\\\ v & =\\pm 4{e}^{(1-x)/2}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=4{e}^{(1-x)/2}.\n$$\n\nNow, we know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=4{e}^{(1-x)/2}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =4{e}^{(1-x)/2} \\\\ \\frac{1}{{e}^{(1-x)/2}}\\frac{\\text{d}x}{\\text{d}t} & =4 \\\\ \\int {e}^{(x-1)/2}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 4\\,\\text{d}t \\\\ \\int {e}^{(x-1)/2}\\text{d}x & =\\int 4\\,\\text{d}t \\\\ 2{e}^{(x-1)/2} & =4t+{C}_{1} \\\\ {e}^{(x-1)/2} & =2t+C\\end{aligned}\n$$\n\nwhere $C=\\frac{{C}_{1}}{2}.$ \n\nWe're given that $x=1$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\n{e}^{(x-1)/2}=2t+1.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}{e}^{(x-1)/2} & =2t+1 \\\\ \\frac{x-1}{2} & =\\operatorname{ln}⁡(2t+1) \\\\ x-1 & =2\\operatorname{ln}⁡(2t+1) \\\\ x & =2\\operatorname{ln}⁡(2t+1)+1.\\end{aligned}\n$$"} :step/id #uuid "03c63cb6-dfb8-5730-962f-2e6452481748"} {:db/id #edb/ref 17592186420430 :step/content {:db/id #edb/ref 17592186256613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016a3368-f9d5-58aa-ab05-aad63edb1b18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)={x}^{2}+x+2" :db/id #edb/ref 17592186253680} {:answer/id #uuid "1e97ff28-e0bb-54b7-b8b3-9417ec6fd261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=\\sqrt{2({x}^{2}+x+6)}" :db/id #edb/ref 17592186253929} {:answer/id #uuid "2371f7e7-c2e4-57e1-bd77-d71c072ed039" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=2\\sqrt{{x}^{2}+x+2}" :db/id #edb/ref 17592186253988} {:answer/id #uuid "bb5e00e1-832f-5f55-83f9-b8c48153a1c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=\\frac{4}{3}\\sqrt{{x}^{2}+2x+6}" :db/id #edb/ref 17592186255339} {:answer/id #uuid "fbf76d94-8303-5033-a055-32483b709927" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)={x}^{2}+3x" :db/id #edb/ref 17592186255884}] :answer-field/correct {:db/id #edb/ref 17592186253929} :answer-field/id #uuid "7a51decc-a151-5408-9864-1176626e3665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256148}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4bd8ece4-afaf-5640-9ad2-c2e8ef66ae37" :question/math-academy-id "q-122338" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x.$ When the displacement of $P$ from the origin $O$ is $x\\,m,$ its velocity is $v\\,m/s$ and its acceleration is $(2x+1)\\,{m/s}^{2}.$ If $P$ has a displacement of $1\\,m$ when its velocity is $4\\,m/s,$ find $v$ in terms of $x.$" :question/worked-solution "![](images/98/983beaf02582c5ebaee129e28bba657eb2db5e4da7f74eb4b8eba73b9083a259.png)\n\nSince the acceleration of the particle $P$ is $(2x+1)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=2x+1.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=2x+1.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (2x+1)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}={x}^{2}+x+C.\n$$\n\nNow, since $x=1\\,\\text{m}$ when $v=4\\,\\text{m/s},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={x}^{2}+x+C \\\\ \\frac{1}{2}(4)^{2} & ={1}^{2}+1+C \\\\ 8 & =2+C \\\\ C & =6\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={x}^{2}+x+6 \\\\ {v}^{2} & =2({x}^{2}+x+6) \\\\ v & =\\pm \\sqrt{2({x}^{2}+x+6)}.\\end{aligned}\n$$\n\nFinally, since the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{2({x}^{2}+x+6)}.\n$$"} :step/id #uuid "5b4469a6-0f97-5a60-8a7e-bd0dcb2520b2" :step/next {:db/id #edb/ref 17592186420433}} {:db/id #edb/ref 17592186420431 :step/content {:db/id #edb/ref 17592186256608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a314d43-645b-5c09-84cc-babb825962d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}}{\\text{d}x}({v}^{3})=2{x}^{4}" :db/id #edb/ref 17592186253749} {:answer/id #uuid "399960c6-8915-55cf-b499-430d9554395e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=2{x}^{4}" :db/id #edb/ref 17592186254174} {:answer/id #uuid "ab9f49c1-1e43-5f1b-aef8-2b18efec441e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}}{\\text{d}x}(2{v}^{2})=2{x}^{4}" :db/id #edb/ref 17592186255187} {:answer/id #uuid "c08c3b51-5261-57f3-8880-d02902e00fe5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{v}^{2})=2{x}^{4}" :db/id #edb/ref 17592186255385} {:answer/id #uuid "cbeb2a0e-c3b9-59b0-8c51-5cca3ce4d472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{v}^{3})=2{x}^{4}" :db/id #edb/ref 17592186255481}] :answer-field/correct {:db/id #edb/ref 17592186254174} :answer-field/id #uuid "ae42a556-6e64-58a1-9826-bc4a1d962a7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256237}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f3eb3e3-8dee-5051-9c40-8fe59ac84fa9" :question/math-academy-id "q-122319" :question/problem "A particle $P$ moves along the $x$-axis. When the displacement of $P$ from the origin $O$ is $x$ meters, its velocity is $v\\,m/s$ and its acceleration is $2{x}^{4}\\,{m/s}^{2}.$ Which differential equation describes this motion?" :question/worked-solution "![](images/b2/b23ef6e4df05874a715271c578dfa57d5ddacabef2d0801edc4e736c7de66e17.png)\n\nSince the acceleration of the particle $P$ is $2{x}^{4}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=2{x}^{4}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=2{x}^{4}.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=2{x}^{4}.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=2{x}^{4}.\n$$"} :step/id #uuid "798abf0e-ceda-5e61-8354-4bf0a2e66635" :step/next {:db/id #edb/ref 17592186420430}} {:db/id #edb/ref 17592186420432 :step/content {:db/id #edb/ref 17592186256623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4364ff09-2922-52f1-bb5f-e67a3ba34a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\sqrt[3]{12t+8}-2" :db/id #edb/ref 17592186254246} {:answer/id #uuid "5b2164e7-b48b-5848-83ea-558ab8d57139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\sqrt[3]{2t+1}-1" :db/id #edb/ref 17592186254476} {:answer/id #uuid "5cc028c3-519a-5570-a621-cd76222813f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=(12t-1)^{3}+1" :db/id #edb/ref 17592186254492} {:answer/id #uuid "da22387e-a7bf-5ddb-9d10-96871c121ede" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\sqrt[3]{t-8}+2" :db/id #edb/ref 17592186255605} {:answer/id #uuid "fd4a3bfe-c5a0-5f5f-b52c-5d5d734cceb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=(3t+2)^{3}-8" :db/id #edb/ref 17592186255897}] :answer-field/correct {:db/id #edb/ref 17592186254246} :answer-field/id #uuid "f893dcb4-30ee-50df-9369-932bd543c3cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256358}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec791f70-e6b1-5d28-9a5c-0e20d98d3307" :question/math-academy-id "q-122349" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin $O$ is $x\\,\\text{m},$ the magnitude of its acceleration is $\\frac{32}{(x+2)^{5}}\\,{m/s}^{2}$ and is directed toward $O.$ Initially, $P$ is at the origin $O$ and has velocity $v=1\\,m/s.$ Find $x$ as a function of time $t.$" :question/worked-solution "![](images/14/141c6dd6c91841238298b86fac1063c76faeb7cd103e13d2723f6ac05ed58f50.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\frac{32}{(x+2)^{5}}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\frac{32}{(x+2)^{5}}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-\\frac{32}{(x+2)^{5}}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -\\frac{32}{(x+2)^{5}}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K.\\end{aligned}\n$$\n\nNow, since $v=1\\,\\text{m/s}$ when $x=0\\,\\text{m},$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K \\\\ \\frac{1}{2}(1)^{2} & =\\frac{8}{(0+2)^{4}}+K \\\\ \\frac{1}{2} & =\\frac{1}{2}+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}} \\\\ {v}^{2} & =\\frac{16}{(x+2)^{4}} \\\\ v & =\\pm \\frac{4}{(x+2)^{2}}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=\\frac{4}{(x+2)^{2}}.\n$$\n\nNow, we know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{4}{(x+2)^{2}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{4}{(x+2)^{2}} \\\\ (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t} & =4 \\\\ \\int (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 4\\,\\text{d}t \\\\ \\int (x+2)^{2}\\text{d}x & =\\int 4\\,\\text{d}t \\\\ \\frac{1}{3}(x+2)^{3} & =4t+{C}_{1} \\\\ (x+2)^{3} & =12t+C\\end{aligned}\n$$\n\nwhere $C=3{C}_{1}.$ \n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=8,$ and the particular solution is\n\n$$\n(x+2)^{3}=12t+8.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}(x+2)^{3} & =12t+8 \\\\ x+2 & =\\sqrt[3]{12t+8} \\\\ x & =\\sqrt[3]{12t+8}-2.\\end{aligned}\n$$"} :step/id #uuid "a1a065d0-24c6-5622-ba75-1f337d376e40" :step/next {:db/id #edb/ref 17592186420429}} {:db/id #edb/ref 17592186420433 :step/content {:db/id #edb/ref 17592186256616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55e5f7fd-5f39-54d0-b24b-d6386ba4b120" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)={2}^{3-x}" :db/id #edb/ref 17592186254422} {:answer/id #uuid "7715943a-4b29-5731-aa1b-21b6a9f5bcda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)={2}^{1-x}+3" :db/id #edb/ref 17592186254725} {:answer/id #uuid "7a7f8494-68d3-5ece-b55e-5a21d83663af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=2\\sqrt{3\\cdot {2}^{1-x}+1}" :db/id #edb/ref 17592186254759} {:answer/id #uuid "bbaa6296-4ac5-5e74-907b-e485c987c549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=2\\sqrt{{2}^{1-x}+3}" :db/id #edb/ref 17592186255345} {:answer/id #uuid "cfa68c5c-78bd-533d-9a2b-0493c8ac2f7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v(x)=\\frac{4}{3}\\sqrt{{2}^{3-x}+5}" :db/id #edb/ref 17592186255520}] :answer-field/correct {:db/id #edb/ref 17592186255345} :answer-field/id #uuid "6837870e-c4ce-53d3-8d92-89b9b7c8217b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256116}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9efcc68b-3929-5bf9-ab56-4c19b9a57740" :question/math-academy-id "q-122341" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x>0.$ When the displacement of $P$ from the origin $O$ is $x\\,m,$ its velocity is $v\\,m/s,$ the magnitude of its acceleration is ${2}^{2-x}\\operatorname{ln}⁡2\\,{m/s}^{2}$ and the acceleration is directed toward $O.$ If $P$ has a displacement of $1\\,m$ when its velocity is $4\\,m/s,$ find $v$ in terms of $x.$" :question/worked-solution "![](images/6d/6ddbfef68a0b41a6ee3f11c46ff7821f7ff0dc23a16b4244b5e7a1f6579d7dd2.png)\n\nSince the acceleration of the particle $P$ has magnitude ${2}^{2-x}\\operatorname{ln}⁡2\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-{2}^{2-x}\\operatorname{ln}⁡2.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-{2}^{2-x}\\operatorname{ln}⁡2.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (-{2}^{2-x}\\operatorname{ln}⁡2)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}={2}^{2-x}+C.\n$$\n\nNow, since $x=1\\,\\text{m}$ when $v=4\\,\\text{m/s},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={2}^{2-x}+C \\\\ \\frac{1}{2}(4)^{2} & ={2}^{2-1}+C \\\\ 8 & =2+C \\\\ C & =6\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={2}^{2-x}+6 \\\\ {v}^{2} & ={2}^{3-x}+12 \\\\ {v}^{2} & =4({2}^{1-x}+3) \\\\ v & =\\pm 2\\sqrt{{2}^{1-x}+3}.\\end{aligned}\n$$\n\nFinally, since the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=2\\sqrt{{2}^{1-x}+3}.\n$$"} :step/id #uuid "c5db5cd4-2409-5a4a-be21-19989f057f9b" :step/next {:db/id #edb/ref 17592186420432}}] :activity/title "Velocity and Acceleration as Functions of Displacement" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420428}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186437149} :activity/id #uuid "feee590a-367b-57bd-af52-b43897192919" :activity/scope {:db/id #edb/ref 17592186049423 :topic/id #uuid "f3e0d484-510c-5c15-beb2-bef21881c55b" :topic/math-academy-id 3235} :activity/steps [{:db/id #edb/ref 17592186437146 :step/content {:db/id #edb/ref 17592186256621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8658c0bb-cfd4-5142-bbcb-e4097359b029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.7\\,\\text{m/s}" :db/id #edb/ref 17592186254860} {:answer/id #uuid "9dc47ff9-abd8-5a14-858a-de531e040383" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.9\\,\\text{m/s}" :db/id #edb/ref 17592186255056} {:answer/id #uuid "b5ad6d9c-592b-5e0c-8122-d62c500c3d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.8\\,\\text{m/s}" :db/id #edb/ref 17592186255273} {:answer/id #uuid "b9989186-dace-584b-b203-97a637274263" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3.1\\,\\text{m/s}" :db/id #edb/ref 17592186255322} {:answer/id #uuid "dd0cc1f7-7a63-5b1c-a0d5-346590852e30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.3\\,\\text{m/s}" :db/id #edb/ref 17592186255630}] :answer-field/correct {:db/id #edb/ref 17592186255322} :answer-field/id #uuid "fcd66982-5b26-55ef-acff-14d539285859" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256362}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8d544f0e-e224-5a8f-b2d9-7d23deb9a689" :question/math-academy-id "q-122347" :question/problem "A particle $P$ moves along the $x$-axis in the direction of decreasing $x$ where $x>0.$ When the displacement of $P$ from $O$ is $x\\,m,$ its velocity is $v\\,m/s,$ the magnitude of its acceleration is ${3}^{1-x}\\operatorname{ln}⁡3\\,{m/s}^{2}$ and the acceleration is directed toward $O.$ If $v=-2\\sqrt{2}\\,m/s$ when $x=2\\,\\text{m},$ find the velocity of $P$ when $x=1\\,\\text{m}.$ Round your answer to one decimal place." :question/worked-solution "![](images/3c/3c5450b18c5dc58b082faadf4086b6a21c0c9b55afb016090147609a2ccfe719.png)\n\nSince the magnitude of the acceleration of the particle $P$ is ${3}^{1-x}\\operatorname{ln}⁡3\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-{3}^{1-x}\\operatorname{ln}⁡3.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-{3}^{1-x}\\operatorname{ln}⁡3.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x & =\\int [-{3}^{1-x}\\operatorname{ln}⁡3]\\,\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}={3}^{1-x}+C.\n$$\n\nNow, since $v=-2\\sqrt{2}\\,m/s$ when $x=2\\,\\text{m},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(-2\\sqrt{2})^{2} & ={3}^{1-2}+C \\\\ 4 & =\\frac{1}{3}+C \\\\ C & =\\frac{11}{3}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={3}^{1-x}+\\frac{11}{3} \\\\ {v}^{2} & =2({3}^{1-x}+\\frac{11}{3}) \\\\ v & =\\pm \\sqrt{2({3}^{1-x}+\\frac{11}{3})}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of decreasing $x,$ we have that $v(x)<0,$ so we can discard the positive square root. Therefore,\n\n$$\nv=-\\sqrt{2({3}^{1-x}+\\frac{11}{3})}.\n$$\n\nFinally, the velocity of $P$ at $x=1$ is given by\n\n$$\n\\begin{aligned}v & =-\\sqrt{2({3}^{1-1}+\\frac{11}{3})} \\\\  & =-\\sqrt{\\frac{28}{3}} \\\\  & ≈-3.1\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to one decimal place."} :step/id #uuid "a96f26a1-150f-53aa-92db-8203a5d7c383"} {:db/id #edb/ref 17592186437147 :step/content {:db/id #edb/ref 17592186256600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5b2eeb-074d-51bf-9b3f-10803e274c41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{v}^{2}\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x+1}" :db/id #edb/ref 17592186253770} {:answer/id #uuid "56351265-a52c-5206-885d-fa5dfeb276eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x+1}" :db/id #edb/ref 17592186254428} {:answer/id #uuid "afa87942-4e3f-5a55-ae5f-5d22dd94cb53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2v\\frac{\\text{d}v}{\\text{d}x}=-\\frac{1}{x+1}" :db/id #edb/ref 17592186255214} {:answer/id #uuid "d4b91cfd-f727-572e-865c-a94f7aba262d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}^{2}\\frac{\\text{d}v}{\\text{d}x}=-\\frac{1}{x+1}" :db/id #edb/ref 17592186255559} {:answer/id #uuid "e6bf1029-4403-54dd-a55a-c9e8275e658a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=-\\frac{1}{x+1}" :db/id #edb/ref 17592186255702}] :answer-field/correct {:db/id #edb/ref 17592186255702} :answer-field/id #uuid "b673d4fe-7d5a-50cb-99f3-481a645a95f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256249}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2aa7557-417c-5f06-bca6-b63a94c74ba4" :question/math-academy-id "q-122307" :question/problem "A particle $P$ moves along the $x$-axis where $x>0.$ When the displacement of $P$ from the origin $O$ is $x$ meters, its velocity is $v\\,m/s$ and the magnitude of its acceleration is $\\frac{1}{x+1}\\,{m/s}^{2}.$ Given that the acceleration is directed toward $O,$ which differential equation describes this motion?" :question/worked-solution "![](images/47/473a3f91d91351499d5849ee07a86cfcfc2b257949d6ebba68b3261201f2bf68.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\frac{1}{x+1}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\frac{1}{x+1}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-\\frac{1}{x+1}.\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we obtain the differential equation\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=-\\frac{1}{x+1}.\n$$"} :step/id #uuid "d63723b3-39af-5ef2-8a04-28cdc6c2794d" :step/next {:db/id #edb/ref 17592186437148}} {:db/id #edb/ref 17592186437148 :step/content {:db/id #edb/ref 17592186256601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08989d71-d44c-554a-bce5-f49fba344fb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}={cos}^{2}⁡x" :db/id #edb/ref 17592186253732} {:answer/id #uuid "485c6662-97ec-5254-8bb7-1d15dbc744b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}v\\frac{\\text{d}v}{\\text{d}x}={cos}^{2}⁡x" :db/id #edb/ref 17592186254291} {:answer/id #uuid "d23b0337-7b09-5e9a-8cfa-fce6700a9517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x" :db/id #edb/ref 17592186255544} {:answer/id #uuid "eac5aa36-49a3-5648-998f-1f48c9122a73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4v\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x" :db/id #edb/ref 17592186255726} {:answer/id #uuid "edac6096-b0c5-5959-8d95-58a0e84227a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x" :db/id #edb/ref 17592186255747}] :answer-field/correct {:db/id #edb/ref 17592186255544} :answer-field/id #uuid "4cd69269-dfc3-5489-a6f7-c96d7e0ca756" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "226fe9ff-a963-5e5f-900b-474a261bf3ef" :question/math-academy-id "q-122310" :question/problem "A particle $P$ moves along the $x$-axis where $x>0.$ When the displacement of $P$ from the origin $O$ is $x$ meters, its velocity is $v\\,m/s$ and its acceleration is ${cos}^{2}⁡x\\,{m/s}^{2}.$ Given that the acceleration is directed toward $O,$ which differential equation describes this motion?" :question/worked-solution "![](images/76/768db6b8051d8f4bea528f6c5b5d386ffc0d6529517d2fe72641cb33f6e8ac10.png)\n\nSince the acceleration of the particle $P$ is ${cos}^{2}⁡x$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-{cos}^{2}⁡x.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-{cos}^{2}⁡x.\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we obtain the differential equation\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x.\n$$"} :step/id #uuid "dac6231b-7098-5146-a02c-d7abae0838f2" :step/next {:db/id #edb/ref 17592186437150}} {:db/id #edb/ref 17592186437149 :step/content {:db/id #edb/ref 17592186167089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ebf18ee-af52-58eb-9db4-f851658ecd7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\operatorname{ln}⁡(1+t)" :db/id #edb/ref 17592186253931} {:answer/id #uuid "1f068fc2-f6b1-5e9e-af2b-751b98bcdc5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=2\\operatorname{ln}⁡(1+t)" :db/id #edb/ref 17592186253936} {:answer/id #uuid "49f209c9-1626-5df5-aefb-bdf07e8a5715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{2}t" :db/id #edb/ref 17592186254305} {:answer/id #uuid "de5cdbb3-0dd8-544a-8444-7a6932630c5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=1-{e}^{t}" :db/id #edb/ref 17592186255642} {:answer/id #uuid "e35e425f-e29f-5937-be75-0ebb5ff34e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)={e}^{t}-1" :db/id #edb/ref 17592186255683}] :answer-field/correct {:db/id #edb/ref 17592186255683} :answer-field/id #uuid "877a8eaf-76c0-5b50-a12d-6f6b23536812" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186256174}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8488fc53-7024-5b0e-acc8-a7217b9f9e03" :question/math-academy-id "q-122170" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x.$ When the displacement of $P$ from the origin $O$ is $x$ meters, the velocity is given by $v(x)=(1+x)\\,m/s.$ Initially, $P$ is at the origin $O.$ Find $x$ as a function of time $t.$" :question/worked-solution "![](images/a8/a8a6f49ead700bee856b1bbdbb10848eac0a57609da14e3967916a36eb56f048.png)\n\nWe're given that the velocity function $v(x)$ is\n\n$$\nv(x)=1+x.\n$$\n\nWe know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=1+x.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =1+x \\\\ \\frac{1}{1+x}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int \\frac{1}{1+x}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int \\frac{1}{1+x}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\operatorname{ln}⁡|1+x| & =t+K \\\\ 1+x & =C{e}^{t} \\\\ x & =C{e}^{t}-1\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\nx(t)={e}^{t}-1.\n$$"} :step/id #uuid "f9140de0-2c2b-50c8-a7e7-ea66ba1fa4cb" :step/next {:db/id #edb/ref 17592186437147}} {:db/id #edb/ref 17592186437150 :step/content {:db/id #edb/ref 17592186256617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032c1aed-5869-5996-b874-ec60376b4b7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.8\\,\\text{m/s}" :db/id #edb/ref 17592186253693} {:answer/id #uuid "3c64d957-8cab-5c68-a933-ebb3da3c2a75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.9\\,\\text{m/s}" :db/id #edb/ref 17592186254193} {:answer/id #uuid "484acfee-7a2b-52bf-a78b-d62f355b27df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.3\\,\\text{m/s}" :db/id #edb/ref 17592186254288} {:answer/id #uuid "caa5dc97-9ff5-56d3-816d-361c1ad73349" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.3\\,\\text{m/s}" :db/id #edb/ref 17592186255472} {:answer/id #uuid "d91174a7-6095-546d-814c-2cd0e4c8e550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.6\\,\\text{m/s}" :db/id #edb/ref 17592186255593}] :answer-field/correct {:db/id #edb/ref 17592186253693} :answer-field/id #uuid "0641e0bb-3057-51af-9319-471e1e0b8f5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186255926}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a56f0b7-8350-56d0-8d3b-b2d932d38f5b" :question/math-academy-id "q-122343" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x,$ away from a fixed origin $O.$ When the displacement of $P$ from $O$ is $x\\,m,$ its velocity is $v\\,m/s$ and its acceleration is ${e}^{x/2}\\,{m/s}^{2}.$ If $v=\\sqrt{5}\\,m/s$ when $x=0\\,\\text{m},$ find the velocity of $P$ when $x=1\\,\\text{m}.$ Round your answer to one decimal place." :question/worked-solution "![](images/0d/0dd98b517e2ed800f12a3672d2d6f45021f7f502cfe98c1e9308e52c05ab5f38.png)\n\nSince the acceleration of the particle $P$ is ${e}^{x/2}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}={e}^{x/2}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})={e}^{x/2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x & =\\int {e}^{x/2}\\,\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=2{e}^{x/2}+C.\n$$\n\nNow, since  $v=\\sqrt{5}\\,m/s$ when $x=0\\,\\text{m},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(\\sqrt{5})^{2} & =2{e}^{0/2}+C \\\\ \\frac{5}{2} & =2+C \\\\ C & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =2{e}^{x/2}+\\frac{1}{2} \\\\ {v}^{2} & =4{e}^{x/2}+1 \\\\ v & =\\pm \\sqrt{4{e}^{x/2}+1}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv=\\sqrt{4{e}^{x/2}+1}.\n$$\n\nFinally, the velocity of $P$ at $x=1$ is given by\n\n$$\n\\begin{aligned}v & =\\sqrt{4{e}^{1/2}+1} \\\\ v & =\\sqrt{4\\sqrt{e}+1} \\\\  & ≈2.8\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to one decimal place."} :step/id #uuid "f9498a14-80ad-5194-bc2c-7090bc99b1db" :step/next {:db/id #edb/ref 17592186437146}}] :activity/title "Velocity and Acceleration as Functions of Displacement" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186437145}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186134811} :activity/id #uuid "1faaba32-288c-58f7-9e8b-36ad43309761" :activity/scope {:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131} :activity/steps [{:db/id #edb/ref 17592186134811 :step/content {:db/id #edb/ref 17592186135102 :tutorial/content "Suppose that $\\mathbf F$ is a vector field on $\\mathbb R^2,$ expressed in terms of its component functions as\n\n$$\n\\mathbf F(x,y) = P(x,y)\\,\\mathbf i + Q(x,y)\\,\\mathbf j.\n$$\n\nIf the first partial derivatives of $P$ and $Q$ exist, then the **divergence** of $\\mathbf F,$ denoted $\\textrm{div}\\,\\mathbf F,$ is the scalar given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y}.\n$$\n\nNotice that if we define the differential operator $\\nabla$ (a.k.a. the \"del\" operator) as \n\n$$\n\\nabla =  \\mathbf i\\,\\dfrac{\\partial }{\\partial x} +  \\mathbf j\\,\\dfrac{\\partial }{\\partial y},\n$$\n\n \n\nthen the divergence of $\\mathbf F$ is given by the dot product\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla \\cdot \\mathbf F.\n$$\n\nFor example, suppose that the vector field $\\mathbf F$ is given by\n\n$$\n\\mathbf F(x,y) = 2xy\\, \\mathbf i + e^{yx} \\, \\mathbf j .\n$$\n\nThen, we can calculate $\\textrm{div}\\,\\mathbf{F}$ using the dot product formula, as follows:\n\n$$\n\\begin{aligned}\\text{div}\\,F & =∇\\cdot F \\\\  & =(i\\,\\frac{∂}{∂x}+j\\,\\frac{∂}{∂y})\\cdot (2xy\\,i+{e}^{yx}\\,j) \\\\  & =\\frac{∂}{∂x}(2xy)+\\frac{∂}{∂y}({e}^{yx}) \\\\  & =2y+x{e}^{yx}\\end{aligned}\n$$" :tutorial/id #uuid "086f12c3-0ab5-54ed-8b4e-5c70e8c7c7e5" :tutorial/math-academy-id 5116 :tutorial/title "Introduction"} :step/id #uuid "5c2a161a-d267-5999-8795-ba9baba0146f" :step/math-academy-id 32111 :step/next {:db/id #edb/ref 17592186134849}} {:db/id #edb/ref 17592186134822 :step/content {:db/id #edb/ref 17592186133876 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133692 :question/id #uuid "78e7cbb2-d207-5d5e-bf46-5c3b2686933f" :question/math-academy-id "e-8740"} :knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707} {:db/id #edb/ref 17592186048954}] :knowledge-point/questions [{:db/id #edb/ref 17592186134066} {:db/id #edb/ref 17592186134368} {:db/id #edb/ref 17592186235522} {:db/id #edb/ref 17592186235529} {:db/id #edb/ref 17592186241078} {:db/id #edb/ref 17592186259485} {:db/id #edb/ref 17592186266054} {:db/id #edb/ref 17592186266055} {:db/id #edb/ref 17592186362533} {:db/id #edb/ref 17592186383034} {:db/id #edb/ref 17592186383244} {:db/id #edb/ref 17592186383251} {:db/id #edb/ref 17592186424226} {:db/id #edb/ref 17592186424229}] :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"} :step/id #uuid "5d2f80d4-10e2-5fdc-b52f-7b5cadac99d2" :step/math-academy-id 32553 :step/next {:db/id #edb/ref 17592186134844}} {:db/id #edb/ref 17592186134826 :step/content {:db/id #edb/ref 17592186133880 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133696 :question/id #uuid "ac6e7a2c-19a3-595a-ba46-f38c653a9bec" :question/math-academy-id "e-8927"} :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048917}] :knowledge-point/questions [{:db/id #edb/ref 17592186134061} {:db/id #edb/ref 17592186134067} {:db/id #edb/ref 17592186240974} {:db/id #edb/ref 17592186241079} {:db/id #edb/ref 17592186241080} {:db/id #edb/ref 17592186241081} {:db/id #edb/ref 17592186241082} {:db/id #edb/ref 17592186259500} {:db/id #edb/ref 17592186266062} {:db/id #edb/ref 17592186266063} {:db/id #edb/ref 17592186382826} {:db/id #edb/ref 17592186407631} {:db/id #edb/ref 17592186424227} {:db/id #edb/ref 17592186424228} {:db/id #edb/ref 17592186483360} {:db/id #edb/ref 17592186483395}] :knowledge-point/title "Interpreting Divergence"} :step/id #uuid "eb39b82a-9c43-56ff-9c10-70ad9f735fab" :step/math-academy-id 33322} {:db/id #edb/ref 17592186134842 :step/content {:db/id #edb/ref 17592186135114 :tutorial/content "Our goal now is to develop an intuitive understanding of what the divergence of a vector field measures.\n\nConsider the vector field $\\mathbf F(x,y)$ and the point $S,$ shown below. Imagine that this vector field represents the velocity field of a stream of flowing water. \n\n![](images/a7/a785c84976242d699af11ab2203600e2007e95e35b60665ba9882c8f0f25bce3.png)\n\n \n\nWe can see from our diagram that $S$ acts like a **source**. You can think of this as an open faucet, pushing water onto the plane and away from itself. \n\nSince $S$ acts like a source, $\\textrm{div}\\,\\mathbf F$ is nonzero. By convention, if a point $S$ acts like a source, the divergence is positive:\n\n$$\n\\textrm{div}\\,\\mathbf F > 0\n$$\n\nIn this particular case, *every* point in our vector field acts as a source. So $\\textrm{div}\\,\\mathbf F > 0$ everywhere.\n\nIf we reverse the situation, we get the following:\n\n![](images/b4/b4c923bbde36568e4e2f36f7d388622a520d0799d558049f72d0194e0bd679f7.png)\n\n \n\nWe can see from our diagram that $T$ acts like a **sink**. You can think of this as an open plughole that sucks in the surrounding water.\n\nSince $T$ acts like a sink, $\\textrm{div}\\,\\mathbf F$ is also nonzero. By convention, if a point $T$ acts like a sink, the divergence is negative:\n\n$$\n\\textrm{div}\\,\\mathbf F < 0\n$$\n\nEvery point in our vector field acts like a sink in this case. So $\\textrm{div}\\,\\mathbf F < 0$ everywhere.\n\nFinally, note that if $\\textrm{div}\\,\\mathbf F = 0$ everywhere in the domain of some vector field $\\mathbf F,$ we say that $\\mathbf F$ is **solenoidal.**" :tutorial/id #uuid "a2cdf73b-116c-5cf4-a5a2-a8c95e447127" :tutorial/math-academy-id 5518 :tutorial/title "Physical Interpretation of Divergence"} :step/id #uuid "6a9298c4-106a-569c-bd0b-5d24d3e71b0f" :step/math-academy-id 34359 :step/next {:db/id #edb/ref 17592186134848}} {:db/id #edb/ref 17592186134844 :step/content {:db/id #edb/ref 17592186133889 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133705 :question/id #uuid "3cbc5b4a-dde4-59b0-bc34-08c4d8776e0e" :question/math-academy-id "e-9489"} :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/questions [{:db/id #edb/ref 17592186134065} {:db/id #edb/ref 17592186134369} {:db/id #edb/ref 17592186235535} {:db/id #edb/ref 17592186259486} {:db/id #edb/ref 17592186259487} {:db/id #edb/ref 17592186259490} {:db/id #edb/ref 17592186266056} {:db/id #edb/ref 17592186266057} {:db/id #edb/ref 17592186266058} {:db/id #edb/ref 17592186362524} {:db/id #edb/ref 17592186383041} {:db/id #edb/ref 17592186385415} {:db/id #edb/ref 17592186407632} {:db/id #edb/ref 17592186424230} {:db/id #edb/ref 17592186436933} {:db/id #edb/ref 17592186436934} {:db/id #edb/ref 17592186483377}] :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"} :step/id #uuid "77b5a013-eab6-50c3-9f63-2a51f2e967b2" :step/math-academy-id 35525 :step/next {:db/id #edb/ref 17592186134842}} {:db/id #edb/ref 17592186134848 :step/content {:db/id #edb/ref 17592186135120 :tutorial/content "The following two vector fields behave either as a source or a sink. Therefore, they both have divergence.\n\n![](images/93/939efa85ebfe4805a27595b60a797b8a3435075590ee77f7a18d04bd76d91f1a.png)\n\nThe following vector fields are solenoidal (i.e., they each have zero divergence).\n\n![](images/ed/edb2f908fa78439bf985b5754c9fcc5968c21926dbe124297b67af046a9f70a3.png)" :tutorial/id #uuid "ddbe7ae2-caaf-5436-b1c7-aabc0eec115d" :tutorial/math-academy-id 5793 :tutorial/title "Examples of Vector Field With Divergence and Solenoidal Vector Fields"} :step/id #uuid "88b27d23-7358-51e8-9457-a8b063ed5a52" :step/math-academy-id 35536 :step/next {:db/id #edb/ref 17592186134826}} {:db/id #edb/ref 17592186134849 :step/content {:db/id #edb/ref 17592186135121 :tutorial/content "There are a few things we should note about the divergence:\n\n- We can only compute the divergence of a *vector* field, and a vector field's divergence is a *scalar* field. So if $G(x,y) = \\textrm{div}\\,\\mathbf F,$ then we have the following map:\n\n$$\n\\underbrace{\\,\\,\\,\\mathbf F(x,y)\\,\\,\\,}_{\\textrm{vector field}} \\mapsto\\underbrace{\\,\\,\\,G(x,y)\\,\\,\\,}_{\\textrm{scalar field}}\n$$\n\nIn contrast, if $f(x,y)$ is a scalar field, then the statement $\\textrm{div}\\, f$ has no meaning.\n\n- We can easily extend the notion of divergence to three dimensions. So, if $\\mathbf F(x,y,z) = P\\,\\mathbf i + Q\\,\\mathbf j + R\\,\\mathbf k,$ then $\\textrm{div}\\,\\mathbf F$ is given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla\\cdot \\mathbf F = \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} + \\dfrac{\\partial R}{\\partial z},\n$$\n\nwhere the three-dimensional differential operator $\\nabla$ is given by\n\n$$\n\\nabla =  \\mathbf i\\,\\dfrac{\\partial }{\\partial x} +  \\mathbf j\\,\\dfrac{\\partial }{\\partial y} + \\mathbf k\\,\\dfrac{\\partial }{\\partial z}.\n$$\n\n- The divergence of a vector field at a point $P$ gives us helpful information about the tendency of the vector field to behave like a source or a sink at $P.$ We'll describe this in more detail shortly." :tutorial/id #uuid "9b8de083-51c2-581b-ad36-a773dca8af05" :tutorial/math-academy-id 5794 :tutorial/title "Some Important Notes About the Divergence of a Vector Field"} :step/id #uuid "e856caa2-317e-5779-b004-597af558a506" :step/math-academy-id 35537 :step/next {:db/id #edb/ref 17592186134822}}] :activity/title "The Divergence of a Vector Field" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134010}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186407634} :activity/id #uuid "23bb149c-27d7-5070-88b1-a3124f094ad2" :activity/scope {:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131} :activity/steps [{:db/id #edb/ref 17592186407633 :step/content {:db/id #edb/ref 17592186407632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e054f8-7842-51d9-944e-506f086c64ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\pi " :db/id #edb/ref 17592186407614} {:answer/id #uuid "30bd69d5-9aed-5f53-bd57-88c0d8b71e93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186407615} {:answer/id #uuid "951b5e1a-06b7-5f54-b81b-2e7935528e41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\pi " :db/id #edb/ref 17592186407621} {:answer/id #uuid "b2537554-7ead-5776-b7ea-b0a5c6ea2d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-\\pi " :db/id #edb/ref 17592186407622} {:answer/id #uuid "de576d13-a320-57ea-81fe-65cb1f522e77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+\\pi " :db/id #edb/ref 17592186407625}] :answer-field/correct {:db/id #edb/ref 17592186407614} :answer-field/id #uuid "55f12593-79dd-5e1b-8574-a974a94bfc5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407628}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f48c368c-417f-5ffe-9791-056b549ac545" :question/math-academy-id "q-105559" :question/problem "Consider the vector field $F=\\operatorname{cos}⁡\\pi x\\,i+y\\operatorname{sin}⁡\\pi y\\,j+{e}^{2z}\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(0,1,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡\\pi x)+\\frac{∂}{∂y}(y\\operatorname{sin}⁡\\pi y)+\\frac{∂}{∂z}({e}^{2z}) \\\\  & =-\\pi \\operatorname{sin}⁡\\pi x+\\operatorname{sin}⁡\\pi y+\\pi y\\operatorname{cos}⁡\\pi y+2{e}^{2z}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(0,1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(0,1,0) & =-\\pi \\operatorname{sin}⁡(0)+\\operatorname{sin}⁡(\\pi )+\\pi \\operatorname{cos}⁡(\\pi )+2{e}^{0} \\\\  & =0+0-\\pi +2 \\\\  & =2-\\pi .\\end{aligned}\n$$"} :step/id #uuid "1d73206f-cfb2-5389-b819-954a52ec5c0a" :step/next {:db/id #edb/ref 17592186407635}} {:db/id #edb/ref 17592186407634 :step/content {:db/id #edb/ref 17592186134065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c79d74f-4409-57e4-b361-e941cc41aa8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x}-\\operatorname{cos}⁡x+3y{z}^{2}" :db/id #edb/ref 17592186407618} {:answer/id #uuid "941fb884-9dbd-5e6e-bdb3-9c13326a2f3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x}+\\operatorname{sin}⁡x+3y{z}^{2}" :db/id #edb/ref 17592186407620} {:answer/id #uuid "d9966256-2b26-5637-969d-ec652f55ff58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{xy}-\\operatorname{cos}⁡x+{z}^{3}" :db/id #edb/ref 17592186407624} {:answer/id #uuid "ec0916bb-4bf2-5bfb-8625-f74c2a28d4bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{xy}\\,i-\\operatorname{cos}⁡x\\,j+{z}^{3}\\,k" :db/id #edb/ref 17592186407626} {:answer/id #uuid "eecb625e-fb38-58c5-8c7d-425f0374e2c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{y}\\,i-\\operatorname{sin}⁡x\\,j+3y{z}^{2}\\,k" :db/id #edb/ref 17592186407627}] :answer-field/correct {:db/id #edb/ref 17592186407618} :answer-field/id #uuid "fafbd1ee-fb02-5785-b3f4-4426b308c48e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186407630}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "db7680f4-57f3-5a1a-a81a-52c92b75f829" :question/math-academy-id "q-105555" :question/problem "Consider the vector field $F=\\operatorname{ln}⁡(xy)\\,i-y\\operatorname{cos}⁡x\\,j+y{z}^{3}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))+\\frac{∂}{∂y}(-y\\operatorname{cos}⁡x)+\\frac{∂}{∂z}(y{z}^{3}) \\\\  & =\\frac{1}{x}-\\operatorname{cos}⁡x+3y{z}^{2}.\\end{aligned}\n$$"} :step/id #uuid "43f42226-1025-58c1-878e-7c4041f020a2" :step/next {:db/id #edb/ref 17592186407633}} {:db/id #edb/ref 17592186407635 :step/content {:db/id #edb/ref 17592186407631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "755d214e-8d2a-5a21-b9cf-f0df0ddc65e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437406} {:answer/id #uuid "3bfd0671-10c2-5e45-a69d-18a97c5bcb8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437407}] :answer-field/correct {:db/id #edb/ref 17592186437406} :answer-field/id #uuid "08fca85a-8f3f-5d04-ba2b-523fc3575ba4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438732} {:answer-field/choices [{:answer/id #uuid "e6d7a93e-05d3-5b4e-a10d-309d06525f6d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437408} {:answer/id #uuid "cee06875-116c-5488-b531-455a557b12b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437409}] :answer-field/correct {:db/id #edb/ref 17592186437408} :answer-field/id #uuid "77753f43-8be4-5002-8a52-0b36dbebd616" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438733} {:answer-field/choices [{:answer/id #uuid "0919152f-4318-5ee5-ab9e-853f1a97e081" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437410} {:answer/id #uuid "8cd97fc8-8c06-56b4-a75e-62d1a96d9ce0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437411}] :answer-field/correct {:db/id #edb/ref 17592186437411} :answer-field/id #uuid "5b9e3e64-ecdb-5c87-af06-d417e36b04d6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438734} {:answer-field/choices [{:answer/id #uuid "98360c07-0eb0-5614-8178-f21e14480fa7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437412} {:answer/id #uuid "4b7d8c5d-3f07-50af-a145-77ac2e6077ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437413}] :answer-field/correct {:db/id #edb/ref 17592186437412} :answer-field/id #uuid "2a0366b6-425d-5c79-b027-f2d81a491b79" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438735}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2847820b-e13e-563d-bfbb-bab640514e5b" :question/math-academy-id "q-105572" :question/problem "![](images/58/584016c88e5916984e181118d52caab95dba1fd0d861e0fd248a4e023d1b07da.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vectors decrease as we move horizontally and vertically towards the origin. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "84dd7364-713d-5340-9f9c-2da553617182"}] :activity/title "The Divergence of a Vector Field" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407612}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186436937} :activity/id #uuid "b0b7ba59-d2e5-5c0e-aa1c-0c290b8b930c" :activity/scope {:db/id #edb/ref 17592186049459 :topic/id #uuid "f6fd4776-56f0-5112-9cdc-83e344004d93" :topic/math-academy-id 2131} :activity/steps [{:db/id #edb/ref 17592186436935 :step/content {:db/id #edb/ref 17592186424227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05739988-eeed-5afd-a445-e1dc677cc92e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437840} {:answer/id #uuid "5bf029c1-b1a8-5a8b-a676-cd13b44e113b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437841}] :answer-field/correct {:db/id #edb/ref 17592186437840} :answer-field/id #uuid "e4d7c78f-dac2-5b80-9554-1e05a93f2f93" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438949} {:answer-field/choices [{:answer/id #uuid "fe246435-fd14-59a9-9160-df256f6ffb82" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437842} {:answer/id #uuid "ff59cb0e-83ac-53c9-bb11-897ad674049d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437843}] :answer-field/correct {:db/id #edb/ref 17592186437843} :answer-field/id #uuid "b39164a9-c699-5980-8ef6-6758528f95e7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438950} {:answer-field/choices [{:answer/id #uuid "1885359c-b7e4-5e24-b124-f8d267e8840f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437844} {:answer/id #uuid "cccdf236-c391-54e1-b0dc-8e77683dd03d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437845}] :answer-field/correct {:db/id #edb/ref 17592186437844} :answer-field/id #uuid "96047e81-3269-5f84-bfb2-854075b3c2f8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438951} {:answer-field/choices [{:answer/id #uuid "c977abab-50be-5c44-961a-335884131fa8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437846} {:answer/id #uuid "209c01dc-3c0e-5ef6-b90f-25c2ce076ee0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437847}] :answer-field/correct {:db/id #edb/ref 17592186437846} :answer-field/id #uuid "9ffbe2f7-9aa4-5310-9d23-ad54db885413" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438952}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5777673f-cba1-5775-ae01-f18d4531f239" :question/math-academy-id "q-131195" :question/problem "![](images/39/39dfec02c787141d8a728381f4093dfe9cbf3fdbf996177ba6f24d973015dc5f.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $∇\\cdot F=0$\n\n- **II.** $∇\\cdot F>0$\n\n- **III.** $∇\\cdot F<0$\n\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vector's $y$-components increase as we move vertically away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "0c687dc8-83c3-51c4-b6a7-2402b933a9ce" :step/next {:db/id #edb/ref 17592186436939}} {:db/id #edb/ref 17592186436936 :step/content {:db/id #edb/ref 17592186241080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3758688-c398-5563-9ef4-6725bb756a4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437422} {:answer/id #uuid "20c2906c-786b-5d44-a2ab-80b29dc77300" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437423}] :answer-field/correct {:db/id #edb/ref 17592186437423} :answer-field/id #uuid "19f46c09-a764-5deb-8de8-68af7432ea43" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438740} {:answer-field/choices [{:answer/id #uuid "cc20a89d-06eb-52ee-876e-878056126986" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437424} {:answer/id #uuid "af5eb708-473f-56c4-b243-76dd14db4f29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437425}] :answer-field/correct {:db/id #edb/ref 17592186437424} :answer-field/id #uuid "72a39fa9-d231-5fb4-8edd-c467842038cf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438741} {:answer-field/choices [{:answer/id #uuid "15199d6a-677b-53ea-8492-a7aa4a7eb581" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437426} {:answer/id #uuid "19d090b2-e9f5-5f83-9d51-046d10ff6235" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437427}] :answer-field/correct {:db/id #edb/ref 17592186437426} :answer-field/id #uuid "d5999586-c6a2-5268-a3ec-230c0f2be240" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438742} {:answer-field/choices [{:answer/id #uuid "4882a295-c5c0-51e1-926e-f95e716e654e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437428} {:answer/id #uuid "9067697b-3c5f-57eb-bc0d-1edcb637afcf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437429}] :answer-field/correct {:db/id #edb/ref 17592186437429} :answer-field/id #uuid "564a4db5-ce17-5a9f-8f0c-cf41329af0c2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438743}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d2172851-a396-51c3-bd4e-4e1278b37143" :question/math-academy-id "q-105575" :question/problem "![](images/11/11d38951b884f17616a61403d793322d0e2ea28910e806fe8f018251508352a1.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $∇\\cdot F=0$\n\n- **II.** $∇\\cdot F>0$\n\n- **III.** $∇\\cdot F<0$\n\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""} :step/id #uuid "0eb2dca7-e256-5a91-aeab-a6e0be87d07f" :step/next {:db/id #edb/ref 17592186436938}} {:db/id #edb/ref 17592186436937 :step/content {:db/id #edb/ref 17592186436933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a914c9-ac5b-510b-8770-498ebbd342d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "yz+3{y}^{2}{x}^{2}+{z}^{2}" :db/id #edb/ref 17592186436921} {:answer/id #uuid "88e03628-9e8e-5879-9ede-a96902f3797a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3yz+3{y}^{2}{x}^{2}" :db/id #edb/ref 17592186436926} {:answer/id #uuid "9a07bd93-8453-5012-b970-faf3a1a28f2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3yz+2{y}^{3}x" :db/id #edb/ref 17592186436927} {:answer/id #uuid "a8d3d9a8-1c50-5ad8-967c-67a2b8bdc976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xyz+3{y}^{2}{x}^{2}+2yz" :db/id #edb/ref 17592186436928} {:answer/id #uuid "d674ed52-351d-5f4a-9c10-e0caa107251f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4yz+2{y}^{3}x" :db/id #edb/ref 17592186436930}] :answer-field/correct {:db/id #edb/ref 17592186436926} :answer-field/id #uuid "69e44755-6b9a-5cca-b1ed-0c837e17c6d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "22c40f40-e4e5-529d-a83f-3f46f140c8db" :question/math-academy-id "q-105557" :question/problem "Consider the vector field $F=xyz\\,i+{y}^{3}{x}^{2}\\,j+y{z}^{2}\\,k.$ \nFind $\\text{div}\\,F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{div}F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(xyz)+\\frac{∂}{∂y}({y}^{3}{x}^{2})+\\frac{∂}{∂z}(y{z}^{2}) \\\\  & =yz+3{y}^{2}{x}^{2}+2yz \\\\  & =3yz+3{y}^{2}{x}^{2}\\end{aligned}\n$$"} :step/id #uuid "6a7d78a0-8d6d-590f-8d8a-84c35fdbd7e4" :step/next {:db/id #edb/ref 17592186436936}} {:db/id #edb/ref 17592186436938 :step/content {:db/id #edb/ref 17592186436934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ab80cc-c857-5dfb-9a3a-cfdfd3d6fc0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{e}^{2x}" :db/id #edb/ref 17592186436922} {:answer/id #uuid "335bd84d-490e-5a69-979b-a11b772a9908" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{2x}" :db/id #edb/ref 17592186436923} {:answer/id #uuid "36f39977-9420-5792-a25e-40ed825c033a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186436924} {:answer/id #uuid "78e9e533-d5f7-5054-82d6-9d333edf1c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2x}(1+y+z)" :db/id #edb/ref 17592186436925} {:answer/id #uuid "af0cee1b-58b3-5b9b-a7e7-5c521761b047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2x}(2-y-z)" :db/id #edb/ref 17592186436929}] :answer-field/correct {:db/id #edb/ref 17592186436924} :answer-field/id #uuid "cbf3222d-f787-5312-b008-17567e5ae0c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436932}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "36837fe3-6724-5929-9249-1bb3cf0a5e7f" :question/math-academy-id "q-131175" :question/problem "Consider the vector field $F={e}^{2x}\\,i-y{e}^{2x}\\,j-z{e}^{2x}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}({e}^{2x})+\\frac{∂}{∂y}(-y{e}^{2x})+\\frac{∂}{∂z}(-z{e}^{2x}) \\\\  & =2{e}^{2x}-{e}^{2x}-{e}^{2x} \\\\  & =0.\\end{aligned}\n$$"} :step/id #uuid "af33c61a-5271-559b-9054-88db8d041045" :step/next {:db/id #edb/ref 17592186436935}} {:db/id #edb/ref 17592186436939 :step/content {:db/id #edb/ref 17592186424228 :question/answe