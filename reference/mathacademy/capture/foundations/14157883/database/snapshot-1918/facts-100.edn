#{[17592186133876 #edb/ref 1037 #edb/ref 17592186048707 #edb/ref 17592186045417] [17592186133876 #edb/ref 1037 #edb/ref 17592186048954 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186134066 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186134368 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186235522 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186235529 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186241078 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186259485 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186266054 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186266055 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186362533 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186383034 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186383244 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186383251 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186424226 #edb/ref 17592186045417] [17592186133876 #edb/ref 1038 #edb/ref 17592186424229 #edb/ref 17592186045417] [17592186133876 #edb/ref 1039 "Finding the Divergence of a Vector Field in Two Dimensions" #edb/ref 17592186045417] [17592186133876 #edb/ref 1041 #edb/ref 17592186133692 #edb/ref 17592186045417] [17592186133876 #edb/ref 1042 #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" #edb/ref 17592186045417] [17592186133880 #edb/ref 1037 #edb/ref 17592186048917 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186134061 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186134067 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186240974 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186241079 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186241080 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186241081 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186241082 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186259500 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186266062 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186266063 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186382826 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186407631 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186424227 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186424228 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186483360 #edb/ref 17592186045417] [17592186133880 #edb/ref 1038 #edb/ref 17592186483395 #edb/ref 17592186045417] [17592186133880 #edb/ref 1039 "Interpreting Divergence" #edb/ref 17592186045417] [17592186133880 #edb/ref 1041 #edb/ref 17592186133696 #edb/ref 17592186045417] [17592186133880 #edb/ref 1042 #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186134065 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186134369 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186235535 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186259486 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186259487 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186259490 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186266056 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186266057 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186266058 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 17592186362524 #edb/ref 17592186045417] [17592186133889 #edb/ref 1038 #edb/ref 1759218