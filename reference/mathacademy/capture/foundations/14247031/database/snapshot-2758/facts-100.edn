i}{2}}\\int_{1}^{2}r^3\\,dr\\,d\\theta \\\\ &=5\\int_{0}^{\\frac{\\pi}{2}}\\left[\\frac{r^4}{4}\\right]_{1}^{2}\\,d\\theta \\\\ &=5\\int_{0}^{\\frac{\\pi}{2}}\\left(4-\\frac{1}{4}\\right)\\,d\\theta \\\\ &=5\\int_{0}^{\\frac{\\pi}{2}}\\frac{15}{4}\\,d\\theta \\\\ &=\\frac{75}{4}[\\theta]_{0}^{\\frac{\\pi}{2}} \\\\ &=\\frac{75}{4}\\left(\\frac{\\pi}{2}-0\\right) \\\\ &=\\frac{75 \\pi}{8}.\\end{aligned}\n$$\n\n" #edb/ref 17592186045443] [17592186562793 #edb/ref 1068 #edb/ref 17592186562772 #edb/ref 17592186045443] [17592186562793 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186562793 #edb/ref 1071 "![](images/9f/9f98c6d615262205474643c73e3d4b5bd8d94a8560d0ffbda34ad7aca362d1bd.png)\n\nEvaluate $\\oint_C(\\sqrt{x+1}-x^2y)\\,dx+(e^y+xy^2)\\,dy,$ where the path $C$ is shown above." #edb/ref 17592186045443] [17592186562793 #edb/ref 1072 #uuid "8f78c19f-91c3-570f-9d07-d78ab8ff655f" #edb/ref 17592186045443] [17592186562793 #edb/ref 1074 "Green's theorem states that\n\n$$\n\\oint_C P\\,dx+Q\\,dy=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/50/50aabd9d34ec0f889ca832e181e271e3e5918f936708684a125fadcdb1cdb71f.png)\n\nNow, since\n\n$$\nP(x,y)=\\sqrt{x+1}-x^2y,\\quad Q(x,y)=e^y+xy^2,\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\\frac{\\partial P}{\\partial y}=- x^{2},\\quad \\frac{\\partial Q}{\\partial x}=y^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}\\oint_C(\\sqrt{x+1}-x^2y)\\,dx+(e^y+xy^2)\\,dy&=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA \\\\ &=\\iint_D\\left(y^{2}-(- x^{2})\\right)\\,dA \\\\ &=\\iint_D (x^2+y^2)\\,dA.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\n\\Delta=\\{(r,\\theta):0\\le r\\le 4,0\\le\\theta\\le \\frac{\\pi}{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n\\iint_D f(x,y)\\,dA=\\iint_\\Delta f(r\\cos\\theta,r\\sin\\theta)\\,r\\,dr\\,d\\theta.\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}\\iint_D (x^2+y^2)\\,dA&=\\iint_\\Delta (r^2(\\cos^2\\theta+\\sin^2\\theta))\\,r\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{4}r^3(\\cos^2\\theta+\\sin^2\\theta)\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{4}r^3\\,dr\\,d\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\left[\\frac{r^4}{4}\\right]_{0}^{4}\\,d\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\left(64-0\\right)\\,d\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}64\\,d\\theta \\\\ &=64[\\theta]_{0}^{\\frac{\\pi}{2}} \\\\ &=64\\left(\\frac{\\pi}{2}-0\\right) \\\\ &=32 \\pi.\\end{aligned}\n$$\n\n" #edb/ref 17592186045443] [17592186562801 #edb/ref 1068 #edb/ref 17592186562769 #edb/ref 17592186045443] [17592186562801 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186562801 #edb/ref 1071 "Use Green's theorem to evaluate $\\oint_C(e^{-x^2}-x^2y)\\,dx+(y+xy^2)\\,dy,$ where $C$ is the counterclockwise boundary of the disk with polar description $0\\le r\\le 3,\\ 0\\le\\theta\\le2\\pi$." #edb/ref 17592186045443] [17592186562801 #edb/ref 1072 #uuid "ac95db02-2900-5a0e-a6b1-4da40e53b041" #edb/ref 17592186045443] [17592186562801 #edb/ref 1074 "Green's theorem states that\n\n$$\n\\oint_C P\\,dx+Q\\,dy=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/6f/6f7b5381fa7792a722e515878be7e2a964d85b9e7f5a17aa83b3983b7f2a7bf5.png)\n\nNow, since\n\n$$\nP(x,y)=e^{-x^2}-x^2y,\\quad Q(x,y)=y+xy^2,\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\\frac{\\partial P}{\\partial y}=- x^{2},\\quad \\frac{\\partial Q}{\\partial x}=y^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}\\oint_C(e^{-x^2}-x^2y)\\,dx+(y+xy^2)\\,dy&=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA \\\\ &=\\iint_D\\left(y^{2}-(- x^{2})\\right)\\,dA \\\\ &=\\iint_D (x^2+y^2)\\,dA.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\n\\Delta=\\{(r,\\theta):0\\le r\\le 3,0\\le\\theta\\le 2 \\pi\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n\\iint_D f(x,y)\\,dA=\\iint_\\Delta f(r\\cos\\theta,r\\sin\\theta)\\,r\\,dr\\,d\\theta.\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}\\iint_D (x^2+y^2)\\,dA&=\\iint_\\Delta (r^2(\\cos^2\\theta+\\sin^2\\theta))\\,r\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2 \\pi}\\int_{0}^{3}r^3(\\cos^2\\theta+\\sin^2\\theta)\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2 \\pi}\\int_{0}^{3}r^3\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2 \\pi}\\left[\\frac{r^4}{4}\\right]_{0}^{3}\\,d\\theta \\\\ &=\\int_{0}^{2 \\pi}\\left(\\frac{81}{4}-0\\right)\\,d\\theta \\\\ &=\\int_{0}^{2 \\pi}\\frac{81}{4}\\,d\\theta \\\\ &=\\frac{81}{4}[\\theta]_{0}^{2 \\pi} \\\\ &=\\frac{81}{4}\\left(2 \\pi-0\\right) \\\\ &=\\frac{81 \\pi}{2}.\\end{aligned}\n$$\n\n" #edb/ref 17592186045443] [17592186562805 #edb/ref 1068 #edb/ref 17592186562776 #edb/ref 17592186045443] [17592186562805 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186562805 #edb/ref 1071 "Use Green's theorem to evaluate $\\oint_C(e^{-x^2}-3x^2y)\\,dx+(y+3xy^2)\\,dy,$ where $C$ is the counterclockwise boundary of the disk with polar description $0\\le r\\le 3,\\ 0\\le\\theta\\le2\\pi$." #edb/ref 17592186045443] [17592186562805 #edb/ref 1072 #uuid "bfddd2c6-0361-5659-b47a-55d51d0fa39a" #edb/ref 17592186045443] [17592186562805 #edb/ref 1074 "Green's theorem states that\n\n$$\n\\oint_C P\\,dx+Q\\,dy=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA.\n$$\n\nIn our case, the region $D$ and its 