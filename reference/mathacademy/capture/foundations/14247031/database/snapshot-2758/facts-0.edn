5417] [17592186262247 #edb/ref 1075 #edb/ref 17592186260350 #edb/ref 17592186045417] [17592186262247 #edb/ref 1075 #edb/ref 17592186260779 #edb/ref 17592186045417] [17592186262247 #edb/ref 1075 #edb/ref 17592186261277 #edb/ref 17592186045417] [17592186262247 #edb/ref 1075 #edb/ref 17592186261467 #edb/ref 17592186045417] [17592186262247 #edb/ref 1075 #edb/ref 17592186262006 #edb/ref 17592186045417] [17592186262247 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262247 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262247 #edb/ref 1078 #edb/ref 17592186262006 #edb/ref 17592186045417] [17592186262247 #edb/ref 1079 #uuid "46d81e6d-01cf-501c-b61e-4c6039a60547" #edb/ref 17592186045417] [17592186262433 #edb/ref 1075 #edb/ref 17592186260059 #edb/ref 17592186045417] [17592186262433 #edb/ref 1075 #edb/ref 17592186260363 #edb/ref 17592186045417] [17592186262433 #edb/ref 1075 #edb/ref 17592186261238 #edb/ref 17592186045417] [17592186262433 #edb/ref 1075 #edb/ref 17592186261314 #edb/ref 17592186045417] [17592186262433 #edb/ref 1075 #edb/ref 17592186261931 #edb/ref 17592186045417] [17592186262433 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262433 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262433 #edb/ref 1078 #edb/ref 17592186260059 #edb/ref 17592186045417] [17592186262433 #edb/ref 1079 #uuid "abcd46d2-644b-54bb-992b-feba4db98108" #edb/ref 17592186045417] [17592186262636 #edb/ref 1068 #edb/ref 17592186262135 #edb/ref 17592186045417] [17592186262636 #edb/ref 1069 "q-126710" #edb/ref 17592186045417] [17592186262636 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186262636 #edb/ref 1071 "![](images/83/831b2131cf134ec21def0014a3121429ded4cd3afd98dfd1660b1e78c1a9ba93.png)\n\nConsider the path $C$ shown above. Given that $F(x,y)=⟨y(x+1),\\,x(y+1)⟩,$ which of the following is equivalent to ${∮}_{C}F\\cdot dr\\,?$" #edb/ref 17592186045417] [17592186262636 #edb/ref 1072 #uuid "bfc83011-612b-5b59-8833-f11d956fe6a7" #edb/ref 17592186045417] [17592186262636 #edb/ref 1074 "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/d8/d8cd55f88d614bdb49aee6eaa0ff9d1d56f6f597cd892ee199a0130b53954b5b.png)\n\nSince $P(x,y)=y(x+1)$ and $Q(x,y)=x(y+1),$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x+1,\\,\\frac{∂Q}{∂x}=y+1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(y+1-(x+1))\\,\\text{d}A \\\\  & ={∬}_{D}(y-x)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}}.\n$$\n\nThe change of variables formula for plane polar coordinates states that  \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(y-x)\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta -r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\,{\\int }_{0}^{3}{r}^{2}(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186262641 #edb/ref 1068 #edb/ref 17592186262247 #edb/ref 17592186045417] [17592186262641 #edb/ref 1069 "q-126736" #edb/ref 17592186045417] [17592186262641 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186262641 #edb/ref 1071 "Use Green's theorem to evaluate ${∮}_{C}F\\cdot dr,$ where $F(x,y)=⟨\\operatorname{sin}⁡x-2{x}^{2}y,\\text{ }\\,\\sqrt{y+3}+2x{y}^{2}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=1,$ oriented counterclockwise." #edb/ref 17592186045417] [17592186262641 #edb/ref 1072 #uuid "388e817a-4cb8-54d8-b3b7-fede3e086b1c" #edb/ref 17592186045417] [17592186262641 #edb/ref 1074 "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/90/902790a00a049bbfc759403125ad5f19a8c2528a46b59c721ac43fb137cd5d8e.png)\n\nNow, since \n\n$$\nP(x,y)=\\operatorname{sin}⁡x-2{x}^{2}y,\\,Q(x,y)=\\sqrt{y+3}+2x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2{x}^{2},\\,\\frac{∂Q}{∂x}=2{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2{y}^{2}-(-2{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }[\\frac{{r}^{4}}{4}]_{0}^{1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\frac{1}{4}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186262650 #edb/ref 1068 #edb/ref 17592186262433 #edb/ref 17592186045417] [17592186262650 #edb/ref 1069 "q-126758" #edb/ref 17592186045417] [17592186262650 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186262650 #edb/ref 1071 "![](images/bc/bcdc0f59fa284c2b1f1621e7de057ef6f0e084d2eca6732fbc5eae3f74ede113.png)\n\nEvaluate ${∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+3x{y}^{2})\\,dy,$ where the path $C$ is shown above." #edb/ref 17592186045417] [17592186262650 #edb/ref 1072 #uuid "5041cff1-c6ce-564b-b2c4-39a44d615f75" #edb/ref 17592186045417] [17592186262650 #edb/ref 1074 "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/62/6273034b38059d3d49b2a29c91052c290151b4a29073f1c925172dd1c4c2bf72.png)\n\nNow, since \n\n$$\nP(x,y)=\\sqrt{5+x}-3{x}^{2}y,\\,Q(x,y)={e}^{-{y}^{2}}+3x{y}^{2},\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-3{x}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{2}-(-3{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,2\\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{2}}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:  \n\n$$\n\\begin{aligned}{∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}3({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}3{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{[\\frac{{r}^{4}}{4}]}_{2}^{4}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}60\\,\\text{d}\\theta  \\\\  & =180[\\theta ]_{0}^{\\pi /2} \\\\  & =180\\cdot \\frac{\\pi }{2} \\\\  & =90\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186416074 #edb/ref 1080 "\\frac{3\\text{ }\\,\\pi }{2}" #edb/ref 17592186045417] [17592186416074 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186416074 #edb/ref 1083 #uuid "0cf2dceb-7c5d-5d9b-9403-414a88730866" #edb/ref 17592186045417] [17592186416083 #edb/ref 1080 "\\frac{729\\text{ }\\,\\pi }{2}" #edb/ref 17592186045417] [17592186416083 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186416083 #edb/ref 1083 #uuid "4f5d7b5b-5c88-5245-85a2-eb913d758a87" #edb/ref 17592186045417] [17592186416090 #edb/ref 1080 "\\frac{81\\text{ }\\,\\pi }{2}" #edb/ref 17592186045417] [17592186416090 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186416090 #edb/ref 1083 #uuid "96c867f3-7baa-5a33-8eba-e465e7463140" #edb/ref 17592186045417] [17592186416092 #edb/ref 1080 "\\frac{243\\text{ }\\,\\pi }{2}" #edb/ref 17592186045417] [17592186416092 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186416092 #edb/ref 1083 #uuid "990e60bc-7dbd-5a34-81df-2112a3293326" #edb/ref 17592186045417] [17592186416098 #edb/ref 1080 "\\frac{27\\text{ }\\,\\pi }{2}" #edb/ref 17592186045417] [17592186416098 #edb/ref 1082 #edb/ref 1759