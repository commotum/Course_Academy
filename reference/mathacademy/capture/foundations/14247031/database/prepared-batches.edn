1-3{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(1-3{y}^{2})\\,\\text{d}A & ={∬}_{Δ}(1-3\\cdot {r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}\\,{\\int }_{0}^{1}(1-3{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta .\\end{aligned}\n$$"] [17592186262636 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/d8/d8cd55f88d614bdb49aee6eaa0ff9d1d56f6f597cd892ee199a0130b53954b5b.png)\n\nSince $P(x,y)=y(x+1)$ and $Q(x,y)=x(y+1),$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x+1,\\,\\frac{∂Q}{∂x}=y+1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(y+1-(x+1))\\,\\text{d}A \\\\  & ={∬}_{D}(y-x)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that  \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(y-x)\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta -r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\,{\\int }_{0}^{3}{r}^{2}(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$"] [17592186262641 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/90/902790a00a049bbfc759403125ad5f19a8c2528a46b59c721ac43fb137cd5d8e.png)\n\nNow, since \n\n$$\nP(x,y)=\\operatorname{sin}⁡x-2{x}^{2}y,\\,Q(x,y)=\\sqrt{y+3}+2x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2{x}^{2},\\,\\frac{∂Q}{∂x}=2{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2{y}^{2}-(-2{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }[\\frac{{r}^{4}}{4}]_{0}^{1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\frac{1}{4}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\pi \\end{aligned}\n$$"] [17592186416110 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}({sin}^{3}⁡x-{y}^{3})\\,dx+({y}^{4}+{x}^{3})\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/e2/e218f4b6938b166aa6eacab02ce0276a4a863a0cfade8528816a54c2621b51e7.png)\n\nNow, since \n\n$$\nP(x,y)={sin}^{3}⁡x-{y}^{3},\\,Q(x,y)={y}^{4}+{x}^{3},\n$$\n\n we have that \n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-3{y}^{2},\\,\\frac{∂Q}{∂x}=3{x}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({sin}^{3}⁡x-{y}^{3})\\,dx+({y}^{4}+{x}^{3})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}-(-3{y}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}3({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }\\frac{81}{4}\\,\\text{d}\\theta  \\\\  & =\\frac{243}{4}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{243}{4}(2\\pi -0) \\\\  & =\\frac{243\\text{ }\\,\\pi }{2}.\\end{aligned}\n$$"] [17592186262650 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/62/6273034b38059d3d49b2a29c91052c290151b4a29073f1c925172dd1c4c2bf72.png)\n\nNow, since \n\n$$\nP(x,y)=\\sqrt{5+x}-3{x}^{2}y,\\,Q(x,y)={e}^{-{y}^{2}}+3x{y}^{2},\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-3{x}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{2}-(-3{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,2\\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:  \n\n$$\n\\begin{aligned}{∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}3({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}3{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{[\\frac{{r}^{4}}{4}]}_{2}^{4}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}60\\,\\text{d}\\theta  \\\\  & =180[\\theta ]_{0}^{\\pi /2} \\\\  & =180\\cdot \\frac{\\pi }{2} \\\\  & =90\\pi \\end{aligned}\n$$"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/id #uuid "29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2"] ["step-d38c598c-e6c8-596d-b5b1-344239cf7390" :step/id #uuid "d38c598c-e6c8-596d-b5b1-344239cf7390"] ["step-0d02eb78-b31f-5714-9473-a758d6d95bda" :step/id #uuid "0d02eb78-b31f-5714-9473-a758d6d95bda"] ["step-2081022a-bc13-504d-84ff-392ffcb85254" :step/id #uuid "2081022a-bc13-504d-84ff-392ffcb85254"] ["step-af0a8f06-6ad0-508f-9f03-0538665d492d" :step/id #uuid "af0a8f06-6ad0-508f-9f03-0538665d492d"] ["step-2c0549f0-8417-57bd-b711-92eea5341e9e" :step/id #uuid "2c0549f0-8417-57bd-b711-92eea5341e9e"] ["step-d38c598c-e6c8-596d-b5b1-344239cf7390" :step/content 17592186176313] ["step-d38c598c-e6c8-596d-b5b1-344239cf7390" :step/next "step-0d02eb78-b31f-5714-9473-a758d6d95bda"] ["step-0d02eb78-b31f-5714-9473-a758d6d95bda" :step/content 17592186262636] ["step-0d02eb78-b31f-5714-9473-a758d6d95bda" :step/next "step-2081022a-bc13-504d-84ff-392ffcb85254"] ["step-2081022a-bc13-504d-84ff-392ffcb85254" :step/content 17592186262641] ["step-2081022a-bc13-504d-84ff-392ffcb85254" :step/next "step-af0a8f06-6ad0-508f-9f03-0538665d492d"] ["step-af0a8f06-6ad0-508f-9f03-0538665d492d" :step/content 17592186416110] ["step-af0a8f06-6ad0-508f-9f03-0538665d492d" :step/next "step-2c0549f0-8417-57bd-b711-92eea5341e9e"] ["step-2c0549f0-8417-57bd-b711-92eea5341e9e" :step/content 17592186262650] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/title "Green's Theorem in Polar Coordinates"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/type :activity.type/review] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/scope 17592186050332] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/course 17592186046660] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/steps "step-d38c598c-e6c8-596d-b5b1-344239cf7390"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/steps "step-0d02eb78-b31f-5714-9473-a758d6d95bda"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/steps "step-2081022a-bc13-504d-84ff-392ffcb85254"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/steps "step-af0a8f06-6ad0-508f-9f03-0538665d492d"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/steps "step-2c0549f0-8417-57bd-b711-92eea5341e9e"] ["activity-29f8ac3d-ebae-5ec0-91bf-2c2d11fca1b2" :activity/first-step "step-d38c598c-e6c8-596d-b5b1-344239cf7390"]] "retractions" [[17592186176313 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}({x}^{2}\\operatorname{cos}⁡x+{y}^{3})\\,dx+(y{e}^{y+1}+x)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/3b/3b90abecc774b5ba5dcee19385fef38b14206d2c31c3b6cba38216bfa9957448.png)\n\nSince $P(x,y)={x}^{2}\\operatorname{cos}⁡x+{y}^{3}$ and $Q(x,y)=y{e}^{y+1}+x,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=3{y}^{2},\\,\\frac{∂Q}{∂x}=1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({x}^{2}\\operatorname{cos}⁡x+{y}^{3})\\,dx-(y{e}^{y+1}+x)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1-3{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2}}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(1-3{y}^{2})\\,\\text{d}A & ={∬}_{Δ}(1-3\\cdot {r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}\\,{\\int }_{0}^{1}(1-3{r}^{2}{sin}^{2}⁡\\theta )r\\,dr\\,d\\theta .\\end{aligned}\n$$"] [17592186262636 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/d8/d8cd55f88d614bdb49aee6eaa0ff9d1d56f6f597cd892ee199a0130b53954b5b.png)\n\nSince $P(x,y)=y(x+1)$ and $Q(x,y)=x(y+1),$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x+1,\\,\\frac{∂Q}{∂x}=y+1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}y(x+1)\\,dx+x(y+1)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(y+1-(x+1))\\,\\text{d}A \\\\  & ={∬}_{D}(y-x)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}}.\n$$\n\nThe change of variables formula for plane polar coordinates states that  \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(y-x)\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta -r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}\\,{\\int }_{0}^{3}{r}^{2}(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$"] [17592186262641 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/90/902790a00a049bbfc759403125ad5f19a8c2528a46b59c721ac43fb137cd5d8e.png)\n\nNow, since \n\n$$\nP(x,y)=\\operatorname{sin}⁡x-2{x}^{2}y,\\,Q(x,y)=\\sqrt{y+3}+2x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2{x}^{2},\\,\\frac{∂Q}{∂x}=2{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\operatorname{sin}⁡x-2{x}^{2}y)\\,dx+(\\sqrt{y+3}-2x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2{y}^{2}-(-2{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }[\\frac{{r}^{4}}{4}]_{0}^{1}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\frac{1}{4}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\pi \\end{aligned}\n$$"] [17592186416110 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}({sin}^{3}⁡x-{y}^{3})\\,dx+({y}^{4}+{x}^{3})\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/e2/e218f4b6938b166aa6eacab02ce0276a4a863a0cfade8528816a54c2621b51e7.png)\n\nNow, since \n\n$$\nP(x,y)={sin}^{3}⁡x-{y}^{3},\\,Q(x,y)={y}^{4}+{x}^{3},\n$$\n\n we have that \n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-3{y}^{2},\\,\\frac{∂Q}{∂x}=3{x}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({sin}^{3}⁡x-{y}^{3})\\,dx+({y}^{4}+{x}^{3})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}-(-3{y}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}3({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{2\\pi }\\frac{81}{4}\\,\\text{d}\\theta  \\\\  & =\\frac{243}{4}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{243}{4}(2\\pi -0) \\\\  & =\\frac{243\\text{ }\\,\\pi }{2}.\\end{aligned}\n$$"] [17592186262650 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/62/6273034b38059d3d49b2a29c91052c290151b4a29073f1c925172dd1c4c2bf72.png)\n\nNow, since \n\n$$\nP(x,y)=\\sqrt{5+x}-3{x}^{2}y,\\,Q(x,y)={e}^{-{y}^{2}}+3x{y}^{2},\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-3{x}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{2}-(-3{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,2\\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{2}}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:  \n\n$$\n\\begin{aligned}{∬}_{D}3({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}3({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}3{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{\\int }_{2}^{4}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}{[\\frac{{r}^{4}}{4}]}_{2}^{4}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}60\\,\\text{d}\\theta  \\\\  & =180[\\theta ]_{0}^{\\pi /2} \\\\  & =180\\cdot \\frac{\\pi }{2} \\\\  & =90\\pi \\end{aligned}\n$$"]]}]