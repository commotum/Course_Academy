#{[{:activity/first-step {:db/id #edb/ref 17592186125385} :activity/id #uuid "e7c42f54-2ba5-576a-b2e1-2db695e51ec2" :activity/scope {:db/id #edb/ref 17592186050996 :topic/id #uuid "7821b684-8118-5d42-9459-ebb20010e0ff" :topic/math-academy-id 1868} :activity/steps [{:db/id #edb/ref 17592186125385 :step/content {:db/id #edb/ref 17592186125778 :tutorial/content "We already learned that the rank of a matrix $A$ is the number of pivot columns in $A.$ Now, can we obtain any information from the *non-pivot* columns?\n\nThe answer is yes! The non-pivot columns help to find the dimension of the null space of a matrix $A,$ and here's how.\n\nConsider the matrix \n\n$$\n[\\begin{aligned}3 & 5 & 1 \\\\ 0 & 0 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nThe matrix $A$ is already in row echelon form, where the $1$st and the $3$rd columns are pivot columns, while the $2$nd one is a *non-pivot* column. Now, to get the null space of $A,$ we need to find the solution of the system\n\n$$\n{\\begin{aligned}3{x}_{1}+5{x}_{2}+{x}_{3}=0 \\\\ 2{x}_{3}=0 \\\\ 0=0\\end{aligned}\n$$\n\nwhere $\\color{blue}x_1$ and ${\\color{blue}x_3}$ are basic variables and $\\color{red}x_2$ is a free variable. Hence, we obtain that \n\n$$\n[\\begin{aligned}-\\frac{5}{3} \\\\ 1 \\\\ 0\\end{aligned}]\n$$\n\nis a basis of $\\textrm{Null}(A)$ and, therefore, $\\textrm{dim(Null}(A))={\\color{red}1}$.\n\nIn other words,\n\n> $\\textrm{dim(Null}(A))$ is equal to the number of *non-pivot* columns in the corresponding row echelon form of $A$\n\nor, equivalently,\n\n> $\\textrm{dim(Null}(A))$  is the number of *free variables* in the corresponding homogeneous system with the coefficient matrix $A.$" :tutorial/id #uuid "7c75fc81-c464-5eea-bb66-37258ca64cb5" :tutorial/math-academy-id 3520 :tutorial/title "Introduction"} :step/id #uuid "8764d6f6-efe5-555a-9b58-2ea9897c7843" :step/math-academy-id 19982 :step/next {:db/id #edb/ref 17592186125386}} {:db/id #edb/ref 17592186125386 :step/content {:db/id #edb/ref 17592186124508 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124317 :question/id #uuid "e1036a11-ebb3-594d-aba1-be259eb0596d" :question/math-academy-id "e-5419"} :knowledge-point/id #uuid "ce5ddb87-f7c0-5bda-8d6e-ac1728dd2f99" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048823} {:db/id #edb/ref 17592186049723}] :knowledge-point/questions [{:db/id #edb/ref 17592186124867} {:db/id #edb/ref 17592186125225} {:db/id #edb/ref 17592186271983} {:db/id #edb/ref 17592186271984} {:db/id #edb/ref 17592186348209} {:db/id #edb/ref 17592186348210}] :knowledge-point/title "Determining the Dimension of the Null Space of a Matrix Given the Number of Non-Pivot Columns"} :step/id #uuid "1781ce33-0951-5cf7-ba14-893c43247e6f" :step/math-academy-id 19983 :step/next {:db/id #edb/ref 17592186125387}} {:db/id #edb/ref 17592186125387 :step/content {:db/id #edb/ref 17592186124509 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124318 :question/id #uuid "4aa47a89-9f9b-55d8-ba01-a131b20e6c95" :question/math-academy-id "e-5421"} :knowledge-point/id #uuid "f020b27f-1cd4-550b-a83a-2afbb7e5db72" :knowledge-point/questions [{:db/id #edb/ref 17592186124868} {:db/id #edb/ref 17592186124877} {:db/id #edb/ref 17592186271986} {:db/id #edb/ref 17592186271987} {:db/id #edb/ref 17592186319314} {:db/id #edb/ref 17592186319352} {:db/id #edb/ref 17592186321072}] :knowledge-point/title "Identifying the Dimension of the Null Space of Matrices Using Inspection"} :step/id #uuid "32808740-b993-5939-9a08-6bc3eab6463c" :step/math-academy-id 19985 :step/next {:db/id #edb/ref 17592186125388}} {:db/id #edb/ref 17592186125388 :step/content {:db/id #edb/ref 17592186125779 :tutorial/content "The dimension of the null space of a matrix $A$ is often called the **nullity** of $A$. We will also use the following notation:\n\n$$\n\\textrm{nullity}(A) = \\textrm{dim}(\\textrm{Null}(A)).\n$$" :tutorial/id #uuid "e46fe003-9e24-5794-b139-5c2805d463c5" :tutorial/math-academy-id 3521 :tutorial/title "The Nullity of a Matrix"} :step/id #uuid "966d2e1c-4409-5d1b-996d-fad6a9c4d98c" :step/math-academy-id 19986 :step/next {:db/id #edb/ref 17592186125389}} {:db/id #edb/ref 17592186125389 :step/content {:db/id #edb/ref 17592186124510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124319 :question/id #uuid "42d77ab8-0670-55bf-8b99-68270c8e5f2e" :question/math-academy-id "e-5422"} :knowledge-point/id #uuid "f3a0e3b9-931a-52bd-9ed9-b8001c8de67b" :knowledge-point/questions [{:db/id #edb/ref 17592186124871} {:db/id #edb/ref 17592186124876} {:db/id #edb/ref 17592186271988} {:db/id #edb/ref 17592186271989} {:db/id #edb/ref 17592186319318} {:db/id #edb/ref 17592186319325} {:db/id #edb/ref 17592186321074} {:db/id #edb/ref 17592186321076} {:db/id #edb/ref 17592186321134}] :knowledge-point/title "Finding the Nullity of a Matrix Using Row Reduction"} :step/id #uuid "0b0649dd-72fb-5d4a-a416-f1ca94874689" :step/math-academy-id 19987}] :activity/title "The Dimension of the Null Space of a Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124684}]}
