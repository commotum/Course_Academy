      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14247909/observations/step-q148378-1030cf543a912e62531f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14247909/observations/step-q148378-1030cf543a912e62531f.png",
      "source_url": "https://mathacademy.com/tasks/14247909/topics/3050/lesson",
