      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14247909/observations/step-q148372-04f37b3f2c3040299bc7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14247909/observations/step-q148372-04f37b3f2c3040299bc7.png",
      "source_url": "https://mathacademy.com/tasks/14247909/topics/3050/lesson",
      "captured_at": 1792211808.81248,
      "math_academy_id": "q-148372",
