685a201a792a36ea2e2755c299063c61403087679442971.png)"} :step/id #uuid "07c058c1-979f-5403-be26-08111075c178" :step/next {:db/id #edb/ref 17592186418071}} {:db/id #edb/ref 17592186418068 :step/content {:db/id #edb/ref 17592186172664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52dbce36-54c0-52ac-b02a-1a0dcf5281a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460491} {:answer/id #uuid "cb0e4957-fb2d-57b1-b861-533d087a82b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460492}] :answer-field/correct {:db/id #edb/ref 17592186460492} :answer-field/id #uuid "fe217ebf-4848-5f37-8c0d-c9ae496feff3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461112} {:answer-field/choices [{:answer/id #uuid "5fbecd13-3f32-58ff-9467-3e1801e294d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460493} {:answer/id #uuid "c890c2fa-e9d2-51ca-a390-9aa83b1fc562" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460494}] :answer-field/correct {:db/id #edb/ref 17592186460493} :answer-field/id #uuid "3f46259a-2b3d-59cc-9c34-9e64833d4671" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461113} {:answer-field/choices [{:answer/id #uuid "06b8aa85-0093-5c39-abac-5bf89d8e8250" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460495} {:answer/id #uuid "ca6f33e4-2ca0-5a88-982f-7e1821cf61e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460496}] :answer-field/correct {:db/id #edb/ref 17592186460495} :answer-field/id #uuid "7549c5fb-20fb-5e7d-aa1b-eed9d174c291" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461114} {:answer-field/choices [{:answer/id #uuid "99e303cb-b333-5d78-baf4-fa7afce14413" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460497} {:answer/id #uuid "51e06db8-ecd9-5455-9232-796d3a182e0f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460498}] :answer-field/correct {:db/id #edb/ref 17592186460498} :answer-field/id #uuid "428af3e1-b497-5b2f-9859-602d61c77fc4" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461115}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8658a678-c6ba-5ca2-b63b-0885c74173b7" :question/math-academy-id "q-97928" :question/problem "![](images/1b/1b0ced561cd98f9cf81c7de42bee7411a39595a9c59f2edaad0121d712dad157.png)\n\nWhich of the following curves is simple, closed, and negatively oriented?\n\nSelect all that apply." :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented.\n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve II is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\n- Curve III is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\n- Curve IV is negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\nTherefore, the correct answer is \"I and IV only.\""} :step/id #uuid "2696ee1a-694a-5753-8a6f-3768b6b0920b" :step/next {:db/id #edb/ref 17592186418070}} {:db/id #edb/ref 17592186418069 :step/content {:db/id #edb/ref 17592186362284 :question/answer-fields