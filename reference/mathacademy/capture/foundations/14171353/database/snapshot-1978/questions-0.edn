nswer/id #uuid "358473a7-587c-552e-b379-4b8b0066f996" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186279061} {:answer/id #uuid "51d5e23f-ed33-5e7e-a8a3-62ac07fa49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186279337} {:answer/id #uuid "a0eb9480-6bb7-57a6-881d-742802d0f9a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186280021} {:answer/id #uuid "c3e4eccb-2a9d-50d7-a35d-b54bc39524f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186280316} {:answer/id #uuid "c4cb9a51-b713-5d85-8c03-d80a8c668649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280324}] :answer-field/correct {:answer/id #uuid "51d5e23f-ed33-5e7e-a8a3-62ac07fa49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186279337} :answer-field/id #uuid "d49946f0-a578-5a3d-907d-fcbefbab0843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281208}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3bcbe167-633d-5f59-83f8-d10ba4510f50" :question/math-academy-id "q-162168" :question/problem "The equation below describes all the points on the line segment $\\overset{―}{PQ},$ where $P(-6,2,-1)$ and $Q(-8,0,-1).$\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ a\\end{aligned}]+t[\\begin{aligned}-2 \\\\ b \\\\ 0\\end{aligned}],\\,t\\in [0,c]\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}-8 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\n$$\n\nand the vector equation of the line segment $\\overset{―}{PQ}$ is\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}],\\,t\\in [0,1].\n$$\n\nTherefore, we have\n\n$$\na+b+c=(-1)+(-2)+1=-2.\n$$"}] [{:db/id #edb/ref 17592186106283 :knowledge-point/_questions [{:db/id #edb/ref 17592186105898 :knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba" :knowledge-point/title "Finding Points on a Line That Are a Fixed Distance From Another Point on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be80d25d-e4fa-518c-b253-d927e1e19088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A_{1}(-3, 9,-4)$ and $A_{2}(-5, 11,-8)$" :db/id #edb/ref 17592186103847} {:answer/id #uuid "fb0bd1a7-2007-5e52-854e-50a9744f34ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A_{1}(0, 3, 1)$ and $A_{2}(4,-7, 7)$" :db/id #edb/ref 17592186103848} {:answer/id #uuid "093719a9-82e5-5793-adc2-dad5eea06d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A_{1}(4,-4, 8)$ and $A_{2}(-4, 4,-8)$" :db/id #edb/ref 17592186103849} {:answer/id #uuid "106c252e-7550-51b4-974f-eb147ebdec94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A_{1}(-3, 9,-4)$ and $A_{2}(5,-11, 8)$" :db/id #edb/ref 17592186103850} {:answer/id #uuid "154b4b8e-cf00-54fb-b72e-2010f015a2e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A_{1}(0, 3, 1)$ and $A_{2}(-4, 7,-7)$" :db/id #edb/ref 17592186103851}] :answer-field/id #uuid "f6e72671-61e7-583b-875f-5e5b03441ae1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103846}] :question/id #uuid "1704dfac-b6f1-5d12-b941-b68f37e7caca" :question/math-academy-id "q-32819" :question/problem "Consider the straight line that passes through $P(-2, 5,-3)$ and is parallel to $v = ⟨1,-1, 2⟩$. Find all the possible points $A$ on that line such that $AP = \\sqrt{24}$."}]}
