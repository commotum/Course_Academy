#{[{:db/id #edb/ref 17592186492050 :knowledge-point/_questions [{:db/id #edb/ref 17592186105897 :knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076aefd7-f3ef-5e65-9a6e-fcef6787013e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ 4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491468} {:answer/id #uuid "31f26793-455b-5519-8bca-61ab48aea421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]+t[\\begin{aligned}3 \\\\ -2 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491554} {:answer/id #uuid "3e3dc15f-f6a0-5469-bd09-5e5682833602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491577} {:answer/id #uuid "45c99e89-541a-51a5-acd4-9fe79f6c950f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491586} {:answer/id #uuid "bafb0fb7-23f1-5dd9-8af3-0d84685adcd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491776}] :answer-field/correct {:answer/id #uuid "bafb0fb7-23f1-5dd9-8af3-0d84685adcd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186491776} :answer-field/id #uuid "97d4e9ea-3206-52e6-90bd-f7265f05e6b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491942}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba6720d7-134d-5884-b22f-7f4012ec3a77" :question/math-academy-id "q-126964" :question/problem "Find a vector equation of the line that passes through the points $H(1,-2,3)$ and $S(4,-2,1).$" :question/worked-solution "The vector equation of the straight line passing through $H$ and parallel to $v$ is given by\n\n$$\nr=h+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $h$ is the position vector of $H.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $H(1,-2,3)$ and $S(4,-2,1),$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{HS} \\\\  & =⟨4,-2,1⟩-⟨1,-2,3⟩ \\\\  & =⟨3,0,-2⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106066 :knowledge-point/_questions [{:db/id #edb/ref 17592186105899 :knowledge-point/id #uuid "f78fe749-e37e-53f2-879f-4c36931c1d6f" :knowledge-point/title "Finding the Vector Equation of a Line Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c0bd9a-8112-53b2-b018-8f7e3b0e9cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2t" :db/id #edb/ref 17592186491492} {:answer/id #uuid "6ddce68d-485d-5026-a8d0-15c7aadcd2ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-2t" :db/id #edb/ref 17592186491652} {:answer/id #uuid "88a898e9-97f9-5c0d-a2a9-e984a3785f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-t" :db/id #edb/ref 17592186491686} {:answer/id #uuid "8f4c0811-7dac-5fed-9809-20000ee340e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-5{t}^{2}" :db/id #edb/ref 17592186491698} {:answer/id #uuid "9c7163c1-8542-5ca0-8417-6dfd8942bd73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}-2t" :db/id #edb/ref 17592186491725}] :answer-field/correct {:answer/id #uuid "88a898e9-97f9-5c0d-a2a9-e984a3785f23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3-t" :db/id #edb/ref 17592186491686} :answer-field/id #uuid "ca2dac9f-c1e9-524d-9d24-eaf747039476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102282}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "695c2a87-03bb-5036-ab74-93acc4cb34c8" :question/math-academy-id "q-162144" :question/problem "The equation below gives a parametrization of the line segment $\\overset{―}{PQ},$ where $P(1,0,3)$ and $Q(1,2,0).$\n\n$$\nr(t)=i+a\\,j+b\\,k,\\,t\\in [c,1]\n$$\n\nWhat is $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(i+2\\,j)-(i+3\\,k) \\\\  & =2\\,j-3\\,k\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=(i+3\\,k)+t(2\\,j-3\\,k)\n$$\n\nand the parametrization of the line segment $\\overset{―}{PQ}$ is\n\n$$\n\\begin{aligned}r(t) & =(i+3\\,k)+t(2\\,j-3\\,k) \\\\  & =i+2t\\,j+(3-3t)\\,k,\\,t\\in [0,1].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=2t+(3-3t)+0=3-t.\n$$"}] [{:db/id #edb/ref 17592186281392 :knowledge-point/_questions [{:db/id #edb/ref 17592186105899 :knowledge-point/id #uuid "f78fe749-e37e-53f2-879f-4c36931c1d6f" :knowledge-point/title "Finding the Vector Equation of a Line Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "358473a7-587c-552e-b379-4b8b0066f996" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186279061} {:answer/id #uuid "51d5e23f-ed33-5e7e-a8a3-62ac07fa49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186279337} {:answer/id #uuid "a0eb9480-6bb7-57a6-881d-742802d0f9a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186280021} {:answer/id #uuid "c3e4eccb-2a9d-50d7-a35d-b54bc39524f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186280316} {:answer/id #uuid "c4cb9a51-b713-5d85-8c03-d80a8c668649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280324}] :answer-field/correct {:answer/id #uuid "51d5e23f-ed33-5e7e-a8a3-62ac07fa49f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186279337} :answer-field/id #uuid "d49946f0-a578-5a3d-907d-fcbefbab0843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281208}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3bcbe167-633d-5f59-83f8-d10ba4510f50" :question/math-academy-id "q-162168" :question/problem "The equation below describes all the points on the line segment $\\overset{―}{PQ},$ where $P(-6,2,-1)$ and $Q(-8,0,-1).$\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ a\\end{aligned}]+t[\\begin{aligned}-2 \\\\ b \\\\ 0\\end{aligned}],\\,t\\in [0,c]\n$$\n\nWhat is the value of $a+b+c?$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}-8 \\\\ 0 \\\\ -1\\end{aligned}]-[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\nr=p+tv\\,⟹\\,r=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}]\n$$\n\nand the vector equation of the line segment $\\overset{―}{PQ}$ is\n\n$$\nr(t)=[\\begin{aligned}-6 \\\\ 2 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -2 \\\\ 0\\end{aligned}],\\,t\\in [0,1].\n$$\n\nTherefore, we have\n\n$$\na+b+c=(-1)+(-2)+1=-2.\n$$"}] [{:db/id #edb/ref 17592186106283 :knowledge-point/_questions [{:db/id #edb/ref 17592186105898 :knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba" :knowledge-point/title "Finding Points on a Line That Are a Fixed Distance From Another Point on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ca1ce6f-1cfa-5862-abce-de665c4b16ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(-3,9,-4)$ and ${A}_{2}(-5,11,-8)$" :db/id #edb/ref 17592186491545} {:answer/id #uuid "8d8daf29-4004-5012-a711-688c5f2c743f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(0,3,1)$ and ${A}_{2}(-4,7,-7)$" :db/id #edb/ref 17592186491695} {:answer/id #uuid "9028b822-283b-56d0-899a-4c8406bf3508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(-3,9,-4)$ and ${A}_{2}(5,-11,8)$" :db/id #edb/ref 17592186491699} {:answer/id #uuid "92e3c2fb-3736-54ce-91a9-4ddf0df4c5ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(4,-4,8)$ and ${A}_{2}(-4,4,-8)$" :db/id #edb/ref 17592186491704} {:answer/id #uuid "aeea0b74-9973-5027-885f-71438bcfb05f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(0,3,1)$ and ${A}_{2}(4,-7,7)$" :db/id #edb/ref 17592186491760}] :answer-field/correct {:answer/id #uuid "8d8daf29-4004-5012-a711-688c5f2c743f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${A}_{1}(0,3,1)$ and ${A}_{2}(-4,7,-7)$" :db/id #edb/ref 17592186491695} :answer-field/id #uuid "f6e72671-61e7-583b-875f-5e5b03441ae1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1704dfac-b6f1-5d12-b941-b68f37e7caca" :question/math-academy-id "q-32819" :question/problem "Consider the straight line that passes through $P(-2,5,-3)$ and is parallel to $v=⟨1,-1,2⟩.$ Find all the possible points $A$ on that line such that $AP=\\sqrt{24}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨-2,5,-3⟩+t⟨1,-1,2⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $A$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =⟨-2,5,-3⟩+t⟨1,-1,2⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PA} & =\\overset{\\to }{OA}-\\overset{\\to }{OP} \\\\  & =(⟨-2,5,-3⟩+t⟨1,-1,2⟩)-⟨-2,5,-3⟩ \\\\  & =t\\,⟨1,-1,2⟩ \\\\  & =⟨t,\\,-t,\\,2t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PA=\\sqrt{24},$ we get:\n\n$$\n\\begin{aligned}AP & =\\sqrt{24} \\\\ |\\overset{\\to }{PA}| & =\\sqrt{24} \\\\ |⟨t,\\,-t,\\,2t⟩| & =\\sqrt{24} \\\\ \\sqrt{{t}^{2}+(-t)^{2}+(2t)^{2}} & =\\sqrt{24} \\\\ \\sqrt{6{t}^{2}} & =\\sqrt{24} \\\\ \\pm t\\sqrt{6} & =2\\sqrt{6} \\\\ t & =\\pm 2\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 2$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{A}_{1}}=⟨-2,5,-3⟩+2⟨1,-1,2⟩=⟨0,3,1⟩, \\\\  & \\overset{\\to }{O{A}_{2}}=⟨-2,5,-3⟩-2⟨1,-1,2⟩=⟨-4,7,-7⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${A}_{1}(0,3,1)$ and ${A}_{2}(-4,7,-7).$"}] [{:db/id #edb/ref 17592186492072 :knowledge-point/_questions [{:db/id #edb/ref 17592186105898 :knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba" :knowledge-point/title "Finding Points on a Line That Are a Fixed Distance From Another Point on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bce919e-a0d8-59f0-8778-d5b453d280a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(2,-2,1)$ and ${X}_{2}(-4,-2,-5)$" :db/id #edb/ref 17592186491510} {:answer/id #uuid "44125a3b-2563-5069-8bbc-ae69a62e4b8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(1,2,-1)$ and ${X}_{2}(-6,3,-9)$" :db/id #edb/ref 17592186491584} {:answer/id #uuid "53ee61a5-d475-57b8-a0b9-a60723219d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(-2,2,1)$ and ${X}_{2}(-6,2,-7)$" :db/id #edb/ref 17592186491614} {:answer/id #uuid "bf682358-c577-5e53-95cb-2e1a7d3008bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(-2,0,1)$ and ${X}_{2}(1,2,-8)$" :db/id #edb/ref 17592186491783} {:answer/id #uuid "d6f87627-6a47-5a19-b342-cf1d6b482b3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(-2,4,-1)$ and ${X}_{2}(2,4,-6)$" :db/id #edb/ref 17592186491820}] :answer-field/correct {:answer/id #uuid "53ee61a5-d475-57b8-a0b9-a60723219d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${X}_{1}(-2,2,1)$ and ${X}_{2}(-6,2,-7)$" :db/id #edb/ref 17592186491614} :answer-field/id #uuid "5db99a8f-cee5-52ce-ae30-3cf87758843e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491919}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fae33bcb-2652-544e-838d-9fea7f4029a9" :question/math-academy-id "q-69799" :question/problem "Consider the straight line that passes through $P(-4,2,-3)$ and is parallel to $v=⟨1,\\,0,\\,2⟩.$ Find all the possible points $X$ on that line such that $XP=\\sqrt{20}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $X$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OX} & =⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PX} & =\\overset{\\to }{OX}-\\overset{\\to }{OP} \\\\  & =(⟨-4,\\,2,\\,-3⟩+t⟨1,\\,0,\\,2⟩)-⟨-4,\\,2,\\,-3⟩ \\\\  & =t⟨1,\\,0,\\,2⟩ \\\\  & =⟨t,\\,0,\\,2t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PX=\\sqrt{20},$ we get:\n\n$$\n\\begin{aligned}XP & =\\sqrt{20} \\\\ |\\overset{\\to }{PX}| & =\\sqrt{20} \\\\ |⟨t,\\,0,\\,2t⟩| & =\\sqrt{20} \\\\ \\sqrt{{t}^{2}+{0}^{2}+(2t)^{2}} & =\\sqrt{20} \\\\ \\sqrt{5{t}^{2}} & =\\sqrt{20} \\\\ \\pm \\sqrt{5}t & =2\\sqrt{5} \\\\ t & =\\pm 2\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 2$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{X}_{1}}=⟨-4,\\,2,\\,-3⟩+2⟨1,\\,0,\\,2⟩=⟨-2,2,1⟩, \\\\  & \\overset{\\to }{O{X}_{2}}=⟨-4,\\,2,\\,-3⟩-2⟨1,\\,0,\\,2⟩=⟨-6,2,-7⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${X}_{1}(-2,2,1)$ and ${X}_{2}(-6,2,-7).$"}]}
