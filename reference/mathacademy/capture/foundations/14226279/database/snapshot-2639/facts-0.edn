802d-5130-a340-47dd3d54165b" #edb/ref 17592186045417] [17592186308149 #edb/ref 1075 #edb/ref 17592186305418 #edb/ref 17592186045417] [17592186308149 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308149 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186308149 #edb/ref 1078 #edb/ref 17592186305418 #edb/ref 17592186045417] [17592186308149 #edb/ref 1079 #uuid "c9664d18-5c13-5c23-a303-4d40a0de2cc7" #edb/ref 17592186045417] [17592186308167 #edb/ref 1075 #edb/ref 17592186306488 #edb/ref 17592186045417] [17592186308167 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308167 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186308167 #edb/ref 1078 #edb/ref 17592186306488 #edb/ref 17592186045417] [17592186308167 #edb/ref 1079 #uuid "cf20e996-1ea4-5bae-aecf-b59e8d34708e" #edb/ref 17592186045417] [17592186308182 #edb/ref 1075 #edb/ref 17592186305366 #edb/ref 17592186045417] [17592186308182 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308182 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186308182 #edb/ref 1078 #edb/ref 17592186305366 #edb/ref 17592186045417] [17592186308182 #edb/ref 1079 #uuid "d4007ccd-444f-5475-a4c0-493bff543247" #edb/ref 17592186045417] [17592186308493 #edb/ref 1068 #edb/ref 17592186466892 #edb/ref 17592186045436] [17592186308493 #edb/ref 1068 #edb/ref 17592186466893 #edb/ref 17592186045436] [17592186308493 #edb/ref 1068 #edb/ref 17592186466894 #edb/ref 17592186045436] [17592186308493 #edb/ref 1069 "q-333693" #edb/ref 17592186045417] [17592186308493 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186308493 #edb/ref 1071 "Which of the following expressions for the global truncation error ($e$) or local truncation error ($τ$) represent a third-order numerical method?\n- **I.** $τ(Δx)=2(Δx)^{2}$\n- **II.** $e(Δx)=3(Δx)^{3}-3(Δx)^{2}$\n- **III.** $τ(Δx)=(Δx)^{4}-2(Δx)^{5}$\n\nSelect all that apply." #edb/ref 17592186045436] [17592186308493 #edb/ref 1072 #uuid "81f632f0-dedf-5479-9362-313bdb74c812" #edb/ref 17592186045417] [17592186308493 #edb/ref 1074 "For a given numerical method, if $p$ is the largest positive integer such that\n\n- the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0,\n$$\n\n- the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0,\n$$\n\nthen the method is of order $p.$\n\nWith that in mind, let's check each option in turn:\n\n- For the LTE expression $τ(Δx)=2(Δx)^{2},$ the dominant term as $Δx\\to 0$ is $2(Δx)^{2}=2(Δx)^{1+1}.$ So, statement I corresponds to an order $1$ method.\n\n- For the GTE expression $e(Δx)=3(Δx)^{3}-3(Δx)^{2},$ the dominant term as $Δx\\to 0$ is $-3(Δx)^{2}.$ So, statement II corresponds to an order $2$ method.\n\n- For the LTE expression $τ(Δx)=(Δx)^{4}-2(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $(Δx)^{4}=(Δx)^{3+1}.$ So, statement III corresponds to an order $3$ method.\n\nTherefore, the correct answer is \"III only\"." #edb/ref 17592186045417] [17592186308680 #edb/ref 1068 #edb/ref 17592186466974 #edb/ref 17592186045436] [17592186308680 #edb/ref 1068 #edb/ref 17592186466975 #edb/ref 17592186045436] [17592186308680 #edb/ref 1068 #edb/ref 17592186466976 #edb/ref 17592186045436] [17592186308680 #edb/ref 1069 "q-334756" #edb/ref 17592186045417] [17592186308680 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186308680 #edb/ref 1071 "Which of the following expressions for the global truncation error ($e$) or local truncation error ($τ$) represent a third-order numerical method?\n- **I.** $τ(Δx)=5(Δx)^{4}+2(Δx)^{6}$\n- **II.** $e(Δx)=4(Δx)^{3}+7(Δx)^{4}$\n- **III.** $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3}$\n\nSelect all that apply." #edb/ref 17592186045436] [17592186308680 #edb/ref 1072 #uuid "1edbdd20-a6fa-5411-be9e-ad5ea2edf0c1" #edb/ref 17592186045417] [17592186308680 #edb/ref 1074 "For a given numerical method, if $p$ is the largest positive integer such that\n\n- the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0,\n$$\n\n- the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0,\n$$\n\nthen the method is of order $p.$\n\nWith that in mind, let's check each option in turn:\n\n- For the LTE expression $τ(Δx)=5(Δx)^{4}+2(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $5(Δx)^{4}=5(Δx)^{3+1}.$\nSo, statement I corresponds to an order $3$ method.\n\n- For the GTE expression $e(Δx)=4(Δx)^{3}+7(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{3}=4(Δx)^{3}.$\nSo, statement II corresponds to an order $3$ method.\n\n- For the LTE expression $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3},$ the dominant term as $Δx\\to 0$ is $0.3(Δx)^{2}=0.3(Δx)^{1+1}.$\nSo, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I and II only\"." #edb/ref 17592186045417] [17592186308686 #edb/ref 1068 #edb/ref 17592186308092 #edb/ref 17592186045417] [17592186308686 #edb/ref 1069 "q-334781" #edb/ref 17592186045417] [17592186308686 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308686 #edb/ref 1071 "A numerical method for approximating a solution to an initial value problem is known to be order $4.$\nSuppose that using step size $Δx=0.1$ produces a global truncation error (GTE) of $e(0.1)≈0.512.$\nIf we instead use a step size $Δx=0.025,$ what GTE should we expect?\n\n$e(0.025)≈$\n{{field-1}}" #edb/ref 17592186045417] [17592186308686 #edb/ref 1072 #uuid "5e9fb99c-0502-586a-b64c-76d5a0146e7d" #edb/ref 17592186045417] [17592186308686 #edb/ref 1074 "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.1$ to $0.025.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.1}{0.025}=4.\n$$\n\nNow, since the numerical method is of order $4,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{4}={4}^{4}=256.\n$$\n\nTherefore, using a step size of $Δx=0.025,$ the expected GTE is\n\n$$\ne(0.025)≈\\frac{0.512}{256}=0.002.\n$$" #edb/ref 17592186045417] [17592186396388 #edb/ref 1075 #edb/ref 17592186396389 #edb/ref 17592186045417] [17592186396388 #edb/ref 1075 #edb/ref 17592186396390 #edb/ref 17592186045417] [17592186396388 #edb/ref 1075 #edb/ref 17592186396391 #edb/ref 17592186045417] [17592186396388 #edb/ref 1075 #edb/ref 17592186396392 #edb/ref 17592186045417] [17592186396388 #edb/ref 1075 #edb/ref 17592186396393 #edb/ref 17592186045417] [17592186396388 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186396388 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186396388 #edb/ref 1078 #edb/ref 17592186396393 #edb/ref 17592186045417] [17592186396388 #edb/ref 1079 #uuid "1e9f3cc8-ee4d-5f7b-b815-f8923b3f6f94" #edb/ref 17592186045417] [17592186396389 #edb/ref 1080 "20.865" #edb/ref 17592186045417] [17592186396389 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186396389 #edb/ref 1083 #uuid "8a98936b-f6f9-53c3-aefc-f49cb4b5c873" #edb/ref 17592186045417] [17592186396390 #edb/ref 1080 "10.642" #edb/ref 17592186045417] [17592186396390 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186396390 #edb/ref 1083 #uuid "55c03e15-db65-5bda-97c7-68787c5792a7" #edb/ref 17592186045417] [17592186396391 #edb/ref 1080 "27.015" #edb/ref 17592186045417] [17592186396391 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186396391 #edb/ref 1083 #uuid "427c0b3e-32c0-57c2-af3d-615ea8da505b" #edb/ref 17592186045417] [17592186396392 #edb/ref 1080 "15.384" #edb/ref 17592186045417] [17592186396392 #edb/ref 1082 #edb/ref 17592