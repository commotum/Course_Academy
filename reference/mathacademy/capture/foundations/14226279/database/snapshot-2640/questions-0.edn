/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186307373}] :answer-field/correct {:answer/id #uuid "f1932091-7e6d-5820-ba97-aad151b907d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186307373} :answer-field/id #uuid "796673ad-168c-5ede-b71a-db80bf562634" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186307903} {:answer-field/choices [{:answer/id #uuid "13e04fc5-3177-5dc2-9100-3fffca35eb24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.225" :db/id #edb/ref 17592186305323} {:answer/id #uuid "64767d88-6051-5480-91b6-c41e9bf49c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.375" :db/id #edb/ref 17592186306121} {:answer/id #uuid "74ede194-9cb5-53af-a0a1-2e82afd1d0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186306264} {:answer/id #uuid "83d61e9d-685a-5a5f-a732-336138f71219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.075" :db/id #edb/ref 17592186306408} {:answer/id #uuid "86751a4c-86a9-5438-b05a-af0255c79861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.550" :db/id #edb/ref 17592186306433}] :answer-field/correct {:answer/id #uuid "74ede194-9cb5-53af-a0a1-2e82afd1d0ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 17592186306264} :answer-field/id #uuid "a7dc62ec-6aa3-5187-b8d0-4ca8606aada0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36473f35-3093-5439-832b-c821da150814" :question/math-academy-id "q-333706" :question/problem "The local truncation error (LTE) of a numerical method with step size $Δx$ is\n\n$$\nτ(Δx)=7(Δx)^{4}-2(Δx)^{5}.\n$$\n\nComplete the following sentences.$\\,$ With step size $Δx=0.5,$ the local truncation error is\n{{field-1}}.\n\n$\\,$ With step size $Δx=0.25,$ the local truncation error is $≈$\n{{field-2}}.\n\n$\\,$ Decreasing from $Δx=0.5$ to $Δx=0.25,$ the LTE is reduced by a factor of $≈$\n{{field-3}}.\n\n$\\,$ According to this data, the order of the method is approximately\n{{field-4}}." :question/requires-calculator true :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nFirst, we compute the LTE for the given step sizes:\n\n- With step size $Δx=0.5,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.5) & =7(0.5)^{4}-2(0.5)^{5} \\\\  & =7\\cdot 0.062\\,5-2\\cdot 0.031\\,25 \\\\  & =0.375.\\end{aligned}\n$$\n\n- With step size $Δx=0.25,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.25) & =7(0.25)^{4}-2(0.25)^{5} \\\\  & =7\\cdot (0.003\\,906…)-2\\cdot (0.000\\,976…) \\\\  & =0.025\\,39… \\\\  & ≈0.025.\\end{aligned}\n$$\n\nNext, we determine the order by comparing the errors. The step size decreases from $0.5$ to $0.25.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.5}{0.25}=2.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={2}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.375$ to $0.025\\,39….$ So, it reduces by a factor of\n\n$$\n\\frac{0.375}{(0.025\\,39…)}=14.769\\,23…≈14.769.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{2}^{p+1} & ≈14.769\\,23… \\\\ p+1 & ≈{log}_{2}⁡(14.769\\,23…) \\\\ p+1 & ≈3.884… \\\\ p & ≈2.884….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is\n$3.$\n\nIndeed, this coincides with the definition of the order from the expression for the LTE:\n\n$$\nτ(Δx)=7(Δx)^{4}-2(Δx)^{5}\\,⇒\\,τ(Δx)=O\\,((Δx)^{4})=O\\,((Δx)^{3+1}),\\,Δx\\to 0.\n$$\n\nHence, the order of the method is $3.$"}] [{:db/id #edb/ref 17592186443229 :knowledge-point/_questions [{:db/id #edb/ref 17592186221402 :knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d85bffd-8755-5e9b-a7b3-89febd886899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186443106} {:answer/id #uuid "36fa518b-6582-5224-a8cb-c3138d904c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186443108} {:answer/id #uuid "78fccd02-9cc5-55f5-b63f-230bd2ea38ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186443145} {:answer/id #uuid "d25d6992-22c7-51c6-8f7a-dcf497256df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186443181} {:answer/id #uuid "fb6df07a-d7ae-549b-8810-208c22275136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186443202}] :answer-field/correct {:answer/id #uuid "d25d6992-22c7-51c6-8f7a-dcf497256df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186443181} :answer-field/id #uuid "a944373a-a6f7-5cc7-b56a-d45f56447bab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1812d74c-f7ff-5b92-ad0c-d300745fe3f0" :question/math-academy-id "q-334643" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.09,$ the observed local truncation error is $τ(0.09)=0.20.$\n\n- With step size $Δx=0.06,$ the observed local truncation error is $τ(0.06)=0.05.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.09$ to $0.06.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.09}{0.06}=1.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}=(1.5)^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.20$ to $0.05.$ So, it reduces by a factor of\n\n$$\n\\frac{0.20}{0.05}=4.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}(1.5)^{p+1} & ≈4 \\\\ p+1 & ≈{log}_{1.5}⁡(4) \\\\ p+1 & ≈3.419… \\\\ p & ≈2.419….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $2.$"}] [{:db/id #edb/ref 17592186308680 :knowledge-point/_questions [{:db/id #edb/ref 17592186221403 :knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21ffaded-0ccb-5f13-b811-33701f6c5711" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466261} {:answer/id #uuid "0396eff4-577a-5f94-9927-4f8eed41fc32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466262}] :answer-field/correct {:answer/id #uuid "0396eff4-577a-5f94-9927-4f8eed41fc32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466262} :answer-field/id #uuid "f14c996d-e452-507e-9e46-0a859b3d4fa9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466974} {:answer-field/choices [{:answer/id #uuid "dde4f68b-d7ce-5557-91ee-694beaffacba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466263} {:answer/id #uuid "df314c42-1898-5b47-ae5d-cfb5a8bb2afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466264}] :answer-field/correct {:answer/id #uuid "df314c42-1898-5b47-ae5d-cfb5a8bb2afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466264} :answer-field/id #uuid "8bc8d993-fe81-5ea2-837e-05e1c8f91a4f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466975} {:answer-field/choices [{:answer/id #uuid "3aa778e3-a751-5e3c-bbce-c3d6e285508d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466265} {:answer/id #uuid "a2808125-76aa-5fe5-a9e0-5a2d101ac8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466266}] :answer-field/correct {:answer/id #uuid "3aa778e3-a751-5e3c-bbce-c3d6e285508d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466265} :answer-field/id #uuid "e3599088-0440-5c81-8639-94ce7a9bf76b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466976}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1edbdd20-a6fa-5411-be9e-ad5ea2edf0c1" :question/math-academy-id "q-334756" :question/problem "Which of the following expressions for the global truncation error ($e$) or local truncation error ($τ$) represent a third-order numerical method?\n- **I.** $τ(Δx)=5(Δx)^{4}+2(Δx)^{6}$\n- **II.** $e(Δx)=4(Δx)^{3}+7(Δx)^{4}$\n- **III.** $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3}$\n\nSelect all that apply." :question/worked-solution "For a given numerical method, if $p$ is the largest positive integer such that\n\n- the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0,\n$$\n\n- the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0,\n$$\n\nthen the method is of order $p.$\n\nWith that in mind, let's check each option in turn:\n\n- For the LTE expression $τ(Δx)=5(Δx)^{4}+2(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $5(Δx)^{4}=5(Δx)^{3+1}.$\nSo, statement I corresponds to an order $3$ method.\n\n- For the GTE expression $e(Δx)=4(Δx)^{3}+7(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{3}=4(Δx)^{3}.$\nSo, statement II corresponds to an order $3$ method.\n\n- For the LTE expression $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3},$ the dominant term as $Δx\\to 0$ is $0.3(Δx)^{2}=0.3(Δx)^{1+1}.$\nSo, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186308686 :knowledge-point/_questions [{:db/id #edb/ref 17592186221404 :knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c564be2-b5d6-576e-b6c5-4b2e22ea2310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.002" :db/id #edb/ref 17592186305415}] :answer-field/correct {:answer/id #uuid "1c564be2-b5d6-576e-b6c5-4b2e22ea2310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.002" :db/id #edb/ref 17592186305415} :answer-field/id #uuid "b4f564b5-049c-5bd7-a511-bc72af30b334" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308092}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e9fb99c-0502-586a-b64c-76d5a0146e7d" :question/math-academy-id "q-334781" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $4.$\nSuppose that using step size $Δx=0.1$ produces a global truncation error (GTE) of $e(0.1)≈0.512.$\nIf we instead use a step size $Δx=0.025,$ what GTE should we expect?\n\n$e(0.025)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.1$ to $0.025.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.1}{0.025}=4.\n$$\n\nNow, since the numerical method is of order $4,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{4}={4}^{4}=256.\n$$\n\nTherefore, using a step size of $Δx=0.025,$ the expected GTE is\n\n$$\ne(0.025)≈\\frac{0.512}{256}=0.002.\n$$"}]}
