#{[{:db/id #edb/ref 17592186308493 :knowledge-point/_questions [{:db/id #edb/ref 17592186221403 :knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cacad9b6-d96e-5ed3-8941-1b425e4561b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466097} {:answer/id #uuid "1ca4bf25-4a12-5fe7-b403-40cd2d1ae306" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466098}] :answer-field/correct {:answer/id #uuid "cacad9b6-d96e-5ed3-8941-1b425e4561b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466097} :answer-field/id #uuid "52118cf3-1913-5b6f-a6a4-3a44d5057427" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466892} {:answer-field/choices [{:answer/id #uuid "16526fc2-0575-5da4-9643-0dde15f08f4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466099} {:answer/id #uuid "1b41930f-abcc-5604-be55-86986ebf53ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466100}] :answer-field/correct {:answer/id #uuid "16526fc2-0575-5da4-9643-0dde15f08f4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466099} :answer-field/id #uuid "516c2af8-6bdf-5d44-a25e-66e659569bb0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466893} {:answer-field/choices [{:answer/id #uuid "3e1fdffc-3d4c-5f3c-b3fd-1c4e03051b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466101} {:answer/id #uuid "a8d8859c-a702-5bff-9977-f3bbc69941ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466102}] :answer-field/correct {:answer/id #uuid "a8d8859c-a702-5bff-9977-f3bbc69941ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466102} :answer-field/id #uuid "a659403e-5966-58dd-8b52-749c8e0a467c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466894}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81f632f0-dedf-5479-9362-313bdb74c812" :question/math-academy-id "q-333693" :question/problem "Which of the following expressions for the global truncation error ($e$) or local truncation error ($τ$) represent a third-order numerical method?\n- **I.** $τ(Δx)=2(Δx)^{2}$\n- **II.** $e(Δx)=3(Δx)^{3}-3(Δx)^{2}$\n- **III.** $τ(Δx)=(Δx)^{4}-2(Δx)^{5}$\n\nSelect all that apply." :question/worked-solution "For a given numerical method, if $p$ is the largest positive integer such that\n\n- the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0,\n$$\n\n- the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0,\n$$\n\nthen the method is of order $p.$\n\nWith that in mind, let's check each option in turn:\n\n- For the LTE expression $τ(Δx)=2(Δx)^{2},$ the dominant term as $Δx\\to 0$ is $2(Δx)^{2}=2(Δx)^{1+1}.$ So, statement I corresponds to an order $1$ method.\n\n- For the GTE expression $e(Δx)=3(Δx)^{3}-3(Δx)^{2},$ the dominant term as $Δx\\to 0$ is $-3(Δx)^{2}.$ So, statement II corresponds to an order $2$ method.\n\n- For the LTE expression $τ(Δx)=(Δx)^{4}-2(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $(Δx)^{4}=(Δx)^{3+1}.$ So, statement III corresponds to an order $3$ method.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186221987 :knowledge-point/_questions [{:db/id #edb/ref 17592186221402 :knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1959d41f-52be-52c1-871e-b699293b1307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.769" :db/id #edb/ref 17592186305381} {:answer/id #uuid "1ec87537-6fa0-5eda-86d9-4554032f1a5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.168" :db/id #edb/ref 17592186305444} {:answer/id #uuid "37d717c9-2678-5acd-9e7b-470aba738582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.671" :db/id #edb/ref 17592186305687} {:answer/id #uuid "3a8bd609-2c76-56f5-ab76-2b1b93bba25c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.135" :db/id #edb/ref 17592186305707} {:answer/id #uuid "9a41b78c-ad27-5209-95b9-87e703d4f1cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.864" :db/id #edb/ref 17592186306592}] :answer-field/correct {:answer/id #uuid "1959d41f-52be-52c1-871e-b699293b1307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14.769" :db/id #edb/ref 17592186305381} :answer-field/id #uuid "02c14e40-2f8c-5353-919f-1e2b81c06a0a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186307524} {:answer-field/choices [{:answer/id #uuid "345d0530-b807-5eb6-8028-e9e60219419a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.025" :db/id #edb/ref 1759