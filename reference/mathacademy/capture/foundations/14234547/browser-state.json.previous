alse\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo>⋅</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>e</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>3</mn></msup><mo>−</mo><mn>0</mn><mo>⋅</mo><msup><mn>1</mn><mn>3</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>e</mi><mn>6</mn></msup><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>e</mi><mn>6</mn></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
