 data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>+</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>θ</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>r</mi></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mn>2</mn><mi>r</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>θ</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>θ</mi><mo>−</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>2</mn><mi>θ</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
