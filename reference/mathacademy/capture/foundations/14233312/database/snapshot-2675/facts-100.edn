ac4-379e-5a13-8c4c-6ea313e7d773" #edb/ref 17592186045417] [17592186479023 #edb/ref 1075 #edb/ref 17592186478606 #edb/ref 17592186045417] [17592186479023 #edb/ref 1075 #edb/ref 17592186478716 #edb/ref 17592186045417] [17592186479023 #edb/ref 1075 #edb/ref 17592186478720 #edb/ref 17592186045417] [17592186479023 #edb/ref 1075 #edb/ref 17592186478779 #edb/ref 17592186045417] [17592186479023 #edb/ref 1075 #edb/ref 17592186478838 #edb/ref 17592186045417] [17592186479023 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186479023 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186479023 #edb/ref 1078 #edb/ref 17592186478838 #edb/ref 17592186045417] [17592186479023 #edb/ref 1079 #uuid "a1d7bd4f-ecaa-56a0-8783-ed8687ea01ad" #edb/ref 17592186045417] [17592186479083 #edb/ref 1068 #edb/ref 17592186479023 #edb/ref 17592186045417] [17592186479083 #edb/ref 1069 "q-95135" #edb/ref 17592186045417] [17592186479083 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479083 #edb/ref 1071 "Given that $v(r,\\theta )=r(1+\\operatorname{cos}⁡2\\theta ),$ find $\\frac{∂v}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479083 #edb/ref 1072 #uuid "41bc3280-6f3c-5ef7-84dc-f2df8938f974" #edb/ref 17592186045417] [17592186479083 #edb/ref 1074 "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂y}=\\frac{∂v}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=1+\\operatorname{cos}⁡2\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡2\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂y} & =(1+\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-2r\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479085 #edb/ref 1068 #edb/ref 17592186479004 #edb/ref 17592186045417] [17592186479085 #edb/ref 1069 "q-165283" #edb/ref 17592186045417] [17592186479085 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479085 #edb/ref 1071 "Given that $v(r,\\theta )={r}^{2}+2r\\operatorname{cos}⁡\\theta ,$ find $\\frac{∂v}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479085 #edb/ref 1072 #uuid "4437c604-b7f0-5633-b7e5-9971f03bd2b2" #edb/ref 17592186045417] [17592186479085 #edb/ref 1074 "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂x}=\\frac{∂v}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{sin}⁡\\theta \n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=2r+2\\operatorname{cos}⁡\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂x} & =(2r+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2{cos}^{2}⁡\\theta +2{sin}^{2}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta +2({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡\\theta +2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479097 #edb/ref 1068 #edb/ref 17592186478991 #edb/ref 17592186045417] [17592186479097 #edb/ref 1069 "q-165285" #edb/ref 17592186045417] [17592186479097 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479097 #edb/ref 1071 "Given that $f(x,y,z)=xy{z}^{2},$ find $\\frac{∂f}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." #edb/ref 17592186045417] [17592186479097 #edb/ref 1072 #uuid "7396bdb2-9333-5e99-8459-ac9d52a00034" #edb/ref 17592186045417] [17592186479097 #edb/ref 1074 "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂f}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}=2xyz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =2{r}^{2}z\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}z\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479105 #edb/ref 1068 #edb/ref 17592186478967 #edb/ref 17592186045417] [17592186479105 #edb/ref 1069 "q-95137" #edb/ref 17592186045417] [17592186479105 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479105 #edb/ref 1071 "Given that $h(r,\\theta )=r(\\operatorname{cos}⁡\\theta -1),$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479105 #edb/ref 1072 #uuid "88d1b83b-2766-5063-936f-a018502be867" #edb/ref 17592186045417] [17592186479105 #edb/ref 1074 "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=\\operatorname{cos}⁡\\theta -1,\\,\\frac{∂h}{∂\\theta }=-r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(\\operatorname{cos}⁡\\theta -1)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1-\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479138 #edb/ref 1068 #edb/ref 17592186478983 #edb/ref 17592186045417] [17592186479138 #edb/ref 1069 "q-95168" #edb/ref 17592186045417] [17592186479138 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479138 #edb/ref 1071 "Given that $g(x,y,z)={x}^{2}z+{z}^{2},$ find $\\frac{∂g}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." #edb/ref 17592186045417] [17592186479138 #edb/ref 1072 #uuid "e54cb552-8c05-5b9c-84f1-978bbe7cbf63" #edb/ref 17592186045417] [17592186479138 #edb/ref 1074 "Applying the multivariable chain rule for the function $g(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂g}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂g}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}={x}^{2}+2z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & ={r}^{2}{cos}^{2}⁡\\theta +2z.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186508382 #edb/ref 1043 #edb/ref 17592186509022 #edb/ref 17592186045417] [17592186508382 #edb/ref 1043 #edb/ref 