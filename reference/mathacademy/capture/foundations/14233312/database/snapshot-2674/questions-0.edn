⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478838} :answer-field/id #uuid "a1d7bd4f-ecaa-56a0-8783-ed8687ea01ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479023}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41bc3280-6f3c-5ef7-84dc-f2df8938f974" :question/math-academy-id "q-95135" :question/problem "Given that $v(r,\\theta )=r(1+\\operatorname{cos}⁡2\\theta ),$ find $\\frac{∂v}{∂y},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂v}{∂y}=\\frac{∂v}{∂r}\\operatorname{sin}⁡\\theta +\\frac{1}{r}\\frac{∂v}{∂\\theta }\\operatorname{cos}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $v$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂v}{∂r}=1+\\operatorname{cos}⁡2\\theta ,\\,\\frac{∂v}{∂\\theta }=-2r\\operatorname{sin}⁡2\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂v}{∂y} & =(1+\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(-2r\\operatorname{sin}⁡2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479105 :knowledge-point/_questions [{:db/id #edb/ref 17592186124595 :knowledge-point/id #uuid "879dfc0f-ea2b-5ccb-bbc6-95f43b9c7073" :knowledge-point/title "Calculating the Derivative of a Polar Function With Respect to Cartesian Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d25be9-c593-5605-a401-5d2bd749db79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478585} {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} {:answer/id #uuid "84dcc6f3-d690-5f72-8730-48a6a222d69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478763} {:answer/id #uuid "952ab814-3b74-5511-bb1b-17a92c942267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186478803} {:answer/id #uuid "e73b53e8-31b8-587a-95b0-e9d5813a7d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478918}] :answer-field/correct {:answer/id #uuid "7368bb2b-738b-5553-9b24-d72d10f86673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186478728} :answer-field/id #uuid "1bff08b3-d2ad-542d-9f8a-a1ea880775f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88d1b83b-2766-5063-936f-a018502be867" :question/math-academy-id "q-95137" :question/problem "Given that $h(r,\\theta )=r(\\operatorname{cos}⁡\\theta -1),$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=\\operatorname{cos}⁡\\theta -1,\\,\\frac{∂h}{∂\\theta }=-r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(\\operatorname{cos}⁡\\theta -1)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1-\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479138 :knowledge-point/_questions [{:db/id #edb/ref 17592186124596 :knowledge-point/id #uuid "2ee45610-e14c-593e-9002-e2b2fcdb4517" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Cylindrical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "893956da-d416-51f2-95f7-dc12fb1c1725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta +2rz" :db/id #edb/ref 17592186478773} {:answer/id #uuid "9713ade3-5604-530d-b802-1fdfc640a4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{cos}^{2}⁡\\theta +2z" :db/id #edb/ref 17592186478807} {:answer/id #uuid "b62c08b7-43fb-5995-8666-a7c19ff8a830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡2\\theta +z" :db/id #edb/ref 17592186478854} {:answer/id #uuid "daa43c07-cab4-59d9-96d9-b09db9596eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{sin}^{2}⁡\\theta +z" :db/id #edb/ref 17592186478903} {:answer/id #uuid "f69418f1-6362-5b4e-8489-03eacbf8b9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡2\\theta +2z" :db/id #edb/ref 17592186478945}] :answer-field/correct {:answer/id #uuid "9713ade3-5604-530d-b802-1fdfc640a4e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}{cos}^{2}⁡\\theta +2z" :db/id #edb/ref 17592186478807} :answer-field/id #uuid "45082c16-ebec-5599-aae3-e180ec356a3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478983}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e54cb552-8c05-5b9c-84f1-978bbe7cbf63" :question/math-academy-id "q-95168" :question/problem "Given that $g(x,y,z)={x}^{2}z+{z}^{2},$ find $\\frac{∂g}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂g}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂g}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}={x}^{2}+2z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & ={r}^{2}{cos}^{2}⁡\\theta +2z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360581 :knowledge-point/_questions [{:db/id #edb/ref 17592186124596 :knowledge-point/id #uuid "2ee45610-e14c-593e-9002-e2b2fcdb4517" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Cylindrical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12192e9d-666e-5c58-ae9b-549a795d8bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z\\operatorname{cos}⁡2\\theta +\\frac{1}{2}{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186357907} {:answer/id #uuid "2313e01f-d71c-5200-a515-ee826a71b2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}(z{cos}^{2}⁡\\theta +\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186358058} {:answer/id #uuid "3838a62b-71f1-5444-8110-29c7f4dcb528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358248} {:answer/id #uuid "6d65b027-234d-52ec-b21e-4cda093023c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta +{r}^{2}z\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358706} {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169}] :answer-field/correct {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169} :answer-field/id #uuid "41d8dcd8-411e-5bef-bfda-8f715f466b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360090}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f89a4f6-9145-5fdf-84a8-9fcaed162c54" :question/math-academy-id "q-95171" :question/problem "Given that $u(x,y,z)={x}^{2}{z}^{2}+{x}^{2}{y}^{2}+xyz,$ find $\\frac{∂u}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $u(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =\\frac{∂u}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂u}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂u}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂u}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z}=2{x}^{2}z+xy\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =2{r}^{2}z{cos}^{2}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360583 :knowledge-point/_questions [{:db/id #edb/ref 17592186124596 :knowledge-point/id #uuid "2ee45610-e14c-593e-9002-e2b2fcdb4517" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Cylindrical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129511e1-8153-5e51-95ae-9c26ed91e829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z" :db/id #edb/ref 17592186357911} {:answer/id #uuid "22e04b8b-94b1-5f23-a25d-237f08e39a4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358054} {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} {:answer/id #uuid "b5f0ea0f-66cb-5c73-84ba-025ec83912b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359332} {:answer/id #uuid "d256b0d6-11fb-52fc-a283-8f751fba045a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359590}] :answer-field/correct {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} :answer-field/id #uuid "57e7c9e5-29e9-5ecf-8487-914454d5c63c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360130}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7a6bf9a-03da-5b3f-8e6f-6e42220c784c" :question/math-academy-id "q-95174" :question/problem "Given that $h(x,y,z)=2{x}^{2}+{y}^{2}+4{x}^{2}{z}^{2},$ find $\\frac{∂h}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂h}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂h}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z}=8{x}^{2}z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =8{r}^{2}z{cos}^{2}⁡\\theta .\\end{aligned}\n$$"}]}
