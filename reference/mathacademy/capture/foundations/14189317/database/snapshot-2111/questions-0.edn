#{[{:db/id #edb/ref 17592186259487 :knowledge-point/_questions [{:db/id #edb/ref 17592186133889 :knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a" :knowledge-point/title "Finding the Divergence of a Vector Field in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2136e2e5-eda2-5d8c-a918-cc6e25b936c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+9y-12z" :db/id #edb/ref 17592186257054} {:answer/id #uuid "25df7a36-fb35-5a6b-a4f2-d81927845c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+6y-8z" :db/id #edb/ref 17592186257106} {:answer/id #uuid "38802d04-6400-526e-a3c7-774018ac66df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x+12y-16z" :db/id #edb/ref 17592186257281} {:answer/id #uuid "5d8c3701-5e7c-5b81-a7af-ecb760a2a77c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+3y-4z)^{2}" :db/id #edb/ref 17592186257601} {:answer/id #uuid "a1dc10e2-998c-5132-90c3-1c176c2b128f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y-4z" :db/id #edb/ref 17592186258200}] :answer-field/correct {:answer/id #uuid "25df7a36-fb35-5a6b-a4f2-d81927845c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+6y-8z" :db/id #edb/ref 17592186257106} :answer-field/id #uuid "f5c380c2-6f7a-5fa6-a1cf-bdd2ef574b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02dd9d18-cd94-5447-91da-e2448419b7b2" :question/math-academy-id "q-123179" :question/problem "Consider the vector field $F=(2x+3y-4z)^{2}\\,i+(2x+3y-4z)^{2}\\,j+(2x+3y-4z)^{2}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((2x+3y-4z)^{2})+\\frac{∂}{∂y}((2x+3y-4z)^{2})+\\frac{∂}{∂z}((2x+3y-4z)^{2}) \\\\  & =4(2x+3y-4z)+6(2x+3y-4z)-8(2x+3y-4z) \\\\  & =2(2x+3y-4z) \\\\  & =4x+6y-8z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134395 :knowledge-point/_questions [{:db/id #edb/ref 17592186133911 :knowledge-point/id #uuid "28142e26-f6c7-54c9-9c16-035c75f7659f" :knowledge-point/title "Calculating the Determinant of a Matrix With A Zero Row/Column or Two Identical Rows/Columns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c225eb90-e2e0-5316-bf2c-433fb3c69768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186132410} {:answer/id #uuid "320e4a8c-eedf-5588-98e8-c145e0ace715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186132411} {:answer/id #uuid "43de3423-2ffd-5930-9ee0-ea5001c9a16b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186132412} {:answer/id #uuid "53f34a5f-dc76-5b22-9b1f-04217732f9e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186132413} {:answer/id #uuid "796055cc-72c1-5b68-9805-3a39d9b06647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186132414}] :answer-field/id #uuid "33879ed2-4ff8-5792-966a-daa49f7bc975" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132409}] :question/id #uuid "dcb38d39-eeab-5f94-bc9b-9cb1d6df2c04" :question/math-academy-id "q-42461" :question/problem "Find $2det(A) + 4det(B)$, where\n$A = \\begin{bmatrix}1 & 0 & \\sqrt{3} & 1 \\\\ 0 & 2 & 4 & 2 \\\\ 0 & 0 & 2 & -4 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}, B = \\begin{bmatrix}3 & \\sqrt{2} & 2 & 3 \\\\ 1 & 2 & 1 & 3 \\\\ 3 & 1 & 0 & \\sqrt{2} \\\\ 1 & 2 & 1 & 3\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186373132 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1b2908-d140-5d0a-8262-c958d76bfa4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471471} {:answer/id #uuid "f456143a-b430-5e18-95eb-88219103f545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471472}] :answer-field/correct {:answer/id #uuid "de1b2908-d140-5d0a-8262-c958d76bfa4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471471} :answer-field/id #uuid "06e697f7-446e-5fcc-ae8a-db378503de70" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472241} {:answer-field/choices [{:answer/id #uuid "55e41eb5-2115-5b1f-9bbb-e67f510d8e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471473} {:answer/id #uuid "bf770033-4a57-5465-a9ee-d6d68d54b733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471474}] :answer-field/correct {:answer/id #uuid "bf770033-4a57-5465-a9ee-d6d68d54b733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471474} :answer-field/id #uuid "83576e31-5a8a-5315-8054-127553d4c6a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472242} {:answer-field/choices [{:answer/id #uuid "ad5d90de-a61d-5e9f-a889-d499427c60be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471475} {:answer/id #uuid "9f5c3a1e-f107-5159-ae8f-6ce7a0d2da41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471476}] :answer-field/correct {:answer/id #uuid "ad5d90de-a61d-5e9f-a889-d499427c60be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471475} :answer-field/id #uuid "5771a531-83c1-5b90-a459-0ec86b28bfd9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c853fbcf-5be0-5101-8f2a-558cbd4a782f" :question/math-academy-id "q-71402" :question/problem "The level curves of the function $f(x,y)=9x+3y-4$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=0$ gives an ellipse\n- **II.** $c=-4$ gives a line\n- **III.** $c=5$ gives a hyperbola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}9x+3y-4 & =c \\\\ 3y & =-9x+c+4 \\\\ y & =-3x+\\frac{c+4}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-3x+\\frac{4}{3},$ which is not an ellipse.\n\n- If $c=-4$ then the level curve is $y=-3x,$ which is a line.\n\n- If $c=5$ then the level curve is $y=-3x+3,$ which is not a hyperbola.\n\nSo, only statement II is true."}] [{:db/id #edb/ref 17592186348202 :knowledge-point/_questions [{:db/id #edb/ref 17592186119845 :knowledge-point/id #uuid "8a5d11c2-4a7c-5fdc-a363-8a87b90db19e" :knowledge-point/title "Finding the Dimension of a Span by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "335681e7-b21b-5519-b297-cb9882ea8e22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186345795} {:answer/id #uuid "36984861-0f30-58fb-9cad-98cc52ec0e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345821} {:answer/id #uuid "3ca26fe7-406c-5810-b03b-0112d32f0206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186345864} {:answer/id #uuid "49d1412f-0fd9-5d5a-9405-9347c3884dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345981} {:answer/id #uuid "d50a984f-a271-58db-8b8a-5011728ab2cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186347223}] :answer-field/correct {:answer/id #uuid "335681e7-b21b-5519-b297-cb9882ea8e22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186345795} :answer-field/id #uuid "8dc68fa8-6b14-57dc-ade7-cef32be5f365" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "550f63f1-7473-5fd5-bd68-1e9ff74a181b" :question/math-academy-id "q-79319" :question/problem "Determine the dimension of $\\text{Span}{[\\begin{aligned}-2 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 3\\end{aligned}]}.$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"}] [{:db/id #edb/ref 17592186351165 :knowledge-point/_questions [{:db/id #edb/ref 17592186119825 :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a265900-a14a-5877-aff1-d3aac3ca2423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}32 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186348533} {:answer/id #uuid "213cc60a-579c-525d-8bac-b2ac16a0ef45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186348732} {:answer/id #uuid "95e69f7a-4747-5a57-9458-e378d2d86baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{31}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186349792} {:answer/id #uuid "f22a76ba-f6d3-5c17-8bea-4d6cbf977c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}11 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350566} {:answer/id #uuid "fab7a2f0-417f-551c-ab1a-1c17871e8400" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ \\frac{32}{3}\\end{aligned}]" :db/id #edb/ref 17592186350654}] :answer-field/correct {:answer/id #uuid "213cc60a-579c-525d-8bac-b2ac16a0ef45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186348732} :answer-field/id #uuid "33e9a91c-32f6-5bae-a84f-52e57d050036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eedfab1-a2e1-5bd8-81d2-7c293aaffcd9" :question/math-academy-id "q-80828" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=3{b}_{2}$ and ${c}_{2}={b}_{1}+6{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=3{b}_{2} \\\\ {c}_{2}={b}_{1}+6{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{3}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+6(\\frac{1}{3}{c}_{1})\\,⟹\\,{b}_{1}={c}_{2}-2{c}_{1}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =-5{b}_{1}+2{b}_{2} \\\\  & =-5({c}_{2}-2{c}_{1})+2(\\frac{1}{3}{c}_{1}) \\\\  & =-5{c}_{2}+10{c}_{1}+\\frac{2}{3}{c}_{1} \\\\  & =\\frac{32}{3}{c}_{1}-5{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}].$"}]}
