mple {:db/id #edb/ref 17592186119636 :question/id #uuid "91fac4cd-7097-5244-a385-9f3f76395912" :question/math-academy-id "e-4829"} :knowledge-point/id #uuid "e568b6fc-88f0-592b-a24d-e3286cfa5043" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049060}] :knowledge-point/questions [{:db/id #edb/ref 17592186120361} {:db/id #edb/ref 17592186120532} {:db/id #edb/ref 17592186247308} {:db/id #edb/ref 17592186247309} {:db/id #edb/ref 17592186351164} {:db/id #edb/ref 17592186351165} {:db/id #edb/ref 17592186351169} {:db/id #edb/ref 17592186351171} {:db/id #edb/ref 17592186351270} {:db/id #edb/ref 17592186382414} {:db/id #edb/ref 17592186382434} {:db/id #edb/ref 17592186410058} {:db/id #edb/ref 17592186410062} {:db/id #edb/ref 17592186424437} {:db/id #edb/ref 17592186432499} {:db/id #edb/ref 17592186437064}] :knowledge-point/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"} :step/id #uuid "344d2e0b-3884-5f31-a733-c6d1b647154b" :step/math-academy-id 17521} {:db/id #edb/ref 17592186120763 :step/content {:db/id #edb/ref 17592186121070 :tutorial/content "Let $\\mathcal{B}= \\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be a basis of $\\mathbb{R}^2$ and ![](images/be/bec3577dd261660f2545adb66b9c26fbb520ea60aa6b0337094347dbc1937ff4.svg) What are the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{C}= \\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\},$ where $\\mathbf{b}_1 = 2\\mathbf{c}_1-\\mathbf{c}_2$ and $\\mathbf{b}_2 = \\mathbf{c}_1+\\mathbf{c}_2?$\n\nSince ![](images/20/200509c629fdf3d263ff375722f57ed77012a8a91a58a7e7f507fad3765b3782.svg) we can write the vector $\\mathbf{x}$ in terms of the vectors $\\mathbf c_1$ and $\\mathbf c_2,$ as follows:\n\n$$\n\\begin{aligned}x & =5{b}_{1}-2{b}_{2} \\\\  & =5(2{c}_{1}-{c}_{2})-2({c}_{1}+{c}_{2}) \\\\  & =10{c}_{1}-5{c}_{2}-2{c}_{1}-2{c}_{2} \\\\  & =8{c}_{1}-7{c}_{2}\\end{aligned}\n$$\n\nTherefore, ![](images/6b/6bc09e66faaef40bba491f31c9342d4d08a8fb6eb3fd4dd1a3e2acdd77421741.svg)" :tutorial/id #uuid "189050f1-7dc3-53be-a9f6-52abe95d9915" :tutorial/math-academy-id 4287 :tutorial/title "Writing a Vector in a Different Basis Given a Linear Relationship Between Two Bases"} :step/id #uuid "a41a07f8-567e-599b-ae5d-a130ad3aae2c" :step/math-academy-id 26017 :step/next {:db/id #edb/ref 17592186120702}}] :activity/title "Writing Vectors in Different Bases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120055}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186424440} :activity/id #uuid "f5cbb860-2adf-582c-a552-bdba6343726b" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186424438 :step/content {:db/id #edb/ref 17592186380636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eba5ccd-5c4e-5a36-a064-4ef635ea962c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186380638} {:answer/id #uuid "153e965c-0ba4-51b3-b2cc-0690963e8754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186380639} {:answer/id #uuid "26addb96-9bcf-50c8-96e8-46e354758c47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ -2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186380640} {:answer/id #uuid "3e6c74e4-e674-54ce-a79c-25df9fdacc3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186380641} {:answer/id #uuid "97952375-bc23-52ad-9a79-64c3a8443c09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186380642}] :answer-field/correct {:db/id #edb/ref 17592186380639} :answer-field/id #uuid "76499bf7-e986-58f6-9967-cfbce16c554a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380637}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7c19afb3-436b-5bc9-8f6f-99c189134e6d" :question/math-academy-id "q-112812" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}4 \\\\ -6 \\\\ 8\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=4{b}_{3}$, ${c}_{2}=2{b}_{1}$ and ${c}_{3}=3{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}4 \\\\ -6 \\\\ 8\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =4{b}_{1}-6{b}_{2}+8{b}_{3} \\\\  & =8{b}_{3}+4{b}_{1}-6{b}_{2} \\\\  & =2(4{b}_{3})+2(2{b}_{1})-2(3{b}_{2}) \\\\  & =2{c}_{1}+2{c}_{2}-2{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}2 \\\\ 2 \\\\ -2\\end{aligned}].$"} :step/id #uuid "7799965b-8388-5cb7-a5d4-d8203068d7c5" :step/next {:db/id #edb/ref 17592186424441}} {:db/id #edb/ref 17592186424439 :step/content {:db/id #edb/ref 17592186351164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b8abef8-6bb8-54af-9cab-7f8200ea2b4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186348983} {:answer/id #uuid "7d38cee2-216a-50f7-9ee2-2046c8fd2070" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186349595} {:answer/id #uuid "7f5e25ed-9a4e-51e9-91a9-88573309ce14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}7 \\\\ \\frac{29}{2}\\end{aligned}]" :db/id #edb/ref 17592186349614} {:answer/id #uuid "da13cf86-203f-5c39-afea-626810d1dd97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-7 \\\\ 29\\end{aligned}]" :db/id #edb/ref 17592186350359} {:answer/id #uuid "decdfd78-92ff-5e5e-bfcb-c0b319ddfdff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{29}{2} \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186350395}] :answer-field/correct {:db/id #edb/ref 17592186348983} :answer-field/id #uuid "c9346877-f860-5d75-8662-7c418ed4209e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186351058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c9bca47-36fc-5691-b4a4-81a309a1be29" :question/math-academy-id "q-80826" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=4{b}_{1}+{b}_{2}$ and ${c}_{2}=2{b}_{1}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=4{b}_{1}+{b}_{2} \\\\ {c}_{2}=2{b}_{1}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the second equation, we get \n\n$$\n{b}_{1}=\\frac{1}{2}{c}_{2}.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n{c}_{1}=4(\\frac{1}{2}{c}_{2})+{b}_{2}\\,⟹\\,{b}_{2}={c}_{1}-2{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -7\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-7{b}_{2} \\\\  & =\\frac{1}{2}{c}_{2}-7({c}_{1}-2{c}_{2}) \\\\  & =\\frac{1}{2}{c}_{2}-7{c}_{1}+14{c}_{2} \\\\  & =-7{c}_{1}+\\frac{29}{2}{c}_{1}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-7 \\\\ \\frac{29}{2}\\end{aligned}].$"} :step/id #uuid "97cd0ede-149c-58ac-816c-c5ea02b44304" :step/next {:db/id #edb/ref 17592186424442}} {:db/id #edb/ref 17592186424440 :step/content {:db/id #edb/ref 17592186351160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1521a735-440e-5594-83fc-552a8de81b4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186348626} {:answer/id #uuid "6a8320a6-b66a-50c6-966f-ec2b07922217" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186349430} {:answer/id #uuid "6f8ac099-04dd-5736-8947-f97096f61cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186349469} {:answer/id #uuid "ee795864-027f-5202-bbf2-2a8d67b17d4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186350530} {:answer/id #uuid "fc1f1b8a-56b4-5f6d-896b-8508eb1fe82d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186350670}] :answer-field/correct {:db/id #edb/ref 17592186348626} :answer-field/id #uuid "2b9dd274-e82b-583b-8183-dfabcc8cb925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350785}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5391d763-accb-53ad-9d75-896f6a1f5e41" :question/math-academy-id "q-80814" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -3 \\\\ 6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-{b}_{2}$, ${c}_{2}=2{b}_{3}$ and ${c}_{3}={b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}1 \\\\ -3 \\\\ 6\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-3{b}_{2}+6{b}_{3} \\\\  & =-3{b}_{2}+6{b}_{3}+{b}_{1} \\\\  & =3(-{b}_{2})+3(2{b}_{3})+{b}_{1} \\\\  & =3{c}_{1}+3{c}_{2}+{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}3 \\\\ 3 \\\\ 1\\end{aligned}].$"} :step/id #uuid "a9fec6b0-dfaa-5c4f-81aa-7c81022a0299" :step/next {:db/id #edb/ref 17592186424439}} {:db/id #edb/ref 17592186424441 :step/content {:db/id #edb/ref 17592186424437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a1b0ee-a4a2-5576-8c66-7aaec2ee0e69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186424424} {:answer/id #uuid "22b18ee1-002f-5c66-b260-413039c7fa38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186424426} {:answer/id #uuid "44ad6232-afa5-5eee-acd4-ac7923c6c4c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424427} {:answer/id #uuid "54f9c040-8ec5-5672-a995-f18c78ec39cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424429} {:answer/id #uuid "d19d735a-e23a-5d22-b726-fc09edb321eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424433}] :answer-field/correct {:db/id #edb/ref 17592186424426} :answer-field/id #uuid "f715ad10-8843-5e87-a878-4728db817271" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424435}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "462a3ac8-3692-5123-988e-2869c674b5a5" :question/math-academy-id "q-113098" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-8 \\\\ 6\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=-2{b}_{2}$ and ${c}_{2}=-2{b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=-2{b}_{2} \\\\ {c}_{2}=-2{b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=-\\frac{1}{2}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}=-2{b}_{1}+(-\\frac{1}{2}{c}_{1})\\,⟹\\,{b}_{1}=-\\frac{1}{4}{c}_{1}-\\frac{1}{2}{c}_{2}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-8 \\\\ 6\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =-8{b}_{1}+6{b}_{2} \\\\  & =-8(-\\frac{1}{4}{c}_{1}-\\frac{1}{2}{c}_{2})+6(-\\frac{1}{2}{c}_{1}) \\\\  & =2{c}_{1}+4{c}_{2}-3{c}_{1} \\\\  & =-{c}_{1}+4{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-1 \\\\ 4\\end{aligned}].$"} :step/id #uuid "cd647117-0e03-5826-88fa-9a59e5ad55dc"} {:db/id #edb/ref 17592186424442 :step/content {:db/id #edb/ref 17592186424436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec99580-87ff-5cfa-9a50-83210750a588" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424425} {:answer/id #uuid "48c04403-8948-5cde-b72e-bcbd3cd68850" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186424428} {:answer/id #uuid "75100d18-03f7-5132-bc07-08e656b29767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424430} {:answer/id #uuid "8e9f3805-6ec3-52b0-8981-651c4924ab5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-2 \\\\ -1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186424431} {:answer/id #uuid "90fa75ef-f7b2-5f35-896b-4536657baef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186424432}] :answer-field/correct {:db/id #edb/ref 17592186424431} :answer-field/id #uuid "f107fe79-1c11-5ad7-9f21-fcda8e8329e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424434}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22cb5720-988d-5f1f-bf8b-00932134f7ba" :question/math-academy-id "q-112811" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}3 \\\\ 6 \\\\ -2\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-3{b}_{2}$, ${c}_{2}=2{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}3 \\\\ 6 \\\\ -2\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =3{b}_{1}+6{b}_{2}-2{b}_{3} \\\\  & =6{b}_{2}-2{b}_{3}+3{b}_{1} \\\\  & =-2(-3{b}_{2})-2{b}_{3}+3{b}_{1} \\\\  & =-2{c}_{1}-{c}_{2}+{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-2 \\\\ -1 \\\\ 1\\end{aligned}].$"} :step/id #uuid "f34e855c-28a1-5a95-b5a6-a3a724cc50d7" :step/next {:db/id #edb/ref 17592186424438}}] :activity/title "Writing Vectors in Different Bases" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424423}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186437068} :activity/id #uuid "0c84172f-333c-5d02-8355-912cd7cfa911" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186437065 :step/content {:db/id #edb/ref 17592186351269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278b95ec-9543-5b30-8694-705447b2953b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ 8 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186348788} {:answer/id #uuid "29c427aa-c438-59b7-8563-b8b32e5248b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}5 \\\\ 4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186348814} {:answer/id #uuid "db1f2b2a-d728-5c5c-9080-4a279744ceb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350368} {:answer/id #uuid "dfb90321-e3c6-5d76-9f86-67160a3d6885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ -6 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186350406} {:answer/id #uuid "e4d32b6e-0307-52a7-92e6-dc39f86df2b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 5 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186350452}] :answer-field/correct {:db/id #edb/ref 17592186350368} :answer-field/id #uuid "3435a83d-541e-550d-b30c-5b4a35d85a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350797}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a06d0486-59a2-551d-a3de-4b2482e5c06f" :question/math-academy-id "q-81228" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=3{b}_{2}$, ${c}_{2}=-6{b}_{3}$ and ${c}_{3}=3{b}_{1}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}15 \\\\ -24 \\\\ 18\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =15{b}_{1}-24{b}_{2}+18{b}_{3} \\\\  & =-24{b}_{2}+18{b}_{3}+15{b}_{1} \\\\  & =-8(3{b}_{2})-3(-6{b}_{3})+5(3{b}_{1}) \\\\  & =-8{c}_{1}-3{c}_{2}+5{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-8 \\\\ -3 \\\\ 5\\end{aligned}].$"} :step/id #uuid "0e41dcfd-ebac-5aca-b944-04ffca0796dd" :step/next {:db/id #edb/ref 17592186437067}} {:db/id #edb/ref 17592186437066 :step/content {:db/id #edb/ref 17592186437063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a201169-6127-5146-ac33-370dbaeb9fed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186437052} {:answer/id #uuid "6d16febb-185e-5f02-b767-d0d169b5dbfe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}4 \\\\ 5 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437053} {:answer/id #uuid "7cf45f1d-e7fe-5ad3-af94-a089a9eeec5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437054} {:answer/id #uuid "e664d5e6-21e0-5873-967f-9bc8ff95c930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{8}{5} \\\\ \\frac{2}{3} \\\\ -\\frac{3}{4}\\end{aligned}]" :db/id #edb/ref 17592186437057} {:answer/id #uuid "eb796ee2-fa6f-5226-9fdb-c601791894cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186437060}] :answer-field/correct {:db/id #edb/ref 17592186437052} :answer-field/id #uuid "5dfb7050-a4fe-5646-9ebf-d0c4cc689423" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437061}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "52843c58-6ada-5ce6-8fe3-a0a1c897ac6d" :question/math-academy-id "q-80817" :question/problem "Let $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ be a basis of ${R}^{3}$ and $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2},{c}_{3}\\},$ where ${c}_{1}=-4{b}_{3}$, ${c}_{2}=5{b}_{1}$ and ${c}_{3}=-3{b}_{2}?$" :question/worked-solution "Since $[x]_{B}=[\\begin{aligned}8 \\\\ -2 \\\\ 3\\end{aligned}]$, we can write $x$ as follows:\n\n$$\n\\begin{aligned}x & =8{b}_{1}-2{b}_{2}+3{b}_{3} \\\\  & =3{b}_{3}+8{b}_{1}-2{b}_{2} \\\\  & =-\\frac{3}{4}(-4{b}_{3})+\\frac{8}{5}(5{b}_{1})+\\frac{2}{3}(-3{b}_{2}) \\\\  & =-\\frac{3}{4}{c}_{1}+\\frac{8}{5}{c}_{2}+\\frac{2}{3}{c}_{3}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-\\frac{3}{4} \\\\ \\frac{8}{5} \\\\ \\frac{2}{3}\\end{aligned}].$"} :step/id #uuid "59637308-9cf1-5b00-baa5-bb0d666676d8" :step/next {:db/id #edb/ref 17592186437065}} {:db/id #edb/ref 17592186437067 :step/content {:db/id #edb/ref 17592186437064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4d1efa-0b11-5604-b83d-1cafc0e12e97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}6 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437051} {:answer/id #uuid "c9b65cef-3b11-5aa5-8c39-6a1bd856ef09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437055} {:answer/id #uuid "cb6a6cb4-14b9-5dc8-a71d-66abf40eedf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186437056} {:answer/id #uuid "e6f678ca-51ca-5faa-80f3-6687002731fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{1}{2} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186437058} {:answer/id #uuid "e97d3d12-325a-5425-988a-d90f7923ca9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186437059}] :answer-field/correct {:db/id #edb/ref 17592186437059} :answer-field/id #uuid "c70a1919-efd3-511f-9ea6-f55df071b113" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186437062}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b0e4cc3b-3144-5373-932e-12723fa2aecf" :question/math-academy-id "q-112862" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=2{b}_{2}$ and ${c}_{2}={b}_{1}+{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=2{b}_{2} \\\\ {c}_{2}={b}_{1}+{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{2}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+(\\frac{1}{2}{c}_{1})\\,⟹\\,{b}_{1}=-\\frac{1}{2}{c}_{1}+{c}_{2}.\n$$\n\n \n\nSince $[x]_{B}=[\\begin{aligned}1 \\\\ -5\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & ={b}_{1}-5{b}_{2} \\\\  & =-\\frac{1}{2}{c}_{1}+{c}_{2}-5(\\frac{1}{2}{c}_{1}) \\\\  & =-\\frac{6}{2}{c}_{1}+{c}_{2} \\\\  & =-3{c}_{1}+{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$"} :step/id #uuid "97825df6-b0ae-5545-b8e4-947e68d7f416" :step/next {:db/id #edb/ref 17592186437069}} {:db/id #edb/ref 17592186437068 :step/content {:db/id #edb/ref 17592186321001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1f3a69-7740-5aa2-925c-53c1ce3286b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186319532} {:answer/id #uuid "66b1a873-459f-552e-a7e5-027c42c7521c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-\\frac{5}{2} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186319705} {:answer/id #uuid "8891e75e-27cb-5964-9e25-018084c2ca28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}2 \\\\ -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186319799} {:answer/id #uuid "9d0ae0bb-3fdb-536c-8