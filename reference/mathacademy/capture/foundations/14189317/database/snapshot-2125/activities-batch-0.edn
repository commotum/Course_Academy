ef 17592186459877} :answer-field/id #uuid "4016c208-5132-52ca-9a94-45c02d928df9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460805} {:answer-field/choices [{:answer/id #uuid "b030eebf-9f96-541c-90b5-e11292ebe597" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459879} {:answer/id #uuid "99d9245a-b26b-504e-872d-b0683ba7eeff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459880}] :answer-field/correct {:db/id #edb/ref 17592186459880} :answer-field/id #uuid "411d20a9-891c-5142-a326-3f8734eb565f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460806} {:answer-field/choices [{:answer/id #uuid "c65a8236-1fb5-5f5f-9b24-1401e140dfcd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186459881} {:answer/id #uuid "a16c0f21-d8cc-5644-b977-7a9c0d956a93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186459882}] :answer-field/correct {:db/id #edb/ref 17592186459881} :answer-field/id #uuid "791a2484-953d-5785-9ff6-1001a3e16b51" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186460807}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "592215bc-9340-546e-9e8f-8c90c87cd2d2" :question/math-academy-id "q-36829" :question/problem "The level curves of the function $f(x,y)={x}^{3}y-{y}^{2}x$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=-1$ gives a line\n- **II.** $c=0$ gives a parabola and the axes $x=0$ and $y=0$\n- **III.** $c=1$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}{x}^{3}y-{y}^{2}x & =c \\\\ xy({x}^{2}-y) & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=\\pm 1$ then the level curves are $xy({x}^{2}-y)=\\pm 1,$ which are not lines.\n\n- If $c=0$ then the level curves are $xy({x}^{2}-y)=0,$ which consists of the axes $x=0$ and $y=0$, and the parabola $y={x}^{2}.$\n\nSo, only statement II is true."} :step/id #uuid "21b773b4-bd95-5150-b031-ba25c0bc0edb" :step/next {:db/id #edb/ref 17592186421496}} {:db/id #edb/ref 17592186421494 :step/content {:db/id #edb/ref 17592186262943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b8f524a-9681-5a5a-aa6a-8d21d370c6a6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef27f12eb1ee6872210bf8cadb6908efd31c1bb54e9e7d34cc3456df2ee03a77.png" :db/id #edb/ref 17592186260656} {:answer/id #uuid "90a9daad-d37b-5bdf-8f0c-1e578a2870e2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186261134} {:answer/id #uuid "a19c1461-ef0c-529e-9726-029d4c772ce7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2c570cc9958db69a30dc400920b6ff27574e79bd26a53b35e086cb03034c5b6d.png" :db/id #edb/ref 17592186261280} {:answer/id #uuid "c30db028-ad8b-5802-9d7d-fe2ee0d636d7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png" :db/id #edb/ref 17592186261596} {:answer/id #uuid "d4894fee-b5e1-59e2-86ca-ba516e7266bf" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d774c444ad33c68ec5d507611324030f2005671265ba5f855f322d8db57b69b4.png" :db/id #edb/ref 17592186261746}] :answer-field/correct {:db/id #edb/ref 17592186261596} :answer-field/id #uuid "93f1dce4-27ec-501b-8cb3-8ca95b44d739" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262388}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ae6e3096-5c3b-5202-84b9-abfe5e790c65" :question/math-academy-id "q-129113" :question/problem "Which of the following represents the level curves of $f(x,y)=3\\operatorname{sin}⁡x?$" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-3,3].$ So, we will consider only $c$-level curves for $c\\in [-3,3].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 3\\operatorname{sin}⁡x & =c \\\\ x & =\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $x=\\operatorname{arcsin}⁡\\frac{c}{3}+2\\pi n$ do not depend on $y.$ So, for a given $c\\in [-3,3]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of vertical lines, as shown below.\n\n![](images/cd/cdd8cec2d30ff2956d5210a49036c17d99781d0b62c0b0f42f97d0575c4d80f6.png)"} :step/id #uuid "35ace902-fd84-5342-8e5b-38d0d8036933" :step/next {:db/id #edb/ref 17592186421497}} {:db/id #edb/ref 17592186421495 :step/content {:db/id #edb/ref 17592186387992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ffca37-cace-5fde-98f2-279fdf4f3975" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/56/56e923e4c1e2603c9bd3c621df0a5a4043fcc6a37ac73427be14541407fc19d8.png" :db/id #edb/ref 17592186387994} {:answer/id #uuid "9ef1d420-a12a-56ca-a25f-8624b9640b47" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09f1a18e1a6fdcd29a40026cbffd8e8bdec23511bb692a1e920c18f942042470.png" :db/id #edb/ref 17592186387995} {:answer/id #uuid "6719fa96-fc32-59ff-ad37-8586f87f620f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/id #edb/ref 17592186387996} {:answer/id #uuid "2c7de16e-8fae-51b2-b167-c594ccf39873" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aa4d0cd189808c717648640c5543a632c099970a19d38d44298d409054f2627c.png" :db/id #edb/ref 17592186387997} {:answer/id #uuid "3995e781-cbde-5cfd-b61f-9c376d6d3f49" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bf/bf0f4b592cde648f63b21523aba1a49aeeb3b4dcaf909ba72c4629e088ca372a.png" :db/id #edb/ref 17592186387998}] :answer-field/correct {:db/id #edb/ref 17592186387996} :answer-field/id #uuid "5053c438-eb23-5e9c-bd54-db15189721dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387993}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9ec437fa-7d05-53d2-8259-19727f28f519" :question/math-academy-id "q-129117" :question/problem "![](images/03/037422e7b1ce3b3d9067aba39c4fa85c6311770e63e70758c34aa61629c7f58e.png)\n\nWhich of the following could represent the level curves of the surface $z=-\\operatorname{sin}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -\\operatorname{sin}⁡y & =c \\\\ y & =-\\operatorname{arcsin}⁡c+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $y=-\\operatorname{arcsin}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png)"} :step/id #uuid "6ed691e2-551c-53fd-a582-b1d42ed0b3f6"} {:db/id #edb/ref 17592186421496 :step/content {:db/id #edb/ref 17592186338937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0a2c4b-1d93-5837-bae6-4a3c28e16089" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467848} {:answer/id #uuid "14a75206-caba-527a-ab7a-6a2b9a8d8748" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467849}] :answer-field/correct {:db/id #edb/ref 17592186467848} :answer-field/id #uuid "19c95e90-566c-5c73-bd5c-bb5cbff441a5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468645} {:answer-field/choices [{:answer/id #uuid "eb7223c5-838d-5ef7-859b-ec117f5a0b9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467850} {:answer/id #uuid "83112c20-89a5-5790-800e-3e3c93383a93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467851}] :answer-field/correct {:db/id #edb/ref 17592186467851} :answer-field/id #uuid "cd2bacc0-d212-57b2-89ee-6c74f13e09de" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468646} {:answer-field/choices [{:answer/id #uuid "8c053cde-7b3e-5844-88a1-fbf51c0cc806" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467852} {:answer/id #uuid "0514df20-5bca-51ca-8efc-b76c2c3044a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467853}] :answer-field/correct {:db/id #edb/ref 17592186467853} :answer-field/id #uuid "0a2ff425-5344-55a6-a715-3662f57b95c1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468647}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b94a6f8a-60a9-5806-9e18-4814d39c5835" :question/math-academy-id "q-71395" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}-2{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=1$ gives a line\n- **II.** $c=2$ gives a hyperbola\n- **III.** $c=0$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-2{y}^{2}} & =c \\\\ {x}^{2}-2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${x}^{2}-2{y}^{2}=1,$ which is not a line.\n\n- If $c=2$ then the level curve is ${x}^{2}-2{y}^{2}=4,$ which is a hyperbola.\n\n- If $c=0$ then the level curve is $y=\\pm \\frac{x}{\\sqrt{2}},$ which consists of two lines.\n\nSo, only statements II and III are true."} :step/id #uuid "d24eeca1-18a8-58f3-b314-b346d5df791c" :step/next {:db/id #edb/ref 17592186421494}} {:db/id #edb/ref 17592186421497 :step/content {:db/id #edb/ref 17592186421492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cac3057-4676-5ed3-95e8-e4e063eba65b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ae/ae78f21487e5883b278f0b62a92b2b44ffe8e83e9bd942cf6c94ed4c46d18c67.png" :db/id #edb/ref 17592186421486} {:answer/id #uuid "61cd2c81-8156-5dbe-b41f-65c5a923eb06" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e4/e405503abc7c773cde77a3631e3e39ed1693e3aac958731a9a8ae52e618b03fa.png" :db/id #edb/ref 17592186421487} {:answer/id #uuid "928d4148-96cc-555a-8460-275af511b8a3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f9/f9f6a496ebabedfb6f73db014080b64a3830214b337bd61c4ac4f4d996a93bd5.png" :db/id #edb/ref 17592186421488} {:answer/id #uuid "b23cb473-4c8b-55bf-98c3-c301ef278556" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3d/3d7cde978fe7dd74efe8deb0b7b6e507c7ddf549bb45f1eeda81ee82a8b4a002.png" :db/id #edb/ref 17592186421489} {:answer/id #uuid "ed3cc711-dc0b-5b9e-a281-a519fe0fd7e8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ff/ff1117065d7475786dd6c45f71f14d78b32cb3273123ced1adf5a67b750dacdd.png" :db/id #edb/ref 17592186421490}] :answer-field/correct {:db/id #edb/ref 17592186421490} :answer-field/id #uuid "6a04a0ad-4057-596b-b2f3-8b4c7bc755f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186421491}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ca25fed3-89e3-5069-b0f1-d69395195a30" :question/math-academy-id "q-129115" :question/problem "Which of the following represents the level curves of $f(x,y)=2x+y?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 2x+y & =c \\\\ y & =-2x+c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-2.$ Therefore, the correct graph is as follows:\n\n![](images/ff/ff1117065d7475786dd6c45f71f14d78b32cb3273123ced1adf5a67b750dacdd.png)"} :step/id #uuid "d88cafd9-c924-5a6c-a387-1de1666c815e" :step/next {:db/id #edb/ref 17592186421495}}] :activity/title "Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421485}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186459326} :activity/id #uuid "050a47c1-467f-5f12-8f61-8827d230183c" :activity/scope {:db/id #edb/ref 17592186049882 :topic/id #uuid "1ad374f3-e4f4-5dcc-ab6d-d6aed0790f3a" :topic/math-academy-id 1900} :activity/steps [{:db/id #edb/ref 17592186459313 :step/content {:db/id #edb/ref 17592186392877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5081b5a-0a05-566f-ac65-b452778b3dff" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png" :db/id #edb/ref 17592186392879} {:answer/id #uuid "1048cbeb-b7a7-5613-93ec-38f4f470c459" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6fcb4286cb1d3a0c850e1a5280558ed793b45766359fe796d37e9ff92110300.png" :db/id #edb/ref 17592186392880} {:answer/id #uuid "7aa3bf7c-ba72-5347-9c51-9a74af107731" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f3/f33a74f9c61703628cd53576dc12b8a02d67944dccd70e3ea6d1be88ba3fa5d8.png" :db/id #edb/ref 17592186392881} {:answer/id #uuid "36e0d7fc-bba4-5076-b14a-e8abbe7e10db" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2c5dda31d349fb26df687cbe59af5ac163380ae7359561c6809737149f4772a3.png" :db/id #edb/ref 17592186392882} {:answer/id #uuid "73047cd2-2772-59bd-ba1e-8f58e56dc0d8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/408a028814088bbb85e20e52e9482a0ddfd0b21fcf70470196049c6b5f37a208.png" :db/id #edb/ref 17592186392883}] :answer-field/correct {:db/id #edb/ref 17592186392879} :answer-field/id #uuid "a113a983-a1ee-554f-9f6d-a9c10a34e3bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392878}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2b2fff3-d401-5946-82c7-5c2974317dd2" :question/math-academy-id "q-64717" :question/problem "![](images/36/36bbd69dec59657a74992dbddced8b87190f953687e0d84aa8f3081e8754789c.png)\n\nWhich of the following could represent the level curves of the surface $z=\\operatorname{cos}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\operatorname{cos}⁡y & =c \\\\ y & =\\pm \\operatorname{arccos}⁡c+2\\pi n\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that in the equations $y=\\pm \\operatorname{arccos}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n$$\n\n$$\n\n![](images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png)"} :step/id #uuid "0c389e51-5208-5b51-8548-4475cba0a511" :step/next {:db/id #edb/ref 17592186459321}} {:db/id #edb/ref 17592186459321 :step/content {:db/id #edb/ref 17592186459278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347f9956-ca4d-503b-8dc1-5e2ad6f7baa5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d1/d1f74734b0de333c0d10a4118d155414c8ced81975bf1321304eeb5059428010.png" :db/id #edb/ref 17592186458731} {:answer/id #uuid "3c0be70e-cf9a-5c38-bf4d-fa0332e77895" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2f/2f267c81217b5873f69d332867b6d655ffaca26397fe02e2e0fb8568277da937.png" :db/id #edb/ref 17592186458741} {:answer/id #uuid "9a36a621-d7aa-5f31-9f47-2f486d5af260" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b809fecaefd763b18eb6bf89942eaeea49d4d69a54d6c748ae501c2f38a3a82f.png" :db/id #edb/ref 17592186458900} {:answer/id #uuid "9aee8bca-b2b1-5ab1-b6c2-2b13877ddde0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" :db/id #edb/ref 17592186458901} {:answer/id #uuid "bff6924d-4d2a-5f8c-8acd-1f03b2ba5c8f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/dc/dc2dac71b2fc7486e7fee2bc7dcbab8722e9fcbd60369d670e7dfb02009bf2c9.png" :db/id #edb/ref 17592186458973}] :answer-field/correct {:db/id #edb/ref 17592186458901} :answer-field/id #uuid "8e7bf0d5-3d69-5131-80bd-bb7c9041b796" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186459146}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b6a9287f-9c6d-59af-b885-5fcb5a380cae" :question/math-academy-id "q-64979" :question/problem "![](images/ff/ffef2a7d5f82bf9d46cb99913c9de149f85b948180047ae96d9c03c69f88c181.png)\n\nWhich of the following could represent the level curves of the surface $z=3-2x-3y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ 3-2x-3y & =c \\\\ y & =-\\frac{2}{3}x+1-\\frac{c}{3}\\end{aligned}\n$$\n\nSo, for any real value of $c$, the right-hand side of an equation is the equation of a line. As a result, we obtain a family of lines with slope $-\\frac{2}{3}$, as shown below.\n\n$$\n\n$$\n\n![](images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png)"} :step/id #uuid "35fc01ec-2fc9-5d0e-966d-f82bec64afe8" :step/next {:db/id #edb/ref 17592186459330}} {:db/id #edb/ref 17592186459322 :step/content {:db/id #edb/ref 17592186262944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f81b229-411e-50ec-868a-e71357c6d344" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/id #edb/ref 17592186260146} {:answer/id #uuid "2e72b69e-de1d-539b-bd7f-b17ba3bb78bc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/0162f31b5dbb35c6d370dff9b54257708df39b6957f6547059842cd31769669b.png" :db/id #edb/ref 17592186260294} {:answer/id #uuid "7d7ac9b2-3db3-5b9c-a04a-a8589af15779" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b4/b4642ea9b585ac066f2ed904b1bee4df7d1ff3449ba2d09afca8364b58f1dcba.png" :db/id #edb/ref 17592186260967} {:answer/id #uuid "867c8bfd-8db7-54f2-837f-8096fc36058e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7a/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/id #edb/ref 17592186261045} {:answer/id #uuid "bebf2ce8-badd-5f41-86c5-5e5bb4040e73" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f8/f82efe38e48f39aee18cf9e00cdd69f07c37cc414b08b5bc78ebc0a876c02d7e.png" :db/id #edb/ref 17592186261560}] :answer-field/correct {:db/id #edb/ref 17592186261045} :answer-field/id #uuid "12e3878f-62b0-500f-bf38-893dbf70a32f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7f1a9983-9e78-5286-9a4c-31363bd01bd7" :question/math-academy-id "q-129118" :question/problem "Which of the following represents the level curves of $f(x,y)=-x-y+2?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nnotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -x-y+2 & =c \\\\ y & =-x+2-c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-1.$ Therefore, the correct graph is as follows:\n\n![](images/e2/e20175ef9ac473a621a67d524e60cacc6e9a40ba30267fe81b4e6a093c780c28.png)"} :step/id #uuid "41e20964-1263-5e71-a909-f0f937a95100"} {:db/id #edb/ref 17592186459326 :step/content {:db/id #edb/ref 17592186379766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5582e4fd-2c1b-5d7e-8c00-e97e06814dbd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471447} {:answer/id #uuid "a3eb097d-ca23-5819-ac10-dc59c55d7b1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471448}] :answer-field/correct {:db/id #edb/ref 17592186471448} :answer-field/id #uuid "d03efb8d-a67e-5194-9397-44b10a9fe206" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472229} {:answer-field/choices [{:answer/id #uuid "398cb7dd-8121-5f92-b1f8-3cb5dfa077bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471449} {:answer/id #uuid "835ea12a-0dec-59ad-8c9d-1e2c535804ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471450}] :answer-field/correct {:db/id #edb/ref 17592186471449} :answer-field/id #uuid "671dd875-2b17-5bf5-8cd4-e539f182cfa9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472230} {:answer-field/choices [{:answer/id #uuid "c761f2b5-ba81-5508-8846-69bc0e2a0948" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471451} {:answer/id #uuid "e051646c-5725-58cc-bba2-10290a7faee3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471452}] :answer-field/correct {:db/id #edb/ref 17592186471451} :answer-field/id #uuid "ac6ae07c-0a83-5d77-ab7d-cfed78b60de1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472231}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "036af2f8-8d3f-5a9f-9714-c21bb558dc15" :question/math-academy-id "q-35538" :question/problem "The level curves of the function $f(x,y)=4x-3y-1$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=-1$ gives a line\n- **II.** $c=0$ gives the axes $x=0$ and $y=0$\n- **III.** $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4x-3y-1 & =c \\\\ 4x-3y-(c+1) & =0 \\\\ y & =\\frac{4}{3}x-\\frac{c+1}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1$ then the level curve is $y=\\frac{4}{3}x,$ which is a line.\n\n- If $c=0$ then the level curve is $y=\\frac{4}{3}x-\\frac{1}{3},$ which is a line different to the axes $x=0$ and $y=0.$\n\n- If $c=2$ then the level curve is $y=\\frac{4}{3}x-1,$ which is not a parabola.\n\nSo, only statement I is true."} :step/id #uuid "6f39d2b2-32b1-5292-ba83-1e03f25801e3" :step/next {:db/id #edb/ref 17592186459313}} {:db/id #edb/ref 17592186459330 :step/content {:db/id #edb/ref 17592186371742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d59b3d7b-2c37-5359-93f8-d192269d5067" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186470979} {:answer/id #uuid "ae0bb8f9-8485-5cfe-ab25-043cbc708f51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186470980}] :answer-field/correct {:db/id #edb/ref 17592186470980} :answer-field/id #uuid "146a2344-578d-5672-a271-50b88fd4f3f6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186471995} {:answer-field/choices [{:answer/id #uuid "93422712-e5a0-55d3-b546-eb39f8114c5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186470981} {:answer/id #uuid "381719ea-dfe9-56ca-b1c4-648a69f283b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186470982}] :answer-field/correct {:db/id #edb/ref 17592186470982} :answer-field/id #uuid "965cc361-b43b-525a-b426-5e5b2f07eb8e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186471996} {:answer-field/choices [{:answer/id #uuid "26a45c3b-1449-5b78-a19d-8f000aabeace" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186470983} {:answer/id #uuid "1e276396-1a9d-5de8-bbc0-32373a1fa78a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186470984}] :answer-field/correct {:db/id #edb/ref 17592186470983} :answer-field/id #uuid "c6cfc70f-9735-5a2a-bc4c-91a5d4a564a7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186471997}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ee3c74bd-cd07-5dd0-b26f-4b93aa9647b3" :question/math-academy-id "q-129061" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n- **I.** $c=0$ gives the point $(0,0)$\n- **II.** $c=1$ gives a circle of radius $1$\n- **III.** $c=4$ gives a parabola\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+{y}^{2}} & =c \\\\ {x}^{2}+{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0,$ the level curve is $x=y=0,$ which gives the point $(0,0).$ So, I is true.\n\n- If $c=1,$ the level curve is ${x}^{2}+{y}^{2}=1,$ which gives a circle of radius $1.$ So, II is true.\n\n- If $c=4,$ the level curve is ${x}^{2}+{y}^{2}=16,$ which gives a circle of radius $4.$ So, III is false.\n\nSo, the correct answer is \"I and II only\"."} :step/id #uuid "93acc85b-87ab-56b3-b7b9-af08ebc81605" :step/next {:db/id #edb/ref 17592186459322}}] :activity/title "Level Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186458609}]}
