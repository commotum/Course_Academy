c/math-academy-id 3028} :activity/steps [{:db/id #edb/ref 17592186436003 :step/content {:db/id #edb/ref 17592186435999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e8d53a-c37d-54b9-846a-15a7e518c2f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186435975} {:answer/id #uuid "60665ee3-a83d-5432-a05d-60a88ce923d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186435978} {:answer/id #uuid "b143f08b-1cca-5921-99e5-5bc87f00cffc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435985} {:answer/id #uuid "d253879a-8d9a-5864-96bf-478e85b5c3b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186435989} {:answer/id #uuid "d97479d6-3612-564b-bc2b-b05d469953d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186435991}] :answer-field/correct {:db/id #edb/ref 17592186435991} :answer-field/id #uuid "a48e8e98-7e33-5d3a-b817-98548380f899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5de95c02-fd0e-5b80-9aec-f79ce1a6a7f4" :question/math-academy-id "q-109040" :question/problem "$\\text{Var}[4]=$" :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore,\n\n$$\n\\text{Var}[4]=0.\n$$"} :step/id #uuid "08e8ef20-2a38-5e05-81da-697f538105e5" :step/next {:db/id #edb/ref 17592186436007}} {:db/id #edb/ref 17592186436004 :step/content {:db/id #edb/ref 17592186436002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34fbef3e-ce0c-5e42-8083-bb856bed6a54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186435977} {:answer/id #uuid "87337578-c732-5754-be09-02283229f965" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186435982} {:answer/id #uuid "9b8996e1-6f9f-5075-9e74-0c9956ec327f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186435983} {:answer/id #uuid "cad3e623-6a5f-55d5-841b-565c29e0e0bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186435988} {:answer/id #uuid "d315913a-19d5-543a-b877-666f53b9143f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186435990}] :answer-field/correct {:db/id #edb/ref 17592186435988} :answer-field/id #uuid "abd7ad31-b561-5286-91ce-40ec287b64f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435997}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f691affc-d374-513b-ace4-47b0fed08cd8" :question/math-academy-id "q-129394" :question/problem "If $\\text{Var}[X]=100,$ calculate $\\text{Var}[3-0.2X].$" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-0.2$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[3-0.2X] & ={(-0.2)}^{2}\\cdot \\text{Var}[X] \\\\  & =0.04\\cdot 100 \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "a774054b-3577-5411-a266-873c0fe2ca4a"} {:db/id #edb/ref 17592186436005 :step/content {:db/id #edb/ref 17592186436000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "771854e8-d892-5203-a97d-09439ca5fe0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186435979} {:answer/id #uuid "7efbea4c-7fba-5238-8596-49239d557793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186435980} {:answer/id #uuid "8456a043-c86f-5008-9d67-2741aff12dc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186435981} {:answer/id #uuid "b334ddce-463a-5f5a-8086-6f71f3ca1947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186435986} {:answer/id #uuid "e9634791-3b57-5087-836f-34d41f943f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186435993}] :answer-field/correct {:db/id #edb/ref 17592186435981} :answer-field/id #uuid "49d01f52-f12f-5f40-8306-2b10fa6ebffd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435995}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab459c95-a786-5463-b6df-ba7f08de2795" :question/math-academy-id "q-109070" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=\\frac{9}{2},$ calculate $\\text{Var}[\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $3$ | $6$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\frac{1}{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{2}X] & ={(\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=\\frac{9}{2}.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{3}^{2}\\cdot f(3)+{6}^{2}\\cdot f(6) \\\\  & =9\\cdot \\frac{1}{4}+36\\cdot \\frac{5}{8} \\\\  & =\\frac{99}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{99}{4}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{2} \\\\  & =\\frac{9}{8}.\\end{aligned}\n$$"} :step/id #uuid "b23b860b-4012-51e9-9c6f-d158c0177636" :step/next {:db/id #edb/ref 17592186436006}} {:db/id #edb/ref 17592186436006 :step/content {:db/id #edb/ref 17592186420139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcfce52-9f77-594e-abb6-a96da80d166b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.2" :db/id #edb/ref 17592186420112} {:answer/id #uuid "5dae0172-10cc-5060-bf4a-315f77dba9a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420115} {:answer/id #uuid "6657c628-8660-5023-8ee0-945dab5715e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186420117} {:answer/id #uuid "95c4162c-b36b-54af-9f0c-c093bb7cac5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.1" :db/id #edb/ref 17592186420119} {:answer/id #uuid "e3fddd96-3d89-5025-83fd-0275af9c34a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186420126}] :answer-field/correct {:db/id #edb/ref 17592186420126} :answer-field/id #uuid "53761adc-2f46-5607-b9dd-4ae8e7e441a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420133}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "64dd6f3a-caa4-5c03-ba3a-d02448881df5" :question/math-academy-id "q-129381" :question/problem "$\\text{Var}[0.2]=$" :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore,\n\n$$\n\\text{Var}[0.2]=0.\n$$"} :step/id #uuid "d680df42-9af5-5d8e-85c5-ee68af73edc3" :step/next {:db/id #edb/ref 17592186436004}} {:db/id #edb/ref 17592186436007 :step/content {:db/id #edb/ref 17592186436001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cce534e-4802-5d94-97bf-80beed889e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "73" :db/id #edb/ref 17592186435976} {:answer/id #uuid "a997e5ce-81f8-5baf-8303-e27befaf4b42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186435984} {:answer/id #uuid "bd1bccd5-410f-5b91-93ca-dbe4d676607f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186435987} {:answer/id #uuid "e6c7e480-2dae-55a9-9956-216be43bcfc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{49}" :db/id #edb/ref 17592186435992} {:answer/id #uuid "f5361e88-3d20-5f4f-860f-c82dceb66009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186435994}] :answer-field/correct {:db/id #edb/ref 17592186435984} :answer-field/id #uuid "cee9d609-cf3a-562f-9f5d-2dd12fbb70da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186435998}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eff26da6-299d-5b1f-93b8-02b4dbf809cb" :question/math-academy-id "q-109064" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=3,$ calculate $\\text{Var}[7X].$ \n\n| $x$ | $1$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{7}$ | $\\frac{2}{7}$ | $\\frac{4}{7}$ |" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=7.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[7X] & ={7}^{2}\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=3.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =1\\cdot \\frac{1}{7}+4\\cdot \\frac{2}{7}+16\\cdot \\frac{4}{7} \\\\  & =\\frac{73}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{73}{7}-{3}^{2} \\\\  & =\\frac{10}{7}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[7X] & =49\\cdot \\text{Var}[X] \\\\  & =49\\cdot \\frac{10}{7} \\\\  & =70.\\end{aligned}\n$$"} :step/id #uuid "de016c0c-5fd8-5def-85ac-87352e4b87f8" :step/next {:db/id #edb/ref 17592186436005}}] :activity/title "Properties of Variance for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186435974}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186503791} :activity/id #uuid "ac400bfc-dddd-51ec-a245-6492bc2ea2af" :activity/scope {:db/id #edb/ref 17592186048731 :topic/id #uuid "b99b224f-8118-53d5-8d6e-c47785040b57" :topic/math-academy-id 3028} :activity/steps [{:db/id #edb/ref 17592186503772 :step/content {:db/id #edb/ref 17592186420138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fcdc20-d9ce-5918-a799-224704442b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186420107} {:answer/id #uuid "954c32d9-778b-5b43-8961-535d53b7d6f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186420118} {:answer/id #uuid "e64a66c3-6dac-5766-9242-dc560f828481" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186420127} {:answer/id #uuid "f1ae131d-893b-5552-852c-ce4ade2b310c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186420129} {:answer/id #uuid "fda015bf-920f-56ce-89d7-ad20ffbb10db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186420130}] :answer-field/correct {:db/id #edb/ref 17592186420118} :answer-field/id #uuid "190cfb56-9bd3-537b-9e67-03ec6f08f929" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420131}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "34f8f239-f24a-50f7-8925-78cd969b209c" :question/math-academy-id "q-109079" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=\\frac{9}{2},$ calculate $\\text{Var}[3-\\frac{1}{2}X].$ \n\n| $x$ | $0$ | $3$ | $6$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ | $\\frac{5}{8}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\frac{1}{2}$ and $b=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & ={(-\\frac{1}{2})}^{2}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=\\frac{9}{2}.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{3}^{2}\\cdot f(3)+{6}^{2}\\cdot f(6) \\\\  & =9\\cdot \\frac{1}{4}+36\\cdot \\frac{5}{8} \\\\  & =\\frac{99}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{99}{4}-{(\\frac{9}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[3-\\frac{1}{2}X] & =\\frac{1}{4}\\cdot \\text{Var}[X] \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{2} \\\\  & =\\frac{9}{8}.\\end{aligned}\n$$"} :step/id #uuid "23144d7f-489b-5b2c-8362-1966c6bcebea" :step/next {:db/id #edb/ref 17592186503779}} {:db/id #edb/ref 17592186503774 :step/content {:db/id #edb/ref 17592186162266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df20dc58-5b67-5b4a-a4b8-eca19f0be704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186158799} {:answer/id #uuid "1253e8d1-5192-596f-970c-1553a00ebc59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35" :db/id #edb/ref 17592186158800} {:answer/id #uuid "2610e250-1e87-5e70-911e-ced87d38d5a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186158801} {:answer/id #uuid "322e03be-95c4-5fdf-9538-cfd90f4a2b3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186158802} {:answer/id #uuid "7d810ec3-fb2e-5820-ae2e-d55f7775e2d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{5}" :db/id #edb/ref 17592186158803}] :answer-field/correct {:db/id #edb/ref 17592186158801} :answer-field/id #uuid "fdd49fee-8241-5a92-8763-eb72406aa943" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186158798}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f809e4ca-96d1-5ff3-9f14-e230cdb13096" :question/math-academy-id "q-108945" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=7,$ calculate $\\text{Var}[5X].$ \n\n| $x$ | $5$ | $6$ | $9$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{5}$ | $\\frac{2}{5}$ | $\\frac{2}{5}$ |" :question/requires-calculator true :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & ={5}^{2}\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=7.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{9}^{2}\\cdot f(9) \\\\  & =25(\\frac{1}{5})+36(\\frac{2}{5})+81(\\frac{2}{5}) \\\\  & =\\frac{259}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{259}{5}-{7}^{2} \\\\  & =\\frac{259}{5}-49 \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[5X] & =25\\cdot \\text{Var}[X] \\\\  & =25\\cdot \\frac{14}{5} \\\\  & =14\\cdot 5 \\\\  & =70.\\end{aligned}\n$$"} :step/id #uuid "2b268847-a40d-5cb1-9002-041f5606d47e" :step/next {:db/id #edb/ref 17592186503835}} {:db/id #edb/ref 17592186503779 :step/content {:db/id #edb/ref 17592186503655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7be9f5-de5a-5df0-8290-cf74e1a39a37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186503004} {:answer/id #uuid "7af11f73-ca21-565a-a0d6-ab60cd498b56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186503232} {:answer/id #uuid "8144080a-f640-5f95-9f81-bd52d80ef293" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186503247} {:answer/id #uuid "8c9997f0-4985-5f75-af77-04e011b3dc5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{3}-5}{3}" :db/id #edb/ref 17592186503265} {:answer/id #uuid "c82fefd9-904f-59e3-a3c8-f25e5d950641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{3}}{3}" :db/id #edb/ref 17592186503379}] :answer-field/correct {:db/id #edb/ref 17592186503232} :answer-field/id #uuid "83693d58-e295-516a-afbd-27422e50c864" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503580}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fdadb20-0f32-5fc9-95d6-7a680685f826" :question/math-academy-id "q-109092" :question/problem "The probability distribution of the random variable $X$ is given below. Given that $\\text{E}[X]=2,$ calculate $\\text{Var}[\\sqrt{3}X-5].$ \n\n| $x$ | $0$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ | $\\frac{1}{3}$ |" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=\\sqrt{3}$ and $b=-5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & ={\\sqrt{3}}^{2}\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\text{Var}[X].\\end{aligned}\n$$\n\nWe can compute the variance of $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nAdditionally, we're given that $\\text{E}[X]=2.$ \n\nWe start by computing $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={0}^{2}\\cdot f(0)+{2}^{2}\\cdot f(2)+{4}^{2}\\cdot f(4) \\\\  & =4\\cdot \\frac{1}{3}+16\\cdot \\frac{1}{3} \\\\  & =\\frac{20}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{20}{3}-{2}^{2} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[\\sqrt{3}X-5] & =3\\cdot \\text{Var}[X] \\\\  & =3\\cdot \\frac{8}{3} \\\\  & =8.\\end{aligned}\n$$"} :step/id #uuid "424ccc4b-8399-55e5-854c-ab879e6c171a"} {:db/id #edb/ref 17592186503791 :step/content {:db/id #edb/ref 17592186503707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013b7439-a140-520f-a3ac-519c465f78f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186502980} {:answer/id #uuid "29e976a2-85af-553f-9ce9-c7465b54a556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186503060} {:answer/id #uuid "57bfcaf4-7c52-5d64-a48a-af0c76f08b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186503151} {:answer/id #uuid "65ebf54d-2206-5935-9b35-5ab2a66dca75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186503182} {:answer/id #uuid "6cf3c46e-e77a-5c78-b951-5c6d1e51165d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-54" :db/id #edb/ref 17592186503199}] :answer-field/correct {:db/id #edb/ref 17592186502980} :answer-field/id #uuid "7470db9e-9f89-5eb5-aa1d-a389b249518e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503568}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8094ceca-7731-54ab-bb63-d28e40db7d50" :question/math-academy-id "q-108938" :question/problem "If $\\text{Var}[X]=6,$ calculate $\\text{Var}[-3X].$" :question/worked-solution "Recall that for any random variable $X$ and constant $a,$ we have\n\n$$\n\\text{Var}[aX]={a}^{2}\\text{Var}[X].\n$$\n\nIn our case, $a=-3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[-3X] & =(-3)^{2}\\cdot \\text{Var}[X] \\\\  & =9\\cdot 6 \\\\  & =54.\\end{aligned}\n$$"} :step/id #uuid "5c0b7eb0-1a52-51a1-9c96-7fa97306cc01" :step/next {:db/id #edb/ref 17592186503774}} {:db/id #edb/ref 17592186503835 :step/content {:db/id #edb/ref 17592186503675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aca28fc-b435-5f30-827e-ee7d02529481" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{b}" :db/id #edb/ref 17592186503090} {:answer/id #uuid "8e88be9e-beec-5707-8a75-1d982aa90617" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "b" :db/id #edb/ref 17592186503267} {:answer/id #uuid "9e23a02a-2881-5785-a934-6bc6623f7104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{b}}" :db/id #edb/ref 17592186503297} {:answer/id #uuid "b518096f-1014-55cc-a4c7-95699e9c75b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186503351} {:answer/id #uuid "f44c1787-6ed5-5b2b-96cb-f32a094f7386" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186503482}] :answer-field/correct {:db/id #edb/ref 17592186503351} :answer-field/id #uuid "7e77c422-979d-5619-b2c9-5f0629b862dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503574}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "359cefbe-6818-5849-92c9-d932909be650" :question/math-academy-id "q-109042" :question/problem "Calculate $\\text{Var}[\\sqrt{b}]$ where $b\\ge 0$ is a constant." :question/worked-solution "Recall that for any constant $a,$ we have\n\n$$\n\\text{Var}[a]=0.\n$$\n\nTherefore, since $b$ is a constant, we have\n\n$$\n\\text{Var}[\\sqrt{b}]=0.\n$$"} :step/id #uuid "ee13848c-afef-59a9-a58f-0082bc13ce48" :step/next {:db/id #edb/ref 17592186503772}}] :activity/title "Properties of Variance for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502973}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186193666} :activity/id #uuid "3166e137-4d3f-5719-abca-e284bb2446a8" :activity/scope {:db/id #edb/ref 17592186048744 :topic/id #uuid "ba8cd959-4cba-5c60-858b-f7ee86680552" :topic/math-academy-id 4043} :activity/steps [{:db/id #edb/ref 17592186193611 :step/content {:db/id #edb/ref 17592186192753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192472 :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839"} :knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049638}] :knowledge-point/questions [{:db/id #edb/ref 17592186192957} {:db/id #edb/ref 17592186193389} {:db/id #edb/ref 17592186275461} {:db/id #edb/ref 17592186275466} {:db/id #edb/ref 17592186275467} {:db/id #edb/ref 17592186278193} {:db/id #edb/ref 17592186406919} {:db/id #edb/ref 17592186406922} {:db/id #edb/ref 17592186419855} {:db/id #edb/ref 17592186503695}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"} :step/id #uuid "a3e6cf46-1327-5a3a-8953-f8f5c744aa8d" :step/math-academy-id 41078 :step/next {:db/id #edb/ref 17592186193665}} {:db/id #edb/ref 17592186193665 :step/content {:db/id #edb/ref 17592186192788 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192512 :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036"} :knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/questions [{:db/id #edb/ref 17592186193181} {:db/id #edb/ref 17592186193393} {:db/id #edb/ref 17592186275458} {:db/id #edb/ref 17592186275459} {:db/id #edb/ref 17592186275460} {:db/id #edb/ref 17592186275462} {:db/id #edb/ref 17592186275464} {:db/id #edb/ref 17592186275465} {:db/id #edb/ref 17592186278194} {:db/id #edb/ref 17592186406921} {:db/id #edb/ref 17592186406923} {:db/id #edb/ref 17592186419854} {:db/id #edb/ref 17592186426229}] :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"} :step/id #uuid "f94672ce-3841-5241-8adb-0cd157483370" :step/math-academy-id 41927 :step/next {:db/id #edb/ref 17592186193667}} {:db/id #edb/ref 17592186193666 :step/content {:db/id #edb/ref 17592186193886 :tutorial/content "Recall that the **probability density function** (or **pdf**) of a continuous random variable $X$ defined over a set $S$ is a function $f(x)$ that satisfies the following conditions:\n\n- $f(x) \\geq 0$ for all $x$ in $S$\n\n- $\\displaystyle \\int_{S} f(x) \\, \\textrm dx = 1$\n\nThe probability that $X$ lies in the interval $[a,b]$ is given by\n\n$$\nP(a \\leq X \\leq b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nThis probability can be interpreted as the area bounded between $f(x)$ and the $x$-axis over the interval $x\\in [a,b],$ as shown below.\n\n![](images/e6/e6c21e69a0dbd15ce32d18c2e74d8fcab0276e82bc55b354eaa5140adff610e6.png)\n\nAlso, remember that for continuous random variables, we get the same answer whether or not we include the endpoints of an interval $[a,b].$ In other words,\n\n$$\nP(a \\leq X \\leq b) = P(a < X < b)  = P(a < X \\leq b) = P(a \\leq X < b).\n$$\n\nIn this lesson, we'll get some practice at computing probabilities with continuous random variables." :tutorial/id #uuid "a6c7afdc-da68-55d5-aaa4-9ff1c77b6740" :tutorial/math-academy-id 6926 :tutorial/title "Introduction"} :step/id #uuid "167eafc7-5e80-5952-9c5c-541b7d78828f" :step/math-academy-id 41930 :step/next {:db/id #edb/ref 17592186193611}} {:db/id #edb/ref 17592186193667 :step/content {:db/id #edb/ref 17592186192789 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192513 :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038"} :knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050215}] :knowledge-point/questions [{:db/id #edb/ref 17592186193177} {:db/id #edb/ref 17592186193180} {:db/id #edb/ref 17592186275473} {:db/id #edb/ref 17592186275474} {:db/id #edb/ref 17592186275475} {:db/id #edb/ref 17592186275477} {:db/id #edb/ref 17592186278184} {:db/id #edb/ref 17592186278185} {:db/id #edb/ref 17592186278187} {:db/id #edb/ref 17592186278189} {:db/id #edb/ref 17592186406920} {:db/id #edb/ref 17592186419853}] :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"} :step/id #uuid "c5ab4c4d-fb97-5d7e-a711-dca2df3d7318" :step/math-academy-id 41936}] :activity/title "Calculating Probabilities With Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192912}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186426232} :activity/id #uuid "fb0c4ffb-c4f5-5d37-8b97-09041215ffb0" :activity/scope {:db/id #edb/ref 17592186048744 :topic/id #uuid "ba8cd959-4cba-5c60-858b-f7ee86680552" :topic/math-academy-id 4043} :activity/steps [{:db/id #edb/ref 17592186426230 :step/content {:db/id #edb/ref 17592186426229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e8a10c-8bca-5b60-94fa-c58a19413d8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{20}" :db/id #edb/ref 17592186426223} {:answer/id #uuid "57650fd3-48dd-55d0-ac9f-7d32e8ecc4b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186426224} {:answer/id #uuid "c0132ea6-fdc2-5a17-acb2-a6b30862b933" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186426225} {:answer/id #uuid "c404deb2-b7c8-573d-8c43-7e7ec28f3b65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186426226} {:answer/id #uuid "f1b44f8c-0f09-5979-a51a-7558f4d266c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186426227}] :answer-field/correct {:db/id #edb/ref 17592186426225} :answer-field/id #uuid "e2057c9f-e99d-5d1c-a575-837b0893982e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186426228}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ee0de2e-5389-59ac-b881-e7c459d89539" :question/math-academy-id "q-158461" :question/problem "Compute $P(X\\le 0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{20}(3{x}^{2}+2x+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<-2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 0) & ={\\int }_{-2}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-2}^{0}\\frac{1}{20}(3{x}^{2}+2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{20}{\\int }_{-2}^{0}3{x}^{2}+2x+1\\,\\text{d}x \\\\  & =\\frac{1}{20}{[{x}^{3}+{x}^{2}+x]}_{-2}^{0} \\\\  & =\\frac{1}{20}([{0}^{3}+{0}^{2}+0]-[(-2)^{3}+(-2)^{2}+(-2)]) \\\\  & =\\frac{1}{20}(0-[-8+4-2]) \\\\  & =\\frac{1}{20}\\cdot 6 \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$"} :step/id #uuid "24093c17-aaf6-5f14-99d2-b70a36b04680"} {:db/id #edb/ref 17592186426231 :step/content {:db/id #edb/ref 17592186419853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384b21df-8a7c-5b30-9125-1330da362a5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186419836} {:answer/id #uuid "3e21377a-680e-57d6-80e2-410c96b326e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186419837} {:answer/id #uuid "6c20cdc4-8968-5346-8c22-76a6ecf55625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{36}" :db/id #edb/ref 17592186419839} {:answer/id #uuid "e2afce84-edf6-5026-8a56-a45c4ffb8701" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{36}" :db/id #edb/ref 17592186419843} {:answer/id #uuid "f1943a76-0ce9-5efd-8b74-da642c9f9e88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186419845}] :answer-field/correct {:db/id #edb/ref 17592186419839} :answer-field/id #uuid "d0b9338f-ce76-54a7-9f1b-a16c716aaa54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186419852}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a05ac3ca-da7d-5bdc-b9ed-2ee65cee279b" :question/math-academy-id "q-158421" :question/problem "Compute $P(-1<X<0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{12}({x}^{2}+2),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{8} & 1<x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X<0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{1}{12}({x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{1}{12}{[\\frac{1}{3}{x}^{3}+2x]}_{-1}^{0} \\\\  & =\\frac{1}{12}([\\frac{1}{3}(0)^{3}+2(0)]-[\\frac{1}{3}(-1)^{3}+2(-1)]) \\\\  & =\\frac{1}{12}(0+\\frac{1}{3}+2) \\\\  & =\\frac{1}{12}(\\frac{7}{3}) \\\\  & =\\frac{7}{36}.\\end{aligned}\n$$"} :step/id #uuid "aa7621a8-c239-56bc-b82e-cc8333eb035f" :step/next {:db/id #edb/ref 17592186426234}} {:db/id #edb/ref 17592186426232 :step/content {:db/id #edb/ref 17592186275459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052459b5-32fe-5a93-b48b-e733fac244d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186272434} {:answer/id #uuid "09f7d73c-c7ee-52c8-9189-640706a28aed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186272477} {:answer/id #uuid "c76bdcab-c03f-5229-8d6c-4ac9d282117c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186274120} {:answer/id #uuid "c778c7da-afc4-5bd5-b2f1-bcc32a8fc807" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186274122} {:answer/id #uuid "f414363f-835b-53bb-9b0c-4cd9b3378183" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274543}] :answer-field/correct {:db/id #edb/ref 17592186272477} :answer-field/id #uuid "e1f7daa1-80eb-5764-a426-2110070d9e2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186275031}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "93f58db6-2e5f-58ae-a9a5-9aa2f152a653" :question/math-academy-id "q-158309" :question/problem "Compute $P(X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{24}({x}^{2}+1),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{24}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{24}{\\int }_{1}^{3}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{1}{24}{[\\frac{{x}^{3}}{3}+x]}_{1}^{3} \\\\  & =\\frac{1}{24}[(\\frac{{3}^{3}}{3}+3)-(\\frac{1}{3}+1)] \\\\  & =\\frac{1}{24}(12-\\frac{4}{3}) \\\\  & =\\frac{1}{24}\\cdot \\frac{32}{3} \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"} :step/id #uuid "d927fc2b-e4ac-5ab3-9c2f-ee91ca8f7ea8" :step/next {:db/id #edb/ref 17592186426233}} {:db/id #edb/ref 17592186426233 :step/content {:db/id #edb/ref 17592186275460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a02ae6e-0506-5c3e-842e-2d36e9955a2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186272611} {:answer/id #uuid "1b27c71e-715d-563a-b143-9a7e7dade11e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186272619} {:answer/id #uuid "352fdf1f-1c35-5952-8b5a-ab2dea63c3f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186272858} {:answer/id #uuid "44ddfa3a-38ea-5840-9c97-21475c3e27e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186272974} {:answer/id #uuid "a09352eb-ece5-548c-9db8-6b063dbf41eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186273778}] :answer-field/correct {:db/id #edb/ref 17592186272974} :answer-field/id #uuid "9a0add09-f8b7-5571-85b6-3994fc452dcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274905}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "93973542-05ae-5f66-9567-d5a70adf747f" :question/math-academy-id "q-158310" :question/problem "Compute $P(X>-3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{72}{x}^{2},\\, & -6\\le x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>0,$ we have\n\n$$\n\\begin{aligned}P(X>-3) & ={\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}\\frac{1}{72}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{216}{x}^{3}]}_{-3}^{0} \\\\  & =\\frac{1}{216}[(0)^{3}-(-3)^{3}] \\\\  & =\\frac{27}{216} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"} :step/id #uuid "dacdef7e-822e-524b-ac66-efc7856bf374" :step/next {:db/id #edb/ref 17592186426231}} {:db/id #edb/ref 17592186426234 :step/content {:db/id #edb/ref 17592186278187 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1028c364-ce75-5836-a84c-a7b8c7109998" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186275619} {:answer/id #uuid "37590d2d-228a-54b7-9ea1-ddb7e5c81f4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{24}" :db/id #edb/ref 17592186275969} {:answer/id #uuid "5b184341-4aed-5427-a6ea-c4f9d55ff988" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186276293} {:answer/id #uuid "78b9fe3f-4e98-52de-bbf1-6f4e65819078" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186276572} {:answer/id #uuid "e782edc4-7e83-59f7-a604-01cdc3eef141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186277501}] :answer-field/correct {:db/id #edb/ref 17592186276293} :answer-field/id #uuid "b41386b3-26a4-5507-8fde-5cf49c81cb7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278040}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f2c51ecb-6d65-53cb-ba0b-d70d6940d33b" :question/math-academy-id "q-158443" :question/problem "Compute $P(0<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}({x}^{3}+1),\\, & -1\\le x<1, \\\\ \\frac{1}{24}x & 1\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0<X\\le 5) & ={\\int }_{0}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{4}({x}^{3}+1)\\,\\text{d}x+{\\int }_{1}^{5}\\frac{1}{24}x\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{1}{4}{x}^{4}+x]}_{0}^{1}+{[\\frac{1}{48}{x}^{2}]}_{1}^{5} \\\\  & =\\frac{1}{4}([\\frac{1}{4}(1)^{4}+1]-[\\frac{1}{4}(0)^{4}+0])+\\frac{1}{48}[{5}^{2}-{1}^{2}] \\\\  & =\\frac{1}{4}(\\frac{5}{4})+\\frac{1}{2} \\\\  & =\\frac{5}{16}+\\frac{1}{2} \\\\  & =\\frac{13}{16}.\\end{aligned}\n$$"} :step/id #uuid "e546e690-a457-54d3-abfc-0fd010860864" :step/next {:db/id #edb/ref 17592186426230}}] :activity/title "Calculating Probabilities With Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186426222}] [{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186120699} :activity/id #uuid "59d43d6d-e407-5159-a37a-73328284da1e" :activity/scope {:db/id #edb/ref 17592186048762 :topic/id #uuid "bc92d9a7-3663-5495-a1b9-4cf735034158" :topic/math-academy-id 1865} :activity/steps [{:db/id #edb/ref 17592186120699 :step/content {:db/id #edb/ref 17592186121043 :tutorial/content "Let's consider the basis $\\mathcal{C}= \\left\\{ \\mathbf{c}_1, \\mathbf{c}_2 \\right\\}$ of $\\mathbb{R}^2$ and the vector\n\n![](images/2d/2dabd318dc49628f9333642f06492d3303617a0ea1cade93c0470c7a767121f5.svg)\n\nNow, let $\\mathcal{B}= \\left\\{ \\mathbf{b}_1, \\mathbf{b}_2 \\right\\}$ be another basis of $\\mathbb{R}^2,$ such that\n\n$$\n\\mathbf{b}_1 = \\mathbf{c}_2 \\quad \\textrm{and} \\quad \\mathbf{b}_2 = -2\\mathbf{c}_1.\n$$\n\nHow can we find the coordinates of $\\mathbf{x}$ relative to the basis $\\mathcal{B}?$\n\nSince ![](images/3e/3e330c07260a16bc76853ca1d275bbd9759f60179dce22500ee6dd38f326ca20.svg) we can write the vector $\\mathbf{x}$ relative to the basis $\\mathcal B$ as follows:\n\n$$\n\\begin{aligned}x & =2{c}_{1}-{c}_{2} \\\\  & =-{c}_{2}+2{c}_{1} \\\\  & =-({c}_{2})-(-2{c}_{1}) \\\\  & =-{b}_{1}-{b}_{2}\\end{aligned}\n$$\n\nTherefore, ![](images/5d/5d39ae32e2bad5125e6d7cf8ba7b943f2c926e1f1d6525ce019fd9a40c263bce.svg)" :tutorial/id #uuid "d5021c80-ecd5-57d1-b176-3ac06c0c4b38" :tutorial/math-academy-id 3209 :tutorial/title "Introduction"} :step/id #uuid "cbbd8b68-9c01-5dc1-a46f-54a0bc690766" :step/math-academy-id 17517 :step/next {:db/id #edb/ref 17592186120700}} {:db/id #edb/ref 17592186120700 :step/content {:db/id #edb/ref 17592186119823 :knowledge-point/canonical-example {:db/