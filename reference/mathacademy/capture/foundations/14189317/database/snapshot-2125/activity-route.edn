#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186503799} :activity/id #uuid "b62f5a31-d356-5eb9-a010-ffeb357ad98e" :activity/steps [{:db/id #edb/ref 17592186503767 :step/content {:db/id #edb/ref 17592186503728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7a6d1e-b67a-5086-8d8e-bc807158948a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-6x}" :db/id #edb/ref 17592186503095} {:answer/id #uuid "4e1371dc-c00c-5e29-9079-f6bee21cefbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-1-2x}" :db/id #edb/ref 17592186503131} {:answer/id #uuid "96581053-e51a-57c0-91dc-cdedecceb889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{e}^{-2x}+2{e}^{-4x}" :db/id #edb/ref 17592186503276} {:answer/id #uuid "e52cdcee-ace6-5887-9332-30bbc7af4b46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{6-4x}" :db/id #edb/ref 17592186503450} {:answer/id #uuid "eca2abbd-fc58-5d08-8f21-69f9b411e1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-2x}+{e}^{-4x}" :db/id #edb/ref 17592186503465}] :answer-field/correct {:db/id #edb/ref 17592186503095} :answer-field/id #uuid "8ea658b1-8a5c-53c8-b110-9aef693ebefd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503585}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac3ed9ab-9e20-50c1-a2df-d0e7acffd405" :question/math-academy-id "q-90726" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}+6{y}^{′}+8y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +8 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-2$ or $\\lambda =-4.$\n\nTherefore, any linear combination of the functions ${e}^{-2x}$ and ${e}^{-4x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${e}^{-6x}$ is not a solution."} :step/id #uuid "13e0f70b-698d-55d0-bc47-57987cc04fec" :step/next {:db/id #edb/ref 17592186503768}} {:db/id #edb/ref 17592186503768 :step/content {:db/id #edb/ref 17592186134395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c225eb90-e2e0-5316-bf2c-433fb3c69768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186132410} {:answer/id #uuid "320e4a8c-eedf-5588-98e8-c145e0ace715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186132411} {:answer/id #uuid "43de3423-2ffd-5930-9ee0-ea5001c9a16b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186132412} {:answer/id #uuid "53f34a5f-dc76-5b22-9b1f-04217732f9e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186132413} {:answer/id #uuid "796055cc-72c1-5b68-9805-3a39d9b06647" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186132414}] :answer-field/correct {:db/id #edb/ref 17592186132410} :answer-field/id #uuid "33879ed2-4ff8-5792-966a-daa49f7bc975" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186132409}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dcb38d39-eeab-5f94-bc9b-9cb1d6df2c04" :question/math-academy-id "q-42461" :question/problem "Find $2det(A)+4det(B)$, where \n\n$$\nA=[\\begin{aligned}1 & 0 & \\sqrt{3} & 1 \\\\ 0 & 2 & 4 & 2 \\\\ 0 & 0 & 2 & -4 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}3 & \\sqrt{2} & 2 & 3 \\\\ 1 & 2 & 1 & 3 \\\\ 3 & 1 & 0 & \\sqrt{2} \\\\ 1 & 2 & 1 & 3\\end{aligned}].\n$$" :question/worked-solution "Let's examine each matrix in turn.\n\n- Since $A$ is a triangular matrix, its determinant is given by the product of the elements of the main diagonal: \n\n$$\ndet(A)=1\\cdot 2\\cdot 2\\cdot 1=4\n$$\n\n- Since $B$ has two identical rows, we obtain\n\n$$\nB=[\\begin{aligned}3 & \\sqrt{2} & 2 & 3 \\\\ 1 & 2 & 1 & 3 \\\\ 3 & 1 & 0 & \\sqrt{2} \\\\ 1 & 2 & 1 & 3\\end{aligned}]\\,⟹\\,det(B)=0.\n$$\n\nTherefore, $2det(A)+4det(B)=2\\cdot 4+4\\cdot 0=8.$"} :step/id #uuid "182aa6cf-2207-5cff-97ff-f13a3a95bbd4" :step/next {:db/id #edb/ref 17592186503790}} {:db/id #edb/ref 17592186503775 :step/content {:db/id #edb/ref 17592186503695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d8b909-cd88-5396-a3e4-015217208b7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186503025} {:answer/id #uuid "41ecd6aa-d66a-5b26-b453-6eb1d066f99c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186503106} {:answer/id #uuid "5addda90-5bb8-5856-90d0-53bbb72f42a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186503157} {:answer/id #uuid "7f50f9e1-dab7-5e4d-9b55-64e931613784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186503244} {:answer/id #uuid "ca2ee2e6-f6b2-50ac-81bf-610eca1b4575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186503387}] :answer-field/correct {:db/id #edb/ref 17592186503025} :answer-field/id #uuid "25b205bf-9311-59ed-b707-a4ae58c7b68e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503533}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6487d2c0-d995-5efa-98e2-2110fb813c4e" :question/math-academy-id "q-158455" :question/problem "Compute $P(-1<X<1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{28}({x}^{2}+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X<1) & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}\\frac{3}{28}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{3}{28}{\\int }_{-1}^{1}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{3}{28}{[\\frac{1}{3}{x}^{3}+x]}_{-1}^{1} \\\\  & =\\frac{3}{28}([\\frac{1}{3}(1)^{3}+(1)]-[\\frac{1}{3}(-1)^{3}+(-1)]) \\\\  & =\\frac{3}{28}([\\frac{1}{3}+1]-[-\\frac{1}{3}-1]) \\\\  & =\\frac{3}{28}\\cdot \\frac{8}{3} \\\\  & =\\frac{2}{7}.\\end{aligned}\n$$"} :step/id #uuid "301f9bfe-208b-540e-a030-39ad7f692d17" :step/next {:db/id #edb/ref 17592186503767}} {:db/id #edb/ref 17592186503790 :step/content {:db/id #edb/ref 17592186259487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2136e2e5-eda2-5d8c-a918-cc6e25b936c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x+9y-12z" :db/id #edb/ref 17592186257054} {:answer/id #uuid "25df7a36-fb35-5a6b-a4f2-d81927845c5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+6y-8z" :db/id #edb/ref 17592186257106} {:answer/id #uuid "38802d04-6400-526e-a3c7-774018ac66df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8x+12y-16z" :db/id #edb/ref 17592186257281} {:answer/id #uuid "5d8c3701-5e7c-5b81-a7af-ecb760a2a77c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3y-4z)^{2}" :db/id #edb/ref 17592186257601} {:answer/id #uuid "a1dc10e2-998c-5132-90c3-1c176c2b128f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y-4z" :db/id #edb/ref 17592186258200}] :answer-field/correct {:db/id #edb/ref 17592186257106} :answer-field/id #uuid "f5c380c2-6f7a-5fa6-a1cf-bdd2ef574b31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259460}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02dd9d18-cd94-5447-91da-e2448419b7b2" :question/math-academy-id "q-123179" :question/problem "Consider the vector field $F=(2x+3y-4z)^{2}\\,i+(2x+3y-4z)^{2}\\,j+(2x+3y-4z)^{2}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((2x+3y-4z)^{2})+\\frac{∂}{∂y}((2x+3y-4z)^{2})+\\frac{∂}{∂z}((2x+3y-4z)^{2}) \\\\  & =4(2x+3y-4z)+6(2x+3y-4z)-8(2x+3y-4z) \\\\  & =2(2x+3y-4z) \\\\  & =4x+6y-8z.\\end{aligned}\n$$"} :step/id #uuid "5bb9c434-f3b3-564c-8f26-3b579750e1d2" :step/next {:db/id #edb/ref 17592186503826}} {:db/id #edb/ref 17592186503794 :step/content {:db/id #edb/ref 17592186351165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a265900-a14a-5877-aff1-d3aac3ca2423" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}32 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186348533} {:answer/id #uuid "213cc60a-579c-525d-8bac-b2ac16a0ef45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186348732} {:answer/id #uuid "95e69f7a-4747-5a57-9458-e378d2d86baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}\\frac{31}{3} \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186349792} {:answer/id #uuid "f22a76ba-f6d3-5c17-8bea-4d6cbf977c5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}11 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186350566} {:answer/id #uuid "fab7a2f0-417f-551c-ab1a-1c17871e8400" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[x]_{C}=[\\begin{aligned}-5 \\\\ \\frac{32}{3}\\end{aligned}]" :db/id #edb/ref 17592186350654}] :answer-field/correct {:db/id #edb/ref 17592186348732} :answer-field/id #uuid "33e9a91c-32f6-5bae-a84f-52e57d050036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350796}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2eedfab1-a2e1-5bd8-81d2-7c293aaffcd9" :question/math-academy-id "q-80828" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}].$ What are the coordinates of $x$ relative to the basis $C=\\{{c}_{1},{c}_{2}\\},$ where ${c}_{1}=3{b}_{2}$ and ${c}_{2}={b}_{1}+6{b}_{2}?$" :question/worked-solution "We are given that\n\n$$\n\\{\\begin{aligned}{c}_{1}=3{b}_{2} \\\\ {c}_{2}={b}_{1}+6{b}_{2}.\\end{aligned}\n$$\n\nFirst, we express the $b$'s in terms of $c$'s. From the first equation, we get \n\n$$\n{b}_{2}=\\frac{1}{3}{c}_{1}.\n$$\n\nSubstituting this into the second equation, we obtain\n\n$$\n{c}_{2}={b}_{1}+6(\\frac{1}{3}{c}_{1})\\,⟹\\,{b}_{1}={c}_{2}-2{c}_{1}.\n$$\n\nSince $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}]$, we can write the vector $x$ as follows:\n\n$$\n\\begin{aligned}x & =-5{b}_{1}+2{b}_{2} \\\\  & =-5({c}_{2}-2{c}_{1})+2(\\frac{1}{3}{c}_{1}) \\\\  & =-5{c}_{2}+10{c}_{1}+\\frac{2}{3}{c}_{1} \\\\  & =\\frac{32}{3}{c}_{1}-5{c}_{2}\\end{aligned}\n$$\n\nTherefore, $[x]_{C}=[\\begin{aligned}\\frac{32}{3} \\\\ -5\\end{aligned}].$"} :step/id #uuid "6e2d77f9-1266-5e11-a6bb-0de9f1eec483" :step/next {:db/id #edb/ref 17592186503775}} {:db/id #edb/ref 17592186503799 :step/content {:db/id #edb/ref 17592186503757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "376695e9-34fc-5ad5-aa0f-2dbf3cbb6b7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186503079} {:answer/id #uuid "68a2c705-93ae-5472-bf5d-03e90b1ec07e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186503186} {:answer/id #uuid "874231b5-4a07-561e-878f-93d066c20b5a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186503258} {:answer/id #uuid "aa757c82-e2c2-59f8-a04a-5ac6e32331b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186503325} {:answer/id #uuid "f3841a1b-f405-55cc-ad4a-a34c66eb086e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186503480}] :answer-field/correct {:db/id #edb/ref 17592186503186} :answer-field/id #uuid "49afd403-f908-5a66-b217-f75651a04dff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503543}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fb704702-8992-5802-a3da-c6412351672c" :question/math-academy-id "q-98337" :question/problem "![](images/50/50a06e9bb2865ea9ce3314700d89de3cd12139dee72ddcf2652fb868e88abbcb.png)\n\nWhich of the curves above is simple, closed, and negatively oriented?" :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented. \n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve II is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve III is not simple.\n\n- Curve IV is a simple and closed curve but it is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "7ede37e8-2ac9-57ac-a2b2-2a8ccaa9f72c" :step/next {:db/id #edb/ref 17592186503836}} {:db/id #edb/ref 17592186503820 :step/content {:db/id #edb/ref 17592186348202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "335681e7-b21b-5519-b297-cb9882ea8e22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186345795} {:answer/id #uuid "36984861-0f30-58fb-9cad-98cc52ec0e81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186345821} {:answer/id #uuid "3ca26fe7-406c-5810-b03b-0112d32f0206" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186345864} {:answer/id #uuid "49d1412f-0fd9-5d5a-9405-9347c3884dd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186345981} {:answer/id #uuid "d50a984f-a271-58db-8b8a-5011728ab2cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186347223}] :answer-field/correct {:db/id #edb/ref 17592186345795} :answer-field/id #uuid "8dc68fa8-6b14-57dc-ade7-cef32be5f365" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347852}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "550f63f1-7473-5fd5-bd68-1e9ff74a181b" :question/math-academy-id "q-79319" :question/problem "Determine the dimension of $\\text{Span}\\{[\\begin{aligned}-2 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 0 \\\\ 3\\end{aligned}]\\}.$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$"} :step/id #uuid "bd3c0d1f-b492-59bf-b2f5-09655d2c295a"} {:db/id #edb/ref 17592186503826 :step/content {:db/id #edb/ref 17592186503657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05145787-0d71-58ee-baea-e057534e89f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186502988} {:answer/id #uuid "39d009a3-e472-56cb-8ec8-718f1dc1759a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186503089} {:answer/id #uuid "6a796978-9de8-5008-bda0-2cb14e00517f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186503188} {:answer/id #uuid "7c489779-80d9-53d6-b869-b746b466d446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186503235} {:answer/id #uuid "8a205b96-1ac9-5b3d-9fda-4320d03ad997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7-\\sqrt{5}" :db/id #edb/ref 17592186503260}] :answer-field/correct {:db/id #edb/ref 17592186503188} :answer-field/id #uuid "785cf924-e072-5ada-8477-7761baf60c78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14c37ea2-4835-508a-983a-3cccd74633e3" :question/math-academy-id "q-109088" :question/problem "If $\\text{Var}[X]=1,$ calculate $\\text{Var}[7-\\sqrt{5}X].$" :question/worked-solution "Recall that for any random variable $X$ and constants $a$ and $b,$ we have\n\n$$\n\\text{Var}[aX+b]={a}^{2}\\cdot \\text{Var}[X].\n$$\n\nIn our case, $a=-\\sqrt{5}$ and $b=7.$ Therefore,\n\n$$\n\\begin{aligned}\\text{Var}[7-\\sqrt{5}X] & ={(-\\sqrt{5})}^{2}\\cdot \\text{Var}[X] \\\\  & =5\\cdot 1 \\\\  & =5.\\end{aligned}\n$$"} :step/id #uuid "cea5206e-4f27-5686-8618-b1774a4c8c2c" :step/next {:db/id #edb/ref 17592186503820}} {:db/id #edb/ref 17592186503836 :step/content {:db/id #edb/ref 17592186373132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1b2908-d140-5d0a-8262-c958d76bfa4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471471} {:answer/id #uuid "f456143a-b430-5e18-95eb-88219103f545" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471472}] :answer-field/correct {:db/id #edb/ref 17592186471471} :answer-field/id #uuid "06e697f7-446e-5fcc-ae8a-db378503de70" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472241} {:answer-field/choices [{:answer/id #uuid "55e41eb5-2115-5b1f-9bbb-e67f510d8e1b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471473} {:answer/id #uuid "bf770033-4a57-5465-a9ee-d6d68d54b733" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471474}] :answer-field/correct {:db/id #edb/ref 17592186471474} :answer-field/id #uuid "83576e31-5a8a-5315-8054-127553d4c6a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472242} {:answer-field/choices [{:answer/id #uuid "ad5d90de-a61d-5e9f-a889-d499427c60be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471475} {:answer/id #uuid "9f5c3a1e-f107-5159-ae8f-6ce7a0d2da41" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471476}] :answer-field/correct {:db/id #edb/ref 17592186471475} :answer-field/id #uuid "5771a531-83c1-5b90-a459-0ec86b28bfd9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472243}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c853fbcf-5be0-5101-8f2a-558cbd4a782f" :question/math-academy-id "q-71402" :question/problem "The level curves of the function $f(x,y)=9x+3y-4$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=0$ gives an ellipse\n- **II.** $c=-4$ gives a line\n- **III.** $c=5$ gives a hyperbola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}9x+3y-4 & =c \\\\ 3y & =-9x+c+4 \\\\ y & =-3x+\\frac{c+4}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-3x+\\frac{4}{3},$ which is not an ellipse.\n\n- If $c=-4$ then the level curve is $y=-3x,$ which is a line.\n\n- If $c=5$ then the level curve is $y=-3x+3,$ which is not a hyperbola.\n\nSo, only statement II is true."} :step/id #uuid "ef8a39e9-b08e-58a6-82f7-69345ea25339" :step/next {:db/id #edb/ref 17592186503794}}] :activity/title "Quiz 16" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186502975}]}
