86234645 #edb/ref 17592186045417] [17592186235027 #edb/ref 1075 #edb/ref 17592186234652 #edb/ref 17592186045417] [17592186235027 #edb/ref 1075 #edb/ref 17592186234700 #edb/ref 17592186045417] [17592186235027 #edb/ref 1075 #edb/ref 17592186234779 #edb/ref 17592186045417] [17592186235027 #edb/ref 1075 #edb/ref 17592186234865 #edb/ref 17592186045417] [17592186235027 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186235027 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186235027 #edb/ref 1078 #edb/ref 17592186234700 #edb/ref 17592186045417] [17592186235027 #edb/ref 1079 #uuid "351f4c64-6f3a-578b-bb07-2d8260b8e536" #edb/ref 17592186045417] [17592186235160 #edb/ref 1075 #edb/ref 17592186234678 #edb/ref 17592186045417] [17592186235160 #edb/ref 1075 #edb/ref 17592186234799 #edb/ref 17592186045417] [17592186235160 #edb/ref 1075 #edb/ref 17592186234876 #edb/ref 17592186045417] [17592186235160 #edb/ref 1075 #edb/ref 17592186234900 #edb/ref 17592186045417] [17592186235160 #edb/ref 1075 #edb/ref 17592186234901 #edb/ref 17592186045417] [17592186235160 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186235160 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186235160 #edb/ref 1078 #edb/ref 17592186234799 #edb/ref 17592186045417] [17592186235160 #edb/ref 1079 #uuid "9c9a9e9c-8c1a-5fea-8cb1-7b089d10977e" #edb/ref 17592186045417] [17592186235272 #edb/ref 1075 #edb/ref 17592186234588 #edb/ref 17592186045417] [17592186235272 #edb/ref 1075 #edb/ref 17592186234592 #edb/ref 17592186045417] [17592186235272 #edb/ref 1075 #edb/ref 17592186234617 #edb/ref 17592186045417] [17592186235272 #edb/ref 1075 #edb/ref 17592186234679 #edb/ref 17592186045417] [17592186235272 #edb/ref 1075 #edb/ref 17592186234774 #edb/ref 17592186045417] [17592186235272 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186235272 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186235272 #edb/ref 1078 #edb/ref 17592186234774 #edb/ref 17592186045417] [17592186235272 #edb/ref 1079 #uuid "f9b78da5-f53f-57bc-9aa0-7ba1fa733f20" #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235405 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235406 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235407 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235408 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235409 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235410 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186235411 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186412196 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186412198 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186412203 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186412206 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186412208 #edb/ref 17592186045417] [17592186235284 #edb/ref 1038 #edb/ref 17592186433112 #edb/ref 17592186045417] [17592186235284 #edb/ref 1039 "Finding a Double-Integral Formula for Volume" #edb/ref 17592186045417] [17592186235284 #edb/ref 1041 #edb/ref 17592186234975 #edb/ref 17592186045417] [17592186235284 #edb/ref 1042 #uuid "13f9ed67-24d8-5d41-8f82-1296abc57f12" #edb/ref 17592186045417] [17592186235407 #edb/ref 1068 #edb/ref 17592186235160 #edb/ref 17592186045417] [17592186235407 #edb/ref 1069 "q-161706" #edb/ref 17592186045417] [17592186235407 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186235407 #edb/ref 1071 "Consider the solid enclosed between the paraboloid $x=3{y}^{2}+4{z}^{2}$ and the parabolic cylinder $x=1-{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1/2}^{1/2}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" #edb/ref 17592186045417] [17592186235407 #edb/ref 1072 #uuid "d129309d-a59a-5bf0-aa8c-890079ed6bb8" #edb/ref 17592186045417] [17592186235407 #edb/ref 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}3{y}^{2}+4{z}^{2} & =1-{y}^{2} \\\\ 4{y}^{2}+4{z}^{2} & =1 \\\\ {y}^{2}+{z}^{2} & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is a circle.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,3{y}^{2}+4{z}^{2}\\le x\\le 1-{y}^{2}\\},\n$$\n\nwhere $D$ is the interior of the circle ${y}^{2}+{z}^{2}=\\frac{1}{4}.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{3{y}^{2}+4{z}^{2}}^{1-{y}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(1-{y}^{2})-(3{y}^{2}+4{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-4{y}^{2}-4{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\frac{1}{2}\\sqrt{1-4{y}^{2}},$ and\n\n- the upper part $z=\\frac{1}{2}\\sqrt{1-4{y}^{2}},$\n\nfor $-\\frac{1}{2}\\le y\\le \\frac{1}{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-4{y}^{2}-4{z}^{2}\\,\\text{d}A & ={\\int }_{-1/2}^{1/2}{\\int }_{-\\sqrt{1-4{y}^{2}}/2}^{\\sqrt{1-4{y}^{2}}/2}\\,1-4{y}^{2}-4{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\frac{1}{2}\\sqrt{1-4{y}^{2}})}^{2}+{(\\frac{1}{2}\\sqrt{1-4{y}^{2}})}^{2}+(1-4{y}^{2}-4{z}^{2}) \\\\  & =\\frac{1}{4}(1-4{y}^{2})+\\frac{1}{4}(1-4{y}^{2})+(1-4{y}^{2}-4{z}^{2}) \\\\  & =\\frac{3}{2}-6{y}^{2}-4{z}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235409 #edb/ref 1068 #edb/ref 17592186235272 #edb/ref 17592186045417] [17592186235409 #edb/ref 1069 "q-161716" #edb/ref 17592186045417] [17592186235409 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186235409 #edb/ref 1071 "Consider the solid enclosed between the parabolic cylinders $y=4{x}^{2}$ and $y=1-2{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1/2}^{1/2}{\\int }_{a(x)}^{b(x)}\\,f(x,z)\\,dz\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" #edb/ref 17592186045417] [17592186235409 #edb/ref 1072 #uuid "12d08b78-b5d1-5179-8c7f-966d7d4e9314" #edb/ref 17592186045417] [17592186235409 #edb/ref 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}4{x}^{2} & =1-2{z}^{2} \\\\ 4{x}^{2}+2{z}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xz$-plane is an ellipse.\n\nNotice that our solid can be written as a type III region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,4{x}^{2}\\le y\\le 1-2{z}^{2}\\},\n$$\n\nwhere $D$ is the interior of the elipse $4{x}^{2}+2{z}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{4{x}^{2}}^{1-2{z}^{2}}\\text{d}y]\\text{d}A \\\\  & ={∬}_{D}(1-2{z}^{2})-(4{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-2{z}^{2}-4{x}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{1-4{x}^{2}}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{1-4{x}^{2}}{2}},$\n\nfor $-\\frac{1}{2}\\le x\\le \\frac{1}{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-2{z}^{2}-4{x}^{2}\\,\\text{d}A & ={\\int }_{-1/2}^{1/2}{\\int }_{-\\sqrt{(1-4{x}^{2})/2}}^{\\sqrt{(1-4{x}^{2})/2}}\\,1-2{z}^{2}-4{x}^{2}\\,dz\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{1-4{x}^{2}}{2}})}^{2}+{(\\sqrt{\\frac{1-4{x}^{2}}{2}})}^{2}+(1-2{z}^{2}-4{x}^{2}) \\\\  & =\\frac{1-4{x}^{2}}{2}+\\frac{1-4{x}^{2}}{2}+(1-2{z}^{2}-4{x}^{2}) \\\\  & =2-8{x}^{2}-2{z}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235411 #edb/ref 1068 #edb/ref 17592186235027 #edb/ref 17592186045417] [17592186235411 #edb/ref 1069 "q-163221" #edb/ref 17592186045417] [17592186235411 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186235411 #edb/ref 1071 "Consider the solid enclosed between the paraboloids $z=1+{x}^{2}+{y}^{2}$ and $z=3-3{x}^{2}-{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-\\sqrt{2}/2}^{\\sqrt{2}/2}{\\int }_{a(x)}^{b(x)}\\,f(x,y)\\,dy\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" #edb/ref 17592186045417] [17592186235411 #edb/ref 1072 #uuid "7682e487-9666-568f-b7a6-c77060041838" #edb/ref 17592186045417] [17592186235411 #edb/ref 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xy$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}1+{x}^{2}+{y}^{2} & =3-3{x}^{2}-{y}^{2} \\\\ 4{x}^{2}+2{y}^{2} & =2 \\\\ 2{x}^{2}+{y}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xy$-plane is an ellipse.\n\nNotice that our solid can be written as a type I region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,1+{x}^{2}+{y}^{2}\\le z\\le 3-3{x}^{2}-{y}^{2}\\},\n$$\n\nwhere $D$ is the interior of the ellipse $2{x}^{2}+{y}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{1+{x}^{2}+{y}^{2}}^{3-3{x}^{2}-{y}^{2}}\\text{d}z]\\text{d}A \\\\  & ={∬}_{D}(3-3{x}^{2}-{y}^{2})-(1+{x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}2-4{x}^{2}-2{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $y=-\\sqrt{1-2{x}^{2}},$ and\n\n- the upper part $y=\\sqrt{1-2{x}^{2}},$\n\nfor $-\\frac{\\sqrt{2}}{2}\\le x\\le \\frac{\\sqrt{2}}{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}2-4{x}^{2}-2{y}^{2}\\,\\text{d}A & ={\\int }_{-\\sqrt{2}/2}^{\\sqrt{2}/2}{\\int }_{-\\sqrt{1-2{x}^{2}}}^{\\sqrt{1-2{x}^{2}}}\\,2-4{x}^{2}-2{y}^{2}\\,dy\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{1-2{x}^{2}})}^{2}+{(\\sqrt{1-2{x}^{2}})}^{2}+(2-4{x}^{2}-2{y}^{2}) \\\\  & =(1-2{x}^{2})+(1-2{x}^{2})+(2-4{x}^{2}-2{y}^{2}) \\\\  & =4-8{x}^{2}-2{y}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278698 #edb/ref 1080 "39" #edb/ref 17592186045417] [17592186278698 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278698 #edb/ref 1083 #uuid "0b3410aa-3741-574c-a561-ca42745d30c1" #edb/ref 17592186045417] [17592186278712 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186278712 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278712 #edb/ref 1083 #uuid "0cc72655-a5c0-5188-8f58-5d27119d622f" #edb/ref 17592186045417] [17592186278782 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186278782 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278782 #edb/ref 1083 #uuid "15597838-21a7-5710-8d04-a20e27443d9d" #edb/ref 17592186045417] [17592186278786 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186278786 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278786 #edb/ref 1083 #uuid "15ae8429-f69d-5ace-9302-7610fc9d936c" #edb/ref 17592186045417] [17592186278943 #edb/ref 1080 "\\frac{33}{2}" #edb/ref 17592186045417] [17592186278943 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278943 #edb/ref 1083 #uuid "27773d7f-25a8-52fe-bf01-68d9f7772331" #edb/ref 17592186045417] [17592186279031 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186279031 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279031 #edb/ref 1083 #uuid "32279d50-a3b6-5eba-856d-313b883aff63" #edb/ref 17592186045417] [17592186279043 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186279043 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279043 #edb/ref 1083 #uuid "344e23d8-bf2f-5fd0-b697-3782f28e621a" #edb/ref 17592186045417] [175921862790