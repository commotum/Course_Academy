86427145 #edb/ref 17592186045417] [17592186427168 #edb/ref 1075 #edb/ref 17592186427147 #edb/ref 17592186045417] [17592186427168 #edb/ref 1075 #edb/ref 17592186427153 #edb/ref 17592186045417] [17592186427168 #edb/ref 1075 #edb/ref 17592186427160 #edb/ref 17592186045417] [17592186427168 #edb/ref 1075 #edb/ref 17592186427163 #edb/ref 17592186045417] [17592186427168 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186427168 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186427168 #edb/ref 1078 #edb/ref 17592186427160 #edb/ref 17592186045417] [17592186427168 #edb/ref 1079 #uuid "87e78623-cec4-5788-b3df-a921432e23fb" #edb/ref 17592186045417] [17592186427169 #edb/ref 1068 #edb/ref 17592186427167 #edb/ref 17592186045417] [17592186427169 #edb/ref 1069 "q-64893" #edb/ref 17592186045417] [17592186427169 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427169 #edb/ref 1071 "Given that ${y}_{1}(x)={e}^{x}$ is a solution to the equation ${y}^{″}-y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." #edb/ref 17592186045417] [17592186427169 #edb/ref 1072 #uuid "0006acdb-45b3-5900-8e6e-eb4bda5a2c89" #edb/ref 17592186045417] [17592186427169 #edb/ref 1074 "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{x}+u{e}^{x}={e}^{x}({u}^{′}+u) \\\\ {y}_{2}^{″} & ={e}^{x}({u}^{″}+2{u}^{′}+u).\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{e}^{x}({u}^{″}+2{u}^{′}+u)-{e}^{x}(u) & =0 \\\\ {e}^{x}({u}^{″}+2{u}^{′}+u-u) & =0 \\\\ {e}^{x}({u}^{″}+2{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{x}\\ne 0$ we must have\n\n$$\n{u}^{″}+2{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}+2w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{-2x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{-2x}\\,⟹\\,u=-\\frac{1}{2}{c}_{1}{e}^{-2x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{x}(-\\frac{1}{2}{c}_{1}{e}^{-2x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-2$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{x}\\cdot {e}^{-2x}={e}^{-x}.\n$$" #edb/ref 17592186045417] [17592186427170 #edb/ref 1068 #edb/ref 17592186427165 #edb/ref 17592186045417] [17592186427170 #edb/ref 1069 "q-64994" #edb/ref 17592186045417] [17592186427170 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186427170 #edb/ref 1071 "The function ${y}_{1}(t)=\\operatorname{sin}⁡2t$ is a solution to the equation ${y}^{″}+4y=0.$ If ${y}_{2}=u(t){y}_{1}(t)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(t)?$" #edb/ref 17592186045417] [17592186427170 #edb/ref 1072 #uuid "3cbf3dd8-a285-5e19-9174-c286d8ed0845" #edb/ref 17592186045417] [17592186427170 #edb/ref 1074 "We're given that\n\n$$\n{y}_{2}(t)=u(t){y}_{1}(t)=u\\operatorname{sin}⁡2t.\n$$\n\nDifferentiating ${y}_{2}=u\\operatorname{sin}⁡2t$ with respect to $t$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}\\operatorname{sin}⁡2t+2u\\operatorname{cos}⁡2t \\\\ {y}_{2}^{″} & ={u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t-4u\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t-4u\\operatorname{sin}⁡2t)+4u\\operatorname{sin}⁡2t & =0 \\\\ {u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186427171 #edb/ref 1068 #edb/ref 17592186427168 #edb/ref 17592186045417] [17592186427171 #edb/ref 1069 "q-102804" #edb/ref 17592186045417] [17592186427171 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186427171 #edb/ref 1071 "Given that ${y}_{1}(x)={e}^{3x}$ is a solution to the equation ${y}^{″}-{y}^{′}-6y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." #edb/ref 17592186045417] [17592186427171 #edb/ref 1072 #uuid "5da78f32-e695-5e02-8dc1-34ad1449602a" #edb/ref 17592186045417] [17592186427171 #edb/ref 1074 "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{3x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{3x}+3u{e}^{3x} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{3x}+6{u}^{′}{e}^{3x}+9u{e}^{3x}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}{e}^{3x}+6{u}^{′}{e}^{3x}+9u{e}^{3x})-({u}^{′}{e}^{3x}+3u{e}^{3x})-6u{e}^{3x} & =0 \\\\ {e}^{3x}({u}^{″}+6{u}^{′}+9u-{u}^{′}-3u-6u) & =0 \\\\ {e}^{3x}({u}^{″}+5{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{3x}\\ne 0,$ we must have\n\n$$\n{u}^{″}+5{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}+5w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{-5x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{-5x}\\,⟹\\,u=-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{3x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{3x}(-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-5$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{3x}\\cdot {e}^{-5x}={e}^{-2x}.\n$$" #edb/ref 17592186045417] [17592186427172 #edb/ref 1068 #edb/ref 17592186427166 #edb/ref 17592186045417] [17592186427172 #edb/ref 1069 "q-102795" #edb/ref 17592186045417] [17592186427172 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186427172 #edb/ref 1071 "The function ${y}_{1}(x)={x}^{-1}$ is a solution to the equation ${x}^{2}{y}^{″}+4x{y}^{′}+2y=0$ for $x>0.$ If ${y}_{2}=u(x){y}_{1}(x)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(x)?$" #edb/ref 17592186045417] [17592186427172 #edb/ref 1072 #uuid "879a358b-954a-58b1-b6bd-64affbba8f30" #edb/ref 17592186045417] [17592186427172 #edb/ref 1074 "We're given that\n\n$$\n{y}_{2}(x)=u(x){y}_{1}(x)=u{x}^{-1}.\n$$\n\nDifferentiating ${y}_{2}=u{x}^{-1}$ with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{x}^{-1}-u{x}^{-2} \\\\ {y}_{2}^{″} & ={u}^{″}{x}^{-1}-2{u}^{′}{x}^{-2}+2u{x}^{-3}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}({u}^{″}{x}^{-1}-2{u}^{′}{x}^{-2}+2u{x}^{-3})+4x({u}^{′}{x}^{-1}-u{x}^{-2})+2u{x}^{-1} & =0 \\\\ {u}^{″}x-2{u}^{′}+2u{x}^{-1}+4{u}^{′}-4u{x}^{-1}+2u{x}^{-1} & =0 \\\\ {u}^{″}x+2{u}^{′} & =0.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx{u}^{″}+2{u}^{′}=0.\n$$" #edb/ref 17592186045417] [17592186427173 #edb/ref 1058 #edb/ref 17592186427175 #edb/ref 17592186045417] [17592186427173 #edb/ref 1062 #uuid "06844a65-63a3-5579-82b4-67520af49c4a" #edb/ref 17592186045417] [17592186427173 #edb/ref 1063 #edb/ref 17592186125184 #edb/ref 17592186045417] [17592186427174 #edb/ref 1058 #edb/ref 17592186427173 #edb/ref 17592186045417] [17592186427174 #edb/ref 1062 #uuid "6ee0e41e-0081-57b1-b63e-73976c761c93" #edb/ref 17592186045417] [17592186427174 #edb/ref 1063 #edb/ref 17592186427170 #edb/ref 17592186045417] [17592186427175 #edb/ref 1058 #edb/ref 17592186427177 #edb/ref 17592186045417] [17592186427175 #edb/ref 1062 #uuid "90e390d3-2285-5647-8dee-72ff1477f1a3" #edb/ref 17592186045417] [17592186427175 #edb/ref 1063 #edb/ref 17592186427172 #edb/ref 17592186045417] [17592186427176 #edb/ref 1058 #edb/ref 17592186427174 #edb/ref 17592186045417] [17592186427176 #edb/ref 1062 #uuid "96e409f5-e17c-5d02-9a72-f1ba50380ab3" #edb/ref 17592186045417] [17592186427176 #edb/ref 1063 #edb/ref 17592186427169 #edb/ref 17592186045417] [17592186427177 #edb/ref 1062 #uuid "e444fcb5-e5b0-58fa-a276-f1b31f0b5d06" #edb/ref 17592186045417] [17592186427177 #edb/ref 1063 #edb/ref 17592186427171 #edb/ref 17592186045417]}
