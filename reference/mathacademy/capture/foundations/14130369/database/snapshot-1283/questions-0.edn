#{[{:db/id #edb/ref 17592186427172 :knowledge-point/_questions [{:db/id #edb/ref 17592186124563 :knowledge-point/id #uuid "ba3e0748-2a14-547e-b21e-c34251994a94" :knowledge-point/title "Finding the Differential Equation Satisfied by the Reduction of Order Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b214ce-ab5e-5f5c-a969-dbab5f241399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+4{u}^{′}=0" :db/id #edb/ref 17592186427146} {:answer/id #uuid "935207a8-801a-5dc5-9425-a3cd78674d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+2{u}^{′}=0" :db/id #edb/ref 17592186427150} {:answer/id #uuid "97c83eab-28ad-55eb-91f3-21e77e24722a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}-2x{u}^{′}=0" :db/id #edb/ref 17592186427151} {:answer/id #uuid "c6393b4b-5ac6-54cd-828e-f2c5d96b68e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{u}^{″}+2{u}^{′}=0" :db/id #edb/ref 17592186427156} {:answer/id #uuid "cb3901fc-4414-5f50-8377-cc29adff3e54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}+4x{u}^{′}=0" :db/id #edb/ref 17592186427158}] :answer-field/correct {:answer/id #uuid "935207a8-801a-5dc5-9425-a3cd78674d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+2{u}^{′}=0" :db/id #edb/ref 17592186427150} :answer-field/id #uuid "47dbd607-90bc-550b-8e0e-ad2915edaeb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "879a358b-954a-58b1-b6bd-64affbba8f30" :question/math-academy-id "q-102795" :question/problem "The function ${y}_{1}(x)={x}^{-1}$ is a solution to the equation ${x}^{2}{y}^{″}+4x{y}^{′}+2y=0$ for $x>0.$ If ${y}_{2}=u(x){y}_{1}(x)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(x)?$" :question/worked-solution "We're given that\n\n$$\n{y}_{2}(x)=u(x){y}_{1}(x)=u{x}^{-1}.\n$$\n\nDifferentiating ${y}_{2}=u{x}^{-1}$ with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{x}^{-1}-u{x}^{-2} \\\\ {y}_{2}^{″} & ={u}^{″}{x}^{-1}-2{u}^{′}{x}^{-2}+2u{x}^{-3}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}({u}^{″}{x}^{-1}-2{u}^{′}{x}^{-2}+2u{x}^{-3})+4x({u}^{′}{x}^{-1}-u{x}^{-2})+2u{x}^{-1} & =0 \\\\ {u}^{″}x-2{u}^{′}+2u{x}^{-1}+4{u}^{′}-4u{x}^{-1}+2u{x}^{-1} & =0 \\\\ {u}^{″}x+2{u}^{′} & =0.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx{u}^{″}+2{u}^{′}=0.\n$$"}] [{:db/id #edb/ref 17592186427171 :knowledge-point/_questions [{:db/id #edb/ref 17592186124562 :knowledge-point/id #uuid "e7ae919f-4a7f-50e3-8c2f-7cea0b5a66ee" :knowledge-point/title "Finding a Second Solution to a Differential Equation Using Reduction of Order"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b716eb-d4fa-5066-8213-092129b7937e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{3x}" :db/id #edb/ref 17592186427145} {:answer/id #uuid "496af30b-c5c5-5345-8110-0135b11a161c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{2x}" :db/id #edb/ref 17592186427147} {:answer/id #uuid "ab6e2856-d996-5ac5-aa97-b729e3339896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-2x}" :db/id #edb/ref 17592186427153} {:answer/id #uuid "dd26cb8c-0ca5-5aee-9310-8a7a0375c7fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}" :db/id #edb/ref 17592186427160} {:answer/id #uuid "f59fd045-73ad-5d29-a771-d22dc5113969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{7x}" :db/id #edb/ref 17592186427163}] :answer-field/correct {:answer/id #uuid "dd26cb8c-0ca5-5aee-9310-8a7a0375c7fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}" :db/id #edb/ref 17592186427160} :answer-field/id #uuid "87e78623-cec4-5788-b3df-a921432e23fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427168}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5da78f32-e695-5e02-8dc1-34ad1449602a" :question/math-academy-id "q-102804" :question/problem "Given that ${y}_{1}(x)={e}^{3x}$ is a solution to the equation ${y}^{″}-{y}^{′}-6y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{3x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{3x}+3u{e}^{3x} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{3x}+6{u}^{′}{e}^{3x}+9u{e}^{3x}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}{e}^{3x}+6{u}^{′}{e}^{3x}+9u{e}^{3x})-({u}^{′}{e}^{3x}+3u{e}^{3x})-6u{e}^{3x} & =0 \\\\ {e}^{3x}({u}^{″}+6{u}^{′}+9u-{u}^{′}-3u-6u) & =0 \\\\ {e}^{3x}({u}^{″}+5{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{3x}\\ne 0,$ we must have\n\n$$\n{u}^{″}+5{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}+5w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{-5x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{-5x}\\,⟹\\,u=-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{3x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{3x}(-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-5$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{3x}\\cdot {e}^{-5x}={e}^{-2x}.\n$$"}] [{:db/id #edb/ref 17592186427169 :knowledge-point/_questions [{:db/id #edb/ref 17592186124562 :knowledge-point/id #uuid "e7ae919f-4a7f-50e3-8c2f-7cea0b5a66ee" :knowledge-point/title "Finding a Second Solution to a Differential Equation Using Reduction of Order"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5624fee0-ac6c-5a27-a00d-a533ce8462a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)={e}^{-x}" :db/id #edb/ref 17592186427149} {:answer/id #uuid "c66f0cef-0e9d-5e23-a546-875b0af82f5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)={e}^{-2x}" :db/id #edb/ref 17592186427157} {:answer/id #uuid "cb87e4e8-0d55-5f56-909c-77cfc9ff1845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)=\\frac{1}{x}" :db/id #edb/ref 17592186427159} {:answer/id #uuid "e92d5e88-cebd-5955-be19-3ce4ea54b887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)=x" :db/id #edb/ref 17592186427161} {:answer/id #uuid "fc51c4e7-1541-5022-aa97-d43e54b6050a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)={e}^{2x}" :db/id #edb/ref 17592186427164}] :answer-field/correct {:answer/id #uuid "5624fee0-ac6c-5a27-a00d-a533ce8462a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{2}(x)={e}^{-x}" :db/id #edb/ref 17592186427149} :answer-field/id #uuid "50d2223c-c444-5eb2-b0e0-62ae52349f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427167}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0006acdb-45b3-5900-8e6e-eb4bda5a2c89" :question/math-academy-id "q-64893" :question/problem "Given that ${y}_{1}(x)={e}^{x}$ is a solution to the equation ${y}^{″}-y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{x}+u{e}^{x}={e}^{x}({u}^{′}+u) \\\\ {y}_{2}^{″} & ={e}^{x}({u}^{″}+2{u}^{′}+u).\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{e}^{x}({u}^{″}+2{u}^{′}+u)-{e}^{x}(u) & =0 \\\\ {e}^{x}({u}^{″}+2{u}^{′}+u-u) & =0 \\\\ {e}^{x}({u}^{″}+2{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{x}\\ne 0$ we must have\n\n$$\n{u}^{″}+2{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}+2w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{-2x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{-2x}\\,⟹\\,u=-\\frac{1}{2}{c}_{1}{e}^{-2x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{x}(-\\frac{1}{2}{c}_{1}{e}^{-2x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-2$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{x}\\cdot {e}^{-2x}={e}^{-x}.\n$$"}] [{:db/id #edb/ref 17592186427170 :knowledge-point/_questions [{:db/id #edb/ref 17592186124563 :knowledge-point/id #uuid "ba3e0748-2a14-547e-b21e-c34251994a94" :knowledge-point/title "Finding the Differential Equation Satisfied by the Reduction of Order Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "526bd235-8c14-5294-9466-6a7e8c18b8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t=0" :db/id #edb/ref 17592186427148} {:answer/id #uuid "9b2a2093-3771-5e44-84d7-a86917edc153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}\\operatorname{sin}⁡2t-{u}^{′}\\operatorname{cos}⁡2t=0" :db/id #edb/ref 17592186427152} {:answer/id #uuid "bec5beb9-da1e-55e4-9083-b45422a210b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{u}^{″}\\operatorname{cos}⁡2t-3{u}^{′}\\operatorname{sin}⁡2t=0" :db/id #edb/ref 17592186427154} {:answer/id #uuid "bf107e21-60dc-5cea-ad5c-d09d313718a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}\\operatorname{cos}⁡2t-2{u}^{′}\\operatorname{sin}⁡2t=0" :db/id #edb/ref 17592186427155} {:answer/id #uuid "ebe49dcb-dfb5-57aa-ac26-2c33b1844fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{u}^{″}\\operatorname{sin}⁡2t+{u}^{′}\\operatorname{cos}⁡2t=0" :db/id #edb/ref 17592186427162}] :answer-field/correct {:answer/id #uuid "526bd235-8c14-5294-9466-6a7e8c18b8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t=0" :db/id #edb/ref 17592186427148} :answer-field/id #uuid "27822b6f-f9aa-52c3-b623-d6079dfb84b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427165}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cbf3dd8-a285-5e19-9174-c286d8ed0845" :question/math-academy-id "q-64994" :question/problem "The function ${y}_{1}(t)=\\operatorname{sin}⁡2t$ is a solution to the equation ${y}^{″}+4y=0.$ If ${y}_{2}=u(t){y}_{1}(t)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(t)?$" :question/worked-solution "We're given that\n\n$$\n{y}_{2}(t)=u(t){y}_{1}(t)=u\\operatorname{sin}⁡2t.\n$$\n\nDifferentiating ${y}_{2}=u\\operatorname{sin}⁡2t$ with respect to $t$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}\\operatorname{sin}⁡2t+2u\\operatorname{cos}⁡2t \\\\ {y}_{2}^{″} & ={u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t-4u\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t-4u\\operatorname{sin}⁡2t)+4u\\operatorname{sin}⁡2t & =0 \\\\ {u}^{″}\\operatorname{sin}⁡2t+4{u}^{′}\\operatorname{cos}⁡2t & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125184 :knowledge-point/_questions [{:db/id #edb/ref 17592186124563 :knowledge-point/id #uuid "ba3e0748-2a14-547e-b21e-c34251994a94" :knowledge-point/title "Finding the Differential Equation Satisfied by the Reduction of Order Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093ed2aa-2b8c-5168-874c-f820cb49ad56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{u}^{″}+5{u}^{′}=0" :db/id #edb/ref 17592186333073} {:answer/id #uuid "5d674283-f300-5b61-b687-08e0a2a4f93e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}-5{u}^{′}=0" :db/id #edb/ref 17592186333843} {:answer/id #uuid "8ef5037c-c9e5-51c3-8f13-71949d2ee3b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+3{u}^{′}=0" :db/id #edb/ref 17592186334263} {:answer/id #uuid "987f5542-c24a-502c-b507-09ab20af49fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}-2{u}^{′}=0" :db/id #edb/ref 17592186334340} {:answer/id #uuid "e593b34e-ca61-5493-979a-cdf8d1326e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+7{u}^{′}=0" :db/id #edb/ref 17592186334987}] :answer-field/correct {:answer/id #uuid "e593b34e-ca61-5493-979a-cdf8d1326e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+7{u}^{′}=0" :db/id #edb/ref 17592186334987} :answer-field/id #uuid "b2aa559f-27df-59e2-a494-d0880512671b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335564}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a18ec5a-2e1b-5a0c-b567-88ee298d1b67" :question/math-academy-id "q-64995" :question/problem "The function ${y}_{1}(x)=x$ is a solution to the equation ${x}^{2}{y}^{″}+5x{y}^{′}-5y=0$ for $x>0.$ If ${y}_{2}=u(x){y}_{1}(x)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(x)?$" :question/worked-solution "We're given that\n\n$$\n{y}_{2}(x)=u(x){y}_{1}(x)=ux.\n$$\n\nDifferentiating ${y}_{2}=ux$ with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}x+u \\\\ {y}_{2}^{″} & ={u}^{″}x+2{u}^{′}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}({u}^{″}x+2{u}^{′})+5x({u}^{′}x+u)-5ux & =0 \\\\ {u}^{″}{x}^{3}+2{u}^{′}{x}^{2}+5{u}^{′}{x}^{2}+5ux-5ux & =0 \\\\ {u}^{″}{x}^{3}+7{u}^{′}{x}^{2} & =0 \\\\ {x}^{2}({u}^{″}x+7{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${x}^{2}\\ne 0$ for $x>0,$ we must have\n\n$$\nx{u}^{″}+7{u}^{′}=0.\n$$"}]}
