#{[{:db/id #edb/ref 17592186125184 :knowledge-point/_questions [{:db/id #edb/ref 17592186124563 :knowledge-point/id #uuid "ba3e0748-2a14-547e-b21e-c34251994a94" :knowledge-point/title "Finding the Differential Equation Satisfied by the Reduction of Order Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093ed2aa-2b8c-5168-874c-f820cb49ad56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{u}^{″}+5{u}^{′}=0" :db/id #edb/ref 17592186333073} {:answer/id #uuid "5d674283-f300-5b61-b687-08e0a2a4f93e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}-5{u}^{′}=0" :db/id #edb/ref 17592186333843} {:answer/id #uuid "8ef5037c-c9e5-51c3-8f13-71949d2ee3b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+3{u}^{′}=0" :db/id #edb/ref 17592186334263} {:answer/id #uuid "987f5542-c24a-502c-b507-09ab20af49fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}-2{u}^{′}=0" :db/id #edb/ref 17592186334340} {:answer/id #uuid "e593b34e-ca61-5493-979a-cdf8d1326e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+7{u}^{′}=0" :db/id #edb/ref 17592186334987}] :answer-field/correct {:answer/id #uuid "e593b34e-ca61-5493-979a-cdf8d1326e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{u}^{″}+7{u}^{′}=0" :db/id #edb/ref 17592186334987} :answer-field/id #uuid "b2aa559f-27df-59e2-a494-d0880512671b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335564}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a18ec5a-2e1b-5a0c-b567-88ee298d1b67" :question/math-academy-id "q-64995" :question/problem "The function ${y}_{1}(x)=x$ is a solution to the equation ${x}^{2}{y}^{″}+5x{y}^{′}-5y=0$ for $x>0.$ If ${y}_{2}=u(x){y}_{1}(x)$ is a second solution of the equation, then which of the following equations must be satisfied by $u(x)?$" :question/worked-solution "We're given that\n\n$$\n{y}_{2}(x)=u(x){y}_{1}(x)=ux.\n$$\n\nDifferentiating ${y}_{2}=ux$ with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}x+u \\\\ {y}_{2}^{″} & ={u}^{″}x+2{u}^{′}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}({u}^{″}x+2{u}^{′})+5x({u}^{′}x+u)-5ux & =0 \\\\ {u}^{″}{x}^{3}+2{u}^{′}{x}^{2}+5{u}^{′}{x}^{2}+5ux-5ux & =0 \\\\ {u}^{″}{x}^{3}+7{u}^{′}{x}^{2} & =0 \\\\ {x}^{2}({u}^{″}x+7{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${x}^{2}\\ne 0$ for $x>0,$ we must have\n\n$$\nx{u}^{″}+7{u}^{′}=0.\n$$"}]}
