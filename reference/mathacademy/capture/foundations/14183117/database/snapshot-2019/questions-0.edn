-91aa-4cc91e0b6090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{C}{x+1}" :db/id #edb/ref 17592186365905} :answer-field/id #uuid "f0c66c58-9529-5f64-8eae-d3568d6b39ba" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186365902} {:answer-field/choices [{:answer/id #uuid "d32f48fb-9f48-5f8d-aac1-2d9bfae7ddb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x+1}" :db/id #edb/ref 17592186365908} {:answer/id #uuid "944aa1bb-2eef-54a1-89ba-4ab67e02b792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{Q(x)}{x+1}" :db/id #edb/ref 17592186365909} {:answer/id #uuid "42d3d69c-9157-589f-b9d3-587708493792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x+1}" :db/id #edb/ref 17592186365910} {:answer/id #uuid "35fcebaf-a241-54dc-83a1-4a302016a95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{Q(x)}" :db/id #edb/ref 17592186365911}] :answer-field/correct {:answer/id #uuid "d32f48fb-9f48-5f8d-aac1-2d9bfae7ddb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x+1}" :db/id #edb/ref 17592186365908} :answer-field/id #uuid "fd621739-f59b-5606-8972-edb16f5ebfcc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186365907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79e61f49-73ab-5296-adbd-e1c1f22991f7" :question/math-academy-id "q-343292" :question/problem "$$\n{y}^{″}+\\frac{1}{x+1}{y}^{′}+Q(x)y=0,\\,x>0\n$$\n\nLet ${y}_{1}$ and ${y}_{2}$ be solutions to the second-order homogeneous differential equation above, where $Q(x)$ is continuous on $(0,\\infty ).$ The Wronskian satisfies $W(1)=0.$ Select the correct options in the reasoning below.The Wronskian $W(x)$ satisfies the following first-order differential equation:\n\n$$\n{W}^{′}(x)={{field-1}}W(x)\n$$\n\nSolving this equation, we get\n\n$$\nW={{field-2}}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nNow, using the fact that $W(1)=0,$ we obtain \n{{field-3}}." :question/worked-solution "Abel's identity says that if ${y}_{1}$ and ${y}_{2}$ are solutions of\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=0,\n$$\n\nthen their Wronskian $W(x)$ satisfies\n\n$$\n{W}^{′}(x)=-P(x)W(x).\n$$\n\nIn our equation, the coefficient of ${y}^{′}$ is \n\n$$\nP(x)=\\frac{1}{x+1}.\n$$\n\nSubstituting into Abel's identity gives\n\n$$\n{W}^{′}(x)=-\\frac{1}{x+1}W(x).\n$$\n\nNow, we solve the first-order differential equation for $W:$\n\n$$\n\\begin{aligned}{W}^{′} & =-\\frac{1}{x+1}W \\\\ \\frac{\\text{d}W}{W} & =-\\frac{1}{x+1}\\text{d}x \\\\ \\int \\frac{\\text{d}W}{W} & =\\int -\\frac{1}{x+1}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|W| & =-\\operatorname{ln}⁡(x+1)+K \\\\ |W| & ={e}^{K}(x+1)^{-1} \\\\ W & =\\frac{C}{x+1}\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nNext, we use the given value $W(1)=0$ to find $C:$\n\n$$\n\\begin{aligned}W(1) & =\\frac{C}{1+1} \\\\ 0 & =\\frac{C}{2} \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have $W(x)=0\\text{ for all }x>0.$"}] [{:db/id #edb/ref 17592186397647 :knowledge-point/_questions [{:db/id #edb/ref 17592186217246 :knowledge-point/id #uuid "734fe467-57d6-5b3f-a61e-1e2e4624b5fc" :knowledge-point/title "Using Abel's Identity to Conclude Independence/Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de6a57db-718b-534a-ae9e-131e468efa23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3Q(x)" :db/id #edb/ref 17592186397649} {:answer/id #uuid "a9ce1615-d523-520a-92c9-77d8376540ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3Q(x)" :db/id #edb/ref 17592186397650} {:answer/id #uuid "7849e7e8-dd36-565f-b3df-32eaf5d73858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186397651} {:answer/id #uuid "6418d95c-2071-5910-935c-316e5a6e14e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186397652}] :answer-field/correct {:answer/id #uuid "6418d95c-2071-5910-935c-316e5a6e14e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186397652} :answer-field/id #uuid "2abe0e81-32ea-5c8a-8474-a8da7cef4208" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186397648} {:answer-field/choices [{:answer/id #uuid "ced5090f-a9f5-5a32-868e-dc53d28d58ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C{e}^{3x}" :db/id #edb/ref 17592186397654} {:answer/id #uuid "774462d4-46f9-512e-8905-d39831ad658e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C{e}^{-3x}" :db/id #edb/ref 17592186397655} {:answer/id #uuid "2575b061-d8fc-52a6-b1af-7e66bd3daf8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C{x}^{2}" :db/id #edb/ref 17592186397656} {:answer/id #uuid "2ade0a28-db59-5ae1-84d7-b56b3670e989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Cx" :db/id #edb/ref 17592186397657}] :answer-field/correct {:answer/id #uuid "774462d4-46f9-512e-8905-d39831ad658e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C{e}^{-3x}" :db/id #edb/ref 17592186397655} :answer-field/id #uuid "2812c0aa-a8f5-52e5-9ddb-2cd3402c3d64" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186397653} {:answer-field/choices [{:answer/id #uuid "7ded8315-1dbf-5143-8c09-39b574a39a0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$W(x)\\ne 0$ for all $x\\in R$" :db/id #edb/ref 17592186397659} {:answer/id #uuid "703b696a-f747-5010-96b9-919bbf602029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$W(x)=0$ for all $x\\in R$" :db/id #edb/ref 17592186397660} {:answer/id #uuid "a35cefdf-5d10-56e7-a5d1-a38747aa53bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$W(x)=0$ for some but not all $x\\in R$" :db/id #edb/ref 17592186397661}] :answer-field/correct {:answer/id #uuid "703b696a-f747-5010-96b9-919bbf602029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$W(x)=0$ for all $x\\in R$" :db/id #edb/ref 17592186397660} :answer-field/id #uuid "02065a3e-a8fd-5833-9e30-70ce022d3cfe" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186397658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b1f9810-dc22-5af5-9afc-b7fe4c62290d" :question/math-academy-id "q-343295" :question/problem "$$\n{y}^{″}+3{y}^{′}+Q(x)y=0\n$$\n\nLet ${y}_{1}$ and ${y}_{2}$ be solutions to the second-order homogeneous differential equation above, where $Q(x)$ is continuous on $(-\\infty ,\\infty ).$ The Wronskian satisfies $W(0)=0.$ Select the correct options in the reasoning below.The Wronskian $W(x)$ satisfies the following first-order differential equation:\n\n$$\n{W}^{′}(x)={{field-1}}W(x)\n$$\n\nSolving this equation, we get\n\n$$\nW={{field-2}}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nNow, using the fact that $W(0)=0,$ we obtain \n{{field-3}}." :question/worked-solution "Abel's identity says that if ${y}_{1}$ and ${y}_{2}$ are solutions of\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=0,\n$$\n\nthen their Wronskian $W(x)$ satisfies\n\n$$\n{W}^{′}(x)=-P(x)W(x).\n$$\n\nIn our equation, the coefficient of ${y}^{′}$ is \n\n$$\nP(x)=3.\n$$\n\nSubstituting into Abel's identity gives\n\n$$\n{W}^{′}(x)=-3W(x).\n$$\n\nNow, we solve the first-order differential equation for $W:$\n\n$$\n\\begin{aligned}{W}^{′} & =-3W \\\\ \\frac{\\text{d}W}{W} & =-3\\text{d}x \\\\ \\int \\frac{\\text{d}W}{W} & =\\int -3\\,\\text{d}x \\\\ \\operatorname{ln}⁡|W| & =-3x+K \\\\ |W| & ={e}^{K}{e}^{-3x} \\\\ W & =C{e}^{-3x}\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nNext, we use the given value $W(0)=0$ to find $C:$\n\n$$\n\\begin{aligned}W(0) & =C{e}^{-3\\cdot 0} \\\\ 0 & =C\\cdot 1 \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have $W(x)=0\\text{ for all }x\\in R.$"}]}
