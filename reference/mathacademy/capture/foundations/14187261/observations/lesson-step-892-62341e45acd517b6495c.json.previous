3 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\"></path>\n<path stroke-width=\"1\" id=\"E7-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E7-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E7-MJMAIN-32\" x=\"809\" y=\"513\"></use>\n <use xlink:href=\"#E7-MJMAIN-3D\" x=\"1304\" y=\"0\"></use>\n<g transform=\"translate(2360,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1150\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E7-MJMATHI-68\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E7-MJMAIN-32\" x=\"815\" y=\"513\"></use>\n</g>\n <use xlink:href=\"#E7-MJMAIN-32\" x=\"324\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E7-MJMAIN-2C\" x=\"3750\" y=\"0\"></use>\n</g>\n</svg></span> we have</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"8.718ex\" height=\"5.676ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1652.5 3753.5 2443.8\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-8-Title\">\n<title id=\"MathJax-SVG-8-Title\">\nA = \\dfrac{h^2}{2}.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E8-MJMATHI-41\" d=\"M208 74Q208 50 254 46Q2