92186045417] [17592186259426 #edb/ref 1075 #edb/ref 17592186257816 #edb/ref 17592186045417] [17592186259426 #edb/ref 1075 #edb/ref 17592186258031 #edb/ref 17592186045417] [17592186259426 #edb/ref 1075 #edb/ref 17592186258327 #edb/ref 17592186045417] [17592186259426 #edb/ref 1075 #edb/ref 17592186258504 #edb/ref 17592186045417] [17592186259426 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259426 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259426 #edb/ref 1078 #edb/ref 17592186258504 #edb/ref 17592186045417] [17592186259426 #edb/ref 1079 #uuid "e01a598b-b83f-5863-8bdb-0dee44f45e9f" #edb/ref 17592186045417] [17592186259466 #edb/ref 1075 #edb/ref 17592186257072 #edb/ref 17592186045417] [17592186259466 #edb/ref 1075 #edb/ref 17592186257504 #edb/ref 17592186045417] [17592186259466 #edb/ref 1075 #edb/ref 17592186258219 #edb/ref 17592186045417] [17592186259466 #edb/ref 1075 #edb/ref 17592186258368 #edb/ref 17592186045417] [17592186259466 #edb/ref 1075 #edb/ref 17592186258549 #edb/ref 17592186045417] [17592186259466 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259466 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259466 #edb/ref 1078 #edb/ref 17592186258219 #edb/ref 17592186045417] [17592186259466 #edb/ref 1079 #uuid "f6fe7e29-2bae-5992-a703-7a5a5b07cc37" #edb/ref 17592186045417] [17592186259471 #edb/ref 1075 #edb/ref 17592186256842 #edb/ref 17592186045417] [17592186259471 #edb/ref 1075 #edb/ref 17592186256976 #edb/ref 17592186045417] [17592186259471 #edb/ref 1075 #edb/ref 17592186257568 #edb/ref 17592186045417] [17592186259471 #edb/ref 1075 #edb/ref 17592186257599 #edb/ref 17592186045417] [17592186259471 #edb/ref 1075 #edb/ref 17592186258319 #edb/ref 17592186045417] [17592186259471 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259471 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259471 #edb/ref 1078 #edb/ref 17592186257568 #edb/ref 17592186045417] [17592186259471 #edb/ref 1079 #uuid "f9e06902-20f2-5350-9460-18f9f5e02942" #edb/ref 17592186045417] [17592186259719 #edb/ref 1068 #edb/ref 17592186259066 #edb/ref 17592186045417] [17592186259719 #edb/ref 1069 "q-124706" #edb/ref 17592186045417] [17592186259719 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186259719 #edb/ref 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=x\\,i+{y}^{2}\\,j$ and $C$ is the curve ${y}^{3}=x+3$ traversed from the point $A(-3,0)$ to the point $B(5,2).$" #edb/ref 17592186045417] [17592186259719 #edb/ref 1072 #uuid "150b42f1-7628-5a99-bfed-f0542c112a51" #edb/ref 17592186045417] [17592186259719 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Making $x$ the subject of the equation, we have\n\n$$\n{y}^{3}=x+3\\,⟹\\,x={y}^{3}-3.\n$$\n\nSo, the parametrization of the curve is given by\n\n$$\n\\begin{aligned}r(t) & =({t}^{3}-3)\\,i+t\\,j,\\,0\\le t\\le 2.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx={t}^{3}-3,\\,y=t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+{y}^{2}\\,j \\\\  & =({t}^{3}-3)\\,i+{t}^{2}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(({t}^{3}-3))i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =3{t}^{2}i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(({t}^{3}-3)\\,i+{t}^{2}\\,j)\\cdot (3{t}^{2}\\,i+j) \\\\  & =({t}^{3}-3)\\cdot 3{t}^{2}+{t}^{2}\\cdot 1 \\\\  & =3{t}^{5}-9{t}^{2}+{t}^{2} \\\\  & =3{t}^{5}-8{t}^{2}\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(3{t}^{5}-8{t}^{2})\\,dt \\\\  & ={[\\frac{{t}^{6}}{2}-\\frac{8{t}^{3}}{3}]}_{0}^{2} \\\\  & =(\\frac{{2}^{6}}{2}-\\frac{8(2)^{3}}{3})-0 \\\\  & =32-\\frac{64}{3} \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259767 #edb/ref 1068 #edb/ref 17592186259221 #edb/ref 17592186045417] [17592186259767 #edb/ref 1069 "q-125027" #edb/ref 17592186045417] [17592186259767 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259767 #edb/ref 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=x\\,i+y\\,j$ and $C$ is the curve $y=3{x}^{2}+1$ traversed from the point $A(0,1)$ to the point $B(1,4).$" #edb/ref 17592186045417] [17592186259767 #edb/ref 1072 #uuid "68c03a79-0b0a-5308-9532-cf00ca2d646f" #edb/ref 17592186045417] [17592186259767 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Since $y$ is the subject of the equation, a parametrization is given by\n\n$$\n\\begin{aligned}r(t) & =t\\,i+(3{t}^{2}+1)\\,j,\\,0\\le t\\le 1.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=t,\\,y=3{t}^{2}+1.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =t\\,i+(3{t}^{2}+1)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+1)j \\\\  & =i+6t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(t\\,i+(3{t}^{2}+1)\\,j)\\cdot (i+6t\\,j) \\\\  & =t\\cdot 1+(3{t}^{2}+1)\\cdot 6t \\\\  & =t+18{t}^{3}+6t \\\\  & =7t+18{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(7t+18{t}^{3})\\,dt \\\\  & ={[\\frac{7{t}^{2}}{2}+\\frac{9{t}^{4}}{2}]}_{0}^{1} \\\\  & =(\\frac{7(1)^{2}}{2}+\\frac{9(1)^{4}}{2})-0 \\\\  & =\\frac{16}{2} \\\\  & =8\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259768 #edb/ref 1068 #edb/ref 17592186259187 #edb/ref 17592186045417] [17592186259768 #edb/ref 1069 "q-125047" #edb/ref 17592186045417] [17592186259768 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259768 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=\\operatorname{ln}⁡(x+y)\\,i+\\sqrt{xy}\\,j$ and $C$ is the line segment traversed from the point $A(1,1)$ to the point $B(4,3)?$\n\n*Hint: Use the parametrization $r(t)=(1+3t)\\,i+(1+2t)\\,j.$*" #edb/ref 17592186045417] [17592186259768 #edb/ref 1072 #uuid "e1e4da74-c912-5fe5-936d-1666e265c014" #edb/ref 17592186045417] [17592186259768 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are \n$a=i+j$ and $b=4\\,i+3\\,j.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =(i+j)+t[(4\\,i+3\\,j)-(i+j)] \\\\  & =(i+j)+t(3i+2\\,j) \\\\  & =(1+3t)\\,i+(1+2t)\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t=1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx=1+3t,\\,y=1+2t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =\\operatorname{ln}⁡(x+y)\\,i+\\sqrt{xy}\\,j \\\\  & =\\operatorname{ln}⁡(1+3t+1+2t)\\,i+\\sqrt{(1+3t)(1+2t)}\\,j \\\\  & =\\operatorname{ln}⁡(2+5t)\\,i+\\sqrt{1+5t+6{t}^{2}}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1+3t)i+\\frac{\\text{d}}{\\text{d}t}(1+2t)j \\\\  & =3\\,i+2\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{ln}⁡(2+5t)\\,i+\\sqrt{1+5t+6{t}^{2}}\\,j)\\cdot (3\\,i+2\\,j) \\\\  & =\\operatorname{ln}⁡(2+5t)\\cdot 3+\\sqrt{1+5t+6{t}^{2}}\\cdot 2 \\\\  & =3\\operatorname{ln}⁡(2+5t)+2\\sqrt{1+5t+6{t}^{2}}.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}3\\operatorname{ln}⁡(2+5t)+2\\sqrt{1+5t+6{t}^{2}}\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259769 #edb/ref 1068 #edb/ref 17592186259189 #edb/ref 17592186045417] [17592186259769 #edb/ref 1069 "q-125048" #edb/ref 17592186045417] [17592186259769 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259769 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=2{x}^{7}\\,i+{5}^{x+y}\\,j$ and $C$ is the line segment traversed from the point $A(2,3)$ to the point $B(5,4)?$\n\n*Hint: Use the parametrization $r(t)=(2+3t)\\,i+(3+t)\\,j.$*" #edb/ref 17592186045417] [17592186259769 #edb/ref 1072 #uuid "73756350-0217-5bec-bce7-083a72fddb57" #edb/ref 17592186045417] [17592186259769 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are \n$a=2\\,i+3\\,j$ and $b=5\\,i+4\\,j.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =(2\\,i+3\\,j)+t[(5\\,i+4\\,j)-(2\\,i+3\\,j)] \\\\  & =(2\\,i+3\\,j)+t(3\\,i+j) \\\\  & =(2+3t)\\,i+(3+t)\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t=1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx=2+3t,\\,y=3+t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =2{x}^{7}\\,i+{5}^{x+y}\\,j \\\\  & =2(2+3t)^{7}\\,i+{5}^{2+3t+3+t}\\,j \\\\  & =2(2+3t)^{7}\\,i+{5}^{5+4t}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2+3t)i+\\frac{\\text{d}}{\\text{d}t}(3+t)j \\\\  & =3\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2(2+3t)^{7}\\,i+{5}^{5+4t}\\,j)\\cdot (3\\,i+j) \\\\  & =2(2+3t)^{7}\\cdot 3+{5}^{5+4t}\\cdot 1 \\\\  & =6(2+3t)^{7}+{5}^{5+4t}.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}6(2+3t)^{7}+{5}^{5+4t}\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259772 #edb/ref 1068 #edb/ref 17592186259466 #edb/ref 17592186045417] [17592186259772 #edb/ref 1069 "q-125053" #edb/ref 17592186045417] [17592186259772 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259772 #edb/ref 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)={e}^{y}\\,i+{e}^{x}\\,j$ and $C$ is the line segment traversed from the point $A(2,0)$ to the point $B(4,2).$" #edb/ref 17592186045417] [17592186259772 #edb/ref 1072 #uuid "70644f1f-e367-534c-b7b4-edf3fcb122f1" #edb/ref 17592186045417] [17592186259772 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are \n$a=2\\,i$ and $b=4\\,i+2\\,j.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =(2\\,i)+t[(4\\,i+2\\,j)-(2\\,i)] \\\\  & =(2\\,i)+t(2\\,i+2\\,j) \\\\  & =(2t+2)\\,i+2t\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t=1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx=2t+2\\,y=2t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & ={e}^{y}\\,i+{e}^{x}\\,j \\\\  & ={e}^{2t}\\,i+{e}^{2t+2}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+2)i+\\frac{\\text{d}}{\\text{d}t}(2t)j \\\\  & =2\\,i+2\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =({e}^{2t}\\,i+{e}^{2t+2}\\,j)\\cdot (2\\,i+2\\,j) \\\\  & ={e}^{2t}\\cdot 2+{e}^{2t+2}\\cdot 2 \\\\  & =2{e}^{2t}(1+{e}^{2}).\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}2{e}^{2t}(1+{e}^{2})\\,dt \\\\  & =(1+{e}^{2}){e}^{2t}{|}_{0}^{1} \\\\  & =(1+{e}^{2})({e}^{2}-1) \\\\  & ={e}^{4}-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259773 #edb/ref 1068 #edb/ref 17592186259471 #edb/ref 17592186045417] [17592186259773 #edb/ref 1069 "q-125065" #edb/ref 17592186045417] [17592186259773 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186259773 #edb/ref 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=x\\,i+2y\\,j$ and $C$ is the curve $\\operatorname{ln}⁡y-x=0$ traversed from the point $A(0,1)$ to the point $B(1,e).$" #edb/ref 17592186045417] [17592186259773 #edb/ref 1072 #uuid "184f4871-87e0-5c99-aba0-b9fc9a5e102d" #edb/ref 17592186045417] [17592186259773 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Making $x$ the subject of the equation, we have\n\n$$\n\\operatorname{ln}⁡y-x=0\\,⟹\\,x=\\operatorname{ln}⁡y.\n$$\n\nSo, the parametrization of the curve is given by\n\n$$\n\\begin{aligned}r(t) & =\\operatorname{ln}⁡t\\,i+t\\,j,\\,1\\le t\\le e.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=\\operatorname{ln}⁡t,\\,y=t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+2y\\,j \\\\  & =\\operatorname{ln}⁡t\\,i+2t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{t}\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{ln}⁡t\\,i+2t\\,j)\\cdot (\\frac{1}{t}\\,i+j) \\\\  & =\\operatorname{ln}⁡t\\cdot \\frac{1}{t}+2t\\cdot 1 \\\\  & =\\frac{\\operatorname{ln}⁡t}{t}+2t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{1}^{e}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{e}(\\frac{\\operatorname{ln}⁡t}{t}+2t)\\,dt \\\\  & ={[\\frac{{ln}^{2}⁡t}{2}+{t}^{2}]}_{1}^{e} \\\\  & =(\\frac{{ln}^{2}⁡e}{2}+{e}^{2})-(0+1) \\\\  & ={e}^{2}-\\frac{1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259781 #edb/ref 1068 #edb/ref 17592186259418 #edb/ref 17592186045417] [17592186259781 #edb/ref 1069 "q-125119" #edb/ref 17592186045417] [17592186259781 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259781 #edb/ref 1071 "Which of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=2y\\,i+{x}^{2}\\,j$ and $C$ is the curve $\\sqrt{y}=x+3$ traversed from the point $A(-3,0)$ to the point $B(-1,4)?$\n\n*Hint: Use the parametrization $r(t)=(\\sqrt{t}-3)\\,i+t\\,j.$*" #edb/ref 17592186045417] [17592186259781 #edb/ref 1072 #uuid "a586e9b0-863c-55ae-99d8-d2f2e26693ec" #edb/ref 17592186045417] [17592186259781 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. This is given by\n\n$$\n\\begin{aligned}r(t) & =(\\sqrt{t}-3)\\,i+t\\,j,\\,0\\le t\\le 4.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=\\sqrt{t}-3,\\,y=t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =2t\\,i+(\\sqrt{t}-3)^{2}\\,j \\\\  & =2t\\,i+(t-6\\sqrt{t}+9)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}-3)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{2\\sqrt{t}}\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2t\\,i+(t-6\\sqrt{t}+9)\\,j)\\cdot (\\frac{1}{2\\sqrt{t}}\\,i+j) \\\\  & =2t\\cdot \\frac{1}{2\\sqrt{t}}+t-6\\sqrt{t}+9 \\\\  & =\\sqrt{t}+t-6\\sqrt{t}+9 \\\\  & =t-5\\sqrt{t}+9.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{4}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}(t-5\\sqrt{t}+9)\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259784 #edb/ref 1068 #edb/ref 17592186259426 #edb/ref 17592186045417] [17592186259784 #edb/ref 1069 "q-125170" #edb/ref 17592186045417] [17592186259784 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259784 #edb/ref 1071 "![](images/00/00ff3216e6876673a388eb3eaa0e7d02e268f5e679593ebd9fe01e2840099e1b.png)\n\nWhich of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=x\\,i+xy\\,j$ and $C$ is the arc of a circle of radius $2$ centered at the origin traversed counterclockwise from the point $(2,0)$ to the point $(0,2)?$\n\n*Hint: Use the parametrization $r(t)=2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j.$*" #edb/ref 17592186045417] [17592186259784 #edb/ref 1072 #uuid "c359f485-3a3d-5def-a8c7-a71d4c1cd8eb" #edb/ref 17592186045417] [17592186259784 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize a part-circle of radius $2$ centered at the origin. This curve can be parameterized as \n\n$$\nr(t)=2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+xy\\,j \\\\  & =2\\operatorname{cos}⁡t\\,i+2\\operatorname{cos}⁡t\\cdot 2\\operatorname{sin}⁡t\\,j \\\\  & =2\\operatorname{cos}⁡t\\,i+4\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2\\operatorname{cos}⁡t\\,i+4\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,j)\\cdot (-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j) \\\\  & =2\\operatorname{cos}⁡t\\cdot (-2\\operatorname{sin}⁡t)+4\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\cdot 2\\operatorname{cos}⁡t \\\\  & =-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+8\\operatorname{sin}⁡t{cos}^{2}⁡t.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{\\pi /2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(8\\operatorname{sin}⁡t{cos}^{2}⁡t-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186324273 #edb/ref 1080 "\\frac{1}{2}+\\frac{\\pi }{2}" #edb/ref 17592186045417] [17592186324273 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324273 #edb/ref 1083 #uuid "24c7893f-0b53-5740-8fbd-ebe54258cfa1" #edb/ref 17592186045417] [17592186324768 #edb/ref 1080 "1-\\frac{\\pi }{2}" #edb/ref 17592186045417] [17592186324768 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324768 #edb/ref 1083 #uuid "5f8031ce-b980-5eb0-9766-6549305fa866" #edb/ref 17592186045417] [17592186325248 #edb/ref 1080 "\\frac{1}{2}-\\pi \\sqrt{2}" #edb/ref 17592186045417] [17592186325248 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325248 #edb/ref 1083 #uuid "95bc9fcf-3ac1-5ef9-8027-af87ed0205b4" #edb/ref 17592186045417] [17592186325498 #edb/ref 1080 "1-\\frac{\\pi \\sqrt{2}}{2}" #edb/ref 17592186045417] [17592186325498 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325498 #edb/ref 1083 #uuid "b23599ac-9233-5e96-a595-f5c52a1d949f" #edb/ref 17592186045417] [17592186326156 #edb/ref 1080 "\\frac{1}{2}-\\frac{\\pi \\sqrt{2}}{2}" #edb/ref 17592186045417] [17592186326156 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186326156 #edb/ref 1083 #uuid "f81eed55-5dd8-5481-8cb2-750b01e06593" #edb/ref 17592186045417] [17592186326629 #edb/ref 1075 #edb/ref 17592186324273 #edb/ref 17592186045417] [17592186326629 #edb/ref 1075 #edb/ref 17592186324768 #edb/ref 17592186045417] [17592186326629 #edb/ref 1075 #edb/ref 17592186325248 #edb/ref 17592186045417] [17592186326629 #edb/ref 1075 #edb/ref 17592186325498 #edb/ref 17592186045417] [17592186326629 #edb/ref 1075 #edb/ref 17592186326156 #edb/ref 17592186045417] [17592186326629 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186326629 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186326629 #edb/ref 1078 #edb/ref 17592186325498 #edb/ref 17592186045417] [17592186326629 #edb/ref 1079 #uuid "df8011e5-0bf7-5c27-90ed-97013e5119ed" #edb/ref 17592186045417] [17592186326764 #edb/ref 1068 #edb/ref 17592186326629 #edb/ref 17592186045417] [17592186326764 #edb/ref 1069 "q-39427" #edb/ref 17592186045417] [17592186326764 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186326764 #edb/ref 1071 "![](images/c5/c5e026312ab8a2ccfc61a37246c954b56550316661f158743cc2c46411a97f53.png)\n\nEvaluate ${\\int }_{C}F(r)\\cdot \\text{d}r,$ where $F(x,y)=(y-x)\\,i-x\\,j$ and $C$ is the arc of the ellipse ${x}^{2}+2{y}^{2}=2$  traversed counterclockwise from the point $(\\sqrt{2},0)$ to the point $(0,1).$" #edb/ref 17592186045417] [17592186326764 #edb/ref 1072 #uuid "d4c5cd42-1163-5d1e-b9ef-190caf4e41ab" #edb/ref 17592186045417] [17592186326764 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Notice that we can write its equation as\n\n$$\n\\frac{{x}^{2}}{2}+{y}^{2}=1.\n$$\n\nSo, our curve is a part-ellipse centered at the origin with horizontal and vertical semiaxes $\\sqrt{2}$ and $1$ respectively. This curve can be parameterized as\n\n$$\nr(t)=\\sqrt{2}\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx=\\sqrt{2}\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =(y-x)\\,i-x\\,j \\\\  & =(\\operatorname{sin}⁡t-\\sqrt{2}\\operatorname{cos}⁡t)\\,i-\\sqrt{2}\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\sqrt{2}\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((\\operatorname{sin}⁡t-\\sqrt{2}\\operatorname{cos}⁡t)\\,i-\\sqrt{2}\\operatorname{cos}⁡t\\,j)\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & =(\\operatorname{sin}⁡t-\\sqrt{2}\\operatorname{cos}⁡t)\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t)-\\sqrt{2}\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & =2\\operatorname{sin}⁡t\\operatorname{cos}⁡t-\\sqrt{2}({sin}^{2}⁡t+{cos}^{2}⁡t) \\\\  & =\\operatorname{sin}⁡2t-\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{\\pi /2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2t-\\sqrt{2}\\,dt \\\\  & ={[-\\frac{1}{2}\\operatorname{cos}⁡2t-\\sqrt{2}t]}_{0}^{\\pi /2} \\\\  & =[-\\frac{1}{2}\\operatorname{cos}⁡\\pi -\\frac{\\pi \\sqrt{2}}{2}]-[-\\frac{1}{2}\\operatorname{cos}⁡(0)-0] \\\\  & =[\\frac{1}{2}-\\frac{\\pi \\sqrt{2}}{2}]-[-\\frac{1}{2}] \\\\  & =\\frac{1}{2}-\\frac{\\pi \\sqrt{2}}{2}+\\frac{1}{2} \\\\  & =1-\\frac{\\pi \\sqrt{2}}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186387568 #edb/ref 1075 #edb/ref 17592186387569 #edb/ref 17592186045417] [17592186387568 #edb/ref 1075 #edb/ref 17592186387570 #edb/ref 17592186045417] [17592186387568 #edb/ref 1075 #edb/ref 17592186387571 #edb/ref 17592186045417] [17592186387568 #edb/ref 1075 #edb/ref 17592186387572 #edb/ref 17592186045417] [17592186387568 #edb/ref 1075 #edb/ref 17592186387573 #edb/ref 17592186045417] [17592186387568 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186387568 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186387568 #edb/ref 1078 #edb/ref 17592186387569 #edb/ref 17592186045417] [17592186387568 #edb/ref 1079 #uuid "cde08ab3-6529-5baf-9022-6a7982378821" #edb/ref 17592186045417]}
