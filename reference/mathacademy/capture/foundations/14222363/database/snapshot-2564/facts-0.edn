 17592186045417] [17592186179864 #edb/ref 1050 1080.0 #edb/ref 17592186045417] [17592186179864 #edb/ref 1053 #uuid "081747a0-57ee-5aec-8eb5-e43238a80d3d" #edb/ref 17592186045417] [17592186180010 #edb/ref 1068 #edb/ref 17592186387568 #edb/ref 17592186045417] [17592186180010 #edb/ref 1069 "q-124701" #edb/ref 17592186045417] [17592186180010 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180010 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)={e}^{x}\\,i+\\operatorname{ln}⁡y\\,j$ and $C$ is the line segment traversed from the point $A(3,2)$ to the point $B(1,5)?$\n\n*Hint: Use the parametrization $r(t)=(3-2t)\\,i+(2+3t)\\,j.$*" #edb/ref 17592186045417] [17592186180010 #edb/ref 1072 #uuid "88b31475-15e6-5485-a3fc-dfd5113d0f64" #edb/ref 17592186045417] [17592186180010 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are $a=3\\,i+2\\,j$ and $b=i+5\\,j.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =(3\\,i+2\\,j)+t[(i+5\\,j)-(3\\,i+2\\,j)] \\\\  & =(3\\,i+2\\,j)+t(-2\\,i+3\\,j) \\\\  & =(3-2t)\\,i+(2+3t)\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t=1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx=3-2t,\\,y=2+3t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & ={e}^{x}\\,i+\\operatorname{ln}⁡y\\,j \\\\  & ={e}^{3-2t}\\,i+\\operatorname{ln}⁡(2+3t)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3-2t)i+\\frac{\\text{d}}{\\text{d}t}(2+3t)j \\\\  & =-2\\,i+3\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =({e}^{3-2t}\\,i+\\operatorname{ln}⁡(2+3t)\\,j)\\cdot (-2\\,i+3\\,j) \\\\  & ={e}^{3-2t}\\cdot (-2)+\\operatorname{ln}⁡(2+3t)\\cdot 3 \\\\  & =-2{e}^{3-2t}+3\\operatorname{ln}⁡(2+3t).\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}-2{e}^{3-2t}+3\\operatorname{ln}⁡(2+3t)\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180012 #edb/ref 1068 #edb/ref 17592186414904 #edb/ref 17592186045417] [17592186180012 #edb/ref 1069 "q-124703" #edb/ref 17592186045417] [17592186180012 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180012 #edb/ref 1071 "Which of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=\\operatorname{cos}⁡x\\,i+\\operatorname{sin}⁡y\\,j$ and $C$ is the curve $y=2{x}^{2}-1$ traversed from the point $A(1,1)$ to the point $B(2,7)?$\n\n*Hint: Use the parametrization $r(t)=t\\,i+(2{t}^{2}-1)\\,j.$*" #edb/ref 17592186045417] [17592186180012 #edb/ref 1072 #uuid "d4e0663c-1824-56f9-b923-60eb7cd3a338" #edb/ref 17592186045417] [17592186180012 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. This is given by\n\n$$\n\\begin{aligned}r(t) & =t\\,i+(2{t}^{2}-1)\\,j,\\,1\\le t\\le 2.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=t,\\,y=2{t}^{2}-1.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =\\operatorname{cos}⁡x\\,i+\\operatorname{sin}⁡y\\,j \\\\  & =\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡(2{t}^{2}-1)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}-1)j \\\\  & =i+4t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡(2{t}^{2}-1)\\,j)\\cdot (i+4t\\,j) \\\\  & =\\operatorname{cos}⁡t\\cdot 1+\\operatorname{sin}⁡(2{t}^{2}-1)\\cdot 4t \\\\  & =\\operatorname{cos}⁡t+4t\\operatorname{sin}⁡(2{t}^{2}-1).\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{1}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}\\operatorname{cos}⁡t+4t\\operatorname{sin}⁡(2{t}^{2}-1)\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180172 #edb/ref 1068 #edb/ref 17592186414912 #edb/ref 17592186045417] [17592186180172 #edb/ref 1069 "q-39341" #edb/ref 17592186045417] [17592186180172 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180172 #edb/ref 1071 "![](images/48/4807f92defb4202359a32ca046073cd138db396a0975164e42b96126ac0cc591.png)\n\nWhich of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)={e}^{x}\\,i+{e}^{-2y}\\,j$ and $C$ is the arc of a circle of radius $1$ centered at the origin traversed counterclockwise from the point $(1,0)$ to the point $(0,1)?$\n\n*Hint: Use the parametrization $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j.$*" #edb/ref 17592186045417] [17592186180172 #edb/ref 1072 #uuid "e19e4fc2-d0da-5e51-a13e-b5b2b6e03a48" #edb/ref 17592186045417] [17592186180172 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize a part-circle of radius $1$ centered at the origin. This curve can be parameterized as \n\n$$\nr(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & ={e}^{x}\\,i+{e}^{-2y}\\,j \\\\  & ={e}^{\\operatorname{cos}⁡t}\\,i+{e}^{-2\\operatorname{sin}⁡t}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =({e}^{\\operatorname{cos}⁡t}\\,i+{e}^{-2\\operatorname{sin}⁡t}\\,j)\\cdot (-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & ={e}^{\\operatorname{cos}⁡t}\\cdot (-\\operatorname{sin}⁡t)+{e}^{-2\\operatorname{sin}⁡t}\\cdot \\operatorname{cos}⁡t \\\\  & =-\\operatorname{sin}⁡t\\,{e}^{\\operatorname{cos}⁡t}+\\operatorname{cos}⁡t\\,{e}^{-2\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{\\pi /2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}-\\operatorname{sin}⁡t\\,{e}^{\\operatorname{cos}⁡t}+\\operatorname{cos}⁡t\\,{e}^{-2\\operatorname{sin}⁡t}\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180488 #edb/ref 1058 #edb/ref 17592186180491 #edb/ref 17592186045417] [17592186180488 #edb/ref 1061 35690 #edb/ref 17592186045417] [17592186180488 #edb/ref 1062 #uuid "7b85eebf-c70c-58a0-9476-5bcb73727ad3" #edb/ref 17592186045417] [17592186180488 #edb/ref 1063 #edb/ref 17592186180718 #edb/ref 17592186045417] [17592186180489 #edb/ref 1061 35691 #edb/ref 17592186045417] [17592186180489 #edb/ref 1062 #uuid "c535e9dc-5505-59aa-ae55-5a85fcb5135c" #edb/ref 17592186045417] [17592186180489 #edb/ref 1063 #edb/ref 17592186179735 #edb/ref 17592186045417] [17592186180490 #edb/ref 1058 #edb/ref 17592186180489 #edb/ref 17592186045417] [17592186180490 #edb/ref 1061 35692 #edb/ref 17592186045417] [17592186180490 #edb/ref 1062 #uuid "922dce6d-b939-516c-95ed-a47bcba850e1" #edb/ref 175921860454