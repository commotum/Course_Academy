/ref 17592186045436] [17592186050860 #edb/ref 1029 #edb/ref 17592186429737 #edb/ref 17592186045436] [17592186050860 #edb/ref 1029 #edb/ref 17592186429738 #edb/ref 17592186045436] [17592186050860 #edb/ref 1029 #edb/ref 17592186429739 #edb/ref 17592186045436] [17592186050860 #edb/ref 1029 #edb/ref 17592186429740 #edb/ref 17592186045436] [17592186050860 #edb/ref 1029 #edb/ref 17592186429741 #edb/ref 17592186045436] [17592186050860 #edb/ref 1031 "The Arc Length of a Parametric Curve" #edb/ref 17592186045417] [17592186050860 #edb/ref 1033 997 #edb/ref 17592186045417] [17592186050860 #edb/ref 1034 0.9339225415057509 #edb/ref 17592186045436] [17592186050860 #edb/ref 1035 #uuid "6c427c49-4a33-55da-a8ed-0f9ab82b1d58" #edb/ref 17592186045417] [17592186179597 #edb/ref 1069 "e-9531" #edb/ref 17592186045417] [17592186179597 #edb/ref 1071 "Evaluate $\\displaystyle \\oint\\limits_{C} \\mathbf{F}(\\mathbf{r}) \\cdot \\textrm{d}\\mathbf{r},$ where $\\mathbf F(x, y) = y\\,\\mathbf{i} + x\\,\\mathbf{j}$ and $C$ is a circle of radius $1$ centered at the origin, traversed once in the counterclockwise direction." #edb/ref 17592186045417] [17592186179597 #edb/ref 1072 #uuid "e4893301-34d3-5f63-9d1c-715588d98d40" #edb/ref 17592186045417] [17592186179597 #edb/ref 1074 "The notation $\\displaystyle\\oint$ is used to remind us that we're dealing with a line integral over a *closed* curve.\n\nWe will use the formula\n\n$$\n\\oint\\limits_C \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int_a^b \\mathbf{F}(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t) \\,\\textrm{d}t.\n$$\n\nFirst, we need to parameterize a circle of radius $1$ centered at the origin. It can be parameterized as \n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} + \\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\lt 2\\pi.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx = \\cos{t}, \\qquad\ny = \\sin{t}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,j=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j)\\cdot (-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j) \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t \\\\  & =-(1-{cos}^{2}⁡t)+{cos}^{2}⁡t \\\\  & =2{cos}^{2}⁡t-1 \\\\  & =\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,dt \\\\  & ={[\\frac{1}{2}\\operatorname{sin}⁡2t]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡4\\pi -\\frac{1}{2}\\operatorname{sin}⁡(0) \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179598 #edb/ref 1069 "e-9532" #edb/ref 17592186045417] [17592186179598 #edb/ref 1071 "Evaluate $\\displaystyle \\int\\limits_{C} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r},$ where $\\mathbf F(x, y) = y\\,\\mathbf{i} + x\\,\\mathbf{j}$ and $C$ is the curve $y^3 = x-5$ traversed from the point $A(5,0)$ to the point $B(6,1).$" #edb/ref 17592186045417] [17592186179598 #edb/ref 1072 #uuid "a448227d-9bf3-54dd-8639-cbdc56a5a403" #edb/ref 17592186045417] [17592186179598 #edb/ref 1074 "We will use the formula\n\n$$\n\\int\\limits_C \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int_a^b \\mathbf{F}(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t) \\,\\textrm{d}t.\n$$\n\nFirst, we need to parameterize the curve. Making $x$ the subject of the equation, we have\n\n$$\ny^3 = x-5\n\\qquad \\Longrightarrow \\qquad\nx = y^3 + 5.\n$$\n\nSo, we can parametrize the curve using\n\n$$\n\\begin{aligned}r(t) & =({t}^{3}+5)\\,i+t\\,j,\\,0\\le t\\le 1.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx = t^3+5, \\qquad\ny = t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =y\\,i+x\\,j \\\\  & =t\\,i+({t}^{3}+5)\\,j.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+5)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =3{t}^{2}\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(t\\,i+({t}^{3}+5)\\,j)\\cdot (3{t}^{2}\\,i+j) \\\\  & =t\\cdot 3{t}^{2}+({t}^{3}+5)\\cdot 1 \\\\  & =3{t}^{3}+{t}^{3}+5 \\\\  & =4{t}^{3}+5.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4{t}^{3}+5\\,dt \\\\  & ={[{t}^{4}+5t]}_{0}^{1} \\\\  & =1+5-0 \\\\  & =6\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179599 #edb/ref 1069 "e-9533" #edb/ref 17592186045417] [17592186179599 #edb/ref 1071 "Evaluate $\\displaystyle \\int\\limits_{C} \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r},$ where $\\mathbf F(x, y) =(1-y)^2\\,\\mathbf{i} + x\\,\\mathbf{j}$ and $C$ is the line segment traversed from the point $A(0, 2)$ to the point $B(1,0).$" #edb/ref 17592186045417] [17592186179599 #edb/ref 1072 #uuid "9152629f-47a8-5a71-9bd9-3f5205788f5d" #edb/ref 17592186045417] [17592186179599 #edb/ref 1074 "We will use the formula\n\n$$\n\\int\\limits_C \\mathbf{F} \\cdot \\textrm{d}\\mathbf{r} = \\int_a^b \\mathbf{F}(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t) \\,\\textrm{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are \n$\\mathbf{a} = 2\\mathbf{j}$ and $\\mathbf{b} = \\mathbf{i}.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =2j+t[i-2j] \\\\  & =t\\,i+(2-2t)\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t = 1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx = t, \\qquad\n\ty = 2-2t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =(1-y)^{2}\\,i+x\\,j \\\\  & =(1-(2-2t))^{2}\\,i+t\\,j \\\\  & =(2t-1)^{2}\\,i+t\\,j \\\\  & =(4{t}^{2}-4t+1)\\,i+t\\,j.\\end{aligned}\n$$\n\nComputing $\\mathbf{r}'(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(2-2t)j \\\\  & =i-2j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((4{t}^{2}-4t+1)\\,i+t\\,j)\\cdot (i-2j) \\\\  & =(4{t}^{2}-4t+1)\\cdot (1)+(t)\\cdot (-2) \\\\  & =4{t}^{2}-6t+1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4{t}^{2}-6t+1\\,dt \\\\  & =(\\frac{4}{3}{t}^{3}-3{t}^{2}+t){|}_{0}^{1} \\\\  & =(\\frac{4}{3}-3+1)-0 \\\\  & =-\\frac{2}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179735 #edb/ref 1037 #edb/ref 17592186048655 #edb/ref 17592186045417] [17592186179735 #edb/ref 1037 #edb/ref 17592186049512 #edb/ref 17592186045417] [17592186179735 #edb/ref 1037 #edb/ref 17592186050616 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186180015 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186180172 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186259784 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186259787 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186326764 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186345267 #edb/ref 17592186045417] [17592186179735 #edb/ref 1038 #edb/ref 17592186345268 #edb/ref 17592186045417] [17