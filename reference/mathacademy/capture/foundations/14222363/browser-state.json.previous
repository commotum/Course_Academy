vel=\"0\"><mfrac><mrow><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi></mrow><mi>t</mi></mfrac></mstyle><mo>+</mo><mn>2</mn><mi>t</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>ln</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>ln</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>e</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><msup><mi>e</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mo stretchy=\"false\">(</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
