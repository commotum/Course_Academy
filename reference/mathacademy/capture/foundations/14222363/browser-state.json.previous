      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125170-b268021dc3151108a929.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125170-b268021dc3151108a929.png",
      "source_url": "https://mathacademy.com/tasks/14222363/topics/3711/lesson",
      "captured_at": 1792031992.291743,
      "math_academy_id": "q-125170",
