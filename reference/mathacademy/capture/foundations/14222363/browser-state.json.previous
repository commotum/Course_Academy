      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q39427-87940a0dcfa82258f9ed.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q39427-87940a0dcfa82258f9ed.png",
      "source_url": "https://mathacademy.com/tasks/14222363/topics/3711/lesson",
