      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125119-eb219927830899382572.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125119-eb219927830899382572.png",
      "source_url": "https://mathacademy.com/tasks/14222363/topics/3711/lesson",
      "captured_at": 1792031962.9149454,
      "math_academy_id": "q-125119",
      "topic_id": "3711",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q125119",
        "placement_id": null,
