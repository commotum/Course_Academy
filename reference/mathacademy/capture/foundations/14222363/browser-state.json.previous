      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125234-3c8878145258190b4592.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14222363/observations/step-q125234-3c8878145258190b4592.png",
      "source_url": "https://mathacademy.com/tasks/14222363/topics/3711/lesson",
      "captured_at": 1792032037.9415464,
      "math_academy_id": "q-125234",
      "topic_id": "3711",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q125234",
        "placement_id": null,
        "content_id": null,
