#{[{:db/id #edb/ref 17592186172282 :knowledge-point/_questions [{:db/id #edb/ref 17592186172088 :knowledge-point/id #uuid "888aa30d-7179-507c-a30c-38209587333b" :knowledge-point/title "Identifying a Three-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af393b5-0b0a-51ee-963e-9232b624b8d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y,z)=-i" :db/id #edb/ref 17592186253755} {:answer/id #uuid "4ebe45a6-6f14-5783-a2c5-0fff74a623ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y,z)={e}^{x}\\,i" :db/id #edb/ref 17592186254352} {:answer/id #uuid "5a235ec0-b137-57da-bcd7-fa7e7f95a670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y,z)=i+j+k" :db/id #edb/ref 17592186254460} {:answer/id #uuid "6c27c496-3691-52cb-89b6-a510f5ec6427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y,z)=i" :db/id #edb/ref 17592186254631} {:answer/id #uuid "99ad8cef-0db5-5109-bbb4-eb38f07c8dc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186255028}] :answer-field/correct {:answer/id #uuid "6c27c496-3691-52cb-89b6-a510f5ec6427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y,z)=i" :db/id #edb/ref 17592186254631} :answer-field/id #uuid "1226930a-6b24-57fb-a5e7-1829039d9728" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255946}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "505eb075-afb5-5225-b846-447773bcc89d" :question/math-academy-id "q-122559" :question/problem "![](images/cf/cfc15b6202167211b7d6c0e8f6635dd9e571810d5296a209a4c317350604c4a4.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- Each vector in our vector field is parallel to the $x$-axis. So, the $j$ and $k$ components of our vector field are zero everywhere. Therefore, we can rule out the following option:\n\n$$\nH(x,y,z)=i+j+k,\\,\n$$\n\n- Moreover, each vector in our vector field is pointing in the *positive* $x$-direction, so the $i$ component of our vector field is positive. Therefore, we can rule out the following option:\n\n$$\nG(x,y,z)=-i\n$$\n\n- Finally, we note that each vector in our vector field has the same length, so the $i$ component of our vector field is constant. Therefore, we can rule out the following option:\n\n$$\nK(x,y,z)={e}^{x}\\,i\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $F(x,y,z)=i.$"}] [{:db/id #edb/ref 17592186256681 :knowledge-point/_questions [{:db/id #edb/ref 17592186172084 :knowledge-point/id #uuid "a9734fc0-9789-5a9c-8ae0-806f87052875" :knowledge-point/title "Identifying a Two-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ba98b8c-2116-50e2-b2de-6aae7dbae22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y)=-i-2\\,j" :db/id #edb/ref 17592186254058} {:answer/id #uuid "735ac856-ee4b-5c8a-9daf-474103fa33a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y)=x\\,j" :db/id #edb/ref 17592186254692} {:answer/id #uuid "a2214b75-4ff9-5986-b2e2-09f3f7eea2eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186255100} {:answer/id #uuid "e51e621f-adf6-56d4-ba3a-23552d243dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y)=5\\,j" :db/id #edb/ref 17592186255694} {:answer/id #uuid "fce86be7-59a1-5b1f-98d2-ae97d81427f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y)=i+j" :db/id #edb/ref 17592186255891}] :answer-field/correct {:answer/id #uuid "735ac856-ee4b-5c8a-9daf-474103fa33a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y)=x\\,j" :db/id #edb/ref 17592186254692} :answer-field/id #uuid "9a1d0012-9007-5d62-a389-7be8930ea3d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5e48f80-38d5-59fb-be5e-a4668cd85716" :question/math-academy-id "q-122632" :question/problem "![](images/a0/a032eb49f78ce7bd54de6969f030e4316f2bd3028280f73991af3fe45521733c.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- The horizontal component (i.e., the $i$ component) is zero for *every* vector in our vector field. Therefore, we can rule out the following options:\n\n$$\nF(x,y)=i+j,\\,K(x,y)=-i-2\\,j\n$$\n\n- As we move away from the origin in the horizontal direction, our vectors' vertical components (i.e., the $j$ components) get longer. Therefore, we can rule out the following option:\n\n$$\nG(x,y)=5\\,j\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $H(x,y)=x\\,j.$"}] [{:db/id #edb/ref 17592186256690 :knowledge-point/_questions [{:db/id #edb/ref 17592186172088 :knowledge-point/id #uuid "888aa30d-7179-507c-a30c-38209587333b" :knowledge-point/title "Identifying a Three-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ebe2869-3764-5f84-92f2-8d83aeebec50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y,z)=-{x}^{2}\\,k" :db/id #edb/ref 17592186254211} {:answer/id #uuid "485b1122-aebc-5d63-869b-388e4298f84a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y,z)=i" :db/id #edb/ref 17592186254290} {:answer/id #uuid "6314f1d5-0c1b-5dde-b8ad-c8264c641fd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y,z)=k" :db/id #edb/ref 17592186254559} {:answer/id #uuid "6d1c6339-3852-5b78-bce2-44780bad6102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186254639} {:answer/id #uuid "d8455093-883f-5f24-818b-8beb81ac7ec8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y,z)=-j" :db/id #edb/ref 17592186255588}] :answer-field/correct {:answer/id #uuid "3ebe2869-3764-5f84-92f2-8d83aeebec50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y,z)=-{x}^{2}\\,k" :db/id #edb/ref 17592186254211} :answer-field/id #uuid "66096820-364b-5ecf-83f9-ae6fac627662" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256113}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "548bbae5-603d-5bc6-9f7d-4ca6dbc971eb" :question/math-academy-id "q-122670" :question/problem "![](images/64/64f02fa7dcd23b20e61801c0453d8fe7ed013936572e1ee63f748361edd4dec5.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- Each vector in our vector field is parallel to the $z$-axis. So, the $i$ and $j$ components of our vector field are zero everywhere. Therefore, we can rule out the following option:\n\n$$\nF(x,y,z)=i,\\,G(x,y,z)=-j\n$$\n\n- Moreover, each vector in our vector field is pointing in the *negative* $z$-direction, so the $k$ component of our vector field is negative. Therefore, we can rule out the following option:\n\n$$\nH(x,y,z)=k\n$$\n\n- Finally, we note that each vector in our vector field has the same length, so the $k$ component of our vector field is constant. Therefore, we can rule out the following option:\n\n$$\nK(x,y,z)=-{x}^{2}\\,k\n$$\n\nTherefore, we conclude that the diagram doesn't correspond to any of the listed vector fields."}] [{:db/id #edb/ref 17592186259551 :knowledge-point/_questions [{:db/id #edb/ref 17592186172088 :knowledge-point/id #uuid "888aa30d-7179-507c-a30c-38209587333b" :knowledge-point/title "Identifying a Three-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44832c8e-8988-5ee0-ac8b-67ae439d923f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186257381} {:answer/id #uuid "70a0b147-68a3-5ec0-ae90-b9c82057aad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y,z)=-2\\,i" :db/id #edb/ref 17592186257773} {:answer/id #uuid "96d0c94c-faa8-5d39-b3c3-d13382b0eced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y,z)=i" :db/id #edb/ref 17592186258114} {:answer/id #uuid "acdf99e3-cf16-5362-88ce-860873156446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y,z)=-i+j" :db/id #edb/ref 17592186258289} {:answer/id #uuid "f8d361e0-0169-5758-b933-86a6b5b677fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y,z)=-y\\,i" :db/id #edb/ref 17592186258965}] :answer-field/correct {:answer/id #uuid "70a0b147-68a3-5ec0-ae90-b9c82057aad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y,z)=-2\\,i" :db/id #edb/ref 17592186257773} :answer-field/id #uuid "861c8be9-902d-5545-831a-501704ab8be1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c63175a-a455-54b8-b784-f9c30e4507e1" :question/math-academy-id "q-123748" :question/problem "![](images/bf/bff60466ca8abba4fd849c046c02af3a4811279774975fc981cafad91d734ed5.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- Each vector in our vector field is parallel to the $x$-axis. So, the $j$ and $k$ components of our vector field are zero everywhere. Therefore, we can rule out the following option:\n\n$$\nK(x,y,z)=-i+j\n$$\n\n- Moreover, each vector in our vector field is pointing in the *negative* $x$-direction, so the $i$ component of our vector field is negative. Therefore, we can rule out the following option:\n\n$$\nF(x,y,z)=i\n$$\n\n- Finally, we note that each vector in our vector field has the same length, so the $i$ component of our vector field is constant. Therefore, we can rule out the following option:\n\n$$\nG(x,y,z)=-y\\,i\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $H(x,y,z)=-2\\,i.$"}]}
