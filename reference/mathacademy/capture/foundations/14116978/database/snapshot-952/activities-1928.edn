#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186125354} :activity/id #uuid "881d7f99-9cf9-5cc5-ac3e-817c6cfcbee4" :activity/scope {:db/id #edb/ref 17592186050008 :topic/id #uuid "25ec858d-77d3-5737-88a7-6eeadae45d1d" :topic/math-academy-id 1928} :activity/steps [{:db/id #edb/ref 17592186125354 :step/content {:db/id #edb/ref 17592186125766 :tutorial/content "Given two bases $\\color{blue}\\mathcal{B}$ and $\\color{red}\\mathcal{C}$ of a vector space $V,$ the **change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to $\\color{red}\\mathcal{C}$** is the matrix $P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}},$ whose columns are the coordinates of the vectors from $\\color{blue}\\mathcal{B}$ relative to the basis $\\color{red}\\mathcal{C}$.\n\nIn expanded form, the matrix looks as follows:\n![](images/06/062187705e6074afa6b5356be64f8deb878be540e2c3b236b22dbd244b872cc6.svg)\n\nFor example, let's consider two bases $\\mathcal B$ and $\\mathcal C$ of $\\mathbb{R}^2$ given by \n\n$$\n\\mathcal{B}=\\{\\mathbf{b}_1,\\mathbf{b}_2\\}, \\qquad\\mathcal{C}=\\{\\mathbf{c}_1,\\mathbf{c}_2\\}.\n$$\n\nIf we happen to know that\n\n![](images/32/32409a45b5ebcf6b8c1cc43404126b514066ace8d8c71bcec2e99f759833ec84.svg) \n\nthen the change-of-coordinates matrix from $\\mathcal{B}$ to $\\mathcal{C}$ is given by\n\n$$\n\\begin{aligned}{P}_{B\\to C}= & [\\begin{aligned}-12 & 3 \\\\ 11 & 6\\end{aligned}]. \\\\  & \\,{↑}_{[{b}_{1}]_{C}}\\,{↑}_{[{b}_{2}]_{C}}\\end{aligned}\n$$\n\nThe beauty of the change-of-coordinates matrix is that it allows us to express the vector $[\\mathbf x]_{\\mathcal B}$ in the basis $\\mathcal C$ via the transformation\n\n$$\n[\\mathbf x]_{\\mathcal C} = P_{\\small\\mathcal{B}\\to\\mathcal{C}} \\cdot [\\mathbf x]_{\\mathcal B}.\n$$\n\nThis can be visualized as shown below.\n\n![](images/ed/ede6eb17f0667a8974902bf2d181150eeb3c665faa3059bb818bb9a61b631511.png)" :tutorial/id #uuid "46d12d06-cf6a-5c5d-bb38-8670b3501be4" :tutorial/math-academy-id 3213 :tutorial/title "Introduction"} :step/id #uuid "c7241b03-69a5-5e64-ac19-86478024cf90" :step/math-academy-id 17526 :step/next {:db/id #edb/ref 17592186125356}} {:db/id #edb/ref 17592186125356 :step/content {:db/id #edb/ref 17592186124491 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124304 :question/id #uuid "4c1e01c1-d607-5ad8-8643-b3317201ab9d" :question/math-academy-id "e-4832"} :knowledge-point/id #uuid "595fd527-e8fd-5360-87f1-acbeab511566" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048762}] :knowledge-point/questions [{:db/id #edb/ref 17592186124895} {:db/id #edb/ref 17592186125228} {:db/id #edb/ref 17592186323799} {:db/id #edb/ref 17592186351377} {:db/id #edb/ref 17592186386640} {:db/id #edb/ref 17592186391924} {:db/id #edb/ref 17592186391931} {:db/id #edb/ref 17592186416596} {:db/id #edb/ref 17592186416602}] :knowledge-point/title "Finding the Change-of-Coordinates Matrix Given a Linear Connection Between Two Bases"} :step/id #uuid "bd858f5c-ef37-5df3-babd-34538f6f381c" :step/math-academy-id 17528 :step/next {:db/id #edb/ref 17592186125357}} {:db/id #edb/ref 17592186125357 :step/content {:db/id #edb/ref 17592186124492 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124305 :question/id #uuid "93b466b2-9b8d-55fa-87b8-b5bf24a497cf" :question/math-academy-id "e-4833"} :knowledge-point/id #uuid "6b973d79-8fe4-5033-8202-9693004855dc" :knowledge-point/questions [{:db/id #edb/ref 17592186124975} {:db/id #edb/ref 17592186124981} {:db/id #edb/ref 17592186247325} {:db/id #edb/ref 17592186377844} {:db/id #edb/ref 17592186391991} {:db/id #edb/ref 17592186394291} {:db/id #edb/ref 17592186394298} {:db/id #edb/ref 17592186416599} {:db/id #edb/ref 17592186416601} {:db/id #edb/ref 17592186416603}] :knowledge-point/title "Finding the Change-of-Coordinates Matrix When One of the Bases is the Standard Basis"} :step/id #uuid "80c4bbb9-f58d-5db9-9875-a6de44dddc60" :step/math-academy-id 17530 :step/next {:db/id #edb/ref 17592186125358}} {:db/id #edb/ref 17592186125358 :step/content {:db/id #edb/ref 17592186125767 :tutorial/content "Since the columns of a change-of-coordinates matrix are linearly independent, the matrix must be invertible.\n\nIn fact, the change-of-coordinates matrix from $\\color{blue}\\mathcal{B}$ to $\\color{red}\\mathcal{C}$ and the change-of-coordinates matrix from $\\color{red}\\mathcal{C}$ to $\\color{blue}\\mathcal{B}$ are the inverses of each other:\n\n$$\nP_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}^{-1} = P_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}}\n\t\\qquad\\textrm{and}\\qquad\n\tP_{\\small{\\color{red}\\mathcal{C}}\\to{\\color{blue}\\mathcal{B}}}^{-1} = P_{\\small{\\color{blue}\\mathcal{B}}\\to{\\color{red}\\mathcal{C}}}.\n$$" :tutorial/id #uuid "f2fa55fd-270b-5d4e-89e4-ec0fe2c4e0c0" :tutorial/math-academy-id 3215 :tutorial/title "The Inverse of a Change-of-Coordinates Matrix"} :step/id #uuid "e23604b2-7d9d-5701-83b0-ef4dd1b95b45" :step/math-academy-id 17531 :step/next {:db/id #edb/ref 17592186125359}} {:db/id #edb/ref 17592186125359 :step/content {:db/id #edb/ref 17592186124493 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124306 :question/id #uuid "6c5b5534-2082-593e-af07-df83497ea84c" :question/math-academy-id "e-4835"} :knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049548}] :knowledge-point/questions [{:db/id #edb/ref 17592186124914} {:db/id #edb/ref 17592186124915} {:db/id #edb/ref 17592186247348} {:db/id #edb/ref 17592186247349} {:db/id #edb/ref 17592186351380} {:db/id #edb/ref 17592186351381} {:db/id #edb/ref 17592186375741} {:db/id #edb/ref 17592186386675} {:db/id #edb/ref 17592186394305} {:db/id #edb/ref 17592186394312} {:db/id #edb/ref 17592186416600} {:db/id #edb/ref 17592186416605} {:db/id #edb/ref 17592186416606}] :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"} :step/id #uuid "f4b1b6b1-2c84-53dc-b2e9-6ae8617800c7" :step/math-academy-id 17533 :step/next {:db/id #edb/ref 17592186125501}} {:db/id #edb/ref 17592186125360 :step/content {:db/id #edb/ref 17592186124494 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124307 :question/id #uuid "0929855b-0310-5c87-8cff-cc2faa8a5ae0" :question/math-academy-id "e-4837"} :knowledge-point/id #uuid "f989cbaf-2d99-5267-8864-48a48db2d535" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048920}] :knowledge-point/questions [{:db/id #edb/ref 17592186124916} {:db/id #edb/ref 17592186124974} {:db/id #edb/ref 17592186247359} {:db/id #edb/ref 17592186247362} {:db/id #edb/ref 17592186247363} {:db/id #edb/ref 17592186323709} {:db/id #edb/ref 17592186377851} {:db/id #edb/ref 17592186386689} {:db/id #edb/ref 17592186391984} {:db/id #edb/ref 17592186416597} {:db/id #edb/ref 17592186416598} {:db/id #edb/ref 17592186416604}] :knowledge-point/title "Finding the Change-of-Coordinates Matrix Between Two Bases"} :step/id #uuid "a7664106-d8c0-540f-9ff4-1553bdb9d7a4" :step/math-academy-id 17535} {:db/id #edb/ref 17592186125501 :step/content {:db/id #edb/ref 17592186125823 :tutorial/content "Suppose that we have bases $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}$ and $\\mathcal{C}=\\{ \\mathbf{c}_1,\\mathbf{c}_2 \\},$ and we want to find the change-of-coordinates matrix from $\\mathcal{B}$ to $\\mathcal{C},$ denoted $P_{\\small\\mathcal{B}\\to\\mathcal{C}}.$\n\nRecall that the columns of $P_{\\small\\mathcal{B}\\to\\mathcal{C}}$ are the coordinates of the vectors of $\\mathcal{B}$ relative to the basis $\\mathcal{C},$ that is\n![](images/fb/fb63e6dcb2c7b0f8417e4f3fd394d42fa4bb84017552779903c40e4114639ac6.svg)\n\nTo compute $P_{\\small{\\color{black}\\mathcal{B}}\\to{\\color{black}\\mathcal{C}}},$ we need to find the coordinates of $\\mathbf{b}_1$ and $\\mathbf{b}_2$ relative to the basis $\\mathcal{C}.$ We can do this simultaneously by considering the matrix\n![](images/64/644f78998195b8be26cb21bf5d680fbebed808d8f412769f9a3b06901533e87d.svg)\n\nIf we reduce the left-hand side of $M$ to reduced row-echelon form using Gaussian elimination, $P_{\\small\\mathcal{B}\\to\\mathcal{C}}$ will emerge on the right-hand side:\n\n![](images/52/52f73b32e9700813960a9c544b71fedcce865ed3c452094be36615459663be9d.svg)" :tutorial/id #uuid "a6e71bf0-0662-5ac2-abc9-4edf7b085968" :tutorial/math-academy-id 4439 :tutorial/title "Computing the Change-of-Coordinates Matrix Using Row-Reduction"} :step/id #uuid "49ef4ed6-562f-5c33-91e3-3f02216c2e4f" :step/math-academy-id 27297 :step/next {:db/id #edb/ref 17592186125360}}] :activity/title "The Change-of-Coordinates Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124721}]}
