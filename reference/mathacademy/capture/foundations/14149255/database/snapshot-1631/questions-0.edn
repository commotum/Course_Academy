#{[{:db/id #edb/ref 17592186290277 :knowledge-point/_questions [{:db/id #edb/ref 17592186100817 :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249cc9e7-cb4d-52ad-9e9e-e84024942ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡{x}^{2}|+C" :db/id #edb/ref 17592186288268} {:answer/id #uuid "5da3752e-4993-5ec0-877d-0a3fd775b84c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288687} {:answer/id #uuid "63651b20-ed95-5e55-8f68-81a466cc5ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288726} {:answer/id #uuid "926da738-6ea6-53a7-b613-8359f66a864b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2+\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289015} {:answer/id #uuid "e33f2640-c785-5dc0-acda-5e6494b2de0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{ln}^{2}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289542}] :answer-field/correct {:answer/id #uuid "5da3752e-4993-5ec0-877d-0a3fd775b84c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288687} :answer-field/id #uuid "30b841af-b6a0-5f34-a593-ca46481cf7b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289838}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "07ddd93b-2266-558f-9ab3-369202ae0194" :question/math-academy-id "q-210752" :question/problem "$\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115850 :knowledge-point/_questions [{:db/id #edb/ref 17592186115250 :knowledge-point/id #uuid "8a4b135f-df0d-5443-bb93-796f32c380c6" :knowledge-point/title "Identifying the Inverse of a 2x2 Matrix Calculated Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27195729-1b10-59a4-9a7d-c8f3fb5b730d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417362} {:answer/id #uuid "30ffe217-9ca4-5886-8537-db99704507c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186417363} {:answer/id #uuid "482e772e-15aa-5a49-ba61-a3210d49dce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}\\frac{1}{2} & 0 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186417367} {:answer/id #uuid "693517ab-7974-5643-b63c-0b1e93f9bf86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186417369} {:answer/id #uuid "f90d54bb-bb78-5ccd-89f4-75dfe86ac00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}\\frac{1}{2} & 0 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186417374}] :answer-field/correct {:answer/id #uuid "482e772e-15aa-5a49-ba61-a3210d49dce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{-1}=[\\begin{aligned}\\frac{1}{2} & 0 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186417367} :answer-field/id #uuid "c76094cd-e064-540b-baa0-d39b44e34908" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc5586f3-545c-5b09-9d7f-103310c35e8b" :question/math-academy-id "q-42989" :question/problem "The inverse of the $2\\times 2$ matrix $A$ is found using row operations, as shown below. Complete the process, and determine ${A}^{-1}.$\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}2 & 0 & 1 & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}2 & 0 & 1 & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & 0 \\\\ 4 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & 0 \\\\ 0 & 1 & -2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}\\frac{1}{2} & 0 \\\\ -2 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186129839 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb1638ba-1d0a-5da1-b7e4-2f08f45f829e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e3/e3e87ba472c52ffd7f6df89f4ad9886e25a3d64cd076d90a085adb38ce6c1508.png" :db/id #edb/ref 17592186128516} {:answer/id #uuid "310b1f99-2ddc-5ff7-abaa-c6dcc52e7c0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28302f0f3d075a9a0b698613b479cf777c00ece0be6766de79c5ced5e01ff63d.png" :db/id #edb/ref 17592186128517} {:answer/id #uuid "31a38edb-3150-59ed-b9a2-5ca4530919a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186128518} {:answer/id #uuid "38a2fee1-773a-5688-8132-96509ebe923c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c8b602894c58ee03f2e0cc3be9155d177da9915f537482671609de075a6bc80.png" :db/id #edb/ref 17592186128519} {:answer/id #uuid "40974dcc-78f6-5b35-bca7-a00d9c372e85" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73fce52068582bba934a9db9b3ccd130b7022a752eb3e753aa7b1a1eb1eab40f.png" :db/id #edb/ref 17592186128520}] :answer-field/correct {:answer/id #uuid "310b1f99-2ddc-5ff7-abaa-c6dcc52e7c0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28302f0f3d075a9a0b698613b479cf777c00ece0be6766de79c5ced5e01ff63d.png" :db/id #edb/ref 17592186128517} :answer-field/id #uuid "73f20238-5852-5de2-b7d7-1ef3dacb6c32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5eea10eb-d5b3-52da-8f82-0b23089e27dc" :question/math-academy-id "q-71823" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD=\\{(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)\\},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/3f/3fccfbd6fd95005958fc9c9c14a1d327c27ef21351b1a32f3a5da553fdbf1539.png)"}] [{:db/id #edb/ref 17592186377695 :knowledge-point/_questions [{:db/id #edb/ref 17592186124453 :knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42" :knowledge-point/title "Calculating Limits of Multivariable Rational Functions by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d118fc5-1c52-5566-be98-a9707e774937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377697} {:answer/id #uuid "30aa323e-111a-55db-ae16-f96b2c70da3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186377698} {:answer/id #uuid "563f0bf5-f3be-54dc-b44e-fce9a03892d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377699} {:answer/id #uuid "a81b9d36-0a30-5151-bf36-ec51a5b12490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377700} {:answer/id #uuid "f84b3786-3b86-57a7-acce-0bc703bbfb0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186377701}] :answer-field/correct {:answer/id #uuid "563f0bf5-f3be-54dc-b44e-fce9a03892d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377699} :answer-field/id #uuid "117ca5de-bfde-5504-8e9b-162dc1ee9296" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d22711b-d1d6-5f06-ab4a-74275f71d77c" :question/math-academy-id "q-74920" :question/problem "Find  ${lim}_{x\\to (1,-3)}\\frac{xy-y}{x-1}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,-3)}\\frac{xy-y}{x-1}=\\frac{1\\cdot (-3)-(-3)}{1-1}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,-3)}\\frac{xy-y}{x-1} & ={lim}_{x\\to (1,-3)}\\frac{(x-1)y}{x-1} \\\\  & ={lim}_{x\\to (1,-3)}y\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,-3)}y & =-3\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-3.$"}] [{:db/id #edb/ref 17592186354557 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1388b042-f6a5-5728-9122-9ffa17a12761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186351737} {:answer/id #uuid "270dbcf7-cdc2-513f-ab8b-6e3e4820b640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186351922} {:answer/id #uuid "7d1ba640-d224-560e-a507-31e31167512d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186352665} {:answer/id #uuid "cde4b7ff-d7f7-5bb3-83c1-196e63bd4eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186353354} {:answer/id #uuid "fbc3532b-a4cf-5703-bd69-c1f96685710c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186353771}] :answer-field/correct {:answer/id #uuid "7d1ba640-d224-560e-a507-31e31167512d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186352665} :answer-field/id #uuid "2bd51fe8-4963-559a-9cc8-296b567fd612" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353888}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c5dab49-c074-55ae-82a5-34331ee5b508" :question/math-academy-id "q-87236" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{k}{{x}^{3}},\\, & 3<x<6, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{3}^{6}\\frac{k}{{x}^{3}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{6}\\frac{k}{{x}^{3}}\\,\\text{d}x & ={\\int }_{3}^{6}k{x}^{-3}\\,\\text{d}x \\\\  & ={[-\\frac{k}{2{x}^{2}}]}_{3}^{6} \\\\  & =-\\frac{k}{72}+\\frac{k}{18} \\\\  & =\\frac{k}{24}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{k}{24}=1\\,⟹\\,k=24.\n$$"}]}
