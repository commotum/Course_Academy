f-ab08179fc26f" #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125401 #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125402 #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125403 #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125448 #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125490 #edb/ref 17592186045417] [17592186124748 #edb/ref 1043 #edb/ref 17592186125497 #edb/ref 17592186045417] [17592186124748 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124748 #edb/ref 1045 "The Image and Rank of a Linear Transformation" #edb/ref 17592186045417] [17592186124748 #edb/ref 1046 #edb/ref 17592186125401 #edb/ref 17592186045417] [17592186124748 #edb/ref 1049 #edb/ref 17592186049539 #edb/ref 17592186045417] [17592186124748 #edb/ref 1050 960.0 #edb/ref 17592186045417] [17592186124748 #edb/ref 1053 #uuid "91d90bfa-8f19-5546-aba3-f391b0f30b02" #edb/ref 17592186045417] [17592186125115 #edb/ref 1068 #edb/ref 17592186323356 #edb/ref 17592186045417] [17592186125115 #edb/ref 1069 "q-38001" #edb/ref 17592186045417] [17592186125115 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186125115 #edb/ref 1071 "The standard matrix $T$ of a linear transformation $T$ and the vector $b\\in {R}^{3}$ are given below. Determine if there exists a vector $x\\in {R}^{3}$ such that $T(x)=b.$\nIn the affirmative case, find the value of ${x}_{1}+{x}_{2},$ where ${x}_{1},{x}_{2},{x}_{3}$ are the components of $x.$  \n\n$$\nT=[\\begin{aligned}-2 & -5 & 3 \\\\ 4 & -1 & 5 \\\\ 0 & 3 & -3\\end{aligned}],\\,b=[\\begin{aligned}9 \\\\ -7 \\\\ -3\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186125115 #edb/ref 1072 #uuid "bed1a457-fd38-5a3f-94a3-0c655ad8bedf" #edb/ref 17592186045417] [17592186125115 #edb/ref 1074 "Since $T$ is the standard matix of $T,$ we have $\\text{Im}(T)=\\text{Col}(T).$ In order to determine whether $b$ lies in $\\text{Im}(T),$ we need to check if the equation $Tx=b$ is consistent. \n\nSo, we find the row echelon form of the augmented matrix $[T\\,|\\,b],$ as follows: \n\n$$\n\\begin{aligned}[T\\,|\\,b] & =[\\begin{aligned}-2 & -5 & 3 & 9 \\\\ 4 & -1 & 5 & -7 \\\\ 0 & 3 & -3 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-2 & -5 & 3 & 9 \\\\ 0 & -11 & 11 & 11 \\\\ 0 & 3 & -3 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+\\frac{3}{11}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-2 & -5 & 3 & 9 \\\\ 0 & -11 & 11 & 11 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has two pivot columns (the $1$st and the $2$nd). Hence, ${x}_{3}$ is a free variable. \nNow, from the second equation, we get \n\n$$\n-11{x}_{2}+11{x}_{3}=11\\,⟹\\,{x}_{2}=-1+{x}_{3}.\n$$\n\nSubstituting this into the first equation gives \n\n$$\n-2{x}_{1}-5(-1+{x}_{3})+3{x}_{3}=9\\,⟹\\,{x}_{1}=-2-{x}_{3}.\n$$\n\nAs a result, the general solution is given by \n\n$$\n[\\begin{aligned}-2-{x}_{3} \\\\ -1+{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=0,$ we have\n\n$$\nx=[\\begin{aligned}-2 \\\\ -1 \\\\ 0\\end{aligned}],\n$$\n\nwhere $T(x)=b.$\n\nFinally, ${x}_{1}+{x}_{2}=-2-1=-3.$" #edb/ref 17592186045417] [17592186125116 #edb/ref 1068 #edb/ref 17592186123296 #edb/ref 17592186045417] [17592186125116 #edb/ref 1069 "q-38005" #edb/ref 17592186045417] [17592186125116 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186125116 #edb/ref 1071 "If $T=[\\begin{aligned}2 & -1 & 1 \\\\ -4 & 2 & -2 \\\\ 6 & -3 & 3\\end{aligned}]$ is the standard matrix of the linear transformation $T$, then $\\text{rank}(T)=$" #edb/ref 17592186045417] [17592186125116 #edb/ref 1072 #uuid "994a2790-60b0-54d4-bc90-ddef3472f156" #edb/ref 17592186045417] [17592186125116 #edb/ref 1074 "Recall that $\\text{rank}(T)=\\text{dim}(\\text{Im}(T))=\\text{rank}(T).$ \n\nSo, we need to find the rank of the matrix $T.$ We reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & -1 & 1 \\\\ -4 & 2 & -2 \\\\ 6 & -3 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & -1 & 1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, since $T$ has $1$ pivot column, we have that \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1.\n$$" #edb/ref 17592186045417] [17592186125401 #edb/ref 1058 #edb/ref 17592186125448 #edb/ref 17592186045417] [17592186125401 #edb/ref 1061 20015 #edb/ref 17592186045417] [17592186125401 #edb/ref 1062 #uuid "f42af34b-8f66-5aee-9bd5-7a3de03f5cdf" #edb/ref 17592186045417] [17592186125401 #edb/ref 1063 #edb/ref 17592186125783 #edb/ref 17592186045417] [17592186125402 #edb/ref 1058 #edb/ref 17592186125497 #edb/ref 17592186045417] [17592186125402 #edb/ref 1061 20016 #edb/ref 17592186045417] [17592186125402 #edb/ref 1062 #uuid "ddfd46cc-2853-59ef-ace0-92fabfa7af70" #edb/ref 17592186045417] [17592186125402 #edb/ref 1063 #edb/ref 17592186124519 #edb/ref 17592186045417] [17592186125403 #edb/ref 1061 20017 #edb/ref 17592186045417] [17592186125403 #edb/ref 1062 #uuid "eb409d13-a534-5413-97fd-7e71ad7fbfad" #edb/ref 17592186045417] [17592186125403 #edb/ref 1063 #edb/ref 17592186124520 #edb/ref 17592186045417] [17592186125448 #edb/ref 1058 #edb/ref 17592186125490 #edb/ref 17592186045417] [17592186125448 #edb/ref 1061 20424 #edb/ref 17592186045417] [17592186125448 #edb/ref 1062 #uuid "905da979-387e-5ded-9c78-3ede6dac59ca" #edb/ref 17592186045417] [17592186125448 #edb/ref 1063 #edb/ref 17592186124547 #edb/ref 17592186045417] [17592186125490 #edb/ref 1058 #edb/ref 17592186125402 #edb/ref 17592186045417] [17592186125490 #edb/ref 1061 25971 #edb/ref 17592186045417] [17592186125490 #edb/ref 1062 #uuid "cb766bed-08ee-564c-a45c-c20f57e59be3" #edb/ref 17592186045417] [17592186125490 #edb/ref 1063 #edb/ref 17592186125819 #edb/ref 17592186045417] [17592186125497 #edb/ref 1058 #edb/ref 17592186125403 #edb/ref 17592186045417] [17592186125497 #edb/ref 1061 26848 #edb/ref 17592186045417] [17592186125497 #edb/ref 1062 #uuid "9f45ab6b-4ad9-5e42-8a3f-69ef72e1a03c" #edb/ref 17592186045417] [17592186125497 #edb/ref 1063 #edb/ref 17592186125821 #edb/ref 17592186045417] [17592186125783 #edb/ref 1064 "The **image** (or **range**) of a linear transformation $\\mathbf{T}$ is the set of all vectors $\\mathbf{b}$ that the transformation maps to. That is to say\n![](images/4c/4c89132f0fd9713f0e688f7cf00189bf4d3f27baddad032c74edf7b0a8c0d8ee.svg)\n\nThe diagram below gives a schematic representation of the image of a linear transformation $\\mathbf{T}: V \\rightarrow V$ for a vector space $V.$\n\n![](images/b8/b859250756eb3870f9c1d4d7e6e78f044adf2b0c4cd94a87d01011879d668afc.png)\n\nNotice that $\\mathbf{0}$ is always in the image of a linear transformation since $\\mathbf{T}(\\mathbf{0})=\\mathbf{0}.$\n\nAs an example, let's consider the linear transformation\n![](images/61/618376922e3c837dba3f742fd77340c2a3deee6cee099843232f85bcec5faf93.svg)\n\nNotice that, for example, the vector $\\mathbf b = [6,9]^T$ is in the image of the transformation $\\mathbf{S}$ since there is another vector $\\mathbf{u} = [1,1]^T$ such that $\\mathbf{S}(\\mathbf{u})=\\mathbf{b}{:}$\n\n![](images/51/51004801582ad1a6cddc389e07a4ac8d486c410ebacf264de14ac1a798a10c30.svg)" #edb/ref 17592186045417] [17592186125783 #edb/ref 1065 3530 #edb/ref 17592186045417] [17592186125783 #edb/ref 1066 #uuid "70bccafd-705b-5026-bdf8-ef7731dfcc77" #edb/ref 17592186045417] [17592186125783 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125819 #edb/ref 1064 "In general, the image of a linear transformation $\\mathbf{T}$ is equivalent to the column space of its standard matrix $T.$ That is,\n![](images/6e/6e8b0992ade86b8e8a0c7d2227ff5473f5cae843f8e763e556c17654e7f1f143.svg)\n\nSo to find out if a vector $\\mathbf{b}$ is in the image of the linear transformation $\\mathbf{T},$ we just need to check if the matrix equation $T\\mathbf{x}=\\mathbf{b}$ is consistent." #edb/ref 17592186045417] [17592186125819 #edb/ref 1065 4276 #edb/ref 17592186045417] [17592186125819 #edb/ref 1066 #uuid "f52415b1-727f-53a7-8502-857fdcb3b835" #edb/ref 17592186045417] [17592186125819 #edb/ref 1067 "Determining If a Vector Lies in the Image" #edb/ref 17592186045417] [17592186125821 #edb/ref 1064 "In general, the rank of a linear transformation $\\mathbf{T}$ is equal to the dimension of its image:\n\n$$\n\\text{rank}(\\mathbf{T}) = \\text{dim}(\\text{Im}(\\mathbf{T}))\n$$\n\nIf the linear transformation $\\mathbf{T}$ has the standard matrix $T,$ then the dimension of the image is equal to the rank of $T{:}$\n\n$$\n\\text{dim}(\\text{Im}(\\mathbf{T})) = \\text{rank}(T)\n$$\n\nSo, in general, we have\n\n$$\n\\text{rank}(\\mathbf{T}) = \\text{rank}(T).\n$$" #edb/ref 17592186045417] [17592186125821 #edb/ref 1065 4382 #edb/ref 17592186045417] [17592186125821 #edb/ref 1066 #uuid "89b10851-3eed-5f36-a0ab-c9d0610e9b75" #edb/ref 17592186045417] [17592186125821 #edb/ref 1067 "The Rank of a Linear Transformation" #edb/ref 17592186045417] [17592186321375 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186321375 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321375 #edb/ref 1083 #uuid "1dfb93ac-6115-54ec-b40b-3b469b909b96" #edb/ref 17592186045417] [17592186321472 #edb/ref 1080 "b\\notin \\text{Im}(T)" #edb/ref 17592186045417] [17592186321472 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321472 #edb/ref 1083 #uuid "2a46af78-157d-5308-b26d-327443fe498e" #edb/ref 17592186045417] [17592186321825 #edb/ref 1080 "\\frac{2}{3}" #edb/ref 17592186045417] [17592186321825 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186321825 #edb/ref 1083 #uuid "55911fc0-26aa-5938-a1d7-93d966b3956b" #edb/ref 17592186045417] [17592186322480 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186322480 #edb/ref 1082 #ed