    "q-37282": {
      "dom_id": "step-q37282",
      "name": "Question 3",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{cos}⁡(xy)-2{z}^{2}y.$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =[-y\\operatorname{sin}⁡(xy)]\\,\\text{d}x+[-2{z}^{2}-x\\operatorname{sin}⁡(xy)]\\,\\text{d}y+[-4yz]\\,\\text{d}z \\\\  & =-y\\operatorname{sin}⁡(xy)\\,\\text{d}x-(2{z}^{2}+x\\operatorname{sin}⁡(xy))\\,\\text{d}y-4yz\\,\\text{d}z\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-37282-a",
