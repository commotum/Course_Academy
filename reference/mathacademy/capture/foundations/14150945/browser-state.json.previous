    "q-167152": {
      "dom_id": "step-q167152",
      "name": "Question 4",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y,z)={x}^{2}y+{y}^{3}z-x{z}^{2}.$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =(2xy-{z}^{2})\\,\\text{d}x+({x}^{2}+3{y}^{2}z)\\,\\text{d}y+({y}^{3}-2xz)\\,\\text{d}z\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-167152-a",
