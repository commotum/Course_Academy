    "q-79740": {
      "dom_id": "step-q79740",
      "name": "Question 5",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y)=4{y}^{3}\\operatorname{ln}⁡x.$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-79740-a",
