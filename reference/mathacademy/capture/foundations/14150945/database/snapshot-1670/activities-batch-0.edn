#{[{:activity/first-step {:db/id #edb/ref 17592186125479} :activity/id #uuid "9e51b578-3c1e-53f2-bd6c-584e173a601f" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186125477 :step/content {:db/id #edb/ref 17592186124565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124374 :question/id #uuid "8ebce398-b228-51b0-8506-e0c6124478a5" :question/math-academy-id "e-6852"} :knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707}] :knowledge-point/questions [{:db/id #edb/ref 17592186125052} {:db/id #edb/ref 17592186125056} {:db/id #edb/ref 17592186284575} {:db/id #edb/ref 17592186348265} {:db/id #edb/ref 17592186348266} {:db/id #edb/ref 17592186348267} {:db/id #edb/ref 17592186348268} {:db/id #edb/ref 17592186348269} {:db/id #edb/ref 17592186393982}] :knowledge-point/title "Computing the Differential of a Multivariable Function"} :step/id #uuid "bf1f5b6c-b40c-5ff9-9ed6-50ee5d23ff70" :step/math-academy-id 25383 :step/next {:db/id #edb/ref 17592186125478}} {:db/id #edb/ref 17592186125478 :step/content {:db/id #edb/ref 17592186124566 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124375 :question/id #uuid "bb3ab0dc-7e26-58f5-a0c2-564c01c77f2e" :question/math-academy-id "e-6854"} :knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/questions [{:db/id #edb/ref 17592186125053} {:db/id #edb/ref 17592186125057} {:db/id #edb/ref 17592186284605} {:db/id #edb/ref 17592186348270} {:db/id #edb/ref 17592186348271} {:db/id #edb/ref 17592186348321} {:db/id #edb/ref 17592186372349} {:db/id #edb/ref 17592186375377} {:db/id #edb/ref 17592186375384} {:db/id #edb/ref 17592186393968}] :knowledge-point/title "Computing a Differential in a Geometrical Context"} :step/id #uuid "34d39ab5-5a0c-5548-9b37-4b9ff25664cc" :step/math-academy-id 25385 :step/next {:db/id #edb/ref 17592186125480}} {:db/id #edb/ref 17592186125479 :step/content {:db/id #edb/ref 17592186125813 :tutorial/content "The **differential** of a multivariable function $f(x,y)$ is denoted $\\textrm df(x,y)$ and represents the infinitesimal change in the function value that occurs when the inputs $x$ and $y$ are changed by infinitesimal amounts $\\textrm dx$ and $\\textrm dy.$\n\nThe formula for the differential comes from the multivariable chain rule, which can be expressed as\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y.\\end{aligned}\n$$\n\nNote that the differential can be extended to any number of variables. For example, for a three-variable function $f(x,y,z),$ we have\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z.\\end{aligned}\n$$" :tutorial/id #uuid "549aa462-1d86-5880-b6e2-2f6b1d79b41d" :tutorial/math-academy-id 4191 :tutorial/title "Introduction"} :step/id #uuid "ca5fbd6f-0bec-58b1-a606-32a0d7df8952" :step/math-academy-id 25416 :step/next {:db/id #edb/ref 17592186125477}} {:db/id #edb/ref 17592186125480 :step/content {:db/id #edb/ref 17592186125814 :tutorial/content "Given a multivariable function $f(x,y),$ the differential\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y\\end{aligned}\n$$\n\ntells us how infinitesimal changes in $x$ and $y,$ denoted $\\textrm dx$ and $\\textrm dy,$ result in an infinitesimal change in $f,$ denoted $\\textrm df.$\n\nConsequently, we can use the differential to *approximate* the change in $f$ as we move from one point to another. If we move from a point $(x,y)$ to a point $(x + \\Delta x, y + \\Delta y),$ then the approximate change in $f$ is given by\n\n$$\n\\begin{aligned}Δf(x,y) & \\approx (\\frac{∂f}{∂x})\\,Δx+(\\frac{∂f}{∂y})\\,Δy.\\end{aligned}\n$$\n\nThe above formula is very similar to the differential formula, except the $\\textrm d$'s are replaced with $\\Delta$'s. The $\\textrm d$'s refer to infinitesimal changes, while the $\\Delta$'s refer to changes that can actually be measured." :tutorial/id #uuid "c2d5565a-cb57-537b-bd6e-64ebd0b91783" :tutorial/math-academy-id 4214 :tutorial/title "Approximating Change Using Differentials"} :step/id #uuid "98241263-1948-5c19-9eb8-bdad86fba771" :step/math-academy-id 25515 :step/next {:db/id #edb/ref 17592186125481}} {:db/id #edb/ref 17592186125481 :step/content {:db/id #edb/ref 17592186124567 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124376 :question/id #uuid "0c4816ed-fba0-5dc7-94ba-646b875d653d" :question/math-academy-id "e-6875"} :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/questions [{:db/id #edb/ref 17592186125055} {:db/id #edb/ref 17592186125226} {:db/id #edb/ref 17592186284577} {:db/id #edb/ref 17592186284578} {:db/id #edb/ref 17592186348287} {:db/id #edb/ref 17592186348289} {:db/id #edb/ref 17592186348290} {:db/id #edb/ref 17592186348291} {:db/id #edb/ref 17592186348292} {:db/id #edb/ref 17592186348293} {:db/id #edb/ref 17592186354501} {:db/id #edb/ref 17592186354502}] :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"} :step/id #uuid "382f7b0c-adae-5236-b08b-ef5b7008f906" :step/math-academy-id 25516 :step/next {:db/id #edb/ref 17592186125482}} {:db/id #edb/ref 17592186125482 :step/content {:db/id #edb/ref 17592186124568 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124377 :question/id #uuid "febc72d4-b1b8-52c9-a805-013b30695077" :question/math-academy-id "e-6876"} :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/questions [{:db/id #edb/ref 17592186125051} {:db/id #edb/ref 17592186125227} {:db/id #edb/ref 17592186284580} {:db/id #edb/ref 17592186284581} {:db/id #edb/ref 17592186348300} {:db/id #edb/ref 17592186348301} {:db/id #edb/ref 17592186348302} {:db/id #edb/ref 17592186348303} {:db/id #edb/ref 17592186348304} {:db/id #edb/ref 17592186348306} {:db/id #edb/ref 17592186354503} {:db/id #edb/ref 17592186373237}] :knowledge-point/title "Using Differentials to Approximate the Value of a Function"} :step/id #uuid "896f3d03-adff-53cf-be59-7b4310e8b280" :step/math-academy-id 25517}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124739}]}
