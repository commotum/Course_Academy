text{d}z" :db/id #edb/ref 17592186392069}] :answer-field/correct {:answer/id #uuid "aae002db-fce7-56b0-8e0b-e5c176407dde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-y\\operatorname{sin}⁡(xy)\\,\\text{d}x-(2{z}^{2}+x\\operatorname{sin}⁡(xy))\\,\\text{d}y-4yz\\,\\text{d}z" :db/id #edb/ref 17592186392067} :answer-field/id #uuid "411881c8-1922-500f-a541-940ee58225d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "914e7517-17c3-54d3-96ce-3e196608d406" :question/math-academy-id "q-37282" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{cos}⁡(xy)-2{z}^{2}y.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =[-y\\operatorname{sin}⁡(xy)]\\,\\text{d}x+[-2{z}^{2}-x\\operatorname{sin}⁡(xy)]\\,\\text{d}y+[-4yz]\\,\\text{d}z \\\\  & =-y\\operatorname{sin}⁡(xy)\\,\\text{d}x-(2{z}^{2}+x\\operatorname{sin}⁡(xy))\\,\\text{d}y-4yz\\,\\text{d}z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125055 :knowledge-point/_questions [{:db/id #edb/ref 17592186124567 :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81763c7d-e9ed-5589-9527-e4f237b7320d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf \\approx 0.1" :db/id #edb/ref 17592186122931} {:answer/id #uuid "9f8999ef-680a-545e-ac09-71dfcdd3b63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf \\approx 0.3" :db/id #edb/ref 17592186122932} {:answer/id #uuid "e5ea0548-b7c1-5bad-97f0-772df63e1d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf \\approx - 0.5" :db/id #edb/ref 17592186122933} {:answer/id #uuid "f8f7c64a-223c-5aea-a503-0bceb1da88f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf \\approx 0.5" :db/id #edb/ref 17592186122934} {:answer/id #uuid "73f4c11e-3050-54b8-9c76-cfb8aa6ab07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf \\approx - 0.3" :db/id #edb/ref 17592186122935}] :answer-field/id #uuid "ca377d22-89aa-51a0-900c-a45e47680e33" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122930} {:answer-field/choices [{:answer/id #uuid "07b0dfa1-a3bd-5d86-841e-767261c7fdb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈0.1" :db/id #edb/ref 17592186373014} {:answer/id #uuid "b518876a-d6a2-57b2-92cf-9d904e6dd10f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈-0.5" :db/id #edb/ref 17592186373015} {:answer/id #uuid "6c65d1de-3197-52f8-9f96-cfeb62d0ce2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈0.3" :db/id #edb/ref 17592186373016} {:answer/id #uuid "6123d165-543d-5503-b3d6-b4c4dfd85d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈-0.3" :db/id #edb/ref 17592186373017} {:answer/id #uuid "98e43f2c-7032-55d3-ac19-6318a10d07a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈0.5" :db/id #edb/ref 17592186373018}] :answer-field/correct {:answer/id #uuid "98e43f2c-7032-55d3-ac19-6318a10d07a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Δf≈0.5" :db/id #edb/ref 17592186373018} :answer-field/id #uuid "c754f0c6-e9f0-5f7b-a4f5-f0c361b3d140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373013}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a0b5eb-1d35-5e16-8d84-c218ac09143a" :question/math-academy-id "q-37306" :question/problem "If $f(x,y)=\\operatorname{cos}⁡x+y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(4\\pi ,8)$ to $(13,8.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =-\\operatorname{sin}⁡x\\,\\text{d}x+1\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(4\\pi ,8),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(4\\pi ,8) & =-\\operatorname{sin}⁡4\\pi \\,\\text{d}x+1\\,\\text{d}y \\\\  & =0\\,\\text{d}x+1\\,\\text{d}y\\end{aligned}\n$$\n\nSo, if we move to the point $(4\\pi +Δx,8+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+1\\,Δy.\n$$\n\nMoving from $(4\\pi ,8)$ to $(13,8.5),$ we have\n\n$$\n\\begin{aligned}Δx & =13-4\\pi , \\\\ Δy & =8.5-8=0.5.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+1\\,Δy \\\\  & ≈0\\cdot (13-4\\pi )+1\\cdot (0.5) \\\\  & ≈0.5.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $0.5.$"}] [{:db/id #edb/ref 17592186348266 :knowledge-point/_questions [{:db/id #edb/ref 17592186124565 :knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667" :knowledge-point/title "Computing the Differential of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05905e56-e689-5126-840d-bc1116dd72e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{y}^{3}\\,\\text{d}x+12{y}^{2}\\,\\text{d}y" :db/id #edb/ref 17592186345402} {:answer/id #uuid "67caff4a-7e36-5bec-ac58-0c42c8671613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}x}{x}+12{y}^{2}\\,\\text{d}y" :db/id #edb/ref 17592186346257} {:answer/id #uuid "8cab1644-ef8d-51ab-a9c3-417c7b7e3cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{4}\\,\\text{d}x}{x}+4{y}^{3}\\operatorname{ln}⁡x\\,\\text{d}y" :db/id #edb/ref 17592186346574} {:answer/id #uuid "9a950f20-f785-50c1-a237-5e98fddf7f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{y}^{3}\\,\\text{d}x+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y" :db/id #edb/ref 17592186346700} {:answer/id #uuid "ac8fc4ec-515e-5142-8b79-f41f0428a75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y" :db/id #edb/ref 17592186346855}] :answer-field/correct {:answer/id #uuid "ac8fc4ec-515e-5142-8b79-f41f0428a75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y" :db/id #edb/ref 17592186346855} :answer-field/id #uuid "4ffa6a66-235b-5631-a0c1-500618323098" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d66e91-862a-530e-b18f-86f79ced0d5f" :question/math-academy-id "q-79740" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)=4{y}^{3}\\operatorname{ln}⁡x.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348267 :knowledge-point/_questions [{:db/id #edb/ref 17592186124565 :knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667" :knowledge-point/title "Computing the Differential of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d612bc-dd52-5831-b337-fa6defcd96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{xy}\\,\\text{d}x+y{e}^{xy}\\,\\text{d}y" :db/id #edb/ref 17592186345513} {:answer/id #uuid "564d124b-ce3d-51b6-ae90-cc269fdd3e63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\text{d}x+x\\text{d}y" :db/id #edb/ref 17592186346083} {:answer/id #uuid "8fb6539d-0734-51a3-a90e-aa8418df3be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{xy}\\,\\text{d}x+{e}^{xy}\\,\\text{d}y" :db/id #edb/ref 17592186346601} {:answer/id #uuid "bc642f54-a808-5aa1-8693-2bd65ddb7d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\text{d}x+{e}^{xy}\\,\\text{d}y" :db/id #edb/ref 17592186346989} {:answer/id #uuid "f1b57932-9ec9-52df-820f-e563f00d3236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y" :db/id #edb/ref 17592186347489}] :answer-field/correct {:answer/id #uuid "f1b57932-9ec9-52df-820f-e563f00d3236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y" :db/id #edb/ref 17592186347489} :answer-field/id #uuid "3670839f-8614-5e81-9b1f-cfef89878f24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347697}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d50fccec-ae2d-5c4e-8f8a-368a11f02916" :question/math-academy-id "q-79741" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={e}^{xy}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348270 :knowledge-point/_questions [{:db/id #edb/ref 17592186124566 :knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "393a2da4-2037-5f88-af20-25566e93ee10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{d}a+10\\,\\text{d}b+2\\,\\text{d}c" :db/id #edb/ref 17592186345839} {:answer/id #uuid "5f766058-5345-504f-969f-c6f41943d337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{d}a+5\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346176} {:answer/id #uuid "8c626268-e771-514e-9e16-2f37c28e6a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{d}a+5\\,\\text{d}b+4\\,\\text{d}c" :db/id #edb/ref 17592186346570} {:answer/id #uuid "bd042560-3b82-573a-bb03-933f8a2d73a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346994} {:answer/id #uuid "dbe3e38f-3a94-535d-a8d4-214ff917e54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+25\\,\\text{d}b+4\\,\\text{d}c" :db/id #edb/ref 17592186347278}] :answer-field/correct {:answer/id #uuid "bd042560-3b82-573a-bb03-933f8a2d73a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346994} :answer-field/id #uuid "001e58e4-393c-54c0-893b-8d317963f75b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb226681-0351-549f-b81b-c5875e8a6018" :question/math-academy-id "q-79746" :question/problem "Given a rectangular solid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular solid if the lengths of the sides are $a=2,$ $b=5,$ and $c=1.$" :question/worked-solution "The volume of the rectangular solid is $V=abc.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂c})\\,\\text{d}c \\\\  & =bc\\,\\text{d}a+ac\\,\\text{d}b+ab\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=2,$ $b=5,$ and $c=1,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(2,5,1) & =5\\cdot 1\\,\\text{d}a+2\\cdot 1\\,\\text{d}b+5\\cdot 2\\,\\text{d}c \\\\  & =5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348287 :knowledge-point/_questions [{:db/id #edb/ref 17592186124567 :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf48df2-dc34-52ca-93a9-b4daed0d2e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.1" :db/id #edb/ref 17592186346435} {:answer/id #uuid "8429f3a8-0088-5774-8b2b-6ec526d65653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346501} {:answer/id #uuid "92ce89f6-9755-5e6f-839c-c0fe25166097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186346635} {:answer/id #uuid "a5c7c1da-a44a-587a-bb11-6f4446367efa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186346798} {:answer/id #uuid "d5c5f6c8-cebe-5787-bdab-e969594c0fc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186347231}] :answer-field/correct {:answer/id #uuid "a5c7c1da-a44a-587a-bb11-6f4446367efa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186346798} :answer-field/id #uuid "5e64129a-5def-586b-ba54-9ee7a632757d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347769}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "660c5793-fb22-5668-8662-5f26917785f7" :question/math-academy-id "q-79809" :question/problem "If $f(x,y)=x\\operatorname{sin}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+x\\operatorname{cos}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}x+2\\operatorname{cos}⁡(\\frac{\\pi }{2})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,\\frac{\\pi }{2}+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1.5-2=-0.5, \\\\ Δy & =1.5-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (-0.5)+0\\cdot (1.5-\\frac{\\pi }{2}) \\\\  & ≈-0.5.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $0.5.$"}] [{:db/id #edb/ref 17592186348289 :knowledge-point/_questions [{:db/id #edb/ref 17592186124567 :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "434f2e6c-b51e-56e2-b3b6-bfea95031930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186345933} {:answer/id #uuid "4357d5f4-8f26-5f42-b673-2b35c8637752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.25" :db/id #edb/ref 17592186345936} {:answer/id #uuid "45342e19-03d6-5c5e-82c8-aa1f3a9c2881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186345952} {:answer/id #uuid "6975986f-f6e6-55f7-9e5c-13e49e2e5623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186346267} {:answer/id #uuid "d185e4fb-7b96-564b-a235-1e5d04c537b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.25" :db/id #edb/ref 17592186347188}] :answer-field/correct {:answer/id #uuid "45342e19-03d6-5c5e-82c8-aa1f3a9c2881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186345952} :answer-field/id #uuid "922aa6d1-ce19-5aa5-aed9-a049d29daf39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3a7a619-a349-551d-ae22-16b086347f4a" :question/math-academy-id "q-79810" :question/problem "If $f(x,y)={x}^{2}y+\\sqrt{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,4)$ to $(-1,5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =2xy\\,\\text{d}x+({x}^{2}+\\frac{1}{2\\sqrt{y}})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,4),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,4) & =2\\cdot 0\\cdot 4\\,\\text{d}x+({0}^{2}+\\frac{1}{2\\sqrt{4}})\\,\\text{d}y \\\\  & =0\\,\\text{d}x+\\frac{1}{4}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,4+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+\\frac{1}{4}\\,Δy.\n$$\n\nMoving from $(0,4)$ to $(-1,5),$ we have\n\n$$\n\\begin{aligned}Δx & =-1-0=-1, \\\\ Δy & =5-4=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+\\frac{1}{4}\\,Δy \\\\  & ≈0\\cdot (-1)+\\frac{1}{4}\\cdot (1) \\\\  & ≈0.25.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $0.25.$"}] [{:db/id #edb/ref 17592186125227 :knowledge-point/_questions [{:db/id #edb/ref 17592186124568 :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0516f7dd-9d93-57c6-ac01-af2cb388af77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.15" :db/id #edb/ref 17592186345393} {:answer/id #uuid "2c46633a-f843-53a2-9bce-50673065b712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.19" :db/id #edb/ref 17592186345747} {:answer/id #uuid "68f6bd37-5d74-5a8a-a983-e540fc0d5f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.16" :db/id #edb/ref 17592186346261} {:answer/id #uuid "77700bc0-d51f-5b58-93c4-32ba10d18ec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.18" :db/id #edb/ref 17592186346400} {:answer/id #uuid "c5edcb38-7406-54f1-8a3a-1da16bc7f752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.20" :db/id #edb/ref 17592186347073}] :answer-field/correct {:answer/id #uuid "77700bc0-d51f-5b58-93c4-32ba10d18ec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.18" :db/id #edb/ref 17592186346400} :answer-field/id #uuid "e67277c2-ffd2-5937-8d1e-923e1b9e37f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348008}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d809b121-2117-5794-bb89-efcea5057754" :question/math-academy-id "q-79837" :question/problem "Estimate $(1.81)\\cdot \\operatorname{ln}⁡(0.91)$ using a differential $\\text{d}f$ of the function $f(x,y)=x\\operatorname{ln}⁡y$ at the point $(2,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(2,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\operatorname{ln}⁡(1)\\,\\text{d}x+\\frac{2}{1}\\,\\text{d}y \\\\  & =0\\,\\text{d}x+2\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,1+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+2\\,Δy\n$$\n\nNote that \n\n$$\n(1.81)\\cdot \\operatorname{ln}⁡(0.91)=f(1.81,0.91),\n$$\n\nso we want to move to the point $(1.81,0.91).$\n\nMoving from $(2,1)$ to $(1.81,0.91),$ we have\n\n$$\n\\begin{aligned}Δx & =1.81-2=-0.19, \\\\ Δy & =0.91-1=-0.09.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\cdot (-0.19)+2\\cdot (-0.09) \\\\  & ≈0-0.18 \\\\  & ≈-0.18.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.18.$ Consequently, we have\n\n$$\n\\begin{aligned}f(1.81,0.91) & ≈f(2,1)-0.18 \\\\ (1.81)\\cdot \\operatorname{ln}⁡(0.91) & ≈2\\operatorname{ln}⁡1-0.18 \\\\  & ≈0-0.18 \\\\  & ≈-0.18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373237 :knowledge-point/_questions [{:db/id #edb/ref 17592186124568 :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5523408e-53c1-55c6-9d6c-93f6067c5024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.138" :db/id #edb/ref 17592186373239} {:answer/id #uuid "3a0e8bda-987d-556d-adc4-5475e67e3649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.146" :db/id #edb/ref 17592186373240} {:answer/id #uuid "85457950-05dd-515a-979c-3c810b65e48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.142" :db/id #edb/ref 17592186373241} {:answer/id #uuid "0e12f9b2-e25d-5e0c-8da0-288cbfb87a9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.144" :db/id #edb/ref 17592186373242} {:answer/id #uuid "64ebbe04-7bf2-5612-a63d-daf300abef15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.140" :db/id #edb/ref 17592186373243}] :answer-field/correct {:answer/id #uuid "85457950-05dd-515a-979c-3c810b65e48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.142" :db/id #edb/ref 17592186373241} :answer-field/id #uuid "b0095e22-2029-58c2-ab81-2e1546884b41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba7d8609-104d-5a2e-b355-39ac5dc83584" :question/math-academy-id "q-79838" :question/problem "Estimate $\\sqrt{3.9}\\operatorname{cos}⁡(1.5)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\sqrt{x}\\operatorname{cos}⁡y$ at the point $(4,\\frac{\\pi }{2}).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\operatorname{cos}⁡y}{2\\sqrt{x}}\\,\\text{d}x-\\sqrt{x}\\operatorname{sin}⁡y\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(4,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})}{2\\sqrt{4}}\\,\\text{d}x-\\sqrt{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}y \\\\  & =0\\,\\text{d}x-2\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(4+Δx,\\frac{\\pi }{2}+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx-2\\,Δy\n$$\n\nNote that \n\n$$\n\\sqrt{3.9}\\operatorname{cos}⁡(1.5)=f(3.9,1.5),\n$$\n\nso we want to move to the point $(3.9,1.5).$\n\nMoving from $(4,\\frac{\\pi }{2})$ to $(3.9,1.5),$ we have\n\n$$\n\\begin{aligned}Δx & =3.9-4=-0.1, \\\\ Δy & =1.5-\\frac{\\pi }{2}≈-0.070796.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\cdot (-0.1)-2(-0.070796) \\\\  & ≈0+0.141592 \\\\  & ≈0.141592.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.141592.$ Consequently, we have\n\n$$\n\\begin{aligned}f(3.9,1.5) & ≈f(4,\\frac{\\pi }{2})+0.141592 \\\\ \\sqrt{3.9}\\operatorname{cos}⁡(1.5) & ≈\\sqrt{4}\\operatorname{cos}⁡(\\frac{\\pi }{2})+0.141592 \\\\  & ≈0+0.141592 \\\\  & ≈0.142,\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186348304 :knowledge-point/_questions [{:db/id #edb/ref 17592186124568 :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5677a6cf-3ae1-5c05-a7ea-d18c541cd27a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.1" :db/id #edb/ref 17592186346086} {:answer/id #uuid "924a5a3d-80d3-5178-be63-b38474407f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8" :db/id #edb/ref 17592186346630} {:answer/id #uuid "c0638f2c-fe79-54bf-9fa1-4ff52d6c1be9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.3" :db/id #edb/ref 17592186347015} {:answer/id #uuid "cbfbad30-45da-5493-a15a-e1bb6fe1f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.7" :db/id #edb/ref 17592186347138} {:answer/id #uuid "dc032e4b-974c-59fc-a8c3-0ad4f14b6c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186347279}] :answer-field/correct {:answer/id #uuid "dc032e4b-974c-59fc-a8c3-0ad4f14b6c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186347279} :answer-field/id #uuid "c553bfad-eb56-5870-b224-d71594c0704b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1639694c-cbca-54ad-bf88-2314edcecfd3" :question/math-academy-id "q-79842" :question/problem "Estimate $2.1{e}^{0.2}$ using a differential $\\text{d}f$ of the function $f(x,y)=x{e}^{y}$ at the point $(2,0).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & ={e}^{y}\\,\\text{d}x+x{e}^{y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & ={e}^{0}\\,\\text{d}x+2\\cdot {e}^{0}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+2\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+2\\,Δy\n$$\n\nNote that \n\n$$\n2.1{e}^{0.2}=f(2.1,0.2),\n$$\n\nso we want to move to the point $(2.1,0.2).$\n\nMoving from $(2,0)$ to $(2.1,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =2.1-2=0.1, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\cdot (0.1)+2\\cdot (0.2) \\\\  & ≈0.1+0.4 \\\\  & ≈0.5.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.5.$ Consequently, we have\n\n$$\n\\begin{aligned}f(2.1,0.2) & ≈f(2,0)+0.5 \\\\ 2.1{e}^{0.2} & ≈2{e}^{0}+0.5 \\\\  & ≈2+0.5 \\\\  & ≈2.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348321 :knowledge-point/_questions [{:db/id #edb/ref 17592186124566 :knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16681232-d875-51d4-8775-995a4bdc038d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{d}r+4\\,\\text{d}h" :db/id #edb/ref 17592186345550} {:answer/id #uuid "19759a8b-a542-5b9d-ac6b-52141e753e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}\\,\\text{d}r+\\frac{3}{10}\\,\\text{d}h" :db/id #edb/ref 17592186345575} {:answer/id #uuid "39123486-345d-5915-be9e-6db3c7d3e8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\,\\text{d}r+\\frac{4}{5}\\,\\text{d}h" :db/id #edb/ref 17592186345838} {:answer/id #uuid "65039564-9812-5d42-8c1d-dcf7c26c5410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}\\,\\text{d}r+\\frac{2}{5}\\,\\text{d}h" :db/id #edb/ref 17592186346227} {:answer/id #uuid "d3029df8-972e-585a-af9f-01f6b385376c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\,\\text{d}r+\\frac{3}{5}\\,\\text{d}h" :db/id #edb/ref 17592186347196}] :answer-field/correct {:answer/id #uuid "39123486-345d-5915-be9e-6db3c7d3e8ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\,\\text{d}r+\\frac{4}{5}\\,\\text{d}h" :db/id #edb/ref 17592186345838} :answer-field/id #uuid "a7bb7a4f-725e-5075-b3cf-da3a1d65ad3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00fbdc66-0e7c-5f09-b062-4832cba6efd9" :question/math-academy-id "q-79958" :question/problem "Given a right cone, find the differential $\\text{d}l$ for the slant height $l$ of the right cone if its base radius is $r=3$ and height $h=4.$" :question/worked-solution "The slant height of the right cone is $l=\\sqrt{{r}^{2}+{h}^{2}}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}l(r,h) & =(\\frac{∂l}{∂r})\\,\\text{d}r+(\\frac{∂l}{∂h})\\,\\text{d}h \\\\  & =\\frac{r}{\\sqrt{{r}^{2}+{h}^{2}}}\\,\\text{d}r+\\frac{h}{\\sqrt{{r}^{2}+{h}^{2}}}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $r=3$  and $h=4$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(3,4) & =\\frac{3}{\\sqrt{{3}^{2}+{4}^{2}}}\\,\\text{d}r+\\frac{4}{\\sqrt{{3}^{2}+{4}^{2}}}\\,\\text{d}h \\\\  & =\\frac{3}{5}\\,\\text{d}r+\\frac{4}{5}\\,\\text{d}h.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354501 :knowledge-point/_questions [{:db/id #edb/ref 17592186124567 :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e7b4730-07bc-55e3-a6a1-1f8f741572c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186352147} {:answer/id #uuid "82af2898-1b6c-5362-bd25-0fa6ec45995a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186352706} {:answer/id #uuid "a1fd631b-991b-54d5-9cc6-8f3cbf84de69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186352953} {:answer/id #uuid "b1408a5a-b1a7-5eba-8e9e-add29f5b3b8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186353083} {:answer/id #uuid "bd42095a-e62b-516a-8666-20268ea4ab47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186353179}] :answer-field/correct {:answer/id #uuid "3e7b4730-07bc-55e3-a6a1-1f8f741572c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186352147} :answer-field/id #uuid "fb9582cd-856c-58b5-9f89-f922a1fb2623" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d42b8603-2969-573d-b945-d7e1061c7be0" :question/math-academy-id "q-86715" :question/problem "If $f(x,y,z)={x}^{2}+4\\operatorname{ln}⁡({z}^{3}-y),$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(2,-3,1)$ to $(1,-2,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =2x\\,\\text{d}x-(\\frac{4}{{z}^{3}-y})\\,\\text{d}y+(\\frac{12{z}^{2}}{{z}^{3}-y})\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(2,-3,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,-3,1) & =(2\\cdot 2)\\,\\text{d}x-(\\frac{4}{{1}^{3}-(-3)})\\,\\text{d}y+(\\frac{12\\cdot {1}^{2}}{{1}^{3}-(-3)})\\,\\text{d}z \\\\  & =4\\,\\text{d}x-\\,\\text{d}y+3\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,-3+Δy,1+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈4\\,Δx-\\,Δy+3\\,Δz.\n$$\n\nMoving from $(2,-3,1)$ to $(1,-2,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-2-(-3)=1 \\\\ Δz & =2-1=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈4\\,Δx-1\\,Δy+3\\,Δz \\\\  & ≈4\\cdot (-1)-1\\cdot 1+3\\cdot 1 \\\\  & ≈-2.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ decreases by approximately $-2.$"}] [{:db/id #edb/ref 17592186354503 :knowledge-point/_questions [{:db/id #edb/ref 17592186124568 :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055e28da-53a3-56a0-936c-0d9671fd3eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186351615} {:answer/id #uuid "2002afe9-57a6-5eea-89b1-769b51a8d9f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.6" :db/id #edb/ref 17592186351850} {:answer/id #uuid "7a3528b6-af86-5cee-8196-f85faa9431c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.6" :db/id #edb/ref 17592186352631} {:answer/id #uuid "b2d1f5fe-3a65-577e-bd22-9c9dffc1c379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.6" :db/id #edb/ref 17592186353096} {:answer/id #uuid "f54e7de6-cb92-58e2-8129-ce019b963249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.6" :db/id #edb/ref 17592186353712}] :answer-field/correct {:answer/id #uuid "7a3528b6-af86-5cee-8196-f85faa9431c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.6" :db/id #edb/ref 17592186352631} :answer-field/id #uuid "de653567-a501-57e8-a380-cad8d0781232" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354194}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cb4b46a5-3d8b-55b1-a7c8-ab6f3feb209f" :question/math-academy-id "q-86717" :question/problem "Estimate ${e}^{(0.3)(2.15)}$ using a differential $\\text{d}f$ of the function $f(x,y)={e}^{xy}$ at the point $(0,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(0,2),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =2\\cdot {e}^{0\\cdot 2}\\,\\text{d}x+0\\cdot {e}^{0\\cdot 2}\\,\\text{d}y \\\\  & =2\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,2+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈2\\,Δx+0\\,Δy.\n$$\n\nNote that \n\n$$\n{e}^{(0.3)(2.15)}=f(0.3,2.15),\n$$\n\nso we want to move to the point $(0.3,2.15).$\n\nMoving from $(0,2)$ to $(0.3,2.15),$ we have\n\n$$\n\\begin{aligned}Δx & =0.3-0=0.3, \\\\ Δy & =2.15-2=0.15.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈2\\cdot (0.3)+0\\cdot (0.15) \\\\  & ≈0.6\\,.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.6.$ Consequently, we have\n\n$$\n\\begin{aligned}f(0.3,2.15) & ≈f(0,2)+0.6 \\\\ {e}^{(0.3)(2.15)} & ≈{e}^{(0)(2)}+0.6 \\\\  & ≈1+0.6 \\\\  & ≈1.6\\,.\\end{aligned}\n$$"}]}
