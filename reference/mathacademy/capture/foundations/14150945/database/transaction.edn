[[:db/retract 17592186125052 :question/answer-fields 17592186122912] [:db/retract 17592186125055 :question/answer-fields 17592186122930] {:db/id 17592186124565 :knowledge-point/questions ["question-26a471f3-9b78-5070-a5db-c0478cd96f7d" "question-1e237109-086a-53bd-a512-ebeaca53c3dd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124566 :knowledge-point/questions ["question-4e75bdad-f36e-527c-a1e9-527d230dfe09"] :db/ensure [:knowledge-point/validate]} {:db/id "question-26a471f3-9b78-5070-a5db-c0478cd96f7d" :question/id #uuid "26a471f3-9b78-5070-a5db-c0478cd96f7d" :question/math-academy-id "q-79957" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{ln}⁡(xyz).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =\\frac{yz\\,\\text{d}x}{xyz}+\\frac{xz\\,\\text{d}y}{xyz}+\\frac{xy\\,\\text{d}z}{xyz} \\\\  & =\\frac{\\,\\text{d}x}{x}+\\frac{\\,\\text{d}y}{y}+\\frac{\\,\\text{d}z}{z}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-102010b9-db98-5ea2-8e9e-7da7428fc2a9"] :db/ensure [:question/validate]} {:db/id "answer-field-102010b9-db98-5ea2-8e9e-7da7428fc2a9" :answer-field/id #uuid "102010b9-db98-5ea2-8e9e-7da7428fc2a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f807cb6c-01c1-5522-a5dd-56315c935102" :answer-field/choices ["answer-72ff75da-b13e-5583-ae20-2ce0e2a55a49" "answer-f807cb6c-01c1-5522-a5dd-56315c935102" "answer-9ca16da6-7a8f-5ec5-ade1-d109e6b3501f" "answer-eaf3116a-63b5-5ad8-b1f5-843a36b5e2c3" "answer-81e483ab-3798-55cc-8300-27c841a9bb82"] :db/ensure [:answer-field/validate]} {:db/id "answer-72ff75da-b13e-5583-ae20-2ce0e2a55a49" :answer/id #uuid "72ff75da-b13e-5583-ae20-2ce0e2a55a49" :answer/type :answer.type/math :answer/value "\\frac{\\,\\text{d}x}{xyz}+\\frac{\\,\\text{d}y}{xyz}+\\frac{\\,\\text{d}z}{xyz}" :db/ensure [:answer/validate]} {:db/id "answer-f807cb6c-01c1-5522-a5dd-56315c935102" :answer/id #uuid "f807cb6c-01c1-5522-a5dd-56315c935102" :answer/type :answer.type/math :answer/value "\\frac{\\,\\text{d}x}{x}+\\frac{\\,\\text{d}y}{y}+\\frac{\\,\\text{d}z}{z}" :db/ensure [:answer/validate]} {:db/id "answer-9ca16da6-7a8f-5ec5-ade1-d109e6b3501f" :answer/id #uuid "9ca16da6-7a8f-5ec5-ade1-d109e6b3501f" :answer/type :answer.type/math :answer/value "\\frac{\\,\\text{d}x}{yz}+\\frac{\\,\\text{d}y}{xz}+\\frac{\\,\\text{d}z}{xy}" :db/ensure [:answer/validate]} {:db/id "answer-eaf3116a-63b5-5ad8-b1f5-843a36b5e2c3" :answer/id #uuid "eaf3116a-63b5-5ad8-b1f5-843a36b5e2c3" :answer/type :answer.type/math :answer/value "x\\,\\text{d}x+y\\,\\text{d}y+z\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-81e483ab-3798-55cc-8300-27c841a9bb82" :answer/id #uuid "81e483ab-3798-55cc-8300-27c841a9bb82" :answer/type :answer.type/math :answer/value "yz\\,\\text{d}x+xz\\,\\text{d}y+xy\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "question-1e237109-086a-53bd-a512-ebeaca53c3dd" :question/id #uuid "1e237109-086a-53bd-a512-ebeaca53c3dd" :question/math-academy-id "q-167152" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)={x}^{2}y+{y}^{3}z-x{z}^{2}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =(2xy-{z}^{2})\\,\\text{d}x+({x}^{2}+3{y}^{2}z)\\,\\text{d}y+({y}^{3}-2xz)\\,\\text{d}z\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6982bff1-d527-5b1b-a1cc-95bd4bd0cec5"] :db/ensure [:question/validate]} {:db/id "answer-field-6982bff1-d527-5b1b-a1cc-95bd4bd0cec5" :answer-field/id #uuid "6982bff1-d527-5b1b-a1cc-95bd4bd0cec5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1d94390-787f-5fc0-9917-5d0f985a5aff" :answer-field/choices ["answer-f3201288-0ff0-5d05-8546-c32107c2bd04" "answer-e1d94390-787f-5fc0-9917-5d0f985a5aff" "answer-0ac0761e-892b-53e0-bd4a-bcb35229b775" "answer-592edaac-aa03-5270-a8be-982b5b3cf8eb" "answer-949f1307-08bf-5cc4-b984-37982aadf2e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3201288-0ff0-5d05-8546-c32107c2bd04" :answer/id #uuid "f3201288-0ff0-5d05-8546-c32107c2bd04" :answer/type :answer.type/math :answer/value "(2xy+{x}^{2})\\,\\text{d}x+({y}^{3}+3{y}^{2}z)\\,\\text{d}y+({z}^{2}-2xz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-e1d94390-787f-5fc0-9917-5d0f985a5aff" :answer/id #uuid "e1d94390-787f-5fc0-9917-5d0f985a5aff" :answer/type :answer.type/math :answer/value "(2xy-{z}^{2})\\,\\text{d}x+({x}^{2}+3{y}^{2}z)\\,\\text{d}y+({y}^{3}-2xz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-0ac0761e-892b-53e0-bd4a-bcb35229b775" :answer/id #uuid "0ac0761e-892b-53e0-bd4a-bcb35229b775" :answer/type :answer.type/math :answer/value "(2xy-{z}^{2})\\,\\text{d}x+{x}^{2}\\,\\text{d}y+{y}^{3}\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-592edaac-aa03-5270-a8be-982b5b3cf8eb" :answer/id #uuid "592edaac-aa03-5270-a8be-982b5b3cf8eb" :answer/type :answer.type/math :answer/value "-{z}^{2}\\,\\text{d}x+({y}^{3}-{z}^{2})\\,\\text{d}y+({y}^{3}-2xz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "answer-949f1307-08bf-5cc4-b984-37982aadf2e7" :answer/id #uuid "949f1307-08bf-5cc4-b984-37982aadf2e7" :answer/type :answer.type/math :answer/value "{z}^{2}\\,\\text{d}x+({x}^{2}+3{y}^{2}z)\\,\\text{d}y-2xz\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "question-4e75bdad-f36e-527c-a1e9-527d230dfe09" :question/id #uuid "4e75bdad-f36e-527c-a1e9-527d230dfe09" :question/math-academy-id "q-79748" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the lengths of the sides are $a=4,$ $b=5,$ and $c=7.$" :question/worked-solution "The  surface area of the rectangular solid is $S=2ab+2bc+2ac.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,b,c) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂b})\\,\\text{d}b+(\\frac{∂S}{∂c})\\,\\text{d}c \\\\  & =2(b+c)\\,\\text{d}a+2(a+c)\\,\\text{d}b+2(a+b)\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=4,$ $b=5,$ and $c=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,5,7) & =2(5+7)\\,\\text{d}a+2(4+7)\\,\\text{d}b+2(4+5)\\,\\text{d}c \\\\  & =24\\,\\text{d}a+22\\,\\text{d}b+18\\,\\text{d}c.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-91bbad55-b7c9-5018-bd2b-a6b22c055c21"] :db/ensure [:question/validate]} {:db/id "answer-field-91bbad55-b7c9-5018-bd2b-a6b22c055c21" :answer-field/id #uuid "91bbad55-b7c9-5018-bd2b-a6b22c055c21" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-15f3dee8-e6f4-5787-8395-50cb7a5ce3d9" :answer-field/choices ["answer-a1659264-c9c8-589f-9fdb-0ef010eb62c1" "answer-15f3dee8-e6f4-5787-8395-50cb7a5ce3d9" "answer-1cbc47ca-c217-5961-8ebc-60818e4b7533" "answer-8596556d-0399-5275-8336-5e8a62170257" "answer-418af1c1-d6d4-51bf-ada3-9317c8a8af10"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1659264-c9c8-589f-9fdb-0ef010eb62c1" :answer/id #uuid "a1659264-c9c8-589f-9fdb-0ef010eb62c1" :answer/type :answer.type/math :answer/value "12\\,\\text{d}a+11\\,\\text{d}b+9\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "answer-15f3dee8-e6f4-5787-8395-50cb7a5ce3d9" :answer/id #uuid "15f3dee8-e6f4-5787-8395-50cb7a5ce3d9" :answer/type :answer.type/math :answer/value "24\\,\\text{d}a+22\\,\\text{d}b+18\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "answer-1cbc47ca-c217-5961-8ebc-60818e4b7533" :answer/id #uuid "1cbc47ca-c217-5961-8ebc-60818e4b7533" :answer/type :answer.type/math :answer/value "35\\,\\text{d}a+28\\,\\text{d}b+20\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "answer-8596556d-0399-5275-8336-5e8a62170257" :answer/id #uuid "8596556d-0399-5275-8336-5e8a62170257" :answer/type :answer.type/math :answer/value "4\\,\\text{d}a+5\\,\\text{d}b+7\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "answer-418af1c1-d6d4-51bf-ada3-9317c8a8af10" :answer/id #uuid "418af1c1-d6d4-51bf-ada3-9317c8a8af10" :answer/type :answer.type/math :answer/value "8\\,\\text{d}a+10\\,\\text{d}b+14\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id 17592186125814 :tutorial/content "Given a multivariable function $f(x,y),$ the differential\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y\\end{aligned}\n$$\n\ntells us how infinitesimal changes in $x$ and $y,$ denoted $\\textrm dx$ and $\\textrm dy,$ result in an infinitesimal change in $f,$ denoted $\\textrm df.$\n\nConsequently, we can use the differential to *approximate* the change in $f$ as we move from one point to another. If we move from a point $(x,y)$ to a point $(x + \\Delta x, y + \\Delta y),$ then the approximate change in $f$ is given by\n\n$$\n\\begin{aligned}Δf(x,y) & ≈(\\frac{∂f}{∂x})\\,Δx+(\\frac{∂f}{∂y})\\,Δy.\\end{aligned}\n$$\n\nThe above formula is very similar to the differential formula, except the $\\textrm d$'s are replaced with $\\Delta$'s. The $\\textrm d$'s refer to infinitesimal changes, while the $\\Delta$'s refer to changes that can actually be measured." :db/ensure [:tutorial/validate]} {:db/id 17592186124739 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]}]
