}}{3\\sqrt{3}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444330 #edb/ref 1068 #edb/ref 17592186444316 #edb/ref 17592186045417] [17592186444330 #edb/ref 1069 "q-165241" #edb/ref 17592186045417] [17592186444330 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186444330 #edb/ref 1071 "Given the curve $r(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t,\\,t-2⟩,$ use the cross product curvature formula to find the curvature of this curve as a function of $t.$ \n\n*Hint: You can use the fact that ${r}^{′}(t)\\times {r}^{″}(t)=2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j+4k.$*" #edb/ref 17592186045417] [17592186444330 #edb/ref 1072 #uuid "4d730355-3ecf-557f-807f-e7e1ed97b6ff" #edb/ref 17592186045417] [17592186444330 #edb/ref 1074 "The curvature $κ(t)$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(t-2)⟩ \\\\  & =⟨-2\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t,\\,1⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(-2\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{cos}⁡t)}^{2}+{1}^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t+1} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\nSince we are told that\n\n$$\n{r}^{′}(t)\\times {r}^{″}(t)=2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j+4k,\n$$\n\nwe have\n\n$$\n\\begin{aligned}‖{r}^{′}(t)\\times {r}^{″}(t)‖ & =\\sqrt{{(2\\operatorname{sin}⁡t)}^{2}+{(-2\\operatorname{cos}⁡t)}^{2}+{(4)}^{2}} \\\\  & =\\sqrt{4+16} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{2\\sqrt{5}}{(\\sqrt{5})^{3}} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444331 #edb/ref 1068 #edb/ref 17592186444318 #edb/ref 17592186045417] [17592186444331 #edb/ref 1069 "q-34389" #edb/ref 17592186045417] [17592186444331 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186444331 #edb/ref 1071 "Using the cross product curvature formula, find the curvature of $r(t)=⟨2\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t⟩$ as a function of $t.$" #edb/ref 17592186045417] [17592186444331 #edb/ref 1072 #uuid "7326acab-616b-5037-877a-7e6bd9629162" #edb/ref 17592186045417] [17592186444331 #edb/ref 1074 "The curvature $κ$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we calculate ${r}^{′}(t)$ and $‖{r}^{′}(t)‖$:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨2\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),3\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩=⟨2\\operatorname{cos}⁡t,-3\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(2cos)^{2}+(-3\\operatorname{sin}⁡t)^{2}}=\\sqrt{4{cos}^{2}⁡t+9{sin}^{2}⁡t}\\end{aligned}\n$$\n\nNow, we find the second derivative:\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨2\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),-3\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)⟩=⟨-2\\operatorname{sin}⁡t,-3\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(t)$ and ${r}^{″}(t)$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(t)\\times {r}^{″}(t) & =⟨2\\operatorname{cos}⁡t,\\,-3\\operatorname{sin}⁡t,0⟩\\times ⟨0,\\,-2\\operatorname{sin}⁡t,\\,-3\\operatorname{cos}⁡t,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2\\operatorname{cos}⁡t & -3\\operatorname{sin}⁡t & 0 \\\\ -2\\operatorname{sin}⁡t & -3\\operatorname{cos}⁡t & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}2\\operatorname{cos}⁡t & -3\\operatorname{sin}⁡t \\\\ -2\\operatorname{sin}⁡t & -3\\operatorname{cos}⁡t\\end{aligned}\\right|\\,k \\\\  & =(-6{cos}^{2}⁡t-6{sin}^{2}⁡t)\\,k \\\\  & =-6\\,k\\end{aligned}\n$$\n\nSo, the magnitude of the cross product is\n\n$$\n‖{r}^{′}(t)\\times {r}^{″}(t)‖=6.\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{6}{(\\sqrt{4{cos}^{2}⁡t+9{sin}^{2}⁡t})^{3}} \\\\  & =\\frac{6}{(4{cos}^{2}⁡t+9{sin}^{2}⁡t)^{3/2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444332 #edb/ref 1068 #edb/ref 17592186444319 #edb/ref 17592186045417] [17592186444332 #edb/ref 1069 "q-83407" #edb/ref 17592186045417] [17592186444332 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186444332 #edb/ref 1071 "Given the curve $r(t)=⟨{e}^{t},\\,{e}^{2t},\\,2t⟩,$ use the cross product curvature formula to compute the curvature at the point $P(1,1,0).$" #edb/ref 17592186045417] [17592186444332 #edb/ref 1072 #uuid "de097a4f-c54e-5f8e-b869-e4dc2af58fad" #edb/ref 17592186045417] [17592186444332 #edb/ref 1074 "The curvature $κ(t)$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we find the value of $t$ that corresponds to the point $P(1,1,0)$ on the given curve. We know that\n\n$$\n\\begin{aligned}r(t) & =⟨1,1,0⟩ \\\\ ⟨{e}^{t},\\,{e}^{2t},\\,2t⟩ & =⟨1,1,0⟩.\\end{aligned}\n$$\n\nEquating the respective components gives\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{e}^{t}=1 \\\\ {e}^{2t}=1 \\\\ 2t=0.\\end{aligned}\\end{aligned}\n$$\n\nFrom the first equality, $t=0.$ This value also satisfies the other two equations. Therefore, $P(1,1,0)$ is at the tip of $r(0).$ \n\nNow, we calculate ${r}^{′}(t)$, ${r}^{′}(0),$  and $‖{r}^{′}(0)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{2t}),\\,\\frac{\\text{d}}{\\text{d}t}(2t)⟩ \\\\  & =⟨{e}^{t},\\,2{e}^{2t},\\,2⟩ \\\\ {r}^{′}(0) & =⟨1,2,2⟩ \\\\ ‖{r}^{′}(0)‖ & =\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}=3\\end{aligned}\n$$\n\nNext, we find ${r}^{″}(t)$ and ${r}^{″}(0):$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(2{e}^{2t}),\\,\\frac{\\text{d}}{\\text{d}t}(2)⟩ \\\\  & =⟨{e}^{t},\\,4{e}^{2t},\\,0⟩ \\\\ {r}^{″}(0) & =⟨1,4,0⟩\\end{aligned}\n$$\n\nNext, we compute the cross-product and its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(0)\\times {r}^{″}(0) & =|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 1 & 4 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 2 \\\\ 4 & 0\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}|j+|\\begin{aligned}1 & 2 \\\\ 1 & 4\\end{aligned}|k \\\\  & =-8i+2j+2k \\\\ ‖{r}^{′}(0)\\times {r}^{″}(0)‖ & =\\sqrt{(-8)^{2}+{2}^{2}+{2}^{2}} \\\\  & =6\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{‖{r}^{′}(0)\\times {r}^{″}(0)‖}{‖{r}^{′}(0){‖}^{3}}=\\frac{6\\sqrt{2}}{{3}^{3}}=\\frac{2\\sqrt{2}}{9}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186444333 #edb/ref 1068 #edb/ref 17592186444323 #edb/ref 17592186045417] [17592186444333 #edb/ref 1069 "q-83404" #edb/ref 17592186045417] [17592186444333 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186444333 #edb/ref 1071 "Given the curve $r(t)=⟨\\frac{2{t}^{3}}{3},{t}^{2},\\,\\,t⟩$ for $t>0$, use the cross product curvature formula to compute the curvature at the point $P(\\frac{2}{3},1,1).$" #edb/ref 17592186045417] [17592186444333 #edb/ref 1072 #uuid "e89f4c3b-6723-58b1-b21d-dbb9b8ced775" #edb/ref 17592186045417] [17592186444333 #edb/ref 1074 "The curvature $κ(t)$ is given by\n\n$$\nκ(t)=\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}}.\n$$\n\nFirst, we find the value of $t$ that corresponds to the point $P(\\frac{2}{3},1,1)$ on the given curve. We know that \n\n$$\n\\begin{aligned}r(t) & =⟨\\frac{2}{3},1,1⟩ \\\\ ⟨\\frac{2{t}^{3}}{3},{t}^{2},\\,\\,t⟩ & =⟨\\frac{2}{3},1,1⟩.\\end{aligned}\n$$\n\nEquating the respective components gives\n\n$$\n\\begin{aligned}\\{\\begin{aligned}\\frac{2{t}^{3}}{3}=\\frac{2}{3} \\\\ {t}^{2}=1 \\\\ t=1.\\end{aligned}\\end{aligned}\n$$\n\nFrom the third equality, $t=1.$ This value also satisfies the other two equations. Therefore, $P(\\frac{2}{3},1,1)$ is at the tip of $r(1).$ \n\nNow, we calculate ${r}^{′}(t)$, ${r}^{′}(1),$  and $‖{r}^{′}(1)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{2{t}^{3}}{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2{t}^{2},\\,2t,\\,1⟩ \\\\ {r}^{′}(1) & =⟨2,2,1⟩ \\\\ ‖{r}^{′}(1)‖ & =\\sqrt{{2}^{2}+{2}^{2}+{1}^{2}}=3\\end{aligned}\n$$\n\nNext, we find ${r}^{″}(t)$ and ${r}^{″}(1):$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =⟨4t,\\,2,\\,0⟩ \\\\ {r}^{″}(1) & =⟨4,2,0⟩\\end{aligned}\n$$\n\nNext, we compute the cross-product and its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(1)\\times {r}^{″}(1) & =|\\begin{aligned}i & j & k \\\\ 2 & 2 & 1 \\\\ 4 & 2 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}|i-|\\begin{aligned}2 & 1 \\\\ 4 & 0\\end{aligned}|j+|\\begin{aligned}2 & 2 \\\\ 4 & 2\\end{aligned}|k \\\\  & =-2i+4j-4k \\\\ ‖{r}^{′}(1)\\times {r}^{″}(1)‖ & =\\sqrt{(-2)^{2}+{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{36} \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the curvature at $t=1$ is\n\n$$\n\\begin{aligned}κ(1) & =\\frac{‖{r}^{′}(1)\\times {r}^{″}(1)‖}{‖{r}^{′}(1){‖}^{3}} \\\\  & =\\frac{6}{{3}^{3}} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
