sup><mi>t</mi><mn>4</mn></msup></msqrt><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mi>t</mi></mrow><mrow><mn>3</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>4</mn></msup><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
