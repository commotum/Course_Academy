retchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mrow><mn>3</mn><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
