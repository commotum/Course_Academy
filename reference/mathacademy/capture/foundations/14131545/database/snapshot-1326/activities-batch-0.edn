#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186129974} :activity/id #uuid "c86f04c0-24d4-55b0-be41-5c72f2b1041e" :activity/scope {:db/id #edb/ref 17592186048305 :topic/id #uuid "932b897a-3e92-55be-8edd-57b43e8f7c9d" :topic/math-academy-id 2016} :activity/steps [{:db/id #edb/ref 17592186129974 :step/content {:db/id #edb/ref 17592186130351 :tutorial/content "Let's compute the eigenvalues of the following matrix:\n\n![](images/1b/1bc3c21f31a351f7f7281824a0d6db9fce0c1581f6506e6533c2352fe6460788.svg)\n\nThe characteristic equation of $A$ is\n\n$$\n\\lambda^2 +1 = 0.\n$$\n\nThe eigenvalues are the roots of the characteristic equation. However, the discriminant of this equation is \n\n$$\n\\mathcal{D}=-4<0,\n$$\n\nso $A$ doesn't have any real eigenvalues! \n\nNonetheless, we can still compute the eigenvalues of $A.$ The difference here is that they will be complex numbers. Let's solve the characteristic equation using the square root method:\n\n$$\n\\begin{aligned}{\\lambda }^{2}+1=0 \\\\ {\\lambda }^{2}=-1 \\\\ \\lambda =\\pm \\text{i}\\end{aligned}\n$$\n\nTherefore, we conclude that the eigenvalues of $A$ are $\\lambda = \\pm\\textrm{i}.$" :tutorial/id #uuid "5303636d-9f2f-59cc-a2d4-8f3d8d0228ea" :tutorial/math-academy-id 3592 :tutorial/title "Introduction"} :step/id #uuid "7cd0f83e-2007-56ea-b4a7-639880aed13e" :step/math-academy-id 20162 :step/next {:db/id #edb/ref 17592186130013}} {:db/id #edb/ref 17592186129975 :step/content {:db/id #edb/ref 17592186130352 :tutorial/content "You may have noticed that if $\\lambda$ is a complex eigenvalue of a real matrix $A,$ then the complex conjugate $\\overline{\\lambda}$ also appears to be an eigenvalue.\n\nMoreover, if the eigenvalue $\\lambda$ corresponds to an eigenvector $\\mathbb{v},$ then the eigenvalue $\\overline{\\lambda}$ corresponds to an eigenvector $\\overline{\\mathbb v}.$\n\nAs a matter of fact, this is true for all matrices with real entries:\n\nLet $A$ be a matrix with real entries. If $A$ has an eigenvector $\\mathbb v$ with eigenvalue $\\lambda,$ then $A$ also has an eigenvector $\\overline{\\mathbb v}$ with eigenvalue $\\overline{\\lambda}.$\n\nLet's prove this. If a real matrix $A$ has an eigenvalue $\\lambda$ with corresponding eigenvector $\\mathbf{v},$ then\n\n$$\nA\\mathbf{v}\t=\t\\lambda\\mathbf{v}.\n$$\n\nTaking the complex conjugate of both sides, we get\n\n$$\n\\begin{aligned}\\overset{―}{Av} & =\\overset{―}{\\lambda v} \\\\ \\overset{―}{A}\\overset{―}{v} & =\\overset{―}{\\lambda }\\overset{―}{v}.\\end{aligned}\n$$\n\nBut since $A$ is a matrix with real entries, we have that $\\overline{A} = A.$ So, we have\n\n$$\nA\\overline{\\mathbf{v}} = \\overline{\\lambda}\\overline{\\mathbf{v}}.\n$$\n\nTherefore, $\\overline{\\lambda}$ is also an eigenvalue of $A$ and its corresponding eigenvector is $\\overline{\\mathbf{v}}.$" :tutorial/id #uuid "1817745f-64ad-5793-a26e-3a333ed7c133" :tutorial/math-academy-id 3593 :tutorial/title "Complex Eigenvalues and Eigenvectors Come in Conjugate Pairs"} :step/id #uuid "9a710163-ad30-5d2e-b714-2d0b0cafeabf" :step/math-academy-id 20165 :step/next {:db/id #edb/ref 17592186130014}} {:db/id #edb/ref 17592186130013 :step/content {:db/id #edb/ref 17592186129158 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128976 :question/id #uuid "3958f8c6-0808-510b-81f5-bb82de6a203f" :question/math-academy-id "e-5904"} :knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049695} {:db/id #edb/ref 17592186050001}] :knowledge-point/questions [{:db/id #edb/ref 17592186129655} {:db/id #edb/ref 17592186129657} {:db/id #edb/ref 17592186237940} {:db/id #edb/ref 17592186237941} {:db/id #edb/ref 17592186326745} {:db/id #edb/ref 17592186326841} {:db/id #edb/ref 17592186351194} {:db/id #edb/ref 17592186351195} {:db/id #edb/ref 17592186351236} {:db/id #edb/ref 17592186351237} {:db/id #edb/ref 17592186368777}] :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"} :step/id #uuid "1fadd550-28c5-5342-b109-c56553345418" :step/math-academy-id 21687 :step/next {:db/id #edb/ref 17592186129975}} {:db/id #edb/ref 17592186130014 :step/content {:db/id #edb/ref 17592186129159 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128977 :question/id #uuid "2c47a76d-1b5d-5a10-a3c8-aff9647ca068" :question/math-academy-id "e-5905"} :knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050384}] :knowledge-point/questions [{:db/id #edb/ref 17592186129719} {:db/id #edb/ref 17592186129720} {:db/id #edb/ref 17592186237942} {:db/id #edb/ref 17592186238014} {:db/id #edb/ref 17592186238015} {:db/id #edb/ref 17592186351203} {:db/id #edb/ref 17592186351204} {:db/id #edb/ref 17592186351205} {:db/id #edb/ref 17592186430455}] :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"} :step/id #uuid "ad2fbc45-7476-5110-90c3-b3ac0aecc17c" :step/math-academy-id 21688}] :activity/title "Finding Complex Eigenvalues of Real 2x2 Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129359}]}
