      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85067-635c9190517a852be9b1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85067-635c9190517a852be9b1.png",
      "source_url": "https://mathacademy.com/tasks/14133254/topics/2835/lesson",
