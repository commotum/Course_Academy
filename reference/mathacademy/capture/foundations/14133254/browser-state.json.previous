      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85204-034ad09c30c74b51f474.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85204-034ad09c30c74b51f474.png",
      "source_url": "https://mathacademy.com/tasks/14133254/topics/2835/lesson",
      "captured_at": 1791795258.5080929,
      "math_academy_id": "q-85204",
