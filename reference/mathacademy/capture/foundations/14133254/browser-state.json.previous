mo><mi mathvariant=\"normal\">Δ</mi></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>r</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></mrow><mrow><mo stretchy=\"false\">(</mo><mi>r</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mi>r</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>r</mi><mtext>d</mtext><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msubsup><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>r</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></mrow><mrow><msup><mi>r</mi><mn>2</mn></msup><mo stretchy=\"false\">(</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
