      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85177-19bde3ba176c7d126b67.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14133254/observations/step-q85177-19bde3ba176c7d126b67.png",
      "source_url": "https://mathacademy.com/tasks/14133254/topics/2835/lesson",
      "captured_at": 1791795163.8493643,
      "math_academy_id": "q-85177",
      "topic_id": "2835",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q85177",
        "placement_id": null,
        "content_id": null,
        "type": null
