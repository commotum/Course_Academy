280892 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280892 #edb/ref 1078 #edb/ref 17592186279462 #edb/ref 17592186045417] [17592186280892 #edb/ref 1079 #uuid "2384f8d6-605a-5711-a7e5-c29c9b3f7d66" #edb/ref 17592186045417] [17592186280992 #edb/ref 1075 #edb/ref 17592186278964 #edb/ref 17592186045417] [17592186280992 #edb/ref 1075 #edb/ref 17592186279060 #edb/ref 17592186045417] [17592186280992 #edb/ref 1075 #edb/ref 17592186279269 #edb/ref 17592186045417] [17592186280992 #edb/ref 1075 #edb/ref 17592186279698 #edb/ref 17592186045417] [17592186280992 #edb/ref 1075 #edb/ref 17592186280542 #edb/ref 17592186045417] [17592186280992 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280992 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280992 #edb/ref 1078 #edb/ref 17592186278964 #edb/ref 17592186045417] [17592186280992 #edb/ref 1079 #uuid "5c6589ef-e870-5ba4-8f44-69c9d5eac8cd" #edb/ref 17592186045417] [17592186281596 #edb/ref 1068 #edb/ref 17592186280879 #edb/ref 17592186045417] [17592186281596 #edb/ref 1069 "q-163090" #edb/ref 17592186045417] [17592186281596 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281596 #edb/ref 1071 "For the function of two variables \n$f(x,y)=\\operatorname{sin}⁡({x}^{2}-2y),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=ay+b{x}^{2}.\n$$\n\nFind the value of $a+b.$" #edb/ref 17592186045417] [17592186281596 #edb/ref 1072 #uuid "c9afa446-cb01-5bd4-8e1a-c029b95460d7" #edb/ref 17592186045417] [17592186281596 #edb/ref 1074 "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =0.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =2x\\operatorname{cos}⁡({x}^{2}-2y), & \\,{f}_{y}(x,y) & =-2\\operatorname{cos}⁡({x}^{2}-2y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =-2\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =2\\operatorname{cos}⁡({x}^{2}-2y)-4{x}^{2}\\operatorname{sin}⁡({x}^{2}-2y), & \\,{f}_{xx}(0,0) & =2 \\\\ {f}_{xy}(x,y) & =4x\\operatorname{sin}⁡({x}^{2}-2y), & \\,{f}_{xy}(0,0) & =0 \\\\ {f}_{yy}(x,y) & =-4\\operatorname{sin}⁡({x}^{2}-2y), & \\,{f}_{yy}(0,0) & =0\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈0+0\\cdot x+(-2)\\cdot y+\\frac{1}{2}(2\\cdot {x}^{2}+2(0)\\cdot xy+0\\cdot {y}^{2}) \\\\  & =(-2)y+1{x}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=-2+1=-1.\n$$" #edb/ref 17592186045417] [17592186281603 #edb/ref 1068 #edb/ref 17592186280892 #edb/ref 17592186045417] [17592186281603 #edb/ref 1069 "q-163104" #edb/ref 17592186045417] [17592186281603 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281603 #edb/ref 1071 "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x,y)=(x-y)^{3},\n$$\n\nthe quadratic Taylor polynomial of $f$ about $a=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ is given by\n\n$$\nf(x,y)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}{[\\begin{aligned}∗ \\\\ y-1\\end{aligned}]}^{T}[\\begin{aligned}-6 & ∗ \\\\ 6 & -6\\end{aligned}][\\begin{aligned}x \\\\ ∗\\end{aligned}].\n$$\n\nFind the sum of the three missing expressions." #edb/ref 17592186045417] [17592186281603 #edb/ref 1072 #uuid "b07db089-383d-5673-822f-6a5d7846d04c" #edb/ref 17592186045417] [17592186281603 #edb/ref 1074 "Suppose that the function $f:{R}^{n}\\to R$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶z\n$$\n\n \n\nand is twice differentiable at $x=a.$ Then, the quadratic Taylor polynomial of $f$ about $a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere\n\n$$\n{f}^{′}(a)={[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have the following:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}], & \\,{f}^{″}(x) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]\\end{aligned}\n$$\n\nCalculating the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =[\\begin{aligned}3(x-y)^{2} & -3(x-y)^{2}\\end{aligned}].\\end{aligned}\n$$\n\nCalculating the second derivative, we have the following:\n\n$$\n\\begin{aligned}{f}^{″}(x) & =[\\begin{aligned}6(x-y) & -6(x-y) \\\\ -6(x-y) & 6(x-y)\\end{aligned}] \\\\ {f}^{″}(0,1) & =[\\begin{aligned}-6 & 6 \\\\ 6 & -6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}{[\\begin{aligned}x \\\\ y-1\\end{aligned}]}^{T}[\\begin{aligned}-6 & 6 \\\\ 6 & -6\\end{aligned}][\\begin{aligned}x \\\\ y-1\\end{aligned}].\n$$\n\nFinally, the sum of the missing expressions is\n\n$$\nx+6+(y-1)=x+y+5.\n$$" #edb/ref 17592186045417] [17592186281604 #edb/ref 1068 #edb/ref 17592186280992 #edb/ref 17592186045417] [17592186281604 #edb/ref 1069 "q-163111" #edb/ref 17592186045417] [17592186281604 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281604 #edb/ref 1071 "For the function of two variables \n$f(x,y)=\\operatorname{ln}⁡(x-y+1),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=ax-y-\\frac{1}{2}{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" #edb/ref 17592186045417] [17592186281604 #edb/ref 1072 #uuid "46cd9f15-1dee-5aee-b3d9-70903f558ae8" #edb/ref 17592186045417] [17592186281604 #edb/ref 1074 "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =0.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{1}{x-y+1}, & \\,{f}_{y}(x,y) & =-\\frac{1}{x-y+1} \\\\ {f}_{x}(0,0) & =1, & \\,{f}_{y}(0,0) & =-1\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-\\frac{1}{(x-y+1)^{2}}, & \\,{f}_{xx}(0,0) & =-1 \\\\ {f}_{xy}(x,y) & =\\frac{1}{(x-y+1)^{2}}, & \\,{f}_{xy}(0,0) & =1 \\\\ {f}_{yy}(x,y) & =-\\frac{1}{(x-y+1)^{2}}, & \\,{f}_{yy}(0,0) & =-1\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈0+1\\cdot x+(-1)\\cdot y+\\frac{1}{2}(-1\\cdot {x}^{2}+2(1)\\cdot xy+(-1)\\cdot {y}^{2}) \\\\  & =1x-y-\\frac{1}{2}{x}^{2}+1xy+(-\\frac{1}{2}){y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1+1+(-\\frac{1}{2})=\\frac{3}{2}.\n$$" #edb/ref 17592186045417] [17592186367908 #edb/ref 1068 #edb/ref 17592186367909 #edb/ref 17592186045417] [17592186367908 #edb/ref 1069 "q-164862" #edb/ref 17592186045417] [17592186367908 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186367908 #edb/ref 1071 "For the twice-differentiable function $f:{R}^{3}\\to R,$ we have the following data:\n\n$$\n\\begin{aligned}f(1,1,0) & =1+e, & \\,{f}^{′}(1,1,0) & =[\\begin{aligned}1 & 1 & 2\\end{aligned}], & \\,{f}^{″}(1,1,0) & =[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 4\\end{aligned}]\\end{aligned}\n$$\n\nUse the quadratic Taylor polynomial of $f$ about $a=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$ to approximate the value of $f(2,2,2).$" #edb/ref 17592186045417] [17592186367908 #edb/ref 1072 #uuid "a2bdcbd2-3eb2-5c14-bb14-2f06b27bbd7b" #edb/ref 17592186045417] [17592186367908 #edb/ref 1074 "Suppose that the function $f:{R}^{n}\\to R$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶z\n$$\n\n \n\nand is twice differentiable at $x=a.$ Then, the quadratic Taylor polynomial of $f$ about $a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere\n\n$$\n{f}^{′}(a)={[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have $a=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],$ and the following data:\n\n$$\n\\begin{aligned}f(a) & =1+e, & \\,{f}^{′}(a) & =[\\begin{aligned}1 & 1 & 2\\end{aligned}], & \\,{f}^{″}(a) & =[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈1+e+[\\begin{aligned}1 & 1 & 2\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1 \\\\ z\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x-1 \\\\ y-1 \\\\ z\\end{aligned}]}^{T}[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1 \\\\ z\\end{aligned}]\n$$\n\nFinally, evaluating the polynomial at $x=[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(2,2,2) & ≈1+e+[\\begin{aligned}1 & 1 & 2\\end{aligned}][\\begin{aligned}2-1 \\\\ 2-1 \\\\ 2\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}2-1 \\\\ 2-1 \\\\ 2\\end{aligned}]}^{T}[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}2-1 \\\\ 2-1 \\\\ 2\\end{aligned}] \\\\  & =1+e+[\\begin{aligned}1 & 1 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}]}^{T}[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =1+e+6+\\frac{1}{2}[\\begin{aligned}1 & 1 & 2\\end{aligned}][\\begin{aligned}-1 \\\\ -1 \\\\ 8\\end{aligned}] \\\\  & =7+e+\\frac{1}{2}(14) \\\\  & =14+e.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186367909 #edb/ref 1075 #edb/ref 17592186367910 #edb/ref 17592186045417] [17592186367909 #edb/ref 1075 #edb/ref 17592186367911 #edb/ref 17592186045417] [17592186367909 #edb/ref 1075 #edb/ref 17592186367912 #edb/ref 17592186045417] [17592186367909 #edb/ref 1075 #edb/ref 17592186367913 #edb/ref 17592186045417] [17592186367909 #edb/ref 1075 #edb/ref 17592186367914 #edb/ref 17592186045417] [17592186367909 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186367909 #edb/ref 1077 "se