#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186125416} :activity/id #uuid "b63f5657-355a-5f0a-a214-2065b7a76d74" :activity/scope {:db/id #edb/ref 17592186050470 :topic/id #uuid "4c435cda-6bf3-50f8-af96-25002a1726eb" :topic/math-academy-id 1966} :activity/steps [{:db/id #edb/ref 17592186125416 :step/content {:db/id #edb/ref 17592186125789 :tutorial/content "The **invertible matrix theorem in terms of eigenvalues** states the following:\n\n*An $n \\times n$ matrix $A$ is invertible if and only if $0$ is not an eigenvalue of $A.$* \n\nAs a result, $\\lambda=0$ should not be a solution to the corresponding characteristic equation. \n\nFor example, if we are given that\n\n$$\n\\lambda^3-\\lambda^2-2\\lambda=0\n$$\n\nis the characteristic equation of a $3 \\times 3$ matrix $A,$ then $A$ must be singular (not invertible) since $\\lambda=0$ is a root of the equation." :tutorial/id #uuid "1e561ab8-38f8-5ec1-a285-6559f35aa7cb" :tutorial/math-academy-id 3569 :tutorial/title "Introduction"} :step/id #uuid "babad562-3d88-57e5-a6c7-a8b53bec4956" :step/math-academy-id 20109 :step/next {:db/id #edb/ref 17592186125417}} {:db/id #edb/ref 17592186125417 :step/content {:db/id #edb/ref 17592186124528 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124337 :question/id #uuid "efccacfd-9595-5315-86c7-de9fefd8ed1f" :question/math-academy-id "e-5497"} :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050376}] :knowledge-point/questions [{:db/id #edb/ref 17592186125071} {:db/id #edb/ref 17592186125076} {:db/id #edb/ref 17592186272158} {:db/id #edb/ref 17592186272159} {:db/id #edb/ref 17592186323919} {:db/id #edb/ref 17592186362244} {:db/id #edb/ref 17592186380325} {:db/id #edb/ref 17592186478441}] :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues"} :step/id #uuid "46208d38-6fce-5121-8f5a-512e318a7731" :step/ma