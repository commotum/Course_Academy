f 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452447} {:answer/id #uuid "c29be87d-ebc5-57fb-9a6d-2a010829060a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452448}] :answer-field/correct {:answer/id #uuid "a3935095-5efb-57a9-a398-831d61d53049" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452447} :answer-field/id #uuid "78acad20-e495-541a-94b6-43117568da9f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1b3df2e-4878-5f07-9682-4c09eb922bca" :question/math-academy-id "q-97945" :question/problem "If $A$ is a $3\\times 3$ matrix and $\\lambda =-1$ is an eigenvalue of $A,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(A+I)x=0$ has a nonzero solution\n- **II.** $\\text{rank}(A+I)=3$\n- **III.** $\\text{Null}(A+I)={0}$" :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=A+I.$\n\n- Statement I is true. Notice that if $\\lambda =-1$ is an eigenvalue of $A,$ then the nonzero solutions of $(A+I)x=0$ are eigenvectors of $A.$ As a result, the matrix $M=A+I$ must be singular.\n\n- Statements II and III are false. Since $M=A+I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{rank}(A+I)\\ne 3,\n$$\n\nand\n\n$$\n\\text{Null}(A+I)\\ne {0}.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186362252 :knowledge-point/_questions [{:db/id #edb/ref 17592186124605 :knowledge-point/id #uuid "c34e7d59-6bb4-5c2f-808f-212503d55338" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9837a523-42e0-533a-a0dd-b42b2ad407d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452461} {:answer/id #uuid "7952bb3e-1500-544d-a00b-8d59f4c87d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452462}] :answer-field/correct {:answer/id #uuid "7952bb3e-1500-544d-a00b-8d59f4c87d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452462} :answer-field/id #uuid "6f4c341a-3666-5cd8-9f18-b1da0ee0573a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453078} {:answer-field/choices [{:answer/id #uuid "bdeda81d-4c04-5009-bc27-1a8a0454cebb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452463} {:answer/id #uuid "da0e6b14-88e6-54aa-ad41-1dba2bdc0fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452464}] :answer-field/correct {:answer/id #uuid "da0e6b14-88e6-54aa-ad41-1dba2bdc0fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452464} :answer-field/id #uuid "d4c6c176-24dd-5b33-9a18-8161ff08d029" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453079} {:answer-field/choices [{:answer/id #uuid "288f57ed-f71f-52e4-aa4d-9812c1e3a401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452465} {:answer/id #uuid "9f0d6501-f9de-5629-932b-a57f8dc171b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452466}] :answer-field/correct {:answer/id #uuid "288f57ed-f71f-52e4-aa4d-9812c1e3a401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452465} :answer-field/id #uuid "ce30fe09-518e-5ee9-b44b-912d5a059e61" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1c970e5-75bc-5ce7-946f-a4ae8b32b111" :question/math-academy-id "q-97960" :question/problem "If $C$ is a $2\\times 2$ matrix and $\\lambda =1$ is an eigenvalue of $C,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $C-I$ is a singular matrix\n- **II.** $\\text{rank}(C-I)\\ne 2$\n- **III.** $\\text{nullity}(C-I)=0$" :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=C-I.$\n\n- Statement I is true. Notice that if $\\lambda =1$ is an eigenvalue of $C,$ then the nonzero solutions of $(C-I)x=0$ are eigenvectors of $C.$ As a result, the matrix $M=C-I$ must be singular.\n\n- Statement II is true. Since $M=C-I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{rank}(C-I)\\ne 2.\n$$\n\n- Statement III is false. Since $M=C-I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{nullity}(C-I)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186362254 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2cedf5f-ea78-598b-8fea-86eb4930a16e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452473} {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474}] :answer-field/correct {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474} :answer-field/id #uuid "6ed2e22e-171c-554d-a637-c726d3aaa309" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453084} {:answer-field/choices [{:answer/id #uuid "941dacde-a17c-5765-910f-5bc4839a1386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452475} {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476}] :answer-field/correct {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476} :answer-field/id #uuid "611e09b5-b47a-5519-9300-6bc0ece8a2f0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453085} {:answer-field/choices [{:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} {:answer/id #uuid "4200c14b-bbe6-5725-adaa-903da877df9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452478}] :answer-field/correct {:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} :answer-field/id #uuid "2ef6a8d9-228c-5e0b-8e7a-462c8a409290" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453086}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "651bcec7-c2ce-52d1-b1e2-d8f7e6384008" :question/math-academy-id "q-97969" :question/problem "If $A$ is a $4\\times 4$ matrix and $\\text{rank}(A-3I)=4,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{nullity}(A-3I)=0$\n- **II.** $A-3I$ is invertible\n- **III.** $\\lambda =3$ is an eigenvalue of $A$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $4$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=4.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(A-3I) & =4-\\text{rank}(A-3I) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$\n\n- Statements II is true. By the invertible matrix theorem, since $\\text{nullity}(A-3I)=0,$ we obtain that $A-3I$ must be invertible.\n\n- Statement III is false. Notice that if $M=A-3I$ is invertible, then $(A-3I)x=0$ has only zero solution. As a result, $\\lambda =3$ can not be an eigenvalue of $A.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186362257 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4ccb0fb-57b3-54cc-9a0e-7b3b2ec086c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452491} {:answer/id #uuid "bb0736bf-0992-5540-92e4-4db3dc860d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452492}] :answer-field/correct {:answer/id #uuid "c4ccb0fb-57b3-54cc-9a0e-7b3b2ec086c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452491} :answer-field/id #uuid "a7a2ad23-7a6f-5d92-beff-9522a7a1c6e4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453093} {:answer-field/choices [{:answer/id #uuid "f4c9d99e-8bcf-530d-a35b-845c74343724" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452493} {:answer/id #uuid "b94d0759-6f74-5338-954d-fc2d4ed8aa4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452494}] :answer-field/correct {:answer/id #uuid "b94d0759-6f74-5338-954d-fc2d4ed8aa4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452494} :answer-field/id #uuid "eabb1107-ac4d-5f76-9ad8-0708cf4bdbd2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453094} {:answer-field/choices [{:answer/id #uuid "aee5ed75-acac-56ef-98ed-57d5822de8c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452495} {:answer/id #uuid "537989db-6a16-5fcc-aa37-3d4aa93c947c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452496}] :answer-field/correct {:answer/id #uuid "537989db-6a16-5fcc-aa37-3d4aa93c947c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452496} :answer-field/id #uuid "86f83e84-79e0-5f94-a3f0-7b675d59f092" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453095}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "68bc418d-6421-5050-b933-2a80a591867e" :question/math-academy-id "q-97975" :question/problem "If $C$ is a $4\\times 4$ matrix and $\\text{rank}(C+3I)=2,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{Null}(C+3I)={0}$\n- **II.** $C+3I$ is singular\n- **III.** $\\lambda =-3$ is an eigenvalue of $C$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $4$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=4.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(C+3I) & =4-\\text{rank}(C+3I) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$\n\nAs a result, $\\text{Null}(C+3I)\\ne {0}.$\n\n- Statements II is true. By the invertible matrix theorem, since $\\text{nullity}(C+3I)\\ne 0,$ we obtain that $C-3I$ must be singular.\n\n- Statement III is true. Notice that if $M=C+3I$ is singular, then $(C+3I)x=0$ has nonzero solutions which will be eigenvectors of $C.$ As a result, $\\lambda =-3$ is an eigenvalue of $C.$\n\nTherefore, the correct answer is \"II and III only.\""}]}
