92186045443] [17592186229183 #edb/ref 1038 #edb/ref 17592186539460 #edb/ref 17592186045443] [17592186229183 #edb/ref 1038 #edb/ref 17592186539462 #edb/ref 17592186045443] [17592186229183 #edb/ref 1039 "Determining an Amount at an Overflow Point" #edb/ref 17592186045417] [17592186229183 #edb/ref 1040 #edb/ref 17592186539463 #edb/ref 17592186045443] [17592186229183 #edb/ref 1041 #edb/ref 17592186228931 #edb/ref 17592186045417] [17592186229183 #edb/ref 1042 #uuid "c652164a-2e94-5e16-a410-5143037af134" #edb/ref 17592186045417] [17592186229261 #edb/ref 1043 #edb/ref 17592186230082 #edb/ref 17592186045417] [17592186229261 #edb/ref 1043 #edb/ref 17592186230083 #edb/ref 17592186045417] [17592186229261 #edb/ref 1043 #edb/ref 17592186230084 #edb/ref 17592186045417] [17592186229261 #edb/ref 1043 #edb/ref 17592186230085 #edb/ref 17592186045417] [17592186229261 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186229261 #edb/ref 1045 "Modeling Mixture Problems With First-Order Linear ODEs" #edb/ref 17592186045417] [17592186229261 #edb/ref 1046 #edb/ref 17592186230082 #edb/ref 17592186045417] [17592186229261 #edb/ref 1049 #edb/ref 17592186049774 #edb/ref 17592186045417] [17592186229261 #edb/ref 1050 1500.0 #edb/ref 17592186045417] [17592186229261 #edb/ref 1053 #uuid "51694459-f27a-580f-878c-371665540655" #edb/ref 17592186045417] [17592186230082 #edb/ref 1058 #edb/ref 17592186230083 #edb/ref 17592186045417] [17592186230082 #edb/ref 1061 601750 #edb/ref 17592186045417] [17592186230082 #edb/ref 1062 #uuid "70852def-fb14-50cc-b88d-6fe2af2343bf" #edb/ref 17592186045417] [17592186230082 #edb/ref 1063 #edb/ref 17592186230205 #edb/ref 17592186045417] [17592186230083 #edb/ref 1058 #edb/ref 17592186230084 #edb/ref 17592186045417] [17592186230083 #edb/ref 1061 601751 #edb/ref 17592186045417] [17592186230083 #edb/ref 1062 #uuid "844e4313-21e2-55d1-b55c-10160b652b89" #edb/ref 17592186045417] [17592186230083 #edb/ref 1063 #edb/ref 17592186229181 #edb/ref 17592186045417] [17592186230084 #edb/ref 1058 #edb/ref 17592186230085 #edb/ref 17592186045417] [17592186230084 #edb/ref 1061 601754 #edb/ref 17592186045417] [17592186230084 #edb/ref 1062 #uuid "926db8f3-a67c-5f3b-9bd8-4eaeaa70c7cf" #edb/ref 17592186045417] [17592186230084 #edb/ref 1063 #edb/ref 17592186229182 #edb/ref 17592186045417] [17592186230085 #edb/ref 1061 601757 #edb/ref 17592186045417] [17592186230085 #edb/ref 1062 #uuid "ff264ca2-0325-5ecb-9be4-8cbee9d9ba83" #edb/ref 17592186045417] [17592186230085 #edb/ref 1063 #edb/ref 17592186229183 #edb/ref 17592186045417] [17592186230205 #edb/ref 1064 "In the previous lesson, we focused on dilution problems in which the incoming solution contained none of the substance being modeled. In those cases, the rate at which the substance entered the container was zero.\n\nIn many practical situations, however, the incoming solution *does* contain some amount of the substance. When this happens,\n\n- the rate of entry is no longer zero, and\n\n- the resulting differential equation takes the form of a first-order linear differential equation.\n\nFor example, suppose a storage tank initially holds $650\\,\\textrm{L}$ of water containing $1\\,300\\,\\textrm{g}$ of dissolved chlorine.\n\n- A solution containing $20\\,\\textrm{g/L}$ of dissolved chlorine is pumped into the tank at a rate of $5\\,\\textrm{L/min}.$\n\n- At the same time, the completely mixed water is drained out at a rate of $5\\,\\textrm{L/min}.$\n\nTo construct the model for the amount of chlorine $Q$ in the tank, we compare the rates of chlorine entering and leaving. The derivative \n$\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t}$\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which chlorine enters the tank minus the rate at which chlorine leaves the tank.\n\n$$\n\\bbox[4pt,border: 1px solid lightgray]{\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_{\\textrm{in}} - Q'_{\\textrm{out}}}\n$$\n\nWe compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which chlorine enters the tank.\n\nThe rate of chlorine entering is the concentration times the flow rate:\n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(20\\,\\frac{\\text{g}}{\\text{L}})\\cdot (5\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(20\\,\\frac{\\text{g}}{\\cancel{\\text{L}}})\\cdot (5\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =100\\,\\frac{\\text{g}}{\\text{min}}\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which chlorine exits the tank.\n\nSince the volume remains constant at $650\\,\\textrm{L},$ the concentration in the tank is $\\dfrac{Q}{650}\\,\\dfrac{\\textrm{g}}{\\textrm{L}}.$ So, the rate of chlorine exiting is\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(5\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{650}\\,\\frac{\\text{g}}{\\text{L}}) \\\\  & =(5\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{650}\\,\\frac{\\text{g}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{Q}{130}\\,\\frac{\\text{g}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe net rate of change $\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = Q'_\\text{in} - Q'_\\text{out}$ is the difference between the rate in and the rate out. Combining this with the initial condition $Q(0) = 1\\,300\\,\\textrm{g},$ we can state the complete initial value problem:\n\n$$\n\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} = 100 - \\dfrac{1}{130}Q\n\\quad\\Longrightarrow\\quad\n\\bbox[4pt,border: 1px solid lightgray]{\\dfrac{\\mathrm{d}Q}{\\mathrm{d}t} + \\dfrac{1}{130}Q = 100, \\quad Q(0) = 1\\,300\\,\\textrm{g}}\n$$" #edb/ref 17592186045417] [17592186230205 #edb/ref 1065 14578 #edb/ref 17592186045417] [17592186230205 #edb/ref 1066 #uuid "fc8b0fc6-c25c-50f5-adbd-028adf7c6698" #edb/ref 17592186045417] [17592186230205 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186377249 #edb/ref 1068 #edb/ref 17592186377250 #edb/ref 17592186045417] [17592186377249 #edb/ref 1069 "q-336743" #edb/ref 17592186045417] [17592186377249 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186377249 #edb/ref 1071 "A processing tank initially holds $420\\,\\text{L}$ of liquid containing $10\\,\\text{kg}$ of dissolved preservative.\nA feed solution containing $0.05\\,\\text{kg/L}$ of the preservative is pumped into the tank at a rate of $18\\,\\text{L/min},$ while the completely mixed liquid is drained out at a rate of $12\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of preservative in the tank $15$ minutes after pumping begins." #edb/ref 17592186045417] [17592186377249 #edb/ref 1072 #uuid "01365019-dd55-56aa-aa06-e538a69722fd" #edb/ref 17592186045417] [17592186377249 #edb/ref 1074 "Let $Q$ be the amount of preservative in the tank at time $t,$ in minutes. Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t.$ This is equal to the rate at which preservative enters the tank minus the rate at which preservative leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which preservative enters the tank.\n\nNote that a feed solution containing $0.05\\,\\text{kg/L}$ of the preservative enters the tank at a rate of $18\\,\\text{L/min}.$ So, the rate at which the *preservative* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.05\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (18\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0.05\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (18\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0.9\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which preservative exits the tank.\n\nTo find the rate at which preservative leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $420\\,\\text{L}$ of liquid; a solution enters at $18\\,\\text{L/min}$ and leaves at $12\\,\\text{L/min}.$\nAs a result, the volume of liquid in the tank after $t$ minutes is \n\n$$\n420+18t-12t=(420+6t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of preservative in the tank, the *concentration* of the mixed solution at time $t$ is\n\n$$\n\\frac{Q}{420+6t}\\,\\text{kg/L}.\n$$\n\nTherefore, as the completely mixed liquid leaves at a rate of $12\\,\\text{L/min},$ *preservative* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(12\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{420+6t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(12\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{420+6t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{12Q}{420+6t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{2Q}{70+t}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0.9-\\frac{2Q}{70+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\begin{aligned}\\frac{dQ}{dt}+\\frac{2}{70+t}Q=0.9.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(70+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|70+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(70+t)^{2}} \\\\  & =(70+t)^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(70+t)^{2}$ yields\n\n$$\n\\begin{aligned}(70+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{70+t}Q) & =(70+t)^{2}\\cdot 0.9 \\\\ (70+t)^{2}\\frac{dQ}{dt}+2(70+t)Q & =0.9(70+t)^{2} \\\\ \\frac{d}{dt}(Q(70+t)^{2}) & =0.9(70+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(70+t)^{2})\\,dt & =\\int 0.9(70+t)^{2}\\,dt \\\\ Q(70+t)^{2} & =0.9\\cdot \\frac{1}{3}(70+t)^{3}+C \\\\ Q(t) & =0.3(70+t)+\\frac{C}{(70+t)^{2}}\\end{aligned}\n$$\n\nNote that $C$ is a constant of integration.\n\nWe're told that the tank initially contains $10\\,\\text{kg}$ of preservative. So, we can apply the initial condition $Q(0)=10,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =10 \\\\ 0.3(70+0)+\\frac{C}{(70+0)^{2}} & =10 \\\\ 21+\\frac{C}{{70}^{2}} & =10 \\\\ \\frac{C}{{70}^{2}} & =-11 \\\\ C & =-11(70)^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =0.3(70+t)-\\frac{11(70)^{2}}{(70+t)^{2}} \\\\  & =0.3(70+t)-11{(\\frac{70}{70+t})}^{2}.\\end{aligned}\n$$\n\nFinally,  the amount of preservative in the tank $15$ minutes after pumping begins is\n\n$$\n\\begin{aligned}Q(15) & =0.3(70+15)-11{(\\frac{70}{70+15})}^{2} \\\\  & =25.5-11{(\\frac{70}{85})}^{2} \\\\  & ≈18.04\\,\\text{kg},\\end{aligned}\n$$\n\nrounded to two decimal places." #edb/ref 17592186045417] [17592186377250 #edb/ref 1075 #edb/ref 17592186377251 #edb/ref 17592186045417] [17592186377250 #edb/ref 1075 #edb/ref 17592186377252 #edb/ref 17592186045417] [17592186377250 #edb/ref 1075 #edb/ref 17592186377253 #edb/ref 17592186045417] [17592186377250 #edb/ref 1075 #edb/ref 17592186377254 #edb/ref 17592186045417] [17592186377250 #edb/ref 1075 #edb/ref 17592186377255 #edb/ref 17592186045417] [17592186377250 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186377250 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186377250 #edb/ref 1078 #edb/ref 17592186377253 #edb/ref 17592186045417] [17592186377250 #edb/ref 1079 #uuid "753683c1-dfc0-5785-8a4b-d335ca58b088" #edb/ref 17592186045417] [17592186377251 #edb/ref 1080 "17.34\\,\\text{kg}" #edb/ref 17592186045417] [17592186377251 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186377251 #edb/ref 1083 #uuid "5a3f26d4-7fd0-5dfc-b30a-66eaf31e8b97" #edb/ref 17592186045417] [17592186377252 #edb/ref 1080 "17.94\\,\\text{kg}" #edb/ref 17592186045417] [17592186377252 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186377252 #edb/ref 1083 #uuid "59e1559d-1a25-5f5b-86a0-b44ad480a144" #edb/ref 17592186045417] [17592186377253 #edb/ref 1080 "18.04\\,\\text{kg}" #edb/ref 17592186045417] [17592186377253 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186377253 #edb/ref 1083 #uuid "6884f190-c170-5c58-85a7-6a4669b950fa" #edb/ref 17592186045417] [17592186377254 #edb/ref 1080 "18.42\\,\\text{kg}" #edb/ref 17592186045417] [17592186377254 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186377254 #edb/ref 1083 #uuid "3dca446e-f8bb-5a17-9561-bc2230c8306c" #edb/ref 17592186045417] [17592186377255 #edb/ref 1080 "19.01\\,\\text{kg}" #edb/ref 17592186045417] [17592186377255 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186377255 #edb/ref 1083 #uuid "9010ad44-b315-5215-8406-035745dd6ad7" #edb/ref 17592186045417] [17592186385208 #edb/ref 1068 #edb/ref 17592186385209 #edb/ref 17592186045417] [17592186385208 #edb/ref 1069 "q-336501" #edb/ref 17592186045417] [17592186385208 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186385208 #edb/ref 1071 "A dye mixing tank at a textile factory can hold up to $180\\,\\text{gal}$ of liquid. Initially, it contains $100\\,\\text{gal}$ of solution with $20\\,\\text{lb}$ of dissolved dye. A more concentrated dye solution with concentration $0.6\\,\\text{lb/gal}$ flows into the tank at a rate of $15\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $10\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of dye in the tank at the moment it begins to overflow." #edb/ref 17592186045417] [17592186385208 #edb/ref 1072 #uuid "3c6933cf-ef37-5bf5-8816-b51b8e56e9df" #edb/ref 17592186045417] [17592186385208 #edb/ref 1074 "Since $Q$ is the amount of dye in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which dye enters the tank minus the rate at which dye leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which dye enters the tank.\n\nFirst, note that a solution containing $0.6\\,\\text{lb/gal}$ of dye enters the tank at a rate of $15\\,\\text{gal/min}.$ So, the rate at which the *dye* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0.6\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (15\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0.6\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (15\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =9\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which dye exits the tank.\n\nTo find the rate at which dye leaves the tank, we must first determine the volume of liquid in the tank at time $t.$\n\nThe tank initially contains $100\\,\\text{gal}$ of liquid; solution enters at $15\\,\\text{gal/min}$ and mixed solution leaves at $10\\,\\text{gal/min}.$\nAs a result, the amount of liquid in the tank after $t$ minutes is \n\n$$\nV(t)=100+15t-10t=5(20+t)\\,\\text{gal}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of dye in the tank, the concentration of the solution at time $t$ is\n\n$$\n\\frac{Q}{5(20+t)}\\,\\text{lb/gal}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $10\\,\\text{gal/min},$ *dye* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(10\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{5(20+t)}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(10\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{5(20+t)}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{10Q}{5(20+t)}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{20+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =9-\\frac{2Q}{20+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}+\\frac{2}{20+t}\\,Q=9.\n$$\n\n**Step 4**: Integrate the equation.\n\nThis is a first-order linear equation with variable coefficients. So we find the general solution using an integrating factor:\n\n$$\n\\begin{aligned}I(t) & ={e}^{\\int 2/(20+t)\\,dt} \\\\  & ={e}^{2\\operatorname{ln}⁡|20+t|} \\\\  & ={e}^{\\operatorname{ln}⁡(20+t)^{2}} \\\\  & =(20+t)^{2}.\\end{aligned}\n$$\n\nMultiplying both sides of the differential equation by $I(t)=(20+t)^{2}$ yields\n\n$$\n\\begin{aligned}(20+t)^{2}\\cdot (\\frac{dQ}{dt}+\\frac{2}{20+t}\\,Q) & =(20+t)^{2}\\cdot 9 \\\\ (20+t)^{2}\\frac{dQ}{dt}+2(20+t)Q & =9(20+t)^{2} \\\\ \\frac{d}{dt}(Q(20+t)^{2}) & =9(20+t)^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $t:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dt}(Q(20+t)^{2})\\,dt & =\\int 9(20+t)^{2}\\,dt \\\\ Q(20+t)^{2} & =9\\cdot \\frac{1}{3}(20+t)^{3}+C \\\\ Q(t) & =3(20+t)+\\frac{C}{(20+t)^{2}}.\\end{aligned}\n$$\n\nWe're told that the tank initially contains $20\\,\\text{lb}$ of dye. So, we can apply the initial condition $Q(0)=20,$ and solve for $C:$\n\n$$\n\\begin{aligned}Q(0) & =20 \\\\ 3(20+0)+\\frac{C}{(20+0)^{2}} & =20 \\\\ 60+\\frac{C}{(20)^{2}} & =20 \\\\ \\frac{C}{(20)^{2}} & =-40 \\\\ C & =-40(20)^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =3(20+t)-\\frac{40(20)^{2}}{(20+t)^{2}} \\\\  & =3(20+t)-40{(\\frac{20}{20+t})}^{2}.\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $180\\,\\text{gal},$ so we can use the condition $V({t}_{o})=180$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =180 \\\\ 100+15{t}_{o}-10{t}_{o} & =180 \\\\ 100+5{t}_{o} & =180 \\\\ 5{t}_{o} & =80 \\\\ {t}_{o} & =16\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, rounded to one decimal place, the amount of dye in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(16) & =3(20+16)-40{(\\frac{20}{20+16})}^{2} \\\\  & =108-40{(\\frac{20}{36})}^{2} \\\\  & ≈95.7\\,\\text{lb}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186385209 #edb/ref 1075 #edb/ref 17592186385210 #edb/ref 17592186045417] [17592186385209 #edb/ref 1075 #edb/ref 17592186385211 #edb/ref 17592186045417] [17592186385209 #edb/ref 1075 #edb/ref 17592186385212 #edb/ref 17592186045417] [17592186385209 #edb/ref 1075 #edb/ref 17592186385213 #edb/ref 17592186045417] [17592186385209 #edb/ref 1075 #edb/ref 17592186385214 #edb/ref 17592186045417] [17592186385209 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186385209 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186385209 #edb/ref 1078 #edb/ref 17592186385212 #edb/ref 17592186045417] [17592186385209 #edb/ref 1079 #uuid "711b7022-c824-5eae-90a8-e7d790b19008" #edb/ref 17592186045417] [17592186385210 #edb/ref 1080 "95.2\\,\\text{lb}" #edb/ref 17592186045417] [17592186385210 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186385210 #edb/ref 1083 #uuid "635d2341-3a33-5ac9-bc90-9aa868281876" #edb/ref 17592186045417] [17592186385211 #edb/ref 1080 "96.1\\,\\text{lb}" #edb/ref 17592186045417] [17592186385211 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186385211 #edb/ref 1083 #uuid "923fae5f-f36e-59d7-a2f9-4b1a32154401" #edb/ref 17592186045417] [17592186385212 #edb/ref 