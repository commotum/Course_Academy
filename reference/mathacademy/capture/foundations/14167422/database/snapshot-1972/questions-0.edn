#{[{:db/id #edb/ref 17592186088039 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d671fb-06b5-5b66-9d46-72466f54e2d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,2)" :db/id #edb/ref 17592186281695} {:answer/id #uuid "112771dc-8b8b-5e3d-9729-617f7ca88db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186281848} {:answer/id #uuid "1127f80d-1e75-5c42-bc23-c285c4938a0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186281849} {:answer/id #uuid "2ed5559e-b4f2-5eba-87fc-9e47294ceb29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186282104} {:answer/id #uuid "8707cf51-9910-5fb3-8701-be3b871e2623" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-2)" :db/id #edb/ref 17592186282855}] :answer-field/correct {:answer/id #uuid "2ed5559e-b4f2-5eba-87fc-9e47294ceb29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186282104} :answer-field/id #uuid "b8c90160-391d-5cc4-8bbb-c0ccdc5ff6b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec2c80f9-6d60-5c98-a90e-0bf456ed1faa" :question/math-academy-id "q-16461" :question/problem "What is the center of the ellipse $\\frac{(x-1)^{2}}{8}+\\frac{(y+2)^{2}}{4}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=1$ and $k=-2,$ so the center is located at $(1,-2).$"}] [{:db/id #edb/ref 17592186421173 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003a3cdb-6961-5ffb-8ced-5a7eeb3a8d25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{4}+\\frac{(y+1)^{2}}{16}=1" :db/id #edb/ref 17592186421156} {:answer/id #uuid "508479a4-483b-5088-be5e-ede9dc4e14b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y-1)^{2}}{16}=1" :db/id #edb/ref 17592186421158} {:answer/id #uuid "7bbf5087-ef93-51b0-81af-75c679128295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{4}+\\frac{(y-1)^{2}}{16}=1" :db/id #edb/ref 17592186421163} {:answer/id #uuid "ca0d327d-d188-553c-8472-29849d799fd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{16}+\\frac{(y-1)^{2}}{4}=1" :db/id #edb/ref 17592186421168} {:answer/id #uuid "ee690150-4af4-5958-b6ba-047a5cc3a472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{16}+\\frac{(y+1)^{2}}{4}=1" :db/id #edb/ref 17592186421170}] :answer-field/correct {:answer/id #uuid "508479a4-483b-5088-be5e-ede9dc4e14b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y-1)^{2}}{16}=1" :db/id #edb/ref 17592186421158} :answer-field/id #uuid "2702a648-2e03-505a-be81-cc9395ed7417" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421171}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b363072-76f6-5390-bc66-85c8817596a8" :question/math-academy-id "q-16554" :question/problem "![](images/f7/f7659f73c533e9407c14ff33f65cac776eef234fd8f696b14eed4d5d288ebab1.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(2,1),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y-1)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294963 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9e4e68f-490a-50ec-831b-a2606c9e2e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{9}+\\frac{(y-1)^{2}}{16}" :db/id #edb/ref 17592186293914}] :answer-field/correct {:answer/id #uuid "f9e4e68f-490a-50ec-831b-a2606c9e2e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{9}+\\frac{(y-1)^{2}}{16}" :db/id #edb/ref 17592186293914} :answer-field/id #uuid "a6cc6684-109c-5446-8ce1-df88d1548753" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294528}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "769c3ba1-be44-5d72-ab21-003c024cdeed" :question/math-academy-id "q-278251" :question/problem "![](images/6b/6bb7a8dc9b34c03e5456b84b843c8975aac8ec8f09135fe9069693febc24ba78.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(4,1),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-4)^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x-4)^{2}}{9}+\\frac{(y-1)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345180 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23950595-9f29-500f-bf4e-43831bca77d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186342533} {:answer/id #uuid "28577dfb-7790-5330-bf8c-3516e403f5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186342577} {:answer/id #uuid "35b91742-e45d-5346-9a77-99f89c7d0852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 1759218