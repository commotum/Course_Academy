      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224338/observations/step-q36973-8514d4677fa4d738d857.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14224338/observations/step-q36973-8514d4677fa4d738d857.png",
      "source_url": "https://mathacademy.com/tasks/14224338/topics/1977/review",
