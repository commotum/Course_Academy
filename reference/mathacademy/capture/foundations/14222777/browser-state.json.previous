<mi mathvariant=\"bold\">r</mi></mrow></mrow></mstyle></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>π</mi><mo>,</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow></mrow></msup><mo>−</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>2</mn><mi>e</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>e</mi></mfrac></mstyle><mo>−</mo><mn>2</mn><mi>e</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>1</mn><mo>−</mo><mn>2</mn><msup><mi>e</mi><mn>2</mn></msup></mrow><mi>e</mi></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
