p://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msub><mo data-mjx-texclass=\"OP\">∫</mo><mi>C</mi></msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><msub><mo data-mjx-texclass=\"OP\">∫</mo><mi>C</mi></msub><mi mathvariant=\"normal\">∇</mi><mi>f</mi><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><msup><mn>2</mn><mn>2</mn></msup><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msup><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>4</mn><mi>e</mi><mo>−</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
