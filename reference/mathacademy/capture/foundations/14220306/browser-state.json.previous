tyle=\"width: 1.47em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 1.47em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c7D TEX-S1\"></mjx-c></mjx-mo></mjx-mrow></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mo stretchy=\"false\">(</mo><mi>ρ</mi><mo>,</mo><mi>θ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>:</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>0</mn><mo>≤</mo><mi>ρ</mi><mo>≤</mo><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi></mpadded></mstyle><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mn>0</mn></mpadded></mstyle><mo>≤</mo><mi>θ</mi><mo>≤</mo><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mi>π</mi></mpadded></mstyle><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>0</mn><mo>≤</mo><mi>ϕ</mi><mo>≤</mo><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mn>2</mn><mi>π</mi></mpadded></mstyle><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow></math></mjx-assistive-mml></mjx-container>"
