wer/validate]} {:db/id "answer-71f6cba5-5871-5803-9c91-61a2cc0bba0d" :answer/id #uuid "71f6cba5-5871-5803-9c91-61a2cc0bba0d" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi /2\\le \\theta \\le 3\\pi /2,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-5218f2af-dac4-5746-8c3c-98268e589c5d" :answer/id #uuid "5218f2af-dac4-5746-8c3c-98268e589c5d" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 8,\\,\\pi /4\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le 2\\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-4d201c45-0b9a-5458-be51-83559b6c7fa0" :answer/id #uuid "4d201c45-0b9a-5458-be51-83559b6c7fa0" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{2},\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id 17592186176396 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\n![](images/e5/e5371e711515feccdaab3f6b10734fb35bb59c724fc408c8b67b4b54132136ec.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:  \n\n- $\\rho \\in [0,5]$\n\n- $\\theta \\in [0,\\pi ]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 5,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186371968 :answer-field/correct "answer-9ca9a438-788a-5b25-a87d-38318a835227" :answer-field/choices ["answer-b17869dd-a218-5ca1-b711-91b1d2c490b3" "answer-9d030973-0753-54b0-87b4-0a1ff3984ba3" "answer-2c99e65e-6e27-5a52-a1ef-c