bfdf-efed-5827-9f40-6d1768ae8a4f" :answer/id #uuid "bdcbbfdf-efed-5827-9f40-6d1768ae8a4f" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le 2\\pi \\}" :db/ensure [:answer/validate]} {:db/id 17592186281345 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\n![](images/0d/0d901312b6a14c863085276458cf8341cbd4cb6cc5411d5c5045244b8c656eb2.png)\n\n  \n\nNotice that inside our region, the spherical polar coordinates vary withing the following domains:\n\n- $\\rho \\in [0,2]$\n\n- $\\theta \\in [0,\\frac{\\pi }{2}]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186281276 :answer-field/correct "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer-field/choices ["answer-20ef2694-93c9-5433-b86a-aa9f99a0bde9" "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" "answer-4220d81b-5fee-5b30-8b21-5a4d1398318f" "answer-5962da49-0814-5ce2-838a-0da88eb72219" "answer-895ec483-a133-5e14-a169-801e1f3a0cdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-20ef2694-93c9-5433-b86a-aa9f99a0bde9" :answer/id #uuid "20ef2694-93c9-5433-b86a-aa9f99a0bde9" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi /2\\}" :db/ensure [:answer/validate]} {:db/id "answer-e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer/id #uuid "e6783016-1b3a-5048-9e49-5135f2d7cdae" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-4220d81b-5fee-5b30-8b21-5a4d1398318f" :answer/id #uuid "4220d81b-5fee-5b30-8b21-5a4d1398318f" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-5962da49-0814-5ce2-838a-0da88eb72219" :answer/id #uuid "5962da49-0814-5ce2-838a-0da88eb72219" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le 2\\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-895ec483-a133-5e14-a169-801e1f3a0cdf" :answer/id #uuid "895ec483-a133-5e14-a169-801e1f3a0cdf" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{2},\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi /2\\}" :db/ensure [:answer/validate]} {:db/id "question-1b4d1e3e-36ae-5b22-9e31-1455caee6c30" :question/id #uuid "1b4d1e3e-36ae-5b22-9e31-1455caee6c30" :question/math-academy-id "q-161852" :question/problem "![](images/b1/b15c12a1cabbab36feab2d15e1ac3d73e8d8c26afc14a8b820e2ca6f57d7d48d.png)\n\nThe solid enclosed by the sphere ${x}^{2}+{y}^{2}+{z}^{2}=2z,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $1$ centered at $(0,0,1).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=2z$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =2z \\\\ {\\rho }^{2} & =2\\rho \\operatorname{cos}⁡ϕ \\\\ \\rho (\\rho -2\\operatorname{cos}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =2\\operatorname{cos}⁡ϕ.$\n\n![](images/66/66812de081c1bbfe515162ab628806717b5602ec1a6cc61eaf22514f91e9c0ea.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,2\\rho \\operatorname{cos}⁡ϕ]$\n\n- $\\theta \\in [0,2\\pi ]$\n\n- $ϕ\\in [0,\\frac{\\pi }{2}]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2ef5564a-71c2-51d9-a5c5-1e430a20af03"] :db/ensure [:question/validate]} {:db/id "answer-field-2ef5564a-71c2-51d9-a5c5-1e430a20af03" :answer-field/id #uuid "2ef5564a-71c2-51d9-a5c5-1e430a20af03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer-field/choices ["answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" "answer-f98a9165-7703-5823-a7ab-afca420773e0" "answer-e8643e12-d858-53e7-9f58-5292e345b9fb" "answer-821c59c1-9fae-533c-87a2-1c8d423ee015" "answer-8f75f27a-bcb9-5bed-b305-7616971ca23d"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer/id #uuid "1d0452cb-7133-5cf9-bafe-72ae2c543e59" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-f98a9165-7703-5823-a7ab-afca420773e0" :answer/id #uuid "f98a9165-7703-5823-a7ab-afca420773e0" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-e8643e12-d858-53e7-9f58-5292e345b9fb" :answer/id #uuid "e8643e12-d858-53e7-9f58-5292e345b9fb" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-821c59c1-9fae-533c-87a2-1c8d423ee015" :answer/id #uuid "821c59c1-9fae-533c-87a2-1c8d423ee015" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-8f75f27a-bcb9-5bed-b305-7616971ca23d" :answer/id #uuid "8f75f27a-bcb9-5bed-b305-7616971ca23d" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186363444 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-quarter of the sphere of radius $1$ centered at $(0,0,-1).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}+2z=0$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2}+2z & =0 \\\\ {\\rho }^{2}+2\\rho \\operatorname{cos}⁡ϕ & =0 \\\\ \\rho (\\rho +2\\operatorname{cos}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-2\\operatorname{cos}⁡ϕ.$\n\n![](images/14/1499d492c526bad77e81aca1128b6160cc574a209ad7706e8d89b3012112e1df.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,-2\\operatorname{cos}⁡ϕ]$\n\n- $\\theta \\in [0,\\frac{\\pi }{2}]$\n\n- $ϕ\\in [\\frac{\\pi }{2},\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186363445 :answer-field/correct "answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer-field/choices ["answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" "answer-2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" "answer-a973e4e0-ee5f-5fc6-ab29-b94e84360208" "answer-722d91c6-40fa-56a4-867b-919bace76541" "answer-da839e87-16a6-50ac-87fc-5f547394b48e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer/id #uuid "ec725f35-2519-51f8-8cc0-4a11c90e6631" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" :answer/id #uuid "2ca9eaa8-0cf0-5859-b374-fdd5806c8ab5" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-a973e4e0-ee5f-5fc6-ab29-b94e84360208" :answer/id #uuid "a973e4e0-ee5f-5fc6-ab29-b94e84360208" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-722d91c6-40fa-56a4-867b-919bace76541" :answer/id #uuid "722d91c6-40fa-56a4-867b-919bace76541" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-da839e87-16a6-50ac-87fc-5f547394b48e" :answer/id #uuid "da839e87-16a6-50ac-87fc-5f547394b48e" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186281370 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $2$ centered at $(0,-2,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}+4y=0$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2}+4y & =0 \\\\ {\\rho }^{2}+4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & =0 \\\\ \\rho (\\rho +4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/e2/e2865e838521a8864ad76d72e520d4b128a8fceb8c18cb9c35ba10134419c4eb.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [\\pi ,2\\pi ]$\n\n- $ϕ\\in [\\frac{\\pi }{2},\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186281177 :answer-field/correct "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer-field/choices ["answer-0888c7a6-5da3-5a1f-b87d-986ab2864e10" "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" "answer-18faa7fa-7eb2-59fb-8bb6-a8207578ac26" "answer-f3af3470-369d-504e-8f80-0f77cd8a8f68" "answer-3c9d4d58-b589-531c-a608-5dd3c04d9134"] :db/ensure [:answer-field/validate]} {:db/id "answer-0888c7a6-5da3-5a1f-b87d-986ab2864e10" :answer/id #uuid "0888c7a6-5da3-5a1f-b87d-986ab2864e10" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer/id #uuid "7f98c60e-4e49-520e-a5f5-776539a57fcc" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-18faa7fa-7eb2-59fb-8bb6-a8207578ac26" :answer/id #uuid "18faa7fa-7eb2-59fb-8bb6-a8207578ac26" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-f3af3470-369d-504e-8f80-0f77cd8a8f68" :answer/id #uuid "f3af3470-369d-504e-8f80-0f77cd8a8f68" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-3c9d4d58-b589-531c-a608-5dd3c04d9134" :answer/id #uuid "3c9d4d58-b589-531c-a608-5dd3c04d9134" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186176398 :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at $(0,2,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=4y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =4y \\\\ {\\rho }^{2} & =4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/3a/3a6985012edbaf28ca42d88fd47e3769fa53704cad8f8c09021c944d966a3d48.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [0,\\pi ]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186363431 :answer-field/correct "answer-805a0a6c-588a-5652-8708-ef6f81947bad" :answer-field/choices ["answer-5088423b-db3e-54df-b831-a57602e5ebe9" "answer-bfd5bc74-b990-585b-b3cb-9771824e5c92" "answer-6bd62de5-f0c5-582e-9f22-e1174588775b" "answer-805a0a6c-588a-5652-8708-ef6f81947bad" "answer-f8e6ef4b-e544-53c2-99a8-afb161df11b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5088423b-db3e-54df-b831-a57602e5ebe9" :answer/id #uuid "5088423b-db3e-54df-b831-a57602e5ebe9" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\rho \\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-bfd5bc74-b990-585b-b3cb-9771824e5c92" :answer/id #uuid "bfd5bc74-b990-585b-b3cb-9771824e5c92" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\rho \\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-6bd62de5-f0c5-582e-9f22-e1174588775b" :answer/id #uuid "6bd62de5-f0c5-582e-9f22-e1174588775b" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-805a0a6c-588a-5652-8708-ef6f81947bad" :answer/id #uuid "805a0a6c-588a-5652-8708-ef6f81947bad" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-f8e6ef4b-e544-53c2-99a8-afb161df11b4" :answer/id #uuid "f8e6ef4b-e544-53c2-99a8-afb161df11b4" :answer/type :answer.type/math :answer/value "\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "question-a7ea971b-d67e-5a60-86aa-35a475db9053" :question/id #uuid "a7ea971b-d67e-5a60-86aa-35a475db9053" :question/math-academy-id "q-161851" :question/problem "![](images/d8/d829e8f51e5cd49bf20587f0cd70abd29a8dd1a336a6bad827541726c9cd4416.png)\n\nThe solid enclosed by the sphere ${x}^{2}+{y}^{2}+{z}^{2}=4x,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at $(2,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=4x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =4x \\\\ {\\rho }^{2} & =4\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/df/dfc7359ad44caa959459676a1e54bf1575e3c7e0f771e92a74817d9d1f9cb581.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a25a1262-2d6c-5d10-9f4a-f4ca15577a84"] :db/ensure [:question/validate]} {:db/id "answer-field-a25a1262-2d6c-5d10-9f4a-f4ca15577a84" :answer-field/id #uuid "a25a1262-2d6c-5d10-9f4a-f4ca15577a84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer-field/choices ["answer-3ac36fc6-724d-59ba-bc41-3af29a3a8de8" "answer-c9301d6b-61d0-5484-9019-19d7b668ce0f" "answer-cb387986-8ebd-5bb9-877c-9abb1c25a852" "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" "answer-a1c646fb-4131-53cd-a9c8-3a4ae803fde4"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ac36fc6-724d-59ba-bc41-3af29a3a8de8" :answer/id #uuid "3ac36fc6-724d-59ba-bc41-3af29a3a8de8" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-c9301d6b-61d0-5484-9019-19d7b668ce0f" :answer/id #uuid "c9301d6b-61d0-5484-9019-19d7b668ce0f" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le 2\\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-cb387986-8ebd-5bb9-877c-9abb1c25a852" :answer/id #uuid "cb387986-8ebd-5bb9-877c-9abb1c25a852" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer/id #uuid "ea6d2993-fd8c-52ec-92fb-7d3841d36a03" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id "answer-a1c646fb-4131-53cd-a9c8-3a4ae803fde4" :answer/id #uuid "a1c646fb-4131-53cd-a9c8-3a4ae803fde4" :answer/type :answer.type/text :answer/value "$$\n\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ,\\,-\\pi \\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}\n$$" :db/ensure [:answer/validate]} {:db/id 17592186176120 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}] "assertions" [[17592186176184 :question/worked-solution "In the picture, we are given a half-plane that passes through the $z$-axis.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nEvery point on the given plane makes an angle of $\\frac{\\pi }{3}$ radians with the positive $x$-axis. On the other hand, $\\rho $ and $ϕ$ can vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $\\theta =\\frac{\\pi }{3}.$"] [17592186176184 :question/difficulty :question.difficulty/easy] ["answer-d7436a96-8f7a-563d-8a2e-27bd76bd83af" :answer/id #uuid "d7436a96-8f7a-563d-8a2e-27bd76bd83af"] ["answer-d7436a96-8f7a-563d-8a2e-27bd76bd83af" :answer/type :answer.type/math] ["answer-d7436a96-8f7a-563d-8a2e-27bd76bd83af" :answer/value "\\theta =\\frac{\\pi }{3}"] ["answer-6d48c000-d46c-5620-896f-57c4438decc4" :answer/id #uuid "6d48c000-d46c-5620-896f-57c4438decc4"] ["answer-6d48c000-d46c-5620-896f-57c4438decc4" :answer/type :answer.type/math] ["answer-6d48c000-d46c-5620-896f-57c4438decc4" :answer/value "r=\\frac{\\pi }{3}\\theta "] ["answer-65926222-59a9-5c6b-8e18-d6118f338b81" :answer/id #uuid "65926222-59a9-5c6b-8e18-d6118f338b81"] ["answer-65926222-59a9-5c6b-8e18-d6118f338b81" :answer/type :answer.type/math] ["answer-65926222-59a9-5c6b-8e18-d6118f338b81" :answer/value "r=\\frac{\\pi }{3}ϕ"] ["answer-3ade53df-f047-5ea9-ad5f-64f2b44fc397" :answer/id #uuid "3ade53df-f047-5ea9-ad5f-64f2b44fc397"] ["answer-3ade53df-f047-5ea9-ad5f-64f2b44fc397" :answer/type :answer.type/math] ["answer-3ade53df-f047-5ea9-ad5f-64f2b44fc397" :answer/value "r=\\frac{\\pi }{4}"] ["answer-5dd7221e-4681-539c-8b73-08fedb80fbbf" :answer/id #uuid "5dd7221e-4681-539c-8b73-08fedb80fbbf"] ["answer-5dd7221e-4681-539c-8b73-08fedb80fbbf" :answer/type :answer.type/math] ["answer-5dd7221e-4681-539c-8b73-08fedb80fbbf" :answer/value "ϕ=\\frac{\\pi }{3}"] [17592186173362 :answer-field/correct "answer-d7436a96-8f7a-563d-8a2e-27bd76bd83af"] [17592186173362 :answer-field/choices "answer-d7436a96-8f7a-563d-8a2e-27bd76bd83af"] [17592186173362 :answer-field/choices "answer-6d48c000-d46c-5620-896f-57c4438decc4"] [17592186173362 :answer-field/choices "answer-65926222-59a9-5c6b-8e18-d6118f338b81"] [17592186173362 :answer-field/choices "answer-3ade53df-f047-5ea9-ad5f-64f2b44fc397"] [17592186173362 :answer-field/choices "answer-5dd7221e-4681-539c-8b73-08fedb80fbbf"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/id #uuid "554c2eb9-1068-5995-9e2b-d384110d6d5e"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/math-academy-id "q-135255"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/problem "![](images/7c/7c923ff3fd6a74263ed05a0ace025e05b0e1b5c445c2bfb0801b8707ce9ac356.png)\n\nWhat is the equation of the surface shown above in spherical polar coordinates?"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/worked-solution "In the picture, we are given a half-cone with the $z$-axis as its axis.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nEvery point on the given half-cone makes an angle of $\\frac{\\pi }{12}$ radians with the positive $z$-axis. On the other hand, $\\rho $ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $ϕ=\\frac{\\pi }{12}.$"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/difficulty :question.difficulty/easy] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/id #uuid "77d22858-0f2e-526e-bced-96022129988c"] ["answer-d379e0ab-40d7-5be4-a02e-62f11a49df2c" :answer/id #uuid "d379e0ab-40d7-5be4-a02e-62f11a49df2c"] ["answer-d379e0ab-40d7-5be4-a02e-62f11a49df2c" :answer/type :answer.type/math] ["answer-d379e0ab-40d7-5be4-a02e-62f11a49df2c" :answer/value "\\rho =\\frac{\\theta }{12}"] ["answer-95019874-835f-5630-8478-7510f7ff01d5" :answer/id #uuid "95019874-835f-5630-8478-7510f7ff01d5"] ["answer-95019874-835f-5630-8478-7510f7ff01d5" :answer/type :answer.type/math] ["answer-95019874-835f-5630-8478-7510f7ff01d5" :answer/value "\\theta =\\frac{\\pi }{12}"] ["answer-d7f9704c-1b98-5e60-a1d1-c90ca30c1a6d" :answer/id #uuid "d7f9704c-1b98-5e60-a1d1-c90ca30c1a6d"] ["answer-d7f9704c-1b98-5e60-a1d1-c90ca30c1a6d" :answer/type :answer.type/math] ["answer-d7f9704c-1b98-5e60-a1d1-c90ca30c1a6d" :answer/value "\\theta =\\frac{\\pi }{6}"] ["answer-d9f36413-282b-594b-bf19-b41c6ca3f9d8" :answer/id #uuid "d9f36413-282b-594b-bf19-b41c6ca3f9d8"] ["answer-d9f36413-282b-594b-bf19-b41c6ca3f9d8" :answer/type :answer.type/math] ["answer-d9f36413-282b-594b-bf19-b41c6ca3f9d8" :answer/value "ϕ=\\frac{5\\pi }{12}"] ["answer-533da413-4cc6-5072-bfd4-5130aa7b1b4c" :answer/id #uuid "533da413-4cc6-5072-bfd4-5130aa7b1b4c"] ["answer-533da413-4cc6-5072-bfd4-5130aa7b1b4c" :answer/type :answer.type/math] ["answer-533da413-4cc6-5072-bfd4-5130aa7b1b4c" :answer/value "ϕ=\\frac{\\pi }{12}"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/key "selection"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/type :answer-field.type/radio] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/correct "answer-533da413-4cc6-5072-bfd4-5130aa7b1b4c"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/choices "answer-d379e0ab-40d7-5be4-a02e-62f11a49df2c"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/choices "answer-95019874-835f-5630-8478-7510f7ff01d5"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/choices "answer-d7f9704c-1b98-5e60-a1d1-c90ca30c1a6d"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/choices "answer-d9f36413-282b-594b-bf19-b41c6ca3f9d8"] ["answer-field-77d22858-0f2e-526e-bced-96022129988c" :answer-field/choices "answer-533da413-4cc6-5072-bfd4-5130aa7b1b4c"] ["question-554c2eb9-1068-5995-9e2b-d384110d6d5e" :question/answer-fields "answer-field-77d22858-0f2e-526e-bced-96022129988c"] [17592186175966 :knowledge-point/questions "question-554c2eb9-1068-5995-9e2b-d384110d6d5e"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/id #uuid "16bc20a0-cc25-520a-9947-7c91335695c8"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/math-academy-id "q-135293"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/problem "![](images/91/917233475c847130eba1875f80606d91b03b53517fdb9273a3b32502619ef522.png)\n\nWhat is the equation of the surface shown above in spherical polar coordinates?"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/worked-solution "In the picture, we are given a half-cone with the $z$-axis as its axis.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nEvery point on the given half-cone makes an angle of $\\frac{8\\pi }{9}$ radians with the positive $z$-axis. On the other hand, $\\rho $ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $ϕ=\\frac{8\\pi }{9}.$"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/difficulty :question.difficulty/easy] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/id #uuid "7c0bc77f-96c8-5f31-bddf-b61325129b9a"] ["answer-7a095849-30a2-5a86-b94a-5937c6527642" :answer/id #uuid "7a095849-30a2-5a86-b94a-5937c6527642"] ["answer-7a095849-30a2-5a86-b94a-5937c6527642" :answer/type :answer.type/math] ["answer-7a095849-30a2-5a86-b94a-5937c6527642" :answer/value "\\rho =\\frac{8\\pi }{9}ϕ"] ["answer-c5446027-bf25-5b95-b225-a1cfb71d17e0" :answer/id #uuid "c5446027-bf25-5b95-b225-a1cfb71d17e0"] ["answer-c5446027-bf25-5b95-b225-a1cfb71d17e0" :answer/type :answer.type/math] ["answer-c5446027-bf25-5b95-b225-a1cfb71d17e0" :answer/value "\\theta =\\frac{8\\pi }{9}"] ["answer-146aa21f-44ca-51df-b0da-ac4f658fac27" :answer/id #uuid "146aa21f-44ca-51df-b0da-ac4f658fac27"] ["answer-146aa21f-44ca-51df-b0da-ac4f658fac27" :answer/type :answer.type/math] ["answer-146aa21f-44ca-51df-b0da-ac4f658fac27" :answer/value "\\theta =\\frac{\\pi }{9}"] ["answer-cf78c873-e6cf-5b6f-a593-5a1a0064a21b" :answer/id #uuid "cf78c873-e6cf-5b6f-a593-5a1a0064a21b"] ["answer-cf78c873-e6cf-5b6f-a593-5a1a0064a21b" :answer/type :answer.type/math] ["answer-cf78c873-e6cf-5b6f-a593-5a1a0064a21b" :answer/value "ϕ=\\frac{8\\pi }{9}"] ["answer-f8c22772-3e88-5eda-bc0a-b400e08d3084" :answer/id #uuid "f8c22772-3e88-5eda-bc0a-b400e08d3084"] ["answer-f8c22772-3e88-5eda-bc0a-b400e08d3084" :answer/type :answer.type/math] ["answer-f8c22772-3e88-5eda-bc0a-b400e08d3084" :answer/value "ϕ=\\frac{\\pi }{9}"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/key "selection"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/type :answer-field.type/radio] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/correct "answer-cf78c873-e6cf-5b6f-a593-5a1a0064a21b"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/choices "answer-7a095849-30a2-5a86-b94a-5937c6527642"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/choices "answer-c5446027-bf25-5b95-b225-a1cfb71d17e0"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/choices "answer-146aa21f-44ca-51df-b0da-ac4f658fac27"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/choices "answer-cf78c873-e6cf-5b6f-a593-5a1a0064a21b"] ["answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a" :answer-field/choices "answer-f8c22772-3e88-5eda-bc0a-b400e08d3084"] ["question-16bc20a0-cc25-520a-9947-7c91335695c8" :question/answer-fields "answer-field-7c0bc77f-96c8-5f31-bddf-b61325129b9a"] [17592186175966 :knowledge-point/questions "question-16bc20a0-cc25-520a-9947-7c91335695c8"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/id #uuid "151bdd66-5085-5cc9-a9af-25457fe9b069"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/math-academy-id "q-135301"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/problem "What surface is defined by the equation $\\theta =\\pi $ in spherical polar coordinates?"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nWith that in mind, let's examine our equation:\n\n$$\n\\theta =\\pi \n$$\n\nThis equation specifies that for any point on the surface, the angle that the corresponding vector makes with the positive $x$-axis must equal $\\pi .$ On the other hand, $\\rho $ and $ϕ$ can vary arbitrarily in their respective domains. \n\nTherefore, since $\\rho \\ge 0,$ our surface is a half-plane.\n\n![](images/41/415596385e885cf6c8fb553d126c550a78879d3503267bae102a8e038a688eb3.png)"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/difficulty :question.difficulty/easy] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/id #uuid "89d19a91-9b5e-5bde-be4d-876637ef2257"] ["answer-c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7" :answer/id #uuid "c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7"] ["answer-c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7" :answer/type :answer.type/text] ["answer-c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7" :answer/value "A half-plane"] ["answer-3d59c90c-9f40-57a5-8e98-bfd01f70ea85" :answer/id #uuid "3d59c90c-9f40-57a5-8e98-bfd01f70ea85"] ["answer-3d59c90c-9f40-57a5-8e98-bfd01f70ea85" :answer/type :answer.type/text] ["answer-3d59c90c-9f40-57a5-8e98-bfd01f70ea85" :answer/value "A hyperboloid"] ["answer-3c27e55e-48dd-567a-b8e9-f381889e732a" :answer/id #uuid "3c27e55e-48dd-567a-b8e9-f381889e732a"] ["answer-3c27e55e-48dd-567a-b8e9-f381889e732a" :answer/type :answer.type/text] ["answer-3c27e55e-48dd-567a-b8e9-f381889e732a" :answer/value "A line"] ["answer-479a1efc-6aee-5db2-81fe-fdda094e2d95" :answer/id #uuid "479a1efc-6aee-5db2-81fe-fdda094e2d95"] ["answer-479a1efc-6aee-5db2-81fe-fdda094e2d95" :answer/type :answer.type/text] ["answer-479a1efc-6aee-5db2-81fe-fdda094e2d95" :answer/value "A plane"] ["answer-32461572-55bc-5f57-b231-fb17b4eaa812" :answer/id #uuid "32461572-55bc-5f57-b231-fb17b4eaa812"] ["answer-32461572-55bc-5f57-b231-fb17b4eaa812" :answer/type :answer.type/text] ["answer-32461572-55bc-5f57-b231-fb17b4eaa812" :answer/value "A sphere"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/key "selection"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/type :answer-field.type/radio] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/correct "answer-c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/choices "answer-c3b9ed22-ede1-58b1-b1b0-d97a6798e3e7"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/choices "answer-3d59c90c-9f40-57a5-8e98-bfd01f70ea85"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/choices "answer-3c27e55e-48dd-567a-b8e9-f381889e732a"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/choices "answer-479a1efc-6aee-5db2-81fe-fdda094e2d95"] ["answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257" :answer-field/choices "answer-32461572-55bc-5f57-b231-fb17b4eaa812"] ["question-151bdd66-5085-5cc9-a9af-25457fe9b069" :question/answer-fields "answer-field-89d19a91-9b5e-5bde-be4d-876637ef2257"] [17592186175967 :knowledge-point/questions "question-151bdd66-5085-5cc9-a9af-25457fe9b069"] ["question-f975b4e0-ae07-50ae-a2a8-6fe6de3927cf" :question/id #uuid "f975b4e0-ae07-50ae-a2a8-6fe6de3927cf"] ["question-f975b4e0-ae07-50ae-a2a8-6fe6de3927cf" :question/math-academy-id "q-135297"] ["question-f975b4e0-ae07-50ae-a2a8-6fe6de3927cf" :question/problem "What surface is defined by the equation $\\rho =1$ in spherical polar coordinates?"] ["question-f975b4e0-ae07-50ae-a2a8-6fe6de3927cf" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nWith that in mind, let's examine our equation:\n\n$$\n\\rho =1\n$$\n\nThis equation specifies that for any point on the surface, the distance from the point to the origin must equal $1.$ On the other hand, $\\theta $ and $ϕ$ can vary arbitrarily in their respective domains. \n\nTherefore, our surface is a sphere.\n\n![](images/6b/6bca743f355735dae56d679cc601852f5a52bd5cc99e89a8d4f20a92111cf621.png)"] ["question-f975b4e0-ae07-50ae-a2a8-6fe6de3927cf" :question/difficulty :question.difficulty/easy] ["answer-field-0f41120f-43ad-516f-be5d-f4fc7aad71f6" :answer-field/id #uuid "0f41120f-43ad-516f-be5d-f4fc7aad71f6"] ["answer-2e47c97e-55dc-53c8-9711-65d1b9fc5ec9" :answer/id #uuid "2e47c97e-55dc-53c8-9711-65d1b9fc5ec9"] ["answer-2e47c97e-55dc-53c8-9711-65d1b9fc5ec9" :answer/type :answer.type/text] ["answer-2e47c97e-55dc-53c8-9711-65d1b9fc5ec9" :answer/value "A cone"] ["answer-2fed5099-caf7-543c-92f2-49d96f84c06e" :answer/id #