      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114451/observations/step-q36301-5e2a3d5d02e4c94d980f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14114451/observations/step-q36301-5e2a3d5d02e4c94d980f.png",
