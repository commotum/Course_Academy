            {
              "option": "0",
              "dom_id": null,
              "type": "text",
              "value": "stable",
              "html": "stable"
            },
            {
              "option": "1",
              "dom_id": null,
              "type": "text",
              "value": "unstable",
              "html": "unstable"
            }
          ],
