      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228292/observations/step-q77145-55943cee42a838523be2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14228292/observations/step-q77145-55943cee42a838523be2.png",
      "source_url": "https://mathacademy.com/tasks/14228292/topics/3704/review",
      "captured_at": 1792067048.5873625,
      "math_academy_id": "q-77145",
