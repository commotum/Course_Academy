#{[{:db/id #edb/ref 17592186256682 :knowledge-point/_questions [{:db/id #edb/ref 17592186172084 :knowledge-point/id #uuid "a9734fc0-9789-5a9c-8ae0-806f87052875" :knowledge-point/title "Identifying a Two-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1594a1bc-f5fe-5f70-9851-0a40cf220726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y)=y\\,i+j" :db/id #edb/ref 17592186253858} {:answer/id #uuid "2a58e0ad-829d-534a-8952-ebde58ad8036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y)=x\\,i" :db/id #edb/ref 17592186254047} {:answer/id #uuid "806ab92f-6629-5c21-bfaa-aed813f56f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y)=y\\,i" :db/id #edb/ref 17592186254806} {:answer/id #uuid "a3040035-3b3f-530d-ab79-811b4208c92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y)=-i" :db/id #edb/ref 17592186255108} {:answer/id #uuid "c489f169-2513-54a3-8d41-2efa377862b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186255426}] :answer-field/correct {:answer/id #uuid "806ab92f-6629-5c21-bfaa-aed813f56f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y)=y\\,i" :db/id #edb/ref 17592186254806} :answer-field/id #uuid "7217108e-c492-5bb5-ac37-d69d40646a57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de025ac4-8073-535b-a254-6c2938769096" :question/math-academy-id "q-122633" :question/problem "![](images/25/251e49513353092b4f9a16f54bb14fbaa1afe1a14e5fecf5b3ce54905fed474d.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- The vertical component (i.e., the $j$ component) is zero for *every* vector in our vector field. Therefore, we can rule out the following option:\n\n$$\nH(x,y)=y\\,i+j\n$$\n\n- As we move away from the origin in the vertical direction, our vectors' horizontal components (i.e., the $i$ components) get longer. Therefore, we can rule out the following options:\n\n$$\nF(x,y)=x\\,i,\\,K(x,y)=-i\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $G(x,y)=y\\,i.$"}] [{:db/id #edb/ref 17592186492026 :knowledge-point/_questions [{:db/id #edb/ref 17592186133840 :knowledge-point/id #uuid "fdce40e5-8ffe-52cb-8a8e-ac8eaea982f0" :knowledge-point/title "Evaluating a Repeated Integral Defined Over a Type II Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49e21610-6649-5cca-867f-919acc5aed1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(19-{e}^{2})" :db/id #edb/ref 17592186491594} {:answer/id #uuid "859926f0-fa4b-5477-bb74-f71065545537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(18-e)" :db/id #edb/ref 17592186491684} {:answer/id #uuid "926c5b60-06c2-5fc5-af57-71f58a6fc834" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186491702} {:answer/id #uuid "9e38e57f-b4bb-5845-b64b-2eac7fc599bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-{e}^{2}" :db/id #edb/ref 17592186491732} {:answer/id #uuid "ed2d7487-59db-5794-9cdb-ba898590d16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9-e" :db/id #edb/ref 17592186491860}] :answer-field/correct {:answer/id #uuid "49e21610-6649-5cca-867f-919acc5aed1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(19-{e}^{2})" :db/id #edb/ref 17592186491594} :answer-field/id #uuid "0ec910be-116e-5d53-bae3-fab1ccd2c9b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491892}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7406d317-ea31-5b68-821e-2624f64676a2" :question/math-academy-id "q-132419" :question/problem "Calculate ${\\int }_{1}^{e}{\\int }_{{y}^{2}}^{9}\\frac{1}{y}\\,dx\\,dy.$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{\\int }_{{y}^{2}}^{9}\\frac{1}{y}\\,dx\\,dy & ={\\int }_{1}^{e}\\frac{1}{y}[{\\int }_{{y}^{2}}^{9}dx]dy \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}[\\,x\\,]_{{y}^{2}}^{9}\\,dy \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}(9-{y}^{2})\\,dy \\\\  & ={\\int }_{1}^{e}(\\frac{9}{y}-y)dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}(\\frac{9}{y}-y)dy & ={[9\\operatorname{ln}⁡y-\\frac{1}{2}{y}^{2}]}_{1}^{e} \\\\  & =(9\\operatorname{ln}⁡e-\\frac{1}{2}{e}^{2})-(9\\operatorname{ln}⁡1-\\frac{1}{2}) \\\\  & =9-\\frac{1}{2}{e}^{2}+\\frac{1}{2} \\\\  & =\\frac{19}{2}-\\frac{1}{2}{e}^{2} \\\\  & =\\frac{1}{2}(19-{e}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275137 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb77d39b-75ff-5747-b99c-9cd47f41c51c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449682} {:answer/id #uuid "94345635-817a-5aa4-a7a2-498d963121ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683}] :answer-field/correct {:answer/id #uuid "94345635-817a-5aa4-a7a2-498d963121ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683} :answer-field/id #uuid "eaedc8bd-f59e-5871-bfc5-e7553143409e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450795} {:answer-field/choices [{:answer/id #uuid "f0f84e81-499d-55d4-ac5e-99eb38720728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} {:answer/id #uuid "79aeba54-2cd8-5240-8cb3-d19dcfbe4680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449685}] :answer-field/correct {:answer/id #uuid "f0f84e81-499d-55d4-ac5e-99eb38720728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} :answer-field/id #uuid "a09ef516-6c8d-5da1-b76b-438fb19a83e7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450796} {:answer-field/choices [{:answer/id #uuid "1bcbb1cb-2004-5967-bedb-dae9a7275c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} {:answer/id #uuid "2bda30dd-367b-5982-ba71-617e5ac2752d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449687}] :answer-field/correct {:answer/id #uuid "1bcbb1cb-2004-5967-bedb-dae9a7275c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} :answer-field/id #uuid "06250cb3-b876-5df2-a845-d13c4b38939b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "62cdcd34-c338-59e0-b65d-2d882ff231e6" :question/math-academy-id "q-143687" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The sum of two $n\\times n$ diagonal matrices is always symmetric.\n- **II.** If $A$ is *any*  $n\\times n$  matrix, then $A-{A}^{T}$ is always symmetric.\n- **III.** The product of two $n\\times n$ symmetric matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any diagonal matrices $A$ and $B,$ we have\n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the matrix \n\n$\\,$ $A=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].$\n\nHowever, $A-{A}^{T}$ is not symmetric:\n\n$$\n\\begin{aligned}A-{A}^{T} & =[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}]-[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}]=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186492011 :knowledge-point/_questions [{:db/id #edb/ref 17592186162154 :knowledge-point/id #uuid "900dcaf8-da39-5654-96cd-6aec89e379c9" :knowledge-point/title "Calculating Joint Probabilities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e2ab1f-ce9b-5969-b153-8c952635697f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.42" :db/id #edb/ref 17592186491606} {:answer/id #uuid "6c01961e-283c-5e82-89cd-af921b8b18cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine using the given information." :db/id #edb/ref 17592186491647} {:answer/id #uuid "79b00643-d756-5605-96ea-7aef73ff16fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.06" :db/id #edb/ref 17592186491665} {:answer/id #uuid "bfceb24c-fc28-5771-a384-73a046579e6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.28" :db/id #edb/ref 17592186491785} {:answer/id #uuid "f4eeb262-2789-575f-8f08-0e1aa6046842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186491873}] :answer-field/correct {:answer/id #uuid "6c01961e-283c-5e82-89cd-af921b8b18cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine using the given information." :db/id #edb/ref 17592186491647} :answer-field/id #uuid "5826e975-df63-51e0-a67a-1164fd2d1f8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c1df99e-2ead-55b4-87fb-2ae2dcf226a5" :question/math-academy-id "q-149654" :question/problem "The marginal mass functions of the discrete random variables $X$ and $Y$ are shown below. Given that the corresponding joint probability mass function is $f(x,y),$ find $f(3,0).$\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$x$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$3$</td>\n<td align=\"center\">$4$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{X}(x)$</td>\n<td align=\"center\">$0.15$</td>\n<td align=\"center\">$0.15$</td>\n<td align=\"center\">$0.7$</td>\n</tr>\n</tbody></table>\n<p></p></th>\n<th width=\"50\"></th>\n<th>\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">$y$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\">${f}_{Y}(y)$</td>\n<td align=\"center\">$0.6$</td>\n<td align=\"center\">$0.4$</td>\n</tr>\n</tbody></table>\n<p></p></th></tr></tbody></table>" :question/worked-solution "Since we don't know whether $X$ and $Y$ are independent, it is impossible to determine the joint distribution of $X$ and $Y$ using only the given information."}] [{:db/id #edb/ref 17592186492036 :knowledge-point/_questions [{:db/id #edb/ref 17592186119927 :knowledge-point/id #uuid "83796fe8-f045-5dbc-94d1-6d6e031f3ed8" :knowledge-point/title "Determining Whether a Line Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2339f215-4cbb-5adc-a39e-5b00344395a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186491526} {:answer/id #uuid "4c9937d0-b3c2-5293-a363-22fac18fe7e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186491599} {:answer/id #uuid "4faf210f-ce86-588c-b968-d96274443741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All the statements are true" :db/id #edb/ref 17592186491604} {:answer/id #uuid "78343537-4f56-5e8c-8de7-ad2c54434a65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186491662} {:answer/id #uuid "81b02aa9-41ab-52c7-98b4-fa537419f075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186491679}] :answer-field/correct {:answer/id #uuid "4c9937d0-b3c2-5293-a363-22fac18fe7e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186491599} :answer-field/id #uuid "3962bad0-d10e-5fef-ab50-1296d25a4863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491900}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8de6a121-b818-5379-9a6e-e58e864f7095" :question/math-academy-id "q-157372" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(2,1,2).$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]=[\\begin{aligned}2t \\\\ t \\\\ 2t\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n\\frac{x}{2}=y=\\frac{z}{2}.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}2a \\\\ a \\\\ 2a\\end{aligned}]\\in L$ and $b=[\\begin{aligned}2b \\\\ b \\\\ 2b\\end{aligned}]\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}2a \\\\ a \\\\ 2a\\end{aligned}]+[\\begin{aligned}2b \\\\ b \\\\ 2b\\end{aligned}]=[\\begin{aligned}2a+2b \\\\ a+b \\\\ 2a+2b\\end{aligned}]=[\\begin{aligned}2(a+b) \\\\ a+b \\\\ 2(a+b)\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{2}=y=\\frac{z}{2}.$ Therefore, $a+b\\in L.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}2a \\\\ a \\\\ 2a\\end{aligned}]\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}2a \\\\ a \\\\ 2a\\end{aligned}]=[\\begin{aligned}k(2a) \\\\ ka \\\\ k(2a)\\end{aligned}]=[\\begin{aligned}2(ka) \\\\ ka \\\\ 2(ka)\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $\\frac{x}{2}=y=\\frac{z}{2}.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement IV is false. Since statements II and III are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186124891 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "593952d1-603f-5697-b907-5540e353de04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0,1)" :db/id #edb/ref 17592186491621} {:answer/id #uuid "6f4f4be7-060b-56f0-97f2-a38d339ecc2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186491655} {:answer/id #uuid "9c77ee9d-084d-5e55-82fd-5f2296dd96bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0,-1)" :db/id #edb/ref 17592186491726} {:answer/id #uuid "cdc8c3e5-1e99-5aaa-b702-9c9113341792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0,-1)" :db/id #edb/ref 17592186491803} {:answer/id #uuid "da4c09e0-be8a-5958-94e9-6bce9a534264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0,-1)" :db/id #edb/ref 17592186491824}] :answer-field/correct {:answer/id #uuid "cdc8c3e5-1e99-5aaa-b702-9c9113341792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0,-1)" :db/id #edb/ref 17592186491803} :answer-field/id #uuid "9fe8f42e-bd52-5557-a69d-1be3b48f9022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121946}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46ec68bc-6534-5a9b-ab9f-a1364685c87b" :question/math-academy-id "q-35557" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+1=\\frac{(x+3)^{2}}{2}-\\frac{{y}^{2}}{4}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+1 & =\\frac{(x+3)^{2}}{2}-\\frac{{y}^{2}}{4} \\\\ z-(-1) & =\\frac{(x-(-3))^{2}}{2}-\\frac{(y-0)^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(-3,0,-1).$"}] [{:db/id #edb/ref 17592186491988 :knowledge-point/_questions [{:db/id #edb/ref 17592186078568 :knowledge-point/id #uuid "9f542453-9758-55e6-93c6-6bfd2139ec45" :knowledge-point/title "Computing a Tangent Line Approximation and Classifying it as an Underestimate or Overestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6fb1-f818-5d45-99d6-93c39ca01de9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave up in the neighborhood of $x=1$" :db/id #edb/ref 17592186491487} {:answer/id #uuid "1e78c860-a13d-567e-a01c-fe605f993316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is linear function" :db/id #edb/ref 17592186491518} {:answer/id #uuid "5a003fde-ad0c-5828-88b8-0ad4076d3dfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ has a local maximum at $x=1$" :db/id #edb/ref 17592186491622} {:answer/id #uuid "985bc9c3-dffa-559d-ab41-88c0db903695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave down in the neighborhood of $x=1$" :db/id #edb/ref 17592186491719} {:answer/id #uuid "ddfc3688-e706-5e73-9a16-b8812fd7619c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is constant function" :db/id #edb/ref 17592186491831}] :answer-field/correct {:answer/id #uuid "985bc9c3-dffa-559d-ab41-88c0db903695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is concave down in the neighborhood of $x=1$" :db/id #edb/ref 17592186491719} :answer-field/id #uuid "d59ee512-a410-5f72-bb29-840819934fc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ae5ac07-ecc2-5615-aa8d-7abad2a2df30" :question/math-academy-id "q-48434" :question/problem "Given that the tangent line approximation to the function $f(x)$ at $x=1$ overestimates the values of the function in the neighborhood of $x=1,$ which of the following must be true?" :question/worked-solution "Since the tangent line approximation of $f(x)$ at $x=1$ overestimates the values of the function, we have\n\n$$\nL(x)>f(x),\n$$\n\nthat is, the line $L(x)$ must be above the graph of $f(x)$ near the point  $x=1.$\n\nTherefore, the function must be concave down in the neighborhood of $x=1.$"}]}
