#{[{:db/id #edb/ref 17592186256682 :knowledge-point/_questions [{:db/id #edb/ref 17592186172084 :knowledge-point/id #uuid "a9734fc0-9789-5a9c-8ae0-806f87052875" :knowledge-point/title "Identifying a Two-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1594a1bc-f5fe-5f70-9851-0a40cf220726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "H(x,y)=y\\,i+j" :db/id #edb/ref 17592186253858} {:answer/id #uuid "2a58e0ad-829d-534a-8952-ebde58ad8036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(x,y)=x\\,i" :db/id #edb/ref 17592186254047} {:answer/id #uuid "806ab92f-6629-5c21-bfaa-aed813f56f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y)=y\\,i" :db/id #edb/ref 17592186254806} {:answer/id #uuid "a3040035-3b3f-530d-ab79-811b4208c92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "K(x,y)=-i" :db/id #edb/ref 17592186255108} {:answer/id #uuid "c489f169-2513-54a3-8d41-2efa377862b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186255426}] :answer-field/correct {:answer/id #uuid "806ab92f-6629-5c21-bfaa-aed813f56f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "G(x,y)=y\\,i" :db/id #edb/ref 17592186254806} :answer-field/id #uuid "7217108e-c492-5bb5-ac37-d69d40646a57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de025ac4-8073-535b-a254-6c2938769096" :question/math-academy-id "q-122633" :question/problem "![](images/25/251e49513353092b4f9a16f54bb14fbaa1afe1a14e5fecf5b3ce54905fed474d.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- The vertical component (i.e., the $j$ component) is zero for *every* vector in our vector field. Therefore, we can rule out the following option:\n\n$$\nH(x,y)=y\\,i+j\n$$\n\n- As we move away from the origin in the vertical direction, our vectors' horizontal components (i.e., the $i$ components) get longer. Therefore, we can rule out the following options:\n\n$$\nF(x,y)=x\\,i,\\,K(x,y)=-i\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $G(x,y)=y\\,i.$"}] [{:db/id #edb/ref 17592186275137 :knowledge-point/_questions [{:db/id #edb/ref 17592186162024 :knowledge-point/id #uuid "bcd0ca26-3f22-533f-9d08-1533eeddbc79" :knowledge-point/title "Identifying True Statements Regarding Properties of Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb77d39b-75ff-5747-b99c-9cd47f41c51c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449682} {:answer/id #uuid "94345635-817a-5aa4-a7a2-498d963121ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683}] :answer-field/correct {:answer/id #uuid "94345635-817a-5aa4-a7a2-498d963121ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449683} :answer-field/id #uuid "eaedc8bd-f59e-5871-bfc5-e7553143409e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450795} {:answer-field/choices [{:answer/id #uuid "f0f84e81-499d-55d4-ac5e-99eb38720728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} {:answer/id #uuid "79aeba54-2cd8-5240-8cb3-d19dcfbe4680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449685}] :answer-field/correct {:answer/id #uuid "f0f84e81-499d-55d4-ac5e-99eb38720728" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449684} :answer-field/id #uuid "a09ef516-6c8d-5da1-b76b-438fb19a83e7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450796} {:answer-field/choices [{:answer/id #uuid "1bcbb1cb-2004-5967-bedb-dae9a7275c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} {:answer/id #uuid "2bda30dd-367b-5982-ba71-617e5ac2752d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449687}] :answer-field/correct {:answer/id #uuid "1bcbb1cb-2004-5967-bedb-dae9a7275c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449686} :answer-field/id #uuid "06250cb3-b876-5df2-a845-d13c4b38939b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "62cdcd34-c338-59e0-b65d-2d882ff231e6" :question/math-academy-id "q-143687" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The sum of two $n\\times n$ diagonal matrices is always symmetric.\n- **II.** If $A$ is *any*  $n\\times n$  matrix, then $A-{A}^{T}$ is always symmetric.\n- **III.** The product of two $n\\times n$ symmetric matrices is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any diagonal matrices $A$ and $B,$ we have\n\n$$\n\\begin{aligned}(A+B)^{T} & ={A}^{T}+{B}^{T} \\\\  & =A+B.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the matrix \n\n$\\,$ $A=[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}].$\n\nHowever, $A-{A}^{T}$ is not symmetric:\n\n$$\n\\begin{aligned}A-{A}^{T} & =[\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}]-[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}]=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n\n$\\,$ $A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ \n\nHowever, their product is not symmetric:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186124891 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf20a278-bc92-5e2f-b45c-1e564aca8abf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 0,-1)" :db/id #edb/ref 17592186121947} {:answer/id #uuid "0c474add-d7bf-50c7-bab7-35830a4cd7e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3, 0, 1)" :db/id #edb/ref 17592186121948} {:answer/id #uuid "1a3eab92-1de2-56ed-a553-638923a1102c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3, 0,-1)" :db/id #edb/ref 17592186121949} {:answer/id #uuid "2f80e277-f109-50bd-a05e-991c96f010fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3, 0,-1)" :db/id #edb/ref 17592186121950} {:answer/id #uuid "5b4ccdce-1dd5-5e45-806e-1cf9e95dc655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 0, 0)" :db/id #edb/ref 17592186121951}] :answer-field/id #uuid "9fe8f42e-bd52-5557-a69d-1be3b48f9022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121946}] :question/id #uuid "46ec68bc-6534-5a9b-ab9f-a1364685c87b" :question/math-academy-id "q-35557" :question/problem "Find the saddle point of the hyperbolic paraboloid $z + 1 = ((x + 3)^{2})/(2) - \\frac{y^{2}}{4}$."}]}
