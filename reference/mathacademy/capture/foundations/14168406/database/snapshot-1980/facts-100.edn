17592186381013 #edb/ref 17592186045417] [17592186133840 #edb/ref 1038 #edb/ref 17592186407921 #edb/ref 17592186045417] [17592186133840 #edb/ref 1038 #edb/ref 17592186475919 #edb/ref 17592186045417] [17592186133840 #edb/ref 1038 #edb/ref 17592186483406 #edb/ref 17592186045417] [17592186133840 #edb/ref 1038 #edb/ref 17592186487361 #edb/ref 17592186045417] [17592186133840 #edb/ref 1038 #edb/ref 17592186492026 #edb/ref 17592186045417] [17592186133840 #edb/ref 1039 "Evaluating a Repeated Integral Defined Over a Type II Region" #edb/ref 17592186045417] [17592186133840 #edb/ref 1041 #edb/ref 17592186133655 #edb/ref 17592186045417] [17592186133840 #edb/ref 1042 #uuid "fdce40e5-8ffe-52cb-8a8e-ac8eaea982f0" #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186134191 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186134519 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186268871 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186268872 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186268873 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186268875 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186268876 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186326871 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186351305 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186381034 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186382490 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186382594 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186407922 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186475953 #edb/ref 17592186045417] [17592186133841 #edb/ref 1038 #edb/ref 17592186487395 #edb/ref 17592186045417] [17592186133841 #edb/ref 1039 "Calculating a Double Integral Defined Over a Type II Region" #edb/ref 17592186045417] [17592186133841 #edb/ref 1041 #edb/ref 17592186133656 #edb/ref 17592186045417] [17592186133841 #edb/ref 1042 #uuid "90f7718f-e014-5232-acb1-6773ab79f61d" #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134761 #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134762 #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134763 #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134764 #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134765 #edb/ref 17592186045417] [17592186134021 #edb/ref 1043 #edb/ref 17592186134766 #edb/ref 17592186045417] [17592186134021 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186134021 #edb/ref 1045 "Double Integrals Over Type II Regions" #edb/ref 17592186045417] [17592186134021 #edb/ref 1046 #edb/ref 17592186134761 #edb/ref 17592186045417] [17592186134021 #edb/ref 1049 #edb/ref 17592186050264 #edb/ref 17592186045417] [17592186134021 #edb/ref 1050 1080.0 #edb/ref 17592186045417] [17592186134021 #edb/ref 1050 1080.0 #edb/ref 17592186045436] [17592186134021 #edb/ref 1053 #uuid "912bbbc1-7dd5-5812-ba95-2d17ed90bd7e" #edb/ref 17592186045417] [17592186134761 #edb/ref 1058 #edb/ref 17592186134762 #edb/ref 17592186045417] [17592186134761 #edb/ref 1061 26243 #edb/ref 17592186045417] [17592186134761 #edb/ref 1062 #uuid "212536fd-085f-5bdf-babc-a919d333a568" #edb/ref 17592186045417] [17592186134761 #edb/ref 1063 #edb/ref 17592186135085 #edb/ref 17592186045417] [17592186134762 #edb/ref 1058 #edb/ref 17592186134763 #edb/ref 17592186045417] [17592186134762 #edb/ref 1061 26244 #edb/ref 17592186045417] [17592186134762 #edb/ref 1062 #uuid "cde6f31a-9259-5126-ab62-92a7120fde39" #edb/ref 17592186045417] [17592186134762 #edb/ref 1063 #edb/ref 17592186133838 #edb/ref 17592186045417] [17592186134763 #edb/ref 1058 #edb/ref 17592186134764 #edb/ref 17592186045417] [17592186134763 #edb/ref 1061 26245 #edb/ref 17592186045417] [17592186134763 #edb/ref 1062 #uuid "38689b31-f1db-5afc-801c-860cb6fc929b" #edb/ref 17592186045417] [17592186134763 #edb/ref 1063 #edb/ref 17592186133839 #edb/ref 17592186045417] [17592186134764 #edb/ref 1058 #edb/ref 17592186134765 #edb/ref 17592186045417] [17592186134764 #edb/ref 1061 26246 #edb/ref 17592186045417] [17592186134764 #edb/ref 1062 #uuid "6fd8b1b4-a45f-595a-b748-1d95ba70387d" #edb/ref 17592186045417] [17592186134764 #edb/ref 1063 #edb/ref 17592186135086 #edb/ref 17592186045417] [17592186134765 #edb/ref 1058 #edb/ref 17592186134766 #edb/ref 17592186045417] [17592186134765 #edb/ref 1061 26247 #edb/ref 17592186045417] [17592186134765 #edb/ref 1062 #uuid "97348c88-b232-5f44-bd21-15af51c5d116" #edb/ref 17592186045417] [17592186134765 #edb/ref 1063 #edb/ref 17592186133840 #edb/ref 17592186045417] [17592186134766 #edb/ref 1061 26248 #edb/ref 17592186045417] [17592186134766 #edb/ref 1062 #uuid "0d46d822-c664-59b7-8ccb-0874593592f6" #edb/ref 17592186045417] [17592186134766 #edb/ref 1063 #edb/ref 17592186133841 #edb/ref 17592186045417] [17592186135085 #edb/ref 1064 "How do we represent a double integral over a type II region as a repeated integral? \n\nSpecifically, let's consider\n\n$$\n\\displaystyle \\iint\\limits_D (x+2y) \\, \\textrm d A, \n%= \\int_a^b \\int_c^d (x+2y) \\,\\textrm d y\\, \\textrm d x,\n$$\n\nwhere $D$  is the finite region bounded by the lines $x=0,$ $y=0, y=1$ and the curve $x=e^y,$ as shown below.\n\n![](images/09/09fa628c26853d48f3775945e856763b5a996c431785ecf4194c879ee881aa78.png)\n\nFirst, notice that $D$ is indeed a type II region. \nTo determine the right and left functions, we draw a horizontal arrow through the region, as usual.\n\n![](images/47/47fffd047fe12aacfbcc98fa34750e7afcb32dd06618f2553c65432828fff328.png)\n\nHence, the region $D$ can be defined as \n\n$$\nD = \\left\\{ (x,y) \\: : \\: {\\color{red}0} \\leq y  \\leq {\\color{blue}1}, \\quad {\\color{red}0} \\leq x \\leq {\\color{blue}e^y} \\right\\}.\n$$\n\nNow, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}(x+2y)\\,dA & ={\\int }_{(\\text{lower limit})}^{(\\text{upper limit})}[{\\int }_{(\\text{left function})}^{(\\text{right function})}(x+2y)\\text{ }dx]\\text{ }dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{{e}^{y}}(x+2y)\\text{ }dx]\\text{ }dy\\end{aligned}\n$$\n\nAnd that's our answer! Notice that when we have a type II region, \n\n- the limits for $x$ are functions of $y,$ and\n\n- the limits for $y$ are constants." #edb/ref 17592186045417] [17592186135085 #edb/ref 1065 4318 #edb/ref 17592186045417] [17592186135085 #edb/ref 1066 #uuid "8a9a9898-50b3-5263-9da1-1228ed4ee5e7" #edb/ref 17592186045417] [17592186135085 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135086 #edb/ref 1064 "Suppose that we want to evaluate the repeated integral\n\n$$\n\\int_{0}^{1}\\int_{0}^{e^y} (x+2) \\ \\mathrm{d}  x \\, \\mathrm{d}  y.\n$$\n\nNotice that the domain of integration is a type II region. \n\nTo compute this integral, we must bear the following important points in mind.\n\n- We start with the inner integral, as usual.\n\n- When integrating with respect to $x,$ we treat $y$ as though it were a constant.\n\n- The limits of integration for the inner integral are functions of $y.$ Once again, we treat $y$ as though it were a constant and substitute the integration limits as usual. After this step, there should be no more $x$'s in our integral.\n\n- Finally, we compute the outer integral.\n\nLet's apply these steps to solve the given problem.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{{e}^{y}}(x+2)\\text{ }dx]dy & ={\\int }_{0}^{1}{[\\frac{{x}^{2}}{2}+2x]}_{0}^{{e}^{y}}\\text{ }dy \\\\  & ={\\int }_{0}^{1}(\\frac{{e}^{2y}}{2}+2{e}^{y})\\text{ }dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{{e}^{2y}}{2}+2{e}^{y})\\text{ }dy & ={[\\frac{{e}^{2y}}{4}+2{e}^{y}]}_{0}^{1} \\\\  & =\\frac{{e}^{2}}{4}+2e-(\\frac{{e}^{0}}{4}+2{e}^{0}) \\\\  & =\\frac{1}{4}({e}^{2}+8e-9)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186135086 #edb/ref 1065 4319 #edb/ref 17592186045417] [17592186135086 #edb/ref 1066 #uuid "cf856bdc-a6e0-55d3-a44c-78b2e569f5e0" #edb/ref 17592186045417] [17592186135086 #edb/ref 1067 "Evaluating Repeated Integrals With Variable Limits" #edb/ref 17592186045417] [17592186161979 #edb/ref 1037 #edb/ref 17592186050727 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186162586 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186162613 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186272114 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186275133 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186275134 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186357611 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186357612 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186357613 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186366553 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186366560 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186425154 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186490264 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186490309 #edb/ref 17592186045417] [17592186161979 #edb/ref 1038 #edb/ref 17592186490315 #edb/ref 17592186045417] [17592186161979 #edb/ref 1039 "Identifying Symmetric Matrices" #edb/ref 17592186045417] [17592186161979 #edb/ref 1041 #edb/ref 17592186161771 #edb/ref 17592186045417] [17592186161979 #edb/ref 1042 #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" #edb/ref 17592186045417] [17592186162024 #edb/ref 1037 #edb/ref 17592186049125 #edb/ref 1759218