#{[{:db/id #edb/ref 17592186441316 :knowledge-point/_questions [{:db/id #edb/ref 17592186221436 :knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a509f0a1-df96-54e7-8b07-3244182c4bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{5t}z(t)" :db/id #edb/ref 17592186441269} {:answer/id #uuid "b90a7aa8-ab0c-5cbf-81a4-db4e580b95d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-5t}z(t)" :db/id #edb/ref 17592186441276} {:answer/id #uuid "c0a3a294-7cc6-5b9f-b486-dfeccdcf0123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{5t}z(t)" :db/id #edb/ref 17592186441278} {:answer/id #uuid "fbb5df36-957b-5e85-9043-a3a5a566794f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{-5t}z(t)" :db/id #edb/ref 17592186441293}] :answer-field/correct {:answer/id #uuid "b90a7aa8-ab0c-5cbf-81a4-db4e580b95d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-5t}z(t)" :db/id #edb/ref 17592186441276} :answer-field/id #uuid "258bced0-5662-54ae-9abc-a8aa92bf71d0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186441298} {:answer-field/choices [{:answer/id #uuid "26244555-8751-5b69-87bb-1a521f8d5b9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186441229} {:answer/id #uuid "6a66b128-146c-5e28-830b-7d212f4acdd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}-5" :db/id #edb/ref 17592186441254} {:answer/id #uuid "894334bc-9bcf-59f8-ac64-29d8f96