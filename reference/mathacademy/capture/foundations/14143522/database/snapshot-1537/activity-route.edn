#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186440939} :activity/id #uuid "b54594b5-9269-55c1-947a-7f5c52c7cdb8" :activity/steps [{:db/id #edb/ref 17592186440934 :step/content {:db/id #edb/ref 17592186440931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fdbcd60-3e81-5057-9137-ec0c999ae6c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{4}{e}^{x}+4" :db/id #edb/ref 17592186440909} {:answer/id #uuid "42ef7e8b-dd14-5712-823d-1681f0ed2cce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}{e}^{3x}+4" :db/id #edb/ref 17592186440910} {:answer/id #uuid "9316cfb5-3c9d-5c47-81ef-313e61f39c28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{4}{e}^{3x}+4" :db/id #edb/ref 17592186440917} {:answer/id #uuid "9de2dcba-6658-52b6-9531-9d55c31851da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{3}{4}{e}^{x}+4" :db/id #edb/ref 17592186440919} {:answer/id #uuid "cd39fea0-220a-508c-bb82-dbcfae1b08c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4{e}^{3x}+4" :db/id #edb/ref 17592186440923}] :answer-field/correct {:db/id #edb/ref 17592186440917} :answer-field/id #uuid "e453f27d-3265-5a94-8683-63394b11fa22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440929}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c50fb833-030a-5f7e-b663-60682ede12d9" :question/math-academy-id "q-122392" :question/problem "The length of a curve $y=f(x)$ is given by ${\\int }_{0}^{1}\\sqrt{1+\\frac{9}{16}{e}^{6x}}\\,\\text{d}x.$ Which of the following could be  an equation for this curve?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\n\\begin{aligned}L & ={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe're given that \n\n$$\nL={\\int }_{0}^{1}\\sqrt{1+\\frac{9}{16}{e}^{6x}}\\,\\text{d}x.\n$$\n\nComparing the above with the arc length formula, we see that we must have\n\n$$\n[{f}^{′}(x)]^{2}=\\frac{9}{16}{e}^{6x}\\,⟹\\,{f}^{′}(x)=\\pm \\frac{3}{4}{e}^{3x}.\n$$\n\nIntegrating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}f(x) & =\\pm \\frac{3}{4}\\int {e}^{3x}\\text{ d}x \\\\  & =\\pm \\frac{1}{4}{e}^{3x}+C.\\end{aligned}\n$$\n\nFrom the given options, the only one that has the required form is $y=\\frac{1}{4}{e}^{3x}+4.$"} :step/id #uuid "2e680767-2f69-5742-9e88-d83d12508574" :step/next {:db/id #edb/ref 17592186440937}} {:db/id #edb/ref 17592186440935 :step/content {:db/id #edb/ref 17592186440932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02156f42-01b9-5208-be76-46dd56d1f051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ -2 & 0 & -3 \\\\ 4 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186440906} {:answer/id #uuid "6988567e-c6b3-5730-a2d4-b0c476a8c21a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186440912} {:answer/id #uuid "79b811ba-d237-5358-9a7b-e5099ee68347" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}]" :db/id #edb/ref 17592186440913} {:answer/id #uuid "c40a1344-3c43-5a5d-97e2-770817ab45f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}4 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 6 & 0 & -3\\end{aligned}]" :db/id #edb/ref 17592186440921} {:answer/id #uuid "fb87aec8-67bb-5868-9fd5-615026521a6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 4 & 0 & 6 \\\\ -2 & 0 & -3\\end{aligned}]" :db/id #edb/ref 17592186440925}] :answer-field/correct {:db/id #edb/ref 17592186440913} :answer-field/id #uuid "e2b3e7c5-52c2-5e4b-bcbf-08cf2d113f06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440928}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de50db69-1f49-5b62-bb8f-7cba652094a4" :question/math-academy-id "q-130663" :question/problem "If $A=[\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}]$, then ${A}^{4}=$" :question/worked-solution "First, we compute ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}]\\cdot [\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}] \\\\  & =A\\end{aligned}\n$$\n\nNotice that ${A}^{2}=A,$ so $A$ is an idempotent matrix. \n\nWe can use this fact to compute ${A}^{4}$ quickly, as follows:\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =A\\cdot A \\\\  & ={A}^{2} \\\\  & =A\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{A}^{4}=[\\begin{aligned}4 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & -3\\end{aligned}].\n$$"} :step/id #uuid "4be5d573-c74c-5d15-84dc-67c9e32a69b2"} {:db/id #edb/ref 17592186440936 :step/content {:db/id #edb/ref 17592186179988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "855d042b-5e19-57c1-aebd-837a4c723fa8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186177598} {:answer/id #uuid "9735d708-c926-5815-8889-5570853f02e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186177599} {:answer/id #uuid "03b940a0-833c-58d6-8a18-1c3b47ecd96f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186177600} {:answer/id #uuid "4fad0e1f-267d-5afd-b2f1-2a39b852ddd9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186177601} {:answer/id #uuid "6b0c01c9-a4f7-558d-8dce-b4691d12c8aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186177602}] :answer-field/correct {:db/id #edb/ref 17592186177600} :answer-field/id #uuid "f1c4f5e0-a34a-52e9-914e-f8404a6ba8c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186177597}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "44bbbc90-f4f2-5074-bbff-3d0cc0edc535" :question/math-academy-id "q-124004" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=v-u,\\,y=u+v-1.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nI. $A=[\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]$\n\nII. $det(A)=-2$\n\nIII. The transformation $T$ is orientation-preserving" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}v-u \\\\ u+v-1\\end{aligned}] \\\\  & =[\\begin{aligned}-u+v \\\\ u+v\\end{aligned}]+[\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ -1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}].$\n\n- Statement II is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}|=1\\cdot (-1)-1\\cdot 1=-2.\n$$\n\n- Statement III is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "4d26866c-abaf-5108-9657-988713fa86d0" :step/next {:db/id #edb/ref 17592186440934}} {:db/id #edb/ref 17592186440937 :step/content {:db/id #edb/ref 17592186440930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "324ac1d0-643d-564f-8f08-9f84bb9e577a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{y}^{″}+5x{y}^{′}=0" :db/id #edb/ref 17592186440907} {:answer/id #uuid "3b8b705a-4bcd-52fc-b60f-645f76d62610" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x}{y}^{″}+5{y}^{′}+y=x-1" :db/id #edb/ref 17592186440908} {:answer/id #uuid "4ec291cf-419e-545a-91fe-9ee555957888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{y}^{″}+5x{y}^{′}+xy=0" :db/id #edb/ref 17592186440911} {:answer/id #uuid "97cda1b8-3dc0-5b1e-87da-467116629abe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{″}+x{y}^{′}+\\frac{1}{x-1}y=0" :db/id #edb/ref 17592186440918} {:answer/id #uuid "ea6650bd-3f73-576d-b334-45546a281ab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{y}^{″}+5x{y}^{′}+xy={x}^{2}" :db/id #edb/ref 17592186440924}] :answer-field/correct {:db/id #edb/ref 17592186440911} :answer-field/id #uuid "b50eac1f-2fd4-5e79-99ef-7e7a92a52cdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440927}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ce39611-61f7-5873-a772-9d52755c9e24" :question/math-academy-id "q-130992" :question/problem "For the differential equation $2{y}^{″}+5x{y}^{′}+xy={x}^{2}-x,$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n2{y}^{″}+5x{y}^{′}+xy=0.\n$$"} :step/id #uuid "68027ec1-b3e8-5d56-9340-a76e6e272009" :step/next {:db/id #edb/ref 17592186440935}} {:db/id #edb/ref 17592186440938 :step/content {:db/id #edb/ref 17592186436028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19118c24-d5da-5954-9e93-75cfa8bacbe5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3c/3c44ae1b59af6ac6f64efedcf4242aaad07ddcf98c2b63c4aeae7958a6622874.png" :db/id #edb/ref 17592186436011} {:answer/id #uuid "b68c227f-79b4-539e-9f21-17aa72aae1be" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3f/3fde41d8d88f0d843e80ae813b07ec030502bcbaa060bc5d54ade4f5207a8740.png" :db/id #edb/ref 17592186436017} {:answer/id #uuid "d4fdc308-acd9-599d-98f4-61b51923dcf4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ca/ca10c21bb658bc3075d0d66321d888c2b23596c1416f605ab0bb8cf79c40af24.png" :db/id #edb/ref 17592186436019} {:answer/id #uuid "ea4ea415-1a42-5ab9-a4f6-74d5d9c47e2c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/08/0857b5d843c6d3f5ca6218ee0f27fe169aedc59676b245578bc8db21fabe6178.png" :db/id #edb/ref 17592186436021} {:answer/id #uuid "f049c9a7-cc49-5c3f-a4df-0714b2f9933a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c6a799db8c86ff2bfb702dbba92f8d26011d33016aa33f5df1b4a58601205f04.png" :db/id #edb/ref 17592186436022}] :answer-field/correct {:db/id #edb/ref 17592186436011} :answer-field/id #uuid "adf8aa6a-75ee-5eec-b556-6b1e3d610f4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186436025}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c5ccf563-8a57-5f1f-ad06-ef72dc726ab7" :question/math-academy-id "q-129114" :question/problem "Which of the following represents the level curves of $f(x,y)={y}^{2}?$" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ {y}^{2} & =c \\\\ y & =\\pm \\sqrt{c}.\\end{aligned}\n$$\n\nNotice that the equations $y=\\pm \\sqrt{c}$ do not depend on $x.$ So, for a given $c\\in [0,\\infty ),$ the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](images/3c/3c44ae1b59af6ac6f64efedcf4242aaad07ddcf98c2b63c4aeae7958a6622874.png)"} :step/id #uuid "8ec26814-7bcf-59e5-88c6-511a1ee3466e" :step/next {:db/id #edb/ref 17592186440936}} {:db/id #edb/ref 17592186440939 :step/content {:db/id #edb/ref 17592186440933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83a1e468-48a0-529c-9588-b70d4f049914" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186440914} {:answer/id #uuid "87c2b1ac-f94b-5fb6-973f-99d22a68d888" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186440915} {:answer/id #uuid "8c5239c1-4a04-5072-9803-7ad54faa4a55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186440916} {:answer/id #uuid "b8169a30-fe00-568f-93da-b3c870742003" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186440920} {:answer/id #uuid "c7b86700-64fa-5575-94cc-8bcb588d9f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186440922}] :answer-field/correct {:db/id #edb/ref 17592186440915} :answer-field/id #uuid "7a87a3d5-8e63-570a-ac6f-5e39be95722a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186440926}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4d37934-3250-5bec-8382-fecffdb8f8b8" :question/math-academy-id "q-84194" :question/problem "A fair seven-sided die with sides labeled with numbers $1$ through $7$ is thrown once. If $X$ is the outcome of the die, what is the variance of $X?$" :question/worked-solution "We can compute the variance of a discrete random variable $X$ using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\nFirst, we need to compute the probability mass function $f(x).$ Here, there are $7$ possible outcomes ($1,2,3,4,5,6,7$) and each outcome has the same probability, so the probability mass function is as follows:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ | $\\frac{1}{7}$ |\n\nNext, we compute $\\text{E}[X].$ Summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5)+6\\cdot f(6)+7\\cdot f(7) \\\\  & =1(\\frac{1}{7})+2(\\frac{1}{7})+3(\\frac{1}{7})+4(\\frac{1}{7})+5(\\frac{1}{7})+6(\\frac{1}{7})+7(\\frac{1}{7}) \\\\  & =4.\\end{aligned}\n$$\n\nNow, we compute $\\text{E}[{X}^{2}].$ Summing up the products of each value of ${X}^{2}$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={1}^{2}\\cdot f(1)+{2}^{2}\\cdot f(2)+{3}^{2}\\cdot f(3)+{4}^{2}\\cdot f(4)+{5}^{2}\\cdot f(5)+{6}^{2}\\cdot f(6)+{7}^{2}\\cdot f(7) \\\\  & =1(\\frac{1}{7})+4(\\frac{1}{7})+9(\\frac{1}{7})+16(\\frac{1}{7})+25(\\frac{1}{7})+36(\\frac{1}{7})+49(\\frac{1}{7}) \\\\  & =20.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =20-{4}^{2} \\\\  & =20-16 \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "cea1f50c-f411-5b8e-8725-9f1453039640" :step/next {:db/id #edb/ref 17592186440940}} {:db/id #edb/ref 17592186440940 :step/content {:db/id #edb/ref 17592186125217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11794d75-cf96-590e-bdca-c3183edad1d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-\\frac{16}{9},0)$ only" :db/id #edb/ref 17592186339281} {:answer/id #uuid "13c76fe1-8968-5eaf-94ce-0c784c590365" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-\\frac{4}{3},0)$ only" :db/id #edb/ref 17592186339303} {:answer/id #uuid "247b300f-eb84-5cfa-bb3a-7eba5f99e1d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-2,0)$ and $(0,2,0)$" :db/id #edb/ref 17592186339444} {:answer/id #uuid "7f35e3af-4c69-5f9c-8224-b42028bb64b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0)$" :db/id #edb/ref 17592186340271} {:answer/id #uuid "bec8e0f2-6c92-5f29-aadc-1e46151bb7ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(0,0,0)$ and $(0,-\\frac{4}{3},0)$" :db/id #edb/ref 17592186340829}] :answer-field/correct {:db/id #edb/ref 17592186340271} :answer-field/id #uuid "0d8db404-8b1b-5e5c-8e2e-d91558bd3be8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341404}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "92b5bb6f-415d-5913-8624-6ebb244cd292" :question/math-academy-id "q-73214" :question/problem "Given the ellipsoid $\\frac{(x+1)^{2}}{9}+(y+2)^{2}+\\frac{(z-2)^{2}}{9}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{9}+(y+2)^{2}+\\frac{(0-2)^{2}}{9} & =1 \\\\ \\frac{1}{9}+(y+2)^{2}+\\frac{4}{9} & =1 \\\\ \\frac{5}{9}+(y+2)^{2} & =1 \\\\ (y+2)^{2} & =\\frac{4}{9} \\\\ y+2 & =\\pm \\frac{2}{3} \\\\ y & =-2\\pm \\frac{2}{3}\\end{aligned}\n$$\n\nHence, we get the solutions $y=-\\frac{8}{3}$ and $y=-\\frac{4}{3}.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0).$"} :step/id #uuid "de23c22a-cee1-55c5-9cbb-8003a72fc391" :step/next {:db/id #edb/ref 17592186440938}}] :activity/title "Quiz 9" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186440905}]}
