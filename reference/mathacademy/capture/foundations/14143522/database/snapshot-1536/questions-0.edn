#{[{:db/id #edb/ref 17592186179988 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "855d042b-5e19-57c1-aebd-837a4c723fa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186177598} {:answer/id #uuid "9735d708-c926-5815-8889-5570853f02e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186177599} {:answer/id #uuid "03b940a0-833c-58d6-8a18-1c3b47ecd96f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186177600} {:answer/id #uuid "4fad0e1f-267d-5afd-b2f1-2a39b852ddd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186177601} {:answer/id #uuid "6b0c01c9-a4f7-558d-8dce-b4691d12c8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186177602}] :answer-field/id #uuid "f1c4f5e0-a34a-52e9-914e-f8404a6ba8c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177597}] :question/id #uuid "44bbbc90-f4f2-5074-bbff-3d0cc0edc535" :question/math-academy-id "q-124004" :question/problem "Consider the affine transformation $T$ defined as\n\n$x = v - u, y = u + v - 1$.\n\nLet $A$ be the matrix representation of the linear transformation associated with $T$.\n\nWhich of the following statements are true?\n\n1. $A = \\begin{bmatrix}1 & 1 \\\\ 1 & 0\\end{bmatrix}$\n2. $det(A) =-2$\n3. The transformation $T$ is orientation-preserving"}] [{:db/id #edb/ref 17592186436028 :knowledge-point/_questions [{:db/id #edb/ref 17592186124476 :knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19118c24-d5da-5954-9e93-75cfa8bacbe5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3c44ae1b59af6ac6f64efedcf4242aaad07ddcf98c2b63c4aeae7958a6622874.png" :db/id #edb/ref 17592186436011} {:answer/id #uuid "b68c227f-79b4-539e-9f21-17aa72aae1be" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3f/3fde41d8d88f0d843e80ae813b07ec030502bcbaa060bc5d54ade4f5207a8740.png" :db/id #edb/ref 17592186436017} {:answer/id #uuid "d4fdc308-acd9-599d-98f4-61b51923dcf4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/ca10c21bb658bc3075d0d66321d888c2b23596c1416f605ab0bb8cf79c40af24.png" :db/id #edb/ref 17592186436019} {:answer/id #uuid "ea4ea415-1a42-5ab9-a4f6-74d5d9c47e2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/08/0857b5d843c6d3f5ca6218ee0f27fe169aedc59676b245578bc8db21fabe6178.png" :db/id #edb/ref 17592186436021} {:answer/id #uuid "f049c9a7-cc49-5c3f-a4df-0714b2f9933a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6a799db8c86ff2bfb702dbba92f8d26011d33016aa33f5df1b4a58601205f04.png" :db/id #edb/ref 17592186436022}] :answer-field/correct {:answer/id #uuid "19118c24-d5da-5954-9e93-75cfa8bacbe5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3c/3c44ae1b59af6ac6f64efedcf4242aaad07ddcf98c2b63c4aeae7958a6622874.png" :db/id #edb/ref 17592186436011} :answer-field/id #uuid "adf8aa6a-75ee-5eec-b556-6b1e3d610f4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436025}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5ccf563-8a57-5f1f-ad06-ef72dc726ab7" :question/math-academy-id "q-129114" :question/problem "Which of the following represents the level curves of $f(x,y)={y}^{2}?$" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ {y}^{2} & =c \\\\ y & =\\pm \\sqrt{c}.\\end{aligned}\n$$\n\nNotice that the equations $y=\\pm \\sqrt{c}$ do not depend on $x.$ So, for a given $c\\in [0,\\infty ),$ the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](images/3c/3c44ae1b59af6ac6f64efedcf4242aaad07ddcf98c2b63c4aeae7958a6622874.png)"}] [{:db/id #edb/ref 17592186125217 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11794d75-cf96-590e-bdca-c3183edad1d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-\\frac{16}{9},0)$ only" :db/id #edb/ref 17592186339281} {:answer/id #uuid "13c76fe1-8968-5eaf-94ce-0c784c590365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-\\frac{4}{3},0)$ only" :db/id #edb/ref 17592186339303} {:answer/id #uuid "247b300f-eb84-5cfa-bb3a-7eba5f99e1d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-2,0)$ and $(0,2,0)$" :db/id #edb/ref 17592186339444} {:answer/id #uuid "7f35e3af-4c69-5f9c-8224-b42028bb64b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0)$" :db/id #edb/ref 17592186340271} {:answer/id #uuid "bec8e0f2-6c92-5f29-aadc-1e46151bb7ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,-\\frac{4}{3},0)$" :db/id #edb/ref 17592186340829}] :answer-field/correct {:answer/id #uuid "7f35e3af-4c69-5f9c-8224-b42028bb64b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0)$" :db/id #edb/ref 17592186340271} :answer-field/id #uuid "0d8db404-8b1b-5e5c-8e2e-d91558bd3be8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92b5bb6f-415d-5913-8624-6ebb244cd292" :question/math-academy-id "q-73214" :question/problem "Given the ellipsoid $\\frac{(x+1)^{2}}{9}+(y+2)^{2}+\\frac{(z-2)^{2}}{9}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{9}+(y+2)^{2}+\\frac{(0-2)^{2}}{9} & =1 \\\\ \\frac{1}{9}+(y+2)^{2}+\\frac{4}{9} & =1 \\\\ \\frac{5}{9}+(y+2)^{2} & =1 \\\\ (y+2)^{2} & =\\frac{4}{9} \\\\ y+2 & =\\pm \\frac{2}{3} \\\\ y & =-2\\pm \\frac{2}{3}\\end{aligned}\n$$\n\nHence, we get the solutions $y=-\\frac{8}{3}$ and $y=-\\frac{4}{3}.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0).$"}]}
