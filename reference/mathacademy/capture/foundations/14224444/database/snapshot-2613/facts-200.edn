d0e-c825-53fe-8a34-c3d587ddcf8e" #edb/ref 17592186045417] [17592186543181 #edb/ref 1080 "{B}_{n}\\operatorname{sin}⁡({\\lambda }_{n}x)" #edb/ref 17592186045417] [17592186543181 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186543181 #edb/ref 1083 #uuid "d1d5e092-eb0f-57a1-9f9e-03c7c474790a" #edb/ref 17592186045417] [17592186543257 #edb/ref 1080 "\\frac{n\\pi }{14}" #edb/ref 17592186045417] [17592186543257 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186543257 #edb/ref 1083 #uuid "f0ba5cbd-77f0-51e1-853b-981e94517aea" #edb/ref 17592186045417] [17592186543396 #edb/ref 1075 #edb/ref 17592186542670 #edb/ref 17592186045417] [17592186543396 #edb/ref 1075 #edb/ref 17592186542700 #edb/ref 17592186045417] [17592186543396 #edb/ref 1075 #edb/ref 17592186542711 #edb/ref 17592186045417] [17592186543396 #edb/ref 1075 #edb/ref 17592186543076 #edb/ref 17592186045417] [17592186543396 #edb/ref 1075 #edb/ref 17592186543257 #edb/ref 17592186045417] [17592186543396 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186543396 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186543396 #edb/ref 1078 #edb/ref 17592186543257 #edb/ref 17592186045417] [17592186543396 #edb/ref 1079 #uuid "9c89b6fc-2543-5375-ab12-8c5c3b4ded4d" #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186542846 #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186542985 #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186543049 #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186543102 #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186543136 #edb/ref 17592186045417] [17592186543402 #edb/ref 1075 #edb/ref 17592186543181 #edb/ref 17592186045417] [17592186543402 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186543402 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186543402 #edb/ref 1078 #edb/ref 17592186542846 #edb/ref 17592186045417] [17592186543402 #edb/ref 1079 #uuid "9f0c0ee2-17d3-59de-a732-734f1a510b76" #edb/ref 17592186045417] [17592186543510 #edb/ref 1068 #edb/ref 17592186543396 #edb/ref 17592186045417] [17592186543510 #edb/ref 1068 #edb/ref 17592186543402 #edb/ref 17592186045417] [17592186543510 #edb/ref 1069 "q-338913" #edb/ref 17592186045417] [17592186543510 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186543510 #edb/ref 1071 "Consider the boundary value problem\n\n$$\n{y}^{″}+49{\\lambda }^{2}y=0,\\,{y}^{′}(0)={y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" #edb/ref 17592186045417] [17592186543510 #edb/ref 1072 #uuid "648c7fb6-34ca-53e3-ba2b-a6cf79213062" #edb/ref 17592186045417] [17592186543510 #edb/ref 1074 "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(0)={y}^{′}(2)=0$ yields $A=0.$ Thus, we have a nontrivial solution, so $\\lambda =0$ is a parameter corresponding to the eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+49{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 7\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(7\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(7\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x)+B\\operatorname{sin}⁡(7\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=-7A\\lambda \\operatorname{sin}⁡(7\\lambda x)+7B\\lambda \\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(0)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(0)+7B\\lambda \\operatorname{cos}⁡(0)=0\n$$\n\nwhich gives $B=0.$ So, we have\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(14\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n14\\lambda =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n\\pi }{14}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$" #edb/ref 17592186045417] [17592186543593 #edb/ref 1058 #edb/ref 17592186543607 #edb/ref 17592186045417] [17592186543593 #edb/ref 1062 #uuid "0192679b-c21d-5e4f-9008-8825cfa9a134" #edb/ref 17592186045417] [17592186543593 #edb/ref 1063 #edb/ref 17592186314743 #edb/ref 17592186045417] [17592186543607 #edb/ref 1058 #edb/ref 17592186543675 #edb/ref 17592186045417] [17592186543607 #edb/ref 1062 #uuid "19f8df0c-4ea0-5f1c-87da-fcb4ccce15a9" #edb/ref 17592186045417] [17592186543607 #edb/ref 1063 #edb/ref 17592186543510 #edb/ref 17592186045417] [17592186543624 #edb/ref 1058 #edb/ref 17592186543593 #edb/ref 17592186045417] [17592186543624 #edb/ref 1062 #uuid "3f89cf12-1a93-567d-8590-ef04e2136613" #edb/ref 17592186045417] [17592186543624 #edb/ref 1063 #edb/ref 17592186365845 #edb/ref 17592186045417] [17592186543666 #edb/ref 1062 #uuid "ce5e40bf-d203-50c5-882e-8f578e5b2d49" #edb/ref 17592186045417] [17592186543666 #edb/ref 1063 #edb/ref 17592186413439 #edb/ref 17592186045417] [17592186543675 #edb/ref 1058 #edb/ref 17592186543666 #edb/ref 17592186045417] [17592186543675 #edb/ref 1062 #uuid "fa486d33-cc4f-5a3c-b5ea-e7ebef9b5e17" #edb/ref 17592186045417] [17592186543675 #edb/ref 1063