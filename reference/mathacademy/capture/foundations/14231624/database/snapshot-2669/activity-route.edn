#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186552575} :activity/id #uuid "4e88258c-f3cd-558f-a528-d91d97358460" :activity/scope {:db/id #edb/ref 17592186050666 :topic/id #uuid "5d68aacb-ca27-5530-ae69-05289931b444" :topic/math-academy-id 3705} :activity/steps [{:db/id #edb/ref 17592186552566 :step/content {:db/id #edb/ref 17592186259709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33545c30-2c3b-5f5c-b78b-fc60e2166576" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186257233} {:answer/id #uuid "8cde1faa-5cce-5eb1-94f0-3de8b204a534" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186258021} {:answer/id #uuid "b5fa8b9f-546c-5e4d-94f9-2fe156e78cc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186258362} {:answer/id #uuid "caa4b27b-23a3-5c0c-a50b-47435d75e3d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186258542} {:answer/id #uuid "e6aade70-1020-58cc-8674-6ada589a47b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186258783}] :answer-field/correct {:db/id #edb/ref 17592186258021} :answer-field/id #uuid "8cfb7190-98b1-5652-91ba-879c636bc9f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259274}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "774a7e23-2066-572e-b119-9d6d06d53bda" :question/math-academy-id "q-124670" :question/problem "Evaluate ${\\int }_{C}(x+y)\\,dx+x\\,dy,$ where $C$ is a portion of the parabola parametrized by $r(t)=2t\\,i+(2-{t}^{2})\\,j$ for $t\\in [0,1].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2t,\\,y(t)=2-{t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2-{t}^{2})\\,j \\\\  & =2\\,i-2t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}[(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}+x\\cdot \\frac{\\text{d}y}{\\text{d}t}]dt \\\\  & ={\\int }_{0}^{1}(2t+2-{t}^{2})\\cdot 2+2t\\cdot (-2t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}-6{t}^{2}+4t+4\\,\\text{d}t \\\\  & ={[-2{t}^{3}+2{t}^{2}+4t]}_{0}^{1} \\\\  & =(-2+2+4)-0 \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "723ae454-6619-5e91-8736-69434ce3b931" :step/next {:db/id #edb/ref 17592186552576}} {:db/id #edb/ref 17592186552575 :step/content {:db/id #edb/ref 17592186357486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122f7f21-b566-5531-b051-dab6afea2aa7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+\\frac{\\pi }{4}" :db/id #edb/ref 17592186354830} {:answer/id #uuid "15d825f3-e7c6-52fe-9d59-ebe4264bfb77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi +2" :db/id #edb/ref 17592186354862} {:answer/id #uuid "60e7bc62-f1b5-5757-8860-988f2e4d54ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186355524} {:answer/id #uuid "911b65aa-26c0-52fc-bc29-9de1cc172895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\pi " :db/id #edb/ref 17592186355947} {:answer/id #uuid "d449a0a2-884a-5b40-8b30-687a32ce1e17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186356519}] :answer-field/correct {:db/id #edb/ref 17592186355524} :answer-field/id #uuid "cb00edf7-cf9d-5208-992a-8b7c1f9ad78f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357284}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0300bce9-a20a-5c73-afd7-2cf9d44f40db" :question/math-academy-id "q-90844" :question/problem "Evaluate ${\\int }_{C}-\\frac{1}{z}\\,dx+x\\,dy+dz,$ where $C$ is a portion of the helix parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+t\\,j+\\operatorname{sin}⁡t\\,k$ for $t\\in [0,\\pi ].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=t,\\,z(t)=\\operatorname{sin}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-\\frac{1}{z}\\,dx+x\\,dy+dz & ={\\int }_{0}^{\\pi }-\\frac{1}{z}\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(-\\frac{1}{z}\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }-\\frac{1}{\\operatorname{sin}⁡t}\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot 1+\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }1+2\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =(t+2\\operatorname{sin}⁡t)\\,{|}_{0}^{\\pi } \\\\  & =\\pi +2\\operatorname{sin}⁡\\pi -0 \\\\  & =\\pi \\end{aligned}\n$$"} :step/id #uuid "87645518-db9c-5c36-8845-4a8840a3493f" :step/next {:db/id #edb/ref 17592186552566}} {:db/id #edb/ref 17592186552576 :step/content {:db/id #edb/ref 17592186259744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65a36f48-5a89-51e6-a7df-d0056a07cd9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{5}{t}^{3}+2\\,dt" :db/id #edb/ref 17592186257677} {:answer/id #uuid "b8411615-0fea-58bf-bded-893520c0d517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{5}4t+5\\,dt" :db/id #edb/ref 17592186258393} {:answer/id #uuid "bcad7826-ad24-5208-b5f2-f5e961a2ca1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{5}4{t}^{2}+11t\\,dt" :db/id #edb/ref 17592186258427} {:answer/id #uuid "d2c95a94-9a34-56fb-b291-be022c933071" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{5}{t}^{2}+10t+5\\,dt" :db/id #edb/ref 17592186258624} {:answer/id #uuid "fdaeb75a-6a02-5fe0-bf80-a88692d11fb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{5}2{t}^{4}-5t\\,dt" :db/id #edb/ref 17592186259000}] :answer-field/correct {:db/id #edb/ref 17592186258427} :answer-field/id #uuid "e6949211-788f-517a-ae3c-a7a7bea5d845" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259436}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a3ee1f45-af74-5bb7-8f28-f9e9a4906e59" :question/math-academy-id "q-124865" :question/problem "Which of the following is equivalent to ${\\int }_{C}{y}^{2}\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the line $r(t)=t\\,i+2t\\,j+3t\\,k$ for $t\\in [0,5]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)=2t,\\,z(t)=3t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3t)\\,k \\\\  & =\\,i+2\\,j+3\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{2}\\,dx+x\\,dy+z\\,dz & ={\\int }_{0}^{5}{y}^{2}\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{5}({y}^{2}\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{5}4{t}^{2}\\cdot (1)+t\\cdot (2)+3t\\cdot (3)\\,dt \\\\  & ={\\int }_{0}^{5}4{t}^{2}+11t\\,dt\\end{aligned}\n$$"} :step/id #uuid "89d9743c-6099-5ef8-aa64-dc527ac1b8f7" :step/next {:db/id #edb/ref 17592186552620}} {:db/id #edb/ref 17592186552602 :step/content {:db/id #edb/ref 17592186552510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "870df5e7-d2dd-52db-87cd-a44cb0b08e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}-{sin}^{2}⁡t-\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186551991} {:answer/id #uuid "8c96aab2-e617-56ea-adf4-9a1410ec880e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡t-{sin}^{2}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186552008} {:answer/id #uuid "d73093ad-73ac-5c58-b8d0-c3d6bafffc9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t-\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186552171} {:answer/id #uuid "da162a27-0934-5a1d-ac7b-859fc607a6b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}-{sin}^{2}⁡t-\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186552179} {:answer/id #uuid "e576ae2f-fa83-5afc-b938-dd30c6775a4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡t+\\operatorname{sin}⁡(2t)-\\operatorname{cos}⁡t\\,\\text{d}t" :db/id #edb/ref 17592186552197}] :answer-field/correct {:db/id #edb/ref 17592186552179} :answer-field/id #uuid "576a1cb3-98a9-5ffe-af11-d33bc3dd7a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186552306}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d3a52378-b733-50d1-beb6-ebbc02cf54a1" :question/math-academy-id "q-124880" :question/problem "Which of the following is equivalent to ${\\int }_{C}(x+y)\\,dx+y\\,dy,$ where $C$ is parametrized by $r(t)=(\\operatorname{cos}⁡t+1)\\,i+(\\operatorname{sin}⁡t-1)\\,j$ for $t\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t+1,\\,y(t)=\\operatorname{sin}⁡t-1.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-1)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+y\\,dy & ={\\int }_{-\\pi /2}^{\\pi /2}(x+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+y\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}((x+y)\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡t+1+\\operatorname{sin}⁡t-1)\\cdot (-\\operatorname{sin}⁡t)+(\\operatorname{sin}⁡t-1)\\cdot \\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}-\\operatorname{cos}⁡t\\operatorname{sin}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t-\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}-{sin}^{2}⁡t-\\operatorname{cos}⁡t\\,\\text{d}t\\end{aligned}\n$$"} :step/id #uuid "c91e67db-7a9c-53b2-9217-6fbe27cc5976"} {:db/id #edb/ref 17592186552620 :step/content {:db/id #edb/ref 17592186387588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bd7e87c-747a-5b58-824f-0439350dcd8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{\\int }_{3}^{5}t+5\\,dt" :db/id #edb/ref 17592186387590} {:answer/id #uuid "adbe687c-bcba-5c8d-9f6b-f99ab2b6e6f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3}^{5}{t}^{2}+5\\,dt" :db/id #edb/ref 17592186387591} {:answer/id #uuid "2d0810da-6698-5f6f-82d4-9a2ac6434ae4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt" :db/id #edb/ref 17592186387592} {:answer/id #uuid "72efd909-587e-5fdc-b3de-2c81f050a94e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{\\int }_{3}^{5}{t}^{4}+t\\,dt" :db/id #edb/ref 17592186387593} {:answer/id #uuid "8e23fe22-2e7e-577d-89e3-47b8cef387ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{3}^{5}{t}^{5}+13t\\,dt" :db/id #edb/ref 17592186387594}] :answer-field/correct {:db/id #edb/ref 17592186387592} :answer-field/id #uuid "3d71fe5d-8db0-5b96-87a0-4dd728be0524" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186387589}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ecd3a3a-cbc4-5984-b2b3-63464f6c03d0" :question/math-academy-id "q-124874" :question/problem "Which of the following is equivalent to ${\\int }_{C}xy\\,dx+y\\,dy+z\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+{t}^{2}\\,j+{t}^{3}\\,k$ for $t\\in [3,5]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2},\\,z(t)={t}^{3}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,k \\\\  & =\\,i+2t\\,j+3{t}^{2}\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,dx+y\\,dy+z\\,dz & ={\\int }_{3}^{5}xy\\frac{\\text{d}x}{\\text{d}t}\\,dt+y\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{3}^{5}(xy\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{3}^{5}{t}^{3}\\cdot (1)+{t}^{2}\\cdot (2t)+{t}^{3}\\cdot (3{t}^{2})\\,dt \\\\  & ={\\int }_{3}^{5}3{t}^{5}+3{t}^{3}\\,dt \\\\  & =3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt\\end{aligned}\n$$"} :step/id #uuid "f95969c3-b1ea-5971-ac03-01ea042b5dfd" :step/next {:db/id #edb/ref 17592186552602}}] :activity/title "Sums of Line Integrals With Respect to X and Y Over Parametric Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186551650}]}
