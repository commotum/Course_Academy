b/ref 17592186162421 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186481341 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186481393 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186481396 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186481420 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186481438 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186495063 #edb/ref 17592186045417] [17592186162131 #edb/ref 1038 #edb/ref 17592186519599 #edb/ref 17592186045417] [17592186162131 #edb/ref 1039 "Further Finding Cumulative Probabilities Given Values From the Joint CDF" #edb/ref 17592186045417] [17592186162131 #edb/ref 1041 #edb/ref 17592186161697 #edb/ref 17592186045417] [17592186162131 #edb/ref 1042 #uuid "b97d9a7a-fa12-5d8d-8958-39625f117979" #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163101 #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163102 #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163103 #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163108 #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163109 #edb/ref 17592186045417] [17592186162165 #edb/ref 1043 #edb/ref 17592186163152 #edb/ref 17592186045417] [17592186162165 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162165 #edb/ref 1045 "The Joint CDF of Two Discrete Random Variables" #edb/ref 17592186045417] [17592186162165 #edb/ref 1046 #edb/ref 17592186163101 #edb/ref 17592186045417] [17592186162165 #edb/ref 1049 #edb/ref 17592186050971 #edb/ref 17592186045417] [17592186162165 #edb/ref 1050 900.0 #edb/ref 17592186045417] [17592186162165 #edb/ref 1053 #uuid "5a4d4eca-048a-559f-8986-fcbff586afd0" #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162887 #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162888 #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162889 #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162890 #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162891 #edb/ref 17592186045417] [17592186162179 #edb/ref 1043 #edb/ref 17592186162950 #edb/ref 17592186045417] [17592186162179 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162179 #edb/ref 1045 "Finding the Mode of a Continuous Random Variable" #edb/ref 17592186045417] [17592186162179 #edb/ref 1046 #edb/ref 17592186162887 #edb/ref 17592186045417] [17592186162179 #edb/ref 1049 #edb/ref 17592186050751 #edb/ref 17592186045417] [17592186162179 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186162179 #edb/ref 1053 #uuid "86e18590-207d-5dd0-a239-bda46bcecd0a" #edb/ref 17592186045417] [17592186162418 #edb/ref 1068 #edb/ref 17592186159710 #edb/ref 17592186045417] [17592186162418 #edb/ref 1069 "q-145888" #edb/ref 17592186045417] [17592186162418 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186162418 #edb/ref 1071 "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{1,2,3,4\\},\\,{S}_{Y}=\\{0,1,2,3\\}.\n$$\n\nFind an expression for the corresponding joint CDF when $x>4,y>3.$" #edb/ref 17592186045417] [17592186162418 #edb/ref 1072 #uuid "d2641b70-6005-5dd7-a26d-e0feed529994" #edb/ref 17592186045417] [17592186162418 #edb/ref 1074 "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nNote the following:\n\n- We can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{1,2,3,4\\}\\times \\{0,1,2,3\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support. Let's also consider a point $(x,y)$ where $x>4$ and $y>3,$ and a region $Δ$ that lies below and to the left of this point. \n\n![](images/57/575107f600fc73bfa39978f161d9ba9da2ec9315d7be4487e7069ceb4ac590c6.png)\n\nSince every value in the support of $X$ is at most $4$ and $x>4,$ every value in the support of $X$ satisfies $X\\le x.$ Similarly, every value in the support of $Y$ is at most $3$ and $y>3,$ so every possible value of $Y$ satisfies $Y\\le y.$\n\nTherefore, the region $Δ$ contains the entire joint support, and\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)=1.\n$$" #edb/ref 17592186045417] [17592186162887 #edb/ref 1058 #edb/ref 17592186162888 #edb/ref 17592186045417] [17592186162887 #edb/ref 1061 30822 #edb/ref 17592186045417] [17592186162887 #edb/ref 1062 #uuid "b08187da-7bd5-55f1-ab34-d07dd9eff9c6" #edb/ref 17592186045417] [17592186162887 #edb/ref 1063 #edb/ref 17592186163240 #edb/ref 17592186045417] [17592186162888 #edb/ref 1058 #edb/ref 17592186162889 #edb/ref 17592186045417] [17592186162888 #edb/ref 1061 30823 #edb/ref 17592186045417] [17592186162888 #edb/ref 1062 #uuid "a92590f7-aa6f-5fea-a68a-758cda01da2f" #edb/ref 17592186045417] [17592186162888 #edb/ref 1063 #edb/ref 17592186162001 #edb/ref 17592186045417] [17592186162889 #edb/ref 1058 #edb/ref 17592186162950 #edb/ref 17592186045417] [17592186162889 #edb/ref 1061 30824 #edb/ref 17592186045417] [17592186162889 #edb/ref 1062 #uuid "1a48bd4a-b0a3-502d-aa65-671deff1ee2f" #edb/ref 17592186045417] [17592186162889 #edb/ref 1063 #edb/ref 17592186162002 #edb/ref 17592186045417] [17592186162890 #edb/ref 1061 30825 #edb/ref 17592186045417] [17592186162890 #edb/ref 1062 #uuid "d5933bd2-e414-5eef-bf2e-16c7bba99353" #edb/ref 17592186045417] [17592186162890 #edb/ref 1063 #edb/ref 17592186162003 #edb/ref 17592186045417] [17592186162891 #edb/ref 1058 #edb/ref 17592186162890 #edb/ref 17592186045417] [17592186162891 #edb/ref 1061 30826 #edb/ref 17592186045417] [17592186162891 #edb/ref 1062 #uuid "aecb909d-327f-5105-aed5-aa3bf9d6a261" #edb/ref 17592186045417] [17592186162891 #edb/ref 1063 #edb/ref 17592186162004 #edb/ref 17592186045417] [17592186162950 #edb/ref 1058 #edb/ref 17592186162891 #edb/ref 17592186045417] [17592186162950 #edb/ref 1061 32476 #edb/ref 17592186045417] [17592186162950 #edb/ref 1062 #uuid "45276fe4-2cb4-586a-9f20-43a83aff5f9f" #edb/ref 17592186045417] [17592186162950 #edb/ref 1063 #edb/ref 17592186163259 #edb/ref 17592186045417] [17592186163101 #edb/ref 1058 #edb/ref 17592186163102 #edb/ref 17592186045417] [17592186163101 #edb/ref 1061 38838 #edb/ref 17592186045417] [17592186163101 #edb/ref 1062 #uuid "494e3329-5465-5724-b614-4ecacfaaed97" #edb/ref 17592186045417] [17592186163101 #edb/ref 1063 #edb/ref 17592186163341 #edb/ref 17592186045417] [17592186163102 #edb/ref 1058 #edb/ref 17592186163152 #edb/ref 17592186045417] [17592186163102 #edb/ref 1061 38839 #edb/ref 17592186045417] [17592186163102 #edb/ref 1062 #uuid "f666bcd7-dca8-55b3-aedf-a8ef91edbe96" #edb/ref 17592186045417] [17592186163102 #edb/ref 1063 #edb/ref 17592186162124 #edb/ref 17592186045417] [17592186163103 #edb/ref 1058 #edb/ref 17592186163109 #edb/ref 17592186045417] [17592186163103 #edb/ref 1061 38840 #edb/ref 17592186045417] [17592186163103 #edb/ref 1062 #uuid "59dbcbcc-3e03-5e5e-946c-753994f1060e" #edb/ref 17592186045417] [17592186163103 #edb/ref 1063 #edb/ref 17592186162125 #edb/ref 17592186045417] [17592186163108 #edb/ref 1058 #edb/ref 17592186163103 #edb/ref 17592186045417] [17592186163108 #edb/ref 1061 38938 #edb/ref 17592186045417] [17592186163108 #edb/ref 1062 #uuid "5ccba458-0f60-53d1-9e72-3de4cf2a6b1f" #edb/ref 17592186045417] [17592186163108 #edb/ref 1063 #edb/ref 17592186162130 #edb/ref 17592186045417] [17592186163109 #edb/ref 1061 38939 #edb/ref 17592186045417] [17592186163109 #edb/ref 1062 #uuid "2851f1ef-e083-54cd-a8c0-7dd89a1c3344" #edb/ref 17592186045417] [17592186163109 #edb/ref 1063 #edb/ref 17592186162131 #edb/ref 17592186045417] [17592186163152 #edb/ref 1058 #edb/ref 17592186163108 #edb/ref 17592186045417] [17592186163152 #edb/ref 1061 42192 #edb/ref 17592186045417] [17592186163152 #edb/ref 1062 #uuid "5d0f7f20-6219-5e6b-9d38-ad689f056506" #edb/ref 17592186045417] [17592186163152 #edb/ref 1063 #edb/ref 17592186163360 #edb/ref 17592186045417] [17592186163240 #edb/ref 1064 "The **modes of a random variable $X$** with probability density function $f(x)$ are the values of $x$ at the global maxima of $f(x).$\n\nFor example, the modes of the random variable $X$ with the probability density function shown below are ${\\color{blue}5}$ and ${\\color{blue}9}$ (the values of $x$ that correspond to the global maxima):\n\n![](images/49/49e3f3c63c01ce5c00e9d2ff51bcd03d7516f7866f510ce091071a13a8496210.png)" #edb/ref 17592186045417] [17592186163240 #edb/ref 1065 4943 #edb/ref 17592186045417] [17592186163240 #edb/ref 1066 #uuid "e0f59103-34ab-59f2-b4c8-397a02d782d1" #edb/ref 17592186045417] [17592186163240 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163259 #edb/ref 1064 "Now, suppose we are given the random variable $X$ with the probability density function shown below. \n\n![](images/ec/ec48a5d839f3d843fe4738707ec3d067a19db9b009f4bf29673d899b321248a3.svg)\n\nHow can we find the mode of $X$ algebraically? \n\nTo find the global maximum of $f(x),$ we find the critical points of $f(x)$ and then apply the candidates test.\n\nFirst, we find the critical points.\n\n- The piece of $f(x)$ defined on $0 \\leq x \\leq 1$ is $f(x) =2x.$ Taking the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2.\\end{aligned}\n$$\n\nSo, there are no solutions  of  $f'(x) = 0.$\n\n- The derivative doesn't exist at the endpoints $x = 0,1.$ So, these are critical points.\n\nNow, we evaluate $f(x)$ at the critical points $x=0,1{:}$\n\n$$\n\\begin{aligned}f(0) & =2(0)=0 \\\\ f(1) & =2(1)=2\\end{aligned}\n$$\n\nFinally, we compare all of the values above. The largest value is\n\n$$\nf({\\color{blue}1}) =2.\n$$\n\nTherefore, the mode of $X$ is ${\\color{blue}1}.$" #edb/ref 17592186045417] [17592186163259 #edb/ref 1065 5172 #edb/ref 17592186045417] [17592186163259 #edb/ref 1066 #uuid "5f6e1736-8d9b-5bc6-8af5-d7618de6d2f8" #edb/ref 17592186045417] [17592186163259 #edb/ref 1067 "Finding the Mode of a Continuous Random Variable Algebraically" #edb/ref 17592186045417] [17592186163341 #edb/ref 1064 "The **joint cumulative distribution function** (or joint CDF) of two discrete random variables $X,$ and $Y$ is defined as\n\n$$\nF(x,y) = P( X \\leq x, Y \\leq y)  = \\sum\\limits_{x_i \\leq x} \\sum\\limits_{y_i \\leq y} f(x_i, y_i).\n$$\n\nThe sets $S_X$ and $S_Y,$ on which the variables $X$ and $Y$ are defined, are the **supports** of $X$ and $Y,$ respectively.\n\nWe can see from this definition that the joint CDF is analogous to the cumulative distribution function of a single random variable.\n\nConsider the joint PMF for the discrete random variables $X$ and $Y,$ shown below.\n\n| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.2$ | $0.1$ |\n| $X=1$ | $0.3$ | $0.2$ | $0.1$ |\n\nHere, the supports of $X$ and $Y$ are $S_X = \\{ 0, 1 \\}$ and $S_Y = \\{ 0, 1, 2 \\},$ respectively. \n\nAs an example, let's compute $F(1,1).$ By definition, we have\n\n$$\n\\begin{aligned}F(1,1) & =P(X\\le 1,Y\\le 1).\\end{aligned}\n$$\n\nWe start by highlighting all cells in the table that correspond to $X \\leq 1, Y \\leq 1.$\n\n| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.2$ | $0.1$ |\n| $X=1$ | $0.3$ | $0.2$ | $0.1$ |\n\nTherefore,\n\n$$\n\\begin{aligned}F(1,1) & =f(0,0)+f(0,1)+f(1,0)+f(1,1) \\\\  & =0.1+0.2+0.3+0.2 \\\\  & =0.8.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186163341 #edb/ref 1065 6430 #edb/ref 17592186045417] [17592186163341 #edb/ref 1066 #uuid "68282cd4-eb49-54e1-a97a-8d49988c8922" #edb/ref 17592186045417] [17592186163341 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163360 #edb/ref 1064 "Consider the joint PMF for the discrete random variables $X$ and $Y,$ shown below.\n\n| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.2$ | $0.1$ |\n| $X=2$ | $0.3$ | $0.2$ | $0.1$ |\n\nWe can think of each point where $f(x,y)\\neq 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n![](images/c6/c6d8e4012a0a16f865bf229549512ff772e103d3fcd7667738cf7250d7267e84.png)\n\n \n\nNow, the joint CDF is given by\n\n$$\nF(x,y) = \\sum\\limits_{x_i \\leq x} \\sum\\limits_{y_i \\leq y} f(x_i, y_i).\n$$\n\nGeometrically, then, the joint CDF gives the total \"probability mass\" that lies inside the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axes.\n\nFor example, consider the point $(2,1.5)$ and the infinite rectangular region that has its top-right corner at this point, shown below.\n\n![](images/46/46837da3e8f8f44831da4e6b464e9f8562f322b17f584df3fc87912d1c09d4c4.png)\n\nThe value of $F(2,1.5)$ equals the total \"probability mass\" contained within this rectangle. That is,\n\n$$\nF(2,1.5) = f(1,0) + f(2,0) + f(1,1) + f(2,1).\n$$\n\nIt's worth highlighting a few important cases:\n\n- If our rectangular region doesn't include any points where the probability is nonzero, then we must have $F(x,y) = 0.$\n\n![](images/bb/bb5faa2b42c9ece2fe80cff4dd27a8b720cb363f5319c3cb5f5dd065f818c403.png)\n\n- If our rectangular region includes *all* points where the probability is nonzero, then we must have $F(x,y) = 1.$\n\n![](images/81/811b15e3cea46e0a4a546e68217a2994a7b2a7b80d6bc444bc6fbaa2ebaed355.png)\n\nFinally, we note the following properties of the joint CDF:\n\n- $0 \\leq F(x,y) \\leq 1$\n\n- The marginal CDF of $X$ is given by $F_X(x) = F(x, \\infty).$\n\n- The marginal CDF of $Y$ is given by $F_Y(y) = F( \\infty, y).$\n\n- $F(\\infty, \\infty) = 1$\n\n- $F(-\\infty,y) = F(x, -\\infty) = 0$\n\n- If $X$ and $Y$ are independent random variables, then $F(x,y) = F_X(x) \\cdot F_Y(y).$" #edb/ref 17592186045417] [17592186163360 #edb/ref 1065 6977 #edb/ref 17592186045417] [17592186163360 #edb/ref 1066 #uuid "d6a285ac-6fdf-506c-9228-20857fedc5b3" #edb/ref 17592186045417] [17592186163360 #edb/ref 1067 "Geometric Interpretation of the Joint CDF" #edb/ref 17592186045417] [17592186165189 #edb/ref 1075 #edb/ref 17592186165190 #edb/ref 17592186045417] [17592186165189 #edb/ref 1075 #edb/ref 17592186165191 #edb/ref 17592186045417] [17592186165189 #edb/ref 1075 #edb/ref 17592186165192 #edb/ref 17592186045417] [17592186165189 #edb/ref 1075 #edb/ref 17592186165193 #edb/ref 17592186045417] [17592186165189 #edb/ref 1075 #edb/ref 17592186165194 #edb/ref 17592186045417] [17592186165189 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186165189 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186165189 #edb/ref 1078 #edb/ref 17592186165194 #edb/ref 17592186045417] [17592186165189 #edb/ref 1079 #uuid "1590187d-85cc-5ce7-9d74-f442d233c0fa" #edb/ref 17592186045417] [17592186165190 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186165190 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186165190 #edb/ref 1083 #uuid "c89b52a5-e7a3-566a-9918-62a16e6087de" #edb/ref 17592186045417] [17592186165191 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186165191 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186165191 #edb/ref 1083 #uuid "f55fc263-98d6-5acb-9fd4-97e311d62182" #edb/ref 17592186045417] [17592186165192 #edb/ref 1080 "-2" #edb/ref 1