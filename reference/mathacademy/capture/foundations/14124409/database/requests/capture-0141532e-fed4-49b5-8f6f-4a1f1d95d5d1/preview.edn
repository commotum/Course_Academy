d "ca872c1a-6f89-5f8b-8336-d7cb854e1bcb" 13194139534452 17592186045417 true] [17592186422006 1080 "4y\\operatorname{cos}⁡({y}^{2})" 13194139534452 17592186045417 true] [17592186422006 1082 #edb/ref 17592186045498 13194139534452 17592186045417 true] [17592186422006 1083 #uuid "d1afdc0c-1cf1-54cf-9c95-d81dfb59dc49" 13194139534452 17592186045417 true] [17592186422007 1080 "y+x+{e}^{x}" 13194139534452 17592186045417 true] [17592186422007 1082 #edb/ref 17592186045498 13194139534452 17592186045417 true] [17592186422007 1083 #uuid "e3c5be38-2517-52b4-89a2-e748dfb3f71f" 13194139534452 17592186045417 true] [17592186422008 1075 #edb/ref 17592186421995 13194139534452 17592186045417 true] [17592186422008 1075 #edb/ref 17592186422003 13194139534452 17592186045417 true] [17592186422008 1075 #edb/ref 17592186422004 13194139534452 17592186045417 true] [17592186422008 1075 #edb/ref 17592186422005 13194139534452 17592186045417 true] [17592186422008 1075 #edb/ref 17592186422006 13194139534452 17592186045417 true] [17592186422008 1076 #edb/ref 17592186045493 13194139534452 17592186045417 true] [17592186422008 1077 "selection" 13194139534452 17592186045417 true] [17592186422008 1078 #edb/ref 17592186422006 13194139534452 17592186045417 true] [17592186422008 1079 #uuid "1a95cb7d-93f6-5084-ade9-1c85a3b6b1f1" 13194139534452 17592186045417 true] [17592186422009 1075 #edb/ref 17592186421994 13194139534452 17592186045417 true] [17592186422009 1075 #edb/ref 17592186421996 13194139534452 17592186045417 true] [17592186422009 1075 #edb/ref 17592186421998 13194139534452 17592186045417 true] [17592186422009 1075 #edb/ref 17592186421999 13194139534452 17592186045417 true] [17592186422009 1075 #edb/ref 17592186422007 13194139534452 17592186045417 true] [17592186422009 1076 #edb/ref 17592186045493 13194139534452 17592186045417 true] [17592186422009 1077 "selection" 13194139534452 17592186045417 true] [17592186422009 1078 #edb/ref 17592186421994 13194139534452 17592186045417 true] [17592186422009 1079 #uuid "31dfaa29-640a-5223-927a-6d7e182b7cd8" 13194139534452 17592186045417 true] [17592186422010 1068 #edb/ref 17592186422009 13194139534452 17592186045417 true] [17592186422010 1069 "q-65070" 13194139534452 17592186045417 true] [17592186422010 1070 #edb/ref 17592186045485 13194139534452 17592186045417 true] [17592186422010 1071 "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)={x}^{2}{y}^{2}+y{e}^{x}.$" 13194139534452 17592186045417 true] [17592186422010 1072 #uuid "11508c24-c4aa-589a-b2fa-c4b12396bfe7" 13194139534452 17592186045417 true] [17592186422010 1074 "First, we find the first-order derivative ${f}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot {y}^{2}+y\\cdot {e}^{x} \\\\  & =2x{y}^{2}+y{e}^{x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2x{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot 2y+1\\cdot {e}^{x} \\\\  & =4xy+{e}^{x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(4xy+{e}^{x}) \\\\  & =4\\cdot 1\\cdot y+{e}^{x} \\\\  & =4y+{e}^{x}\\end{aligned}\n$$" 13194139534452 17592186045417 true] [17592186422011 1068 #edb/ref 17592186422008 13194139534452 17592186045417 true] [17592186422011 1069 "q-80479" 13194139534452 17592186045417 true] [17592186422011 1070 #edb/ref 17592186045485 13194139534452 17592186045417 true] [17592186422011 1071 "Calculate ${g}_{xxy}(x,y)$ given that $g(x,y)=({x}^{2}+y)\\operatorname{sin}⁡({y}^{2}).$" 13194139534452 17592186045417 true] [17592186422011 1072 #uuid "fdce2d33-30de-52e0-89c4-590147a8c4ea" 13194139534452 17592186045417 true] [17592186422011 1074 "First, we find the first-order derivative ${g}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(({x}^{2}+y)\\operatorname{sin}⁡({y}^{2})) \\\\  & =2x\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nNext, we find ${g}_{x}(x,y)$ by differentiating ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(2x\\operatorname{sin}⁡({y}^{2})) \\\\  & =2\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nFinally, we find ${g}_{xxy}(x,y)$ by differentiating ${g}_{xx}(x,y)$ with respect to $y:$ \n\n$$\n\\begin{aligned}{g}_{xxy}(x,y) & =\\frac{∂}{∂y}({g}_{xx}(x,y)) \\\\  & =\\frac{∂}{∂y}(2\\operatorname{sin}⁡({y}^{2})) \\\\  & =4y\\operatorname{cos}⁡({y}^{2})\\end{aligned}\n$$" 13194139534452 17592186045417 true] [17592186422012 1058 #edb/ref 17592186422015 13194139534452 17592186045417 true] [17592186422012 1062 #uuid "25f65be6-b106-53d1-9640-27a18badcd80" 13194139534452 17592186045417 true] [17592186422012 1063 #edb/ref 17592186422011 13194139534452 17592186045417 true] [17592186422013 1058 #edb/ref 17592186422012 13194139534452 17592186045417 true] [17592186422013 1062 #uuid "4932cd51-46e5-51d8-99f7-f0e3336e3476" 13194139534452 17592186045417 true] [17592186422013 1063 #edb/ref 17592186422010 13194139534452 17592186045417 true] [17592186422014 1058 #edb/ref 17592186422016 13194139534452 17592186045417 true] [17592186422014 1062 #uuid "73d31843-2db2-5471-8b39-85a8ef5439bb" 13194139534452 17592186045417 true] [17592186422014 1063 #edb/ref 17592186124932 13194139534452 17592186045417 true] [17592186422015 1062 #uuid "999e1519-06f2-527e-a6e9-193c3c031bfa" 13194139534452 17592186045417 true] [17592186422015 1063 #edb/ref 17592186268920 13194139534452 17592186045417 true] [17592186422016 1058 #edb/ref 17592186422013 13194139534452 17592186045417 true] [17592186422016 1062 #uuid "ed57f383-5736-5d28-bb66-05e9dcdf8f3a" 13194139534452 17592186045417 true] [17592186422016 1063 #edb/ref 17592186124939 13194139534452 17592186045417 true]] :edb/tempids {"activity-59407835-7bfb-56b8-b3fd-56d3687982eb" 17592186421992 "answer-01