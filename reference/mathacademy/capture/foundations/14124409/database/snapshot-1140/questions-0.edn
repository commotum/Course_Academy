#{[{:db/id #edb/ref 17592186268920 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573ca17f-8b55-50aa-b136-59bd043a6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}-\\pi " :db/id #edb/ref 17592186266921} {:answer/id #uuid "5df633bf-d9fe-5623-9aed-bd0cc78f2d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186266974} {:answer/id #uuid "5fc7ddd0-7d66-560f-b925-d71f0a4f1da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}+\\pi )" :db/id #edb/ref 17592186266989} {:answer/id #uuid "75e2d132-79e6-565d-b0a0-3480a84f1042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\pi -\\sqrt{3})" :db/id #edb/ref 17592186267184} {:answer/id #uuid "aa6cc2bf-6cc9-5989-82ab-f94ca56c41d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}-\\frac{\\pi }{3})" :db/id #edb/ref 17592186267685}] :answer-field/correct {:answer/id #uuid "5df633bf-d9fe-5623-9aed-bd0cc78f2d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186266974} :answer-field/id #uuid "0722938f-1bbb-5341-b742-6808aa83c68d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3aaf83dc-c135-54d5-b395-8dc2f637ad0a" :question/math-academy-id "q-132894" :question/problem "Find ${g}_{xx}(x,y)-{g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3})$ given that ${g}_{x}(x,y)=x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)$ and ${g}_{y}(x,y)=x\\operatorname{sin}⁡(x+y).$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)) \\\\  & =\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)+\\operatorname{sin}⁡(x+y) \\\\  & =2\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡(x+y)) \\\\  & =x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})+\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6} \\\\ {g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3})-{g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6}-(-\\frac{\\pi }{6})=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186124932 :knowledge-point/_questions [{:db/id #edb/ref 17592186124441 :knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673" :knowledge-point/title "Computing Expressions Involving Second-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b1340c-9ea7-510e-a7fe-a5318d1aa165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}\\operatorname{cos}⁡y" :db/id #edb/ref 17592186421993} {:answer/id #uuid "2ea483d9-4903-536f-a106-b11346fafb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186421997} {:answer/id #uuid "646a4289-2437-5a76-800d-038e82b06562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(\\operatorname{cos}⁡y-\\operatorname{sin}⁡y)" :db/id #edb/ref 17592186422000} {:answer/id #uuid "654452d8-a947-5e7b-b22c-8a13e2ef81d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x(\\operatorname{cos}⁡y+\\operatorname{sin}⁡y)" :db/id #edb/ref 17592186422001} {:answer/id #uuid "6b0fbde1-6b7d-56c5-b32e-24ed9e9df6a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{sin}⁡y" :db/id #edb/ref 17592186422002}] :answer-field/correct {:answer/id #uuid "2ea483d9-4903-536f-a106-b11346fafb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186421997} :answer-field/id #uuid "f436de7c-3f9a-5c8c-8ef3-8a7a55ee418d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fe7b82e-efd4-53ad-afa8-cb700e6400e0" :question/math-academy-id "q-35936" :question/problem "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=2x\\operatorname{sin}⁡y$ and ${f}_{y}(x,y)={x}^{2}\\operatorname{cos}⁡y.$" :question/worked-solution "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2x\\operatorname{sin}⁡y) \\\\  & =2x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}({x}^{2}\\operatorname{cos}⁡y) \\\\  & =2x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =2x\\operatorname{cos}⁡y+2x\\operatorname{cos}⁡y \\\\  & =4x\\operatorname{cos}⁡y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124939 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9137d290-41b5-56f3-91a0-1bd21a361f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186122235} {:answer/id #uuid "9a8c61f9-4828-5963-94b5-9c4024267fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186122236} {:answer/id #uuid "fb781ced-0c22-5194-a9bf-5a48f6b0b287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{y}" :db/id #edb/ref 17592186122237} {:answer/id #uuid "54475861-eeaf-5969-a8d8-c01e85facc65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186122238} {:answer/id #uuid "74a0e08c-a99c-5a0d-80ac-df9b1bbcc42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186122239}] :answer-field/correct {:answer/id #uuid "9a8c61f9-4828-5963-94b5-9c4024267fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186122236} :answer-field/id #uuid "0485544a-7efe-5a7c-a375-d04fc25e6208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122234}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca6dfc54-54dd-5d46-99aa-e23ca5426a6a" :question/math-academy-id "q-35969" :question/problem "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)={x}^{2}y+{y}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}y+{y}^{2}\\operatorname{ln}⁡y) \\\\  & =2xy\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2xy) \\\\  & =2x\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(2x) \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186422010 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b7ad2e-54cc-50e3-9ca3-0b8efd17be6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+{e}^{x}" :db/id #edb/ref 17592186421994} {:answer/id #uuid "1f109dc7-15d8-584f-8e2b-595762c1a061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4xy+y{e}^{x}" :db/id #edb/ref 17592186421996} {:answer/id #uuid "44455996-432d-5a3d-8b99-8ba088ea40bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2xy+{e}^{x}" :db/id #edb/ref 17592186421998} {:answer/id #uuid "5e886d04-bc8d-58c5-9141-d4629aa452fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{y}^{2}+y{e}^{x}" :db/id #edb/ref 17592186421999} {:answer/id #uuid "e3c5be38-2517-52b4-89a2-e748dfb3f71f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+x+{e}^{x}" :db/id #edb/ref 17592186422007}] :answer-field/correct {:answer/id #uuid "07b7ad2e-54cc-50e3-9ca3-0b8efd17be6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y+{e}^{x}" :db/id #edb/ref 17592186421994} :answer-field/id #uuid "31dfaa29-640a-5223-927a-6d7e182b7cd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186422009}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11508c24-c4aa-589a-b2fa-c4b12396bfe7" :question/math-academy-id "q-65070" :question/problem "Calculate ${f}_{xyx}(x,y)$ given that $f(x,y)={x}^{2}{y}^{2}+y{e}^{x}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot {y}^{2}+y\\cdot {e}^{x} \\\\  & =2x{y}^{2}+y{e}^{x}\\end{aligned}\n$$\n\nNext, we find ${f}_{xy}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2x{y}^{2}+y{e}^{x}) \\\\  & =2x\\cdot 2y+1\\cdot {e}^{x} \\\\  & =4xy+{e}^{x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xyx}(x,y)$ by differentiating ${f}_{xy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{xyx}(x,y) & =\\frac{∂}{∂x}({f}_{xy}(x,y)) \\\\  & =\\frac{∂}{∂x}(4xy+{e}^{x}) \\\\  & =4\\cdot 1\\cdot y+{e}^{x} \\\\  & =4y+{e}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186422011 :knowledge-point/_questions [{:db/id #edb/ref 17592186124442 :knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38" :knowledge-point/title "Finding Higher-Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c70e303-c80e-51d2-8821-2af0cf8b3950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y\\operatorname{cos}⁡({y}^{2})-x\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186421995} {:answer/id #uuid "92245356-2a0e-55cd-8484-17313be9c3ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{cos}⁡({y}^{2})-2x\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186422003} {:answer/id #uuid "992b5993-493b-561e-9033-5437b3de59e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}^{2}\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422004} {:answer/id #uuid "ca872c1a-6f89-5f8b-8336-d7cb854e1bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x{y}^{2}\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186422005} {:answer/id #uuid "d1afdc0c-1cf1-54cf-9c95-d81dfb59dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422006}] :answer-field/correct {:answer/id #uuid "d1afdc0c-1cf1-54cf-9c95-d81dfb59dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4y\\operatorname{cos}⁡({y}^{2})" :db/id #edb/ref 17592186422006} :answer-field/id #uuid "1a95cb7d-93f6-5084-ade9-1c85a3b6b1f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186422008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdce2d33-30de-52e0-89c4-590147a8c4ea" :question/math-academy-id "q-80479" :question/problem "Calculate ${g}_{xxy}(x,y)$ given that $g(x,y)=({x}^{2}+y)\\operatorname{sin}⁡({y}^{2}).$" :question/worked-solution "First, we find the first-order derivative ${g}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(({x}^{2}+y)\\operatorname{sin}⁡({y}^{2})) \\\\  & =2x\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nNext, we find ${g}_{x}(x,y)$ by differentiating ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(2x\\operatorname{sin}⁡({y}^{2})) \\\\  & =2\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nFinally, we find ${g}_{xxy}(x,y)$ by differentiating ${g}_{xx}(x,y)$ with respect to $y:$ \n\n$$\n\\begin{aligned}{g}_{xxy}(x,y) & =\\frac{∂}{∂y}({g}_{xx}(x,y)) \\\\  & =\\frac{∂}{∂y}(2\\operatorname{sin}⁡({y}^{2})) \\\\  & =4y\\operatorname{cos}⁡({y}^{2})\\end{aligned}\n$$"}]}
