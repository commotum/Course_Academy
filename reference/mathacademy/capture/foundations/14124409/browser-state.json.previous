i><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mo>+</mo><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mi>x</mi></mrow></msub><mo stretchy=\"false\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>+</mo><mn>2</mn><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>4</mn><mi>x</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>y</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
