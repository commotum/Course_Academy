#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186421873} :activity/id #uuid "b2fb8c6f-93f0-54a5-8f0c-d3aee90f2a9b" :activity/scope {:db/id #edb/ref 17592186050992 :topic/id #uuid "77b779f9-f0f6-53e5-821f-44c6d9f4ce47" :topic/math-academy-id 1899} :activity/steps [{:db/id #edb/ref 17592186421871 :step/content {:db/id #edb/ref 17592186124801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01afdd60-14a5-5347-97c0-b145df6c08f5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/93/934de8df0f2c2a0c93d3966a66f1eed69744079f4beee57d7cc46e6ca20fddcb.png" :db/id #edb/ref 17592186121404} {:answer/id #uuid "42fd1e88-b1bd-520d-91af-11e4da73aadd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09a061a81ca4b3201e9b97ad15354c14003e41d610c2892f5b6ba468761e83b7.png" :db/id #edb/ref 17592186121405} {:answer/id #uuid "52848fa8-e0a8-5d95-b7e3-ee8a85dd9598" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/407b19e99e4fe935cc353c18afcd8576bc4a8d6fa10f5d059ff1b4a7005f4f21.png" :db/id #edb/ref 17592186121406} {:answer/id #uuid "6dae1c1d-e85c-5ad2-95d5-247890638d6a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/80/800cc48a7cbe24b302e3ea0d4ddd156bd33cb1ad45d8dafbbcef20b997c24585.png" :db/id #edb/ref 17592186121407} {:answer/id #uuid "7839d4ad-f7d4-57b2-a944-52dd9c55849d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/28/280ac039d18c0af132b0a2a85a3b94226c7ff2b310c460a1086d52402bc41865.png" :db/id #edb/ref 17592186121408}] :answer-field/correct {:db/id #edb/ref 17592186121408} :answer-field/id #uuid "51e5d630-8dfa-5699-9375-937c6eb03e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186121403}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "036420cb-4253-5cbd-8d56-15a7f64df030" :question/math-academy-id "q-158197" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{1}{x-y}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx-y\\ne 0\\,⟹\\,y\\ne x\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,y\\ne x}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $y=x$ and shade *above* and *below* the line.\n\nThe resulting domain is as follows:\n\n![](images/69/6953e2f817a786ae5ea52ea224a31b12a40a3ca89999a6bd5b1453eec11f8559.png)"} :step/id #uuid "1967cc1b-8c66-55dd-a6aa-4a116ffa9f8c"} {:db/id #edb/ref 17592186421872 :step/content {:db/id #edb/ref 17592186124798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ed55f36-0c59-534d-95e8-07b34cf2dc0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}" :db/id #edb/ref 17592186273476} {:answer/id #uuid "8cbe26d2-a7ea-57c3-b47a-0b429892c77c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le x-y\\le \\frac{\\pi }{2}}" :db/id #edb/ref 17592186273604} {:answer/id #uuid "a40eb757-e322-5c5a-ae24-103986e65d27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,0\\le x-y\\le \\pi }" :db/id #edb/ref 17592186273802} {:answer/id #uuid "b8517e7a-c661-562c-81e8-faa0f8fe98e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1,\\,x>0}" :db/id #edb/ref 17592186273983} {:answer/id #uuid "db332580-91a3-58b1-ad8e-07bfc400b3ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274306}] :answer-field/correct {:db/id #edb/ref 17592186273476} :answer-field/id #uuid "5b7c962d-3d23-53a3-911a-272dffdfe63f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274793}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8d83dba6-238e-5ccd-970d-da3225e73ce3" :question/math-academy-id "q-158181" :question/problem "Find the domain of the function  $f(x,y)=\\operatorname{arccos}⁡(x-y).$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arccosine has values between $-1$ and $1.$\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n-1\\le x-y\\le 1\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-1\\le x-y\\le 1}.\n$$"} :step/id #uuid "596527ae-7d3c-5d49-9792-ae1c3070a5b2" :step/next {:db/id #edb/ref 17592186421871}} {:db/id #edb/ref 17592186421873 :step/content {:db/id #edb/ref 17592186275453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00bacbcd-590d-557f-a9f4-6a4269e68310" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<0}" :db/id #edb/ref 17592186272390} {:answer/id #uuid "8f76b85c-0fb2-5e25-b12d-307a72a16bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 1}" :db/id #edb/ref 17592186273631} {:answer/id #uuid "df3e244c-ae04-56cb-8d2f-103fe2a767ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186274357} {:answer/id #uuid "e6619d40-8fda-56f8-ab78-d3db56de9c51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>1}" :db/id #edb/ref 17592186274424} {:answer/id #uuid "fe29f23c-2a64-564f-9465-5e972cf08268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}" :db/id #edb/ref 17592186274622}] :answer-field/correct {:db/id #edb/ref 17592186274622} :answer-field/id #uuid "7d3ee636-ed6b-5d29-ac3b-8e818ea5617f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186274851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8022d60c-ad02-52ea-a2bc-6bcc108f5f02" :question/math-academy-id "q-158179" :question/problem "Find the domain of the function $z=\\frac{1}{\\sqrt{1-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}1-{x}^{2}-{y}^{2}>0\\,⟹\\,{x}^{2}+{y}^{2}<1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}.\n$$"} :step/id #uuid "e9dc22fd-7547-5b94-95b7-ace0ad096377" :step/next {:db/id #edb/ref 17592186421872}}] :activity/title "The Domain of a Multivariable Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186421870}]}
