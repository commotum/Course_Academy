          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:110px;\n                                        margin-left:0px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"19\"><var mathquill-command-id=\"21\">A</var><var mathquill-command-id=\"23\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"25\"><span class=\"mq-sup\" mathquill-block-id=\"27\"><span mathquill-command-id=\"26\" class=\"\">−</span><span mathquill-command-id=\"28\">6</span><var mathquill-command-id=\"30\">x</var></span></span><span mathquill-command-id=\"33\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"35\">2</span><var mathquill-command-id=\"37\">x</var><span mathquill-command-id=\"39\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"41\">1</span></span></div></div>",
          "rendered_text": "Ae−6x+2x+1",
