ction" #edb/ref 17592186045417] [17592186259430 #edb/ref 1078 #edb/ref 17592186258450 #edb/ref 17592186045417] [17592186259430 #edb/ref 1079 #uuid "e4362a76-2e86-5ca7-8502-9a0cc1964b8f" #edb/ref 17592186045417] [17592186259440 #edb/ref 1075 #edb/ref 17592186257056 #edb/ref 17592186045417] [17592186259440 #edb/ref 1075 #edb/ref 17592186257170 #edb/ref 17592186045417] [17592186259440 #edb/ref 1075 #edb/ref 17592186257249 #edb/ref 17592186045417] [17592186259440 #edb/ref 1075 #edb/ref 17592186257560 #edb/ref 17592186045417] [17592186259440 #edb/ref 1075 #edb/ref 17592186258165 #edb/ref 17592186045417] [17592186259440 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186259440 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186259440 #edb/ref 1078 #edb/ref 17592186257560 #edb/ref 17592186045417] [17592186259440 #edb/ref 1079 #uuid "e9b84b78-85d8-5936-a4d9-bebaf84cdf71" #edb/ref 17592186045417] [17592186259602 #edb/ref 1068 #edb/ref 17592186259353 #edb/ref 17592186045417] [17592186259602 #edb/ref 1069 "q-124167" #edb/ref 17592186045417] [17592186259602 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186259602 #edb/ref 1071 "![](images/55/559a6b6cb717c10e60b77da402e310fc5895c814655b4ca1748eba294d712a32.png)\n\nEvaluate ${\\int }_{C}\\frac{1}{2}xy\\,\\text{d}y,$ where $C$ is the path along the upper half of the circle of radius $2,$ traversed from the point $(2,0)$ to the point $(-2,0),$ as shown above." #edb/ref 17592186045417] [17592186259602 #edb/ref 1072 #uuid "0853e6c9-d856-5aec-b1f2-e5d65484f5a2" #edb/ref 17592186045417] [17592186259602 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\nThe curve $C$ is a half of a circle of radius $2$ centered at $O.$ It can be parameterized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\pi .\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{1}{2}xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{1}{2}(2\\operatorname{cos}⁡t)(2\\operatorname{sin}⁡t) \\\\  & =2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{\\pi }f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot (2\\operatorname{cos}⁡t)\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡t,$ $\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t & =4{\\int }_{1}^{-1}{u}^{2}\\,(-\\text{d}u) \\\\  & =4{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{4}{3}{u}^{3}{|}_{-1}^{1} \\\\  & =\\frac{4}{3}[(1)^{3}-(-1)^{3}] \\\\  & =\\frac{4}{3}\\cdot 2 \\\\  & =\\frac{8}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259619 #edb/ref 1068 #edb/ref 17592186259430 #edb/ref 17592186045417] [17592186259619 #edb/ref 1069 "q-124212" #edb/ref 17592186045417] [17592186259619 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259619 #edb/ref 1071 "![](images/df/dfa95100566fce9ab113b00ae53d1a76e8977b68aa4bac0e9b6892a9930b70d4.png)\n\nEvaluate ${\\int }_{C}\\frac{y{x}^{2}+{y}^{3}}{8x}\\,\\text{d}y,$ where $C$ is the path along the lower half of the circle of radius $4,$ traversed from the point $(-4,0)$ to the point $(4,0),$ as shown above." #edb/ref 17592186045417] [17592186259619 #edb/ref 1072 #uuid "cdf631e5-2841-5a67-a8ff-d0eebc8b7e83" #edb/ref 17592186045417] [17592186259619 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\nThe curve $C$ is a part-circle of radius $4$ centered at $O.$ It can be parameterized as \n\n$$\nr(t)=⟨4\\operatorname{cos}⁡t,\\,4\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le 2\\pi .\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{y{x}^{2}+{y}^{3}}{8x},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(4\\operatorname{sin}⁡t)(4\\operatorname{cos}⁡t)^{2}+(4\\operatorname{sin}⁡t)^{3}}{8(4\\operatorname{cos}⁡t)} \\\\  & =\\frac{64\\operatorname{sin}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}{32\\operatorname{cos}⁡t} \\\\  & =\\frac{2\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =2\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{\\pi }^{2\\pi }f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{2\\pi }2\\operatorname{tan}⁡t\\cdot (4\\operatorname{cos}⁡t)\\cdot \\text{d}t \\\\  & =8{\\int }_{\\pi }^{2\\pi }\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-8\\operatorname{cos}⁡t{|}_{\\pi }^{2\\pi } \\\\  & =-8[\\operatorname{cos}⁡2\\pi -\\operatorname{cos}⁡\\pi ] \\\\  & =-8(1-(-1)) \\\\  & =-16\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259624 #edb/ref 1068 #edb/ref 17592186259338 #edb/ref 17592186045417] [17592186259624 #edb/ref 1069 "q-124223" #edb/ref 17592186045417] [17592186259624 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259624 #edb/ref 1071 "![](images/2f/2f01c4633489a913d93f86ccc83580963ea5cd41bed31347108730a7d60c3ebf.png)\n\nWhich of the following is equivalent to ${\\int }_{C}x{y}^{2}\\,\\text{d}x,$ where $C$ is the path along the ellipse $3{x}^{2}+{y}^{2}=3,$ traversed from the point $(0,\\sqrt{3})$ to the point $(0,-\\sqrt{3}),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨\\operatorname{cos}⁡t,\\,\\sqrt{3}\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186259624 #edb/ref 1072 #uuid "591574ce-dde0-5375-8d9f-24f9b5f86769" #edb/ref 17592186045417] [17592186259624 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ can be parameterized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,\\,\\sqrt{3}\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\operatorname{cos}⁡t\\cdot (\\sqrt{3}\\operatorname{sin}⁡t)^{2} \\\\  & =3\\operatorname{cos}⁡t{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{\\pi /2}^{3\\pi /2}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}3\\operatorname{cos}⁡t{sin}^{2}⁡t\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =-3{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cos}⁡t{sin}^{3}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259628 #edb/ref 1068 #edb/ref 17592186259440 #edb/ref 17592186045417] [17592186259628 #edb/ref 1069 "q-124234" #edb/ref 17592186045417] [17592186259628 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259628 #edb/ref 1071 "![](images/43/43c8d1ced440e0fe79052c1329ff3af865e1fdbfb4cc0c7ad0a9c176592358e9.png)\n\nWhich of the following is equivalent to ${\\int }_{C}(x+{y}^{2})\\,\\text{d}x,$ where $C$ is the path along the line segment from the point $(-1,1)$ to the point $(2,2),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨3t-1,\\,t+1⟩.$*" #edb/ref 17592186045417] [17592186259628 #edb/ref 1072 #uuid "a31726b8-8b33-50ff-9a55-ad044b065273" #edb/ref 17592186045417] [17592186259628 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a line segment with endpoints $(-1,1)$ and $(2,2).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(-1+t(2-(-1))),\\,(1+t(2-1))⟩ \\\\  & =⟨3t-1,\\,t+1⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t-1)=3\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3t-1)+(t+1)^{2} \\\\  & =(3t-1)+({t}^{2}+2t+1) \\\\  & ={t}^{2}+5t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}+5t)\\cdot 3\\,\\text{d}t \\\\  & =3{\\int }_{0}^{1}({t}^{2}+5t)\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259646 #edb/ref 1068 #edb/ref 17592186259305 #edb/ref 17592186045417] [17592186259646 #edb/ref 1069 "q-124273" #edb/ref 17592186045417] [17592186259646 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186259646 #edb/ref 1071 "![](images/0e/0e5257867dae67451500793687a2da24ee31a73a17c691d8d8a6dcded46e8993.png)\n\nEvaluate ${\\int }_{C}x{e}^{1-{y}^{2}}\\,\\text{d}x,$ where $C$ is the path along the three-quarters of the ellipse ${x}^{2}+9{y}^{2}=9,$ traversed from the point $(0,1)$ to the point $(3,0),$ as shown above." #edb/ref 17592186045417] [17592186259646 #edb/ref 1072 #uuid "11aa222d-e9ea-5ecd-ab97-032f5281bcab" #edb/ref 17592186045417] [17592186259646 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨3\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le 2\\pi .\n$$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=x{e}^{1-{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3\\operatorname{cos}⁡t){e}^{1-{sin}^{2}⁡t} \\\\  & =3\\operatorname{cos}⁡t{e}^{{cos}^{2}⁡t}.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{\\pi /2}^{2\\pi }f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{2\\pi }(3\\operatorname{cos}⁡t{e}^{{cos}^{2}⁡t})\\cdot (-3\\operatorname{sin}⁡t)\\cdot \\text{d}t \\\\  & =-9{\\int }_{\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t{e}^{{cos}^{2}⁡t}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u={cos}^{2}⁡t,$ $\\text{d}u=-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}-9{\\int }_{\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t{e}^{{cos}^{2}⁡t}\\,\\text{d}t & =-9{\\int }_{0}^{1}{e}^{u}\\,(-\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{9}{2}{\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{9}{2}{e}^{u}{|}_{0}^{1} \\\\  & =\\frac{9}{2}[{e}^{1}-{e}^{0}] \\\\  & =\\frac{9}{2}\\cdot (e-1) \\\\  & =\\frac{9}{2}(e-1)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259648 #edb/ref 1068 #edb/ref 17592186259275 #edb/ref 17592186045417] [17592186259648 #edb/ref 1069 "q-124279" #edb/ref 17592186045417] [17592186259648 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259648 #edb/ref 1071 "![](images/8d/8d55ece1948f9ecb7da7d489b86a297651a34f409f83ba2470f6dd06678a375e.png)\n\nWhich of the following is equivalent to ${\\int }_{C}(x-y)\\,\\text{d}y,$ where $C$ is the path along a circle of radius $3,$ traversed from the point $(0,-3)$ to the point $(0,3),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨3\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186259648 #edb/ref 1072 #uuid "7eef0fe8-9d36-5fca-a5de-d79c02a74295" #edb/ref 17592186045417] [17592186259648 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a part-circle of radius $3$ centered at $O.$ It can be parameterized as \n\n$$\nr(t)=⟨3\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,-\\frac{\\pi }{2}\\le t\\le \\frac{\\pi }{2}.\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=x-y,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t \\\\  & =3(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{-\\pi /2}^{\\pi /2}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}3(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =9{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259654 #edb/ref 1068 #edb/ref 17592186259081 #edb/ref 17592186045417] [17592186259654 #edb/ref 1069 "q-124287" #edb/ref 17592186045417] [17592186259654 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259654 #edb/ref 1071 "![](images/69/69a10b5524670d31cfc9f2982e37d58a5ee9ca39fe49f35b9dace011275a635a.png)\n\nWhich of the following is equivalent to ${\\int }_{C}(9-{y}^{2})\\,\\text{d}y,$ where $C$ is the path along three-quarters of the ellipse $9{x}^{2}+{y}^{2}=9,$ traversed from the point $(0,3)$ to the point $(1,0),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186259654 #edb/ref 1072 #uuid "76e58dcc-8bc1-5f3d-ae09-2c38a29543eb" #edb/ref 17592186045417] [17592186259654 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ can be parameterized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,\\frac{\\pi }{2}\\le t\\le 2\\pi .\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=9-{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =9-(3\\operatorname{sin}⁡t)^{2} \\\\  & =9-9{sin}^{2}⁡t \\\\  & =9(1-{sin}^{2}⁡t) \\\\  & =9{cos}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{\\pi /2}^{2\\pi }f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{2\\pi }9{cos}^{2}⁡t\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =27{\\int }_{\\pi /2}^{2\\pi }{cos}^{3}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369258 #edb/ref 1068 #edb/ref 17592186369259 #edb/ref 17592186045417] [17592186369258 #edb/ref 1069 "q-124226" #edb/ref 17592186045417] [17592186369258 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186369258 #edb/ref 1071 "![](images/f4/f402fe97e6f76cd94b94331e7f30ddb09c978c93b86ce112a5232042a2f741cc.png)\n\nWhich of the following is equivalent to ${\\int }_{C}2y\\,\\text{d}x,$ where $C$ is the path along the ellipse $9{x}^{2}+4{y}^{2}=36,$ traversed from the point $(2,0)$ to the point $(-2,0),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨2\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩.$*" #edb/ref 17592186045417] [17592186369258 #edb/ref 1072 #uuid "55218946-84ed-5872-a1c7-f6fd7a57a20f" #edb/ref 17592186045417] [17592186369258 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ can be parameterized as \n\n$$\nr(t)=⟨2\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩,\\,0\\le t\\le \\pi .\n$$\n\nComputing $\\frac{\\text{d}x}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)=2y,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(3\\operatorname{sin}⁡t) \\\\  & =6\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{0}^{\\pi }f(r(t))\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }6\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =-12{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369259 #edb/ref 1075 #edb/ref 17592186369260 #edb/ref 17592186045417] [17592186369259 #edb/ref 1075 #edb/ref 17592186369261 #edb/ref 17592186045417] [17592186369259 #edb/ref 1075 #edb/ref 17592186369262 #edb/ref 17592186045417] [17592186369259 #edb/ref 1075 #edb/ref 17592186369263 #edb/ref 17592186045417] [17592186369259 #edb/ref 1075 #edb/ref 17592186369264 #edb/ref 17592186045417] [17592186369259 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369259 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369259 #edb/ref 1078 #edb/ref 17592186369262 #edb/ref 17592186045417] [17592186369259 #edb/ref 1079 #uuid "dc543956-16a6-524a-b735-fabf30c10bc9" #edb/ref 17592186045417] [17592186369260 #edb/ref 1080 "6{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369260 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369260 #edb/ref 1083 #uuid "5a914125-7099-5b0c-a1c1-9224eef57080" #edb/ref 17592186045417] [17592186369261 #edb/ref 1080 "-6{\\int }_{0}^{\\pi }{cos}^{2}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369261 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369261 #edb/ref 1083 #uuid "7213e0d0-98dc-5715-bb95-024708c2eadc" #edb/ref 17592186045417] [17592186369262 #edb/ref 1080 "-12{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369262 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369262 #edb/ref 1083 #uuid "9a304234-899b-5867-ae14-f933577257a0" #edb/ref 17592186045417] [17592186369263 #edb/ref 1080 "12{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369263 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369263 #edb/ref 1083 #uuid "5c0a400c-fbad-505f-8344-98b05be346a3" #edb/ref 17592186045417] [17592186369264 #edb/ref 1080 "-12{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" #edb/ref 17592186045417] [17592186369264 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369264 #edb/ref 1083 #uuid "ce5940aa-094f-59da-a9fc-f4dda58c537a" #edb/ref 17592186045417] [17592186369265 #edb/ref 1068 #edb/ref 17592186369266 #edb/ref 17592186045417] [17592186369265 #edb/ref 1069 "q-124266" #edb/ref 17592186045417] [17592186369265 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186369265 #edb/ref 1071 "![](images/b2/b21c9c11aa3320a729db0d8a71f5c89069d46527e78dfc76b47ae3925387c770.png)\n\nWhich of the following is equivalent to ${\\int }_{C}(3x+2y)\\,\\text{d}y,$ where $C$ is the path along the line segment from the point $(-2,2)$ to the point $(-1,1),$ as shown above?\n\n*Hint: Use the parametrization $r(t)=⟨t-2,\\,2-t⟩.$*" #edb/ref 17592186045417] [17592186369265 #edb/ref 1072 #uuid "0acc8f31-7302-5dee-af54-ae46e10b8d37" #edb/ref 17592186045417] [17592186369265 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\n \n\nThe curve $C$ is a line segment with endpoints $(-2,2)$ and $(-1,1).$ It can be parametrized as \n\n$$\n\\begin{aligned}r(t) & =⟨(-2+t(-1-(-2))),\\,(2+t(1-2))⟩ \\\\  & =⟨t-2,\\,2-t⟩,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2-t)=-1\\end{aligned}\n$$\n\nNow, since $f(x,y)=3x+2y,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3(t-2)+2(2-t) \\\\  & =3t-6+4-2t \\\\  & =t-2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{0}^{1}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(t-2)\\cdot (-1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(2-t)\\,\\text{d}t.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369266 #edb/ref 1075 #edb/ref 17592186369267 #edb/ref 17592186045417] [17592186369266 #edb/ref 1075 #edb/ref 17592186369268 #edb/ref 17592186045417] [17592186369266 #edb/ref 1075 #edb/ref 17592186369269 #edb/ref 17592186045417] [17592186369266 #edb/ref 1075 #edb/ref 17592186369270 #edb/ref 17592186045417] [17592186369266 #edb/ref 1075 #edb/ref 17592186369271 #edb/ref 17592186045417] [17592186369266 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369266 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369266 #edb/ref 1078 #edb/ref 17592186369268 #edb/ref 17592186045417] [17592186369266 #edb/ref 1079 #uuid "ea741151-0b0f-527e-9bc4-e1287cde677a" #edb/ref 17592186045417] [17592186369267 #edb/ref 1080 "{\\int }_{0}^{1}(5-2t)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369267 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369267 #edb/ref 1083 #uuid "756639e5-ef49-5356-874a-b797a567ade2" #edb/ref 17592186045417] [17592186369268 #edb/ref 1080 "{\\int }_{0}^{1}(2-t)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369268 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369268 #edb/ref 1083 #uuid "e3f350f1-37ad-503f-9ea6-70c30ae57437" #edb/ref 17592186045417] [17592186369269 #edb/ref 1080 "{\\int }_{0}^{1}(3t+1)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369269 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369269 #edb/ref 1083 #uuid "cb15b44a-28cb-5de2-b373-a77569fe3933" #edb/ref 17592186045417] [17592186369270 #edb/ref 1080 "{\\int }_{0}^{1}({t}^{2}+3t-1)\\,\\text{d}t" #edb/ref 17592186045417] [17592186369270 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369270 #edb/ref 1083 #uuid "be76a975-6edc-58eb-8a4c-da7fbf2781b3" #edb/ref 17592186045417] [17592186369271 #edb/ref 1080 "{\\int }_{0}^{1}(1-{t}^{2})\\,\\text{d}t" #edb/ref 17592186045417] [17592186369271 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369271 #edb/ref 1083 #uuid "68681886-c9c0-5332-b1f7-d6c36341760a" #edb/ref 17592186045417] [17592186369272 #edb/ref 1068 #edb/ref 17592186369273 #edb/ref 17592186045417] [17592186369272 #edb/ref 1069 "q-124268" #edb/ref 17592186045417] [17592186369272 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186369272 #edb/ref 1071 "![](images/be/be3ad044a611d99e67c89d053d4878a2835be65828a4dc9300697bfd61822994.png)\n\nEvaluate ${\\int }_{C}{x}^{2}y\\,\\text{d}y,$ where $C$ is the path along the below-left quarter of the ellipse $4{x}^{2}+{y}^{2}=4,$ traversed from the point $(-1,0)$ to the point $(0,-2),$ as shown above." #edb/ref 17592186045417] [17592186369272 #edb/ref 1072 #uuid "bb41f199-2f33-5f68-9a53-dffe3c93ab84" #edb/ref 17592186045417] [17592186369272 #edb/ref 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{a}^{b}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t.\n$$\n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $2,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩,\\,\\pi \\le t\\le \\frac{3\\pi }{2}.\n$$\n\nComputing $\\frac{\\text{d}y}{\\text{d}t},$ we get the following:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(\\operatorname{cos}⁡t)^{2}(2\\operatorname{sin}⁡t) \\\\  & =2\\operatorname{sin}⁡t{cos}^{2}⁡t.\\end{aligned}\n$$\n\nWe can now evaluate the integral:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{\\pi }^{3\\pi /2}f(r(t))\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(2\\operatorname{sin}⁡t{cos}^{2}⁡t)\\cdot (2\\operatorname{cos}⁡t)\\cdot \\text{d}t \\\\  & =4{\\int }_{\\pi }^{3\\pi /2}\\operatorname{sin}⁡t{cos}^{3}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡t,$ $\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{\\pi }^{3\\pi /2}\\operatorname{sin}⁡t{cos}^{3}⁡t\\,\\text{d}t & =4{\\int }_{-1}^{0}{u}^{3}\\,(-\\text{d}u) \\\\  & =-4{\\int }_{-1}^{0}{u}^{3}\\,\\text{d}u \\\\  & =-{u}^{4}{|}_{-1}^{0} \\\\  & =-[(0)^{4}-(-1)^{4}] \\\\  & =-(-1) \\\\  & =1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369273 #edb/ref 1075 #edb/ref 17592186369274 #edb/ref 17592186045417] [17592186369273 #edb/ref 1075 #edb/ref 17592186369275 #edb/ref 17592186045417] [17592186369273 #edb/ref 1075 #edb/ref 17592186369276 #edb/ref 17592186045417] [17592186369273 #edb/ref 1075 #edb/ref 17592186369277 #edb/ref 17592186045417] [17592186369273 #edb/ref 1075 #edb/ref 17592186369278 #edb/ref 17592186045417] [17592186369273 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369273 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369273 #edb/ref 1078 #edb/ref 17592186369275 #edb/ref 17592186045417] [17592186369273 #edb/ref 1079 #uuid "b8f91420-1dd1-57a3-bbc3-7cd1a732535b" #edb/ref 17592186045417] [17592186369274 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186369274 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369274 #edb/ref 1083 #uuid "ce947fb0-2af2-5578-bc88-f97fd8bc5195" #edb/ref 17592186045417] [17592186369275 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186369275 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369275 #edb/ref 1083 #uuid "7faeed0c-8c4d-51f9-816f-430b26355ead" #edb/ref 17592186045417] [17592186369276 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186369276 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369276 #edb/ref 1083 #uuid "d3b4e0df-ee12-54ca-90c1-55fd453aaffb" #edb/ref 17592186045417] [17592186369277 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186369277 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369277 #edb/ref 1083 #uuid "17c11c14-5bd8-5dfc-9bc8-39959c08d204" #edb/ref 17592186045417]}
