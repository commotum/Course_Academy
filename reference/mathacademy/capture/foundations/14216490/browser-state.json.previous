      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124246-6d9a7f556d40ea0d7dbb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124246-6d9a7f556d40ea0d7dbb.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
      "captured_at": 1792013868.604567,
