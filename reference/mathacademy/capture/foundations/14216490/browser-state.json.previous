      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124212-bba6f044cb634460a29b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124212-bba6f044cb634460a29b.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
      "captured_at": 1792014106.4468176,
      "math_academy_id": "q-124212",
