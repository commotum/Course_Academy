      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124287-93e7a02460b9aa5e1b72.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124287-93e7a02460b9aa5e1b72.png",
