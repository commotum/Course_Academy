      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124226-81eb20bfe4fcd9ea7c08.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124226-81eb20bfe4fcd9ea7c08.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
