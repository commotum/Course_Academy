      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124266-d00d325d902504931e75.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124266-d00d325d902504931e75.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
      "captured_at": 1792013963.876122,
      "math_academy_id": "q-124266",
