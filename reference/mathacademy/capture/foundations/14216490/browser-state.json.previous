><mi></mi><mo>=</mo><mo>−</mo><mn>4</mn><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msubsup><msup><mi>u</mi><mn>3</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msup><mi>u</mi><mn>4</mn></msup><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">|</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">[</mo><mo stretchy=\"false\">(</mo><mn>0</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo stretchy=\"false\">]</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
