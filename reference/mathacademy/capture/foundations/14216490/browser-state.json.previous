      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124218-ac7b44ed09eab57ea396.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124218-ac7b44ed09eab57ea396.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
      "captured_at": 1792013848.0675209,
      "math_academy_id": "q-124218",
