      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124268-68861d0904af770f1116.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124268-68861d0904af770f1116.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
      "captured_at": 1792014126.712256,
      "math_academy_id": "q-124268",
