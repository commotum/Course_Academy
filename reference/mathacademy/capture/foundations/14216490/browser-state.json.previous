      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124293-b4cfbb175a15174eeacd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14216490/observations/step-q124293-b4cfbb175a15174eeacd.png",
      "source_url": "https://mathacademy.com/tasks/14216490/topics/2109/lesson",
