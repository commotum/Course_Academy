#{[{:activity/first-step {:db/id #edb/ref 17592186065313} :activity/id #uuid "73d951b2-ddb7-5e7a-805a-d3f9c5c7afd7" :activity/scope {:db/id #edb/ref 17592186048542 :topic/id #uuid "a85d3e87-9bf3-59b3-b47a-71521b5e81d2" :topic/math-academy-id 365} :activity/steps [{:db/id #edb/ref 17592186065313 :step/content {:db/id #edb/ref 17592186065383 :tutorial/content "We know how to solve related rates problems in the context of squares. We can use the same methods to solve related rates problems in the context of cubes, too.\n\nIn general, to solve a related rates problem, we need to follow three steps:\n\n**Step 1:** Draw a diagram and identify the variables that change with time.\n\n**Step 2:** Write down a relation between the time-dependent variables.\n\n**Step 3:** Differentiate the relation with respect to time and plug in the known values.\n\nLet's see this in action in the next example." :tutorial/id #uuid "ff60fc65-18a2-5e55-a0e1-0ecbd0698507" :tutorial/math-academy-id 484 :tutorial/title "Introduction"} :step/id #uuid "33231a76-9fca-526a-a863-28a8b9ba5ab0" :step/math-academy-id 897 :step/next {:db/id #edb/ref 17592186065314}} {:db/id #edb/ref 17592186065314 :step/content {:db/id #edb/ref 17592186064376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064020 :question/id #uuid "1c2e1a0e-4e7b-5029-94c3-3eb14d8869bd" :question/math-academy-id "e-222"} :knowledge-point/id #uuid "d0cf1bf7-69a3-50b2-adaa-84982ffac95e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048633} {:db/id #edb/ref 17592186049878} {:db/id #edb/ref 17592186050288}] :knowledge-point/questions [{:db/id #edb/ref 17592186064641} {:db/id #edb/ref 17592186064726} {:db/id #edb/ref 17592186375016} {:db/id #edb/ref 17592186375019} {:db/id #edb/ref 17592186375537} {:db/id #edb/ref 17592186399228}] :knowledge-point/title "Calculating the Rate of Change of a Side Given the Rate of Change of the Volume"} :step/id #uuid "de101021-b5be-55c7-a7f9-401670121e58" :step/math-academy-id 898 :st