4\\operatorname{cos}⁡t\\end{bmatrix}.\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}\\begin{bmatrix}8\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}=\\frac{8\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j}{||{r}^{′}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $a(t)=8\\operatorname{sin}⁡t.$"} :step/id #uuid "a61f17a9-02c9-5d8f-bc89-f080656ef9f3" :step/next {:db/id #edb/ref 17592186445298}} {:db/id #edb/ref 17592186445298 :step/content {:db/id #edb/ref 17592186445292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3065874e-f894-5c1a-a03f-26e6b2e6c08a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186445267} {:answer/id #uuid "5c5bdb73-6898-56ac-bbfd-188b444b01de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cos}⁡t" :db/id #edb/ref 17592186445271} {:answer/id #uuid "6f4d0844-3d2a-5a55-ac0a-b06e2d2a8f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186445273} {:answer/id #uuid "7dc69b79-8fb8-593f-825a-4bbd5ae3ad91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8\\operatorname{cos}⁡t" :db/id #edb/ref 17592186445275} {:answer/id #uuid "fad75c53-910c-59f2-aa27-ab56b7a5017d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{sin}⁡t" :db/id #edb/ref 17592186445286}] :answer-field/correct {:db/id #edb/ref 17592186445271} :answer-field/id #uuid "e2487de5-11c9-540d-8192-d573aee45967" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186445289}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79ef7418-2499-5a5e-9753-d6a82e3d1195" :question/ma