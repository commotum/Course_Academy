#{[{:db/id #edb/ref 17592186247248 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41cb02b9-13f3-5f1d-bb94-34c18d18a3a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186244889} {:answer/id #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245269} {:answer/id #uuid "7ddf9142-c44c-55fc-9780-62e19815fce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245422} {:answer/id #uuid "f2a4d81c-2941-5f57-a05a-cf24897f52ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246455} {:answer/id #uuid "b24cff0c-453c-54bf-b5a0-92ed0ff4ac54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426850}] :answer-field/correct {:answer/id #uuid "6bdc01cf-2d88-5f1d-918a-b6b8c908df28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245269} :answer-field/id #uuid "306483a6-036f-5c40-8757-606ab6fe2509" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246624}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df51ea15-f830-55ce-a2e9-e42267e5f4de" :question/math-academy-id "q-112203" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}]}_{⏟}}_{x}={{(\\,3\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,8\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=3\\cdot {b}_{1}+8\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}3 \\\\ 8\\end{aligned}].\n$$\n\nFinally, we have that ${x}_{1}=3.$"}] [{:db/id #edb/ref 17592186426857 :knowledge-point/_questions [{:db/id #edb/ref 17592186119821 :knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06febdbc-65f9-5901-99f7-6a7827495ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426843} {:answer/id #uuid "5fac1657-f0bf-58cd-839a-2936f55e9617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186426846} {:answer/id #uuid "922920ae-5499-5f5e-8c1f-2a7d78b98e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186426848} {:answer/id #uuid "a26be051-5458-55a3-b657-078318cd500e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186426849} {:answer/id #uuid "de386f32-9648-5557-95da-e81b5a893cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186426852}] :answer-field/correct {:answer/id #uuid "a26be051-5458-55a3-b657-078318cd500e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186426849} :answer-field/id #uuid "6dbd70cc-1860-587f-a06b-f6be24d7a7e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad22bfb4-da83-594b-af3c-ca1a05478310" :question/math-academy-id "q-112247" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -3\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 9\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -3\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 1\\end{aligned}] & =[\\begin{aligned}2 \\\\ 9\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & -2 & 2 \\\\ -3 & 1 & 9\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 2 \\\\ -3 & 1 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & -5 & 15\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{2}=2 \\\\ -5{x}_{2}=15.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=-3.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-2(-3)=2\\,⟹\\,{x}_{1}=-4.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-4 \\\\ -3\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-4)+(-3)=-7.$"}] [{:db/id #edb/ref 17592186247257 :knowledge-point/_questions [{:db/id #edb/ref 17592186119822 :knowledge-point/id #uuid "ed6a6ea8-6100-5224-b75f-b87c037fafbb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing More Than Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c86a8e6-6f85-5aa5-ae6d-29029bdec356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245272} {:answer/id #uuid "9aad1bac-86db-5804-9c07-c985acb44877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245681} {:answer/id #uuid "a44bbdac-4145-547d-a028-c0ec1721745f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186245782} {:answer/id #uuid "d577a31d-6124-5fbe-949c-907e0f506fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186246217} {:answer/id #uuid "f3d6cf3f-5569-5d37-8bae-a5a9fd24ed99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246466}] :answer-field/correct {:answer/id #uuid "9aad1bac-86db-5804-9c07-c985acb44877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245681} :answer-field/id #uuid "cb99454a-a003-5139-9346-c2529872576e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246914}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb853955-e8ef-5657-bd4c-789f3e409e20" :question/math-academy-id "q-112291" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ -3 \\\\ -2\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}],\\,x=[\\begin{aligned}7 \\\\ -15 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -3 \\\\ -2\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ -2 \\\\ -4\\end{aligned}] & =[\\begin{aligned}7 \\\\ -15 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & 0 & 7 \\\\ -2 & -3 & -2 & -15 \\\\ 4 & -2 & -4 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 4 & -2 & -4 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & -6 & -4 & -22\\end{aligned}] & {R}_{3} & :={R}_{3}+(-6){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 1 & 0 & 7 \\\\ 0 & -1 & -2 & -1 \\\\ 0 & 0 & 8 & -16\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}=7 \\\\ -{x}_{2}-2{x}_{3}=-1 \\\\ 8{x}_{3}=-16.\\end{aligned}\n$$\n\nFrom third equation we get ${x}_{3}=-2$ and substituting this value into the second equation yields ${x}_{2}=-2(-2)+1=5.$ Finally, substituting ${x}_{2}=5$ into the first equation, we obtain\n\n$$\n{x}_{1}+5=7\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}2 \\\\ 5 \\\\ -2\\end{aligned}].$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+5+(-2)=5.\n$$"}] [{:db/id #edb/ref 17592186426856 :knowledge-point/_questions [{:db/id #edb/ref 17592186119822 :knowledge-point/id #uuid "ed6a6ea8-6100-5224-b75f-b87c037fafbb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing More Than Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e83f3a8-e73e-5dcd-ac90-e7fbd7a63237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186426844} {:answer/id #uuid "1298c82b-5f34-5b3d-9a2e-19a4db3c3122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186426845} {:answer/id #uuid "6f2c222c-23e3-58cc-87ec-9f7920cb1f7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186426847} {:answer/id #uuid "b92f0488-96a7-580a-9581-5603eab3169c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186426851} {:answer/id #uuid "ef9d08f1-fc9e-5876-bc5a-62f5443e92fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/id #edb/ref 17592186426853}] :answer-field/correct {:answer/id #uuid "1298c82b-5f34-5b3d-9a2e-19a4db3c3122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186426845} :answer-field/id #uuid "3659e401-201b-5665-a817-8016820a5661" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426854}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "973ba0d1-71e0-5bd1-b707-8f3f23076709" :question/math-academy-id "q-34761" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ 0 \\\\ -6\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}0 \\\\ 2 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ -2 \\\\ -6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 0 \\\\ -6\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 2 \\\\ 0\\end{aligned}] & =[\\begin{aligned}6 \\\\ -2 \\\\ -6\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 4 & 0 & 6 \\\\ -3 & 0 & 2 & -2 \\\\ 0 & -6 & 0 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 4 & 0 & 6 \\\\ 0 & 12 & 2 & 16 \\\\ 0 & -6 & 0 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 4 & 0 & 6 \\\\ 0 & 12 & 2 & 16 \\\\ 0 & 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+4{x}_{2}=6 \\\\ 12{x}_{2}+2{x}_{3}=16 \\\\ {x}_{3}=2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this into the second  equation yields\n\n$$\n12{x}_{2}+2(2)=16\\,⟹\\,{x}_{2}=1.\n$$\n\n Finally,  by substituting ${x}_{2}=1$ into the first equation we obtain \n\n$$\n{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+1+2=5.\n$$"}] [{:db/id #edb/ref 17592186345147 :knowledge-point/_questions [{:db/id #edb/ref 17592186119859 :knowledge-point/id #uuid "a2926764-dfbc-5e4e-a6b0-db24a7298a64" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3425c-3f4f-50ac-9c9d-0a2e7c77dbbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186342384} {:answer/id #uuid "429a3619-daf6-5115-8c01-735449d7217d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186342791} {:answer/id #uuid "6ca6b908-2e20-5cef-bb8b-aa67933e5937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186343166} {:answer/id #uuid "7becf401-33da-536b-bc10-f41539c33323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186343306} {:answer/id #uuid "868ebaf6-e3a5-54f9-a3a1-db42d06e7646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186343397}] :answer-field/correct {:answer/id #uuid "868ebaf6-e3a5-54f9-a3a1-db42d06e7646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186343397} :answer-field/id #uuid "737ac1c3-2191-5acf-acad-aaac5e91f2b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfe9fa20-a503-5468-a775-31a4b970b2ec" :question/math-academy-id "q-75973" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :question/worked-solution "Remember, the order of the vectors in a basis is important.\n\nNotice that \n\n$$\n{{[\\begin{aligned}-3 \\\\ 4\\end{aligned}]}_{⏟}}_{x}={{(\\,4\\,)}_{⏟}}_{{x}_{1}}\\cdot {{[\\begin{aligned}0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{1}}+{{(\\,-3\\,)}_{⏟}}_{{x}_{2}}\\cdot {{[\\begin{aligned}1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{2}}\n$$\n\nwhich means that\n\n$$\nx=4\\cdot {b}_{1}+(-3)\\cdot {b}_{2}\n$$\n\nand therefore\n\n$$\n[x]_{B}=[\\begin{aligned}4 \\\\ \\,\\,-3\\end{aligned}].\n$$\n\nFinally, we have that ${x}_{2}=-3.$"}]}
