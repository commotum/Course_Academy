124630 :knowledge-point/id #uuid "879514d5-e127-5485-ab41-d459f6b5f379" :knowledge-point/title "Recognizing Parts of the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c95950f-0823-5370-bdc6-01bb92a952d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186426033} {:answer/id #uuid "273e0c96-01c0-59a1-9a8a-bbc504aefdcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186426040} {:answer/id #uuid "6b00939c-668f-5ef6-a841-a3a747721c0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1\\}" :db/id #edb/ref 17592186426051} {:answer/id #uuid "8f359088-8e4f-5c73-9327-b8f57f81b67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186426056} {:answer/id #uuid "932d7cf7-e61c-56ad-ad09-463fb4d48e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186426057}] :answer-field/correct {:answer/id #uuid "932d7cf7-e61c-56ad-ad09-463fb4d48e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186426057} :answer-field/id #uuid "ca86128d-009c-5e25-9a78-0a5e2db13bd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426069}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33a20d40-e8ca-5cc3-bf01-9f700d36b547" :question/math-academy-id "q-141191" :question/problem "$$\nA\\text{ is invertible}\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=\\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{W}}=\\text{nullity}(A)\\end{aligned}\n$$\n\nConsider the equivalence above, where $A$ is an $n\\,\\times \\,n$ matrix. Which of the following should be placed into the blank space to make a true statement?" :question/worked-solution "Recall that the *invertible matrix theorem* states the following: \n\n*Let $A$ be an $n\\,\\times \\,n$ matrix. Then we have the following equivalence:*\n\n$$\nA\\text{ is invertible}\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}\n$$\n\nTherefore, the missing expression is $0.$"}] [{:db/id #edb/ref 17592186272337 :knowledge-point/_questions [{:db/id #edb/ref 17592186124630 :knowledge-point/id #uuid "879514d5-e127-5485-ab41-d459f6b5f379" :knowledge-point/title "Recognizing Parts of the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10dd7d25-8cfc-52a1-acc2-3277c8eeb2cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "det(I-{A}^{n})" :db/id #edb/ref 17592186269419} {:answer/id #uuid "22f60b50-9d54-5d0c-bd92-26d69595fd5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{n})" :db/id #edb/ref 17592186269574} {:answer/id #uuid "9fc3a383-4f66-5f23-a4b0-402cfefdcb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186270689} {:answer/id #uuid "abdc186b-e8ae-5ad6-90c7-9f9264cfc7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{-1})" :db/id #edb/ref 17592186270802} {:answer/id #uuid "fd18314a-6226-54bc-8252-cb6f9e346896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "det({A}^{n})" :db/id #edb/ref 17592186271482}] :answer-field/correct {:answer/id #uuid "9fc3a383-4f66-5f23-a4b0-402cfefdcb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186270689} :answer-field/id #uuid "34c48b4c-89fa-5a1f-9048-8c8927a71839" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271608}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d5626a2-9938-5097-90ed-3e9019e50489" :question/math-academy-id "q-142357" :question/problem "$$\nA\\text{ is invertible}\\,⇔\\,\\{\\,\\begin{aligned} & \\bbox[3pt,white,border: 2px solid Gainsboro]{\\phantom{WW}}={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}\n$$\n\nConsider the equivalence above, where $A$ is an $n\\,\\times \\,n$ matrix. Which of the following should be placed into the blank space to make a true statement?" :question/worked-solution "Recall that the *invertible matrix theorem* states the following: \n\n*Let $A$ be an $n\\,\\times \\,n$ matrix. Then we have the following equivalence:*\n\n$$\nA\\text{ is invertible}\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}\n$$\n\nTherefore, the missing expression is $\\text{Col}(A).$"}] [{:db/id #edb/ref 17592186426076 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e3d0a6-c269-5dde-bafd-a91861927c14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186426036} {:answer/id #uuid "1848f756-51a0-5639-8084-5aa59abdaebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426037} {:answer/id #uuid "562361ed-d031-5fb2-9175-4571a3994648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186426047} {:answer/id #uuid "8a7285e7-4a5d-5073-aa0f-ffd3853ddc65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "lI only" :db/id #edb/ref 17592186426054} {:answer/id #uuid "f1d58843-37c3-5988-8dac-72db97dcd1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426064}] :answer-field/correct {:answer/id #uuid "f1d58843-37c3-5988-8dac-72db97dcd1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426064} :answer-field/id #uuid "fec9750c-eaeb-571d-b465-6fa1ab05e88d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fbccd10-1c43-51a4-ad8b-36063e11427d" :question/math-academy-id "q-142367" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $v=[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}]$ is a solution of the equation $Ax=0?$\n\nI. $\\text{dim(Null}(A))\\ne 0$\n\nII. $A$  is  invertible\n\nIII. $\\text{Col}(A)={R}^{4}$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn. \n\n- Statement I is true. Since $v\\ne 0$ and $Av=0,$ \nthen $v\\in \\text{Null}(A)$ and, therefore, $\\text{dim(Null}(A))\\ne 0.$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is false. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{4}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186426074 :knowledge-point/_questions [{:db/id #edb/ref 17592186124630 :knowledge-point/id #uuid "879514d5-e127-5485-ab41-d459f6b5f379" :knowledge-point/title "Recognizing Parts of the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b25edc-b99e-5683-bc78-86b9980302d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186426049} {:answer/id #uuid "689ca3d8-8583-5b72-bea0-6f1b9b6117f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{I}_{n\\times n}" :db/id #edb/ref 17592186426050} {:answer/id #uuid "bab99505-cf3b-5584-bca4-4d0e0cbc9cd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{-1})" :db/id #edb/ref 17592186426061} {:answer/id #uuid "c9023723-f6af-5dbc-9f3c-83dd8cbd448c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186426063} {:answer/id #uuid "f578f28e-933d-5e8f-878b-46984a7720a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id #edb/ref 17592186426065}] :answer-field/correct {:answer/id #uuid "c9023723-f6af-5dbc-9f3c-83dd8cbd448c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186426063} :answer-field/id #uuid "bcefd7d7-6332-5b93-9f2c-e15574d03741" :ans