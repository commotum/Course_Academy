6045417] [17592186559796 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186559796 #edb/ref 1071 "$$\nR\\,\\bbox[5px,border:1px solid black]{\\phantom{A}}={Q}^{T}\\,\\bbox[5px,border:1px solid black]{\\phantom{A}}\n$$\n\nLet $A=QR$  be a QR decomposition of an $m\\times n$ matrix $A$ with linearly independent columns, and the matrix equation above gives the least-squares solution of $Ax=b.$ From left to right, what are the missing parts of the equation?" #edb/ref 17592186045417] [17592186559796 #edb/ref 1072 #uuid "3a651338-245e-55fb-922d-e222a82f10f8" #edb/ref 17592186045417] [17592186559796 #edb/ref 1074 "The least-squares solution of $Ax=b$ satisfies the normal equation\n\n$$\n{A}^{T}Ax={A}^{T}b.\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ R\\,\\,x & ={Q}^{T}\\,\\,b.\\end{aligned}\n$$\n\nTherefore, the missing parts of the equation are $x$ and $b.$" #edb/ref 17592186045417] [17592186564048 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186564048 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186564048 #edb/ref 1083 #uuid "2e9e21c3-28d7-5744-b751-8735eef80c3e" #edb/ref 17592186045417] [17592186564085 #edb/ref 1080 "[\\begin{aligned}-9 \\\\ 3\\end{aligned}]" #edb/ref 17592186045417] [17592186564085 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186564085 #edb/ref 1083 #uuid "45ccbd17-a611-5e51-8f96-c134314902f7" #edb/ref 17592186045417] [17592186564139 #edb/ref 1080 "[\\begin{aligned}-3 \\\\ 9\\end{aligned}]" #edb/ref 17592186045417] [17592186564139 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186564139 #edb/ref 1083 #uuid "6c912a39-aa9c-5584-bd27-ebb5f9b76c23" #edb/ref 17592186045417] [17592186564186 #edb/ref 1080 "[\\begin{aligned}-9 \\\\ 9\\end{aligned}]" #edb/ref 17592186045417] [17592186564186 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186564186 #edb/ref 1083 #uuid "8c06bd3e-d522-582e-8e6e-842930f9ae84" #edb/ref 17592186045417] [17592186564235 #edb/ref 1080 "[\\begin{aligned}-6 \\\\ 6\\end{aligned}]" #edb/ref 17592186045417] [17592186564235 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186564235 #edb/ref 1083 #uuid "ae08b2e2-ed79-5464-95a9-3d40e4f6d24d" #edb/ref 17592186045417] [17592186564425 #edb/ref 1075 #edb/ref 17592186564048 #edb/ref 17592186045417] [17592186564425 #edb/ref 1075 #edb/ref 17592186564085 #edb/ref 17592186045417] [17592186564425 #edb/ref 1075 #edb/ref 17592186564139 #edb/ref 17592186045417] [17592186564425 #edb/ref 1075 #edb/ref 17592186564186 #edb/ref 17592186045417] [17592186564425 #edb/ref 1075 #edb/ref 17592186564235 #edb/ref 17592186045417] [17592186564425 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186564425 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186564425 #edb/ref 1078 #edb/ref 17592186564186 #edb/ref 17592186045417] [17592186564425 #edb/ref 1079 #uuid "99733e29-1d7e-5770-81f4-dc925a89eb32" #edb/ref 17592186045417] [17592186564531 #edb/ref 1068 #edb/ref 17592186564425 #edb/ref 17592186045417] [17592186564531 #edb/ref 1069 "q-139798" #edb/ref 17592186045417] [17592186564531 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186564531 #edb/ref 1071 "Given the QR decomposition $A=QR,$ find the least-squares solution to $Ax=b,$ where\n\n$$\nQ=\\frac{1}{9}[\\begin{aligned}8 & -1 \\\\ 4 & 4 \\\\ -1 & 8\\end{aligned}],\\,R=\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186564531 #edb/ref 1072 #uuid "e0061631-6269-58a0-a054-4e33a330ba6f" #edb/ref 17592186045417] [17592186564531 #edb/ref 1074 "The least-squares solution $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}8 & 4 & -1 \\\\ -1 & 4 & 8\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}} \\\\ [\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]x & =[\\begin{aligned}-9 \\\\ 9\\end{aligned}]\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\{\\begin{aligned}9{x}_{1}+8{x}_{2}=-9 \\\\ {x}_{2}=9.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=9.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}9{x}_{1}+8(9) & =-9 \\\\ 9{x}_{1} & =-81 \\\\ {x}_{1} & =-9.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $[\\begin{aligned}-9 \\\\ 9\\end{aligned}].$" #edb/ref 17592186045417]}
