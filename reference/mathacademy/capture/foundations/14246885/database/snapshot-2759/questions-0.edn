herefore, the missing parts of the equation are ${R}^{-1}$ and $b.$"}] [{:db/id #edb/ref 17592186410808 :knowledge-point/_questions [{:db/id #edb/ref 17592186133906 :knowledge-point/id #uuid "c7d226d3-f7d3-574f-94f9-a532ec99b0ac" :knowledge-point/title "Identifying an Expression for a Least-Squares Solution in Terms of the Matrices Q and R"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09435933-4c28-52dd-8678-41dcf0848333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{T}" :db/id #edb/ref 17592186410779} {:answer/id #uuid "24985731-b6b9-5e8d-820b-1f13827d0949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R-m\\cdot I)" :db/id #edb/ref 17592186410783} {:answer/id #uuid "50d2e581-451b-5360-b4da-e26396ea468e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R-I)" :db/id #edb/ref 17592186410788} {:answer/id #uuid "7dceedd7-4b1f-5a60-b090-4dc26f3702e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{-1}" :db/id #edb/ref 17592186410790} {:answer/id #uuid "91cae48a-5ff2-5a13-a3b1-20c945ab4731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{T}R" :db/id #edb/ref 17592186410792}] :answer-field/correct {:answer/id #uuid "7dceedd7-4b1f-5a60-b090-4dc26f3702e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{-1}" :db/id #edb/ref 17592186410790} :answer-field/id #uuid "3eb41613-58b3-5878-8f3f-4404da6faf4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e50c9b4-d5fe-527c-b554-c5ae45ba5355" :question/math-academy-id "q-158081" :question/problem "$$\nx=\\bbox[5px,border:1px solid blac