          "input_html": "<div id=\"freeResponseTextbox-2\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:80px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"3\"><span mathquill-command-id=\"7\">9</span><span mathquill-command-id=\"9\">(</span><var mathquill-command-id=\"11\">y</var><span mathquill-command-id=\"13\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"15\">4</span><span mathquill-command-id=\"17\">)</span></span></div></div>",
          "rendered_text": "9(y+4)",
