3</mn><mn>4</mn></mfrac></mstyle><msup><mi>t</mi><mn>2</mn></msup><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mi>y</mi><mo>+</mo><mn>4</mn><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mi>t</mi><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
