</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mo stretchy=\"false\">(</mo><mi>y</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><mn>3</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>6</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mo stretchy=\"false\">(</mo><mi>y</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
