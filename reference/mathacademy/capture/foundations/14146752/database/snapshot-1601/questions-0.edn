#{[{:db/id #edb/ref 17592186265839 :knowledge-point/_questions [{:db/id #edb/ref 17592186087773 :knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d8a3c5-5363-5440-81b4-736a6ed048c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+Bx{e}^{-2x}" :db/id #edb/ref 17592186263316} {:answer/id #uuid "4be3230f-287e-5bc5-bb8a-0bc800ebb580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+Bx{e}^{-4x}" :db/id #edb/ref 17592186263653} {:answer/id #uuid "54d9255b-1d3e-556a-8e47-22f8f0859221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{2x}" :db/id #edb/ref 17592186263729} {:answer/id #uuid "95061659-d6cf-5b2a-ac7e-6647bf34f7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+Bx{e}^{2x}" :db/id #edb/ref 17592186264276} {:answer/id #uuid "acb55b46-a13b-5b43-98b6-e37cd7cfa6e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+B{e}^{4x}" :db/id #edb/ref 17592186264485}] :answer-field/correct {:answer/id #uuid "24d8a3c5-5363-5440-81b4-736a6ed048c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{-2x}+Bx{e}^{-2x}" :db/id #edb/ref 17592186263316} :answer-field/id #uuid "a5a73307-ba25-593c-b49a-b3c51f5baaf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd7e4f6c-a1fc-5a7a-9880-7a238668b459" :question/math-academy-id "q-130138" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+4\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda +2)(\\lambda +2)=0 \\\\ (\\lambda +2)^{2}=0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =-2$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+Bx{e}^{-2x}.\n$$"}] [{:db/id #edb/ref 17592186265843 :knowledge-point/_questions [{:db/id #edb/ref 17592186087774 :knowledge-point/id #uuid "b4ad20bb-c6a4-5390-a11a-e5277cfd1667" :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c7eef7-3d78-5989-86e0-94ecf6198c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-2x}+x{e}^{-2x}" :db/id #edb/ref 17592186263025} {:answer/id #uuid "9a6f9528-c212-5abe-9e54-8bfc43b253d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-2x}" :db/id #edb/ref 17592186264323} {:answer/id #uuid "b0c75313-b7a0-5910-aede-49a9ecc39bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-x}" :db/id #edb/ref 17592186264524} {:answer/id #uuid "b4adbff7-3555-5242-bfca-c5d264d3ce55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}-x{e}^{-2x}" :db/id #edb/ref 17592186264553} {:answer/id #uuid "d2a21b02-ca2e-51b8-92c2-391a79250846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{e}^{-2x}" :db/id #edb/ref 17592186264837}] :answer-field/correct {:answer/id #uuid "b0c75313-b7a0-5910-aede-49a9ecc39bff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{e}^{-x}" :db/id #edb/ref 17592186264524} :answer-field/id #uuid "a4383e0a-d8be-5d10-8611-d4c6afc8cf56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94dec214-fc61-500b-bffe-c52024a2504b" :question/math-academy-id "q-130147" :question/problem "Given the equation ${y}^{″}+4{y}^{′}+4y=0$ for $y=y(x),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +4 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}(\\lambda +2)^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =-2$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{-2x}$ and $x{e}^{-2x}$ is a solution to the original differential equation. \n\nAmong the given options, only $4{e}^{-x}$ is not a solution."}] [{:db/id #edb/ref 17592186348053 :knowledge-point/_questions [{:db/id #edb/ref 17592186087773 :knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b85ad48-9f95-542b-b9e7-333573122a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{5x}+B{e}^{x/2}" :db/id #edb/ref 17592186345999} {:answer/id #uuid "5df5ae30-aca2-5b8b-a7ef-ab9a0e07d1b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{3x/2}+Bx{e}^{3x/2}" :db/id #edb/ref 17592186346157} {:answer/id #uuid "87ddb655-179d-58ca-aee8-81d2759013c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{5x}+B{e}^{5x/2}" :db/id #edb/ref 17592186346529} {:answer/id #uuid "a30734ea-8cc5-594e-99de-f5929b08b6ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{5x/2}" :db/id #edb/ref 17592186346763} {:answer/id #uuid "ade2ac4a-023e-51b4-86dd-4276ec9f1a4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{-5x/2}" :db/id #edb/ref 17592186346867}] :answer-field/correct {:answer/id #uuid "a30734ea-8cc5-594e-99de-f5929b08b6ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{5x/2}" :db/id #edb/ref 17592186346763} :answer-field/id #uuid "ddfd4a05-11a3-55b9-a24a-46a074d48938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3297f16-33bd-57f9-a38b-3244518aab25" :question/math-academy-id "q-7796" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+\\frac{25y}{4}=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+\\frac{25}{4}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +\\frac{25}{4}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +\\frac{25}{4}=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -\\frac{5}{2})(\\lambda -\\frac{5}{2}) & =0 \\\\ {(\\lambda -\\frac{5}{2})}^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =\\frac{5}{2}$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{5x/2}+Bx{e}^{5x/2}.\n$$"}]}
