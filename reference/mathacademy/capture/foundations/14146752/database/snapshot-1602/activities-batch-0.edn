#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186088643} :activity/id #uuid "c7c1a0ce-38f8-537d-a8f0-5c255830b86e" :activity/scope {:db/id #edb/ref 17592186050433 :topic/id #uuid "48b31687-d86d-5039-a373-e5b296daf525" :topic/math-academy-id 879} :activity/steps [{:db/id #edb/ref 17592186088643 :step/content {:db/id #edb/ref 17592186088941 :tutorial/content "When the characteristic equation of a second-order homogeneous ODE has a **repeated root** $\\lambda = c,$ the general solution is\n\n$$\ny(x) = Ae^{cx} + Bxe^{cx}.\n$$\n\nTo illustrate, let's solve the following ODE:\n\n$$\n\\frac{\\textrm{d}^2 y}{\\textrm{d} x^2} - 6\\frac{\\textrm{d} y}{\\textrm{d} x} + 9y =0.\n$$\n\nAssuming a solution of the form $y=e^{\\lambda x},$ we differentiate and substitute into the ODE:\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-6\\lambda {e}^{\\lambda x}+9{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-6\\lambda +9) & =0.\\end{aligned}\n$$\n\nSince $e^{\\lambda x}$ is never zero, we can divide by it to get the **characteristic equation**:\n\n$$\n\\begin{aligned}{\\lambda }^{2}-6\\lambda +9 & =0 \\\\ (\\lambda -3)^{2} & =0,\\end{aligned}\n$$\n\nso $\\lambda = 3$ is a **repeated root**. Therefore, the general solution is\n\n$$\ny(x) = Ae^{3x} + Bxe^{3x}.\n$$" :tutorial/id #uuid "a4fc9c29-f54a-5346-b7b3-59abdf8bb39f" :tutorial/math-academy-id 4049 :tutorial/title "Introduction"} :step/id #uuid "0a076b74-a850-5e47-b647-e51c36c1259a" :step/math-academy-id 24226 :step/next {:db/id #edb/ref 17592186088644}} {:db/id #edb/ref 17592186088644 :step/content {:db/id #edb/ref 17592186087772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087592 :question/id #uuid "81531c55-fe2e-5eff-82ba-9e08abf24a0e" :question/math-academy-id "e-6591"} :knowledge-point/id #uuid "f5fb4d6b-2c86-5ad6-898b-5a1cd44e4106" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048391}] :knowledge-point/questions [{:db/id #edb/ref 17592186088232} {:db/id #edb/ref 17592186088238} {:db/id #edb/ref 17592186265834} {:db/id #edb/ref 17592186265835} {:db/id #edb/ref 17592186265836} {:db/id #edb/ref 17592186265837} {:db/id #edb/ref 17592186335747} {:db/id #edb/ref 17592186423299}] :knowledge-point/title "Constructing and Solving a Characteristic Equation With Repeated Roots"} :step/id #uuid "f1046776-23ad-5801-b3b5-f777cbc55e3b" :step/math-academy-id 24228 :step/next {:db/id #edb/ref 17592186088645}} {:db/id #edb/ref 17592186088645 :step/content {:db/id #edb/ref 17592186087773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087593 :question/id #uuid "3363cf38-10a2-5a55-9451-ee2101b8e809" :question/math-academy-id "e-6592"} :knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/questions [{:db/id #edb/ref 17592186088346} {:db/id #edb/ref 17592186088347} {:db/id #edb/ref 17592186265839} {:db/id #edb/ref 17592186265840} {:db/id #edb/ref 17592186265841} {:db/id #edb/ref 17592186345350} {:db/id #edb/ref 17592186348053} {:db/id #edb/ref 17592186357491} {:db/id #edb/ref 17592186357492} {:db/id #edb/ref 17592186423300}] :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"} :step/id #uuid "e78e8b59-e0a4-5f68-8156-3b7d5844fde6" :step/math-academy-id 24229 :step/next {:db/id #edb/ref 17592186088646}} {:db/id #edb/ref 17592186088646 :step/content {:db/id #edb/ref 17592186087774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087594 :question/id #uuid "abc842b6-8b86-585c-a425-5776909c6425" :question/math-academy-id "e-6593"} :knowledge-point/id #uuid "b4ad20bb-c6a4-5390-a11a-e5277cfd1667" :knowledge-point/questions [{:db/id #edb/ref 17592186088233} {:db/id #edb/ref 17592186088239} {:db/id #edb/ref 17592186265842} {:db/id #edb/ref 17592186265843} {:db/id #edb/ref 17592186265844} {:db/id #edb/ref 17592186357493} {:db/id #edb/ref 17592186357494} {:db/id #edb/ref 17592186357495} {:db/id #edb/ref 17592186423301} {:db/id #edb/ref 17592186444007} {:db/id #edb/ref 17592186444008}] :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"} :step/id #uuid "8392881d-182b-5602-83c1-1fbe45b22882" :step/math-academy-id 24230}] :activity/title "Second-Order Homogeneous ODEs: Characteristic Equations With Repeated Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087944}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186444009} :activity/id #uuid "d70c6a0e-1f3c-563a-8c55-406c4c3e138f" :activity/scope {:db/id #edb/ref 17592186050433 :topic/id #uuid "48b31687-d86d-5039-a373-e5b296daf525" :topic/math-academy-id 879} :activity/steps [{:db/id #edb/ref 17592186444009 :step/content {:db/id #edb/ref 17592186348053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b85ad48-9f95-542b-b9e7-333573122a0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{5x}+B{e}^{x/2}" :db/id #edb/ref 17592186345999} {:answer/id #uuid "5df5ae30-aca2-5b8b-a7ef-ab9a0e07d1b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{3x/2}+Bx{e}^{3x/2}" :db/id #edb/ref 17592186346157} {:answer/id #uuid "87ddb655-179d-58ca-aee8-81d2759013c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{5x}+B{e}^{5x/2}" :db/id #edb/ref 17592186346529} {:answer/id #uuid "a30734ea-8cc5-594e-99de-f5929b08b6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{5x/2}+Bx{e}^{5x/2}" :db/id #edb/ref 17592186346763} {:answer/id #uuid "ade2ac4a-023e-51b4-86dd-4276ec9f1a4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{5x/2}+Bx{e}^{-5x/2}" :db/id #edb/ref 17592186346867}] :answer-field/correct {:db/id #edb/ref 17592186346763} :answer-field/id #uuid "ddfd4a05-11a3-55b9-a24a-46a074d48938" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347995}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a3297f16-33bd-57f9-a38b-3244518aab25" :question/math-academy-id "q-7796" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+\\frac{25y}{4}=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+\\frac{25}{4}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +\\frac{25}{4}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +\\frac{25}{4}=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -\\frac{5}{2})(\\lambda -\\frac{5}{2}) & =0 \\\\ {(\\lambda -\\frac{5}{2})}^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =\\frac{5}{2}$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{5x/2}+Bx{e}^{5x/2}.\n$$"} :step/id #uuid "0f286fd7-1908-5288-96d6-dcf89110d360" :step/next {:db/id #edb/ref 17592186444013}} {:db/id #edb/ref 17592186444010 :step/content {:db/id #edb/ref 17592186265839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d8a3c5-5363-5440-81b4-736a6ed048c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+Bx{e}^{-2x}" :db/id #edb/ref 17592186263316} {:answer/id #uuid "4be3230f-287e-5bc5-bb8a-0bc800ebb580" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-4x}+Bx{e}^{-4x}" :db/id #edb/ref 17592186263653} {:answer/id #uuid "54d9255b-1d3e-556a-8e47-22f8f0859221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{2x}" :db/id #edb/ref 17592186263729} {:answer/id #uuid "95061659-d6cf-5b2a-ac7e-6647bf34f7e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{2x}+Bx{e}^{2x}" :db/id #edb/ref 17592186264276} {:answer/id #uuid "acb55b46-a13b-5b43-98b6-e37cd7cfa6e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=A{e}^{-2x}+B{e}^{4x}" :db/id #edb/ref 17592186264485}] :answer-field/correct {:db/id #edb/ref 17592186263316} :answer-field/id #uuid "a5a73307-ba25-593c-b49a-b3c51f5baaf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265537}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dd7e4f6c-a1fc-5a7a-9880-7a238668b459" :question/math-academy-id "q-130138" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+4\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda +2)(\\lambda +2)=0 \\\\ (\\lambda +2)^{2}=0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =-2$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+Bx{e}^{-2x}.\n$$"} :step/id #uuid "12f24fc0-6891-5b1a-9924-a75b1a7ee50c" :step/next {:db/id #edb/ref 17592186444011}} {:db/id #edb/ref 17592186444011 :step/content {:db/id #edb/ref 17592186265843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c7eef7-3d78-5989-86e0-94ecf6198c5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-2x}+x{e}^{-2x}" :db/id #edb/ref 17592186263025} {:answer/id #uuid "9a6f9528-c212-5abe-9e54-8bfc43b253d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{-2x}" :db/id #edb/ref 17592186264323} {:answer/id #uuid "b0c75313-b7a0-5910-aede-49a9ecc39bff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-x}" :db/id #edb/ref 17592186264524} {:answer/id #uuid "b4adbff7-3555-5242-bfca-c5d264d3ce55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-2x}-x{e}^{-2x}" :db/id #edb/ref 17592186264553} {:answer/id #uuid "d2a21b02-ca2e-51b8-92c2-391a79250846" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{e}^{-2x}" :db/id #edb/ref 17592186264837}] :answer-field/correct {:db/id #edb/ref 17592186264524} :answer-field/id #uuid "a4383e0a-d8be-5d10-8611-d4c6afc8cf56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186265534}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "94dec214-fc61-500b-bffe-c52024a2504b" :question/math-academy-id "q-130147" :question/problem "Given the equation ${y}^{″}+4{y}^{′}+4y=0$ for $y=y(x),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +4 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}(\\lambda +2)^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =-2$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{-2x}$ and $x{e}^{-2x}$ is a solution to the original differential equation. \n\nAmong the given options, only $4{e}^{-x}$ is not a solution."} :step/id #uuid "3d0273da-7dca-5b4d-9e87-7ca443d6f6e9"} {:db/id #edb/ref 17592186444012 :step/content {:db/id #edb/ref 17592186444007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19665675-933f-562b-92c2-453f3aa6a7c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x{e}^{-x/4}" :db/id #edb/ref 17592186443996} {:answer/id #uuid "1c7e410e-ff0e-513f-b439-59db85b21e9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{-x/4}" :db/id #edb/ref 17592186443997} {:answer/id #uuid "3bc60826-5099-595c-bb90-6813ebbf7d31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{e}^{-x/4}" :db/id #edb/ref 17592186443998} {:answer/id #uuid "59ac1266-2808-5904-a986-8f81e5f69ca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{e}^{-x/4}-x{e}^{-x/4}" :db/id #edb/ref 17592186443999} {:answer/id #uuid "6c7c927a-01c3-5ee9-9a6b-b90fcf3476e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{-4x}+3x{e}^{-x/4}" :db/id #edb/ref 17592186444000}] :answer-field/correct {:db/id #edb/ref 17592186444000} :answer-field/id #uuid "47117b4f-de1f-5179-8ffa-cfd17b335562" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444005}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5dbc9673-510f-532c-a004-54ed22aabfa7" :question/math-academy-id "q-64796" :question/problem "Given the equation ${y}^{″}+\\frac{1}{2}{y}^{′}+\\frac{1}{16}y=0$ for $y=y(x),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+\\frac{1}{2}\\lambda {e}^{\\lambda x}+\\frac{1}{16}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+\\frac{1}{2}\\lambda +\\frac{1}{16}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+\\frac{1}{2}\\lambda +\\frac{1}{16} & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}{(\\lambda +\\frac{1}{4})}^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =-\\frac{1}{4}$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{-x/4}$ and $x{e}^{-x/4}$ is a solution to the original differential equation. \n\nAmong the given options, only $2{e}^{-4x}+3x{e}^{-x/4}$ is not a solution."} :step/id #uuid "4a132e70-8467-55e5-b1db-1bc17136f384" :step/next {:db/id #edb/ref 17592186444010}} {:db/id #edb/ref 17592186444013 :step/content {:db/id #edb/ref 17592186444008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05281020-031d-5d2a-808e-01688d4b6930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{e}^{9t}" :db/id #edb/ref 17592186443995} {:answer/id #uuid "9983f332-f05f-500a-8acb-70984c9621d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t{e}^{9t}" :db/id #edb/ref 17592186444001} {:answer/id #uuid "c635f663-c965-5072-9ef5-15319fccaa59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{9t}+5t{e}^{9t}" :db/id #edb/ref 17592186444002} {:answer/id #uuid "c8f68714-c0ba-58d7-8203-728b2921b006" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{e}^{-9t}" :db/id #edb/ref 17592186444003} {:answer/id #uuid "e69ea800-ad27-5d19-8fda-f9c165e154aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7t{e}^{9t}" :db/id #edb/ref 17592186444004}] :answer-field/correct {:db/id #edb/ref 17592186444003} :answer-field/id #uuid "585f5d02-4d6c-51a6-9fd9-0f3602ee74e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444006}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e9b8a76-fadd-5c5e-88d1-453c1509beac" :question/math-academy-id "q-64795" :question/problem "Given the equation ${y}^{″}-18{y}^{′}+81y=0$ for $y=y(t),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}-18\\lambda {e}^{\\lambda t}+81{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}-18\\lambda +81) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-18\\lambda +81 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}(\\lambda -9)^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =9$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{9t}$ and $t{e}^{9t}$ is a solution to the original differential equation. \n\nAmong the given options, only $3{e}^{-9t}$ is not a solution."} :step/id #uuid "6a42458d-290e-54dd-b688-d7fd5bd9fa4a" :step/next {:db/id #edb/ref 17592186444012}}] :activity/title "Second-Order Homogeneous ODEs: Characteristic Equations With Repeated Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186443994}]}
