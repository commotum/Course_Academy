frac{\\pi }{2}+\\operatorname{cot}⁡(\\frac{\\pi }{2}))-(4\\cdot \\frac{\\pi }{4}+\\operatorname{cot}⁡(\\frac{\\pi }{4})) \\\\  & =(2\\pi +0)-(\\pi +1) \\\\  & =\\pi -1\\end{aligned}\n$$" 13194139534644 17592186045417 true] [17592186430770 1068 #edb/ref 17592186430763 13194139534644 17592186045417 true] [17592186430770 1069 "q-83520" 13194139534644 17592186045417 true] [17592186430770 1070 #edb/ref 17592186045487 13194139534644 17592186045417 true] [17592186430770 1071 "Integrate the function $f(x,y)=x-y$ over the portion of the disk of radius $2$ centered at the origin, where $x\\ge 0$ and $y\\ge 0.$" 13194139534644 17592186045417 true] [17592186430770 1072 #uuid "2077302e-eca5-5aa1-8731-3c58ab648006" 13194139534644 17592186045417 true] [17592186430770 1074 "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/7b/7b181b47af7d29b68d86d26b5c2b948c17ce39c01a62cbb36e874bb733865718.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}x-y\\,dA & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta ){\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\frac{1}{3}{[{r}^{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{3}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )({2}^{3}-{0}^{3})\\text{d}\\theta  \\\\  & =\\frac{8}{3}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{8}{3}[\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ]_{0}^{\\pi /2} \\\\  & =\\frac{8}{3}[(\\operatorname{sin}⁡\\frac{\\pi }{2}+\\operatorname{cos}⁡\\frac{\\pi }{2})-(\\operatorname{sin}⁡0+\\operatorname{cos}⁡0)] \\\\  & =\\frac{8}{3}(1-1) \\\\  & =0.\\end{aligned}\n$$" 13194139534644 17592186045417 true] [17592186430771 1068 #edb/ref 17592186430764 13194139534644 17592186045417 true] [17592186430771 1069 "q-161048" 13194139534644 17592186045417 true] [17592186430771 1070 #edb/ref 17592186045485 13194139534644 17592186045417 true] [17592186430771 1071 "${\\int }_{0}^{\\pi }{\\int }_{0}^{1}5{r}^{4}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta =$" 13194139534644 17592186045417 true] [17592186430771 1072 #uuid "414bd17b-1eab-5df7-bb84-eb1080abae7b" 13194139534644 17592186045417 true] [17592186430771 1074 "First, we integrate with respect to $r$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }{\\int }_{0}^{1}5{r}^{4}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta {\\int }_{0}^{1}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta [{r}^{5}]_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta (1-0)\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =[-\\operatorname{cos}⁡\\theta ]_{0}^{\\pi } \\\\  & =-(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-(-1-1) \\\\  & =2\\end{aligned}\n$$" 13194139534644 17592186045417 true] [17592186430772 1068 #edb/ref 17592186430768 13194139534644 17592186045417 true] [17592186430772 1069 "q-83966" 13194139534644 17592186045417 true] [17592186430772 1070 #edb/ref 17592186045487 13194139534644 17592186045417 true] [17592186430772 1071 "Evaluate \n${\\int }_{5\\pi /3}^{2\\pi }{\\int }_{1}^{2\\operatorname{cos}⁡\\theta }r\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .$" 13194139534644 17592186045417 true] [17592186430772 1072 #uuid "9231aa24-53fe-5011-80b7-3b4b62ca8c09" 13194139534644 17592186045417 true] [17592186430772 1074 "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{5\\pi /3}^{2\\pi }{\\int }_{1}^{2\\operatorname{cos}⁡\\theta }r\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  & ={\\int }_{5\\pi /3}^{2\\pi }\\operatorname{sin}⁡\\theta {\\int }_{1}^{2\\operatorname{cos}⁡\\theta }r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{5\\pi /3}^{2\\pi }\\operatorname{sin}⁡\\theta \\,[\\frac{{r}^{2}}{2}]_{1}^{2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{5\\pi /3}^{2\\pi }\\operatorname{sin}⁡\\theta ((2\\operatorname{cos}⁡\\theta )^{2}-{1}^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{5\\pi /3}^{2\\pi }\\operatorname{sin}⁡\\theta (4{cos}^{2}⁡\\theta -1)\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{5\\pi /3}^{2\\pi }(4\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{5\\pi /3}^{2\\pi }(4\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  & =\\frac{1}{2}{[-\\frac{4}{3}{cos}^{3}⁡\\theta +\\operatorname{cos}⁡\\theta ]}_{5\\pi /3}^{2\\pi } \\\\  & =\\frac{1}{2}[(-\\frac{4}{3}{cos}^{3}⁡(2\\pi )+\\operatorname{cos}⁡(2\\pi ))-(-\\frac{4}{3}{cos}^{3}⁡(\\frac{5\\pi }{3})+\\operatorname{cos}⁡(\\frac{5\\pi }{3}))] \\\\  & =\\frac{1}{2}[(-\\frac{4}{3}+1)-(-\\frac{1}{6}+\\frac{1}{2})] \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$" 13194139534644 17592186045417 true] [17592186430773 1068 #edb/ref 17592186430766 13194139534644 17592186045417 true] [17592186430773 1069 "q-83954" 13194139534644 17592186045417 true] [17592186430773 1070 #edb/ref 17592186045487 13194139534644 17592186045417 true] [17592186430773 1071 "![](images/a6/a60d80425c240deb1ea372d7a21c3774247c4827536ce6f409f7e8736c7c94bc.png)\n\nThe region $D$ is the quarter-circle shown above. What is\n${∬}_{D}x\\,\\text{d}A$\nexpressed in polar coordinates?" 13194139534644 17592186045417 true] [17592186430773 1072 #uuid "9bb2e441-17ac-5548-ad1a-c8ae9611922f" 13194139534644 17592186045417 true] [17592186430773 1074 "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{3}$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le \\sqrt{3},\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139534644 17592186045417 true] [17592186430774 1068 #edb/ref 17592186430767 13194139534644 17592186045417 true] [17592186430774 1069 "q-161043" 13194139534644 17592186045417 true] [17592186430774 1070 #edb/ref 17592186045485 13194139534644 17592186045417 true] [17592186430774 1071 "![](images/2d/2db1e29e5f911a45c4c48ab41c4ad6dc63eeb36a8112672ae66844e14342f4c0.png)\n\nThe region $D$ is the circle shown above. What is ${∬}_{D}{y}^{2}\\,\\text{d}A$ expressed in polar coordinates?" 13194139534644 17592186045417 true] [17592186430774 1072 #uuid "b93ec44e-b9fb-53f6-875f-5ef36dc8b48a" 13194139534644 17592186045417 true] [17592186430774 1074 "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $5$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 5,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}{(r\\operatorname{sin}⁡\\theta )}^{2}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139534644 17592186045417 true]] :edb/tempids {"answer-0ea2ccdb-2b2b-5e06-a8bd-a29481af05f6" 17592186430733 "answer-26c2bf0f-9ee2-5d88-8b23-545cf4448435" 17592186430734 "answer-37e9bbb5-54b5-5e26-a0a0-50d7cf20ec9d" 17592186430735 "answer-3c68a910-d47a-5d42-8472-65a137268360" 17592186430736 "answer-40fcf753-0267-53ac-aa07-33aca198c3c0" 17592186430737 "answer-4e7ef1ee-27c1-50f3-af3d-a2b63e2d03d0" 17592186430738 "answer-566fc95d-9cf1-5eeb-ae90-c8f8a3969e01" 17592186430739 "answer-5b3e76f1-42b1-5f3d-8b32-cf741baa2a0e" 17592186430740 "answer-5cf5461b-da0e-570c-b9aa-467a2f82071d" 17592186430741 "answer-5d101e08-dd8a-5f3e-96a5-138bde512f04" 17592186430742 "answer-5e28ab03-180e-5b20-af37-557e7db4d91e" 17592186430743 "answer-681f0aba-b493-51e6-a417-42799a6f3a67" 17592186430744 "answer-686056c3-1712-5837-8d5c-57ad9de19f24" 17592186430745 "answer-6ef3239f-a18f-5059-bc4c-90c9f800c498" 17592186430746 "answer-6f84c6cd-963a-5926-9438-431cae8fd173" 17592186430747 "answer-73fa4118-327c-5da0-ace4-6324c8542c7b" 17592186430748 "answer-77346f94-7bc7-5551-a9ff-5850737d6c7b" 17592186430749 "answe