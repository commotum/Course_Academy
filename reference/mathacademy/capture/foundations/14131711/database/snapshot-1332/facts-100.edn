i /2}2{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta  & ={\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta  \\\\  & ={[\\theta +\\frac{1}{4}\\operatorname{sin}⁡(4\\theta )]}_{-\\pi /2}^{\\pi /2} \\\\  & =(\\frac{\\pi }{2}+\\frac{\\pi }{2})+\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(-2\\pi )) \\\\  & =\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186351613 #edb/ref 1080 "\\frac{\\pi }{2}" #edb/ref 17592186045417] [17592186351613 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351613 #edb/ref 1083 #uuid "04c8b8e0-2cc2-5fe5-a1df-e98cd1001f29" #edb/ref 17592186045417] [17592186352654 #edb/ref 1080 "2\\operatorname{ln}⁡2" #edb/ref 17592186045417] [17592186352654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352654 #edb/ref 1083 #uuid "7c4bd1d1-6340-5981-bf6a-672c766b04a6" #edb/ref 17592186045417] [17592186353302 #edb/ref 1080 "\\pi \\operatorname{ln}⁡2" #edb/ref 17592186045417] [17592186353302 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353302 #edb/ref 1083 #uuid "c7e43f8a-2b13-5ebe-b51e-312ffdb9f42b" #edb/ref 17592186045417] [17592186353496 #edb/ref 1080 "\\frac{\\operatorname{ln}⁡2}{2}" #edb/ref 17592186045417] [17592186353496 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353496 #edb/ref 1083 #uuid "de54c0b4-a6ca-5c07-9dbe-5dedc4f5b648" #edb/ref 17592186045417] [17592186353757 #edb/ref 1080 "\\frac{\\pi \\operatorname{ln}⁡2}{2}" #edb/ref 17592186045417] [17592186353757 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353757 #edb/ref 1083 #uuid "fa31fa69-bb59-5f48-98b0-b5486fce2c71" #edb/ref 17592186045417] [17592186354139 #edb/ref 1075 #edb/ref 17592186351613 #edb/ref 17592186045417] [17592186354139 #edb/ref 1075 #edb/ref 17592186352654 #edb/ref 17592186045417] [17592186354139 #edb/ref 1075 #edb/ref 17592186353302 #edb/ref 17592186045417] [17592186354139 #edb/ref 1075 #edb/ref 17592186353496 #edb/ref 17592186045417] [17592186354139 #edb/ref 1075 #edb/ref 17592186353757 #edb/ref 17592186045417] [17592186354139 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186354139 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186354139 #edb/ref 1078 #edb/ref 17592186353757 #edb/ref 17592186045417] [17592186354139 #edb/ref 1079 #uuid "bbf98d97-f14f-5123-b9e9-537f4bff4e00" #edb/ref 17592186045417] [17592186354276 #edb/ref 1068 #edb/ref 17592186354139 #edb/ref 17592186045417] [17592186354276 #edb/ref 1069 "q-83970" #edb/ref 17592186045417] [17592186354276 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186354276 #edb/ref 1071 "Integrate the function $f(x,y)=\\frac{2}{{x}^{2}+{y}^{2}+1}$ over the portion of the disk of radius $1$ centered at the origin, where $x\\le 0$ and $y\\le 0.$" #edb/ref 17592186045417] [17592186354276 #edb/ref 1072 #uuid "3a65ae57-db8c-559b-a30a-84cd82c23ff1" #edb/ref 17592186045417] [17592186354276 #edb/ref 1074 "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/e4/e4275e74a45deb22c0ed22546772e33fbd5caeb89a4036b1a2f4870e8ecf67a1.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2}{{x}^{2}+{y}^{2}+1}\\,\\text{d}A & ={∬}_{Δ}\\frac{2}{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{1}\\frac{2r}{{r}^{2}+1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}[\\operatorname{ln}⁡({r}^{2}+1)]_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1)\\,\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡2{\\int }_{\\pi }^{3\\pi /2}\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡2[\\theta ]_{\\pi }^{3\\pi /2} \\\\  & =\\operatorname{ln}⁡2(\\frac{3\\pi }{2}-\\pi ) \\\\  & =\\frac{\\pi \\operatorname{ln}⁡2}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186389119 #edb/ref 1068 #edb/ref 17592186389120 #edb/ref 17592186045417] [17592186389119 #edb/ref 1069 "q-161041" #edb/ref 17592186045417] [17592186389119 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186389119 #edb/ref 1071 "![](images/6b/6b077d20bcb79f293383a7810d1c46ad42ce78d17a8d631b01f66a9fd547f475.png)\n\nThe region $D$ is the circle shown above. What is ${∬}_{D}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)\\,\\text{d}A$ expressed in polar coordinates?" #edb/ref 17592186045417] [17592186389119 #edb/ref 1072 #uuid "a368d06f-dd38-5739-a1e1-1669cc437d2c" #edb/ref 17592186045417] [17592186389119 #edb/ref 1074 "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $4$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 4,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)\\,\\text{d}A & ={∬}_{Δ}\\operatorname{ln}⁡((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1)r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1)\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [175921