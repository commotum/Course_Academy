b/ref 17592186045417] [17592186290210 #edb/ref 1075 #edb/ref 17592186289131 #edb/ref 17592186045417] [17592186290210 #edb/ref 1075 #edb/ref 17592186289259 #edb/ref 17592186045417] [17592186290210 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186290210 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186290210 #edb/ref 1078 #edb/ref 17592186289112 #edb/ref 17592186045417] [17592186290210 #edb/ref 1079 #uuid "e191ff6e-214b-558e-9919-97349fa4da47" #edb/ref 17592186045417] [17592186290423 #edb/ref 1068 #edb/ref 17592186289966 #edb/ref 17592186045417] [17592186290423 #edb/ref 1069 "q-225166" #edb/ref 17592186045417] [17592186290423 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186290423 #edb/ref 1071 "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=2v(1-u-v),\\,y=\\frac{1-v}{1+u}.\n$$\n\nWhich of the following is the image of the side ${S}_{4}$ under the action of $T?$" #edb/ref 17592186045417] [17592186290423 #edb/ref 1072 #uuid "21fdd56a-1bd5-5736-b8c0-5f4753ddc47e" #edb/ref 17592186045417] [17592186290423 #edb/ref 1074 "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{4}.$\n\nFor the side ${S}_{4},$ we have $u=0$ and $1\\ge v\\ge 0.$ Substituting $u=0$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(2v(1-u-v),\\,\\frac{1-v}{1+u}) \\\\  & =(2v(1-0-v),\\,\\frac{1-v}{1+0}) \\\\  & =(2v(1-v),\\,1-v).\\end{aligned}\n$$\n\nSo, the image of ${S}_{4}$ can be parametrized by\n\n$$\nx=2v(1-v),\\,y=1-v,\\,1\\ge v\\ge 0.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx=2t(1-t),\\,y=1-t,\\,1\\ge t\\ge 0.\n$$\n\nThese are parametric equations of a parabolic arc. Notice that if we eliminate $t$ from the equations, we get\n\n$$\nx=2(1-y)(y)\\,⇒\\,x=-2{(y-\\frac{1}{2})}^{2}+\\frac{1}{2}\n$$\n\nwhich is a left-opening parabola whose vertex is at $(\\frac{1}{2},\\frac{1}{2}).$\n\nMoreover, the endpoints of ${S}_{4}$ are mapped to the $xy$-plane as follows:\n\n$$\n\\begin{aligned} & T:(0,1)\\to (2(1)(1-0-1),\\frac{1-1}{1+0})=(0,0) \\\\  & T:(0,0)\\to (2(0)(1-0-0),\\frac{1-0}{1+0})=(0,1)\\end{aligned}\n$$\n\nTherefore, the image of ${S}_{4}$ is an arc of a left-opening parabola, traversed from $(0,0)$ to $(0,1).$\n\n![](images/ff/ff3c1028da35afad6c215e88863665b5bd6647d2507af2344f9f6710f0ad6373.png)" #edb/ref 17592186045417] [17592186317580 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186317580 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186317580 #edb/ref 1083 #uuid "028867b0-8cf6-524a-93e6-8e63fa02e23d" #edb/ref 17592186045417] [17592186317692 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186317692 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186317692 #edb/ref 1083 #uuid "28f401e4-eb59-5198-abf4-1458830b331c" #edb/ref 17592186045417] [17592186317709 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186317709 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186317709 #edb/ref 1083 #uuid "2f329de5-7c1a-5fad-b2d2-f7cc8384731d" #edb/ref 17592186045417] [17592186317852 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186317852 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186317852 #edb/ref 1083 #uuid "55e9e214-e0b3-5771-95e7-5cb487ad7118" #edb/ref 17592186045417] [17592186317888 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186317888 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186317888 #edb/ref 1083 #uuid "5f5bbc70-a2a7-5d4f-9c69-50122cef639d" #edb/ref 17592186045417] [17592186318014 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186318014 #edb/ref 1082 #edb