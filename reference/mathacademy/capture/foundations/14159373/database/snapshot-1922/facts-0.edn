7] [17592186119875 #edb/ref 1038 #edb/ref 17592186120547 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186266127 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186357508 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186357512 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186357513 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186388251 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186394854 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186440780 #edb/ref 17592186045417] [17592186119875 #edb/ref 1038 #edb/ref 17592186484245 #edb/ref 17592186045417] [17592186119875 #edb/ref 1039 "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations" #edb/ref 17592186045417] [17592186119875 #edb/ref 1041 #edb/ref 17592186119691 #edb/ref 17592186045417] [17592186119875 #edb/ref 1042 #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" #edb/ref 17592186045417] [17592186119995 #edb/ref 1043 #edb/ref 17592186120705 #edb/ref 17592186045417] [17592186119995 #edb/ref 1043 #edb/ref 17592186120778 #edb/ref 17592186045417] [17592186119995 #edb/ref 1043 #edb/ref 17592186120782 #edb/ref 17592186045417] [17592186119995 #edb/ref 1043 #edb/ref 17592186120783 #edb/ref 17592186045417] [17592186119995 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186119995 #edb/ref 1045 "Finding Determinants Using Row and Column Operations" #edb/ref 17592186045417] [17592186119995 #edb/ref 1046 #edb/ref 17592186120705 #edb/ref 17592186045417] [17592186119995 #edb/ref 1049 #edb/ref 17592186049685 #edb/ref 17592186045417] [17592186119995 #edb/ref 1050 840.0 #edb/ref 17592186045417] [17592186119995 #edb/ref 1053 #uuid "0110b0af-3b1d-5486-8362-7c1bb8e6b885" #edb/ref 17592186045417] [17592186120545 #edb/ref 1068 #edb/ref 17592186394834 #edb/ref 17592186045417] [17592186120545 #edb/ref 1069 "q-91092" #edb/ref 17592186045417] [17592186120545 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186120545 #edb/ref 1071 "$$\n|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{32}$ equal to zero.*" #edb/ref 17592186045417] [17592186120545 #edb/ref 1072 #uuid "2ea53fce-52af-53d1-b17c-6cd66b5ff019" #edb/ref 17592186045417] [17592186120545 #edb/ref 1074 "Let's make entries to the left and to the right of ${a}_{32}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-1){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+2}|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}| \\\\  & =-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120705 #edb/ref 1058 #edb/ref 17592186120782 #edb/ref 17592186045417] [17592186120705 #edb/ref 1061 17785 #edb/ref 17592186045417] [17592186120705 #edb/ref 1062 #uuid "5e9a2059-bb14-516d-a920-81186f0ec60f" #edb/ref 17592186045417] [17592186120705 #edb/ref 1063 #edb/ref 17592186121046 #edb/ref 17592186045417] [17592186120778 #edb/ref 1061 29895 #edb/ref 17592186045417] [17592186120778 #edb/ref 1062 #uuid "44a46e6a-f719-5f4e-9005-f87336a49c49" #edb/ref 17592186045417] [17592186120778 #edb/ref 1063 #edb/ref 17592186119870 #edb/ref 17592186045417] [17592186120782 #edb/ref 1058 #edb/ref 17592186120783 #edb/ref 17592186045417] [17592186120782 #edb/ref 1061 30071 #edb/ref 17592186045417] [17592186120782 #edb/ref 1062 #uuid "f2fba6b9-422f-5056-af49-20d435b1e997" #edb/ref 17592186045417] [17592186120782 #edb/ref 1063 #edb/ref 17592186119874 #edb/ref 17592186045417] [17592186120783 #edb/ref 1058 #edb/ref 17592186120778 #edb/ref 17592186045417] [17592186120783 #edb/ref 1061 30087 #edb/ref 17592186045417] [17592186120783 #edb/ref 1062 #uuid "109c7db1-e31f-5a38-9ad5-5e9c96e5d373" #edb/ref 17592186045417] [17592186120783 #edb/ref 1063 #edb/ref 17592186119875 #edb/ref 17592186045417] [17592186121046 #edb/ref 1064 "One way to simplify a determinant calculation is to create a row (or column) containing all zeros except for one entry. Then, we can use a Laplace expansion across that row (or column) to compute the determinant.\n\nLet's demonstrate this method on the matrix $A$ below.\n\n![](images/37/37946204f088b803603ba8adc3f93494e1d49fbe59d9c0925347675311b23e5d.svg)\n\nNotice that we can make entries to the right of $a_{21}=1$ equal to zero using elementary *column* operations.\n\nSince adding a multiple of one column to another column in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}2 & 1 & 1 \\\\ 1 & 2 & 3 \\\\ 8 & 14 & 17\\end{aligned}| &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}+(-2){C}_{1} \\\\ {C}_{3}:={C}_{3}+(-3){C}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}2 & -3 & -5 \\\\ 1 & 0 & 0 \\\\ 8 & -2 & -7\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}2 & -3 & -5 \\\\ 1 & 0 & 0 \\\\ 8 & -2 & -7\\end{aligned}| \\\\  & =1\\cdot (-1)^{2+1}|\\begin{aligned}-3 & -5 \\\\ -2 & -7\\end{aligned}| \\\\  & =-(21-10) \\\\  & =-11.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121046 #edb/ref 1065 3240 #edb/ref 17592186045417] [17592186121046 #edb/ref 1066 #uuid "b4a9a955-bf0a-5e47-973a-fa7d6e4191be" #edb/ref 17592186045417] [17592186121046 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186263178 #edb/ref 1080 "256" #edb/ref 17592186045417] [17592186263178 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263178 #edb/ref 1083 #uuid "12d46ac6-9747-5c71-b490-546887e78256" #edb/ref 17592186045417] [17592186263367 #edb/ref 1080 "324" #edb/ref 17592186045417] [17592186263367 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263367 #edb/ref 1083 #uuid "2afea5e5-8fc7-5005-883c-6aaf5bb2ea37" #edb/ref 17592186045417] [17592186263878 #edb/ref 1080 "315" #edb/ref 17592186045417] [17592186263878 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263878 #edb/ref 1083 #uuid "65602076-c5b7-5aad-8a7a-cd4f344a6872" #edb/ref 17592186045417] [17592186264134 #edb/ref 1080 "312" #edb/ref 17592186045417] [17592186264134 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264134 #edb/ref 1083 #uuid "844ee3e5-405e-5c43-8fad-90753e6eb5f8" #edb/ref 17592186045417] [17592186265103 #edb/ref 1080 "278" #edb/ref 17592186045417] [17592186265103 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186265103 #edb/ref 1083 #uuid "efbf8c8d-59c7-55fc-afcd-b1821ae25cb2" #edb/ref 17592186045417] [17592186265422 #edb/ref 1075 #edb/ref 17592186263178 #edb/ref 17592186045417] [17592186265422 #edb/ref 1075 #edb/ref 17592186263367 #edb/ref 17592186045417] [17592186265422 #edb/ref 1075 #edb/ref 17592186263878 #edb/ref 17592186045417] [17592186265422 #edb/ref 1075 #edb/ref 17592186264134 #edb/ref 17592186045417] [17592186265422 #edb/ref 1075 #edb/ref 17592186265103 #edb/ref 17592186045417] [175