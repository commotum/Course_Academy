#{[{:db/id #edb/ref 17592186266143 :knowledge-point/_questions [{:db/id #edb/ref 17592186119870 :knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566" :knowledge-point/title "Computing 4x4 Determinants Using Row and Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12d46ac6-9747-5c71-b490-546887e78256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186263178} {:answer/id #uuid "2afea5e5-8fc7-5005-883c-6aaf5bb2ea37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324" :db/id #edb/ref 17592186263367} {:answer/id #uuid "65602076-c5b7-5aad-8a7a-cd4f344a6872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "315" :db/id #edb/ref 17592186263878} {:answer/id #uuid "844ee3e5-405e-5c43-8fad-90753e6eb5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "312" :db/id #edb/ref 17592186264134} {:answer/id #uuid "efbf8c8d-59c7-55fc-afcd-b1821ae25cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "278" :db/id #edb/ref 17592186265103}] :answer-field/correct {:answer/id #uuid "2afea5e5-8fc7-5005-883c-6aaf5bb2ea37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324" :db/id #edb/ref 17592186263367} :answer-field/id #uuid "653fc202-e598-5222-9f0e-b11e0cf8ccc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e03835d-437b-59ee-bd2c-565e5373dfa5" :question/math-academy-id "q-132144" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries above and below ${a}_{32}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries above and below ${a}_{32}=3$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -6 & -2 & 4 \\\\ 2 & -3 & 7 & -5 \\\\ -2 & 3 & -1 & 2 \\\\ -2 & 3 & 1 & 7\\end{aligned}| &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{3} \\\\ {R}_{2}:={R}_{2}+{R}_{3} \\\\ {R}_{4}:={R}_{4}+(-1){R}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-3 & 0 & -4 & 8 \\\\ 0 & 0 & 6 & -3 \\\\ -2 & 3 & -1 & 2 \\\\ 0 & 0 & 2 & 5\\end{aligned}| \\\\  & =3\\cdot (-1)^{3+2}|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =-3|\\begin{aligned}-3 & -4 & 8 \\\\ 0 & 6 & -3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =(-3)\\cdot -3\\cdot (-1)^{1+1}|\\begin{aligned}6 & -3 \\\\ 2 & 5\\end{aligned}| \\\\  & =9(30+6) \\\\  & =324.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120545 :knowledge-point/_questions [{:db/id #edb/ref 17592186119875 :knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8093b1f1-d3ed-5ed8-a9e5-08dbda817a06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\begin{vmatrix}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{vmatrix}" :db/id #edb/ref 17592186119384} {:answer/id #uuid "8a478fe5-40a9-51bb-abfb-dceb527a4108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\begin{vmatrix}1 & -2 & 10 \\\\ -2 & 2 & -6 \\\\ 2 & 1 & -7\\end{vmatrix}" :db/id #edb/ref 17592186119385} {:answer/id #uuid "aea34567-748e-5267-ad16-f14eea2221b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\begin{vmatrix}1 & -7 & 10 \\\\ -9 & -6 & 9 \\\\ 2 & 4 & -7\\end{vmatrix}" :db/id #edb/ref 17592186119386} {:answer/id #uuid "d700cc92-46e0-58d9-b1e9-9f6fa1a9f666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\begin{vmatrix}-3 & -6 & 9 \\\\ 2 & 2 & -6 \\\\ 1 & 4 & -7\\end{vmatrix}" :db/id #edb/ref 17592186119387} {:answer/id #uuid "719b6350-3515-5357-a23b-2026aae684ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\begin{vmatrix}-1 & -5 & 4 \\\\ -10 & -4 & 6 \\\\ 5 & 3 & -4\\end{vmatrix}" :db/id #edb/ref 17592186119388}] :answer-field/id #uuid "a37115d0-c9d7-5aed-ac0e-9588846c44f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119383} {:answer-field/choices [{:answer/id #uuid "fec93138-cf0b-5d3f-8a5c-8882046ae062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394835} {:answer/id #uuid "090d23f3-9df7-5a18-ad1c-3041ca3b0b88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}1 & -7 & 10 \\\\ -9 & -6 & 9 \\\\ 2 & 4 & -7\\end{aligned}|" :db/id #edb/ref 17592186394836} {:answer/id #uuid "c4475098-4c19-544f-a8c8-75b11b40afce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -4 & 6 \\\\ 5 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394837} {:answer/id #uuid "0720eaf4-1dba-52f4-98df-0fc8cc7f0d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}1 & -2 & 10 \\\\ -2 & 2 & -6 \\\\ 2 & 1 & -7\\end{aligned}|" :db/id #edb/ref 17592186394838} {:answer/id #uuid "c47f2fc0-2674-5e12-89b3-daeb57faaf22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-3 & -6 & 9 \\\\ 2 & 2 & -6 \\\\ 1 & 4 & -7\\end{aligned}|" :db/id #edb/ref 17592186394839}] :answer-field/correct {:answer/id #uuid "fec93138-cf0b-5d3f-8a5c-8882046ae062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394835} :answer-field/id #uuid "294d6d11-4a04-5aed-b0e6-84671260549e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ea53fce-52af-53d1-b17c-6cd66b5ff019" :question/math-academy-id "q-91092" :question/problem "$$\n|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{32}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{32}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-1){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+2}|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}| \\\\  & =-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$"}]}
