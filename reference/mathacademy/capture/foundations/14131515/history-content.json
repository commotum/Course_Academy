      "raw_html": "<div class=\"question\" id=\"question-72042\"><div class=\"questionHeader\"><span class=\"questionNumber\">1.</span><a class=\"questionKP\" href=\"/topics/1979#6101\">Identifying Type I Regions</a><span class=\"helpButton\" questionid=\"72042\">?</span></div><div class=\"questionText\"><p>Which of the following is a type I region in two-dimensional space?</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 10:08 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:23</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
