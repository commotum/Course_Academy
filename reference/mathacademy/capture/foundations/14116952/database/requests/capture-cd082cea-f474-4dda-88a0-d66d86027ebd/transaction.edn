[{:db/id 17592186124585 :knowledge-point/questions ["question-e365d16e-a317-5782-a1fd-f9a127eeaeee"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e365d16e-a317-5782-a1fd-f9a127eeaeee" :question/id #uuid "e365d16e-a317-5782-a1fd-f9a127eeaeee" :question/math-academy-id "q-94699" :question/problem "Find the center of the elliptic cone $8(x-6)^{2}+12(y-4)^{2}=4(z+2)^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}8(x-6)^{2}+12(y-4)^{2} & =4(z+2)^{2} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z+2)^{2}}{1/4} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z-(-2))^{2}}{1/4}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(6,4,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-90f98d7f-bc9e-5d73-8a9b-c9601cd09a5c"] :db/ensure [:question/validate]} {:db/id "answer-field-90f98d7f-bc9e-5d73-8a9b-c9601cd09a5c" :answer-field/id #uuid "90f98d7f-bc9e-5d73-8a9b-c9601cd09a5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ea0ec23-f682-53e7-88fb-7469662cfac6" :answer-field/choices ["answer-fdc3119d-6815-5c0c-a167-9b6d25d35a4f" "answer-57c975a4-5dc8-50d2-a81e-558a7189251f" "answer-045932cb-4e7d-5eeb-a1bd-fd8a8b320228" "answer-6ea0ec23-f682-53e7-88fb-7469662cfac6" "answer-3565bdc3-f252-59de-885d-0bb85488a4eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdc3119d-6815-5c0c-a167-9b6d25d35a4f" :answer/id #uuid "fdc3119d-6815-5c0c-a167-9b6d25d35a4f" :answer/type :answer.type/math :answer/value "(-2,-3,1)" :db/ensure [:answer/validate]} {:db/id "answer-57c975a4-5dc8-50d2-a81e-558a7189251f" :answer/id 