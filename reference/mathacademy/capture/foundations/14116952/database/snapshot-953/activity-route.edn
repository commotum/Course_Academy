#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186416617} :activity/id #uuid "22b10c8c-4354-5ffb-badf-062a6db3301e" :activity/scope {:db/id #edb/ref 17592186050456 :topic/id #uuid "4a81b34b-9d6c-50ec-87c8-f6c706602e63" :topic/math-academy-id 1894} :activity/steps [{:db/id #edb/ref 17592186416615 :step/content {:db/id #edb/ref 17592186416614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045932cb-4e7d-5eeb-a1bd-fd8a8b320228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,3,-1)" :db/id #edb/ref 17592186416608} {:answer/id #uuid "3565bdc3-f252-59de-885d-0bb85488a4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,12,4)" :db/id #edb/ref 17592186416609} {:answer/id #uuid "57c975a4-5dc8-50d2-a81e-558a7189251f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-6,-4,2)" :db/id #edb/ref 17592186416610} {:answer/id #uuid "6ea0ec23-f682-53e7-88fb-7469662cfac6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,4,-2)" :db/id #edb/ref 17592186416611} {:answer/id #uuid "fdc3119d-6815-5c0c-a167-9b6d25d35a4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,-3,1)" :db/id #edb/ref 17592186416612}] :answer-field/correct {:db/id #edb/ref 17592186416611} :answer-field/id #uuid "90f98d7f-bc9e-5d73-8a9b-c9601cd09a5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186416613}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e365d16e-a317-5782-a1fd-f9a127eeaeee" :question/math-academy-id "q-94699" :question/problem "Find the center of the elliptic cone $8(x-6)^{2}+12(y-4)^{2}=4(z+2)^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}8(x-6)^{2}+12(y-4)^{2} & =4(z+2)^{2} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z+2)^{2}}{1/4} \\\\ \\frac{(x-6)^{2}}{1/8}+\\frac{(y-4)^{2}}{1/12} & =\\frac{(z-(-2))^{2}}{1/4}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(6,4,-2).$"} :step/id #uuid "5a0f177f-5462-56d0-97ab-220aea3f5556"} {:db/id #edb/ref 17592186416616 :step/content {:db/id #edb/ref 17592186357751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497c9287-8527-5f28-9070-29d5455ff937" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,0,0)" :db/id #edb/ref 17592186355315} {:answer/id #uuid "8935fc20-662f-5493-8895-2ff5e7873ee9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm 3x-5" :db/id #edb/ref 17592186355877} {:answer/id #uuid "8cd8d2b3-1b54-51b9-aa4b-86e2141de38d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm \\frac{x}{3}+2" :db/id #edb/ref 17592186355907} {:answer/id #uuid "97966c4c-9e1f-5c8e-b01d-facfe4e419d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,2,0)" :db/id #edb/ref 17592186356000} {:answer/id #uuid "b6f64f22-7913-52f4-86c8-f51e90ac0c11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm \\frac{2x}{3}+18" :db/id #edb/ref 17592186356269}] :answer-field/correct {:db/id #edb/ref 17592186355315} :answer-field/id #uuid "8196235b-25ca-50fc-919f-d7ee8e52fb0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357148}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2cfd332-5d5c-5209-92ee-4f9962118084" :question/math-academy-id "q-94496" :question/problem "What is the trace in the $xy$-plane of the elliptic cone $9(x-2)^{2}+2{y}^{2}=18{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}9(x-2)^{2}+2{y}^{2}=18(0)^{2} \\\\ 9(x-2)^{2}+2{y}^{2}=0\\end{aligned}\n$$\n\nThis gives in the $xy$-plane the point $(2,0,0).$"} :step/id #uuid "81a2407c-e479-5098-9a3a-1ffa4cdd92c6" :step/next {:db/id #edb/ref 17592186416615}} {:db/id #edb/ref 17592186416617 :step/content {:db/id #edb/ref 17592186357749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096807f4-6104-5c9d-9a4f-3cc078997926" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-\\frac{y}{3}\\pm 1" :db/id #edb/ref 17592186354752} {:answer/id #uuid "45b089cf-4cd4-5955-98fe-9f0ff803df9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\frac{y}{9}+1" :db/id #edb/ref 17592186355284} {:answer/id #uuid "78a27687-7772-5319-a40c-aef31e7c2570" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\frac{y}{3}" :db/id #edb/ref 17592186355718} {:answer/id #uuid "7fd6a87d-0609-5bbe-9ab6-30cf1a7bcfa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-\\frac{y}{3}" :db/id #edb/ref 17592186355784} {:answer/id #uuid "97dcd38b-595a-5837-97a8-ed1062f9f32b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=\\pm \\frac{y}{9}" :db/id #edb/ref 17592186356003}] :answer-field/correct {:db/id #edb/ref 17592186355718} :answer-field/id #uuid "0000aeb3-77f2-52e8-8fd1-917fe7c0e597" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186356907}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1057b215-35c6-5a51-b1d3-2145bec593cc" :question/math-academy-id "q-94486" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{3{x}^{2}}{4}+\\frac{{y}^{2}}{9}={z}^{2}\\,?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+\\frac{{y}^{2}}{9} & ={z}^{2} \\\\ \\frac{{y}^{2}}{9} & ={z}^{2} \\\\ z & =\\pm \\frac{y}{3}\\end{aligned}\n$$\n\nThis gives us two lines in the $yz$-plane with equations $z=\\pm \\frac{y}{3}.$"} :step/id #uuid "d217a96c-8c03-502b-b5e2-7536101a5ec4" :step/next {:db/id #edb/ref 17592186416616}}] :activity/title "Elliptic Cones" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186416607}]}
