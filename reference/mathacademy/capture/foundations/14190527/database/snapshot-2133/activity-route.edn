 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "a85a1ef4-0643-5a34-aa1c-63793030b26e" :step/next {:db/id #edb/ref 17592186504737}} {:db/id #edb/ref 17592186504737 :step/content {:db/id #edb/ref 17592186504696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d0e360c-e3e6-587a-b736-c80bcba8308f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504059} {:answer/id #uuid "3d428b90-61d0-5038-9b34-bf775ecb13d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504139} {:answer/id #uuid "9813b985-683d-58f6-aec5-13cadade9904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504301} {:answer/id #uuid "ad4452ae-73b0-5e53-a1b7-6d17307aeea2" :answer/type {:db/id #edb/ref 175921860454