186045498} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186382665} {:answer/id #uuid "d2048545-37eb-5154-98fb-fbdc70936239" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186382666} {:answer/id #uuid "a3ccc71c-705b-55f1-bd7a-216a4ecad2d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}" :db/id #edb/ref 17592186382667}] :answer-field/correct {:db/id #edb/ref 17592186382667} :answer-field/id #uuid "601494e0-9a29-5b8f-8afd-34cbf959efa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186382662}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcd0e8b8-71e5-5dcd-a370-0847d15e9434" :question/math-academy-id "q-98797" :question/problem "$$\nA=\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix},\\,Σ=\\begin{bmatrix}6 & 0 \\\\ 0 & 4 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=4.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{6}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{6}\\begin{bmatrix}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{8}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ \\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{4}\\begin{bmatrix}1 & -3 \\\\ 4 & 4 \\\\ -3 & 1\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{4}\\begin{bmatrix}-\\frac{4}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{3\\sqrt{2}}{x}_{1}+\\frac{4}{3\\sqrt{2}}{x}_{2}-\\frac{1}{3\\sqrt{2}}{x}_{3} &=0 \\\\ -\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2}-{x}_{3} &=0 \\\\ -{x}_{1}+{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}\\frac{2}{3} \\\\ \\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & \\frac{2}{3} \\\\ \\frac{4}{3\\sqrt{2}} & 0 & \\frac{1}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & \\frac{2}{3}\\end{bmatrix}\n$$"} :step/id #uuid "083a494b-c789-5c77-8d90-bf2796641ed3" :step/next {:db/id #edb/ref 17592186526143}} {:db/id #edb/ref 17592186526143 :step/content {:db/id #edb/ref 17592186525985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21cd4f8b-9498-5d21-baab-074e7d02e4bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{\\sqrt{30}}" :db/id #edb/ref 17592186525282} {:answer/id #uuid "83d6bc2e-d7c0-5db9-9f3d-bd4cdf4f6f1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{30}}" :db/id #edb/ref 17592186525538} {:answer/id #uuid "8940d80e-582b-5d7c-8642-73f87b9c0924" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{30}}" :db/id #edb/ref 17592186525551} {:answer/id #uuid "bccc676a-883d-57ad-9f71-0e94856d6b64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{\\sqrt{30}}" :db/id #edb/ref 17592186525692}] :answer-field/correct {:db/id #edb/ref 17592186525551} :answer-field/id #uuid "0bd819e0-daee-5f8c-b3ed-dda09a79f3bb" :answer-field/key "field-10" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186525851} {:answer-field/choices [{:answer/id #uuid "3ce43be3-6287-5a43-8e7e-f0f6dbb70a00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186525358} {:answer/id #uuid "403732de-7db9-5b49-9aca-47b26030eeee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186525365} {:answer/id #uuid "d04f4968-c94c-5bbd-b17a-854dad443dc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186525724} {:answer/id #uuid "d396567f-f526-5dec-9323-98393255b386" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186525732}] :answer-field/correct {:db/id #e