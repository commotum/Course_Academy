ad9-f88a-5195-920b-7a3186617810" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186407944} {:answer/id #uuid "2f3dc26e-73b8-5c9c-b134-f48af0b4fa31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186407945} {:answer/id #uuid "ca46e85d-7449-58fd-8c94-b7c43aa2a295" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407987} {:answer/id #uuid "f4e20ae3-af8f-5ec4-a295-1482b0ef913b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186407998}] :answer-field/correct {:db/id #edb/ref 17592186407944} :answer-field/id #uuid "d052871d-6bf4-5f71-8c1e-86068b23ed06" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408015} {:answer-field/choices [{:answer/id #uuid "1cee1409-cfce-543a-9fbf-be92072772c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{3}" :db/id #edb/ref 17592186407937} {:answer/id #uuid "7a8de822-d7cd-59c2-b31e-e7c680575025" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186407964} {:answer/id #uuid "b988539b-4772-5dd4-b789-d1aba86ace4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407986}] :answer-field/correct {:db/id #edb/ref 17592186407937} :answer-field/id #uuid "d603b43b-7324-5190-9be8-8e1ad1918734" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408016} {:answer-field/choices [{:answer/id #uuid "37af3508-a147-54ba-b151-f98b35972d3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}-{x}_{2}=0" :db/id #edb/ref 17592186407946} {:answer/id #uuid "41772dca-2c67-5d05-8f2f-74d9c3f1fc15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}-{x}_{3}=0" :db/id #edb/ref 17592186407947} {:answer/id #uuid "5435dd64-12d8-59bb-904c-5c17390e60cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}+{x}_{2}=0" :db/id #edb/ref 17592186407953}] :answer-field/correct {:db/id #edb/ref 17592186407946} :answer-field/id #uuid "def84bcd-2e4c-557e-9a7b-0920a09668c2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408017}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07d790e0-8df9-5a35-b3fe-bdc95541cdd3" :question/math-academy-id "q-363828" :question/problem "$$\nA=\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ 0 & 0\\end{bmatrix},\\,Σ=\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | $\\frac{1}{\\sqrt{2}}$ |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-1}} |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | ${x}_{2}$ |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as\n\n$$\n\\begin{bmatrix}{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n| | ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | $\\frac{1}{\\sqrt{2}}$ |  |  |  |\n|  | {{field-7}} |  |  |  | | | ${u}_{3}=\\,\\,$ |  | {{field-8}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | $0$ |  |  |  |\n|  | {{field-9}} |  |  |  | |\n| --- | --- |" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2}\\begin{bmatrix}1 & 1 \\\\ -1 & -1 \\\\ 0 & 0\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}\\frac{2}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{2}}{x}_{1}-\\frac{1}{\\sqrt{2}}{x}_{2}=0\\,⟹\\,{x}_{1}-{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n\\begin{bmatrix}{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}{{\\begin{bmatrix}1 \\\\ 1 \\\\ 0\\end{bmatrix}}_{⏟}}_{{b}_{1}}+{x}_{3}{{\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}\\,{u}_{3}=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$"} :step/id #uuid "e2882521-8d21-5a7b-8813-60683b9344e3"} {:db/id #edb/ref 17592186408023 :step/content {:db/id #edb/ref 17592186408020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a847e10-ad2a-5e19-bffe-4f473d1f4614" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186407950} {:answer/id #uuid "53b3d1ac-5ba6-5b42-802f-34c001d2a3eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{1}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186407952} {:answer/id #uuid "7ba9bbe0-a4bd-5d08-aca1-3c1661cf6c5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{\\sqrt{2}}{2} \\\\ -\\frac{1}{2} \\\\ \\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186407966} {:answer/id #uuid "e36cd36f-f51a-505a-8f73-b691e55977cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186407993} {:answer/id #uuid "e71af25d-d057-558a-8db8-29ad46847b17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186407996}] :answer-field/correct {:db/id #edb/ref 17592186407996} :answer-field/id #uuid "1e3568eb-62d3-583e-93bd-bbecf0a0149d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186408002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "256724b0-7532-517f-89d9-acc3daa6cf56" :question/math-academy-id "q-98766" :question/problem "$$\nA=\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix},\\,Σ=\\begin{bmatrix}5 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=3.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}-\\frac{5}{\\sqrt{2}} \\\\ \\frac{5}{\\sqrt{2}} \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{3}\\begin{bmatrix}2 & -3 \\\\ -3 & 2 \\\\ -2 & -2\\end{bmatrix}\\begin{bmatrix}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{bmatrix}\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}\n$$\n\nsuch that \n\n$$\n\\left\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3} &=0 \\\\ {u}_{2}\\cdot {u}_{3} &=0,\\end{aligned}\\right.\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\left\\{\\begin{aligned}-\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2} &=0 \\\\ -\\frac{1}{3\\sqrt{2}}{x}_{1}-\\frac{1}{3\\sqrt{2}}{x}_{2}-\\frac{4}{3\\sqrt{2}}{x}_{3} &=0\\end{aligned}\\right.\\,⟹\\,\\left\\{\\begin{aligned}-{x}_{1}+{x}_{2} &=0 \\\\ -{x}_{1}-{x}_{2}-4{x}_{3} &=0,\\end{aligned}\\right.\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=\\begin{bmatrix}-\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{bmatrix}.\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=\\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{3\\sqrt{2}} & -\\frac{2}{3} \\\\ 0 & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3}\\end{bmatrix}\n$$"} :step/id #uuid "e4884cf0-a1fa-595d-912e-314992ac2509" :step/next {:db/id #edb/ref 17592186408024}} {:db/id #edb/ref 17592186408024 :step/content {:db/id #edb/ref 17592186408021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2078b66-2ae5-54f6-a460-e22e75e77234" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}_{2}" :db/id #edb/ref 17592186407979} {:answer/id #uuid "a891a29c-280f-5600-bd3a-be3e4b2b01f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186407982} {:answer/id #uuid "a9578c71-fcde-5fb5-a17c-8cd3bb804565" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{3}" :db/id #edb/ref 17592186407983}] :answer-field/correct {:db/id #edb/ref 17592186407982} :answer-field/id #uuid "0b9c438d-d68e-55fe-84e3-f15c3a21c90f" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408000} {:answer-field/choices [{:answer/id #uuid "11957032-84d5-5287-bd1c-5e6f76cf0b6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186407931} {:answer/id #uuid "89bc27fe-361d-55f9-8ddc-0f93f93b8b48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407970} {:answer/id #uuid "8fcb6f12-af61-54ef-b3a4-e5cdbd213eb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186407972} {:answer/id #uuid "a70a374b-4aab-5db4-9f20-c387df22f82c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186407981}] :answer-field/correct {:db/id #edb/ref 17592186407981} :answer-field/id #uuid "0cf930fc-e7fc-5a60-856d-576c2a81a972" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408001} {:answer-field/choices [{:answer/id #uuid "0a12e000-8edc-52d4-8be7-8c84eb934e65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186407929} {:answer/id #uuid "1c9d28e8-688f-5888-b109-