#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186185017} :activity/id #uuid "9f058771-3446-5ded-a35e-dcaf0a14a90a" :activity/scope {:db/id #edb/ref 17592186049136 :topic/id #uuid "dd9df00e-fa32-5b48-8cc0-53efc543597d" :topic/math-academy-id 3837} :activity/steps [{:db/id #edb/ref 17592186184892 :step/content {:db/id #edb/ref 17592186184142 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184052 :question/id #uuid "c049aaef-f59a-5113-b739-20cc7a6d802c" :question/math-academy-id "e-3520"} :knowledge-point/id #uuid "3155a85f-7bd8-584c-a5ae-e2e18dd60cd2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049059} {:db/id #edb/ref 17592186049773} {:db/id #edb/ref 17592186050714}] :knowledge-point/questions [{:db/id #edb/ref 17592186184824} {:db/id #edb/ref 17592186184838} {:db/id #edb/ref 17592186253580} {:db/id #edb/ref 17592186272268} {:db/id #edb/ref 17592186275139} {:db/id #edb/ref 17592186292744} {:db/id #edb/ref 17592186302291} {:db/id #edb/ref 17592186551248} {:db/id #edb/ref 17592186551312} {:db/id #edb/ref 17592186551320} {:db/id #edb/ref 17592186551344}] :knowledge-point/title "Computing the Sine of a Composite Angle Using Angles in the First Quadrant"} :step/id #uuid "1da36f0e-cde3-5812-8b1a-eeab11974263" :step/math-academy-id 11735 :step/next {:db/id #edb/ref 17592186185018}} {:db/id #edb/ref 17592186185017 :step/content {:db/id #edb/ref 17592186185347 :tutorial/content "We can compute trigonometric ratios using the sum and difference formulas for sine together with the Pythagorean identity.\n\nLet's suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\sin v = \\dfrac{3}{5}, \\qquad \\cos v = \\dfrac{4}{5}, \\qquad \\sin u = -\\dfrac{12}{13}.\n$$\n\nHow can we find the value of $\\sin\\left(u - v\\right)$ given that $u$ lies in the third quadrant? \n\nFirst, recall the difference formula for sine:\n\n$$\n\\sin(u-v) = \\sin u \\cos v- \\cos u \\sin v\n$$\n\nWe know the values of $\\sin{v}$, $\\cos{v}$, and $\\sin{u}.$ To find the missing value of $\\cos{u}$, we can use the Pythagorean identity:\n\n$$\n\\sin^2 u + \\cos^2 u= 1 \\qquad\\Longrightarrow\\qquad \\cos^2 u = 1- \\sin^2 u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(-\\frac{12}{13})}^{2} \\\\  & =1-{(\\frac{12}{13})}^{2} \\\\  & =1-\\frac{{12}^{2}}{{13}^{2}} \\\\  & =1-\\frac{144}{169} \\\\  & =\\frac{169}{169}-\\frac{144}{169} \\\\  & =\\frac{25}{169}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{25}{169}} \\\\  & =\\pm \\frac{5}{13}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the third quadrant, where cosine is negative. So, we disregard the positive value, and we have \n\n$$\n\\cos u= -\\dfrac{5}{13}.\n$$\n\nWe can now apply the difference formula as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(u-v) & =\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{12}{13})(\\frac{4}{5})-(-\\frac{5}{13})(\\frac{3}{5}) \\\\  & =-\\frac{48}{65}+\\frac{15}{65} \\\\  & =-\\frac{33}{65}.\\end{aligned}\n$$" :tutorial/id #uuid "699a9021-a261-5b19-b767-75fd52b030bd" :tutorial/math-academy-id 6203 :tutorial/title "Introduction"} :step/id #uuid "28ed07fc-351f-5531-9103-a17479e1cce6" :step/math-academy-id 37604 :step/next {:db/id #edb/ref 17592186184892}} {:db/id #edb/ref 17592186185018 :step/content {:db/id #edb/ref 17592186184226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184132 :question/id #uuid "06df772e-eb43-55e8-9ede-3fc2f7ae291d" :question/math-academy-id "e-9984"} :knowledge-point/id #uuid "99d7256f-6130-52b4-8188-3b1388c63f2b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048461}] :knowledge-point/questions [{:db/id #edb/ref 17592186184453} {:db/id #edb/ref 17592186184825} {:db/id #edb/ref 17592186275148} {:db/id #edb/ref 17592186292747} {:db/id #edb/ref 17592186302292} {:db/id #edb/ref 17592186551255} {:db/id #edb/ref 17592186551273} {:db/id #edb/ref 17592186551317} {:db/id #edb/ref 17592186551328} {:db/id #edb/ref 17592186551353}] :knowledge-point/title "Computing the Sine of a Composite Angle Using Angles in the Second, Third, or Fourth Quadrants"} :step/id #uuid "2c891011-e58f-5ba0-8625-0854ca6c6fa3" :step/math-academy-id 37605}] :activity/title "Calculating Trigonometric Ratios Using the Sum Formula for Sine" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184422}]}
