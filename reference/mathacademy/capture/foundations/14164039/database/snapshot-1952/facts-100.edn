2}+(y+3)^{2}-\\frac{(z+5)^{2}}{16} & =-1 \\\\ (x+4)^{2}+(y+3)^{2}+1 & =\\frac{(z+5)^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{(z+5)^{2}}{16} & =(x+4)^{2}+(y+3)^{2}+1 \\\\ (z+5)^{2} & =16((x+4)^{2}+(y+3)^{2}+1) \\\\ z+5 & =\\pm 4\\sqrt{(x+4)^{2}+(y+3)^{2}+1} \\\\ z & =-5\\pm 4\\sqrt{(x+4)^{2}+(y+3)^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n(x+4)^{2}+(y+3)^{2}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" #edb/ref 17592186045417] [17592186488263 #edb/ref 1068 #edb/ref 17592186488163 #edb/ref 17592186045417] [17592186488263 #edb/ref 1069 "q-164375" #edb/ref 17592186045417] [17592186488263 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186488263 #edb/ref 1071 "What is the trace in the $xz$-plane of the hyperboloid of two sheets $-\\frac{{x}^{2}}{4}+{y}^{2}+{z}^{2}=-1?$" #edb/ref 17592186045417] [17592186488263 #edb/ref 1072 #uuid "cfd858a6-a00f-5a94-8347-c41608b62519" #edb/ref 17592186045417] [17592186488263 #edb/ref 1074 "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the hyperboloid. This gives:\n\n$$\n\\begin{aligned}-\\frac{{x}^{2}}{4}+{0}^{2}+{z}^{2} & =-1 \\\\ -\\frac{{x}^{2}}{4}+{z}^{2} & =-1 \\\\ \\frac{{x}^{2}}{4}-{z}^{2} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $xz$-plane." #edb/ref 17592186045417] [17592186488298 #edb/ref 1058 #edb/ref 17592186488342 #edb/ref 17592186045417] [17592186488298 #edb/ref 1062 #uuid "346ce6bc-5f2c-5170-a37c-8daa10ff6d75" #edb/ref 17592186045417] [17592186488298 #edb/ref 1063 #edb/ref 17592186284469 #edb/ref 17592186045417] [17592186488333 #edb/ref 1058 #edb/ref 17592186488340 #edb/ref 17592186045417] [17592186488333 #edb/ref 1062 #uuid "c766094c-6eab-58b2-b2f3-4c23eb53e41f" #edb/ref 17592186045417] [17592186488333 #edb/ref 1063 #edb/ref 17592186284468 #edb/ref 17592186045417] [17592186488340 #edb/ref 1058 #edb/re