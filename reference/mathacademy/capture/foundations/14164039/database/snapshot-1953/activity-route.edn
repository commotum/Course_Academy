#{[{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186488348} :activity/id #uuid "f044953d-ed45-518b-a59c-617113ac03a7" :activity/scope {:db/id #edb/ref 17592186048527 :topic/id #uuid "a715d0ff-c3bf-59f0-8f15-f8770c11ebac" :topic/math-academy-id 1892} :activity/steps [{:db/id #edb/ref 17592186488298 :step/content {:db/id #edb/ref 17592186284469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28dfc208-68c2-5f88-8bd4-209d53beb5ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186282042} {:answer/id #uuid "36789465-716b-57b5-bcb5-c61d70e72a4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\le 3\\}" :db/id #edb/ref 17592186487670} {:answer/id #uuid "389cbac5-a671-5c39-a922-51617d9c06fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}>1\\}" :db/id #edb/ref 17592186487674} {:answer/id #uuid "639e7663-1b18-512b-aaa1-be4700f6151a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\ge 1\\}" :db/id #edb/ref 17592186487764} {:answer/id #uuid "c59c6bc5-e7d5-524f-b87d-e788fbdad7bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}<3\\}" :db/id #edb/ref 17592186487943}] :answer-field/correct {:db/id #edb/ref 17592186487764} :answer-field/id #uuid "0ac34746-de0d-5226-892a-e787c1d531e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283953}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cc95e142-b514-5431-9924-bdc1db9331dd" :question/math-academy-id "q-164307" :question/problem "Given the hyperboloid of one sheet $(x+5)^{2}+{y}^{2}-(z-3)^{2}=1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+5)^{2}+{y}^{2}-(z-3)^{2} & =1 \\\\ (x+5)^{2}+{y}^{2}-1 & =(z-3)^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}(z-3)^{2} & =(x+5)^{2}+{y}^{2}-1 \\\\ z-3 & =\\pm \\sqrt{(x+5)^{2}+{y}^{2}-1} \\\\ z & =3\\pm \\sqrt{(x+5)^{2}+{y}^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have\n\n$$\n\\begin{aligned}(x+5)^{2}+{y}^{2}-1 & \\ge 0 \\\\ (x+5)^{2}+{y}^{2} & \\ge 1,\\end{aligned}\n$$\n\nwhich gives the exterior of the circle $(x+5)^{2}+{y}^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\ge 1\\}.\n$$"} :step/id #uuid "346ce6bc-5f2c-5170-a37c-8daa10ff6d75" :step/next {:db/id #edb/ref 17592186488342}} {:db/id #edb/ref 17592186488333 :step/content {:db/id #edb/ref 17592186284468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051774ba-959a-5c1e-a9f4-ba2f7128c841" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186281733} {:answer/id #uuid "3dcc081f-8c87-52c8-b3e1-e3a8a332e58f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,{x}^{2}+\\frac{(y-3)^{2}}{9}\\le 1\\}" :db/id #edb/ref 17592186487686} {:answer/id #uuid "a77b95d1-fceb-5a52-bb2a-611c7c686bdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,{x}^{2}+\\frac{(y-3)^{2}}{9}<1\\}" :db/id #edb/ref 17592186487882} {:answer/id #uuid "d3c48da9-56f6-56f4-b48e-a9ee4cfebf84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,{x}^{2}+\\frac{(y-3)^{2}}{9}>1\\}" :db/id #edb/ref 17592186487969} {:answer/id #uuid "e4f233b9-83c6-5d23-a7ab-9cd273335e98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,{x}^{2}+\\frac{(y-3)^{2}}{9}\\ge 1\\}" :db/id #edb/ref 17592186488003}] :answer-field/correct {:db/id #edb/ref 17592186281733} :answer-field/id #uuid "f0ed39c8-50b3-5c43-b5b6-cec23b5c61a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284360}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e42866d-b20f-5a25-a416-745497c6d775" :question/math-academy-id "q-164305" :question/problem "Given the hyperboloid of two sheets ${x}^{2}+\\frac{(y-3)^{2}}{9}-{z}^{2}=-1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}{x}^{2}+\\frac{(y-3)^{2}}{9}-{z}^{2} & =-1 \\\\ {x}^{2}+\\frac{(y-3)^{2}}{9}+1 & ={z}^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & ={x}^{2}+\\frac{(y-3)^{2}}{9}+1 \\\\ z & =\\pm \\sqrt{{x}^{2}+\\frac{(y-3)^{2}}{9}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n{x}^{2}+\\frac{(y-3)^{2}}{9}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$"} :step/id #uuid "c766094c-6eab-58b2-b2f3-4c23eb53e41f" :step/next {:db/id #edb/ref 17592186488340}} {:db/id #edb/ref 17592186488340 :step/content {:db/id #edb/ref 17592186488228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fcdf940-6360-5efc-815a-67685f2bcd39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{2}" :db/id #edb/ref 17592186487692} {:answer/id #uuid "8d2dd945-a79f-5959-bfa8-cdfafd1ac3cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+4)^{2}+(y+3)^{2}\\le 1\\}" :db/id #edb/ref 17592186487834} {:answer/id #uuid "ad54fb20-d344-5be0-b621-c08138a7d222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+4)^{2}+(y+3)^{2}>1\\}" :db/id #edb/ref 17592186487897} {:answer/id #uuid "c00ed966-6006-5b17-8212-cacd1e467d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+4)^{2}+(y+3)^{2}\\ge 1\\}" :db/id #edb/ref 17592186487928} {:answer/id #uuid "c13ff75f-ea2e-5e78-b3fd-6dfe315f448e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{(x,y)\\,:\\,(x+4)^{2}+(y+3)^{2}<1\\}" :db/id #edb/ref 17592186487931}] :answer-field/correct {:db/id #edb/ref 17592186487692} :answer-field/id #uuid "751f8b2e-9f8a-59f7-8b55-6cf5ae31cd83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488098}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "756c31bd-d0b5-518e-8fa8-bf3e64b797d5" :question/math-academy-id "q-164306" :question/problem "Given the hyperboloid of two sheets $(x+4)^{2}+(y+3)^{2}-\\frac{(z+5)^{2}}{16}=-1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+4)^{2}+(y+3)^{2}-\\frac{(z+5)^{2}}{16} & =-1 \\\\ (x+4)^{2}+(y+3)^{2}+1 & =\\frac{(z+5)^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{(z+5)^{2}}{16} & =(x+4)^{2}+(y+3)^{2}+1 \\\\ (z+5)^{2} & =16((x+4)^{2}+(y+3)^{2}+1) \\\\ z+5 & =\\pm 4\\sqrt{(x+4)^{2}+(y+3)^{2}+1} \\\\ z & =-5\\pm 4\\sqrt{(x+4)^{2}+(y+3)^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n(x+4)^{2}+(y+3)^{2}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$"} :step/id #uuid "e921225c-624b-5c95-9668-3ca7e3b9bedb" :step/next {:db/id #edb/ref 17592186488298}} {:db/id #edb/ref 17592186488342 :step/content {:db/id #edb/ref 17592186488263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58602c0f-accf-5f29-9ed8-3bc7fca41325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{2}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186487746} {:answer/id #uuid "9f47998e-e870-56c4-baa4-8f352b659234" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}+{z}^{2}=1" :db/id #edb/ref 17592186487862} {:answer/id #uuid "a290ce1e-061b-5f18-9739-ce332aa415a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{z}^{2}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186487870} {:answer/id #uuid "cd8afb28-1c32-5f0f-a8c4-af9d56f35d12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}-{z}^{2}=1" :db/id #edb/ref 17592186487959} {:answer/id #uuid "ecef13cd-61bd-588f-a9df-6b1c14e317f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}}{4}-{y}^{2}=1" :db/id #edb/ref 17592186488014}] :answer-field/correct {:db/id #edb/ref 17592186487959} :answer-field/id #uuid "eb913cd1-fa9a-53a5-80ea-84008e65ffbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186488163}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfd858a6-a00f-5a94-8347-c41608b62519" :question/math-academy-id "q-164375" :question/problem "What is the trace in the $xz$-plane of the hyperboloid of two sheets $-\\frac{{x}^{2}}{4}+{y}^{2}+{z}^{2}=-1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the hyperboloid. This gives:\n\n$$\n\\begin{aligned}-\\frac{{x}^{2}}{4}+{0}^{2}+{z}^{2} & =-1 \\\\ -\\frac{{x}^{2}}{4}+{z}^{2} & =-1 \\\\ \\frac{{x}^{2}}{4}-{z}^{2} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $xz$-plane."} :step/id #uuid "ee6f7b73-925c-51b7-8db4-73cd3744c6e3"} {:db/id #edb/ref 17592186488348 :step/content {:db/id #edb/ref 17592186391951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b38fc56c-0b29-550e-b109-d771f89562da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$" :db/id #edb/ref 17592186391953} {:answer/id #uuid "8b0c9da7-de70-5aea-8bf7-5c9b4d287b28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186391954} {:answer/id #uuid "003b79b6-3c82-5aed-b7a9-37fc9aef1484" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391955} {:answer/id #uuid "8fa71829-34e0-581f-aa98-5fcdef3852dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Two parallel lines: $z=2x\\pm 4$" :db/id #edb/ref 17592186391956} {:answer/id #uuid "f376e4eb-51f9-5938-9cba-d55cb6cf1e60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{2}+\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186391957}] :answer-field/correct {:db/id #edb/ref 17592186391954} :answer-field/id #uuid "8d57934b-d5eb-5a5a-8448-b8cae29a9df0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186391952}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fcfedd1b-1d6b-51cf-8ffc-3860006da14a" :question/math-academy-id "q-36288" :question/problem "What is the projection of the intersection between the hyperboloid of two sheets $\\frac{(x-2)^{2}}{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$ and the plane $y=2$ onto the $xz$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $y=2$, we substitute $y=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(2)^{2}}{4}-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}+1-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8} & =-2 \\\\ -\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16} & =1\\end{aligned}\n$$\n\nSo, we get the hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1.$"} :step/id #uuid "fa19a58c-a70e-5db0-ade4-effabe26c294" :step/next {:db/id #edb/ref 17592186488333}}] :activity/title "Hyperboloids" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186487565}]}
