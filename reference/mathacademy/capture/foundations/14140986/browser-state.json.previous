o stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.278em\"></mspace></mstyle><mn>3</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mo>−</mo><mn>25</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>16</mn><mo>−</mo><mn>2</mn><mo>−</mo><mn>75</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>61</mn></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
