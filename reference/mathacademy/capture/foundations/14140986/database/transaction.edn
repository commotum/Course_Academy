67-5574-9f7e-9bbc7ec96a39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c868e06-3d4f-58da-ac1c-394649473371" :answer-field/choices ["answer-8f647f5b-f844-5f83-a3b5-4dd41251ce53" "answer-cc450cf0-b19f-5ea7-a21a-77cc584560d4" "answer-0c868e06-3d4f-58da-ac1c-394649473371" "answer-a5827dcf-e234-5aca-a530-b57e41c8cee9" "answer-db6f97ee-90ca-5331-9ef0-435bc5aba44f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f647f5b-f844-5f83-a3b5-4dd41251ce53" :answer/id #uuid "8f647f5b-f844-5f83-a3b5-4dd41251ce53" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-cc450cf0-b19f-5ea7-a21a-77cc584560d4" :answer/id #uuid "cc450cf0-b19f-5ea7-a21a-77cc584560d4" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-0c868e06-3d4f-58da-ac1c-394649473371" :answer/id #uuid "0c868e06-3d4f-58da-ac1c-394649473371" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "answer-a5827dcf-e234-5aca-a530-b57e41c8cee9" :answer/id #uuid "a5827dcf-e234-5aca-a530-b57e41c8cee9" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-db6f97ee-90ca-5331-9ef0-435bc5aba44f" :answer/id #uuid "db6f97ee-90ca-5331-9ef0-435bc5aba44f" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id 17592186106131 :question/problem "Given that $a=⟨0,-2,3⟩,$ $b=⟨4,-2,1⟩,$ and $c=⟨3,-1,2⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 4 & -2 & 1 \\\\ 3 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 1 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}4 & 1 \\\\ 3 & 2\\end{aligned}|j+|\\begin{aligned}4 & -2 \\\\ 3 & -1\\end{aligned}|k \\\\  & =((-2)\\cdot 2-1\\cdot (-1))i-(4\\cdot 2-1\\cdot 3)j+(4\\cdot (-1)-(-2)\\cdot 3)k \\\\  & =-3i-5j+2k \\\\  & =⟨-3,-5,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,-2,3⟩\\cdot ⟨-3,-5,2⟩ \\\\  & =0\\cdot (-3)+(-2)\\cdot (-5)+3\\cdot 2 \\\\  & =16.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186102662 :answer-field/correct 17592186102667 :db/ensure [:answer-field/validate]} {:db/id "question-9c2e5f62-97b7-5f13-893d-335d40132469" :question/id #uuid "9c2e5f62-97b7-5f13-893d-335d40132469" :question/math-academy-id "q-317306" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨2\\sqrt{2},\\,-1,\\,4⟩$ and $b\\times c=⟨-2\\sqrt{2},\\,3,\\,-5⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2\\sqrt{2},\\,-1,\\,4⟩\\cdot ⟨-2\\sqrt{2},\\,3,\\,-5⟩ \\\\  & =(2\\sqrt{2})(-2\\sqrt{2})+(-1)(3)+(4)(-5) \\\\  & =-8-3-20 \\\\  & =-31.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-afdc93fa-0aca-5068-a46b-19029c20890d"] :db/ensure [:question/validate]} {:db/id "answer-field-afdc93fa-0aca-5068-a46b-19029c20890d" :answer-field/id #uuid "afdc93fa-0aca-5068-a46b-19029c20890d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-27685b8e-75cd-51d4-8f57-2c5a8d85852f" :answer-field/choices ["answer-27685b8e-75cd-51d4-8f57-2c5a8d85852f"] :db/ensure [:answer-field/validate]} {:db/id "answer-27685b8e-75cd-51d4-8f57-2c5a8d85852f" :answer/id #uuid "27685b8e-75cd-51d4-8f57-2c5a8d85852f" :answer/type :answer.type/math :answer/value "-31" :db/ensure [:answer/validate]} {:db/id "question-77263833-2d61-5397-981f-0a043abf2225" :question/id #uuid "77263833-2d61-5397-981f-0a043abf2225" :question/math-academy-id "q-73451" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-5,2,3⟩$ and $b\\times c=⟨1,-5,4⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-5,2,3⟩\\cdot ⟨1,-5,4⟩ \\\\  & =(-5)\\cdot 1+2\\cdot (-5)+3\\cdot 4 \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-827eac35-448a-5c6d-a1b3-05ca38d592f4"] :db/ensure [:question/validate]} {:db/id "answer-field-827eac35-448a-5c6d-a1b3-05ca38d592f4" :answer-field/id #uuid "827eac35-448a-5c6d-a1b3-05ca38d592f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" :answer-field/choices ["answer-e3516f72-8edb-54cf-a1ba-115368557ea8" "answer-159b7861-635b-50f0-91b9-d5cd93472fe0" "answer-0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" "answer-a770a7ff-df6f-5dec-bec7-267dbaa53948" "answer-10a95030-65da-5159-a9c2-11449ebd9b71"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3516f72-8edb-54cf-a1ba-115368557ea8" :answer/id #uuid "e3516f72-8edb-54cf-a1ba-115368557ea8" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-159b7861-635b-50f0-91b9-d5cd93472fe0" :answer/id #uuid "159b7861-635b-50f0-91b9-d5cd93472fe0" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" :answer/id #uuid "0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-a770a7ff-df6f-5dec-bec7-267dbaa53948" :answer/id #uuid "a770a7ff-df6f-5dec-bec7-267dbaa53948" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-10a95030-65da-5159-a9c2-11449ebd9b71" :answer/id #uuid "10a95030-65da-5159-a9c2-11449ebd9b71" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186408071 :question/problem "Let $r=⟨-4,-1,2⟩$, $q=⟨-2,3,1⟩$ and $p=⟨5,-2,-1⟩.$ Find $r\\cdot (q\\times p)$ using a determinant.\n\n$r\\cdot (q\\times p)=$\n{{field-1}}" :db/ensure [:question/validate]} {:db/id "question-26ec4cd9-8af6-5de8-b3cc-526d00b07bfc" :question/id #uuid "26ec4cd9-8af6-5de8-b3cc-526d00b07bfc" :question/math-academy-id "q-317344" :question/problem "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨7,-2,3⟩$ and $a=⟨1,4,2⟩.$\n\n$c\\cdot (a\\times b)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,4,2⟩\\cdot ⟨7,-2,3⟩ \\\\  & =1\\cdot 7+4\\cdot (-2)+2\\cdot 3 \\\\  & =7-8+6 \\\\  & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-5\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c02ae549-228a-54f0-a3ff-7af356d2a5aa"] :db/ensure [:question/validate]} {:db/id "answer-field-c02ae549-228a-54f0-a3ff-7af356d2a5aa" :answer-field/id #uuid "c02ae549-228a-54f0-a3ff-7af356d2a5aa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-21f97420-5edb-586f-ab7a-66299006cada" :answer-field/choices ["answer-21f97420-5edb-586f-ab7a-66299006cada"] :db/ensure [:answer-field/validate]} {:db/id "answer-21f97420-5edb-586f-ab7a-66299006cada" :answer/id #uuid "21f97420-5edb-586f-ab7a-66299006cada" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-661d9816-4244-5782-9d68-b93f1424eb3e" :question/id #uuid "661d9816-4244-5782-9d68-b93f1424eb3e" :question/math-academy-id "q-317348" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨-2,5,4⟩$ and $a=⟨-1,3,2⟩.$\n\n$c\\cdot (b\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,3,2⟩\\cdot ⟨-2,5,4⟩ \\\\  & =(-1)\\cdot (-2)+3\\cdot 5+2\\cdot 4 \\\\  & =2+15+8 \\\\  & =25.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-56dee8e9-07f4-5b22-acca-8f6df3bf286f"] :db/ensure [:question/validate]} {:db/id "answer-field-56dee8e9-07f4-5b22-acca-8f6df3bf286f" :answer-field/id #uuid "56dee8e9-07f4-5b22-acca-8f6df3bf286f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c37b847b-0603-5e0f-8973-9dd05a27d3d1" :answer-field/choices ["answer-c37b847b-0603-5e0f-8973-9dd05a27d3d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c37b847b-0603-5e0f-8973-9dd05a27d3d1" :answer/id #uuid "c37b847b-0603-5e0f-8973-9dd05a27d3d1" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "question-e30f2d7c-8431-5cce-a8b2-50fb65874116" :question/id #uuid "e30f2d7c-8431-5cce-a8b2-50fb65874116" :question/math-academy-id "q-317333" :question/problem "Find $b\\cdot (a\\times c)$, if $5a\\cdot ((-4b)\\times (-3c))=-120.$\n\n$b\\cdot (a\\times c)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}5a\\cdot ((-4b)\\times (-3c)) & =-120 \\\\ 5\\cdot (-4)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =-120 \\\\ 60[a\\cdot (b\\times c)] & =-120 \\\\ a\\cdot (b\\times c) & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\nb\\cdot (a\\times c)=2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a5b05a0-2b4a-5a26-9708-cfdb631cd43b"] :db/ensure [:question/validate]} {:db/id "answer-field-9a5b05a0-2b4a-5a26-9708-cfdb631cd43b" :answer-field/id #uuid "9a5b05a0-2b4a-5a26-9708-cfdb631cd43b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5" :answer-field/choices ["answer-4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5" :answer/id #uuid "4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-0d6554d4-4442-5e1f-83e6-be1fca151acc" :question/id #uuid "0d6554d4-4442-5e1f-83e6-be1fca151acc" :question/math-academy-id "q-20067" :question/problem "Find $b\\cdot (c\\times a)$, if $b\\times c=⟨2,-5,7⟩$ and $a=⟨8,-2,-4⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨8,-2,-4⟩\\cdot ⟨2,-5,7⟩ \\\\  & =8\\cdot 2+(-2)\\cdot (-5)+(-4)\\cdot 7 \\\\  & =16+10-28 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=2,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-50946ad3-7b33-5f99-8c2f-0f86e0968171"] :db/ensure [:question/validate]} {:db/id "answer-field-50946ad3-7b33-5f99-8c2f-0f86e0968171" :answer-field/id #uuid "50946ad3-7b33-5f99-8c2f-0f86e0968171" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ced8cb93-fea7-5255-adf7-bbf81df0fb94" :answer-field/choices ["answer-ced8cb93-fea7-5255-adf7-bbf81df0fb94" "answer-47b586ec-b7a1-51dc-aebe-7c3c8e874aa7" "answer-0d1d4e45-804b-5781-a8d5-a26e64d5d107" "answer-8f9314df-764a-5a13-88af-6d3fa98e5570" "answer-d8ee39a5-5e9c-56c4-a239-5bf26581cedf"] :db/ensure [:answer-field/validate]} {:db/id "answer-ced8cb93-fea7-5255-adf7-bbf81df0fb94" :answer/id #uuid "ced8cb93-fea7-5255-adf7-bbf81df0fb94" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-47b586ec-b7a1-51dc-aebe-7c3c8e874aa7" :answer/id #uuid "47b586ec-b7a1-51dc-aebe-7c3c8e874aa7" :answer/type :answer.type/math :answer/value "-26" :db/ensure [:answer/validate]} {:db/id "answer-0d1d4e45-804b-5781-a8d5-a26e64d5d107" :answer/id #uuid "0d1d4e45-804b-5781-a8d5-a26e64d5d107" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-8f9314df-764a-5a13-88af-6d3fa98e5570" :answer/id #uuid "8f9314df-764a-5a13-88af-6d3fa98e5570" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d8ee39a5-5e9c-56c4-a239-5bf26581cedf" :answer/id #uuid "d8ee39a5-5e9c-56c4-a239-5bf26581cedf" :answer/type :answer.type/math :answer/value "⟨2,1,0⟩" :db/ensure [:answer/validate]} {:db/id 17592186107076 :tutorial/content "The scalar triple product has two important properties.\n\nFirst, scalars can be factored out of the product. For example,\n\n$$\n({\\color{red}2}\\mathbf{a}) \\cdot (\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot ({\\color{red}2}\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot (\\mathbf{b} \\times {\\color{red}2}\\mathbf{c}) = {\\color{red}2}\\left[ \\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})\\right].\n$$\n\nSecond, if we swap exactly two vectors in the scalar triple product, the result changes sign. For example, swapping $\\mathbf{a}$ and $\\mathbf{b},$ we have\n\n$$\n{\\color{red}\\mathbf{a}} \\cdot ( {\\color{blue}\\mathbf{b}} \\times \\mathbf{c}) = - {\\color{blue}\\mathbf{b}} \\cdot ( {\\color{red}\\mathbf{a}} \\times \\mathbf{c}).\n$$\n\nNote that if we swap twice, then the result remains the same, because the negatives cancel out. For example, swapping $\\color{red}\\mathbf{a}$ and $\\color{blue}\\mathbf{b}$ and then swapping $\\color{red}\\mathbf{a}$ and $\\mathbf{c},$ we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =-b\\cdot (a\\times c) \\\\  & =-(-b\\cdot (c\\times a)) \\\\  & =b\\cdot (c\\times a).\\end{aligned}\n$$\n\nThese properties arise naturally from the fact that the scalar triple product can be computed as a determinant.\n\n1\\. If we multiply a row of the matrix by a number, then the determinant is multiplied by that number:\n  ![](images/82/827b78de142e085b00c9c7eccb43ba32b30861ef45d91b53b1f35c86a67b78f4.svg)\n\n2\\. If we swap two rows, then the determinant changes sign:\n  ![](images/ac/acadadda23e53448493a31441e2d3e53e89b6a320d6b4040c7567a2489d3cff3.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186105963 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]}]
