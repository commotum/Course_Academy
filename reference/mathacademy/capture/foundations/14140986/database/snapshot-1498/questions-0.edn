#{[{:db/id #edb/ref 17592186105593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/id #uuid "2f380683-0d93-541d-a07d-95a1d889c761" :question/math-academy-id "e-4347" :question/problem "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 5 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 5 \\\\ 2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & 5 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0\\cdot 3-5\\cdot 2)i-(-1\\cdot 3-5\\cdot 1)j+(-1\\cdot 2-0\\cdot 2)k \\\\  & =-10i+8j-2k \\\\  & =⟨-10,8,-2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,-3,2⟩\\cdot ⟨-10,8,-2⟩ \\\\  & =2\\cdot (-10)+(-3)\\cdot 8+2\\cdot (-2) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105594 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/id #uuid "b5cf98f2-087d-580c-a2f6-c37ad2af4c2c" :question/math-academy-id "e-4348" :question/problem "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle,$ $\\mathbf{b}=\\langle 0,2,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,-1,2 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ -1 & -1\\end{aligned}| \\\\  & =4\\cdot (2\\cdot 2-1\\cdot (-1))-2\\cdot (0\\cdot 2-1\\cdot (-1))+(-1)\\cdot (0\\cdot (-1)-2\\cdot (-1)) \\\\  & =20-2-2 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105595 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/id #uuid "483b758a-9b14-5a72-87e5-70f27a0acf48" :question/math-academy-id "e-4349" :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436856 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c868e06-3d4f-58da-ac1c-394649473371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186436823} {:answer/id #uuid "8f647f5b-f844-5f83-a3b5-4dd41251ce53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186436833} {:answer/id #uuid "a5827dcf-e234-5aca-a530-b57e41c8cee9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186436836} {:answer/id #uuid "cc450cf0-b19f-5ea7-a21a-77cc584560d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186436840} {:answer/id #uuid "db6f97ee-90ca-5331-9ef0-435bc5aba44f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186436843}] :answer-field/correct {:answer/id #uuid "0c868e06-3d4f-58da-ac1c-394649473371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186436823} :answer-field/id #uuid "19000978-0267-5574-9f7e-9bbc7ec96a39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11bcd21b-33cd-5c67-b5f7-a5248fa0b15a" :question/math-academy-id "q-128090" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-2,0,4⟩$ and $b\\times c=⟨7,-4,9⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,0,4⟩\\cdot ⟨7,-4,9⟩ \\\\  & =(-2)\\cdot 7+0\\cdot (-4)+4\\cdot 9 \\\\  & =22.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436860 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64225d0e-e8e7-5a62-ba67-a47c2125c90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186436832} {:answer/id #uuid "a490d505-52ab-5416-8a32-5429f938b745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186436835} {:answer/id #uuid "c2ebf10e-c933-5ba3-a9e0-1a62a27771b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186436838} {:answer/id #uuid "f98f5e82-18cb-5ae0-8ec5-0ba8c856e8be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186436845} {:answer/id #uuid "f9e0cc5c-df06-54c7-9fce-ac55f53eeb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186436846}] :answer-field/correct {:answer/id #uuid "64225d0e-e8e7-5a62-ba67-a47c2125c90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186436832} :answer-field/id #uuid "84e1a389-e227-565c-848f-f4e0c19bfd02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436851}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97c82ac3-b53e-55cf-b9b8-2b725636dcb8" :question/math-academy-id "q-128093" :question/problem "Given that $a=⟨5,-8,-7⟩,$ $b=⟨-1,1,2⟩,$ and $c=⟨-3,1,0⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 1 & 2 \\\\ -3 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ -3 & 0\\end{aligned}|j+|\\begin{aligned}-1 & 1 \\\\ -3 & 1\\end{aligned}|k \\\\  & =(1\\cdot 0-1\\cdot 2)i-(-1\\cdot 0-(-3)\\cdot 2)j+((-1)\\cdot 1-(-3)\\cdot 1)k \\\\  & =-2i-6j+2k \\\\  & =⟨-2,-6,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨5,-8,-7⟩\\cdot ⟨-2,-6,2⟩ \\\\  & =5\\cdot (-2)+(-8)\\cdot (-6)+(-7)\\cdot 2 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186410422 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29595116-806d-5a50-ab1b-9695013bab97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410234} {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} {:answer/id #uuid "87da3e47-9864-54d6-b40d-2913c6ae3373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186410286} {:answer/id #uuid "ba4d127a-493d-5de0-a877-1ac772d55fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186410329} {:answer/id #uuid "f7d42b31-2f13-5fd5-a529-f48c87f1b72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186410369}] :answer-field/correct {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} :answer-field/id #uuid "81bc68bf-9d8f-562a-bde6-27ff85778ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35202296-3c02-529f-93c9-ab75d2fe58b2" :question/math-academy-id "q-128355" :question/problem "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨4,3,-5⟩$ and $a=⟨-2,8,2⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,8,2⟩\\cdot ⟨4,3,-5⟩ \\\\  & =(-2)\\cdot 4+8\\cdot 3+2\\cdot (-5) \\\\  & =-8+24-10 \\\\  & =6.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-6\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287972 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1868bb81-71b6-5f50-8657-a4862c1f609e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186285005} {:answer/id #uuid "2cdccd16-86aa-576c-bb76-82d6055e2720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186285184} {:answer/id #uuid "39d88586-7aa2-5d90-adfe-ac64bd3a8ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186285331} {:answer/id #uuid "a567177a-6805-5d8a-9d10-fde433c3ecd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186286298} {:answer/id #uuid "de641599-4761-523f-91dd-a114e0a85611" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186286811}] :answer-field/correct {:answer/id #uuid "1868bb81-71b6-5f50-8657-a4862c1f609e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186285005} :answer-field/id #uuid "699666f7-e0ff-5c75-8d34-1ee5373ce603" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75f9d3bd-a296-5c60-a85d-8a17773b59f9" :question/math-academy-id "q-20050" :question/problem "Let $a=⟨1,3,2⟩$, $b=⟨3,4,1⟩$ and $c=⟨2,0,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 3 & 2 \\\\ 3 & 4 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}4 & 1 \\\\ 0 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}3 & 1 \\\\ 2 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}3 & 4 \\\\ 2 & 0\\end{aligned}| \\\\  & =(4\\cdot 1-0\\cdot 1)-3(3\\cdot 1-2\\cdot 1)+2(3\\cdot 0-2\\cdot 4) \\\\  & =4-3-16 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106131 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6351ad9-60eb-5c1f-b085-0679828a8f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186102663} {:answer/id #uuid "bd21b2e9-ea49-5df3-8d99-5c5fe08c5507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186102664} {:answer/id #uuid "de9107a1-a714-5163-bbc2-967ba2fe6b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186102665} {:answer/id #uuid "f05b096d-b558-5756-8dfd-2ddf5e8baaf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186102666} {:answer/id #uuid "f58ada1e-09a7-5c98-bb8c-566d28d2cc28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186102667}] :answer-field/correct {:answer/id #uuid "f58ada1e-09a7-5c98-bb8c-566d28d2cc28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186102667} :answer-field/id #uuid "ab5f7550-d466-5039-802c-5c3f0c6aa926" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102662}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb9b799b-95c5-5b8c-b1f0-b4bcc39f76c4" :question/math-academy-id "q-20065" :question/problem "Given that $a=⟨0,-2,3⟩,$ $b=⟨4,-2,1⟩,$ and $c=⟨3,-1,2⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 4 & -2 & 1 \\\\ 3 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 1 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}4 & 1 \\\\ 3 & 2\\end{aligned}|j+|\\begin{aligned}4 & -2 \\\\ 3 & -1\\end{aligned}|k \\\\  & =((-2)\\cdot 2-1\\cdot (-1))i-(4\\cdot 2-1\\cdot 3)j+(4\\cdot (-1)-(-2)\\cdot 3)k \\\\  & =-3i-5j+2k \\\\  & =⟨-3,-5,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,-2,3⟩\\cdot ⟨-3,-5,2⟩ \\\\  & =0\\cdot (-3)+(-2)\\cdot (-5)+3\\cdot 2 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436855 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1d4e45-804b-5781-a8d5-a26e64d5d107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186436825} {:answer/id #uuid "47b586ec-b7a1-51dc-aebe-7c3c8e874aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186436830} {:answer/id #uuid "8f9314df-764a-5a13-88af-6d3fa98e5570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186436834} {:answer/id #uuid "ced8cb93-fea7-5255-adf7-bbf81df0fb94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436841} {:answer/id #uuid "d8ee39a5-5e9c-56c4-a239-5bf26581cedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,1,0⟩" :db/id #edb/ref 17592186436842}] :answer-field/correct {:answer/id #uuid "ced8cb93-fea7-5255-adf7-bbf81df0fb94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436841} :answer-field/id #uuid "50946ad3-7b33-5f99-8c2f-0f86e0968171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d6554d4-4442-5e1f-83e6-be1fca151acc" :question/math-academy-id "q-20067" :question/problem "Find $b\\cdot (c\\times a)$, if $b\\times c=⟨2,-5,7⟩$ and $a=⟨8,-2,-4⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨8,-2,-4⟩\\cdot ⟨2,-5,7⟩ \\\\  & =8\\cdot 2+(-2)\\cdot (-5)+(-4)\\cdot 7 \\\\  & =16+10-28 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=2,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186408071 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3276117f-c9fb-5648-baa7-3ddf01111aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186408047}] :answer-field/correct {:answer/id #uuid "3276117f-c9fb-5648-baa7-3ddf01111aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186408047} :answer-field/id #uuid "1c0686c8-e24f-53f9-b174-994346511b51" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186408065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40346cc1-7283-5552-9863-224be650a17a" :question/math-academy-id "q-275350" :question/problem "Let $r=⟨-4,-1,2⟩$, $q=⟨-2,3,1⟩$ and $p=⟨5,-2,-1⟩.$ Find $r\\cdot (q\\times p)$ using a determinant.\n\n$r\\cdot (q\\times p)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =|\\begin{aligned}-4 & -1 & 2 \\\\ -2 & 3 & 1 \\\\ 5 & -2 & -1\\end{aligned}| \\\\  & =(-4)\\cdot |\\begin{aligned}3 & 1 \\\\ -2 & -1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}-2 & 1 \\\\ 5 & -1\\end{aligned}|+2\\cdot |\\begin{aligned}-2 & 3 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-4)(3\\cdot (-1)-(-2)\\cdot 1)+((-2)\\cdot (-1)-5\\cdot 1)+2((-2)\\cdot (-2)-5\\cdot 3) \\\\  & =(-4)(-3+2)+(2-5)+2(4-15) \\\\  & =4-3-22 \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436861 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27685b8e-75cd-51d4-8f57-2c5a8d85852f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-31" :db/id #edb/ref 17592186436829}] :answer-field/correct {:answer/id #uuid "27685b8e-75cd-51d4-8f57-2c5a8d85852f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-31" :db/id #edb/ref 17592186436829} :answer-field/id #uuid "afdc93fa-0aca-5068-a46b-19029c20890d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186436853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c2e5f62-97b7-5f13-893d-335d40132469" :question/math-academy-id "q-317306" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨2\\sqrt{2},\\,-1,\\,4⟩$ and $b\\times c=⟨-2\\sqrt{2},\\,3,\\,-5⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2\\sqrt{2},\\,-1,\\,4⟩\\cdot ⟨-2\\sqrt{2},\\,3,\\,-5⟩ \\\\  & =(2\\sqrt{2})(-2\\sqrt{2})+(-1)(3)+(4)(-5) \\\\  & =-8-3-20 \\\\  & =-31.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186419785 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186419781}] :answer-field/correct {:answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186419781} :answer-field/id #uuid "cea71914-4f17-5f64-8016-140e481b698d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419784}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20209d26-6af3-5176-8409-17df2aefc0b9" :question/math-academy-id "q-317313" :question/problem "Let $a=⟨1,-3,0⟩$, $b=⟨-2,2,0⟩$ and $c=⟨2,0,-4⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -3 & 0 \\\\ -2 & 2 & 0 \\\\ 2 & 0 & -4\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}|\\,-\\,(-3)\\cdot |\\begin{aligned}-2 & 0 \\\\ 2 & -4\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}-2 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =1\\,(2\\cdot (-4)-0\\cdot 0)\\,-\\,(-3)\\,((-2)\\cdot (-4)-0\\cdot 2)\\,+\\,0\\,((-2)\\cdot 0-2\\cdot 2) \\\\  & =1\\,(-8)\\,-\\,(-3)\\,(8)\\,+\\,0\\,(-4) \\\\  & =-8+24+0 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299587 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eadf82fd-7365-5e8c-a894-8da47cecc210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-61" :db/id #edb/ref 17592186298550}] :answer-field/correct {:answer/id #uuid "eadf82fd-7365-5e8c-a894-8da47cecc210" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-61" :db/id #edb/ref 17592186298550} :answer-field/id #uuid "d53ab5af-4297-5b00-921b-5e024f7f4a79" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299361}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffaceba3-4514-5d9f-9674-fd0da3b7e455" :question/math-academy-id "q-317319" :question/problem "Let $a=⟨2,1,3⟩$, $b=⟨1,4,0⟩$ and $c=⟨6,-1,2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & 1 & 3 \\\\ 1 & 4 & 0 \\\\ 6 & -1 & 2\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 0 \\\\ -1 & 2\\end{aligned}|\\,-\\,1\\cdot |\\begin{aligned}1 & 0 \\\\ 6 & 2\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}1 & 4 \\\\ 6 & -1\\end{aligned}| \\\\  & =2\\,(4\\cdot 2-0\\cdot (-1))\\,-\\,1\\,(1\\cdot 2-0\\cdot 6)\\,+\\,3\\,(1\\cdot (-1)-4\\cdot 6) \\\\  & =2\\,(8)\\,-\\,1\\,(2)\\,+\\,3\\,(-25) \\\\  & =16-2-75 \\\\  & =-61.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299590 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbb9271c-ec63-545e-82bd-3098f3d6d52f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298372}] :answer-field/correct {:answer/id #uuid "bbb9271c-ec63-545e-82bd-3098f3d6d52f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298372} :answer-field/id #uuid "ba217f0a-f30a-560e-b9be-570832c81a18" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299267}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86560436-5dd3-5177-80a9-3ddb91ccbf81" :question/math-academy-id "q-317325" :question/problem "Let $a=⟨-1,-2,3⟩$, $b=⟨4,-1,-2⟩$ and $c=⟨1,2,-3⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & -2 & 3 \\\\ 4 & -1 & -2 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}-1 & -2 \\\\ 2 & -3\\end{aligned}|\\,-\\,(-2)\\cdot |\\begin{aligned}4 & -2 \\\\ 1 & -3\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & -1 \\\\ 1 & 2\\end{aligned}| \\\\  & =(-1)\\,((-1)(-3)-(-2)\\cdot 2)\\,-\\,(-2)\\,(4\\cdot (-3)-(-2)\\cdot 1)\\,+\\,3\\,(4\\cdot 2-(-1)\\cdot 1) \\\\  & =(-1)\\,(7)\\,-\\,(-2)\\,(-10)\\,+\\,3\\,(9) \\\\  & =-7-20+27 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436862 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436831}] :answer-field/correct {:answer/id #uuid "4d1ac6eb-e3c3-5371-80e6-24c3f54f1da5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186436831} :answer-field/id #uuid "9a5b05a0-2b4a-5a26-9708-cfdb631cd43b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186436852}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e30f2d7c-8431-5cce-a8b2-50fb65874116" :question/math-academy-id "q-317333" :question/problem "Find $b\\cdot (a\\times c)$, if $5a\\cdot ((-4b)\\times (-3c))=-120.$\n\n$b\\cdot (a\\times c)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}5a\\cdot ((-4b)\\times (-3c)) & =-120 \\\\ 5\\cdot (-4)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =-120 \\\\ 60[a\\cdot (b\\times c)] & =-120 \\\\ a\\cdot (b\\times c) & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\nb\\cdot (a\\times c)=2.\n$$"}] [{:db/id #edb/ref 17592186436857 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f97420-5edb-586f-ab7a-66299006cada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186436828}] :answer-field/correct {:answer/id #uuid "21f97420-5edb-586f-ab7a-66299006cada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186436828} :answer-field/id #uuid "c02ae549-228a-54f0-a3ff-7af356d2a5aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186436854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26ec4cd9-8af6-5de8-b3cc-526d00b07bfc" :question/math-academy-id "q-317344" :question/problem "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨7,-2,3⟩$ and $a=⟨1,4,2⟩.$\n\n$c\\cdot (a\\times b)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,4,2⟩\\cdot ⟨7,-2,3⟩ \\\\  & =1\\cdot 7+4\\cdot (-2)+2\\cdot 3 \\\\  & =7-8+6 \\\\  & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-5\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c37b847b-0603-5e0f-8973-9dd05a27d3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186436839}] :answer-field/correct {:answer/id #uuid "c37b847b-0603-5e0f-8973-9dd05a27d3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186436839} :answer-field/id #uuid "56dee8e9-07f4-5b22-acca-8f6df3bf286f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186436849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "661d9816-4244-5782-9d68-b93f1424eb3e" :question/math-academy-id "q-317348" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨-2,5,4⟩$ and $a=⟨-1,3,2⟩.$\n\n$c\\cdot (b\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,3,2⟩\\cdot ⟨-2,5,4⟩ \\\\  & =(-1)\\cdot (-2)+3\\cdot 5+2\\cdot 4 \\\\  & =2+15+8 \\\\  & =25.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186436859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186436824} {:answer/id #uuid "10a95030-65da-5159-a9c2-11449ebd9b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186436826} {:answer/id #uuid "159b7861-635b-50f0-91b9-d5cd93472fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186436827} {:answer/id #uuid "a770a7ff-df6f-5dec-bec7-267dbaa53948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186436837} {:answer/id #uuid "e3516f72-8edb-54cf-a1ba-115368557ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186436844}] :answer-field/correct {:answer/id #uuid "0ca56ef0-f2a8-56e7-a0f1-0c84b89b4f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186436824} :answer-field/id #uuid "827eac35-448a-5c6d-a1b3-05ca38d592f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77263833-2d61-5397-981f-0a043abf2225" :question/math-academy-id "q-73451" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-5,2,3⟩$ and $b\\times c=⟨1,-5,4⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-5,2,3⟩\\cdot ⟨1,-5,4⟩ \\\\  & =(-5)\\cdot 1+2\\cdot (-5)+3\\cdot 4 \\\\  & =-3.\\end{aligned}\n$$"}]}
