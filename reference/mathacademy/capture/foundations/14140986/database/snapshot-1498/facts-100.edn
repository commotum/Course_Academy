#{[17592186410422 #edb/ref 1068 #edb/ref 17592186410391 #edb/ref 17592186045417] [17592186410422 #edb/ref 1069 "q-128355" #edb/ref 17592186045417] [17592186410422 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186410422 #edb/ref 1071 "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨4,3,-5⟩$ and $a=⟨-2,8,2⟩.$" #edb/ref 17592186045417] [17592186410422 #edb/ref 1072 #uuid "35202296-3c02-529f-93c9-ab75d2fe58b2" #edb/ref 17592186045417] [17592186410422 #edb/ref 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,8,2⟩\\cdot ⟨4,3,-5⟩ \\\\  & =(-2)\\cdot 4+8\\cdot 3+2\\cdot (-5) \\\\  & =-8+24-10 \\\\  & =6.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-6\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419778 #edb/ref 1043 #edb/ref 17592186419788 #edb/ref 17592186045417] [17592186419778 #edb/ref 1043 #edb/ref 17592186419789 #edb/ref 17592186045417] [17592186419778 #edb/ref 1043 #edb/ref 17592186419790 #edb/ref 17592186045417] [17592186419778 #edb/ref 1043 #edb/ref 17592186419791 #edb/ref 17592186045417] [17592186419778 #edb/ref 1043 #edb/ref 17592186419792 #edb/ref 17592186045417] [17592186419778 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186419778 #edb/ref 1045 "The Scalar Triple Product" #edb/ref 17592186045417] [17592186419778 #edb/ref 1046 #edb/ref 17592186419792 #edb/ref 17592186045417] [17592186419778 #edb/ref 1048 #edb/ref 17592186046658 #edb/ref 17592186045417] [17592186419778 #edb/ref 1049 #edb/ref 17592186050356 #edb/ref 17592186045417] [17592186419778 #edb/ref 1053 #uuid "e3670cc4-3e0e-52dd-b203-84b0f2da8c90" #edb/ref 17592186045417] [17592186419779 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186419779 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186419779 #edb/ref 1083 #uuid "069