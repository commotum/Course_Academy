186436853 #edb/ref 1078 #edb/ref 17592186436829 #edb/ref 17592186045417] [17592186436853 #edb/ref 1079 #uuid "afdc93fa-0aca-5068-a46b-19029c20890d" #edb/ref 17592186045417] [17592186436854 #edb/ref 1075 #edb/ref 17592186436828 #edb/ref 17592186045417] [17592186436854 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186436854 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186436854 #edb/ref 1078 #edb/ref 17592186436828 #edb/ref 17592186045417] [17592186436854 #edb/ref 1079 #uuid "c02ae549-228a-54f0-a3ff-7af356d2a5aa" #edb/ref 17592186045417] [17592186436855 #edb/ref 1068 #edb/ref 17592186436848 #edb/ref 17592186045417] [17592186436855 #edb/ref 1069 "q-20067" #edb/ref 17592186045417] [17592186436855 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436855 #edb/ref 1071 "Find $b\\cdot (c\\times a)$, if $b\\times c=⟨2,-5,7⟩$ and $a=⟨8,-2,-4⟩.$" #edb/ref 17592186045417] [17592186436855 #edb/ref 1072 #uuid "0d6554d4-4442-5e1f-83e6-be1fca151acc" #edb/ref 17592186045417] [17592186436855 #edb/ref 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨8,-2,-4⟩\\cdot ⟨2,-5,7⟩ \\\\  & =8\\cdot 2+(-2)\\cdot (-5)+(-4)\\cdot 7 \\\\  & =16+10-28 \\\\  & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=2,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436856 #edb/ref 1068 #edb/ref 17592186436847 #edb/ref 17592186045417] [17592186436856 #edb/ref 1069 "q-128090" #edb/ref 17592186045417] [17592186436856 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436856 #edb/ref 1071 "Find $a\\cdot (b\\times c)$ given that $a=⟨-2,0,4⟩$ and $b\\times c=⟨7,-4,9⟩.$" #edb/ref 17592186045417] [17592186436856 #edb/ref 1072 #uuid "11bcd21b-33cd-5c67-b5f7-a5248fa0b15a" #edb/ref 17592186045417] [17592186436856 #edb/ref 1074 "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,0,4⟩\\cdot ⟨7,-4,9⟩ \\\\  & =(-2)\\cdot 7+0\\cdot (-4)+4\\cdot 9 \\\\  & =22.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436857 #edb/ref 1068 #edb/ref 17592186436854 #edb/ref 17592186045417] [17592186436857 #edb/ref 1069 "q-317344" #edb/ref 17592186045417] [17592186436857 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436857 #edb/ref 1071 "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨7,-2,3⟩$ and $a=⟨1,4,2⟩.$\n\n$c\\cdot (a\\times b)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436857 #edb/ref 1072 #uuid "26ec4cd9-8af6-5de8-b3cc-526d00b07bfc" #edb/ref 17592186045417] [17592186436857 #edb/ref 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,4,2⟩\\cdot ⟨7,-2,3⟩ \\\\  & =1\\cdot 7+4\\cdot (-2)+2\\cdot 3 \\\\  & =7-8+6 \\\\  & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-5\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436858 #edb/ref 1068 #edb/ref 17592186436849 #edb/ref 17592186045417] [17592186436858 #edb/ref 1069 "q-317348" #edb/ref 17592186045417] [17592186436858 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436858 #edb/ref 1071 "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨-2,5,4⟩$ and $a=⟨-1,3,2⟩.$\n\n$c\\cdot (b\\times a)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436858 #edb/ref 1072 #uuid "661d9816-4244-5782-9d68-b93f1424eb3e" #edb/ref 17592186045417] [17592186436858 #edb/ref 1074 "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,3,2⟩\\cdot ⟨-2,5,4⟩ \\\\  & =(-1)\\cdot (-2)+3\\cdot 5+2\\cdot 4 \\\\  & =2+15+8 \\\\  & =25.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-25.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436859 #edb/ref 1068 #edb/ref 17592186436850 #edb/ref 17592186045417] [17592186436859 #edb/ref 1069 "q-73451" #edb/ref 17592186045417] [17592186436859 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436859 #edb/ref 1071 "Find $a\\cdot (b\\times c)$ given that $a=⟨-5,2,3⟩$ and $b\\times c=⟨1,-5,4⟩.$" #edb/ref 17592186045417] [17592186436859 #edb/ref 1072 #uuid "77263833-2d61-5397-981f-0a043abf2225" #edb/ref 17592186045417] [17592186436859 #edb/ref 1074 "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-5,2,3⟩\\cdot ⟨1,-5,4⟩ \\\\  & =(-5)\\cdot 1+2\\cdot (-5)+3\\cdot 4 \\\\  & =-3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436860 #edb/ref 1068 #edb/ref 17592186436851 #edb/ref 17592186045417] [17592186436860 #edb/ref 1069 "q-128093" #edb/ref 17592186045417] [17592186436860 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436860 #edb/ref 1071 "Given that $a=⟨5,-8,-7⟩,$ $b=⟨-1,1,2⟩,$ and $c=⟨-3,1,0⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." #edb/ref 17592186045417] [17592186436860 #edb/ref 1072 #uuid "97c82ac3-b53e-55cf-b9b8-2b725636dcb8" #edb/ref 17592186045417] [17592186436860 #edb/ref 1074 "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 1 & 2 \\\\ -3 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ -3 & 0\\end{aligned}|j+|\\begin{aligned}-1 & 1 \\\\ -3 & 1\\end{aligned}|k \\\\  & =(1\\cdot 0-1\\cdot 2)i-(-1\\cdot 0-(-3)\\cdot 2)j+((-1)\\cdot 1-(-3)\\cdot 1)k \\\\  & =-2i-6j+2k \\\\  & =⟨-2,-6,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨5,-8,-7⟩\\cdot ⟨-2,-6,2⟩ \\\\  & =5\\cdot (-2)+(-8)\\cdot (-6)+(-7)\\cdot 2 \\\\  & =24.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436861 #edb/ref 1068 #edb/ref 17592186436853 #edb/ref 17592186045417] [17592186436861 #edb/ref 1069 "q-317306" #edb/ref 17592186045417] [17592186436861 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186436861 #edb/ref 1071 "Find $a\\cdot (b\\times c)$ given that $a=⟨2\\sqrt{2},\\,-1,\\,4⟩$ and $b\\times c=⟨-2\\sqrt{2},\\,3,\\,-5⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436861 #edb/ref 1072 #uuid "9c2e5f62-97b7-5f13-893d-335d40132469" #edb/ref 17592186045417] [17592186436861 #edb/ref 1074 "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2\\sqrt{2},\\,-1,\\,4⟩\\cdot ⟨-2\\sqrt{2},\\,3,\\,-5⟩ \\\\  & =(2\\sqrt{2})(-2\\sqrt{2})+(-1)(3)+(4)(-5) \\\\  & =-8-3-20 \\\\  & =-31.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186436862 #edb/ref 1068 #edb/ref 17592186436852 #edb/ref 17592186045417] [17592186436862 #edb/ref 1069 "q-317333" #edb/ref 17592186045417] [17592186436862 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186436862 #edb/ref 1071 "Find $b\\cdot (a\\times c)$, if $5a\\cdot ((-4b)\\times (-3c))=-120.$\n\n$b\\cdot (a\\times c)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186436862 #edb/ref 1072 #uuid "e30f2d7c-8431-5cce-a8b2-50fb65874116" #edb/ref 17592186045417] [17592186436862 #edb/ref 1074 "First, we factor out the constants and get\n\n$$\n\\begin{aligned}5a\\cdot ((-4b)\\times (-3c)) & =-120 \\\\ 5\\cdot (-4)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =-120 \\\\ 60[a\\cdot (b\\times c)] & =-120 \\\\ a\\cdot (b\\times c) & =-2.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\nb\\cdot (a\\times c)=2.\n$$" #edb/ref 17592186045417]}
