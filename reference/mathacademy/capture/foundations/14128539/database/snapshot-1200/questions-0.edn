#{[{:db/id #edb/ref 17592186161817 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162025 :knowledge-point/id #uuid "7be1caf7-728f-5c51-b3da-64f3f7ff6fa9" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable at a Single Point"}] :question/id #uuid "0e332257-0d6f-59e6-a2cd-8cc53dd50173" :question/math-academy-id "e-8491" :question/problem "The discrete random variable $X\\in \\mathbb Z$ can be approximated by the continuous random variable $Y$. By applying an appropriate continuity correction, $P(X = -1)$ can be approximated as $P(a\\leq Y \\leq b)$. Find the values of $a$ and $b$." :question/worked-solution "We construct an interval around $X=-1$ with a radius of $0.5{:}$\n\n![](images/e9/e92a0fb229125f6a9cd27c96629cd1851f3356ece0bca6aa77b8393f7a0dfd90.png)\n\nThis gives\n\n$$\nP(X =-1) \\mid \\approx P(-1 - 0.5 \\le Y \\le - 1 + 0.5); = P(-1.5 \\le Y \\le - 0.5)\n$$\n\nTherefore, $a=-1.5$ and $b=-0.5$."}] [{:db/id #edb/ref 17592186161818 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162026 :knowledge-point/id #uuid "2d41f010-e1b6-5da8-ab37-c584d84dd5b6" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Interval"}] :question/id #uuid "eb9d63bd-dfbb-5c37-bdd0-2dc0b9d5ac6b" :question/math-academy-id "e-8492" :question/problem "The discrete random variable $X\\in \\mathbb Z$ can be approximated by the continuous random variable $Y$. By applying an appropriate continuity correction, $P(-1 \\lt X \\lt 2)$ can be approximated as $P(a\\leq Y \\leq b)$. Find the values of $a$ and $b$." :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequalities using non-strict inequalities, as follows:\n\n$$\n\\begin{aligned}\nP(-1 < X < 2) &= P(0 \\le X \\le 1)\n\\end{aligned}\n$$\n\nThen, we extend the endpoints of the interval\n\n$$\n0 \\leq X \\leq 1\n$$\n\nby $0.5$. This gives\n\n$$\nP(0 \\le X \\le 1) \\mid \\approx P(0 - 0.5 \\le Y \\le 1 + 0.5); = P(-0.5 \\le Y \\le 1.5)\n$$\n\nTherefore, $a=-0.5$ and $b=1.5$.\n\n![](images/52/52e5ddb2af86cba41ad9b05001e6a8720b973492f4cf5239031b972c5bcf2afb.png)"}] [{:db/id #edb/ref 17592186161819 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186162027 :knowledge-point/id #uuid "5d691e3a-f9c5-5c9d-863c-533abdebb948" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Unbounded Interval"}] :question/id #uuid "a6430e40-7b8f-5d1b-a842-ec7cc6013abe" :question/math-academy-id "e-8493" :question/problem "The discrete random variable $X\\in \\mathbb Z$ can be approximated by the continuous random variable $Y$. By applying an appropriate continuity correction, $P(X > 5)$ can be approximated as $P(Y\\geq a)$. Find the value of $a$." :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequalities using non-strict inequalities, as follows:\n\n$$\nP(X > 5) =P(X \\geq 6)\n$$\n\nThen, we extend the endpoints of the interval\n\n$$\nX \\geq 6\n$$\n\nby $0.5$. This gives\n\n$$\nP(X \\ge 6) \\mid \\approx P(Y \\ge 6 - 0.5); = P(Y \\ge 5.5)\n$$\n\nTherefore, $a=5.5$.\n\n![](images/4b/4b6c945ad08ff50b4d306e1952947cb55d5a05899e91f254f3dde3edde9f6523.png)"}] [{:db/id #edb/ref 17592186162681 :knowledge-point/_questions [{:db/id #edb/ref 17592186162027 :knowledge-point/id #uuid "5d691e3a-f9c5-5c9d-863c-533abdebb948" :knowledge-point/title "Approximating a Probability Involving a Discrete Random Variable Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97867ffb-249b-5c3b-a238-86fc0ce91566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y \\ge 1)" :db/id #edb/ref 17592186161379} {:answer/id #uuid "e9f1005f-49ac-5399-a134-c63d740b1066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y \\ge 1.5)" :db/id #edb/ref 17592186161380} {:answer/id #uuid "0c9a4f02-3403-5a13-835f-009242a29939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y \\ge 3)" :db/id #edb/ref 17592186161381} {:answer/id #uuid "37111785-45f3-5b1e-924f-ebc31996cf3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y \\ge 2.5)" :db/id #edb/ref 17592186161382} {:answer/id #uuid "5db85b1d-d863-515a-a9e7-b4f10e21ddab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P(Y \\ge 2)" :db/id #edb/ref 17592186161383}] :answer-field/id #uuid "40e2eb0e-0056-5c43-91d4-bcc5cb8114b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161378}] :question/id #uuid "c07ac69b-b578-5bd0-b356-001df67e45a8" :question/math-academy-id "q-96138" :question/problem "The discrete random variable $X ∈ Z$ can be approximated by the continuous random variable $Y$. By applying an appropriate continuity correction, $P(X > 2)$ can be approximated as"}]}
