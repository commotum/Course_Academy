e Y\\le 10.5)" :db/ensure [:answer/validate]} {:db/id "answer-62b2ffe4-e2bc-55b7-9142-b927851f6559" :answer/id #uuid "62b2ffe4-e2bc-55b7-9142-b927851f6559" :answer/type :answer.type/math :answer/value "P(3.5\\le Y\\le 11.5)" :db/ensure [:answer/validate]} {:db/id "answer-df77e3cb-a46c-5c4c-90d1-7a2242e8fe18" :answer/id #uuid "df77e3cb-a46c-5c4c-90d1-7a2242e8fe18" :answer/type :answer.type/math :answer/value "P(3\\le Y\\le 12)" :db/ensure [:answer/validate]} {:db/id "answer-91c2b6df-1f62-55b3-84dd-69ad22009d28" :answer/id #uuid "91c2b6df-1f62-55b3-84dd-69ad22009d28" :answer/type :answer.type/math :answer/value "P(4.5\\le Y\\le 11.5)" :db/ensure [:answer/validate]} {:db/id "answer-7ec0215e-cf0e-52e8-b5d2-776ea0823a8d" :answer/id #uuid "7ec0215e-cf0e-52e8-b5d2-776ea0823a8d" :answer/type :answer.type/math :answer/value "P(4\\le Y\\le 11)" :db/ensure [:answer/validate]} {:db/id 17592186162681 :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X>2)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequality as follows:\n\n$$\nP(X>2)=P(X\\ge 3)\n$$\n\nThen, we extend the endpoints of the interval $X\\ge 3$ by $0.5:$\n\n$$\n\\begin{aligned}P(X\\ge 3) & ≈P(Y\\ge 3-0.5) \\\\  & =P(Y\\ge 2.5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161378 :answer-field/correct "answer-607ccc93-baa5-5679-a220-0d6b40910c40" :answer-field/choices ["answer-3027ed31-48ec-5bfe-a75a-cca3f101caf7" "answer-79cffcc3-81c2-5f0b-82bd-d4056a02af9c" "answer-2d156751-d57a-5d11-b57d-a25b41edf93d" "answer-607ccc93-baa5-5679-a220-0d6b40910c40" "answer-26f1787c-1530-51d1-a55f-5b4548e5e9af"] :db/ensure [:answer-field/validate]} {:db/id "answer-3027ed31-48ec-5bfe-a75a-cca3f101caf7" :answer/id #uuid "3027ed31-48ec-5bfe-a75a-cca3f101caf7" :answer/type :answer.type/math :answer/value "P(Y\\ge 1)" :db/ensure [:answer/validate]} {:db/id "answer-79cffcc3-81c2-5f0b-82bd-d4056a02af9c" :answer/id #uuid "79cffcc3-81c2-5f0b-82bd-d4056a02af9c" :answer/type :answer.type/math :answer/value "P(Y\\ge 1.5)" :db/ensure [:answer/validate]} {:db/id "answer-2d156751-d57a-5d11-b57d-a25b41edf93d" :answer/id #uuid "2d156751-d57a-5d11-b57d-a25b41edf93d" :answer/type :answer.type/math :answer/value "P(Y\\ge 2)" :db/ensure [:answer/validate]} {:db/id "answer-607ccc93-baa5-5679-a220-0d6b40910c40" :answer/id #uuid "607ccc93-baa5-5679-a220-0d6b40910c40" :answer/type :answer.type/math :answer/value "P(Y\\ge 2.5)" :db/ensure [:answer/validate]} {:db/id "answer-26f1787c-1530-51d1-a55f-5b4548e5e9af" :answer/id #uuid "26f1787c-1530-51d1-a55f-5b4548e5e9af" :answer/type :answer.type/math :answer/value "P(Y\\ge 3)" :db/ensure [:answer/validate]} {:db/id "question-c629c32e-40e8-52bc-a310-6147fcdaffe0" :question/id #uuid "c629c32e-40e8-52bc-a310-6147fcdaffe0" :question/math-academy-id "q-132239" :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X>19)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequality as follows:\n\n$$\nP(X>19)=P(X\\ge 20)\n$$\n\nThen, we extend the endpoints of the interval $X\\ge 20$ by $0.5:$\n\n$$\n\\begin{aligned}P(X\\ge 20) & ≈P(Y\\ge 20-0.5) \\\\  & =P(Y\\ge 19.5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-73d1dd19-48bc-5039-8b9f-a0f421fe1f55"] :db/ensure [:question/validate]} {:db/id "answer-field-73d1dd19-48bc-5039-8b9f-a0f421fe1f55" :answer-field/id #uuid "73d1dd19-48bc-5039-8b9f-a0f421fe1f55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f67fe3c-93b8-5874-a54f-f03725ff88da" :answer-field/choices ["answer-4dd1bf1e-51f4-5d01-a7e4-e41076598b66" "answer-162d5e12-0ad8-5ea1-80fb-a59cd473cd6d" "answer-4f67fe3c-93b8-5874-a54f-f03725ff88da" "answer-055ee122-3724-57f6-b149-fab95924d791" "answer-cb4152f7-38f1-5786-9cf0-b430e02fe302"] :db/ensure [:answer-field/validate]} {:db/id "answer-4dd1bf1e-51f4-5d01-a7e4-e41076598b66" :answer/id #uuid "4dd1bf1e-51f4-5d01-a7e4-e41076598b66" :answer/type :answer.type/math :answer/value "P(Y\\ge 18.5)" :db/ensure [:answer/validate]} {:db/id "answer-162d5e12-0ad8-5ea1-80fb-a59cd473cd6d" :answer/id #uuid "162d5e12-0ad8-5ea1-80fb-a59cd473cd6d" :answer/type :answer.type/math :answer/value "P(Y\\ge 19)" :db/ensure [:answer/validate]} {:db/id "answer-4f67fe3c-93b8-5874-a54f-f03725ff88da" :answer/id #uuid "4f67fe3c-93b8-5874-a54f-f03725ff88da" :answer/type :answer.type/math :answer/value "P(Y\\ge 19.5)" :db/ensure [:answer/validate]} {:db/id "answer-055ee122-3724-57f6-b149-fab95924d791" :answer/id #uuid "055ee122-3724-57f6-b149-fab95924d791" :answer/type :answer.type/math :answer/value "P(Y\\ge 20)" :db/ensure [:answer/validate]} {:db/id "answer-cb4152f7-38f1-5786-9cf0-b430e02fe302" :answer/id #uuid "cb4152f7-38f1-5786-9cf0-b430e02fe302" :answer/type :answer.type/math :answer/value "P(Y\\ge 20.5)" :db/ensure [:answer/validate]} {:db/id 17592186163245 :tutorial/content "We often want to approximate a discrete random variable $X$ by a continuous random variable $Y.$ To do this, we need to consider how to treat the values of $Y$ that lie between the discrete values of $X.$\n\nFirst, recall that if $X = 2$ *to the nearest integer*, then\n\n$$\n1.5\\leq X \\lt 2.5.\n$$\n\nNow consider the following scenario:\n\n- $X\\in\\big\\{\\ldots, 0,1,2, 3\\ldots\\big\\}$ is a *discrete* random variable with *integer* support\n\n- $Y\\in(-\\infty, \\infty)$ is a *continuous* random variable that we will use to approximate $X$\n\nTo approximate the probability\n\n$$\nP(X = 2)\n$$\n\nusing the random variable $Y,$ we need to calculate\n\n$$\nP( 1.5 \\leq Y \\lt 2.5).\n$$\n\nAlso, since $Y$ is continuous, this probability is equal to\n\n$$\nP( 1.5 \\leq Y \\leq 2.5).\n$$\n\nWe can think of the required values of $Y$ as lying within the interval contained within a circle of radius $0.5$ centered at $Y=2.$\n\n![](images/8a/8af3b4a73cdf37169e0841ce7ef9bbe31fefd171cdeacc33dcc8cedca0facfe8.png)\n\nAdjusting the values of a discrete random variable so that it can be approximated using a continuous random variable is called a **continuity correction.**" :db/ensure [:tutorial/validate]} {:db/id 17592186162160 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
