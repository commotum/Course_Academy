      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14217845/observations/step-q161932-1483848809c37b5e1ff5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14217845/observations/step-q161932-1483848809c37b5e1ff5.png",
