<mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>z</mi><mo>=</mo><mn>2</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>8</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>32</mn><mn>3</mn></mfrac></mstyle><mo>+</mo><mn>4</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
