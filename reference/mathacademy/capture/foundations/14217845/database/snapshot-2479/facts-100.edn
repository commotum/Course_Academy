db/ref 1077 "selection" #edb/ref 17592186045417] [17592186527892 #edb/ref 1078 #edb/ref 17592186527568 #edb/ref 17592186045417] [17592186527892 #edb/ref 1079 #uuid "d16be51a-dcbd-5540-95d0-1d9d605bbc50" #edb/ref 17592186045417] [17592186527894 #edb/ref 1075 #edb/ref 17592186527376 #edb/ref 17592186045417] [17592186527894 #edb/ref 1075 #edb/ref 17592186527409 #edb/ref 17592186045417] [17592186527894 #edb/ref 1075 #edb/ref 17592186527599 #edb/ref 17592186045417] [17592186527894 #edb/ref 1075 #edb/ref 17592186527615 #edb/ref 17592186045417] [17592186527894 #edb/ref 1075 #edb/ref 17592186527675 #edb/ref 17592186045417] [17592186527894 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527894 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527894 #edb/ref 1078 #edb/ref 17592186527675 #edb/ref 17592186045417] [17592186527894 #edb/ref 1079 #uuid "d83fd660-d05c-552a-9c9c-8182ba76ceb4" #edb/ref 17592186045417] [17592186527911 #edb/ref 1068 #edb/ref 17592186527805 #edb/ref 17592186045417] [17592186527911 #edb/ref 1069 "q-161666" #edb/ref 17592186045417] [17592186527911 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527911 #edb/ref 1071 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{x}2x\\,\\text{d}y]\\text{d}A\n$$\n\ngiven that the region $D$ in the $xz$-plane is given by\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,0\\le z\\le 2-x\\}.\n$$" #edb/ref 17592186045417] [17592186527911 #edb/ref 1072 #uuid "0597a6d4-1752-5cad-a458-a8b2a80e68a1" #edb/ref 17592186045417] [17592186527911 #edb/ref 1074 "First, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{x}2x\\,\\text{d}y]\\text{d}A & ={∬}_{D}2x[y]_{y=0}^{y=x}\\,\\text{d}A \\\\  & ={∬}_{D}2{x}^{2}\\,\\text{d}A\\end{aligned}\n$$\n\nNotice that $D$ is a type I region in the $xz$-plane.\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $z$ and then with respect to $x:$\n\n$$\n\\begin{aligned}{∬}_{D}2{x}^{2}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}2{x}^{2}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}[{\\int }_{0}^{2-x}\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}{[z]}_{z=0}^{z=2-x}\\text{d}x \\\\  & ={\\int }_{0}^{2}2{x}^{2}(2-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(4{x}^{2}-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{4}{3}{x}^{3}-\\frac{1}{2}{x}^{4}]}_{x=0}^{x=2} \\\\  & =(\\frac{32}{3}-8)-0 \\\\  & =\\frac{8}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527914 #edb/ref 1068 #edb/ref 17592186527862 #edb/ref 17592186045417] [17592186527914 #edb/ref 1069 "q-161764" #edb/ref 17592186045417] [17592186527914 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527914 #edb/ref 1071 "Evaluate the triple integral \n\n$$\n{∭}_{R}4xy\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,x\\le y\\le \\sqrt{1-z}\\},\n$$\n\nand $D$ is a finite region in $xz$-plane enclosed between the $x$-axis, the $z$-axis, and the curve $z=1-{x}^{2},$ in the first quadrant." #edb/ref 17592186045417] [17592186527914 #edb/ref 1072 #uuid "0bcb5cdc-84fc-59d4-a070-2f4375bf7e4a" #edb/ref 17592186045417] [17592186527914 #edb/ref 1074 "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}4xy\\,\\text{d}V={∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA & ={∬}_{D}2x[{y}^{2}]_{y=x}^{y=\\sqrt{1-z}}\\,dA \\\\  & ={∬}_{D}2x(\\,(1-z)-{x}^{2})\\,dA \\\\  & ={∬}_{D}2x(1-z)-2{x}^{3}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate this double integral over the region $D$ in the $xz$-plane shown below.\n\n![](images/95/95a2b4e28dbfae5ce447b3b975b2f74bf04883441217f42a24636970948402a0.png)\n\n  \n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}2x(1-z)-2{x}^{3}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-z}}2x(1-z)-2{x}^{3}\\,dx\\,dz \\\\  & ={\\int }_{0}^{1}(1-z)[{\\int }_{0}^{\\sqrt{1-z}}2x\\,dx]dz+{\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-z}}-2{x}^{3}\\,dx]dz \\\\  & ={\\int }_{0}^{1}(1-z)[{x}^{2}]_{x=0}^{x=\\sqrt{1-z}}dz+{\\int }_{0}^{1}{[-\\frac{{x}^{4}}{2}]}_{x=0}^{x=\\sqrt{1-z}}dz \\\\  & ={\\int }_{0}^{1}(1-z)^{2}\\,dz-\\frac{1}{2}{\\int }_{0}^{1}(1-z)^{2}\\,dz \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}(1-z)^{2}\\,dz \\\\  & =\\frac{1}{6}{[-(1-z)^{3}]}_{z=0}^{z=1} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527916 #edb/ref 1068 #edb/ref 17592186527823 #edb/ref 17592186045417] [17592186527916 #edb/ref 1069 "q-161932" #edb/ref 17592186045417] [17592186527916 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527916 #edb/ref 1071 "![](images/6f/6f4bf1fe2f1a49f84b56702c4a83272c2f927ea4774eb677f43e525bf6cfb1f7.png)\n\nEvaluate the triple integral \n${∭}_{R}8x\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" #edb/ref 17592186045417] [17592186527916 #edb/ref 1072 #uuid "0d6e2493-0d92-5bdf-8874-580184f51513" #edb/ref 17592186045417] [17592186527916 #edb/ref 1074 "![](images/71/71f3fd0cbbde8adeca71688d6b53e2cd4cdf72076be3efa770cfebb8c10ffb76.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3-\\frac{3x}{4}-\\frac{z}{2}\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/cd/cd84968e9e5300a18d087ba566202aba2b7166818a590cca03eac90d4f3f7a89.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3,\\,\\,0\\le y\\le 3-\\frac{3x}{4}-\\frac{z}{2}\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}8x\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{3-3x/4-z/2}8x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{3-3x/4-z/2}8x\\,dy\\,dz\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{3}[{\\int }_{0}^{3-3x/4-z/2}8x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}8x[y]_{y=0}^{y=3-3x/4-z/2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}8x(3-\\frac{3x}{4}-\\frac{z}{2})\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{3}(24x-6{x}^{2}-4xz)\\,dz]dx \\\\  & ={\\int }_{0}^{1}{[24xz-6{x}^{2}z-2x{z}^{2}]}_{z=0}^{z=3}\\,dx \\\\  & ={\\int }_{0}^{1}(72x-18{x}^{2}-18x)\\,dx \\\\  & ={\\int }_{0}^{1}(54x-18{x}^{2})\\,dx\\end{aligned}\n$$\n\n \n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(54x-18{x}^{2})\\,dx & ={[27{x}^{2}-6{x}^{3}]}_{x=0}^{x=1} \\\\  & =(27-6)-0 \\\\  & =21.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527918 #edb/ref 1068 #edb/ref 17592186527842 #edb/ref 17592186045417] [17592186527918 #edb/ref 1069 "q-161725" #edb/ref 17592186045417] [17592186527918 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186527918 #edb/ref 1071 "$$\n{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA,\n$$\n\nEvaluate the repeated integral above given that $D$ is a region in the $xz$-plane bounded by the lines $z=0,$ $x=0,$ and the curve $z+{x}^{2}=1.$" #edb/ref 17592186045417] [17592186527918 #edb/ref 1072 #uuid "0f4e6580-868c-593b-ba50-63aa6d6e6e42" #edb/ref 17592186045417] [17592186527918 #edb/ref 1074 "First, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{\\sqrt{1-z}}4xy\\,dy]dA & ={∬}_{D}2x[{y}^{2}]_{y=x}^{y=\\sqrt{1-z}}\\,dA \\\\  & ={∬}_{D}2x(1-z-{x}^{2})\\,dA \\\\  & ={∬}_{D}(\\,2x(1-z)-2{x}^{3}\\,)\\,dA\\end{aligned}\n$$\n\nNow, to calculate this double integral, we plot $D$ as a type I plane region in the $xz$-plane.\n\n![](images/80/8079d8f9796c1f863a515ced0091c1f420318be1c4bfe0eb2da641bddfa426ce.png)\n\n \n\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $z$ and then with respect to $x:$\n\n$$\n\\begin{aligned}{∬}_{D}(\\,2x(1-z)-2{x}^{3}\\,)\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}(\\,2x(1-z)-2{x}^{3}\\,)\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(x[-(1-z)^{2}]_{z=0}^{z=1-{x}^{2}}-2{x}^{3}[z]_{z=0}^{z=1-{x}^{2}}\\,)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-{x}^{5}+x-2{x}^{3}+2{x}^{5})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{5}+x-2{x}^{3})\\,\\text{d}x \\\\  & ={[\\frac{1}{6}{x}^{6}+\\frac{1}{2}{x}^{2}-\\frac{1}{2}{x}^{4}]}_{x=0}^{x=1} \\\\  & =(\\frac{1}{6}+\\frac{1}{2}-\\frac{1}{2})-0 \\\\  & =\\frac{1}{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527928 #edb/ref 1068 #edb/ref 17592186527832 #edb/ref 17592186045417] [17592186527928 #edb/ref 1069 "q-163715" #edb/ref 17592186045417] [17592186527928 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186527928 #edb/ref 1071 "![](images/5b/5b7552bbde56a68bfca44adb0501a4a4a8ae0a1105d3dc9039d05bfb6fd405c9.png)\n\nGiven that $R$ is the type III region shown above, \n${∭}_{R}2y\\,\\text{d}V=$" #edb/ref 17592186045417] [17592186527928 #edb/ref 1072 #uuid "3242c4d8-39d7-5463-b665-91b0cfa5917f" #edb/ref 17592186045417] [17592186527928 #edb/ref 1074 "For a type III region $R$ with projection $D$ onto the $xz$-plane, the triple integral of a continuous function $f(x,y,z)$ over $R$ is given by\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\text{d}A.\n$$\n\nWe consider the region $R$ as a type III region enclosed between the back surface $y={u}_{1}(x,z)=1$ and the front surface $y={u}_{2}(x,z)=2.$\n\n![](images/2f/2f1112a1fa4e540ce8ef2d1337383a2adcb378ba519cfb9c49a4521e5bc1b02f.png)\n\nSo, the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,1\\le y\\le 2\\}.\n$$\n\nNow, we consider the projection $D$ as a type II *plane* region in the $xz$-plane with the left curve\n\n$$\nx={z}^{2}.\n$$\n\n![](images/2d/2dcbae12ed3351892c63117f86bab7ffe6e1818b7a16666b42c2efdcc6bd787f.png)\n\nHence, $D=\\{(x,z)\\,:\\,0\\le z\\le 1,\\,{z}^{2}\\le x\\le 1\\}.$\n\nTherefore, we write the triple integral as follows:\n\n$$\n\\begin{aligned}{∭}_{R}2y\\,\\text{d}V & ={∬}_{D}[{\\int }_{1}^{2}2y\\,\\text{d}y]\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{z}^{2}}^{1}[{\\int }_{1}^{2}2y\\,\\text{d}y]\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{\\int }_{{z}^{2}}^{1}[{y}^{2}]_{y=1}^{y=2}\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{\\int }_{{z}^{2}}^{1}3\\,\\text{d}x\\,\\text{d}z\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527935 #edb/ref 1068 #edb/ref 17592186527822 #edb/ref 17592186045417] [17592186527935 #edb/ref 1069 "q-161891" #edb/ref 17592186045417] [17592186527935 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527935 #edb/ref 1071 "![](images/3c/3cba44923f4f583cf6e01ac87cdd6e5ca73a75993eef8322cd01bf44416f84f4.png)\n\nEvaluate the triple integral \n${∭}_{R}4x\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" #edb/ref 17592186045417] [17592186527935 #edb/ref 1072 #uuid "43d7c496-4713-50a7-87bb-4a90921bae35" #edb/ref 17592186045417] [17592186527935 #edb/ref 1074 "![](images/f1/f112dd83a8cbb7563979dc170db23db7e178ba1762aca23fd4073c50e1c7a343.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 5-x-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/71/71974fddc8e0e0b6a12fc6a248c15eea08c9f6b8a0823d50aede8aadc31a41fa.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 5-x-z\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}4x\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{5-x-z}4x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{5-x-z}4x\\,dy\\,dz\\,dx & ={\\int }_{0}^{2}{\\int }_{0}^{2}[{\\int }_{0}^{5-x-z}4x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}4x[y]_{y=0}^{y=5-x-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}4x(5-x-z)\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz\\,dx & ={\\int }_{0}^{2}[{\\int }_{0}^{2}(20x-4{x}^{2}-4xz)\\,dz]dx \\\\  & ={\\int }_{0}^{2}{[20xz-4{x}^{2}z-2x{z}^{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{3}(32x-8{x}^{2})\\,dx\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(32x-8{x}^{2})\\,dx & ={[16{x}^{2}-\\frac{8{x}^{3}}{3}]}_{x=0}^{x=2} \\\\  & =(64-\\frac{64}{3})-0 \\\\  & =\\frac{128}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527957 #edb/ref 1068 #edb/ref 17592186527826 #edb/ref 17592186045417] [17592186527957 #edb/ref 1069 "q-161772" #edb/ref 17592186045417] [17592186527957 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186527957 #edb/ref 1071 "Evaluate the triple integral\n\n$$\n{∭}_{R}xyz\\,\\text{d}V\n$$\n\nwhere $R$ is the type III region given by \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le z\\le 2,\\,0\\le x\\le \\sqrt{4-2z},\\,0\\le y\\le x\\}.\n$$" #edb/ref 17592186045417] [17592186527957 #edb/ref 1072 #uuid "7a83145c-370c-5913-b3c6-439072b6c354" #edb/ref 17592186045417] [17592186527957 #edb/ref 1074 "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}xyz\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{\\int }_{0}^{x}xyz\\,dy\\,dx\\,dz.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{\\int }_{0}^{x}xyz\\,dy\\,dx\\,dz & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}[{\\int }_{0}^{x}xyz\\,dy]dx\\,dz \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}xz{[\\frac{{y}^{2}}{2}]}_{y=0}^{y=x}dx\\,dz \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}xz(\\frac{{x}^{2}}{2})\\,dx\\,dz \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{x}^{3}z\\,dx\\,dz\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $x$, treating $z$ as a constant: \n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2x}}{x}^{3}z\\,dx\\,dz & =\\frac{1}{2}{\\int }_{0}^{2}z[{\\int }_{0}^{\\sqrt{4-2z}}{x}^{3}\\,\\text{d}x]\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}z{[\\frac{{x}^{4}}{4}]}_{x=0}^{x=\\sqrt{4-2z}}\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}\\frac{1}{4}(4-2z)^{2}z\\,\\text{d}z \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}4z-4{z}^{2}+{z}^{3}\\,\\text{d}z\\end{aligned}\n$$\n\nFinally, we integrate with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{2}4z-4{z}^{2}+{z}^{3}\\,\\text{d}z & =\\frac{1}{2}{[2{z}^{2}-\\frac{4}{3}{z}^{3}+\\frac{1}{4}{z}^{4}]}_{z=0}^{z=2} \\\\  & =\\frac{1}{2}(8-\\frac{32}{3}+4)-0 \\\\  & =\\frac{2}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527962 #edb/ref 1068 #edb/ref 17592186527806 #edb/ref 17592186045417] [17592186527962 #edb/ref 1069 "q-161689" #edb/ref 17592186045417] [17592186527962 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527962 #edb/ref 1071 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{4-{x}^{2}}}5yz\\,\\text{d}y]\\text{d}A\n$$\n\ngiven that the region $D$ in the $xz$-plane is given by\n\n$$\nD=\\{(x,z)\\,:\\,0\\le z\\le 2,\\,0\\le x\\le 2-z\\}.\n$$" #edb/ref 17592186045417] [17592186527962 #edb/ref 1072 #uuid "7dfdc43a-549b-5350-87ba-ec6dde24e325" #edb/ref 17592186045417] [17592186527962 #edb/ref 1074 "First, we evaluate the inner integral with respect to $y,$ treating $z$ and $x$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{4-{x}^{2}}}5yz\\,\\text{d}y]\\text{d}A & ={∬}_{D}5z{[\\frac{{y}^{2}}{2}]}_{y=0}^{y=\\sqrt{4-{x}^{2}}}\\,\\text{d}A \\\\  & =\\frac{5}{2}{∬}_{D}z(4-{x}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNotice that $D$ is a type II region in the $xz$-plane.\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $x$ and then with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{5}{2}{∬}_{D}z(4-{x}^{2})\\,\\text{d}A & =\\frac{5}{2}{\\int }_{0}^{2}{\\int }_{0}^{2-z}z(4-{x}^{2})\\,\\text{d}x\\,\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z[{\\int }_{0}^{2-z}(4-{x}^{2})\\,\\text{d}x]\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z{[(4x-\\frac{{x}^{3}}{3})]}_{x=0}^{x=2-z}\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}z(4(2-z)-\\frac{(2-z)^{3}}{3})\\,\\text{d}z \\\\  & =\\frac{5}{2}{\\int }_{0}^{2}(\\frac{16z}{3}-2{z}^{3}+\\frac{{z}^{4}}{3})\\,\\text{d}z \\\\  & =\\frac{5}{2}{[\\frac{8{z}^{2}}{3}-\\frac{{z}^{4}}{2}+\\frac{{z}^{5}}{15}]}_{z=0}^{z=2} \\\\  & =\\frac{5}{2}[\\frac{32}{3}-8+\\frac{32}{15}] \\\\  & =12\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527974 #edb/ref 1068 #edb/ref 17592186527886 #edb/ref 17592186045417] [17592186527974 #edb/ref 1069 "q-163509" #edb/ref 17592186045417] [17592186527974 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186527974 #edb/ref 1071 "![](images/33/335bf5e4e2a4ee9d0286eadb968e0e82c6afb18d47cd5258d6d1b6cee3d5c5a6.png)\n\nGiven that $R$ is the type III region shown above, \n${∭}_{R}xz\\,\\text{d}V=$" #edb/ref 17592186045417] [17592186527974 #edb/ref 1072 #uuid "9c0ba772-2d81-508b-bca4-4e2298a7113a" #edb/ref 17592186045417] [17592186527974 #edb/ref 1074 "For a type III region $R$ with projection $D$ onto the $xz$-plane, the triple integral of a continuous function $f(x,y,z)$ over $R$ is given by\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\text{d}A.\n$$\n\nWe consider the region $R$ as a type III region enclosed between the back surface $y={u}_{1}(x,z)=1$ and the front surface $y={u}_{2}(x,z)=3.$\n\n![](images/b1/b176bcf502a0801eae2bf470dfe4bf92852a34b06675fd74be78b30ccb4f6469.png)\n\nSo, the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,1\\le y\\le 3\\}.\n$$\n\nNow, we consider the projection $D$ as a type I *plane* region in the $xz$-plane with the upper curve\n\n$$\nz=1-{x}^{2}.\n$$\n\n![](images/eb/eb054b5f1567aa2c56842d79133fbbefc41a8b40730c688381d88e3ef06ccab7.png)\n\nHence, $D=\\{(x,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le 1-{x}^{2}\\}.$\n\nTherefore, we write the triple integral as follows:\n\n$$\n\\begin{aligned}{∭}_{R}xz\\,\\text{d}V & ={∬}_{D}[{\\int }_{1}^{3}xz\\,\\text{d}y]\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}[{\\int }_{1}^{3}xz\\,\\text{d}y]\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}xz[y]_{y=1}^{y=3}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}2xz\\,\\text{d}z\\,\\text{d}x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527996 #edb/ref 1068 #edb/ref 17592186527892 #edb/ref 17592186045417] [17592186527996 #edb/ref 1069 "q-161723" #edb/ref 17592186045417] [17592186527996 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186527996 #edb/ref 1071 "Consider the type III region $R,$ given by\n\n$$\nS=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,{x}^{2}\\le y\\le 2+{z}^{2}\\},\n$$\n\nwhere $D$ is some finite region in the $xz$-plane. Then,\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V=\n$$" #edb/ref 17592186045417] [17592186527996 #edb/ref 1072 #uuid "d33bfb77-09ea-5195-a418-173b3296a490" #edb/ref 17592186045417] [17592186527996 #edb/ref 1074 "A type III region in three-dimensional space can be written as\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,{u}_{1}(x,z)\\le y\\le {u}_{2}(x,z)\\}.\n$$\n\nA typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/06/0603bed12c6af74e46544d8bebc52362aed95a9a5ad7418ea4faaf228f3b5241.png)\n\n \n\nIf $R$ is a type III region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,z)={x}^{2},\\,{u}_{2}(x,z)=2+{z}^{2}.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{x}^{2}}^{2+{z}^{2}}f(x,y,z)\\,dy]dA.\n$$" #edb/ref 17592186045417] [17592186528004 #edb/ref 1068 #edb/ref 17592186527808 #edb/ref 17592186045417] [17592186528004 #edb/ref 1069 "q-161724" #edb/ref 17592186045417] [17592186528004 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186528004 #edb/ref 1071 "Consider the type III region $R,$ given by\n\n$$\nS=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,{x}^{2}-2\\le y\\le {x}^{2}+{z}^{2}\\},\n$$\n\nwhere $D$ is some finite region in the $xz$-plane. Then,\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V=\n$$" #edb/ref 17592186045417] [17592186528004 #edb/ref 1072 #uuid "e1798463-dc83-5fa2-a428-d476acd2c869" #edb/ref 17592186045417] [17592186528004 #edb/ref 1074 "A type III region in three-dimensional space can be written as\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,{u}_{1}(x,z)\\le y\\le {u}_{2}(x,z)\\}.\n$$\n\nA typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/06/0603bed12c6af74e46544d8bebc52362aed95a9a5ad7418ea4faaf228f3b5241.png)\n\n \n\nIf $R$ is a type III region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,z)={x}^{2}-2,\\,{u}_{2}(x,z)={x}^{2}+{z}^{2}.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{x}^{2}-2}^{{x}^{2}+{z}^{2}}f(x,y,z)\\,dy]dA.\n$$" #edb/ref 17592186045417] [17592186528006 #edb/ref 1068 #edb/ref 17592186527846 #edb/ref 17592186045417] [17592186528006 #edb/ref 1069 "q-161738" #edb/ref 17592186045417] [17592186528006 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186528006 #edb/ref 1071 "Evaluate the triple integral\n\n$$\n{∭}_{R}3x\\,\\text{d}V\n$$\n\nwhere $R$ is the type III region given by \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le x,\\,0\\le z\\le 2-x\\}.\n$$" #edb/ref 17592186045417] [17592186528006 #edb/ref 1072 #uuid "e4e7d822-5d73-50ee-b641-1c594f9a070a" #edb/ref 17592186045417] [17592186528006 #edb/ref 1074 "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}3x\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{2-x}{\\int }_{0}^{x}3x\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2-x}{\\int }_{0}^{x}3x\\,dy\\,dz\\,dx & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}[{\\int }_{0}^{x}3x\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3x[y]_{y=0}^{y=x}dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3x(x-0)\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-x}3{x}^{2}\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{2-x}3{x}^{2}\\,dz\\,dx & ={\\int }_{0}^{2}3{x}^{2}[{\\int }_{0}^{2-x}\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{2}3{x}^{2}{[z]}_{z=0}^{z=2-x}\\text{d}x \\\\  & ={\\int }_{0}^{2}3{x}^{2}(2-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(6{x}^{2}-3{x}^{3})\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(6{x}^{2}-3{x}^{3})\\,\\text{d}x & ={[2{x}^{3}-\\frac{3}{4}{x}^{4}]}_{x=0}^{x=2} \\\\  & =(16-12)-0 \\\\  & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186528008 #edb/ref 1068 #edb/ref 17592186527894 #edb/ref 17592186045417] [17592186528008 #edb/ref 1069 "q-161745" #edb/ref 17592186045417] [17592186528008 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186528008 #edb/ref 1071 "$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{∗}{\\int }_{∗}^{∗}{\\int }_{∗}^{b}f(x,y,z)\\,dy\\,dz\\,dx\n$$\n\nThe triple integral above is defined over the type III region given by\n\n$$\nS=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,-2\\le z\\le {x}^{2}+2,\\,-2-z\\le y\\le 2+x+z\\}.\n$$\n\nWhat is the value of $a-b?$" #edb/ref 17592186045417] [17592186528008 #edb/ref 1072 #uuid "ea162333-68ea-5f39-92a3-425dd5b76bfd" #edb/ref 17592186045417] [17592186528008 #edb/ref 1074 "A type III region in three-dimensional space can be written as\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,{u}_{1}(x,z)\\le y\\le {u}_{2}(x,z)\\}.\n$$\n\nA typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/06/0603bed12c6af74e46544d8bebc52362aed95a9a5ad7418ea4faaf228f3b5241.png)\n\n \n\nIf $R$ is a type III region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,z)=-2-z,\\,{u}_{2}(x,z)=2+x+z.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{-2-z}^{2+x+z}f(x,y,z)\\,dy]dA.\n$$\n\n \n\nNow, the region $D$ is given by\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 1,\\,-2\\le z\\le {x}^{2}+2\\}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{-2-z}^{2+x+z}f(x,y,z)\\,dy]dA & ={\\int }_{0}^{1}{\\int }_{-2}^{{x}^{2}+2}[{\\int }_{-2-z}^{2+x+z}f(x,y,z)\\,dy]dz\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{-2}^{{x}^{2}+2}{\\int }_{-2-z}^{2+x+z}f(x,y,z)\\,dy\\,dz\\,dx.\\end{aligned}\n$$\n\nFinally, \n\n$$\na-b=(0)-(2+x+z)=-2-x-z.\n$$" #edb/ref 17592186045417]}
