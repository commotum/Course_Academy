db/ref 17592186279920 #edb/ref 17592186045417] [17592186280919 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280919 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280919 #edb/ref 1078 #edb/ref 17592186279920 #edb/ref 17592186045417] [17592186280919 #edb/ref 1079 #uuid "2eb2ba9a-f03f-55df-8fb0-cec85d841b52" #edb/ref 17592186045417] [17592186280972 #edb/ref 1075 #edb/ref 17592186278715 #edb/ref 17592186045417] [17592186280972 #edb/ref 1075 #edb/ref 17592186279139 #edb/ref 17592186045417] [17592186280972 #edb/ref 1075 #edb/ref 17592186279456 #edb/ref 17592186045417] [17592186280972 #edb/ref 1075 #edb/ref 17592186280333 #edb/ref 17592186045417] [17592186280972 #edb/ref 1075 #edb/ref 17592186280384 #edb/ref 17592186045417] [17592186280972 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280972 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280972 #edb/ref 1078 #edb/ref 17592186278715 #edb/ref 17592186045417] [17592186280972 #edb/ref 1079 #uuid "544d160b-e29b-59aa-9938-64c90c8cfe69" #edb/ref 17592186045417] [17592186281060 #edb/ref 1075 #edb/ref 17592186278995 #edb/ref 17592186045417] [17592186281060 #edb/ref 1075 #edb/ref 17592186279621 #edb/ref 17592186045417] [17592186281060 #edb/ref 1075 #edb/ref 17592186279849 #edb/ref 17592186045417] [17592186281060 #edb/ref 1075 #edb/ref 17592186280061 #edb/ref 17592186045417] [17592186281060 #edb/ref 1075 #edb/ref 17592186280451 #edb/ref 17592186045417] [17592186281060 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281060 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281060 #edb/ref 1078 #edb/ref 17592186280061 #edb/ref 17592186045417] [17592186281060 #edb/ref 1079 #uuid "7c28af51-d8e7-53ee-b355-cdf9be35b210" #edb/ref 17592186045417] [17592186281102 #edb/ref 1075 #edb/ref 17592186279010 #edb/ref 17592186045417] [17592186281102 #edb/ref 1075 #edb/ref 17592186279514 #edb/ref 17592186045417] [17592186281102 #edb/ref 1075 #edb/ref 17592186279740 #edb/ref 17592186045417] [17592186281102 #edb/ref 1075 #edb/ref 17592186280358 #edb/ref 17592186045417] [17592186281102 #edb/ref 1075 #edb/ref 17592186280583 #edb/ref 17592186045417] [17592186281102 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281102 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281102 #edb/ref 1078 #edb/ref 17592186279010 #edb/ref 17592186045417] [17592186281102 #edb/ref 1079 #uuid "9575c3e7-857c-5f96-ad84-b47a94df34c7" #edb/ref 17592186045417] [17592186281136 #edb/ref 1075 #edb/ref 17592186279174 #edb/ref 17592186045417] [17592186281136 #edb/ref 1075 #edb/ref 17592186279646 #edb/ref 17592186045417] [17592186281136 #edb/ref 1075 #edb/ref 17592186280341 #edb/ref 17592186045417] [17592186281136 #edb/ref 1075 #edb/ref 17592186280465 #edb/ref 17592186045417] [17592186281136 #edb/ref 1075 #edb/ref 17592186280783 #edb/ref 17592186045417] [17592186281136 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281136 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281136 #edb/ref 1078 #edb/ref 17592186279174 #edb/ref 17592186045417] [17592186281136 #edb/ref 1079 #uuid "af73b320-686f-5899-8f90-0fd38634d25e" #edb/ref 17592186045417] [17592186281307 #edb/ref 1068 #edb/ref 17592186281102 #edb/ref 17592186045417] [17592186281307 #edb/ref 1069 "q-161722" #edb/ref 17592186045417] [17592186281307 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281307 #edb/ref 1071 "Consider the type III region $R,$ given by\n\n$$\nS={(x,y,z)\\,:\\,(x,z)\\in D,\\,-z\\le y\\le {x}^{2}+z},\n$$\n\nwhere $D$ is some finite region in the $xz$-plane. Then,\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V=\n$$" #edb/ref 17592186045417] [17592186281307 #edb/ref 1072 #uuid "2f13673d-47ba-5a25-8690-9d3a570aad64" #edb/ref 17592186045417] [17592186281307 #edb/ref 1074 "A type III region in three-dimensional space can be written as\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,{u}_{1}(x,z)\\le y\\le {u}_{2}(x,z)}.\n$$\n\nA typical three-dimensional type III region can be visualized schematically, as shown below.\n\n![](images/06/0603bed12c6af74e46544d8bebc52362aed95a9a5ad7418ea4faaf228f3b5241.png)\n\n \n\nIf $R$ is a type III region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,z)=-z,\\,{u}_{2}(x,z)={x}^{2}+z.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{S}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{-z}^{{x}^{2}+z}f(x,y,z)\\,dy]dA.\n$$" #edb/ref 17592186045417] [17592186281312 #edb/ref 1068 #edb/ref 17592186280919 #edb/ref 17592186045417] [17592186281312 #edb/ref 1069 "q-161733" #edb/ref 17592186045417] [17592186281312 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186281312 #edb/ref 1071 "$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{x}}4zy\\,dy]dA,\n$$\n\nEvaluate the repeated integral above given that $D$ is a region in the $xz$-plane bounded by the lines $z=0,$ $x=2$ and the line $z-x=0.$" #edb/ref 17592186045417] [17592186281312 #edb/ref 1072 #uuid "4b555d9f-d5f9-558f-a244-86b96b18ac88" #edb/ref 17592186045417] [17592186281312 #edb/ref 1074 "First, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{x}}4zy\\,dy]dA & ={∬}_{D}2z[{y}^{2}]_{y=0}^{y=\\sqrt{x}}\\,dA \\\\  & ={∬}_{D}2zx\\,dA\\end{aligned}\n$$\n\nNow, to calculate this double integral, we plot $D$ as a type I plane region in the $xz$-plane.\n\n![](images/b7/b748f589d7fa773444fc45bdbd1d94a5424bb81c40851f0f0f2542a4f66c0c8d.png)\n\n \n\nTherefore, to evaluate our double integral as a repeated integral over this region, we integrate with respect to $z$ and then with respect to $x:$\n\n$$\n\\begin{aligned}{∬}_{D}2zx\\,dA & ={\\int }_{0}^{2}{\\int }_{0}^{x}2zx\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x[{z}^{2}]_{z=0}^{z=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{3}\\,\\text{d}x \\\\  & ={[\\frac{1}{4}{x}^{4}]}_{x=0}^{x=2} \\\\  & =4-0 \\\\  & =4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281313 #edb/ref 1068 #edb/ref 17592186281136 #edb/ref 17592186045417] [17592186281313 #edb/ref 1069 "q-161735" #edb/ref 17592186045417] [17592186281313 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281313 #edb/ref 1071 "Evaluate the triple integral \n\n$$\n{∭}_{R}12y\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,0\\le y\\le \\sqrt{x}},\n$$\n\nand $D$ is a finite region in $xz$-plane enclosed between the $x$-axis, the line $x=1,$ and the line $z=x$ in the first quadrant." #edb/ref 17592186045417] [17592186281313 #edb/ref 1072 #uuid "ff27e038-e43c-5a90-b151-748220a86ed2" #edb/ref 17592186045417] [17592186281313 #edb/ref 1074 "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}12y\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{\\sqrt{x}}12y\\,dy]dA.\n$$\n\n \n\nFirst, we evaluate the inner integral with respect to $y,$ treating $x$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{x}}12y\\,dy]dA & ={∬}_{D}6[{y}^{2}]_{y=0}^{y=\\sqrt{x}}\\,dA \\\\  & ={∬}_{D}6x\\,dA\\end{aligned}\n$$\n\n \n\nWe must now evaluate this double integral over the region $D$ in the $xz$-plane shown below.\n\n![](images/1d/1d102b63c3deb8121ea88cdc994b9410cf28f9c3bb29abc5ea4a14d7e1e7c389.png)\n\n \n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}6x\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{x}6x\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}6x[z]_{z=0}^{z=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}6{x}^{2}\\,\\text{d}x \\\\  & ={[2{x}^{3}]}_{x=0}^{x=1} \\\\  & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281317 #edb/ref 1068 #edb/ref 17592186281060 #edb/ref 17592186045417] [17592186281317 #edb/ref 1069 "q-161751" #edb/ref 17592186045417] [17592186281317 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281317 #edb/ref 1071 "Evaluate the triple integral\n\n$$\n{∭}_{R}20y\\,\\text{d}V\n$$\n\nwhere $R$ is the type III region given by \n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le 1-{x}^{2},\\,0\\le y\\le 1-x}.\n$$" #edb/ref 17592186045417] [17592186281317 #edb/ref 1072 #uuid "f9e6176f-e02b-5e64-8d69-eb13369492af" #edb/ref 17592186045417] [17592186281317 #edb/ref 1074 "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}2x\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{\\int }_{0}^{1-x}20y\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{\\int }_{0}^{1-x}20y\\,dy\\,dz\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}[{\\int }_{0}^{1-x}20y\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}[10{y}^{2}]_{y=0}^{y=1-x}dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}10(1-x)^{2}\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}10(1-x)^{2}\\,dz\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{1-{x}^{2}}10(1-x)^{2}\\,dz]dx \\\\  & ={\\int }_{0}^{1}10(1-x)^{2}[z]_{z=0}^{z=1-{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}10(1-x)^{2}(1-{x}^{2})dx \\\\  & ={\\int }_{0}^{1}10(1-2x+2{x}^{3}-{x}^{4})\\,dx\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}10(1-2x+2{x}^{3}-{x}^{4})\\,dx & ={[10(x-{x}^{2}+\\frac{{x}^{4}}{2}-\\frac{{x}^{5}}{5})]}_{x=0}^{x=1} \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281358 #edb/ref 1068 #edb/ref 17592186280972 #edb/ref 17592186045417] [17592186281358 #edb/ref 1069 "q-161853" #edb/ref 17592186045417] [17592186281358 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281358 #edb/ref 1071 "![](images/a1/a1e4a1e39c85a037f3f4f49910b651300363ef34bee969464f5e711aa00986e3.png)\n\nEvaluate the triple integral \n${∭}_{R}4{x}^{2}z\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" #edb/ref 17592186045417] [17592186281358 #edb/ref 1072 #uuid "2dd43989-4160-5cb0-b938-4fe05b8b6278" #edb/ref 17592186045417] [17592186281358 #edb/ref 1074 "![](images/91/9165163be9ce95e7165f04d26e6ce8080699ab4d477eba3f804c849fdf1fb679.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 4-z},\n$$\n\nwhere\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/ca/ca74bf149c1371fe9f1622586d9eb92fe180a9c9bb6a0c53d16f538b3c55f4a4.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 3,\\,\\,0\\le y\\le 4-z}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}4{x}^{2}z\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{4-z}4{x}^{2}z\\,dy\\,dz\\,dx.\n$$\n\nFirst, we evaluate the inner integral with respect to $y$, treating $x$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}{\\int }_{0}^{4-z}4{x}^{2}z\\,dy\\,dz\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{3}[{\\int }_{0}^{4-z}4{x}^{2}z\\,dy]dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}4{x}^{2}z[y]_{y=0}^{y=4-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}4{x}^{2}z(4-z)\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}(16{x}^{2}z-4{x}^{2}{z}^{2})\\,dz\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{3}(16{x}^{2}z-4{x}^{2}{z}^{2})\\,dz\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{3}(16{x}^{2}z-4{x}^{2}{z}^{2})\\,dz]dx \\\\  & ={\\int }_{0}^{1}[8{x}^{2}{z}^{2}-\\frac{4}{3}{x}^{2}{z}^{3}]_{z=0}^{z=3}\\,dx \\\\  & ={\\int }_{0}^{1}36{x}^{2}\\,dx\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}36{x}^{2}\\,dx & ={[12{x}^{3}]}_{x=0}^{x=1} \\\\  & =(12-0) \\\\  & =12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186324100 #edb/ref 1080 "x+z" #edb/ref 17592186045417] [17592186324100 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324100 #edb/ref 1083 #uuid "0e2c97d4-b434-5053-9663-fa52d98d5684" #edb/ref 17592186045417] [17592186324279 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186324279 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324279 #edb/ref 1083 #uuid "26371e7c-d4aa-5cd0-a363-95439d905659" #edb/ref 17592186045417] [17592186324580 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186324580 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324580 #edb/ref 1083 #uuid "4b299549-5cb0-56d7-9c33-9a26cc8d61bb" #edb/ref 17592186045417] [17592186324608 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186324608 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324608 #edb/ref 1083 #uuid "4d153674-baf0-565f-a0eb-dec9cc52f8a5" #edb/ref 17592186045417] [17592186325246 #edb/ref 1080 "2x+1" #edb/ref 17592186045417] [17592186325246 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325246 #edb/ref 1083 #uuid "95a97664-7cb4-546a-9467-1efee24db627" #edb/ref 17592186045417] [17592186325283 #edb/ref 1080 "\\frac{4}{3}" #edb/ref 17592186045417] [17592186325283 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325283 #edb/ref 1083 #uuid "9a3d06d0-0635-568c-b9ca-dac6fef15963" #edb/ref 17592186045417] [17592186325291 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186325291 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325291 #edb/ref 1083 #uuid "9b0a8c83-7180