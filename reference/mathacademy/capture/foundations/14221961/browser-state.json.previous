      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125694-9974349c6375269d794d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125694-9974349c6375269d794d.png",
      "source_url": "https://mathacademy.com/tasks/14221961/topics/3694/lesson",
      "captured_at": 1792029704.7108018,
      "math_academy_id": "q-125694",
