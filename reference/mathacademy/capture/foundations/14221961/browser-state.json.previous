      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125501-a3e3bb1fe612b35e2aa4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125501-a3e3bb1fe612b35e2aa4.png",
