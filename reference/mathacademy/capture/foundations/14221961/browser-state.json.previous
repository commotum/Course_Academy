      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125495-c03768d9775e2fbd9003.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125495-c03768d9775e2fbd9003.png",
      "source_url": "https://mathacademy.com/tasks/14221961/topics/3694/lesson",
      "captured_at": 1792029743.3713484,
      "math_academy_id": "q-125495",
