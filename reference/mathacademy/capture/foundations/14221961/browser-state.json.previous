      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125380-4a5c8a8ec4cde8911dda.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125380-4a5c8a8ec4cde8911dda.png",
      "source_url": "https://mathacademy.com/tasks/14221961/topics/3694/lesson",
      "captured_at": 1792029887.0482247,
      "math_academy_id": "q-125380",
      "topic_id": "3694",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q125380",
        "placement_id": null,
        "content_id": null,
