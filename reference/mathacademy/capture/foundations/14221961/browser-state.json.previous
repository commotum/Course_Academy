      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125496-20c394a0798541bc32b3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125496-20c394a0798541bc32b3.png",
      "source_url": "https://mathacademy.com/tasks/14221961/topics/3694/lesson",
      "captured_at": 1792029763.381535,
      "math_academy_id": "q-125496",
      "topic_id": "3694",
      "sequence_position": null,
      "source_step": {
