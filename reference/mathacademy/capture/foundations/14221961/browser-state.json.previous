      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125488-aeab0dc73e89ee8733ef.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/foundations/14221961/observations/step-q125488-aeab0dc73e89ee8733ef.png",
      "source_url": "https://mathacademy.com/tasks/14221961/topics/3694/lesson",
      "captured_at": 1792029723.1183376,
      "math_academy_id": "q-125488",
      "topic_id": "3694",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q125488",
        "placement_id": null,
        "content_id": null,
