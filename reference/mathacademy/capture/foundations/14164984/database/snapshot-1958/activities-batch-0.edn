#{[{:activity/first-step {:db/id #edb/ref 17592186180418} :activity/id #uuid "3c60e1af-3567-58af-98f2-930ea8934370" :activity/scope {:db/id #edb/ref 17592186049826 :topic/id #uuid "16fa321b-e229-5d84-9d88-678560ff349f" :topic/math-academy-id 3700} :activity/steps [{:db/id #edb/ref 17592186180412 :step/content {:db/id #edb/ref 17592186179689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179548 :question/id #uuid "3a28f359-71aa-5b9b-b55c-802374e6821f" :question/math-academy-id "e-8745"} :knowledge-point/id #uuid "4f429709-cb4b-5319-8d2b-0858bc409e89" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186051085}] :knowledge-point/questions [{:db/id #edb/ref 17592186179911} {:db/id #edb/ref 17592186180186} {:db/id #edb/ref 17592186241125} {:db/id #edb/ref 17592186241126} {:db/id #edb/ref 17592186266089} {:db/id #edb/ref 17592186366836} {:db/id #edb/ref 17592186366843} {:db/id #edb/ref 17592186367394} {:db/id #edb/ref 17592186388216} {:db/id #edb/ref 17592186388223}] :knowledge-point/title "Finding the Curl of a Vector Field Using Linearity Properties"} :step/id #uuid "e4609d71-fe05-50cf-9a13-ebc4074a2846" :step/math-academy-id 32565 :step/next {:db/id #edb/ref 17592186180419}} {:db/id #edb/ref 17592186180415 :step/content {:db/id #edb/ref 17592186179691 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179550 :question/id #uuid "e27e6735-4d50-5c26-a20d-44454ddcdef3" :question/math-academy-id "e-8931"} :knowledge-point/id #uuid "ffe539af-1253-5ce3-a65b-eb50ed639c52" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186050885}] :knowledge-point/questions [{:db/id #edb/ref 17592186179908} {:db/id #edb/ref 17592186179912} {:db/id #edb/ref 17592186241136} {:db/id #edb/ref 17592186241148} {:db/id #edb/ref 17592186266091} {:db/id #edb/ref 17592186366864} {:db/id #edb/ref 17592186371527} {:db/id #edb/ref 17592186386175} {:db/id #edb/ref 17592186388230}] :knowledge-point/title "Finding the Curl of a Vector Field Using the Product Rule"} :step/id #uuid "98443251-1329-5b54-9cf7-7bf7e278e18a" :step/math-academy-id 33332} {:db/id #edb/ref 17592186180418 :step/content {:db/id #edb/ref 17592186180687 :tutorial/content "Recall that if $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j + R\\,\\mathbf k$ is a vector field on $\\mathbb R^3,$ then the curl of $\\mathbf F$ is given by\n\n$$\n\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}\n$$\n\nThe curl is a quantity that's made up of derivatives, so we would expect it to have similar properties to derivatives.\n\nFor example, if $\\mathbf F$ and $\\mathbf H$ are vector fields and $k$ is a scalar constant, then we have the following linearity properties:\n\n$$\n\\begin{aligned} & ∇\\times (kF)=k\\,∇\\times F \\\\  & ∇\\times (F+G)=∇\\times F+∇\\times G\\end{aligned}\n$$\n\nApplying these rules can often help us to save time when computing curl. Let's see some examples." :tutorial/id #uuid "61a8e799-6b8c-5b9e-b729-92a3f4d062ca" :tutorial/math-academy-id 5520 :tutorial/title "Introduction"} :step/id #uuid "424de5cf-698c-5da6-94c4-615bbca1376a" :step/math-academy-id 34361 :step/next {:db/id #edb/ref 17592186180412}} {:db/id #edb/ref 17592186180419 :step/content {:db/id #edb/ref 17592186180688 :tutorial/content "Recall that for functions $f(x)$ and $g(x),$ the product rule for differentiation is given by\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(f\\cdot g) = f\\dfrac{\\textrm d }{\\textrm d x}(g) +  g\\dfrac{\\textrm d }{\\textrm d x}(f).\n$$\n\nThere is an analogous rule for computing the curl of the product of a vector field and a scalar field.\n\nSuppose that $\\mathbf F$ is a vector field and $f$ is a scalar field. Then, we have the following identity:\n\n$$\n\\nabla\\times(f\\,\\mathbf F) = f \\, \\nabla \\times \\mathbf {F}+   \\nabla \\! f \\times \\mathbf F\n$$\n\nwhere $\\nabla f$ is the gradient of $f.$\n\nNotice that the del operator $\\nabla$ acts on the terms in the same way as the $\\dfrac{\\textrm d}{\\textrm d x}$ operator in the product rule for differentiation!\n\nThere are a few other tips that we can use to remember this rule:\n\n- The term $\\nabla\\times(f\\,\\mathbf F)$ on the left-hand side must be a vector field because it's a curl. So, the two terms on the right-hand side must be vector fields, too.\n\n- The term $f \\, \\nabla \\times \\mathbf {F}$ on the right-hand side is a vector field because $f$ is a scalar field, $\\nabla \\times \\mathbf F$ is a vector field, and the product of a scalar and a vector field is a vector field. Note that this \"product\" is just regular multiplication.\n\n- The term $\\nabla \\! f \\times \\mathbf F$ on the right-hand side is a vector field because both $\\nabla f$ and $\\mathbf F$ are vector fields, and the *cross-product* of two vector fields is a vector field." :tutorial/id #uuid "0eb2c12d-4d29-5fe3-b3a4-864368ada8f3" :tutorial/math-academy-id 5521 :tutorial/title "The Product Rule for Curl"} :step/id #uuid "2b40b1da-c024-5f4e-83fe-5a20d7b787c2" :step/math-academy-id 34362 :step/next {:db/id #edb/ref 17592186180415}}] :activity/title "Properties of the Curl Operator" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179854}]}
