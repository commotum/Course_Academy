#{[{:db/id #edb/ref 17592186408129 :knowledge-point/_questions [{:db/id #edb/ref 17592186124509 :knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1947e7ad-9f28-5f1c-bbd7-0534d7ae56a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}>1}" :db/id #edb/ref 17592186408116} {:answer/id #uuid "4a717d1f-b7eb-5705-90ee-dc90eea2ac01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\ge 1}" :db/id #edb/ref 17592186408117} {:answer/id #uuid "69b1c641-c4ea-5e70-b0c0-21d7aa7137c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}\\le 1}" :db/id #edb/ref 17592186408120} {:answer/id #uuid "cd42f6f5-8e5b-53dc-b5eb-fcddd900ecf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186408122} {:answer/id #uuid "fda21d60-b280-5d0d-beed-f16249e1a048" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x+1)^{2}+(y-2)^{2}<1}" :db/id #edb/ref 17592186408125}] :answer-field/correct {:answer/id #uuid "cd42f6f5-8e5b-53dc-b5eb-fcddd900ecf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186408122} :answer-field/id #uuid "2e07a855-54d3-5672-a263-c28fae61891d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408126}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28ec3dc9-c6d5-5b75-a09b-0f48f395ab8d" :question/math-academy-id "q-164302" :question/problem "Given the hyperboloid of two sheets $(x+1)^{2}+(y-2)^{2}-\\frac{{z}^{2}}{9}=-1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-2)^{2}-\\frac{{z}^{2}}{9} & =-1 \\\\ (x+1)^{2}+(y-2)^{2}+1 & =\\frac{{z}^{2}}{9}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{9} & =(x+1)^{2}+(y-2)^{2}+1 \\\\ {z}^{2} & =9((x+1)^{2}+(y-2)^{2}+1) \\\\ z & =\\pm 3\\sqrt{(x+1)^{2}+(y-2)^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n(x+1)^{2}+(y-2)^{2}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$"}] [{:db/id #edb/ref 17592186284485 :knowledge-point/_questions [{:db/id #edb/ref 17592186124561 :knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "551c53cb-cbf5-55c7-ba29-b85d13550b02" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$3\\sqrt{2}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186282418} {:answer/id #uuid "7819d091-7c0e-5b7f-811d-3d6c71883b60" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186282722} {:answer/id #uuid "8ad6b7a6-a742-5b64-8cb1-af1729ef0f49" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$18$ and $2$" :db/id #edb/ref 17592186282892} {:answer/id #uuid "a9de43cc-4364-5236-b915-7e6ddcebb2a2" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$\\sqrt{6}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186283168} {:answer/id #uuid "b5641acc-ae6d-5cbd-a8c8-1547afc76732" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186283270}] :answer-field/correct {:answer/id #uuid "b5641acc-ae6d-5cbd-a8c8-1547afc76732" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186283270} :answer-field/id #uuid "0ba59a7f-90be-5278-8bf5-8ea5a019c2ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6cf5542-c57d-51eb-9c7d-5efe33d9469c" :question/math-academy-id "q-164380" :question/problem "The projection of the intersection between the hyperboloid of two sheets $-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(z-2)^{2}=-1$ and the plane $z=3$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=3,$ we substitute $z=3$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(3-2)^{2} & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+1 & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2} & =-2 \\\\ \\frac{(x+1)^{2}}{18}-\\frac{{y}^{2}}{2} & =2 \\\\ \\frac{(x+1)^{2}}{36}-\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(x+1)^{2}}{{6}^{2}}-\\frac{{y}^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $6$ and $2.$"}] [{:db/id #edb/ref 17592186323807 :knowledge-point/_questions [{:db/id #edb/ref 17592186124509 :knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b247dd-fec8-5ca0-973c-2e5283ca38cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}<0}" :db/id #edb/ref 17592186321339} {:answer/id #uuid "61eca7e5-5fa6-5690-a884-1b0e9b6596f6" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186321919} {:answer/id #uuid "90c09e40-2729-5ade-8409-6290b0249236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}<1}" :db/id #edb/ref 17592186322302} {:answer/id #uuid "adcd90b4-3530-55e6-af62-f4a55da2ba2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}\\ge 0}" :db/id #edb/ref 17592186322517} {:answer/id #uuid "f8c6cf8c-9492-52a4-b891-983ac582c05c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}" :db/id #edb/ref 17592186323110}] :answer-field/correct {:answer/id #uuid "f8c6cf8c-9492-52a4-b891-983ac582c05c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}" :db/id #edb/ref 17592186323110} :answer-field/id #uuid "787e8934-c73f-50c0-b941-8b2a7ad64fd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7388c8d-bcb0-58d2-b80f-408abd20ed3a" :question/math-academy-id "q-36388" :question/problem "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}.\n$$"}] [{:db/id #edb/ref 17592186339033 :knowledge-point/_questions [{:db/id #edb/ref 17592186124561 :knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1367a913-bd30-5d46-b192-55918d608fb8" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "Two parallel lines: $y=2x\\pm 2$" :db/id #edb/ref 17592186336221} {:answer/id #uuid "21b8d9e0-4b1f-50b9-9504-2d80b0e4177d" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186336352} {:answer/id #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/id #edb/ref 17592186336858} {:answer/id #uuid "9ef4b176-d408-5e50-bc9d-8a80f42c2948" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" :db/id #edb/ref 17592186337474} {:answer/id #uuid "ddad069b-ab04-5be6-931f-973051696d79" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=1$" :db/id #edb/ref 17592186337966}] :answer-field/correct {:answer/id #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/id #edb/ref 17592186336858} :answer-field/id #uuid "1567f6f6-2047-5c07-9a81-179bf8b695ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338319}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e51ba70-807e-5821-b5e3-3514d515c2b6" :question/math-academy-id "q-71966" :question/problem "What is the projection of the intersection between the hyperboloid of one sheet $\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{z}^{2}=1$ and the plane $z=1$ onto the $xy$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=1$, we substitute $z=1$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{1}^{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+1 & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8} & =0 \\\\ {y}^{2} & =4(x-2)^{2} \\\\ y & =\\pm 2(x-2)\\end{aligned}\n$$\n\nThis gives us two intersecting lines: $y=2(x-2)$ and $y=-2(x-2).$"}] [{:db/id #edb/ref 17592186408128 :knowledge-point/_questions [{:db/id #edb/ref 17592186124509 :knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "647d79bc-f910-5f37-9518-15b28a26a365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{2}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186408118} {:answer/id #uuid "6664498a-b8f5-59ab-b882-7ea3cc1260a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+{y}^{2}\\ge 1}" :db/id #edb/ref 17592186408119} {:answer/id #uuid "c970f5ab-4e4d-5836-a7ea-bb38ca163641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186408121} {:answer/id #uuid "e08b4887-48da-5258-b769-f2c5686179db" :answer/type {:db/id #edb/ref 17592186045500 :db/ident :answer.type/text} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186408123} {:answer/id #uuid "ed3fc56b-37c5-55d4-9d7e-18c3f48790c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}" :db/id #edb/ref 17592186408124}] :answer-field/correct {:answer/id #uuid "ed3fc56b-37c5-55d4-9d7e-18c3f48790c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}" :db/id #edb/ref 17592186408124} :answer-field/id #uuid "e4502bac-b95a-55f0-b8aa-e4531b3d53f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408127}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fec2431-d065-5bba-8c18-02d476e1dc33" :question/math-academy-id "q-74014" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =16(\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1) \\\\ z & =\\pm 4\\sqrt{\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & \\ge 0 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x-2)^{2}}{4}+(y-1)^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}.\n$$"}]}
