2186045585] [17592186408126 #edb/ref 1075 #edb/ref 17592186408122 #edb/ref 17592186045585] [17592186408126 #edb/ref 1075 #edb/ref 17592186408125 #edb/ref 17592186045585] [17592186408126 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186408126 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186408126 #edb/ref 1079 #edb/ref 17592186408122 #edb/ref 17592186045585] [17592186408126 #edb/ref 1080 #uuid "2e07a855-54d3-5672-a263-c28fae61891d" #edb/ref 17592186045585] [17592186408127 #edb/ref 1075 #edb/ref 17592186408118 #edb/ref 17592186045585] [17592186408127 #edb/ref 1075 #edb/ref 17592186408119 #edb/ref 17592186045585] [17592186408127 #edb/ref 1075 #edb/ref 17592186408121 #edb/ref 17592186045585] [17592186408127 #edb/ref 1075 #edb/ref 17592186408123 #edb/ref 17592186045585] [17592186408127 #edb/ref 1075 #edb/ref 17592186408124 #edb/ref 17592186045585] [17592186408127 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186408127 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186408127 #edb/ref 1079 #edb/ref 17592186408124 #edb/ref 17592186045585] [17592186408127 #edb/ref 1080 #uuid "e4502bac-b95a-55f0-b8aa-e4531b3d53f1" #edb/ref 17592186045585] [17592186408128 #edb/ref 1068 #edb/ref 17592186408127 #edb/ref 17592186045585] [17592186408128 #edb/ref 1069 "q-74014" #edb/ref 17592186045585] [17592186408128 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186408128 #edb/ref 1071 "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16}=1$, find the domain of $z=z(x,y).$" #edb/ref 17592186045585] [17592186408128 #edb/ref 1072 #uuid "1fec2431-d065-5bba-8c18-02d476e1dc33" #edb/ref 17592186045585] [17592186408128 #edb/ref 1074 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =16(\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1) \\\\ z & =\\pm 4\\sqrt{\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & \\ge 0 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x-2)^{2}}{4}+(y-1)^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1}.\n$$" #edb/ref 17592186045585] [17592186408129 #edb/ref 1068 #edb/ref 17592186408126 #edb/ref 17592186045585] [17592186408129 #edb/ref 1069 "q-164302" #edb/ref 17592186045585] [17592186408129 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045585] [17592186408129 #edb/ref 1071 "Given the hyperboloid of two sheets $(x+1)^{2}+(y-2)^{2}-\\frac{{z}^{2}}{9}=-1,$ find the domain of $z=z(x,y).$" #edb/ref 17592186045585] [17592186408129 #edb/ref 1072 #uuid "28ec3dc9-c6d5-5b75-a09b-0f48f395ab8d" #edb/ref 17592186045585] [17592186408129 #edb/ref 1074 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-2)^{2}-\\frac{{z}^{2}}{9} & =-1 \\\\ (x+1)^{2}+(y-2)^{2}+1 & =\\frac{{z}^{2}}{9}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{9} & =(x+1)^{2}+(y-2)^{2}+1 \\\\ {z}^{2} & =9((x+1)^{2}+(y-2)^{2}+1) \\\\ z & =\\pm 3\\sqrt{(x+1)^{2}+(y-2)^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n(x+1)^{2}+(y-2)^{2}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" #edb/ref 17592186045585] [17592186408130 #edb/ref 1058 #edb/ref 17592186408134 #edb/ref 17592186045585] [17592186408130 #edb/ref 1062 #uuid "1a9a8033-786e-5c6d-91e1-dc436b6bcbe6" #edb/ref 17592186045585] [17592186408130 #edb/ref 1063 #edb/ref 17592186339033 #edb/ref 17592186045585] [17592186408131 #edb/ref 1058 #edb/ref 17592186408130 #e