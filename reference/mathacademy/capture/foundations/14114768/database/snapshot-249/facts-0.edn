9b1de06e-be8c-5534-9c53-59e61058ffb5" #edb/ref 17592186045585] [17592186125381 #edb/ref 1063 #edb/ref 17592186125779 #edb/ref 17592186045585] [17592186125382 #edb/ref 1058 #edb/ref 17592186125465 #edb/ref 17592186045585] [17592186125382 #edb/ref 1061 19458 #edb/ref 17592186045585] [17592186125382 #edb/ref 1062 #uuid "4ba1a392-70de-526a-ac89-008dd6fbf4e5" #edb/ref 17592186045585] [17592186125382 #edb/ref 1063 #edb/ref 17592186124509 #edb/ref 17592186045585] [17592186125385 #edb/ref 1058 #edb/ref 17592186125640 #edb/ref 17592186045585] [17592186125385 #edb/ref 1061 19462 #edb/ref 17592186045585] [17592186125385 #edb/ref 1062 #uuid "4ed11bf9-ec94-5810-9687-5899a45bf9cc" #edb/ref 17592186045585] [17592186125385 #edb/ref 1063 #edb/ref 17592186125781 #edb/ref 17592186045585] [17592186125464 #edb/ref 1061 22380 #edb/ref 17592186045585] [17592186125464 #edb/ref 1062 #uuid "fb6a05b0-ef9d-5743-a9b2-a3a300f5e53f" #edb/ref 17592186045585] [17592186125464 #edb/ref 1063 #edb/ref 17592186124561 #edb/ref 17592186045585] [17592186125465 #edb/ref 1058 #edb/ref 17592186125641 #edb/ref 17592186045585] [17592186125465 #edb/ref 1061 22397 #edb/ref 17592186045585] [17592186125465 #edb/ref 1062 #uuid "2deb75ff-8eff-541a-bff6-4a30ea363312" #edb/ref 17592186045585] [17592186125465 #edb/ref 1063 #edb/ref 17592186125810 #edb/ref 17592186045585] [17592186125640 #edb/ref 1058 #edb/ref 17592186125643 #edb/ref 17592186045585] [17592186125640 #edb/ref 1061 45274 #edb/ref 17592186045585] [17592186125640 #edb/ref 1062 #uuid "55a21c7e-3632-5bac-88a2-92a6bd3c409d" #edb/ref 17592186045585] [17592186125640 #edb/ref 1063 #edb/ref 17592186124656 #edb/ref 17592186045585] [17592186125641 #edb/ref 1058 #edb/ref 17592186125642 #edb/ref 17592186045585] [17592186125641 #edb/ref 1061 45276 #edb/ref 17592186045585] [17592186125641 #edb/ref 1062 #uuid "f7656072-e089-540b-89c4-8df18945b7f8" #edb/ref 17592186045585] [17592186125641 #edb/ref 1063 #edb/ref 17592186125883 #edb/ref 17592186045585] [17592186125642 #edb/ref 1058 #edb/ref 17592186125464 #edb/ref 17592186045585] [17592186125642 #edb/ref 1061 45277 #edb/ref 17592186045585] [17592186125642 #edb/ref 1062 #uuid "3e256a50-c4bf-5ba0-8f3e-b65f84c0fe2c" #edb/ref 17592186045585] [17592186125642 #edb/ref 1063 #edb/ref 17592186125884 #edb/ref 17592186045585] [17592186125643 #edb/ref 1058 #edb/ref 17592186125382 #edb/ref 17592186045585] [17592186125643 #edb/ref 1061 45281 #edb/ref 17592186045585] [17592186125643 #edb/ref 1062 #uuid "203c24cd-0b43-5e99-91fc-7f9c44b7b75c" #edb/ref 17592186045585] [17592186125643 #edb/ref 1063 #edb/ref 17592186125885 #edb/ref 17592186045585] [17592186125779 #edb/ref 1064 "A **hyperboloid of one sheet** centered at $(x_0,y_0,z_0)$ is a quadric surface whose equation is given by\n\n$$\\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2} - \\dfrac{(z-z_0)^2}{c^2} =1,$$\n\nwhere $a,$ $b,$ and $c$ are constants.\n\nFor example, the graph of the hyperboloid of one sheet\n\n$$x^2+y^2-z^2=1$$\n\nis shown below. It has its center at the origin, and the $z$-axis is the **axis of symmetry** of the hyperboloid.\n\n![](images/0d/0d97e5ac26685b49bcdb3155866bd34ba83bd758f02035b500d3f594fc5716c8.png)\n\nThe intercepts of this hyperboloid with the coordinate axes are as follows:\n\n- the $x$-intercepts are $(\\pm1,0,0)$\n- the $y$-intercepts are $(0,\\pm1,0)$\n- there are no $z$-intercepts" #edb/ref 17592186045585] [17592186125779 #edb/ref 1065 3438 #edb/ref 17592186045585] [17592186125779 #edb/ref 1066 #uuid "b15b84bd-ab8f-5ade-8289-c1795374ab94" #edb/ref 17592186045585] [17592186125779 #edb/ref 1067 "Introduction" #edb/ref 17592186045585] [17592186125781 #edb/ref 1064 "A **hyperboloid of two sheets** centered at $(x_0, y_0, z_0)$ is given by\n\n$$\\dfrac{(x-x_0)^2}{a^2} + \\dfrac{(y-y_0)^2}{b^2} - \\dfrac{(z-z_0)^2}{c^2} =-1.$$\n\n**Watch out!** This equation is similar to the general equation of a hyperboloid of one sheet. The only difference is the right-hand side is now $-1$ instead of $+1.$\n\nFor example, the graph of the hyperboloid of two sheets\n\n$$x^2+y^2-z^2=-1$$\n\nis represented below. It has its center at the origin, and the $z$-axis is the **axis of symmetry** of the hyperboloid.\n\n![](images/96/96ec4196c3e299d2e57cdb8a3a2a06094452bf05e2f66e43fc60c059077b305f.png)\n\nThe intercepts of this hyperboloid with the $z$-axis are $(0,0,\\pm1).$ The surface does not intersect the $x$- or $y$-axes.\n\nCalculating the intercepts of a hyperboloid with the coordinate axes is done in the same way as we've seen before with spheres and ellipsoids. Let's see some examples.\n\nThere is a simple way to distinguish between hyperboloids of one and two sheets by simply looking at the equations:\n\n- *one* minus sign indicates hyperboloids of *one* sheet: $$\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}=1$$\n- *two* minus signs indicate hyperboloids of *two* sheets: $$\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2} \\bbox[3pt,Gainsboro]{\\color{red}-} \\dfrac{z^2}{c^2}= \\bbox[3pt,Gainsboro]{\\color{red}-}1$$" #edb/ref 17592186045585] [17592186125781 #edb/ref 1065 3440 #edb/ref 17592186045585] [17592186125781 #edb/ref 1066 #uuid "d9a4fb57-50db-54d3-a354-5c56c44b5b3b" #edb/ref 17592186045585] [17592186125781 #edb/ref 1067 "Hyperboloids of Two Sheets" #edb/ref 17592186045585] [17592186125810 #edb/ref 1064 "So far, we've encountered hyperboloids whose axes of symmetry are parallel to the $z$-axis. \nLet's now consider the cases when a hyperboloid is oriented along the $x$- or the $y$-axes.\n\nFor a hyperboloid of one sheet centered at the origin, the other two cases are as follows:\n\n- When the $y$ term is negative, the axis of symmetry is the $y$-axis.\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2} + \\frac{z^2}{c^2} =1\n$$\n\n![](images/85/854a4e7506aa8e14fd19ceaadb5311a2d83596d27b33224272c41fa0639ea996.png)\n\n- When the $x$ term is negative, the axis of symmetry is the $x$-axis.\n\n$$\n-\\frac{x^2}{a^2} + \\frac{y^2}{b^2} + \\frac{z^2}{c^2} =1\n$$\n\n![](images/ef/effc9d579d8d2ba00fec421fb1800639ccb4fba440e4518a5454d4ca282bc2d3.png)\n\nLikewise, for a hyperboloid of two sheets centered at the origin, the other two cases are as follows:\n\n- When the $y$ term is negative, the axis of symmetry is the $y$-axis.\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2} + \\frac{z^2}{c^2} =-1\n$$\n\n![](images/2b/2b77432e38466d0983c196aed51eecd614096d971f21b0c68804e71a39548210.png)\n\n- When the $x$ term is negative, the axis of symmetry is the $x$-axis.\n\n$$\n-\\frac{x^2}{a^2} + \\frac{y^2}{b^2} + \\frac{z^2}{c^2} =-1\n$$\n\n![](images/4d/4d3b7e21da4acb5c13320c248c9cbe220488f43cfcbe328ad0416b22f449d143.png)" #edb/ref 17592186045585] [17592186125810 #edb/ref 1065 3850 #edb/ref 17592186045585] [17592186125810 #edb/ref 1066 #uuid "37ea72a1-3f48-5ba4-94e5-ad5a2e962723" #edb/ref 17592186045585] [17592186125810 #edb/ref 1067 "Alternative Orientations of the Axis of Symmetry" #edb/ref 17592186045585] [17592186125883 #edb/ref 1064 "The traces of a hyperboloid of one sheet are either ellipses or hyperbolas.\n\nFor example, let's find the traces with the coordinate planes for the hyperboloid of one sheet given by\n\n$$\nx^2+y^2-z^2=1.\n$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{0}^{2} & =1 \\\\ {x}^{2}+{y}^{2} & =1,\\end{aligned}\n$$\n\nwhich is a circle centered at the origin of radius $1$ in the $xy$-plane.\n\n![](images/b3/b369958a609ba3861be5d32fbf3195b6feb241228f81e89bb116b29f80e38318.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2}-{z}^{2} & =1 \\\\ {x}^{2}-{z}^{2} & =1,\\end{aligned}\n$$\n\nwhich is a hyperbola in the $xz$-plane centered at the origin.\n\n![](images/4c/4c77b8758877ac88a73dece8c52f3b9cb650c4176edad5db020b138d70e0393b.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}{0}^{2}+{y}^{2}-{z}^{2} & =1 \\\\ {y}^{2}-{z}^{2} & =1,\\end{aligned}\n$$\n\nwhich is a hyperbola in the $yz$-plane centered at the origin.\n\n![](images/0d/0ddcfc2e78166fa801a46deccd30c4cc2ddc12e81ae2e81508b5e13a374c208f.png)" #edb/ref 17592186045585] [17592186125883 #edb/ref 1065 7836 #edb/ref 17592186045585] [17592186125883 #edb/ref 1066 #uuid "f3dfcfe4-330c-5142-8314-d09baa6e8acf" #edb/ref 17592186045585] [17592186125883 #edb/ref 1067 "Traces of Hyperboloids of One Sheet" #edb/ref 17592186045585] [17592186125884 #edb/ref 1064 "The traces of a hyperboloid of two sheets are either ellipses, hyperbolas, a single point, or the empty set.\n\nFor example, let's find the traces with the coordinate planes for the hyperboloid of two sheets given by\n\n$$\nx^2+y^2-z^2=-1.\n$$\n\n- The trace of this surface in the $xy$-plane (when $z=0$) is the empty set since the surface does not intersect the $xy$-plane.\n\n![](images/96/96ec4196c3e299d2e57cdb8a3a2a06094452bf05e2f66e43fc60c059077b305f.png)\n\n- The trace of this surface in the $xz$-plane (when $y=0$) is given by the equation\n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2}-{z}^{2} & =-1 \\\\ {x}^{2}-{z}^{2} & =-1,\\end{aligned}\n$$\n\nwhich is a hyperbola in the $xz$-plane centered at the origin.\n\n![](images/71/71d280f0b887b4805c882362dab8c9b13ef08b83f91904bce487ef749a67a6ab.png)\n\n- The trace of this surface in the $yz$-plane (when $x=0$) is given by the equation\n\n$$\n\\begin{aligned}{0}^{2}+{y}^{2}-{z}^{2} & =-1 \\\\ {y}^{2}-{z}^{2} & =-1,\\end{aligned}\n$$\n\nwhich is a hyperbola in the $yz$-plane centered at the origin.\n\n![](images/34/3425d7f8df3a4dbbb5fa5763baf499e220215d0e33a0914859b8d1707074145d.png)\n\nThere are a few other cases we should note:\n\n- The trace of our surface with the plane $z=1$ is a single point (the vertex of the upper sheet):\n\n$$\nx^2+y^2 - 1^2 = -1 \\quad\\Longrightarrow\\quad (x,y,z) = (0,0,1)\n$$\n\nLikewise, the trace of our surface with the plane $z=-1$ is another point (the vertex of the lower sheet):\n\n$$\nx^2+y^2 - (-1)^2 = -1 \\quad\\Longrightarrow\\quad (x,y,z) = (0,0,-1)\n$$\n\n- The trace of our surface with the horizontal plane $z=k$ for $|k| > 1$ is a circle:\n\n$$\nx^2+y^2 - k^2 = -1 \\quad\\Longrightarrow x^2+y^2 = k^2-1\n$$\n\n![](images/0c/0c91656e9656d4958de2b82f24ae05a6611d24d1cf0536384fbdd873d2e10e1d.png)" #edb/ref 17592186045585] [17592186125884 #edb/ref 1065 7837 #edb/ref 17592186045585] [17592186125884 #edb/ref 1066 #uuid "16cf67e7-24e7-5523-991e-af37acd35e60" #edb/ref 17592186045585] [17592186125884 #edb/ref 1067 "Traces of Hyperboloids of Two Sheets" #edb/ref 17592186045585] [17592186125885 #edb/ref 1064 "Let's consider the graphs a typical one-sheet and two-sheet hyperboloids centered at $O,$ as shown below.\n\n![](images/45/45359d1c73d9cdc721068dbee0e27bedb8cde622bae0615c16862e4157b2baf3.png)\n\nNotice that a hyperboloid of two sheets is defined for any $(x,y) \\in \\mathbb{R}^2.$ In fact, for any point $(x,y)$ in the $xy$-plane, there are exactly two points on the hyperboloid. \n\nOn the other hand, the graph of a hyperboloid of one sheet does not contain points over the central elliptical region (close to the axis of symmetry).\n\nFor example, given the hyperboloid of one sheet $x^2 + y^2 - z^2 = 1,$ let's find the domain of $z = z(x,y).$\n\nFrom the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =1 \\\\ {x}^{2}+{y}^{2}-1 & ={z}^{2} \\\\ {z}^{2} & ={x}^{2}+{y}^{2}-1 \\\\ z & =\\pm \\sqrt{{x}^{2}+{y}^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-1 & \\ge 0 \\\\ {x}^{2}+{y}^{2} & \\ge 1,\\end{aligned}\n$$\n\nwhich gives the *exterior* and boundary of the circle $x^2 + y^2 = 1.$\n\nTherefore, the domain of $z(x,y)$ for the hyperboloid $x^2+y^2-z^2 = 1$ is\n\n$$\n\\left \\{(x,y) \\: : \\: x^2 + y^2 \\geq 1 \\right\\}.\n$$" #edb/ref 17592186045585] [17592186125885 #edb/ref 1065 7838 #edb/ref 17592186045585] [17592186125885 #edb/ref 1066 #uuid "4d2a84b4-9a16-51d5-a343-bc7826406b8e" #edb/ref 17592186045585] [17592186125885 #edb/ref 1067 "The Domain of a Hyperboloid" #edb/ref 17592186045585] [17592186282418 #edb/ref 1081 "$3\\sqrt{2}$ and $\\sqrt{2}$" #edb/ref 17592186045585] [17592186282418 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186282418 #edb/ref 1084 #uuid "551c53cb-cbf5-55c7-ba29-b85d13550b02" #edb/ref 17592186045585] [17592186282722 #edb/ref 1081 "$9$ and $4$" #edb/ref 17592186045585] [17592186282722 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186282722 #edb/ref 1084 #uuid "7819d091-7c0e-5b7f-811d-3d6c71883b60" #edb/ref 17592186045585] [17592186282892 #edb/ref 1081 "$18$ and $2$" #edb/ref 17592186045585] [17592186282892 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186282892 #edb/ref 1084 #uuid "8ad6b7a6-a742-5b64-8cb1-af1729ef0f49" #edb/ref 17592186045585] [17592186283168 #edb/ref 1081 "$\\sqrt{6}$ and $\\sqrt{3}$" #edb/ref 17592186045585] [17592186283168 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186283168 #edb/ref 1084 #uuid "a9de43cc-4364-5236-b915-7e6ddcebb2a2" #edb/ref 17592186045585] [17592186283270 #edb/ref 1081 "$6$ and $2$" #edb/ref 17592186045585] [17592186283270 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186283270 #edb/ref 1084 #uuid "b5641acc-ae6d-5cbd-a8c8-1547afc76732" #edb/ref 17592186045585] [17592186283960 #edb/ref 1075 #edb/ref 17592186282418 #edb/ref 17592186045585] [17592186283960 #edb/ref 1075 #edb/ref 17592186282722 #edb/ref 17592186045585] [17592186283960 #edb/ref 1075 #edb/ref 17592186282892 #edb/ref 17592186045585] [17592186283960 #edb/ref 1075 #edb/ref 17592186283168 #edb/ref 17592186045585] [17592186283960 #edb/ref 1075 #edb/ref 17592186283270 #edb/ref 17592186045585] [17592186283960 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186283960 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186283960 #edb/ref 1079 #edb/ref 17592186283270 #edb/ref 17592186045585] [17592186283960 #edb/ref 1080 #uuid "0ba59a7f-90be-5278-8bf5-8ea5a019c2ac" #edb/ref 17592186045585] [17592186284485 #edb/ref 1068 #edb/ref 17592186283960 #edb/ref 17592186045585] [17592186284485 #edb/ref 1069 "q-164380" #edb/ref 17592186045585] [17592186284485 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186284485 #edb/ref 1071 "The projection of the intersection between the hyperboloid of two sheets $-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(z-2)^{2}=-1$ and the plane $z=3$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" #edb/ref 17592186045585] [17592186284485 #edb/ref 1072 #uuid "b6cf5542-c57d-51eb-9c7d-5efe33d9469c" #edb/ref 17592186045585] [17592186284485 #edb/ref 1074 "To find the intersection of the hyperboloid and the plane $z=3,$ we substitute $z=3$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(3-2)^{2} & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+1 & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2} & =-2 \\\\ \\frac{(x+1)^{2}}{18}-\\frac{{y}^{2}}{2} & =2 \\\\ \\frac{(x+1)^{2}}{36}-\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(x+1)^{2}}{{6}^{2}}-\\frac{{y}^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $6$ and $2.$" #edb/ref 17592186045585] [17592186321339 #edb/ref 1081 "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}<0}" #edb/ref 17592186045585] [17592186321339 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186321339 #edb/ref 1084 #uuid "16b247dd-fec8-5ca0-973c-2e5283ca38cc" #edb/ref 17592186045585] [17592186321919 #edb/ref 1081 "The entire $xy$-plane" #edb/ref 17592186045585] [17592186321919 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186321919 #edb/ref 1084 #uuid "61eca7e5-5fa6-5690-a884-1b0e9b6596f6" #edb/ref 17592186045585] [17592186322302 #edb/ref 1081 "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}<1}" #edb/ref 17592186045585] [17592186322302 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186322302 #edb/ref 1084 #uuid "90c09e40-2729-5ade-8409-6290b0249236" #edb/ref 17592186045585] [17592186322517 #edb/ref 1081 "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}\\ge 0}" #edb/ref 17592186045585] [17592186322517 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186322517 #edb/ref 1084 #uuid "adcd90b4-3530-55e6-af62-f4a55da2ba2c" #edb/ref 17592186045585] [17592186323110 #edb/ref 1081 "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}" #edb/ref 17592186045585] [17592186323110 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186323110 #edb/ref 1084 #uuid "f8c6cf8c-9492-52a4-b891-983ac582c05c" #edb/ref 17592186045585] [17592186323411 #edb/ref 1075 #edb/ref 17592186321339 #edb/ref 17592186045585] [17592186323411 #edb/ref 1075 #edb/ref 17592186321919 #edb/ref 17592186045585] [17592186323411 #edb/ref 1075 #edb/ref 17592186322302 #edb/ref 17592186045585] [17592186323411 #edb/ref 1075 #edb/ref 17592186322517 #edb/ref 17592186045585] [17592186323411 #edb/ref 1075 #edb/ref 17592186323110 #edb/ref 17592186045585] [17592186323411 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045585] [17592186323411 #edb/ref 1077 "selection" #edb/ref 17592186045585] [17592186323411 #edb/ref 1079 #edb/ref 17592186323110 #edb/ref 17592186045585] [17592186323411 #edb/ref 1080 #uuid "787e8934-c73f-50c0-b941-8b2a7ad64fd6" #edb/ref 17592186045585] [17592186323807 #edb/ref 1068 #edb/ref 17592186323411 #edb/ref 17592186045585] [17592186323807 #edb/ref 1069 "q-36388" #edb/ref 17592186045585] [17592186323807 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045585] [17592186323807 #edb/ref 1071 "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" #edb/ref 17592186045585] [17592186323807 #edb/ref 1072 #uuid "e7388c8d-bcb0-58d2-b80f-408abd20ed3a" #edb/ref 17592186045585] [17592186323807 #edb/ref 1074 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}.\n$$" #edb/ref 17592186045585] [17592186336221 #edb/ref 1081 "Two parallel lines: $y=2x\\pm 2$" #edb/ref 17592186045585] [17592186336221 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186336221 #edb/ref 1084 #uuid "1367a913-bd30-5d46-b192-55918d608fb8" #edb/ref 17592186045585] [17592186336352 #edb/ref 1081 "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" #edb/ref 17592186045585] [17592186336352 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186336352 #edb/ref 1084 #uuid "21b8d9e0-4b1f-50b9-9504-2d80b0e4177d" #edb/ref 17592186045585] [17592186336858 #edb/ref 1081 "Two intersecting lines: $y=\\pm 2(x-2)$" #edb/ref 17592186045585] [17592186336858 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [17592186336858 #edb/ref 1084 #uuid "5a1cf904-9470-5d6d-bd73-91765fe6eab5" #edb/ref 17592186045585] [17592186337474 #edb/ref 1081 "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" #edb/ref 17592186045585] [17592186337474 #edb/ref 1083 #edb/ref 17592186045500 #edb/ref 17592186045585] [1759218