#{[{:db/id #edb/ref 17592186166708 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166855 :knowledge-point/id #uuid "fd76ab70-7c62-5513-8afa-7b805b3b8447" :knowledge-point/title "The Mean of an Exponential Distribution"}] :question/id #uuid "707a9f77-49ed-5ab2-abc9-5fbffb713336" :question/math-academy-id "e-9242" :question/problem "Given that $X\\sim \\textrm{Exp}\\left(\\dfrac{\\sqrt 3}{3}\\right),$ what is $\\textrm{E}[X]?$" :question/worked-solution "If $X \\sim \\textrm{Exp}({\\lambda})$ is an exponential random variable, then\n\n$$\n\\textrm E[X] = \\dfrac{1}{\\lambda}.\n$$\n\nTherefore, for our random variable $X \\sim \\textrm{Exp}\\left(\\dfrac{\\sqrt 3}{3}\\right),$ we have the following expected value:\n\n$$\n\\textrm E[X] =\\dfrac{1}{\\left(\\dfrac{\\sqrt 3}{3}\\right)}=\\sqrt 3\n$$"}] [{:db/id #edb/ref 17592186166709 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166856 :knowledge-point/id #uuid "269d8bf1-f092-5352-a689-35b2978b163b" :knowledge-point/title "The Variance of a  Exponential Distribution"}] :question/id #uuid "5ebef25c-14db-5d26-ae2e-d4f818833795" :question/math-academy-id "e-9244" :question/problem "Given that $X\\sim  \\textrm{Exp}\\left(0.1\\right),$ what is $\\textrm{SD}[X]?$" :question/worked-solution "If $X \\sim  \\textrm{Exp}(\\lambda)$ is an exponential random variable, then\n\n$$\n\\textrm{SD}[X] = \\sqrt{\\textrm{Var}[X]} = \\dfrac{1}{\\lambda}.\n$$\n\nTherefore, for our random variable $X \\sim  \\textrm{Exp}\\left(0.1\\right),$ we have the following standard deviation:\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\frac{1}{(0.1)} \\\\  & =10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166721 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166868 :knowledge-point/id #uuid "ddb0f6dc-ae8d-59e3-abf9-744916a0bfb1" :knowledge-point/title "Modeling With the Mean of an Exponential Distribution"}] :question/id #uuid "2f1173e0-dd6c-5be4-a5ac-0580c6068450" :question/math-academy-id "e-9839" :question/problem "The time $X,$ in hours, between two customers ordering a chocolate muffin at a pastry shop can be modeled as an exponential random variable $X\\sim \\textrm{Exp}(6).$ If a customer has just ordered a chocolate muffin, what is the average time, in minutes, until the next customer orders a chocolate muffin?" :question/worked-solution "Recall that if $X \\sim \\textrm{Exp}({\\lambda})$ is an exponential random variable, then\n\n$$\n\\textrm{E}[X] = \\dfrac{1}{\\lambda}.\n$$\n\nWe're given that $X \\sim \\textrm{Exp}\\left(6\\right).$ Therefore, $\\lambda = 6,$ which means that $6$ customers order a chocolate muffin each hour. Hence,\n\n$$\n\\textrm E[X] =\\dfrac{1}{6}\\, \\textrm{h} = 10 \\, \\textrm{min}.\n$$\n\nTherefore, the average time until the next customer orders a chocolate muffin is $10$ minutes."}] [{:db/id #edb/ref 17592186167076 :knowledge-point/_questions [{:db/id #edb/ref 17592186166868 :knowledge-point/id #uuid "ddb0f6dc-ae8d-59e3-abf9-744916a0bfb1" :knowledge-point/title "Modeling With the Mean of an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cdecda1-377a-5fab-a155-4a8a5d5c8243" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ minute" :db/id #edb/ref 17592186163535} {:answer/id #uuid "c4f06c76-6903-5a88-9f67-260931cb42c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ seconds" :db/id #edb/ref 17592186163536} {:answer/id #uuid "d09b003a-b6b0-5bb2-a942-1967279bd209" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ minutes" :db/id #edb/ref 17592186163537} {:answer/id #uuid "f49e837c-644f-5402-bd4e-98a3853da365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186163538} {:answer/id #uuid "5fd7214e-3723-5a98-b1d7-e3844ce70e7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ seconds" :db/id #edb/ref 17592186163539}] :answer-field/correct {:answer/id #uuid "5fd7214e-3723-5a98-b1d7-e3844ce70e7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12$ seconds" :db/id #edb/ref 17592186163539} :answer-field/id #uuid "b165ad85-e210-5a08-ad4a-a381cb065769" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c340852f-a5cf-53db-988e-4c4c3f31b950" :question/math-academy-id "q-112757" :question/problem "The time $X,$ in minutes, between two customers arriving at a bank can be modeled as an exponential random variable $X∼\\text{Exp}(5).$ If a customer has just arrived at the bank, what is the average time until the next customer arrives at the bank?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(5).$ Therefore, $\\lambda =5,$ which means that $5$ customers arrive each minute. Hence,\n\n$$\n\\text{E}[X]=\\frac{1}{5}\\,\\text{min}=12\\,\\text{s}.\n$$\n\nTherefore, the average time until the next customer is $12$ seconds."}] [{:db/id #edb/ref 17592186435632 :knowledge-point/_questions [{:db/id #edb/ref 17592186166855 :knowledge-point/id #uuid "fd76ab70-7c62-5513-8afa-7b805b3b8447" :knowledge-point/title "The Mean of an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06eedefb-fb96-5dde-9684-40c6c4325db0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186435601} {:answer/id #uuid "87eb2fe2-6fca-5ada-88d8-dfb168d5ed24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}"